-- Example: Basic TEST/WHEN/TEST THAT framework usage.
-- Demonstrates test structure, setup isolation, and assertions.
--
-- Run: clear test examples/testing/basic_test.cht

FN add(a: Float64, b: Float64) RETURNS Float64 ->
    RETURN a + b;
END

FN multiply(a: Float64, b: Float64) RETURNS Float64 ->
    RETURN a * b;
END

PRIVATE FN secret() RETURNS Float64 ->
    RETURN 42.0;
END

FN main() RETURNS Void -> RETURN; END

TEST Arithmetic DO
  WHEN "add" DO
    TEST THAT "adds positives" DO
      ASSERT add(2.0, 3.0) == 5.0;
    END

    TEST THAT "adds negatives" DO
      ASSERT add(-1.0, -2.0) == -3.0;
    END

    TEST THAT "identity" DO
      ASSERT add(0.0, 5.0) == 5.0;
    END
  END

  WHEN "multiply" DO
    TEST THAT "multiplies" DO
      ASSERT multiply(3.0, 4.0) == 12.0;
    END

    TEST THAT "zero" DO
      ASSERT multiply(0.0, 100.0) == 0.0;
    END

    BENCHMARK multiply(100.0, 200.0) x500;
  END

  WHEN "private access" DO
    TEST THAT "can call private functions in test mode" DO
      s = secret();
      ASSERT s == 42.0, "private function accessible";
    END
  END
END
