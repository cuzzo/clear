# Example: STUB with UFCS method calls.
# Demonstrates stubbing instance-style methods on structs.
#
# Run: clear test examples/testing/stub_ufcs.cht

STRUCT Client { host: String }

FN query(client: Client, sql: String) RETURNS String ->
    RETURN "real database result";
END

FN execute(client: Client, sql: String) RETURNS Void ->
    RETURN;
END

FN main() RETURNS Void -> RETURN; END

TEST ClientStubs DO
  WHEN "stubbed query" DO
    STUB query RETURNS "mock result";

    TEST THAT "x.query() returns stub" DO
      x = Client{ host: "localhost" };
      result = x.query("SELECT * FROM users");
      ASSERT result == "mock result", "UFCS stub replaces method call";
    END
  END

  WHEN "stubbed execute with capture" DO
    STUB execute CAPTURES execCount;

    TEST THAT "counts executions" DO
      x = Client{ host: "localhost" };
      x.execute("INSERT INTO users VALUES (1)");
      x.execute("INSERT INTO users VALUES (2)");
      ASSERT execCount == 2, "captured 2 execute calls";
    END
  END

  WHEN "real calls" DO
    TEST THAT "query returns real data when not stubbed" DO
      x = Client{ host: "localhost" };
      result = x.query("SELECT 1");
      ASSERT result == "real database result";
    END
  END
END
