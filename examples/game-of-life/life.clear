REQUIRE "grid.clear";
REQUIRE "gui.clear";

FN parseCell(line: String) RETURNS !Cell ->
  parts = line.split(",");
  x = ((UNWRAP parts[0]).toNumber() OR_ELSE 0.0).toInt();
  y = ((UNWRAP parts[1]).toNumber() OR_ELSE 0.0).toInt();
  RETURN Cell{ x: x, y: y };
END

FN readGrid(path: String) RETURNS ![]Cell ->
  raw = readFile(path) OR_ELSE RAISE;
  lines = raw.split("\n");
  MUTABLE cells: []Cell = [];
  MUTABLE i = 0;
  WHILE i < lines.length() DO
    line = UNWRAP (UNWRAP lines[i]).trim();
    IF line.any?() THEN
      &cells.append(TRY parseCell(line));
    END
    i += 1;
  END
  RETURN cells;
END

FN runLife(path: String, generations: Int64) RETURNS !Void ->
  MUTABLE cells = TRY readGrid(path);
  MUTABLE generation = 0;
  WHILE generation < generations AND cells.any?() DO
    TRY render(cells);
    cells = TRY advance(cells);
    generation += 1;
  END
END

FN defaultGlider() RETURNS ![]Cell ->
  MUTABLE cells: []Cell = [];
  &cells.append(Cell{ x: 1, y: 0 });
  &cells.append(Cell{ x: 2, y: 1 });
  &cells.append(Cell{ x: 0, y: 2 });
  &cells.append(Cell{ x: 1, y: 2 });
  &cells.append(Cell{ x: 2, y: 2 });
  RETURN cells;
END

FN main() RETURNS Void ->
  MUTABLE cells = TRY defaultGlider();
  MUTABLE generation = 0;
  WHILE generation < 4 AND cells.any?() DO
    render(cells);
    cells = TRY advance(cells);
    generation += 1;
  END
END
