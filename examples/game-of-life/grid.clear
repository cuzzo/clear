STRUCT Cell {
  x: Int64,
  y: Int64
}

STRUCT CellState {
  life: Bool,
  neighbors: Int64
}

FN cellKey(cell: Cell) RETURNS !String ->
  RETURN cell.x.toString() $+ "," $+ cell.y.toString();
END

FN sameCell?(a: Cell, b: Cell) RETURNS Bool ->
  RETURN a.x == b.x AND a.y == b.y;
END

FN containsCell?(cells: []Cell, cell: Cell) RETURNS Bool ->
  MUTABLE i = 0;
  WHILE i < cells.length() DO
    candidate = cells[i] OR_ELSE Cell{ x: 0_i64, y: 0_i64 };
    IF sameCell?(candidate, cell) -> RETURN TRUE;
    i += 1;
  END
  RETURN FALSE;
END

FN appendUniqueCell(MUTABLE cells: []Cell, cell: Cell) RETURNS !Void ->
  IF containsCell?(cells, cell) == FALSE THEN
    &cells.append(cell);
  END
  RETURN;
END

FN cellNeighbors(cell: Cell) RETURNS ![]Cell ->
  MUTABLE neighbors: []Cell = [];
  MUTABLE dx = -1;
  WHILE dx <= 1 DO
    MUTABLE dy = -1;
    WHILE dy <= 1 DO
      IF dx != 0 OR dy != 0 THEN
        &neighbors.append(Cell{ x: cell.x + dx, y: cell.y + dy });
      END
      dy += 1;
    END
    dx += 1;
  END
  RETURN neighbors;
END

FN buildGrid(liveCells: []Cell) RETURNS !{String}CellState ->
  MUTABLE states: {String}CellState = {};
  MUTABLE i = 0;
  WHILE i < liveCells.length() DO
    cell = liveCells[i] OR_ELSE Cell{ x: 0_i64, y: 0_i64 };
    neighbors = cellNeighbors(cell);

    MUTABLE n = 0;
    WHILE n < neighbors.length() DO
      neighbor = neighbors[n] OR_ELSE Cell{ x: 0_i64, y: 0_i64 };
      key = cellKey(neighbor);
      MUTABLE state = states[key] OR_ELSE CellState{ life: FALSE, neighbors: 0 };
      state.neighbors += 1;
      states[key] = state;
      n += 1;
    END

    ownKey = cellKey(cell);
    MUTABLE ownState = states[ownKey] OR_ELSE CellState{ life: TRUE, neighbors: 0 };
    ownState.life = TRUE;
    states[ownKey] = ownState;
    i += 1;
  END
  RETURN states;
END

FN revive?(lifeState: Bool, liveNeighbors: Int64) RETURNS Bool ->
  RETURN lifeState == FALSE AND liveNeighbors >= 3 AND liveNeighbors <= 3;
END

FN survive?(lifeState: Bool, liveNeighbors: Int64) RETURNS Bool ->
  RETURN lifeState == TRUE AND liveNeighbors >= 2 AND liveNeighbors <= 3;
END

FN evolve(state: CellState) RETURNS Bool ->
  IF survive?(state.life, state.neighbors) OR revive?(state.life, state.neighbors) THEN
    RETURN TRUE;
  END
  RETURN FALSE;
END

FN candidateCells(liveCells: []Cell) RETURNS ![]Cell ->
  MUTABLE candidates: []Cell = [];
  MUTABLE i = 0;
  WHILE i < liveCells.length() DO
    cell = liveCells[i] OR_ELSE Cell{ x: 0_i64, y: 0_i64 };
    neighbors = cellNeighbors(cell);
    MUTABLE n = 0;
    WHILE n < neighbors.length() DO
      neighbor = neighbors[n] OR_ELSE Cell{ x: 0_i64, y: 0_i64 };
      appendUniqueCell(&candidates, neighbor);
      n += 1;
    END
    appendUniqueCell(&candidates, cell);
    i += 1;
  END
  RETURN candidates;
END

FN advance(liveCells: []Cell) RETURNS ![]Cell ->
  states = buildGrid(liveCells);
  candidates = candidateCells(liveCells);
  MUTABLE next: []Cell = [];
  MUTABLE i = 0;
  WHILE i < candidates.length() DO
    cell = candidates[i] OR_ELSE Cell{ x: 0_i64, y: 0_i64 };
    state = states[cellKey(cell)] OR_ELSE CellState{ life: FALSE, neighbors: 0 };
    IF evolve(state) THEN
      &next.append(cell);
    END
    i += 1;
  END
  RETURN next;
END
