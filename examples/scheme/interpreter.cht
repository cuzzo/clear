-- Mal (Make-a-Lisp) Level 4 Interpreter in CLEAR
-- All state passed explicitly. No globals.

UNION Value {
    Nil, TrueVal, FalseVal,
    Number: Float64, Str: String, Symbol: String,
    List: Value[], NativeFn: String,
    Lambda { params: Value[], body: Value @indirect, envId: Int64 }
}

FN mkKey(envId: Int64, key: String) RETURNS String ->
    RETURN toString(envId) + ":" + key;
END

FN setEnv!(MUTABLE env: HashMap<Value>, envId: Int64, key: String, val: Value) RETURNS Void ->
    x = "" + "";
    env[mkKey(envId, key)] = val;
END

FN getEnv(env: HashMap<Value>, envId: Int64, key: String) RETURNS ?Value @reentrant ->
    v = env[mkKey(envId, key)];
    IF v THEN RETURN v; END
    parentVal = env[mkKey(envId, "__p")] OR Value.Nil;
    MATCH parentVal START
        Value.Number AS pid ->
            IF pid >= 0.0 THEN RETURN getEnv(env, toInt(pid), key); END,
        DEFAULT -> PASS;
    END
    MUTABLE none: ?Value = NIL;
    RETURN none;
END

FN boolVal(b: Bool) RETURNS Value ->
    IF b THEN RETURN Value.TrueVal; END
    RETURN Value.FalseVal;
END

FN isTruthy(v: Value) RETURNS Bool ->
    MATCH v START
        Value.Nil -> RETURN FALSE;,
        Value.FalseVal -> RETURN FALSE;,
        DEFAULT -> RETURN TRUE;
    END
    RETURN TRUE;
END

FN valEqual(a: Value, b: Value) RETURNS Bool @reentrant ->
    MATCH a START
        Value.Nil -> MATCH b START Value.Nil -> RETURN TRUE;, DEFAULT -> RETURN FALSE; END,
        Value.TrueVal -> MATCH b START Value.TrueVal -> RETURN TRUE;, DEFAULT -> RETURN FALSE; END,
        Value.FalseVal -> MATCH b START Value.FalseVal -> RETURN TRUE;, DEFAULT -> RETURN FALSE; END,
        Value.Number AS na -> MATCH b START Value.Number AS nb -> RETURN na == nb;, DEFAULT -> RETURN FALSE; END,
        Value.Str AS sa -> MATCH b START Value.Str AS sb -> RETURN sa == sb;, DEFAULT -> RETURN FALSE; END,
        Value.List AS la ->
            MATCH b START
                Value.List AS lb ->
                    IF la.length() != lb.length() THEN RETURN FALSE; END
                    MUTABLE ci: Int64 = 0;
                    WHILE ci < la.length() DO
                        IF valEqual(la[ci], lb[ci]) == FALSE THEN RETURN FALSE; END
                        ci += 1;
                    END
                    RETURN TRUE;,
                DEFAULT -> RETURN FALSE;
            END,
        DEFAULT -> RETURN FALSE;
    END
    RETURN FALSE;
END

FN tokenize(str: String) RETURNS String[]@list ->
    MUTABLE tokens: String[]@list = List[];
    MUTABLE i: Int64 = 0;
    WHILE i < str.length() DO
        c = charAt(str, i);
        IF c == " " || c == "," || c == "\n" || c == "\t" THEN
            i += 1;
        ELSE_IF c == "(" || c == ")" || c == "[" || c == "]" THEN
            tokens.append(c);
            i += 1;
        ELSE_IF c == ";" THEN
            WHILE i < str.length() && charAt(str, i) != "\n" DO i += 1; END
        ELSE_IF c == "\"" THEN
            MUTABLE s = "\"";
            i += 1;
            WHILE i < str.length() && charAt(str, i) != "\"" DO
                s = s + charAt(str, i);
                i += 1;
            END
            s = s + "\"";
            tokens.append(s);
            i += 1;
        ELSE
            MUTABLE s = "";
            WHILE i < str.length() && charAt(str, i) != " " && charAt(str, i) != "," && charAt(str, i) != "\n" && charAt(str, i) != "\t" && charAt(str, i) != "(" && charAt(str, i) != ")" && charAt(str, i) != "[" && charAt(str, i) != "]" && charAt(str, i) != "\"" DO
                s = s + charAt(str, i);
                i += 1;
            END
            tokens.append(s);
        END
    END
    RETURN tokens;
END

-- Reader: tokens passed as slice, pos tracked via HashMap entry to avoid copy issues
FN readAtom(token: String) RETURNS Value ->
    IF token == "nil" THEN RETURN Value.Nil; END
    IF token == "true" THEN RETURN Value.TrueVal; END
    IF token == "false" THEN RETURN Value.FalseVal; END
    IF charAt(token, 0) == "\"" THEN
        RETURN Value{ Str: substr(token, 1, token.length() - 2) };
    END
    n = toNumber(token) OR 0.0 - 999999.0;
    IF n != 0.0 - 999999.0 THEN RETURN Value{ Number: n }; END
    RETURN Value{ Symbol: token };
END

-- Use env HashMap to store reader position as "r:pos" -> Value.Number
-- This avoids struct copy issues with MUTABLE Reader params.
FN getPos(env: HashMap<Value>) RETURNS Int64 ->
    v = env["r:pos"] OR Value{ Number: 0.0 };
    MATCH v START Value.Number AS n -> RETURN toInt(n);, DEFAULT -> RETURN 0; END
    RETURN 0;
END

FN setPos!(MUTABLE env: HashMap<Value>, pos: Int64) RETURNS Void ->
    x = "" + "";
    env["r:pos"] = Value{ Number: toFloat(pos) };
END

FN readForm!(MUTABLE env: HashMap<Value>, tokens: String[]) RETURNS !Value @reentrant ->
    pos = getPos(env);
    IF pos >= tokens.length() THEN RAISE "EOF"; END
    token = tokens[pos];
    setPos!(env, pos + 1);
    IF token == "(" || token == "[" THEN
        MUTABLE closer = ")";
        IF token == "[" THEN closer = "]"; END
        MUTABLE items: Value[]@list = List[];
        MUTABLE rp = getPos(env);
        WHILE rp < tokens.length() && tokens[rp] != closer DO
            item = readForm!(env, tokens) OR RAISE;
            items.append(item);
            rp = getPos(env);
        END
        IF rp >= tokens.length() THEN RAISE "Expected )"; END
        setPos!(env, rp + 1);
        RETURN Value{ List: items };
    ELSE
        RETURN readAtom(token);
    END
END

FN eval!(MUTABLE env: HashMap<Value>, MUTABLE nextId: Int64, v: Value, envId: Int64) RETURNS !Value @reentrant ->
    MATCH v START
        Value.Symbol AS s ->
            got = getEnv(env, envId, s) OR Value.Nil;
            MATCH got START Value.Nil -> RAISE "'" + s + "' not found";, DEFAULT -> RETURN got; END,

        Value.List AS items ->
            IF items.length() == 0 THEN RETURN v; END
            head = items[0];
            MATCH head START
                Value.Symbol AS s ->
                    IF s == "def!" THEN
                        val = eval!(env, nextId, items[2], envId) OR RAISE;
                        MATCH items[1] START
                            Value.Symbol AS k ->
                                setEnv!(env, envId, k, val);
                                defR = getEnv(env, envId, k) OR Value.Nil;
                                RETURN defR;,
                            DEFAULT -> RAISE "def! key must be symbol";
                        END
                    END
                    IF s == "let*" THEN
                        letEnv = nextId;
                        nextId += 1;
                        env[mkKey(letEnv, "__p")] = Value{ Number: toFloat(envId) };
                        MATCH items[1] START
                            Value.List AS bindings ->
                                MUTABLE bi: Int64 = 0;
                                WHILE bi < bindings.length() DO
                                    MATCH bindings[bi] START
                                        Value.Symbol AS bk ->
                                            bv = eval!(env, nextId, bindings[bi + 1], letEnv) OR RAISE;
                                            setEnv!(env, letEnv, bk, bv);,
                                        DEFAULT -> RAISE "let* key must be symbol";
                                    END
                                    bi += 2;
                                END,
                            DEFAULT -> RAISE "let* bindings must be list";
                        END
                        RETURN eval!(env, nextId, items[2], letEnv) OR RAISE;
                    END
                    IF s == "do" THEN
                        MUTABLE doRes: Value = Value.Nil;
                        MUTABLE di: Int64 = 1;
                        WHILE di < items.length() DO
                            doRes = eval!(env, nextId, items[di], envId) OR RAISE;
                            di += 1;
                        END
                        RETURN doRes;
                    END
                    IF s == "if" THEN
                        cond = eval!(env, nextId, items[1], envId) OR RAISE;
                        IF isTruthy(cond) THEN
                            RETURN eval!(env, nextId, items[2], envId) OR RAISE;
                        ELSE
                            IF items.length() > 3 THEN
                                RETURN eval!(env, nextId, items[3], envId) OR RAISE;
                            ELSE
                                RETURN Value.Nil;
                            END
                        END
                    END
                    IF s == "fn*" THEN
                        MATCH items[1] START
                            Value.List AS fparams ->
                                RETURN Value.Lambda{ params: fparams, body: items[2], envId: envId };,
                            DEFAULT -> RAISE "fn* params must be list";
                        END
                    END,
                DEFAULT -> PASS;
            END

            MUTABLE evaluated: Value[]@list = List[];
            MUTABLE ei: Int64 = 0;
            WHILE ei < items.length() DO
                ev = eval!(env, nextId, items[ei], envId) OR RAISE;
                evaluated.append(ev);
                ei += 1;
            END
            f = evaluated[0];
            MUTABLE args: Value[]@list = List[];
            MUTABLE ai: Int64 = 1;
            WHILE ai < evaluated.length() DO
                args.append(evaluated[ai]);
                ai += 1;
            END

            MATCH f START
                Value.NativeFn AS name ->
                    IF name == "+" THEN MATCH args[0] START Value.Number AS a -> MATCH args[1] START Value.Number AS b -> RETURN Value{ Number: a + b };, DEFAULT -> PASS; END, DEFAULT -> PASS; END END
                    IF name == "-" THEN MATCH args[0] START Value.Number AS a -> MATCH args[1] START Value.Number AS b -> RETURN Value{ Number: a - b };, DEFAULT -> PASS; END, DEFAULT -> PASS; END END
                    IF name == "*" THEN MATCH args[0] START Value.Number AS a -> MATCH args[1] START Value.Number AS b -> RETURN Value{ Number: a * b };, DEFAULT -> PASS; END, DEFAULT -> PASS; END END
                    IF name == "/" THEN MATCH args[0] START Value.Number AS a -> MATCH args[1] START Value.Number AS b -> RETURN Value{ Number: a / b };, DEFAULT -> PASS; END, DEFAULT -> PASS; END END
                    IF name == "=" THEN RETURN boolVal(valEqual(args[0], args[1])); END
                    IF name == ">" THEN MATCH args[0] START Value.Number AS a -> MATCH args[1] START Value.Number AS b -> RETURN boolVal(a > b);, DEFAULT -> PASS; END, DEFAULT -> PASS; END END
                    IF name == ">=" THEN MATCH args[0] START Value.Number AS a -> MATCH args[1] START Value.Number AS b -> RETURN boolVal(a >= b);, DEFAULT -> PASS; END, DEFAULT -> PASS; END END
                    IF name == "<" THEN MATCH args[0] START Value.Number AS a -> MATCH args[1] START Value.Number AS b -> RETURN boolVal(a < b);, DEFAULT -> PASS; END, DEFAULT -> PASS; END END
                    IF name == "<=" THEN MATCH args[0] START Value.Number AS a -> MATCH args[1] START Value.Number AS b -> RETURN boolVal(a <= b);, DEFAULT -> PASS; END, DEFAULT -> PASS; END END
                    IF name == "list" THEN RETURN Value{ List: args }; END
                    IF name == "list?" THEN MATCH args[0] START Value.List -> RETURN Value.TrueVal;, DEFAULT -> RETURN Value.FalseVal; END END
                    IF name == "empty?" THEN MATCH args[0] START Value.List AS l -> RETURN boolVal(l.length() == 0);, DEFAULT -> RETURN Value.FalseVal; END END
                    IF name == "count" THEN
                        MATCH args[0] START
                            Value.List AS l -> RETURN Value{ Number: toFloat(l.length()) };,
                            Value.Nil -> RETURN Value{ Number: 0.0 };,
                            DEFAULT -> RETURN Value{ Number: 0.0 };
                        END
                    END
                    IF name == "not" THEN RETURN boolVal(isTruthy(args[0]) == FALSE); END
                    IF name == "prn" THEN
                        MUTABLE prnOut = "";
                        MUTABLE pi: Int64 = 0;
                        WHILE pi < args.length() DO
                            IF pi > 0 THEN prnOut = prnOut + " "; END
                            prnOut = prnOut + prStr(args[pi], TRUE);
                            pi += 1;
                        END
                        print(prnOut);
                        RETURN Value.Nil;
                    END
                    RAISE "Unknown native fn: " + name;,
                Value.Lambda AS lam ->
                    callEnv = nextId;
                    nextId += 1;
                    env[mkKey(callEnv, "__p")] = Value{ Number: toFloat(lam.envId) };
                    MUTABLE ki: Int64 = 0;
                    WHILE ki < lam.params.length() DO
                        MATCH lam.params[ki] START
                            Value.Symbol AS pname -> setEnv!(env, callEnv, pname, args[ki]);,
                            DEFAULT -> PASS;
                        END
                        ki += 1;
                    END
                    RETURN eval!(env, nextId, lam.body, callEnv) OR RAISE;,
                DEFAULT -> RAISE "Not a function";
            END,
        DEFAULT -> RETURN v;
    END
END

FN prStr(v: Value, readably: Bool) RETURNS String @reentrant ->
    MATCH v START
        Value.Nil -> RETURN "nil";,
        Value.TrueVal -> RETURN "true";,
        Value.FalseVal -> RETURN "false";,
        Value.Number AS n -> RETURN toString(toInt(n));,
        Value.Str AS s ->
            IF readably THEN RETURN "\"" + s + "\""; END
            RETURN s;,
        Value.Symbol AS s -> RETURN s;,
        Value.List AS litems ->
            MUTABLE out = "(";
            MUTABLE li: Int64 = 0;
            WHILE li < litems.length() DO
                IF li > 0 THEN out = out + " "; END
                out = out + prStr(litems[li], readably);
                li += 1;
            END
            RETURN out + ")";,
        Value.NativeFn AS name -> RETURN "#<native " + name + ">";,
        Value.Lambda -> RETURN "#<function>";
    END
    RETURN "";
END

FN cheatMain() RETURNS Void ->
    MUTABLE env: HashMap<Value> = {};
    MUTABLE nextId: Int64 = 1;
    env[mkKey(0, "__p")] = Value{ Number: 0.0 - 1.0 };

    setEnv!(env, 0, "+", Value{ NativeFn: "+" });
    setEnv!(env, 0, "-", Value{ NativeFn: "-" });
    setEnv!(env, 0, "*", Value{ NativeFn: "*" });
    setEnv!(env, 0, "/", Value{ NativeFn: "/" });
    setEnv!(env, 0, "=", Value{ NativeFn: "=" });
    setEnv!(env, 0, ">", Value{ NativeFn: ">" });
    setEnv!(env, 0, ">=", Value{ NativeFn: ">=" });
    setEnv!(env, 0, "<", Value{ NativeFn: "<" });
    setEnv!(env, 0, "<=", Value{ NativeFn: "<=" });
    setEnv!(env, 0, "list", Value{ NativeFn: "list" });
    setEnv!(env, 0, "list?", Value{ NativeFn: "list?" });
    setEnv!(env, 0, "empty?", Value{ NativeFn: "empty?" });
    setEnv!(env, 0, "count", Value{ NativeFn: "count" });
    setEnv!(env, 0, "not", Value{ NativeFn: "not" });
    setEnv!(env, 0, "prn", Value{ NativeFn: "prn" });

    input = "(def! a 10) (def! f (fn* (x) (+ x a))) (f 5)";
    MUTABLE tokens = tokenize(input);
    setPos!(env, 0);
    WHILE getPos(env) < tokens.length() DO
        expr = readForm!(env, tokens) OR BREAK;
        res = eval!(env, nextId, expr, 0) OR BREAK;
        print(prStr(res, TRUE));
    END
END
