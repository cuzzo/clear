# Puck runner.
#
# This is intentionally self-contained: it loads core.puck, tokenizes a .puck
# file, and executes the primitive core directly.

UNION PuckValue {
  IntVal: Int64,
  StrVal: String,
  BoolVal: Bool
}

STRUCT PuckVm {
  corePath: String,
  macroCount: Int64,
  vars: HashMap<Int64>
}

STRUCT ExecResult {
  pos: Int64,
  didExit: Bool
}

METHOD intValue(v: PuckValue) RETURNS Int64 ->
  PARTIAL MATCH v START
    PuckValue.IntVal AS n -> RETURN n;,
    PuckValue.BoolVal AS b -> IF b THEN RETURN 1; END RETURN 0;,
    DEFAULT -> RETURN 0;
  END
  RETURN 0;
END

METHOD boolValue(v: PuckValue) RETURNS Bool ->
  PARTIAL MATCH v START
    PuckValue.BoolVal AS b -> RETURN b;,
    PuckValue.IntVal AS n -> RETURN n != 0;,
    PuckValue.StrVal AS s -> RETURN s.length() > 0;
  END
  RETURN FALSE;
END

METHOD printValue(v: PuckValue) RETURNS !Void ->
  PARTIAL MATCH v START
    PuckValue.IntVal AS n -> print(n.toString()); RETURN;,
    PuckValue.StrVal AS s -> print(s); RETURN;,
    PuckValue.BoolVal AS b -> IF b THEN print("TRUE"); ELSE print("FALSE"); END RETURN;
  END
  RETURN;
END

METHOD isSpace?(c: String) RETURNS Bool ->
  RETURN c == " " || c == "\n" || c == "\r" || c == "\t";
END

METHOD isDigit?(c: String) RETURNS Bool ->
  RETURN c >= "0" && c <= "9";
END

METHOD isAlpha?(c: String) RETURNS Bool ->
  RETURN (c >= "A" && c <= "Z") || (c >= "a" && c <= "z") || c == "_";
END

METHOD isIdentChar?(c: String) RETURNS Bool ->
  RETURN isAlpha?(c) || isDigit?(c);
END

METHOD isPunct?(c: String) RETURNS Bool ->
  RETURN c == ";" || c == ":" || c == "." || c == "," || c == "(" || c == ")" || c == "~" ||
    c == "+" || c == "-" || c == "*" || c == "/" || c == "=" || c == "<" || c == ">";
END

METHOD isAscii?(source: String) RETURNS !Bool ->
  ascii = "\n\r\t !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
  MUTABLE i = 0;
  WHILE i < source.length() DO
    ch = source.charAt(i) OR "";
    MUTABLE found = FALSE;
    MUTABLE j = 0;
    WHILE j < ascii.length() DO
      IF (ascii.charAt(j) OR "") == ch THEN found = TRUE; END
      j += 1;
    END
    IF found == FALSE THEN RETURN FALSE; END
    i += 1;
  END
  RETURN TRUE;
END

METHOD tokenize(source: String) RETURNS !String[]@list ->
  IF (isAscii?(source) OR RAISE) == FALSE THEN RAISE "puck source must be ASCII"; END

  MUTABLE tokens: String[]@list = [];
  MUTABLE i = 0;
  len = source.length();
  WHILE i < len DO
    c = source.charAt(i);
    IF isSpace?(c) THEN
      i += 1;
    ELSE_IF c == "#" THEN
      WHILE i < len && source.charAt(i) != "\n" DO i += 1; END
    ELSE_IF c == ":" && i + 1 < len && source.charAt(i + 1) == "=" THEN
      tokens.append(":=");
      i += 2;
    ELSE_IF c == "<" && i + 1 < len && source.charAt(i + 1) == "=" THEN
      tokens.append("<=");
      i += 2;
    ELSE_IF c == ">" && i + 1 < len && source.charAt(i + 1) == "=" THEN
      tokens.append(">=");
      i += 2;
    ELSE_IF isPunct?(c) THEN
      tokens.append(c);
      i += 1;
    ELSE_IF c == "\"" THEN
      start = i;
      i += 1;
      MUTABLE closed = FALSE;
      WHILE i < len && closed == FALSE DO
        ch = source.charAt(i);
        IF ch == "\n" || ch == "\r" THEN
          RAISE "puck strings cannot span lines";
        ELSE_IF ch == "\\" THEN
          i += 2;
        ELSE_IF ch == "\"" THEN
          closed = TRUE;
          i += 1;
        ELSE
          i += 1;
        END
      END
      IF closed == FALSE THEN RAISE "unterminated puck string"; END
      tokens.append(substr(source, start, i - start));
    ELSE_IF isAlpha?(c) THEN
      startIdent = i;
      WHILE i < len && isIdentChar?(source.charAt(i)) DO i += 1; END
      tokens.append(substr(source, startIdent, i - startIdent));
    ELSE_IF isDigit?(c) THEN
      startNum = i;
      WHILE i < len && isDigit?(source.charAt(i)) DO i += 1; END
      tokens.append(substr(source, startNum, i - startNum));
    ELSE
      RAISE "unexpected puck character " + c;
    END
  END
  RETURN tokens;
END

METHOD tokenAt(tokens: String[]@list, pos: Int64) RETURNS String ->
  IF pos < 0 || pos >= tokens.length() THEN RETURN ""; END
  RETURN tokens[pos];
END

METHOD expectToken(tokens: String[]@list, pos: Int64, wanted: String) RETURNS !Void ->
  got = tokenAt(tokens, pos);
  IF got != wanted THEN RAISE "expected " + wanted + ", got " + got; END
  RETURN;
END

METHOD countCoreMacros(source: String) RETURNS !Int64 ->
  tokens = tokenize(source) OR RAISE;
  MUTABLE count = 0;
  MUTABLE i = 0;
  WHILE i < tokens.length() DO
    IF tokens[i] == "MACRO" THEN count += 1; END
    i += 1;
  END
  RETURN count;
END

METHOD findEnd(tokens: String[]@list, bodyStart: Int64) RETURNS !Int64 ->
  MUTABLE pos = bodyStart;
  MUTABLE depth = 0;
  WHILE pos < tokens.length() DO
    tok = tokens[pos];
    IF tok == "IF" || tok == "LOOP" THEN
      depth += 1;
    ELSE_IF tok == "END" THEN
      IF depth == 0 THEN RETURN pos; END
      depth -= 1;
    END
    pos += 1;
  END
  RAISE "missing END";
END

METHOD findToken(tokens: String[]@list, start: Int64, wanted: String) RETURNS !Int64 ->
  MUTABLE pos = start;
  WHILE pos < tokens.length() DO
    IF tokens[pos] == wanted THEN RETURN pos; END
    pos += 1;
  END
  RAISE "missing " + wanted;
END

METHOD evalAtom!(MUTABLE vm: PuckVm, tokens: String[]@list, pos: Int64) RETURNS !PuckValue ->
  tok = tokenAt(tokens, pos);
  IF tok == "" THEN RAISE "expected expression"; END
  IF tok == "TRUE" THEN RETURN PuckValue{ BoolVal: TRUE }; END
  IF tok == "FALSE" THEN RETURN PuckValue{ BoolVal: FALSE }; END
  IF tok.charAt(0) == "\"" THEN RETURN PuckValue{ StrVal: substr(tok, 1, tok.length() - 2) }; END
  IF isDigit?(tok.charAt(0)) THEN RETURN PuckValue{ IntVal: toInt(toNumber(tok) OR 0.0) }; END
  RETURN PuckValue{ IntVal: vm.vars[tok] OR 0 };
END

METHOD applyBinary(op: String, left: PuckValue, right: PuckValue) RETURNS !PuckValue ->
  a = intValue(left);
  b = intValue(right);
  IF op == "+" THEN RETURN PuckValue{ IntVal: a + b }; END
  IF op == "-" THEN RETURN PuckValue{ IntVal: a - b }; END
  IF op == "*" THEN RETURN PuckValue{ IntVal: a * b }; END
  IF op == "/" THEN RETURN PuckValue{ IntVal: a / b }; END
  IF op == "=" THEN RETURN PuckValue{ BoolVal: a == b }; END
  IF op == "<" THEN RETURN PuckValue{ BoolVal: a < b }; END
  IF op == ">" THEN RETURN PuckValue{ BoolVal: a > b }; END
  IF op == "<=" THEN RETURN PuckValue{ BoolVal: a <= b }; END
  IF op == ">=" THEN RETURN PuckValue{ BoolVal: a >= b }; END
  RAISE "unsupported operator " + op;
END

METHOD evalExpr!(MUTABLE vm: PuckVm, tokens: String[]@list, start: Int64, endPos: Int64) RETURNS !PuckValue EFFECTS REENTRANT ->
  IF start >= endPos THEN RAISE "empty expression"; END
  IF tokenAt(tokens, start) == "NOT" THEN
    inner = evalExpr!(vm, tokens, start + 1, endPos) OR RAISE;
    RETURN PuckValue{ BoolVal: boolValue(inner) == FALSE };
  END

  MUTABLE result = evalAtom!(vm, tokens, start) OR RAISE;
  MUTABLE pos = start + 1;
  WHILE pos < endPos DO
    op = tokenAt(tokens, pos);
    rhs = evalAtom!(vm, tokens, pos + 1) OR RAISE;
    result = applyBinary(op, result, rhs) OR RAISE;
    pos += 2;
  END
  RETURN result;
END

METHOD execBlock!(MUTABLE vm: PuckVm, tokens: String[]@list, start: Int64, endPos: Int64) RETURNS !ExecResult EFFECTS REENTRANT ->
  MUTABLE pos = start;
  WHILE pos < endPos DO
    tok = tokenAt(tokens, pos);

    IF tok == ";" THEN
      pos += 1;
    ELSE_IF tok == "EXIT" THEN
      IF tokenAt(tokens, pos + 1) == ";" THEN pos += 1; END
      RETURN ExecResult{ pos: pos + 1, didExit: TRUE };
    ELSE_IF tok == "IF" THEN
      thenPos = findToken(tokens, pos + 1, "THEN") OR RAISE;
      endIf = findEnd(tokens, thenPos + 1) OR RAISE;
      cond = evalExpr!(vm, tokens, pos + 1, thenPos) OR RAISE;
      IF boolValue(cond) THEN
        inner = execBlock!(vm, tokens, thenPos + 1, endIf) OR RAISE;
        IF inner.didExit THEN RETURN inner; END
      END
      pos = endIf + 1;
      IF tokenAt(tokens, pos) == ";" THEN pos += 1; END
    ELSE_IF tok == "LOOP" THEN
      loopEnd = findEnd(tokens, pos + 1) OR RAISE;
      MUTABLE loopDone = FALSE;
      WHILE loopDone == FALSE DO
        inner = execBlock!(vm, tokens, pos + 1, loopEnd) OR RAISE;
        IF inner.didExit THEN loopDone = TRUE; END
      END
      pos = loopEnd + 1;
      IF tokenAt(tokens, pos) == ";" THEN pos += 1; END
    ELSE_IF tokenAt(tokens, pos + 1) == ":=" THEN
      semi = findToken(tokens, pos + 2, ";") OR RAISE;
      val = evalExpr!(vm, tokens, pos + 2, semi) OR RAISE;
      vm.vars[tok] = intValue(val);
      pos = semi + 1;
    ELSE_IF tok == "Print" THEN
      expectToken(tokens, pos + 1, "(") OR RAISE;
      close = findToken(tokens, pos + 2, ")") OR RAISE;
      value = evalExpr!(vm, tokens, pos + 2, close) OR RAISE;
      printValue(value) OR RAISE;
      pos = close + 1;
      IF tokenAt(tokens, pos) == ";" THEN pos += 1; END
    ELSE
      RAISE "unsupported Puck statement " + tok;
    END
  END
  RETURN ExecResult{ pos: pos, didExit: FALSE };
END

METHOD loadCore!(MUTABLE vm: PuckVm) RETURNS !Void ->
  source = readFile(vm.corePath) OR RAISE;
  vm.macroCount = countCoreMacros(source) OR RAISE;
  RETURN;
END

METHOD runFile!(MUTABLE vm: PuckVm, path: String) RETURNS !Void ->
  IF vm.macroCount <= 0 THEN RAISE "puck core is not loaded"; END
  source = readFile(path) OR RAISE;
  tokens = tokenize(source) OR RAISE;
  result = execBlock!(vm, tokens, 0, tokens.length()) OR RAISE;
  IF result.didExit THEN RAISE "EXIT outside LOOP"; END
  RETURN;
END

METHOD newPuckVm(corePath: String) RETURNS !PuckVm ->
  MUTABLE vm = PuckVm{ corePath: COPY corePath, macroCount: 0, vars: {} };
  loadCore!(vm) OR RAISE;
  RETURN vm;
END

FN main() RETURNS !Void ->
  MUTABLE vm = newPuckVm("examples/puck/core.puck") OR RAISE;
  ASSERT vm.macroCount == 10;

  runFile!(vm, "examples/puck/samples/primitive.puck") OR RAISE;
  RETURN;
END
