-- LiteDB: Concurrent B-Tree Key-Value Store
--
-- Compiler stress test targeting under-tested paths:
-- @shared:locked, @indirect unions, @multiowned results,
-- DO blocks, ENUM dispatch, lambda parameters, nested BG.
--
-- Flat-array B-tree. Nodes stored in Node[]@list.
-- Children stored in HashMap<Int64> keyed by "parentIdx:childPos".

ENUM Op { Get, Put, Delete, Scan }

STRUCT Node {
    keys: Int64[]@list,
    vals: String[]@list,
    numChildren: Int64,
    isLeaf: Bool
}

FN childKey(parentIdx: Int64, pos: Int64) RETURNS String ->
    RETURN "${parentIdx.toString()}:${pos.toString()}";
END

-- Find the first index i where keys[i] >= key.
FN findKeyIndex(keys: Int64[]@list, key: Int64) RETURNS Int64 ->
    MUTABLE i: Int64 = 0;
    WHILE i < keys.length() DO
        IF keys[i] >= key -> RETURN i;
        i += 1;
    END
    RETURN i;
END

FN main() RETURNS Void ->
    MUTABLE nodes: Node[]@list = [];
    MUTABLE children: HashMap<Int64> = {};
    MUTABLE root: Int64 = 0;
    maxKeys = 3;

    -- Create root leaf
    nodes.append(Node{ keys: [], vals: [], numChildren: 0, isLeaf: TRUE });

    -- ENUM smoke test
    MUTABLE opName = "";
    MATCH Op.Get START
        Op.Get -> opName = "get";,
        Op.Put -> opName = "put";,
        Op.Delete -> opName = "delete";,
        Op.Scan -> opName = "scan";
    END
    ASSERT opName == "get", "ENUM: Op.Get dispatches correctly";

    -- Insert keys 10, 20, 30, 40 with splitting at maxKeys=3
    -- When 4th key makes a leaf exceed maxKeys, split:
    --   left gets first half, right gets second half, median promoted to parent
    MUTABLE ki: Int64 = 0;
    WHILE ki < 4 DO
        key = (ki + 1) * 10;
        val = key.toString();

        -- Navigate to the correct leaf
        MUTABLE cur = root;
        WHILE nodes[cur].isLeaf == FALSE DO
            cp = findKeyIndex(nodes[cur].keys, key);
            cur = children[childKey(cur, cp)] OR (0 - 1);
        END

        -- Sorted insert into leaf by rebuilding keys/vals
        MUTABLE pos2 = findKeyIndex(nodes[cur].keys, key);
        MUTABLE nk: Int64[]@list = [];
        MUTABLE nv: String[]@list = [];
        MUTABLE jj: Int64 = 0;
        WHILE jj < nodes[cur].keys.length() DO
            IF jj == pos2 THEN
                nk.append(key);
                nv.append(COPY val);
            END
            nk.append(nodes[cur].keys[jj]);
            nv.append(COPY nodes[cur].vals[jj]);
            jj += 1;
        END
        IF pos2 == nodes[cur].keys.length() THEN
            nk.append(key);
            nv.append(COPY val);
        END

        -- Split if overfull
        IF nk.length() > maxKeys THEN
            mid = nk.length() / 2;
            -- Build left half
            MUTABLE lk: Int64[]@list = [];
            MUTABLE lv: String[]@list = [];
            MUTABLE ri2: Int64 = 0;
            WHILE ri2 < mid DO
                lk.append(nk[ri2]);
                lv.append(COPY nv[ri2]);
                ri2 += 1;
            END
            -- Median
            medKey = nk[mid];
            medVal = COPY nv[mid];
            -- Build right half
            MUTABLE rk: Int64[]@list = [];
            MUTABLE rv: String[]@list = [];
            ri2 = mid + 1;
            WHILE ri2 < nk.length() DO
                rk.append(nk[ri2]);
                rv.append(COPY nv[ri2]);
                ri2 += 1;
            END
            -- Left stays at cur, right is new node
            rightIdx = nodes.length();
            nodes.append(Node{ keys: rk, vals: rv, numChildren: 0, isLeaf: TRUE });
            nodes[cur].keys = lk;
            nodes[cur].vals = lv;
            -- New root
            MUTABLE rootKeys: Int64[]@list = [];
            MUTABLE rootVals: String[]@list = [];
            rootKeys.append(medKey);
            rootVals.append(medVal);
            newRoot = nodes.length();
            nodes.append(Node{ keys: rootKeys, vals: rootVals, numChildren: 2, isLeaf: FALSE });
            children[childKey(newRoot, 0)] = cur;
            children[childKey(newRoot, 1)] = rightIdx;
            root = newRoot;
        ELSE
            nodes[cur].keys = nk;
            nodes[cur].vals = nv;
        END
        ki += 1;
    END

    -- Verify tree after inserting [10, 20, 30, 40]
    -- mid = 4/2 = 2, so median = keys[2] = 30
    -- Expected: root(30) -> left(10, 20), right(40)
    ASSERT nodes[root].isLeaf == FALSE, "root is internal after split";
    ASSERT nodes[root].keys[0] == 30, "root median is 30";
    ASSERT nodes[root].numChildren == 2, "root has 2 children";

    -- Verify children
    lc = children[childKey(root, 0)] OR (0 - 1);
    rc = children[childKey(root, 1)] OR (0 - 1);
    ASSERT lc >= 0, "left child exists";
    ASSERT rc >= 0, "right child exists";
    ASSERT nodes[lc].keys[0] == 10, "left child first key is 10";
    ASSERT nodes[lc].keys[1] == 20, "left child second key is 20";
    ASSERT nodes[rc].keys[0] == 40, "right child has key 40";

    -- Search for key 20 (left subtree)
    MUTABLE searchIdx = root;
    MUTABLE searchResult = "";
    WHILE searchIdx >= 0 DO
        IF nodes[searchIdx].isLeaf THEN
            MUTABLE sk: Int64 = 0;
            WHILE sk < nodes[searchIdx].keys.length() DO
                IF nodes[searchIdx].keys[sk] == 20 THEN
                    searchResult = COPY nodes[searchIdx].vals[sk];
                END
                sk += 1;
            END
            searchIdx = 0 - 1;
        ELSE
            cp3 = findKeyIndex(nodes[searchIdx].keys, 20);
            searchIdx = children[childKey(searchIdx, cp3)] OR (0 - 1);
        END
    END
    ASSERT searchResult == "20", "tree search: key 20 found in left subtree";

    -- Search for key 40 (right subtree)
    searchIdx = root;
    searchResult = "";
    WHILE searchIdx >= 0 DO
        IF nodes[searchIdx].isLeaf THEN
            MUTABLE sk2: Int64 = 0;
            WHILE sk2 < nodes[searchIdx].keys.length() DO
                IF nodes[searchIdx].keys[sk2] == 40 THEN
                    searchResult = COPY nodes[searchIdx].vals[sk2];
                END
                sk2 += 1;
            END
            searchIdx = 0 - 1;
        ELSE
            cp4 = findKeyIndex(nodes[searchIdx].keys, 40);
            searchIdx = children[childKey(searchIdx, cp4)] OR (0 - 1);
        END
    END
    ASSERT searchResult == "40", "tree search: key 40 found in right subtree";

    -- ENUM dispatch on all variants
    MUTABLE opCount: Int64 = 0;
    MATCH Op.Get START Op.Get -> opCount += 1;, DEFAULT -> opCount += 0; END
    MATCH Op.Put START Op.Put -> opCount += 1;, DEFAULT -> opCount += 0; END
    MATCH Op.Delete START Op.Delete -> opCount += 1;, DEFAULT -> opCount += 0; END
    MATCH Op.Scan START Op.Scan -> opCount += 1;, DEFAULT -> opCount += 0; END
    ASSERT opCount == 4, "ENUM: all 4 Op variants dispatched";

    print("LiteDB: all tests PASSED");
END
