# Footgun: Uninitialized Read — CLEAR
#
# CLEAR requires every variable to be assigned before use. The compiler
# performs definite-assignment analysis: a binding that might not have
# been initialized on all paths is a compile-time error.
#
# Additionally, CLEAR does not have a "declare without assign" syntax.
# Every `x = expr` declaration assigns immediately. The C pattern of
# `int x; ... x = value;` (declare then conditionally assign) does not
# exist — if you want to delay assignment you use an Option type.
#
# The zero-value guarantee: CLEAR does not zero-initialize variables
# (unlike Go). It enforces initialization through static analysis instead
# of runtime overhead. The result is the same safety property at lower cost.

STRUCT Triple {
  a: Int64,
  b: Int64,
  c: Int64
}

FN conditional_sum(n: Int64) RETURNS Int64 ->
  # sum must be assigned on every path.
  # In CLEAR there is no "declare without assign" — the assignment IS
  # the declaration. A conditional that may not execute cannot leave
  # sum uninitialized because sum doesn't exist until it's assigned.
  MUTABLE sum = 0;
  MUTABLE i = 0;
  WHILE i < n DO
    sum = sum + i;
    i = i + 1;
  END
  RETURN sum;
END

FN init_struct() RETURNS Triple ->
  # Every field must be provided in the struct literal.
  # Omitting a field is a compile-time error.
  RETURN Triple{ a: 1, b: 2, c: 0 };
END

FN main() RETURNS Void ->
  result = conditional_sum(0);
  print("conditional_sum(0) = " $+ result.toString());

  t = init_struct();
  print("t.c = " $+ t.c.toString());
END

# Summary:
#
# CLEAR vs Go vs Rust vs C on uninitialized reads:
#
#   C:     Runtime UB — garbage value, no error. Detectable only with
#          Valgrind / MSan.
#
#   Go:    Runtime zero-initialization — always safe, slight overhead
#          (zeroing stack frames and heap allocations).
#
#   Rust:  Compile-time definite-assignment analysis — safe, zero cost.
#          MaybeUninit<T> for explicit unsafe opt-out.
#
#   CLEAR: Compile-time definite-assignment analysis — safe, zero cost.
#          No "declare without assign" syntax eliminates the pattern
#          entirely. Option[T] for intentionally-absent values.
