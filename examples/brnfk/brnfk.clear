FN printableAscii() RETURNS String ->
  RETURN " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
END

FN incByte(n: Int64) RETURNS Int64 ->
  IF n >= 255 THEN
    RETURN 0;
  END
  RETURN n + 1;
END

FN decByte(n: Int64) RETURNS Int64 ->
  IF n <= 0 THEN
    RETURN 255;
  END
  RETURN n - 1;
END

FN byteToString(n: Int64) RETURNS !String ->
  IF n == 10 THEN
    RETURN "\n";
  END
  IF n >= 32 AND n <= 126 THEN
    RETURN "" + printableAscii().charAt(n - 32);
  END
  RAISE "brnfk cannot render non-printable byte ${n.toString()} as String";
END

FN bytesToString(bytes: Int64[]@list) RETURNS !String ->
  MUTABLE parts: String[]@list = [];
  parts.reserve(bytes.length());
  MUTABLE i = 0;
  WHILE i < bytes.length() DO
    parts.append(byteToString(bytes[i] OR_ELSE 0_i64));
    i += 1;
  END
  RETURN parts.join("");
END

FN ownedBytesToString(TAKES bytes: Int64[]@list) RETURNS !String ->
  RETURN bytesToString(bytes);
END

FN stringToByte(ch: String) RETURNS !Int64 ->
  IF ch == "\n" THEN
    RETURN 10;
  END

  ascii = printableAscii();
  MUTABLE i = 0;
  WHILE i < ascii.length() DO
    IF ascii.charAt(i) == ch THEN
      RETURN i + 32;
    END
    i += 1;
  END

  RAISE "brnfk input contains unsupported non-printable character";
END

FN stringToBytes(s: String) RETURNS !Int64[]@list ->
  MUTABLE bytes: Int64[]@list = [];
  bytes.reserve(s.length());
  MUTABLE i = 0;
  WHILE i < s.length() DO
    bytes.append(stringToByte(s.charAt(i)));
    i += 1;
  END
  RETURN bytes;
END

FN copyBytes(bytes: Int64[]@list) RETURNS !Int64[]@list ->
  MUTABLE copied: Int64[]@list = [];
  copied.reserve(bytes.length());
  MUTABLE i = 0;
  WHILE i < bytes.length() DO
    copied.append(bytes[i] OR_ELSE 0_i64);
    i += 1;
  END
  RETURN copied;
END

FN isCommand(ch: String) RETURNS Bool ->
  RETURN ch == ">" OR ch == "<" OR ch == "+" OR ch == "-" OR
  ch == "." OR ch == "," OR ch == "[" OR ch == "]";
END

FN commands(program: String) RETURNS !String ->
  MUTABLE parts: String[]@list = [];
  MUTABLE i = 0;
  WHILE i < program.length() DO
    ch = program.charAt(i);
    IF isCommand(ch) THEN
      parts.append(ch);
    END
    i += 1;
  END
  RETURN parts.join("");
END

FN makeTape(size: Int64) RETURNS !Int64[]@list ->
  IF size <= 0 THEN
    RAISE "brnfk tape size must be positive";
  END

  MUTABLE tape: Int64[]@list = [];
  tape.reserve(size);
  MUTABLE i = 0;
  WHILE i < size DO
    tape.append(0);
    i += 1;
  END
  RETURN tape;
END

FN makeJumpTable(program: String) RETURNS !Int64[]@list ->
  MUTABLE jumps: Int64[]@list = [];
  jumps.reserve(program.length());
  MUTABLE i = 0;
  WHILE i < program.length() DO
    jumps.append(-1);
    i += 1;
  END

  MUTABLE stack: Int64[]@list = [];
  i = 0;
  WHILE i < program.length() DO
    ch = program.charAt(i);
    IF ch == "[" THEN
      stack.append(i);
    ELSE_IF ch == "]" THEN
      open = stack.pop() OR_ELSE -1;
      IF open < 0 THEN
        RAISE "brnfk unmatched ] at instruction ${i.toString()}";
      END
      jumps[open] = i;
      jumps[i] = open;
    END
    i += 1;
  END

  IF stack.any?() THEN
    open = stack.pop() OR_ELSE -1;
    RAISE "brnfk unmatched [ at instruction ${open.toString()}";
  END

  RETURN jumps;
END

FN run(program: String, input: String) RETURNS !String ->
  RETURN runWithLimits(program, input, 30_000, 10_000_000);
END

FN runBytes(program: String, input: String) RETURNS !Int64[]@list ->
  RETURN runBytesWithLimits(program, input, 30_000, 10_000_000);
END

FN runFile(path: String, input: String) RETURNS !String ->
  RETURN runFileWithLimits(path, input, 30_000, 10_000_000);
END

FN runFileBytes(path: String, input: String) RETURNS !Int64[]@list ->
  RETURN runFileBytesWithLimits(path, input, 30_000, 10_000_000);
END

FN runFileWithLimits(path: String, input: String, tapeSize: Int64, maxSteps: Int64) RETURNS !String ->
  bytes = runFileBytesWithLimits(path, input, tapeSize, maxSteps) OR_ELSE RAISE;
  RETURN ownedBytesToString(GIVE bytes);
END

FN runFileBytesWithLimits(path: String, input: String, tapeSize: Int64, maxSteps: Int64) RETURNS !Int64[]@list ->
  program = readFile(path) OR_ELSE RAISE;
  RETURN runBytesWithLimits(program, input, tapeSize, maxSteps);
END

FN runWithLimits(program: String, input: String, tapeSize: Int64, maxSteps: Int64) RETURNS !String ->
  bytes = runBytesWithLimits(program, input, tapeSize, maxSteps) OR_ELSE RAISE;
  RETURN ownedBytesToString(GIVE bytes);
END

FN runBytesWithLimits(program: String, input: String, tapeSize: Int64, maxSteps: Int64) RETURNS !Int64[]@list ->
  inputBytes = stringToBytes(input) OR_ELSE RAISE;
  RETURN runOwnedByteInputWithLimits(program, GIVE inputBytes, tapeSize, maxSteps);
END

FN runByteInputWithLimits(
    program: String,
    inputBytes: Int64[]@list,
    tapeSize: Int64,
    maxSteps: Int64
)
RETURNS !Int64[]@list ->
  ownedInput = copyBytes(inputBytes) OR_ELSE RAISE;
  RETURN runOwnedByteInputWithLimits(program, GIVE ownedInput, tapeSize, maxSteps);
END

FN runOwnedByteInputWithLimits(
    program: String,
    TAKES inputBytes: Int64[]@list,
    tapeSize: Int64,
    maxSteps: Int64
)
RETURNS !Int64[]@list ->
  code = commands(program);
  jumps = makeJumpTable(code);
  MUTABLE tape = makeTape(tapeSize);
  MUTABLE pointer = 0;
  MUTABLE ip = 0;
  MUTABLE inputPos = 0;
  MUTABLE steps = 0;
  MUTABLE output: Int64[]@list = [];

  WHILE ip < code.length() DO
    IF steps >= maxSteps THEN
      RAISE "brnfk exceeded max step count";
    END

    op = code.charAt(ip);
    IF op == ">" THEN
      pointer += 1;
      IF pointer >= tape.length() THEN
        RAISE "brnfk pointer moved past tape end";
      END
    ELSE_IF op == "<" THEN
      IF pointer == 0 THEN
        RAISE "brnfk pointer moved before tape start";
      END
      pointer -= 1;
    ELSE_IF op == "+" THEN
      tape[pointer] = incByte(tape[pointer] OR_ELSE 0_i64);
    ELSE_IF op == "-" THEN
      tape[pointer] = decByte(tape[pointer] OR_ELSE 0_i64);
    ELSE_IF op == "." THEN
      output.append(tape[pointer] OR_ELSE 0_i64);
    ELSE_IF op == "," THEN
      IF inputPos < inputBytes.length() THEN
        tape[pointer] = inputBytes[inputPos] OR_ELSE 0_i64;
        inputPos += 1;
      END
    ELSE_IF op == "[" THEN
      IF (tape[pointer] OR_ELSE 0_i64) == 0 THEN
        ip = jumps[ip] OR_ELSE ip;
      END
    ELSE_IF op == "]" THEN
      IF (tape[pointer] OR_ELSE 0_i64) != 0 THEN
        ip = jumps[ip] OR_ELSE ip;
      END
    END

    ip += 1;
    steps += 1;
  END

  RETURN output;
END
