REQUIRE "brnfk.clear";

FN testPath(name: String) RETURNS !String ->
  RETURN "../../examples/brnfk/tests/" $+ name;
END

FN expectedSquares() RETURNS !String ->
  MUTABLE lines: []String = [];
  MUTABLE i = 0;
  WHILE i <= 100 DO
    lines.append((i * i).toString());
    lines.append("\n");
    i += 1;
  END
  RETURN lines.join("");
END

FN main() RETURNS Void ->
  ASSERT runFile(testPath("null.b") OR_ELSE RAISE, "") == "", "null.b produces no output";
  ASSERT runFile(testPath("rot13.b") OR_ELSE RAISE, "~mlk zyx") == "~zyx mlk", "rot13.b transforms known input";
  ASSERT runFile(testPath("xmastree.b") OR_ELSE RAISE, "") == "*\n", "xmastree.b smoke output";
  ASSERT runFile(testPath("squares.b") OR_ELSE RAISE, "") == expectedSquares(), "squares.b prints 0..100 squared";

  ioProbe = ">,>+++++++++,>+++++++++++[<++++++<++++++<+>>>-]<<.>.<<-.>.>.<<.";
  ASSERT runWithLimits(ioProbe, "\n", 30_000, 100_000) == "LK\nLK\n", "Cristofani newline/EOF probe";

  obscureProbe = "[]++++++++++[>>+>+>++++++[<<+<+++>>>-]<<<<-]" $+
  "\"A*$\";?@![#>>+<<]>[>>]<<<<[>++<[-]]>.>.";
  ASSERT runWithLimits(obscureProbe, "", 30_000, 1_000_000) == "H\n", "Cristofani obscure parser probe";

  RETURN;
END
