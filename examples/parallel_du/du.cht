-- Parallel du — recursive directory size calculator
--
-- Scans a directory tree, summing file sizes.
-- Exercises: File I/O (fileSize, listAll), string parsing, recursion.
--
-- Usage: ./du
-- Compare: du -sb .

FN scanDir(path: String) RETURNS Int64 @reentrant ->
    entries = listAll(path);
    MUTABLE total: Int64 = 0;

    MUTABLE i: Int64 = 0;
    WHILE i < entries.length() DO
        entry = entries[i];
        prefix = substr(entry, 0, 2);
        name = substr(entry, 2, entry.length() - 2);
        fullPath = path + "/" + name;

        IF prefix == "f:" THEN
            size = fileSize(fullPath);
            IF size > 0 THEN
                total += size;
            END
        ELSE_IF prefix == "d:" THEN
            total += scanDir(fullPath);
        END
        i += 1;
    END

    RETURN total;
END

FN cheatMain() RETURNS Void ->
    path = ".";
    total = scanDir(path);
    print(total.toString() + "\t" + path);
END
