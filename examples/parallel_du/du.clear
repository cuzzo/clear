# pdu: parallel recursive directory size calculator
#
# Scans the current directory tree, summing apparent file sizes.
# Uses a concurrent pipeline so independent entries can run in parallel.
#
# Usage: ./pdu
# Compare: du -sb . or diskus --apparent-size .

FN entrySize(entry: String)
 RETURNS !Int64
 EFFECTS REENTRANT
->
  fullPath = entry.substr(2, entry.length() - 2);
  prefix = entry.substr(0, 2);

  IF prefix == "f:" THEN
    RETURN fullPath.fileSize();
  ELSE_IF prefix == "d:" THEN
    RETURN scanDir(fullPath);
  END

  RETURN 0;
END

FN scanDir(path: String)
 RETURNS !Int64
 EFFECTS REENTRANT
->
  entries = path.listAll()
    |> SELECT "${substr(_, 0, 2)}${path}/${substr(_, 2, _.length() - 2)}";

  children = entries
    |> CONCURRENT SELECT entrySize(_)
    |> REDUCE(0) acc + _;

  RETURN path.fileSize() + children;
END

FN main() RETURNS Void ->
  path = ".";
  total = TRY scanDir(path);
  print("${total.toString()}\t${path}");
END
