# S-expression parser for the Mal interpreter.
# Tokenizes input strings into HashMap<Value> and reads S-expressions.

REQUIRE "types.clear";

FN readAtom(token: String) RETURNS !Value ->
    IF token.length() == 0 THEN RETURN Value.Nil; END
    IF token == "nil" THEN RETURN Value.Nil; END
    IF token == "true" THEN RETURN Value.TrueVal; END
    IF token == "false" THEN RETURN Value.FalseVal; END
    IF charAt(token, 0) == "\"" THEN RETURN Value{ Str: substr(token, 1, token.length() - 2) }; END

    # Typed literals: 42:i64, 3.14:f64
    IF contains?(token, ":i64") THEN
        numPart = substr(token, 0, token.length() - 4);
        n = toNumber(numPart) OR_ELSE (0.0 - 999999.0);
        IF n != 0.0 - 999999.0 THEN
            intVal = toInt(n);
            RETURN Value{ Int64Val: intVal };
        END
    END
    IF contains?(token, ":f64") THEN
        numPart = substr(token, 0, token.length() - 4);
        n = toNumber(numPart) OR_ELSE (0.0 - 999999.0);
        IF n != 0.0 - 999999.0 THEN RETURN Value{ Number: n }; END
    END

    n = toNumber(token) OR_ELSE (0.0 - 999999.0);
    IF n != 0.0 - 999999.0 THEN RETURN Value{ Number: n }; END
    RETURN Value{ Symbol: COPY token };
END

# Parser: tokenize into HashMap<Value> with numeric position tracking.
# Tokens stored as Value.Str at keys "__t0", "__t1", etc.
# Position and count stored as Value.Number at "__rp" and "__tc".
# This avoids toString() inside WHILE loops for position updates.

FN isWhitespace?(c: String) RETURNS Bool ->
    RETURN c == " " OR c == "," OR c == "\n" OR c == "\t";
END

FN isDelimiter?(c: String) RETURNS Bool ->
    RETURN c == " " OR c == "," OR c == "\n" OR c == "\t" OR c == "(" OR c == ")" OR c == "[" OR c == "]" OR c == "\"" OR c == ";";
END

FN tokenizeToEnv(MUTABLE penv: {String}Value, str: String) RETURNS !Void ->
    MUTABLE count: Int64 = 0;
    MUTABLE i: Int64 = 0;
    len = str.length();
    WHILE i < len DO
        c = charAt(str, i);
        IF isWhitespace?(c) THEN i += 1;
        ELSE_IF c == "(" OR c == ")" OR c == "[" OR c == "]" THEN
            penv["__t" $+ count.toString()] = Value{ Str: COPY c };
            count += 1;
            i += 1;
        ELSE_IF c == ";" THEN
            WHILE i < len AND charAt(str, i) != "\n" DO i += 1; END
        ELSE_IF c == "\"" THEN
            # String literal: scan for closing quote, extract with substr
            start = i;
            i += 1;
            WHILE i < len AND charAt(str, i) != "\"" DO
                i += 1;
            END
            IF i < len THEN i += 1; END
            penv["__t" $+ count.toString()] = Value{ Str: COPY substr(str, start, i - start) };
            count += 1;
        ELSE
            # Symbol/number: scan to next delimiter, extract with substr
            start = i;
            WHILE i < len AND isDelimiter?(charAt(str, i)) == FALSE DO
                i += 1;
            END
            IF i > start THEN
                penv["__t" $+ count.toString()] = Value{ Str: COPY substr(str, start, i - start) };
                count += 1;
            END
        END
    END
    penv["__tc"] = Value{ Number: toFloat(count) };
    RETURN;
END

FN getTokenStr(MUTABLE penv: {String}Value, idx: Int64) RETURNS !String ->
    val = penv["__t" $+ idx.toString()] OR_ELSE Value.Nil;
    RETURN getStr(val);
END

FN readFormEnv(MUTABLE penv: {String}Value) RETURNS !Value EFFECTS REENTRANT ->
    posVal = penv["__rp"] OR_ELSE Value{ Number: 0.0 };
    tcVal = penv["__tc"] OR_ELSE Value{ Number: 0.0 };
    pos = toInt(getNum(posVal));
    tc = toInt(getNum(tcVal));
    tok = getTokenStr(&penv, pos) OR_ELSE RAISE;

    IF pos >= tc THEN
        RETURN Value.Nil;
    END

    IF tok == "(" OR tok == "[" THEN
        penv["__rp"] = Value{ Number: toFloat(pos + 1) };
        RETURN readListEnv(&penv) OR_ELSE RAISE;
    END

    penv["__rp"] = Value{ Number: toFloat(pos + 1) };
    RETURN readAtom(tok) OR_ELSE RAISE;
END

FN readListEnv(MUTABLE penv: {String}Value) RETURNS !Value EFFECTS REENTRANT ->
    MUTABLE items: []Value = List[];
    MUTABLE listDone = FALSE;
    WHILE listDone == FALSE DO
        curPosVal = penv["__rp"] OR_ELSE Value{ Number: 0.0 };
        tcVal2 = penv["__tc"] OR_ELSE Value{ Number: 0.0 };
        curPos = toInt(getNum(curPosVal));
        tc2 = toInt(getNum(tcVal2));
        IF curPos >= tc2 THEN listDone = TRUE;
        ELSE
            curTok = getTokenStr(&penv, curPos) OR_ELSE RAISE;
            IF curTok == ")" OR curTok == "]" THEN
                penv["__rp"] = Value{ Number: toFloat(curPos + 1) };
                listDone = TRUE;
            ELSE
                item = readFormEnv(&penv) OR_ELSE RAISE;
                &items.append(item);
            END
        END
    END
    RETURN Value{ List: items };
END
