-- Debugger support for the Mal interpreter.
-- File-based debug pause (tree-walker) and helpers.
-- Depends on Value union, eval!, prStr, envGet! from interpreter.cht.

FN readFileOr!(path: String, fallback: String, MUTABLE pool: Env[50000]@pool) RETURNS !String ->
    content = readFile(path) OR RAISE;
    RETURN content;
END

FN readFileSafe!(path: String, MUTABLE pool: Env[50000]@pool) RETURNS String ->
    content = readFileOr!(path, "", pool) OR "";
    RETURN content;
END

-- Debug pause: writes break info, polls for commands, resumes on :c/:s/:n/:f.
-- Returns the debug action: 0=continue, 1=step-into, 2=step-over, 3=step-out

FN debugPause!(reason: String, envId: Id<Env>, MUTABLE pool: Env[50000]@pool) RETURNS Int64 @reentrant ->
    -- Build call stack string
    stackStr = envGet!(envId, "__dbg_stack", pool);
    stackDisplay = getStr(stackStr);

    -- Write break info
    MUTABLE breakInfo = COPY reason;
    IF stackDisplay.length() > 0 THEN
        breakInfo = breakInfo + "\n  stack: " + stackDisplay;
    END
    writeFile("/tmp/_debug_break.txt", breakInfo);

    MUTABLE debugAction: Int64 = 0;
    MUTABLE debugActive = TRUE;
    WHILE debugActive DO
        MUTABLE cmdRaw = readFileSafe!("/tmp/_debug_cmd.txt", pool);
        IF cmdRaw.length() > 0 THEN
            writeFile("/tmp/_debug_cmd.txt", "");
            IF cmdRaw == ":c" || cmdRaw == ":continue" THEN
                debugAction = 0; debugActive = FALSE;
            ELSE_IF cmdRaw == ":s" || cmdRaw == ":step" THEN
                debugAction = 1; debugActive = FALSE;
            ELSE_IF cmdRaw == ":n" || cmdRaw == ":next" THEN
                debugAction = 2; debugActive = FALSE;
            ELSE_IF cmdRaw == ":f" || cmdRaw == ":finish" THEN
                debugAction = 3; debugActive = FALSE;
            ELSE_IF startsWith?(cmdRaw, ":i ") THEN
                inspectExpr = substr(cmdRaw, 3, cmdRaw.length() - 3);
                MUTABLE inspPenv: HashMap<Value> = {};
                tokenizeToEnv!(inspPenv, inspectExpr);
                inspPenv["__rp"] = Value{ Number: 0.0 };
                inspAst = readFormEnv!(inspPenv);
                inspResult = eval!(COPY inspAst, envId, pool);
                writeFile("/tmp/_debug_resp.txt", prStr(inspResult, TRUE));
            ELSE_IF cmdRaw == ":l" || cmdRaw == ":locals" THEN
                -- Dump all known variable names from locals tracking
                localsStr = envGet!(envId, "__dbg_locals", pool);
                MUTABLE localDump = "";
                IF getStr(localsStr).length() > 0 THEN
                    localDump = getStr(localsStr);
                ELSE
                    localDump = "(no tracked locals)";
                END
                writeFile("/tmp/_debug_resp.txt", localDump);
            ELSE_IF cmdRaw == ":w" || cmdRaw == ":where" || cmdRaw == ":bt" THEN
                IF stackDisplay.length() > 0 THEN
                    writeFile("/tmp/_debug_resp.txt", stackDisplay);
                ELSE
                    writeFile("/tmp/_debug_resp.txt", "(top level)");
                END
            ELSE
                writeFile("/tmp/_debug_resp.txt", "commands: :c :s :n :f :i <expr> :l :w");
            END
        END
    END
    writeFile("/tmp/_debug_break.txt", "");
    RETURN debugAction;
END
