# Benchmark: tight integer loop summing 0..9_999_999.

FN main() RETURNS Void ->
    # Verify
    MUTABLE s: Int64 = 0;
    MUTABLE i: Int64 = 0;
    WHILE i < 10000000 DO
        s += i;
        i += 1;
    END
    print("sum(0..9999999) = " $+ s.toString());
    ASSERT s == 49999995000000;

    # Timed: 3 iterations
    startMs = timestampMs();
    MUTABLE iter: Int64 = 0;
    WHILE iter < 3 DO
        MUTABLE ts: Int64 = 0;
        MUTABLE ti: Int64 = 0;
        WHILE ti < 10000000 DO
            ts += ti;
            ti += 1;
        END
        iter += 1;
    END
    endMs = timestampMs();
    elapsed = endMs - startMs;
    print("CLEAR native: 3 iterations in " $+ elapsed.toString() $+ "ms");
    RETURN;
END
