                    mapReg = ops[ip]; ip += 1;
                    keyIdx = ops[ip]; ip += 1;
                    mapKey = getRegisterConstString(consts, keyIdx) OR_ELSE RAISE;
                    IF mapReg == 0 THEN map0.delete(mapKey);
                    ELSE_IF mapReg == 1 THEN map1.delete(mapKey);
                    ELSE_IF mapReg == 2 THEN map2.delete(mapKey);
                    ELSE_IF mapReg == 3 THEN map3.delete(mapKey); END,
            RegisterOp.NMPutI ->
                # NMPUTI map key_reg src
                    mapReg = ops[ip]; ip += 1;
                    keyReg = ops[ip]; ip += 1;
                    src = ops[ip]; ip += 1;
