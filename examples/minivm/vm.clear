                    IF mapReg == 0 THEN iregs[iBase + dst] = nmap0[iregs[iBase + keyReg]] OR_ELSE iregs[iBase + fallback];
                    ELSE_IF mapReg == 1 THEN iregs[iBase + dst] = nmap1[iregs[iBase + keyReg]] OR_ELSE iregs[iBase + fallback];
                    ELSE_IF mapReg == 2 THEN iregs[iBase + dst] = nmap2[iregs[iBase + keyReg]] OR_ELSE iregs[iBase + fallback];
                    ELSE_IF mapReg == 3 THEN iregs[iBase + dst] = nmap3[iregs[iBase + keyReg]] OR_ELSE iregs[iBase + fallback]; END,
