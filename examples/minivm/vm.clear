                    ELSE_IF mapReg == 1 THEN nmap1[iregs[iBase + keyReg]] = iregs[iBase + src];
                    ELSE_IF mapReg == 2 THEN nmap2[iregs[iBase + keyReg]] = iregs[iBase + src];
                    ELSE_IF mapReg == 3 THEN nmap3[iregs[iBase + keyReg]] = iregs[iBase + src]; END,
            RegisterOp.NMGetI ->
