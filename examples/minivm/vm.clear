# Register bytecode VM for examples/minivm.
#
# This file intentionally only interprets already-emitted register bytecode.
# The Ruby harness writes ops/consts files, then builds a tiny generated main
# that calls runRegisterBytecode!(...).

REQUIRE "register_debugger_types.clear";
REQUIRE "register_debugger.clear";

UNION RegisterValue {
    Nil,
    Int64Val: Int64,
    Number: Float64,
    Str: String,
    # futureTable index; produced by BGSPAWN, consumed by FNEXT.
    Future: Int64,
}

