# Benchmark: create array of 10000 integers, filter evens, sum them.
# Compares typed (Int64[]) vs untyped paths.

FN main() RETURNS Void ->
    # Build array of 0..9999
    MUTABLE nums: Int64[] = [];
    MUTABLE i = 0_i64;
    WHILE i < 10000 DO
        nums.append(i);
        i = i + 1_i64;
    END

    # Filter even numbers and sum
    MUTABLE sum = 0_i64;
    MUTABLE j = 0_i64;
    WHILE j < nums.length() DO
        n = nums[j];
        IF n MOD 2 == 0 THEN
            sum = sum + n;
        END
        j = j + 1_i64;
    END

    print("Sum of evens 0..9999: " + sum.toString());
    ASSERT sum == 24995000, "sum check";

    RETURN;
END
