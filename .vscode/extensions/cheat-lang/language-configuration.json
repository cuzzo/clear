{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "(.*\\s(DO|THEN|->)\\s*$)|(.*\\{\\s*$)|(\\bSTRUCT\\s+\\w+\\s*\\{\\s*$)|(\\bENUM\\s+\\w+\\s*\\{\\s*$)|(\\bUNION\\s+\\w+\\s*\\{\\s*$)",
    "decreaseIndentPattern": "^\\s*(END|\\}|ELSE|ELSE_IF|CATCH)\\b"
  },
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)"
}
