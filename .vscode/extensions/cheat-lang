{
  "name": "cheat-lang",
  "displayName": "CHEAT Language Support",
  "description": "Syntax highlighting for the CHEAT programming language",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "cheat",
      "aliases": ["Cheat", "cheat"],
      "extensions": [".cht"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "cheat",
      "scopeName": "source.cheat",
      "path": "./syntaxes/cheat.tmLanguage.json"
    }]
  }
}
