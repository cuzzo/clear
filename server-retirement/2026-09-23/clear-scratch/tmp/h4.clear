UNION KwValue { StringValue: String, Int64Value: Int64 }
FN takes_map(a: {String@symbol}KwValue) RETURNS Void -> print("${a.length().toString()}"); END
FN takes_one(a: KwValue) RETURNS Void -> print("x"); END
FN main() RETURNS Int64
->
  MUTABLE kw: {String@symbol}KwValue = {};
  fallback = KwValue{ StringValue: COPY "" };
  kw[:type] = KwValue{ StringValue: COPY "x" };
  takes_map({:type: (kw[:type] OR_ELSE fallback)});
  RETURN 0;
END
