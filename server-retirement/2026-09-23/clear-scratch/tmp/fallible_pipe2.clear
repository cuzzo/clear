STRUCT Ctx { depth: Int64 }

FN ctx__deep?(MUTABLE self: Ctx, n: Int64) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE view {
  IF n < 0 THEN
    RAISE "negative";
  END
  RETURN n > view.depth;
}
END

FN ctx__all_deep?(MUTABLE self: Ctx, items: []Int64) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE view {
  RETURN items |> ALL TRY (ctx__deep?(&view, _));
}
END

FN main() RETURNS !Void ->
  MUTABLE c: Ctx = Ctx{ depth: 2 };
  MUTABLE a: Bool = TRY (ctx__all_deep?(&c, [3, 4, 5]));
  IF a THEN
    print("all-deep");
  ELSE
    print("not-all");
  END
END
