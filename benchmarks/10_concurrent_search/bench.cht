-- Concurrent File Search Benchmark — CLEAR
--
-- Opens all files in a directory, counts occurrences of a needle string
-- in each file concurrently using fibers, then reports top-10 by count.
--
-- CLEAR (this file): One fiber per file via ~Int64[]@list (promise list).
--   - Cooperative M:1 scheduler; readFile yields before blocking so all fibers
--     interleave rather than running strictly sequentially.
--   - ~2KB fiber stacks vs ~8KB goroutines vs 8MB OS threads.
--   - Each fiber: yield → readFile → countOccurrences → return Int64.
--
-- Go (bench.go):   One goroutine per file, GOMAXPROCS=num_cpu M:N parallelism.
-- Rust (bench.rs): One OS thread per file, std::thread::spawn full parallelism.
--
-- DATASET: 128 files × ~10KB each = ~1.28MB total; needle = "the"
-- Data generated by running any of the three benchmarks once.
--
-- COMPILE (via benchmarks/runner.rb):
--   CLEAR:  ruby src/transpiler.rb bench.cht > zig/bench.zig
--           zig build-exe zig/bench.zig zig/switch.S zig/onRoot.S \
--               --name bench_clear -O ReleaseFast -lc

STRUCT SearchResult { filename: String, count: Int64 }

FN main() RETURNS Void ->
    t0 = timestampMs();
    needle = "the";
    data_dir = "benchmarks/10_concurrent_search/data";

    -- List all files in the data directory (filenames only, not full paths).
    files = listDir(data_dir);
    n: Int64 = files.length();

    -- Spawn one fiber per file using a promise list.
    -- append(futures, BG { ... }) adds a Promise(i64) to the ArrayList.
    -- loop_appends_outer_list? ensures mark_per_iter = false (no frame rewind
    -- per iteration, so captured 'filepath' slices stay valid until NEXT).
    MUTABLE futures: ~Int64[]@list = [];
    MUTABLE i: Int64 = 0;
    WHILE i < n DO
        filepath = "${data_dir}/${files[i]}";
        futures.append(BG {
            content = readFile(filepath);
            countOccurrences(content, needle);
        });
        i += 1;
    END

    -- Collect results by NEXTing each promise in order.
    -- futures[j] returns a CheatLib.Promise(i64) by value;
    -- NEXT calls .next() which blocks until the fiber completes.
    -- files[j] gives the actual filename for future j, regardless of listDir order.
    MUTABLE results: SearchResult[]@list = [];
    MUTABLE j: Int64 = 0;
    WHILE j < n DO
        c: Int64 = NEXT futures[j];
        results.append(SearchResult{ filename: files[j], count: c });
        j += 1;
    END

    -- Selection sort: find top-10 by swapping into the first 10 positions.
    MUTABLE k: Int64 = 0;
    WHILE k < 10 DO
        MUTABLE best: Int64 = k;
        MUTABLE m: Int64 = k + 1;
        WHILE m < n DO
            IF results[m].count > results[best].count THEN
                best = m;
            END
            m += 1;
        END
        IF best != k THEN
            tmp = results[k];
            results[k] = results[best];
            results[best] = tmp;
        END
        k += 1;
    END

    -- Print top 10.
    print("Top 10 files by '", needle, "' count:");
    MUTABLE p: Int64 = 0;
    WHILE p < 10 DO
        r = results[p];
        print("  ", r.filename, "  ", r.count);
        p += 1;
    END

    elapsed = timestampMs() - t0;
    print("Time: ${elapsed.toString()} ms");
    RETURN;
END
