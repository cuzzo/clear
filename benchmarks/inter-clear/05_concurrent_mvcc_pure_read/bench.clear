# 17b: MVCC vs RwLock under PURE READ stress (no writers).
#
# Why this scenario: with NO writers, RwLock readers shouldn't have any
# contention -- they all hold a shared mode. But the rwlock implementation
# still has to atomically update the reader-count on the lock state cache
# line on every acquire/release. With 32 readers on 32 cores, all 32 cores
# contend for that one cache line via cache-coherence traffic. Throughput
# is bottlenecked on the inter-core MESI protocol, not on actual work.
#
# MVCC reads are pure local operations: an acquire-load of an immutable
# pointer + a thread-local EBR pin (one store to a per-thread slot). No
# inter-core write traffic. Throughput scales linearly with cores.
#
# This is the cleanest 5-10x scenario. If it doesn't show that gap on
# 32 cores, something is wrong with the EBR pin path or with the lock's
# read fast path.
#
# Workload: 32 readers x 200k iters; ZERO writers.

STRUCT Counter { value: Int64 }

FN main() RETURNS Void ->
    n_readers:  Int64 = 32_i64;
    reads_per:  Int64 = 200000_i64;
    total_reads: Int64 = n_readers * reads_per;

    # ---------- Variant A: @shared:writeLocked (RwLock) ----------
    MUTABLE c_rw = Counter{ value: 42_i64 } @shared:writeLocked;

    t0_rw = timestampMs();

    MUTABLE rw_readers: ~Int64[]@list = [];
    FOR r IN (0_i64 ..< n_readers) DO
        &rw_readers.append(BG { @parallel ->
            MUTABLE s: Int64 = 0_i64;
            MUTABLE i: Int64 = 0_i64;
            WHILE i < reads_per DO
                WITH c_rw AS v { s = s + v.value; }
                i = i + 1_i64;
            END
            s;
        });
    END

    MUTABLE s_rw: Int64 = 0_i64;
    FOR r IN (0_i64 ..< n_readers) DO IF rw_readers[r] EXISTS AS future THEN s_rw = s_rw + (NEXT future); END END
    elapsed_rw_ms = timestampMs() - t0_rw;

    # ---------- Variant B: @shared:versioned (MVCC) ----------
    MUTABLE c_v = Counter{ value: 42_i64 } @shared:versioned;

    t0_v = timestampMs();

    MUTABLE v_readers: ~Int64[]@list = [];
    FOR r IN (0_i64 ..< n_readers) DO
        &v_readers.append(BG { @parallel ->
            MUTABLE s: Int64 = 0_i64;
            MUTABLE i: Int64 = 0_i64;
            WHILE i < reads_per DO
                WITH SNAPSHOT c_v AS view { s = s + view.value; }
                i = i + 1_i64;
            END
            s;
        });
    END

    MUTABLE s_v: Int64 = 0_i64;
    FOR r IN (0_i64 ..< n_readers) DO IF v_readers[r] EXISTS AS future THEN s_v = s_v + (NEXT future); END END
    elapsed_v_ms = timestampMs() - t0_v;

    # ---------- Report ----------
    rw_rate_ms = IF elapsed_rw_ms > 0_i64 THEN elapsed_rw_ms ELSE 1_i64 END;
    v_rate_ms = IF elapsed_v_ms > 0_i64 THEN elapsed_v_ms ELSE 1_i64 END;
    rw_ops_per_sec = (total_reads * 1000_i64) / rw_rate_ms;
    v_ops_per_sec  = (total_reads * 1000_i64) / v_rate_ms;
    speedup_x100 = (rw_rate_ms * 100_i64) / v_rate_ms;

    print("\n=== Pure-read stress (no writers): ${n_readers.toString()} readers x ${reads_per.toString()} reads ===\n");
    print("BENCH_INFO: RwLock  ${elapsed_rw_ms.toString()} ms  (${rw_ops_per_sec.toString()} reads/sec)\n");
    print("BENCH_INFO: MVCC    ${elapsed_v_ms.toString()} ms  (${v_ops_per_sec.toString()} reads/sec)\n");
    print("BENCH_INFO: MVCC speedup vs RwLock: ${speedup_x100.toString()}/100 x\n");

    ASSERT s_rw == n_readers * reads_per * 42_i64, "rwlock sum sanity";
    ASSERT s_v  == n_readers * reads_per * 42_i64, "mvcc sum sanity";

    print("BENCH_RESULT: ${elapsed_v_ms.toString()} ms\n");
    RETURN;
END
