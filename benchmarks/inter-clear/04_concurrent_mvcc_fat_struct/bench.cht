-- 17a: MVCC vs RwLock with a FAT STRUCT and multi-field reads.
--
-- Why this scenario: 03_concurrent_mvcc_vs_rwlock uses a single Int64 cell. The read
-- critical section is one cache-line load (~1ns of work), so the ~10-30ns
-- lock-acquire / EBR-pin overhead dominates and the speedup compresses to
-- ~2x. This bench reads 8 fields per CS so the relative cost of the
-- lock/pin amortizes across more useful work, and any RwLock contention
-- scales with the wider critical section.
--
-- Workload: 32 readers x 80k iters; each iter does ONE acquire and reads
-- all 8 fields inside the CS, summing them. 4 sparse writers do 1k
-- field-bumps each.
--
-- Expected on 32 cores: 3-5x MVCC win over RwLock. Below that means the
-- EBR pin or the WITH-block lowering is leaving free cycles on the table.

STRUCT Sample {
    a: Int64, b: Int64, c: Int64, d: Int64,
    e: Int64, f: Int64, g: Int64, h: Int64
}

FN main() RETURNS Void ->
    n_readers:  Int64 = 32_i64;
    reads_per:  Int64 = 80000_i64;
    n_writers:  Int64 = 4_i64;
    writes_per: Int64 = 1000_i64;
    total_reads: Int64 = n_readers * reads_per;

    -- ---------- Variant A: @shared:writeLocked (RwLock) ----------
    MUTABLE c_rw = Sample{ a: 1_i64, b: 2_i64, c: 3_i64, d: 4_i64,
                            e: 5_i64, f: 6_i64, g: 7_i64, h: 8_i64 } @shared:writeLocked;

    t0_rw = timestampMs();

    MUTABLE rw_readers: ~Int64[]@list = [];
    FOR r IN (0_i64 ..< n_readers) DO
        rw_readers.append(BG { @parallel ->
            MUTABLE s: Int64 = 0_i64;
            MUTABLE i: Int64 = 0_i64;
            WHILE i < reads_per DO
                WITH c_rw AS v {
                    s = s + v.a + v.b + v.c + v.d + v.e + v.f + v.g + v.h;
                }
                i = i + 1_i64;
            END
            s;
        });
    END

    MUTABLE rw_writers: ~Void[]@list = [];
    FOR w IN (0_i64 ..< n_writers) DO
        rw_writers.append(BG { @parallel ->
            MUTABLE i: Int64 = 0_i64;
            WHILE i < writes_per DO
                WITH EXCLUSIVE c_rw AS inner { inner.a = inner.a + 1_i64; }
                i = i + 1_i64;
            END
        });
    END

    MUTABLE s_rw: Int64 = 0_i64;
    FOR r IN (0_i64 ..< n_readers) DO s_rw = s_rw + (NEXT rw_readers[r]); END
    FOR w IN (0_i64 ..< n_writers) DO NEXT rw_writers[w]; END
    elapsed_rw_ms = timestampMs() - t0_rw;

    -- ---------- Variant B: @shared:versioned (MVCC) ----------
    MUTABLE c_v = Sample{ a: 1_i64, b: 2_i64, c: 3_i64, d: 4_i64,
                           e: 5_i64, f: 6_i64, g: 7_i64, h: 8_i64 } @shared:versioned;

    t0_v = timestampMs();

    MUTABLE v_readers: ~Int64[]@list = [];
    FOR r IN (0_i64 ..< n_readers) DO
        v_readers.append(BG { @parallel ->
            MUTABLE s: Int64 = 0_i64;
            MUTABLE i: Int64 = 0_i64;
            WHILE i < reads_per DO
                WITH SNAPSHOT c_v AS view {
                    s = s + view.a + view.b + view.c + view.d + view.e + view.f + view.g + view.h;
                }
                i = i + 1_i64;
            END
            s;
        });
    END

    MUTABLE v_writers: ~Void[]@list = [];
    FOR w IN (0_i64 ..< n_writers) DO
        v_writers.append(BG { @parallel ->
            MUTABLE i: Int64 = 0_i64;
            WHILE i < writes_per DO
                WITH SNAPSHOT c_v AS MUTABLE va { va.a = va.a + 1_i64; } ON MvccConflict RAISE
                i = i + 1_i64;
            END
        });
    END

    MUTABLE s_v: Int64 = 0_i64;
    FOR r IN (0_i64 ..< n_readers) DO s_v = s_v + (NEXT v_readers[r]); END
    FOR w IN (0_i64 ..< n_writers) DO NEXT v_writers[w]; END
    elapsed_v_ms = timestampMs() - t0_v;

    -- ---------- Report ----------
    rw_ops_per_sec = (total_reads * 1000_i64) / elapsed_rw_ms;
    v_ops_per_sec  = (total_reads * 1000_i64) / elapsed_v_ms;
    speedup_x100 = (elapsed_rw_ms * 100_i64) / elapsed_v_ms;

    print("\n=== Fat struct (8x i64) + multi-field reads: ${n_readers.toString()} readers x ${reads_per.toString()} + ${n_writers.toString()} writers x ${writes_per.toString()} ===\n");
    print("BENCH_INFO: RwLock  ${elapsed_rw_ms.toString()} ms  (${rw_ops_per_sec.toString()} reads/sec)\n");
    print("BENCH_INFO: MVCC    ${elapsed_v_ms.toString()} ms  (${v_ops_per_sec.toString()} reads/sec)\n");
    print("BENCH_INFO: MVCC speedup vs RwLock: ${speedup_x100.toString()}/100 x\n");

    ASSERT s_rw >= 0_i64, "rwlock sum sanity";
    ASSERT s_v  >= 0_i64, "mvcc sum sanity";

    print("BENCH_RESULT: ${elapsed_v_ms.toString()} ms\n");
    RETURN;
END
