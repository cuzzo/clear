-- @leak_skip
-- Phase 5b: hand-written WHILE loop equivalent of bench_tail_call.cht.
-- Identical workload (sum 1..N); the only difference is whether the
-- compiler lowered the recursion via TCO or the user wrote the loop
-- by hand. Wall time should be near-equal.

-- Same polynomial hash as bench_tail_call, hand-written WHILE loop.
FN hash_loop(n: Int64) RETURNS Int64 ->
  MUTABLE i: Int64 = n;
  MUTABLE acc: Int64 = 0;
  WHILE i > 0 DO
    acc = (acc %* 31_i64) %+ i;
    i = i - 1;
  END
  RETURN acc;
END

FN main() RETURNS Void ->
  t0 = timestampMs();
  n = 999999000_i64 %+ (t0 MOD 1000_i64);
  r = hash_loop(n);
  elapsed = timestampMs() - t0;
  print("BENCH_RESULT: ${elapsed.toString()} ms");
  print("sum_loop(${n.toString()}) = ${r.toString()}");
  print("Time: ${elapsed.toString()} ms");
  RETURN;
END
