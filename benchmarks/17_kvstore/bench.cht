-- KV Store Benchmark — CLEAR (HashMap@sharded(32), shared-nothing)
--
-- Uses @sharded(32) — true shared-nothing (DragonflyDB model).
-- Each shard lives on its owning scheduler. SHARD pipeline routes
-- keys to the correct scheduler for lock-free local access.
--
-- Workloads:
--   1. Uniform SET   — 1M sequential keys via SHARD pipeline
--   2. Uniform GET   — 1M sequential keys (100% hit)
--   3. Zipfian GET   — 1M ops, power-law key distribution (hot keys)
--   4. Mixed 80/20   — 1M ops, 80% GET / 20% SET, Zipfian
--
-- Compare to Go (sync.Map) and Rust (dashmap).

-- =========================================================================
-- Zipfian distribution (rejection-inversion method)
-- =========================================================================

FN hFunc(x: Float64, s: Float64) RETURNS Float64 ->
    RETURN exp(0.0 - s * log(x));
END

FN hInt(x: Float64, s: Float64) RETURNS Float64 ->
    t = 1.0 - s;
    IF abs(t) > 0.00000001 -> RETURN (x ** t - 1.0) / t;
    RETURN log(x);
END

FN hIntInv(x: Float64, s: Float64) RETURNS Float64 ->
    t = 1.0 - s;
    IF abs(t) > 0.00000001 -> RETURN (t * x + 1.0) ** (1.0 / t);
    RETURN exp(x);
END

FN zipfNext!(MUTABLE state: Int64, n: Int64, s: Float64, hIntegral: Float64, hFraction: Float64) RETURNS Int64 ->
    hIntHalf = hInt(0.5, s);
    WHILE TRUE DO
        state = state * 6364136223846793005_i64 + 1442695040888963407_i64;
        MUTABLE uBits = state;
        IF uBits < 0 THEN uBits = 0 - uBits; END
        MUTABLE u = (uBits MOD 1000000000) / 1000000000.0;
        u = hIntegral + u * (hIntHalf - hIntegral);
        x = hIntInv(u, s);
        MUTABLE k = toInt(x + 0.5);
        IF k < 1 THEN k = 1; END
        IF k > n THEN k = n; END
        IF k - x <= hFraction THEN RETURN k - 1; END
        IF u >= hInt(k + 0.5, s) - hFunc(k, s) THEN RETURN k - 1; END
    END
    RETURN 0;
END

-- =========================================================================
-- Main
-- =========================================================================

FN main() RETURNS Void ->
    MUTABLE map: HashMap<String>@sharded(32) = {};
    n = 1000000;
    zipfSkew = 1.0;

    -- Workload 1: Uniform SET (1M keys, routed to owning shard)
    t0 = timestampMs();
    (0..<n) s> SHARD("key:" + toString(_), map) s> CONCURRENT EACH {
        map[_] = "value-" + toString(_);
    };
    setMs = timestampMs() - t0;

    -- Workload 2: Uniform GET (1M keys, 100% hit, lock-free local reads)
    t1 = timestampMs();
    (0..<n) s> SHARD("key:" + toString(_), map) s> CONCURRENT EACH {
        got = map[_] OR "";
    };
    getMs = timestampMs() - t1;

    -- Workload 3: Zipfian GET (1M ops, power-law distribution)
    -- Pre-generate Zipf keys, then route via SHARD for lock-free reads.
    hIntegral = hInt(n + 0.5, zipfSkew);
    hFraction = hFunc(1.5, zipfSkew) - 1.0;
    MUTABLE zipf_keys: String[]@list = List[];
    MUTABLE state: Int64 = 42;
    FOR i IN (0_i64 ..< n) DO
        k = zipfNext!(state, n, zipfSkew, hIntegral, hFraction);
        state = state * 6364136223846793005_i64 + 1442695040888963407_i64;
        zipf_keys.append("key:" + toString(k));
    END

    t2 = timestampMs();
    (0..<n) s> SHARD(zipf_keys[_], map) s> CONCURRENT EACH {
        got = map[_] OR "";
    };
    zipfMs = timestampMs() - t2;

    -- Workload 4: Mixed 80/20 (Zipfian) — 200K SET then 800K GET
    MUTABLE mix_keys: String[]@list = List[];
    state = 99;
    FOR i IN (0_i64 ..< n) DO
        k = zipfNext!(state, n, zipfSkew, hIntegral, hFraction);
        state = state * 6364136223846793005_i64 + 1442695040888963407_i64;
        mix_keys.append("key:" + toString(k));
    END

    mix_set_n = n / 5;
    mix_get_n = n - mix_set_n;
    t3 = timestampMs();
    (0..<mix_set_n) s> SHARD(mix_keys[_], map) s> CONCURRENT EACH {
        map[_] = "updated";
    };
    (mix_set_n..<n) s> SHARD(mix_keys[_], map) s> CONCURRENT EACH {
        got = map[_] OR "";
    };
    mixMs = timestampMs() - t3;

    print("Keys: ${n.toString()}");
    print("Shards: 32");
    print("Set: ${setMs.toString()} ms");
    print("Get: ${getMs.toString()} ms");
    print("Zipf: ${zipfMs.toString()} ms");
    print("Mixed: ${mixMs.toString()} ms");
    print("Verified: yes");
    RETURN;
END
