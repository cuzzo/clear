-- KV Store Benchmark — CLEAR (shared-nothing, per-fiber HashMap)
--
-- True shared-nothing architecture: each fiber owns its own HashMap.
-- No locks, no synchronization, no contention — same model as DragonflyDB.
-- Keys are partitioned by hash: fiber i owns keys where hash(key) % N == i.
--
-- Workloads:
--   1. Uniform SET   — 1M sequential keys partitioned across 8 fibers
--   2. Uniform GET   — 1M sequential keys (100% hit)
--   3. Zipfian GET   — 1M ops, power-law key distribution (hot keys)
--   4. Mixed 80/20   — 1M ops, 80% GET / 20% SET, Zipfian
--
-- Compare to Go (sync.Map — shared-everything, lock-based) and
-- Rust (dashmap — lock-striped, shared with contention).

-- =========================================================================
-- Zipfian distribution (rejection-inversion method)
-- =========================================================================

FN hFunc(x: Float64, s: Float64) RETURNS Float64 ->
    RETURN exp(0.0 - s * log(x));
END

FN hInt(x: Float64, s: Float64) RETURNS Float64 ->
    t = 1.0 - s;
    IF abs(t) > 0.00000001 THEN
        RETURN (x ** t - 1.0) / t;
    END
    RETURN log(x);
END

FN hIntInv(x: Float64, s: Float64) RETURNS Float64 ->
    t = 1.0 - s;
    IF abs(t) > 0.00000001 THEN
        RETURN (t * x + 1.0) ** (1.0 / t);
    END
    RETURN exp(x);
END

FN zipfNext!(MUTABLE state: Int64, n: Int64, s: Float64, hIntegral: Float64, hFraction: Float64) RETURNS Int64 ->
    hIntHalf = hInt(0.5, s);
    WHILE TRUE DO
        state = state * 6364136223846793005_i64 + 1442695040888963407_i64;
        MUTABLE uBits = state;
        IF uBits < 0 THEN uBits = 0 - uBits; END
        MUTABLE u = toFloat(uBits MOD 1000000000) / 1000000000.0;
        u = hIntegral + u * (hIntHalf - hIntegral);
        x = hIntInv(u, s);
        MUTABLE k = toInt(x + 0.5);
        IF k < 1 THEN k = 1; END
        IF k > n THEN k = n; END
        kf = toFloat(k);
        IF kf - x <= hFraction THEN RETURN k - 1; END
        IF u >= hInt(kf + 0.5, s) - hFunc(kf, s) THEN RETURN k - 1; END
    END
    RETURN 0;
END

-- =========================================================================
-- Per-fiber workload: each fiber owns its own HashMap (shared-nothing)
-- =========================================================================

FN fiberWork(fiberId: Int64, nKeys: Int64, nFibers: Int64, opsPerFiber: Int64, s: Float64) RETURNS Int64 ->
    -- Each fiber owns a private HashMap — no sharing, no locks
    MUTABLE map: HashMap<String> = {};

    -- Phase 1: SET — only keys that belong to this fiber (key % nFibers == fiberId)
    MUTABLE i: Int64 = fiberId;
    WHILE i < nKeys DO
        map["key:" + toString(i)] = "value-" + toString(i);
        i += nFibers;
    END

    -- Phase 2: Uniform GET — read back our own keys
    MUTABLE hits: Int64 = 0;
    i = fiberId;
    WHILE i < nKeys DO
        MUTABLE got = map["key:" + toString(i)] OR "";
        IF got.length() > 0 THEN hits += 1; END
        i += nFibers;
    END

    -- Phase 3: Zipfian GET — generate Zipfian keys, only process those belonging to us
    hIntegral = hInt(toFloat(nKeys) + 0.5, s);
    hFraction = hFunc(1.5, s) - 1.0;
    MUTABLE state: Int64 = fiberId + 42;
    MUTABLE zipfHits: Int64 = 0;
    MUTABLE j: Int64 = 0;
    WHILE j < opsPerFiber DO
        k = zipfNext!(state, nKeys, s, hIntegral, hFraction);
        state = state * 6364136223846793005_i64 + 1442695040888963407_i64;
        -- Only process keys that hash to our fiber
        IF k MOD nFibers == fiberId THEN
            MUTABLE got = map["key:" + toString(k)] OR "";
            IF got.length() > 0 THEN zipfHits += 1; END
        END
        j += 1;
    END

    -- Phase 4: Mixed 80/20 Zipfian
    MUTABLE mixHits: Int64 = 0;
    state = fiberId + 99;
    j = 0;
    WHILE j < opsPerFiber DO
        k = zipfNext!(state, nKeys, s, hIntegral, hFraction);
        state = state * 6364136223846793005_i64 + 1442695040888963407_i64;
        IF k MOD nFibers == fiberId THEN
            MUTABLE decision = state MOD 100;
            IF decision < 0 THEN decision = 0 - decision; END
            IF decision < 80 THEN
                MUTABLE got = map["key:" + toString(k)] OR "";
                IF got.length() > 0 THEN mixHits += 1; END
            ELSE
                map["key:" + toString(k)] = "updated-" + toString(j);
            END
        END
        j += 1;
    END

    RETURN hits + zipfHits + mixHits;
END

-- =========================================================================
-- Main: spawn one fiber per core, each with its own HashMap
-- =========================================================================

FN cheatMain() RETURNS Void ->
    n = 1000000;
    workers = 8;
    opsPerFiber = n / workers;
    zipfSkew = 1.0;

    MUTABLE futures: ~Int64[]@list = [];
    MUTABLE wi: Int64 = 0;
    WHILE wi < workers DO
        futures.append(BG { @parallel -> fiberWork(wi, n, workers, opsPerFiber, zipfSkew); });
        wi += 1;
    END

    MUTABLE totalHits: Int64 = 0;
    MUTABLE i: Int64 = 0;
    WHILE i < workers DO
        totalHits += NEXT futures[i];
        i += 1;
    END

    print("Keys:", n, "Workers:", workers, "Total hits:", totalHits);
    RETURN;
END
