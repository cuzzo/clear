-- KV Store Benchmark — CLEAR (HashMap@sharded(8):locked, RwLock per shard)
--
-- Uses @sharded(8):locked — 8 RwLock-protected shards. Readers are
-- concurrent within a shard; writers are exclusive per-shard.
-- Best for workloads where any fiber may touch any key (cross-shard).
--
-- For true shared-nothing (zero locks), use @sharded(N) with
-- (1..<N)@sharded s> CONCURRENT EACH — each fiber owns its partition.
--
-- Workloads:
--   1. Uniform SET   — 1M sequential keys (split across 8 fibers)
--   2. Uniform GET   — 1M sequential keys (100% hit)
--   3. Zipfian GET   — 1M ops, power-law key distribution (hot keys)
--   4. Mixed 80/20   — 1M ops, 80% GET / 20% SET, Zipfian
--
-- Compare to Go (sync.Map) and Rust (dashmap).

-- =========================================================================
-- Zipfian distribution (rejection-inversion method)
-- =========================================================================

FN hFunc(x: Float64, s: Float64) RETURNS Float64 ->
    RETURN exp(0.0 - s * log(x));
END

FN hInt(x: Float64, s: Float64) RETURNS Float64 ->
    t = 1.0 - s;
    IF abs(t) > 0.00000001 -> RETURN (x ** t - 1.0) / t;
    RETURN log(x);
END

FN hIntInv(x: Float64, s: Float64) RETURNS Float64 ->
    t = 1.0 - s;
    IF abs(t) > 0.00000001 -> RETURN (t * x + 1.0) ** (1.0 / t);
    RETURN exp(x);
END

FN zipfNext!(MUTABLE state: Int64, n: Int64, s: Float64, hIntegral: Float64, hFraction: Float64) RETURNS Int64 ->
    hIntHalf = hInt(0.5, s);
    WHILE TRUE DO
        state = state * 6364136223846793005_i64 + 1442695040888963407_i64;
        MUTABLE uBits = state;
        IF uBits < 0 THEN uBits = 0 - uBits; END
        MUTABLE u = (uBits MOD 1000000000) / 1000000000.0;
        u = hIntegral + u * (hIntHalf - hIntegral);
        x = hIntInv(u, s);
        MUTABLE k = toInt(x + 0.5);
        IF k < 1 THEN k = 1; END
        IF k > n THEN k = n; END
        IF k - x <= hFraction THEN RETURN k - 1; END
        IF u >= hInt(k + 0.5, s) - hFunc(k, s) THEN RETURN k - 1; END
    END
    RETURN 0;
END

-- =========================================================================
-- Workload functions
-- =========================================================================

FN doSet!(MUTABLE map: HashMap<String>, start: Int64, count: Int64) RETURNS Void ->
    FOR i IN (start ..< start + count) -> map["key:${i.toString()}"] = "value-${i.toString()}";
    RETURN;
END

FN doGet!(MUTABLE map: HashMap<String>, start: Int64, count: Int64) RETURNS Int64 ->
    MUTABLE hits: Int64 = 0;
    FOR i IN (start ..< start + count) DO
        MUTABLE got = map["key:${i.toString()}"] OR "";
        IF got.length() > 0 THEN hits += 1; END
    END
    RETURN hits;
END

FN doZipfGet!(MUTABLE map: HashMap<String>, seed: Int64, count: Int64, n: Int64, s: Float64) RETURNS Int64 ->
    hIntegral = hInt(n + 0.5, s);
    hFraction = hFunc(1.5, s) - 1.0;
    MUTABLE hits: Int64 = 0;
    MUTABLE state: Int64 = seed;
    FOR i IN (0_i64 ..< count) DO
        k = zipfNext!(state, n, s, hIntegral, hFraction);
        state = state * 6364136223846793005_i64 + 1442695040888963407_i64;
        MUTABLE got = map["key:${k.toString()}"] OR "";
        IF got.length() > 0 THEN hits += 1; END
    END
    RETURN hits;
END

FN doZipfMixed!(MUTABLE map: HashMap<String>, seed: Int64, count: Int64, n: Int64, s: Float64) RETURNS Int64 ->
    hIntegral = hInt(n + 0.5, s);
    hFraction = hFunc(1.5, s) - 1.0;
    MUTABLE hits: Int64 = 0;
    MUTABLE state: Int64 = seed;
    FOR i IN (0_i64 ..< count) DO
        k = zipfNext!(state, n, s, hIntegral, hFraction);
        state = state * 6364136223846793005_i64 + 1442695040888963407_i64;
        MUTABLE decision = state MOD 100;
        IF decision < 0 THEN decision = 0 - decision; END
        IF decision < 80 THEN
            MUTABLE got = map["key:${k.toString()}"] OR "";
            IF got.length() > 0 THEN hits += 1; END
        ELSE
            map["key:${k.toString()}"] = "updated-${i.toString()}";
        END
    END
    RETURN hits;
END

-- =========================================================================
-- Main
-- =========================================================================

FN main() RETURNS Void ->
    MUTABLE map: HashMap<String>@sharded(32):locked = {};
    n = 1000000;
    workers = 32;
    chunk = n / workers;
    zipfSkew = 1.0;

    -- Workload 1: Uniform SET
    t0 = timestampMs();
    MUTABLE set_futures: ~Void[]@list = [];
    MUTABLE wi: Int64 = 0;
    WHILE wi < workers DO
        start = wi * chunk;
        set_futures.append(BG { doSet!(map, start, chunk); });
        wi += 1;
    END
    FOR si IN (0_i64 ..< workers) -> NEXT set_futures[si];
    setMs = timestampMs() - t0;

    -- Workload 2: Uniform GET
    t1 = timestampMs();
    MUTABLE get_futures: ~Int64[]@list = [];
    wi = 0;
    WHILE wi < workers DO
        start = wi * chunk;
        get_futures.append(BG { doGet!(map, start, chunk); });
        wi += 1;
    END
    MUTABLE total_hits: Int64 = 0;
    FOR gi IN (0_i64 ..< workers) -> total_hits += NEXT get_futures[gi];
    getMs = timestampMs() - t1;

    -- Workload 3: Zipfian GET
    t2 = timestampMs();
    MUTABLE zipf_futures: ~Int64[]@list = [];
    wi = 0;
    WHILE wi < workers DO
        zipf_futures.append(BG { doZipfGet!(map, wi + 42, chunk, n, zipfSkew); });
        wi += 1;
    END
    MUTABLE zipf_hits: Int64 = 0;
    FOR zi IN (0_i64 ..< workers) -> zipf_hits += NEXT zipf_futures[zi];
    zipfMs = timestampMs() - t2;

    -- Workload 4: Mixed 80/20 (Zipfian)
    t3 = timestampMs();
    MUTABLE mix_futures: ~Int64[]@list = [];
    wi = 0;
    WHILE wi < workers DO
        mix_futures.append(BG { doZipfMixed!(map, wi + 99, chunk, n, zipfSkew); });
        wi += 1;
    END
    MUTABLE mix_hits: Int64 = 0;
    FOR mi IN (0_i64 ..< workers) -> mix_hits += NEXT mix_futures[mi];
    mixMs = timestampMs() - t3;

    ASSERT total_hits == n, "GET hits must equal key count";
    ASSERT zipf_hits > 0, "Zipf hits must be > 0";
    ASSERT mix_hits > 0, "Mixed hits must be > 0";

    print("Keys: ${n.toString()}");
    print("Workers: ${workers.toString()}");
    print("Set: ${setMs.toString()} ms");
    print("Get: ${getMs.toString()} ms");
    print("Zipf: ${zipfMs.toString()} ms");
    print("Mixed: ${mixMs.toString()} ms");
    print("Verified: yes");
    RETURN;
END
