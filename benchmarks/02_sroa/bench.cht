-- SROA (Scalar Replacement of Aggregates) Benchmark
--
-- WHY CLEAR FAILS HERE:
--
--   BigVec has 130 Number fields = 130 slots, which exceeds CLEAR's 128-slot
--   frame-allocation threshold. CLEAR allocates it in the frame arena (*BigVec).
--
--   The frame arena is saved/restored ONCE per function call. Inside a loop,
--   each iteration allocates 1040 bytes that are never reclaimed until the
--   function returns. After ~1000 iterations the 1 MB arena is exhausted
--   and CLEAR crashes with OutOfMemory.
--
--   C / Rust: BigVec lives on the OS stack, auto-reclaimed at each iteration.
--   No allocation, no growth, runs 100 000 iterations in microseconds.
--
-- Expected result: CLEAR crashes; C/Rust finishes instantly.
--
-- Fix (SROA): detect that bv never escapes the loop body, decompose it into
--   individual scalar `var` bindings (x1..x3 only), eliminate the frame-arena
--   allocation entirely, and dead-code-eliminate the 127 unused fields.
--
-- Iteration count is intentionally small (100 000) so CLEAR crashes quickly
-- instead of grinding through memory pressure.

STRUCT BigVec {
  x1: Number, x2: Number, x3: Number, x4: Number, x5: Number,
  x6: Number, x7: Number, x8: Number, x9: Number, x10: Number,
  x11: Number, x12: Number, x13: Number, x14: Number, x15: Number,
  x16: Number, x17: Number, x18: Number, x19: Number, x20: Number,
  x21: Number, x22: Number, x23: Number, x24: Number, x25: Number,
  x26: Number, x27: Number, x28: Number, x29: Number, x30: Number,
  x31: Number, x32: Number, x33: Number, x34: Number, x35: Number,
  x36: Number, x37: Number, x38: Number, x39: Number, x40: Number,
  x41: Number, x42: Number, x43: Number, x44: Number, x45: Number,
  x46: Number, x47: Number, x48: Number, x49: Number, x50: Number,
  x51: Number, x52: Number, x53: Number, x54: Number, x55: Number,
  x56: Number, x57: Number, x58: Number, x59: Number, x60: Number,
  x61: Number, x62: Number, x63: Number, x64: Number, x65: Number,
  x66: Number, x67: Number, x68: Number, x69: Number, x70: Number,
  x71: Number, x72: Number, x73: Number, x74: Number, x75: Number,
  x76: Number, x77: Number, x78: Number, x79: Number, x80: Number,
  x81: Number, x82: Number, x83: Number, x84: Number, x85: Number,
  x86: Number, x87: Number, x88: Number, x89: Number, x90: Number,
  x91: Number, x92: Number, x93: Number, x94: Number, x95: Number,
  x96: Number, x97: Number, x98: Number, x99: Number, x100: Number,
  x101: Number, x102: Number, x103: Number, x104: Number, x105: Number,
  x106: Number, x107: Number, x108: Number, x109: Number, x110: Number,
  x111: Number, x112: Number, x113: Number, x114: Number, x115: Number,
  x116: Number, x117: Number, x118: Number, x119: Number, x120: Number,
  x121: Number, x122: Number, x123: Number, x124: Number, x125: Number,
  x126: Number, x127: Number, x128: Number, x129: Number, x130: Number
}

-- Only reads 3 of 130 fields.
-- With SROA the other 127 field initializations are dead and eliminated.
FN sum3(v: BigVec) RETURNS Number @reentrant ->
    RETURN v.x1 + v.x2 + v.x3;
END

FN cheatMain() RETURNS Void ->
    MUTABLE i = 0_i64;
    MUTABLE acc: Number = 0.0;

    -- Each iteration creates a BigVec INSIDE the loop.
    -- CLEAR: frame-arena allocates 1040 bytes per iteration.
    --   Frame mark is saved once at function entry; the arena never shrinks
    --   inside the loop.  After ~1000 iterations the 1 MB arena is exhausted
    --   and the program crashes with OutOfMemory.
    -- C / Rust: BigVec is stack-allocated per iteration with zero overhead.
    WHILE i < 100000 DO
        bv = BigVec{
            x1: acc, x2: acc + 1.0, x3: acc + 2.0,
            x4: 0.0, x5: 0.0, x6: 0.0, x7: 0.0, x8: 0.0,
            x9: 0.0, x10: 0.0, x11: 0.0, x12: 0.0, x13: 0.0,
            x14: 0.0, x15: 0.0, x16: 0.0, x17: 0.0, x18: 0.0,
            x19: 0.0, x20: 0.0, x21: 0.0, x22: 0.0, x23: 0.0,
            x24: 0.0, x25: 0.0, x26: 0.0, x27: 0.0, x28: 0.0,
            x29: 0.0, x30: 0.0, x31: 0.0, x32: 0.0, x33: 0.0,
            x34: 0.0, x35: 0.0, x36: 0.0, x37: 0.0, x38: 0.0,
            x39: 0.0, x40: 0.0, x41: 0.0, x42: 0.0, x43: 0.0,
            x44: 0.0, x45: 0.0, x46: 0.0, x47: 0.0, x48: 0.0,
            x49: 0.0, x50: 0.0, x51: 0.0, x52: 0.0, x53: 0.0,
            x54: 0.0, x55: 0.0, x56: 0.0, x57: 0.0, x58: 0.0,
            x59: 0.0, x60: 0.0, x61: 0.0, x62: 0.0, x63: 0.0,
            x64: 0.0, x65: 0.0, x66: 0.0, x67: 0.0, x68: 0.0,
            x69: 0.0, x70: 0.0, x71: 0.0, x72: 0.0, x73: 0.0,
            x74: 0.0, x75: 0.0, x76: 0.0, x77: 0.0, x78: 0.0,
            x79: 0.0, x80: 0.0, x81: 0.0, x82: 0.0, x83: 0.0,
            x84: 0.0, x85: 0.0, x86: 0.0, x87: 0.0, x88: 0.0,
            x89: 0.0, x90: 0.0, x91: 0.0, x92: 0.0, x93: 0.0,
            x94: 0.0, x95: 0.0, x96: 0.0, x97: 0.0, x98: 0.0,
            x99: 0.0, x100: 0.0, x101: 0.0, x102: 0.0, x103: 0.0,
            x104: 0.0, x105: 0.0, x106: 0.0, x107: 0.0, x108: 0.0,
            x109: 0.0, x110: 0.0, x111: 0.0, x112: 0.0, x113: 0.0,
            x114: 0.0, x115: 0.0, x116: 0.0, x117: 0.0, x118: 0.0,
            x119: 0.0, x120: 0.0, x121: 0.0, x122: 0.0, x123: 0.0,
            x124: 0.0, x125: 0.0, x126: 0.0, x127: 0.0, x128: 0.0,
            x129: 0.0, x130: 0.0
        };
        acc = acc + sum3(bv);
        i = i + 1_i64;
    END

    ASSERT acc > 0.0, "acc must be positive";
    RETURN;
END
