-- @leak: n = 10000 -> n = 100
-- Heap Array Benchmark
--
-- All three languages allocate a 10000-element heap array per outer
-- iteration, fill it, sum it, and discard it. 10000 outer iterations.
-- Total: 100M element writes + 100M element reads.
--
-- CLEAR runs three variants:
--   1. Regular FOR loops (checkYield + frame marks per iteration)
--   2. Outer FOR + inner TIGHT (frame rewind per outer, no yield on inner)
--   3. C/Rust: malloc/Vec + raw indexed writes

FN benchRegular(n: Int64) RETURNS Float64 ->
    MUTABLE total: Float64 = 0.0;
    FOR outer IN (0_i64 ..< n) DO
        MUTABLE vals: Float64[10000]@list = [];
        FOR inner IN (0_i64 ..< n) -> vals.append(inner + 0.0);
        MUTABLE s: Float64 = 0.0;
        FOR inner IN (0_i64 ..< vals.length()) -> s += vals[inner];
        total = total + s;
    END
    RETURN total;
END

FN benchTight(n: Int64) RETURNS Float64 ->
    MUTABLE total: Float64 = 0.0;
    FOR outer IN (0_i64 ..< n) DO
        MUTABLE vals: Float64[10000]@list = [];
        MUTABLE inner: Int64 = 0;
        TIGHT WHILE inner < n DO vals.append(inner + 0.0); inner += 1; END
        MUTABLE s: Float64 = 0.0;
        inner = 0;
        TIGHT WHILE inner < n DO s += vals[inner]; inner += 1; END
        total = total + s;
    END
    RETURN total;
END

FN main() RETURNS Void ->
    n = 10000;

    -- Warmup
    warmR = benchRegular(100);
    warmT = benchTight(100);

    -- Tight inner loops (apples-to-apples vs C malloc + Rust Vec::with_capacity)
    t0 = timestampMs();
    totalT = benchTight(n);
    tightMs = timestampMs() - t0;

    -- Regular FOR loops (reference: includes checkYield + frame marks)
    t1 = timestampMs();
    totalR = benchRegular(n);
    regularMs = timestampMs() - t1;

    ASSERT totalT == totalR, "results must match";
    ASSERT totalT > 0.0, "total must be positive";

    -- TIGHT WHILE is the apples-to-apples comparison with C/Rust.
    -- Regular FOR shows overhead from checkYield + per-iteration frame marks.
    print("total = ${totalT.toString()}");
    print("TIGHT WHILE: ${tightMs.toString()} ms  (vs C/Rust)");
    print("Regular FOR: ${regularMs.toString()} ms");
    RETURN;
END
