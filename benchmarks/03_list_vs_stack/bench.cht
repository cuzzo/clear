-- Heap Array Benchmark
--
-- All three languages allocate a 1000-element array per outer iteration,
-- fill it, sum it, and discard it. 1000 outer iterations.
--
-- C:     malloc(N * sizeof(double)) + free per iteration.
-- Rust:  Vec::with_capacity(1000) — 1 heap alloc per iteration.
-- CLEAR: Float64[1000]@list — pre-allocated frame arena list, rewound
--        each iteration via saveLoopMark/restoreLoopMark.

FN main() RETURNS Void ->
    t0 = timestampMs();
    MUTABLE total: Float64 = 0.0;
    FOR outer IN (0_i64 ..< 1000) DO
        MUTABLE vals: Float64[1000]@list = [];
        FOR inner IN (0_i64 ..< 1000) -> vals.append(inner + 0.0);
        s = vals s> SUM _;
        total = total + s;
    END
    ASSERT total > 0.0, "total must be positive";
    elapsed = timestampMs() - t0;
    print("Time: ${elapsed.toString()} ms");
    RETURN;
END
