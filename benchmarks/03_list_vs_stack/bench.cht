-- Heap Array Benchmark
--
-- All three languages allocate a 1000-element heap array per outer
-- iteration, fill it, sum it, and discard it. 1000 outer iterations.
--
-- C:     malloc + indexed write (arr[i] = val). Zero overhead per element.
-- Rust:  Vec::with_capacity + push. Bounds check per push, no realloc.
-- CLEAR: Float64[1000]@list + indexed write. Pre-allocated and expanded
--        to full capacity. Frame arena rewound each iteration.

FN main() RETURNS Void ->
    t0 = timestampMs();
    MUTABLE total: Float64 = 0.0;
    FOR outer IN (0_i64 ..< 1000) DO
        MUTABLE vals: Float64[1000]@list = [];
        MUTABLE inner: Int64 = 0;
        TIGHT WHILE inner < 1000 DO vals[inner] = inner + 0.0; inner += 1; END
        s = vals s> SUM _;
        total = total + s;
    END
    ASSERT total > 0.0, "total must be positive";
    elapsed = timestampMs() - t0;
    print("Time: ${elapsed.toString()} ms");
    RETURN;
END
