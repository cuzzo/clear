-- List vs. Stack Benchmark
--
-- BEFORE (heapAlloc era):  ~52× slower than C
-- AFTER  (frameAlloc + per-loop marks): matches C wall-clock time
--
-- WHAT CHANGED:
--
--   Step 1 — @list switched from rt.heapAlloc() to rt.frameAlloc().
--   The frame arena (CheatArena) grows dynamically via heap-backed pages
--   (4KB → 16KB → 64KB → 256KB) so it never OOMs.  append now uses a
--   bump allocator with no GPA lock and no bookkeeping overhead.
--   Result: ~52× → ~5× overhead (GPA lock eliminated).
--
--   Step 2 — Per-iteration arena rewind for loop-local lists.
--   The compiler detects that vals is declared inside the outer loop body
--   and wraps each iteration with saveLoopMark/restoreLoopMark.  The
--   stranded realloc buffers (from ArrayListUnmanaged's geometric growth)
--   are reclaimed at each iteration end rather than accumulating to ~16MB.
--   Arena usage stays O(1) across iterations.
--   Result: ~5× → matches C.
--
-- REMAINING GAP vs C (minor):
--   - `try` error-union check on every append (vs no check in C)
--   - ArrayListUnmanaged copies on capacity doubling (vs C's fixed array)
--   C uses a fixed-size stack array (zero realloc); CLEAR uses a growable
--   list that pays for realloc copies.  The allocation cost is now gone.
--
-- C:     stack array double arr[1000] — 0 allocations, 0 error checks.
-- Rust:  Vec::with_capacity(1000) — 1 alloc per outer, 0 reallocs, no try.
-- CLEAR: frame arena + per-loop rewind — 0 GPA calls in the hot path.

FN cheatMain() RETURNS Void ->
    t0 = timestampMs();
    MUTABLE total: Float64 = 0.0;
    MUTABLE outer = 0;
    WHILE outer < 1000 DO
        MUTABLE vals: Float64[]@list = [];
        MUTABLE inner = 0;
        WHILE inner < 1000 DO
            vals.append(inner + 0.0);
            inner += 1;
        END
        s = vals s> SUM _;
        total = total + s;
        outer += 1;
    END
    ASSERT total > 0.0, "total must be positive";
    elapsed = timestampMs() - t0;
    print("Time: ${elapsed.toString()} ms");
    RETURN;
END
