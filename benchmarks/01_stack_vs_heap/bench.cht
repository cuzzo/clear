-- Recursive Fibonacci to test stack frames and call overhead
-- Goal: 1M calls with zero heap allocation

FN fib(n: Int64) RETURNS Int64 @reentrant ->
    IF n <= 1 -> RETURN n;
    RETURN fib(n - 1) + fib(n - 2);
END

FN main() RETURNS Void ->
    t0 = timestampMs();
    r = fib(40);
    elapsed = timestampMs() - t0;
    ASSERT r == 102334155, "Fib(40) calculation error";
    print("Fib(40) = ${r.toString()}");
    print("Time: ${elapsed.toString()} ms");
    RETURN;
END
