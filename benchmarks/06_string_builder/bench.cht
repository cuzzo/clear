-- String Builder Benchmark — CLEAR List+join vs C
--
-- WHAT WE ARE MEASURING:
--
--   C baseline:   repeated realloc+memcpy concat loop (GPA-style)
--
--   CLEAR (List+join):
--     Append each piece to a frame-allocated String[]@list, then join.
--     O(N) total frame memory vs O(N²) for naive concat.
--     Per-run arena rewind (saveLoopMark/restoreLoopMark) keeps memory O(1)
--     across 1 000 runs.
--
-- PARAMETERS:
--   N    = 1 000 concat operations per run
--   RUNS = 1 000 runs   →  1 M total append+join calls
--
-- FRAME MEMORY PER RUN:
--   - N string pointers in the @list: N × 8 bytes = 8 KB
--   - Joined result: N × avg_len bytes ≈ 5 000 bytes
--   - Total ≈ 13 KB per run → well within the default 1 MB frame arena
--   - Per-run arena rewind (automatically emitted because `parts` is
--     declared inside the outer loop) keeps memory O(1).
--
-- WHAT THE TRANSPILER EMITS:
--   append(parts, p)  →  try parts.append(rt.frameAlloc(), p)
--   join(parts, "")   →  try CheatLib.join(rt.frameAlloc(), parts, "")
--   (outer loop)      →  saveLoopMark/restoreLoopMark wrap each iteration

FN cheatMain() RETURNS Void ->
    MUTABLE total = 0_i64;

    MUTABLE run = 0_i64;
    WHILE run < 1000 DO
        -- `parts` is declared inside the loop, so the compiler emits
        -- saveLoopMark/restoreLoopMark to rewind the frame each iteration.
        MUTABLE parts: String[]@list = [];

        MUTABLE i = 0_i64;
        WHILE i < 1000 DO
            append(parts, "hello");
            i = i + 1_i64;
        END

        result = join(parts, "");
        total = total + result.length();
        run = run + 1_i64;
    END

    ASSERT total > 0_i64, "total must be positive";
    RETURN;
END
