-- Minimal reproducer: writeFile in a loop on a single connection.

FN handleClient!(client: TCPClient) RETURNS Void ->
    MUTABLE running: Bool = TRUE;
    WHILE running DO
        data = tcpRead(client);
        IF data.length() == 0 THEN
            running = FALSE;
        ELSE_IF startsWith?(data, "W") THEN
            -- Write a file
            writeFile("data/test.json", "hello");
            tcpWrite(client, "+OK\r\n");
        ELSE_IF startsWith?(data, "Q") THEN
            tcpWrite(client, "+BYE\r\n");
            running = FALSE;
        ELSE
            tcpWrite(client, "+OK\r\n");
        END
    END
END

FN main() RETURNS Void ->
    shell("mkdir -p data");
    server = TCPServer::listen(6391);
    print("repro on 6391");

    MUTABLE tasks: ~Void[]@list = [];
    WHILE TRUE DO
        client = accept(server);
        tasks.append(BG { @service ->
            handleClient!(client);
        });
    END
END
