-- Dynamic Spawn Benchmark — CLEAR
--
-- Spawns 100K individual BG blocks, each does trivial work (return index * 3).
-- Measures pure per-spawn overhead: GPA alloc for SpawnRequest + Fiber + Task,
-- stack allocation, 0xCC fill, context switch, stack scan on completion.
--
-- This is CLEAR's WORST CASE — each BG block pays ~60μs of GPA overhead.
-- For real workloads, use CONCURRENT(workers: N) which avoids per-item spawning.
--
-- Known issue: v0.1 uses GPA for task creation. Object pooling (v0.2) will
-- reduce per-spawn cost to ~2-5μs, closing the gap with Go (~2.4μs/goroutine).

FN main() RETURNS Void ->
    t0 = timestampMs();
    MUTABLE futures: ~Int64[]@list = [];
    MUTABLE i: Int64 = 0;
    WHILE i < 10000 DO
        futures.append(BG { i * 3; });
        i += 1;
    END

    MUTABLE total: Int64 = 0;
    MUTABLE j: Int64 = 0;
    WHILE j < 10000 DO
        result = NEXT futures[j];
        total += result;
        j += 1;
    END
    elapsed = timestampMs() - t0;

    print("Total: ${total.toString()}");
    print("Tasks: 10000");
    print("Time: ${elapsed.toString()} ms");
    RETURN;
END
