FN main() RETURNS Void ->
    t0 = timestampMs();
    MUTABLE x: Float64 = 1.0;
    FOR i IN (0_i64 ..< 100000_i64) DO
        x = (x + 1.25) * 1.000001 - 0.25;
    END
    totalMs = timestampMs() - t0;
    whole = toInt(x);
    print("x = ${whole.toString()}");
    print("BENCH_RESULT: ${totalMs.toString()} ms");
    RETURN;
END
