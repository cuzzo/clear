FN main() RETURNS Void ->
    t0 = timestampMs();
    MUTABLE m: {Int64}Int64 = {};
    FOR i IN (0_i64 ..< 60000_i64) DO
        m[i] = i * 3_i64;
    END

    MUTABLE total: Int64 = 0_i64;
    MUTABLE hits: Int64 = 0_i64;
    FOR j IN (0_i64 ..< 60000_i64) DO
        IF m.contains?(j) THEN
            hits = hits + 1_i64;
            total = total + (m[j] OR_ELSE 0_i64);
        END
        IF (j MOD 4_i64) == 0_i64 THEN
            &m.delete(j);
        END
    END

    MUTABLE survivors: Int64 = 0_i64;
    FOR k IN (0_i64 ..< 60000_i64) DO
        IF m.contains?(k) THEN
            survivors = survivors + 1_i64;
        END
    END

    count = m.count();
    score = total + (hits * 7_i64) + (survivors * 11_i64) + count;
    elapsed = timestampMs() - t0;
    print("count = ${count.toString()}");
    print("score = ${score.toString()}");
    print("BENCH_RESULT: ${elapsed.toString()} ms");
    RETURN;
END
