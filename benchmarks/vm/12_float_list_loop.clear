FN main() RETURNS Void ->
    t0 = timestampMs();
    MUTABLE values: Float64[]@list = [];
    MUTABLE current: Float64 = 0.0;
    FOR i IN (0_i64 ..< 5000_i64) DO
        values.append(current);
        current = current + 1.5;
    END
    FOR j IN (0_i64 ..< values.length()) DO
        values[j] = (values[j] OR 0.0) + 0.25;
    END
    MUTABLE total: Float64 = 0.0;
    FOR k IN (0_i64 ..< values.length()) DO
        total = total + (values[k] OR 0.0);
    END
    whole = toInt(total);
    totalMs = timestampMs() - t0;
    print("total = ${whole.toString()}");
    print("BENCH_RESULT: ${totalMs.toString()} ms");
    RETURN;
END
