# @leak: n = 10000 -> n = 100
# Alloc Throughput Benchmark
#
# All three languages allocate a 10000-element heap array per outer
# iteration, fill it, sum it, and discard it. 10000 outer iterations.
# Total: 10K alloc+free cycles, 100M element writes, 100M element reads.
#
# Measures allocator throughput (dominant cost) + sequential fill+sum.
# C: malloc/free. Rust: Vec::with_capacity. CLEAR: Float64[10000]@list.
#
# Runner records TIGHT WHILE time (apples-to-apples vs C/Rust).
# Regular FOR is printed as CLEAR overhead reference only.

FN benchRegular(n: Int64) RETURNS !Float64 ->
  MUTABLE total = 0.0;
  FOR outer IN (0 ..< n) DO
    MUTABLE vals: []Float64 = [];
    FOR inner IN (0 ..< n) -> &vals.append(inner + 0.0);
    MUTABLE s = 0.0;
    FOR inner IN (0 ..< vals.length()) -> s += (vals[inner] OR_ELSE 0.0);
    total = total + s;
  END
  RETURN total;
END

FN benchTight(n: Int64) RETURNS !Float64 ->
  MUTABLE total = 0.0;
  FOR outer IN (0 ..< n) DO
    MUTABLE vals: []Float64 = [];
    MUTABLE inner = 0;
    TIGHT WHILE inner < n DO
      &vals.append(inner + 0.0);
      inner += 1;
    END
    MUTABLE s = 0.0;
    inner = 0;
    TIGHT WHILE inner < n DO
      s += vals[inner] OR_ELSE 0.0;
      inner += 1;
    END
    total = total + s;
  END
  RETURN total;
END

FN main() RETURNS Void ->
  n = 10_000;

  # Warmup
  warmR = TRY benchRegular(100);
  warmT = TRY benchTight(100);

  # Primary measurement: TIGHT WHILE (apples-to-apples vs C malloc + Rust Vec)
  t0 = timestampMs();
  totalT = TRY benchTight(n);
  tightMs = timestampMs() - t0;

  # Declare the primary result for runner.rb
  print("BENCH_RESULT: ${tightMs.toString()} ms");

  # Regular FOR loops (CLEAR overhead reference, not cross-language comparison)
  t1 = timestampMs();
  totalR = TRY benchRegular(n);
  regularMs = timestampMs() - t1;

  ASSERT totalT == totalR, "results must match";
  ASSERT totalT > 0.0, "total must be positive";

  print("total = ${totalT.toInt().toString()}");
  print("TIGHT WHILE: ${tightMs.toString()} ms  (vs C/Rust)");
  print("Regular FOR: ${regularMs.toString()} ms  (CLEAR overhead reference, not measured by runner)");
  RETURN;
END
