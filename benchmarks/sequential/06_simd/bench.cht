# @leak_skip
# SIMD Benchmark — Vec4 Dot Product (100 million iterations)
#
# WHAT WE MEASURE:
#   dot4(a, b) = a.x*b.x + a.y*b.y + a.z*b.z + a.w*b.w
#   Run 100M times. b is constant {1,2,3,4}; a.xyzw = {i, i+1, i+2, i+3}.
#
# CLEAR has no explicit SIMD vector types. The transpiler emits:
#   return ((((a.x * b.x) + (a.y * b.y)) + (a.z * b.z)) + (a.w * b.w));
#
# However, Zig's LLVM backend (ReleaseFast = -O3) auto-vectorizes the
# outer loop: b is loop-invariant, a's fields are incrementing sequences,
# and LLVM can tile 4 iterations into a single vmulpd ymm instruction.
#
# C uses explicit AVX2 intrinsics (_mm256_set_pd + _mm256_mul_pd + hadd).
# The hadd reduction adds latency that LLVM avoids with a better schedule.
#
# Result: CLEAR (LLVM auto-vec) is faster than C (GCC explicit AVX2).

STRUCT Vec4 {
    x: Float64,
    y: Float64,
    z: Float64,
    w: Float64
}

# Scalar dot product: 4 fmul + 3 fadd.
# No SIMD equivalent exists in CLEAR today.
FN dot4(a: Vec4, b: Vec4) RETURNS Float64 EFFECTS REENTRANT ->
    RETURN a.x*b.x + a.y*b.y + a.z*b.z + a.w*b.w;
END

FN main() RETURNS Void ->
    t0 = timestampMs();
    MUTABLE sum: Float64 = 0.0;
    FOR i IN (0_i64 ..< 100000000) DO
        a = Vec4{ x: i+0.0, y: i+1.0, z: i+2.0, w: i+3.0 };
        b = Vec4{ x: 1.0, y: 2.0, z: 3.0, w: 4.0 };
        sum = sum + dot4(a, b);
    END
    ASSERT sum > 0.0, "sum must be positive";
    elapsed = timestampMs() - t0;
    print("BENCH_RESULT: ${elapsed.toString()} ms");
    RETURN;
END
