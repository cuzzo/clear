# @leak: 1000000 -> 1000
# Sort Benchmark — Quicksort + Mergesort
# N = 1,000,000 f64 values
#
# Data: deterministic permutation via Knuth's multiplicative hash
#   val[i] = (i * 2654435761) MOD N  cast to f64
#   Produces a permutation of [0, N-1].
#
# Both algorithms are in-place (or near-in-place for mergesort with external buffer).
# Function parameters use plain Float64[] (slice) — CLEAR auto-converts @list to slice
# at the call site via CheatLib's @hasField comptime check.
#
# Key optimizations active:
#   1. TIGHT inner loops: eliminates rt.checkYield() and saveLoopMark/restoreLoopMark
#      overhead from pure compare/swap loops — the dominant cost before this change.
#   2. var_mutated SROA: loop index vars (i, j, k, sp, etc.) are read AND reassigned,
#      so no `_ = &name;` is emitted — LLVM can keep them in registers.

# Iterative Lomuto quicksort over a plain slice.
# The `!` suffix marks a function with MUTABLE parameters (CLEAR convention).
FN qsort!(MUTABLE arr: Float64[], n: Int64) RETURNS !Void ->
  # Pre-allocate stacks: log2(1M) < 20; 48 entries is safe.
  # Using @list so both stacks live in the frame arena; trivially freed on exit.
  MUTABLE lo_stk: Int64[]@list = [];
  MUTABLE hi_stk: Int64[]@list = [];
  # Fill loop uses append → cannot be TIGHT (append calls rt.frameAlloc).
  TIGHT FOR fill_i IN (0 ..< 48) DO
    lo_stk.append(0);
    hi_stk.append(0);
  END
  lo_stk[0] = 0;
  hi_stk[0] = n - 1;
  MUTABLE sp = 1;
  MUTABLE tmp = 0.0;

  # TIGHT: pure compare-and-swap, no per-iteration allocation.
  TIGHT WHILE sp > 0 DO
    sp -= 1;
    lo = lo_stk[sp] OR_ELSE 0_i64;
    hi = hi_stk[sp] OR_ELSE 0_i64;

    IF lo < hi THEN
      pivot = arr[hi] OR_ELSE 0.0;
      MUTABLE i = lo - 1;
      MUTABLE j = lo;
      TIGHT WHILE j < hi DO
        IF (arr[j] OR_ELSE 0.0) <= pivot THEN
          i += 1;
          tmp = arr[i] OR_ELSE 0.0;
          arr[i] = arr[j] OR_ELSE 0.0;
          arr[j] = tmp;
        END
        j += 1;
      END
      i += 1;
      tmp = arr[i] OR_ELSE 0.0;
      arr[i] = arr[hi] OR_ELSE 0.0;
      arr[hi] = tmp;
      pi = i;

      left_size = pi - lo;
      right_size = hi - pi;
      IF left_size > right_size THEN
        lo_stk[sp] = lo; hi_stk[sp] = pi - 1; sp += 1;
        lo_stk[sp] = pi + 1; hi_stk[sp] = hi; sp += 1;
      ELSE
        lo_stk[sp] = pi + 1; hi_stk[sp] = hi; sp += 1;
        lo_stk[sp] = lo; hi_stk[sp] = pi - 1; sp += 1;
      END
    END
  END
  RETURN;
END

# Bottom-up iterative mergesort.
# arr and tmp are both plain slices (Float64[]); no allocation inside this function.
FN msort!(MUTABLE arr: Float64[], MUTABLE tmp: Float64[], n: Int64) RETURNS !Void ->
  MUTABLE width = 1;
  # TIGHT: all loops here are pure compare/copy, no allocation.
  TIGHT WHILE width < n DO
    MUTABLE lo = 0;
    TIGHT WHILE lo < n DO
      MUTABLE mid = lo + width;
      IF mid > n THEN
        mid = n;
      END
      MUTABLE hi = lo + width + width;
      IF hi > n THEN
        hi = n;
      END

      IF mid < hi THEN
        MUTABLE i = lo;
        MUTABLE j = mid;
        MUTABLE k = lo;
        TIGHT WHILE k < hi DO
          IF j >= hi || (i < mid && (arr[i] OR_ELSE 0.0) <= (arr[j] OR_ELSE 0.0)) THEN
            tmp[k] = arr[i] OR_ELSE 0.0;
            i += 1;
          ELSE
            tmp[k] = arr[j] OR_ELSE 0.0;
            j += 1;
          END
          k += 1;
        END
        MUTABLE ci = lo;
        TIGHT WHILE ci < hi DO
          arr[ci] = tmp[ci] OR_ELSE 0.0;
          ci += 1;
        END
      END

      lo = lo + width + width;
    END
    width = width + width;
  END
  RETURN;
END

FN main() RETURNS !Void ->
  n = 1_000_000;

  # Build data: permutation of [0, N-1] via Knuth multiplicative hash
  MUTABLE arr: Float64[]@list = [];
  MUTABLE seed_i = 0;
  TIGHT WHILE seed_i < n DO
    v = seed_i * 2_654_435_761 MOD n + 0.0;
    arr.append(v);
    seed_i += 1;
  END

  # Quicksort
  t0 = timestampMs();
  qsort!(arr, n);
  qsortMs = timestampMs() - t0;
  ASSERT (arr[0] OR_ELSE 0.0) <= (arr[1] OR_ELSE 0.0), "qsort: not sorted at start";
  ASSERT (arr[n - 2] OR_ELSE 0.0) <= (arr[n - 1] OR_ELSE 0.0), "qsort: not sorted at end";

  # Refill for mergesort
  seed_i = 0;
  TIGHT WHILE seed_i < n DO
    v = seed_i * 2_654_435_761 MOD n + 0.0;
    arr[seed_i] = v;
    seed_i += 1;
  END

  # Mergesort (needs a temp buffer of the same size)
  MUTABLE tmp_arr: Float64[]@list = [];
  TIGHT FOR ti IN (0 ..< n) -> tmp_arr.append(0.0);
  t1 = timestampMs();
  msort!(arr, tmp_arr, n);
  msortMs = timestampMs() - t1;
  ASSERT (arr[0] OR_ELSE 0.0) <= (arr[1] OR_ELSE 0.0), "msort: not sorted at start";
  ASSERT (arr[n - 2] OR_ELSE 0.0) <= (arr[n - 1] OR_ELSE 0.0), "msort: not sorted at end";

  totalMs = qsortMs + msortMs;
  print("BENCH_RESULT: ${totalMs.toString()} ms");
  print("Sort 1M floats | Quicksort: ${qsortMs.toString()} ms | Mergesort: ${msortMs.toString()} ms");
  RETURN;
END
