-- Parallel Aggregation Benchmark — Distributed Histogram + Stats
--
-- Deterministic LCG generates 100K events. Each event is bucketed into
-- one of 1,000 categories. Two phases:
--
--   Phase 1 (SHARD): Build histogram via @sharded(32) map.
--     Uses explicit SHARD() to route by bucket key.
--     Zero locks, zero contention — true shared-nothing counting.
--
--   Phase 2 (Partial Aggregation): Compute stats over histogram values.
--     CONCURRENT SUM/MIN/MAX/AVERAGE with per-worker accumulators.
--
-- All languages use the same LCG with the same seed → identical results.
-- No I/O — pure parallel compute.

FN lcg(state: Int64) RETURNS Int64 ->
    RETURN state %* 6364136223846793005_i64 %+ 1442695040888963407_i64;
END

FN absInt(x: Int64) RETURNS Int64 ->
    IF x < 0 THEN RETURN 0 - x; END
    RETURN x;
END

FN makeKey(seed: Int64, buckets: Int64) RETURNS String ->
    RETURN "b:${toString(absInt(seed) MOD buckets)}";
END

FN main() RETURNS Void ->
    n = 100000;
    buckets = 1000;

    -- Pre-compute seeds (Int64 array: 80MB vs 1.1GB for string keys).
    -- LCG is sequential so we must pre-compute, but seeds are 8 bytes each.
    MUTABLE seeds: Int64[]@list = List[];
    MUTABLE seed: Int64 = 42;
    FOR i IN (0_i64 ..< n) DO
        seed = lcg(seed);
        seeds.append(seed);
    END

    -- Phase 1: Build histogram via SHARD (shared-nothing counting).
    -- Key strings are generated on-the-fly inside the streaming pipeline.
    t0 = timestampMs();
    MUTABLE counts: HashMap<Int64>@sharded(32) = {};
    (0..<n) s> SHARD(makeKey(seeds[_], buckets), counts) s> CONCURRENT EACH {
        cur = counts[_] OR 0;
        counts[_] = cur + 1;
    };
    shardMs = timestampMs() - t0;

    -- Phase 2: Stats over histogram values (partial aggregation)
    t1 = timestampMs();
    vals = counts.values();
    total    = vals s> CONCURRENT SUM toFloat(_);
    highest  = vals s> CONCURRENT MAX toFloat(_);
    lowest   = vals s> CONCURRENT MIN toFloat(_);
    average  = vals s> CONCURRENT AVERAGE toFloat(_);
    statsMs = timestampMs() - t1;

    ASSERT total == toFloat(n), "total mismatch";

    print("Events: ${n.toString()}");
    print("Buckets: ${buckets.toString()}");
    print("Shard histogram: ${shardMs.toString()} ms");
    print("Aggregation: ${statsMs.toString()} ms");
    print("Total: ${total.toString()}");
    print("Max: ${highest.toString()}");
    print("Min: ${lowest.toString()}");
    print("Avg: ${average.toString()}");
    print("Verified: yes");
END
