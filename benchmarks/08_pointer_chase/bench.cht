-- Pointer-Chasing Benchmark — CLEAR (@pool + Id<Node>)
--
-- Mirrors bench.c exactly: 2,000,000 nodes, additive prime-step permutation.
--   next[i] = id of node at slot (i + STEP) MOD N
--   STEP = 999983 (prime, gcd(STEP, 2000000) = 1 → full-length cycle).
--
-- Memory pressure:
--   - Pool slots = 2 M × ~32 bytes (CheatLib.Pool has alive+generation fields)
--   - Working set ≈ 64 MB → 8× larger than L2 (8 MB), no L3 on this machine.
--   - Every pool.get() dereferences cold DRAM data (same as C).
--
-- WHY CLEAR IS SLOWER HERE:
--
--   C (bench.c) walk hot-path per step:
--     1. sum += cur->val         (load i64 from current node)
--     2. cur  = cur->next        (load *Node from current node)
--     Total: 2 memory loads, 0 function calls, 0 optional checks.
--
--   CLEAR walk hot-path per step:
--     1. pool.get(cur?)          (unwrap ?u64, check alive, check generation,
--                                 compute slot address = base + id * @sizeOf(Slot))
--     2. n?.val                  (optional deref + field load)
--     3. n?.next                 (optional deref + field load)
--     4. rt.saveLoopMark()       (function call — saves arena bump pointer)
--     5. rt.restoreLoopMark()    (function call — restores arena bump pointer)
--     Total: 1 pool lookup + 5 ops + 2 function calls per iteration.
--
-- MEASURED RESULTS (x86-64 Linux, no L3 cache, 2M nodes, 32 MB working set):
--
--   VARIANT                    | WALL TIME | vs C
--   C (raw pointer chain)      | ~0.37 s   | 1.0× baseline
--   CLEAR (@pool + Id<Node>)   | ~0.49 s   | ~1.34× slower (~34% overhead)
--
-- ANALYSIS:
--   The gap is surprisingly small (~34%) because the bottleneck is DRAM
--   latency — both C and CLEAR spend most time waiting for cache misses
--   (32 MB working set >> 8 MB L2, no L3 on this VM). The extra ops in
--   pool.get() (alive check, generation check, address arithmetic) happen
--   during the same memory stall that C endures for its pointer load.
--   This is the "memory-bound" regime where instruction overhead is hidden.
--
--   The residual 34% comes from:
--     - rt.saveLoopMark() / rt.restoreLoopMark() on every walk iteration
--     - Optional unwrap overhead (cur.? + n.? per iteration)
--     - `_ = &n` forcing the pool.get() result onto the stack
--
-- CONCLUSION: CLEAR's @pool is designed for ABA-safe handle semantics,
--   not raw pointer throughput. In the memory-bound regime the overhead
--   is largely hidden by DRAM stalls. In compute-bound or cache-warm
--   scenarios the overhead would be more visible.
--   CLEAR deliberately has no raw pointer types; @pool is the idiomatic
--   choice for graph-like data, and the ~34% tax reflects that trade-off.

STRUCT Node { val: Int64, next: ?Id<Node> }

FN cheatMain() RETURNS Void ->
    n_nodes = 2000000_i64;
    step    = 999983_i64;

    MUTABLE pool: Node[]@pool = [];
    MUTABLE id_list: Id<Node>[]@list = [];

    -- Phase 1: insert N nodes, record IDs in insertion order.
    MUTABLE i = 0_i64;
    WHILE i < n_nodes DO
        id = pool.insert(Node{ val: i, next: NIL });
        append(id_list, id);
        i = i + 1_i64;
    END

    -- Phase 2: wire additive permutation — node[i].next = id[(i+step) MOD n].
    MUTABLE j = 0_i64;
    WHILE j < n_nodes DO
        next_pos = (j + step) MOD n_nodes;
        next_id  = id_list[next_pos];
        cur_node = pool.get(id_list[j]);
        cur_node?.next = next_id;
        j = j + 1_i64;
    END

    -- Phase 3: walk N steps, accumulate sum.
    MUTABLE cur:   ?Id<Node> = id_list[0];
    MUTABLE steps  = 0_i64;
    MUTABLE sum    = 0_i64;
    WHILE steps < n_nodes DO
        n     = pool.get(cur?);
        sum   = sum + n?.val;
        cur   = n?.next;
        steps = steps + 1_i64;
    END

    ASSERT sum > 0, "sum must be positive";
    RETURN;
END
