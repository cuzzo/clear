// HashMap Benchmark — CLEAR Runtime (Zig implementation)
//
// This file exercises the CLEAR @map runtime exactly as the transpiler
// generates it.  CLEAR syntax cannot produce integer→string keys in a loop
// (no fmt intrinsic yet), so we drive the runtime directly from Zig.
//
// What this measures:
//   - CheatLib.mapPut with rt.heapAlloc() — one GPA alloc per key copy +
//     periodic GPA realloc for the bucket array as it grows.
//   - CheatLib.mapGet with the resulting map.
//
// WHY CLEAR IS SLOW TODAY:
//   1. Key duplication: every put() calls allocator.dupe(u8, key) — 1M
//      small GPA allocations just for key strings.
//   2. GPA bookkeeping: each small alloc touches global lock-protected
//      metadata, ruining branch-predictor and cache locality.
//   3. Bucket-array growth: std.StringHashMapUnmanaged grows geometrically
//      (~20 GPA reallocs for 1M items), each copying the entire table.
//
// GOAL: Arena-backed @map would eliminate all three costs.  A single
// allocator.alloc() for the initial bucket array + bump-pointer key storage
// would bring CLEAR's map to within ~10% of the C baseline.

const std = @import("std");
const Header = @import("../zig/runtime-header.zig");
const CheatLib = Header.CheatLib;
const Runtime = Header.Runtime;
const EbrContext = Header.EbrContext;

const N = 1_000_000;

pub fn main() !void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var ctx = EbrContext{};
    defer ctx.deinit(allocator);

    var rt = try Runtime.init(allocator, 4 * 1024 * 1024, &ctx);
    defer rt.deinit();
    rt.wireAllocator();

    // Pre-generate all key strings into a single heap buffer.
    // This isolates hash-table cost from key-generation cost.
    var key_buf = try allocator.alloc([8]u8, N);
    defer allocator.free(key_buf);
    var key_lens = try allocator.alloc(usize, N);
    defer allocator.free(key_lens);

    for (0..N) |i| {
        const s = try std.fmt.bufPrint(&key_buf[i], "{d}", .{i});
        key_lens[i] = s.len;
    }

    var map = std.StringHashMapUnmanaged(f64){};
    defer {
        // Free all duplicated key strings that mapPut allocated.
        var it = map.keyIterator();
        while (it.next()) |k| rt.heapAlloc().free(k.*);
        map.deinit(rt.heapAlloc());
    }

    var timer = try std.time.Timer.start();

    // ---- INSERT: uses rt.heapAlloc() for key copy + bucket array ----
    timer.reset();
    for (0..N) |i| {
        const key = key_buf[i][0..key_lens[i]];
        try CheatLib.mapPut(f64, rt.heapAlloc(), &map, key, @floatFromInt(i));
    }
    const ins_ns = timer.read();

    // ---- LOOKUP ----
    var sum: f64 = 0;
    timer.reset();
    for (0..N) |i| {
        const key = key_buf[i][0..key_lens[i]];
        sum += CheatLib.mapGet(f64, map, key);
    }
    const lkp_ns = timer.read();

    std.debug.assert(sum > 0);
    std.debug.print("sum = {d:.0}\n", .{sum});
    std.debug.print("Insert: {d:.1} ms | Lookup: {d:.1} ms | Total: {d:.1} ms\n", .{
        @as(f64, @floatFromInt(ins_ns)) / 1e6,
        @as(f64, @floatFromInt(lkp_ns)) / 1e6,
        @as(f64, @floatFromInt(ins_ns + lkp_ns)) / 1e6,
    });
}
