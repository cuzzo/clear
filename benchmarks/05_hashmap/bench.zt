// HashMap Benchmark — CLEAR Runtime (Zig implementation)
//
// Tests three variants head-to-head:
//   1. String map — old GPA-only path  (heapAlloc for keys AND buckets)
//   2. String map — split-allocator    (heapAlloc keys, frameAlloc buckets)
//   3. Numeric map — f64 key           (AutoHashMapUnmanaged, no key copies)
//
// Numeric maps (Option 3) cover ALL numeric key types:
//   f64, i64, u64, etc.  AutoHashMapUnmanaged handles them identically.
//
// WHY NUMERIC MAP IS FASTEST:
//   - No key duplication at all (integers copied by value).
//   - Single frameAlloc bump for bucket array — no GPA lock contention.
//   - Integer comparison (~1 ns) vs string hash + strcmp (~5 ns).
//
// WHY SPLIT-ALLOCATOR STRING MAP IS FASTER THAN OLD:
//   - Bucket-array growth uses frameAlloc (bump-pointer, no GPA lock).
//   - Only key copies still go to heapAlloc — 1M small GPA allocs,
//     but bucket reallocs are now free.

const std = @import("std");
const Header = @import("../zig/runtime-header.zig");
const CheatLib = Header.CheatLib;
const Runtime = Header.Runtime;
const EbrContext = Header.EbrContext;

const N = 1_000_000;

pub fn main() !void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    var ctx = EbrContext{};
    defer ctx.deinit(allocator);

    var rt = try Runtime.init(allocator, 16 * 1024 * 1024, &ctx);
    defer rt.deinit();
    rt.wireAllocator();

    // Pre-generate all key strings — isolates hash-table cost from key-gen.
    var key_buf = try allocator.alloc([8]u8, N);
    defer allocator.free(key_buf);
    var key_lens = try allocator.alloc(usize, N);
    defer allocator.free(key_lens);

    for (0..N) |i| {
        const s = try std.fmt.bufPrint(&key_buf[i], "{d}", .{i});
        key_lens[i] = s.len;
    }

    // =========================================================
    // Variant 1: String map — GPA for both keys AND buckets
    // (old CLEAR behaviour, kept for baseline comparison)
    // =========================================================
    {
        var map = std.StringHashMapUnmanaged(f64){};
        defer {
            var it = map.keyIterator();
            while (it.next()) |k| rt.heapAlloc().free(k.*);
            map.deinit(rt.heapAlloc());
        }

        var timer = try std.time.Timer.start();

        timer.reset();
        for (0..N) |i| {
            const key = key_buf[i][0..key_lens[i]];
            // Old API: single heapAlloc for both key copy and bucket growth.
            if (map.getPtr(key)) |p| { p.* = @floatFromInt(i); } else {
                const kc = try rt.heapAlloc().dupe(u8, key);
                try map.put(rt.heapAlloc(), kc, @floatFromInt(i));
            }
        }
        const ins_ns = timer.read();

        var sum: f64 = 0;
        timer.reset();
        for (0..N) |i| {
            const key = key_buf[i][0..key_lens[i]];
            sum += map.get(key) orelse 0;
        }
        const lkp_ns = timer.read();

        std.debug.assert(sum > 0);
        std.debug.print("[1] String/GPA  Insert: {d:.1} ms | Lookup: {d:.1} ms | Total: {d:.1} ms\n", .{
            @as(f64, @floatFromInt(ins_ns)) / 1e6,
            @as(f64, @floatFromInt(lkp_ns)) / 1e6,
            @as(f64, @floatFromInt(ins_ns + lkp_ns)) / 1e6,
        });
    }

    // =========================================================
    // Variant 2: String map — split allocator (Option 1)
    //   heapAlloc for key copies, frameAlloc for bucket growth
    // =========================================================
    {
        var map = std.StringHashMapUnmanaged(f64){};
        defer CheatLib.mapDeinit(f64, rt.heapAlloc(), rt.frameAlloc(), &map);

        var timer = try std.time.Timer.start();

        timer.reset();
        for (0..N) |i| {
            const key = key_buf[i][0..key_lens[i]];
            try CheatLib.mapPut(f64, rt.heapAlloc(), rt.frameAlloc(), &map, key, @floatFromInt(i));
        }
        const ins_ns = timer.read();

        var sum: f64 = 0;
        timer.reset();
        for (0..N) |i| {
            const key = key_buf[i][0..key_lens[i]];
            sum += CheatLib.mapGet(f64, map, key);
        }
        const lkp_ns = timer.read();

        std.debug.assert(sum > 0);
        std.debug.print("[2] String/Split Insert: {d:.1} ms | Lookup: {d:.1} ms | Total: {d:.1} ms\n", .{
            @as(f64, @floatFromInt(ins_ns)) / 1e6,
            @as(f64, @floatFromInt(lkp_ns)) / 1e6,
            @as(f64, @floatFromInt(ins_ns + lkp_ns)) / 1e6,
        });
    }

    // =========================================================
    // Variant 3: Numeric map — f64 key (Option 3)
    //   AutoHashMapUnmanaged(f64, f64), frameAlloc only
    //   No key duplication, no GPA at all.
    // =========================================================
    {
        var map = CheatLib.NumericMapType(f64, f64){};
        defer CheatLib.numericMapDeinit(f64, f64, rt.frameAlloc(), &map);

        var timer = try std.time.Timer.start();

        timer.reset();
        for (0..N) |i| {
            const key: f64 = @floatFromInt(i);
            try CheatLib.numericMapPut(f64, f64, rt.frameAlloc(), &map, key, key);
        }
        const ins_ns = timer.read();

        var sum: f64 = 0;
        timer.reset();
        for (0..N) |i| {
            const key: f64 = @floatFromInt(i);
            sum += CheatLib.numericMapGet(f64, f64, map, key);
        }
        const lkp_ns = timer.read();

        std.debug.assert(sum > 0);
        std.debug.print("[3] Numeric/f64  Insert: {d:.1} ms | Lookup: {d:.1} ms | Total: {d:.1} ms\n", .{
            @as(f64, @floatFromInt(ins_ns)) / 1e6,
            @as(f64, @floatFromInt(lkp_ns)) / 1e6,
            @as(f64, @floatFromInt(ins_ns + lkp_ns)) / 1e6,
        });
    }

    // =========================================================
    // Variant 4: Numeric map — i64 key
    //   Same as f64 but with integer keys — typically faster
    //   because integer hash is simpler than float hash.
    // =========================================================
    {
        var map = CheatLib.NumericMapType(i64, f64){};
        defer CheatLib.numericMapDeinit(i64, f64, rt.frameAlloc(), &map);

        var timer = try std.time.Timer.start();

        timer.reset();
        for (0..N) |i| {
            try CheatLib.numericMapPut(i64, f64, rt.frameAlloc(), &map, @intCast(i), @floatFromInt(i));
        }
        const ins_ns = timer.read();

        var sum: f64 = 0;
        timer.reset();
        for (0..N) |i| {
            sum += CheatLib.numericMapGet(i64, f64, map, @intCast(i));
        }
        const lkp_ns = timer.read();

        std.debug.assert(sum > 0);
        std.debug.print("[4] Numeric/i64  Insert: {d:.1} ms | Lookup: {d:.1} ms | Total: {d:.1} ms\n", .{
            @as(f64, @floatFromInt(ins_ns)) / 1e6,
            @as(f64, @floatFromInt(lkp_ns)) / 1e6,
            @as(f64, @floatFromInt(ins_ns + lkp_ns)) / 1e6,
        });
    }
}
