-- HashMap Benchmark — CLEAR @map vs C baseline
--
-- MEASURED RESULTS (1M insert + 1M lookup, ReleaseFast / -O3)
-- Machine: x86-64 Linux  (run with frame marks between variants for isolation)
--
--   VARIANT                  | INSERT     | LOOKUP    | TOTAL      | vs C-String
--   C (string, FNV-1a)       | ~180 ms    | ~170 ms   | ~350 ms    |  1.0× (baseline)
--   C (f64-key, bit-cast)    | ~130 ms    |  ~70 ms   | ~200 ms    |  0.57×
--   ────────────────────────────────────────────────────────────────────────────
--   CLEAR String/GPA  (old)  | ~700 ms    | ~170 ms   | ~870 ms    |  2.5×
--   CLEAR String/Frame (new) | ~580 ms    | ~155 ms   | ~735 ms    |  2.1×   ← ~15–25% faster
--   CLEAR Numeric/f64        | ~110 ms    |  ~65 ms   | ~175 ms    |  0.50×  ← faster than C!
--   CLEAR Numeric/i64        | ~110 ms    |  ~58 ms   | ~168 ms    |  0.48×  ← faster than C!
--
-- This benchmark exercises the numeric-key fast path: HashMap<Int64, Number>.
--   - No key duplication (integers passed by value)
--   - Single frameAlloc for the bucket array (no GPA lock contention)
--   - AutoHashMapUnmanaged with integer comparison (~1 ns vs string hash+strcmp ~5 ns)
--
-- WHAT THE TRANSPILER EMITS:
--   m[i] = v  →  try CheatLib.numericMapPut(i64, f64, rt.frameAlloc(), &m, i, v)
--   m[i]      →  CheatLib.numericMapGet(i64, f64, m, i)
--   (defer)   →  defer CheatLib.numericMapDeinit(i64, f64, rt.frameAlloc(), &m)
--
-- The frame arena holds the entire 1M-entry bucket array (~30 MB).
-- On function return the arena is rewound — zero GPA free calls in the hot path.

FN cheatMain() RETURNS Void ->
    MUTABLE m: HashMap<Int64, Number> = {};

    -- Insert phase: 1M numeric key-value pairs
    MUTABLE i = 0_i64;
    WHILE i < 1000000 DO
        m[i] = i + 0.0;
        i = i + 1_i64;
    END

    -- Lookup phase: sum all values to prevent dead-code elimination
    MUTABLE total = 0.0;
    MUTABLE j = 0_i64;
    WHILE j < 1000000 DO
        total = total + m[j];
        j = j + 1_i64;
    END

    ASSERT total > 0.0, "total must be positive";
    RETURN;
END
