# @leak: n = 1000000 -> n = 1000
# KV Store Benchmark — CLEAR (HashMap@shared:sharded(128):locked, DashMap)
#
# WARNING: DO NOT RUN IN DEBUG MODE.
#   The BG worker call chain (string concat + intToString + sharded HashMap put
#   with locking) exceeds the 12 KB usable stack of a Standard (16 KB) fiber
#   when compiled in Debug (no inlining, no register allocation). Without
#   __morestack guard pages, the overflow silently corrupts the next stack in
#   the slab and segfaults the depot freelist. Use --safe or --optimized.
#   If you must run debug-instrumented (e.g. for leak detection), force the
#   BG blocks to @xl (256 KB) to avoid the smash.
#
# Uses @shared:sharded(128):locked — Arc-wrapped lock-striped HashMap.
# Each of 8 shards has its own RwLock: readers are concurrent within a shard,
# writers are exclusive per-shard. No WITH blocks needed — methods handle
# shard selection and locking internally.
#
# Workloads:
#   1. Uniform SET   — 1M sequential keys (split across 8 workers)
#   2. Uniform GET   — 1M sequential keys (100% hit)
#   3. Zipfian GET   — 1M ops, power-law key distribution (hot keys)
#   4. Mixed 80/20   — 1M ops, 80% GET / 20% SET, Zipfian
#
# Compare to Go (sync.Map) and Rust (dashmap).

# =========================================================================
# Zipfian distribution (rejection-inversion method)
# =========================================================================

FN hFunc(x: Float64, s: Float64) RETURNS Float64 ->
  RETURN exp(0.0 - s * log(x));
END

FN hInt(x: Float64, s: Float64) RETURNS Float64 ->
  t = 1.0 - s;
  IF abs(t) > 0.000_000_01 -> RETURN (x ** t - 1.0) / t;
  RETURN log(x);
END

FN hIntInv(x: Float64, s: Float64) RETURNS Float64 ->
  t = 1.0 - s;
  IF abs(t) > 0.000_000_01 -> RETURN (t * x + 1.0) ** (1.0 / t);
  RETURN exp(x);
END

FN zipfNext!(MUTABLE state: Int64, n: Int64, s: Float64, hIntegral: Float64, hFraction: Float64) RETURNS Int64 ->
  hIntHalf = hInt(0.5, s);
  WHILE TRUE DO
    state = state %* 6_364_136_223_846_793_005 %+ 1_442_695_040_888_963_407;
    MUTABLE uBits = state;
    IF uBits < 0 THEN
      uBits = 0 - uBits;
    END
    MUTABLE u = (uBits MOD 1_000_000_000) / 1_000_000_000.0;
    u = hIntegral + u * (hIntHalf - hIntegral);
    x = hIntInv(u, s);
    MUTABLE k = (x + 0.5).toInt();
    IF k < 1 THEN
      k = 1;
    END
    IF k > n THEN
      k = n;
    END
    IF k - x <= hFraction THEN
      RETURN k - 1;
    END
    IF u >= hInt(k.toFloat() + 0.5, s) - hFunc(k.toFloat(), s) THEN
      RETURN k - 1;
    END
  END
  RETURN 0;
END

# =========================================================================
# Main
# =========================================================================

FN main() RETURNS Void ->
  MUTABLE map: HashMap<String> @shared:sharded(128):locked = {};
  n = 1_000_000;
  workers = threadCount();
  chunk = n / workers;
  zipfSkew = 1.0;

  # Workload 1: Uniform SET
  t0 = timestampMs();
  MUTABLE set_futures: ~Void[]@list = [];
  MUTABLE wi = 0;
  WHILE wi < workers DO
    start = wi * chunk;
    cnt = chunk;
    set_futures
      .append(
        BG {
          @parallel ->
            FOR idx IN (start ..< start + cnt) DO
              map["key:${idx.toString()}"] = "value-${idx.toString()}";
            END

        }
      );
    wi += 1;
  END
  FOR si IN (0 ..< workers) DO
    IF set_futures[si] EXISTS AS future THEN NEXT future; END
  END
  setMs = timestampMs() - t0;

  # Workload 2: Uniform GET
  t1 = timestampMs();
  MUTABLE get_futures: ~Int64[]@list = [];
  wi = 0;
  WHILE wi < workers DO
    start = wi * chunk;
    cnt = chunk;
    get_futures
      .append(
        BG {
          @parallel ->
            MUTABLE hits = 0;
            FOR idx IN (start ..< start + cnt) DO
              got = map["key:${idx.toString()}"] OR_ELSE "";
              IF got.any?() THEN
                hits += 1;
              END
            END
            hits;
        }
      );
    wi += 1;
  END
  MUTABLE total_hits = 0;
  FOR gi IN (0 ..< workers) DO
    IF get_futures[gi] EXISTS AS future THEN total_hits += NEXT future; END
  END
  getMs = timestampMs() - t1;

  # Workload 3: Zipfian GET
  hIntegral = hInt(n + 0.5, zipfSkew);
  hFraction = hFunc(1.5, zipfSkew) - 1.0;
  t2 = timestampMs();
  MUTABLE zipf_futures: ~Int64[]@list = [];
  wi = 0;
  WHILE wi < workers DO
    seed = wi + 42;
    cnt = chunk;
    zipf_futures
      .append(
        BG {
          @parallel ->
            MUTABLE hits = 0;
            MUTABLE state = seed;
            FOR idx IN (0 ..< cnt) DO
              k = zipfNext!(state, n, zipfSkew, hIntegral, hFraction);
              state = state %* 6_364_136_223_846_793_005 %+ 1_442_695_040_888_963_407;
              got = map["key:${k.toString()}"] OR_ELSE "";
              IF got.any?() THEN
                hits += 1;
              END
            END
            hits;
        }
      );
    wi += 1;
  END
  MUTABLE zipf_hits = 0;
  FOR zi IN (0 ..< workers) DO
    IF zipf_futures[zi] EXISTS AS future THEN zipf_hits += NEXT future; END
  END
  zipfMs = timestampMs() - t2;

  # Workload 4: Mixed 80/20 (Zipfian)
  t3 = timestampMs();
  MUTABLE mix_futures: ~Int64[]@list = [];
  wi = 0;
  WHILE wi < workers DO
    seed = wi + 99;
    cnt = chunk;
    mix_futures
      .append(
        BG {
          @parallel ->
            MUTABLE hits = 0;
            MUTABLE state = seed;
            MUTABLE val: String = "";
            FOR idx IN (0 ..< cnt) DO
              k = zipfNext!(state, n, zipfSkew, hIntegral, hFraction);
              state = state %* 6_364_136_223_846_793_005 %+ 1_442_695_040_888_963_407;
              MUTABLE decision = state MOD 100;
              IF decision < 0 THEN
                decision = 0 - decision;
              END
              IF decision < 80 THEN
                val = map["key:${k.toString()}"] OR_ELSE "";
                IF val.any?() THEN
                  hits += 1;
                END
              ELSE
                map["key:${k.toString()}"] = "updated-${idx.toString()}";
              END
            END
            hits;
        }
      );
    wi += 1;
  END
  MUTABLE mix_hits = 0;
  FOR mi IN (0 ..< workers) DO
    IF mix_futures[mi] EXISTS AS future THEN mix_hits += NEXT future; END
  END
  mixMs = timestampMs() - t3;

  # Assert against workers*chunk, not n: integer division may drop a
  # remainder when n doesn't evenly divide workers (e.g. @leak n=1000 with
  # nproc=32 → chunk=31, 32*31=992 keys actually written, not 1000).
  ASSERT total_hits == workers * chunk, "GET hits must equal SET count";
  ASSERT zipf_hits > 0, "Zipf hits must be > 0";
  ASSERT mix_hits > 0, "Mixed hits must be > 0";

  totalMs = setMs + getMs + zipfMs + mixMs;
  print("BENCH_RESULT: ${totalMs.toString()} ms");
  print("Keys: ${n.toString()}");
  print("Workers: ${workers.toString()}");
  print("Set: ${setMs.toString()} ms");
  print("Get: ${getMs.toString()} ms");
  print("Zipf: ${zipfMs.toString()} ms");
  print("Mixed: ${mixMs.toString()} ms");
  print("Verified: yes");
  RETURN;
END
