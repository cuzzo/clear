s_rw = (NEXT r1) + (NEXT r2) + (NEXT r3) + (NEXT r4) + (NEXT r5) + (NEXT r6) + (NEXT r7) + (NEXT r8) + (NEXT r9) + (NEXT r10) + (NEXT r11) + (NEXT r12) + (NEXT r13) + (NEXT r14) + (NEXT r15) + (NEXT r16) + (NEXT r17) + (NEXT r18) + (NEXT r19) + (NEXT r20) + (NEXT r21) + (NEXT r22) + (NEXT r23) + (NEXT r24) + (NEXT r25) + (NEXT r26) + (NEXT r27) + (NEXT r28) + (NEXT r29) + (NEXT r30) + (NEXT r31) + (NEXT r32);
NEXT wrw1;
    NEXT wrw2;
    NEXT wrw3;
    NEXT wrw4;
t1_rw = timestampMs();
elapsed_rw_ms = t1_rw - t0_rw;

-- ───── Variant B: @shared:versioned (MVCC) ─────
MUTABLE c_v = Counter{ value: 0_i64 } @shared:versioned;

t0_v = timestampMs();
    v1: ~Int64 = BG { @parallel ->
