# Concurrent File Search Benchmark — CLEAR
#
# Opens all files in a directory, counts occurrences of a needle string
# in each file concurrently using fibers, then reports top-10 by count.
#
# CLEAR (this file): Batched promise list (~Int64[]@list) with backpressure.
#   - io_uring SQ has 256 slots; we cap in-flight reads to BATCH_SIZE = 128
#     so the ring never overflows with many concurrent readFile calls.
#   - search_batch! spawns BATCH_SIZE fibers, awaits all via NEXT, returns counts.
#   - ~2KB fiber stacks vs ~8KB goroutines vs 8MB OS threads.
#   - Each fiber: readFile (yields on io_uring SQE) → countOccurrences → Int64.
#
# Go (bench.go):   One goroutine per file, GOMAXPROCS=num_cpu M:N parallelism.
# Rust (bench.rs): One Tokio task per file, async io_uring via tokio::fs.
#
# DATASET: 2000 files × ~10KB each = ~20MB total; needle = "the"
# Data generated by running any of the three benchmarks once.
#
# COMPILE (via benchmarks/runner.rb):
#   CLEAR:  ruby src/transpiler.rb bench.clear > zig/bench.zig
#           zig build-exe zig/bench.zig zig/switch.S zig/onRoot.S \
#               --name bench_clear -O ReleaseFast -lc
#
# @leak: n = files.length() -> n = 64
# @leak: batch_size = 128 -> batch_size = 8

STRUCT SearchResult {
  file_idx: Int64,
  count: Int64
}

# Search a batch of files concurrently. Returns heap-promoted count list.
# Isolating the promise list here prevents per-iteration frame rewind in main.
FN search_batch(files: String[], start: Int64, end: Int64, data_dir: String, needle: String) RETURNS !Int64[] ->
  MUTABLE futures: ~Int64[]@list = [];
  FOR i IN (start ..< end) DO
    filepath = "${data_dir}/${files[i]}";
    &futures.append(
      BG {
        content = readFile(filepath);
        content.countOccurrences(needle);
      }
    );
  END
  counts: []Int64 = NEXT futures;
  RETURN counts;
END

FN main() RETURNS Void ->
  t0 = timestampMs();
  needle = "the";
  data_dir = "benchmarks/10_concurrent_search/data";

  # List all files in the data directory (filenames only, not full paths).
  files = data_dir.listDir();
  n = files.length();

  # Process files in batches to bound io_uring SQ pressure.
  # io_uring SQ capacity = 256; BATCH_SIZE = 128 keeps headroom.
  batch_size = 128;
  MUTABLE results: []SearchResult = [];
  MUTABLE batch_start = 0;

  WHILE batch_start < n DO
    MUTABLE batch_end = batch_start + batch_size;
    IF batch_end > n THEN
      batch_end = n;
    END

    counts = search_batch(files, batch_start, batch_end, data_dir, needle);
    FOR k IN (0 ..< counts.length()) DO
      &results.append(SearchResult{ file_idx: batch_start + k, count: counts[k] });
    END

    batch_start = batch_end;
  END

  # Selection sort: find top-10 by swapping into the first 10 positions.
  FOR j IN (0 ..< 10) DO
    MUTABLE best = j;
    FOR m IN (j + 1 ..< n) DO
      IF results[m] EXISTS AS candidate THEN
        IF results[best] EXISTS AS currentBest THEN
          IF candidate.count > currentBest.count THEN best = m; END
        END
      END
    END
    IF best != j THEN
      IF (COPY results[j] EXISTS AS tmp) AND (COPY results[best] EXISTS AS bestResult) THEN
        results[j] = bestResult;
        results[best] = tmp;
      END
    END
  END

  # Print top 10.
  print("Top 10 files by '", needle, "' count:");
  FOR p IN (0 ..< 10) DO
    IF results[p] EXISTS AS r THEN
      print("  ", files[r.file_idx], "  ", r.count);
    END
  END

  elapsed = timestampMs() - t0;
  print("BENCH_RESULT: ${elapsed.toString()} ms");
  print("Time: ${elapsed.toString()} ms");
  RETURN;
END
