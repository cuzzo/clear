# @leak: n = 10000000 -> n = 10000
# Parallel Aggregation Benchmark — Distributed Histogram + Stats
#
# Deterministic LCG generates 10M events. Each event is bucketed into
# one of 1,000 categories. Two phases:
#
#   Phase 1 (SHARD): Build histogram via @sharded(32) map.
#     Uses explicit SHARD() to route by bucket key.
#     Zero locks, zero contention — true shared-nothing counting.
#
#   Phase 2 (Partial Aggregation): Compute stats over histogram values.
#     CONCURRENT SUM/MIN/MAX/AVERAGE with per-worker accumulators.
#
# All languages use the same LCG with the same seed → identical results.
# No I/O — pure parallel compute.

FN lcg(state: Int64) RETURNS Int64 ->
  RETURN state %* 6_364_136_223_846_793_005 %+ 1_442_695_040_888_963_407;
END

FN absInt(x: Int64) RETURNS Int64 ->
  IF x < 0 THEN
    RETURN 0 - x;
  END
  RETURN x;
END

FN main() RETURNS Void ->
  n = 10_000_000;
  buckets = 1000;

  # Pre-compute seeds (LCG is sequential so we must pre-compute).
  MUTABLE seeds: Int64[]@list = List[];
  MUTABLE seed = 42;
  FOR i IN (0 ..< n) DO
    seed = lcg(seed);
    seeds.append(seed);
  END

  # Phase 1: Build histogram via SHARD with integer keys — zero string allocation.
  t0 = timestampMs();
  MUTABLE counts: HashMap<Int64, Int64> @sharded(32) = {};
  (0 ..< n)
    |> SHARD(absInt(seeds[_] OR_ELSE 0_i64) MOD buckets, counts)
    |> CONCURRENT(batch: 512) EACH {counts[_] = (counts[_] OR_ELSE 0) + 1;};
  shardMs = timestampMs() - t0;

  # Phase 2: Stats over histogram values (partial aggregation)
  t1 = timestampMs();
  vals = counts.values();
  total = vals |> CONCURRENT SUM _.toFloat();
  highest = vals |> CONCURRENT MAX _.toFloat();
  lowest = vals |> CONCURRENT MIN _.toFloat();
  average = vals |> CONCURRENT AVERAGE _.toFloat();
  statsMs = timestampMs() - t1;

  ASSERT total == n.toFloat(), "total mismatch";

  totalMs = shardMs + statsMs;
  print("BENCH_RESULT: ${totalMs.toString()} ms");
  print("Events: ${n.toString()}");
  print("Buckets: ${buckets.toString()}");
  print("Shard histogram: ${shardMs.toString()} ms");
  print("Aggregation: ${statsMs.toString()} ms");
  print("Total: ${total.toInt().toString()}");
  print("Max: ${highest.toInt().toString()}");
  print("Min: ${lowest.toInt().toString()}");
  print("Avg: ${average.toInt().toString()}");
  print("Verified: yes");
END
