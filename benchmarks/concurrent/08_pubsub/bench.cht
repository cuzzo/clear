# @leak: 10000 -> 100
# Pub-Sub Benchmark — CLEAR
#
# 1 publisher broadcasts 10K messages to 64 subscribers.
# Each subscriber processes every message (2000 LCG iterations).
# Total work: 10K * 64 * 2000 = 1.28 billion LCG iterations.
#
# CLEAR: publisher writes once to a shared SplitStream ring buffer.
# Each subscriber CLONEs an independent cursor — zero message copying.
# Compare to Go/Rust: publisher sends to 64 separate channels (N copies).

STRUCT Msg { seed: Int64 }

FN processMessage(seed: Int64) RETURNS Int64 ->
    MUTABLE x: Int64 = seed;
    FOR i IN (0_i64 ..< 2000) -> x = x %* 6364136223846793005_i64 %+ 1442695040888963407_i64;
    RETURN x;
END

FN main() RETURNS Void ->
    t0 = timestampMs();

    msgs: ~?Msg[] @split = BG STREAM {
        FOR i IN (0 ..< 10000) -> YIELD Msg{ seed: i };
    };

    MUTABLE futures: ~Int64[]@list = [];
    FOR i IN (0 ..< 64) DO
        subscriber_msgs: ~?Msg[] @split = CLONE msgs;
        futures.append(BG {
            @parallel ->
            MUTABLE total: Int64 = 0;
            WHILE NEXT subscriber_msgs AS m DO
                total = total %+ processMessage(m.seed);
            END
            total;
        });
    END

    MUTABLE total: Int64 = 0;
    FOR j IN (0 ..< 64) DO
        result = NEXT futures[j];
        total = total %+ result;
    END
    elapsed = timestampMs() - t0;

    checksum = total MOD 1000000000;
    print("Checksum: ${checksum.toString()}");
    print("Messages: 10000");
    print("Subscribers: 64");
    print("BENCH_RESULT: ${elapsed.toString()} ms");
    print("Time: ${elapsed.toString()} ms");
    RETURN;
END
