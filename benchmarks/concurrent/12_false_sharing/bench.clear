# @leak: 40000000 -> 40000
# False Sharing Benchmark -- CLEAR (@shared:locked)
#
# threadCount() fibers each increment their own @shared:locked counter.
# Each counter is an independent Arc<Mutex<Counter>> heap allocation, so
# counters naturally land on separate cache lines. No false sharing.
#
# Compare to C/Go packed arrays where adjacent counters share a cache line,
# causing 5-20x slowdown from cache line bouncing across cores.
#
# CLEAR's @shared eliminates false sharing by construction: every @shared
# value is its own heap allocation with a control block, guaranteeing
# cache line isolation without manual padding.

STRUCT Counter {
  value: Int64
}

FN main() RETURNS !Void ->
  workers = threadCount();
  totalWork = 40_000_000;
  increments = totalWork / workers;

  # Each worker gets its own @shared:locked counter (separate heap alloc)
  MUTABLE counters: []Counter@shared:locked = [];
  FOR i IN (0 ..< workers) DO
    counters.append(Counter{ value: 0 } @shared:locked);
  END

  t0 = timestampMs();

  MUTABLE futures: ~Void[]@list = [];
  MUTABLE wi = 0;
  WHILE wi < workers DO
    IF counters[wi] EXISTS AS ref0 THEN
      ref = CLONE ref0;
      futures
        .append(
          BG {
            @standard:@parallel -> FOR j IN (0 ..< increments) DO
              WITH EXCLUSIVE ref AS inner {inner.value = inner.value + 1;}
            END

        }
      );
    END
  wi += 1;
END

FOR i IN (0 ..< workers) DO
  IF futures[i] EXISTS AS future THEN NEXT future; END
END
elapsed = timestampMs() - t0;

# Verify
MUTABLE total = 0;
FOR i IN (0 ..< workers) DO
  IF counters[i] EXISTS AS ref THEN
    WITH ref AS inner {
      total = total + inner.value;
    }
  END
END
expected = workers * increments;
ASSERT total == expected, "total mismatch";

print("BENCH_RESULT: ${elapsed.toString()} ms");
print("False-sharing (${workers.toString()} threads x ${increments.toString()} iters)");
print("  @shared:locked (no false sharing): ${elapsed.toString()} ms");
print("  Total: ${total.toString()}");
END
