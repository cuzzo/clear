-- Atomic Contention Benchmark — CLEAR
--
-- 1024 fibers each increment a shared counter 10 000 times.
-- Total expected: 10 240 000.
--
-- @local: zero-cost shared mutable reference (*Counter, no Mutex).
-- All BG blocks are auto-pinned to the local scheduler because the
-- compiler sees @local capture.  Cooperative single-threaded execution
-- means the counter's cache line stays in L1 Modified state — zero
-- bus traffic, zero lock overhead.
--
-- Compare to Go's atomic.AddInt64 which bounces the cache line across
-- cores under M:N scheduling (~15ns/op on 2 cores, worse on more).

STRUCT Counter { value: Int64 }

FN cheatMain() RETURNS Void ->
    MUTABLE c = Counter{ value: 0 } @local;

    t0 = timestampMs();
    MUTABLE futures: ~Void[]@list = [];
    MUTABLE i: Int64 = 0;
    WHILE i < 1024 DO
        futures.append(BG {
            MUTABLE j: Int64 = 0;
            WHILE j < 10000 DO
                c.value += 1;
                j += 1;
            END
        });
        i += 1;
    END

    MUTABLE k: Int64 = 0;
    WHILE k < 1024 DO
        NEXT futures[k];
        k += 1;
    END
    elapsed = timestampMs() - t0;

    print("Counter: ${c.value.toString()}");
    print("Time: ${elapsed.toString()} ms");
    RETURN;
END
