-- Backpressure Benchmark — CLEAR
--
-- Producer generates 100,000 items.  Consumer pool processes each item
-- with CPU work (500 LCG iterations).  Backpressure is applied via
-- CONCURRENT(pool_size: 8) which uses a semaphore to limit in-flight
-- work — the producer fiber blocks when all 8 slots are busy.
--
-- CLEAR does not have bounded channels (v0.1).  The CONCURRENT pipeline
-- is the closest mechanism: it gates fan-out with a semaphore, providing
-- backpressure at the pipeline level rather than the channel level.
--
-- This benchmark reveals the overhead of CLEAR's pipeline machinery
-- compared to Go's native channels and Rust/Tokio's mpsc.

STRUCT Item { seed: Int64, result: Int64 }

FN processItem(val: Int64) RETURNS Int64 ->
    MUTABLE x: Int64 = val;
    MUTABLE i: Int64 = 0;
    WHILE i < 500 DO
        x = x * 6364136223846793005 + 1442695040888963407;
        i = i + 1;
    END
    RETURN x;
END

FN cheatMain() RETURNS Void ->
    -- Build work items
    MUTABLE items: Item[] = [];
    MUTABLE i: Int64 = 0;
    WHILE i < 100000 DO
        append(items, Item{ seed: i, result: 0 });
        i = i + 1;
    END

    -- Process with backpressure (pool_size: 8 = max 8 concurrent fibers)
    processed = items s> CONCURRENT(pool_size: 8) SELECT processItem(_.seed);

    -- Sum results (SUM returns Number, so we accumulate as Number)
    MUTABLE total: Int64 = 0;
    MUTABLE j: Int64 = 0;
    WHILE j < 100000 DO
        total = total + processed[j];
        j = j + 1;
    END

    print("Total:", total);
    print("Items: 100000, Consumers: 8, Pool: 8");

    RETURN;
END
