# Benchmark 25: Pathological Workloads -- CLEAR
#
# Protocol (text, \r\n terminated):
#   WORK:ID:N  -> compute N iterations of heavy math on seed ID, respond :RESULT\r\n
#   QUIT       -> close connection
#   READY?     -> respond +READY\r\n
#
# Three phases test scheduler fairness:
#   1. Uniform:     all requests do equal work
#   2. Skewed:      1% of requests do 1000x more work
#   3. Adversarial: one connection does all heavy work
#
# Pure compute (no FFI, no onRootStack). Tests scheduler quality directly.

FN heavyCompute(seed: Int64, n: Int64) RETURNS Int64 ->
  MUTABLE x = seed;
  FOR i IN (0 ..< n) DO
    x = x %* 6_364_136_223_846_793_005 %+ 1_442_695_040_888_963_407;
    x = x %* x %+ 1;
  END
  IF x < 0 -> x = 0 - x;
  RETURN x MOD 1_000_000_000;
END

FN handleClient(client: TCPClient) RETURNS !Void ->
  MUTABLE running = TRUE;
  WHILE running DO
    data: String@raw = client.tcpRead();
    IF data.empty?() THEN
      running = FALSE;
    ELSE
      MUTABLE resp = "";
      MUTABLE pos = 0;
      WHILE pos < data.length() DO
        MUTABLE eol = pos;
        WHILE eol < data.length() AND data.charAt(eol) != "\r" AND data.charAt(eol) != "\n" DO
          eol += 1;
        END
        line = data.substr(pos, eol - pos);
        pos = eol;
        WHILE pos < data.length() AND (data.charAt(pos) == "\r" OR data.charAt(pos) == "\n") DO
          pos += 1;
        END

        IF line.empty?() THEN
          # skip
        ELSE_IF line.startsWith?("WORK:") THEN
          rest: String@raw = line.substr(5, line.length() - 5);
          MUTABLE colonPos = 0;
          WHILE colonPos < rest.length() AND rest.charAt(colonPos) != ":" DO
            colonPos += 1;
          END
          idStr = rest.substr(0, colonPos);
          nStr = rest.substr(colonPos + 1, rest.length() - colonPos - 1);
          MUTABLE id = (idStr.toNumber() OR_ELSE 0.0).toInt();
          MUTABLE n = (nStr.toNumber() OR_ELSE 0.0).toInt();
          IF n < 1 THEN
            n = 1;
          END
          result = heavyCompute(id, n);
          resp = resp $+ ":${result.toString()}\r\n";
        ELSE_IF line == "QUIT" THEN
          resp = resp $+ "+OK\r\n";
          running = FALSE;
        ELSE_IF line == "READY?" THEN
          resp = resp $+ "+READY\r\n";
        ELSE
          resp = resp $+ "-ERR unknown command\r\n";
        END
      END
      IF resp.any?() -> client.tcpWrite(resp);
    END
  END
END

FN main() RETURNS Void ->
  server = TRY TCPServer::listen(6390);
  print("CLEAR pathological server listening on port 6390");

  # Pin BG fibers to the main scheduler to prevent work-stealing
  # which corrupts epoll fd registration.
  MUTABLE pin: {String}@sharded(32):locked Int64 = {};

  MUTABLE tasks: ~!Void[]@list = [];
  WHILE TRUE DO
    client = TRY server.accept();
    &tasks.append(
      BG {
        n = pin.count();
        handleClient(client);
      }
    );
  END
END
