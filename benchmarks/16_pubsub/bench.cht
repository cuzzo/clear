-- Pub-Sub Benchmark — streaming promises with backpressure — CLEAR
--
-- 64 subscribers each receive 100K messages via a dedicated ~Int64[INF]
-- stream generator. The 64-slot lock-free ring buffer blocks the generator
-- when the subscriber falls behind — true per-subscriber backpressure.
-- No intermediate Msg[] list is materialized.
--
-- Architecture:
--   Publisher: one BG STREAM fiber per subscriber (SPSC InfStream).
--   Subscriber: one BG fiber per subscriber reads lazily via NEXT.
--   Backpressure: generator yields when ring buffer is full; consumer
--     wakes producer after draining a slot.
--
-- Contrast with previous approach (materializes Msg[] then CONCURRENT):
--   Previous: ~420 MB peak RSS (100K * 64 structs)
--   Current:  ~32 KB peak RSS (64 * 64-slot ring buffers)
--
-- Total work: 100K * 64 * 2000 = 12.8 billion LCG iterations.

FN processMessage(seed: Int64) RETURNS Int64 ->
    MUTABLE x: Int64 = seed;
    FOR i IN (0_i64 ..< 2000) -> x = x %* 6364136223846793005_i64 %+ 1442695040888963407_i64;
    RETURN x;
END

FN main() RETURNS Void ->
    t0 = timestampMs();

    -- 64 subscriber BG fibers. Each spawns its own InfStream generator and
    -- reads lazily. The 64-slot ring buffer provides backpressure: the
    -- generator blocks when the subscriber hasn't drained the next slot.
    MUTABLE futures: ~Int64[]@list = [];
    FOR i IN (0_i64 ..< 64) DO
        futures.append(BG {
            stream: ~Int64[INF] = BG STREAM {
                MUTABLE j: Int64 = 0;
                WHILE TRUE DO
                    YIELD j;
                    j = j + 1;
                END
            };
            MUTABLE total: Int64 = 0;
            FOR k IN (0_i64 ..< 100000) DO
                msg = NEXT stream;
                total = total %+ processMessage(msg);
            END
            total;
        });
    END

    MUTABLE total: Int64 = 0;
    FOR j IN (0_i64 ..< 64) ->
        total = total %+ NEXT futures[j];

    elapsed = timestampMs() - t0;
    checksum = total MOD 1000000000;
    print("Checksum: ${checksum.toString()}");
    print("Messages: 100000");
    print("Subscribers: 64");
    print("Time: ${elapsed.toString()} ms");
    RETURN;
END
