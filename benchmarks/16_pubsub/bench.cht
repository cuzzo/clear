-- Pub-Sub Benchmark — CLEAR
--
-- Models 1 publisher broadcasting 100K messages to 64 subscribers.
-- Each subscriber processes every message with CPU-bound work
-- (2000 LCG iterations per message).
-- Total work: 100K * 64 * 2000 = 12.8 billion LCG iterations.
--
-- CLEAR approach: each subscriber is a BG fiber that processes
-- the message range using CONCURRENT(workers: 8, parallel: TRUE).
-- Since the publisher just sends sequential IDs (0..99999), each
-- subscriber generates its own sequence — no shared-memory broadcast
-- needed.  This is the same pattern as multicast market data where
-- each subscriber independently decodes the same feed.
--
-- Compare to Go (64 goroutines + buffered channels) and Rust
-- (64 Tokio tasks + broadcast channel).

STRUCT Msg { seed: Int64 }

FN processMessage(seed: Int64) RETURNS Int64 ->
    MUTABLE x: Int64 = seed;
    FOR i IN (0_i64 ..< 2000) -> x = x %* 6364136223846793005_i64 %+ 1442695040888963407_i64;
    RETURN x;
END

FN subscriberWork(n: Int64) RETURNS Int64 ->
    -- Build local message list
    MUTABLE msgs: Msg[] = [];
    FOR i IN (0_i64 ..< n) -> msgs.append(Msg{ seed: i });
    -- Process all messages with parallel workers
    results = msgs s> CONCURRENT(workers: 32, parallel: TRUE) SELECT processMessage(_.seed);
    -- Manual sum (SUM _ returns Float64, we need Int64)
    MUTABLE total: Int64 = 0;
    FOR j IN (0_i64 ..< results.length()) -> total = total %+ results[j];
    RETURN total;
END

FN main() RETURNS Void ->
    t0 = timestampMs();
    MUTABLE futures: ~Int64[]@list = [];
    FOR i IN (0_i64 ..< 64) -> futures.append(BG { subscriberWork(100000); });

    MUTABLE total: Int64 = 0;
    FOR j IN (0_i64 ..< 64) DO
        result = NEXT futures[j];
        total = total %+ result;
    END
    elapsed = timestampMs() - t0;

    checksum = total MOD 1000000000;
    print("Checksum: ${checksum.toString()}");
    print("Messages: 100000");
    print("Subscribers: 64");
    print("Time: ${elapsed.toString()} ms");
    RETURN;
END
