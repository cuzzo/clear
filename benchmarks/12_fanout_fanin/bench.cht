-- Fan-Out / Fan-In Benchmark — CLEAR
--
-- 10,000 items, each processed with CPU-bound work (1000 LCG iterations),
-- results collected into a single sum.
--
-- Uses CONCURRENT(workers: 8, parallel: TRUE) SELECT — persistent worker
-- pool distributed across schedulers.  8 workers process 10K items via
-- shared atomic index.  Zero per-item fiber spawn.
--
-- Compare to Go (10K goroutines + WaitGroup) and Rust (10K Tokio tasks
-- + JoinSet).

STRUCT Work { seed: Int64 }

FN doWork(seed: Int64) RETURNS Int64 ->
    MUTABLE x: Int64 = seed;
    FOR i IN (0_i64 ..< 1000) -> x = x * 6364136223846793005 + 1442695040888963407;
    RETURN x;
END

FN main() RETURNS Void ->
    t0 = timestampMs();
    -- Build work items
    MUTABLE items: Work[] = [];
    FOR i IN (0_i64 ..< 10000) -> items.append(Work{ seed: i });

    -- Fan-out: 8 persistent workers, distributed across schedulers
    results = items s> CONCURRENT(workers: 8, parallel: TRUE) SELECT doWork(_.seed);

    -- Fan-in: sum results
    MUTABLE total: Int64 = 0;
    FOR j IN (0_i64 ..< 10000) -> total += results[j];

    print("Total:", total);
    print("Workers: 10000, Iterations: 1000");

    elapsed = timestampMs() - t0;
    print("Time: ${elapsed.toString()} ms");
    RETURN;
END
