{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CHEAT",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#sigils"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.cheat",
          "match": "--.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.cheat",
          "match": "\\b(IF|THEN|ELSE|ELSE_IF|END|MATCH|START|WHEN|WHILE|DO|FOR|BREAK|CONTINUE|RETURN|OR|PASS|CATCH|PARALLEL|ASYNC|SYNC|COLLECT|STRUCT|USE)\\b"
        },
        {
          "name": "storage.type.cheat",
          "match": "\\b(VAR|MUTABLE|SET|FN)\\b"
        },
        {
          "name": "keyword.other.memory.cheat",
          "match": "\\b(GIVE|TAKES|COPY|FREE)\\b"
        },
        {
          "name": "keyword.other.sql.cheat",
          "match": "\\b(SELECT|WHERE|UNNEST|EACH|INDEX|SORT)\\b"
        },
        {
          "name": "constant.language.boolean.cheat",
          "match": "\\b(TRUE|FALSE)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.cheat",
          "match": "\\b(Number|UInt8|UInt16|UInt32|UInt64|Int8|Int16|Int32|Int64|Float32|Float64|Bool|String|Stream)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.cheat",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.cheat",
          "match": "\\\\."
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*!?)(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.cheat"
            }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.cheat",
          "match": "\\b0x[0-9a-fA-F]+(u8|u16|u32|u64|i8|i16|i32|i64)?\\b"
        },
        {
          "name": "constant.numeric.binary.cheat",
          "match": "\\b0b[01]+(u8|u16|u32|u64|i8|i16|i32|i64)?\\b"
        },
        {
          "name": "constant.numeric.octal.cheat",
          "match": "\\b0o[0-7]+(u8|u16|u32|u64|i8|i16|i32|i64)?\\b"
        },
        {
          "name": "constant.numeric.float.cheat",
          "match": "\\b\\d+\\.\\d+(f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.integer.cheat",
          "match": "\\b\\d+(u8|u16|u32|u64|i8|i16|i32|i64)?\\b"
        }
      ]
    },
    "sigils": {
      "patterns": [
        {
          "name": "keyword.operator.sigil.heap.cheat",
          "match": "%"
        },
        {
          "name": "keyword.operator.sigil.borrow.cheat",
          "match": "&"
        },
        {
          "name": "variable.other.bind.cheat",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "keyword.operator.panic.cheat",
          "match": "!!"
        },
        {
          "name": "keyword.operator.mutation.cheat",
          "match": "!"
        },
        {
          "name": "keyword.operator.question.cheat",
          "match": "\\?"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipeline.cheat",
          "match": "(s>|\\|>)"
        },
        {
          "name": "keyword.operator.arrow.cheat",
          "match": "->"
        },
        {
          "name": "keyword.operator.range.cheat",
          "match": "(\\.\\.<|\\.\\.=|\\[\\*\\])"
        },
        {
          "name": "keyword.operator.standard.cheat",
          "match": "(\\+|-|\\*|/|=|==|!=|<|>|<=|>=)"
        },
        {
           "name": "variable.language.placeholder.cheat",
           "match": "\\b_\\b"
        }
      ]
    }
  },
  "scopeName": "source.cheat"
}

