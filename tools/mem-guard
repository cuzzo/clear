#!/bin/sh
# Run any command under a hard resident-memory cap.
#
# Darwin does not enforce RLIMIT_AS -- `ulimit -v` is rejected outright and a
# test process allocated 10 GB straight through it -- so a runaway child cannot
# be capped by the kernel. This polls the child's process tree and kills it.
# A single zig run reached 77 GB here and forced two physical resets; the Ruby
# closure census is the same hazard from the other direction.
#
#   MEM_GUARD_CAP_MB=32768 tools/mem-guard ruby big_job.rb
#
# MEM_GUARD_CAP_MB defaults to a quarter of RAM; 0 disables the watchdog.
# MEM_GUARD_LABEL names the child in messages. MEM_GUARD_REPORT=1 prints peak.
set -u

[ $# -ge 1 ] || { echo "mem-guard: usage: mem-guard <command> [args...]" >&2; exit 2; }
LABEL="${MEM_GUARD_LABEL:-$(basename "$1")}"

CAP_MB="${MEM_GUARD_CAP_MB:-}"
if [ -z "$CAP_MB" ]; then
  total_mb=$(( $(sysctl -n hw.memsize 2>/dev/null || echo 8589934592) / 1048576 ))
  CAP_MB=$(( total_mb / 4 ))
  [ "$CAP_MB" -lt 4096 ] && CAP_MB=4096
fi
[ "$CAP_MB" = "0" ] && exec "$@"

"$@" &
child=$!
cap_kb=$(( CAP_MB * 1024 ))
peak_kb=0

# Resident set of the WHOLE tree: a child that spawns workers (zig's linker,
# a fork pool) would slip a cap that only watched the root.
tree_kb() {
  ps -Ao pid=,ppid=,rss= 2>/dev/null | awk -v root="$1" '
    { pid[NR]=$1; ppid[NR]=$2; rss[NR]=$3; n=NR }
    END {
      want[root]=1
      for (pass=0; pass<12; pass++)
        for (i=1; i<=n; i++) if (want[ppid[i]]) want[pid[i]]=1
      t=0; for (i=1; i<=n; i++) if (want[pid[i]]) t+=rss[i]
      print t+0
    }'
}

kill_tree() {
  ps -Ao pid=,ppid= 2>/dev/null | awk -v root="$1" '
    { pid[NR]=$1; ppid[NR]=$2; n=NR }
    END {
      want[root]=1
      for (pass=0; pass<12; pass++)
        for (i=1; i<=n; i++) if (want[ppid[i]]) want[pid[i]]=1
      for (i=1; i<=n; i++) if (want[pid[i]]) print pid[i]
    }' | while read -r p; do kill -9 "$p" 2>/dev/null; done
}

trap 'kill_tree "$child"; exit 130' INT TERM

while kill -0 "$child" 2>/dev/null; do
  rss_kb=$(tree_kb "$child"); [ -n "$rss_kb" ] || rss_kb=0
  [ "$rss_kb" -gt "$peak_kb" ] && peak_kb=$rss_kb
  if [ "$rss_kb" -gt "$cap_kb" ]; then
    kill_tree "$child"
    echo "mem-guard: KILLED $LABEL at $(( rss_kb / 1024 )) MB resident (cap ${CAP_MB} MB)." >&2
    echo "mem-guard: this is a memory runaway, not a compile error." >&2
    wait "$child" 2>/dev/null
    exit 137
  fi
  sleep 0.25
done
wait "$child"; status=$?
[ -n "${MEM_GUARD_REPORT:-}" ] && echo "mem-guard: $LABEL peak $(( peak_kb / 1024 )) MB" >&2
exit $status
