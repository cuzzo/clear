# --- Allow-list for project root ---
# Ignore everything at root, then explicitly allow known files/dirs.
# Anything new dropped at root is ignored by default.
/*
!/.github/
!/.gitignore
!/.rspec
!/.vscode/
!/CLAUDE.md
!/CONTRIBUTING.md
!/GEMINI.md
!/Gemfile
!/Gemfile.lock
!/LICENSE
!/ONE-PAGER.md
!/README.md
!/TODO.md
!/WALKTHROUGH.md
!/clear
!/benchmarks/
!/docs/
!/examples/
!/manifesto/
!/spec/
!/src/
!/syntaxes/
!/testdata/
!/transpile-tests/
!/zig/

# --- Allow-list for benchmarks/ ---
# Ignore everything under benchmarks/, then allow only source / config /
# marker files. Compiled binaries, caches, and accidental drops stay out.
benchmarks/**
!benchmarks/**/
!benchmarks/.gitignore
!benchmarks/runner.rb
!benchmarks/**/*.cht
!benchmarks/**/*.c
!benchmarks/**/*.h
!benchmarks/**/*.cpp
!benchmarks/**/*.hpp
!benchmarks/**/*.go
!benchmarks/**/*.rs
!benchmarks/**/*.zig
!benchmarks/**/*.zon
!benchmarks/**/*.py
!benchmarks/**/*.rb
!benchmarks/**/*.md
!benchmarks/**/*.toml
!benchmarks/**/*.mod
!benchmarks/**/*.sum
!benchmarks/**/Makefile
!benchmarks/**/THREADS
!benchmarks/**/TIMEOUT
!benchmarks/**/SKIP
!benchmarks/**/FAIL
!benchmarks/**/compare.sh
!benchmarks/**/build.sh
# Cargo.lock: explicitly NOT allowed (regenerated by cargo).
benchmarks/**/Cargo.lock

# --- Allow-list for examples/ ---
# Ignore everything under examples/, then allow only source / config /
# docs. Compiled binaries, .clear-build.json, .zig-cache/ stay out.
examples/**
!examples/**/
!examples/.gitignore
# General source files
!examples/**/*.cht
!examples/**/*.md
!examples/**/*.toml
!examples/**/*.zon
!examples/**/*.zig
# minivm has Ruby/Python helpers + the bytecode compiler
!examples/**/*.py
!examples/**/*.rb
# footguns has multi-language demos (.c, .go, .rs)
!examples/footguns/**/*.c
!examples/footguns/**/*.go
!examples/footguns/**/*.rs
!examples/footguns/**/*.h
# minivm has its own *.cht test fixtures + the bc_runner alias
!examples/minivm/_bc_runner.cht
# web_crawler has a build.zig
!examples/web_crawler/**/build.zig*
# Sub-package directories that benchmarks may need
!examples/web_crawler/packages/

# Logs / vendored deps
vendor
.byebug_history
coverage/
tmp/rubycritic/
log.txt

# Zig build artifacts (top-level scratch / cache directories)
zig/all-tests.zig
zig/transpile-test.zig
zig/zig-out
zig/.zig-cache
zig/.zig-cache-*
zig/.clear-cache
zig/.clear-transpile-cache
zig/fiber-stack-check/pass/build
zig/*.bc
zig/*.o
zig/._clear_tmp_*
zig/data

# Transpile-tests build artifacts
transpile-tests/ffi-integration/.zig-cache
transpile-tests/module-integration/.zig-cache
# Compiled transpile-test binaries (numeric prefix, no extension).
# Source files have .cht / .zig / .disabled.
transpile-tests/[0-9]*
!transpile-tests/[0-9]*.cht
!transpile-tests/[0-9]*.zig
!transpile-tests/[0-9]*.disabled
!transpile-tests/[0-9]*.cht.disabled
!transpile-tests/[0-9]*/

# Catch-all
**/*.profile/
**/.zig-cache/
**/*.clear-build.json
