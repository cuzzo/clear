# --- Allow-list for project root ---
# Ignore everything at root, then explicitly allow known files/dirs.
# Anything new dropped at root is ignored by default.
/*
!/.devcontainer/
!/.github/
!/.gitignore
!/.npmrc
!/.rspec
!/.sqlfluff
!/.vscode/
!/CLAUDE.md
!/CONTRIBUTING.md
!/codecov.yml
!/GEMINI.md
!/Gemfile
!/Gemfile.lock
!/gems/
!/gems/**
!/LICENSE
!/ONE-PAGER.md
!/package-lock.json
!/package.json
!/README.md
!/TODO.md
!/clear
!/bin/
!/benchmarks/
!/compiler/
!/compiler/**
!/docs/
!/examples/
!/gems/
!/manifesto/
!/site/
!/sorbet/
!/stdlib/
!/syntaxes/
!/testdata/
!/tools/
!/transpile-tests/
!/zig/

# --- Allow-list for benchmarks/ ---
# Ignore everything under benchmarks/, then allow only source / config /
# marker files. Compiled binaries, caches, and accidental drops stay out.
benchmarks/**
!benchmarks/**/
!benchmarks/.gitignore
!benchmarks/runner.rb
!benchmarks/**/*.clear
!benchmarks/**/*.c
!benchmarks/**/*.h
!benchmarks/**/*.cpp
!benchmarks/**/*.hpp
!benchmarks/**/*.go
!benchmarks/**/*.rs
!benchmarks/**/*.zig
!benchmarks/**/*.zon
!benchmarks/**/*.py
!benchmarks/**/*.rb
!benchmarks/**/*.puck
!benchmarks/**/*.sh
!benchmarks/**/*.md
!benchmarks/**/*.toml
!benchmarks/**/*.mod
!benchmarks/**/*.sum
!benchmarks/**/Makefile
!benchmarks/**/THREADS
!benchmarks/**/TIMEOUT
!benchmarks/**/SKIP
!benchmarks/**/FAIL
!benchmarks/**/compare.sh
!benchmarks/**/build.sh
# Cargo.lock: explicitly NOT allowed (regenerated by cargo).
benchmarks/**/Cargo.lock

# --- Allow-list for examples/ ---
# Ignore everything under examples/, then allow only source / config /
# docs. Compiled binaries, .clear-build.json, .zig-cache/ stay out.
examples/**
!examples/**/
!examples/.gitignore
# General source files
!examples/**/*.clear
!examples/**/*.md
!examples/**/*.puck
!examples/**/*.toml
!examples/**/*.zon
!examples/**/*.zig
# minivm golden harness: bytecode snapshots + expected-output files are
# committed test data (the integration golden harness hard-fails if
# they are missing on a fresh checkout, e.g. CI).
!examples/minivm/vm-tests/**/*.bc
!examples/minivm/vm-tests/**/*.out
# minivm has Ruby/Python helpers + the bytecode compiler
!examples/**/*.py
!examples/**/*.rb
# footguns has multi-language demos (.c, .go, .rs)
!examples/footguns/**/*.c
!examples/footguns/**/*.go
!examples/footguns/**/*.rs
!examples/footguns/**/*.h
# puck v10 has a C VM and Makefile
!examples/puck/v10/*.c
!examples/puck/v10/*.h
!examples/puck/v10/Makefile
# puck v11 has a C VM + JIT and Makefile
!examples/puck/v11/*.c
!examples/puck/v11/*.h
!examples/puck/v11/Makefile
# minivm has its own *.clear test fixtures + the bc_runner alias
!examples/minivm/_bc_runner.clear
# web_crawler has a build.zig
!examples/web_crawler/**/build.zig*
# Sub-package directories that benchmarks may need
!examples/web_crawler/packages/

# Logs / vendored deps
vendor
.byebug_history
coverage/
tmp/rubycritic/
log.txt

# Zig build artifacts (top-level scratch / cache directories)
zig/all-tests.zig
zig/all-fuzz.zig
zig/transpile-test.zig
zig/zig-out
zig/.zig-cache
zig/.zig-cache-*
zig/.clear-cache
zig/.clear-transpile-cache
zig/fiber-stack-check/pass/build
zig/*.bc
zig/*.o
zig/._clear_tmp_*
zig/._clear_cov_*
zig/data

# Transpile-tests build artifacts
transpile-tests/ffi-integration/.zig-cache
transpile-tests/module-integration/.zig-cache
# Compiled transpile-test binaries (numeric prefix, no extension).
# Source files have .clear / .zig / .disabled.
transpile-tests/[0-9]*
!transpile-tests/[0-9]*.clear
!transpile-tests/[0-9]*.zig
!transpile-tests/[0-9]*.disabled
!transpile-tests/[0-9]*.clear.disabled
!transpile-tests/[0-9]*/

# Generated fuzz programs (see tools/fuzz/). Promoted regressions move into
# transpile-tests/ proper; the fuzz/ dir holds only ephemeral output.
transpile-tests/fuzz/*.clear
transpile-tests/fuzz/*.rb

# Catch-all
**/*.profile/
**/.zig-cache/
**/zig-out/
**/*.clear-build.json
**/__pycache__/

# Self-host bootstrap build outputs (sources use explicit extensions).
compiler/src/ast/lexer
compiler/src/ast/parser

# Generated gem diagnostics and local analysis output.
gems/**/*.log
gems/**/*.orig
gems/**/*.profraw
gems/decomplex/report_*.md
gems/espalier/report_*.md
gems/fact-mine/check_errors.txt
gems/fact-mine/coverage.txt
gems/fact-mine/debug.log
gems/fact-mine/out.json

# ruby-to-clear verifier output. A deliberately promoted baseline belongs in
# baseline.{json,md}; each local run overwrites latest.{json,md}.
gems/ruby-to-clear/analysis/results/latest.json
gems/ruby-to-clear/analysis/results/latest.md

# Generated architecture reports
gems/espalier/architecture.yml

# Decomplex native Rust build artifacts
gems/decomplex/target/
gems/fact-mine/target/
gems/nil-kill/target/
