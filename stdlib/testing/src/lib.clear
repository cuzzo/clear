# pkg:testing — CLEAR's first-party testing stdlib package.
#
# Auto-resolvable via `REQUIRE "pkg:testing"`. The compiler walks
# stdlib/<name>/src/lib.clear under the repo root after exhausting
# explicitly-registered packages.
#
# v1 ships:
#   - this skeleton (smoke proof of pkg:testing wiring)
#   - the foundational predicate library (in core STD_LIB so
#     every CLEAR program gets `.zero?` / `.positive?` / `.between?`
#     / `.closeTo?` etc. without REQUIRE'ing this package)
#
# Future tranches will populate:
#   - diff renderer (equality-failure pretty-printer)
#   - LET / hook lowering helpers
#   - CLI flag translation (--tag, --focus → Zig --test-filter)
#
# See docs/agents/rspec-light.md for the full spec.

# Smoke marker. The mere presence of this PUB FN proves pkg:testing
# resolves and parses end-to-end. Real exports land in later
# tranches; for now this is a no-op that future tests can call to
# confirm the package was successfully imported.
PUB FN ready?() RETURNS Bool ->
    RETURN TRUE;
END
