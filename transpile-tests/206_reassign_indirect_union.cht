-- Test: reassigning a non-Copy variable using itself as an argument.
-- Bug: `x = f(x)` generated `cleanup(x); x = f(x)` (use-after-free).
-- Fix: generate `{ const __new = f(x); cleanup(x); x = __new; }`.
--
-- Unions with @indirect fields are non-Copy and have heap cleanup.
-- This test uses MUTABLE v = transform(v) to trigger the bug.

UNION Val {
    Nil,
    Box: Int64 @indirect,
}

FN transform(v: Val) RETURNS !Val ->
    PARTIAL MATCH v START
        Val.Box AS n -> RETURN Val{ Box: n * 2 };,
        DEFAULT -> RETURN Val.Nil;
    END
    RETURN Val.Nil;
END

FN main() RETURNS Void ->
    MUTABLE v: Val = Val{ Box: 3_i64 };
    v = transform(v);
    PARTIAL MATCH v START
        Val.Box AS n -> ASSERT n == 6_i64, "doubled";,
        DEFAULT -> ASSERT FALSE, "should be Box";
    END

    MUTABLE w: Val = Val{ Box: 5_i64 };
    w = transform(w);
    w = transform(w);
    PARTIAL MATCH w START
        Val.Box AS n -> ASSERT n == 20_i64, "double transform";,
        DEFAULT -> ASSERT FALSE, "should be Box after double transform";
    END

    RETURN;
END
