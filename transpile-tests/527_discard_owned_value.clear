# Regression: `_ = <owned expr>;` discard must bind a unique temp
# and still be cleaned up (no leak), not emit literal Zig `_`.
FN mkList() RETURNS ![]Int64 ->
    MUTABLE xs: []Int64 = List[];
    xs.append(7_i64);
    RETURN GIVE xs;
END

STRUCT Bag { items: []Int64 }

FN mkBag() RETURNS !Bag ->
    MUTABLE ys: []Int64 = List[];
    ys.append(9_i64);
    RETURN Bag{ items: GIVE ys };
END

FN run() RETURNS !Void ->
    # Discarded owned values: must compile to a real temp AND be freed.
    _ = mkList() OR_ELSE RAISE;
    _ = mkBag() OR_ELSE RAISE;
    # The same functions, bound, prove they actually produce the values
    # (the discard path must not corrupt or alter behavior).
    keep: []Int64 = mkList() OR_ELSE RAISE;
    bag: Bag = mkBag() OR_ELSE RAISE;
    ASSERT length(keep) == 1_i64, "discard path leaves mkList correct";
    ASSERT length(bag.items) == 1_i64, "discard path leaves mkBag correct";
    RETURN;
END

FN main() RETURNS Void ->
    run() OR_ELSE PASS;
    RETURN;
END
