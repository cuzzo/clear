# Union constructor return: the transpiler must emit `const __ret`
# (not `var`) when the return value doesn't need field promotion.
# Zig 0.15 errors on `var` that is never mutated.

STRUCT Wrapper { value: Float64 }

FN make_wrapper(x: Float64) RETURNS Wrapper ->
    RETURN Wrapper{ value: x };
END

FN main() RETURNS Void ->
    w = make_wrapper(42.0);
    ASSERT w.value == 42.0, "struct return with const __ret";

    # Also test returning a struct with a string field (needs var for promotion)
    RETURN;
END
