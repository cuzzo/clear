-- Line parsing: iterate chars, extract lines, dispatch commands.
-- This mirrors the server's protocol parsing logic.

FN parseLine(data: String) RETURNS !String ->
    MUTABLE result = "";
    MUTABLE pos: Int64 = 0;

    WHILE pos < data.length() DO
        -- Find end of line
        MUTABLE eol = pos;
        WHILE eol < data.length() && charAt(data, eol) != "\n" DO
            eol += 1;
        END

        line = substr(data, pos, eol - pos);

        -- Skip past newline
        pos = eol;
        WHILE pos < data.length() && charAt(data, pos) == "\n" DO
            pos += 1;
        END

        IF line.length() == 0 THEN
            -- skip empty
        ELSE_IF startsWith?(line, "SET:") THEN
            idStr = substr(line, 4_i64, line.length() - 4);
            result = result + "SET=" + idStr + ";";
        ELSE_IF startsWith?(line, "GET:") THEN
            idStr = substr(line, 4_i64, line.length() - 4);
            result = result + "GET=" + idStr + ";";
        ELSE
            result = result + "ERR;";
        END
    END

    RETURN result;
END

FN main() RETURNS Void ->
    -- Single command
    ASSERT parseLine("SET:1\n") == "SET=1;", "single SET";
    ASSERT parseLine("GET:42\n") == "GET=42;", "single GET";

    -- Multiple commands in one read
    ASSERT parseLine("SET:1\nGET:1\n") == "SET=1;GET=1;", "multi command";

    -- Unknown command
    ASSERT parseLine("NOPE\n") == "ERR;", "unknown command";

    -- Empty lines skipped
    ASSERT parseLine("\n\nSET:5\n\n") == "SET=5;", "skip empty lines";

    RETURN;
END
