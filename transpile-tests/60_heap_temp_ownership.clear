# Comprehensive test: string temporaries from function returns.
# Strings live in the caller's frame arena (no heap dupe on return).
# GPA leak detection catches any missed cleanup.

FN buildGreeting(name: String) RETURNS !String ->
    RETURN "Hello, " $+ name $+ "!";
END

FN getLength(s: String) RETURNS Int64 ->
    RETURN s.length();
END

FN main() RETURNS Void ->
    # 1. String return assigned to variable
    a = buildGreeting("Alice");
    ASSERT a == "Hello, Alice!", "string return assigned";

    # 2. String return as inline comparison
    ASSERT buildGreeting("Bob") == "Hello, Bob!", "string return inline compare";

    # 3. String return passed as function argument
    len = getLength(buildGreeting("C"));
    ASSERT len == 9_i64, "string return as arg";

    # 4. Multiple string returns in one statement
    ASSERT buildGreeting("X") == buildGreeting("X"), "two returns in one statement";

    # 5. Nested function calls
    len2 = getLength(buildGreeting("Hi"));
    ASSERT len2 == 10_i64, "nested calls";

    # 6. String return in IF condition
    IF buildGreeting("Z") == "wrong" THEN
        ASSERT FALSE, "should not match";
    ELSE_IF buildGreeting("Z") == "Hello, Z!" THEN
        ASSERT TRUE, "matched in else_if";
    ELSE
        ASSERT FALSE, "should have matched";
    END

    # 7. String return in loop (verify per-iteration cleanup)
    MUTABLE count: Int64 = 0;
    FOR i IN (1_i64 ..= 3_i64) DO
        IF buildGreeting("loop") == "Hello, loop!" THEN
            count += 1;
        END
    END
    ASSERT count == 3_i64, "cleanup in loop iterations";

    RETURN;
END
