# Test: CONCURRENT SELECT with OR_ELSE RAISE — when no errors, works as normal SELECT
FN alwaysOk(x: Float64) RETURNS !Float64 ->
    RETURN x * 2.0;
END

FN main() RETURNS Void ->
    nums: Float64[] = [1.0, 2.0, 3.0];
    results = nums |> CONCURRENT(workers: 2) SELECT alwaysOk(_) OR_ELSE RAISE;
    total = results |> SUM _;
    ASSERT total == 12.0, "OR_ELSE RAISE with no errors should work normally";
    RETURN;
END
