-- BG body COPY of a captured @list, exercising the bug 258 fix:
-- `CheatLib.dupeValue` now recognizes ArrayList and allocates a fresh
-- buffer + recursively dupes elements. Before the fix, `dupeValue`
-- fell through to `return value` for any type with a deinit method,
-- producing a shallow copy that aliased the outer list's buffer.
--
-- The FreshHeapCopy capture path (Phase 2 of sync-boundary-unification)
-- is the user-visible trigger: writing `COPY items` inside the BG body
-- classifies the capture as FreshHeapCopy, so the BG ctx field gets a
-- `try CheatLib.dupeValue(@TypeOf(items), items, alloc)` init and a
-- corresponding cleanup.
--
-- Verifies independence by mutating the outer list AFTER the BG fiber
-- has been spawned. The fiber's snapshot (computed via COPY) must show
-- the pre-mutation state; the outer list shows the post-mutation state.

FN sumAll(items: Int64[]) RETURNS Int64 ->
    MUTABLE total: Int64 = 0_i64;
    FOR x IN items DO total = total + x; END
    RETURN total;
END

FN main() RETURNS Void ->
    items: Int64[]@list = [];
    items.append(1_i64);
    items.append(2_i64);
    items.append(3_i64);

    pr: ~Int64 = BG {
        sumAll(COPY items);
    };

    items.append(100_i64);
    items.append(200_i64);

    fiber_sum = NEXT pr;
    outer_sum = sumAll(items);

    ASSERT fiber_sum == 6_i64, "fiber owns its own dupe: 1+2+3";
    ASSERT outer_sum == 306_i64, "outer mutation does not bleed into fiber: 1+2+3+100+200";
END
