-- Test: Pipeline operators on ~?T[] (open stream / BG STREAM generator).
-- Sequential ops (WHERE, SELECT, EACH, SUM, COUNT, fused chains) and
-- CONCURRENT ops (SELECT, WHERE, EACH with BoundedChannel back pressure).
-- All generators are self-closing (finite); tests use sums/counts for
-- non-deterministic concurrent results.

STRUCT Acc {
    value: Int64
}

FN main() RETURNS Void ->
    -- -------------------------------------------------------
    -- Test 1: ~?T[] | sequential WHERE
    -- -------------------------------------------------------
    gen1: ~?Int64[] = BG STREAM {
        MUTABLE i: Int64 = 1;
        WHILE i <= 8 DO
            YIELD i;
            i = i + 1;
        END
    };
    evens = gen1 s> WHERE _ MOD 2 == 0;
    ASSERT evens.length() == 4, "open stream WHERE: 4 even numbers in 1..8";
    MUTABLE sum1: Int64 = 0;
    evens s> EACH { sum1 = sum1 + _; };
    ASSERT sum1 == 20, "open stream WHERE: 2+4+6+8=20";

    -- -------------------------------------------------------
    -- Test 2: ~?T[] | sequential SELECT
    -- -------------------------------------------------------
    gen2: ~?Int64[] = BG STREAM {
        YIELD 1;
        YIELD 2;
        YIELD 3;
        YIELD 4;
        YIELD 5;
    };
    doubled = gen2 s> SELECT _ * 2;
    ASSERT doubled.length() == 5, "open stream SELECT: 5 items";
    MUTABLE sum2: Int64 = 0;
    doubled s> EACH { sum2 = sum2 + _; };
    ASSERT sum2 == 30, "open stream SELECT: 2+4+6+8+10=30";

    -- -------------------------------------------------------
    -- Test 3: ~?T[] | sequential EACH (side effects)
    -- -------------------------------------------------------
    MUTABLE sum3: Int64 = 0;
    gen3: ~?Int64[] = BG STREAM {
        YIELD 10;
        YIELD 20;
        YIELD 30;
    };
    gen3 s> EACH { sum3 = sum3 + _; };
    ASSERT sum3 == 60, "open stream EACH: 10+20+30=60";

    -- -------------------------------------------------------
    -- Test 4: ~?T[] | sequential SUM (fold)
    -- -------------------------------------------------------
    gen4: ~?Int64[] = BG STREAM {
        MUTABLE i4: Int64 = 1;
        WHILE i4 <= 5 DO
            YIELD i4;
            i4 = i4 + 1;
        END
    };
    total4 = gen4 s> SUM _;
    ASSERT total4 == 15, "open stream SUM: 1+2+3+4+5=15";

    -- -------------------------------------------------------
    -- Test 5: ~?T[] | sequential COUNT
    -- -------------------------------------------------------
    gen5: ~?Int64[] = BG STREAM {
        YIELD 100;
        YIELD 200;
        YIELD 300;
        YIELD 400;
    };
    n5 = gen5 s> COUNT _ > 150;
    ASSERT n5 == 3, "open stream COUNT: 200+300+400 > 150";

    -- -------------------------------------------------------
    -- Test 6: ~?T[] | fused WHERE + SUM
    -- -------------------------------------------------------
    gen6: ~?Int64[] = BG STREAM {
        MUTABLE i6: Int64 = 1;
        WHILE i6 <= 10 DO
            YIELD i6;
            i6 = i6 + 1;
        END
    };
    total6 = gen6 s> WHERE _ MOD 2 == 0 s> SUM _;
    ASSERT total6 == 30, "open stream WHERE+SUM: 2+4+6+8+10=30";

    -- -------------------------------------------------------
    -- Test 7: ~?T[] | CONCURRENT SELECT
    -- -------------------------------------------------------
    gen7: ~?Int64[] = BG STREAM {
        YIELD 1;
        YIELD 2;
        YIELD 3;
        YIELD 4;
        YIELD 5;
    };
    results7 = gen7 s> CONCURRENT(workers: 2) SELECT _ * 2;
    ASSERT results7.length() == 5, "concurrent open stream SELECT: 5 items";
    MUTABLE sum7: Int64 = 0;
    results7 s> EACH { sum7 = sum7 + _; };
    ASSERT sum7 == 30, "concurrent open stream SELECT: 2+4+6+8+10=30";

    -- -------------------------------------------------------
    -- Test 8: ~?T[] | CONCURRENT WHERE
    -- -------------------------------------------------------
    gen8: ~?Int64[] = BG STREAM {
        MUTABLE i8: Int64 = 1;
        WHILE i8 <= 9 DO
            YIELD i8;
            i8 = i8 + 1;
        END
    };
    evens8 = gen8 s> CONCURRENT(workers: 3) WHERE _ MOD 2 == 0;
    ASSERT evens8.length() == 4, "concurrent open stream WHERE: 4 even numbers";
    MUTABLE sum8: Int64 = 0;
    evens8 s> EACH { sum8 = sum8 + _; };
    ASSERT sum8 == 20, "concurrent open stream WHERE: 2+4+6+8=20";

    -- -------------------------------------------------------
    -- Test 9: ~?T[] | CONCURRENT EACH (shared locked accumulator)
    -- -------------------------------------------------------
    acc9 = Acc{ value: 0 } @shared:locked;
    gen9: ~?Int64[] = BG STREAM {
        YIELD 100;
        YIELD 200;
        YIELD 300;
    };
    gen9 s> CONCURRENT(workers: 2) EACH {
        WITH EXCLUSIVE acc9 AS a {
            a.value = a.value + _;
        }
    };
    WITH acc9 AS a {
        ASSERT a.value == 600, "concurrent open stream EACH: 100+200+300=600";
    }

    RETURN;
END
