# Known-failing reproducer for docs/agents/vm-bugs.md
# "REENTRANT:THUNK / :TAIL_CALL blocked in TIGHT loops" (filed c6ae7c47).
#
# A `:TAIL_CALL` reentrant fn has CONSTANT native stack (verified
# self-loop) -- strictly more TIGHT-safe than `:MAX_DEPTH(N)` (which
# is permitted yet burns N real frames). But effects.rb's TIGHT gate
# keys on the coarse `fn.reentrant == :reentrant` proxy, and
# reentrance.rb maps both :reentrant_thunk and :reentrant_tail_call
# to `fn.reentrant ||= :reentrant`, so this is rejected with
# "TIGHT loop cannot call @reentrant function 'sumTo'".
#
# This program is CORRECT CLEAR (sums 1..5 three times = 45); the
# only reason it fails is the over-conservative gate. When the gate
# is re-keyed onto reentrance_kind / tight_reentrance ("unbounded
# native stack" -- plain :reentrant only), this compiles and the
# ASSERT holds; move it up to
# transpile-tests/<NNN>_tailcall_reentrant_in_tight_loop.cht.
FN sumTo(n: Int64, acc: Int64) RETURNS Int64 EFFECTS REENTRANT:TAIL_CALL ->
    IF n <= 0_i64 THEN RETURN acc; END
    RETURN sumTo(n - 1_i64, acc + n);
END

FN main() RETURNS Void ->
    MUTABLE total: Int64 = 0_i64;
    MUTABLE i: Int64 = 0_i64;
    TIGHT WHILE i < 3_i64 DO
        total = total + sumTo(5_i64, 0_i64);
        i = i + 1_i64;
    END
    ASSERT total == 45_i64, "TAIL_CALL reentrant (constant native stack) in TIGHT loop";
    RETURN;
END
