# Known-failing reproducer for docs/agents/vm-bugs.md "Bug #8"
# (bare String[]@list COPY'd into a BG fiber double-frees its
# element strings). OPEN; deferred (separate standalone fix).
#
# IMPORTANT: this one BUILDS and RUNS clean under `./clear build`
# /`./clear run` (C allocator -- no double-free detection). It only
# reproduces under LEAK DETECTION:
#
#     ./clear test transpile-tests/known-failing/bug8_bare_string_list_copy_into_bg.cht
#
# -> std.testing.allocator reports `Second free:` and the test
# command exits 1, even though "All 1 tests passed" (the program
# logic is correct; the duped list's owned []const u8 payloads are
# freed by BOTH the in-fiber `defer cleanup` and the pre-spawn
# errdefer/outer recipe).
#
# Distinct from Bug #7 (ctx-field typing) -- this is cleanup
# OWNERSHIP. Only :int / struct-wrapped shapes are clean, which is
# why tools/fuzz/templates/bg_capture_typing.rb is scoped to
# elem=:int. When fixed: re-enable that template's :string cells AND
# move this up to transpile-tests/<NNN>_*.cht.
FN consume(xs: String[]@list) RETURNS Int64 -> RETURN xs.length(); END

FN runit() RETURNS !Int64 ->
    MUTABLE c0: String[]@list = List[];
    c0.append("a");
    f: ~Int64 = BG { consume(COPY c0); };
    RETURN NEXT f;
END

FN main() RETURNS !Void ->
    n: Int64 = runit() OR RAISE;
    ASSERT n == 1_i64, "bare String[]@list COPY into BG";
    RETURN;
END
