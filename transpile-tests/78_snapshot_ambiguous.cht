-- Ambiguous snapshot: two pipeline steps with different input types
-- feeding the same CATCH clause. Accessing snapshot should error.
-- (This test verifies the program compiles when snapshot is NOT accessed)

STRUCT User { name: String }
STRUCT Order { amount: Float64 }

FN checkUser(u: User) RETURNS !User ->
    IF u.name == "" THEN RAISE Input; END
    RETURN u;
END

FN checkOrder(o: Order) RETURNS !Order ->
    IF o.amount < 0.0 THEN RAISE Input; END
    RETURN o;
END

-- Two pipelines with different types: snapshot type is ambiguous
FN processBoth(u: User, o: Order) RETURNS !String ->
    validUser = u |> checkUser;
    validOrder = o |> checkOrder;
    RETURN validUser.name;

CATCH Input
    -- NOT accessing snapshot here (would be ambiguous: User or Order?)
    RETURN "error";
END

FN main() RETURNS Void ->
    r1 = processBoth(User{ name: "Alice" }, Order{ amount: 10.0 });
    ASSERT r1 == "Alice", "both valid";

    r2 = processBoth(User{ name: "" }, Order{ amount: 10.0 });
    ASSERT r2 == "error", "user invalid";

    r3 = processBoth(User{ name: "Alice" }, Order{ amount: -1.0 });
    ASSERT r3 == "error", "order invalid";

    RETURN;
END
