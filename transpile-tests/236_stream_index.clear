# Test: INDEX on finite stream sources (~T[N]).
# INDEX groups stream elements into a HashMap by key.

STRUCT Item { category: String, score: Int64 }

FN makeItem(cat: String, s: Int64) RETURNS Item ->
    RETURN Item{ category: COPY cat, score: s };
END

FN main() RETURNS Void ->
    # INDEX on bounded stream (~T[N])
    s1: ~Item[3] = [
        BG { makeItem("a", 10); },
        BG { makeItem("b", 20); },
        BG { makeItem("a", 30); },
    ];
    grouped = s1 |> INDEX _.category;
    ASSERT grouped["a"]?.length() == 2, "two 'a' items";
    ASSERT grouped["b"]?.length() == 1, "one 'b' item";

    # INDEX on bounded stream with WHERE pre-filter
    s2: ~Item[4] = [
        BG { makeItem("x", 1); },
        BG { makeItem("y", 2); },
        BG { makeItem("x", 3); },
        BG { makeItem("z", 4); },
    ];
    grouped2 = s2 |> WHERE _.score > 1 |> INDEX _.category;
    ASSERT grouped2["x"]?.length() == 1, "one 'x' with score > 1";
    ASSERT grouped2["y"]?.length() == 1, "one 'y'";
    ASSERT grouped2["z"]?.length() == 1, "one 'z'";

    print("OK");
    RETURN;
END
