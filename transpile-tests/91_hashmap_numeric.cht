-- 91_hashmap_numeric.cht — Numeric-key HashMap (HashMap<Int64, Number>)
--
-- Exercises the [] operator for both read and write on a numeric map.
-- The transpiler must emit numericMapPut/numericMapGet (not string variants).

FN cheatMain() RETURNS Void ->
    -- HashMap<Int64, Number> uses AutoHashMapUnmanaged (no key copies)
    MUTABLE scores: HashMap<Int64, Number> = {};

    -- write via [] operator → numericMapPut
    scores[1_i64] = 10.0;
    scores[2_i64] = 20.0;
    scores[3_i64] = 30.0;

    -- read via [] operator → numericMapGet
    ASSERT scores[1_i64] == 10.0, "key 1 should be 10";
    ASSERT scores[2_i64] == 20.0, "key 2 should be 20";
    ASSERT scores[3_i64] == 30.0, "key 3 should be 30";

    -- missing key returns 0 (default)
    ASSERT scores[99_i64] == 0.0, "missing key should return 0";

    -- update existing key
    scores[2_i64] = 99.0;
    ASSERT scores[2_i64] == 99.0, "updated key 2 should be 99";

    -- count / contains / delete via method API
    ASSERT scores.count() == 3, "should have 3 entries";
    ASSERT scores.contains(1_i64), "should contain key 1";
    ASSERT scores.contains(99_i64) == FALSE, "should not contain key 99";

    scores.delete(3_i64);
    ASSERT scores.count() == 2, "count should be 2 after delete";
    ASSERT scores.contains(3_i64) == FALSE, "key 3 should be gone";
END
