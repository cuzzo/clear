-- Test: function call results used in string concat must be safe to cleanup.
-- Bug: transpiler hoists function call results as __hpt_N temporaries
-- with heapAlloc().free() cleanup, but the function may return
-- frame-allocated strings.

UNION Val {
    Nil,
    Str: String,
    Num: Float64
}

FN prVal(v: Val) RETURNS String @reentrant ->
    MATCH v START
        Val.Num AS n -> RETURN toInt(n).toString();,
        Val.Str AS s -> RETURN s;,
        DEFAULT -> RETURN "nil";
    END
    RETURN "nil";
END

FN buildDesc!(items: Val[]) RETURNS String ->
    MUTABLE desc = "(";
    FOR i IN (0_i64 ..< items.length()) DO
        IF i > 0 THEN desc = desc + " "; END
        desc = desc + prVal(items[i]);
    END
    RETURN desc + ")";
END

FN main() RETURNS Void ->
    MUTABLE items: Val[]@list = List[];
    items.append(Val{ Num: 1.0 });
    items.append(Val{ Num: 2.0 });
    items.append(Val{ Num: 3.0 });
    result = buildDesc!(items);
    ASSERT result == "(1 2 3)", "string from func calls";
    print("PASS");
END
