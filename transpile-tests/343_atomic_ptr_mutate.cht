-- AtomicPtr M3.6: WITH SNAPSHOT MUTABLE for @indirect:atomic.
-- Verifies the compiler lowers `WITH SNAPSHOT cell AS MUTABLE x
-- { ... }` on @indirect:atomic to AtomicPtr.update(rt, alloc, ...)
-- with NO conflict handler today (Rust rcu retries until success;
-- AtomicConflict will land once #330 bounds the loop at 256).

STRUCT Counter {
    value: Int64,
}

FN main() RETURNS Void ->
    cfg = Counter{ value: 0 } @indirect:atomic;

    -- Read: confirm initial value.
    WITH SNAPSHOT cfg AS c {
        ASSERT c.value == 0, "initial: expected 0";
    }

    -- Mutate via WITH SNAPSHOT MUTABLE — no conflict handler (rcu).
    -- The body runs on a fresh clone; AtomicPtr.update CAS-publishes
    -- and retries until success.
    WITH SNAPSHOT cfg AS MUTABLE x {
        x.value = x.value + 1;
    }

    -- Read: confirm increment landed.
    WITH SNAPSHOT cfg AS c {
        ASSERT c.value == 1, "after first inc: expected 1";
    }

    -- Multiple sequential mutations.
    WITH SNAPSHOT cfg AS MUTABLE x { x.value = x.value + 10; }
    WITH SNAPSHOT cfg AS MUTABLE x { x.value = x.value * 2; }

    WITH SNAPSHOT cfg AS c {
        ASSERT c.value == 22, "after +10 then *2: expected 22";
    }

    RETURN;
END
