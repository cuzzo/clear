-- Test: EXTERN FFI to Zig standard library (no native shims).
-- Exercises: comptime type args, EFFECTS :alloc:heap, OR RAISE, CLOSE cleanup,
-- C-string params (String -> [*:0]const u8), UInt32 suffix.

EXTERN STRUCT ParseOptions {} FROM "std.json";
EXTERN STRUCT Value {} FROM "std.json";
EXTERN STRUCT Parsed { value: Value } CLOSE "deinit" AS "Parsed(Value)" FROM "std.json";
EXTERN FN parseFromSlice<T>(comptime: T, content: String, options: ParseOptions) RETURNS !Parsed EFFECTS :alloc:heap FROM "std.json";
EXTERN FN mkdir(path: String, mode: UInt32) RETURNS Int64 FROM "std.c";

FN main() RETURNS Void ->
    -- std.c.mkdir: no native shim, String coerces to [*:0]const u8 automatically
    mkdir("/tmp/clear_std_ffi_test", 0o755_u32);

    -- std.json.parseFromSlice: comptime type arg baked into call, not a struct field
    opts: ParseOptions = ParseOptions{};
    parsed = parseFromSlice(Value, "{\"x\":3,\"y\":4}", opts) OR RAISE;
    print("stdlib FFI ok");
    RETURN;
END
