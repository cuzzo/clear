# Test: reproduce bench 25 line parsing pattern exactly.
# Simulates tcpRead raw data, line splitting, startsWith? dispatch,
# and the WORK:ID:N colon-delimited parsing.

FN heavyCompute(seed: Int64, n: Int64) RETURNS Int64 ->
    MUTABLE x: Int64 = seed;
    FOR i IN (0_i64 ..< n) DO
        x = x %* 6364136223846793005_i64 %+ 1442695040888963407_i64;
        x = x %* x %+ 1_i64;
    END
    IF x < 0 -> x = 0 - x;
    RETURN x MOD 1000000000;
END

FN handleData(data: String) RETURNS !String ->
    MUTABLE resp = "";
    MUTABLE pos: Int64 = 0;
    WHILE pos < data.length() DO
        MUTABLE eol = pos;
        WHILE eol < data.length() AND charAt(data, eol) != "\r" AND charAt(data, eol) != "\n" DO
            eol += 1;
        END
        line = substr(data, pos, eol - pos);
        pos = eol;
        WHILE pos < data.length() AND (charAt(data, pos) == "\r" OR charAt(data, pos) == "\n") DO
            pos += 1;
        END

        IF line.length() == 0 THEN
            # skip
        ELSE_IF startsWith?(line, "WORK:") THEN
            rest: String@raw = substr(line, 5_i64, line.length() - 5);
            MUTABLE colonPos: Int64 = 0;
            WHILE colonPos < rest.length() AND charAt(rest, colonPos) != ":" DO
                colonPos += 1;
            END
            idStr = substr(rest, 0_i64, colonPos);
            nStr = substr(rest, colonPos + 1, rest.length() - colonPos - 1);
            MUTABLE id = toInt(toNumber(idStr) OR_ELSE 0.0);
            MUTABLE n = toInt(toNumber(nStr) OR_ELSE 0.0);
            IF n < 1 THEN n = 1; END
            result = heavyCompute(id, n);
            resp = resp + ":${result.toString()}\r\n";
        ELSE_IF line == "QUIT" THEN
            resp = resp + "+OK\r\n";
        ELSE
            resp = resp + "-ERR unknown\r\n";
        END
    END
    RETURN resp;
END

FN main() RETURNS Void ->
    # Test 1: single WORK command
    r1 = handleData("WORK:42:100\r\n");
    ASSERT startsWith?(r1, ":"), "WORK result starts with colon";

    # Test 2: multiple pipelined commands
    r2 = handleData("WORK:1:5\r\nWORK:2:10\r\nQUIT\r\n");
    # Should have 3 response lines: two :results and one +OK
    ASSERT r2.length() > 10, "multi-command response has content";

    # Test 3: READY? and QUIT
    r3 = handleData("QUIT\r\n");
    ASSERT r3 == "+OK\r\n", "QUIT returns +OK";

    # Test 4: unknown command
    r4 = handleData("BOGUS\r\n");
    ASSERT startsWith?(r4, "-ERR"), "unknown returns -ERR";

    print("PASS: line parse startsWith with WORK parsing");
    RETURN;
END
