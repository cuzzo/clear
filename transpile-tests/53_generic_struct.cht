-- Phases 1 & 2: Generic Struct Definitions + Type Annotations
-- Phase 3 (struct literal instantiation: Pair<Number>{ first: 1.0 }) is next.

STRUCT Pair<T> { first: T, second: T }
STRUCT Triple<A, B, C> { a: A, b: B, c: C }
STRUCT Wrapper<T> { value: T }
STRUCT KeyValue<K, V> { key: K, value: V }

-- Phase 2: generic types in function signatures compile to correct Zig.
-- Pair<Number> → Pair(f64) in params and return types.
FN identity(p: Pair<Number>) RETURNS Pair<Number> ->
  RETURN p;
END

FN cheatMain() RETURNS Void ->
  -- Instantiation tested in Phase 3. Phase 2 verifies function signatures compile.
  PASS
END
