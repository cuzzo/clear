-- Phases 1, 2 & 3: Generic Struct Definitions + Type Annotations + Struct Literals

STRUCT Pair<T> { first: T, second: T }
STRUCT Triple<A, B, C> { a: A, b: B, c: C }
STRUCT Wrapper<T> { value: T }
STRUCT KeyValue<K, V> { key: K, value: V }

-- Phase 2: generic types in function signatures compile to correct Zig.
FN identity(p: Pair<Number>) RETURNS Pair<Number> ->
  RETURN p;
END

FN wrapNumber(n: Number) RETURNS Wrapper<Number> ->
  RETURN Wrapper<Number>{ value: n };
END

FN cheatMain() RETURNS Void ->
  -- Phase 3: generic struct literals with type args.
  p = Pair<Number>{ first: 1.0, second: 2.0 };
  ASSERT p.first == 1.0;
  ASSERT p.second == 2.0;

  w = Wrapper<Number>{ value: 42.0 };
  ASSERT w.value == 42.0;

  -- Round-trip through a function
  w2 = wrapNumber(99.0);
  ASSERT w2.value == 99.0;

  -- Multi-param generic
  kv = KeyValue<Number, Bool>{ key: 7.0, value: TRUE };
  ASSERT kv.key == 7.0;
  ASSERT kv.value == TRUE;

  -- identity round-trip
  orig = Pair<Number>{ first: 3.0, second: 4.0 };
  copy = identity(orig);
  ASSERT copy.first == 3.0;
  ASSERT copy.second == 4.0;
END
