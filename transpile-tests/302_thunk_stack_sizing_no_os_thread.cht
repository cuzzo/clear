# Thunk Phase 4g -- bounded reentrance variants do NOT force the
# spawn site onto an OS thread. The fiber stack stays small.
#
# :THUNK     -> heap CPS keeps depth = 1 on the fiber stack
# :TAIL_CALL -> TCO turns recursion into a self-`jmp` loop; depth = 1
# :MAX_DEPTH -> bounded by N; runtime counter raises if exceeded
#
# All three are spawnable from a default-tier BG with NO @service.
# The compiler MUST NOT mark these as :unbounded.

FN factorial(n: Int64) RETURNS Int64
  EFFECTS REENTRANT:THUNK ->
  IF n <= 1 -> RETURN 1;
  RETURN n * factorial(n - 1);
END

FN sum_tc(n: Int64, acc: Int64) RETURNS Int64
  EFFECTS REENTRANT:TAIL_CALL ->
  IF n <= 0 -> RETURN acc;
  RETURN sum_tc(n - 1, acc + n);
END

FN bounded(n: Int64) RETURNS !Int64
  EFFECTS REENTRANT:MAX_DEPTH(8) ->
  RETURN n + 1;
END

FN main() RETURNS Void ->
  # Each BG runs on a default fiber tier (no @service required).
  p1: ~Int64 = BG { factorial(8_i64); };
  p2: ~Int64 = BG { sum_tc(50_i64, 0_i64); };
  p3: ~Int64 = BG { bounded(0_i64) OR EXIT System, "x"; };

  r1 = NEXT p1;
  r2 = NEXT p2;
  r3 = NEXT p3;

  ASSERT r1 == 40320_i64,        "factorial(8)";
  ASSERT r2 == 1275_i64,         "sum_tc(50, 0)";
  ASSERT r3 == 1_i64,            "bounded(0) + 1";
  RETURN;
END
