# Test: outer string variable reassigned inside loop from a user function result.
# The outer var must survive the loop mark rewind each iteration.
# We verify by reading the value after post-loop frame allocations overwrite
# the arena region where the dangling pointer would have pointed.

FN makePrefix(i: Int64) RETURNS !String ->
    RETURN "entry-" $+ i.toString();
END

FN main() RETURNS Void ->
    MUTABLE last: String = "";
    FOR i IN (1_i64 ..= 50) DO
        tmp = i.toString();         # frame local, forces mark_per_iter
        last = makePrefix(i);       # outer string reassigned from fn call
    END
    # Force arena allocations to overwrite the freed region (use-after-free probe)
    n1 = 1_i64.toString();
    n2 = 2_i64.toString();
    n3 = 3_i64.toString();
    n4 = 4_i64.toString();
    n5 = 5_i64.toString();
    ASSERT n1 == "1";
    ASSERT last == "entry-50", "outer string must survive loop frame rewind";

    print("PASS");
    RETURN;
END
