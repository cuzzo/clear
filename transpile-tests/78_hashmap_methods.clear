FN main() RETURNS Void ->
  # Setup: build a small map
  MUTABLE scores: {String}Int64 = {"alice": 10_i64, "bob": 20_i64, "carol": 30_i64};

  # count(): number of entries
  ASSERT scores.count() == 3, "count should be 3 after init";

  # contains(): key existence checks
  ASSERT scores.contains?("alice") == TRUE,  "alice should be present";
  ASSERT scores.contains?("bob")   == TRUE,  "bob should be present";
  ASSERT scores.contains?("dave")  == FALSE, "dave should not be present";

  # get: map[key] returns ?V — use OR_ELSE to provide a fallback
  ASSERT scores["alice"] OR_ELSE 0 == 10, "alice score should be 10";
  ASSERT scores["bob"] OR_ELSE 0 == 20, "bob score should be 20";

  # put (existing behaviour): update + insert
  scores["alice"] = 99_i64;
  ASSERT scores["alice"] OR_ELSE 0 == 99, "alice score should be updated to 99";
  scores["dave"] = 40_i64;
  ASSERT scores.count() == 4, "count should be 4 after inserting dave";
  ASSERT scores.contains?("dave") == TRUE, "dave should now be present";

  # delete(): remove a key
  &scores.delete("bob");
  ASSERT scores.count() == 3, "count should be 3 after deleting bob";
  ASSERT scores.contains?("bob") == FALSE, "bob should no longer be present";

  # missing key returns nil — OR_ELSE provides default
  ASSERT scores["bob"] OR_ELSE 0 == 0, "missing key should return default 0 via OR_ELSE";

  # delete() on non-existent key is a no-op
  &scores.delete("nobody");
  ASSERT scores.count() == 3, "count should still be 3 after no-op delete";

  # keys(): returns String[] of all current keys
  all_keys = scores.keys();
  ASSERT all_keys.length() == 3, "keys() should return 3 keys";

  # values(): returns Int64[] of all current values
  all_vals = scores.values();
  ASSERT all_vals.length() == 3, "values() should return 3 values";
END
