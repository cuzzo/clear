# Test: the unified CATCH grammar compiles + runs end-to-end.
# Exercises every form against actual raised errors and verifies
# which clause handles each case.
#   1. CATCH Kind                              -- plain kind match
#   2. CATCH Kind WITH(T)                      -- kind + single type
#   3. CATCH Kind WITH(T1, T2)                 -- kind + multi-type filter
#   4. CATCH Type                              -- direct type match
#   5. CATCH Kind1, Kind2                      -- multi-kind OR_ELSE
#   6. CATCH Type1, Type2                      -- multi-type OR_ELSE
#   7. CATCH Kind1, Type2                      -- mixed item list OR_ELSE
#   8. CATCH Kind WITH("message")              -- message filter
#   9. CATCH Kind WITH(Type, "message")        -- mixed filter

FN raiseParseErr() RETURNS !Int64 -> RAISE Input, ParseErr,   "bad p"; RETURN 0; END
FN raiseOtherInput() RETURNS !Int64 -> RAISE Input, OtherIn,  "bad o"; RETURN 0; END
FN raiseExtraIn() RETURNS !Int64 -> RAISE Input, ExtraIn,     "bad x"; RETURN 0; END
FN raisePlainInput() RETURNS !Int64 -> RAISE Input, "plain";            RETURN 0; END
FN raiseTransient() RETURNS !Int64 -> RAISE Transient, "flaky";        RETURN 0; END

# CATCH Type directly matches the registered-kind type.
FN directType(mode: Int64) RETURNS !Int64 ->
    IF mode == 1 THEN v = raiseParseErr() OR_ELSE RAISE; RETURN v; END
    RETURN 0;
CATCH ParseErr
    RETURN -1;
END

# CATCH Kind WITH(Type) narrows to a specific type.
FN withSingle(mode: Int64) RETURNS !Int64 ->
    IF mode == 1 THEN v = raiseParseErr()    OR_ELSE RAISE; RETURN v; END
    IF mode == 2 THEN v = raisePlainInput()  OR_ELSE RAISE; RETURN v; END
    RETURN 0;
CATCH Input WITH(ParseErr)
    RETURN -1;
CATCH Input
    RETURN -2;
END

# CATCH Kind WITH(T1, T2) filters on multiple types.
FN withMulti(mode: Int64) RETURNS !Int64 ->
    IF mode == 1 THEN v = raiseOtherInput() OR_ELSE RAISE; RETURN v; END
    IF mode == 2 THEN v = raiseExtraIn()    OR_ELSE RAISE; RETURN v; END
    IF mode == 3 THEN v = raisePlainInput() OR_ELSE RAISE; RETURN v; END
    RETURN 0;
CATCH Input WITH(OtherIn, ExtraIn)
    RETURN -1;
CATCH Input
    RETURN -2;
END

# CATCH Kind matches any error of that kind.
FN kindOnly(mode: Int64) RETURNS !Int64 ->
    IF mode == 1 THEN v = raiseTransient() OR_ELSE RAISE; RETURN v; END
    RETURN 0;
CATCH Transient
    RETURN -1;
END

FN raiseNotFound() RETURNS !Int64 -> RAISE NotFound, MissingItem, "m"; RETURN 0; END
FN raiseMsgBad() RETURNS !Int64   -> RAISE Input, ParseErr, "bad header"; RETURN 0; END
FN raiseMsgGood() RETURNS !Int64  -> RAISE Input, ParseErr, "other";      RETURN 0; END

# Multi-kind CATCH Kind1, Kind2
FN multiKind(mode: Int64) RETURNS !Int64 ->
    IF mode == 1 THEN v = raisePlainInput() OR_ELSE RAISE; RETURN v; END
    IF mode == 2 THEN v = raiseNotFound()   OR_ELSE RAISE; RETURN v; END
    RETURN 0;
CATCH Input, NotFound
    RETURN -1;
END

# Multi-type CATCH Type1, Type2
FN multiType(mode: Int64) RETURNS !Int64 ->
    IF mode == 1 THEN v = raiseParseErr()  OR_ELSE RAISE; RETURN v; END
    IF mode == 2 THEN v = raiseOtherInput() OR_ELSE RAISE; RETURN v; END
    RETURN 0;
CATCH ParseErr, OtherIn
    RETURN -1;
CATCH Input
    RETURN -2;
END

# Mixed item list CATCH Kind1, Type2 (OR_ELSE semantics)
FN mixedItems(mode: Int64) RETURNS !Int64 ->
    IF mode == 1 THEN v = raiseNotFound() OR_ELSE RAISE; RETURN v; END
    IF mode == 2 THEN v = raiseParseErr() OR_ELSE RAISE; RETURN v; END
    RETURN 0;
CATCH NotFound, ParseErr
    RETURN -1;
END

# CATCH Kind WITH("message") — pure message filter
FN withMessage(mode: Int64) RETURNS !Int64 ->
    IF mode == 1 THEN v = raiseMsgBad()  OR_ELSE RAISE; RETURN v; END
    IF mode == 2 THEN v = raiseMsgGood() OR_ELSE RAISE; RETURN v; END
    RETURN 0;
CATCH Input WITH("bad header")
    RETURN -1;
CATCH Input
    RETURN -2;
END

# CATCH Kind WITH(Type, "message") — mixed filter
FN withMixed(mode: Int64) RETURNS !Int64 ->
    IF mode == 1 THEN v = raiseOtherInput() OR_ELSE RAISE; RETURN v; END  # matches type OtherIn
    IF mode == 2 THEN v = raiseMsgBad()     OR_ELSE RAISE; RETURN v; END  # matches message
    IF mode == 3 THEN v = raisePlainInput() OR_ELSE RAISE; RETURN v; END  # matches nothing -> DEFAULT
    RETURN 0;
CATCH Input WITH(OtherIn, "bad header")
    RETURN -1;
DEFAULT
    RETURN -99;
END

FN main() RETURNS Void ->
    # Direct type form
    ASSERT directType(1) == -1, "CATCH ParseErr matches ParseErr";
    ASSERT directType(0) ==  0, "no raise -> no catch";

    # Kind + single type
    ASSERT withSingle(1) == -1, "CATCH Input WITH(ParseErr) matches ParseErr";
    ASSERT withSingle(2) == -2, "CATCH Input (fallback) matches plain Input";

    # Kind + multi type
    ASSERT withMulti(1) == -1, "CATCH Input WITH(OtherIn, ExtraIn) matches OtherIn";
    ASSERT withMulti(2) == -1, "same clause also matches ExtraIn";
    ASSERT withMulti(3) == -2, "CATCH Input (fallback) matches plain Input";

    # Kind-only
    ASSERT kindOnly(1) == -1, "CATCH Transient matches";

    # Multi-kind
    ASSERT multiKind(1) == -1, "CATCH Input, NotFound matches Input";
    ASSERT multiKind(2) == -1, "CATCH Input, NotFound matches NotFound";

    # Multi-type
    ASSERT multiType(1) == -1, "CATCH ParseErr, OtherIn matches ParseErr";
    ASSERT multiType(2) == -1, "CATCH ParseErr, OtherIn matches OtherIn";

    # Mixed items
    ASSERT mixedItems(1) == -1, "CATCH NotFound, ParseErr matches NotFound by kind";
    ASSERT mixedItems(2) == -1, "CATCH NotFound, ParseErr matches ParseErr by type";

    # Message filter
    ASSERT withMessage(1) == -1, "CATCH Input WITH(\"bad header\") matches message";
    ASSERT withMessage(2) == -2, "different message falls through to kind CATCH";

    # Mixed filter (type OR_ELSE message)
    ASSERT withMixed(1) == -1, "mixed filter matches by type OtherIn";
    ASSERT withMixed(2) == -1, "mixed filter matches by message";
    ASSERT withMixed(3) == -99, "no match -> DEFAULT";

    RETURN;
END
