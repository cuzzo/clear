-- Pipeline-terminal observable MIN. Mirror of 308_observable_pipe_max.

FN main() RETURNS Void ->
    gen: ~?Int64[] = BG STREAM {
        MUTABLE i: Int64 = 100_i64;
        WHILE i > 0_i64 DO
            YIELD i;
            i = i - 1_i64;
        END
    };

    running: ~Int64@observable = gen s> MIN _;
    final = NEXT running;

    ASSERT final == 1_i64, "running min mismatch";
    print("ok");
    RETURN;
END
