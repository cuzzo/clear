-- 90_list_return.cht — list escape safety: returning @list from frame-using functions
--
-- PROBLEM:
--   A function with uses_frame=true wraps its body in saveFrameMark/restoreFrameMark.
--   When it returns, the frame mark rewinds the arena, freeing the @list's backing buffer.
--   The caller would hold a dangling pointer.
--
-- FIX:
--   The compiler detects this pattern (list_return=true on ReturnNode) and emits:
--     try CheatLib.promoteList(T, rt, &vals);
--   before the return.  promoteList copies the backing buffer from the frame arena to
--   the GPA heap.  The caller's deinit uses heapAlloc() (annotator sets heap_list=true).
--
-- SETUP:
--   BigS has 130 slots (>128 threshold) → allocated in frame arena → uses_frame=true.
--   buildList creates a local BigS (triggering uses_frame=true) and also builds a list.
--   cheatMain calls buildList() and verifies the returned list contains correct values.

STRUCT Chunk5 { a: Float64, b: Float64, c: Float64, d: Float64, e: Float64 }
STRUCT BigS {
  c1:  Chunk5, c2:  Chunk5, c3:  Chunk5, c4:  Chunk5, c5:  Chunk5,
  c6:  Chunk5, c7:  Chunk5, c8:  Chunk5, c9:  Chunk5, c10: Chunk5,
  c11: Chunk5, c12: Chunk5, c13: Chunk5, c14: Chunk5, c15: Chunk5,
  c16: Chunk5, c17: Chunk5, c18: Chunk5, c19: Chunk5, c20: Chunk5,
  c21: Chunk5, c22: Chunk5, c23: Chunk5, c24: Chunk5, c25: Chunk5,
  c26: Chunk5
}

-- buildList creates a large local struct (→ frame arena, uses_frame=true)
-- and returns a @list built from it.  The compiler must emit promoteList
-- to copy the list's arena buffer to heap before the frame mark rewinds.
FN buildList() RETURNS Float64[]@list ->
  zero:  Chunk5 = Chunk5{ a: 0.0, b: 0.0, c: 0.0, d: 0.0, e: 0.0 };
  first: Chunk5 = Chunk5{ a: 1.0, b: 2.0, c: 3.0, d: 4.0, e: 5.0 };
  big: BigS = BigS{
    c1:  first, c2:  zero, c3:  zero, c4:  zero, c5:  zero,
    c6:  zero,  c7:  zero, c8:  zero, c9:  zero, c10: zero,
    c11: zero,  c12: zero, c13: zero, c14: zero, c15: zero,
    c16: zero,  c17: zero, c18: zero, c19: zero, c20: zero,
    c21: zero,  c22: zero, c23: zero, c24: zero, c25: zero,
    c26: zero
  };
  MUTABLE vals: Float64[]@list = [];
  append(vals, big.c1.a);
  append(vals, big.c1.b);
  append(vals, big.c1.c);
  RETURN vals;
END

FN cheatMain() RETURNS Void ->
  -- Caller receives a heap-promoted list; deinit uses heapAlloc (no leak).
  result = buildList();
  ASSERT length(result) == 3_i64, "returned list has 3 elements";
  ASSERT result[0] == 1.0, "element 0 is correct";
  ASSERT result[1] == 2.0, "element 1 is correct";
  ASSERT result[2] == 3.0, "element 2 is correct";
  RETURN;
END
