# Test: replace, downcase, upcase string functions.

FN main() RETURNS Void ->
    # replace: all occurrences
    ASSERT replace("hello world", "world", "CLEAR") == "hello CLEAR";
    ASSERT replace("aaa", "a", "bb") == "bbbbbb";
    ASSERT replace("no match", "xyz", "abc") == "no match";
    ASSERT replace("", "a", "b") == "";

    # downcase
    ASSERT "Hello World".downcase() == "hello world";
    ASSERT "ALLCAPS".downcase() == "allcaps";
    ASSERT "already".downcase() == "already";
    ASSERT "MiXeD123".downcase() == "mixed123";

    # upcase
    ASSERT "Hello World".upcase() == "HELLO WORLD";
    ASSERT "alllower".upcase() == "ALLLOWER";
    ASSERT "ALREADY".upcase() == "ALREADY";
    ASSERT "MiXeD123".upcase() == "MIXED123";

    # chained
    result = replace("Hello WORLD".downcase(), "hello", "hi");
    ASSERT result == "hi world";

    print("PASS");
    RETURN;
END
