STRUCT User { id: Int64 }

FN main() RETURNS Void ->
    a: User @boxed = User{ id: 1 };
    # 'a' should be marked moved here.
    # 'b' is now the owner.
    b = a;

    # If 'a' tries to free at end of scope -> Double Free Crash
    # If 'b' fails to free -> Leak
    ASSERT b.id == 1;
    RETURN;
END

