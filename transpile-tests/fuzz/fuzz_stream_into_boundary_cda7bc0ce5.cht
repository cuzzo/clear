# AUTOGENERATED by tools/fuzz — template=stream_into_boundary expected=pass params={:consumer=>:bg, :ownership=>:shared, :sync=>:atomic, :move=>:copy, :value=>:int}
FN main() RETURNS Void ->
    src: ~Int64[INF] = BG STREAM {
        MUTABLE i: Int64 = 1_i64;
        WHILE TRUE DO
            YIELD i;
            i = i + 1_i64;
        END
    };
    raw: Int64 = NEXT src;
    MUTABLE val: Int64 = raw @shared:atomic;
    result: ~Int64 = BG { c = COPY val; c; };
    answer: Int64 = NEXT result;
    ASSERT answer >= 0_i64, "bg consumer produced a value";
    RETURN;
END
