# AUTOGENERATED by tools/fuzz — template=escape_via_return expected=pass params={:elem=>:union_with_heap, :body=>:loop, :size=>3}
UNION Wrap { Empty, Has: Int64[]@list }

FN make() RETURNS !Wrap ->
    MUTABLE lst: Int64[]@list = [];
    lst.append(1_i64);
    lst.append(2_i64);
    lst.append(3_i64);
    RETURN Wrap{ Has: lst };
END

FN main() RETURNS Void ->
    result = make();
    PARTIAL MATCH result START
  Wrap.Has AS xs -> ASSERT xs.length() == 3_i64, "returned union variant length";,
  DEFAULT -> ASSERT 1_i64 == 0_i64, "expected Has variant";
END
    
    RETURN;
END
