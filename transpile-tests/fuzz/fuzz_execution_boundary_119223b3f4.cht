# AUTOGENERATED by tools/fuzz — template=execution_boundary expected=compile_error params={:boundary=>:bg_stream, :modifier=>:parallel, :ownership=>:local}
STRUCT Counter { value: Int64 }

FN main() RETURNS Void ->
    MUTABLE c = Counter{ value: 0_i64 } @local;
    s: ~Int64[INF] = BG STREAM {
        @parallel -> WHILE TRUE DO  YIELD c.value; END
    };
    a: Int64 = NEXT s;
    ASSERT a >= 0_i64, "stream produced a value";
    RETURN;
END
