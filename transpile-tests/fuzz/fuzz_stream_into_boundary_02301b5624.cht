# AUTOGENERATED by tools/fuzz — template=stream_into_boundary expected=pass params={:consumer=>:bg, :ownership=>:local, :sync=>:none, :move=>:borrow, :value=>:string}
FN main() RETURNS Void ->
    src: ~String[INF] = BG STREAM {
        MUTABLE i: Int64 = 1_i64;
        WHILE TRUE DO
            YIELD i.toString();
            i = i + 1_i64;
        END
    };
    raw: String = NEXT src;
    val: String = raw;
    result: ~Int64 = BG { val.length(); };
    answer: Int64 = NEXT result;
    ASSERT answer >= 0_i64, "bg consumer produced a value";
    RETURN;
END
