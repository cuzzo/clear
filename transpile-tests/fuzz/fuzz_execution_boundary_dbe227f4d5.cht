# AUTOGENERATED by tools/fuzz — template=execution_boundary expected=pass params={:boundary=>:bg_stream, :modifier=>:pinned, :ownership=>:multiowned}
STRUCT Counter { value: Int64 }

FN main() RETURNS Void ->
    c = Counter{ value: 0_i64 } @multiowned;
    s: ~Int64[INF] = BG STREAM {
        @pinned -> WHILE TRUE DO MUTABLE inner_r: Int64 = 0_i64; WITH c { inner_r = c.value; } YIELD inner_r; END
    };
    a: Int64 = NEXT s;
    ASSERT a >= 0_i64, "stream produced a value";
    RETURN;
END
