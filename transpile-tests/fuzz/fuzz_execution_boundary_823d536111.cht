# AUTOGENERATED by tools/fuzz — template=execution_boundary expected=pass params={:boundary=>:bg_stream, :modifier=>:none, :ownership=>:shared_locked}
STRUCT Counter { value: Int64 }

FN main() RETURNS Void ->
    c = Counter{ value: 0_i64 } @shared:locked;
    s: ~Int64[INF] = BG STREAM {
        WHILE TRUE DO MUTABLE inner_r: Int64 = 0_i64; WITH EXCLUSIVE c AS x { inner_r = x.value; } YIELD inner_r; END
    };
    a: Int64 = NEXT s;
    ASSERT a >= 0_i64, "stream produced a value";
    RETURN;
END
