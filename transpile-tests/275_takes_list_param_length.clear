FN consume(TAKES xs: []Int64) RETURNS Int64 -> RETURN xs.length(); END

FN make_lst() RETURNS ![]Int64 ->
    MUTABLE lst: []Int64 = List[];
    &lst.append(1_i64); &lst.append(2_i64); &lst.append(3_i64);
    RETURN lst;
END

FN main() RETURNS Void ->
    lst = make_lst();
    n: Int64 = consume(GIVE lst);
    ASSERT n == 3, "consume! saw all three items via .length() on @list TAKES";
END
