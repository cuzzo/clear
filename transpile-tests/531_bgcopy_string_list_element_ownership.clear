# Regression: COPY of a String[]@list into a BG must deep-copy the
# element strings, else its cleanup double-frees the source's.
# Detected only under leak detection (`./clear test`).
FN consume(xs: []String) RETURNS Int64 -> RETURN xs.length(); END

FN runit() RETURNS !Int64 ->
    MUTABLE c0: []String = List[];
    &c0.append("a");
    f: ~Int64 = BG { consume(COPY c0); };
    RETURN NEXT f;
END

FN main() RETURNS !Void ->
    n: Int64 = runit() OR_ELSE RAISE;
    ASSERT n == 1_i64, "bare String[]@list COPY into BG";
    RETURN;
END
