# Read-only borrow of an `@list` argument: the callee declares
# `xs: T[]@list` (no TAKES, no MUTABLE) and reads via `.length()`,
# indexing, and iteration. The caller keeps full ownership; the
# call must not consume or shadow the list.

FN measureLen(xs: Int64[]@list) RETURNS Int64 ->
    RETURN xs.length();
END

FN sumAll(xs: Int64[]@list) RETURNS Int64 ->
    MUTABLE total: Int64 = 0_i64;
    FOR x IN xs DO total = total + x; END
    RETURN total;
END

FN firstTwo(xs: Int64[]@list) RETURNS Int64 ->
    RETURN (xs[0_i64] OR 0_i64) + (xs[1_i64] OR 0_i64);
END

FN main() RETURNS Void ->
    MUTABLE xs: Int64[]@list = List[];
    xs.append(10_i64);
    xs.append(20_i64);
    xs.append(30_i64);

    ASSERT measureLen(xs) == 3_i64, "borrow length";
    ASSERT sumAll(xs)     == 60_i64, "borrow iter sum";
    ASSERT firstTwo(xs)   == 30_i64, "borrow indexed access";

    # The borrow must not have consumed `xs`; the caller can keep using it.
    xs.append(40_i64);
    ASSERT xs.length() == 4_i64, "caller still owns list after borrow calls";
END
