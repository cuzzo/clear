-- Test: SHARD pipeline operator — shared-nothing concurrent map operations.
--
-- Exercises: SHARD routing, CONCURRENT EACH with @sharded HashMap,
-- multiple SHARD blocks in sequence (caught a codegen semicolon bug).

FN main() RETURNS Void ->
    MUTABLE map: HashMap<String>@sharded(2) = {};
    n = 100_i64;

    -- SHARD SET: route keys to owning shards, set values
    (0..<n) |> SHARD("k:${toString(_)}", map) |> CONCURRENT EACH {
        map[_] = "v";
    };

    -- SHARD OVERWRITE: second sequential SHARD block (tests semicolon codegen)
    (0..<n) |> SHARD("k:${toString(_)}", map) |> CONCURRENT EACH {
        map[_] = "updated";
    };

    ASSERT map.count() == 100, "shard pipeline count after two sequential blocks";

    RETURN;
END
