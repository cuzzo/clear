STRUCT Node { v: Int64 }

FN makeLockedNode(n: Node) RETURNS !Node @locked ->
    locked = Node{ v: n.v } @locked;
    RETURN locked;
END

FN main() RETURNS Void ->
    ln = makeLockedNode(Node{ v: 99 });

    WITH EXCLUSIVE ln AS inner {
        ASSERT inner.v == 99, "inner.v should be 99";
        inner.v = 100;
        ASSERT inner.v == 100, "inner.v should be 100 after mutation";
    }

    -- defer lockedDestroy runs here; no leak.
    RETURN;
END
