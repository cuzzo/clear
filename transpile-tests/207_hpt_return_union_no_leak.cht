-- Test: RETURN f(g!()) where the return type is a non-Copy union.
-- Fix: the callee must deep-copy the union before returning so the HPT
-- (the g!() result) can be freed without dangling the returned value.

UNION Value { Nil, Str: String, Num: Float64 }

FN makeValue!(s: String) RETURNS Value ->
    RETURN Value{ Str: COPY s };
END

-- COPY v deep-copies the union (including string fields), returning an
-- independent Value. The caller's HPT is freed after this returns.
FN identity(v: Value) RETURNS Value ->
    RETURN COPY v;
END

FN wrapAndReturn!(input: String) RETURNS Value ->
    -- Named binding: makeValue!()'s cleanup is a regular defer.
    -- identity returns a deep copy, so the returned Value survives v's cleanup.
    v = makeValue!(input);
    RETURN identity(v);
END

FN main() RETURNS Void ->
    result = wrapAndReturn!("hello");
    PARTIAL MATCH result START
        Value.Str AS s -> ASSERT s == "hello", "string survives HPT cleanup";,
        DEFAULT -> ASSERT FALSE, "expected Str variant";
    END
    print("207: hpt return union no leak PASSED");
END
