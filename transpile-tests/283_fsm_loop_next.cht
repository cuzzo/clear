-- FSM Phase B2-NEXT-LOOP: a BG body containing a single top-level
-- WHILE loop whose body has exactly one NEXT lowers to a 4-state
-- cycling FSM (runPre → loop_test → loop_pre+suspend → loop_post →
-- back-edge to loop_test → runPost).
--
-- The state machine reuses one suspend slot across iterations and
-- preserves loop-induction + cross-iteration locals via the same
-- conservative-promote rule as the linear N-state path.

FN double_it(x: Int64) RETURNS Int64 -> RETURN x * 2; END

FN noop() RETURNS Void -> RETURN; END

FN main() RETURNS Void ->
  -- 1. Canonical fan-out-collect: 4 sequential awaits driven by a
  --    counter, each spawning a child BG that depends on i.
  o1: ~Int64 = BG {
    MUTABLE i = 0_i64;
    MUTABLE total = 0_i64;
    WHILE i < 4 DO
      p: ~Int64 = BG { i + 1; };
      r = NEXT p;
      total += r;
      i += 1;
    END
    total;
  };
  ASSERT (NEXT o1) == 10, "1: 1+2+3+4 = 10";

  -- 2. Loop with N=0 iterations: cond is false on entry, suspend
  --    never fires, post-stmts run.
  o2: ~Int64 = BG {
    MUTABLE i = 0_i64;
    MUTABLE total = 99_i64;
    WHILE i > 0 DO
      p: ~Int64 = BG { 1000; };
      r = NEXT p;
      total += r;
      i += 1;
    END
    total;
  };
  ASSERT (NEXT o2) == 99, "2: zero-iteration loop";

  -- 3. Loop with N=1 iteration. Single suspend, exits.
  o3: ~Int64 = BG {
    MUTABLE i = 0_i64;
    MUTABLE total = 0_i64;
    WHILE i < 1 DO
      p: ~Int64 = BG { 42; };
      r = NEXT p;
      total = r;
      i += 1;
    END
    total;
  };
  ASSERT (NEXT o3) == 42, "3: single-iteration loop";

  -- 4. Many iterations stress (16). Verifies no per-iteration leaks
  --    and the cycling state machine doesn't accumulate state.
  o4: ~Int64 = BG {
    MUTABLE i = 0_i64;
    MUTABLE total = 0_i64;
    WHILE i < 16 DO
      p: ~Int64 = BG { i; };
      r = NEXT p;
      total += r;
      i += 1;
    END
    total;
  };
  ASSERT (NEXT o4) == 120, "4: sum 0..15 = 120";

  -- 5. Pre-loop computation that survives all iterations (seed
  --    declared in pre, read in loop_pre and post).
  o5: ~Int64 = BG {
    seed = 100_i64;
    MUTABLE i = 0_i64;
    MUTABLE total = 0_i64;
    WHILE i < 3 DO
      p: ~Int64 = BG { seed + i; };
      r = NEXT p;
      total += r;
      i += 1;
    END
    seed + total;          -- 100 + (100+0)+(100+1)+(100+2) = 100 + 303 = 403
  };
  ASSERT (NEXT o5) == 403, "5: pre-loop local read each iteration + after loop";

  -- 6. Capture from outer scope flows through alongside the loop.
  cap = 7_i64;
  o6: ~Int64 = BG {
    MUTABLE i = 0_i64;
    MUTABLE total = 0_i64;
    WHILE i < 3 DO
      p: ~Int64 = BG { cap + i; };
      r = NEXT p;
      total += r;
      i += 1;
    END
    total;                 -- (7+0)+(7+1)+(7+2) = 24
  };
  ASSERT (NEXT o6) == 24, "6: outer capture + loop";

  -- 7. Function call inside the loop body's pre-suspend section.
  o7: ~Int64 = BG {
    MUTABLE i = 0_i64;
    MUTABLE total = 0_i64;
    WHILE i < 3 DO
      v = double_it(i);
      p: ~Int64 = BG { v + 1; };
      r = NEXT p;
      total += r;
      i += 1;
    END
    total;                 -- (0*2+1)+(1*2+1)+(2*2+1) = 1+3+5 = 9
  };
  ASSERT (NEXT o7) == 9, "7: fn call in loop_pre";

  -- 8. Bare NEXT (no result-var binding) inside the loop. Each
  --    iteration awaits and discards.
  o8: ~Int64 = BG {
    MUTABLE i = 0_i64;
    WHILE i < 3 DO
      p: ~Void = BG { noop(); };
      NEXT p;
      i += 1;
    END
    i;                     -- 3
  };
  ASSERT (NEXT o8) == 3, "8: bare NEXT in loop";

  RETURN;
END
