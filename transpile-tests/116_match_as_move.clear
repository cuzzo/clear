# Test: Union with heap slice variant — cleanup must recurse into elements
#
# Reproduces the scheme interpreter leak pattern:
# 1. makeInner() builds a list, promotes it, returns Value.List
# 2. makeOuter() receives that Value.List (heap slice), puts it in
#    another list, promotes, returns Value.List
# 3. Caller receives nested Value.List structure
# 4. cleanup(Value) must free BOTH the outer and inner []Value slices
#
# Without the fix, needsCleanup(Value) returns false for the List: []Value
# variant, so cleanup skips recursion into elements and inner slices leak.

UNION Value { Num: Float64, List: Value[] }

FN makeInner() RETURNS !Value ->
    MUTABLE items: Value[]@list = List[];
    items.append(Value{ Num: 1.0 });
    items.append(Value{ Num: 2.0 });
    RETURN Value{ List: items };
END

FN makeOuter() RETURNS !Value ->
    MUTABLE items: Value[]@list = List[];
    items.append(makeInner());
    items.append(Value{ Num: 3.0 });
    RETURN Value{ List: items };
END

FN main() RETURNS Void ->
    result = makeOuter();

    PARTIAL MATCH result START
        Value.List AS items ->
            ASSERT items.length() == 2, "outer should have 2 elements";,
        DEFAULT ->
            ASSERT FALSE, "expected List";
    END

    # result cleanup must:
    # 1. See result is Value.List, enter slice cleanup
    # 2. Recurse into items[0] which is Value.List (inner)
    # 3. Free inner []Value slice
    # 4. Free outer []Value slice
    RETURN;
END
