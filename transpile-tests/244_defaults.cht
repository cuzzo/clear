-- Test: function and struct defaults
-- Verifies:
--   1. Function param with primitive default
--   2. Function param with DEFAULT (struct default)
--   3. Empty struct literal Foo{} uses all field defaults
--   4. Struct field defaults emitted in Zig struct definition

STRUCT Config {
    retries=3: Int64,
    timeout=1000: Int64,
}

FN makeConfig() RETURNS Config ->
    RETURN Config{};
END

FN run(n=10: Int64) RETURNS Int64 ->
    RETURN n * 2;
END

FN runWithConfig(cfg=DEFAULT: Config) RETURNS Int64 ->
    RETURN cfg.retries + cfg.timeout;
END

FN main() RETURNS Void ->
    -- Test 1: primitive default used
    r1 = run();
    ASSERT r1 == 20, "test1: default n=10, 10*2=20";

    -- Test 2: override the default
    r2 = run(5);
    ASSERT r2 == 10, "test2: override n=5, 5*2=10";

    -- Test 3: empty struct literal uses all field defaults
    cfg = Config{};
    ASSERT cfg.retries == 3, "test3: default retries=3";
    ASSERT cfg.timeout == 1000, "test3: default timeout=1000";

    -- Test 4: makeConfig() returns empty struct with defaults
    cfg2 = makeConfig();
    ASSERT cfg2.retries == 3, "test4: makeConfig retries=3";

    -- Test 5: DEFAULT param injects struct{} at call site
    r5 = runWithConfig();
    ASSERT r5 == 1003, "test5: DEFAULT cfg, 3+1000=1003";

    -- Test 6: override DEFAULT param
    r6 = runWithConfig(Config{ retries: 5, timeout: 500 });
    ASSERT r6 == 505, "test6: explicit cfg, 5+500=505";

    RETURN;
END
