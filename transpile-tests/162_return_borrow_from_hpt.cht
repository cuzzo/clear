-- Test: function call temporaries returning unions must get cleanup.
-- Covers all allocator paths: frame (promoted), heap (COPY), and mixed.

UNION Val {
    Nil,
    Str: String,
    Lambda { params: Val[], body: Val @indirect, envId: Int64 }
}

FN getStr(v: Val) RETURNS String ->
    PARTIAL MATCH v START
        Val.Str AS s -> RETURN s;,
        DEFAULT -> RETURN "nil";
    END
    RETURN "nil";
END

-- Case 1: frame-allocated string promoted to heap via PromotionPlan
FN makeFromFrame!(a: String, b: String) RETURNS !Val ->
    RETURN Val{ Str: a + b };
END

-- Case 2: heap-allocated via COPY
FN makeFromHeap!() RETURNS !Val ->
    MUTABLE params: Val[]@list = List[];
    params.append(Val{ Str: "x" });
    RETURN Val.Lambda{ params: COPY params, body: Val{ Str: "body" }, envId: 0 };
END

-- Case 3: pure value (no allocation) - should NOT get __hpt
FN makePure() RETURNS Val ->
    RETURN Val.Nil;
END

FN wrap(v: Val) RETURNS String ->
    RETURN getStr(v);
END

FN main() RETURNS Void ->
    -- Case 1: frame-promoted return as temp
    s1 = wrap(makeFromFrame!("hel", "lo"));
    ASSERT s1 == "hello", "frame promoted temp";

    -- Case 2: heap return as temp
    s2 = wrap(makeFromHeap!());
    ASSERT s2 == "nil", "heap temp";  -- Lambda has no Str, getStr returns "nil"

    -- Case 3: pure return as temp (no leak expected)
    s3 = wrap(makePure());
    ASSERT s3 == "nil", "pure temp";

    print("PASS");
END
