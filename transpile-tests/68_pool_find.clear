# Test: @pool FIND pipeline operator
# Verifies that FIND on a @pool source returns the first matching live slot
# as an optional element, and returns NIL when no slot matches.

STRUCT Item { value: Float64 }

FN main() RETURNS Void ->
    MUTABLE pool: [Pool(100)]Item = [];
    id1: Id<Item> = &pool.insert(Item{ value: 10.0 });
    id2: Id<Item> = &pool.insert(Item{ value: 20.0 });
    id3: Id<Item> = &pool.insert(Item{ value: 30.0 });

    # FIND: matching element
    found = pool |> FIND _.value == 20.0;
    ASSERT found != NIL, "FIND should find value 20";

    # FIND: no match returns NIL
    missing = pool |> FIND _.value == 99.0;
    ASSERT missing == NIL, "FIND should return NIL for missing value";

    # FIND: after remove, deleted slot is skipped (alive check)
    &pool.remove(id1);
    gone = pool |> FIND _.value == 10.0;
    ASSERT gone == NIL, "FIND should not return a removed item";

    # FIND: other items still findable after remove
    still_there = pool |> FIND _.value == 30.0;
    ASSERT still_there != NIL, "FIND should still find live items after remove";

    RETURN;
END
