-- Test: returning a string from a function that wraps an HPT call must
-- not leak the HPT. The returned string must be an independent copy
-- so the HPT can be cleaned up after the function returns.

UNION Value { Nil, Str: String, Number: Float64 }

-- COPY s creates a new heap allocation for the string bytes, independent of v.
-- v can be freed after getStr returns without dangling the returned string.
FN getStr(v: Value) RETURNS String ->
    PARTIAL MATCH v START
        Value.Str AS s -> RETURN COPY s;,
        DEFAULT -> RETURN COPY "nil";
    END
    RETURN COPY "nil";
END

FN makeValue!(s: String) RETURNS Value ->
    RETURN Value{ Str: COPY s };
END

FN wrapAndGet!(input: String) RETURNS String ->
    -- Named binding: v's cleanup is a regular defer (freed at scope exit).
    -- getStr returns a COPY'd string independent of v, so no UAF.
    v = makeValue!(input);
    RETURN getStr(v);
END

FN main() RETURNS Void ->
    result = wrapAndGet!("hello");
    ASSERT result == "hello", "returned string matches";
    print("180: hpt return string no leak PASSED");
END
