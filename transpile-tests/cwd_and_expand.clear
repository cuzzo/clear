# Ruby's Dir.pwd. path's expand already resolves a path against a base, so
# pwd is what File.expand_path needs to resolve a relative path against.
REQUIRE "pkg:path"

FN main() RETURNS !Void ->
  here = TRY (pwd());
  ASSERT here.startsWith?("/"), "the working directory is absolute";
  ASSERT !(here.empty?()), "and is not empty";

  ASSERT expand("/abs/x", here) == "/abs/x", "an absolute path ignores the base";
  ASSERT expand("rel", here).startsWith?(here), "a relative path resolves against it";
END
