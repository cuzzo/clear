# Ruby's Dir.pwd and File.expand_path: the working directory, and a path
# resolved against it.
FN main() RETURNS !Void ->
  here = TRY (pwd());
  ASSERT here.startsWith?("/"), "the working directory is absolute";

  same = TRY (expand(here));
  ASSERT same == here, "an absolute path resolves to itself";

  child = TRY (expand("./sub/../sub"));
  ASSERT child.startsWith?("/"), "a relative path is resolved against the cwd";
  ASSERT child.endsWith?("sub"), "and names the directory asked for";
  ASSERT !(child.contains?("..")), "with the parent segment collapsed";
END
