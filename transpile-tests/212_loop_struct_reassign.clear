# Test: outer struct with String field reassigned inside a loop.
# The struct is non-Copy (it contains a String). Each iteration replaces
# the outer variable with a new struct containing a frame-allocated string.
# The compiler must preserve the string across the loop mark rewind.

STRUCT Record { name: String, score: Int64 }

FN main() RETURNS Void ->
    MUTABLE best: Record = Record{ name: "none", score: 0 };
    FOR i IN (1_i64 ..= 100) DO
        s = "person_" + i.toString();
        best = Record{ name: COPY s, score: i };
    END
    ASSERT best.score == 100, "should have last score";
    ASSERT best.name == "person_100", "should have last name";

    print("PASS");
    RETURN;
END
