-- Test: Collection Types — Phase 1 (@list and @pool)
-- Exercises explicit @list annotations and @pool generational pool declarations
-- with insert / get / remove and Id<T> handle semantics.

STRUCT Point { x: Float64, y: Float64 }

FN main() RETURNS Void ->
    -- @list with UFCS append
    MUTABLE pts: Point[]@list = [];
    pts.append(Point{ x: 1.0, y: 2.0 });
    pts.append(Point{ x: 3.0, y: 4.0 });
    pts.append(Point{ x: 5.0, y: 6.0 });
    ASSERT pts.length() == 3, "@list should hold 3 points";

    -- Pipeline operators on @list work the same as on plain arrays
    x_sum = pts s> SUM _.x;
    ASSERT x_sum == 9.0, "@list SUM should be 9";

    x_count: Int64 = pts s> COUNT _.x > 2.0;
    ASSERT x_count == 2, "@list COUNT should be 2";

    any_big = pts s> ANY _.x > 4.0;
    ASSERT any_big == TRUE, "@list ANY should find x > 4";

    all_pos = pts s> ALL _.x > 0.0;
    ASSERT all_pos == TRUE, "@list ALL positive";

    found_pt = pts s> FIND _.x == 3.0;
    ASSERT found_pt != NIL, "@list FIND should find x=3";

    small_pts = pts s> WHERE _.x < 4.0;
    ASSERT small_pts.length() == 2, "@list WHERE should return 2 items";

    -- Pool constructor with handle-based access (lazy inference via insert)
    MUTABLE pool: Point[100]@pool = [];

    -- insert returns an Id<Point> (u64 handle)
    id_a: Id<Point> = pool.insert(Point{ x: 10.0, y: 20.0 });
    id_b: Id<Point> = pool.insert(Point{ x: 30.0, y: 40.0 });

    -- pool.length() tracks live slots
    ASSERT pool.length() == 2, "pool should have 2 live items";

    -- get returns ?*Point (optional pointer to the live slot)
    p_a = pool.get(id_a);
    ASSERT p_a != NIL, "get should find a";

    -- remove invalidates the handle
    pool.remove(id_a);
    ASSERT pool.get(id_a) == NIL, "get after remove should return NIL";
    ASSERT pool.length() == 1, "pool should have 1 live item after remove";

    -- id_b still valid
    ASSERT pool.get(id_b) != NIL, "id_b should still be valid";

    RETURN;
END
