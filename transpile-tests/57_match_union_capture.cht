-- MATCH IFF on unions with AS payload capture
-- Regular MATCH: partial coverage allowed

UNION Shape { Circle: Float64, Rectangle: Float64, Point }
UNION Result { Ok: Float64, Err: Float64, Empty }
UNION Option<T> { Some: T, None }

FN area(s: Shape) RETURNS Float64 ->
  MUTABLE a = 0.0;
  MATCH IFF s START
    Shape.Circle    AS r -> a = r * 3.14;,
    Shape.Rectangle AS w -> a = w * w;,
    Shape.Point          -> a = 0.0;
  END
  RETURN a;
END

FN unwrap_ok(r: Result) RETURNS Float64 ->
  MUTABLE val = 0.0;
  MATCH IFF r START
    Result.Ok    AS v -> val = v;,
    Result.Err   AS e -> val = e * -1.0;,
    Result.Empty      -> val = 0.0;
  END
  RETURN val;
END

FN main() RETURNS Void ->
  -- Payload capture: Circle with radius 2.0 → area = 2.0 * 3.14 = 6.28
  c: Shape = Shape{ Circle: 2.0 };
  ASSERT area(c) == 6.28, "Circle AS r: area = r * 3.14";

  -- Payload capture: Rectangle with width 3.0 → area = 9.0
  rect: Shape = Shape{ Rectangle: 3.0 };
  ASSERT area(rect) == 9.0, "Rectangle AS w: area = w * w";

  -- Unit variant: no capture needed
  p: Shape = Shape.Point;
  ASSERT area(p) == 0.0, "Point: area = 0";

  -- Result union payload capture
  ok: Result = Result{ Ok: 42.0 };
  ASSERT unwrap_ok(ok) == 42.0, "Result.Ok AS v";

  err: Result = Result{ Err: 5.0 };
  ASSERT unwrap_ok(err) == -5.0, "Result.Err AS e: negated";

  empty: Result = Result.Empty;
  ASSERT unwrap_ok(empty) == 0.0, "Result.Empty: default";

  -- MATCH IFF inline with AS capture on generic union
  MUTABLE got = 0.0;
  opt = Option<Float64>{ Some: 99.0 };
  MATCH IFF opt START
    Option.Some AS x -> got = x;,
    Option.None      -> got = -1.0;
  END
  ASSERT got == 99.0, "Option.Some AS x: extracts payload";

  MUTABLE got2 = 0.0;
  none_val = Option<Float64>{ Some: 0.0 };
  MATCH IFF none_val START
    Option.Some AS x -> got2 = x;,
    Option.None      -> got2 = -1.0;
  END
  ASSERT got2 == 0.0, "Option.Some AS x = 0.0";

  -- Regular MATCH with partial coverage is fine
  MUTABLE partial = 0.0;
  s2: Shape = Shape{ Circle: 5.0 };
  MATCH s2 START
    Shape.Circle AS r -> partial = r;,
    DEFAULT          -> partial = -1.0;
  END
  ASSERT partial == 5.0, "Regular MATCH with DEFAULT: Circle AS r";
END
