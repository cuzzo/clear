# Bug: frame-allocated @list GIVE'd to TAKES @list param → alloc mismatch.
# Caller's lst lives on frame; callee's TAKES cleanup uses heapAlloc().
# Detected by DebugAllocator as alignment 16 != 8 on free.
# Architectural cause: escape_analysis lacks a "GIVE-to-TAKES" condition;
# the source declaration is not promoted to heap.

FN sum(TAKES xs: []Int64) RETURNS Int64 ->
    MUTABLE total: Int64 = 0_i64;
    FOR x IN xs DO total = total + x; END
    RETURN total;
END

FN main() RETURNS Void ->
    # Frame-allocated source: this is the only thing the test exercises.
    MUTABLE lst: []Int64 = List[];
    &lst.append(10_i64); &lst.append(20_i64); &lst.append(30_i64);
    n: Int64 = sum(GIVE lst);
    ASSERT n == 60_i64, "GIVE frame @list to TAKES @list param";
END
