-- Test: CONCURRENT SELECT with OR RAISE — when no errors, works as normal SELECT
FN alwaysOk(x: Float64) RETURNS !Float64 ->
    RETURN x * 2.0;
END

FN main() RETURNS Void ->
    nums: Float64[] = [1.0, 2.0, 3.0];
    results = nums s> CONCURRENT(workers: 2) SELECT alwaysOk(_) OR RAISE;
    total = results s> SUM _;
    ASSERT total == 12.0, "OR RAISE with no errors should work normally";
    RETURN;
END
