# Test: struct with populated @list field stored in HashMap via a function.
# The list backing buffer is frame-allocated. When HashMap.put replaces
# the value, cleanup tries to free with heapAlloc -> "Invalid free".
# This only triggers when the list has elements (empty lists have no backing).

STRUCT Item {
    name: String,
    tags: []String,
}

FN addItem!(MUTABLE items: {String}Item, key: String, name: String, tag: String) RETURNS !Void ->
    MUTABLE tags: []String = [];
    tags.append(COPY tag);
    items[key] = Item{ name: COPY name, tags: tags };
    RETURN;
END

FN main() RETURNS Void ->
    MUTABLE items: {String}Item = {};

    # Store a struct with a populated list field
    addItem!(items, "x", "first", "a");

    # Replace it - triggers cleanup of old value's frame-allocated list
    addItem!(items, "x", "second", "b");

    # Verify replacement worked
    item = items["x"] OR_ELSE Item{ name: "", tags: [] };
    ASSERT item.name == "second", "replaced value";

    print("181: hashmap struct list field PASSED");
END
