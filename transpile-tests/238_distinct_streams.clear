# Test: DISTINCT on stream types -> T[]@set

FN main() RETURNS Void ->
    # DISTINCT on dynamic range stream (~T[]): produces ~T[]@set:observable;
    # COLLECT joins the producer fiber and returns the final set.
    s1: ~Int64[] = 1 ..< 6;
    u1 = s1 |> DISTINCT _ |> COLLECT;
    ASSERT u1.length() == 5_i64, "distinct range 1..5: 5 unique";
    ASSERT u1.contains?(3_i64), "contains 3";

    # DISTINCT on ~T[INF] with LIMIT: LIMIT strips tense, eager DISTINCT.
    counter: ~Int64[INF] = BG STREAM {
        MUTABLE i: Int64 = 1;
        WHILE TRUE DO
            YIELD i MOD 3;
            i = i + 1;
        END
    };
    u2 = counter |> LIMIT 9 |> DISTINCT _;
    ASSERT u2.length() == 3_i64, "1 MOD 3 cycles through 0,1,2";
    ASSERT u2.contains?(0_i64), "contains 0";
    ASSERT u2.contains?(1_i64), "contains 1";
    ASSERT u2.contains?(2_i64), "contains 2";

    # DISTINCT after WHERE on ~T[INF]: WHERE+LIMIT strip tense, eager.
    counter2: ~Int64[INF] = BG STREAM {
        MUTABLE j: Int64 = 1;
        WHILE TRUE DO
            YIELD j MOD 5;
            j = j + 1;
        END
    };
    u3 = counter2 |> WHERE _ MOD 2 == 0 |> LIMIT 10 |> DISTINCT _;
    ASSERT u3.length() == 3_i64, "even residues mod 5: 0, 2, 4";
    ASSERT u3.contains?(0_i64), "contains 0";
    ASSERT u3.contains?(2_i64), "contains 2";
    ASSERT u3.contains?(4_i64), "contains 4";

    # DISTINCT on bounded stream (~T[N]): observable; COLLECT joins.
    s4: ~Int64[5] = [BG { 3; }, BG { 1; }, BG { 3; }, BG { 2; }, BG { 1; }];
    u4 = s4 |> DISTINCT _ |> COLLECT;
    ASSERT u4.length() == 3_i64, "3 unique values from bounded stream";
    ASSERT u4.contains?(1_i64), "contains 1";
    ASSERT u4.contains?(2_i64), "contains 2";
    ASSERT u4.contains?(3_i64), "contains 3";

    print("OK");
    RETURN;
END
