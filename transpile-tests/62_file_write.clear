# Test: File::create + fileWrite (Phase 4)
# Opens a file for writing, writes content, auto-closes via RAII.
# The compiler emits defer f.close() for the writable File resource.

FN main() RETURNS Void ->
    # File::create is a static constructor that opens/truncates a file for writing.
    # Compiler emits: `defer f.close();` at this declaration site.
    f = File::create("testdata/write_test_output.txt");

    # Write a string to the open file.
    fileWrite(f, "hello from CLEAR");

    # Verify the write worked by reading back via the existing readFile intrinsic.
    result = readFile("testdata/write_test_output.txt");
    ASSERT result.eql?("hello from CLEAR"), "Written content should match read-back content";

    RETURN;
END
