# AtomicPtr M3.13 follow-up (review item E): escape via RETURN.
# Verifies @boxed:atomic survives a fn-return boundary -- the
# M3.12 lifetime exemption (Arc-managed cells can escape) plus the
# caller-side cleanup of the received cell. If cleanup classification
# is wrong for received-via-return cells, this test surfaces a leak.

STRUCT Cfg { v: Int64 }

FN make() RETURNS !Cfg@boxed:atomic ->
    cfg = Cfg{ v: 42 } @boxed:atomic;
    RETURN cfg;
END

FN main() RETURNS Void ->
    cfg = TRY make();
    WITH SNAPSHOT cfg AS c {
        ASSERT c.v == 42, "escaped cell read: expected 42";
    }
    RETURN;
END
