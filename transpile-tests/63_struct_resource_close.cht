# Test: resource fields auto-close on scope exit.

STRUCT Connection { sock: TCPClient, id: Int64 }

FN main() RETURNS Void ->
    # Direct resource: File auto-closes on scope exit.
    f = File::create("testdata/write_test_output.txt");
    fileWrite(f, "resource test");
    content = readFile("testdata/write_test_output.txt");
    ASSERT content == "resource test", "direct resource close";

    # Struct containing resource: TCPClient inside Connection should
    # auto-close when the Connection goes out of scope.
    server = TCPServer::listen(0);
    # (We can't easily test the nested close without a client,
    #  but the transpiler should emit defer for the sock field.)

    RETURN;
END
