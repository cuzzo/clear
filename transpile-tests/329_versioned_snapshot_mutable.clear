# MVCC L8: WITH SNAPSHOT MUTABLE on a @versioned cell.
# Single-cell transaction commits via Versioned.update + EBR retire.
# ON MvccConflict RAISE handles the (unreachable in single-thread) commit conflict.

STRUCT Counter { value: Int64 }

FN main() RETURNS Void ->
    c = Counter{ value: 0 } @versioned;

    # Three sequential transactions, each commits without contention.
    WITH SNAPSHOT c AS MUTABLE va { va.value = va.value + 1; } ON MvccConflict RAISE
    WITH SNAPSHOT c AS MUTABLE va { va.value = va.value + 1; } ON MvccConflict RAISE
    WITH SNAPSHOT c AS MUTABLE va { va.value = va.value + 1; } ON MvccConflict RAISE

    # Verify the cumulative effect.
    WITH SNAPSHOT c AS view {
        ASSERT view.value == 3, "MVCC transaction: expected 3 after three increments";
    }

    RETURN;
END
