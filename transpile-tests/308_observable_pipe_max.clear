# Pipeline-terminal observable MAX.
#
# A BG STREAM produces values; MAX folds them into a `~Int64@observable`
# binding (heap-allocated `*ObservableMax(i64)` with a CAS-loop running
# max); NEXT joins the producer and returns the final max.

FN main() RETURNS Void ->
    gen: ~?Int64[] = BG STREAM {
        MUTABLE i: Int64 = 0_i64;
        WHILE i < 100_i64 DO
            YIELD i;
            i = i + 1_i64;
        END
    };

    running: ~Int64@observable = gen |> MAX _;
    final = NEXT running;

    ASSERT final == 99_i64, "running max mismatch";
    print("ok");
    RETURN;
END
