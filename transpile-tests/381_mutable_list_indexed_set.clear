# Test: indexed assignment (`xs[i] = v`) on a MUTABLE @list parameter.
#
# The bd075f2c hotfix made MUTABLE @list parameters pointer-passed:
# the callee receives `*ArrayList(T)`. CheatLib.setAt and cleanupAt
# dispatch via comptime `@hasField(@TypeOf(container), "items")`,
# which Zig rejects on pointer types -- "type does not support
# @hasField". Result: any callee writing `xs[i] = v` on a MUTABLE
# @list parameter failed to compile.
#
# Fix: setAt/cleanupAt unwrap a single layer of pointer before the
# shape dispatch, mirroring the existing optional-unwrap pattern in
# getAt / firstOpt / lastOpt / sliceContains / len.

FN setFirst!(MUTABLE xs: Int64[]@list, value: Int64) RETURNS !Void ->
    xs[0_i64] = value;
    RETURN;
END

FN main!() RETURNS !Void ->
    MUTABLE xs: Int64[]@list = List[];
    xs.append(10_i64);
    xs.append(20_i64);
    setFirst!(xs, 99_i64) OR_ELSE RAISE;
    ASSERT xs.length() == 2_i64, "len preserved";
    ASSERT xs[0_i64] == 99_i64, "first updated";
    ASSERT xs[1_i64] == 20_i64, "second untouched";
    RETURN;
END
