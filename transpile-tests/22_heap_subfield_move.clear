STRUCT Node { value: Int64 }
STRUCT Container { node: Node @indirect, id: Int64 }

# Create container with heap-allocated node
FN makeContainer(v: Int64) RETURNS !Container ->
    n: Node @indirect = Node{ value: v };
    c = Container{ node: n, id: 1 };
    RETURN c;
END

FN main() RETURNS Void ->
    # Container owns a heap-allocated Node
    container = makeContainer(777);

    # Move the heap node out of container
    extracted = container.node;

    # Verify value
    ASSERT extracted.value == 777, "Extracted node value should be 777";

    # extracted now owns the Node pointer
    # container.node is moved (dead)
    # When scope ends:
    #   - extracted should free the Node (no leak)
    #   - container should NOT double-free the Node
    RETURN;
END
