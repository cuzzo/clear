# Memory leak test: functions that return strings built from concat
# must not leak heap memory. The caller's frame should own the result.

FN buildGreeting(name: String) RETURNS !String ->
    RETURN "Hello, " + name + "!";
END

FN main() RETURNS Void ->
    # Call a string-returning function multiple times.
    # If each call leaks, the GPA will catch it.
    a = buildGreeting("Alice");
    ASSERT a == "Hello, Alice!", "greeting Alice";

    b = buildGreeting("Bob");
    ASSERT b == "Hello, Bob!", "greeting Bob";

    c = buildGreeting("Charlie");
    ASSERT c == "Hello, Charlie!", "greeting Charlie";

    RETURN;
END
