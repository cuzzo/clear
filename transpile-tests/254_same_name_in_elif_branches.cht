FN pick(kind: Int64) RETURNS Int64 ->
    IF kind == 1 THEN
        MUTABLE items: Int64[]@list = [];
        items.append(1_i64);
        items.append(2_i64);
        items.append(3_i64);
        RETURN items.length();
    ELSE_IF kind == 2 THEN
        MUTABLE items: Int64[]@list = [];
        items.append(10_i64);
        items.append(20_i64);
        RETURN items.length();
    ELSE
        MUTABLE items: Int64[]@list = [];
        RETURN items.length();
    END
    RETURN 0_i64;
END

FN main() RETURNS Void ->
    a = pick(1);
    ASSERT a == 3_i64, "kind 1 should be 3";
    b = pick(2);
    ASSERT b == 2_i64, "kind 2 should be 2";
    c = pick(3);
    ASSERT c == 0_i64, "kind 3 should be 0";
    RETURN;
END
