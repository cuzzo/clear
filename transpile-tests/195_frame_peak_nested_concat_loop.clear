# Test: nested string concat (multi-part) in a loop has bounded frame.
# Pattern: s = a + b + c creates two frame-arena allocations per iteration.
# Tests that all intermediate concat results are reclaimed per iteration.

FN formatLine(n: Int64) RETURNS !String ->
    RETURN "[" + n.toString() + "] " + "item";
END

FN main() RETURNS Void ->
    MUTABLE total: Int64 = 0;
    FOR i IN (1_i64 ..= 500) DO
        line = formatLine(i);
        total += line.length();
    END
    peak = framePeakBytes();

    ASSERT total > 0, "accumulated lengths";
    # 500 calls, each with ~3 concats + toString. Without rewind: ~50KB+
    # of dead frame strings. With rewind: bounded.
    ASSERT peak < 500000, "frame peak bounded for nested concat loop";

    print("PASS: frame peak bounded in nested concat loop");
    RETURN;
END
