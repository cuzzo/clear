-- Test: Method calls on struct.list[index].field expressions
-- Verifies that the aliasing checker handles GetIndex nodes in
-- GetField chains (e.g. db.nodes[idx].keys.length()).

STRUCT Node { keys: Int64[]@list, vals: String[]@list }
STRUCT DB { nodes: Node[]@list }

FN countKeys(db: DB, idx: Int64) RETURNS Int64 ->
    RETURN db.nodes[idx].keys.length();
END

FN main() RETURNS Void ->
    MUTABLE db = DB{ nodes: [] };
    MUTABLE n0 = Node{ keys: [], vals: [] };
    n0.keys.append(10);
    n0.keys.append(20);
    n0.keys.append(30);
    MUTABLE n1 = Node{ keys: [], vals: [] };
    n1.keys.append(40);
    n1.keys.append(50);
    db.nodes.append(n0);
    db.nodes.append(n1);

    -- Verify counts via method call on nested indexed field
    ASSERT countKeys(db, 0) == 3, "node 0 has 3 keys";
    ASSERT countKeys(db, 1) == 2, "node 1 has 2 keys";

    -- Direct access pattern
    ASSERT db.nodes[0].keys[0] == 10, "node 0 key 0 is 10";
    ASSERT db.nodes[0].keys[2] == 30, "node 0 key 2 is 30";
    ASSERT db.nodes[1].keys[0] == 40, "node 1 key 0 is 40";

    print("167: nested list index field PASSED");
END
