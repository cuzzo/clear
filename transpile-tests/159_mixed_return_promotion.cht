-- Test: functions with mixed return paths must not double-promote.
-- Bug: struct_promote is function-level, so RETURN Val{ Str: COPY s }
-- gets promoteFields even though COPY already heap-duped. Leaks.

UNION Val {
    Nil,
    Str: String,
    Num: Float64
}

FN convert!(token: String) RETURNS Val ->
    -- Path 1: frame string in union (needs promotion)
    IF token == "nil" THEN RETURN Val.Nil; END
    IF charAt(token, 0) == "\"" THEN RETURN Val{ Str: substr(token, 1, token.length() - 2) }; END
    -- Path 2: number (no promotion needed)
    n = toNumber(token) OR (0.0 - 999999.0);
    IF n != 0.0 - 999999.0 THEN RETURN Val{ Num: n }; END
    -- Path 3: COPY string (already heap, must not double-promote)
    RETURN Val{ Str: COPY token };
END

FN main() RETURNS Void ->
    v1 = convert!("nil");
    v2 = convert!("\"hello\"");
    v3 = convert!("42");
    v4 = convert!("symbol");
    MATCH v2 START
        Val.Str AS s -> ASSERT s == "hello", "substr path";,
        DEFAULT -> ASSERT FALSE, "should be Str";
    END
    MATCH v4 START
        Val.Str AS s -> ASSERT s == "symbol", "copy path";,
        DEFAULT -> ASSERT FALSE, "should be Str";
    END
    print("PASS");
END
