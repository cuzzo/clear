# Test: PROFILE inside TEST blocks.
# Verifies that PROFILE compiles and produces timing + alloc output.

FN compute(n: Float64) RETURNS Float64 ->
    MUTABLE sum = 0.0;
    MUTABLE i = 0.0;
    WHILE i < n DO
        sum = sum + i;
        i = i + 1.0;
    END
    RETURN sum;
END

FN main() RETURNS Void ->
    ASSERT compute(10.0) == 45.0;
    RETURN;
END

TEST ProfileTest DO
  WHEN "profiling" DO
    TEST THAT "compute is correct" DO
      ASSERT compute(100.0) == 4950.0;
    END

    PROFILE compute(1000.0);
  END
END
