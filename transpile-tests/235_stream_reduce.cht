-- Test: REDUCE on variable-backed finite streams (~T[], ~T[N]) and infinite
-- streams (~T[INF] with LIMIT).

FN main() RETURNS Void ->
    -- REDUCE on dynamic stream (~T[]): produces ~T@observable; COLLECT joins.
    s1: ~Int64[] = 1 ..< 6;
    product1 = s1 s> REDUCE(1_i64) acc * _ s> COLLECT;
    ASSERT product1 == 120, "dynamic stream REDUCE product 1*2*3*4*5";

    -- WHERE + REDUCE on dynamic stream: WHERE strips tense, so REDUCE
    -- folds eagerly to a scalar (no observable lift here).
    s2: ~Int64[] = 0 ..< 10;
    filtered = s2 s> WHERE _ > 5 s> REDUCE(0_i64) acc + _;
    ASSERT filtered == 30, "dynamic stream WHERE+REDUCE: 6+7+8+9";

    -- REDUCE on bounded stream (~T[N]): observable; COLLECT joins.
    s3: ~Int64[4] = [BG { 1; }, BG { 2; }, BG { 3; }, BG { 4; }];
    sum3 = s3 s> REDUCE(0_i64) acc + _ s> COLLECT;
    ASSERT sum3 == 10, "bounded stream REDUCE sum 1+2+3+4";

    -- WHERE + REDUCE on bounded stream: WHERE strips tense (eager).
    s4: ~Int64[5] = [BG { 1; }, BG { 2; }, BG { 3; }, BG { 4; }, BG { 5; }];
    evens = s4 s> WHERE _ MOD 2 == 0 s> REDUCE(0_i64) acc + _;
    ASSERT evens == 6, "bounded stream WHERE+REDUCE: 2+4";

    -- REDUCE on infinite stream with LIMIT: LIMIT strips tense (eager).
    counter: ~Int64[INF] = BG STREAM {
        MUTABLE i: Int64 = 1;
        WHILE TRUE DO
            YIELD i;
            i = i + 1;
        END
    };
    total = counter s> LIMIT 5 s> REDUCE(0_i64) acc + _;
    ASSERT total == 15, "inf stream LIMIT+REDUCE: 1+2+3+4+5";

    print("OK");
    RETURN;
END
