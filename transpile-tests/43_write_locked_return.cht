STRUCT Node { v: Int64 }

FN makeWriteLockedNode(n: Node) RETURNS !Node @writeLocked ->
    locked = Node{ v: n.v } @writeLocked;
    RETURN locked;
END

FN main() RETURNS Void ->
    ln = makeWriteLockedNode(Node{ v: 99 });

    WITH EXCLUSIVE ln AS inner {
        ASSERT inner.v == 99, "inner.v should be 99";
        inner.v = 100;
        ASSERT inner.v == 100, "inner.v should be 100 after mutation";
    }

    WITH ln AS inner {
        ASSERT inner.v == 100, "inner.v should be 100 after write";
    }

    -- defer rwLockedDestroy runs here; no leak.
    RETURN;
END
