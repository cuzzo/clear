-- Repro: BG block inside a function that received an @shared:locked
-- argument via REQUIRES LOCKED. The param is `anytype` from the
-- caller's POV, and the actual deduced runtime type is *Arc(Locked(T)).
-- The BG capture codegen used to compute the field type from the
-- nominal parameter type (without Arc), producing a Zig type-mismatch
-- when the ctx struct was initialized with `&pool`.
--
-- This is exactly what _bc_runner.cht's exec! does when BG_SPAWN
-- creates a real fiber capturing the @shared:locked pool.

STRUCT Counter { value: Int64 }

FN spawnBumper(c: Counter) RETURNS !Int64
  REQUIRES c: LOCKED
->
    bgFut: ~Int64 = BG {
        WITH EXCLUSIVE c AS inner {
            inner.value = inner.value + 1;
        }
        42_i64;
    };
    r = NEXT bgFut;
    RETURN r;
END

FN main() RETURNS Void ->
    c = Counter{ value: 10 } @shared:locked;
    r = spawnBumper(c);
    ASSERT r == 42, "BG fiber returns its value";
    WITH c AS inner {
        ASSERT inner.value == 11, "BG fiber mutated the locked counter";
    }
END
