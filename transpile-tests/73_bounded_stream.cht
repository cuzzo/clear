-- Bounded streams: ~T[N] — a fixed-size ordered stream of N concurrent BG fibers.
-- NEXT consumes items in spawn order (FIFO). Calling NEXT on the same stream
-- variable N times returns the N results; the Nth+1 call panics at runtime.

FN double(x: Number) RETURNS Number ->
    RETURN x * 2.0;
END

FN add(a: Number, b: Number) RETURNS Number ->
    RETURN a + b;
END

FN cheatMain() RETURNS Void ->
    -- -------------------------------------------------------
    -- Test 1: Basic bounded stream — 3 concurrent BG fibers.
    -- -------------------------------------------------------
    stream: ~Number[3] = [
        BG { 10.0; },
        BG { 20.0; },
        BG { 30.0; }
    ];

    r0: Number = NEXT stream;
    r1: Number = NEXT stream;
    r2: Number = NEXT stream;

    ASSERT r0 == 10.0, "bounded stream item 0";
    ASSERT r1 == 20.0, "bounded stream item 1";
    ASSERT r2 == 30.0, "bounded stream item 2";

    -- -------------------------------------------------------
    -- Test 2: Stream with captured outer variables.
    -- Each BG block captures its own snapshot of outer vars.
    -- -------------------------------------------------------
    base: Number = 5.0;
    factor: Number = 3.0;

    work: ~Number[2] = [
        BG { double(base); },
        BG { add(base, factor); }
    ];

    w0: Number = NEXT work;
    w1: Number = NEXT work;

    ASSERT w0 == 10.0, "bounded stream: captured double(5)";
    ASSERT w1 == 8.0,  "bounded stream: captured add(5, 3)";

    -- -------------------------------------------------------
    -- Test 3: Single-element stream (degenerate case).
    -- -------------------------------------------------------
    solo: ~Number[1] = [
        BG { 99.0; }
    ];
    s0: Number = NEXT solo;
    ASSERT s0 == 99.0, "single-element bounded stream";

    RETURN;
END
