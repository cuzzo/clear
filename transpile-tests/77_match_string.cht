FN classify(cmd: String) RETURNS Int64 ->
  MUTABLE result = 0_i64;
  PARTIAL MATCH cmd START
    "hello" -> result = 1_i64;,
    "world" -> result = 2_i64;,
    DEFAULT -> result = 99_i64;
  END
  RETURN result;
END

FN main() RETURNS Void ->
  # Static string literals: should hit matching case
  r1 = classify("hello");
  ASSERT r1 == 1, "PARTIAL MATCH string: should hit 'hello' case";

  r2 = classify("world");
  ASSERT r2 == 2, "PARTIAL MATCH string: should hit 'world' case";

  # Unmatched string: should hit DEFAULT
  r3 = classify("other");
  ASSERT r3 == 99, "PARTIAL MATCH string: DEFAULT should fire for unmatched string";

  # Build a string at runtime via concatenation to prove content equality
  s1 = "hel";
  s2 = "lo";
  dynamic = s1 + s2;
  r4 = classify(dynamic);
  ASSERT r4 == 1, "PARTIAL MATCH string: content equality should match 'hello' built via concat";
END
