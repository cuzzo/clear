# Test: a block expression whose value is a pipeline result hands that result
# to the binding. The pipeline temp used to keep a plain `defer cleanup` inside
# the block while the same buffer escaped as the block's value, so the owner
# freed it a second time.

FN main() RETURNS Void ->
    uniq = ( { MUTABLE src: []String = ["a", "b", "a"]; src |> DISTINCT _ } );
    ASSERT uniq.length() == 2;

    nums = ( { MUTABLE raw: []Int64 = [3, 1, 3]; raw |> DISTINCT _ } );
    ASSERT nums.length() == 2;

    kept = ( { MUTABLE all: []Int64 = [5, 6, 7]; all |> WHERE _ > 5 } );
    ASSERT kept.length() == 2;
END
