# ELSE_IF chains and mutable string concatenation

FN dispatch(cmd: String) RETURNS String ->
    IF startsWith?(cmd, "SET:") THEN
        RETURN "ok_set";
    ELSE_IF startsWith?(cmd, "GET:") THEN
        RETURN "ok_get";
    ELSE_IF cmd == "QUIT" THEN
        RETURN "ok_quit";
    ELSE_IF cmd == "READY?" THEN
        RETURN "ok_ready";
    ELSE
        RETURN "err_unknown";
    END
END

FN main() RETURNS Void ->
    ASSERT dispatch("SET:1") == "ok_set", "dispatch SET";
    ASSERT dispatch("GET:42") == "ok_get", "dispatch GET";
    ASSERT dispatch("QUIT") == "ok_quit", "dispatch QUIT";
    ASSERT dispatch("READY?") == "ok_ready", "dispatch READY";
    ASSERT dispatch("NOPE") == "err_unknown", "dispatch unknown";

    # Mutable string concatenation (building a response)
    MUTABLE resp = "";
    resp = resp $+ "line1\n";
    resp = resp $+ "line2\n";
    ASSERT resp == "line1\nline2\n", "mutable string concat";

    RETURN;
END
