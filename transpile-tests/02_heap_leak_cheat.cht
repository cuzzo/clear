STRUCT User { id: Int64 }

FN main() RETURNS Void ->
    # Heap allocation (type annotation forces heap via declared pointer type)
    u: %User = User{ id: 99 };

    # The transpiler is responsible for generating:
    # defer CheatLib.free(rt, u);

    # If transpiler logic works, `zig test` passes.
    # If it fails to free, `zig test` reports "Memory leak detected".
    RETURN;
END

