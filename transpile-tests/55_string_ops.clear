# String operations: startsWith?, charAt, substr, toNumber, toInt

FN main() RETURNS Void ->
    # startsWith?
    ASSERT startsWith?("SET:1", "SET:"), "startsWith SET: prefix";
    ASSERT startsWith?("GET:42", "GET:"), "startsWith GET: prefix";
    ASSERT !startsWith?("QUIT", "SET:"), "startsWith negative";
    ASSERT startsWith?("", ""), "startsWith empty on empty";
    ASSERT startsWith?("hello", ""), "startsWith empty prefix";

    # charAt
    line = "SET:1";
    ASSERT charAt(line, 0_i64) == "S", "charAt 0";
    ASSERT charAt(line, 3_i64) == ":", "charAt 3";
    ASSERT charAt(line, 4_i64) == "1", "charAt 4";

    # substr
    s = substr("SET:123", 4_i64, 3_i64);
    ASSERT s == "123", "substr extracts id";
    s2 = substr("hello world", 0_i64, 5_i64);
    ASSERT s2 == "hello", "substr from start";

    # toNumber and toInt
    n = toNumber("42.5") OR_ELSE 0.0;
    ASSERT n == 42.5, "toNumber parses float";
    bad = toNumber("not_a_number") OR_ELSE -1.0;
    ASSERT bad == -1.0, "toNumber OR_ELSE default";
    i = toInt(42.9);
    ASSERT i == 42_i64, "toInt truncates";
    hex = "7fff".toInt(16_i64) OR_ELSE -1_i64;
    ASSERT hex == 32767_i64, "toInt parses an explicit radix";
    binary = toInt("101010", 2_i64) OR_ELSE -1_i64;
    ASSERT binary == 42_i64, "function-form radix parsing remains available";
    badRadix = "10".toInt(1_i64) OR_ELSE -1_i64;
    ASSERT badRadix == -1_i64, "invalid radix is fallible";
    maxUInt = "ffffffffffffffff".toUInt(16_i64) OR_ELSE 0_u64;
    ASSERT maxUInt == 18446744073709551615_u64, "toUInt covers the full UInt64 domain";

    RETURN;
END
