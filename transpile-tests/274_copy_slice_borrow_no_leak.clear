FN consume(xs: Int64[]) RETURNS Int64 -> RETURN xs.length(); END

FN main() RETURNS Void ->
    MUTABLE lst: []Int64 = List[];
    lst.append(1_i64); lst.append(2_i64); lst.append(3_i64);

    n: Int64 = consume(COPY lst);
    ASSERT n == 3, "consume saw the deep-copied slice";

    m: Int64 = lst.length();
    ASSERT m == 3, "outer lst is unchanged after COPY";
END
