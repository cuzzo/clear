# Atomics M1.7: REQUIRES c: ATOMIC | LOCKED compiles, parses, and runs
# the LOCKED arm at runtime. The WHEN ATOMIC arm is shape-tested only
# (no body that exercises atomic methods) until typed atomic-method
# dispatch lands in a follow-up. Verifies:
#
#   1. The polymorphic REQUIRES disjunction parses.
#   2. The WITH MATCH per-arm prelude compiles (LOCKED acquires the
#      mutex, ATOMIC binds the cell ref).
#   3. The same fn body's LOCKED arm runs correctly.
#
# Note: full @shared:atomic dispatch through the polymorphic surface
# requires struct-atomic CAS-loop ops in CLEAR's surface and is tracked
# separately. M1's atomic surface is primitive-only (Int64, Float64,
# Bool); for the polymorphic ATOMIC family the body currently must be
# a no-op (or comment-only).

STRUCT Counter { value: Int64 }

FN bump_counter!(MUTABLE c: Counter) RETURNS Void
    REQUIRES c: ATOMIC | LOCKED
->
    WITH c AS va MATCH
        WHEN ATOMIC   -> { MUTABLE x: Int64 = 0; x = x + 1; }
        WHEN LOCKED -> { va.value = va.value + 1; }
    END
    RETURN;
END

FN main() RETURNS Void ->
    MUTABLE c_locked = Counter{ value: 0 } @locked;
    bump_counter!(c_locked);
    bump_counter!(c_locked);
    bump_counter!(c_locked);
    WITH EXCLUSIVE c_locked AS guard1 {
        ASSERT guard1.value == 3, "LOCKED arm: expected 3 after 3 bumps";
    }

    RETURN;
END
