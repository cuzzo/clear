# Test: indexOf — returns ?Int64 position of substring, nil if not found.

FN main() RETURNS Void ->
    # Basic: found at position
    pos = indexOf("hello world", "world") OR -1;
    ASSERT pos == 6, "indexOf should find 'world' at position 6";

    # Found at start
    pos0 = indexOf("abcdef", "abc") OR -1;
    ASSERT pos0 == 0, "indexOf should find 'abc' at position 0";

    # Not found: OR provides fallback
    missing = indexOf("hello", "xyz") OR -1;
    ASSERT missing == -1, "indexOf should return nil for missing substring";

    # Single character search
    comma = indexOf("a,b,c", ",") OR -1;
    ASSERT comma == 1, "indexOf should find ',' at position 1";

    # Empty needle: found at 0
    empty = indexOf("hello", "") OR -1;
    ASSERT empty == 0, "indexOf with empty needle should return 0";

    # Used with contains-like pattern
    has_it = indexOf("hello world", "world") OR -1;
    ASSERT has_it >= 0, "positive index means substring exists";

    RETURN;
END
