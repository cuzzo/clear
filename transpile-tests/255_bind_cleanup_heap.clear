# Tests: cleanup of heap-owning captures in WHILE bind and IF bind.
# Latent bug: WHILE pop() AS v where v contains heap-allocated data
#   → without fix, v's inner list leaks each iteration (no defer cleanup(v)).
# Incorrect implementation: IF call() AS v where v contains heap-allocated data
#   → without fix, v's inner list leaks at end of then-block.

STRUCT Container { vals: []Int64 }

FN make_container(n: Int64) RETURNS !Container ->
    MUTABLE vals: []Int64 = List[];
    &vals.append(n);
    RETURN Container{ vals: vals };
END

FN make_optional_container(n: Int64) RETURNS !?Container ->
    MUTABLE vals: []Int64 = List[];
    &vals.append(n);
    RETURN Container{ vals: vals };
END

# Test 1: WHILE pop() AS v where v is a struct with a list field.
# Each iteration, v.vals is a heap-allocated list that must be freed.
# Without fix: v.vals leaks on every iteration.
FN test_while_pop_heap_capture() RETURNS !Void ->
    MUTABLE pool: []Container = [];
    MUTABLE c1 = make_container(10);
    &pool.append(GIVE c1);
    MUTABLE c2 = make_container(20);
    &pool.append(GIVE c2);
    MUTABLE c3 = make_container(30);
    &pool.append(GIVE c3);

    MUTABLE count: Int64 = 0;
    WHILE &pool.pop() EXISTS AS c DO
        count = count + c.vals.length();
    END
    ASSERT count == 3_i64, "should pop 3 containers (one val each)";
    RETURN;
END

# Test 2: IF call() AS v where v is a struct with a list field.
# v.vals must be freed at end of the then-block.
# Without fix: v.vals leaks.
FN test_if_bind_heap_capture() RETURNS !Void ->
    MUTABLE got_it: Bool = FALSE;
    IF make_optional_container(42) EXISTS AS c THEN
        ASSERT c.vals.length() == 1_i64, "IF bind capture should have 1 element";
        got_it = TRUE;
    END
    ASSERT got_it == TRUE, "IF bind should have executed then-branch";
    RETURN;
END

FN main() RETURNS Void ->
    test_while_pop_heap_capture();
    test_if_bind_heap_capture();
    print("255: bind cleanup heap PASSED");
    RETURN;
END
