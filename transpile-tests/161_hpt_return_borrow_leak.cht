-- Test: __hpt cleanup must not be suppressed when value is borrowed in return.
-- Bug: RETURN f(g()) where g() returns union with heap data, f() borrows it.
-- The __hpt for g() gets _moved=true, suppressing cleanup. f() doesn't own
-- the Value, so the heap data leaks.

UNION Val {
    Nil,
    Str: String,
    Lambda { params: Val[], body: Val @indirect, envId: Int64 }
}

FN getStr(v: Val) RETURNS String ->
    MATCH v START
        Val.Str AS s -> RETURN s;,
        DEFAULT -> RETURN "nil";
    END
    RETURN "nil";
END

FN makeLambda!() RETURNS Val ->
    MUTABLE params: Val[]@list = List[];
    params.append(Val{ Str: "x" });
    RETURN Val.Lambda{ params: COPY params, body: Val{ Str: "body" }, envId: 0 };
END

FN extractStr!(v: Val) RETURNS String ->
    RETURN getStr(v);
END

-- This is the pattern from evalIn!: RETURN f(g()) where g returns heap union
FN leakyReturn!() RETURNS String ->
    RETURN extractStr!(makeLambda!());
END

FN main() RETURNS Void ->
    s = leakyReturn!();
    s2 = leakyReturn!();
    s3 = leakyReturn!();
    print("PASS");
END
