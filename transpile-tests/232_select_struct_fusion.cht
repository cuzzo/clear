-- Test: SELECT T{} struct literal works with pipeline fusion.
-- WHERE before SELECT filters on the raw iterator (efficient).
-- SELECT before fold/WHERE materializes via a temp var (valid Zig).
-- Zig prohibits StructType{...}.field inline in arithmetic/boolean contexts;
-- the compiler binds each SELECT result to a temp before further use.

STRUCT Raw     { id: Int64, score: Float64 }
STRUCT Summary { key: Int64, normalized: Float64 }

FN main() RETURNS Void ->
    raws: Raw[] = [
        Raw{ id: 1, score: 100.0 },
        Raw{ id: 2, score: 200.0 },
        Raw{ id: 3, score: 50.0 }
    ];

    -- WHERE before SELECT: filter on raw iterator, then project
    a = raws s> WHERE _.score > 75.0 s> SELECT Summary{ key: _.id, normalized: _.score / 100.0 };
    ASSERT a.length() == 2, "2 items pass score > 75";
    ASSERT a[0].key == 1, "first id is 1";
    ASSERT a[1].normalized == 2.0, "second normalized is 200/100";

    -- SELECT then SUM: project to struct, sum a field
    b = raws s> SELECT Summary{ key: _.id, normalized: _.score / 100.0 } s> SUM _.normalized;
    ASSERT b == 3.5, "100/100 + 200/100 + 50/100 = 3.5";

    -- WHERE -> SELECT -> SUM: filter raw, project, aggregate
    c = raws s> WHERE _.score > 75.0 s> SELECT Summary{ key: _.id, normalized: _.score / 100.0 } s> SUM _.normalized;
    ASSERT c == 3.0, "(100+200)/100 = 3.0";

    -- SELECT then WHERE: build struct first, filter on struct field
    d = raws s> SELECT Summary{ key: _.id, normalized: _.score / 100.0 } s> WHERE _.normalized > 0.75;
    ASSERT d.length() == 2, "1.0 and 2.0 pass; 0.5 fails";

    -- SELECT then COUNT
    e = raws s> SELECT Summary{ key: _.id, normalized: _.score / 100.0 } s> COUNT _.normalized > 0.75;
    ASSERT e == 2, "2 items have normalized > 0.75";

    -- SELECT then MIN/MAX
    mn = raws s> SELECT Summary{ key: _.id, normalized: _.score / 100.0 } s> MIN _.normalized;
    ASSERT mn == 0.5, "min normalized is 50/100";
    mx = raws s> SELECT Summary{ key: _.id, normalized: _.score / 100.0 } s> MAX _.normalized;
    ASSERT mx == 2.0, "max normalized is 200/100";

    print("OK");
    RETURN;
END
