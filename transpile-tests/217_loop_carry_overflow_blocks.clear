# Test: heap carry string with allocations large enough to force overflow blocks.
#
# The static frame block is 4 KB. This test allocates ~200 strings per inner
# iteration (each a few bytes), totalling ~1-2 KB per inner pass. After a few
# inner iterations the static block fills and CheatArena allocates an overflow
# block from the heap.
#
# When restoreLoopMark calls rewind (softRewind + trimExcess), trimExcess frees
# overflow blocks allocated after the saved mark. For the OUTER loop mark this
# means freeing ALL overflow blocks, including ones allocated INSIDE the outer
# loop body. If an inner mark references a block index pointing into freed
# memory the next trimExcess call corrupts the GPA free list.
#
# After fixing restoreLoopMark to use softRewind only (no trimExcess), overflow
# blocks are kept alive until restoreFrameMark fires at function exit, and the
# block-index arithmetic in getMark/trimExcess is never invoked per-iteration.

FN heavyInner(outer: Int64) RETURNS !Void ->
    MUTABLE resp = "";
    MUTABLE i: Int64 = 0;
    WHILE i < 8 DO
        # Allocate many small strings on the frame; after ~20 iterations of the
        # outer caller this should exhaust the 4 KB static block and create
        # at least one overflow block per inner loop pass.
        MUTABLE parts: []String = [];
        MUTABLE k: Int64 = 0;
        WHILE k < 150 DO
            &parts.append(k.toString());
            k += 1;
        END
        resp = resp $+ i.toString() $+ ",";
        i += 1;
    END
    ASSERT resp == "0,1,2,3,4,5,6,7,", "wrong result";
    RETURN;
END

FN main() RETURNS !Void ->
    # 50 outer iterations.  Each calls heavyInner! which exercises the doubly-
    # nested rewind path with overflow blocks.
    MUTABLE outer: Int64 = 0;
    WHILE outer < 50 DO
        heavyInner(outer) OR_ELSE EXIT;
        outer += 1;
    END
    print("PASS");
    RETURN;
END
