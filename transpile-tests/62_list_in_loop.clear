# Test: buildList + writeFile in a loop inside a BG fiber.
# Verifies file I/O works on standard (16KB) fiber stacks
# after posix-based writeFile/readFile rewrite.

FN buildList(n: Int64) RETURNS !String ->
    MUTABLE parts: []String = [];
    FOR i IN (1_i64 ..= n) -> &parts.append(i.toString());
    RETURN join(parts, ",");
END

FN doWork() RETURNS !Void ->
    MUTABLE i: Int64 = 1;
    WHILE i <= 10 DO
        result = buildList(i * 5_i64);
        writeFile("testdata/write_test_output.txt", result);
        i += 1;
    END
END

FN main() RETURNS Void ->
    p: ~Void = BG { doWork(); };
    NEXT p;
    content = readFile("testdata/write_test_output.txt");
    ASSERT content.length() > 0_i64, "file written from fiber";
    RETURN;
END
