# Test: Struct literal with @list field moves ArrayList directly
# Verifies that Node{ keys: someList } passes the ArrayList struct
# rather than converting to a slice via .items.

STRUCT Node { keys: []Int64 }

FN main() RETURNS Void ->
    # Build a list and move it into a struct
    MUTABLE keys: []Int64 = [];
    keys.append(10);
    keys.append(20);
    keys.append(30);

    MUTABLE nodes: []Node = [];
    nodes.append(Node{ keys: keys });

    ASSERT nodes[0]?.keys.length() == 3, "node has 3 keys";
    ASSERT nodes[0]?.keys[0] == 10, "key 0 is 10";
    ASSERT nodes[0]?.keys[1] == 20, "key 1 is 20";
    ASSERT nodes[0]?.keys[2] == 30, "key 2 is 30";

    # Build a second node with fresh keys
    MUTABLE keys2: []Int64 = [];
    keys2.append(40);
    keys2.append(50);
    nodes.append(Node{ keys: keys2 });

    ASSERT nodes[1]?.keys.length() == 2, "node 1 has 2 keys";
    ASSERT nodes[1]?.keys[0] == 40, "node 1 key 0 is 40";

    print("168: struct list field move PASSED");
END
