# require_types_helper.clear -- used by 51_require_types.clear
# Tests that STRUCT, UNION, and ENUM types are importable across REQUIRE.

PUB STRUCT Point { x: Float64, y: Float64 }

PUB ENUM Color { Red, Green, Blue }

PUB UNION Result { Ok: Float64, Err: String }

PUB FN makePoint(x: Float64, y: Float64) RETURNS Point ->
    RETURN Point{ x: x, y: y };
END

# PRIVATE types should NOT be importable.
PRIVATE STRUCT Secret { code: Float64 }
