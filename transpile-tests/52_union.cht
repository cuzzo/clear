UNION Shape { Circle: Float64, Rectangle: Float64, Point }
UNION Result { Ok: Float64, Err: Float64, Empty }

FN area(s: Shape) RETURNS Float64 ->
  MUTABLE a = 0.0;
  MATCH s START
    Shape.Circle    -> a = 3.14;,
    Shape.Rectangle -> a = 4.0;,
    Shape.Point     -> a = 0.0;
  END
  RETURN a;
END

FN main() RETURNS Void ->
  -- Unit variant (GetField syntax — no payload)
  p: Shape = Shape.Point;
  a = area(p);
  ASSERT a == 0.0, "Union: unit variant Point has area 0";

  -- Payload variant (StructLit syntax — same as structs)
  c: Shape = Shape{ Circle: 5.0 };
  MUTABLE result = 0.0;
  MATCH c START
    Shape.Circle    -> result = 1.0;,
    Shape.Rectangle -> result = 2.0;,
    Shape.Point     -> result = 3.0;
  END
  ASSERT result == 1.0, "Union: Circle variant matches correctly";

  -- Result-style union (Ok path)
  r: Result = Result{ Ok: 42.0 };
  MUTABLE got = 0.0;
  MATCH r START
    Result.Ok    -> got = 1.0;,
    Result.Err   -> got = 2.0;,
    Result.Empty -> got = 3.0;
  END
  ASSERT got == 1.0, "Union: Result.Ok matches";

  -- Result-style union (Err path)
  e: Result = Result{ Err: 99.0 };
  MUTABLE got2 = 0.0;
  MATCH e START
    Result.Ok  -> got2 = 1.0;,
    Result.Err -> got2 = 2.0;,
    DEFAULT    -> got2 = 0.0;
  END
  ASSERT got2 == 2.0, "Union: Result.Err matches";
END
