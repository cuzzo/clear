# Regression: `_ = <owned/cleanup-bearing expr>;` discard. The discard
# placeholder `_` is not a valid Zig binding identifier -- the lowering
# used to emit `const _ = expr; _ = &_; defer cleanup(&_)` which Zig
# rejects ("'_' used as an identifier without @\"_\" syntax"). A
# discarded owned value must still be cleaned up (no leak), so it is
# bound to a unique synthetic temp. Covers an owned @list and an owned
# struct-with-@list-field; the leak-detecting harness proves the duped
# value is freed exactly once.
FN mkList() RETURNS !Int64[]@list ->
    MUTABLE xs: Int64[]@list = List[];
    xs.append(7_i64);
    RETURN GIVE xs;
END

STRUCT Bag { items: Int64[]@list }

FN mkBag() RETURNS !Bag ->
    MUTABLE ys: Int64[]@list = List[];
    ys.append(9_i64);
    RETURN Bag{ items: GIVE ys };
END

FN run() RETURNS !Void ->
    # Discarded owned values: must compile to a real temp AND be freed.
    _ = mkList() OR RAISE;
    _ = mkBag() OR RAISE;
    # The same functions, bound, prove they actually produce the values
    # (the discard path must not corrupt or alter behavior).
    keep: Int64[]@list = mkList() OR RAISE;
    bag: Bag = mkBag() OR RAISE;
    ASSERT length(keep) == 1_i64, "discard path leaves mkList correct";
    ASSERT length(bag.items) == 1_i64, "discard path leaves mkBag correct";
    RETURN;
END

FN main() RETURNS Void ->
    run() OR PASS;
    RETURN;
END
