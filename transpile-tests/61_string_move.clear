# String move semantics: strings are affine (like Rust's String).
# Assignment moves ownership. Use after move is a compiler error.

FN identity(s: String) RETURNS String ->
    RETURN s;
END

FN main() RETURNS Void ->
    # Move to new binding
    x = "hello";
    y = x;
    ASSERT y == "hello", "moved string retains value";

    # Move through function call and return
    a = identity("world");
    ASSERT a == "world", "string survives function round-trip";

    # String built from concat moves correctly
    b = "foo" + "bar";
    c = b;
    ASSERT c == "foobar", "concat result moves";

    # Multiple independent strings
    s1 = "one";
    s2 = "two";
    ASSERT s1 == "one", "independent string 1";
    ASSERT s2 == "two", "independent string 2";

    RETURN;
END
