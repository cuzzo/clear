# Test: LINK/RESOLVE -- weak references

STRUCT Node { value: Int64 }

# Test 1: @multiowned weak ref (WeakRc)
FN test_multiowned() RETURNS !Void ->
    x = Node{ value: 42 } @multiowned;
    w = LINK x;

    resolved = RESOLVE w;
    ASSERT resolved != NIL, "weak ref should resolve while strong ref exists";

    RETURN;
END

# Test 2: @shared weak ref (WeakArc)
FN test_shared() RETURNS !Void ->
    x = Node{ value: 10 } @shared;
    w = LINK x;

    resolved = RESOLVE w;
    ASSERT resolved != NIL, "shared weak ref should resolve while strong ref exists";

    RETURN;
END

# Test 3: @link stored in a struct field
STRUCT Edge {
    target: Node@link
}

FN test_link_in_struct() RETURNS !Void ->
    n = Node{ value: 99 } @multiowned;
    e = Edge{ target: LINK n };

    resolved = RESOLVE e.target;
    ASSERT resolved != NIL, "weak ref in struct field should resolve";

    RETURN;
END

# Test 4: multiple weak refs to the same node
FN test_multiple_links() RETURNS !Void ->
    n = Node{ value: 7 } @multiowned;
    w1 = LINK n;
    w2 = LINK n;

    r1 = RESOLVE w1;
    r2 = RESOLVE w2;
    ASSERT r1 != NIL, "first weak ref should resolve";
    ASSERT r2 != NIL, "second weak ref should resolve";

    RETURN;
END

# Test 5: field access on resolved ?T@multiowned (safe nav)
FN makeDeadWeakNode() RETURNS !Node@link ->
    n = Node{ value: 999 } @multiowned;
    RETURN LINK n;
END

FN test_safe_field_access() RETURNS !Void ->
    # Strong ref alive: resolved?.field returns the field value
    n = Node{ value: 42 } @multiowned;
    w = LINK n;
    resolved = RESOLVE w;
    val = resolved?.value OR_ELSE -1_i64;
    ASSERT val == 42_i64, "field access on live ref";

    # Dropped: fallback triggers
    dead_w = makeDeadWeakNode();
    dead_r = RESOLVE dead_w;
    dead_val = dead_r?.value OR_ELSE -1_i64;
    ASSERT dead_val == -1_i64, "field access on dropped ref";

    RETURN;
END

# Test 6: IF RESOLVE x AS y optional binding
FN test_if_resolve_bind() RETURNS !Void ->
    x = Node{ value: 100 } @multiowned;
    w = LINK x;

    MUTABLE found = 0_i64;
    IF RESOLVE w EXISTS AS r THEN
        found = r.value;
    END
    ASSERT found == 100_i64, "IF RESOLVE AS should bind the resolved value";

    RETURN;
END

FN main() RETURNS Void ->
    test_multiowned();
    test_shared();
    test_link_in_struct();
    test_multiple_links();
    test_safe_field_access();
    test_if_resolve_bind();
    RETURN;
END
