# Test: RETURN f(g()) where g() returns union with heap data, f() borrows it.
# Fix: f() must COPY extracted string fields before returning; caller must use
# named binding for g() so its cleanup is a regular defer (not errdefer).

UNION Val {
    Nil,
    Str: String,
    Lambda { params: Val[], body: Val @boxed, envId: Int64 }
}

FN getStr(v: Val) RETURNS !String ->
    PARTIAL MATCH v START
        Val.Str AS s -> RETURN COPY s;,
        DEFAULT -> RETURN COPY "nil";
    END
    RETURN COPY "nil";
END

FN makeLambda() RETURNS !Val ->
    MUTABLE params: []Val = List[];
    &params.append(Val{ Str: "x" });
    RETURN Val.Lambda{ params: COPY params, body: Val{ Str: "body" }, envId: 0 };
END

FN extractStr(v: Val) RETURNS !String ->
    RETURN getStr(v);
END

# Named binding ensures makeLambda()'s cleanup is a regular defer, not errdefer.
# getStr copies the extracted string, so it survives when v is freed.
FN safeReturn() RETURNS !String ->
    v = TRY makeLambda();
    RETURN extractStr(v);
END

FN main() RETURNS Void ->
    s = TRY safeReturn();
    s2 = TRY safeReturn();
    s3 = TRY safeReturn();
    # A Lambda is not a Str, so getStr falls through to DEFAULT.
    ASSERT s == "nil";
    ASSERT s2 == "nil";
    ASSERT s3 == "nil";
END
