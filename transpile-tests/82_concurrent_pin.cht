-- Test: CONCURRENT SELECT with parallel: TRUE — dispatches to least-loaded scheduler
STRUCT Work { value: Float64 }

FN compute(w: Work) RETURNS Float64 ->
    RETURN w.value * 3.0;
END

FN main() RETURNS Void ->
    items = [Work{value: 1.0}, Work{value: 2.0}, Work{value: 3.0}];
    results = items s> CONCURRENT(workers: 2, parallel: TRUE) SELECT compute(_);
    total = results s> SUM _;
    ASSERT total == 18.0, "parallel: TRUE should still produce correct results";
    RETURN;
END
