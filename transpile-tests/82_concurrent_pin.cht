-- Test: CONCURRENT SELECT with pin: true — dispatches to least-loaded scheduler
STRUCT Work { value: Number }

FN compute(w: Work) RETURNS Number ->
    RETURN w.value * 3.0;
END

FN cheatMain() RETURNS Void ->
    items: Work[] = [Work{value: 1.0}, Work{value: 2.0}, Work{value: 3.0}];
    results = items s> CONCURRENT(pool_size: 2, pin: true) SELECT compute(_);
    total = results s> SUM _;
    ASSERT total == 18.0, "pin: true should still produce correct results";
    RETURN;
END
