# Regression test: values()/keys() on a sharded map used inline as a pipeline
# source must not leak. Before the fix, the heap ArrayListUnmanaged returned by
# values() was never freed when used directly in a CONCURRENT pipeline expression.

FN main() RETURNS Void ->
    MUTABLE counts: HashMap<String, Int64>@sharded(4) = {};
    n = 20_i64;
    FOR i IN (0_i64 ..< n) DO
        k = i.toString();
        counts[k] = (counts[k] OR 0_i64) + 1_i64;
    END

    # Inline values() as pipeline source for each CONCURRENT op variant.
    # If any of these leak, the leak detector will fail the test.
    total   = counts.values() |> CONCURRENT SUM toFloat(_);
    highest = counts.values() |> CONCURRENT MAX toFloat(_);
    lowest  = counts.values() |> CONCURRENT MIN toFloat(_);
    average = counts.values() |> CONCURRENT AVERAGE toFloat(_);

    ASSERT total   == toFloat(n), "sum mismatch";
    ASSERT highest == 1.0,        "max should be 1";
    ASSERT lowest  == 1.0,        "min should be 1";
    ASSERT average == 1.0,        "avg should be 1";

    # Also test numeric-keyed sharded map inline values().
    MUTABLE ncounts: HashMap<Int64, Int64>@sharded(4) = {};
    FOR j IN (0_i64 ..< n) DO
        ncounts[j] = (ncounts[j] OR 0_i64) + 1_i64;
    END

    ntotal = ncounts.values() |> CONCURRENT SUM toFloat(_);
    ASSERT ntotal == toFloat(n), "numeric sum mismatch";

    print("ok");
END
