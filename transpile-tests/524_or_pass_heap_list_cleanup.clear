# Regression: a heap-owned @list returned from a fallible function through
# OR PASS must be cleaned with the heap allocator in the receiving binding.
FN inner() RETURNS !Int64[]@list ->
    MUTABLE v: Int64[]@list = [];
    v.append(1_i64);
    RETURN v;
END

FN run() RETURNS !Void ->
    result: Int64[]@list = inner() OR PASS;
    ASSERT length(result) == 1_i64, "OR PASS returned list length";
    RETURN;
END

FN main() RETURNS Void ->
    run() OR PASS;
    RETURN;
END
