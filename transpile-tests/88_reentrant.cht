# 88_reentrant.cht — reentrance capability tests
#
# EFFECTS REENTRANT — function is designed to call itself recursively.
# REQUIRES cb: NON_REENTRANT — callback parameter rejects plain
#                              reentrant functions.

# Direct recursion: must declare EFFECTS REENTRANT.
FN fib(n: Int64) RETURNS Int64 EFFECTS REENTRANT ->
  IF n <= 1 THEN
    RETURN n;
  END
  RETURN fib(n - 1) + fib(n - 2);
END

# This callback parameter explicitly rejects plain reentrant functions.
FN apply(cb: FN(Int64) -> Int64, x: Int64) RETURNS !Int64
  REQUIRES cb: NON_REENTRANT ->
  RETURN cb(x);
END

# applyReentrant explicitly opts in to accepting plain reentrant callbacks.
FN applyReentrant(cb: FN(Int64) -> Int64, x: Int64) RETURNS !Int64
  EFFECTS REENTRANT ->
  RETURN cb(x);
END

FN double(x: Int64) RETURNS Int64 ->
  RETURN x * 2;
END

FN main() RETURNS Void ->
  ASSERT fib(10) == 55;
  result: Int64 = apply(double, 7);
  ASSERT result == 14;
  # fib is plain reentrant, so it can only be passed to reentrant-accepting params.
  r2: Int64 = applyReentrant(fib, 6);
  ASSERT r2 == 8;
END
