# Test: promoteFields follows through @boxed pointers.
# A function returns a union with an @boxed field containing a frame-allocated
# string. promoteFields must promote the string through the *T pointer to heap.

UNION Value {
    Nil, Str: String,
    Wrapped { inner: String @boxed },
    Error { errMsg: String, errKind: String },
}

FN handleCatch!(msg: String, kind: String) RETURNS !Value ->
    RETURN Value.Wrapped{ inner: "caught:" $+ msg $+ ":" $+ kind };
END

FN tryEval!(TAKES input: Value) RETURNS !Value ->
    PARTIAL MATCH input START
        Value.Error AS e ->
            RETURN handleCatch!(e.errMsg, e.errKind);,
        DEFAULT -> RETURN input;
    END
    RETURN Value.Nil;
END

FN prStr(v: Value) RETURNS !String ->
    PARTIAL MATCH v START
        Value.Nil -> RETURN "nil";,
        Value.Str AS s -> RETURN COPY s;,
        Value.Wrapped AS w -> RETURN COPY w.inner;,
        Value.Error AS e -> RETURN "error:" $+ e.errMsg;
    END
    RETURN "";
END

FN main() RETURNS Void ->
    err = Value.Error{ errMsg: "x", errKind: "E" };
    result = tryEval!(COPY err);
    str = prStr(result);
    ASSERT str == "caught:x:E", "indirect string promoted through pointer";

    ok = Value{ Str: "hello" };
    result2 = tryEval!(COPY ok);
    str2 = prStr(result2);
    ASSERT str2 == "hello", "non-error passthrough";

    print("174: union indirect promotion PASSED");
END
