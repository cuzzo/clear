# Regression from examples/mal:
# A recursive union with an @indirect payload is copied out of a lambda-like
# variant into a TCO-like variant. This is the MAL closure body path.

UNION Value {
    Nil,
    Str: String,
    Symbol: String,
    List: Value[],
    Lambda { params: Value[], body: Value @indirect },
    Tco { ast: Value @indirect }
}

STRUCT Env {
    vars: {String}Value
}

FN forceTco!(f: Value) RETURNS !Value ->
    PARTIAL MATCH f START
        Value.Lambda AS lam -> RETURN Value.Tco{ ast: lam.body };,
        DEFAULT -> RETURN Value.Nil;
    END
    RETURN Value.Nil;
END

FN unwrapTco!(f: Value) RETURNS !Value ->
    result = forceTco!(f) OR_ELSE RAISE;
    PARTIAL MATCH result START
        Value.Tco AS tco ->
            ast = COPY tco.ast;
            RETURN ast;,
        DEFAULT -> RETURN result;
    END
    RETURN Value.Nil;
END

FN main() RETURNS Void ->
    bodyText = "lambda-" $+ "body";
    MUTABLE params: []Value = [];
    params.append(Value{ Symbol: COPY "x" });
    MUTABLE bodyItems: []Value = [];
    bodyItems.append(Value{ Symbol: COPY "identity" });
    bodyItems.append(Value{ Str: COPY bodyText });

    MUTABLE pool: [Pool(8)]Env = [];
    envId: Id<Env> = pool.insert(Env{ vars: {} });
    IF pool[envId] EXISTS AS env THEN
        env.vars["f"] = Value.Lambda{ params: COPY params, body: Value{ List: bodyItems } };
    END
    MUTABLE lambda = Value.Nil;
    IF pool[envId] EXISTS AS env2 THEN
        lambda = env2.vars["f"] OR_ELSE Value.Nil;
    END

    ast = unwrapTco!(lambda) OR_ELSE RAISE;
    PARTIAL MATCH ast START
        Value.List AS items ->
            ASSERT items.length() == 2, "lambda body should survive TCO unwrap";,
        DEFAULT -> ASSERT FALSE, "lambda should match";
    END
    RETURN;
END
