-- Comprehensive COPY tests: verify COPY works on all types without leaks.

UNION Value { Nil, Number: Float64, Str: String, List: Value[] }

FN main() RETURNS Void ->
    -- COPY string: heap-dupes, both copies independent
    s = "hello";
    s2 = COPY s;
    ASSERT s == "hello", "string original";
    ASSERT s2 == "hello", "string copy";

    -- COPY union with string payload
    v = Value{ Str: COPY "world" };
    v2 = COPY v;

    -- COPY union with number (trivial)
    n = Value{ Number: 42.0 };
    n2 = COPY n;

    -- COPY into function argument
    MUTABLE list: Value[]@list = List[];
    list.append(COPY v);
    list.append(COPY n);
    ASSERT list.length() == 2, "list has 2";

    -- COPY from container index into binding
    item = COPY list[0];

    -- COPY in return position (tested by makeStr)
    result = makeStr("test");

    RETURN;
END

FN makeStr(s: String) RETURNS !Value ->
    RETURN Value{ Str: COPY s };
END
