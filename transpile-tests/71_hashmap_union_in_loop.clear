# HashMap storing union values with strings inside a WHILE loop.
# The loop's restoreLoopMark rewinds the arena, destroying frame-allocated
# strings. The runtime's StringMap.put must heap-dupe string payloads
# inside tagged union values to prevent dangling pointers.

UNION Value { Nil, Str: String, Num: Float64 }

FN main() RETURNS Void ->
    MUTABLE map: {String}Value = {};
    data: String[] = ["alpha", "beta", "gamma"];

    # Store strings from loop iterations into the hashmap
    MUTABLE i: Int64 = 0;
    WHILE i < data.length() DO
        key = "k" $+ i.toString();
        map[key] = Value{ Str: COPY data[i] };
        i += 1;
    END

    # Verify values survive the loop's arena rewind
    v0 = map["k0"] OR_ELSE Value.Nil;
    v1 = map["k1"] OR_ELSE Value.Nil;
    v2 = map["k2"] OR_ELSE Value.Nil;

    PARTIAL MATCH v0 START Value.Str AS s -> ASSERT s == "alpha", "k0 == alpha";, DEFAULT -> ASSERT FALSE, "k0 missing"; END
    PARTIAL MATCH v1 START Value.Str AS s -> ASSERT s == "beta", "k1 == beta";, DEFAULT -> ASSERT FALSE, "k1 missing"; END
    PARTIAL MATCH v2 START Value.Str AS s -> ASSERT s == "gamma", "k2 == gamma";, DEFAULT -> ASSERT FALSE, "k2 missing"; END

    RETURN;
END
