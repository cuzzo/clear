# Thunk Phase 4f.3 -- :MAX_DEPTH(N) compiles in a per-fn depth
# counter. Calls within the bound return normally; the counter
# is decremented on exit (defer), so independent call paths
# don't accumulate.
#
# This test exercises the OK path (call depth always = 1). The
# error path is a runtime trap covered by the safety unit tests
# in zig/runtime/.

FN bounded(n: Int64) RETURNS !Int64
  EFFECTS REENTRANT:MAX_DEPTH(8) ->
  RETURN n + 1;
END

FN main() RETURNS Void ->
  # Many independent calls -- each enters/exits, depth back to 0
  # between them.
  MUTABLE total: Int64 = 0;
  MUTABLE i: Int64 = 0;
  WHILE i < 100 DO
    v: Int64 = bounded(i) OR_ELSE EXIT System, "bounded failed";
    total = total + v;
    i = i + 1;
  END
  # sum of (i+1) for i in 0..99 = 100*101/2 = 5050
  ASSERT total == 5050_i64, "total == 5050";
  RETURN;
END
