# Test: multiple outer strings preserved across loop iterations.
# When loop_preserve_vars has >1 variable, each loopPreserveAndRewind
# rewinds to the same mark, causing all strings to alias the same memory.
# The second preserve overwrites the first; the third overwrites both.
# Fix: first call rewinds; subsequent calls copy sequentially (no rewind).

FN main() RETURNS Void ->
    MUTABLE a = "";
    MUTABLE b = "";
    MUTABLE c = "";
    FOR i IN (1_i64 ..= 5) DO
        # frame-local forces mark_per_iter
        tmp = i.toString();
        # all three get frame-allocated strings each iteration
        a = "A" + tmp;
        b = "BB" + tmp;
        c = "CCC" + tmp;
    END
    # If preserve is broken, a/b/c all alias the same memory
    # and will show the last-written value ("CCC5"), or garbage.
    ASSERT a == "A5",   "a corrupted";
    ASSERT b == "BB5",  "b corrupted";
    ASSERT c == "CCC5", "c corrupted";
    print("PASS");
    RETURN;
END
