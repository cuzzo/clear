# Regression from examples/mal:
# A borrowed parameter copied into a map must not leak when the caller passes a
# freshly allocated union/string payload.

UNION Value {
    Nil,
    Str: String
}

FN storeCopy!(name: String, val: Value, MUTABLE map: HashMap<Value>) RETURNS !Void ->
    map[name] = COPY val;
    RETURN;
END

FN main() RETURNS !Void ->
    MUTABLE map: HashMap<Value> = {};
    payload = "owned-" + "payload";

    storeCopy!("out", Value{ Str: COPY payload }, map) OR_ELSE RAISE;
    got = map["out"] OR_ELSE Value.Nil;

    PARTIAL MATCH got START
        Value.Str AS s -> ASSERT s == "owned-payload", "stored copy should preserve payload";,
        DEFAULT -> ASSERT FALSE, "stored value should be a string";
    END
    RETURN;
END
