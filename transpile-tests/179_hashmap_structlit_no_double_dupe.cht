-- Test: HashMap put with struct literal value containing COPY'd fields
-- must not double-dupe. The struct literal is freshly constructed (owned),
-- so the HashMap dupe guard should skip it.

UNION Value { Nil, Str: String, Number: Float64 }

FN getStr(v: Value) RETURNS String ->
    MATCH v START
        Value.Str AS s -> RETURN s;,
        DEFAULT -> RETURN "";
    END
    RETURN "";
END

FN main() RETURNS Void ->
    MUTABLE env: HashMap<Value> = {};
    s = "hello";

    -- Struct literal with COPY: the COPY already dupes to heap.
    -- HashMap put must NOT wrap this in another dupeUnionValue.
    env["a"] = Value{ Str: COPY s };
    env["b"] = Value{ Str: COPY s };
    env["c"] = Value{ Number: 42.0 };

    ASSERT getStr(env["a"] OR Value.Nil) == "hello", "a";
    ASSERT getStr(env["b"] OR Value.Nil) == "hello", "b";

    print("179: hashmap structlit no double dupe PASSED");
END
