STRUCT Item { category: String[], value: Int64 }

FN cheatMain() RETURNS Void ->
  VAR items = %[
    Item{ category: %"fruit", value: 10_i64 },
    Item{ category: %"veggie", value: 20_i64 },
    Item{ category: %"fruit", value: 30_i64 }
  ];

  -- INDEX: Group items by category
  VAR grouped = items s> INDEX _.category;

  -- Verify grouping
  VAR fruits = grouped["fruit"];
  VAR veggies = grouped["veggie"];

  ASSERT fruits.length() == 2, "Should have 2 fruits";
  ASSERT veggies.length() == 1, "Should have 1 veggie";

  ASSERT fruits[0].value == 10, "First fruit value should be 10";
  ASSERT fruits[1].value == 30, "Second fruit value should be 30";
  ASSERT veggies[0].value == 20, "Veggie value should be 20";
END
