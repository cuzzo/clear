# Test: WHILE expr AS y optional binding

STRUCT Node { val: Int64 }

# Test 1: WHILE list.pop() AS item -- drain a list
FN test_pop_drain() RETURNS !Void ->
    MUTABLE items: Int64[5]@list = [];
    items.append(1_i64);
    items.append(2_i64);
    items.append(3_i64);

    MUTABLE sum = 0_i64;
    WHILE items.pop() EXISTS AS v DO
        sum = sum + v;
    END
    ASSERT sum == 6_i64, "pop drain: sum should be 6";
    ASSERT items.length() == 0_i64, "list should be empty after drain";
    RETURN;
END

# Test 3: WHILE RESOLVE link AS y -- linked-list traversal via @link
FN test_resolve_traversal() RETURNS !Void ->
    n1 = Node{ val: 10 } @multiowned;
    n2 = Node{ val: 20 } @multiowned;
    n3 = Node{ val: 30 } @multiowned;

    # Build a chain: link -> n1 -> n2 -> n3 (via LINK reassignment each iter)
    MUTABLE links: Node@link[3]@list = [];
    links.append(LINK n1);
    links.append(LINK n2);
    links.append(LINK n3);

    MUTABLE sum = 0_i64;
    MUTABLE i: Int64 = 0;
    WHILE i < 3 DO
        IF links[i] EXISTS AS link THEN
            IF RESOLVE link EXISTS AS node THEN
                sum = sum + node.val;
            END
        END
        i = i + 1;
    END
    ASSERT sum == 60_i64, "resolve traversal: sum should be 60";
    RETURN;
END

# Test 4: WHILE RESOLVE link AS y -- terminates when strong ref drops
FN makeWeakNode() RETURNS !Node@link ->
    n = Node{ val: 42 } @multiowned;
    RETURN LINK n;
END

FN test_resolve_terminates() RETURNS !Void ->
    live = Node{ val: 77 } @multiowned;
    w = LINK live;

    MUTABLE found = 0_i64;
    MUTABLE iters = 0_i64;
    WHILE RESOLVE w EXISTS AS node DO
        found = node.val;
        iters = iters + 1;
        BREAK;
    END
    ASSERT found == 77_i64, "resolved live node";
    ASSERT iters == 1_i64, "exactly one iteration";

    dead_w = makeWeakNode();
    MUTABLE dead_iters = 0_i64;
    WHILE RESOLVE dead_w EXISTS AS node DO
        dead_iters = dead_iters + 1;
    END
    ASSERT dead_iters == 0_i64, "dead ref: loop never runs";
    RETURN;
END

FN main() RETURNS Void ->
    test_pop_drain();
    test_resolve_traversal();
    test_resolve_terminates();
    print("253: WHILE bind PASSED");
    RETURN;
END
