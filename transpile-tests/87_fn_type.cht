-- Phase 1: First-class function types.
--
-- FN(T, ...) -> R is a function-pointer type. Variables may be declared with
-- this annotation and assigned a lambda literal.  Calling through fn-type
-- variables is Phase 3; this test only exercises declaration + storage.

FN isPositive(n: Int64) RETURNS Bool ->
  RETURN n > 0;
END

FN cheatMain() RETURNS Void ->
  -- Declare a fn-type variable and assign a typed lambda.
  cb: FN(Int64) -> Bool = %(n: Int64) -> n > 0;

  -- A multi-param fn type.
  add: FN(Int64, Int64) -> Int64 = %(a: Int64, b: Int64) -> a + b;

  -- Smoke test: verify unrelated logic still works.
  ASSERT isPositive(5) == TRUE;
  ASSERT isPositive(-1) == FALSE;
END
