FN main() RETURNS Void ->
  raw_data = readFile("testdata/fruits.csv").trim();

  # 1. Split into List
  MUTABLE parts = raw_data.split(",");

  ASSERT parts.length() == 3, "Should have 3 parts";

  # 2. Modify
  &parts.append("date");
  ASSERT parts.length() == 4, "Should have 4 parts after append";

  # 3. Join back together
  new_csv = join(parts, " | ");

  # Verify join result length (apple=5 + banana=6 + cherry=6 + date=4 + 3 separators*3 = 30)
  ASSERT new_csv.length() == 30, "Joined string should have correct length";
END
