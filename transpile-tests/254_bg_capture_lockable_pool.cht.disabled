-- Repro: BG block captures a Pool parameter (a needs_pointer_passing
-- collection) that arrived via REQUIRES LOCKABLE from a caller's
-- @shared:locked binding. The exact pattern used by _bc_runner.cht's
-- exec! when BG_SPAWN spawns a real fiber.
--
-- The TYPE-MISMATCH compiler bug is fixed (BG capture fields now use
-- @TypeOf(name)). This test transpiles and runs; the assertions PASS.
--
-- DISABLED because the test leaks 2 allocations (Pool + inserted Item).
-- The Arc-wrapped pool captured by the fiber's ctx never has its Arc
-- count bumped/released -- CaptureStrategy classifies the capture as
-- RcClone but mir_lowering's BG codegen doesn't actually emit retain
-- on capture or release on fiber completion. The Pool's contents leak
-- because nobody owns the deinit.
--
-- Re-enable once BG capture of Arc/Rc-wrapped values wires through
-- proper retain (at ctx-init) + release (at ctx-destroy).

STRUCT Item { value: Int64 }

FN spawnPool!(MUTABLE p: Item[100]@pool) RETURNS Int64
  REQUIRES p: LOCKABLE
->
    bgFut: ~Int64 = BG {
        WITH EXCLUSIVE p AS pInner {
            myId = pInner.insert(Item{ value: 42 });
        }
        7_i64;
    };
    r = NEXT bgFut;
    RETURN r;
END

FN main() RETURNS Void ->
    MUTABLE p: Item[100]@pool:shared:locked = [];
    r = spawnPool!(p);
    ASSERT r == 7, "BG fiber returns its value";
END
