FN label(n: Int64) RETURNS String ->
  RETURN PARTIAL MATCH n START
    1 -> "one",
    2 -> "two",
    DEFAULT -> "other"
  END;
END

FN score(n: Int64) RETURNS Int64 ->
  RETURN PARTIAL MATCH n START
    1 -> 100,
    2 -> 200,
    DEFAULT -> 0
  END;
END

FN main() RETURNS Void ->
  n = 2;
  x = PARTIAL MATCH n START
    1 -> "one",
    2 -> "two",
    DEFAULT -> "other"
  END;
  ASSERT x == "two";
  ASSERT label(1) == "one";
  ASSERT label(3) == "other";
  ASSERT score(2) == 200;
  ASSERT score(9) == 0;
  RETURN;
END
