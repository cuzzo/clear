# Test: IF x AS y optional binding syntax

FN main() RETURNS Void ->
    # Test 1: single bind, found case
    str = "hello world";
    MUTABLE found_pos: Int64 = -1;
    IF str.indexOf("world") AS pos THEN
        found_pos = pos;
    END
    ASSERT found_pos == 6_i64, "indexOf found at 6";

    # Test 2: single bind, nil case (else branch taken)
    MUTABLE hit: Bool = FALSE;
    IF str.indexOf("xyz") AS pos THEN
        hit = TRUE;
        found_pos = pos;
    ELSE
        hit = FALSE;
    END
    ASSERT hit == FALSE, "xyz not found: else branch taken";

    print("251: IF bind PASSED");
    RETURN;
END
