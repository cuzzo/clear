-- Error context: RAISE with kind, OR EXIT, RECOVER, CATCH blocks.

FN riskyParse(input: String) RETURNS !String ->
    IF input == "bad" THEN
        RAISE Input, InvalidJson, "failed to parse";
    END
    RETURN "parsed:" + input;
END

FN riskyFetch(url: String) RETURNS !String ->
    IF url == "" THEN
        RAISE Transient, NetworkDown;
    END
    RETURN "data:" + url;
END

FN main() RETURNS Void ->
    -- OR RAISE (existing behavior)
    good = riskyParse("ok") OR RAISE;
    ASSERT good == "parsed:ok", "OR RAISE passes through";

    -- OR EXIT "message" (set error context message + propagate)
    good2 = riskyParse("ok") OR EXIT "parse failed";
    ASSERT good2 == "parsed:ok", "OR EXIT passes on success";

    -- OR value (existing behavior, fallback)
    fallback = riskyParse("bad") OR "default";
    ASSERT fallback == "default", "OR value fallback";

    -- RECOVER in pipeline: replace error with default value
    result = riskyFetch("") s> RECOVER("fallback_data");
    ASSERT result == "fallback_data", "RECOVER replaces error with default";

    result2 = riskyFetch("example.com") s> RECOVER("fallback");
    ASSERT result2 == "data:example.com", "RECOVER passes through on success";

    RETURN;
END
