# Test: FREEZE operator compacts a @multiowned struct tree into a contiguous buffer.
# Result is T @frozen; field access auto-derefs through _root; cleanup via deinit.

STRUCT Point { x: Int64, y: Int64 }

FN testSimple() RETURNS !Void ->
    p = Point{ x: 3, y: 4 } @multiowned;
    frozen = FREEZE p;
    ASSERT frozen.x == 3;
    ASSERT frozen.y == 4;
END

FN main() RETURNS Void ->
    testSimple();
END
