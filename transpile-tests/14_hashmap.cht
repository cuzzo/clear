FN main() RETURNS Void ->
  MUTABLE counts = {"dummy": 0_i64}; -- Init Map

  word_str = "apple banana apple";
  MUTABLE words = word_str.split(" ");

  -- Manual Loop
  MUTABLE i = 0_i64;
  WHILE i < words.length() DO
    w = words[i];
    current = counts[w] OR 0_i64;
    counts[w] = current + 1_i64;
    i = i + 1_i64;
  END

  -- Verify counts
  ASSERT (counts["apple"] OR 0_i64) == 2, "Apple count should be 2";
  ASSERT (counts["banana"] OR 0_i64) == 1, "Banana count should be 1";
END
