FN cheatMain() RETURNS Void ->
  MUTABLE counts = %{"dummy": 0_i64}; -- Init Map

  VAR word_str = "apple banana apple";
  MUTABLE words = word_str.split(" ");

  -- Manual Loop
  MUTABLE i = 0_i64;
  WHILE i < words.length() DO
    VAR w = words[i];
    VAR current = counts[w]; -- mapGet (defaults to 0)
    SET counts[w] = current + 1_i64; -- mapPut
    SET i = i + 1_i64;
  END

  -- Verify counts
  ASSERT counts["apple"] == 2, "Apple count should be 2";
  ASSERT counts["banana"] == 1, "Banana count should be 1";
END
