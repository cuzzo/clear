-- Test: Iterator with BORROWED field — stress test for borrow system.
--
-- StringIter borrows a String[] and iterates without copying.
-- Exercises: BORROWED struct field, non_escaping propagation,
-- borrow conflict detection, and zero-copy iteration.

STRUCT StringIter {
    source: BORROWED String[],
    pos: Int64,
    len: Int64
}

FN makeIter(source: String[], len: Int64) RETURNS StringIter ->
    RETURN StringIter{ source: source, pos: 0, len: len };
END

FN hasNext(iter: StringIter) RETURNS Bool ->
    RETURN iter.pos < iter.len;
END

FN currentLen(iter: StringIter) RETURNS Int64 ->
    RETURN iter.source[iter.pos].length();
END

FN advance(iter: StringIter) RETURNS StringIter ->
    RETURN StringIter{ source: iter.source, pos: iter.pos + 1, len: iter.len };
END

FN main() RETURNS Void ->
    -- Iterate strings without copying — measure total length
    items: String[] = ["alpha", "beta", "gamma", "delta"];
    WITH BORROWED items AS ref {
        MUTABLE iter = makeIter(ref, 4);
        MUTABLE totalLen: Int64 = 0;
        WHILE hasNext(iter) DO
            totalLen += currentLen(iter);
            iter = advance(iter);
        END
        -- alpha(5) + beta(4) + gamma(5) + delta(5) = 19
        ASSERT totalLen == 19;
    }

    -- Verify items is still usable after WITH block
    ASSERT items.length() == 4;

    print("PASS");
    RETURN;
END
