# HashMap keys must survive across function frame rewinds.
# A HashMap passed to a function that has saveFrameMark/restoreFrameMark
# must retain valid keys after the callee returns.

FN modify!(MUTABLE map: {String}Int64, key: String, val: Int64) RETURNS !Void ->
    map[key] = val;
    RETURN;
END

FN main() RETURNS Void ->
    MUTABLE m: {String}Int64 = {};

    # Put via function calls (each has its own frame mark)
    modify!(m, "alpha", 1);
    modify!(m, "beta", 2);
    modify!(m, "gamma", 3);

    # Keys must still be valid after callee frame rewinds
    a = m["alpha"] OR_ELSE 0;
    ASSERT a == 1, "alpha survives frame rewind";
    b = m["beta"] OR_ELSE 0;
    ASSERT b == 2, "beta survives frame rewind";
    c = m["gamma"] OR_ELSE 0;
    ASSERT c == 3, "gamma survives frame rewind";

    # Overwrite via another call
    modify!(m, "alpha", 99);
    a2 = m["alpha"] OR_ELSE 0;
    ASSERT a2 == 99, "overwrite after frame rewind";

    RETURN;
END
