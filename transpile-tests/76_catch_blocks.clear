# CATCH blocks: multi-clause error handling at function bottom.

FN riskyOp(mode: String) RETURNS !String ->
    IF mode == "transient" THEN
        RAISE Transient, Timeout, "connection timed out";
    ELSE_IF mode == "input" THEN
        RAISE Input, InvalidJson, "bad json";
    ELSE_IF mode == "notfound" THEN
        RAISE NotFound;
    END
    RETURN "ok:" + mode;
END

# Function with CATCH blocks
FN handleWithCatch(mode: String) RETURNS !String ->
    result = riskyOp(mode) OR_ELSE RAISE;
    RETURN result;

CATCH Transient
    RETURN "recovered-transient";
CATCH Input WITH(InvalidJson)
    RETURN "recovered-invalid-json";
DEFAULT
    RETURN "recovered-default";
END

FN main() RETURNS Void ->
    # Success case: no error, CATCH not triggered
    r1 = handleWithCatch("ok");
    ASSERT r1 == "ok:ok", "success passes through";

    # Transient error: caught by CATCH Transient
    r2 = handleWithCatch("transient");
    ASSERT r2 == "recovered-transient", "CATCH Transient";

    # Input/InvalidJson: caught by CATCH Input WITH(InvalidJson)
    r3 = handleWithCatch("input");
    ASSERT r3 == "recovered-invalid-json", "CATCH Input WITH(InvalidJson)";

    # NotFound: no specific CATCH, falls to DEFAULT
    r4 = handleWithCatch("notfound");
    ASSERT r4 == "recovered-default", "DEFAULT catches NotFound";

    RETURN;
END
