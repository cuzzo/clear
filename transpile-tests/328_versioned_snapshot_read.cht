# MVCC L8: WITH SNAPSHOT read on a @versioned cell.
# Single-cell read returns a Guard whose release is auto-deferred.
# The alias binds the bare inner T (Group 2 strip).

STRUCT Counter { value: Int64 }

FN main() RETURNS Void ->
    c = Counter{ value: 42 } @versioned;

    WITH SNAPSHOT c AS view {
        ASSERT view.value == 42, "WITH SNAPSHOT read: expected 42";
    }

    # Read again -- the cell is unchanged.
    WITH SNAPSHOT c AS view2 {
        ASSERT view2.value == 42, "WITH SNAPSHOT read repeat: expected 42";
    }

    RETURN;
END
