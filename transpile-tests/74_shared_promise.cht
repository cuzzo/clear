-- Shared promises: ~T@shared — a memoized promise with Arc-style ref counting.
-- Multiple NEXT calls on the same handle return the cached result after the
-- first block.  The underlying Inner is freed when the last handle is consumed.

FN expensive(x: Number) RETURNS Number ->
    RETURN x * x;
END

FN cheatMain() RETURNS Void ->
    -- -------------------------------------------------------
    -- Test 1: Single holder, NEXT called twice (idempotent).
    -- -------------------------------------------------------
    sp: ~Number@shared = BG { expensive(7.0); };

    r1: Number = NEXT sp;
    ASSERT r1 == 49.0, "shared promise: first NEXT returns correct value";

    r2: Number = NEXT sp;
    ASSERT r2 == 49.0, "shared promise: second NEXT returns same cached value";

    -- -------------------------------------------------------
    -- Test 2: Simple shared promise with a captured variable.
    -- -------------------------------------------------------
    base: Number = 6.0;
    sp2: ~Number@shared = BG { expensive(base); };

    v1: Number = NEXT sp2;
    v2: Number = NEXT sp2;

    ASSERT v1 == 36.0, "shared promise with capture: first NEXT";
    ASSERT v2 == 36.0, "shared promise with capture: second NEXT (cached)";

    -- -------------------------------------------------------
    -- Test 3: Shared promise that produces a Bool.
    -- -------------------------------------------------------
    flag: ~Bool@shared = BG { TRUE; };
    b1: Bool = NEXT flag;
    b2: Bool = NEXT flag;
    ASSERT b1 == TRUE, "shared bool promise: first NEXT";
    ASSERT b2 == TRUE, "shared bool promise: second NEXT (cached)";

    RETURN;
END
