-- Test: lambda assigned to a variable without explicit FN(...) type annotation.
-- The compiler must infer the function-pointer type correctly so Zig can compile.
-- Verifies:
--   1. Lambda assigned to untyped var and called
--   2. Lambda with USE capture assigned to untyped var and called
--   3. Lambda with default param assigned to untyped var - override and inject

FN main() RETURNS Void ->
    -- Test 1: plain lambda, inferred type
    double = %(n: Int64) -> n * 2;
    ASSERT double(3) == 6, "test1: 3*2=6";
    ASSERT double(0) == 0, "test1: 0*2=0";

    -- Test 2: lambda with USE capture, inferred type
    base: Int64 = 100;
    add_base = %(n: Int64) USE(base) -> n + base;
    ASSERT add_base(5) == 105, "test2: 5+100=105";

    -- Test 3: lambda with default param, inferred type
    triple_or = %(n=4: Int64) -> n * 3;
    ASSERT triple_or(2) == 6, "test3: override 2*3=6";
    ASSERT triple_or() == 12, "test3: default 4*3=12";

    RETURN;
END
