# Regression: a nested-@list-field append on a loop-rewind-heap-
# promoted root must use the root's allocator, not :frame.
STRUCT Handle { values: Int64[]@list }

FN run(n: Int64) RETURNS !Int64 ->
    MUTABLE handles: Handle[]@list = List[];
    MUTABLE i: Int64 = 0_i64;
    WHILE i < n DO
        MUTABLE scratch: Int64[]@list = List[];
        scratch.append(i);
        scratch.append(i + 1_i64);
        handles.append(Handle{ values: [] });
        IF handles[i] AS handle THEN
            handle.values.append(scratch[0] OR_ELSE 0_i64);
            handle.values.append(scratch[1] OR_ELSE 0_i64);
        END
        i = i + 1_i64;
    END
    MUTABLE total: Int64 = 0_i64;
    FOR h IN (0_i64 ..< handles.length()) DO
        total = total + (handles[h]?.values.length() OR_ELSE 0_i64);
    END
    RETURN total;
END

FN main() RETURNS Void ->
    r: Int64 = run(5_i64) OR_ELSE PASS;
    ASSERT r == 10_i64, "5 handles x 2 nested values each";
    RETURN;
END
