-- Test: CONCURRENT EACH — parallel side-effect iteration
STRUCT Counter { value: Float64 }

FN main() RETURNS Void ->
    MUTABLE items: Counter[]@list = [];
    append(items, Counter{value: 0.0});
    append(items, Counter{value: 0.0});
    append(items, Counter{value: 0.0});
    append(items, Counter{value: 0.0});

    -- CONCURRENT EACH: set each item's value to 1.0 in parallel (workers: 2)
    items |> CONCURRENT(workers: 2) EACH { _.value = 1.0; };

    total = items |> SUM _.value;
    ASSERT total == 4.0, "all 4 counters should be set to 1";

    RETURN;
END
