# Pipeline-terminal observable FIND.
#
# A BG STREAM produces values; FIND publishes the first item matching
# the predicate into a `~?Int64@observable` binding (heap-allocated
# `*ObservableFind(i64)` with a CAS-on-flag first-wins publication).
# NEXT joins and returns the optional final.

FN main() RETURNS Void ->
    gen: ~?Int64[] = BG STREAM {
        MUTABLE i: Int64 = 0_i64;
        WHILE i < 100_i64 DO
            YIELD i;
            i = i + 1_i64;
        END
    };

    running: ~?Int64@observable = gen |> FIND _ > 42_i64;
    final = NEXT running;

    ASSERT final != NIL, "FIND should produce a value";
    ASSERT final == 43_i64, "first int > 42 is 43";
    print("ok");
    RETURN;
END
