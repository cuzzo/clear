-- Thunk Phase 4d -- non-tail :THUNK lowers to a heap-CPS trampoline.
--
-- factorial is the canonical "simple recurrence" shape: zero or more
-- IF base cases followed by `RETURN expr <op> self_call(args)`. Phase 4c
-- detects the shape; Phase 4d emits a Frame-struct-based trampoline
-- inside the function body. Each recursive call allocates a child
-- frame on rt.heapAlloc(); the trampoline pops back through parent
-- pointers when each frame's Done value is computed.
--
-- The fiber stack stays at depth=1 -- recursion lives entirely on the
-- heap (one Frame per active call). Compare with plain EFFECTS REENTRANT
-- which would force the caller onto a 2 MB @service stack.

FN factorial(n: Int64) RETURNS Int64
  EFFECTS REENTRANT:THUNK ->
  IF n <= 1 -> RETURN 1;
  RETURN n * factorial(n - 1);
END

FN main() RETURNS Void ->
  r0 = factorial(0_i64);
  ASSERT r0 == 1_i64, "factorial(0) == 1 (base case)";

  r5 = factorial(5_i64);
  ASSERT r5 == 120_i64, "factorial(5) == 120";

  r10 = factorial(10_i64);
  ASSERT r10 == 3628800_i64, "factorial(10) == 3628800";

  RETURN;
END
