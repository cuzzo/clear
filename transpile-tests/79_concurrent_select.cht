-- Test: CONCURRENT SELECT — parallel transform with pool_size backpressure
STRUCT Work { value: Number }

FN double(w: Work) RETURNS Number ->
    RETURN w.value * 2.0;
END

FN cheatMain() RETURNS Void ->
    items: Work[] = [Work{value: 1.0}, Work{value: 2.0}, Work{value: 3.0}, Work{value: 4.0}, Work{value: 5.0}];

    -- CONCURRENT SELECT: map items to doubled values (pool_size: 3)
    results = items s> CONCURRENT(pool_size: 3) SELECT double(_);

    -- Verify via SUM (order-preserving means sum is deterministic)
    total = results s> SUM _;
    ASSERT total == 30.0, "sum of doubled [1,2,3,4,5] should be 30";

    -- Also test with default pool_size
    results2 = items s> CONCURRENT SELECT _.value;
    total2 = results2 s> SUM _;
    ASSERT total2 == 15.0, "sum of values [1,2,3,4,5] should be 15";

    RETURN;
END
