# Test: an IF expression whose branches are uniformly heap-owned must be
# allowed. Rust accepts `if c { format!(..) } else { format!(..) }`; CLEAR
# rejected it because the result was force-stamped rodata, so an owned string
# would have leaked. Mixed provenance stays rejected -- Rust rejects that too
# (&str vs String) -- but same-ownership branches are ordinary code.

PRIVATE FN decorate(code: String, semi: Bool) RETURNS String ->
  RETURN IF semi THEN "${code};" ELSE "${code}!" END;
END

FN main() RETURNS !Void ->
  ASSERT decorate("x", TRUE) == "x;", "the THEN branch should own its result";
  ASSERT decorate("y", FALSE) == "y!", "the ELSE branch should own its result";

  MUTABLE joined = "";
  FOR i IN (0_i64..=2_i64) DO
    part = IF i > 0_i64 THEN "n${i.toString()}" ELSE "z${i.toString()}" END;
    joined = joined $+ part;
  END
  ASSERT joined == "z0n1n2", "an owned IF result should survive a loop";

  # Ruby's `next nil unless code` shape: one branch owns a string, the other
  # yields nothing. A NIL branch carries no storage, so it says nothing about
  # ownership and must not veto the owned result.
  MUTABLE seen = 0_i64;
  FOR i IN (0_i64..=3_i64) DO
    MUTABLE maybe: ?String = IF i > 1_i64 THEN "k${i.toString()}" ELSE NIL END;
    IF maybe EXISTS AS entry THEN
      ASSERT entry == "k${i.toString()}", "the optional owned result should survive";
      seen = seen + 1_i64;
    END
  END
  ASSERT seen == 2_i64, "only the value branches should yield a result";

  print("if_expr_owned_result: all tests passed");
  RETURN;
END
