-- Repro for the residual `snapshot = COPY items` body-binding case.
-- Bug 258 itself (CheatLib.dupeValue shallow-copying ArrayList) is
-- FIXED -- see transpile-tests/282_bg_body_copy_list.cht for the
-- working case (`sumAll(COPY items)` form: COPY at function-call
-- argument position).
--
-- The residual issue is in `lower_var_decl`: the list_collection
-- branch unconditionally emits `ContainerInit(:list_empty)` for the
-- declaration's init, ignoring the RHS. So `snapshot = COPY items`
-- lowers as `var snapshot = .empty;` instead of using the COPY
-- expression's value. The COPY itself (now a slice via lower_copy's
-- :list_shallow strategy) is dropped on the floor; the body then
-- indexes into an empty ArrayList and crashes with `index 0, len 0`.
--
-- Fix path:
-- 1. `lower_var_decl` list_collection branch: lower the RHS when it
--    is a CopyNode/CloneNode (mirroring the existing FuncCall /
--    MethodCall / NextExpr handling).
-- 2. Either:
--    a. Add a new DeepCopy strategy `:list_full` that emits
--       `try CheatLib.dupeValue(@TypeOf(src), src, alloc)` and returns
--       an ArrayList. `lower_copy` for `list_collection?` sources uses
--       this strategy; existing :list_shallow stays for slice sources.
--    b. OR have the list_collection branch emit `dupeValue` directly
--       around the CopyNode's inner expression.
--
-- Until then this test crashes at runtime. Re-enable when the
-- list_collection lower_var_decl + lower_copy paths are wired
-- end-to-end.

-- Originally classified as bug 258. Bug 258 in `dupeValue` is fixed.
-- This residual is bug 258b / "lower_var_decl ignores RHS for
-- list_collection types".

FN main() RETURNS Void ->
    items: Int64[]@list = [];
    items.append(10_i64);
    items.append(20_i64);
    items.append(30_i64);
    p: ~Int64 = BG {
        snapshot = COPY items;
        snapshot[0_i64] + snapshot[1_i64] + snapshot[2_i64];
    };
    r = NEXT p;
    ASSERT r == 60_i64, "BG body COPY of captured @list snapshots correctly";
END
