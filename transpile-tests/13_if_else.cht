FN cheatMain() RETURNS Void ->
  MUTABLE score = 10;
  VAR is_valid = score > 5;

  IF is_valid THEN
    VAR bonus = 100;
    SET score = score + bonus;
  ELSE
    SET score = 0;
  END

  -- Should be 110 since is_valid is true
  ASSERT score == 110, "Score should be 110 after bonus";

  -- Test else branch
  MUTABLE low_score = 3;
  IF low_score > 5 THEN
    SET low_score = 999;
  ELSE
    SET low_score = 0;
  END

  ASSERT low_score == 0, "Low score should be 0 from else branch";
END
