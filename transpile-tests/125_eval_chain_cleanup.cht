-- Minimal reproducer: parse-like chain creates heap Values,
-- eval-like chain consumes them. Should be zero leaks.

UNION Value { Nil, Symbol: String, Number: Float64, List: Value[] }

FN makeAst() RETURNS !Value ->
    MUTABLE items: Value[]@list = List[];
    items.append(Value{ Symbol: COPY "+" });
    items.append(Value{ Number: 1.0 });
    items.append(Value{ Number: 2.0 });
    RETURN Value{ List: items };
END

FN eval!(TAKES ast: Value) RETURNS !Value @reentrant ->
    PARTIAL MATCH TAKES ast START
        Value.Symbol AS sym -> RETURN Value.Nil;,
        Value.List AS items -> RETURN evalList!(items);,
        Value.Number AS n -> RETURN Value{ Number: n };,
        DEFAULT -> RETURN Value.Nil;
    END
    RETURN Value.Nil;
END

FN evalList!(TAKES items: Value[]) RETURNS !Value @reentrant ->
    MUTABLE evaled: Value[]@list = List[];
    FOR ei IN (0_i64 ..< items.length()) DO
        evaled.append(eval!(COPY items[ei]));
    END
    RETURN Value.Nil;
END

FN main() RETURNS Void ->
    ast = makeAst();
    result = eval!(ast);
    RETURN;
END
