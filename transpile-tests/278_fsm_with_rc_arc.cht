# FSM Phase B2-WITH (Rc/Arc): single WITH EXCLUSIVE on Rc/Arc-wrapped
# @locked values lowers to a 2-state FsmTask. The unwrap path uses
# `.ctrl.data.*` to reach the inner Locked(T), then takes the
# standard FSM lock acquire path.

STRUCT Counter { value: Int64 }

FN main() RETURNS Void ->
  # 1. @shared:locked (Arc<Locked<T>>) — atomic refcount + mutex.
  #    Two contending FSMs each increment.
  c1 = Counter{ value: 0 } @shared:locked;
  s1: ~Void = BG { WITH EXCLUSIVE c1 AS inner { inner.value = inner.value + 1; } };
  s2: ~Void = BG { WITH EXCLUSIVE c1 AS inner { inner.value = inner.value + 1; } };
  s3: ~Void = BG { WITH EXCLUSIVE c1 AS inner { inner.value = inner.value + 1; } };
  s4: ~Void = BG { WITH EXCLUSIVE c1 AS inner { inner.value = inner.value + 1; } };
  NEXT s1; NEXT s2; NEXT s3; NEXT s4;
  WITH EXCLUSIVE c1 AS inner {
    ASSERT inner.value == 4, "1: 4 contending @shared:locked FSMs";
  }

  # 2. @multiowned:locked (Rc<Locked<T>>) — non-atomic refcount;
  #    same-scheduler-only.
  c2 = Counter{ value: 100 } @multiowned:locked;
  q1: ~Void = BG { WITH EXCLUSIVE c2 AS inner { inner.value = inner.value + 1; } };
  q2: ~Void = BG { WITH EXCLUSIVE c2 AS inner { inner.value = inner.value + 1; } };
  NEXT q1; NEXT q2;
  WITH EXCLUSIVE c2 AS inner {
    ASSERT inner.value == 102, "2: 2 contending @multiowned:locked FSMs";
  }

  # 3. Pre-suspend local read inside the CS, on Arc-wrapped lock.
  c3 = Counter{ value: 1000 } @shared:locked;
  p3: ~Void = BG {
    delta = 5_i64;
    WITH EXCLUSIVE c3 AS inner {
      inner.value = inner.value + delta;
    }
  };
  NEXT p3;
  WITH EXCLUSIVE c3 AS inner {
    ASSERT inner.value == 1005, "3: pre-local read inside Arc-wrapped CS";
  }

  # 4. Heavy contention: 8 FSMs on @shared:locked.
  c4 = Counter{ value: 0 } @shared:locked;
  r1: ~Void = BG { WITH EXCLUSIVE c4 AS inner { inner.value = inner.value + 1; } };
  r2: ~Void = BG { WITH EXCLUSIVE c4 AS inner { inner.value = inner.value + 1; } };
  r3: ~Void = BG { WITH EXCLUSIVE c4 AS inner { inner.value = inner.value + 1; } };
  r4: ~Void = BG { WITH EXCLUSIVE c4 AS inner { inner.value = inner.value + 1; } };
  r5: ~Void = BG { WITH EXCLUSIVE c4 AS inner { inner.value = inner.value + 1; } };
  r6: ~Void = BG { WITH EXCLUSIVE c4 AS inner { inner.value = inner.value + 1; } };
  r7: ~Void = BG { WITH EXCLUSIVE c4 AS inner { inner.value = inner.value + 1; } };
  r8: ~Void = BG { WITH EXCLUSIVE c4 AS inner { inner.value = inner.value + 1; } };
  NEXT r1; NEXT r2; NEXT r3; NEXT r4;
  NEXT r5; NEXT r6; NEXT r7; NEXT r8;
  WITH EXCLUSIVE c4 AS inner {
    ASSERT inner.value == 8, "4: 8-FSM @shared:locked contention";
  }

  RETURN;
END
