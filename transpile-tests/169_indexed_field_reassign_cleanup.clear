# Test: Reassigning list[idx].field with heap-backed list
# Verifies that move suppression fires for the RHS variable when
# assigning through indexed struct field access, preventing double-free.

STRUCT Node { keys: Int64[]@list, vals: String[]@list }

FN main() RETURNS Void ->
    MUTABLE nodes: Node[]@list = [];
    nodes.append(Node{ keys: [], vals: [] });
    nodes[0].keys.append(1);
    nodes[0].vals.append("one");

    # Replace vals (String[]@list) through indexed access
    MUTABLE nv: String[]@list = [];
    nv.append("ten");
    nv.append("twenty");
    nodes[0].vals = nv;

    ASSERT nodes[0].vals.length() == 2, "replaced vals has 2 entries";
    ASSERT nodes[0].vals[0] == "ten", "val 0 is ten";
    ASSERT nodes[0].vals[1] == "twenty", "val 1 is twenty";

    # Replace keys (Int64[]@list) through indexed access
    MUTABLE nk: Int64[]@list = [];
    nk.append(10);
    nk.append(20);
    nodes[0].keys = nk;

    ASSERT nodes[0].keys.length() == 2, "replaced keys has 2 entries";
    ASSERT nodes[0].keys[0] == 10, "key 0 is 10";

    print("169: indexed field reassign cleanup PASSED");
END
