# Test: destructuring the pipeline placeholder inside a block.
# `k, v = _` in an EACH block fell through the placeholder rewriter's dispatch
# (it had no case for a destructuring assignment), so `_` survived into the
# emitted Zig and named a capture that is not in scope.

FN totals(pairs: []Tuple<String, Int64>) RETURNS Int64 ->
    MUTABLE sum = 0_i64;
    MUTABLE seen = 0_i64;
    pairs |> EACH {
        key, value = _;
        sum = sum + value;
        seen = seen + key.length();
    };
    RETURN sum + seen;
END

FN main() RETURNS Void ->
    MUTABLE a: String = "ab";
    MUTABLE b: String = "cd";
    MUTABLE m: []Tuple<String, Int64> = [Tuple{a, 10_i64}, Tuple{b, 5_i64}];
    ASSERT totals(m) == 19_i64, "destructured placeholder pairs";
    print("destructured placeholder ok");
END
