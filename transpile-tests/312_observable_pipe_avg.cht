-- Pipeline-terminal observable AVG.
--
-- A BG STREAM produces values; AVG folds them into a
-- `~Float64@observable` binding (heap-allocated `*ObservableAvg(f64)`
-- backed by atomic sum + count). View / NEXT both return Float64.

FN main() RETURNS Void ->
    gen: ~?Int64[] = BG STREAM {
        MUTABLE i: Int64 = 0_i64;
        WHILE i < 10_i64 DO
            YIELD i;
            i = i + 1_i64;
        END
    };

    running: ~Float64@observable = gen s> AVERAGE _;
    final = NEXT running;

    -- 0..9 sums to 45, count 10 → average 4.5
    ASSERT final == 4.5, "running avg mismatch";
    print("ok");
    RETURN;
END
