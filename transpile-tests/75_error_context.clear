# Error context: RAISE with kind, OR_ELSE EXIT, RECOVER, CATCH blocks.

FN riskyParse(input: String) RETURNS !String ->
    IF input == "bad" THEN
        RAISE Input, InvalidJson, "failed to parse";
    END
    RETURN "parsed:" $+ input;
END

FN riskyFetch(url: String) RETURNS !String ->
    IF url == "" THEN
        RAISE Transient, NetworkDown;
    END
    RETURN "data:" $+ url;
END

FN main() RETURNS Void ->
    # OR_ELSE RAISE (existing behavior)
    good = riskyParse("ok") OR_ELSE RAISE;
    ASSERT good == "parsed:ok", "OR_ELSE RAISE passes through";

    # OR_ELSE EXIT "message" (set error context message + propagate)
    good2 = riskyParse("ok") OR_ELSE EXIT "parse failed";
    ASSERT good2 == "parsed:ok", "OR_ELSE EXIT passes on success";

    # OR_ELSE value (existing behavior, fallback)
    fallback = riskyParse("bad") OR_ELSE "default";
    ASSERT fallback == "default", "OR_ELSE value fallback";

    # RECOVER in pipeline: replace error with default value
    result = riskyFetch("") |> RECOVER("fallback_data");
    ASSERT result == "fallback_data", "RECOVER replaces error with default";

    result2 = riskyFetch("example.com") |> RECOVER("fallback");
    ASSERT result2 == "data:example.com", "RECOVER passes through on success";

    RETURN;
END
