-- Test: loop puts frame-allocated string keys/values into an outer HashMap (Pattern 6).
-- The key and value strings are built from frame arena each iteration.
-- They must be heap-promoted so the loop mark rewind doesn't destroy them.

FN main() RETURNS Void ->
    MUTABLE m: HashMap<String, Int64> = {};
    FOR i IN (1_i64 ..= 5) DO
        m["key-" + i.toString()] = i * 10;
    END
    ASSERT m.count() == 5;
    ASSERT m["key-1"] == 10;
    ASSERT m["key-3"] == 30;
    ASSERT m["key-5"] == 50;

    print("PASS");
    RETURN;
END
