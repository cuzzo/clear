-- Test: @indirect field must deep-copy when capturing shared data.
--
-- Pattern: Lambda body captures a Value via @indirect. The @indirect
-- heap-allocates a *Value. If the source Value contains heap data,
-- the stored value must be a deep copy so cleanup doesn't double-free.

STRUCT Env { x: Int64 }
UNION Value { Nil, Num: Float64, Str: String, Lambda { body: Value @indirect, id: Int64 } }

FN captureLambda!(TAKES bodyVal: Value, MUTABLE pool: Env[10]@pool) RETURNS !Value ->
    pool.insert(Env{ x: 1 });
    RETURN Value.Lambda{ body: bodyVal, id: 1 };
END

FN main() RETURNS Void ->
    MUTABLE pool: Env[10]@pool = [];
    body = Value{ Num: 42.0 };
    lambda = captureLambda!(body, pool);
    -- lambda goes out of scope. cleanup(Value) must free *Value body.
    RETURN;
END
