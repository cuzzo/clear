# Test: @local capability — zero-cost shared mutable reference.
# @local creates a heap pointer (*T) with no Mutex/Arc wrapper.
# Multiple BG fibers can read/write through the pointer safely because
# the compiler auto-pins them to the local scheduler (cooperative, single-threaded).

STRUCT Counter { value: Int64 }

FN main() RETURNS Void ->
    # @local: heap-allocated *Counter, no lock.
    MUTABLE c = Counter{ value: 0 } @local;

    # Spawn 4 fibers, each incrementing the counter.
    # Auto-pinned because c is @local.
    MUTABLE futures: ~Void[]@list = [];
    MUTABLE i: Int64 = 0;
    WHILE i < 4 DO
        append(futures, BG {
            c.value = c.value + 1;
        });
        i = i + 1;
    END

    # Wait for all fibers to complete.
    MUTABLE j: Int64 = 0;
    WHILE j < 4 DO
        IF futures[j] AS future THEN NEXT future; END
        j = j + 1;
    END

    # Verify: 4 increments → value should be 4.
    ASSERT c.value == 4, "@local counter should be 4 after 4 increments";

    # Also verify direct read access works.
    result: Int64 = c.value;
    ASSERT result == 4, "direct read of @local field should be 4";

    RETURN;
END
