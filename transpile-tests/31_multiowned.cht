STRUCT Counter { value: Int64 }

-- Test: basic multiowned creation and field access.
-- The testing allocator verifies no leaks (cleanup happens correctly).
FN main() RETURNS Void ->
    a = Counter{ value: 42 } @multiowned;
    ASSERT a.value == 42, "a.value should be 42";

    -- Clone: both a and b point to the same Counter (ref count = 2).
    -- If the Counter were freed when b is created, accessing a.value would be a use-after-free.
    b = a;
    ASSERT a.value == 42, "a.value should still be 42 after clone";
    ASSERT b.value == 42, "b.value should equal a.value (same Counter)";

    -- On scope exit:
    --   defer rcRelease(Counter, alloc, b)  -> count 2->1  (Counter still alive)
    --   defer rcRelease(Counter, alloc, a)  -> count 1->0  (Counter and ref_count freed)
    -- The testing allocator confirms no leaks.
    RETURN;
END
