# Test: ActiveSupport-style optional + collection predicates.
# Each is `is_method: true` in std_lib.rb so `clear fmt` rewrites
# prefix calls to UFCS; tests below use the canonical UFCS form.

FN main() RETURNS Void -> RETURN; END

TEST Predicates DO
  WHEN "nil? / present? on optionals" DO
    TEST THAT "NIL optional reports nil?" DO
      x: ?Int64 = NIL;
      ASSERT x.nil?();
      not_present = x.present?();
      ASSERT not_present == FALSE;
    END

    TEST THAT "non-NIL optional reports present?" DO
      x: ?Int64 = 42;
      ASSERT x.present?();
      not_nil = x.nil?();
      ASSERT not_nil == FALSE;
    END

    TEST THAT "?String works the same way" DO
      a: ?String = "hello";
      b: ?String = NIL;
      ASSERT a.present?();
      ASSERT b.nil?();
    END
  END

  WHEN "empty? on collections" DO
    TEST THAT "empty string" DO
      ASSERT "".empty?();
    END

    TEST THAT "non-empty string" DO
      not_empty = "hello".empty?();
      ASSERT not_empty == FALSE;
    END

    TEST THAT "empty list" DO
      xs: Int64[] = [];
      ASSERT xs.empty?();
    END

    TEST THAT "non-empty list" DO
      xs: Int64[] = [1, 2, 3];
      not_empty = xs.empty?();
      ASSERT not_empty == FALSE;
    END
  END

  WHEN "any? on collections (non-empty)" DO
    # `.any?` (no-arg) is CLEAR's "has data" predicate. The same
    # name doubles as `.any?(predicate)` — Ruby/Crystal/Elixir do
    # exactly this, disambiguated by arity.

    TEST THAT "non-empty string any?" DO
      ASSERT "hello".any?();
    END

    TEST THAT "empty string is not any?" DO
      none = "".any?();
      ASSERT none == FALSE;
    END

    TEST THAT "non-empty list any?" DO
      xs: Int64[] = [1];
      ASSERT xs.any?();
    END

    TEST THAT "non-NIL optional with content is any?" DO
      x: ?String = "hello";
      ASSERT x.any?();
    END

    TEST THAT "NIL optional is not any?" DO
      x: ?String = NIL;
      none = x.any?();
      ASSERT none == FALSE;
    END

    TEST THAT "empty optional is not any?" DO
      x: ?String = "";
      none = x.any?();
      ASSERT none == FALSE;
    END
  END

  WHEN "blank? on optional collections" DO
    # blank? = nil? OR_ELSE empty?  — only meaningful on `?T` shapes.
    # For non-optional collections, users write `.empty?` (CLEAR
    # avoids two predicates for the same check on the same shape).

    TEST THAT "NIL optional string is blank" DO
      x: ?String = NIL;
      ASSERT x.blank?();
    END

    TEST THAT "empty optional string is blank" DO
      x: ?String = "";
      ASSERT x.blank?();
    END

    TEST THAT "non-empty optional string is not blank" DO
      x: ?String = "alice";
      not_blank = x.blank?();
      ASSERT not_blank == FALSE;
    END
  END
END
