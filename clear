#!/usr/bin/env ruby
# clear - CLEAR language compiler CLI
#
# Usage:
#   clear build foo.cht [-o output] [--release|--safe]
#   clear run foo.cht [-- args...]
#   clear test foo.cht
#
# See docs/clear-man.md for full documentation.

require 'fileutils'
require 'optparse'
require 'digest'
require 'set'
require 'json'

# Resolve paths relative to this script (works from any directory)
CLEAR_ROOT = File.expand_path('..', __FILE__)
ZIG_DIR    = File.join(CLEAR_ROOT, 'zig')
SRC_DIR    = File.join(CLEAR_ROOT, 'src')
TRANSPILER = File.join(SRC_DIR, 'backends', 'transpiler.rb')
TRANSPILER_CACHE_DIR = File.join(ZIG_DIR, '.clear-transpile-cache')

# Find Zig compiler
ZIG = [
  File.join(File.expand_path('~'), 'zig-x86_64-linux-0.16.0', 'zig'),
  File.join(ZIG_DIR, 'zig-new', 'zig'),
  File.join(ZIG_DIR, 'zig', 'zig'),
  `which zig 2>/dev/null`.strip
].find { |p| !p.empty? && File.exist?(p) } || 'zig'

# Runtime files needed for linking
RUNTIME_FILES = %w[runtime/switch.S runtime/onRoot.S].map { |f| File.join(ZIG_DIR, f) }

# Detect jemalloc/tcmalloc
# Detect `--fix` / `--fix=auto` / `--fix=yes` in an args list. Returns
# nil, :interactive, or :auto. `yes` is an alias for `auto`.
def detect_fix_mode(args)
  return :auto        if args.include?('--fix=auto') || args.include?('--fix=yes')
  return :interactive if args.include?('--fix')
  nil
end

# First positional argument in an args list (skipping flags and the
# value after `-o`). Used by --fix to locate the source file without
# needing the full build-flag parser.
def first_positional_arg(args)
  skip_next = false
  args.each do |a|
    if skip_next
      skip_next = false
      next
    end
    if a == '-o' || a == '--out'
      skip_next = true
      next
    end
    return a unless a.start_with?('-')
  end
  nil
end

# Run `<binary> <cmd> <sub_args>`; on failure, invoke `clear fix` on
# `source` (passing `--yes` when mode is :auto) and retry the build
# exactly once. Exits with the final subprocess status. The sub-build
# does NOT receive `--fix`, so nothing recurses.
def run_with_fix_retry(binary, cmd, sub_args, source, fix_mode)
  first = system(binary, cmd, *sub_args)
  exit($?.exitstatus) if first

  $stderr.puts "\e[33m[fix]\e[0m #{cmd} failed — running `clear fix` on #{source}..."
  fix_args = ['fix']
  fix_args << '--yes' if fix_mode == :auto
  fix_args << source
  unless system(binary, *fix_args)
    $stderr.puts "\e[31m[fix]\e[0m fix produced no applicable edits; giving up."
    exit 1
  end

  $stderr.puts "\e[33m[fix]\e[0m retrying `clear #{cmd}`..."
  exec(binary, cmd, *sub_args)
end

def describe_finding(finding)
  line = finding.token&.line
  col  = finding.token&.column
  puts "\n[#{finding.category}] #{finding.message} (line #{line}, col #{col})"
  finding.fixes.each_with_index do |fx, i|
    marker = fx.confidence == :auto ? '*' : ' '
    puts "  #{marker} [#{i + 1}] #{fx.description}"
  end
end

def prompt_choice(finding)
  $stderr.print "Apply which fix? [1-#{finding.fixes.length}, 0 to skip]: "
  input = $stdin.gets&.strip
  return nil if input.nil? || input.empty?
  idx = input.to_i
  return nil if idx == 0
  finding.fixes[idx - 1]
end

# Apply edits to `text`. Edits are pre-sorted last-to-first (line, col)
# so earlier application doesn't shift later byte positions.
# Drop edits whose span starts inside another edit's span. Keeps the
# first (earlier in the sorted list) when spans overlap. This handles
# the case where multiple fixable sources fire for the same syntax
# mistake (e.g., both the operator-typo scanner and the parser
# expected-token handler flag the same `=>`).
def dedupe_overlapping_edits(edits)
  kept = []
  edits.each do |e|
    start_col = e.span.col
    end_col   = start_col + e.span.length
    conflict = kept.find do |prev|
      next false if prev.span.line != e.span.line
      prev_start = prev.span.col
      prev_end   = prev_start + prev.span.length
      # An edit conflicts with a kept one if its insertion point falls
      # within the kept edit's range, OR its replacement range
      # overlaps the kept range. Also catches two zero-length
      # insertions at the same column.
      within_prev = start_col >= prev_start && start_col <= prev_end
      ranges_overlap = start_col < prev_end && prev_start < end_col
      within_prev || ranges_overlap
    end
    kept << e unless conflict
  end
  kept
end

def apply_edits(text, edits)
  lines = text.split("\n", -1)
  edits.each do |e|
    sp = e.span
    idx = sp.line - 1
    next if idx < 0 || idx >= lines.length
    ln = lines[idx]
    start_col = sp.col - 1
    start_col = 0 if start_col < 0
    start_col = ln.length if start_col > ln.length
    end_col = start_col + sp.length
    end_col = ln.length if end_col > ln.length
    lines[idx] = ln[0...start_col] + e.replacement.to_s + ln[end_col..]
  end
  lines.join("\n")
end

def find_alloc_preload
  Dir.glob('/lib/x86_64-linux-gnu/libjemalloc.so*').first ||
    Dir.glob('/usr/lib/libjemalloc.so*').first ||
    Dir.glob('/usr/local/lib/libjemalloc.so*').first ||
    Dir.glob('/lib/x86_64-linux-gnu/libtcmalloc.so*').first
end

def hint(msg)
  $stderr.puts "\e[33mhint:\e[0m #{msg}"
end

def error(msg)
  $stderr.puts "\e[31merror:\e[0m #{msg}"
  exit 1
end

def debug_cache(msg)
  $stderr.puts("[transpile-cache] #{msg}") if ENV['CLEAR_DEBUG_CACHE'] == '1'
end

def write_if_changed(path, content)
  FileUtils.mkdir_p(File.dirname(path))
  return false if File.exist?(path) && File.read(path) == content
  File.write(path, content)
  true
end

def ensure_symlink(link_path, target_path)
  if File.symlink?(link_path)
    return if File.readlink(link_path) == target_path
    File.delete(link_path)
  elsif File.exist?(link_path)
    FileUtils.rm_rf(link_path)
  end
  File.symlink(target_path, link_path)
end

def build_metadata_path(output)
  File.join(File.dirname(output), ".#{File.basename(output)}.clear-build.json")
end

def build_signature(source:, output:, opt_level:, extra_flags:, module_mode:, profile:, use_c_allocator:, default_stack:, strict_test:, exact_tiers:, main_tier: nil)
  {
    "source" => File.expand_path(source),
    "output" => File.expand_path(output),
    "opt_level" => opt_level,
    "extra_flags" => Array(extra_flags),
    "module_mode" => module_mode,
    "profile" => profile,
    "use_c_allocator" => use_c_allocator,
    "default_stack" => default_stack,
    "strict_test" => strict_test,
    "exact_tiers" => exact_tiers&.transform_keys(&:to_s),
    "main_tier" => main_tier,
    "zig" => ZIG
  }
end

def read_build_signature(output)
  meta_path = build_metadata_path(output)
  return nil unless File.exist?(meta_path)
  JSON.parse(File.read(meta_path))
rescue JSON::ParserError
  nil
end

def write_build_signature(output, signature)
  write_if_changed(build_metadata_path(output), JSON.pretty_generate(signature))
end

def find_package_source(pkg_name, start_dir:)
  dir = File.expand_path(start_dir)
  loop do
    candidate = File.join(dir, "packages", pkg_name, "src", "lib.cht")
    return candidate if File.exist?(candidate)
    parent = File.dirname(dir)
    break if parent == dir
    dir = parent
  end
  nil
end

def resolve_clear_require(raw, caller_dir:)
  if raw.start_with?('pkg:')
    pkg_name = raw.sub(/\Apkg:/, '')
    pkg_path = find_package_source(pkg_name, start_dir: caller_dir)
    error "Package '#{pkg_name}' not found from #{caller_dir}" unless pkg_path
    pkg_path
  else
    File.expand_path(raw, caller_dir)
  end
end

def collect_clear_dependencies(path, seen: Set.new)
  abs_path = File.expand_path(path)
  return seen if seen.include?(abs_path)
  error "File not found: #{abs_path}" unless File.exist?(abs_path)

  seen.add(abs_path)
  source = File.read(abs_path)
  caller_dir = File.dirname(abs_path)
  source.scan(/REQUIRE\s+"([^"]+)"/).flatten.uniq.each do |raw|
    dep_path = resolve_clear_require(raw, caller_dir: caller_dir)
    collect_clear_dependencies(dep_path, seen: seen)
  end
  seen
end

def newest_build_dependency_mtime(source)
  dep_paths = collect_clear_dependencies(source).to_a
  compiler_paths = Dir.glob(File.join(SRC_DIR, '**', '*.rb'))
  runtime_paths = Dir.glob(File.join(ZIG_DIR, 'runtime', '**', '*.zig')) +
                  Dir.glob(File.join(ZIG_DIR, 'runtime', '**', '*.S')) +
                  Dir.glob(File.join(ZIG_DIR, 'lib', '**', '*.zig'))
  tracked = dep_paths + compiler_paths + runtime_paths + [__FILE__]
  tracked.filter_map { |p| File.exist?(p) ? File.mtime(p) : nil }.max || Time.at(0)
end

def compiler_signature
  @compiler_signature ||= begin
    tracked = Dir.glob(File.join(SRC_DIR, '**', '*.rb')).sort +
              Dir.glob(File.join(ZIG_DIR, 'runtime', 'runtime-footer.zig')).sort +
              Dir.glob(File.join(ZIG_DIR, 'runtime', 'runtime-header.zig')).sort
    digest = Digest::SHA256.new
    tracked.each do |path|
      digest << path
      digest << File.read(path)
    end
    digest.hexdigest
  end
end

def transpile_dependency_signature(source_path)
  digest = Digest::SHA256.new
  collect_clear_dependencies(source_path).to_a.sort.each do |path|
    digest << File.expand_path(path)
    digest << File.read(path)
  end
  digest.hexdigest
end

def transpile_cache_key(source_path:, mode:, transpile_flag:, source_text:)
  Digest::SHA256.hexdigest([
    mode,
    transpile_flag,
    compiler_signature,
    transpile_dependency_signature(source_path),
    File.expand_path(source_path),
    source_text
  ].join("\0"))
end

def transpile_cached(source_path:, mode:, transpile_flag:, source_text:, force: false)
  cache_key = transpile_cache_key(
    source_path: source_path,
    mode: mode,
    transpile_flag: transpile_flag,
    source_text: source_text
  )
  cache_file = File.join(TRANSPILER_CACHE_DIR, "#{cache_key}.zig")

  if !force && File.exist?(cache_file)
    debug_cache("hit #{mode} #{File.basename(source_path)}")
    return [File.read(cache_file), cache_file]
  end

  debug_cache("miss #{mode} #{File.basename(source_path)}")
  zig_code = `ruby #{TRANSPILER} #{transpile_flag} #{source_path} 2>/dev/null`
  unless $?.success?
    system("ruby #{TRANSPILER} #{transpile_flag} #{source_path} > /dev/null")
    error "Transpilation failed"
  end

  write_if_changed(cache_file, zig_code)
  [zig_code, cache_file]
end

# Walk AST to collect BG block nodes in order (matching transpiler's @bg_block_counter).
def find_bg_blocks(node, result)
  case node
  when Array
    node.each { |n| find_bg_blocks(n, result) }
  when AST::BgBlock
    result << node
    find_bg_blocks(node.body, result) if node.respond_to?(:body)
  else
    node.each_pair { |_, v| find_bg_blocks(v, result) } if node.respond_to?(:each_pair)
  end
end

# -------------------------------------------------------------------------
# Build: transpile + compile
# -------------------------------------------------------------------------
def do_build(source, output: nil, opt_level: 'Debug', extra_flags: [], module_mode: false, default_stack: nil, profile: false, strict_test: false, force: false, exact_tiers: nil, use_c_allocator: false, main_tier: nil)
  error "File not found: #{source}" unless File.exist?(source)
  source = File.expand_path(source)
  source_dir = File.dirname(source)
  base_name = File.basename(source, '.cht')

  # Output binary path
  output ||= File.join(source_dir, base_name)
  signature = build_signature(
    source: source,
    output: output,
    opt_level: opt_level,
    extra_flags: extra_flags,
    module_mode: module_mode,
    profile: profile,
    use_c_allocator: use_c_allocator,
    default_stack: default_stack,
    strict_test: strict_test,
    exact_tiers: exact_tiers,
    main_tier: main_tier
  )

  # Skip rebuild if output is newer than source AND compiler files.
  unless force || module_mode || profile
    if File.exist?(output)
      out_mtime = File.mtime(output)
      newest_dep = newest_build_dependency_mtime(source)
      if out_mtime >= newest_dep && read_build_signature(output) == signature
        $stderr.puts "\e[90mup-to-date: #{output}\e[0m"
        return :up_to_date
      end
    end
  end

  # Transpile
  transpile_flag = module_mode ? '--test' : ''
  transpile_flag += " --use-c-allocator" if use_c_allocator
  transpile_flag += " --default-stack #{default_stack}" if default_stack
  transpile_flag += " --strict" if strict_test
  if exact_tiers
    transpile_flag += " --exact-tiers '#{exact_tiers.transform_keys(&:to_s).to_json}'"
  end
  transpile_flag += " --main-tier #{main_tier}" if main_tier

  # Auto-detect package requires: REQUIRE "pkg:name" → look for packages/name/src/lib.cht
  source_text = File.read(source)
  pkg_requires = source_text.scan(/REQUIRE\s+"pkg:([^"]+)"/).flatten.uniq
  pkg_flags = pkg_requires.map do |pkg_name|
    pkg_path = find_package_source(pkg_name, start_dir: source_dir)
    error "Package '#{pkg_name}' not found from #{source_dir}" unless pkg_path
    "--pkg #{pkg_name}=#{pkg_path}"
  end.join(" ")
  transpile_flag += " #{pkg_flags}" if pkg_flags.length > 0
  # MIR is the only pipeline (--mir flag no longer needed)

  cache_key = Digest::SHA256.hexdigest(source)[0, 16]
  build_dir = File.join(ZIG_DIR, ".clear-cache", cache_key)
  FileUtils.mkdir_p(build_dir)
  ensure_symlink(File.join(build_dir, 'runtime'), File.join(ZIG_DIR, 'runtime'))
  ensure_symlink(File.join(build_dir, 'lib'), File.join(ZIG_DIR, 'lib'))
  ensure_symlink(File.join(build_dir, 'experimental'), File.join(ZIG_DIR, 'experimental'))
  cache_dir = File.join(build_dir, '.zig-cache')
  global_cache_dir = File.join(build_dir, '.global-zig-cache')

  tmp_name = "._clear_tmp_#{base_name}.zig"
  tmp_zig = File.join(build_dir, tmp_name)

  zig_code, _cache_file = transpile_cached(
    source_path: source,
    mode: module_mode ? :test_root : :build_root,
    transpile_flag: transpile_flag,
    source_text: source_text,
    force: force
  )
  # Inject comptime profiling flag when building with `clear profile`.
  # This enables allocation tracking in the runtime allocator VTable
  # with zero overhead in production builds.
  if profile
    zig_code = "pub const CLEAR_PROFILE = true;\n" + zig_code
  end
  # When packages are present, rewrite package @import("name") to @import("name.zig")
  # so all files live as file-path imports (avoids Zig module system complexity).
  if pkg_requires.any?
    pkg_requires.each do |pkg_name|
      zig_code = zig_code.gsub("@import(\"#{pkg_name}\")", "@import(\"#{pkg_name}.zig\")")
    end
  end
  write_if_changed(tmp_zig, zig_code)

  # Auto-detect FFI modules: scan source for EXTERN ... FROM "module" declarations
  # and check if a matching .zig file exists in the source directory.
  extern_modules = source_text.scan(/FROM\s+"([^"]+)"/).flatten.uniq
  ffi_modules = extern_modules.select { |m|
    # Skip standard library modules (std.json, std.fs, etc.)
    !m.start_with?('std.') && File.exist?(File.join(source_dir, "#{m}.zig"))
  }

  # Copy FFI modules to build dir for compilation
  ffi_modules.each { |m| FileUtils.cp(File.join(source_dir, "#{m}.zig"), File.join(build_dir, "#{m}.zig")) }

  # Transpile package modules to .zig files
  pkg_modules = pkg_requires.map do |pkg_name|
    pkg_path = find_package_source(pkg_name, start_dir: source_dir)
    error "Package '#{pkg_name}' not found from #{source_dir}" unless pkg_path
    # Collect transitive package deps for nested REQUIRE "pkg:..."
    pkg_src = File.read(pkg_path)
    nested_pkgs = pkg_src.scan(/REQUIRE\s+"pkg:([^"]+)"/).flatten.uniq
    nested_flags = nested_pkgs.map { |np|
      np_path = find_package_source(np, start_dir: File.dirname(pkg_path))
      error "Package '#{np}' not found from #{File.dirname(pkg_path)}" unless np_path
      "--pkg #{np}=#{np_path}"
    }.join(" ")
    pkg_zig, _pkg_cache_file = transpile_cached(
      source_path: pkg_path,
      mode: :module,
      transpile_flag: "--module #{nested_flags}".strip,
      source_text: pkg_src,
      force: force
    )
    # Rewrite module imports to file-path imports (all files live in zig/).
    # cheat_runtime → runtime-header.zig, nested packages → name.zig
    pkg_zig = pkg_zig.gsub('@import("cheat_runtime")', '@import("runtime/runtime-header.zig")')
    nested_pkgs.each do |np|
      pkg_zig = pkg_zig.gsub("@import(\"#{np}\")", "@import(\"#{np}.zig\")")
    end
    pkg_zig_file = File.join(build_dir, "#{pkg_name}.zig")
    write_if_changed(pkg_zig_file, pkg_zig)
    pkg_name
  end

  # Build Zig command from the temp build dir. Keep the runtime/lib layout,
  # but rely on ordinary file imports instead of Zig named modules.

  if module_mode
    cmd_parts = [ZIG, 'test']
  else
    cmd_parts = [ZIG, 'build-exe']
  end

  # Use per-build cache directories. Reusing the default shared global cache
  # has produced misoptimized binaries for some benchmarks (e.g. 02_sroa)
  # after recent build-system changes.
  cmd_parts += ['--cache-dir', cache_dir, '--global-cache-dir', global_cache_dir]

  cmd_parts += [tmp_name, *RUNTIME_FILES]
  cmd_parts += ['-lc']

  unless module_mode
    bin_name = "#{File.basename(output)}-#{$$}"
    cmd_parts += ['-O', opt_level] + extra_flags
    cmd_parts += ['-fno-strip'] if profile
    cmd_parts += ['--name', bin_name]
  end

  cmd = cmd_parts.join(' ')
  compile_output = `cd #{build_dir} && #{cmd} 2>&1`
  success = $?.success?

  # Move binary to output location (zig puts it in the build dir)
  if success && !module_mode
    zig_binary = File.join(build_dir, "#{File.basename(output)}-#{$$}")
    if File.exist?(zig_binary)
      FileUtils.mv(zig_binary, output)
      write_build_signature(output, signature)
    end
  end

  # For profile builds, copy the transpiled Zig to the profile dir
  # so `clear doctor` can map Zig lines back to CLEAR lines via // CLR:N.
  if profile
    profile_dir_path = output + ".profile"
    FileUtils.mkdir_p(profile_dir_path) if File.directory?(File.dirname(profile_dir_path))
    FileUtils.cp(tmp_zig, File.join(profile_dir_path, "transpiled.zig")) rescue nil
  end

  unless success
    # Map known Zig errors to CLEAR-level messages
    if compile_output.include?("unable to perform tail call")
      $stderr.puts "\e[31m[CLEAR Error]\e[0m @reentrant:tailCall failed: the Zig backend cannot " \
                   "perform tail call optimization on this target.\n" \
                   "  - Debug builds (default) use the stage2 backend which does not support TCO.\n" \
                   "  - Use --optimized or --safe to enable the LLVM backend with TCO support.\n" \
                   "  - Or remove :tailCall and use @reentrant with @canSmash instead."
    else
      $stderr.puts compile_output
    end
    error "Compilation failed"
  end

  # Return compile output for test mode
  compile_output
end

# -------------------------------------------------------------------------
# Commands
# -------------------------------------------------------------------------
case ARGV[0]
when 'build'
  args = ARGV[1..] || []

  # --fix / --fix=auto: on build failure, invoke `clear fix` on the
  # source then retry once. Implemented via subprocess so the build's
  # existing exit-on-error behaviour doesn't leak into the retry path.
  fix_mode = detect_fix_mode(args)
  if fix_mode
    sub_args = args - %w[--fix --fix=auto --fix=yes]
    source   = first_positional_arg(sub_args)
    error "Usage: clear build --fix <file.cht>" unless source
    run_with_fix_retry(__FILE__, 'build', sub_args, source, fix_mode)
    exit 0
  end

  output = nil
  opt_level = 'Debug'
  extra_flags = ['-fno-llvm', '-fno-lld']
  use_c_allocator = false

  # Parse build flags
  remaining = []
  stack_check = nil  # auto: on for release/safe, off for debug
  i = 0
  while i < args.length
    case args[i]
    when '-o'
      output = args[i + 1]
      error "-o requires an output path" unless output
      i += 2
    when '--debug'
      opt_level = 'Debug'
      extra_flags = ['-fno-llvm', '-fno-lld']
      i += 1
    when '--safe'
      opt_level = 'ReleaseSafe'
      extra_flags = []
      i += 1
    when '--optimized', '--release', '--fast'
      opt_level = 'ReleaseFast'
      extra_flags = []
      i += 1
    when '--stack-check'
      stack_check = true  # explicit override
      i += 1
    when '--no-stack-check'
      stack_check = false  # explicit override
      i += 1
    when '--force', '--no-cache'
      @force_build = true
      i += 1
    when '--mir'
      # No-op: MIR is the only pipeline. Flag kept for backward compat.
      i += 1
    when '--use-c-allocator'
      use_c_allocator = true
      i += 1
    else
      remaining << args[i]
      i += 1
    end
  end

  source = remaining.first
  error "Usage: clear build <file.cht> [-o output] [--release|--safe] [--stack-check] [--force]" unless source

  # Auto-detect stack check: off for debug (20MB binaries make objdump slow), on for release/safe.
  stack_check = (opt_level != 'Debug') if stack_check.nil?

  default_stack = (opt_level == 'Debug') ? 'Large' : nil
  result = do_build(source, output: output, opt_level: opt_level, extra_flags: extra_flags, default_stack: default_stack, force: !!@force_build, use_c_allocator: use_c_allocator)
  output_path = output || File.join(File.dirname(File.expand_path(source)), File.basename(source, '.cht'))
  exit 0 if result == :up_to_date
  puts "Built: #{output_path}"

  # Post-build stack verification and exact sizing
  if stack_check && File.exist?(output_path) && File.read(source).scan(/REQUIRE\s+"pkg:([^"]+)"/).empty?
    require_relative 'src/mir/stack_verifier'
    require_relative 'src/backends/transpiler'

    begin
      src_text = File.read(source)
      tokens = Lexer.new(src_text).tokenize
      ast = Parser.new(tokens, src_text).parse
      annotator = SemanticAnnotator.new
      annotator.annotate!(ast)
      fn_nodes = annotator.instance_variable_get(:@fn_nodes)

      base_name = File.basename(source, '.cht')
      prefix = "._clear_tmp_#{base_name}"
      verifier = StackVerifier.new(output_path, prefix)

      # Phase 1: Per-function frame size report
      report = verifier.analyze(fn_nodes: fn_nodes, source_file: source)
      verifier.print_report(report)

      # Verify tail calls in release builds
      tco_results = verifier.verify_tail_calls(fn_nodes)
      tco_results.each do |r|
        if r[:tco_verified]
          $stderr.puts "\e[32m[tco verified]\e[0m '#{r[:name]}' - no self-call instructions (tail call optimized)"
        else
          $stderr.puts "\e[31m[tco FAILED]\e[0m '#{r[:name]}' - contains call-to-self (NOT tail-call optimized)"
        end
      end

      # Phase 2: Exact stack sizing via call graph analysis
      tier_order = { micro: 0, standard: 1, large: 2, xl: 3 }
      optimal = verifier.compute_optimal_tiers(fn_nodes: fn_nodes)
      main_optimal = verifier.compute_main_optimal_tier

      if optimal.any? || main_optimal
        verifier.print_tier_report(optimal)

        if main_optimal
          $stderr.puts "    main fiber: #{main_optimal[:path_cost]} bytes -> #{main_optimal[:optimal_tier].to_s.upcase}"
        end

        # Find BG blocks in the AST to check user annotations
        bg_nodes = []
        ast.statements.each do |stmt|
          next unless stmt.is_a?(AST::FunctionDef)
          find_bg_blocks(stmt.body, bg_nodes)
        end

        needs_rebuild = false
        exact = {}
        exact_main_tier = nil

        optimal.each do |r|
          idx = r[:bg_index]
          bg_node = bg_nodes[idx]
          user_tier = bg_node&.stack_size  # explicit user annotation (e.g. @micro)
          computed = bg_node&.computed_stack_tier
          optimal_tier = r[:optimal_tier]

          if user_tier
            # User explicitly picked a tier. Error if it will overflow.
            user_sym = user_tier.to_s.downcase.to_sym
            if tier_order.fetch(user_sym, 0) < tier_order.fetch(optimal_tier, 0)
              $stderr.puts "\e[31m[stack error]\e[0m BG##{idx}: user annotation @#{user_tier} " \
                           "(#{StackVerifier::TIER_BUDGET[user_sym]} bytes) is too small. " \
                           "Deepest call path needs #{r[:path_cost]} bytes (#{optimal_tier})."
              exit 1
            end
          else
            # No user annotation. Auto-size: upgrade or downsize as needed.
            current_tier = computed || :standard
            if tier_order.fetch(optimal_tier, 0) != tier_order.fetch(current_tier, 0)
              exact[idx] = optimal_tier
              needs_rebuild = true
            end
          end
        end

        # Main fiber exact sizing
        if main_optimal
          current_main = fn_nodes["main"]&.stack_tier || :standard
          optimal_main = main_optimal[:optimal_tier]
          if tier_order.fetch(optimal_main, 0) != tier_order.fetch(current_main, 0)
            exact_main_tier = optimal_main
            needs_rebuild = true
          end
        end

        # Phase 3: Rebuild with exact tiers
        if needs_rebuild
          $stderr.puts ""
          exact.each { |idx, tier| $stderr.puts "  [exact] BG##{idx}: #{tier} (auto-sized)" }
          $stderr.puts "  [exact] main fiber: #{exact_main_tier} (auto-sized)" if exact_main_tier
          $stderr.puts "  Rebuilding with exact stack sizes..."
          do_build(source, output: output, opt_level: opt_level, extra_flags: extra_flags,
                   default_stack: default_stack, force: true, exact_tiers: exact,
                   main_tier: exact_main_tier)
          puts "Rebuilt: #{output_path}"
        end
      end
    rescue => e
      $stderr.puts "[stack-check] Analysis failed: #{e.message}"
      $stderr.puts e.backtrace.first(3).join("\n")
    end
  end

when 'run'
  # Split on -- for pass-through args
  idx = ARGV.index('--')
  if idx
    clear_args = ARGV[1...idx]
    run_args = ARGV[(idx + 1)..]
  else
    clear_args = ARGV[1..] || []
    run_args = []
  end

  # --fix: same retry pattern as `clear build --fix`.
  fix_mode = detect_fix_mode(clear_args)
  if fix_mode
    sub_args = clear_args - %w[--fix --fix=auto --fix=yes]
    source   = first_positional_arg(sub_args)
    error "Usage: clear run --fix <file.cht>" unless source
    full_args = sub_args.dup
    full_args += ['--'] + run_args unless run_args.empty?
    run_with_fix_retry(__FILE__, 'run', full_args, source, fix_mode)
    exit 0
  end

  # Parse run flags
  opt_level = 'Debug'
  extra_flags = ['-fno-llvm', '-fno-lld']
  use_c_allocator = false
  no_cache = false
  run_remaining = []
  clear_args.each do |arg|
    case arg
    when '--optimized', '--release', '--fast'
      opt_level = 'ReleaseFast'
      extra_flags = []
    when '--safe'
      opt_level = 'ReleaseSafe'
      extra_flags = []
    when '--debug'
      opt_level = 'Debug'
      extra_flags = ['-fno-llvm', '-fno-lld']
    when '--mir'
      # No-op: MIR is the only pipeline. Flag kept for backward compat.
    when '--use-c-allocator'
      use_c_allocator = true
    when '--no-cache'
      no_cache = true
    else
      run_remaining << arg
    end
  end

  source = run_remaining.first
  error "Usage: clear run <file.cht> [--optimized|--safe] [-- args...]" unless source

  source = File.expand_path(source)
  output = File.join(File.dirname(source), File.basename(source, '.cht'))
  default_stack = (opt_level == 'Debug') ? 'Large' : nil
  do_build(source, output: output, opt_level: opt_level, extra_flags: extra_flags, default_stack: default_stack, use_c_allocator: use_c_allocator, force: no_cache)

  # Hints
  unless ENV['CLEAR_THREADS']
    hint "set CLEAR_THREADS=0 for multi-threaded fiber runtime"
  end
  unless find_alloc_preload
    hint "install libjemalloc-dev for better allocator performance"
  end

  # Run
  preload = find_alloc_preload
  env = preload ? "LD_PRELOAD=#{preload} " : ""
  cmd = "#{env}#{output} #{run_args.join(' ')}".strip
  exec(cmd)

when 'test'
  test_args = ARGV[1..] || []
  profile_mode = test_args.delete('--profile')
  strict_mode = test_args.delete('--strict')
  frame_debug = test_args.delete('--debug-frame') || test_args.delete('--no-frame')
  test_args.delete('--mir')  # No-op: MIR is the only pipeline
  source = test_args.first
  error "Usage: clear test <file.cht|directory> [--profile] [--strict] [--debug-frame]" unless source
  frame_env = frame_debug ? "CLEAR_FRAME_DEBUG=1 " : ""

  if File.directory?(source)
    gen_script = File.join(CLEAR_ROOT, 'transpile-tests', 'gen.rb')
    puts "Generating tests..."
    system("#{frame_env}ruby #{gen_script}")
    puts "Running tests..."
    passed = 0
    failed = 0
    failed_names = []
    leak_tests = []
    current_test = nil
    last_completed_test = nil
    leak_seen = {}
    zig_test_cmd = [
      ZIG, 'test',
      'all-tests.zig',
      *RUNTIME_FILES,
      '-lc'
    ].join(' ')

    zig_test_status = nil
    zig_output = +""
    IO.popen("cd #{ZIG_DIR} && #{zig_test_cmd} 2>&1") do |io|
      io.each_line do |line|
        zig_output << line
        # Zig test result format: "N/M all-tests.test.NAME...OK" or "...FAIL"
        # Result may be on the same line (inline) or a standalone "OK"/"FAIL" line.
        if line =~ %r{^(\d+)/(\d+)\s+all-tests\.test\.(.+?)\.\.\.\s*(.*)$}
          current_test = $3
          result = $4.strip
        else
          result = nil
          # Standalone result line (test printed output before result)
          result = line.strip if current_test && line.strip =~ /^(OK|FAIL)\b/
        end

        # Track leaks: GPA output appears after the test's OK/FAIL line,
        # so attribute to last_completed_test when current_test is nil.
        if line.include?('[gpa] (err)') && line.include?('leaked')
          leaker = current_test || last_completed_test
          if leaker && !leak_seen[leaker]
            leak_seen[leaker] = true
            leak_tests << leaker
          end
        end

        next unless current_test

        if result == 'OK'
          print "\e[32m.\e[0m"
          passed += 1
          last_completed_test = current_test
          current_test = nil
        elsif result =~ /^FAIL/ || line.include?('Segmentation fault at address')
          print "\e[31mF\e[0m"
          failed += 1
          failed_names << current_test
          last_completed_test = current_test
          current_test = nil
        elsif line.include?('error: the following test command crashed')
          print "\e[31mF\e[0m"
          failed += 1
          failed_names << current_test
          last_completed_test = current_test
          current_test = nil
        end
      end
      Process.wait(io.pid)
      zig_test_status = $?
    end

    unless zig_test_status&.success?
      $stderr.print(zig_output)
      error "Directory test run failed"
    end
    puts
    puts
    if failed_names.any?
      puts
      puts "  \e[31m\e[1mFAILURES:\e[0m"
      failed_names.each { |n| puts "    \e[31m\e[1m#{n}\e[0m" }
      puts
      puts "  \e[31m\e[1m#{passed} passed, #{failed} FAILED, #{passed + failed} total\e[0m"
    else
      puts "  \e[32m#{passed} passed, #{passed} total\e[0m"
    end

    puts
    if leak_tests.any?
      puts "  \e[31m\e[1mMEMORY LEAKS: #{leak_tests.size}\e[0m"
      leak_tests.each { |n| puts "    \e[31m\e[1m#{n}\e[0m" }
    else
      puts "  \e[32m\e[1mMEMORY LEAKS: 0\e[0m"
    end
    puts
    exit(failed_names.any? ? 1 : 0)
  else
    source = File.expand_path(source)
    gen_script = File.join(CLEAR_ROOT, 'transpile-tests', 'gen.rb')

    # Transpile via gen.rb --single to get a proper zig test block
    zig_code = `#{frame_env}ruby #{gen_script} --single #{source} 2>/dev/null`
    unless $?.success?
      # Re-run with stderr visible for error messages
      system("ruby #{gen_script} --single #{source} > /dev/null")
      error "Transpilation failed"
    end
    zig_code = zig_code.gsub('@import("runtime-header.zig")', '@import("runtime/runtime-header.zig")')

    # Write to a minimal per-process build dir matching normal build layout.
    # Transpiled tests import runtime/runtime-header.zig and lib/* via
    # directory-relative paths; top-level zig/*.zig symlinks are no longer
    # sufficient after the Zig 0.16 runtime/layout changes.
    base_name = File.basename(source, '.cht')
    build_dir = File.join(ZIG_DIR, ".build-#{$$}")
    FileUtils.mkdir_p(build_dir)
    ensure_symlink(File.join(build_dir, 'runtime'), File.join(ZIG_DIR, 'runtime'))
    ensure_symlink(File.join(build_dir, 'lib'), File.join(ZIG_DIR, 'lib'))
    ensure_symlink(File.join(build_dir, 'experimental'), File.join(ZIG_DIR, 'experimental'))
    source_dir = File.dirname(File.expand_path(source))
    extern_modules = File.read(source).scan(/FROM\s+"([^"]+)"/).flatten.uniq
    ffi_modules = extern_modules.select { |m|
      !m.start_with?('std.') && File.exist?(File.join(source_dir, "#{m}.zig"))
    }
    ffi_modules.each { |m| FileUtils.cp(File.join(source_dir, "#{m}.zig"), File.join(build_dir, "#{m}.zig")) }
    tmp_name = "._clear_tmp_#{base_name}.zig"
    tmp_zig = File.join(build_dir, tmp_name)
    File.write(tmp_zig, zig_code)

    # Compile and run with zig test
    cmd_parts = [ZIG, 'test']
    cmd_parts += [tmp_name, 'runtime/switch.S', 'runtime/onRoot.S']
    cmd_parts += ['-lc', '--test-filter', "\"#{File.basename(source)}\""]
    cmd = cmd_parts.join(' ')
    compile_output = `cd #{build_dir} && #{cmd} 2>&1`
    success = $?.success?
    FileUtils.rm_rf(build_dir)

    if !success || compile_output.include?('FAIL')
      $stderr.puts "\e[31m\e[1mTEST FAILED\e[0m"
      $stderr.puts compile_output
      exit 1
    end
    puts compile_output unless compile_output.strip.empty?
    exit 0
  end

when 'benchmark'
  source = ARGV[1]
  error "Usage: clear benchmark <file.cht>" unless source
  # Benchmark mode: same as test but also runs BENCHMARK/SMASH blocks
  do_build(source, module_mode: true, default_stack: 'Large')
  puts "Benchmarks complete."

when 'profile'
  # Split on -- for pass-through args
  idx = ARGV.index('--')
  if idx
    clear_args = ARGV[1...idx]
    run_args = ARGV[(idx + 1)..]
  else
    clear_args = ARGV[1..] || []
    run_args = []
  end

  source = clear_args.first
  error "Usage: clear profile <file.cht> [-- args...]" unless source

  source = File.expand_path(source)
  base_name = File.basename(source, '.cht')
  output = File.join(File.dirname(source), base_name)
  profile_dir = File.join(File.dirname(source), "#{base_name}.profile")
  FileUtils.mkdir_p(profile_dir)

  alloc_file = File.join(profile_dir, 'alloc.txt')
  perf_data = File.join(profile_dir, 'perf.data')
  callgrind_file = File.join(profile_dir, 'callgrind.out')

  # Build ReleaseFast with profiling enabled. Debug symbols retained (-fno-strip)
  # for addr2line resolution.
  do_build(source, output: output, opt_level: 'ReleaseFast', profile: true)
  puts "Built: #{output} (ReleaseFast + alloc profiling)"

  # Copy the CLEAR source alongside the transpiled.zig so `clear doctor`
  # can show source snippets next to hot-line attributions.
  FileUtils.cp(source, File.join(profile_dir, 'source.cht')) rescue nil

  # CPU profiling via perf
  has_perf = system('which perf > /dev/null 2>&1') &&
    File.readable?('/proc/sys/kernel/perf_event_paranoid') &&
    File.read('/proc/sys/kernel/perf_event_paranoid').strip.to_i <= 2

  # Build the run command
  channel_file = File.join(profile_dir, 'channels.txt')
  fiber_file   = File.join(profile_dir, 'fibers.txt')
  lock_file    = File.join(profile_dir, 'locks.txt')
  env_parts = [
    "CLEAR_ALLOC_PROFILE=#{alloc_file}",
    "CLEAR_CHANNEL_PROFILE=#{channel_file}",
    "CLEAR_FIBER_PROFILE=#{fiber_file}",
    "CLEAR_LOCK_PROFILE=#{lock_file}",
  ]
  env_parts << "CLEAR_THREADS=#{ENV['CLEAR_THREADS']}" if ENV['CLEAR_THREADS']
  target_env = env_parts.join(' ')

  if has_perf
    cmd = "perf record -g -o #{perf_data} -- env #{target_env} #{output} #{run_args.join(' ')}".strip
  else
    hint "perf unavailable (perf_event_paranoid > 2). CPU profiling skipped."
    cmd = "env #{target_env} #{output} #{run_args.join(' ')}".strip
  end

  strace_file = File.join(profile_dir, 'syscalls.txt')
  perf_stat_file = File.join(profile_dir, 'perf-stat.txt')

  puts "Profiling: #{cmd}"
  system(cmd)

  # Collect syscall summary and hardware counters (separate quick runs)
  puts "Collecting syscall profile..."
  system("strace -c -o #{strace_file} env #{target_env} #{output} #{run_args.join(' ')} > /dev/null 2>&1")
  if has_perf
    system("perf stat -e cycles,instructions,branches,branch-misses,cache-references,cache-misses,L1-dcache-loads,L1-dcache-load-misses,LLC-loads,LLC-load-misses,page-faults -o #{perf_stat_file} env #{target_env} #{output} #{run_args.join(' ')} > /dev/null 2>&1")
  end

  puts ""
  puts "Profile data: #{profile_dir}/"
  puts "  Heap:     #{alloc_file} (#{File.exist?(alloc_file) ? "#{(File.size(alloc_file) / 1024.0).round(1)} KB" : 'not generated'})"
  if has_perf && File.exist?(perf_data)
    puts "  CPU:      #{perf_data} (#{(File.size(perf_data) / 1024.0).round(1)} KB)"
  end
  puts "  Syscalls: #{strace_file}" if File.exist?(strace_file)
  puts "  Counters: #{perf_stat_file}" if File.exist?(perf_stat_file)

when 'doctor'
  profile_dir = ARGV[1]
  error "Usage: clear doctor <profile-dir>" unless profile_dir && Dir.exist?(profile_dir)

  alloc_file = File.join(profile_dir, 'alloc.txt')
  perf_data  = File.join(profile_dir, 'perf.data')

  # Find the binary (same dir as profile, minus .profile/ suffix)
  binary = profile_dir.chomp('/').sub(/\.profile$/, '')
  binary = nil unless File.exist?(binary.to_s)

  # ── Heap Profile ──
  if File.exist?(alloc_file)
    lines = File.readlines(alloc_file).reject { |l| l.start_with?('#') || l.strip.empty? }
    total_line = File.readlines(alloc_file).find { |l| l.include?('total_allocs') }
    total = total_line ? total_line.scan(/\d+/).last.to_i : 0

    sites = lines.map do |line|
      parts = line.strip.split
      next nil if parts.size < 6
      addr = parts[0]
      { addr: addr, allocs: parts[1].to_i, bytes: parts[2].to_i,
        frees: parts[3].to_i, free_bytes: parts[4].to_i, live: parts[5].to_i }
    end.compact.sort_by { |s| -s[:bytes] }

    # Resolve addresses to source via addr2line
    if binary
      resolved = {}
      addrs = sites.map { |s| s[:addr] }
      # Batch addr2line call
      raw = IO.popen(['addr2line', '-e', binary, '-f'] + addrs, err: '/dev/null', &:read)
      lines_out = raw.split("\n")
      addrs.each_with_index do |addr, i|
        func = lines_out[i * 2]&.strip || "?"
        file = lines_out[i * 2 + 1]&.strip || "?"
        # Map Zig source to CLEAR: use saved transpiled.zig for CLR:N lookup
        clear_line = nil
        zig_source = File.join(profile_dir, 'transpiled.zig')
        if file =~ /:(\d+)/ && File.exist?(zig_source)
          zig_line = $1.to_i
          zig_lines = @_zig_lines ||= File.readlines(zig_source)
          (zig_line - 1).downto(0) do |li|
            break if li < 0 || li >= zig_lines.size
            if zig_lines[li] =~ %r{// CLR:(\d+)}
              clear_line = $1.to_i
              break
            end
          end
        end
        # Clean up function names: strip Zig mangling
        func = func.sub(/.*\./, '').sub(/__anon_\d+/, '')
        resolved[addr] = { func: func, file: file, clear_line: clear_line }
      end
    end

    puts "=== Allocation Profile (#{total.to_s.gsub(/(\d)(?=(\d{3})+$)/, '\\1,')} allocs) ==="
    puts ""
    puts "Top sites by bytes:"
    sites.first(10).each_with_index do |s, i|
      r = resolved&.dig(s[:addr])
      func = r ? r[:func] : s[:addr]
      loc = if r&.dig(:clear_line) then "(line #{r[:clear_line]})"
            elsif r then "(#{r[:file].split('/').last})"
            else "" end
      avg = s[:allocs] > 0 ? s[:bytes] / s[:allocs] : 0
      kb = s[:bytes] / 1024.0
      leak = if s[:frees] == 0 && s[:allocs] > 0 && avg >= 16
               # rcCreate alloc tracking: frees always 0 (rcRelease uses different
               # return address so it doesn't decrement this site's counter).
               "  (heap rc)"
             elsif s[:frees] == 0 && s[:allocs] > 0
               # Frame-arena (smartAlloc): frees==0 is normal — rewind frees in bulk.
               "  (arena)"
             elsif s[:frees] > 0 && s[:frees] < s[:allocs]
               "  ** LEAK ** (#{s[:allocs] - s[:frees]} unfreed)"
             else
               ""
             end
      if kb >= 1.0
        puts "  #{i + 1}. %-25s %6.1f KB  (%s allocs, %d bytes avg)%s" % [
          "#{func} #{loc}", kb, s[:allocs].to_s.gsub(/(\d)(?=(\d{3})+$)/, '\\1,'), avg, leak]
      else
        puts "  #{i + 1}. %-25s %6d B   (%s allocs, %d bytes avg)%s" % [
          "#{func} #{loc}", s[:bytes], s[:allocs].to_s.gsub(/(\d)(?=(\d{3})+$)/, '\\1,'), avg, leak]
      end
    end
    arena_count  = sites.first(10).count { |s| s[:frees] == 0 && s[:allocs] > 0 && (s[:allocs] > 0 ? s[:bytes] / s[:allocs] : 0) < 16 }
    heap_rc_count = sites.first(10).count { |s| s[:frees] == 0 && s[:allocs] > 0 && (s[:allocs] > 0 ? s[:bytes] / s[:allocs] : 0) >= 16 }
    leak_count   = sites.first(10).count { |s| s[:frees] > 0 && s[:frees] < s[:allocs] }
    if arena_count > 0 && leak_count == 0
      puts "  (arena) = frame-arena allocation, freed in bulk by rewind (not a leak)"
    end
    if heap_rc_count > 0
      puts "  (heap rc) = @multiowned RC allocation tracked by rcCreate"
    end
    puts ""
  else
    puts "No heap profile found at #{alloc_file}"
  end

  # ── CPU Profile ──
  if File.exist?(perf_data)
    puts "=== CPU Profile ==="
    puts ""
    report = `perf report -i #{perf_data} --stdio --no-children 2>/dev/null`
    top = report.lines.select { |l| l =~ /^\s+\d+\.\d+%/ }.first(10)
    if top.any?
      top.each { |l| puts "  #{l.strip}" }
    else
      puts "  (no samples collected - program may have run too briefly)"
    end
    puts ""

    # ── CLEAR Source Hot Lines ──
    # Attributes perf samples to CLEAR source lines by (a) asking perf
    # for srcline-sorted samples against the transpiled Zig, (b)
    # mapping each Zig line back to its CLEAR source line via the
    # `// CLR:N` comments the transpiler emits. Pipeline stages (lines
    # containing `s>`) are called out explicitly — they're the most
    # common perf "why is this slow" question.
    zig_source = File.join(profile_dir, 'transpiled.zig')
    clear_source = File.join(profile_dir, 'source.cht')
    if File.exist?(zig_source) && File.exist?(perf_data)
      zig_to_clear = {}
      current_clear = nil
      File.readlines(zig_source).each_with_index do |line, idx|
        if line =~ %r{// CLR:(\d+)}
          current_clear = $1.to_i
        end
        zig_to_clear[idx + 1] = current_clear if current_clear
      end

      srcline_out = `perf report -i #{perf_data} --stdio --no-children -g none --sort=srcline 2>/dev/null`
      clear_samples = Hash.new(0.0)
      # The running binary's debug info points perf at the original temp
      # Zig file (`._clear_tmp_<name>.zig` or `<basename>.zig`), not the
      # profile-dir copy. Match any Zig filename that isn't a known
      # runtime/stdlib file.
      runtime_zigs = %w[
        runtime.zig slab-alloc.zig parking-lot.zig Allocator.zig
        compiler_rt.zig array_list.zig format.zig fmt.zig io.zig
        start.zig mem.zig math.zig std.zig
      ].to_set
      srcline_out.each_line do |line|
        next unless line =~ /^\s*(\d+\.\d+)%.*?(\S+\.zig):(\d+)/
        pct = $1.to_f
        file = File.basename($2)
        zig_line = $3.to_i
        next if runtime_zigs.include?(file)
        clear_line = zig_to_clear[zig_line]
        clear_samples[clear_line] += pct if clear_line
      end

      if clear_samples.any?
        puts "=== CLEAR Source Hot Lines ==="
        puts ""
        source_lines = File.exist?(clear_source) ? File.readlines(clear_source) : []
        top = clear_samples.sort_by { |_, pct| -pct }.first(10)
        top.each do |line_no, pct|
          snippet = source_lines[line_no - 1]&.rstrip || ''
          # Detect `s>` as a standalone token. Avoid matching identifiers
          # that happen to contain the substring.
          pipeline = snippet =~ /(^|[\s(;])s>/ ? ' [pipeline stage]' : ''
          trimmed = snippet.lstrip[0, 64]
          puts "  %5.1f%%  line %-4d  %s%s" % [pct, line_no, trimmed, pipeline]
        end
        puts ""
      end
    end
  end

  # ── Channel Saturation ──
  # Each BoundedChannel records pushes, pops, push_blocked, pop_blocked,
  # max_depth, capacity (comptime-gated in the runtime). Ratios reveal
  # fast-producer-slow-consumer (producer blocks often + max_depth at
  # capacity) or slow-producer-fast-consumer (consumer blocks often +
  # max_depth nowhere near capacity).
  channel_file = File.join(profile_dir, 'channels.txt')
  if File.exist?(channel_file)
    rows = File.readlines(channel_file).reject { |l| l.start_with?('#') || l.strip.empty? }
    channels = rows.map do |l|
      f = l.split
      next nil if f.size < 7
      {
        id: f[0].to_i, pushes: f[1].to_i, pops: f[2].to_i,
        push_blocked: f[3].to_i, pop_blocked: f[4].to_i,
        max_depth: f[5].to_i, capacity: f[6].to_i,
      }
    end.compact.reject { |c| c[:pushes] == 0 && c[:pops] == 0 }

    if channels.any?
      puts "=== Channel Saturation ==="
      puts ""
      printf "  %-4s %10s %10s %10s %10s %8s  %s\n",
             "id", "pushes", "pops", "pblk", "cblk", "depth/cap", "diagnosis"
      channels.each do |c|
        cap = c[:capacity]
        ratio = cap > 0 ? (c[:max_depth].to_f / cap * 100).round : 0
        push_blk_pct = c[:pushes] > 0 ? (c[:push_blocked].to_f / c[:pushes] * 100).round : 0
        pop_blk_pct  = c[:pops]   > 0 ? (c[:pop_blocked].to_f  / c[:pops]   * 100).round : 0
        diagnosis =
          if push_blk_pct >= 20 && ratio >= 80
            "slow consumer (producer blocked #{push_blk_pct}%, max depth #{ratio}%)"
          elsif pop_blk_pct >= 20 && ratio < 50
            "slow producer (consumer blocked #{pop_blk_pct}%, max depth #{ratio}%)"
          elsif push_blk_pct >= 20 || pop_blk_pct >= 20
            "backpressure (push #{push_blk_pct}% / pop #{pop_blk_pct}%)"
          else
            "balanced"
          end
        printf "  %-4d %10d %10d %10d %10d %7d%% %s\n",
               c[:id], c[:pushes], c[:pops], c[:push_blocked], c[:pop_blocked], ratio, diagnosis
      end
      puts ""
    end
  end

  # ── Fibers & Workstealing Balance ──
  # Parses `.profile/fibers.txt`: fiber-lifetime summary + per-scheduler
  # fibers-run counter. Diagnoses micro-fiber overhead (fibers dominated
  # by sub-10us setup cost) and scheduler imbalance (one scheduler doing
  # most of the work while others are idle).
  fiber_file = File.join(profile_dir, 'fibers.txt')
  if File.exist?(fiber_file)
    totals = {}
    sched_rows = []
    in_sched = false
    File.readlines(fiber_file).each do |l|
      s = l.strip
      next if s.empty? || s.start_with?('#') && !s.include?('per-scheduler')
      if s.include?('per-scheduler')
        in_sched = true
        next
      end
      if in_sched
        f = s.split
        next if f.size < 2
        sched_rows << { idx: f[0].to_i, runs: f[1].to_i } if f[0] =~ /\A\d+\z/
      else
        if s =~ /\A(\w+):\s*(\d+)/
          totals[$1] = $2.to_i
        end
      end
    end

    if totals['total_fibers'] && totals['total_fibers'] > 0
      total = totals['total_fibers']
      short = totals['short_fibers_under_1ms'] || 0
      vshort = totals['vshort_fibers_under_10us'] || 0
      total_ns = totals['total_lifetime_ns'] || 0
      max_ns = totals['max_lifetime_ns'] || 0
      avg_ns = total > 0 ? total_ns / total : 0
      short_pct  = total > 0 ? (short.to_f / total * 100).round : 0
      vshort_pct = total > 0 ? (vshort.to_f / total * 100).round : 0

      puts "=== Fibers ==="
      puts ""
      puts "  total:   #{total}"
      puts "  average: #{(avg_ns / 1000.0).round(1)} us"
      puts "  max:     #{(max_ns / 1000.0).round(1)} us"
      puts "  < 1ms:   #{short} (#{short_pct}%)"
      puts "  < 10us:  #{vshort} (#{vshort_pct}%)"
      if vshort_pct >= 50 && total >= 50
        puts ""
        puts "  *** #{vshort_pct}% of fibers finished in under 10us. Setup cost"
        puts "      likely dominates work. Consider inlining, batching, or"
        puts "      a pool of long-lived workers instead of per-item BG."
      end
      puts ""
    end

    if sched_rows.any?
      puts "=== Workstealing Balance ==="
      puts ""
      total_runs = sched_rows.sum { |r| r[:runs] }
      max_runs   = sched_rows.map { |r| r[:runs] }.max || 0
      sched_rows.each do |r|
        pct = total_runs > 0 ? (r[:runs].to_f / total_runs * 100).round : 0
        bar = '█' * (pct * 40 / 100.0).round
        puts "  sched #{r[:idx]}: %6d  %3d%% %s" % [r[:runs], pct, bar]
      end
      imbalance_pct = total_runs > 0 ? (max_runs.to_f / total_runs * 100).round : 0
      if sched_rows.length >= 2 && imbalance_pct >= 80
        puts ""
        puts "  *** Scheduler imbalance: one scheduler ran #{imbalance_pct}%"
        puts "      of all fibers. Other schedulers were idle. BG spawn"
        puts "      policy may be routing too aggressively to a single target."
      end
      puts ""
    end
  end

  # ── Lock Hold & Contention ──
  # Per-mutex stats from ParkingMutex + ParkingRwLock (write path).
  # Each row = one unique lock instance. Diagnoses:
  #   - high contention  (contended_acquires / acquires > 20%)
  #   - long critical sections (avg hold > 1ms)
  #   - hot lock (>10k acquires; recommends finer-grained locking)
  lock_prof = File.join(profile_dir, 'locks.txt')
  if File.exist?(lock_prof)
    rows = File.readlines(lock_prof).reject { |l| l.start_with?('#') || l.strip.empty? }
    locks = rows.map do |l|
      f = l.split
      next nil if f.size < 7
      {
        addr: f[0], acquires: f[1].to_i, contended: f[2].to_i,
        total_wait_ns: f[3].to_i, max_wait_ns: f[4].to_i,
        total_hold_ns: f[5].to_i, max_hold_ns: f[6].to_i,
      }
    end.compact.reject { |c| c[:acquires] == 0 }.sort_by { |c| -c[:total_hold_ns] }

    if locks.any?
      puts "=== Lock Hold & Contention ==="
      puts ""
      printf "  %-12s %8s %6s %12s %10s %12s %10s  %s\n",
             "addr", "acqs", "cont%", "avg_hold", "max_hold", "avg_wait", "max_wait", "diagnosis"
      locks.first(10).each do |l|
        cont_pct = l[:acquires] > 0 ? (l[:contended].to_f / l[:acquires] * 100).round : 0
        avg_hold = l[:acquires] > 0 ? l[:total_hold_ns] / l[:acquires] : 0
        avg_wait = l[:acquires] > 0 ? l[:total_wait_ns] / l[:acquires] : 0

        diagnosis =
          if cont_pct >= 20 && avg_hold > 1_000_000
            "hot lock + long hold — break up the critical section"
          elsif cont_pct >= 20
            "contended — consider @mvcc or finer-grained locking"
          elsif avg_hold > 1_000_000
            "long critical section (#{(avg_hold / 1_000_000.0).round(1)}ms avg)"
          elsif l[:acquires] >= 100_000
            "hot lock (very frequent; low overhead but possible bottleneck)"
          else
            "ok"
          end

        printf "  %-12s %8d %5d%% %10.1fus %8.1fus %10.1fus %8.1fus  %s\n",
               l[:addr], l[:acquires], cont_pct,
               avg_hold / 1000.0, l[:max_hold_ns] / 1000.0,
               avg_wait / 1000.0, l[:max_wait_ns] / 1000.0,
               diagnosis
      end
      puts ""
    end
  end

  # ── Syscalls ──
  strace_file = File.join(profile_dir, 'syscalls.txt')
  if File.exist?(strace_file)
    puts "=== Syscalls ==="
    puts ""
    lines = File.readlines(strace_file).select { |l| l =~ /^\s+[\d.]+\s+[\d.]+/ }
    lines.first(10).each { |l| puts "  #{l.rstrip}" }
    total = File.readlines(strace_file).find { |l| l.include?('total') }
    puts "  #{total.rstrip}" if total
    puts ""
  end

  # ── Hardware Counters ──
  perf_stat_file = File.join(profile_dir, 'perf-stat.txt')
  hw = {}        # event_name -> integer count (unsupported events absent)
  llc_miss_rate = nil

  if File.exist?(perf_stat_file)
    puts "=== Hardware Counters ==="
    puts ""
    File.readlines(perf_stat_file).each do |l|
      next if l.strip.empty? || l.start_with?('#') || l.start_with?('Performance')
      puts "  #{l.rstrip}" if l =~ /\d/
      next if l.include?('<not supported>')
      # Parse: "    1,234,567      event-name:u     # comment"
      m = l.match(/^\s*([\d,]+)\s+([\w:-]+)/)
      next unless m
      hw[m[2].sub(/:u?$/, '')] = m[1].gsub(',', '').to_i
    end

    # Derived metrics
    cycles       = hw['cycles']
    instructions = hw['instructions']
    branches     = hw['branches']
    branch_miss  = hw['branch-misses']
    # cache-references / cache-misses are the LLC-level events on x86
    # (LLC-loads / LLC-load-misses unsupported on most VMs/laptops)
    llc_loads    = hw['LLC-loads']    || hw['cache-references']
    llc_misses   = hw['LLC-load-misses'] || hw['cache-misses']

    ipc = (cycles && instructions && cycles > 0) ?
            (instructions.to_f / cycles).round(2) : nil
    llc_miss_rate = (llc_loads && llc_misses && llc_loads > 0) ?
                      (llc_misses.to_f / llc_loads * 100).round(1) : nil
    branch_miss_pct = (branches && branch_miss && branches > 0) ?
                        (branch_miss.to_f / branches * 100).round(1) : nil

    puts ""
    puts "  Analysis:"
    if ipc
      ipc_note = ipc < 1.0 ? " (low — memory or branch bound)" :
                 ipc >= 2.0 ? " (good — compute bound)" : ""
      puts "    IPC: #{ipc}#{ipc_note}"
    end
    if llc_miss_rate
      llc_note = llc_miss_rate > 20 ? " *** HIGH — working set exceeds cache" :
                 llc_miss_rate > 10 ? " (moderate)" : " (low)"
      puts "    LLC miss rate: #{llc_miss_rate}%#{llc_note}"
    end
    if branch_miss_pct
      branch_note = branch_miss_pct > 5 ? " *** HIGH — unpredictable control flow" : ""
      puts "    Branch miss rate: #{branch_miss_pct}%#{branch_note}"
    end
    puts ""
  end

  # ── FREEZE Recommendation ──
  # Fires when: high LLC miss rate + many small scattered heap allocations
  # (the signature of individually malloc'd tree/list nodes).
  STRING_OPS = %w[concat charAtCodepoint intToString floatToString smartAlloc].freeze
  FREEZE_LLC_THRESHOLD  = 20   # % LLC miss rate to consider high
  FREEZE_MIN_ALLOCS     = 5_000
  FREEZE_MIN_AVG_BYTES  = 16   # below this = arena string/int bytes, not struct nodes
  FREEZE_MAX_AVG_BYTES  = 512

  if llc_miss_rate && llc_miss_rate >= FREEZE_LLC_THRESHOLD && sites&.any?
    candidates = sites.select do |s|
      avg = s[:allocs] > 0 ? s[:bytes] / s[:allocs] : 0
      r   = resolved&.dig(s[:addr])
      fn  = r ? r[:func] : ''
      s[:allocs] >= FREEZE_MIN_ALLOCS &&
        avg >= FREEZE_MIN_AVG_BYTES && avg <= FREEZE_MAX_AVG_BYTES &&
        STRING_OPS.none? { |op| fn.include?(op) }
    end.sort_by { |s| -s[:bytes] }

    # For RC alloc sites that resolve to entryWrapper (inlined in ReleaseFast),
    # scan the transpiled.zig for rcCreate call sites to find CLEAR source lines.
    rc_clear_lines = []
    zig_source = File.join(profile_dir, 'transpiled.zig')
    if File.exist?(zig_source)
      zig_lines = File.readlines(zig_source)
      zig_lines.each_with_index do |line, li|
        next unless line.include?('rcCreate')
        (li - 1).downto(0) do |ci|
          break if ci < 0
          if zig_lines[ci] =~ %r{// CLR:(\d+)}
            rc_clear_lines << $1.to_i
            break
          end
        end
      end
      rc_clear_lines.uniq!
    end

    if candidates.any?
      puts "=== FREEZE Opportunity ==="
      puts ""
      puts "  LLC cache miss rate is #{llc_miss_rate}% (high). Detected scattered"
      puts "  node-level heap allocations — likely pointer-chasing through"
      puts "  individually malloc'd structs."
      puts ""
      puts "  Candidates (many small allocs from same site):"
      candidates.first(5).each do |s|
        r   = resolved&.dig(s[:addr])
        # In ReleaseFast builds, RC alloc sites inline into entryWrapper.
        # Fall back to transpiled.zig rcCreate line scan for CLEAR location.
        loc = if r&.dig(:clear_line)
                "line #{r[:clear_line]}"
              elsif r && r[:func] != 'entryWrapper' && !r[:func].empty?
                r[:func]
              elsif rc_clear_lines.any?
                "line #{rc_clear_lines.first}"
              else
                s[:addr]
              end
        avg  = s[:bytes] / s[:allocs]
        mb   = s[:bytes] / (1024.0 * 1024.0)
        puts "    %-32s  %s allocs × %d bytes avg  (%.1f MB)" % [
          loc,
          s[:allocs].to_s.gsub(/(\d)(?=(\d{3})+$)/, '\\1,'),
          avg, mb
        ]
      end
      puts ""
      puts "  If these nodes form a tree or acyclic graph, FREEZE can pack"
      puts "  them into a single contiguous allocation, eliminating pointer-"
      puts "  chasing cache misses. Measured speedup: 3-5x for working sets"
      puts "  larger than L3 cache."
      puts ""
      puts "  Zig:         const frozen = try freeze(T, alloc, root_ptr);"
      puts "  CLEAR:       frozen = FREEZE expr"
      puts ""
    end
  end

when 'fix'
  require_relative 'src/ast/lexer'
  require_relative 'src/ast/parser'
  require_relative 'src/ast/fixable_error'
  require_relative 'src/ast/syntax_typo_scanner'
  require_relative 'src/annotator'

  args = ARGV[1..] || []
  dry_run       = false
  take_first    = false
  only_set      = nil
  paths         = []

  args.each do |a|
    case a
    when '--dry-run' then dry_run = true
    when '--yes'     then take_first = true
    when /\A--only=(.+)/ then only_set = $1.split(',').map(&:to_sym).to_set
    when /\A-/       then error "Unknown flag for fix: #{a}"
    else paths << a
    end
  end

  error "Usage: clear fix [--dry-run|--yes|--only=cat1,cat2] <file.cht>..." if paths.empty?

  paths.each do |path|
    error "No such file: #{path}" unless File.file?(path)
    source = File.read(path)

    # Run lexer + parser + annotator in collector mode. The parser and
    # annotator both raise CompilerError / ParserError on unrecoverable
    # errors; we swallow so the collector's captured findings surface.
    FixCollector.enable!
    findings = []
    begin
      # Rule-based operator-typo scan runs BEFORE the lexer so typos
      # (|> for s>, => for ->) surface as fixable findings even when
      # the lexer/parser would otherwise reject the source.
      SyntaxTypoScanner.scan!(source)
      begin
        tokens = Lexer.new(source).tokenize
        ast    = Parser.new(tokens, source).parse
        annotator = SemanticAnnotator.new
        annotator.source_code = source
        annotator.annotate!(ast)
      rescue CompilerError, ParserError
      end
      findings = FixCollector.drain
    ensure
      FixCollector.disable!
    end

    findings = findings.select { |f| only_set.nil? || only_set.include?(f.category) }

    if findings.empty?
      puts "#{path}: no fixable findings"
      next
    end

    # Order findings by position, then dedupe by (line, col, message).
    findings = findings.sort_by { |f| [f.token&.line || 0, f.token&.column || 0] }

    queued_edits = []
    findings.each do |f|
      auto_fix = f.fixes.find { |fx| fx.confidence == :auto }

      if dry_run
        describe_finding(f)
        next
      end

      chosen =
        if auto_fix
          auto_fix
        elsif take_first
          f.fixes.first
        else
          describe_finding(f)
          prompt_choice(f)
        end

      if chosen
        puts "  #{path}:#{f.token&.line}:#{f.token&.column}  [#{f.category}]  #{f.message}"
        puts "    -> #{chosen.description}"
        queued_edits.concat(chosen.edits.map { |e| [path, e] })
      end
    end

    next if dry_run || queued_edits.empty?

    # Group edits by file, apply right-to-left by (line, col) within each
    # file so earlier edits don't shift later byte offsets.
    by_file = queued_edits.group_by(&:first)
    applied_count = 0
    by_file.each do |file_key, rows|
      target_path = file_key || path
      text = File.read(target_path)
      edits = rows.map { |(_, e)| e }
               .sort_by { |e| [e.span.line, e.span.col] }
      edits = dedupe_overlapping_edits(edits)
      edits = edits.reverse  # right-to-left application keeps offsets stable
      text = apply_edits(text, edits)
      File.write(target_path, text)
      applied_count += edits.length
    end
    puts "#{path}: applied #{applied_count} edit(s)"
  end

when 'fmt', 'format'
  require_relative 'src/backends/formatter'

  args = ARGV[1..] || []
  check_only = false
  to_stdout  = false
  paths = []

  warn_width = true
  args.each do |a|
    case a
    when '--check' then check_only = true
    when '--stdout' then to_stdout = true
    when '--no-warn' then warn_width = false
    when /\A-/ then error "Unknown flag for fmt: #{a}"
    else paths << a
    end
  end

  error "Usage: clear fmt [--check|--stdout] <file.cht|dir>..." if paths.empty?

  files = []
  paths.each do |p|
    if File.directory?(p)
      files.concat(Dir.glob(File.join(p, '**', '*.cht')).sort)
    elsif File.file?(p)
      files << p
    else
      error "No such file or directory: #{p}"
    end
  end
  error "No .cht files found" if files.empty?

  changed = 0
  failed  = 0

  files.each do |path|
    begin
      src = File.read(path)
      out = Formatter.format(src)
    rescue Formatter::Error => e
      warn "#{path}: #{e.message}"
      failed += 1
      next
    end

    if warn_width
      out.each_line.with_index(1) do |ln, idx|
        stripped = ln.sub(/\n\z/, '')
        len = stripped.length
        if len > 120
          warn "#{path}:#{idx}: warning: line length #{len} exceeds 120"
        end
      end
    end

    if to_stdout
      print out
      next
    end

    if out == src
      next
    end

    changed += 1
    if check_only
      warn "#{path}: not formatted"
    else
      File.write(path, out)
      puts path
    end
  end

  if failed > 0
    exit 2
  elsif check_only && changed > 0
    exit 1
  end

