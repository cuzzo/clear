      clear fix --dry-run <file>    Show findings and chosen fixes, do not write
      clear fix --yes <file>        Take the first fix for every finding
      clear fix --only=lint,... <f> Restrict to categories (lint, ownership, ...)
      clear c-ffi <h> <out> --link <lib>  Generate formatted CLEAR C declarations
      clear c-ffi <h> <out> --link <lib> --check  Fail when generated declarations are stale
      clear fmt <file|dir>...       Format CLEAR source in place
      clear fmt --check <path>...   Exit 1 if any file is not formatted
      clear fmt --stdout <file>     Print formatted output, do not write
      clear fmt --no-warn <path>    Suppress width warnings for >120-char lines
