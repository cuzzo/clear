#!/usr/bin/env ruby
# clear - CLEAR language compiler CLI
#
# Usage:
#   clear build foo.cht [-o output] [--release|--safe]
#   clear run foo.cht [-- args...]
#   clear test foo.cht
#
# See docs/clear-man.md for full documentation.

require 'fileutils'
require 'optparse'

# Resolve paths relative to this script (works from any directory)
CLEAR_ROOT = File.expand_path('..', __FILE__)
ZIG_DIR    = File.join(CLEAR_ROOT, 'zig')
SRC_DIR    = File.join(CLEAR_ROOT, 'src')
TRANSPILER = File.join(SRC_DIR, 'transpiler.rb')

# Find Zig compiler
ZIG = [
  File.join(ZIG_DIR, 'zig-new', 'zig'),
  File.join(ZIG_DIR, 'zig', 'zig'),
  `which zig 2>/dev/null`.strip
].find { |p| !p.empty? && File.exist?(p) } || 'zig'

# Runtime files needed for linking
RUNTIME_FILES = %w[switch.S onRoot.S].map { |f| File.join(ZIG_DIR, f) }

# Detect jemalloc/tcmalloc
def find_alloc_preload
  Dir.glob('/lib/x86_64-linux-gnu/libjemalloc.so*').first ||
    Dir.glob('/usr/lib/libjemalloc.so*').first ||
    Dir.glob('/usr/local/lib/libjemalloc.so*').first ||
    Dir.glob('/lib/x86_64-linux-gnu/libtcmalloc.so*').first
end

def hint(msg)
  $stderr.puts "\e[33mhint:\e[0m #{msg}"
end

def error(msg)
  $stderr.puts "\e[31merror:\e[0m #{msg}"
  exit 1
end

# -------------------------------------------------------------------------
# Build: transpile + compile
# -------------------------------------------------------------------------
def do_build(source, output: nil, opt_level: 'Debug', extra_flags: [], module_mode: false, default_stack: nil, profile: false)
  error "File not found: #{source}" unless File.exist?(source)
  source = File.expand_path(source)
  source_dir = File.dirname(source)
  base_name = File.basename(source, '.cht')

  # Output binary path
  output ||= File.join(source_dir, base_name)

  # Transpile
  transpile_flag = module_mode ? '--test' : ''
  transpile_flag += " --default-stack #{default_stack}" if default_stack
  tmp_name = "._clear_tmp_#{base_name}.zig"
  tmp_zig = File.join(ZIG_DIR, tmp_name)

  zig_code = `ruby #{TRANSPILER} #{transpile_flag} #{source} 2>/dev/null`
  unless $?.success?
    # Re-run with stderr visible for error messages
    system("ruby #{TRANSPILER} #{transpile_flag} #{source} > /dev/null")
    error "Transpilation failed"
  end
  # Inject comptime profiling flag when building with `clear profile`.
  # This enables allocation tracking in the runtime allocator VTable
  # with zero overhead in production builds.
  if profile
    zig_code = "pub const CLEAR_PROFILE = true;\n" + zig_code
  end
  File.write(tmp_zig, zig_code)

  # Auto-detect FFI modules: scan source for EXTERN ... FROM "module" declarations
  # and check if a matching .zig file exists in the source directory.
  source_text = File.read(source)
  extern_modules = source_text.scan(/FROM\s+"([^"]+)"/).flatten.uniq
  ffi_modules = extern_modules.select { |m|
    # Skip standard library modules (std.json, std.fs, etc.)
    !m.start_with?('std.') && File.exist?(File.join(source_dir, "#{m}.zig"))
  }

  # Copy FFI modules to zig/ for compilation
  ffi_modules.each { |m| FileUtils.cp(File.join(source_dir, "#{m}.zig"), File.join(ZIG_DIR, "#{m}.zig")) }

  # Build Zig command (runs from zig/ directory where runtime files live)
  if module_mode
    # Test mode: zig test with same imports as standalone (runtime-header.zig)
    cmd_parts = [ZIG, 'test']
    if ffi_modules.any?
      ffi_modules.each { |m| cmd_parts += ['--dep', m] }
      cmd_parts += ["-Mroot=#{tmp_name}", '-lc', 'switch.S', 'onRoot.S']
      ffi_modules.each { |m| cmd_parts += ["-M#{m}=#{m}.zig"] }
    else
      cmd_parts += [tmp_name, '-lc', 'switch.S', 'onRoot.S']
    end
  else
    cmd_parts = [ZIG, 'build-exe']
    if ffi_modules.any?
      ffi_modules.each { |m| cmd_parts += ['--dep', m] }
      cmd_parts += ["-Mroot=#{tmp_name}", '-lc', 'switch.S', 'onRoot.S']
      ffi_modules.each { |m| cmd_parts += ["-M#{m}=#{m}.zig"] }
    else
      cmd_parts += [tmp_name, '-lc', 'switch.S', 'onRoot.S']
    end
    cmd_parts += ['-O', opt_level] + extra_flags + ['--name', File.basename(output)]
  end

  cmd = cmd_parts.join(' ')
  compile_output = `cd #{ZIG_DIR} && #{cmd} 2>&1`
  success = $?.success?

  # Move binary to output location (zig puts it in zig/)
  if success && !module_mode
    zig_binary = File.join(ZIG_DIR, File.basename(output))
    if File.exist?(zig_binary)
      FileUtils.mv(zig_binary, output)
    end
  end

  # Cleanup temp files
  FileUtils.rm_f(tmp_zig)
  ffi_modules.each { |m| FileUtils.rm_f(File.join(ZIG_DIR, "#{m}.zig")) }

  unless success
    $stderr.puts compile_output
    error "Compilation failed"
  end

  # Return compile output for test mode
  compile_output
end

# -------------------------------------------------------------------------
# Commands
# -------------------------------------------------------------------------
case ARGV[0]
when 'build'
  args = ARGV[1..] || []
  output = nil
  opt_level = 'Debug'
  extra_flags = ['-fno-llvm', '-fno-lld']

  # Parse build flags
  remaining = []
  i = 0
  while i < args.length
    case args[i]
    when '-o'
      output = args[i + 1]
      error "-o requires an output path" unless output
      i += 2
    when '--debug'
      opt_level = 'Debug'
      extra_flags = ['-fno-llvm', '-fno-lld']
      i += 1
    when '--safe'
      opt_level = 'ReleaseSafe'
      extra_flags = []
      i += 1
    when '--optimized', '--release', '--fast'
      opt_level = 'ReleaseFast'
      extra_flags = []
      i += 1
    else
      remaining << args[i]
      i += 1
    end
  end

  source = remaining.first
  error "Usage: clear build <file.cht> [-o output] [--release|--safe]" unless source

  default_stack = (opt_level == 'Debug') ? 'Large' : nil
  do_build(source, output: output, opt_level: opt_level, extra_flags: extra_flags, default_stack: default_stack)
  output_path = output || File.join(File.dirname(File.expand_path(source)), File.basename(source, '.cht'))
  puts "Built: #{output_path}"

when 'run'
  # Split on -- for pass-through args
  idx = ARGV.index('--')
  if idx
    clear_args = ARGV[1...idx]
    run_args = ARGV[(idx + 1)..]
  else
    clear_args = ARGV[1..] || []
    run_args = []
  end

  source = clear_args.first
  error "Usage: clear run <file.cht> [-- args...]" unless source

  source = File.expand_path(source)
  output = File.join(File.dirname(source), File.basename(source, '.cht'))
  do_build(source, output: output)

  # Hints
  unless ENV['CLEAR_THREADS']
    hint "set CLEAR_THREADS=0 for multi-threaded fiber runtime"
  end
  unless find_alloc_preload
    hint "install libjemalloc-dev for better allocator performance"
  end

  # Run
  preload = find_alloc_preload
  env = preload ? "LD_PRELOAD=#{preload} " : ""
  cmd = "#{env}#{output} #{run_args.join(' ')}".strip
  exec(cmd)

when 'test'
  source = ARGV[1]
  error "Usage: clear test <file.cht|directory>" unless source

  if File.directory?(source)
    # Directory mode: generate all-tests.zig and run via zig test (like gen.rb)
    gen_script = File.join(CLEAR_ROOT, 'transpile-tests', 'gen.rb')
    puts "Generating tests..."
    system("ruby #{gen_script}")
    puts "Running tests..."
    success = system("cd #{ZIG_DIR} && #{ZIG} test all-tests.zig -lc switch.S onRoot.S")
    exit(success ? 0 : 1)
  else
    output = do_build(source, module_mode: true)
    puts output unless output.strip.empty?
  end

when 'profile'
  # Split on -- for pass-through args
  idx = ARGV.index('--')
  if idx
    clear_args = ARGV[1...idx]
    run_args = ARGV[(idx + 1)..]
  else
    clear_args = ARGV[1..] || []
    run_args = []
  end

  source = clear_args.first
  error "Usage: clear profile <file.cht> [-- args...]" unless source

  source = File.expand_path(source)
  base_name = File.basename(source, '.cht')
  output = File.join(File.dirname(source), base_name)
  profile_dir = File.join(File.dirname(source), "#{base_name}.profile")
  FileUtils.mkdir_p(profile_dir)

  alloc_file = File.join(profile_dir, 'alloc.txt')
  perf_data = File.join(profile_dir, 'perf.data')
  callgrind_file = File.join(profile_dir, 'callgrind.out')

  # Build optimized with profiling enabled (comptime CLEAR_PROFILE flag)
  do_build(source, output: output, opt_level: 'ReleaseFast', profile: true)
  puts "Built: #{output} (ReleaseFast + alloc profiling)"

  # CPU profiling: perf (best) > callgrind (fallback) > none
  has_perf = system('which perf > /dev/null 2>&1') &&
    File.readable?('/proc/sys/kernel/perf_event_paranoid') &&
    File.read('/proc/sys/kernel/perf_event_paranoid').strip.to_i <= 2
  has_callgrind = !has_perf && system('which valgrind > /dev/null 2>&1')

  # Build the run command
  env_parts = ["CLEAR_ALLOC_PROFILE=#{alloc_file}"]
  env_parts << "CLEAR_THREADS=#{ENV['CLEAR_THREADS']}" if ENV['CLEAR_THREADS']
  target_env = env_parts.join(' ')

  if has_perf
    cmd = "perf record -g -o #{perf_data} -- env #{target_env} #{output} #{run_args.join(' ')}".strip
  elsif has_callgrind
    cmd = "valgrind --tool=callgrind --callgrind-out-file=#{callgrind_file} -- env #{target_env} #{output} #{run_args.join(' ')} 2>/dev/null".strip
  else
    cmd = "env #{target_env} #{output} #{run_args.join(' ')}".strip
  end

  cpu_tool = has_perf ? "perf" : (has_callgrind ? "callgrind" : "none")
  puts "Profiling (CPU: #{cpu_tool}): #{cmd}"
  system(cmd)

  puts ""
  puts "Profile data: #{profile_dir}/"
  puts "  Heap: #{alloc_file} (#{File.exist?(alloc_file) ? "#{(File.size(alloc_file) / 1024.0).round(1)} KB" : 'not generated'})"
  if has_perf
    puts "  CPU:  #{perf_data} (#{File.exist?(perf_data) ? "#{(File.size(perf_data) / 1024.0).round(1)} KB" : 'skipped'})"
  elsif has_callgrind && File.exist?(callgrind_file)
    puts "  CPU:  #{callgrind_file} (#{(File.size(callgrind_file) / 1024.0).round(1)} KB)"
    puts "        View: callgrind_annotate #{callgrind_file} | head -40"
  else
    hint "No CPU profiler available. Install perf or valgrind."
  end

when 'help', '--help', '-h', nil
  puts <<~HELP
    CLEAR Language Compiler

    Usage:
      clear build <file.cht> [-o output] [--optimized|--safe|--debug]
      clear run <file.cht> [-- args...]
      clear test <file.cht>         Test a single file
      clear test <directory>        Test all .cht files in directory

    Commands:
      build    Transpile and compile a CLEAR program to a native binary
      run      Build and execute a CLEAR program
      test     Build and run tests (uses test harness with leak detection)

    Build flags:
      -o PATH       Output binary path (default: same dir as source)
      (default)     Fast build, Zig backend, no LLVM (~2s)
      --debug       Same as default (explicit)
      --optimized   Full LLVM optimization (-O ReleaseFast, ~22s)
      --safe        LLVM + safety checks (-O ReleaseSafe, ~28s)

    Environment:
      CLEAR_THREADS  Number of scheduler threads (0 = auto, 1 = single)

    See docs/clear-man.md for full documentation.
  HELP

else
  error "Unknown command: #{ARGV[0]}. Run 'clear help' for usage."
end
