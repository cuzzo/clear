REQUIRE "pkg:rtoc_6173742f747970652e636c656172" AS type
REQUIRE "pkg:rtoc_6173742f6173742e636c656172" AS ast
REQUIRE "pkg:rtoc_616e6e6f7461746f722f68656c706572732f696e7472696e7369635f72656769737472792e636c656172" AS intrinsic_registry
REQUIRE "pkg:rtoc_6d69722f6d69722e636c656172" AS mir
REQUIRE "pkg:rtoc_6d69722f686f6973742e636c656172" AS hoist
REQUIRE "pkg:rtoc_6d69722f66696265725f6374785f6275696c6465722e636c656172" AS fiber_ctx_builder
REQUIRE "pkg:rtoc_73656d616e7469632f74656e73655f6f7065726174696f6e5f706c616e2e636c656172" AS tense_operation_plan
REQUIRE "pkg:rtoc_6d69722f6c6f776572696e672f636f756e746572732e636c656172" AS counters
REQUIRE "pkg:rtoc_6d69722f6d69725f6c6f776572696e672e636c656172" AS mir_lowering
REQUIRE "pkg:rtoc_73656d616e7469632f6c6966656379636c655f706c616e2e636c656172" AS lifecycle_plan
REQUIRE "pkg:rtoc_6d69722f636c65616e75705f656e7472792e636c656172" AS cleanup_entry
# Ruby module MIRLoweringExpressions
PUB UNION StructLitFieldType { FunctionType: FunctionType, TypeMultiowned: Type@multiowned, SymbolValue: String@symbol, StringValue: String, InlineStructVariantMultiowned: InlineStructVariant@multiowned, Type: Type }
PUB ENUM OptionalOperandSide { Left, Right }
PUB STRUCT OrElseExitFacts {
  kind: ?String,
  error_name: ?String,
  name_id: ?Int64,
  clear_type: Bool,
  has_message: Bool,
  line: Int64
}
PUB STRUCT OrElseFacts {
  left_is_error: Bool,
  left_success_optional: Bool,
  line: Int64,
  target: String@symbol
}
PUB STRUCT BinaryIntArithmeticFacts {
  both_int: Bool,
  has_comptime_number_literal: Bool,
  has_float_coercion: Bool
}
PUB STRUCT UnitVariantAccess {
  type_name: String@symbol,
  variant_name: String
}
PUB STRUCT BinaryMirOperands {
  left: Emittable,
  right: Emittable
}
PUB STRUCT BinaryOperandFacts {
  node: BinaryOp,
  op: String@symbol,
  left: Emittable,
  right: Emittable,
  left_type: Type,
  right_type: Type,
  int_arithmetic: BinaryIntArithmeticFacts,
  left_unit_variant: ?UnitVariantAccess,
  right_unit_variant: ?UnitVariantAccess
}
PUB STRUCT BinaryOperationPlan {
  kind: String@symbol,
  facts: BinaryOperandFacts,
  builtin: ?String@symbol,
  op_str: ?String,
  type_arg: ?String,
  variant: ?UnitVariantAccess,
  tag_source: ?String@symbol,
  union_error_type: ?String@symbol,
  optional_side: ?OptionalOperandSide,
  optional_capture: ?String
}
PUB STRUCT FieldAccessPlan {
  target: Emittable,
  field: String,
  path: String@symbol,
  union_payload: Bool,
  union_payload_zig: ?String,
  indirect: Bool
}

PRIVATE FN fieldAccessPlan__union_payload?(self: FieldAccessPlan) RETURNS Bool ->
  RETURN self.union_payload;
END
PUB FN fieldAccessPlan__value(self: FieldAccessPlan) RETURNS Emittable ->
  RETURN fieldAccessPlan__value_for(self, self.target);
END
PRIVATE FN fieldAccessPlan__value_for(self: FieldAccessPlan, root: Emittable) RETURNS Emittable ->
  MUTABLE result =   IF fieldAccessPlan__union_payload?(self) THEN
    UnionVariantGet{ object: COPY root, variant: COPY self.field, zig_type: COPY UNWRAP (self.union_payload_zig), lowered_node_id: NIL, ownership_consumption: NIL }
  ELSE
    FieldGet{ object: COPY fieldAccessPlan__field_root(self, root), field: COPY self.field, lowered_node_id: NIL, ownership_consumption: NIL }
  END;
  IF self.indirect THEN
    RETURN Emittable{ Deref: COPY Deref{ expr: COPY result, lowered_node_id: NIL, ownership_consumption: NIL } };
  ELSE
    RETURN result;
  END
END
PRIVATE FN fieldAccessPlan__field_root(self: FieldAccessPlan, root: Emittable) RETURNS Emittable ->
  IF (self.path == :ctrl_data) THEN
    RETURN Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ FieldGet: COPY FieldGet{ object: COPY root, field: "ctrl", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "data", lowered_node_id: NIL, ownership_consumption: NIL } };
  ELSE_IF (self.path == :comptime_ctrl_data) THEN
    RETURN Emittable{ ComptimeCarrierPayload: COPY ComptimeCarrierPayload{ source: COPY root, lowered_node_id: NIL, ownership_consumption: NIL } };
  ELSE_IF (self.path == :data) THEN
    RETURN Emittable{ FieldGet: COPY FieldGet{ object: COPY root, field: "data", lowered_node_id: NIL, ownership_consumption: NIL } };
  ELSE
    RETURN COPY root;
  END
END
PUB STRUCT IndexAccessPlan {
  target: Emittable,
  index: Emittable,
  optional: Bool,
  optional_source: ?Emittable,
  target_ast: Locatable,
  type_info: Type,
  target_name: ?String,
  needs_mut_ref: Bool,
  rank_indices: ?[]Emittable
}

PUB FN indexAccessPlan__optional?(self: IndexAccessPlan) RETURNS Bool ->
  RETURN self.optional;
END
PUB STRUCT RankCoordinates {
  dimensions: Emittable,
  indices: ArrayInit
}
optional_comparison_ops: [6]String@symbol = [:EQ, :NEQ, :LT, :LTE, :GT, :GTE];
# End Ruby module MIRLoweringExpressions
