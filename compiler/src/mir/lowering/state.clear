PUB STRUCT StubInfo {
  kind: String@symbol,
  var: String
}

STRUCT MIRLoweringInput {
  struct_schemas: {String@symbol}StructSchema@multiowned,
  enum_schemas: {String@symbol}[]TypeEnumVariantsItem,
  union_schemas: {String@symbol}UnionSchema@multiowned,
  schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult,
  lifecycle_registry: LifecycleRegistry@multiowned,
  fn_sigs: {String@symbol}FunctionSignature@multiowned,
  moved_guard_info: {String}{String}Bool,
  importer: ?ModuleImporter@multiowned,
  source_dir: ?String,
  debug_mode: Bool,
  target: String@symbol,
  function_counter_seeds: {String}MIRLoweringCounterSnapshot
}
STRUCT MIRLoweringRuntimeState {
  rt_name: String,
  emitter: ?MIREmitter@multiowned
}

PUB FN mIRLoweringRuntimeState__emitter_mut(MUTABLE self: MIRLoweringRuntimeState) RETURNS MIREmitter@multiowned ->
  MUTABLE current: ?MIREmitter@multiowned = COPY self.emitter;
  IF current EXISTS AS current_value THEN
    RETURN KEEP current_value;
  END
  current = mIREmitter__new();
  self.emitter = current;
  RETURN current_value;
END
FN mIRLoweringRuntimeState__with_rt_name<U>(MUTABLE self: MIRLoweringRuntimeState, rt_name: String, blk: FN() -> U) RETURNS U ->
MUTABLE previous = COPY self.rt_name;
DEFER self.rt_name = previous;
self.rt_name = COPY rt_name;
RETURN blk();
END
STRUCT ConstInitEntry {
  name: String,
  zig_type: String,
  init: Emittable,
  type_info: ?Type,
  prelude: []Emittable
}
STRUCT MIRLoweringProgramState {
  fn_sigs: {String@symbol}FunctionSignature@multiowned,
  shard_context: ?{String@symbol}String,
  emitted_extern_modules: [Set]String,
  pipeline_host: ?PipelineHost@multiowned,
  importer: ?ModuleImporter@multiowned,
  source_dir: ?String,
  emitted_types: [Set]String,
  emitted_require_modules: [Set]String,
  emitted_import_type_aliases: [Set]String,
  debug_mode: Bool,
  target: String@symbol,
  used_sharded_map: Bool,
  use_debug_allocator: ?Bool,
  fn_nodes: {String}FunctionDef@multiowned,
  function_counter_snapshots: {String}MIRLoweringCounterSnapshot,
  runtime_init_consts: []ConstInitEntry,
  module_const_inits: [Set]String,
  module_global_names: [Set]String
}
STRUCT MIRLoweringCaptureState {
  current_bg_pointer_captures: ?[Set]String,
  current_lambda_pointer_params: [Set]String,
  current_fiber_capture_symbols: {String}SymbolEntry@multiowned,
  do_capture_map: ?{String}String,
  current_stream_is_inf: ?Bool,
  current_stream_local: ?String,
  current_stream_close_label: ?String,
  current_fsm_inherited_alloc_names: [Set]String,
  current_fsm_inherited_guarded_names: [Set]String,
  current_fsm_owned_result_guards: {String}String,
  last_fsm_result_transfer_facts: []FsmResultTransferFact
}
STRUCT MIRLoweringCapabilityState {
  locked_unwrap_map: ?{String}LockedUnwrapMapValue,
  rc_unwrap_map: ?{String}String,
  with_alias_alloc_map: ?{String}?String@symbol,
  with_alias_owner_map: ?{String}String,
  polymorphic_alias_type_map: ?{String}String,
  if_bind_aliases: [Set]String,
  if_bind_pointer_aliases: [Set]String,
  atomic_emit_raw: Bool
}
STRUCT MIRLoweringOwnershipState {
  next_lowered_node_id: Int64,
  finalized_body_ids: [Set]LoweredBodyId,
  finalized_node_ids: [Set]LoweredNodeId
}
STRUCT MIRLoweringTestState {
  active_stubs: {String}StubInfo,
  stub_label_counter: Int64
}
STRUCT MIRLoweringState {
  input: MIRLoweringInput,
  schemas: MIRLoweringSchemas@multiowned,
  counters: MIRLoweringCounters@multiowned,
  function_state: FunctionState,
  runtime: MIRLoweringRuntimeState,
  program: MIRLoweringProgramState,
  capture: MIRLoweringCaptureState,
  capabilities: MIRLoweringCapabilityState,
  ownership: MIRLoweringOwnershipState,
  test: MIRLoweringTestState
}
