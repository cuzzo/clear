REQUIRE "pkg:rtoc_6173742f6173742e636c656172"
REQUIRE "pkg:rtoc_6173742f73796d626f6c5f656e7472792e636c656172"
REQUIRE "pkg:rtoc_73656d616e7469632f6c6966656379636c655f706c616e2e636c656172"
REQUIRE "pkg:rtoc_636f6d70696c65722f6d6f64756c655f696d706f727465722e636c656172"
