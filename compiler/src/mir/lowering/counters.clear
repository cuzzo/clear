PUB ENUM MIRLoweringCounterKind { Tmp, BlockExpr, SafeNav, Extern, Lambda, StreamLiteral, DoBlock, BackgroundBlock, StreamGenerator, LoopMark, ForLoop }
PUB STRUCT MIRLoweringGeneratedId {
  kind: MIRLoweringCounterKind,
  value: Int64
}

PUB FN mIRLoweringGeneratedId__to_s(self: MIRLoweringGeneratedId) RETURNS String EFFECTS REENTRANT ->
  RETURN COPY self.value.toString();
END
PUB STRUCT MIRLoweringCounterSnapshot {
  values: {String}Int64
}
PUB STRUCT MIRLoweringCounters {
  values: {String}Int64
}

counter_kinds: [11]MIRLoweringCounterKind = [MIRLoweringCounterKind.Tmp, MIRLoweringCounterKind.BlockExpr, MIRLoweringCounterKind.SafeNav, MIRLoweringCounterKind.Extern, MIRLoweringCounterKind.Lambda, MIRLoweringCounterKind.StreamLiteral, MIRLoweringCounterKind.DoBlock, MIRLoweringCounterKind.BackgroundBlock, MIRLoweringCounterKind.StreamGenerator, MIRLoweringCounterKind.LoopMark, MIRLoweringCounterKind.ForLoop];
PUB FN mIRLoweringCounters__initialize(MUTABLE self: MIRLoweringCounters) RETURNS Void ->
    self.values = {};
    FOR _ IN counter_kinds DO
    self.values[mIRLoweringCounters__counter_key(self, _)] = 0;
    END
END
PUB FN mIRLoweringCounters__next_tmp_id(MUTABLE self: MIRLoweringCounters) RETURNS MIRLoweringGeneratedId ->
    RETURN mIRLoweringCounters__next_one_based(&self, MIRLoweringCounterKind.Tmp);
END
PUB FN mIRLoweringCounters__next_block_expr_id(MUTABLE self: MIRLoweringCounters) RETURNS MIRLoweringGeneratedId ->
    RETURN mIRLoweringCounters__next_one_based(&self, MIRLoweringCounterKind.BlockExpr);
END
PUB FN mIRLoweringCounters__next_safe_nav_id(MUTABLE self: MIRLoweringCounters) RETURNS MIRLoweringGeneratedId ->
    RETURN mIRLoweringCounters__next_one_based(&self, MIRLoweringCounterKind.SafeNav);
END
PUB FN mIRLoweringCounters__next_extern_id(MUTABLE self: MIRLoweringCounters) RETURNS MIRLoweringGeneratedId ->
    RETURN mIRLoweringCounters__next_one_based(&self, MIRLoweringCounterKind.Extern);
END
PUB FN mIRLoweringCounters__next_lambda_id(MUTABLE self: MIRLoweringCounters) RETURNS MIRLoweringGeneratedId ->
    RETURN mIRLoweringCounters__next_one_based(&self, MIRLoweringCounterKind.Lambda);
END
PUB FN mIRLoweringCounters__next_stream_literal_id(MUTABLE self: MIRLoweringCounters) RETURNS MIRLoweringGeneratedId ->
    RETURN mIRLoweringCounters__next_zero_based(&self, MIRLoweringCounterKind.StreamLiteral);
END
PUB FN mIRLoweringCounters__next_do_block_id(MUTABLE self: MIRLoweringCounters) RETURNS MIRLoweringGeneratedId ->
    RETURN mIRLoweringCounters__next_zero_based(&self, MIRLoweringCounterKind.DoBlock);
END
PUB FN mIRLoweringCounters__next_background_block_id(MUTABLE self: MIRLoweringCounters) RETURNS MIRLoweringGeneratedId ->
    RETURN mIRLoweringCounters__next_zero_based(&self, MIRLoweringCounterKind.BackgroundBlock);
END
PUB FN mIRLoweringCounters__next_stream_generator_id(MUTABLE self: MIRLoweringCounters) RETURNS MIRLoweringGeneratedId ->
    RETURN mIRLoweringCounters__next_zero_based(&self, MIRLoweringCounterKind.StreamGenerator);
END
PUB FN mIRLoweringCounters__next_loop_mark_id(MUTABLE self: MIRLoweringCounters) RETURNS MIRLoweringGeneratedId ->
    RETURN mIRLoweringCounters__next_one_based(&self, MIRLoweringCounterKind.LoopMark);
END
PUB FN mIRLoweringCounters__next_for_loop_id(MUTABLE self: MIRLoweringCounters) RETURNS MIRLoweringGeneratedId ->
    RETURN mIRLoweringCounters__next_one_based(&self, MIRLoweringCounterKind.ForLoop);
END
PUB FN mIRLoweringCounters__snapshot(self: MIRLoweringCounters) RETURNS MIRLoweringCounterSnapshot ->
    RETURN MIRLoweringCounterSnapshot{ values: COPY self.values };
END
PUB FN mIRLoweringCounters__restore_mut(MUTABLE self: MIRLoweringCounters, snapshot_value: MIRLoweringCounterSnapshot) RETURNS Void ->
    self.values = COPY snapshot_value.values;
END
PRIVATE FN mIRLoweringCounters__next_one_based(MUTABLE self: MIRLoweringCounters, kind: MIRLoweringCounterKind) RETURNS MIRLoweringGeneratedId ->
    RETURN mIRLoweringCounters__next_id(&self, kind, 1);
END
PRIVATE FN mIRLoweringCounters__next_zero_based(MUTABLE self: MIRLoweringCounters, kind: MIRLoweringCounterKind) RETURNS MIRLoweringGeneratedId ->
    RETURN mIRLoweringCounters__next_id(&self, kind, 0);
END
PRIVATE FN mIRLoweringCounters__next_id(MUTABLE self: MIRLoweringCounters, kind: MIRLoweringCounterKind, offset: Int64) RETURNS MIRLoweringGeneratedId ->
    MUTABLE key = mIRLoweringCounters__counter_key(self, kind);
    MUTABLE value = self.values[key]?;
    self.values[key] = (value + 1);
    RETURN MIRLoweringGeneratedId{ kind: COPY kind, value: (value + offset) };
END
PRIVATE FN mIRLoweringCounters__counter_key(self: MIRLoweringCounters, kind: MIRLoweringCounterKind) RETURNS String ->
    IF (kind == MIRLoweringCounterKind.Tmp) THEN
      RETURN "tmp";
    END
    IF (kind == MIRLoweringCounterKind.BlockExpr) THEN
      RETURN "block_expr";
    END
    IF (kind == MIRLoweringCounterKind.SafeNav) THEN
      RETURN "safe_nav";
    END
    IF (kind == MIRLoweringCounterKind.Extern) THEN
      RETURN "extern";
    END
    IF (kind == MIRLoweringCounterKind.Lambda) THEN
      RETURN "lambda";
    END
    IF (kind == MIRLoweringCounterKind.StreamLiteral) THEN
      RETURN "stream_literal";
    END
    IF (kind == MIRLoweringCounterKind.DoBlock) THEN
      RETURN "do_block";
    END
    IF (kind == MIRLoweringCounterKind.BackgroundBlock) THEN
      RETURN "background_block";
    END
    IF (kind == MIRLoweringCounterKind.StreamGenerator) THEN
      RETURN "stream_generator";
    END
    IF (kind == MIRLoweringCounterKind.LoopMark) THEN
      RETURN "loop_mark";
    END
    RETURN "for_loop";
END
PUB FN mIRLoweringCounters__new() RETURNS MIRLoweringCounters@multiowned ->
  MUTABLE self = MIRLoweringCounters{ values: {} };
  mIRLoweringCounters__initialize(&self);
  RETURN self @multiowned;
END
