PUB UNION WithBindingNode { StringValue: String, Emittable: Emittable, ArrayValue: []Emittable }
PUB STRUCT FallibleClauseFact {
  var_name: String,
  alias_name: String,
  action_kind: ErrorActionKind,
  retries: ?Int64,
  matched_types: []String@symbol,
  bubble_types: []String@symbol,
  action_mir: []Emittable,
  exit_msg_mir: ?Emittable
}
PUB STRUCT WithCapabilityBindingContext {
  node: WithBlock,
  cap: CapabilityTransition,
  var_node: CapabilityVarNode,
  var_name: String,
  alias_name: String,
  resolved_type: ?Type,
  var_sync: ?String@symbol,
  var_storage: ?String@symbol,
  zig_var: String,
  clause: ?ErrorClause,
  with_label: ?String,
  needs_sort: Bool,
  rt_name: String
}
PUB STRUCT WithBindingMaterialization {
  bindings: []WithBindingNode,
  fallible_clauses: []FallibleClauseFact
}

PUB FN withBindingMaterialization__add_binding(MUTABLE self: WithBindingMaterialization, binding: WithBindingNode) RETURNS Void ->
  &self.bindings.append(COPY binding);
END
PUB FN withBindingMaterialization__add_fallible_clause(MUTABLE self: WithBindingMaterialization, clause: FallibleClauseFact) RETURNS Void ->
  &self.fallible_clauses.append(COPY clause);
END
PUB STRUCT LockBindingPlan {
  guard_var: String,
  alias_name: String,
  lock_expr: Emittable,
  lock_sync: ?String@symbol,
  clause: ?ErrorClause,
  with_label: ?String,
  with_node: WithBlock
}
PUB STRUCT MutableSnapshotCap {
  var_node: CapabilityVarNode,
  alias_name: String,
  source: Emittable,
  bare_type: Type,
  conflict_error: String@symbol
}
PUB STRUCT MutableSnapshotPlan {
  node: WithBlock,
  with_label: ?String,
  rt_name: String,
  alloc: String@symbol,
  body_mir: []Emittable,
  retries: ?Int64,
  capabilities: []MutableSnapshotCap
}
PUB UNION LockedUnwrapMapValue { StringValue: String, BoolValue: Bool }
