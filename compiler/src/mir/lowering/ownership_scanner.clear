: ProfileStmt }
PUB FN mIRLoweringOwnershipScanner__collect_bg_capture_transfer_roots(self: MIRLoweringOwnershipScanner, stmt: Locatable) RETURNS ![]String ->
  MUTABLE names: []String = ( { MUTABLE rtoc_empty_list_1: []String = List[]; rtoc_empty_list_1 } );
  aST__each_bg_block_in_stmt(stmt, %(bg_value: BgNode) USE(MUTABLE names, self) -> {
  MUTABLE body_names: [Set]String = Set[];
  aST__each_locatable_list( UNWRAP (bgNode__body(bg_value)), FALSE, %(node: Locatable) USE(MUTABLE body_names) -> {
    IF node IS_A Identifier AS identifier THEN
        &body_names.insert(COPY identifier__name(identifier));
    END
    rubyToClearVoid__ownership_scanner()
  });
  MUTABLE rtoc_each_items_2 = (((IF selectOp__capture_analysis(bg_value) != NIL THEN
      (selectOp__capture_analysis(bg_value)).move_mark_names()
    ELSE
      NIL
    END) OR_ELSE Set[]));
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < rtoc_each_items_2.length() DO
      IF !(body_names.contains?(CAST(UNWRAP (rtoc_each_items_2[rtoc_idx]) AS String))) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE entry = (self.bindings[CAST(UNWRAP (rtoc_each_items_2[rtoc_idx]) AS String)] OR_ELSE new({:produces_owned: FALSE, :alloc: NIL, :cleanup_kind: NIL, :requires_hoist: FALSE, :target_var: NIL}));
      IF cleanupEntry__present?(entry) THEN
          &names.append(COPY CAST(UNWRAP (rtoc_each_items_2[rtoc_idx]) AS String));
      END
    rtoc_idx = rtoc_idx + 1;
  END
  rubyToClearVoid__ownership_scanner()
  });
  RETURN CAST((names |> DISTINCT _) AS []String);
END
PUB FN mIRLoweringOwnershipScanner__collect_explicit_move_roots(self: MIRLoweringOwnershipScanner, node: Locatable) RETURNS ![]String ->
  MUTABLE names: []String = ( { MUTABLE rtoc_empty_list_3: []String = List[]; rtoc_empty_list_3 } );
  MUTABLE collect: FN(MIRLoweringOwnershipScannerScanRoot) -> Void = %(root) USE(MUTABLE names, self) -> aST__each_locatable_list(root, FALSE, %(child: Locatable) USE(MUTABLE names, self) -> {
  IF !(child IS_A MoveNode) THEN
      RETURN;
  END
  MUTABLE moved: ?String = mIRLoweringOwnershipScanner__moved_arg_root(self, child);
  IF moved EXISTS AS moved_value THEN
      &names.append(moved_value);
  END
  rubyToClearVoid__ownership_scanner()
  });
  collect( castLocatableToMIRLoweringOwnershipScannerScanRoot(node));
  aST__each_bg_block_in_stmt(node, %(bg_value: BgNode) USE(collect) -> {
  IF bgNode__body(bg_value) THEN
      collect(bgNode__body(bg_value));
  END
  rubyToClearVoid__ownership_scanner()
  });
  RETURN CAST((names |> DISTINCT _) AS []String);
END
PUB FN mIRLoweringOwnershipScanner__collect_moved_arg_roots(self: MIRLoweringOwnershipScanner, stmt: Locatable) RETURNS ![]String ->
  MUTABLE names: []String = ( { MUTABLE rtoc_empty_list_4: []String = List[]; rtoc_empty_list_4 } );
  IF aST__declaration_with_identifier_value?(stmt) THEN
    MUTABLE value: Identifier = CAST(aST__node_value(stmt) AS Identifier);
    MUTABLE ti: ?Type = TRY (type__from_node_mut(Locatable{ Identifier: COPY value }, "moved declaration root"));
    MUTABLE entry = (self.bindings[value.name] OR_ELSE new({:produces_owned: FALSE, :alloc: NIL, :cleanup_kind: NIL, :requires_hoist: FALSE, :target_var: NIL}));
    IF (TRY (mIRLoweringOwnershipScanner__ownership_tracked_transfer_type?(self, UNWRAP (ti))) AND cleanupEntry__present?(entry)) THEN
      &names.append(COPY value.name);
    END
  END
  mIRLoweringOwnershipScanner__walk_ast_for_moved_args(self, stmt, %(arg: Locatable) USE(MUTABLE names, stmt, MUTABLE ti, self) -> {
  IF mIRLoweringOwnershipScanner__arg_is_call_argument?(self, stmt, arg) THEN
      RETURN;
  END
  MUTABLE ti = TRY (type__from_node_mut(arg, "moved argument root"));
  IF !(TRY (mIRLoweringOwnershipScanner__ownership_tracked_transfer_type?(self, UNWRAP (ti)))) THEN
      RETURN;
  END
  MUTABLE root: ?String = mIRLoweringOwnershipScanner__moved_arg_root(self, arg);
  IF !(root) THEN
      RETURN;
  END
  MUTABLE ident = (aST__root_identifier(arg));
  MUTABLE entry = (self.bindings[UNWRAP (root)] OR_ELSE new({:produces_owned: FALSE, :alloc: NIL, :cleanup_kind: NIL, :requires_hoist: FALSE, :target_var: NIL}));
  IF !(((IF ident != NIL THEN
      { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_5 = ident.symbol();
  symbolEntry__heap_storage?(rtoc_local_receiver_5) }
    ELSE
      NIL
    END) OR_ELSE ((cleanupEntry__present?(entry) AND entry.heap?())))) THEN
      RETURN;
  END
  &names.append(UNWRAP (root));
  rubyToClearVoid__ownership_scanner()
  });
  RETURN CAST((names |> DISTINCT _) AS []String);
END
PUB FN mIRLoweringOwnershipScanner__walk_ast_for_moved_args(self: MIRLoweringOwnershipScanner, node: Locatable, blk: FN(Locatable) -> Void) RETURNS Void EFFECTS REENTRANT ->
  IF (IF node IS_A Identifier AS identifier THEN aST__moved?(Locatable{ Identifier: COPY identifier }) ELSE FALSE END) THEN
    blk(node);
  END
  IF mIRLoweringOwnershipScanner__nested_ownership_scope?(self, node) THEN
    RETURN;
  END
  aST__each_child_node(node, %(child: Locatable) USE(blk, self) -> {
  mIRLoweringOwnershipScanner__walk_ast_for_moved_args(self, child, blk);
  rubyToClearVoid__ownership_scanner()
  });
END
PUB FN mIRLoweringOwnershipScanner__moved_arg_root(self: MIRLoweringOwnershipScanner, arg: Locatable) RETURNS ?String ->
  MUTABLE node = COPY arg;
  IF node IS_A MoveNode AS move_node THEN
    MUTABLE move_node = move_node.value;
  END
  IF node IS_A Identifier AS identifier THEN
    RETURN COPY identifier__name(identifier);
  END
  RETURN NIL;
END
PUB FN mIRLoweringOwnershipScanner__transfer_binding_name(self: MIRLoweringOwnershipScanner, name: String) RETURNS String ->
  MUTABLE mapped: ?String = COPY self.capture_map[name];
  IF mapped EXISTS AS mapped_value THEN
    RETURN COPY mapped_value;
  END
  MUTABLE safe = self.safe_name(name);
  IF self.rename_map.contains?(safe) THEN
    RETURN COPY self.rename_map[safe]?;
  ELSE
    RETURN safe;
  END
END
PRIVATE FN mIRLoweringOwnershipScanner__arg_is_call_argument?(self: MIRLoweringOwnershipScanner, stmt: Locatable, arg: Locatable) RETURNS Bool ->
  IF !((aST__call?(stmt) AND (locatable__args(stmt) != NIL))) THEN
    RETURN FALSE;
  END
  RETURN locatable__args(stmt).contains?(arg);
END
PRIVATE FN mIRLoweringOwnershipScanner__ownership_tracked_transfer_type?(self: MIRLoweringOwnershipScanner, ti: Type) RETURNS !Bool ->
  IF (((type__primitive?(ti) OR type__void?(ti)) OR type__any?(ti)) OR type__id_handle?(ti)) THEN
    RETURN FALSE;
  END
  RETURN TRY (type__ownership_bearing?(ti, self.schema_lookup));
END
PRIVATE FN mIRLoweringOwnershipScanner__nested_ownership_scope?(self: MIRLoweringOwnershipScanner, node: Locatable) RETURNS Bool ->
  RETURN PARTIAL MATCH node START
    Locatable.WithBlock AS with_block -> TRUE,
    doblock -> TRUE,
    AST.BgBlock -> TRUE,
    Locatable.BgStreamBlock AS bg_stream_block -> TRUE,
    Locatable.FunctionDef AS function_def -> TRUE,
    Locatable.LambdaLit AS lambda_lit -> TRUE,
    DEFAULT -> FALSE
  END;
END
FN rubyToClearVoid__ownership_scanner() RETURNS Void ->
  RETURN;
END

# The cast helper belongs with the union it builds. rtoc emitted it into
# ast.clear, which cannot see a type declared here -- ast is below mir in
# the package order, so the reference was unresolvable.
