    Locatable.Drop AS cast_payload -> RETURN MIRLoweringOwnershipScannerScanRoot{ Drop: COPY cast_payload };,
    Locatable.SuppressCleanup AS cast_payload -> RETURN MIRLoweringOwnershipScannerScanRoot{ SuppressCleanup: COPY cast_payload };,
    Locatable.Return AS cast_payload -> RETURN MIRLoweringOwnershipScannerScanRoot{ Return: COPY cast_payload };,
    Locatable.ReassignCleanup AS cast_payload -> RETURN MIRLoweringOwnershipScannerScanRoot{ ReassignCleanup: COPY cast_payload };,
    Locatable.FieldCleanup AS cast_payload -> RETURN MIRLoweringOwnershipScannerScanRoot{ FieldCleanup: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to MIRLoweringOwnershipScannerScanRoot");
  END
  panic("Invalid cast to MIRLoweringOwnershipScannerScanRoot");
END
