REQUIRE "pkg:rtoc_6173742f747970652e636c656172" AS type
PUB STRUCT MIRLoweringSchemas {
  enum_schemas: {String@symbol}[]TypeEnumVariantsItem,
  lookup_proc: FN(String@symbol) -> ?TypeSchemaLookupResult,
  struct_schemas: {String@symbol}StructSchema@multiowned,
  union_schemas: {String@symbol}UnionSchema@multiowned
}

PUB FN mIRLoweringSchemas__initialize(MUTABLE self: MIRLoweringSchemas, struct_schemas: {String@symbol}StructSchema, enum_schemas: {String@symbol}[]TypeEnumVariantsItem, union_schemas: {String@symbol}UnionSchema) RETURNS Void ->
    self.struct_schemas = COPY struct_schemas;
    self.enum_schemas = COPY enum_schemas;
    self.union_schemas = COPY union_schemas;
    self.lookup_proc = %(name) USE(self) -> mIRLoweringSchemas__lookup(self, name);
END
PUB FN mIRLoweringSchemas__lookup_proc(self: MIRLoweringSchemas) RETURNS FN(String@symbol) -> ?TypeSchemaLookupResult ->
    RETURN COPY self.lookup_proc;
END
PUB FN mIRLoweringSchemas__lookup(self: MIRLoweringSchemas, name: String@symbol) RETURNS ?TypeSchemaLookupResult ->
    MUTABLE key = mIRLoweringSchemas__schema_key(self, name);
    MUTABLE struct_schema: ?StructSchema@multiowned = COPY self.struct_schemas[key];
    IF struct_schema EXISTS AS struct_schema_value THEN
      RETURN TypeSchemaLookupResult{ StructSchemaMultiowned: COPY struct_schema_value };
    END
    MUTABLE union_schema: ?UnionSchema@multiowned = COPY self.union_schemas[key];
    IF union_schema EXISTS AS union_schema_value THEN
      RETURN TypeSchemaLookupResult{ UnionSchemaMultiowned: COPY union_schema_value };
    END
    RETURN COPY self.enum_schemas[key];
END
PUB FN mIRLoweringSchemas__replace_lookup_proc_mut(MUTABLE self: MIRLoweringSchemas, lookup_proc: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS Void ->
    self.lookup_proc = COPY lookup_proc;
END
PUB FN mIRLoweringSchemas__register_enum(MUTABLE self: MIRLoweringSchemas, name: String@symbol, variants: []TypeEnumVariantsItem) RETURNS Void ->
    self.enum_schemas[mIRLoweringSchemas__schema_key(self, name)] = COPY variants;
END
PUB FN mIRLoweringSchemas__register_struct(MUTABLE self: MIRLoweringSchemas, name: String@symbol, schema: StructSchema) RETURNS Void ->
    self.struct_schemas[mIRLoweringSchemas__schema_key(self, name)] = schema;
END
PUB FN mIRLoweringSchemas__register_union(MUTABLE self: MIRLoweringSchemas, name: String@symbol, schema: UnionSchema) RETURNS Void ->
    self.union_schemas[mIRLoweringSchemas__schema_key(self, name)] = schema;
END
PUB FN mIRLoweringSchemas__merge_mut(MUTABLE self: MIRLoweringSchemas, struct_schemas: {String@symbol}StructSchema, enum_schemas: {String@symbol}[]TypeEnumVariantsItem, union_schemas: {String@symbol}UnionSchema) RETURNS Void ->
    FOR rtoc_each_key IN struct_schemas.keys() DO
    MUTABLE schema: StructSchema = COPY UNWRAP (struct_schemas[rtoc_each_key]);
    self.struct_schemas[rtoc_each_key] = schema;
    END
    FOR rtoc_inner_key IN enum_schemas.keys() DO
    MUTABLE variants: []TypeEnumVariantsItem = COPY UNWRAP (enum_schemas[rtoc_inner_key]);
    self.enum_schemas[rtoc_inner_key] = COPY variants;
    END
    FOR rtoc_inner_key IN union_schemas.keys() DO
    MUTABLE schema: UnionSchema = COPY UNWRAP (union_schemas[rtoc_inner_key]);
    self.union_schemas[rtoc_inner_key] = schema;
    END
END
PRIVATE FN mIRLoweringSchemas__schema_key(self: MIRLoweringSchemas, name: String@symbol) RETURNS String@symbol ->
    RETURN COPY name;
END
PUB FN mIRLoweringSchemas__new(struct_schemas: {String@symbol}StructSchema, enum_schemas: {String@symbol}[]TypeEnumVariantsItem, union_schemas: {String@symbol}UnionSchema) RETURNS MIRLoweringSchemas@multiowned ->
  MUTABLE self = MIRLoweringSchemas{ enum_schemas: COPY enum_schemas, lookup_proc: %(arg0: String@symbol) -> CAST(NIL AS ?TypeSchemaLookupResult), struct_schemas: COPY struct_schemas, union_schemas: COPY union_schemas };
  mIRLoweringSchemas__initialize(&self, struct_schemas, enum_schemas, union_schemas);
  RETURN self @multiowned;
END
PUB FN mIRLoweringSchemas__lookup_proc_call(self: MIRLoweringSchemas, arg0: String@symbol) RETURNS ?TypeSchemaLookupResult ->
  MUTABLE fn_value = self.lookup_proc;
  RETURN fn_value(arg0);
END
