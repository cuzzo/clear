FN rubyToClearVoid() RETURNS Void ->
  RETURN;
END
FN ruby_union_scalar_equal_optional_TransformValue_Bool(value: ?TransformValue, expected: Bool) RETURNS Bool ->
  IF value EXISTS AS equality_value THEN
    IF equality_value IS_A Bool AS equality_payload THEN
      RETURN equality_payload == expected;
    END
  END
  FALSE;
END
