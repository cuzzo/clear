PUB STRUCT PromotedLocalFact {
  name: String,
  type_zig: String,
  is_suspend_result: Bool
}
PUB UNION ContextFieldListItem { ContextFieldDecl: ContextFieldDecl, ArrayValue: []ContextFieldDecl }
PUB UNION ContextInitListItem { StructInitField: StructInitField, ArrayValue: []StructInitField }
