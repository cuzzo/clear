FN castContextFieldListItemToOptionalContextFieldInput(value: ContextFieldListItem) RETURNS ?ContextFieldInput ->
  PARTIAL MATCH value START
    ContextFieldListItem.ContextFieldDecl AS cast_payload -> RETURN ContextFieldInput{ ContextFieldDecl: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to ?ContextFieldInput");
  END
  panic("Invalid cast to ?ContextFieldInput");
END
FN castContextFieldListItemToRaw(value: ContextFieldListItem) RETURNS Raw ->
  PARTIAL MATCH value START
    ContextFieldListItem.ContextFieldDecl AS cast_payload -> RETURN Raw{ ContextFieldDecl: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Raw");
  END
  panic("Invalid cast to Raw");
END
FN castContextInitListItemToOptionalContextInitInput(value: ContextInitListItem) RETURNS ?ContextInitInput ->
  PARTIAL MATCH value START
    ContextInitListItem.StructInitField AS cast_payload -> RETURN ContextInitInput{ StructInitField: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to ?ContextInitInput");
  END
  panic("Invalid cast to ?ContextInitInput");
END
FN castOptionalTransformValueToAsyncResultShape(value: ?TransformValue) RETURNS AsyncResultShape ->
  IF value != NIL THEN
    IF value IS_A AsyncResultShape AS cast_payload THEN
      RETURN cast_payload;
    END
  END
  RETURN panic("Invalid cast to AsyncResultShape");
END
FN castOptionalTransformValueToEmittable(value: ?TransformValue) RETURNS Emittable ->
  IF value == NIL THEN
    panic("Invalid cast to Emittable");
  END
  PARTIAL MATCH value? START
    TransformValue.MIRBgBlock AS cast_payload -> RETURN Emittable{ MIRBgBlock: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Emittable");
  END
  panic("Invalid cast to Emittable");
END
FN castOptionalTransformValueToInt64(value: ?TransformValue) RETURNS Int64 ->
  IF value != NIL THEN
    IF value IS_A Int64 AS cast_payload THEN
      RETURN cast_payload;
    END
  END
  RETURN 0_i64;
END
