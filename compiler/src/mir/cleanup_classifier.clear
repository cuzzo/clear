PUB STRUCT BindingCleanupFacts {
  container_borrow: Bool,
  heap_storage: Bool,
  borrow_provenance: Bool,
  rodata_provenance: Bool,
  empty_initializer: Bool,
  mutable_binding_mutated: Bool,
  resource_close_plan: ?ResourceClosePlan,
  sync: ?String@symbol
}
PUB STRUCT FrozenCleanupFacts {
  entries_by_place: {PlaceId}CleanupEntry@multiowned
}

PUB FN frozenCleanupFacts__from_bindings(bindings: {String}CleanupEntry) RETURNS FrozenCleanupFacts ->
  MUTABLE entries: {PlaceId}CleanupEntry@multiowned = {};
  FOR rtoc_each_key IN bindings.keys() DO
  MUTABLE entry: CleanupEntry = COPY UNWRAP (bindings[rtoc_each_key]);
  entries[placeId__from_path(Path{ StringValue: COPY rtoc_each_key })] = COPY entry;
  END
  RETURN frozenCleanupFacts__build(&entries);
END
PUB FN frozenCleanupFacts__from_function(fn_node: FunctionDef, bindings: {String}CleanupEntry, MUTABLE entries: {PlaceId}CleanupEntry) RETURNS FrozenCleanupFacts ->
  MUTABLE _ = COPY fn_node;
  FOR rtoc_inner_key IN bindings.keys() DO
  MUTABLE entry: CleanupEntry = COPY UNWRAP (bindings[rtoc_inner_key]);
  MUTABLE place_key = placeId__from_path(Path{ StringValue: COPY rtoc_inner_key });
  entries[place_key] = (entries[place_key] OR_ELSE entry);
  END
  RETURN frozenCleanupFacts__build(&entries);
END
PUB FN frozenCleanupFacts__build(MUTABLE entries: {PlaceId}CleanupEntry) RETURNS FrozenCleanupFacts ->
  RETURN FrozenCleanupFacts{ entries_by_place: COPY entries };
END
PUB FN frozenCleanupFacts__empty?(self: FrozenCleanupFacts) RETURNS Bool EFFECTS REENTRANT ->
  RETURN (self.entries_by_place.count() == 0);
END
PUB FN frozenCleanupFacts__entry_for(self: FrozenCleanupFacts, name: Name) RETURNS CleanupEntry@multiowned ->
  MUTABLE place = placeId__from_path(castNameToPath(name));
  IF self.entries_by_place[place] EXISTS AS direct_entry THEN
    RETURN KEEP direct_entry;
  END
  MUTABLE path_place = placeId__from_path(Path{ StringValue: COPY place.path });
  IF self.entries_by_place[path_place] EXISTS AS path_entry THEN
    RETURN KEEP path_entry;
  END
  RETURN cleanupEntry__blank();
END
PUB FN frozenCleanupFacts__entry_for_node(self: FrozenCleanupFacts, name: Name, node: Locatable) RETURNS CleanupEntry@multiowned ->
  MUTABLE place = cleanupClassifier__place_for_binding_node(CAST(name AS String), node);
  IF self.entries_by_place[place] EXISTS AS direct_entry THEN
    RETURN KEEP direct_entry;
  END
  MUTABLE path_place = placeId__from_path(Path{ StringValue: COPY place.path });
  IF self.entries_by_place[path_place] EXISTS AS path_entry THEN
    RETURN KEEP path_entry;
  END
  RETURN cleanupEntry__blank();
END
PUB FN frozenCleanupFacts__live_entry_for(self: FrozenCleanupFacts, name: Name) RETURNS CleanupEntry@multiowned ->
  MUTABLE entry = frozenCleanupFacts__entry_for(self, name);
  IF cleanupEntry__needs_cleanup?(entry) THEN
    RETURN entry;
  ELSE
    RETURN cleanupEntry__blank();
  END
END
PUB FN frozenCleanupFacts__live_entry_for_node(self: FrozenCleanupFacts, name: Name, node: Locatable) RETURNS CleanupEntry@multiowned ->
  MUTABLE entry = frozenCleanupFacts__entry_for_node(self, name, node);
  IF cleanupEntry__needs_cleanup?(entry) THEN
    RETURN entry;
  ELSE
    RETURN cleanupEntry__blank();
  END
END
PUB FN frozenCleanupFacts__with_live_entry_for(self: FrozenCleanupFacts, name: Name, block: FN(CleanupEntry) -> Void) RETURNS Bool ->
  MUTABLE entry = frozenCleanupFacts__live_entry_for(self, name);
  IF !(cleanupEntry__present?(entry)) THEN
    RETURN FALSE;
  END
  block(entry);
  RETURN TRUE;
END
PUB FN frozenCleanupFacts__with_live_entry_for_node(self: FrozenCleanupFacts, name: Name, node: Locatable, block: FN(CleanupEntry) -> Void) RETURNS Bool ->
  MUTABLE entry = frozenCleanupFacts__live_entry_for_node(self, name, node);
  IF !(cleanupEntry__present?(entry)) THEN
    RETURN FALSE;
  END
  block(entry);
  RETURN TRUE;
END
PUB FN frozenCleanupFacts__without_names(self: FrozenCleanupFacts, names: []NamesItem) RETURNS FrozenCleanupFacts ->
  MUTABLE removed_paths: [Set]String = (names |> SELECT (placeId__from_path(castNamesItemToPath(_))).path) |> DISTINCT _;
  MUTABLE kept: {PlaceId}CleanupEntry@multiowned = {};
  FOR rtoc_place IN self.entries_by_place.keys() DO
    IF !(removed_paths.contains?(rtoc_place.path)) THEN
      IF self.entries_by_place[rtoc_place] EXISTS AS kept_entry THEN
        kept[rtoc_place] = KEEP kept_entry;
      END
    END
  END
  RETURN frozenCleanupFacts__build(&kept);
END
PUB FN frozenCleanupFacts__bindings(self: FrozenCleanupFacts) RETURNS !{String}CleanupEntry@multiowned ->
  MUTABLE out: {String}CleanupEntry@multiowned = {};
  FOR rtoc_place IN self.entries_by_place.keys() DO
    IF self.entries_by_place[rtoc_place] EXISTS AS binding_entry THEN
      MUTABLE binding_key: String = COPY rtoc_place.path;
      out[binding_key] = KEEP binding_entry;
    END
  END
  RETURN out;
END
PUB FN frozenCleanupFacts__each_entry(self: FrozenCleanupFacts, block: FN(PlaceId, CleanupEntry) -> Void) RETURNS Void ->
  FOR rtoc_each_key IN self.entries_by_place.keys() DO
  MUTABLE entry: CleanupEntry@multiowned = COPY UNWRAP (self.entries_by_place[rtoc_each_key]);
  block(rtoc_each_key, entry);
  END
  NIL;
END
PUB STRUCT CleanupClassificationPlan {
  function_name: String,
  facts: FrozenCleanupFacts
}

PUB FN cleanupClassificationPlan__from_bindings(function_name: String, bindings: {String}CleanupEntry) RETURNS CleanupClassificationPlan EFFECTS REENTRANT ->
  RETURN CleanupClassificationPlan{ function_name: COPY function_name, facts: COPY frozenCleanupFacts__from_bindings(bindings) };
END
PUB FN cleanupClassificationPlan__from_function(fn_node: FunctionDef, bindings: {String}CleanupEntry, MUTABLE entries: {PlaceId}CleanupEntry) RETURNS CleanupClassificationPlan EFFECTS REENTRANT ->
  RETURN CleanupClassificationPlan{ function_name: COPY CAST(fn_node.name AS String), facts: COPY frozenCleanupFacts__from_function(fn_node, bindings, &entries) };
END
PUB FN cleanupClassificationPlan__empty?(self: CleanupClassificationPlan) RETURNS Bool EFFECTS REENTRANT ->
  RETURN frozenCleanupFacts__empty?(self.facts);
END
PUB FN cleanupClassificationPlan__bindings(self: CleanupClassificationPlan) RETURNS !{String}CleanupEntry@multiowned EFFECTS REENTRANT ->
  RETURN TRY (frozenCleanupFacts__bindings(self.facts));
END
PUB FN cleanupClassifier__classify(fn_node: FunctionDef, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !{String}CleanupEntry@multiowned ->
  RETURN TRY (cleanupClassificationPlan__bindings((TRY (cleanupClassifier__classify_plan(fn_node, schema_lookup)))));
END
PUB FN cleanupClassifier__classify_plan(fn_node: FunctionDef, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, lifecycle_registry: ?LifecycleRegistry = NIL) RETURNS !CleanupClassificationPlan ->
  IF !(fn_node.body) THEN
    RETURN cleanupClassificationPlan__from_bindings(CAST(fn_node.name AS String), {});
  END
  MUTABLE bindings: {String}CleanupEntry@multiowned = {};
  MUTABLE entries_by_place: {PlaceId}CleanupEntry@multiowned = {};
  TRY (cleanupClassifier__walk_bindings(fn_node.body, schema_lookup, lifecycle_registry, &bindings, &entries_by_place));
  TRY (cleanupClassifier__walk_takes_params(fn_node, schema_lookup, lifecycle_registry, &bindings));
  cleanupClassifier__walk_moved_source_guards(fn_node.body, bindings);
  TRY (cleanupClassifier__walk_match_as_bindings(fn_node.body, schema_lookup, lifecycle_registry, &bindings));
  MUTABLE capture_body: []Locatable = COPY fn_node.body;
  TRY (cleanupClassifier__walk_capture_bindings(&capture_body, schema_lookup, lifecycle_registry, &bindings));
  TRY (cleanupClassifier__stamp_cleanup_scopes_mut(fn_node.body, bindings));
  RETURN cleanupClassificationPlan__from_function(fn_node, bindings, &entries_by_place);
END
PUB FN cleanupClassifier__place_for_binding_node(name: String, node: Locatable) RETURNS PlaceId ->
  MUTABLE symbol: ?SymbolEntry@multiowned = aST__node__symbol(node);
  RETURN placeId__from_symbol(Path{ StringValue: COPY name }, symbol);
END
PUB FN cleanupClassifier__walk_moved_source_guards(body: []Locatable, bindings: {String}CleanupEntry) RETURNS Void ->
  FOR _ IN body DO
  cleanupClassifier__mark_moved_source_guards_in_node(_, bindings);
  END
END
PUB FN cleanupClassifier__mark_moved_source_guards_in_node(node: Locatable, bindings: {String}CleanupEntry) RETURNS Void EFFECTS REENTRANT ->
  IF node IS_A Identifier AS moved_identifier THEN
    IF aST__moved?(Locatable{ Identifier: COPY moved_identifier }) THEN
      IF bindings[moved_identifier.name] EXISTS AS moved_entry THEN
        MUTABLE moved_entry_mutable = COPY moved_entry;
        cleanupEntry__mark_moved_guard_mut(&moved_entry_mutable);
      END
    END
  END
  IF node IS_A FunctionDef AS function_def THEN
    RETURN;
  END
  aST__each_child_node(node, %(child: Locatable) USE(bindings) -> {
  cleanupClassifier__mark_moved_source_guards_in_node(child, bindings);
  rubyToClearVoid()
  });
END
PUB FN cleanupClassifier__stamp_cleanup_scopes_mut(body: []Locatable, bindings: {String}CleanupEntry) RETURNS !Void ->
  TRY (cleanupClassifier__stamp_default_scopes_mut(body, 0));
  TRY (cleanupClassifier__stamp_extended_loop_lifetimes_mut(body, bindings));
END
PUB FN cleanupClassifier__stamp_default_scopes_mut(body: []Locatable, loop_depth: Int64) RETURNS !Void EFFECTS REENTRANT ->
  FOR _ IN body DO
  cleanupClassifier__stamp_binding_default_scope_mut(_, loop_depth);
  MUTABLE child_depth = IF aST__loop_node?((_)) THEN
      (loop_depth + 1)
    ELSE
      loop_depth
    END;
  FOR child_body IN (TRY (hoist__child_bodies((_)))) DO
  TRY (cleanupClassifier__stamp_default_scopes_mut(child_body, child_depth));
  END
  END
END
PUB FN cleanupClassifier__stamp_binding_default_scope_mut(node: Locatable, loop_depth: Int64) RETURNS Void ->
  IF !((node IS_A VarDecl OR node IS_A BindExpr)) THEN
    RETURN;
  END
  IF (IF node IS_A BindExpr AS bind_expr THEN (bind_expr.mode == :assign) ELSE FALSE END) THEN
    RETURN;
  END
  MUTABLE entry: ?CleanupEntry@multiowned = NIL;
  IF node IS_A VarDecl AS var_decl THEN
    entry = KEEP var_decl.mir_binding_entry;
  ELSE_IF node IS_A BindExpr AS bind_expr THEN
    entry = KEEP bind_expr.mir_binding_entry;
  END
  IF entry EXISTS AS entry_value THEN
    MUTABLE entry_mutable = KEEP entry_value;
    IF cleanupEntry__none?(entry_mutable) THEN
      RETURN;
    END
    MUTABLE scope: String@symbol = :function;
    IF cleanupEntry__heap?(entry_mutable) THEN
      scope = :heap;
    ELSE_IF (loop_depth > 0) THEN
      scope = :iteration;
    END
    cleanupEntry__set_cleanup_scope_mut(&entry_mutable, scope);
  END
END
PUB FN cleanupClassifier__stamp_extended_loop_lifetimes_mut(body: []Locatable, bindings: {String}CleanupEntry) RETURNS !Void EFFECTS REENTRANT ->
  FOR node IN body DO
  MUTABLE is_loop = aST__loop_node?((node));
  FOR child_body IN (TRY (hoist__child_bodies((node)))) DO
  IF is_loop THEN
      TRY (cleanupClassifier__stamp_loop_extensions_mut(child_body, bindings));
  END
  TRY (cleanupClassifier__stamp_extended_loop_lifetimes_mut(child_body, bindings));
  END
  END
END
PUB FN cleanupClassifier__stamp_loop_extensions_mut(body: []Locatable, bindings: {String}CleanupEntry) RETURNS !Void ->
  MUTABLE local_facts = TRY (localBindingAnalysis__direct_loop_body_facts(body));
  MUTABLE local_names = COPY local_facts.names;
  MUTABLE local_entries = COPY local_facts.entries;
  TRY (localBindingAnalysis__each_direct_loop_node(body, %(node: Locatable) USE(bindings, local_entries, local_names) -> {
  IF node IS_A BindExpr AS bind_expr THEN
      MUTABLE bind_expr_mutable = COPY bind_expr;
      IF !((bind_expr_mutable.mode == :assign)) THEN
        RETURN;
      END
      IF local_names.contains?(CAST(bind_expr_mutable.name AS String)) THEN
        RETURN;
      END
      MUTABLE entry: ?CleanupEntry = COPY bindings[CAST(bind_expr_mutable.name AS String)];
      IF ((entry != NIL) AND TRY (cleanupClassifier__value_extends_loop?(bind_expr_mutable.value))) THEN
        TRY (cleanupClassifier__promote_entry_to_heap_cleanup_mut(&entry, bind_expr_mutable.value));
      END
  ELSE_IF node IS_A Assignment AS assignment THEN
      MUTABLE target: ?Identifier = aST__root_identifier(castAssignmentNameToLocatable(assignment.name));
      IF target EXISTS AS target_value THEN
        IF local_names.contains?(COPY target_value.name) THEN
          RETURN;
        END
      END
      cleanupClassifier__mark_iteration_values_function_mut(assignment.value, local_entries);
  ELSE_IF node IS_A DestructuringAssignment AS destructuring_assignment THEN
      cleanupClassifier__mark_iteration_values_function_mut(COPY destructuring_assignment.value, local_entries);
  ELSE_IF node IS_A FuncCall AS func_call THEN
      cleanupClassifier__mark_call_lifetime_extensions_mut(func_call.args, cleanupClassifier__params_for_call(func_call), local_entries, NIL);
  ELSE_IF node IS_A MethodCall AS method_call THEN
      MUTABLE receiver: ?Identifier = aST__root_identifier(method_call.object);
      MUTABLE receiver_nonlocal = FALSE;
      IF receiver EXISTS AS receiver_value THEN
        receiver_nonlocal = !(local_names.contains?(COPY receiver_value.name));
      END
      cleanupClassifier__mark_call_lifetime_extensions_mut(COPY method_call.args, cleanupClassifier__params_for_method_call(method_call) |> SKIP 1, local_entries, receiver_nonlocal);
  END
  rubyToClearVoid()
  }));
END
PUB FN cleanupClassifier__value_extends_loop?(value: Locatable) RETURNS !Bool ->
  IF (TRY (type__from_node_mut(value, "cleanup lifetime extension"))) EXISTS AS ti THEN
    RETURN TRY (type__heap_ptr?(ti));
  END
  RETURN FALSE;
END
PUB FN cleanupClassifier__promote_entry_to_heap_cleanup_mut(MUTABLE entry_obj: CleanupEntry, value: Locatable) RETURNS !Void ->
  MUTABLE lifecycle: ?LifecyclePlan = cleanupEntry__lifecycle_plan(entry_obj);
  IF lifecycle EXISTS AS lifecycle_value THEN
    IF !(lifecyclePlan__needs_drop?(lifecycle_value)) THEN
      RETURN;
    END
  END
  MUTABLE ti_opt: ?Type = TRY (type__from_node_mut(value, "cleanup lifetime promotion"));
  IF !(ti_opt EXISTS) THEN
    RETURN;
  END
  MUTABLE ti: Type = COPY UNWRAP (ti_opt);
  MUTABLE is_string = TRY (type__string?(ti));
  IF (type__symbol?(ti) OR (is_string AND type__rodata?(ti))) THEN
    RETURN;
  END
  MUTABLE kind: String@symbol = :uniform;
  IF is_string THEN
    kind = :heap_string;
  END
  cleanupEntry__promote_to_cleanup_mut(&entry_obj, kind, :heap, TRUE);
END
PUB FN cleanupClassifier__mark_call_lifetime_extensions_mut(args: []Locatable, params: []Param, local_entries: {String}CleanupEntry, receiver_nonlocal: ?Bool) RETURNS Void ->
  IF receiver_nonlocal EXISTS AS receiver_nonlocal_value THEN
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < params.length() DO
    IF !(((params[rtoc_idx]?.takes OR_ELSE FALSE) OR (params[rtoc_idx]?.mutable OR_ELSE FALSE))) THEN
      rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    MUTABLE arg: ?Locatable = COPY args[rtoc_idx];
    IF arg EXISTS AS arg_value THEN
          cleanupClassifier__mark_iteration_values_function_mut(arg_value, local_entries);
    END
  rtoc_idx = rtoc_idx + 1;
    END
  ELSE
    RETURN;
  END
END
PUB FN cleanupClassifier__mark_iteration_values_function_mut(expr: Locatable, local_entries: {String}CleanupEntry) RETURNS Void ->
  MUTABLE ident: ?Identifier = aST__root_identifier(expr);
  IF ident EXISTS AS ident_value THEN
    MUTABLE ident_value_mutable = COPY ident_value;
    MUTABLE entry: ?CleanupEntry = COPY local_entries[ident_value_mutable.name];
    IF entry EXISTS AS entry_value THEN
      MUTABLE entry_value_mutable = COPY entry_value;
      IF (cleanupEntry__frame?(entry_value_mutable) AND (cleanupEntry__scope(entry_value_mutable) == :iteration)) THEN
        cleanupEntry__set_cleanup_scope_mut(&entry_value_mutable, :function);
      END
    ELSE
      RETURN;
    END
  ELSE
    RETURN;
  END
END
PUB FN cleanupClassifier__params_for_call(call: FuncCall) RETURNS ![]Param ->
  MUTABLE sig: ?FunctionSignature@multiowned = KEEP call.matched_signature;
  IF sig EXISTS AS sig_value THEN
    RETURN TRY (functionSignature__params(sig_value));
  ELSE
    RETURN CAST(( { MUTABLE rtoc_empty_list_2: []Param = List[]; rtoc_empty_list_2 } ) AS []Param);
  END
END
PUB FN cleanupClassifier__params_for_method_call(call: MethodCall) RETURNS ![]Param ->
  MUTABLE sig: ?FunctionSignature@multiowned = KEEP call.matched_signature;
  IF sig EXISTS AS sig_value THEN
    RETURN TRY (functionSignature__params(sig_value));
  ELSE
    RETURN CAST(( { MUTABLE rtoc_empty_list_3: []Param = List[]; rtoc_empty_list_3 } ) AS []Param);
  END
END
PUB FN cleanupClassifier__stamp_field_pre_cleanups_mut(MUTABLE body: []Locatable, facts: FrozenCleanupFacts, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL, lifecycle_registry: ?LifecycleRegistry = NIL) RETURNS !Void ->
  aST__each_locatable_list_mut(&body, FALSE, %(MUTABLE stmt: Locatable) USE(facts, lifecycle_registry, schema_lookup) -> {
  PARTIAL MATCH stmt START
    Locatable.Assignment AS MUTABLE assignment -> cleanupClassifier__stamp_field_pre_cleanup_mut(&assignment, facts, schema_lookup, lifecycle_registry);
  END
  rubyToClearVoid()
  });
END
PRIVATE FN cleanupClassifier__assignment_get_field(name: AssignmentName) RETURNS ?GetField ->
  PARTIAL MATCH name START
    AssignmentName.GetField AS get_field -> RETURN COPY get_field;
  END
  RETURN NIL;
END
PRIVATE FN cleanupClassifier__stamp_field_pre_cleanup_mut(MUTABLE assignment: Assignment, facts: FrozenCleanupFacts, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult, lifecycle_registry: ?LifecycleRegistry) RETURNS !Void ->
  IF !(assignment.name IS_A GetField) THEN
    RETURN;
  END
  MUTABLE get_field: GetField = COPY UNWRAP (cleanupClassifier__assignment_get_field(assignment.name));
  MUTABLE target_node: Locatable = COPY get_field.target;
  MUTABLE field_ti_opt: ?Type = TRY (type__from_node_mut(Locatable{ GetField: COPY get_field }, "field pre-cleanup"));
  IF !(field_ti_opt EXISTS) THEN
    RETURN;
  END
  MUTABLE field_ti: Type = COPY UNWRAP (field_ti_opt);
  MUTABLE lifecycle: ?LifecyclePlan@multiowned = NIL;
  IF lifecycle_registry EXISTS AS registry THEN
    lifecycle = KEEP TRY (lifecycleRegistry__fetch(registry, field_ti));
    assignment.field_lifecycle_plan = KEEP lifecycle;
  END
  IF ((assignment.auto_lock EXISTS) AND TRY (cleanupClassifier__cleanup_owned_string_type?(field_ti))) THEN
    assignment.field_pre_cleanup = :heap;
    RETURN;
  END
  IF cleanupClassifier__heap_owned_field_pre_cleanup_alloc(field_ti, target_node, facts) EXISTS AS heap_alloc THEN
    assignment.field_pre_cleanup = COPY heap_alloc;
    RETURN;
  END
  MUTABLE field_needs_cleanup = FALSE;
  IF lifecycle EXISTS AS lifecycle_value THEN
    field_needs_cleanup = lifecyclePlan__needs_drop?(lifecycle_value);
  ELSE
    field_needs_cleanup = (TRY (type__needs_cleanup?(field_ti, schema_lookup)) OR TRY (type__recursive_cleanup_shape?(field_ti, schema_lookup)));
  END
  IF field_needs_cleanup THEN
    assignment.field_pre_cleanup = cleanupClassifier__field_owner_cleanup_alloc(target_node, facts);
  END
END
PUB FN cleanupClassifier__heap_owned_field_pre_cleanup_alloc(field_ti: Type, target_node: Locatable, facts: FrozenCleanupFacts) RETURNS ?String@symbol ->
  IF !(TRY (cleanupClassifier__cleanup_owned_string_type?(field_ti))) THEN
    RETURN NIL;
  END
  IF (cleanupClassifier__field_owner_cleanup_alloc(target_node, facts) == :heap) THEN
    RETURN :heap;
  ELSE
    RETURN NIL;
  END
END
PUB FN cleanupClassifier__field_owner_cleanup_alloc(target_node: Locatable, facts: FrozenCleanupFacts) RETURNS String@symbol ->
  IF target_node IS_A Identifier AS identifier THEN
    MUTABLE target_entry = frozenCleanupFacts__entry_for_node(facts, Name{ StringValue: COPY identifier__name(identifier) }, Locatable{ Identifier: COPY identifier });
    IF cleanupEntry__heap?(target_entry) THEN
      RETURN :heap;
    ELSE
      RETURN :frame;
    END
  ELSE
    RETURN :frame;
  END
END
PUB FN cleanupClassifier__walk_bindings(body: []Locatable, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, lifecycle_registry: ?LifecycleRegistry, MUTABLE bindings: {String}CleanupEntry, MUTABLE entries_by_place: {PlaceId}CleanupEntry) RETURNS ![]CleanupEntry@multiowned ->
  MUTABLE body_mutable: []Locatable = COPY body;
  TRY (cleanupClassifier__classify_cleanup_binding_body(&body_mutable, schema_lookup, lifecycle_registry, &bindings, &entries_by_place));
  MUTABLE result: []CleanupEntry@multiowned = bindings.values();
  RETURN result;
END
PUB FN cleanupClassifier__classify_cleanup_binding_body(MUTABLE body: []Locatable, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, lifecycle_registry: ?LifecycleRegistry, MUTABLE bindings: {String}CleanupEntry, MUTABLE entries_by_place: {PlaceId}CleanupEntry) RETURNS !Void EFFECTS REENTRANT ->
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < body.length() DO
    MUTABLE node: Locatable = COPY UNWRAP (body[rtoc_idx]);
    TRY (cleanupClassifier__classify_binding_stmt_mut(&node, schema_lookup, lifecycle_registry, &bindings, &entries_by_place));
    TRY (cleanupClassifier__classify_inline_bg_binding_body(node, schema_lookup, lifecycle_registry, &bindings, &entries_by_place));
    FOR child_body IN (TRY (hoist__child_bodies(node))) DO
      MUTABLE child_body_mutable: []Locatable = COPY child_body;
      TRY (cleanupClassifier__classify_cleanup_binding_body(&child_body_mutable, schema_lookup, lifecycle_registry, &bindings, &entries_by_place));
    END
    body[rtoc_idx] = COPY node;
    rtoc_idx = rtoc_idx + 1;
  END
END
PRIVATE FN cleanupClassifier__classify_binding_stmt_mut(MUTABLE node: Locatable, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, lifecycle_registry: ?LifecycleRegistry, MUTABLE bindings: {String}CleanupEntry, MUTABLE entries_by_place: {PlaceId}CleanupEntry) RETURNS !Void ->
  PARTIAL MATCH node START
    Locatable.VarDecl AS MUTABLE item -> TRY (cleanupClassifier__classify_var_decl_binding_mut(&item, schema_lookup, lifecycle_registry, &bindings, &entries_by_place));,
    Locatable.BindExpr AS MUTABLE item -> TRY (cleanupClassifier__classify_bind_expr_binding_mut(&item, schema_lookup, lifecycle_registry, &bindings, &entries_by_place));
  END
END
PRIVATE FN cleanupClassifier__classify_var_decl_binding_mut(MUTABLE decl: VarDecl, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, lifecycle_registry: ?LifecycleRegistry, MUTABLE bindings: {String}CleanupEntry, MUTABLE entries_by_place: {PlaceId}CleanupEntry) RETURNS !Void ->
  MUTABLE binding: BindingNode = BindingNode{ VarDecl: COPY decl };
  TRY (cleanupClassifier__classify_cleanup_binding_node(&binding, schema_lookup, lifecycle_registry, &bindings, &entries_by_place));
  PARTIAL MATCH binding START
    BindingNode.VarDecl AS stamped -> decl = COPY stamped;
  END
END
PRIVATE FN cleanupClassifier__classify_bind_expr_binding_mut(MUTABLE bind: BindExpr, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, lifecycle_registry: ?LifecycleRegistry, MUTABLE bindings: {String}CleanupEntry, MUTABLE entries_by_place: {PlaceId}CleanupEntry) RETURNS !Void ->
  MUTABLE binding: BindingNode = BindingNode{ BindExpr: COPY bind };
  TRY (cleanupClassifier__classify_cleanup_binding_node(&binding, schema_lookup, lifecycle_registry, &bindings, &entries_by_place));
  PARTIAL MATCH binding START
    BindingNode.BindExpr AS stamped -> bind = COPY stamped;
  END
END
PUB FN cleanupClassifier__classify_inline_bg_binding_body(node: Locatable, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, lifecycle_registry: ?LifecycleRegistry, MUTABLE bindings: {String}CleanupEntry, MUTABLE entries_by_place: {PlaceId}CleanupEntry) RETURNS !Void EFFECTS REENTRANT ->
  FOR child IN aST__expression_children(node) DO
    IF (child IS_A BgBlock OR child IS_A BgStreamBlock) THEN
      MUTABLE bg_body: []Locatable = COPY cleanupClassifier__block_body(child);
      TRY (cleanupClassifier__classify_cleanup_binding_body(&bg_body, schema_lookup, lifecycle_registry, &bindings, &entries_by_place));
    ELSE_IF child IS_A BlockExpr AS block_expr THEN
      # A value BlockExpr (`{ stmts...; result }`, e.g. a desugared pipeline
      # fold) carries real bindings that need classification like any other
      # statement sequence.
      MUTABLE block_body: []Locatable = COPY block_expr.body;
      TRY (cleanupClassifier__classify_cleanup_binding_body(&block_body, schema_lookup, lifecycle_registry, &bindings, &entries_by_place));
      IF block_expr.result EXISTS AS block_result THEN
        TRY (cleanupClassifier__classify_inline_bg_binding_body(block_result, schema_lookup, lifecycle_registry, &bindings, &entries_by_place));
      END
    ELSE
      TRY (cleanupClassifier__classify_inline_bg_binding_body(child, schema_lookup, lifecycle_registry, &bindings, &entries_by_place));
    END
  END
END
PRIVATE FN cleanupClassifier__block_body(node: Locatable) RETURNS []Locatable ->
  PARTIAL MATCH node START
    Locatable.BgBlock AS item -> RETURN COPY item.body;,
    Locatable.BgStreamBlock AS item -> RETURN COPY item.body;
  END
  RETURN List[];
END
PUB FN cleanupClassifier__classify_cleanup_binding_node(MUTABLE node: BindingNode, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, lifecycle_registry: ?LifecycleRegistry, MUTABLE bindings: {String}CleanupEntry, MUTABLE entries_by_place: {PlaceId}CleanupEntry) RETURNS !Void ->
  IF node IS_A BindExpr AS bind_expr THEN
    IF (bind_expr.mode == :assign) THEN
      RETURN;
    END
  END
  MUTABLE var_name: String = COPY cleanupClassifier__binding_node_name(node);
  MUTABLE place = cleanupClassifier__place_for_binding_node(var_name, castBindingNodeToLocatable(node));
  IF cleanupClassifier__binding_container_borrow?(castBindingNodeToLocatable(node)) THEN
    &bindings.delete(var_name);
    &entries_by_place.delete(place);
    cleanupClassifier__set_binding_entry_mut(&node, cleanupEntry__none());
    RETURN;
  END
  MUTABLE full_type: Type = TRY (aST__full_type_mut(castBindingNodeToLocatable(node)));
  MUTABLE value_node: ?Locatable = cleanupClassifier__binding_node_value(node);
  MUTABLE moved_alloc: ?String@symbol = TRY (cleanupClassifier__moved_payload_alloc(value_node, bindings));
  MUTABLE cleanup: ?CleanupEntry@multiowned = TRY (cleanupClassifier__classify_binding(full_type, castBindingNodeToLocatable(node), schema_lookup, lifecycle_registry));
  IF (!(cleanup EXISTS) AND (moved_alloc EXISTS)) THEN
    cleanup = KEEP TRY (cleanupClassifier__transferred_payload_entry(full_type, schema_lookup, lifecycle_registry));
  END
  IF !(cleanup EXISTS) THEN
    IF !(lifecycle_registry EXISTS) THEN
      IF aST__node__symbol(castBindingNodeToLocatable(node)) EXISTS AS symbol THEN
        IF (symbolEntry__heap_storage?(symbol) AND !(cleanupClassifier__optional_empty_initializer?(value_node))) THEN
          IF TRY (type__needs_explicit_cleanup?(full_type, :heap, schema_lookup)) THEN
            cleanup = KEEP cleanupClassifier__entry(:uniform, :heap);
          END
        END
      END
    END
  END
  IF cleanup EXISTS AS with_alloc THEN
    IF moved_alloc EXISTS AS alloc THEN
      MUTABLE with_alloc_mutable = KEEP with_alloc;
      cleanupEntry__set_alloc_mut(&with_alloc_mutable, alloc);
      cleanup = KEEP with_alloc_mutable;
    END
  ELSE
    cleanup = KEEP TRY (cleanupClassifier__no_cleanup_alloc_entry(full_type, schema_lookup));
  END
  IF cleanup EXISTS AS planned THEN
    IF lifecycle_registry EXISTS AS registry THEN
      IF !(cleanupEntry__lifecycle_plan(planned) EXISTS) THEN
        MUTABLE planned_mutable = KEEP planned;
        cleanupEntry__set_lifecycle_plan_mut(&planned_mutable, TRY (lifecycleRegistry__fetch_binding(registry, castBindingNodeToLocatable(node), full_type)));
        cleanup = KEEP planned_mutable;
      END
    END
  END
  # Stamp every declaration, including the explicit NONE result: leaving a
  # no-cleanup declaration unstamped makes lowering fall back to the legacy
  # name-keyed view, where a cleanup-bearing sibling with the same display
  # name contaminates this declaration.
  IF cleanup EXISTS AS stamped THEN
    cleanupClassifier__set_binding_entry_mut(&node, KEEP stamped);
    bindings[var_name] = KEEP stamped;
    entries_by_place[place] = KEEP stamped;
  ELSE
    cleanupClassifier__set_binding_entry_mut(&node, cleanupEntry__none());
    &bindings.delete(var_name);
    &entries_by_place.delete(place);
  END
END
PRIVATE FN cleanupClassifier__binding_node_name(node: BindingNode) RETURNS String ->
  PARTIAL MATCH node START
    BindingNode.VarDecl AS item -> RETURN COPY item.name;,
    BindingNode.BindExpr AS item -> RETURN COPY item.name;,
    BindingNode.DestructureTarget AS item -> RETURN COPY item.name;
  END
  RETURN "";
END
PRIVATE FN cleanupClassifier__binding_node_value(node: BindingNode) RETURNS ?Locatable ->
  PARTIAL MATCH node START
    BindingNode.VarDecl AS item -> RETURN COPY item.value;,
    BindingNode.BindExpr AS item -> RETURN COPY item.value;,
    BindingNode.DestructureTarget AS item -> RETURN NIL;
  END
  RETURN NIL;
END
PRIVATE FN cleanupClassifier__set_binding_entry_mut(MUTABLE node: BindingNode, entry: CleanupEntry) RETURNS Void ->
  PARTIAL MATCH node START
    BindingNode.VarDecl AS MUTABLE item -> item.mir_binding_entry = KEEP entry;,
    BindingNode.BindExpr AS MUTABLE item -> item.mir_binding_entry = KEEP entry;,
    BindingNode.DestructureTarget AS MUTABLE item -> item.mir_binding_entry = KEEP entry;
  END
END
PUB FN cleanupClassifier__no_cleanup_alloc_entry(ti: Type, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !?CleanupEntry@multiowned ->
  IF !((TRY (type__heap_ptr?(ti)) OR TRY (type__collection_value?(ti)))) THEN
    RETURN NIL;
  END
  MUTABLE alloc = TRY (type__cleanup_allocator(ti, schema_lookup));
  RETURN cleanupEntry__no_cleanup(alloc, IF placement__heap?(alloc) THEN
    :heap
  ELSE
    :function
  END);
CATCH Transient, Input, System, NotFound, Permission, Canceled
  RETURN NIL;
END
PUB FN cleanupClassifier__moved_payload_alloc(node: ?Locatable, bindings: {String}CleanupEntry) RETURNS !?String@symbol ->
  IF !(TRY (cleanupClassifier__ownership_transfer_payload?(node))) THEN
    RETURN NIL;
  END
  MUTABLE payload = COPY UNWRAP (node);
  MUTABLE names: []String = List[];
  TRY (cleanupClassifier__collect_payload_binding_names(payload, &names));
  MUTABLE allocs: []String@symbol = List[];
  FOR name IN names DO
    IF bindings[name] EXISTS AS entry THEN
      IF cleanupEntry__needs_cleanup?(entry) THEN
        &allocs.append(COPY cleanupEntry__alloc(entry));
      END
    END
  END
  IF (allocs.length() == 0) THEN
    RETURN NIL;
  END
  IF allocs.contains?(:heap) THEN
    RETURN :heap;
  ELSE
    RETURN :frame;
  END
END
PUB FN cleanupClassifier__ownership_transfer_payload?(node: ?Locatable) RETURNS !Bool EFFECTS REENTRANT ->
  IF node EXISTS AS node_value THEN
    IF node_value IS_A MoveNode AS move_node THEN
      RETURN TRUE;
    END
    IF aST__moved?(node_value) THEN
      RETURN TRUE;
    END
    RETURN aST__wrapped_children(node_value) |> ANY TRY (cleanupClassifier__ownership_transfer_payload?(_));
  ELSE
    RETURN FALSE;
  END
END
PUB FN cleanupClassifier__collect_payload_binding_names(node: Locatable, MUTABLE names: []String) RETURNS !Void EFFECTS REENTRANT ->
  IF node IS_A Identifier AS identifier THEN
    &names.append(COPY identifier__name(identifier));
    RETURN;
  END
  FOR _ IN aST__wrapped_children(node) DO
  TRY (cleanupClassifier__collect_payload_binding_names(_, &names));
  END
END
PUB FN cleanupClassifier__transferred_payload_entry(ti: Type, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, lifecycle_registry: ?LifecycleRegistry) RETURNS !?CleanupEntry@multiowned ->
  RETURN TRY (cleanupClassifier__takes_param_base_entry(ti, schema_lookup, lifecycle_registry));
END
PUB FN cleanupClassifier__walk_takes_params(fn_node: FunctionDef, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, lifecycle_registry: ?LifecycleRegistry, MUTABLE bindings: {String}CleanupEntry) RETURNS !Void ->
  FOR param IN fn_node.params DO
    IF (param.takes OR_ELSE FALSE) THEN
      IF (TRY (cleanupClassifier__takes_param_base_entry(param.type, schema_lookup, lifecycle_registry))) EXISTS AS found THEN
        MUTABLE base = KEEP found;
        IF lifecycle_registry EXISTS AS registry THEN
          cleanupEntry__set_lifecycle_plan_mut(&base, TRY (lifecycleRegistry__fetch(registry, param.type)));
        END
        cleanupEntry__mark_moved_guard_mut(&base);
        cleanupEntry__set_alloc_mut(&base, :heap);
        IF !(cleanupEntry__source_kind(base) EXISTS) THEN
          cleanupEntry__set_source_kind_mut(&base, :takes_param);
        END
        IF type__needs_pointer_passing?(param.type) THEN
          cleanupEntry__set_via_pointer_mut(&base, TRUE);
        END
        bindings[COPY param.name] = KEEP base;
      END
    END
  END
  # A MONOMORPHIC TAKES param is emitted anytype and threads the caller's actual
  # carrier. Its declared payload may need no drop while the carrier that arrives
  # is an Rc/Arc handle that must be released, so take the carrier's release
  # lifecycle from the registry rather than rebuilding memory logic here.
  FOR param IN fn_node.params DO
    IF ((param.takes OR_ELSE FALSE) AND (param.carrier_contract == :monomorphic)) THEN
      IF !(bindings.contains?(COPY param.name)) THEN
        MUTABLE base = cleanupClassifier__rc_entry(:heap);
        cleanupEntry__mark_moved_guard_mut(&base);
        cleanupEntry__set_alloc_mut(&base, :heap);
        IF !(cleanupEntry__source_kind(base) EXISTS) THEN
          cleanupEntry__set_source_kind_mut(&base, :takes_param);
        END
        MUTABLE plan: LifecyclePlan = lifecyclePlanner__monomorphic_carrier_plan(param.type);
        IF lifecycle_registry EXISTS AS registry THEN
          plan = COPY lifecycleRegistry__fetch_monomorphic(registry, param.type);
        END
        cleanupEntry__set_lifecycle_plan_mut(&base, plan);
        bindings[COPY param.name] = KEEP base;
      END
    END
  END
  # Kept-identity params own the Rc handle their call edge normalized; release
  # at scope exit unless a consumer moved it.
  FOR param IN fn_node.params DO
    IF !((param.takes OR_ELSE FALSE)) THEN
      IF param.symbol EXISTS AS symbol THEN
        IF symbolEntry__kept_identity(symbol) THEN
          MUTABLE base = cleanupClassifier__rc_entry(:heap);
          cleanupEntry__mark_moved_guard_mut(&base);
          cleanupEntry__set_alloc_mut(&base, :heap);
          IF !(cleanupEntry__source_kind(base) EXISTS) THEN
            cleanupEntry__set_source_kind_mut(&base, :kept_param);
          END
          bindings[COPY param.name] = KEEP base;
        END
      END
    END
  END
END
PUB FN cleanupClassifier__owned_value_entry(ti: Type, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !?CleanupEntry@multiowned ->
  RETURN TRY (cleanupClassifier__takes_param_base_entry(ti, schema_lookup));
END
PRIVATE FN cleanupClassifier__schema_resource?(schema: ?TypeSchemaLookupResult) RETURNS Bool ->
  RETURN (schema? IS_A ResourceSchema);
END
PRIVATE FN cleanupClassifier__schema_union?(schema: ?TypeSchemaLookupResult) RETURNS Bool ->
  RETURN (schema? IS_A UnionSchema);
END
PRIVATE FN cleanupClassifier__schema_close_plan(schema: ?TypeSchemaLookupResult) RETURNS ?ResourceClosePlan ->
  IF schema EXISTS AS schema_value THEN
    PARTIAL MATCH schema_value START
      TypeSchemaLookupResult.ResourceSchemaMultiowned AS resource -> RETURN COPY resource.close_plan;
    END
  END
  RETURN NIL;
END
PRIVATE FN cleanupClassifier__schema_union(schema: ?TypeSchemaLookupResult) RETURNS ?UnionSchema@multiowned ->
  IF schema EXISTS AS schema_value THEN
    PARTIAL MATCH schema_value START
      TypeSchemaLookupResult.UnionSchemaMultiowned AS union_schema -> RETURN KEEP union_schema;
    END
  END
  RETURN NIL;
END
PUB FN cleanupClassifier__takes_param_base_entry(ti: Type, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, lifecycle_registry: ?LifecycleRegistry = NIL) RETURNS !?CleanupEntry@multiowned ->
  IF lifecycle_registry EXISTS AS registry THEN
    IF !(lifecyclePlan__needs_drop?(TRY (lifecycleRegistry__fetch(registry, ti)))) THEN
      RETURN NIL;
    END
  END
  MUTABLE schema: ?TypeSchemaLookupResult = schema_lookup(type__resolved(ti));
  IF (cleanupClassifier__schema_resource?(schema) AND !(TRY (type__any_rc?(ti)))) THEN
    RETURN cleanupClassifier__resource_entry(COPY UNWRAP (cleanupClassifier__schema_close_plan(schema)));
  END
  IF cleanupClassifier__schema_union?(schema) THEN
    # Heap variants pin the allocator exactly as classify_non_copy_union does
    # for a local of the same type: the payload is already on the heap, so a
    # consuming site must not rebase the recipe onto its own placement.
    IF TRY (cleanupClassifier__union_variants_need_cleanup?(cleanupClassifier__schema_union(schema), schema_lookup)) THEN
      MUTABLE union_entry = cleanupEntry__build(:takes_union, :heap, TRUE);
      cleanupEntry__set_fixed_alloc_mut(&union_entry, TRUE);
      RETURN KEEP union_entry;
    END
    RETURN NIL;
  END
  IF (TRY (cleanupClassifier__classify_optional(ti, schema_lookup))) EXISTS AS opt THEN
    RETURN KEEP opt;
  END
  IF TRY (cleanupClassifier__cleanup_owned_string_type?(ti)) THEN
    RETURN cleanupClassifier__entry(:heap_string);
  END
  IF (TRY (cleanupClassifier__classify_collection(ti, schema_lookup))) EXISTS AS coll THEN
    RETURN KEEP coll;
  END
  IF TRY (type__direct_indexable_collection?(ti)) THEN
    MUTABLE elem_zig: String = "UNKNOWN";
    IF (TRY (type__element_type(ti))) EXISTS AS elem_type THEN
      elem_zig = COPY TRY (type__zig_type(elem_type));
    END
    RETURN cleanupClassifier__uniform_elem_entry(COPY elem_zig);
  END
  IF (TRY (cleanupClassifier__classify_struct_cleanup_fields(ti, NIL, schema_lookup))) EXISTS AS struct_entry THEN
    RETURN KEEP struct_entry;
  END
  IF cleanupClassifier__classify_structural_product(ti, schema_lookup) EXISTS AS structural_product THEN
    RETURN KEEP structural_product;
  END
  IF lifecycle_registry EXISTS AS registry THEN
    MUTABLE plan: LifecyclePlan = TRY (lifecycleRegistry__fetch(registry, ti));
    IF lifecyclePlan__needs_drop?(plan) THEN
      MUTABLE fallback = cleanupClassifier__entry(:uniform, :heap, TRUE);
      cleanupEntry__set_lifecycle_plan_mut(&fallback, plan);
      RETURN KEEP fallback;
    END
  END
  RETURN NIL;
END
PUB FN cleanupClassifier__walk_match_as_bindings(body: []Locatable, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, lifecycle_registry: ?LifecycleRegistry, MUTABLE bindings: {String}CleanupEntry) RETURNS !Void ->
  aST__each_locatable_list(body, FALSE, %(node: Locatable) USE(MUTABLE bindings, lifecycle_registry, schema_lookup) -> {
  IF node IS_A MatchStatement AS match_stmt THEN
    IF (match_stmt.takes OR_ELSE FALSE) THEN
      IF match_stmt.expr IS_A Identifier AS subject THEN
        IF (subject.was_moved OR_ELSE FALSE) THEN
          cleanupClassifier__stamp_match_as_bindings_mut(match_stmt, subject, schema_lookup, lifecycle_registry, &bindings);
        END
      END
    END
  END
  rubyToClearVoid()
  });
END
PRIVATE FN cleanupClassifier__stamp_match_as_bindings_mut(match_stmt: MatchStatement, subject: Identifier, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, lifecycle_registry: ?LifecycleRegistry, MUTABLE bindings: {String}CleanupEntry) RETURNS !Void ->
  MUTABLE source_ti: Type = TRY (aST__full_type_mut(Locatable{ Identifier: COPY subject }));
  MUTABLE union_lookup: String@symbol = type__resolved(source_ti);
  IF type__generic_instance?(source_ti) THEN
    union_lookup = COPY type__generic_base(source_ti);
  END
  MUTABLE schema: ?UnionSchema@multiowned = cleanupClassifier__schema_union(schema_lookup(union_lookup));
  IF !(schema EXISTS) THEN
    RETURN;
  END
  MUTABLE variants: {String@symbol}?SchemasUnionSchemaVariantValue = COPY UNWRAP (schema).variants;
  FOR match_case IN match_stmt.cases DO
    IF match_case.binding EXISTS AS binding_name THEN
      IF cleanupClassifier__match_case_variant_name(match_case) EXISTS AS variant_name THEN
        IF variants[variant_name] EXISTS AS variant_type THEN
          IF (TRY (cleanupClassifier__match_as_entry_for(variant_type, UnionLookup{ SymbolValue: COPY union_lookup }, VariantName{ SymbolValue: COPY variant_name }))) EXISTS AS found THEN
            MUTABLE e = KEEP found;
            IF lifecycle_registry EXISTS AS registry THEN
              MUTABLE variant_plan_type: Type = COPY source_ti;
              PARTIAL MATCH variant_type START
                SchemasUnionSchemaVariantValue.TypeMultiowned AS variant_ti -> variant_plan_type = COPY variant_ti;
              END
              cleanupEntry__set_lifecycle_plan_mut(&e, TRY (lifecycleRegistry__fetch(registry, variant_plan_type)));
            END
            IF bindings[COPY subject.name] EXISTS AS src_entry THEN
              cleanupEntry__set_alloc_mut(&e, cleanupEntry__alloc(src_entry));
            END
            bindings[COPY binding_name] = KEEP e;
          END
        END
      END
    END
  END
END
PRIVATE FN cleanupClassifier__match_case_variant_name(match_case: MatchCase) RETURNS ?String@symbol ->
  IF match_case.value IS_A GetField AS get_field THEN
    RETURN symbol(COPY get_field.field);
  END
  IF match_case.value IS_A MethodCall AS method_call THEN
    RETURN symbol(COPY method_call.name);
  END
  RETURN NIL;
END
PUB FN cleanupClassifier__match_as_entry_for(variant_type: ?SchemasUnionSchemaVariantValue, union_lookup: UnionLookup, variant_name: VariantName) RETURNS !?CleanupEntry@multiowned ->
  MUTABLE _ = COPY union_lookup;
  _ = castVariantNameToUnionLookup(COPY variant_name);
  IF variant_type? IS_A InlineStructVariant AS inline_struct_variant THEN
    IF !(TRY (type__variant_has_heap?(SchemasUnionSchemaVariantValue{ InlineStructVariantMultiowned: COPY inline_struct_variant }))) THEN
      RETURN NIL;
    END
    RETURN cleanupClassifier__match_as_entry();
  END
  IF variant_type? IS_A Type AS type THEN
    IF type__indirect?(type) THEN
      RETURN NIL;
    END
    IF (type__array?(type) AND !(TRY (type__string?(type)))) THEN
      MUTABLE elem_zig: String = "UNKNOWN";
      IF (TRY (type__element_type(type))) EXISTS AS elem_type THEN
        elem_zig = COPY TRY (type__zig_type(elem_type));
      END
      RETURN cleanupClassifier__uniform_elem_entry(COPY elem_zig, TRUE);
    ELSE_IF type__map?(type) THEN
      RETURN cleanupClassifier__match_as_entry();
    END
    RETURN NIL;
  ELSE
    RETURN NIL;
  END
END
PUB FN cleanupClassifier__walk_capture_bindings(MUTABLE body: []Locatable, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, lifecycle_registry: ?LifecycleRegistry, MUTABLE bindings: {String}CleanupEntry) RETURNS !Void ->
  aST__each_locatable_list_mut(&body, FALSE, %(MUTABLE node: Locatable) USE(MUTABLE bindings, lifecycle_registry, schema_lookup) -> {
  PARTIAL MATCH node START
    Locatable.WhileBindLoop AS while_bind -> cleanupClassifier__capture_binding_mut(COPY while_bind.binding_name, COPY while_bind.condition, COPY while_bind.condition, schema_lookup, lifecycle_registry, &bindings);,
    Locatable.IfBind AS MUTABLE if_bind -> cleanupClassifier__if_bind_captures_mut(&if_bind, schema_lookup, lifecycle_registry, &bindings);
  END
  rubyToClearVoid()
  });
END
PRIVATE FN cleanupClassifier__if_bind_captures_mut(MUTABLE if_bind: IfBind, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, lifecycle_registry: ?LifecycleRegistry, MUTABLE bindings: {String}CleanupEntry) RETURNS Void ->
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < if_bind.bindings.length() DO
    MUTABLE binding: Binding = COPY UNWRAP (if_bind.bindings[rtoc_idx]);
    IF cleanupClassifier__capture_entry(COPY binding.expr, COPY binding.expr, schema_lookup, lifecycle_registry) EXISTS AS found THEN
      binding.mir_binding_entry = KEEP found;
      bindings[COPY binding.name] = KEEP found;
      if_bind.bindings[rtoc_idx] = COPY binding;
    END
    rtoc_idx = rtoc_idx + 1;
  END
END
PRIVATE FN cleanupClassifier__capture_binding_mut(name: String, expr: Locatable, classification_node: Locatable, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, lifecycle_registry: ?LifecycleRegistry, MUTABLE bindings: {String}CleanupEntry) RETURNS Void ->
  IF cleanupClassifier__capture_entry(expr, classification_node, schema_lookup, lifecycle_registry) EXISTS AS found THEN
    bindings[COPY name] = KEEP found;
  END
END
PRIVATE FN cleanupClassifier__capture_entry(expr: Locatable, classification_node: Locatable, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, lifecycle_registry: ?LifecycleRegistry) RETURNS ?CleanupEntry@multiowned ->
  IF !(aST__capture_expr_owns_result?(expr)) THEN
    RETURN NIL;
  END
  MUTABLE expr_ti: Type = TRY (aST__capture_expr_source_type(expr));
  MUTABLE inner_opt: ?Type = type__wrapped_type(expr_ti);
  IF type__stream_step?(expr_ti) THEN
    inner_opt = type__stream_step_item_type(expr_ti);
  ELSE_IF type__error_union?(expr_ti) THEN
    inner_opt = type__success_type(expr_ti);
  END
  IF !(inner_opt EXISTS) THEN
    RETURN NIL;
  END
  MUTABLE inner_ti: Type = COPY UNWRAP (inner_opt);
  MUTABLE e: ?CleanupEntry@multiowned = cleanupClassifier__classify_binding(inner_ti, classification_node, schema_lookup, lifecycle_registry);
  IF !(lifecycle_registry EXISTS) THEN
    IF !(e EXISTS) THEN
      IF cleanupClassifier__cleanup_owned_string_type?(inner_ti) THEN
        e = KEEP cleanupClassifier__entry(:heap_string, :heap, TRUE);
      ELSE_IF type__needs_explicit_cleanup?(inner_ti, :heap, schema_lookup) THEN
        e = KEEP cleanupClassifier__entry(:uniform);
      END
    END
  END
  IF !(e EXISTS) THEN
    RETURN NIL;
  END
  MUTABLE entry_value = KEEP UNWRAP (e);
  IF cleanupClassifier__capture_expr_owned_alloc(expr, schema_lookup) EXISTS AS capture_alloc THEN
    cleanupEntry__set_alloc_mut(&entry_value, capture_alloc);
  END
  IF !(cleanupEntry__zig_type(entry_value) EXISTS) THEN
    cleanupEntry__set_zig_type_mut(&entry_value, type__zig_type(inner_ti));
  END
  IF type__element_type(inner_ti) EXISTS AS elem_type THEN
    IF !(cleanupEntry__elem_zig_type(entry_value) EXISTS) THEN
      cleanupEntry__set_elem_zig_type_mut(&entry_value, type__zig_type(elem_type));
    END
  END
  RETURN KEEP entry_value;
END
PUB FN cleanupClassifier__capture_expr_heap?(expr: Locatable, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Bool ->
  RETURN (TRY (cleanupClassifier__capture_expr_owned_alloc(expr, schema_lookup)) == :heap);
END
PUB FN cleanupClassifier__capture_expr_owned_alloc(expr: Locatable, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !?String@symbol ->
  IF (expr IS_A NextExpr OR expr IS_A ResolveNode) THEN
    # NEXT transfers an awaited value (or a popped stream item) into the
    # receiving binding; async results are materialized in heap storage.
    RETURN :heap;
  END
  IF !((expr IS_A FuncCall OR expr IS_A MethodCall)) THEN
    RETURN NIL;
  END
  IF TRY (cleanupClassifier__call_has_return_lifetime?(expr)) THEN
    RETURN NIL;
  END
  IF TRY (cleanupClassifier__call_returns_heap_owned?(expr, schema_lookup)) THEN
    RETURN :heap;
  END
  IF TRY (cleanupClassifier__call_returns_frame_owned?(expr)) THEN
    RETURN :frame;
  END
  IF expr IS_A MethodCall AS method_call THEN
    IF TRY (cleanupClassifier__call_returns_receiver_owned?(expr)) THEN
      RETURN cleanupClassifier__receiver_storage_alloc(method_call);
    END
    IF aST__node__symbol(method_call.object) EXISTS AS receiver_symbol THEN
      IF symbolEntry__heap_storage?(receiver_symbol) THEN
        RETURN :heap;
      END
    END
  END
  RETURN NIL;
END
PUB FN cleanupClassifier__call_returns_heap_owned?(expr: Locatable, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Bool ->
  MUTABLE sig: ?FunctionSignature@multiowned = KEEP aST__node__matched_signature(expr);
  IF sig EXISTS AS sig_value THEN
    MUTABLE sig_value_mutable = COPY sig_value;
    IF (TRUE AND !(((TRY (functionSignature__return_lifetime(sig_value_mutable))).length() == 0))) THEN
      RETURN FALSE;
    END
    IF (TRUE AND (functionSignature__heap_carry_return(sig_value_mutable) == TRUE)) THEN
      RETURN TRUE;
    END
    IF TRY (functionSignature__heap_return_alloc?(&sig_value_mutable)) THEN
      RETURN TRUE;
    END
    IF TRY (functionSignature__frame_return_alloc?(&sig_value_mutable)) THEN
      RETURN FALSE;
    END
    IF !(TRUE) THEN
      RETURN FALSE;
    END
    MUTABLE ret = TRY (type__new(TypeConstructionInput{ Type: COPY functionSignature__return_type(sig_value_mutable) }));
    ret = TRY (type__success_type(ret));
    RETURN (!(!(ret)) AND TRY (type__needs_explicit_cleanup?(ret, :heap, schema_lookup)));
  ELSE
    RETURN FALSE;
  END
END
PUB FN cleanupClassifier__call_returns_frame_owned?(expr: Locatable) RETURNS !Bool ->
  MUTABLE sig: ?FunctionSignature@multiowned = KEEP aST__node__matched_signature(expr);
  RETURN !(!((IF sig != NIL THEN
    TRY (functionSignature__frame_return_alloc?(&sig))
  ELSE
    NIL
  END)));
END
PUB FN cleanupClassifier__call_returns_receiver_owned?(expr: Locatable) RETURNS !Bool ->
  MUTABLE sig: ?FunctionSignature@multiowned = KEEP aST__node__matched_signature(expr);
  RETURN ((sig != NIL) AND (TRY (functionSignature__return_alloc(&sig)) == :receiver_storage));
END
PUB FN cleanupClassifier__receiver_storage_alloc(expr: MethodCall) RETURNS ?String@symbol ->
  MUTABLE receiver = COPY expr.object;
  MUTABLE storage: ?String@symbol = NIL;
  IF aST__node__symbol(receiver) EXISTS AS symbol THEN
    storage = COPY symbolEntry__storage(symbol);
  END
  IF (storage == :heap) THEN
    RETURN :heap;
  END
  IF (storage == :frame) THEN
    RETURN :frame;
  END
  MUTABLE root_storage: ?String@symbol = NIL;
  IF aST__root_identifier(receiver) EXISTS AS root THEN
    IF root.symbol EXISTS AS root_symbol THEN
      root_storage = COPY symbolEntry__storage(root_symbol);
    END
  END
  IF (root_storage == :heap) THEN
    RETURN :heap;
  END
  IF (root_storage == :frame) THEN
    RETURN :frame;
  END
  RETURN NIL;
END
PUB FN cleanupClassifier__call_has_return_lifetime?(expr: Locatable) RETURNS !Bool ->
  IF aST__node__matched_signature(expr) EXISTS AS sig THEN
    RETURN !(((TRY (functionSignature__return_lifetime(sig))).length() == 0));
  END
  RETURN FALSE;
END
PUB FN cleanupClassifier__classify_binding(ti: Type, node: Locatable, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, lifecycle_registry: ?LifecycleRegistry = NIL) RETURNS !?CleanupEntry@multiowned ->
  IF TRY (type__node_reference?(ti)) THEN
    RETURN NIL;
  END
  MUTABLE facts = cleanupClassifier__binding_cleanup_facts(node);
  IF facts.container_borrow THEN
    RETURN NIL;
  END
  IF ((type__optional?(ti) AND facts.empty_initializer) AND !(facts.mutable_binding_mutated)) THEN
    RETURN NIL;
  END
  IF !(facts.heap_storage) THEN
    IF facts.borrow_provenance THEN
      RETURN NIL;
    END
    IF (TRY (type__string?(ti)) AND !(TRY (cleanupClassifier__mutable_owning_slot?(ti, node, schema_lookup)))) THEN
      IF facts.rodata_provenance THEN
        RETURN NIL;
      END
    END
    IF cleanupClassifier__literal_only_list?(node) THEN
      RETURN NIL;
    END
  END
  MUTABLE lifecycle: ?LifecyclePlan = NIL;
  IF lifecycle_registry EXISTS AS registry THEN
    lifecycle = COPY TRY (lifecycleRegistry__fetch_binding(registry, node, ti));
    IF !(lifecyclePlan__needs_drop?(COPY UNWRAP (lifecycle))) THEN
      RETURN NIL;
    END
  END
  MUTABLE entry: ?CleanupEntry@multiowned = NIL;
  MUTABLE schema: ?TypeSchemaLookupResult = schema_lookup(type__resolved(ti));
  IF (cleanupClassifier__schema_resource?(schema) AND !(TRY (type__any_rc?(ti)))) THEN
    entry = cleanupClassifier__resource_entry(COPY UNWRAP (cleanupClassifier__schema_close_plan(schema)));
  END
  IF cleanupClassifier__tuple_with_borrowed_element?(ti) THEN
    entry = (entry OR_ELSE cleanupClassifier__classify_structural_product(ti, schema_lookup));
  END
  IF (TRY (type__tense_observable?(ti)) AND !(type__promise_list?(ti))) THEN
    entry = (entry OR_ELSE cleanupClassifier__entry(:uniform, :heap, FALSE));
  END
  IF (!(entry EXISTS) AND type__frozen?(ti)) THEN
    entry = cleanupClassifier__entry(:frozen, :heap, FALSE);
    cleanupClassifier__set_entry_fixed_alloc_mut(&entry);
  END
  IF cleanupClassifier__stream_handle_type?(ti) THEN
    entry = (entry OR_ELSE cleanupClassifier__entry(:uniform, :heap, TRUE));
  END
  IF (!(entry EXISTS) AND (facts.resource_close_plan EXISTS)) THEN
    entry = cleanupClassifier__resource_entry(COPY UNWRAP (facts.resource_close_plan));
  END
  entry = (entry OR_ELSE cleanupClassifier__classify_mutable_owning_slot(ti, node, schema_lookup));
  entry = (entry OR_ELSE TRY (cleanupClassifier__classify_optional(ti, schema_lookup, node)));
  IF ((!(entry EXISTS) AND facts.heap_storage) AND TRY (type__recursive_cleanup_shape?(ti, schema_lookup))) THEN
    entry = cleanupClassifier__entry(:uniform, :heap, FALSE);
    cleanupClassifier__set_entry_fixed_alloc_mut(&entry);
  END
  entry = (entry OR_ELSE cleanupClassifier__classify_owned_return_call(ti, node, schema_lookup));
  entry = (entry OR_ELSE TRY (cleanupClassifier__classify_collection(ti, schema_lookup, node)));
  IF ((!(entry EXISTS) AND TRY (type__direct_indexable_collection?(ti))) AND TRY (cleanupClassifier__elem_needs_cleanup?(ti, schema_lookup))) THEN
    entry = cleanupClassifier__entry(:uniform, :heap, TRUE);
  END
  IF ((!(type__optional?(ti)) AND ((TRY (type__heap_ptr?(ti)) OR type__indirect?(ti)))) AND cleanupClassifier__ownership_bearing_type?(ti, schema_lookup)) THEN
    entry = (entry OR_ELSE cleanupClassifier__entry(:uniform, :heap, TRUE));
  END
  entry = (entry OR_ELSE TRY (cleanupClassifier__classify_array_struct_strings(ti, node, schema_lookup)));
  entry = (entry OR_ELSE cleanupClassifier__classify_rc_or_link(ti, schema_lookup));
  IF (type__any_sync?(ti) OR symbolEntry__cleanup_sync?(facts.sync)) THEN
    entry = (entry OR_ELSE cleanupClassifier__entry(:uniform, :heap, FALSE));
  END
  entry = (entry OR_ELSE TRY (cleanupClassifier__classify_owned_string(ti, node, schema_lookup)));
  entry = (entry OR_ELSE TRY (cleanupClassifier__classify_heap_storage(ti, node, schema_lookup, facts.sync)));
  entry = (entry OR_ELSE TRY (cleanupClassifier__classify_heap_composite(ti, node, schema_lookup, facts.sync)));
  entry = (entry OR_ELSE TRY (cleanupClassifier__classify_struct_cleanup_fields(ti, node, schema_lookup)));
  entry = (entry OR_ELSE cleanupClassifier__classify_structural_product(ti, schema_lookup));
  entry = (entry OR_ELSE TRY (cleanupClassifier__classify_non_copy_union(ti, schema_lookup)));
  IF lifecycle EXISTS AS lifecycle_drop THEN
    IF lifecyclePlan__needs_drop?(lifecycle_drop) THEN
      entry = (entry OR_ELSE cleanupClassifier__entry(:uniform, :heap, TRUE));
    END
  END
  MUTABLE finalized: ?CleanupEntry@multiowned = TRY (cleanupClassifier__finalize_alloc_from_storage_mut(&entry, node, ti, schema_lookup));
  IF lifecycle EXISTS AS lifecycle_value THEN
    IF finalized EXISTS AS finalized_value THEN
      MUTABLE finalized_mutable = KEEP finalized_value;
      cleanupEntry__set_lifecycle_plan_mut(&finalized_mutable, COPY lifecycle_value);
      RETURN KEEP finalized_mutable;
    END
  END
  RETURN finalized;
END
PRIVATE FN cleanupClassifier__set_entry_fixed_alloc_mut(MUTABLE entry: ?CleanupEntry) RETURNS Void ->
  IF entry EXISTS AS entry_value THEN
    MUTABLE entry_mutable: CleanupEntry = COPY entry_value;
    cleanupEntry__set_fixed_alloc_mut(&entry_mutable, TRUE);
    entry = COPY entry_mutable;
  END
END
PUB FN cleanupClassifier__tuple_with_borrowed_element?(ti: Type) RETURNS !Bool ->
  IF !(type__tuple?(ti)) THEN
    RETURN FALSE;
  END
  RETURN (TRY (type__generic_args(ti))) |> ANY (type__symbol?(_) OR type__borrowed_reference?(_));
END
PUB FN cleanupClassifier__classify_structural_product(ti: Type, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !?CleanupEntry@multiowned ->
  IF !(type__tuple?(ti)) THEN
    RETURN NIL;
  END
  MUTABLE fields: []TupleCleanupField = List[];
  MUTABLE args: []Type = TRY (type__generic_args(ti));
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < args.length() DO
    MUTABLE arg: Type = COPY UNWRAP (args[rtoc_idx]);
    IF !((type__symbol?(arg) OR type__borrowed_reference?(arg))) THEN
      MUTABLE close = TRY (type__resolve_resource_close(arg, schema_lookup));
      IF (close.is_resource AND (close.close_plan EXISTS)) THEN
        &fields.append(TupleCleanupField{ index: rtoc_idx, close_plan: COPY close.close_plan });
      ELSE_IF TRY (type__recursive_cleanup_shape?(arg, schema_lookup)) THEN
        &fields.append(TupleCleanupField{ index: rtoc_idx, close_plan: NIL });
      END
    END
    rtoc_idx = rtoc_idx + 1;
  END
  IF (fields.length() == 0) THEN
    RETURN NIL;
  END
  MUTABLE tuple_entry = cleanupEntry__build(:tuple, :heap, TRUE);
  cleanupEntry__set_tuple_cleanup_fields_mut(&tuple_entry, fields);
  RETURN KEEP tuple_entry;
END
PUB FN cleanupClassifier__binding_cleanup_facts(node: Locatable) RETURNS BindingCleanupFacts ->
  MUTABLE sync: ?String@symbol = NIL;
  IF aST__node__symbol(node) EXISTS AS symbol THEN
    sync = COPY symbolEntry__sync(symbol);
  END
  MUTABLE mutated = FALSE;
  IF node IS_A VarDecl AS var_decl THEN
    mutated = (var_decl.mutable AND (var_decl.var_mutated OR_ELSE FALSE));
  END
  RETURN BindingCleanupFacts{
    container_borrow: cleanupClassifier__binding_container_borrow?(node),
    heap_storage: aST__node_heap_storage?(node),
    borrow_provenance: aST__node_borrow_provenance?(node),
    rodata_provenance: aST__node_rodata_provenance?(node),
    empty_initializer: cleanupClassifier__optional_empty_initializer?(cleanupClassifier__binding_value(node)),
    mutable_binding_mutated: mutated,
    resource_close_plan: COPY aST__node_resource_close_plan(node),
    sync: COPY sync
  };
END
PUB FN cleanupClassifier__binding_value(node: Locatable) RETURNS ?Locatable ->
  IF node IS_A VarDecl AS var_decl THEN
    RETURN CAST(var_decl.value AS ?Locatable);
  ELSE_IF node IS_A BindExpr AS bind_expr THEN
    RETURN CAST(bind_expr.value AS ?Locatable);
  ELSE_IF node IS_A WhileBindLoop AS while_bind_loop THEN
    RETURN COPY castLocatableToOptionalLocatable(while_bind_loop.condition);
  ELSE
    RETURN NIL;
  END
END
PUB FN cleanupClassifier__binding_container_borrow?(node: Locatable) RETURNS Bool ->
  RETURN (aST__container_borrow?(node) OR aST__container_borrow?(cleanupClassifier__binding_value(node)));
END
PUB FN cleanupClassifier__finalize_alloc_from_storage_mut(MUTABLE entry: ?CleanupEntry, node: Locatable, ti: Type, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !?CleanupEntry@multiowned ->
  IF !(entry EXISTS) THEN
    RETURN NIL;
  END
  MUTABLE finalized: CleanupEntry@multiowned = KEEP UNWRAP (entry);
  IF cleanupEntry__fixed_alloc?(finalized) THEN
    RETURN KEEP finalized;
  END
  MUTABLE storage: ?String@symbol = cleanupClassifier__storage_from_symbol(aST__node__symbol(node), node);
  MUTABLE type_alloc: String@symbol = TRY (type__cleanup_allocator(ti, schema_lookup));
  MUTABLE alloc: String@symbol = :frame;
  IF ((type_alloc == :heap) OR (storage == :heap)) THEN
    alloc = :heap;
  END
  cleanupEntry__set_alloc_mut(&finalized, alloc);
  RETURN KEEP finalized;
END
PUB FN cleanupClassifier__storage_from_symbol(sym: ?SymbolEntry, node: Locatable) RETURNS ?String@symbol ->
  IF sym EXISTS AS sym_value THEN
    MUTABLE symbol: SymbolEntry = COPY (aST__declaration_symbol(sym_value) OR_ELSE sym_value);
    RETURN COPY symbolEntry__storage(symbol);
  END
  RETURN COPY aST__node_storage_override(node);
END
PUB FN cleanupClassifier__entry(kind: String@symbol, alloc: String@symbol = :heap, has_moved_guard: Bool = TRUE) RETURNS CleanupEntry@multiowned ->
  RETURN cleanupEntry__build(kind, alloc, has_moved_guard);
END
PRIVATE FN cleanupClassifier__rc_entry(rc_alloc: String@symbol) RETURNS CleanupEntry@multiowned ->
  MUTABLE built = cleanupEntry__build(:rc, :heap, TRUE);
  cleanupEntry__set_rc_alloc_mut(&built, rc_alloc);
  RETURN KEEP built;
END
PRIVATE FN cleanupClassifier__resource_entry(close_plan: ResourceClosePlan) RETURNS CleanupEntry@multiowned ->
  MUTABLE built = cleanupEntry__build(:resource, :heap, TRUE);
  cleanupEntry__set_resource_close_plan_mut(&built, close_plan);
  RETURN KEEP built;
END
PRIVATE FN cleanupClassifier__uniform_elem_entry(elem_zig: String, match_as: Bool = FALSE) RETURNS CleanupEntry@multiowned ->
  MUTABLE built = cleanupEntry__build(:uniform, :heap, TRUE);
  cleanupEntry__set_elem_zig_type_mut(&built, elem_zig);
  cleanupEntry__set_match_as_mut(&built, match_as);
  RETURN KEEP built;
END
PRIVATE FN cleanupClassifier__match_as_entry() RETURNS CleanupEntry@multiowned ->
  MUTABLE built = cleanupEntry__build(:uniform, :heap, TRUE);
  cleanupEntry__set_match_as_mut(&built, TRUE);
  RETURN KEEP built;
END
PUB FN cleanupClassifier__stream_handle_type?(ti: Type) RETURNS !Bool ->
  RETURN (((((TRY (type__dynamic_stream?(ti)) OR TRY (type__bounded_stream?(ti))) OR TRY (type__open_stream?(ti))) OR TRY (type__inf_stream?(ti))) OR TRY (type__split_open_stream?(ti))) OR type__shared_promise?(ti));
END
PUB FN cleanupClassifier__mutable_owning_slot?(ti: Type, node: Locatable, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Bool ->
  IF !((aST__node_var_mutated(node) OR_ELSE FALSE)) THEN
    RETURN FALSE;
  END
  RETURN TRY (cleanupClassifier__ownership_bearing_type?(ti, schema_lookup));
END
PUB FN cleanupClassifier__ownership_bearing_type?(ti: Type, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Bool ->
  RETURN TRY (type__ownership_bearing?(ti, schema_lookup));
END
PUB FN cleanupClassifier__cleanup_owned_string_type?(ti: Type) RETURNS !Bool ->
  RETURN ((TRY (type__string?(ti)) AND !(type__symbol?(ti))) AND !(type__raw?(ti)));
END
PUB FN cleanupClassifier__classify_mutable_owning_slot(ti: Type, node: Locatable, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !?CleanupEntry@multiowned ->
  IF !(TRY (cleanupClassifier__mutable_owning_slot?(ti, node, schema_lookup))) THEN
    RETURN NIL;
  END
  MUTABLE kind = IF TRY (type__string?(ti)) THEN
    :heap_string
  ELSE
    :uniform
  END;
  MUTABLE alloc = TRY (type__cleanup_allocator(ti, schema_lookup));
  MUTABLE e = cleanupClassifier__entry(kind, alloc, TRUE);
  RETURN e;
END
PUB FN cleanupClassifier__classify_owned_return_call(ti: Type, node: Locatable, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !?CleanupEntry@multiowned ->
  IF !(cleanupClassifier__binding_value(node) EXISTS) THEN
    RETURN NIL;
  END
  IF !(cleanupClassifier__contains_call?(COPY UNWRAP (cleanupClassifier__binding_value(node)))) THEN
    RETURN NIL;
  END
  IF !(aST__node__symbol(node) EXISTS) THEN
    RETURN NIL;
  END
  IF !((symbolEntry__storage(COPY UNWRAP (aST__node__symbol(node))) == :heap)) THEN
    RETURN NIL;
  END
  MUTABLE ret: Type = TRY (type__success_type(ti));
  IF !(((TRY (type__needs_explicit_cleanup?(ret, :heap, schema_lookup)) OR TRY (type__heap_ptr?(ret))) OR TRY (type__recursive_cleanup_shape?(ret, schema_lookup)))) THEN
    RETURN NIL;
  END
  MUTABLE kind: String@symbol = :uniform;
  IF TRY (type__string?(ret)) THEN
    kind = :heap_string;
  END
  MUTABLE e = cleanupClassifier__entry(kind, :heap, TRUE);
  cleanupEntry__set_fixed_alloc_mut(&e, TRUE);
  RETURN KEEP e;
END
PUB FN cleanupClassifier__contains_call?(node: Locatable) RETURNS Bool ->
  MUTABLE found: Bool = FALSE;
  aST__each_locatable(node, TRUE, %(cur: Locatable) USE(MUTABLE found) -> {
  IF aST__call?(cur) THEN
      found = TRUE;
  END
  rubyToClearVoid()
  });
  RETURN found;
END
PUB FN cleanupClassifier__classify_collection(ti: Type, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, node: ?Locatable = NIL) RETURNS !?CleanupEntry@multiowned ->
  IF TRY (type__any_rc?(ti)) THEN
    RETURN NIL;
  END
  IF type__fixed_soa?(ti) THEN
    RETURN cleanupClassifier__entry(:uniform, cleanupClassifier__wrapper_alloc(ti), FALSE);
  END
  MUTABLE is_heap = FALSE;
  IF node EXISTS AS node_value THEN
    is_heap = aST__node_heap_storage?(node_value);
  END
  IF ((type__list_collection?(ti) AND !(type__sharded?(ti))) AND !(is_heap)) THEN
    MUTABLE has_heap_elems = TRY (cleanupClassifier__elem_needs_cleanup?(ti, schema_lookup));
    MUTABLE frame_entry = cleanupEntry__build(:uniform, :frame, TRUE);
    cleanupEntry__set_elem_needs_cleanup_mut(&frame_entry, has_heap_elems);
    RETURN KEEP frame_entry;
  END
  IF type__list_collection?(ti) THEN
    RETURN cleanupClassifier__entry(:uniform, :heap, TRUE);
  END
  IF type__map?(ti) THEN
    RETURN cleanupClassifier__entry(:uniform);
  END
  IF type__pool?(ti) THEN
    RETURN cleanupClassifier__entry(:uniform, cleanupClassifier__wrapper_alloc(ti), TRUE);
  END
  IF type__set_collection?(ti) THEN
    RETURN cleanupClassifier__entry(:uniform, cleanupClassifier__wrapper_alloc(ti), TRUE);
  END
  RETURN NIL;
END
PUB FN cleanupClassifier__wrapper_alloc(ti: Type) RETURNS String@symbol ->
  IF type__provenance_alloc(ti) != NIL THEN
  RETURN (type__provenance_alloc(ti))?;
  ELSE
  RETURN :heap;
  END
END
PUB FN cleanupClassifier__classify_array_struct_strings(ti: Type, node: Locatable, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !?CleanupEntry@multiowned ->
  MUTABLE val: ?Locatable = cleanupClassifier__binding_value(node);
  IF !(((TRY (type__non_string_array?(ti)) AND !(type__collection?(ti))) AND ((val? IS_A ListLit OR val? IS_A DefaultArrayLit)))) THEN
    RETURN NIL;
  END
  IF (TRY (type__element_type(ti))) EXISTS AS et_value THEN
    IF TRY (cleanupClassifier__elem_type_needs_cleanup?(et_value, schema_lookup)) THEN
      RETURN cleanupClassifier__entry(:uniform, cleanupClassifier__container_alloc_from(aST__node__symbol(node), node), FALSE);
    END
  END
  RETURN NIL;
END
PUB FN cleanupClassifier__literal_only_list?(node: Any) RETURNS Bool ->
  MUTABLE val = cleanupClassifier__binding_value(node);
  IF !(val IS_A ListLit) THEN
    RETURN FALSE;
  END
  MUTABLE items = val.items();
  IF ((items == NIL) OR items.empty?()) THEN
    RETURN FALSE;
  END
  RETURN items |> ALL _ IS_A Literal;
END
PUB FN cleanupClassifier__container_alloc_from(sym: ?SymbolEntry, node: Any) RETURNS String@symbol ->
  MUTABLE storage = cleanupClassifier__storage_from_symbol(sym, node);
  RETURN PARTIAL MATCH storage START
    :frame -> :frame,
    :stack -> :frame,
    DEFAULT -> :heap
  END;
END
PUB FN cleanupClassifier__classify_rc_or_link(ti: Type, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !?CleanupEntry@multiowned ->
  IF !((TRY (type__any_rc?(ti)) OR type__link?(ti))) THEN
    RETURN NIL;
  END
  IF type__link?(ti) THEN
    RETURN cleanupClassifier__entry(:rc);
  ELSE_IF type__optional?(ti) THEN
    RETURN cleanupClassifier__rc_entry(COPY cleanupClassifier__wrapper_alloc(ti));
  ELSE
    MUTABLE rc_alloc = cleanupClassifier__wrapper_alloc(ti);
    RETURN cleanupClassifier__rc_entry(COPY rc_alloc);
  END
END
PUB FN cleanupClassifier__classify_optional(ti: Type, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, node: Any = NIL) RETURNS !?CleanupEntry@multiowned ->
  IF !(type__optional?(ti)) THEN
    RETURN NIL;
  END
  MUTABLE inner: ?Type = TRY (type__wrapped_type(ti));
  IF inner EXISTS AS inner_value THEN
    MUTABLE inner_value_mutable = COPY inner_value;
    IF !(TRY (cleanupClassifier__optional_payload_needs_cleanup?(inner_value_mutable, schema_lookup))) THEN
      RETURN NIL;
    END
    MUTABLE value = cleanupClassifier__binding_value(node);
    IF cleanupClassifier__optional_empty_initializer?(value) THEN
      RETURN NIL;
    END
    MUTABLE is_rodata = aST__node_rodata_provenance?(node);
    MUTABLE is_borrow = aST__node_borrow_provenance?(node);
    IF (is_rodata OR is_borrow) THEN
      RETURN NIL;
    END
    MUTABLE storage: ?String@symbol = cleanupClassifier__storage_from_symbol(aST__node__symbol(node), node);
    MUTABLE alloc = IF (storage == :heap) THEN
      :heap
    ELSE
      :frame
    END;
    MUTABLE e = cleanupClassifier__entry(:uniform, alloc);
    IF value IS_A NextExpr THEN
      cleanupEntry__set_alloc_mut(&e, :heap);
      e[:fixed_alloc] = TRUE;
    END
    RETURN e;
  ELSE
    RETURN NIL;
  END
END
PUB FN cleanupClassifier__optional_empty_initializer?(value: ?Locatable) RETURNS Bool ->
  IF (IF value? IS_A Literal AS literal THEN (literal.type == symbol("NIL")) ELSE FALSE END) THEN
    RETURN TRUE;
  ELSE
    RETURN FALSE;
  END
END
PUB FN cleanupClassifier__optional_payload_needs_cleanup?(inner: Type, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Bool ->
  IF TRY (cleanupClassifier__cleanup_owned_string_type?(inner)) THEN
    RETURN TRUE;
  END
  IF TRY (type__recursive_cleanup_shape?(inner, schema_lookup)) THEN
    RETURN TRUE;
  END
  IF TRY (type__needs_cleanup?(inner, schema_lookup)) THEN
    RETURN TRUE;
  END
  MUTABLE schema = (runtimeCallSpec__call(CAST(schema_lookup AS RuntimeCallSpec), type__resolved(inner)) OR_ELSE NIL);
  IF cleanupClassifier__schema_union?(schema) THEN
    RETURN TRY (cleanupClassifier__union_variants_need_cleanup?(schema, schema_lookup));
  END
  IF schemas__field_bearing?(schema) THEN
    RETURN TRY (cleanupClassifier__elem_has_string_fields?(schema));
  END
  RETURN FALSE;
END
PUB FN cleanupClassifier__classify_owned_string(ti: Type, node: Locatable, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !?CleanupEntry@multiowned ->
  IF !(TRY (cleanupClassifier__cleanup_owned_string_type?(ti))) THEN
    RETURN NIL;
  END
  MUTABLE value: ?Locatable = cleanupClassifier__binding_value(node);
  IF (!(aST__node_heap_storage?(node)) AND (aST__node_rodata_provenance?(node) OR aST__node_borrow_provenance?(node))) THEN
    RETURN NIL;
  END
  MUTABLE fixed_heap = FALSE;
  MUTABLE owns_heap = aST__node_heap_storage?(node);
  IF value EXISTS AS value_node THEN
    fixed_heap = ((value_node IS_A NextExpr) OR TRY (cleanupClassifier__capture_expr_heap?(value_node, schema_lookup)));
    MUTABLE string_concat_op = FALSE;
    IF value_node IS_A BinaryOp AS binary_op THEN
      string_concat_op = (binary_op.string_concat OR_ELSE FALSE);
    END
    owns_heap = ((((owns_heap OR fixed_heap) OR (value_node IS_A CopyNode)) OR (value_node IS_A StringConcat)) OR string_concat_op);
  END
  IF !(owns_heap) THEN
    RETURN NIL;
  END
  MUTABLE e = cleanupClassifier__entry(:heap_string, :heap, TRUE);
  IF fixed_heap THEN
    cleanupEntry__set_fixed_alloc_mut(&e, TRUE);
  END
  RETURN KEEP e;
END
PUB FN cleanupClassifier__classify_heap_storage(ti: Type, node: Locatable, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, sync_value: ?String@symbol = NIL) RETURNS !?CleanupEntry@multiowned ->
  IF !(aST__node_heap_storage?(node)) THEN
    RETURN NIL;
  END
  IF ((TRY (type__any_rc?(ti)) OR type__link?(ti)) OR symbolEntry__cleanup_sync?(sync_value)) THEN
    RETURN NIL;
  END
  IF TRY (type__implicitly_copyable?(ti, schema_lookup)) THEN
    RETURN NIL;
  END
  IF type__collection?(ti) THEN
    RETURN NIL;
  END
  IF (type__fixed?(ti) AND type__array?(ti)) THEN
    MUTABLE elem: ?Type = TRY (type__element_type(ti));
    IF ((elem != NIL) AND !(TRY (cleanupClassifier__elem_type_needs_cleanup?(elem, schema_lookup)))) THEN
      RETURN NIL;
    END
  END
  IF TRY (cleanupClassifier__cleanup_owned_string_type?(ti)) THEN
    RETURN cleanupClassifier__entry(:heap_string);
  END
  IF (type__array?(ti) AND !(type__collection?(ti))) THEN
    RETURN cleanupClassifier__entry(:uniform);
  END
  MUTABLE schema = (runtimeCallSpec__call(CAST(schema_lookup AS RuntimeCallSpec), type__resolved(ti)) OR_ELSE NIL);
  IF cleanupClassifier__schema_union?(schema) THEN
    MUTABLE has_heap = TRY (cleanupClassifier__union_variants_need_cleanup?(schema, schema_lookup));
    IF has_heap THEN
      RETURN cleanupClassifier__entry(:uniform);
    END
  END
  IF schemas__field_bearing?(schema) THEN
    MUTABLE has_escapable = TRY (cleanupClassifier__elem_has_cleanup_fields?(schema, schema_lookup));
    IF (has_escapable AND TRY (cleanupClassifier__struct_lit_borrows_cleanup_fields?(node, schema, schema_lookup))) THEN
      has_escapable = FALSE;
    END
    IF has_escapable THEN
      RETURN cleanupClassifier__entry(:uniform);
    END
    RETURN cleanupClassifier__entry(:uniform);
  END
  RETURN NIL;
END
PUB FN cleanupClassifier__classify_heap_composite(ti: Type, node: Locatable, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, sync_value: ?String@symbol = NIL) RETURNS !?CleanupEntry@multiowned ->
  IF !(aST__node_heap_storage?(node)) THEN
    RETURN NIL;
  END
  IF ((TRY (type__any_rc?(ti)) OR type__link?(ti)) OR symbolEntry__cleanup_sync?(sync_value)) THEN
    RETURN NIL;
  END
  IF TRY (type__implicitly_copyable?(ti, schema_lookup)) THEN
    RETURN NIL;
  END
  IF type__primitive?(ti) THEN
    RETURN NIL;
  END
  IF (type__fixed?(ti) AND type__array?(ti)) THEN
    MUTABLE elem: ?Type = TRY (type__element_type(ti));
    IF ((elem != NIL) AND !(TRY (cleanupClassifier__elem_type_needs_cleanup?(elem, schema_lookup)))) THEN
      RETURN NIL;
    END
  END
  MUTABLE schema = (runtimeCallSpec__call(CAST(schema_lookup AS RuntimeCallSpec), type__resolved(ti)) OR_ELSE NIL);
  IF cleanupClassifier__schema_union?(schema) THEN
    MUTABLE has_heap = TRY (cleanupClassifier__union_variants_need_cleanup?(schema, schema_lookup));
    IF has_heap THEN
      RETURN cleanupClassifier__entry(:uniform);
    END
  END
  IF schemas__field_bearing?(schema) THEN
    IF !(TRY (cleanupClassifier__elem_has_cleanup_fields?(schema, schema_lookup))) THEN
      RETURN NIL;
    END
    IF TRY (cleanupClassifier__struct_lit_borrows_cleanup_fields?(node, schema, schema_lookup)) THEN
      RETURN NIL;
    END
  END
  RETURN cleanupClassifier__entry(:uniform);
END
PUB FN cleanupClassifier__struct_lit_borrows_cleanup_fields?(node: Any, schema: FieldBearingSchema, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Bool ->
  MUTABLE value = cleanupClassifier__binding_value(node);
  IF !(value IS_A StructLit) THEN
    RETURN FALSE;
  END
  MUTABLE borrowed = TRY (cleanupClassifier__borrowed_field_names(schema));
  RETURN schema.fields() |> ALL { MUTABLE rtoc_value_block_marker = 0; MUTABLE t = TRY (cleanupClassifier__cleanup_field_type(_._1)); (IF !(TRY (cleanupClassifier__elem_type_needs_cleanup?(t, schema_lookup))) THEN TRUE ELSE { MUTABLE rtoc_value_block_marker = 0; MUTABLE fval = (value.fields()[CAST(_._0 AS String)] OR value.fields()[_._0]); (((cleanupClassifier__cleanup_field_borrowed?(_._1) OR borrowed.contains?(CAST(_._0 AS String))) OR ((TRUE AND ((aST__node__symbol(fval) != NIL) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_20 = ((aST__node__symbol(fval))?);
  symbolEntry__borrow_provenance?(rtoc_local_receiver_20) })))) OR ((fval AND type__borrowed_reference?((TRY (type__from_node_mut(fval, "struct literal borrowed field"))))))) } END) };
END
PUB FN cleanupClassifier__classify_struct_cleanup_fields(ti: Type, node: ?Locatable, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !?CleanupEntry@multiowned ->
  MUTABLE schema = (runtimeCallSpec__call(CAST(schema_lookup AS RuntimeCallSpec), type__resolved(ti)) OR_ELSE NIL);
  IF !(schemas__field_bearing?(schema)) THEN
    RETURN NIL;
  END
  MUTABLE value = cleanupClassifier__binding_value(node);
  MUTABLE struct_lit = IF value IS_A StructLit THEN
    value
  ELSE
    NIL
  END;
  MUTABLE borrowed = TRY (cleanupClassifier__borrowed_field_names(schema));
  MUTABLE has_cleanup = schema.fields() |> ANY (IF borrowed.contains?(CAST(_._0 AS String)) THEN FALSE ELSE { MUTABLE rtoc_value_block_marker = 0; MUTABLE t = TRY (cleanupClassifier__cleanup_field_type(_._1)); { MUTABLE rtoc_value_block_marker = 0; IF struct_lit THEN
    MUTABLE fval = (struct_lit.fields()[CAST(_._0 AS String)] OR struct_lit.fields()[_._0]);
    IF (TRUE AND ((aST__node__symbol(fval) != NIL) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_21 = ((aST__node__symbol(fval))?);
    symbolEntry__borrow_provenance?(rtoc_local_receiver_21) })) THEN
      CONTINUE;
    END
    IF fval THEN
      MUTABLE fval_ti = TRY (type__from_node_mut(fval, "struct cleanup field"));
      IF (type__rodata?(fval_ti) OR type__borrowed_reference?(fval_ti)) THEN
        CONTINUE;
      END
    END
  END TRY (cleanupClassifier__elem_type_needs_cleanup?(t, schema_lookup)) } } END);
  IF !(has_cleanup) THEN
    RETURN NIL;
  END
  MUTABLE alloc = IF placement__frame?(type__provenance_alloc(ti)) THEN
    :frame
  ELSE
    :heap
  END;
  RETURN cleanupClassifier__entry(:uniform, alloc);
END
PUB FN cleanupClassifier__classify_non_copy_union(ti: Type, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !?CleanupEntry@multiowned ->
  MUTABLE schema = (runtimeCallSpec__call(CAST(schema_lookup AS RuntimeCallSpec), type__resolved(ti)) OR_ELSE NIL);
  IF !(cleanupClassifier__schema_union?(schema)) THEN
    RETURN NIL;
  END
  MUTABLE is_copy = (TRY (type__implicitly_copyable?(ti, %(t) USE(schema_lookup) -> (runtimeCallSpec__call(CAST(schema_lookup AS RuntimeCallSpec), t) OR_ELSE NIL))) OR_ELSE TRUE);
  IF is_copy THEN
    RETURN NIL;
  END
  MUTABLE has_heap_variants = TRY (cleanupClassifier__union_variants_need_cleanup?(schema, schema_lookup));
  MUTABLE alloc = IF has_heap_variants THEN
    :heap
  ELSE
    ((type__provenance_alloc(ti) OR_ELSE :frame))
  END;
  MUTABLE e = cleanupClassifier__entry(:uniform, alloc);
  IF has_heap_variants THEN
    e[:fixed_alloc] = TRUE;
  END
  RETURN e;
END
PUB FN cleanupClassifier__elem_needs_cleanup?(ti: Type, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Bool ->
  MUTABLE et: ?Type = TRY (type__element_type(ti));
  IF et EXISTS AS et_value THEN
    RETURN TRY (cleanupClassifier__elem_type_needs_cleanup?(et_value, schema_lookup));
  ELSE
    RETURN FALSE;
  END
END
PUB FN cleanupClassifier__elem_type_needs_cleanup?(et: Type, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Bool ->
  IF type__borrowed_reference?(et) THEN
    RETURN FALSE;
  END
  IF TRY (type__string?(et)) THEN
    RETURN TRUE;
  END
  IF TRY (type__needs_cleanup?(et, schema_lookup)) THEN
    RETURN TRUE;
  END
  MUTABLE elem_schema = (runtimeCallSpec__call(CAST(schema_lookup AS RuntimeCallSpec), type__resolved(et)) OR_ELSE NIL);
  IF schemas__union?(elem_schema) THEN
    RETURN TRY (cleanupClassifier__union_variants_need_cleanup?(elem_schema, schema_lookup));
  END
  IF schemas__field_bearing?(elem_schema) THEN
    RETURN TRY (cleanupClassifier__elem_has_cleanup_fields?(elem_schema, schema_lookup));
  END
  RETURN FALSE;
END
PUB FN cleanupClassifier__union_variants_need_cleanup?(schema: ?UnionSchema, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Bool ->
  IF !(schemas__union?(ruby_wrap_optional_UnionSchema_SchemaValue(schema))) THEN
    RETURN FALSE;
  END
  MUTABLE concrete_schema = COPY schema?;
  RETURN (concrete_schema.variants) |> ANY TRY (cleanupClassifier__variant_type_needs_cleanup?(_._1, schema_lookup));
END
PUB FN cleanupClassifier__variant_type_needs_cleanup?(vt: ?SchemasUnionSchemaVariantValue, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Bool ->
  IF vt? IS_A InlineStructVariant AS inline_struct_variant THEN
    RETURN TRY (cleanupClassifier__elem_has_cleanup_fields?(inline_struct_variant, schema_lookup));
  END
  IF vt? IS_A Type AS type THEN
    RETURN TRY (cleanupClassifier__elem_type_needs_cleanup?(type, schema_lookup));
  ELSE
    RETURN FALSE;
  END
END
PUB FN cleanupClassifier__elem_has_string_fields?(schema: ?FieldBearingSchema) RETURNS !Bool ->
  RETURN TRY (cleanupClassifier__elem_has_cleanup_fields?(schema, NIL));
END
PUB FN cleanupClassifier__elem_has_cleanup_fields?(schema: ?FieldBearingSchema, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Bool ->
  IF !(((((schema != NIL) AND (schema IS_A InlineStructVariant)) OR ((schema != NIL) AND (schema IS_A StructSchema))) OR ((schema != NIL) AND (schema IS_A ResourceSchema)))) THEN
    RETURN FALSE;
  END
  MUTABLE concrete_schema: ?FieldBearingSchema = COPY schema;
  MUTABLE borrowed = TRY (cleanupClassifier__borrowed_field_names(concrete_schema));
  RETURN concrete_schema.fields() |> ANY (IF borrowed.contains?(CAST(_._0 AS String)) THEN FALSE ELSE (IF cleanupClassifier__cleanup_field_borrowed?(_._1) THEN FALSE ELSE { MUTABLE rtoc_value_block_marker = 0; MUTABLE t = TRY (cleanupClassifier__cleanup_field_type(_._1)); (((((((TRY (type__string?(t)) OR TRY (type__non_string_array?(t))) OR type__collection?(t)) OR t.indirect?()) OR TRY (type__any_rc?(t))) OR type__link?(t)) OR (((schema_lookup != NIL) AND TRY (type__recursive_cleanup_shape?(t, schema_lookup))))) OR (((schema_lookup != NIL) AND t.needs_cleanup?(schema_lookup)))) } END) END);
END
PUB FN cleanupClassifier__cleanup_field_borrowed?(field: Field) RETURNS Bool ->
  IF field IS_A StructField AS struct_field THEN
    RETURN (structField__borrowed(struct_field) == TRUE);
  ELSE
    RETURN FALSE;
  END
END
PUB FN cleanupClassifier__cleanup_field_type(field: Field) RETURNS !Type ->
  IF field IS_A StructField AS struct_field THEN
    RETURN structField__type(struct_field);
  ELSE
    RETURN TRY (type__new(castFieldToTypeConstructionInput(field)));
  END
END
PUB FN cleanupClassifier__borrowed_field_names(schema: FieldBearingSchema) RETURNS ![Set]String ->
  IF schema IS_A StructSchema AS struct_schema THEN
    RETURN TRY (structSchema__borrowed_fields(struct_schema));
  END
  MUTABLE empty: [Set]String = Set[];
  RETURN empty;
END
# End Ruby module CleanupClassifier
FN castAssignmentNameToLocatable(value: AssignmentName) RETURNS Locatable ->
  PARTIAL MATCH value START
    AssignmentName.Identifier AS cast_payload -> RETURN Locatable{ Identifier: COPY cast_payload };,
    AssignmentName.GetField AS cast_payload -> RETURN Locatable{ GetField: COPY cast_payload };,
    AssignmentName.GetIndex AS cast_payload -> RETURN Locatable{ GetIndex: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Locatable");
  END
  panic("Invalid cast to Locatable");
END
FN castBindingNodeToLocatable(value: BindingNode) RETURNS Locatable ->
  PARTIAL MATCH value START
    BindingNode.VarDecl AS cast_payload -> RETURN Locatable{ VarDecl: COPY cast_payload };,
    BindingNode.BindExpr AS cast_payload -> RETURN Locatable{ BindExpr: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Locatable");
  END
  panic("Invalid cast to Locatable");
END
FN castFieldToTypeConstructionInput(value: Field) RETURNS TypeConstructionInput ->
  PARTIAL MATCH value START
    Field.FunctionType AS cast_payload -> RETURN TypeConstructionInput{ FunctionType: COPY cast_payload };,
    Field.Type AS cast_payload -> RETURN TypeConstructionInput{ Type: COPY cast_payload };,
    Field.SymbolValue AS cast_payload -> RETURN TypeConstructionInput{ SymbolValue: COPY cast_payload };,
    Field.StringValue AS cast_payload -> RETURN TypeConstructionInput{ StringValue: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to TypeConstructionInput");
  END
  panic("Invalid cast to TypeConstructionInput");
END
FN castLocatableToOptionalLocatable(value: Locatable) RETURNS ?Locatable ->
  PARTIAL MATCH value START
    Locatable.RequireNode AS cast_payload -> RETURN Locatable{ RequireNode: COPY cast_payload };,
    Locatable.ProtocolRequirement AS cast_payload -> RETURN Locatable{ ProtocolRequirement: COPY cast_payload };,
    Locatable.ProtocolDef AS cast_payload -> RETURN Locatable{ ProtocolDef: COPY cast_payload };,
    Locatable.FunctionDef AS cast_payload -> RETURN Locatable{ FunctionDef: COPY cast_payload };,
    Locatable.ImplementationDef AS cast_payload -> RETURN Locatable{ ImplementationDef: COPY cast_payload };,
    Locatable.ConformanceDef AS cast_payload -> RETURN Locatable{ ConformanceDef: COPY cast_payload };,
    Locatable.VarDecl AS cast_payload -> RETURN Locatable{ VarDecl: COPY cast_payload };,
    Locatable.Assignment AS cast_payload -> RETURN Locatable{ Assignment: COPY cast_payload };,
    Locatable.DestructuringAssignment AS cast_payload -> RETURN Locatable{ DestructuringAssignment: COPY cast_payload };,
    Locatable.BindExpr AS cast_payload -> RETURN Locatable{ BindExpr: COPY cast_payload };,
    Locatable.BinaryOp AS cast_payload -> RETURN Locatable{ BinaryOp: COPY cast_payload };,
    Locatable.IsA AS cast_payload -> RETURN Locatable{ IsA: COPY cast_payload };,
    Locatable.CallSiteOverride AS cast_payload -> RETURN Locatable{ CallSiteOverride: COPY cast_payload };,
    Locatable.Identifier AS cast_payload -> RETURN Locatable{ Identifier: COPY cast_payload };,
    Locatable.Literal AS cast_payload -> RETURN Locatable{ Literal: COPY cast_payload };,
    Locatable.ListLit AS cast_payload -> RETURN Locatable{ ListLit: COPY cast_payload };,
    Locatable.TupleLit AS cast_payload -> RETURN Locatable{ TupleLit: COPY cast_payload };,
    Locatable.DefaultArrayLit AS cast_payload -> RETURN Locatable{ DefaultArrayLit: COPY cast_payload };,
    Locatable.HashLit AS cast_payload -> RETURN Locatable{ HashLit: COPY cast_payload };,
    Locatable.DefaultLit AS cast_payload -> RETURN Locatable{ DefaultLit: COPY cast_payload };,
    Locatable.StructLit AS cast_payload -> RETURN Locatable{ StructLit: COPY cast_payload };,
    Locatable.LambdaLit AS cast_payload -> RETURN Locatable{ LambdaLit: COPY cast_payload };,
    Locatable.IfStatement AS cast_payload -> RETURN Locatable{ IfStatement: COPY cast_payload };,
    Locatable.IfBind AS cast_payload -> RETURN Locatable{ IfBind: COPY cast_payload };,
    Locatable.WhileLoop AS cast_payload -> RETURN Locatable{ WhileLoop: COPY cast_payload };,
    Locatable.WhileBindLoop AS cast_payload -> RETURN Locatable{ WhileBindLoop: COPY cast_payload };,
    Locatable.BreakNode AS cast_payload -> RETURN Locatable{ BreakNode: COPY cast_payload };,
    Locatable.ContinueNode AS cast_payload -> RETURN Locatable{ ContinueNode: COPY cast_payload };,
    Locatable.FuncCall AS cast_payload -> RETURN Locatable{ FuncCall: COPY cast_payload };,
    Locatable.GetField AS cast_payload -> RETURN Locatable{ GetField: COPY cast_payload };,
    Locatable.GetIndex AS cast_payload -> RETURN Locatable{ GetIndex: COPY cast_payload };,
    Locatable.ReturnNode AS cast_payload -> RETURN Locatable{ ReturnNode: COPY cast_payload };,
    Locatable.Assert AS cast_payload -> RETURN Locatable{ Assert: COPY cast_payload };,
    Locatable.Raise AS cast_payload -> RETURN Locatable{ Raise: COPY cast_payload };,
    Locatable.ThrowNode AS cast_payload -> RETURN Locatable{ ThrowNode: COPY cast_payload };,
    Locatable.DieNode AS cast_payload -> RETURN Locatable{ DieNode: COPY cast_payload };,
    Locatable.Slice AS cast_payload -> RETURN Locatable{ Slice: COPY cast_payload };,
    Locatable.Require AS cast_payload -> RETURN Locatable{ Require: COPY cast_payload };,
    Locatable.WithBlock AS cast_payload -> RETURN Locatable{ WithBlock: COPY cast_payload };,
    Locatable.SyncPolicyDecl AS cast_payload -> RETURN Locatable{ SyncPolicyDecl: COPY cast_payload };,
    Locatable.SelectOp AS cast_payload -> RETURN Locatable{ SelectOp: COPY cast_payload };,
    Locatable.WhereOp AS cast_payload -> RETURN Locatable{ WhereOp: COPY cast_payload };,
    Locatable.IndexOp AS cast_payload -> RETURN Locatable{ IndexOp: COPY cast_payload };,
    Locatable.ReduceOp AS cast_payload -> RETURN Locatable{ ReduceOp: COPY cast_payload };,
    Locatable.OrderByOp AS cast_payload -> RETURN Locatable{ OrderByOp: COPY cast_payload };,
    Locatable.LimitOp AS cast_payload -> RETURN Locatable{ LimitOp: COPY cast_payload };,
    Locatable.UnnestOp AS cast_payload -> RETURN Locatable{ UnnestOp: COPY cast_payload };,
    Locatable.DistinctOp AS cast_payload -> RETURN Locatable{ DistinctOp: COPY cast_payload };,
    Locatable.EachOp AS cast_payload -> RETURN Locatable{ EachOp: COPY cast_payload };,
    Locatable.TapOp AS cast_payload -> RETURN Locatable{ TapOp: COPY cast_payload };,
    Locatable.SkipOp AS cast_payload -> RETURN Locatable{ SkipOp: COPY cast_payload };,
    Locatable.CollectOp AS cast_payload -> RETURN Locatable{ CollectOp: COPY cast_payload };,
    Locatable.TakeWhileOp AS cast_payload -> RETURN Locatable{ TakeWhileOp: COPY cast_payload };,
    Locatable.WindowOp AS cast_payload -> RETURN Locatable{ WindowOp: COPY cast_payload };,
    Locatable.BatchWindowOp AS cast_payload -> RETURN Locatable{ BatchWindowOp: COPY cast_payload };,
    Locatable.JoinOp AS cast_payload -> RETURN Locatable{ JoinOp: COPY cast_payload };,
    Locatable.FindOp AS cast_payload -> RETURN Locatable{ FindOp: COPY cast_payload };,
    Locatable.AnyOp AS cast_payload -> RETURN Locatable{ AnyOp: COPY cast_payload };,
    Locatable.AllOp AS cast_payload -> RETURN Locatable{ AllOp: COPY cast_payload };,
    Locatable.CountOp AS cast_payload -> RETURN Locatable{ CountOp: COPY cast_payload };,
    Locatable.SumOp AS cast_payload -> RETURN Locatable{ SumOp: COPY cast_payload };,
    Locatable.AverageOp AS cast_payload -> RETURN Locatable{ AverageOp: COPY cast_payload };,
