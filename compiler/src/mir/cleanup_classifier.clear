FN castVariantNameToUnionLookup(value: VariantName) RETURNS UnionLookup ->
  PARTIAL MATCH value START
    VariantName.StringValue AS cast_payload -> RETURN UnionLookup{ StringValue: COPY cast_payload };,
    VariantName.SymbolValue AS cast_payload -> RETURN UnionLookup{ SymbolValue: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to UnionLookup");
  END
  panic("Invalid cast to UnionLookup");
