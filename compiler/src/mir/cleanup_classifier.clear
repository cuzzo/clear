FN rubyToClearVoid() RETURNS Void ->
  RETURN;
END
FN ruby_wrap_optional_UnionSchema_SchemaValue(value: ?UnionSchema) RETURNS ?SchemaValue ->
  IF value EXISTS AS optional_payload THEN
    RETURN SchemaValue{ UnionSchemaMultiowned: COPY optional_payload };
  END
  NIL;
END
