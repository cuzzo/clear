FN castNameToPath(value: Name) RETURNS Path ->
  PARTIAL MATCH value START
    Name.StringValue AS cast_payload -> RETURN Path{ StringValue: COPY cast_payload };,
    Name.SymbolValue AS cast_payload -> RETURN Path{ SymbolValue: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Path");
  END
  panic("Invalid cast to Path");
END
FN castNamesItemToPath(value: NamesItem) RETURNS Path ->
  PARTIAL MATCH value START
    NamesItem.StringValue AS cast_payload -> RETURN Path{ StringValue: COPY cast_payload };,
    NamesItem.SymbolValue AS cast_payload -> RETURN Path{ SymbolValue: COPY cast_payload };,
    NamesItem.PlaceId AS cast_payload -> RETURN Path{ PlaceId: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Path");
  END
  panic("Invalid cast to Path");
END
