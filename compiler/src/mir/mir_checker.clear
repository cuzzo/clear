PUB UNION MIRCheckerCleanup { Cleanup: Cleanup, ErrCleanup: ErrCleanup }
PUB STRUCT MIRChecker {
  captured_names: ?[Set]String,
  errors: []String,
  fn_name: ?String,
  schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult
}

PUB UNION MIRCheckerAggregateExpr { Emittable: Emittable, StringValue: String, SymbolValue: String@symbol, Int64Value: Int64, Float64Value: Float64, BoolValue: Bool }
# Ruby keeps this as an array of class objects and asks `include?(stmt.class)`.
# CLEAR has no runtime classes: Emittable is a union, so the same question is
# a variant check, and the compiler verifies the arms are exhaustive.
#
# rtoc prefixes a variant whose bare name would collide (BgBlock -> MIRBgBlock),
# so the Ruby class names are mapped onto the variants the union actually has.
PUB FN mIRChecker__linear_statement_node?(stmt: Emittable) RETURNS Bool ->
  PARTIAL MATCH stmt START
    Emittable.AllocMark -> RETURN TRUE;,
    Emittable.AssertRaisesCheck -> RETURN TRUE;,
    Emittable.AssertStmt -> RETURN TRUE;,
    Emittable.BatchWindowFlush -> RETURN TRUE;,
    Emittable.BatchWindowPush -> RETURN TRUE;,
    Emittable.MIRBgBlock -> RETURN TRUE;,
    Emittable.BreakStmt -> RETURN TRUE;,
    Emittable.CatchWrapper -> RETURN TRUE;,
    Emittable.Cleanup -> RETURN TRUE;,
    Emittable.Comment -> RETURN TRUE;,
    Emittable.ContinueStmt -> RETURN TRUE;,
    Emittable.MIRDeferStmt -> RETURN TRUE;,
    Emittable.DestructureSet -> RETURN TRUE;,
    Emittable.DiscardOwned -> RETURN TRUE;,
    Emittable.DebugOnly -> RETURN TRUE;,
    Emittable.MIRDoBlock -> RETURN TRUE;,
    Emittable.MIREnumDef -> RETURN TRUE;,
    Emittable.ErrCleanup -> RETURN TRUE;,
    Emittable.ErrDeferStmt -> RETURN TRUE;,
    Emittable.ExprStmt -> RETURN TRUE;,
    Emittable.FallibleLockBinding -> RETURN TRUE;,
    Emittable.FieldCleanupMark -> RETURN TRUE;,
    Emittable.FnDef -> RETURN TRUE;,
    Emittable.ForStmt -> RETURN TRUE;,
    Emittable.FrameRestore -> RETURN TRUE;,
    Emittable.FrameSave -> RETURN TRUE;,
    Emittable.FsmB1Body -> RETURN TRUE;,
    Emittable.FsmGenericBody -> RETURN TRUE;,
    Emittable.FsmIoBody -> RETURN TRUE;,
    Emittable.IfBindStmt -> RETURN TRUE;,
    Emittable.IfChain -> RETURN TRUE;,
    Emittable.IfStmt -> RETURN TRUE;,
    Emittable.Import -> RETURN TRUE;,
    Emittable.CExternFnDecl -> RETURN TRUE;,
    Emittable.CExternStructDef -> RETURN TRUE;,
    Emittable.IndexInsert -> RETURN TRUE;,
    Emittable.Let -> RETURN TRUE;,
    Emittable.ModuleNamespace -> RETURN TRUE;,
    Emittable.MoveMark -> RETURN TRUE;,
    Emittable.MutualThunkTrampoline -> RETURN TRUE;,
    Emittable.Noop -> RETURN TRUE;,
    Emittable.OwnedBorrow -> RETURN TRUE;,
    Emittable.OwnedCreate -> RETURN TRUE;,
    Emittable.OwnedDestroy -> RETURN TRUE;,
    Emittable.OwnedReturn -> RETURN TRUE;,
    Emittable.OwnedStore -> RETURN TRUE;,
    Emittable.OwnedTransfer -> RETURN TRUE;,
    Emittable.Panic -> RETURN TRUE;,
    Emittable.Pipeline -> RETURN TRUE;,
    Emittable.PolymorphicFlowSignal -> RETURN TRUE;,
    Emittable.PolymorphicMutate -> RETURN TRUE;,
    Emittable.PolymorphicMutateFlow -> RETURN TRUE;,
    Emittable.PubConst -> RETURN TRUE;,
    Emittable.ModuleVar -> RETURN TRUE;,
    Emittable.ModuleConstFree -> RETURN TRUE;,
    Emittable.ReassignMark -> RETURN TRUE;,
    Emittable.ReassignWithCleanup -> RETURN TRUE;,
    Emittable.ResourceClose -> RETURN TRUE;,
    Emittable.ReturnMark -> RETURN TRUE;,
    Emittable.ReturnStmt -> RETURN TRUE;,
    Emittable.ScopeBlock -> RETURN TRUE;,
    Emittable.Set -> RETURN TRUE;,
    Emittable.ShardConcurrentEach -> RETURN TRUE;,
    Emittable.ShardedMapPut -> RETURN TRUE;,
    Emittable.SnapshotMultiTxn -> RETURN TRUE;,
    Emittable.SnapshotRead -> RETURN TRUE;,
    Emittable.SnapshotTransaction -> RETURN TRUE;,
    Emittable.Sort -> RETURN TRUE;,
    Emittable.SortedLockAcquire -> RETURN TRUE;,
    Emittable.StreamSpawn -> RETURN TRUE;,
    Emittable.StreamYield -> RETURN TRUE;,
    Emittable.MIRStructDef -> RETURN TRUE;,
    Emittable.Suppress -> RETURN TRUE;,
    Emittable.SwitchStmt -> RETURN TRUE;,
    Emittable.TestDef -> RETURN TRUE;,
    Emittable.TestPreamble -> RETURN TRUE;,
    Emittable.ThunkTrampoline -> RETURN TRUE;,
    Emittable.TransferMark -> RETURN TRUE;,
    Emittable.TypeAlias -> RETURN TRUE;,
    Emittable.UnionMatchStmt -> RETURN TRUE;,
    Emittable.UnionTypeDef -> RETURN TRUE;,
    Emittable.WhileStmt -> RETURN TRUE;,
    Emittable.WithMatchDispatch -> RETURN TRUE;,
    DEFAULT -> RETURN FALSE;
  END
  RETURN FALSE;
END
PUB STRUCT LinearOwnershipState {
  alloc_kinds: {String}String@symbol,
  alloc_scopes: {String}String@symbol,
  cleanup_finalizers: [Set]String,
  err_finalizers: [Set]String,
  guarded_finalizers: [Set]String,
  maybe_released: [Set]String,
  move_marks: [Set]String,
  owned: [Set]String,
  pending_block_transfers: [Set]String,
  pending_return_transfers: [Set]String,
  released: [Set]String,
  terminated: Bool
}

PUB FN linearOwnershipState__initialize(MUTABLE self: LinearOwnershipState) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.owned = Set[];
    rtoc_self_view.released = Set[];
    rtoc_self_view.maybe_released = Set[];
    rtoc_self_view.cleanup_finalizers = Set[];
    rtoc_self_view.guarded_finalizers = Set[];
    rtoc_self_view.err_finalizers = Set[];
    rtoc_self_view.pending_return_transfers = Set[];
    rtoc_self_view.pending_block_transfers = Set[];
    rtoc_self_view.alloc_kinds = {};
    rtoc_self_view.alloc_scopes = {};
    rtoc_self_view.move_marks = Set[];
    rtoc_self_view.terminated = FALSE;
}
END
PUB FN linearOwnershipState__copy(self: LinearOwnershipState) RETURNS LinearOwnershipState@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE other = linearOwnershipState__new();
    &other.owned.merge(rtoc_self_view.owned);
    &other.released.merge(rtoc_self_view.released);
    &other.maybe_released.merge(rtoc_self_view.maybe_released);
    &other.cleanup_finalizers.merge(rtoc_self_view.cleanup_finalizers);
    &other.guarded_finalizers.merge(rtoc_self_view.guarded_finalizers);
    &other.err_finalizers.merge(rtoc_self_view.err_finalizers);
    &other.pending_return_transfers.merge(rtoc_self_view.pending_return_transfers);
    &other.pending_block_transfers.merge(rtoc_self_view.pending_block_transfers);
    &other.alloc_kinds.merge_mut(rtoc_self_view.alloc_kinds);
    &other.alloc_scopes.merge_mut(rtoc_self_view.alloc_scopes);
    &other.move_marks.merge(rtoc_self_view.move_marks);
    other.terminated = rtoc_self_view.terminated;
    RETURN other;
}
END
PUB FN linearOwnershipState__same_state?(self: LinearOwnershipState, other: LinearOwnershipState) RETURNS !Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_1 = TRY (linearOwnershipState__snapshot(rtoc_self_view));
    linearOwnershipSnapshot__same_state?(rtoc_local_receiver_1, TRY (linearOwnershipState__snapshot(other))) };
}
END
PUB FN linearOwnershipState__summary(self: LinearOwnershipState) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_2 = TRY (linearOwnershipState__snapshot(rtoc_self_view));
    linearOwnershipSnapshot__summary(rtoc_local_receiver_2) };
}
END
PUB FN linearOwnershipState__snapshot(self: LinearOwnershipState) RETURNS !LinearOwnershipSnapshot@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (linearOwnershipSnapshot__from_state(rtoc_self_view));
}
END
PUB FN linearOwnershipState__new() RETURNS LinearOwnershipState@multiowned ->
  MUTABLE self = LinearOwnershipState{ alloc_kinds: {}, alloc_scopes: {}, cleanup_finalizers: Set[], err_finalizers: Set[], guarded_finalizers: Set[], maybe_released: Set[], move_marks: Set[], owned: Set[], pending_block_transfers: Set[], pending_return_transfers: Set[], released: Set[], terminated: FALSE };
  linearOwnershipState__initialize(&self);
  RETURN self @multiowned;
END
PUB STRUCT LinearOwnershipSnapshot {
  alloc_kinds: {PlaceId}String@symbol,
  cleanup_finalizers: [Set]PlaceId,
  err_finalizers: [Set]PlaceId,
  guarded_finalizers: [Set]PlaceId,
  maybe_released: [Set]PlaceId,
  owned: [Set]PlaceId,
  pending_block_transfers: [Set]PlaceId,
  pending_return_transfers: [Set]PlaceId,
  released: [Set]PlaceId
}

PUB FN linearOwnershipSnapshot__initialize(MUTABLE self: LinearOwnershipSnapshot, owned: [Set]PlaceId, released: [Set]PlaceId, maybe_released: [Set]PlaceId, cleanup_finalizers: [Set]PlaceId, guarded_finalizers: [Set]PlaceId, err_finalizers: [Set]PlaceId, pending_return_transfers: [Set]PlaceId, pending_block_transfers: [Set]PlaceId, alloc_kinds: {PlaceId}String@symbol) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.owned = owned;
    rtoc_self_view.released = released;
    rtoc_self_view.maybe_released = maybe_released;
    rtoc_self_view.cleanup_finalizers = cleanup_finalizers;
    rtoc_self_view.guarded_finalizers = guarded_finalizers;
    rtoc_self_view.err_finalizers = err_finalizers;
    rtoc_self_view.pending_return_transfers = pending_return_transfers;
    rtoc_self_view.pending_block_transfers = pending_block_transfers;
    rtoc_self_view.alloc_kinds = alloc_kinds;
}
END
PUB FN linearOwnershipSnapshot__from_state(state: LinearOwnershipState) RETURNS !LinearOwnershipSnapshot@multiowned ->
  RETURN linearOwnershipSnapshot__new(TRY (linearOwnershipSnapshot__place_set(state.owned)), TRY (linearOwnershipSnapshot__place_set(state.released)), TRY (linearOwnershipSnapshot__place_set(state.maybe_released)), TRY (linearOwnershipSnapshot__place_set(state.cleanup_finalizers)), TRY (linearOwnershipSnapshot__place_set(state.guarded_finalizers)), TRY (linearOwnershipSnapshot__place_set(state.err_finalizers)), TRY (linearOwnershipSnapshot__place_set(state.pending_return_transfers)), TRY (linearOwnershipSnapshot__place_set(state.pending_block_transfers)), TRY (linearOwnershipSnapshot__place_hash(state.alloc_kinds)));
END
PUB FN linearOwnershipSnapshot__owned(self: LinearOwnershipSnapshot) RETURNS ![Set]PlaceId
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY rtoc_self_view.owned;
}
END
PUB FN linearOwnershipSnapshot__alloc_kinds(self: LinearOwnershipSnapshot) RETURNS !{PlaceId}String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY rtoc_self_view.alloc_kinds;
}
END
PUB FN linearOwnershipSnapshot__same_state?(self: LinearOwnershipSnapshot, other: LinearOwnershipSnapshot) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (((((((((rtoc_self_view.owned == other.owned) AND (rtoc_self_view.released == other.released)) AND (rtoc_self_view.maybe_released == other.maybe_released)) AND (rtoc_self_view.cleanup_finalizers == other.cleanup_finalizers)) AND (rtoc_self_view.guarded_finalizers == other.guarded_finalizers)) AND (rtoc_self_view.err_finalizers == other.err_finalizers)) AND (rtoc_self_view.pending_return_transfers == other.pending_return_transfers)) AND (rtoc_self_view.pending_block_transfers == other.pending_block_transfers)) AND (rtoc_self_view.alloc_kinds == other.alloc_kinds));
}
END
PUB FN linearOwnershipSnapshot__summary(self: LinearOwnershipSnapshot) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (["owned=${linearOwnershipSnapshot__format_places(rtoc_self_view, rtoc_self_view.owned)}", "released=${linearOwnershipSnapshot__format_places(rtoc_self_view, rtoc_self_view.released)}", "maybe=${linearOwnershipSnapshot__format_places(rtoc_self_view, rtoc_self_view.maybe_released)}", "cleanup=${linearOwnershipSnapshot__format_places(rtoc_self_view, rtoc_self_view.cleanup_finalizers)}", "guarded=${linearOwnershipSnapshot__format_places(rtoc_self_view, rtoc_self_view.guarded_finalizers)}", "err=${linearOwnershipSnapshot__format_places(rtoc_self_view, rtoc_self_view.err_finalizers)}", "return=${linearOwnershipSnapshot__format_places(rtoc_self_view, rtoc_self_view.pending_return_transfers)}", "block=${linearOwnershipSnapshot__format_places(rtoc_self_view, rtoc_self_view.pending_block_transfers)}", "alloc=${((rtoc_self_view.alloc_kinds.keys() |> SELECT "${_.path}:${COPY UNWRAP (rtoc_self_view.alloc_kinds[_])}") |> ORDER_BY _).join(",")}"]).join(" ");
}
END
PRIVATE FN linearOwnershipSnapshot__place_set(names: [Set]String) RETURNS ![Set]PlaceId ->
  MUTABLE out: [Set]PlaceId = Set[];
  FOR _ IN names DO
  &out.insert(placeId__from_path(Path{ StringValue: COPY _ }));
  END
  RETURN out;
END
PRIVATE FN linearOwnershipSnapshot__place_hash(allocs: {String}String@symbol) RETURNS !{PlaceId}String@symbol ->
  MUTABLE out: {PlaceId}String@symbol = {};
  FOR rtoc_key IN allocs.keys() DO
  MUTABLE alloc: String@symbol = COPY UNWRAP (allocs[rtoc_key]);
  out[placeId__from_path(Path{ StringValue: COPY rtoc_key })] = COPY alloc;
  END
  RETURN out;
END
PRIVATE FN linearOwnershipSnapshot__format_places(self: LinearOwnershipSnapshot, places: [Set]PlaceId) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ((places |> SELECT _.path) |> ORDER_BY _).join(",");
}
END
PUB FN linearOwnershipSnapshot__new(owned: [Set]PlaceId, released: [Set]PlaceId, maybe_released: [Set]PlaceId, cleanup_finalizers: [Set]PlaceId, guarded_finalizers: [Set]PlaceId, err_finalizers: [Set]PlaceId, pending_return_transfers: [Set]PlaceId, pending_block_transfers: [Set]PlaceId, alloc_kinds: {PlaceId}String@symbol) RETURNS LinearOwnershipSnapshot@multiowned ->
  MUTABLE self = LinearOwnershipSnapshot{ alloc_kinds: {}, cleanup_finalizers: Set[], err_finalizers: Set[], guarded_finalizers: Set[], maybe_released: Set[], owned: Set[], pending_block_transfers: Set[], pending_return_transfers: Set[], released: Set[] };
  linearOwnershipSnapshot__initialize(&self, owned, released, maybe_released, cleanup_finalizers, guarded_finalizers, err_finalizers, pending_return_transfers, pending_block_transfers, alloc_kinds);
  RETURN self @multiowned;
END
PUB UNION MIRCheckerCleanupMarksByNameValueItem { Cleanup: Cleanup, ErrCleanup: ErrCleanup }
PUB UNION MIRCheckerAllocatorMetadataCarrier { RegistryCall: RegistryCall, IndexedStore: IndexedStore, ShardedMapPut: ShardedMapPut, ShardedMapGet: ShardedMapGet }
PUB UNION MIRCheckerAllocatorMetadataSource { Emittable: Emittable, CallableContractMultiowned: CallableContract@multiowned }
PUB UNION MIRCheckerRegistryOwnershipNode { RegistryCall: RegistryCall, IndexedStore: IndexedStore }
PUB UNION MIRCheckerOwnershipSurfaceNode { RegistryCall: RegistryCall, IndexedStore: IndexedStore, ShardedMapPut: ShardedMapPut, ReassignWithCleanup: ReassignWithCleanup }
PUB STRUCT InlineStoredAllocCheck {
  label: String@symbol,
  alloc: ?String@symbol
}
valid_fsm_destroy_sources: [4]String@symbol = [:capture, :fresh_heap, :body, :owned_result];
valid_fsm_unlock_methods: [2]String = ["unlock", "unlockShared"];
valid_allocators: [2]String@symbol = [:heap, :frame];
valid_alloc_scopes: [3]String@symbol = [:heap, :function, :iteration];
PUB FN mIRChecker__initialize(MUTABLE self: MIRChecker, fn_name: ?String = NIL, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.fn_name = COPY fn_name;
    rtoc_self_view.schema_lookup = COPY schema_lookup;
    rtoc_self_view.errors = List[];
}
END
PUB FN mIRChecker__check_fn_mut(MUTABLE self: MIRChecker, fn_def: FnDef, strict: Bool = FALSE, captured_names: []String) RETURNS ![]String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.fn_name = fn_def.name;
    rtoc_self_view.captured_names = (captured_names |> SELECT _.toString()) |> DISTINCT _;
    rtoc_self_view.errors = List[];
    MUTABLE nodes: []Emittable = TRY (mIR__nodes(NodeRoot{ ArrayValue: COPY fn_def.body }));
    MUTABLE allocs: {String}[]AllocMark = {};
    MUTABLE cleanups: {String}[]MIRCheckerCleanupMarksByNameValueItem = {};
    MUTABLE err_cleanups: {String}[]MIRCheckerCleanupMarksByNameValueItem = {};
    MUTABLE transfers: [Set]String = Set[];
    MUTABLE return_transfers: [Set]String = Set[];
    MUTABLE errdefer_destroy_names: [Set]String = Set[];
    MUTABLE hpt_leaks: []String = ( { MUTABLE rtoc_empty_list_3: []String = List[]; rtoc_empty_list_3 } );
    MUTABLE owned_return_lets: []Let = ( { MUTABLE rtoc_empty_list_4: []Let = List[]; rtoc_empty_list_4 } );
    MUTABLE owned_result_lets: []Let = ( { MUTABLE rtoc_empty_list_5: []Let = List[]; rtoc_empty_list_5 } );
    MUTABLE allocator_metadata_nodes: []Emittable = ( { MUTABLE rtoc_empty_list_6: []Emittable = List[]; rtoc_empty_list_6 } );
    MUTABLE allocator_metadata_node_ids: {Int64}Bool = {};
    MUTABLE structural_ownership_nodes: []Emittable = ( { MUTABLE rtoc_empty_list_7: []Emittable = List[]; rtoc_empty_list_7 } );
    MUTABLE ownership_fact_nodes: []Emittable = ( { MUTABLE rtoc_empty_list_8: []Emittable = List[]; rtoc_empty_list_8 } );
    FOR _ IN nodes DO
    IF emittable__ownership_consumption(_) EXISTS THEN
        &structural_ownership_nodes.append(COPY _);
    END
    MUTABLE rtoc_node_id: ?LoweredNodeId = emittable__lowered_node_id(_);
    MUTABLE rtoc_seen_id: Bool = FALSE;
    IF rtoc_node_id EXISTS AS rtoc_id_value THEN
      rtoc_seen_id = allocator_metadata_node_ids.contains?(rtoc_id_value.value);
    END
    IF (mIRChecker__allocator_metadata_node?(rtoc_self_view, _) AND !(rtoc_seen_id)) THEN
        &allocator_metadata_nodes.append(COPY _);
        IF rtoc_node_id EXISTS AS rtoc_id_store THEN
          allocator_metadata_node_ids[rtoc_id_store.value] = TRUE;
        END
    END
    IF _ IS_A OwnedCreate AS owned_create THEN
        &ownership_fact_nodes.append(Emittable{ OwnedCreate: COPY owned_create });
    ELSE_IF _ IS_A OwnedDestroy AS owned_destroy THEN
        &ownership_fact_nodes.append(Emittable{ OwnedDestroy: COPY owned_destroy });
    ELSE_IF _ IS_A OwnedTransfer AS owned_transfer THEN
        &ownership_fact_nodes.append(Emittable{ OwnedTransfer: COPY owned_transfer });
        &transfers.insert(COPY CAST(owned_transfer.name AS String));
        IF (owned_transfer.target == :return) THEN
          &return_transfers.insert(COPY CAST(owned_transfer.name AS String));
        END
    ELSE_IF _ IS_A OwnedBorrow AS owned_borrow THEN
        &ownership_fact_nodes.append(Emittable{ OwnedBorrow: COPY owned_borrow });
    ELSE_IF _ IS_A OwnedStore AS owned_store THEN
        &ownership_fact_nodes.append(Emittable{ OwnedStore: COPY owned_store });
    ELSE_IF _ IS_A OwnedReturn AS owned_return THEN
        &ownership_fact_nodes.append(Emittable{ OwnedReturn: COPY owned_return });
    ELSE_IF _ IS_A AllocMark AS alloc_mark THEN
        IF allocs[alloc_mark.name] == NIL THEN
          allocs[alloc_mark.name] = List[];
        END
        (allocs[alloc_mark.name])?.append(alloc_mark);
    ELSE_IF _ IS_A Cleanup AS cleanup THEN
        IF cleanups[cleanup.name] == NIL THEN
          cleanups[cleanup.name] = List[];
        END
        (cleanups[cleanup.name])?.append(cleanup);
    ELSE_IF _ IS_A ErrCleanup AS err_cleanup THEN
        IF cleanups[err_cleanup.name] == NIL THEN
          cleanups[err_cleanup.name] = List[];
        END
        (cleanups[err_cleanup.name])?.append(err_cleanup);
        IF err_cleanups[err_cleanup.name] == NIL THEN
          err_cleanups[err_cleanup.name] = List[];
        END
        (err_cleanups[err_cleanup.name])?.append(err_cleanup);
    ELSE_IF _ IS_A TransferMark AS transfer_mark THEN
        MUTABLE name = COPY transfer_mark.name;
        &transfers.insert(name);
        IF (transfer_mark.target == :return) THEN
          &return_transfers.insert(name);
        END
    ELSE_IF _ IS_A ErrDeferStmt AS err_defer_stmt THEN
        MUTABLE body = COPY errDeferStmt__body(err_defer_stmt);
        MUTABLE ptr: ?Emittable = NIL;
        IF body IS_A Emittable AS body_node THEN
          IF body_node IS_A DestroyPtr AS destroy_ptr THEN
            ptr = COPY destroy_ptr.ptr;
          END
        END
        IF ptr EXISTS AS ptr_value THEN
          IF ptr_value IS_A Ident AS ptr_ident THEN
            &errdefer_destroy_names.insert(COPY CAST(ptr_ident.name AS String));
          END
        END
    ELSE_IF _ IS_A Let AS let THEN
        IF TRY (mIRChecker__owned_return_init?(rtoc_self_view, let.init)) THEN
          &owned_return_lets.append(COPY let);
        END
        IF ((TRY (mIRChecker__expr_owned_result_alloc(rtoc_self_view, let.init)) != NIL) AND !((let.self_managed_alloc OR_ELSE FALSE))) THEN
          &owned_result_lets.append(COPY let);
        END
    ELSE_IF _ IS_A ExprStmt AS expr_stmt THEN
        MUTABLE expr_stmt_mutable = COPY expr_stmt;
        TRY (mIRChecker__scan_expr_for_hpt_leak_mut(rtoc_self_view, exprStmt__expr(expr_stmt_mutable), &hpt_leaks));
    ELSE_IF _ IS_A LambdaExpr AS lambda_expr THEN
        MUTABLE lambda_expr_mutable = COPY lambda_expr;
        IF lambda_expr_mutable.fn_def THEN
          MUTABLE sub = mIRChecker__new(NIL, rtoc_self_view.schema_lookup);
          rtoc_self_view.errors = ruby_array_concat_String(rtoc_self_view.errors, TRY (mIRChecker__check_fn_mut(&sub, lambda_expr_mutable.fn_def, strict, (lambda_expr_mutable.captures) |> SELECT _.toString())));
        END
    END
    END
    FOR _ IN hpt_leaks DO
    &rtoc_self_view.errors.append(COPY _);
    END
    TRY (mIRChecker__verify_allocator_closed_set_mut(&rtoc_self_view, allocs, cleanups, allocator_metadata_nodes));
    TRY (mIRChecker__verify_alloc_marks_typed_mut(&rtoc_self_view, allocs));
    TRY (mIRChecker__verify_owned_return_alloc_marks_mut(&rtoc_self_view, owned_return_lets, allocs));
    TRY (mIRChecker__verify_owned_result_alloc_marks_mut(&rtoc_self_view, owned_result_lets, allocs));
    TRY (mIRChecker__verify_allocator_metadata_contracts_mut(&rtoc_self_view, allocator_metadata_nodes, allocs, fn_def));
    TRY (mIRChecker__verify_cross_frame_param_alloc_mut(&rtoc_self_view, allocator_metadata_nodes, fn_def));
    TRY (mIRChecker__verify_err_cleanup_transfers_mut(&rtoc_self_view, err_cleanups, transfers));
    TRY (mIRChecker__verify_return_transfers_heap_mut(&rtoc_self_view, return_transfers, allocs));
    TRY (mIRChecker__verify_cleanup_sources_own_values_mut(&rtoc_self_view, fn_def.body, cleanups, err_cleanups));
    TRY (mIRChecker__verify_if_bind_capture_cleanup_ownership_mut(&rtoc_self_view, nodes));
    TRY (mIRChecker__verify_no_structural_rc_handle_copies_mut(&rtoc_self_view, nodes));
    TRY (mIRChecker__verify_allocating_lets_marked_mut(&rtoc_self_view, nodes, allocs));
    TRY (mIRChecker__verify_aggregate_owned_children_mut(&rtoc_self_view, fn_def.body, allocs));
    TRY (mIRChecker__verify_alloc_cleanup_match_mut(&rtoc_self_view, allocs, cleanups, errdefer_destroy_names, transfers));
    TRY (mIRChecker__verify_cleanup_required_finalizers_mut(&rtoc_self_view, allocs, cleanups, errdefer_destroy_names, transfers));
    TRY (mIRChecker__verify_ownership_consumption_operands_mut(&rtoc_self_view, structural_ownership_nodes));
    TRY (mIRChecker__verify_call_contracts_mut(&rtoc_self_view, nodes, transfers, allocs));
    TRY (mIRChecker__verify_structural_ownership_contracts_mut(&rtoc_self_view, structural_ownership_nodes, transfers, allocs));
    TRY (mIRChecker__verify_explicit_ownership_contracts_mut(&rtoc_self_view, nodes, transfers, allocs));
    TRY (mIRChecker__verify_ownership_surfaces_finalized_mut(&rtoc_self_view, nodes, ownership_fact_nodes));
    TRY (mIRChecker__verify_execution_boundary_facts_mut(&rtoc_self_view, nodes));
    TRY (mIRChecker__verify_frame_rewind_mut(&rtoc_self_view, fn_def.body));
    TRY (mIRChecker__verify_allocator_metadata_targets_mut(&rtoc_self_view, allocator_metadata_nodes));
    TRY (mIRChecker__verify_unhoisted_allocs_mut(&rtoc_self_view, fn_def.body));
    TRY (mIRChecker__verify_heap_create_single_indirection_mut(&rtoc_self_view, nodes));
    TRY (mIRChecker__verify_move_mark_scope_mut(&rtoc_self_view, fn_def.body));
    TRY (mIRChecker__verify_linear_ownership_mut(&rtoc_self_view, fn_def.body));
    RETURN COPY rtoc_self_view.errors;
}
END
PUB FN mIRChecker__verify_return_transfers_heap_mut(MUTABLE self: MIRChecker, return_transfers: [Set]String, allocs: {String}[]AllocMark) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < return_transfers.length() DO
      MUTABLE marks: ?[]AllocMark = COPY allocs[UNWRAP (return_transfers[rtoc_idx])];
      IF !(((marks != NIL) AND !(marks.empty?()))) THEN
          &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :RETURN_TRANSFER_WITHOUT_ALLOC, Name{ StringValue: COPY UNWRAP (return_transfers[rtoc_idx]) }, "return ownership transfer has no MIR::AllocMark")));
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF (UNWRAP (marks)) |> ALL placement__heap?(_.alloc) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :RETURN_TRANSFER_FRAME_ALLOC, Name{ StringValue: COPY UNWRAP (return_transfers[rtoc_idx]) }, "return ownership transfer is backed by :frame allocation; escaping owned returns must be heap")));
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PUB FN mIRChecker__verify_alloc_marks_typed_mut(MUTABLE self: MIRChecker, allocs: {String}[]AllocMark) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR rtoc_key IN allocs.keys() DO
    MUTABLE marks: []AllocMark = COPY UNWRAP (allocs[rtoc_key]);
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < marks.length() DO
      IF !(type__untyped?(UNWRAP (marks[rtoc_idx]?.type_info))) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :ALLOC_MARK_TYPE_MISSING, Name{ StringValue: COPY rtoc_key }, "MIR::AllocMark must carry a concrete Type so MIRChecker can prove cleanup/ownership safety")));
    rtoc_idx = rtoc_idx + 1;
    END
    END
}
END
PUB FN mIRChecker__verify_structural_ownership_contracts_mut(MUTABLE self: MIRChecker, nodes: []Emittable, transfers: [Set]String, allocs: {String}[]AllocMark) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_each_items_9 = (CAST((nodes |> DISTINCT _) AS []Emittable));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_9.length() DO
      MUTABLE consumed = TRY (mIRChecker__structural_consumed_names(&rtoc_self_view, UNWRAP (rtoc_each_items_9[rtoc_idx])));
      IF (consumed.length() == 0) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE sink_alloc: ?String@symbol = NIL;
      MUTABLE rtoc_sink_node = UNWRAP (rtoc_each_items_9[rtoc_idx]);
      IF rtoc_sink_node IS_A ReassignWithCleanup AS rtoc_reassign THEN
        sink_alloc = COPY rtoc_reassign.alloc;
      ELSE_IF emittable__resolved_allocs(rtoc_sink_node) EXISTS AS rtoc_allocs THEN
        sink_alloc = COPY inlineAllocMetadata__value_alloc(rtoc_allocs);
      END
      MUTABLE rtoc_idx_2 = 0;
      WHILE rtoc_idx_2 < consumed.length() DO
          IF !(allocs.contains?(consumed[rtoc_idx_2]?)) THEN
            rtoc_idx_2 = rtoc_idx_2 + 1;
        CONTINUE;
          END
          IF !(transfers.contains?(consumed[rtoc_idx_2]?)) THEN
              &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_CONTRACT_WITHOUT_TRANSFER, Name{ StringValue: COPY consumed[rtoc_idx_2]? }, "structural ownership sink consumes '${consumed[rtoc_idx_2]?}' but no MIR::TransferMark exists for that binding")));
          END
          MUTABLE mark: ?AllocMark = NIL;
          IF allocs[consumed[rtoc_idx_2]?] EXISTS AS rtoc_mark_list THEN
            mark = rtoc_mark_list.first();
          END
          IF !((mark AND sink_alloc)) THEN
              rtoc_idx_2 = rtoc_idx_2 + 1;
        CONTINUE;
          END
          IF ((UNWRAP (mark)).alloc == sink_alloc) THEN
              rtoc_idx_2 = rtoc_idx_2 + 1;
        CONTINUE;
          END
          &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :AGGREGATE_CHILD_ALLOC_MISMATCH, Name{ StringValue: COPY consumed[rtoc_idx_2]? }, "structural ownership sink consumes :${(UNWRAP (mark)).alloc} binding '${consumed[rtoc_idx_2]?}' into :${sink_alloc OR_ELSE ""} sink; owned transfer allocator is incoherent")));
        rtoc_idx_2 = rtoc_idx_2 + 1;
      END
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PUB FN mIRChecker__verify_ownership_consumption_operands_mut(MUTABLE self: MIRChecker, nodes: []Emittable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_each_items_12 = (CAST((nodes |> DISTINCT _) AS []Emittable));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_12.length() DO
      MUTABLE fact: ?OwnershipConsumptionFact = emittable__ownership_consumption(UNWRAP (rtoc_each_items_12[rtoc_idx]));
      IF !(fact EXISTS) THEN
          &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_CONSUMPTION_FACT_MISSING, Name{ StringValue: COPY mIRChecker__ownership_node_name(rtoc_self_view, UNWRAP (rtoc_each_items_12[rtoc_idx])) }, "ownership-consuming MIR node has no MIR::OwnershipConsumptionFact")));
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF (UNWRAP (fact)).operands.empty?() THEN
          &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_CONSUMPTION_OPERAND_MISSING, Name{ StringValue: COPY mIRChecker__ownership_node_name(rtoc_self_view, UNWRAP (rtoc_each_items_12[rtoc_idx])) }, "ownership-consuming MIR node has no operand provenance")));
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE rtoc_each_items_13 = (UNWRAP (fact)).operands;
      MUTABLE rtoc_idx_2 = 0;
      WHILE rtoc_idx_2 < rtoc_each_items_13.length() DO
          IF (UNWRAP (rtoc_each_items_13[rtoc_idx_2]).kind == :non_owning) THEN
            rtoc_idx_2 = rtoc_idx_2 + 1;
        CONTINUE;
          END
          IF !(UNWRAP (rtoc_each_items_13[rtoc_idx_2]).borrowed) THEN
              rtoc_idx_2 = rtoc_idx_2 + 1;
        CONTINUE;
          END
          &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_CONSUMPTION_BORROWED_OPERAND, Name{ StringValue: COPY (UNWRAP (rtoc_each_items_13[rtoc_idx_2]).name OR_ELSE (UNWRAP (fact)).source) }, "ownership-consuming MIR node tries to consume borrowed operand from ${UNWRAP (rtoc_each_items_13[rtoc_idx_2]).source}")));
        rtoc_idx_2 = rtoc_idx_2 + 1;
      END
    rtoc_idx = rtoc_idx + 1;
    END
    NIL;
}
END
PUB FN mIRChecker__structural_consumed_names(MUTABLE self: MIRChecker, node: Emittable) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fact: ?OwnershipConsumptionFact = emittable__ownership_consumption(node);
    IF fact EXISTS THEN
      RETURN TRY (mIRChecker__ownership_consumption_operand_names(rtoc_self_view, fact));
    END
    IF !(mIRChecker__stdlib_takes_ownership?(rtoc_self_view, node)) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_14: []String = List[]; rtoc_empty_list_14 } ) AS []String);
    END
    MUTABLE value: ?Emittable = emittable__value(node);
    IF value EXISTS AS rtoc_value_node THEN
      IF rtoc_value_node IS_A Ident AS rtoc_value_ident THEN
        RETURN CAST([CAST(rtoc_value_ident.name AS String)] AS []String);
      END
    END
    IF TRY (mIRChecker__allocating_expr?(rtoc_self_view, value)) THEN
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :IMPLICIT_OWNERSHIP_TRANSFER, Name{ StringValue: COPY mIRChecker__ownership_node_name(rtoc_self_view, node) }, "structural ownership sink takes a value, but the source owner is not a named MIR binding")));
    END
    RETURN CAST(( { MUTABLE rtoc_empty_list_15: []String = List[]; rtoc_empty_list_15 } ) AS []String);
}
END
PUB FN mIRChecker__ownership_consumption_operand_names(self: MIRChecker, fact: OwnershipConsumptionFact) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN CAST(((fact.operands |> SELECT:? _.name |> WHERE _ != NIL |> SELECT UNWRAP _) |> SELECT _.toString() |> WHERE !(_.empty?()) |> DISTINCT _) AS []String);
}
END
PUB FN mIRChecker__verify_linear_ownership_mut(MUTABLE self: MIRChecker, body: []Emittable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE final_state = TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, body, linearOwnershipState__new()));
    FOR _ IN final_state.pending_return_transfers DO
    &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_UNVERIFIED_PATH, Name{ StringValue: COPY _ } "TransferMark(:return) was emitted but no ReturnStmt consumed that ownership transfer")));
    END
    NIL;
}
END
PUB FN mIRChecker__check_linear_stmts_mut(MUTABLE self: MIRChecker, stmts: []Emittable, MUTABLE state: LinearOwnershipState) RETURNS !LinearOwnershipState@multiowned
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < stmts.length() DO
      IF state.terminated THEN
          BREAK;
      END
      TRY (mIRChecker__check_linear_stmt_mut(&rtoc_self_view, stmts[rtoc_idx]?, &state));
    rtoc_idx = rtoc_idx + 1;
    END
    MUTABLE rtoc_owned_return_16: LinearOwnershipState@multiowned = state;
    RETURN rtoc_owned_return_16;
}
END
PUB FN mIRChecker__check_linear_stmt_mut(MUTABLE self: MIRChecker, stmt: ?Emittable, MUTABLE state: LinearOwnershipState) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF stmt EXISTS AS stmt_value THEN
      MUTABLE stmt_value_mutable = COPY stmt_value;
      IF !(emittable__stmt?(stmt_value_mutable)) THEN
        TRY (mIRChecker__check_linear_expr_uses_mut(&rtoc_self_view, stmt_value_mutable, &state));
        RETURN;
      END
      IF !(mIRChecker__linear_statement_node?(stmt_value_mutable)) THEN
        &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :LINEAR_STMT_NOT_REGISTERED, Name{ StringValue: COPY emittable__variant_name(stmt_value_mutable) }, "MIR statement is not registered with MIRChecker linear ownership traversal")));
        RETURN;
      END
      IF stmt_value_mutable IS_A AllocMark AS alloc_mark THEN
        MUTABLE alloc_mark_mutable = COPY alloc_mark;
        TRY (mIRChecker__linear_alloc_mut(&rtoc_self_view, alloc_mark_mutable, &state));
      ELSE_IF stmt_value_mutable IS_A Cleanup AS cleanup THEN
        MUTABLE cleanup_mutable = COPY cleanup;
        TRY (mIRChecker__linear_register_cleanup_mut(&rtoc_self_view, CAST(cleanup_mutable.name AS String), { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_17 = CAST(cleanup_mutable.cleanup_entry AS CleanupEntry);
        cleanupEntry__has_moved_guard?(rtoc_local_receiver_17) }, &state));
      ELSE_IF stmt_value_mutable IS_A ErrCleanup AS err_cleanup THEN
        MUTABLE err_cleanup_mutable = COPY err_cleanup;
        TRY (mIRChecker__linear_register_err_cleanup_mut(&rtoc_self_view, CAST(err_cleanup_mutable.name AS String), &state));
      ELSE_IF stmt_value_mutable IS_A TransferMark AS transfer_mark THEN
        MUTABLE transfer_mark_mutable = COPY transfer_mark;
        TRY (mIRChecker__linear_transfer_mut(&rtoc_self_view, transfer_mark_mutable.name, transfer_mark_mutable.target, transfer_mark_mutable.target_alloc, &state));
      ELSE_IF stmt_value_mutable IS_A MoveMark AS move_mark THEN
        MUTABLE move_mark_mutable = COPY move_mark;
        TRY (mIRChecker__linear_move_mark_mut(&rtoc_self_view, CAST(move_mark_mutable.name AS String), &state));
      ELSE_IF stmt_value_mutable IS_A OwnedCreate AS owned_create THEN
        NIL;
      ELSE_IF stmt_value_mutable IS_A OwnedBorrow AS owned_borrow THEN
        NIL;
      ELSE_IF stmt_value_mutable IS_A OwnedStore AS owned_store THEN
        NIL;
      ELSE_IF stmt_value_mutable IS_A OwnedTransfer AS owned_transfer THEN
        NIL;
      ELSE_IF stmt_value_mutable IS_A OwnedReturn AS owned_return THEN
        NIL;
      ELSE_IF stmt_value_mutable IS_A OwnedDestroy AS owned_destroy THEN
        NIL;
      ELSE_IF stmt_value_mutable IS_A ReassignMark AS reassign_mark THEN
        NIL;
      ELSE_IF stmt_value_mutable IS_A FieldCleanupMark AS field_cleanup_mark THEN
        NIL;
      ELSE_IF stmt_value_mutable IS_A ReturnMark AS return_mark THEN
        NIL;
      ELSE_IF stmt_value_mutable IS_A Panic AS panic THEN
        state.terminated = TRUE;
      ELSE_IF stmt_value_mutable IS_A ReturnStmt AS return_stmt THEN
        MUTABLE return_stmt_mutable = COPY return_stmt;
        MUTABLE return_reads = COPY state.pending_return_transfers;
        FOR _ IN (TRY (mIRChecker__linear_expr_consumed_names(rtoc_self_view, return_stmt_mutable.value))) DO
        &return_reads.insert(COPY _);
        END
        TRY (mIRChecker__check_linear_expr_uses_mut(&rtoc_self_view, return_stmt_mutable.value, &state, return_reads));
        MUTABLE returned_names = TRY (mIRChecker__linear_expr_ident_names(rtoc_self_view, return_stmt_mutable.value));
        TRY (mIRChecker__verify_guarded_transfers_moved_mut(&rtoc_self_view, state.pending_return_transfers, state, :return));
        FOR _ IN state.pending_return_transfers DO
        TRY (mIRChecker__linear_release_mut(&rtoc_self_view, _, :return, NIL, &state));
        END
        MUTABLE rtoc_idx = 0;
        WHILE rtoc_idx < state.pending_return_transfers.length() DO
      IF returned_names.contains?(state.pending_return_transfers[rtoc_idx]) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_UNVERIFIED_PATH, Name{ StringValue: COPY UNWRAP (state.pending_return_transfers[rtoc_idx]) } "TransferMark(:return) does not match the returned expression")));
    rtoc_idx = rtoc_idx + 1;
        END
        &state.pending_return_transfers.clear();
        state.terminated = TRUE;
      ELSE_IF stmt_value_mutable IS_A BreakStmt AS break_stmt THEN
        MUTABLE break_stmt_mutable = COPY break_stmt;
        MUTABLE block_reads = COPY state.pending_block_transfers;
        FOR _ IN (TRY (mIRChecker__linear_expr_consumed_names(rtoc_self_view, break_stmt_mutable.value))) DO
        &block_reads.insert(COPY _);
        END
        TRY (mIRChecker__check_linear_expr_uses_mut(&rtoc_self_view, break_stmt_mutable.value, &state, block_reads));
        MUTABLE break_names = TRY (mIRChecker__linear_expr_ident_names(rtoc_self_view, break_stmt_mutable.value));
        TRY (mIRChecker__verify_guarded_transfers_moved_mut(&rtoc_self_view, state.pending_block_transfers, state, :block_result));
        FOR _ IN state.pending_block_transfers DO
        TRY (mIRChecker__linear_release_mut(&rtoc_self_view, _, :block_result, NIL, &state));
        END
        MUTABLE rtoc_idx = 0;
        WHILE rtoc_idx < state.pending_block_transfers.length() DO
      IF break_names.contains?(state.pending_block_transfers[rtoc_idx]) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_UNVERIFIED_PATH, Name{ StringValue: COPY UNWRAP (state.pending_block_transfers[rtoc_idx]) } "TransferMark(:block_result) does not match the block break expression")));
    rtoc_idx = rtoc_idx + 1;
        END
        &state.pending_block_transfers.clear();
      ELSE
        MUTABLE manual_traversal = (((((stmt_value_mutable IS_A MIRDeferStmt OR stmt_value_mutable IS_A ErrDeferStmt) OR stmt_value_mutable IS_A MIRStructDef) OR stmt_value_mutable IS_A FsmB1Body) OR stmt_value_mutable IS_A FsmGenericBody) OR stmt_value_mutable IS_A FsmIoBody);
        IF ((TRY (emittable__body_slots(stmt_value_mutable))).empty?() AND !(manual_traversal)) THEN
          TRY (mIRChecker__check_linear_expr_uses_mut(&rtoc_self_view, stmt_value_mutable, &state));
          RETURN;
        END
      END
      IF stmt_value_mutable IS_A IfStmt AS if_stmt THEN
        MUTABLE if_stmt_mutable = COPY if_stmt;
        TRY (mIRChecker__check_linear_expr_uses_mut(&rtoc_self_view, if_stmt_mutable.cond, &state));
        TRY (mIRChecker__check_linear_branch_join_mut(&rtoc_self_view, if_stmt_mutable.then_body, (if_stmt_mutable.else_body OR_ELSE List[]), &state, "if"));
      ELSE_IF stmt_value_mutable IS_A IfBindStmt AS if_bind_stmt THEN
        MUTABLE if_bind_stmt_mutable = COPY if_bind_stmt;
        IF !((if_bind_stmt_mutable.bindings).empty?()) THEN
                FOR _ IN if_bind_stmt_mutable.bindings DO
            MUTABLE expr = COPY _.expr;
            TRY (mIRChecker__check_linear_expr_uses_mut(&rtoc_self_view, expr, &state));
                END
        END
        TRY (mIRChecker__check_linear_branch_join_mut(&rtoc_self_view, if_bind_stmt_mutable.then_body, (if_bind_stmt_mutable.else_body OR_ELSE List[]), &state, "if-bind"));
      ELSE_IF stmt_value_mutable IS_A WhileStmt AS while_stmt THEN
        MUTABLE while_stmt_mutable = COPY while_stmt;
        TRY (mIRChecker__check_linear_expr_uses_mut(&rtoc_self_view, while_stmt_mutable.cond, &state));
        MUTABLE body_state = TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, TRY (whileStmt__body(while_stmt_mutable)), linearOwnershipState__copy(state)));
        MUTABLE projected = linearOwnershipState__copy(state);
        TRY (mIRChecker__linear_exit_scope_mut(&rtoc_self_view, &projected, body_state, "while"));
        TRY (mIRChecker__linear_require_same_state_mut(&rtoc_self_view, state, projected, "while"));
      ELSE_IF stmt_value_mutable IS_A ForStmt AS for_stmt THEN
        MUTABLE for_stmt_mutable = COPY for_stmt;
        TRY (mIRChecker__check_linear_expr_uses_mut(&rtoc_self_view, for_stmt_mutable.iter, &state));
        MUTABLE body_state = TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, TRY (forStmt__body(for_stmt_mutable)), linearOwnershipState__copy(state)));
        MUTABLE projected = linearOwnershipState__copy(state);
        TRY (mIRChecker__linear_exit_scope_mut(&rtoc_self_view, &projected, body_state, "for"));
        TRY (mIRChecker__linear_require_same_state_mut(&rtoc_self_view, state, projected, "for"));
      ELSE_IF stmt_value_mutable IS_A ScopeBlock AS scope_block THEN
        MUTABLE scope_block_mutable = COPY scope_block;
        MUTABLE inner = TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, TRY (scopeBlock__body(scope_block_mutable)), linearOwnershipState__copy(state)));
        TRY (mIRChecker__linear_exit_scope_mut(&rtoc_self_view, &state, inner, "scope"));
      ELSE_IF stmt_value_mutable IS_A MIRBlockExpr AS mir_block_expr THEN
        MUTABLE mir_block_expr_mutable = COPY mir_block_expr;
        MUTABLE inner = TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, TRY (blockExpr__body(mir_block_expr_mutable)), linearOwnershipState__copy(state)));
        TRY (mIRChecker__linear_exit_scope_mut(&rtoc_self_view, &state, inner, "scope"));
      ELSE_IF stmt_value_mutable IS_A DebugOnly AS debug_only THEN
        MUTABLE debug_only_mutable = COPY debug_only;
        TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, TRY (debugOnly__body(debug_only_mutable)), linearOwnershipState__copy(state)));
      ELSE_IF stmt_value_mutable IS_A SwitchStmt AS switch_stmt THEN
        MUTABLE switch_stmt_mutable = COPY switch_stmt;
        TRY (mIRChecker__check_linear_expr_uses_mut(&rtoc_self_view, switch_stmt_mutable.subject, &state));
        MUTABLE states: []LinearOwnershipState@multiowned = ( { MUTABLE rtoc_empty_list_18: []LinearOwnershipState@multiowned = List[]; rtoc_empty_list_18 } );
        IF !((switch_stmt_mutable.arms).empty?()) THEN
                FOR _ IN switch_stmt_mutable.arms DO
                &states.append(TRY (mIRChecker__linear_project_branch_state(&rtoc_self_view, TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, _.body, linearOwnershipState__copy(state))), state, "match")));
                END
        END
        &states.append(TRY (mIRChecker__linear_project_branch_state(&rtoc_self_view, TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, (switch_stmt_mutable.default_body OR_ELSE List[]), linearOwnershipState__copy(state))), state, "match")));
        TRY (mIRChecker__linear_merge_branch_states_mut(&rtoc_self_view, states, &state, "match"));
      ELSE_IF stmt_value_mutable IS_A UnionMatchStmt AS union_match_stmt THEN
        MUTABLE union_match_stmt_mutable = COPY union_match_stmt;
        TRY (mIRChecker__check_linear_expr_uses_mut(&rtoc_self_view, union_match_stmt_mutable.subject, &state));
        MUTABLE states: []LinearOwnershipState@multiowned = ( { MUTABLE rtoc_empty_list_19: []LinearOwnershipState@multiowned = List[]; rtoc_empty_list_19 } );
        IF !((union_match_stmt_mutable.arms).empty?()) THEN
                FOR _ IN union_match_stmt_mutable.arms DO
                &states.append(TRY (mIRChecker__linear_project_branch_state(&rtoc_self_view, TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, _.body, linearOwnershipState__copy(state))), state, "match")));
                END
        END
        &states.append(TRY (mIRChecker__linear_project_branch_state(&rtoc_self_view, TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, (union_match_stmt_mutable.default_body OR_ELSE List[]), linearOwnershipState__copy(state))), state, "match")));
        TRY (mIRChecker__linear_merge_branch_states_mut(&rtoc_self_view, states, &state, "match"));
      ELSE_IF stmt_value_mutable IS_A IfChain AS if_chain THEN
        MUTABLE if_chain_mutable = COPY if_chain;
        MUTABLE states: []LinearOwnershipState@multiowned = ( { MUTABLE rtoc_empty_list_20: []LinearOwnershipState@multiowned = List[]; rtoc_empty_list_20 } );
        IF !((if_chain_mutable.branches).empty?()) THEN
                FOR _ IN if_chain_mutable.branches DO
            TRY (mIRChecker__check_linear_expr_uses_mut(&rtoc_self_view, _.cond, &state));
            &states.append(TRY (mIRChecker__linear_project_branch_state(&rtoc_self_view, TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, _.body, linearOwnershipState__copy(state))), state, "if-chain")));
                END
        END
        &states.append(TRY (mIRChecker__linear_project_branch_state(&rtoc_self_view, TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, (if_chain_mutable.default_body OR_ELSE List[]), linearOwnershipState__copy(state))), state, "if-chain")));
        TRY (mIRChecker__linear_merge_branch_states_mut(&rtoc_self_view, states, &state, "if-chain"));
      ELSE_IF stmt_value_mutable IS_A MIRDeferStmt AS mir_defer_stmt THEN
        MUTABLE mir_defer_stmt_mutable = COPY mir_defer_stmt;
        MUTABLE body = COPY deferStmt__body(mir_defer_stmt_mutable);
        IF body IS_A []Emittable AS array THEN
          MUTABLE array_mutable = COPY array;
          TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, array_mutable, &state));
        ELSE
          TRY (mIRChecker__check_linear_stmt_mut(&rtoc_self_view, CAST(body AS Emittable), &state));
        END
      ELSE_IF stmt_value_mutable IS_A ErrDeferStmt AS err_defer_stmt THEN
        MUTABLE err_defer_stmt_mutable = COPY err_defer_stmt;
        MUTABLE body = COPY errDeferStmt__body(err_defer_stmt_mutable);
        IF body IS_A []Emittable AS array THEN
          MUTABLE array_mutable = COPY array;
          TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, array_mutable, &state));
        ELSE
          TRY (mIRChecker__check_linear_stmt_mut(&rtoc_self_view, CAST(body AS Emittable), &state));
        END
      ELSE_IF stmt_value_mutable IS_A StreamSpawn AS stream_spawn THEN
        MUTABLE stream_spawn_mutable = COPY stream_spawn;
        TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, TRY (streamSpawn__body(stream_spawn_mutable)), linearOwnershipState__new()));
      ELSE_IF stmt_value_mutable IS_A FnDef AS fn_def THEN
        MUTABLE fn_def_mutable = COPY fn_def;
        TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, TRY (fnDef__body(fn_def_mutable)), linearOwnershipState__new()));
      ELSE_IF stmt_value_mutable IS_A TestDef AS test_def THEN
        MUTABLE test_def_mutable = COPY test_def;
        TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, TRY (testDef__body(test_def_mutable)), linearOwnershipState__new()));
      ELSE_IF stmt_value_mutable IS_A SnapshotRead AS snapshot_read THEN
        MUTABLE snapshot_read_mutable = COPY snapshot_read;
        MUTABLE inner = TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, TRY (snapshotRead__body(snapshot_read_mutable)), linearOwnershipState__copy(state)));
        TRY (mIRChecker__linear_exit_scope_mut(&rtoc_self_view, &state, inner, "MIR::SnapshotRead"));
      ELSE_IF stmt_value_mutable IS_A SnapshotTransaction AS snapshot_transaction THEN
        MUTABLE snapshot_transaction_mutable = COPY snapshot_transaction;
        MUTABLE inner = TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, TRY (snapshotTransaction__body(snapshot_transaction_mutable)), linearOwnershipState__copy(state)));
        TRY (mIRChecker__linear_exit_scope_mut(&rtoc_self_view, &state, inner, "MIR::SnapshotTransaction"));
      ELSE_IF stmt_value_mutable IS_A SnapshotMultiTxn AS snapshot_multi_txn THEN
        MUTABLE snapshot_multi_txn_mutable = COPY snapshot_multi_txn;
        MUTABLE inner = TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, TRY (snapshotMultiTxn__body(snapshot_multi_txn_mutable)), linearOwnershipState__copy(state)));
        TRY (mIRChecker__linear_exit_scope_mut(&rtoc_self_view, &state, inner, "MIR::SnapshotMultiTxn"));
      ELSE_IF stmt_value_mutable IS_A PolymorphicMutate AS polymorphic_mutate THEN
        MUTABLE polymorphic_mutate_mutable = COPY polymorphic_mutate;
        MUTABLE inner = TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, TRY (polymorphicMutate__body(polymorphic_mutate_mutable)), linearOwnershipState__copy(state)));
        TRY (mIRChecker__linear_exit_scope_mut(&rtoc_self_view, &state, inner, "polymorphic-mutate"));
      ELSE_IF stmt_value_mutable IS_A PolymorphicMutateFlow AS polymorphic_mutate_flow THEN
        MUTABLE polymorphic_mutate_flow_mutable = COPY polymorphic_mutate_flow;
        TRY (mIRChecker__check_linear_expr_uses_mut(&rtoc_self_view, polymorphic_mutate_flow_mutable.guard_cond, &state));
        MUTABLE states: []LinearOwnershipState@multiowned = ( { MUTABLE rtoc_empty_list_21: []LinearOwnershipState@multiowned = List[]; rtoc_empty_list_21 } );
        &states.append(TRY (mIRChecker__linear_project_branch_state(&rtoc_self_view, TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, TRY (polymorphicMutateFlow__body(polymorphic_mutate_flow_mutable)), linearOwnershipState__copy(state))), state, "polymorphic-mutate-flow")));
        &states.append(TRY (mIRChecker__linear_project_branch_state(&rtoc_self_view, TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, (polymorphic_mutate_flow_mutable.guard_fail_body OR_ELSE List[]), linearOwnershipState__copy(state))), state, "polymorphic-mutate-flow")));
        TRY (mIRChecker__linear_merge_branch_states_mut(&rtoc_self_view, states, &state, "polymorphic-mutate-flow"));
      ELSE_IF stmt_value_mutable IS_A WithMatchDispatch AS with_match_dispatch THEN
        MUTABLE with_match_dispatch_mutable = COPY with_match_dispatch;
        MUTABLE states: []LinearOwnershipState@multiowned = ( { MUTABLE rtoc_empty_list_22: []LinearOwnershipState@multiowned = List[]; rtoc_empty_list_22 } );
        IF !((with_match_dispatch_mutable.arms).empty?()) THEN
                FOR _ IN with_match_dispatch_mutable.arms DO
                &states.append(TRY (mIRChecker__linear_project_branch_state(&rtoc_self_view, TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, _.body, linearOwnershipState__copy(state))), state, "with-match")));
                END
        END
        TRY (mIRChecker__linear_merge_branch_states_mut(&rtoc_self_view, states, &state, "with-match"));
      ELSE_IF stmt_value_mutable IS_A MIRBgBlock AS mir_bg_block THEN
        MUTABLE mir_bg_block_mutable = COPY mir_bg_block;
        TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, mir_bg_block_mutable.run_body, linearOwnershipState__new()));
      ELSE_IF stmt_value_mutable IS_A MIRDoBlock AS mir_do_block THEN
        MUTABLE mir_do_block_mutable = COPY mir_do_block;
        IF !((mir_do_block_mutable.branch_bodies).empty?()) THEN
                FOR _ IN mir_do_block_mutable.branch_bodies DO
                TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, _, linearOwnershipState__new()));
                END
        END
      ELSE_IF stmt_value_mutable IS_A CatchWrapper AS catch_wrapper THEN
        MUTABLE catch_wrapper_mutable = COPY catch_wrapper;
        IF !((TRY (catchWrapper__clause_bodies(catch_wrapper_mutable))).empty?()) THEN
                FOR _ IN (TRY (catchWrapper__clause_bodies(catch_wrapper_mutable))) DO
                TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, _, linearOwnershipState__copy(state)));
                END
        END
      ELSE_IF stmt_value_mutable IS_A MIRStructDef AS mir_struct_def THEN
        MUTABLE mir_struct_def_mutable = COPY mir_struct_def;
        IF mir_struct_def_mutable.methods != NIL THEN
                FOR _ IN UNWRAP (mir_struct_def_mutable.methods) DO
                IF _ IS_A FnDef THEN
                  TRY (mIRChecker__check_linear_stmt_mut(&rtoc_self_view, _, linearOwnershipState__new()));
                END
                END
        END
      ELSE_IF stmt_value_mutable IS_A FsmB1Body AS fsm_b1_body THEN
        MUTABLE fsm_b1_body_mutable = COPY fsm_b1_body;
        MUTABLE body_stmts = COPY fsm_b1_body_mutable.ctx_struct.run_body.body_stmts;
        TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, body_stmts, linearOwnershipState__new()));
      ELSE_IF stmt_value_mutable IS_A FsmGenericBody AS fsm_generic_body THEN
        NIL;
      ELSE_IF stmt_value_mutable IS_A FsmIoBody AS fsm_io_body THEN
        NIL;
      ELSE_IF stmt_value_mutable IS_A Comment AS comment THEN
        NIL;
      ELSE_IF stmt_value_mutable IS_A ContinueStmt AS continue_stmt THEN
        NIL;
      ELSE_IF stmt_value_mutable IS_A MIREnumDef AS mir_enum_def THEN
        NIL;
      ELSE_IF stmt_value_mutable IS_A FrameRestore AS frame_restore THEN
        NIL;
      ELSE_IF stmt_value_mutable IS_A FrameSave AS frame_save THEN
        NIL;
      ELSE_IF stmt_value_mutable IS_A Import AS import THEN
        NIL;
      ELSE_IF stmt_value_mutable IS_A CExternFnDecl AS c_extern_fn_decl THEN
        NIL;
      ELSE_IF stmt_value_mutable IS_A CExternStructDef AS c_extern_struct_def THEN
        NIL;
      ELSE_IF stmt_value_mutable IS_A MutualThunkTrampoline AS mutual_thunk_trampoline THEN
        NIL;
      ELSE_IF stmt_value_mutable IS_A Noop AS noop THEN
        NIL;
      ELSE_IF stmt_value_mutable IS_A PubConst AS pub_const THEN
        NIL;
      ELSE_IF stmt_value_mutable IS_A Suppress AS suppress THEN
        NIL;
      ELSE_IF stmt_value_mutable IS_A ThunkTrampoline AS thunk_trampoline THEN
        NIL;
      ELSE_IF stmt_value_mutable IS_A TypeAlias AS type_alias THEN
        NIL;
      ELSE_IF stmt_value_mutable IS_A TestPreamble AS test_preamble THEN
        NIL;
      ELSE_IF stmt_value_mutable IS_A UnionTypeDef AS union_type_def THEN
        NIL;
      END
      NIL;
    ELSE
      RETURN;
    END
}
END
PUB FN mIRChecker__linear_alloc_mut(MUTABLE self: MIRChecker, mark: AllocMark, MUTABLE state: LinearOwnershipState) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE name = COPY mark.name;
    IF (state.owned.contains?(name) AND !(state.released.contains?(name))) THEN
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_UNVERIFIED_PATH, Name{ StringValue: COPY name }, "AllocMark appears while prior ownership for the same binding is still active")));
    END
    &state.owned.insert(name);
    state.alloc_kinds[name] = COPY mark.alloc;
    IF (mark.scope != NIL) THEN
      state.alloc_scopes[name] = symbol(UNWRAP (COPY mark.scope));
    END
    &state.released.remove(name);
    &state.maybe_released.remove(name);
    &state.cleanup_finalizers.remove(name);
    &state.guarded_finalizers.remove(name);
    &state.err_finalizers.remove(name);
    &state.pending_return_transfers.remove(name);
    &state.pending_block_transfers.remove(name);
    NIL;
}
END
PUB FN mIRChecker__linear_register_cleanup_mut(MUTABLE self: MIRChecker, name: String, guarded: Bool, MUTABLE state: LinearOwnershipState) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (mIRChecker__linear_register_finalizer_mut(&rtoc_self_view, name, "Cleanup", &state));
    IF guarded THEN
      &state.guarded_finalizers.insert(COPY name);
    END
    NIL;
}
END
PUB FN mIRChecker__linear_register_err_cleanup_mut(MUTABLE self: MIRChecker, name: String, MUTABLE state: LinearOwnershipState) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (mIRChecker__linear_register_finalizer_mut(&rtoc_self_view, name, "ErrCleanup", &state));
    NIL;
}
END
PUB FN mIRChecker__linear_register_finalizer_mut(MUTABLE self: MIRChecker, name: String, kind: String, MUTABLE state: LinearOwnershipState) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF state.released.contains?(name) THEN
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_DOUBLE_RELEASE, Name{ StringValue: COPY name }, "${kind} registered after ownership for this binding was already transferred")));
    END
    IF (state.cleanup_finalizers.contains?(name) OR state.err_finalizers.contains?(name)) THEN
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_DOUBLE_FINALIZER, Name{ StringValue: COPY name }, "multiple cleanup strategies registered for one owned binding")));
    END
    IF kind == "Cleanup" THEN
      &state.cleanup_finalizers.insert(COPY name);
    ELSE
      &state.err_finalizers.insert(COPY name);
    END
    NIL;
}
END
PUB FN mIRChecker__linear_transfer_mut(MUTABLE self: MIRChecker, name: String, target: String@symbol, target_alloc: ?String@symbol, MUTABLE state: LinearOwnershipState) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (target == :return) THEN
      &state.pending_return_transfers.insert(COPY name);
      RETURN;
    END
    IF (target == :block_result) THEN
      &state.pending_block_transfers.insert(COPY name);
      RETURN;
    END
    IF (state.cleanup_finalizers.contains?(name) AND !(state.guarded_finalizers.contains?(name))) THEN
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_DOUBLE_RELEASE, Name{ StringValue: COPY name }, "TransferMark and unguarded Cleanup both own the success-path release")));
    END
    TRY (mIRChecker__linear_release_mut(&rtoc_self_view, name, target, target_alloc, &state));
    NIL;
}
END
PUB FN mIRChecker__linear_move_mark_mut(MUTABLE self: MIRChecker, name: String, MUTABLE state: LinearOwnershipState) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE rtoc_defer_move_mark: String = COPY name;
  DEFER &state.move_marks.insert(rtoc_defer_move_mark);
  IF ((state.released.contains?(name) OR state.pending_return_transfers.contains?(name)) OR state.pending_block_transfers.contains?(name)) THEN
      RETURN;
  END
  &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_IMPLICIT_MOVE, Name{ StringValue: COPY name }, "MoveMark suppresses cleanup but no matching TransferMark was seen first")));
  NIL;
}
END
PUB FN mIRChecker__verify_guarded_transfers_moved_mut(MUTABLE self: MIRChecker, names: [Set]String, state: LinearOwnershipState, target: String@symbol) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < names.length() DO
      IF !(state.guarded_finalizers.contains?(names[rtoc_idx])) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF state.move_marks.contains?(names[rtoc_idx]) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_IMPLICIT_MOVE, Name{ StringValue: COPY UNWRAP (names[rtoc_idx]) } "TransferMark(:${target}) moves a guarded cleanup binding without MIR::MoveMark")));
    rtoc_idx = rtoc_idx + 1;
    END
    NIL;
}
END
PUB FN mIRChecker__linear_release_mut(MUTABLE self: MIRChecker, name: String, target: String@symbol, target_alloc: ?String@symbol, MUTABLE state: LinearOwnershipState) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(state.owned.contains?(name)) THEN
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :TRANSFER_WITHOUT_ALLOC, Name{ StringValue: COPY name }, "ownership release to ${compilerInspectValue()} has no active AllocMark")));
      RETURN;
    END
    IF ((target == :owned_sink) AND (target_alloc == NIL)) THEN
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :IMPLICIT_OWNERSHIP_TRANSFER, Name{ StringValue: COPY name }, "TransferMark(:owned_sink) must carry target_alloc so MIRChecker can prove whether ownership escapes")));
    END
    IF ((state.alloc_kinds[name] == :frame) AND mIRChecker__escaping_transfer_target?(rtoc_self_view, target, target_alloc)) THEN
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :FRAME_ALLOC_ESCAPES, Name{ StringValue: COPY name }, "frame-allocated ownership is transferred to ${compilerInspectValue()}; escaping owned values must be heap")));
    END
    IF state.released.contains?(name) THEN
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_DOUBLE_RELEASE, Name{ StringValue: COPY name }, "binding ownership is released more than once")));
      RETURN;
    END
    &state.released.insert(COPY name);
    &state.maybe_released.remove(name);
    NIL;
}
END
PUB FN mIRChecker__escaping_transfer_target?(self: MIRChecker, target: String@symbol, target_alloc: ?String@symbol) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (target == :owned_sink) THEN
      RETURN placement__explicit_heap?(target_alloc);
    END
    RETURN ([:return, :external_param, :capture, :field_store, :aggregate_store] |> DISTINCT _).contains?(target);
}
END
PUB FN mIRChecker__check_linear_branch_join_mut(MUTABLE self: MIRChecker, then_body: []Emittable, else_body: []Emittable, MUTABLE state: LinearOwnershipState, label: String) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE then_state = TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, then_body, linearOwnershipState__copy(state)));
    MUTABLE else_state = TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, else_body, linearOwnershipState__copy(state)));
    MUTABLE projected_then = TRY (mIRChecker__linear_project_branch_state(&rtoc_self_view, then_state, state, label));
    MUTABLE projected_else = TRY (mIRChecker__linear_project_branch_state(&rtoc_self_view, else_state, state, label));
    TRY (mIRChecker__linear_merge_branch_states_mut(&rtoc_self_view, [projected_then, projected_else], &state, label));
    NIL;
}
END
PUB FN mIRChecker__linear_project_branch_state(MUTABLE self: MIRChecker, branch_state: LinearOwnershipState, outer_state: LinearOwnershipState, label: String) RETURNS !LinearOwnershipState@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE projected = linearOwnershipState__copy(branch_state);
    TRY (mIRChecker__prune_scope_locals_mut(&rtoc_self_view, outer_state, &projected, label));
    RETURN projected;
}
END
PUB FN mIRChecker__linear_merge_branch_states_mut(MUTABLE self: MIRChecker, states: []LinearOwnershipState@multiowned, MUTABLE into: LinearOwnershipState, label: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (states.length() == 0) THEN
      RETURN;
    END
    MUTABLE live_states: []LinearOwnershipState@multiowned = states |> WHERE !(_.terminated);
    IF (live_states.length() == 0) THEN
      into.terminated = TRUE;
      RETURN;
    END
    MUTABLE first = COPY UNWRAP (live_states.first());
    mIRChecker__normalize_guarded_conditional_releases_mut(rtoc_self_view, live_states);
    MUTABLE rtoc_each_items_23 = (live_states |> SKIP 1);
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_23.length() DO
      IF linearOwnershipState__same_state?(rtoc_each_items_23[rtoc_idx], first) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_UNVERIFIED_PATH, Name{ StringValue: COPY label }, "control-flow branches rejoin with different ownership state: ${TRY (linearOwnershipState__summary(first))} vs ${linearOwnershipState__summary(rtoc_each_items_23[rtoc_idx])}")));
    rtoc_idx = rtoc_idx + 1;
    END
    mIRChecker__copy_linear_state_mut(rtoc_self_view, first, &into);
    NIL;
}
END
PUB FN mIRChecker__normalize_guarded_conditional_releases_mut(self: MIRChecker, states: []LinearOwnershipState@multiowned) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (states.length() == 0) THEN
      RETURN;
    END
    MUTABLE names: [Set]String = Set[];
    FOR _ IN states DO
    &names.merge(_.released);
    END
    FOR _ IN states DO
    &names.merge(_.maybe_released);
    END
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < names.length() DO
      MUTABLE released_count = states |> COUNT (_.released.contains?(names[rtoc_idx]) OR _.maybe_released.contains?(names[rtoc_idx]));
      IF ((released_count == 0) OR (released_count == states.length())) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !(states |> ALL _.guarded_finalizers.contains?(names[rtoc_idx])) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      FOR _ IN states DO
        MUTABLE rtoc_mutable_block_param_24 = COPY _;
        &rtoc_mutable_block_param_24.released.remove(names[rtoc_idx]);
        &rtoc_mutable_block_param_24.maybe_released.insert(COPY UNWRAP (names[rtoc_idx]));
      END
    rtoc_idx = rtoc_idx + 1;
    END
    NIL;
}
END
PUB FN mIRChecker__linear_require_same_state_mut(MUTABLE self: MIRChecker, expected: LinearOwnershipState, actual: LinearOwnershipState, label: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    mIRChecker__normalize_guarded_conditional_releases_mut(rtoc_self_view, [expected, actual]);
    IF TRY (linearOwnershipState__same_state?(expected, actual)) THEN
      RETURN;
    END
    &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_UNVERIFIED_PATH, Name{ StringValue: COPY label }, "nested control flow changes ownership state in a way MIRChecker cannot prove: ${TRY (linearOwnershipState__summary(expected))} vs ${TRY (linearOwnershipState__summary(actual))}")));
    NIL;
}
END
PUB FN mIRChecker__linear_exit_scope_mut(MUTABLE self: MIRChecker, MUTABLE outer: LinearOwnershipState, inner: LinearOwnershipState, label: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE projected = linearOwnershipState__copy(inner);
    TRY (mIRChecker__prune_scope_locals_mut(&rtoc_self_view, outer, &projected, label));
    mIRChecker__copy_linear_state_mut(rtoc_self_view, projected, &outer);
    NIL;
}
END
PUB FN mIRChecker__prune_scope_locals_mut(MUTABLE self: MIRChecker, outer: LinearOwnershipState, MUTABLE projected: LinearOwnershipState, label: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE local_names: [Set]String = (projected.owned.difference(outer.owned));
    FOR _ IN local_names DO
    IF !((((projected.released.contains?(_) OR projected.cleanup_finalizers.contains?(_)) OR projected.err_finalizers.contains?(_)) OR (projected.alloc_kinds[_] == :frame))) THEN
        &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_UNVERIFIED_PATH, Name{ StringValue: COPY label }, "scope-local owned binding '${_}' exits without cleanup or transfer")));
    END
    &projected.owned.remove(_);
    &projected.released.remove(_);
    &projected.cleanup_finalizers.remove(_);
    &projected.guarded_finalizers.remove(_);
    &projected.err_finalizers.remove(_);
    &projected.pending_return_transfers.remove(_);
    &projected.pending_block_transfers.remove(_);
    &projected.maybe_released.remove(_);
    &projected.alloc_kinds.delete(_);
    &projected.alloc_scopes.delete(_);
    END
    NIL;
}
END
PUB FN mIRChecker__copy_linear_state_mut(self: MIRChecker, source: LinearOwnershipState, MUTABLE target: LinearOwnershipState) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    &target.owned.clear();
    &target.owned.merge(source.owned);
    &target.released.clear();
    &target.released.merge(source.released);
    &target.maybe_released.clear();
    &target.maybe_released.merge(source.maybe_released);
    &target.cleanup_finalizers.clear();
    &target.cleanup_finalizers.merge(source.cleanup_finalizers);
    &target.guarded_finalizers.clear();
    &target.guarded_finalizers.merge(source.guarded_finalizers);
    &target.err_finalizers.clear();
    &target.err_finalizers.merge(source.err_finalizers);
    &target.pending_return_transfers.clear();
    &target.pending_return_transfers.merge(source.pending_return_transfers);
    &target.pending_block_transfers.clear();
    &target.pending_block_transfers.merge(source.pending_block_transfers);
    &target.alloc_kinds.clear();
    &target.alloc_kinds.merge_mut(source.alloc_kinds);
    &target.alloc_scopes.clear();
    &target.alloc_scopes.merge_mut(source.alloc_scopes);
    target.terminated = source.terminated;
    NIL;
}
END
PUB FN mIRChecker__check_linear_expr_uses_mut(MUTABLE self: MIRChecker, expr: ?Emittable, MUTABLE state: LinearOwnershipState, transfer_reads: [Set]String = Set[]) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE consuming_reads: [Set]String = COPY transfer_reads;
    FOR _ IN (TRY (mIRChecker__linear_expr_consumed_names(rtoc_self_view, expr))) DO
    &consuming_reads.insert(COPY _);
    END
    IF expr? IS_A Pipeline AS pipeline THEN
      MUTABLE pipeline_mutable = COPY pipeline;
      TRY (mIRChecker__check_linear_expr_uses_mut(&rtoc_self_view, pipeline_mutable.inner, &state, consuming_reads));
      RETURN;
    END
    IF expr? IS_A MIRBlockExpr AS mir_block_expr THEN
      MUTABLE mir_block_expr_mutable = COPY mir_block_expr;
      MUTABLE inner = TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, TRY (blockExpr__body(mir_block_expr_mutable)), linearOwnershipState__copy(state)));
      TRY (mIRChecker__linear_exit_scope_mut(&rtoc_self_view, &state, inner, "block-expr"));
      RETURN;
    END
    MUTABLE rtoc_each_items_25 = (TRY (mIRChecker__linear_expr_ident_names(rtoc_self_view, expr)));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_25.length() DO
      IF consuming_reads.contains?(UNWRAP (rtoc_each_items_25[rtoc_idx])) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !((state.released.contains?(UNWRAP (rtoc_each_items_25[rtoc_idx])) OR state.maybe_released.contains?(UNWRAP (rtoc_each_items_25[rtoc_idx])))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_USE_AFTER_TRANSFER, Name{ StringValue: COPY UNWRAP (rtoc_each_items_25[rtoc_idx]) } "binding read after ownership was transferred")));
    rtoc_idx = rtoc_idx + 1;
    END
    TRY (mIRChecker__check_nested_linear_expr_bodies_mut(&rtoc_self_view, expr, &state));
    NIL;
}
END
PUB FN mIRChecker__check_nested_linear_expr_bodies_mut(MUTABLE self: MIRChecker, expr: ?Emittable, MUTABLE state: LinearOwnershipState) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !((expr != NIL)) THEN
      RETURN;
    END
    FOR _ IN (TRY (emittable__child_exprs(UNWRAP (expr)))) DO
    IF _ IS_A MIRBlockExpr THEN
      MUTABLE inner = TRY (mIRChecker__check_linear_stmts_mut(&rtoc_self_view, UNWRAP (emittable__body(_)), linearOwnershipState__copy(state)));
      TRY (mIRChecker__linear_exit_scope_mut(&rtoc_self_view, &state, inner, "block-expr"));
    ELSE
      TRY (mIRChecker__check_nested_linear_expr_bodies_mut(&rtoc_self_view, _, &state));
    END
    END
    NIL;
}
END
PUB FN mIRChecker__linear_expr_consumed_names(self: MIRChecker, expr: ?Emittable) RETURNS ![Set]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE names: [Set]String = Set[];
    mIRChecker__walk_mir_node(rtoc_self_view, ruby_wrap_optional_Emittable_NodeRoot(expr), %(node: Emittable) USE(MUTABLE names, rtoc_self_view) -> {
    IF ((node IS_A StructInit OR node IS_A ArrayInit) OR node IS_A TupleLiteral) THEN
        mIRChecker__collect_linear_expr_ident_names(rtoc_self_view, node, &names);
    END
    IF !((((node IS_A Call OR node IS_A RuntimeCall) OR node IS_A TailCall) OR node IS_A MIRMethodCall)) THEN
        RETURN;
    END
    MUTABLE callable: ?CallableContract@multiowned = NIL;
    IF node IS_A RuntimeCall AS rtoc_runtime_call THEN
      callable = KEEP rtoc_runtime_call.spec.callable_contract;
    ELSE
      callable = emittable__callable_contract(node);
    END
    IF callable EXISTS AS rtoc_callable THEN
      MUTABLE rtoc_contract = COPY rtoc_callable.ownership_contract;
        FOR _ IN (TRY (ownershipContract__owned_operand_names(rtoc_contract))) DO
          &names.insert(COPY CAST(_ AS String));
      END
    END
    rubyToClearVoid()
    });
    RETURN names;
}
END
PUB FN mIRChecker__linear_expr_ident_names(self: MIRChecker, expr: ?Emittable) RETURNS ![Set]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE names: [Set]String = Set[];
    mIRChecker__collect_linear_expr_ident_names(rtoc_self_view, expr, &names);
    RETURN names;
}
END
PUB FN mIRChecker__collect_linear_expr_ident_names(self: MIRChecker, expr: ?Emittable, MUTABLE names: [Set]String) RETURNS Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF expr EXISTS AS expr_value THEN
      MUTABLE expr_value_mutable = COPY expr_value;
      IF expr_value_mutable IS_A Ident AS ident THEN
        &names.insert(COPY CAST(ident.name AS String));
        RETURN;
      ELSE_IF expr_value_mutable IS_A MIRBlockExpr AS mir_block_expr THEN
        RETURN;
      END
      FOR _ IN emittable__child_exprs(expr_value_mutable) DO
      mIRChecker__collect_linear_expr_ident_names(rtoc_self_view, _, &names);
      END
      NIL;
    ELSE
      RETURN;
    END
}
END
PUB FN mIRChecker__verify_move_mark_scope_mut(MUTABLE self: MIRChecker, body: []Emittable, MUTABLE visible: [Set]String = Set[]) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN body DO
    IF _ IS_A Cleanup AS cleanup THEN
      IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_29 = CAST(cleanup.cleanup_entry AS CleanupEntry);
      cleanupEntry__has_moved_guard?(rtoc_local_receiver_29) } THEN
        &visible.insert(COPY CAST(cleanup.name AS String));
      END
    ELSE_IF _ IS_A ErrCleanup AS err_cleanup THEN
      IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_30 = CAST(err_cleanup.cleanup_entry AS CleanupEntry);
      cleanupEntry__has_moved_guard?(rtoc_local_receiver_30) } THEN
        &visible.insert(COPY CAST(err_cleanup.name AS String));
      END
    ELSE_IF _ IS_A MoveMark AS move_mark THEN
      IF !(visible.contains?(CAST(move_mark.name AS String))) THEN
        &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :MOVEMARK_WITHOUT_GUARD, Name{ StringValue: COPY move_mark.name } "MIR::MoveMark has no visible guarded Cleanup/ErrCleanup; ownership marker escaped its lexical owner")));
      END
    ELSE_IF _ IS_A IfStmt AS if_stmt THEN
      MUTABLE if_stmt_mutable = COPY if_stmt;
      TRY (mIRChecker__verify_move_mark_scope_mut(&rtoc_self_view, if_stmt_mutable.then_body, COPY visible));
      TRY (mIRChecker__verify_move_mark_scope_mut(&rtoc_self_view, (if_stmt_mutable.else_body OR_ELSE List[]), COPY visible));
    ELSE_IF _ IS_A IfBindStmt AS if_bind_stmt THEN
      MUTABLE if_bind_stmt_mutable = COPY if_bind_stmt;
      TRY (mIRChecker__verify_move_mark_scope_mut(&rtoc_self_view, if_bind_stmt_mutable.then_body, COPY visible));
      TRY (mIRChecker__verify_move_mark_scope_mut(&rtoc_self_view, (if_bind_stmt_mutable.else_body OR_ELSE List[]), COPY visible));
    ELSE_IF _ IS_A WhileStmt AS while_stmt THEN
      MUTABLE while_stmt_mutable = COPY while_stmt;
      TRY (mIRChecker__verify_move_mark_scope_mut(&rtoc_self_view, TRY (whileStmt__body(while_stmt_mutable)), COPY visible));
    ELSE_IF _ IS_A ForStmt AS for_stmt THEN
      MUTABLE for_stmt_mutable = COPY for_stmt;
      TRY (mIRChecker__verify_move_mark_scope_mut(&rtoc_self_view, TRY (forStmt__body(for_stmt_mutable)), COPY visible));
    ELSE_IF _ IS_A ScopeBlock AS scope_block THEN
      MUTABLE scope_block_mutable = COPY scope_block;
      TRY (mIRChecker__verify_move_mark_scope_mut(&rtoc_self_view, TRY (scopeBlock__body(scope_block_mutable)), COPY visible));
    ELSE_IF _ IS_A MIRBlockExpr AS mir_block_expr THEN
      MUTABLE mir_block_expr_mutable = COPY mir_block_expr;
      TRY (mIRChecker__verify_move_mark_scope_mut(&rtoc_self_view, TRY (blockExpr__body(mir_block_expr_mutable)), COPY visible));
    ELSE_IF _ IS_A SnapshotRead AS snapshot_read THEN
      MUTABLE snapshot_read_mutable = COPY snapshot_read;
      TRY (mIRChecker__verify_move_mark_scope_mut(&rtoc_self_view, TRY (snapshotRead__body(snapshot_read_mutable)), COPY visible));
    ELSE_IF _ IS_A SnapshotTransaction AS snapshot_transaction THEN
      MUTABLE snapshot_transaction_mutable = COPY snapshot_transaction;
      TRY (mIRChecker__verify_move_mark_scope_mut(&rtoc_self_view, TRY (snapshotTransaction__body(snapshot_transaction_mutable)), COPY visible));
    ELSE_IF _ IS_A SnapshotMultiTxn AS snapshot_multi_txn THEN
      MUTABLE snapshot_multi_txn_mutable = COPY snapshot_multi_txn;
      TRY (mIRChecker__verify_move_mark_scope_mut(&rtoc_self_view, TRY (snapshotMultiTxn__body(snapshot_multi_txn_mutable)), COPY visible));
    ELSE_IF _ IS_A SwitchStmt AS switch_stmt THEN
      MUTABLE switch_stmt_mutable = COPY switch_stmt;
      IF !((switch_stmt_mutable.arms).empty?()) THEN
            FOR _ IN switch_stmt_mutable.arms DO
            TRY (mIRChecker__verify_move_mark_scope_mut(&rtoc_self_view, _.body, COPY visible));
            END
      END
      TRY (mIRChecker__verify_move_mark_scope_mut(&rtoc_self_view, (switch_stmt_mutable.default_body OR_ELSE List[]), COPY visible));
    ELSE_IF _ IS_A UnionMatchStmt AS union_match_stmt THEN
      MUTABLE union_match_stmt_mutable = COPY union_match_stmt;
      IF !((union_match_stmt_mutable.arms).empty?()) THEN
            FOR _ IN union_match_stmt_mutable.arms DO
            TRY (mIRChecker__verify_move_mark_scope_mut(&rtoc_self_view, _.body, COPY visible));
            END
      END
      TRY (mIRChecker__verify_move_mark_scope_mut(&rtoc_self_view, (union_match_stmt_mutable.default_body OR_ELSE List[]), COPY visible));
    ELSE_IF _ IS_A IfChain AS if_chain THEN
      MUTABLE if_chain_mutable = COPY if_chain;
      IF !((if_chain_mutable.branches).empty?()) THEN
            FOR _ IN if_chain_mutable.branches DO
            TRY (mIRChecker__verify_move_mark_scope_mut(&rtoc_self_view, _.body, COPY visible));
            END
      END
      TRY (mIRChecker__verify_move_mark_scope_mut(&rtoc_self_view, (if_chain_mutable.default_body OR_ELSE List[]), COPY visible));
    ELSE_IF _ IS_A MIRBgBlock AS mir_bg_block THEN
      MUTABLE mir_bg_block_mutable = COPY mir_bg_block;
      TRY (mIRChecker__verify_move_mark_scope_mut(&rtoc_self_view, mir_bg_block_mutable.run_body, COPY visible));
    ELSE_IF _ IS_A MIRDoBlock AS mir_do_block THEN
      MUTABLE mir_do_block_mutable = COPY mir_do_block;
      IF !((mir_do_block_mutable.branch_bodies).empty?()) THEN
            FOR _ IN mir_do_block_mutable.branch_bodies DO
            TRY (mIRChecker__verify_move_mark_scope_mut(&rtoc_self_view, _, COPY visible));
            END
      END
    ELSE_IF _ IS_A CatchWrapper AS catch_wrapper THEN
      MUTABLE catch_wrapper_mutable = COPY catch_wrapper;
      IF !((TRY (catchWrapper__clause_bodies(catch_wrapper_mutable))).empty?()) THEN
            FOR _ IN (TRY (catchWrapper__clause_bodies(catch_wrapper_mutable))) DO
            TRY (mIRChecker__verify_move_mark_scope_mut(&rtoc_self_view, _, COPY visible));
            END
      END
    ELSE_IF _ IS_A WithMatchDispatch AS with_match_dispatch THEN
      MUTABLE with_match_dispatch_mutable = COPY with_match_dispatch;
      IF !((with_match_dispatch_mutable.arms).empty?()) THEN
            FOR _ IN with_match_dispatch_mutable.arms DO
            TRY (mIRChecker__verify_move_mark_scope_mut(&rtoc_self_view, _.body, COPY visible));
            END
      END
    END
    END
}
END
PUB FN mIRChecker__verify_err_cleanup_transfers_mut(MUTABLE self: MIRChecker, err_cleanups: {String}[]MIRCheckerCleanupMarksByNameValueItem, transfers: [Set]String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN err_cleanups.keys() DO
    IF transfers.contains?(_) THEN
      CONTINUE;
    END
    &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :ERRCLEANUP_WITHOUT_TRANSFER, Name{ StringValue: COPY _ } "MIR::ErrCleanup requires a matching MIR::TransferMark; success-path owner is implicit")));
    END
}
END
PUB FN mIRChecker__verify_allocating_lets_marked_mut(MUTABLE self: MIRChecker, nodes: []Emittable, allocs: {String}[]AllocMark) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < nodes.length() DO
      IF !(nodes[rtoc_idx]? IS_A Let) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF (emittable__self_managed_alloc(UNWRAP (nodes[rtoc_idx])) OR_ELSE FALSE) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !(TRY (mIRChecker__allocating_expr?(rtoc_self_view, emittable__init(UNWRAP (nodes[rtoc_idx]))))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF allocs.contains?(UNWRAP (emittable__name(UNWRAP (nodes[rtoc_idx])))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :ALLOCATING_LET_WITHOUT_ALLOC, Name{ StringValue: COPY UNWRAP (emittable__name(UNWRAP (nodes[rtoc_idx]))) } "heap-allocating Let init has no MIR::AllocMark; ownership is implicit")));
    rtoc_idx = rtoc_idx + 1;
    END
    NIL;
}
END
PUB FN mIRChecker__verify_aggregate_owned_children_mut(MUTABLE self: MIRChecker, body: []Emittable, allocs: {String}[]AllocMark) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE alloc_by_name: {String}String@symbol = {};
    FOR rtoc_key IN allocs.keys() DO
    MUTABLE marks: []AllocMark = COPY UNWRAP (allocs[rtoc_key]);
    MUTABLE mark: ?AllocMark = COPY marks.first();
    IF ((mark != NIL) AND valid_allocators.contains?(mark.alloc)) THEN
        alloc_by_name[rtoc_key] = COPY mark.alloc;
    END
    END
    TRY (mIRChecker__check_aggregate_stmts_mut(&rtoc_self_view, body, alloc_by_name));
}
END
PUB FN mIRChecker__check_aggregate_stmts_mut(MUTABLE self: MIRChecker, stmts: []Emittable, alloc_by_name: {String}String@symbol) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN stmts DO
    IF _ IS_A Let AS let THEN
      MUTABLE let_mutable = COPY let;
      TRY (mIRChecker__check_aggregate_expr_mut(&rtoc_self_view, MIRCheckerAggregateExpr{ Emittable: COPY let_mutable.init }, alloc_by_name[let_mutable.name], alloc_by_name));
    ELSE_IF _ IS_A Set AS set THEN
      MUTABLE set_mutable = COPY set;
      TRY (mIRChecker__check_aggregate_expr_mut(&rtoc_self_view, MIRCheckerAggregateExpr{ Emittable: COPY set_mutable.value }, NIL, alloc_by_name));
    ELSE_IF _ IS_A DestructureSet AS destructure_set THEN
      MUTABLE destructure_set_mutable = COPY destructure_set;
      TRY (mIRChecker__check_aggregate_expr_mut(&rtoc_self_view, MIRCheckerAggregateExpr{ Emittable: COPY destructure_set_mutable.value }, NIL, alloc_by_name));
    ELSE_IF _ IS_A ReturnStmt AS return_stmt THEN
      MUTABLE return_stmt_mutable = COPY return_stmt;
      TRY (mIRChecker__check_aggregate_expr_mut(&rtoc_self_view, MIRCheckerAggregateExpr{ Emittable: COPY UNWRAP (return_stmt_mutable.value) }, NIL, alloc_by_name));
    ELSE_IF _ IS_A BreakStmt AS break_stmt THEN
      MUTABLE break_stmt_mutable = COPY break_stmt;
      TRY (mIRChecker__check_aggregate_expr_mut(&rtoc_self_view, MIRCheckerAggregateExpr{ Emittable: COPY UNWRAP (break_stmt_mutable.value) }, NIL, alloc_by_name));
    ELSE_IF _ IS_A ReassignWithCleanup AS reassign_with_cleanup THEN
      MUTABLE reassign_with_cleanup_mutable = COPY reassign_with_cleanup;
      TRY (mIRChecker__check_reassign_cleanup_alloc_mut(&rtoc_self_view, reassign_with_cleanup_mutable, alloc_by_name));
      TRY (mIRChecker__check_aggregate_expr_mut(&rtoc_self_view, MIRCheckerAggregateExpr{ Emittable: COPY reassign_with_cleanup_mutable.value }, reassign_with_cleanup_mutable.alloc, alloc_by_name));
    ELSE_IF _ IS_A ExprStmt AS expr_stmt THEN
      MUTABLE expr_stmt_mutable = COPY expr_stmt;
      TRY (mIRChecker__check_aggregate_expr_mut(&rtoc_self_view, MIRCheckerAggregateExpr{ Emittable: COPY exprStmt__expr(expr_stmt_mutable) }, NIL, alloc_by_name));
    ELSE_IF _ IS_A DiscardOwned AS discard_owned THEN
      MUTABLE discard_owned_mutable = COPY discard_owned;
      TRY (mIRChecker__check_aggregate_expr_mut(&rtoc_self_view, MIRCheckerAggregateExpr{ Emittable: COPY discardOwned__expr(discard_owned_mutable) }, NIL, alloc_by_name));
    ELSE_IF _ IS_A IfStmt AS if_stmt THEN
      MUTABLE if_stmt_mutable = COPY if_stmt;
      TRY (mIRChecker__check_aggregate_expr_mut(&rtoc_self_view, MIRCheckerAggregateExpr{ Emittable: COPY if_stmt_mutable.cond }, NIL, alloc_by_name));
      TRY (mIRChecker__check_aggregate_stmts_mut(&rtoc_self_view, if_stmt_mutable.then_body, alloc_by_name));
      TRY (mIRChecker__check_aggregate_stmts_mut(&rtoc_self_view, (if_stmt_mutable.else_body OR_ELSE List[]), alloc_by_name));
    ELSE_IF _ IS_A WhileStmt AS while_stmt THEN
      MUTABLE while_stmt_mutable = COPY while_stmt;
      TRY (mIRChecker__check_aggregate_expr_mut(&rtoc_self_view, MIRCheckerAggregateExpr{ Emittable: COPY while_stmt_mutable.cond }, NIL, alloc_by_name));
      TRY (mIRChecker__check_aggregate_stmts_mut(&rtoc_self_view, TRY (whileStmt__body(while_stmt_mutable)), alloc_by_name));
    ELSE_IF _ IS_A ForStmt AS for_stmt THEN
      MUTABLE for_stmt_mutable = COPY for_stmt;
      TRY (mIRChecker__check_aggregate_expr_mut(&rtoc_self_view, MIRCheckerAggregateExpr{ Emittable: COPY for_stmt_mutable.iter }, NIL, alloc_by_name));
      TRY (mIRChecker__check_aggregate_stmts_mut(&rtoc_self_view, TRY (forStmt__body(for_stmt_mutable)), alloc_by_name));
    ELSE_IF _ IS_A ScopeBlock AS scope_block THEN
      MUTABLE scope_block_mutable = COPY scope_block;
      TRY (mIRChecker__check_aggregate_stmts_mut(&rtoc_self_view, TRY (scopeBlock__body(scope_block_mutable)), alloc_by_name));
    ELSE_IF _ IS_A MIRBlockExpr AS mir_block_expr THEN
      MUTABLE mir_block_expr_mutable = COPY mir_block_expr;
      TRY (mIRChecker__check_aggregate_stmts_mut(&rtoc_self_view, TRY (blockExpr__body(mir_block_expr_mutable)), alloc_by_name));
    ELSE_IF _ IS_A SwitchStmt AS switch_stmt THEN
      MUTABLE switch_stmt_mutable = COPY switch_stmt;
      TRY (mIRChecker__check_aggregate_expr_mut(&rtoc_self_view, MIRCheckerAggregateExpr{ Emittable: COPY switch_stmt_mutable.subject }, NIL, alloc_by_name));
      IF !((switch_stmt_mutable.arms).empty?()) THEN
            FOR _ IN switch_stmt_mutable.arms DO
            TRY (mIRChecker__check_aggregate_stmts_mut(&rtoc_self_view, _.body, alloc_by_name));
            END
      END
      TRY (mIRChecker__check_aggregate_stmts_mut(&rtoc_self_view, (switch_stmt_mutable.default_body OR_ELSE List[]), alloc_by_name));
    ELSE_IF _ IS_A UnionMatchStmt AS union_match_stmt THEN
      MUTABLE union_match_stmt_mutable = COPY union_match_stmt;
      TRY (mIRChecker__check_aggregate_expr_mut(&rtoc_self_view, MIRCheckerAggregateExpr{ Emittable: COPY union_match_stmt_mutable.subject }, NIL, alloc_by_name));
      IF !((union_match_stmt_mutable.arms).empty?()) THEN
            FOR _ IN union_match_stmt_mutable.arms DO
            TRY (mIRChecker__check_aggregate_stmts_mut(&rtoc_self_view, _.body, alloc_by_name));
            END
      END
      TRY (mIRChecker__check_aggregate_stmts_mut(&rtoc_self_view, (union_match_stmt_mutable.default_body OR_ELSE List[]), alloc_by_name));
    ELSE_IF _ IS_A IfChain AS if_chain THEN
      MUTABLE if_chain_mutable = COPY if_chain;
      IF !((if_chain_mutable.branches).empty?()) THEN
            FOR _ IN if_chain_mutable.branches DO
          TRY (mIRChecker__check_aggregate_expr_mut(&rtoc_self_view, MIRCheckerAggregateExpr{ Emittable: COPY _.cond } NIL, alloc_by_name));
          TRY (mIRChecker__check_aggregate_stmts_mut(&rtoc_self_view, _.body, alloc_by_name));
            END
      END
      TRY (mIRChecker__check_aggregate_stmts_mut(&rtoc_self_view, (if_chain_mutable.default_body OR_ELSE List[]), alloc_by_name));
    END
    END
}
END
PUB FN mIRChecker__check_reassign_cleanup_alloc_mut(MUTABLE self: MIRChecker, stmt: ReassignWithCleanup, alloc_by_name: {String}String@symbol) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE target_alloc: ?String@symbol = COPY alloc_by_name[CAST(stmt.name AS String)];
    IF target_alloc EXISTS AS target_alloc_value THEN
      IF (target_alloc_value == stmt.alloc) THEN
        RETURN;
      END
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :ALLOC_CLEANUP_MISMATCH, Name{ StringValue: COPY CAST(stmt.name AS String) }, "MIR::ReassignWithCleanup frees old value with :${stmt.alloc}, but ${stmt.name} was allocated with :${target_alloc_value}")));
    ELSE
      RETURN;
    END
}
END
PUB FN mIRChecker__check_aggregate_expr_mut(MUTABLE self: MIRChecker, expr: ?MIRCheckerAggregateExpr, owner_alloc: ?String@symbol, alloc_by_name: {String}String@symbol) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF expr EXISTS AS expr_value THEN
      MUTABLE expr_value_mutable = COPY expr_value;
      IF expr_value_mutable IS_A Emittable AS rtoc_expr_node THEN
      IF rtoc_expr_node IS_A MIRCast AS rtoc_mIRCast THEN
        TRY (mIRChecker__check_aggregate_expr_mut(&rtoc_self_view, MIRCheckerAggregateExpr{ Emittable: COPY rtoc_mIRCast.expr } owner_alloc, alloc_by_name));
      ELSE_IF rtoc_expr_node IS_A MakeList AS rtoc_makeList THEN
        MUTABLE list_alloc = rtoc_makeList.alloc;
        IF !((rtoc_makeList.items).empty?()) THEN
                FOR _ IN (rtoc_makeList.items) DO
                TRY (mIRChecker__check_aggregate_expr_mut(&rtoc_self_view, MIRCheckerAggregateExpr{ Emittable: COPY _ } list_alloc, alloc_by_name));
                END
        END
      ELSE_IF rtoc_expr_node IS_A StructInit AS rtoc_structInit THEN
        IF !((rtoc_structInit.fields).empty?()) THEN
                FOR _ IN (rtoc_structInit.fields) DO
            MUTABLE field_alloc: ?String@symbol = (IF mIR__struct_init_field_alloc(_) != NIL THEN mIR__struct_init_field_alloc(_) ELSE owner_alloc END);
            TRY (mIRChecker__check_aggregate_expr_mut(&rtoc_self_view, ruby_wrap_optional_Emittable_MIRCheckerAggregateExpr(mIR__struct_init_field_value(_)), field_alloc, alloc_by_name));
                END
        END
      ELSE_IF rtoc_expr_node IS_A ArrayInit AS rtoc_arrayInit THEN
        IF !((rtoc_arrayInit.items).empty?()) THEN
                FOR _ IN (rtoc_arrayInit.items) DO
                TRY (mIRChecker__check_aggregate_expr_mut(&rtoc_self_view, MIRCheckerAggregateExpr{ Emittable: COPY _ } owner_alloc, alloc_by_name));
                END
        END
      ELSE_IF (rtoc_expr_node IS_A DeepCopy) OR (rtoc_expr_node IS_A RcRetain) OR (rtoc_expr_node IS_A RcDowngrade) OR (rtoc_expr_node IS_A WeakUpgrade) THEN
        RETURN;
      ELSE_IF rtoc_expr_node IS_A Ident AS rtoc_ident THEN
        MUTABLE child_alloc: ?String@symbol = COPY alloc_by_name[rtoc_ident.name];
        IF child_alloc EXISTS AS child_alloc_value THEN
          IF owner_alloc THEN
            IF (child_alloc_value == owner_alloc) THEN
              RETURN;
            END
            &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :AGGREGATE_CHILD_ALLOC_MISMATCH, Name{ StringValue: COPY UNWRAP (emittable__name(rtoc_expr_node)) } "owned child is :${child_alloc_value} but aggregate owner is :${UNWRAP (owner_alloc)}; nested ownership placement is implicit/incoherent")));
          ELSE
            RETURN;
          END
        ELSE
          RETURN;
        END
      ELSE
          FOR _ IN (TRY (emittable__child_exprs(rtoc_expr_node))) DO
          TRY (mIRChecker__check_aggregate_expr_mut(&rtoc_self_view, MIRCheckerAggregateExpr{ Emittable: COPY _ } NIL, alloc_by_name));
        END
      END
      END
      NIL;
    ELSE
      RETURN;
    END
}
END
PUB FN mIRChecker__verify_heap_create_single_indirection_mut(MUTABLE self: MIRChecker, nodes: []Emittable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN nodes DO
      IF _ IS_A HeapCreate AS hc THEN
      MUTABLE zt = COPY hc.zig_type;
      IF !((TRUE AND zt.trimStart().startsWith?("*"))) THEN
          CONTINUE;
      END
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :INDIRECT_DOUBLE_BOX, ruby_wrap_optional_String_Name(rtoc_self_view.fn_name), "HeapCreate cell type is `${zt}` (already a pointer) \u{2014} boxing it yields a double indirection")));
      END
    END
    NIL;
}
END
PUB FN mIRChecker__each_heap_create(self: MIRChecker, nodes: []Emittable, blk: FN(HeapCreate) -> Void) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    FOR _ IN nodes DO
    IF _ IS_A HeapCreate AS heap_create THEN
      blk(heap_create);
    END
    END
    NIL;
}
END
PUB FN mIRChecker__check_program_mut(MUTABLE self: MIRChecker, program: MIRProgram, strict: Bool = FALSE) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (mIRPassState__class_require_mut(PassStateProgram{ MIRProgram: COPY program }, :mir_lowered, "MIRChecker"));
    MUTABLE all_errors: []String = TRY (mIRChecker__ownership_registry_errors(rtoc_self_view));
    FOR _ IN (TRY (mIRChecker__program_functions(rtoc_self_view, program.items))) DO
    ruby_array_concat_String(all_errors, TRY (mIRChecker__check_fn_mut(&rtoc_self_view, _, strict, ( { MUTABLE rtoc_empty_list_31: []String = List[]; rtoc_empty_list_31 } ))));
    END
    IF (all_errors.length() == 0) THEN
      MUTABLE rtoc_mutable_receiver_32 = mIRPassState__for_mut(PassStateProgram{ MIRProgram: COPY program });
      TRY (mIRPassState__mark_mut(&rtoc_mutable_receiver_32, :mir_checked));
    END
    RETURN all_errors;
}
END
PUB FN mIRChecker__program_functions(self: MIRChecker, items: []Emittable) RETURNS ![]FnDef
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE functions: []FnDef = ( { MUTABLE rtoc_empty_list_33: []FnDef = List[]; rtoc_empty_list_33 } );
    FOR _ IN items DO
    IF _ IS_A FnDef AS fn_def THEN
      &functions.append(COPY fn_def);
    ELSE_IF _ IS_A MIRStructDef AS mir_struct_def THEN
      FOR _ IN ((mir_struct_def.methods OR_ELSE List[])) DO
      IF _ IS_A FnDef THEN
        &functions.append(COPY _);
      END
      END
    ELSE_IF _ IS_A ModuleNamespace AS module_namespace THEN
      functions = ruby_array_concat_FnDef(functions, TRY (mIRChecker__program_functions(rtoc_self_view, module_namespace.items)));
    END
    END
    RETURN functions;
}
END
# Ruby walks its own class registry here, asking whether every MIR::Stmt
# subclass is registered and whether any node carrying ownership fields was
# left out -- a self-audit against a table that can drift.
#
# CLEAR has no runtime class registry, and it does not need one: the tables
# this audits are PARTIAL MATCHes over the Emittable union, so a node the
# checker forgot is a compile error, not a runtime finding. The audit is
# discharged statically, so it reports nothing.
PUB FN mIRChecker__ownership_registry_errors(self: MIRChecker) RETURNS ![]String
  REQUIRES self: LOCAL
->
  MUTABLE none: []String = List[];
  RETURN none;
END
PUB FN mIRChecker__owned_return_init?(self: MIRChecker, init: ?Emittable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (IF init? IS_A Call AS call THEN call__owned_return?(call) ELSE FALSE END) THEN
      RETURN TRUE;
    END
    IF init? IS_A ExternTrampoline AS extern_trampoline THEN
      IF extern_trampoline.alloc_kind THEN
        RETURN TRUE;
      END
      MUTABLE return_type = TRY (type__success_type(extern_trampoline.return_type));
      MUTABLE schema: ?TypeSchemaLookupResult = NIL;
      IF rtoc_self_view.schema_lookup EXISTS AS rtoc_lookup THEN
        schema = rtoc_lookup(type__resolved(return_type));
      END
      MUTABLE rtoc_schema_value: ?SchemaValue = NIL;
      IF schema EXISTS AS rtoc_schema THEN
        rtoc_schema_value = castTypeSchemaLookupResultToSchemaValue(rtoc_schema);
      END
      IF schemas__resource?(rtoc_schema_value) THEN
        RETURN TRUE;
      END
    END
    IF init EXISTS AS rtoc_init THEN
      IF ((rtoc_init IS_A InlineBc) OR (rtoc_init IS_A RegistryCall)) THEN
        IF !(TRY (mIRChecker__stdlib_owned_return?(rtoc_self_view, rtoc_init))) THEN
          RETURN FALSE;
        END
        MUTABLE sig: ?FunctionSignature@multiowned = emittable__stdlib_def(rtoc_init);
        IF sig EXISTS AS rtoc_sig THEN
          IF !(TRY (functionSignature__fixed_return?(rtoc_sig))) THEN
            RETURN FALSE;
          END
          MUTABLE ret = functionSignature__return_type(rtoc_sig);
          RETURN !(type__void?(ret));
        ELSE
          RETURN FALSE;
        END
      END
    END
    RETURN FALSE;
}
END
PUB FN mIRChecker__verify_cleanup_sources_own_values_mut(MUTABLE self: MIRChecker, body: []Emittable, cleanups: {String}[]MIRCheckerCleanupMarksByNameValueItem, err_cleanups: {String}[]MIRCheckerCleanupMarksByNameValueItem) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF ((cleanups.count() == 0) AND (err_cleanups.count() == 0)) THEN
      RETURN;
    END
    TRY (mIRChecker__verify_cleanup_sources_in_scope_mut(&rtoc_self_view, body));
}
END
PUB FN mIRChecker__verify_cleanup_sources_in_scope_mut(MUTABLE self: MIRChecker, body: []Emittable) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lets: {String}Let = {};
    MUTABLE materialized_owners: [Set]String = Set[];
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < body.length() DO
      IF !(TRUE) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE rtoc_node = UNWRAP (body[rtoc_idx]);
      IF rtoc_node IS_A Let AS let THEN
          lets[CAST(let.name AS String)] = COPY let;
      END
      IF rtoc_node IS_A OwnedCreate AS owned_create THEN
          &materialized_owners.insert(COPY owned_create.name);
      END
      IF (rtoc_node IS_A Cleanup OR rtoc_node IS_A ErrCleanup) THEN
          MUTABLE let: ?Let = COPY lets[CAST((emittable__name(rtoc_node)) AS String)];
          IF (((let != NIL) AND !(materialized_owners.contains?(CAST((emittable__name(rtoc_node)) AS String)))) AND !(TRY (mIRChecker__cleanup_source_owns_value?(&rtoc_self_view, let, castEmittableToMIRCheckerCleanup(rtoc_node))))) THEN
            &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_CLEANUP_FOR_BORROW, Name{ StringValue: COPY UNWRAP (emittable__name(rtoc_node)) } "Cleanup was emitted for a binding initialized from a borrowed/non-owning expression; MIRChecker cannot prove this binding owns memory")));
          END
      END
      FOR _ IN (emittable__body_slots(rtoc_node)) DO
      TRY (mIRChecker__verify_cleanup_sources_in_scope_mut(&rtoc_self_view, _.body));
      END
    rtoc_idx = rtoc_idx + 1;
    END
    NIL;
}
END
PUB FN mIRChecker__verify_if_bind_capture_cleanup_ownership_mut(MUTABLE self: MIRChecker, nodes: []Emittable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < nodes.length() DO
      IF nodes[rtoc_idx]? IS_A IfBindStmt AS rtoc_node THEN
        MUTABLE cleanup_names = ((rtoc_node.then_body |> SELECT:? (  IF (_ IS_A Cleanup OR _ IS_A ErrCleanup) THEN
            CAST((emittable__name(_)) AS String)
          ELSE
            NIL
          END) |> WHERE _ != NIL)) |> DISTINCT _;
        MUTABLE rtoc_each_items_38 = COPY rtoc_node.bindings;
        MUTABLE rtoc_idx_2 = 0;
        WHILE rtoc_idx_2 < rtoc_each_items_38.length() DO
          MUTABLE rtoc_binding = UNWRAP (rtoc_each_items_38[rtoc_idx_2]);
          MUTABLE capture = COPY CAST(rtoc_binding.capture AS String);
          IF !(cleanup_names.contains?(capture)) THEN
            rtoc_idx_2 = rtoc_idx_2 + 1;
        CONTINUE;
          END
          IF (rtoc_binding.owns_capture == TRUE) THEN
            rtoc_idx_2 = rtoc_idx_2 + 1;
        CONTINUE;
          END
          &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_CLEANUP_FOR_BORROW, Name{ StringValue: COPY capture }, "optional capture cleanup requires owns_capture=true; borrowed collection/field/local captures must remain owned by their source")));
          rtoc_idx_2 = rtoc_idx_2 + 1;
        END
      END
    rtoc_idx = rtoc_idx + 1;
    END
    NIL;
}
END
PUB FN mIRChecker__verify_no_structural_rc_handle_copies_mut(MUTABLE self: MIRChecker, nodes: []Emittable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < nodes.length() DO
      IF !(nodes[rtoc_idx]? IS_A DeepCopy) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE zig_type = COPY CAST((nodes[rtoc_idx]?.zig_type()) AS String);
      IF zig_type.startsWith?("?") THEN
          zig_type = zig_type.substr(1, (zig_type.length() - 1));
      END
      MUTABLE direct_ref_handle = (["CheatLib.Rc(", "CheatLib.Arc(", "CheatLib.WeakRc(", "CheatLib.WeakArc("]) |> ANY zig_type.startsWith?(_);
      IF !(direct_ref_handle) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_STRUCTURAL_RC_COPY, nodes[rtoc_idx]?.zig_type(), "reference-counted handles must be retained, upgraded, or downgraded; MIR::DeepCopy may not structurally duplicate an Rc/Arc handle")));
    rtoc_idx = rtoc_idx + 1;
    END
    NIL;
}
END
PUB FN mIRChecker__cleanup_source_owns_value?(MUTABLE self: MIRChecker, node: Let, cleanup: MIRCheckerCleanup) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE init = mIRChecker__ownership_source_expr(rtoc_self_view, node.init);
    IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_40 = CAST((MATCH cleanup START MIRCheckerCleanup.Cleanup AS item -> item.cleanup_entry, MIRCheckerCleanup.ErrCleanup AS item -> item.cleanup_entry END) AS CleanupEntry);
    cleanupEntry__match_as?(rtoc_local_receiver_40) } THEN
      RETURN TRUE;
    END
    IF (IF init IS_A Lit AS lit THEN (CAST(lit.value AS String) == "null") ELSE FALSE END) THEN
      RETURN TRUE;
    END
    IF TRY (mIRChecker__allocating_expr?(rtoc_self_view, init)) THEN
      RETURN TRUE;
    END
    IF TRY (mIRChecker__value_constructor_expr?(rtoc_self_view, init)) THEN
      RETURN TRUE;
    END
    IF init IS_A ForeignOwnedUnwrap AS foreign_owned_unwrap THEN
      RETURN TRUE;
    END
    IF (TRY (ownershipEffect__of(init))).produces_owned THEN
      RETURN TRUE;
    END
    IF TRY (mIRChecker__owned_return_init?(rtoc_self_view, init)) THEN
      RETURN TRUE;
    END
    IF TRY (mIRChecker__expr_owned_result_alloc(rtoc_self_view, init)) THEN
      RETURN TRUE;
    END
    IF ((TRY (mIRChecker__structural_consumed_names(&rtoc_self_view, Emittable{ Let: COPY node }))).length() > 0) THEN
      RETURN TRUE;
    END
    MUTABLE node_fact: ?OwnershipConsumptionFact = node.ownership_consumption;
    MUTABLE name = operand.name();
    IF (node_fact EXISTS AND (node_fact.operands |> ANY {
    name;
    (!((name == NIL)) AND !(name.empty?()))
    })) THEN
      RETURN TRUE;
    END
    MUTABLE init_fact: ?OwnershipConsumptionFact = emittable__ownership_consumption(init);
    name = operand.name();
    IF (init_fact EXISTS AND (init_fact.operands() |> ANY {
    name;
    (!((name == NIL)) AND !(name.empty?()))
    })) THEN
      RETURN TRUE;
    END
    RETURN FALSE;
}
END
PUB FN mIRChecker__value_constructor_expr?(self: MIRChecker, node: ?Emittable) RETURNS !Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (((((node != NIL) AND (node IS_A StructInit)) OR ((node != NIL) AND (node IS_A TupleLiteral))) OR ((node != NIL) AND (node IS_A ArrayInit))) OR ((node != NIL) AND (node IS_A ArrayDefaultInit))) THEN
      RETURN TRUE;
    END
    IF node? IS_A MIRBlockExpr AS mir_block_expr THEN
      MUTABLE terminal = (TRY (blockExpr__body(mir_block_expr))).reverse() |> FIND (_ IS_A BreakStmt AND (_.label() == mir_block_expr.label));
      IF (terminal IS_A BreakStmt AND terminal.value()) THEN
        RETURN mIRChecker__value_constructor_expr?(rtoc_self_view, terminal.value());
      END
      RETURN FALSE;
    END
    IF node? IS_A MIRMethodCall AS mir_method_call THEN
    IF (["create", "createBound"]).contains?(mir_method_call.method) THEN
        MUTABLE receiver = mir_method_call.receiver;
        RETURN (((receiver IS_A Call AND (["CheatLib.NodeStore", "CheatLib.SharedNodeStore"]).contains?(receiver.callee()))) == TRUE);
      ELSE
        RETURN FALSE;
      END
    ELSE
      RETURN FALSE;
    END
}
END
PUB FN mIRChecker__ownership_source_expr(self: MIRChecker, node: Emittable) RETURNS Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE current: Emittable = COPY node;
    WHILE (respondsTo?(current, "expr") AND ((((current IS_A MIRCast OR current IS_A TryExpr) OR current IS_A TryOptional) OR current IS_A MIROptionalUnwrap))) DO
      current = CAST(current.expr() AS Emittable);
    END
    RETURN current;
}
END
PUB FN mIRChecker__stdlib_owned_return?(self: MIRChecker, node: Emittable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE sig: ?FunctionSignature@multiowned = functionSignature__unwrap(node.stdlib_def());
    IF sig EXISTS AS sig_value THEN
      MUTABLE sig_value_mutable = COPY sig_value;
      MUTABLE ret_type = functionSignature__return_type(sig_value_mutable);
      IF type__resource?(ret_type) THEN
        RETURN TRUE;
      END
      IF !(TRY (functionSignature__emits_allocating?(&sig_value_mutable))) THEN
        RETURN FALSE;
      END
      IF TRY (functionSignature__heap_return_alloc?(&sig_value_mutable)) THEN
        RETURN TRUE;
      END
      MUTABLE metadata: ?InlineAllocMetadata@multiowned = mIRChecker__allocator_metadata_for(rtoc_self_view, MIRCheckerAllocatorMetadataSource{ Emittable: COPY node });
      IF metadata EXISTS AS metadata_value THEN
        RETURN TRY (inlineAllocMetadata__any_heap?(metadata_value));
      ELSE
        RETURN FALSE;
      END
    ELSE
      RETURN FALSE;
    END
}
END
PUB FN mIRChecker__stdlib_owned_fixed_return?(self: MIRChecker, node: Emittable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE sig_branch_value: ?FunctionSignature@multiowned = NIL;
    IF respondsTo?(node, "stdlib_def") THEN
      sig_branch_value = functionSignature__unwrap(node.stdlib_def());
    ELSE
      sig_branch_value = NIL;
    END
    MUTABLE sig: ?FunctionSignature@multiowned = sig_branch_value;
    IF sig EXISTS AS sig_value THEN
      RETURN (TRY (mIRChecker__stdlib_owned_return?(rtoc_self_view, node)) AND TRY (functionSignature__fixed_return?(sig_value)));
    ELSE
      RETURN FALSE;
    END
}
END
PUB FN mIRChecker__verify_owned_return_alloc_marks_mut(MUTABLE self: MIRChecker, lets: []Let, allocs: {String}[]AllocMark) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < lets.length() DO
      MUTABLE marks: ?[]AllocMark = COPY allocs[castNameToString(emittable__name(UNWRAP (lets[rtoc_idx])))];
      IF !(marks) THEN
          &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNED_RETURN_WITHOUT_ALLOC, emittable__name(UNWRAP (lets[rtoc_idx])), "owned-return initializer is heap-provenance but no MIR::AllocMark exists")));
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE mark_allocs = marks |> SELECT _.alloc();
      IF mark_allocs |> ANY placement__frame?(_) THEN
          &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNED_RETURN_ALLOC_NOT_HEAP, emittable__name(UNWRAP (lets[rtoc_idx])), "owned-return initializer is heap-provenance but MIR::AllocMark uses :frame")));
      END
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PUB FN mIRChecker__expr_owned_result_alloc(self: MIRChecker, init: ?Emittable) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE effect = TRY (ownershipEffect__of(init));
    IF !(effect.requires_hoist) THEN
      RETURN NIL;
    END
    RETURN effect.alloc;
}
END
PUB FN mIRChecker__verify_owned_result_alloc_marks_mut(MUTABLE self: MIRChecker, lets: []Let, allocs: {String}[]AllocMark) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR rtoc_key IN lets.group_by(:name).keys() DO
    MUTABLE name_lets: Any = COPY UNWRAP (lets.group_by(:name)[rtoc_key]);
    MUTABLE marks: ?[]AllocMark = COPY allocs[rtoc_key];
    MUTABLE available: []Any = List[];
      IF marks EXISTS AS marks_value THEN
        available = marks_value |> SELECT _.alloc();
      ELSE
        available = ( { MUTABLE rtoc_empty_list_41: []Any = List[]; rtoc_empty_list_41 } );
      END
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < name_lets.length() DO
        MUTABLE expected_alloc: ?String@symbol = TRY (mIRChecker__expr_owned_result_alloc(rtoc_self_view, name_lets[rtoc_idx].init()));
        IF !(expected_alloc) THEN
            rtoc_idx = rtoc_idx + 1;
      CONTINUE;
        END
        IF ((available.length() == 0) AND (((marks == NIL) OR (marks?).empty?()))) THEN
            &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNED_RESULT_WITHOUT_ALLOC, name_lets[rtoc_idx].name(), "owned-result initializer has no MIR::AllocMark; ownership is implicit")));
            rtoc_idx = rtoc_idx + 1;
      CONTINUE;
        END
        MUTABLE idx = available.indexOf(expected_alloc);
        IF idx THEN
            &available.remove(idx);
        ELSE
            &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNED_RESULT_ALLOC_MISMATCH, name_lets[rtoc_idx].name(), "owned-result initializer produces :${UNWRAP (expected_alloc)} storage but no MIR::AllocMark uses :${UNWRAP (expected_alloc)} (marks: ${(marks_value |> SELECT ":${_.alloc()}").join(", ")})")));
        END
      rtoc_idx = rtoc_idx + 1;
    END
    END
    NIL;
}
END
PUB FN mIRChecker__check_fsm_structure_mut(structure: ?FsmStructure, source: ?Locatable = NIL) RETURNS !Void ->
  IF structure EXISTS AS structure_value THEN
    MUTABLE structure_value_mutable = COPY structure_value;
    MUTABLE captures: []FsmCaptureFact = CAST((CAST(structure_value_mutable.captures AS ?[]FsmCaptureFact) OR_ELSE List[]) AS []FsmCaptureFact);
    MUTABLE finalize_cleanups = (structure_value_mutable.finalize_cleanups OR_ELSE List[]);
    MUTABLE steps: []FsmStepFact = CAST((CAST(structure_value_mutable.steps AS ?[]FsmStepFact) OR_ELSE List[]) AS []FsmStepFact);
    FOR _ IN captures DO
    IF !((KEEP _.cleanup_at == :finalize)) THEN
      RAISE Input, FsmStructureError, mIRChecker__format_fsm_error("INV-FSM-CAPTURE-FINALIZE", "capture '${_.name}' has cleanup_at=${compilerInspectValue()}; captures may be read by any step and MUST cleanup at FSM finalize. Cleanup placed in an earlier step fires before later steps run -> UAF.", source);
    END
    END
    FOR _ IN captures DO
    IF !(finalize_cleanups.contains?(_.name)) THEN
      RAISE Input, FsmStructureError, mIRChecker__format_fsm_error("INV-FSM-CAPTURE-CLEANUP-PRESENT", "capture '${_.name}' has no entry in finalize_cleanups; the heap-dupe at spawn would leak.", source);
    END
    END
    TRY (mIRChecker__check_fsm_destroy_actions_mut(TRY (fsmStructure__destroy_actions(structure_value_mutable)), finalize_cleanups, IF structure_value_mutable.ctx_id IS_A Int64 THEN
      structure_value_mutable.ctx_id
    ELSE
      NIL
    END, source));
    MUTABLE cleanup_step_index = {};
    FOR _ IN steps DO
    FOR _ IN _.cleanups DO
    cleanup_step_index[_] = _.index;
    END
    END
    FOR _ IN steps DO
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < _.reads.length() DO
    IF finalize_cleanups.contains?(_.reads[rtoc_idx]?) THEN
      rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    MUTABLE cleanup_step: ?Any = COPY cleanup_step_index[_.reads[rtoc_idx]?];
    IF (cleanup_step == NIL) THEN
          rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    IF (cleanup_step >= _.index) THEN
          rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    RAISE Input, FsmStructureError, mIRChecker__format_fsm_error("INV-FSM-STEP-READS-LIVE", "step ${_.index.toString()} reads '${_.reads[rtoc_idx]?}' but its cleanup was placed in step ${cleanup_step} (earlier). The defer fires before step ${_.index.toString()} runs -> cross-step UAF.", source);
  rtoc_idx = rtoc_idx + 1;
    END
    END
    IF (TRUE AND structure_value_mutable.result_aliases_finalized) THEN
      MUTABLE aliased = structure_value_mutable.result_aliases_finalized;
      RAISE Input, FsmStructureError, mIRChecker__format_fsm_error("INV-FSM-RESULT-NO-FINALIZED-ALIAS", "BG body's terminal expression aliases finalized state field '${aliased}' via the bound local. The slice would escape the FSM via inner.result, but its backing memory is freed when the finalize defer fires at end of last step -> consumer reads a dangling pointer. Either compute a fresh value from the bound local before returning (e.g. wrap in a function call that returns a value type), or drop the FSM templates for this stdlib so the stackful escape-promotion path handles ownership.", source);
    END
    MUTABLE required_guards: []Any = List[];
    IF TRUE THEN
      required_guards = TRY (fsmStructure__required_move_guards(structure_value_mutable));
    ELSE
      required_guards = ( { MUTABLE rtoc_empty_list_42: []Any = List[]; rtoc_empty_list_42 } );
    END
    MUTABLE guard_writes: []Any = List[];
    IF TRUE THEN
      guard_writes = TRY (fsmStructure__move_guard_writes(structure_value_mutable));
    ELSE
      guard_writes = ( { MUTABLE rtoc_empty_list_43: []Any = List[]; rtoc_empty_list_43 } );
    END
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < required_guards.length() DO
    IF guard_writes.contains?(required_guards[rtoc_idx]) THEN
      rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    RAISE Input, FsmStructureError, mIRChecker__format_fsm_error("INV-FSM-TRANSFER-GUARD-WRITTEN", "captured ctx field '${required_guards[rtoc_idx]}' is transferred out of the FSM but no `${required_guards[rtoc_idx]}_moved = true` write is present in the FSM structure. destroyTask would run the finalizer after ownership moved -> double free.", source);
  rtoc_idx = rtoc_idx + 1;
    END
    IF (TRUE AND (structure_value_mutable.owned_result_required != NIL)) THEN
      MUTABLE facts: []Any = List[];
      IF TRUE THEN
        facts = TRY (fsmStructure__ownership_facts(structure_value_mutable));
      ELSE
        facts = ( { MUTABLE rtoc_empty_list_44: []Any = List[]; rtoc_empty_list_44 } );
      END
      MUTABLE result_facts = facts |> WHERE (_.target() == :result);
      IF !((result_facts.length() > 0)) THEN
        RAISE Input, FsmStructureError, mIRChecker__format_fsm_error("INV-FSM-OWNED-RESULT-TRANSFER", "FSM BG returns an owned result but the structure has no result ownership fact. Raw inner.result assignment is unverifiable.", source);
      END
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < result_facts.length() DO
    IF !(result_facts[rtoc_idx].move_guarded()) THEN
      rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    IF guard_writes.contains?(result_facts[rtoc_idx].name()) THEN
            rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    RAISE Input, FsmStructureError, mIRChecker__format_fsm_error("INV-FSM-OWNED-RESULT-GUARD-WRITTEN", "FSM BG transfers owned result '${result_facts[rtoc_idx].name()}' but no matching move guard write is present. The segment-local cleanup would free the value before the promise consumer receives it.", source);
  rtoc_idx = rtoc_idx + 1;
      END
    END
    NIL;
  ELSE
    RETURN;
  END
END
PUB FN mIRChecker__check_fsm_destroy_actions_mut(actions: []FsmDestroyAction, finalize_cleanups: []String, ctx_id: ?Int64, source: ?Locatable) RETURNS !Void ->
  IF ((actions.length() == 0) AND (finalize_cleanups.length() == 0)) THEN
    RETURN;
  END
  IF ctx_id EXISTS AS ctx_id_value THEN
    MUTABLE cleanup_names = actions |> SELECT:? _.cleanup_name() |> WHERE _ != NIL;
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < finalize_cleanups.length() DO
    IF cleanup_names.contains?(finalize_cleanups[rtoc_idx]?) THEN
      rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    RAISE Input, FsmStructureError, mIRChecker__format_fsm_error("INV-FSM-FINALIZE-ACTION-PRESENT", "finalize cleanup '${finalize_cleanups[rtoc_idx]?}' has no structural destroy action.", source);
  rtoc_idx = rtoc_idx + 1;
    END
    FOR _ IN actions DO
    IF _ IS_A FsmDestroyCleanup AS fsm_destroy_cleanup THEN
      TRY (mIRChecker__check_fsm_destroy_cleanup_action_mut(fsm_destroy_cleanup, finalize_cleanups, ctx_id_value, source));
    ELSE_IF _ IS_A FsmDestroyStmt AS fsm_destroy_stmt THEN
      TRY (mIRChecker__check_fsm_destroy_stmt_action_mut(fsm_destroy_stmt, finalize_cleanups, ctx_id_value, source));
    ELSE_IF _ IS_A FsmDestroyLockRelease AS fsm_destroy_lock_release THEN
      TRY (mIRChecker__check_fsm_destroy_lock_action_mut(fsm_destroy_lock_release, ctx_id_value, source));
    END
    END
  ELSE
    RAISE Input, FsmStructureError, mIRChecker__format_fsm_error("INV-FSM-DESTROY-CTX-ID", "FSM finalization records exist but ctx_id is missing; destroyTask targets cannot be verified.", source);
  END
END
PUB FN mIRChecker__check_fsm_destroy_cleanup_action_mut(action: FsmDestroyCleanup, finalize_cleanups: []String, ctx_id: Int64, source: ?Locatable) RETURNS !Void ->
  IF !(valid_fsm_destroy_sources.contains?(action.source_kind)) THEN
    RAISE Input, FsmStructureError, mIRChecker__format_fsm_error("INV-FSM-DESTROY-SOURCE", "destroy cleanup '${action.name}' has unknown source ${compilerInspectValue()}.", source);
  END
  MUTABLE expected_target = "__ctx_${ctx_id.toString()}.${action.name}";
  MUTABLE target_text = mIRChecker__fsm_destroy_expr_label(action.target);
  IF !(mIRChecker__fsm_ctx_field_target?(action.target, ctx_id, action.name)) THEN
    RAISE Input, FsmStructureError, mIRChecker__format_fsm_error("INV-FSM-DESTROY-TARGET", "destroy cleanup '${action.name}' targets ${compilerInspectValue()}; expected ${compilerInspectValue()}.", source);
  END
  IF !(finalize_cleanups.contains?(action.name)) THEN
    RAISE Input, FsmStructureError, mIRChecker__format_fsm_error("INV-FSM-DESTROY-FINALIZE-LIST", "destroy cleanup '${action.name}' is not listed in finalize_cleanups.", source);
  END
  MUTABLE entry = COPY KEEP action.cleanup_entry;
  IF !(cleanupEntry__needs_cleanup?(entry)) THEN
    RAISE Input, FsmStructureError, mIRChecker__format_fsm_error("INV-FSM-DESTROY-CLEANUP-ENTRY", "destroy cleanup '${action.name}' has a no-cleanup entry.", source);
  END
  IF !(([:heap, :frame]).contains?(cleanupEntry__alloc(entry))) THEN
    RAISE Input, FsmStructureError, mIRChecker__format_fsm_error("INV-FSM-DESTROY-ALLOC", "destroy cleanup '${action.name}' uses invalid allocator ${compilerInspectValue()}.", source);
  END
  IF (cleanupEntry__kind(entry) == :resource) THEN
    MUTABLE close_plan: ?ResourceClosePlan = cleanupEntry__resource_close_plan(entry);
    IF !(((close_plan != NIL) AND !(resourceClosePlan__empty?(close_plan)))) THEN
      RAISE Input, FsmStructureError, mIRChecker__format_fsm_error("INV-FSM-DESTROY-RESOURCE-PLAN", "resource cleanup '${action.name}' must carry at least one close action.", source);
    END
  END
  TRY (mIRChecker__check_fsm_destroy_optional_expr_mut("guard", action.name, action.guard, source));
  TRY (mIRChecker__check_fsm_destroy_optional_expr_mut("allocator", action.name, action.allocator, source));
END
PUB FN mIRChecker__check_fsm_destroy_stmt_action_mut(action: FsmDestroyStmt, finalize_cleanups: []String, ctx_id: Int64, source: ?Locatable) RETURNS !Void ->
  IF !(valid_fsm_destroy_sources.contains?(action.source_kind)) THEN
    RAISE Input, FsmStructureError, mIRChecker__format_fsm_error("INV-FSM-DESTROY-SOURCE", "destroy statement '${action.name}' has unknown source ${compilerInspectValue()}.", source);
  END
  MUTABLE expected_target = "__ctx_${ctx_id.toString()}.${action.name}";
  IF !((fsmDestroyStmt__ctx_cleanup_target_name(action) == expected_target)) THEN
    RAISE Input, FsmStructureError, mIRChecker__format_fsm_error("INV-FSM-DESTROY-TARGET", "destroy statement '${action.name}' targets ${compilerInspectValue()}; expected ${compilerInspectValue()}.", source);
  END
  IF !(finalize_cleanups.contains?(action.name)) THEN
    RAISE Input, FsmStructureError, mIRChecker__format_fsm_error("INV-FSM-DESTROY-FINALIZE-LIST", "destroy statement '${action.name}' is not listed in finalize_cleanups.", source);
  END
END
PUB FN mIRChecker__check_fsm_destroy_lock_action_mut(action: FsmDestroyLockRelease, ctx_id: Int64, source: ?Locatable) RETURNS !Void ->
  IF !((action.ctx_id == ctx_id)) THEN
    RAISE Input, FsmStructureError, mIRChecker__format_fsm_error("INV-FSM-DESTROY-LOCK-TARGET", "lock destroy action '${action.name}' targets ctx ${action.ctx_id.toString()}, expected ctx ${ctx_id.toString()}.", source);
  END
  IF !((action.guard_index >= 0)) THEN
    RAISE Input, FsmStructureError, mIRChecker__format_fsm_error("INV-FSM-DESTROY-LOCK-GUARD", "lock destroy action '${action.name}' uses invalid guard index ${compilerInspectValue()}.", source);
  END
  IF !(valid_fsm_unlock_methods.contains?(action.unlock_method)) THEN
    RAISE Input, FsmStructureError, mIRChecker__format_fsm_error("INV-FSM-DESTROY-LOCK-METHOD", "lock destroy action '${action.name}' uses unknown unlock method ${compilerInspectValue()}.", source);
  END
END
PUB FN mIRChecker__check_fsm_destroy_optional_expr_mut(kind: String, name: String, value: ?Emittable, source: ?Locatable) RETURNS !Void ->
  IF value EXISTS AS value_value THEN
    TRY (mIRChecker__check_fsm_destroy_required_expr_mut(kind, name, value_value, source));
  ELSE
    RETURN;
  END
END
PUB FN mIRChecker__check_fsm_destroy_required_expr_mut(kind: String, name: String, value: Emittable, source: ?Locatable) RETURNS !Void ->
  IF !(mIRChecker__fsm_destroy_field_path?(value)) THEN
    RAISE Input, FsmStructureError, mIRChecker__format_fsm_error("INV-FSM-DESTROY-ZIG-FIELD", "destroy ${kind} for '${name}' must be a single expression field, got ${compilerInspectValue()}.", source);
  END
END
PUB FN mIRChecker__fsm_destroy_field_path?(expr: Emittable) RETURNS Bool ->
  RETURN !((mIRChecker__fsm_destroy_expr_path(expr) == NIL));
END
PUB FN mIRChecker__fsm_destroy_expr_label(expr: Emittable) RETURNS String ->
  IF mIRChecker__fsm_destroy_expr_path(expr) != NIL THEN
  RETURN (mIRChecker__fsm_destroy_expr_path(expr))?;
  ELSE
  RETURN COPY emittable__variant_name(expr);
  END
END
PUB FN mIRChecker__fsm_destroy_expr_path(expr: Emittable) RETURNS ?String EFFECTS REENTRANT ->
  IF expr IS_A Ident AS ident THEN
    MUTABLE segment = COPY CAST(ident.name AS String);
    IF mIRChecker__fsm_destroy_field_segment?(segment) THEN
      RETURN segment;
    ELSE
      RETURN NIL;
    END
  ELSE_IF expr IS_A FieldGet AS field_get THEN
    MUTABLE object = COPY field_get.object;
    IF !(TRUE) THEN
      RETURN NIL;
    END
    MUTABLE object_path: ?String = mIRChecker__fsm_destroy_expr_path(object);
    MUTABLE field = COPY field_get.field;
    IF object_path EXISTS AS object_path_value THEN
      IF mIRChecker__fsm_destroy_field_segment?(field) THEN
        RETURN "${object_path_value}.${field}";
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
  ELSE
    RETURN NIL;
  END
END
PUB FN mIRChecker__fsm_destroy_field_segment?(segment: String) RETURNS Bool ->
  IF (segment.length() == 0) THEN
    RETURN FALSE;
  END
  MUTABLE bytes: []Int64 = segment.bytes();
  MUTABLE first = UNWRAP (bytes[0]);
  IF !(mIRChecker__fsm_destroy_field_segment_head_byte?(first)) THEN
    RETURN FALSE;
  END
  RETURN (bytes |> SKIP 1) |> ALL mIRChecker__fsm_destroy_field_segment_tail_byte?(_);
END
PUB FN mIRChecker__fsm_destroy_field_segment_head_byte?(byte: Int64) RETURNS Bool ->
  RETURN (((byte == 95) OR (((byte >= 65) AND (byte <= 90)))) OR (((byte >= 97) AND (byte <= 122))));
END
PUB FN mIRChecker__fsm_destroy_field_segment_tail_byte?(byte: Int64) RETURNS Bool ->
  RETURN (mIRChecker__fsm_destroy_field_segment_head_byte?(byte) OR (((byte >= 48) AND (byte <= 57))));
END
PUB FN mIRChecker__fsm_ctx_field_target?(expr: Emittable, ctx_id: Int64, field: String) RETURNS Bool ->
  IF expr IS_A FieldGet AS field_get THEN
    IF !((field_get.field == field)) THEN
      RETURN FALSE;
    END
    MUTABLE object = COPY field_get.object;
    RETURN (IF object IS_A Ident AS ident THEN (CAST(ident.name AS String) == "__ctx_${ctx_id.toString()}") ELSE FALSE END);
  ELSE
    RETURN FALSE;
  END
END
PUB FN mIRChecker__format_fsm_error(invariant: String, message: String, source: ?Locatable) RETURNS String ->
  MUTABLE loc: String = "";
  IF source EXISTS AS source_value THEN
    IF source_value.line() THEN
    loc = " at line ${source.line()}";
  ELSE
    loc = "";
  END
  END
  RETURN "[FSM checker]${loc} ${invariant}: ${message}";
END
PRIVATE FN mIRChecker__allocator_metadata_node?(self: MIRChecker, node: Emittable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE metadata: ?InlineAllocMetadata@multiowned = mIRChecker__allocator_metadata_for(rtoc_self_view, MIRCheckerAllocatorMetadataSource{ Emittable: COPY node });
    RETURN ((metadata != NIL) AND !(inlineAllocMetadata__empty?(metadata)));
}
END
PRIVATE FN mIRChecker__allocator_metadata_for(self: MIRChecker, node: MIRCheckerAllocatorMetadataSource) RETURNS ?InlineAllocMetadata@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE carrier: ?MIRCheckerAllocatorMetadataCarrier = mIRChecker__allocator_metadata_carrier(rtoc_self_view, node);
    IF carrier IS_A RegistryCall AS registry_call THEN
      MUTABLE rtoc_owned_return_45: ?InlineAllocMetadata@multiowned = KEEP registry_call.allocs;
      RETURN rtoc_owned_return_45;
    ELSE_IF carrier IS_A IndexedStore AS indexed_store THEN
      MUTABLE rtoc_owned_return_46: ?InlineAllocMetadata@multiowned = KEEP indexed_store.allocs;
      RETURN rtoc_owned_return_46;
    ELSE_IF carrier IS_A ShardedMapPut AS sharded_map_put THEN
      MUTABLE rtoc_owned_return_47: ?InlineAllocMetadata@multiowned = sharded_map_put.resolved_allocs;
      RETURN rtoc_owned_return_47;
    ELSE_IF carrier IS_A ShardedMapGet AS sharded_map_get THEN
      MUTABLE rtoc_owned_return_48: ?InlineAllocMetadata@multiowned = sharded_map_get.resolved_allocs;
      RETURN rtoc_owned_return_48;
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN mIRChecker__allocator_metadata_carrier(self: MIRChecker, node: MIRCheckerAllocatorMetadataSource) RETURNS ?MIRCheckerAllocatorMetadataCarrier
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (node IS_A RegistryCall) OR (node IS_A IndexedStore) OR (node IS_A ShardedMapPut) OR (node IS_A ShardedMapGet) THEN
      RETURN COPY node;
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN mIRChecker__allocator_metadata_target(self: MIRChecker, node: MIRCheckerAllocatorMetadataSource) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE carrier: ?MIRCheckerAllocatorMetadataCarrier = mIRChecker__allocator_metadata_carrier(rtoc_self_view, node);
    IF carrier IS_A RegistryCall AS registry_call THEN
      MUTABLE target: ?String = COPY registry_call.target_var;
      IF ((target != NIL) AND !((target.length() == 0))) THEN
        RETURN COPY target;
      END
    ELSE_IF carrier IS_A IndexedStore AS indexed_store THEN
      MUTABLE target: ?String = COPY indexed_store.target_var;
      IF ((target != NIL) AND !((target.length() == 0))) THEN
        RETURN COPY target;
      END
      MUTABLE target_expr = COPY indexed_store.target;
      IF target_expr IS_A Ident AS ident THEN
        RETURN COPY CAST(ident.name AS String);
      END
    ELSE_IF carrier IS_A ShardedMapPut AS sharded_map_put THEN
      MUTABLE target: ?String = COPY sharded_map_put.target_var;
      IF ((target != NIL) AND !((target.length() == 0))) THEN
        RETURN COPY target;
      END
      MUTABLE target_expr = COPY sharded_map_put.target;
      IF target_expr IS_A Ident AS ident THEN
        RETURN COPY CAST(ident.name AS String);
      END
    ELSE_IF carrier IS_A ShardedMapGet AS sharded_map_get THEN
      MUTABLE target_expr = COPY sharded_map_get.target;
      IF target_expr IS_A Ident AS ident THEN
        RETURN COPY CAST(ident.name AS String);
      END
    END
    RETURN NIL;
}
END
PRIVATE FN mIRChecker__allocator_metadata_label(self: MIRChecker, node: MIRCheckerAllocatorMetadataSource) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE target: ?String = mIRChecker__allocator_metadata_target(rtoc_self_view, node);
    IF target EXISTS AS target_value THEN
      RETURN COPY target_value;
    END
    MUTABLE reason = IF node IS_A RegistryCall THEN
      node.reason()
    ELSE
      NIL
    END;
    IF reason THEN
      RETURN COPY CAST(reason AS String);
    ELSE
      RETURN COPY emittable__variant_name(node);
    END
}
END
PRIVATE FN mIRChecker__verify_allocator_closed_set_mut(MUTABLE self: MIRChecker, allocs: {String}[]AllocMark, cleanups: {String}[]MIRCheckerCleanupMarksByNameValueItem, metadata_nodes: []Emittable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR rtoc_key IN allocs.keys() DO
    MUTABLE marks: []AllocMark = COPY UNWRAP (allocs[rtoc_key]);
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < marks.length() DO
      IF valid_allocators.contains?(marks[rtoc_idx]?.alloc) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :INVALID_ALLOCATOR_MARK, Name{ StringValue: COPY rtoc_key }, "AllocMark uses ${compilerInspectValue()}; MIR allocator facts must be :heap or :frame")));
    rtoc_idx = rtoc_idx + 1;
    END
    END
    FOR rtoc_key IN allocs.keys() DO
    MUTABLE marks: []AllocMark = COPY UNWRAP (allocs[rtoc_key]);
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < marks.length() DO
      MUTABLE scope: ?String@symbol = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_50 = marks[rtoc_idx]?;
      cleanupEntry__scope(rtoc_local_receiver_50) };
      IF valid_alloc_scopes.contains?(scope) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :INVALID_ALLOCATOR_MARK, Name{ StringValue: COPY rtoc_key }, "AllocMark has scope ${compilerInspectValue()}; MIR allocation lifetime must be :heap, :function, or :iteration")));
    rtoc_idx = rtoc_idx + 1;
    END
    END
    FOR rtoc_key IN cleanups.keys() DO
    MUTABLE nodes: []MIRCheckerCleanupMarksByNameValueItem = COPY UNWRAP (cleanups[rtoc_key]);
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < nodes.length() DO
      MUTABLE alloc = (MATCH nodes[rtoc_idx]? START MIRCheckerCleanupMarksByNameValueItem.Cleanup AS item -> item.cleanup_entry.alloc(), MIRCheckerCleanupMarksByNameValueItem.ErrCleanup AS item -> item.cleanup_entry.alloc() END);
      IF valid_allocators.contains?(alloc) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :INVALID_ALLOCATOR_MARK, Name{ StringValue: COPY rtoc_key }, "${(nodes[rtoc_idx]?.class()).name()} uses ${compilerInspectValue()}; MIR cleanup allocators must be :heap or :frame")));
    rtoc_idx = rtoc_idx + 1;
    END
    END
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < metadata_nodes.length() DO
      MUTABLE metadata: ?InlineAllocMetadata@multiowned = mIRChecker__allocator_metadata_for(rtoc_self_view, MIRCheckerAllocatorMetadataSource{ Emittable: COPY metadata_nodes[rtoc_idx]? });
      IF !(((metadata != NIL) AND !(inlineAllocMetadata__empty?(metadata)))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      inlineAllocMetadata__each(metadata, %(alloc_key: String@symbol, alloc: String@symbol) USE(rtoc_idx, rtoc_self_view) -> {
        IF valid_allocators.contains?(alloc) THEN
            RETURN;
        END
        &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :INVALID_ALLOCATOR_MARK, Name{ StringValue: COPY mIRChecker__allocator_metadata_label(rtoc_self_view, MIRCheckerAllocatorMetadataSource{ Emittable: COPY metadata_nodes[rtoc_idx]? }) }, "allocator metadata ${alloc_key} uses ${compilerInspectValue()}; MIR allocator metadata must be :heap or :frame")));
        rubyToClearVoid()
      });
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PRIVATE FN mIRChecker__verify_allocator_metadata_targets_mut(MUTABLE self: MIRChecker, metadata_nodes: []Emittable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < metadata_nodes.length() DO
      MUTABLE metadata: ?InlineAllocMetadata@multiowned = mIRChecker__allocator_metadata_for(rtoc_self_view, MIRCheckerAllocatorMetadataSource{ Emittable: COPY metadata_nodes[rtoc_idx]? });
      IF !(((metadata != NIL) AND !(inlineAllocMetadata__empty?(metadata)))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE target: ?String = mIRChecker__allocator_metadata_target(rtoc_self_view, MIRCheckerAllocatorMetadataSource{ Emittable: COPY metadata_nodes[rtoc_idx]? });
      IF ((target != NIL) AND !((target.length() == 0))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :INLINE_ALLOC_WITHOUT_TARGET, Name{ StringValue: COPY mIRChecker__allocator_metadata_label(rtoc_self_view, MIRCheckerAllocatorMetadataSource{ Emittable: COPY metadata_nodes[rtoc_idx]? }) }, "${(metadata_nodes[rtoc_idx]?.class()).name()} has allocator metadata ${inlineAllocMetadata__inspect(metadata)} but no target binding; allocator use is not checker-verifiable against binding placement")));
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PRIVATE FN mIRChecker__walk_mir(self: MIRChecker, stmts: ?NodeRoot, block: FN(Emittable) -> Void) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    TRY (mIR__each_node(UNWRAP (stmts), block));
    NIL;
}
END
PRIVATE FN mIRChecker__walk_mir_node(self: MIRChecker, node: ?NodeRoot, block: FN(Emittable) -> Void) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((((node != NIL) AND (node IS_A Emittable)) OR ((node != NIL) AND (node IS_A Emittable[])))) THEN
      RETURN;
    END
    TRY (mIR__each_node(UNWRAP (node), block));
    NIL;
}
END
PRIVATE FN mIRChecker__walk_mir_expr(self: MIRChecker, expr: ?NodeRoot, block: FN(Emittable) -> Void) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    TRY (mIRChecker__walk_mir_node(rtoc_self_view, expr, block));
    NIL;
}
END
PRIVATE FN mIRChecker__scan_expr_for_hpt_leak_mut(self: MIRChecker, node: ?Emittable, MUTABLE leaks: []String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node EXISTS AS node_value THEN
      mIR__each_surface_node(NodeRoot{ Emittable: COPY node_value }, %(expr: Emittable) USE(MUTABLE leaks, rtoc_self_view) -> {
    MUTABLE effect = TRY (ownershipEffect__of(expr));
    IF effect.produces_owned THEN
          &leaks.append(TRY (mIRChecker__error(rtoc_self_view, :HPT_LEAK, Name{ StringValue: COPY mIRChecker__ownership_effect_label(rtoc_self_view, expr) }, "owned-result expression not bound to variable (leak)")));
          RETURN;
    END
    IF TRY (mIRChecker__stdlib_owned_fixed_return?(rtoc_self_view, expr)) THEN
          MUTABLE sig: ?FunctionSignature@multiowned = functionSignature__unwrap(expr.stdlib_def());
          MUTABLE ret = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_51 = UNWRAP (sig);
          functionSignature__return_type(rtoc_local_receiver_51) };
          IF !(type__void?(ret)) THEN
            &leaks.append(TRY (mIRChecker__error(rtoc_self_view, :HPT_LEAK, Name{ StringValue: COPY mIRChecker__ownership_effect_label(rtoc_self_view, expr) }, "stdlib call with allocates:true result not bound to variable (leak)")));
          END
    END
    rubyToClearVoid()
      });
      NIL;
    ELSE
      RETURN;
    END
}
END
PRIVATE FN mIRChecker__ownership_effect_label(self: MIRChecker, node: Emittable) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A Call AS call THEN
      RETURN COPY call.callee;
    ELSE_IF node IS_A MIRMethodCall AS mir_method_call THEN
      RETURN COPY mir_method_call.method;
    ELSE_IF node IS_A RegistryCall AS registry_call THEN
      RETURN COPY registry_call.reason;
    ELSE
      RETURN COPY emittable__variant_name(node);
    END
}
END
PRIVATE FN mIRChecker__verify_allocator_metadata_contracts_mut(MUTABLE self: MIRChecker, metadata_nodes: []Emittable, allocs: {String}[]AllocMark, fn_def: FnDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE param_names: [Set]String = fn_def.params |> REDUCE(Set[]) {
    MUTABLE name = COPY _.name;
    &acc.insert(name);
    IF name.startsWith?("_m_") THEN
        &acc.insert(name.deletePrefix("_m_"));
    END
    acc
    };
    IF rtoc_self_view.captured_names EXISTS AS captured_names_value THEN
      param_names = (param_names BIT_OR captured_names_value);
    END
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < metadata_nodes.length() DO
      MUTABLE alloc_metadata: ?InlineAllocMetadata@multiowned = mIRChecker__allocator_metadata_for(rtoc_self_view, MIRCheckerAllocatorMetadataSource{ Emittable: COPY metadata_nodes[rtoc_idx]? });
      IF !(((alloc_metadata != NIL) AND !(inlineAllocMetadata__empty?(alloc_metadata)))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE target: ?String = mIRChecker__allocator_metadata_target(rtoc_self_view, MIRCheckerAllocatorMetadataSource{ Emittable: COPY metadata_nodes[rtoc_idx]? });
      IF !(((target != NIL) AND !((target.length() == 0)))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE requires_target_alloc = inlineAllocMetadata__requires_target_alloc?(alloc_metadata);
      IF !(allocs.contains?(target)) THEN
          IF param_names.contains?((target OR_ELSE "")) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
          END
          IF !(requires_target_alloc) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
          END
          &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :INLINE_ALLOC_WITHOUT_ALLOCMARK, ruby_wrap_optional_String_Name(target), "${(metadata_nodes[rtoc_idx]?.class()).name()} has allocator metadata ${inlineAllocMetadata__inspect(alloc_metadata)} for '${target}' but no MIR::AllocMark")));
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE container_alloc = (UNWRAP (allocs[UNWRAP (target)])).first().alloc();
      IF inlineAllocMetadata__primary(alloc_metadata) THEN
          MUTABLE op_alloc: ?String@symbol = inlineAllocMetadata__primary(alloc_metadata);
          IF (op_alloc != container_alloc) THEN
            &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :INLINE_ALLOC_MISMATCH, ruby_wrap_optional_String_Name(target), "operation uses :${UNWRAP (op_alloc)} but container '${target}' is :${container_alloc}")));
          END
      END
      MUTABLE rtoc_each_items_52 = ([InlineStoredAllocCheck{ label: :key_alloc, alloc: COPY inlineAllocMetadata__key_alloc(alloc_metadata) }, InlineStoredAllocCheck{ label: :val_alloc, alloc: COPY inlineAllocMetadata__value_alloc(alloc_metadata) }]);
      MUTABLE rtoc_idx_2 = 0;
      WHILE rtoc_idx_2 < rtoc_each_items_52.length() DO
          MUTABLE stored_alloc = COPY UNWRAP (rtoc_each_items_52[rtoc_idx_2]).alloc;
          IF !(stored_alloc) THEN
              rtoc_idx_2 = rtoc_idx_2 + 1;
        CONTINUE;
          END
          IF (placement__explicit_frame?(stored_alloc) AND placement__explicit_heap?(container_alloc)) THEN
              &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :INLINE_ALLOC_MISMATCH, ruby_wrap_optional_String_Name(target), "${UNWRAP (rtoc_each_items_52[rtoc_idx_2]).label} is :frame but container '${target}' is :heap (stored data will dangle after frame rewind)")));
          END
        rtoc_idx_2 = rtoc_idx_2 + 1;
      END
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PRIVATE FN mIRChecker__verify_cross_frame_param_alloc_mut(MUTABLE self: MIRChecker, metadata_nodes: []Emittable, fn_def: FnDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (FALSE OR (fn_def.params.length() == 0)) THEN
      RETURN;
    END
    MUTABLE pointer_passed = fn_def.params |> REDUCE(Set[]) {
    IF (TRUE AND _.pointer_passed) THEN
        &acc.insert(COPY _.name);
    END
    acc
    };
    IF pointer_passed.empty?() THEN
      RETURN;
    END
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < metadata_nodes.length() DO
      MUTABLE metadata: ?InlineAllocMetadata@multiowned = mIRChecker__allocator_metadata_for(rtoc_self_view, MIRCheckerAllocatorMetadataSource{ Emittable: COPY metadata_nodes[rtoc_idx]? });
      IF !(((metadata != NIL) AND !(inlineAllocMetadata__empty?(metadata)))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE target = COPY (mIRChecker__allocator_metadata_target(rtoc_self_view, MIRCheckerAllocatorMetadataSource{ Emittable: COPY metadata_nodes[rtoc_idx]? }) OR_ELSE "");
      IF !(pointer_passed.contains?(target)) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      inlineAllocMetadata__each(metadata, %(alloc_key: String@symbol, alloc_sym: String@symbol) USE(target, rtoc_self_view) -> {
        IF !((alloc_sym == :frame)) THEN
            RETURN;
        END
        &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :CROSS_FRAME_PARAM_ALLOC, Name{ StringValue: COPY target }, "operation ${alloc_key} is :frame but '${target}' is a pointer-passed parameter (lifetime extends past this function's frame mark; buffer would dangle on return). Use :heap.")));
        rubyToClearVoid()
      });
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PRIVATE FN mIRChecker__verify_alloc_cleanup_match_mut(MUTABLE self: MIRChecker, allocs: {String}[]AllocMark, cleanups: {String}[]MIRCheckerCleanupMarksByNameValueItem, errdefer_destroy_names: [Set]String = Set[], transfers: [Set]String = Set[]) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR rtoc_key IN allocs.keys() DO
    MUTABLE alloc_marks: []AllocMark = COPY UNWRAP (allocs[rtoc_key]);
    IF !(cleanups.contains?(rtoc_key)) THEN
      CONTINUE;
    END
    MUTABLE alloc_sym = COPY (UNWRAP (alloc_marks.first())).alloc;
    MUTABLE cleanup_sym = (UNWRAP (cleanups[rtoc_key])).first().cleanup_entry().alloc();
    IF (alloc_sym != cleanup_sym) THEN
        &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :ALLOC_CLEANUP_MISMATCH, Name{ StringValue: COPY rtoc_key }, "allocated with :${alloc_sym} but cleanup uses :${cleanup_sym}")));
    END
    MUTABLE ti = COPY (UNWRAP (alloc_marks.first())).type_info;
    IF ti THEN
        MUTABLE no_caps = (((!(type__any_sync?(ti)) AND !(type__multiowned?(ti))) AND !(type__shared?(ti))) AND !(TRY (type__heap_ptr?(ti))));
        IF (no_caps AND ((type__primitive?(ti) OR type__id_handle?(ti)))) THEN
          &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :COPY_CLEANUP, Name{ StringValue: COPY rtoc_key }, "cleanup emitted for value type ${ti} (primitive or Id<T>) that can never own heap memory -- needs_explicit_cleanup? or visit_CopyNode missed the gate")));
        END
    END
    END
    FOR rtoc_key IN cleanups.keys() DO
    MUTABLE ignored_cleanup_nodes: []MIRCheckerCleanupMarksByNameValueItem = COPY UNWRAP (cleanups[rtoc_key]);
    IF allocs.contains?(rtoc_key) THEN
      CONTINUE;
    END
    &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :CLEANUP_WITHOUT_ALLOC, Name{ StringValue: COPY rtoc_key }, "MIR::Cleanup present but no MIR::AllocMark (allocation event missing from MIR)")));
    END
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < transfers.length() DO
      IF allocs.contains?(transfers[rtoc_idx]) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :TRANSFER_WITHOUT_ALLOC, transfers[rtoc_idx], "MIR::TransferMark present but no MIR::AllocMark (transfer event missing allocation source)")));
    rtoc_idx = rtoc_idx + 1;
    END
    FOR rtoc_key IN allocs.keys() DO
    MUTABLE alloc_marks: []AllocMark = COPY UNWRAP (allocs[rtoc_key]);
    IF cleanups.contains?(rtoc_key) THEN
      CONTINUE;
    END
    IF errdefer_destroy_names.contains?(rtoc_key) THEN
        CONTINUE;
    END
    IF transfers.contains?(rtoc_key) THEN
        CONTINUE;
    END
    IF alloc_marks |> ALL placement__frame?(_.alloc) THEN
        CONTINUE;
    END
    &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :ALLOC_WITHOUT_CLEANUP, Name{ StringValue: COPY rtoc_key }, "AllocMark with no Cleanup, ErrCleanup, ErrDeferStmt(DestroyPtr), or TransferMark -- leaked allocation")));
    END
    NIL;
}
END
PRIVATE FN mIRChecker__verify_cleanup_required_finalizers_mut(MUTABLE self: MIRChecker, allocs: {String}[]AllocMark, cleanups: {String}[]MIRCheckerCleanupMarksByNameValueItem, errdefer_destroy_names: [Set]String, transfers: [Set]String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR rtoc_key IN allocs.keys() DO
    MUTABLE marks: []AllocMark = COPY UNWRAP (allocs[rtoc_key]);
    IF cleanups.contains?(rtoc_key) THEN
      CONTINUE;
    END
    IF errdefer_destroy_names.contains?(rtoc_key) THEN
        CONTINUE;
    END
    IF transfers.contains?(rtoc_key) THEN
        CONTINUE;
    END
    MUTABLE required_mark: ?AllocMark = marks |> FIND TRY (mIRChecker__alloc_mark_type_requires_finalizer?(rtoc_self_view, _));
    IF !(required_mark) THEN
        CONTINUE;
    END
    &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :CLEANUP_REQUIRED_WITHOUT_FINALIZER, Name{ StringValue: COPY rtoc_key }, "AllocMark type ${required_mark.type_info} requires cleanup, but no Cleanup, ErrCleanup, ErrDeferStmt(DestroyPtr), or TransferMark closes the ownership path")));
    END
    NIL;
}
END
PRIVATE FN mIRChecker__alloc_mark_type_requires_finalizer?(self: MIRChecker, mark: AllocMark) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE ti = COPY mark.type_info;
    IF type__untyped?(ti) THEN
      RETURN FALSE;
    END
    IF (type__rodata?(ti) OR type__borrowed_reference?(ti)) THEN
      RETURN FALSE;
    END
    RETURN TRY (type__needs_cleanup?(ti, rtoc_self_view.schema_lookup));
}
CATCH Transient, Input, System, NotFound, Permission, Canceled
  RETURN FALSE;
END
PRIVATE FN mIRChecker__verify_call_contracts_mut(MUTABLE self: MIRChecker, nodes: []Emittable, transfers: [Set]String, allocs: {String}[]AllocMark) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN nodes DO
    IF _ IS_A Call AS call THEN
      MUTABLE call_mutable = COPY call;
      TRY (mIRChecker__verify_callable_contract_mut(&rtoc_self_view, call_mutable.callable_contract, call_mutable.callee, "MIR::Call", transfers, allocs));
    ELSE_IF _ IS_A RuntimeCall AS runtime_call THEN
      MUTABLE runtime_call_mutable = COPY runtime_call;
      TRY (mIRChecker__verify_callable_contract_mut(&rtoc_self_view, KEEP runtime_call_mutable.spec.callable_contract, runtime_call_mutable.spec.callee, "MIR::RuntimeCall", transfers, allocs));
    ELSE_IF _ IS_A TailCall AS tail_call THEN
      MUTABLE tail_call_mutable = COPY tail_call;
      TRY (mIRChecker__verify_callable_contract_mut(&rtoc_self_view, tail_call_mutable.callable_contract, tail_call_mutable.callee, "MIR::TailCall", transfers, allocs));
    ELSE_IF _ IS_A MIRMethodCall AS mir_method_call THEN
      MUTABLE mir_method_call_mutable = COPY mir_method_call;
      TRY (mIRChecker__verify_callable_contract_mut(&rtoc_self_view, mir_method_call_mutable.callable_contract, mir_method_call_mutable.method, "MIR::MethodCall", transfers, allocs));
    END
    END
    NIL;
}
END
PRIVATE FN mIRChecker__verify_callable_contract_mut(MUTABLE self: MIRChecker, contract: ?CallableContract, label: String, node_kind: String, transfers: [Set]String, allocs: {String}[]AllocMark) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !((contract != NIL)) THEN
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :MIR_CALL_NO_CONTRACT, Name{ StringValue: COPY label }, "${node_kind} has no typed callable/effect contract; argument ownership is unverifiable")));
      RETURN;
    END
    MUTABLE sig = COPY contract.signature;
    IF !(TRUE) THEN
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :MIR_CALL_NO_CONTRACT, Name{ StringValue: COPY label }, "${node_kind} callable contract does not carry a FunctionSignature")));
      RETURN;
    END
    MUTABLE ownership = COPY contract.ownership_contract;
    IF !(TRUE) THEN
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :IMPLICIT_OWNERSHIP_TRANSFER, Name{ StringValue: COPY label }, "${node_kind} callable contract has no typed ownership contract")));
      RETURN;
    END
    IF ((TRY (functionSignature__params(sig))).length() < contract.checked_arg_count) THEN
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :MIR_CALL_NO_CONTRACT, Name{ StringValue: COPY label }, "${node_kind} callable contract covers ${(TRY (functionSignature__params(sig))).length()} params but callsite has ${contract.checked_arg_count.toString()} args")));
    END
    IF (TRY (mIRChecker__function_signature_takes_ownership?(rtoc_self_view, sig, contract.checked_arg_count)) AND !(ownership.covers_consuming_params)) THEN
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :IMPLICIT_OWNERSHIP_TRANSFER, Name{ StringValue: COPY label }, "${node_kind} target declares TAKES/consuming params but concrete consumed bindings are absent")));
    END
    TRY (mIRChecker__verify_ownership_contract_operands_mut(&rtoc_self_view, ownership, "${node_kind} ownership_contract", transfers, TRY (mIRChecker__function_signature_takes_ownership?(rtoc_self_view, sig, contract.checked_arg_count))));
    TRY (mIRChecker__check_consumed_allocators_match_sink_mut(&rtoc_self_view, MIRCheckerAllocatorMetadataSource{ CallableContractMultiowned: COPY UNWRAP (contract) }, TRY (ownershipContract__owned_operand_names(ownership)), allocs));
    NIL;
}
END
PRIVATE FN mIRChecker__verify_ownership_contract_operands_mut(MUTABLE self: MIRChecker, contract: OwnershipContract, label: String, transfers: [Set]String, require_operands: Bool = FALSE) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (contract.operands.length() == 0) THEN
      IF require_operands THEN
        &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_CONSUMPTION_OPERAND_MISSING, Name{ StringValue: COPY label }, "${label} covers a consuming call but has no operand provenance")));
      END
      RETURN;
    END
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < contract.operands.length() DO
      IF (contract.operands[rtoc_idx]?.kind == :non_owning) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF contract.operands[rtoc_idx]?.borrowed THEN
          IF require_operands THEN
            &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_CONSUMPTION_BORROWED_OPERAND, Name{ StringValue: COPY (contract.operands[rtoc_idx]?.name OR_ELSE label) }, "${label} tries to consume borrowed operand from ${contract.operands[rtoc_idx]?.source}")));
          END
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE name: ?String = COPY contract.operands[rtoc_idx]?.name;
      IF ((name == NIL) OR ((name?).length() == 0)) THEN
          &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_CONSUMPTION_OPERAND_MISSING, Name{ StringValue: COPY label }, "${label} has an ownership operand with no tracked binding")));
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !(transfers.contains?(name)) THEN
          &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_CONTRACT_WITHOUT_TRANSFER, ruby_wrap_optional_String_Name(name), "${label} consumes '${(name OR_ELSE "")}' but no MIR::TransferMark exists for that binding")));
      END
    rtoc_idx = rtoc_idx + 1;
    END
    NIL;
}
END
PRIVATE FN mIRChecker__function_signature_takes_ownership?(self: MIRChecker, sig: FunctionSignature, checked_arg_count: Int64) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (TRY (functionSignature__params(sig))).first(checked_arg_count) |> ANY (respondsTo?(_, "takes") AND _.takes());
}
END
PRIVATE FN mIRChecker__verify_explicit_ownership_contracts_mut(MUTABLE self: MIRChecker, nodes: []Emittable, transfers: [Set]String, allocs: {String}[]AllocMark) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < nodes.length() DO
      IF !(respondsTo?(nodes[rtoc_idx]?, "ownership_contract")) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE contract = nodes[rtoc_idx]?.ownership_contract();
      IF !((mIRChecker__stdlib_takes_ownership?(rtoc_self_view, nodes[rtoc_idx]?) OR (contract IS_A OwnershipContract@multiowned AND !(contract.empty?())))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !(contract IS_A OwnershipContract@multiowned) THEN
          &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :IMPLICIT_OWNERSHIP_TRANSFER, Name{ StringValue: COPY mIRChecker__ownership_node_name(rtoc_self_view, nodes[rtoc_idx]?) }, "ownership_contract must be MIR::OwnershipContract; Hash/nil contracts make ownership unverifiable")));
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE consumes = TRY (mIRChecker__ownership_contract_consumes(rtoc_self_view, contract));
      IF (mIRChecker__stdlib_takes_ownership?(rtoc_self_view, nodes[rtoc_idx]?) AND !(mIRChecker__ownership_contract_present?(rtoc_self_view, contract))) THEN
          &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :IMPLICIT_OWNERSHIP_TRANSFER, Name{ StringValue: COPY mIRChecker__ownership_node_name(rtoc_self_view, nodes[rtoc_idx]?) }, "stdlib_def declares a TAKES/consuming parameter but ownership_contract is absent; MIRChecker cannot prove whether this call consumes an owned binding")));
      END
      TRY (mIRChecker__verify_ownership_contract_operands_mut(&rtoc_self_view, contract, "ownership_contract", transfers, mIRChecker__stdlib_takes_ownership?(rtoc_self_view, nodes[rtoc_idx]?)));
      TRY (mIRChecker__check_consumed_allocators_match_sink_mut(&rtoc_self_view, MIRCheckerAllocatorMetadataSource{ Emittable: COPY nodes[rtoc_idx]? }, consumes, allocs));
    rtoc_idx = rtoc_idx + 1;
    END
    NIL;
}
END
PRIVATE FN mIRChecker__verify_ownership_surfaces_finalized_mut(MUTABLE self: MIRChecker, nodes: []Emittable, facts: []Emittable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE facts_seen = !((facts.length() == 0));
    MUTABLE fact_sources: [Set]String = Set[];
    FOR _ IN facts DO
    MUTABLE source: ?String = mIRChecker__ownership_fact_source(rtoc_self_view, _);
    IF source EXISTS AS source_value THEN
        &fact_sources.insert(source_value);
    END
    END
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < nodes.length() DO
    IF nodes[rtoc_idx]? IS_A Call AS call THEN
        IF !((call__owned_return?(call) OR TRY (mIRChecker__callable_contract_consumes?(rtoc_self_view, call.callable_contract)))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
        END
        IF (facts_seen AND mIRChecker__ownership_fact_covers_node?(rtoc_self_view, fact_sources, Emittable{ Call: COPY call })) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
        END
        &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_FACT_REQUIRED, Name{ StringValue: COPY call.callee }, "MIR::Call carries ownership through owned_return/callable_contract. Finalize call ownership into OwnedCreate/OwnedTransfer/OwnedReturn facts.")));
    ELSE_IF nodes[rtoc_idx]? IS_A RuntimeCall AS runtime_call THEN
        IF !((runtimeCall__owned_return?(runtime_call) OR TRY (mIRChecker__callable_contract_consumes?(rtoc_self_view, KEEP runtime_call.spec.callable_contract)))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
        END
        IF (facts_seen AND mIRChecker__ownership_fact_covers_node?(rtoc_self_view, fact_sources, Emittable{ RuntimeCall: COPY runtime_call })) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
        END
        &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_FACT_REQUIRED, Name{ StringValue: COPY runtime_call.spec.callee }, "MIR::RuntimeCall carries ownership through owned_return/callable_contract. Finalize call ownership into OwnedCreate/OwnedTransfer/OwnedReturn facts.")));
    ELSE_IF nodes[rtoc_idx]? IS_A MIRMethodCall AS mir_method_call THEN
        IF !(((mir_method_call.owned_result_alloc != NIL) OR TRY (mIRChecker__callable_contract_consumes?(rtoc_self_view, mir_method_call.callable_contract)))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
        END
        IF (facts_seen AND mIRChecker__ownership_fact_covers_node?(rtoc_self_view, fact_sources, Emittable{ MIRMethodCall: COPY mir_method_call })) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
        END
        &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_FACT_REQUIRED, Name{ StringValue: COPY mir_method_call.method }, "MIR::MethodCall carries ownership through owned_result_alloc/callable_contract. Finalize method ownership into OwnedCreate/OwnedTransfer/OwnedStore facts.")));
    ELSE_IF nodes[rtoc_idx]? IS_A RegistryCall AS registry_call THEN
        IF !(TRY (mIRChecker__registry_ownership_side_channel?(rtoc_self_view, MIRCheckerRegistryOwnershipNode{ RegistryCall: COPY registry_call }))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
        END
        IF (mIRChecker__stdlib_takes_ownership?(rtoc_self_view, Emittable{ RegistryCall: COPY registry_call }) AND mIRChecker__ownership_surface_has_no_owned_operands?(rtoc_self_view, MIRCheckerOwnershipSurfaceNode{ RegistryCall: COPY registry_call })) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
        END
        IF (facts_seen AND mIRChecker__ownership_fact_covers_node?(rtoc_self_view, fact_sources, Emittable{ RegistryCall: COPY registry_call })) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
        END
        &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_FACT_REQUIRED, Name{ StringValue: COPY mIRChecker__ownership_node_name(rtoc_self_view, Emittable{ RegistryCall: COPY registry_call }) }, "${registry_call.class().name()} carries allocator or ownership effects through registry metadata. Finalize it into Owned* facts before MIRChecker.")));
    ELSE_IF nodes[rtoc_idx]? IS_A IndexedStore AS indexed_store THEN
        IF !(TRY (mIRChecker__registry_ownership_side_channel?(rtoc_self_view, MIRCheckerRegistryOwnershipNode{ IndexedStore: COPY indexed_store }))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
        END
        IF (mIRChecker__stdlib_takes_ownership?(rtoc_self_view, Emittable{ IndexedStore: COPY indexed_store }) AND mIRChecker__ownership_surface_has_no_owned_operands?(rtoc_self_view, MIRCheckerOwnershipSurfaceNode{ IndexedStore: COPY indexed_store })) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
        END
        IF (facts_seen AND mIRChecker__ownership_fact_covers_node?(rtoc_self_view, fact_sources, Emittable{ IndexedStore: COPY indexed_store })) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
        END
        &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_FACT_REQUIRED, Name{ StringValue: COPY mIRChecker__ownership_node_name(rtoc_self_view, Emittable{ IndexedStore: COPY indexed_store }) }, "${indexed_store.class().name()} carries allocator or ownership effects through registry metadata. Finalize it into Owned* facts before MIRChecker.")));
    ELSE_IF nodes[rtoc_idx]? IS_A ShardedMapPut AS sharded_map_put THEN
        IF !(mIRChecker__stdlib_takes_ownership?(rtoc_self_view, Emittable{ ShardedMapPut: COPY sharded_map_put })) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
        END
        IF mIRChecker__ownership_consumption_has_no_owned_operands?(rtoc_self_view, Emittable{ ShardedMapPut: COPY sharded_map_put }) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
        END
        IF (facts_seen AND mIRChecker__ownership_fact_covers_node?(rtoc_self_view, fact_sources, Emittable{ ShardedMapPut: COPY sharded_map_put })) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
        END
        &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_FACT_REQUIRED, Name{ StringValue: COPY mIRChecker__ownership_node_name(rtoc_self_view, Emittable{ ShardedMapPut: COPY sharded_map_put }) }, "${sharded_map_put.class().name()} consumes or replaces owned data through node-specific fields. Finalize the store/reassign into OwnedStore/OwnedTransfer/OwnedDestroy facts.")));
    ELSE_IF nodes[rtoc_idx]? IS_A ReassignWithCleanup AS reassign_with_cleanup THEN
        IF !(mIRChecker__stdlib_takes_ownership?(rtoc_self_view, Emittable{ ReassignWithCleanup: COPY reassign_with_cleanup })) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
        END
        IF mIRChecker__ownership_consumption_has_no_owned_operands?(rtoc_self_view, Emittable{ ReassignWithCleanup: COPY reassign_with_cleanup }) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
        END
        IF (facts_seen AND mIRChecker__ownership_fact_covers_node?(rtoc_self_view, fact_sources, Emittable{ ReassignWithCleanup: COPY reassign_with_cleanup })) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
        END
        &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_FACT_REQUIRED, Name{ StringValue: COPY mIRChecker__ownership_node_name(rtoc_self_view, Emittable{ ReassignWithCleanup: COPY reassign_with_cleanup }) }, "${reassign_with_cleanup.class().name()} consumes or replaces owned data through node-specific fields. Finalize the store/reassign into OwnedStore/OwnedTransfer/OwnedDestroy facts.")));
    ELSE_IF nodes[rtoc_idx]? IS_A MIRBgBlock AS mir_bg_block THEN
        IF (facts_seen AND mIRChecker__ownership_fact_covers_node?(rtoc_self_view, fact_sources, Emittable{ MIRBgBlock: COPY mir_bg_block })) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
        END
        &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :OWNERSHIP_FACT_REQUIRED, Name{ StringValue: COPY mIRChecker__ownership_node_name(rtoc_self_view, Emittable{ MIRBgBlock: COPY mir_bg_block }) }, "MIR::BgBlock creates/captures promise-owned state across an execution boundary. Finalize BG ownership into OwnedCreate/OwnedTransfer/OwnedReturn/OwnedDestroy facts.")));
    END
    rtoc_idx = rtoc_idx + 1;
    END
    NIL;
}
END
PRIVATE FN mIRChecker__verify_execution_boundary_facts_mut(MUTABLE self: MIRChecker, nodes: []Emittable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < nodes.length() DO
    IF nodes[rtoc_idx]? IS_A MIRBgBlock AS mir_bg_block THEN
        MUTABLE mir_bg_block_mutable = COPY mir_bg_block;
        TRY (mIRChecker__verify_execution_boundary_fact_mut(&rtoc_self_view, bgBlock__boundary_fact(&mir_bg_block_mutable), "MIR::BgBlock"));
        IF (((!(mir_bg_block_mutable.run_body) OR (mir_bg_block_mutable.run_body.length() == 0))) AND !(mir_bg_block_mutable.fsm_structure)) THEN
          &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :BOUNDARY_FACT_REQUIRED, Name{ StringValue: COPY "MIR::BgBlock" }, "FSM-consumed BG body has no typed FsmStructure; rendered execution-boundary code is unverifiable")));
        END
        IF mir_bg_block_mutable.fsm_structure THEN
          TRY (mIRChecker__check_fsm_structure_mut(castOptionalEmittableToOptionalFsmStructure(mir_bg_block_mutable.fsm_structure)));
        END
    ELSE_IF nodes[rtoc_idx]? IS_A StreamSpawn AS stream_spawn THEN
        MUTABLE stream_spawn_mutable = COPY stream_spawn;
        TRY (mIRChecker__verify_execution_boundary_fact_mut(&rtoc_self_view, streamSpawn__boundary_fact(&stream_spawn_mutable), "MIR::StreamSpawn"));
    ELSE_IF nodes[rtoc_idx]? IS_A MIRDoBlock AS mir_do_block THEN
        MUTABLE mir_do_block_mutable = COPY mir_do_block;
        MUTABLE facts = COPY TRY (doBlock__boundary_facts(mir_do_block_mutable));
        IF !((TRUE AND (facts |> ALL TRUE))) THEN
          &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :BOUNDARY_FACT_REQUIRED, Name{ StringValue: COPY "MIR::DoBlock" }, "MIR::DoBlock has no typed ExecutionBoundaryFact array for its branches")));
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
        END
        MUTABLE expected: Int64 = 0;
        IF mir_do_block_mutable.branch_bodies != NIL THEN
          expected = ((mir_do_block_mutable.branch_bodies)?).length();
        END
        IF (facts.length() != expected) THEN
          &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :BOUNDARY_FACT_REQUIRED, Name{ StringValue: COPY "MIR::DoBlock" }, "MIR::DoBlock has ${facts.length()} boundary facts for ${expected.toString()} branch bodies")));
        END
        FOR _ IN facts DO
        TRY (mIRChecker__verify_execution_boundary_fact_mut(&rtoc_self_view, _, "MIR::DoBlock"));
        END
    END
    rtoc_idx = rtoc_idx + 1;
    END
    NIL;
}
END
PRIVATE FN mIRChecker__verify_execution_boundary_fact_mut(MUTABLE self: MIRChecker, fact: ?ExecutionBoundaryFact, label: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF fact EXISTS AS fact_value THEN
      IF !(([:bg, :bg_stream, :do_branch, :stream_spawn]).contains?(fact_value.kind)) THEN
        &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :BOUNDARY_FACT_REQUIRED, Name{ StringValue: COPY label }, "${label} has invalid boundary kind ${compilerInspectValue()}")));
      END
      IF !(([:local, :pinned, :parallel]).contains?(fact_value.dispatch)) THEN
        &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :BOUNDARY_FACT_REQUIRED, Name{ StringValue: COPY label }, "${label} has invalid boundary dispatch ${compilerInspectValue()}")));
      END
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < fact_value.captures.length() DO
      IF !((fact_value.dispatch == :parallel)) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF fact_value.captures[rtoc_idx]?.parallel_safe THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE reason = (fact_value.captures[rtoc_idx]?.forbidden_reason OR_ELSE :not_parallel_safe);
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :BOUNDARY_CAPTURE_NOT_PARALLEL_SAFE, Name{ StringValue: COPY fact_value.captures[rtoc_idx]?.name }, "capture '${fact_value.captures[rtoc_idx]?.name}' is not safe for @parallel dispatch (storage=${compilerInspectValue()}, sync=${compilerInspectValue()}, reason=${compilerInspectValue()})")));
    rtoc_idx = rtoc_idx + 1;
      END
      NIL;
    ELSE
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :BOUNDARY_FACT_REQUIRED, Name{ StringValue: COPY label }, "${label} has no typed ExecutionBoundaryFact")));
      RETURN;
    END
}
END
PRIVATE FN mIRChecker__callable_contract_consumes?(self: MIRChecker, contract: ?CallableContract) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((contract != NIL)) THEN
      RETURN FALSE;
    END
    RETURN !(((TRY (mIRChecker__ownership_contract_consumes(rtoc_self_view, contract.ownership_contract))).length() == 0));
}
END
PRIVATE FN mIRChecker__registry_ownership_side_channel?(self: MIRChecker, node: MIRCheckerRegistryOwnershipNode) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE sig: ?FunctionSignature@multiowned = functionSignature__unwrap(node.stdlib_def());
    IF mIRChecker__stdlib_takes_ownership?(rtoc_self_view, castMIRCheckerRegistryOwnershipNodeToEmittable(node)) THEN
      IF mIRChecker__ownership_surface_has_no_owned_operands?(rtoc_self_view, castMIRCheckerRegistryOwnershipNodeToMIRCheckerOwnershipSurfaceNode(node)) THEN
        RETURN FALSE;
      END
      RETURN TRUE;
    END
    MUTABLE contract: OwnershipContract@multiowned = NIL;
    MATCH node START
      MIRCheckerRegistryOwnershipNode.RegistryCall AS item ->
        contract = COPY item.ownership_contract;,
      MIRCheckerRegistryOwnershipNode.IndexedStore AS item ->
        contract = COPY item.ownership_contract;,
    END
    IF (TRUE AND !(ownershipContract__empty?(&contract))) THEN
      RETURN TRUE;
    END
    IF (IF node IS_A RegistryCall AS registry_call THEN (registry_call.owned_result_alloc != NIL) ELSE FALSE END) THEN
      RETURN TRUE;
    END
    IF node.mutating_receiver_allocator_op?() THEN
      RETURN FALSE;
    END
    IF sig EXISTS AS sig_value THEN
      MUTABLE sig_value_mutable = COPY sig_value;
      RETURN ((TRY (functionSignature__emits_allocating?(&sig_value_mutable)) == TRUE) AND type__void?(functionSignature__return_type(sig_value_mutable)));
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN mIRChecker__ownership_fact_covers_node?(self: MIRChecker, fact_sources: [Set]String, node: Emittable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF respondsTo?(node, "ownership_consumption") THEN
    IF node.ownership_consumption() IS_A OwnershipConsumptionFact THEN
      RETURN TRUE;
    END
    END
    RETURN fact_sources.contains?(mIRChecker__ownership_node_name(rtoc_self_view, node));
}
END
PRIVATE FN mIRChecker__ownership_fact_source(self: MIRChecker, fact: Emittable) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF fact IS_A OwnedCreate AS owned_create THEN
      RETURN COPY owned_create.source;
    ELSE_IF fact IS_A OwnedDestroy AS owned_destroy THEN
      RETURN COPY owned_destroy.source;
    ELSE_IF fact IS_A OwnedTransfer AS owned_transfer THEN
      RETURN COPY CAST(owned_transfer.source AS String);
    ELSE_IF fact IS_A OwnedBorrow AS owned_borrow THEN
      RETURN COPY CAST(owned_borrow.source AS String);
    ELSE_IF fact IS_A OwnedStore AS owned_store THEN
      RETURN COPY owned_store.source;
    ELSE_IF fact IS_A OwnedReturn AS owned_return THEN
      RETURN COPY CAST(owned_return.source AS String);
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN mIRChecker__check_consumed_allocators_match_sink_mut(MUTABLE self: MIRChecker, node: MIRCheckerAllocatorMetadataSource, consumes: []String, allocs: {String}[]AllocMark) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (consumes.length() == 0) THEN
      RETURN;
    END
    MUTABLE sink_alloc: ?String@symbol = (IF mIRChecker__allocator_metadata_for(rtoc_self_view, node) != NIL THEN
      { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_53 = (mIRChecker__allocator_metadata_for(rtoc_self_view, node));
    inlineAllocMetadata__sink_alloc(rtoc_local_receiver_53) }
    ELSE
      NIL
    END);
    IF sink_alloc EXISTS AS sink_alloc_value THEN
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < consumes.length() DO
      MUTABLE mark = (IF allocs[consumes[rtoc_idx]?] != NIL THEN
            (allocs[consumes[rtoc_idx]?]).first()
          ELSE
            NIL
          END);
      IF !(mark) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF (mark.alloc() == sink_alloc_value) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :AGGREGATE_CHILD_ALLOC_MISMATCH, Name{ StringValue: COPY consumes[rtoc_idx]? }, "ownership_contract consumes :${(UNWRAP (mark)).alloc} binding '${consumes[rtoc_idx]?}' into :${sink_alloc_value} sink; owned transfer allocator is incoherent")));
    rtoc_idx = rtoc_idx + 1;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN mIRChecker__ownership_consumption_has_no_owned_operands?(self: MIRChecker, node: Emittable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fact = node.ownership_consumption();
    IF !(fact EXISTS) THEN
      RETURN FALSE;
    END
    RETURN { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_54 = (UNWRAP (fact)).operands;
    cleanupEntry__none?(rtoc_local_receiver_54, %(operand) -> ((operand.kind() == :owned_binding) AND operand.name())) };
}
END
PRIVATE FN mIRChecker__ownership_contract_has_no_owned_operands?(self: MIRChecker, node: MIRCheckerOwnershipSurfaceNode) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE contract = PARTIAL MATCH node START
      MIRCheckerOwnershipSurfaceNode.RegistryCall AS registry_call -> KEEP registry_call.ownership_contract,
      MIRCheckerOwnershipSurfaceNode.IndexedStore AS indexed_store -> KEEP indexed_store.ownership_contract,
      DEFAULT -> NIL
    END;
    IF !(contract IS_A OwnershipContract@multiowned) THEN
      RETURN FALSE;
    END
    RETURN { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_55 = contract.operands();
    cleanupEntry__none?(rtoc_local_receiver_55, %(operand) -> ((operand.kind() == :owned_binding) AND operand.name())) };
}
END
PRIVATE FN mIRChecker__ownership_surface_has_no_owned_operands?(self: MIRChecker, node: MIRCheckerOwnershipSurfaceNode) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (mIRChecker__ownership_consumption_has_no_owned_operands?(rtoc_self_view, castMIRCheckerOwnershipSurfaceNodeToEmittable(node)) OR mIRChecker__ownership_contract_has_no_owned_operands?(rtoc_self_view, node));
}
END
PRIVATE FN mIRChecker__stdlib_takes_ownership?(self: MIRChecker, node: Emittable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A ReassignWithCleanup AS reassign_with_cleanup THEN
      RETURN TRUE;
    END
    MUTABLE sig = emittable__stdlib_def(node);
    IF !(sig) THEN
      RETURN FALSE;
    END
    MUTABLE params = emittable__params(sig);
    IF (respondsTo?(params, "any?") AND (params |> ANY (respondsTo?(_, "takes") AND _.takes()))) THEN
      RETURN TRUE;
    END
    RETURN sig.takes_ownership?();
}
END
PRIVATE FN mIRChecker__ownership_contract_consumes(self: MIRChecker, contract: OwnershipContract) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (ownershipContract__owned_operand_names(contract));
}
END
PRIVATE FN mIRChecker__ownership_contract_present?(self: MIRChecker, contract: OwnershipContract) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (!(ownershipContract__empty?(&contract)) OR contract.covers_consuming_params);
}
END
PRIVATE FN mIRChecker__ownership_node_name(self: MIRChecker, node: Emittable) RETURNS String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (node IS_A MIRCast OR node IS_A TryExpr) THEN
      RETURN mIRChecker__ownership_node_name(rtoc_self_view, node.expr());
    END
    MUTABLE target = PARTIAL MATCH node START
      Emittable.RegistryCall AS registry_call -> registry_call.target_var,
      Emittable.IndexedStore AS indexed_store -> indexed_store.target_var,
      Emittable.ShardedMapPut AS sharded_map_put -> sharded_map_put.target_var,
      DEFAULT -> NIL
    END;
    IF target THEN
      RETURN COPY CAST(target AS String);
    END
    IF node IS_A RuntimeCall AS runtime_call THEN
      RETURN COPY runtime_call.spec.callee;
    END
    IF (node IS_A Call OR node IS_A TailCall) THEN
      RETURN COPY CAST(node.callee() AS String);
    END
    IF node IS_A MIRMethodCall AS mir_method_call THEN
      RETURN COPY mir_method_call.method;
    END
    IF node IS_A MIRBgBlock AS mir_bg_block THEN
      RETURN "MIR::BgBlock";
    END
    IF node IS_A StreamSpawn AS stream_spawn THEN
      RETURN "MIR::StreamSpawn";
    END
    MUTABLE reason = PARTIAL MATCH node START
      Emittable.RegistryCall AS registry_call -> registry_call.reason,
      Emittable.Noop AS noop -> noop.reason,
      DEFAULT -> NIL
    END;
    IF reason THEN
      RETURN COPY CAST(reason AS String);
    ELSE
      RETURN COPY emittable__variant_name(node);
    END
}
END
PRIVATE FN mIRChecker__verify_frame_rewind_mut(MUTABLE self: MIRChecker, body: []Emittable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    mIRChecker__each_frame_rewind_node(rtoc_self_view, NodeRoot{ ArrayValue: COPY body }, %(stmt: Emittable) USE(rtoc_self_view) -> {
    IF !((stmt IS_A WhileStmt OR stmt IS_A ForStmt)) THEN
        RETURN;
    END
    MUTABLE has_restore = TRY (mIRChecker__body_has_loop_restore?(rtoc_self_view, stmt.body()));
    IF (!(stmt.tight()) AND !(has_restore)) THEN
        IF TRY (mIRChecker__body_has_iteration_frame_alloc?(rtoc_self_view, stmt.body())) THEN
          MUTABLE allocations = TRY (mIRChecker__iteration_frame_alloc_summary(rtoc_self_view, stmt.body()));
          &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :FRAME_NO_REWIND, ruby_wrap_optional_String_Name(rtoc_self_view.fn_name), "loop body has iteration-scoped frame allocations but no restoreLoopMark defer (allocations: ${allocations})")));
        END
    ELSE_IF has_restore THEN
        IF TRY (mIRChecker__body_has_non_iteration_frame_alloc?(rtoc_self_view, stmt.body())) THEN
          &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :FRAME_NO_REWIND, ruby_wrap_optional_String_Name(rtoc_self_view.fn_name), "loop restore encloses frame allocations not scoped to one iteration")));
        END
    END
    rubyToClearVoid()
    });
}
END
PRIVATE FN mIRChecker__each_frame_rewind_node(self: MIRChecker, root: ?NodeRoot, block: FN(Emittable) -> Void) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    TRY (mIR__each_node_until(UNWRAP (root), %(node) USE(rtoc_self_view) -> mIRChecker__frame_rewind_boundary?(rtoc_self_view, node), block));
}
END
PRIVATE FN mIRChecker__frame_rewind_boundary?(self: MIRChecker, node: Emittable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (node IS_A MIRBgBlock OR node IS_A LambdaExpr);
}
END
PRIVATE FN mIRChecker__body_has_loop_restore?(self: MIRChecker, stmts: []Emittable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE found: Bool = FALSE;
    mIRChecker__each_loop_local_node(rtoc_self_view, NodeRoot{ ArrayValue: COPY stmts }, %(node: Emittable) -> {
    IF !(node IS_A MIRDeferStmt) THEN
        RETURN;
    END
    MUTABLE body = node.body();
    IF (body IS_A MIRMethodCall AND (body.method() == "restoreLoopMark")) THEN
        found = TRUE;
    END
    rubyToClearVoid()
    });
    RETURN found;
}
END
PRIVATE FN mIRChecker__body_has_iteration_frame_alloc?(self: MIRChecker, stmts: ?NodeRoot) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (mIRChecker__body_has_frame_alloc_scope?(rtoc_self_view, stmts, %(scope: String@symbol) -> (scope == :iteration)));
}
END
PRIVATE FN mIRChecker__body_has_non_iteration_frame_alloc?(self: MIRChecker, stmts: ?NodeRoot) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (mIRChecker__body_has_frame_alloc_scope?(rtoc_self_view, stmts, %(scope: String@symbol) -> (scope != :iteration)));
}
END
PRIVATE FN mIRChecker__iteration_frame_alloc_summary(self: MIRChecker, stmts: ?NodeRoot) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE allocations: []String = ( { MUTABLE rtoc_empty_list_56: []String = List[]; rtoc_empty_list_56 } );
    mIRChecker__each_loop_local_node(rtoc_self_view, stmts, %(node: Emittable) USE(MUTABLE allocations) -> {
    IF !(node IS_A AllocMark) THEN
        RETURN;
    END
    IF !((placement__frame?(node.alloc()) AND (cleanupEntry__scope(node) == :iteration))) THEN
        RETURN;
    END
    MUTABLE line: ?Int64 = emittable__source_line(node);
    &allocations.append((IF line THEN
        "${node.name()}@${line}"
      ELSE
        CAST(node.name() AS String)
      END));
    rubyToClearVoid()
    });
    RETURN (CAST((allocations |> DISTINCT _) AS []String)).join(", ");
}
END
PRIVATE FN mIRChecker__body_has_frame_alloc_scope?(self: MIRChecker, stmts: ?NodeRoot, block: FN(String@symbol) -> Bool) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE found: Bool = FALSE;
    mIRChecker__each_loop_local_node(rtoc_self_view, stmts, %(node: Emittable) USE(block) -> {
    IF !(node IS_A AllocMark) THEN
        RETURN;
    END
    MUTABLE alloc = node.alloc();
    IF !(placement__frame?(alloc)) THEN
        RETURN;
    END
    MUTABLE scope = cleanupEntry__scope(node);
    scope = IF scope IS_A String@symbol THEN
        scope
      ELSE
        :unknown
      END;
    found = (found OR block(scope));
    rubyToClearVoid()
    });
    RETURN found;
}
END
PRIVATE FN mIRChecker__each_loop_local_node(self: MIRChecker, root: ?NodeRoot, block: FN(Emittable) -> Void) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    TRY (mIR__each_node_until(UNWRAP (root), %(node) USE(rtoc_self_view) -> mIRChecker__loop_local_boundary?(rtoc_self_view, node), block));
}
END
PRIVATE FN mIRChecker__loop_local_boundary?(self: MIRChecker, node: Emittable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (((node IS_A WhileStmt OR node IS_A ForStmt) OR node IS_A MIRBgBlock) OR node IS_A LambdaExpr);
}
END
PRIVATE FN mIRChecker__expr_has_frame_alloc?(self: MIRChecker, expr: ?Emittable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF expr EXISTS AS expr_value THEN
      MUTABLE metadata: ?InlineAllocMetadata@multiowned = mIRChecker__allocator_metadata_for(rtoc_self_view, MIRCheckerAllocatorMetadataSource{ Emittable: COPY expr_value });
      IF ((metadata != NIL) AND !(inlineAllocMetadata__empty?(metadata))) THEN
        IF (IF expr_value IS_A ShardedMapPut AS sharded_map_put THEN shardedMapPut__mutating_receiver_allocator_op?(sharded_map_put) ELSE FALSE END) THEN
          RETURN FALSE;
        END
        RETURN TRY (inlineAllocMetadata__any_frame?(metadata));
      END
      RETURN PARTIAL MATCH expr_value START
        Emittable.DupeSlice AS dupe_slice -> placement__frame?(dupe_slice.alloc),
        Emittable.ConcatStr AS concat_str -> placement__frame?(concat_str.alloc),
        Emittable.ConcatList AS concat_list -> placement__frame?(concat_list.alloc),
        Emittable.HeapCreate AS heap_create -> placement__frame?(heap_create.alloc),
        Emittable.AllocSlice AS alloc_slice -> placement__frame?(alloc_slice.alloc),
        Emittable.ContainerInit AS container_init -> placement__frame?(container_init.alloc),
        Emittable.MakeList AS make_list -> placement__frame?(make_list.alloc),
        Emittable.MakeSet AS make_set -> placement__frame?(make_set.alloc),
        Emittable.DeepCopy AS deep_copy -> placement__frame?(deep_copy.alloc),
        Emittable.CapWrap AS cap_wrap -> placement__frame?(cap_wrap.alloc),
        DEFAULT -> FALSE
      END;
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN mIRChecker__error(self: MIRChecker, kind: String@symbol, name: ?Name, msg: String) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(TRY (diagnosticRegistry__known?(kind))) THEN
      panic("{}Add an entry in src/ast/diagnostic_registry.rb (category: :mir).");
    END
    RETURN "[${kind}] ${rtoc_self_view.fn_name}::${castOptionalNameToString(name)} -- ${msg}";
}
END
PRIVATE FN mIRChecker__verify_unhoisted_allocs_mut(MUTABLE self: MIRChecker, body: []Emittable) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (mIRChecker__check_stmts_for_unhoisted(&rtoc_self_view, body));
    RETURN COPY body;
}
END
PRIVATE FN mIRChecker__check_stmts_for_unhoisted(MUTABLE self: MIRChecker, stmts: []Emittable) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN stmts DO
    MUTABLE rtoc_mutable_block_param_57 = COPY _;
    TRY (mIRChecker__check_stmt_for_unhoisted(&rtoc_self_view, &rtoc_mutable_block_param_57));
    END
}
END
PRIVATE FN mIRChecker__check_stmt_for_unhoisted(MUTABLE self: MIRChecker, MUTABLE node: ?Emittable) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !((node != NIL)) THEN
      RETURN;
    END
    IF node IS_A Let AS let THEN
      MUTABLE let_mutable = COPY let;
      TRY (mIRChecker__check_owned_expr_position_for_unhoisted(&rtoc_self_view, let_mutable.init, "Let initializer"));
    ELSE_IF node IS_A ReassignWithCleanup AS reassign_with_cleanup THEN
      MUTABLE reassign_with_cleanup_mutable = COPY reassign_with_cleanup;
      TRY (mIRChecker__check_owned_expr_position_for_unhoisted(&rtoc_self_view, reassign_with_cleanup_mutable.value, "ReassignWithCleanup value"));
    ELSE_IF node IS_A DiscardOwned AS discard_owned THEN
      MUTABLE discard_owned_mutable = COPY discard_owned;
      TRY (mIRChecker__check_owned_expr_position_for_unhoisted(&rtoc_self_view, discardOwned__expr(discard_owned_mutable), "DiscardOwned expression"));
    ELSE_IF node IS_A IfBindStmt AS if_bind_stmt THEN
      MUTABLE if_bind_stmt_mutable = COPY if_bind_stmt;
      IF !((if_bind_stmt_mutable.bindings).empty?()) THEN
            MUTABLE rtoc_idx = 0;
            WHILE rtoc_idx < if_bind_stmt_mutable.bindings.length() DO
            IF !(if_bind_stmt_mutable.bindings[rtoc_idx] IS_A {}Any) THEN
              rtoc_idx = rtoc_idx + 1;
          CONTINUE;
            END
            MUTABLE expr = if_bind_stmt_mutable.bindings[rtoc_idx][:expr];
            MUTABLE capture = if_bind_stmt_mutable.bindings[rtoc_idx][:capture];
            IF (capture AND mIRChecker__binder_capture_cleanup?(rtoc_self_view, if_bind_stmt_mutable.then_body, CAST(capture AS String))) THEN
                  TRY (mIRChecker__check_owned_expr_position_for_unhoisted(&rtoc_self_view, expr, "IfBind capture"));
            ELSE
                  TRY (mIRChecker__check_expr_for_unhoisted(&rtoc_self_view, expr));
            END
          rtoc_idx = rtoc_idx + 1;
            END
      END
      FOR _ IN TRY (ifBindStmt__body_slots(&if_bind_stmt_mutable)) DO
      TRY (mIRChecker__check_stmts_for_unhoisted(&rtoc_self_view, _.body));
      END
      RETURN;
    ELSE_IF node IS_A WhileStmt AS while_stmt THEN
      MUTABLE while_stmt_mutable = COPY while_stmt;
      IF (while_stmt_mutable.capture AND ((mIRChecker__binder_capture_cleanup?(rtoc_self_view, TRY (whileStmt__body(while_stmt_mutable)), CAST(while_stmt_mutable.capture AS String)) OR TRY (mIRChecker__block_expr_transfers_result?(rtoc_self_view, while_stmt_mutable.cond))))) THEN
        TRY (mIRChecker__check_owned_expr_position_for_unhoisted(&rtoc_self_view, while_stmt_mutable.cond, "While capture"));
      ELSE
        TRY (mIRChecker__check_expr_for_unhoisted(&rtoc_self_view, while_stmt_mutable.cond));
      END
      IF while_stmt_mutable.update THEN
        TRY (mIRChecker__check_expr_for_unhoisted(&rtoc_self_view, while_stmt_mutable.update));
      END
      FOR _ IN TRY (whileStmt__body_slots(&while_stmt_mutable)) DO
      TRY (mIRChecker__check_stmts_for_unhoisted(&rtoc_self_view, _.body));
      END
      RETURN;
    ELSE_IF node IS_A BatchWindowPush AS batch_window_push THEN
      MUTABLE batch_window_push_mutable = COPY batch_window_push;
      TRY (mIRChecker__check_expr_for_unhoisted(&rtoc_self_view, batch_window_push_mutable.item_expr));
      TRY (mIRChecker__check_owned_expr_position_for_unhoisted(&rtoc_self_view, batch_window_push_mutable.value_expr, "BatchWindow value"));
    ELSE_IF node IS_A BatchWindowFlush AS batch_window_flush THEN
      MUTABLE batch_window_flush_mutable = COPY batch_window_flush;
      TRY (mIRChecker__check_owned_expr_position_for_unhoisted(&rtoc_self_view, batch_window_flush_mutable.value_expr, "BatchWindow value"));
    ELSE
      MUTABLE owned_sources = node.owned_position_source_exprs() |> DISTINCT _;
      FOR _ IN node.child_exprs() DO
      TRY (mIRChecker__check_expr_sources_for_unhoisted(&rtoc_self_view, _, "expression", owned_sources.contains?(_)));
      END
    END
    FOR _ IN node.body_slots() DO
    TRY (mIRChecker__check_stmts_for_unhoisted(&rtoc_self_view, _.body()));
    END
    NIL;
}
END
PRIVATE FN mIRChecker__binder_capture_cleanup?(self: MIRChecker, body: []Emittable, name: String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN body |> ANY (IF _ IS_A Cleanup AS cleanup THEN (cleanup.name == name) ELSE FALSE END);
}
END
PRIVATE FN mIRChecker__block_expr_transfers_result?(self: MIRChecker, expr: Emittable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF expr IS_A MIRBlockExpr AS mir_block_expr THEN
      RETURN TRY (blockExpr__body(mir_block_expr)) |> ANY (_ IS_A TransferMark AND (_.target() == :block_result));
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN mIRChecker__check_owned_expr_position_for_unhoisted(MUTABLE self: MIRChecker, expr: ?Emittable, context: String) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF expr EXISTS AS expr_value THEN
      MUTABLE expr_value_mutable = COPY expr_value;
      TRY (mIRChecker__check_expr_sources_for_unhoisted(&rtoc_self_view, expr_value_mutable, context, TRUE));
    ELSE
      RETURN;
    END
}
END
PRIVATE FN mIRChecker__check_expr_for_unhoisted(MUTABLE self: MIRChecker, expr: ?Emittable) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF expr EXISTS AS expr_value THEN
      MUTABLE expr_value_mutable = COPY expr_value;
      TRY (mIRChecker__check_expr_sources_for_unhoisted(&rtoc_self_view, expr_value_mutable, "expression", FALSE));
    ELSE
      RETURN;
    END
}
END
PRIVATE FN mIRChecker__check_expr_sources_for_unhoisted(MUTABLE self: MIRChecker, expr: ?Emittable, context: String, owned_position: Bool) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF expr EXISTS AS expr_value THEN
      MUTABLE expr_value_mutable = COPY expr_value;
      IF !(TRUE) THEN
        RETURN;
      END
      IF TRY (mIRChecker__allocating_expr?(rtoc_self_view, expr_value_mutable)) THEN
        IF !(owned_position) THEN
          MUTABLE kind = expr_value_mutable.class().name().split("::").last();
          &rtoc_self_view.errors.append(TRY (mIRChecker__error(rtoc_self_view, :UNHOISTED_ALLOC, ruby_wrap_optional_String_Name(rtoc_self_view.fn_name), "${kind} in non-Let-init position (must be hoisted to a named variable)")));
          RETURN;
        END
      END
      MUTABLE owned_sources: [Set]Emittable = expr_value_mutable.owned_position_source_exprs() |> DISTINCT _;
      FOR _ IN expr_value_mutable.child_exprs() DO
      TRY (mIRChecker__check_expr_sources_for_unhoisted(&rtoc_self_view, _, context, owned_sources.contains?(_)));
      END
      FOR _ IN expr_value_mutable.body_slots() DO
      TRY (mIRChecker__check_stmts_for_unhoisted(&rtoc_self_view, _.body()));
      END
      NIL;
    ELSE
      RETURN;
    END
}
END
PRIVATE FN mIRChecker__allocating_expr?(self: MIRChecker, expr: ?Emittable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE effect = TRY (ownershipEffect__of(expr));
    RETURN ((effect.produces_owned AND effect.requires_hoist) AND ((!(effect.alloc) OR valid_allocators.contains?(effect.alloc))));
}
END
PUB FN mIRChecker__new(fn_name: ?String = NIL, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL) RETURNS MIRChecker@multiowned ->
  MUTABLE self = MIRChecker{ captured_names: NIL, errors: List[], fn_name: COPY fn_name, schema_lookup: COPY schema_lookup };
  mIRChecker__initialize(&self, fn_name, schema_lookup);
  RETURN self @multiowned;
END
FN castBodyToEmittable(value: Body) RETURNS Emittable ->
  PARTIAL MATCH value START
    Body.MIRProgram AS cast_payload -> RETURN Emittable{ MIRProgram: COPY cast_payload };,
    Body.MIRStructDef AS cast_payload -> RETURN Emittable{ MIRStructDef: COPY cast_payload };,
    Body.MIRDestructureTarget AS cast_payload -> RETURN Emittable{ MIRDestructureTarget: COPY cast_payload };,
    Body.MIRUnaryOp AS cast_payload -> RETURN Emittable{ MIRUnaryOp: COPY cast_payload };,
    Body.MIRMethodCall AS cast_payload -> RETURN Emittable{ MIRMethodCall: COPY cast_payload };,
    Body.MIRCast AS cast_payload -> RETURN Emittable{ MIRCast: COPY cast_payload };,
    Body.MIRDeferStmt AS cast_payload -> RETURN Emittable{ MIRDeferStmt: COPY cast_payload };,
    Body.MIROptionalUnwrap AS cast_payload -> RETURN Emittable{ MIROptionalUnwrap: COPY cast_payload };,
    Body.MIRBlockExpr AS cast_payload -> RETURN Emittable{ MIRBlockExpr: COPY cast_payload };,
    Body.MIRRangeLit AS cast_payload -> RETURN Emittable{ MIRRangeLit: COPY cast_payload };,
    Body.MIREnumDef AS cast_payload -> RETURN Emittable{ MIREnumDef: COPY cast_payload };,
    Body.MIRDoBlock AS cast_payload -> RETURN Emittable{ MIRDoBlock: COPY cast_payload };,
    Body.MIRBgBlock AS cast_payload -> RETURN Emittable{ MIRBgBlock: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Emittable");
  END
  panic("Invalid cast to Emittable");
END
FN castEmittableToMIRCheckerCleanup(value: Emittable) RETURNS MIRCheckerCleanup ->
  PARTIAL MATCH value START
    Emittable.Cleanup AS cast_payload -> RETURN MIRCheckerCleanup{ Cleanup: COPY cast_payload };,
    Emittable.ErrCleanup AS cast_payload -> RETURN MIRCheckerCleanup{ ErrCleanup: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to MIRCheckerCleanup");
  END
  panic("Invalid cast to MIRCheckerCleanup");
END
FN castMIRCheckerOwnershipSurfaceNodeToEmittable(value: MIRCheckerOwnershipSurfaceNode) RETURNS Emittable ->
  PARTIAL MATCH value START
    MIRCheckerOwnershipSurfaceNode.RegistryCall AS cast_payload -> RETURN Emittable{ RegistryCall: COPY cast_payload };,
    MIRCheckerOwnershipSurfaceNode.IndexedStore AS cast_payload -> RETURN Emittable{ IndexedStore: COPY cast_payload };,
    MIRCheckerOwnershipSurfaceNode.ShardedMapPut AS cast_payload -> RETURN Emittable{ ShardedMapPut: COPY cast_payload };,
    MIRCheckerOwnershipSurfaceNode.ReassignWithCleanup AS cast_payload -> RETURN Emittable{ ReassignWithCleanup: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Emittable");
  END
  panic("Invalid cast to Emittable");
END
FN castMIRCheckerRegistryOwnershipNodeToEmittable(value: MIRCheckerRegistryOwnershipNode) RETURNS Emittable ->
  PARTIAL MATCH value START
    MIRCheckerRegistryOwnershipNode.RegistryCall AS cast_payload -> RETURN Emittable{ RegistryCall: COPY cast_payload };,
    MIRCheckerRegistryOwnershipNode.IndexedStore AS cast_payload -> RETURN Emittable{ IndexedStore: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Emittable");
  END
  panic("Invalid cast to Emittable");
END
FN castMIRCheckerRegistryOwnershipNodeToMIRCheckerOwnershipSurfaceNode(value: MIRCheckerRegistryOwnershipNode) RETURNS MIRCheckerOwnershipSurfaceNode ->
  PARTIAL MATCH value START
    MIRCheckerRegistryOwnershipNode.RegistryCall AS cast_payload -> RETURN MIRCheckerOwnershipSurfaceNode{ RegistryCall: COPY cast_payload };,
    MIRCheckerRegistryOwnershipNode.IndexedStore AS cast_payload -> RETURN MIRCheckerOwnershipSurfaceNode{ IndexedStore: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to MIRCheckerOwnershipSurfaceNode");
  END
  panic("Invalid cast to MIRCheckerOwnershipSurfaceNode");
END
FN castNameToString(value: Name) RETURNS String ->
  IF value IS_A String AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN "";
END
FN castOptionalEmittableToOptionalFsmStructure(value: ?Emittable) RETURNS ?FsmStructure ->
  IF value != NIL THEN
    IF value IS_A FsmStructure AS cast_payload THEN
      RETURN cast_payload;
    END
  END
  RETURN NIL;
END
FN castOptionalNameToString(value: ?Name) RETURNS String ->
  IF value != NIL THEN
    IF value IS_A String AS cast_payload THEN
      RETURN cast_payload;
    END
  END
  RETURN "";
END
FN rubyToClearVoid() RETURNS Void ->
  RETURN;
END
FN ruby_array_concat_FnDef(left: []FnDef, right: []FnDef) RETURNS []FnDef ->
  MUTABLE result: []FnDef = [];
  left |> EACH { &result.append(COPY _); };
  right |> EACH { &result.append(COPY _); };
  RETURN result;
END
FN ruby_array_concat_String(left: []String, right: []String) RETURNS []String ->
  MUTABLE result: []String = [];
  left |> EACH { &result.append(COPY _); };
  right |> EACH { &result.append(COPY _); };
  RETURN result;
END
FN ruby_set_intersection_String_symbol(left: []String@symbol, right: []String@symbol) RETURNS []String@symbol ->
  MUTABLE result: []String@symbol = [];
  left |> EACH {
    IF right.contains?(_) AND !(result.contains?(_)) THEN
      &result.append(COPY _);
    END
  };
  RETURN result;
END
FN ruby_wrap_optional_Emittable_MIRCheckerAggregateExpr(value: ?Emittable) RETURNS ?MIRCheckerAggregateExpr ->
  IF value EXISTS AS optional_payload THEN
    RETURN MIRCheckerAggregateExpr{ Emittable: COPY optional_payload };
  END
  NIL;
END
FN ruby_wrap_optional_Emittable_NodeRoot(value: ?Emittable) RETURNS ?NodeRoot ->
  IF value EXISTS AS optional_payload THEN
    RETURN NodeRoot{ Emittable: COPY optional_payload };
  END
  NIL;
END
FN ruby_wrap_optional_String_Name(value: ?String) RETURNS ?Name ->
  IF value EXISTS AS optional_payload THEN
    RETURN Name{ StringValue: COPY optional_payload };
  END
  NIL;
END
FN ruby_wrap_optional_string_to_symbol(value: ?String) RETURNS ?String@symbol ->
  IF value EXISTS AS value_value THEN
    RETURN symbol(value_value);
  END
  NIL;
END
