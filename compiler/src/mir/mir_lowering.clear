      MUTABLE decl: ?SymbolEntryRegInput = decl_branch_value;
      MUTABLE mapped: ?String = IF decl != NIL THEN
        (TRY (functionState__decl_zig_names(mIRLowering__function_state(rtoc_self_view))))[decl.object_id()]
      ELSE
        NIL
      END;
      RETURN (((IF mIRLowering__capture_state(rtoc_self_view).do_capture_map != NIL THEN
        (mIRLowering__capture_state(rtoc_self_view).do_capture_map)[var_name]
      ELSE
        NIL
      END) OR_ELSE mapped) OR var_name);
    END
}
END
PRIVATE FN mIRLowering__with_cap_is_param?(self: MIRLowering, var_node: CapabilityVarNode) RETURNS Bool
