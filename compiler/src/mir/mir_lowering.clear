    ELSE_IF type__set_collection?(ct) THEN
      MUTABLE for_id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_756 = mIRLowering__lowering_counters(rtoc_self_view);
