    IF !(copy_forbidden) THEN
      clone_statements[0] = Let{ name: COPY "result", init: Emittable{ Ident: COPY self_ref }, mutable: clone_fields |> ANY _, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL };
      &clone_statements.unshift(Suppress{ name: "alloc", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
      &clone_statements.append(Stmt{ Emittable: COPY CAST(ReturnStmt{ value: Emittable{ Ident: COPY Ident{ name: "result", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) });
      &methods.append(FnDef{ name: "__clear_clone", params: [MIRParam{ name: "self", zig_type: "@This()", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL }, MIRParam{ name: "alloc", zig_type: "std.mem.Allocator", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL }], ret_type: "@This()", body: Body{ ArrayValue: clone_statements |> SELECT castStmtToLocatable(_) }, visibility: :pub, can_fail: TRUE, comptime_params: List[], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
    END
    RETURN methods;
}
END
PRIVATE FN mIRLowering__lifecycle_cleanup_statement(self: MIRLowering, field_ref: Expr, field_type: Type, alloc_ref: Expr) RETURNS !Stmt
