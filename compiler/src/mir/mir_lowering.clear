PRIVATE FN mIRLowering__takes_param_ownership_mir(self: MIRLowering, node: FunctionDef) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE out: []Emittable = ( { MUTABLE rtoc_empty_list_314: []Emittable = List[]; rtoc_empty_list_314 } );
    MUTABLE rtoc_each_items_316 = (node.params |> WHERE (_.takes OR (IF _.symbol != NIL THEN
      { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_315 = CAST(_.symbol AS SymbolEntry);
    symbolEntry__kept_identity(rtoc_local_receiver_315) }
    ELSE
      NIL
    END)));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_316.length() DO
      MUTABLE entry = ((TRY (functionState__bindings(mIRLowering__function_state(rtoc_self_view))))[CAST((rtoc_each_items_316[rtoc_idx]?.name) AS String)] OR_ELSE new());
      MUTABLE ti = COPY rtoc_each_items_316[rtoc_idx]?.type;
      IF !(((((IF rtoc_each_items_316[rtoc_idx]?.symbol != NIL THEN
          { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_317 = CAST((rtoc_each_items_316[rtoc_idx]?.symbol) AS SymbolEntry);
      symbolEntry__kept_identity(rtoc_local_receiver_317) }
        ELSE
          NIL
        END) != NIL) OR mIRLowering__ownership_tracked_transfer_type?(rtoc_self_view, ti)) OR ((cleanupEntry__present?(entry) AND entry.heap?())))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE kept = (!(rtoc_each_items_316[rtoc_idx]?.takes) AND !(((IF rtoc_each_items_316[rtoc_idx]?.symbol != NIL THEN
          { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_318 = CAST((rtoc_each_items_316[rtoc_idx]?.symbol) AS SymbolEntry);
      symbolEntry__kept_identity(rtoc_local_receiver_318) }
        ELSE
          NIL
        END) == NIL)));
      IF kept THEN
          ti = TRY (type__new(TypeConstructionInput{ StringValue: COPY CAST(type__resolved(ti) AS String) }, :multiowned, NIL, NIL, :heap));
      END
      MUTABLE drop_entry = COPY entry;
      MUTABLE alloc = IF cleanupEntry__present?(entry) THEN
          entry.alloc()
        ELSE
          :heap
        END;
      MUTABLE scope = IF cleanupEntry__present?(entry) THEN
          cleanupEntry__scope(entry)
        ELSE
          :heap
        END;
      MUTABLE mark = AllocMark{ name: COPY CAST((rtoc_each_items_316[rtoc_idx]?.name) AS String), alloc: COPY alloc, type_info: COPY ti, scope: COPY scope, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
      IF entry.needs_cleanup?() THEN
          IF !(kept) THEN
            TRY (mIRLowering__build_drop_entry_mut(rtoc_self_view, &drop_entry, ti, NIL));
          END
          IF cleanupEntry__has_moved_guard?(drop_entry) THEN
            MUTABLE rtoc_index_receiver_319 = mIRLowering__function_state(rtoc_self_view).guarded_cleanup_names;
            rtoc_index_receiver_319[mIRLowering__zig_safe_name(rtoc_self_view, CAST((rtoc_each_items_316[rtoc_idx]?.name) AS String))] = TRUE;
          END
          out = ruby_array_concat_Emittable(out, CAST(TRY (materializationPacket__statements((materializationPacket__markers(mark, Stmt{ Emittable: COPY CAST(Cleanup{ name: mIRLowering__zig_safe_name(rtoc_self_view, CAST((rtoc_each_items_316[rtoc_idx]?.name) AS String)), cleanup_entry: drop_entry, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) })))) AS []Emittable));
      ELSE
          out = ruby_array_concat_Emittable(out, CAST(TRY (materializationPacket__statements(materializationPacket__markers(mark))) AS []Emittable));
      END
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN out;
}
END
PRIVATE FN mIRLowering__record_lowered_entry_markers_mut(self: MIRLowering, nodes: []Emittable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    FOR _ IN nodes DO
    IF _ IS_A AllocMark AS alloc_mark THEN
        mIRLowering__function_state(rtoc_self_view).lowered_alloc_names.insert(COPY alloc_mark.name);
    END
    IF (((_ IS_A Cleanup OR _ IS_A ErrCleanup)) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_322 = ownedCompositeMaterialization__cleanup_entry(_);
    cleanupEntry__has_moved_guard?(rtoc_local_receiver_322) }) THEN
        mIRLowering__function_state(rtoc_self_view).lowered_guarded_cleanup_names.insert(COPY CAST(_.name() AS String));
    END
    END
}
END
PRIVATE FN mIRLowering__build_post_inner_fn(self: MIRLowering, node: FunctionDef, params_mir: []MIRParam, return_type_str: String, prologue: []Emittable, body_mir: []Emittable, comptime_params: []String) RETURNS FnDef
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE inner_name = "__${mIRLowering__zig_safe_name(rtoc_self_view, node.name)}_post_body";
    RETURN FnDef{ name: inner_name, params: COPY params_mir, ret_type: COPY return_type_str, body: COPY (prologue + body_mir), visibility: :private, can_fail: FALSE, comptime_params: COPY comptime_params, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
}
END
PRIVATE FN mIRLowering__build_post_outer_fn(MUTABLE self: MIRLowering, node: FunctionDef, params_mir: []MIRParam, return_type_str: String, fn_needs_rt: Bool, vis: String@symbol, comptime_params: []String) RETURNS !FnDef
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE inner_name = "__${mIRLowering__zig_safe_name(rtoc_self_view, node.name)}_post_body";
    MUTABLE mutable_scalar = ((((node.params |> WHERE ((_.mutable != NIL) AND !((mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ Type: COPY _.type }, TRUE).startsWith?("[]") OR mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ Type: COPY _.type }, TRUE).startsWith?("*")))))) |> SELECT _.name)) |> DISTINCT _;
    MUTABLE forward_name = %(p) USE(mutable_scalar) -> {
    IF mutable_scalar.contains?(p.name()) THEN
      RETURN "_m_${p.name()}";
    ELSE
      RETURN p.name();
    END
    NIL
    };
    MUTABLE arg_idents = node.params |> SELECT Ident{ name: runtimeCallSpec__call(forward_name, _), lowered_node_id: NIL, ownership_consumption: NIL };
    IF fn_needs_rt THEN
      arg_idents = ([Ident{ name: "rt", lowered_node_id: NIL, ownership_consumption: NIL }] + arg_idents);
    END
    MUTABLE rt_obj: ?Type = COPY node.return_type;
    MUTABLE is_error_union = !(!((((rt_obj != NIL) AND type__error_union?(rt_obj)))));
    MUTABLE payload_type_branch_value: ?Type = NIL;
    IF is_error_union THEN
      payload_type_branch_value = TRY (type__payload_type(rt_obj));
    ELSE
      payload_type_branch_value = rt_obj;
    END
    MUTABLE payload_type: ?Type = payload_type_branch_value;
    MUTABLE is_void = !(!(((((payload_type != NIL) AND TRUE) AND type__void?(payload_type)))));
    MUTABLE inner_sig = TRY (functionSignature__from_function_def(node));
    MUTABLE inner_contract = callableContract__new(inner_sig, TRY (ownershipContract__new(( { MUTABLE rtoc_empty_list_324: []OwnershipOperandFact = List[]; rtoc_empty_list_324 } ), ( { MUTABLE rtoc_empty_list_325: []String = List[]; rtoc_empty_list_325 } ), ( { MUTABLE rtoc_empty_list_326: []String = List[]; rtoc_empty_list_326 } ), TRUE)), node.params.length());
    MUTABLE inner_call_mir = Call{ callee: COPY inner_name, args: COPY arg_idents, try_wrap: is_error_union, owned_return: mIRLowering__call_owned_return?(rtoc_self_view, Node{ FunctionDef: COPY node }), callable_contract: COPY inner_contract, lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL };
    inner_call_mir.result_type = TRY (type__new((payload_type OR_ELSE :Void)));
    MUTABLE check_stmts = (((node.post_clauses OR List[]))) |> SELECT {
    MUTABLE expr = _[:expr];
    MUTABLE source = _[:source];
    MUTABLE cond_mir = TRY (mIRLowering__lower(&rtoc_self_view, expr));
    MUTABLE msg_text: String = "";
      IF (source AND !(source.empty?())) THEN
        msg_text = "DEBUG_POST failed: ${source}";
      ELSE
        msg_text = "DEBUG_POST failed";
      END
    IfStmt{ cond: Emittable{ MIRUnaryOp: COPY MIRUnaryOp{ op: "!", operand: COPY cond_mir, lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: [Panic{ message: msg_text, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL }
    };
    MUTABLE body =   IF is_void THEN
      ([ExprStmt{ expr: Emittable{ Call: COPY inner_call_mir }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }] + (IF !((check_stmts.length() == 0)) THEN
      [DebugOnly{ body: Body{ ArrayValue: check_stmts |> SELECT SegmentStmt{ Emittable: Emittable{ IfStmt: COPY _ } } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }]
    ELSE
      NIL
    END) + [ReturnStmt{ value: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }])
    ELSE
      ([Let{ name: COPY "result", init: Emittable{ Call: COPY inner_call_mir }, mutable: FALSE, annotation: NIL, suppression: "_ = &result;", alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }] + (IF !((check_stmts.length() == 0)) THEN
      [DebugOnly{ body: Body{ ArrayValue: check_stmts |> SELECT SegmentStmt{ Emittable: Emittable{ IfStmt: COPY _ } } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }]
    ELSE
      NIL
    END) + [ReturnStmt{ value: Emittable{ Ident: COPY Ident{ name: "result", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }])
    END;
    RETURN FnDef{ name: mIRLowering__zig_safe_name(rtoc_self_view, node.name), params: COPY params_mir, ret_type: COPY return_type_str, body: COPY body, visibility: COPY vis, can_fail: FALSE, comptime_params: COPY comptime_params, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
}
END
PRIVATE FN mIRLowering__build_catch_clauses(MUTABLE self: MIRLowering, node: FunctionDef, fn_can_fail: Bool) RETURNS !CatchLoweringPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE clauses: []MIRCatchClause = ( { MUTABLE rtoc_empty_list_327: []MIRCatchClause = List[]; rtoc_empty_list_327 } );
    MUTABLE snap_types: [Set]Any = Set[];
    IF TRUE THEN
      snap_types = ((node.snapshot_types OR Set[]));
    ELSE
      snap_types = Set[];
    END
    MUTABLE snapshot_type_branch_value: ?Type = NIL;
    IF (snap_types.size() == 1) THEN
      snapshot_type_branch_value = TRY (type__new(snap_types.first()));
    ELSE
      snapshot_type_branch_value = NIL;
    END
    MUTABLE snapshot_type: ?Type = snapshot_type_branch_value;
    FOR _ IN mIRLowering__function_catch_clauses(rtoc_self_view, node) DO
    MUTABLE clause_mir = TRY (mIRLowering__lower_body(&rtoc_self_view, _.body));
    MUTABLE clause_body: []Emittable = clause_mir;
    &clauses.append(MIRCatchClause{ meta: COPY CatchClauseMeta{ kinds: COPY _.kinds |> SELECT _.toString(), types: COPY _.types |> SELECT _.toString(), filter_types: COPY _.filter_types |> SELECT _.toString(), filter_messages: COPY _.filter_messages |> SELECT CAST(TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(_))) AS Emittable) }, body: COPY clause_body });
    END
    MUTABLE default_body: []Emittable = ( { MUTABLE rtoc_empty_list_328: []Emittable = List[]; rtoc_empty_list_328 } );
    MUTABLE default_action: CatchDefaultAction = CatchDefaultAction.Unreachable;
    IF mIRLowering__has_default_catch?(rtoc_self_view, node) THEN
      MUTABLE default_mir = TRY (mIRLowering__lower_body(&rtoc_self_view, mIRLowering__default_catch_body(rtoc_self_view, node)));
      default_body = default_mir;
      default_action = CatchDefaultAction.Body;
    ELSE_IF fn_can_fail THEN
      default_action = CatchDefaultAction.Propagate;
    END
    RETURN CatchLoweringPlan{ clauses: COPY clauses, default_body: COPY default_body, default_action: COPY default_action, snapshot_type: COPY snapshot_type };
}
END
PRIVATE FN mIRLowering__collect_catch_reassigns(self: MIRLowering, node: FunctionDef) RETURNS ![]CatchReassign
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE reassigns: []CatchReassign = ( { MUTABLE rtoc_empty_list_329: []CatchReassign = List[]; rtoc_empty_list_329 } );
    MUTABLE catch_bodies: [List, List]Locatable = ( { MUTABLE rtoc_empty_list_330: [List, List]Locatable = List[]; rtoc_empty_list_330 } );
    FOR _ IN mIRLowering__function_catch_clauses(rtoc_self_view, node) DO
    IF _.body THEN
      &catch_bodies.append(COPY _.body);
    END
    END
    MUTABLE default_body = mIRLowering__default_catch_body(rtoc_self_view, node);
    IF !((default_body.length() == 0)) THEN
      &catch_bodies.append(default_body);
    END
    FOR _ IN catch_bodies DO
    mIRLowering__walk_catch_body_for_reassigns(rtoc_self_view, _, &reassigns);
    END
    RETURN reassigns;
}
END
PRIVATE FN mIRLowering__walk_catch_body_for_reassigns(self: MIRLowering, stmts: []Locatable, MUTABLE reassigns: []CatchReassign) RETURNS Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    FOR _ IN stmts DO
    IF _ IS_A BindExpr AS bind_expr THEN
      IF (bind_expr.mode == :assign) THEN
        MUTABLE alloc: ?String@symbol = mIRLowering__infer_catch_value_allocator(rtoc_self_view, bind_expr.value);
        IF alloc EXISTS AS alloc_value THEN
          &reassigns.append(CatchReassign{ name: COPY CAST(bind_expr.name AS String), alloc: COPY alloc_value, line: bind_expr.token.line });
        END
      END
    ELSE_IF _ IS_A Assignment AS assignment THEN
      IF assignment.name IS_A Identifier THEN
        MUTABLE alloc: ?String@symbol = mIRLowering__infer_catch_value_allocator(rtoc_self_view, assignment.value);
        IF alloc EXISTS AS alloc_value THEN
          &reassigns.append(CatchReassign{ name: COPY CAST(assignment.name.name() AS String), alloc: COPY alloc_value, line: assignment.token.line });
        END
      END
    ELSE_IF _ IS_A IfStatement AS if_statement THEN
      mIRLowering__walk_catch_body_for_reassigns(rtoc_self_view, if_statement.then_branch, &reassigns);
      mIRLowering__walk_catch_body_for_reassigns(rtoc_self_view, if_statement.else_branch, &reassigns);
    ELSE_IF _ IS_A MatchStatement AS match_statement THEN
      FOR _ IN match_statement.cases DO
      mIRLowering__walk_catch_body_for_reassigns(rtoc_self_view, matchCase__body(_), &reassigns);
      END
      mIRLowering__walk_catch_body_for_reassigns(rtoc_self_view, match_statement.default_case, &reassigns);
    END
    END
}
END
PRIVATE FN mIRLowering__infer_catch_value_allocator(self: MIRLowering, expr: ?Locatable) RETURNS ?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF expr EXISTS AS expr_value THEN
      IF (respondsTo?(expr_value, "symbol") AND ((expr_value.symbol() != NIL) AND ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_331 = ((expr_value.symbol())?);
      symbolEntry__heap_storage?(rtoc_local_receiver_331) } == TRUE))) THEN
        RETURN :heap;
      END
      MUTABLE sym_storage = IF respondsTo?(expr_value, "symbol") THEN
        (IF expr_value.symbol() != NIL THEN
        (expr_value.symbol()).storage()
      ELSE
        NIL
      END)
      ELSE
        NIL
      END;
      IF symbolEntry__frame_storage_value?(sym_storage) THEN
        RETURN :frame;
      END
      MUTABLE storage: ?String@symbol = IF respondsTo?(expr_value, "storage") THEN
        expr_value.storage()
      ELSE
        NIL
      END;
      IF symbolEntry__heap_storage_value?(storage) THEN
        RETURN :heap;
      END
      IF symbolEntry__frame_storage_value?(storage) THEN
        RETURN :frame;
      END
      RETURN NIL;
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN mIRLowering__cross_boundary_arg(self: MIRLowering, arg_input: Emittable, a: Locatable, callee_param: ?Param, callee_param_type: Type, callee_sig: ?FunctionSignature, idx: Int64) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE arg = COPY arg_input;
    MUTABLE ti = TRY (type__from_node_mut(a, "call boundary argument"));
    MUTABLE moved_arg = (((a IS_A CopyNode OR a IS_A KeepNode) OR a IS_A MoveNode) OR (((((aST__moved?(a) AND !(a IS_A CopyNode)) AND !(a IS_A KeepNode)) AND !(arg IS_A DupeSlice)) AND !(arg IS_A DeepCopy))));
    IF ((((ti != NIL) AND type__symbol?((ti?))) AND TRY (type__byte_string?(callee_param_type))) AND ((callee_param == NIL) OR (callee_param.carrier_contract != :monomorphic))) THEN
      MUTABLE widened = FieldGet{ object: COPY arg, field: "bytes", lowered_node_id: NIL, ownership_consumption: NIL };
      IF callee_param?.takes EXISTS AS takes_value THEN
        RETURN Emittable{ DupeSlice: COPY DupeSlice{ source: Emittable{ FieldGet: COPY widened }, alloc: :heap, lowered_node_id: NIL, ownership_consumption: NIL } };
      ELSE
        RETURN Emittable{ FieldGet: COPY widened };
      END
    END
    IF (((callee_param != NIL) AND (callee_param?).takes) AND (callee_param.carrier_contract == :monomorphic)) THEN
      IF wants_ptr?(a, ti, callee_param, callee_param_type, callee_sig, idx) THEN
        RETURN Emittable{ AddressOf: COPY AddressOf{ expr: COPY arg, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
      RETURN COPY arg;
    END
    IF ((((((callee_param != NIL) AND (callee_param?).takes) AND TRY (type__any_rc?(ti))) AND !(TRY (type__any_rc?(callee_param_type)))) AND !(type__generic_type_parameter?(callee_param_type))) AND (callee_param.carrier_contract != :monomorphic)) THEN
      MUTABLE sink_alloc = TRY (mIRLowering__allocator_for_takes_param_mut(rtoc_self_view, callee_param));
      MUTABLE payload = mIRLowering__rc_payload_value(rtoc_self_view, arg, ti);
      MUTABLE materialized = DeepCopy{ source: COPY payload, zig_type: COPY TRY (type__zig_type(callee_param_type)), elem_type: NIL, strategy: :full_value, alloc: COPY sink_alloc, copy_shape: NIL, type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL };
      materialized = castEmittableToDeepCopy(mIRLowering__hoist_alloc(rtoc_self_view, Emittable{ DeepCopy: COPY materialized }, a, TRUE));
      IF mIRLowering__owned_slice_argument_required?(rtoc_self_view, callee_param, moved_arg, ti, callee_param_type) THEN
        MUTABLE owned_slice = OwnedSlice{ expr: Emittable{ DeepCopy: COPY materialized }, alloc: COPY sink_alloc, lowered_node_id: NIL, ownership_consumption: NIL };
        RETURN Emittable{ OwnedSlice: COPY castEmittableToOwnedSlice(TRY (mIRLowering__with_ownership_consumption(rtoc_self_view, Emittable{ OwnedSlice: COPY owned_slice }, mIRLowering__mir_ident_names(rtoc_self_view, Emittable{ DeepCopy: COPY materialized }), "MIR::OwnedSlice(managed payload)", :owned_sink, sink_alloc))) };
      END
      IF wants_ptr?(a, ti, callee_param, callee_param_type, callee_sig, idx) THEN
        RETURN Emittable{ AddressOf: COPY AddressOf{ expr: Emittable{ DeepCopy: COPY materialized }, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
      RETURN Emittable{ DeepCopy: COPY materialized };
    END
    IF mIRLowering__owned_slice_argument_required?(rtoc_self_view, callee_param, moved_arg, ti, callee_param_type) THEN
      MUTABLE sink_alloc = TRY (mIRLowering__allocator_for_takes_param_mut(rtoc_self_view, callee_param));
      MUTABLE owned_slice = OwnedSlice{ expr: COPY arg, alloc: COPY sink_alloc, lowered_node_id: NIL, ownership_consumption: NIL };
      MUTABLE owns_slice_input = (mIRLowering__ownership_tracked_transfer_type?(rtoc_self_view, ti) OR (mIRLowering__mir_ident_names(rtoc_self_view, arg) |> ANY mIRLowering__function_state(rtoc_self_view).lowered_alloc_names.contains?(_)));
      IF !(owns_slice_input) THEN
        RETURN Emittable{ OwnedSlice: COPY owned_slice };
      END
      RETURN Emittable{ OwnedSlice: COPY castEmittableToOwnedSlice(TRY (mIRLowering__with_ownership_consumption(rtoc_self_view, Emittable{ OwnedSlice: COPY owned_slice }, mIRLowering__mir_ident_names(rtoc_self_view, arg), "MIR::OwnedSlice", :owned_sink, sink_alloc))) };
    END
    IF callee_param?.takes EXISTS AS takes_value THEN
      MUTABLE sink_alloc = TRY (mIRLowering__allocator_for_takes_param_mut(rtoc_self_view, callee_param));
      MUTABLE placed = TRY (mIRLowering__materialize_owned_sink_value(rtoc_self_view, arg, a, sink_alloc, TypeTypeInput{ Type: COPY callee_param_type }));
      arg = mIRLowering__hoist_alloc(rtoc_self_view, placed, a, TRUE);
    END
    IF ((((callee_param != NIL) AND !(callee_param.takes)) AND arg IS_A Orelse) AND ((TRY (type__recursive_cleanup_shape?(ti, mIRLowering__mir_schema_lookup(rtoc_self_view))) OR TRY (type__needs_cleanup?(ti, mIRLowering__mir_schema_lookup(rtoc_self_view)))))) THEN
      MUTABLE arg_alloc = mIRLowering__placement_for_node(rtoc_self_view, a);
      MUTABLE placed = TRY (mIRLowering__place_owned_orelse_for_destination(rtoc_self_view, castEmittableToOrelse(arg), ti, arg_alloc));
      arg = mIRLowering__hoist_alloc(rtoc_self_view, placed, a, FALSE, FALSE, FALSE);
    END
    IF (((callee_param != NIL) AND !(callee_param.takes)) AND (((arg IS_A StructInit OR arg IS_A TupleLiteral) OR arg IS_A ArrayInit))) THEN
      arg = mIRLowering__hoist_alloc(rtoc_self_view, arg, a, FALSE, FALSE, FALSE, mIRLowering__placement_for_node(rtoc_self_view, a));
    END
    IF mIRLowering__borrowed_array_argument_required?(rtoc_self_view, ti, a, callee_param_type) THEN
      RETURN Emittable{ ItemsAccess: COPY ItemsAccess{ expr: COPY arg, safe: TRUE, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF (((callee_param != NIL) AND (callee_param?).mutable) AND symbolEntry__always_mutable_sync?(type__sync(ti))) THEN
      RETURN Emittable{ AddressOf: COPY AddressOf{ expr: Emittable{ FieldGet: COPY FieldGet{ object: COPY arg, field: "data", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF (((with_alias_pointer_shaped?(a) AND (callee_param != NIL)) AND !(callee_param.mutable)) AND !(type__needs_pointer_passing?(callee_param_type))) THEN
      RETURN Emittable{ Deref: COPY Deref{ expr: COPY arg, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF !(wants_ptr?(a, ti, callee_param, callee_param_type, callee_sig, idx)) THEN
      RETURN COPY arg;
    END
    IF arg_already_pointer_shaped?(a) THEN
      RETURN COPY arg;
    END
    IF (((callee_param != NIL) AND (callee_param?).mutable) AND (aST__root_identifier(a) == NIL)) THEN
      arg = mIRLowering__materialize_mutable_call_temporary(rtoc_self_view, arg, a);
    END
    RETURN Emittable{ AddressOf: COPY AddressOf{ expr: COPY arg, lowered_node_id: NIL, ownership_consumption: NIL } };
}
END
PRIVATE FN mIRLowering__materialize_mutable_call_temporary(self: MIRLowering, arg: Emittable, ast_arg: Locatable) RETURNS Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE hoisted = mIRLowering__hoist_alloc(rtoc_self_view, arg, ast_arg, FALSE, TRUE);
    IF !(hoisted.equal?(arg)) THEN
      RETURN hoisted;
    END
    MUTABLE owned_temp: ?Let = mIRLowering__pending_owned_let(rtoc_self_view, arg);
    IF owned_temp EXISTS AS owned_temp_value THEN
      MUTABLE owned_temp_value_mutable = COPY owned_temp_value;
      owned_temp_value_mutable.mutable = TRUE;
      RETURN COPY arg;
    END
    MUTABLE name = "__mutable_arg_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_332 = mIRLowering__lowering_counters(rtoc_self_view);
    mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_332) }}";
    mIRLowering__function_state(rtoc_self_view).pending_stmts.append(Stmt{ Emittable: COPY CAST(Let{ name: COPY name, init: COPY arg, mutable: TRUE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } AS Emittable) });
    RETURN Emittable{ Ident: COPY Ident{ name: name, lowered_node_id: NIL, ownership_consumption: NIL } };
}
END
PRIVATE FN mIRLowering__pending_owned_let(self: MIRLowering, arg: Emittable) RETURNS ?Let
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF arg IS_A Ident AS ident THEN
      MUTABLE name = COPY ident.name;
      RETURN CAST(mIRLowering__function_state(rtoc_self_view).pending_stmts |> FIND (_ IS_A Let AND (_.name() == name)) AS ?Let);
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN mIRLowering__owned_slice_argument_required?(self: MIRLowering, callee_param: ?Param, moved_arg: Bool, ti: Type, callee_param_type: Type) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN !(!(((((((callee_param != NIL) AND (callee_param?).takes) AND moved_arg) AND TRY (type__direct_indexable_collection?(ti))) AND !(type__collection?(callee_param_type))))));
}
END
PRIVATE FN mIRLowering__borrowed_array_argument_required?(self: MIRLowering, ti: Type, ast_arg: Locatable, callee_param_type: Type) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (((TRY (type__borrowed_array_argument?(ti)) AND !(ast_arg IS_A MoveNode)) AND !(type__collection?(callee_param_type))) AND !(type__generic_type_parameter?(callee_param_type)));
}
END
PRIVATE FN mIRLowering__callable_contract_for(self: MIRLowering, sig: ?FunctionSignature, ast_args: []Locatable) RETURNS !?CallableContract@multiowned
  REQUIRES self: LOCAL
->
