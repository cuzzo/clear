PRIVATE FN mIRLowering__loop_body_exits?(self: MIRLowering, body: []Emittable) RETURNS Bool ->
    IF !((TRUE AND !((body.length() == 0)))) THEN
      RETURN FALSE;
    END
    RETURN ((((body.last() != NIL) AND (body.last() IS_A BreakStmt)) OR ((body.last() != NIL) AND (body.last() IS_A ContinueStmt))) OR ((body.last() != NIL) AND (body.last() IS_A ReturnStmt)));
END
PRIVATE FN mIRLowering__lower_for_each(MUTABLE self: MIRLowering, node: ForEach) RETURNS !Emittable ->
    MUTABLE plan = TRY (mIRLowering__for_each_plan(&self, node));
    MUTABLE loop_stmt = TRY (mIRLowering__for_each_loop_stmt(&self, node, plan));
    IF (plan.collection_setup.length() == 0) THEN
      RETURN loop_stmt;
    ELSE
      RETURN Emittable{ ScopeBlock: COPY ScopeBlock{ body: COPY (plan.collection_setup + [loop_stmt]), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
END
PRIVATE FN mIRLowering__for_each_plan(MUTABLE self: MIRLowering, node: ForEach) RETURNS !ForEachPlan ->
    MUTABLE var = mIRLowering__zig_safe_name(self, node.var_name);
    # `_` is a discard in Zig, not a binding, so a body that reads the
    # placeholder needs a real name -- and two nested `FOR _` loops naming
    # their capture the same thing collide. Give each placeholder loop its
    # own name and resolve the body's `_` uses through it, so the innermost
    # enclosing loop wins the way lexical shadowing does.
    MUTABLE placeholder = (node.var_name == "_");
    MUTABLE ph_map = TRY (functionState__rename_map(mIRLowering__function_state(&self)));
    MUTABLE ph_key = mIRLowering__zig_safe_name(self, "_");
    MUTABLE ph_had = ph_map.contains?(ph_key);
    MUTABLE ph_prev: String = "";
    IF placeholder THEN
      IF ph_had THEN
        ph_prev = UNWRAP (COPY ph_map[ph_key]);
      END
      var = "__for_it_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_ph = mIRLowering__lowering_counters(&self);
      mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_ph)) }}";
      ph_map[ph_key] = COPY var;
    END
    MUTABLE body = TRY (mIRLowering__lower_body(&self, castLocatableListToMIRLoweringLowerableStmtList(node.body)));
    IF placeholder THEN
      IF ph_had THEN
        ph_map[ph_key] = COPY ph_prev;
      ELSE
        &ph_map.delete(ph_key);
      END
    END
    TRY (mIRLowering__finalize_loop_frame_alloc_scopes_mut(&self, body, node.mark_per_iter));
    MUTABLE rt = Ident{ name: mIRLowering__runtime_binding_name(&self), lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE coll = mIRLowering__with_expected_type(&self, NIL, %() USE(MUTABLE node, MUTABLE self) -> {
    MUTABLE rtoc_lambda_result_739: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__pipeline_lowering_bridge(node.collection)));
    rtoc_lambda_result_739
    });
    MUTABLE coll_type = TRY (aST__full_type_mut(node.collection));
    MUTABLE ct_branch_value: ?Type = NIL;
    IF coll_type IS_A Type THEN
      ct_branch_value = coll_type;
    ELSE
      ct_branch_value = TRY (type__new(coll_type));
    END
    MUTABLE ct: Type = ct_branch_value?;
    MUTABLE collection_setup: []Emittable = List[];
    IF TRY (mIRLowering__for_each_owned_collection_source?(&self, &coll)) THEN
      MUTABLE source_name = "__for_src_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_741 = mIRLowering__lowering_counters(&self);
      mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_741)) }}";
      MUTABLE source_alloc = TRY (mIRLowering__for_each_owned_collection_source_alloc(&self, coll, ct));
      MUTABLE entry = cleanupEntry__build(:uniform, source_alloc, FALSE, NIL, TRY (type__zig_type(ct)));
      collection_setup = ruby_array_concat_Emittable__mir_lowering(collection_setup, CAST(TRY (bindingMaterialization__statements((BindingMaterialization{ name: COPY source_name, expr: COPY CAST(coll AS Emittable), alloc: COPY source_alloc, type_info: COPY ct, mutable: FALSE, cleanup_entry: entry, annotation: NIL, suppression: NIL, cleanup_mode: :normal, scope: NIL, ownership_tracked: TRUE }))) AS []Emittable));
      coll = Ident{ name: COPY source_name, lowered_node_id: NIL, ownership_consumption: NIL };
    END
    MUTABLE is_mutable = (node.is_mutable == TRUE);
    MUTABLE mark_per_iter: ?Bool = IF (node.mark_per_iter == TRUE) THEN
      TRUE
    ELSE
      NIL
    END;
    MUTABLE tight = node.tight;
    body = TRY (mIRLowering__prepend_loop_mark(&self, body, mark_per_iter, tight, List[]));
    IF (mIRLowering__current_function_has_rt?(&self) AND !(mIRLowering__loop_body_exits?(self, body))) THEN
      &body.append(Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY rt }, method: "checkYield", args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    END
    RETURN ForEachPlan{ var: COPY var, body: COPY body, rt: COPY rt, collection: COPY coll, collection_type: COPY ct, collection_setup: COPY collection_setup, mutable: is_mutable, mark_per_iter: mark_per_iter, tight: tight };
