FN mIRLowering__initialize(MUTABLE self: MIRLowering, input: MIRLoweringInput = MIRLoweringInput{ struct_schemas: {}, enum_schemas: {}, union_schemas: {}, schema_lookup: NIL, lifecycle_registry: lifecycleRegistry__empty(), fn_sigs: {}, moved_guard_info: {}, importer: NIL, source_dir: NIL, debug_mode: FALSE, target: :zig, function_counter_seeds: {} }) RETURNS Void ->
    MUTABLE schemas = mIRLoweringSchemas__new(CAST(COPY input.struct_schemas AS {String@symbol}StructSchema), input.enum_schemas, CAST(COPY input.union_schemas AS {String@symbol}UnionSchema));
    IF input.schema_lookup EXISTS AS schema_lookup_value THEN
      MUTABLE schema_lookup_value_mutable = COPY schema_lookup_value;
      MUTABLE external_lookup = COPY schema_lookup_value_mutable;
      mIRLoweringSchemas__replace_lookup_proc_mut(&schemas, %(name) USE(external_lookup, schemas) -> (mIRLoweringSchemas__lookup(schemas, name) OR_ELSE UNWRAP (external_lookup(name))));
    END
    self.state = MIRLoweringState{ input: COPY input, schemas: schemas, counters: mIRLoweringCounters__new(), function_state: COPY FunctionState{ current_function_context: NIL, pending_stmts: List[], current_decl_alloc: NIL, current_expected_type: NIL, current_sink_type: NIL, current_reassignment_target: NIL, current_bindings: {}, current_binding_types: {}, fn_alloc_marked_names: {}, lowered_alloc_names: Set[], lowered_guarded_cleanup_names: Set[], decl_zig_name_map: {}, guarded_cleanup_names: {}, fn_name_rename_map: {}, node_store_types: Set[] }, runtime: COPY MIRLoweringRuntimeState{ rt_name: "rt", emitter: NIL }, program: COPY MIRLoweringProgramState{ fn_sigs: COPY input.fn_sigs, importer: COPY input.importer, source_dir: COPY input.source_dir, debug_mode: input.debug_mode, target: COPY input.target, shard_context: NIL, emitted_extern_modules: Set[], pipeline_host: NIL, emitted_types: Set[], emitted_require_modules: Set[], emitted_import_type_aliases: Set[], used_sharded_map: FALSE, use_debug_allocator: NIL, fn_nodes: {}, function_counter_snapshots: {}, runtime_init_consts: List[], module_const_inits: Set[], module_global_names: Set[] }, capture: MIRLoweringCaptureState{ current_bg_pointer_captures: NIL, current_lambda_pointer_params: Set[], current_fiber_capture_symbols: {}, do_capture_map: NIL, current_stream_is_inf: NIL, current_stream_local: NIL, current_stream_close_label: NIL, current_fsm_inherited_alloc_names: Set[], current_fsm_inherited_guarded_names: Set[], current_fsm_owned_result_guards: {}, last_fsm_result_transfer_facts: List[] }, capabilities: COPY MIRLoweringCapabilityState{ locked_unwrap_map: NIL, rc_unwrap_map: NIL, with_alias_alloc_map: NIL, with_alias_owner_map: NIL, polymorphic_alias_type_map: NIL, if_bind_aliases: Set[], if_bind_pointer_aliases: Set[], atomic_emit_raw: FALSE }, ownership: COPY MIRLoweringOwnershipState{ next_lowered_node_id: 0, finalized_body_ids: Set[], finalized_node_ids: Set[] }, test: COPY MIRLoweringTestState{ active_st