FN castOptionalAssignmentNameToOptionalGetField(value: ?AssignmentName) RETURNS ?GetField ->
  IF value != NIL THEN
    IF value IS_A GetField AS cast_payload THEN
      RETURN cast_payload;
    END
  END
  RETURN NIL;
END
FN castOptionalAstReturnSearchNodeToAnyMultiowned(value: ?AstReturnSearchNode) RETURNS Any@multiowned ->
  IF value != NIL THEN
    IF value IS_A Any@multiowned AS cast_payload THEN
      RETURN cast_payload;
    END
  END
  RETURN panic("Invalid cast to Any@multiowned");
END
FN castOptionalEmittableToLet(value: ?Emittable) RETURNS Let ->
  IF value != NIL THEN
    IF value IS_A Let AS cast_payload THEN
      RETURN cast_payload;
    END
  END
  RETURN panic("Invalid cast to Let");
END
FN castOptionalLocatableToLocatable(value: ?Locatable) RETURNS Locatable ->
  IF value == NIL THEN
    panic("Invalid cast to Locatable");
  END
  PARTIAL MATCH value? START
    Locatable.ASTProgram AS cast_payload -> RETURN Locatable{ ASTProgram: COPY cast_payload };,
    Locatable.RequireNode AS cast_payload -> RETURN Locatable{ RequireNode: COPY cast_payload };,
    Locatable.ProtocolRequirement AS cast_payload -> RETURN Locatable{ ProtocolRequirement: COPY cast_payload };,
    Locatable.ProtocolDef AS cast_payload -> RETURN Locatable{ ProtocolDef: COPY cast_payload };,
    Locatable.FunctionDef AS cast_payload -> RETURN Locatable{ FunctionDef: COPY cast_payload };,
    Locatable.ImplementationDef AS cast_payload -> RETURN Locatable{ ImplementationDef: COPY cast_payload };,
    Locatable.ConformanceDef AS cast_payload -> RETURN Locatable{ ConformanceDef: COPY cast_payload };,
    Locatable.MIRStructDef AS cast_payload -> RETURN Locatable{ MIRStructDef: COPY cast_payload };,
