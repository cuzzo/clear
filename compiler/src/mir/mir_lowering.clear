    MUTABLE type_info = TRY (aST__full_type_mut(Locatable{ DefaultArrayLit: COPY node }));
    MUTABLE elem_type = UNWRAP (TRY (type__element_type(type_info)));
    MUTABLE elem_zig = TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY elem_type }));
    MUTABLE count: ?TypeArrayCapacity = type__capacity(type_info);
    IF count? IS_A Int64 AS int64 THEN
      RETURN ArrayDefaultInit{ elem_type: COPY elem_zig, count: COPY int64.toString(), default_value: Emittable{ Lit: COPY TRY (mIRLowering__default_array_value(self, elem_type)) }, alloc: :frame, lowered_node_id: CAST(type_info AS ?LoweredNodeId), ownership_consumption: NIL, result_type: CAST(NIL AS Type)};
    ELSE
      panic("default fixed-array literal requires an integer capacity");
    END
END
PRIVATE FN mIRLowering__default_array_value(self: MIRLowering, elem_type: Type) RETURNS !Lit ->
    IF (type__resolved(elem_type) == :Int64) OR (type__resolved(elem_type) == :Int32) OR (type__resolved(elem_type) == :Int16) OR (type__resolved(elem_type) == :Int8) THEN
      RETURN Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL };
    ELSE_IF (type__resolved(elem_type) == :Float64) OR (type__resolved(elem_type) == :Float32) THEN
      RETURN Lit{ value: "0.0", lowered_node_id: NIL, ownership_consumption: NIL };
    ELSE_IF (type__resolved(elem_type) == :String) THEN
      RETURN Lit{ value: "\"\"", lowered_node_id: NIL, ownership_consumption: NIL };
    ELSE_IF (type__resolved(elem_type) == :Bool) OR (type__resolved(elem_type) == :Boolean) THEN
      RETURN Lit{ value: "false", lowered_node_id: NIL, ownership_consumption: NIL };
    ELSE
      panic("unsupported fixed-array default element type {}");
    END
END
PRIVATE FN mIRLowering__lower_hash_lit(MUTABLE self: MIRLowering, MUTABLE node: HashLit) RETURNS !Emittable ->
    MUTABLE plan = TRY (mIRLowering__hash_literal_plan(&self, node));
    MUTABLE capability = TRY (mIRLowering__hash_literal_capability_plan(&self, plan));
    IF node.pairs.empty?() THEN
      IF capability.empty_result EXISTS AS empty_result_value THEN
        RETURN COPY empty_result_value;
      END
      RETURN Emittable{ ContainerInit: COPY mIRLowering__empty_hash_literal(self, plan, capability.zig_type) };
    END
    RETURN Emittable{ MIRBlockExpr: COPY TRY (mIRLowering__non_empty_hash_literal(&self, node, plan, capability)) };
END
PRIVATE FN mIRLowering__hash_literal_capability_plan(MUTABLE self: MIRLowering, plan: HashLiteralPlan) RETURNS !HashLiteralCapabilityPlan ->
    IF !(hashLiteralPlan__capability_wrapped?(plan)) THEN
      RETURN mIRLowering__unwrapped_hash_literal_capability_plan(self, plan);
    END
    IF type__striped?(plan.type_info) THEN
      RETURN TRY (mIRLowering__striped_hash_literal_capability_plan(&self, plan));
    ELSE
      RETURN TRY (mIRLowering__composed_hash_literal_capability_plan(self, plan));
    END
END
PRIVATE FN mIRLowering__unwrapped_hash_literal_capability_plan(self: MIRLowering, plan: HashLiteralPlan) RETURNS HashLiteralCapabilityPlan ->
    RETURN HashLiteralCapabilityPlan{ zig_type: COPY plan.zig_type, init_value: NIL, empty_result: NIL, result_wrap: NIL, result_wrap_fn: NIL };
END
PRIVATE FN mIRLowering__striped_hash_literal_capability_plan(MUTABLE self: MIRLowering, plan: HashLiteralPlan) RETURNS !HashLiteralCapabilityPlan ->
    MUTABLE bare_type = TRY (type__new(TypeConstructionInput{ StringValue: COPY CAST(type__resolved(plan.type_info) AS String) }));
    TRY (type__copy_striped_map_topology_from_mut(&bare_type, plan.type_info));
    MUTABLE zig_type = TRY (type__zig_type(bare_type));
    MUTABLE init_value = mIRLowering__hash_literal_init_struct(self, zig_type, plan.alloc, TRY (type__map_init_needs_alloc?(bare_type)));
    MUTABLE wrap_fn: String = "";
    IF plan.arc_wrapped THEN
      wrap_fn = "arcCreate";
    ELSE
      wrap_fn = "rcCreate";
    END
    MUTABLE empty_result: CapWrap = castEmittableToCapWrap(TRY (mIRLowering__with_ownership_consumption(&self, Emittable{ CapWrap: COPY CapWrap{ inner: Emittable{ StructInit: COPY init_value }, zig_base: COPY zig_type, strategy: :own_only, sync_fn: NIL, sync_type: NIL, own_fn: COPY wrap_fn, alloc: :heap, lowered_node_id: NIL, ownership_consumption: NIL } }, TRY (mIRLowering__mir_ident_names(self, Emittable{ StructInit: COPY init_value })), "MIR::CapWrap", :owned_sink, :heap)));
    RETURN HashLiteralCapabilityPlan{ zig_type: COPY zig_type, init_value: COPY mIRLowering__hash_literal_init_struct(self, zig_type, plan.alloc, TRY (type__map_init_needs_alloc?(bare_type))), empty_result: Emittable{ CapWrap: COPY empty_result }, result_wrap: :striped, result_wrap_fn: COPY wrap_fn };
END
PRIVATE FN mIRLowering__composed_hash_literal_capability_plan(self: MIRLowering, plan: HashLiteralPlan) RETURNS !HashLiteralCapabilityPlan ->
    MUTABLE bare_type = TRY (type__bare_data_type(plan.type_info));
    MUTABLE zig_type = TRY (type__zig_type(bare_type));
    MUTABLE init_value = mIRLowering__hash_literal_init_struct(self, zig_type, plan.alloc, TRY (type__map_init_needs_alloc?(bare_type)));
    RETURN HashLiteralCapabilityPlan{ zig_type: COPY zig_type, init_value: COPY init_value, empty_result: COPY mIRLowering__compose_capability_wrap(self, Emittable{ StructInit: COPY init_value }, zig_type, plan.type_info, :heap), result_wrap: :composed, result_wrap_fn: NIL };
END
PRIVATE FN mIRLowering__hash_literal_init_struct(self: MIRLowering, zig_type: String, alloc: String@symbol, needs_alloc: Bool) RETURNS StructInit ->
    MUTABLE fields = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_638: ?[]StructInitField = NIL;
    IF needs_alloc THEN
      rtoc_ternary_value_638 = [mIR__named_field(symbol("alloc"), Emittable{ AllocatorRef: COPY AllocatorRef{ kind: COPY alloc, lowered_node_id: NIL, ownership_consumption: NIL } })];
    ELSE
      rtoc_ternary_value_638 = List[];
    END
    rtoc_ternary_value_638? };
    RETURN StructInit{ zig_type: COPY zig_type, fields: COPY fields, lowered_node_id: NIL, ownership_consumption: NIL };
END
PRIVATE FN mIRLowering__empty_hash_literal(self: MIRLowering, plan: HashLiteralPlan, zig_type: String) RETURNS ContainerInit ->
    MUTABLE strategy = IF mIRLowering__hash_literal_empty_needs_alloc?(self, zig_type) THEN
      :map_bare
    ELSE
      :map_empty
    END;
    RETURN ContainerInit{ zig_type: COPY zig_type, strategy: COPY strategy, alloc: COPY plan.alloc, capacity: NIL, lowered_node_id: NIL, ownership_consumption: NIL };
END
PRIVATE FN mIRLowering__hash_literal_empty_needs_alloc?(self: MIRLowering, zig_type: String) RETURNS Bool ->
    RETURN ((!(zig_type.contains?("PartitionedStringMap")) AND !(zig_type.contains?("PartitionedNumericMap"))) AND !(zig_type.contains?("NumericMapType")));
END
PRIVATE FN mIRLowering__non_empty_hash_literal(MUTABLE self: MIRLowering, node: HashLit, plan: HashLiteralPlan, capability: HashLiteralCapabilityPlan) RETURNS !MIRBlockExpr ->
    MUTABLE items: []Emittable = List[];
    MUTABLE literal_id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_640 = mIRLowering__lowering_counters(&self);
    mIRLoweringCounters__next_block_expr_id(&rtoc_mutable_receiver_640) };
    MUTABLE label = "__hm_blk_${mIRLoweringGeneratedId__to_s(literal_id)}";
    MUTABLE hm_name = "__hm_${mIRLoweringGeneratedId__to_s(literal_id)}";
    MUTABLE alloc_expr = TRY (mIRLowering__hash_literal_allocator_expr(&self, plan));
    &items.append(Emittable{ Let: COPY Let{ name: COPY hm_name, init: Emittable{ StructInit: COPY (capability.init_value OR_ELSE mIRLowering__hash_literal_init_struct(self, capability.zig_type, plan.alloc, TRUE)) }, mutable: TRUE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
    FOR rtoc_pair IN node.pairs DO
    MUTABLE rtoc_key: Locatable = COPY rtoc_pair._0;
    MUTABLE val_node: Locatable = COPY rtoc_pair._1;
    MUTABLE outer_pending = COPY mIRLowering__function_state(&self).pending_stmts;
    self.state.function_state.pending_stmts = List[];
    MUTABLE put_stmt = TRY (mIRLowering__hash_literal_put_stmt(&self, &rtoc_key, &val_node, plan, alloc_expr, hm_name));
    MUTABLE pair_stmts = COPY mIRLowering__function_state(&self).pending_stmts;
    self.state.function_state.pending_stmts = outer_pending;
    # Appending out of a value block leaves the appended node borrowed; the
    # statement form gives it an owner.
    IF (pair_stmts.length() == 0) THEN
      &items.append(Emittable{ ExprStmt: COPY put_stmt });
    ELSE
      &items.append(Emittable{ MIRBlockExpr: COPY MIRBlockExpr{ label: NIL, body: COPY (pair_stmts + [put_stmt]), lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL } });
    END
    END
    MUTABLE result = mIRLowering__hash_literal_result(self, Emittable{ Ident: COPY Ident{ name: COPY hm_name, lowered_node_id: NIL, ownership_consumption: NIL } }, plan, capability);
    IF hashLiteralCapabilityPlan__wraps_result?(capability) THEN
      MUTABLE wrapped_name = "__hm_wrapped_${mIRLoweringGeneratedId__to_s(literal_id)}";
      &items.append(Emittable{ Let: COPY Let{ name: COPY wrapped_name, init: COPY result, mutable: FALSE, annotation: COPY TRY (type__new(TypeConstructionInput{ Type: COPY plan.type_info })), suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
      result = Emittable{ Ident: COPY Ident{ name: COPY wrapped_name, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    &items.append(Emittable{ BreakStmt: COPY BreakStmt{ label: COPY label, value: COPY result, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    MUTABLE block = MIRBlockExpr{ label: COPY label, body: items, lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
    block.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY plan.type_info }));
    RETURN block;
END
PRIVATE FN mIRLowering__hash_literal_allocator_expr(MUTABLE self: MIRLowering, plan: HashLiteralPlan) RETURNS !MIRMethodCall ->
    RETURN MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: mIRLowering__runtime_binding_name(&self), lowered_node_id: NIL, ownership_consumption: NIL } }, method: COPY hashLiteralPlan__allocator_method(plan), args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
END
PRIVATE FN mIRLowering__hash_literal_put_stmt(MUTABLE self: MIRLowering, MUTABLE key_node: Locatable, MUTABLE val_node: Locatable, plan: HashLiteralPlan, alloc_expr: MIRMethodCall, hm_name: String) RETURNS !ExprStmt ->
    MUTABLE key_mir: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(key_node)));
    MUTABLE value_type = TRY (type__value_type(plan.type_info));
    MUTABLE raw_value = mIRLowering__with_decl_alloc(&self, plan.alloc, %() USE(plan, MUTABLE val_node, value_type, MUTABLE self) -> {
    MUTABLE lowered_branch_value: ?Emittable = NIL;
      IF value_type THEN
        lowered_branch_value = mIRLowering__with_expected_type(&self, value_type, %() USE(MUTABLE val_node, MUTABLE self) -> {
      MUTABLE rtoc_lambda_result_646: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(val_node)));
      rtoc_lambda_result_646
        });
      ELSE
        lowered_branch_value = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(val_node)));
      END
    MUTABLE lowered: ?Emittable = lowered_branch_value;
    MUTABLE placed: Emittable = COPY UNWRAP (lowered);
    IF value_type THEN
      placed = COPY TRY (mIRLowering__place_value_for_destination(&self, COPY UNWRAP (lowered), &val_node, plan.alloc, TypeTypeInput{ Type: COPY UNWRAP (value_type) }));
    END
    TRY (mIRLowering__materialize_owned_sink_value(&self, placed, val_node, plan.alloc, TypeTypeInput{ Type: COPY UNWRAP (value_type) }))
    });
    MUTABLE value_mir = TRY (mIRLowering__hoist_alloc(&self, &raw_value, &val_node, TRUE));
    MUTABLE operands = (TRY (mIRLowering__ownership_operands_for_value(&self, UNWRAP (key_mir), &key_node, "hash literal key", plan.alloc)) + TRY (mIRLowering__ownership_operands_for_value(&self, &value_mir, &val_node, "hash literal value", plan.alloc)));
    MUTABLE base_contract = TRY (callableContract__no_ownership(4));
    MUTABLE put_contract = callableContract__new(base_contract.signature, TRY (ownershipContract__consume_operands(operands)), 4);
    RETURN ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: COPY hm_name, lowered_node_id: NIL, ownership_consumption: NIL } }, method: "put", args: [CAST(alloc_expr AS Any), CAST(alloc_expr AS Any), CAST(key_mir AS Any), CAST(value_mir AS Any)], try_wrap: TRUE, callable_contract: COPY put_contract, owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN mIRLowering__hash_literal_result(self: MIRLowering, result: Emittable, plan: HashLiteralPlan, capability: HashLiteralCapabilityPlan) RETURNS Emittable ->
    IF hashLiteralCapabilityPlan__striped_result?(capability) THEN
      RETURN Emittable{ CapWrap: COPY CapWrap{ inner: COPY result, zig_base: COPY capability.zig_type, strategy: :own_only, sync_fn: NIL, sync_type: NIL, own_fn: COPY UNWRAP (capability.result_wrap_fn), alloc: :heap, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF hashLiteralCapabilityPlan__composed_result?(capability) THEN
      RETURN mIRLowering__compose_capability_wrap(self, result, capability.zig_type, plan.type_info, :heap);
    END
    RETURN COPY result;
END
PRIVATE FN mIRLowering__list_literal_plan(MUTABLE self: MIRLowering, node: ListLit) RETURNS !ListLiteralPlan ->
    MUTABLE expected_ti: ?Type = TRY (type__from_node(mIRLowering__function_state(&self).current_expected_type));
    MUTABLE expected_owned_list = (((((expected_ti != NIL) AND TRY (type__direct_indexable_collection?(expected_ti))) AND type__dynamic?(expected_ti)) AND !(TRY (type__string?(expected_ti)))));
    IF expected_ti != NIL THEN
      expected_owned_list = type__collection?(expected_ti);
    END
    MUTABLE ti:? =   IF expected_owned_list THEN
      expected_ti
    ELSE
      (locatable__coerced_type_info(Locatable{ ListLit: COPY node }) OR_ELSE TRY (aST__full_type_mut(Locatable{ ListLit: COPY node })))
    END;
    MUTABLE type_info = TRY (type__new( CAST(ti AS TypeConstructionInput)));
    MUTABLE elem_type: ?Type = TRY (type__element_type(type_info));
    MUTABLE elem_ti_branch_value: ?Type = NIL;
    IF elem_type EXISTS AS elem_type_value THEN
      elem_ti_branch_value = TRY (type__new(TypeConstructionInput{ Type: COPY elem_type_value }));
    ELSE
      elem_ti_branch_value = NIL;
    END
    MUTABLE elem_ti: ?Type = elem_ti_branch_value;
    MUTABLE requested_alloc = (mIRLowering__function_state(&self).current_decl_alloc OR_ELSE TRY (mIRLowering__alloc_for_node(&self, Locatable{ ListLit: COPY node })));
    # An owned String does not leave an IF expression implicitly; both fields
    # default to the no-element answer and only differ when there is one.
    MUTABLE rtoc_element_zig: String = "u8";
    MUTABLE rtoc_needs_owned: Bool = FALSE;
    IF elem_ti EXISTS AS rtoc_elem_ti THEN
      rtoc_element_zig = TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY rtoc_elem_ti }));
      rtoc_needs_owned = TRY (type__recursive_cleanup_shape?(rtoc_elem_ti, mIRLowering__mir_schema_lookup(&self)));
    END
    RETURN ListLiteralPlan{ type_info: COPY type_info, alloc: COPY requested_alloc, element_type: COPY elem_ti, element_zig: COPY rtoc_element_zig, element_needs_owned_storage: rtoc_needs_owned };
END
PRIVATE FN mIRLowering__hash_literal_plan(MUTABLE self: MIRLowering, node: HashLit) RETURNS !HashLiteralPlan ->
    MUTABLE expected_ti: ?Type = TRY (type__from_node(mIRLowering__function_state(&self).current_expected_type));
    IF expected_ti EXISTS AS expected_ti_value THEN
      IF type__optional?(expected_ti_value) THEN
      expected_ti = TRY (type__non_optional_type( UNWRAP (expected_ti)));
    END
    END
    MUTABLE ti:? =   IF (IF expected_ti != NIL THEN
      type__map?(expected_ti)
    ELSE
      NIL
    END) THEN
      expected_ti
    ELSE
      TRY (type__new(TypeConstructionInput{ Type: COPY (locatable__coerced_type_info(Locatable{ HashLit: COPY node }) OR_ELSE TRY (aST__full_type_mut(Locatable{ HashLit: COPY node }))) }))
    END;
    MUTABLE map_alloc = (mIRLowering__function_state(&self).current_decl_alloc OR_ELSE TRY (mIRLowering__alloc_for_node(&self, Locatable{ HashLit: COPY node })));
    RETURN HashLiteralPlan{ type_info: UNWRAP (COPY ti), alloc: COPY map_alloc, zig_type: COPY TRY (mIRLowering__transpile_type(self, CAST(ti AS MIRLoweringType))), arc_wrapped: type__shared?( UNWRAP (ti)), rc_wrapped: type__multiowned?( UNWRAP (ti)) };
END
PRIVATE FN mIRLowering__binding_placement_fact(MUTABLE self: MIRLowering, node: VarDecl, type_info: Type, binding_entry: CleanupEntry, heap_return_var: Bool, heap_return_binding_allocates: Bool) RETURNS !BindingFact ->
    MUTABLE storage = IF ((((IF node.symbol != NIL THEN
      symbolEntry__heap_storage?( UNWRAP (node.symbol))
    ELSE
      NIL
    END) != NIL) OR heap_return_binding_allocates)) THEN
      :heap
    ELSE
      :frame
    END;
    MUTABLE cleanup_alloc =   IF (storage == :heap) THEN
      :heap
    ELSE_IF heap_return_var THEN
      :frame
    ELSE_IF cleanupEntry__present?(binding_entry) THEN
      cleanupEntry__alloc(binding_entry)
    ELSE
      TRY (mIRLowering__alloc_for_node(&self, Locatable{ VarDecl: COPY node }))
    END;
    MUTABLE alloc = placement__binding_alloc(storage, cleanup_alloc, :frame);
    MUTABLE scope = IF cleanupEntry__present?(binding_entry) THEN
      cleanupEntry__scope(binding_entry)
    ELSE
      placement__cleanup_scope(alloc)
    END;
    RETURN BindingFact{ name: COPY CAST(node.name AS String), type_info: COPY type_info, storage: COPY storage, alloc: COPY alloc, scope: COPY scope, heap_return: heap_return_var, escape_reason: IF (storage == :heap) THEN
      :symbol_storage
    ELSE
      NIL
    END };
END
PRIVATE FN mIRLowering__tied_shared_family_return_param(self: MIRLowering, node: FunctionDef, mutable_scalar_params: [Set]String) RETURNS ?String ->
    MUTABLE ret: ?Type = COPY node.return_type;
    IF !(((ret != NIL) AND type__polymorphic_shared?(ret))) THEN
      RETURN NIL;
    END
    IF !(type__generic_type_parameter?( ret)) THEN
      RETURN NIL;
    END
    MUTABLE params = node.params |> WHERE {
    MUTABLE pt = COPY _.type;
    (type__shared?(pt) AND (type__resolved(pt) == type__resolved( ret)))
    };
    IF !((params.length() == 1)) THEN
      RETURN NIL;
    END
    MUTABLE name = (UNWRAP (params.first())).name;
    MUTABLE zig_name: String = "";
    IF mutable_scalar_params.contains?(name) THEN
      zig_name = "_m_${name}";
    ELSE
      zig_name = name;
    END
    RETURN "@TypeOf(${zig_name})";
END
PRIVATE FN mIRLowering__compose_capability_wrap(self: MIRLowering, inner_mir: Emittable, bare_zig_t: String, ft: Type, alloc: String@symbol) RETURNS Emittable ->
    MUTABLE is_atomic_ptr = type__atomic_ptr?(ft);
    MUTABLE sync_fn: ?String = mIRLowering__sync_wrap_constructor(self, type__sync(ft), is_atomic_ptr);
    MUTABLE sync_t: ?String = mIRLowering__sync_wrap_type(self, type__sync(ft), bare_zig_t, is_atomic_ptr);
    # A MATCH whose arms are optional strings has no implicitly copyable
    # result; the statement form assigns each arm.
    MUTABLE own_fn: ?String = NIL;
    PARTIAL MATCH type__ownership(ft) START
      :shared ->
        IF !(type__atomic?(ft)) THEN
          own_fn = "arcCreate";
        END,
      :multiowned ->
        IF !(type__atomic?(ft)) THEN
          own_fn = "rcCreate";
        END,
      DEFAULT -> PASS;
    END
    IF ((sync_fn != NIL) AND own_fn) THEN
      RETURN Emittable{ CapWrap: COPY CapWrap{ inner: COPY inner_mir, zig_base: COPY bare_zig_t, strategy: :both, sync_fn: COPY sync_fn, sync_type: COPY sync_t, own_fn: COPY own_fn, alloc: COPY alloc, lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE_IF sync_fn THEN
      RETURN Emittable{ CapWrap: COPY CapWrap{ inner: COPY inner_mir, zig_base: COPY bare_zig_t, strategy: :sync_only, sync_fn: COPY sync_fn, sync_type: COPY sync_t, own_fn: NIL, alloc: COPY alloc, lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE_IF own_fn THEN
      RETURN Emittable{ CapWrap: COPY CapWrap{ inner: COPY inner_mir, zig_base: COPY bare_zig_t, strategy: :own_only, sync_fn: NIL, sync_type: NIL, own_fn: COPY own_fn, alloc: COPY alloc, lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE
      RETURN COPY inner_mir;
    END
END
PRIVATE FN mIRLowering__lower_var_decl(MUTABLE self: MIRLowering, MUTABLE node: VarDecl) RETURNS !NodeRoot ->
    MUTABLE facts = TRY (mIRLowering__var_decl_facts(&self, &node));
    IF node.module_const EXISTS AS module_const_value THEN
      MUTABLE module_const_value_mutable = COPY module_const_value;
      RETURN TRY (mIRLowering__lower_module_const(&self, &node, facts));
    END
    IF mIRLowering__program_state(self).module_global_names.contains?(CAST(node.name AS String)) THEN
      RETURN TRY (mIRLowering__lower_module_global(&self, &node, facts));
    END
    MUTABLE init = mIRLowering__with_decl_alloc(&self, facts.decl_alloc, %() USE(facts, MUTABLE node, MUTABLE self) -> TRY (mIRLowering__lower_var_decl_init(&self, &node, facts.ft, facts.bare_zig, facts.has_caps, facts.decl_alloc)));
    init = TRY (mIRLowering__ensure_cleanup_binding_owns_string_init(self, init, facts, node.value));
    MUTABLE safe_name = TRY (mIRLowering__var_decl_safe_name(&self, node, facts.has_mir_drop));
    MUTABLE rtoc_index_receiver_649 = TRY (functionState__binding_types(mIRLowering__function_state(&self)));
    rtoc_index_receiver_649[safe_name] = COPY facts.ft;
    TRY (mIRLowering__stamp_var_decl_init_target_mut(&self, &init, safe_name, facts.decl_alloc));
    MUTABLE let_node = Let{ name: COPY safe_name, init: COPY init, mutable: facts.keyword_mutable, annotation: COPY facts.annotation, suppression: COPY TRY (mIRLowering__var_decl_suppression(&self, safe_name, node, facts, &init)), alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL };
    MUTABLE init_effect = TRY (ownershipEffect__of(init));
    IF TRY (mIRLowering__var_decl_source_transfer_required?(&self, &node, facts, init_effect)) THEN
      let_node = castEmittableToLet(TRY (mIRLowering__with_ownership_consumption_for_value(&self, Emittable{ Let: COPY let_node }, &init, &node.value, "var init", :owned_sink, facts.decl_alloc)));
    END
    MUTABLE nodes = TRY (materializationPacket__statements(TRY (mIRLowering__var_decl_materialization_plan(&self, &node, facts, safe_name, &init, let_node))));
    FOR _ IN nodes DO
    IF _ IS_A AllocMark THEN
      &self.state.function_state.lowered_alloc_names.insert(COPY CAST(emittable__name(_) AS String));
    END
    END
    IF (TRY (type__node_reference?(facts.ft)) AND (!(nodes |> ANY _ IS_A AllocMark))) THEN
      nodes = (List[Emittable{ AllocMark: COPY AllocMark{ name: COPY safe_name, alloc: :heap, type_info: COPY facts.ft, scope: :heap, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] + nodes);
      &nodes.append(CAST(Cleanup{ name: COPY safe_name, cleanup_entry: cleanupEntry__build(:uniform, :heap, FALSE), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable));
    END
    MUTABLE owner_marks = TRY (mIRLowering__field_owner_move_marks(&self, node));
    nodes = ruby_array_concat_Stmt(nodes, owner_marks);
    IF (nodes.length() == 1) THEN
      RETURN COPY castStmtToNodeRoot(UNWRAP (nodes.first()));
    ELSE
      RETURN NodeRoot{ ArrayValue: nodes |> SELECT castStmtToEmittable(_) };
    END
END
PRIVATE FN mIRLowering__lower_module_const(MUTABLE self: MIRLowering, MUTABLE node: VarDecl, facts: VarDeclFacts) RETURNS !NodeRoot ->
    IF mIRLowering__const_init_error_fallible?(self, node) THEN
      RAISE Input, CompilerError, "{}error channel. Make the initializer infallible, or compute the value inside a function.";
    END
    MUTABLE safe_name = TRY (mIRLowering__var_decl_safe_name(&self, node, FALSE));
    MUTABLE rtoc_index_receiver_650 = TRY (functionState__binding_types(mIRLowering__function_state(&self)));
    rtoc_index_receiver_650[safe_name] = COPY facts.ft;
    MUTABLE heap_value, const_pending = mIRLowering__lower_head(&self, %() USE(MUTABLE node, MUTABLE self) -> {
    MUTABLE rtoc_lambda_result_652: ?Emittable = mIRLowering__with_decl_alloc(&self, :heap, %() USE(MUTABLE node, MUTABLE self) -> {
    MUTABLE rtoc_lambda_result_651: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(node.value)));
    rtoc_lambda_result_651
    });
    rtoc_lambda_result_652
    });
    IF ((facts.has_mir_drop OR TRY (mIRLowering__mir_allocates?(&self, heap_value))) OR (const_pending).any?()) THEN
      RETURN TRY (mIRLowering__lower_runtime_init_const(&self, node, facts, safe_name, UNWRAP (heap_value), const_pending));
    END
    self.state.function_state.pending_stmts = ruby_array_concat_Stmt(mIRLowering__function_state(&self).pending_stmts, CAST(const_pending AS []Emittable));
    MUTABLE init = mIRLowering__with_decl_alloc(&self, facts.decl_alloc, %() USE(facts, MUTABLE node, MUTABLE self) -> TRY (mIRLowering__lower_var_decl_init(&self, &node, facts.ft, facts.bare_zig, facts.has_caps, facts.decl_alloc)));
    TRY (mIRLowering__stamp_var_decl_init_target_mut(&self, &init, safe_name, facts.decl_alloc));
    MUTABLE let = Let{ name: COPY safe_name, init: COPY init, mutable: FALSE, annotation: COPY facts.annotation, suppression: COPY TRY (mIRLowering__var_decl_suppression(&self, safe_name, node, facts, &init)), alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL };
    let.module_const = TRUE;
    let.const_visibility = COPY node.const_visibility;
    RETURN NodeRoot{ Emittable: Emittable{ Let: COPY let } };
END
PRIVATE FN mIRLowering__lower_module_global(MUTABLE self: MIRLowering, MUTABLE node: VarDecl, facts: VarDeclFacts) RETURNS !NodeRoot ->
    MUTABLE safe_name = TRY (mIRLowering__var_decl_safe_name(&self, node, FALSE));
    MUTABLE rtoc_index_receiver_653 = TRY (functionState__binding_types(mIRLowering__function_state(&self)));
    rtoc_index_receiver_653[safe_name] = COPY facts.ft;
    MUTABLE heap_value, pending = mIRLowering__lower_head(&self, %() USE(MUTABLE node, MUTABLE self) -> {
    MUTABLE rtoc_lambda_result_655: ?Emittable = mIRLowering__with_decl_alloc(&self, :heap, %() USE(MUTABLE node, MUTABLE self) -> {
    MUTABLE rtoc_lambda_result_654: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(node.value)));
    rtoc_lambda_result_654
    });
    rtoc_lambda_result_655
    });
    IF ((facts.has_mir_drop OR TRY (mIRLowering__mir_allocates?(&self, heap_value))) OR (pending).any?()) THEN
      RETURN TRY (mIRLowering__lower_runtime_init_const(&self, node, facts, safe_name, UNWRAP (heap_value), pending));
    END
    self.state.function_state.pending_stmts = ruby_array_concat_Stmt(mIRLowering__function_state(&self).pending_stmts, CAST(pending AS []Emittable));
    RETURN NodeRoot{ Emittable: COPY CAST(Let{ name: COPY safe_name, init: COPY UNWRAP (heap_value), mutable: TRUE, annotation: COPY facts.annotation, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } AS Emittable) };
END
PRIVATE FN mIRLowering__lower_runtime_init_const(MUTABLE self: MIRLowering, node: VarDecl, facts: VarDeclFacts, safe_name: String, value: Emittable, prelude: []Emittable) RETURNS !NodeRoot ->
    MUTABLE annotation: ?Type = COPY facts.annotation;
    MUTABLE zig_type: String = "";
    IF annotation EXISTS AS annotation_value THEN
      zig_type = TRY (type__nested_zig_type(annotation_value));
    ELSE
      zig_type = TRY (type__nested_zig_type(facts.ft));
    END
    &self.state.program.runtime_init_consts.append(COPY ConstInitEntry{ name: COPY safe_name, zig_type: COPY zig_type, init: COPY value, type_info: facts.ft, prelude: COPY prelude });
    RETURN NodeRoot{ Emittable: COPY CAST(ModuleVar{ name: COPY safe_name, zig_type: COPY zig_type, visibility: UNWRAP (COPY node.const_visibility), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) };
END
PRIVATE FN mIRLowering__const_init_error_fallible?(self: MIRLowering, node: VarDecl) RETURNS Bool ->
    MUTABLE value = node.value;
    RETURN !(!(((aST__node_error_union_type(value) != NIL))));
END
PRIVATE FN mIRLowering__ensure_cleanup_binding_owns_string_init(self: MIRLowering, init: Emittable, facts: VarDeclFacts, ast_value: Locatable) RETURNS !Emittable ->
    MUTABLE rtoc_binding_entry: CleanupEntry = COPY facts.binding_entry;
    MUTABLE rtoc_plan_needs_drop: Bool = FALSE;
    IF cleanupEntry__lifecycle_plan(rtoc_binding_entry) EXISTS AS rtoc_lifecycle_plan THEN
      rtoc_plan_needs_drop = lifecyclePlan__needs_drop?(rtoc_lifecycle_plan);
    END
    MUTABLE owns_storage: Bool = (facts.has_mir_drop OR rtoc_plan_needs_drop);
    IF !(owns_storage) THEN
      RETURN COPY init;
    END
    # `?String` owns exactly what `String` owns -- the optional adds a tag, not
    # a buffer -- but `string?` spells the wrapper out. Asking the wrapper left
    # an optional binding holding whatever slice the initializer produced while
    # its cleanup freed that slice.
    MUTABLE rtoc_payload: Type = COPY type__non_optional_type(facts.ft);
    IF !(TRY (type__string?(rtoc_payload))) THEN
      RETURN COPY init;
    END
    IF type__symbol?(rtoc_payload) THEN
      RETURN COPY init;
    END
    MUTABLE effect = TRY (ownershipEffect__of(init));
    IF effect.produces_owned THEN
      RETURN COPY init;
    END
    IF (IF ast_value IS_A Identifier AS identifier THEN aST__moved?(Locatable{ Identifier: COPY identifier }) ELSE FALSE END) THEN
      RETURN COPY init;
    END
    # An optional cannot go through the raw slice dupe: `alloc.dupe(u8, opt)`
    # is not typed. dupeValue carries the absent case through unchanged.
    IF type__optional?(facts.ft) THEN
      RETURN Emittable{ DeepCopy: COPY DeepCopy{ source: COPY init, zig_type: COPY TRY (type__zig_type(facts.ft)), elem_type: NIL, strategy: :full_value, alloc: COPY facts.decl_alloc, copy_shape: COPY deepCopy__copy_shape_for_zig_type(TRY (type__zig_type(facts.ft))), type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    RETURN Emittable{ DupeSlice: COPY DupeSlice{ source: COPY init, alloc: COPY facts.decl_alloc, lowered_node_id: NIL, ownership_consumption: NIL } };
END
PRIVATE FN mIRLowering__var_decl_facts(MUTABLE self: MIRLowering, MUTABLE node: VarDecl) RETURNS !VarDeclFacts ->
    MUTABLE is_mutable = (TRUE AND node.mutable);
    MUTABLE ft = TRY (type__new(TypeConstructionInput{ Type: COPY TRY (aST__full_type_mut(Locatable{ VarDecl: COPY node })) }));
    is_mutable = (is_mutable OR ((((TRY (type__dynamic_stream?(ft)) OR TRY (type__bounded_stream?(ft))) OR type__shared_promise?(ft)) OR TRY (type__open_stream?(ft))) OR TRY (type__inf_stream?(ft))));
    is_mutable = (is_mutable OR type__collection?(ft));
    is_mutable = (is_mutable OR type__any_sync?(ft));
    is_mutable = (is_mutable OR (type__resource?(ft) OR node.resource_close_plan));
    IF type__local?(ft) THEN
      is_mutable = FALSE;
    END
    IF (IF (IF node.symbol != NIL THEN
      symbolEntry__poly_borrow_target( UNWRAP (node.symbol))
    ELSE
      NIL
    END) != NIL THEN (IF node.symbol != NIL THEN
      symbolEntry__poly_borrow_target( UNWRAP (node.symbol))
    ELSE
      NIL
    END) ELSE (IF node.symbol != NIL THEN
      symbolEntry__mutable_ref_target( UNWRAP (node.symbol))
    ELSE
      NIL
    END) END) THEN
      is_mutable = TRUE;
    END
    is_mutable = (is_mutable == TRUE);
    MUTABLE node_entry: ?CleanupEntry@multiowned = COPY node.mir_binding_entry;
    MUTABLE decl_name = COPY CAST(node.name AS String);
    MUTABLE binding_entry:? = node_entry;
    MUTABLE transport_plan: ?PassStateValue = COPY node.ownership_transport_plan;
    MUTABLE inferred_borrow = (IF transport_plan IS_A OwnershipTransportPlan AS inferred_transport THEN (inferred_transport.action == :borrow) ELSE FALSE END);
    IF inferred_borrow THEN
      binding_entry = mIRLowering__new();
    END
    MUTABLE empty_optional_init = mIRLowering__optional_nil_initializer?(self, ft, node.value);
    MUTABLE has_mir_drop = (cleanupEntry__needs_cleanup?(UNWRAP (binding_entry)) AND !(cleanupEntry__match_as?(UNWRAP (binding_entry))));
    MUTABLE heap_return_var = (!(empty_optional_init) AND mIRLowering__current_function_heap_carry_return_var?(&self, CAST(node.name AS String)));
    MUTABLE heap_return_binding_allocates = (((heap_return_var AND (TRY (mIRLowering__escaping_value_alloc(&self, ft)) == :heap))) == TRUE);
    MUTABLE placement = TRY (mIRLowering__binding_placement_fact(&self, node, ft, UNWRAP (binding_entry), heap_return_var, heap_return_binding_allocates));
    MUTABLE actually_mutated = ((is_mutable AND TRUE) AND (node.var_mutated == TRUE));
    IF TRY (type__node_reference?(ft)) THEN
      actually_mutated = ((node.symbol != NIL) AND (((node.symbol)?).reassigned == TRUE));
    END
    actually_mutated = (actually_mutated == TRUE);
    MUTABLE is_heap = bindingFact__heap?(placement);
    MUTABLE has_mutable_cleanup = ((((((((((has_mir_drop OR type__collection?(ft)) OR TRY (type__dynamic_stream?(ft))) OR TRY (type__bounded_stream?(ft))) OR type__shared_promise?(ft)) OR TRY (type__open_stream?(ft))) OR TRY (type__inf_stream?(ft))) OR ((type__array?(ft) AND type__dynamic?(ft)))) OR is_heap) OR type__resource?(ft)) OR node.resource_close_plan);
    MUTABLE forced_var = (is_mutable AND has_mutable_cleanup);
    forced_var = (forced_var == TRUE);
    MUTABLE by_ref_borrow = (((node.symbol != NIL) AND ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_657 = ((node.symbol)?);
    symbolEntry__mutable_ref_target(rtoc_local_receiver_657) } == TRUE)) OR ((node.symbol != NIL) AND ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_658 = ((node.symbol)?);
    symbolEntry__poly_borrow_target(rtoc_local_receiver_658) } == TRUE)));
    MUTABLE keyword_mutable = (is_mutable AND (((actually_mutated OR forced_var) OR by_ref_borrow)));
    MUTABLE zig_type = TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY TRY (aST__full_type_mut(Locatable{ VarDecl: COPY node })) }));
    MUTABLE needs_annotation = ((((zigTypeMapper__zig_primitives().contains?(zig_type) OR type__fn_type?(ft)) OR type__error_union?(ft)) OR ((node.value IS_A Literal AND (locatable__type(node.value) == symbol("NIL"))))) OR ((TRY (type__string?(ft)) AND is_heap)));
    MUTABLE annotation_branch_value: ?Type = NIL;
    IF needs_annotation THEN
      annotation_branch_value = ft;
    ELSE
      annotation_branch_value = NIL;
    END
    MUTABLE annotation: ?Type = annotation_branch_value;
    MUTABLE base_decl_alloc = COPY placement.alloc;
    MUTABLE next_owned_alloc: ?String@symbol =   IF node.value IS_A NextExpr THEN
      TRY (mIRLowering__next_result_owned_alloc(&self, TRY (type__from_node_mut(locatable__expr(node.value), "NEXT source")), ft, base_decl_alloc))
    ELSE
      NIL
    END;
    MUTABLE source_owned_alloc: ?String@symbol = IF inferred_borrow THEN
      NIL
    ELSE
      TRY (mIRLowering__owned_binding_source_alloc(&self, node.value))
    END;
    MUTABLE init_ownership_effect_branch_value: ?OwnershipEffect = NIL;
    IF next_owned_alloc EXISTS AS next_owned_alloc_value THEN
      init_ownership_effect_branch_value = ownershipEffect__owned(next_owned_alloc_value);
    ELSE
      IF source_owned_alloc EXISTS AS source_owned_alloc_value THEN
        init_ownership_effect_branch_value = ownershipEffect__owned(source_owned_alloc_value);
      ELSE
        init_ownership_effect_branch_value = ownershipEffect__none();
      END
    END
    MUTABLE init_ownership_effect: OwnershipEffect = init_ownership_effect_branch_value?;
    MUTABLE decl_alloc = IF placement__explicit_heap?(base_decl_alloc) THEN
      :heap
    ELSE
      ((init_ownership_effect.alloc OR_ELSE base_decl_alloc))
    END;
    MUTABLE has_caps = !(!(((((type__any_sync?(ft) OR (type__ownership(ft) != :affine))) AND !(type__striped?(ft))))));
    MUTABLE bare_ft_branch_value: ?Type = NIL;
    IF has_caps THEN
      bare_ft_branch_value = TRY (type__bare_data_type((TRY (type__non_optional_type(ft)))));
    ELSE
      bare_ft_branch_value = ft;
    END
    MUTABLE bare_ft: Type = bare_ft_branch_value?;
    MUTABLE bare_zig = TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY bare_ft }));
    RETURN VarDeclFacts{ ft: COPY ft, binding_entry: binding_entry, has_mir_drop: has_mir_drop, actually_mutated: actually_mutated, forced_var: forced_var, keyword_mutable: keyword_mutable, annotation: COPY annotation, heap_return_var: (heap_return_var == TRUE), decl_alloc: COPY decl_alloc, init_ownership_effect: init_ownership_effect, source_owned_binding: !((source_owned_alloc == NIL)), has_caps: has_caps, bare_zig: COPY bare_zig, generic_id: type__id_handle?(ft) };
END
PRIVATE FN mIRLowering__optional_nil_initializer?(self: MIRLowering, type_info: Type, value: Locatable) RETURNS Bool ->
    IF !(type__optional?(type_info)) THEN
      RETURN FALSE;
    END
    MUTABLE node: Locatable = COPY value;
    WHILE node IS_A Cast DO
      MUTABLE node: ?Locatable = aST__node_value(node);
    END
    IF (IF node IS_A Literal AS literal THEN (literal.type == symbol("NIL")) ELSE FALSE END) THEN
      RETURN TRUE;
    ELSE
      RETURN FALSE;
    END
END
PRIVATE FN mIRLowering__owned_binding_source_alloc(MUTABLE self: MIRLowering, value: Locatable) RETURNS !?String@symbol ->
    IF (value IS_A CopyNode OR value IS_A KeepNode) THEN
      RETURN NIL;
    END
    MUTABLE node: Locatable = COPY value;
    IF value IS_A MoveNode THEN
      node = UNWRAP (aST__node_value(value));
    END
    IF !(node IS_A Identifier) THEN
      RETURN NIL;
    END
    MUTABLE ti: Type = TRY (type__from_node_mut(node, "owned binding source"));
    IF !(TRY (mIRLowering__ownership_tracked_transfer_type?(&self, ti))) THEN
      RETURN NIL;
    END
    MUTABLE entry: ?CleanupEntry@multiowned = COPY (TRY (functionState__bindings(mIRLowering__function_state(&self))))[CAST(aST__node_name(node) AS String)];
    IF !((IF entry != NIL THEN
      cleanupEntry__needs_cleanup?(entry)
    ELSE
      NIL
    END)) THEN
      RETURN NIL;
    END
    RETURN cleanupEntry__alloc(UNWRAP (entry));
END
PRIVATE FN mIRLowering__var_decl_source_transfer_required?(MUTABLE self: MIRLowering, MUTABLE node: VarDecl, facts: VarDeclFacts, init_effect: OwnershipEffect) RETURNS !Bool ->
    MUTABLE plan: ?OwnershipTransportPlan = COPY node.ownership_transport_plan;
    IF (IF plan EXISTS AS transport THEN (transport.action != :move) ELSE FALSE END) THEN
      RETURN FALSE;
    END
    IF mIRLowering__var_decl_source_borrowed?(self, node) THEN
      RETURN FALSE;
    END
    IF facts.source_owned_binding THEN
      RETURN TRUE;
    END
    IF init_effect.produces_owned THEN
      RETURN FALSE;
    END
    RETURN TRY (mIRLowering__ownership_tracked_transfer_type?(&self, facts.ft));
END
PRIVATE FN mIRLowering__var_decl_source_borrowed?(self: MIRLowering, node: VarDecl) RETURNS Bool ->
    IF aST__container_borrow?(Locatable{ VarDecl: COPY node }) THEN
      RETURN TRUE;
    END
    RETURN ((node.symbol != NIL) AND ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_661 = ((node.symbol)?);
    symbolEntry__borrow_provenance?(rtoc_local_receiver_661) } == TRUE));
END
PRIVATE FN mIRLowering__var_decl_safe_name(MUTABLE self: MIRLowering, node: VarDecl, has_mir_drop: Bool) RETURNS !String ->
    MUTABLE safe_name: String = "";
    MUTABLE decl_name_map = TRY (functionState__decl_zig_names(mIRLowering__function_state(&self)));
    MUTABLE alloc_marked_names = TRY (functionState__alloc_marked_names(mIRLowering__function_state(&self)));
    MUTABLE rename_map = TRY (functionState__rename_map(mIRLowering__function_state(&self)));
    IF (CAST(node.name AS String) == "_") THEN
      safe_name = "__discard_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_662 = mIRLowering__lowering_counters(&self);
      mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_662)) }}";
    ELSE
      safe_name = mIRLowering__zig_safe_name(self, node.name);
    END
    MUTABLE original_safe = COPY safe_name;
    IF alloc_marked_names.contains?(safe_name) THEN
      safe_name = mIRLowering__zig_safe_name(self, "${node.name}_L${(mIRLowering__function_relative_line(&self, node.token.line)).toString()}");
    END
    alloc_marked_names[safe_name] = TRUE;
    decl_name_map[aST__node_identity(Locatable{ VarDecl: COPY node })] = COPY safe_name;
    rename_map[original_safe] = COPY safe_name;
    RETURN safe_name;
END
PRIVATE FN mIRLowering__var_decl_suppression(MUTABLE self: MIRLowering, safe_name: String, node: VarDecl, facts: VarDeclFacts, MUTABLE init: Emittable) RETURNS !?String ->
    MUTABLE lowering = self;
    IF !(mIRLowering__current_function_context(&self)) THEN
      RETURN NIL;
    END
    MUTABLE owned_cleanup_value = (((facts.has_mir_drop OR ((TRY (mIRLowering__mir_allocates?(&lowering, init)) AND mIRLowering__ownership_bearing_type?(&lowering, facts.ft))))) == TRUE);
    IF facts.keyword_mutable THEN
      IF ((facts.actually_mutated AND (node.var_used != NIL)) AND !(facts.forced_var)) THEN
        RETURN NIL;
      ELSE
        RETURN "_ = &${safe_name};";
      END
    ELSE
      IF node.var_used EXISTS AS var_used_value THEN
        RETURN NIL;
      END
      IF owned_cleanup_value THEN
        RETURN "_ = &${safe_name};";
      ELSE
        RETURN "_ = ${safe_name};";
      END
    END
END
PRIVATE FN mIRLowering__stamp_var_decl_init_target_mut(MUTABLE self: MIRLowering, MUTABLE init: Emittable, safe_name: String, decl_alloc: String@symbol) RETURNS !Void ->
    IF TRY (mIRLowering__mir_allocates?(&self, init)) THEN
      TRY (mIRLowering__stamp_allocating_result_target_mut(&self, &init, safe_name, decl_alloc));
    END
END
PRIVATE FN mIRLowering__var_decl_materialization_plan(MUTABLE self: MIRLowering, MUTABLE node: VarDecl, facts: VarDeclFacts, safe_name: String, MUTABLE init: Emittable, let_node: Let) RETURNS !MaterializationPacket ->
    IF facts.has_mir_drop THEN
      RETURN TRY (mIRLowering__classified_cleanup_var_decl_plan(&self, node, facts, safe_name, init, let_node));
    END
    IF (mIRLowering__owned_return_call_init?(self, init) AND !(facts.generic_id)) THEN
      RETURN TRY (mIRLowering__owned_return_call_var_decl_plan(&self, node, facts, safe_name, init, let_node));
    END
    IF TRY (mIRLowering__transfer_only_var_decl?(self, facts, init)) THEN
      RETURN mIRLowering__transfer_only_var_decl_plan(&self, node, facts, safe_name, init, let_node);
    END
    IF TRY (mIRLowering__mutated_owned_var_decl?(&self, facts, &init)) THEN
      RETURN TRY (mIRLowering__mutated_owned_var_decl_plan(&self, node, facts, safe_name, init, let_node));
    END
    IF ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_663 = (COPY facts.binding_entry);
    cleanupEntry__present?(rtoc_local_receiver_663) } AND !({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_664 = (COPY facts.binding_entry);
    cleanupEntry__needs_cleanup?(rtoc_local_receiver_664) })) THEN
      RETURN TRY (mIRLowering__binding_metadata_var_decl_plan(&self, &node, facts, safe_name, &init, let_node));
    END
    IF (TRY (mIRLowering__mir_allocates?(&self, init)) AND !(facts.generic_id)) THEN
      RETURN TRY (mIRLowering__allocating_init_var_decl_plan(&self, node, facts, safe_name, init, let_node));
    END
    RETURN materializationPacket__value_only(Emittable{ Let: COPY let_node });
END
PRIVATE FN mIRLowering__classified_cleanup_var_decl_plan(MUTABLE self: MIRLowering, node: VarDecl, facts: VarDeclFacts, safe_name: String, init: Emittable, let_node: Let) RETURNS !MaterializationPacket ->
    MUTABLE drop_entry = COPY facts.binding_entry;
    TRY (mIRLowering__build_drop_entry_mut(&self, &drop_entry, TRY (aST__full_type_mut(Locatable{ VarDecl: COPY node })), node));
    IF TRY (type__bounded_stream?(facts.ft)) THEN
      drop_entry = cleanupEntry__with_moved_guard(drop_entry);
    END
    MUTABLE init_effect = TRY (ownershipEffect__of(init));
    # `init_effect.alloc || facts.init_ownership_effect.alloc ||
    # drop_entry.alloc` -- optional fallbacks ending in a value.
    MUTABLE node_alloc: String@symbol = :heap;
    IF !(placement__explicit_heap?(facts.decl_alloc)) THEN
      node_alloc = ((init_effect.alloc OR_ELSE (COPY facts.init_ownership_effect).alloc) OR_ELSE cleanupEntry__alloc(drop_entry));
    END
    drop_entry = cleanupEntry__with_alloc(drop_entry, node_alloc);
    MUTABLE rtoc_index_receiver_665 = TRY (functionState__bindings(mIRLowering__function_state(&self)));
    rtoc_index_receiver_665[CAST(node.name AS String)] = drop_entry;
    IF cleanupEntry__has_moved_guard?(drop_entry) THEN
      mIRLowering__mark_guarded_cleanup_name_mut(&self, safe_name);
    END
    RETURN materializationPacket__owned(mIRLowering__var_decl_alloc_mark(self, safe_name, node_alloc, facts.ft, drop_entry), Emittable{ Let: COPY let_node }, CAST(Cleanup{ name: COPY safe_name, cleanup_entry: drop_entry, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable));
END
PRIVATE FN mIRLowering__owned_return_call_var_decl_plan(MUTABLE self: MIRLowering, node: VarDecl, facts: VarDeclFacts, safe_name: String, init: Emittable, let_node: Let) RETURNS !MaterializationPacket ->
    MUTABLE mir_alloc = (mIRLowering__mir_owned_alloc(&self, init) OR_ELSE facts.decl_alloc);
    MUTABLE cleanup_entry = (mIRLowering__hoist_cleanup_entry(&self, init, Locatable{ VarDecl: COPY node }) OR_ELSE cleanupEntry__build(:uniform, mir_alloc, TRUE));
    TRY (mIRLowering__build_drop_entry_mut(&self, &cleanup_entry, TRY (aST__full_type_mut(Locatable{ VarDecl: COPY node })), node));
    cleanupEntry__mark_moved_guard_mut(&cleanup_entry);
    mIRLowering__mark_guarded_cleanup_name_mut(&self, safe_name);
    RETURN materializationPacket__owned(mIRLowering__var_decl_alloc_mark(self, safe_name, mir_alloc, facts.ft, COPY facts.binding_entry), Emittable{ Let: COPY let_node }, CAST(Cleanup{ name: COPY safe_name, cleanup_entry: cleanup_entry, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable));
END
PRIVATE FN mIRLowering__transfer_only_var_decl?(self: MIRLowering, facts: VarDeclFacts, init: Emittable) RETURNS !Bool ->
    RETURN ((!(facts.heap_return_var) AND TRY (mIRLowering__owned_return_transfer_binding?(self, KEEP facts.binding_entry, init))) AND !(facts.generic_id));
END
PRIVATE FN mIRLowering__transfer_only_var_decl_plan(MUTABLE self: MIRLowering, node: VarDecl, facts: VarDeclFacts, safe_name: String, init: Emittable, let_node: Let) RETURNS MaterializationPacket ->
    MUTABLE mir_alloc = (mIRLowering__mir_owned_alloc(&self, init) OR_ELSE facts.decl_alloc);
    RETURN materializationPacket__owned(mIRLowering__var_decl_alloc_mark(self, safe_name, mir_alloc, facts.ft, COPY facts.binding_entry), Emittable{ Let: COPY let_node });
END
PRIVATE FN mIRLowering__mutated_owned_var_decl?(MUTABLE self: MIRLowering, facts: VarDeclFacts, MUTABLE init: Emittable) RETURNS !Bool ->
    RETURN (((({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_666 = (COPY facts.binding_entry);
    cleanupEntry__present?(rtoc_local_receiver_666) } AND !({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_667 = (COPY facts.binding_entry);
    cleanupEntry__needs_cleanup?(rtoc_local_receiver_667) })) AND facts.actually_mutated) AND lifecyclePlan__needs_drop?((TRY (lifecycleRegistry__fetch(mIRLowering__lifecycle_registry(&self), facts.ft))))) AND (((!(TRY (type__string?(facts.ft))) OR TRY (mIRLowering__mir_allocates?(&self, init))) OR mIRLowering__owned_return_call_init?(self, init))));
END
PRIVATE FN mIRLowering__mutated_owned_var_decl_plan(MUTABLE self: MIRLowering, node: VarDecl, facts: VarDeclFacts, safe_name: String, init: Emittable, let_node: Let) RETURNS !MaterializationPacket ->
    MUTABLE mir_alloc = (mIRLowering__mir_owned_alloc(&self, init) OR_ELSE { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_668 = (COPY facts.binding_entry);
    cleanupEntry__alloc(rtoc_local_receiver_668) });
    MUTABLE cleanup_entry = cleanupEntry__build(IF TRY (type__string?(facts.ft)) THEN
      :heap_string
    ELSE
      :uniform
    END, mir_alloc, TRUE);
    TRY (mIRLowering__build_drop_entry_mut(&self, &cleanup_entry, TRY (aST__full_type_mut(Locatable{ VarDecl: COPY node })), node));
    mIRLowering__mark_guarded_cleanup_name_mut(&self, safe_name);
    RETURN materializationPacket__owned(mIRLowering__var_decl_alloc_mark(self, safe_name, mir_alloc, facts.ft, COPY facts.binding_entry), Emittable{ Let: COPY let_node }, CAST(Cleanup{ name: COPY safe_name, cleanup_entry: cleanup_entry, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable));
END
PRIVATE FN mIRLowering__binding_metadata_var_decl_plan(MUTABLE self: MIRLowering, MUTABLE node: VarDecl, facts: VarDeclFacts, safe_name: String, MUTABLE init: Emittable, let_node: Let) RETURNS !MaterializationPacket ->
    MUTABLE binding_entry = COPY facts.binding_entry;
    IF !((TRY (mIRLowering__mir_allocates?(&self, init)) OR ((placement__heap?(cleanupEntry__alloc(binding_entry)) AND (cleanupEntry__kind(binding_entry) != :none))))) THEN
      RETURN materializationPacket__value_only(Emittable{ Let: COPY let_node });
    END
    MUTABLE mir_alloc = IF placement__explicit_heap?(facts.decl_alloc) THEN
      :heap
    ELSE
      ((mIRLowering__mir_owned_alloc(&self, init) OR_ELSE facts.decl_alloc))
    END;
    MUTABLE alloc_mark = mIRLowering__var_decl_alloc_mark(self, safe_name, mir_alloc, facts.ft, binding_entry);
    IF !(lifecyclePlan__needs_drop?((TRY (lifecycleRegistry__fetch(mIRLowering__lifecycle_registry(&self), facts.ft))))) THEN
      RETURN materializationPacket__owned(alloc_mark, Emittable{ Let: COPY let_node });
    END
    MUTABLE cleanup_entry = TRY (mIRLowering__moved_guard_cleanup_entry(&self, facts.ft, mir_alloc, node));
    mIRLowering__mark_guarded_cleanup_name_mut(&self, safe_name);
    RETURN materializationPacket__owned(alloc_mark, Emittable{ Let: COPY let_node }, CAST(Cleanup{ name: COPY safe_name, cleanup_entry: cleanup_entry, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable));
END
PRIVATE FN mIRLowering__allocating_init_var_decl_plan(MUTABLE self: MIRLowering, node: VarDecl, facts: VarDeclFacts, safe_name: String, init: Emittable, let_node: Let) RETURNS !MaterializationPacket ->
    MUTABLE mir_alloc = (mIRLowering__mir_owned_alloc(&self, init) OR_ELSE facts.decl_alloc);
    MUTABLE alloc_mark = mIRLowering__var_decl_alloc_mark(self, safe_name, mir_alloc, facts.ft, KEEP facts.binding_entry);
    IF type__rodata?(facts.ft) THEN
      RETURN materializationPacket__value_only(Emittable{ Let: COPY let_node });
    END
    IF !(TRY (mIRLowering__type_requires_alloc_cleanup?(&self, facts.ft, mir_alloc))) THEN
      RETURN materializationPacket__owned(alloc_mark, Emittable{ Let: COPY let_node });
    END
    MUTABLE entry: ?CleanupEntry@multiowned = TRY (mIRLowering__hoist_cleanup_entry(&self, init, Locatable{ VarDecl: COPY node }));
    # An initializer that allocates nothing ITSELF -- a projection such as a
    # union payload read, whose buffer the union owns -- has no cleanup recipe.
    # The binding borrows that buffer: an AllocMark without a Cleanup is a LEAK
    # by INV-2, and a Cleanup here would free what the union's cleanup frees.
    IF !(entry EXISTS) THEN
      RETURN materializationPacket__value_only(Emittable{ Let: COPY let_node });
    END
    MUTABLE cleanup_entry = cleanupEntry__with_alloc(entry, mir_alloc);
    TRY (mIRLowering__build_drop_entry_mut(&self, &cleanup_entry, TRY (aST__full_type_mut(Locatable{ VarDecl: COPY node })), node));
    IF cleanupEntry__has_moved_guard?(cleanup_entry) THEN
      mIRLowering__mark_guarded_cleanup_name_mut(&self, safe_name);
    END
    RETURN materializationPacket__owned(alloc_mark, Emittable{ Let: COPY let_node }, CAST(Cleanup{ name: COPY safe_name, cleanup_entry: cleanup_entry, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable));
END
PRIVATE FN mIRLowering__mark_guarded_cleanup_name_mut(MUTABLE self: MIRLowering, name: String) RETURNS Void ->
    MUTABLE rtoc_index_receiver_670 = mIRLowering__function_state(&self).guarded_cleanup_names;
    rtoc_index_receiver_670[name] = TRUE;
END
PRIVATE FN mIRLowering__moved_guard_cleanup_entry(MUTABLE self: MIRLowering, ft: Type, alloc: String@symbol, node: VarDecl) RETURNS !CleanupEntry@multiowned ->
    MUTABLE entry = cleanupEntry__build(IF TRY (type__string?(ft)) THEN
      :heap_string
    ELSE
      :uniform
    END, alloc, TRUE);
    TRY (mIRLowering__build_drop_entry_mut(&self, &entry, TRY (aST__full_type_mut(Locatable{ VarDecl: COPY node })), node));
    cleanupEntry__mark_moved_guard_mut(&entry);
    RETURN entry;
END
PRIVATE FN mIRLowering__type_requires_alloc_cleanup?(MUTABLE self: MIRLowering, ft: Type, alloc: String@symbol) RETURNS !Bool ->
    MUTABLE _ = COPY alloc;
    RETURN lifecyclePlan__needs_drop?((TRY (lifecycleRegistry__fetch(mIRLowering__lifecycle_registry(&self), ft))));
END
PRIVATE FN mIRLowering__var_decl_alloc_mark(self: MIRLowering, name: String, alloc: String@symbol, type_info: Type, binding_entry: CleanupEntry) RETURNS AllocMark ->
    MUTABLE mark = AllocMark{ name: COPY name, alloc: COPY alloc, type_info: COPY type_info, scope: COPY IF placement__explicit_heap?(alloc) THEN
      :heap
    ELSE
      (IF cleanupEntry__present?(binding_entry) THEN
      cleanupEntry__scope(binding_entry)
    ELSE
      :iteration
    END)
    END, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    RETURN mark;
END
PRIVATE FN mIRLowering__lower_var_decl_init(MUTABLE self: MIRLowering, MUTABLE node: VarDecl, ft: Type, bare_zig: String, has_caps: Bool, decl_alloc: String@symbol) RETURNS !Emittable ->
    MUTABLE placed = NIL;
    IF node.value IS_A NextExpr THEN
      RETURN TRY (mIRLowering__lower_next_expr(&self, CAST(node.value AS NextExpr), decl_alloc));
    END
    MUTABLE rhs = node.value;
    MUTABLE rhs_unwrapped = IF ((rhs IS_A BinaryOp AND (aST__node_op(rhs) == symbol("OR_ELSE")))) THEN
      UNWRAP (locatable__left(rhs))
    ELSE
      rhs
    END;
    IF (rhs IS_A BinaryOp AND (aST__node_op(rhs) == symbol("OR_ELSE"))) THEN
      placed = mIRLowering__with_expected_type(&self, ft, %() USE(MUTABLE rhs, MUTABLE self) -> {
    MUTABLE rtoc_lambda_result_671: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(rhs)));
    rtoc_lambda_result_671
      });
      RETURN TRY (mIRLowering__place_value_for_destination(&self, &placed, &rhs, decl_alloc, TypeTypeInput{ Type: COPY ft }));
    END
    IF ((TRY (type__dynamic_rank?(ft)) AND rhs_unwrapped IS_A ListLit) AND locatable__items(rhs_unwrapped).empty?()) THEN
      MUTABLE inner = ContainerInit{ zig_type: COPY bare_zig, strategy: :grid_empty, alloc: COPY decl_alloc, capacity: NIL, lowered_node_id: NIL, ownership_consumption: NIL };
      IF has_caps THEN
        RETURN mIRLowering__compose_capability_wrap(self, Emittable{ ContainerInit: COPY inner }, bare_zig, ft, decl_alloc);
      ELSE
        RETURN Emittable{ ContainerInit: COPY inner };
      END
    END
    IF type__pool?(ft) THEN
      IF ((rhs_unwrapped IS_A MoveNode OR aST__call?(rhs_unwrapped)) OR !(rhs_unwrapped IS_A ListLit)) THEN
        RETURN UNWRAP (TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(node.value))));
      END
      MUTABLE inner = ContainerInit{ zig_type: COPY bare_zig, strategy: :pool, alloc: COPY decl_alloc, capacity: COPY type__capacity(ft), lowered_node_id: NIL, ownership_consumption: NIL };
      IF has_caps THEN
        RETURN mIRLowering__compose_capability_wrap(self, Emittable{ ContainerInit: COPY inner }, bare_zig, ft, decl_alloc);
      ELSE
        RETURN Emittable{ ContainerInit: COPY inner };
      END
    END
    IF type__set_collection?(ft) THEN
      IF (IF rhs IS_A BinaryOp AS rtoc_smooth_n THEN binaryOp__smooth?(rtoc_smooth_n) ELSE FALSE END) THEN
        RETURN UNWRAP (TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(node.value))));
      END
      IF ((rhs_unwrapped IS_A MoveNode OR aST__call?(rhs_unwrapped)) OR !(rhs_unwrapped IS_A ListLit)) THEN
        RETURN UNWRAP (TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(node.value))));
      END
      MUTABLE hint: ?Int64 = type__allocation_hint(ft);
      MUTABLE inner = ContainerInit{ zig_type: COPY bare_zig, strategy: IF hint != NIL THEN
        :set_capacity
      ELSE
        :set_empty
      END, alloc: COPY decl_alloc, capacity: COPY hint, lowered_node_id: NIL, ownership_consumption: NIL };
      IF has_caps THEN
        RETURN mIRLowering__compose_capability_wrap(self, Emittable{ ContainerInit: COPY inner }, bare_zig, ft, decl_alloc);
      ELSE
        RETURN Emittable{ ContainerInit: COPY inner };
      END
    END
    IF type__list_collection?(ft) THEN
      IF rhs_unwrapped IS_A MoveNode THEN
        RETURN UNWRAP (TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(node.value))));
      END
      IF rhs_unwrapped IS_A NextExpr AS rhs_unwrapped_narrowed THEN
        RETURN TRY (mIRLowering__lower_next_expr(&self, &rhs_unwrapped_narrowed, decl_alloc));
      END
      IF aST__call?(rhs_unwrapped) THEN
        RETURN UNWRAP (TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(node.value))));
      END
      IF ((rhs_unwrapped IS_A CopyNode AND rhs_unwrapped.own) AND TRY (type__any_rc?(TRY (aST__full_type_mut(UNWRAP (aST__node_value(rhs_unwrapped))))))) THEN
        RETURN TRY (mIRLowering__lower(&self, &rhs_unwrapped));
      END
      IF mIRLowering__list_collection_copy?(self, rhs_unwrapped) THEN
        RETURN Emittable{ DeepCopy: COPY DeepCopy{ source: COPY UNWRAP (TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(UNWRAP (aST__node_value(rhs_unwrapped)))))), zig_type: COPY TRY (type__zig_type(ft)), elem_type: NIL, strategy: :full_value, alloc: COPY decl_alloc, copy_shape: deepCopy__copy_shape_for_zig_type(COPY TRY (type__zig_type(ft))), type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
      IF !(rhs_unwrapped IS_A ListLit) THEN
        RETURN UNWRAP (TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(node.value))));
      END
      IF !(locatable__items(rhs_unwrapped).empty?()) THEN
        RETURN mIRLowering__with_expected_type(&self, ft, %() USE(node, MUTABLE self) -> {
    MUTABLE rtoc_lambda_result_672: ?Emittable = TRY (mIRLowering__lower(&self, node.value));
    rtoc_lambda_result_672
        });
      END
      MUTABLE init_capacity: ?Int64 = type__allocation_hint(ft);
      MUTABLE init_kind = IF init_capacity != NIL THEN
        :list_capacity
      ELSE
        :array_list_empty
      END;
      MUTABLE inner = ContainerInit{ zig_type: COPY bare_zig, strategy: COPY init_kind, alloc: COPY decl_alloc, capacity: COPY init_capacity, lowered_node_id: NIL, ownership_consumption: NIL };
      IF has_caps THEN
        RETURN mIRLowering__compose_capability_wrap(self, Emittable{ ContainerInit: COPY inner }, bare_zig, ft, decl_alloc);
      ELSE
        RETURN Emittable{ ContainerInit: COPY inner };
      END
    END
    IF type__fixed_soa?(ft) THEN
      MUTABLE inner = ContainerInit{ zig_type: COPY bare_zig, strategy: :list_capacity, alloc: COPY decl_alloc, capacity: COPY type__capacity(ft), lowered_node_id: NIL, ownership_consumption: NIL };
      IF has_caps THEN
        RETURN mIRLowering__compose_capability_wrap(self, Emittable{ ContainerInit: COPY inner }, bare_zig, ft, decl_alloc);
      ELSE
        RETURN Emittable{ ContainerInit: COPY inner };
      END
    END
    MUTABLE retain_source = mIRLowering__var_decl_retain_source(self, node.value);
    IF ((IF retain_source IS_A Identifier AS identifier THEN (node.value.was_moved != TRUE) ELSE FALSE END) AND TRY (mIRLowering__rc_retain_needed?(&self, retain_source))) THEN
      RETURN Emittable{ RcRetain: COPY TRY (mIRLowering__make_rc_retain(&self, castLocatableToIdentifier__mir_lowering(retain_source))) };
    END
    MUTABLE wraps_value = (has_caps AND !(TRY (mIRLowering__source_already_has_declared_capability?(self, node.value, ft))));
    MUTABLE value_ft_branch_value: ?Type = NIL;
    IF wraps_value THEN
      value_ft_branch_value = TRY (type__bare_data_type((TRY (type__non_optional_type(ft)))));
    ELSE
      value_ft_branch_value = COPY ft;
    END
    MUTABLE value_ft: Type = value_ft_branch_value?;
    placed = mIRLowering__with_expected_type(&self, value_ft, %() USE(node, MUTABLE self) -> {
    MUTABLE rtoc_lambda_result_673: ?Emittable = TRY (mIRLowering__lower(&self, &node.value));
    rtoc_lambda_result_673
    });
    placed = TRY (mIRLowering__place_value_for_destination(&self, &placed, node.value, decl_alloc, TypeTypeInput{ Type: COPY value_ft }));
    IF (wraps_value AND TRY (mIRLowering__borrowed_wrap_source?(self, node.value))) THEN
      placed = DeepCopy{ source: COPY placed, zig_type: COPY TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY value_ft })), elem_type: NIL, strategy: :full_value, alloc: COPY decl_alloc, copy_shape: deepCopy__copy_shape_for_zig_type(COPY TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY value_ft }))), type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL };
    END
    IF (wraps_value AND !(mIRLowering__capability_wrapped_mir?(self, placed))) THEN
      RETURN mIRLowering__compose_capability_wrap(self, placed, bare_zig, ft, decl_alloc);
    ELSE
      RETURN placed;
    END
END
PRIVATE FN mIRLowering__borrowed_wrap_source?(self: MIRLowering, value: ?Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((value != NIL)) THEN
      RETURN FALSE;
    END
    MUTABLE source = TRY (aST__full_type_mut( value));
    IF TRY (type__any_rc?(source)) THEN
      RETURN FALSE;
    END
    RETURN type__borrowed_reference?(source);
}
CATCH Transient, Input, System, NotFound, Permission, Canceled
  RETURN FALSE;
END
PRIVATE FN mIRLowering__var_decl_retain_source(self: MIRLowering, value: Locatable) RETURNS Locatable ->
    IF value IS_A MoveNode AS move_node THEN
      RETURN COPY move_node.value;
    END
    RETURN COPY value;
END
PRIVATE FN mIRLowering__capability_wrapped_mir?(self: MIRLowering, node: Emittable) RETURNS Bool
  EFFECTS REENTRANT ->
    IF node IS_A CapWrap AS cap_wrap THEN
      RETURN TRUE;
    END
    IF ((node IS_A MIRCast OR node IS_A TryExpr) OR node IS_A TryOptional) THEN
      RETURN mIRLowering__capability_wrapped_mir?(self, UNWRAP (emittable__expr(node)));
    END
    RETURN FALSE;
END
PRIVATE FN mIRLowering__source_already_has_declared_capability?(self: MIRLowering, source_node: Locatable, target_type: Type) RETURNS !Bool ->
    MUTABLE node: Locatable = COPY source_node;
    WHILE node IS_A Cast DO
      MUTABLE node: ?Locatable = aST__node_value( node);
    END
    IF node IS_A CapabilityWrap AS capability_wrap THEN
      RETURN FALSE;
    END
    MUTABLE inner: Locatable = node;
    WHILE (inner IS_A CopyNode OR inner IS_A KeepNode) DO
      inner = UNWRAP (aST__node_value( inner));
    END
    MUTABLE source_type: ?Type = TRY (type__from_node_mut(inner, "capability source type"));
    IF !((type__ownership( UNWRAP (source_type)) == type__ownership(target_type))) THEN
      RETURN FALSE;
    END
    IF !((type__sync( UNWRAP (source_type)) == type__sync(target_type))) THEN
      RETURN FALSE;
    END
    IF !((type__layout( UNWRAP (source_type)) == type__layout(target_type))) THEN
      RETURN FALSE;
    END
    IF !((type__shard_count( UNWRAP (source_type)) == type__shard_count(target_type))) THEN
      RETURN FALSE;
    END
    RETURN TRUE;
END
PRIVATE FN mIRLowering__list_collection_copy?(self: MIRLowering, rhs: Locatable) RETURNS Bool ->
    RETURN (((rhs IS_A CopyNode OR rhs IS_A KeepNode)) AND type__list_collection?(TRY (aST__full_type_mut(UNWRAP (aST__node_value(rhs))))));
END
PRIVATE FN mIRLowering__field_owner_move_marks(MUTABLE self: MIRLowering, node: VarDecl) RETURNS ![]Emittable ->
    MUTABLE value = node.value;
    IF !(value IS_A GetField) THEN
      RETURN CAST(List[] AS []Emittable);
    END
    IF !(TRY (mIRLowering__field_access_moves_owner?(self, castLocatableToGetField__type_analysis_session(value)))) THEN
      RETURN CAST(List[] AS []Emittable);
    END
    MUTABLE root: ?Identifier = aST__root_identifier(value);
    IF root EXISTS AS root_value THEN
      MUTABLE source_name = COPY root_value.name;
      MUTABLE safe = mIRLowering__zig_safe_name(self, source_name);
      MUTABLE rename_map = TRY (functionState__rename_map(mIRLowering__function_state(&self)));
      IF rename_map.contains?(safe) THEN
        safe = COPY (rename_map[safe] OR_ELSE "");
      END
      MUTABLE entry = ((TRY (functionState__bindings(mIRLowering__function_state(&self))))[source_name] OR_ELSE cleanupEntry__none());
      IF !(cleanupEntry__present?(entry)) THEN
        RETURN CAST(List[] AS []Emittable);
      END
      MUTABLE guarded_names = COPY mIRLowering__function_state(&self).guarded_cleanup_names;
      MUTABLE guarded = (cleanupEntry__has_moved_guard?(entry) OR (guarded_names[safe] == TRUE));
      RETURN TRY (mIRLowering__ownership_transfer_marks(&self, safe, :owned_sink, cleanupEntry__alloc(entry), guarded));
    ELSE
      RETURN CAST(List[] AS []Emittable);
    END
END
PRIVATE FN mIRLowering__field_access_moves_owner?(self: MIRLowering, value: GetField) RETURNS !Bool ->
    IF aST__container_borrow?(Locatable{ GetField: COPY value }) THEN
      RETURN FALSE;
    END
    IF aST__moved?(Locatable{ GetField: COPY value }) THEN
      RETURN TRUE;
    END
    IF (TRUE AND (value.indirect_field == TRUE)) THEN
      RETURN TRUE;
    END
    RETURN type__indirect_type?(TRY (aST__full_type_mut(Locatable{ GetField: COPY value })));
END
PRIVATE FN mIRLowering__owned_return_transfer_binding?(self: MIRLowering, binding_entry: CleanupEntry, init: Emittable) RETURNS !Bool ->
    IF cleanupEntry__needs_cleanup?(binding_entry) THEN
      RETURN FALSE;
    END
    IF !(cleanupEntry__present?(binding_entry)) THEN
      RETURN FALSE;
    END
    IF !((cleanupEntry__heap?(binding_entry) OR (cleanupEntry__alloc(binding_entry) == :cleanup))) THEN
      RETURN FALSE;
    END
    IF init IS_A Call AS call THEN
      RETURN FALSE;
    END
    IF !((emittable__stdlib_def(init) != NIL)) THEN
      RETURN FALSE;
    END
    MUTABLE sig: ?FunctionSignature@multiowned = functionSignature__unwrap( (IF emittable__stdlib_def(init) EXISTS AS rtoc_wrap_18392 THEN X{ FunctionSignature: COPY rtoc_wrap_18392 } ELSE NIL END));
    IF !((IF sig != NIL THEN
      TRY (functionSignature__emits_allocating?(sig))
    ELSE
      NIL
    END)) THEN
      RETURN FALSE;
    END
    IF TRY (functionSignature__heap_return_alloc?(UNWRAP (sig))) THEN
      RETURN TRUE;
    END
    MUTABLE metadata: ?InlineAllocMetadata@multiowned = emittable__allocs(init);
    IF metadata EXISTS THEN
      RETURN (inlineAllocMetadata__any_heap?(metadata) == TRUE);
    END
    RETURN FALSE;
END
PRIVATE FN mIRLowering__owned_return_call_init?(self: MIRLowering, init: ?Emittable) RETURNS Bool
  EFFECTS REENTRANT ->
    IF init? IS_A MIRCast AS mir_cast THEN
      RETURN mIRLowering__owned_return_call_init?(self, cast__expr(mir_cast));
    END
    IF (((init != NIL) AND (init IS_A TryExpr)) OR ((init != NIL) AND (init IS_A TryOptional))) THEN
      RETURN mIRLowering__owned_return_call_init?( self, emittable__expr(UNWRAP (init)));
    END
    RETURN !(!(((IF init? IS_A Call AS call THEN call__owned_return?(call) ELSE FALSE END))));
END
PRIVATE FN mIRLowering__cleanup_entry_for_ast_binding(self: MIRLowering, node: Locatable) RETURNS ?CleanupEntry@multiowned ->
    IF !((aST__node__symbol(node) EXISTS)) THEN
      RETURN NIL;
    END
    MUTABLE symbol: ?SymbolEntry@multiowned = locatable__symbol(node);
    IF !(symbol) THEN
      RETURN NIL;
    END
    MUTABLE decl:? = symbol.reg;
    IF (decl AND (aST__node_mir_binding_entry( castSymbolEntryRegInputToLocatable(decl)) EXISTS)) THEN
      MUTABLE entry: ?CleanupEntry@multiowned = aST__node_mir_binding_entry( castSymbolEntryRegInputToLocatable(decl));
      IF entry THEN
        RETURN entry;
      END
    END
    RETURN NIL;
END
PRIVATE FN mIRLowering__lower_bind_expr(MUTABLE self: MIRLowering, MUTABLE node: BindExpr) RETURNS !NodeRoot ->
    IF (node.mode == :decl) THEN
      MUTABLE proxy = VarDecl{ token: COPY node.token, name: node.name, type: COPY node.type, value: node.value, mutable: FALSE, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, mir_binding_entry: NIL, ownership_transport_plan: NIL, const_visibility: NIL, module_const: NIL };
      TRY (aST__stamp_synthetic_type_mut(Locatable{ VarDecl: COPY proxy }, CAST(COPY TRY (aST__full_type_mut(Locatable{ BindExpr: COPY node })) AS Type), "synthetic AST type"));
      proxy.storage_override = locatable__storage( Locatable{ BindExpr: COPY node });
      proxy.slot_size = node.slot_size;
      proxy.resource_close_plan = COPY node.resource_close_plan;
      proxy.var_used = node.var_used;
      IF (TRUE AND TRUE) THEN
        proxy.container_borrow = node.container_borrow;
      END
      IF (TRUE AND TRUE) THEN
        proxy.symbol = COPY node.symbol;
      END
      IF (TRUE AND TRUE) THEN
        proxy.mir_binding_entry = node.mir_binding_entry;
      END
      proxy.ownership_transport_plan = node.ownership_transport_plan;
      MUTABLE result = TRY (mIRLowering__lower_var_decl(&self, &proxy));
      MUTABLE decl_name_map = TRY (functionState__decl_zig_names(mIRLowering__function_state(&self)));
      IF decl_name_map.contains?(aST__node_identity(Locatable{ VarDecl: COPY proxy })) THEN
        MUTABLE safe_name = COPY UNWRAP (decl_name_map[aST__node_identity(Locatable{ VarDecl: COPY proxy })]);
        decl_name_map[aST__node_identity(Locatable{ BindExpr: COPY node })] = COPY safe_name;
        MUTABLE symbol_reg: ?SymbolEntryRegInput = NIL;
        IF node.symbol != NIL THEN
          symbol_reg = COPY ((node.symbol)?).reg;
        END
        IF symbol_reg EXISTS AS symbol_reg_value THEN
          decl_name_map[aST__node_identity(castSymbolEntryRegInputToLocatable(COPY symbol_reg_value))] = COPY safe_name;
        END
      END
      RETURN result;
    ELSE
      IF node.auto_atomic_op THEN
        RETURN NodeRoot{ Emittable: COPY CAST(TRY (mIRLowering__lower_atomic_assignment(&self, node)) AS Emittable) };
      END
      MUTABLE target_name = TRY (mIRLowering__assignment_storage_name(&self, CAST(node.name AS String), TRUE));
      MUTABLE rp: ?ReassignPlan = COPY node.reassign_cleanup;
      MUTABLE binding_entry = ((IF mIRLowering__cleanup_entry_for_ast_binding(self, Locatable{ BindExpr: COPY node }) != NIL THEN mIRLowering__cleanup_entry_for_ast_binding(self, Locatable{ BindExpr: COPY node }) ELSE (TRY (functionState__bindings(mIRLowering__function_state(&self))))[CAST(node.name AS String)] END) OR_ELSE cleanupEntry__none());
      MUTABLE heap_return_var = mIRLowering__current_function_heap_carry_return_var?(&self, CAST(node.name AS String));
      MUTABLE module_global = mIRLowering__program_state(self).module_global_names.contains?(CAST(node.name AS String));
      MUTABLE assign_alloc =     IF (heap_return_var OR module_global) THEN
        :heap
      ELSE
        (IF rp THEN
        mIRLowering__alloc_from_sym(self, UNWRAP (rp.alloc))
      ELSE
        (IF cleanupEntry__present?(binding_entry) THEN
        cleanupEntry__alloc(binding_entry)
      ELSE
        NIL
      END)
      END)
      END;
      MUTABLE source_type: ?Type = TRY (type__from_node_mut(node.value, "reassignment value type"));
      MUTABLE target_type_branch_value: ?Type = NIL;
      IF assign_alloc THEN
        target_type_branch_value = TRY (type__new(TypeConstructionInput{ Type: COPY source_type }, NIL, NIL, NIL, assign_alloc));
      ELSE
        target_type_branch_value = source_type;
      END
      MUTABLE target_type: Type = target_type_branch_value?;
      MUTABLE value: ?Emittable = mIRLowering__with_reassignment_target(&self, target_name, %() USE(assign_alloc, node, target_type, MUTABLE self) -> {
    MUTABLE rtoc_lambda_result_678: ?Emittable = mIRLowering__with_decl_alloc(&self, assign_alloc, %() USE(assign_alloc, node, target_type, MUTABLE self) -> {
    MUTABLE lowered: ?Emittable = TRY (mIRLowering__lower(&self, node.value));
    TRY (mIRLowering__place_value_for_destination(&self, UNWRAP (lowered), node.value, assign_alloc, TypeTypeInput{ Type: COPY target_type }))
      });
    rtoc_lambda_result_678
      });
      IF (assign_alloc == NIL) THEN
        assign_alloc = TRY (mIRLowering__mir_owned_alloc(&self, value));
      END
      value = TRY (mIRLowering__copy_container_borrow_if_needed(&self, &value, node.value));
      IF (TRUE AND TRUE) THEN
        TRY (mIRLowering__stamp_allocating_result_target_mut(&self, &value, target_name, assign_alloc));
      END
      IF ((TRUE AND TRY (mIRLowering__mir_allocates?(&self, value))) AND !(mIRLowering__fallible_self_fallback_reassign?(self, target_name, value))) THEN
        value = TRY (mIRLowering__hoist_alloc(&self, &value, node.value, TRUE));
      END
      result =     IF rp THEN
        {
    MUTABLE rtoc_value_block_marker = 0;
    plan = cleanupEntry__lifecycle_plan(rp);
    IF !((IF plan != NIL THEN
        lifecyclePlan__needs_drop?(plan)
      ELSE
        NIL
      END)) THEN
        panic("reassignment cleanup lacks annotation lifecycle plan for {}");
      END
    ReassignWithCleanup{ name: COPY target_name, value: COPY value, zig_type: UNWRAP (UNWRAP (rp).zig_type), alloc: mIRLowering__alloc_from_sym(self, UNWRAP (UNWRAP (rp).alloc)), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }
      }
      ELSE_IF (heap_return_var AND lifecyclePlan__needs_drop?((TRY (lifecycleRegistry__fetch(mIRLowering__lifecycle_registry(&self), TRY (aST__full_type_mut(Locatable{ BindExpr: COPY node }))))))) THEN
        {
    MUTABLE rtoc_value_block_marker = 0;
    target_type = TRY (aST__full_type_mut(Locatable{ BindExpr: COPY node }));
    ReassignWithCleanup{ name: COPY target_name, value: COPY value, zig_type: TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY target_type })), alloc: :heap, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }
      }
      ELSE
        Set{ target: Emittable{ Ident: COPY Ident{ name: COPY target_name, lowered_node_id: NIL, ownership_consumption: NIL } }, value: COPY value, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }
      END;
      MUTABLE ownership_value = (mIRLowering__fallible_self_fallback_success_expr(self, target_name, value) OR_ELSE value);
      MUTABLE ownership_ast =     IF mir__same_node?(ownership_value, value) THEN
        node.value
      ELSE_IF node.value IS_A BinaryOp THEN
        UNWRAP (locatable__left(UNWRAP (node.value)))
      ELSE
        node.value
      END;
      result = NodeRoot{ Emittable: COPY TRY (mIRLowering__with_ownership_consumption_for_value(&self, &result, &ownership_value, &ownership_ast, emittable__variant_name(result), :owned_sink, IF result IS_A ReassignWithCleanup AS reassign_result THEN
        reassign_result.alloc
      ELSE
        assign_alloc
      END, TRY (type__from_node_mut(node.value, "reassignment ownership value")))) };
      RETURN result;
    END
END
PRIVATE FN mIRLowering__lower_destructuring_assignment(MUTABLE self: MIRLowering, MUTABLE node: DestructuringAssignment) RETURNS !DestructureSet ->
    MUTABLE value: Emittable = CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(node.value))) AS Emittable);
    MUTABLE targets = node.targets |> SELECT { MUTABLE rtoc_mutable_block_param_679 = COPY _;
    TRY (mIRLowering__lower_destructure_target(&self, rtoc_mutable_block_param_679)) };
    FOR concat_stmt IN TRY (mIRLowering__destructure_source_transfer(&self, node, value)) DO
      &self.state.function_state.pending_stmts.append(COPY concat_stmt);
    END
    RETURN DestructureSet{ targets: CAST(targets AS []Emittable), value: COPY value, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN mIRLowering__destructure_source_transfer(MUTABLE self: MIRLowering, node: DestructuringAssignment, value: Emittable) RETURNS ![]Emittable ->
    MUTABLE name: ?String = IF value IS_A Ident THEN
      (emittable__name(value) OR_ELSE "")
    ELSE
      NIL
    END;
    IF name EXISTS AS name_value THEN
      IF !(mIRLowering__function_state(&self).guarded_cleanup_names[name_value]) THEN
        RETURN CAST(List[] AS []Emittable);
      END
      # Ruby's `any?` block has three early `next false` guards and a final
      # `||`; each arm answers with a Bool, and the map lookups are optional.
      MUTABLE reassigns_owner: Bool = FALSE;
      FOR rtoc_target IN node.targets DO
        IF (CAST(rtoc_target.name AS String) != "_") THEN
          MUTABLE rtoc_guarded: Bool = FALSE;
          IF mIRLowering__function_state(&self).guarded_cleanup_names[mIRLowering__zig_safe_name(self, CAST(rtoc_target.name AS String))] EXISTS AS rtoc_guard_flag THEN
            rtoc_guarded = rtoc_guard_flag;
          END
          IF !(rtoc_guarded) THEN
            IF (TRY (functionState__bindings(mIRLowering__function_state(&self))))[CAST(rtoc_target.name AS String)] EXISTS AS rtoc_target_entry THEN
              rtoc_guarded = cleanupEntry__needs_cleanup?(rtoc_target_entry);
            END
          END
          IF rtoc_guarded THEN
            reassigns_owner = TRUE;
          END
        END
      END
      IF !(reassigns_owner) THEN
        RETURN CAST(List[] AS []Emittable);
      END
      RETURN TRY (mIRLowering__ownership_transfer_marks(&self, name_value, :block_result, NIL, TRUE));
    ELSE
      RETURN CAST(List[] AS []Emittable);
    END
END
PRIVATE FN mIRLowering__lower_destructure_target(MUTABLE self: MIRLowering, target: DestructureTarget) RETURNS !MIRDestructureTarget ->
    IF (CAST(target.name AS String) == "_") THEN
      RETURN MIRDestructureTarget{ name: "_", declaration_kind: NIL, annotation: NIL, lowered_node_id: NIL, ownership_consumption: NIL };
    END
    MUTABLE symbol: ?SymbolEntry = COPY target.symbol;
    MUTABLE declared = FALSE;
    IF symbol EXISTS AS rtoc_symbol THEN
      IF castOptionalSymbolEntryRegInputToOptionalLocatable(rtoc_symbol.reg) EXISTS AS rtoc_reg THEN
        declared = (aST__node_identity(rtoc_reg) == aST__node_identity(Locatable{ DestructureTarget: COPY target }));
      END
    END
    MUTABLE safe_name = mIRLowering__zig_safe_name(self, target.name);
    IF declared THEN
      MUTABLE rtoc_index_receiver_684 = TRY (functionState__decl_zig_names(mIRLowering__function_state(&self)));
      rtoc_index_receiver_684[aST__node_identity(Locatable{ DestructureTarget: COPY target })] = COPY safe_name;
      IF symbol?.reg EXISTS AS reg_value THEN
        MUTABLE rtoc_index_receiver_685 = TRY (functionState__decl_zig_names(mIRLowering__function_state(&self)));
        rtoc_index_receiver_685[aST__node_identity(castSymbolEntryRegInputToLocatable(COPY reg_value))] = COPY safe_name;
      END
    END
    MUTABLE declaration_kind: ?String@symbol = IF declared THEN
      TRY (mIRLowering__destructure_declaration_kind(self, target))
    ELSE
      NIL
    END;
    MUTABLE annotation_branch_value: ?Type = NIL;
    IF (declared AND target.type) THEN
      annotation_branch_value = TRY (type__new(TypeConstructionInput{ StringValue: COPY TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY TRY (aST__full_type_mut(Locatable{ DestructureTarget: COPY target })) })) }));
    ELSE
      annotation_branch_value = NIL;
    END
    MUTABLE annotation: ?Type = annotation_branch_value;
    RETURN MIRDestructureTarget{ name: COPY safe_name, declaration_kind: declaration_kind, annotation: CAST(annotation AS ?String), lowered_node_id: NIL, ownership_consumption: NIL };
END
PRIVATE FN mIRLowering__destructure_declaration_kind(self: MIRLowering, target: DestructureTarget) RETURNS !String@symbol ->
    IF !(target.mutable) THEN
      RETURN :const;
    END
    MUTABLE ft: ?Type = TRY (type__from_node_mut(Locatable{ DestructureTarget: COPY target }, "destructure target declaration"));
    MUTABLE forced_var = ((((((((type__collection?( UNWRAP (ft)) OR TRY (type__dynamic_stream?( UNWRAP (ft)))) OR TRY (type__bounded_stream?( UNWRAP (ft)))) OR type__shared_promise?( UNWRAP (ft))) OR TRY (type__open_stream?( UNWRAP (ft)))) OR TRY (type__inf_stream?( UNWRAP (ft)))) OR ((type__array?( UNWRAP (ft)) AND type__dynamic?( UNWRAP (ft))))) OR type__any_sync?( UNWRAP (ft))) OR type__resource?( UNWRAP (ft)));
    IF ((target.var_mutated == TRUE) OR forced_var) THEN
      RETURN :var;
    ELSE
      RETURN :const;
    END
END
PRIVATE FN mIRLowering__assignment_storage_name(MUTABLE self: MIRLowering, name: String, renamed: Bool) RETURNS !String ->
    IF mIRLowering__capture_mapped_name(&self, name) != NIL THEN
    RETURN (mIRLowering__capture_mapped_name(&self, name))?;
    ELSE
    RETURN TRY (mIRLowering__zig_local_name(&self, name, renamed));
    END
END
PRIVATE FN mIRLowering__capture_mapped_name(MUTABLE self: MIRLowering, name: String) RETURNS ?String ->
    IF mIRLowering__capture_state(&self).do_capture_map EXISTS AS rtoc_capture_map THEN
      IF rtoc_capture_map[name] EXISTS AS rtoc_mapped THEN
        RETURN COPY rtoc_mapped;
      END
    END
    RETURN NIL;
END
PRIVATE FN mIRLowering__zig_local_name(MUTABLE self: MIRLowering, name: String, renamed: Bool) RETURNS !String ->
    MUTABLE safe = mIRLowering__zig_safe_name(self, name);
    IF !(renamed) THEN
      RETURN safe;
    END
    RETURN COPY (TRY (functionState__rename_map(mIRLowering__function_state(&self)))[safe]);
END
PRIVATE FN mIRLowering__fallible_self_fallback_reassign?(self: MIRLowering, name: String, value: Emittable) RETURNS Bool ->
    RETURN !((mIRLowering__fallible_self_fallback_success_expr(self, name, value) == NIL));
END
PRIVATE FN mIRLowering__fallible_self_fallback_success_expr(self: MIRLowering, name: String, value: Emittable) RETURNS ?Emittable ->
    MUTABLE expr = COPY value;
    IF expr IS_A MIRCast AS mir_cast THEN
      MUTABLE mir_cast = cast__expr(mir_cast);
    END
    IF expr IS_A TryCatch AS try_catch THEN
    IF (try_catch.capture == NIL) THEN
        MUTABLE catch_body = try_catch.catch_body;
        IF catch_body IS_A Ident AS ident THEN
        IF (ident.name == name) THEN
            RETURN COPY tryCatch__expr(try_catch);
          ELSE
            RETURN NIL;
          END
        ELSE
          RETURN NIL;
        END
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
END
PRIVATE FN mIRLowering__lower_atomic_assignment(MUTABLE self: MIRLowering, node: BindExpr) RETURNS !ExprStmt ->
    MUTABLE op_name = COPY CAST(node.auto_atomic_op AS String);
    MUTABLE target_name: String = COPY node.name;
    MUTABLE safe = TRY (mIRLowering__zig_local_name(&self, target_name, TRUE));
    IF mIRLowering__current_function_mutable_scalar_param?(&self, target_name) THEN
      safe = "_m_${target_name}";
    END
    MUTABLE target_ident = Ident{ name: (mIRLowering__capture_mapped_name(&self, target_name) OR_ELSE safe), lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE cell = Deref{ expr: Emittable{ Ident: COPY target_ident }, lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE arg_ast:? =   IF node.compound_op THEN
      aST__node_right(node.value)
    ELSE
      node.value
    END;
    MUTABLE arg: ?Emittable = TRY (mIRLowering__lower(&self, castOptionalLocatableToMIRLoweringLowerableStmt(arg_ast)));
    MUTABLE method_call = MIRMethodCall{ receiver: Emittable{ Deref: COPY cell }, method: COPY op_name, args: [CAST(arg AS Any)], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(1)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    MUTABLE discard = (node.auto_atomic_op != :store);
    RETURN ExprStmt{ expr: Emittable{ MIRMethodCall: COPY method_call }, discard: discard, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN mIRLowering__kept_assignment_field_value(MUTABLE self: MIRLowering, node: Assignment) RETURNS !?Emittable ->
    MUTABLE target = COPY node.name;
    IF target IS_A GetField AS get_field THEN
      MUTABLE get_field_mutable = COPY get_field;
      MUTABLE ft = (TRY (aST__full_type_mut( Locatable{ GetField: COPY get_field_mutable })));
      IF !((TRUE AND type__multiowned?(ft))) THEN
        RETURN NIL;
      END
      RETURN TRY (mIRLowering__kept_identity_orelse_field_value(&self, node.value, ft, :heap));
    ELSE
      RETURN NIL;
    END
END
PRIVATE FN mIRLowering__lower_assignment(MUTABLE self: MIRLowering, MUTABLE node: Assignment) RETURNS !Emittable ->
    MUTABLE special_result: ?Emittable = TRY (mIRLowering__special_assignment_result(&self, &node));
    IF special_result EXISTS AS special_result_value THEN
      RETURN special_result_value;
    END
    MUTABLE plan = TRY (mIRLowering__assignment_target_plan(&self, node));
    MUTABLE kept_value: ?Emittable = TRY (mIRLowering__kept_assignment_field_value(&self, node));
    IF ((kept_value != NIL) AND TRY (mIRLowering__mir_allocates?(&self, kept_value))) THEN
      kept_value = TRY (mIRLowering__hoist_alloc(&self, &kept_value, &node.value, TRUE));
    END
    MUTABLE value = (kept_value OR_ELSE TRY (mIRLowering__assignment_value(&self, &node)));
    MUTABLE result = Set{ target: COPY plan.target, value: COPY value, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    MUTABLE target_alloc: ?String@symbol =   IF plan.cleanup_field THEN
      TRY (mIRLowering__placement_for_node(&self, ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_root_recv: Locatable = Locatable{ GetField: COPY UNWRAP (plan.cleanup_field) };
      IF mIRLowering__root_receiver_node(self, Locatable{ GetField: COPY UNWRAP (plan.cleanup_field) }) EXISTS AS rtoc_root_ident THEN
        rtoc_root_recv = Locatable{ Identifier: COPY rtoc_root_ident };
      END
      rtoc_root_recv })))
    ELSE_IF (COPY node.name IS_A String OR COPY node.name IS_A Identifier) THEN
      {
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE raw_name: String = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_689: ?String = NIL;
    IF COPY node.name IS_A Identifier THEN
      rtoc_ternary_value_689 = CAST(assignmentName__name(COPY node.name) AS String);
    ELSE
      rtoc_ternary_value_689 = CAST(COPY node.name AS String);
    END
    rtoc_ternary_value_689? };
    MUTABLE safe_name: String = TRY (mIRLowering__assignment_storage_name(&self, raw_name, FALSE));
    # `bindings[safe_name] || bindings[raw_name]` -- two optional reads.
    MUTABLE entry: ?CleanupEntry@multiowned = COPY ((TRY (functionState__bindings(mIRLowering__function_state(&self))))[safe_name] OR_ELSE (TRY (functionState__bindings(mIRLowering__function_state(&self))))[raw_name]);
    (IF (IF (IF entry != NIL THEN
      cleanupEntry__alloc(entry)
    ELSE
      NIL
    END) != NIL THEN (IF entry != NIL THEN
      cleanupEntry__alloc(entry)
    ELSE
      NIL
    END) ELSE TRY (mIRLowering__mir_owned_alloc(&self, value)) END) != NIL THEN (IF (IF entry != NIL THEN
      cleanupEntry__alloc(entry)
    ELSE
      NIL
    END) != NIL THEN (IF entry != NIL THEN
      cleanupEntry__alloc(entry)
    ELSE
      NIL
    END) ELSE TRY (mIRLowering__mir_owned_alloc(&self, value)) END) ELSE (IF COPY node.name IS_A Identifier THEN
      TRY (mIRLowering__placement_for_node(&self, castAssignmentNameToLocatable__mir_lowering(COPY node.name)))
    ELSE
      NIL
    END) END)
    }
    ELSE
      NIL
    END;
    TRY (mIRLowering__with_ownership_consumption_for_value(&self, Emittable{ Set: COPY result }, COPY value, &node.value, "MIR::Set", :owned_sink, target_alloc));
    TRY (mIRLowering__mark_field_assignment_cleanup_mut(&self, &result, plan));
    RETURN Emittable{ Set: COPY result };
END
PRIVATE FN mIRLowering__special_assignment_result(MUTABLE self: MIRLowering, MUTABLE node: Assignment) RETURNS !?Emittable ->
    MUTABLE name = COPY node.name;
    IF mIRLowering__conditional_field_assignment?(self, castAssignmentNameToName(name)) THEN
      RETURN CAST(TRY (mIRLowering__lower_conditional_field_assignment(&self, &node)) AS Emittable);
    END
    IF name IS_A GetIndex AS get_index THEN
      MUTABLE get_index_mutable = COPY get_index;
      RETURN (TRY (mIRLowering__lower_indexed_assignment(&self, &node)));
    END
    IF ((name IS_A GetField) AND (node.auto_lock EXISTS)) THEN
      RETURN (TRY (mIRLowering__lower_auto_lock_assignment(&self, &node)));
    END
    IF ((name IS_A GetField) AND (node.field_pre_cleanup EXISTS)) THEN
      RETURN CAST(TRY (mIRLowering__lower_field_assignment_with_cleanup(&self, &node)) AS Emittable);
    END
    RETURN NIL;
END
PRIVATE FN mIRLowering__conditional_field_assignment?(self: MIRLowering, name: MIRLoweringName) RETURNS Bool ->
    RETURN (IF name IS_A GetField AS get_field THEN get_field.target IS_A OptionalUnwrap ELSE FALSE END);
END
PRIVATE FN mIRLowering__lower_conditional_field_assignment(MUTABLE self: MIRLowering, MUTABLE node: Assignment) RETURNS !IfBindStmt ->
    MUTABLE field: GetField = COPY castAssignmentNameToGetField(node.name);
    MUTABLE unwrap: OptionalUnwrap = COPY CAST(field.target AS OptionalUnwrap);
    MUTABLE source = COPY unwrap.target;
    MUTABLE target_alloc = TRY (mIRLowering__placement_for_node(&self, source));
    MUTABLE source_type: ?Type = TRY (type__from_node_mut(source, "conditional assignment receiver"));
    MUTABLE optional_ptr_branch_value: ?MethodCall = NIL;
    IF source IS_A GetIndex AS get_index THEN
      MUTABLE index = get_index;
      MUTABLE receiver: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(index.target)));
      IF !(mIRLowering__collection_param_receiver?(&self, index.target)) THEN
        receiver = AddressOf{ expr: Emittable{ AddressOf: CAST(COPY receiver AS AddressOf)}, lowered_node_id: NIL, ownership_consumption: NIL };
      END
      target_alloc = TRY (mIRLowering__placement_for_node(&self, index.target));
      optional_ptr_branch_value = TRY (mIRLowering__emit_builtin(&self, :getAtPtrOpt, [Emittable{ AddressOf: CAST(COPY receiver AS AddressOf)}, TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(index.index)))]));
    ELSE
      IF TRY (type__node_reference?( UNWRAP (source_type))) THEN
        MUTABLE payload = UNWRAP (TRY (type__node_payload_type( UNWRAP (source_type))));
        MUTABLE zig_type = TRY (mIRLowering__transpile_type(self, MIRLoweringType{ StringValue: COPY CAST(type__resolved(payload) AS String) }));
        MUTABLE shared = type__shared_node?( UNWRAP (source_type));
        IF !(shared) THEN
          &self.state.function_state.node_store_types.insert(zig_type);
        END
        optional_ptr_branch_value = MIRMethodCall{ receiver: Emittable{ Call: COPY TRY (mIRLowering__node_store_type_mir(&self, zig_type, shared)) }, method: "getBound", args: [CAST(Ident{ name: mIRLowering__node_store_binding_name(self, zig_type, shared), lowered_node_id: NIL, ownership_consumption: NIL } AS Any), CAST(CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(source))) AS Emittable) AS Any)], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(1)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
      ELSE
        optional_ptr_branch_value = TRY (mIRLowering__emit_builtin(&self, :getOptionalPtr, [Emittable{ AddressOf: COPY AddressOf{ expr: COPY CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(source))) AS Emittable), lowered_node_id: NIL, ownership_consumption: NIL } }]));
      END
    END
    MUTABLE optional_ptr: MethodCall = optional_ptr_branch_value?;
    MUTABLE capture = "__conditional_mut_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_690 = mIRLowering__lowering_counters(&self);
    mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_690)) }}";
    MUTABLE target = FieldGet{ object: Emittable{ Ident: COPY Ident{ name: COPY capture, lowered_node_id: NIL, ownership_consumption: NIL } }, field: COPY CAST(field.field AS String), lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE field_type = TRY (aST__full_type_mut(Locatable{ GetField: COPY field }));
    IF ((field.safe_nav_chain == TRUE) AND type__optional?(field_type)) THEN
      field_type = UNWRAP (TRY (type__wrapped_type(field_type)));
    END
    MUTABLE field_lifecycle = COPY TRY (lifecycleRegistry__fetch(mIRLowering__lifecycle_registry(&self), field_type));
    MUTABLE value, value_pending = mIRLowering__lower_head(&self, %() USE(field_lifecycle, field_type, MUTABLE node, target_alloc, MUTABLE self) -> {
    MUTABLE lowered: ?Emittable = mIRLowering__with_decl_alloc(&self, target_alloc, %() USE(field_type, MUTABLE node, target_alloc, MUTABLE self) -> {
      MUTABLE raw: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(node.value)));
      TRY (mIRLowering__place_value_for_destination(&self, UNWRAP (raw), &node.value, target_alloc, TypeTypeInput{ Type: COPY field_type }))
    });
    MUTABLE materialized =   IF lifecyclePlan__needs_drop?(field_lifecycle) THEN
        TRY (mIRLowering__materialize_owned_sink_value(&self, lowered, node.value, target_alloc))
      ELSE
        lowered
      END;
    IF mIRLowering__node_store_create_call?(self, materialized) THEN
      RETURN mIRLowering__hoist_evaluation_barrier(&self, materialized);
    ELSE_IF TRY (mIRLowering__mir_allocates?(&self, materialized)) THEN
      RETURN TRY (mIRLowering__hoist_alloc(&self, &materialized, &node.value, TRUE));
    ELSE
      RETURN materialized;
    END
    NIL
    });
    MUTABLE set = Set{ target: Emittable{ FieldGet: COPY target }, value: COPY value, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    MUTABLE stmt = TRY (mIRLowering__with_ownership_consumption_for_value(&self, Emittable{ Set: COPY set }, &value, node.value, "MIR::Set", :owned_sink, target_alloc));
    MUTABLE then_body: []Emittable = List[];
    then_body = ruby_array_concat_Stmt(then_body, CAST(value_pending AS []Emittable));
    IF lifecyclePlan__needs_drop?(field_lifecycle) THEN
      MUTABLE cleanup_call = Call{ callee: "CheatLib.cleanup", args: [Emittable{ TypeOf: COPY TypeOf{ expr: Emittable{ FieldGet: COPY target }, lowered_node_id: NIL, ownership_consumption: NIL } }, Emittable{ AllocatorRef: COPY AllocatorRef{ kind: COPY target_alloc, lowered_node_id: NIL, ownership_consumption: NIL } }, Emittable{ AddressOf: COPY AddressOf{ expr: Emittable{ FieldGet: COPY target }, lowered_node_id: NIL, ownership_consumption: NIL } }], try_wrap: FALSE, owned_return: FALSE, callable_contract: TRY (callableContract__no_ownership(3)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL };
      &then_body.append(CAST(ExprStmt{ expr: Emittable{ Call: COPY cleanup_call }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable));
    END
    &then_body.append(castEmittableToStmt(stmt));
    RETURN IfBindStmt{ bindings: COPY [{:expr: optional_ptr, :capture: capture, :node_ref: FALSE}], then_body: then_body, else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN mIRLowering__assignment_target_plan(MUTABLE self: MIRLowering, node: Assignment) RETURNS !AssignmentTargetPlan ->
    MUTABLE name = COPY node.name;
    IF name IS_A String AS string THEN
      RETURN AssignmentTargetPlan{ target: Emittable{ Ident: COPY Ident{ name: TRY (mIRLowering__assignment_storage_name(&self, string, FALSE)), lowered_node_id: NIL, ownership_consumption: NIL } }, cleanup_field: NIL };
    END
    MUTABLE field_branch_value: ?AssignmentName = NIL;
    IF name IS_A GetField AS get_field THEN
      field_branch_value = AssignmentName{ GetField: COPY get_field };
    ELSE
      field_branch_value = NIL;
    END
    MUTABLE field: ?AssignmentName = field_branch_value;
    MUTABLE cleanup_field_branch_value: ?AssignmentName = NIL;
    IF ((field != NIL) AND !(node.field_pre_cleanup)) THEN
      cleanup_field_branch_value = field;
    ELSE
      cleanup_field_branch_value = NIL;
    END
    MUTABLE cleanup_field: ?AssignmentName = cleanup_field_branch_value;
    RETURN AssignmentTargetPlan{ target: COPY CAST(TRY (mIRLowering__lower(&self, castAssignmentNameToMIRLoweringLowerableStmt(name))) AS Emittable), cleanup_field: castOptionalAssignmentNameToOptionalGetField(COPY cleanup_field) };
END
PRIVATE FN mIRLowering__assignment_value(MUTABLE self: MIRLowering, MUTABLE node: Assignment) RETURNS !Emittable ->
    MUTABLE value: Emittable = CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(node.value))) AS Emittable);
    IF mIRLowering__node_store_create_call?(self, value) THEN
      value = Emittable{ Ident: COPY mIRLowering__hoist_evaluation_barrier(&self, value) };
    END
    RETURN TRY (mIRLowering__copy_container_borrow_if_needed(&self, &value, &node.value));
END
PRIVATE FN mIRLowering__mark_field_assignment_cleanup_mut(MUTABLE self: MIRLowering, MUTABLE result: Set, plan: AssignmentTargetPlan) RETURNS !Void ->
    MUTABLE field: ?GetField = COPY plan.cleanup_field;
    IF ((field != NIL) AND lifecyclePlan__needs_drop?((TRY (lifecycleRegistry__fetch(mIRLowering__lifecycle_registry(&self), TRY (aST__full_type_mut(Locatable{ GetField: COPY field }))))))) THEN
      result.needs_field_cleanup = TRUE;
    END
    NIL;
END
PRIVATE FN mIRLowering__field_assignment_root_identifier(self: MIRLowering, field: GetField) RETURNS ?Identifier ->
    MUTABLE root: Any = COPY field.target;
    WHILE root IS_A GetField DO
      root = UNWRAP (aST__node_target(root));
    END
    IF root IS_A Identifier THEN
      RETURN castLocatableToOptionalIdentifier__type_analysis_session(root);
    ELSE
      RETURN NIL;
    END
END
PRIVATE FN mIRLowering__ownership_marks_for_transferred_temp(MUTABLE self: MIRLowering, value: Emittable, target_alloc: ?String@symbol = NIL) RETURNS ![]Emittable ->
    IF value IS_A Ident AS ident THEN
      MUTABLE name = COPY ident.name;
      MUTABLE entry = ((TRY (functionState__bindings(mIRLowering__function_state(&self))))[name] OR_ELSE cleanupEntry__none());
      MUTABLE guarded = mIRLowering__pipeline_guarded_cleanup_name?(&self, name);
      IF !((guarded OR cleanupEntry__present?(entry))) THEN
        RETURN CAST(List[] AS []Emittable);
      END
      MUTABLE alloc: String@symbol = :heap;
      IF target_alloc EXISTS AS rtoc_target_alloc THEN
        alloc = COPY rtoc_target_alloc;
      ELSE_IF cleanupEntry__present?(entry) THEN
        alloc = COPY cleanupEntry__alloc(entry);
      END
      RETURN TRY (mIRLowering__ownership_transfer_marks(&self, name, :owned_sink, alloc, guarded));
    ELSE
      RETURN CAST(List[] AS []Emittable);
    END
END
PRIVATE FN mIRLowering__lower_indexed_assignment(MUTABLE self: MIRLowering, MUTABLE node: Assignment) RETURNS !Emittable ->
    MUTABLE call: ?Emittable = NIL;
    MUTABLE rtoc_target_index: ?GetIndex = NIL;
    PARTIAL MATCH node.name START
      AssignmentName.GetIndex AS rtoc_gi -> rtoc_target_index = COPY rtoc_gi;,
      DEFAULT -> PASS;
    END
    IF (IF rtoc_target_index EXISTS AS rtoc_gi_op THEN (rtoc_gi_op.protocol_operation == :map_put) ELSE FALSE END) THEN
      call = TRY (mIRLowering__lower_protocol_map_put_call(&self, COPY UNWRAP (rtoc_target_index).target, COPY UNWRAP (rtoc_target_index).index, COPY node.value));
      RETURN Emittable{ ExprStmt: COPY ExprStmt{ expr: COPY UNWRAP (call), discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
    MUTABLE target_node: Locatable = COPY UNWRAP (rtoc_target_index).target;
    MUTABLE ti = TRY (aST__full_type_mut(target_node));
    IF mIRLowering__bc_target?(&self) THEN
      RETURN Emittable{ Set: COPY TRY (mIRLowering__lower_direct_indexed_set(&self, &node, FALSE)) };
    END
    MUTABLE receiver_type = TRY (type__new(TypeConstructionInput{ Type: COPY ti }));
    IF type__rank?(receiver_type) THEN
      MUTABLE target = AddressOf{ expr: COPY CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(target_node))) AS Emittable), lowered_node_id: NIL, ownership_consumption: NIL };
      # `node.name.index.is_a?(TupleLit) ? .items : [index]` then lower each.
      MUTABLE index_nodes: []Locatable = List[COPY UNWRAP (rtoc_target_index).index];
      IF UNWRAP (rtoc_target_index).index IS_A TupleLit THEN
        index_nodes = UNWRAP (locatable__items(COPY UNWRAP (rtoc_target_index).index));
      END
      MUTABLE lowered_indices: []Emittable = List[];
      FOR MUTABLE rtoc_index_node IN index_nodes DO
        &lowered_indices.append(UNWRAP (TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(rtoc_index_node)))));
      END
      MUTABLE coordinates = TRY (mIRLowering__rank_coordinates(self, Emittable{ AddressOf: COPY target }, receiver_type, lowered_indices));
      MUTABLE value: Emittable = CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(node.value))) AS Emittable);
      call = RuntimeCall{ spec: COPY TRY (runtimeCalls__rank_set_spec()), args: [Emittable{ AddressOf: COPY target }, coordinates.dimensions, Emittable{ ArrayInit: COPY coordinates.indices }, value], lowered_node_id: NIL, ownership_consumption: NIL };
      RETURN Emittable{ ExprStmt: COPY ExprStmt{ expr: COPY UNWRAP (call), discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
    IF ((type__fixed?(receiver_type) AND !(TRY (type__string?(receiver_type)))) AND !(type__collection?(receiver_type))) THEN
      RETURN Emittable{ Set: COPY TRY (mIRLowering__lower_direct_indexed_set(&self, &node, TRUE)) };
    END
    MUTABLE kind: ?String@symbol = TRY (type__dispatch_key(ti));
    MUTABLE op: ?FunctionSignature@multiowned = NIL;
    IF kind EXISTS AS rtoc_index_kind THEN
      op = TRY (intrinsicRegistry__lookup_single(:index_ops, "${CAST(rtoc_index_kind AS String)}_set"));
    END
        MUTABLE target: Emittable = UNWRAP (TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(target_node))));
    MUTABLE idx: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(COPY UNWRAP (rtoc_target_index).index)));
    IF !(op) THEN
      MUTABLE val: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__pipeline_lowering_bridge(node.value)));
      RETURN Emittable{ ExprStmt: COPY ExprStmt{ expr: castMIRLoweringReturnValueToEmittable__mir_lowering(COPY TRY (mIRLowering__emit_builtin(&self, :setAt, [Emittable{ AddressOf: COPY AddressOf{ expr: COPY target, lowered_node_id: NIL, ownership_consumption: NIL } }, UNWRAP (idx), UNWRAP (val)]))), discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
    MUTABLE op_value_mutable = COPY op;
    IF ((kind == :string_map) OR (kind == :numeric_map)) THEN
      RETURN Emittable{ ShardedMapPut: COPY TRY (mIRLowering__lower_map_indexed_assignment(&self, &node, &target_node, receiver_type, Emittable{ AddressOf: COPY AddressOf{ expr: COPY target, lowered_node_id: NIL, ownership_consumption: NIL } }, UNWRAP (idx), UNWRAP (kind), &op_value_mutable)) };
    END
    RETURN TRY (mIRLowering__lower_template_indexed_assignment(&self, &node, &target_node, receiver_type, Emittable{ AddressOf: COPY AddressOf{ expr: COPY target, lowered_node_id: NIL, ownership_consumption: NIL } }, UNWRAP (idx), UNWRAP (kind), &op_value_mutable));
END
PRIVATE FN mIRLowering__lower_direct_indexed_set(MUTABLE self: MIRLowering, MUTABLE node: Assignment, cast_index: Bool) RETURNS !Set ->
    MUTABLE rtoc_target_index: ?GetIndex = NIL;
    PARTIAL MATCH node.name START
      AssignmentName.GetIndex AS rtoc_gi -> rtoc_target_index = COPY rtoc_gi;,
      DEFAULT -> PASS;
    END
    MUTABLE target: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(COPY UNWRAP (rtoc_target_index).target)));
    MUTABLE idx: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(COPY UNWRAP (rtoc_target_index).index)));
    IF cast_index THEN
      idx = Emittable{ MIRCast: COPY MIRCast{ expr: COPY UNWRAP (idx), target_type: "usize", method: :intCast, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    MUTABLE target_alloc = TRY (mIRLowering__placement_for_node(&self, COPY UNWRAP (rtoc_target_index).target));
    MUTABLE value_type: ?Type = TRY (type__from_node_mut(node.value, "direct indexed assignment value"));
    MUTABLE val: ?Emittable = mIRLowering__with_decl_alloc(&self, target_alloc, %() USE(MUTABLE node, MUTABLE self) -> {
    MUTABLE rtoc_lambda_result_694: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(COPY node.value)));
    rtoc_lambda_result_694
    });
    IF TRY (mIRLowering__ownership_tracked_transfer_type?(&self, UNWRAP (value_type))) THEN
      val = TRY (mIRLowering__place_value_for_destination(&self, UNWRAP (val), &node.value, target_alloc, TypeTypeInput{ Type: COPY UNWRAP (value_type) }));
      val = TRY (mIRLowering__materialize_owned_sink_value(&self, UNWRAP (val), node.value, target_alloc, TypeTypeInput{ Type: COPY UNWRAP (value_type) }));
      IF TRY (mIRLowering__mir_allocates?(&self, val)) THEN
        val = TRY (mIRLowering__hoist_alloc(&self, UNWRAP (val), &node.value, TRUE));
      END
    END
    MUTABLE set = Set{ target: Emittable{ IndexGet: COPY IndexGet{ object: COPY UNWRAP (target), index: COPY UNWRAP (idx), lowered_node_id: NIL, ownership_consumption: NIL } }, value: COPY UNWRAP (val), needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    TRY (mIRLowering__with_ownership_consumption_for_value(&self, Emittable{ Set: COPY set }, UNWRAP (val), &node.value, "MIR::Set", :owned_sink, target_alloc));
    RETURN set;
END
PRIVATE FN mIRLowering__lower_map_indexed_assignment(MUTABLE self: MIRLowering, MUTABLE node: Assignment, MUTABLE target_node: Locatable, receiver_type: Type, target_input: Emittable, idx_input: Emittable, kind: String@symbol, MUTABLE op: FunctionSignature) RETURNS !ShardedMapPut ->
    MUTABLE idx = COPY idx_input;
    MUTABLE target = COPY target_input;
    MUTABLE shard: ?{String@symbol}String = TRY (mIRLowering__shard_context(self));
    MUTABLE dispatch = TRY (mIRLowering__indexed_assignment_dispatch(&self, kind, receiver_type, target_node, node, &op));
    MUTABLE sink_type = TRY (type__value_type(receiver_type));
    MUTABLE val: ?Emittable = mIRLowering__with_sink_type(&self, sink_type, %() USE(dispatch, MUTABLE node, MUTABLE self) -> {
    MUTABLE rtoc_lambda_result_696: ?Emittable = mIRLowering__with_decl_alloc(&self, dispatch.sink_alloc, %() USE(MUTABLE node, MUTABLE self) -> {
    MUTABLE rtoc_lambda_result_695: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(node.value)));
    rtoc_lambda_result_695
    });
    rtoc_lambda_result_696
    });
    IF (kind == :string_map) THEN
    IF idx IS_A ConcatStr AS concat_str THEN
      MUTABLE concat_str = ConcatStr{ parts: COPY concat_str.parts, alloc: COPY mIRLowering__alloc_expr(self, :frame), rt_expr: COPY concat_str.rt_expr, lowered_node_id: NIL, ownership_consumption: NIL };
    END
    END
    IF (kind == :string_map) THEN
      # `node.name.index` -- the assignment target is a GetIndex node, and
      # `.index` is its field, not the String method rtoc reached for.
      PARTIAL MATCH node.name START
        AssignmentName.GetIndex AS rtoc_target_index ->
          idx = TRY (mIRLowering__hoist_alloc(&self, &idx, COPY rtoc_target_index.index));,
        DEFAULT -> PASS;
      END
    END
    val = TRY (mIRLowering__place_value_for_destination(&self, UNWRAP (val), &node.value, dispatch.sink_alloc, TypeTypeInput{ Type: COPY sink_type }));
    IF !((dispatch.shard_direct AND mIRLowering__rodata_ownership_ast?(&self, node.value))) THEN
      val = TRY (mIRLowering__materialize_owned_sink_value(&self, UNWRAP (val), node.value, dispatch.sink_alloc));
    END
    val = TRY (mIRLowering__hoist_alloc(&self, UNWRAP (val), &node.value, TRUE));
    IF (!(mIRLowering__bc_target?(&self)) AND type__rc_map?(receiver_type)) THEN
      target = Deref{ expr: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Deref: COPY Deref{ expr: COPY target, lowered_node_id: NIL, ownership_consumption: NIL } }, field: "ctrl", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "data", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL };
    END
    IF dispatch.shard_direct THEN
      RETURN castEmittableToShardedMapPut(TRY (mIRLowering__with_ownership_consumption_for_value(&self, Emittable{ ShardedMapPut: COPY ShardedMapPut{ target: Emittable{ Deref: COPY Deref{ expr: COPY target, lowered_node_id: NIL, ownership_consumption: NIL } }, key: COPY idx, value: COPY UNWRAP (val), shard_idx: Emittable{ Ident: COPY Ident{ name: COPY CAST(UNWRAP (UNWRAP (shard)[:idx]) AS String), lowered_node_id: NIL, ownership_consumption: NIL } }, shard_key: Emittable{ Ident: COPY Ident{ name: COPY CAST(UNWRAP (UNWRAP (shard)[:key]) AS String), lowered_node_id: NIL, ownership_consumption: NIL } }, map_kind: COPY kind, stdlib_def: COPY op, key_type: COPY dispatch.key_type, value_type: COPY dispatch.value_type, resolved_allocs: COPY KEEP dispatch.resolved_allocs, template_kind: COPY dispatch.template_kind, target_var: COPY TRY (mIRLowering__extract_root_var_name(&self, &target_node)), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, UNWRAP (val), &node.value, "MIR::ShardedMapPut", :owned_sink, dispatch.sink_alloc)));
    END
    RETURN castEmittableToShardedMapPut(TRY (mIRLowering__with_ownership_consumption_for_value(&self, Emittable{ ShardedMapPut: COPY ShardedMapPut{ target: Emittable{ Deref: COPY Deref{ expr: COPY target, lowered_node_id: NIL, ownership_consumption: NIL } }, key: COPY idx, value: COPY UNWRAP (val), shard_idx: NIL, shard_key: NIL, map_kind: COPY kind, stdlib_def: COPY op, key_type: COPY dispatch.key_type, value_type: COPY dispatch.value_type, resolved_allocs: COPY KEEP dispatch.resolved_allocs, template_kind: COPY dispatch.template_kind, target_var: COPY TRY (mIRLowering__extract_root_var_name(&self, &target_node)), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, UNWRAP (val), &node.value, "MIR::ShardedMapPut", :owned_sink, dispatch.sink_alloc)));
END
PRIVATE FN mIRLowering__lower_template_indexed_assignment(MUTABLE self: MIRLowering, MUTABLE node: Assignment, MUTABLE target_node: Locatable, receiver_type: Type, target: Emittable, idx: Emittable, kind: String@symbol, MUTABLE op: FunctionSignature) RETURNS !Emittable ->
    MUTABLE val_node = COPY node.value;
    MUTABLE value_type_for_transfer: ?Type = TRY (type__from_node_mut(val_node, "indexed assignment value transfer"));
    MUTABLE dispatch = TRY (mIRLowering__indexed_assignment_dispatch(&self, kind, receiver_type, target_node, node, &op));
    MUTABLE sink_type_branch_value: ?Type = NIL;
    IF ((kind == :array) OR (kind == :list)) THEN
      sink_type_branch_value = (TRY (type__element_type(receiver_type)) OR_ELSE value_type_for_transfer);
    ELSE
      sink_type_branch_value = TRY (type__value_type(receiver_type));
    END
    MUTABLE sink_type: Type = sink_type_branch_value?;
    MUTABLE owns_transferred_value = TRY (mIRLowering__ownership_tracked_transfer_type?(&self, sink_type));
    MUTABLE val: ?Emittable = mIRLowering__with_decl_alloc(&self, dispatch.sink_alloc, %() USE(MUTABLE node, sink_type, MUTABLE self) -> {
    MUTABLE rtoc_lambda_result_698: ?Emittable = mIRLowering__with_sink_type(&self, sink_type, %() USE(MUTABLE node, MUTABLE self) -> {
    MUTABLE rtoc_lambda_result_697: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(node.value)));
    rtoc_lambda_result_697
    });
    rtoc_lambda_result_698
    });
    IF !(dispatch.shard_direct) THEN
      val = TRY (mIRLowering__place_value_for_destination(&self, UNWRAP (val), &val_node, dispatch.sink_alloc, TypeTypeInput{ Type: COPY sink_type }));
      IF owns_transferred_value THEN
        val = TRY (mIRLowering__materialize_owned_sink_value(&self, UNWRAP (val), val_node, dispatch.sink_alloc, TypeTypeInput{ Type: COPY sink_type }));
      END
      IF TRY (mIRLowering__mir_allocates?(&self, val)) THEN
        val = TRY (mIRLowering__hoist_alloc(&self, UNWRAP (val), &val_node, TRUE));
      END
      IF val IS_A Ident THEN
        TRY (mIRLowering__move_mark_field_mut(&self, val_node));
      END
    END
    MUTABLE ownership_operands = TRY (mIRLowering__ownership_operands_for_value(&self, UNWRAP (val), &val_node, "indexed assignment", dispatch.sink_alloc));
    MUTABLE consumed_names: []String = (ownership_operands |> SELECT:? (IF !((_.kind == :owned_binding)) THEN NIL ELSE _.name END) |> WHERE _ != NIL).compact();
    MUTABLE entry: FunctionSignature@multiowned = op;
    MUTABLE ownership_contract = TRY (ownershipContract__consume_operands(ownership_operands));
    MUTABLE setAt_stmt = ExprStmt{ expr: Emittable{ IndexedStore: COPY IndexedStore{ target: COPY target, index: COPY idx, value: COPY UNWRAP (val), entry: entry, template_kind: COPY dispatch.template_kind, map_kind: COPY kind, ownership_contract: ownership_contract, allocs: KEEP dispatch.resolved_allocs, target_var: COPY TRY (mIRLowering__extract_root_var_name(&self, &target_node)), key_type: COPY dispatch.key_type, value_type: COPY dispatch.value_type } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    MUTABLE post_transfer_marks = consumed_names |> UNNEST {
    MUTABLE guarded = mIRLowering__pipeline_guarded_cleanup_name?(&self, _);
    TRY (mIRLowering__ownership_transfer_marks(&self, _, :owned_sink, dispatch.sink_alloc, guarded))
    };
    IF ((kind == :array) OR (kind == :list)) THEN
      MUTABLE elem_ti = UNWRAP (TRY (type__element_type(receiver_type)));
      IF TRY (mIRLowering__ownership_tracked_transfer_type?(&self, elem_ti)) THEN
        MUTABLE elem_zig = TRY (type__zig_type(elem_ti));
        MUTABLE cleanup_call = TRY (mIRLowering__emit_builtin(&self, :cleanupAt, [Emittable{ Ident: COPY Ident{ name: COPY elem_zig, lowered_node_id: NIL, ownership_consumption: NIL } }, target, Emittable{ AllocatorRef: COPY AllocatorRef{ kind: COPY dispatch.sink_alloc, lowered_node_id: NIL, ownership_consumption: NIL } }, idx]));
        RETURN Emittable{ ScopeBlock: COPY ScopeBlock{ body: COPY ([Emittable{ ExprStmt: COPY ExprStmt{ expr: castMIRLoweringReturnValueToEmittable__mir_lowering(COPY cleanup_call), discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ ExprStmt: COPY setAt_stmt }] + post_transfer_marks), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
      END
    END
    IF (post_transfer_marks.length() > 0) THEN
      RETURN Emittable{ ScopeBlock: COPY ScopeBlock{ body: COPY ([Emittable{ ExprStmt: COPY setAt_stmt }] + post_transfer_marks), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
    RETURN Emittable{ ExprStmt: COPY setAt_stmt };
END
PRIVATE FN mIRLowering__indexed_assignment_dispatch(MUTABLE self: MIRLowering, kind: String@symbol, receiver_type: Type, target_node: Locatable, assignment: Assignment, MUTABLE op: FunctionSignature) RETURNS !IndexedAssignmentDispatch ->
    MUTABLE target_var: ?String = mIRLowering__indexed_assignment_target_var(self, target_node);
    MUTABLE shard: ?{String@symbol}String = TRY (mIRLowering__shard_context(self));
    MUTABLE shard_direct = !(!(((((shard != NIL) AND (target_var == shard[:map])) AND (TRY (functionSignature__intrinsic_template(op, IntrinsicTemplateKind.ShardDirectZig)) != NIL)))));
    MUTABLE template_kind =   IF shard_direct THEN
      IntrinsicTemplateKind.ShardDirectZig
    ELSE_IF (((type__sharded?(receiver_type) OR type__striped?(receiver_type))) AND (TRY (functionSignature__intrinsic_template(op, IntrinsicTemplateKind.ShardedZig)) != NIL)) THEN
      IntrinsicTemplateKind.ShardedZig
    ELSE
      IntrinsicTemplateKind.Zig
    END;
    MUTABLE resolved_allocs = TRY (mIRLowering__indexed_assignment_allocs(&self, &op, target_node, assignment));
    MUTABLE receiver_alloc = TRY (mIRLowering__placement_for_node(&self, target_node));
    MUTABLE rtoc_sink_alloc: String@symbol = (((inlineAllocMetadata__value_alloc(resolved_allocs) OR_ELSE inlineAllocMetadata__primary(resolved_allocs)) OR_ELSE inlineAllocMetadata__shard_alloc(resolved_allocs)) OR_ELSE :heap);
    RETURN IndexedAssignmentDispatch{ target_var: COPY target_var, shard_direct: shard_direct, template_kind: COPY template_kind, key_type: COPY ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_699: ?Type = NIL;
    IF (kind == :numeric_map) THEN
      rtoc_ternary_value_699 = TRY (type__key_type(receiver_type));
    ELSE
      rtoc_ternary_value_699 = NIL;
    END
    rtoc_ternary_value_699? }), value_type: COPY ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_700: ?Type = NIL;
    IF (kind == :numeric_map) THEN
      rtoc_ternary_value_700 = TRY (type__value_type(receiver_type));
    ELSE
      rtoc_ternary_value_700 = NIL;
    END
    rtoc_ternary_value_700? }), resolved_allocs: resolved_allocs, sink_alloc: COPY rtoc_sink_alloc };
END
PRIVATE FN mIRLowering__indexed_assignment_target_var(self: MIRLowering, target_node: Locatable) RETURNS ?String ->
    IF target_node IS_A Identifier AS identifier THEN
      RETURN COPY identifier__name(identifier);
    ELSE
      RETURN NIL;
    END
END
PRIVATE FN mIRLowering__indexed_assignment_allocs(MUTABLE self: MIRLowering, MUTABLE op: FunctionSignature, target_node: Locatable, assignment: Assignment) RETURNS !InlineAllocMetadata@multiowned ->
    RETURN inlineAllocMetadata__new(TRY (mIRLowering__indexed_assignment_resolved_alloc(&self, &op, IntrinsicAllocationKind.Alloc, target_node, assignment)), TRY (mIRLowering__indexed_assignment_resolved_alloc(&self, &op, IntrinsicAllocationKind.KeyAlloc, target_node, assignment)), TRY (mIRLowering__indexed_assignment_resolved_alloc(&self, &op, IntrinsicAllocationKind.ValAlloc, target_node, assignment)), TRY (mIRLowering__indexed_assignment_resolved_alloc(&self, &op, IntrinsicAllocationKind.ShardAlloc, target_node, assignment)));
END
PRIVATE FN mIRLowering__indexed_assignment_resolved_alloc(MUTABLE self: MIRLowering, MUTABLE op: FunctionSignature, alloc_key: IntrinsicAllocationKind, target_node: Locatable, assignment: Assignment) RETURNS !?String@symbol ->
    MUTABLE registry_alloc: ?String@symbol = TRY (mIRLowering__indexed_assignment_registry_alloc(self, &op, alloc_key));
    IF registry_alloc EXISTS AS registry_alloc_value THEN
      RETURN TRY (mIRLowering__resolve_alloc_sym(&self, registry_alloc_value, target_node, Locatable{ Assignment: COPY assignment }));
    ELSE
      RETURN NIL;
    END
END
PRIVATE FN mIRLowering__indexed_assignment_registry_alloc(self: MIRLowering, MUTABLE op: FunctionSignature, alloc_key: IntrinsicAllocationKind) RETURNS !?String@symbol ->
    RETURN TRY (functionSignature__intrinsic_alloc(&op, alloc_key));
END
PRIVATE FN mIRLowering__lower_field_assignment_with_cleanup(MUTABLE self: MIRLowering, MUTABLE node: Assignment) RETURNS !ScopeBlock ->
    MUTABLE lifecycle: ?LifecyclePlan = COPY node.field_lifecycle_plan;
    IF !((IF lifecycle != NIL THEN
      lifecyclePlan__needs_drop?(lifecycle)
    ELSE
      NIL
    END)) THEN
      panic("field cleanup lacks annotation lifecycle plan");
    END
    MUTABLE alloc_sym = TRY (mIRLowering__placement_for_node(&self, (IF mIRLowering__root_receiver_node(self, castAssignmentNameToOptionalLocatable__mir_lowering(node.name)) EXISTS AS rtoc_root THEN Locatable{ Identifier: COPY rtoc_root } ELSE UNWRAP (castAssignmentNameToOptionalLocatable__mir_lowering(node.name)) END)));
    MUTABLE rtoc_field_name: ?GetField = NIL;
    PARTIAL MATCH node.name START
      AssignmentName.GetField AS rtoc_gf -> rtoc_field_name = COPY rtoc_gf;,
      DEFAULT -> PASS;
    END
    MUTABLE receiver_type: ?Type = TRY (type__from_node_mut(COPY UNWRAP (rtoc_field_name).target, "field assignment receiver"));
    IF TRY (type__node_reference?( UNWRAP (receiver_type))) THEN
      alloc_sym = :heap;
    END
    MUTABLE kept_value: ?Emittable = mIRLowering__with_decl_alloc(&self, alloc_sym, %() USE(MUTABLE node, MUTABLE self) -> TRY (mIRLowering__kept_assignment_field_value(&self, node)));
    IF (kept_value != NIL AND TRY (mIRLowering__mir_allocates?(&self, kept_value))) THEN
      kept_value = TRY (mIRLowering__hoist_alloc(&self, &kept_value, &node.value, TRUE));
    END
    MUTABLE value: ?Emittable = COPY kept_value;
    IF kept_value == NIL THEN
      value = mIRLowering__with_decl_alloc(&self, alloc_sym, %() USE(MUTABLE node, MUTABLE self, alloc_sym) -> {
        MUTABLE rtoc_lowered: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(COPY node.value)));
        TRY (mIRLowering__place_value_for_destination(&self, UNWRAP (rtoc_lowered), &node.value, alloc_sym, TypeTypeInput{ Type: COPY TRY (aST__full_type_mut(castAssignmentNameToLocatable__mir_lowering(node.name))) }))
      });
      value = TRY (mIRLowering__materialize_owned_sink_value(&self, UNWRAP (value), node.value, alloc_sym, NIL));
      IF TRY (mIRLowering__mir_allocates?(&self, value)) THEN
        value = TRY (mIRLowering__hoist_alloc(&self, UNWRAP (value), &node.value, TRUE));
      END
    END
    MUTABLE alloc = AllocatorRef{ kind: COPY alloc_sym, lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE field_get: Emittable = CAST(TRY (mIRLowering__lower(&self, castAssignmentNameToMIRLoweringLowerableStmt(node.name))) AS Emittable);
    MUTABLE type_expr = TypeOf{ expr: COPY field_get, lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE cleanup_call = Call{ callee: "CheatLib.cleanup", args: [Emittable{ TypeOf: COPY type_expr }, Emittable{ AllocatorRef: COPY alloc }, Emittable{ AddressOf: COPY AddressOf{ expr: COPY field_get, lowered_node_id: NIL, ownership_consumption: NIL } }], try_wrap: FALSE, owned_return: FALSE, callable_contract: TRY (callableContract__no_ownership(3)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL };
    MUTABLE assign = Set{ target: COPY field_get, value: COPY UNWRAP (value), needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    TRY (mIRLowering__with_ownership_consumption_for_value(&self, Emittable{ Set: COPY assign }, UNWRAP (value), &node.value, "MIR::Set", :owned_sink, alloc_sym));
    RETURN ScopeBlock{ body: COPY [Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ Call: COPY cleanup_call }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ Set: COPY assign }], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN mIRLowering__lower_auto_lock_assignment(MUTABLE self: MIRLowering, MUTABLE node: Assignment) RETURNS !Emittable ->
    MUTABLE stmts: []Emittable = List[];
    MUTABLE value_pending: []Emittable = List[];
    MUTABLE facts = TRY (mIRLowering__auto_lock_assignment_facts(&self, node));
    IF facts.cleanup_alloc EXISTS AS cleanup_alloc_value THEN
      MUTABLE lifecycle: ?LifecyclePlan = COPY node.field_lifecycle_plan;
      IF !((IF lifecycle != NIL THEN
        lifecyclePlan__needs_drop?(lifecycle)
      ELSE
        NIL
      END)) THEN
        panic("auto-lock field cleanup lacks annotation lifecycle plan");
      END
    END
    MUTABLE len_guard = %(old_name, alloc_sym) -> IfStmt{ cond: Emittable{ MIRBinOp: COPY MIRBinOp{ op: ">", left: Emittable{ ListLength: COPY ListLength{ expr: Emittable{ Ident: COPY Ident{ name: COPY old_name, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: [Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ FreeSlice: COPY FreeSlice{ slice: Emittable{ Ident: COPY Ident{ name: COPY old_name, lowered_node_id: NIL, ownership_consumption: NIL } }, alloc: COPY alloc_sym, lowered_node_id: NIL, ownership_consumption: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL };
    IF symbolEntry__always_mutable_sync?(facts.sync) THEN
      MUTABLE value = TRY (mIRLowering__auto_lock_assignment_value(&self, &node, facts.alloc_sym));
      value_pending = TRY (mIRLowering__flush_pending(&self));
      MUTABLE get_field = FieldGet{ object: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: COPY facts.zig_var, lowered_node_id: NIL, ownership_consumption: NIL } }, method: "get", args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, field: COPY facts.field, lowered_node_id: NIL, ownership_consumption: NIL };
      IF facts.cleanup_alloc EXISTS AS cleanup_alloc_value THEN
        MUTABLE cleanup_alloc_value_mutable = COPY cleanup_alloc_value;
        stmts = (value_pending + CAST([Emittable{ Let: COPY Let{ name: COPY "__old", init: Emittable{ FieldGet: COPY get_field }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }, Emittable{ Set: COPY castEmittableToSet(TRY (mIRLowering__with_ownership_consumption_for_value(&self, Emittable{ Set: COPY Set{ target: Emittable{ FieldGet: COPY get_field }, value: COPY value, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, &value, &node.value, "MIR::Set", :owned_sink, facts.alloc_sym))) }] AS []Emittable));
        &stmts.append(Emittable{ Call: CAST(COPY len_guard("__old", cleanup_alloc_value_mutable) AS Call)});
        RETURN Emittable{ ScopeBlock: COPY ScopeBlock{ body: TRY (mIRLowering__append_ownership_transfers_for_mir_body(&self, stmts)), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
      ELSE
        MUTABLE set = Set{ target: Emittable{ FieldGet: COPY get_field }, value: COPY value, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
        TRY (mIRLowering__with_ownership_consumption_for_value(&self, Emittable{ Set: COPY set }, &value, &node.value, "MIR::Set", :owned_sink, facts.alloc_sym));
        RETURN Emittable{ Set: COPY set };
      END
    END
    MUTABLE acquire_method: String = "";
    IF symbolEntry__write_locked_sync?(facts.sync) THEN
      acquire_method = "write";
    ELSE
      acquire_method = "acquire";
    END
    MUTABLE prev_locked: ?{String}LockedUnwrapMapValue = COPY mIRLowering__capability_state(&self).locked_unwrap_map;
    MUTABLE rtoc_locked_map: {String}LockedUnwrapMapValue = {};
    IF prev_locked EXISTS AS rtoc_prev_locked THEN
      rtoc_locked_map = COPY rtoc_prev_locked;
    END
    &rtoc_locked_map.merge_mut({facts.alias_var: LockedUnwrapMapValue{ BoolValue: TRUE }, facts.var_name: LockedUnwrapMapValue{ StringValue: COPY facts.alias_var }});
    self.state.capabilities.locked_unwrap_map = COPY rtoc_locked_map;
    MUTABLE value = TRY (mIRLowering__auto_lock_assignment_value(&self, &node, facts.alloc_sym));
    value_pending = TRY (mIRLowering__flush_pending(&self));
    self.state.capabilities.locked_unwrap_map = prev_locked;
    MUTABLE alias_field = FieldGet{ object: Emittable{ Ident: COPY Ident{ name: COPY facts.alias_var, lowered_node_id: NIL, ownership_consumption: NIL } }, field: COPY facts.field, lowered_node_id: NIL, ownership_consumption: NIL };
    stmts = (CAST([Emittable{ Let: COPY Let{ name: COPY facts.guard_var, init: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: COPY facts.zig_var, lowered_node_id: NIL, ownership_consumption: NIL } }, method: COPY acquire_method, args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, mutable: TRUE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }, Emittable{ MIRDeferStmt: COPY MIRDeferStmt{ body: DeferBody{ Emittable: COPY CAST(COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: COPY facts.guard_var, lowered_node_id: NIL, ownership_consumption: NIL } }, method: "release", args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } AS Emittable) }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ Let: COPY Let{ name: COPY facts.alias_var, init: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: COPY facts.guard_var, lowered_node_id: NIL, ownership_consumption: NIL } }, method: "get", args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }] AS []Emittable) + value_pending);
    IF facts.cleanup_alloc EXISTS AS cleanup_alloc_value THEN
      MUTABLE cleanup_alloc_value_mutable = COPY cleanup_alloc_value;
      &stmts.append(Emittable{ Let: COPY Let{ name: COPY "__old", init: Emittable{ FieldGet: COPY alias_field }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
      &stmts.append(Emittable{ Set: COPY castEmittableToSet(TRY (mIRLowering__with_ownership_consumption_for_value(&self, Emittable{ Set: COPY Set{ target: Emittable{ FieldGet: COPY alias_field }, value: COPY value, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, &value, &node.value, "MIR::Set", :owned_sink, facts.alloc_sym))) });
      &stmts.append(Emittable{ Call: CAST(COPY len_guard("__old", cleanup_alloc_value_mutable) AS Call)});
    ELSE
      &stmts.append(Emittable{ Set: COPY castEmittableToSet(TRY (mIRLowering__with_ownership_consumption_for_value(&self, Emittable{ Set: COPY Set{ target: Emittable{ FieldGet: COPY alias_field }, value: COPY value, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, &value, &node.value, "MIR::Set", :owned_sink, facts.alloc_sym))) });
    END
    RETURN Emittable{ ScopeBlock: COPY ScopeBlock{ body: TRY (mIRLowering__append_ownership_transfers_for_mir_body(&self, stmts)), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
END
PRIVATE FN mIRLowering__auto_lock_assignment_facts(MUTABLE self: MIRLowering, node: Assignment) RETURNS !AutoLockAssignmentFacts ->
    MUTABLE auto_lock: AutoLockPlan = UNWRAP (COPY node.auto_lock);
    MUTABLE var_name = COPY auto_lock.var;
    MUTABLE cleanup_alloc: ?String@symbol = COPY node.field_pre_cleanup;
    MUTABLE rtoc_field_name: ?GetField = NIL;
    PARTIAL MATCH node.name START
      AssignmentName.GetField AS rtoc_gf -> rtoc_field_name = COPY rtoc_gf;,
      DEFAULT -> PASS;
    END
    MUTABLE rtoc_zig_var: String = COPY var_name;
    IF mIRLowering__capture_state(&self).do_capture_map EXISTS AS rtoc_cap_map THEN
      IF rtoc_cap_map[var_name] EXISTS AS rtoc_mapped THEN
        rtoc_zig_var = COPY rtoc_mapped;
      END
    END
    MUTABLE rtoc_alloc_sym: String@symbol = :heap;
    IF cleanup_alloc EXISTS AS rtoc_cleanup_alloc THEN
      rtoc_alloc_sym = COPY rtoc_cleanup_alloc;
    ELSE
      rtoc_alloc_sym = TRY (mIRLowering__placement_for_node(&self, (IF mIRLowering__root_receiver_node(self, castAssignmentNameToOptionalLocatable__mir_lowering(node.name)) EXISTS AS rtoc_root THEN Locatable{ Identifier: COPY rtoc_root } ELSE UNWRAP (castAssignmentNameToOptionalLocatable__mir_lowering(node.name)) END)));
    END
    RETURN AutoLockAssignmentFacts{ var_name: COPY var_name, sync: COPY auto_lock.sync, guard_var: "__${var_name}_guard", alias_var: "__${var_name}_inner", zig_var: COPY rtoc_zig_var, field: COPY UNWRAP (rtoc_field_name).field, cleanup_alloc: COPY cleanup_alloc, alloc_sym: COPY rtoc_alloc_sym };
END
PRIVATE FN mIRLowering__auto_lock_assignment_value(MUTABLE self: MIRLowering, MUTABLE node: Assignment, alloc_sym: String@symbol) RETURNS !Emittable ->
    MUTABLE value: ?Emittable = mIRLowering__with_decl_alloc(&self, alloc_sym, %() USE(alloc_sym, MUTABLE node, MUTABLE self) -> {
    MUTABLE lowered: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__pipeline_lowering_bridge(node.value)));
    MUTABLE placed = TRY (mIRLowering__place_value_for_destination(&self, UNWRAP (lowered), &node.value, alloc_sym, TypeTypeInput{ Type: COPY TRY (aST__full_type_mut( castAssignmentNameToLocatable__type_analysis_session(node.name))) }));
    TRY (mIRLowering__materialize_owned_sink_value(&self, placed, node.value, alloc_sym, TypeTypeInput{ Type: COPY TRY (aST__full_type_mut(castAssignmentNameToLocatable__ast(node.name))) }))
    });
    IF (TRUE AND TRY (mIRLowering__mir_allocates?(&self, value))) THEN
      RETURN TRY (mIRLowering__hoist_alloc(&self, &value, &node.value, TRUE));
    ELSE
      RETURN value;
    END
END
PRIVATE FN mIRLowering__loop_condition_expr(MUTABLE self: MIRLowering, cond: Emittable, pending_value: []Emittable) RETURNS !Emittable ->
    IF (pending_value.length() == 0) THEN
      RETURN COPY cond;
    END
    MUTABLE label = "__while_cond_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_710 = mIRLowering__lowering_counters(&self);
    mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_block_expr_id(&rtoc_mutable_receiver_710)) }}";
    MUTABLE body: []Emittable = List[];
