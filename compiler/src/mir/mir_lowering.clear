PRIVATE FN mIRLowering__borrowed_capability_binding(self: MIRLowering, context: WithCapabilityBindingContext) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE source_mir = mIRLowering__with_capability_source_mir(rtoc_self_view, context.var_node);
    MUTABLE is_param = mIRLowering__with_cap_is_param?(rtoc_self_view, context.var_node);
    MUTABLE safe_alias = mIRLowering__safe_with_capability_alias(rtoc_self_view, context.alias_name);
    MUTABLE aliased_value =   IF (COPY context.node).polymorphic THEN
      CapabilityUnwrap{ source: COPY source_mir, lowered_node_id: NIL, ownership_consumption: NIL }
    ELSE_IF mIRLowering__borrowed_const_param_alias?(rtoc_self_view, context, is_param) THEN
      Deref{ expr: COPY source_mir, lowered_node_id: NIL, ownership_consumption: NIL }
    ELSE_IF (IF context.resolved_type != NIL THEN
      TRY (type__non_string_array?(context.resolved_type))
    ELSE
      NIL
    END) THEN
      ItemsAccess{ expr: COPY source_mir, safe: TRUE, lowered_node_id: NIL, ownership_consumption: NIL }
    ELSE
      source_mir
    END;
    RETURN CAST([Emittable{ Let: COPY Let{ name: COPY safe_alias, init: COPY aliased_value, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }, Emittable{ Suppress: COPY Suppress{ name: COPY safe_alias, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable);
}
END
PRIVATE FN mIRLowering__borrowed_const_param_alias?(self: MIRLowering, context: WithCapabilityBindingContext, is_param: Bool) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(is_param) THEN
      RETURN FALSE;
    END
    IF !(((context.var_sync == NIL) OR ((context.var_sync)? == :local))) THEN
      RETURN FALSE;
    END
    MUTABLE sym: ?SymbolEntry = NIL;
    MATCH context.var_node START
      CapabilityVarNode.Identifier AS item ->
        sym = COPY item.symbol;,
      CapabilityVarNode.GetField AS item ->
        sym = COPY item.symbol;,
      CapabilityVarNode.GetIndex AS item ->
        sym = COPY item.symbol;,
    END
    IF sym EXISTS AS sym_value THEN
      IF !(sym_value.mutable) THEN
        MUTABLE source_type = TRY (type__new(TypeConstructionInput{ Type: COPY symbolEntry__type(sym_value) }));
        IF (TRY (type__non_string_array?(source_type)) AND !(type__collection?(source_type))) THEN
          RETURN FALSE;
        END
        RETURN TRUE;
      ELSE
        RETURN FALSE;
      END
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN mIRLowering__restrict_capability_binding(self: MIRLowering, context: WithCapabilityBindingContext) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(((context.var_sync == NIL) OR ((context.var_sync)? == :local))) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_446: []Emittable = List[]; rtoc_empty_list_446 } ) AS []Emittable);
    END
    MUTABLE source_mir = mIRLowering__with_capability_source_mir(rtoc_self_view, context.var_node);
    MUTABLE safe_alias = mIRLowering__safe_with_capability_alias(rtoc_self_view, context.alias_name);
    MUTABLE value =   IF (COPY context.node).polymorphic THEN
      CapabilityUnwrap{ source: COPY source_mir, lowered_node_id: NIL, ownership_consumption: NIL }
    ELSE_IF mIRLowering__with_cap_is_param?(rtoc_self_view, context.var_node) THEN
      Deref{ expr: COPY source_mir, lowered_node_id: NIL, ownership_consumption: NIL }
    ELSE_IF context.cap.alias_mutable THEN
      AddressOf{ expr: COPY source_mir, lowered_node_id: NIL, ownership_consumption: NIL }
    ELSE
      source_mir
    END;
    MUTABLE stmts: []Emittable = [Emittable{ Let: COPY Let{ name: COPY safe_alias, init: COPY value, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }];
    IF !(((context.var_sync == :local) OR context.cap.alias_mutable)) THEN
      &stmts.append(Emittable{ Suppress: COPY Suppress{ name: COPY safe_alias, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    END
    RETURN stmts;
}
END
PRIVATE FN mIRLowering__view_capability_binding(self: MIRLowering, context: WithCapabilityBindingContext) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE source_mir = mIRLowering__with_capability_source_mir(rtoc_self_view, context.var_node);
    MUTABLE safe_alias = mIRLowering__safe_with_capability_alias(rtoc_self_view, context.alias_name);
    MUTABLE rt = (context.resolved_type OR_ELSE TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })));
    MUTABLE inner_t_branch_value: ?Type = NIL;
    IF type__future?(rt) THEN
      inner_t_branch_value = TRY (type__tense_type(rt));
    ELSE
      inner_t_branch_value = rt;
    END
    MUTABLE inner_t: Type = inner_t_branch_value?;
    MUTABLE wrapped_inner: ?Type = TRY (type__wrapped_type(inner_t));
    MUTABLE is_value_shape = ((type__primitive?(inner_t) OR TRY (type__string?(inner_t))) OR (((type__optional?(inner_t) AND (wrapped_inner != NIL)) AND ((type__primitive?(wrapped_inner) OR TRY (type__string?(wrapped_inner)))))));
    MUTABLE wants_release = (!(is_value_shape) AND ((TRY (type__collection_value?(inner_t)) OR !(type__primitive?(inner_t)))));
    MUTABLE view_expr = MIRMethodCall{ receiver: COPY source_mir, method: "view", args: ( { MUTABLE rtoc_empty_list_447: []Any = List[]; rtoc_empty_list_447 } ), try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    MUTABLE stmts: []Emittable = [Emittable{ Let: COPY Let{ name: COPY safe_alias, init: Emittable{ MIRMethodCall: COPY view_expr }, mutable: wants_release, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }];
    IF wants_release THEN
      &stmts.append(Emittable{ MIRDeferStmt: COPY MIRDeferStmt{ body: DeferBody{ Emittable: COPY CAST(COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: safe_alias, lowered_node_id: NIL, ownership_consumption: NIL } }, method: "release", args: ( { MUTABLE rtoc_empty_list_448: []Any = List[]; rtoc_empty_list_448 } ), try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } AS Emittable) }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    END
    stmts = ruby_array_concat_Emittable(stmts, mIRLowering__coop_yield_mir(rtoc_self_view));
    &stmts.append(Emittable{ Suppress: COPY Suppress{ name: COPY safe_alias, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    RETURN stmts;
}
END
PRIVATE FN mIRLowering__unsafe_foreign_view_binding(self: MIRLowering, context: WithCapabilityBindingContext) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE lowerer: MIRLowering@multiowned = CAST(rtoc_self_view AS MIRLowering@multiowned);
    MUTABLE length: ?Locatable = COPY context.cap.view_length;
    IF length EXISTS AS length_value THEN
      MUTABLE length_value_mutable = COPY length_value;
      MUTABLE source_mir = mIRLowering__with_capability_source_mir(rtoc_self_view, context.var_node);
      MUTABLE safe_alias = mIRLowering__safe_with_capability_alias(rtoc_self_view, context.alias_name);
      MUTABLE view = ForeignSliceView{ pointer: COPY source_mir, count: COPY TRY (mIRLowering__lower(&lowerer, castLocatableToMIRLoweringLowerableStmt(length_value_mutable))), lowered_node_id: NIL, ownership_consumption: NIL };
      RETURN CAST([Emittable{ Let: COPY Let{ name: COPY safe_alias, init: Emittable{ ForeignSliceView: COPY view }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }, Emittable{ Suppress: COPY Suppress{ name: COPY safe_alias, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable);
    ELSE
      panic("Internal: WITH UNSAFE VIEW missing LENGTH expression");
    END
}
END
PRIVATE FN mIRLowering__coop_yield_mir(self: MIRLowering) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE scheduler = FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "CheatHeader", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "scheduler", lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE active_scheduler = FieldGet{ object: Emittable{ FieldGet: COPY scheduler }, field: "active_scheduler", lowered_node_id: NIL, ownership_consumption: NIL };
    RETURN CAST([Emittable{ IfStmt: COPY IfStmt{ cond: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ FieldGet: COPY scheduler }, field: "scheduler_running", lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: [ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ FieldGet: COPY active_scheduler }, method: "drainChannels", args: ( { MUTABLE rtoc_empty_list_451: []Any = List[]; rtoc_empty_list_451 } ), try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }, ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ FieldGet: COPY active_scheduler }, method: "coopYield", args: ( { MUTABLE rtoc_empty_list_452: []Any = List[]; rtoc_empty_list_452 } ), try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL } }] AS []Emittable);
}
END
PRIVATE FN mIRLowering__snapshot_capability_binding(self: MIRLowering, context: WithCapabilityBindingContext) RETURNS !?SnapshotRead
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF TRY (withCapabilityPlan__mutable_snapshot?((TRY (capabilityPlan__require_for(CAST(COPY COPY context.node AS WithBlock)))))) THEN
      RETURN NIL;
    END
    MUTABLE source_mir = mIRLowering__with_capability_source_mir(rtoc_self_view, context.var_node, TRUE);
    MUTABLE safe_alias = mIRLowering__safe_with_capability_alias(rtoc_self_view, context.alias_name);
    MUTABLE guard_var = "__${context.var_name}_snap_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_453 = (CAST(rtoc_self_view AS MIRLowering@multiowned));
    mIRLowering__stable_node_suffix(rtoc_local_receiver_453, Locatable{ WithBlock: COPY COPY context.node }) }}";
    RETURN SnapshotRead{ cell_unwrap: Emittable{ CapabilityUnwrap: COPY CapabilityUnwrap{ source: COPY source_mir, lowered_node_id: NIL, ownership_consumption: NIL } }, rt: COPY context.rt_name, alias_name: safe_alias, guard_var: guard_var, body: COPY List[], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
}
END
PRIVATE FN mIRLowering__materialized_view_capability_bindings(self: MIRLowering, context: WithCapabilityBindingContext) RETURNS ![]WithBindingNode
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE source_mir = mIRLowering__with_capability_source_mir(rtoc_self_view, context.var_node);
    MUTABLE safe_alias = mIRLowering__safe_with_capability_alias(rtoc_self_view, context.alias_name);
    MUTABLE rt = (context.resolved_type OR_ELSE TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })));
    MUTABLE is_collection = (TRY (type__observable_array_future?(rt)) OR type__array?(rt));
    MUTABLE materialize = MIRMethodCall{ receiver: COPY source_mir, method: "materialize", args: [CAST(AllocatorRef{ kind: :heap, lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: TRUE, callable_contract: COPY TRY (callableContract__no_ownership(1)), owned_result_alloc: IF is_collection THEN
      :heap
    ELSE
      NIL
    END, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    IF !(is_collection) THEN
      RETURN CAST([WithBindingNode{ Emittable: COPY CAST(Let{ name: COPY safe_alias, init: Emittable{ MIRMethodCall: COPY materialize }, mutable: TRUE, annotation: NIL, suppression: "_ = &${safe_alias};", alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } AS Emittable) }] AS []WithBindingNode);
    END
    MUTABLE entry = cleanupEntry__build(:uniform, :heap, FALSE);
    RETURN TRY (bindingMaterialization__statements((BindingMaterialization{ name: COPY safe_alias, expr: Emittable{ MIRMethodCall: COPY materialize }, alloc: :heap, type_info: COPY TRY (type__tense_type(rt)), mutable: TRUE, suppression: "_ = &${safe_alias};", cleanup_entry: entry, scope: :heap, annotation: NIL, cleanup_mode: :normal, ownership_tracked: TRUE })));
}
END
PRIVATE FN mIRLowering__with_block_control_label(self: MIRLowering, node: WithBlock, clause: ?ErrorClause) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF clause EXISTS AS clause_value THEN
      IF (((clause_value.action == ErrorActionKind.Pass) OR (clause_value.action == ErrorActionKind.Block))) THEN
        RETURN "__with_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_454 = (CAST(rtoc_self_view AS MIRLowering@multiowned));
        mIRLowering__stable_node_suffix(rtoc_local_receiver_454, Locatable{ WithBlock: COPY node }) }}";
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN mIRLowering__mutable_snapshot_with?(self: MIRLowering, node: WithBlock) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (withCapabilityPlan__mutable_snapshot?((TRY (capabilityPlan__require_for(node)))));
}
END
PRIVATE FN mIRLowering__with_block_body_stmts(MUTABLE self: MIRLowering, node: WithBlock, materialization: WithBindingMaterialization, with_label: ?String) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN mIRLowering__with_capability_alias_maps(rtoc_self_view, node, %() USE(materialization, node, with_label, MUTABLE rtoc_self_view) -> {
    IF mIRLowering__mutable_snapshot_with?(rtoc_self_view, node) THEN
      withBindingMaterialization__add_binding(materialization, WithBindingNode{ Emittable: castMIRLoweringCapabilitiesReturnValueToEmittable(mIRLowering__emit_snapshot_mutable_call(&rtoc_self_view, node, with_label)) });
      RETURN List[];
    ELSE
      MUTABLE lowered_body = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_455 = (CAST(rtoc_self_view AS MIRLowering@multiowned));
      TRY (mIRLowering__lower_body(&rtoc_mutable_receiver_455, node.body)) };
      RETURN mIRLowering__wrap_body_with_guard(&rtoc_self_view, node, lowered_body, with_label);
    END
    NIL
    });
}
END
PRIVATE FN mIRLowering__with_block_borrow_names(self: MIRLowering, node: WithBlock) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN mIRLowering__with_capability_specs(rtoc_self_view, node) |> SELECT:? {
    MUTABLE var_node: CapabilityVarNode = COPY castLocatableToCapabilityVarNode(_.var_node);
    (IF var_node IS_A Identifier THEN
        CAST(var_node.name() AS String)
      ELSE
        NIL
      END)
    } |> WHERE _ != NIL;
}
END
PRIVATE FN mIRLowering__with_block_inline_bindings(self: MIRLowering, materialization: WithBindingMaterialization, node: WithBlock) RETURNS !?Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE string_bindings = (materialization.bindings |> SELECT:? (  IF _ IS_A String THEN
      _
    ELSE
      NIL
    END) |> WHERE _ != NIL) |> WHERE !(_.empty?());
    IF (string_bindings.length() == 0) THEN
      RETURN NIL;
    END
    panic("WITH binding materialization still produced pre-emission Zig text; structural MIR binding nodes are required");
}
END
PRIVATE FN mIRLowering__structured_with_bindings(self: MIRLowering, materialization: WithBindingMaterialization) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN materialization.bindings |> UNNEST (  IF _ IS_A []Emittable THEN
      _
    ELSE_IF _ IS_A Emittable THEN
      [_]
    ELSE
      List[]
    END);
}
END
PRIVATE FN mIRLowering__assemble_with_block(self: MIRLowering, node: WithBlock, materialization: WithBindingMaterialization, body_stmts: []Emittable, with_label: ?String) RETURNS MIRLoweringReturnValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE stmts: []Emittable = ( { MUTABLE rtoc_empty_list_456: []Emittable = List[]; rtoc_empty_list_456 } );
    MUTABLE inline_bindings: ?Emittable = mIRLowering__with_block_inline_bindings(rtoc_self_view, materialization, node);
    IF inline_bindings EXISTS AS inline_bindings_value THEN
      &stmts.append(inline_bindings_value);
    END
    stmts = ruby_array_concat_Emittable(stmts, mIRLowering__structured_with_bindings(rtoc_self_view, materialization));
    stmts = ruby_array_concat_Emittable(stmts, body_stmts);
    IF with_label EXISTS AS with_label_value THEN
      RETURN MIRLoweringReturnValue{ MIRBlockExpr: COPY MIRBlockExpr{ label: COPY with_label_value, body: Body{ ArrayValue: stmts |> SELECT castEmittableToLocatable(_) }, lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL } };
    ELSE
      RETURN MIRLoweringReturnValue{ ScopeBlock: COPY ScopeBlock{ body: Body{ ArrayValue: stmts |> SELECT castEmittableToLocatable(_) }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
}
END
PRIVATE FN mIRLowering__lower_with_block(MUTABLE self: MIRLowering, node: WithBlock) RETURNS MIRLoweringReturnValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node.arms EXISTS AS arms_value THEN
      MUTABLE arms_value_mutable = COPY arms_value;
      RETURN MIRLoweringReturnValue{ ScopeBlock: COPY mIRLowering__lower_with_match_block(&rtoc_self_view, node) };
    END
    IF (node.universal_poly AND (mIRLowering__with_capability_specs(rtoc_self_view, node).length() == 1)) THEN
      RETURN MIRLoweringReturnValue{ ScopeBlock: COPY mIRLowering__lower_polymorphic_universal(&rtoc_self_view, node) };
    END
    MUTABLE rt_name = mIRLowering__runtime_binding_name(rtoc_self_view);
    MUTABLE clause: ?ErrorClause = COPY CAST(node.lock_error_clause AS ?ErrorClause);
    MUTABLE with_label: ?String = mIRLowering__with_block_control_label(rtoc_self_view, node, clause);
    MUTABLE materialization = mIRLowering__with_binding_materialization(&rtoc_self_view, node, with_label, rt_name);
    RETURN castMIRLoweringCapabilitiesReturnValueToMIRLoweringReturnValue(mIRLowering__assemble_with_block(rtoc_self_view, node, materialization, mIRLowering__with_block_body_stmts(&rtoc_self_view, node, materialization, with_label), with_label));
}
END
PRIVATE FN mIRLowering__with_capability_alias_maps<Result>(self: MIRLowering, node: WithBlock, blk: FN() -> Result) RETURNS Result
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
  MUTABLE prev_locked: ?{String}LockedUnwrapMapValue = COPY mIRLowering__capability_state(rtoc_self_view).locked_unwrap_map;
  MUTABLE prev_rc: ?{String}String = COPY mIRLowering__capability_state(rtoc_self_view).rc_unwrap_map;
  MUTABLE prev_alias_alloc: ?{String}?String@symbol = COPY mIRLowering__capability_state(rtoc_self_view).with_alias_alloc_map;
  MUTABLE prev_alias_owner: ?{String}String = COPY mIRLowering__capability_state(rtoc_self_view).with_alias_owner_map;
  MUTABLE prev_polymorphic_types: ?{String}String = COPY mIRLowering__capability_state(rtoc_self_view).polymorphic_alias_type_map;
  DEFER {
  MUTABLE rtoc_writer_receiver_457: MIRLoweringCapabilityState = mIRLowering__capability_state(rtoc_self_view);
  rtoc_writer_receiver_457.locked_unwrap_map = prev_locked;
  MUTABLE rtoc_writer_receiver_458: MIRLoweringCapabilityState = mIRLowering__capability_state(rtoc_self_view);
  rtoc_writer_receiver_458.rc_unwrap_map = prev_rc;
  MUTABLE rtoc_writer_receiver_459: MIRLoweringCapabilityState = mIRLowering__capability_state(rtoc_self_view);
  rtoc_writer_receiver_459.with_alias_alloc_map = prev_alias_alloc;
  MUTABLE rtoc_writer_receiver_460: MIRLoweringCapabilityState = mIRLowering__capability_state(rtoc_self_view);
  rtoc_writer_receiver_460.with_alias_owner_map = prev_alias_owner;
  MUTABLE rtoc_writer_receiver_461: MIRLoweringCapabilityState = mIRLowering__capability_state(rtoc_self_view);
  rtoc_writer_receiver_461.polymorphic_alias_type_map = prev_polymorphic_types;
  }
  MUTABLE locked_map: {String}LockedUnwrapMapValue = COPY ((prev_locked OR_ELSE {}));
  MUTABLE rc_map: {String}String = COPY ((prev_rc OR_ELSE {}));
  MUTABLE alias_alloc_map: {String}?String@symbol = COPY ((prev_alias_alloc OR_ELSE {}));
  MUTABLE alias_owner_map: {String}String = COPY ((prev_alias_owner OR_ELSE {}));
  MUTABLE polymorphic_types: {String}String = COPY ((prev_polymorphic_types OR_ELSE {}));
  MUTABLE rtoc_writer_receiver_462: MIRLoweringCapabilityState = mIRLowering__capability_state(rtoc_self_view);
  rtoc_writer_receiver_462.locked_unwrap_map = locked_map;
  MUTABLE rtoc_writer_receiver_463: MIRLoweringCapabilityState = mIRLowering__capability_state(rtoc_self_view);
  rtoc_writer_receiver_463.rc_unwrap_map = rc_map;
  MUTABLE rtoc_writer_receiver_464: MIRLoweringCapabilityState = mIRLowering__capability_state(rtoc_self_view);
  rtoc_writer_receiver_464.with_alias_alloc_map = alias_alloc_map;
  MUTABLE rtoc_writer_receiver_465: MIRLoweringCapabilityState = mIRLowering__capability_state(rtoc_self_view);
  rtoc_writer_receiver_465.with_alias_owner_map = alias_owner_map;
  MUTABLE rtoc_writer_receiver_466: MIRLoweringCapabilityState = mIRLowering__capability_state(rtoc_self_view);
  rtoc_writer_receiver_466.polymorphic_alias_type_map = polymorphic_types;
  FOR _ IN mIRLowering__with_capability_specs(rtoc_self_view, node) DO
    MUTABLE var_node: CapabilityVarNode = COPY castLocatableToCapabilityVarNode(_.var_node);
    MUTABLE var_name = COPY _.target_label;
    MUTABLE alias_name = COPY _.alias_name;
    IF _.alias_explicit THEN
        MUTABLE generic_inner = type__generic_type_parameter?(_.resolved_type);
        alias_alloc_map[alias_name] = IF generic_inner THEN
          :heap
        ELSE
          mIRLowering__placement_for_node(rtoc_self_view, castCapabilityVarNodeToLocatable(var_node))
        END;
        alias_owner_map[alias_name] = COPY var_name;
        IF (node.universal_poly AND generic_inner) THEN
          polymorphic_types[alias_name] = "CheatLib.PolymorphicInner(${type__resolved(_.resolved_type)})";
          RETURN "CheatLib.PolymorphicInner(${type__resolved(_.resolved_type)})";
        END
    END
    IF (_.capability == symbol("EXCLUSIVE")) OR (_.capability == :write_locked_read) THEN
        locked_map[alias_name] = LockedUnwrapMapValue{ BoolValue: TRUE };
        IF (alias_name != var_name) THEN
          locked_map[var_name] = LockedUnwrapMapValue{ StringValue: COPY alias_name };
          RETURN alias_name;
        END
    ELSE_IF (_.capability == :multiowned) OR (_.capability == :shared) THEN
        rc_map[var_name] = "__${var_name}_unwrap";
        RETURN "__${var_name}_unwrap";
    END
  END
  RETURN blk();
}
END
PRIVATE FN mIRLowering__build_fallible_clause_mir(MUTABLE self: MIRLowering, var_name: String, alias_name: String, clause: ErrorClause) RETURNS !FallibleClauseFact
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE action_mir: []Emittable = ( { MUTABLE rtoc_empty_list_467: []Emittable = List[]; rtoc_empty_list_467 } );
    MUTABLE exit_msg_mir: ?Emittable = NIL;
    IF (clause.action == ErrorActionKind.Block) THEN
      action_mir = TRY (mIRLowering__lower_body(&rtoc_self_view, clause.body));
    ELSE_IF (clause.action IS_A Exit) THEN
      exit_msg_mir = TRY (mIRLowering__lower(&rtoc_self_view, castNodeToMIRLoweringLowerableStmt(UNWRAP (clause.message))));
    END
    RETURN FallibleClauseFact{ var_name: COPY var_name, alias_name: COPY alias_name, action_kind: COPY clause.action, retries: clause.retries, matched_types: COPY clause.matched_types, bubble_types: COPY clause.bubble_types, action_mir: COPY action_mir, exit_msg_mir: COPY exit_msg_mir };
}
END
PRIVATE FN mIRLowering__lower_with_match_block(MUTABLE self: MIRLowering, node: WithBlock) RETURNS !ScopeBlock
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE cap = withCapabilityPlan__first_transition((TRY (capabilityPlan__require_for(node))));
    MUTABLE var_node: CapabilityVarNode = COPY castLocatableToCapabilityVarNode(cap.var_node);
    MUTABLE cell = mIRLowering__with_capability_source_mir(rtoc_self_view, var_node, TRUE);
    MUTABLE alias_name = COPY cap.alias_name;
    MUTABLE safe_alias = mIRLowering__safe_with_capability_alias(rtoc_self_view, alias_name);
    MUTABLE snapshot_mode = !(!(((TRUE AND node.snapshot_mode))));
    MUTABLE arms_meta = UNWRAP (node.arms) |> SELECT MIRWithMatchArm{ family: COPY _.family(), guard_var: "__${alias_name}_match_${mIRLowering__stable_node_suffix(rtoc_self_view, Locatable{ WithBlock: COPY node })}", body: COPY TRY (mIRLowering__lower_body(&rtoc_self_view, _.body())) };
    RETURN ScopeBlock{ body: Body{ ArrayValue: [WithMatchDispatch{ cell: COPY cell, alias_name: safe_alias, snapshot_mode: snapshot_mode, rt_name: mIRLowering__runtime_binding_name(rtoc_self_view), arms: arms_meta, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }] |> SELECT SegmentStmt{ Emittable: Emittable{ WithMatchDispatch: COPY _ } } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
}
END
PRIVATE FN mIRLowering__lower_polymorphic_universal(MUTABLE self: MIRLowering, node: WithBlock) RETURNS !ScopeBlock
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE cap = withCapabilityPlan__first_transition((TRY (capabilityPlan__require_for(node))));
    MUTABLE var_node: CapabilityVarNode = COPY castLocatableToCapabilityVarNode(cap.var_node);
    MUTABLE var_name = COPY cap.target_label;
    MUTABLE alias_name = COPY cap.alias_name;
    MUTABLE safe_alias = mIRLowering__zig_safe_name(rtoc_self_view, alias_name);
    MUTABLE cell_mir = AddressOf{ expr: COPY mIRLowering__with_capability_source_mir(rtoc_self_view, var_node, TRUE), lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE resolved_source = COPY cap.resolved_type;
    MUTABLE rt_obj = TRY (type__from_node_mut(resolved_source, "WITH polymorphic capability resolved type"));
    MUTABLE generic_inner = type__generic_type_parameter?(rt_obj);
    MUTABLE bare_type = TRY (type__new({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_468: ?String = NIL;
    IF generic_inner THEN
      rtoc_ternary_value_468 = "CheatLib.PolymorphicInner(${type__resolved(rt_obj)})";
    ELSE
      rtoc_ternary_value_468 = TRY (type__bare_data_type(rt_obj));
    END
    rtoc_ternary_value_468? }));
