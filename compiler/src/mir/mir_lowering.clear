PRIVATE FN mIRLowering__finalize_call_result(MUTABLE self: MIRLowering, MUTABLE node: CallNode, callee: String, args: []Emittable, can_fail: Bool, owned_return: Bool, contract: ?CallableContract, ast_args: []Locatable, mir_args: []Emittable) RETURNS !Emittable ->
    MUTABLE call = Call{ callee: COPY callee, args: COPY args, try_wrap: can_fail, owned_return: owned_return, callable_contract: COPY contract, lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL };
