PRIVATE FN mIRLowering__destructure_source_transfer(self: MIRLowering, node: DestructuringAssignment, value: Emittable) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE name: ?String = IF value IS_A Ident THEN
