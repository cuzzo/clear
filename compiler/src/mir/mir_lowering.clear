PRIVATE FN mIRLowering__guard_fsm_result_cleanup_mut(self: MIRLowering, body: []Emittable, facts: []FsmResultTransferFact) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rename_map = mIRLowering__fsm_fn_name_rename_map(rtoc_self_view);
    MUTABLE guarded_cleanup_names = mIRLowering__fsm_guarded_cleanup_names(rtoc_self_view);
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < facts.length() DO
      IF !(facts[rtoc_idx]?.move_guarded) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < body.length() DO
          IF !((body[rtoc_idx]? IS_A Cleanup OR body[rtoc_idx]? IS_A ErrCleanup)) THEN
            rtoc_idx = rtoc_idx + 1;
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
          END
          MUTABLE node_name = COPY CAST((body[rtoc_idx]?.name()) AS String);
          MUTABLE rendered_name = COPY (rename_map[node_name] OR_ELSE node_name);
          IF !(((node_name == facts[rtoc_idx]?.name) OR (rendered_name == facts[rtoc_idx]?.name))) THEN
              rtoc_idx = rtoc_idx + 1;
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
          END
          MUTABLE rtoc_mutable_receiver_197 = (body[rtoc_idx]?.cleanup_entry());
          cleanupEntry__mark_moved_guard_mut(&rtoc_mutable_receiver_197);
          MUTABLE rtoc_key_1: String = COPY UNWRAP (facts[rtoc_idx]).name;
          guarded_cleanup_names[rtoc_key_1] = TRUE;
        rtoc_idx = rtoc_idx + 1;
      END
    rtoc_idx = rtoc_idx + 1;
    END
    NIL;
}
END
