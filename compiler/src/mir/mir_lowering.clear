PRIVATE FN mIRLowering__owned_sink_plan(self: MIRLowering, value: Emittable, ast_node: Locatable, sink_alloc: String@symbol, sink_type: ?TypeTypeInput = NIL) RETURNS !OwnedSinkPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
