PRIVATE FN mIRLowering__hash_literal_put_stmt(MUTABLE self: MIRLowering, key_node: Locatable, val_node: Locatable, plan: HashLiteralPlan, alloc_expr: MIRMethodCall, hm_name: String) RETURNS !ExprStmt
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE key_mir = TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(key_node)));
    MUTABLE value_type = TRY (type__value_type(plan.type_info));
    MUTABLE raw_value = mIRLowering__with_decl_alloc(rtoc_self_view, plan.alloc, %() USE(plan, val_node, value_type, MUTABLE rtoc_self_view) -> {
    MUTABLE lowered_branch_value: ?U = NIL;
      IF value_type THEN
        lowered_branch_value = mIRLowering__with_expected_type(rtoc_self_view, value_type, %() USE(val_node, MUTABLE rtoc_self_view) -> {
      rtoc_lambda_result_646 = TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(val_node)));
      rtoc_lambda_result_646
        });
      ELSE
        lowered_branch_value = TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(val_node)));
      END
    MUTABLE lowered: U = lowered_branch_value?;
    MUTABLE placed = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_648: ?Emittable = NIL;
      IF value_type THEN
        rtoc_ternary_value_648 = TRY (mIRLowering__place_value_for_destination(rtoc_self_view, lowered, val_node, plan.alloc, TypeTypeInput{ Type: COPY value_type }));
      ELSE
        rtoc_ternary_value_648 = lowered;
      END
      rtoc_ternary_value_648? };
    TRY (mIRLowering__materialize_owned_sink_value(rtoc_self_view, placed, val_node, plan.alloc, TypeTypeInput{ Type: COPY value_type }))
    });
    MUTABLE value_mir = mIRLowering__hoist_alloc(rtoc_self_view, raw_value, val_node, TRUE);
    MUTABLE operands = (TRY (mIRLowering__ownership_operands_for_value(rtoc_self_view, key_mir, key_node, "hash literal key", plan.alloc)) + TRY (mIRLowering__ownership_operands_for_value(rtoc_self_view, value_mir, val_node, "hash literal value", plan.alloc)));
    MUTABLE base_contract = TRY (callableContract__no_ownership(4));
    MUTABLE put_contract = callableContract__new(base_contract.signature, TRY (ownershipContract__consume_operands(operands)), 4);
    RETURN ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: COPY hm_name, lowered_node_id: NIL, ownership_consumption: NIL } }, method: "put", args: [CAST(alloc_expr AS Any), CAST(alloc_expr AS Any), CAST(key_mir AS Any), CAST(value_mir AS Any)], try_wrap: TRUE, callable_contract: COPY put_contract, owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
}
END
PRIVATE FN mIRLowering__hash_literal_result(self: MIRLowering, result: Emittable, plan: HashLiteralPlan, capability: HashLiteralCapabilityPlan) RETURNS Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF hashLiteralCapabilityPlan__striped_result?(capability) THEN
      RETURN Emittable{ CapWrap: COPY CapWrap{ inner: COPY result, zig_base: COPY capability.zig_type, strategy: :own_only, sync_fn: NIL, sync_type: NIL, own_fn: COPY UNWRAP (capability.result_wrap_fn), alloc: :heap, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF hashLiteralCapabilityPlan__composed_result?(capability) THEN
      RETURN mIRLowering__compose_capability_wrap(rtoc_self_view, result, capability.zig_type, plan.type_info, :heap);
    END
    RETURN COPY result;
}
END
PRIVATE FN mIRLowering__list_literal_plan(self: MIRLowering, MUTABLE node: ListLit) RETURNS !ListLiteralPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE expected_ti: ?Type = TRY (type__from_node(mIRLowering__function_state(rtoc_self_view).current_expected_type));
    MUTABLE expected_owned_list = (((((expected_ti != NIL) AND TRY (type__direct_indexable_collection?((expected_ti?)))) AND type__dynamic?(expected_ti)) AND !(TRY (type__string?(expected_ti)))));
    IF expected_ti != NIL THEN
      expected_owned_list = type__collection?(expected_ti);
    END
    MUTABLE ti =   IF expected_owned_list THEN
      expected_ti
    ELSE
      (node.coerced_type_info() OR_ELSE TRY (aST__full_type_mut(node)))
    END;
    MUTABLE type_info = TRY (type__new(ti));
    MUTABLE elem_type: ?Type = TRY (type__element_type(type_info));
    MUTABLE elem_ti_branch_value: ?Type = NIL;
    IF elem_type EXISTS AS elem_type_value THEN
      elem_ti_branch_value = TRY (type__new(TypeConstructionInput{ Type: COPY elem_type_value }));
    ELSE
      elem_ti_branch_value = NIL;
    END
    MUTABLE elem_ti: ?Type = elem_ti_branch_value;
    MUTABLE requested_alloc = (mIRLowering__function_state(rtoc_self_view).current_decl_alloc OR_ELSE mIRLowering__alloc_for_node(rtoc_self_view, Locatable{ ListLit: COPY node }));
    RETURN ListLiteralPlan{ type_info: COPY type_info, alloc: COPY requested_alloc, element_type: COPY elem_ti, element_zig: COPY IF elem_ti != NIL THEN
      mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ Type: COPY elem_ti })
    ELSE
      "u8"
    END, element_needs_owned_storage: IF elem_ti != NIL THEN
      TRY (type__recursive_cleanup_shape?(elem_ti, mIRLowering__mir_schema_lookup(rtoc_self_view)))
    ELSE
      FALSE
    END };
}
END
PRIVATE FN mIRLowering__hash_literal_plan(self: MIRLowering, MUTABLE node: HashLit) RETURNS !HashLiteralPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE expected_ti: ?Type = TRY (type__from_node(mIRLowering__function_state(rtoc_self_view).current_expected_type));
    IF (IF expected_ti != NIL THEN
      type__optional?(expected_ti)
    ELSE
      NIL
    END) THEN
      expected_ti = TRY (type__non_optional_type(expected_ti));
    END
    MUTABLE ti =   IF (IF expected_ti != NIL THEN
      type__map?(expected_ti)
    ELSE
      NIL
    END) THEN
      expected_ti
    ELSE
      TRY (type__new(TypeConstructionInput{ Type: COPY (node.coerced_type_info() OR_ELSE TRY (aST__full_type_mut(node))) }))
    END;
    MUTABLE map_alloc = (mIRLowering__function_state(rtoc_self_view).current_decl_alloc OR_ELSE mIRLowering__alloc_for_node(rtoc_self_view, Locatable{ HashLit: COPY node }));
    RETURN HashLiteralPlan{ type_info: COPY ti, alloc: COPY map_alloc, zig_type: COPY mIRLowering__transpile_type(rtoc_self_view, ti), arc_wrapped: type__shared?(ti), rc_wrapped: type__multiowned?(ti) };
}
END
PRIVATE FN mIRLowering__binding_placement_fact(self: MIRLowering, node: VarDecl, type_info: Type, binding_entry: CleanupEntry, heap_return_var: Bool, heap_return_binding_allocates: Bool) RETURNS BindingFact
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE storage = IF ((((IF node.symbol != NIL THEN
      symbolEntry__heap_storage?(node.symbol)
    ELSE
      NIL
    END) != NIL) OR heap_return_binding_allocates)) THEN
      :heap
    ELSE
      :frame
    END;
    MUTABLE cleanup_alloc =   IF (storage == :heap) THEN
      :heap
    ELSE_IF heap_return_var THEN
      :frame
    ELSE_IF cleanupEntry__present?(binding_entry) THEN
      cleanupEntry__alloc(binding_entry)
    ELSE
      mIRLowering__alloc_for_node(rtoc_self_view, Locatable{ VarDecl: COPY node })
    END;
    MUTABLE alloc = placement__binding_alloc(storage, cleanup_alloc, :frame);
    MUTABLE scope = IF cleanupEntry__present?(binding_entry) THEN
      cleanupEntry__scope(binding_entry)
    ELSE
      placement__cleanup_scope(alloc)
    END;
    RETURN BindingFact{ name: COPY CAST(node.name AS String), type_info: COPY type_info, storage: COPY storage, alloc: COPY alloc, scope: COPY scope, heap_return: COPY heap_return_var, escape_reason: IF (storage == :heap) THEN
      :symbol_storage
    ELSE
      NIL
    END };
}
END
PRIVATE FN mIRLowering__tied_shared_family_return_param(self: MIRLowering, node: FunctionDef, mutable_scalar_params: [Set]String) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE ret: ?Type = COPY node.return_type;
    IF !(((ret != NIL) AND type__polymorphic_shared?(ret))) THEN
      RETURN NIL;
    END
    IF !(type__generic_type_parameter?(ret)) THEN
      RETURN NIL;
    END
    MUTABLE params = node.params |> WHERE {
    MUTABLE pt = COPY _.type;
    (type__shared?(pt) AND (type__resolved(pt) == type__resolved(ret)))
    };
    IF !((params.length() == 1)) THEN
      RETURN NIL;
    END
    MUTABLE name = (UNWRAP (params.first())).name;
    MUTABLE zig_name: String = "";
    IF mutable_scalar_params.contains?(name) THEN
      zig_name = "_m_${name}";
    ELSE
      zig_name = name;
    END
    RETURN "@TypeOf(${zig_name})";
}
END
PRIVATE FN mIRLowering__compose_capability_wrap(self: MIRLowering, inner_mir: Emittable, bare_zig_t: String, ft: Type, alloc: String@symbol) RETURNS Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE is_atomic_ptr = type__atomic_ptr?(ft);
    MUTABLE sync_fn: ?String = mIRLowering__sync_wrap_constructor(rtoc_self_view, type__sync(ft), is_atomic_ptr);
    MUTABLE sync_t: ?String = mIRLowering__sync_wrap_type(rtoc_self_view, type__sync(ft), bare_zig_t, is_atomic_ptr);
    MUTABLE own_fn = PARTIAL MATCH type__ownership(ft) START
      :shared -> (IF type__atomic?(ft) THEN
          NIL
        ELSE
          "arcCreate"
        END),
      :multiowned -> (IF type__atomic?(ft) THEN
          NIL
        ELSE
          "rcCreate"
        END),
      DEFAULT -> NIL
    END;
    IF ((sync_fn != NIL) AND own_fn) THEN
      RETURN Emittable{ CapWrap: COPY CapWrap{ inner: COPY inner_mir, zig_base: COPY bare_zig_t, strategy: :both, sync_fn: COPY sync_fn, sync_type: COPY sync_t, own_fn: COPY own_fn, alloc: COPY alloc, lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE_IF sync_fn THEN
      RETURN Emittable{ CapWrap: COPY CapWrap{ inner: COPY inner_mir, zig_base: COPY bare_zig_t, strategy: :sync_only, sync_fn: COPY sync_fn, sync_type: COPY sync_t, own_fn: NIL, alloc: COPY alloc, lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE_IF own_fn THEN
      RETURN Emittable{ CapWrap: COPY CapWrap{ inner: COPY inner_mir, zig_base: COPY bare_zig_t, strategy: :own_only, sync_fn: NIL, sync_type: NIL, own_fn: COPY own_fn, alloc: COPY alloc, lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE
      RETURN COPY inner_mir;
    END
}
END
PRIVATE FN mIRLowering__lower_var_decl(MUTABLE self: MIRLowering, MUTABLE node: VarDecl) RETURNS !NodeRoot
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE facts = mIRLowering__var_decl_facts(rtoc_self_view, &node);
    IF node.module_const EXISTS AS module_const_value THEN
      MUTABLE module_const_value_mutable = COPY module_const_value;
      RETURN mIRLowering__lower_module_const(&rtoc_self_view, node, facts);
    END
    IF mIRLowering__program_state(rtoc_self_view).module_global_names.contains?(CAST(node.name AS String)) THEN
      RETURN mIRLowering__lower_module_global(&rtoc_self_view, node, facts);
    END
    MUTABLE init = mIRLowering__with_decl_alloc(rtoc_self_view, facts.decl_alloc, %() USE(facts, node, MUTABLE rtoc_self_view) -> mIRLowering__lower_var_decl_init(&rtoc_self_view, node, facts.ft, facts.bare_zig, facts.has_caps, facts.decl_alloc));
    init = mIRLowering__ensure_cleanup_binding_owns_string_init(rtoc_self_view, init, facts, node.value);
    MUTABLE safe_name = mIRLowering__var_decl_safe_name(rtoc_self_view, node, facts.has_mir_drop);
    MUTABLE rtoc_index_receiver_649 = TRY (functionState__binding_types(mIRLowering__function_state(rtoc_self_view)));
    rtoc_index_receiver_649[safe_name] = COPY facts.ft;
    mIRLowering__stamp_var_decl_init_target_mut(rtoc_self_view, init, safe_name, facts.decl_alloc);
    MUTABLE let_node = Let{ name: COPY safe_name, init: COPY init, mutable: facts.keyword_mutable, annotation: COPY facts.annotation, suppression: COPY mIRLowering__var_decl_suppression(rtoc_self_view, safe_name, node, facts, init), alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL };
    MUTABLE init_effect = ownershipEffect__of(init);
    IF mIRLowering__var_decl_source_transfer_required?(rtoc_self_view, node, facts, init_effect) THEN
      let_node = castEmittableToLet(TRY (mIRLowering__with_ownership_consumption_for_value(rtoc_self_view, Emittable{ Let: COPY let_node }, init, node.value, "var init", :owned_sink, facts.decl_alloc)));
    END
    MUTABLE nodes = TRY (materializationPacket__statements(mIRLowering__var_decl_materialization_plan(rtoc_self_view, node, facts, safe_name, init, let_node)));
    FOR _ IN nodes DO
    IF _ IS_A AllocMark THEN
      mIRLowering__function_state(rtoc_self_view).lowered_alloc_names.insert(COPY CAST(_.name() AS String));
    END
    END
    IF (TRY (type__node_reference?(facts.ft)) AND (!(nodes |> ANY _ IS_A AllocMark))) THEN
      &nodes.unshift(AllocMark{ name: COPY safe_name, alloc: :heap, type_info: COPY facts.ft, scope: :heap, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
      &nodes.append(Stmt{ Emittable: COPY CAST(Cleanup{ name: safe_name, cleanup_entry: cleanupEntry__build(:uniform, :heap, FALSE), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) });
    END
    MUTABLE owner_marks = mIRLowering__field_owner_move_marks(rtoc_self_view, node);
    nodes = ruby_array_concat_Stmt(nodes, owner_marks);
    IF (nodes.length() == 1) THEN
      RETURN COPY castStmtToNodeRoot(UNWRAP (nodes.first()));
    ELSE
      RETURN NodeRoot{ ArrayValue: nodes |> SELECT castStmtToEmittable(_) };
    END
}
END
PRIVATE FN mIRLowering__lower_module_const(MUTABLE self: MIRLowering, node: VarDecl, facts: VarDeclFacts) RETURNS !NodeRoot
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF mIRLowering__const_init_error_fallible?(rtoc_self_view, node) THEN
      RAISE Input, CompilerError, "{}error channel. Make the initializer infallible, or compute the value inside a function.";
    END
    MUTABLE safe_name = mIRLowering__var_decl_safe_name(rtoc_self_view, node, FALSE);
    MUTABLE rtoc_index_receiver_650 = TRY (functionState__binding_types(mIRLowering__function_state(rtoc_self_view)));
