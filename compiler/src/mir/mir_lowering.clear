PRIVATE FN mIRLowering__managed_handle_materialized_for_plain_takes?(MUTABLE self: MIRLowering, ast_arg: Locatable, contract: ?CallableContract, idx: Int64) RETURNS !Bool ->
    IF contract EXISTS AS contract_value THEN
