    ELSE
      rtoc_ternary_value_182 = TRY (type__from_node_mut(ast_node, "owned sink materialization"));
    END
    rtoc_ternary_value_182? };
    MUTABLE dst_ti = IF sink_type != NIL THEN
      ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_184: ?TypeTypeInput = NIL;
    IF sink_type IS_A Type THEN
      rtoc_ternary_value_184 = sink_type;
    ELSE
      rtoc_ternary_value_184 = TRY (type__new(castTypeTypeInputToTypeConstructionInput(sink_type)));
    END
    rtoc_ternary_value_184? })
    ELSE
      ti
    END;
