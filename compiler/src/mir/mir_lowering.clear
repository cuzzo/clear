PRIVATE FN mIRLowering__binary_int_arithmetic_facts(self: MIRLowering, node: BinaryOp) RETURNS BinaryIntArithmeticFacts
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE left_ti = &node.left.full_type_mut("binary left operand");
    MUTABLE right_ti = &node.right.full_type_mut("binary right operand");
    RETURN BinaryIntArithmeticFacts{ both_int: (((left_ti != NIL) AND (type__integer?(left_ti) == TRUE)) AND ((right_ti != NIL) AND (type__integer?(right_ti) == TRUE))), has_comptime_number_literal: (mIRLowering__comptime_number_literal?(rtoc_self_view, node.left, left_ti) OR mIRLowering__comptime_number_literal?(rtoc_self_view, node.right, right_ti)), has_float_coercion: (mIRLowering__float_coercion?(rtoc_self_view, node.left) OR mIRLowering__float_coercion?(rtoc_self_view, node.right)) };
}
END
PRIVATE FN mIRLowering__comptime_number_literal?(self: MIRLowering, node: Locatable, ti: ?Type) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A Literal AS literal THEN
      IF !((literal.type == :NUMBER)) THEN
        RETURN FALSE;
      END
      RETURN ((ti == NIL) OR !(type__integer?((ti?))));
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN mIRLowering__float_coercion?(self: MIRLowering, node: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE coerced = node.coerced_type_info();
    IF (coerced == NIL) THEN
      RETURN FALSE;
    END
    RETURN (type__integer?(coerced) != TRUE);
}
END
PRIVATE FN mIRLowering__lower_get_index(MUTABLE self: MIRLowering, MUTABLE node: GetIndex) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (node.protocol_operation == :map_get) THEN
      MUTABLE receiver: Emittable = CAST(TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(node.target))) AS Emittable);
      IF !(mIRLowering__collection_param_receiver?(rtoc_self_view, node.target)) THEN
        receiver = Emittable{ AddressOf: COPY AddressOf{ expr: COPY receiver, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
      RETURN Emittable{ ProtocolCall: COPY ProtocolCall{ protocol: :Map, operation: :get, receiver: COPY receiver, args: [CAST(TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(node.index))) AS Emittable)], lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    MUTABLE plan = mIRLowering__index_access_plan(&rtoc_self_view, node);
    MUTABLE value = mIRLowering__index_access_value(rtoc_self_view, plan);
    IF indexAccessPlan__optional?(plan) THEN
      MUTABLE result_type = &node.full_type_mut("safe-navigation index result");
      IF !(type__optional?(result_type)) THEN
        result_type = TRY (type__optional_of(TypeTypeInput{ Type: COPY result_type }));
      END
      MUTABLE result = IfOptional{ optional: COPY UNWRAP (plan.optional_source), capture: "_r", then_expr: COPY value, else_expr: COPY TRY (mIRLowering__optional_nil_mir(rtoc_self_view, result_type)), lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
      result.result_type = result_type;
      RETURN Emittable{ IfOptional: COPY result };
    END
    RETURN value;
}
END
PRIVATE FN mIRLowering__index_access_plan(MUTABLE self: MIRLowering, node: GetIndex) RETURNS !IndexAccessPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE target_node = COPY node.target;
    MUTABLE target_ast: Locatable = target_node;
    MUTABLE implicit_safe_nav = (respondsTo?(target_node, "safe_nav_chain") AND (target_node.safe_nav_chain() == TRUE));
    MUTABLE explicit_safe_nav = (target_node IS_A OptionalUnwrap AND target_node.safe_navigation?());
    MUTABLE optional = (explicit_safe_nav OR implicit_safe_nav);
    MUTABLE source_ast_branch_value: ?Locatable = NIL;
    IF explicit_safe_nav THEN
      source_ast_branch_value = target_node.target();
    ELSE
      source_ast_branch_value = target_node;
    END
    MUTABLE source_ast: Locatable = source_ast_branch_value?;
    MUTABLE optional_source_branch_value: ?Emittable = NIL;
    IF optional THEN
      optional_source_branch_value = CAST(TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(source_ast))) AS Emittable);
    ELSE
      optional_source_branch_value = NIL;
    END
    MUTABLE optional_source: ?Emittable = optional_source_branch_value;
    MUTABLE target_branch_value: ?Ident = NIL;
    IF optional THEN
      target_branch_value = Ident{ name: "_r", lowered_node_id: NIL, ownership_consumption: NIL };
    ELSE
      target_branch_value = castEmittableToIdent(CAST(TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(target_node))) AS Emittable));
    END
    MUTABLE target: Ident = target_branch_value?;
    MUTABLE target_type = TRY (type__from_node_mut(target_node, "index target"));
    IF implicit_safe_nav THEN
      target_type = UNWRAP (TRY (type__wrapped_type(target_type)));
    END
    MUTABLE rank_indices: []Emittable = List[];
    IF type__rank?(target_type) THEN
      MUTABLE index_nodes: []Locatable = List[];
      IF node.index IS_A TupleLit THEN
        index_nodes = node.index.items();
      ELSE
        index_nodes = [node.index];
      END
      rank_indices = index_nodes |> SELECT CAST(TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(_))) AS Emittable);
    ELSE
      rank_indices = List[];
    END
    RETURN IndexAccessPlan{ target: Emittable{ Ident: COPY target }, index: COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_571: ?Emittable = NIL;
    IF rank_indices THEN
      rtoc_ternary_value_571 = UNWRAP (rank_indices.first());
    ELSE
      rtoc_ternary_value_571 = CAST(TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(node.index))) AS Emittable);
    END
    rtoc_ternary_value_571? }, optional: optional, optional_source: COPY optional_source, target_ast: COPY target_ast, type_info: COPY target_type, target_name: COPY IF target_node IS_A Identifier THEN
      target_node.name()
    ELSE
      NIL
    END, needs_mut_ref: (node.needs_mut_ref == TRUE), rank_indices: COPY rank_indices };
}
END
PRIVATE FN mIRLowering__index_access_value(self: MIRLowering, plan: IndexAccessPlan) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE shard: ?{String@symbol}String = TRY (mIRLowering__shard_context(rtoc_self_view));
    MUTABLE target = COPY plan.target;
    MUTABLE index = COPY plan.index;
    MUTABLE ti = COPY plan.type_info;
    IF type__rank?(ti) THEN
      RETURN Emittable{ RuntimeCall: COPY mIRLowering__rank_index_value(rtoc_self_view, target, ti, UNWRAP (plan.rank_indices)) };
    END
    IF (TRY (type__any_rc?(ti)) AND !(mIRLowering__bc_target?(rtoc_self_view))) THEN
      target = Emittable{ Deref: COPY Deref{ expr: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ FieldGet: COPY FieldGet{ object: COPY target, field: "ctrl", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "data", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF indexAccessPlan__optional?(plan) THEN
      RETURN mIRLowering__index_collection_value(rtoc_self_view, target, index, plan);
    END
    IF (plan.target_ast.metatype() == :hashmap) THEN
      MUTABLE map_ft = TRY (type__from_node_mut(plan.target_ast, "hashmap index target"));
      MUTABLE kind = IF TRY (type__numeric_map?(map_ft)) THEN
        :numeric_map
      ELSE
