      ELSE
        source_guard_branch_value = NIL;
      END
    MUTABLE source_guard: DeferStmt = source_guard_branch_value?;
    MUTABLE source_shape = TRY (asyncResultShape__promise(source_result_type, (operation.handle_use == TenseHandleUse.SharedRead)));
