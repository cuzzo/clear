PRIVATE FN mIRLowering__struct_lit_field_types(self: MIRLowering, node: StructLit) RETURNS !{String}?StructLitFieldType
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE schema: ?MIRLoweringSchemasSchemaLookupResult = mIRLowering__mir_schema_lookup(rtoc_self_view)(symbol(node.name));
    IF schema IS_A UnionSchema@multiowned AS union_schema_multiowned THEN
      MUTABLE union_schema_multiowned_mutable = COPY union_schema_multiowned;
      MUTABLE union_subst: {String@symbol}TypeTypeInput = {};
      RETURN union_schema_multiowned_mutable.variants.each_with_object({}, %(tuple_param_0, h) USE(union_subst, rtoc_self_view) -> {
    MUTABLE k = tuple_param_0._0;
    MUTABLE t = tuple_param_0._1;
    h[CAST(k AS String)] = mIRLowering__substitute_mir_type(rtoc_self_view, t, union_subst);
    NIL
      });
    ELSE_IF schema IS_A StructSchema@multiowned AS struct_schema_multiowned THEN
      MUTABLE struct_schema_multiowned_mutable = COPY struct_schema_multiowned;
      MUTABLE struct_subst = mIRLowering__struct_lit_type_subst(rtoc_self_view, Schema{ StructSchemaMultiowned: COPY struct_schema_multiowned_mutable }, node);
      RETURN struct_schema_multiowned_mutable.fields.each_with_object({}, %(tuple_param_0, h) USE(struct_subst, rtoc_self_view) -> {
    MUTABLE k = tuple_param_0._0;
    MUTABLE f = tuple_param_0._1;
    MUTABLE raw = IF f IS_A StructField THEN
          f.type()
        ELSE
          f
        END;
    h[CAST(k AS String)] = mIRLowering__substitute_mir_type(rtoc_self_view, raw, struct_subst);
    NIL
      });
    ELSE
      RETURN {};
    END
}
END
PRIVATE FN mIRLowering__struct_lit_type_subst(self: MIRLowering, schema: Schema, node: StructLit) RETURNS !{String@symbol}TypeTypeInput
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE params: []Any = List[];
    IF schema IS_A StructSchema AS struct_schema THEN
      params = struct_schema.type_params;
    ELSE
      params = ( { MUTABLE rtoc_empty_list_573: []Any = List[]; rtoc_empty_list_573 } );
    END
    MUTABLE args = (node.type_args OR_ELSE List[]);
    IF !(((params |> ANY _) AND args.any?())) THEN
      RETURN {};
    END
    MUTABLE out: {String@symbol}TypeTypeInput = {};
    FOR rtoc_key IN params.zip(args).keys() DO
    MUTABLE arg: Any = COPY UNWRAP (params.zip(args)[rtoc_key]);
    IF !(rtoc_key) THEN
      CONTINUE;
    END
    out[type__to_sym(rtoc_key)] = arg;
    END
    RETURN out;
}
END
PRIVATE FN mIRLowering__substitute_mir_type(self: MIRLowering, raw_type: ?StructLitFieldType, subst: {String@symbol}TypeTypeInput) RETURNS !?StructLitFieldType
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (subst.count() == 0) THEN
      RETURN COPY raw_type;
    END
    IF raw_type EXISTS AS raw_type_value THEN
      IF raw_type_value IS_A InlineStructVariant AS inline_struct_variant THEN
        RETURN COPY StructLitFieldType{ InlineStructVariantMultiowned: COPY inline_struct_variant };
      END
      MUTABLE type_input = COPY raw_type_value;
      MUTABLE t = TRY (type__new(castStructLitFieldTypeToTypeConstructionInput(type_input)));
      MUTABLE resolved = type__resolved(t);
      IF subst.contains?(resolved) THEN
        MUTABLE replacement = TRY (type__new(castTypeTypeInputToTypeConstructionInput(subst[resolved]?)));
        mIRLowering__copy_type_capabilities(rtoc_self_view, t, &replacement);
        RETURN StructLitFieldType{ TypeMultiowned: COPY replacement };
      END
      IF type__projection?(t) THEN
        MUTABLE owner = symbol(UNWRAP (type__projection_owner(t)));
        MUTABLE concrete_input: ?TypeTypeInput = COPY subst[owner];
        IF concrete_input EXISTS AS concrete_input_value THEN
          MUTABLE concrete = TRY (type__new(castTypeTypeInputToTypeConstructionInput(concrete_input_value)));
          MUTABLE projected_branch_value: ?Type = NIL;
          PARTIAL MATCH type__projection_member(t) START
            :Key ->
            IF type__map?(concrete) THEN
              projected_branch_value = TRY (type__key_type(concrete));
            ELSE
              projected_branch_value = NIL;
            END,
            :Value ->
            IF type__map?(concrete) THEN
              projected_branch_value = TRY (type__value_type(concrete));
            ELSE
              projected_branch_value = NIL;
            END,
            DEFAULT ->
            projected_branch_value = NIL;
          END
          MUTABLE projected: Type = projected_branch_value?;
          IF projected THEN
            RETURN StructLitFieldType{ TypeMultiowned: COPY projected };
          END
          RETURN StructLitFieldType{ TypeMultiowned: COPY TRY (type__new(TypeConstructionInput{ TypeExpression: COPY typeExpression__of(TypeProjectionExpression{ owner: COPY type__resolved(concrete), member: COPY symbol(UNWRAP (type__projection_member(t))), protocol: COPY type__projection_protocol(t) }) })) };
        ELSE
          RETURN COPY raw_type_value;
        END
      END
      IF type__map?(t) THEN
        MUTABLE wrapper = COPY t.shape.expression;
        MUTABLE expression: MapTypeExpression = COPY CAST(wrapper.kind AS MapTypeExpression);
        MUTABLE new_key: TypeTypeInput = castOptionalStructLitFieldTypeToTypeTypeInput(mIRLowering__substitute_mir_type(rtoc_self_view, StructLitFieldType{ TypeMultiowned: COPY TRY (type__key_type(t)) }, subst));
        MUTABLE new_value: TypeTypeInput = castOptionalStructLitFieldTypeToTypeTypeInput(mIRLowering__substitute_mir_type(rtoc_self_view, StructLitFieldType{ TypeMultiowned: COPY TRY (type__value_type(t)) }, subst));
        RETURN StructLitFieldType{ TypeMultiowned: COPY TRY (type__new(TypeConstructionInput{ TypeExpression: COPY TypeExpression{ kind: COPY MapTypeExpression{ key: COPY ((TRY (type__new(castTypeTypeInputToTypeConstructionInput(new_key)))).shape).expression, value: COPY ((TRY (type__new(castTypeTypeInputToTypeConstructionInput(new_value)))).shape).expression, key_implicit: expression.key_implicit, legacy_separator: COPY expression.legacy_separator }, capabilities: COPY wrapper.capabilities } })) };
      END
      IF type__generic_instance?(t) THEN
        MUTABLE new_args = (TRY (type__generic_args(t))) |> SELECT castOptionalStructLitFieldTypeToTypeTypeInput(mIRLowering__substitute_mir_type(rtoc_self_view, StructLitFieldType{ TypeMultiowned: COPY _ }, subst));
        MUTABLE replacement = TRY (type__generic_instance_of(type__generic_base(t), new_args));
        mIRLowering__copy_type_capabilities(rtoc_self_view, t, &replacement);
        RETURN StructLitFieldType{ TypeMultiowned: COPY replacement };
      END
      IF type__array?(t) THEN
        MUTABLE element_type = UNWRAP (TRY (type__element_type(t)));
        MUTABLE new_element: TypeTypeInput = castOptionalStructLitFieldTypeToTypeTypeInput(mIRLowering__substitute_mir_type(rtoc_self_view, StructLitFieldType{ TypeMultiowned: COPY element_type }, subst));
        IF (TRY (type__surface_name(TypeTypeInput{ Type: COPY element_type })) == TRY (type__surface_name(new_element))) THEN
          RETURN COPY raw_type_value;
        END
        MUTABLE replacement = TRY (type__array_of(new_element, type__capacity(t)));
        mIRLowering__copy_type_capabilities(rtoc_self_view, t, &replacement);
        RETURN StructLitFieldType{ TypeMultiowned: COPY replacement };
      END
      IF type__error_union?(t) THEN
        MUTABLE payload_type = UNWRAP (TRY (type__payload_type(t)));
        MUTABLE new_payload: TypeTypeInput = castOptionalStructLitFieldTypeToTypeTypeInput(mIRLowering__substitute_mir_type(rtoc_self_view, StructLitFieldType{ TypeMultiowned: COPY payload_type }, subst));
        IF (TRY (type__surface_name(TypeTypeInput{ Type: COPY payload_type })) == TRY (type__surface_name(new_payload))) THEN
          RETURN COPY raw_type_value;
        END
        MUTABLE replacement = TRY (type__error_union_of(new_payload));
        mIRLowering__copy_type_capabilities(rtoc_self_view, t, &replacement);
        RETURN StructLitFieldType{ TypeMultiowned: COPY replacement };
      END
      IF type__optional?(t) THEN
        MUTABLE wrapped_type = UNWRAP (TRY (type__wrapped_type(t)));
        MUTABLE new_wrapped: TypeTypeInput = castOptionalStructLitFieldTypeToTypeTypeInput(mIRLowering__substitute_mir_type(rtoc_self_view, StructLitFieldType{ TypeMultiowned: COPY wrapped_type }, subst));
        IF (TRY (type__surface_name(TypeTypeInput{ Type: COPY wrapped_type })) == TRY (type__surface_name(new_wrapped))) THEN
          RETURN COPY raw_type_value;
        END
        MUTABLE replacement = TRY (type__optional_of(new_wrapped));
        mIRLowering__copy_type_capabilities(rtoc_self_view, t, &replacement);
        RETURN StructLitFieldType{ TypeMultiowned: COPY replacement };
      END
      IF type__tense?(t) THEN
        MUTABLE tense_type = TRY (type__tense_type(t));
        MUTABLE new_tense_type: TypeTypeInput = castOptionalStructLitFieldTypeToTypeTypeInput(mIRLowering__substitute_mir_type(rtoc_self_view, StructLitFieldType{ TypeMultiowned: COPY tense_type }, subst));
        IF (TRY (type__surface_name(TypeTypeInput{ Type: COPY tense_type })) == TRY (type__surface_name(new_tense_type))) THEN
          RETURN COPY raw_type_value;
        END
        MUTABLE replacement = TRY (type__tense_of(new_tense_type));
        mIRLowering__copy_type_capabilities(rtoc_self_view, t, &replacement);
        RETURN StructLitFieldType{ TypeMultiowned: COPY replacement };
      END
      RETURN COPY raw_type_value;
    ELSE
      RETURN COPY raw_type;
    END
}
END
PRIVATE FN mIRLowering__copy_type_capabilities(self: MIRLowering, source: Type, MUTABLE target: Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    TRY (type__merge_capabilities_from_mut(&target, source));
}
END
PRIVATE FN mIRLowering__struct_field_wants_slice?(self: MIRLowering, ft: ?Type, k: K, node: StructLit) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (IF node.borrowed_field_names != NIL THEN
      node.borrowed_field_names.contains?(CAST(k AS String))
    ELSE
      NIL
    END) THEN
      RETURN TRUE;
    END
    RETURN mIRLowering__aggregate_field_wants_dynamic_slice?(rtoc_self_view, ft);
}
END
PRIVATE FN mIRLowering__aggregate_field_wants_dynamic_slice?(self: MIRLowering, ft: ?Type) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF ft EXISTS AS ft_value THEN
      RETURN (((type__array?(ft_value) AND type__dynamic?(ft_value)) AND !(type__collection?(ft_value))) AND !(TRY (type__string?(ft_value))));
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN mIRLowering__aggregate_dynamic_slice_field_value(self: MIRLowering, val: Emittable, ft: ?Type, borrowed_field: Bool, sink_alloc: String@symbol, ast_node: ?Locatable = NIL) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(mIRLowering__aggregate_field_wants_dynamic_slice?(rtoc_self_view, ft)) THEN
      RETURN COPY val;
    END
    IF borrowed_field THEN
      RETURN Emittable{ ItemsAccess: COPY ItemsAccess{ expr: COPY val, safe: TRUE, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    MUTABLE source_branch_value: ?Emittable = NIL;
    IF (mIRLowering__mir_produces_owned_result?(rtoc_self_view, val) AND !(val IS_A Ident)) THEN
      source_branch_value = mIRLowering__hoist_alloc(rtoc_self_view, val, ast_node, TRUE);
    ELSE
      source_branch_value = COPY val;
    END
    MUTABLE source: Emittable = source_branch_value?;
    RETURN Emittable{ OwnedSlice: COPY castEmittableToOwnedSlice(TRY (mIRLowering__with_ownership_consumption(rtoc_self_view, Emittable{ OwnedSlice: COPY OwnedSlice{ expr: COPY source, alloc: COPY sink_alloc, lowered_node_id: NIL, ownership_consumption: NIL } }, mIRLowering__mir_ident_names(rtoc_self_view, source), "MIR::OwnedSlice", :owned_sink, sink_alloc))) };
}
END
PRIVATE FN mIRLowering__lower_struct_lit(MUTABLE self: MIRLowering, node: StructLit) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
