PRIVATE FN mIRLowering__lower_runtime_is_a_if(MUTABLE self: MIRLowering, node: IfStatement, MUTABLE condition: IsA) RETURNS !Emittable ->
    MUTABLE else_body: ?[]Emittable = NIL;
