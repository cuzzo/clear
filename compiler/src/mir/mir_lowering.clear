PRIVATE FN mIRLowering__fsm_result_transfer_facts(self: MIRLowering, result_mir: Emittable, ast_node: Locatable, destination_type: ?Type = NIL) RETURNS ![]FsmResultTransferFact
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rename_map = mIRLowering__fsm_fn_name_rename_map(rtoc_self_view);
    MUTABLE bindings = mIRLowering__fsm_current_bindings(rtoc_self_view);
    MUTABLE guarded_cleanup_names = mIRLowering__fsm_guarded_cleanup_names(rtoc_self_view);
    MUTABLE facts: []FsmResultTransferFact = ( { MUTABLE rtoc_empty_list_198: []FsmResultTransferFact = List[]; rtoc_empty_list_198 } );
    MUTABLE result_owner: Emittable = COPY result_mir;
    WHILE TRUE DO
      IF result_owner IS_A TryExpr AS try_expr THEN
        MUTABLE try_expr = tryExpr__expr(try_expr);
      ELSE_IF result_owner IS_A TryOptional AS try_optional THEN
        MUTABLE try_optional = tryOptional__expr(try_optional);
      ELSE_IF result_owner IS_A MIRCast AS mir_cast THEN
        MUTABLE mir_cast = cast__expr(mir_cast);
      ELSE
        BREAK;
      END
    END
    MUTABLE result_type = (destination_type OR_ELSE TRY (type__from_node_mut(ast_node, "FSM result owner")));
    IF (IF result_owner IS_A Ident AS ident THEN mIRLowering__ownership_tracked_transfer_type?(rtoc_self_view, result_type) ELSE FALSE END) THEN
      MUTABLE owner_name = COPY CAST(result_owner.name() AS String);
      owner_name = COPY (rename_map[owner_name] OR_ELSE owner_name);
      MUTABLE mir_entry = ((IF bindings[CAST(result_owner.name() AS String)] != NIL THEN bindings[CAST(result_owner.name() AS String)] ELSE bindings[owner_name] END) OR_ELSE new());
      IF cleanupEntry__present?(mir_entry) THEN
        cleanupEntry__mark_moved_guard_mut(&mir_entry);
        guarded_cleanup_names[owner_name] = TRUE;
      END
      &facts.append(FsmResultTransferFact{ name: COPY owner_name, target_alloc: COPY IF cleanupEntry__present?(mir_entry) THEN
        mir_entry.alloc()
      ELSE
        :heap
      END, move_guarded: TRUE });
      RETURN facts;
    END
    MUTABLE consumed = mIRLowering__fsm_ast_result_consumed_roots(rtoc_self_view, castLocatableToOptionalFsmAstResultNode(ast_node));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < consumed.length() DO
      MUTABLE safe = mIRLowering__fsm_zig_safe_name(rtoc_self_view, consumed[rtoc_idx]?);
      safe = COPY (rename_map[safe] OR_ELSE safe);
      MUTABLE binding_entry = ((IF bindings[consumed[rtoc_idx]?] != NIL THEN bindings[consumed[rtoc_idx]?] ELSE bindings[safe] END) OR_ELSE new());
      IF !(cleanupEntry__present?(binding_entry)) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE guarded = (cleanupEntry__has_moved_guard?(binding_entry) OR (guarded_cleanup_names[safe] == TRUE));
      &facts.append(FsmResultTransferFact{ name: COPY safe, target_alloc: COPY binding_entry.alloc(), move_guarded: guarded });
    rtoc_idx = rtoc_idx + 1;
    END
    MUTABLE rtoc_each_items_199 = (TRY (mIR__nodes(NodeRoot{ Emittable: COPY result_mir }))).grep(MIR.Ident);
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_199.length() DO
      MUTABLE name = COPY CAST(rtoc_each_items_199[rtoc_idx].name() AS String);
      MUTABLE safe = COPY (rename_map[name] OR_ELSE name);
      MUTABLE entry = ((IF bindings[name] != NIL THEN bindings[name] ELSE bindings[safe] END) OR_ELSE new());
      MUTABLE guarded = ((guarded_cleanup_names[name] == TRUE) OR (guarded_cleanup_names[safe] == TRUE));
      IF !((guarded OR cleanupEntry__present?(entry))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF facts |> ANY (_.name == safe) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      &facts.append(FsmResultTransferFact{ name: COPY safe, target_alloc: COPY IF cleanupEntry__present?(entry) THEN
          entry.alloc()
        ELSE
          :heap
        END, move_guarded: (guarded OR cleanupEntry__has_moved_guard?(entry)) });
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN facts;
}
END
PRIVATE FN mIRLowering__fsm_ast_result_consumed_roots(self: MIRLowering, MUTABLE node: ?FsmAstResultNode) RETURNS ![]String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE names: []String = ( { MUTABLE rtoc_empty_list_200: []String = List[]; rtoc_empty_list_200 } );
    IF node IS_A MoveNode AS move_node THEN
      IF move_node.value IS_A Identifier THEN
        &names.append(COPY CAST(move_node.value.name() AS String));
      ELSE
        names = ruby_array_concat_String(names, mIRLowering__fsm_ast_result_consumed_roots(rtoc_self_view, move_node.value));
      END
    ELSE_IF node IS_A Identifier AS identifier THEN
      MUTABLE identifier_mutable = COPY identifier;
      IF (aST__moved?(Locatable{ Identifier: COPY identifier_mutable }) OR mIRLowering__fsm_owned_transfer_identifier?(rtoc_self_view, &identifier_mutable)) THEN
        &names.append(COPY identifier__name(identifier_mutable));
      END
    ELSE_IF node IS_A StructLit AS struct_lit THEN
      IF struct_lit.fields != NIL THEN
            FOR _ IN struct_lit.fields.values() DO
          MUTABLE rtoc_mutable_block_param_201 = COPY _;
          IF rtoc_mutable_block_param_201 IS_A CopyNode THEN
            CONTINUE;
          END
          IF rtoc_mutable_block_param_201 IS_A Identifier THEN
                IF mIRLowering__fsm_owned_transfer_identifier?(rtoc_self_view, &rtoc_mutable_block_param_201) THEN
                  &names.append(COPY CAST(rtoc_mutable_block_param_201.name() AS String));
                END
          ELSE
                names = ruby_array_concat_String(names, mIRLowering__fsm_ast_result_consumed_roots(rtoc_self_view, rtoc_mutable_block_param_201));
          END
            END
      END
    ELSE_IF node IS_A UnionVariantLit AS union_variant_lit THEN
      IF union_variant_lit.fields != NIL THEN
            FOR _ IN union_variant_lit.fields.values() DO
          MUTABLE rtoc_mutable_block_param_202 = COPY _;
          IF rtoc_mutable_block_param_202 IS_A CopyNode THEN
            CONTINUE;
          END
          IF rtoc_mutable_block_param_202 IS_A Identifier THEN
                IF mIRLowering__fsm_owned_transfer_identifier?(rtoc_self_view, &rtoc_mutable_block_param_202) THEN
                  &names.append(COPY CAST(rtoc_mutable_block_param_202.name() AS String));
                END
          ELSE
                names = ruby_array_concat_String(names, mIRLowering__fsm_ast_result_consumed_roots(rtoc_self_view, rtoc_mutable_block_param_202));
          END
            END
      END
    ELSE_IF node IS_A ListLit AS list_lit THEN
      IF list_lit.items != NIL THEN
            MUTABLE rtoc_idx = 0;
            WHILE rtoc_idx < list_lit.items.length() DO
            IF list_lit.items[rtoc_idx] IS_A CopyNode THEN
              rtoc_idx = rtoc_idx + 1;
          CONTINUE;
            END
            ruby_array_concat_String(names, mIRLowering__fsm_ast_result_consumed_roots(rtoc_self_view, list_lit.items[rtoc_idx]));
          rtoc_idx = rtoc_idx + 1;
            END
      END
    END
    RETURN dedupeStrings(names);
}
END
PRIVATE FN mIRLowering__fsm_owned_transfer_identifier?(self: MIRLowering, MUTABLE node: Identifier) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rename_map = mIRLowering__fsm_fn_name_rename_map(rtoc_self_view);
    MUTABLE bindings = mIRLowering__fsm_current_bindings(rtoc_self_view);
    MUTABLE ti = &node.full_type_mut("FSM owned transfer identifier");
    IF !(mIRLowering__ownership_tracked_transfer_type?(rtoc_self_view, ti)) THEN
      RETURN FALSE;
    END
    MUTABLE safe = mIRLowering__fsm_zig_safe_name(rtoc_self_view, node.name);
    safe = COPY (rename_map[safe] OR_ELSE safe);
    MUTABLE entry = ((IF bindings[node.name] != NIL THEN bindings[node.name] ELSE bindings[safe] END) OR_ELSE new());
    RETURN (((cleanupEntry__present?(entry) AND entry.heap?())) OR ((node.symbol != NIL) AND ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_203 = ((node.symbol)?);
    symbolEntry__heap_storage?(rtoc_local_receiver_203) } == TRUE)));
}
END
PRIVATE FN mIRLowering__lower_one_step_to_mir(MUTABLE self: MIRLowering, step: ThenStep) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE mir = TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(step.expr)));
    IF (mir == NIL) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_204: []Emittable = List[]; rtoc_empty_list_204 } ) AS []Emittable);
    END
    MUTABLE pending = mIRLowering__flush_pending(rtoc_self_view);
    IF mir IS_A []@multiowned Any THEN
      RETURN TRY (mIRLowering__guard_shared_node_statement(rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(step.expr), (pending + (mir |> WHERE _ != NIL))));
    END
    IF !(mir IS_A Emittable) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_205: []Emittable = List[]; rtoc_empty_list_205 } ) AS []Emittable);
    END
    MUTABLE main: ?Emittable = mIRLowering__wrap_step_as_stmt(rtoc_self_view, step, mir);
    IF main EXISTS AS main_value THEN
      RETURN TRY (mIRLowering__guard_shared_node_statement(rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(step.expr), (pending + [main_value])));
    ELSE
      RETURN pending;
    END
}
END
PRIVATE FN mIRLowering__wrap_step_as_stmt(self: MIRLowering, step: ThenStep, mir: Emittable) RETURNS !?Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE binding: ?String = COPY step.binding;
    IF binding EXISTS AS binding_value THEN
      RETURN Emittable{ Let: COPY Let{ name: COPY binding_value, init: COPY mir, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } };
    END
    IF mir.stmt?() THEN
      RETURN COPY mir;
    END
    MUTABLE expr_type = &step.expr.full_type_mut();
    MUTABLE is_void_step = TRY (mIRLowering__ast_void_type?(rtoc_self_view, expr_type));
    RETURN Emittable{ ExprStmt: COPY ExprStmt{ expr: COPY mir, discard: !(is_void_step), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
}
END
PUB FN mIRLowering__lower_finalized_fsm_step_mir(MUTABLE self: MIRLowering, stmts: []Locatable, no_result: Bool, ctx_id: ?Int64 = NIL, async_result_shape: ?AsyncResultShape = NIL) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_writer_receiver_207: MIRLoweringCaptureState = mIRLowering__capture_state(rtoc_self_view);
    rtoc_writer_receiver_207.last_fsm_result_transfer_facts = ( { MUTABLE rtoc_empty_list_206: []FsmResultTransferFact = List[]; rtoc_empty_list_206 } );
    MUTABLE result = mIRLowering__lower_step_stmts(&rtoc_self_view, stmts, no_result, ctx_id, async_result_shape);
    MUTABLE inherited_allocs = COPY mIRLowering__capture_state(rtoc_self_view).current_fsm_inherited_alloc_names;
    MUTABLE inherited_guards = COPY mIRLowering__capture_state(rtoc_self_view).current_fsm_inherited_guarded_names;
    RETURN TRY (mIRLowering__append_ownership_transfers_for_mir_body(rtoc_self_view, result, inherited_allocs, inherited_guards));
}
END
PUB FN mIRLowering__last_fsm_result_transfer_facts(self: MIRLowering) RETURNS ![]FsmResultTransferFact
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY mIRLowering__capture_state(rtoc_self_view).last_fsm_result_transfer_facts;
}
END
PRIVATE FN mIRLowering__with_fsm_segment_lowering_context<Result>(self: MIRLowering, pointer_captures: [Set]String, inherited_alloc_names: [Set]String, inherited_guard_names: [Set]String, owned_result_guards: {String}String, blk: FN() -> Result) RETURNS Result
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE prev_result_guards = COPY mIRLowering__capture_state(rtoc_self_view).current_fsm_owned_result_guards;
    MUTABLE prev_alloc_names = COPY mIRLowering__capture_state(rtoc_self_view).current_fsm_inherited_alloc_names;
    MUTABLE prev_guard_names = COPY mIRLowering__capture_state(rtoc_self_view).current_fsm_inherited_guarded_names;
    DEFER {
    MUTABLE rtoc_writer_receiver_208: MIRLoweringCaptureState = mIRLowering__capture_state(rtoc_self_view);
    rtoc_writer_receiver_208.current_fsm_owned_result_guards = prev_result_guards;
    MUTABLE rtoc_writer_receiver_209: MIRLoweringCaptureState = mIRLowering__capture_state(rtoc_self_view);
    rtoc_writer_receiver_209.current_fsm_inherited_guarded_names = prev_guard_names;
    MUTABLE rtoc_writer_receiver_210: MIRLoweringCaptureState = mIRLowering__capture_state(rtoc_self_view);
    rtoc_writer_receiver_210.current_fsm_inherited_alloc_names = prev_alloc_names;
    }
    MUTABLE rtoc_writer_receiver_211: MIRLoweringCaptureState = mIRLowering__capture_state(rtoc_self_view);
    rtoc_writer_receiver_211.current_fsm_inherited_alloc_names = COPY inherited_alloc_names;
    MUTABLE rtoc_writer_receiver_212: MIRLoweringCaptureState = mIRLowering__capture_state(rtoc_self_view);
    rtoc_writer_receiver_212.current_fsm_inherited_guarded_names = COPY inherited_guard_names;
    MUTABLE rtoc_writer_receiver_213: MIRLoweringCaptureState = mIRLowering__capture_state(rtoc_self_view);
    rtoc_writer_receiver_213.current_fsm_owned_result_guards = COPY owned_result_guards;
    RETURN mIRLowering__with_bg_fiber_body_context(rtoc_self_view, pointer_captures, blk);
}
END
PUB FN mIRLowering__fsm_cap_metadata(self: MIRLowering, cap: CapabilityTransition, with_node: WithBlock, ctx_id: Int64, captured: {String}Type@multiowned) RETURNS !?{String@symbol}FsmCapMetadataValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(((cap.capability == symbol("EXCLUSIVE")) OR (cap.capability == :write_locked_read))) THEN
      RETURN NIL;
    END
    MUTABLE var_node = COPY cap.var_node;
    IF var_node IS_A Identifier AS identifier THEN
      MUTABLE lock_var_name = identifier__name(identifier);
      MUTABLE alias_name = COPY cap.alias_name;
      IF !(captured.contains?(lock_var_name)) THEN
        RETURN NIL;
      END
      MUTABLE resolved = COPY cap.resolved_type;
      MUTABLE any_rc: ?Bool = TRY (type__any_rc?(resolved));
      MUTABLE write_locked: ?Bool = type__write_locked?(resolved);
      MUTABLE is_param: ?Bool = (IF identifier.symbol != NIL THEN
        symbolEntry__is_param(identifier.symbol)
      ELSE
        NIL
      END);
      MUTABLE polymorphic_locked = (((is_param != NIL) AND !(any_rc)) AND ((!(!(type__locked?(resolved))) OR !(!(type__write_locked?(resolved))))));
      MUTABLE lock_kind =     IF (cap.capability == :write_locked_read) THEN
        :rwlock_read
      ELSE_IF write_locked THEN
        :rwlock_write
      ELSE
        :mutex_excl
      END;
      MUTABLE base_field = "__ctx_${ctx_id.toString()}.${lock_var_name}";
      MUTABLE lock_field_ref: String = "";
      IF any_rc EXISTS AS any_rc_value THEN
        lock_field_ref = "${base_field}.ctrl.data.*";
      ELSE
        IF polymorphic_locked THEN
          lock_field_ref = "(if (comptime @hasDecl(@TypeOf(${base_field}), \"__clear_ref_carrier\")) ${base_field}.ctrl.data.* else ${base_field})";
        ELSE
          lock_field_ref = base_field;
        END
      END
      MUTABLE alias_data_ref = "(${lock_field_ref}.data)";
      MUTABLE try_method, unlock_method = PARTIAL MATCH lock_kind START
        :rwlock_write -> ["tryWriteLockForFsm", "unlock"],
        :rwlock_read -> ["tryReadLockForFsm", "unlockShared"],
        DEFAULT -> ["tryLockForFsm", "unlock"]
      END;
      MUTABLE retries: Int64 = 0;
      IF with_node.lock_error_clause != NIL THEN
        retries = ((with_node.lock_error_clause)?).retries();
      END
      RETURN CAST({:cap: FsmCapMetadataValue{ CapabilityTransition: COPY cap }, :lock_kind: FsmCapMetadataValue{ SymbolValue: COPY lock_kind }, :try_method: try_method, :unlock_method: unlock_method, :lock_field_ref: FsmCapMetadataValue{ StringValue: COPY lock_field_ref }, :alias_name: FsmCapMetadataValue{ StringValue: COPY alias_name }, :alias_data_ref: FsmCapMetadataValue{ StringValue: COPY alias_data_ref }, :retries: FsmCapMetadataValue{ Int64Value: retries }} AS ?{String@symbol}FsmCapMetadataValue);
    ELSE
      RETURN NIL;
    END
}
END
PUB FN mIRLowering__emit_fsm_lock_error_arm_split(MUTABLE self: MIRLowering, clause: ErrorClause, ctx_id: Int64, with_node: WithBlock, capture_map: {String}String, pointer_captures: [Set]String, bg_rt: String) RETURNS !?FsmLockErrorArmSplit
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE line = COPY with_node.token?.line;
    IF (clause.action IS_A Raise) THEN
      RETURN FsmLockErrorArmSplit{ body_stmts: COPY mIRLowering__lock_error_done_stmts(rtoc_self_view, ctx_id, Emittable{ Lit: COPY Lit{ value: "\"lock acquire failed\"", lowered_node_id: NIL, ownership_consumption: NIL } }, line, "error.CheatError"), exit_kind: :done };
    ELSE_IF (clause.action IS_A Exit) THEN
      MUTABLE message_mir = mIRLowering__with_fiber_capture_map(rtoc_self_view, capture_map, {}, bg_rt, %() USE(clause, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_214 = TRY (mIRLowering__lower(&rtoc_self_view, castNodeToMIRLoweringLowerableStmt(UNWRAP (clause.message))));
    rtoc_lambda_result_214
      });
      IF !(message_mir IS_A Emittable) THEN
        RETURN NIL;
      END
      RETURN FsmLockErrorArmSplit{ body_stmts: COPY mIRLowering__lock_error_done_stmts(rtoc_self_view, ctx_id, message_mir, line, "error.CheatError"), exit_kind: :done };
    ELSE_IF (clause.action IS_A Pass) THEN
      RETURN FsmLockErrorArmSplit{ body_stmts: ( { MUTABLE rtoc_empty_list_215: []Emittable = List[]; rtoc_empty_list_215 } ), exit_kind: :goto_post };
    ELSE_IF (clause.action == ErrorActionKind.Block) THEN
      MUTABLE prev_bg_ptr_caps: ?[Set]String = COPY mIRLowering__capture_state(rtoc_self_view).current_bg_pointer_captures;
      MUTABLE prev_fiber_pending = COPY mIRLowering__function_state(rtoc_self_view).pending_stmts;
      DEFER {
      MUTABLE rtoc_writer_receiver_216: FunctionState = mIRLowering__function_state(rtoc_self_view);
      rtoc_writer_receiver_216.pending_stmts = prev_fiber_pending;
      MUTABLE rtoc_writer_receiver_217: MIRLoweringCaptureState = mIRLowering__capture_state(rtoc_self_view);
      rtoc_writer_receiver_217.current_bg_pointer_captures = prev_bg_ptr_caps;
      }
      MUTABLE rtoc_writer_receiver_218: MIRLoweringCaptureState = mIRLowering__capture_state(rtoc_self_view);
      rtoc_writer_receiver_218.current_bg_pointer_captures = COPY pointer_captures;
      MUTABLE rtoc_writer_receiver_220: FunctionState = mIRLowering__function_state(rtoc_self_view);
      rtoc_writer_receiver_220.pending_stmts = ( { MUTABLE rtoc_empty_list_219: []Stmt = List[]; rtoc_empty_list_219 } );
      MUTABLE block_mir = mIRLowering__with_fiber_capture_map(rtoc_self_view, capture_map, {}, bg_rt, %() USE(clause, MUTABLE rtoc_self_view) -> mIRLowering__lower_finalized_fsm_step_mir(&rtoc_self_view, clause.body, TRUE));
      RETURN FsmLockErrorArmSplit{ body_stmts: COPY block_mir, exit_kind: :goto_post };
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN mIRLowering__lock_error_done_stmts(self: MIRLowering, ctx_id: Int64, message: Emittable, line: String, result_zig: String) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN CAST([Emittable{ ExprStmt: COPY mIRLowering__lock_error_set_error_stmt(rtoc_self_view, ctx_id, message, line) }, Emittable{ Set: COPY mIRLowering__lock_error_result_set(rtoc_self_view, ctx_id, result_zig) }] AS []Emittable);
}
END
PRIVATE FN mIRLowering__lock_error_set_error_stmt(self: MIRLowering, ctx_id: Int64, message: Emittable, line: String) RETURNS ExprStmt
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__ctx_${ctx_id.toString()}", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "rt", lowered_node_id: NIL, ownership_consumption: NIL } }, method: "setError", args: [CAST(EnumTag{ variant: "Transient" } AS Any), CAST(EnumOrdinal{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "ErrorName", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "LockTimeout", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } AS Any), CAST(message AS Any), CAST(Lit{ value: COPY line, lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: FALSE, callable_contract: NIL, owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
}
END
PRIVATE FN mIRLowering__lock_error_result_set(self: MIRLowering, ctx_id: Int64, result_zig: String) RETURNS Set
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE result_name = result_zig.deletePrefix("error.");
    RETURN Set{ target: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__ctx_${ctx_id.toString()}", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "inner", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "result", lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "error", lowered_node_id: NIL, ownership_consumption: NIL } }, field: COPY result_name, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
}
END
PUB FN mIRLowering__default_fsm_lock_error_arm_split(self: MIRLowering, id: Int64) RETURNS FsmLockErrorArmSplit
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN FsmLockErrorArmSplit{ body_stmts: [Emittable{ Set: COPY mIRLowering__lock_error_result_set(rtoc_self_view, id, "error.LockError") }], exit_kind: :done };
}
END
PRIVATE FN mIRLowering__lower_test_block(MUTABLE self: MIRLowering, node: TestBlock) RETURNS ![]TestDef
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE ctx = testBlockCtx__new(node, rtoc_self_view);
    MUTABLE tests = List[];
    TRY (testBlockCtx__emit_all_hooks(ctx, (node.before_all OR List[]), "__before_all", "", &tests));
    FOR _ IN ((node.whens OR List[])) DO
    mIRLowering__lower_when_block(&rtoc_self_view, _, ctx, &tests);
    END
    TRY (testBlockCtx__emit_all_hooks(ctx, (node.after_all OR List[]), "__after_all", "", &tests));
    RETURN tests;
}
END
PRIVATE FN mIRLowering__lower_when_block(MUTABLE self: MIRLowering, when_block: WhenBlock, ctx: TestBlockCtx, MUTABLE tests: []TestDef) RETURNS ![]TestDef
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE when_desc = when_block.description;
    MUTABLE prev_stubs = OWN COPY (KEEP mIRLowering__test_state(rtoc_self_view).active_stubs);
    MUTABLE rtoc_writer_receiver_221: MIRLoweringTestState = mIRLowering__test_state(rtoc_self_view);
    rtoc_writer_receiver_221.active_stubs = OWN COPY prev_stubs;
    DEFER MUTABLE rtoc_writer_receiver_222: MIRLoweringTestState = mIRLowering__test_state(rtoc_self_view);
    rtoc_writer_receiver_222.active_stubs = prev_stubs;
    MUTABLE stubs, non_stub_setup = when_block.setup.partition(%(s) -> s IS_A StubDecl);
    MUTABLE when_setup_mir = TRY (mIRLowering__lower_body(&rtoc_self_view, non_stub_setup));
    MUTABLE stub_mir = (stubs |> UNNEST {
    MUTABLE m = TRY (mIRLowering__lower(&rtoc_self_view, _));
    ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_224: ?[]Any = NIL;
      IF m IS_A []@multiowned Any THEN
        rtoc_ternary_value_224 = m;
      ELSE
        rtoc_ternary_value_224 = [m];
      END
      rtoc_ternary_value_224? })
    }) |> WHERE _ != NIL;
    MUTABLE when_before_each_mir = (((when_block.before_each OR List[]))) |> SELECT TRY (mIRLowering__lower_body(&rtoc_self_view, _));
    MUTABLE when_after_each_mir = (((when_block.after_each OR List[]))) |> SELECT TRY (mIRLowering__lower_body(&rtoc_self_view, _));
    MUTABLE let_ast_map = mIRLowering__build_let_ast_map(rtoc_self_view, (when_block.lets OR List[]), mIRLowering__build_let_ast_map(rtoc_self_view, (ctx.test_block.lets OR List[])));
    TRY (testBlockCtx__emit_all_hooks(ctx, (when_block.before_all OR List[]), "__before_all", "${when_desc}: ", &tests));
    MUTABLE tag_suffix = mIRLowering__format_tag_suffix(rtoc_self_view, (when_block.tags OR List[]));
    MUTABLE env = TestThatEnv{ ctx: COPY ctx, when_block: COPY when_block, when_desc: when_desc, tag_suffix: tag_suffix, stub_mir: stub_mir, when_setup_mir: when_setup_mir, when_before_each_mir: when_before_each_mir, when_after_each_mir: when_after_each_mir, let_ast_map: let_ast_map };
    FOR _ IN ((when_block.tests OR List[])) DO
    &tests.append(mIRLowering__lower_test_that(&rtoc_self_view, _, env));
    END
    FOR _ IN ((when_block.benchmarks OR List[])) DO
    MUTABLE name = "${ctx.test_name}: ${when_desc}: benchmark${tag_suffix}";
    MUTABLE body = (((([testBlockCtx__fresh_preamble(ctx)] + stub_mir) + ctx.setup_mir) + when_setup_mir) + [TRY (mIRLowering__lower(&rtoc_self_view, _))]);
    &tests.append(TestDef{ name: name, body: COPY body, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, needs_scheduler: NIL });
    END
    RETURN TRY (testBlockCtx__emit_all_hooks(ctx, (when_block.after_all OR List[]), "__after_all", "${when_desc}: ", &tests));
}
END
PRIVATE FN mIRLowering__lower_test_that(MUTABLE self: MIRLowering, test_that: TestThat, env: TestThatEnv) RETURNS !TestDef
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE full_name = "${env.ctx.test_name()}: ${env.when_desc}: ${test_that.description}${env.tag_suffix}";
    IF test_that.pending THEN
      RETURN TestDef{ name: full_name, body: Body{ ArrayValue: [{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_225 = CAST(env.ctx AS TestBlockCtx);
      testBlockCtx__fresh_preamble(rtoc_local_receiver_225) }, ReturnStmt{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "error", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "SkipZigTest", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }] |> SELECT SegmentStmt{ Emittable: Emittable{ ReturnStmt: COPY _ } } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, needs_scheduler: NIL };
    END
    MUTABLE body_mir = mIRLowering__with_test_that_bindings(rtoc_self_view, test_that, %() USE(test_that, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_226 = TRY (mIRLowering__lower_body(&rtoc_self_view, test_that.body));
    rtoc_lambda_result_226
    });
    MUTABLE before_mir = (env.ctx.test_before_each_mir().flatten() + env.when_before_each_mir.flatten());
    MUTABLE after_defers = ((env.ctx.test_after_each_mir() + env.when_after_each_mir)) |> SELECT MIRDeferStmt{ body: DeferBody{ Emittable: COPY CAST(COPY ScopeBlock{ body: COPY _, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    MUTABLE used_let_names = mIRLowering__compute_used_let_names(rtoc_self_view, env.let_ast_map, ([test_that.body, env.when_block.before_each(), env.when_block.after_each(), env.ctx.test_block().before_each(), env.ctx.test_block().after_each()]).flatten());
    MUTABLE let_decls_mir = used_let_names |> SELECT Let{ name: COPY _, init: COPY TRY (mIRLowering__lower(&rtoc_self_view, (UNWRAP (env.let_ast_map[_])).expr())), mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL };
    MUTABLE body = ((((((([{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_227 = CAST(env.ctx AS TestBlockCtx);
    testBlockCtx__fresh_preamble(rtoc_local_receiver_227) }] + env.stub_mir) + env.ctx.setup_mir()) + env.when_setup_mir) + let_decls_mir) + before_mir) + after_defers) + body_mir);
    MUTABLE test_def = TestDef{ name: full_name, body: COPY body, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, needs_scheduler: NIL };
    test_def.needs_scheduler = mIRLowering__test_body_spawns_fibers?(rtoc_self_view, body);
    RETURN test_def;
}
END
PRIVATE FN mIRLowering__test_body_spawns_fibers?(self: MIRLowering, body: []Emittable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE found: Bool = FALSE;
    mIR__each_node(NodeRoot{ ArrayValue: COPY body }, %(n: Emittable) -> {
    found = (found OR ((((n IS_A MIRBgBlock OR n IS_A StreamSpawn) OR n IS_A ShardConcurrentEach) OR ((IF n IS_A MIRMethodCall AS mir_method_call THEN (mir_method_call.method == "getSched") ELSE FALSE END))) OR ((IF n IS_A RuntimeCall AS runtime_call THEN runtime_call.spec.callee.downcase().contains?("concurrent") ELSE FALSE END))));
    rubyToClearVoid()
    });
    RETURN found;
}
END
PRIVATE FN mIRLowering__with_test_that_bindings(self: MIRLowering, test_that: TestThat, blk: FN() -> ![]Emittable) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
  MUTABLE prev = COPY mIRLowering__function_state(rtoc_self_view).current_bindings;
  DEFER MUTABLE rtoc_writer_receiver_228: FunctionState = mIRLowering__function_state(rtoc_self_view);
  rtoc_writer_receiver_228.current_bindings = prev;
  MUTABLE synth_fn = test_that.synthetic_fn;
  MUTABLE rtoc_writer_receiver_229: FunctionState = mIRLowering__function_state(rtoc_self_view);
  rtoc_writer_receiver_229.current_bindings = ((synth_fn.cleanup_bindings()) OR {});
  RETURN TRY (blk());
}
END
PRIVATE FN mIRLowering__format_tag_suffix(self: MIRLowering, tags_value: []String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (tags_value.length() == 0) THEN
      RETURN "";
    END
    RETURN (" " $+ ((tags_value |> SELECT "#${_}").join(" ")));
}
END
PRIVATE FN mIRLowering__build_let_ast_map(self: MIRLowering, lets: []LetBinding, base: {String}LetBinding) RETURNS !{String}LetBinding
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE out = COPY base;
    FOR _ IN lets DO
