      END, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    next_call.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY source_result_type }));
    MUTABLE next_value_branch_value: ?AsyncPayloadTake = NIL;
      IF asyncResultShape__boxes_fallible_payload?(source_shape) THEN
        next_value_branch_value = AsyncPayloadTake{ source: Emittable{ TryExpr: COPY TryExpr{ expr: Emittable{ MIRMethodCall: COPY next_call }, lowered_node_id: NIL, ownership_consumption: NIL } }, result_type: COPY TRY (type__new(TypeConstructionInput{ Type: COPY source_result_type })) };
