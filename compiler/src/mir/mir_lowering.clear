      MUTABLE raw_name = COPY CAST(node.result.name() AS String);
      MUTABLE entry: ?CleanupEntry@multiowned = COPY (TRY (functionState__bindings(mIRLowering__function_state(rtoc_self_view))))[raw_name];
      transfer_name = mIRLowering__zig_safe_name(rtoc_self_view, raw_name);
      IF (IF entry != NIL THEN
        cleanupEntry__needs_cleanup?(entry)
      ELSE
        NIL
      END) THEN
        cleanupEntry__mark_moved_guard_mut(&entry);
        MUTABLE rtoc_index_receiver_595 = mIRLowering__function_state(rtoc_self_view).guarded_cleanup_names;
        rtoc_index_receiver_595[transfer_name] = TRUE;
      END
    END
    MUTABLE body = TRY (mIRLowering__lower_body(&rtoc_self_view, node.body));
    IF node.result EXISTS AS optional_value_value THEN
      MUTABLE optional_value_value_mutable = COPY optional_value_value;
      MUTABLE result, result_hoists = mIRLowering__lower_head(rtoc_self_view, %() USE(node, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_596 = TRY (mIRLowering__lower(&rtoc_self_view, castOptionalLocatableToMIRLoweringLowerableStmt(optional_value_value_mutable)));
    rtoc_lambda_result_596
      });
      ruby_array_concat_Emittable(body, CAST(result_hoists AS []Emittable));
      IF transfer_name EXISTS AS transfer_name_value THEN
        MUTABLE transfer_name_value_mutable = COPY transfer_name_value;
        MUTABLE cleanup: ?Emittable = body |> FIND (((_ IS_A Cleanup OR _ IS_A ErrCleanup)) AND (CAST(_.name() AS String) == transfer_name_value_mutable));
        IF cleanup EXISTS AS cleanup_value THEN
          MUTABLE cleanup_value_mutable = COPY cleanup_value;
          MUTABLE rtoc_mutable_receiver_597 = (ownedCompositeMaterialization__cleanup_entry(cleanup_value_mutable));
          cleanupEntry__mark_moved_guard_mut(&rtoc_mutable_receiver_597);
          body = ruby_array_concat_Emittable(body, CAST(TRY (mIRLowering__ownership_transfer_marks(rtoc_self_view, transfer_name_value_mutable, :block_result, NIL, TRUE)) AS []Emittable));
        END
      END
      &body.append(Emittable{ BreakStmt: COPY BreakStmt{ label: COPY label, value: COPY result, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
      MUTABLE block = MIRBlockExpr{ label: label, body: Body{ ArrayValue: body |> SELECT castEmittableToLocatable(_) }, lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
      block.result_type = TRY (type__from_node_mut(optional_value_value_mutable, "block expression result"));
      RETURN MIRLoweringReturnValue{ MIRBlockExpr: COPY block };
    ELSE
      RETURN MIRLoweringReturnValue{ ScopeBlock: COPY ScopeBlock{ body: Body{ ArrayValue: body |> SELECT castEmittableToLocatable(_) }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
}
END
PRIVATE FN mIRLowering__lower_range_lit(MUTABLE self: MIRLowering, MUTABLE node: RangeLit) RETURNS !MIRRangeLit
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE s = TRY (mIRLowering__lower(&rtoc_self_view, node.start));
    MUTABLE e = TRY (mIRLowering__lower(&rtoc_self_view, node.finish));
    MUTABLE elem_type: ?String@symbol = (IF TRY (type__tense_type((TRY (aST__full_type_mut(node))))) != NIL THEN
      type__resolved((TRY (type__element_type((TRY (type__tense_type((TRY (aST__full_type_mut(node))))))))))
    ELSE
      NIL
    END);
    MUTABLE range_branch_value: ?MIRRangeLit = NIL;
    IF node.inclusive THEN
      range_branch_value = MIRRangeLit{ start: COPY s, end_val: Emittable{ MIRBinOp: COPY MIRBinOp{ op: "+", left: COPY e, right: Emittable{ Lit: COPY Lit{ value: "1", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, elem_type: elem_type, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    ELSE
      range_branch_value = MIRRangeLit{ start: COPY s, end_val: COPY e, elem_type: elem_type, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    END
    MUTABLE range: MIRRangeLit = range_branch_value?;
    range.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY TRY (aST__full_type_mut(node)) }));
    RETURN range;
}
END
PRIVATE FN mIRLowering__lower_slice(MUTABLE self: MIRLowering, node: Slice) RETURNS !SliceExpr
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE target = TRY (mIRLowering__lower(&rtoc_self_view, node.target));
    MUTABLE start_expr = TRY (mIRLowering__lower(&rtoc_self_view, node.start));
    MUTABLE end_expr = TRY (mIRLowering__lower(&rtoc_self_view, node.end));
    MUTABLE exclusive = node.exclusive;
    MUTABLE target_ti = TRY (type__from_node_mut(node.target, "slice target"));
    IF TRY (type__direct_indexable_collection?(target_ti)) THEN
      target = ItemsAccess{ expr: Emittable{ ItemsAccess: COPY target }, safe: TRUE, lowered_node_id: NIL, ownership_consumption: NIL };
    END
    MUTABLE start_cast = MIRCast{ expr: COPY start_expr, target_type: "usize", method: :intCast, lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE end_cast =   IF exclusive THEN
      MIRCast{ expr: COPY end_expr, target_type: "usize", method: :intCast, lowered_node_id: NIL, ownership_consumption: NIL }
    ELSE
      MIRBinOp{ op: "+", left: Emittable{ MIRCast: COPY MIRCast{ expr: COPY end_expr, target_type: "usize", method: :intCast, lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Lit: COPY Lit{ value: "1", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL }
    END;
    MUTABLE element_type = (&node.target.full_type_mut()).element_type();
    MUTABLE elem_zig: String = "";
    IF element_type THEN
      elem_zig = TRY (type__zig_type((TRY (type__new(element_type)))));
    ELSE
      elem_zig = "u8";
    END
    RETURN SliceExpr{ target: Emittable{ ItemsAccess: COPY target }, start: Emittable{ MIRCast: COPY start_cast }, end_expr: COPY end_cast, elem_type: elem_zig, lowered_node_id: NIL, ownership_consumption: NIL };
}
END
PRIVATE FN mIRLowering__lower_assert(MUTABLE self: MIRLowering, node: Assert) RETURNS !MIRLoweringReturnValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE eq_lowering: ?Call = mIRLowering__try_lower_equality_assert(&rtoc_self_view, node);
    IF (!(mIRLowering__bc_target?(rtoc_self_view)) AND (eq_lowering)) THEN
      RETURN MIRLoweringReturnValue{ Call: COPY UNWRAP (eq_lowering) };
    END
    MUTABLE cond = TRY (mIRLowering__lower(&rtoc_self_view, node.condition));
    MUTABLE raw = node.message;
    MUTABLE msg_str: String = "";
    IF (((raw == NIL) OR (raw == :Any)) OR raw.empty?()) THEN
      msg_str = "assertion failed";
    ELSE
      msg_str = COPY CAST(raw AS String);
    END
    MUTABLE msg = msg_str.replace("\"", "\\\"");
    RETURN MIRLoweringReturnValue{ AssertStmt: COPY AssertStmt{ cond: COPY cond, message: "\"${msg}\"", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
}
END
PRIVATE FN mIRLowering__try_lower_equality_assert(MUTABLE self: MIRLowering, node: Assert) RETURNS !?Call
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE cond = node.condition;
    IF !((cond IS_A BinaryOp AND (cond.op() == :EQ))) THEN
      RETURN NIL;
    END
    MUTABLE raw = node.message;
    MUTABLE has_message = !(((((raw == NIL) OR (raw == :Any)) OR ((respondsTo?(raw, "empty?") AND raw.empty?())))));
    IF has_message THEN
      RETURN NIL;
    END
    MUTABLE left = cond.left();
    MUTABLE right = cond.right();
    MUTABLE left_type = mIRLowering__type_info_for(rtoc_self_view, left);
    MUTABLE right_type = mIRLowering__type_info_for(rtoc_self_view, right);
    MUTABLE left_mir: Emittable = CAST(TRY (mIRLowering__lower(&rtoc_self_view, left)) AS Emittable);
    MUTABLE right_mir: Emittable = CAST(TRY (mIRLowering__lower(&rtoc_self_view, right)) AS Emittable);
    IF (TRY (type__any_rc?(left_type)) AND !(mIRLowering__bc_target?(rtoc_self_view))) THEN
      left_mir = mIRLowering__rc_payload_value(rtoc_self_view, left_mir, CAST(left_type AS Type));
    END
    IF (TRY (type__any_rc?(right_type)) AND !(mIRLowering__bc_target?(rtoc_self_view))) THEN
      right_mir = mIRLowering__rc_payload_value(rtoc_self_view, right_mir, CAST(right_type AS Type));
    END
    left_mir = mIRLowering__hoist_alloc(rtoc_self_view, left_mir, left);
    right_mir = mIRLowering__hoist_alloc(rtoc_self_view, right_mir, right);
    MUTABLE helper, extra_args = mIRLowering__pick_equality_helper(rtoc_self_view, left, right);
    IF (helper == "expectEqualStrings") THEN
      left_mir = TRY (mIRLowering__widen_symbol_to_bytes(rtoc_self_view, left_mir, left));
      right_mir = TRY (mIRLowering__widen_symbol_to_bytes(rtoc_self_view, right_mir, right));
    END
    MUTABLE args_mir: []Emittable = extra_args |> SELECT Ident{ name: COPY _, lowered_node_id: NIL, ownership_consumption: NIL };
    &args_mir.append(left_mir);
    &args_mir.append(right_mir);
    MUTABLE params = args_mir.each_index() |> SELECT Param{ name: "__assert_eq_arg${_}", type: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })), default: NIL, mutable: NIL, takes: NIL, comptime: NIL, name_token: NIL, required: NIL, sync: NIL, symbol: NIL, carrier_contract: NIL };
    MUTABLE sig = TRY (functionSignature__new(params, TypeTypeInput{ Type: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :Void })) }, NIL, NIL, ( { MUTABLE rtoc_empty_list_598: []String@symbol = List[]; rtoc_empty_list_598 } ), {}, FALSE, FALSE, NIL, NIL, NIL, ( { MUTABLE rtoc_empty_list_599: []String@symbol = List[]; rtoc_empty_list_599 } ), NIL, ( { MUTABLE rtoc_empty_list_600: []String@symbol = List[]; rtoc_empty_list_600 } ), TRUE, NIL, TRUE, NIL, NIL, NIL, NIL, NIL, NIL, NIL, NIL, NIL, NIL, NIL, IntrinsicEmit{ borrows: :all, zig: NIL, numeric_zig: NIL, sharded_zig: NIL, shard_direct_zig: NIL, fsm_setup: List[], fsm_state_decls: List[], fsm_finish_block: List[], fsm_state_finalize: List[], fsm_setup_present: FALSE, fsm_state_decls_present: FALSE, fsm_finish_block_present: FALSE, fsm_state_finalize_present: FALSE, fsm_finish_value: NIL, bc: FALSE, is_method: FALSE, suspends: FALSE, narrows_collection: FALSE, narrows_receiver_collection: FALSE, mutates_receiver: FALSE, allocates: FALSE, takes_value: FALSE, container_borrow: FALSE, tag: NIL, builtin: NIL, alloc: NIL, return_alloc: NIL, val_alloc: NIL, key_alloc: NIL, shard_alloc: NIL, sharded_alloc: NIL, reject_when: NIL, bc_op: NIL, error_kind: NIL, error_type: NIL, registry: NIL, elem: NIL, fallible_clauses: NIL, lifetime: List[], reject_error: NIL, arity: NIL, takes_args: List[], label: NIL, eql: NIL, strcmp: NIL, cleanup: NIL, assert: NIL, array: NIL, list: NIL, pool: NIL, set: NIL, get: NIL, string_raw: NIL, string_symbol: NIL, string_map: NIL, numeric_map: NIL, set_collection: NIL }));
    MUTABLE contract = TRY (ownershipContract__new(( { MUTABLE rtoc_empty_list_601: []OwnershipOperandFact = List[]; rtoc_empty_list_601 } ), ( { MUTABLE rtoc_empty_list_602: []String = List[]; rtoc_empty_list_602 } ), ( { MUTABLE rtoc_empty_list_603: []String = List[]; rtoc_empty_list_603 } ), TRUE));
    RETURN Call{ callee: "std.testing.${helper}", args: COPY args_mir, try_wrap: TRUE, owned_return: FALSE, callable_contract: COPY callableContract__new(sig, contract, args_mir.length()), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL };
}
END
PRIVATE FN mIRLowering__pick_equality_helper(self: MIRLowering, left: Locatable, right: Locatable) RETURNS !Tuple<String, []String>
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE lt = mIRLowering__type_info_for(rtoc_self_view, left);
    MUTABLE rt = mIRLowering__type_info_for(rtoc_self_view, right);
    IF (TRY (type__string_comparable_with?(lt, CAST(rt AS ?Type))) OR TRY (type__string_comparable_with?(rt, CAST(lt AS ?Type)))) THEN
      RETURN CAST(Tuple{"expectEqualStrings", List[]} AS Tuple<String, []String>);
    END
    MUTABLE slice_elem: ?String = (IF mIRLowering__slice_element_zig_type(rtoc_self_view, CAST(lt AS Type)) != NIL THEN mIRLowering__slice_element_zig_type(rtoc_self_view, CAST(lt AS Type)) ELSE mIRLowering__slice_element_zig_type(rtoc_self_view, CAST(rt AS Type)) END);
    IF slice_elem EXISTS AS slice_elem_value THEN
      RETURN CAST(Tuple{"expectEqualSlices", [slice_elem_value]} AS Tuple<String, []String>);
    END
    RETURN CAST(Tuple{"expectEqualDeep", List[]} AS Tuple<String, []String>);
}
END
PRIVATE FN mIRLowering__type_info_for(self: MIRLowering, ast_node: Locatable) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (type__from_node_mut(ast_node, "equality helper"));
}
END
PRIVATE FN mIRLowering__slice_element_zig_type(self: MIRLowering, t: Type) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((TRUE AND type__array?(t))) THEN
      RETURN NIL;
    END
    IF TRY (type__string?(t)) THEN
      RETURN NIL;
    END
    MUTABLE elem_branch_value: ?Type = NIL;
    IF TRUE THEN
      elem_branch_value = TRY (type__element_type(t));
    ELSE
      elem_branch_value = NIL;
    END
    MUTABLE elem: ?Type = elem_branch_value;
    IF elem EXISTS AS elem_value THEN
      IF TRUE THEN
        RETURN TRY (type__zig_type(elem_value));
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
CATCH Transient, Input, System, NotFound, Permission, Canceled
  RETURN NIL;
END
PRIVATE FN mIRLowering__lower_raise(MUTABLE self: MIRLowering, node: Raise) RETURNS !ScopeBlock
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rt = Ident{ name: mIRLowering__runtime_binding_name(rtoc_self_view), lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE kind = COPY CAST(((node.kind OR :Unknown)) AS String);
    MUTABLE error_name = node.error_name;
    MUTABLE name_expr =   IF (error_name AND !(error_name.empty?())) THEN
      EnumOrdinal{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "ErrorName", lowered_node_id: NIL, ownership_consumption: NIL } }, field: COPY error_name, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL }
    ELSE
      Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL }
    END;
    MUTABLE msg_expr_branch_value: ?Lit = NIL;
    IF node.message_expr THEN
      msg_expr_branch_value = TRY (mIRLowering__lower(&rtoc_self_view, node.message_expr));
    ELSE
      msg_expr_branch_value = Lit{ value: "\"\"", lowered_node_id: NIL, ownership_consumption: NIL };
    END
    MUTABLE msg_expr: Lit = msg_expr_branch_value?;
    MUTABLE line = COPY node.token.line;
    MUTABLE set_error = MIRMethodCall{ receiver: Emittable{ Ident: COPY rt }, method: "setError", args: [CAST(EnumTag{ variant: COPY kind } AS Any), CAST(name_expr AS Any), CAST(msg_expr AS Any), CAST(Lit{ value: COPY line, lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(4)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    MUTABLE ret = ReturnStmt{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "error", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "CheatError", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    RETURN ScopeBlock{ body: COPY CAST(Tuple{ExprStmt{ expr: Emittable{ MIRMethodCall: COPY set_error }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }, ret} AS Tuple<ExprStmt, ReturnStmt>), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
}
END
PRIVATE FN mIRLowering__lower_copy(MUTABLE self: MIRLowering, MUTABLE node: CopyNode) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_writer_receiver_604: FunctionState = mIRLowering__function_state(rtoc_self_view);
    rtoc_writer_receiver_604.current_sink_type = COPY mIRLowering__function_state(rtoc_self_view).current_sink_type;
    MUTABLE rtoc_writer_receiver_605: FunctionState = mIRLowering__function_state(rtoc_self_view);
    rtoc_writer_receiver_605.current_expected_type = COPY mIRLowering__function_state(rtoc_self_view).current_expected_type;
    IF ((node.own AND node.value IS_A Identifier) AND ((node.value.symbol() != NIL) AND ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_606 = ((node.value.symbol())?);
    symbolEntry__carrier_contract(rtoc_local_receiver_606) } == :monomorphic))) THEN
      MUTABLE payload_ti = TRY (type__from_node_mut(node.value, "OWN COPY monomorphic payload"));
      MUTABLE projected = ComptimeCarrierPayload{ source: COPY TRY (mIRLowering__lower(&rtoc_self_view, node.value)), lowered_node_id: NIL, ownership_consumption: NIL };
      RETURN Emittable{ DeepCopy: COPY DeepCopy{ source: Emittable{ ComptimeCarrierPayload: COPY projected }, zig_type: COPY CAST(type__resolved(payload_ti) AS String), elem_type: NIL, strategy: :full_value, alloc: :heap, copy_shape: NIL, type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF node.own THEN
      MUTABLE own_src_ti = TRY (type__from_node_mut(node.value, "OWN COPY handle payload"));
      IF TRY (type__any_rc?(own_src_ti)) THEN
        MUTABLE payload_ti = TRY (type__bare_data_type(own_src_ti));
        MUTABLE projected = ComptimeCarrierPayload{ source: COPY TRY (mIRLowering__lower(&rtoc_self_view, node.value)), lowered_node_id: NIL, ownership_consumption: NIL };
        RETURN Emittable{ DeepCopy: COPY DeepCopy{ source: Emittable{ ComptimeCarrierPayload: COPY projected }, zig_type: COPY TRY (type__zig_type(payload_ti)), elem_type: NIL, strategy: :full_value, alloc: :heap, copy_shape: NIL, type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
    END
    MUTABLE source = TRY (mIRLowering__lower(&rtoc_self_view, node.value));
    IF mIRLowering__fresh_copy_constructor?(rtoc_self_view, node.value) THEN
      RETURN source;
    END
    IF hoist__noreturn_value?(node.value) THEN
      RETURN source;
    END
    IF TRY (mIRLowering__unit_union_variant_constructor?(rtoc_self_view, node.value)) THEN
      RETURN source;
    END
    MUTABLE source_ti = mIRLowering__copy_source_type_info(rtoc_self_view, &node.value);
    MUTABLE ti = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_608: ?Type = NIL;
    IF node.coerced_type_info() THEN
      rtoc_ternary_value_608 = TRY (type__new(TypeConstructionInput{ Type: COPY UNWRAP (node.coerced_type_info()) }));
    ELSE
      rtoc_ternary_value_608 = source_ti;
    END
    rtoc_ternary_value_608? };
    IF (TRY (type__any_rc?(ti)) AND !(TRY (type__any_rc?(source_ti)))) THEN
      ti = KEEP source_ti;
    END
    MUTABLE lifecycle = COPY UNWRAP (mIRLowering__lifecycle_registry(rtoc_self_view)[ti]);
    MUTABLE sink_type: ?Type = (IF mIRLowering__function_state(rtoc_self_view).current_sink_type != NIL THEN mIRLowering__function_state(rtoc_self_view).current_sink_type ELSE mIRLowering__function_state(rtoc_self_view).current_expected_type END);
    MUTABLE dst_ti_branch_value: ?Type@multiowned = NIL;
    IF sink_type EXISTS AS sink_type_value THEN
      dst_ti_branch_value = (sink_type_value);
    ELSE
      dst_ti_branch_value = ti;
    END
    MUTABLE dst_ti: Type@multiowned = dst_ti_branch_value?;
    MUTABLE alloc = ((IF mIRLowering__function_state(rtoc_self_view).current_decl_alloc != NIL THEN mIRLowering__function_state(rtoc_self_view).current_decl_alloc ELSE node.alloc END) OR_ELSE :heap);
    IF (IF source IS_A Orelse AS orelse THEN lifecyclePlan__needs_drop?(lifecycle) ELSE FALSE END) THEN
      source = TRY (mIRLowering__place_owned_orelse_for_destination(rtoc_self_view, castEmittableToOrelse(source), CAST(source_ti AS Type), alloc));
      source = mIRLowering__hoist_alloc(rtoc_self_view, source, node.value, FALSE, FALSE, FALSE);
    ELSE_IF mIRLowering__mir_allocates?(rtoc_self_view, source) THEN
      source = mIRLowering__hoist_alloc(rtoc_self_view, source, node.value);
    END
    IF (lifecycle.copy_strategy == :bit_copy) THEN
      RETURN Emittable{ DeepCopy: COPY DeepCopy{ source: COPY source, zig_type: NIL, elem_type: NIL, strategy: :passthrough, alloc: NIL, copy_shape: NIL, type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE_IF (lifecycle.copy_strategy == :forbidden) THEN
      panic("annotation admitted COPY of linear type {}");
    ELSE_IF (lifecycle.copy_strategy == :retain) THEN
      IF (type__optional?(ti) AND ((TRY (type__wrapped_type(ti)) != NIL) AND TRY (type__any_rc?(((TRY (type__wrapped_type(ti)))?))))) THEN
        MUTABLE wrapped = UNWRAP (TRY (type__wrapped_type(ti)));
        MUTABLE capture = "__copy_rc_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_609 = mIRLowering__lowering_counters(rtoc_self_view);
        mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_609) }}";
        MUTABLE func: String = "";
        IF type__shared?(wrapped) THEN
          func = "arcRetain";
        ELSE
          func = "rcRetain";
        END
        MUTABLE retained = RcRetain{ source: Emittable{ Ident: COPY Ident{ name: capture, lowered_node_id: NIL, ownership_consumption: NIL } }, zig_base: mIRLowering__rc_payload_zig_type(rtoc_self_view, wrapped), func: func, lowered_node_id: NIL, ownership_consumption: NIL };
        MUTABLE copied = IfOptional{ optional: COPY source, capture: capture, then_expr: Emittable{ RcRetain: COPY retained }, else_expr: Emittable{ Lit: COPY Lit{ value: "null", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
        copied.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY ti }));
        RETURN Emittable{ IfOptional: COPY copied };
      ELSE
        IF type__shared?(ti) THEN
          func = "arcRetain";
        ELSE
          func = "rcRetain";
        END
        RETURN Emittable{ RcRetain: COPY RcRetain{ source: COPY source, zig_base: mIRLowering__rc_payload_zig_type(rtoc_self_view, CAST(ti AS Type)), func: func, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
    ELSE_IF (lifecycle.copy_strategy == :deep_clone) OR (lifecycle.copy_strategy == :generic) THEN
      MUTABLE copy_ti_branch_value: ?Type@multiowned = NIL;
      IF ((type__optional?(ti) OR type__error_union?(ti))) THEN
        copy_ti_branch_value = ti;
      ELSE
        copy_ti_branch_value = dst_ti;
      END
      MUTABLE copy_ti: Type@multiowned = copy_ti_branch_value?;
      MUTABLE dst_payload = TRY (type__non_optional_type(dst_ti));
      MUTABLE source_payload = TRY (type__non_optional_type(ti));
      IF (TRY (type__any_rc?(dst_payload)) AND !(TRY (type__any_rc?(source_payload)))) THEN
        RETURN Emittable{ DeepCopy: COPY DeepCopy{ source: COPY source, zig_type: COPY mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ Type: COPY source_payload }), elem_type: NIL, strategy: :full_value, alloc: COPY alloc, copy_shape: COPY deepCopy__copy_shape_for_zig_type(mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ Type: COPY source_payload })), type_info: COPY source_payload, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
      MUTABLE copy_zig: ?String =     IF (lifecycle.copy_strategy == :generic) THEN
        NIL
      ELSE_IF (type__optional?(ti) OR type__error_union?(ti)) THEN
        mIRLowering__bare_zig_type(rtoc_self_view, CAST(ti AS Type))
      ELSE_IF TRY (type__string?(ti)) THEN
        "[]const u8"
      ELSE_IF ((TRY (type__direct_indexable_collection?(ti)) AND TRY (type__direct_indexable_collection?(dst_ti))) AND !(TRY (type__string?(dst_ti)))) THEN
        mIRLowering__copy_source_zig_type(rtoc_self_view, node.value, CAST(ti AS Type), CAST(dst_ti AS Type))
      ELSE_IF (type__borrowed_reference?(ti) OR (type__ownership(ti) == :borrow)) THEN
        mIRLowering__bare_zig_type(rtoc_self_view, CAST(dst_ti AS Type))
      ELSE_IF (type__indirect?(dst_ti) AND !(type__indirect?(ti))) THEN
        mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ Type: COPY ti })
      ELSE_IF (TRY (type__any_rc?(dst_ti)) AND !(TRY (type__any_rc?(ti)))) THEN
        mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ Type: COPY ti })
      ELSE
        mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ Type: COPY dst_ti })
      END;
      RETURN Emittable{ DeepCopy: COPY DeepCopy{ source: COPY source, zig_type: COPY copy_zig, elem_type: NIL, strategy: :full_value, alloc: COPY alloc, copy_shape: COPY deepCopy__copy_shape_for_zig_type(copy_zig), type_info: CAST(COPY copy_ti AS ?Type), lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE
      panic("unknown lifecycle copy strategy {} for {}");
    END
}
END
PRIVATE FN mIRLowering__copy_source_type_info(self: MIRLowering, MUTABLE source: Locatable) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (respondsTo?(source, "typed?") AND source.typed?()) THEN
      RETURN &source.full_type_mut("COPY value");
    END
    IF source IS_A GetIndex AS get_index THEN
      MUTABLE target_ti = TRY (type__from_node_mut(get_index.target, "COPY index target"));
      MUTABLE elem: ?Type = TRY (type__element_type(target_ti));
      IF elem EXISTS AS elem_value THEN
        RETURN COPY elem_value;
      END
    END
    MUTABLE sym_type =   IF (IF source IS_A Identifier AS identifier THEN TRUE ELSE FALSE END) THEN
      source.symbol().type()
    ELSE
      NIL
    END;
    IF (sym_type IS_A Type AND !(type__untyped?(sym_type))) THEN
      RETURN sym_type;
    END
    RETURN TRY (type__from_node_mut(source, "COPY value"));
}
END
PRIVATE FN mIRLowering__fresh_copy_constructor?(self: MIRLowering, node: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE value: Locatable = COPY node;
    WHILE (value IS_A CopyNode OR value IS_A KeepNode) DO
      value = value.value();
    END
    RETURN ((((value IS_A TupleLit OR value IS_A ListLit) OR value IS_A HashLit) OR value IS_A StructLit) OR value IS_A UnionVariantLit);
}
END
PRIVATE FN mIRLowering__copy_source_zig_type(self: MIRLowering, source: Locatable, source_type: Type, dest_type: Type) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF ((TRY (type__non_string_array?(source_type)) AND source IS_A Identifier) AND ((source.symbol() != NIL) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_610 = ((source.symbol())?);
    symbolEntry__is_param(rtoc_local_receiver_610) })) THEN
      RETURN TRY (type__zig_type(source_type, TRUE));
    END
    IF (TRY (type__non_string_array?(source_type)) AND type__collection?(dest_type)) THEN
      RETURN TRY (type__zig_type(source_type));
    ELSE
      RETURN TRY (type__zig_type(dest_type));
    END
}
END
PRIVATE FN mIRLowering__lower_clone(MUTABLE self: MIRLowering, node: KeepNode) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE func: String = "";
    MUTABLE ti = TRY (type__from_node_mut(node.value, "CLONE value"));
    IF (node.carrier_op == :monomorphic_keep) THEN
      RETURN Emittable{ MonomorphicKeep: COPY MonomorphicKeep{ source: COPY TRY (mIRLowering__lower(&rtoc_self_view, node.value)), zig_base: COPY CAST(type__resolved(ti) AS String), alloc: :heap, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF (node.carrier_op == :deferred_specialization) THEN
      panic("KEEP on a carrier-polymorphic parameter requires carrier {}");
    END
    MUTABLE lifecycle = COPY UNWRAP (mIRLowering__lifecycle_registry(rtoc_self_view)[ti]);
    IF (lifecycle.copy_strategy == :bit_copy) THEN
      RETURN Emittable{ DeepCopy: COPY DeepCopy{ source: COPY TRY (mIRLowering__lower(&rtoc_self_view, node.value)), zig_type: NIL, elem_type: NIL, strategy: :passthrough, alloc: NIL, copy_shape: NIL, type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF !((lifecycle.copy_strategy == :retain)) THEN
      panic("annotation admitted KEEP without retain lifecycle for {}");
    END
    IF (type__optional?(ti) AND ((TRY (type__wrapped_type(ti)) != NIL) AND TRY (type__any_rc?(((TRY (type__wrapped_type(ti)))?))))) THEN
      MUTABLE wrapped = UNWRAP (TRY (type__wrapped_type(ti)));
      MUTABLE capture = "__clone_rc_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_611 = mIRLowering__lowering_counters(rtoc_self_view);
      mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_611) }}";
      IF type__shared?(wrapped) THEN
        func = "arcRetain";
      ELSE
        func = "rcRetain";
      END
      MUTABLE retained = RcRetain{ source: Emittable{ Ident: COPY Ident{ name: capture, lowered_node_id: NIL, ownership_consumption: NIL } }, zig_base: mIRLowering__rc_payload_zig_type(rtoc_self_view, wrapped), func: func, lowered_node_id: NIL, ownership_consumption: NIL };
      MUTABLE cloned = IfOptional{ optional: COPY TRY (mIRLowering__lower(&rtoc_self_view, node.value)), capture: capture, then_expr: Emittable{ RcRetain: COPY retained }, else_expr: Emittable{ Lit: COPY Lit{ value: "null", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
      cloned.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY ti }));
      RETURN Emittable{ IfOptional: COPY cloned };
    END
    IF TRY (type__split_open_stream?(ti)) THEN
      func = "splitRetain";
    ELSE_IF (type__shared_promise?(ti) OR type__shared?(ti)) THEN
      func = "arcRetain";
    ELSE_IF type__multiowned?(ti) THEN
      func = "rcRetain";
    ELSE
      panic("Internal: lower_clone on unsupported type {}");
    END
    MUTABLE zig_base: String = "";
    IF TRY (type__split_open_stream?(ti)) THEN
      zig_base = TRY (type__zig_type(ti));
    ELSE
      zig_base = mIRLowering__rc_payload_zig_type(rtoc_self_view, ti);
    END
    RETURN Emittable{ RcRetain: COPY RcRetain{ source: COPY TRY (mIRLowering__lower(&rtoc_self_view, node.value)), zig_base: zig_base, func: func, lowered_node_id: NIL, ownership_consumption: NIL } };
}
END
PRIVATE FN mIRLowering__kept_identity_orelse_field_value(MUTABLE self: MIRLowering, field_node: Locatable, expected_ft: ?Type, alloc: String@symbol) RETURNS !?Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !((IF expected_ft != NIL THEN
      type__multiowned?(expected_ft)
    ELSE
      NIL
    END)) THEN
      RETURN NIL;
    END
    IF field_node IS_A BinaryOp AS binary_op THEN
      MUTABLE binary_op_mutable = COPY binary_op;
    IF (binary_op_mutable.op == symbol("OR_ELSE")) THEN
        MUTABLE lhs = binary_op_mutable.left;
        IF lhs IS_A Identifier AS identifier THEN
          MUTABLE identifier_mutable = COPY identifier;
          MUTABLE entry: ?CleanupEntry@multiowned = COPY (TRY (functionState__bindings(mIRLowering__function_state(rtoc_self_view))))[identifier__name(identifier_mutable)];
          IF !((((entry != NIL) AND cleanupEntry__present?(entry)) AND (entry[:source_kind] == :kept_param))) THEN
            RETURN NIL;
          END
          MUTABLE bare = TRY (type__bare_data_type(expected_ft));
          MUTABLE default_ti = (TRY (type__from_node_mut(binary_op_mutable.right, "kept orelse default")) OR_ELSE NIL);
          MUTABLE default_rc = ((default_ti != NIL) AND (TRY (type__any_rc?(default_ti)) == TRUE));
          IF (!(default_rc) AND respondsTo?(binary_op_mutable.right, "matched_signature")) THEN
            MUTABLE sig: ?FunctionSignature@multiowned = functionSignature__unwrap(binary_op_mutable.right.matched_signature());
            MUTABLE rt: ?Type@multiowned = NIL;
            IF sig != NIL THEN
              rt = COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_612 = (sig?);
            functionSignature__return_type(rtoc_local_receiver_612) };
            END
            default_rc = IF rt != NIL THEN
              ((TRY (type__any_rc?((TRY (type__new(TypeConstructionInput{ Type: COPY rt }))))) OR_ELSE FALSE))
            ELSE
              FALSE
            END;
          END
          MUTABLE wrapped = mIRLowering__lower_scoped(rtoc_self_view, %() USE(alloc, bare, default_rc, expected_ft, binary_op_mutable, MUTABLE rtoc_self_view) -> {
    IF default_rc THEN
      RETURN mIRLowering__hoist_alloc(rtoc_self_view, mIRLowering__with_expected_type(rtoc_self_view, expected_ft, %() USE(binary_op_mutable, MUTABLE rtoc_self_view) -> {
        rtoc_lambda_result_613 = TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(binary_op_mutable.right)));
        rtoc_lambda_result_613
      }), binary_op_mutable.right, TRUE);
    ELSE
      MUTABLE default_mir = mIRLowering__with_expected_type(rtoc_self_view, bare, %() USE(binary_op_mutable, MUTABLE rtoc_self_view) -> {
        rtoc_lambda_result_614 = TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(binary_op_mutable.right)));
        rtoc_lambda_result_614
      });
      RETURN mIRLowering__hoist_alloc(rtoc_self_view, mIRLowering__compose_capability_wrap(rtoc_self_view, default_mir, TRY (type__zig_type(bare)), UNWRAP (expected_ft), alloc), binary_op_mutable.right, TRUE);
    END
    NIL
          });
          MUTABLE still_live = IF mIRLowering__kept_store_liveness(&rtoc_self_view) THEN
            !({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_616 = UNWRAP (mIRLowering__kept_store_liveness(&rtoc_self_view));
          keptEdgeLiveness__last_use?(rtoc_local_receiver_616, identifier_mutable) })
          ELSE
            FALSE
          END;
          MUTABLE handle_type = TRY (type__new(TypeConstructionInput{ StringValue: COPY CAST((type__resolved((TRY (type__bare_data_type(expected_ft))))) AS String) }, :multiowned, NIL, NIL, :heap));
          IF still_live THEN
            MUTABLE payload = TRY (type__zig_type((TRY (type__bare_data_type(expected_ft)))));
            MUTABLE capture = "__keep_val_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_617 = mIRLowering__lowering_counters(rtoc_self_view);
            mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_617) }}";
            MUTABLE provided = RcRetain{ source: Emittable{ Ident: COPY Ident{ name: capture, lowered_node_id: NIL, ownership_consumption: NIL } }, zig_base: payload, func: "rcRetain", lowered_node_id: NIL, ownership_consumption: NIL };
            MUTABLE out = IfOptional{ optional: Emittable{ Ident: COPY Ident{ name: mIRLowering__zig_safe_name(rtoc_self_view, identifier__name(identifier_mutable)), lowered_node_id: NIL, ownership_consumption: NIL } }, capture: capture, then_expr: Emittable{ RcRetain: COPY provided }, else_expr: COPY wrapped, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
            out.result_type = handle_type;
            RETURN Emittable{ IfOptional: COPY out };
          ELSE
            out = Orelse{ expr: Emittable{ Ident: COPY Ident{ name: mIRLowering__zig_safe_name(rtoc_self_view, identifier__name(identifier_mutable)), lowered_node_id: NIL, ownership_consumption: NIL } }, fallback: COPY wrapped, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
            out.result_type = handle_type;
            mIRLowering__move_mark_field_mut(rtoc_self_view, Locatable{ Identifier: COPY identifier_mutable });
            RETURN TRY (mIRLowering__with_ownership_consumption(rtoc_self_view, Emittable{ IfOptional: COPY out }, [mIRLowering__zig_safe_name(rtoc_self_view, identifier__name(identifier_mutable))], "kept optional field store", :owned_sink, alloc));
          END
        ELSE
          RETURN NIL;
        END
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN mIRLowering__move_mark_field_mut(self: MIRLowering, MUTABLE v: Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF v IS_A Identifier AS identifier THEN
      MUTABLE identifier_mutable = COPY identifier;
      MUTABLE ti = &identifier_mutable.full_type_mut("field move mark");
      MUTABLE tracked = ((((TRUE AND !(type__primitive?(ti))) AND !(type__void?(ti))) AND !(type__any?(ti))) AND ((((TRY (type__string?(ti)) OR TRY (type__heap_ptr?(ti))) OR TRY (type__collection_value?(ti))) OR TRY (type__recursive_cleanup_shape?(ti, mIRLowering__mir_schema_lookup(rtoc_self_view))))));
      IF !(tracked) THEN
        RETURN;
      END
      MUTABLE nm = mIRLowering__zig_safe_name(rtoc_self_view, identifier__name(identifier_mutable));
      MUTABLE rename_map = TRY (functionState__rename_map(mIRLowering__function_state(rtoc_self_view)));
      nm = COPY (rename_map[nm] OR_ELSE nm);
      MUTABLE entry = ((TRY (functionState__bindings(mIRLowering__function_state(rtoc_self_view))))[identifier__name(identifier_mutable)] OR_ELSE new());
      IF !(cleanupEntry__present?(entry)) THEN
        RETURN;
      END
      cleanupEntry__mark_moved_guard_mut(&entry);
      MUTABLE rtoc_index_receiver_618 = mIRLowering__function_state(rtoc_self_view).guarded_cleanup_names;
      rtoc_index_receiver_618[nm] = TRUE;
    ELSE
      RETURN;
    END
}
END
PRIVATE FN mIRLowering__lower_move(MUTABLE self: MIRLowering, node: MoveNode) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node.value IS_A Identifier THEN
      MUTABLE ident = mIRLowering__lower_identifier(rtoc_self_view, &node.value);
      MUTABLE type_info = TRY (type__from_node_mut(node.value, "GIVE parameter"));
      IF (mIRLowering__current_function_takes_param_name?(rtoc_self_view, node.value.name()) AND type__needs_pointer_passing?(type_info)) THEN
        RETURN Emittable{ Deref: COPY Deref{ expr: COPY ident, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
      RETURN ident;
    ELSE
      RETURN TRY (mIRLowering__lower(&rtoc_self_view, node.value));
    END
}
END
PRIVATE FN mIRLowering__lower_share(MUTABLE self: MIRLowering, node: ShareNode) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE source = NIL;
    MUTABLE zig_base: String = "";
    MUTABLE source_ti = &node.value.full_type_mut();
    IF (TRUE AND !(TRUE)) THEN
      source_ti = TRY (type__new(TypeConstructionInput{ Type: COPY source_ti }));
    END
    IF (type__optional?(source_ti) AND ((TRY (type__wrapped_type(source_ti)) != NIL) AND TRY (type__any_rc?(((TRY (type__wrapped_type(source_ti)))?))))) THEN
      MUTABLE wrapped = UNWRAP (TRY (type__wrapped_type(source_ti)));
      source = TRY (mIRLowering__lower(&rtoc_self_view, node.value));
      MUTABLE capture = "__share_rc_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_619 = mIRLowering__lowering_counters(rtoc_self_view);
      mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_619) }}";
      zig_base = mIRLowering__rc_payload_zig_type(rtoc_self_view, wrapped);
      MUTABLE shared_payload =     IF type__shared?(wrapped) THEN
        RcRetain{ source: Emittable{ Ident: COPY Ident{ name: capture, lowered_node_id: NIL, ownership_consumption: NIL } }, zig_base: zig_base, func: "arcRetain", lowered_node_id: NIL, ownership_consumption: NIL }
      ELSE
        SharePromote{ source: Emittable{ Ident: COPY Ident{ name: capture, lowered_node_id: NIL, ownership_consumption: NIL } }, zig_base: COPY zig_base, alloc: :heap, lowered_node_id: NIL, ownership_consumption: NIL }
      END;
      MUTABLE shared = IfOptional{ optional: COPY source, capture: capture, then_expr: COPY shared_payload, else_expr: Emittable{ Lit: COPY Lit{ value: "null", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
      shared.result_type = TRY (type__from_node_mut(node, "SHARE optional result"));
      IF type__shared?(wrapped) THEN
        RETURN Emittable{ IfOptional: COPY shared };
      END
      RETURN TRY (mIRLowering__with_ownership_consumption(rtoc_self_view, Emittable{ IfOptional: COPY shared }, mIRLowering__mir_ident_names(rtoc_self_view, source), "MIR::IfOptional(SHARE)", :owned_sink, :heap));
    END
    zig_base = mIRLowering__rc_payload_zig_type(rtoc_self_view, source_ti);
    IF type__shared?(source_ti) THEN
      RETURN Emittable{ RcRetain: COPY RcRetain{ source: COPY TRY (mIRLowering__lower(&rtoc_self_view, node.value)), zig_base: zig_base, func: "arcRetain", lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF type__multiowned?(source_ti) THEN
      source = TRY (mIRLowering__lower(&rtoc_self_view, node.value));
      RETURN Emittable{ SharePromote: COPY castEmittableToSharePromote(TRY (mIRLowering__with_ownership_consumption(rtoc_self_view, Emittable{ SharePromote: COPY SharePromote{ source: COPY source, zig_base: COPY zig_base, alloc: :heap, lowered_node_id: NIL, ownership_consumption: NIL } }, mIRLowering__mir_ident_names(rtoc_self_view, source), "MIR::SharePromote", :owned_sink, :heap))) };
    END
    source = TRY (mIRLowering__lower(&rtoc_self_view, node.value));
    RETURN Emittable{ CapWrap: COPY castEmittableToCapWrap(TRY (mIRLowering__with_ownership_consumption(rtoc_self_view, Emittable{ CapWrap: COPY CapWrap{ inner: COPY source, zig_base: COPY zig_base, strategy: :own_only, sync_fn: NIL, sync_type: NIL, own_fn: "arcCreate", alloc: :heap, lowered_node_id: NIL, ownership_consumption: NIL } }, mIRLowering__mir_ident_names(rtoc_self_view, source), "MIR::CapWrap", :owned_sink, :heap))) };
}
END
PRIVATE FN mIRLowering__lower_cap_wrap(MUTABLE self: MIRLowering, MUTABLE node: CapabilityWrap) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF ((node.ownership == :node) OR (node.ownership == :shared_node)) THEN
      MUTABLE node_value = TRY (mIRLowering__lower(&rtoc_self_view, node.value));
      RETURN Emittable{ MIRMethodCall: COPY TRY (mIRLowering__node_create_mir(rtoc_self_view, CAST(node_value AS Emittable), TRY (aST__full_type_mut(node)), node.value)) };
    END
    MUTABLE inner_type = &node.value.full_type_mut();
    MUTABLE inner = mIRLowering__with_decl_alloc(rtoc_self_view, :heap, %() USE(inner_type, node, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_621 = mIRLowering__with_sink_type(rtoc_self_view, inner_type, %() USE(inner_type, node, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_620 = mIRLowering__with_expected_type(rtoc_self_view, inner_type, %() USE(inner_type, node, MUTABLE rtoc_self_view) -> {
    MUTABLE value = TRY (mIRLowering__lower(&rtoc_self_view, node.value));
    TRY (mIRLowering__place_value_for_destination(rtoc_self_view, value, node.value, :heap, inner_type))
    });
    rtoc_lambda_result_620
    });
    rtoc_lambda_result_621
    });
    IF ((TRY (type__string?(inner_type)) AND inner_type.rodata?()) AND !(ownershipEffect__of(inner).produces_owned)) THEN
      inner = DupeSlice{ source: COPY inner, alloc: :heap, lowered_node_id: NIL, ownership_consumption: NIL };
    END
    MUTABLE base_type = COPY CAST(node.value.resolved_type() AS String);
    MUTABLE zig_base = mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ StringValue: COPY base_type });
    MUTABLE alloc = :heap;
    MUTABLE is_atomic_ptr = capabilityWrap__atomic_ptr?(node);
    MUTABLE sync_fn: ?String = mIRLowering__sync_wrap_constructor(rtoc_self_view, node.sync, is_atomic_ptr);
    MUTABLE sync_type: ?String = mIRLowering__sync_wrap_type(rtoc_self_view, node.sync, zig_base, is_atomic_ptr);
    MUTABLE own_fn = PARTIAL MATCH node.ownership START
      :shared -> (IF capabilityWrap__atomic?(node) THEN
          NIL
        ELSE
          "arcCreate"
        END),
      :multiowned -> (IF capabilityWrap__atomic?(node) THEN
          NIL
        ELSE
          "rcCreate"
        END),
      DEFAULT -> NIL
    END;
    MUTABLE strategy =   IF capabilityWrap__local_storage_wrap?(node) THEN
      :local
    ELSE_IF ((sync_fn != NIL) AND own_fn) THEN
      :both
    ELSE_IF sync_fn THEN
      :sync_only
    ELSE_IF own_fn THEN
      :own_only
    ELSE
      :passthrough
    END;
