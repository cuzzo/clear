    MUTABLE spawn = mIRLowering__fiber_spawn_call_plan(rtoc_self_view, mIRLowering__runtime_binding_name(rtoc_self_view), names.ctx_type, names.ctx_var, profiled, PinMode{ SymbolValue: :local });
    MUTABLE profile = ProfileTaskSite{ site_id: site_id, line: ((IF node.token() != NIL THEN
      (node.token()).line()
