      &steps.append(BgBodyStep{ expr: COPY _, binding: NIL });
    END
    END
    RETURN steps;
}
END
PRIVATE FN mIRLowering__lower_bg_body_steps(MUTABLE self: MIRLowering, node: BgBlock, id: MIRLoweringGeneratedId, is_void: Bool, inner_t: Type) RETURNS BgBodyMaterialization
  REQUIRES self: LOCAL
