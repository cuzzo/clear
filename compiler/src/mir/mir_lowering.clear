    sig = UNWRAP (type__function_signature(sig));
    MUTABLE fn_name = "_lambda_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_417 = mIRLowering__lowering_counters(rtoc_self_view);
    mIRLoweringCounters__next_lambda_id(&rtoc_mutable_receiver_417) }}";
    MUTABLE params_list = sig.params();
