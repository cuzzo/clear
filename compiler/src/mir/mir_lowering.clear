PRIVATE FN mIRLowering__lower_cap_wrap(MUTABLE self: MIRLowering, MUTABLE node: CapabilityWrap) RETURNS !Emittable ->
    IF ((node.ownership == :node) OR (node.ownership == :shared_node)) THEN
