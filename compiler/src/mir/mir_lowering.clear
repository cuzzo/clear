PRIVATE FN mIRLowering__non_empty_hash_literal(MUTABLE self: MIRLowering, node: HashLit, plan: HashLiteralPlan, capability: HashLiteralCapabilityPlan) RETURNS !MIRBlockExpr
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE items: []Emittable = ( { MUTABLE rtoc_empty_list_639: []Emittable = List[]; rtoc_empty_list_639 } );
    MUTABLE literal_id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_640 = mIRLowering__lowering_counters(rtoc_self_view);
    mIRLoweringCounters__next_block_expr_id(&rtoc_mutable_receiver_640) };
    MUTABLE label = "__hm_blk_${literal_id}";
    MUTABLE hm_name = "__hm_${literal_id}";
    MUTABLE alloc_expr = mIRLowering__hash_literal_allocator_expr(rtoc_self_view, plan);
    &items.append(Emittable{ Let: COPY Let{ name: COPY hm_name, init: Emittable{ StructInit: COPY (capability.init_value OR_ELSE mIRLowering__hash_literal_init_struct(rtoc_self_view, capability.zig_type, plan.alloc, TRUE)) }, mutable: TRUE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
    FOR rtoc_key IN node.pairs.keys() DO
    MUTABLE val_node: Locatable = COPY UNWRAP (node.pairs[rtoc_key]);
    MUTABLE outer_pending = COPY mIRLowering__function_state(rtoc_self_view).pending_stmts;
    MUTABLE rtoc_writer_receiver_642: FunctionState = mIRLowering__function_state(rtoc_self_view);
    rtoc_writer_receiver_642.pending_stmts = ( { MUTABLE rtoc_empty_list_641: []Stmt = List[]; rtoc_empty_list_641 } );
    MUTABLE put_stmt = mIRLowering__hash_literal_put_stmt(&rtoc_self_view, rtoc_key, val_node, plan, alloc_expr, hm_name);
    MUTABLE pair_stmts = COPY mIRLowering__function_state(rtoc_self_view).pending_stmts;
    MUTABLE rtoc_writer_receiver_643: FunctionState = mIRLowering__function_state(rtoc_self_view);
    rtoc_writer_receiver_643.pending_stmts = outer_pending;
    &items.append(({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_644: ?ExprStmt = NIL;
      IF (pair_stmts.length() == 0) THEN
        rtoc_ternary_value_644 = put_stmt;
      ELSE
        rtoc_ternary_value_644 = MIRBlockExpr{ label: NIL, body: COPY (pair_stmts + [put_stmt]), lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
      END
      rtoc_ternary_value_644? }));
    END
    MUTABLE result = mIRLowering__hash_literal_result(rtoc_self_view, Emittable{ Ident: COPY Ident{ name: hm_name, lowered_node_id: NIL, ownership_consumption: NIL } }, plan, capability);
    IF hashLiteralCapabilityPlan__wraps_result?(capability) THEN
      MUTABLE wrapped_name = "__hm_wrapped_${literal_id}";
      &items.append(Emittable{ Let: COPY Let{ name: COPY wrapped_name, init: COPY result, mutable: FALSE, annotation: COPY TRY (type__new(TypeConstructionInput{ Type: COPY plan.type_info })), suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
      result = Emittable{ Ident: COPY Ident{ name: wrapped_name, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    &items.append(Emittable{ BreakStmt: COPY BreakStmt{ label: COPY label, value: COPY result, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    MUTABLE block = MIRBlockExpr{ label: label, body: Body{ ArrayValue: items |> SELECT castEmittableToLocatable(_) }, lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
    block.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY plan.type_info }));
    RETURN block;
}
END
PRIVATE FN mIRLowering__hash_literal_allocator_expr(self: MIRLowering, plan: HashLiteralPlan) RETURNS !MIRMethodCall
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: mIRLowering__runtime_binding_name(rtoc_self_view), lowered_node_id: NIL, ownership_consumption: NIL } }, method: COPY hashLiteralPlan__allocator_method(plan), args: ( { MUTABLE rtoc_empty_list_645: []Any = List[]; rtoc_empty_list_645 } ), try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
