PRIVATE FN mIRLowering__bg_capture_materialization(self: MIRLowering, names: BgLoweringNames, analysis: ?CaptureAnalysis, captured: {String}Type, capture_close_plans: {String}ResourceClosePlan, pointer_captures: [Set]String) RETURNS !BgCaptureMaterialization
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE promoted_names: {String}String = {};
    MUTABLE outer_capture_map = mIRLowering__fiber_capture_source_overrides(rtoc_self_view, analysis, (mIRLowering__capture_state(rtoc_self_view).do_capture_map OR_ELSE {}));
    MUTABLE capture_analysis = (analysis OR_ELSE CaptureAnalysis{ captures: COPY captured, pointer_captures: COPY pointer_captures, has_local: FALSE, has_rc: FALSE, has_shared: FALSE, has_sharded: FALSE, has_affine_locked: FALSE, has_outer_ref: FALSE, has_non_escaping_capture: FALSE, capture_symbols: {}, close_plans: {}, string_captures: Set[], resource_captures: Set[], site_moved: Set[], site_copied: Set[], strategies: {}, move_mark_names: Set[], alloc_mark_entries: {} });
    MUTABLE caps = TRY (fiberCtxBuilder__build(capture_analysis, "__ctx_${names.id.toString()}", promoted_names, names.alloc_var, names.id, outer_capture_map, mIRLowering__mir_schema_lookup(rtoc_self_view)));
    MUTABLE capture_fields = caps.specs |> SELECT {
    MUTABLE ftype: String = "";
      IF ((captureSpec__requires_setup?(_) OR promoted_names[_.name]) OR (outer_capture_map[_.name] == NIL)) THEN
        ftype = COPY _.field_type_zig;
      ELSE
        ftype = replaceFirst(_.field_type_zig, "(${_.name})", "(${outer_capture_map[_.name]})");
      END
    mIRLowering__context_field_decl(rtoc_self_view, _.name, ftype)
    };
    capture_fields = (capture_fields + mIRLowering__capture_moved_guard_fields(rtoc_self_view, caps.specs));
    MUTABLE capture_inits = ([mIRLowering__context_init_field(rtoc_self_view, Name{ SymbolValue: :inner }, Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: COPY names.promise_var, lowered_node_id: NIL, ownership_consumption: NIL } }, field: "inner", lowered_node_id: NIL, ownership_consumption: NIL } }), mIRLowering__context_init_field(rtoc_self_view, Name{ SymbolValue: :alloc }, Emittable{ Ident: COPY Ident{ name: COPY names.alloc_var, lowered_node_id: NIL, ownership_consumption: NIL } })] + (caps.specs |> SELECT {
    MUTABLE outer_ref: ?String = COPY outer_capture_map[_.name];
    MUTABLE init_val_branch_value: ?Ident = NIL;
      IF (((captureSpec__requires_setup?(_) OR promoted_names[_.name]) OR (outer_ref == NIL)) OR pointer_captures.contains?(_.name)) THEN
        init_val_branch_value = castEmittableToIdent(_.init_value_mir);
      ELSE
        init_val_branch_value = Ident{ name: COPY outer_ref, lowered_node_id: NIL, ownership_consumption: NIL };
      END
    MUTABLE init_val: Ident = init_val_branch_value?;
    mIRLowering__context_init_field(rtoc_self_view, Name{ StringValue: COPY _.name }, Emittable{ Ident: COPY init_val })
    }));
    MUTABLE setup_stmts = mIRLowering__capture_setup_stmts(rtoc_self_view, caps.specs);
    MUTABLE fresh_heap_cleanup_names = caps.specs |> SELECT:? (IF capture_close_plans.contains?(_.name) THEN NIL ELSE IF captureSpec__needs_moved_guard?(_) THEN
      _.name
    ELSE
      NIL
    END END) |> WHERE _ != NIL;
    MUTABLE capture_finalizers = caps.specs |> SELECT:? (IF capture_close_plans.contains?(_.name) THEN NIL ELSE captureSpec__finalizer_mir_for(_, "__ctx_${names.id.toString()}") END) |> WHERE _ != NIL;
    MUTABLE capture_frees = captured |> SELECT:? {
    MUTABLE close_plan: ?ResourceClosePlan = COPY capture_close_plans[_._0];
