PUB UNION MIRLoweringLoweredMir { Emittable: Emittable, ArrayValue: []Emittable }
# Ruby writes `Array(packet.mir)`: one node or many, always read back as a list.
PUB FN loweredMir__nodes(value: MIRLoweringLoweredMir) RETURNS []Emittable ->
  PARTIAL MATCH value START
    MIRLoweringLoweredMir.ArrayValue AS item -> RETURN COPY item;,
    MIRLoweringLoweredMir.Emittable AS item -> RETURN [COPY item];,
    DEFAULT -> RETURN List[];
  END
  RETURN List[];
END
