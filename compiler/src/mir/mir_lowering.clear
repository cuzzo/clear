    MUTABLE lock_expr = CapabilityLockTarget{ source: COPY mIRLowering__with_capability_source_mir(rtoc_self_view, context.var_node), arc_wrapped: is_arc, comptime_arc_unwrap: FALSE, lowered_node_id: NIL, ownership_consumption: NIL };
