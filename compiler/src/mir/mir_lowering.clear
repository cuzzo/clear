  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN StructInitField{ name: castNameToStringSymbol(COPY name), value: COPY value, alloc: NIL };
}
END
PRIVATE FN mIRLowering__capture_setup_stmts(self: MIRLowering, specs: []CaptureSpec) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN specs |> UNNEST _.setup_mir;
}
END
PRIVATE FN mIRLowering__capture_cleanup_stmts(self: MIRLowering, specs: []CaptureSpec, receiver: String) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN specs |> SELECT:? TRY (captureSpec__cleanup_mir_for(_, receiver)) |> WHERE _ != NIL;
}
END
PRIVATE FN mIRLowering__fiber_capture_source_overrides(self: MIRLowering, analysis: ?CaptureAnalysis, base: {String}String) RETURNS !{String}String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE out = COPY base;
    IF analysis EXISTS AS analysis_value THEN
      FOR rtoc_key IN analysis_value.capture_symbols.keys() DO
    MUTABLE sym: SymbolEntry@multiowned = COPY UNWRAP (analysis_value.capture_symbols[rtoc_key]);
    MUTABLE decl: ?SymbolEntryRegInput = NIL;
    IF sym != NIL THEN
          decl = COPY (sym?).reg;
        END
    MUTABLE mapped: ?String = IF decl != NIL THEN
          (TRY (functionState__decl_zig_names(mIRLowering__function_state(rtoc_self_view))))[decl.object_id()]
        ELSE
          NIL
        END;
    IF mapped EXISTS AS mapped_value THEN
          out[rtoc_key] = (out[rtoc_key] OR_ELSE mapped_value);
    END
      END
      RETURN out;
    ELSE
      RETURN out;
    END
}
END
PRIVATE FN mIRLowering__finalized_boundary_body_for_emit(self: MIRLowering, body: []Emittable) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
  MUTABLE prev_alloc_names = COPY mIRLowering__function_state(rtoc_self_view).lowered_alloc_names;
  MUTABLE prev_guarded_names = COPY mIRLowering__function_state(rtoc_self_view).lowered_guarded_cleanup_names;
  DEFER {
  MUTABLE rtoc_writer_receiver_496: FunctionState = mIRLowering__function_state(rtoc_self_view);
  rtoc_writer_receiver_496.lowered_alloc_names = prev_alloc_names;
  MUTABLE rtoc_writer_receiver_497: FunctionState = mIRLowering__function_state(rtoc_self_view);
  rtoc_writer_receiver_497.lowered_guarded_cleanup_names = prev_guarded_names;
  }
  RETURN TRY (mIRLowering__append_ownership_transfers_for_mir_body(rtoc_self_view, body));
}
END
PRIVATE FN mIRLowering__capture_ownership_mirror_node?(self: MIRLowering, node: Emittable, receiver: String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(((node IS_A AllocMark OR node IS_A Cleanup) OR node IS_A ErrCleanup)) THEN
      RETURN FALSE;
    END
    RETURN (CAST(node.name() AS String)).startsWith?("${receiver}.");
}
END
PRIVATE FN mIRLowering__boundary_capture_fact(self: MIRLowering, name: String, symbol: ?SymbolEntry, captured_type: ?Type) RETURNS BoundaryCaptureFact
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE storage: ?String@symbol = mIRLowering__boundary_capture_storage(rtoc_self_view, symbol, captured_type);
    MUTABLE sync: ?String@symbol = (IF symbol != NIL THEN
      symbolEntry__sync(symbol)
    ELSE
      NIL
    END);
    IF captured_type != NIL THEN
      sync = type__sync(captured_type);
    END
    MUTABLE ownership: ?String@symbol = (IF symbol != NIL THEN
      symbolEntry__ownership_kind(symbol)
    ELSE
      NIL
    END);
    IF captured_type != NIL THEN
      ownership = type__ownership(captured_type);
    END
    MUTABLE forbidden: ?String@symbol = mIRLowering__boundary_capture_forbidden_reason(rtoc_self_view, symbol, captured_type);
    RETURN BoundaryCaptureFact{ name: COPY name, storage: COPY storage, sync: COPY sync, ownership: COPY ownership, parallel_safe: (forbidden == NIL), scheduler_affine: mIRLowering__boundary_capture_scheduler_affine?(rtoc_self_view, symbol, captured_type), requires_pinned: mIRLowering__boundary_capture_requires_pinned?(rtoc_self_view, symbol, captured_type), forbidden_reason: COPY forbidden };
}
END
PRIVATE FN mIRLowering__boundary_capture_forbidden_reason(self: MIRLowering, symbol: ?SymbolEntry, captured_type: ?Type) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((IF symbol != NIL THEN symbol ELSE captured_type END)) THEN
      RETURN NIL;
    END
    IF mIRLowering__boundary_capture_local?(rtoc_self_view, symbol, captured_type) THEN
      RETURN :local_scheduler_affinity;
    END
    IF mIRLowering__boundary_capture_multiowned_rc?(rtoc_self_view, symbol, captured_type) THEN
      RETURN :non_atomic_rc;
    END
    IF mIRLowering__boundary_capture_shared_arc?(rtoc_self_view, symbol, captured_type) THEN
      RETURN NIL;
    END
    IF mIRLowering__boundary_capture_locked?(rtoc_self_view, symbol, captured_type) THEN
      RETURN :affine_locked;
    END
    IF mIRLowering__boundary_capture_write_locked?(rtoc_self_view, symbol, captured_type) THEN
      RETURN :affine_write_locked;
    END
    IF mIRLowering__boundary_capture_versioned?(rtoc_self_view, symbol, captured_type) THEN
      RETURN :affine_versioned;
    END
    MUTABLE type_info = (IF captured_type != NIL THEN captured_type ELSE (IF symbol != NIL THEN
      symbolEntry__type(symbol)
    ELSE
      NIL
    END) END);
    IF type_info THEN
      RETURN TRY (type__parallel_boundary_forbidden_reason(type_info, CAST(mIRLowering__mir_schema_lookup(rtoc_self_view) AS FN(String@symbol) -> ?TypeSchemaLookupResult)));
    END
    RETURN NIL;
}
END
PRIVATE FN mIRLowering__boundary_capture_scheduler_affine?(self: MIRLowering, symbol: ?SymbolEntry, captured_type: ?Type) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((IF symbol != NIL THEN symbol ELSE captured_type END)) THEN
      RETURN FALSE;
    END
    IF mIRLowering__boundary_capture_local?(rtoc_self_view, symbol, captured_type) THEN
      RETURN TRUE;
    END
    IF mIRLowering__boundary_capture_shared_arc?(rtoc_self_view, symbol, captured_type) THEN
      RETURN FALSE;
    END
    RETURN ((mIRLowering__boundary_capture_locked?(rtoc_self_view, symbol, captured_type) OR mIRLowering__boundary_capture_write_locked?(rtoc_self_view, symbol, captured_type)) OR mIRLowering__boundary_capture_versioned?(rtoc_self_view, symbol, captured_type));
