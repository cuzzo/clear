PRIVATE FN mIRLowering__direct_slice_backed_expr?(self: MIRLowering, ast_node: Locatable, type_info: Type) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF type__fixed?(type_info) THEN
      RETURN TRUE;
    END
    IF ast_node IS_A GetField AS get_field THEN
      RETURN TRUE;
    END
    IF ast_node IS_A Identifier AS identifier THEN
      RETURN mIRLowering__current_function_param_name?(rtoc_self_view, identifier__name(identifier));
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN mIRLowering__direct_index_get(self: MIRLowering, target: Emittable, index_value: Emittable, ast_node: Locatable, type_info: Type) RETURNS !?IndexGet
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE ti = TRY (type__new(TypeConstructionInput{ Type: COPY type_info }));
    IF type__list_collection?(ti) THEN
      RETURN NIL;
    END
    IF !(mIRLowering__direct_slice_backed_expr?(rtoc_self_view, ast_node, ti)) THEN
      RETURN NIL;
    END
    MUTABLE cast_idx = MIRCast{ expr: COPY index_value, target_type: "usize", method: :intCast, lowered_node_id: NIL, ownership_consumption: NIL };
    RETURN IndexGet{ object: COPY target, index: Emittable{ MIRCast: COPY cast_idx }, lowered_node_id: NIL, ownership_consumption: NIL };
}
END
PRIVATE FN mIRLowering__lower_direct_length(MUTABLE self: MIRLowering, node: Node) RETURNS !?MIRCast
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE recv_ast = IF node IS_A MethodCall THEN
      node.object()
    ELSE
      node.args().first()
    END;
    IF !(recv_ast) THEN
      RETURN NIL;
    END
    MUTABLE recv_ti = TRY (type__from_node_mut(recv_ast, "direct length"));
    MUTABLE ti = TRY (type__new(TypeConstructionInput{ Type: COPY recv_ti }));
    IF TRY (type__direct_indexable_collection?(ti)) THEN
      RETURN NIL;
    END
    MUTABLE recv = mIRLowering__rc_payload_value(rtoc_self_view, CAST(TRY (mIRLowering__lower(&rtoc_self_view, recv_ast)) AS Emittable), recv_ti);
    IF mIRLowering__mir_allocates?(rtoc_self_view, recv) THEN
      recv = mIRLowering__hoist_alloc(rtoc_self_view, recv, recv_ast);
    END
    IF !(TRY (type__string?(ti))) THEN
      RETURN NIL;
    END
    RETURN MIRCast{ expr: Emittable{ ListLength: COPY ListLength{ expr: COPY TRY (mIRLowering__widen_symbol_to_bytes(rtoc_self_view, recv, recv_ast)), lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: "i64", method: :intCast, lowered_node_id: NIL, ownership_consumption: NIL };
}
END
PRIVATE FN mIRLowering__rc_payload_value(self: MIRLowering, value: Emittable, type_info: Type) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(TRY (type__any_rc?(type_info))) THEN
      RETURN COPY value;
    END
    IF (type__optional?(type_info) OR type__error_union?(type_info)) THEN
      RETURN COPY value;
    END
    RETURN Emittable{ Deref: COPY Deref{ expr: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ FieldGet: COPY FieldGet{ object: COPY value, field: "ctrl", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "data", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } };
}
END
FN mIRLowering__emit_expr(self: MIRLowering, node: Emittable) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE emitter = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_164 = mIRLowering__runtime_state(rtoc_self_view);
    mIRLoweringRuntimeState__emitter_mut(&rtoc_mutable_receiver_164) };
    emitter.rt_name = mIRLowering__runtime_binding_name(rtoc_self_view);
    RETURN TRY (mIREmitter__emit(&emitter, node));
}
END
PRIVATE FN mIRLowering__try_catch_with_provenance(self: MIRLowering, left: Emittable, catch_body: Emittable, capture: ?String, fallback: ?MIRLoweringFallback = NIL) RETURNS !TryCatch
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE stripped = mIRLowering__strip_try(rtoc_self_view, left);
    MUTABLE out = TryCatch{ expr: COPY stripped, catch_body: COPY catch_body, capture: COPY capture, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    IF (respondsTo?(stripped, "result_type") AND stripped.result_type()) THEN
      out.result_type = TRY (type__new(stripped.result_type()));
    ELSE_IF ((fallback != NIL) AND respondsTo?(fallback, "full_type!")) THEN
      out.result_type = TRY (type__new(&fallback.full_type_mut("try-catch fallback result")));
    END
    RETURN out;
}
END
PRIVATE FN mIRLowering__strip_try(self: MIRLowering, mir_node: Emittable) RETURNS Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF respondsTo?(mir_node, "without_try") THEN
      RETURN mir_node.without_try();
    ELSE
      RETURN COPY mir_node;
    END
}
END
PRIVATE FN mIRLowering__emit_stmts_zig(self: MIRLowering, mir_nodes: []Emittable, indent: String = "") RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (mir_nodes |> SELECT:? { MUTABLE rtoc_value_block_marker = 0; MUTABLE code: ?String = mIRLowering__emit_expr(rtoc_self_view, _); (IF !(code) THEN NIL ELSE { MUTABLE rtoc_value_block_marker = 0; MUTABLE stripped = code.trim(); (  IF mIRLowering__zig_statement_semicolon_required?(rtoc_self_view, _, stripped) THEN
      "${indent}${code};"
    ELSE
      "${indent}${code}"
    END) } END) } |> WHERE _ != NIL).join("\n");
}
