FN mIRLowering__append_block_result_transfer_mut(MUTABLE self: MIRLowering, node: Emittable, body: []Emittable, MUTABLE state: OwnershipFinalizationContext) RETURNS !Void ->
    IF node IS_A BreakStmt AS break_stmt THEN
