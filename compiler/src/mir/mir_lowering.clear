PRIVATE FN mIRLowering__lower_union_def(MUTABLE self: MIRLowering, MUTABLE node: UnionDef) RETURNS !MIRLoweringLoweredMir ->
    MUTABLE rtoc_mutable_receiver_136 = mIRLowering__lowering_schemas(&self);
