END
PRIVATE FN mIRLowering__attach_explicit_move_consumption_mut(MUTABLE self: MIRLowering, MUTABLE call: Call, ast_args: []Locatable, mir_args: []Emittable, source: String, contract: ?CallableContract) RETURNS !Void ->
