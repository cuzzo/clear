    AstIdentifierSearchNode.StubDecl AS cast_payload -> RETURN Locatable{ StubDecl: COPY cast_payload };,
    AstIdentifierSearchNode.Drop AS cast_payload -> RETURN Locatable{ Drop: COPY cast_payload };,
    AstIdentifierSearchNode.SuppressCleanup AS cast_payload -> RETURN Locatable{ SuppressCleanup: COPY cast_payload };,
    AstIdentifierSearchNode.Return AS cast_payload -> RETURN Locatable{ Return: COPY cast_payload };,
    AstIdentifierSearchNode.ReassignCleanup AS cast_payload -> RETURN Locatable{ ReassignCleanup: COPY cast_payload };,
    AstIdentifierSearchNode.FieldCleanup AS cast_payload -> RETURN Locatable{ FieldCleanup: COPY cast_payload };,
    AstIdentifierSearchNode.FunctionDef AS cast_payload -> RETURN Locatable{ FunctionDef: COPY cast_payload };,
    AstIdentifierSearchNode.WithBlock AS cast_payload -> RETURN Locatable{ WithBlock: COPY cast_payload };,
    AstIdentifierSearchNode.SelectOp AS cast_payload -> RETURN Locatable{ SelectOp: COPY cast_payload };,
    AstIdentifierSearchNode.WhereOp AS cast_payload -> RETURN Locatable{ WhereOp: COPY cast_payload };,
    AstIdentifierSearchNode.IndexOp AS cast_payload -> RETURN Locatable{ IndexOp: COPY cast_payload };,
