PRIVATE FN mIRLowering__unit_variant_constructor(self: MIRLowering, node: GetField) RETURNS !?StructInit
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE target_node = COPY node.target;
    IF target_node IS_A Identifier AS identifier THEN
      MUTABLE schema = (TRY (mIRLowering__union_schemas(rtoc_self_view)))[symbol(identifier__name(identifier))];
      IF !(schema IS_A UnionSchema@multiowned) THEN
        RETURN NIL;
      END
      MUTABLE field_key: ?MIRLoweringExpressionsReturnValue = mIRLowering__union_variant_key(rtoc_self_view, schema, node.field);
      IF field_key EXISTS AS field_key_value THEN
        MUTABLE var_data = schema.variants()[field_key_value];
        IF schemas__inline_struct?(var_data) THEN
          RETURN NIL;
        END
        RETURN StructInit{ zig_type: identifier__name(identifier), fields: [CAST({:name: CAST(node.field AS String), :value: VoidLiteral{ lowered_node_id: NIL, ownership_consumption: NIL }} AS Any)], lowered_node_id: NIL, ownership_consumption: NIL };
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN mIRLowering__field_access_plan(self: MIRLowering, MUTABLE node: GetField, target: Emittable) RETURNS !FieldAccessPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE target_node = COPY node.target;
    MUTABLE ti = TRY (type__from_node_mut(target_node, "field target"));
    MUTABLE rc_map = (mIRLowering__capability_state(rtoc_self_view).rc_unwrap_map OR_ELSE {});
    MUTABLE locked_map = (mIRLowering__capability_state(rtoc_self_view).locked_unwrap_map OR_ELSE {});
    MUTABLE is_rc_unwrapped: Bool = FALSE;
    IF target_node IS_A Identifier AS identifier THEN
      is_rc_unwrapped = rc_map.contains?(identifier__name(identifier));
    ELSE
      is_rc_unwrapped = FALSE;
    END
    MUTABLE is_locked_unwrapped: Bool = FALSE;
    IF target_node IS_A Identifier AS identifier THEN
      is_locked_unwrapped = locked_map.contains?(identifier__name(identifier));
    ELSE
      is_locked_unwrapped = FALSE;
    END
    MUTABLE target_sync =   IF target_node IS_A OptionalUnwrap THEN
      (IF target_node.target().symbol() != NIL THEN
      (target_node.target().symbol()).sync()
    ELSE
      NIL
    END)
    ELSE
      (IF target_node.symbol() != NIL THEN
      (target_node.symbol()).sync()
    ELSE
      NIL
    END)
    END;
    target_sync = (target_sync OR (&target_node.full_type_mut("field target capability")).sync());
    MUTABLE path = mIRLowering__field_access_path(rtoc_self_view, ti, target_sync, &is_rc_unwrapped, &is_locked_unwrapped);
    IF ((((path == :direct) AND target_node IS_A Identifier) AND ((target_node.symbol() != NIL) AND ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_567 = ((target_node.symbol())?);
    symbolEntry__carrier_contract(rtoc_local_receiver_567) } == :monomorphic))) AND !(is_rc_unwrapped)) THEN
      path = :comptime_ctrl_data;
    END
    MUTABLE target_type_sym = symbol((CAST(type__resolved(ti) AS String)));
    MUTABLE union_schema = (TRY (mIRLowering__union_schemas(rtoc_self_view)))[target_type_sym];
    MUTABLE union_variants = IF union_schema IS_A UnionSchema@multiowned THEN
      union_schema.variants()
    ELSE
      NIL
    END;
    MUTABLE field_str: String = "";
    IF (node.tuple_position == NIL) THEN
      field_str = COPY CAST(node.field AS String);
    ELSE
      field_str = "@\"${UNWRAP (node.tuple_position).toString()}\"";
    END
    MUTABLE union_payload = (TRUE AND (((union_variants.key?(node.field) OR union_variants.key?(field_str)) OR union_variants.key?(CAST(symbol(field_str) AS String)))));
    RETURN FieldAccessPlan{ target: COPY target, field: COPY field_str, path: COPY path, union_payload: (union_payload == TRUE), union_payload_zig: COPY IF union_payload THEN
      TRY (type__zig_type(ti))
    ELSE
      NIL
    END, indirect: ((node.indirect_field == TRUE) AND !(type__optional?((&node.full_type_mut("indirect field access"))))) };
}
END
PRIVATE FN mIRLowering__field_access_path(self: MIRLowering, type_info: Type, target_sync: ?String@symbol, MUTABLE is_rc_unwrapped: Bool, MUTABLE is_locked_unwrapped: Bool) RETURNS String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (((type__multiowned?(type_info) OR type__shared?(type_info))) AND !(is_rc_unwrapped)) THEN
      RETURN :ctrl_data;
    END
    IF ((((target_sync == :locked) OR (target_sync == :write_locked))) AND !(is_locked_unwrapped)) THEN
      RETURN :ctrl_data;
    END
    IF ((target_sync == :always_mutable) AND !(is_locked_unwrapped)) THEN
      RETURN :data;
    END
    RETURN :direct;
}
END
PRIVATE FN mIRLowering__or_else_exit_facts(self: MIRLowering, ex: OrElseExit, line: Int64) RETURNS !OrElseExitFacts
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE kind: ?String = NIL;
    MUTABLE error_name: ?String = NIL;
    MUTABLE name_id: ?Int64 = NIL;
    MUTABLE clear_type: Bool = FALSE;
    MUTABLE explicit_error_name = ex.error_name;
    IF ex.kind THEN
      kind = COPY (ex.kind OR_ELSE "");
      IF explicit_error_name THEN
        error_name = explicit_error_name;
        name_id = TRY (aST__id_of_type(type__to_sym(explicit_error_name)));
      ELSE
        clear_type = TRUE;
      END
    ELSE_IF (explicit_error_name AND TRY (aST__error_type?(type__to_sym(explicit_error_name)))) THEN
      kind = COPY CAST((TRY (aST__kind_of_type(type__to_sym(explicit_error_name)))) AS String);
      error_name = explicit_error_name;
      name_id = TRY (aST__id_of_type(type__to_sym(explicit_error_name)));
    END
    RETURN OrElseExitFacts{ kind: COPY kind, error_name: COPY error_name, name_id: name_id, clear_type: clear_type, has_message: !((ex.message == NIL)), line: line.toInt() };
}
END
