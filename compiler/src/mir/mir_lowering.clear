PRIVATE FN mIRLowering__lower_pre_clauses(MUTABLE self: MIRLowering, node: FunctionDef) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE pre_clauses: []Any = List[];
    IF TRUE THEN
      pre_clauses = ((node.pre_clauses OR List[]));
    ELSE
      pre_clauses = ( { MUTABLE rtoc_empty_list_475: []Any = List[]; rtoc_empty_list_475 } );
    END
    IF (pre_clauses.length() == 0) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_476: []Emittable = List[]; rtoc_empty_list_476 } ) AS []Emittable);
    END
    RETURN pre_clauses |> SELECT {
    MUTABLE expr = _[:expr];
    MUTABLE source = _[:source];
    MUTABLE cond = TRY (mIRLowering__lower(&rtoc_self_view, expr));
    MUTABLE line: String = "";
      IF expr.token() THEN
        line = COPY expr.token().line();
      ELSE
        line = "0";
      END
    MUTABLE msg_text: String = "";
      IF (source AND !(source.empty?())) THEN
        msg_text = "PRE failed: ${source}";
      ELSE
        msg_text = "precondition failed";
      END
    MUTABLE msg_zig = mIRLowering__zig_string_lit(rtoc_self_view, msg_text);
    IfStmt{ cond: Emittable{ MIRUnaryOp: COPY MIRUnaryOp{ op: "!", operand: COPY cond, lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: CAST(Tuple{ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: mIRLowering__runtime_binding_name(rtoc_self_view), lowered_node_id: NIL, ownership_consumption: NIL } }, method: "setError", args: [CAST(EnumTag{ variant: "Input" } AS Any), CAST(EnumOrdinal{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "ErrorName", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "PreconditionFail", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } AS Any), CAST(Lit{ value: COPY msg_zig, lowered_node_id: NIL, ownership_consumption: NIL } AS Any), CAST(Lit{ value: COPY line, lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(4)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }, ReturnStmt{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "error", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "CheatError", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }} AS Tuple<ExprStmt, ReturnStmt>), else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL }
    };
}
END
PRIVATE FN mIRLowering__zig_string_lit(self: MIRLowering, text: String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE out = "\"";
    text.each_byte(%(b) USE(MUTABLE out) -> {
    IF (b == 92) THEN
        &out.append("\\\\");
    ELSE_IF (b == 34) THEN
        &out.append("\\\"");
    ELSE_IF (b == 10) THEN
        &out.append("\\n");
    ELSE_IF (b == 13) THEN
        &out.append("\\r");
    ELSE_IF (b == 9) THEN
        &out.append("\\t");
    ELSE_IF (b == 0 ..= 31) OR (b == 127) THEN
        &out.append(format(symbol("\\x%02x"), b));
    ELSE
        &out.append(codepointToString(b));
    END
    NIL
    });
    &out.append("\"");
    RETURN out;
}
END
PRIVATE FN mIRLowering__wrap_body_with_guard(MUTABLE self: MIRLowering, node: WithBlock, body_mir: []Emittable, with_label: ?String) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE guard_cond: ?MIRBinOp = mIRLowering__combined_guard_cond(&rtoc_self_view, node);
    IF guard_cond EXISTS AS guard_cond_value THEN
      MUTABLE guard_cond_value_mutable = COPY guard_cond_value;
      MUTABLE fail_body = mIRLowering__guard_fail_body(&rtoc_self_view, node, with_label);
      RETURN CAST([Emittable{ IfStmt: COPY IfStmt{ cond: Emittable{ MIRBinOp: COPY guard_cond_value_mutable }, then_body: COPY body_mir, else_body: fail_body, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL } }] AS []Emittable);
    ELSE
      RETURN COPY body_mir;
    END
}
END
PRIVATE FN mIRLowering__combined_guard_cond(MUTABLE self: MIRLowering, node: WithBlock) RETURNS !?MIRBinOp
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE guarded = TRY (withCapabilityPlan__guarded((TRY (capabilityPlan__require_for(node)))));
    IF (guarded.length() == 0) THEN
      RETURN NIL;
    END
    RETURN (guarded |> SELECT TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(UNWRAP (_.guard_expr))))) |> REDUCE(0) MIRBinOp{ op: "and", left: COPY acc, right: COPY _, lowered_node_id: NIL, ownership_consumption: NIL };
}
END
PRIVATE FN mIRLowering__guard_fail_body(MUTABLE self: MIRLowering, node: WithBlock, with_label: ?String) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE clause = node.lock_error_clause;
    IF !((clause AND clause.matched_types().contains?(:GuardFail))) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_477: []Emittable = List[]; rtoc_empty_list_477 } ) AS []Emittable);
    END
    RETURN mIRLowering__error_action_stmts(&rtoc_self_view, clause, with_label, node, :GuardFail, "WITH GUARD predicate failed");
}
END
PRIVATE FN mIRLowering__error_action_stmts(MUTABLE self: MIRLowering, clause: ErrorClause, with_label: ?String, with_node: WithBlock, error_type: String@symbol, default_msg: String) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE line = COPY with_node.token?.line;
    MUTABLE err_name = COPY CAST(error_type AS String);
    MUTABLE kind = (TRY (aST__kind_of_type(error_type)) OR_ELSE :Transient);
    IF (clause.action IS_A Raise) THEN
      RETURN CAST([Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: mIRLowering__runtime_binding_name(rtoc_self_view), lowered_node_id: NIL, ownership_consumption: NIL } }, method: "setError", args: [CAST(EnumTag{ variant: COPY CAST(kind AS String) } AS Any), CAST(EnumOrdinal{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "ErrorName", lowered_node_id: NIL, ownership_consumption: NIL } }, field: COPY err_name, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } AS Any), CAST(Lit{ value: COPY mIRLowering__zig_string_lit(rtoc_self_view, default_msg), lowered_node_id: NIL, ownership_consumption: NIL } AS Any), CAST(Lit{ value: COPY line, lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(4)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ ReturnStmt: COPY ReturnStmt{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "error", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "CheatError", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable);
    ELSE_IF (clause.action IS_A Exit) THEN
      MUTABLE msg_mir = TRY (mIRLowering__lower(&rtoc_self_view, castNodeToMIRLoweringLowerableStmt(UNWRAP (clause.message))));
      RETURN CAST([Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: mIRLowering__runtime_binding_name(rtoc_self_view), lowered_node_id: NIL, ownership_consumption: NIL } }, method: "setError", args: [CAST(EnumTag{ variant: COPY CAST(kind AS String) } AS Any), CAST(EnumOrdinal{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "ErrorName", lowered_node_id: NIL, ownership_consumption: NIL } }, field: COPY err_name, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } AS Any), CAST(msg_mir AS Any), CAST(Lit{ value: COPY line, lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(4)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ ReturnStmt: COPY ReturnStmt{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "error", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "CheatError", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable);
    ELSE_IF (clause.action IS_A Pass) THEN
      RETURN CAST([Emittable{ BreakStmt: COPY BreakStmt{ label: COPY with_label?, value: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable);
    ELSE_IF (clause.action IS_A Return) THEN
      RETURN CAST([Emittable{ ReturnStmt: COPY ReturnStmt{ value: COPY TRY (mIRLowering__lower(&rtoc_self_view, clause.value)), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable);
    ELSE_IF (clause.action == ErrorActionKind.Block) THEN
      RETURN (TRY (mIRLowering__lower_body(&rtoc_self_view, clause.body)) + [BreakStmt{ label: COPY with_label?, value: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }]);
    ELSE
      panic("Internal: unknown lock action {}");
    END
}
END
PRIVATE FN mIRLowering__mutable_snapshot_plan(self: MIRLowering, node: WithBlock, with_label: ?String) RETURNS !MutableSnapshotPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE lowerer: MIRLowering@multiowned = CAST(rtoc_self_view AS MIRLowering@multiowned);
    MUTABLE body_mir = TRY (mIRLowering__lower_body(&lowerer, node.body));
    MUTABLE rt_name = mIRLowering__runtime_binding_name(lowerer);
    RETURN MutableSnapshotPlan{ node: node, with_label: COPY with_label, rt_name: COPY rt_name, alloc: :heap, body_mir: COPY body_mir, retries: (IF node.lock_error_clause != NIL THEN
      node.lock_error_clause.retries()
    ELSE
      NIL
    END), capabilities: COPY mIRLowering__with_capability_specs(rtoc_self_view, node) |> SELECT mIRLowering__mutable_snapshot_cap(rtoc_self_view, lowerer, _) };
}
END
PRIVATE FN mIRLowering__mutable_snapshot_cap(self: MIRLowering, lowerer: MIRLowering, cap: CapabilityTransition) RETURNS !MutableSnapshotCap
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE var_node: CapabilityVarNode = COPY castLocatableToCapabilityVarNode(cap.var_node);
    MUTABLE sym: ?SymbolEntry = NIL;
    MATCH var_node START
      CapabilityVarNode.Identifier AS item ->
        sym = COPY item.symbol;,
      CapabilityVarNode.GetField AS item ->
        sym = COPY item.symbol;,
      CapabilityVarNode.GetIndex AS item ->
        sym = COPY item.symbol;,
    END
    MUTABLE resolved_type = COPY cap.resolved_type;
    RETURN MutableSnapshotCap{ var_node: COPY var_node, alias_name: COPY cap.alias_name, source: COPY mIRLowering__with_capability_source_mir(lowerer, var_node, TRUE), bare_type: COPY TRY (type__bare_data_type(resolved_type)), conflict_error: IF (((sym != NIL) AND symbolEntry__atomic?(sym)) AND symbolEntry__indirect?(sym)) THEN
      :AtomicConflict
    ELSE
      :MvccConflict
    END };
}
END
PRIVATE FN mIRLowering__single_mutable_snapshot_txn(MUTABLE self: MIRLowering, plan: MutableSnapshotPlan, cap: MutableSnapshotCap) RETURNS SnapshotTransaction
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE conflict_action = mIRLowering__conflict_failure_action(&rtoc_self_view, (COPY plan.node).lock_error_clause, plan.with_label, CAST(COPY COPY plan.node AS WithBlock), cap.conflict_error);
    RETURN SnapshotTransaction{ cell_unwrap: Emittable{ CapabilityUnwrap: COPY CapabilityUnwrap{ source: COPY cap.source, lowered_node_id: NIL, ownership_consumption: NIL } }, rt: COPY plan.rt_name, alloc: COPY plan.alloc, alias_name: mIRLowering__safe_with_capability_alias(rtoc_self_view, cap.alias_name), bare_type: COPY cap.bare_type, body: Body{ ArrayValue: plan.body_mir |> SELECT castEmittableToLocatable(_) }, conflict_action: Emittable{ FailureAction: COPY conflict_action }, retries: plan.retries, with_label: COPY plan.with_label, is_atomic_ptr: (cap.conflict_error == :AtomicConflict), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
}
END
PRIVATE FN mIRLowering__multi_mutable_snapshot_txn(MUTABLE self: MIRLowering, plan: MutableSnapshotPlan) RETURNS SnapshotMultiTxn
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE conflict_action = mIRLowering__conflict_failure_action(&rtoc_self_view, (COPY plan.node).lock_error_clause, plan.with_label, CAST(COPY COPY plan.node AS WithBlock), :MvccConflict);
    RETURN SnapshotMultiTxn{ cells: COPY plan.capabilities |> SELECT _.source, rt: COPY plan.rt_name, alloc: COPY plan.alloc, aliases: plan.capabilities |> SELECT mIRLowering__safe_with_capability_alias(rtoc_self_view, _.alias_name), body: Body{ ArrayValue: plan.body_mir |> SELECT castEmittableToLocatable(_) }, conflict_action: Emittable{ FailureAction: COPY conflict_action }, retries: plan.retries, with_label: COPY plan.with_label, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
}
END
PRIVATE FN mIRLowering__emit_snapshot_mutable_call(MUTABLE self: MIRLowering, node: WithBlock, with_label: ?String) RETURNS MIRLoweringReturnValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE plan = mIRLowering__mutable_snapshot_plan(rtoc_self_view, node, with_label);
    IF !(plan.capabilities[1]) THEN
      MUTABLE single_cap: ?MutableSnapshotCap = COPY plan.capabilities[0];
    END
    IF single_cap EXISTS AS single_cap_value THEN
      RETURN MIRLoweringReturnValue{ SnapshotTransaction: COPY mIRLowering__single_mutable_snapshot_txn(&rtoc_self_view, plan, single_cap_value) };
    ELSE
      RETURN MIRLoweringReturnValue{ SnapshotMultiTxn: COPY mIRLowering__multi_mutable_snapshot_txn(&rtoc_self_view, plan) };
    END
}
END
PRIVATE FN mIRLowering__conflict_failure_action(MUTABLE self: MIRLowering, clause: ?ErrorClause, with_label: ?String, with_node: WithBlock, conflict_error: String@symbol = :MvccConflict) RETURNS FailureAction
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE msg: String = "";
    IF (conflict_error == :AtomicConflict) THEN
      msg = "atomic CAS retries exhausted";
    ELSE
      msg = "MVCC commit conflict";
    END
    IF clause EXISTS AS clause_value THEN
      MUTABLE clause_value_mutable = COPY clause_value;
      RETURN mIRLowering__failure_action_from_clause(&rtoc_self_view, clause_value_mutable, with_label, with_node, conflict_error, msg);
    ELSE
      RETURN mIRLowering__default_failure_action(rtoc_self_view, with_label, with_node, conflict_error, msg);
    END
}
END
PRIVATE FN mIRLowering__lock_failure_action(MUTABLE self: MIRLowering, clause: ErrorClause, with_label: ?String, with_node: WithBlock) RETURNS FailureAction
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN mIRLowering__failure_action_from_clause(&rtoc_self_view, clause, with_label, with_node, :LockTimeout, "lock acquire timed out");
}
END
PRIVATE FN mIRLowering__default_failure_action(self: MIRLowering, with_label: ?String, with_node: WithBlock, error_type: String@symbol, default_msg: String) RETURNS !FailureAction
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN FailureAction{ kind: COPY FailureActionKind.Raise, error_type: COPY error_type, error_kind: COPY (TRY (aST__kind_of_type(error_type)) OR_ELSE :Transient), default_message: COPY default_msg, line: COPY CAST(with_node.token?.line AS String), rt_name: COPY mIRLowering__runtime_binding_name(rtoc_self_view), with_label: COPY with_label, message: NIL, return_value: NIL, body: List[] };
}
END
PRIVATE FN mIRLowering__failure_action_from_clause(MUTABLE self: MIRLowering, clause: ErrorClause, with_label: ?String, with_node: WithBlock, error_type: String@symbol, default_msg: String) RETURNS !FailureAction
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE kind = mIRLowering__clause_failure_action_kind(rtoc_self_view, clause.action);
    MUTABLE message_mir: ?Emittable = NIL;
    MUTABLE return_mir: ?Emittable = NIL;
    MUTABLE body_mir: []Emittable = ( { MUTABLE rtoc_empty_list_478: []Emittable = List[]; rtoc_empty_list_478 } );
    IF (clause.action IS_A Exit) THEN
      message_mir = CAST(TRY (mIRLowering__lower(&rtoc_self_view, castNodeToMIRLoweringLowerableStmt(UNWRAP (clause.message)))) AS Emittable);
    ELSE_IF (clause.action IS_A Return) THEN
      return_mir = CAST(TRY (mIRLowering__lower(&rtoc_self_view, clause.value)) AS Emittable);
    ELSE_IF (clause.action == ErrorActionKind.Block) THEN
      body_mir = TRY (mIRLowering__lower_body(&rtoc_self_view, clause.body));
    END
    RETURN FailureAction{ kind: COPY kind, error_type: COPY error_type, error_kind: COPY (TRY (aST__kind_of_type(error_type)) OR_ELSE :Transient), default_message: COPY default_msg, line: COPY CAST(with_node.token?.line AS String), rt_name: COPY mIRLowering__runtime_binding_name(rtoc_self_view), with_label: COPY with_label, message: COPY message_mir, return_value: COPY return_mir, body: COPY body_mir };
}
END
PRIVATE FN mIRLowering__clause_failure_action_kind(self: MIRLowering, action: ErrorActionKind) RETURNS !FailureActionKind
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (action IS_A Raise) THEN
      RETURN FailureActionKind.Raise;
    ELSE_IF (action IS_A Exit) THEN
      RETURN FailureActionKind.Exit;
    ELSE_IF (action IS_A Pass) THEN
      RETURN FailureActionKind.Pass;
    ELSE_IF (action IS_A Return) THEN
      RETURN FailureActionKind.Return;
    ELSE_IF (action == ErrorActionKind.Block) THEN
      RETURN FailureActionKind.Block;
    ELSE
      panic("Internal: unknown lock action {}");
    END
}
END
PRIVATE FN mIRLowering__build_sorted_acquire_entries(self: MIRLowering, fallible_caps: []CapabilityTransition, fallible: Bool, with_node: ?WithBlock = NIL) RETURNS ![]SortedLockAcquireEntry
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE suffix: String = "";
    IF with_node EXISTS AS with_node_value THEN
      suffix = "_${mIRLowering__stable_node_suffix(rtoc_self_view, Locatable{ WithBlock: COPY with_node_value })}";
    ELSE
      suffix = "";
    END
    RETURN {
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE rtoc_indexed_items_479: []CapabilityTransition = fallible_caps;
    MUTABLE rtoc_indexed_output_481 = [];
    MUTABLE rtoc_indexed_i_480 = 0;
    WHILE rtoc_indexed_i_480 < rtoc_indexed_items_479.length() DO
      &rtoc_indexed_output_481.append({
    MUTABLE var_node: CapabilityVarNode = castLocatableToCapabilityVarNode(rtoc_indexed_items_479[rtoc_indexed_i_480].var_node);
    MUTABLE var_name = rtoc_indexed_items_479[rtoc_indexed_i_480].target_label;
    MUTABLE alias_name = rtoc_indexed_items_479[rtoc_indexed_i_480].alias_name;
    MUTABLE resolved = rtoc_indexed_items_479[rtoc_indexed_i_480].resolved_type;
    MUTABLE source_mir = mIRLowering__with_capability_source_mir(rtoc_self_view, var_node);
    MUTABLE var_storage = rtoc_indexed_items_479[rtoc_indexed_i_480].storage;
    MUTABLE is_arc = (symbolEntry__rc_storage?(var_storage) OR (IF resolved != NIL THEN
        TRY (type__any_rc?(resolved))
      ELSE
        NIL
      END));
    MUTABLE lock_expr = CapabilityLockTarget{ source: COPY source_mir, arc_wrapped: is_arc, comptime_arc_unwrap: FALSE, lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE addr_expr = CapabilityLockAddress{ source: COPY source_mir, arc_wrapped: is_arc, lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE var_sync: ?String@symbol = rtoc_indexed_items_479[rtoc_indexed_i_480].sync;
    MUTABLE panic_method: String = "read";
    MUTABLE err_method: String = "readOrErr";
    IF (rtoc_indexed_items_479[rtoc_indexed_i_480].capability == symbol("EXCLUSIVE")) THEN
        IF (var_sync == :write_locked) THEN
          panic_method = "write";
          err_method = "writeOrErr";
        ELSE
          panic_method = "acquire";
          err_method = "acquireOrErr";
        END
    END
    SortedLockAcquireEntry{ index: rtoc_indexed_i_480, alias_name: COPY alias_name, guard_var: "__sort_guard${suffix}_${rtoc_indexed_i_480.toString()}", held_var: "__held${suffix}_${rtoc_indexed_i_480.toString()}", lock_expr: Emittable{ CapabilityLockTarget: COPY lock_expr }, address_expr: Emittable{ CapabilityLockAddress: COPY addr_expr }, method_name: COPY (IF fallible THEN
        err_method
      ELSE
        panic_method
      END) }
    });
      rtoc_indexed_i_480 = rtoc_indexed_i_480 + 1;
    END
    rtoc_indexed_output_481
    };
}
END
PRIVATE FN mIRLowering__sorted_lock_acquire(MUTABLE self: MIRLowering, fallible_caps: []CapabilityTransition, clause: ?ErrorClause, with_label: ?String, with_node: WithBlock) RETURNS SortedLockAcquire
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fallible = !((clause == NIL));
    RETURN SortedLockAcquire{ entries: COPY mIRLowering__build_sorted_acquire_entries(rtoc_self_view, fallible_caps, fallible, with_node), action: Emittable{ FailureAction: COPY UNWRAP (COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_482: ?FailureAction = NIL;
    IF clause != NIL THEN
      rtoc_ternary_value_482 = mIRLowering__lock_failure_action(&rtoc_self_view, clause, with_label, with_node);
    ELSE
      rtoc_ternary_value_482 = NIL;
    END
    rtoc_ternary_value_482? }) }, matched_types: (clause?.matched_types OR_ELSE List[]), bubble_types: (clause?.bubble_types OR_ELSE List[]), retries: clause?.retries, source_line: COPY CAST(with_node.token?.line AS String), loop_label: "__acq_sort_${mIRLowering__stable_node_suffix(rtoc_self_view, Locatable{ WithBlock: COPY with_node })}", rt_name: mIRLowering__runtime_binding_name(rtoc_self_view), fallible: fallible, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL };
}
END
PRIVATE FN mIRLowering__execution_boundary_dispatch(self: MIRLowering, parallel: ?Bool, pinned: ?Pinned) RETURNS String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF parallel EXISTS AS parallel_value THEN
      RETURN :parallel;
    END
    IF pinned EXISTS AS pinned_value THEN
      RETURN :pinned;
    END
    RETURN :local;
}
END
PRIVATE FN mIRLowering__execution_boundary_fact(self: MIRLowering, kind: String@symbol, dispatch: String@symbol, analysis: ?CaptureAnalysis) RETURNS ExecutionBoundaryFact
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE symbols: {String}SymbolEntry@multiowned = {};
    IF analysis EXISTS AS analysis_value THEN
      symbols = COPY analysis_value.capture_symbols;
    ELSE
      symbols = {};
    END
    MUTABLE captured: {String}Type = {};
    IF analysis EXISTS AS analysis_value THEN
      captured = COPY analysis_value.captures;
    ELSE
      captured = {};
    END
    MUTABLE names: []String = (((symbols.keys() + captured.keys())) |> SELECT _.toString() |> DISTINCT _ |> SELECT COPY _) |> ORDER_BY _;
    RETURN ExecutionBoundaryFact{ kind: COPY kind, dispatch: COPY dispatch, captures: COPY names |> SELECT mIRLowering__boundary_capture_fact(rtoc_self_view, _, symbols[_], captured[_]) };
}
END
PRIVATE FN mIRLowering__with_bg_fiber_body_context<Result>(self: MIRLowering, pointer_captures: [Set]String, blk: FN() -> Result) RETURNS Result
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
  MUTABLE prev_bg_ptr_caps: ?[Set]String = COPY mIRLowering__capture_state(rtoc_self_view).current_bg_pointer_captures;
  MUTABLE prev_fiber_pending = COPY mIRLowering__function_state(rtoc_self_view).pending_stmts;
  DEFER {
  MUTABLE rtoc_writer_receiver_483: FunctionState = mIRLowering__function_state(rtoc_self_view);
  rtoc_writer_receiver_483.pending_stmts = prev_fiber_pending;
  MUTABLE rtoc_writer_receiver_484: MIRLoweringCaptureState = mIRLowering__capture_state(rtoc_self_view);
  rtoc_writer_receiver_484.current_bg_pointer_captures = prev_bg_ptr_caps;
  }
  MUTABLE rtoc_writer_receiver_485: MIRLoweringCaptureState = mIRLowering__capture_state(rtoc_self_view);
  rtoc_writer_receiver_485.current_bg_pointer_captures = COPY pointer_captures;
  MUTABLE rtoc_writer_receiver_487: FunctionState = mIRLowering__function_state(rtoc_self_view);
  rtoc_writer_receiver_487.pending_stmts = ( { MUTABLE rtoc_empty_list_486: []Stmt = List[]; rtoc_empty_list_486 } );
  RETURN blk();
}
END
PRIVATE FN mIRLowering__with_stream_body_context<Result>(self: MIRLowering, local_stream: String, is_inf: Bool, close_label: ?String = NIL, inherited_alloc_names: ?[Set]String = NIL, blk: FN() -> Result) RETURNS Result
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
  MUTABLE prev_stream_local: ?String = COPY mIRLowering__capture_state(rtoc_self_view).current_stream_local;
  MUTABLE prev_stream_is_inf: ?Bool = mIRLowering__capture_state(rtoc_self_view).current_stream_is_inf;
  MUTABLE prev_close_label: ?String = COPY mIRLowering__capture_state(rtoc_self_view).current_stream_close_label;
  MUTABLE prev_inherited_alloc_names = COPY mIRLowering__capture_state(rtoc_self_view).current_fsm_inherited_alloc_names;
  DEFER {
  MUTABLE rtoc_writer_receiver_488: MIRLoweringCaptureState = mIRLowering__capture_state(rtoc_self_view);
  rtoc_writer_receiver_488.current_stream_local = prev_stream_local;
  MUTABLE rtoc_writer_receiver_489: MIRLoweringCaptureState = mIRLowering__capture_state(rtoc_self_view);
  rtoc_writer_receiver_489.current_stream_is_inf = prev_stream_is_inf;
  MUTABLE rtoc_writer_receiver_490: MIRLoweringCaptureState = mIRLowering__capture_state(rtoc_self_view);
  rtoc_writer_receiver_490.current_stream_close_label = prev_close_label;
  IF !(FALSE) THEN
      MUTABLE rtoc_writer_receiver_491: MIRLoweringCaptureState = mIRLowering__capture_state(rtoc_self_view);
      rtoc_writer_receiver_491.current_fsm_inherited_alloc_names = prev_inherited_alloc_names;
  END
  }
  MUTABLE rtoc_writer_receiver_492: MIRLoweringCaptureState = mIRLowering__capture_state(rtoc_self_view);
  rtoc_writer_receiver_492.current_stream_local = COPY local_stream;
  MUTABLE rtoc_writer_receiver_493: MIRLoweringCaptureState = mIRLowering__capture_state(rtoc_self_view);
  rtoc_writer_receiver_493.current_stream_is_inf = COPY is_inf;
  MUTABLE rtoc_writer_receiver_494: MIRLoweringCaptureState = mIRLowering__capture_state(rtoc_self_view);
  rtoc_writer_receiver_494.current_stream_close_label = COPY close_label;
  IF inherited_alloc_names EXISTS AS inherited_alloc_names_value THEN
      MUTABLE rtoc_writer_receiver_495: MIRLoweringCaptureState = mIRLowering__capture_state(rtoc_self_view);
      rtoc_writer_receiver_495.current_fsm_inherited_alloc_names = COPY inherited_alloc_names_value;
      RETURN inherited_alloc_names_value;
  END
  RETURN blk();
}
END
PRIVATE FN mIRLowering__capture_ownership_mirror_nodes(self: MIRLowering, caps: FiberCtxBuilderResult, analysis: ?CaptureAnalysis, receiver: String, close_plans: {String}ResourceClosePlan) RETURNS ![]Stmt
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE captured: {String}Type = {};
    IF analysis EXISTS AS analysis_value THEN
      captured = COPY analysis_value.captures;
    ELSE
      captured = {};
    END
    RETURN (caps.specs |> SELECT:? (IF !(captureSpec__needs_moved_guard?(_)) THEN NIL ELSE (IF close_plans.contains?(_.name) THEN NIL ELSE { MUTABLE rtoc_value_block_marker = 0; MUTABLE raw_type: ?Type = COPY captured[_.name]; { MUTABLE rtoc_value_block_marker = 0; MUTABLE type_info_branch_value: ?Type = NIL;
    IF (raw_type != NIL) THEN
      type_info_branch_value = TRY (type__new(TypeConstructionInput{ Type: COPY UNWRAP (raw_type) }));
    ELSE
      type_info_branch_value = TRY (type__new((raw_type OR_ELSE :Any)));
    END
    MUTABLE type_info: Type = type_info_branch_value?; (IF type__resource?(type_info) THEN NIL ELSE { MUTABLE rtoc_value_block_marker = 0; type_info = (captureSpec__cleanup_mirror_type(_) OR_ELSE type_info); { MUTABLE rtoc_value_block_marker = 0; MUTABLE name = "${receiver}.${_.name}"; { MUTABLE rtoc_value_block_marker = 0; MUTABLE entry = cleanupEntry__build(:uniform, :heap, TRUE); { MUTABLE rtoc_value_block_marker = 0; MUTABLE mark = AllocMark{ name: COPY name, alloc: :heap, type_info: COPY type_info, scope: :heap, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }; TRY (materializationPacket__statements((materializationPacket__markers(mark, Stmt{ Emittable: COPY CAST(Cleanup{ name: name, cleanup_entry: entry, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) })))) } } } } END) } } END) END) |> WHERE _ != NIL).flatten();
}
END
PRIVATE FN mIRLowering__capture_moved_guard_fields(self: MIRLowering, specs: []CaptureSpec) RETURNS ![]ContextFieldDecl
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN specs |> SELECT:? (IF !(captureSpec__needs_moved_guard?(_)) THEN NIL ELSE ContextFieldDecl{ name: "${_.name}_moved", type_zig: "bool", default_value: Emittable{ Lit: COPY Lit{ value: "false", lowered_node_id: NIL, ownership_consumption: NIL } } } END) |> WHERE _ != NIL;
}
END
