END
PRIVATE FN mIRLowering__with_cap_zig_target(self: MIRLowering, var_node: CapabilityVarNode, var_name: String) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF var_node IS_A GetField AS get_field THEN
      RETURN mIRLowering__build_field_path_zig(rtoc_self_view, FieldPathNode{ GetField: COPY get_field });
    ELSE
