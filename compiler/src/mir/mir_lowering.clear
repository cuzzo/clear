FN mIRLowering__consumed_binding_root(self: MIRLowering, arg: ?Locatable) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (((arg != NIL) AND (arg IS_A CopyNode)) OR ((arg != NIL) AND (arg IS_A KeepNode))) THEN
      RETURN NIL;
    END
    MUTABLE node = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_89: ?Void = NIL;
    IF ((arg != NIL) AND (arg IS_A MoveNode)) THEN
      rtoc_ternary_value_89 = arg.value();
    ELSE
      rtoc_ternary_value_89 = arg;
    END
    rtoc_ternary_value_89? };
    IF node IS_A Identifier THEN
      RETURN COPY CAST(node.name() AS String);
    END
    MUTABLE root = (aST__root_identifier(node) OR_ELSE NIL);
    IF root != NIL THEN
    IF (root?).name() != NIL THEN
      RETURN COPY CAST((((root?).name())?) AS String);
    ELSE
      RETURN NIL;
    END
    ELSE
    RETURN NIL;
    END
}
END
FN mIRLowering__discard_owned_zig_type(self: MIRLowering, node: Locatable, entry: CleanupEntry) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF entry[:zig_type] THEN
      RETURN COPY entry[:zig_type];
    END
    MUTABLE ti = TRY (type__from_node_mut(node, "discard owned type"));
    ti = TRY (type__success_type(ti));
    IF TRY (type__string?(ti)) THEN
      RETURN "[]const u8";
    END
    RETURN TRY (type__zig_type(ti));
}
END
FN mIRLowering__stamp_source_line_mut(self: MIRLowering, node: Emittable, line: ?Int64, column: ?Int64 = NIL) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF line EXISTS AS line_value THEN
      IF !(respondsTo?(node, "source_line=")) THEN
        RETURN;
      END
      node.source_line = (node.source_line() OR_ELSE line_value);
      IF (respondsTo?(node, "source_column=") AND (column != NIL)) THEN
        node.source_column = (node.source_column() OR_ELSE column);
      END
    ELSE
      RETURN;
    END
}
END
FN mIRLowering__noreturn_result_expr?(self: MIRLowering, node: ?Emittable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE resolved = IF respondsTo?(node, "resolved_type") THEN
      node.resolved_type()
    ELSE
      NIL
    END;
    IF resolved IS_A Type THEN
      resolved = resolved.resolved();
    END
    RETURN (resolved == :NoReturn);
}
END
FN mIRLowering__lower_body_with_break(MUTABLE self: MIRLowering, stmts: []MIRLoweringLowerableStmt, label: String) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (stmts.length() == 0) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_90: []Emittable = List[]; rtoc_empty_list_90 } ) AS []Emittable);
    END
    MUTABLE last_user_idx = stmts.rindex(%(s: MIRLoweringLowerableStmt) -> (((((!(s IS_A Drop) AND !(s IS_A AllocMark)) AND !(s IS_A Return)) AND !(s IS_A SuppressCleanup)) AND !(s IS_A ReassignCleanup)) AND !(s IS_A FieldCleanup)));
    IF !(last_user_idx) THEN
      RETURN TRY (mIRLowering__lower_body(&rtoc_self_view, stmts));
    END
    MUTABLE prefix_lowered = TRY (mIRLowering__lower_body(&rtoc_self_view, (stmts.substr(0, (last_user_idx - 0)) OR_ELSE List[])));
    MUTABLE result_stmt = COPY UNWRAP (stmts[last_user_idx]);
    MUTABLE result_mir, pending = mIRLowering__lower_head(rtoc_self_view, %() USE(result_stmt, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_91 = TRY (mIRLowering__lower(&rtoc_self_view, result_stmt));
    rtoc_lambda_result_91
    });
    MUTABLE suffix_lowered = TRY (mIRLowering__lower_body(&rtoc_self_view, stmts |> SKIP (last_user_idx + 1)));
    MUTABLE terminator_branch_value: ?BreakStmt = NIL;
    IF mIRLowering__noreturn_result_expr?(rtoc_self_view, result_stmt) THEN
      terminator_branch_value = castEmittableToBreakStmt(CAST(result_mir AS Emittable));
    ELSE
      terminator_branch_value = BreakStmt{ label: COPY label, value: COPY CAST(result_mir AS Emittable), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    END
    MUTABLE terminator: BreakStmt = terminator_branch_value?;
    MUTABLE tail = ((pending + suffix_lowered) + [terminator]);
    RETURN (prefix_lowered + mIRLowering__normalize_allocating_mir_body(rtoc_self_view, tail));
}
END
FN mIRLowering__lower_program(MUTABLE self: MIRLowering, node: Program, use_c_allocator: Bool = FALSE, needs_safety_input: Bool = FALSE, use_debug_allocator: Bool = FALSE) RETURNS !?MIRProgram
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE needs_safety = COPY needs_safety_input;
    TRY (mIRPassState__class_require_mut(node, :mir_pass_complete, {:consumer: "MIRLowering"}));
    mIRLowering__reset_unit_import_dedup_mut(rtoc_self_view);
    MUTABLE rtoc_writer_receiver_92: MIRLoweringProgramState = mIRLowering__program_state(rtoc_self_view);
    rtoc_writer_receiver_92.use_debug_allocator = COPY use_debug_allocator;
    MUTABLE rtoc_writer_receiver_93: MIRLoweringProgramState = mIRLowering__program_state(rtoc_self_view);
    rtoc_writer_receiver_93.fn_nodes = node.statements |> REDUCE({}) {
    IF _ IS_A FunctionDef AS function_def THEN
        MUTABLE function_def_mutable = COPY function_def;
        acc[CAST(function_def_mutable.name AS String)] = COPY function_def_mutable;
    END
    acc
    };
    MUTABLE items = List[];
    needs_safety = (needs_safety OR node.statements |> ANY (IF _ IS_A FunctionDef AS function_def THEN functionDef__reentrance_guard_required?(function_def) ELSE FALSE END));
    &items.append(Import{ alias_name: "std", module_path: "std", member: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
    &items.append(Import{ alias_name: "CheatHeader", module_path: "runtime/runtime-header.zig", member: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
    &items.append(TypeAlias{ name: "CheatLib", target: "CheatHeader.CheatLib", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
    &items.append(TypeAlias{ name: "Runtime", target: "CheatHeader.Runtime", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
    &items.append(TypeAlias{ name: "EbrContext", target: "CheatHeader.EbrContext", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
    IF needs_safety THEN
      &items.append(Import{ alias_name: "safety", module_path: "runtime/../lib/safety.zig", member: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
    END
    items = ruby_array_concat_Any(items, CAST(TRY (mIRLowering__lower_protocol_adapters(rtoc_self_view, node)) AS []Any));
    IF (use_c_allocator OR mIRLowering__program_state(rtoc_self_view).used_sharded_map) THEN
      &items.append(PubConst{ name: "USE_C_ALLOCATOR", value: "true", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
    END
    IF mIRLowering__program_state(rtoc_self_view).use_debug_allocator EXISTS AS use_debug_allocator_value THEN
      &items.append(PubConst{ name: "USE_DEBUG_ALLOCATOR", value: "true", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
    END
    FOR _ IN node.statements DO
    IF _ IS_A FunctionDef AS function_def THEN
        MUTABLE function_def_mutable = COPY function_def;
        MUTABLE seed: ?MIRLoweringCounterSnapshot = COPY mIRLowering__lowering_input(rtoc_self_view).function_counter_seeds[function_def_mutable.name];
        IF seed EXISTS AS seed_value THEN
          MUTABLE seed_value_mutable = COPY seed_value;
          MUTABLE rtoc_mutable_receiver_94 = mIRLowering__lowering_counters(rtoc_self_view);
          mIRLoweringCounters__restore_mut(&rtoc_mutable_receiver_94, seed_value_mutable);
        END
        MUTABLE rtoc_index_receiver_96 = mIRLowering__program_state(rtoc_self_view).function_counter_snapshots;
        rtoc_index_receiver_96[function_def_mutable.name] = COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_95 = mIRLowering__lowering_counters(rtoc_self_view);
        mIRLoweringCounters__snapshot(rtoc_local_receiver_95) };
    END
    MUTABLE lowered: ?MIRLoweringLoweredMir = TRY (mIRLowering__lower_top_level(&rtoc_self_view, _));
    TRY (mIRLowering__reject_module_scope_cleanup_mut(rtoc_self_view, _, UNWRAP (lowered)));
    mIRLowering__append_lowered_items_mut(rtoc_self_view, LoweredItemTarget{ items: COPY items, line: (IF _.token() != NIL THEN
        (_.token()).line()
      ELSE
        NIL
      END) }, UNWRAP (lowered));
    END
    TRY (mIRLowering__inject_const_init_mut(rtoc_self_view, &items));
    MUTABLE state = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_97 = mIRPassState__for_mut(MIRPassStateProgram{ ASTProgram: COPY node });
    mIRPassState__copy(rtoc_local_receiver_97) };
    TRY (mIRPassState__mark_mut(&state, :mir_lowered));
    RETURN MIRProgram{ token: items, statements: state, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, sync_policy: NIL, mir_pass_state: NIL, language_mode: NIL };
}
END
FN mIRLowering__inject_const_init_mut(self: MIRLowering, MUTABLE items: []Emittable, module_scope: Bool = FALSE) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE entries = COPY mIRLowering__program_state(rtoc_self_view).runtime_init_consts;
    MUTABLE module_inits = mIRLowering__program_state(rtoc_self_view).module_const_inits |> SELECT COPY _;
    IF ((entries.length() == 0) AND module_inits.empty?()) THEN
      RETURN;
    END
    MUTABLE raw: []Emittable = ( { MUTABLE rtoc_empty_list_98: []Emittable = List[]; rtoc_empty_list_98 } );
    IF module_scope THEN
      &items.append(Emittable{ Let: COPY Let{ name: COPY "__clear_consts_ready", init: Emittable{ Lit: COPY Lit{ value: "false", lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :Bool })), suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
      &raw.append(Emittable{ IfStmt: COPY IfStmt{ cond: Emittable{ Ident: COPY Ident{ name: "__clear_consts_ready", lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: [ReturnStmt{ value: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL } });
      &raw.append(Emittable{ Set: COPY Set{ target: Emittable{ Ident: COPY Ident{ name: "__clear_consts_ready", lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Lit: COPY Lit{ value: "true", lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    END
    FOR _ IN module_inits DO
    &raw.append(Emittable{ Call: COPY Call{ callee: "${_}.${"__clear_init_consts"}", args: [Emittable{ Ident: COPY Ident{ name: "rt", lowered_node_id: NIL, ownership_consumption: NIL } }], try_wrap: TRUE, owned_return: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(1)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL } });
    END
    FOR _ IN entries DO
    MUTABLE tmp = "__ci_${_.name}";
    ruby_array_concat_Emittable(raw, _.prelude);
    &raw.append(Emittable{ AllocMark: COPY AllocMark{ name: COPY tmp, alloc: :heap, type_info: COPY COPY _.type_info, scope: :heap, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    &raw.append(Emittable{ Let: COPY Let{ name: COPY tmp, init: COPY _.init, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
    &raw.append(Emittable{ Set: COPY Set{ target: Emittable{ Ident: COPY Ident{ name: COPY _.name, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Ident: COPY Ident{ name: tmp, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    ruby_array_concat_Emittable(raw, CAST(TRY (mIRLowering__ownership_transfer_marks(rtoc_self_view, tmp, :owned_sink, :heap)) AS []Emittable));
    END
    MUTABLE body = TRY (mIRLowering__finalize_synthetic_const_init_body_mut(rtoc_self_view, raw));
    &items.append(Emittable{ FnDef: COPY FnDef{ name: "__clear_init_consts", params: [MIRParam{ name: "rt", zig_type: "*Runtime", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL }], ret_type: "void", body: Body{ ArrayValue: body |> SELECT castEmittableToLocatable(_) }, visibility: IF module_scope THEN
      :pub
    ELSE
      :private
    END, can_fail: TRUE, comptime_params: List[], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    MUTABLE main_fn: ?Emittable = items |> FIND (IF _ IS_A FnDef AS fn_def THEN (((CAST(fn_def.name AS String) == zig_name) OR (CAST(fn_def.name AS String) == name))) ELSE FALSE END);
    IF main_fn? IS_A FnDef AS fn_def THEN
      MUTABLE rtoc_reverse_items_99: []ConstInitEntry = entries;
      MUTABLE rtoc_reverse_i_100 = rtoc_reverse_items_99.length() - 1;
      WHILE rtoc_reverse_i_100 >= 0 DO
    fnDef__body(fn_def).unshift(ModuleConstFree{ name: COPY ((rtoc_reverse_items_99[rtoc_reverse_i_100])?).name, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
    rtoc_reverse_i_100 = rtoc_reverse_i_100 - 1;
      END
      fnDef__body(fn_def).unshift(Call{ callee: COPY "__clear_init_consts", args: [Emittable{ Ident: COPY Ident{ name: "rt", lowered_node_id: NIL, ownership_consumption: NIL } }], try_wrap: TRUE, owned_return: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(1)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL });
    END
}
END
FN mIRLowering__finalize_synthetic_const_init_body_mut(self: MIRLowering, nodes: []Emittable) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE state = mIRLowering__initial_ownership_finalization_context(rtoc_self_view);
    mIRLowering__seed_cleanup_owner_index_mut(rtoc_self_view, state, nodes);
    FOR _ IN nodes DO
    TRY (mIRLowering__finalize_ownership_for_mir_node_mut(rtoc_self_view, _, nodes, state));
    END
    RETURN COPY state.out;
}
END
FN mIRLowering__reject_module_scope_cleanup_mut(self: MIRLowering, stmt: Locatable, lowered: ?MIRLoweringLoweredMir) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((stmt IS_A VarDecl OR stmt IS_A BindExpr)) THEN
      RETURN;
    END
    MUTABLE nodes = ([lowered]).flatten() |> WHERE _ != NIL;
    IF !(nodes |> ANY (_ IS_A Cleanup OR _ IS_A ErrCleanup)) THEN
      RETURN;
    END
    MUTABLE name: String = "";
    IF respondsTo?(stmt, "name") THEN
      name = stmt.name();
    ELSE
      name = "value";
    END
    RAISE Input, CompilerError, "{}but CLEAR has no module initialization/termination lifetime. Use a fixed-size comptime value, or construct it inside a function.";
}
END
FN mIRLowering__reset_unit_import_dedup_mut(self: MIRLowering) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    mIRLowering__program_state(rtoc_self_view).emitted_require_modules.delete_if(%(key) -> key.startsWith?("pkg-import:"));
    mIRLowering__program_state(rtoc_self_view).emitted_import_type_aliases.clear();
}
END
FN mIRLowering__append_lowered_items_mut(self: MIRLowering, target: LoweredItemTarget, lowered: ?MIRLoweringLoweredMir) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF lowered EXISTS AS lowered_value THEN
      MUTABLE nodes = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_102: ?MIRLoweringLoweredMir = NIL;
      IF lowered_value IS_A []Emittable THEN
        rtoc_ternary_value_102 = lowered_value;
      ELSE
        rtoc_ternary_value_102 = [lowered_value];
      END
      rtoc_ternary_value_102? };
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < nodes.length() DO
      IF (rtoc_idx.zero?() AND (target.line != NIL)) THEN
            &target.items.append(Emittable{ Comment: COPY Comment{ text: "CLR:${(target.line)?.toString()}", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
      END
      &target.items.append(COPY nodes[rtoc_idx]);
    rtoc_idx = rtoc_idx + 1;
      END
      NIL;
    ELSE
      RETURN;
    END
}
END
FN mIRLowering__lower_protocol_adapters(self: MIRLowering, program: Program) RETURNS ![]ProtocolAdapterDef
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE protocols = program.statements.grep(AST.ProtocolDef).to_h(%(protocol) -> [protocol.name(), protocol]);
    MUTABLE conformances = program.statements.grep(AST.ConformanceDef).group_by(%(declaration) USE(rtoc_self_view) -> mIRLowering__protocol_base_name_for_lowering(rtoc_self_view, declaration.protocol_type()));
    RETURN (TRY (inlineAllocMetadata__values(protocols))) |> SELECT {
    MUTABLE cases = (((conformances[_.name()] OR List[]))) |> SELECT mIRLowering__lower_protocol_conformance_case(rtoc_self_view, _, _);
    MUTABLE requirements = _.requirements() |> SELECT ProtocolRequirementAdapter{ name: COPY _.name(), argument_count: scopeBindings__length(_.params()), return_type: COPY TRY (mIRLowering__protocol_requirement_return_type(rtoc_self_view, _, _)) };
    ProtocolAdapterDef{ protocol: COPY _.name(), associated_types: COPY _.associated_types() |> SELECT _.name(), requirements: COPY requirements, conformances: COPY cases }
    };
}
END
FN mIRLowering__lower_protocol_conformance_case(self: MIRLowering, protocol: ProtocolDef, declaration: ConformanceDef) RETURNS !ProtocolConformanceCase
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE generic = declaration.binders |> ANY _;
    MUTABLE associated = {
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE rtoc_indexed_items_103: []GenericParamDecl = protocol.associated_types;
    MUTABLE rtoc_indexed_output_105 = {};
    MUTABLE rtoc_indexed_i_104 = 0;
    WHILE rtoc_indexed_i_104 < rtoc_indexed_items_103.length() DO
      MUTABLE rtoc_indexed_pair_106 = {
    MUTABLE binding = COPY UNWRAP ((TRY (type__generic_args(declaration.protocol_type)))[rtoc_indexed_i_104]);
    [rtoc_indexed_items_103[rtoc_indexed_i_104].name, mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ Type: COPY binding })]
    };
      rtoc_indexed_output_105[rtoc_indexed_pair_106._0] = rtoc_indexed_pair_106._1;
      rtoc_indexed_i_104 = rtoc_indexed_i_104 + 1;
    END
    rtoc_indexed_output_105
    };
    MUTABLE operations = declaration.members.to_h(%(member: FunctionDef) USE(rtoc_self_view) -> [member.source_name, mIRLowering__zig_safe_name(rtoc_self_view, member.name)]);
    MUTABLE owner_name = mIRLowering__protocol_base_name_for_lowering(rtoc_self_view, declaration.owner_type);
    RETURN ProtocolConformanceCase{ owner_type: COPY IF generic THEN
      NIL
    ELSE
      mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ Type: COPY declaration.owner_type })
    END, owner_marker: IF generic THEN
      "__clear_nominal_${mIRLowering__zig_safe_name(rtoc_self_view, owner_name)}"
    ELSE
      NIL
    END, type_params: COPY declaration.binders |> SELECT _.name, associated_types: COPY associated, operations: COPY operations };
}
END
FN mIRLowering__protocol_requirement_return_type(self: MIRLowering, protocol: ProtocolDef, requirement: ProtocolRequirement) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE replacements: {String@symbol}TypeExpression = {};
    FOR _ IN protocol.associated_types DO
    replacements[symbol(_.name)] = typeExpression__of(TypeProjectionExpression{ owner: :T, member: COPY symbol(_.name), protocol: COPY type__to_sym(protocol.name) });
    END
    replacements[:Self] = typeExpression__of(NamedTypeExpression{ name: :T, arguments: List[] });
    MUTABLE expression = typeExpressionTree__transform(requirement.return_type.shape.expression, %(candidate: TypeExpression) USE(replacements) -> {
    MUTABLE candidate_kind = candidate.kind;
    IF ((candidate_kind IS_A NamedTypeExpression AND candidate_kind.arguments().empty?()) AND replacements.contains?(candidate_kind.name())) THEN
      RETURN UNWRAP (replacements[candidate_kind.name()]);
    ELSE
      RETURN candidate;
    END
    NIL
    });
    MUTABLE result = TRY (type__new(TypeConstructionInput{ TypeExpression: COPY expression }));
    IF type__error_union?(result) THEN
      MUTABLE payload = TRY (type__success_type(result));
      RETURN "anyerror!${mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ Type: COPY payload })}";
    END
    RETURN mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ Type: COPY result });
}
END
FN mIRLowering__protocol_base_name_for_lowering(self: MIRLowering, type: Type) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY CAST((IF type__generic_instance?(type) THEN
      type__generic_base(type)
    ELSE
      type__resolved(type)
    END) AS String);
}
END
FN mIRLowering__lower_module(MUTABLE self: MIRLowering, node: Program) RETURNS !LoweredModuleItems
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (mIRPassState__class_require_mut(node, :mir_pass_complete, {:consumer: "MIRLowering.lower_module"}));
    mIRLowering__reset_unit_import_dedup_mut(rtoc_self_view);
    MUTABLE type_items: []Emittable = ( { MUTABLE rtoc_empty_list_107: []Emittable = List[]; rtoc_empty_list_107 } );
    MUTABLE fn_items: []Emittable = ( { MUTABLE rtoc_empty_list_108: []Emittable = List[]; rtoc_empty_list_108 } );
    FOR _ IN node.statements DO
    IF _ IS_A FunctionDef AS function_def THEN
      MUTABLE function_def_mutable = COPY function_def;
      mIRLowering__append_lowered_items_mut(rtoc_self_view, LoweredItemTarget{ items: COPY fn_items, line: function_def_mutable.token.line }, UNWRAP (TRY (mIRLowering__lower_top_level(&rtoc_self_view, Locatable{ FunctionDef: COPY function_def_mutable }))));
    ELSE_IF (_ IS_A StructDef) OR (_ IS_A EnumDef) OR (_ IS_A UnionDef) THEN
      mIRLowering__append_lowered_items_mut(rtoc_self_view, LoweredItemTarget{ items: COPY type_items, line: _.token().line() }, UNWRAP (TRY (mIRLowering__lower_top_level(&rtoc_self_view, _))));
    ELSE_IF _ IS_A RequireNode AS require_node THEN
      MUTABLE require_node_mutable = COPY require_node;
      mIRLowering__append_lowered_items_mut(rtoc_self_view, LoweredItemTarget{ items: COPY fn_items, line: NIL }, UNWRAP (TRY (mIRLowering__lower_top_level(&rtoc_self_view, Locatable{ RequireNode: COPY require_node_mutable }))));
    ELSE_IF _ IS_A ExternFnDecl AS extern_fn_decl THEN
      MUTABLE extern_fn_decl_mutable = COPY extern_fn_decl;
      mIRLowering__append_lowered_items_mut(rtoc_self_view, LoweredItemTarget{ items: COPY fn_items, line: extern_fn_decl_mutable.token.line }, UNWRAP (TRY (mIRLowering__lower_top_level(&rtoc_self_view, Locatable{ ExternFnDecl: COPY extern_fn_decl_mutable }))));
    ELSE_IF _ IS_A ExternStructDecl AS extern_struct_decl THEN
      MUTABLE extern_struct_decl_mutable = COPY extern_struct_decl;
      mIRLowering__append_lowered_items_mut(rtoc_self_view, LoweredItemTarget{ items: COPY fn_items, line: extern_struct_decl_mutable.token.line }, UNWRAP (TRY (mIRLowering__lower_top_level(&rtoc_self_view, Locatable{ ExternStructDecl: COPY extern_struct_decl_mutable }))));
    ELSE_IF _ IS_A VarDecl AS var_decl THEN
      MUTABLE var_decl_mutable = COPY var_decl;
      MUTABLE lowered: ?MIRLoweringLoweredMir = TRY (mIRLowering__lower_top_level(&rtoc_self_view, Locatable{ VarDecl: COPY var_decl_mutable }));
      TRY (mIRLowering__reject_module_scope_cleanup_mut(rtoc_self_view, Locatable{ VarDecl: COPY var_decl_mutable }, UNWRAP (lowered)));
      mIRLowering__append_lowered_items_mut(rtoc_self_view, LoweredItemTarget{ items: COPY fn_items, line: varDecl__token(var_decl_mutable).line }, UNWRAP (lowered));
    ELSE_IF _ IS_A BindExpr AS bind_expr THEN
      MUTABLE bind_expr_mutable = COPY bind_expr;
      MUTABLE lowered: ?MIRLoweringLoweredMir = TRY (mIRLowering__lower_top_level(&rtoc_self_view, Locatable{ BindExpr: COPY bind_expr_mutable }));
      TRY (mIRLowering__reject_module_scope_cleanup_mut(rtoc_self_view, Locatable{ BindExpr: COPY bind_expr_mutable }, UNWRAP (lowered)));
      mIRLowering__append_lowered_items_mut(rtoc_self_view, LoweredItemTarget{ items: COPY fn_items, line: bind_expr_mutable.token.line }, UNWRAP (lowered));
    END
    END
    TRY (mIRLowering__inject_const_init_mut(rtoc_self_view, &fn_items, TRUE));
    RETURN LoweredModuleItems{ items: COPY fn_items, type_items: COPY type_items };
}
END
PRIVATE FN mIRLowering__lower_top_level(MUTABLE self: MIRLowering, stmt: Locatable) RETURNS !?MIRLoweringLoweredMir
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_writer_receiver_110: FunctionState = mIRLowering__function_state(rtoc_self_view);
    rtoc_writer_receiver_110.pending_stmts = ( { MUTABLE rtoc_empty_list_109: []Stmt = List[]; rtoc_empty_list_109 } );
    IF (IF stmt IS_A VarDecl AS var_decl THEN !(varDecl__module_const(var_decl)) ELSE FALSE END) THEN
      mIRLowering__program_state(rtoc_self_view).module_global_names.insert(COPY CAST(stmt.name() AS String));
    END
    MUTABLE lowered = TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(stmt)));
    MUTABLE items: []Any = List[];
    IF lowered IS_A []@multiowned Any THEN
      items = lowered;
    ELSE
      items = [CAST(lowered AS Any)];
    END
    FOR _ IN items DO
    IF _ IS_A Let THEN
      _.suppression = NIL;
    END
    END
    RETURN lowered;
}
END
PRIVATE FN mIRLowering__zig_safe_name(self: MIRLowering, name: String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE cleaned: String = "";
    IF name.endsWith?("?") THEN
      cleaned = "${name.substr(0, (((name.length() - 2) - 0) + 1))}${"_p"}";
    ELSE_IF name.endsWith?("!") THEN
      cleaned = "${name.substr(0, (((name.length() - 2) - 0) + 1))}${"_bang"}";
    ELSE
      cleaned = COPY name;
    END
    IF (cleaned == name) THEN
      cleaned = zig_name;
    END
    cleaned = COPY cleaned;
    IF zigType__reserved_identifier?(cleaned) THEN
      RETURN "@\"${cleaned}\"";
    ELSE
      RETURN cleaned;
    END
}
END
PRIVATE FN mIRLowering__node_store_binding_name(self: MIRLowering, zig_type: String, shared_value: Bool = FALSE) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE encoded = (zig_type.each_char() |> SELECT {
    MUTABLE alpha = ((((_ >= "A") AND (_ <= "Z"))) OR (((_ >= "a") AND (_ <= "z"))));
    MUTABLE digit = ((_ >= "0") AND (_ <= "9"));
    (IF ((alpha OR digit) OR (_ == "_")) THEN
        _
      ELSE
        "_"
      END)
    }).join("");
    IF shared_value THEN
      RETURN "__shared_node_guard_${encoded}";
    ELSE
      RETURN "__node_store_${encoded}";
    END
}
END
PRIVATE FN mIRLowering__alloc_for_node(self: MIRLowering, node: Locatable) RETURNS String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN mIRLowering__placement_for_node(rtoc_self_view, node);
}
END
PRIVATE FN mIRLowering__with_decl_alloc<U>(self: MIRLowering, alloc: ?String@symbol, blk: FN() -> U) RETURNS U
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
  MUTABLE prev: ?String@symbol = COPY mIRLowering__function_state(rtoc_self_view).current_decl_alloc;
  DEFER MUTABLE rtoc_writer_receiver_111: FunctionState = mIRLowering__function_state(rtoc_self_view);
  rtoc_writer_receiver_111.current_decl_alloc = prev;
  MUTABLE rtoc_writer_receiver_112: FunctionState = mIRLowering__function_state(rtoc_self_view);
  rtoc_writer_receiver_112.current_decl_alloc = COPY alloc;
  RETURN blk();
}
END
PRIVATE FN mIRLowering__with_reassignment_target<U>(self: MIRLowering, name: String, blk: FN() -> U) RETURNS U
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
  MUTABLE previous: ?String = COPY mIRLowering__function_state(rtoc_self_view).current_reassignment_target;
  DEFER MUTABLE rtoc_writer_receiver_113: FunctionState = mIRLowering__function_state(rtoc_self_view);
  rtoc_writer_receiver_113.current_reassignment_target = previous;
  MUTABLE rtoc_writer_receiver_114: FunctionState = mIRLowering__function_state(rtoc_self_view);
  rtoc_writer_receiver_114.current_reassignment_target = COPY name;
  RETURN blk();
}
END
PRIVATE FN mIRLowering__with_expected_type<U>(self: MIRLowering, type_info: ?Type, blk: FN() -> U) RETURNS U
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
  MUTABLE prev: ?Type = COPY mIRLowering__function_state(rtoc_self_view).current_expected_type;
  DEFER MUTABLE rtoc_writer_receiver_115: FunctionState = mIRLowering__function_state(rtoc_self_view);
  rtoc_writer_receiver_115.current_expected_type = prev;
  MUTABLE rtoc_writer_receiver_116: FunctionState = mIRLowering__function_state(rtoc_self_view);
  rtoc_writer_receiver_116.current_expected_type = COPY type_info;
  RETURN blk();
}
END
PRIVATE FN mIRLowering__with_sink_type<U>(self: MIRLowering, type_info: ?Type, blk: FN() -> U) RETURNS U
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
  MUTABLE prev: ?Type = COPY mIRLowering__function_state(rtoc_self_view).current_sink_type;
  DEFER MUTABLE rtoc_writer_receiver_117: FunctionState = mIRLowering__function_state(rtoc_self_view);
  rtoc_writer_receiver_117.current_sink_type = prev;
  MUTABLE rtoc_writer_receiver_118: FunctionState = mIRLowering__function_state(rtoc_self_view);
  rtoc_writer_receiver_118.current_sink_type = COPY type_info;
  RETURN blk();
}
END
PRIVATE FN mIRLowering__allocator_for_takes_param_mut(self: MIRLowering, callee_param: ?Param) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF callee_param EXISTS AS callee_param_value THEN
      RETURN :heap;
    ELSE
      panic("TAKES argument allocator requested without a callee parameter");
    END
}
END
PRIVATE FN mIRLowering__call_arg_consumes_ownership?(self: MIRLowering, arg: Locatable, callee_param: ?Param) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN !(!(((((callee_param != NIL) AND TRUE) AND callee_param.takes))));
}
END
PRIVATE FN mIRLowering__symbol_storage_for_node(self: MIRLowering, node: ?Locatable) RETURNS ?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node EXISTS AS node_value THEN
      MUTABLE sym = IF respondsTo?(node_value, "symbol") THEN
        node_value.symbol()
      ELSE
        NIL
      END;
      IF !(sym) THEN
        RETURN NIL;
      END
      MUTABLE decl = IF respondsTo?(sym, "reg") THEN
        sym.reg()
      ELSE
        NIL
      END;
      MUTABLE auth = ((((TRUE AND respondsTo?(decl, "symbol")) AND decl.symbol())) OR sym);
      MUTABLE storage = auth.storage();
      IF symbolEntry__heap_storage?(auth) THEN
        RETURN :heap;
      ELSE
        RETURN :frame;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN mIRLowering__placement_for_node(self: MIRLowering, node_input: Locatable) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE node = COPY node_input;
    IF node IS_A MoveNode AS move_node THEN
      MUTABLE move_node = move_node.value;
    END
    MUTABLE root = (mIRLowering__root_receiver_node(rtoc_self_view, node) OR_ELSE node);
    IF root IS_A Identifier THEN
      MUTABLE alias_alloc: ?String@symbol = COPY (IF mIRLowering__capability_state(rtoc_self_view).with_alias_alloc_map != NIL THEN
        (mIRLowering__capability_state(rtoc_self_view).with_alias_alloc_map)[CAST(root.name() AS String)]
      ELSE
        NIL
      END);
      IF alias_alloc EXISTS AS alias_alloc_value THEN
        RETURN alias_alloc_value;
      END
      IF mIRLowering__current_function_collection_param?(rtoc_self_view, root.name()) THEN
        RETURN :heap;
      END
      MUTABLE entry: ?CleanupEntry@multiowned = COPY (TRY (functionState__bindings(mIRLowering__function_state(rtoc_self_view))))[CAST(root.name() AS String)];
      IF (IF entry != NIL THEN
        cleanupEntry__alloc(entry)
      ELSE
        NIL
      END) THEN
        RETURN cleanupEntry__alloc(entry);
      END
    END
    IF root IS_A Identifier THEN
      MUTABLE sym = root.symbol();
      MUTABLE lifetime_sources: []Any = List[];
      IF sym != NIL THEN
        lifetime_sources = COPY TRY (symbolEntry__lifetime_sources(sym));
      END
      IF !((lifetime_sources.length() == 0)) THEN
        IF lifetime_sources |> ANY _.heap_storage?() THEN
          RETURN :heap;
        END
        RETURN :frame;
      END
    END
    IF (IF mIRLowering__symbol_storage_for_node(rtoc_self_view, root) != NIL THEN mIRLowering__symbol_storage_for_node(rtoc_self_view, root) ELSE mIRLowering__function_state(rtoc_self_view).current_decl_alloc END) != NIL THEN
    RETURN ((IF mIRLowering__symbol_storage_for_node(rtoc_self_view, root) != NIL THEN mIRLowering__symbol_storage_for_node(rtoc_self_view, root) ELSE mIRLowering__function_state(rtoc_self_view).current_decl_alloc END))?;
    ELSE
    RETURN :frame;
    END
}
END
PRIVATE FN mIRLowering__alloc_expr(self: MIRLowering, kind: String@symbol, ignored_rt_name: ?RtName = NIL) RETURNS String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN placement__alloc(kind, :frame);
}
END
PRIVATE FN mIRLowering__alloc_from_sym(self: MIRLowering, sym: String@symbol) RETURNS String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN placement__alloc(sym, :heap);
}
END
PRIVATE FN mIRLowering__resolve_alloc_sym(self: MIRLowering, alloc_sym: String@symbol, target_node: ?Locatable = NIL, node: ?Locatable = NIL) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (alloc_sym == :frame) THEN
      RETURN :frame;
    ELSE_IF (alloc_sym == :receiver_storage) THEN
      MUTABLE receiver: ?Locatable = COPY target_node;
      IF ((node != NIL) AND (node IS_A MethodCall)) THEN
        receiver = (receiver OR_ELSE node.object());
      END
      IF (IF node? IS_A FuncCall AS func_call THEN (func_call.mutates_receiver != NIL) ELSE FALSE END) THEN
        receiver = (receiver OR_ELSE node.args().first());
      END
      MUTABLE root: ?Identifier = mIRLowering__root_receiver_node(rtoc_self_view, receiver);
      MUTABLE selected: Locatable = CAST(((IF root != NIL THEN root ELSE receiver END) OR node) AS Locatable);
      MUTABLE selected_type = TRY (type__from_node_mut(selected, "allocator receiver"));
      IF TRY (type__node_reference?(selected_type)) THEN
        RETURN :heap;
      END
      RETURN mIRLowering__placement_for_node(rtoc_self_view, selected);
    ELSE_IF (alloc_sym == :node_storage) THEN
      IF mIRLowering__function_state(rtoc_self_view).current_decl_alloc != NIL THEN
    RETURN (mIRLowering__function_state(rtoc_self_view).current_decl_alloc)?;
      ELSE
    RETURN mIRLowering__placement_for_node(rtoc_self_view, castOptionalLocatableToLocatable((IF target_node != NIL THEN target_node ELSE UNWRAP (node) END)));
      END
    ELSE
      RETURN :heap;
    END
}
END
PRIVATE FN mIRLowering__root_receiver_node(self: MIRLowering, node: ?Locatable) RETURNS ?Identifier
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((node != NIL)) THEN
      RETURN NIL;
    END
    MUTABLE root: ?Identifier = aST__root_identifier(UNWRAP (node));
    IF root EXISTS AS root_value THEN
      RETURN COPY root_value;
    END
    IF (node IS_A GetField) OR (node IS_A GetIndex) OR (node IS_A OptionalUnwrap) OR (node IS_A Slice) THEN
      RETURN mIRLowering__root_receiver_node(rtoc_self_view, node.target());
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN mIRLowering__extract_root_var_name(self: MIRLowering, node: Locatable) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE root: ?Identifier = mIRLowering__root_receiver_node(rtoc_self_view, node);
    IF !((root != NIL)) THEN
      RETURN NIL;
    END
    MUTABLE owner: ?String = COPY (IF mIRLowering__capability_state(rtoc_self_view).with_alias_owner_map != NIL THEN
      (mIRLowering__capability_state(rtoc_self_view).with_alias_owner_map)[root.name]
    ELSE
      NIL
    END);
    IF owner EXISTS AS owner_value THEN
      RETURN COPY owner_value;
    END
    MUTABLE decl: ?SymbolEntryRegInput = NIL;
    IF root.symbol != NIL THEN
      decl = COPY ((root.symbol)?).reg;
    END
    RETURN ((((decl != NIL) AND ((TRY (functionState__decl_zig_names(mIRLowering__function_state(rtoc_self_view))))[decl.object_id()] != NIL))) OR root.name);
}
END
PRIVATE FN mIRLowering__mir_cast(self: MIRLowering, mir_node: Emittable, from_type: Type, to_type: TypeTypeInput) RETURNS !?Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE from_t = COPY from_type;
    IF (type__resolved(from_t) == :NoReturn) THEN
      RETURN COPY mir_node;
    END
    MUTABLE to_t = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_120: ?TypeTypeInput = NIL;
    IF to_type IS_A Type THEN
      rtoc_ternary_value_120 = to_type;
    ELSE
      rtoc_ternary_value_120 = TRY (type__new(castTypeTypeInputToTypeConstructionInput(to_type)));
    END
    rtoc_ternary_value_120? };
    IF (type__semantic_type_key(from_t) == type__semantic_type_key(to_t)) THEN
      RETURN NIL;
    END
    IF ((to_t.indirect?() AND !(type__indirect?(from_t))) AND (type__resolved(from_t) == to_t.resolved())) THEN
      RETURN NIL;
    END
    IF (TRY (type__zig_type(from_t)) == TRY (type__zig_type(to_t))) THEN
      RETURN NIL;
    END
    MUTABLE zig_to = mIRLowering__transpile_type(rtoc_self_view, to_t);
    IF (type__fn_type?(from_t) OR to_t.fn_type?()) THEN
      RETURN Emittable{ MIRCast: COPY MIRCast{ expr: COPY mir_node, target_type: COPY zig_to, method: :as, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF (type__integer?(from_t) AND type__float?(to_t)) THEN
      RETURN Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ MIRCast: COPY MIRCast{ expr: COPY mir_node, target_type: NIL, method: :floatFromInt, lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: COPY zig_to, method: :as, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF (type__float?(from_t) AND type__integer?(to_t)) THEN
      RETURN Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ MIRCast: COPY MIRCast{ expr: COPY mir_node, target_type: NIL, method: :intFromFloat, lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: COPY zig_to, method: :as, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF (type__integer?(from_t) AND type__integer?(to_t)) THEN
      RETURN Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ MIRCast: COPY MIRCast{ expr: COPY mir_node, target_type: NIL, method: :intCast, lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: COPY zig_to, method: :as, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF (type__float?(from_t) AND type__float?(to_t)) THEN
      RETURN Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ MIRCast: COPY MIRCast{ expr: COPY mir_node, target_type: NIL, method: :floatCast, lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: COPY zig_to, method: :as, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF (type__dynamic?(from_t) AND type__dynamic?(to_t)) THEN
      RETURN NIL;
    END
    IF (type__fixed?(from_t) AND type__empty_list?(to_t)) THEN
      RETURN NIL;
    END
    IF (type__fixed?(from_t) AND type__dynamic?(to_t)) THEN
      MUTABLE from_elem: ?Type = TRY (type__element_type(from_t));
      MUTABLE to_elem = to_t.element_type();
      IF (((from_elem != NIL) AND to_elem) AND (TRY (type__surface_name(TypeTypeInput{ Type: COPY UNWRAP (from_elem) })) == TRY (type__surface_name(to_elem)))) THEN
        RETURN NIL;
      END
    END
    IF (type__map?(from_t) AND type__map?(to_t)) THEN
      RETURN NIL;
    END
    IF to_t.error_union?() THEN
      MUTABLE payload_type = to_t.payload_type();
      MUTABLE from_matches = (TRY (type__surface_name(TypeTypeInput{ Type: COPY from_t })) == TRY (type__surface_name(payload_type)));
      from_matches = (from_matches OR (TRY (type__string?(from_t)) AND TRY (type__string?(payload_type))));
      IF from_matches THEN
        RETURN NIL;
      END
    END
    RETURN Emittable{ MIRCast: COPY MIRCast{ expr: COPY mir_node, target_type: COPY zig_to, method: :as, lowered_node_id: NIL, ownership_consumption: NIL } };
}
END
PRIVATE FN mIRLowering__build_drop_entry_mut(self: MIRLowering, MUTABLE entry: CleanupEntry, ti: Type, source_node: ?VarDecl) RETURNS !?Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE plan = (cleanupEntry__lifecycle_plan(entry) OR_ELSE ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_122: ?LifecyclePlan = NIL;
    IF source_node != NIL THEN
      rtoc_ternary_value_122 = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_121 = mIRLowering__lifecycle_registry(rtoc_self_view);
    TRY (lifecycleRegistry__fetch_binding(rtoc_local_receiver_121, Locatable{ VarDecl: COPY source_node }, ti)) };
    ELSE
      rtoc_ternary_value_122 = UNWRAP (mIRLowering__lifecycle_registry(rtoc_self_view)[ti]);
    END
    rtoc_ternary_value_122? }));
    IF !(lifecyclePlan__needs_drop?(plan)) THEN
      MUTABLE source: String = "";
      IF source_node EXISTS AS source_node_value THEN
        source = " binding ${source_node_value.name} at line ${source_node_value.line().toString()}";
      ELSE
        source = "";
      END
      panic("lowering attempted DROP for non-owning type {}{}");
    END
    cleanupEntry__set_lifecycle_plan_mut(&entry, plan);
    RETURN TRUE;
}
END
PRIVATE FN mIRLowering__lower_drop(self: MIRLowering, node: Drop) RETURNS !Cleanup
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE safe = mIRLowering__zig_safe_name(rtoc_self_view, node.name);
    MUTABLE entry = node.cleanup_entry;
    MUTABLE plan = entry.lifecycle_plan();
    IF !((IF plan != NIL THEN
      lifecyclePlan__needs_drop?(plan)
    ELSE
      NIL
    END)) THEN
      panic("MIR::Drop lacks annotation lifecycle plan for {}");
    END
    MUTABLE has_guard = IF respondsTo?(entry, "has_moved_guard?") THEN
      { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_124 = CAST(entry AS CleanupEntry);
    cleanupEntry__has_moved_guard?(rtoc_local_receiver_124) }
    ELSE
      !(!(((respondsTo?(entry, "[]") AND entry[:has_moved_guard]))))
    END;
    IF has_guard THEN
      MUTABLE rtoc_index_receiver_125 = mIRLowering__function_state(rtoc_self_view).guarded_cleanup_names;
      rtoc_index_receiver_125[safe] = TRUE;
    END
    RETURN Cleanup{ name: safe, cleanup_entry: node.cleanup_entry, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
}
END
PRIVATE FN mIRLowering__lower_enum_def(self: MIRLowering, node: EnumDef) RETURNS MIREnumDef
