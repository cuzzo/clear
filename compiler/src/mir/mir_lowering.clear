      RETURN mIRLowering__ownership_consumed_arg_names(rtoc_self_view, ownedSlice__expr(owned_slice));
    ELSE_IF arg IS_A MIRCast AS mir_cast THEN
      RETURN mIRLowering__ownership_consumed_arg_names(rtoc_self_view, cast__expr(mir_cast));
    ELSE_IF arg IS_A TryExpr AS try_expr THEN
      RETURN mIRLowering__ownership_consumed_arg_names(rtoc_self_view, tryExpr__expr(try_expr));
    ELSE_IF arg IS_A TryOptional AS try_optional THEN
      RETURN mIRLowering__ownership_consumed_arg_names(rtoc_self_view, tryOptional__expr(try_optional));
    ELSE_IF arg IS_A AddressOf AS address_of THEN
      RETURN mIRLowering__ownership_consumed_arg_names(rtoc_self_view, addressOf__expr(address_of));
    ELSE_IF arg IS_A Deref AS deref THEN
      RETURN mIRLowering__ownership_consumed_arg_names(rtoc_self_view, deref__expr(deref));
    ELSE
      RETURN mIRLowering__mir_ident_names(rtoc_self_view, arg);
    END
}
END
