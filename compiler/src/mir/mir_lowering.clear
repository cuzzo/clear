PRIVATE FN mIRLowering__owned_sink_plan(MUTABLE self: MIRLowering, MUTABLE value: Emittable, ast_node: Locatable, sink_alloc: String@symbol, sink_type: ?TypeTypeInput = NIL) RETURNS !OwnedSinkPlan ->
