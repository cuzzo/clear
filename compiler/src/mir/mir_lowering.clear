PRIVATE FN mIRLowering__polymorphic_flow_required?(self: MIRLowering, node: WithBlock) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF mIRLowering__with_capability_specs(rtoc_self_view, node) |> ANY _.guard_expr THEN
      RETURN TRUE;
    END
    RETURN mIRLowering__ast_contains_return?(rtoc_self_view, AstReturnSearchNode{ ArrayValue: node.body |> SELECT castLocatableToNode(_) });
}
END
PRIVATE FN mIRLowering__ast_contains_return?(self: MIRLowering, node: ?AstReturnSearchNode) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE root_branch_value: ?AstReturnSearchNode = NIL;
    IF ((node != NIL) AND (node IS_A [Set]Any)) THEN
      root_branch_value = node.to_a();
    ELSE
      root_branch_value = COPY node;
    END
    MUTABLE root: ?AstReturnSearchNode = root_branch_value;
    MUTABLE found: Bool = FALSE;
    aST__each_locatable(castOptionalAstReturnSearchNodeToAnyMultiowned(root), %(candidate: Locatable) -> {
    IF candidate IS_A ReturnNode AS return_node THEN
        found = TRUE;
    END
    rubyToClearVoid()
    });
    RETURN found;
}
END
