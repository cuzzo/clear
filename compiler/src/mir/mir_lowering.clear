PRIVATE FN mIRLowering__or_else_exit_error_update_stmts(self: MIRLowering, facts: OrElseExitFacts) RETURNS ![]Stmt
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE stmts: []Stmt = ( { MUTABLE rtoc_empty_list_568: []Stmt = List[]; rtoc_empty_list_568 } );
    IF facts.kind EXISTS AS kind_value THEN
      &stmts.append(Stmt{ Emittable: COPY CAST(Set{ target: Emittable{ FieldGet: COPY mIRLowering__runtime_error_field(rtoc_self_view, "kind") }, value: Emittable{ EnumTag: COPY EnumTag{ variant: COPY kind_value } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) });
      IF facts.error_name EXISTS AS error_name_value THEN
        MUTABLE name_id = EnumOrdinal{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "ErrorName", lowered_node_id: NIL, ownership_consumption: NIL } }, field: COPY error_name_value, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL };
        &stmts.append(Stmt{ Emittable: COPY CAST(Set{ target: Emittable{ FieldGet: COPY mIRLowering__runtime_error_field(rtoc_self_view, "error_name") }, value: Emittable{ EnumOrdinal: COPY name_id }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) });
      ELSE
      IF facts.clear_type THEN
          &stmts.append(Stmt{ Emittable: COPY CAST(Set{ target: Emittable{ FieldGet: COPY mIRLowering__runtime_error_field(rtoc_self_view, "error_name") }, value: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) });
      END
      END
    END
    RETURN stmts;
}
END
