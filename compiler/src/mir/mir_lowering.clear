      TRY (type__wrapped_type(dst_ti))
    ELSE
      dst_ti
    END;
    IF (((handle_ti != NIL) AND TRY (type__any_rc?((handle_ti?)))) AND !(ownedSinkSourceFact__satisfies_rc_sink?(source))) THEN
      RETURN OwnedSinkPlan{ action: :rc_retain, target_alloc: COPY sink_alloc, zig_type: COPY mIRLowering__rc_payload_zig_type(rtoc_self_view, handle_ti), copy_mode: NIL, rc_func: IF type__shared?(handle_ti) THEN
        "arcRetain"
      ELSE
        "rcRetain"
      END, source_slice_view: FALSE };
    END
    IF ((lifecycle.copy_strategy == :deep_clone) OR (lifecycle.copy_strategy == :generic)) THEN
      IF source.borrowed_union_sink THEN
        RETURN OwnedSinkPlan{ action: :dupe_union, target_alloc: COPY sink_alloc, zig_type: COPY mIRLowering__bare_zig_type(rtoc_self_view, ti), copy_mode: NIL, rc_func: NIL, source_slice_view: FALSE };
      END
