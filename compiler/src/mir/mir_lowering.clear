    callee_sig = (callee_sig OR_ELSE TRY (mIRLowering__matched_call_signature(self, CallNode{ FuncCall: COPY node })));
    MUTABLE call_plans = (node.kept_edge_plans OR_ELSE {});
    MUTABLE args_mir = TRY (mIRLowering__with_kept_edge_call_frame(&self, %() USE(node, call_plans, callee_sig, MUTABLE self) -> {
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE rtoc_indexed_items_359: []Locatable = node.args;
    MUTABLE rtoc_indexed_output_361 = [];
    MUTABLE rtoc_indexed_i_360 = 0;
    WHILE rtoc_indexed_i_360 < rtoc_indexed_items_359.length() DO
      &rtoc_indexed_output_361.append(TRY (mIRLowering__lower_call_arg_from_facts(&self, TRY (mIRLowering__call_arg_facts(&self, UNWRAP (rtoc_indexed_items_359[rtoc_indexed_i_360]), callee_sig, rtoc_indexed_i_360, call_plans[rtoc_indexed_i_360])))));
      rtoc_indexed_i_360 = rtoc_indexed_i_360 + 1;
    END
    rtoc_indexed_output_361
    }));
    mod_alias = node.module_alias;
    MUTABLE mod_prefix: String = "";
    IF mod_alias EXISTS AS mod_alias_value THEN
      mod_prefix = "${mIRLowering__zig_module_alias(self, mod_alias_value)}.";
    ELSE
      mod_prefix = "";
    END
    IF (node.fn_var_call OR_ELSE FALSE) THEN
      # A function VALUE is a closure: the environment its captures live in
      # travels with the code pointer, so the call passes both.
      MUTABLE fn_var_safe = mIRLowering__zig_safe_name(self, CAST(node.name AS String));
      all_args = (([Emittable{ Ident: COPY Ident{ name: mIRLowering__runtime_binding_name(&self), lowered_node_id: NIL, ownership_consumption: NIL } }, Emittable{ Ident: COPY Ident{ name: "${fn_var_safe}.ctx", lowered_node_id: NIL, ownership_consumption: NIL } }]) + args_mir);
      MUTABLE contract: ?CallableContract@multiowned = TRY (mIRLowering__callable_contract_for_lowered_args(&self, KEEP node.matched_signature, node.args, &args_mir));
      RETURN Emittable{ Call: COPY Call{ callee: "try ${fn_var_safe}.call", args: COPY all_args, try_wrap: FALSE, owned_return: TRY (mIRLowering__call_owned_return?(&self, Node{ FuncCall: COPY node })), callable_contract: COPY contract, lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL } };
    END
    MUTABLE needs_rt = TRY (mIRLowering__callee_needs_rt?(self, CAST(node.name AS String)));
    MUTABLE can_fail = TRY (mIRLowering__callee_can_fail?(self, CAST(node.name AS String)));
    IF (TRUE AND (node.retain_error_channel != NIL)) THEN
      can_fail = FALSE;
    END
    MUTABLE type_args: []Emittable = List[];
    IF node.generic_type_args EXISTS AS rtoc_type_args THEN
      IF (rtoc_type_args.length() > 0) THEN
        type_args = rtoc_type_args |> SELECT Emittable{ Ident: COPY Ident{ name: TRY (mIRLowering__generic_type_arg_zig(self, TypeTypeInput{ SymbolValue: COPY _ })), lowered_node_id: NIL, ownership_consumption: NIL } };
      END
    END
    MUTABLE rt_args: []Emittable = List[];
    IF needs_rt THEN
      &rt_args.append(Emittable{ Ident: COPY Ident{ name: mIRLowering__runtime_binding_name(&self), lowered_node_id: NIL, ownership_consumption: NIL } });
    END
    MUTABLE runtime_args = TRY (mIRLowering__inject_protocol_map_allocator_args(&self, callee_sig, node.args, args_mir));
    all_args = ((type_args + rt_args) + runtime_args);
    MUTABLE fn_zig = "${mod_prefix}${mIRLowering__zig_safe_name(self, UNWRAP (castCallNameToString(node.name)))}";
    MUTABLE owned_return = TRY (mIRLowering__call_owned_return?(&self, Node{ FuncCall: COPY node }));
    RETURN TRY (mIRLowering__finalize_call_result(&self, CallNode{ FuncCall: COPY node }, fn_zig, all_args, can_fail, owned_return, TRY (mIRLowering__callable_contract_for_lowered_args(&self, callee_sig, node.args, &args_mir, call_plans)), node.args, args_mir));
END
PRIVATE FN mIRLowering__lower_method_call(MUTABLE self: MIRLowering, MUTABLE node: MethodCall) RETURNS !Emittable ->
    MUTABLE mod_alias = NIL;
    IF node.object IS_A TenseNavigation THEN
      RETURN TRY (mIRLowering__lower_tense_navigation_method(&self, &node, castLocatableToTenseNavigation__mir_lowering(node.object)));
    END
    MUTABLE stub_name = (node.source_method_name OR_ELSE node.name);
    MUTABLE intercept: ?Emittable = TRY (mIRLowering__stub_intercept_for(&self, stub_name, node.object, node.args));
    IF intercept EXISTS AS intercept_value THEN
      RETURN COPY intercept_value;
    END
    IF node.protocol_name EXISTS AS protocol_name_value THEN
      MUTABLE protocol_name_value_mutable = COPY protocol_name_value;
      RETURN TRY (mIRLowering__lower_user_protocol_method_call(&self, node));
    END
    IF node.protocol_operation EXISTS AS protocol_operation_value THEN
      MUTABLE protocol_operation_value_mutable = COPY protocol_operation_value;
      IF (protocol_operation_value_mutable == :put) THEN
        RETURN TRY (mIRLowering__lower_protocol_map_put_call(&self, &node.object, UNWRAP (node.args[0]), UNWRAP (node.args[1])));
      END
      MUTABLE receiver: Emittable = CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(node.object))) AS Emittable);
      IF !(mIRLowering__collection_param_receiver?(&self, node.object)) THEN
        receiver = Emittable{ AddressOf: COPY AddressOf{ expr: COPY receiver, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
      MUTABLE arguments = node.args |> SELECT CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(_))) AS Emittable);
      IF (protocol_operation_value_mutable == :delete) THEN
        &arguments.append(TRY (mIRLowering__protocol_map_allocator_for(&self, &node.object)));
      END
      RETURN Emittable{ ProtocolCall: COPY ProtocolCall{ protocol: :Map, operation: protocol_operation_value_mutable, receiver: COPY receiver, args: COPY arguments, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF node.zig_pattern EXISTS AS zig_pattern_value THEN
      MUTABLE zig_pattern_value_mutable = COPY zig_pattern_value;
      IF (((node.object IS_A OptionalUnwrap AND (locatable__safe_navigation?(node.object) OR_ELSE FALSE))) OR ((locatable__safe_nav_chain(node.object) OR_ELSE FALSE))) THEN
        RETURN Emittable{ IfOptional: COPY TRY (mIRLowering__lower_safe_nav_method_call(&self, node)) };
      END
      RETURN TRY (mIRLowering__lower_intrinsic(&self, Node{ MethodCall: COPY node }));
    END
    IF node.extern_call THEN
      RETURN TRY (mIRLowering__lower_extern_method(&self, &node));
    END
    MUTABLE callee_sig: ?FunctionSignature@multiowned = TRY (mIRLowering__fn_sig_for(self, MIRLoweringName{ StringValue: COPY node.name }));
    callee_sig = (callee_sig OR_ELSE TRY (mIRLowering__matched_call_signature(self, CallNode{ MethodCall: COPY node })));
    MUTABLE lowered_recv_and_args = mIRLowering__with_kept_edge_call_frame(&self, %() USE(callee_sig, node, MUTABLE self) -> {
    MUTABLE recv = TRY (mIRLowering__lower_call_arg_from_facts(&self, TRY (mIRLowering__call_arg_facts(&self, node.object, callee_sig, 0))));
    IF (node.object IS_A Identifier AND ((locatable__symbol(node.object) != NIL) AND ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_364 = ((node.object.symbol)?);
    symbolEntry__carrier_contract(rtoc_local_receiver_364) } == :monomorphic))) THEN
        recv = Emittable{ ComptimeCarrierPayload: COPY ComptimeCarrierPayload{ source: COPY recv, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    MUTABLE method_args = COPY node.args;
    ([recv] + {
      MUTABLE rtoc_value_block_marker = 0;
      MUTABLE rtoc_indexed_items_365: []Locatable = method_args;
      MUTABLE rtoc_indexed_output_367 = [];
      MUTABLE rtoc_indexed_i_366 = 0;
      WHILE rtoc_indexed_i_366 < rtoc_indexed_items_365.length() DO
        &rtoc_indexed_output_367.append(TRY (mIRLowering__lower_call_arg_from_facts(&self, TRY (mIRLowering__call_arg_facts(&self, UNWRAP (rtoc_indexed_items_365[rtoc_indexed_i_366]), callee_sig, (rtoc_indexed_i_366 + 1))))));
        rtoc_indexed_i_366 = rtoc_indexed_i_366 + 1;
      END
      rtoc_indexed_output_367
    })
    });
    MUTABLE obj_mir = COPY UNWRAP (lowered_recv_and_args.first());
    MUTABLE args_mir = lowered_recv_and_args |> SKIP 1;
    MUTABLE mod_prefix: String = "";
    IF mod_alias THEN
      mod_prefix = "${mIRLowering__zig_module_alias(self, mod_alias)}.";
    ELSE
      mod_prefix = "";
    END
    MUTABLE needs_rt = TRY (mIRLowering__callee_needs_rt?(self, node.name));
    MUTABLE can_fail = TRY (mIRLowering__callee_can_fail?(self, node.name));
    IF (TRUE AND (node.retain_error_channel != NIL)) THEN
      can_fail = FALSE;
    END
    MUTABLE type_args =   IF (TRUE AND ((node.generic_type_args != NIL) AND type__any?(((node.generic_type_args)?)))) THEN
      node.generic_type_args |> SELECT Ident{ name: TRY (mIRLowering__generic_type_arg_zig(self, _)), lowered_node_id: NIL, ownership_consumption: NIL }
    ELSE
      List[]
    END;
    MUTABLE rt_args = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_369: ?[]Ident = NIL;
    IF needs_rt THEN
      rtoc_ternary_value_369 = [Ident{ name: mIRLowering__runtime_binding_name(&self), lowered_node_id: NIL, ownership_consumption: NIL }];
    ELSE
      rtoc_ternary_value_369 = List[];
    END
    rtoc_ternary_value_369? };
    MUTABLE ast_args = ([node.object] + node.args);
    MUTABLE mir_args = ([obj_mir] + args_mir);
    MUTABLE runtime_args = TRY (mIRLowering__inject_protocol_map_allocator_args(&self, callee_sig, ast_args, mir_args));
    MUTABLE all_args = ((type_args + rt_args) + runtime_args);
    MUTABLE fn_zig = "${mod_prefix}${mIRLowering__zig_safe_name(self, node.name)}";
    MUTABLE owned_return = TRY (mIRLowering__call_owned_return?(&self, Node{ MethodCall: COPY node }));
    RETURN mIRLowering__finalize_call_result(&self, CallNode{ MethodCall: COPY node }, fn_zig, all_args, can_fail, owned_return, mIRLowering__callable_contract_for_lowered_args(&self, callee_sig, ([node.object] + node.args), ([obj_mir] + args_mir), ( { MUTABLE rtoc_transform_keys_result_370: {Int64}CallEdgeOwnershipPlan = {}; FOR rtoc_key IN ((node.kept_edge_plans OR_ELSE {})).keys() DO rtoc_transform_keys_result_370[{ MUTABLE rtoc_value_block_marker = 0;
    MUTABLE k: Int64 = rtoc_key;
    (k + 1)
    }] = COPY UNWRAP (((node.kept_edge_plans OR_ELSE {}))[rtoc_key]); END rtoc_transform_keys_result_370 } )), ([node.object] + node.args), ([obj_mir] + args_mir));
END
PRIVATE FN mIRLowering__lower_tense_navigation_method(MUTABLE self: MIRLowering, MUTABLE node: MethodCall, navigation: TenseNavigation) RETURNS !Emittable ->
    RETURN mIRLowering__lower_tense_navigation(&self, Locatable{ MethodCall: COPY node }, navigation, %(receiver: String) USE(MUTABLE navigation, node, MUTABLE self) -> {
    MUTABLE synthetic_receiver = Identifier{ token: COPY navigation.token, name: COPY receiver, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, fn_ref: NIL, heap_dupe_result: NIL, atomic_borrow: NIL, ownership_pending_transfer: NIL };
    TRY (aST__stamp_synthetic_type_mut(Locatable{ Identifier: COPY synthetic_receiver }, CAST(COPY TRY (aST__full_type_mut(Locatable{ TenseNavigation: COPY navigation })) AS Type), "synthetic tense navigation receiver"));
    MUTABLE synthetic = COPY node;
    synthetic.object = Locatable{ Identifier: COPY synthetic_receiver };
    MUTABLE plan_opt: ?TenseOperationPlan = COPY CAST(node.tense_plan AS ?TenseOperationPlan);
    IF plan_opt == NIL THEN
        panic("tense navigation method lowering requires its annotation plan");
    END
    MUTABLE plan: TenseOperationPlan = COPY UNWRAP (plan_opt);
    TRY (aST__stamp_synthetic_type_mut(Locatable{ MethodCall: COPY synthetic }, TRY (tenseEnvelope__payload_type((TRY (tenseEnvelope__from_type(plan.result_type))))), "synthetic tense navigation method result"));
    TRY (mIRLowering__lower_method_call(&self, &synthetic))
    });
END
PRIVATE FN mIRLowering__lower_user_protocol_method_call(MUTABLE self: MIRLowering, node: MethodCall) RETURNS !Emittable ->
    MUTABLE ast_args = ([node.object] + node.args);
    MUTABLE receiver_type = TRY (aST__full_type_mut(node.object));
    RETURN TRY (mIRLowering__lower_user_protocol_call(&self, CallNode{ MethodCall: COPY node }, ast_args, receiver_type));
END
PRIVATE FN mIRLowering__lower_user_protocol_call(MUTABLE self: MIRLowering, MUTABLE node: CallNode, ast_args: []Locatable, receiver_type: Type) RETURNS !Emittable ->
    MUTABLE signature = UNWRAP (TRY (mIRLowering__matched_call_signature(self, node)));
    MUTABLE mir_args = {
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE rtoc_indexed_items_371: []Locatable = ast_args;
    MUTABLE rtoc_indexed_output_373 = [];
    MUTABLE rtoc_indexed_i_372 = 0;
    WHILE rtoc_indexed_i_372 < rtoc_indexed_items_371.length() DO
      &rtoc_indexed_output_373.append(TRY (mIRLowering__lower_call_arg_from_facts(&self, TRY (mIRLowering__call_arg_facts(&self, UNWRAP (rtoc_indexed_items_371[rtoc_indexed_i_372]), signature, rtoc_indexed_i_372)))));
      rtoc_indexed_i_372 = rtoc_indexed_i_372 + 1;
    END
    rtoc_indexed_output_373
    };
    MUTABLE receiver_index = IF node IS_A FuncCall THEN
      ((callNode__protocol_receiver_index(node) OR_ELSE 0))
    ELSE
      0
    END;
    MUTABLE receiver = COPY UNWRAP (ast_args[receiver_index]);
    MUTABLE type_arg = Ident{ name: TRY (mIRLowering__user_protocol_receiver_type_arg(&self, receiver, receiver_type)), lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE all_args: []Emittable = ([Emittable{ Ident: COPY type_arg }, Emittable{ Ident: COPY Ident{ name: mIRLowering__runtime_binding_name(&self), lowered_node_id: NIL, ownership_consumption: NIL } }] + mir_args);
    MUTABLE protocol_name: String = "";
    MATCH node START
      CallNode.FuncCall AS item ->
        protocol_name = COPY (item.protocol_name OR_ELSE "");,
      CallNode.MethodCall AS item ->
        protocol_name = COPY (item.protocol_name OR_ELSE "");,
    END
    MUTABLE protocol_operation: String@symbol = :none;
    MATCH node START
      CallNode.FuncCall AS item ->
        protocol_operation = COPY (item.protocol_operation OR_ELSE :none);,
      CallNode.MethodCall AS item ->
        protocol_operation = COPY (item.protocol_operation OR_ELSE :none);,
    END
    MUTABLE fn_zig = "__clearProtocol_${protocol_name}_${mIRLowering__zig_safe_name(self, CAST(protocol_operation AS String))}";
    MUTABLE can_fail = type__error_union?(functionSignature__return_type(signature));
    RETURN TRY (mIRLowering__finalize_call_result(&self, &node, fn_zig, all_args, can_fail, TRY (mIRLowering__call_owned_return?(&self, castCallNodeToNode(node))), TRY (mIRLowering__callable_contract_for_lowered_args(&self, signature, ast_args, &mir_args)), ast_args, mir_args));
END
PRIVATE FN mIRLowering__user_protocol_receiver_type_arg(MUTABLE self: MIRLowering, receiver: Locatable, receiver_type: Type) RETURNS !String ->
    MUTABLE root: ?Identifier = aST__root_identifier(receiver);
    MUTABLE polymorphic_type: ?String = NIL;
    IF root EXISTS AS root_value THEN
      IF mIRLowering__capability_state(&self).polymorphic_alias_type_map EXISTS AS alias_type_map THEN
        polymorphic_type = COPY alias_type_map[CAST(root_value.name AS String)];
      END
    END
    IF polymorphic_type EXISTS AS polymorphic_type_value THEN
      RETURN COPY polymorphic_type_value;
    END
    RETURN TRY (mIRLowering__generic_type_arg_zig(self, TypeTypeInput{ Type: COPY receiver_type }));
END
PRIVATE FN mIRLowering__inject_protocol_map_allocator_args(MUTABLE self: MIRLowering, signature: ?FunctionSignature, ast_args: []Locatable, mir_args: []Emittable) RETURNS ![]Emittable ->
    IF signature EXISTS AS signature_value THEN
      MUTABLE rtoc_out: []Emittable = List[];
      MUTABLE rtoc_i: Int64 = 0;
      WHILE (rtoc_i < mir_args.length()) DO
        MUTABLE rtoc_param: ?Param = COPY (TRY (functionSignature__params(signature_value)))[rtoc_i];
        &rtoc_out.append(COPY UNWRAP (mir_args[rtoc_i]));
        IF rtoc_param EXISTS AS rtoc_param_value THEN
          IF mIRLowering__protocol_map_signature_param?(self, signature_value, rtoc_param_value) THEN
            &rtoc_out.append(TRY (mIRLowering__protocol_map_allocator_for(&self, UNWRAP (ast_args[rtoc_i]))));
          END
        END
        rtoc_i = rtoc_i + 1;
      END
      RETURN rtoc_out;
    ELSE
      RETURN COPY mir_args;
    END
END
PRIVATE FN mIRLowering__protocol_map_signature_param?(self: MIRLowering, signature: FunctionSignature, param: Param) RETURNS Bool ->
    MUTABLE bounds: ?[]Type = COPY signature.generic_bounds[type__resolved(param.type)];
    RETURN !(!((((bounds != NIL) AND (bounds |> ANY (type__resolved(_) == :Map))))));
END
PRIVATE FN mIRLowering__protocol_map_allocator_for(MUTABLE self: MIRLowering, MUTABLE node: Locatable) RETURNS !Emittable ->
    MUTABLE root: ?Identifier = mIRLowering__root_receiver_node(self, node);
    IF root EXISTS AS root_value THEN
      MUTABLE hidden: ?String = mIRLowering__current_function_protocol_map_allocator(&self, root_value.name);
      IF hidden EXISTS AS hidden_value THEN
        RETURN Emittable{ Ident: COPY Ident{ name: COPY hidden_value, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
    END
    RETURN Emittable{ AllocatorRef: COPY AllocatorRef{ kind: COPY TRY (mIRLowering__placement_for_node(&self, node)), lowered_node_id: NIL, ownership_consumption: NIL } };
END
PRIVATE FN mIRLowering__lower_protocol_map_put_call(MUTABLE self: MIRLowering, MUTABLE receiver_node: Locatable, key_node: Locatable, MUTABLE value_node: Locatable) RETURNS !Emittable ->
    MUTABLE receiver: Emittable = CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(receiver_node))) AS Emittable);
    IF !(mIRLowering__collection_param_receiver?(&self, receiver_node)) THEN
      receiver = Emittable{ AddressOf: COPY AddressOf{ expr: COPY receiver, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    MUTABLE sink_alloc = TRY (mIRLowering__placement_for_node(&self, receiver_node));
    MUTABLE sink_type = typeExpression__of( TypeExpressionKind{ TypeProjectionExpression: COPY TypeProjectionExpression{ owner: COPY type__resolved((TRY (aST__full_type_mut(receiver_node)))), member: :MIRLoweringValue, protocol: NIL } });
    MUTABLE value: ?Emittable = mIRLowering__with_sink_type(&self, TRY (type__new(TypeConstructionInput{ TypeExpression: COPY sink_type })), %() USE(sink_alloc, value_node, MUTABLE self) -> {
    MUTABLE rtoc_lambda_result_380: ?Emittable = mIRLowering__with_decl_alloc(&self, sink_alloc, %() USE(value_node, MUTABLE self) -> {
    rtoc_lambda_result_379 = CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(value_node))) AS Emittable);
    rtoc_lambda_result_379
    });
    rtoc_lambda_result_380
    });
    value = TRY (mIRLowering__materialize_owned_sink_value(&self, value, value_node, sink_alloc, TypeTypeInput{ Type: COPY TRY (type__new(TypeConstructionInput{ TypeExpression: COPY sink_type })) }));
    IF TRY (mIRLowering__mir_allocates?(&self, value)) THEN
      value = TRY (mIRLowering__hoist_alloc(&self, &value, &value_node, TRUE));
    END
    MUTABLE allocator = TRY (mIRLowering__protocol_map_allocator_for(&self, &receiver_node));
    MUTABLE call = ProtocolCall{ protocol: :Map, operation: :put, receiver: COPY receiver, args: [CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(key_node))) AS Emittable), value, allocator, allocator], lowered_node_id: NIL, ownership_consumption: NIL };
    RETURN TRY (mIRLowering__with_ownership_consumption_for_value(&self, Emittable{ ProtocolCall: COPY call }, &value, &value_node, "Map protocol put", :owned_sink, sink_alloc));
END
PRIVATE FN mIRLowering__call_owned_return?(MUTABLE self: MIRLowering, node: Node) RETURNS !Bool ->
    MUTABLE sig: ?FunctionSignature@multiowned = NIL;
    IF aST__node_name(UNWRAP (castNodeToLocatable(node))) EXISTS AS rtoc_node_name THEN
      sig = TRY (mIRLowering__fn_sig_for(self, MIRLoweringName{ SymbolValue: symbol(COPY rtoc_node_name) }));
    END
    IF aST__node__matched_signature( UNWRAP (castNodeToLocatable(node))) EXISTS THEN
      sig = (sig OR_ELSE aST__node__matched_signature( UNWRAP (castNodeToLocatable(node))));
    END
    IF (((sig != NIL) AND TRUE) AND !(((TRY (functionSignature__return_lifetime(sig))).length() == 0))) THEN
      IF !(((functionSignature__heap_carry_return(sig) == TRUE) OR TRY (functionSignature__heap_return_alloc?(sig)))) THEN
        RETURN FALSE;
      END
    END
    MUTABLE node_ti: Type = TRY (type__from_node_mut(castNodeToLocatable(node), "call owned return"));
    IF node IS_A FunctionDef AS function_def THEN
      node_ti = COPY functionDef__lowering_return_type(function_def);
    END
    IF (!(type__any?(node_ti)) AND !(type__auto?(node_ti))) THEN
      RETURN TRY (mIRLowering__concrete_call_type_owned_return?(&self, node_ti, sig));
    END
    IF !(node IS_A FunctionDef) THEN
      MUTABLE dep: ?Bool = TRY (mIRLowering__call_owned_return_from_args?(&self, castNodeToCallNode(node), sig));
      IF !((dep == NIL)) THEN
        RETURN dep;
      END
    END
    # `raw_ti = sig&.return_type` then `raw_ti.is_a?(Type) ? raw_ti : ...` --
    # the CLEAR return_type is already a Type, so the branch is the identity
    # and the temp only cost the consuming node its provenance.
    MUTABLE ti: ?Type = NIL;
    IF sig EXISTS AS rtoc_sig_for_ti THEN
      ti = COPY functionSignature__return_type(rtoc_sig_for_ti);
    END
    RETURN TRY (mIRLowering__call_type_owned_return?(&self, ti, sig));
END
PRIVATE FN mIRLowering__call_never_returns_success?(self: MIRLowering, node: CallNode) RETURNS !Bool ->
    IF !((aST__node_name( castCallNodeToLocatable(node)) EXISTS)) THEN
      RETURN FALSE;
    END
    MUTABLE fn: ?FunctionDef@multiowned = COPY mIRLowering__program_state(self).fn_nodes[CAST(aST__node_name(castCallNodeToLocatable(node)) AS String)];
    IF !((fn != NIL)) THEN
      RETURN FALSE;
    END
    MUTABLE fn_ret: Type = TRY (functionDef__lowering_return_type(fn));
    IF !(type__error_union?(fn_ret)) THEN
      RETURN FALSE;
    END
    RETURN !(TRY (mIRLowering__function_body_has_value_return?(self, CAST(fn.body AS []Node))));
END
PRIVATE FN mIRLowering__function_body_has_value_return?(self: MIRLowering, nodes: []Node) RETURNS !Bool
