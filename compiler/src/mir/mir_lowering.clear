PRIVATE FN mIRLowering__with_binding_materialization(MUTABLE self: MIRLowering, MUTABLE node: WithBlock, with_label: ?String, rt_name: String) RETURNS !WithBindingMaterialization ->
    MUTABLE materialization = WithBindingMaterialization{ bindings: List[], fallible_clauses: List[] };
    MUTABLE caps = TRY (mIRLowering__with_capability_specs(self, node));
    MUTABLE clause: ?ErrorClause = COPY CAST(node.lock_error_clause AS ?ErrorClause);
    MUTABLE fallible_caps = caps |> WHERE ([symbol("EXCLUSIVE"), :write_locked_read]).contains?(_.capability);
    MUTABLE needs_sort = (fallible_caps.length() >= 2);
    IF needs_sort THEN
      TRY (mIRLowering__materialize_sorted_lock_bindings(&self, node, &materialization, fallible_caps, clause, with_label));
    END
    FOR _ IN caps DO
    MUTABLE context = TRY (mIRLowering__with_capability_binding_context(&self, node, _, clause, with_label, needs_sort, rt_name));
    TRY (mIRLowering__materialize_with_capability_binding(&self, &materialization, context));
    END
    RETURN materialization;
END
PRIVATE FN mIRLowering__with_capability_specs(self: MIRLowering, node: WithBlock) RETURNS ![]CapabilityTransition ->
    RETURN COPY (TRY (capabilityPlan__require_for(node))).all;
END
PRIVATE FN mIRLowering__materialize_sorted_lock_bindings(MUTABLE self: MIRLowering, node: WithBlock, MUTABLE materialization: WithBindingMaterialization, fallible_caps: []CapabilityTransition, clause: ?ErrorClause, with_label: ?String) RETURNS !Void ->
    IF clause EXISTS AS clause_value THEN
      MUTABLE clause_value_mutable = COPY clause_value;
      withBindingMaterialization__add_binding( &materialization, WithBindingNode{ Emittable: COPY CAST(TRY (mIRLowering__sorted_lock_acquire(&self, fallible_caps, clause_value_mutable, with_label, node)) AS Emittable) });
      FOR _ IN fallible_caps DO
    MUTABLE var_name = COPY _.target_label;
    MUTABLE alias_name = COPY _.alias_name;
    withBindingMaterialization__add_fallible_clause( &materialization, TRY (mIRLowering__build_fallible_clause_mir(&self, var_name, alias_name, clause_value_mutable)));
      END
    ELSE
      withBindingMaterialization__add_binding( &materialization, WithBindingNode{ Emittable: COPY CAST(TRY (mIRLowering__sorted_lock_acquire(&self, fallible_caps, NIL, with_label, node)) AS Emittable) });
