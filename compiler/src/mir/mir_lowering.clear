    stream_run_body = mIRLowering__finalized_boundary_body_for_emit(rtoc_self_view, ((mIRLowering__capture_ownership_mirror_nodes(rtoc_self_view, caps, analysis, "ctx") + stream_capture_cleanups) + body_mir));
    stream_emit_body = stream_run_body |> WHERE !((mIRLowering__capture_ownership_mirror_node?(rtoc_self_view, _, "ctx") OR stream_capture_cleanups.contains?(_)));
    NIL
    });
    rtoc_lambda_result_522
    });
    MUTABLE promoted_decls = mIRLowering__capture_setup_stmts(rtoc_self_view, caps.specs);
    MUTABLE task_cfg = mIRLowering__task_config_plan(rtoc_self_view, node.stack_size, node.computed_stack_tier);
    MUTABLE spawn_call = mIRLowering__fiber_spawn_call_plan(rtoc_self_view, rt_name, ctx_type, ctx_var, task_cfg, PinMode{ SymbolValue: :local });
    MUTABLE plan = BgStreamPlan{ id: id.value, ctx_type: COPY ctx_type, alloc_var: COPY alloc_var, stream_var: COPY stream_var, ctx_var: COPY ctx_var, blk_label: COPY blk_label, stream_zig: COPY stream_zig, local_stream: COPY local_stream, capture_fields: COPY capture_fields, capture_inits: COPY capture_inits, promoted_decls: COPY promoted_decls, capture_cleanups: COPY stream_capture_cleanups, body: COPY stream_emit_body, spawn_call: COPY spawn_call, rt_name: COPY rt_name };
    MUTABLE bg = MIRBgBlock{ code: BgBlockPlan{ BgStreamPlan: COPY plan }, captures: COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_523: ?{Any}Any = NIL;
    IF analysis THEN
      rtoc_ternary_value_523 = analysis.captures();
    ELSE
      rtoc_ternary_value_523 = {};
    END
    rtoc_ternary_value_523? }, run_body: COPY (stream_run_body OR List[]), fsm_structure: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, boundary_fact: NIL, result_type: NIL };
    bg.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY tense_t }));
    bg.boundary_fact = mIRLowering__execution_boundary_fact(rtoc_self_view, :bg_stream, :local, analysis);
    RETURN MIRLoweringReturnValue{ MIRBgBlock: COPY bg };
}
END
PRIVATE FN mIRLowering__lower_yield(MUTABLE self: MIRLowering, node: YieldExpr) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE stream_local = (mIRLowering__capture_state(rtoc_self_view).current_stream_local OR_ELSE "__stream_local");
    MUTABLE lowered = mIRLowering__with_decl_alloc(rtoc_self_view, :heap, %() USE(node, MUTABLE rtoc_self_view) -> {
    MUTABLE value = TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(node.expr)));
    TRY (mIRLowering__place_value_for_destination(rtoc_self_view, value, node.expr, :heap, &node.expr.full_type_mut()))
    });
    IF mIRLowering__mir_allocates?(rtoc_self_view, lowered) THEN
      lowered = mIRLowering__hoist_alloc(rtoc_self_view, lowered, node.expr, TRUE);
    END
    MUTABLE transfer_marks = mIRLowering__ownership_marks_for_transferred_temp(rtoc_self_view, lowered, :heap);
    IF (mIRLowering__bc_target?(rtoc_self_view) AND (mIRLowering__capture_state(rtoc_self_view).current_stream_is_inf != NIL)) THEN
      MUTABLE stream_yield = StreamYield{ value: COPY lowered, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
      IF (transfer_marks.length() == 0) THEN
        RETURN Emittable{ StreamYield: COPY stream_yield };
      ELSE
        RETURN Emittable{ ScopeBlock: COPY ScopeBlock{ body: COPY (transfer_marks + [stream_yield]), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
      END
    END
    MUTABLE base_contract = TRY (callableContract__no_ownership(1));
    MUTABLE push_contract_branch_value: ?CallableContract = NIL;
    IF ((transfer_marks.length() == 0) OR !(lowered IS_A Ident)) THEN
      push_contract_branch_value = base_contract;
    ELSE
      MUTABLE operand = ownershipOperandFact__owned_binding(CAST(lowered.name() AS String), TRY (type__from_node_mut(node.expr, "YIELD ownership transfer")), "stream YIELD push", :heap);
      push_contract_branch_value = callableContract__new(base_contract.signature, TRY (ownershipContract__consume_operands([operand])), 1);
    END
    MUTABLE push_contract: CallableContract = push_contract_branch_value?;
    MUTABLE push = MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: stream_local, lowered_node_id: NIL, ownership_consumption: NIL } }, method: "push", args: [CAST(lowered AS Any)], try_wrap: TRUE, callable_contract: COPY push_contract, owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    IF (transfer_marks.length() == 0) THEN
      RETURN Emittable{ MIRMethodCall: COPY push };
    ELSE
      RETURN Emittable{ ScopeBlock: COPY ScopeBlock{ body: COPY (transfer_marks + [ExprStmt{ expr: Emittable{ MIRMethodCall: COPY push }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }]), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
}
END
PRIVATE FN mIRLowering__lower_close_stream(self: MIRLowering, ignored_node: CloseStream) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE stream_local = (mIRLowering__capture_state(rtoc_self_view).current_stream_local OR_ELSE "__stream_local");
    MUTABLE close = ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: stream_local, lowered_node_id: NIL, ownership_consumption: NIL } }, method: "close", args: ( { MUTABLE rtoc_empty_list_524: []Any = List[]; rtoc_empty_list_524 } ), try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    MUTABLE label: ?String = COPY mIRLowering__capture_state(rtoc_self_view).current_stream_close_label;
    IF (mIRLowering__bc_target?(rtoc_self_view) AND (label != NIL)) THEN
      RETURN Emittable{ ScopeBlock: COPY ScopeBlock{ body: COPY CAST(Tuple{close, BreakStmt{ label: COPY label, value: Emittable{ Ident: COPY Ident{ name: stream_local, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }} AS Tuple<ExprStmt, BreakStmt>), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
    RETURN Emittable{ ScopeBlock: COPY ScopeBlock{ body: COPY CAST(Tuple{close, ReturnStmt{ value: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }} AS Tuple<ExprStmt, ReturnStmt>), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
}
END
PRIVATE FN mIRLowering__next_result_owned_alloc(self: MIRLowering, promise_type: Type, result_type: Type, fallback_alloc: String@symbol) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF type__promise_list?(promise_type) THEN
      RETURN fallback_alloc;
    END
    IF TRY (type__observable_array_future?(promise_type)) THEN
      RETURN fallback_alloc;
    END
    IF (type__observable?(promise_type) AND mIRLowering__ownership_bearing_type?(rtoc_self_view, result_type)) THEN
      RETURN :heap;
    END
    IF mIRLowering__ownership_bearing_type?(rtoc_self_view, result_type) THEN
      RETURN :heap;
    END
    RETURN NIL;
}
END
PRIVATE FN mIRLowering__next_expr_plan(MUTABLE self: MIRLowering, MUTABLE node: NextExpr, alloc_sym: String@symbol) RETURNS !NextExprPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE promise_type = TRY (type__new(&node.expr.full_type_mut()));
    MUTABLE result_type = &node.full_type_mut("NEXT result");
    MUTABLE async_shape = IF node.expr IS_A Identifier THEN
      (IF node.expr.symbol() != NIL THEN
      { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_526 = (node.expr.symbol());
    symbolEntry__async_result_shape(rtoc_local_receiver_526) }
    ELSE
      NIL
    END)
    ELSE
      NIL
    END;
    MUTABLE tense_plan: ?TenseOperationPlan = COPY CAST(node.tense_plan AS ?TenseOperationPlan);
    MUTABLE scalar_future = ((async_shape.promise?() OR_ELSE TRY (type__single_future?(promise_type))) OR type__shared_promise?(promise_type));
    IF (scalar_future AND FALSE) THEN
      async_shape = TRY (asyncResultShape__promise(TRY (type__tense_type(promise_type)), type__shared_promise?(promise_type)));
    END
    IF (scalar_future AND ((!(tense_plan) OR (tense_plan.operation != TenseOperationKind.Next)))) THEN
      panic("scalar NEXT lowering requires its annotation-produced TenseOperationPlan");
    END
    MUTABLE source_kind =   IF (type__promise_list?(promise_type) AND FALSE) THEN
      :promise_list
    ELSE_IF tense_plan THEN
      (PARTIAL MATCH tense_plan.backend_form START
      TenseBackendForm.SharedPromiseNext -> :shared_promise,
      TenseBackendForm.ObservableStringNext -> :observable_string,
      DEFAULT -> :plain
    END)
    ELSE_IF TRY (type__observable_array_future?(promise_type)) THEN
      :observable_list
    ELSE_IF (type__observable?(promise_type) AND mIRLowering__observable_next_string?(rtoc_self_view, promise_type)) THEN
      :observable_string
    ELSE
      :plain
    END;
    RETURN NextExprPlan{ source_kind: COPY source_kind, promise_type: COPY promise_type, async_result_shape: COPY async_shape, result_type: COPY result_type, result_alloc: COPY mIRLowering__next_result_owned_alloc(rtoc_self_view, promise_type, result_type, alloc_sym), inner: COPY CAST(TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(node.expr))) AS Emittable) };
}
END
PRIVATE FN mIRLowering__observable_next_string?(self: MIRLowering, promise_type: Type) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE tt = TRY (type__tense_type(promise_type));
    MUTABLE wt = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_528: ?Type = NIL;
    IF type__optional?(tt) THEN
      rtoc_ternary_value_528 = TRY (type__wrapped_type(tt));
    ELSE
      rtoc_ternary_value_528 = tt;
    END
    rtoc_ternary_value_528 };
    RETURN !(!((IF wt != NIL THEN
      TRY (type__string?(wt))
    ELSE
      NIL
    END)));
}
END
PRIVATE FN mIRLowering__bg_stream_expected_type?(self: MIRLowering, type_info: ?Type) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF type_info EXISTS AS type_info_value THEN
      RETURN ((TRY (type__inf_stream?(type_info_value)) OR TRY (type__open_stream?(type_info_value))) OR TRY (type__bounded_stream?(type_info_value)));
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN mIRLowering__lower_next_expr(MUTABLE self: MIRLowering, MUTABLE node: NextExpr, alloc_sym: String@symbol = :frame) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE plan = mIRLowering__next_expr_plan(&rtoc_self_view, &node, alloc_sym);
    MUTABLE promise_type = COPY plan.promise_type;
    MUTABLE result_t = COPY plan.result_type;
    IF nextExprPlan__promise_list?(plan) THEN
      MUTABLE promise_list_inner = COPY plan.inner;
      IF mIRLowering__bc_target?(rtoc_self_view) THEN
        MUTABLE call = MIRMethodCall{ receiver: COPY promise_list_inner, method: "next", args: ( { MUTABLE rtoc_empty_list_529: []Any = List[]; rtoc_empty_list_529 } ), try_wrap: TRUE, callable_contract: COPY TRY (callableContract__no_ownership(0)), owned_result_alloc: COPY alloc_sym, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
        call.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY result_t }));
        RETURN Emittable{ MIRMethodCall: COPY call };
      END
      MUTABLE item_shape = TRY (asyncResultShape__promise_list_item(promise_type));
      MUTABLE tmp_id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_530 = mIRLowering__lowering_counters(rtoc_self_view);
      mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_530) };
      MUTABLE promise_list_label = "__next_all_${tmp_id}";
      MUTABLE results_var = "__next_results_${tmp_id}";
      RETURN Emittable{ NextPromiseList: COPY NextPromiseList{ list_expr: COPY promise_list_inner, async_shape: COPY item_shape, label: COPY promise_list_label, results_var: COPY results_var, alloc: COPY alloc_sym, result_type: COPY result_t } };
    END
    IF nextExprPlan__observable_list?(plan) THEN
      MUTABLE observable_list_inner = COPY plan.inner;
      MUTABLE call = MIRMethodCall{ receiver: COPY observable_list_inner, method: "materializeNext", args: [CAST(AllocatorRef{ kind: COPY alloc_sym, lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: TRUE, callable_contract: COPY TRY (callableContract__no_ownership(1)), owned_result_alloc: COPY alloc_sym, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
      call.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY result_t }));
      RETURN Emittable{ MIRMethodCall: COPY call };
    END
    IF nextExprPlan__observable_string?(plan) THEN
      MUTABLE observable_string_inner = COPY plan.inner;
      MUTABLE observable_string_label = "__obs_next_string_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_531 = mIRLowering__lowering_counters(rtoc_self_view);
      mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_531) }}";
      MUTABLE materialize = MIRMethodCall{ receiver: COPY observable_string_inner, method: "materialize", args: [CAST(AllocatorRef{ kind: :heap, lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: TRUE, callable_contract: COPY TRY (callableContract__no_ownership(1)), owned_result_alloc: :heap, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
      materialize.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY result_t }));
      MUTABLE block = MIRBlockExpr{ label: observable_string_label, body: COPY CAST(Tuple{ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: COPY observable_string_inner, method: "wait", args: ( { MUTABLE rtoc_empty_list_532: []Any = List[]; rtoc_empty_list_532 } ), try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }, BreakStmt{ label: COPY observable_string_label, value: Emittable{ MIRMethodCall: COPY materialize }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }} AS Tuple<ExprStmt, BreakStmt>), lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
      block.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY result_t }));
      RETURN Emittable{ MIRBlockExpr: COPY block };
    END
    MUTABLE receiver = COPY plan.inner;
    IF (TRY (type__stream?(promise_type)) AND !(receiver IS_A Ident)) THEN
      MUTABLE receiver_tmp_id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_533 = mIRLowering__lowering_counters(rtoc_self_view);
      mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_533) };
      MUTABLE label = "__next_recv_${receiver_tmp_id}";
      MUTABLE temp = "__next_source_${receiver_tmp_id}";
      MUTABLE block = MIRBlockExpr{ label: label, body: COPY CAST(Tuple{Let{ name: COPY temp, init: COPY receiver, mutable: TRUE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }, BreakStmt{ label: COPY label, value: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: temp, lowered_node_id: NIL, ownership_consumption: NIL } }, method: IF TRY (type__stream_step?(result_t)) THEN
        "nextStep"
      ELSE
        "next"
      END, args: ( { MUTABLE rtoc_empty_list_534: []Any = List[]; rtoc_empty_list_534 } ), try_wrap: TRUE, callable_contract: COPY TRY (callableContract__no_ownership(0)), owned_result_alloc: COPY plan.result_alloc, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }} AS Tuple<Let, BreakStmt>), lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
      block.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY result_t }));
      RETURN Emittable{ MIRBlockExpr: COPY block };
    END
    MUTABLE next_method: String = "";
    IF TRY (type__stream_step?(result_t)) THEN
      next_method = "nextStep";
    ELSE
      next_method = "next";
    END
    MUTABLE boxed_fallible = (!(mIRLowering__bc_target?(rtoc_self_view)) AND ((plan.async_result_shape != NIL) AND (asyncResultShape__boxes_fallible_payload?(((plan.async_result_shape)?)) == TRUE)));
    MUTABLE call = MIRMethodCall{ receiver: COPY receiver, method: COPY next_method, args: ( { MUTABLE rtoc_empty_list_535: []Any = List[]; rtoc_empty_list_535 } ), try_wrap: !(boxed_fallible), callable_contract: COPY TRY (callableContract__no_ownership(0)), owned_result_alloc: COPY plan.result_alloc, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    IF !(boxed_fallible) THEN
      RETURN Emittable{ MIRMethodCall: COPY call };
    END
    MUTABLE unwrapped_transport = TryExpr{ expr: Emittable{ MIRMethodCall: COPY call }, lowered_node_id: NIL, ownership_consumption: NIL };
    RETURN Emittable{ AsyncPayloadTake: COPY AsyncPayloadTake{ source: Emittable{ TryExpr: COPY unwrapped_transport }, result_type: COPY TRY (type__new(TypeConstructionInput{ Type: COPY result_t })) } };
}
END
PRIVATE FN mIRLowering__lower_literal(self: MIRLowering, node: Literal) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (node.type == :SYMBOL) THEN
      RETURN Emittable{ SymbolLit: COPY SymbolLit{ value: COPY CAST(node.value AS String), lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE_IF (node.type == :STRING) THEN
      MUTABLE escaped = (node.value.bytes() |> SELECT PARTIAL MATCH _ START
        92 -> "\\\\",
        34 -> "\\\"",
        10 -> "\\n",
        13 -> "\\r",
        9 -> "\\t",
        0 -> "\\x00",
        1 ..= 31 -> "\\x${compilerFormatTemplate("%02x")}",
        127 -> "\\x${compilerFormatTemplate("%02x")}",
        128 ..= 255 -> "\\x${compilerFormatTemplate("%02x")}",
        DEFAULT -> codepointToString(_)
      END).join("");
      RETURN Emittable{ Lit: COPY Lit{ value: "\"${escaped}\"", lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE_IF (node.type == :NUMBER) THEN
      IF ruby_union_scalar_equal_optional_CoerceTypeInput_String_symbol(node.coerced_type(), :Int64) THEN
        RETURN Emittable{ Lit: COPY Lit{ value: COPY (TRY (node.value.toInt())).toString(), lowered_node_id: NIL, ownership_consumption: NIL } };
      ELSE
        RETURN Emittable{ Lit: COPY Lit{ value: COPY mIRLowering__float_literal_text(rtoc_self_view, node.value), lowered_node_id: NIL, ownership_consumption: NIL } };
      END
    ELSE_IF (node.type == :INT8) OR (node.type == :INT16) OR (node.type == :INT32) OR (node.type == :UINT16) OR (node.type == :UINT32) OR (node.type == :UINT64) THEN
      RETURN Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ Lit: COPY Lit{ value: COPY CAST(node.value AS String), lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: COPY (CAST({:INT8: "i8", :INT16: "i16", :INT32: "i32", :UINT16: "u16", :UINT32: "u32", :UINT64: "u64"} AS {String@symbol}String))[node.type]?, method: :as, lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE_IF (node.type == :FLOAT32) THEN
      RETURN Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ Lit: COPY Lit{ value: COPY mIRLowering__float_literal_text(rtoc_self_view, node.value), lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: "f32", method: :as, lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE_IF (node.type == symbol("NIL")) THEN
      RETURN Emittable{ Lit: COPY Lit{ value: "null", lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE
      RETURN Emittable{ Lit: COPY Lit{ value: COPY CAST(node.value AS String), lowered_node_id: NIL, ownership_consumption: NIL } };
    END
}
END
PRIVATE FN mIRLowering__float_literal_text(self: MIRLowering, value: Value) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE s = COPY CAST(value AS String);
    IF (ruby_union_scalar_equal_Value_Int64(value, castValueToInt64(value)) AND !(s.contains?("."))) THEN
      RETURN "${s}.0";
    ELSE
      RETURN s;
    END
}
END
PRIVATE FN mIRLowering__lower_identifier(self: MIRLowering, MUTABLE node: Identifier) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF mIRLowering__synthetic_pipeline_binding_name?(rtoc_self_view, node.name) THEN
      MUTABLE line: String = "?";
      IF node.token != NIL THEN
        line = ((node.token)?).line;
      END
      panic("{}{}in the same pipeline expression where they are used.");
    END
    IF (TRUE AND node.fn_ref) THEN
      RETURN Emittable{ FnRef: COPY FnRef{ name: mIRLowering__zig_safe_name(rtoc_self_view, node.name), lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    MUTABLE rc_map = (mIRLowering__capability_state(rtoc_self_view).rc_unwrap_map OR_ELSE {});
    IF rc_map.contains?(node.name) THEN
      RETURN Emittable{ Ident: COPY Ident{ name: COPY rc_map[node.name], lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    MUTABLE locked_map = (mIRLowering__capability_state(rtoc_self_view).locked_unwrap_map OR_ELSE {});
    MUTABLE alias_name: ?LockedUnwrapMapValue = COPY locked_map[node.name];
    IF alias_name? IS_A String AS string THEN
      RETURN Emittable{ Ident: COPY Ident{ name: COPY string, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    MUTABLE capture_map = (mIRLowering__capture_state(rtoc_self_view).do_capture_map OR_ELSE {});
    IF capture_map.contains?(node.name) THEN
      MUTABLE ident = Ident{ name: COPY capture_map[node.name], lowered_node_id: NIL, ownership_consumption: NIL };
      IF mIRLowering__atomic_capture_load?(rtoc_self_view, node) THEN
        RETURN Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY ident }, method: "load", args: ( { MUTABLE rtoc_empty_list_536: []Any = List[]; rtoc_empty_list_536 } ), try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } };
      END
      RETURN Emittable{ Ident: COPY ident };
    END
    MUTABLE decl_node: ?SymbolEntryRegInput = NIL;
    IF node.symbol != NIL THEN
      decl_node = COPY ((node.symbol)?).reg;
    END
    MUTABLE zig_name = (((((decl_node != NIL) AND ((TRY (functionState__decl_zig_names(mIRLowering__function_state(rtoc_self_view))))[decl_node.object_id()] != NIL))) OR (TRY (functionState__rename_map(mIRLowering__function_state(rtoc_self_view))))[mIRLowering__zig_safe_name(rtoc_self_view, node.name)]) OR mIRLowering__zig_safe_name(rtoc_self_view, node.name));
    MUTABLE ident = Ident{ name: zig_name, lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE symbol: ?SymbolEntry = COPY node.symbol;
    IF (((symbol != NIL) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_537 = (symbol?);
    symbolEntry__atomic?(rtoc_local_receiver_537) }) AND !(mIRLowering__capability_state(rtoc_self_view).atomic_emit_raw)) THEN
      IF node.atomic_borrow THEN
        RETURN Emittable{ Ident: COPY ident };
      END
      IF symbolEntry__indirect?(symbol) THEN
        RETURN Emittable{ Ident: COPY ident };
      END
      RETURN Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Deref: COPY Deref{ expr: Emittable{ Ident: COPY ident }, lowered_node_id: NIL, ownership_consumption: NIL } }, method: "load", args: ( { MUTABLE rtoc_empty_list_538: []Any = List[]; rtoc_empty_list_538 } ), try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } };
    END
    IF (TRUE AND node.heap_dupe_result) THEN
      RETURN Emittable{ DupeSlice: COPY DupeSlice{ source: Emittable{ Ident: COPY ident }, alloc: :heap, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    MUTABLE binding_type: ?Type@multiowned = NIL;
    IF symbol != NIL THEN
      binding_type = COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_539 = (symbol?);
    symbolEntry__type(rtoc_local_receiver_539) };
    END
    IF ((binding_type != NIL) AND type__optional?(binding_type)) THEN
      MUTABLE stamped = &node.full_type_mut("identifier lowering");
      IF !(type__optional?(stamped)) THEN
        RETURN Emittable{ MIROptionalUnwrap: COPY MIROptionalUnwrap{ expr: Emittable{ Ident: COPY ident }, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
    END
    RETURN Emittable{ Ident: COPY ident };
}
END
PRIVATE FN mIRLowering__synthetic_pipeline_binding_name?(self: MIRLowering, name: String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(name.startsWith?("$")) THEN
      RETURN FALSE;
    END
    IF (name.codepointCount() < 2) THEN
      RETURN FALSE;
    END
    MUTABLE codepoint = name.substr(1, 1).ord();
    RETURN ((codepoint >= 97) AND (codepoint <= 122));
}
END
PRIVATE FN mIRLowering__atomic_capture_load?(self: MIRLowering, node: Identifier) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE sym: ?SymbolEntry = COPY node.symbol;
    RETURN !(!(((((((sym != NIL) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_540 = (sym?);
    symbolEntry__atomic?(rtoc_local_receiver_540) }) AND !(mIRLowering__capability_state(rtoc_self_view).atomic_emit_raw)) AND !(node.atomic_borrow)) AND (symbolEntry__layout(sym) != :indirect)))));
}
END
PRIVATE FN mIRLowering__recursive_field_copy_required?(self: MIRLowering, ft: Type, field_node: Locatable, field_alloc: ?String@symbol, field_sink_alloc: String@symbol) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (IF field_node IS_A Literal AS literal THEN (literal.type == symbol("NIL")) ELSE FALSE END) THEN
      RETURN FALSE;
    END
    RETURN !(!((((TRY (type__recursive_cleanup_shape?(ft, mIRLowering__mir_schema_lookup(rtoc_self_view))) AND !(mIRLowering__ast_expr_produces_heap?(rtoc_self_view, field_node))) AND (field_alloc != field_sink_alloc)))));
}
END
PRIVATE FN mIRLowering__lower_unary_op(MUTABLE self: MIRLowering, node: UnaryOp) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE right = TRY (mIRLowering__lower(&rtoc_self_view, node.right));
    IF (node.op == :NOT) OR (node.op == "!") THEN
      RETURN Emittable{ MIRUnaryOp: COPY MIRUnaryOp{ op: "!", operand: COPY right, lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE_IF (node.op == :EXISTS) THEN
      IF TRY (type__stream_step?((TRY (type__from_node_mut(node.right))))) THEN
        RETURN Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: COPY right, method: "isItem", args: ( { MUTABLE rtoc_empty_list_541: []Any = List[]; rtoc_empty_list_541 } ), try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } };
      ELSE
        mIRLowering__require_tense_operation_plan_mut(rtoc_self_view, node, TenseOperationKind.Exists, TenseBackendForm.OptionalTest);
        RETURN Emittable{ MIRBinOp: COPY MIRBinOp{ op: "!=", left: COPY right, right: Emittable{ Lit: COPY Lit{ value: "null", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
    ELSE_IF (node.op == :IS_OK) THEN
      mIRLowering__require_tense_operation_plan_mut(rtoc_self_view, node, TenseOperationKind.IsOk, TenseBackendForm.FallibleTest);
      RETURN Emittable{ FallibleOk: COPY FallibleOk{ expr: COPY mIRLowering__strip_try(rtoc_self_view, right), lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE_IF (node.op == :IS_READY) THEN
      RETURN Emittable{ FutureReady: COPY FutureReady{ expr: COPY right, lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE_IF (node.op == :TRY) THEN
      MUTABLE plan: ?TenseOperationPlan = COPY CAST(node.tense_plan AS ?TenseOperationPlan);
      IF plan EXISTS AS plan_value THEN
        IF (plan_value.operation == TenseOperationKind.Try) THEN
          IF (plan_value.backend_form == TenseBackendForm.ZigTry) THEN
            RETURN Emittable{ TryExpr: COPY TryExpr{ expr: COPY mIRLowering__strip_try(rtoc_self_view, right), lowered_node_id: NIL, ownership_consumption: NIL } };
          ELSE_IF (plan_value.backend_form == TenseBackendForm.OptionalTry) THEN
            RETURN Emittable{ TryOptional: COPY TryOptional{ expr: COPY right, lowered_node_id: NIL, ownership_consumption: NIL } };
          ELSE
            panic("TRY lowering received unsupported tense backend {}");
          END
        ELSE
          panic("TRY lowering requires its annotation-produced TenseOperationPlan");
        END
      ELSE
        panic("TRY lowering requires its annotation-produced TenseOperationPlan");
      END
    ELSE_IF (node.op == :SUB) OR (node.op == "-") THEN
      RETURN Emittable{ MIRUnaryOp: COPY MIRUnaryOp{ op: "-", operand: COPY right, lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE_IF (node.op == :BITWISE_NOT) OR (node.op == "~") THEN
      RETURN Emittable{ MIRUnaryOp: COPY MIRUnaryOp{ op: "~", operand: COPY right, lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE
      panic("MIRLowering: unknown unary op {}");
    END
}
END
PRIVATE FN mIRLowering__require_tense_operation_plan_mut(self: MIRLowering, node: Locatable, operation: TenseOperationKind, backend: TenseBackendForm) RETURNS !TenseOperationPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE plan: ?TenseOperationPlan = CAST(node.tense_plan() AS ?TenseOperationPlan);
    IF !((((plan != NIL) AND (plan.operation == operation)) AND (plan.backend_form == backend))) THEN
      panic("{} lowering requires its annotation-produced TenseOperationPlan");
    END
    RETURN UNWRAP (plan);
}
END
PRIVATE FN mIRLowering__lower_optional_unwrap(MUTABLE self: MIRLowering, node: OptionalUnwrap) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    mIRLowering__require_tense_operation_plan_mut(rtoc_self_view, node, TenseOperationKind.Unwrap, TenseBackendForm.OptionalUnwrap);
    MUTABLE target: Emittable = CAST(TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(node.target))) AS Emittable);
    IF (TRUE AND node.error_union_type) THEN
      target = mIRLowering__strip_try(rtoc_self_view, target);
    END
    MUTABLE owns_foreign_resource = (node.target IS_A Identifier AND ((node.target.symbol() != NIL) AND ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_542 = ((node.target.symbol())?);
    symbolEntry__foreign_out_owner(rtoc_local_receiver_542) } == TRUE)));
    IF owns_foreign_resource THEN
      RETURN Emittable{ ForeignOwnedUnwrap: COPY ForeignOwnedUnwrap{ expr: COPY target, lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE
      RETURN Emittable{ MIROptionalUnwrap: COPY MIROptionalUnwrap{ expr: COPY target, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
}
END
PRIVATE FN mIRLowering__lower_binary_op(MUTABLE self: MIRLowering, node: BinaryOp) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF binaryOp__smooth?(node) THEN
      RETURN mIRLowering__lower_smooth(&rtoc_self_view, node);
    END
    IF (node.op == symbol("OR_ELSE")) THEN
      RETURN mIRLowering__lower_or_else(&rtoc_self_view, node);
    END
    IF (node.op == :BIND_VAR) THEN
      RETURN CAST(TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(node.left))) AS Emittable);
    END
    IF ((node.op == symbol("AND")) OR (node.op == symbol("OR"))) THEN
      RETURN Emittable{ MIRBinOp: COPY mIRLowering__lower_lazy_boolean_op(&rtoc_self_view, node) };
    END
    IF node.string_concat THEN
      MUTABLE left = mIRLowering__hoist_alloc(rtoc_self_view, TRY (mIRLowering__widen_symbol_to_bytes(rtoc_self_view, CAST(TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(node.left))) AS Emittable), node.left)), node.left);
      MUTABLE right = mIRLowering__hoist_alloc(rtoc_self_view, TRY (mIRLowering__widen_symbol_to_bytes(rtoc_self_view, CAST(TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(node.right))) AS Emittable), node.right)), node.right);
      MUTABLE alloc = mIRLowering__alloc_for_node(rtoc_self_view, Locatable{ BinaryOp: COPY node });
      RETURN Emittable{ ConcatStr: COPY ConcatStr{ parts: [CAST(left AS Any), CAST(right AS Any)], alloc: COPY alloc, rt_expr: NIL, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    RETURN mIRLowering__emit_binary_operation_plan(rtoc_self_view, mIRLowering__binary_operation_plan(&rtoc_self_view, node));
}
END
PRIVATE FN mIRLowering__lower_is_a(MUTABLE self: MIRLowering, node: IsA) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node.runtime_variant_name THEN
      MUTABLE subject: Emittable = CAST(TRY (mIRLowering__lower(&rtoc_self_view, node.left)) AS Emittable);
      RETURN Emittable{ MIRBinOp: COPY MIRBinOp{ op: "==", left: Emittable{ Call: COPY TRY (mIRLowering__active_tag_call(rtoc_self_view, subject)) }, right: Emittable{ EnumTag: COPY EnumTag{ variant: COPY node.runtime_variant_name } }, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    RETURN Emittable{ TypeEq: COPY TypeEq{ left: COPY mIRLowering__lower_type_value_expr(&rtoc_self_view, node.left), right: COPY mIRLowering__lower_type_value_expr(&rtoc_self_view, node.right), lowered_node_id: NIL, ownership_consumption: NIL } };
}
END
PRIVATE FN mIRLowering__lower_type_value_expr(MUTABLE self: MIRLowering, node: Node) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node IS_A Type AS type THEN
      RETURN Emittable{ Ident: COPY Ident{ name: TRY (type__zig_type(type)), lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE_IF node IS_A Identifier AS identifier THEN
      RETURN Emittable{ Ident: COPY Ident{ name: mIRLowering__type_value_zig_name(rtoc_self_view, identifier__name(identifier)), lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE_IF node IS_A GetField AS get_field THEN
      RETURN Emittable{ Ident: COPY Ident{ name: mIRLowering__dotted_type_value_zig_name(rtoc_self_view, get_field), lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE
      RETURN TRY (mIRLowering__lower(&rtoc_self_view, castNodeToMIRLoweringLowerableStmt(node)));
    END
}
END
PRIVATE FN mIRLowering__type_value_zig_name(self: MIRLowering, name: String) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (type__zig_type((TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol(name) })))));
}
END
PRIVATE FN mIRLowering__dotted_type_value_zig_name(self: MIRLowering, node: GetField) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node.target IS_A Identifier THEN
      MUTABLE namespace = COPY castLocatableToIdentifier(node.target).name;
      IF (namespace == "AST") THEN
        RETURN mIRLowering__type_value_zig_name(rtoc_self_view, CAST(node.field AS String));
      END
      RETURN "${mIRLowering__zig_module_alias(rtoc_self_view, namespace)}.${node.field}";
    END
    panic("MIRLowering: unsupported dotted type expression {}");
}
END
PRIVATE FN mIRLowering__binary_operation_plan(MUTABLE self: MIRLowering, node: BinaryOp) RETURNS BinaryOperationPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE facts = mIRLowering__binary_operand_facts(&rtoc_self_view, node);
    RETURN mIRLowering__classify_binary_operation(rtoc_self_view, facts);
}
END
PRIVATE FN mIRLowering__binary_operand_facts(MUTABLE self: MIRLowering, node: BinaryOp) RETURNS !BinaryOperandFacts
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE left_type = TRY (type__from_node_mut(node.left, "binary lhs"));
    MUTABLE right_type = TRY (type__from_node_mut(node.right, "binary rhs"));
    MUTABLE left: Emittable = CAST(TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(node.left))) AS Emittable);
    MUTABLE right: Emittable = CAST(TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(node.right))) AS Emittable);
    IF (TRY (type__any_rc?(left_type)) AND !(mIRLowering__bc_target?(rtoc_self_view))) THEN
      left = mIRLowering__rc_payload_value(rtoc_self_view, left, left_type);
    END
    IF (TRY (type__any_rc?(right_type)) AND !(mIRLowering__bc_target?(rtoc_self_view))) THEN
      right = mIRLowering__rc_payload_value(rtoc_self_view, right, right_type);
    END
    RETURN BinaryOperandFacts{ node: COPY node, op: COPY node.op, left: COPY left, right: COPY right, left_type: COPY left_type, right_type: COPY right_type, int_arithmetic: COPY mIRLowering__binary_int_arithmetic_facts(rtoc_self_view, node), left_unit_variant: COPY mIRLowering__unit_variant_access(rtoc_self_view, node.left), right_unit_variant: COPY mIRLowering__unit_variant_access(rtoc_self_view, node.right) };
}
END
PRIVATE FN mIRLowering__classify_binary_operation(self: MIRLowering, facts: BinaryOperandFacts) RETURNS !BinaryOperationPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (facts.op == :POW) THEN
      RETURN BinaryOperationPlan{ kind: :pow, facts: COPY facts, type_arg: COPY mIRLowering__binary_power_type_arg(rtoc_self_view, facts), builtin: NIL, op_str: NIL, variant: NIL, tag_source: NIL, union_error_type: NIL, optional_side: NIL, optional_capture: NIL };
    END
    IF mIRLowering__signed_integer_modulo?(rtoc_self_view, facts) THEN
      RETURN BinaryOperationPlan{ kind: :builtin, facts: COPY facts, builtin: :intMod, op_str: NIL, type_arg: NIL, variant: NIL, tag_source: NIL, union_error_type: NIL, optional_side: NIL, optional_capture: NIL };
    END
    MUTABLE optional_plan: ?BinaryOperationPlan = mIRLowering__classify_optional_binary_comparison(rtoc_self_view, facts);
    IF optional_plan EXISTS AS optional_plan_value THEN
      RETURN COPY optional_plan_value;
    END
    MUTABLE string_plan: ?BinaryOperationPlan = mIRLowering__classify_string_binary_operation(rtoc_self_view, facts);
    IF string_plan EXISTS AS string_plan_value THEN
      RETURN COPY string_plan_value;
    END
    IF mIRLowering__integer_division?(rtoc_self_view, facts) THEN
      RETURN BinaryOperationPlan{ kind: :builtin, facts: COPY facts, builtin: :intDiv, op_str: NIL, type_arg: NIL, variant: NIL, tag_source: NIL, union_error_type: NIL, optional_side: NIL, optional_capture: NIL };
    END
    MUTABLE builtin: ?String@symbol = mIRLowering__direct_binary_builtin(rtoc_self_view, facts);
    IF builtin EXISTS AS builtin_value THEN
      RETURN BinaryOperationPlan{ kind: :builtin, facts: COPY facts, builtin: COPY builtin_value, op_str: NIL, type_arg: NIL, variant: NIL, tag_source: NIL, union_error_type: NIL, optional_side: NIL, optional_capture: NIL };
    END
    MUTABLE unit_plan: ?BinaryOperationPlan = mIRLowering__classify_unit_variant_comparison(rtoc_self_view, facts);
    IF unit_plan EXISTS AS unit_plan_value THEN
      RETURN COPY unit_plan_value;
    END
    MUTABLE union_error_type: ?String@symbol = mIRLowering__invalid_union_equality_type(rtoc_self_view, facts);
    IF union_error_type EXISTS AS union_error_type_value THEN
      RETURN BinaryOperationPlan{ kind: :union_equality_error, facts: COPY facts, union_error_type: COPY union_error_type_value, builtin: NIL, op_str: NIL, type_arg: NIL, variant: NIL, tag_source: NIL, optional_side: NIL, optional_capture: NIL };
    END
    MUTABLE op_str: ?String = COPY (CAST({:ADD: "+", :SUB: "-", :MUL: "*", :DIV: "/", symbol("MOD"): "%", :EQ: "==", :NEQ: "!=", :LT: "<", :LTE: "<=", :GT: ">", :GTE: ">=", symbol("AND"): "and", symbol("OR"): "or", :NOT: "!", :BITWISE_NOT: "~", symbol("XOR"): "^", symbol("BIT_AND"): "&", symbol("BIT_OR"): "|", :SHL: "<<", :SHR: ">>"} AS {String@symbol}String))[facts.op];
    IF op_str EXISTS AS op_str_value THEN
      RETURN BinaryOperationPlan{ kind: :standard, facts: COPY facts, op_str: COPY op_str_value, builtin: NIL, type_arg: NIL, variant: NIL, tag_source: NIL, union_error_type: NIL, optional_side: NIL, optional_capture: NIL };
    ELSE
      panic("MIRLowering: unknown binary op {}");
    END
}
END
PRIVATE FN mIRLowering__binary_power_type_arg(self: MIRLowering, facts: BinaryOperandFacts) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (type__resolved(facts.left_type) == :Int64) THEN
      RETURN "i64";
    ELSE
      RETURN "f64";
    END
}
END
PRIVATE FN mIRLowering__signed_integer_modulo?(self: MIRLowering, facts: BinaryOperandFacts) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ((facts.op == symbol("MOD")) AND (type__resolved(facts.left_type) == :Int64));
}
END
PRIVATE FN mIRLowering__classify_string_binary_operation(self: MIRLowering, facts: BinaryOperandFacts) RETURNS !?BinaryOperationPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((TRY (type__string?(facts.left_type)) OR TRY (type__string?(facts.right_type)))) THEN
      RETURN NIL;
    END
    IF (type__symbol?(facts.left_type) AND type__symbol?(facts.right_type)) THEN
      IF !(((facts.op == :EQ) OR (facts.op == :NEQ))) THEN
        RETURN NIL;
      END
      RETURN BinaryOperationPlan{ kind: :symbol_comparison, facts: COPY facts, builtin: NIL, op_str: NIL, type_arg: NIL, variant: NIL, tag_source: NIL, union_error_type: NIL, optional_side: NIL, optional_capture: NIL };
    END
    MUTABLE op_str: ?String = mIRLowering__string_comparison_operator(rtoc_self_view, facts.op);
    IF op_str EXISTS AS op_str_value THEN
      RETURN BinaryOperationPlan{ kind: :string_comparison, facts: COPY facts, op_str: COPY op_str_value, builtin: NIL, type_arg: NIL, variant: NIL, tag_source: NIL, union_error_type: NIL, optional_side: NIL, optional_capture: NIL };
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN mIRLowering__string_comparison_operator(self: MIRLowering, op: String@symbol) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY (CAST({:EQ: "==", :NEQ: "!=", :LT: "<", :LTE: "<=", :GT: ">", :GTE: ">="} AS {String@symbol}String))[op];
}
END
PRIVATE FN mIRLowering__classify_optional_binary_comparison(self: MIRLowering, facts: BinaryOperandFacts) RETURNS ?BinaryOperationPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(optional_comparison_ops.contains?(facts.op)) THEN
      RETURN NIL;
    END
    IF !((type__optional?(facts.left_type) OR type__optional?(facts.right_type))) THEN
      RETURN NIL;
    END
    MUTABLE both_optional = (type__optional?(facts.left_type) AND type__optional?(facts.right_type));
    IF (both_optional AND !((((facts.op == :EQ) OR (facts.op == :NEQ))))) THEN
      RETURN NIL;
    END
    MUTABLE optional_side = IF type__optional?(facts.left_type) THEN
      OptionalOperandSide.Left
    ELSE
      OptionalOperandSide.Right
    END;
    MUTABLE payload_type_branch_value: ?Type = NIL;
    IF (optional_side == OptionalOperandSide.Left) THEN
      payload_type_branch_value = COPY facts.right_type;
    ELSE
      payload_type_branch_value = COPY facts.left_type;
    END
    MUTABLE payload_type: Type = payload_type_branch_value?;
    IF (!(both_optional) AND (type__resolved(payload_type) == symbol("NIL"))) THEN
      RETURN NIL;
    END
    RETURN BinaryOperationPlan{ kind: :optional_comparison, facts: COPY facts, optional_side: COPY optional_side, optional_capture: "__opt_cmp_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_543 = mIRLowering__lowering_counters(rtoc_self_view);
    mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_543) }}", builtin: NIL, op_str: NIL, type_arg: NIL, variant: NIL, tag_source: NIL, union_error_type: NIL };
}
END
PRIVATE FN mIRLowering__integer_division?(self: MIRLowering, facts: BinaryOperandFacts) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (((facts.op == :DIV) AND type__integer?(facts.left_type)) AND type__integer?(facts.right_type));
}
END
PRIVATE FN mIRLowering__direct_binary_builtin(self: MIRLowering, facts: BinaryOperandFacts) RETURNS ?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE direct: ?String@symbol = (IF (CAST({:WRAP_ADD: :wrapAdd, :WRAP_SUB: :wrapSub, :WRAP_MUL: :wrapMul} AS {String@symbol}String@symbol))[facts.op] != NIL THEN (CAST({:WRAP_ADD: :wrapAdd, :WRAP_SUB: :wrapSub, :WRAP_MUL: :wrapMul} AS {String@symbol}String@symbol))[facts.op] ELSE (CAST({:CHECK_ADD: :checkAdd, :CHECK_SUB: :checkSub, :CHECK_MUL: :checkMul} AS {String@symbol}String@symbol))[facts.op] END);
    IF direct EXISTS AS direct_value THEN
      RETURN direct_value;
    END
    MUTABLE fn: ?String@symbol = COPY (CAST({:ADD: :intAdd, :SUB: :intSub, :MUL: :intMul} AS {String@symbol}String@symbol))[facts.op];
    IF fn EXISTS AS fn_value THEN
      IF !(facts.int_arithmetic.both_int) THEN
        RETURN NIL;
      END
      IF facts.int_arithmetic.has_comptime_number_literal THEN
        RETURN NIL;
      END
      IF facts.int_arithmetic.has_float_coercion THEN
        RETURN NIL;
      END
      RETURN fn_value;
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN mIRLowering__classify_unit_variant_comparison(self: MIRLowering, facts: BinaryOperandFacts) RETURNS ?BinaryOperationPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(((facts.op == :EQ) OR (facts.op == :NEQ))) THEN
      RETURN NIL;
    END
    MUTABLE lhs_uv: ?UnitVariantAccess = COPY facts.left_unit_variant;
    MUTABLE rhs_uv: ?UnitVariantAccess = COPY facts.right_unit_variant;
    MUTABLE op_str: String = "";
    IF (facts.op == :EQ) THEN
      op_str = "==";
    ELSE
      op_str = "!=";
    END
    IF ((lhs_uv != NIL) AND !(rhs_uv)) THEN
      RETURN BinaryOperationPlan{ kind: :unit_variant_comparison, facts: COPY facts, op_str: COPY op_str, variant: COPY lhs_uv, tag_source: :right, builtin: NIL, type_arg: NIL, union_error_type: NIL, optional_side: NIL, optional_capture: NIL };
    END
    IF ((rhs_uv != NIL) AND !(lhs_uv)) THEN
      RETURN BinaryOperationPlan{ kind: :unit_variant_comparison, facts: COPY facts, op_str: COPY op_str, variant: COPY rhs_uv, tag_source: :left, builtin: NIL, type_arg: NIL, union_error_type: NIL, optional_side: NIL, optional_capture: NIL };
    END
    RETURN NIL;
}
END
PRIVATE FN mIRLowering__invalid_union_equality_type(self: MIRLowering, facts: BinaryOperandFacts) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(((facts.op == :EQ) OR (facts.op == :NEQ))) THEN
      RETURN NIL;
    END
    MUTABLE left_resolved = type__resolved(facts.left_type);
    MUTABLE right_resolved = type__resolved(facts.right_type);
    IF (TRY (mIRLowering__union_schemas(rtoc_self_view))).contains?(left_resolved) THEN
      RETURN left_resolved;
    END
    IF (TRY (mIRLowering__union_schemas(rtoc_self_view))).contains?(right_resolved) THEN
      RETURN right_resolved;
    END
    RETURN NIL;
}
END
PRIVATE FN mIRLowering__emit_binary_operation_plan(self: MIRLowering, plan: BinaryOperationPlan) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (plan.kind == :pow) THEN
      RETURN Emittable{ Call: COPY mIRLowering__emit_power_binary_plan(rtoc_self_view, plan) };
    ELSE_IF (plan.kind == :builtin) THEN
      RETURN mIRLowering__emit_builtin_binary_plan(rtoc_self_view, plan);
    ELSE_IF (plan.kind == :optional_comparison) THEN
      RETURN Emittable{ IfOptional: COPY mIRLowering__emit_optional_comparison_plan(rtoc_self_view, plan) };
    ELSE_IF (plan.kind == :symbol_comparison) THEN
      RETURN mIRLowering__emit_symbol_binary_plan(rtoc_self_view, plan);
    ELSE_IF (plan.kind == :string_comparison) THEN
      RETURN mIRLowering__emit_string_binary_comparison(rtoc_self_view, plan);
    ELSE_IF (plan.kind == :unit_variant_comparison) THEN
      RETURN Emittable{ MIRBinOp: COPY mIRLowering__emit_unit_variant_comparison(rtoc_self_view, plan) };
    ELSE_IF (plan.kind == :union_equality_error) THEN
      RETURN mIRLowering__raise_union_equality_error(rtoc_self_view, plan);
    ELSE_IF (plan.kind == :standard) THEN
      RETURN Emittable{ MIRBinOp: COPY mIRLowering__emit_standard_binary_plan(rtoc_self_view, plan) };
    ELSE
      panic("MIRLowering: unknown binary operation plan {}");
    END
}
END
PRIVATE FN mIRLowering__emit_power_binary_plan(self: MIRLowering, plan: BinaryOperationPlan) RETURNS !Call
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE facts = COPY plan.facts;
    RETURN Call{ callee: "std.math.pow", args: [Emittable{ Ident: COPY Ident{ name: COPY UNWRAP (plan.type_arg), lowered_node_id: NIL, ownership_consumption: NIL } }, facts.left, facts.right], try_wrap: FALSE, owned_return: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(3)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL };
}
END
PRIVATE FN mIRLowering__emit_builtin_binary_plan(self: MIRLowering, plan: BinaryOperationPlan) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE facts = COPY plan.facts;
    RETURN castMIRLoweringReturnValueToEmittable(TRY (mIRLowering__emit_builtin(rtoc_self_view, symbol(UNWRAP (plan.builtin)), [facts.left, facts.right])));
}
END
PRIVATE FN mIRLowering__emit_optional_comparison_plan(self: MIRLowering, plan: BinaryOperationPlan) RETURNS !IfOptional
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE facts = COPY plan.facts;
    MUTABLE capture = COPY UNWRAP (plan.optional_capture);
    MUTABLE optional_side = COPY UNWRAP (plan.optional_side);
    MUTABLE capture_ref = Ident{ name: capture, lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE optional_source_branch_value: ?Emittable = NIL;
    IF (optional_side == OptionalOperandSide.Left) THEN
      optional_source_branch_value = COPY facts.left;
    ELSE
      optional_source_branch_value = COPY facts.right;
    END
    MUTABLE optional_source: Emittable = optional_source_branch_value?;
    MUTABLE then_expr = mIRLowering__emit_optional_comparison_then_expr(rtoc_self_view, facts, optional_side, capture_ref);
    MUTABLE else_expr = mIRLowering__absent_optional_comparison_result(rtoc_self_view, facts, optional_side);
    MUTABLE result = IfOptional{ optional: COPY optional_source, capture: capture, then_expr: COPY then_expr, else_expr: COPY else_expr, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    result.result_type = TRY (type__new(TypeConstructionInput{ SymbolValue: :Bool }));
    RETURN result;
}
END
PRIVATE FN mIRLowering__absent_optional_comparison_result(self: MIRLowering, facts: BinaryOperandFacts, optional_side: OptionalOperandSide) RETURNS Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE other_branch_value: ?Emittable = NIL;
    IF (optional_side == OptionalOperandSide.Left) THEN
      other_branch_value = COPY facts.right;
    ELSE
      other_branch_value = COPY facts.left;
    END
    MUTABLE other: Emittable = other_branch_value?;
    MUTABLE other_type_branch_value: ?Type = NIL;
    IF (optional_side == OptionalOperandSide.Left) THEN
      other_type_branch_value = COPY facts.right_type;
    ELSE
      other_type_branch_value = COPY facts.left_type;
    END
    MUTABLE other_type: Type = other_type_branch_value?;
    IF !(type__optional?(other_type)) THEN
      RETURN Emittable{ Lit: COPY Lit{ value: IF (facts.op == :NEQ) THEN
        "true"
      ELSE
        "false"
      END, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    RETURN Emittable{ MIRBinOp: COPY MIRBinOp{ op: IF (facts.op == :NEQ) THEN
      "!="
    ELSE
      "=="
    END, left: COPY other, right: Emittable{ Lit: COPY Lit{ value: "null", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } };
}
END
PRIVATE FN mIRLowering__emit_optional_comparison_then_expr(self: MIRLowering, facts: BinaryOperandFacts, optional_side: OptionalOperandSide, capture_ref: Ident) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE inner_type_branch_value: ?Type = NIL;
    IF (optional_side == OptionalOperandSide.Left) THEN
      inner_type_branch_value = UNWRAP (TRY (type__wrapped_type(facts.left_type)));
    ELSE
      inner_type_branch_value = UNWRAP (TRY (type__wrapped_type(facts.right_type)));
    END
    MUTABLE inner_type: Type = inner_type_branch_value?;
    MUTABLE inner_facts = BinaryOperandFacts{ node: COPY facts.node, op: COPY facts.op, left: COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_544: ?Ident = NIL;
    IF (optional_side == OptionalOperandSide.Left) THEN
      rtoc_ternary_value_544 = capture_ref;
    ELSE
      rtoc_ternary_value_544 = facts.left;
    END
    rtoc_ternary_value_544? }, right: COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_545: ?Ident = NIL;
    IF (optional_side == OptionalOperandSide.Right) THEN
      rtoc_ternary_value_545 = capture_ref;
    ELSE
      rtoc_ternary_value_545 = facts.right;
    END
    rtoc_ternary_value_545? }, left_type: COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_546: ?Type = NIL;
    IF (optional_side == OptionalOperandSide.Left) THEN
      rtoc_ternary_value_546 = inner_type;
    ELSE
      rtoc_ternary_value_546 = facts.left_type;
    END
    rtoc_ternary_value_546? }, right_type: COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_547: ?Type = NIL;
    IF (optional_side == OptionalOperandSide.Right) THEN
      rtoc_ternary_value_547 = inner_type;
    ELSE
      rtoc_ternary_value_547 = facts.right_type;
    END
    rtoc_ternary_value_547? }, int_arithmetic: COPY facts.int_arithmetic, left_unit_variant: COPY facts.left_unit_variant, right_unit_variant: COPY facts.right_unit_variant };
    RETURN mIRLowering__emit_binary_operation_plan(rtoc_self_view, mIRLowering__classify_binary_operation(rtoc_self_view, inner_facts));
}
END
PRIVATE FN mIRLowering__emit_symbol_binary_plan(self: MIRLowering, plan: BinaryOperationPlan) RETURNS Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN mIRLowering__emit_symbol_binary_comparison(rtoc_self_view, plan.facts);
}
END
PRIVATE FN mIRLowering__emit_standard_binary_plan(self: MIRLowering, plan: BinaryOperationPlan) RETURNS MIRBinOp
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE facts = COPY plan.facts;
    MUTABLE right_branch_value: ?Cast = NIL;
    IF ((facts.op == :SHL) OR (facts.op == :SHR)) THEN
      right_branch_value = MIRCast{ expr: COPY facts.right, target_type: NIL, method: :intCast, lowered_node_id: NIL, ownership_consumption: NIL };
    ELSE
      right_branch_value = COPY facts.right;
    END
    MUTABLE right: Cast = right_branch_value?;
    RETURN MIRBinOp{ op: COPY UNWRAP (plan.op_str), left: COPY facts.left, right: COPY right, lowered_node_id: NIL, ownership_consumption: NIL };
}
END
PRIVATE FN mIRLowering__emit_symbol_binary_comparison(self: MIRLowering, facts: BinaryOperandFacts) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE cmp = TRY (mIRLowering__emit_builtin(rtoc_self_view, :symbolEql, [facts.left, facts.right]));
    IF (facts.op == :NEQ) THEN
      RETURN Emittable{ MIRUnaryOp: COPY MIRUnaryOp{ op: "!", operand: castMIRLoweringReturnValueToEmittable(COPY cmp), lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE
      RETURN castMIRLoweringReturnValueToEmittable(cmp);
    END
}
END
PRIVATE FN mIRLowering__emit_string_binary_comparison(self: MIRLowering, plan: BinaryOperationPlan) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE facts = COPY plan.facts;
    MUTABLE operands = mIRLowering__string_comparison_operands(rtoc_self_view, facts);
    MUTABLE eql_call = TRY (mIRLowering__emit_builtin(rtoc_self_view, :eql, [operands.left, operands.right]));
    IF (facts.op == :EQ) THEN
      RETURN castMIRLoweringReturnValueToEmittable(eql_call);
    END
    IF (facts.op == :NEQ) THEN
      RETURN Emittable{ MIRUnaryOp: COPY MIRUnaryOp{ op: "!", operand: castMIRLoweringReturnValueToEmittable(COPY eql_call), lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    RETURN Emittable{ MIRBinOp: COPY MIRBinOp{ op: COPY UNWRAP (plan.op_str), left: castMIRLoweringReturnValueToEmittable(COPY TRY (mIRLowering__emit_builtin(rtoc_self_view, :strcmp, [operands.left, operands.right]))), right: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } };
}
END
PRIVATE FN mIRLowering__string_comparison_operands(self: MIRLowering, facts: BinaryOperandFacts) RETURNS BinaryMirOperands
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE node = COPY facts.node;
    MUTABLE left = mIRLowering__string_comparison_operand(rtoc_self_view, facts.left, &node.left);
    MUTABLE right = mIRLowering__string_comparison_operand(rtoc_self_view, facts.right, &node.right);
    RETURN BinaryMirOperands{ left: COPY mIRLowering__hoist_alloc(rtoc_self_view, left, node.left), right: COPY mIRLowering__hoist_alloc(rtoc_self_view, right, node.right) };
}
END
PRIVATE FN mIRLowering__string_comparison_operand(self: MIRLowering, value: Emittable, MUTABLE ast_node: Locatable) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (IF ast_node IS_A BinaryOp AS binary_op THEN (binary_op.op == symbol("OR_ELSE")) ELSE FALSE END) THEN
      RETURN TRY (mIRLowering__place_value_for_destination(rtoc_self_view, value, ast_node, :heap, TRY (aST__full_type_mut(ast_node))));
    END
    RETURN COPY value;
}
END
PRIVATE FN mIRLowering__emit_unit_variant_comparison(self: MIRLowering, plan: BinaryOperationPlan) RETURNS !MIRBinOp
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE facts = COPY plan.facts;
    MUTABLE tag_target_branch_value: ?Emittable = NIL;
    IF (plan.tag_source == :left) THEN
      tag_target_branch_value = COPY facts.left;
    ELSE
      tag_target_branch_value = COPY facts.right;
    END
    MUTABLE tag_target: Emittable = tag_target_branch_value?;
    RETURN MIRBinOp{ op: COPY UNWRAP (plan.op_str), left: Emittable{ Call: COPY TRY (mIRLowering__active_tag_call(rtoc_self_view, tag_target)) }, right: Emittable{ EnumTag: COPY EnumTag{ variant: COPY (UNWRAP (plan.variant)).variant_name } }, lowered_node_id: NIL, ownership_consumption: NIL };
}
END
PRIVATE FN mIRLowering__raise_union_equality_error(self: MIRLowering, plan: BinaryOperationPlan) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE type_name = COPY symbol(UNWRAP (plan.union_error_type));
    panic("{}work on tagged unions. Either compare against a unit variant {}std.meta.activeTag(s) == .Variant -- or use a MATCH expression to discriminate the active variant.\\n(See transpile-tests/255_union_equality.clear.)");
}
END
PRIVATE FN mIRLowering__lower_lazy_boolean_op(MUTABLE self: MIRLowering, node: BinaryOp) RETURNS !MIRBinOp
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE op_str: ?String = COPY (CAST({:ADD: "+", :SUB: "-", :MUL: "*", :DIV: "/", symbol("MOD"): "%", :EQ: "==", :NEQ: "!=", :LT: "<", :LTE: "<=", :GT: ">", :GTE: ">=", symbol("AND"): "and", symbol("OR"): "or", :NOT: "!", :BITWISE_NOT: "~", symbol("XOR"): "^", symbol("BIT_AND"): "&", symbol("BIT_OR"): "|", :SHL: "<<", :SHR: ">>"} AS {String@symbol}String))[node.op];
    IF op_str EXISTS AS op_str_value THEN
      MUTABLE op_str_value_mutable = COPY op_str_value;
      MUTABLE left = mIRLowering__lower_boolean_operand(&rtoc_self_view, node.left);
      MUTABLE right = mIRLowering__lower_scoped(rtoc_self_view, %() USE(node, MUTABLE rtoc_self_view) -> mIRLowering__lower_boolean_operand(&rtoc_self_view, node.right));
      RETURN MIRBinOp{ op: COPY op_str_value_mutable, left: COPY left, right: COPY right, lowered_node_id: NIL, ownership_consumption: NIL };
    ELSE
      panic("MIRLowering: unknown boolean op {}");
    END
}
END
PRIVATE FN mIRLowering__lower_boolean_operand(MUTABLE self: MIRLowering, node: Locatable) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lowered: Emittable = CAST(TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(node))) AS Emittable);
    IF !(type__optional?((TRY (type__from_node_mut(node, "logical operand"))))) THEN
      RETURN lowered;
    END
    RETURN Emittable{ MIRBinOp: COPY MIRBinOp{ op: "!=", left: COPY lowered, right: Emittable{ Lit: COPY Lit{ value: "null", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } };
}
END
PRIVATE FN mIRLowering__unit_variant_access(self: MIRLowering, node: Locatable) RETURNS !?UnitVariantAccess
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A GetField AS get_field THEN
      IF !(get_field.target IS_A Identifier) THEN
        RETURN NIL;
      END
      MUTABLE type_name = type__to_sym(get_field.target.name());
      MUTABLE schema = (TRY (mIRLowering__union_schemas(rtoc_self_view)))[type_name];
      IF !(schema IS_A UnionSchema@multiowned) THEN
        RETURN NIL;
      END
      MUTABLE field_key: ?MIRLoweringExpressionsReturnValue = mIRLowering__union_variant_key(rtoc_self_view, schema, get_field.field);
      IF field_key EXISTS AS field_key_value THEN
        MUTABLE var_data = schema.variants()[field_key_value];
        IF schemas__inline_struct?(var_data) THEN
          RETURN NIL;
        END
        RETURN UnitVariantAccess{ type_name: COPY type_name, variant_name: COPY get_field.field };
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN mIRLowering__union_variant_key(self: MIRLowering, schema: UnionSchema, field: Field) RETURNS ?MIRLoweringReturnValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF schema.variants.contains?(field) THEN
      RETURN COPY castFieldToOptionalMIRLoweringReturnValue(field);
    END
    MUTABLE field_s = COPY CAST(field AS String);
    IF schema.variants.contains?(field_s) THEN
      RETURN MIRLoweringReturnValue{ StringValue: COPY field_s };
    END
    MUTABLE field_sym = symbol(field_s);
    IF schema.variants.contains?(field_sym) THEN
      RETURN MIRLoweringReturnValue{ SymbolValue: COPY field_sym };
    END
    RETURN NIL;
}
END
PRIVATE FN mIRLowering__lower_smooth(MUTABLE self: MIRLowering, MUTABLE node: BinaryOp) RETURNS Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_writer_receiver_548: FunctionState = mIRLowering__function_state(rtoc_self_view);
    rtoc_writer_receiver_548.current_decl_alloc = COPY mIRLowering__function_state(rtoc_self_view).current_decl_alloc;
    MUTABLE rhs = COPY node.right;
    IF aST__pipeline_complex_op?(rhs) THEN
      RETURN mIRLowering__lower_complex_smooth(rtoc_self_view, node);
    END
    IF rhs IS_A CollectOp AS collect_op THEN
      MUTABLE collect_op_mutable = COPY collect_op;
      RETURN mIRLowering__lower_collect_smooth(&rtoc_self_view, node, collect_op_mutable);
    END
    IF rhs IS_A RecoverOp AS recover_op THEN
      MUTABLE recover_op_mutable = COPY recover_op;
      RETURN Emittable{ TryCatch: COPY mIRLowering__lower_recover_smooth(&rtoc_self_view, &node, recover_op_mutable) };
    END
    RETURN mIRLowering__lower_call_smooth(&rtoc_self_view, node);
}
END
PRIVATE FN mIRLowering__lower_complex_smooth(self: MIRLowering, node: BinaryOp) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rhs = COPY node.right;
    MUTABLE source_type: ?String@symbol = IF node.left IS_A RangeLit THEN
      :range
    ELSE
      NIL
    END;
    MUTABLE mir_result: ?PipelineLoweringResult = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_549 = (TRY (mIRLowering__pipeline_host(rtoc_self_view)));
    TRY (pipelineHost__lower_pipeline(&rtoc_mutable_receiver_549, node)) };
    MUTABLE result_type = TRY (type__from_node_mut(node, "pipeline result ownership"));
    MUTABLE sink_alloc: ?String@symbol = mIRLowering__complex_pipeline_sink_alloc(rtoc_self_view, mir_result, result_type, node);
    IF mir_result EXISTS AS mir_result_value THEN
      RETURN Emittable{ Pipeline: COPY Pipeline{ ast_node: COPY node, inner: castPipelineLoweringResultToEmittable(COPY mir_result_value), source_type: source_type, stages: NIL, sink: NIL, sink_alloc: sink_alloc, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
    panic("lower_smooth: unsupported pipeline op {}; legacy pipeline fallback has been removed");
}
END
PRIVATE FN mIRLowering__complex_pipeline_sink_alloc(self: MIRLowering, mir_result: ?PipelineLoweringResult, result_type: Type, node: BinaryOp) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
