      &stmts.append(Emittable{ Set: COPY castEmittableToSet(TRY (mIRLowering__with_ownership_consumption_for_value(rtoc_self_view, Emittable{ Set: COPY Set{ target: Emittable{ FieldGet: COPY alias_field }, value: COPY value, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, value, node.value, "MIR::Set", :owned_sink, facts.alloc_sym))) });
      &stmts.append(Emittable{ Call: COPY runtimeCallSpec__call(len_guard, "__old", cleanup_alloc_value_mutable) });
    ELSE
