      MUTABLE loop_body = (cond_pending + [Emittable{ Let: COPY Let{ name: COPY step_name, init: COPY UNWRAP (cond), mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }, Emittable{ UnionMatchStmt: COPY UnionMatchStmt{ subject: Emittable{ Ident: COPY step }, arms: [item_arm, closed_arm], default_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }]);
