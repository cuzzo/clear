END
PRIVATE FN mIRLowering__mir_references_identifier?(self: MIRLowering, root: Root, name: String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE found: Bool = FALSE;
    mIR__each_node(castRootToNodeRoot(root), %(candidate: Emittable) USE(name) -> {
    IF (IF candidate IS_A Ident AS ident THEN (ident.name == name) ELSE FALSE END) THEN
        found = TRUE;
    END
    rubyToClearVoid()
    });
    RETURN found;
}
END
PRIVATE FN mIRLowering__for_each_owned_collection_source?(self: MIRLowering, mir: Emittable) RETURNS Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF ((mir IS_A MIRCast OR mir IS_A TryExpr) OR mir IS_A TryOptional) THEN
      RETURN mIRLowering__for_each_owned_collection_source?(rtoc_self_view, mir.expr());
    END
    IF (IF mir IS_A Call AS call THEN call__owned_return?(call) ELSE FALSE END) THEN
      RETURN TRUE;
    END
    RETURN mIRLowering__mir_allocates?(rtoc_self_view, mir);
}
END
PRIVATE FN mIRLowering__for_each_owned_collection_source_alloc(self: MIRLowering, mir: Emittable, type_info: Type) RETURNS !String@symbol
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF ((mir IS_A MIRCast OR mir IS_A TryExpr) OR mir IS_A TryOptional) THEN
      RETURN mIRLowering__for_each_owned_collection_source_alloc(rtoc_self_view, mir.expr(), type_info);
    END
    IF (IF mir IS_A Call AS call THEN call__owned_return?(call) ELSE FALSE END) THEN
      RETURN :heap;
    END
    MUTABLE owned_alloc: ?String@symbol = mIRLowering__mir_owned_alloc(rtoc_self_view, mir);
    IF owned_alloc EXISTS AS owned_alloc_value THEN
      RETURN owned_alloc_value;
    END
    RETURN TRY (type__cleanup_allocator(type_info, mIRLowering__mir_schema_lookup(rtoc_self_view)));
}
END
PRIVATE FN mIRLowering__lower_for_range(MUTABLE self: MIRLowering, node: ForRange) RETURNS !ScopeBlock
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE plan = mIRLowering__for_range_plan(&rtoc_self_view, node);
    MUTABLE var_decl = Let{ name: COPY plan.var, init: Emittable{ Ident: COPY Ident{ name: COPY plan.iter_var, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: FALSE, annotation: COPY TRY (type__new(TypeConstructionInput{ StringValue: COPY "i64" })), suppression: "_ = &${plan.var};", alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL };
    MUTABLE body = mIRLowering__prepend_loop_mark(rtoc_self_view, plan.body, plan.mark_per_iter, &plan.tight, [Emittable{ Let: COPY var_decl }]);
    IF ((!(plan.tight) AND mIRLowering__current_function_has_rt?(rtoc_self_view)) AND !(mIRLowering__loop_body_exits?(rtoc_self_view, body))) THEN
      &body.append(Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY plan.rt }, method: "checkYield", args: ( { MUTABLE rtoc_empty_list_759: []Any = List[]; rtoc_empty_list_759 } ), try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    END
    MUTABLE update = Set{ target: Emittable{ Ident: COPY Ident{ name: COPY plan.iter_var, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ MIRBinOp: COPY MIRBinOp{ op: "+", left: Emittable{ Ident: COPY Ident{ name: COPY plan.iter_var, lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Lit: COPY Lit{ value: "1", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    MUTABLE cond = MIRBinOp{ op: COPY plan.comparison, left: Emittable{ Ident: COPY Ident{ name: COPY plan.iter_var, lowered_node_id: NIL, ownership_consumption: NIL } }, right: COPY plan.end_value, lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE iter_init = Let{ name: COPY plan.iter_var, init: COPY plan.start_value, mutable: TRUE, annotation: COPY TRY (type__new(TypeConstructionInput{ StringValue: COPY "i64" })), suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL };
    MUTABLE while_stmt = WhileStmt{ cond: Emittable{ MIRBinOp: COPY cond }, body: Body{ ArrayValue: body |> SELECT castEmittableToLocatable(_) }, capture: NIL, update: Emittable{ Set: COPY update }, mark_per_iter: plan.mark_per_iter, tight: plan.tight, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    RETURN ScopeBlock{ body: COPY CAST(Tuple{iter_init, while_stmt} AS Tuple<Let, WhileStmt>), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
}
END
PRIVATE FN mIRLowering__for_range_plan(MUTABLE self: MIRLowering, node: ForRange) RETURNS !ForRangePlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE start_val = TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(node.start_expr)));
    MUTABLE end_val = TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(node.end_expr)));
    MUTABLE var = mIRLowering__zig_safe_name(rtoc_self_view, node.var_name);
    MUTABLE body = TRY (mIRLowering__lower_body(&rtoc_self_view, node.body));
    mIRLowering__finalize_loop_frame_alloc_scopes_mut(rtoc_self_view, body, node.mark_per_iter);
    MUTABLE rt = Ident{ name: mIRLowering__runtime_binding_name(rtoc_self_view), lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE cmp: String = "";
    IF node.inclusive THEN
      cmp = "<=";
    ELSE
      cmp = "<";
    END
    MUTABLE iter_var = "__for_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_760 = mIRLowering__lowering_counters(rtoc_self_view);
    mIRLoweringCounters__next_for_loop_id(&rtoc_mutable_receiver_760) }}";
    RETURN ForRangePlan{ var: COPY var, start_value: COPY start_val, end_value: COPY end_val, body: COPY body, rt: COPY rt, comparison: COPY cmp, iter_var: COPY iter_var, mark_per_iter: IF (node.mark_per_iter == TRUE) THEN
      TRUE
    ELSE
      NIL
    END, tight: node.tight };
}
END
PRIVATE FN mIRLowering__lower_match(MUTABLE self: MIRLowering, node: MatchStatement) RETURNS Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE result = NIL;
    MUTABLE facts = mIRLowering__match_lowering_facts(&rtoc_self_view, node);
    MUTABLE expr_label: ?String = COPY facts.expr_label;
    MUTABLE subject = COPY facts.subject;
    MUTABLE is_union = facts.is_union;
    IF (facts.is_int_match OR facts.is_enum_match) THEN
      result = mIRLowering__lower_switch_match(&rtoc_self_view, node, facts);
    ELSE_IF (is_union AND mIRLowering__union_match_switchable?(rtoc_self_view, node)) THEN
      result = mIRLowering__lower_union_match(&rtoc_self_view, node, facts);
    ELSE
      result = mIRLowering__lower_if_chain_match(&rtoc_self_view, node, facts);
    END
    IF expr_label EXISTS AS expr_label_value THEN
      RETURN Emittable{ MIRBlockExpr: COPY MIRBlockExpr{ label: expr_label_value, body: COPY [result], lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL } };
    ELSE
      RETURN result;
    END
}
END
PRIVATE FN mIRLowering__lower_if_chain_match(MUTABLE self: MIRLowering, node: MatchStatement, facts: MatchLoweringFacts) RETURNS IfChain
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE branches = node.cases |> UNNEST mIRLowering__if_chain_match_case_branches(&rtoc_self_view, node, _, facts);
    RETURN IfChain{ branches: COPY branches, default_body: mIRLowering__lower_match_default_body(&rtoc_self_view, node.default_case, facts.expr_label), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
}
END
PRIVATE FN mIRLowering__if_chain_match_case_branches(MUTABLE self: MIRLowering, node: MatchStatement, match_case: MatchCase, facts: MatchLoweringFacts) RETURNS ![]IfChainBranch
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE body = mIRLowering__hoisted_match_case_body(&rtoc_self_view, match_case, facts.expr_label);
    IF (match_case.kind == :when) THEN
      RETURN CAST([mIRLowering__if_chain_branch(rtoc_self_view, CAST(TRY (mIRLowering__lower(&rtoc_self_view, match_case.value)) AS Emittable), body)] AS []IfChainBranch);
    END
    IF facts.is_union THEN
      RETURN mIRLowering__union_if_chain_match_case(rtoc_self_view, node, match_case, facts.subject, body);
    END
    RETURN mIRLowering__value_if_chain_match_case(&rtoc_self_view, node, match_case, facts.subject, body);
}
END
PRIVATE FN mIRLowering__hoisted_match_case_body(MUTABLE self: MIRLowering, match_case: MatchCase, expr_label: ?String) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE body = mIRLowering__lower_match_branch(&rtoc_self_view, match_case.body, expr_label);
    RETURN mIRLowering__hoist_unhoisted_return_allocs(rtoc_self_view, body, match_case.body);
}
END
PRIVATE FN mIRLowering__if_chain_branch(self: MIRLowering, cond: Emittable, body: []Emittable) RETURNS IfChainBranch
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN IfChainBranch{ cond: COPY cond, body: COPY body };
}
END
PRIVATE FN mIRLowering__union_if_chain_match_case(self: MIRLowering, node: MatchStatement, match_case: MatchCase, subject: Emittable, body: []Emittable) RETURNS ![]IfChainBranch
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE variants = mIRLowering__union_match_case_variants(rtoc_self_view, match_case);
    MUTABLE is_mutable = (node.expr IS_A Identifier AND (node.expr.was_moved() == TRUE));
    MUTABLE has_payload_binding = !(!(((IF match_case.binding != NIL THEN match_case.binding ELSE match_case.destructure END))));
    IF (has_payload_binding AND (variants.length() > 1)) THEN
      RETURN variants |> SELECT mIRLowering__if_chain_branch(rtoc_self_view, Emittable{ MIRBinOp: COPY mIRLowering__union_tag_condition(rtoc_self_view, subject, _) }, (mIRLowering__union_if_chain_payload_bindings(rtoc_self_view, match_case, subject, _, is_mutable) + COPY body));
    END
    MUTABLE branch_body: []Emittable = List[];
    IF has_payload_binding THEN
      branch_body = (mIRLowering__union_if_chain_payload_bindings(rtoc_self_view, match_case, subject, (variants.first() OR_ELSE ""), is_mutable) + body);
    ELSE
      branch_body = COPY body;
    END
    RETURN CAST([mIRLowering__if_chain_branch(rtoc_self_view, mIRLowering__disjoin_match_conditions(rtoc_self_view, variants |> SELECT mIRLowering__union_tag_condition(rtoc_self_view, subject, _)), branch_body)] AS []IfChainBranch);
}
END
PRIVATE FN mIRLowering__union_if_chain_payload_bindings(self: MIRLowering, match_case: MatchCase, subject: Emittable, variant: String, is_mutable: Bool) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE payload: Emittable = Emittable{ UnionPayloadGet: COPY UnionPayloadGet{ subject: COPY subject, variant: COPY variant, lowered_node_id: NIL, ownership_consumption: NIL } };
    IF match_case.indirect_payload_as THEN
      payload = Emittable{ Deref: COPY Deref{ expr: COPY payload, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF match_case.binding EXISTS AS binding_value THEN
      MUTABLE safe_binding = mIRLowering__payload_binding_name(rtoc_self_view, UNWRAP (binding_value), match_case, NIL);
      RETURN CAST([Emittable{ Let: COPY Let{ name: COPY safe_binding, init: COPY payload, mutable: COPY is_mutable, annotation: NIL, suppression: "_ = &${safe_binding};", alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }] AS []Emittable);
    END
    MUTABLE destructure: ?StructPattern = COPY match_case.destructure;
    IF destructure EXISTS AS destructure_value THEN
      RETURN destructure_value.fields |> SELECT:? (IF patternField__wildcard?(_) THEN NIL ELSE (IF !(patternField__bind?(_)) THEN NIL ELSE Let{ name: COPY _.name, init: Emittable{ FieldGet: COPY FieldGet{ object: COPY payload, field: COPY _.name, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: FALSE, annotation: NIL, suppression: "_ = &${_.name};", alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } END) END) |> WHERE _ != NIL;
    ELSE
      RETURN CAST(( { MUTABLE rtoc_empty_list_761: []Emittable = List[]; rtoc_empty_list_761 } ) AS []Emittable);
    END
}
END
PRIVATE FN mIRLowering__union_tag_condition(self: MIRLowering, subject: Emittable, variant: String) RETURNS !MIRBinOp
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN MIRBinOp{ op: "==", left: Emittable{ Call: COPY TRY (mIRLowering__active_tag_call(rtoc_self_view, subject)) }, right: Emittable{ EnumTag: COPY EnumTag{ variant: COPY variant } }, lowered_node_id: NIL, ownership_consumption: NIL };
}
END
PRIVATE FN mIRLowering__value_if_chain_match_case(MUTABLE self: MIRLowering, node: MatchStatement, match_case: MatchCase, subject: Emittable, body: []Emittable) RETURNS ![]IfChainBranch
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node.string_match THEN
      RETURN CAST([mIRLowering__if_chain_branch(rtoc_self_view, mIRLowering__string_match_condition(&rtoc_self_view, subject, match_case), body)] AS []IfChainBranch);
    END
    IF (match_case.kind == :struct_pattern) THEN
      MUTABLE pattern: StructPattern = COPY CAST(match_case.value AS StructPattern);
      MUTABLE subject_ident: Ident = COPY castEmittableToIdent(subject);
      MUTABLE cond_parts, bind_stmts = TRY (mIRLowering__lower_struct_pattern(&rtoc_self_view, subject_ident, pattern));
      MUTABLE branch_body = (bind_stmts + body);
      RETURN CAST([mIRLowering__if_chain_branch(rtoc_self_view, mIRLowering__conjoin_match_conditions(rtoc_self_view, cond_parts), branch_body)] AS []IfChainBranch);
    END
    RETURN CAST([mIRLowering__if_chain_branch(rtoc_self_view, mIRLowering__equality_match_condition(&rtoc_self_view, subject, match_case), body)] AS []IfChainBranch);
}
END
PRIVATE FN mIRLowering__string_match_condition(MUTABLE self: MIRLowering, subject: Emittable, match_case: MatchCase) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE conditions = ([match_case.value] + match_case.extra_values) |> SELECT TRY (mIRLowering__emit_builtin(rtoc_self_view, :strEql, [subject, TRY (mIRLowering__lower(&rtoc_self_view, _))]));
    RETURN mIRLowering__disjoin_match_conditions(rtoc_self_view, conditions);
}
END
PRIVATE FN mIRLowering__equality_match_condition(MUTABLE self: MIRLowering, subject: Emittable, match_case: MatchCase) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE conditions = ([match_case.value] + match_case.extra_values) |> SELECT MIRBinOp{ op: "==", left: COPY subject, right: COPY TRY (mIRLowering__lower(&rtoc_self_view, _)), lowered_node_id: NIL, ownership_consumption: NIL };
    RETURN mIRLowering__disjoin_match_conditions(rtoc_self_view, conditions);
}
END
PRIVATE FN mIRLowering__disjoin_match_conditions(self: MIRLowering, conditions: []Emittable) RETURNS Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ((conditions |> REDUCE(0) MIRBinOp{ op: "or", left: COPY acc, right: COPY _, lowered_node_id: NIL, ownership_consumption: NIL }) OR Lit{ value: "false", lowered_node_id: NIL, ownership_consumption: NIL });
}
END
PRIVATE FN mIRLowering__conjoin_match_conditions(self: MIRLowering, conditions: []Emittable) RETURNS Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ((conditions |> REDUCE(0) MIRBinOp{ op: "and", left: COPY acc, right: COPY _, lowered_node_id: NIL, ownership_consumption: NIL }) OR Lit{ value: "true", lowered_node_id: NIL, ownership_consumption: NIL });
}
END
PRIVATE FN mIRLowering__lower_match_default_body(MUTABLE self: MIRLowering, default_case: ?[]Locatable, expr_label: ?String) RETURNS !?[]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF default_case EXISTS AS default_case_value THEN
      MUTABLE default_case_value_mutable = COPY default_case_value;
      IF !(default_case_value_mutable.empty?()) THEN
        MUTABLE body = mIRLowering__lower_match_branch(&rtoc_self_view, default_case_value_mutable, expr_label);
        RETURN mIRLowering__hoist_unhoisted_return_allocs(rtoc_self_view, body, default_case_value_mutable);
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN mIRLowering__union_match_switchable?(self: MIRLowering, node: MatchStatement) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN node.cases |> ALL (matchCase__kind(_) == :eq);
}
END
PRIVATE FN mIRLowering__match_lowering_facts(MUTABLE self: MIRLowering, node: MatchStatement) RETURNS !MatchLoweringFacts
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE match_ident: ?Identifier = NIL;
    MUTABLE expr_label: String = "";
    IF node.expr_mode THEN
      expr_label = "__match_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_762 = mIRLowering__lowering_counters(rtoc_self_view);
      mIRLoweringCounters__next_block_expr_id(&rtoc_mutable_receiver_762) }}";
    ELSE
      expr_label = "";
    END
    MUTABLE subject = TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(node.expr)));
    MUTABLE union_lookup = mIRLowering__match_union_lookup(rtoc_self_view, node.expr);
    MUTABLE is_union = (TRY (mIRLowering__union_schemas(rtoc_self_view))).contains?(union_lookup);
    IF node.expr IS_A Identifier THEN
      match_ident = COPY castLocatableToOptionalIdentifier(node.expr);
    END
    IF ((is_union AND (match_ident != NIL)) AND mIRLowering__capability_state(rtoc_self_view).if_bind_pointer_aliases.contains?(match_ident.name)) THEN
      subject = Deref{ expr: Emittable{ Deref: COPY subject }, lowered_node_id: NIL, ownership_consumption: NIL };
    END
    MUTABLE expr_type = node.expr.resolved_type();
    MUTABLE expr_type_sym = IF expr_type IS_A Type THEN
      expr_type.resolved()
    ELSE
      expr_type
    END;
    MUTABLE is_int_match = !(!(((((!(is_union) AND !(node.string_match)) AND ((((((expr_type == :Int64) OR (expr_type == :Int32)) OR (expr_type == :Int16)) OR (expr_type == :Int8)) OR ((expr_type IS_A Type AND type__integer?(expr_type)))))) AND (node.cases |> ALL (((matchCase__kind(_) != :when) AND (matchCase__kind(_) != :struct_pattern)) AND (([matchCase__value(_)] + (matchCase__extra_values(_))) |> ALL (_ IS_A Literal AND (((_.type() == :INT64) OR (_.type() == :NUMBER)))))))))));
    MUTABLE is_enum_match = !(!((((((!(is_union) AND !(node.string_match)) AND expr_type_sym) AND (TRY (mIRLowering__enum_schemas(rtoc_self_view))).contains?(expr_type_sym)) AND (node.cases |> ALL (((matchCase__kind(_) != :when) AND (matchCase__kind(_) != :struct_pattern)) AND (([matchCase__value(_)] + (matchCase__extra_values(_))) |> ALL _ IS_A GetField)))))));
    RETURN MatchLoweringFacts{ expr_label: COPY expr_label, subject: Emittable{ Deref: COPY subject }, is_union: is_union, is_int_match: is_int_match, is_enum_match: is_enum_match, expr_type_sym: COPY CAST(IF is_union THEN
      union_lookup
    ELSE
      expr_type_sym
    END AS String@symbol) };
}
END
PRIVATE FN mIRLowering__match_union_lookup(self: MIRLowering, expression: Locatable) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE type = TRY (type__new((expression.resolved_type() OR :Any)));
    IF type__generic_instance?(type) THEN
      RETURN type__generic_base(type);
    END
    RETURN type__resolved(type);
}
END
PRIVATE FN mIRLowering__lower_match_branch(MUTABLE self: MIRLowering, stmts: []Locatable, expr_label: ?String) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF expr_label EXISTS AS expr_label_value THEN
      RETURN TRY (mIRLowering__lower_body_with_break(&rtoc_self_view, stmts, expr_label_value));
    ELSE
      RETURN TRY (mIRLowering__lower_body(&rtoc_self_view, stmts));
    END
}
END
PRIVATE FN mIRLowering__lower_union_match(MUTABLE self: MIRLowering, node: MatchStatement, facts: MatchLoweringFacts) RETURNS UnionMatchStmt
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE arms = node.cases |> UNNEST mIRLowering__union_match_arm_plans(&rtoc_self_view, _, node, facts.expr_label);
    MUTABLE default: ?[]Emittable = mIRLowering__union_match_default_body(&rtoc_self_view, node, facts, arms);
    IF default EXISTS AS default_value THEN
      MUTABLE default_value = mIRLowering__hoist_unhoisted_return_allocs(rtoc_self_view, default_value, (node.default_case OR_ELSE List[]));
    END
    RETURN UnionMatchStmt{ subject: COPY facts.subject, arms: arms |> SELECT UnionMatchArm{ variant: COPY _.variant(), payload: COPY _.payload_name(), body: COPY _.body(), pointer_payload: _.pointer_payload() }, default_body: default, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
}
END
PRIVATE FN mIRLowering__union_match_default_body(MUTABLE self: MIRLowering, node: MatchStatement, facts: MatchLoweringFacts, arms: []UnionMatchArmPlan) RETURNS !?[]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE schema: ?UnionSchema@multiowned = COPY (TRY (mIRLowering__union_schemas(rtoc_self_view)))[facts.expr_type_sym];
    MUTABLE all_variants: []Any = List[];
    IF (IF schema?.variants != NIL THEN
      (schema?.variants).keys() |> SELECT _.toString()
    ELSE
      NIL
    END) != NIL THEN
      all_variants = COPY (((IF schema?.variants != NIL THEN
      (schema?.variants).keys() |> SELECT _.toString()
    ELSE
      NIL
    END))?) |> ORDER_BY _;
    END
    MUTABLE covered = (arms |> SELECT _.variant) |> SELECT _.toString() |> ORDER_BY _;
    IF (covered == all_variants) THEN
      RETURN NIL;
    END
    IF ((node.default_case != NIL) AND !(((node.default_case)?).empty?())) THEN
      RETURN mIRLowering__lower_match_branch(&rtoc_self_view, (node.default_case)?, facts.expr_label);
    END
    RETURN List[];
}
END
PRIVATE FN mIRLowering__union_match_arm_plans(MUTABLE self: MIRLowering, c: MatchCase, node: MatchStatement, expr_label: ?String) RETURNS ![]UnionMatchArmPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE variants = mIRLowering__union_match_case_variants(rtoc_self_view, c);
    MUTABLE body = mIRLowering__lower_match_branch(&rtoc_self_view, c.body, expr_label);
    body = mIRLowering__hoist_unhoisted_return_allocs(rtoc_self_view, body, c.body);
    IF !((IF c.binding != NIL THEN c.binding ELSE c.destructure END)) THEN
      RETURN variants |> SELECT UnionMatchArmPlan{ variant: COPY _, body: COPY body, payload_name: NIL, pointer_payload: FALSE };
    END
    RETURN variants |> SELECT {
    MUTABLE payload_name = "__match_payload_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_763 = mIRLowering__lowering_counters(rtoc_self_view);
    mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_763) }}";
    MUTABLE arm_body = (mIRLowering__union_match_payload_bindings(rtoc_self_view, c, payload_name, node) + COPY body);
    UnionMatchArmPlan{ variant: COPY _, body: COPY arm_body, payload_name: COPY payload_name, pointer_payload: (c.binding_mutable == TRUE) }
    };
}
END
PRIVATE FN mIRLowering__union_match_case_variants(self: MIRLowering, c: MatchCase) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ([c.value] + (c.extra_values)) |> SELECT:? mIRLowering__union_match_variant_name(rtoc_self_view, _) |> WHERE _ != NIL;
}
END
PRIVATE FN mIRLowering__union_match_variant_name(self: MIRLowering, value: Locatable) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF value IS_A GetField AS get_field THEN
      RETURN COPY CAST(get_field.field AS String);
    ELSE_IF (value IS_A MethodCall) OR (value IS_A Identifier) THEN
      RETURN COPY CAST(value.name() AS String);
    ELSE
      panic("union MATCH variant must be a named variant, got {}");
    END
}
END
PRIVATE FN mIRLowering__union_match_payload_bindings(self: MIRLowering, c: MatchCase, payload_name: String, node: MatchStatement) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE is_mutable = (((node.expr IS_A Identifier AND (node.expr.was_moved() == TRUE))) OR (c.binding_mutable == TRUE));
    MUTABLE payload = Ident{ name: COPY payload_name, lowered_node_id: NIL, ownership_consumption: NIL };
    IF c.indirect_payload_as THEN
      payload = Deref{ expr: Emittable{ Ident: COPY payload }, lowered_node_id: NIL, ownership_consumption: NIL };
    END
    IF c.binding EXISTS AS binding_value THEN
      MUTABLE binding = COPY binding_value;
      RETURN CAST([Emittable{ Let: COPY Let{ name: COPY binding, init: Emittable{ Ident: COPY payload }, mutable: is_mutable, annotation: NIL, suppression: "_ = &${binding};", alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }] AS []Emittable);
    END
    MUTABLE destructure: ?StructPattern = COPY c.destructure;
    IF destructure EXISTS AS destructure_value THEN
      RETURN destructure_value.fields |> SELECT:? (IF patternField__wildcard?(_) THEN NIL ELSE (IF !(patternField__bind?(_)) THEN NIL ELSE Let{ name: COPY _.name, init: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY payload }, field: COPY _.name, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: FALSE, annotation: NIL, suppression: "_ = &${_.name};", alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } END) END) |> WHERE _ != NIL;
    ELSE
      RETURN CAST(( { MUTABLE rtoc_empty_list_764: []Emittable = List[]; rtoc_empty_list_764 } ) AS []Emittable);
    END
}
END
PRIVATE FN mIRLowering__lower_switch_match(MUTABLE self: MIRLowering, node: MatchStatement, facts: MatchLoweringFacts) RETURNS !SwitchStmt
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE arms = node.cases |> SELECT {
    MUTABLE body = mIRLowering__lower_match_branch(&rtoc_self_view, matchCase__body(_), facts.expr_label);
    MUTABLE patterns: []SwitchPattern = [mIRLowering__switch_match_pattern(&rtoc_self_view, matchCase__value(_), facts.is_enum_match)];
    FOR _ IN (matchCase__extra_values(_)) DO
    &patterns.append(mIRLowering__switch_match_pattern(&rtoc_self_view, _, facts.is_enum_match));
    END
    SwitchArm{ patterns: COPY patterns, body: COPY body }
    };
    MUTABLE default_branch_value: ?[]Emittable = NIL;
    IF (((node.default_case != NIL) AND !(((node.default_case)?).empty?()))) THEN
      default_branch_value = mIRLowering__lower_match_branch(&rtoc_self_view, node.default_case, facts.expr_label);
    ELSE
      default_branch_value = NIL;
    END
    MUTABLE default: ?[]Emittable = default_branch_value;
    IF facts.is_int_match THEN
      default = (default OR_ELSE List[]);
    END
    IF facts.is_enum_match THEN
      MUTABLE all_variants: []Any = List[];
      IF (IF (TRY (mIRLowering__enum_schemas(rtoc_self_view)))[facts.expr_type_sym] != NIL THEN
        ((TRY (mIRLowering__enum_schemas(rtoc_self_view)))[facts.expr_type_sym]) |> SELECT _.toString()
      ELSE
        NIL
      END) != NIL THEN
        all_variants = COPY (((IF (TRY (mIRLowering__enum_schemas(rtoc_self_view)))[facts.expr_type_sym] != NIL THEN
        ((TRY (mIRLowering__enum_schemas(rtoc_self_view)))[facts.expr_type_sym]) |> SELECT _.toString()
      ELSE
        NIL
      END))?) |> ORDER_BY _;
      END
      MUTABLE covered = (node.cases |> UNNEST {
    MUTABLE value: GetField = CAST(matchCase__value(_) AS GetField);
    MUTABLE extras = matchCase__extra_values(_) |> SELECT CAST(castLocatableToGetField(_).field AS String);
    ([CAST(value.field AS String)] + extras)
      }) |> ORDER_BY _;
      MUTABLE exhaustive = (covered == all_variants);
      IF ((default != NIL) AND exhaustive) THEN
        default = NIL;
      END
      IF (!(NIL) AND !(exhaustive)) THEN
        default = List[];
      END
    END
    RETURN SwitchStmt{ subject: COPY facts.subject, arms: COPY arms, default_body: default, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
}
END
PRIVATE FN mIRLowering__switch_match_pattern(MUTABLE self: MIRLowering, value: Locatable, is_enum_match: Bool) RETURNS !SwitchPattern
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF is_enum_match THEN
      RETURN SwitchPattern{ EnumSwitchPattern: COPY EnumSwitchPattern{ variant: COPY CAST(castLocatableToGetField(value).field AS String) } };
    END
    RETURN TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(value)));
}
END
PRIVATE FN mIRLowering__hoist_unhoisted_return_allocs(self: MIRLowering, body: []Emittable, ast_stmts: []Locatable) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE returns: []Locatable = ( { MUTABLE rtoc_empty_list_765: []Locatable = List[]; rtoc_empty_list_765 } );
    FOR _ IN ast_stmts DO
    IF (IF _ IS_A ReturnNode AS return_node THEN return_node.value ELSE FALSE END) THEN
      &returns.append(_.value());
    END
    END
    MUTABLE ret_i: Int64 = 0;
    RETURN body |> UNNEST {
    IF !(((IF _ IS_A ReturnStmt AS return_stmt THEN return_stmt.value ELSE FALSE END) AND mIRLowering__mir_allocates?(rtoc_self_view, _.value()))) THEN
        IF _ IS_A ReturnStmt AS return_stmt THEN
          ret_i = (ret_i + 1);
        END
        CONTINUE;
    END
    MUTABLE ast_value: ?Locatable = COPY returns[ret_i];
    ret_i = (ret_i + 1);
    MUTABLE name = "__tmp_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_766 = mIRLowering__lowering_counters(rtoc_self_view);
    mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_766) }}";
    MUTABLE return_value = _.value();
    MUTABLE entry: ?CleanupEntry@multiowned = mIRLowering__hoist_cleanup_entry(rtoc_self_view, return_value, ast_value);
    MUTABLE materialized = BindingMaterialization{ name: COPY name, expr: COPY return_value, alloc: :heap, type_info: CAST(COPY mIRLowering__mir_alloc_mark_type_info(rtoc_self_view, return_value, ast_value, "unhoisted return allocation") AS Type), mutable: FALSE, cleanup_entry: entry, cleanup_mode: IF entry != NIL THEN
        :err
      ELSE
        :normal
      END, scope: :heap, annotation: NIL, suppression: NIL, ownership_tracked: TRUE };
    MUTABLE out: []Stmt = TRY (bindingMaterialization__statements(materialized));
    IF entry EXISTS AS entry_value THEN
        MUTABLE plan = mIRLowering__synthetic_return_ownership_plan(rtoc_self_view, name);
        out = ruby_array_concat_Stmt(out, TRY (returnOwnershipPlan__transfer_marks_for(plan, [name] |> DISTINCT _, mIRLowering__function_state(rtoc_self_view).lowered_guarded_cleanup_names)));
    END
    &out.append(Stmt{ Emittable: COPY CAST(ReturnStmt{ value: Emittable{ Ident: COPY Ident{ name: name, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) });
    out
    };
}
END
PRIVATE FN mIRLowering__lower_return(MUTABLE self: MIRLowering, node: ReturnNode) RETURNS !NodeRoot
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE plan = mIRLowering__return_lowering_plan(&rtoc_self_view, node);
    MUTABLE value: ?Emittable = mIRLowering__finalize_return_value(rtoc_self_view, node, plan.value);
    IF ((value != NIL) AND hoist__noreturn_value?(node.value)) THEN
      RETURN NodeRoot{ Emittable: COPY value };
    END
    IF (IF value? IS_A Call AS call THEN mIRLowering__tail_call_return?(rtoc_self_view, Emittable{ Call: COPY call }) ELSE FALSE END) THEN
      RETURN NodeRoot{ Emittable: COPY CAST(ReturnStmt{ value: Emittable{ TailCall: COPY TailCall{ callee: COPY value.callee(), args: COPY value.args(), callable_contract: COPY value.callable_contract(), lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) };
    END
    IF ((node.value AND TRY (mIRLowering__rc_retain_needed?(rtoc_self_view, node.value))) AND !(mIRLowering__return_transfers_heap_binding?(rtoc_self_view, node.value))) THEN
      MUTABLE retained = mIRLowering__hoist_alloc(rtoc_self_view, Emittable{ RcRetain: COPY TRY (mIRLowering__make_rc_retain(&rtoc_self_view, node.value)) }, node.value, TRUE);
      RETURN mIRLowering__return_with_transfer_marks(rtoc_self_view, plan, retained, ReturnStmt{ value: COPY retained, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
    ELSE
      IF ((value != NIL) AND !(value IS_A Ident)) THEN
        value = mIRLowering__hoist_alloc(rtoc_self_view, value, node.value, TRUE, FALSE, FALSE);
      END
      IF value EXISTS AS value_value THEN
        MUTABLE value_value = mIRLowering__bind_consuming_call_return_value(rtoc_self_view, value_value);
      END
      RETURN mIRLowering__return_with_transfer_marks(rtoc_self_view, plan, value, ReturnStmt{ value: UNWRAP (COPY value), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
    END
}
END
PRIVATE FN mIRLowering__bind_consuming_call_return_value(self: MIRLowering, value: Emittable) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((value IS_A Call OR value IS_A MIRMethodCall)) THEN
      RETURN COPY value;
    END
    MUTABLE fact = value.ownership_consumption();
    IF !((fact IS_A OwnershipConsumptionFact AND !((TRY (callOwnershipFacts__operands(fact))).empty?()))) THEN
      RETURN COPY value;
    END
    MUTABLE name = "__ret_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_767 = mIRLowering__lowering_counters(rtoc_self_view);
    mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_767) }}";
    mIRLowering__function_state(rtoc_self_view).pending_stmts.append(Stmt{ Emittable: COPY CAST(Let{ name: COPY name, init: COPY value, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } AS Emittable) });
    RETURN Emittable{ Ident: COPY Ident{ name: name, lowered_node_id: NIL, ownership_consumption: NIL } };
}
END
PRIVATE FN mIRLowering__finalize_return_value(self: MIRLowering, node: ReturnNode, value_input: ?Emittable) RETURNS ?Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE value = COPY value_input;
    value = mIRLowering__generic_parameter_return_copy(rtoc_self_view, node, value);
    value = mIRLowering__return_payload_pointer_value(rtoc_self_view, node, value);
    value = mIRLowering__heap_carry_return_value(rtoc_self_view, node, value);
    RETURN mIRLowering__heap_carry_recursive_param_value(rtoc_self_view, node, value);
}
END
PRIVATE FN mIRLowering__generic_parameter_return_copy(self: MIRLowering, node: ReturnNode, value: ?Emittable) RETURNS !?Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((node.value AND ((value != NIL) AND (value IS_A Ident)))) THEN
      RETURN COPY value;
    END
    IF !(mIRLowering__current_function_param_name?(rtoc_self_view, value.name())) THEN
      RETURN COPY value;
    END
    IF !(mIRLowering__current_function_has_rt?(rtoc_self_view)) THEN
      RETURN COPY value;
    END
    IF mIRLowering__current_function_takes_param_name?(rtoc_self_view, value.name()) THEN
      RETURN COPY value;
    END
    MUTABLE ret_type = TRY (type__from_node_mut(node.value, "generic parameter return"));
    IF !(type__generic_type_parameter?(ret_type)) THEN
      RETURN COPY value;
    END
    RETURN Emittable{ DeepCopy: COPY DeepCopy{ source: UNWRAP (COPY value), zig_type: COPY TRY (type__zig_type(ret_type)), elem_type: NIL, strategy: :full_value, alloc: :heap, copy_shape: NIL, type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL } };
}
END
PRIVATE FN mIRLowering__return_payload_pointer_value(self: MIRLowering, node: ReturnNode, value: ?Emittable) RETURNS !?Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE payload_zig: ?String = mIRLowering__current_function_return_payload_zig(rtoc_self_view);
    IF !((IF payload_zig != NIL THEN
      payload_zig.startsWith?("*")
    ELSE
      NIL
    END)) THEN
      RETURN COPY value;
    END
    IF value EXISTS AS value_value THEN
      MUTABLE value_value_mutable = COPY value_value;
      IF (value_value_mutable IS_A HeapCreate OR value_value_mutable IS_A Call) THEN
        RETURN COPY value_value_mutable;
      END
      IF mIRLowering__return_value_already_payload_pointer?(rtoc_self_view, node.value) THEN
        RETURN COPY value_value_mutable;
      END
      MUTABLE bare_ret = payload_zig.deletePrefix("*");
      RETURN TRY (mIRLowering__with_ownership_consumption(rtoc_self_view, Emittable{ HeapCreate: COPY HeapCreate{ zig_type: COPY bare_ret, init: COPY value_value_mutable, alloc: :heap, label: "ret", lowered_node_id: NIL, ownership_consumption: NIL } }, mIRLowering__mir_ident_names(rtoc_self_view, value_value_mutable), "MIR::HeapCreate", :owned_sink, :heap));
    ELSE
      RETURN COPY value;
    END
}
END
PRIVATE FN mIRLowering__heap_carry_return_value(self: MIRLowering, node: ReturnNode, value: ?Emittable) RETURNS !?Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(((mIRLowering__current_function_heap_carry_return?(rtoc_self_view) AND node.value) AND (value != NIL))) THEN
      RETURN COPY value;
    END
    IF value? IS_A Ident AS ident THEN
      RETURN COPY Emittable{ Ident: COPY ident };
    END
    IF mIRLowering__return_transfers_heap_binding?(rtoc_self_view, node.value) THEN
      RETURN COPY value;
    END
    IF (mIRLowering__mir_allocates?(rtoc_self_view, value) OR ((IF value? IS_A Call AS call THEN call__owned_return?(call) ELSE FALSE END))) THEN
      RETURN COPY value;
    END
    MUTABLE ret_type = TRY (type__from_node_mut(node.value, "heap carry return placement"));
    ret_type = TRY (type__success_type(ret_type));
    IF (mIRLowering__escaping_value_alloc(rtoc_self_view, ret_type) == :heap) THEN
      RETURN TRY (mIRLowering__place_value_for_destination(rtoc_self_view, UNWRAP (value), node.value, :heap, TypeTypeInput{ Type: COPY ret_type }));
    ELSE
      RETURN COPY value;
    END
}
END
PRIVATE FN mIRLowering__heap_carry_recursive_param_value(self: MIRLowering, node: ReturnNode, value: ?Emittable) RETURNS !?Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(((mIRLowering__current_function_heap_carry_return?(rtoc_self_view) AND node.value) AND ((value != NIL) AND (value IS_A Ident)))) THEN
      RETURN COPY value;
    END
    IF !(mIRLowering__current_function_param_name?(rtoc_self_view, value.name())) THEN
      RETURN COPY value;
    END
    IF mIRLowering__current_function_takes_param_name?(rtoc_self_view, value.name()) THEN
      RETURN COPY value;
    END
    MUTABLE ret_type = TRY (type__from_node_mut(node.value, "heap carry recursive return"));
    ret_type = TRY (type__success_type(ret_type));
    IF TRY (type__recursive_cleanup_shape?(ret_type, mIRLowering__mir_schema_lookup(rtoc_self_view))) THEN
      RETURN Emittable{ DeepCopy: COPY DeepCopy{ source: UNWRAP (COPY value), zig_type: COPY TRY (type__zig_type(ret_type)), elem_type: NIL, strategy: :full_value, alloc: :heap, copy_shape: NIL, type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE
      RETURN COPY value;
    END
}
END
PRIVATE FN mIRLowering__tail_call_return?(self: MIRLowering, value: ?Emittable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN !(!(((((mIRLowering__current_function_tail_call?(rtoc_self_view) AND !(mIRLowering__program_state(rtoc_self_view).debug_mode)) AND ((value != NIL) AND (value IS_A Call))) AND (value.callee() == mIRLowering__current_function_zig_name(rtoc_self_view))))));
}
END
PRIVATE FN mIRLowering__return_with_transfer_marks(self: MIRLowering, plan: ReturnOwnershipPlan, value: ?Emittable, ret: ReturnStmt) RETURNS !NodeRoot
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE names = TRY (returnOwnershipPlan__returned_names(plan));
    IF value? IS_A Ident AS ident THEN
      IF names.contains?(CAST(ident.name AS String)) THEN
        names = COPY names;
      ELSE
        names = COPY [CAST(ident.name AS String)] |> DISTINCT _;
      END
    ELSE_IF value THEN
      MUTABLE value_names = mIRLowering__mir_ident_names(rtoc_self_view, value) |> DISTINCT _;
      IF !(value_names.empty?()) THEN
        names = COPY value_names;
      END
    END
    MUTABLE marks = TRY (returnOwnershipPlan__transfer_marks_for(plan, names, mIRLowering__function_state(rtoc_self_view).lowered_guarded_cleanup_names));
    IF ((IF value? IS_A Ident AS ident THEN (marks.length() == 0) ELSE FALSE END) AND mIRLowering__returned_hoist_binding?(rtoc_self_view, CAST(value.name() AS String))) THEN
      marks = TRY (ownershipTransferPlan__marks((OwnershipTransferPlan{ name: COPY CAST(value.name() AS String), target: :return, target_alloc: NIL, move_guarded: mIRLowering__lowered_guarded_cleanup_name?(rtoc_self_view, CAST(value.name() AS String)) })));
    END
    IF (marks.length() == 0) THEN
      RETURN COPY NodeRoot{ Emittable: Emittable{ ReturnStmt: COPY ret } };
    ELSE
      RETURN (marks + [ret]);
    END
}
END
PRIVATE FN mIRLowering__synthetic_return_ownership_plan(self: MIRLowering, name: String) RETURNS ReturnOwnershipPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE names: [Set]String = COPY [name] |> DISTINCT _;
    RETURN ReturnOwnershipPlan{ value: Emittable{ Ident: COPY Ident{ name: COPY name, lowered_node_id: NIL, ownership_consumption: NIL } }, explicit_return_names: COPY Set[], moved_root_names: COPY Set[], consumed_root_names: COPY Set[], direct_value_names: COPY names, converted_cleanup_names: COPY Set[], transfer_required_names: COPY names, move_guard_required_names: COPY names };
}
END
PRIVATE FN mIRLowering__return_lowering_plan(MUTABLE self: MIRLowering, node: ReturnNode) RETURNS !ReturnOwnershipPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE ret_alloc: ?String@symbol = TRY (mIRLowering__return_destination_alloc(rtoc_self_view, node));
    MUTABLE value_branch_value: ?U = NIL;
    IF node.value THEN
      value_branch_value = mIRLowering__with_decl_alloc(rtoc_self_view, ret_alloc, %() USE(node, ret_alloc, MUTABLE rtoc_self_view) -> {
    MUTABLE destination_type: ?Type@multiowned = mIRLowering__return_value_destination_type(rtoc_self_view, node);
    MUTABLE lowered = mIRLowering__with_expected_type(rtoc_self_view, CAST(destination_type AS ?Type), %() USE(node, MUTABLE rtoc_self_view) -> {
      rtoc_lambda_result_768 = TRY (mIRLowering__lower(&rtoc_self_view, node.value));
      rtoc_lambda_result_768
    });
    TRY (mIRLowering__place_value_for_destination(rtoc_self_view, lowered, node.value, ret_alloc, ruby_wrap_optional_Type_multiowned_TypeTypeInput(destination_type)))
      });
    ELSE
      value_branch_value = NIL;
    END
    MUTABLE value: ?U = value_branch_value;
    MUTABLE explicit_return_names: [Set]String = Set[];
    IF (node.value AND !(mIRLowering__aggregate_return_literal?(rtoc_self_view, node.value))) THEN
      explicit_return_names = mIRLowering__returned_binding_names(rtoc_self_view, node.value);
    ELSE
      explicit_return_names = Set[];
    END
    MUTABLE moved_root_names: [Set]String = Set[];
    MUTABLE consumed_root_names: [Set]String = Set[];
    MUTABLE direct_value_names: [Set]String = Set[];
    IF ((value != NIL) AND (value IS_A Ident)) THEN
      &direct_value_names.insert(value.name());
    END
    MUTABLE returned_names: [Set]String = Set[];
    FOR _ IN ([explicit_return_names, moved_root_names, consumed_root_names, direct_value_names]) DO
    FOR _ IN _ DO
    &returned_names.insert(COPY _);
    END
    END
    MUTABLE transfer_required_names = mIRLowering__return_transfer_required_names(rtoc_self_view, returned_names);
    MUTABLE move_guard_required_names = mIRLowering__return_move_guard_required_names(rtoc_self_view, returned_names);
    RETURN ReturnOwnershipPlan{ value: COPY value, explicit_return_names: COPY explicit_return_names, moved_root_names: COPY moved_root_names, consumed_root_names: COPY consumed_root_names, direct_value_names: COPY direct_value_names, converted_cleanup_names: COPY Set[], transfer_required_names: COPY transfer_required_names, move_guard_required_names: COPY move_guard_required_names };
}
END
PRIVATE FN mIRLowering__aggregate_return_literal?(self: MIRLowering, expr: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE node: Locatable = COPY expr;
    WHILE node IS_A Cast DO
      node = node.value;
    END
    RETURN ((node IS_A StructLit OR node IS_A UnionVariantLit) OR node IS_A ListLit);
}
END
PRIVATE FN mIRLowering__return_transfers_heap_binding?(self: MIRLowering, ast_node: Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE node: Locatable = COPY ast_node;
    WHILE (node IS_A Cast OR node IS_A MoveNode) DO
      node = node.value;
    END
    IF (node IS_A GetField OR node IS_A GetIndex) THEN
      RETURN FALSE;
    END
    MUTABLE root = (aST__root_identifier(node) OR_ELSE NIL);
    MUTABLE entry_branch_value: ?CleanupEntry@multiowned = NIL;
    IF root THEN
      entry_branch_value = COPY (TRY (functionState__bindings(mIRLowering__function_state(rtoc_self_view))))[root.name()];
    ELSE
      entry_branch_value = NIL;
    END
    MUTABLE entry: ?CleanupEntry@multiowned = entry_branch_value;
    IF (IF entry != NIL THEN
      cleanupEntry__present?(entry)
    ELSE
      NIL
    END) THEN
      RETURN (cleanupEntry__needs_cleanup?(entry) AND cleanupEntry__heap?(entry));
    END
    RETURN !(!((((root AND mIRLowering__current_function_takes_param_name?(rtoc_self_view, CAST(root.name() AS String))) AND ((root.symbol() != NIL) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_769 = ((root.symbol())?);
    symbolEntry__heap_storage?(rtoc_local_receiver_769) })))));
}
END
PRIVATE FN mIRLowering__return_destination_type(self: MIRLowering, node: ReturnNode) RETURNS !?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE ti: ?Type@multiowned = mIRLowering__current_function_return_type(rtoc_self_view);
    IF ti != NIL THEN
    RETURN TRY (type__success_type((ti?)));
    ELSE
    RETURN NIL;
    END
}
END
PRIVATE FN mIRLowering__return_value_destination_type(self: MIRLowering, node: ReturnNode) RETURNS !?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE declared: ?Type@multiowned = mIRLowering__return_destination_type(rtoc_self_view, node);
    IF !(node.value) THEN
      RETURN CAST(declared AS ?Type);
    END
    MUTABLE value_type = TRY (type__from_node_mut(node.value, "return destination value"));
    IF type__collection?(value_type) THEN
      RETURN value_type;
    END
    RETURN CAST(declared AS ?Type);
}
END
PRIVATE FN mIRLowering__return_value_already_payload_pointer?(self: MIRLowering, ast_node: ?Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE payload_zig: ?String = mIRLowering__current_function_return_payload_zig(rtoc_self_view);
    IF ast_node EXISTS AS ast_node_value THEN
      IF payload_zig THEN
        MUTABLE ti = TRY (type__from_node_mut(ast_node_value, "return payload pointer"));
        RETURN (TRY (type__zig_type(ti)) == payload_zig);
      ELSE
        RETURN FALSE;
      END
    ELSE
      RETURN FALSE;
    END
}
CATCH Transient, Input, System, NotFound, Permission, Canceled
  RETURN FALSE;
END
PRIVATE FN mIRLowering__returned_binding_names(self: MIRLowering, expr: Locatable) RETURNS ![Set]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE names: [Set]String = Set[];
    mIRLowering__collect_returned_binding_names(rtoc_self_view, expr, &names);
    RETURN names;
}
END
PRIVATE FN mIRLowering__return_transfer_required_names(self: MIRLowering, names: [Set]String) RETURNS ![Set]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE out: [Set]String = Set[];
    FOR _ IN names DO
    IF mIRLowering__return_transfer_required?(rtoc_self_view, _) THEN
      &out.insert(COPY _);
    END
    END
    RETURN out;
}
END
PRIVATE FN mIRLowering__return_move_guard_required_names(self: MIRLowering, names: [Set]String) RETURNS ![Set]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE out: [Set]String = Set[];
    FOR _ IN names DO
    IF mIRLowering__return_move_guard_required?(rtoc_self_view, _) THEN
      &out.insert(COPY _);
    END
    END
    RETURN out;
}
END
PRIVATE FN mIRLowering__return_transfer_required?(self: MIRLowering, name: String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (((mIRLowering__pipeline_guarded_cleanup_name?(rtoc_self_view, name) OR mIRLowering__returned_hoist_binding?(rtoc_self_view, name)) OR mIRLowering__returned_takes_param?(rtoc_self_view, name)) OR mIRLowering__returned_owned_binding?(rtoc_self_view, name));
}
END
PRIVATE FN mIRLowering__return_move_guard_required?(self: MIRLowering, name: String) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF mIRLowering__pipeline_guarded_cleanup_name?(rtoc_self_view, name) THEN
      RETURN TRUE;
    END
    IF mIRLowering__lowered_guarded_cleanup_name?(rtoc_self_view, name) THEN
      RETURN TRUE;
    END
    MUTABLE entry: ?CleanupEntry@multiowned = COPY (TRY (functionState__bindings(mIRLowering__function_state(rtoc_self_view))))[name];
    RETURN !(!(((IF entry != NIL THEN
      cleanupEntry__needs_cleanup?(entry)
    ELSE
      NIL
    END))));
}
END
PRIVATE FN mIRLowering__returned_takes_param?(self: MIRLowering, name: String) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE entry: ?CleanupEntry@multiowned = COPY (TRY (functionState__bindings(mIRLowering__function_state(rtoc_self_view))))[name];
    IF entry EXISTS AS entry_value THEN
      IF (entry_value[:source_kind] == :takes_param) THEN
        MUTABLE ti: ?Type@multiowned = COPY (TRY (functionState__binding_types(mIRLowering__function_state(rtoc_self_view))))[name];
        RETURN (!(ti) OR mIRLowering__ownership_tracked_transfer_type?(rtoc_self_view, CAST(ti AS Type)));
      ELSE
        RETURN FALSE;
      END
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN mIRLowering__returned_hoist_binding?(self: MIRLowering, name: String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(name.startsWith?("__hoist_")) THEN
      RETURN FALSE;
    END
    RETURN mIRLowering__function_state(rtoc_self_view).lowered_alloc_names.contains?(name);
}
END
PRIVATE FN mIRLowering__returned_owned_binding?(self: MIRLowering, name: String) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE entry: ?CleanupEntry@multiowned = COPY (TRY (functionState__bindings(mIRLowering__function_state(rtoc_self_view))))[name];
    IF ((entry != NIL) AND !(cleanupEntry__needs_cleanup?(entry))) THEN
      IF !((IF cleanupEntry__lifecycle_plan(entry) != NIL THEN
        lifecyclePlan__needs_drop?((cleanupEntry__lifecycle_plan(entry)))
      ELSE
        NIL
      END)) THEN
        RETURN FALSE;
      END
    END
    MUTABLE ti: ?Type@multiowned = COPY (TRY (functionState__binding_types(mIRLowering__function_state(rtoc_self_view))))[name];
    IF ((!((IF entry != NIL THEN
      cleanupEntry__lifecycle_plan(entry)
    ELSE
      NIL
    END)) AND (ti != NIL)) AND !(mIRLowering__ownership_tracked_transfer_type?(rtoc_self_view, CAST(ti AS Type)))) THEN
      RETURN FALSE;
    END
    IF mIRLowering__owned_binding_visible?(rtoc_self_view, name) THEN
      RETURN TRUE;
    END
    RETURN !(!(((IF entry != NIL THEN
      cleanupEntry__needs_cleanup?(entry)
    ELSE
      NIL
    END))));
}
END
PRIVATE FN mIRLowering__returned_no_cleanup_binding?(self: MIRLowering, name: String) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE entry: ?CleanupEntry@multiowned = COPY (TRY (functionState__bindings(mIRLowering__function_state(rtoc_self_view))))[name];
    RETURN !(!(((((entry != NIL) AND cleanupEntry__present?(entry)) AND !(cleanupEntry__needs_cleanup?(entry))))));
}
END
PRIVATE FN mIRLowering__collect_fn_returned_names(self: MIRLowering, body: []Node) RETURNS ![Set]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE names: [Set]String = Set[];
    aST__walk_body(Body{ ArrayValue: body |> SELECT castNodeToLocatable(_) }, %(node: Locatable) USE(MUTABLE names, rtoc_self_view) -> {
    IF node IS_A ReturnNode AS return_node THEN
        mIRLowering__collect_returned_binding_names(rtoc_self_view, return_node.value, &names);
    END
    rubyToClearVoid()
    });
    RETURN names;
}
END
PRIVATE FN mIRLowering__collect_returned_binding_names(self: MIRLowering, expr: ?Locatable, MUTABLE names: [Set]String) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF expr EXISTS AS expr_value THEN
      IF expr_value IS_A Identifier AS identifier THEN
        MUTABLE decl: ?SymbolEntryRegInput = NIL;
        IF identifier.symbol != NIL THEN
          decl = COPY ((identifier.symbol)?).reg;
        END
        MUTABLE name = ((((decl != NIL) AND ((TRY (functionState__decl_zig_names(mIRLowering__function_state(rtoc_self_view))))[decl.object_id()] != NIL))) OR mIRLowering__zig_safe_name(rtoc_self_view, identifier__name(identifier)));
        IF name THEN
          &names.insert(name);
        END
      ELSE_IF (expr_value IS_A Cast) OR (expr_value IS_A MoveNode) OR (expr_value IS_A ShareNode) THEN
        mIRLowering__collect_returned_binding_names(rtoc_self_view, expr_value.value(), &names);
      ELSE_IF expr_value IS_A CopyNode AS copy_node THEN
        RETURN;
      ELSE_IF expr_value IS_A KeepNode AS keep_node THEN
        RETURN;
      ELSE_IF expr_value IS_A FreezeNode AS freeze_node THEN
        RETURN;
      ELSE_IF expr_value IS_A StructLit AS struct_lit THEN
        FOR _ IN struct_lit.fields.values() DO
        mIRLowering__collect_returned_binding_names(rtoc_self_view, _, &names);
        END
      ELSE_IF expr_value IS_A UnionVariantLit AS union_variant_lit THEN
        FOR _ IN union_variant_lit.fields.values() DO
        mIRLowering__collect_returned_binding_names(rtoc_self_view, _, &names);
        END
      ELSE_IF expr_value IS_A ListLit AS list_lit THEN
        FOR _ IN list_lit.items DO
        mIRLowering__collect_returned_binding_names(rtoc_self_view, _, &names);
        END
      ELSE_IF expr_value IS_A BinaryOp AS binary_op THEN
        IF (binary_op.op == symbol("OR_ELSE")) THEN
          mIRLowering__collect_returned_binding_names(rtoc_self_view, binary_op.left, &names);
          mIRLowering__collect_returned_binding_names(rtoc_self_view, binary_op.right, &names);
        END
      END
      NIL;
    ELSE
      RETURN;
    END
}
END
PRIVATE FN mIRLowering__call_union_return_needs_hoist?(self: MIRLowering, expr: Emittable, MUTABLE ast_node: Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF expr IS_A Call AS call THEN
      IF !(TRUE) THEN
        RETURN FALSE;
      END
      MUTABLE ti = &ast_node.full_type_mut("union return hoist");
      ti = (TRY (type__success_type(ti)) OR ti);
      MUTABLE is_heap = (((TRUE AND ast_node.heap_storage?())) OR ti.heap?());
      IF is_heap THEN
        RETURN FALSE;
      END
      RETURN !(!((((TRY (mIRLowering__union_schemas(rtoc_self_view))).contains?(ti.resolved()) AND mIRLowering__ownership_bearing_type?(rtoc_self_view, ti)))));
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN mIRLowering__aggregate_temporary_needs_hoist?(self: MIRLowering, expr: Emittable, MUTABLE ast_node: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF expr IS_A TupleLiteral AS tuple_literal THEN
    IF ast_node IS_A TupleLit THEN
        RETURN mIRLowering__ownership_bearing_type?(rtoc_self_view, &ast_node.full_type_mut("aggregate argument hoist"));
      ELSE
        RETURN FALSE;
      END
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN mIRLowering__universal_poly_arg_needs_addr?(self: MIRLowering, arg_node: Locatable, callee_sig: ?FunctionSignature, idx: Int64) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((callee_sig != NIL)) THEN
      RETURN FALSE;
    END
    IF !(TRY (functionSignature__requires(callee_sig))) THEN
      RETURN FALSE;
    END
    MUTABLE param: ?Param = COPY (TRY (functionSignature__params(callee_sig)))[idx];
    IF param EXISTS AS param_value THEN
      MUTABLE pname = COPY CAST(param_value.name AS String);
      MUTABLE fams: ?[Set]String@symbol = COPY (TRY (functionSignature__requires(callee_sig)))[pname];
      IF fams EXISTS AS fams_value THEN
        IF fams_value.empty?() THEN
          IF arg_node IS_A Identifier AS identifier THEN
            MUTABLE sym: ?SymbolEntry = identifier.symbol;
            IF sym EXISTS AS sym_value THEN
              IF symbolEntry__with_match_capability_family?(sym_value) THEN
                RETURN FALSE;
              END
              IF !((TRUE AND sym_value.mutable)) THEN
                RETURN FALSE;
              END
              RETURN TRUE;
            ELSE
              RETURN FALSE;
            END
          ELSE
            RETURN FALSE;
          END
        ELSE
          RETURN FALSE;
        END
      ELSE
        RETURN FALSE;
      END
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN mIRLowering__callee_needs_rt?(self: MIRLowering, name: String) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (FALSE OR (name.length() == 0)) THEN
      RETURN TRUE;
    END
    MUTABLE sig: ?FunctionSignature@multiowned = TRY (mIRLowering__fn_sig_for(rtoc_self_view, Name{ StringValue: COPY name }));
    IF sig EXISTS AS sig_value THEN
      MUTABLE sig_value_mutable = COPY sig_value;
      IF functionSignature__intrinsic(sig_value_mutable) THEN
        RETURN ((functionSignature__needs_rt(sig_value_mutable) == TRUE) OR TRY (functionSignature__emits_allocating?(&sig_value_mutable)));
      END
      IF !(((functionSignature__needs_rt(sig_value_mutable) == TRUE) OR (functionSignature__needs_rt(sig_value_mutable) == FALSE))) THEN
        panic("callee {} missing finalized needs_rt metadata before MIR lowering");
      END
      RETURN UNWRAP (functionSignature__needs_rt(sig_value_mutable));
    ELSE
      RETURN TRUE;
    END
}
END
FN mIRLowering__new(input: MIRLoweringInput = MIRLoweringInput{ struct_schemas: {}, enum_schemas: {}, union_schemas: {}, schema_lookup: NIL, lifecycle_registry: lifecycleRegistry__empty(), fn_sigs: {}, moved_guard_info: {}, importer: NIL, source_dir: NIL, debug_mode: FALSE, target: :zig, function_counter_seeds: {} }) RETURNS MIRLowering@multiowned ->
  MUTABLE self = MIRLowering{ active_lifecycle_registry: NIL, state: MIRLoweringState{ input: COPY input, schemas: schemas, counters: mIRLoweringCounters__new(), function_state: COPY FunctionState{ current_function_context: NIL, pending_stmts: List[], current_decl_alloc: NIL, current_expected_type: NIL, current_sink_type: NIL, current_reassignment_target: NIL, current_bindings: {}, current_binding_types: {}, fn_alloc_marked_names: {}, lowered_alloc_names: Set[], lowered_guarded_cleanup_names: Set[], decl_zig_name_map: {}, guarded_cleanup_names: {}, fn_name_rename_map: {}, node_store_types: Set[] }, runtime: COPY MIRLoweringRuntimeState{ rt_name: "rt", emitter: NIL }, program: COPY MIRLoweringProgramState{ fn_sigs: COPY ((COPY input).fn_sigs), importer: COPY (COPY input).importer, source_dir: COPY (COPY input).source_dir, debug_mode: (COPY input).debug_mode, target: COPY (COPY input).target, shard_context: NIL, emitted_extern_modules: Set[], pipeline_host: NIL, emitted_types: Set[], emitted_require_modules: Set[], emitted_import_type_aliases: Set[], used_sharded_map: FALSE, use_debug_allocator: NIL, fn_nodes: {}, function_counter_snapshots: {}, runtime_init_consts: List[], module_const_inits: Set[], module_global_names: Set[] }, capture: COPY MIRLoweringCaptureState{ current_bg_pointer_captures: NIL, current_lambda_pointer_params: Set[], current_fiber_capture_symbols: {}, do_capture_map: NIL, current_stream_is_inf: NIL, current_stream_local: NIL, current_stream_close_label: NIL, current_fsm_inherited_alloc_names: Set[], current_fsm_inherited_guarded_names: Set[], current_fsm_owned_result_guards: {}, last_fsm_result_transfer_facts: List[] }, capabilities: COPY MIRLoweringCapabilityState{ locked_unwrap_map: NIL, rc_unwrap_map: NIL, with_alias_alloc_map: NIL, with_alias_owner_map: NIL, polymorphic_alias_type_map: NIL, if_bind_aliases: Set[], if_bind_pointer_aliases: Set[], atomic_emit_raw: FALSE }, ownership: COPY MIRLoweringOwnershipState{ next_lowered_node_id: 0, finalized_body_ids: Set[], finalized_node_ids: Set[] }, test: COPY MIRLoweringTestState{ active_stubs: {}, stub_label_counter: 0 } } };
  mIRLowering__initialize(&self, input);
  RETURN self @multiowned;
END
