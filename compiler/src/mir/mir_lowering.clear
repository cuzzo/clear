    MUTABLE fallback: ?LookupResult = TRY (intrinsicRegistry__lookup(std_lib, RegistryKey{ StringValue: COPY CAST(node.name() AS String) }));
    IF fallback? IS_A []FunctionSignature@multiowned AS array THEN
