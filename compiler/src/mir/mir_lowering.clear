FN mIRLowering__append_nested_ownership_transfers_for_mir_body(MUTABLE self: MIRLowering, body: []Emittable, inherited_alloc_names: [Set]String, inherited_guarded_names: [Set]String, parent: OwnershipFinalizationContext) RETURNS ![]Emittable
  EFFECTS REENTRANT ->
