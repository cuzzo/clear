      MUTABLE heap_return_var = mIRLowering__current_function_heap_carry_return_var?(rtoc_self_view, CAST(node.name AS String));
      MUTABLE module_global = mIRLowering__program_state(rtoc_self_view).module_global_names.contains?(CAST(node.name AS String));
      MUTABLE assign_alloc =     IF (heap_return_var OR module_global) THEN
        :heap
      ELSE
