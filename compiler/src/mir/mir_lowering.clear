PRIVATE FN mIRLowering__lower_field_assignment_with_cleanup(MUTABLE self: MIRLowering, node: Assignment) RETURNS !ScopeBlock
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lifecycle = node.field_lifecycle_plan;
    IF !((IF lifecycle != NIL THEN
      lifecyclePlan__needs_drop?(CAST(lifecycle AS LifecyclePlan))
    ELSE
      NIL
    END)) THEN
      panic("field cleanup lacks annotation lifecycle plan");
    END
    MUTABLE alloc_sym = mIRLowering__placement_for_node(rtoc_self_view, (mIRLowering__root_receiver_node(rtoc_self_view, castAssignmentNameToOptionalLocatable(node.name)) OR_ELSE node.name));
    MUTABLE receiver_type = TRY (type__from_node_mut(node.name.target(), "field assignment receiver"));
    IF TRY (type__node_reference?(receiver_type)) THEN
      alloc_sym = :heap;
    END
    MUTABLE kept_value = mIRLowering__with_decl_alloc(rtoc_self_view, alloc_sym, %() USE(node, MUTABLE rtoc_self_view) -> mIRLowering__kept_assignment_field_value(&rtoc_self_view, node));
    IF (TRUE AND mIRLowering__mir_allocates?(rtoc_self_view, kept_value)) THEN
      kept_value = mIRLowering__hoist_alloc(rtoc_self_view, kept_value, node.value, TRUE);
    END
    MUTABLE value = kept_value;
    MUTABLE alloc = AllocatorRef{ kind: COPY alloc_sym, lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE field_get: Emittable = CAST(TRY (mIRLowering__lower(&rtoc_self_view, castAssignmentNameToMIRLoweringLowerableStmt(node.name))) AS Emittable);
    MUTABLE type_expr = TypeOf{ expr: COPY field_get, lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE cleanup_call = Call{ callee: "CheatLib.cleanup", args: [Emittable{ TypeOf: COPY type_expr }, Emittable{ AllocatorRef: COPY alloc }, Emittable{ AddressOf: COPY AddressOf{ expr: COPY field_get, lowered_node_id: NIL, ownership_consumption: NIL } }], try_wrap: FALSE, owned_return: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(3)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL };
    MUTABLE assign = Set{ target: COPY field_get, value: COPY value, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    TRY (mIRLowering__with_ownership_consumption_for_value(rtoc_self_view, Emittable{ Set: COPY assign }, value, node.value, "MIR::Set", :owned_sink, alloc_sym));
    RETURN ScopeBlock{ body: COPY CAST(Tuple{ExprStmt{ expr: Emittable{ Call: COPY cleanup_call }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }, assign} AS Tuple<ExprStmt, Set>), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
}
END
PRIVATE FN mIRLowering__lower_auto_lock_assignment(MUTABLE self: MIRLowering, node: Assignment) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE stmts: []Emittable = List[];
    MUTABLE value_pending: []Stmt = List[];
    MUTABLE facts = mIRLowering__auto_lock_assignment_facts(rtoc_self_view, node);
    IF facts.cleanup_alloc EXISTS AS cleanup_alloc_value THEN
      MUTABLE lifecycle = node.field_lifecycle_plan;
      IF !((IF lifecycle != NIL THEN
        lifecyclePlan__needs_drop?(CAST(lifecycle AS LifecyclePlan))
      ELSE
        NIL
      END)) THEN
        panic("auto-lock field cleanup lacks annotation lifecycle plan");
      END
    END
    MUTABLE len_guard = %(old_name, alloc_sym) -> IfStmt{ cond: Emittable{ MIRBinOp: COPY MIRBinOp{ op: ">", left: Emittable{ ListLength: COPY ListLength{ expr: Emittable{ Ident: COPY Ident{ name: old_name, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: [ExprStmt{ expr: Emittable{ FreeSlice: COPY FreeSlice{ slice: Emittable{ Ident: COPY Ident{ name: old_name, lowered_node_id: NIL, ownership_consumption: NIL } }, alloc: COPY alloc_sym, lowered_node_id: NIL, ownership_consumption: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL };
    IF symbolEntry__always_mutable_sync?(facts.sync) THEN
      MUTABLE value = mIRLowering__auto_lock_assignment_value(&rtoc_self_view, node, facts.alloc_sym);
      value_pending = mIRLowering__flush_pending(rtoc_self_view);
      MUTABLE get_field = FieldGet{ object: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: COPY facts.zig_var, lowered_node_id: NIL, ownership_consumption: NIL } }, method: "get", args: ( { MUTABLE rtoc_empty_list_701: []Any = List[]; rtoc_empty_list_701 } ), try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, field: COPY facts.field, lowered_node_id: NIL, ownership_consumption: NIL };
      IF facts.cleanup_alloc EXISTS AS cleanup_alloc_value THEN
        MUTABLE cleanup_alloc_value_mutable = COPY cleanup_alloc_value;
        stmts = (value_pending + CAST([Emittable{ Let: COPY Let{ name: COPY "__old", init: Emittable{ FieldGet: COPY get_field }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }, Emittable{ Set: COPY castEmittableToSet(TRY (mIRLowering__with_ownership_consumption_for_value(rtoc_self_view, Emittable{ Set: COPY Set{ target: Emittable{ FieldGet: COPY get_field }, value: COPY value, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, value, node.value, "MIR::Set", :owned_sink, facts.alloc_sym))) }] AS []Emittable));
        &stmts.append(Emittable{ Call: COPY runtimeCallSpec__call(len_guard, "__old", cleanup_alloc_value_mutable) });
        RETURN Emittable{ ScopeBlock: COPY ScopeBlock{ body: Body{ ArrayValue: TRY (mIRLowering__append_ownership_transfers_for_mir_body(rtoc_self_view, stmts)) |> SELECT castEmittableToLocatable(_) }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
      ELSE
        MUTABLE set = Set{ target: Emittable{ FieldGet: COPY get_field }, value: COPY value, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
        TRY (mIRLowering__with_ownership_consumption_for_value(rtoc_self_view, Emittable{ Set: COPY set }, value, node.value, "MIR::Set", :owned_sink, facts.alloc_sym));
        RETURN Emittable{ Set: COPY set };
      END
    END
    MUTABLE acquire_method: String = "";
    IF symbolEntry__write_locked_sync?(facts.sync) THEN
      acquire_method = "write";
    ELSE
      acquire_method = "acquire";
    END
    MUTABLE prev_locked: ?{String}LockedUnwrapMapValue = COPY mIRLowering__capability_state(rtoc_self_view).locked_unwrap_map;
    MUTABLE rtoc_writer_receiver_702: MIRLoweringCapabilityState = mIRLowering__capability_state(rtoc_self_view);
    rtoc_writer_receiver_702.locked_unwrap_map = ((prev_locked OR_ELSE {})).merge({facts.alias_var: TRUE, facts.var_name: facts.alias_var});
    MUTABLE value = mIRLowering__auto_lock_assignment_value(&rtoc_self_view, node, facts.alloc_sym);
    value_pending = mIRLowering__flush_pending(rtoc_self_view);
    MUTABLE rtoc_writer_receiver_703: MIRLoweringCapabilityState = mIRLowering__capability_state(rtoc_self_view);
    rtoc_writer_receiver_703.locked_unwrap_map = prev_locked;
    MUTABLE alias_field = FieldGet{ object: Emittable{ Ident: COPY Ident{ name: COPY facts.alias_var, lowered_node_id: NIL, ownership_consumption: NIL } }, field: COPY facts.field, lowered_node_id: NIL, ownership_consumption: NIL };
    stmts = (CAST([Emittable{ Let: COPY Let{ name: COPY facts.guard_var, init: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: COPY facts.zig_var, lowered_node_id: NIL, ownership_consumption: NIL } }, method: COPY acquire_method, args: ( { MUTABLE rtoc_empty_list_707: []Any = List[]; rtoc_empty_list_707 } ), try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, mutable: TRUE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }, Emittable{ MIRDeferStmt: COPY MIRDeferStmt{ body: DeferBody{ Emittable: COPY CAST(COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: COPY facts.guard_var, lowered_node_id: NIL, ownership_consumption: NIL } }, method: "release", args: ( { MUTABLE rtoc_empty_list_708: []Any = List[]; rtoc_empty_list_708 } ), try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } AS Emittable) }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ Let: COPY Let{ name: COPY facts.alias_var, init: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: COPY facts.guard_var, lowered_node_id: NIL, ownership_consumption: NIL } }, method: "get", args: ( { MUTABLE rtoc_empty_list_709: []Any = List[]; rtoc_empty_list_709 } ), try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }] AS []Emittable) + value_pending);
    IF facts.cleanup_alloc EXISTS AS cleanup_alloc_value THEN
