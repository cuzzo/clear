        mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_714)) }}";
      END
      safe = mIRLowering__zig_safe_name(self, "${binding}${suffix}");
    END
    MUTABLE rtoc_index_receiver_715 = TRY (functionState__alloc_marked_names(mIRLowering__function_state(&self)));
    rtoc_index_receiver_715[safe] = TRUE;
