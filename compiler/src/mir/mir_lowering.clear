FN mIRLowering__collect_stdlib_consumed_roots(self: MIRLowering, stmt: ?Locatable) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE names: []String = ( { MUTABLE rtoc_empty_list_86: []String = List[]; rtoc_empty_list_86 } );
    mIRLowering__walk_ast_calls(rtoc_self_view, stmt, %(call: Locatable) USE(MUTABLE names, rtoc_self_view) -> {
    FOR _ IN mIRLowering__stdlib_call_ownership_facts(rtoc_self_view, call).consumed_names DO
    &names.append(COPY _);
    END
    rubyToClearVoid()
    });
    RETURN dedupeStrings(names);
}
