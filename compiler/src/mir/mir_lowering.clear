  IF value EXISTS AS optional_payload THEN
    RETURN X{ FunctionSignatureMultiowned: COPY optional_payload };
  END
  NIL;
END
FN ruby_wrap_optional_Set_Emittable(value: ?Set) RETURNS ?Emittable ->
  IF value EXISTS AS optional_payload THEN
    RETURN Emittable{ Set: COPY optional_payload };
  END
  NIL;
END
FN ruby_wrap_optional_Type_TypeTypeInput(value: ?Type) RETURNS ?TypeTypeInput ->
  IF value EXISTS AS optional_payload THEN
    RETURN TypeTypeInput{ Type: COPY optional_payload };
  END
  NIL;
END
FN ruby_wrap_optional_Type_multiowned_TypeTypeInput(value: ?Type@multiowned) RETURNS ?TypeTypeInput ->
  IF value EXISTS AS optional_payload THEN
    RETURN TypeTypeInput{ Type: COPY optional_payload };
  END
  NIL;
END
FN ruby_wrap_optional_string_to_symbol(value: ?String) RETURNS ?String@symbol ->
  IF value EXISTS AS value_value THEN
    RETURN symbol(value_value);
  END
  NIL;
END
