      (node.token()).column()
    ELSE
      NIL
    END) OR_ELSE 0), dispatch: :local, form: :stack };
    MUTABLE structural = FutureMapPlan{ id: COPY id, ctx_type: COPY names.ctx_type, ctx_var: COPY names.ctx_var, alloc_var: COPY names.alloc_var, promise_var: COPY names.promise_var, blk_label: COPY names.blk_label, raw_rt: COPY names.bg_rt, rt_name: COPY mIRLowering__runtime_binding_name(rtoc_self_view), source: COPY source, source_field: "source", source_shared: (operation.handle_use == TenseHandleUse.SharedRead), run_body: COPY run_body, promise_zig: COPY promise_zig, spawn_call: COPY spawn, profile_site: COPY profile, result_type: COPY future_type };
    MUTABLE bg = MIRBgBlock{ code: BgBlockPlan{ FutureMapPlan: COPY structural }, captures: {}, run_body: COPY run_body, fsm_structure: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, boundary_fact: NIL, result_type: NIL };
    bg.result_type = future_type;
    bg.boundary_fact = mIRLowering__execution_boundary_fact(rtoc_self_view, :bg, :local, NIL);
    IF tenseOperationPlan__consumes_handle?(operation) THEN
    IF source IS_A Ident AS ident THEN
      MUTABLE ident_mutable = COPY ident;
      TRY (mIRLowering__with_ownership_consumption(rtoc_self_view, Emittable{ MIRBgBlock: COPY bg }, [ident_mutable.name], "tense future-map capture", :capture, :heap));
    END
    END
    RETURN bg;
}
END
PRIVATE FN mIRLowering__tense_map_cleanup_entry(self: MIRLowering, type_info: Type, lifecycle: LifecyclePlan) RETURNS !CleanupEntry@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE entry_branch_value: ?CleanupEntry = NIL;
    IF (lifecycle.drop_strategy == :resource_close) THEN
      entry_branch_value = cleanupEntry__build(:resource, :heap, FALSE, {:resource_close_plan: UNWRAP (lifecycle.resource_close_plan)});
    ELSE
      entry_branch_value = cleanupEntry__build(:uniform, :heap, FALSE, NIL, TRY (type__zig_type(type_info)));
    END
    MUTABLE entry: CleanupEntry = entry_branch_value?;
    RETURN cleanupEntry__set_lifecycle_plan_mut(&entry, lifecycle);
}
END
PRIVATE FN mIRLowering__tense_map_bindings(self: MIRLowering, id: Int64, segment: String, count_value: Int64) RETURNS ![]String
