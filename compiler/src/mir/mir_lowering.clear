          MUTABLE value_prefix, normalized_value = mIRLowering__hoist_normalized_value_expr(rtoc_self_view, placed);
          mIRLowering__function_state(rtoc_self_view).pending_stmts = ruby_array_concat_Stmt(mIRLowering__function_state(rtoc_self_view).pending_stmts, CAST(value_prefix AS []Stmt));
