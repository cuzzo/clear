    MUTABLE captures: []Any = List[];
    IF node.captures != NIL THEN
      captures = COPY ((node.captures)?) |> SELECT (  IF respondsTo?(_, "name") THEN
      CAST(_.name() AS String)
    ELSE
      CAST(_ AS String)
    END);
    END
    RETURN LambdaExpr{ fn_def: fn_def, captures: captures, lowered_node_id: NIL, ownership_consumption: NIL };
}
END
