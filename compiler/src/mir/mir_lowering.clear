PRIVATE FN mIRLowering__lower_bg_block(MUTABLE self: MIRLowering, MUTABLE node: BgBlock) RETURNS !MIRBgBlock
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_504 = mIRLowering__lowering_counters(rtoc_self_view);
    mIRLoweringCounters__next_background_block_id(&rtoc_mutable_receiver_504) };
    MUTABLE names = mIRLowering__bg_lowering_names(rtoc_self_view, id);
    MUTABLE types = mIRLowering__bg_type_plan(rtoc_self_view, &node);
    MUTABLE analysis = node.capture_analysis;
    MUTABLE captured: {String}Type = {};
    IF analysis THEN
      captured = analysis.captures();
    ELSE
      captured = {};
    END
    MUTABLE capture_close_plans: {String}ResourceClosePlan = {};
    IF analysis THEN
      capture_close_plans = analysis.close_plans();
    ELSE
      capture_close_plans = {};
    END
    MUTABLE pointer_captures: [Set]String = Set[];
    IF analysis THEN
      pointer_captures = analysis.pointer_captures();
    ELSE
      pointer_captures = Set[];
    END
    MUTABLE rt_name = mIRLowering__runtime_binding_name(rtoc_self_view);
    mIRLowering__enforce_bg_capture_strategies_mut(rtoc_self_view, Node{ BgBlock: COPY node }, captured);
    MUTABLE capture = mIRLowering__bg_capture_materialization(rtoc_self_view, names, analysis, captured, capture_close_plans, pointer_captures);
    MUTABLE body = mIRLowering__bg_body_materialization(&rtoc_self_view, node, capture.caps, analysis, pointer_captures, names.bg_rt, id, types.is_void, types.inner_type, capture_close_plans);
    MUTABLE scheduler = mIRLowering__bg_scheduler_plan(rtoc_self_view, node, names, rt_name);
    IF mIRLowering__bg_uses_fsm_transform?(rtoc_self_view, node) THEN
      MUTABLE ctx = BgFsmTransformContext{ node: COPY node, names: COPY names, types: COPY types, capture: COPY capture, body: COPY body, scheduler: COPY scheduler, captured: COPY captured, capture_close_plans: COPY capture_close_plans, pointer_captures: COPY pointer_captures, rt_name: COPY rt_name };
      MUTABLE transform_result: ?FsmLoweringResult = TRY (fsmTransform__transform(BgBlockInput{ BgBlock: COPY node }, TRY (bgFsmTransformContext__to_transform_hash(ctx)), rtoc_self_view));
      IF transform_result EXISTS AS transform_result_value THEN
        RETURN mIRLowering__fsm_bg_block_from_transform_mut(rtoc_self_view, &node, transform_result_value, captured, analysis);
      END
    END
    RETURN mIRLowering__emit_stackful_bg_block(rtoc_self_view, &node, names, types, capture, body, scheduler, rt_name, captured, analysis);
}
END
