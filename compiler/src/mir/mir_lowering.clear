PRIVATE FN mIRLowering__lower_inline_union_helper_struct(self: MIRLowering, fact: UnionVariantLoweringFact) RETURNS !?MIRStructDef
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(fact.inline_struct) THEN
