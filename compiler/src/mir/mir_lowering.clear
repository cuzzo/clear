      RETURN value_payload;
    END
    MUTABLE error_union = IF respondsTo?(node.left, "error_union_type") THEN
      node.left.error_union_type()
    ELSE
      NIL
    END;
    IF error_union THEN
      MUTABLE eu_type = TRY (type__new(error_union));
      MUTABLE eu_payload = TRY (type__value_payload_type(eu_type));
      IF !(type__any?(eu_payload)) THEN
        RETURN eu_payload;
      END
    END
    IF mIRLowering__function_state(rtoc_self_view).current_expected_type != NIL THEN
    RETURN COPY (mIRLowering__function_state(rtoc_self_view).current_expected_type)?;
    ELSE
    RETURN &node.full_type_mut("OR_ELSE fallback expected type");
    END
}
END
PRIVATE FN mIRLowering__materialize_or_fallback_value(self: MIRLowering, value: Emittable, MUTABLE ast_node: Locatable) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF mIRLowering__mir_allocates?(rtoc_self_view, value) THEN
      RETURN mIRLowering__hoist_alloc(rtoc_self_view, value, ast_node, FALSE);
    END
    IF TRY (mIRLowering__unit_union_variant_constructor?(rtoc_self_view, ast_node)) THEN
      RETURN COPY value;
    END
    IF !(mIRLowering__or_fallback_access_path?(rtoc_self_view, ast_node)) THEN
      RETURN COPY value;
    END
    IF !(TRUE) THEN
      RETURN COPY value;
    END
    MUTABLE ti = &ast_node.full_type_mut("OR_ELSE fallback materialization");
    IF !(((TRY (type__string?(ti)) OR TRY (type__recursive_cleanup_shape?(ti, mIRLowering__mir_schema_lookup(rtoc_self_view)))) OR ti.needs_cleanup?(mIRLowering__mir_schema_lookup(rtoc_self_view)))) THEN
      RETURN COPY value;
    END
    MUTABLE alloc = (mIRLowering__function_state(rtoc_self_view).current_decl_alloc OR_ELSE :heap);
    MUTABLE copied = (TRY (mIRLowering__retain_handle_for_destination(rtoc_self_view, value, ti)) OR_ELSE Emittable{ DeepCopy: COPY DeepCopy{ source: COPY value, zig_type: COPY TRY (type__zig_type(ti)), elem_type: NIL, strategy: :full_value, alloc: COPY alloc, copy_shape: NIL, type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL } });
    RETURN mIRLowering__hoist_alloc(rtoc_self_view, copied, ast_node, FALSE);
}
END
PRIVATE FN mIRLowering__or_fallback_access_path?(self: MIRLowering, ast_node: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (ast_node IS_A GetField OR ast_node IS_A GetIndex);
}
END
PRIVATE FN mIRLowering__or_else_facts(self: MIRLowering, node: BinaryOp) RETURNS !OrElseFacts
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE plan: ?TenseOperationPlan = COPY CAST(node.tense_plan AS ?TenseOperationPlan);
    IF !((IF plan != NIL THEN
      tenseOperationPlan__recovery_operation?(plan)
    ELSE
      NIL
    END)) THEN
      panic("OR_ELSE lowering requires its annotation-produced TenseOperationPlan at line {}");
    END
    MUTABLE left_is_error = (plan.backend_form == TenseBackendForm.ZigCatch);
    MUTABLE left_success_optional = (left_is_error AND type__optional?((TRY (type__success_type(plan.input_type)))));
    RETURN OrElseFacts{ left_is_error: left_is_error, left_success_optional: left_success_optional, line: (node.token?.line OR_ELSE 0), target: COPY mIRLowering__lowering_target(rtoc_self_view) };
}
END
PRIVATE FN mIRLowering__or_else_pass_fallback(self: MIRLowering, node: Locatable) RETURNS !DefaultValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE ti = TRY (type__from_node_mut(node, "OR_ELSE fallback"));
    ti = TRY (type__success_type(ti));
    IF TRY (type__string?(ti)) THEN
      RETURN DefaultValue{ kind: :string_empty, zig_type: NIL };
    END
    IF type__list_collection?(ti) THEN
      RETURN DefaultValue{ kind: :collection_empty, zig_type: COPY TRY (type__zig_type(ti)) };
    END
    RETURN DefaultValue{ kind: :undefined, zig_type: NIL };
}
END
PRIVATE FN mIRLowering__lower_get_field(MUTABLE self: MIRLowering, MUTABLE node: GetField) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE shared: Bool = FALSE;
    MUTABLE zig_type: String = "";
    MUTABLE constructor: ?StructInit = mIRLowering__unit_variant_constructor(rtoc_self_view, node);
    IF constructor EXISTS AS constructor_value THEN
      RETURN Emittable{ StructInit: COPY constructor_value };
    END
    IF node.target IS_A TenseNavigation THEN
      RETURN mIRLowering__lower_tense_navigation_field(&rtoc_self_view, node, castLocatableToTenseNavigation(node.target));
    END
    MUTABLE target_node = COPY node.target;
    MUTABLE implicit_safe_nav = (respondsTo?(target_node, "safe_nav_chain") AND (target_node.safe_nav_chain() == TRUE));
    MUTABLE explicit_safe_nav = (target_node IS_A OptionalUnwrap AND target_node.safe_navigation?());
    IF (explicit_safe_nav OR implicit_safe_nav) THEN
      MUTABLE inner_ast_branch_value: ?Locatable = NIL;
      IF explicit_safe_nav THEN
        inner_ast_branch_value = target_node.target();
      ELSE
        inner_ast_branch_value = target_node;
      END
      MUTABLE inner_ast: Locatable = inner_ast_branch_value?;
      MUTABLE inner_mir: Emittable = CAST(TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(inner_ast))) AS Emittable);
      MUTABLE inner_type = TRY (type__from_node_mut(inner_ast, "optional @node field target"));
      IF TRY (type__node_reference?(inner_type)) THEN
        MUTABLE payload = UNWRAP (TRY (type__node_payload_type(inner_type)));
        zig_type = mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ StringValue: COPY type__resolved(payload) });
        shared = type__shared_node?(inner_type);
        IF !(shared) THEN
          mIRLowering__function_state(rtoc_self_view).node_store_types.insert(zig_type);
        END
        MUTABLE store = TRY (mIRLowering__node_store_type_mir(rtoc_self_view, zig_type, shared));
        inner_mir = Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Call: COPY store }, method: "getBound", args: [CAST(Ident{ name: mIRLowering__node_store_binding_name(rtoc_self_view, zig_type, shared), lowered_node_id: NIL, ownership_consumption: NIL } AS Any), CAST(inner_mir AS Any)], try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(1)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } };
      END
      MUTABLE safe_root: Emittable = Emittable{ Ident: COPY Ident{ name: "_r", lowered_node_id: NIL, ownership_consumption: NIL } };
      IF type__indirect?(inner_type) THEN
        safe_root = Emittable{ Deref: COPY Deref{ expr: COPY safe_root, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
      MUTABLE plan = mIRLowering__field_access_plan(rtoc_self_view, &node, safe_root);
      MUTABLE result_type = &node.full_type_mut("safe-navigation field result");
      IF !(type__optional?(result_type)) THEN
        result_type = TRY (type__optional_of(TypeTypeInput{ Type: COPY result_type }));
      END
      MUTABLE result = IfOptional{ optional: COPY inner_mir, capture: "_r", then_expr: COPY fieldAccessPlan__value(plan), else_expr: COPY TRY (mIRLowering__optional_nil_mir(rtoc_self_view, result_type)), lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
      result.result_type = result_type;
      RETURN Emittable{ IfOptional: COPY result };
    END
    MUTABLE target = TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(node.target)));
    MUTABLE target_type = TRY (type__from_node_mut(node.target, "@node field target"));
    IF TRY (type__node_reference?(target_type)) THEN
      MUTABLE payload = UNWRAP (TRY (type__node_payload_type(target_type)));
      zig_type = mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ StringValue: COPY type__resolved(payload) });
      shared = type__shared_node?(target_type);
      IF !(shared) THEN
        mIRLowering__function_state(rtoc_self_view).node_store_types.insert(zig_type);
      END
      MUTABLE store = TRY (mIRLowering__node_store_type_mir(rtoc_self_view, zig_type, shared));
      MUTABLE resolved = MIRMethodCall{ receiver: Emittable{ Call: COPY store }, method: "getBound", args: [CAST(Ident{ name: mIRLowering__node_store_binding_name(rtoc_self_view, zig_type, shared), lowered_node_id: NIL, ownership_consumption: NIL } AS Any), CAST(CAST(target AS Emittable) AS Any)], try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(1)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
      target = MIROptionalUnwrap{ expr: Emittable{ MIRMethodCall: COPY resolved }, lowered_node_id: NIL, ownership_consumption: NIL };
    END
    RETURN fieldAccessPlan__value((mIRLowering__field_access_plan(rtoc_self_view, &node, CAST(target AS Emittable))));
}
END
PRIVATE FN mIRLowering__lower_tense_navigation_field(MUTABLE self: MIRLowering, MUTABLE node: GetField, navigation: TenseNavigation) RETURNS Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN mIRLowering__lower_tense_navigation(&rtoc_self_view, Locatable{ GetField: COPY node }, navigation, %(receiver: String) USE(MUTABLE node, rtoc_self_view) -> fieldAccessPlan__value(mIRLowering__field_access_plan(rtoc_self_view, &node, Emittable{ Ident: COPY Ident{ name: COPY receiver, lowered_node_id: NIL, ownership_consumption: NIL } })));
}
END
PRIVATE FN mIRLowering__lower_tense_navigation(MUTABLE self: MIRLowering, node: Locatable, navigation: TenseNavigation, mapper: FN(String) -> Emittable) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE plan: ?TenseOperationPlan = CAST(node.tense_plan() AS ?TenseOperationPlan);
    IF !((plan?.operation == TenseOperationKind.Navigate)) THEN
      panic("tense navigation lowering requires its annotation-produced TenseOperationPlan");
    END
    MUTABLE plan_value: TenseOperationPlan = plan?;
    MUTABLE source: Emittable = CAST(TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(navigation.target))) AS Emittable);
    MUTABLE future_map = tenseOperationPlan__owns_result?(plan_value);
    MUTABLE source_prefix, normalized_source = mIRLowering__normalize_allocating_used_expr(rtoc_self_view, source, (future_map AND tenseOperationPlan__consumes_handle?(plan_value)));
    mIRLowering__function_state(rtoc_self_view).pending_stmts = ruby_array_concat_Stmt(mIRLowering__function_state(rtoc_self_view).pending_stmts, CAST(source_prefix AS []Stmt));
    source = COPY normalized_source;
    MUTABLE split = tenseEnvelope__split_future((TRY (tenseEnvelope__from_type(plan_value.input_type))));
    MUTABLE id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_560 = mIRLowering__lowering_counters(rtoc_self_view);
    mIRLoweringCounters__next_background_block_id(&rtoc_mutable_receiver_560) };
    MUTABLE raw_id = id.value;
    MUTABLE outer_bindings = mIRLowering__tense_map_bindings(rtoc_self_view, raw_id, "outer", split.outer.length());
    MUTABLE source_for_future_branch_value: ?Ident = NIL;
    IF (outer_bindings.length() == 0) THEN
      source_for_future_branch_value = castEmittableToIdent(source);
    ELSE
      source_for_future_branch_value = Ident{ name: COPY UNWRAP (outer_bindings.last()), lowered_node_id: NIL, ownership_consumption: NIL };
    END
    MUTABLE source_for_future: Ident = source_for_future_branch_value?;
    MUTABLE mapped_branch_value: ?MIRBgBlock = NIL;
    IF tenseOperationPlan__owns_result?(plan_value) THEN
      mapped_branch_value = mIRLowering__lower_future_tense_map(rtoc_self_view, node, plan_value, Emittable{ Ident: COPY source_for_future }, split.inner, raw_id, mapper);
    ELSE
      MUTABLE bindings = mIRLowering__tense_map_bindings(rtoc_self_view, raw_id, "direct", plan_value.navigation_layers.length());
      MUTABLE value = mapper(UNWRAP (bindings.last()));
      RETURN Emittable{ DirectTenseMap: COPY mIRLowering__direct_tense_map(rtoc_self_view, source, value, plan_value.navigation_layers, bindings, raw_id, plan_value.result_type) };
    END
    MUTABLE mapped: MIRBgBlock = mapped_branch_value?;
    IF (split.outer.length() == 0) THEN
      RETURN Emittable{ MIRBgBlock: COPY mapped };
    END
    MUTABLE outer = mIRLowering__direct_tense_map(rtoc_self_view, source, Emittable{ MIRBgBlock: COPY mapped }, split.outer, outer_bindings, raw_id, plan_value.result_type);
    IF tenseOperationPlan__consumes_handle?(plan_value) THEN
    IF source IS_A Ident AS ident THEN
      MUTABLE ident_mutable = COPY ident;
      TRY (mIRLowering__with_ownership_consumption(rtoc_self_view, Emittable{ DirectTenseMap: COPY outer }, [ident_mutable.name], "tense navigation future capture", :capture, :heap));
    END
    END
    RETURN Emittable{ DirectTenseMap: COPY outer };
}
END
PRIVATE FN mIRLowering__lower_future_tense_map(self: MIRLowering, node: Locatable, operation: TenseOperationPlan, source: Emittable, inner_layers: []TenseLayer, id: Int64, mapper: FN(String) -> Emittable) RETURNS !MIRBgBlock
