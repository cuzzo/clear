    END
}
END
PRIVATE FN mIRLowering__lower_destructure_target(self: MIRLowering, MUTABLE target: DestructureTarget) RETURNS !MIRDestructureTarget
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (CAST(target.name AS String) == "_") THEN
      RETURN MIRDestructureTarget{ name: "_", declaration_kind: NIL, annotation: NIL, lowered_node_id: NIL, ownership_consumption: NIL };
    END
    MUTABLE symbol: ?SymbolEntry = COPY target.symbol;
    MUTABLE declared = symbol?.reg.equal?(target);
    MUTABLE safe_name = mIRLowering__zig_safe_name(rtoc_self_view, target.name);
    IF declared THEN
      MUTABLE rtoc_index_receiver_684 = TRY (functionState__decl_zig_names(mIRLowering__function_state(rtoc_self_view)));
      rtoc_index_receiver_684[target.object_id()] = safe_name;
      IF symbol?.reg EXISTS AS reg_value THEN
        MUTABLE rtoc_index_receiver_685 = TRY (functionState__decl_zig_names(mIRLowering__function_state(rtoc_self_view)));
        rtoc_index_receiver_685[symbol.reg.object_id()] = safe_name;
      END
    END
    MUTABLE declaration_kind: ?String@symbol = IF declared THEN
      mIRLowering__destructure_declaration_kind(rtoc_self_view, target)
    ELSE
      NIL
    END;
    MUTABLE annotation_branch_value: ?Type = NIL;
    IF (declared AND target.type) THEN
      annotation_branch_value = TRY (type__new(TypeConstructionInput{ StringValue: COPY mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ Type: COPY TRY (aST__full_type_mut(target)) }) }));
    ELSE
      annotation_branch_value = NIL;
    END
    MUTABLE annotation: ?Type = annotation_branch_value;
    RETURN MIRDestructureTarget{ name: safe_name, declaration_kind: declaration_kind, annotation: annotation, lowered_node_id: NIL, ownership_consumption: NIL };
}
END
PRIVATE FN mIRLowering__destructure_declaration_kind(self: MIRLowering, target: DestructureTarget) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(target.mutable) THEN
      RETURN :const;
    END
    MUTABLE ft = TRY (type__from_node_mut(target, "destructure target declaration"));
    MUTABLE forced_var = ((((((((type__collection?(ft) OR TRY (type__dynamic_stream?(ft))) OR TRY (type__bounded_stream?(ft))) OR type__shared_promise?(ft)) OR TRY (type__open_stream?(ft))) OR TRY (type__inf_stream?(ft))) OR ((type__array?(ft) AND type__dynamic?(ft)))) OR type__any_sync?(ft)) OR type__resource?(ft));
    IF ((target.var_mutated == TRUE) OR forced_var) THEN
      RETURN :var;
    ELSE
