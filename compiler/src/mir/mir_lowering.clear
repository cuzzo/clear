FN mIRLowering__ownership_facts_for_mir_surface(MUTABLE self: MIRLowering, node: Emittable) RETURNS ![]MIRLoweringOwnershipFact ->
    MUTABLE facts: []MIRLoweringOwnershipFact = List[];
    TRY (mIR__each_surface_node(NodeRoot{ Emittable: COPY node }, %(MUTABLE surface_node: Emittable) USE(MUTABLE facts, MUTABLE self) -> {
