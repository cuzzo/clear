PRIVATE FN mIRLowering__with_capability_binding_context(MUTABLE self: MIRLowering, node: WithBlock, cap: CapabilityTransition, clause: ?ErrorClause, with_label: ?String, needs_sort: Bool, rt_name: String) RETURNS !WithCapabilityBindingContext ->
