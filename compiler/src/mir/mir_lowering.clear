PRIVATE FN mIRLowering__mutable_struct_list_bind?(self: MIRLowering, expr: Locatable) RETURNS !Bool ->
    IF expr IS_A GetIndex AS get_index THEN
      MUTABLE get_index_mutable = COPY get_index;
      MUTABLE receiver = TRY (aST__full_type_mut(get_index_mutable.target));
      MUTABLE result = TRY (aST__full_type_mut( Locatable{ GetIndex: COPY get_index_mutable }));
      MUTABLE inner_branch_value: ?Type = NIL;
      IF type__optional?(result) THEN
        inner_branch_value = UNWRAP (TRY (type__wrapped_type(result)));
      ELSE
        inner_branch_value = result;
      END
      MUTABLE inner: Type = inner_branch_value?;
      RETURN (((((((type__list_collection?(receiver) AND TRY (type__struct?(inner))) AND !(type__collection?(inner))) AND !(TRY (type__node_reference?(inner)))) AND !(type__link?(inner))) AND !(TRY (type__any_rc?(inner))))) == TRUE);
    ELSE
      RETURN FALSE;
    END
END
PRIVATE FN mIRLowering__plain_map_pointer_bind?(MUTABLE self: MIRLowering, expr: Locatable) RETURNS !Bool ->
    IF expr IS_A GetIndex AS get_index THEN
      MUTABLE get_index_mutable = COPY get_index;
      MUTABLE receiver = TRY (aST__full_type_mut(get_index_mutable.target));
      IF !((((type__map?(receiver) AND !(type__sharded?(receiver))) AND !(TRY (type__any_rc?(receiver)))) AND !(type__any_sync?(receiver)))) THEN
        RETURN FALSE;
      END
      MUTABLE result = TRY (aST__full_type_mut( Locatable{ GetIndex: COPY get_index_mutable }));
      MUTABLE inner_branch_value: ?Type = NIL;
      IF type__optional?(result) THEN
        inner_branch_value = UNWRAP (TRY (type__wrapped_type(result)));
      ELSE
        inner_branch_value = result;
      END
      MUTABLE inner: Type = inner_branch_value?;
      MUTABLE union_name = IF type__generic_instance?(inner) THEN
        type__generic_base(inner)
      ELSE
        type__resolved(inner)
      END;
      IF (TRY (mIRLowering__union_schemas(&self))).contains?(union_name) THEN
        RETURN TRUE;
      END
      IF ((type__collection?(inner) AND !(TRY (type__node_reference?(inner)))) AND !(TRY (type__any_rc?(inner)))) THEN
        RETURN TRUE;
      END
      RETURN ((((((TRY (type__struct?(inner)) AND !(type__collection?(inner))) AND !(TRY (type__node_reference?(inner)))) AND !(type__link?(inner))) AND !(TRY (type__any_rc?(inner))))) == TRUE);
    ELSE
      RETURN FALSE;
    END
