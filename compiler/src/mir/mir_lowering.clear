FN mIRLowering__append_transfer_marks_mut(MUTABLE self: MIRLowering, marks: []Emittable, MUTABLE state: OwnershipFinalizationContext) RETURNS !Void
  EFFECTS REENTRANT ->
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < marks.length() DO
      IF (marks[rtoc_idx]? IS_A MoveMark AND state.move_mark_names.contains?(CAST((emittable__name(UNWRAP (marks[rtoc_idx]))) AS String))) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF (marks[rtoc_idx]? IS_A TransferMark AND state.transfer_mark_names.contains?(CAST((emittable__name(UNWRAP (marks[rtoc_idx]))) AS String))) THEN
