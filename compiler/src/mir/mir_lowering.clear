    MUTABLE variant_facts = TRY (mIRLowering__union_variant_lowering_facts(self, node));
    MUTABLE helper_structs = variant_facts |> SELECT:? TRY (mIRLowering__lower_inline_union_helper_struct(&self, _)) |> WHERE _ != NIL;
    MUTABLE variants = variant_facts |> SELECT UnionTypeVariant{ name: symbol(COPY _.name), zig_type: COPY _.zig_type };
    IF node.type_params.any?() THEN
      MUTABLE comptime_params = node.type_params |> SELECT "comptime ${_}: type";
      MUTABLE lifecycle_methods = TRY (mIRLowering__lower_union_lifecycle_methods(&self, node, variant_facts));
      MUTABLE inner_union = UnionTypeDef{ name: NIL, variants: variants, visibility: NIL, methods: { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_137: ?[]Emittable = NIL;
      IF (lifecycle_methods.length() == 0) THEN
        rtoc_ternary_value_137 = NIL;
      ELSE
        rtoc_ternary_value_137 = CAST(COPY lifecycle_methods AS ?[]Emittable);
      END
      rtoc_ternary_value_137? }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
      MUTABLE body = [Emittable{ ReturnStmt: COPY ReturnStmt{ value: Emittable{ UnionTypeDef: COPY inner_union }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }];
      MUTABLE generic_fn = FnDef{ name: node.name, params: List[], ret_type: "type", body: COPY body, visibility: NIL, can_fail: FALSE, comptime_params: comptime_params, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
      IF (helper_structs.length() > 0) THEN
        MUTABLE lowered_items: []Emittable = List[];
        FOR helper IN helper_structs DO
          IF helper EXISTS AS helper_value THEN
            &lowered_items.append(Emittable{ MIRStructDef: COPY helper_value });
          END
        END
        &lowered_items.append(Emittable{ FnDef: COPY generic_fn });
        RETURN MIRLoweringLoweredMir{ ArrayValue: COPY lowered_items };
      ELSE
        RETURN MIRLoweringLoweredMir{ Emittable: Emittable{ FnDef: COPY generic_fn } };
      END
    ELSE
      lifecycle_methods = TRY (mIRLowering__lower_union_lifecycle_methods(&self, node, variant_facts));
      MUTABLE union_node = UnionTypeDef{ name: node.name, variants: variants, visibility: node.visibility, methods: { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_139: ?[]Emittable = NIL;
      IF (lifecycle_methods.length() == 0) THEN
        rtoc_ternary_value_139 = NIL;
