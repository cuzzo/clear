        { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_681 = ((TRY (functionState__bindings(mIRLowering__function_state(rtoc_self_view))))[_.name]);
      cleanupEntry__needs_cleanup?(rtoc_local_receiver_681) }
      ELSE
        NIL
      END) END) END) END);
