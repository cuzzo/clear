    # concatenating its prefix onto pending_stmts as it goes.
    MUTABLE hoisted_args: []Emittable = List[];
    FOR arg_mir IN args_mir DO
      IF ((((arg_mir IS_A Ident OR arg_mir IS_A Lit) OR arg_mir IS_A AllocatorRef) OR arg_mir IS_A MIRUnaryOp)) THEN
        &hoisted_args.append(COPY arg_mir);
      ELSE
        MUTABLE stmts, ident = mIRLowering__hoist_normalized_value_expr(&self, arg_mir);
        FOR hoist_stmt IN stmts DO
          &self.state.function_state.pending_stmts.append(COPY hoist_stmt);
        END
        &hoisted_args.append(Emittable{ Ident: COPY ident });
      END
    END
    args_mir = hoisted_args;
    FOR concat_stmt IN TRY (mIR__kept_edge_transfer_boundary((frame.temps + frame.moved_sources))) DO
      &self.state.function_state.pending_stmts.append(COPY concat_stmt);
    END
