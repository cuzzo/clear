    MUTABLE zig_base = TRY (mIRLowering__transpile_type(self, MIRLoweringType{ StringValue: COPY base_type }));
    MUTABLE alloc = :heap;
    MUTABLE is_atomic_ptr = capabilityWrap__atomic_ptr?(node);
    MUTABLE sync_fn: ?String = mIRLowering__sync_wrap_constructor(self, node.sync, is_atomic_ptr);
    MUTABLE sync_type: ?String = mIRLowering__sync_wrap_type(self, node.sync, zig_base, is_atomic_ptr);
