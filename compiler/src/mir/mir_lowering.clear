        CaptureCleanupAction{ target: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__ctx_${names.id.toString()}", lowered_node_id: NIL, ownership_consumption: NIL } }, field: COPY _._0, lowered_node_id: NIL, ownership_consumption: NIL } }, cleanup_entry: cleanupEntry__build(:resource, :heap, FALSE, {:resource_close_plan: close_plan}), allocator: NIL }
      ELSE
