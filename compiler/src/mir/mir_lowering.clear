    IF root EXISTS AS root_value THEN
      IF root_value.symbol EXISTS AS root_symbol THEN
        borrowed = symbolEntry__borrow_provenance?(root_symbol);
      END
    END
    borrowed = (borrowed OR aST__container_borrow?(ast_node));
    IF !(borrowed) THEN
      RETURN FALSE;
    END
    IF !((TRY (mIRLowering__union_schemas(&self))).contains?(type__resolved(ti))) THEN
      RETURN FALSE;
    END
    IF (TRUE AND TRY (type__implicitly_copyable?(ti, mIRLowering__mir_schema_lookup(&self)))) THEN
      RETURN FALSE;
    END
    RETURN TRUE;
END
PRIVATE FN mIRLowering__rc_retain_needed?(MUTABLE self: MIRLowering, value_node: Locatable) RETURNS !Bool ->
    IF value_node IS_A Identifier AS identifier THEN
      MUTABLE ti = TRY (type__from_node_mut(Locatable{ Identifier: COPY identifier }, "rc retain"));
      MUTABLE declared: ?Type@multiowned = NIL;
      IF identifier.symbol != NIL THEN
        declared = COPY symbolEntry__type(((identifier.symbol)?));
      END
      IF ((((declared != NIL) AND !(TRY (type__any_rc?(declared)))) AND TRY (type__any_rc?(ti))) AND ((identifier.symbol == NIL) OR ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_187 = ((identifier.symbol)?);
      symbolEntry__rc_stored?(rtoc_local_receiver_187) } != TRUE))) THEN
        RETURN FALSE;
      END
      IF !(TRY (type__any_rc?(ti))) THEN
        RETURN FALSE;
      END
      IF type__atomic_ptr?( ti) THEN
        RETURN FALSE;
      END
      MUTABLE rc_map = (mIRLowering__capability_state(&self).rc_unwrap_map OR_ELSE {});
      IF rc_map.contains?(identifier__name(identifier)) THEN
        RETURN FALSE;
      END
      RETURN TRUE;
    ELSE
      RETURN FALSE;
    END
END
PRIVATE FN mIRLowering__make_rc_retain(MUTABLE self: MIRLowering, value_node: Identifier) RETURNS !RcRetain ->
    MUTABLE ti: ?Type = TRY (type__from_node_mut(Locatable{ Identifier: COPY value_node }, "rc retain emit"));
    MUTABLE func: String = "";
    IF type__shared?( UNWRAP (ti)) THEN
      func = "arcRetain";
    ELSE
      func = "rcRetain";
    END
    MUTABLE zig_base = TRY (mIRLowering__rc_payload_zig_type(self, UNWRAP (ti)));
    RETURN RcRetain{ source: UNWRAP (COPY TRY (mIRLowering__lower(&self, MIRLoweringLowerableStmt{ Identifier: COPY value_node }))), zig_base: COPY zig_base, func: COPY func, lowered_node_id: NIL, ownership_consumption: NIL };
END
PRIVATE FN mIRLowering__pipeline_host(MUTABLE self: MIRLowering) RETURNS !PipelineHost@multiowned
  EFFECTS REENTRANT ->
    MUTABLE cached: ?PipelineHost@multiowned = COPY KEEP mIRLowering__program_state(self).pipeline_host;
    IF cached EXISTS AS cached_value THEN
      RETURN KEEP cached_value;
    END
    self.state.program.pipeline_host = TRY (pipelineHost__new(self, { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_188 = mIRLowering__runtime_state(&self);
    mIRLoweringRuntimeState__emitter_mut(&rtoc_mutable_receiver_188) }));
    RETURN KEEP UNWRAP (KEEP mIRLowering__program_state(self).pipeline_host);
END
PRIVATE FN mIRLowering__transpile_type(self: MIRLowering, type: MIRLoweringType, is_param: Bool = FALSE, is_field: Bool = FALSE) RETURNS !String ->
    MUTABLE t: Type = TRY (type__new(castMIRLoweringTypeToTypeConstructionInput(type)));
    IF type IS_A Type AS type_struct THEN
      t = COPY type_struct;
    END
    RETURN TRY (type__zig_type(t, is_param, is_field));
END
PRIVATE FN mIRLowering__fsm_fn_name_rename_map(MUTABLE self: MIRLowering) RETURNS !{String}String ->
    RETURN COPY mIRLowering__function_state(&self).fn_name_rename_map;
END
PRIVATE FN mIRLowering__fsm_current_bindings(MUTABLE self: MIRLowering) RETURNS !{String}CleanupEntry@multiowned ->
    RETURN COPY mIRLowering__function_state(&self).current_bindings;
END
PRIVATE FN mIRLowering__fsm_guarded_cleanup_names(MUTABLE self: MIRLowering) RETURNS !{String}Bool ->
    RETURN COPY mIRLowering__function_state(&self).guarded_cleanup_names;
END
PRIVATE FN mIRLowering__fsm_zig_safe_name(self: MIRLowering, name: String) RETURNS String ->
    RETURN mIRLowering__zig_safe_name(self, name);
END
PRIVATE FN mIRLowering__lower_step_stmts(MUTABLE self: MIRLowering, stmts: []Locatable, no_result: Bool, ctx_id: ?Int64 = NIL, async_result_shape: ?AsyncResultShape = NIL) RETURNS ![]Emittable ->
    MUTABLE flat_steps: []ThenStep = List[];
    FOR _ IN stmts DO
    IF _ IS_A ThenChain AS then_chain THEN
      FOR _ IN then_chain.steps DO
      &flat_steps.append(COPY _);
      END
    ELSE
      &flat_steps.append(ThenStep{ expr: COPY _, binding: NIL });
    END
    END
    IF no_result THEN
      MUTABLE out: []Emittable = List[];
      FOR _ IN flat_steps DO
    MUTABLE chunk = TRY (mIRLowering__lower_one_step_to_mir(&self, _));
    IF chunk THEN
          out = ruby_array_concat_Emittable__mir_lowering(out, chunk);
    END
      END
      RETURN out;
    ELSE
      MUTABLE last_step: ?ThenStep = &flat_steps.pop();
      MUTABLE pre_mir = List[];
      FOR _ IN flat_steps DO
    MUTABLE chunk = TRY (mIRLowering__lower_one_step_to_mir(&self, _));
    IF chunk THEN
          pre_mir = ruby_array_concat_Any__mir_lowering(pre_mir, CAST(chunk AS []Any));
    END
      END
      MUTABLE result_mir: []Emittable = List[];
      IF last_step EXISTS AS last_step_value THEN
        MUTABLE last_step_value_mutable = COPY last_step_value;
        MUTABLE expr_type = TRY (aST__full_type_mut(last_step_value_mutable.expr));
        MUTABLE retained_error:? =       IF ((TRUE AND (locatable__retain_error_channel(last_step_value_mutable.expr) == TRUE)) AND TRUE) THEN
          locatable__error_union_type(UNWRAP (locatable__expr( CAST(last_step_value_mutable AS Locatable))))
        ELSE
          NIL
        END;
        MUTABLE expr_t_branch_value: ?Type = NIL;
        IF retained_error THEN
          expr_t_branch_value = TRY (type__new( TypeConstructionInput{ Type: retained_error }));
        ELSE
          expr_t_branch_value = COPY expr_type;
        END
        MUTABLE expr_t: Type = expr_t_branch_value?;
        MUTABLE declared_result_type: Type = COPY expr_t;
        IF async_result_shape != NIL THEN
          declared_result_type = COPY async_result_shape.payload_type;
        END
        MUTABLE result_alloc: ?String@symbol = TRY (mIRLowering__escaping_value_alloc(&self, declared_result_type));
        MUTABLE last_mir = mIRLowering__with_decl_alloc(&self, result_alloc, %() USE(last_step_value_mutable, MUTABLE self) -> {
    MUTABLE rtoc_lambda_result_196: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(last_step_value_mutable.expr)));
    rtoc_lambda_result_196
        });
        MUTABLE result_destination_type_branch_value: ?Type = NIL;
        IF (TRY (type__string?(declared_result_type)) AND type__rodata?(expr_t)) THEN
          result_destination_type_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: :String }, NIL, NIL, NIL, result_alloc));
        ELSE
          result_destination_type_branch_value = declared_result_type;
        END
        MUTABLE result_destination_type: Type = result_destination_type_branch_value?;
        IF last_mir EXISTS AS MUTABLE last_mir_value THEN
          MUTABLE last_mir_value = TRY (mIRLowering__place_value_for_destination(&self, &last_mir_value, &last_step_value_mutable.expr, result_alloc, TypeTypeInput{ Type: COPY result_destination_type }));
        END
        IF ((last_mir != NIL) AND ((TRY (mIRLowering__mir_allocates?(&self, last_mir)) OR lifecyclePlan__needs_drop?((TRY (lifecycleRegistry__fetch(mIRLowering__lifecycle_registry(&self), result_destination_type))))))) THEN
          last_mir = TRY (mIRLowering__hoist_alloc(&self, &last_mir, &last_step_value_mutable.expr, TRUE, FALSE, TRUE, result_alloc));
        END
        MUTABLE last_pending = TRY (mIRLowering__flush_pending(&self));
        result_mir = ruby_array_concat_Emittable__mir_lowering(result_mir, CAST(last_pending AS []Emittable));
        MUTABLE last_is_assign = last_step_value_mutable.expr IS_A Assignment;
        MUTABLE is_step_void = (TRY (mIRLowering__ast_void_type?(self, TypeTypeInput{ Type: COPY expr_type })) AND !(type__error_union?(expr_t)));
        IF ((last_mir != NIL) AND ((last_is_assign OR is_step_void))) THEN
          MUTABLE stmt_mir: ?Emittable = TRY (mIRLowering__wrap_step_as_stmt(self, ThenStep{ expr: COPY last_step_value_mutable.expr, binding: NIL }, last_mir));
          IF stmt_mir EXISTS AS stmt_mir_value THEN
            &result_mir.append(stmt_mir_value);
          END
        ELSE_IF last_mir EXISTS THEN
          MUTABLE ctx_ident = Ident{ name: "__ctx_${UNWRAP (ctx_id).toString()}", lowered_node_id: NIL, ownership_consumption: NIL };
          MUTABLE target = FieldGet{ object: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY ctx_ident }, field: "inner", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "result", lowered_node_id: NIL, ownership_consumption: NIL };
          MUTABLE result_value = TRY (mIRLowering__coerce_fsm_result_value(self, mIRLowering__strip_try(self, last_mir), expr_t));
          result_value = mIRLowering__async_payload_storage_value(&self, result_value, (async_result_shape OR_ELSE TRY (asyncResultShape__promise(result_destination_type))));
          MUTABLE result_set = Set{ target: Emittable{ FieldGet: COPY target }, value: COPY result_value, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
          MUTABLE transfer_facts = TRY (mIRLowering__fsm_result_transfer_facts(&self, last_mir, last_step_value_mutable.expr, result_destination_type));
          self.state.capture.last_fsm_result_transfer_facts = ruby_array_concat_FsmResultTransferFact(mIRLowering__capture_state(&self).last_fsm_result_transfer_facts, transfer_facts);
          TRY (mIRLowering__guard_fsm_result_cleanup_mut(&self, result_mir, transfer_facts));
          MUTABLE transfer_names = (transfer_facts |> SELECT _.name) |> DISTINCT _ |> SELECT COPY _;
          MUTABLE result_set_emittable: Emittable = Emittable{ Set: COPY result_set };
          IF (transfer_names).any?() THEN
            result_set_emittable = TRY (mIRLowering__with_ownership_consumption(&self, Emittable{ Set: COPY result_set }, transfer_names, "fsm_result", :owned_sink, mIRLowering__uniform_fsm_result_target_alloc(self, transfer_facts)));
          END
          &result_mir.append(COPY result_set_emittable);
          result_mir = ruby_array_concat_Emittable__mir_lowering(result_mir, CAST(transfer_facts |> UNNEST TRY (fsmResultTransferFact__marks(_)) AS []Emittable));
          MUTABLE last_expr = COPY last_step_value_mutable.expr;
          IF last_expr IS_A Identifier AS identifier THEN
            MUTABLE guard_map = COPY mIRLowering__capture_state(&self).current_fsm_owned_result_guards;
            MUTABLE guard_name: ?String = COPY guard_map[identifier__name(identifier)];
            IF guard_name EXISTS AS guard_name_value THEN
              &result_mir.append(Emittable{ Set: COPY Set{ target: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY ctx_ident }, field: COPY guard_name_value, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Lit: COPY Lit{ value: "false", lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
            END
          END
        END
      END
      MUTABLE guarded_result: []Emittable = List[];
      IF last_step EXISTS AS last_step_value THEN
        guarded_result = TRY (mIRLowering__guard_shared_node_statement(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(last_step_value.expr), result_mir));
      ELSE
        guarded_result = result_mir;
      END
      RETURN (pre_mir + guarded_result);
    END
END
PRIVATE FN mIRLowering__uniform_fsm_result_target_alloc(self: MIRLowering, facts: []FsmResultTransferFact) RETURNS ?String@symbol ->
    MUTABLE allocs = (facts |> SELECT _.target_alloc) |> DISTINCT _ |> SELECT COPY _;
    IF ((allocs).length() == 1) THEN
      FOR only_alloc IN allocs DO
        RETURN COPY only_alloc;
      END
      RETURN NIL;
    ELSE
      RETURN NIL;
    END
END
PRIVATE FN mIRLowering__coerce_fsm_result_value(self: MIRLowering, value: Emittable, result_type: Type) RETURNS !Emittable ->
    IF (type__error_union?(result_type) OR type__optional?(result_type)) THEN
      RETURN COPY value;
    END
    IF !(type__integer?(result_type)) THEN
      RETURN COPY value;
    END
    IF value IS_A MIRCast AS mir_cast THEN
      RETURN COPY Emittable{ MIRCast: COPY mir_cast };
    END
    RETURN Emittable{ MIRCast: COPY MIRCast{ expr: COPY value, target_type: COPY TRY (type__zig_type(result_type)), method: :intCast, lowered_node_id: NIL, ownership_consumption: NIL } };
END
PRIVATE FN mIRLowering__guard_fsm_result_cleanup_mut(MUTABLE self: MIRLowering, body: []Emittable, facts: []FsmResultTransferFact) RETURNS !Void ->
    MUTABLE rename_map = TRY (mIRLowering__fsm_fn_name_rename_map(&self));
    MUTABLE guarded_cleanup_names = TRY (mIRLowering__fsm_guarded_cleanup_names(&self));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < facts.length() DO
      IF !(facts[rtoc_idx]?.move_guarded) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE rtoc_idx_n1 = 0;
      WHILE rtoc_idx_n1 < body.length() DO
          IF !((body[rtoc_idx_n1]? IS_A Cleanup OR body[rtoc_idx_n1]? IS_A ErrCleanup)) THEN
            rtoc_idx_n1 = rtoc_idx_n1 + 1;
        CONTINUE;
          END
          MUTABLE node_name = COPY CAST(emittable__name(UNWRAP (body[rtoc_idx_n1])) AS String);
          MUTABLE rendered_name = COPY (rename_map[node_name] OR_ELSE node_name);
          IF !(((node_name == emittable__name( CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(UNWRAP (facts[rtoc_idx]) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable) AS Emittable))) OR (rendered_name == UNWRAP (facts[rtoc_idx]).name))) THEN
              rtoc_idx_n1 = rtoc_idx_n1 + 1;
        CONTINUE;
          END
          MUTABLE rtoc_mutable_receiver_197: ?CleanupEntry@multiowned = emittable__cleanup_entry(UNWRAP (body[rtoc_idx_n1]));
          cleanupEntry__mark_moved_guard_mut( UNWRAP (rtoc_mutable_receiver_197));
          MUTABLE rtoc_key_1: String = COPY UNWRAP (facts[rtoc_idx]).name;
          guarded_cleanup_names[rtoc_key_1] = TRUE;
        rtoc_idx_n1 = rtoc_idx_n1 + 1;
      END
    rtoc_idx = rtoc_idx + 1;
    END
    NIL;
END
PRIVATE FN mIRLowering__fsm_result_transfer_marks(MUTABLE self: MIRLowering, result_mir: Emittable, ast_node: Locatable) RETURNS ![]Emittable ->
    RETURN TRY (mIRLowering__fsm_result_transfer_facts(&self, result_mir, ast_node, NIL)) |> UNNEST TRY (fsmResultTransferFact__marks(_));
END
PRIVATE FN mIRLowering__fsm_result_transfer_facts(MUTABLE self: MIRLowering, result_mir: Emittable, ast_node: Locatable, destination_type: ?Type = NIL) RETURNS ![]FsmResultTransferFact ->
    MUTABLE rename_map = TRY (mIRLowering__fsm_fn_name_rename_map(&self));
    MUTABLE bindings = TRY (mIRLowering__fsm_current_bindings(&self));
    MUTABLE guarded_cleanup_names = TRY (mIRLowering__fsm_guarded_cleanup_names(&self));
    MUTABLE facts: []FsmResultTransferFact = List[];
    MUTABLE result_owner: Emittable = COPY result_mir;
    WHILE TRUE DO
      IF result_owner IS_A TryExpr AS try_expr THEN
        MUTABLE try_expr = tryExpr__expr(try_expr);
      ELSE_IF result_owner IS_A TryOptional AS try_optional THEN
        MUTABLE try_optional = tryOptional__expr(try_optional);
      ELSE_IF result_owner IS_A MIRCast AS mir_cast THEN
        MUTABLE mir_cast = cast__expr(mir_cast);
      ELSE
        BREAK;
      END
    END
    MUTABLE result_type:? = (destination_type OR_ELSE TRY (type__from_node_mut(ast_node, "FSM result owner")));
    IF (IF result_owner IS_A Ident AS ident THEN TRY (mIRLowering__ownership_tracked_transfer_type?(&self, UNWRAP (result_type))) ELSE FALSE END) THEN
      MUTABLE owner_name = COPY CAST(emittable__name(result_owner) AS String);
      owner_name = COPY (rename_map[owner_name] OR_ELSE owner_name);
      MUTABLE mir_entry: CleanupEntry@multiowned = cleanupEntry__none();
      IF bindings[CAST(emittable__name(result_owner) AS String)] EXISTS AS direct_entry THEN
        mir_entry = KEEP direct_entry;
      ELSE_IF bindings[owner_name] EXISTS AS renamed_entry THEN
        mir_entry = KEEP renamed_entry;
      END
      IF cleanupEntry__present?(mir_entry) THEN
        cleanupEntry__mark_moved_guard_mut(&mir_entry);
        guarded_cleanup_names[owner_name] = TRUE;
      END
      MUTABLE fact_alloc: String@symbol = :heap;
      IF cleanupEntry__present?(mir_entry) THEN
        fact_alloc = cleanupEntry__alloc(mir_entry);
      END
      &facts.append(FsmResultTransferFact{ name: COPY owner_name, target_alloc: COPY fact_alloc, move_guarded: TRUE });
      RETURN facts;
    END
    MUTABLE consumed = TRY (mIRLowering__fsm_ast_result_consumed_roots(&self, castLocatableToOptionalFsmAstResultNode(ast_node)));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < consumed.length() DO
      MUTABLE consumed_name: String = COPY UNWRAP (consumed[rtoc_idx]);
      MUTABLE safe = mIRLowering__fsm_zig_safe_name(self, consumed_name);
      safe = COPY (rename_map[safe] OR_ELSE safe);
      MUTABLE binding_entry: CleanupEntry@multiowned = cleanupEntry__none();
      IF bindings[consumed_name] EXISTS AS direct_binding THEN
        binding_entry = KEEP direct_binding;
      ELSE_IF bindings[safe] EXISTS AS renamed_binding THEN
        binding_entry = KEEP renamed_binding;
      END
      IF !(cleanupEntry__present?(binding_entry)) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE guarded = (cleanupEntry__has_moved_guard?(binding_entry) OR (guarded_cleanup_names[safe] == TRUE));
      &facts.append(FsmResultTransferFact{ name: COPY safe, target_alloc: COPY cleanupEntry__alloc(binding_entry), move_guarded: guarded });
    rtoc_idx = rtoc_idx + 1;
    END
    MUTABLE rtoc_each_items_199 = (TRY (mIR__nodes(NodeRoot{ Emittable: COPY result_mir }))) |> WHERE (_ IS_A Ident);
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_199.length() DO
      MUTABLE name = COPY CAST(emittable__name(rtoc_each_items_199[rtoc_idx]) AS String);
      MUTABLE safe = COPY (rename_map[name] OR_ELSE name);
      MUTABLE entry: CleanupEntry@multiowned = cleanupEntry__none();
      IF bindings[name] EXISTS AS direct_entry THEN
        entry = KEEP direct_entry;
      ELSE_IF bindings[safe] EXISTS AS renamed_entry THEN
        entry = KEEP renamed_entry;
      END
      MUTABLE guarded = ((guarded_cleanup_names[name] == TRUE) OR (guarded_cleanup_names[safe] == TRUE));
      IF !((guarded OR cleanupEntry__present?(entry))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF facts |> ANY (_.name == safe) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      &facts.append(FsmResultTransferFact{ name: COPY safe, target_alloc: COPY IF cleanupEntry__present?(entry) THEN
          cleanupEntry__alloc(entry)
        ELSE
          :heap
        END, move_guarded: (guarded OR cleanupEntry__has_moved_guard?(entry)) });
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN facts;
END
PRIVATE FN mIRLowering__fsm_ast_result_consumed_roots(MUTABLE self: MIRLowering, node: ?FsmAstResultNode) RETURNS ![]String
  EFFECTS REENTRANT ->
    MUTABLE names: []String = List[];
    IF UNWRAP (node) IS_A MoveNode AS MUTABLE move_node THEN
      IF move_node.value IS_A Identifier THEN
        &names.append(COPY CAST(aST__node_name(move_node.value) AS String));
      ELSE
        names = ruby_array_concat_String__mir_lowering(names, mIRLowering__fsm_ast_result_consumed_roots(&self, castLocatableToOptionalFsmAstResultNode(move_node.value)));
      END
    ELSE_IF node IS_A Identifier AS identifier THEN
      MUTABLE identifier_mutable = COPY identifier;
      IF (aST__moved?(Locatable{ Identifier: COPY identifier_mutable }) OR TRY (mIRLowering__fsm_owned_transfer_identifier?(&self, identifier_mutable))) THEN
        &names.append(COPY identifier__name(identifier_mutable));
      END
    ELSE_IF node IS_A StructLit AS struct_lit THEN
      IF (struct_lit.fields.length() > 0) THEN
            FOR MUTABLE rtoc_mutable_block_param_201 IN struct_lit.fields.values() DO
          IF rtoc_mutable_block_param_201 IS_A CopyNode THEN
            CONTINUE;
          END
          IF rtoc_mutable_block_param_201 IS_A Identifier THEN
                IF TRY (mIRLowering__fsm_owned_transfer_identifier?(&self, castLocatableToIdentifier__mir_lowering(rtoc_mutable_block_param_201))) THEN
                  &names.append(COPY CAST(locatable__name(rtoc_mutable_block_param_201) AS String));
                END
          ELSE
                names = ruby_array_concat_String__mir_lowering(names, mIRLowering__fsm_ast_result_consumed_roots(&self, castLocatableToOptionalFsmAstResultNode(rtoc_mutable_block_param_201)));
          END
            END
      END
    ELSE_IF node IS_A UnionVariantLit AS union_variant_lit THEN
      IF (union_variant_lit.fields.length() > 0) THEN
            FOR MUTABLE rtoc_mutable_block_param_202 IN union_variant_lit.fields.values() DO
          IF rtoc_mutable_block_param_202 IS_A CopyNode THEN
            CONTINUE;
          END
          IF rtoc_mutable_block_param_202 IS_A Identifier THEN
                IF TRY (mIRLowering__fsm_owned_transfer_identifier?(&self, castLocatableToIdentifier__mir_lowering(rtoc_mutable_block_param_202))) THEN
                  &names.append(COPY CAST(locatable__name(rtoc_mutable_block_param_202) AS String));
                END
          ELSE
                names = ruby_array_concat_String__mir_lowering(names, mIRLowering__fsm_ast_result_consumed_roots(&self, castLocatableToOptionalFsmAstResultNode(rtoc_mutable_block_param_202)));
          END
            END
      END
    ELSE_IF node IS_A ListLit AS list_lit THEN
      IF (list_lit.items.length() > 0) THEN
            MUTABLE rtoc_idx = 0;
            WHILE rtoc_idx < list_lit.items.length() DO
            IF list_lit.items[rtoc_idx] IS_A CopyNode THEN
              rtoc_idx = rtoc_idx + 1;
          CONTINUE;
            END
            names = ruby_array_concat_String__mir_lowering(names, mIRLowering__fsm_ast_result_consumed_roots(&self, castLocatableToOptionalFsmAstResultNode(UNWRAP (list_lit.items[rtoc_idx]))));
          rtoc_idx = rtoc_idx + 1;
            END
      END
    END
    RETURN dedupeStrings(names);
END
PRIVATE FN mIRLowering__fsm_owned_transfer_identifier?(MUTABLE self: MIRLowering, node: Identifier) RETURNS !Bool ->
    MUTABLE rename_map = TRY (mIRLowering__fsm_fn_name_rename_map(&self));
    MUTABLE bindings = TRY (mIRLowering__fsm_current_bindings(&self));
    MUTABLE ti = TRY (aST__full_type_mut(Locatable{ Identifier: COPY node }));
    IF !(TRY (mIRLowering__ownership_tracked_transfer_type?(&self, ti))) THEN
      RETURN FALSE;
    END
    MUTABLE safe = mIRLowering__fsm_zig_safe_name(self, node.name);
    safe = COPY (rename_map[safe] OR_ELSE safe);
    MUTABLE entry: CleanupEntry@multiowned = cleanupEntry__none();
    IF bindings[node.name] EXISTS AS named_entry THEN
      entry = KEEP named_entry;
    ELSE_IF bindings[safe] EXISTS AS safe_entry THEN
      entry = KEEP safe_entry;
    END
    RETURN (((cleanupEntry__present?(entry) AND cleanupEntry__heap?(entry))) OR ((node.symbol != NIL) AND ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_203 = ((node.symbol)?);
    symbolEntry__heap_storage?(rtoc_local_receiver_203) } == TRUE)));
END
PRIVATE FN mIRLowering__lower_one_step_to_mir(MUTABLE self: MIRLowering, step: ThenStep) RETURNS ![]Emittable ->
    MUTABLE mir: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(step.expr)));
    IF (mir == NIL) THEN
      RETURN CAST(List[] AS []Emittable);
    END
    MUTABLE pending = TRY (mIRLowering__flush_pending( &self));
    # `lower` hands back at most one node: the multi-node lowerings put their
    # extra statements in the pending list this already flushes.
    MUTABLE main: ?Emittable = TRY (mIRLowering__wrap_step_as_stmt(self, step, mir));
    IF main EXISTS AS main_value THEN
      RETURN TRY (mIRLowering__guard_shared_node_statement(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(step.expr), (pending + [main_value])));
    ELSE
      RETURN pending;
    END
END
PRIVATE FN mIRLowering__wrap_step_as_stmt(self: MIRLowering, step: ThenStep, mir: Emittable) RETURNS !?Emittable ->
    MUTABLE binding: ?String = COPY step.binding;
    IF binding EXISTS AS binding_value THEN
      RETURN Emittable{ Let: COPY Let{ name: COPY binding_value, init: COPY mir, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } };
    END
    IF emittable__stmt?(mir) THEN
      RETURN COPY mir;
    END
    MUTABLE expr_type = TRY (aST__full_type_mut(step.expr));
    MUTABLE is_void_step = TRY (mIRLowering__ast_void_type?(self, TypeTypeInput{ Type: COPY expr_type }));
    RETURN Emittable{ ExprStmt: COPY ExprStmt{ expr: COPY mir, discard: !(is_void_step), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
END
PUB FN mIRLowering__lower_finalized_fsm_step_mir(MUTABLE self: MIRLowering, stmts: []Locatable, no_result: Bool, ctx_id: ?Int64 = NIL, async_result_shape: ?AsyncResultShape = NIL) RETURNS ![]Emittable ->
    self.state.capture.last_fsm_result_transfer_facts = List[];
    MUTABLE result = TRY (mIRLowering__lower_step_stmts(&self, stmts, no_result, ctx_id, async_result_shape));
    MUTABLE inherited_allocs = COPY mIRLowering__capture_state(&self).current_fsm_inherited_alloc_names;
    MUTABLE inherited_guards = COPY mIRLowering__capture_state(&self).current_fsm_inherited_guarded_names;
    RETURN TRY (mIRLowering__append_ownership_transfers_for_mir_body(&self, result, inherited_allocs, inherited_guards));
END
PUB FN mIRLowering__last_fsm_result_transfer_facts(MUTABLE self: MIRLowering) RETURNS ![]FsmResultTransferFact
  EFFECTS REENTRANT ->
    RETURN COPY mIRLowering__capture_state(&self).last_fsm_result_transfer_facts;
END
PRIVATE FN mIRLowering__with_fsm_segment_lowering_context<RESULT>(MUTABLE self: MIRLowering, pointer_captures: [Set]String, inherited_alloc_names: [Set]String, inherited_guard_names: [Set]String, owned_result_guards: {String}String, blk: FN() -> RESULT) RETURNS RESULT
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE prev_result_guards = COPY mIRLowering__capture_state(&rtoc_self_view).current_fsm_owned_result_guards;
    MUTABLE prev_alloc_names = COPY mIRLowering__capture_state(&rtoc_self_view).current_fsm_inherited_alloc_names;
    MUTABLE prev_guard_names = COPY mIRLowering__capture_state(&rtoc_self_view).current_fsm_inherited_guarded_names;
    DEFER {
    rtoc_self_view.state.capture.current_fsm_owned_result_guards = prev_result_guards;
    rtoc_self_view.state.capture.current_fsm_inherited_guarded_names = prev_guard_names;
    rtoc_self_view.state.capture.current_fsm_inherited_alloc_names = prev_alloc_names;
    }
    rtoc_self_view.state.capture.current_fsm_inherited_alloc_names = COPY inherited_alloc_names;
    rtoc_self_view.state.capture.current_fsm_inherited_guarded_names = COPY inherited_guard_names;
    rtoc_self_view.state.capture.current_fsm_owned_result_guards = COPY owned_result_guards;
    RETURN mIRLowering__with_bg_fiber_body_context( &rtoc_self_view, pointer_captures, blk);
}
END
PUB FN mIRLowering__fsm_cap_metadata(self: MIRLowering, cap: CapabilityTransition, with_node: WithBlock, ctx_id: Int64, captured: {String}Type@multiowned) RETURNS !?{String@symbol}FsmCapMetadataValue ->
    IF !(((cap.capability == symbol("EXCLUSIVE")) OR (cap.capability == :write_locked_read))) THEN
      RETURN NIL;
    END
    MUTABLE var_node = COPY cap.var_node;
    IF var_node IS_A Identifier AS identifier THEN
      MUTABLE lock_var_name = identifier__name(identifier);
      MUTABLE alias_name = COPY cap.alias_name;
      IF !(captured.contains?(lock_var_name)) THEN
        RETURN NIL;
      END
      MUTABLE resolved = COPY cap.resolved_type;
      MUTABLE any_rc: ?Bool = TRY (type__any_rc?(resolved));
      MUTABLE write_locked: ?Bool = type__write_locked?(resolved);
      MUTABLE is_param: ?Bool = (IF identifier.symbol != NIL THEN
        symbolEntry__is_param( UNWRAP (identifier.symbol))
      ELSE
        NIL
      END);
      MUTABLE polymorphic_locked = (((is_param != NIL) AND !(any_rc)) AND ((!(!(type__locked?(resolved))) OR !(!(type__write_locked?(resolved))))));
      MUTABLE lock_kind =     IF (cap.capability == :write_locked_read) THEN
        :rwlock_read
      ELSE_IF write_locked THEN
        :rwlock_write
      ELSE
        :mutex_excl
      END;
      MUTABLE base_field = "__ctx_${ctx_id.toString()}.${lock_var_name}";
      MUTABLE lock_field_ref: String = "";
      IF any_rc EXISTS AS any_rc_value THEN
        lock_field_ref = "${base_field}.ctrl.data.*";
      ELSE
        IF polymorphic_locked THEN
          lock_field_ref = "(if (comptime @hasDecl(@TypeOf(${base_field}), \"__clear_ref_carrier\")) ${base_field}.ctrl.data.* else ${base_field})";
        ELSE
          lock_field_ref = base_field;
        END
      END
      MUTABLE alias_data_ref = "(${lock_field_ref}.data)";
      MUTABLE try_method: String = COPY "tryLockForFsm";
      MUTABLE unlock_method: String = COPY "unlock";
      IF (lock_kind == :rwlock_write) THEN
        try_method = COPY "tryWriteLockForFsm";
      ELSE_IF (lock_kind == :rwlock_read) THEN
        try_method = COPY "tryReadLockForFsm";
        unlock_method = COPY "unlockShared";
      END
      MUTABLE retries: Int64 = 0;
      IF with_node.lock_error_clause EXISTS AS lock_error_clause THEN
        retries = (lock_error_clause.retries OR_ELSE 0);
      END
      RETURN CAST({:cap: FsmCapMetadataValue{ CapabilityTransition: COPY cap }, :lock_kind: FsmCapMetadataValue{ SymbolValue: COPY lock_kind }, :try_method: FsmCapMetadataValue{ StringValue: COPY try_method }, :unlock_method: FsmCapMetadataValue{ StringValue: COPY unlock_method }, :lock_field_ref: FsmCapMetadataValue{ StringValue: COPY lock_field_ref }, :alias_name: FsmCapMetadataValue{ StringValue: COPY alias_name }, :alias_data_ref: FsmCapMetadataValue{ StringValue: COPY alias_data_ref }, :retries: FsmCapMetadataValue{ Int64Value: retries }} AS ?{String@symbol}FsmCapMetadataValue);
    ELSE
      RETURN NIL;
    END
END
PUB FN mIRLowering__emit_fsm_lock_error_arm_split(MUTABLE self: MIRLowering, clause: ErrorClause, ctx_id: Int64, with_node: WithBlock, capture_map: {String}String, pointer_captures: [Set]String, bg_rt: String) RETURNS !?FsmLockErrorArmSplit ->
    MUTABLE line: String = with_node.token.line.toString();
    IF (clause.action == ErrorActionKind.Raise) THEN
      RETURN FsmLockErrorArmSplit{ body_stmts: COPY TRY (mIRLowering__lock_error_done_stmts(self, ctx_id, Emittable{ Lit: COPY Lit{ value: "\"lock acquire failed\"", lowered_node_id: NIL, ownership_consumption: NIL } }, CAST(line AS String), "error.CheatError")), exit_kind: :done };
    ELSE_IF (clause.action == ErrorActionKind.Exit) THEN
      MUTABLE message_mir = mIRLowering__with_fiber_capture_map(&self, capture_map, {}, bg_rt, %() USE(clause, MUTABLE self) -> {
    MUTABLE rtoc_lambda_result_214: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(UNWRAP (clause.message))));
    rtoc_lambda_result_214
      });
      IF !(message_mir EXISTS) THEN
        RETURN NIL;
      END
      RETURN FsmLockErrorArmSplit{ body_stmts: COPY TRY (mIRLowering__lock_error_done_stmts(self, ctx_id, message_mir, line, "error.CheatError")), exit_kind: :done };
    ELSE_IF (clause.action == ErrorActionKind.Pass) THEN
      RETURN FsmLockErrorArmSplit{ body_stmts: List[], exit_kind: :goto_post };
    ELSE_IF (clause.action == ErrorActionKind.Block) THEN
      MUTABLE prev_bg_ptr_caps: ?[Set]String = COPY mIRLowering__capture_state(&self).current_bg_pointer_captures;
      MUTABLE prev_fiber_pending = COPY mIRLowering__function_state(&self).pending_stmts;
      DEFER {
      self.state.function_state.pending_stmts = prev_fiber_pending;
      self.state.capture.current_bg_pointer_captures = prev_bg_ptr_caps;
      }
      self.state.capture.current_bg_pointer_captures = COPY pointer_captures;
      self.state.function_state.pending_stmts = List[];
      MUTABLE block_mir = mIRLowering__with_fiber_capture_map(&self, capture_map, {}, bg_rt, %() USE(clause, MUTABLE self) -> TRY (mIRLowering__lower_finalized_fsm_step_mir(&self, clause.body, TRUE)));
      RETURN FsmLockErrorArmSplit{ body_stmts: COPY block_mir, exit_kind: :goto_post };
    ELSE
      RETURN NIL;
    END
END
PRIVATE FN mIRLowering__lock_error_done_stmts(self: MIRLowering, ctx_id: Int64, message: Emittable, line: String, result_zig: String) RETURNS ![]Emittable ->
    RETURN CAST([Emittable{ ExprStmt: COPY mIRLowering__lock_error_set_error_stmt(self, ctx_id, message, line) }, Emittable{ Set: COPY mIRLowering__lock_error_result_set(self, ctx_id, result_zig) }] AS []Emittable);
END
PRIVATE FN mIRLowering__lock_error_set_error_stmt(self: MIRLowering, ctx_id: Int64, message: Emittable, line: String) RETURNS ExprStmt ->
    RETURN ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__ctx_${ctx_id.toString()}", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "rt", lowered_node_id: NIL, ownership_consumption: NIL } }, method: "setError", args: [CAST(EnumTag{ variant: "Transient" } AS Any), CAST(EnumOrdinal{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "ErrorName", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "LockTimeout", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } AS Any), CAST(message AS Any), CAST(Lit{ value: COPY line, lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: FALSE, callable_contract: NIL, owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN mIRLowering__lock_error_result_set(self: MIRLowering, ctx_id: Int64, result_zig: String) RETURNS Set ->
    MUTABLE result_name = result_zig.deletePrefix("error.");
    RETURN Set{ target: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__ctx_${ctx_id.toString()}", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "inner", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "result", lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "error", lowered_node_id: NIL, ownership_consumption: NIL } }, field: COPY result_name, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PUB FN mIRLowering__default_fsm_lock_error_arm_split(self: MIRLowering, id: Int64) RETURNS FsmLockErrorArmSplit ->
    RETURN FsmLockErrorArmSplit{ body_stmts: [Emittable{ Set: COPY mIRLowering__lock_error_result_set(self, id, "error.LockError") }], exit_kind: :done };
END
PRIVATE FN mIRLowering__lower_test_block(MUTABLE self: MIRLowering, node: TestBlock) RETURNS ![]TestDef ->
    MUTABLE ctx = TRY (testBlockCtx__new(node, &self));
    MUTABLE tests = List[];
    TRY (testBlockCtx__emit_all_hooks( &ctx, (node.before_all OR_ELSE List[]), "__before_all", "", &tests));
    FOR _ IN ((node.whens)) DO
    TRY (mIRLowering__lower_when_block(&self, _, &ctx, &tests));
    END
    TRY (testBlockCtx__emit_all_hooks( &ctx, (node.after_all OR_ELSE List[]), "__after_all", "", &tests));
    RETURN tests;
END
PRIVATE FN mIRLowering__lower_when_block(MUTABLE self: MIRLowering, when_block: WhenBlock, MUTABLE ctx: TestBlockCtx, MUTABLE tests: []TestDef) RETURNS ![]TestDef ->
    MUTABLE when_desc = when_block.description;
    MUTABLE prev_stubs = OWN COPY (COPY mIRLowering__test_state(&self).active_stubs);
    self.state.test.active_stubs = OWN COPY prev_stubs;
    DEFER self.state.test.active_stubs = prev_stubs;
    MUTABLE stubs: []Locatable = List[];
    MUTABLE non_stub_setup: []Locatable = List[];
    FOR setup_stmt IN (when_block.setup OR_ELSE List[]) DO
      IF setup_stmt IS_A StubDecl THEN
        &stubs.append(COPY setup_stmt);
      ELSE
        &non_stub_setup.append(COPY setup_stmt);
      END
    END
    MUTABLE when_setup_mir = TRY (mIRLowering__lower_body(&self, castLocatableListToMIRLoweringLowerableStmtList(non_stub_setup)));
    MUTABLE stub_mir: []Emittable = List[];
    FOR stub_stmt IN stubs DO
      MUTABLE stub_lowerable = castLocatableToMIRLoweringLowerableStmt__mir_lowering(COPY stub_stmt);
      IF TRY (mIRLowering__lower(&self, &stub_lowerable)) EXISTS AS stub_node THEN
        &stub_mir.append(COPY stub_node);
      END
    END
    MUTABLE when_before_each_mir = (((when_block.before_each OR_ELSE List[]))) |> SELECT TRY (mIRLowering__lower_body(&self, castLocatableListToMIRLoweringLowerableStmtList(_)));
    MUTABLE when_after_each_mir = (((when_block.after_each OR_ELSE List[]))) |> SELECT TRY (mIRLowering__lower_body(&self, castLocatableListToMIRLoweringLowerableStmtList(_)));
    MUTABLE let_ast_map = TRY (mIRLowering__build_let_ast_map(self, (when_block.lets OR_ELSE List[]), TRY (mIRLowering__build_let_ast_map(self, (ctx.test_block.lets OR_ELSE List[])))));
    TRY (testBlockCtx__emit_all_hooks( &ctx, (when_block.before_all OR_ELSE List[]), "__before_all", "${when_desc}: ", &tests));
    MUTABLE tag_suffix = mIRLowering__format_tag_suffix(self, (when_block.tags OR_ELSE List[]));
    MUTABLE env = TestThatEnv{ ctx: COPY ctx, when_block: COPY when_block, when_desc: COPY when_desc, tag_suffix: COPY tag_suffix, stub_mir: COPY stub_mir, when_setup_mir: COPY when_setup_mir, when_before_each_mir: COPY when_before_each_mir, when_after_each_mir: COPY when_after_each_mir, let_ast_map: let_ast_map };
    FOR _ IN when_block.tests DO
    &tests.append(TRY (mIRLowering__lower_test_that(&self, _, env)));
    END
    FOR MUTABLE rtoc_for_elem_6566 IN when_block.benchmarks DO
    MUTABLE benchmark_lowerable = castLocatableToMIRLoweringLowerableStmt__mir_lowering(UNWRAP (castBenchmarkEntryToLocatable(rtoc_for_elem_6566)));
    MUTABLE name = "${ctx.test_name}: ${when_desc}: benchmark${tag_suffix}";
    MUTABLE body = (((([Emittable{ TestPreamble: COPY testBlockCtx__fresh_preamble(ctx) }] + stub_mir) + ctx.setup_mir) + when_setup_mir) + [UNWRAP (TRY (mIRLowering__lower(&self, &benchmark_lowerable)))]);
    &tests.append(TestDef{ name: COPY name, body: COPY body, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, needs_scheduler: NIL });
    END
    RETURN TRY (testBlockCtx__emit_all_hooks( &ctx, (when_block.after_all OR_ELSE List[]), "__after_all", "${when_desc}: ", &tests));
END
PRIVATE FN mIRLowering__lower_test_that(MUTABLE self: MIRLowering, test_that: TestThat, env: TestThatEnv) RETURNS !TestDef ->
    MUTABLE full_name = "${env.ctx.test_name}: ${env.when_desc}: ${test_that.description}${env.tag_suffix}";
    IF test_that.pending THEN
      RETURN TestDef{ name: COPY full_name, body: [Emittable{ TestPreamble: COPY testBlockCtx__fresh_preamble(env.ctx) }, Emittable{ ReturnStmt: COPY ReturnStmt{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "error", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "SkipZigTest", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] , lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, needs_scheduler: NIL };
    END
    MUTABLE body_mir = TRY (mIRLowering__with_test_that_bindings(&self, test_that, %() USE(test_that, MUTABLE self) -> {
    rtoc_lambda_result_226 = TRY (mIRLowering__lower_body(&self, castLocatableListToMIRLoweringLowerableStmtList(test_that.body)));
    rtoc_lambda_result_226
    }));
    MUTABLE before_mir: []Emittable = List[];
    FOR before_group IN env.ctx.test_before_each_mir DO
      before_mir = ruby_array_concat_Emittable__mir_lowering(before_mir, COPY before_group);
    END
    FOR before_group IN env.when_before_each_mir DO
      before_mir = ruby_array_concat_Emittable__mir_lowering(before_mir, COPY before_group);
    END
    MUTABLE after_defers = ((env.ctx.test_after_each_mir + env.when_after_each_mir)) |> SELECT MIRDeferStmt{ body: DeferBody{ Emittable: COPY CAST(COPY ScopeBlock{ body: COPY _, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    # Ruby flattens the test body with the four hook bodies; the hooks are
    # optional lists of lists here, so the walk builds the flat list.
    MUTABLE let_search_nodes: []?AstIdentifierSearchNode = List[];
    FOR body_stmt IN test_that.body DO
      &let_search_nodes.append(castLocatableToOptionalAstIdentifierSearchNode(COPY body_stmt));
    END
    FOR hook_group IN ((env.when_block.before_each OR_ELSE List[]) + (env.when_block.after_each OR_ELSE List[]) + (env.ctx.test_block.before_each OR_ELSE List[]) + (env.ctx.test_block.after_each OR_ELSE List[])) DO
      FOR hook_stmt IN hook_group DO
        &let_search_nodes.append(castLocatableToOptionalAstIdentifierSearchNode(COPY hook_stmt));
      END
    END
    MUTABLE used_let_names = TRY (mIRLowering__compute_used_let_names(self, env.let_ast_map, let_search_nodes));
    MUTABLE let_decls_mir: []Emittable = List[];
    FOR let_name IN used_let_names DO
      MUTABLE let_expr = castLocatableToMIRLoweringLowerableStmt__mir_lowering(COPY UNWRAP (env.let_ast_map[let_name]).expr);
      &let_decls_mir.append(Emittable{ Let: COPY Let{ name: COPY let_name, init: COPY UNWRAP (TRY (mIRLowering__lower(&self, &let_expr))), mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
    END
    MUTABLE body = ((((((([Emittable{ TestPreamble: COPY testBlockCtx__fresh_preamble(env.ctx) }] + env.stub_mir) + env.ctx.setup_mir) + env.when_setup_mir) + let_decls_mir) + before_mir) + after_defers) + body_mir);
    MUTABLE test_def = TestDef{ name: COPY full_name, body: COPY body, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, needs_scheduler: NIL };
    test_def.needs_scheduler = TRY (mIRLowering__test_body_spawns_fibers?(self, body));
    RETURN test_def;
END
PRIVATE FN mIRLowering__test_body_spawns_fibers?(self: MIRLowering, body: []Emittable) RETURNS !Bool ->
    MUTABLE found: Bool = FALSE;
    TRY (mIR__each_node(NodeRoot{ ArrayValue: COPY body }, %(n: Emittable) USE(MUTABLE found) -> {
    found = (found OR ((((n IS_A MIRBgBlock OR n IS_A StreamSpawn) OR n IS_A ShardConcurrentEach) OR ((IF n IS_A MIRMethodCall AS mir_method_call THEN (mir_method_call.method == "getSched") ELSE FALSE END))) OR ((IF n IS_A RuntimeCall AS runtime_call THEN runtime_call.spec.callee.downcase().contains?("concurrent") ELSE FALSE END))));
    rubyToClearVoid__mir_lowering()
    }));
    RETURN found;
END
PRIVATE FN mIRLowering__with_test_that_bindings(MUTABLE self: MIRLowering, test_that: TestThat, blk: FN() -> ![]Emittable) RETURNS ![]Emittable ->
  MUTABLE prev = COPY mIRLowering__function_state(&self).current_bindings;
  DEFER self.state.function_state.current_bindings = prev;
  MUTABLE synth_fn: ?FunctionDef@multiowned = COPY test_that.synthetic_fn;
  IF synth_fn EXISTS AS synth_fn_value THEN
    IF synth_fn_value.cleanup_bindings EXISTS AS synth_bindings THEN
      self.state.function_state.current_bindings = CAST(COPY synth_bindings AS {String}CleanupEntry@multiowned);
    END
  END
  RETURN TRY (blk());
END
PRIVATE FN mIRLowering__format_tag_suffix(self: MIRLowering, tags_value: []String) RETURNS String ->
    IF (tags_value.length() == 0) THEN
      RETURN "";
    END
    RETURN (" " $+ ((tags_value |> SELECT "#${_}").join(" ")));
END
PRIVATE FN mIRLowering__build_let_ast_map(self: MIRLowering, lets: []LetBinding, base: {String}LetBinding = {}) RETURNS !{String}LetBinding ->
    MUTABLE out = COPY base;
    FOR _ IN lets DO
    out[_.name] = COPY _;
    END
    RETURN out;
END
PRIVATE FN mIRLowering__compute_used_let_names(self: MIRLowering, let_ast_map: {String}LetBinding, ast_subtrees: []?AstIdentifierSearchNode) RETURNS ![]String ->
    IF (let_ast_map.count() == 0) THEN
      RETURN CAST(List[] AS []String);
    END
    MUTABLE referenced: [Set]String = Set[];
    FOR MUTABLE rtoc_for_item_6659 IN ast_subtrees DO
    mIRLowering__collect_identifier_refs(self, rtoc_for_item_6659, let_ast_map, &referenced);
    END
    MUTABLE changed: Bool = TRUE;
    WHILE changed DO
      changed = FALSE;
      MUTABLE rtoc_each_items_231 = (referenced |> SELECT COPY _);
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < rtoc_each_items_231.length() DO
      MUTABLE let_binding: ?LetBinding = COPY let_ast_map[UNWRAP (rtoc_each_items_231[rtoc_idx])];
      IF let_binding == NIL THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE rhs = COPY let_binding.expr;
      MUTABLE before: Int64 = referenced.length();
      mIRLowering__collect_identifier_refs(self, castLocatableToOptionalAstIdentifierSearchNode(rhs), let_ast_map, &referenced);
      IF (referenced.length() > before) THEN
            changed = TRUE;
      END
    rtoc_idx = rtoc_idx + 1;
      END
    END
    RETURN let_ast_map.keys() |> WHERE referenced.contains?(_);
END
FN castAstIdentifierSearchNodeToLocatable(value: AstIdentifierSearchNode) RETURNS Locatable ->
  PARTIAL MATCH value START
    AstIdentifierSearchNode.Program AS cast_payload -> RETURN Locatable{ Program: COPY cast_payload };,
    AstIdentifierSearchNode.RequireNode AS cast_payload -> RETURN Locatable{ RequireNode: COPY cast_payload };,
    AstIdentifierSearchNode.ProtocolRequirement AS cast_payload -> RETURN Locatable{ ProtocolRequirement: COPY cast_payload };,
    AstIdentifierSearchNode.ProtocolDef AS cast_payload -> RETURN Locatable{ ProtocolDef: COPY cast_payload };,
    AstIdentifierSearchNode.ImplementationDef AS cast_payload -> RETURN Locatable{ ImplementationDef: COPY cast_payload };,
    AstIdentifierSearchNode.ConformanceDef AS cast_payload -> RETURN Locatable{ ConformanceDef: COPY cast_payload };,
    AstIdentifierSearchNode.VarDecl AS cast_payload -> RETURN Locatable{ VarDecl: COPY cast_payload };,
    AstIdentifierSearchNode.Assignment AS cast_payload -> RETURN Locatable{ Assignment: COPY cast_payload };,
