PRIVATE FN mIRLowering__lower_bg_pre_step(MUTABLE self: MIRLowering, step: BgBodyStep, MUTABLE body_mir: []Emittable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE mir = TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(step.expr)));
    MUTABLE binding: ?String = COPY step.binding;
    IF !(binding) THEN
      mir = mIRLowering__finalize_bg_discard_expr(rtoc_self_view, step.expr, mir);
    END
    MUTABLE step_pending = mIRLowering__flush_pending(rtoc_self_view);
    MUTABLE mir_nodes = mIRLowering__bg_mir_nodes(rtoc_self_view, castNodeRootToMir(mir));
    MUTABLE produced =   IF binding THEN
      (step_pending + [Let{ name: COPY UNWRAP (COPY binding), init: COPY UNWRAP (mir_nodes.last()), mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }])
