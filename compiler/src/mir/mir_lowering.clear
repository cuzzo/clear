    MUTABLE result_names = (TRY (mIRLowering__mir_ident_names(self, result)) |> SELECT _.toString()) |> DISTINCT _;
    # A boxed field temp is consumed by the STRUCT, not by the block result:
    # the struct is what the break hands back, and normalization hoists that
    # struct into a temp, after which a :block_result mark for a field temp no
    # longer names anything the break expression mentions.
    FOR rtoc_alloc_name_any IN local_alloc_names DO
      MUTABLE rtoc_alloc_name: String = COPY CAST(rtoc_alloc_name_any AS String);
      IF result_names.contains?(rtoc_alloc_name) THEN
    hoisted = ruby_array_concat_Emittable__mir_lowering(hoisted, CAST(TRY (mIRLowering__ownership_transfer_marks(&self, rtoc_alloc_name, :owned_sink, alloc_by_name[rtoc_alloc_name])) AS []Emittable));
      END
    END
    &hoisted.append(Emittable{ BreakStmt: COPY BreakStmt{ label: COPY label, value: COPY result, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    MUTABLE inherited_alloc_names = COPY mIRLowering__function_state(&self).lowered_alloc_names;
    MUTABLE inherited_guarded_names = COPY mIRLowering__function_state(&self).lowered_guarded_cleanup_names;
    FOR _ IN mIRLowering__function_state(&self).guarded_cleanup_names.keys() DO
    &inherited_guarded_names.insert(COPY CAST(_ AS String));
    END
    RETURN Emittable{ MIRBlockExpr: COPY MIRBlockExpr{ label: COPY label, body: TRY (mIRLowering__append_ownership_transfers_for_mir_body(&self, hoisted, inherited_alloc_names, inherited_guarded_names)), lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL } };
END
PRIVATE FN mIRLowering__union_variant_lit_field_types(MUTABLE self: MIRLowering, node: UnionVariantLit) RETURNS !{String}TypeTypeInput ->
    MUTABLE schema: ?UnionSchema@multiowned = COPY (TRY (mIRLowering__union_schemas(&self)))[symbol(node.union_name)];
    IF !((schema != NIL)) THEN
      RETURN {};
    END
    MUTABLE variant_data: ?SchemasUnionSchemaVariantValue = (IF schema.variants[symbol(node.variant_name)] != NIL THEN schema.variants[symbol(node.variant_name)] ELSE UNWRAP (schema.variants[symbol(CAST(node.variant_name AS String))]) END);
    IF variant_data EXISTS AS variant_data_value THEN
      IF variant_data_value IS_A InlineStructVariant AS inline_struct_variant THEN
        MUTABLE fields = COPY (CAST(inline_struct_variant AS InlineStructVariant@multiowned)).fields;
        MUTABLE inline_field_types: {String}TypeTypeInput = {};
        FOR inline_field IN fields.keys() DO
          inline_field_types[CAST(inline_field AS String)] = UNWRAP (fields[inline_field]);
        END
        RETURN inline_field_types;
      ELSE
      IF ((node.fields).length() == 1) THEN
          MUTABLE key = COPY CAST(node.fields.keys().first() AS String);
          RETURN CAST({key: TypeTypeInput{ Type: COPY UNWRAP (TRY (type__from_node( CAST(castSchemasUnionSchemaVariantValueToTypeTypeInput__mir_lowering(variant_data_value) AS ?Type)))) }} AS {String}TypeTypeInput);
      ELSE
          RETURN {};
      END
      END
    ELSE
      RETURN {};
    END
END
PRIVATE FN mIRLowering__aggregate_field_sink_alloc(MUTABLE self: MIRLowering, ignored_field_type: ?TypeTypeInput, value: Locatable, aggregate_alloc: String@symbol) RETURNS !String@symbol ->
    # A @boxed field IS a heap pointer, and the box owns what it holds: the
    # payload is allocated where the box is, whatever the aggregate's own
    # placement. Left on the frame it outlives its frame the moment the
    # HeapCreate takes it (FRAME_ALLOC_ESCAPES at that transfer).
    IF (aST__node_needs_heap_create(value) OR_ELSE FALSE) THEN
      RETURN :heap;
    END
    IF value IS_A Identifier AS identifier THEN
      MUTABLE ti: Type = TRY (type__from_node_mut(Locatable{ Identifier: COPY identifier }, "aggregate field sink"));
      IF (TRY (mIRLowering__ownership_tracked_transfer_type?(&self, ti)) AND ((aST__moved?(Locatable{ Identifier: COPY identifier }) OR (IF identifier.symbol EXISTS AS rtoc_ident_symbol THEN
        symbolEntry__heap_storage?(rtoc_ident_symbol)
      ELSE
        FALSE
      END)))) THEN
        MUTABLE source_alloc = TRY (mIRLowering__placement_for_node(&self, Locatable{ Identifier: COPY identifier }));
        IF (source_alloc == aggregate_alloc) THEN
          RETURN source_alloc;
        END
      END
    END
    RETURN aggregate_alloc;
END
PRIVATE FN mIRLowering__lower_string_concat(MUTABLE self: MIRLowering, node: StringConcat) RETURNS !ConcatStr ->
    # Each part is lowered and hoisted, which stamps it; a pipeline
    # placeholder is an immutable borrow of the source element.
    MUTABLE parts: []Emittable = List[];
    FOR MUTABLE rtoc_part IN node.parts DO
      &parts.append(TRY (mIRLowering__hoist_alloc(&self, TRY (mIRLowering__widen_symbol_to_bytes(&self, UNWRAP (TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(rtoc_part)))), rtoc_part)), &rtoc_part)));
    END
    MUTABLE alloc = TRY (mIRLowering__alloc_for_node(&self, Locatable{ StringConcat: COPY node }));
    RETURN ConcatStr{ parts: COPY parts, alloc: COPY alloc, rt_expr: COPY mIRLowering__runtime_binding_name(&self), lowered_node_id: NIL, ownership_consumption: NIL };
END
PRIVATE FN mIRLowering__lower_block_expr(MUTABLE self: MIRLowering, node: BlockExpr) RETURNS !MIRLoweringReturnValue ->
    MUTABLE label = "__blk_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_594 = mIRLowering__lowering_counters(&self);
    mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_block_expr_id(&rtoc_mutable_receiver_594)) }}";
    MUTABLE transfer_name: ?String = NIL;
    IF ((node.result != NIL) AND (UNWRAP (node.result) IS_A Identifier)) THEN
      MUTABLE raw_name = COPY CAST(locatable__name(UNWRAP (node.result)) AS String);
      MUTABLE entry: ?CleanupEntry@multiowned = COPY (TRY (functionState__bindings(mIRLowering__function_state(&self))))[raw_name];
      transfer_name = mIRLowering__zig_safe_name(self, raw_name);
      IF entry EXISTS AS entry_value THEN
        IF cleanupEntry__needs_cleanup?(entry_value) THEN
        cleanupEntry__mark_moved_guard_mut( UNWRAP (entry));
        MUTABLE rtoc_index_receiver_595 = mIRLowering__function_state(&self).guarded_cleanup_names;
        rtoc_index_receiver_595[UNWRAP (transfer_name)] = TRUE;
      END
      END
    END
    MUTABLE body = TRY (mIRLowering__lower_body(&self, castLocatableListToMIRLoweringLowerableStmtList(node.body)));
    IF node.result EXISTS AS optional_value_value THEN
      MUTABLE optional_value_value_mutable = COPY optional_value_value;
      MUTABLE result, result_hoists = mIRLowering__lower_head(&self, %() USE(node, MUTABLE optional_value_value_mutable, MUTABLE self) -> {
    MUTABLE rtoc_lambda_result_596: ?Emittable = TRY (mIRLowering__lower(&self, castOptionalLocatableToMIRLoweringLowerableStmt(optional_value_value_mutable)));
    rtoc_lambda_result_596
      });
      body = ruby_array_concat_Emittable__mir_lowering(body, CAST(result_hoists AS []Emittable));
      IF transfer_name EXISTS AS transfer_name_value THEN
        MUTABLE transfer_name_value_mutable = COPY transfer_name_value;
        MUTABLE cleanup: ?Emittable = body |> FIND (((_ IS_A Cleanup OR _ IS_A ErrCleanup)) AND (CAST(emittable__name(_) AS String) == transfer_name_value_mutable));
        IF cleanup EXISTS AS cleanup_value THEN
          MUTABLE cleanup_value_mutable = COPY cleanup_value;
          MUTABLE rtoc_mutable_receiver_597 = (TRY (ownedCompositeMaterialization__cleanup_entry( CAST(cleanup_value_mutable AS OwnedCompositeMaterialization))));
          cleanupEntry__mark_moved_guard_mut(&rtoc_mutable_receiver_597);
          body = ruby_array_concat_Emittable__mir_lowering(body, CAST(TRY (mIRLowering__ownership_transfer_marks(&self, transfer_name_value_mutable, :block_result, NIL, TRUE)) AS []Emittable));
        END
      END
      &body.append(Emittable{ BreakStmt: COPY BreakStmt{ label: COPY label, value: COPY result, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
      MUTABLE block = MIRBlockExpr{ label: COPY label, body: body, lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
      block.result_type = TRY (type__from_node_mut(optional_value_value_mutable, "block expression result"));
      RETURN MIRLoweringReturnValue{ MIRBlockExpr: COPY block };
    ELSE
      RETURN MIRLoweringReturnValue{ ScopeBlock: COPY ScopeBlock{ body: body, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
END
PRIVATE FN mIRLowering__lower_range_lit(MUTABLE self: MIRLowering, node: RangeLit) RETURNS !MIRRangeLit ->
    MUTABLE s: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(node.start)));
    MUTABLE e: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(node.finish)));
    # `tense_type&.element_type&.resolved` -- each link is optional, and the
    # CLEAR tense_type is not, so the nil test it was given never typed.
    MUTABLE elem_type: ?String@symbol = NIL;
    IF TRY (type__element_type((TRY (type__tense_type((TRY (aST__full_type_mut(Locatable{ RangeLit: COPY node }))))))) ) EXISTS AS rtoc_elem THEN
      elem_type = type__resolved(rtoc_elem);
    END
    MUTABLE range_branch_value: ?MIRRangeLit = NIL;
    IF node.inclusive THEN
      range_branch_value = MIRRangeLit{ start: UNWRAP (COPY s), end_val: Emittable{ MIRBinOp: COPY MIRBinOp{ op: "+", left: UNWRAP (COPY e), right: Emittable{ Lit: COPY Lit{ value: "1", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, elem_type: UNWRAP (elem_type), lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    ELSE
      range_branch_value = MIRRangeLit{ start: UNWRAP (COPY s), end_val: UNWRAP (COPY e), elem_type: UNWRAP (elem_type), lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    END
    MUTABLE range: MIRRangeLit = range_branch_value?;
    range.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY TRY (aST__full_type_mut(Locatable{ RangeLit: COPY node })) }));
    RETURN range;
END
PRIVATE FN mIRLowering__lower_slice(MUTABLE self: MIRLowering, MUTABLE node: Slice) RETURNS !SliceExpr ->
    MUTABLE target: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(node.target)));
    MUTABLE start_expr: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt( UNWRAP (node.start))));
    MUTABLE end_expr: ?Emittable = TRY (mIRLowering__lower(&self, castOptionalLocatableToMIRLoweringLowerableStmt(node.end)));
    MUTABLE exclusive = node.exclusive;
    MUTABLE target_ti: ?Type = TRY (type__from_node_mut(node.target, "slice target"));
    IF TRY (type__direct_indexable_collection?( UNWRAP (target_ti))) THEN
      target = ItemsAccess{ expr: Emittable{ ItemsAccess: CAST(COPY target AS ItemsAccess)}, safe: TRUE, lowered_node_id: NIL, ownership_consumption: NIL };
    END
    MUTABLE start_cast = MIRCast{ expr: UNWRAP (COPY start_expr), target_type: "usize", method: :intCast, lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE end_cast =   IF exclusive THEN
      Emittable{ MIRCast: COPY MIRCast{ expr: UNWRAP (COPY end_expr), target_type: "usize", method: :intCast, lowered_node_id: NIL, ownership_consumption: NIL } }
    ELSE
      Emittable{ MIRBinOp: COPY MIRBinOp{ op: "+", left: Emittable{ MIRCast: COPY MIRCast{ expr: UNWRAP (COPY end_expr), target_type: "usize", method: :intCast, lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Lit: COPY Lit{ value: "1", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }
    END;
    MUTABLE element_type: ?Type = TRY (type__element_type(TRY (aST__full_type_mut(node.target))));
    MUTABLE elem_zig: String = "";
    IF element_type THEN
      elem_zig = TRY (type__zig_type((TRY (type__new(TypeConstructionInput{ Type: COPY element_type })))));
    ELSE
      elem_zig = "u8";
    END
    RETURN SliceExpr{ target: Emittable{ ItemsAccess: CAST(COPY target AS ItemsAccess)}, start: Emittable{ MIRCast: COPY start_cast }, end_expr: COPY end_cast, elem_type: elem_zig, lowered_node_id: NIL, ownership_consumption: NIL };
END
PRIVATE FN mIRLowering__lower_assert(MUTABLE self: MIRLowering, MUTABLE node: Assert) RETURNS !MIRLoweringReturnValue ->
    MUTABLE eq_lowering: ?Call = TRY (mIRLowering__try_lower_equality_assert(&self, node));
    IF (!(mIRLowering__bc_target?(&self)) AND (eq_lowering)) THEN
      RETURN MIRLoweringReturnValue{ Call: COPY eq_lowering };
    END
    MUTABLE cond: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(node.condition)));
    MUTABLE raw = node.message;
    MUTABLE msg_str: String = "";
    msg_str = "assertion failed";
    PARTIAL MATCH raw START
        AssertMessage.StringValue AS rtoc_raw_text ->
          IF (rtoc_raw_text.codepointCount() > 0) THEN
            msg_str = COPY rtoc_raw_text;
          END,
        AssertMessage.SymbolValue AS rtoc_raw_sym ->
          IF (rtoc_raw_sym != :Any) THEN
            msg_str = COPY CAST(rtoc_raw_sym AS String);
          END,
        DEFAULT -> PASS;
      END
    MUTABLE msg = msg_str.replace("\"", "\\\"");
    RETURN MIRLoweringReturnValue{ AssertStmt: COPY AssertStmt{ cond: UNWRAP (COPY cond), message: "\"${msg}\"", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
END
PRIVATE FN mIRLowering__try_lower_equality_assert(MUTABLE self: MIRLowering, node: Assert) RETURNS !?Call ->
    MUTABLE cond = node.condition;
    IF !((cond IS_A BinaryOp AND (aST__node_op(cond) == :EQ))) THEN
      RETURN NIL;
    END
    MUTABLE raw = node.message;
    MUTABLE has_message: Bool = FALSE;
    PARTIAL MATCH raw START
      AssertMessage.StringValue AS rtoc_raw_text -> has_message = (rtoc_raw_text.codepointCount() > 0);,
      AssertMessage.SymbolValue AS rtoc_raw_sym -> has_message = (rtoc_raw_sym != :Any);,
      DEFAULT -> PASS;
    END
    IF has_message THEN
      RETURN NIL;
    END
    MUTABLE left: ?Locatable@boxed = locatable__left(cond);
    MUTABLE right: ?Locatable@boxed = locatable__right(cond);
    MUTABLE left_type: ?Type = TRY (mIRLowering__type_info_for(self, UNWRAP (left)));
    MUTABLE right_type: ?Type = TRY (mIRLowering__type_info_for(self, UNWRAP (right)));
    MUTABLE left_mir: Emittable = CAST(TRY (mIRLowering__lower(&self, castOptionalLocatableToMIRLoweringLowerableStmt(left))) AS Emittable);
    MUTABLE right_mir: Emittable = CAST(TRY (mIRLowering__lower(&self, castOptionalLocatableToMIRLoweringLowerableStmt(right))) AS Emittable);
    IF (TRY (type__any_rc?( UNWRAP (left_type))) AND !(mIRLowering__bc_target?(&self))) THEN
      left_mir = TRY (mIRLowering__rc_payload_value(self, left_mir, CAST(left_type AS Type)));
    END
    IF (TRY (type__any_rc?( UNWRAP (right_type))) AND !(mIRLowering__bc_target?(&self))) THEN
      right_mir = TRY (mIRLowering__rc_payload_value(self, right_mir, CAST(right_type AS Type)));
    END
    left_mir = TRY (mIRLowering__hoist_alloc(&self, &left_mir, &left));
    right_mir = TRY (mIRLowering__hoist_alloc(&self, &right_mir, &right));
    MUTABLE helper, extra_args = TRY (mIRLowering__pick_equality_helper(self, UNWRAP (left), UNWRAP (right)));
    IF (helper == "expectEqualStrings") THEN
      left_mir = TRY (mIRLowering__widen_symbol_to_bytes(&self, left_mir, left));
      right_mir = TRY (mIRLowering__widen_symbol_to_bytes(&self, right_mir, right));
    END
    MUTABLE args_mir: []Emittable = extra_args |> SELECT Emittable{ Ident: COPY Ident{ name: COPY _, lowered_node_id: NIL, ownership_consumption: NIL } };
    &args_mir.append(left_mir);
    &args_mir.append(right_mir);
    MUTABLE params: []Param = List[];
    MUTABLE assert_arg_index = 0;
    WHILE assert_arg_index < args_mir.length() DO
      &params.append(Param{ name: "__assert_eq_arg${assert_arg_index.toString()}", type: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })), default: NIL, mutable: NIL, takes: NIL, comptime: NIL, name_token: NIL, required: NIL, sync: NIL, symbol: NIL, carrier_contract: NIL });
      assert_arg_index = assert_arg_index + 1;
    END
    MUTABLE sig = TRY (functionSignature__new(params, TypeTypeInput{ Type: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :Void })) }, NIL, NIL, List[], {}, FALSE, FALSE, NIL, NIL, NIL, List[], NIL, List[], TRUE, NIL, TRUE, NIL, NIL, NIL, NIL, NIL, NIL, NIL, NIL, NIL, NIL, NIL, IntrinsicEmit{ borrows: CAST(:all AS ?Borrows), zig: NIL, numeric_zig: NIL, sharded_zig: NIL, shard_direct_zig: NIL, fsm_setup: List[], fsm_state_decls: List[], fsm_finish_block: List[], fsm_state_finalize: List[], fsm_setup_present: FALSE, fsm_state_decls_present: FALSE, fsm_finish_block_present: FALSE, fsm_state_finalize_present: FALSE, fsm_finish_value: NIL, bc: FALSE, is_method: FALSE, suspends: FALSE, narrows_collection: FALSE, narrows_receiver_collection: FALSE, mutates_receiver: FALSE, allocates: FALSE, takes_value: FALSE, container_borrow: FALSE, tag: NIL, builtin: NIL, alloc: NIL, return_alloc: NIL, val_alloc: NIL, key_alloc: NIL, shard_alloc: NIL, sharded_alloc: NIL, reject_when: NIL, bc_op: NIL, error_kind: NIL, error_type: NIL, registry: NIL, elem: NIL, lifetime: List[], reject_error: NIL, arity: NIL, takes_args: List[], eql: NIL, strcmp: NIL, cleanup: NIL, assert: NIL, array: NIL, list: NIL, pool: NIL, set: NIL, get: NIL, string_raw: NIL, string_symbol: NIL, string_map: NIL, numeric_map: NIL, set_collection: NIL }));
    MUTABLE contract = TRY (ownershipContract__new(List[], List[], List[], TRUE));
    RETURN Call{ callee: "std.testing.${helper}", args: COPY args_mir, try_wrap: TRUE, owned_return: FALSE, callable_contract: COPY callableContract__new(sig, contract, args_mir.length()), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL };
END
PRIVATE FN mIRLowering__pick_equality_helper(self: MIRLowering, left: Locatable, right: Locatable) RETURNS !Tuple<String, []String> ->
    MUTABLE lt: ?Type = TRY (mIRLowering__type_info_for(self, left));
    MUTABLE rt: ?Type = TRY (mIRLowering__type_info_for(self, right));
    IF (TRY (type__string_comparable_with?(UNWRAP (lt), CAST(rt AS ?Type))) OR TRY (type__string_comparable_with?(UNWRAP (rt), CAST(lt AS ?Type)))) THEN
      RETURN CAST(Tuple{"expectEqualStrings", List[]} AS Tuple<String, []String>);
    END
    MUTABLE slice_elem: ?String = (IF TRY (mIRLowering__slice_element_zig_type(self, CAST(lt AS Type))) != NIL THEN TRY (mIRLowering__slice_element_zig_type(self, CAST(lt AS Type))) ELSE TRY (mIRLowering__slice_element_zig_type(self, CAST(rt AS Type))) END);
    IF slice_elem EXISTS AS slice_elem_value THEN
      RETURN CAST(Tuple{"expectEqualSlices", [slice_elem_value]} AS Tuple<String, []String>);
    END
    RETURN CAST(Tuple{"expectEqualDeep", List[]} AS Tuple<String, []String>);
END
PRIVATE FN mIRLowering__type_info_for(self: MIRLowering, ast_node: Locatable) RETURNS !?Type ->
    RETURN TRY (type__from_node_mut(ast_node, "equality helper"));
END
PRIVATE FN mIRLowering__slice_element_zig_type(self: MIRLowering, t: Type) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((TRUE AND type__array?(t))) THEN
      RETURN NIL;
    END
    IF TRY (type__string?(t)) THEN
      RETURN NIL;
    END
    MUTABLE elem_branch_value: ?Type = NIL;
    IF TRUE THEN
      elem_branch_value = TRY (type__element_type(t));
    ELSE
      elem_branch_value = NIL;
    END
    MUTABLE elem: ?Type = elem_branch_value;
    IF elem EXISTS AS elem_value THEN
      IF TRUE THEN
        RETURN TRY (type__zig_type(elem_value));
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
CATCH Transient, Input, System, NotFound, Permission, Canceled
  RETURN NIL;
END
PRIVATE FN mIRLowering__lower_raise(MUTABLE self: MIRLowering, node: Raise) RETURNS !ScopeBlock ->
    MUTABLE rt = Ident{ name: mIRLowering__runtime_binding_name(&self), lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE kind = COPY CAST(((node.kind OR_ELSE :Unknown)) AS String);
    MUTABLE error_name: ?String = COPY node.error_name;
    MUTABLE name_expr =   IF (error_name AND !(error_name.empty?())) THEN
      Emittable{ EnumOrdinal: COPY EnumOrdinal{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "ErrorName", lowered_node_id: NIL, ownership_consumption: NIL } }, field: COPY error_name, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }
    ELSE
      Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }
    END;
    MUTABLE msg_expr: Emittable = Emittable{ Lit: COPY Lit{ value: "\"\"", lowered_node_id: NIL, ownership_consumption: NIL } };
    IF node.message_expr EXISTS AS MUTABLE rtoc_message_expr_present THEN
      msg_expr = UNWRAP (TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__pipeline_lowering_bridge(rtoc_message_expr_present))));
    END
    MUTABLE line: String = node.token.line.toString();
    MUTABLE set_error = MIRMethodCall{ receiver: Emittable{ Ident: COPY rt }, method: "setError", args: [CAST(EnumTag{ variant: COPY kind } AS Any), CAST(name_expr AS Any), CAST(msg_expr AS Any), CAST(Lit{ value: COPY line, lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(4)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    MUTABLE ret = ReturnStmt{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "error", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "CheatError", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    RETURN ScopeBlock{ body: COPY [Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ MIRMethodCall: COPY set_error }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ ReturnStmt: COPY ret }], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN mIRLowering__lower_copy(MUTABLE self: MIRLowering, MUTABLE node: CopyNode) RETURNS !Emittable ->
    self.state.function_state.current_sink_type = COPY mIRLowering__function_state(&self).current_sink_type;
    self.state.function_state.current_expected_type = COPY mIRLowering__function_state(&self).current_expected_type;
    IF (((node.own OR_ELSE FALSE) AND UNWRAP (aST__node_value(Locatable{ CopyNode: COPY node })) IS_A Identifier) AND ((locatable__symbol(node.value) != NIL) AND ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_606 = ((locatable__symbol(node.value))?);
    symbolEntry__carrier_contract(rtoc_local_receiver_606) } == :monomorphic))) THEN
      MUTABLE payload_ti: ?Type = TRY (type__from_node_mut(node.value, "OWN COPY monomorphic payload"));
      MUTABLE projected = ComptimeCarrierPayload{ source: UNWRAP (COPY TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(node.value)))), lowered_node_id: NIL, ownership_consumption: NIL };
      RETURN Emittable{ DeepCopy: COPY DeepCopy{ source: Emittable{ ComptimeCarrierPayload: COPY projected }, zig_type: COPY CAST(type__resolved( UNWRAP (payload_ti)) AS String), elem_type: NIL, strategy: :full_value, alloc: :heap, copy_shape: deepCopy__copy_shape_for_zig_type(COPY CAST(type__resolved( UNWRAP (payload_ti)) AS String)), type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF node.own THEN
      MUTABLE own_src_ti: ?Type = TRY (type__from_node_mut(node.value, "OWN COPY handle payload"));
      IF TRY (type__any_rc?( UNWRAP (own_src_ti))) THEN
        MUTABLE payload_ti = TRY (type__bare_data_type( UNWRAP (own_src_ti)));
        MUTABLE projected = ComptimeCarrierPayload{ source: UNWRAP (COPY TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__pipeline_lowering_bridge(node.value)))), lowered_node_id: NIL, ownership_consumption: NIL };
        RETURN Emittable{ DeepCopy: COPY DeepCopy{ source: Emittable{ ComptimeCarrierPayload: COPY projected }, zig_type: COPY TRY (type__zig_type(payload_ti)), elem_type: NIL, strategy: :full_value, alloc: :heap, copy_shape: deepCopy__copy_shape_for_zig_type(COPY TRY (type__zig_type(payload_ti))), type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
    END
    MUTABLE source: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__pipeline_lowering_bridge( CAST(castLocatableToMIRLoweringLowerableStmt__pipeline_lowering_bridge(node.value) AS Locatable))));
    IF mIRLowering__fresh_copy_constructor?(self, node.value) THEN
      RETURN source;
    END
    IF hoist__noreturn_value?(node.value) THEN
      RETURN source;
    END
    IF TRY (mIRLowering__unit_union_variant_constructor?(&self, node.value)) THEN
      RETURN source;
    END
    MUTABLE source_ti = TRY (mIRLowering__copy_source_type_info(self, node.value));
    MUTABLE ti: Type = source_ti;
    IF locatable__coerced_type_info(Locatable{ CopyNode: COPY node }) EXISTS THEN
      ti = COPY TRY (type__new(TypeConstructionInput{ Type: COPY UNWRAP (locatable__coerced_type_info(Locatable{ CopyNode: COPY node })) }));
    END
    IF (TRY (type__any_rc?(ti)) AND !(TRY (type__any_rc?(source_ti)))) THEN
      ti = KEEP source_ti;
    END
    MUTABLE lifecycle = COPY TRY (lifecycleRegistry__fetch(mIRLowering__lifecycle_registry(&self), ti));
    MUTABLE sink_type: ?Type = (IF mIRLowering__function_state(&self).current_sink_type != NIL THEN mIRLowering__function_state(&self).current_sink_type ELSE mIRLowering__function_state(&self).current_expected_type END);
    MUTABLE dst_ti_branch_value: ?Type@multiowned = NIL;
    IF sink_type EXISTS AS sink_type_value THEN
      dst_ti_branch_value = (sink_type_value);
    ELSE
      dst_ti_branch_value = ti;
    END
    MUTABLE dst_ti: Type@multiowned = dst_ti_branch_value?;
    MUTABLE alloc = ((IF mIRLowering__function_state(&self).current_decl_alloc != NIL THEN mIRLowering__function_state(&self).current_decl_alloc ELSE node.alloc END) OR_ELSE :heap);
    IF (IF source IS_A Orelse AS orelse THEN lifecyclePlan__needs_drop?(lifecycle) ELSE FALSE END) THEN
      source = TRY (mIRLowering__place_owned_orelse_for_destination(&self, castEmittableToOrelse(UNWRAP (source)), CAST(source_ti AS Type), alloc));
      source = TRY (mIRLowering__hoist_alloc(&self, UNWRAP (source), &node.value, FALSE, FALSE, FALSE));
    ELSE_IF TRY (mIRLowering__mir_allocates?(&self, source)) THEN
      source = TRY (mIRLowering__hoist_alloc(&self, UNWRAP (source), &node.value));
    END
    IF (lifecycle.copy_strategy == :bit_copy) THEN
      RETURN Emittable{ DeepCopy: COPY DeepCopy{ source: COPY UNWRAP (source), zig_type: NIL, elem_type: NIL, strategy: :passthrough, alloc: NIL, copy_shape: deepCopy__copy_shape_for_zig_type(NIL), type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE_IF (lifecycle.copy_strategy == :forbidden) THEN
      panic("annotation admitted COPY of linear type {}");
    ELSE_IF (lifecycle.copy_strategy == :retain) THEN
      IF (type__optional?(ti) AND ((TRY (type__wrapped_type(ti)) != NIL) AND TRY (type__any_rc?((UNWRAP (TRY (type__wrapped_type(ti)))))))) THEN
        MUTABLE wrapped = UNWRAP (TRY (type__wrapped_type(ti)));
        MUTABLE capture = "__copy_rc_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_609 = mIRLowering__lowering_counters(&self);
        mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_609)) }}";
        MUTABLE func: String = "";
        IF type__shared?(wrapped) THEN
          func = "arcRetain";
        ELSE
          func = "rcRetain";
        END
        MUTABLE retained = RcRetain{ source: Emittable{ Ident: COPY Ident{ name: COPY capture, lowered_node_id: NIL, ownership_consumption: NIL } }, zig_base: TRY (mIRLowering__rc_payload_zig_type(self, wrapped)), func: COPY func, lowered_node_id: NIL, ownership_consumption: NIL };
        MUTABLE copied = IfOptional{ optional: COPY source, capture: COPY capture, then_expr: Emittable{ RcRetain: COPY retained }, else_expr: Emittable{ Lit: COPY Lit{ value: "null", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
        copied.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY ti }));
        RETURN Emittable{ IfOptional: COPY copied };
      ELSE
        IF type__shared?(ti) THEN
          func = "arcRetain";
        ELSE
          func = "rcRetain";
        END
        RETURN Emittable{ RcRetain: COPY RcRetain{ source: COPY source, zig_base: TRY (mIRLowering__rc_payload_zig_type(self, CAST(ti AS Type))), func: COPY func, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
    ELSE_IF (lifecycle.copy_strategy == :deep_clone) OR (lifecycle.copy_strategy == :generic) THEN
      MUTABLE copy_ti_branch_value: ?Type@multiowned = NIL;
      IF ((type__optional?(ti) OR type__error_union?(ti))) THEN
        copy_ti_branch_value = ti;
      ELSE
        copy_ti_branch_value = dst_ti;
      END
      MUTABLE copy_ti: Type@multiowned = copy_ti_branch_value?;
      MUTABLE dst_payload = TRY (type__non_optional_type(dst_ti));
      MUTABLE source_payload = TRY (type__non_optional_type(ti));
      IF (TRY (type__any_rc?(dst_payload)) AND !(TRY (type__any_rc?(source_payload)))) THEN
        RETURN Emittable{ DeepCopy: COPY DeepCopy{ source: COPY source, zig_type: COPY TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY source_payload })), elem_type: NIL, strategy: :full_value, alloc: COPY alloc, copy_shape: COPY deepCopy__copy_shape_for_zig_type(TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY source_payload }))), type_info: COPY source_payload, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
      MUTABLE copy_zig: ?String =     IF (lifecycle.copy_strategy == :generic) THEN
        NIL
      ELSE_IF (type__optional?(ti) OR type__error_union?(ti)) THEN
        TRY (mIRLowering__bare_zig_type(self, CAST(ti AS Type)))
      ELSE_IF TRY (type__string?(ti)) THEN
        "[]const u8"
      ELSE_IF ((TRY (type__direct_indexable_collection?(ti)) AND TRY (type__direct_indexable_collection?(dst_ti))) AND !(TRY (type__string?(dst_ti)))) THEN
        TRY (mIRLowering__copy_source_zig_type(self, node.value, CAST(ti AS Type), CAST(dst_ti AS Type)))
      ELSE_IF (type__borrowed_reference?(ti) OR (type__ownership(ti) == :borrow)) THEN
        TRY (mIRLowering__bare_zig_type(self, CAST(dst_ti AS Type)))
      ELSE_IF (type__indirect?(dst_ti) AND !(type__indirect?(ti))) THEN
        TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY ti }))
      ELSE_IF (TRY (type__any_rc?(dst_ti)) AND !(TRY (type__any_rc?(ti)))) THEN
        TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY ti }))
      ELSE
        TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY dst_ti }))
      END;
      RETURN Emittable{ DeepCopy: COPY DeepCopy{ source: COPY UNWRAP (source), zig_type: COPY copy_zig, elem_type: NIL, strategy: :full_value, alloc: COPY alloc, copy_shape: COPY deepCopy__copy_shape_for_zig_type(copy_zig), type_info: CAST(COPY copy_ti AS ?Type), lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE
      panic("unknown lifecycle copy strategy {} for {}");
    END
END
PRIVATE FN mIRLowering__copy_source_type_info(self: MIRLowering, source: Locatable) RETURNS !Type ->
    IF (TRUE AND locatable__typed?(source)) THEN
      RETURN TRY (aST__full_type_mut(source));
    END
    IF source IS_A GetIndex AS get_index THEN
      MUTABLE target_ti: ?Type = TRY (type__from_node_mut(get_index.target, "COPY index target"));
      MUTABLE elem: ?Type = TRY (type__element_type( UNWRAP (target_ti)));
      IF elem EXISTS AS elem_value THEN
        RETURN COPY elem_value;
      END
    END
    # Ruby reads the symbol's type only when the source is an identifier that
    # has one, and keeps it only when it is a resolved Type.
    IF source IS_A Identifier THEN
      IF locatable__symbol(source) EXISTS AS rtoc_source_symbol THEN
        MUTABLE sym_type: Type = symbolEntry__type(rtoc_source_symbol);
        IF !(type__untyped?(sym_type)) THEN
          RETURN sym_type;
        END
      END
    END
    RETURN TRY (type__from_node_mut(source, "COPY value"));
END
PRIVATE FN mIRLowering__fresh_copy_constructor?(self: MIRLowering, node: Locatable) RETURNS Bool ->
    MUTABLE value: Locatable = COPY node;
    WHILE (value IS_A CopyNode OR value IS_A KeepNode) DO
      value = UNWRAP (aST__node_value( value));
    END
    RETURN ((((value IS_A TupleLit OR value IS_A ListLit) OR value IS_A HashLit) OR value IS_A StructLit) OR value IS_A UnionVariantLit);
END
PRIVATE FN mIRLowering__copy_source_zig_type(self: MIRLowering, source: Locatable, source_type: Type, dest_type: Type) RETURNS !String ->
    IF ((TRY (type__non_string_array?(source_type)) AND source IS_A Identifier) AND ((locatable__symbol(source) != NIL) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_610 = ((locatable__symbol(source))?);
    symbolEntry__is_param(rtoc_local_receiver_610) })) THEN
      RETURN TRY (type__zig_type(source_type, TRUE));
    END
    IF (TRY (type__non_string_array?(source_type)) AND type__collection?(dest_type)) THEN
      RETURN TRY (type__zig_type(source_type));
    ELSE
      RETURN TRY (type__zig_type(dest_type));
    END
END
PRIVATE FN mIRLowering__lower_clone(MUTABLE self: MIRLowering, MUTABLE node: KeepNode) RETURNS !Emittable ->
    MUTABLE func: String = "";
    MUTABLE ti: ?Type = TRY (type__from_node_mut(node.value, "CLONE value"));
    IF (node.carrier_op == :monomorphic_keep) THEN
      RETURN Emittable{ MonomorphicKeep: COPY MonomorphicKeep{ source: COPY UNWRAP (TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(node.value)))), zig_base: COPY CAST(type__resolved( UNWRAP (ti)) AS String), alloc: :heap, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF (node.carrier_op == :deferred_specialization) THEN
      panic("KEEP on a carrier-polymorphic parameter requires carrier {}");
    END
    MUTABLE lifecycle = COPY TRY (lifecycleRegistry__fetch(mIRLowering__lifecycle_registry(&self), UNWRAP (ti)));
    IF (lifecycle.copy_strategy == :bit_copy) THEN
      RETURN Emittable{ DeepCopy: COPY DeepCopy{ source: COPY UNWRAP (TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(node.value)))), zig_type: NIL, elem_type: NIL, strategy: :passthrough, alloc: NIL, copy_shape: deepCopy__copy_shape_for_zig_type(NIL), type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF !((lifecycle.copy_strategy == :retain)) THEN
      panic("annotation admitted KEEP without retain lifecycle for {}");
    END
    IF (type__optional?( UNWRAP (ti)) AND ((TRY (type__wrapped_type( UNWRAP (ti))) != NIL) AND TRY (type__any_rc?((UNWRAP (TRY (type__wrapped_type( UNWRAP (ti))))))))) THEN
      MUTABLE wrapped = UNWRAP (TRY (type__wrapped_type( UNWRAP (ti))));
      MUTABLE capture = "__clone_rc_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_611 = mIRLowering__lowering_counters(&self);
      mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_611)) }}";
      IF type__shared?(wrapped) THEN
        func = "arcRetain";
      ELSE
        func = "rcRetain";
      END
      MUTABLE retained = RcRetain{ source: Emittable{ Ident: COPY Ident{ name: COPY capture, lowered_node_id: NIL, ownership_consumption: NIL } }, zig_base: TRY (mIRLowering__rc_payload_zig_type(self, wrapped)), func: COPY func, lowered_node_id: NIL, ownership_consumption: NIL };
      MUTABLE cloned = IfOptional{ optional: COPY UNWRAP (TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(node.value)))), capture: COPY capture, then_expr: Emittable{ RcRetain: COPY retained }, else_expr: Emittable{ Lit: COPY Lit{ value: "null", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
      cloned.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY UNWRAP (ti)}));
      RETURN Emittable{ IfOptional: COPY cloned };
    END
    IF TRY (type__split_open_stream?( UNWRAP (ti))) THEN
      func = "splitRetain";
    ELSE_IF (type__shared_promise?( UNWRAP (ti)) OR type__shared?( UNWRAP (ti))) THEN
      func = "arcRetain";
    ELSE_IF type__multiowned?( UNWRAP (ti)) THEN
      func = "rcRetain";
    ELSE
      panic("Internal: lower_clone on unsupported type {}");
    END
    MUTABLE zig_base: String = "";
    IF TRY (type__split_open_stream?( UNWRAP (ti))) THEN
      zig_base = TRY (type__zig_type( UNWRAP (ti)));
    ELSE
      zig_base = TRY (mIRLowering__rc_payload_zig_type(self, UNWRAP (ti)));
    END
    RETURN Emittable{ RcRetain: COPY RcRetain{ source: COPY UNWRAP (TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(node.value)))), zig_base: COPY zig_base, func: COPY func, lowered_node_id: NIL, ownership_consumption: NIL } };
END
PRIVATE FN mIRLowering__kept_identity_orelse_field_value(MUTABLE self: MIRLowering, field_node: Locatable, expected_ft: ?Type, alloc: String@symbol) RETURNS !?Emittable ->
    IF !((IF expected_ft != NIL THEN
      type__multiowned?(expected_ft)
    ELSE
      NIL
    END)) THEN
      RETURN NIL;
    END
    IF field_node IS_A BinaryOp AS binary_op THEN
      MUTABLE binary_op_mutable = COPY binary_op;
    IF (binary_op_mutable.op == symbol("OR_ELSE")) THEN
        MUTABLE lhs: Locatable = COPY binary_op_mutable.left;
        IF lhs IS_A Identifier AS identifier THEN
          MUTABLE identifier_mutable = COPY identifier;
          MUTABLE entry: ?CleanupEntry@multiowned = COPY (TRY (functionState__bindings(mIRLowering__function_state(&self))))[identifier__name(identifier_mutable)];
          IF !((((entry != NIL) AND cleanupEntry__present?(entry)) AND (entry.source_kind == :kept_param))) THEN
            RETURN NIL;
          END
          MUTABLE bare = TRY (type__bare_data_type( UNWRAP (expected_ft)));
          MUTABLE default_ti:? = (TRY (type__from_node_mut(COPY binary_op_mutable.right, "kept orelse default")));
          MUTABLE default_rc = ((default_ti != NIL) AND (TRY (type__any_rc?(default_ti)) == TRUE));
          IF (!(default_rc) AND TRUE) THEN
            MUTABLE sig: ?FunctionSignature@multiowned = locatable__matched_signature(UNWRAP (locatable__right( Locatable{ BinaryOp: COPY binary_op_mutable })));
            MUTABLE rt: ?Type@multiowned = NIL;
            IF sig EXISTS AS rtoc_sig_rt THEN
              rt = COPY functionSignature__return_type(rtoc_sig_rt);
            END
            IF rt EXISTS AS rtoc_rt THEN
              default_rc = TRY (type__any_rc?((TRY (type__new(TypeConstructionInput{ Type: COPY rtoc_rt })))));
            END
          END
          MUTABLE wrapped: Emittable = TRY (mIRLowering__lower_scoped(&self, %() USE(alloc, bare, default_rc, expected_ft, MUTABLE binary_op_mutable, MUTABLE self) -> {
    IF default_rc THEN
      RETURN mIRLowering__hoist_alloc(&self, UNWRAP (mIRLowering__with_expected_type(&self, expected_ft, %() USE(MUTABLE binary_op_mutable, MUTABLE self) -> {
        MUTABLE rtoc_lambda_result_613: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(binary_op_mutable.right)));
        rtoc_lambda_result_613
      })), &binary_op_mutable.right, TRUE);
    ELSE
      MUTABLE default_mir: ?Emittable = mIRLowering__with_expected_type(&self, bare, %() USE(MUTABLE binary_op_mutable, MUTABLE self) -> {
        MUTABLE rtoc_lambda_result_614: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(binary_op_mutable.right)));
        rtoc_lambda_result_614
      });
      RETURN TRY (mIRLowering__hoist_alloc(&self, mIRLowering__compose_capability_wrap(self, UNWRAP (default_mir), TRY (type__zig_type(bare)), UNWRAP (expected_ft), alloc), &binary_op_mutable.right, TRUE));
    END
    NIL
          }));
          MUTABLE still_live = IF mIRLowering__kept_store_liveness(&self) THEN
            !({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_616 = UNWRAP (mIRLowering__kept_store_liveness(&self));
          keptEdgeLiveness__last_use?(rtoc_local_receiver_616, identifier_mutable) })
          ELSE
            FALSE
          END;
          MUTABLE handle_type = TRY (type__new(TypeConstructionInput{ StringValue: COPY CAST((type__resolved((TRY (type__bare_data_type( UNWRAP (expected_ft)))))) AS String) }, :multiowned, NIL, NIL, :heap));
          IF still_live THEN
            MUTABLE payload = TRY (type__zig_type((TRY (type__bare_data_type( UNWRAP (expected_ft))))));
            MUTABLE capture = "__keep_val_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_617 = mIRLowering__lowering_counters(&self);
            mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_617)) }}";
            MUTABLE provided = RcRetain{ source: Emittable{ Ident: COPY Ident{ name: COPY capture, lowered_node_id: NIL, ownership_consumption: NIL } }, zig_base: COPY payload, func: "rcRetain", lowered_node_id: NIL, ownership_consumption: NIL };
            MUTABLE out = IfOptional{ optional: Emittable{ Ident: COPY Ident{ name: mIRLowering__zig_safe_name(self, identifier__name(identifier_mutable)), lowered_node_id: NIL, ownership_consumption: NIL } }, capture: COPY capture, then_expr: Emittable{ RcRetain: COPY provided }, else_expr: COPY wrapped, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
            out.result_type = handle_type;
            RETURN Emittable{ IfOptional: COPY out };
          ELSE
            MUTABLE out_orelse = Orelse{ expr: Emittable{ Ident: COPY Ident{ name: mIRLowering__zig_safe_name(self, identifier__name(identifier_mutable)), lowered_node_id: NIL, ownership_consumption: NIL } }, fallback: COPY wrapped, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
            out_orelse.result_type = handle_type;
            TRY (mIRLowering__move_mark_field_mut(&self, Locatable{ Identifier: COPY identifier_mutable }));
            RETURN TRY (mIRLowering__with_ownership_consumption(&self, Emittable{ Orelse: COPY out_orelse }, [mIRLowering__zig_safe_name(self, identifier__name(identifier_mutable))], "kept optional field store", :owned_sink, alloc));
          END
        ELSE
          RETURN NIL;
        END
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
END
PRIVATE FN mIRLowering__move_mark_field_mut(MUTABLE self: MIRLowering, v: Locatable) RETURNS !Void ->
    IF v IS_A Identifier AS identifier THEN
      MUTABLE identifier_mutable = COPY identifier;
      MUTABLE ti = TRY (aST__full_type_mut( Locatable{ Identifier: COPY identifier_mutable }));
      MUTABLE tracked = ((((TRUE AND !(type__primitive?(ti))) AND !(type__void?(ti))) AND !(type__any?(ti))) AND ((((TRY (type__string?(ti)) OR TRY (type__heap_ptr?(ti))) OR TRY (type__collection_value?(ti))) OR TRY (type__recursive_cleanup_shape?(ti, mIRLowering__mir_schema_lookup(&self))))));
      IF !(tracked) THEN
        RETURN;
      END
      MUTABLE nm = mIRLowering__zig_safe_name(self, identifier__name(identifier_mutable));
      MUTABLE rename_map = TRY (functionState__rename_map(mIRLowering__function_state(&self)));
      nm = COPY (rename_map[nm] OR_ELSE nm);
      MUTABLE entry = ((TRY (functionState__bindings(mIRLowering__function_state(&self))))[identifier__name(identifier_mutable)] OR_ELSE cleanupEntry__none());
      IF !(cleanupEntry__present?(entry)) THEN
        RETURN;
      END
      cleanupEntry__mark_moved_guard_mut(&entry);
      MUTABLE rtoc_index_receiver_618 = mIRLowering__function_state(&self).guarded_cleanup_names;
      rtoc_index_receiver_618[nm] = TRUE;
    ELSE
      RETURN;
    END
END
PRIVATE FN mIRLowering__lower_move(MUTABLE self: MIRLowering, MUTABLE node: MoveNode) RETURNS !Emittable ->
    IF node.value IS_A Identifier THEN
      MUTABLE ident = TRY (mIRLowering__lower_identifier(&self, UNWRAP (castLocatableToIdentifier(node.value))));
      MUTABLE type_info: ?Type = TRY (type__from_node_mut(node.value, "GIVE parameter"));
      IF (mIRLowering__current_function_takes_param_name?(&self, UNWRAP (locatable__name(node.value))) AND type__needs_pointer_passing?( UNWRAP (type_info))) THEN
        RETURN Emittable{ Deref: COPY Deref{ expr: COPY ident, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
      RETURN ident;
    ELSE
      RETURN UNWRAP (TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__pipeline_lowering_bridge(node.value))));
    END
END
PRIVATE FN mIRLowering__lower_share(MUTABLE self: MIRLowering, MUTABLE node: ShareNode) RETURNS !Emittable ->
    MUTABLE source: ?Emittable = NIL;
    MUTABLE zig_base: String = "";
    MUTABLE source_ti = TRY (aST__full_type_mut(node.value));
    IF (TRUE AND !(TRUE)) THEN
      source_ti = TRY (type__new(TypeConstructionInput{ Type: COPY source_ti }));
    END
    IF (type__optional?(source_ti) AND ((TRY (type__wrapped_type(source_ti)) != NIL) AND TRY (type__any_rc?((UNWRAP (TRY (type__wrapped_type(source_ti)))))))) THEN
      MUTABLE wrapped = UNWRAP (TRY (type__wrapped_type(source_ti)));
