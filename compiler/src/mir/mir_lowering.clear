PRIVATE FN mIRLowering__intrinsic_owned_result_alloc(MUTABLE self: MIRLowering, entry: FunctionSignature, node: Node, alloc_metadata: InlineAllocMetadata, result_ownership_bearing: Bool) RETURNS !?String@symbol ->
