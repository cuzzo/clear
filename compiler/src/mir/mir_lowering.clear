FN ruby_union_scalar_equal_TypeTypeInput_String_symbol(value: TypeTypeInput, expected: String@symbol) RETURNS Bool ->
  IF value IS_A String@symbol AS equality_payload THEN
    RETURN equality_payload == expected;
  END
  FALSE;
END
FN ruby_union_scalar_equal_Value_Int64(value: Value, expected: Int64) RETURNS Bool ->
  IF value IS_A Int64 AS equality_payload THEN
    RETURN equality_payload == expected;
  END
  FALSE;
END
FN ruby_union_scalar_equal_optional_CoerceTypeInput_String_symbol(value: ?CoerceTypeInput, expected: String@symbol) RETURNS Bool ->
  IF value EXISTS AS equality_value THEN
    IF equality_value IS_A String@symbol AS equality_payload THEN
      RETURN equality_payload == expected;
    END
  END
  FALSE;
END
FN ruby_wrap_optional_Emittable_MIRLoweringLoweredMir(value: ?Emittable) RETURNS ?MIRLoweringLoweredMir ->
