# Ruby interpolates this value directly; each variant renders the
# way Ruby renders it.
PUB FN mIRLoweringBackgroundDispatch__to_s(value: MIRLoweringBackgroundDispatch) RETURNS String ->
  PARTIAL MATCH value START
    MIRLoweringBackgroundDispatch.SymbolValue AS item -> RETURN COPY item;,
    MIRLoweringBackgroundDispatch.BoolValue AS item -> RETURN item.toString();,
  END
  RETURN "";
END

FN castCallNodeToLocatable(value: CallNode) RETURNS Locatable ->
  PARTIAL MATCH value START
    CallNode.FuncCall AS cast_payload -> RETURN Locatable{ FuncCall: COPY cast_payload };,
    CallNode.MethodCall AS cast_payload -> RETURN Locatable{ MethodCall: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Locatable");
  END
  panic("Invalid cast to Locatable");
END

# Ruby asks `respond_to?(:cleanup_entry)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN mIRLoweringReturnValue__cleanup_entry(value: MIRLoweringReturnValue) RETURNS ?CleanupEntry@multiowned ->
  PARTIAL MATCH value START
    MIRLoweringReturnValue.Cleanup AS item -> RETURN COPY item.cleanup_entry;,
    MIRLoweringReturnValue.ErrCleanup AS item -> RETURN COPY item.cleanup_entry;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END

# Ruby asks `respond_to?(:protocol_receiver_index)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN callNode__protocol_receiver_index(value: CallNode) RETURNS ?Int64 ->
  PARTIAL MATCH value START
    CallNode.FuncCall AS item -> RETURN COPY item.protocol_receiver_index;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END

# Same layering fix as the scan-root cast: the helper belongs with the
# union it builds, not in ast.clear which sits below mir.

# The schema's variant value and a struct-literal field type carry the same
# six shapes under two names; this is the bridge between them.
FN castSchemasUnionSchemaVariantValueToStructLitFieldType(value: SchemasUnionSchemaVariantValue) RETURNS StructLitFieldType ->
  PARTIAL MATCH value START
    SchemasUnionSchemaVariantValue.FunctionType AS rtoc_payload -> RETURN StructLitFieldType{ FunctionType: COPY rtoc_payload };,
    SchemasUnionSchemaVariantValue.TypeMultiowned AS rtoc_payload -> RETURN StructLitFieldType{ TypeMultiowned: COPY rtoc_payload };,
    SchemasUnionSchemaVariantValue.SymbolValue AS rtoc_payload -> RETURN StructLitFieldType{ SymbolValue: COPY rtoc_payload };,
    SchemasUnionSchemaVariantValue.StringValue AS rtoc_payload -> RETURN StructLitFieldType{ StringValue: COPY rtoc_payload };,
    SchemasUnionSchemaVariantValue.InlineStructVariantMultiowned AS rtoc_payload -> RETURN StructLitFieldType{ InlineStructVariantMultiowned: COPY rtoc_payload };,
    SchemasUnionSchemaVariantValue.Type AS rtoc_payload -> RETURN StructLitFieldType{ Type: COPY rtoc_payload };,
    DEFAULT -> PASS;
  END
  panic("union schema variant has no struct-literal field type");
END
