PRIVATE FN mIRLowering__var_decl_materialization_plan(self: MIRLowering, MUTABLE node: VarDecl, facts: VarDeclFacts, safe_name: String, init: Emittable, let_node: Let) RETURNS MaterializationPacket
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF facts.has_mir_drop THEN
      RETURN mIRLowering__classified_cleanup_var_decl_plan(rtoc_self_view, &node, facts, safe_name, init, let_node);
    END
    IF (mIRLowering__owned_return_call_init?(rtoc_self_view, init) AND !(facts.generic_id)) THEN
      RETURN mIRLowering__owned_return_call_var_decl_plan(rtoc_self_view, &node, facts, safe_name, init, let_node);
    END
    IF mIRLowering__transfer_only_var_decl?(rtoc_self_view, facts, init) THEN
      RETURN mIRLowering__transfer_only_var_decl_plan(rtoc_self_view, node, facts, safe_name, init, let_node);
    END
    IF mIRLowering__mutated_owned_var_decl?(rtoc_self_view, facts, init) THEN
      RETURN mIRLowering__mutated_owned_var_decl_plan(rtoc_self_view, &node, facts, safe_name, init, let_node);
    END
    IF ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_663 = (KEEP facts.binding_entry);
    cleanupEntry__present?(rtoc_local_receiver_663) } AND !({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_664 = (KEEP facts.binding_entry);
    cleanupEntry__needs_cleanup?(rtoc_local_receiver_664) })) THEN
      RETURN mIRLowering__binding_metadata_var_decl_plan(rtoc_self_view, node, facts, safe_name, init, let_node);
    END
    IF (mIRLowering__mir_allocates?(rtoc_self_view, init) AND !(facts.generic_id)) THEN
      RETURN mIRLowering__allocating_init_var_decl_plan(rtoc_self_view, &node, facts, safe_name, init, let_node);
    END
    RETURN materializationPacket__value_only(Stmt{ Emittable: Emittable{ Let: COPY let_node } });
}
END
PRIVATE FN mIRLowering__classified_cleanup_var_decl_plan(self: MIRLowering, MUTABLE node: VarDecl, facts: VarDeclFacts, safe_name: String, init: Emittable, let_node: Let) RETURNS !MaterializationPacket
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE drop_entry = COPY KEEP facts.binding_entry;
    TRY (mIRLowering__build_drop_entry_mut(rtoc_self_view, &drop_entry, TRY (aST__full_type_mut(node)), node));
    IF TRY (type__bounded_stream?(facts.ft)) THEN
      drop_entry = cleanupEntry__with_moved_guard(drop_entry);
    END
    MUTABLE init_effect = ownershipEffect__of(init);
    MUTABLE node_alloc = IF placement__explicit_heap?(facts.decl_alloc) THEN
      :heap
    ELSE
      (((IF init_effect.alloc != NIL THEN init_effect.alloc ELSE (KEEP facts.init_ownership_effect).alloc END) OR_ELSE cleanupEntry__alloc(drop_entry)))
    END;
    drop_entry = cleanupEntry__with_alloc(drop_entry, node_alloc);
    MUTABLE rtoc_index_receiver_665 = TRY (functionState__bindings(mIRLowering__function_state(rtoc_self_view)));
    rtoc_index_receiver_665[CAST(node.name AS String)] = drop_entry;
    IF cleanupEntry__has_moved_guard?(drop_entry) THEN
      mIRLowering__mark_guarded_cleanup_name_mut(rtoc_self_view, safe_name);
    END
    RETURN materializationPacket__owned(mIRLowering__var_decl_alloc_mark(rtoc_self_view, safe_name, node_alloc, facts.ft, drop_entry), Stmt{ Emittable: Emittable{ Let: COPY let_node } }, Stmt{ Emittable: COPY CAST(Cleanup{ name: COPY safe_name, cleanup_entry: drop_entry, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) });
}
END
PRIVATE FN mIRLowering__owned_return_call_var_decl_plan(self: MIRLowering, MUTABLE node: VarDecl, facts: VarDeclFacts, safe_name: String, init: Emittable, let_node: Let) RETURNS !MaterializationPacket
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE mir_alloc = (mIRLowering__mir_owned_alloc(rtoc_self_view, init) OR_ELSE facts.decl_alloc);
    MUTABLE cleanup_entry = (mIRLowering__hoist_cleanup_entry(rtoc_self_view, init, Locatable{ VarDecl: COPY node }) OR_ELSE cleanupEntry__build(:uniform, mir_alloc, TRUE));
    TRY (mIRLowering__build_drop_entry_mut(rtoc_self_view, &cleanup_entry, TRY (aST__full_type_mut(node)), node));
    cleanupEntry__mark_moved_guard_mut(&cleanup_entry);
    mIRLowering__mark_guarded_cleanup_name_mut(rtoc_self_view, safe_name);
    RETURN materializationPacket__owned(mIRLowering__var_decl_alloc_mark(rtoc_self_view, safe_name, mir_alloc, facts.ft, KEEP facts.binding_entry), Stmt{ Emittable: Emittable{ Let: COPY let_node } }, Stmt{ Emittable: COPY CAST(Cleanup{ name: COPY safe_name, cleanup_entry: cleanup_entry, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) });
}
END
PRIVATE FN mIRLowering__transfer_only_var_decl?(self: MIRLowering, facts: VarDeclFacts, init: Emittable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ((!(facts.heap_return_var) AND mIRLowering__owned_return_transfer_binding?(rtoc_self_view, KEEP facts.binding_entry, init)) AND !(facts.generic_id));
}
END
PRIVATE FN mIRLowering__transfer_only_var_decl_plan(self: MIRLowering, node: VarDecl, facts: VarDeclFacts, safe_name: String, init: Emittable, let_node: Let) RETURNS MaterializationPacket
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE mir_alloc = (mIRLowering__mir_owned_alloc(rtoc_self_view, init) OR_ELSE facts.decl_alloc);
    RETURN materializationPacket__owned(mIRLowering__var_decl_alloc_mark(rtoc_self_view, safe_name, mir_alloc, facts.ft, KEEP facts.binding_entry), Stmt{ Emittable: Emittable{ Let: COPY let_node } });
}
END
PRIVATE FN mIRLowering__mutated_owned_var_decl?(self: MIRLowering, facts: VarDeclFacts, init: Emittable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (((({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_666 = (KEEP facts.binding_entry);
    cleanupEntry__present?(rtoc_local_receiver_666) } AND !({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_667 = (KEEP facts.binding_entry);
    cleanupEntry__needs_cleanup?(rtoc_local_receiver_667) })) AND facts.actually_mutated) AND lifecyclePlan__needs_drop?((UNWRAP (mIRLowering__lifecycle_registry(rtoc_self_view)[facts.ft])))) AND (((!(TRY (type__string?(facts.ft))) OR mIRLowering__mir_allocates?(rtoc_self_view, init)) OR mIRLowering__owned_return_call_init?(rtoc_self_view, init))));
}
END
PRIVATE FN mIRLowering__mutated_owned_var_decl_plan(self: MIRLowering, MUTABLE node: VarDecl, facts: VarDeclFacts, safe_name: String, init: Emittable, let_node: Let) RETURNS !MaterializationPacket
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE mir_alloc = (mIRLowering__mir_owned_alloc(rtoc_self_view, init) OR_ELSE { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_668 = (KEEP facts.binding_entry);
    cleanupEntry__alloc(rtoc_local_receiver_668) });
    MUTABLE cleanup_entry = cleanupEntry__build(IF TRY (type__string?(facts.ft)) THEN
      :heap_string
    ELSE
      :uniform
    END, mir_alloc, TRUE);
    TRY (mIRLowering__build_drop_entry_mut(rtoc_self_view, &cleanup_entry, TRY (aST__full_type_mut(node)), node));
    mIRLowering__mark_guarded_cleanup_name_mut(rtoc_self_view, safe_name);
    RETURN materializationPacket__owned(mIRLowering__var_decl_alloc_mark(rtoc_self_view, safe_name, mir_alloc, facts.ft, KEEP facts.binding_entry), Stmt{ Emittable: Emittable{ Let: COPY let_node } }, Stmt{ Emittable: COPY CAST(Cleanup{ name: COPY safe_name, cleanup_entry: cleanup_entry, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) });
}
END
PRIVATE FN mIRLowering__binding_metadata_var_decl_plan(self: MIRLowering, MUTABLE node: VarDecl, facts: VarDeclFacts, safe_name: String, init: Emittable, let_node: Let) RETURNS MaterializationPacket
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE binding_entry = COPY KEEP facts.binding_entry;
    IF !((mIRLowering__mir_allocates?(rtoc_self_view, init) OR ((placement__heap?(cleanupEntry__alloc(binding_entry)) AND (cleanupEntry__kind(binding_entry) != :none))))) THEN
      RETURN materializationPacket__value_only(Stmt{ Emittable: Emittable{ Let: COPY let_node } });
    END
    MUTABLE mir_alloc = IF placement__explicit_heap?(facts.decl_alloc) THEN
      :heap
    ELSE
      ((mIRLowering__mir_owned_alloc(rtoc_self_view, init) OR_ELSE facts.decl_alloc))
    END;
    MUTABLE alloc_mark = mIRLowering__var_decl_alloc_mark(rtoc_self_view, safe_name, mir_alloc, facts.ft, binding_entry);
    IF !(lifecyclePlan__needs_drop?((UNWRAP (mIRLowering__lifecycle_registry(rtoc_self_view)[facts.ft])))) THEN
      RETURN materializationPacket__owned(alloc_mark, Stmt{ Emittable: Emittable{ Let: COPY let_node } });
    END
    MUTABLE cleanup_entry = mIRLowering__moved_guard_cleanup_entry(rtoc_self_view, facts.ft, mir_alloc, &node);
    mIRLowering__mark_guarded_cleanup_name_mut(rtoc_self_view, safe_name);
    RETURN materializationPacket__owned(alloc_mark, Stmt{ Emittable: Emittable{ Let: COPY let_node } }, Stmt{ Emittable: COPY CAST(Cleanup{ name: COPY safe_name, cleanup_entry: cleanup_entry, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) });
}
END
PRIVATE FN mIRLowering__allocating_init_var_decl_plan(self: MIRLowering, MUTABLE node: VarDecl, facts: VarDeclFacts, safe_name: String, init: Emittable, let_node: Let) RETURNS !MaterializationPacket
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE mir_alloc = (mIRLowering__mir_owned_alloc(rtoc_self_view, init) OR_ELSE facts.decl_alloc);
    MUTABLE alloc_mark = mIRLowering__var_decl_alloc_mark(rtoc_self_view, safe_name, mir_alloc, facts.ft, KEEP facts.binding_entry);
    IF type__rodata?(facts.ft) THEN
      RETURN materializationPacket__value_only(Stmt{ Emittable: Emittable{ Let: COPY let_node } });
    END
    IF !(mIRLowering__type_requires_alloc_cleanup?(rtoc_self_view, facts.ft, mir_alloc)) THEN
      RETURN materializationPacket__owned(alloc_mark, Stmt{ Emittable: Emittable{ Let: COPY let_node } });
    END
    MUTABLE cleanup_entry = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_669 = UNWRAP (mIRLowering__hoist_cleanup_entry(rtoc_self_view, init, Locatable{ VarDecl: COPY node }));
    cleanupEntry__with_alloc(rtoc_local_receiver_669, mir_alloc) };
    TRY (mIRLowering__build_drop_entry_mut(rtoc_self_view, &cleanup_entry, TRY (aST__full_type_mut(node)), node));
    IF cleanupEntry__has_moved_guard?(cleanup_entry) THEN
      mIRLowering__mark_guarded_cleanup_name_mut(rtoc_self_view, safe_name);
    END
    RETURN materializationPacket__owned(alloc_mark, Stmt{ Emittable: Emittable{ Let: COPY let_node } }, Stmt{ Emittable: COPY CAST(Cleanup{ name: COPY safe_name, cleanup_entry: cleanup_entry, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) });
}
END
PRIVATE FN mIRLowering__mark_guarded_cleanup_name_mut(self: MIRLowering, name: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rtoc_index_receiver_670 = mIRLowering__function_state(rtoc_self_view).guarded_cleanup_names;
    rtoc_index_receiver_670[name] = TRUE;
}
END
PRIVATE FN mIRLowering__moved_guard_cleanup_entry(self: MIRLowering, ft: Type, alloc: String@symbol, MUTABLE node: VarDecl) RETURNS !CleanupEntry@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE entry = cleanupEntry__build(IF TRY (type__string?(ft)) THEN
      :heap_string
    ELSE
      :uniform
    END, alloc, TRUE);
    TRY (mIRLowering__build_drop_entry_mut(rtoc_self_view, &entry, TRY (aST__full_type_mut(node)), node));
    cleanupEntry__mark_moved_guard_mut(&entry);
    RETURN entry;
}
END
PRIVATE FN mIRLowering__type_requires_alloc_cleanup?(self: MIRLowering, ft: Type, alloc: String@symbol) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE _ = COPY alloc;
    RETURN lifecyclePlan__needs_drop?((UNWRAP (mIRLowering__lifecycle_registry(rtoc_self_view)[ft])));
}
END
PRIVATE FN mIRLowering__var_decl_alloc_mark(self: MIRLowering, name: String, alloc: String@symbol, type_info: Type, binding_entry: CleanupEntry) RETURNS AllocMark
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE mark = AllocMark{ name: COPY name, alloc: COPY alloc, type_info: COPY type_info, scope: COPY IF placement__explicit_heap?(alloc) THEN
      :heap
    ELSE
      (IF cleanupEntry__present?(binding_entry) THEN
      cleanupEntry__scope(binding_entry)
    ELSE
      :iteration
    END)
    END, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    RETURN mark;
}
END
PRIVATE FN mIRLowering__lower_var_decl_init(MUTABLE self: MIRLowering, node: VarDecl, ft: Type, bare_zig: String, has_caps: Bool, decl_alloc: String@symbol) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE placed = NIL;
    IF node.value IS_A NextExpr THEN
      RETURN mIRLowering__lower_next_expr(&rtoc_self_view, node.value, decl_alloc);
    END
    MUTABLE rhs = node.value;
    MUTABLE rhs_unwrapped = IF ((rhs IS_A BinaryOp AND (rhs.op() == symbol("OR_ELSE")))) THEN
      rhs.left()
    ELSE
      rhs
    END;
    IF (rhs IS_A BinaryOp AND (rhs.op() == symbol("OR_ELSE"))) THEN
      placed = mIRLowering__with_expected_type(rtoc_self_view, ft, %() USE(rhs, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_671 = TRY (mIRLowering__lower(&rtoc_self_view, rhs));
    rtoc_lambda_result_671
      });
      RETURN TRY (mIRLowering__place_value_for_destination(rtoc_self_view, placed, rhs, decl_alloc, TypeTypeInput{ Type: COPY ft }));
    END
    IF ((TRY (type__dynamic_rank?(ft)) AND rhs_unwrapped IS_A ListLit) AND rhs_unwrapped.items().empty?()) THEN
      MUTABLE inner = ContainerInit{ zig_type: COPY bare_zig, strategy: :grid_empty, alloc: COPY decl_alloc, capacity: NIL, lowered_node_id: NIL, ownership_consumption: NIL };
      IF has_caps THEN
        RETURN mIRLowering__compose_capability_wrap(rtoc_self_view, Emittable{ ContainerInit: COPY inner }, bare_zig, ft, decl_alloc);
      ELSE
        RETURN Emittable{ ContainerInit: COPY inner };
      END
    END
    IF type__pool?(ft) THEN
      IF ((rhs_unwrapped IS_A MoveNode OR aST__call?(rhs_unwrapped)) OR !(rhs_unwrapped IS_A ListLit)) THEN
        RETURN TRY (mIRLowering__lower(&rtoc_self_view, node.value));
      END
      MUTABLE inner = ContainerInit{ zig_type: COPY bare_zig, strategy: :pool, alloc: COPY decl_alloc, capacity: COPY type__capacity(ft), lowered_node_id: NIL, ownership_consumption: NIL };
      IF has_caps THEN
        RETURN mIRLowering__compose_capability_wrap(rtoc_self_view, Emittable{ ContainerInit: COPY inner }, bare_zig, ft, decl_alloc);
      ELSE
        RETURN Emittable{ ContainerInit: COPY inner };
      END
    END
    IF type__set_collection?(ft) THEN
      IF (rhs IS_A BinaryOp AND rhs.smooth?()) THEN
        RETURN TRY (mIRLowering__lower(&rtoc_self_view, node.value));
      END
      IF ((rhs_unwrapped IS_A MoveNode OR aST__call?(rhs_unwrapped)) OR !(rhs_unwrapped IS_A ListLit)) THEN
        RETURN TRY (mIRLowering__lower(&rtoc_self_view, node.value));
      END
      MUTABLE hint: ?Int64 = type__allocation_hint(ft);
      MUTABLE inner = ContainerInit{ zig_type: COPY bare_zig, strategy: IF hint != NIL THEN
        :set_capacity
      ELSE
        :set_empty
      END, alloc: COPY decl_alloc, capacity: COPY hint, lowered_node_id: NIL, ownership_consumption: NIL };
      IF has_caps THEN
        RETURN mIRLowering__compose_capability_wrap(rtoc_self_view, Emittable{ ContainerInit: COPY inner }, bare_zig, ft, decl_alloc);
      ELSE
        RETURN Emittable{ ContainerInit: COPY inner };
      END
    END
    IF type__list_collection?(ft) THEN
      IF rhs_unwrapped IS_A MoveNode THEN
        RETURN TRY (mIRLowering__lower(&rtoc_self_view, node.value));
      END
      IF rhs_unwrapped IS_A NextExpr THEN
        RETURN mIRLowering__lower_next_expr(&rtoc_self_view, rhs_unwrapped, decl_alloc);
      END
      IF aST__call?(rhs_unwrapped) THEN
        RETURN TRY (mIRLowering__lower(&rtoc_self_view, node.value));
      END
      IF ((rhs_unwrapped IS_A CopyNode AND rhs_unwrapped.own()) AND TRY (type__any_rc?(rhs_unwrapped.value().full_type_mut("OWN COPY collection source")))) THEN
        RETURN TRY (mIRLowering__lower(&rtoc_self_view, rhs_unwrapped));
      END
      IF mIRLowering__list_collection_copy?(rtoc_self_view, rhs_unwrapped) THEN
        RETURN Emittable{ DeepCopy: COPY DeepCopy{ source: COPY TRY (mIRLowering__lower(&rtoc_self_view, rhs_unwrapped.value())), zig_type: COPY TRY (type__zig_type(ft)), elem_type: NIL, strategy: :full_value, alloc: COPY decl_alloc, copy_shape: NIL, type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
      IF !(rhs_unwrapped IS_A ListLit) THEN
        RETURN TRY (mIRLowering__lower(&rtoc_self_view, node.value));
      END
      IF !(rhs_unwrapped.items().empty?()) THEN
        RETURN mIRLowering__with_expected_type(rtoc_self_view, ft, %() USE(node, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_672 = TRY (mIRLowering__lower(&rtoc_self_view, node.value));
    rtoc_lambda_result_672
        });
      END
      MUTABLE init_capacity: ?Int64 = type__allocation_hint(ft);
      MUTABLE init_kind = IF init_capacity != NIL THEN
        :list_capacity
      ELSE
        :array_list_empty
      END;
      MUTABLE inner = ContainerInit{ zig_type: COPY bare_zig, strategy: COPY init_kind, alloc: COPY decl_alloc, capacity: COPY init_capacity, lowered_node_id: NIL, ownership_consumption: NIL };
      IF has_caps THEN
        RETURN mIRLowering__compose_capability_wrap(rtoc_self_view, Emittable{ ContainerInit: COPY inner }, bare_zig, ft, decl_alloc);
      ELSE
        RETURN Emittable{ ContainerInit: COPY inner };
      END
    END
    IF type__fixed_soa?(ft) THEN
      MUTABLE inner = ContainerInit{ zig_type: COPY bare_zig, strategy: :list_capacity, alloc: COPY decl_alloc, capacity: COPY type__capacity(ft), lowered_node_id: NIL, ownership_consumption: NIL };
      IF has_caps THEN
        RETURN mIRLowering__compose_capability_wrap(rtoc_self_view, Emittable{ ContainerInit: COPY inner }, bare_zig, ft, decl_alloc);
      ELSE
        RETURN Emittable{ ContainerInit: COPY inner };
      END
    END
    MUTABLE retain_source = mIRLowering__var_decl_retain_source(rtoc_self_view, node.value);
    IF ((IF retain_source IS_A Identifier AS identifier THEN (node.value.was_moved() != TRUE) ELSE FALSE END) AND TRY (mIRLowering__rc_retain_needed?(rtoc_self_view, retain_source))) THEN
      RETURN Emittable{ RcRetain: COPY TRY (mIRLowering__make_rc_retain(&rtoc_self_view, castLocatableToIdentifier(retain_source))) };
    END
    MUTABLE wraps_value = (has_caps AND !(mIRLowering__source_already_has_declared_capability?(rtoc_self_view, node.value, ft)));
    MUTABLE value_ft_branch_value: ?Type = NIL;
    IF wraps_value THEN
      value_ft_branch_value = TRY (type__bare_data_type((TRY (type__non_optional_type(ft)))));
    ELSE
      value_ft_branch_value = COPY ft;
    END
    MUTABLE value_ft: Type = value_ft_branch_value?;
    placed = mIRLowering__with_expected_type(rtoc_self_view, value_ft, %() USE(node, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_673 = TRY (mIRLowering__lower(&rtoc_self_view, node.value));
    rtoc_lambda_result_673
    });
    placed = TRY (mIRLowering__place_value_for_destination(rtoc_self_view, placed, node.value, decl_alloc, TypeTypeInput{ Type: COPY value_ft }));
    IF (wraps_value AND mIRLowering__borrowed_wrap_source?(rtoc_self_view, &node.value)) THEN
      placed = DeepCopy{ source: COPY placed, zig_type: COPY mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ Type: COPY value_ft }), elem_type: NIL, strategy: :full_value, alloc: COPY decl_alloc, copy_shape: NIL, type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL };
    END
    IF (wraps_value AND !(mIRLowering__capability_wrapped_mir?(rtoc_self_view, placed))) THEN
      RETURN mIRLowering__compose_capability_wrap(rtoc_self_view, placed, bare_zig, ft, decl_alloc);
    ELSE
      RETURN placed;
    END
}
END
PRIVATE FN mIRLowering__borrowed_wrap_source?(self: MIRLowering, MUTABLE value: ?Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((value != NIL)) THEN
      RETURN FALSE;
    END
    MUTABLE source = &value.full_type_mut("carrier wrap source");
    IF TRY (type__any_rc?(source)) THEN
      RETURN FALSE;
    END
    RETURN type__borrowed_reference?(source);
}
CATCH Transient, Input, System, NotFound, Permission, Canceled
  RETURN FALSE;
END
PRIVATE FN mIRLowering__var_decl_retain_source(self: MIRLowering, value: Locatable) RETURNS Locatable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF value IS_A MoveNode AS move_node THEN
      RETURN COPY move_node.value;
    END
    RETURN COPY value;
}
END
PRIVATE FN mIRLowering__capability_wrapped_mir?(self: MIRLowering, node: Emittable) RETURNS Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A CapWrap AS cap_wrap THEN
      RETURN TRUE;
    END
    IF ((node IS_A MIRCast OR node IS_A TryExpr) OR node IS_A TryOptional) THEN
      RETURN mIRLowering__capability_wrapped_mir?(rtoc_self_view, node.expr());
    END
    RETURN FALSE;
}
END
PRIVATE FN mIRLowering__source_already_has_declared_capability?(self: MIRLowering, source_node: Locatable, target_type: Type) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE node: Locatable = COPY source_node;
    WHILE node IS_A Cast DO
      node = node.value();
    END
    IF node IS_A CapabilityWrap AS capability_wrap THEN
      RETURN FALSE;
    END
    MUTABLE inner: Locatable = node;
    WHILE (inner IS_A CopyNode OR inner IS_A KeepNode) DO
      inner = inner.value();
    END
    MUTABLE source_type = TRY (type__from_node_mut(inner, "capability source type"));
    IF !((type__ownership(source_type) == type__ownership(target_type))) THEN
      RETURN FALSE;
    END
    IF !((type__sync(source_type) == type__sync(target_type))) THEN
      RETURN FALSE;
    END
    IF !((type__layout(source_type) == type__layout(target_type))) THEN
      RETURN FALSE;
    END
    IF !((type__shard_count(source_type) == type__shard_count(target_type))) THEN
      RETURN FALSE;
    END
    RETURN TRUE;
}
END
PRIVATE FN mIRLowering__list_collection_copy?(self: MIRLowering, rhs: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (((rhs IS_A CopyNode OR rhs IS_A KeepNode)) AND rhs.value().full_type_mut("collection copy source").list_collection?());
}
END
PRIVATE FN mIRLowering__field_owner_move_marks(self: MIRLowering, node: VarDecl) RETURNS ![]Stmt
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE value = node.value;
    IF !(value IS_A GetField) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_674: []Stmt = List[]; rtoc_empty_list_674 } ) AS []Stmt);
    END
    IF !(mIRLowering__field_access_moves_owner?(rtoc_self_view, &value)) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_675: []Stmt = List[]; rtoc_empty_list_675 } ) AS []Stmt);
    END
    MUTABLE root: ?Identifier = aST__root_identifier(value);
    IF root EXISTS AS root_value THEN
      MUTABLE source_name = COPY root_value.name;
      MUTABLE safe = mIRLowering__zig_safe_name(rtoc_self_view, source_name);
      MUTABLE rename_map = TRY (functionState__rename_map(mIRLowering__function_state(rtoc_self_view)));
      IF rename_map.contains?(safe) THEN
        safe = COPY (rename_map[safe] OR_ELSE "");
      END
      MUTABLE entry = ((TRY (functionState__bindings(mIRLowering__function_state(rtoc_self_view))))[source_name] OR_ELSE new());
      IF !(cleanupEntry__present?(entry)) THEN
        RETURN CAST(( { MUTABLE rtoc_empty_list_676: []Stmt = List[]; rtoc_empty_list_676 } ) AS []Stmt);
      END
      MUTABLE guarded_names = COPY mIRLowering__function_state(rtoc_self_view).guarded_cleanup_names;
      MUTABLE guarded = (cleanupEntry__has_moved_guard?(entry) OR (guarded_names[safe] == TRUE));
      RETURN TRY (mIRLowering__ownership_transfer_marks(rtoc_self_view, safe, :owned_sink, entry.alloc(), guarded));
    ELSE
      RETURN CAST(( { MUTABLE rtoc_empty_list_677: []Stmt = List[]; rtoc_empty_list_677 } ) AS []Stmt);
    END
}
END
PRIVATE FN mIRLowering__field_access_moves_owner?(self: MIRLowering, MUTABLE value: GetField) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF aST__container_borrow?(Locatable{ GetField: COPY value }) THEN
      RETURN FALSE;
    END
    IF aST__moved?(Locatable{ GetField: COPY value }) THEN
      RETURN TRUE;
    END
    IF (TRUE AND (value.indirect_field == TRUE)) THEN
      RETURN TRUE;
    END
    RETURN type__indirect_type?(&value.full_type_mut("field owner move"));
}
END
PRIVATE FN mIRLowering__owned_return_transfer_binding?(self: MIRLowering, binding_entry: CleanupEntry, init: Emittable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF cleanupEntry__needs_cleanup?(binding_entry) THEN
      RETURN FALSE;
    END
    IF !(cleanupEntry__present?(binding_entry)) THEN
      RETURN FALSE;
    END
    IF !((cleanupEntry__heap?(binding_entry) OR (cleanupEntry__alloc(binding_entry) == :cleanup))) THEN
      RETURN FALSE;
    END
    IF init IS_A Call AS call THEN
      RETURN FALSE;
    END
    IF !(respondsTo?(init, "stdlib_def")) THEN
      RETURN FALSE;
    END
    MUTABLE sig: ?FunctionSignature@multiowned = functionSignature__unwrap(init.stdlib_def());
    IF !((IF sig != NIL THEN
      TRY (functionSignature__emits_allocating?(&sig))
    ELSE
      NIL
    END)) THEN
      RETURN FALSE;
    END
    IF TRY (functionSignature__heap_return_alloc?(&sig)) THEN
      RETURN TRUE;
    END
    MUTABLE metadata = IF respondsTo?(init, "allocs") THEN
      init.allocs()
    ELSE
      NIL
    END;
    IF metadata IS_A InlineAllocMetadata THEN
      RETURN (metadata.any_heap?() == TRUE);
    END
    RETURN FALSE;
}
END
PRIVATE FN mIRLowering__owned_return_call_init?(self: MIRLowering, init: ?Emittable) RETURNS Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF init? IS_A MIRCast AS mir_cast THEN
      RETURN mIRLowering__owned_return_call_init?(rtoc_self_view, cast__expr(mir_cast));
    END
    IF (((init != NIL) AND (init IS_A TryExpr)) OR ((init != NIL) AND (init IS_A TryOptional))) THEN
      RETURN mIRLowering__owned_return_call_init?(rtoc_self_view, init.expr());
    END
    RETURN !(!(((IF init? IS_A Call AS call THEN call__owned_return?(call) ELSE FALSE END))));
}
END
PRIVATE FN mIRLowering__cleanup_entry_for_ast_binding(self: MIRLowering, node: Locatable) RETURNS ?CleanupEntry@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(respondsTo?(node, "symbol")) THEN
      RETURN;
    END
    MUTABLE symbol = node.symbol();
    IF !(symbol) THEN
      RETURN;
    END
    MUTABLE decl = symbol.reg();
    IF (decl AND respondsTo?(decl, "mir_binding_entry")) THEN
      MUTABLE entry = decl.mir_binding_entry();
      IF entry THEN
        RETURN entry;
      END
    END
    RETURN NIL;
}
END
PRIVATE FN mIRLowering__lower_bind_expr(MUTABLE self: MIRLowering, MUTABLE node: BindExpr) RETURNS !NodeRoot
