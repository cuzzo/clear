PRIVATE FN mIRLowering__bg_type_plan(self: MIRLowering, MUTABLE node: BgBlock) RETURNS !BgTypePlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
