    MUTABLE future_type = TRY (type__new(TypeConstructionInput{ TypeExpression: COPY TRY (tenseLayer__wrap(future_layer, inner_result_expression)) }));
    MUTABLE shared_result = (future_layer.capabilities.ownership == :shared);
