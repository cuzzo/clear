END
PRIVATE FN mIRLowering__exclusive_lock_sync(self: MIRLowering, context: WithCapabilityBindingContext) RETURNS ?String@symbol ->
    MUTABLE is_param = mIRLowering__with_cap_is_param?(self, context.var_node);
    IF (((COPY context.node).polymorphic OR_ELSE FALSE) AND is_param) THEN
      RETURN NIL;
    ELSE
      RETURN context.var_sync;
    END
END
PRIVATE FN mIRLowering__exclusive_capability_binding(MUTABLE self: MIRLowering, context: WithCapabilityBindingContext) RETURNS ![]Emittable ->
    IF context.needs_sort THEN
      RETURN CAST(List[] AS []Emittable);
    END
    MUTABLE plan = mIRLowering__lock_binding_plan(&self, context, TRY (mIRLowering__exclusive_lock_expr(self, context)), mIRLowering__exclusive_lock_sync(self, context));
    RETURN TRY (mIRLowering__render_lock_binding(&self, plan, Emittable{ LockAcquire: COPY LockAcquire{ lock_expr: COPY plan.lock_expr, lock_sync: plan.lock_sync, fallible: !((plan.clause == NIL)), lowered_node_id: NIL, ownership_consumption: NIL } }));
END
PRIVATE FN mIRLowering__read_locked_capability_binding(MUTABLE self: MIRLowering, context: WithCapabilityBindingContext) RETURNS ![]Emittable ->
    IF context.needs_sort THEN
      RETURN CAST(List[] AS []Emittable);
    END
    MUTABLE is_arc: Bool = symbolEntry__rc_storage?(context.var_storage);
    IF context.resolved_type EXISTS AS context_resolved_type THEN
      is_arc = (is_arc OR TRY (type__any_rc?(context_resolved_type)));
    END
    MUTABLE lock_expr = CapabilityLockTarget{ source: COPY TRY (mIRLowering__with_capability_source_mir(self, context.var_node)), arc_wrapped: is_arc, comptime_arc_unwrap: FALSE, lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE plan = mIRLowering__lock_binding_plan(&self, context, Emittable{ CapabilityLockTarget: COPY lock_expr }, NIL);
    RETURN TRY (mIRLowering__render_lock_binding(&self, plan, Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ CapabilityLockTarget: COPY lock_expr }, method: IF plan.clause != NIL THEN
      "readOrErr"
    ELSE
      "read"
    END, args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }));
END
PRIVATE FN mIRLowering__borrowed_capability_binding(self: MIRLowering, context: WithCapabilityBindingContext) RETURNS ![]Emittable ->
    MUTABLE source_mir = TRY (mIRLowering__with_capability_source_mir(self, context.var_node));
    MUTABLE is_param = mIRLowering__with_cap_is_param?(self, context.var_node);
    MUTABLE safe_alias = mIRLowering__safe_with_capability_alias(self, context.alias_name);
    MUTABLE aliased_value =   IF (COPY context.node).polymorphic THEN
      Emittable{ CapabilityUnwrap: COPY CapabilityUnwrap{ source: COPY source_mir, lowered_node_id: NIL, ownership_consumption: NIL } }
    ELSE_IF TRY (mIRLowering__borrowed_const_param_alias?(self, context, is_param)) THEN
      Emittable{ Deref: COPY Deref{ expr: COPY source_mir, lowered_node_id: NIL, ownership_consumption: NIL } }
    ELSE_IF (IF context.resolved_type != NIL THEN
      TRY (type__non_string_array?( UNWRAP (context.resolved_type)))
    ELSE
      NIL
    END) THEN
      Emittable{ ItemsAccess: COPY ItemsAccess{ expr: COPY source_mir, safe: TRUE, lowered_node_id: NIL, ownership_consumption: NIL } }
    ELSE
      source_mir
    END;
    RETURN CAST([Emittable{ Let: COPY Let{ name: COPY safe_alias, init: COPY aliased_value, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }, Emittable{ Suppress: COPY Suppress{ name: COPY safe_alias, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable);
END
PRIVATE FN mIRLowering__borrowed_const_param_alias?(self: MIRLowering, context: WithCapabilityBindingContext, is_param: Bool) RETURNS !Bool ->
    IF !(is_param) THEN
      RETURN FALSE;
    END
    IF !(((context.var_sync == NIL) OR ((context.var_sync)? == :local))) THEN
      RETURN FALSE;
    END
    MUTABLE sym: ?SymbolEntry = NIL;
    MATCH context.var_node START
      CapabilityVarNode.Identifier AS item ->
        sym = COPY item.symbol;,
      CapabilityVarNode.GetField AS item ->
        sym = COPY item.symbol;,
      CapabilityVarNode.GetIndex AS item ->
        sym = COPY item.symbol;,
    END
    IF sym EXISTS AS sym_value THEN
      IF !(sym_value.mutable) THEN
        MUTABLE source_type = TRY (type__new(TypeConstructionInput{ Type: COPY symbolEntry__type(sym_value) }));
        IF (TRY (type__non_string_array?(source_type)) AND !(type__collection?(source_type))) THEN
          RETURN FALSE;
        END
        RETURN TRUE;
      ELSE
        RETURN FALSE;
      END
    ELSE
      RETURN FALSE;
    END
END
PRIVATE FN mIRLowering__restrict_capability_binding(self: MIRLowering, context: WithCapabilityBindingContext) RETURNS ![]Emittable ->
    IF !(((context.var_sync == NIL) OR ((context.var_sync)? == :local))) THEN
      RETURN CAST(List[] AS []Emittable);
    END
    MUTABLE source_mir = TRY (mIRLowering__with_capability_source_mir(self, context.var_node));
    MUTABLE safe_alias = mIRLowering__safe_with_capability_alias(self, context.alias_name);
    MUTABLE value =   IF (COPY context.node).polymorphic THEN
      Emittable{ CapabilityUnwrap: COPY CapabilityUnwrap{ source: COPY source_mir, lowered_node_id: NIL, ownership_consumption: NIL } }
    ELSE_IF mIRLowering__with_cap_is_param?(self, context.var_node) THEN
      Emittable{ Deref: COPY Deref{ expr: COPY source_mir, lowered_node_id: NIL, ownership_consumption: NIL } }
    ELSE_IF context.cap.alias_mutable THEN
      Emittable{ AddressOf: COPY AddressOf{ expr: COPY source_mir, lowered_node_id: NIL, ownership_consumption: NIL } }
    ELSE
      source_mir
    END;
    MUTABLE stmts: []Emittable = [Emittable{ Let: COPY Let{ name: COPY safe_alias, init: COPY value, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }];
    IF !(((context.var_sync == :local) OR context.cap.alias_mutable)) THEN
      &stmts.append(Emittable{ Suppress: COPY Suppress{ name: COPY safe_alias, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    END
    RETURN stmts;
END
PRIVATE FN mIRLowering__view_capability_binding(self: MIRLowering, context: WithCapabilityBindingContext) RETURNS ![]Emittable ->
    MUTABLE source_mir = TRY (mIRLowering__with_capability_source_mir(self, context.var_node));
    MUTABLE safe_alias = mIRLowering__safe_with_capability_alias(self, context.alias_name);
    MUTABLE rt = (context.resolved_type OR_ELSE TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })));
    MUTABLE inner_t_branch_value: ?Type = NIL;
    IF type__future?(rt) THEN
      inner_t_branch_value = TRY (type__tense_type(rt));
    ELSE
      inner_t_branch_value = rt;
    END
    MUTABLE inner_t: Type = inner_t_branch_value?;
    MUTABLE wrapped_inner: ?Type = TRY (type__wrapped_type(inner_t));
    MUTABLE is_value_shape = ((type__primitive?(inner_t) OR TRY (type__string?(inner_t))) OR (((type__optional?(inner_t) AND (wrapped_inner != NIL)) AND ((type__primitive?(wrapped_inner) OR TRY (type__string?(wrapped_inner)))))));
    MUTABLE wants_release = (!(is_value_shape) AND ((TRY (type__collection_value?(inner_t)) OR !(type__primitive?(inner_t)))));
    MUTABLE view_expr = MIRMethodCall{ receiver: COPY source_mir, method: "view", args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    MUTABLE stmts: []Emittable = [Emittable{ Let: COPY Let{ name: COPY safe_alias, init: Emittable{ MIRMethodCall: COPY view_expr }, mutable: wants_release, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }];
    IF wants_release THEN
      &stmts.append(Emittable{ MIRDeferStmt: COPY MIRDeferStmt{ body: DeferBody{ Emittable: COPY CAST(COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: COPY safe_alias, lowered_node_id: NIL, ownership_consumption: NIL } }, method: "release", args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } AS Emittable) }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    END
    stmts = ruby_array_concat_Emittable__mir_lowering(stmts, TRY (mIRLowering__coop_yield_mir(self)));
    &stmts.append(Emittable{ Suppress: COPY Suppress{ name: COPY safe_alias, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    RETURN stmts;
END
PRIVATE FN mIRLowering__unsafe_foreign_view_binding(self: MIRLowering, context: WithCapabilityBindingContext) RETURNS ![]Emittable ->
    MUTABLE lowerer: MIRLowering@multiowned = CAST(self AS MIRLowering@multiowned);
    MUTABLE length: ?Locatable = COPY context.cap.view_length;
    IF length EXISTS AS length_value THEN
      MUTABLE length_value_mutable = COPY length_value;
      MUTABLE source_mir = TRY (mIRLowering__with_capability_source_mir(self, context.var_node));
      MUTABLE safe_alias = mIRLowering__safe_with_capability_alias(self, context.alias_name);
      MUTABLE view = ForeignSliceView{ pointer: COPY source_mir, count: UNWRAP (COPY TRY (mIRLowering__lower(&lowerer, castLocatableToMIRLoweringLowerableStmt__mir_lowering(length_value_mutable)))), lowered_node_id: NIL, ownership_consumption: NIL };
      RETURN CAST([Emittable{ Let: COPY Let{ name: COPY safe_alias, init: Emittable{ ForeignSliceView: COPY view }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }, Emittable{ Suppress: COPY Suppress{ name: COPY safe_alias, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable);
    ELSE
      panic("Internal: WITH UNSAFE VIEW missing LENGTH expression");
    END
END
PRIVATE FN mIRLowering__coop_yield_mir(self: MIRLowering) RETURNS ![]Emittable ->
    MUTABLE scheduler = FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "CheatHeader", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "scheduler", lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE active_scheduler = FieldGet{ object: Emittable{ FieldGet: COPY scheduler }, field: "active_scheduler", lowered_node_id: NIL, ownership_consumption: NIL };
    RETURN CAST([Emittable{ IfStmt: COPY IfStmt{ cond: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ FieldGet: COPY scheduler }, field: "scheduler_running", lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: [Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ FieldGet: COPY active_scheduler }, method: "drainChannels", args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ FieldGet: COPY active_scheduler }, method: "coopYield", args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL } }] AS []Emittable);
END
PRIVATE FN mIRLowering__snapshot_capability_binding(MUTABLE self: MIRLowering, context: WithCapabilityBindingContext) RETURNS !?SnapshotRead ->
    IF TRY (withCapabilityPlan__mutable_snapshot?((TRY (capabilityPlan__require_for(CAST(COPY context.node AS WithBlock)))))) THEN
      RETURN NIL;
    END
    MUTABLE source_mir = TRY (mIRLowering__with_capability_source_mir(self, context.var_node, TRUE));
    MUTABLE safe_alias = mIRLowering__safe_with_capability_alias(self, context.alias_name);
    MUTABLE guard_var = "__${context.var_name}_snap_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_453 = (CAST(self AS MIRLowering@multiowned));
    mIRLowering__stable_node_suffix(&rtoc_local_receiver_453, Locatable{ WithBlock: COPY context.node }) }}";
    RETURN SnapshotRead{ cell_unwrap: Emittable{ CapabilityUnwrap: COPY CapabilityUnwrap{ source: COPY source_mir, lowered_node_id: NIL, ownership_consumption: NIL } }, rt: COPY context.rt_name, alias_name: COPY safe_alias, guard_var: COPY guard_var, body: COPY List[], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN mIRLowering__materialized_view_capability_bindings(self: MIRLowering, context: WithCapabilityBindingContext) RETURNS ![]WithBindingNode ->
    MUTABLE source_mir = TRY (mIRLowering__with_capability_source_mir(self, context.var_node));
    MUTABLE safe_alias = mIRLowering__safe_with_capability_alias(self, context.alias_name);
    MUTABLE rt = (context.resolved_type OR_ELSE TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })));
    MUTABLE is_collection = (TRY (type__observable_array_future?(rt)) OR type__array?(rt));
    MUTABLE materialize = MIRMethodCall{ receiver: COPY source_mir, method: "materialize", args: [CAST(AllocatorRef{ kind: :heap, lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: TRUE, callable_contract: TRY (callableContract__no_ownership(1)), owned_result_alloc: IF is_collection THEN
      :heap
    ELSE
      NIL
    END, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    IF !(is_collection) THEN
      RETURN CAST([WithBindingNode{ Emittable: COPY CAST(Let{ name: COPY safe_alias, init: Emittable{ MIRMethodCall: COPY materialize }, mutable: TRUE, annotation: NIL, suppression: "_ = &${safe_alias};", alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } AS Emittable) }] AS []WithBindingNode);
    END
    MUTABLE entry = cleanupEntry__build(:uniform, :heap, FALSE);
    # statements() yields Emittable nodes; the caller collects WithBindingNode.
    MUTABLE rtoc_binding_stmts: []Emittable = TRY (bindingMaterialization__statements((BindingMaterialization{ name: COPY safe_alias, expr: Emittable{ MIRMethodCall: COPY materialize }, alloc: :heap, type_info: COPY TRY (type__tense_type(rt)), mutable: TRUE, suppression: "_ = &${safe_alias};", cleanup_entry: entry, scope: :heap, annotation: NIL, cleanup_mode: :normal, ownership_tracked: TRUE })));
    MUTABLE rtoc_binding_nodes: []WithBindingNode = List[];
    FOR rtoc_binding_stmt IN rtoc_binding_stmts DO
      &rtoc_binding_nodes.append(WithBindingNode{ Emittable: COPY rtoc_binding_stmt });
    END
    RETURN rtoc_binding_nodes;
END
PRIVATE FN mIRLowering__with_block_control_label(MUTABLE self: MIRLowering, node: WithBlock, clause: ?ErrorClause) RETURNS ?String ->
    IF clause EXISTS AS clause_value THEN
      IF (((clause_value.action == ErrorActionKind.Pass) OR (clause_value.action == ErrorActionKind.Block))) THEN
        RETURN "__with_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_454 = (CAST(self AS MIRLowering@multiowned));
        mIRLowering__stable_node_suffix(&rtoc_local_receiver_454, Locatable{ WithBlock: COPY node }) }}";
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
END
PRIVATE FN mIRLowering__mutable_snapshot_with?(self: MIRLowering, node: WithBlock) RETURNS !Bool ->
    RETURN TRY (withCapabilityPlan__mutable_snapshot?((TRY (capabilityPlan__require_for(node)))));
END
PRIVATE FN mIRLowering__with_block_body_stmts(MUTABLE self: MIRLowering, MUTABLE node: WithBlock, MUTABLE materialization: WithBindingMaterialization, with_label: ?String) RETURNS ![]Emittable ->
    RETURN mIRLowering__with_capability_alias_maps(&self, &node, %() USE(MUTABLE materialization, MUTABLE node, with_label, MUTABLE self) -> {
    IF TRY (mIRLowering__mutable_snapshot_with?(self, node)) THEN
      withBindingMaterialization__add_binding( &materialization, WithBindingNode{ Emittable: castMIRLoweringCapabilitiesReturnValueToEmittable( CAST(TRY (mIRLowering__emit_snapshot_mutable_call(&self, &node, with_label)) AS MIRLoweringCapabilitiesReturnValue)) });
      RETURN CAST(List[] AS []Emittable);
    ELSE
      MUTABLE lowered_body = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_455 = (CAST(self AS MIRLowering@multiowned));
      TRY (mIRLowering__lower_body(&rtoc_mutable_receiver_455, castLocatableListToMIRLoweringLowerableStmtList(node.body))) };
      RETURN TRY (mIRLowering__wrap_body_with_guard(&self, &node, lowered_body, with_label));
    END
    NIL
    });
END
PRIVATE FN mIRLowering__with_block_borrow_names(self: MIRLowering, MUTABLE node: WithBlock) RETURNS ![]String ->
    RETURN (TRY (mIRLowering__with_capability_specs(self, node)) |> SELECT:? {
    MUTABLE var_node: CapabilityVarNode = COPY castLocatableToCapabilityVarNode(_.var_node);
    (IF var_node IS_A Identifier THEN
        CAST(aST__node_name(castCapabilityVarNodeToLocatable(var_node)) AS String)
      ELSE
        NIL
      END)
    } |> WHERE _ != NIL) |> SELECT UNWRAP (_);
END
PRIVATE FN mIRLowering__with_block_inline_bindings(self: MIRLowering, materialization: WithBindingMaterialization, node: WithBlock) RETURNS !?Emittable ->
    MUTABLE string_bindings = (materialization.bindings |> SELECT:? (  IF _ IS_A String THEN
      _
    ELSE
      NIL
    END) |> WHERE _ != NIL) |> SELECT CAST(UNWRAP (_) AS String) |> WHERE !(_.empty?());
    IF (string_bindings.length() == 0) THEN
      RETURN NIL;
    END
    panic("WITH binding materialization still produced pre-emission Zig text; structural MIR binding nodes are required");
END
PRIVATE FN mIRLowering__structured_with_bindings(self: MIRLowering, materialization: WithBindingMaterialization) RETURNS ![]Emittable ->
    MUTABLE rtoc_out: []Emittable = List[];
    FOR rtoc_binding IN materialization.bindings DO
      PARTIAL MATCH rtoc_binding START
        WithBindingNode.ArrayValue AS rtoc_binding_list -> rtoc_out = (rtoc_out + rtoc_binding_list);,
        WithBindingNode.Emittable AS rtoc_binding_node -> &rtoc_out.append(COPY rtoc_binding_node);,
        DEFAULT -> PASS;
      END
    END
    RETURN rtoc_out;
END
PRIVATE FN mIRLowering__assemble_with_block(self: MIRLowering, MUTABLE node: WithBlock, materialization: WithBindingMaterialization, body_stmts: []Emittable, with_label: ?String) RETURNS !MIRLoweringReturnValue ->
    MUTABLE stmts: []Emittable = List[];
    MUTABLE inline_bindings: ?Emittable = TRY (mIRLowering__with_block_inline_bindings(self, materialization, node));
    IF inline_bindings EXISTS AS inline_bindings_value THEN
      &stmts.append(inline_bindings_value);
    END
    stmts = ruby_array_concat_Emittable__mir_lowering(stmts, TRY (mIRLowering__structured_with_bindings(self, materialization)));
    stmts = ruby_array_concat_Emittable__mir_lowering(stmts, body_stmts);
    IF with_label EXISTS AS with_label_value THEN
      RETURN MIRLoweringReturnValue{ MIRBlockExpr: COPY MIRBlockExpr{ label: COPY with_label_value, body: stmts, lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL } };
    ELSE
      RETURN MIRLoweringReturnValue{ ScopeBlock: COPY ScopeBlock{ body: stmts, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
END
PRIVATE FN mIRLowering__lower_with_block(MUTABLE self: MIRLowering, MUTABLE node: WithBlock) RETURNS !MIRLoweringReturnValue ->
    IF node.arms EXISTS AS arms_value THEN
      MUTABLE arms_value_mutable = COPY arms_value;
      RETURN MIRLoweringReturnValue{ ScopeBlock: COPY TRY (mIRLowering__lower_with_match_block(&self, node)) };
    END
    IF ((node.universal_poly OR_ELSE FALSE) AND ((TRY (mIRLowering__with_capability_specs(self, node))).length() == 1)) THEN
      RETURN MIRLoweringReturnValue{ ScopeBlock: COPY TRY (mIRLowering__lower_polymorphic_universal(&self, &node)) };
    END
    MUTABLE rt_name = mIRLowering__runtime_binding_name(&self);
    MUTABLE clause: ?ErrorClause = COPY CAST(node.lock_error_clause AS ?ErrorClause);
    MUTABLE with_label: ?String = mIRLowering__with_block_control_label(&self, node, clause);
    MUTABLE materialization = TRY (mIRLowering__with_binding_materialization(&self, &node, with_label, rt_name));
    RETURN castMIRLoweringCapabilitiesReturnValueToMIRLoweringReturnValue( CAST(TRY (mIRLowering__assemble_with_block(self, &node, materialization, TRY (mIRLowering__with_block_body_stmts(&self, &node, &materialization, with_label)), with_label)) AS MIRLoweringCapabilitiesReturnValue));
END
PRIVATE FN mIRLowering__with_capability_alias_maps<RESULT>(MUTABLE self: MIRLowering, MUTABLE node: WithBlock, blk: FN() -> RESULT) RETURNS !RESULT
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE prev_locked: ?{String}LockedUnwrapMapValue = COPY mIRLowering__capability_state(&rtoc_self_view).locked_unwrap_map;
  MUTABLE prev_rc: ?{String}String = COPY mIRLowering__capability_state(&rtoc_self_view).rc_unwrap_map;
  MUTABLE prev_alias_alloc: ?{String}?String@symbol = COPY mIRLowering__capability_state(&rtoc_self_view).with_alias_alloc_map;
  MUTABLE prev_alias_owner: ?{String}String = COPY mIRLowering__capability_state(&rtoc_self_view).with_alias_owner_map;
  MUTABLE prev_polymorphic_types: ?{String}String = COPY mIRLowering__capability_state(&rtoc_self_view).polymorphic_alias_type_map;
  DEFER {
  rtoc_self_view.state.capabilities.locked_unwrap_map = prev_locked;
  rtoc_self_view.state.capabilities.rc_unwrap_map = prev_rc;
  rtoc_self_view.state.capabilities.with_alias_alloc_map = prev_alias_alloc;
  rtoc_self_view.state.capabilities.with_alias_owner_map = prev_alias_owner;
  rtoc_self_view.state.capabilities.polymorphic_alias_type_map = prev_polymorphic_types;
  }
  MUTABLE locked_map: {String}LockedUnwrapMapValue = COPY ((prev_locked OR_ELSE {}));
  MUTABLE rc_map: {String}String = COPY ((prev_rc OR_ELSE {}));
  MUTABLE alias_alloc_map: {String}?String@symbol = COPY ((prev_alias_alloc OR_ELSE {}));
  MUTABLE alias_owner_map: {String}String = COPY ((prev_alias_owner OR_ELSE {}));
  MUTABLE polymorphic_types: {String}String = COPY ((prev_polymorphic_types OR_ELSE {}));
  rtoc_self_view.state.capabilities.locked_unwrap_map = locked_map;
  rtoc_self_view.state.capabilities.rc_unwrap_map = rc_map;
  rtoc_self_view.state.capabilities.with_alias_alloc_map = alias_alloc_map;
  rtoc_self_view.state.capabilities.with_alias_owner_map = alias_owner_map;
  rtoc_self_view.state.capabilities.polymorphic_alias_type_map = polymorphic_types;
  FOR _ IN TRY (mIRLowering__with_capability_specs(rtoc_self_view, node)) DO
    MUTABLE var_node: CapabilityVarNode = COPY castLocatableToCapabilityVarNode(_.var_node);
    MUTABLE var_name = COPY _.target_label;
    MUTABLE alias_name = COPY _.alias_name;
    IF _.alias_explicit THEN
        MUTABLE generic_inner = type__generic_type_parameter?(_.resolved_type);
        alias_alloc_map[alias_name] = IF generic_inner THEN
          :heap
        ELSE
          TRY (mIRLowering__placement_for_node(&rtoc_self_view, castCapabilityVarNodeToLocatable(var_node)))
        END;
        alias_owner_map[alias_name] = COPY var_name;
        IF ((node.universal_poly OR_ELSE FALSE) AND generic_inner) THEN
          polymorphic_types[alias_name] = "CheatLib.PolymorphicInner(${type__resolved(_.resolved_type)})";
        END
    END
    IF (_.capability == symbol("EXCLUSIVE")) OR (_.capability == :write_locked_read) THEN
        locked_map[alias_name] = LockedUnwrapMapValue{ BoolValue: TRUE };
        IF (alias_name != var_name) THEN
          locked_map[var_name] = LockedUnwrapMapValue{ StringValue: COPY alias_name };
        END
    ELSE_IF (_.capability == :multiowned) OR (_.capability == :shared) THEN
        rc_map[var_name] = "__${var_name}_unwrap";
    END
  END
  RETURN blk();
}
END
PRIVATE FN mIRLowering__build_fallible_clause_mir(MUTABLE self: MIRLowering, var_name: String, alias_name: String, clause: ErrorClause) RETURNS !FallibleClauseFact ->
    MUTABLE action_mir: []Emittable = List[];
    MUTABLE exit_msg_mir: ?Emittable = NIL;
    IF (clause.action == ErrorActionKind.Block) THEN
      action_mir = TRY (mIRLowering__lower_body(&self, castLocatableListToMIRLoweringLowerableStmtList(clause.body)));
    ELSE_IF (clause.action == ErrorActionKind.Exit) THEN
      exit_msg_mir = TRY (mIRLowering__lower(&self, castNodeToMIRLoweringLowerableStmt(castLocatableToNode(UNWRAP (clause.message)))));
    END
    RETURN FallibleClauseFact{ var_name: COPY var_name, alias_name: COPY alias_name, action_kind: COPY clause.action, retries: clause.retries, matched_types: COPY clause.matched_types, bubble_types: COPY clause.bubble_types, action_mir: COPY action_mir, exit_msg_mir: COPY exit_msg_mir };
END
PRIVATE FN mIRLowering__lower_with_match_block(MUTABLE self: MIRLowering, node: WithBlock) RETURNS !ScopeBlock ->
    MUTABLE cap = withCapabilityPlan__first_transition((TRY (capabilityPlan__require_for(node))));
    MUTABLE var_node: CapabilityVarNode = COPY castLocatableToCapabilityVarNode(cap.var_node);
    MUTABLE cell = TRY (mIRLowering__with_capability_source_mir(self, var_node, TRUE));
    MUTABLE alias_name = COPY cap.alias_name;
    MUTABLE safe_alias = mIRLowering__safe_with_capability_alias(self, alias_name);
    MUTABLE snapshot_mode = !(!(((TRUE AND node.snapshot_mode))));
    MUTABLE arms_meta = UNWRAP (node.arms) |> SELECT MIRWithMatchArm{ family: COPY _.family, guard_var: "__${alias_name}_match_${mIRLowering__stable_node_suffix(&self, Locatable{ WithBlock: COPY node })}", body: COPY TRY (mIRLowering__lower_body(&self, castLocatableListToMIRLoweringLowerableStmtList(_.body))) };
    RETURN ScopeBlock{ body: [Emittable{ WithMatchDispatch: COPY WithMatchDispatch{ cell: COPY cell, alias_name: COPY safe_alias, snapshot_mode: snapshot_mode, rt_name: mIRLowering__runtime_binding_name(&self), arms: arms_meta, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN mIRLowering__lower_polymorphic_universal(MUTABLE self: MIRLowering, MUTABLE node: WithBlock) RETURNS !ScopeBlock ->
    MUTABLE cap = withCapabilityPlan__first_transition((TRY (capabilityPlan__require_for(node))));
    MUTABLE var_node: CapabilityVarNode = COPY castLocatableToCapabilityVarNode(cap.var_node);
    MUTABLE var_name = COPY cap.target_label;
    MUTABLE alias_name = COPY cap.alias_name;
    MUTABLE safe_alias = mIRLowering__zig_safe_name(self, alias_name);
    MUTABLE cell_mir = AddressOf{ expr: COPY TRY (mIRLowering__with_capability_source_mir(self, var_node, TRUE)), lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE resolved_source = COPY cap.resolved_type;
    MUTABLE rt_obj: ?Type = TRY (type__from_node_mut( CAST(resolved_source AS ?Locatable), "WITH polymorphic capability resolved type"));
    MUTABLE generic_inner = type__generic_type_parameter?( UNWRAP (rt_obj));
    MUTABLE bare_type: String = COPY UNWRAP ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_468: ?String = NIL;
    IF generic_inner THEN
      rtoc_ternary_value_468 = "CheatLib.PolymorphicInner(${type__resolved( UNWRAP (rt_obj))})";
    ELSE
      rtoc_ternary_value_468 = COPY CAST(TRY (type__bare_data_type( UNWRAP (rt_obj))) AS String);
    END
    rtoc_ternary_value_468 });
    MUTABLE body_mir = TRY (mIRLowering__with_capability_alias_maps(&self, &node, %() USE(node, MUTABLE self) -> {
    rtoc_lambda_result_469 = TRY (mIRLowering__lower_body(&self, castLocatableListToMIRLoweringLowerableStmtList(node.body)));
    rtoc_lambda_result_469
    }));
    MUTABLE guard_cond: ?Emittable = TRY (mIRLowering__combined_guard_cond(&self, node));
    IF TRY (mIRLowering__polymorphic_flow_required?(self, &node)) THEN
      MUTABLE guard_fail = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_471: ?[]Emittable = NIL;
      IF guard_cond != NIL THEN
        rtoc_ternary_value_471 = TRY (mIRLowering__guard_fail_flow_body(&self, node));
      ELSE
        rtoc_ternary_value_471 = List[];
      END
      rtoc_ternary_value_471? };
      RETURN ScopeBlock{ body: [Emittable{ PolymorphicMutateFlow: COPY PolymorphicMutateFlow{ cell: Emittable{ AddressOf: COPY cell_mir }, rt: mIRLowering__runtime_binding_name(&self), alias_name: COPY safe_alias, bare_type: bare_type, return_type: COPY mIRLowering__current_function_return_payload_zig(&self), body: COPY body_mir, guard_cond: COPY UNWRAP (guard_cond), guard_fail_body: guard_fail, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    ELSE
      body_mir = TRY (mIRLowering__wrap_body_with_guard(&self, &node, body_mir, NIL));
      RETURN ScopeBlock{ body: [Emittable{ PolymorphicMutate: COPY PolymorphicMutate{ cell: Emittable{ AddressOf: COPY cell_mir }, rt: mIRLowering__runtime_binding_name(&self), alias_name: COPY safe_alias, bare_type: bare_type, body: COPY body_mir, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    END
END
PRIVATE FN mIRLowering__polymorphic_flow_required?(self: MIRLowering, MUTABLE node: WithBlock) RETURNS !Bool ->
    IF TRY (mIRLowering__with_capability_specs(self, node)) |> ANY (_.guard_expr != NIL) THEN
      RETURN TRUE;
    END
    RETURN mIRLowering__ast_contains_return?(self, AstReturnSearchNode{ ArrayValue: node.body |> SELECT castLocatableToNode__mir_lowering(_) });
END
PRIVATE FN mIRLowering__ast_contains_return?(self: MIRLowering, node: ?AstReturnSearchNode) RETURNS Bool ->
    MUTABLE root: ?AstReturnSearchNode = COPY node;
    MUTABLE found: Bool = FALSE;
    aST__each_locatable_list(castOptionalAstReturnSearchNodeToAnyMultiowned(root), FALSE, %(candidate: Locatable) -> {
    IF candidate IS_A ReturnNode AS return_node THEN
        found = TRUE;
    END
    rubyToClearVoid__mir_lowering()
    });
    RETURN found;
END
PRIVATE FN mIRLowering__guard_fail_flow_body(MUTABLE self: MIRLowering, node: WithBlock) RETURNS ![]Emittable ->
    MUTABLE clause: ?ErrorClause = COPY CAST(node.lock_error_clause AS ?ErrorClause);
    IF clause EXISTS AS clause_value THEN
      MUTABLE clause_value_mutable = COPY clause_value;
      IF clause_value_mutable.matched_types.contains?(:GuardFail) THEN
        MUTABLE line: String = node.token.line.toString();
        MUTABLE result: []Emittable = List[];
        IF (clause_value_mutable.action == ErrorActionKind.Return) THEN
          &result.append(Emittable{ ReturnStmt: COPY ReturnStmt{ value: COPY TRY (mIRLowering__lower(&self, castOptionalLocatableToMIRLoweringLowerableStmt(clause_value_mutable.value))), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
        ELSE_IF (clause_value_mutable.action == ErrorActionKind.Raise) THEN
          &result.append(Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: mIRLowering__runtime_binding_name(&self), lowered_node_id: NIL, ownership_consumption: NIL } }, method: "setError", args: [CAST(EnumTag{ variant: "Transient" } AS Any), CAST(EnumOrdinal{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "ErrorName", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "GuardFail", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } AS Any), CAST(Lit{ value: COPY mIRLowering__zig_string_lit(self, "WITH GUARD predicate failed"), lowered_node_id: NIL, ownership_consumption: NIL } AS Any), CAST(Lit{ value: COPY line, lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(4)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
          &result.append(Emittable{ PolymorphicFlowSignal: COPY PolymorphicFlowSignal{ kind: :raise_no_commit, ret: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
        ELSE_IF (clause_value_mutable.action == ErrorActionKind.Exit) THEN
          MUTABLE msg_mir: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(UNWRAP (clause_value_mutable.message))));
          &result.append(Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: mIRLowering__runtime_binding_name(&self), lowered_node_id: NIL, ownership_consumption: NIL } }, method: "setError", args: [CAST(EnumTag{ variant: "Transient" } AS Any), CAST(EnumOrdinal{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "ErrorName", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "GuardFail", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } AS Any), CAST(msg_mir AS Any), CAST(Lit{ value: COPY line, lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(4)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
          &result.append(Emittable{ PolymorphicFlowSignal: COPY PolymorphicFlowSignal{ kind: :raise_no_commit, ret: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
        ELSE_IF (clause_value_mutable.action == ErrorActionKind.Block) THEN
          result = ruby_array_concat_Emittable__mir_lowering(result, TRY (mIRLowering__lower_body(&self, castLocatableListToMIRLoweringLowerableStmtList(clause_value_mutable.body))));
        ELSE
          result;
        END
        RETURN result;
      ELSE
        RETURN CAST(List[] AS []Emittable);
      END
    ELSE
      RETURN CAST(List[] AS []Emittable);
    END
END
PRIVATE FN mIRLowering__no_ownership_call(self: MIRLowering, callee: String, args: []Emittable) RETURNS !Call ->
    RETURN Call{ callee: COPY callee, args: COPY args, try_wrap: FALSE, owned_return: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(args.length())), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL };
END
PRIVATE FN mIRLowering__lower_pre_clauses(MUTABLE self: MIRLowering, node: FunctionDef) RETURNS ![]Emittable ->
    MUTABLE pre_clauses: []{String@symbol}ContractClauseValue = (node.pre_clauses OR_ELSE List[]);
    IF (pre_clauses.length() == 0) THEN
      RETURN CAST(List[] AS []Emittable);
    END
    RETURN pre_clauses |> SELECT {
    MUTABLE expr: Locatable = UNWRAP (castContractClauseValueToLocatable(UNWRAP (_[:expr])));
    MUTABLE source: ?ContractClauseValue = _[:source];
    MUTABLE cond: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(expr)));
    MUTABLE line: String = "";
      IF locatable__token(expr) EXISTS AS expr_token THEN
        line = expr_token.line.toString();
      ELSE
        line = "0";
      END
    MUTABLE msg_text: String = "";
      MUTABLE source_text: String = "";
      IF source EXISTS AS source_value THEN
        PARTIAL MATCH source_value START
          ContractClauseValue.StringValue AS clause_text -> source_text = COPY clause_text;,
          DEFAULT -> PASS;
        END
      END
      IF (source_text.codepointCount() > 0) THEN
        msg_text = "PRE failed: ${source_text}";
      ELSE
        msg_text = "precondition failed";
      END
    MUTABLE msg_zig = mIRLowering__zig_string_lit(self, msg_text);
    Emittable{ IfStmt: COPY IfStmt{ cond: Emittable{ MIRUnaryOp: COPY MIRUnaryOp{ op: "!", operand: UNWRAP (COPY cond), lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: [Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: mIRLowering__runtime_binding_name(&self), lowered_node_id: NIL, ownership_consumption: NIL } }, method: "setError", args: [CAST(EnumTag{ variant: "Input" } AS Any), CAST(EnumOrdinal{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "ErrorName", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "PreconditionFail", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } AS Any), CAST(Lit{ value: COPY msg_zig, lowered_node_id: NIL, ownership_consumption: NIL } AS Any), CAST(Lit{ value: COPY line, lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(4)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ ReturnStmt: COPY ReturnStmt{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "error", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "CheatError", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL } }
    };
END
PRIVATE FN mIRLowering__zig_string_lit(self: MIRLowering, text: String) RETURNS String ->
    MUTABLE out = "\"";
    MUTABLE byte_idx = 0;
    WHILE byte_idx < text.bytes() DO
    MUTABLE b = byteAt(text, byte_idx);
    IF (b == 92) THEN
        &out.append("\\\\");
    ELSE_IF (b == 34) THEN
        &out.append("\\\"");
    ELSE_IF (b == 10) THEN
        &out.append("\\n");
    ELSE_IF (b == 13) THEN
        &out.append("\\r");
    ELSE_IF (b == 9) THEN
        &out.append("\\t");
    ELSE_IF ((((b >= 0) AND (b <= 31)) OR (b == 127))) THEN
        # Ruby's `format('\\x%02x', b)`. CLEAR has no printf, and the escape
        # is always exactly two lowercase hex digits for a byte.
        &out.append("\\x");
        &out.append("0123456789abcdef".substr((b / 16), 1));
        &out.append("0123456789abcdef".substr((b - ((b / 16) * 16)), 1));
    ELSE
        &out.append(codepointToString(b));
    END
    byte_idx = byte_idx + 1;
    END
    &out.append("\"");
    RETURN out;
END
PRIVATE FN mIRLowering__wrap_body_with_guard(MUTABLE self: MIRLowering, MUTABLE node: WithBlock, body_mir: []Emittable, with_label: ?String) RETURNS ![]Emittable ->
    MUTABLE guard_cond: ?Emittable = TRY (mIRLowering__combined_guard_cond(&self, node));
    IF guard_cond EXISTS AS guard_cond_value THEN
      MUTABLE guard_cond_value_mutable = COPY guard_cond_value;
      MUTABLE fail_body = TRY (mIRLowering__guard_fail_body(&self, node, with_label));
      RETURN CAST([Emittable{ IfStmt: COPY IfStmt{ cond: COPY guard_cond_value_mutable, then_body: COPY body_mir, else_body: fail_body, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL } }] AS []Emittable);
    ELSE
      RETURN COPY body_mir;
    END
END
PRIVATE FN mIRLowering__combined_guard_cond(MUTABLE self: MIRLowering, node: WithBlock) RETURNS !?Emittable ->
    MUTABLE guarded = TRY (withCapabilityPlan__guarded((TRY (capabilityPlan__require_for(node)))));
    IF (guarded.length() == 0) THEN
      RETURN NIL;
    END
    # Ruby folds with `reduce` and NO seed: one guard yields that guard's own
    # lowered node, not a conjunction with a synthetic operand.
    MUTABLE conds: []Emittable = guarded |> SELECT UNWRAP (TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(UNWRAP (_.guard_expr)))));
    IF (conds.length() == 0) THEN
      RETURN NIL;
    END
    MUTABLE acc: Emittable = COPY UNWRAP (conds[0]);
    MUTABLE rtoc_idx: Int64 = 1;
    WHILE (rtoc_idx < conds.length()) DO
      acc = Emittable{ MIRBinOp: COPY MIRBinOp{ op: "and", left: COPY acc, right: COPY UNWRAP (conds[rtoc_idx]), lowered_node_id: NIL, ownership_consumption: NIL } };
      rtoc_idx = rtoc_idx + 1;
    END
    RETURN acc;
END
PRIVATE FN mIRLowering__guard_fail_body(MUTABLE self: MIRLowering, node: WithBlock, with_label: ?String) RETURNS ![]Emittable ->
    MUTABLE clause: ?ErrorClause = COPY node.lock_error_clause;
    IF !((clause AND clause.matched_types.contains?(:GuardFail))) THEN
      RETURN CAST(List[] AS []Emittable);
    END
    RETURN TRY (mIRLowering__error_action_stmts(&self, clause, with_label, node, :GuardFail, "WITH GUARD predicate failed"));
END
PRIVATE FN mIRLowering__error_action_stmts(MUTABLE self: MIRLowering, clause: ErrorClause, with_label: ?String, with_node: WithBlock, error_type: String@symbol, default_msg: String) RETURNS ![]Emittable ->
    MUTABLE line = COPY with_node.token.line.toString();
    MUTABLE err_name = COPY CAST(error_type AS String);
    MUTABLE kind = (TRY (aST__kind_of_type(error_type)) OR_ELSE :Transient);
    IF (clause.action == ErrorActionKind.Raise) THEN
      RETURN CAST([Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: mIRLowering__runtime_binding_name(&self), lowered_node_id: NIL, ownership_consumption: NIL } }, method: "setError", args: [CAST(EnumTag{ variant: COPY CAST(kind AS String) } AS Any), CAST(EnumOrdinal{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "ErrorName", lowered_node_id: NIL, ownership_consumption: NIL } }, field: COPY err_name, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } AS Any), CAST(Lit{ value: COPY mIRLowering__zig_string_lit(self, default_msg), lowered_node_id: NIL, ownership_consumption: NIL } AS Any), CAST(Lit{ value: COPY line, lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(4)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ ReturnStmt: COPY ReturnStmt{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "error", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "CheatError", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable);
    ELSE_IF (clause.action == ErrorActionKind.Exit) THEN
      MUTABLE msg_mir: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(UNWRAP (clause.message))));
      RETURN CAST([Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: mIRLowering__runtime_binding_name(&self), lowered_node_id: NIL, ownership_consumption: NIL } }, method: "setError", args: [CAST(EnumTag{ variant: COPY CAST(kind AS String) } AS Any), CAST(EnumOrdinal{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "ErrorName", lowered_node_id: NIL, ownership_consumption: NIL } }, field: COPY err_name, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } AS Any), CAST(msg_mir AS Any), CAST(Lit{ value: COPY line, lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(4)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ ReturnStmt: COPY ReturnStmt{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "error", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "CheatError", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable);
    ELSE_IF (clause.action == ErrorActionKind.Pass) THEN
      RETURN CAST([Emittable{ BreakStmt: COPY BreakStmt{ label: COPY with_label?, value: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable);
    ELSE_IF (clause.action == ErrorActionKind.Return) THEN
      RETURN CAST([Emittable{ ReturnStmt: COPY ReturnStmt{ value: COPY TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(UNWRAP (clause.value)))), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable);
    ELSE_IF (clause.action == ErrorActionKind.Block) THEN
      RETURN (TRY (mIRLowering__lower_body(&self, castLocatableListToMIRLoweringLowerableStmtList(clause.body))) + [Emittable{ BreakStmt: COPY BreakStmt{ label: COPY with_label?, value: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }]);
    ELSE
      panic("Internal: unknown lock action {}");
    END
END
PRIVATE FN mIRLowering__mutable_snapshot_plan(self: MIRLowering, MUTABLE node: WithBlock, with_label: ?String) RETURNS !MutableSnapshotPlan ->
    MUTABLE lowerer: MIRLowering@multiowned = CAST(self AS MIRLowering@multiowned);
    MUTABLE body_mir = TRY (mIRLowering__lower_body(&lowerer, castLocatableListToMIRLoweringLowerableStmtList(node.body)));
    MUTABLE rt_name = mIRLowering__runtime_binding_name(&lowerer);
    RETURN MutableSnapshotPlan{ node: COPY node, with_label: COPY with_label, rt_name: COPY rt_name, alloc: :heap, body_mir: COPY body_mir, retries: (IF node.lock_error_clause != NIL THEN
      UNWRAP (node.lock_error_clause).retries
    ELSE
      NIL
    END), capabilities: COPY TRY (mIRLowering__with_capability_specs(self, node)) |> SELECT TRY (mIRLowering__mutable_snapshot_cap(self, lowerer, _)) };
END
PRIVATE FN mIRLowering__mutable_snapshot_cap(self: MIRLowering, lowerer: MIRLowering, cap: CapabilityTransition) RETURNS !MutableSnapshotCap ->
    MUTABLE var_node: CapabilityVarNode = COPY castLocatableToCapabilityVarNode(cap.var_node);
    MUTABLE sym: ?SymbolEntry = NIL;
    MATCH var_node START
      CapabilityVarNode.Identifier AS item ->
        sym = COPY item.symbol;,
      CapabilityVarNode.GetField AS item ->
        sym = COPY item.symbol;,
      CapabilityVarNode.GetIndex AS item ->
        sym = COPY item.symbol;,
    END
    MUTABLE resolved_type = COPY cap.resolved_type;
    RETURN MutableSnapshotCap{ var_node: COPY var_node, alias_name: COPY cap.alias_name, source: COPY TRY (mIRLowering__with_capability_source_mir(lowerer, var_node, TRUE)), bare_type: COPY TRY (type__bare_data_type(resolved_type)), conflict_error: IF (((sym != NIL) AND symbolEntry__atomic?(sym)) AND symbolEntry__indirect?(sym)) THEN
      :AtomicConflict
    ELSE
      :MvccConflict
    END };
END
PRIVATE FN mIRLowering__single_mutable_snapshot_txn(MUTABLE self: MIRLowering, plan: MutableSnapshotPlan, cap: MutableSnapshotCap) RETURNS !SnapshotTransaction ->
    MUTABLE conflict_action = TRY (mIRLowering__conflict_failure_action(&self, (COPY plan.node).lock_error_clause, plan.with_label, CAST(COPY plan.node AS WithBlock), cap.conflict_error));
    RETURN SnapshotTransaction{ cell_unwrap: Emittable{ CapabilityUnwrap: COPY CapabilityUnwrap{ source: COPY cap.source, lowered_node_id: NIL, ownership_consumption: NIL } }, rt: COPY plan.rt_name, alloc: COPY plan.alloc, alias_name: mIRLowering__safe_with_capability_alias(self, cap.alias_name), bare_type: castTypeToString(cap.bare_type), body: plan.body_mir, conflict_action: Emittable{ FailureAction: COPY conflict_action }, retries: plan.retries, with_label: UNWRAP (COPY plan.with_label), is_atomic_ptr: (cap.conflict_error == :AtomicConflict), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN mIRLowering__multi_mutable_snapshot_txn(MUTABLE self: MIRLowering, plan: MutableSnapshotPlan) RETURNS !SnapshotMultiTxn ->
    MUTABLE conflict_action = TRY (mIRLowering__conflict_failure_action(&self, (COPY plan.node).lock_error_clause, plan.with_label, CAST(COPY plan.node AS WithBlock), :MvccConflict));
    RETURN SnapshotMultiTxn{ cells: COPY plan.capabilities |> SELECT _.source, rt: COPY plan.rt_name, alloc: COPY plan.alloc, aliases: plan.capabilities |> SELECT mIRLowering__safe_with_capability_alias(self, _.alias_name), body: plan.body_mir, conflict_action: Emittable{ FailureAction: COPY conflict_action }, retries: plan.retries, with_label: UNWRAP (COPY plan.with_label), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN mIRLowering__emit_snapshot_mutable_call(MUTABLE self: MIRLowering, MUTABLE node: WithBlock, with_label: ?String) RETURNS !MIRLoweringReturnValue ->
    MUTABLE plan = TRY (mIRLowering__mutable_snapshot_plan(self, &node, with_label));
    MUTABLE single_cap: ?MutableSnapshotCap = NIL;
    IF !(plan.capabilities[1]) THEN
      single_cap = COPY plan.capabilities[0];
    END
    IF single_cap EXISTS AS single_cap_value THEN
      RETURN MIRLoweringReturnValue{ SnapshotTransaction: COPY TRY (mIRLowering__single_mutable_snapshot_txn(&self, plan, single_cap_value)) };
    ELSE
      RETURN MIRLoweringReturnValue{ SnapshotMultiTxn: COPY TRY (mIRLowering__multi_mutable_snapshot_txn(&self, plan)) };
    END
END
PRIVATE FN mIRLowering__conflict_failure_action(MUTABLE self: MIRLowering, clause: ?ErrorClause, with_label: ?String, with_node: WithBlock, conflict_error: String@symbol = :MvccConflict) RETURNS !FailureAction ->
    MUTABLE msg: String = "";
    IF (conflict_error == :AtomicConflict) THEN
      msg = "atomic CAS retries exhausted";
    ELSE
      msg = "MVCC commit conflict";
    END
    IF clause EXISTS AS clause_value THEN
      MUTABLE clause_value_mutable = COPY clause_value;
      RETURN TRY (mIRLowering__failure_action_from_clause(&self, clause_value_mutable, with_label, with_node, conflict_error, msg));
    ELSE
      RETURN TRY (mIRLowering__default_failure_action(&self, with_label, with_node, conflict_error, msg));
    END
END
PRIVATE FN mIRLowering__lock_failure_action(MUTABLE self: MIRLowering, clause: ErrorClause, with_label: ?String, with_node: WithBlock) RETURNS !FailureAction ->
    RETURN TRY (mIRLowering__failure_action_from_clause(&self, clause, with_label, with_node, :LockTimeout, "lock acquire timed out"));
END
PRIVATE FN mIRLowering__default_failure_action(MUTABLE self: MIRLowering, with_label: ?String, with_node: WithBlock, error_type: String@symbol, default_msg: String) RETURNS !FailureAction ->
    RETURN FailureAction{ kind: COPY FailureActionKind.Raise, error_type: COPY error_type, error_kind: COPY (TRY (aST__kind_of_type(error_type)) OR_ELSE :Transient), default_message: COPY default_msg, line: COPY CAST(with_node.token.line AS String), rt_name: COPY mIRLowering__runtime_binding_name(&self), with_label: COPY with_label, message: NIL, return_value: NIL, body: List[] };
END
PRIVATE FN mIRLowering__failure_action_from_clause(MUTABLE self: MIRLowering, clause: ErrorClause, with_label: ?String, with_node: WithBlock, error_type: String@symbol, default_msg: String) RETURNS !FailureAction ->
    MUTABLE kind = TRY (mIRLowering__clause_failure_action_kind(self, clause.action));
    MUTABLE message_mir: ?Emittable = NIL;
    MUTABLE return_mir: ?Emittable = NIL;
    MUTABLE body_mir: []Emittable = List[];
    IF (clause.action == ErrorActionKind.Exit) THEN
      message_mir = CAST(TRY (mIRLowering__lower(&self, castNodeToMIRLoweringLowerableStmt( castLocatableToNode(UNWRAP (clause.message))))) AS Emittable);
    ELSE_IF (clause.action == ErrorActionKind.Return) THEN
      return_mir = CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(UNWRAP (clause.value)))) AS Emittable);
    ELSE_IF (clause.action == ErrorActionKind.Block) THEN
      body_mir = TRY (mIRLowering__lower_body(&self, castLocatableListToMIRLoweringLowerableStmtList(clause.body)));
    END
    RETURN FailureAction{ kind: COPY kind, error_type: COPY error_type, error_kind: COPY (TRY (aST__kind_of_type(error_type)) OR_ELSE :Transient), default_message: COPY default_msg, line: COPY with_node.token.line.toString(), rt_name: COPY mIRLowering__runtime_binding_name(&self), with_label: COPY with_label, message: COPY message_mir, return_value: COPY return_mir, body: COPY body_mir };
END
PRIVATE FN mIRLowering__clause_failure_action_kind(self: MIRLowering, action: ErrorActionKind) RETURNS !FailureActionKind ->
    IF (action == ErrorActionKind.Raise) THEN
      RETURN FailureActionKind.Raise;
    ELSE_IF (action == ErrorActionKind.Exit) THEN
      RETURN FailureActionKind.Exit;
    ELSE_IF (action == ErrorActionKind.Pass) THEN
      RETURN FailureActionKind.Pass;
    ELSE_IF (action == ErrorActionKind.Return) THEN
      RETURN FailureActionKind.Return;
    ELSE_IF (action == ErrorActionKind.Block) THEN
      RETURN FailureActionKind.Block;
    ELSE
      panic("Internal: unknown lock action {}");
    END
END
PRIVATE FN mIRLowering__build_sorted_acquire_entries(MUTABLE self: MIRLowering, fallible_caps: []CapabilityTransition, fallible: Bool, with_node: ?WithBlock = NIL) RETURNS ![]SortedLockAcquireEntry ->
    MUTABLE suffix: String = "";
    IF with_node EXISTS AS with_node_value THEN
      suffix = "_${mIRLowering__stable_node_suffix(&self, Locatable{ WithBlock: COPY with_node_value })}";
    ELSE
      suffix = "";
    END
    RETURN {
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE rtoc_indexed_items_479: []CapabilityTransition = fallible_caps;
    MUTABLE rtoc_indexed_output_481 = [];
    MUTABLE rtoc_indexed_i_480 = 0;
    WHILE rtoc_indexed_i_480 < rtoc_indexed_items_479.length() DO
      &rtoc_indexed_output_481.append({
    MUTABLE var_node: CapabilityVarNode = castLocatableToCapabilityVarNode(UNWRAP (rtoc_indexed_items_479[rtoc_indexed_i_480]).var_node);
    MUTABLE var_name = UNWRAP (rtoc_indexed_items_479[rtoc_indexed_i_480]).target_label;
    MUTABLE alias_name = UNWRAP (rtoc_indexed_items_479[rtoc_indexed_i_480]).alias_name;
    MUTABLE resolved = UNWRAP (rtoc_indexed_items_479[rtoc_indexed_i_480]).resolved_type;
    MUTABLE source_mir = TRY (mIRLowering__with_capability_source_mir(self, var_node));
    MUTABLE var_storage:? = UNWRAP (rtoc_indexed_items_479[rtoc_indexed_i_480]).storage;
    MUTABLE is_arc: Bool = (symbolEntry__rc_storage?(var_storage) OR TRY (type__any_rc?(resolved)));
    MUTABLE lock_expr = CapabilityLockTarget{ source: COPY source_mir, arc_wrapped: is_arc, comptime_arc_unwrap: FALSE, lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE addr_expr = CapabilityLockAddress{ source: COPY source_mir, arc_wrapped: is_arc, lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE var_sync: ?String@symbol = UNWRAP (rtoc_indexed_items_479[rtoc_indexed_i_480]).sync;
    MUTABLE panic_method: String = "read";
    MUTABLE err_method: String = "readOrErr";
    IF (UNWRAP (rtoc_indexed_items_479[rtoc_indexed_i_480]).capability == symbol("EXCLUSIVE")) THEN
        IF (var_sync == :write_locked) THEN
          panic_method = "write";
          err_method = "writeOrErr";
        ELSE
          panic_method = "acquire";
          err_method = "acquireOrErr";
        END
    END
    SortedLockAcquireEntry{ index: rtoc_indexed_i_480, alias_name: COPY alias_name, guard_var: "__sort_guard${suffix}_${rtoc_indexed_i_480.toString()}", held_var: "__held${suffix}_${rtoc_indexed_i_480.toString()}", lock_expr: Emittable{ CapabilityLockTarget: COPY lock_expr }, address_expr: Emittable{ CapabilityLockAddress: COPY addr_expr }, method_name: COPY (IF fallible THEN
        err_method
      ELSE
        panic_method
      END) }
    });
      rtoc_indexed_i_480 = rtoc_indexed_i_480 + 1;
    END
    rtoc_indexed_output_481
    };
END
PRIVATE FN mIRLowering__sorted_lock_acquire(MUTABLE self: MIRLowering, fallible_caps: []CapabilityTransition, clause: ?ErrorClause, with_label: ?String, with_node: WithBlock) RETURNS !SortedLockAcquire ->
    MUTABLE fallible = !((clause == NIL));
    # `clause ? lock_failure_action(...) : nil` on a non-optional field: the
    # clause is what decides, and the guard binds it.
    MUTABLE rtoc_action: ?Emittable = NIL;
    IF clause EXISTS AS rtoc_clause THEN
      rtoc_action = Emittable{ FailureAction: COPY TRY (mIRLowering__lock_failure_action(&self, rtoc_clause, with_label, with_node)) };
    END
    MUTABLE rtoc_matched_types: []String@symbol = List[];
    MUTABLE rtoc_bubble_types: []String@symbol = List[];
    MUTABLE rtoc_retries: ?Int64 = NIL;
    IF clause EXISTS AS rtoc_clause_fields THEN
      rtoc_matched_types = COPY rtoc_clause_fields.matched_types;
      rtoc_bubble_types = COPY rtoc_clause_fields.bubble_types;
      rtoc_retries = rtoc_clause_fields.retries;
    END
    MUTABLE rtoc_source_line: ?Int64 = with_node.token.line;
    RETURN SortedLockAcquire{ entries: COPY TRY (mIRLowering__build_sorted_acquire_entries(&self, fallible_caps, fallible, with_node)), action: COPY UNWRAP (rtoc_action), matched_types: COPY rtoc_matched_types, bubble_types: COPY rtoc_bubble_types, retries: rtoc_retries, source_line: rtoc_source_line, loop_label: "__acq_sort_${mIRLowering__stable_node_suffix(&self, Locatable{ WithBlock: COPY with_node })}", rt_name: mIRLowering__runtime_binding_name(&self), fallible: fallible, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL };
END
PRIVATE FN mIRLowering__execution_boundary_dispatch(self: MIRLowering, parallel: ?Bool, pinned: ?Pinned) RETURNS String@symbol ->
    IF parallel EXISTS AS parallel_value THEN
      RETURN :parallel;
    END
    IF pinned EXISTS AS pinned_value THEN
      RETURN :pinned;
    END
    RETURN :local;
END
PRIVATE FN mIRLowering__execution_boundary_fact(MUTABLE self: MIRLowering, kind: String@symbol, dispatch: String@symbol, analysis: ?CaptureAnalysis) RETURNS !ExecutionBoundaryFact ->
    MUTABLE symbols: {String}SymbolEntry@multiowned = {};
    IF analysis EXISTS AS analysis_value THEN
      symbols = COPY analysis_value.capture_symbols;
    ELSE
      symbols = {};
    END
    MUTABLE captured: {String}Type = {};
    IF analysis EXISTS AS analysis_value THEN
      captured = COPY analysis_value.captures;
    ELSE
      captured = {};
    END
    MUTABLE names: []String = (((symbols.keys() + captured.keys())) |> SELECT _.toString() |> DISTINCT _ |> SELECT COPY _) |> ORDER_BY _;
    RETURN ExecutionBoundaryFact{ kind: COPY kind, dispatch: COPY dispatch, captures: COPY names |> SELECT TRY (mIRLowering__boundary_capture_fact(&self, _, symbols[_], captured[_])) };
END
PRIVATE FN mIRLowering__with_bg_fiber_body_context<RESULT>(MUTABLE self: MIRLowering, pointer_captures: [Set]String, blk: FN() -> RESULT) RETURNS RESULT
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE prev_bg_ptr_caps: ?[Set]String = COPY mIRLowering__capture_state(&rtoc_self_view).current_bg_pointer_captures;
  MUTABLE prev_fiber_pending = COPY mIRLowering__function_state(&rtoc_self_view).pending_stmts;
  DEFER {
  rtoc_self_view.state.function_state.pending_stmts = prev_fiber_pending;
  rtoc_self_view.state.capture.current_bg_pointer_captures = prev_bg_ptr_caps;
  }
  rtoc_self_view.state.capture.current_bg_pointer_captures = COPY pointer_captures;
  rtoc_self_view.state.function_state.pending_stmts = List[];
  RETURN blk();
}
END
PRIVATE FN mIRLowering__with_stream_body_context<RESULT>(MUTABLE self: MIRLowering, local_stream: String, is_inf: Bool, close_label: ?String = NIL, inherited_alloc_names: ?[Set]String = NIL, blk: FN() -> RESULT) RETURNS RESULT
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE prev_stream_local: ?String = COPY mIRLowering__capture_state(&rtoc_self_view).current_stream_local;
  MUTABLE prev_stream_is_inf: ?Bool = mIRLowering__capture_state(&rtoc_self_view).current_stream_is_inf;
  MUTABLE prev_close_label: ?String = COPY mIRLowering__capture_state(&rtoc_self_view).current_stream_close_label;
  MUTABLE prev_inherited_alloc_names = COPY mIRLowering__capture_state(&rtoc_self_view).current_fsm_inherited_alloc_names;
  DEFER {
  rtoc_self_view.state.capture.current_stream_local = prev_stream_local;
  rtoc_self_view.state.capture.current_stream_is_inf = prev_stream_is_inf;
  rtoc_self_view.state.capture.current_stream_close_label = prev_close_label;
  IF !(FALSE) THEN
      rtoc_self_view.state.capture.current_fsm_inherited_alloc_names = prev_inherited_alloc_names;
  END
  }
  rtoc_self_view.state.capture.current_stream_local = COPY local_stream;
  rtoc_self_view.state.capture.current_stream_is_inf = COPY is_inf;
  rtoc_self_view.state.capture.current_stream_close_label = COPY close_label;
  IF inherited_alloc_names EXISTS AS inherited_alloc_names_value THEN
      rtoc_self_view.state.capture.current_fsm_inherited_alloc_names = COPY inherited_alloc_names_value;
      RETURN CAST(inherited_alloc_names_value AS RESULT);
  END
  RETURN blk();
}
END
PRIVATE FN mIRLowering__capture_ownership_mirror_nodes(self: MIRLowering, caps: FiberCtxBuilderResult, analysis: ?CaptureAnalysis, receiver: String, close_plans: {String}ResourceClosePlan = {}) RETURNS ![]Emittable ->
    MUTABLE captured: {String}Type = {};
    IF analysis EXISTS AS analysis_value THEN
      captured = COPY analysis_value.captures;
    ELSE
      captured = {};
    END
    # Ruby's filter_map has four early `next nil` guards and flattens the
    # packets; the arms of the IF expressions it became yield lists, which do
    # not leave an expression implicitly.
    MUTABLE rtoc_mirror: []Emittable = List[];
    FOR rtoc_spec IN caps.specs DO
      IF captureSpec__needs_moved_guard?(rtoc_spec) THEN
        IF !(close_plans.contains?(rtoc_spec.name)) THEN
          MUTABLE raw_type: ?Type = COPY captured[rtoc_spec.name];
          MUTABLE type_info: Type = TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }));
          IF raw_type EXISTS AS rtoc_raw_type THEN
            type_info = TRY (type__new(TypeConstructionInput{ Type: COPY rtoc_raw_type }));
          END
          IF !(type__resource?(type_info)) THEN
            type_info = (captureSpec__cleanup_mirror_type(rtoc_spec) OR_ELSE COPY type_info);
            MUTABLE name = "${receiver}.${rtoc_spec.name}";
            MUTABLE entry = cleanupEntry__build(:uniform, :heap, TRUE);
            MUTABLE mark = AllocMark{ name: COPY name, alloc: :heap, type_info: COPY type_info, scope: :heap, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
            rtoc_mirror = (rtoc_mirror + TRY (materializationPacket__statements(materializationPacket__markers(mark, CAST(Cleanup{ name: COPY name, cleanup_entry: entry, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable)))));
          END
        END
      END
    END
    RETURN rtoc_mirror;
END
PRIVATE FN mIRLowering__capture_moved_guard_fields(self: MIRLowering, specs: []CaptureSpec) RETURNS ![]ContextFieldDecl
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN specs |> SELECT:? (IF !(captureSpec__needs_moved_guard?(_)) THEN NIL ELSE ContextFieldDecl{ name: "${_.name}_moved", type_zig: "bool", default_value: Emittable{ Lit: COPY Lit{ value: "false", lowered_node_id: NIL, ownership_consumption: NIL } } } END) |> WHERE _ != NIL |> SELECT UNWRAP (_);
}
END
PRIVATE FN mIRLowering__context_field_decl(self: MIRLowering, name: String, type_zig: String) RETURNS ContextFieldDecl ->
    RETURN ContextFieldDecl{ name: COPY name, type_zig: COPY type_zig, default_value: NIL };
END
PRIVATE FN mIRLowering__context_init_field(self: MIRLowering, name: MIRLoweringName, value: Emittable) RETURNS StructInitField ->
    RETURN StructInitField{ name: castNameToStringSymbol__mir_lowering(COPY name), value: COPY value, alloc: NIL };
END
PRIVATE FN mIRLowering__capture_setup_stmts(self: MIRLowering, specs: []CaptureSpec) RETURNS ![]Emittable ->
    RETURN specs |> UNNEST _.setup_mir;
END
PRIVATE FN mIRLowering__capture_cleanup_stmts(self: MIRLowering, specs: []CaptureSpec, receiver: String) RETURNS ![]Emittable ->
    RETURN specs |> SELECT:? TRY (captureSpec__cleanup_mir_for(_, receiver)) |> WHERE _ != NIL |> SELECT Emittable{ MIRDeferStmt: COPY UNWRAP (_) };
END
PRIVATE FN mIRLowering__fiber_capture_source_overrides(MUTABLE self: MIRLowering, analysis: ?CaptureAnalysis, base: {String}String = {}) RETURNS !{String}String ->
    MUTABLE out = COPY base;
    IF analysis EXISTS AS analysis_value THEN
      FOR rtoc_key IN analysis_value.capture_symbols.keys() DO
    MUTABLE sym: SymbolEntry@multiowned = COPY UNWRAP (analysis_value.capture_symbols[rtoc_key]);
    MUTABLE decl: ?SymbolEntryRegInput = NIL;
    IF TRUE THEN
          decl = COPY sym.reg;
        END
    MUTABLE mapped: ?String = NIL;
        IF decl EXISTS THEN
          mapped = (TRY (functionState__decl_zig_names(mIRLowering__function_state(&self))))[aST__node_identity(castSymbolEntryRegInputToLocatable(decl))];
        END
    IF mapped EXISTS AS mapped_value THEN
          out[rtoc_key] = (out[rtoc_key] OR_ELSE mapped_value);
    END
      END
      RETURN out;
    ELSE
      RETURN out;
    END
END
PRIVATE FN mIRLowering__finalized_boundary_body_for_emit(MUTABLE self: MIRLowering, body: []Emittable) RETURNS ![]Emittable ->
  MUTABLE prev_alloc_names = COPY mIRLowering__function_state(&self).lowered_alloc_names;
  MUTABLE prev_guarded_names = COPY mIRLowering__function_state(&self).lowered_guarded_cleanup_names;
  DEFER {
  self.state.function_state.lowered_alloc_names = prev_alloc_names;
  self.state.function_state.lowered_guarded_cleanup_names = prev_guarded_names;
  }
  RETURN TRY (mIRLowering__append_ownership_transfers_for_mir_body(&self, body));
END
PRIVATE FN mIRLowering__capture_ownership_mirror_node?(self: MIRLowering, node: Emittable, receiver: String) RETURNS Bool ->
    IF !(((node IS_A AllocMark OR node IS_A Cleanup) OR node IS_A ErrCleanup)) THEN
      RETURN FALSE;
    END
    RETURN (CAST(emittable__name(node) AS String)).startsWith?("${receiver}.");
END
PRIVATE FN mIRLowering__boundary_capture_fact(MUTABLE self: MIRLowering, name: String, symbol: ?SymbolEntry, captured_type: ?Type) RETURNS !BoundaryCaptureFact ->
    MUTABLE storage: ?String@symbol = mIRLowering__boundary_capture_storage(self, symbol, captured_type);
    MUTABLE sync: ?String@symbol = (IF symbol != NIL THEN
      symbolEntry__sync(symbol)
    ELSE
      NIL
    END);
    IF captured_type != NIL THEN
      sync = type__sync(captured_type);
    END
    MUTABLE ownership: ?String@symbol = (IF symbol != NIL THEN
      symbolEntry__ownership_kind(symbol)
    ELSE
      NIL
    END);
    IF captured_type != NIL THEN
      ownership = type__ownership(captured_type);
    END
    MUTABLE forbidden: ?String@symbol = TRY (mIRLowering__boundary_capture_forbidden_reason(&self, symbol, captured_type));
    RETURN BoundaryCaptureFact{ name: COPY name, storage: COPY storage, sync: COPY sync, ownership: COPY ownership, parallel_safe: (forbidden == NIL), scheduler_affine: mIRLowering__boundary_capture_scheduler_affine?(self, symbol, captured_type), requires_pinned: mIRLowering__boundary_capture_requires_pinned?(self, symbol, captured_type), forbidden_reason: COPY forbidden };
END
PRIVATE FN mIRLowering__boundary_capture_forbidden_reason(MUTABLE self: MIRLowering, symbol: ?SymbolEntry, captured_type: ?Type) RETURNS !?String@symbol ->
    IF !((IF symbol != NIL THEN symbol ELSE captured_type END)) THEN
      RETURN NIL;
    END
    IF mIRLowering__boundary_capture_local?(self, symbol, captured_type) THEN
      RETURN :local_scheduler_affinity;
    END
    IF mIRLowering__boundary_capture_multiowned_rc?(self, symbol, captured_type) THEN
      RETURN :non_atomic_rc;
    END
    IF mIRLowering__boundary_capture_shared_arc?(self, symbol, captured_type) THEN
      RETURN NIL;
    END
    IF mIRLowering__boundary_capture_locked?(self, symbol, captured_type) THEN
      RETURN :affine_locked;
    END
    IF mIRLowering__boundary_capture_write_locked?(self, symbol, captured_type) THEN
      RETURN :affine_write_locked;
    END
    IF mIRLowering__boundary_capture_versioned?(self, symbol, captured_type) THEN
      RETURN :affine_versioned;
    END
    MUTABLE type_info:? = (IF captured_type != NIL THEN captured_type ELSE (IF symbol != NIL THEN
      symbolEntry__type(symbol)
    ELSE
      NIL
    END) END);
    IF type_info THEN
      RETURN TRY (type__parallel_boundary_forbidden_reason(type_info, CAST(mIRLowering__mir_schema_lookup(&self) AS FN(String@symbol) -> ?TypeSchemaLookupResult)));
    END
    RETURN NIL;
END
PRIVATE FN mIRLowering__boundary_capture_scheduler_affine?(self: MIRLowering, symbol: ?SymbolEntry, captured_type: ?Type) RETURNS Bool ->
    IF !((IF symbol != NIL THEN symbol ELSE captured_type END)) THEN
      RETURN FALSE;
    END
    IF mIRLowering__boundary_capture_local?(self, symbol, captured_type) THEN
      RETURN TRUE;
    END
    IF mIRLowering__boundary_capture_shared_arc?(self, symbol, captured_type) THEN
      RETURN FALSE;
    END
    RETURN ((mIRLowering__boundary_capture_locked?(self, symbol, captured_type) OR mIRLowering__boundary_capture_write_locked?(self, symbol, captured_type)) OR mIRLowering__boundary_capture_versioned?(self, symbol, captured_type));
END
PRIVATE FN mIRLowering__boundary_capture_requires_pinned?(self: MIRLowering, symbol: ?SymbolEntry, captured_type: ?Type) RETURNS Bool ->
    RETURN (mIRLowering__boundary_capture_scheduler_affine?(self, symbol, captured_type) OR mIRLowering__boundary_capture_multiowned_rc?(self, symbol, captured_type));
END
PRIVATE FN mIRLowering__boundary_capture_shared_arc?(self: MIRLowering, symbol: ?SymbolEntry, captured_type: ?Type) RETURNS Bool ->
    IF captured_type EXISTS AS captured_type_value THEN
      IF type__shared?(captured_type_value) THEN
      RETURN TRUE;
    END
    END
    IF symbol EXISTS AS symbol_value THEN
      MUTABLE type_info = symbolEntry__type(symbol_value);
      IF (TRUE AND type__shared?(type_info)) THEN
        RETURN TRUE;
      END
      RETURN (symbolEntry__storage(symbol_value) == :shared);
    ELSE
      RETURN FALSE;
    END
END
PRIVATE FN mIRLowering__boundary_capture_multiowned_rc?(self: MIRLowering, symbol: ?SymbolEntry, captured_type: ?Type) RETURNS Bool ->
    IF captured_type EXISTS AS captured_type_value THEN
      IF type__multiowned?(captured_type_value) THEN
      RETURN TRUE;
    END
    END
    IF symbol EXISTS AS symbol_value THEN
      MUTABLE type_info = symbolEntry__type(symbol_value);
      IF (TRUE AND type__multiowned?(type_info)) THEN
        RETURN TRUE;
      END
      RETURN (symbolEntry__storage(symbol_value) == :multiowned);
    ELSE
      RETURN FALSE;
    END
END
PRIVATE FN mIRLowering__boundary_capture_storage(self: MIRLowering, symbol: ?SymbolEntry, captured_type: ?Type) RETURNS ?String@symbol ->
    IF mIRLowering__boundary_capture_shared_arc?(self, symbol, captured_type) THEN
      RETURN :shared;
    END
    IF mIRLowering__boundary_capture_multiowned_rc?(self, symbol, captured_type) THEN
      RETURN :multiowned;
    END
    IF symbol != NIL THEN
    RETURN symbolEntry__storage(symbol);
    ELSE
    RETURN NIL;
    END
END
PRIVATE FN mIRLowering__boundary_capture_local?(self: MIRLowering, symbol: ?SymbolEntry, captured_type: ?Type) RETURNS Bool ->
    RETURN !(!(((IF (IF captured_type != NIL THEN
      type__local?(captured_type)
    ELSE
      NIL
    END) != NIL THEN (IF captured_type != NIL THEN
      type__local?(captured_type)
    ELSE
      NIL
    END) ELSE (IF symbol != NIL THEN
      symbolEntry__local?(symbol)
    ELSE
      NIL
    END) END))));
END
PRIVATE FN mIRLowering__boundary_capture_locked?(self: MIRLowering, symbol: ?SymbolEntry, captured_type: ?Type) RETURNS Bool ->
    RETURN !(!(((IF (IF captured_type != NIL THEN
      type__locked?(captured_type)
    ELSE
      NIL
    END) != NIL THEN (IF captured_type != NIL THEN
      type__locked?(captured_type)
    ELSE
      NIL
    END) ELSE (IF symbol != NIL THEN
      symbolEntry__locked?(symbol)
    ELSE
      NIL
    END) END))));
END
PRIVATE FN mIRLowering__boundary_capture_write_locked?(self: MIRLowering, symbol: ?SymbolEntry, captured_type: ?Type) RETURNS Bool ->
    RETURN !(!(((IF (IF captured_type != NIL THEN
      type__write_locked?(captured_type)
    ELSE
      NIL
    END) != NIL THEN (IF captured_type != NIL THEN
      type__write_locked?(captured_type)
    ELSE
      NIL
    END) ELSE (IF symbol != NIL THEN
      symbolEntry__write_locked?(symbol)
    ELSE
      NIL
    END) END))));
END
PRIVATE FN mIRLowering__boundary_capture_versioned?(self: MIRLowering, symbol: ?SymbolEntry, captured_type: ?Type) RETURNS Bool ->
    RETURN !(!(((((IF captured_type != NIL THEN
      type__versioned?(captured_type)
    ELSE
      NIL
    END) != NIL) OR symbolEntry__versioned_sync?((IF symbol != NIL THEN
      symbolEntry__sync(symbol)
    ELSE
      NIL
    END))))));
END
PRIVATE FN mIRLowering__lower_do_block(MUTABLE self: MIRLowering, node: DoBlock) RETURNS !MIRDoBlock ->
    MUTABLE id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_499 = mIRLowering__lowering_counters(&self);
    mIRLoweringCounters__next_do_block_id(&rtoc_mutable_receiver_499) };
    MUTABLE branches = node.branches;
    MUTABLE n = (branches).length();
    MUTABLE wg_var = "__do${mIRLoweringGeneratedId__to_s(id)}_wg";
    MUTABLE all_branch_bodies: [][]Emittable = List[];
    MUTABLE boundary_facts: []ExecutionBoundaryFact = List[];
    # Ruby builds this with `branches.each_with_index.map`, whose collection
    # ruby-to-clear could not type; the body also appends to two locals the
    # map closes over, which is why it became an `unsupportedRuby` stub rather
    # than a partial translation.
    MUTABLE branch_plans: []DoBranchPlan = List[];
    MUTABLE branch_index: Int64 = 0;
    WHILE (branch_index < n) DO
      MUTABLE branch: DoBranch = COPY UNWRAP (branches[branch_index]);
      MUTABLE ctx_type = "__DoBranchCtx${mIRLoweringGeneratedId__to_s( CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(CAST(id AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId) AS MIRLoweringGeneratedId))}_${mIRLoweringGeneratedId__to_s(branch_index)}";
      MUTABLE ctx_var = "__do${id.toString()}_ctx${branch_index.toString()}";
      MUTABLE branch_analysis: ?CaptureAnalysis = COPY branch.capture_analysis;
      MUTABLE pinned: Bool = pinMode__pinned?(branch.pinned);
      &boundary_facts.append(TRY (mIRLowering__execution_boundary_fact(&self, :do_branch, mIRLowering__execution_boundary_dispatch(self, branch.parallel, Pinned{ BoolValue: COPY pinned }), branch_analysis)));
      MUTABLE caps = TRY (fiberCtxBuilder__build(branch_analysis, "ctx", {}, NIL, ((id * 1000) + branch_index), TRY (mIRLowering__fiber_capture_source_overrides(&self, branch_analysis, {})), mIRLowering__mir_schema_lookup(&self)));
      MUTABLE capture_fields: []ContextFieldDecl = [mIRLowering__context_field_decl(self, "alloc", "std.mem.Allocator")];
      FOR spec IN caps.specs DO
        &capture_fields.append(mIRLowering__context_field_decl(self, spec.name, spec.field_type_zig));
      END
      capture_fields = (capture_fields + TRY (mIRLowering__capture_moved_guard_fields(self, caps.specs)));
      MUTABLE capture_inits: []StructInitField = [
        mIRLowering__context_init_field(self, MIRLoweringName{ SymbolValue: :wg }, Emittable{ AddressOf: COPY AddressOf{ expr: Emittable{ Ident: COPY Ident{ name: COPY wg_var, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }),
        mIRLowering__context_init_field(self, MIRLoweringName{ SymbolValue: :alloc }, Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: COPY mIRLowering__runtime_binding_name(&self), lowered_node_id: NIL, ownership_consumption: NIL } }, method: "heapAlloc", args: ( { MUTABLE rtoc_empty_args_do: []Emittable = List[]; rtoc_empty_args_do } ), fallible: FALSE, contract: COPY TRY (callableContract__no_ownership(0)), lowered_node_id: NIL, ownership_consumption: NIL } })
      ];
      FOR spec IN caps.specs DO
        &capture_inits.append(mIRLowering__context_init_field(self, MIRLoweringName{ StringValue: COPY spec.name }, COPY spec.init_value_mir));
      END
      MUTABLE capture_pre_decls = TRY (mIRLowering__capture_setup_stmts(self, caps.specs));
      MUTABLE branch_mir: []Emittable = TRY (mIRLowering__lower_do_branch_body(&self, branch, caps));
      &all_branch_bodies.append(COPY branch_mir);
      MUTABLE task_cfg = mIRLowering__task_config_plan(self, branch.stack_size, branch.computed_stack_tier);
      &branch_plans.append(DoBranchPlan{
        ctx_type: COPY ctx_type,
        ctx_var: COPY ctx_var,
        wg_var: COPY wg_var,
        raw_rt_name: "__raw_rt_do${id.toString()}_${branch_index.toString()}",
        raw_args_name: "__raw_args_do${id.toString()}_${branch_index.toString()}",
        capture_fields: COPY capture_fields,
        capture_inits: COPY capture_inits,
        capture_pre_decls: COPY capture_pre_decls,
        body: COPY branch_mir,
        spawn_call: COPY mIRLowering__do_branch_spawn_call_plan(self, wg_var, ctx_type, ctx_var, task_cfg, pinned)
      });
      branch_index = (branch_index + 1);
    END
    MUTABLE do_block = MIRDoBlock{ code: COPY DoBlockPlan{ wg_var: COPY wg_var, branches: COPY branch_plans }, branch_bodies: COPY all_branch_bodies, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, boundary_facts: List[] };
    do_block.boundary_facts = boundary_facts;
    RETURN do_block;
END
# One DO branch body, lowered under the branch's fiber capture map. Split out
# because the Ruby original nests this inside the each_with_index map.
PRIVATE FN mIRLowering__lower_do_branch_body(MUTABLE self: MIRLowering, branch: DoBranch, caps: FiberCtxBuilderResult) RETURNS ![]Emittable
  EFFECTS REENTRANT ->
    RETURN mIRLowering__with_fiber_capture_map(&self, caps.capture_map, caps.capture_symbols, "__rt", %() USE(branch, caps, MUTABLE self) -> {
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE body_stmts: []Emittable = TRY (mIRLowering__capture_cleanup_stmts(self, caps.specs, "ctx"));
    FOR branch_stmt IN branch.body DO
      MUTABLE lowered: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(branch_stmt)));
      FOR pending IN (TRY (mIRLowering__flush_pending(&self))) DO
        &body_stmts.append(castStmtToEmittable(pending));
      END
      FOR lowered_stmt IN (TRY (mIRLowering__do_branch_stmt_nodes(&self, branch_stmt, UNWRAP (lowered)))) DO
        &body_stmts.append(COPY lowered_stmt);
      END
    END
    TRY (mIRLowering__finalized_boundary_body_for_emit(&self, body_stmts))
    });
END
PRIVATE FN mIRLowering__do_branch_stmt_nodes(MUTABLE self: MIRLowering, expr: Locatable, mir: Emittable) RETURNS ![]Emittable ->
    IF mir IS_A MIRBgBlock AS mir_bg_block THEN
      MUTABLE mir_bg_block_mutable = COPY mir_bg_block;
      MUTABLE name = "__discard_bg_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_501 = mIRLowering__lowering_counters(&self);
      mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_501)) }}";
      MUTABLE next_contract = callableContract__new((TRY (callableContract__no_ownership(0))).signature, TRY (ownershipContract__consume_operands([ownershipOperandFact__owned_binding(name, TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })), "DO branch BG discard", :heap)])), 0);
      RETURN CAST([Emittable{ Let: COPY Let{ name: COPY name, init: Emittable{ MIRBgBlock: COPY mir_bg_block_mutable }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }, Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: COPY name, lowered_node_id: NIL, ownership_consumption: NIL } }, method: "next", args: List[], try_wrap: TRUE, callable_contract: COPY next_contract, owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: TRUE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable);
    END
    RETURN CAST([UNWRAP (TRY (mIRLowering__wrap_step_as_stmt(self, ThenStep{ expr: COPY expr, binding: NIL }, mir)))] AS []Emittable);
END
PRIVATE FN mIRLowering__lower_bg_block(MUTABLE self: MIRLowering, MUTABLE node: BgBlock) RETURNS !MIRBgBlock ->
    MUTABLE id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_504 = mIRLowering__lowering_counters(&self);
    mIRLoweringCounters__next_background_block_id(&rtoc_mutable_receiver_504) };
    MUTABLE names = mIRLowering__bg_lowering_names(self, id);
    MUTABLE types = TRY (mIRLowering__bg_type_plan(self, node));
    MUTABLE analysis: ?CaptureAnalysis = COPY node.capture_analysis;
    MUTABLE captured: {String}Type = {};
    IF analysis EXISTS AS analysis_value THEN
      captured = analysis_value.captures;
    ELSE
      captured = {};
    END
    MUTABLE capture_close_plans: {String}ResourceClosePlan = {};
    IF analysis EXISTS AS analysis_value THEN
      capture_close_plans = analysis_value.close_plans;
    ELSE
      capture_close_plans = {};
    END
    MUTABLE pointer_captures: [Set]String = Set[];
    IF analysis EXISTS AS analysis_value THEN
      pointer_captures = analysis_value.pointer_captures;
    ELSE
      pointer_captures = Set[];
    END
    MUTABLE rt_name = mIRLowering__runtime_binding_name(&self);
    TRY (mIRLowering__enforce_bg_capture_strategies_mut(&self, Node{ BgBlock: COPY node }, captured));
    MUTABLE capture = TRY (mIRLowering__bg_capture_materialization(&self, names, analysis, captured, capture_close_plans, pointer_captures));
    MUTABLE body = TRY (mIRLowering__bg_body_materialization(&self, &node, capture.caps, analysis, pointer_captures, names.bg_rt, id, types.is_void, types.inner_type, capture_close_plans));
    MUTABLE scheduler = mIRLowering__bg_scheduler_plan(self, node, names, rt_name);
    IF mIRLowering__bg_uses_fsm_transform?(&self, node) THEN
      MUTABLE ctx = BgFsmTransformContext{ node: COPY node, names: COPY names, types: COPY types, capture: capture, body: COPY body, scheduler: COPY scheduler, captured: COPY captured, capture_close_plans: COPY capture_close_plans, pointer_captures: COPY pointer_captures, rt_name: COPY rt_name };
      MUTABLE transform_result: ?FsmLoweringResult = TRY (fsmTransform__transform(BgBlockInput{ BgBlock: COPY node }, TRY (bgFsmTransformContext__to_transform_hash(ctx)), &self));
      IF transform_result EXISTS AS transform_result_value THEN
        RETURN TRY (mIRLowering__fsm_bg_block_from_transform_mut(&self, node, transform_result_value, captured, analysis));
      END
    END
    RETURN TRY (mIRLowering__emit_stackful_bg_block(&self, &node, names, types, capture, body, scheduler, rt_name, captured, analysis));
END
PRIVATE FN mIRLowering__bg_lowering_names(self: MIRLowering, id: MIRLoweringGeneratedId) RETURNS BgLoweringNames ->
    MUTABLE raw_id = id.value;
    RETURN BgLoweringNames{ id: raw_id, ctx_type: "__BgCtx${raw_id.toString()}", alloc_var: "__bg${raw_id.toString()}_alloc", promise_var: "__bg${raw_id.toString()}_promise", ctx_var: "__bg${raw_id.toString()}_ctx", blk_label: "__bg${raw_id.toString()}", bg_rt: "__rt_bg${raw_id.toString()}" };
END
PRIVATE FN mIRLowering__bg_type_plan(self: MIRLowering, node: BgBlock) RETURNS !BgTypePlan ->
    MUTABLE tense_t = TRY (type__new(TypeConstructionInput{ Type: COPY TRY (aST__full_type_mut(Locatable{ BgBlock: COPY node })) }));
    MUTABLE async_shape = (node.async_result_shape OR_ELSE TRY (asyncResultShape__promise(TRY (type__tense_type(tense_t)), type__shared_promise?(tense_t))));
    MUTABLE inner_t = TRY (type__new(TypeConstructionInput{ Type: COPY async_shape.payload_type }));
    MUTABLE inner_zig = TRY (type__nested_zig_type(inner_t));
    RETURN BgTypePlan{ async_shape: COPY async_shape, inner_type: COPY inner_t, inner_zig: COPY inner_zig, promise_zig: COPY TRY (asyncResultShape__handle_zig_type(async_shape)), is_void: ((inner_zig == "void") AND !(asyncResultShape__boxes_fallible_payload?(async_shape))) };
END
PRIVATE FN mIRLowering__bg_capture_materialization(MUTABLE self: MIRLowering, names: BgLoweringNames, analysis: ?CaptureAnalysis, captured: {String}Type, capture_close_plans: {String}ResourceClosePlan, pointer_captures: [Set]String) RETURNS !BgCaptureMaterialization ->
    MUTABLE promoted_names: {String}String = {};
    MUTABLE outer_capture_map = TRY (mIRLowering__fiber_capture_source_overrides(&self, analysis, (mIRLowering__capture_state(&self).do_capture_map OR_ELSE {})));
    MUTABLE capture_analysis = (analysis OR_ELSE CaptureAnalysis{ captures: COPY captured, pointer_captures: COPY pointer_captures, has_local: FALSE, has_rc: FALSE, has_shared: FALSE, has_sharded: FALSE, has_affine_locked: FALSE, has_outer_ref: FALSE, has_non_escaping_capture: FALSE, capture_symbols: {}, close_plans: {}, string_captures: Set[], resource_captures: Set[], site_moved: Set[], site_copied: Set[], strategies: {}, move_mark_names: Set[], alloc_mark_entries: {} });
    MUTABLE caps = TRY (fiberCtxBuilder__build(capture_analysis, "__ctx_${names.id.toString()}", promoted_names, names.alloc_var, names.id, outer_capture_map, mIRLowering__mir_schema_lookup(&self)));
    MUTABLE capture_fields = caps.specs |> SELECT {
    MUTABLE ftype: String = "";
      IF ((captureSpec__requires_setup?(_) OR promoted_names[_.name]) OR (outer_capture_map[_.name] == NIL)) THEN
        ftype = COPY _.field_type_zig;
      ELSE
        ftype = compilerRegexReplaceFirst(_.field_type_zig, compilerRegexCompile(compilerRegexEscape("(${_.name})")), "(${(outer_capture_map[_.name] OR_ELSE "")})");
      END
    mIRLowering__context_field_decl(self, _.name, ftype)
    };
    capture_fields = (capture_fields + TRY (mIRLowering__capture_moved_guard_fields(self, caps.specs)));
    MUTABLE capture_inits = ([mIRLowering__context_init_field(self, MIRLoweringName{ SymbolValue: :inner }, Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: COPY names.promise_var, lowered_node_id: NIL, ownership_consumption: NIL } }, field: "inner", lowered_node_id: NIL, ownership_consumption: NIL } }), mIRLowering__context_init_field(self, MIRLoweringName{ SymbolValue: :alloc }, Emittable{ Ident: COPY Ident{ name: COPY names.alloc_var, lowered_node_id: NIL, ownership_consumption: NIL } })] + (caps.specs |> SELECT {
    MUTABLE outer_ref: ?String = COPY outer_capture_map[_.name];
    MUTABLE init_val_branch_value: ?Ident = NIL;
      IF (((captureSpec__requires_setup?(_) OR promoted_names[_.name]) OR (outer_ref == NIL)) OR pointer_captures.contains?(_.name)) THEN
        init_val_branch_value = castEmittableToIdent(_.init_value_mir);
      ELSE
        init_val_branch_value = Ident{ name: COPY outer_ref, lowered_node_id: NIL, ownership_consumption: NIL };
      END
    MUTABLE init_val: Ident = init_val_branch_value?;
    mIRLowering__context_init_field(self, MIRLoweringName{ StringValue: COPY _.name }, Emittable{ Ident: COPY init_val })
    }));
    MUTABLE setup_stmts = TRY (mIRLowering__capture_setup_stmts(self, caps.specs));
    # `filter_map` over the specs: only the guarded names that have no close
    # plan, and the field that holds them is a plain list of names.
    MUTABLE fresh_heap_cleanup_names: []String = List[];
    FOR rtoc_spec IN caps.specs DO
      IF !(capture_close_plans.contains?(rtoc_spec.name)) THEN
        IF captureSpec__needs_moved_guard?(rtoc_spec) THEN
          &fresh_heap_cleanup_names.append(COPY rtoc_spec.name);
        END
      END
    END
    MUTABLE capture_finalizers: []Emittable = List[];
    FOR rtoc_fin_spec IN caps.specs DO
      IF !(capture_close_plans.contains?(rtoc_fin_spec.name)) THEN
        IF captureSpec__finalizer_mir_for(rtoc_fin_spec, "__ctx_${names.id.toString()}") EXISTS AS rtoc_finalizer THEN
          &capture_finalizers.append(COPY rtoc_finalizer);
        END
      END
    END
    # `captured.filter_map { |name, _| ... }` walks a hash: CLEAR yields the
    # key, and only the names with a close plan produce an action.
    MUTABLE capture_frees: []CaptureCleanupAction = List[];
    FOR rtoc_capture_name IN captured.keys() DO
      IF capture_close_plans[rtoc_capture_name] EXISTS AS close_plan THEN
        &capture_frees.append(CaptureCleanupAction{ target: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__ctx_${names.id.toString()}", lowered_node_id: NIL, ownership_consumption: NIL } }, field: COPY rtoc_capture_name, lowered_node_id: NIL, ownership_consumption: NIL } }, cleanup_entry: cleanupEntry__build(:resource, :heap, FALSE, close_plan), allocator: NIL });
      END
    END
    RETURN BgCaptureMaterialization{ caps: COPY caps, capture_fields: COPY capture_fields, capture_inits: COPY capture_inits, fresh_heap_cleanup_names: COPY fresh_heap_cleanup_names, capture_frees: COPY capture_frees, capture_finalizers: COPY capture_finalizers, promoted_decls: COPY setup_stmts };
END
PRIVATE FN mIRLowering__task_config_plan(self: MIRLowering, stack_size: ?String@symbol, computed_tier: ?String@symbol) RETURNS TaskConfigPlan ->
    MUTABLE lowerer: MIRLowering@multiowned = CAST(self AS MIRLowering@multiowned);
    RETURN TaskConfigPlan{ stack_variant: COPY mIRLowering__task_config_variant(lowerer, stack_size, computed_tier), profile_site_id: NIL, profile_dispatch_id: NIL };
END
PRIVATE FN mIRLowering__profiled_task_config_plan(self: MIRLowering, base: TaskConfigPlan, site_id: Int64, dispatch: PinMode) RETURNS TaskConfigPlan ->
    RETURN TaskConfigPlan{ stack_variant: COPY base.stack_variant, profile_site_id: COPY site_id, profile_dispatch_id: mIRLowering__profile_dispatch_numeric_id(self, dispatch) };
END
PRIVATE FN mIRLowering__profile_dispatch_numeric_id(self: MIRLowering, dispatch: PinMode) RETURNS Int64 ->
    RETURN PARTIAL MATCH dispatch START
      PinMode.SymbolValue AS rtoc_dispatch_sym -> (IF (rtoc_dispatch_sym == :parallel) THEN 2 ELSE (IF (rtoc_dispatch_sym == :shared) THEN 3 ELSE 1 END) END),
      DEFAULT -> 1
    END;
END
PRIVATE FN mIRLowering__fiber_spawn_call_plan(self: MIRLowering, rt_name: String, ctx_type: String, ctx_var: String, task_config: TaskConfigPlan, pin_mode: ?PinMode) RETURNS FiberSpawnCall ->
    MUTABLE target = PARTIAL MATCH pin_mode START
      PinMode.SymbolValue AS rtoc_pin_sym -> (IF (rtoc_pin_sym == :local) THEN :runtime_submit ELSE (IF (rtoc_pin_sym == :shared) THEN :pinned ELSE :best END) END),
      PinMode.BoolValue AS rtoc_pin_bool -> (IF rtoc_pin_bool THEN :runtime_submit ELSE :best END),
      DEFAULT -> :best
    END;
    RETURN FiberSpawnCall{ target: COPY target, runtime_name: COPY rt_name, ctx_type: COPY ctx_type, ctx_var: COPY ctx_var, task_config: COPY task_config, wait_group_name: NIL, pass_ctx_by_address: FALSE };
END
PRIVATE FN mIRLowering__do_branch_spawn_call_plan(self: MIRLowering, wg_var: String, ctx_type: String, ctx_var: String, task_config: TaskConfigPlan, pinned: Bool) RETURNS FiberSpawnCall ->
    RETURN FiberSpawnCall{ target: IF pinned THEN
      :wait_group_submit
    ELSE
      :best
    END, wait_group_name: COPY IF pinned THEN
      wg_var
    ELSE
      NIL
    END, ctx_type: COPY ctx_type, ctx_var: COPY ctx_var, task_config: COPY task_config, pass_ctx_by_address: TRUE, runtime_name: NIL };
END
PRIVATE FN mIRLowering__profile_dispatch_symbol(self: MIRLowering, dispatch: PinMode) RETURNS String@symbol ->
    RETURN PARTIAL MATCH dispatch START
      PinMode.SymbolValue AS rtoc_symbol -> (IF (rtoc_symbol == :parallel) THEN :parallel ELSE (IF (rtoc_symbol == :shared) THEN :shared ELSE :local END) END),
      DEFAULT -> :local
    END;
END
PRIVATE FN mIRLowering__bg_scheduler_plan(self: MIRLowering, node: BgBlock, names: BgLoweringNames, rt_name: String) RETURNS BgSchedulerPlan ->
    MUTABLE task_cfg = mIRLowering__task_config_plan(self, node.stack_size, node.computed_stack_tier);
    MUTABLE pin_mode: ?PinMode = COPY node.pinned;
    MUTABLE site_id = (names.id + 1);
    MUTABLE site_line: Int64 = 0;
    IF TRUE THEN
      site_line = ((node.token)).line;
    END
    MUTABLE site_col: Int64 = 0;
    IF TRUE THEN
      site_col = ((node.token)).column;
    END
    MUTABLE dispatch: PinMode = IF node.parallel THEN
      PinMode{ SymbolValue: :parallel }
    ELSE
      (IF !(pinMode__pinned?(node.pinned)) THEN
      PinMode{ SymbolValue: :local }
    ELSE
      COPY UNWRAP (node.pinned)
    END)
    END;
    MUTABLE profiled_task_cfg = mIRLowering__profiled_task_config_plan(self, task_cfg, site_id, COPY dispatch);
    RETURN BgSchedulerPlan{ pin_mode: pin_mode, site_id: site_id, site_line: site_line, site_col: site_col, dispatch: dispatch, profiled_task_cfg: COPY profiled_task_cfg, spawn_call: COPY mIRLowering__fiber_spawn_call_plan(self, rt_name, names.ctx_type, names.ctx_var, profiled_task_cfg, COPY dispatch), profile_site: COPY ProfileTaskSite{ site_id: site_id, line: site_line, column: site_col, dispatch: mIRLowering__profile_dispatch_symbol(self, COPY dispatch), form: :stack }, arena_init: ruby_wrap_optional_Set_Emittable(COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_505: ?Set = NIL;
    IF node.arena_mode THEN
      rtoc_ternary_value_505 = Set{ target: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: COPY names.bg_rt, lowered_node_id: NIL, ownership_consumption: NIL } }, field: "arena_mode", lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Lit: COPY Lit{ value: "true", lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    ELSE
      rtoc_ternary_value_505 = NIL;
    END
    rtoc_ternary_value_505? }) };
END
PRIVATE FN mIRLowering__bg_uses_fsm_transform?(MUTABLE self: MIRLowering, node: BgBlock) RETURNS Bool ->
    MUTABLE target_is_bc = !(!(mIRLowering__bc_target?(&self)));
    RETURN !(!((((node.spawn_form == :fsm) AND !(target_is_bc)))));
END
PRIVATE FN mIRLowering__emit_stackful_bg_block(MUTABLE self: MIRLowering, MUTABLE node: BgBlock, names: BgLoweringNames, types: BgTypePlan, capture: BgCaptureMaterialization, body: BgBodyMaterialization, scheduler: BgSchedulerPlan, rt_name: String, captured: {String}Type, analysis: ?CaptureAnalysis) RETURNS !MIRBgBlock ->
    MUTABLE plan = BgStackfulPlan{ id: names.id, ctx_type: COPY names.ctx_type, alloc_var: COPY names.alloc_var, promise_var: COPY names.promise_var, ctx_var: COPY names.ctx_var, blk_label: COPY names.blk_label, bg_rt: COPY names.bg_rt, rt_name: COPY rt_name, promise_zig: COPY types.promise_zig, is_void: types.is_void, capture_fields: COPY capture.capture_fields, capture_inits: COPY capture.capture_inits, capture_frees: COPY capture.capture_frees, promoted_decls: COPY capture.promoted_decls, profile_site: COPY scheduler.profile_site, arena_init: COPY scheduler.arena_init, spawn_call: COPY scheduler.spawn_call, alloc_expr: COPY TRY (mIRLowering__bg_alloc_expr(self, node, rt_name)), run_body: COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_506: ?[]Emittable = NIL;
    IF (body.emit_body.length() == 0) THEN
      rtoc_ternary_value_506 = body.run_body;
    ELSE
      rtoc_ternary_value_506 = body.emit_body;
    END
    rtoc_ternary_value_506? } };
    MUTABLE bg = MIRBgBlock{ code: BgBlockPlan{ BgStackfulPlan: COPY plan }, captures: COPY captured, run_body: COPY body.run_body, fsm_structure: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, boundary_fact: NIL, result_type: NIL };
    bg.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY TRY (aST__full_type_mut(Locatable{ BgBlock: COPY node })) }));
    bg.boundary_fact = TRY (mIRLowering__execution_boundary_fact(&self, :bg, mIRLowering__execution_boundary_dispatch(self, node.parallel, Pinned{ BoolValue: CAST(node.pinned AS Bool)}), analysis));
    RETURN bg;
END
PRIVATE FN mIRLowering__bg_alloc_expr(self: MIRLowering, node: BgBlock, rt_name: String) RETURNS !Emittable ->
    MUTABLE receiver = Ident{ name: COPY rt_name, lowered_node_id: NIL, ownership_consumption: NIL };
    IF ((node.pinned == PinMode{ BoolValue: TRUE }) OR (node.pinned == PinMode{ SymbolValue: :local })) THEN
      MUTABLE sched = MIRMethodCall{ receiver: Emittable{ Ident: COPY receiver }, method: "getSched", args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
      RETURN Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ MIRMethodCall: COPY sched }, field: "allocator", lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    RETURN Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY receiver }, method: "heapAlloc", args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } };
END
PRIVATE FN mIRLowering__bg_body_materialization(MUTABLE self: MIRLowering, MUTABLE node: BgBlock, caps: FiberCtxBuilderResult, analysis: ?CaptureAnalysis, pointer_captures: [Set]String, bg_rt: String, id: MIRLoweringGeneratedId, is_void: Bool, inner_t: Type, capture_close_plans: {String}ResourceClosePlan) RETURNS !BgBodyMaterialization ->
    MUTABLE run_body: []Emittable = List[];
    MUTABLE emit_body: []Emittable = List[];
    mIRLowering__with_bg_fiber_body_context(&self, pointer_captures, %() USE(analysis, bg_rt, caps, capture_close_plans, id, inner_t, is_void, MUTABLE node, MUTABLE run_body, MUTABLE self) -> mIRLowering__with_fiber_capture_map(&self, caps.capture_map, caps.capture_symbols, bg_rt, %() USE(analysis, caps, capture_close_plans, id, inner_t, is_void, MUTABLE node, MUTABLE run_body, MUTABLE self) -> {
    MUTABLE lowered = TRY (mIRLowering__lower_bg_body_steps(&self, &node, id, is_void, inner_t));
    run_body = TRY (mIRLowering__finalized_boundary_body_for_emit(&self, ((TRY (mIRLowering__capture_ownership_mirror_nodes(self, caps, analysis, "__ctx_${mIRLoweringGeneratedId__to_s(id)}", capture_close_plans)) + TRY (mIRLowering__capture_cleanup_stmts(self, caps.specs, "__ctx_${mIRLoweringGeneratedId__to_s(id)}"))) + lowered.run_body)));
    emit_body = run_body |> WHERE !(mIRLowering__capture_ownership_mirror_node?(self, _, "__ctx_${mIRLoweringGeneratedId__to_s(id)}"));
    NIL
    }));
    RETURN BgBodyMaterialization{ run_body: COPY run_body, emit_body: COPY emit_body };
END
PRIVATE FN mIRLowering__bg_body_steps(self: MIRLowering, node: BgBlock) RETURNS ![]BgBodyStep ->
    MUTABLE steps: []BgBodyStep = List[];
    FOR rtoc_stmt IN node.body DO
    IF rtoc_stmt IS_A ThenChain AS rtoc_then_chain THEN
      FOR rtoc_step IN rtoc_then_chain.steps DO
      &steps.append(BgBodyStep{ expr: COPY rtoc_step.expr, binding: COPY rtoc_step.binding });
      END
    ELSE
      &steps.append(BgBodyStep{ expr: COPY rtoc_stmt, binding: NIL });
    END
    END
    RETURN steps;
END
PRIVATE FN mIRLowering__lower_bg_body_steps(MUTABLE self: MIRLowering, MUTABLE node: BgBlock, id: MIRLoweringGeneratedId, is_void: Bool, inner_t: Type) RETURNS !BgBodyMaterialization ->
    MUTABLE steps = TRY (mIRLowering__bg_body_steps(self, node));
    MUTABLE last_step: ?BgBodyStep = &steps.pop();
    MUTABLE body_mir: []Emittable = List[];
    FOR _ IN steps DO
    TRY (mIRLowering__lower_bg_pre_step(&self, _, &body_mir));
    END
    TRY (mIRLowering__lower_bg_result_step(&self, last_step, &body_mir, id, is_void, inner_t));
    RETURN BgBodyMaterialization{ run_body: COPY body_mir, emit_body: COPY body_mir };
END
PRIVATE FN mIRLowering__lower_bg_pre_step(MUTABLE self: MIRLowering, step: BgBodyStep, MUTABLE body_mir: []Emittable) RETURNS !Void ->
    MUTABLE mir: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(step.expr)));
    MUTABLE binding: ?String = COPY step.binding;
    IF !(binding) THEN
      MUTABLE mir = TRY (mIRLowering__finalize_bg_discard_expr(&self, step.expr, CAST(mir AS NodeRoot)));
    END
    MUTABLE step_pending = TRY (mIRLowering__flush_pending(&self));
    MUTABLE mir_nodes = TRY (mIRLowering__bg_mir_nodes(self, castNodeRootToMir( CAST(mir AS NodeRoot))));
    MUTABLE produced: []Emittable = List[];
    IF binding EXISTS AS binding_name THEN
      produced = (step_pending + List[Emittable{ Let: COPY Let{ name: COPY binding_name, init: COPY UNWRAP (mir_nodes.last()), mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }]);
    ELSE
      produced = (step_pending + mir_nodes);
    END
    body_mir = ruby_array_concat_Emittable__mir_lowering(body_mir, TRY (mIRLowering__guard_bg_shared_node_statement(&self, step.expr, produced)));
    NIL;
END
PRIVATE FN mIRLowering__lower_bg_result_step(MUTABLE self: MIRLowering, step: ?BgBodyStep, MUTABLE body_mir: []Emittable, id: MIRLoweringGeneratedId, is_void: Bool, inner_t: Type) RETURNS !Void ->
    IF step EXISTS AS step_value THEN
      MUTABLE step_value_mutable = COPY step_value;
      IF (is_void OR step_value_mutable.expr IS_A Assignment) THEN
        TRY (mIRLowering__lower_bg_statement_result(&self, step_value_mutable, &body_mir));
        RETURN;
      END
      TRY (mIRLowering__lower_bg_value_result(&self, step_value_mutable, &body_mir, id, inner_t));
    ELSE
      RETURN;
    END
END
PRIVATE FN mIRLowering__lower_bg_statement_result(MUTABLE self: MIRLowering, step: BgBodyStep, MUTABLE body_mir: []Emittable) RETURNS !Void ->
    MUTABLE last_mir: Emittable = castNodeRootToEmittable(TRY (mIRLowering__finalize_bg_discard_expr(&self, step.expr, CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(step.expr))) AS NodeRoot))));
    MUTABLE last_pending = TRY (mIRLowering__flush_pending( &self));
    body_mir = ruby_array_concat_Emittable__mir_lowering(body_mir, TRY (mIRLowering__guard_bg_shared_node_statement(&self, step.expr, (last_pending + [last_mir]))));
    NIL;
END
PRIVATE FN mIRLowering__finalize_bg_discard_expr(MUTABLE self: MIRLowering, expr: Locatable, MUTABLE mir: NodeRoot) RETURNS !NodeRoot ->
    MUTABLE finalized, hoisted_discard = TRY (mIRLowering__materialize_statement_discard(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(expr), mir));
    IF !((mIRLowering__discard_expr_stmt?(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(expr), castNodeRootToEmittable(finalized)) AND !(hoisted_discard))) THEN
      RETURN COPY finalized;
    END
    RETURN NodeRoot{ Emittable: COPY CAST(ExprStmt{ expr: COPY castNodeRootToEmittable(finalized), discard: TRUE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) };
END
PRIVATE FN mIRLowering__lower_bg_value_result(MUTABLE self: MIRLowering, MUTABLE step: BgBodyStep, MUTABLE body_mir: []Emittable, id: MIRLoweringGeneratedId, inner_t: Type) RETURNS !Void ->
    MUTABLE result_alloc: ?String@symbol = TRY (mIRLowering__escaping_value_alloc(&self, inner_t));
    MUTABLE last_mir: Emittable = CAST(mIRLowering__with_decl_alloc(&self, result_alloc, %() USE(step, MUTABLE self) -> {
    MUTABLE rtoc_lambda_result_515: Emittable = UNWRAP (TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(step.expr))));
    rtoc_lambda_result_515
    }) AS Emittable);
    last_mir = TRY (mIRLowering__place_value_for_destination(&self, &last_mir, &step.expr, result_alloc, TypeTypeInput{ Type: COPY inner_t }));
    IF TRY (mIRLowering__mir_allocates?(&self, last_mir)) THEN
      last_mir = TRY (mIRLowering__hoist_alloc(&self, &last_mir, &step.expr, TRUE));
    END
    MUTABLE last_pending = TRY (mIRLowering__flush_pending(&self));
    MUTABLE result_target = FieldGet{ object: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__ctx_${mIRLoweringGeneratedId__to_s(id)}", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "inner", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "result", lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE shape = TRY (asyncResultShape__promise(inner_t));
    MUTABLE stored_value = mIRLowering__async_payload_storage_value(&self, last_mir, shape);
    MUTABLE produced = ((last_pending + TRY (mIRLowering__ownership_marks_for_transferred_temp(&self, last_mir, :heap))) + [Emittable{ Set: COPY Set{ target: Emittable{ FieldGet: COPY result_target }, value: COPY stored_value, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }]);
    body_mir = ruby_array_concat_Emittable__mir_lowering(body_mir, TRY (mIRLowering__guard_bg_shared_node_statement(&self, step.expr, produced)));
    NIL;
END
PRIVATE FN mIRLowering__guard_bg_shared_node_statement(MUTABLE self: MIRLowering, stmt: Locatable, nodes: []Emittable) RETURNS ![]Emittable ->
    RETURN TRY (mIRLowering__guard_shared_node_statement(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(stmt), nodes));
END
PRIVATE FN mIRLowering__bg_mir_nodes(self: MIRLowering, mir: Mir) RETURNS ![]Emittable ->
    IF mir IS_A []Emittable AS array THEN
      RETURN array |> WHERE TRUE;
    ELSE
      RETURN CAST([mir] AS []Emittable);
    END
END
PRIVATE FN mIRLowering__enforce_bg_capture_strategies_mut(MUTABLE self: MIRLowering, node: Node, ignored_captured: {String}Type) RETURNS !Void ->
    MUTABLE strategies: {String}Strategy = {};
    IF node__capture_analysis(node) EXISTS AS rtoc_analysis THEN
      strategies = COPY rtoc_analysis.strategies;
    END
    # Ruby's `select` on a hash keeps a hash: every message below needs the
    # name alongside the strategy, which `.values()` had already thrown away.
    MUTABLE refused: {String}Refuse = {};
    FOR rtoc_name IN strategies.keys() DO
      PARTIAL MATCH UNWRAP (strategies[rtoc_name]) START
        Strategy.Refuse AS rtoc_refuse -> refused[rtoc_name] = COPY rtoc_refuse;,
        DEFAULT -> PASS;
      END
    END
    IF (refused.length() == 0) THEN
      RETURN;
    END
    MUTABLE lines: []String = List[];
    FOR rtoc_name IN refused.keys() DO
      MUTABLE rtoc_strategy: Refuse = COPY UNWRAP (refused[rtoc_name]);
      MUTABLE hint = PARTIAL MATCH rtoc_strategy.reason START
        :pointer_passed_without_transfer -> "'${rtoc_name}' is @pool/@map/HashMap \u{2014} wrap in @shared:locked, or GIVE/COPY inside the BG body.",
        :list_borrow_without_transfer -> "'${rtoc_name}' is @list \u{2014} GIVE inside the BG body to transfer ownership, or COPY to deep-copy.",
        :pool_borrow_without_transfer -> "'${rtoc_name}' is @pool \u{2014} wrap in @shared:locked, or GIVE inside the BG body.",
        :array_borrow_without_transfer -> "'${rtoc_name}' is a slice borrow \u{2014} COPY inside the BG body for a fresh heap copy.",
        :heap_backed_without_transfer -> "'${rtoc_name}' is heap-backed \u{2014} GIVE/COPY inside the BG body, or use @multiowned/@shared.",
        DEFAULT -> "'${rtoc_name}' cannot be safely captured (${rtoc_strategy.reason})."
      END;
      &lines.append("  - ${hint}");
    END
    panic((("BG block captures values that cannot safely cross the fiber boundary:\n" $+ lines.join("\n")) $+ "\n(See docs/agents/vm-bugs.md for the ownership rules.)"));
END
PRIVATE FN mIRLowering__fsm_bg_block_from_transform_mut(MUTABLE self: MIRLowering, node: BgBlock, transform_result: FsmLoweringResult, captured: {String}Type, analysis: ?CaptureAnalysis) RETURNS !MIRBgBlock ->
    MUTABLE fsm_structure = COPY transform_result.structure;
    MUTABLE result_type = TRY (type__tense_type( TRY (type__from_node_mut( Locatable{ BgBlock: COPY node }, "FSM BG result"))));
    fsm_structure.owned_result_required = !(!(((TRUE AND TRY (mIRLowering__ownership_tracked_transfer_type?(&self, result_type))))));
    TRY (mIRChecker__check_fsm_structure_mut(fsm_structure, Locatable{ BgBlock: COPY node }));
    MUTABLE bg = MIRBgBlock{ code: castFsmBodyToBgBlockPlan( castMIRFsmLoweringResultFsmBodyToFsmBody(COPY transform_result.body)), captures: COPY captured, run_body: List[], fsm_structure: Emittable{ FsmStructure: COPY fsm_structure }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, boundary_fact: NIL, result_type: NIL };
    bg.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY TRY (aST__full_type_mut(Locatable{ BgBlock: COPY node })) }));
    bg.boundary_fact = TRY (mIRLowering__execution_boundary_fact(&self, :bg, mIRLowering__execution_boundary_dispatch(self, node.parallel, Pinned{ BoolValue: CAST(node.pinned AS Bool)}), analysis));
    RETURN bg;
END
PRIVATE FN mIRLowering__lower_bg_stream_block(MUTABLE self: MIRLowering, node: BgStreamBlock) RETURNS !MIRLoweringReturnValue ->
    MUTABLE id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_517 = mIRLowering__lowering_counters(&self);
    mIRLoweringCounters__next_stream_generator_id(&rtoc_mutable_receiver_517) };
    MUTABLE expected_t: ?Type = TRY (type__from_node(mIRLowering__function_state(&self).current_expected_type));
    MUTABLE tense_t_branch_value: ?Type = NIL;
    IF TRY (mIRLowering__bg_stream_expected_type?(self, expected_t)) THEN
      tense_t_branch_value = expected_t?;
    ELSE
      tense_t_branch_value = TRY (type__new(TypeConstructionInput{ Type: COPY TRY (aST__full_type_mut(Locatable{ BgStreamBlock: COPY node })) }));
    END
    MUTABLE tense_t: Type = tense_t_branch_value?;
    MUTABLE is_inf = TRY (type__inf_stream?(tense_t));
    MUTABLE stream_zig: String = "";
    IF (TRY (type__dynamic_stream?(tense_t)) AND !(TRY (type__split_open_stream?(tense_t)))) THEN
      MUTABLE element_t = UNWRAP (TRY (type__element_type((TRY (type__tense_type(tense_t))))));
      stream_zig = "CheatLib.Stream(${TRY (type__nested_zig_type(element_t))})";
    ELSE
      stream_zig = TRY (type__zig_type(tense_t));
    END
    MUTABLE ctx_type = "__SgCtx${mIRLoweringGeneratedId__to_s(id)}";
    MUTABLE alloc_var = "__sg${mIRLoweringGeneratedId__to_s(id)}_alloc";
    MUTABLE stream_var = "__sg${mIRLoweringGeneratedId__to_s(id)}_stream";
    MUTABLE ctx_var = "__sg${mIRLoweringGeneratedId__to_s(id)}_ctx";
    MUTABLE blk_label = "__sg${mIRLoweringGeneratedId__to_s(id)}";
    MUTABLE local_stream = "__sg${mIRLoweringGeneratedId__to_s(id)}_local";
    IF mIRLowering__bc_target?(&self) THEN
      MUTABLE run_body = mIRLowering__with_stream_body_context(&self, local_stream, is_inf, IF is_inf THEN
        NIL
      ELSE
        blk_label
      END, NIL, %() USE(node, MUTABLE self) -> {
    MUTABLE rtoc_lambda_result_518: []Emittable = List[];
    FOR MUTABLE rtoc_for_elem_518 IN node.body DO
      MUTABLE rtoc_stmt_518: MIRLoweringLowerableStmt = castLocatableToMIRLoweringLowerableStmt__mir_lowering(rtoc_for_elem_518);
      MUTABLE rtoc_lowered_518: ?Emittable = TRY (mIRLowering__lower(&self, &rtoc_stmt_518));
      IF rtoc_lowered_518 EXISTS AS rtoc_lowered_518_value THEN
        &rtoc_lambda_result_518.append(rtoc_lowered_518_value);
      END
    END
    rtoc_lambda_result_518
      });
      IF is_inf THEN
        MUTABLE captures_map: {String}Type = {};
        IF node.capture_analysis EXISTS AS stream_capture_analysis THEN
          captures_map = COPY stream_capture_analysis.captures;
        END
        MUTABLE spawn = StreamSpawn{ captures: captures_map, body: COPY run_body, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, boundary_fact: NIL };
        spawn.boundary_fact = TRY (mIRLowering__execution_boundary_fact(&self, :stream_spawn, :local, node.capture_analysis));
        RETURN MIRLoweringReturnValue{ StreamSpawn: COPY spawn };
      END
      MUTABLE block = MIRBlockExpr{ label: COPY blk_label, body: COPY ([Emittable{ Let: COPY Let{ name: COPY local_stream, init: Emittable{ MakeList: COPY MakeList{ elem_type: "anytype", items: List[], alloc: :frame, minimum_capacity: NIL, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: COPY TRY (type__new(TypeConstructionInput{ StringValue: COPY "anytype" })), suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }] + run_body + [Emittable{ BreakStmt: COPY BreakStmt{ label: COPY blk_label, value: Emittable{ Ident: COPY Ident{ name: COPY local_stream, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }]), lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
      IF TRY (type__split_open_stream?(tense_t)) THEN
        RETURN MIRLoweringReturnValue{ InlineBc: COPY InlineBc{ op: :split_stream_new, args: [Emittable{ MIRBlockExpr: COPY block }], stdlib_def: {:tag: :split_stream}, suppress_try: FALSE, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
      RETURN MIRLoweringReturnValue{ MIRBlockExpr: COPY block };
    END
    MUTABLE analysis: ?CaptureAnalysis = COPY node.capture_analysis;
    MUTABLE rt_name = mIRLowering__runtime_binding_name(&self);
    TRY (mIRLowering__enforce_bg_capture_strategies_mut(&self, Node{ BgStreamBlock: COPY node }, { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_520: ?{Any}Any = NIL;
    IF analysis THEN
      rtoc_ternary_value_520 = analysis.captures;
    ELSE
      rtoc_ternary_value_520 = {};
    END
    rtoc_ternary_value_520? }));
    MUTABLE promoted_names: {String}String = {};
    MUTABLE caps = TRY (fiberCtxBuilder__build(analysis, "ctx", promoted_names, alloc_var, id.value, TRY (mIRLowering__fiber_capture_source_overrides(&self, analysis)), mIRLowering__mir_schema_lookup(&self)));
    MUTABLE capture_fields = ((caps.specs |> SELECT mIRLowering__context_field_decl(self, _.name, _.field_type_zig)) + TRY (mIRLowering__capture_moved_guard_fields(self, caps.specs)));
    MUTABLE capture_inits = ([mIRLowering__context_init_field(self, MIRLoweringName{ SymbolValue: :stream_inner }, Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: COPY stream_var, lowered_node_id: NIL, ownership_consumption: NIL } }, field: "inner", lowered_node_id: NIL, ownership_consumption: NIL } }), mIRLowering__context_init_field(self, MIRLoweringName{ SymbolValue: :alloc }, Emittable{ Ident: COPY Ident{ name: COPY alloc_var, lowered_node_id: NIL, ownership_consumption: NIL } })] + (caps.specs |> SELECT mIRLowering__context_init_field(self, MIRLoweringName{ StringValue: COPY _.name }, _.init_value_mir)));
    MUTABLE stream_run_body: ?[]Emittable = NIL;
    MUTABLE stream_emit_body: []Emittable = List[];
    MUTABLE stream_capture_cleanups = TRY (mIRLowering__capture_cleanup_stmts(self, caps.specs, "ctx"));
    MUTABLE inherited_capture_names = (caps.specs |> SELECT:? (IF captureSpec__needs_moved_guard?(_) THEN
      "ctx.${_.name}"
    ELSE
      NIL
    END) |> WHERE _ != NIL) |> DISTINCT _;
    mIRLowering__with_stream_body_context(&self, local_stream, is_inf, NIL, inherited_capture_names, %() USE(analysis, caps, node, stream_capture_cleanups, MUTABLE stream_run_body, MUTABLE self) -> {
    MUTABLE rtoc_lambda_result_522 = mIRLowering__with_fiber_capture_map(&self, caps.capture_map, caps.capture_symbols, "__rt", %() USE(analysis, caps, node, stream_capture_cleanups, MUTABLE stream_run_body, MUTABLE self) -> {
    MUTABLE body_mir: []Any = List[];
    FOR MUTABLE rtoc_for_elem_522 IN node.body DO
      MUTABLE rtoc_stmt_522: MIRLoweringLowerableStmt = castLocatableToMIRLoweringLowerableStmt__mir_lowering(rtoc_for_elem_522);
      MUTABLE mir: ?Emittable = TRY (mIRLowering__lower(&self, &rtoc_stmt_522));
      MUTABLE pending = TRY (mIRLowering__flush_pending(&self));
      MUTABLE mir_nodes: []Any = List[];
      IF mir EXISTS AS mir_value THEN
        mir_nodes = [CAST(mir_value AS Any)];
      END
      body_mir = (body_mir + (pending + mir_nodes));
    END
    stream_run_body = TRY (mIRLowering__finalized_boundary_body_for_emit(&self, ((TRY (mIRLowering__capture_ownership_mirror_nodes(self, caps, analysis, "ctx")) + stream_capture_cleanups) + body_mir)));
    stream_emit_body = UNWRAP (stream_run_body) |> WHERE !((mIRLowering__capture_ownership_mirror_node?(self, _, "ctx") OR stream_capture_cleanups.contains?(_)));
    NIL
    });
    rtoc_lambda_result_522
    });
    MUTABLE promoted_decls = TRY (mIRLowering__capture_setup_stmts(self, caps.specs));
    MUTABLE task_cfg = mIRLowering__task_config_plan(self, node.stack_size, node.computed_stack_tier);
    MUTABLE spawn_call = mIRLowering__fiber_spawn_call_plan(self, rt_name, ctx_type, ctx_var, task_cfg, PinMode{ SymbolValue: :local });
    MUTABLE plan = BgStreamPlan{ id: id.value, ctx_type: COPY ctx_type, alloc_var: COPY alloc_var, stream_var: COPY stream_var, ctx_var: COPY ctx_var, blk_label: COPY blk_label, stream_zig: COPY stream_zig, local_stream: COPY local_stream, capture_fields: COPY capture_fields, capture_inits: COPY capture_inits, promoted_decls: COPY promoted_decls, capture_cleanups: COPY stream_capture_cleanups, body: COPY stream_emit_body, spawn_call: COPY spawn_call, rt_name: COPY rt_name };
    MUTABLE bg = MIRBgBlock{ code: BgBlockPlan{ BgStreamPlan: COPY plan }, captures: COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_523: ?{Any}Any = NIL;
    IF analysis THEN
      rtoc_ternary_value_523 = analysis.captures;
    ELSE
      rtoc_ternary_value_523 = {};
    END
    rtoc_ternary_value_523? }, run_body: COPY UNWRAP (stream_run_body), fsm_structure: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, boundary_fact: NIL, result_type: NIL };
    bg.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY tense_t }));
    bg.boundary_fact = TRY (mIRLowering__execution_boundary_fact(&self, :bg_stream, :local, analysis));
    RETURN MIRLoweringReturnValue{ MIRBgBlock: COPY bg };
END
PRIVATE FN mIRLowering__lower_yield(MUTABLE self: MIRLowering, MUTABLE node: YieldExpr) RETURNS !Emittable ->
    MUTABLE stream_local = (mIRLowering__capture_state(&self).current_stream_local OR_ELSE "__stream_local");
    MUTABLE lowered: ?Emittable = mIRLowering__with_decl_alloc(&self, :heap, %() USE(MUTABLE node, MUTABLE self) -> {
    MUTABLE value: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(node.expr)));
    TRY (mIRLowering__place_value_for_destination(&self, UNWRAP (value), &node.expr, :heap, TypeTypeInput{ Type: COPY TRY (aST__full_type_mut(node.expr)) }))
    });
    IF TRY (mIRLowering__mir_allocates?(&self, lowered)) THEN
      lowered = TRY (mIRLowering__hoist_alloc(&self, UNWRAP (lowered), &node.expr, TRUE));
    END
    MUTABLE transfer_marks = TRY (mIRLowering__ownership_marks_for_transferred_temp(&self, UNWRAP (lowered), :heap));
    IF (mIRLowering__bc_target?(&self) AND (mIRLowering__capture_state(&self).current_stream_is_inf != NIL)) THEN
      MUTABLE stream_yield = StreamYield{ value: COPY UNWRAP (lowered), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
      IF (transfer_marks.length() == 0) THEN
        RETURN Emittable{ StreamYield: COPY stream_yield };
      ELSE
        RETURN Emittable{ ScopeBlock: COPY ScopeBlock{ body: COPY (transfer_marks + [Emittable{ StreamYield: COPY stream_yield }]), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
      END
    END
    MUTABLE base_contract = TRY (callableContract__no_ownership(1));
    MUTABLE push_contract_branch_value: ?CallableContract = NIL;
    IF ((transfer_marks.length() == 0) OR !(lowered IS_A Ident)) THEN
      push_contract_branch_value = base_contract;
    ELSE
      MUTABLE operand = ownershipOperandFact__owned_binding(CAST(emittable__name(UNWRAP (lowered)) AS String), TRY (type__from_node_mut(node.expr, "YIELD ownership transfer")), "stream YIELD push", :heap);
      push_contract_branch_value = callableContract__new(base_contract.signature, TRY (ownershipContract__consume_operands([operand])), 1);
    END
    MUTABLE push_contract: CallableContract = push_contract_branch_value?;
    MUTABLE push = MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: COPY stream_local, lowered_node_id: NIL, ownership_consumption: NIL } }, method: "push", args: [CAST(lowered AS Any)], try_wrap: TRUE, callable_contract: COPY push_contract, owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    IF (transfer_marks.length() == 0) THEN
      RETURN Emittable{ MIRMethodCall: COPY push };
    ELSE
      RETURN Emittable{ ScopeBlock: COPY ScopeBlock{ body: COPY (transfer_marks + [Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ MIRMethodCall: COPY push }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }]), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
END
PRIVATE FN mIRLowering__lower_close_stream(MUTABLE self: MIRLowering, ignored_node: CloseStream) RETURNS !Emittable ->
    MUTABLE stream_local = (mIRLowering__capture_state(&self).current_stream_local OR_ELSE "__stream_local");
    MUTABLE close = ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: COPY stream_local, lowered_node_id: NIL, ownership_consumption: NIL } }, method: "close", args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    MUTABLE label: ?String = COPY mIRLowering__capture_state(&self).current_stream_close_label;
    IF (mIRLowering__bc_target?(&self) AND (label != NIL)) THEN
      RETURN Emittable{ ScopeBlock: COPY ScopeBlock{ body: COPY [Emittable{ ExprStmt: COPY close }, Emittable{ BreakStmt: COPY BreakStmt{ label: COPY label, value: Emittable{ Ident: COPY Ident{ name: COPY stream_local, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
    RETURN Emittable{ ScopeBlock: COPY ScopeBlock{ body: COPY [Emittable{ ExprStmt: COPY close }, Emittable{ ReturnStmt: COPY ReturnStmt{ value: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
END
PRIVATE FN mIRLowering__next_result_owned_alloc(MUTABLE self: MIRLowering, promise_type: Type, result_type: Type, fallback_alloc: String@symbol) RETURNS !?String@symbol ->
    IF type__promise_list?(promise_type) THEN
      RETURN fallback_alloc;
    END
    IF TRY (type__observable_array_future?(promise_type)) THEN
      RETURN fallback_alloc;
    END
    IF (type__observable?(promise_type) AND TRY (mIRLowering__ownership_bearing_type?(&self, result_type))) THEN
      RETURN :heap;
    END
    IF TRY (mIRLowering__ownership_bearing_type?(&self, result_type)) THEN
      RETURN :heap;
    END
    RETURN NIL;
END
PRIVATE FN mIRLowering__next_expr_plan(MUTABLE self: MIRLowering, node: NextExpr, alloc_sym: String@symbol) RETURNS !NextExprPlan ->
    MUTABLE promise_type = TRY (type__new(TypeConstructionInput{ Type: COPY TRY (aST__full_type_mut(node.expr)) }));
    MUTABLE result_type = TRY (aST__full_type_mut(Locatable{ NextExpr: COPY node }));
    # The shape comes off the identifier's symbol entry; an owned value out of
    # a nested IF expression has no owner on the success path.
    MUTABLE async_shape: ?AsyncResultShape = NIL;
    IF node.expr IS_A Identifier THEN
      IF locatable__symbol(node.expr) EXISTS AS rtoc_expr_symbol THEN
        async_shape = symbolEntry__async_result_shape(rtoc_expr_symbol);
      END
    END
    MUTABLE tense_plan: ?TenseOperationPlan = COPY CAST(node.tense_plan AS ?TenseOperationPlan);
    MUTABLE scalar_future = (((IF async_shape EXISTS AS promise_shape THEN asyncResultShape__promise?(promise_shape) ELSE FALSE END) OR TRY (type__single_future?(promise_type))) OR type__shared_promise?(promise_type));
    IF (scalar_future AND FALSE) THEN
      async_shape = TRY (asyncResultShape__promise(TRY (type__tense_type(promise_type)), type__shared_promise?(promise_type)));
    END
    IF (scalar_future AND ((!(tense_plan) OR (tense_plan.operation != TenseOperationKind.Next)))) THEN
      panic("scalar NEXT lowering requires its annotation-produced TenseOperationPlan");
    END
    # A MATCH arm is not a value expression for an IF-expression branch, and
    # the plan is optional -- both want the statement form.
    MUTABLE source_kind: String@symbol = :plain;
    IF (type__promise_list?(promise_type) AND FALSE) THEN
      source_kind = :promise_list;
    ELSE_IF tense_plan EXISTS AS rtoc_tense_plan THEN
      PARTIAL MATCH rtoc_tense_plan.backend_form START
        TenseBackendForm.SharedPromiseNext -> source_kind = :shared_promise;,
        TenseBackendForm.ObservableStringNext -> source_kind = :observable_string;,
        DEFAULT -> PASS;
      END
    ELSE_IF TRY (type__observable_array_future?(promise_type)) THEN
      source_kind = :observable_list;
    ELSE_IF (type__observable?(promise_type) AND TRY (mIRLowering__observable_next_string?(self, promise_type))) THEN
      source_kind = :observable_string;
    END
    RETURN NextExprPlan{ source_kind: COPY source_kind, promise_type: COPY promise_type, async_result_shape: COPY async_shape, result_type: COPY result_type, result_alloc: COPY TRY (mIRLowering__next_result_owned_alloc(&self, promise_type, result_type, alloc_sym)), inner: COPY CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(node.expr))) AS Emittable) };
END
PRIVATE FN mIRLowering__observable_next_string?(self: MIRLowering, promise_type: Type) RETURNS !Bool ->
    MUTABLE tt = TRY (type__tense_type(promise_type));
    MUTABLE wt:? = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_528: ?Type = NIL;
    IF type__optional?(tt) THEN
      rtoc_ternary_value_528 = TRY (type__wrapped_type(tt));
    ELSE
      rtoc_ternary_value_528 = tt;
    END
    rtoc_ternary_value_528 };
    RETURN !(!((IF wt != NIL THEN
      TRY (type__string?(wt))
    ELSE
      NIL
    END)));
END
PRIVATE FN mIRLowering__bg_stream_expected_type?(self: MIRLowering, type_info: ?Type) RETURNS !Bool ->
    IF type_info EXISTS AS type_info_value THEN
      RETURN ((TRY (type__inf_stream?(type_info_value)) OR TRY (type__open_stream?(type_info_value))) OR TRY (type__bounded_stream?(type_info_value)));
    ELSE
      RETURN FALSE;
    END
END
PRIVATE FN mIRLowering__lower_next_expr(MUTABLE self: MIRLowering, MUTABLE node: NextExpr, alloc_sym: String@symbol = :frame) RETURNS !Emittable ->
    MUTABLE plan = TRY (mIRLowering__next_expr_plan(&self, node, alloc_sym));
    MUTABLE promise_type = COPY plan.promise_type;
    MUTABLE result_t = COPY plan.result_type;
    IF nextExprPlan__promise_list?(plan) THEN
      MUTABLE promise_list_inner = COPY plan.inner;
      IF mIRLowering__bc_target?(&self) THEN
        MUTABLE call = MIRMethodCall{ receiver: COPY promise_list_inner, method: "next", args: List[], try_wrap: TRUE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: COPY alloc_sym, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
        call.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY result_t }));
        RETURN Emittable{ MIRMethodCall: COPY call };
      END
      MUTABLE item_shape = TRY (asyncResultShape__promise_list_item(promise_type));
      MUTABLE tmp_id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_530 = mIRLowering__lowering_counters(&self);
      mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_530) };
      MUTABLE promise_list_label = "__next_all_${mIRLoweringGeneratedId__to_s(tmp_id)}";
      MUTABLE results_var = "__next_results_${mIRLoweringGeneratedId__to_s(tmp_id)}";
      RETURN Emittable{ NextPromiseList: COPY NextPromiseList{ list_expr: COPY promise_list_inner, async_shape: COPY item_shape, label: COPY promise_list_label, results_var: COPY results_var, alloc: COPY alloc_sym, result_type: COPY result_t } };
    END
    IF nextExprPlan__observable_list?(plan) THEN
      MUTABLE observable_list_inner = COPY plan.inner;
      MUTABLE call = MIRMethodCall{ receiver: COPY observable_list_inner, method: "materializeNext", args: [CAST(AllocatorRef{ kind: COPY alloc_sym, lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: TRUE, callable_contract: TRY (callableContract__no_ownership(1)), owned_result_alloc: COPY alloc_sym, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
      call.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY result_t }));
      RETURN Emittable{ MIRMethodCall: COPY call };
    END
    IF nextExprPlan__observable_string?(plan) THEN
      MUTABLE observable_string_inner = COPY plan.inner;
      MUTABLE observable_string_label = "__obs_next_string_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_531 = mIRLowering__lowering_counters(&self);
      mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_531)) }}";
      MUTABLE materialize = MIRMethodCall{ receiver: COPY observable_string_inner, method: "materialize", args: [CAST(AllocatorRef{ kind: :heap, lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: TRUE, callable_contract: TRY (callableContract__no_ownership(1)), owned_result_alloc: :heap, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
      materialize.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY result_t }));
      MUTABLE block = MIRBlockExpr{ label: COPY observable_string_label, body: COPY [Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: COPY observable_string_inner, method: "wait", args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ BreakStmt: COPY BreakStmt{ label: COPY observable_string_label, value: Emittable{ MIRMethodCall: COPY materialize }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
      block.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY result_t }));
      RETURN Emittable{ MIRBlockExpr: COPY block };
    END
    MUTABLE receiver = COPY plan.inner;
    IF (TRY (type__stream?(promise_type)) AND !(receiver IS_A Ident)) THEN
      MUTABLE receiver_tmp_id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_533 = mIRLowering__lowering_counters(&self);
      mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_533) };
      MUTABLE label = "__next_recv_${mIRLoweringGeneratedId__to_s(receiver_tmp_id)}";
      MUTABLE temp = "__next_source_${mIRLoweringGeneratedId__to_s(receiver_tmp_id)}";
      MUTABLE block = MIRBlockExpr{ label: COPY label, body: COPY [Emittable{ Let: COPY Let{ name: COPY temp, init: COPY receiver, mutable: TRUE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }, Emittable{ BreakStmt: COPY BreakStmt{ label: COPY label, value: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: COPY temp, lowered_node_id: NIL, ownership_consumption: NIL } }, method: IF TRY (type__stream_step?(result_t)) THEN
        "nextStep"
      ELSE
        "next"
      END, args: List[], try_wrap: TRUE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: COPY plan.result_alloc, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
      block.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY result_t }));
      RETURN Emittable{ MIRBlockExpr: COPY block };
    END
    MUTABLE next_method: String = "";
    IF TRY (type__stream_step?(result_t)) THEN
      next_method = "nextStep";
    ELSE
      next_method = "next";
    END
    MUTABLE boxed_fallible = (!(mIRLowering__bc_target?(&self)) AND ((plan.async_result_shape != NIL) AND (asyncResultShape__boxes_fallible_payload?(((plan.async_result_shape)?)) == TRUE)));
    MUTABLE call = MIRMethodCall{ receiver: COPY receiver, method: COPY next_method, args: List[], try_wrap: !(boxed_fallible), callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: COPY plan.result_alloc, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    IF !(boxed_fallible) THEN
      RETURN Emittable{ MIRMethodCall: COPY call };
    END
    MUTABLE unwrapped_transport = TryExpr{ expr: Emittable{ MIRMethodCall: COPY call }, lowered_node_id: NIL, ownership_consumption: NIL };
    RETURN Emittable{ AsyncPayloadTake: COPY AsyncPayloadTake{ source: Emittable{ TryExpr: COPY unwrapped_transport }, result_type: COPY TRY (type__new(TypeConstructionInput{ Type: COPY result_t })) } };
END
PRIVATE FN mIRLowering__lower_literal(self: MIRLowering, node: Literal) RETURNS !Emittable ->
    IF (node.type == :SYMBOL) THEN
      RETURN Emittable{ SymbolLit: COPY SymbolLit{ value: CAST(node.value AS String), lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE_IF (node.type == :STRING) THEN
      # Ruby escapes each byte of the literal. This is NOT zig_string_lit:
      # that one passes 0x80..0xFF through as raw bytes, while a source
      # literal hex-escapes them too.
      MUTABLE rtoc_lit_text: String = "";
      PARTIAL MATCH node.value START
        TokenValue.StringValue AS rtoc_lit_value -> rtoc_lit_text = COPY rtoc_lit_value;,
        DEFAULT -> PASS;
      END
      MUTABLE escaped = "";
      MUTABLE rtoc_byte_idx: Int64 = 0;
      WHILE (rtoc_byte_idx < rtoc_lit_text.bytes()) DO
        MUTABLE rtoc_b = byteAt(rtoc_lit_text, rtoc_byte_idx);
        IF (rtoc_b == 92) THEN
          &escaped.append("\\\\");
        ELSE_IF (rtoc_b == 34) THEN
          &escaped.append("\\\"");
        ELSE_IF (rtoc_b == 10) THEN
          &escaped.append("\\n");
        ELSE_IF (rtoc_b == 13) THEN
          &escaped.append("\\r");
        ELSE_IF (rtoc_b == 9) THEN
          &escaped.append("\\t");
        ELSE_IF (((rtoc_b >= 0) AND (rtoc_b <= 31)) OR (rtoc_b == 127) OR (rtoc_b >= 128)) THEN
          &escaped.append("\\x");
          &escaped.append("0123456789abcdef".substr((rtoc_b / 16), 1));
          &escaped.append("0123456789abcdef".substr((rtoc_b - ((rtoc_b / 16) * 16)), 1));
        ELSE
          &escaped.append(codepointToString(rtoc_b));
        END
        rtoc_byte_idx = rtoc_byte_idx + 1;
      END
      RETURN Emittable{ Lit: COPY Lit{ value: "\"${escaped}\"", lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE_IF (node.type == :NUMBER) THEN
      IF ruby_union_scalar_equal_optional_CoerceTypeInput_String_symbol( CAST(locatable__coerced_type( Locatable{ Literal: COPY node }) AS ?CoerceTypeInput), :Int64) THEN
      # `node.value.to_i.to_s` over the token union: the number arrives as an
      # Int64 or as the text of one.
      MUTABLE rtoc_int_text: String = "0";
      PARTIAL MATCH node.value START
        TokenValue.Int64Value AS rtoc_int_value -> rtoc_int_text = rtoc_int_value.toString();,
        TokenValue.StringValue AS rtoc_int_str -> rtoc_int_text = (rtoc_int_str.toInt() OR_ELSE 0).toString();,
        DEFAULT -> PASS;
      END
        RETURN Emittable{ Lit: COPY Lit{ value: COPY rtoc_int_text, lowered_node_id: NIL, ownership_consumption: NIL } };
      ELSE
        RETURN Emittable{ Lit: COPY Lit{ value: COPY mIRLowering__float_literal_text(self, CAST(node.value AS MIRLoweringValue)), lowered_node_id: NIL, ownership_consumption: NIL } };
      END
    ELSE_IF (node.type == :INT8) OR (node.type == :INT16) OR (node.type == :INT32) OR (node.type == :UINT16) OR (node.type == :UINT32) OR (node.type == :UINT64) THEN
      RETURN Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ Lit: COPY Lit{ value: COPY CAST(node.value AS String), lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: COPY (CAST({:INT8: "i8", :INT16: "i16", :INT32: "i32", :UINT16: "u16", :UINT32: "u32", :UINT64: "u64"} AS {String@symbol}String))[node.type]?, method: :as, lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE_IF (node.type == :FLOAT32) THEN
      RETURN Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ Lit: COPY Lit{ value: COPY mIRLowering__float_literal_text(self, CAST(node.value AS MIRLoweringValue)), lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: "f32", method: :as, lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE_IF (node.type == symbol("NIL")) THEN
      RETURN Emittable{ Lit: COPY Lit{ value: "null", lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE
      RETURN Emittable{ Lit: COPY Lit{ value: COPY CAST(node.value AS String), lowered_node_id: NIL, ownership_consumption: NIL } };
    END
END
PRIVATE FN mIRLowering__float_literal_text(self: MIRLowering, value: MIRLoweringValue) RETURNS String ->
    MUTABLE s = COPY CAST(value AS String);
    IF (ruby_union_scalar_equal_Value_Int64(value, castValueToInt64(value)) AND !(s.contains?("."))) THEN
      RETURN "${s}.0";
    ELSE
      RETURN s;
    END
END
PRIVATE FN mIRLowering__lower_identifier(MUTABLE self: MIRLowering, MUTABLE node: Identifier) RETURNS !Emittable ->
    IF mIRLowering__synthetic_pipeline_binding_name?(self, node.name) THEN
      MUTABLE line: String = "?";
      IF TRUE THEN
        line = ((node.token)).line;
      END
      panic("{}{}in the same pipeline expression where they are used.");
    END
    IF (TRUE AND node.fn_ref) THEN
      RETURN Emittable{ FnRef: COPY FnRef{ name: mIRLowering__zig_safe_name(self, node.name), lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    MUTABLE rc_map = (mIRLowering__capability_state(&self).rc_unwrap_map OR_ELSE {});
    IF rc_map.contains?(node.name) THEN
      RETURN Emittable{ Ident: COPY Ident{ name: COPY UNWRAP (rc_map[node.name]), lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    MUTABLE locked_map = (mIRLowering__capability_state(&self).locked_unwrap_map OR_ELSE {});
    MUTABLE alias_name: ?LockedUnwrapMapValue = COPY locked_map[node.name];
    IF alias_name? IS_A String AS string THEN
      RETURN Emittable{ Ident: COPY Ident{ name: COPY string, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    MUTABLE capture_map = (mIRLowering__capture_state(&self).do_capture_map OR_ELSE {});
    IF capture_map.contains?(node.name) THEN
      MUTABLE ident = Ident{ name: COPY UNWRAP (capture_map[node.name]), lowered_node_id: NIL, ownership_consumption: NIL };
      IF mIRLowering__atomic_capture_load?(&self, node) THEN
        RETURN Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY ident }, method: "load", args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } };
      END
      RETURN Emittable{ Ident: COPY ident };
    END
    MUTABLE decl_node: ?SymbolEntryRegInput = NIL;
    IF node.symbol != NIL THEN
      decl_node = COPY ((node.symbol)?).reg;
    END
    MUTABLE zig_name = (((((decl_node != NIL) AND ((TRY (functionState__decl_zig_names(mIRLowering__function_state(&self))))[aST__node_identity(castSymbolEntryRegInputToLocatable(COPY decl_node))] != NIL))) OR (TRY (functionState__rename_map(mIRLowering__function_state(&self))))[mIRLowering__zig_safe_name(self, node.name)]) OR mIRLowering__zig_safe_name(self, node.name));
    MUTABLE ident = Ident{ name: COPY zig_name, lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE symbol: ?SymbolEntry = COPY node.symbol;
    IF (((symbol != NIL) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_537 = symbol;
    symbolEntry__atomic?(rtoc_local_receiver_537) }) AND !(mIRLowering__capability_state(&self).atomic_emit_raw)) THEN
      IF node.atomic_borrow THEN
        RETURN Emittable{ Ident: COPY ident };
      END
      IF symbolEntry__indirect?(symbol) THEN
        RETURN Emittable{ Ident: COPY ident };
      END
      RETURN Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Deref: COPY Deref{ expr: Emittable{ Ident: COPY ident }, lowered_node_id: NIL, ownership_consumption: NIL } }, method: "load", args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } };
    END
    IF (TRUE AND node.heap_dupe_result) THEN
      RETURN Emittable{ DupeSlice: COPY DupeSlice{ source: Emittable{ Ident: COPY ident }, alloc: :heap, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    MUTABLE binding_type: ?Type@multiowned = NIL;
    IF symbol != NIL THEN
      binding_type = COPY symbolEntry__type(symbol);
    END
    IF ((binding_type != NIL) AND type__optional?(binding_type)) THEN
      MUTABLE stamped = TRY (aST__full_type_mut(Locatable{ Identifier: COPY node }));
      IF !(type__optional?(stamped)) THEN
        RETURN Emittable{ MIROptionalUnwrap: COPY MIROptionalUnwrap{ expr: Emittable{ Ident: COPY ident }, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
    END
    RETURN Emittable{ Ident: COPY ident };
END
PRIVATE FN mIRLowering__synthetic_pipeline_binding_name?(self: MIRLowering, name: String) RETURNS Bool ->
    IF !(name.startsWith?("$")) THEN
      RETURN FALSE;
    END
    IF (name.codepointCount() < 2) THEN
      RETURN FALSE;
    END
    RETURN ("abcdefghijklmnopqrstuvwxyz".indexOf(name.substr(1, 1)) EXISTS);
END
PRIVATE FN mIRLowering__atomic_capture_load?(MUTABLE self: MIRLowering, node: Identifier) RETURNS Bool ->
    MUTABLE sym: ?SymbolEntry = COPY node.symbol;
    RETURN !(!(((((((sym != NIL) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_540 = sym;
    symbolEntry__atomic?(rtoc_local_receiver_540) }) AND !(mIRLowering__capability_state(&self).atomic_emit_raw)) AND !(node.atomic_borrow)) AND (symbolEntry__layout(sym) != :indirect)))));
END
PRIVATE FN mIRLowering__recursive_field_copy_required?(MUTABLE self: MIRLowering, ft: Type, field_node: Locatable, field_alloc: ?String@symbol, field_sink_alloc: String@symbol) RETURNS !Bool ->
    IF (IF field_node IS_A Literal AS literal THEN (literal.type == symbol("NIL")) ELSE FALSE END) THEN
      RETURN FALSE;
    END
    RETURN !(!((((TRY (type__recursive_cleanup_shape?(ft, mIRLowering__mir_schema_lookup(&self))) AND !(TRY (mIRLowering__ast_expr_produces_heap?(&self, field_node)))) AND (field_alloc != field_sink_alloc)))));
END
PRIVATE FN mIRLowering__lower_unary_op(MUTABLE self: MIRLowering, node: UnaryOp) RETURNS !Emittable ->
    MUTABLE right: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(node.right)));
    IF (node.op == :NOT) OR (node.op == "!") THEN
      RETURN Emittable{ MIRUnaryOp: COPY MIRUnaryOp{ op: "!", operand: UNWRAP (COPY right), lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE_IF (node.op == :EXISTS) THEN
      IF TRY (type__stream_step?( TRY (type__from_node_mut(node.right)))) THEN
        RETURN Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: UNWRAP (COPY right), method: "isItem", args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } };
      ELSE
        TRY (mIRLowering__require_tense_operation_plan_mut(&self, Locatable{ UnaryOp: COPY node }, TenseOperationKind.Exists, TenseBackendForm.OptionalTest));
        RETURN Emittable{ MIRBinOp: COPY MIRBinOp{ op: "!=", left: UNWRAP (COPY right), right: Emittable{ Lit: COPY Lit{ value: "null", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
    ELSE_IF (node.op == :IS_OK) THEN
      TRY (mIRLowering__require_tense_operation_plan_mut(&self, Locatable{ UnaryOp: COPY node }, TenseOperationKind.IsOk, TenseBackendForm.FallibleTest));
      RETURN Emittable{ FallibleOk: COPY FallibleOk{ expr: COPY mIRLowering__strip_try(self, UNWRAP (right)), lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE_IF (node.op == :IS_READY) THEN
      RETURN Emittable{ FutureReady: COPY FutureReady{ expr: UNWRAP (COPY right), lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE_IF (node.op == :TRY) THEN
      MUTABLE plan: ?TenseOperationPlan = COPY CAST(node.tense_plan AS ?TenseOperationPlan);
      IF plan EXISTS AS plan_value THEN
        IF (plan_value.operation == TenseOperationKind.Try) THEN
          IF (plan_value.backend_form == TenseBackendForm.ZigTry) THEN
            RETURN Emittable{ TryExpr: COPY TryExpr{ expr: COPY mIRLowering__strip_try(self, UNWRAP (right)), lowered_node_id: NIL, ownership_consumption: NIL } };
          ELSE_IF (plan_value.backend_form == TenseBackendForm.OptionalTry) THEN
            RETURN Emittable{ TryOptional: COPY TryOptional{ expr: UNWRAP (COPY right), lowered_node_id: NIL, ownership_consumption: NIL } };
          ELSE
            panic("TRY lowering received unsupported tense backend {}");
          END
        ELSE
          panic("TRY lowering requires its annotation-produced TenseOperationPlan");
        END
      ELSE
        panic("TRY lowering requires its annotation-produced TenseOperationPlan");
      END
    ELSE_IF (node.op == :SUB) OR (node.op == "-") THEN
      RETURN Emittable{ MIRUnaryOp: COPY MIRUnaryOp{ op: "-", operand: UNWRAP (COPY right), lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE_IF (node.op == :BITWISE_NOT) OR (node.op == "~") THEN
      RETURN Emittable{ MIRUnaryOp: COPY MIRUnaryOp{ op: "~", operand: UNWRAP (COPY right), lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE
      panic("MIRLowering: unknown unary op {}");
    END
END
PRIVATE FN mIRLowering__require_tense_operation_plan_mut(MUTABLE self: MIRLowering, node: Locatable, operation: TenseOperationKind, backend: TenseBackendForm) RETURNS !TenseOperationPlan ->
    MUTABLE plan: ?TenseOperationPlan = CAST(locatable__tense_plan(node) AS ?TenseOperationPlan);
    IF !((((plan != NIL) AND (plan.operation == operation)) AND (plan.backend_form == backend))) THEN
      panic("{} lowering requires its annotation-produced TenseOperationPlan");
    END
    RETURN plan;
END
PRIVATE FN mIRLowering__lower_optional_unwrap(MUTABLE self: MIRLowering, node: OptionalUnwrap) RETURNS !Emittable ->
    TRY (mIRLowering__require_tense_operation_plan_mut(&self, Locatable{ OptionalUnwrap: COPY node }, TenseOperationKind.Unwrap, TenseBackendForm.OptionalUnwrap));
    MUTABLE target: Emittable = CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(node.target))) AS Emittable);
    IF (TRUE AND node.error_union_type) THEN
      target = mIRLowering__strip_try(self, target);
    END
    MUTABLE owns_foreign_resource = (UNWRAP (aST__node_target(Locatable{ OptionalUnwrap: COPY node })) IS_A Identifier AND ((locatable__symbol(node.target) != NIL) AND ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_542 = ((locatable__symbol(node.target))?);
    symbolEntry__foreign_out_owner(rtoc_local_receiver_542) } == TRUE)));
    IF owns_foreign_resource THEN
      RETURN Emittable{ ForeignOwnedUnwrap: COPY ForeignOwnedUnwrap{ expr: COPY target, lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE
      RETURN Emittable{ MIROptionalUnwrap: COPY MIROptionalUnwrap{ expr: COPY target, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
END
PRIVATE FN mIRLowering__lower_binary_op(MUTABLE self: MIRLowering, MUTABLE node: BinaryOp) RETURNS !Emittable ->
    IF binaryOp__smooth?(node) THEN
      RETURN TRY (mIRLowering__lower_smooth(&self, &node));
    END
    IF (node.op == symbol("OR_ELSE")) THEN
      RETURN TRY (mIRLowering__lower_or_else(&self, &node));
    END
    IF (node.op == :BIND_VAR) THEN
      RETURN CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(node.left))) AS Emittable);
    END
    IF ((node.op == symbol("AND")) OR (node.op == symbol("OR"))) THEN
      RETURN Emittable{ MIRBinOp: COPY TRY (mIRLowering__lower_lazy_boolean_op(&self, &node)) };
    END
    IF node.string_concat THEN
      MUTABLE left = TRY (mIRLowering__hoist_alloc(&self, TRY (mIRLowering__widen_symbol_to_bytes(&self, CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(node.left))) AS Emittable), node.left)), &node.left));
      MUTABLE right = TRY (mIRLowering__hoist_alloc(&self, TRY (mIRLowering__widen_symbol_to_bytes(&self, CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(node.right))) AS Emittable), node.right)), &node.right));
      MUTABLE alloc = TRY (mIRLowering__alloc_for_node(&self, Locatable{ BinaryOp: COPY node }));
      RETURN Emittable{ ConcatStr: COPY ConcatStr{ parts: [CAST(left AS Any), CAST(right AS Any)], alloc: COPY alloc, rt_expr: NIL, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    RETURN TRY (mIRLowering__emit_binary_operation_plan(&self, TRY (mIRLowering__binary_operation_plan(&self, &node))));
END
PRIVATE FN mIRLowering__lower_is_a(MUTABLE self: MIRLowering, MUTABLE node: IsA) RETURNS !Emittable ->
    IF node.runtime_variant_name THEN
      MUTABLE subject: Emittable = CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(node.left))) AS Emittable);
      RETURN Emittable{ MIRBinOp: COPY MIRBinOp{ op: "==", left: Emittable{ Call: COPY TRY (mIRLowering__active_tag_call(&self, subject)) }, right: Emittable{ EnumTag: COPY EnumTag{ variant: UNWRAP (COPY node.runtime_variant_name) } }, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    RETURN Emittable{ TypeEq: COPY TypeEq{ left: COPY TRY (mIRLowering__lower_type_value_expr(&self, IsARight{ Locatable: COPY node.left })), right: COPY TRY (mIRLowering__lower_type_value_expr(&self, node.right)), lowered_node_id: NIL, ownership_consumption: NIL } };
END
PRIVATE FN mIRLowering__lower_type_value_expr(MUTABLE self: MIRLowering, node: IsARight) RETURNS !Emittable ->
    # Ruby's `case node when Type ... when AST::Identifier ...` sees a Type or
    # an AST node; IsARight is that union, and the AST arm is a Locatable whose
    # own variants carry the identifier and field cases.
    IF node IS_A Type AS type THEN
      RETURN Emittable{ Ident: COPY Ident{ name: TRY (type__zig_type(type)), lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE_IF node IS_A Locatable AS rtoc_ast_node THEN
      IF rtoc_ast_node IS_A Identifier AS identifier THEN
        RETURN Emittable{ Ident: COPY Ident{ name: TRY (mIRLowering__type_value_zig_name(self, identifier__name(identifier))), lowered_node_id: NIL, ownership_consumption: NIL } };
      ELSE_IF rtoc_ast_node IS_A GetField AS get_field THEN
        RETURN Emittable{ Ident: COPY Ident{ name: TRY (mIRLowering__dotted_type_value_zig_name(self, get_field)), lowered_node_id: NIL, ownership_consumption: NIL } };
      END
      RETURN UNWRAP (TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(rtoc_ast_node))));
    END
    panic("type value expression is neither a Type nor an AST node");
END
PRIVATE FN mIRLowering__type_value_zig_name(self: MIRLowering, name: String) RETURNS !String ->
    RETURN TRY (type__zig_type((TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol(name) })))));
END
PRIVATE FN mIRLowering__dotted_type_value_zig_name(self: MIRLowering, node: GetField) RETURNS !String ->
    IF node.target IS_A Identifier THEN
      MUTABLE namespace = COPY castLocatableToIdentifier__mir_lowering(node.target).name;
      IF (namespace == "AST") THEN
        RETURN TRY (mIRLowering__type_value_zig_name(self, CAST(node.field AS String)));
      END
      RETURN "${mIRLowering__zig_module_alias(self, namespace)}.${node.field}";
    END
    panic("MIRLowering: unsupported dotted type expression {}");
END
PRIVATE FN mIRLowering__binary_operation_plan(MUTABLE self: MIRLowering, MUTABLE node: BinaryOp) RETURNS !BinaryOperationPlan ->
    MUTABLE facts = TRY (mIRLowering__binary_operand_facts(&self, &node));
    RETURN TRY (mIRLowering__classify_binary_operation(&self, facts));
END
PRIVATE FN mIRLowering__binary_operand_facts(MUTABLE self: MIRLowering, MUTABLE node: BinaryOp) RETURNS !BinaryOperandFacts ->
    MUTABLE left_type: ?Type = TRY (type__from_node_mut(node.left, "binary lhs"));
    MUTABLE right_type: ?Type = TRY (type__from_node_mut(node.right, "binary rhs"));
    MUTABLE left: Emittable = CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(node.left))) AS Emittable);
    MUTABLE right: Emittable = CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(node.right))) AS Emittable);
    IF (TRY (type__any_rc?( UNWRAP (left_type))) AND !(mIRLowering__bc_target?(&self))) THEN
      left = TRY (mIRLowering__rc_payload_value(self, left, UNWRAP (left_type)));
    END
    IF (TRY (type__any_rc?( UNWRAP (right_type))) AND !(mIRLowering__bc_target?(&self))) THEN
      right = TRY (mIRLowering__rc_payload_value(self, right, UNWRAP (right_type)));
    END
    RETURN BinaryOperandFacts{ node: COPY node, op: COPY node.op, left: COPY left, right: COPY right, left_type: UNWRAP (COPY left_type), right_type: UNWRAP (COPY right_type), int_arithmetic: COPY TRY (mIRLowering__binary_int_arithmetic_facts(self, node)), left_unit_variant: COPY TRY (mIRLowering__unit_variant_access(&self, node.left)), right_unit_variant: COPY TRY (mIRLowering__unit_variant_access(&self, node.right)) };
END
PRIVATE FN mIRLowering__classify_binary_operation(MUTABLE self: MIRLowering, facts: BinaryOperandFacts) RETURNS !BinaryOperationPlan ->
    IF (facts.op == :POW) THEN
      RETURN BinaryOperationPlan{ kind: :pow, facts: COPY facts, type_arg: COPY mIRLowering__binary_power_type_arg(self, facts), builtin: NIL, op_str: NIL, variant: NIL, tag_source: NIL, union_error_type: NIL, optional_side: NIL, optional_capture: NIL };
    END
    IF mIRLowering__signed_integer_modulo?(self, facts) THEN
      RETURN BinaryOperationPlan{ kind: :builtin, facts: COPY facts, builtin: :intMod, op_str: NIL, type_arg: NIL, variant: NIL, tag_source: NIL, union_error_type: NIL, optional_side: NIL, optional_capture: NIL };
    END
    MUTABLE optional_plan: ?BinaryOperationPlan = mIRLowering__classify_optional_binary_comparison(&self, facts);
    IF optional_plan EXISTS AS optional_plan_value THEN
      RETURN COPY optional_plan_value;
    END
    MUTABLE string_plan: ?BinaryOperationPlan = TRY (mIRLowering__classify_string_binary_operation(self, facts));
    IF string_plan EXISTS AS string_plan_value THEN
      RETURN COPY string_plan_value;
    END
    IF mIRLowering__integer_division?(self, facts) THEN
      RETURN BinaryOperationPlan{ kind: :builtin, facts: COPY facts, builtin: :intDiv, op_str: NIL, type_arg: NIL, variant: NIL, tag_source: NIL, union_error_type: NIL, optional_side: NIL, optional_capture: NIL };
    END
    MUTABLE builtin: ?String@symbol = mIRLowering__direct_binary_builtin(self, facts);
    IF builtin EXISTS AS builtin_value THEN
      RETURN BinaryOperationPlan{ kind: :builtin, facts: COPY facts, builtin: COPY builtin_value, op_str: NIL, type_arg: NIL, variant: NIL, tag_source: NIL, union_error_type: NIL, optional_side: NIL, optional_capture: NIL };
    END
    MUTABLE unit_plan: ?BinaryOperationPlan = mIRLowering__classify_unit_variant_comparison(self, facts);
    IF unit_plan EXISTS AS unit_plan_value THEN
      RETURN COPY unit_plan_value;
    END
    MUTABLE union_error_type: ?String@symbol = TRY (mIRLowering__invalid_union_equality_type(&self, facts));
    IF union_error_type EXISTS AS union_error_type_value THEN
      RETURN BinaryOperationPlan{ kind: :union_equality_error, facts: COPY facts, union_error_type: COPY union_error_type_value, builtin: NIL, op_str: NIL, type_arg: NIL, variant: NIL, tag_source: NIL, optional_side: NIL, optional_capture: NIL };
    END
    MUTABLE op_str: ?String = COPY (CAST({:ADD: "+", :SUB: "-", :MUL: "*", :DIV: "/", symbol("MOD"): "%", :EQ: "==", :NEQ: "!=", :LT: "<", :LTE: "<=", :GT: ">", :GTE: ">=", symbol("AND"): "and", symbol("OR"): "or", :NOT: "!", :BITWISE_NOT: "~", symbol("XOR"): "^", symbol("BIT_AND"): "&", symbol("BIT_OR"): "|", :SHL: "<<", :SHR: ">>"} AS {String@symbol}String))[facts.op];
    IF op_str EXISTS AS op_str_value THEN
      RETURN BinaryOperationPlan{ kind: :standard, facts: COPY facts, op_str: COPY op_str_value, builtin: NIL, type_arg: NIL, variant: NIL, tag_source: NIL, union_error_type: NIL, optional_side: NIL, optional_capture: NIL };
    ELSE
      panic("MIRLowering: unknown binary op {}");
    END
END
PRIVATE FN mIRLowering__binary_power_type_arg(self: MIRLowering, facts: BinaryOperandFacts) RETURNS String ->
    IF (type__resolved(facts.left_type) == :Int64) THEN
      RETURN "i64";
    ELSE
      RETURN "f64";
    END
END
PRIVATE FN mIRLowering__signed_integer_modulo?(self: MIRLowering, facts: BinaryOperandFacts) RETURNS Bool ->
    RETURN ((facts.op == symbol("MOD")) AND (type__resolved(facts.left_type) == :Int64));
END
PRIVATE FN mIRLowering__classify_string_binary_operation(self: MIRLowering, facts: BinaryOperandFacts) RETURNS !?BinaryOperationPlan ->
    IF !((TRY (type__string?(facts.left_type)) OR TRY (type__string?(facts.right_type)))) THEN
      RETURN NIL;
    END
    IF (type__symbol?(facts.left_type) AND type__symbol?(facts.right_type)) THEN
      IF !(((facts.op == :EQ) OR (facts.op == :NEQ))) THEN
        RETURN NIL;
      END
      RETURN BinaryOperationPlan{ kind: :symbol_comparison, facts: COPY facts, builtin: NIL, op_str: NIL, type_arg: NIL, variant: NIL, tag_source: NIL, union_error_type: NIL, optional_side: NIL, optional_capture: NIL };
    END
    MUTABLE op_str: ?String = mIRLowering__string_comparison_operator(self, facts.op);
    IF op_str EXISTS AS op_str_value THEN
      RETURN BinaryOperationPlan{ kind: :string_comparison, facts: COPY facts, op_str: COPY op_str_value, builtin: NIL, type_arg: NIL, variant: NIL, tag_source: NIL, union_error_type: NIL, optional_side: NIL, optional_capture: NIL };
    ELSE
      RETURN NIL;
    END
END
PRIVATE FN mIRLowering__string_comparison_operator(self: MIRLowering, op: String@symbol) RETURNS ?String ->
    RETURN COPY (CAST({:EQ: "==", :NEQ: "!=", :LT: "<", :LTE: "<=", :GT: ">", :GTE: ">="} AS {String@symbol}String))[op];
END
PRIVATE FN mIRLowering__classify_optional_binary_comparison(MUTABLE self: MIRLowering, facts: BinaryOperandFacts) RETURNS ?BinaryOperationPlan ->
    IF !((optional_comparison_ops |> ANY (_ == facts.op))) THEN
      RETURN NIL;
    END
    IF !((type__optional?(facts.left_type) OR type__optional?(facts.right_type))) THEN
      RETURN NIL;
    END
    MUTABLE both_optional = (type__optional?(facts.left_type) AND type__optional?(facts.right_type));
    IF (both_optional AND !((((facts.op == :EQ) OR (facts.op == :NEQ))))) THEN
      RETURN NIL;
    END
    MUTABLE optional_side = IF type__optional?(facts.left_type) THEN
      OptionalOperandSide.Left
    ELSE
      OptionalOperandSide.Right
    END;
    MUTABLE payload_type_branch_value: ?Type = NIL;
    IF (optional_side == OptionalOperandSide.Left) THEN
      payload_type_branch_value = COPY facts.right_type;
    ELSE
      payload_type_branch_value = COPY facts.left_type;
    END
    MUTABLE payload_type: Type = payload_type_branch_value?;
    IF (!(both_optional) AND (type__resolved(payload_type) == symbol("NIL"))) THEN
      RETURN NIL;
    END
    RETURN BinaryOperationPlan{ kind: :optional_comparison, facts: COPY facts, optional_side: COPY optional_side, optional_capture: "__opt_cmp_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_543 = mIRLowering__lowering_counters(&self);
    mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_543)) }}", builtin: NIL, op_str: NIL, type_arg: NIL, variant: NIL, tag_source: NIL, union_error_type: NIL };
END
PRIVATE FN mIRLowering__integer_division?(self: MIRLowering, facts: BinaryOperandFacts) RETURNS Bool ->
    RETURN (((facts.op == :DIV) AND type__integer?(facts.left_type)) AND type__integer?(facts.right_type));
END
PRIVATE FN mIRLowering__direct_binary_builtin(self: MIRLowering, facts: BinaryOperandFacts) RETURNS ?String@symbol ->
    MUTABLE direct: ?String@symbol = (IF (CAST({:WRAP_ADD: :wrapAdd, :WRAP_SUB: :wrapSub, :WRAP_MUL: :wrapMul} AS {String@symbol}String@symbol))[facts.op] != NIL THEN (CAST({:WRAP_ADD: :wrapAdd, :WRAP_SUB: :wrapSub, :WRAP_MUL: :wrapMul} AS {String@symbol}String@symbol))[facts.op] ELSE (CAST({:CHECK_ADD: :checkAdd, :CHECK_SUB: :checkSub, :CHECK_MUL: :checkMul} AS {String@symbol}String@symbol))[facts.op] END);
    IF direct EXISTS AS direct_value THEN
      RETURN direct_value;
    END
    MUTABLE fn: ?String@symbol = COPY (CAST({:ADD: :intAdd, :SUB: :intSub, :MUL: :intMul} AS {String@symbol}String@symbol))[facts.op];
    IF fn EXISTS AS fn_value THEN
      IF !(facts.int_arithmetic.both_int) THEN
        RETURN NIL;
      END
      IF facts.int_arithmetic.has_comptime_number_literal THEN
        RETURN NIL;
      END
      IF facts.int_arithmetic.has_float_coercion THEN
        RETURN NIL;
      END
      RETURN fn_value;
    ELSE
      RETURN NIL;
    END
END
PRIVATE FN mIRLowering__classify_unit_variant_comparison(self: MIRLowering, facts: BinaryOperandFacts) RETURNS ?BinaryOperationPlan ->
    IF !(((facts.op == :EQ) OR (facts.op == :NEQ))) THEN
      RETURN NIL;
    END
    MUTABLE lhs_uv: ?UnitVariantAccess = COPY facts.left_unit_variant;
    MUTABLE rhs_uv: ?UnitVariantAccess = COPY facts.right_unit_variant;
    MUTABLE op_str: String = "";
    IF (facts.op == :EQ) THEN
      op_str = "==";
    ELSE
      op_str = "!=";
    END
    IF ((lhs_uv != NIL) AND !(rhs_uv)) THEN
      RETURN BinaryOperationPlan{ kind: :unit_variant_comparison, facts: COPY facts, op_str: COPY op_str, variant: COPY lhs_uv, tag_source: :right, builtin: NIL, type_arg: NIL, union_error_type: NIL, optional_side: NIL, optional_capture: NIL };
    END
    IF ((rhs_uv != NIL) AND !(lhs_uv)) THEN
      RETURN BinaryOperationPlan{ kind: :unit_variant_comparison, facts: COPY facts, op_str: COPY op_str, variant: COPY rhs_uv, tag_source: :left, builtin: NIL, type_arg: NIL, union_error_type: NIL, optional_side: NIL, optional_capture: NIL };
    END
    RETURN NIL;
END
PRIVATE FN mIRLowering__invalid_union_equality_type(MUTABLE self: MIRLowering, facts: BinaryOperandFacts) RETURNS !?String@symbol ->
    IF !(((facts.op == :EQ) OR (facts.op == :NEQ))) THEN
      RETURN NIL;
    END
    MUTABLE left_resolved = type__resolved(facts.left_type);
    MUTABLE right_resolved = type__resolved(facts.right_type);
    IF (TRY (mIRLowering__union_schemas(&self))).contains?(left_resolved) THEN
      RETURN left_resolved;
    END
    IF (TRY (mIRLowering__union_schemas(&self))).contains?(right_resolved) THEN
      RETURN right_resolved;
    END
    RETURN NIL;
END
PRIVATE FN mIRLowering__emit_binary_operation_plan(MUTABLE self: MIRLowering, plan: BinaryOperationPlan) RETURNS !Emittable ->
    IF (plan.kind == :pow) THEN
      RETURN Emittable{ Call: COPY TRY (mIRLowering__emit_power_binary_plan(self, plan)) };
    ELSE_IF (plan.kind == :builtin) THEN
      RETURN TRY (mIRLowering__emit_builtin_binary_plan(&self, plan));
    ELSE_IF (plan.kind == :optional_comparison) THEN
      RETURN Emittable{ IfOptional: COPY TRY (mIRLowering__emit_optional_comparison_plan(&self, plan)) };
    ELSE_IF (plan.kind == :symbol_comparison) THEN
      RETURN TRY (mIRLowering__emit_symbol_binary_plan(&self, plan));
    ELSE_IF (plan.kind == :string_comparison) THEN
      RETURN TRY (mIRLowering__emit_string_binary_comparison(&self, plan));
    ELSE_IF (plan.kind == :unit_variant_comparison) THEN
      RETURN Emittable{ MIRBinOp: COPY TRY (mIRLowering__emit_unit_variant_comparison(&self, plan)) };
    ELSE_IF (plan.kind == :union_equality_error) THEN
      RETURN mIRLowering__raise_union_equality_error(self, plan);
    ELSE_IF (plan.kind == :standard) THEN
      RETURN Emittable{ MIRBinOp: COPY mIRLowering__emit_standard_binary_plan(self, plan) };
    ELSE
      panic("MIRLowering: unknown binary operation plan {}");
    END
END
PRIVATE FN mIRLowering__emit_power_binary_plan(self: MIRLowering, plan: BinaryOperationPlan) RETURNS !Call ->
    MUTABLE facts = COPY plan.facts;
    RETURN Call{ callee: "std.math.pow", args: [Emittable{ Ident: COPY Ident{ name: COPY UNWRAP (plan.type_arg), lowered_node_id: NIL, ownership_consumption: NIL } }, facts.left, facts.right], try_wrap: FALSE, owned_return: FALSE, callable_contract: TRY (callableContract__no_ownership(3)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL };
END
PRIVATE FN mIRLowering__emit_builtin_binary_plan(MUTABLE self: MIRLowering, plan: BinaryOperationPlan) RETURNS !Emittable ->
    MUTABLE facts = COPY plan.facts;
    RETURN castMIRLoweringReturnValueToEmittable__mir_lowering(TRY (mIRLowering__emit_builtin(&self, symbol(UNWRAP (plan.builtin)), [facts.left, facts.right])));
END
PRIVATE FN mIRLowering__emit_optional_comparison_plan(MUTABLE self: MIRLowering, plan: BinaryOperationPlan) RETURNS !IfOptional ->
    MUTABLE facts = COPY plan.facts;
    MUTABLE capture = COPY UNWRAP (plan.optional_capture);
    MUTABLE optional_side = COPY UNWRAP (plan.optional_side);
    MUTABLE capture_ref = Ident{ name: COPY capture, lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE optional_source_branch_value: ?Emittable = NIL;
    IF (optional_side == OptionalOperandSide.Left) THEN
      optional_source_branch_value = COPY facts.left;
    ELSE
      optional_source_branch_value = COPY facts.right;
    END
    MUTABLE optional_source: Emittable = optional_source_branch_value?;
    MUTABLE then_expr = TRY (mIRLowering__emit_optional_comparison_then_expr(&self, facts, optional_side, capture_ref));
    MUTABLE else_expr = mIRLowering__absent_optional_comparison_result(self, facts, optional_side);
    MUTABLE result = IfOptional{ optional: COPY optional_source, capture: COPY capture, then_expr: COPY then_expr, else_expr: COPY else_expr, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    result.result_type = TRY (type__new(TypeConstructionInput{ SymbolValue: :Bool }));
    RETURN result;
END
PRIVATE FN mIRLowering__absent_optional_comparison_result(self: MIRLowering, facts: BinaryOperandFacts, optional_side: OptionalOperandSide) RETURNS Emittable ->
    MUTABLE other_branch_value: ?Emittable = NIL;
    IF (optional_side == OptionalOperandSide.Left) THEN
      other_branch_value = COPY facts.right;
    ELSE
      other_branch_value = COPY facts.left;
    END
    MUTABLE other: Emittable = other_branch_value?;
    MUTABLE other_type_branch_value: ?Type = NIL;
    IF (optional_side == OptionalOperandSide.Left) THEN
      other_type_branch_value = COPY facts.right_type;
    ELSE
      other_type_branch_value = COPY facts.left_type;
    END
    MUTABLE other_type: Type = other_type_branch_value?;
    IF !(type__optional?(other_type)) THEN
      RETURN Emittable{ Lit: COPY Lit{ value: IF (facts.op == :NEQ) THEN
        "true"
      ELSE
        "false"
      END, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    RETURN Emittable{ MIRBinOp: COPY MIRBinOp{ op: IF (facts.op == :NEQ) THEN
      "!="
    ELSE
      "=="
    END, left: COPY other, right: Emittable{ Lit: COPY Lit{ value: "null", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } };
END
PRIVATE FN mIRLowering__emit_optional_comparison_then_expr(MUTABLE self: MIRLowering, facts: BinaryOperandFacts, optional_side: OptionalOperandSide, capture_ref: Ident) RETURNS !Emittable ->
    MUTABLE inner_type_branch_value: ?Type = NIL;
    IF (optional_side == OptionalOperandSide.Left) THEN
      inner_type_branch_value = UNWRAP (TRY (type__wrapped_type(facts.left_type)));
    ELSE
      inner_type_branch_value = UNWRAP (TRY (type__wrapped_type(facts.right_type)));
    END
    MUTABLE inner_type: Type = inner_type_branch_value?;
    MUTABLE inner_facts = BinaryOperandFacts{ node: COPY facts.node, op: COPY facts.op, left: COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_544: ?Emittable = NIL;
    IF (optional_side == OptionalOperandSide.Left) THEN
      rtoc_ternary_value_544 = Emittable{ Ident: COPY capture_ref };
    ELSE
      rtoc_ternary_value_544 = COPY facts.left;
    END
    rtoc_ternary_value_544? }, right: COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_545: ?Emittable = NIL;
    IF (optional_side == OptionalOperandSide.Right) THEN
      rtoc_ternary_value_545 = Emittable{ Ident: COPY capture_ref };
    ELSE
      rtoc_ternary_value_545 = COPY facts.right;
    END
    rtoc_ternary_value_545? }, left_type: COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_546: ?Type = NIL;
    IF (optional_side == OptionalOperandSide.Left) THEN
      rtoc_ternary_value_546 = COPY inner_type;
    ELSE
      rtoc_ternary_value_546 = COPY facts.left_type;
    END
    rtoc_ternary_value_546? }, right_type: COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_547: ?Type = NIL;
    IF (optional_side == OptionalOperandSide.Right) THEN
      rtoc_ternary_value_547 = COPY inner_type;
    ELSE
      rtoc_ternary_value_547 = COPY facts.right_type;
    END
    rtoc_ternary_value_547? }, int_arithmetic: COPY facts.int_arithmetic, left_unit_variant: COPY facts.left_unit_variant, right_unit_variant: COPY facts.right_unit_variant };
    RETURN TRY (mIRLowering__emit_binary_operation_plan(&self, TRY (mIRLowering__classify_binary_operation(&self, inner_facts))));
END
PRIVATE FN mIRLowering__emit_symbol_binary_plan(MUTABLE self: MIRLowering, plan: BinaryOperationPlan) RETURNS !Emittable ->
    RETURN TRY (mIRLowering__emit_symbol_binary_comparison(&self, plan.facts));
END
PRIVATE FN mIRLowering__emit_standard_binary_plan(self: MIRLowering, plan: BinaryOperationPlan) RETURNS MIRBinOp ->
    MUTABLE facts = COPY plan.facts;
    MUTABLE right_branch_value: ?Emittable = NIL;
    IF ((facts.op == :SHL) OR (facts.op == :SHR)) THEN
      right_branch_value = Emittable{ MIRCast: COPY MIRCast{ expr: COPY facts.right, target_type: NIL, method: :intCast, lowered_node_id: NIL, ownership_consumption: NIL  } };
    ELSE
      right_branch_value = COPY facts.right;
    END
    MUTABLE right: Emittable = UNWRAP (right_branch_value);
    RETURN MIRBinOp{ op: COPY UNWRAP (plan.op_str), left: COPY facts.left, right: COPY right, lowered_node_id: NIL, ownership_consumption: NIL };
END
PRIVATE FN mIRLowering__emit_symbol_binary_comparison(MUTABLE self: MIRLowering, facts: BinaryOperandFacts) RETURNS !Emittable ->
    MUTABLE cmp = TRY (mIRLowering__emit_builtin(&self, :symbolEql, [facts.left, facts.right]));
    IF (facts.op == :NEQ) THEN
      RETURN Emittable{ MIRUnaryOp: COPY MIRUnaryOp{ op: "!", operand: castMIRLoweringReturnValueToEmittable__mir_lowering(COPY cmp), lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE
      RETURN castMIRLoweringReturnValueToEmittable__mir_lowering(cmp);
    END
END
PRIVATE FN mIRLowering__emit_string_binary_comparison(MUTABLE self: MIRLowering, plan: BinaryOperationPlan) RETURNS !Emittable ->
    MUTABLE facts = COPY plan.facts;
    MUTABLE operands = TRY (mIRLowering__string_comparison_operands(&self, &facts));
    MUTABLE eql_call = TRY (mIRLowering__emit_builtin(&self, :eql, [operands.left, operands.right]));
    IF (facts.op == :EQ) THEN
      RETURN castMIRLoweringReturnValueToEmittable__mir_lowering(eql_call);
    END
    IF (facts.op == :NEQ) THEN
      RETURN Emittable{ MIRUnaryOp: COPY MIRUnaryOp{ op: "!", operand: castMIRLoweringReturnValueToEmittable__mir_lowering(COPY eql_call), lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    RETURN Emittable{ MIRBinOp: COPY MIRBinOp{ op: COPY UNWRAP (plan.op_str), left: castMIRLoweringReturnValueToEmittable__mir_lowering(COPY TRY (mIRLowering__emit_builtin(&self, :strcmp, [operands.left, operands.right]))), right: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } };
END
PRIVATE FN mIRLowering__string_comparison_operands(MUTABLE self: MIRLowering, MUTABLE facts: BinaryOperandFacts) RETURNS !BinaryMirOperands ->
    MUTABLE node = COPY facts.node;
    MUTABLE left = TRY (mIRLowering__string_comparison_operand(&self, &facts.left, &node.left));
    MUTABLE right = TRY (mIRLowering__string_comparison_operand(&self, &facts.right, &node.right));
    RETURN BinaryMirOperands{ left: COPY TRY (mIRLowering__hoist_alloc(&self, &left, &node.left)), right: COPY TRY (mIRLowering__hoist_alloc(&self, &right, &node.right)) };
END
PRIVATE FN mIRLowering__string_comparison_operand(MUTABLE self: MIRLowering, MUTABLE value: Emittable, MUTABLE ast_node: Locatable) RETURNS !Emittable ->
    IF (IF ast_node IS_A BinaryOp AS binary_op THEN (binary_op.op == symbol("OR_ELSE")) ELSE FALSE END) THEN
      RETURN TRY (mIRLowering__place_value_for_destination(&self, &value, &ast_node, :heap, TypeTypeInput{ Type: COPY TRY (aST__full_type_mut(ast_node)) }));
    END
    RETURN COPY value;
END
PRIVATE FN mIRLowering__emit_unit_variant_comparison(MUTABLE self: MIRLowering, plan: BinaryOperationPlan) RETURNS !MIRBinOp ->
    MUTABLE facts = COPY plan.facts;
    MUTABLE tag_target_branch_value: ?Emittable = NIL;
    IF (plan.tag_source == :left) THEN
      tag_target_branch_value = COPY facts.left;
    ELSE
      tag_target_branch_value = COPY facts.right;
    END
    MUTABLE tag_target: Emittable = tag_target_branch_value?;
    RETURN MIRBinOp{ op: COPY UNWRAP (plan.op_str), left: Emittable{ Call: COPY TRY (mIRLowering__active_tag_call(&self, tag_target)) }, right: Emittable{ EnumTag: COPY EnumTag{ variant: COPY (UNWRAP (plan.variant)).variant_name } }, lowered_node_id: NIL, ownership_consumption: NIL };
END
PRIVATE FN mIRLowering__raise_union_equality_error(self: MIRLowering, plan: BinaryOperationPlan) RETURNS Emittable ->
    MUTABLE type_name = COPY symbol(UNWRAP (plan.union_error_type));
    panic("{}work on tagged unions. Either compare against a unit variant {}std.meta.activeTag(s) == .Variant -- or use a MATCH expression to discriminate the active variant.\\n(See transpile-tests/255_union_equality.clear.)");
END
PRIVATE FN mIRLowering__lower_lazy_boolean_op(MUTABLE self: MIRLowering, MUTABLE node: BinaryOp) RETURNS !MIRBinOp ->
    MUTABLE op_str: ?String = COPY (CAST({:ADD: "+", :SUB: "-", :MUL: "*", :DIV: "/", symbol("MOD"): "%", :EQ: "==", :NEQ: "!=", :LT: "<", :LTE: "<=", :GT: ">", :GTE: ">=", symbol("AND"): "and", symbol("OR"): "or", :NOT: "!", :BITWISE_NOT: "~", symbol("XOR"): "^", symbol("BIT_AND"): "&", symbol("BIT_OR"): "|", :SHL: "<<", :SHR: ">>"} AS {String@symbol}String))[node.op];
    IF op_str EXISTS AS op_str_value THEN
      MUTABLE op_str_value_mutable = COPY op_str_value;
      MUTABLE left = TRY (mIRLowering__lower_boolean_operand(&self, node.left));
      MUTABLE right = TRY (mIRLowering__lower_scoped(&self, %() USE(node, MUTABLE self) -> TRY (mIRLowering__lower_boolean_operand(&self, node.right))));
      RETURN MIRBinOp{ op: COPY op_str_value_mutable, left: COPY left, right: COPY right, lowered_node_id: NIL, ownership_consumption: NIL };
    ELSE
      panic("MIRLowering: unknown boolean op {}");
    END
END
PRIVATE FN mIRLowering__lower_boolean_operand(MUTABLE self: MIRLowering, node: Locatable) RETURNS !Emittable ->
    MUTABLE lowered: Emittable = CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering( node))) AS Emittable);
    IF !(type__optional?( TRY (type__from_node_mut( node, "logical operand")))) THEN
      RETURN lowered;
    END
    RETURN Emittable{ MIRBinOp: COPY MIRBinOp{ op: "!=", left: COPY lowered, right: Emittable{ Lit: COPY Lit{ value: "null", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } };
END
PRIVATE FN mIRLowering__unit_variant_access(MUTABLE self: MIRLowering, node: Locatable) RETURNS !?UnitVariantAccess ->
    IF node IS_A GetField AS get_field THEN
      IF !(get_field.target IS_A Identifier) THEN
        RETURN NIL;
      END
      MUTABLE type_name = symbol(UNWRAP (aST__node_name(get_field.target)));
      MUTABLE schema: ?UnionSchema@multiowned = COPY (TRY (mIRLowering__union_schemas(&self)))[type_name];
      IF !(schema) THEN
        RETURN NIL;
      END
      MUTABLE field_key: ?MIRLoweringReturnValue = mIRLowering__union_variant_key(self, schema, MIRLoweringField{ StringValue: get_field.field });
      IF field_key EXISTS AS field_key_value THEN
        # The key is the string or symbol the variant lookup produced.
        MUTABLE rtoc_variant_key: String@symbol = :unknown;
        PARTIAL MATCH field_key_value START
          MIRLoweringReturnValue.StringValue AS rtoc_key_str -> rtoc_variant_key = symbol(rtoc_key_str);,
          MIRLoweringReturnValue.SymbolValue AS rtoc_key_sym -> rtoc_variant_key = rtoc_key_sym;,
          DEFAULT -> PASS;
        END
        MUTABLE var_data: ?SchemasUnionSchemaVariantValue = COPY schema.variants[rtoc_variant_key];
        IF schemas__inline_struct?(var_data) THEN
          RETURN NIL;
        END
        RETURN UnitVariantAccess{ type_name: COPY type_name, variant_name: COPY get_field.field };
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
END
PRIVATE FN mIRLowering__union_variant_key(self: MIRLowering, schema: UnionSchema, field: MIRLoweringField) RETURNS ?MIRLoweringReturnValue ->
    # The variant set is keyed by String; `field` is a union of a symbol and a
    # string, so the "already a key" test has to ask with the payload.
    PARTIAL MATCH field START
      MIRLoweringField.StringValue AS rtoc_field_str ->
        IF schema.variants.contains?(rtoc_field_str) THEN
          RETURN MIRLoweringReturnValue{ StringValue: COPY rtoc_field_str };
        END,
      DEFAULT -> PASS;
    END
    MUTABLE field_s = COPY CAST(field AS String);
    IF schema.variants.contains?(field_s) THEN
      RETURN MIRLoweringReturnValue{ StringValue: COPY field_s };
    END
    MUTABLE field_sym = symbol(field_s);
    IF schema.variants.contains?(field_sym) THEN
      RETURN MIRLoweringReturnValue{ SymbolValue: COPY field_sym };
    END
    RETURN NIL;
END
PRIVATE FN mIRLowering__lower_smooth(MUTABLE self: MIRLowering, MUTABLE node: BinaryOp) RETURNS !Emittable ->
    self.state.function_state.current_decl_alloc = COPY mIRLowering__function_state(&self).current_decl_alloc;
    MUTABLE rhs = COPY node.right;
    IF aST__pipeline_complex_op?(rhs) THEN
      RETURN TRY (mIRLowering__lower_complex_smooth( &self, &node));
    END
    IF rhs IS_A CollectOp AS collect_op THEN
      MUTABLE collect_op_mutable = COPY collect_op;
      RETURN TRY (mIRLowering__lower_collect_smooth(&self, node, collect_op_mutable));
    END
    IF rhs IS_A RecoverOp AS recover_op THEN
      MUTABLE recover_op_mutable = COPY recover_op;
      RETURN Emittable{ TryCatch: COPY TRY (mIRLowering__lower_recover_smooth(&self, node, &recover_op_mutable)) };
    END
    RETURN TRY (mIRLowering__lower_call_smooth(&self, &node));
END
PRIVATE FN mIRLowering__lower_complex_smooth(MUTABLE self: MIRLowering, MUTABLE node: BinaryOp) RETURNS !Emittable ->
    MUTABLE rhs = COPY node.right;
    MUTABLE source_type: ?String@symbol = IF node.left IS_A RangeLit THEN
      :range
    ELSE
      NIL
    END;
    MUTABLE mir_result: ?PipelineLoweringResult = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_549 = (TRY (mIRLowering__pipeline_host( &self)));
    TRY (pipelineHost__lower_pipeline(&rtoc_mutable_receiver_549, &node)) };
    MUTABLE result_type: ?Type = TRY (type__from_node_mut(Locatable{ BinaryOp: COPY node }, "pipeline result ownership"));
    MUTABLE sink_alloc: ?String@symbol = TRY (mIRLowering__complex_pipeline_sink_alloc( &self, mir_result, UNWRAP (result_type), node));
    IF mir_result EXISTS AS mir_result_value THEN
      RETURN Emittable{ Pipeline: COPY Pipeline{ ast_node: node, inner: castPipelineLoweringResultToEmittable(COPY mir_result_value), source_type: source_type, stages: NIL, sink: NIL, sink_alloc: sink_alloc, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
    panic("lower_smooth: unsupported pipeline op {}; legacy pipeline fallback has been removed");
END
PRIVATE FN mIRLowering__complex_pipeline_sink_alloc(MUTABLE self: MIRLowering, mir_result: ?PipelineLoweringResult, result_type: Type, node: BinaryOp) RETURNS !?String@symbol ->
    IF ownershipEffect__borrowed_view_result?(castOptionalPipelineLoweringResultToOptionalEmittable(mir_result)) THEN
      RETURN NIL;
    END
    IF type__observable?(result_type) THEN
      RETURN :heap;
    END
    IF !(TRY (mIRLowering__ownership_tracked_transfer_type?(&self, result_type))) THEN
      RETURN NIL;
    END
    IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_550 = (TRY (mIRLowering__pipeline_host( &self)));
    pipelineHost__pipeline_result_heap?(&rtoc_local_receiver_550, node) } THEN
      RETURN :heap;
    END
    IF mIRLowering__function_state(&self).current_decl_alloc != NIL THEN
    RETURN (mIRLowering__function_state(&self).current_decl_alloc)?;
    ELSE
    RETURN TRY (mIRLowering__placement_for_node(&self, Locatable{ BinaryOp: COPY node }));
    END
END
PRIVATE FN mIRLowering__lower_collect_smooth(MUTABLE self: MIRLowering, node: BinaryOp, rhs: CollectOp) RETURNS !Emittable ->
    MUTABLE left: Emittable = CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(node.left))) AS Emittable);
    MUTABLE ft = TRY (aST__full_type_mut(node.left));
    MUTABLE collect_method: String = "";
    IF (type__observable?(ft) AND type__array?(TRY (type__tense_type(ft)))) THEN
      collect_method = "materializeNext";
    ELSE
      collect_method = "next";
    END
    MUTABLE collect_alloc = functionState__current_decl_or_frame_alloc(mIRLowering__function_state(&self));
    MUTABLE collect_args = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_552: ?[]AllocatorRef = NIL;
    IF (collect_method == "materializeNext") THEN
      rtoc_ternary_value_552 = [AllocatorRef{ kind: COPY collect_alloc, lowered_node_id: NIL, ownership_consumption: NIL }];
    ELSE
      rtoc_ternary_value_552 = List[];
    END
    rtoc_ternary_value_552? };
    MUTABLE collect_type = TRY (mIRLowering__smooth_collect_type(self, ft, collect_method));
    MUTABLE collect_alloc_fact: ?String@symbol = IF (collect_method == "materializeNext") THEN
      collect_alloc
    ELSE
      NIL
    END;
    IF node.left IS_A Identifier THEN
      RETURN Emittable{ MIRMethodCall: COPY TRY (mIRLowering__smooth_collect_call(self, left, collect_method, CAST(collect_args AS []Emittable), CAST(collect_type AS Type), collect_alloc_fact)) };
    END
    RETURN Emittable{ MIRBlockExpr: COPY TRY (mIRLowering__smooth_collect_block(&self, left, ft, collect_method, CAST(collect_args AS []Emittable), CAST(collect_type AS Type), collect_alloc_fact)) };
END
PRIVATE FN mIRLowering__smooth_collect_type(self: MIRLowering, type_info: Type, collect_method: String) RETURNS !Type ->
    IF (collect_method == "materializeNext") THEN
      MUTABLE elem_t: ?Type = TRY (type__element_type((TRY (type__tense_type(type_info)))));
      RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY "${type__resolved(UNWRAP (elem_t))}[]" }, NIL, NIL, NIL, NIL, :list));
    ELSE
      IF TRY (type__tense_type(type_info)) THEN
        RETURN TRY (type__new(TypeConstructionInput{ Type: COPY TRY (type__tense_type(type_info)) }));
      ELSE
        RETURN TRY (type__new(TypeConstructionInput{ Type: COPY type_info }));
      END
    END
END
PRIVATE FN mIRLowering__smooth_collect_call(self: MIRLowering, receiver: Emittable, collect_method: String, collect_args: []Emittable, collect_type: Type, collect_alloc_fact: ?String@symbol) RETURNS !MIRMethodCall ->
    MUTABLE call = MIRMethodCall{ receiver: COPY receiver, method: COPY collect_method, args: COPY collect_args, try_wrap: TRUE, callable_contract: COPY TRY (callableContract__no_ownership(collect_args.length())), owned_result_alloc: COPY collect_alloc_fact, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    call.result_type = COPY collect_type;
    RETURN call;
END
PRIVATE FN mIRLowering__smooth_collect_block(MUTABLE self: MIRLowering, left: Emittable, ft: Type, collect_method: String, collect_args: []Emittable, collect_type: Type, collect_alloc_fact: ?String@symbol) RETURNS !MIRBlockExpr ->
    MUTABLE acc_zig = TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY ft }));
    MUTABLE block_id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_553 = mIRLowering__lowering_counters(&self);
    mIRLoweringCounters__next_block_expr_id(&rtoc_mutable_receiver_553) };
    MUTABLE label = "__collect_blk_${mIRLoweringGeneratedId__to_s(block_id)}";
    MUTABLE collect_var = "__collect_acc_${mIRLoweringGeneratedId__to_s(block_id)}";
    MUTABLE val_var = "__collect_val_${mIRLoweringGeneratedId__to_s(block_id)}";
    MUTABLE left_effect = TRY (ownershipEffect__of(left));
    # An owned String out of a nested IF expression is not implicitly copyable;
    # the default is :heap and only the owned-left case can differ.
    MUTABLE collect_source_alloc: String@symbol = :heap;
    IF !(type__observable?(ft)) THEN
      IF left_effect.produces_owned THEN
        collect_source_alloc = (left_effect.alloc OR_ELSE :heap);
      END
    END
    MUTABLE collect_cleanup = cleanupEntry__build(:uniform, collect_source_alloc, FALSE, NIL, acc_zig);
    RETURN MIRBlockExpr{ label: COPY label, body: COPY [Emittable{ Let: COPY Let{ name: COPY collect_var, init: COPY left, mutable: FALSE, annotation: COPY ft, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }, Emittable{ Cleanup: COPY Cleanup{ name: COPY collect_var, cleanup_entry: collect_cleanup, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ Let: COPY Let{ name: COPY val_var, init: Emittable{ MIRMethodCall: COPY TRY (mIRLowering__smooth_collect_call(self, Emittable{ Ident: COPY Ident{ name: COPY collect_var, lowered_node_id: NIL, ownership_consumption: NIL } }, collect_method, collect_args, collect_type, collect_alloc_fact)) }, mutable: FALSE, annotation: COPY collect_type, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }, Emittable{ BreakStmt: COPY BreakStmt{ label: COPY label, value: Emittable{ Ident: COPY Ident{ name: COPY val_var, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
END
PRIVATE FN mIRLowering__lower_recover_smooth(MUTABLE self: MIRLowering, node: BinaryOp, MUTABLE rhs: RecoverOp) RETURNS !TryCatch ->
    MUTABLE left: Emittable = CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(node.left))) AS Emittable);
    MUTABLE default_val: Emittable = CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt( UNWRAP (rhs.default_expr)))) AS Emittable);
    MUTABLE out = TryCatch{ expr: COPY mIRLowering__strip_try(self, left), catch_body: COPY default_val, capture: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    out.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY TRY (aST__full_type_mut(Locatable{ BinaryOp: COPY node })) }));
    RETURN out;
END
PRIVATE FN mIRLowering__lower_call_smooth(MUTABLE self: MIRLowering, MUTABLE node: BinaryOp) RETURNS !Emittable ->
    MUTABLE left: Emittable = CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(node.left))) AS Emittable);
    MUTABLE snapshot_stmts = TRY (mIRLowering__smooth_snapshot_stmts(&self, node, left));
    IF !((snapshot_stmts.length() == 0)) THEN
      left = Emittable{ Ident: COPY Ident{ name: "__snap_input", lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    MUTABLE call_mir = TRY (mIRLowering__lower_smooth_call_rhs(&self, &node));
    IF (snapshot_stmts.length() == 0) THEN
      RETURN call_mir;
    END
    MUTABLE label = "__snap_blk";
    RETURN Emittable{ MIRBlockExpr: COPY MIRBlockExpr{ label: COPY label, body: COPY (snapshot_stmts + [Emittable{ BreakStmt: COPY BreakStmt{ label: COPY label, value: COPY call_mir, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }]), lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL } };
END
PRIVATE FN mIRLowering__smooth_snapshot_stmts(MUTABLE self: MIRLowering, node: BinaryOp, left: Emittable) RETURNS ![]Emittable ->
    IF !((mIRLowering__current_function_has_catch?(&self) AND ((TRY (mIRLowering__current_function_snapshot_types(&self))).length() == 1))) THEN
      RETURN CAST(List[] AS []Emittable);
    END
    MUTABLE t = TRY (type__new(TypeConstructionInput{ Type: COPY TRY (aST__full_type_mut(node.left)) }));
    IF !(type__catch_snapshot_payload?(t)) THEN
      RETURN CAST(List[] AS []Emittable);
    END
    MUTABLE snap_zig_type = TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY t }));
    RETURN CAST([CAST(Let{ name: COPY "__snap_input", init: COPY left, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } AS Emittable), CAST(ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: mIRLowering__runtime_binding_name(&self), lowered_node_id: NIL, ownership_consumption: NIL } }, method: "captureSnapshot", args: [CAST(Ident{ name: COPY snap_zig_type, lowered_node_id: NIL, ownership_consumption: NIL } AS Any), CAST(AddressOf{ expr: Emittable{ Ident: COPY Ident{ name: "__snap_input", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(2)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable)] AS []Emittable);
END
PRIVATE FN mIRLowering__lower_smooth_call_rhs(MUTABLE self: MIRLowering, MUTABLE node: BinaryOp) RETURNS !Emittable ->
    MUTABLE rhs = COPY node.right;
    IF rhs IS_A Identifier AS identifier THEN
      MUTABLE identifier_mutable = COPY identifier;
      RETURN TRY (mIRLowering__lower_smooth_identifier_call(&self, node, identifier_mutable));
    ELSE_IF rhs IS_A FuncCall AS func_call THEN
      RETURN TRY (mIRLowering__lower_smooth_func_call(&self, node, func_call));
    END
    panic("MIRLowering: unhandled SMOOTH RHS {}");
END
PRIVATE FN mIRLowering__lower_smooth_identifier_call(MUTABLE self: MIRLowering, node: BinaryOp, rhs: Identifier) RETURNS !Emittable ->
    MUTABLE synthetic = FuncCall{ token: COPY rhs.token, name: CallName{ StringValue: COPY rhs.name }, args: COPY [node.left], can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, explicit_mutable_argument_tokens: NIL, module_alias: NIL, extern_call: NIL, extern_effects: NIL, extern_source: NIL, generic_type_args: NIL, fn_var_call: NIL, pipe_lhs: NIL, heap_dupe_result: NIL, arg_families: NIL, collapsed_errors: NIL, error_union_type: NIL, protocol_name: NIL, protocol_operation: NIL, protocol_receiver_index: NIL, retain_error_channel: NIL };
    TRY (aST__stamp_synthetic_type_mut(Locatable{ FuncCall: COPY synthetic }, CAST(COPY TRY (aST__full_type_mut(Locatable{ BinaryOp: COPY node })) AS Type), "synthetic AST type"));
    synthetic.storage_override = locatable__storage( Locatable{ BinaryOp: COPY node });
    IF rhs.zig_pattern EXISTS AS zig_pattern_value THEN
      synthetic.zig_pattern = COPY zig_pattern_value;
    END
    RETURN TRY (mIRLowering__lower_func_call(&self, &synthetic));
END
PRIVATE FN mIRLowering__lower_smooth_func_call(MUTABLE self: MIRLowering, node: BinaryOp, rhs: FuncCall) RETURNS !Emittable ->
    MUTABLE synthetic = FuncCall{ token: COPY rhs.token, name: rhs.name, args: COPY ([node.left] + rhs.args), can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, explicit_mutable_argument_tokens: NIL, module_alias: NIL, extern_call: NIL, extern_effects: NIL, extern_source: NIL, generic_type_args: NIL, fn_var_call: NIL, pipe_lhs: NIL, heap_dupe_result: NIL, arg_families: NIL, collapsed_errors: NIL, error_union_type: NIL, protocol_name: NIL, protocol_operation: NIL, protocol_receiver_index: NIL, retain_error_channel: NIL };
    TRY (aST__stamp_synthetic_type_mut(Locatable{ FuncCall: COPY synthetic }, CAST(COPY TRY (aST__full_type_mut(Locatable{ BinaryOp: COPY node })) AS Type), "synthetic AST type"));
    synthetic.storage_override = locatable__storage( Locatable{ BinaryOp: COPY node });
