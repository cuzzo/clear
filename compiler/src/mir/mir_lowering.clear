    AstIdentifierSearchNode.BindExpr AS cast_payload -> RETURN Locatable{ BindExpr: COPY cast_payload };,
    AstIdentifierSearchNode.BinaryOp AS cast_payload -> RETURN Locatable{ BinaryOp: COPY cast_payload };,
    AstIdentifierSearchNode.IsA AS cast_payload -> RETURN Locatable{ IsA: COPY cast_payload };,
    AstIdentifierSearchNode.CallSiteOverride AS cast_payload -> RETURN Locatable{ CallSiteOverride: COPY cast_payload };,
    AstIdentifierSearchNode.Identifier AS cast_payload -> RETURN Locatable{ Identifier: COPY cast_payload };,
