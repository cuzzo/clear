    MUTABLE methods: []FnDef = ( { MUTABLE rtoc_empty_list_134: []FnDef = List[]; rtoc_empty_list_134 } );
    &drop_statements.unshift(Suppress{ name: "alloc", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
    IF (drop_statements.length() == 1) THEN
