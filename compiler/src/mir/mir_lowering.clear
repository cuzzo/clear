      mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_block_expr_id(&rtoc_mutable_receiver_713)) }}";
      then_body = (payload_bindings + TRY (mIRLowering__lower_body_with_break(&self, node.then_branch, label)));
      else_body = TRY (mIRLowering__lower_body_with_break(&self, castLocatableListToMIRLoweringLowerableStmtList((node.else_branch OR_ELSE List[])), label));
      MUTABLE block = MIRBlockExpr{ label: COPY label, body: [Emittable{ IfStmt: COPY IfStmt{ cond: Emittable{ MIRBinOp: COPY cond }, then_body: then_body, else_body: else_body, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL } }], lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
      RETURN mIRLowering__with_pending(self, subject_pending, Emittable{ MIRBlockExpr: COPY block });
    END
    then_body = (payload_bindings + TRY (mIRLowering__lower_body(&self, node.then_branch)));
    IF (((node.else_branch != NIL) AND !(((node.else_branch)?).empty?()))) THEN
      else_body = TRY (mIRLowering__lower_body(&self, (node.else_branch OR_ELSE List[])));
