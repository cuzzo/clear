PRIVATE FN mIRLowering__auto_lock_assignment_value(MUTABLE self: MIRLowering, node: Assignment, alloc_sym: String@symbol) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE value = mIRLowering__with_decl_alloc(rtoc_self_view, alloc_sym, %() USE(alloc_sym, node, MUTABLE rtoc_self_view) -> {
    MUTABLE lowered = TRY (mIRLowering__lower(&rtoc_self_view, node.value));
    MUTABLE placed = TRY (mIRLowering__place_value_for_destination(rtoc_self_view, lowered, node.value, alloc_sym, &node.name.full_type_mut()));
    TRY (mIRLowering__materialize_owned_sink_value(rtoc_self_view, placed, node.value, alloc_sym, &node.name.full_type_mut()))
    });
    IF (TRUE AND mIRLowering__mir_allocates?(rtoc_self_view, value)) THEN
      RETURN mIRLowering__hoist_alloc(rtoc_self_view, value, node.value, TRUE);
    ELSE
      RETURN value;
    END
}
END
PRIVATE FN mIRLowering__loop_condition_expr(self: MIRLowering, cond: Emittable, pending_value: []Emittable) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (pending_value.length() == 0) THEN
      RETURN COPY cond;
    END
    MUTABLE label = "__while_cond_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_710 = mIRLowering__lowering_counters(rtoc_self_view);
    mIRLoweringCounters__next_block_expr_id(&rtoc_mutable_receiver_710) }}";
    MUTABLE body: []Emittable = ( { MUTABLE rtoc_empty_list_711: []Emittable = List[]; rtoc_empty_list_711 } );
    FOR _ IN pending_value DO
    &body.append(COPY _);
    ruby_array_concat_Emittable(body, CAST(TRY (mIRLowering__ownership_facts_for_mir_surface(rtoc_self_view, _)) AS []Emittable));
    END
    RETURN Emittable{ MIRBlockExpr: COPY MIRBlockExpr{ label: label, body: COPY (body + [BreakStmt{ label: COPY label, value: COPY cond, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }]), lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL } };
}
END
PRIVATE FN mIRLowering__lower_control_condition(self: MIRLowering, ast_node: Locatable, transfers_to_capture: Bool = FALSE) RETURNS Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE lowerer = rtoc_self_view;
    MUTABLE lowered = mIRLowering__lower(lowerer, ast_node);
    IF mIRLowering__mir_allocates?(lowerer, lowered) THEN
      RETURN mIRLowering__hoist_alloc(lowerer, lowered, ast_node, transfers_to_capture);
    ELSE
      RETURN lowered;
    END
}
END
PRIVATE FN mIRLowering__lower_if(MUTABLE self: MIRLowering, node: IfStatement) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE else_body = NIL;
    MUTABLE then_body: []Emittable = List[];
    IF (node.condition IS_A IsA AND node.condition.runtime_variant_name()) THEN
      RETURN mIRLowering__lower_runtime_is_a_if(&rtoc_self_view, node, castLocatableToIsA(node.condition));
    END
    MUTABLE cond, cond_pending = mIRLowering__lower_head(rtoc_self_view, %() USE(node, rtoc_self_view) -> mIRLowering__lower_control_condition(rtoc_self_view, node.condition));
    IF node.expr_mode THEN
      MUTABLE label = "__if_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_712 = mIRLowering__lowering_counters(rtoc_self_view);
      mIRLoweringCounters__next_block_expr_id(&rtoc_mutable_receiver_712) }}";
      then_body = TRY (mIRLowering__lower_body_with_break(&rtoc_self_view, node.then_branch, label));
      else_body = TRY (mIRLowering__lower_body_with_break(&rtoc_self_view, (node.else_branch OR_ELSE List[]), label));
      MUTABLE if_stmt = IfStmt{ cond: COPY cond, then_body: then_body, else_body: else_body, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL };
      if_stmt.comptime = node.comptime;
      MUTABLE block = MIRBlockExpr{ label: label, body: Body{ ArrayValue: [if_stmt] |> SELECT SegmentStmt{ Emittable: Emittable{ IfStmt: COPY _ } } }, lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
      RETURN mIRLowering__with_pending(rtoc_self_view, cond_pending, Emittable{ MIRBlockExpr: COPY block });
    END
    then_body = TRY (mIRLowering__lower_body(&rtoc_self_view, node.then_branch));
    IF (((node.else_branch != NIL) AND !(((node.else_branch)?).empty?()))) THEN
      else_body = TRY (mIRLowering__lower_body(&rtoc_self_view, node.else_branch));
    ELSE
      else_body = NIL;
    END
    MUTABLE if_stmt = IfStmt{ cond: COPY cond, then_body: then_body, else_body: else_body, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL };
    if_stmt.comptime = node.comptime;
    RETURN mIRLowering__with_pending(rtoc_self_view, cond_pending, Emittable{ IfStmt: COPY if_stmt });
