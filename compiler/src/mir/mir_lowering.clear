    MUTABLE next_call = MIRMethodCall{ receiver: Emittable{ FieldGet: COPY source_receiver }, method: "next", args: ( { MUTABLE rtoc_empty_list_562: []Any = List[]; rtoc_empty_list_562 } ), try_wrap: !(asyncResultShape__boxes_fallible_payload?(source_shape)), callable_contract: COPY TRY (callableContract__no_ownership(0)), owned_result_alloc: IF lifecyclePlan__needs_drop?(source_lifecycle) THEN
        :heap
      ELSE
