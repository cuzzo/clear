PRIVATE FN mIRLowering__stdlib_coerce_type(self: MIRLowering, type_info: TypeTypeInput) RETURNS !?String@symbol ->
    MUTABLE ti: ?Type = TRY (type__from_node(castTypeTypeInputToType__mir_lowering(type_info)));
    IF ti EXISTS AS ti_value THEN
      MUTABLE resolved = type__resolved(ti_value);
      IF TRUE THEN
        RETURN resolved;
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
END
PRIVATE FN mIRLowering__matched_call_signature(self: MIRLowering, node: CallNode) RETURNS !?FunctionSignature@multiowned ->
    MUTABLE raw: ?FunctionSignature@multiowned = NIL;
    MATCH node START
