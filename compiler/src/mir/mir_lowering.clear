    RETURN HashLiteralCapabilityPlan{ zig_type: COPY zig_type, init_value: COPY mIRLowering__hash_literal_init_struct(rtoc_self_view, zig_type, plan.alloc, TRY (type__map_init_needs_alloc?(bare_type))), empty_result: Emittable{ CapWrap: COPY empty_result }, result_wrap: :striped, result_wrap_fn: COPY wrap_fn };
}
