        IF pending_stmts[mark_idx] EXISTS AS pending_stmt THEN
          IF pending_stmt IS_A AllocMark AS alloc_mark THEN
            IF (alloc_mark.name == consumed_name) THEN
              mark_alloc = COPY alloc_mark.alloc;
              mark_idx = -1;
