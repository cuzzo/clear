FN mIRLowering__finalize_ownership_for_mir_node_mut(MUTABLE self: MIRLowering, MUTABLE node: Emittable, body: []Emittable, MUTABLE state: OwnershipFinalizationContext) RETURNS !Void
  EFFECTS REENTRANT ->
    IF mIRLowering__ownership_finalized_node?(&self, node) THEN
      TRY (mIRLowering__append_already_finalized_node_mut(&self, &state, &node));
      RETURN;
    END
    TRY (mIRLowering__finalize_nested_mir_bodies_mut(&self, &node, state, state.inherited_alloc_names, state.guarded_cleanup_names));
    TRY (mIRLowering__append_implicit_alloc_fact_mut(&self, &node, &state));
    TRY (mIRLowering__append_block_result_transfer_mut(&self, node, body, &state));
    TRY (mIRLowering__append_transfer_marks_mut(&self, TRY (mIRLowering__pre_terminator_transfer_marks(&self, node, state.out, body)), &state));
    IF node IS_A BreakStmt AS break_stmt THEN
      TRY (mIRLowering__append_transfer_marks_mut(&self, TRY (mIRLowering__ownership_transfers_for_node(&self, Emittable{ BreakStmt: COPY break_stmt }, state)), &state));
    END
    &state.out.append(COPY node);
    TRY (mIRLowering__append_move_guard_for_transfer_mark_mut(&self, node, &state));
    MUTABLE surface: ?OwnershipSurfaceScan = NIL;
    MUTABLE facts: []MIRLoweringOwnershipFact = List[];
    IF node IS_A BreakStmt AS break_stmt THEN
      facts = TRY (mIRLowering__ownership_facts_for_mir_surface(&self, Emittable{ BreakStmt: COPY break_stmt }));
    ELSE
      surface = TRY (mIRLowering__scan_ownership_surface_mut(&self, &state, NodeRoot{ Emittable: COPY node }, TRUE, TRUE));
      IF surface EXISTS AS surface_value THEN
        facts = COPY surface_value.facts;
      END
    END
    state.out = ruby_array_concat_Emittable__mir_lowering(state.out, CAST(facts AS []Emittable));
    mIRLowering__mark_ownership_finalized_node_mut(&self, &node);
    mIRLowering__mark_ownership_finalized_nodes_mut(&self, CAST(facts AS []Emittable));
    IF !(surface) THEN
      TRY (mIRLowering__record_ownership_finalization_node_mut(&self, &state, NodeRoot{ Emittable: COPY node }));
    END
    IF !(node IS_A BreakStmt) THEN
      TRY (mIRLowering__append_transfer_marks_mut(&self, TRY (mIRLowering__ownership_transfers_for_targets(&self, (UNWRAP (surface)).transfer_targets, state)), &state));
    END
    NIL;
END
FN mIRLowering__append_move_guard_for_transfer_mark_mut(MUTABLE self: MIRLowering, node: Emittable, MUTABLE state: OwnershipFinalizationContext) RETURNS !Void ->
    IF node IS_A TransferMark AS transfer_mark THEN
      MUTABLE transfer_mark_mutable = COPY transfer_mark;
      IF !(((transfer_mark_mutable.target == :owned_sink) OR (transfer_mark_mutable.target == :return))) THEN
        RETURN;
      END
      MUTABLE name = COPY transfer_mark_mutable.name;
      MUTABLE guarded = state.guarded_cleanup_names.contains?(name);
      IF !(guarded) THEN
        MUTABLE owner_cleanup: ?Emittable = mIRLowering__owner_cleanup_for_transfer(&self, state, name);
        IF owner_cleanup EXISTS AS owner_cleanup_value THEN
          MUTABLE owner_cleanup_value_mutable = COPY owner_cleanup_value;
          MUTABLE rtoc_mutable_receiver_51: ?CleanupEntry@multiowned = emittable__cleanup_entry(owner_cleanup_value_mutable);
          cleanupEntry__mark_moved_guard_mut( UNWRAP (rtoc_mutable_receiver_51));
          &state.guarded_cleanup_names.insert(name);
          IF state.parent EXISTS AS MUTABLE parent_state THEN
            &parent_state.guarded_cleanup_names.insert(COPY name);
          END
          guarded = TRUE;
        ELSE
        MUTABLE entry: ?CleanupEntry@multiowned = COPY (TRY (functionState__bindings(mIRLowering__function_state(&self))))[name];
        IF ((entry) AND cleanupEntry__needs_cleanup?(entry)) THEN
            cleanupEntry__mark_moved_guard_mut(&entry);
            &state.guarded_cleanup_names.insert(name);
            IF state.parent EXISTS AS MUTABLE parent_state THEN
            &parent_state.guarded_cleanup_names.insert(COPY name);
          END
            guarded = TRUE;
        END
        END
      END
      IF !(guarded) THEN
        RETURN;
      END
      IF state.move_mark_names.contains?(locatable__name( CAST(transfer_mark_mutable AS Locatable))) THEN
        RETURN;
      END
      MUTABLE move = COPY UNWRAP ((TRY (ownershipTransferPlan__marks((OwnershipTransferPlan{ name: UNWRAP (COPY locatable__name( CAST(transfer_mark_mutable AS Locatable))), target: COPY transfer_mark_mutable.target, target_alloc: COPY transfer_mark_mutable.target_alloc, move_guarded: TRUE })))).last());
      &state.out.append(castStmtToEmittable(move));
      state.out = ruby_array_concat_Emittable__mir_lowering(state.out, CAST(TRY (mIRLowering__ownership_facts_for_structural_node(&self, UNWRAP (state.out.last()))) AS []Emittable));
      TRY (mIRLowering__record_ownership_finalization_node_mut(&self, &state, castStmtToNodeRoot(move)));
      NIL;
    ELSE
      RETURN;
    END
END
FN mIRLowering__owner_cleanup_for_transfer(MUTABLE self: MIRLowering, state: OwnershipFinalizationContext, name: String) RETURNS ?Emittable ->
    MUTABLE current: ?OwnershipFinalizationContext = COPY state;
    WHILE current EXISTS AS current_state DO
      MUTABLE found: ?Emittable = (COPY current_state.cleanup_by_name)[name];
      IF found EXISTS AS found_value THEN
        RETURN COPY found_value;
      END
      current = COPY current_state.parent;
    END
    RETURN NIL;
END
FN mIRLowering__append_implicit_alloc_fact_mut(MUTABLE self: MIRLowering, MUTABLE node: Emittable, MUTABLE state: OwnershipFinalizationContext) RETURNS !Void ->
    MUTABLE alloc_mark: ?AllocMark = TRY (mIRLowering__implicit_alloc_mark_for_mir_node(&self, &node, state));
