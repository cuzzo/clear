PRIVATE FN mIRLowering__var_decl_facts(self: MIRLowering, MUTABLE node: VarDecl) RETURNS !VarDeclFacts
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE is_mutable = (TRUE AND node.mutable);
    MUTABLE ft = TRY (type__new(TypeConstructionInput{ Type: COPY TRY (aST__full_type_mut(node)) }));
    is_mutable = (is_mutable OR ((((TRY (type__dynamic_stream?(ft)) OR TRY (type__bounded_stream?(ft))) OR type__shared_promise?(ft)) OR TRY (type__open_stream?(ft))) OR TRY (type__inf_stream?(ft))));
    is_mutable = (is_mutable OR type__collection?(ft));
    is_mutable = (is_mutable OR type__any_sync?(ft));
    is_mutable = (is_mutable OR (type__resource?(ft) OR node.resource_close_plan));
    IF type__local?(ft) THEN
      is_mutable = FALSE;
    END
    IF (IF (IF node.symbol != NIL THEN
      symbolEntry__poly_borrow_target(node.symbol)
    ELSE
      NIL
    END) != NIL THEN (IF node.symbol != NIL THEN
      symbolEntry__poly_borrow_target(node.symbol)
    ELSE
      NIL
    END) ELSE (IF node.symbol != NIL THEN
      symbolEntry__mutable_ref_target(node.symbol)
    ELSE
      NIL
    END) END) THEN
      is_mutable = TRUE;
    END
    is_mutable = (is_mutable == TRUE);
    MUTABLE node_entry = node.mir_binding_entry;
    MUTABLE decl_name = COPY CAST(node.name AS String);
    MUTABLE binding_entry = node_entry;
    MUTABLE transport_plan = node.ownership_transport_plan;
    MUTABLE inferred_borrow = (transport_plan IS_A OwnershipTransportPlan AND (transport_plan.action() == :borrow));
    IF inferred_borrow THEN
      binding_entry = new();
    END
    MUTABLE empty_optional_init = mIRLowering__optional_nil_initializer?(rtoc_self_view, ft, node.value);
    MUTABLE has_mir_drop = (binding_entry.needs_cleanup?() AND !(binding_entry.match_as?()));
    MUTABLE heap_return_var = (!(empty_optional_init) AND mIRLowering__current_function_heap_carry_return_var?(rtoc_self_view, CAST(node.name AS String)));
    MUTABLE heap_return_binding_allocates = (((heap_return_var AND (mIRLowering__escaping_value_alloc(rtoc_self_view, ft) == :heap))) == TRUE);
    MUTABLE placement = mIRLowering__binding_placement_fact(rtoc_self_view, node, ft, binding_entry, heap_return_var, heap_return_binding_allocates);
    MUTABLE actually_mutated = ((is_mutable AND TRUE) AND (node.var_mutated == TRUE));
    IF TRY (type__node_reference?(ft)) THEN
      actually_mutated = ((node.symbol != NIL) AND (((node.symbol)?).reassigned == TRUE));
    END
    actually_mutated = (actually_mutated == TRUE);
    MUTABLE is_heap = bindingFact__heap?(placement);
    MUTABLE has_mutable_cleanup = ((((((((((has_mir_drop OR type__collection?(ft)) OR TRY (type__dynamic_stream?(ft))) OR TRY (type__bounded_stream?(ft))) OR type__shared_promise?(ft)) OR TRY (type__open_stream?(ft))) OR TRY (type__inf_stream?(ft))) OR ((type__array?(ft) AND type__dynamic?(ft)))) OR is_heap) OR type__resource?(ft)) OR node.resource_close_plan);
    MUTABLE forced_var = (is_mutable AND has_mutable_cleanup);
    forced_var = (forced_var == TRUE);
    MUTABLE by_ref_borrow = (((node.symbol != NIL) AND ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_657 = ((node.symbol)?);
    symbolEntry__mutable_ref_target(rtoc_local_receiver_657) } == TRUE)) OR ((node.symbol != NIL) AND ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_658 = ((node.symbol)?);
    symbolEntry__poly_borrow_target(rtoc_local_receiver_658) } == TRUE)));
    MUTABLE keyword_mutable = (is_mutable AND (((actually_mutated OR forced_var) OR by_ref_borrow)));
    MUTABLE zig_type = mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ Type: COPY TRY (aST__full_type_mut(node)) });
    MUTABLE needs_annotation = ((((zig_primitives.contains?(zig_type) OR type__fn_type?(ft)) OR type__error_union?(ft)) OR ((node.value IS_A Literal AND (node.value.type() == symbol("NIL"))))) OR ((TRY (type__string?(ft)) AND is_heap)));
    MUTABLE annotation_branch_value: ?Type = NIL;
    IF needs_annotation THEN
      annotation_branch_value = ft;
    ELSE
      annotation_branch_value = NIL;
    END
    MUTABLE annotation: ?Type = annotation_branch_value;
    MUTABLE base_decl_alloc = COPY placement.alloc;
    MUTABLE next_owned_alloc: ?String@symbol =   IF node.value IS_A NextExpr THEN
      mIRLowering__next_result_owned_alloc(rtoc_self_view, TRY (type__from_node_mut(node.value.expr(), "NEXT source")), ft, base_decl_alloc)
    ELSE
      NIL
    END;
    MUTABLE source_owned_alloc: ?String@symbol = IF inferred_borrow THEN
      NIL
    ELSE
      mIRLowering__owned_binding_source_alloc(rtoc_self_view, node.value)
    END;
    MUTABLE init_ownership_effect_branch_value: ?OwnershipEffect = NIL;
    IF next_owned_alloc EXISTS AS next_owned_alloc_value THEN
      init_ownership_effect_branch_value = ownershipEffect__owned(next_owned_alloc_value);
    ELSE
      IF source_owned_alloc EXISTS AS source_owned_alloc_value THEN
        init_ownership_effect_branch_value = ownershipEffect__owned(source_owned_alloc_value);
      ELSE
        init_ownership_effect_branch_value = ownershipEffect__none();
      END
    END
    MUTABLE init_ownership_effect: OwnershipEffect = init_ownership_effect_branch_value?;
    MUTABLE decl_alloc = IF placement__explicit_heap?(base_decl_alloc) THEN
      :heap
    ELSE
      ((init_ownership_effect.alloc OR_ELSE base_decl_alloc))
    END;
    MUTABLE has_caps = !(!(((((type__any_sync?(ft) OR (type__ownership(ft) != :affine))) AND !(type__striped?(ft))))));
    MUTABLE bare_ft_branch_value: ?Type = NIL;
    IF has_caps THEN
      bare_ft_branch_value = TRY (type__bare_data_type((TRY (type__non_optional_type(ft)))));
    ELSE
      bare_ft_branch_value = ft;
    END
    MUTABLE bare_ft: Type = bare_ft_branch_value?;
    MUTABLE bare_zig = mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ Type: COPY bare_ft });
    RETURN VarDeclFacts{ ft: COPY ft, binding_entry: binding_entry, has_mir_drop: has_mir_drop, actually_mutated: actually_mutated, forced_var: forced_var, keyword_mutable: keyword_mutable, annotation: COPY annotation, heap_return_var: (heap_return_var == TRUE), decl_alloc: COPY decl_alloc, init_ownership_effect: init_ownership_effect, source_owned_binding: !((source_owned_alloc == NIL)), has_caps: has_caps, bare_zig: COPY bare_zig, generic_id: type__id_handle?(ft) };
}
END
PRIVATE FN mIRLowering__optional_nil_initializer?(self: MIRLowering, type_info: Type, value: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(type__optional?(type_info)) THEN
      RETURN FALSE;
    END
    MUTABLE node: Locatable = COPY value;
    WHILE node IS_A Cast DO
      node = node.value;
    END
    IF (IF node IS_A Literal AS literal THEN (literal.type == symbol("NIL")) ELSE FALSE END) THEN
      RETURN TRUE;
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN mIRLowering__owned_binding_source_alloc(self: MIRLowering, value: Locatable) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (value IS_A CopyNode OR value IS_A KeepNode) THEN
      RETURN NIL;
    END
    MUTABLE node = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_660: ?Void = NIL;
    IF value IS_A MoveNode THEN
      rtoc_ternary_value_660 = value.value();
    ELSE
      rtoc_ternary_value_660 = value;
    END
    rtoc_ternary_value_660? };
    IF !(node IS_A Identifier) THEN
      RETURN NIL;
    END
    MUTABLE ti = TRY (type__from_node_mut(node, "owned binding source"));
    IF !(mIRLowering__ownership_tracked_transfer_type?(rtoc_self_view, ti)) THEN
      RETURN NIL;
    END
    MUTABLE entry: ?CleanupEntry@multiowned = COPY (TRY (functionState__bindings(mIRLowering__function_state(rtoc_self_view))))[CAST(node.name() AS String)];
    IF !((IF entry != NIL THEN
      cleanupEntry__needs_cleanup?(entry)
    ELSE
      NIL
    END)) THEN
      RETURN NIL;
    END
    RETURN cleanupEntry__alloc(entry);
}
END
PRIVATE FN mIRLowering__var_decl_source_transfer_required?(self: MIRLowering, node: VarDecl, facts: VarDeclFacts, init_effect: OwnershipEffect) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE plan = node.ownership_transport_plan;
    IF (plan IS_A OwnershipTransportPlan AND (plan.action() != :move)) THEN
      RETURN FALSE;
    END
    IF mIRLowering__var_decl_source_borrowed?(rtoc_self_view, node) THEN
      RETURN FALSE;
    END
    IF facts.source_owned_binding THEN
      RETURN TRUE;
    END
    IF init_effect.produces_owned THEN
      RETURN FALSE;
    END
    RETURN mIRLowering__ownership_tracked_transfer_type?(rtoc_self_view, facts.ft);
}
END
PRIVATE FN mIRLowering__var_decl_source_borrowed?(self: MIRLowering, node: VarDecl) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF aST__container_borrow?(Locatable{ VarDecl: COPY node }) THEN
      RETURN TRUE;
    END
    RETURN ((node.symbol != NIL) AND ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_661 = ((node.symbol)?);
    symbolEntry__borrow_provenance?(rtoc_local_receiver_661) } == TRUE));
}
END
PRIVATE FN mIRLowering__var_decl_safe_name(self: MIRLowering, node: VarDecl, has_mir_drop: Bool) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE safe_name: String = "";
    MUTABLE decl_name_map = TRY (functionState__decl_zig_names(mIRLowering__function_state(rtoc_self_view)));
    MUTABLE alloc_marked_names = TRY (functionState__alloc_marked_names(mIRLowering__function_state(rtoc_self_view)));
    MUTABLE rename_map = TRY (functionState__rename_map(mIRLowering__function_state(rtoc_self_view)));
    IF (CAST(node.name AS String) == "_") THEN
      safe_name = "__discard_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_662 = mIRLowering__lowering_counters(rtoc_self_view);
      mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_662) }}";
    ELSE
      safe_name = mIRLowering__zig_safe_name(rtoc_self_view, node.name);
    END
    MUTABLE original_safe = COPY safe_name;
    IF alloc_marked_names.contains?(safe_name) THEN
      safe_name = mIRLowering__zig_safe_name(rtoc_self_view, "${node.name}_L${(mIRLowering__function_relative_line(rtoc_self_view, node.line())).toString()}");
    END
    alloc_marked_names[safe_name] = TRUE;
    decl_name_map[node.object_id()] = safe_name;
    rename_map[original_safe] = safe_name;
    RETURN safe_name;
}
END
PRIVATE FN mIRLowering__var_decl_suppression(self: MIRLowering, safe_name: String, node: VarDecl, facts: VarDeclFacts, init: Emittable) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE lowering = rtoc_self_view;
    IF !(mIRLowering__current_function_context(rtoc_self_view)) THEN
      RETURN NIL;
    END
    MUTABLE owned_cleanup_value = (((facts.has_mir_drop OR ((mIRLowering__mir_allocates?(lowering, init) AND lowering.ownership_bearing_type?(facts.ft))))) == TRUE);
    IF facts.keyword_mutable THEN
      IF ((facts.actually_mutated AND (node.var_used != NIL)) AND !(facts.forced_var)) THEN
        RETURN NIL;
      ELSE
        RETURN "_ = &${safe_name};";
      END
    ELSE
      IF node.var_used EXISTS AS var_used_value THEN
        RETURN NIL;
      END
      IF owned_cleanup_value THEN
        RETURN "_ = &${safe_name};";
      ELSE
        RETURN "_ = ${safe_name};";
      END
    END
}
END
PRIVATE FN mIRLowering__stamp_var_decl_init_target_mut(self: MIRLowering, MUTABLE init: Emittable, safe_name: String, decl_alloc: String@symbol) RETURNS Void
  REQUIRES self: LOCAL
