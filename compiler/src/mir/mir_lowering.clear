    RETURN Emittable{ DupeSlice: COPY DupeSlice{ source: Emittable{ Call: COPY call }, alloc: :heap, lowered_node_id: NIL, ownership_consumption: NIL } };
}
END
PRIVATE FN mIRLowering__attach_explicit_move_consumption_mut(self: MIRLowering, MUTABLE call: Call, ast_args: []Locatable, mir_args: []Emittable, source: String, contract: ?CallableContract) RETURNS !Void
