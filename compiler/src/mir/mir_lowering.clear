    END
    MUTABLE profile = ProfileTaskSite{ site_id: site_id, line: rtoc_site_line, column: rtoc_site_column, dispatch: :local, form: :stack };
    MUTABLE structural = FutureMapPlan{ id: COPY id, ctx_type: COPY names.ctx_type, ctx_var: COPY names.ctx_var, alloc_var: COPY names.alloc_var, promise_var: COPY names.promise_var, blk_label: COPY names.blk_label, raw_rt: COPY names.bg_rt, rt_name: COPY mIRLowering__runtime_binding_name(&self), source: COPY source, source_field: "source", source_shared: (operation.handle_use == TenseHandleUse.SharedRead), run_body: COPY run_body, promise_zig: COPY promise_zig, spawn_call: COPY spawn, profile_site: COPY profile, result_type: COPY future_type };
    MUTABLE bg = MIRBgBlock{ code: BgBlockPlan{ FutureMapPlan: COPY structural }, captures: {}, run_body: COPY run_body, fsm_structure: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, boundary_fact: NIL, result_type: NIL };
    bg.result_type = future_type;
    bg.boundary_fact = TRY (mIRLowering__execution_boundary_fact(&self, :bg, :local, NIL));
    IF tenseOperationPlan__consumes_handle?(operation) THEN
    IF source IS_A Ident AS ident THEN
      MUTABLE ident_mutable = COPY ident;
      TRY (mIRLowering__with_ownership_consumption(&self, Emittable{ MIRBgBlock: COPY bg }, [ident_mutable.name], "tense future-map capture", :capture, :heap));
    END
    END
    RETURN bg;
END
PRIVATE FN mIRLowering__tense_map_cleanup_entry(self: MIRLowering, type_info: Type, lifecycle: LifecyclePlan) RETURNS !CleanupEntry@multiowned ->
    MUTABLE entry_branch_value: ?CleanupEntry = NIL;
    IF (lifecycle.drop_strategy == :resource_close) THEN
      entry_branch_value = cleanupEntry__build(:resource, :heap, FALSE, UNWRAP (lifecycle.resource_close_plan));
    ELSE
      entry_branch_value = cleanupEntry__build(:uniform, :heap, FALSE, NIL, TRY (type__zig_type(type_info)));
    END
    MUTABLE entry: CleanupEntry@multiowned = entry_branch_value?;
    cleanupEntry__set_lifecycle_plan_mut(&entry, lifecycle);
    RETURN KEEP entry;
END
PRIVATE FN mIRLowering__tense_map_bindings(self: MIRLowering, id: Int64, segment: String, count_value: Int64) RETURNS ![]String ->
    MUTABLE bindings: []String = List[];
    FOR rtoc_counter_t IN (0_i64 ..< count_value) DO
      &bindings.append("__tense_${segment}${id.toString()}_${rtoc_counter_t.toString()}");
    END
    RETURN bindings;
END
PRIVATE FN mIRLowering__direct_tense_map(self: MIRLowering, source: Emittable, mapped: Emittable, layers: []TenseLayer, bindings: []String, id: Int64, result_type: Type, label_suffix: String = "outer") RETURNS DirectTenseMap ->
    MUTABLE rtoc_tuple_return_566 = DirectTenseMap{ source: COPY source, mapped: COPY mapped, layers: COPY ( { MUTABLE rtoc_map_results = CAST([] AS []String); layers |> EACH { &rtoc_map_results.append(COPY tenseLayer__marker(_)); }; rtoc_map_results } ), bindings: COPY bindings, label: "__tense_${label_suffix}_${id.toString()}", result_type: COPY result_type };
    RETURN rtoc_tuple_return_566;
END
PRIVATE FN mIRLowering__unit_variant_constructor(MUTABLE self: MIRLowering, node: GetField) RETURNS !?StructInit ->
    MUTABLE target_node = COPY node.target;
    IF target_node IS_A Identifier AS identifier THEN
      MUTABLE schema: ?UnionSchema@multiowned = COPY (TRY (mIRLowering__union_schemas(&self)))[symbol(identifier__name(identifier))];
      IF !(schema) THEN
        RETURN NIL;
      END
      MUTABLE field_key: ?MIRLoweringReturnValue = mIRLowering__union_variant_key(self, schema, MIRLoweringField{ StringValue: COPY node.field });
      IF field_key EXISTS AS field_key_value THEN
        MUTABLE rtoc_variant_key: String@symbol = :unknown;
        PARTIAL MATCH field_key_value START
          MIRLoweringReturnValue.StringValue AS rtoc_key_str -> rtoc_variant_key = symbol(rtoc_key_str);,
          MIRLoweringReturnValue.SymbolValue AS rtoc_key_sym -> rtoc_variant_key = rtoc_key_sym;,
          DEFAULT -> PASS;
        END
        MUTABLE var_data: ?SchemasUnionSchemaVariantValue = COPY schema.variants[rtoc_variant_key];
        IF schemas__inline_struct?(var_data) THEN
          RETURN NIL;
        END
        RETURN StructInit{ zig_type: identifier__name(identifier), fields: [CAST({:name: CAST(node.field AS String), :value: VoidLiteral{ lowered_node_id: NIL, ownership_consumption: NIL }} AS Any)], lowered_node_id: NIL, ownership_consumption: NIL };
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
END
PRIVATE FN mIRLowering__field_access_plan(MUTABLE self: MIRLowering, node: GetField, target: Emittable) RETURNS !FieldAccessPlan ->
    MUTABLE target_node = COPY node.target;
    MUTABLE ti: ?Type = TRY (type__from_node_mut(target_node, "field target"));
    MUTABLE rc_map = (mIRLowering__capability_state(&self).rc_unwrap_map OR_ELSE {});
    MUTABLE locked_map = (mIRLowering__capability_state(&self).locked_unwrap_map OR_ELSE {});
    MUTABLE is_rc_unwrapped: Bool = FALSE;
    IF target_node IS_A Identifier AS identifier THEN
      is_rc_unwrapped = rc_map.contains?(identifier__name(identifier));
    ELSE
      is_rc_unwrapped = FALSE;
    END
    MUTABLE is_locked_unwrapped: Bool = FALSE;
    IF target_node IS_A Identifier AS identifier THEN
      is_locked_unwrapped = locked_map.contains?(identifier__name(identifier));
    ELSE
      is_locked_unwrapped = FALSE;
    END
    # `(target_node.optional_unwrap? ? target_node.target : target_node)
    # .symbol&.sync` -- one subject, one optional chain.
    MUTABLE rtoc_sync_subject: Locatable = COPY target_node;
    IF target_node IS_A OptionalUnwrap THEN
      rtoc_sync_subject = COPY UNWRAP (aST__node_target(target_node));
    END
    MUTABLE target_sync: ?String@symbol = NIL;
    IF locatable__symbol(rtoc_sync_subject) EXISTS AS rtoc_sync_symbol THEN
      target_sync = symbolEntry__sync(rtoc_sync_symbol);
    END
    IF (target_sync == NIL) THEN
      target_sync = type__sync(TRY (aST__full_type_mut(target_node)));
    END
    MUTABLE path = mIRLowering__field_access_path(self, UNWRAP (ti), target_sync, is_rc_unwrapped, is_locked_unwrapped);
    IF ((((path == :direct) AND target_node IS_A Identifier) AND (IF locatable__symbol(target_node) EXISTS AS rtoc_carrier_symbol THEN ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_567 = COPY rtoc_carrier_symbol;
    symbolEntry__carrier_contract(rtoc_local_receiver_567) } == :monomorphic) ELSE FALSE END)) AND !(is_rc_unwrapped)) THEN
      path = :comptime_ctrl_data;
    END
    MUTABLE target_type_sym = symbol((CAST(type__resolved( UNWRAP (ti)) AS String)));
    MUTABLE union_schema: ?UnionSchema@multiowned = COPY (TRY (mIRLowering__union_schemas(&self)))[target_type_sym];
    MUTABLE union_variants: ?{String@symbol}?SchemasUnionSchemaVariantValue = NIL;
    IF union_schema EXISTS AS rtoc_union_schema THEN
      union_variants = COPY rtoc_union_schema.variants;
    END
    MUTABLE field_str: String = "";
    IF (node.tuple_position == NIL) THEN
      field_str = COPY CAST(node.field AS String);
    ELSE
      field_str = "@\"${UNWRAP (node.tuple_position).toString()}\"";
    END
    MUTABLE union_payload = (TRUE AND (((union_variants.contains?(node.field) OR union_variants.contains?(field_str)) OR union_variants.contains?(CAST(symbol(field_str) AS String)))));
    RETURN FieldAccessPlan{ target: COPY target, field: COPY field_str, path: COPY path, union_payload: (union_payload == TRUE), union_payload_zig: COPY IF union_payload THEN
      TRY (type__zig_type( UNWRAP (ti)))
    ELSE
      NIL
    END, indirect: ((node.indirect_field == TRUE) AND !(type__optional?((TRY (aST__full_type_mut(Locatable{ GetField: COPY node })))))) };
END
PRIVATE FN mIRLowering__field_access_path(self: MIRLowering, type_info: Type, target_sync: ?String@symbol, is_rc_unwrapped: Bool, is_locked_unwrapped: Bool) RETURNS String@symbol ->
    IF (((type__multiowned?(type_info) OR type__shared?(type_info))) AND !(is_rc_unwrapped)) THEN
      RETURN :ctrl_data;
    END
    IF ((((target_sync == :locked) OR (target_sync == :write_locked))) AND !(is_locked_unwrapped)) THEN
      RETURN :ctrl_data;
    END
    IF ((target_sync == :always_mutable) AND !(is_locked_unwrapped)) THEN
      RETURN :data;
    END
    RETURN :direct;
END
PRIVATE FN mIRLowering__or_else_exit_facts(self: MIRLowering, ex: OrElseExit, line: Int64) RETURNS !OrElseExitFacts ->
    MUTABLE kind: ?String = NIL;
    MUTABLE error_name: ?String = NIL;
    MUTABLE name_id: ?Int64 = NIL;
    MUTABLE clear_type: Bool = FALSE;
    MUTABLE explicit_error_name: ?String = COPY ex.error_name;
    IF ex.kind THEN
      kind = COPY (ex.kind OR_ELSE "");
      IF explicit_error_name EXISTS AS explicit_error_name_value THEN
        error_name = COPY explicit_error_name_value;
        name_id = TRY (aST__id_of_type(symbol(explicit_error_name_value)));
      ELSE
        clear_type = TRUE;
      END
    ELSE_IF explicit_error_name EXISTS AS rtoc_explicit_name THEN
      IF TRY (aST__error_type?(symbol(rtoc_explicit_name))) THEN
        kind = COPY CAST((TRY (aST__kind_of_type(symbol(rtoc_explicit_name)))) AS String);
        error_name = COPY rtoc_explicit_name;
        name_id = TRY (aST__id_of_type(symbol(rtoc_explicit_name)));
      END
    END
    RETURN OrElseExitFacts{ kind: COPY kind, error_name: COPY error_name, name_id: name_id, clear_type: clear_type, has_message: !((ex.message == NIL)), line: line.toInt() };
END
PRIVATE FN mIRLowering__runtime_error_field(MUTABLE self: MIRLowering, field: String) RETURNS FieldGet ->
    RETURN FieldGet{ object: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: mIRLowering__runtime_binding_name(&self), lowered_node_id: NIL, ownership_consumption: NIL } }, field: "__error", lowered_node_id: NIL, ownership_consumption: NIL } }, field: COPY field, lowered_node_id: NIL, ownership_consumption: NIL };
END
PRIVATE FN mIRLowering__or_else_exit_error_update_stmts(MUTABLE self: MIRLowering, facts: OrElseExitFacts) RETURNS ![]Emittable ->
    MUTABLE stmts: []Emittable = List[];
    IF facts.kind EXISTS AS kind_value THEN
      &stmts.append(CAST(Set{ target: Emittable{ FieldGet: COPY mIRLowering__runtime_error_field(&self, "kind") }, value: Emittable{ EnumTag: COPY EnumTag{ variant: COPY kind_value } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable));
      IF facts.error_name EXISTS AS error_name_value THEN
        MUTABLE name_id = EnumOrdinal{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "ErrorName", lowered_node_id: NIL, ownership_consumption: NIL } }, field: COPY error_name_value, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL };
        &stmts.append(CAST(Set{ target: Emittable{ FieldGet: COPY mIRLowering__runtime_error_field(&self, "error_name") }, value: Emittable{ EnumOrdinal: COPY name_id }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable));
      ELSE
      IF facts.clear_type THEN
          &stmts.append(CAST(Set{ target: Emittable{ FieldGet: COPY mIRLowering__runtime_error_field(&self, "error_name") }, value: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable));
      END
      END
    END
    RETURN stmts;
END
PRIVATE FN mIRLowering__or_else_exit_bc_reassign(self: MIRLowering, facts: OrElseExitFacts, msg_mir: ?Emittable) RETURNS OrElseExitBcRewrite ->
    RETURN OrElseExitBcRewrite{ kind: COPY facts.kind, name_id: facts.name_id, clear_type: facts.clear_type, has_message: facts.has_message, line: facts.line, message: COPY msg_mir, lowered_node_id: NIL, ownership_consumption: NIL };
END
PRIVATE FN mIRLowering__or_else_exit_scope(MUTABLE self: MIRLowering, facts: OrElseExitFacts, msg_mir: ?Emittable, return_value: Emittable) RETURNS !ScopeBlock ->
    MUTABLE stmts = TRY (mIRLowering__or_else_exit_error_update_stmts(&self, facts));
    IF msg_mir EXISTS AS msg_mir_value THEN
      &stmts.append(CAST(Set{ target: Emittable{ FieldGet: COPY mIRLowering__runtime_error_field(&self, "message") }, value: COPY msg_mir_value, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable));
    END
    &stmts.append(CAST(Set{ target: Emittable{ FieldGet: COPY mIRLowering__runtime_error_field(&self, "clear_line") }, value: Emittable{ Lit: COPY Lit{ value: COPY facts.line.toString(), lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable));
    &stmts.append(CAST(ReturnStmt{ value: COPY return_value, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable));
    RETURN ScopeBlock{ body: COPY (stmts |> SELECT (IF ((_ IS_A ReturnStmt) OR (_ IS_A Set)) THEN
      COPY _
    ELSE
      Emittable{ ExprStmt: COPY ExprStmt{ expr: castStmtToEmittable(COPY _), discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }
    END)), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN mIRLowering__binary_int_arithmetic_facts(self: MIRLowering, node: BinaryOp) RETURNS !BinaryIntArithmeticFacts ->
    MUTABLE left_ti = TRY (aST__full_type_mut(node.left));
    MUTABLE right_ti = TRY (aST__full_type_mut(node.right));
    RETURN BinaryIntArithmeticFacts{ both_int: (((TRUE) AND (type__integer?(left_ti) == TRUE)) AND ((TRUE) AND (type__integer?(right_ti) == TRUE))), has_comptime_number_literal: (mIRLowering__comptime_number_literal?(self, node.left, left_ti) OR mIRLowering__comptime_number_literal?(self, node.right, right_ti)), has_float_coercion: (mIRLowering__float_coercion?(self, node.left) OR mIRLowering__float_coercion?(self, node.right)) };
END
PRIVATE FN mIRLowering__comptime_number_literal?(self: MIRLowering, node: Locatable, ti: ?Type) RETURNS Bool ->
    IF node IS_A Literal AS literal THEN
      IF !((literal.type == :NUMBER)) THEN
        RETURN FALSE;
      END
      RETURN ((ti == NIL) OR !(type__integer?(ti)));
    ELSE
      RETURN FALSE;
    END
END
PRIVATE FN mIRLowering__float_coercion?(self: MIRLowering, node: Locatable) RETURNS Bool ->
    MUTABLE coerced: ?Type = locatable__coerced_type_info(node);
    IF (coerced == NIL) THEN
      RETURN FALSE;
    END
    RETURN (type__integer?( coerced) != TRUE);
END
PRIVATE FN mIRLowering__lower_get_index(MUTABLE self: MIRLowering, MUTABLE node: GetIndex) RETURNS !Emittable ->
    IF (node.protocol_operation == :map_get) THEN
      MUTABLE receiver: Emittable = CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(node.target))) AS Emittable);
      IF !(mIRLowering__collection_param_receiver?(&self, node.target)) THEN
        receiver = Emittable{ AddressOf: COPY AddressOf{ expr: COPY receiver, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
      RETURN Emittable{ ProtocolCall: COPY ProtocolCall{ protocol: :Map, operation: :get, receiver: COPY receiver, args: [CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(node.index))) AS Emittable)], lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    MUTABLE plan = TRY (mIRLowering__index_access_plan(&self, node));
    MUTABLE value = TRY (mIRLowering__index_access_value(&self, plan));
    IF indexAccessPlan__optional?(plan) THEN
      MUTABLE result_type = TRY (aST__full_type_mut(Locatable{ GetIndex: COPY node }));
      IF !(type__optional?(result_type)) THEN
        result_type = TRY (type__optional_of(TypeTypeInput{ Type: COPY result_type }));
      END
      MUTABLE result = IfOptional{ optional: COPY UNWRAP (plan.optional_source), capture: "_r", then_expr: COPY value, else_expr: COPY TRY (mIRLowering__optional_nil_mir(&self, result_type)), lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
      result.result_type = result_type;
      RETURN Emittable{ IfOptional: COPY result };
    END
    RETURN value;
END
PRIVATE FN mIRLowering__index_access_plan(MUTABLE self: MIRLowering, node: GetIndex) RETURNS !IndexAccessPlan ->
    MUTABLE target_node = COPY node.target;
    MUTABLE target_ast: Locatable = target_node;
    MUTABLE implicit_safe_nav = ((aST__node_safe_nav_chain(target_node) EXISTS) AND (locatable__safe_nav_chain(target_node) == TRUE));
    MUTABLE explicit_safe_nav = (target_node IS_A OptionalUnwrap AND (locatable__safe_navigation?(target_node) OR_ELSE FALSE));
    MUTABLE optional = (explicit_safe_nav OR implicit_safe_nav);
    MUTABLE source_ast: Locatable = COPY target_node;
    IF explicit_safe_nav THEN
      source_ast = COPY UNWRAP (aST__node_target(target_node));
    END
    MUTABLE optional_source_branch_value: ?Emittable = NIL;
    IF optional THEN
      optional_source_branch_value = CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(source_ast))) AS Emittable);
    ELSE
      optional_source_branch_value = NIL;
    END
    MUTABLE optional_source: ?Emittable = optional_source_branch_value;
    MUTABLE target_branch_value: ?Ident = NIL;
    IF optional THEN
      target_branch_value = Ident{ name: "_r", lowered_node_id: NIL, ownership_consumption: NIL };
    ELSE
      target_branch_value = castEmittableToIdent(CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(target_node))) AS Emittable));
    END
    MUTABLE target: Ident = target_branch_value?;
    MUTABLE target_type: ?Type = TRY (type__from_node_mut(target_node, "index target"));
    IF implicit_safe_nav THEN
      target_type = UNWRAP (TRY (type__wrapped_type( UNWRAP (target_type))));
    END
    MUTABLE rank_indices: []Emittable = List[];
    IF type__rank?( UNWRAP (target_type)) THEN
      MUTABLE index_nodes: []Locatable = List[];
      IF node.index IS_A TupleLit THEN
        index_nodes = UNWRAP (locatable__items(node.index));
      ELSE
        index_nodes = List[COPY node.index];
      END
      rank_indices = index_nodes |> SELECT CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(_))) AS Emittable);
    ELSE
      rank_indices = List[];
    END
    RETURN IndexAccessPlan{ target: Emittable{ Ident: COPY target }, index: COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_571: ?Emittable = NIL;
    IF rank_indices THEN
      rtoc_ternary_value_571 = UNWRAP (rank_indices.first());
    ELSE
      rtoc_ternary_value_571 = CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(node.index))) AS Emittable);
    END
    rtoc_ternary_value_571? }, optional: optional, optional_source: COPY optional_source, target_ast: COPY target_ast, type_info: COPY UNWRAP (target_type), target_name: COPY IF target_node IS_A Identifier THEN
      CAST(aST__node_name(target_node) AS String)
    ELSE
      NIL
    END, needs_mut_ref: (node.needs_mut_ref == TRUE), rank_indices: COPY rank_indices };
END
PRIVATE FN mIRLowering__index_access_value(MUTABLE self: MIRLowering, plan: IndexAccessPlan) RETURNS !Emittable ->
    MUTABLE shard: ?{String@symbol}String = TRY (mIRLowering__shard_context(self));
    MUTABLE target = COPY plan.target;
    MUTABLE index = COPY plan.index;
    MUTABLE ti = COPY plan.type_info;
    IF type__rank?(ti) THEN
      RETURN Emittable{ RuntimeCall: COPY TRY (mIRLowering__rank_index_value(self, target, ti, UNWRAP (plan.rank_indices))) };
    END
    IF (TRY (type__any_rc?(ti)) AND !(mIRLowering__bc_target?(&self))) THEN
      target = Emittable{ Deref: COPY Deref{ expr: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ FieldGet: COPY FieldGet{ object: COPY target, field: "ctrl", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "data", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF indexAccessPlan__optional?(plan) THEN
      RETURN TRY (mIRLowering__index_collection_value(&self, target, index, plan));
    END
    IF (aST__metatype(plan.target_ast) == :hashmap) THEN
      MUTABLE map_ft: ?Type = TRY (type__from_node_mut(plan.target_ast, "hashmap index target"));
      MUTABLE kind = IF TRY (type__numeric_map?( UNWRAP (map_ft))) THEN
        :numeric_map
      ELSE
        :string_map
      END;
            MUTABLE op: ?FunctionSignature@multiowned = NIL;
    op = TRY (intrinsicRegistry__lookup_single(:index_ops, "${CAST(kind AS String)}_get"));
      IF op EXISTS AS op_value THEN
        MUTABLE op_value_mutable = COPY op_value;
        MUTABLE shard_direct = ((shard != NIL) AND (plan.target_name == shard[:map]));
        MUTABLE template_kind =       IF shard_direct THEN
          IntrinsicTemplateKind.ShardDirectZig
        ELSE_IF (((type__sharded?( UNWRAP (map_ft)) OR type__striped?( UNWRAP (map_ft)))) AND (TRY (functionSignature__intrinsic_template(op_value_mutable, IntrinsicTemplateKind.ShardedZig)) != NIL)) THEN
          IntrinsicTemplateKind.ShardedZig
        ELSE
          IntrinsicTemplateKind.Zig
        END;
        MUTABLE alloc_metadata = inlineAllocMetadata__new();
        MUTABLE key_type_branch_value: ?Type = NIL;
        IF ((kind == :numeric_map)) THEN
          key_type_branch_value = TRY (type__key_type( UNWRAP (map_ft)));
        ELSE
          key_type_branch_value = NIL;
        END
        MUTABLE key_type: ?Type = key_type_branch_value;
        MUTABLE value_type_branch_value: ?Type = NIL;
        IF ((kind == :numeric_map)) THEN
          value_type_branch_value = TRY (type__value_type( UNWRAP (map_ft)));
        ELSE
          value_type_branch_value = NIL;
        END
        MUTABLE value_type: ?Type = value_type_branch_value;
        IF shard_direct THEN
          RETURN Emittable{ ShardedMapGet: COPY ShardedMapGet{ target: COPY target, key: COPY index, shard_idx: Emittable{ Ident: COPY Ident{ name: UNWRAP (COPY shard[:idx]), lowered_node_id: NIL, ownership_consumption: NIL } }, shard_key: Emittable{ Ident: COPY Ident{ name: COPY UNWRAP (shard[:key]), lowered_node_id: NIL, ownership_consumption: NIL } }, map_kind: COPY kind, stdlib_def: COPY op_value_mutable, key_type: COPY key_type, value_type: COPY value_type, resolved_allocs: COPY alloc_metadata, template_kind: COPY template_kind, lowered_node_id: NIL, ownership_consumption: NIL } };
        END
        RETURN Emittable{ ShardedMapGet: COPY ShardedMapGet{ target: COPY target, key: COPY index, shard_idx: NIL, shard_key: NIL, map_kind: COPY kind, stdlib_def: COPY op_value_mutable, key_type: COPY key_type, value_type: COPY value_type, resolved_allocs: COPY alloc_metadata, template_kind: COPY template_kind, lowered_node_id: NIL, ownership_consumption: NIL } };
      ELSE
        panic("indexed access: missing registry signature for {}");
      END
    ELSE_IF type__pool?(ti) THEN
      MUTABLE elem_t: ?Type = TRY (type__element_type(ti));
      MUTABLE elem_name: String = "";
      IF TRUE THEN
        elem_name = COPY CAST((type__resolved(UNWRAP (elem_t))) AS String);
      ELSE
        elem_name = COPY type__to_s( UNWRAP (elem_t));
      END
      MUTABLE pool_get_def = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_572 = UNWRAP (functionSignature__unwrap(castOptionalLookupResultToOptionalX__mir_lowering(TRY (intrinsicRegistry__lookup(:pool_methods, RegistryKey{ StringValue: COPY "get" })))));
      TRY (functionSignature__dup(rtoc_local_receiver_572)) };
      MUTABLE pool_get_emit_branch_value: ?IntrinsicEmit = NIL;
      IF functionSignature__emit(pool_get_def) THEN
        pool_get_emit_branch_value = COPY UNWRAP (functionSignature__emit(pool_get_def));
      ELSE
        pool_get_emit_branch_value = IntrinsicEmit{ zig: NIL, numeric_zig: NIL, sharded_zig: NIL, shard_direct_zig: NIL, fsm_setup: List[], fsm_state_decls: List[], fsm_finish_block: List[], fsm_state_finalize: List[], fsm_setup_present: FALSE, fsm_state_decls_present: FALSE, fsm_finish_block_present: FALSE, fsm_state_finalize_present: FALSE, fsm_finish_value: NIL, bc: FALSE, is_method: FALSE, suspends: FALSE, narrows_collection: FALSE, narrows_receiver_collection: FALSE, mutates_receiver: FALSE, allocates: FALSE, takes_value: FALSE, container_borrow: FALSE, tag: NIL, builtin: NIL, alloc: NIL, return_alloc: NIL, val_alloc: NIL, key_alloc: NIL, shard_alloc: NIL, sharded_alloc: NIL, borrows: NIL, reject_when: NIL, bc_op: NIL, error_kind: NIL, error_type: NIL, registry: NIL, elem: NIL, lifetime: List[], reject_error: NIL, arity: NIL, takes_args: List[], eql: NIL, strcmp: NIL, cleanup: NIL, assert: NIL, array: NIL, list: NIL, pool: NIL, set: NIL, get: NIL, string_raw: NIL, string_symbol: NIL, string_map: NIL, numeric_map: NIL, set_collection: NIL };
      END
      MUTABLE pool_get_emit: IntrinsicEmit = pool_get_emit_branch_value?;
      pool_get_emit.elem = elem_name;
      functionSignature__replace_intrinsic_emit_mut(&pool_get_def, pool_get_emit);
      RETURN Emittable{ InlineBc: COPY InlineBc{ op: :get, args: [target, index], stdlib_def: pool_get_def, suppress_try: FALSE, lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE_IF plan.needs_mut_ref THEN
      MUTABLE items = ListItems{ list: COPY target, lowered_node_id: NIL, ownership_consumption: NIL };
      MUTABLE cast_idx = MIRCast{ expr: COPY index, target_type: "usize", method: :intCast, lowered_node_id: NIL, ownership_consumption: NIL };
      RETURN Emittable{ IndexGet: COPY IndexGet{ object: Emittable{ ListItems: COPY items }, index: Emittable{ MIRCast: COPY cast_idx }, lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE
      RETURN TRY (mIRLowering__index_collection_value(&self, target, index, plan));
    END
END
PRIVATE FN mIRLowering__rank_index_value(self: MIRLowering, target: Emittable, type_info: Type, indices: []Emittable) RETURNS !RuntimeCall ->
    MUTABLE coordinates = TRY (mIRLowering__rank_coordinates(self, target, type_info, indices));
    RETURN RuntimeCall{ spec: COPY TRY (runtimeCalls__rank_get_spec()), args: [target, coordinates.dimensions, Emittable{ ArrayInit: COPY coordinates.indices }], lowered_node_id: NIL, ownership_consumption: NIL };
END
PRIVATE FN mIRLowering__rank_coordinates(self: MIRLowering, target: Emittable, type_info: Type, indices: []Emittable) RETURNS !RankCoordinates ->
    MUTABLE rank = TRY (type__rank(type_info));
    MUTABLE cast_indices = indices |> SELECT MIRCast{ expr: COPY _, target_type: "usize", method: :intCast, lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE index_array = ArrayInit{ elem_type: "usize", count: COPY rank.toString(), items: CAST(COPY cast_indices AS []Emittable), lowered_node_id: NIL, ownership_consumption: NIL };
    # Both arms yield a node; the Emittable wrapper is what gives them a
    # common type, and a statement IF is what lets the array arm build its
    # item list first.
    MUTABLE dimensions: Emittable = Emittable{ FieldGet: COPY FieldGet{ object: COPY target, field: "shape", lowered_node_id: NIL, ownership_consumption: NIL } };
    IF TRY (type__fixed_rank?(type_info)) THEN
      MUTABLE items = (TRY (type__rank_dimensions(type_info))) |> SELECT Lit{ value: COPY castTypeExpressionDimensionToInt64(_).toString(), lowered_node_id: NIL, ownership_consumption: NIL };
      dimensions = Emittable{ ArrayInit: COPY ArrayInit{ elem_type: "usize", count: COPY rank.toString(), items: CAST(COPY items AS []Emittable), lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    RETURN RankCoordinates{ dimensions: COPY dimensions, indices: COPY index_array };
END
PRIVATE FN mIRLowering__index_collection_value(MUTABLE self: MIRLowering, target: Emittable, index_value: Emittable, plan: IndexAccessPlan) RETURNS !Emittable ->
    MUTABLE ti = COPY plan.type_info;
    IF type__set_collection?(ti) THEN
      MUTABLE elem_zig = TRY (type__zig_type(UNWRAP (TRY (type__element_type(ti)))));
      RETURN castMIRLoweringReturnValueToEmittable__mir_lowering(TRY (mIRLowering__emit_builtin(&self, :setMemberGet, [target, index_value, Emittable{ Ident: COPY Ident{ name: COPY elem_zig, lowered_node_id: NIL, ownership_consumption: NIL } }])));
    ELSE_IF TRY (type__direct_indexable_collection?(ti)) THEN
      RETURN TRY (mIRLowering__lower_direct_or_builtin_index_get(&self, target, index_value, plan.target_ast, ti));
    ELSE
      RETURN castMIRLoweringExpressionsReturnValueToEmittable( CAST(TRY (mIRLowering__lower_builtin_index_get(&self, target, index_value, ti)) AS MIRLoweringExpressionsReturnValue));
    END
END
PRIVATE FN mIRLowering__lower_direct_or_builtin_index_get(MUTABLE self: MIRLowering, target: Emittable, index_value: Emittable, ast_node: Locatable, ti: Type) RETURNS !Emittable ->
    IF TRY (mIRLowering__direct_index_get(&self, target, index_value, ast_node, ti)) != NIL THEN
    RETURN Emittable{ IndexGet: COPY UNWRAP (TRY (mIRLowering__direct_index_get(&self, target, index_value, ast_node, ti))) };
    ELSE
    RETURN castMIRLoweringExpressionsReturnValueToEmittable( CAST(TRY (mIRLowering__lower_builtin_index_get(&self, target, index_value, ti)) AS MIRLoweringExpressionsReturnValue));
    END
END
PRIVATE FN mIRLowering__lower_builtin_index_get(MUTABLE self: MIRLowering, target: Emittable, index_value: Emittable, ti: Type) RETURNS !MIRLoweringReturnValue ->
    MUTABLE element_type: ?Type = TRY (type__element_type(ti));
    # `INDEX_OPS.dig(ti.dispatch_key, :get, :builtin) || :getAt` -- three
    # optional steps, each of which can be absent.
    MUTABLE builtin: String@symbol = :getAt;
    IF (type__list_collection?(ti) AND (IF element_type EXISTS AS rtoc_elem_ti THEN type__node?(rtoc_elem_ti) ELSE FALSE END)) THEN
      builtin = :getNodeAt;
    ELSE_IF TRY (type__dispatch_key(ti)) EXISTS AS rtoc_dispatch_key THEN
      MUTABLE rtoc_index_ops = {:string_map: {:get: {:zig: "{target}.get({index})", :shard_direct_zig: "{target}.getDirect({shard_idx}, {shard_key})", :return_type: :r_optional_value, :container_borrow: TRUE, :bc: TRUE, :bc_op: :map_get}, :set: {:zig: "try {target}.put({key_alloc}, {val_alloc}, {index}, {value})", :takes_value: TRUE, :allocates: TRUE, :key_alloc: :receiver_storage, :val_alloc: :receiver_storage, :shard_direct_zig: "try {target}.putDirect({shard_idx}, {shard_alloc}, {shard_key}, {value})", :shard_alloc: :heap, :bc: TRUE, :bc_op: :map_set}}, :numeric_map: {:get: {:zig: "CheatLib.numericMapGet({key_zig}, {val_zig}, {target}, {index})", :sharded_zig: "{target}.get({index})", :shard_direct_zig: "{target}.getDirect({shard_idx}, {shard_key})", :return_type: :r_optional_value, :container_borrow: TRUE, :bc: TRUE, :bc_op: :map_get}, :set: {:zig: "try CheatLib.numericMapPut({key_zig}, {val_zig}, {alloc}, &{target}, {index}, {value})", :takes_value: TRUE, :allocates: TRUE, :alloc: :receiver_storage, :sharded_zig: "try {target}.put({alloc}, {alloc}, {index}, {value})", :shard_direct_zig: "try {target}.putDirect({shard_idx}, {shard_alloc}, {shard_key}, {value})", :shard_alloc: :heap, :bc: TRUE, :bc_op: :map_set}}, :array: {:get: {:zig: "CheatLib.getAt({target}, {index})", :return_type: :r_element_of, :container_borrow: TRUE}, :set: {:zig: "CheatLib.setAt({target}, {index}, {value})", :takes_value: TRUE, :val_alloc: :receiver_storage}}, :list: {:get: {:zig: "CheatLib.getAtOpt({target}, {index})", :builtin: :getAtOpt, :return_type: :r_optional_element, :container_borrow: TRUE}, :set: {:zig: "CheatLib.setAt({target}, {index}, {value})", :takes_value: TRUE, :val_alloc: :receiver_storage}}, :pool: {:get: {:zig: "{target}.get({index})", :return_type: :r_optional_element, :container_borrow: TRUE}, :set: {:zig: "try {target}.insert({alloc}, {value})", :takes_value: TRUE, :allocates: TRUE, :alloc: :heap}}, :set_collection: {:get: {:zig: "if ({target}.contains({index})) {index} else null", :return_type: :r_optional_element, :container_borrow: TRUE}, :set: {:zig: "try {target}.insert({alloc}, {value})", :takes_value: TRUE, :allocates: TRUE, :alloc: :heap}}, :string_raw: {:get: {:builtin: :charAt, :return_type: {:type: :String, :sync: :raw}, :container_borrow: TRUE}}, :string_symbol: {:get: {:builtin: :charAt, :return_type: {:type: :String, :sync: :symbol}, :container_borrow: TRUE}}};
      IF rtoc_index_ops[rtoc_dispatch_key] EXISTS AS rtoc_kind_ops THEN
        IF rtoc_kind_ops[:get] EXISTS AS rtoc_get_op THEN
          IF rtoc_get_op[:builtin] EXISTS AS rtoc_builtin THEN
            builtin = symbol(CAST(rtoc_builtin AS String));
          END
        END
      END
    END
    RETURN TRY (mIRLowering__emit_builtin(&self, builtin, [target, index_value]));
END
PRIVATE FN mIRLowering__struct_lit_field_types(MUTABLE self: MIRLowering, MUTABLE node: StructLit) RETURNS !{String}?StructLitFieldType ->
    MUTABLE rtoc_schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult = mIRLowering__mir_schema_lookup(&self);
    MUTABLE schema: ?TypeSchemaLookupResult = rtoc_schema_lookup(symbol(node.name));
    IF schema IS_A UnionSchema@multiowned AS union_schema_multiowned THEN
      MUTABLE union_schema_multiowned_mutable = COPY union_schema_multiowned;
      MUTABLE union_subst: {String@symbol}TypeTypeInput = {};
      MUTABLE union_field_types: {String}?StructLitFieldType = {};
      FOR union_variant IN union_schema_multiowned_mutable.variants.keys() DO
        union_field_types[CAST(union_variant AS String)] = TRY (mIRLowering__substitute_mir_type(self, castSchemasUnionSchemaVariantValueToStructLitFieldType(UNWRAP (union_schema_multiowned_mutable.variants[union_variant])), union_subst));
      END
      RETURN union_field_types;
    ELSE_IF schema IS_A StructSchema@multiowned AS struct_schema_multiowned THEN
      MUTABLE struct_schema_multiowned_mutable = COPY struct_schema_multiowned;
      MUTABLE struct_subst = TRY (mIRLowering__struct_lit_type_subst(self, MIRLoweringSchema{ StructSchemaMultiowned: COPY struct_schema_multiowned_mutable }, node));
      MUTABLE struct_field_types: {String}?StructLitFieldType = {};
      FOR struct_field IN struct_schema_multiowned_mutable.fields.keys() DO
        MUTABLE typed_field: StructField = COPY UNWRAP (struct_schema_multiowned_mutable.fields[struct_field]);
        MUTABLE raw = StructLitFieldType{ TypeMultiowned: COPY typed_field.type };
        struct_field_types[CAST(struct_field AS String)] = TRY (mIRLowering__substitute_mir_type(self, raw, struct_subst));
      END
      RETURN struct_field_types;
    ELSE
      RETURN {};
    END
END
PRIVATE FN mIRLowering__struct_lit_type_subst(self: MIRLowering, schema: MIRLoweringSchema, node: StructLit) RETURNS !{String@symbol}TypeTypeInput ->
    MUTABLE params: []Any = List[];
    IF schema IS_A StructSchema AS struct_schema THEN
      params = struct_schema.type_params;
    ELSE
      params = List[];
    END
    MUTABLE args = (node.type_args OR_ELSE List[]);
    IF !((((params.length() > 0)) AND args.any?())) THEN
      RETURN {};
    END
    MUTABLE out: {String@symbol}TypeTypeInput = {};
    # `params.zip(args).each { |param, arg| ... }` walks the two lists in step
    # and stops at the shorter one; CLEAR has no zip.
    MUTABLE rtoc_pair_i: Int64 = 0;
    WHILE ((rtoc_pair_i < params.length()) AND (rtoc_pair_i < args.length())) DO
      MUTABLE rtoc_param = COPY UNWRAP (params[rtoc_pair_i]);
      out[symbol(rtoc_param)] = COPY UNWRAP (args[rtoc_pair_i]);
      rtoc_pair_i = rtoc_pair_i + 1;
    END
    RETURN out;
END
PRIVATE FN mIRLowering__substitute_mir_type(self: MIRLowering, raw_type: ?StructLitFieldType, subst: {String@symbol}TypeTypeInput) RETURNS !?StructLitFieldType
  EFFECTS REENTRANT ->
    IF (subst.count() == 0) THEN
      RETURN COPY raw_type;
    END
    IF raw_type EXISTS AS raw_type_value THEN
      IF raw_type_value IS_A InlineStructVariant AS inline_struct_variant THEN
        RETURN COPY StructLitFieldType{ InlineStructVariantMultiowned: COPY inline_struct_variant };
      END
      MUTABLE type_input = COPY raw_type_value;
      MUTABLE t = TRY (type__new(castStructLitFieldTypeToTypeConstructionInput(type_input)));
      MUTABLE resolved = type__resolved(t);
      IF subst.contains?(resolved) THEN
        MUTABLE replacement = TRY (type__new(castTypeTypeInputToTypeConstructionInput__mir_lowering(subst[resolved]?)));
        TRY (mIRLowering__copy_type_capabilities(self, t, &replacement));
        RETURN StructLitFieldType{ TypeMultiowned: COPY replacement };
      END
      IF type__projection?(t) THEN
        MUTABLE owner = symbol(UNWRAP (type__projection_owner(t)));
        MUTABLE concrete_input: ?TypeTypeInput = COPY subst[owner];
        IF concrete_input EXISTS AS concrete_input_value THEN
          MUTABLE concrete = TRY (type__new(castTypeTypeInputToTypeConstructionInput__mir_lowering(concrete_input_value)));
          MUTABLE projected_branch_value: ?Type = NIL;
          PARTIAL MATCH type__projection_member(t) START
            :Key ->
            IF type__map?(concrete) THEN
              projected_branch_value = TRY (type__key_type(concrete));
            ELSE
              projected_branch_value = NIL;
            END,
            :MIRLoweringValue ->
            IF type__map?(concrete) THEN
              projected_branch_value = TRY (type__value_type(concrete));
            ELSE
              projected_branch_value = NIL;
            END,
            DEFAULT ->
            projected_branch_value = NIL;
          END
          MUTABLE projected: Type = projected_branch_value?;
          IF projected THEN
            RETURN StructLitFieldType{ TypeMultiowned: COPY projected };
          END
          RETURN StructLitFieldType{ TypeMultiowned: COPY TRY (type__new(TypeConstructionInput{ TypeExpression: COPY typeExpression__of( TypeExpressionKind{ TypeProjectionExpression: TypeProjectionExpression{ owner: COPY type__resolved(concrete), member: COPY symbol(UNWRAP (type__projection_member(t))), protocol: COPY type__projection_protocol( CAST(TypeExpressionKind{ TypeProjectionExpression: CAST(COPY t AS TypeProjectionExpression)} AS Type)) } }) })) };
        ELSE
          RETURN COPY raw_type_value;
        END
      END
      IF type__map?(t) THEN
        MUTABLE wrapper = COPY t.shape.expression;
        MUTABLE expression: MapTypeExpression = COPY CAST(wrapper.kind AS MapTypeExpression);
        MUTABLE new_key: TypeTypeInput = castOptionalStructLitFieldTypeToTypeTypeInput(mIRLowering__substitute_mir_type(self, StructLitFieldType{ TypeMultiowned: COPY TRY (type__key_type(t)) }, subst));
        MUTABLE new_value: TypeTypeInput = castOptionalStructLitFieldTypeToTypeTypeInput(mIRLowering__substitute_mir_type(self, StructLitFieldType{ TypeMultiowned: COPY TRY (type__value_type(t)) }, subst));
        RETURN StructLitFieldType{ TypeMultiowned: COPY TRY (type__new(TypeConstructionInput{ TypeExpression: COPY TypeExpression{ kind: TypeExpressionKind{ MapTypeExpression: COPY MapTypeExpression{ key: COPY ((TRY (type__new(castTypeTypeInputToTypeConstructionInput__mir_lowering(new_key)))).shape).expression, value: COPY ((TRY (type__new(castTypeTypeInputToTypeConstructionInput__mir_lowering(new_value)))).shape).expression, key_implicit: expression.key_implicit, legacy_separator: COPY expression.legacy_separator } }, capabilities: COPY wrapper.capabilities } })) };
      END
      IF type__generic_instance?(t) THEN
        MUTABLE new_args = (TRY (type__generic_args(t))) |> SELECT castOptionalStructLitFieldTypeToTypeTypeInput(mIRLowering__substitute_mir_type(self, StructLitFieldType{ TypeMultiowned: COPY _ }, subst));
        MUTABLE replacement = TRY (type__generic_instance_of(type__generic_base(t), new_args));
        TRY (mIRLowering__copy_type_capabilities(self, t, &replacement));
        RETURN StructLitFieldType{ TypeMultiowned: COPY replacement };
      END
      IF type__array?(t) THEN
        MUTABLE element_type = UNWRAP (TRY (type__element_type(t)));
        MUTABLE new_element: TypeTypeInput = castOptionalStructLitFieldTypeToTypeTypeInput(mIRLowering__substitute_mir_type(self, StructLitFieldType{ TypeMultiowned: COPY element_type }, subst));
        IF (TRY (type__surface_name(TypeTypeInput{ Type: COPY element_type })) == TRY (type__surface_name(new_element))) THEN
          RETURN COPY raw_type_value;
        END
        MUTABLE replacement = TRY (type__array_of(new_element, type__capacity(t)));
        TRY (mIRLowering__copy_type_capabilities(self, t, &replacement));
        RETURN StructLitFieldType{ TypeMultiowned: COPY replacement };
      END
      IF type__error_union?(t) THEN
        MUTABLE payload_type = UNWRAP (TRY (type__payload_type(t)));
        MUTABLE new_payload: TypeTypeInput = castOptionalStructLitFieldTypeToTypeTypeInput(mIRLowering__substitute_mir_type(self, StructLitFieldType{ TypeMultiowned: COPY payload_type }, subst));
        IF (TRY (type__surface_name(TypeTypeInput{ Type: COPY payload_type })) == TRY (type__surface_name(new_payload))) THEN
          RETURN COPY raw_type_value;
        END
        MUTABLE replacement = TRY (type__error_union_of(new_payload));
        TRY (mIRLowering__copy_type_capabilities(self, t, &replacement));
        RETURN StructLitFieldType{ TypeMultiowned: COPY replacement };
      END
      IF type__optional?(t) THEN
        MUTABLE wrapped_type = UNWRAP (TRY (type__wrapped_type(t)));
        MUTABLE new_wrapped: TypeTypeInput = castOptionalStructLitFieldTypeToTypeTypeInput(mIRLowering__substitute_mir_type(self, StructLitFieldType{ TypeMultiowned: COPY wrapped_type }, subst));
        IF (TRY (type__surface_name(TypeTypeInput{ Type: COPY wrapped_type })) == TRY (type__surface_name(new_wrapped))) THEN
          RETURN COPY raw_type_value;
        END
        MUTABLE replacement = TRY (type__optional_of(new_wrapped));
        TRY (mIRLowering__copy_type_capabilities(self, t, &replacement));
        RETURN StructLitFieldType{ TypeMultiowned: COPY replacement };
      END
      IF type__tense?(t) THEN
        MUTABLE tense_type = TRY (type__tense_type(t));
        MUTABLE new_tense_type: TypeTypeInput = castOptionalStructLitFieldTypeToTypeTypeInput(mIRLowering__substitute_mir_type(self, StructLitFieldType{ TypeMultiowned: COPY tense_type }, subst));
        IF (TRY (type__surface_name(TypeTypeInput{ Type: COPY tense_type })) == TRY (type__surface_name(new_tense_type))) THEN
          RETURN COPY raw_type_value;
        END
        MUTABLE replacement = TRY (type__tense_of(new_tense_type));
        TRY (mIRLowering__copy_type_capabilities(self, t, &replacement));
        RETURN StructLitFieldType{ TypeMultiowned: COPY replacement };
      END
      RETURN COPY raw_type_value;
    ELSE
      RETURN COPY raw_type;
    END
END
PRIVATE FN mIRLowering__copy_type_capabilities(self: MIRLowering, source: Type, MUTABLE target: Type) RETURNS !Void ->
    TRY (type__merge_capabilities_from_mut(&target, source));
END
PRIVATE FN mIRLowering__struct_field_wants_slice?(self: MIRLowering, ft: ?Type, k: K, node: StructLit) RETURNS !Bool ->
    IF node.borrowed_field_names EXISTS AS borrowed_field_names_value THEN
      IF borrowed_field_names_value.contains?(CAST(k AS String)) THEN
      RETURN TRUE;
    END
    END
    RETURN TRY (mIRLowering__aggregate_field_wants_dynamic_slice?(self, ft));
END
PRIVATE FN mIRLowering__aggregate_field_wants_dynamic_slice?(self: MIRLowering, ft: ?Type) RETURNS !Bool ->
    IF ft EXISTS AS ft_value THEN
      RETURN (((type__array?(ft_value) AND type__dynamic?(ft_value)) AND !(type__collection?(ft_value))) AND !(TRY (type__string?(ft_value))));
    ELSE
      RETURN FALSE;
    END
END
PRIVATE FN mIRLowering__aggregate_dynamic_slice_field_value(MUTABLE self: MIRLowering, MUTABLE val: Emittable, ft: ?Type, borrowed_field: Bool, sink_alloc: String@symbol, MUTABLE ast_node: ?Locatable = NIL) RETURNS !Emittable ->
    IF !(TRY (mIRLowering__aggregate_field_wants_dynamic_slice?(self, ft))) THEN
      RETURN COPY val;
    END
    IF borrowed_field THEN
      RETURN Emittable{ ItemsAccess: COPY ItemsAccess{ expr: COPY val, safe: TRUE, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    MUTABLE source_branch_value: ?Emittable = NIL;
    IF (TRY (mIRLowering__mir_produces_owned_result?(&self, val)) AND !(val IS_A Ident)) THEN
      source_branch_value = TRY (mIRLowering__hoist_alloc(&self, &val, &ast_node, TRUE));
    ELSE
      source_branch_value = COPY val;
    END
    MUTABLE source: Emittable = source_branch_value?;
    RETURN Emittable{ OwnedSlice: COPY castEmittableToOwnedSlice(TRY (mIRLowering__with_ownership_consumption(&self, Emittable{ OwnedSlice: COPY OwnedSlice{ expr: COPY source, alloc: COPY sink_alloc, lowered_node_id: NIL, ownership_consumption: NIL } }, TRY (mIRLowering__mir_ident_names(self, source)), "MIR::OwnedSlice", :owned_sink, sink_alloc))) };
END
PRIVATE FN mIRLowering__lower_struct_lit(MUTABLE self: MIRLowering, MUTABLE node: StructLit) RETURNS !Emittable ->
    MUTABLE hoisted: []Emittable = List[];
    MUTABLE field_types = TRY (mIRLowering__struct_lit_field_types(&self, &node));
    MUTABLE coerced_destination: ?Type = locatable__coerced_type_info(Locatable{ StructLit: COPY node });
    MUTABLE struct_alloc = IF (IF coerced_destination != NIL THEN
      TRY (type__node_reference?(coerced_destination))
    ELSE
      NIL
    END) THEN
      :heap
    ELSE
      TRY (mIRLowering__alloc_for_node(&self, Locatable{ StructLit: COPY node }))
    END;
    MUTABLE literal_fields = TRY (mIRLowering__struct_lit_fields_with_callsite_defaults(&self, node));
    # The element expression mutates `hoisted`, which a pipeline block only
    # borrows; the loop is what lets the append land.
    MUTABLE fields: []StructInitField = List[];
    FOR rtoc_field_key IN literal_fields.keys() DO
    MUTABLE ft: ?StructLitFieldType = COPY field_types[rtoc_field_key];
    MUTABLE field_type_input_branch_value: ?TypeTypeInput = NIL;
      IF ft? IS_A InlineStructVariant AS inline_struct_variant THEN
        field_type_input_branch_value = NIL;
      ELSE
        field_type_input_branch_value = castOptionalStructLitFieldTypeToOptionalTypeTypeInput(ft);
      END
    MUTABLE field_type_input: ?TypeTypeInput = field_type_input_branch_value;
    MUTABLE borrowed_field: Bool = ((node.borrowed_field_names != NIL) AND (((node.borrowed_field_names)?).contains?(rtoc_field_key) == TRUE));
    MUTABLE field_node = mIRLowering__struct_literal_field_node(self, borrowed_field, COPY UNWRAP (literal_fields[rtoc_field_key]));
    MUTABLE field_sink_alloc = TRY (mIRLowering__aggregate_field_sink_alloc(&self, field_type_input, field_node, struct_alloc));
    TRY (mIRLowering__move_mark_field_mut(&self, field_node));
    # `ft && (ft.is_a?(Type) ? ft : Type.new(ft))` -- the nested ternary only
    # runs when the field has a declared type, and it yields a Type.
    MUTABLE expected_ft: ?Type = NIL;
    IF field_type_input EXISTS AS rtoc_field_ti THEN
