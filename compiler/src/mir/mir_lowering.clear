    END
    IF (plan.copy_strategy == :forbidden) THEN
        copy_forbidden = TRUE;
    ELSE_IF (plan.copy_strategy != :bit_copy) THEN
        &clone_fields.append(COPY rtoc_key);
        MUTABLE field_source = "self.${mIRLowering__zig_safe_name(rtoc_self_view, rtoc_key)}";
        MUTABLE tmp_name = "__clone_${rtoc_key}";
        &clone_statements.append(Stmt{ Emittable: COPY CAST(Let{ name: COPY tmp_name, init: Emittable{ Lit: COPY Lit{ value: "try CheatLib.dupeValue(@TypeOf(${field_source}), ${field_source}, alloc)", lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } AS Emittable) });
        &clone_statements.append(Stmt{ Emittable: COPY CAST(ExprStmt{ expr: Emittable{ Lit: COPY Lit{ value: "errdefer CheatLib.cleanup(@TypeOf(${tmp_name}), alloc, &${tmp_name})", lowered_node_id: NIL, ownership_consumption: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) });
        &clone_statements.append(Stmt{ Emittable: COPY CAST(Set{ target: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "result", lowered_node_id: NIL, ownership_consumption: NIL } }, field: COPY rtoc_key, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Ident: COPY Ident{ name: tmp_name, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) });
    END
