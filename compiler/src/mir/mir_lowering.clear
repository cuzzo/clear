        MUTABLE raw_last_mir = mIRLowering__with_decl_alloc(rtoc_self_view, result_alloc, %() USE(last_step_value_mutable, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_196 = TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(last_step_value_mutable.expr)));
    rtoc_lambda_result_196
        });
        MUTABLE last_mir_branch_value: ?Emittable = NIL;
        IF raw_last_mir IS_A Emittable THEN
          last_mir_branch_value = raw_last_mir;
        ELSE
          last_mir_branch_value = NIL;
        END
        MUTABLE last_mir: ?Emittable = last_mir_branch_value;
        MUTABLE result_destination_type_branch_value: ?Type = NIL;
