->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rtoc_mutable_receiver_126 = mIRLowering__lowering_schemas(rtoc_self_view);
    mIRLoweringSchemas__register_enum(&rtoc_mutable_receiver_126, node.name, node.variants);
    RETURN MIREnumDef{ name: node.name, variants: node.variants |> SELECT _.toString(), visibility: node.visibility, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
}
END
PRIVATE FN mIRLowering__lower_field_default(MUTABLE self: MIRLowering, node: Locatable) RETURNS !Emittable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node IS_A DefaultLit AS default_lit THEN
