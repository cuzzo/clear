PRIVATE FN mIRLowering__ast_expr_produces_heap?(MUTABLE self: MIRLowering, expr: Locatable) RETURNS !Bool ->
    MUTABLE node = COPY expr;
    IF node IS_A MoveNode AS move_node THEN
