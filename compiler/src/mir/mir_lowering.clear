PRIVATE FN mIRLowering__exclusive_lock_expr(self: MIRLowering, context: WithCapabilityBindingContext) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE is_arc = (symbolEntry__rc_storage?(context.var_storage) OR (IF context.resolved_type != NIL THEN
      TRY (type__any_rc?(context.resolved_type))
    ELSE
      NIL
    END));
    MUTABLE is_param = mIRLowering__with_cap_is_param?(rtoc_self_view, context.var_node);
    MUTABLE source = mIRLowering__with_capability_source_mir(rtoc_self_view, context.var_node);
    IF (is_param AND !(is_arc)) THEN
      RETURN Emittable{ CapabilityLockTarget: COPY CapabilityLockTarget{ source: COPY source, arc_wrapped: FALSE, comptime_arc_unwrap: TRUE, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    RETURN Emittable{ CapabilityLockTarget: COPY CapabilityLockTarget{ source: COPY source, arc_wrapped: is_arc, comptime_arc_unwrap: FALSE, lowered_node_id: NIL, ownership_consumption: NIL } };
}
