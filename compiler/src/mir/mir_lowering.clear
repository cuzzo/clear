PRIVATE FN mIRLowering__lower_struct_field_default(MUTABLE self: MIRLowering, field: StructField) RETURNS !?Emittable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF mIRLowering__callsite_struct_field_default?(rtoc_self_view, field) THEN
      RETURN NIL;
    END
    IF (((type__optional?(field.type) AND TRY (type__node_reference?(field.type))) AND ((field.default != NIL) AND (field.default IS_A Literal))) AND FALSE) THEN
      RETURN Emittable{ StructInit: COPY StructInit{ zig_type: TRY (type__zig_type(field.type, FALSE, TRUE)), fields: ( { MUTABLE rtoc_empty_list_127: []Any = List[]; rtoc_empty_list_127 } ), lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF field.default EXISTS AS default_value THEN
      MUTABLE default_value_mutable = COPY default_value;
      RETURN TRY (mIRLowering__lower_field_default(&rtoc_self_view, default_value_mutable));
    END
    MUTABLE type = COPY field.type;
    IF (type__optional?(type) AND TRY (type__node_reference?(type))) THEN
      RETURN Emittable{ StructInit: COPY StructInit{ zig_type: TRY (type__zig_type(type, FALSE, TRUE)), fields: ( { MUTABLE rtoc_empty_list_128: []Any = List[]; rtoc_empty_list_128 } ), lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF (type__list_collection?(type) AND !(TRY (type__any_rc?(type)))) THEN
      RETURN Emittable{ ContainerInit: COPY ContainerInit{ zig_type: COPY TRY (type__zig_type(type, FALSE, TRUE)), strategy: :array_list_empty, alloc: NIL, capacity: NIL, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    RETURN NIL;
}
END
PRIVATE FN mIRLowering__callsite_struct_field_default?(self: MIRLowering, field: StructField) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (((field.default != NIL) AND (field.default IS_A HashLit)) OR ((field.default != NIL) AND (field.default IS_A ListLit)));
}
END
PRIVATE FN mIRLowering__lower_struct_def(MUTABLE self: MIRLowering, node: StructDef) RETURNS !Emittable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_mutable_receiver_130 = mIRLowering__lowering_schemas(rtoc_self_view);
    mIRLoweringSchemas__register_struct(&rtoc_mutable_receiver_130, MIRLoweringSchemasSchemaName{ StringValue: COPY node.name }, TRY (structSchema__new(node.field_decls, node.type_params |> SELECT symbol(_), ( { MUTABLE rtoc_empty_list_129: []GenericParamDecl = List[]; rtoc_empty_list_129 } ), {}, {})));
    IF node.type_params |> ANY _ THEN
      MUTABLE comptime_params = node.type_params |> SELECT "comptime ${_}: type";
      MUTABLE fields_mir = node.field_decls.keys() |> SELECT {
    MUTABLE zig_t = mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ Type: COPY structField__type((COPY UNWRAP (node.field_decls[_]))) }, FALSE, TRUE);
    MUTABLE default_mir: ?Emittable = TRY (mIRLowering__lower_struct_field_default(&rtoc_self_view, CAST(COPY UNWRAP (node.field_decls[_]) AS StructField)));
    FieldDef{ name: COPY _, zig_type: zig_t, default: default_mir, lowered_node_id: NIL, ownership_consumption: NIL, boxed_capture: NIL }
      };
      MUTABLE metadata = [PubConst{ name: "__clear_nominal_${mIRLowering__zig_safe_name(rtoc_self_view, node.name)}", value: "true", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }, PubConst{ name: "__clear_type_args", value: ".{ ${node.type_params.join(", ")} }", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }];
      ruby_array_concat_PubConst(metadata, CAST(TRY (mIRLowering__lower_struct_lifecycle_methods(rtoc_self_view, node)) AS []PubConst));
      MUTABLE inner_struct = MIRStructDef{ name: NIL, fields: fields_mir, methods: metadata, visibility: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
      MUTABLE body = [ReturnStmt{ value: Emittable{ MIRStructDef: COPY inner_struct }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }];
      RETURN Emittable{ FnDef: COPY FnDef{ name: COPY node.name, params: ( { MUTABLE rtoc_empty_list_131: []MIRParam = List[]; rtoc_empty_list_131 } ), ret_type: "type", body: Body{ ArrayValue: body |> SELECT SegmentStmt{ Emittable: Emittable{ ReturnStmt: COPY _ } } }, visibility: NIL, can_fail: FALSE, comptime_params: comptime_params, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    ELSE
      MUTABLE fields = node.field_decls.keys() |> SELECT {
    MUTABLE zig_t = mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ Type: COPY structField__type((COPY UNWRAP (node.field_decls[_]))) }, FALSE, TRUE);
    MUTABLE default_mir: ?Emittable = TRY (mIRLowering__lower_struct_field_default(&rtoc_self_view, CAST(COPY UNWRAP (node.field_decls[_]) AS StructField)));
    FieldDef{ name: COPY _, zig_type: zig_t, default: default_mir, lowered_node_id: NIL, ownership_consumption: NIL, boxed_capture: NIL }
      };
      MUTABLE lifecycle_methods = TRY (mIRLowering__lower_struct_lifecycle_methods(rtoc_self_view, node));
      MUTABLE methods_branch_value: ?[]FnDef = NIL;
      IF (lifecycle_methods.length() == 0) THEN
        methods_branch_value = NIL;
      ELSE
        methods_branch_value = lifecycle_methods;
      END
      MUTABLE methods: ?[]FnDef = methods_branch_value;
      RETURN Emittable{ MIRStructDef: COPY MIRStructDef{ name: COPY node.name, fields: fields, methods: methods, visibility: node.visibility, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
}
END
PRIVATE FN mIRLowering__lower_struct_lifecycle_methods(self: MIRLowering, node: StructDef) RETURNS ![]FnDef
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE self_ref = Ident{ name: "self", lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE alloc_ref = Ident{ name: "alloc", lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE drop_statements: []Stmt = ( { MUTABLE rtoc_empty_list_132: []Stmt = List[]; rtoc_empty_list_132 } );
    MUTABLE clone_statements: []Stmt = [Stmt{ Emittable: COPY CAST(Let{ name: COPY "result", init: Emittable{ Ident: COPY self_ref }, mutable: TRUE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } AS Emittable) }];
    MUTABLE clone_fields: []String = ( { MUTABLE rtoc_empty_list_133: []String = List[]; rtoc_empty_list_133 } );
    MUTABLE copy_forbidden: Bool = FALSE;
    FOR rtoc_key IN node.field_decls.keys() DO
    MUTABLE field: StructField@multiowned = COPY UNWRAP (node.field_decls[rtoc_key]);
    IF structField__borrowed(field) THEN
      CONTINUE;
    END
    MUTABLE field_type = structField__type(field);
    MUTABLE plan = COPY UNWRAP (mIRLowering__lifecycle_registry(rtoc_self_view)[field_type]);
    MUTABLE field_ref = FieldGet{ object: Emittable{ Ident: COPY self_ref }, field: COPY rtoc_key, lowered_node_id: NIL, ownership_consumption: NIL };
    IF (plan.drop_strategy == :resource_close) THEN
        &drop_statements.append(Stmt{ Emittable: COPY CAST(ResourceClose{ target: Emittable{ FieldGet: COPY field_ref }, close_plan: COPY UNWRAP (plan.resource_close_plan), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) });
    ELSE_IF type__optional?(field_type) THEN
        MUTABLE wrapped = UNWRAP (TRY (type__wrapped_type(field_type)));
        MUTABLE wrapped_plan = COPY UNWRAP (mIRLowering__lifecycle_registry(rtoc_self_view)[wrapped]);
        IF (wrapped_plan.drop_strategy == :resource_close) THEN
          MUTABLE capture = "__close_${mIRLowering__zig_safe_name(rtoc_self_view, rtoc_key)}";
          &drop_statements.append(Stmt{ Emittable: COPY CAST(IfBindStmt{ bindings: COPY [{:expr: field_ref, :capture: capture, :pointer_capture: TRUE}], then_body: [ResourceClose{ target: Emittable{ Deref: COPY Deref{ expr: Emittable{ Ident: COPY Ident{ name: capture, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, close_plan: COPY UNWRAP (wrapped_plan.resource_close_plan), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) });
