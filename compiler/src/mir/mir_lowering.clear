    ELSE_IF (entry.kind == :uniform) THEN
      RETURN CAST([Stmt{ Emittable: COPY CAST(ExprStmt{ expr: castMIRLoweringReturnValueToEmittable(COPY TRY (mIRLowering__emit_builtin(rtoc_self_view, :cleanup, [Emittable{ Ident: COPY Ident{ name: COPY UNWRAP (entry.zig_type), lowered_node_id: NIL, ownership_consumption: NIL } }, castExprToEmittable(alloc_ref), Emittable{ AddressOf: COPY AddressOf{ expr: Emittable{ FieldGet: COPY self_field }, lowered_node_id: NIL, ownership_consumption: NIL } }]))), discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) }] AS []Stmt);
    ELSE_IF (entry.kind == :array) THEN
      MUTABLE elem_zig = Ident{ name: COPY UNWRAP (entry.elem_zig_type), lowered_node_id: NIL, ownership_consumption: NIL };
      MUTABLE loop_body = [ExprStmt{ expr: castMIRLoweringReturnValueToEmittable(COPY TRY (mIRLowering__emit_builtin(rtoc_self_view, :cleanup, [Emittable{ Ident: COPY elem_zig }, castExprToEmittable(alloc_ref), Emittable{ Ident: COPY Ident{ name: "__e", lowered_node_id: NIL, ownership_consumption: NIL } }]))), discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }];
      MUTABLE for_loop = ForStmt{ iter: Emittable{ FieldGet: COPY self_field }, capture: "*__e", body: Body{ ArrayValue: loop_body |> SELECT SegmentStmt{ Emittable: Emittable{ ExprStmt: COPY _ } } }, index_capture: NIL, mark_per_iter: FALSE, tight: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
      MUTABLE cleanup_guard = IfStmt{ cond: Emittable{ Comptime: COPY Comptime{ expr: castMIRLoweringReturnValueToEmittable(COPY TRY (mIRLowering__emit_builtin(rtoc_self_view, :needsCleanup, [Emittable{ Ident: COPY elem_zig }]))), lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: [for_loop], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL };
      MUTABLE len_guard = IfStmt{ cond: Emittable{ MIRBinOp: COPY MIRBinOp{ op: ">", left: Emittable{ ListLength: COPY ListLength{ expr: Emittable{ FieldGet: COPY self_field }, lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: [ExprStmt{ expr: Emittable{ FreeSlice: COPY FreeSlice{ slice: Emittable{ FieldGet: COPY self_field }, alloc: castExprToAlloc(COPY alloc_ref), lowered_node_id: NIL, ownership_consumption: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL };
      RETURN CAST([Stmt{ Emittable: Emittable{ IfStmt: COPY cleanup_guard } }, Stmt{ Emittable: Emittable{ IfStmt: COPY len_guard } }] AS []Stmt);
