END
PRIVATE FN mIRLowering__lower_runtime_is_a_if(MUTABLE self: MIRLowering, node: IfStatement, condition: IsA) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE else_body = NIL;
    MUTABLE then_body = NIL;
    MUTABLE subject, subject_pending = mIRLowering__lower_head(rtoc_self_view, %() USE(condition, rtoc_self_view) -> mIRLowering__lower_control_condition(rtoc_self_view, condition.left));
    MUTABLE variant = condition.runtime_variant_name;
    MUTABLE cond = mIRLowering__union_tag_condition(rtoc_self_view, CAST(subject AS Emittable), variant);
    MUTABLE payload_bindings = mIRLowering__runtime_is_a_payload_bindings(rtoc_self_view, condition, CAST(subject AS Emittable), variant);
    IF node.expr_mode THEN
      MUTABLE label = "__if_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_713 = mIRLowering__lowering_counters(rtoc_self_view);
      mIRLoweringCounters__next_block_expr_id(&rtoc_mutable_receiver_713) }}";
      then_body = (payload_bindings + TRY (mIRLowering__lower_body_with_break(&rtoc_self_view, node.then_branch, label)));
      else_body = TRY (mIRLowering__lower_body_with_break(&rtoc_self_view, (node.else_branch OR_ELSE List[]), label));
      MUTABLE block = MIRBlockExpr{ label: label, body: Body{ ArrayValue: [IfStmt{ cond: Emittable{ MIRBinOp: COPY cond }, then_body: then_body, else_body: else_body, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL }] |> SELECT SegmentStmt{ Emittable: Emittable{ IfStmt: COPY _ } } }, lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
      RETURN mIRLowering__with_pending(rtoc_self_view, subject_pending, Emittable{ MIRBlockExpr: COPY block });
    END
    then_body = (payload_bindings + TRY (mIRLowering__lower_body(&rtoc_self_view, node.then_branch)));
    IF (((node.else_branch != NIL) AND !(((node.else_branch)?).empty?()))) THEN
      else_body = TRY (mIRLowering__lower_body(&rtoc_self_view, node.else_branch));
    ELSE
      else_body = NIL;
    END
    RETURN mIRLowering__with_pending(rtoc_self_view, subject_pending, Emittable{ IfStmt: COPY IfStmt{ cond: Emittable{ MIRBinOp: COPY cond }, then_body: then_body, else_body: else_body, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL } });
}
END
PRIVATE FN mIRLowering__payload_binding_name(self: MIRLowering, binding: String, decl: ?Locatable, line: ?Int64) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE safe = mIRLowering__zig_safe_name(rtoc_self_view, binding);
    IF (TRY (functionState__alloc_marked_names(mIRLowering__function_state(rtoc_self_view)))).contains?(safe) THEN
      MUTABLE suffix: String = "";
      IF line EXISTS AS line_value THEN
        suffix = "_L${mIRLowering__function_relative_line(rtoc_self_view, line_value).toString()}";
      ELSE
        suffix = "_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_714 = mIRLowering__lowering_counters(rtoc_self_view);
        mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_714) }}";
      END
      safe = mIRLowering__zig_safe_name(rtoc_self_view, "${binding}${suffix}");
    END
    MUTABLE rtoc_index_receiver_715 = TRY (functionState__alloc_marked_names(mIRLowering__function_state(rtoc_self_view)));
    rtoc_index_receiver_715[safe] = TRUE;
    IF decl THEN
      MUTABLE rtoc_index_receiver_716 = TRY (functionState__decl_zig_names(mIRLowering__function_state(rtoc_self_view)));
      rtoc_index_receiver_716[decl.object_id()] = safe;
    END
    RETURN safe;
}
END
PRIVATE FN mIRLowering__runtime_is_a_payload_bindings(self: MIRLowering, condition: IsA, subject: Emittable, variant: String) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE binding = condition.binding;
    IF !(binding) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_717: []Emittable = List[]; rtoc_empty_list_717 } ) AS []Emittable);
    END
    MUTABLE payload: Emittable = Emittable{ UnionPayloadGet: COPY UnionPayloadGet{ subject: COPY subject, variant: COPY variant, lowered_node_id: NIL, ownership_consumption: NIL } };
    IF condition.runtime_indirect_payload_as THEN
      payload = Emittable{ Deref: COPY Deref{ expr: COPY payload, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    MUTABLE is_mutable = (condition.left IS_A Identifier AND (condition.left.was_moved() == TRUE));
    MUTABLE safe_binding = mIRLowering__payload_binding_name(rtoc_self_view, CAST(binding AS String), condition, condition.line());
    RETURN CAST([Emittable{ Let: COPY Let{ name: COPY safe_binding, init: COPY payload, mutable: is_mutable, annotation: NIL, suppression: "_ = &${safe_binding};", alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }] AS []Emittable);
}
END
PRIVATE FN mIRLowering__lower_if_bind(MUTABLE self: MIRLowering, node: IfBind) RETURNS !IfBindStmt
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE capture_markers: []Stmt = ( { MUTABLE rtoc_empty_list_718: []Stmt = List[]; rtoc_empty_list_718 } );
    MUTABLE mir_bindings = node.bindings |> SELECT { MUTABLE rtoc_mutable_block_param_720 = COPY _;
    {
    MUTABLE expr, pending = mIRLowering__lower_head(rtoc_self_view, %() USE(rtoc_mutable_block_param_720, MUTABLE rtoc_self_view) -> {
      IF mIRLowering__plain_map_pointer_bind?(rtoc_self_view, &rtoc_mutable_block_param_720.expr) THEN
        MUTABLE index: GetIndex = COPY castLocatableToGetIndex(rtoc_mutable_block_param_720.expr);
        MUTABLE expr_target = TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(index.target)));
        RETURN MIRMethodCall{ receiver: COPY expr_target, method: "getPtr", args: [CAST(TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(index.index))) AS Any)], try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(1)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
      ELSE_IF mIRLowering__mutable_struct_list_bind?(rtoc_self_view, &rtoc_mutable_block_param_720.expr) THEN
        index = COPY castLocatableToGetIndex(rtoc_mutable_block_param_720.expr);
        MUTABLE target = TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(index.target)));
        IF !(mIRLowering__collection_param_receiver?(rtoc_self_view, index.target)) THEN
            target = AddressOf{ expr: COPY target, lowered_node_id: NIL, ownership_consumption: NIL };
        END
        RETURN TRY (mIRLowering__emit_builtin(rtoc_self_view, :getAtPtrOpt, [Emittable{ AddressOf: COPY target }, TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(index.index)))]));
      ELSE
        RETURN mIRLowering__lower_control_condition(rtoc_self_view, rtoc_mutable_block_param_720.expr, TRUE);
      END
      NIL
    });
    MUTABLE capture_cleanup: ?CleanupEntry@multiowned = mIRLowering__bind_capture_cleanup(rtoc_self_view, rtoc_mutable_block_param_720.expr);
    IF capture_cleanup EXISTS AS capture_cleanup_value THEN
        MUTABLE capture_name = COPY rtoc_mutable_block_param_720.name;
        MUTABLE capture_type = mIRLowering__capture_expr_payload_type(rtoc_self_view, rtoc_mutable_block_param_720.expr);
        &capture_markers.append(Stmt{ Emittable: COPY CAST(AllocMark{ name: COPY capture_name, alloc: :heap, type_info: CAST(COPY capture_type AS Type), scope: :function, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) });
        &capture_markers.append(Stmt{ Emittable: COPY CAST(Cleanup{ name: capture_name, cleanup_entry: capture_cleanup_value, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) });
    END
    {:expr: { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_719: ?Emittable = NIL;
      IF (rtoc_mutable_block_param_720.predicate == :is_ok) THEN
        rtoc_ternary_value_719 = mIRLowering__strip_try(rtoc_self_view, mIRLowering__loop_condition_expr(rtoc_self_view, expr, pending));
      ELSE
        rtoc_ternary_value_719 = mIRLowering__loop_condition_expr(rtoc_self_view, expr, pending);
      END
      rtoc_ternary_value_719? }, :capture: rtoc_mutable_block_param_720.name, :node_ref: TRY (type__node_reference?((TRY (type__from_node_mut(rtoc_mutable_block_param_720.expr))))), :owns_capture: aST__capture_expr_owns_result?(rtoc_mutable_block_param_720.expr), :predicate: rtoc_mutable_block_param_720.predicate}
    } };
    MUTABLE lowered_then = mIRLowering__with_if_bind_alias_maps(rtoc_self_view, node, %() USE(node, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_721 = TRY (mIRLowering__lower_body(&rtoc_self_view, node.then_branch));
    rtoc_lambda_result_721
    });
    MUTABLE existing_capture_names = (lowered_then |> SELECT:? (  IF _ IS_A AllocMark THEN
      CAST(_.name() AS String)
    ELSE
      NIL
    END) |> WHERE _ != NIL) |> DISTINCT _;
    capture_markers = capture_markers |> WHERE !((respondsTo?(_, "name") AND existing_capture_names.contains?(CAST(_.name() AS String))));
    MUTABLE then_body = (capture_markers + lowered_then);
    MUTABLE else_body_branch_value: ?[]Emittable = NIL;
    IF ((node.else_branch AND !(node.else_branch.empty?()))) THEN
      else_body_branch_value = TRY (mIRLowering__lower_body(&rtoc_self_view, node.else_branch));
    ELSE
      else_body_branch_value = NIL;
    END
    MUTABLE else_body: ?[]Emittable = else_body_branch_value;
    RETURN IfBindStmt{ bindings: COPY mir_bindings, then_body: COPY then_body, else_body: else_body, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
}
END
PRIVATE FN mIRLowering__mutable_struct_list_bind?(self: MIRLowering, MUTABLE expr: Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF expr IS_A GetIndex AS get_index THEN
      MUTABLE get_index_mutable = COPY get_index;
      MUTABLE receiver = &get_index_mutable.target.full_type_mut("IF list binding receiver");
      MUTABLE result = &get_index_mutable.full_type_mut("IF list binding result");
      MUTABLE inner_branch_value: ?Type = NIL;
      IF type__optional?(result) THEN
        inner_branch_value = UNWRAP (TRY (type__wrapped_type(result)));
      ELSE
        inner_branch_value = result;
      END
      MUTABLE inner: Type = inner_branch_value?;
      RETURN (((((((receiver.list_collection?() AND TRY (type__struct?(inner))) AND !(type__collection?(inner))) AND !(TRY (type__node_reference?(inner)))) AND !(type__link?(inner))) AND !(TRY (type__any_rc?(inner))))) == TRUE);
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN mIRLowering__plain_map_pointer_bind?(self: MIRLowering, MUTABLE expr: Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF expr IS_A GetIndex AS get_index THEN
      MUTABLE get_index_mutable = COPY get_index;
      MUTABLE receiver = &get_index_mutable.target.full_type_mut("IF map binding receiver");
      IF !((((type__map?(receiver) AND !(type__sharded?(receiver))) AND !(TRY (type__any_rc?(receiver)))) AND !(type__any_sync?(receiver)))) THEN
        RETURN FALSE;
      END
      MUTABLE result = &get_index_mutable.full_type_mut("IF map binding result");
      MUTABLE inner_branch_value: ?Type = NIL;
      IF type__optional?(result) THEN
        inner_branch_value = UNWRAP (TRY (type__wrapped_type(result)));
      ELSE
        inner_branch_value = result;
      END
      MUTABLE inner: Type = inner_branch_value?;
      MUTABLE union_name = IF type__generic_instance?(inner) THEN
        type__generic_base(inner)
      ELSE
        type__resolved(inner)
      END;
      IF (TRY (mIRLowering__union_schemas(rtoc_self_view))).contains?(union_name) THEN
        RETURN TRUE;
      END
      IF ((type__collection?(inner) AND !(TRY (type__node_reference?(inner)))) AND !(TRY (type__any_rc?(inner)))) THEN
        RETURN TRUE;
      END
