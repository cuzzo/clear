    MUTABLE keep = OwnedSinkPlan{ action: :keep, target_alloc: COPY sink_alloc, zig_type: NIL, copy_mode: NIL, rc_func: NIL, source_slice_view: FALSE };
    IF TRY (type__node_reference?(ti)) THEN
      RETURN keep;
    END
    MUTABLE source = TRY (mIRLowering__owned_sink_source_fact(rtoc_self_view, value, ast_node, sink_alloc, ti));
    IF (lifecycle.copy_strategy == :bit_copy) THEN
      RETURN keep;
    END
