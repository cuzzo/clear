PRIVATE FN mIRLowering__lower_link(MUTABLE self: MIRLowering, node: LinkNode) RETURNS !RcDowngrade
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE inner = TRY (mIRLowering__lower(&rtoc_self_view, node.value));
    MUTABLE ti = &node.value.full_type_mut();
    MUTABLE base = mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ StringValue: COPY CAST(ti.resolved() AS String) });
    MUTABLE func: String = "";
    IF type__shared?(ti) THEN
      func = "arcDowngrade";
    ELSE
      func = "rcDowngrade";
    END
    RETURN RcDowngrade{ source: inner, zig_base: base, func: func, lowered_node_id: NIL, ownership_consumption: NIL };
}
END
PRIVATE FN mIRLowering__lower_resolve(MUTABLE self: MIRLowering, node: ResolveNode) RETURNS !WeakUpgrade
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE inner = TRY (mIRLowering__lower(&rtoc_self_view, node.value));
    MUTABLE ti = &node.value.full_type_mut();
    MUTABLE base = mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ StringValue: COPY CAST(ti.resolved() AS String) });
    MUTABLE source = (ti.link_source() OR :multiowned);
    MUTABLE func: String = "";
    IF (source == :shared) THEN
      func = "weakArcUpgrade";
    ELSE
      func = "weakRcUpgrade";
    END
    RETURN WeakUpgrade{ source: inner, zig_base: base, func: func, lowered_node_id: NIL, ownership_consumption: NIL };
}
END
PRIVATE FN mIRLowering__lower_freeze(MUTABLE self: MIRLowering, node: FreezeNode) RETURNS !FreezeExpr
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE ti = &node.value.full_type_mut();
    MUTABLE zig_base = mIRLowering__transpile_type(rtoc_self_view, type__resolved((TRY (type__non_optional_type(ti)))));
    MUTABLE inner = TRY (mIRLowering__lower(&rtoc_self_view, node.value));
    MUTABLE rc_data = FieldGet{ object: Emittable{ FieldGet: COPY FieldGet{ object: COPY inner, field: "ctrl", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "data", lowered_node_id: NIL, ownership_consumption: NIL };
    RETURN FreezeExpr{ inner: Emittable{ FieldGet: COPY rc_data }, zig_base: COPY zig_base, alloc_ref: COPY AllocatorRef{ kind: :heap, lowered_node_id: NIL, ownership_consumption: NIL }, lowered_node_id: NIL, ownership_consumption: NIL };
}
END
PRIVATE FN mIRLowering__rc_payload_zig_type(self: MIRLowering, ti: Type) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (type__generic_type_parameter?(ti) AND type__shared?(ti)) THEN
