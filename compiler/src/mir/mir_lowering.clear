      MUTABLE for_loop = ForStmt{ iter: Emittable{ FieldGet: COPY self_field }, capture: "*__e", body: CAST(loop_body |> SELECT Emittable{ ExprStmt: castEmittableToExprStmt(COPY _)} AS []Emittable), index_capture: NIL, mark_per_iter: FALSE, tight: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
      MUTABLE cleanup_guard = IfStmt{ cond: Emittable{ Comptime: COPY Comptime{ expr: castMIRLoweringReturnValueToEmittable__mir_lowering(COPY TRY (mIRLowering__emit_builtin(&self, :needsCleanup, [Emittable{ Ident: COPY elem_zig }]))), lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: [Emittable{ ForStmt: COPY for_loop }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL };
      MUTABLE len_guard = IfStmt{ cond: Emittable{ MIRBinOp: COPY MIRBinOp{ op: ">", left: Emittable{ ListLength: COPY ListLength{ expr: Emittable{ FieldGet: COPY self_field }, lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: [Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ FreeSlice: COPY FreeSlice{ slice: Emittable{ FieldGet: COPY self_field }, alloc: castExprToAlloc(COPY alloc_ref), lowered_node_id: NIL, ownership_consumption: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL };
      RETURN CAST([Emittable{ IfStmt: COPY cleanup_guard }, Emittable{ IfStmt: COPY len_guard }] AS []Emittable);
    ELSE
      RETURN CAST(List[] AS []Emittable);
    END
END
PRIVATE FN mIRLowering__lower_union_lifecycle_methods(MUTABLE self: MIRLowering, node: UnionDef, facts: []UnionVariantLoweringFact) RETURNS ![]FnDef
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE cleanup_arms: []UnionMatchArm = List[];
    MUTABLE needs_cleanup: Bool = FALSE;
    MUTABLE copy_forbidden: Bool = FALSE;
    MUTABLE clone_arms: []UnionMatchArm = List[];
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < facts.length() DO
      MUTABLE data: ?MIRLoweringUnionVariantPayload = COPY facts[rtoc_idx]?.data;
      IF (data == NIL) THEN
          &cleanup_arms.append(UnionMatchArm{ variant: COPY UNWRAP (facts[rtoc_idx]).name, payload: NIL, body: List[], pointer_payload: FALSE });
          &clone_arms.append(UnionMatchArm{ variant: COPY UNWRAP (facts[rtoc_idx]).name, payload: NIL, body: [Emittable{ ReturnStmt: COPY ReturnStmt{ value: Emittable{ StructInit: COPY StructInit{ zig_type: NIL, fields: [CAST({:name: UNWRAP (facts[rtoc_idx]).name, :value: Lit{ value: "void{}", lowered_node_id: NIL, ownership_consumption: NIL }} AS Any)], lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], pointer_payload: FALSE });
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE payload = "__payload_${mIRLowering__zig_safe_name(rtoc_self_view, COPY UNWRAP (facts[rtoc_idx]).name)}";
      MUTABLE body: []Emittable = List[];
      MUTABLE copy_strategy: String@symbol = :bit_copy;
      IF facts[rtoc_idx]?.inline_struct THEN
          MUTABLE inline: InlineStructVariant@multiowned = castOptionalMIRLoweringUnionVariantPayloadToInlineStructVariantMultiowned(data);
          MUTABLE drop_payload: Bool = (inline.deinit_entries.length() > 0);
          FOR _ IN inline.fields.values() DO
        MUTABLE rtoc_recv_4769 = mIRLowering__lifecycle_registry(&rtoc_self_view);
        MUTABLE plan = COPY TRY (lifecycleRegistry__fetch(rtoc_recv_4769, TRY (type__from_input(_))));
        copy_forbidden = (copy_forbidden OR (plan.copy_strategy == :forbidden));
        IF (plan.copy_strategy != :bit_copy) THEN
              copy_strategy = :deep_clone;
        END
        drop_payload = (drop_payload OR lifecyclePlan__needs_drop?(plan));
          END
          IF drop_payload THEN
            &body.append(Emittable{ ExprStmt: COPY ExprStmt{ expr: castMIRLoweringReturnValueToEmittable__mir_lowering(COPY TRY (mIRLowering__emit_builtin(&rtoc_self_view, :cleanup, [Emittable{ Ident: COPY Ident{ name: UNWRAP (COPY facts[rtoc_idx]?.zig_type), lowered_node_id: NIL, ownership_consumption: NIL } }, Emittable{ Ident: COPY Ident{ name: "alloc", lowered_node_id: NIL, ownership_consumption: NIL } }, Emittable{ Ident: COPY Ident{ name: COPY payload, lowered_node_id: NIL, ownership_consumption: NIL } }]))), discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
          END
      ELSE
          MUTABLE variant_type = TRY (type__from_variant_input(castOptionalMIRLoweringUnionVariantPayloadToOptionalSchemasUnionSchemaVariantValue(data)));
          MUTABLE rtoc_recv_4782 = mIRLowering__lifecycle_registry(&rtoc_self_view);
          MUTABLE plan = COPY TRY (lifecycleRegistry__fetch(rtoc_recv_4782, variant_type));
          copy_forbidden = (copy_forbidden OR (plan.copy_strategy == :forbidden));
          copy_strategy = COPY plan.copy_strategy;
          IF (plan.drop_strategy == :resource_close) THEN
            &body.append(Emittable{ ResourceClose: COPY ResourceClose{ target: Emittable{ Deref: COPY Deref{ expr: Emittable{ Ident: COPY Ident{ name: COPY payload, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, close_plan: UNWRAP (plan.resource_close_plan), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
          ELSE_IF lifecyclePlan__needs_drop?(plan) THEN
            &body.append(Emittable{ ExprStmt: COPY ExprStmt{ expr: castMIRLoweringReturnValueToEmittable__mir_lowering(COPY TRY (mIRLowering__emit_builtin(&rtoc_self_view, :cleanup, [Emittable{ Ident: COPY Ident{ name: COPY UNWRAP (facts[rtoc_idx]).zig_type, lowered_node_id: NIL, ownership_consumption: NIL } }, Emittable{ Ident: COPY Ident{ name: "alloc", lowered_node_id: NIL, ownership_consumption: NIL } }, Emittable{ Ident: COPY Ident{ name: COPY payload, lowered_node_id: NIL, ownership_consumption: NIL } }]))), discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
          END
      END
      needs_cleanup = (needs_cleanup OR (body.length() > 0));
      MUTABLE clone_payload: String = "";
        IF (copy_strategy == :bit_copy) THEN
          clone_payload = "${payload}.*";
        ELSE
          clone_payload = "try CheatLib.dupeValue(@TypeOf(${payload}.*), ${payload}.*, alloc)";
        END
      &clone_arms.append(UnionMatchArm{ variant: COPY UNWRAP (facts[rtoc_idx]).name, payload: COPY payload, pointer_payload: TRUE, body: [Emittable{ ReturnStmt: COPY ReturnStmt{ value: Emittable{ StructInit: COPY StructInit{ zig_type: NIL, fields: [CAST({:name: UNWRAP (facts[rtoc_idx]).name, :value: Lit{ value: COPY clone_payload, lowered_node_id: NIL, ownership_consumption: NIL }} AS Any)], lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] });
      &cleanup_arms.append(UnionMatchArm{ variant: COPY UNWRAP (facts[rtoc_idx]).name, payload: COPY payload, pointer_payload: TRUE, body: COPY body });
    rtoc_idx = rtoc_idx + 1;
    END
    MUTABLE methods: []FnDef = List[];
    MUTABLE statements: []Emittable = [CAST(Suppress{ name: "alloc", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable), CAST(UnionMatchStmt{ subject: Emittable{ Deref: COPY Deref{ expr: Emittable{ Ident: COPY Ident{ name: "self", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, arms: cleanup_arms, default_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable)];
    &methods.append(FnDef{ name: "__clear_drop", params: [MIRParam{ name: "self", zig_type: "*@This()", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL }, MIRParam{ name: "alloc", zig_type: "std.mem.Allocator", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL }], ret_type: "void", body: COPY statements, visibility: :pub, can_fail: FALSE, comptime_params: List[], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
    IF !(copy_forbidden) THEN
      &methods.append(FnDef{ name: "__clear_clone", params: [MIRParam{ name: "self", zig_type: "@This()", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL }, MIRParam{ name: "alloc", zig_type: "std.mem.Allocator", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL }], ret_type: "@This()", body: COPY [Emittable{ Suppress: COPY Suppress{ name: "alloc", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ UnionMatchStmt: COPY UnionMatchStmt{ subject: Emittable{ Ident: COPY Ident{ name: "self", lowered_node_id: NIL, ownership_consumption: NIL } }, arms: clone_arms, default_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], visibility: :pub, can_fail: TRUE, comptime_params: List[], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
    END
    RETURN methods;
}
END
FN castSchemasUnionSchemaVariantInputToMIRLoweringType(value: SchemasUnionSchemaVariantInput) RETURNS MIRLoweringType ->
  PARTIAL MATCH value START
    SchemasUnionSchemaVariantInput.StringValue AS cast_payload -> RETURN MIRLoweringType{ StringValue: COPY cast_payload };,
    SchemasUnionSchemaVariantInput.SymbolValue AS cast_payload -> RETURN MIRLoweringType{ SymbolValue: COPY cast_payload };,
    SchemasUnionSchemaVariantInput.Type AS cast_payload -> RETURN MIRLoweringType{ Type: COPY cast_payload };,
    SchemasUnionSchemaVariantInput.TypeMultiowned AS cast_payload -> RETURN MIRLoweringType{ Type: COPY cast_payload };,
  END
  RETURN MIRLoweringType{ SymbolValue: :Any };
END
FN castSchemasUnionSchemaVariantInputToOptionalMIRLoweringUnionVariantPayload(value: ?SchemasUnionSchemaVariantInput) RETURNS ?MIRLoweringUnionVariantPayload ->
  IF value EXISTS AS value_present THEN
    PARTIAL MATCH value_present START
      SchemasUnionSchemaVariantInput.FunctionType AS cast_payload -> RETURN MIRLoweringUnionVariantPayload{ FunctionType: COPY cast_payload };,
      SchemasUnionSchemaVariantInput.TypeMultiowned AS cast_payload -> RETURN MIRLoweringUnionVariantPayload{ TypeMultiowned: COPY cast_payload };,
      SchemasUnionSchemaVariantInput.SymbolValue AS cast_payload -> RETURN MIRLoweringUnionVariantPayload{ SymbolValue: COPY cast_payload };,
      SchemasUnionSchemaVariantInput.StringValue AS cast_payload -> RETURN MIRLoweringUnionVariantPayload{ StringValue: COPY cast_payload };,
      SchemasUnionSchemaVariantInput.InlineStructVariantMultiowned AS cast_payload -> RETURN MIRLoweringUnionVariantPayload{ InlineStructVariantMultiowned: COPY cast_payload };,
      SchemasUnionSchemaVariantInput.Type AS cast_payload -> RETURN MIRLoweringUnionVariantPayload{ Type: COPY cast_payload };,
    END
  END
  RETURN NIL;
END
PRIVATE FN mIRLowering__union_variant_lowering_facts(self: MIRLowering, node: UnionDef) RETURNS ![]UnionVariantLoweringFact ->
    MUTABLE facts: []UnionVariantLoweringFact = List[];
    FOR rtoc_variant_name IN node.variants.keys() DO
      MUTABLE rtoc_data: ?SchemasUnionSchemaVariantInput = COPY node.variants[rtoc_variant_name];
      MUTABLE inline_struct = schemas__inline_struct?(IF rtoc_data EXISTS AS rtoc_variant_value THEN castSchemasUnionSchemaVariantInputToSchemasUnionSchemaVariantValue(rtoc_variant_value) ELSE NIL END);
      MUTABLE name = COPY rtoc_variant_name;
      MUTABLE zig_type: String = "void";
      IF rtoc_data EXISTS THEN
        IF inline_struct THEN
          zig_type = "${node.name}_${name}";
        ELSE
          zig_type = TRY (mIRLowering__transpile_type(self, castSchemasUnionSchemaVariantInputToMIRLoweringType(rtoc_data), FALSE, TRUE));
        END
      END
      &facts.append(UnionVariantLoweringFact{ owner_name: COPY node.name, name: COPY name, data: castSchemasUnionSchemaVariantInputToOptionalMIRLoweringUnionVariantPayload(COPY rtoc_data), inline_struct: inline_struct, zig_type: COPY zig_type });
    END
    RETURN facts;
END
PRIVATE FN mIRLowering__lower_cast(MUTABLE self: MIRLowering, node: Cast) RETURNS !?Emittable
  EFFECTS REENTRANT ->
    MUTABLE inner: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(node.value)));
    IF hoist__noreturn_value?(node.value) THEN
      RETURN inner;
    END
    MUTABLE target_type = TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY node.target }));
    MUTABLE cast_target = TRY (type__new(TypeConstructionInput{ Type: COPY node.target }));
    IF (TRY (type__byte_string?(cast_target)) AND !(type__optional?(cast_target))) THEN
      MUTABLE widened = TRY (mIRLowering__widen_symbol_to_bytes(&self, UNWRAP (inner), node.value));
      IF widened IS_A FieldGet AS rtoc_widened_field THEN
        IF (rtoc_widened_field.field == "bytes") THEN
          RETURN widened;
        END
      END
    END
    MUTABLE target_base = type__resolved((TRY (type__value_payload_type((TRY (type__new(TypeConstructionInput{ Type: COPY node.target })))))));
    IF (TRY (mIRLowering__enum_schemas(&self))).contains?(target_base) THEN
      RETURN Emittable{ MIRCast: COPY MIRCast{ expr: UNWRAP (COPY inner), target_type: COPY target_type, method: :enumFromInt, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    RETURN Emittable{ MIRCast: COPY MIRCast{ expr: UNWRAP (COPY inner), target_type: COPY target_type, method: :as, lowered_node_id: NIL, ownership_consumption: NIL } };
END
PRIVATE FN mIRLowering__lower_static_call(MUTABLE self: MIRLowering, node: StaticCall) RETURNS !Emittable
  EFFECTS REENTRANT ->
    MUTABLE mir_args: []Emittable = List[];
    MUTABLE inherent_call: ?FuncCall = COPY node.inherent_call;
    IF inherent_call EXISTS AS inherent_call_value THEN
      MUTABLE inherent_call_value_mutable = COPY inherent_call_value;
      RETURN TRY (mIRLowering__lower_func_call(&self, &inherent_call_value_mutable));
    END
    MUTABLE stdlib_def: ?FunctionSignature@multiowned = functionSignature__unwrap(ruby_wrap_optional_FunctionSignature_multiowned_X__mir_lowering(KEEP node.matched_stdlib_def));
    IF stdlib_def EXISTS AS stdlib_def_value THEN
      MUTABLE stdlib_def_value_mutable = COPY stdlib_def_value;
      IF TRY (functionSignature__intrinsic_bc?(stdlib_def_value_mutable)) THEN
        mir_args = List[];
        FOR arg_node IN node.args DO
          MUTABLE arg_stmt = castLocatableToMIRLoweringLowerableStmt__mir_lowering(COPY arg_node);
          MUTABLE arg_mir: Emittable = UNWRAP (TRY (mIRLowering__lower(&self, &arg_stmt)));
          MUTABLE arg_ast: Locatable = COPY arg_node;
          &mir_args.append(TRY (mIRLowering__hoist_alloc(&self, &arg_mir, &arg_ast)));
        END
        RETURN Emittable{ InlineBc: COPY InlineBc{ op: COPY TRY (functionSignature__intrinsic_bc_op_or(&stdlib_def_value_mutable, symbol((CAST(node.method_name AS String))))), args: COPY mir_args, stdlib_def: stdlib_def_value_mutable, suppress_try: FALSE, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
      mir_args = List[];
      FOR arg_node IN node.args DO
        MUTABLE arg_stmt = castLocatableToMIRLoweringLowerableStmt__mir_lowering(COPY arg_node);
        MUTABLE arg_mir: Emittable = UNWRAP (TRY (mIRLowering__lower(&self, &arg_stmt)));
        MUTABLE arg_ast: Locatable = COPY arg_node;
        &mir_args.append(TRY (mIRLowering__hoist_alloc(&self, &arg_mir, &arg_ast)));
      END
      RETURN Emittable{ RegistryCall: COPY RegistryCall{ entry: stdlib_def_value_mutable, args: COPY mir_args |> SELECT RegistryCallArg{ expr: COPY _, coerce_type: NIL }, reason: "static_call", ownership_contract: TRY (ownershipContract__empty()), allocs: NIL, owned_result_alloc: NIL, target_var: NIL, result_type: NIL, result_ownership_bearing: NIL, key_type: NIL, value_type: NIL, suppress_try: FALSE } };
    ELSE
      panic("lower_static_call: missing stdlib signature for {}");
    END
END
PRIVATE FN mIRLowering__lower_or_else_exit(MUTABLE self: MIRLowering, node: OrElseExit) RETURNS !ScopeBlock
  EFFECTS REENTRANT ->
    MUTABLE msg_mir: ?Emittable = NIL;
    MUTABLE facts = TRY (mIRLowering__or_else_exit_facts(self, node, node.token.line));
    IF mIRLowering__bc_target?(&self) THEN
      IF node.message EXISTS AS message_value THEN
        msg_mir = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(message_value)));
      END
      RETURN ScopeBlock{ body: COPY [Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ OrElseExitBcRewrite: COPY mIRLowering__or_else_exit_bc_reassign(self, facts, msg_mir) }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ ReturnStmt: COPY ReturnStmt{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "error", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "CheatError", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    END
    IF node.message EXISTS AS message_value THEN
      msg_mir = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(message_value)));
    END
    RETURN TRY (mIRLowering__or_else_exit_scope(&self, facts, msg_mir, Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "error", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "CheatError", lowered_node_id: NIL, ownership_consumption: NIL } }));
END
PRIVATE FN mIRLowering__lower_require(MUTABLE self: MIRLowering, node: RequireNode) RETURNS !MIRLoweringLoweredMir
  EFFECTS REENTRANT ->
    MUTABLE importer: ?ModuleImporter = COPY mIRLowering__program_state(self).importer;
    MUTABLE pkg_inline = (((node.kind == :package) AND (TRUE)) AND moduleImporter__stdlib_package?(UNWRAP (importer), node.path));
    IF ((node.kind == :package) AND !(pkg_inline)) THEN
      MUTABLE import_name = (IF node.namespace.empty?() THEN COPY node.path ELSE COPY node.namespace END);
      IF ((importer != NIL) AND TRUE) THEN
        import_name = moduleImporter__owning_package_name(importer, import_name);
      END
      MUTABLE zig_import_name = mIRLowering__zig_module_alias(self, import_name);
      IF !(&self.state.program.emitted_require_modules.insert("pkg-import:${import_name}")) THEN
        RETURN List[];
      END
      MUTABLE items: []Emittable = [Emittable{ Import: COPY Import{ alias_name: COPY zig_import_name, module_path: "${import_name}.zig", member: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }];
      MUTABLE pkg_mod: ?CompiledModule = NIL;
      IF importer EXISTS AS MUTABLE importer_value THEN
        pkg_mod = TRY (moduleImporter__compile_package(&importer_value, node.path, UNWRAP (mIRLowering__program_state(self).source_dir)));
      END
      IF pkg_mod EXISTS AS pkg_mod_value THEN
        mIRLowering__merge_module_schemas_mut(&self, pkg_mod_value);
      END
      mIRLowering__record_module_const_init_mut(&self, pkg_mod, zig_import_name);
      IF pkg_mod EXISTS AS pkg_mod_scope_owner THEN
        MUTABLE pkg_scope_value: Scope@multiowned = KEEP pkg_mod_scope_owner.global_scope;
        MUTABLE alias_target = zig_import_name;
        FOR rtoc_key IN pkg_scope_value.types.keys() DO
    MUTABLE type_entry: ScopeTypeEntry = COPY UNWRAP (pkg_scope_value.types[rtoc_key]);
    MUTABLE vis: String@symbol = (schemaValue__visibility(type_entry.schema) OR_ELSE :package);
    IF !((vis == :pub)) THEN
            CONTINUE;
    END
    IF !(&self.state.program.emitted_import_type_aliases.insert(CAST(rtoc_key AS String))) THEN
            CONTINUE;
    END
    &items.append(Emittable{ TypeAlias: COPY TypeAlias{ name: COPY CAST(rtoc_key AS String), target: "${alias_target}.${rtoc_key}", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
        END
      END
      RETURN MIRLoweringLoweredMir{ ArrayValue: COPY items };
    ELSE
      IF importer EXISTS AS importer_value THEN
        MUTABLE importer_value_mutable = COPY importer_value;
        MUTABLE mod_branch_value: ?CompiledModule = NIL;
        IF pkg_inline THEN
          mod_branch_value = TRY (moduleImporter__compile_package(&importer_value_mutable, node.path, UNWRAP (mIRLowering__program_state(self).source_dir)));
        ELSE
          mod_branch_value = TRY (moduleImporter__compile_file(&importer_value_mutable, node.path, UNWRAP (mIRLowering__program_state(self).source_dir)));
        END
        MUTABLE mod: ?CompiledModule = mod_branch_value;
        mIRLowering__merge_module_schemas_mut(&self, UNWRAP (mod));
        IF UNWRAP (mod).ast EXISTS AS mod_ast THEN
          MUTABLE rtoc_each_items_148 = COPY mod_ast.statements;
          MUTABLE rtoc_idx = 0;
          WHILE rtoc_idx < rtoc_each_items_148.length() DO
      IF !(UNWRAP (rtoc_each_items_148[rtoc_idx]) IS_A FunctionDef) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF (locatable__name(UNWRAP (rtoc_each_items_148[rtoc_idx])) == "main") THEN
                rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF UNWRAP (rtoc_each_items_148[rtoc_idx]) IS_A FunctionDef AS module_fn THEN
        MUTABLE rtoc_index_receiver_149 = TRY (mIRLowering__fn_sigs(self));
        rtoc_index_receiver_149[COPY module_fn.name] = TRY (functionSignature__from_function_def(module_fn));
      END
    rtoc_idx = rtoc_idx + 1;
          END
          MUTABLE module_scope: Scope@multiowned = KEEP UNWRAP (mod).global_scope;
          IF TRUE THEN
            MUTABLE rtoc_merged_sigs = TRY (mIRLowering__fn_sigs(self));
            TRY (functionSignature__merge_imported_signatures_mut(&rtoc_merged_sigs, module_scope));
            self.state.program.fn_sigs = rtoc_merged_sigs;
          END
        END
        MUTABLE same_dir = ((UNWRAP (mod)).source_dir == mIRLowering__program_state(self).source_dir);
        MUTABLE dependency_items = TRY (mIRLowering__imported_module_dependency_items(&self, mod?));
        MUTABLE namespace_items = mIRLowering__with_lifecycle_registry(&self, (UNWRAP (mod)).lifecycle_registry, %() USE(mod, MUTABLE self) -> {
    rtoc_lambda_result_150 = TRY (mIRLowering__imported_module_items(&self, mod?));
    rtoc_lambda_result_150
        });
        IF mIRLowering__bc_target?(&self) THEN
          MUTABLE helper_fns = TRY (mIRLowering__imported_bc_helper_fns(self, mod?, namespace_items));
          IF (helper_fns.length() > 0) THEN
            RETURN MIRLoweringLoweredMir{ ArrayValue: helper_fns |> SELECT Emittable{ FnDef: COPY _ } };
          END
        END
        # Ruby keys emitted_require_modules by the CompiledModule's object_id.
        # CompiledModule carries no id of its own, so identify it by its
        # program node, which is unique per imported source file.
        MUTABLE module_key = aST__node_identity(Locatable{ Program: COPY UNWRAP ((UNWRAP (mod)).ast) });
        IF !(&self.state.program.emitted_require_modules.insert(CAST(module_key AS String))) THEN
          RETURN List[];
        END
        RETURN (dependency_items + TRY (mIRLowering__imported_module_extern_items(&self, mod?)) + TRY (mIRLowering__visible_type_items(&self, mod?, same_dir)) + [Emittable{ ModuleNamespace: COPY ModuleNamespace{ name: mIRLowering__zig_module_alias(self, node.namespace), items: COPY namespace_items, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }]);
      ELSE
        panic("MIRLowering: REQUIRE \\\"{}\\\" but no importer available");
      END
    END
END
PRIVATE FN mIRLowering__imported_module_extern_items(MUTABLE self: MIRLowering, mod_value: CompiledModule) RETURNS ![]Emittable
  EFFECTS REENTRANT ->
    IF mod_value.ast == NIL THEN
      RETURN CAST(List[] AS []Emittable);
    END
    MUTABLE extern_items: []Emittable = List[];
    FOR stmt IN UNWRAP (mod_value.ast).statements DO
      IF (stmt IS_A ExternFnDecl OR stmt IS_A ExternStructDecl) THEN
        MUTABLE extern_stmt = castLocatableToMIRLoweringLowerableStmt__mir_lowering(COPY stmt);
        IF TRY (mIRLowering__lower(&self, &extern_stmt)) EXISTS AS extern_mir THEN
          &extern_items.append(COPY extern_mir);
        END
      END
    END
    RETURN extern_items;
END
PRIVATE FN mIRLowering__record_module_const_init_mut(MUTABLE self: MIRLowering, mod_value: ?CompiledModule, alias_name: String) RETURNS Void ->
    MUTABLE items: ?[]Emittable = COPY mod_value?.mir_items;
    IF items EXISTS AS items_value THEN
      MUTABLE has_init = items_value |> ANY (IF _ IS_A FnDef AS fn_def THEN (fn_def.name == "__clear_init_consts") ELSE FALSE END);
      IF has_init THEN
        &self.state.program.module_const_inits.insert(COPY alias_name);
      END
    ELSE
      RETURN;
    END
END
PRIVATE FN mIRLowering__merge_module_schemas_mut(MUTABLE self: MIRLowering, mod_value: CompiledModule) RETURNS Void ->
    MUTABLE struct_schemas = mod_value.struct_schemas;
    MUTABLE enum_schemas = mod_value.enum_schemas;
    MUTABLE union_schemas = mod_value.union_schemas;
    MUTABLE rtoc_mutable_receiver_152 = mIRLowering__lowering_schemas(&self);
    mIRLoweringSchemas__merge_mut(&rtoc_mutable_receiver_152, struct_schemas, enum_schemas, union_schemas);
END
PRIVATE FN mIRLowering__visible_type_items(MUTABLE self: MIRLowering, mod_value: CompiledModule, same_dir: Bool = FALSE) RETURNS ![]Emittable ->
    MUTABLE items:? = mod_value.type_items;
    IF !(items) THEN
      RETURN CAST(List[] AS []Emittable);
    END
    MUTABLE visible_names = mIRLowering__visible_imported_type_names(&self, mod_value, same_dir);
    IF visible_names.empty?() THEN
      RETURN CAST(List[] AS []Emittable);
    END
    RETURN items |> WHERE (IF emittable__name(_) EXISTS AS item_name THEN visible_names.contains?(item_name) ELSE FALSE END);
END
PRIVATE FN mIRLowering__visible_imported_type_names(MUTABLE self: MIRLowering, mod_value: CompiledModule, same_dir: Bool = FALSE) RETURNS [Set]String ->
    MUTABLE visible_names: [Set]String = Set[];
    IF mod_value.ast == NIL THEN
      RETURN COPY visible_names;
    END
    MUTABLE rtoc_each_items_155 = UNWRAP (mod_value.ast).statements;
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_155.length() DO
    IF (UNWRAP (rtoc_each_items_155[rtoc_idx]) IS_A StructDef) OR (UNWRAP (rtoc_each_items_155[rtoc_idx]) IS_A EnumDef) OR (UNWRAP (rtoc_each_items_155[rtoc_idx]) IS_A UnionDef) THEN
        MUTABLE vis: String@symbol = (locatable__visibility(UNWRAP (rtoc_each_items_155[rtoc_idx])) OR_ELSE :package);
        IF (vis == :private) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
        END
        IF !((((vis == :pub)) OR same_dir)) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
        END
        MUTABLE name = COPY CAST(UNWRAP locatable__name( UNWRAP ((rtoc_each_items_155[rtoc_idx]))) AS String);
        IF mIRLowering__program_state(self).emitted_types.contains?(name) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
        END
        &visible_names.insert(name);
        &self.state.program.emitted_types.insert(name);
        IF UNWRAP (rtoc_each_items_155[rtoc_idx]) IS_A UnionDef AS visible_union_def THEN
          FOR rtoc_key IN visible_union_def.variants.keys() DO
      MUTABLE var_data: SchemasUnionSchemaVariantInput = COPY UNWRAP (visible_union_def.variants[rtoc_key]);
      IF !(schemas__inline_struct?(castSchemasUnionSchemaVariantInputToSchemasUnionSchemaVariantValue(var_data))) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE syn = "${visible_union_def.name}_${rtoc_key}";
      &visible_names.insert(COPY syn);
      &self.state.program.emitted_types.insert(COPY syn);
          END
        END
    END
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN COPY visible_names;
END
PRIVATE FN mIRLowering__imported_module_items(MUTABLE self: MIRLowering, mod_value: CompiledModule) RETURNS ![]Emittable
  EFFECTS REENTRANT ->
    IF mod_value.ast EXISTS AS module_ast THEN
      MUTABLE hidden_type_items: []Emittable = List[];
      MUTABLE fn_items: []Emittable = List[];
      FOR stmt IN module_ast.statements DO
        MUTABLE stmt_lowerable = castLocatableToMIRLoweringLowerableStmt__mir_lowering(COPY stmt);
        IF mIRLowering__hidden_imported_type_statement?(self, stmt, mod_value) THEN
          IF TRY (mIRLowering__lower(&self, &stmt_lowerable)) EXISTS AS hidden_mir THEN
            &hidden_type_items.append(COPY hidden_mir);
          END
        END
        IF stmt IS_A FunctionDef AS module_fn THEN
          IF !((module_fn.name == "main")) THEN
            MUTABLE module_fn_mutable = COPY module_fn;
            &fn_items.append(castMIRLoweringReturnValueToEmittable__mir_lowering(TRY (mIRLowering__lower_function_def(&self, &module_fn_mutable))));
          END
        ELSE_IF (stmt IS_A VarDecl OR stmt IS_A BindExpr) THEN
          IF TRY (mIRLowering__lower(&self, &stmt_lowerable)) EXISTS AS binding_mir THEN
            &fn_items.append(COPY binding_mir);
          END
        END
      END
      RETURN (hidden_type_items + fn_items);
    END
    IF mod_value.mir_items EXISTS AS module_mir_items THEN
      RETURN module_mir_items |> WHERE mIRLowering__importable_module_item?(self, _);
    END
    RETURN CAST(List[] AS []Emittable);
END
PRIVATE FN mIRLowering__hidden_imported_type_statement?(self: MIRLowering, stmt: Locatable, mod_value: CompiledModule) RETURNS Bool ->
    IF !(((stmt IS_A StructDef OR stmt IS_A EnumDef) OR stmt IS_A UnionDef)) THEN
      RETURN FALSE;
    END
    MUTABLE same_dir = (mod_value.source_dir == mIRLowering__program_state(self).source_dir);
    MUTABLE vis = (locatable__visibility(stmt) OR_ELSE :package);
    IF (vis == :pub) THEN
      RETURN FALSE;
    END
    IF ((vis == :package) AND same_dir) THEN
      RETURN FALSE;
    END
    RETURN TRUE;
END
PRIVATE FN mIRLowering__importable_module_item?(self: MIRLowering, item: Emittable) RETURNS Bool ->
    IF (IF item IS_A FnDef AS fn_def THEN (CAST(fn_def.name AS String) == "main") ELSE FALSE END) THEN
      RETURN FALSE;
    END
    IF item IS_A ModuleNamespace AS module_namespace THEN
      RETURN FALSE;
    END
    RETURN TRUE;
END
PRIVATE FN mIRLowering__imported_module_dependency_items(MUTABLE self: MIRLowering, mod_value: CompiledModule) RETURNS ![]Emittable
  EFFECTS REENTRANT ->
  IF !(mod_value.ast) THEN
      RETURN CAST(List[] AS []Emittable);
  END
  MUTABLE prev_source_dir: ?String = COPY mIRLowering__program_state(self).source_dir;
  DEFER self.state.program.source_dir = prev_source_dir;
  self.state.program.source_dir = mod_value.source_dir;
  MUTABLE dependency_items: []Emittable = List[];
  FOR stmt IN UNWRAP (mod_value.ast).statements DO
    IF stmt IS_A RequireNode AS require_node THEN
      MUTABLE required = TRY (mIRLowering__lower_require(&self, require_node));
      IF required IS_A MIRLoweringLoweredMir.Emittable AS single THEN
        &dependency_items.append(COPY single);
      END
      IF required IS_A MIRLoweringLoweredMir.ArrayValue AS many THEN
        FOR item IN many DO
          &dependency_items.append(COPY item);
        END
      END
    END
  END
  RETURN dependency_items;
END
PRIVATE FN mIRLowering__imported_bc_helper_fns(self: MIRLowering, mod_value: CompiledModule, items: []Emittable) RETURNS ![]FnDef ->
    RETURN items |> SELECT:? (IF _ IS_A FnDef AS fn_def THEN COPY fn_def ELSE NIL END) |> WHERE _ != NIL |> SELECT UNWRAP (_);
END
PUB FN mIRLowering__task_config_variant(self: MIRLowering, stack_size: ?String@symbol, computed_tier: ?String@symbol) RETURNS String ->
    MUTABLE default: String = "";
    IF mIRLowering__program_state(self).debug_mode THEN
      default = "Large";
    ELSE
      default = "Standard";
    END
    IF stack_size EXISTS AS stack_size_value THEN
      IF (stack_size_value == :stack) THEN
        RETURN ({NIL: "Standard", :micro: "Micro", :standard: "Standard", :large: "Large", :xl: "Xl", "micro": "Micro", "standard": "Standard", "large": "Large", "xl": "Xl", :service: "Huge"}[(computed_tier OR_ELSE :standard)] OR_ELSE default);
      ELSE
        RETURN ({NIL: "Standard", :micro: "Micro", :standard: "Standard", :large: "Large", :xl: "Xl", "micro": "Micro", "standard": "Standard", "large": "Large", "xl": "Xl", :service: "Huge"}[stack_size_value] OR_ELSE default);
      END
    ELSE
    IF computed_tier EXISTS AS computed_tier_value THEN
        MUTABLE computed = ({NIL: "Standard", :micro: "Micro", :standard: "Standard", :large: "Large", :xl: "Xl", "micro": "Micro", "standard": "Standard", "large": "Large", "xl": "Xl", :service: "Huge"}[computed_tier_value] OR_ELSE default);
        IF (({"Micro": 0, "Standard": 1, "Large": 2, "Xl": 3, "Huge": 4}[computed] OR_ELSE 0) >= ({"Micro": 0, "Standard": 1, "Large": 2, "Xl": 3, "Huge": 4}[default] OR_ELSE 0)) THEN
          RETURN computed;
        ELSE
          RETURN default;
        END
    ELSE
        RETURN default;
    END
    END
END
PRIVATE FN mIRLowering__profile_dispatch_id(self: MIRLowering, dispatch: MIRLoweringBackgroundDispatch) RETURNS Int64 ->
    RETURN PARTIAL MATCH dispatch START
      MIRLoweringBackgroundDispatch.SymbolValue AS rtoc_dispatch_sym -> (IF (rtoc_dispatch_sym == :parallel) THEN 2 ELSE (IF (rtoc_dispatch_sym == :shared) THEN 3 ELSE 1 END) END),
      DEFAULT -> 1
    END;
END
PRIVATE FN mIRLowering__bg_profile_site_comment(self: MIRLowering, site_id: Int64, line: Int64, col: Int64, dispatch: MIRLoweringBackgroundDispatch, form: String@symbol) RETURNS String ->
    RETURN "// CLEAR_PROFILE_TASK_SITE id=${site_id.toString()} kind=BG line=${line.toString()} column=${col.toString()} dispatch=${CAST(dispatch AS String)} form=${form}";
END
PRIVATE FN mIRLowering__lower_struct_pattern(MUTABLE self: MIRLowering, subject: Ident, pat: StructPattern) RETURNS !Tuple<[]Emittable, []Let> ->
    MUTABLE conditions: []Emittable = List[];
    MUTABLE bindings: []Let = List[];
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < pat.fields.length() DO
      IF patternField__wildcard?(pat.fields[rtoc_idx]?) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF patternField__bind?(UNWRAP (pat.fields[rtoc_idx])) THEN
          MUTABLE pattern_field_name: String = COPY UNWRAP (pat.fields[rtoc_idx]).name;
          MUTABLE field_access = FieldGet{ object: Emittable{ Ident: COPY subject }, field: COPY pattern_field_name, lowered_node_id: NIL, ownership_consumption: NIL };
          &bindings.append(Let{ name: COPY pattern_field_name, init: Emittable{ FieldGet: COPY field_access }, mutable: FALSE, annotation: NIL, suppression: "_ = &${pattern_field_name};", alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL });
      ELSE
          MUTABLE val: Emittable = CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt( UNWRAP (patternField__expr(pat.fields[rtoc_idx]?))))) AS Emittable);
          MUTABLE field_access = FieldGet{ object: Emittable{ Ident: COPY subject }, field: UNWRAP (COPY (pat.fields[rtoc_idx]?.name)), lowered_node_id: NIL, ownership_consumption: NIL };
          &conditions.append(Emittable{ MIRBinOp: COPY MIRBinOp{ op: "==", left: Emittable{ FieldGet: COPY field_access }, right: COPY val, lowered_node_id: NIL, ownership_consumption: NIL } });
      END
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN CAST(Tuple{conditions, COPY bindings} AS Tuple<[]Emittable, []Let>);
END
PRIVATE FN mIRLowering__lower_macro_print(MUTABLE self: MIRLowering, node: FuncCall) RETURNS !Call ->
    MUTABLE formats = (node.args |> SELECT { MUTABLE rtoc_mutable_block_param_163 = COPY _;
    TRY (mIRLowering__zig_format_for_type(self, TRY (aST__full_type_mut(rtoc_mutable_block_param_163)))) }).join(" ");
    MUTABLE args_mir: []Emittable = List[];
    FOR print_arg IN node.args DO
      MUTABLE print_stmt = castLocatableToMIRLoweringLowerableStmt__mir_lowering(COPY print_arg);
      MUTABLE print_ast: Locatable = COPY print_arg;
      MUTABLE print_mir: Emittable = UNWRAP (TRY (mIRLowering__lower(&self, &print_stmt)));
      print_mir = TRY (mIRLowering__widen_symbol_to_bytes(&self, print_mir, print_ast));
      &args_mir.append(TRY (mIRLowering__hoist_alloc(&self, &print_mir, &print_ast)));
    END
    MUTABLE format_lit = Lit{ value: "\"${formats}\\n\"", lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE tuple = TupleLiteral{ items: COPY args_mir, lowered_node_id: NIL, ownership_consumption: NIL };
    RETURN Call{ callee: "std.debug.print", args: [Emittable{ Lit: COPY format_lit }, Emittable{ TupleLiteral: COPY tuple }], try_wrap: FALSE, owned_return: FALSE, callable_contract: TRY (callableContract__no_ownership(2)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL };
END
PRIVATE FN mIRLowering__zig_format_for_type(self: MIRLowering, flux_type: Type) RETURNS !String ->
    IF (TRY (type__string?(flux_type)) OR ((type__array?(flux_type) AND ((TRY (type__element_type(flux_type)) != NIL) AND type__byte?((UNWRAP (TRY (type__element_type(flux_type))))))))) THEN
      RETURN "{s}";
    END
    IF (((type__resolved(flux_type) == :Number) OR (type__resolved(flux_type) == :Int64)) OR type__byte?(flux_type)) THEN
      RETURN "{d}";
    END
    IF (((type__resolved(flux_type) == :Bool) OR (type__resolved(flux_type) == :Boolean)) OR type__void?(flux_type)) THEN
      RETURN "{}";
    END
    RETURN "{any}";
END
PRIVATE FN mIRLowering__callee_can_fail?(self: MIRLowering, name: String) RETURNS !Bool ->
    IF (name.length() == 0) THEN
      RETURN TRUE;
    END
    MUTABLE sig: ?FunctionSignature@multiowned = TRY (mIRLowering__fn_sig_for(self, MIRLoweringName{ StringValue: COPY name }));
    IF sig EXISTS AS sig_value THEN
      RETURN (functionSignature__can_fail(sig_value) != FALSE);
    ELSE
      RETURN TRUE;
    END
END
PRIVATE FN mIRLowering__collect_identifier_names(self: MIRLowering, nodes: []Node) RETURNS ![Set]String ->
    MUTABLE names = Set[];
    aST__each_locatable_list(castNodeListToLocatableList(nodes), FALSE, %(MUTABLE node: Locatable) USE(MUTABLE names) -> {
    IF node IS_A Identifier AS identifier THEN
        &names.insert(identifier__name(identifier));
    END
    rubyToClearVoid__mir_lowering()
    });
    RETURN names;
END
PUB FN mIRLowering__emit_builtin(MUTABLE self: MIRLowering, name: String@symbol, args: []Emittable) RETURNS !MIRLoweringReturnValue ->
    MUTABLE entry: ?FunctionSignature@multiowned = functionSignature__unwrap(castOptionalLookupResultToOptionalX__mir_lowering(TRY (intrinsicRegistry__lookup(:builtin_ops, RegistryKey{ SymbolValue: COPY name }))));
    IF entry EXISTS AS entry_value THEN
      MUTABLE entry_value_mutable = COPY entry_value;
      IF (mIRLowering__bc_target?(&self) AND TRY (functionSignature__intrinsic_bc?(entry_value_mutable))) THEN
        RETURN MIRLoweringReturnValue{ InlineBc: COPY InlineBc{ op: COPY TRY (functionSignature__intrinsic_bc_op_or(&entry_value_mutable, name)), args: COPY args, stdlib_def: entry_value_mutable, suppress_try: FALSE, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
      RETURN MIRLoweringReturnValue{ RegistryCall: COPY RegistryCall{ entry: entry_value_mutable, args: COPY args |> SELECT RegistryCallArg{ expr: COPY _, coerce_type: NIL }, reason: "builtin_${name}", ownership_contract: TRY (ownershipContract__empty()), allocs: NIL, owned_result_alloc: NIL, target_var: NIL, result_type: NIL, result_ownership_bearing: NIL, key_type: NIL, value_type: NIL, suppress_try: FALSE } };
    ELSE
      panic("emit_builtin: unknown builtin :{}");
    END
END
PRIVATE FN mIRLowering__direct_slice_backed_expr?(MUTABLE self: MIRLowering, ast_node: Locatable, type_info: Type) RETURNS Bool ->
    IF type__fixed?(type_info) THEN
      RETURN TRUE;
    END
    IF ast_node IS_A GetField AS get_field THEN
      RETURN TRUE;
    END
    IF ast_node IS_A Identifier AS identifier THEN
      RETURN mIRLowering__current_function_param_name?(&self, identifier__name(identifier));
    ELSE
      RETURN FALSE;
    END
END
PRIVATE FN mIRLowering__direct_index_get(MUTABLE self: MIRLowering, target: Emittable, index_value: Emittable, ast_node: Locatable, type_info: Type) RETURNS !?IndexGet ->
    MUTABLE ti = TRY (type__new(TypeConstructionInput{ Type: COPY type_info }));
    IF type__list_collection?(ti) THEN
      RETURN NIL;
    END
    IF !(mIRLowering__direct_slice_backed_expr?(&self, ast_node, ti)) THEN
      RETURN NIL;
    END
    MUTABLE cast_idx = MIRCast{ expr: COPY index_value, target_type: "usize", method: :intCast, lowered_node_id: NIL, ownership_consumption: NIL };
    RETURN IndexGet{ object: COPY target, index: Emittable{ MIRCast: COPY cast_idx }, lowered_node_id: NIL, ownership_consumption: NIL };
END
PRIVATE FN mIRLowering__lower_direct_length(MUTABLE self: MIRLowering, node: Node) RETURNS !?MIRCast ->
    MUTABLE recv_ast:? = IF node IS_A MethodCall THEN
      node__object(node)
    ELSE
      (node__args(node) OR_ELSE List[]).first()
    END;
    IF !(recv_ast) THEN
      RETURN NIL;
    END
    MUTABLE recv_ti: ?Type = TRY (type__from_node_mut(recv_ast, "direct length"));
    MUTABLE ti = TRY (type__new(TypeConstructionInput{ Type: COPY UNWRAP (recv_ti) }));
    IF TRY (type__direct_indexable_collection?(ti)) THEN
      RETURN NIL;
    END
    MUTABLE recv = TRY (mIRLowering__rc_payload_value(self, CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(recv_ast))) AS Emittable), UNWRAP (recv_ti)));
    IF TRY (mIRLowering__mir_allocates?(&self, recv)) THEN
      recv = TRY (mIRLowering__hoist_alloc(&self, &recv, &recv_ast));
    END
    IF !(TRY (type__string?(ti))) THEN
      RETURN NIL;
    END
    RETURN MIRCast{ expr: Emittable{ ListLength: COPY ListLength{ expr: COPY TRY (mIRLowering__widen_symbol_to_bytes(&self, recv, recv_ast)), lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: "i64", method: :intCast, lowered_node_id: NIL, ownership_consumption: NIL };
END
PRIVATE FN mIRLowering__rc_payload_value(self: MIRLowering, value: Emittable, type_info: Type) RETURNS !Emittable ->
    IF !(TRY (type__any_rc?(type_info))) THEN
      RETURN COPY value;
    END
    IF (type__optional?(type_info) OR type__error_union?(type_info)) THEN
      RETURN COPY value;
    END
    RETURN Emittable{ Deref: COPY Deref{ expr: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ FieldGet: COPY FieldGet{ object: COPY value, field: "ctrl", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "data", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } };
END
FN mIRLowering__emit_expr(MUTABLE self: MIRLowering, node: Emittable) RETURNS !?String ->
    MUTABLE emitter = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_164 = mIRLowering__runtime_state(&self);
    mIRLoweringRuntimeState__emitter_mut(&rtoc_mutable_receiver_164) };
    emitter.rt_name = mIRLowering__runtime_binding_name(&self);
    RETURN TRY (mIREmitter__emit(&emitter, node));
END
PRIVATE FN mIRLowering__try_catch_with_provenance(self: MIRLowering, left: Emittable, catch_body: Emittable, capture: ?String, fallback: ?MIRLoweringFallback = NIL) RETURNS !TryCatch ->
    MUTABLE stripped = TRY (mIRLowering__strip_try(self, left));
    MUTABLE out = TryCatch{ expr: COPY stripped, catch_body: COPY catch_body, capture: COPY capture, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    IF emittable__result_type(stripped) EXISTS AS stripped_result_type THEN
      out.result_type = TRY (type__new( TypeConstructionInput{ Type: COPY stripped_result_type }));
    ELSE_IF ((fallback EXISTS) AND mIRLoweringFallback__responds_to_full_type?(fallback)) THEN
      out.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY TRY (aST__full_type_mut( CAST(fallback AS Locatable))) }));
    END
    RETURN out;
END
PRIVATE FN mIRLowering__strip_try(self: MIRLowering, mir_node: Emittable) RETURNS !Emittable ->
    IF emittable__responds_to_without_try?(mir_node) THEN
      RETURN TRY (emittable__without_try(mir_node));
    ELSE
      RETURN COPY mir_node;
    END
END
PRIVATE FN mIRLowering__emit_stmts_zig(MUTABLE self: MIRLowering, mir_nodes: []Emittable, indent: String = "") RETURNS !String ->
    MUTABLE rendered: []String = List[];
    FOR stmt IN mir_nodes DO
      IF TRY (mIRLowering__emit_expr(&self, stmt)) EXISTS AS code THEN
        MUTABLE stripped: String = code.trim();
        IF mIRLowering__zig_statement_semicolon_required?(self, stmt, stripped) THEN
          &rendered.append("${indent}${code};");
        ELSE
          &rendered.append("${indent}${code}");
        END
      END
    END
    RETURN rendered.join("\n");
END
PRIVATE FN mIRLowering__zig_statement_semicolon_required?(self: MIRLowering, stmt: Emittable, stripped: String) RETURNS Bool ->
    RETURN (((emittable__expr?(stmt) AND !(stripped.endsWith?(";"))) AND !(stripped.endsWith?("}"))) AND !(stripped.endsWith?("{")));
END
PUB FN mIRLowering__pipeline_lower_node_with_decl_alloc(MUTABLE self: MIRLowering, node: Locatable, alloc: String@symbol) RETURNS !Emittable ->
    RETURN mIRLowering__with_decl_alloc(&self, alloc, %() USE(node, MUTABLE self) -> {
    rtoc_lambda_result_165 = CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(node))) AS Emittable);
    rtoc_lambda_result_165
    });
END
PUB FN mIRLowering__pipeline_alloc_mark_fact(MUTABLE self: MIRLowering, MUTABLE value: Emittable, name: String, fallback_alloc: String@symbol, type_info: ?Type = NIL, ast_node: ?Locatable = NIL, context: String = "pipeline allocation", known_allocating: Bool = FALSE, accept_owned_call: Bool = FALSE, include_cleanup: Bool = FALSE) RETURNS !?PipelineAllocMarkFact ->
    MUTABLE owns_call_result: Bool = FALSE;
    IF value IS_A Call AS owned_call THEN
