      MUTABLE idx_var = "__soa_idx_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_754 = mIRLowering__lowering_counters(&self);
      mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_for_loop_id(&rtoc_mutable_receiver_754)) }}";
      MUTABLE iter_init = Let{ name: COPY idx_var, init: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: COPY TRY (type__new(TypeConstructionInput{ StringValue: COPY "i64" })), suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL };
      value_bind = Let{ name: COPY var, init: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: COPY coll, method: "get", args: [CAST(MIRCast{ expr: Emittable{ Ident: COPY Ident{ name: COPY idx_var, lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: "usize", method: :intCast, lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(1)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL };
      MUTABLE cond = MIRBinOp{ op: "<", left: Emittable{ Ident: COPY Ident{ name: COPY idx_var, lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: COPY coll, method: "length", args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL };
      MUTABLE update = Set{ target: Emittable{ Ident: COPY Ident{ name: COPY idx_var, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ MIRBinOp: COPY MIRBinOp{ op: "+", left: Emittable{ Ident: COPY Ident{ name: COPY idx_var, lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Lit: COPY Lit{ value: "1", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
      loop_stmt = Emittable{ ScopeBlock: COPY ScopeBlock{ body: COPY [Emittable{ Let: COPY iter_init }, Emittable{ WhileStmt: COPY WhileStmt{ cond: Emittable{ MIRBinOp: COPY cond }, body: COPY ([Emittable{ Let: COPY value_bind }] + body), capture: NIL, update: Emittable{ Set: COPY update }, mark_per_iter: mark_per_iter, tight: tight, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    ELSE_IF type__set_collection?(ct) THEN
      MUTABLE for_id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_756 = mIRLowering__lowering_counters(&self);
      mIRLoweringCounters__next_for_loop_id(&rtoc_mutable_receiver_756) };
      MUTABLE iter_var = "__kit_${mIRLoweringGeneratedId__to_s(for_id)}";
      MUTABLE ptr_var = "__kptr_${mIRLoweringGeneratedId__to_s(for_id)}";
      iter_init = Let{ name: COPY iter_var, init: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: COPY coll, method: "keyIterator", args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, mutable: TRUE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL };
      MUTABLE deref = Let{ name: COPY var, init: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: COPY ptr_var, lowered_node_id: NIL, ownership_consumption: NIL } }, field: "*", lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL };
      full_body = ([Emittable{ Let: COPY deref }, Emittable{ Suppress: COPY Suppress{ name: COPY var, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] + body);
      MUTABLE while_stmt = WhileStmt{ cond: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: COPY iter_var, lowered_node_id: NIL, ownership_consumption: NIL } }, method: "next", args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, body: COPY full_body, capture: COPY ptr_var, update: NIL, mark_per_iter: mark_per_iter, tight: tight, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
      loop_stmt = Emittable{ ScopeBlock: COPY ScopeBlock{ body: COPY [Emittable{ Let: COPY iter_init }, Emittable{ WhileStmt: COPY while_stmt }], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    ELSE
      MUTABLE is_param = (node.collection IS_A Identifier AND mIRLowering__current_function_param_name?(&self, UNWRAP (locatable__name(node.collection))));
      MUTABLE is_field_access = node.collection IS_A GetField;
      MUTABLE is_arraylist = (((((type__list_collection?(ct) OR ((type__array?(ct) AND type__dynamic?(ct))))) AND !(TRY (type__string?(ct)))) AND !(is_param)) AND !(((is_field_access AND type__slice_shaped_field_array?(ct)))));
      MUTABLE iter =     IF is_arraylist THEN
        ListItems{ list: COPY coll, lowered_node_id: NIL, ownership_consumption: NIL }
      ELSE_IF is_field_access THEN
        coll
      ELSE_IF is_param THEN
        ItemsAccess{ expr: COPY coll, safe: TRUE, lowered_node_id: NIL, ownership_consumption: NIL }
      ELSE
        AddressOf{ expr: COPY coll, lowered_node_id: NIL, ownership_consumption: NIL }
      END;
      MUTABLE capture: String = "";
      IF plan.mutable THEN
        MUTABLE elem: ?Type = TRY (type__element_type(ct));
        MUTABLE elem_sym: ?String@symbol = (IF elem != NIL THEN
          type__resolved(elem)
        ELSE
          NIL
        END);
        IF (((elem_sym != NIL) AND (TRY (mIRLowering__struct_schemas(&self))).contains?(elem_sym))) THEN
          capture = "*${var}";
        ELSE
          capture = var;
        END
      ELSE
        capture = var;
      END
      IF !(TRY (mIRLowering__mir_references_identifier?(self, Root{ ArrayValue: COPY body }, var))) THEN
        capture = "_";
      END
      loop_stmt = Emittable{ ForStmt: COPY ForStmt{ iter: COPY iter, capture: COPY capture, body: body, index_capture: NIL, mark_per_iter: UNWRAP (mark_per_iter), tight: tight, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
    RETURN UNWRAP (loop_stmt);
END
PRIVATE FN mIRLowering__mir_references_identifier?(self: MIRLowering, root: Root, name: String) RETURNS !Bool ->
    MUTABLE found: Bool = FALSE;
    TRY (mIR__each_node(castRootToNodeRoot(root), %(candidate: Emittable) USE(name) -> {
    IF (IF candidate IS_A Ident AS ident THEN (ident.name == name) ELSE FALSE END) THEN
        found = TRUE;
    END
    rubyToClearVoid__mir_lowering()
    }));
    RETURN found;
END
PRIVATE FN mIRLowering__for_each_owned_collection_source?(MUTABLE self: MIRLowering, MUTABLE mir: Emittable) RETURNS !Bool
  EFFECTS REENTRANT ->
    IF ((mir IS_A MIRCast OR mir IS_A TryExpr) OR mir IS_A TryOptional) THEN
      RETURN mIRLowering__for_each_owned_collection_source?(&self, UNWRAP (emittable__expr(mir)));
    END
    IF (IF mir IS_A Call AS call THEN call__owned_return?(call) ELSE FALSE END) THEN
      RETURN TRUE;
    END
    RETURN TRY (mIRLowering__mir_allocates?(&self, mir));
END
PRIVATE FN mIRLowering__for_each_owned_collection_source_alloc(MUTABLE self: MIRLowering, mir: Emittable, type_info: Type) RETURNS !String@symbol
  EFFECTS REENTRANT ->
    IF ((mir IS_A MIRCast OR mir IS_A TryExpr) OR mir IS_A TryOptional) THEN
      RETURN mIRLowering__for_each_owned_collection_source_alloc(&self, UNWRAP (emittable__expr(mir)), type_info);
    END
    IF (IF mir IS_A Call AS call THEN call__owned_return?(call) ELSE FALSE END) THEN
      RETURN :heap;
    END
    MUTABLE owned_alloc: ?String@symbol = TRY (mIRLowering__mir_owned_alloc(&self, mir));
    IF owned_alloc EXISTS AS owned_alloc_value THEN
      RETURN owned_alloc_value;
    END
    RETURN TRY (type__cleanup_allocator(type_info, mIRLowering__mir_schema_lookup(&self)));
END
PRIVATE FN mIRLowering__lower_for_range(MUTABLE self: MIRLowering, node: ForRange) RETURNS !ScopeBlock ->
    MUTABLE plan = TRY (mIRLowering__for_range_plan(&self, node));
    MUTABLE var_decl = Let{ name: COPY plan.var, init: Emittable{ Ident: COPY Ident{ name: COPY plan.iter_var, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: FALSE, annotation: COPY TRY (type__new(TypeConstructionInput{ StringValue: COPY "i64" })), suppression: "_ = &${plan.var};", alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL };
    MUTABLE body = TRY (mIRLowering__prepend_loop_mark(&self, plan.body, plan.mark_per_iter, plan.tight, [Emittable{ Let: COPY var_decl }]));
    IF ((!(plan.tight) AND mIRLowering__current_function_has_rt?(&self)) AND !(mIRLowering__loop_body_exits?(self, body))) THEN
      &body.append(Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY plan.rt }, method: "checkYield", args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    END
    MUTABLE update = Set{ target: Emittable{ Ident: COPY Ident{ name: COPY plan.iter_var, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ MIRBinOp: COPY MIRBinOp{ op: "+", left: Emittable{ Ident: COPY Ident{ name: COPY plan.iter_var, lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Lit: COPY Lit{ value: "1", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    MUTABLE cond = MIRBinOp{ op: COPY plan.comparison, left: Emittable{ Ident: COPY Ident{ name: COPY plan.iter_var, lowered_node_id: NIL, ownership_consumption: NIL } }, right: COPY plan.end_value, lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE iter_init = Let{ name: COPY plan.iter_var, init: COPY plan.start_value, mutable: TRUE, annotation: COPY TRY (type__new(TypeConstructionInput{ StringValue: COPY "i64" })), suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL };
    MUTABLE while_stmt = WhileStmt{ cond: Emittable{ MIRBinOp: COPY cond }, body: body, capture: NIL, update: Emittable{ Set: COPY update }, mark_per_iter: plan.mark_per_iter, tight: plan.tight, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    RETURN ScopeBlock{ body: COPY [Emittable{ Let: COPY iter_init }, Emittable{ WhileStmt: COPY while_stmt }], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN mIRLowering__for_range_plan(MUTABLE self: MIRLowering, node: ForRange) RETURNS !ForRangePlan ->
    MUTABLE start_val: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(node.start_expr)));
    MUTABLE end_val: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(node.end_expr)));
    MUTABLE var = mIRLowering__zig_safe_name(self, node.var_name);
    MUTABLE body = TRY (mIRLowering__lower_body(&self, castLocatableListToMIRLoweringLowerableStmtList(node.body)));
    TRY (mIRLowering__finalize_loop_frame_alloc_scopes_mut(&self, body, node.mark_per_iter));
    MUTABLE rt = Ident{ name: mIRLowering__runtime_binding_name(&self), lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE cmp: String = "";
    IF node.inclusive THEN
      cmp = "<=";
    ELSE
      cmp = "<";
    END
    MUTABLE iter_var = "__for_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_760 = mIRLowering__lowering_counters(&self);
    mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_for_loop_id(&rtoc_mutable_receiver_760)) }}";
    RETURN ForRangePlan{ var: COPY var, start_value: UNWRAP (COPY start_val), end_value: UNWRAP (COPY end_val), body: COPY body, rt: COPY rt, comparison: COPY cmp, iter_var: COPY iter_var, mark_per_iter: IF (node.mark_per_iter == TRUE) THEN
      TRUE
    ELSE
      NIL
    END, tight: node.tight };
END
PRIVATE FN mIRLowering__lower_match(MUTABLE self: MIRLowering, node: MatchStatement) RETURNS !Emittable ->
    MUTABLE result: ?SwitchStmt = NIL;
    MUTABLE facts = TRY (mIRLowering__match_lowering_facts(&self, node));
    MUTABLE expr_label: ?String = COPY facts.expr_label;
    MUTABLE subject = COPY facts.subject;
    MUTABLE is_union = facts.is_union;
    IF (facts.is_int_match OR facts.is_enum_match) THEN
      result = TRY (mIRLowering__lower_switch_match(&self, node, facts));
    ELSE_IF (is_union AND mIRLowering__union_match_switchable?(self, node)) THEN
      result = TRY (mIRLowering__lower_union_match(&self, node, facts));
    ELSE
      result = TRY (mIRLowering__lower_if_chain_match(&self, node, facts));
    END
    IF expr_label EXISTS AS expr_label_value THEN
      RETURN Emittable{ MIRBlockExpr: COPY MIRBlockExpr{ label: COPY expr_label_value, body: COPY [Emittable{ Set: COPY result }], lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL } };
    ELSE
      RETURN result;
    END
END
PRIVATE FN mIRLowering__lower_if_chain_match(MUTABLE self: MIRLowering, node: MatchStatement, facts: MatchLoweringFacts) RETURNS !IfChain ->
    MUTABLE branches = node.cases |> UNNEST TRY (mIRLowering__if_chain_match_case_branches(&self, node, _, facts));
    RETURN IfChain{ branches: COPY branches, default_body: TRY (mIRLowering__lower_match_default_body(&self, node.default_case, facts.expr_label)), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN mIRLowering__if_chain_match_case_branches(MUTABLE self: MIRLowering, node: MatchStatement, match_case: MatchCase, facts: MatchLoweringFacts) RETURNS ![]IfChainBranch ->
    MUTABLE body = TRY (mIRLowering__hoisted_match_case_body(&self, match_case, facts.expr_label));
    IF (match_case.kind == :when) THEN
      RETURN CAST([mIRLowering__if_chain_branch(self, CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(match_case.value))) AS Emittable), body)] AS []IfChainBranch);
    END
    IF facts.is_union THEN
      RETURN TRY (mIRLowering__union_if_chain_match_case(&self, node, match_case, facts.subject, body));
    END
    RETURN TRY (mIRLowering__value_if_chain_match_case(&self, node, match_case, facts.subject, body));
END
PRIVATE FN mIRLowering__hoisted_match_case_body(MUTABLE self: MIRLowering, match_case: MatchCase, expr_label: ?String) RETURNS ![]Emittable ->
    MUTABLE body = TRY (mIRLowering__lower_match_branch(&self, match_case.body, expr_label));
    RETURN TRY (mIRLowering__hoist_unhoisted_return_allocs(&self, body, match_case.body));
END
PRIVATE FN mIRLowering__if_chain_branch(self: MIRLowering, cond: Emittable, body: []Emittable) RETURNS IfChainBranch ->
    RETURN IfChainBranch{ cond: COPY cond, body: COPY body };
END
PRIVATE FN mIRLowering__union_if_chain_match_case(MUTABLE self: MIRLowering, node: MatchStatement, match_case: MatchCase, subject: Emittable, body: []Emittable) RETURNS ![]IfChainBranch ->
    MUTABLE variants = TRY (mIRLowering__union_match_case_variants( CAST(Locatable{ MatchStatement: CAST(COPY self AS MatchStatement)} AS MIRLowering), match_case));
    MUTABLE is_mutable = (locatable__expr(Locatable{ MatchStatement: COPY node }) IS_A Identifier AND (locatable__expr( Locatable{ MatchStatement: COPY node }).was_moved == TRUE));
    MUTABLE has_payload_binding = !(!(((IF match_case.binding != NIL THEN match_case.binding ELSE match_case.destructure END))));
    IF (has_payload_binding AND (variants.length() > 1)) THEN
      RETURN variants |> SELECT mIRLowering__if_chain_branch(self, Emittable{ MIRBinOp: COPY TRY (mIRLowering__union_tag_condition(&self, subject, _)) }, (TRY (mIRLowering__union_if_chain_payload_bindings(&self, match_case, subject, _, is_mutable)) + COPY body));
    END
    MUTABLE branch_body: []Emittable = List[];
    IF has_payload_binding THEN
      branch_body = (TRY (mIRLowering__union_if_chain_payload_bindings(&self, match_case, subject, (variants.first() OR_ELSE ""), is_mutable)) + body);
    ELSE
      branch_body = COPY body;
    END
    RETURN CAST([mIRLowering__if_chain_branch(self, mIRLowering__disjoin_match_conditions(self, variants |> SELECT TRY (mIRLowering__union_tag_condition(&self, subject, _))), branch_body)] AS []IfChainBranch);
END
PRIVATE FN mIRLowering__union_if_chain_payload_bindings(MUTABLE self: MIRLowering, match_case: MatchCase, subject: Emittable, variant: String, is_mutable: Bool) RETURNS ![]Emittable ->
    MUTABLE payload: Emittable = Emittable{ UnionPayloadGet: COPY UnionPayloadGet{ subject: COPY subject, variant: COPY variant, lowered_node_id: NIL, ownership_consumption: NIL } };
    IF match_case.indirect_payload_as THEN
      payload = Emittable{ Deref: COPY Deref{ expr: COPY payload, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF match_case.binding EXISTS AS binding_value THEN
      MUTABLE safe_binding = TRY (mIRLowering__payload_binding_name(&self, binding_value, CAST(match_case AS ?Locatable), NIL));
      RETURN CAST([Emittable{ Let: COPY Let{ name: COPY safe_binding, init: COPY payload, mutable: is_mutable, annotation: NIL, suppression: "_ = &${safe_binding};", alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }] AS []Emittable);
    END
    MUTABLE destructure: ?StructPattern = COPY match_case.destructure;
    IF destructure EXISTS AS destructure_value THEN
      RETURN destructure_value.fields |> SELECT:? (IF patternField__wildcard?(_) THEN NIL ELSE (IF !(patternField__bind?(_)) THEN NIL ELSE Let{ name: COPY _.name, init: Emittable{ FieldGet: COPY FieldGet{ object: COPY payload, field: COPY _.name, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: FALSE, annotation: NIL, suppression: "_ = &${_.name};", alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } END) END) |> WHERE _ != NIL;
    ELSE
      RETURN CAST(List[] AS []Emittable);
    END
END
PRIVATE FN mIRLowering__union_tag_condition(MUTABLE self: MIRLowering, subject: Emittable, variant: String) RETURNS !MIRBinOp ->
    RETURN MIRBinOp{ op: "==", left: Emittable{ Call: COPY TRY (mIRLowering__active_tag_call(&self, subject)) }, right: Emittable{ EnumTag: COPY EnumTag{ variant: COPY variant } }, lowered_node_id: NIL, ownership_consumption: NIL };
END
PRIVATE FN mIRLowering__value_if_chain_match_case(MUTABLE self: MIRLowering, node: MatchStatement, match_case: MatchCase, subject: Emittable, body: []Emittable) RETURNS ![]IfChainBranch ->
    IF node.string_match THEN
      RETURN CAST([mIRLowering__if_chain_branch(self, TRY (mIRLowering__string_match_condition(&self, subject, match_case)), body)] AS []IfChainBranch);
    END
    IF (match_case.kind == :struct_pattern) THEN
      MUTABLE pattern: StructPattern = COPY CAST(match_case.value AS StructPattern);
      MUTABLE subject_ident: Ident = COPY castEmittableToIdent(subject);
      MUTABLE cond_parts, bind_stmts = TRY (mIRLowering__lower_struct_pattern(&self, subject_ident, pattern));
      MUTABLE branch_body = (bind_stmts + body);
      RETURN CAST([mIRLowering__if_chain_branch(self, mIRLowering__conjoin_match_conditions(self, cond_parts), CAST(branch_body AS []Emittable))] AS []IfChainBranch);
    END
    RETURN CAST([mIRLowering__if_chain_branch(self, TRY (mIRLowering__equality_match_condition(&self, subject, match_case)), body)] AS []IfChainBranch);
END
PRIVATE FN mIRLowering__string_match_condition(MUTABLE self: MIRLowering, subject: Emittable, match_case: MatchCase) RETURNS !Emittable ->
    MUTABLE conditions: []Emittable = List[];
    MUTABLE rtoc_case_values: []Locatable = ([match_case.value] + match_case.extra_values);
    FOR MUTABLE rtoc_case_value IN rtoc_case_values DO
      &conditions.append(TRY (mIRLowering__emit_builtin(&self, :strEql, [subject, UNWRAP (TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(rtoc_case_value))))])));
    END
    RETURN mIRLowering__disjoin_match_conditions(self, conditions);
END
PRIVATE FN mIRLowering__equality_match_condition(MUTABLE self: MIRLowering, subject: Emittable, match_case: MatchCase) RETURNS !Emittable ->
    MUTABLE conditions: []Emittable = List[];
    MUTABLE rtoc_case_values: []Locatable = ([match_case.value] + match_case.extra_values);
    FOR MUTABLE rtoc_case_value IN rtoc_case_values DO
      &conditions.append(Emittable{ MIRBinOp: COPY MIRBinOp{ op: "==", left: COPY subject, right: COPY UNWRAP (TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(rtoc_case_value)))), lowered_node_id: NIL, ownership_consumption: NIL } });
    END
    RETURN mIRLowering__disjoin_match_conditions(self, conditions);
END
PRIVATE FN mIRLowering__disjoin_match_conditions(self: MIRLowering, conditions: []Emittable) RETURNS Emittable ->
    RETURN ((conditions |> REDUCE(0) MIRBinOp{ op: "or", left: CAST(COPY acc AS Emittable), right: COPY _, lowered_node_id: NIL, ownership_consumption: NIL }) OR Lit{ value: "false", lowered_node_id: NIL, ownership_consumption: NIL });
END
PRIVATE FN mIRLowering__conjoin_match_conditions(self: MIRLowering, conditions: []Emittable) RETURNS Emittable ->
    RETURN ((conditions |> REDUCE(0) MIRBinOp{ op: "and", left: CAST(COPY acc AS Emittable), right: COPY _, lowered_node_id: NIL, ownership_consumption: NIL }) OR Lit{ value: "true", lowered_node_id: NIL, ownership_consumption: NIL });
END
PRIVATE FN mIRLowering__lower_match_default_body(MUTABLE self: MIRLowering, default_case: ?[]Locatable, expr_label: ?String) RETURNS !?[]Emittable ->
    IF default_case EXISTS AS default_case_value THEN
      MUTABLE default_case_value_mutable = COPY default_case_value;
      IF !(default_case_value_mutable.empty?()) THEN
        MUTABLE body = TRY (mIRLowering__lower_match_branch(&self, default_case_value_mutable, expr_label));
        RETURN TRY (mIRLowering__hoist_unhoisted_return_allocs(&self, body, default_case_value_mutable));
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
END
PRIVATE FN mIRLowering__union_match_switchable?(self: MIRLowering, node: MatchStatement) RETURNS Bool ->
    RETURN node.cases |> ALL (matchCase__kind(_) == :eq);
END
PRIVATE FN mIRLowering__match_lowering_facts(MUTABLE self: MIRLowering, node: MatchStatement) RETURNS !MatchLoweringFacts ->
    MUTABLE match_ident: ?Identifier = NIL;
    MUTABLE expr_label: String = "";
    IF node.expr_mode THEN
      expr_label = "__match_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_762 = mIRLowering__lowering_counters(&self);
      mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_block_expr_id(&rtoc_mutable_receiver_762)) }}";
    ELSE
      expr_label = "";
    END
    MUTABLE subject: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(node.expr)));
    MUTABLE union_lookup = TRY (mIRLowering__match_union_lookup(self, node.expr));
    MUTABLE is_union = (TRY (mIRLowering__union_schemas(&self))).contains?(union_lookup);
    IF node.expr IS_A Identifier THEN
      match_ident = COPY castLocatableToOptionalIdentifier__mir_lowering(node.expr);
    END
    IF ((is_union AND (match_ident != NIL)) AND mIRLowering__capability_state(&self).if_bind_pointer_aliases.contains?(match_ident.name)) THEN
      subject = Deref{ expr: Emittable{ Deref: CAST(COPY subject AS Deref)}, lowered_node_id: NIL, ownership_consumption: NIL };
    END
    MUTABLE expr_type = locatable__expr( Locatable{ MatchStatement: COPY node }).resolved_type;
    MUTABLE expr_type_sym = IF expr_type IS_A Type THEN
      type__resolved(expr_type)
    ELSE
      expr_type
    END;
    MUTABLE is_int_match = !(!(((((!(is_union) AND !(node.string_match)) AND ((((((expr_type == :Int64) OR (expr_type == :Int32)) OR (expr_type == :Int16)) OR (expr_type == :Int8)) OR ((expr_type IS_A Type AND type__integer?(expr_type)))))) AND (node.cases |> ALL (((matchCase__kind(_) != :when) AND (matchCase__kind(_) != :struct_pattern)) AND (([matchCase__value(_)] + (matchCase__extra_values(_))) |> ALL (_ IS_A Literal AND (((_.type() == :INT64) OR (_.type() == :NUMBER)))))))))));
    MUTABLE is_enum_match = !(!((((((!(is_union) AND !(node.string_match)) AND expr_type_sym) AND (TRY (mIRLowering__enum_schemas(&self))).contains?(expr_type_sym)) AND (node.cases |> ALL (((matchCase__kind(_) != :when) AND (matchCase__kind(_) != :struct_pattern)) AND (([matchCase__value(_)] + (matchCase__extra_values(_))) |> ALL _ IS_A GetField)))))));
    RETURN MatchLoweringFacts{ expr_label: COPY expr_label, subject: Emittable{ Deref: CAST(COPY subject AS Deref)}, is_union: is_union, is_int_match: is_int_match, is_enum_match: is_enum_match, expr_type_sym: COPY CAST(IF is_union THEN
      union_lookup
    ELSE
      expr_type_sym
    END AS String@symbol) };
END
PRIVATE FN mIRLowering__match_union_lookup(self: MIRLowering, expression: Locatable) RETURNS !String@symbol ->
    MUTABLE type = TRY (type__new( TypeConstructionInput{ SymbolValue: COPY (locatable__resolved_type(expression) OR_ELSE :Any) }));
    # `?Shape` names the same union as `Shape`. The annotator binds arm
    # payloads through the optional, so the lowering has to agree -- a mismatch
    # here drops the binding and emits Zig that reads an undeclared name.
    type = TRY (type__non_optional_type(type));
    IF type__generic_instance?(type) THEN
      RETURN type__generic_base(type);
    END
    RETURN type__resolved(type);
END
PRIVATE FN mIRLowering__lower_match_branch(MUTABLE self: MIRLowering, stmts: []Locatable, expr_label: ?String) RETURNS ![]Emittable ->
    IF expr_label EXISTS AS expr_label_value THEN
      RETURN TRY (mIRLowering__lower_body_with_break(&self, castLocatableListToMIRLoweringLowerableStmtList(stmts), expr_label_value));
    ELSE
      RETURN TRY (mIRLowering__lower_body(&self, castLocatableListToMIRLoweringLowerableStmtList(stmts)));
    END
END
PRIVATE FN mIRLowering__lower_union_match(MUTABLE self: MIRLowering, node: MatchStatement, facts: MatchLoweringFacts) RETURNS !UnionMatchStmt ->
    MUTABLE arms = node.cases |> UNNEST TRY (mIRLowering__union_match_arm_plans(&self, _, node, facts.expr_label));
    MUTABLE default: ?[]Emittable = TRY (mIRLowering__union_match_default_body(&self, node, facts, arms));
    IF default EXISTS AS default_value THEN
      MUTABLE default_value = TRY (mIRLowering__hoist_unhoisted_return_allocs(&self, default_value, (node.default_case OR_ELSE List[])));
    END
    RETURN UnionMatchStmt{ subject: COPY facts.subject, arms: arms |> SELECT UnionMatchArm{ variant: COPY _.variant, payload: COPY _.payload_name, body: COPY _.body, pointer_payload: _.pointer_payload }, default_body: default, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN mIRLowering__union_match_default_body(MUTABLE self: MIRLowering, node: MatchStatement, facts: MatchLoweringFacts, arms: []UnionMatchArmPlan) RETURNS !?[]Emittable ->
    MUTABLE schema: ?UnionSchema@multiowned = COPY (TRY (mIRLowering__union_schemas(&self)))[facts.expr_type_sym];
    MUTABLE all_variants: []Any = List[];
    IF (IF schema?.variants != NIL THEN
      (schema?.variants).keys() |> SELECT _.toString()
    ELSE
      NIL
    END) != NIL THEN
      all_variants = COPY (((IF schema?.variants != NIL THEN
      (schema?.variants).keys() |> SELECT _.toString()
    ELSE
      NIL
    END))) |> ORDER_BY _;
    END
    MUTABLE covered = (arms |> SELECT _.variant) |> SELECT _.toString() |> ORDER_BY _;
    IF (covered == all_variants) THEN
      RETURN NIL;
    END
    IF ((node.default_case != NIL) AND !(((node.default_case)?).empty?())) THEN
      RETURN TRY (mIRLowering__lower_match_branch(&self, (node.default_case)?, facts.expr_label));
    END
    RETURN CAST(List[] AS []Emittable);
END
PRIVATE FN mIRLowering__union_match_arm_plans(MUTABLE self: MIRLowering, c: MatchCase, node: MatchStatement, expr_label: ?String) RETURNS ![]UnionMatchArmPlan ->
    MUTABLE variants = TRY (mIRLowering__union_match_case_variants(self, c));
    MUTABLE body = TRY (mIRLowering__lower_match_branch(&self, c.body, expr_label));
    body = TRY (mIRLowering__hoist_unhoisted_return_allocs(&self, body, c.body));
    IF !((IF c.binding != NIL THEN c.binding ELSE c.destructure END)) THEN
      RETURN variants |> SELECT UnionMatchArmPlan{ variant: COPY _, body: COPY body, payload_name: NIL, pointer_payload: FALSE };
    END
    RETURN variants |> SELECT {
    MUTABLE payload_name = "__match_payload_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_763 = mIRLowering__lowering_counters(&self);
    mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_763)) }}";
    MUTABLE arm_body = (TRY (mIRLowering__union_match_payload_bindings(&self, c, payload_name, node)) + COPY body);
    UnionMatchArmPlan{ variant: COPY _, body: COPY arm_body, payload_name: COPY payload_name, pointer_payload: (c.binding_mutable == TRUE) }
    };
END
PRIVATE FN mIRLowering__union_match_case_variants(self: MIRLowering, c: MatchCase) RETURNS ![]String ->
    RETURN ([c.value] + (c.extra_values)) |> SELECT:? TRY (mIRLowering__union_match_variant_name(self, _)) |> WHERE _ != NIL;
END
PRIVATE FN mIRLowering__union_match_variant_name(self: MIRLowering, value: Locatable) RETURNS !String ->
    IF value IS_A GetField AS get_field THEN
      RETURN COPY CAST(get_field.field AS String);
    ELSE_IF (value IS_A MethodCall) OR (value IS_A Identifier) THEN
      RETURN COPY CAST(locatable__name(value) AS String);
    ELSE
      panic("union MATCH variant must be a named variant, got {}");
    END
END
PRIVATE FN mIRLowering__union_match_payload_bindings(MUTABLE self: MIRLowering, c: MatchCase, payload_name: String, node: MatchStatement) RETURNS ![]Emittable ->
    MUTABLE is_mutable = (((UNWRAP (locatable__expr(Locatable{ MatchStatement: COPY node })) IS_A Identifier AND (locatable__was_moved(UNWRAP (locatable__expr( Locatable{ MatchStatement: COPY node }))) == TRUE))) OR (c.binding_mutable == TRUE));
    MUTABLE payload = Ident{ name: COPY payload_name, lowered_node_id: NIL, ownership_consumption: NIL };
    IF c.indirect_payload_as THEN
      payload = Deref{ expr: Emittable{ Ident: COPY payload }, lowered_node_id: NIL, ownership_consumption: NIL };
    END
    IF c.binding EXISTS AS binding_value THEN
      MUTABLE binding = COPY binding_value;
      RETURN CAST([Emittable{ Let: COPY Let{ name: COPY binding, init: Emittable{ Ident: COPY payload }, mutable: is_mutable, annotation: NIL, suppression: "_ = &${binding};", alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }] AS []Emittable);
    END
    MUTABLE destructure: ?StructPattern = COPY c.destructure;
    IF destructure EXISTS AS destructure_value THEN
      RETURN destructure_value.fields |> SELECT:? (IF patternField__wildcard?(_) THEN NIL ELSE (IF !(patternField__bind?(_)) THEN NIL ELSE Let{ name: COPY _.name, init: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY payload }, field: COPY _.name, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: FALSE, annotation: NIL, suppression: "_ = &${_.name};", alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } END) END) |> WHERE _ != NIL;
    ELSE
      RETURN CAST(List[] AS []Emittable);
    END
END
PRIVATE FN mIRLowering__lower_switch_match(MUTABLE self: MIRLowering, node: MatchStatement, facts: MatchLoweringFacts) RETURNS !SwitchStmt ->
    MUTABLE arms = node.cases |> SELECT {
    MUTABLE body = TRY (mIRLowering__lower_match_branch(&self, TRY (matchCase__body(_)), facts.expr_label));
    MUTABLE patterns: []SwitchPattern = [TRY (mIRLowering__switch_match_pattern(&self, matchCase__value(_), facts.is_enum_match))];
    FOR _ IN (matchCase__extra_values(_)) DO
    &patterns.append(TRY (mIRLowering__switch_match_pattern(&self, _, facts.is_enum_match)));
    END
    SwitchArm{ patterns: COPY patterns, body: COPY body }
    };
    MUTABLE default_branch_value: ?[]Emittable = NIL;
    IF (((node.default_case != NIL) AND !(((node.default_case)?).empty?()))) THEN
      default_branch_value = TRY (mIRLowering__lower_match_branch(&self, (node.default_case OR_ELSE List[]), facts.expr_label));
    ELSE
      default_branch_value = NIL;
    END
    MUTABLE default: ?[]Emittable = default_branch_value;
    IF facts.is_int_match THEN
      default = (default OR_ELSE List[]);
    END
    IF facts.is_enum_match THEN
      MUTABLE all_variants: []Any = List[];
      IF (IF (TRY (mIRLowering__enum_schemas(&self)))[facts.expr_type_sym] != NIL THEN
        ((TRY (mIRLowering__enum_schemas(&self)))[facts.expr_type_sym]) |> SELECT _.toString()
      ELSE
        NIL
      END) != NIL THEN
        all_variants = COPY (((IF (TRY (mIRLowering__enum_schemas(&self)))[facts.expr_type_sym] != NIL THEN
        ((TRY (mIRLowering__enum_schemas(&self)))[facts.expr_type_sym]) |> SELECT _.toString()
      ELSE
        NIL
      END))) |> ORDER_BY _;
      END
      MUTABLE covered = (node.cases |> UNNEST {
    MUTABLE value: GetField = CAST(matchCase__value(_) AS GetField);
    MUTABLE extras = matchCase__extra_values(_) |> SELECT CAST(castLocatableToGetField__mir_lowering(_).field AS String);
    ([CAST(value.field AS String)] + extras)
      }) |> ORDER_BY _;
      MUTABLE exhaustive = (covered == all_variants);
      IF ((default != NIL) AND exhaustive) THEN
        default = NIL;
      END
      IF (!(NIL) AND !(exhaustive)) THEN
        default = List[];
      END
    END
    RETURN SwitchStmt{ subject: COPY facts.subject, arms: COPY arms, default_body: default, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN mIRLowering__switch_match_pattern(MUTABLE self: MIRLowering, value: Locatable, is_enum_match: Bool) RETURNS !SwitchPattern ->
    IF is_enum_match THEN
      RETURN SwitchPattern{ EnumSwitchPattern: COPY EnumSwitchPattern{ variant: COPY CAST(castLocatableToGetField__mir_lowering(value).field AS String) } };
    END
    RETURN TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(value)));
END
PRIVATE FN mIRLowering__hoist_unhoisted_return_allocs(MUTABLE self: MIRLowering, body: []Emittable, ast_stmts: []Locatable) RETURNS ![]Emittable ->
    MUTABLE returns: []Locatable = List[];
    FOR _ IN ast_stmts DO
    IF (IF _ IS_A ReturnNode AS return_node THEN return_node.value ELSE FALSE END) THEN
      &returns.append(aST__node_value(_));
    END
    END
    MUTABLE ret_i: Int64 = 0;
    RETURN body |> UNNEST {
    IF !(((IF _ IS_A ReturnStmt AS return_stmt THEN emittable__value(Emittable{ ReturnStmt: COPY return_stmt }) ELSE FALSE END) AND TRY (mIRLowering__mir_allocates?(&self, emittable__value( Emittable{ ReturnStmt: COPY _ }))))) THEN
        IF _ IS_A ReturnStmt AS return_stmt THEN
          ret_i = (ret_i + 1);
        END
        CONTINUE;
    END
    MUTABLE ast_value: ?Locatable = COPY returns[ret_i];
    ret_i = (ret_i + 1);
    MUTABLE name = "__tmp_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_766 = mIRLowering__lowering_counters(&self);
    mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_766)) }}";
    MUTABLE return_value = _.value;
    MUTABLE entry: ?CleanupEntry@multiowned = TRY (mIRLowering__hoist_cleanup_entry(&self, return_value, ast_value));
    MUTABLE materialized = BindingMaterialization{ name: COPY name, expr: COPY return_value, alloc: :heap, type_info: CAST(COPY TRY (mIRLowering__mir_alloc_mark_type_info(&self, return_value, ast_value, "unhoisted return allocation")) AS Type), mutable: FALSE, cleanup_entry: entry, cleanup_mode: IF entry != NIL THEN
        :err
      ELSE
        :normal
      END, scope: :heap, annotation: NIL, suppression: NIL, ownership_tracked: TRUE };
    MUTABLE out: []Emittable = TRY (bindingMaterialization__statements(materialized));
    IF entry EXISTS AS entry_value THEN
        MUTABLE plan = mIRLowering__synthetic_return_ownership_plan(&self, name);
        out = ruby_array_concat_Stmt(out, TRY (returnOwnershipPlan__transfer_marks_for(plan, [name] |> DISTINCT _, mIRLowering__function_state(&self).lowered_guarded_cleanup_names)));
    END
    &out.append(CAST(ReturnStmt{ value: Emittable{ Ident: COPY Ident{ name: COPY name, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable));
    out
    };
END
PRIVATE FN mIRLowering__lower_return(MUTABLE self: MIRLowering, MUTABLE node: ReturnNode) RETURNS !NodeRoot ->
    MUTABLE plan = TRY (mIRLowering__return_lowering_plan(&self, &node));
    MUTABLE value: ?Emittable = TRY (mIRLowering__finalize_return_value(&self, node, plan.value));
    IF ((value != NIL) AND hoist__noreturn_value?(node.value)) THEN
      RETURN NodeRoot{ Emittable: COPY value };
    END
    IF (UNWRAP (value)) IS_A Call AS tail_call_value THEN
    IF mIRLowering__tail_call_return?(&self, Emittable{ Call: COPY tail_call_value }) THEN
      RETURN NodeRoot{ Emittable: COPY CAST(ReturnStmt{ value: Emittable{ TailCall: COPY TailCall{ callee: COPY tail_call_value.callee, args: COPY tail_call_value.args, callable_contract: COPY tail_call_value.callable_contract, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) };
    END
    END
    IF (((node.value EXISTS) AND TRY (mIRLowering__rc_retain_needed?(&self, UNWRAP (node.value)))) AND !(TRY (mIRLowering__return_transfers_heap_binding?(&self, UNWRAP (node.value))))) THEN
      MUTABLE retained = TRY (mIRLowering__hoist_alloc(&self, Emittable{ RcRetain: COPY TRY (mIRLowering__make_rc_retain(&self, castLocatableToIdentifier(UNWRAP (node.value)))) }, node.value, TRUE));
      RETURN TRY (mIRLowering__return_with_transfer_marks(&self, plan, &retained, ReturnStmt{ value: COPY retained, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }));
    ELSE
      IF ((value != NIL) AND !(value IS_A Ident)) THEN
        value = TRY (mIRLowering__hoist_alloc(&self, &value, &node.value, TRUE, FALSE, FALSE));
      END
      IF value EXISTS AS value_value THEN
        MUTABLE value_value = TRY (mIRLowering__bind_consuming_call_return_value(&self, value_value));
      END
      RETURN TRY (mIRLowering__return_with_transfer_marks(&self, plan, &value, ReturnStmt{ value: UNWRAP (COPY value), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }));
    END
END
PRIVATE FN mIRLowering__bind_consuming_call_return_value(MUTABLE self: MIRLowering, value: Emittable) RETURNS !Emittable ->
    IF !((value IS_A Call OR value IS_A MIRMethodCall)) THEN
      RETURN COPY value;
    END
    MUTABLE fact: ?OwnershipConsumptionFact = emittable__ownership_consumption(value);
    IF !((fact EXISTS AND !((fact.operands).length() == 0))) THEN
      RETURN COPY value;
    END
    MUTABLE name = "__ret_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_767 = mIRLowering__lowering_counters(&self);
    mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_767)) }}";
    &self.state.function_state.pending_stmts.append(CAST(Let{ name: COPY name, init: COPY value, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } AS Emittable));
    RETURN Emittable{ Ident: COPY Ident{ name: COPY name, lowered_node_id: NIL, ownership_consumption: NIL } };
END
PRIVATE FN mIRLowering__finalize_return_value(MUTABLE self: MIRLowering, node: ReturnNode, value_input: ?Emittable) RETURNS !?Emittable ->
    MUTABLE value:? = COPY value_input;
    value = TRY (mIRLowering__generic_parameter_return_copy(&self, node, value));
    value = TRY (mIRLowering__return_payload_pointer_value(&self, node, value));
    value = TRY (mIRLowering__heap_carry_return_value(&self, node, &value));
    RETURN TRY (mIRLowering__heap_carry_recursive_param_value(&self, node, value));
END
PRIVATE FN mIRLowering__generic_parameter_return_copy(MUTABLE self: MIRLowering, node: ReturnNode, value: ?Emittable) RETURNS !?Emittable ->
    IF !(((node.value EXISTS) AND ((value != NIL) AND (value IS_A Ident)))) THEN
      RETURN COPY value;
    END
    IF !(mIRLowering__current_function_param_name?(&self, UNWRAP (emittable__name( value)))) THEN
      RETURN COPY value;
    END
    IF !(mIRLowering__current_function_has_rt?(&self)) THEN
      RETURN COPY value;
    END
    IF mIRLowering__current_function_takes_param_name?(&self, UNWRAP (emittable__name( value))) THEN
      RETURN COPY value;
    END
    MUTABLE ret_type: ?Type = TRY (type__from_node_mut(node.value, "generic parameter return"));
    IF !(type__generic_type_parameter?( UNWRAP (ret_type))) THEN
      RETURN COPY value;
    END
    RETURN Emittable{ DeepCopy: COPY DeepCopy{ source: COPY value, zig_type: COPY TRY (type__zig_type( UNWRAP (ret_type))), elem_type: NIL, strategy: :full_value, alloc: :heap, copy_shape: deepCopy__copy_shape_for_zig_type(COPY TRY (type__zig_type( UNWRAP (ret_type)))), type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL } };
END
PRIVATE FN mIRLowering__return_payload_pointer_value(MUTABLE self: MIRLowering, node: ReturnNode, value: ?Emittable) RETURNS !?Emittable ->
    MUTABLE payload_zig: ?String = mIRLowering__current_function_return_payload_zig(&self);
    IF !((IF payload_zig != NIL THEN
      payload_zig.startsWith?("*")
    ELSE
      NIL
    END)) THEN
      RETURN COPY value;
    END
    IF value EXISTS AS value_value THEN
      MUTABLE value_value_mutable = COPY value_value;
      IF (value_value_mutable IS_A HeapCreate OR value_value_mutable IS_A Call) THEN
        RETURN COPY value_value_mutable;
      END
      IF TRY (mIRLowering__return_value_already_payload_pointer?(&self, node.value)) THEN
        RETURN COPY value_value_mutable;
      END
      MUTABLE bare_ret = UNWRAP (payload_zig).deletePrefix("*");
      RETURN TRY (mIRLowering__with_ownership_consumption(&self, Emittable{ HeapCreate: COPY HeapCreate{ zig_type: COPY bare_ret, init: COPY value_value_mutable, alloc: :heap, label: "ret", lowered_node_id: NIL, ownership_consumption: NIL } }, TRY (mIRLowering__mir_ident_names(self, value_value_mutable)), "MIR::HeapCreate", :owned_sink, :heap));
    ELSE
      RETURN COPY value;
    END
END
PRIVATE FN mIRLowering__heap_carry_return_value(MUTABLE self: MIRLowering, node: ReturnNode, MUTABLE value: ?Emittable) RETURNS !?Emittable ->
    IF !(((mIRLowering__current_function_heap_carry_return?(&self) AND node.value) AND (value != NIL))) THEN
      RETURN COPY value;
    END
    IF value IS_A Ident AS ident THEN
      RETURN COPY Emittable{ Ident: COPY ident };
    END
    IF TRY (mIRLowering__return_transfers_heap_binding?(&self, UNWRAP (node.value))) THEN
      RETURN COPY value;
    END
    IF (TRY (mIRLowering__mir_allocates?(&self, value)) OR ((IF value IS_A Call AS call THEN call__owned_return?(call) ELSE FALSE END))) THEN
      RETURN COPY value;
    END
    MUTABLE ret_type: ?Type = TRY (type__from_node_mut(node.value, "heap carry return placement"));
    ret_type = TRY (type__success_type( UNWRAP (ret_type)));
    IF (TRY (mIRLowering__escaping_value_alloc(&self, ret_type)) == :heap) THEN
      RETURN TRY (mIRLowering__place_value_for_destination(&self, &value, UNWRAP (node.value), :heap, (IF ret_type EXISTS AS rtoc_wrap_20619 THEN TypeTypeInput{ Type: COPY rtoc_wrap_20619 } ELSE NIL END)));
    ELSE
      RETURN COPY value;
    END
END
PRIVATE FN mIRLowering__heap_carry_recursive_param_value(MUTABLE self: MIRLowering, node: ReturnNode, value: ?Emittable) RETURNS !?Emittable ->
    IF !(((mIRLowering__current_function_heap_carry_return?(&self) AND node.value) AND ((value != NIL) AND (value IS_A Ident)))) THEN
      RETURN COPY value;
    END
    IF !(mIRLowering__current_function_param_name?(&self, UNWRAP (emittable__name( value)))) THEN
      RETURN COPY value;
    END
    IF mIRLowering__current_function_takes_param_name?(&self, UNWRAP (emittable__name( value))) THEN
      RETURN COPY value;
    END
    MUTABLE ret_type: ?Type = TRY (type__from_node_mut(node.value, "heap carry recursive return"));
    ret_type = TRY ( type__success_type(UNWRAP (ret_type)));
    IF TRY (type__recursive_cleanup_shape?(UNWRAP (ret_type), mIRLowering__mir_schema_lookup(&self))) THEN
      RETURN Emittable{ DeepCopy: COPY DeepCopy{ source: COPY value, zig_type: COPY TRY (type__zig_type( UNWRAP (ret_type))), elem_type: NIL, strategy: :full_value, alloc: :heap, copy_shape: deepCopy__copy_shape_for_zig_type(COPY TRY (type__zig_type(UNWRAP (ret_type)))), type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE
      RETURN COPY value;
    END
END
PRIVATE FN mIRLowering__tail_call_return?(MUTABLE self: MIRLowering, value: ?Emittable) RETURNS Bool ->
    RETURN !(!(((((mIRLowering__current_function_tail_call?(&self) AND !(mIRLowering__program_state(self).debug_mode)) AND ((value != NIL) AND (value IS_A Call))) AND (emittable__callee(value) == mIRLowering__current_function_zig_name(&self))))));
END
PRIVATE FN mIRLowering__return_with_transfer_marks(MUTABLE self: MIRLowering, plan: ReturnOwnershipPlan, MUTABLE value: ?Emittable, ret: ReturnStmt) RETURNS !NodeRoot ->
    MUTABLE names = TRY (returnOwnershipPlan__returned_names(plan));
    IF value? IS_A Ident AS ident THEN
      IF names.contains?(CAST(ident.name AS String)) THEN
        names = COPY names;
      ELSE
        names = COPY [CAST(ident.name AS String)] |> DISTINCT _;
      END
    ELSE_IF value THEN
      MUTABLE value_names = TRY (mIRLowering__mir_ident_names(self, value)) |> DISTINCT _;
      IF !(value_names.empty?()) THEN
        names = COPY value_names;
      END
    END
    MUTABLE marks = TRY (returnOwnershipPlan__transfer_marks_for(plan, names, mIRLowering__function_state(&self).lowered_guarded_cleanup_names));
    IF ((IF value? IS_A Ident AS ident THEN (marks.length() == 0) ELSE FALSE END) AND mIRLowering__returned_hoist_binding?(&self, CAST(emittable__name( UNWRAP (value)) AS String))) THEN
      marks = TRY (ownershipTransferPlan__marks((OwnershipTransferPlan{ name: COPY CAST(emittable__name( UNWRAP (value)) AS String), target: :return, target_alloc: NIL, move_guarded: mIRLowering__lowered_guarded_cleanup_name?(&self, CAST(emittable__name( UNWRAP (value)) AS String)) })));
    END
    IF (marks.length() == 0) THEN
      RETURN COPY NodeRoot{ Emittable: Emittable{ ReturnStmt: COPY ret } };
    ELSE
      RETURN (marks + [Emittable{ ReturnStmt: COPY ret }]);
    END
END
PRIVATE FN mIRLowering__synthetic_return_ownership_plan(MUTABLE self: MIRLowering, name: String) RETURNS ReturnOwnershipPlan ->
    MUTABLE names: [Set]String = COPY [name] |> DISTINCT _;
    RETURN ReturnOwnershipPlan{ value: Emittable{ Ident: COPY Ident{ name: COPY name, lowered_node_id: NIL, ownership_consumption: NIL } }, explicit_return_names: COPY Set[], moved_root_names: COPY Set[], consumed_root_names: COPY Set[], direct_value_names: COPY names, converted_cleanup_names: COPY Set[], transfer_required_names: COPY names, move_guard_required_names: COPY names };
END
PRIVATE FN mIRLowering__return_lowering_plan(MUTABLE self: MIRLowering, MUTABLE node: ReturnNode) RETURNS !ReturnOwnershipPlan ->
    MUTABLE ret_alloc: ?String@symbol = TRY (mIRLowering__return_destination_alloc(&self, node));
    MUTABLE value_branch_value: ?U = NIL;
    IF node.value EXISTS AS rtoc_value_present THEN
      value_branch_value = mIRLowering__with_decl_alloc(&self, ret_alloc, %() USE(node, ret_alloc, MUTABLE self) -> {
    MUTABLE destination_type: ?Type@multiowned = TRY (mIRLowering__return_value_destination_type(&self, node));
    MUTABLE lowered: ?Emittable = mIRLowering__with_expected_type(&self, CAST(destination_type AS ?Type), %() USE(node, MUTABLE self) -> {
      MUTABLE rtoc_lambda_result_768: ?Emittable = TRY (mIRLowering__lower(&self, &rtoc_value_present));
      rtoc_lambda_result_768
    });
    TRY (mIRLowering__place_value_for_destination(&self, &lowered, node.value, ret_alloc, ruby_wrap_optional_Type_multiowned_TypeTypeInput(destination_type)))
      });
    ELSE
      value_branch_value = NIL;
    END
    MUTABLE value: ?U = value_branch_value;
    MUTABLE explicit_return_names: [Set]String = Set[];
    IF ((node.value EXISTS) AND !(mIRLowering__aggregate_return_literal?(&self, UNWRAP (node.value)))) THEN
      explicit_return_names = TRY (mIRLowering__returned_binding_names(&self, UNWRAP (node.value)));
    ELSE
      explicit_return_names = Set[];
    END
    MUTABLE moved_root_names: [Set]String = Set[];
    MUTABLE consumed_root_names: [Set]String = Set[];
    MUTABLE direct_value_names: [Set]String = Set[];
    IF ((value != NIL) AND (value IS_A Ident)) THEN
      &direct_value_names.insert(CAST(emittable__name(value) AS String));
    END
    MUTABLE returned_names: [Set]String = Set[];
    FOR _ IN ([explicit_return_names, moved_root_names, consumed_root_names, direct_value_names]) DO
    FOR _ IN _ DO
    &returned_names.insert(COPY _);
    END
    END
    MUTABLE transfer_required_names = TRY (mIRLowering__return_transfer_required_names(&self, returned_names));
    MUTABLE move_guard_required_names = TRY (mIRLowering__return_move_guard_required_names(&self, returned_names));
    RETURN ReturnOwnershipPlan{ value: COPY value, explicit_return_names: COPY explicit_return_names, moved_root_names: COPY moved_root_names, consumed_root_names: COPY consumed_root_names, direct_value_names: COPY direct_value_names, converted_cleanup_names: COPY Set[], transfer_required_names: COPY transfer_required_names, move_guard_required_names: COPY move_guard_required_names };
END
PRIVATE FN mIRLowering__aggregate_return_literal?(MUTABLE self: MIRLowering, expr: Locatable) RETURNS Bool ->
    MUTABLE node: Locatable = COPY expr;
    WHILE node IS_A Cast DO
      node = UNWRAP (aST__node_value(node));
    END
    RETURN ((node IS_A StructLit OR node IS_A UnionVariantLit) OR node IS_A ListLit);
END
PRIVATE FN mIRLowering__return_transfers_heap_binding?(MUTABLE self: MIRLowering, ast_node: Locatable) RETURNS !Bool ->
    MUTABLE node: Locatable = COPY ast_node;
    WHILE (node IS_A Cast OR node IS_A MoveNode) DO
      node = UNWRAP (aST__node_value(node));
    END
    IF (node IS_A GetField OR node IS_A GetIndex) THEN
      RETURN FALSE;
    END
    MUTABLE root:? = (aST__root_identifier(node));
    MUTABLE entry_branch_value: ?CleanupEntry@multiowned = NIL;
    IF root THEN
      entry_branch_value = COPY (TRY (functionState__bindings(mIRLowering__function_state(&self))))[identifier__name(root)];
    ELSE
      entry_branch_value = NIL;
    END
    MUTABLE entry: ?CleanupEntry@multiowned = entry_branch_value;
    IF entry EXISTS AS entry_value THEN
      IF cleanupEntry__present?(entry_value) THEN
      RETURN (cleanupEntry__needs_cleanup?( UNWRAP (entry)) AND cleanupEntry__heap?( UNWRAP (entry)));
    END
    END
    RETURN !(!((((root AND mIRLowering__current_function_takes_param_name?(&self, CAST(identifier__name(root) AS String))) AND ((root.symbol != NIL) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_769 = ((root.symbol)?);
    symbolEntry__heap_storage?(rtoc_local_receiver_769) })))));
END
PRIVATE FN mIRLowering__return_destination_type(MUTABLE self: MIRLowering, node: ReturnNode) RETURNS !?Type ->
    MUTABLE ti: ?Type@multiowned = mIRLowering__current_function_return_type(&self);
    IF ti != NIL THEN
    RETURN TRY (type__success_type(ti));
    ELSE
    RETURN NIL;
    END
END
PRIVATE FN mIRLowering__return_value_destination_type(MUTABLE self: MIRLowering, node: ReturnNode) RETURNS !?Type ->
    MUTABLE declared: ?Type@multiowned = TRY (mIRLowering__return_destination_type(&self, node));
    IF !(node.value) THEN
      RETURN CAST(declared AS ?Type);
    END
    MUTABLE value_type: ?Type = TRY (type__from_node_mut(node.value, "return destination value"));
    IF type__collection?( UNWRAP (value_type)) THEN
      RETURN value_type;
    END
    RETURN CAST(declared AS ?Type);
END
PRIVATE FN mIRLowering__return_value_already_payload_pointer?(MUTABLE self: MIRLowering, ast_node: ?Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE payload_zig: ?String = mIRLowering__current_function_return_payload_zig(&rtoc_self_view);
    IF ast_node EXISTS AS ast_node_value THEN
      IF payload_zig THEN
        MUTABLE ti: ?Type = TRY (type__from_node_mut(ast_node_value, "return payload pointer"));
        RETURN (TRY (type__zig_type( UNWRAP (ti))) == payload_zig);
      ELSE
        RETURN FALSE;
      END
    ELSE
      RETURN FALSE;
    END
}
CATCH Transient, Input, System, NotFound, Permission, Canceled
  RETURN FALSE;
END
PRIVATE FN mIRLowering__returned_binding_names(MUTABLE self: MIRLowering, expr: Locatable) RETURNS ![Set]String ->
    MUTABLE names: [Set]String = Set[];
    TRY (mIRLowering__collect_returned_binding_names(&self, expr, &names));
    RETURN names;
END
PRIVATE FN mIRLowering__return_transfer_required_names(MUTABLE self: MIRLowering, names: [Set]String) RETURNS ![Set]String ->
    MUTABLE out: [Set]String = Set[];
    FOR _ IN names DO
    IF TRY (mIRLowering__return_transfer_required?(&self, _)) THEN
      &out.insert(COPY _);
    END
    END
    RETURN out;
END
PRIVATE FN mIRLowering__return_move_guard_required_names(MUTABLE self: MIRLowering, names: [Set]String) RETURNS ![Set]String ->
    MUTABLE out: [Set]String = Set[];
    FOR _ IN names DO
    IF TRY (mIRLowering__return_move_guard_required?(&self, _)) THEN
      &out.insert(COPY _);
    END
    END
    RETURN out;
END
PRIVATE FN mIRLowering__return_transfer_required?(MUTABLE self: MIRLowering, name: String) RETURNS !Bool ->
    RETURN (((mIRLowering__pipeline_guarded_cleanup_name?(&self, name) OR mIRLowering__returned_hoist_binding?(&self, name)) OR TRY (mIRLowering__returned_takes_param?(&self, name))) OR TRY (mIRLowering__returned_owned_binding?(&self, name)));
END
PRIVATE FN mIRLowering__return_move_guard_required?(MUTABLE self: MIRLowering, name: String) RETURNS !Bool ->
    IF mIRLowering__pipeline_guarded_cleanup_name?(&self, name) THEN
      RETURN TRUE;
    END
    IF mIRLowering__lowered_guarded_cleanup_name?(&self, name) THEN
      RETURN TRUE;
    END
    MUTABLE entry: ?CleanupEntry@multiowned = COPY (TRY (functionState__bindings(mIRLowering__function_state(&self))))[name];
    RETURN !(!(((IF entry != NIL THEN
      cleanupEntry__needs_cleanup?(entry)
    ELSE
      NIL
    END))));
END
PRIVATE FN mIRLowering__returned_takes_param?(MUTABLE self: MIRLowering, name: String) RETURNS !Bool ->
    MUTABLE entry: ?CleanupEntry@multiowned = COPY (TRY (functionState__bindings(mIRLowering__function_state(&self))))[name];
    IF entry EXISTS AS entry_value THEN
      IF (cleanupEntry__source_kind(entry_value) == :takes_param) THEN
        MUTABLE ti: ?Type@multiowned = COPY (TRY (functionState__binding_types(mIRLowering__function_state(&self))))[name];
        RETURN (!(ti) OR TRY (mIRLowering__ownership_tracked_transfer_type?(&self, CAST(ti AS Type))));
      ELSE
        RETURN FALSE;
      END
    ELSE
      RETURN FALSE;
    END
END
PRIVATE FN mIRLowering__returned_hoist_binding?(MUTABLE self: MIRLowering, name: String) RETURNS Bool ->
    IF !(name.startsWith?("__hoist_")) THEN
      RETURN FALSE;
    END
    RETURN mIRLowering__function_state(&self).lowered_alloc_names.contains?(name);
END
PRIVATE FN mIRLowering__returned_owned_binding?(MUTABLE self: MIRLowering, name: String) RETURNS !Bool ->
    MUTABLE entry: ?CleanupEntry@multiowned = COPY (TRY (functionState__bindings(mIRLowering__function_state(&self))))[name];
    IF ((entry != NIL) AND !(cleanupEntry__needs_cleanup?(entry))) THEN
      IF !((IF cleanupEntry__lifecycle_plan( entry) != NIL THEN
        lifecyclePlan__needs_drop?( UNWRAP ((cleanupEntry__lifecycle_plan( entry))))
      ELSE
        NIL
      END)) THEN
        RETURN FALSE;
      END
    END
    MUTABLE ti: ?Type@multiowned = COPY (TRY (functionState__binding_types(mIRLowering__function_state(&self))))[name];
    IF ((!((IF entry != NIL THEN
      cleanupEntry__lifecycle_plan(entry)
    ELSE
      NIL
    END)) AND (ti != NIL)) AND !(TRY (mIRLowering__ownership_tracked_transfer_type?(&self, CAST(ti AS Type))))) THEN
      RETURN FALSE;
    END
    IF TRY (mIRLowering__owned_binding_visible?(&self, name)) THEN
      RETURN TRUE;
    END
    RETURN !(!(((IF entry != NIL THEN
      cleanupEntry__needs_cleanup?(entry)
    ELSE
      NIL
    END))));
END
PRIVATE FN mIRLowering__returned_no_cleanup_binding?(MUTABLE self: MIRLowering, name: String) RETURNS !Bool ->
    MUTABLE entry: ?CleanupEntry@multiowned = COPY (TRY (functionState__bindings(mIRLowering__function_state(&self))))[name];
    RETURN !(!(((((entry != NIL) AND cleanupEntry__present?(entry)) AND !(cleanupEntry__needs_cleanup?(entry))))));
END
PRIVATE FN mIRLowering__collect_fn_returned_names(MUTABLE self: MIRLowering, body: []Locatable) RETURNS ![Set]String ->
    MUTABLE names: [Set]String = Set[];
    aST__walk_body(body, %(node: Locatable) USE(MUTABLE names, MUTABLE self) -> {
    IF node IS_A ReturnNode AS return_node THEN
        TRY (mIRLowering__collect_returned_binding_names(&self, return_node.value, &names));
    END
    rubyToClearVoid__mir_lowering()
    });
    RETURN names;
END
PRIVATE FN mIRLowering__collect_returned_binding_names(MUTABLE self: MIRLowering, expr: ?Locatable, MUTABLE names: [Set]String) RETURNS !Void
  EFFECTS REENTRANT ->
    IF expr EXISTS AS expr_value THEN
      IF expr_value IS_A Identifier AS identifier THEN
        MUTABLE decl: ?SymbolEntryRegInput = NIL;
        IF identifier.symbol != NIL THEN
          decl = COPY ((identifier.symbol)?).reg;
        END
        MUTABLE name = ((((decl != NIL) AND ((TRY (functionState__decl_zig_names(mIRLowering__function_state(&self))))[aST__node_identity(castSymbolEntryRegInputToLocatable(decl))] != NIL))) OR TRUE);
        IF name THEN
          &names.insert(name);
        END
      ELSE_IF (expr_value IS_A Cast) OR (expr_value IS_A MoveNode) OR (expr_value IS_A ShareNode) THEN
        TRY (mIRLowering__collect_returned_binding_names(&self, aST__node_value(expr_value), &names));
      ELSE_IF expr_value IS_A CopyNode AS copy_node THEN
        RETURN;
      ELSE_IF expr_value IS_A KeepNode AS keep_node THEN
        RETURN;
      ELSE_IF expr_value IS_A FreezeNode AS freeze_node THEN
        RETURN;
      ELSE_IF expr_value IS_A StructLit AS struct_lit THEN
        FOR _ IN struct_lit.fields.values() DO
        TRY (mIRLowering__collect_returned_binding_names(&self, _, &names));
        END
      ELSE_IF expr_value IS_A UnionVariantLit AS union_variant_lit THEN
        FOR _ IN union_variant_lit.fields.values() DO
        TRY (mIRLowering__collect_returned_binding_names(&self, _, &names));
        END
      ELSE_IF expr_value IS_A ListLit AS list_lit THEN
        FOR _ IN list_lit.items DO
        TRY (mIRLowering__collect_returned_binding_names(&self, _, &names));
        END
      ELSE_IF expr_value IS_A BinaryOp AS binary_op THEN
        IF (binary_op.op == symbol("OR_ELSE")) THEN
          TRY (mIRLowering__collect_returned_binding_names(&self, binary_op.left, &names));
          TRY (mIRLowering__collect_returned_binding_names(&self, binary_op.right, &names));
        END
      END
      NIL;
    ELSE
      RETURN;
    END
END
PRIVATE FN mIRLowering__call_union_return_needs_hoist?(MUTABLE self: MIRLowering, expr: Emittable, ast_node: Locatable) RETURNS !Bool ->
    IF expr IS_A Call AS call THEN
      MUTABLE ti = TRY (aST__full_type_mut(ast_node));
      ti = (TRY (type__success_type(ti)) OR ti);
      MUTABLE is_heap = (((TRUE AND aST__node_heap_storage?(ast_node))) OR type__heap?(ti));
      IF is_heap THEN
        RETURN FALSE;
      END
      RETURN !(!((((TRY (mIRLowering__union_schemas(&self))).contains?(type__resolved(ti)) AND TRY (mIRLowering__ownership_bearing_type?(&self, ti))))));
    ELSE
      RETURN FALSE;
    END
END
PRIVATE FN mIRLowering__aggregate_temporary_needs_hoist?(MUTABLE self: MIRLowering, expr: Emittable, ast_node: Locatable) RETURNS !Bool ->
    IF expr IS_A TupleLiteral AS tuple_literal THEN
    IF ast_node IS_A TupleLit THEN
        RETURN TRY (mIRLowering__ownership_bearing_type?(&self, TRY (aST__full_type_mut(ast_node))));
      ELSE
        RETURN FALSE;
      END
    ELSE
      RETURN FALSE;
    END
END
PRIVATE FN mIRLowering__universal_poly_arg_needs_addr?(self: MIRLowering, arg_node: Locatable, callee_sig: ?FunctionSignature, idx: Int64) RETURNS !Bool ->
    IF !((callee_sig != NIL)) THEN
      RETURN FALSE;
    END
    IF !(TRY (functionSignature__requires( callee_sig))) THEN
      RETURN FALSE;
    END
    MUTABLE param: ?Param = COPY (TRY (functionSignature__params( callee_sig)))[idx];
    IF param EXISTS AS param_value THEN
      MUTABLE pname = COPY CAST(param_value.name AS String);
      MUTABLE fams: ?[Set]String@symbol = COPY (TRY (functionSignature__requires( callee_sig)))[pname];
      IF fams EXISTS AS fams_value THEN
        IF fams_value.empty?() THEN
          IF arg_node IS_A Identifier AS identifier THEN
            MUTABLE sym: ?SymbolEntry = identifier.symbol;
            IF sym EXISTS AS sym_value THEN
              IF symbolEntry__with_match_capability_family?(sym_value) THEN
                RETURN FALSE;
              END
              IF !((TRUE AND sym_value.mutable)) THEN
                RETURN FALSE;
              END
              RETURN TRUE;
            ELSE
              RETURN FALSE;
            END
          ELSE
            RETURN FALSE;
          END
        ELSE
          RETURN FALSE;
        END
      ELSE
        RETURN FALSE;
      END
    ELSE
      RETURN FALSE;
    END
END
PRIVATE FN mIRLowering__callee_needs_rt?(self: MIRLowering, name: String) RETURNS !Bool ->
    IF (FALSE OR (name.length() == 0)) THEN
      RETURN TRUE;
    END
    MUTABLE sig: ?FunctionSignature@multiowned = TRY (mIRLowering__fn_sig_for(self, MIRLoweringName{ StringValue: COPY name }));
    IF sig EXISTS AS sig_value THEN
      MUTABLE sig_value_mutable = COPY sig_value;
      IF functionSignature__intrinsic(sig_value_mutable) THEN
        RETURN ((functionSignature__needs_rt(sig_value_mutable) == TRUE) OR TRY (functionSignature__emits_allocating?(sig_value_mutable)));
      END
      IF !(((functionSignature__needs_rt(sig_value_mutable) == TRUE) OR (functionSignature__needs_rt(sig_value_mutable) == FALSE))) THEN
        panic("callee {} missing finalized needs_rt metadata before MIR lowering");
      END
      RETURN UNWRAP (functionSignature__needs_rt(sig_value_mutable));
    ELSE
      RETURN TRUE;
    END
END
FN mIRLowering__new(input: MIRLoweringInput = MIRLoweringInput{ struct_schemas: {}, enum_schemas: {}, union_schemas: {}, schema_lookup: NIL, lifecycle_registry: lifecycleRegistry__empty(), fn_sigs: {}, moved_guard_info: {}, importer: NIL, source_dir: NIL, debug_mode: FALSE, target: :zig, function_counter_seeds: {} }) RETURNS MIRLowering@multiowned ->
  MUTABLE schemas = mIRLoweringSchemas__new(CAST(COPY input.struct_schemas AS {String@symbol}StructSchema), input.enum_schemas, CAST(COPY input.union_schemas AS {String@symbol}UnionSchema));
  MUTABLE self = MIRLowering{ active_lifecycle_registry: NIL, kept_liveness_fn: NIL, kept_liveness: NIL, kept_edge_temp_stack: [], state: MIRLoweringState{ input: COPY input, schemas: schemas, counters: mIRLoweringCounters__new(), function_state: COPY FunctionState{ current_function_context: NIL, pending_stmts: List[], current_decl_alloc: NIL, current_expected_type: NIL, current_sink_type: NIL, current_reassignment_target: NIL, current_bindings: {}, current_binding_types: {}, fn_alloc_marked_names: {}, lowered_alloc_names: Set[], lowered_guarded_cleanup_names: Set[], decl_zig_name_map: {}, guarded_cleanup_names: {}, fn_name_rename_map: {}, node_store_types: Set[] }, runtime: COPY MIRLoweringRuntimeState{ rt_name: "rt", emitter: NIL }, program: COPY MIRLoweringProgramState{ fn_sigs: COPY ((COPY input).fn_sigs), importer: COPY (COPY input).importer, source_dir: COPY (COPY input).source_dir, debug_mode: (COPY input).debug_mode, target: COPY (COPY input).target, shard_context: NIL, emitted_extern_modules: Set[], pipeline_host: NIL, emitted_types: Set[], emitted_require_modules: Set[], emitted_import_type_aliases: Set[], used_sharded_map: FALSE, use_debug_allocator: NIL, fn_nodes: {}, function_counter_snapshots: {}, runtime_init_consts: List[], module_const_inits: Set[], module_global_names: Set[] }, capture: MIRLoweringCaptureState{ current_bg_pointer_captures: NIL, current_lambda_pointer_params: Set[], current_fiber_capture_symbols: {}, do_capture_map: NIL, current_stream_is_inf: NIL, current_stream_local: NIL, current_stream_close_label: NIL, current_fsm_inherited_alloc_names: Set[], current_fsm_inherited_guarded_names: Set[], current_fsm_owned_result_guards: {}, last_fsm_result_transfer_facts: List[] }, capabilities: COPY MIRLoweringCapabilityState{ locked_unwrap_map: NIL, rc_unwrap_map: NIL, with_alias_alloc_map: NIL, with_alias_owner_map: NIL, polymorphic_alias_type_map: NIL, if_bind_aliases: Set[], if_bind_pointer_aliases: Set[], atomic_emit_raw: FALSE }, ownership: COPY MIRLoweringOwnershipState{ next_lowered_node_id: 0, finalized_body_ids: Set[], finalized_node_ids: Set[] }, test: COPY MIRLoweringTestState{ active_stubs: {}, stub_label_counter: 0 } } };
  mIRLowering__initialize(&self, input);
  RETURN self @multiowned;
END
FN castAssignmentNameToGetField(value: AssignmentName) RETURNS GetField ->
  IF value IS_A GetField AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to GetField");
END
FN castAssignmentNameToLocatable__mir_lowering(value: AssignmentName) RETURNS Locatable ->
  PARTIAL MATCH value START
    AssignmentName.Identifier AS cast_payload -> RETURN Locatable{ Identifier: COPY cast_payload };,
    AssignmentName.GetField AS cast_payload -> RETURN Locatable{ GetField: COPY cast_payload };,
    AssignmentName.GetIndex AS cast_payload -> RETURN Locatable{ GetIndex: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Locatable");
  END
  panic("Invalid cast to Locatable");
END
FN castAssignmentNameToMIRLoweringLowerableStmt(value: AssignmentName) RETURNS MIRLoweringLowerableStmt ->
  PARTIAL MATCH value START
    AssignmentName.Identifier AS cast_payload -> RETURN MIRLoweringLowerableStmt{ Identifier: COPY cast_payload };,
    AssignmentName.GetField AS cast_payload -> RETURN MIRLoweringLowerableStmt{ GetField: COPY cast_payload };,
    AssignmentName.GetIndex AS cast_payload -> RETURN MIRLoweringLowerableStmt{ GetIndex: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to MIRLoweringLowerableStmt");
  END
  panic("Invalid cast to MIRLoweringLowerableStmt");
END
FN castAssignmentNameToName(value: AssignmentName) RETURNS MIRLoweringName ->
  PARTIAL MATCH value START
    AssignmentName.StringValue AS cast_payload -> RETURN MIRLoweringName{ StringValue: COPY cast_payload };,
    AssignmentName.Identifier AS cast_payload -> RETURN MIRLoweringName{ Identifier: COPY cast_payload };,
    AssignmentName.GetField AS cast_payload -> RETURN MIRLoweringName{ GetField: COPY cast_payload };,
    AssignmentName.GetIndex AS cast_payload -> RETURN MIRLoweringName{ GetIndex: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to MIRLoweringName");
  END
  panic("Invalid cast to MIRLoweringName");
END
FN castAssignmentNameToOptionalLocatable__mir_lowering(value: AssignmentName) RETURNS ?Locatable ->
  PARTIAL MATCH value START
