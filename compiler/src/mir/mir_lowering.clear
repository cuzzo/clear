FN mIRLowering__place_value_for_destination(MUTABLE self: MIRLowering, MUTABLE mir: Emittable, MUTABLE ast_node: Locatable, dest_alloc: ?String@symbol, dest_type: ?TypeTypeInput = NIL) RETURNS !Emittable ->
    MUTABLE plan = TRY (mIRLowering__destination_placement_plan(&self, &mir, &ast_node, dest_alloc, dest_type));
    MUTABLE placed = TRY (destinationPlacementPlan__place(&plan, &self, &mir, &ast_node));
    MUTABLE dst: ?Type = NIL;
    IF dest_type EXISTS AS dest_type_value THEN
      IF dest_type_value IS_A Type AS dest_type_struct THEN
        dst = COPY dest_type_struct;
      ELSE
        dst = TRY (type__new(castTypeTypeInputToTypeConstructionInput__mir_lowering(dest_type_value)));
      END
    END
    MUTABLE dst_is_byte_string: Bool = FALSE;
    IF dst EXISTS AS dst_value THEN
      dst_is_byte_string = TRY (type__byte_string?(dst_value));
    END
    IF !(dst_is_byte_string) THEN
      RETURN placed;
    END
    RETURN TRY (mIRLowering__widen_symbol_to_bytes(&self, placed, ast_node));
END
FN mIRLowering__async_payload_storage_value(MUTABLE self: MIRLowering, value: Emittable, shape: AsyncResultShape) RETURNS Emittable ->
    IF !(asyncResultShape__boxes_fallible_payload?(shape)) THEN
      RETURN COPY value;
    END
    RETURN Emittable{ StructInit: COPY StructInit{ zig_type: NIL, fields: [CAST(StructInitField{ name: symbol("value"), value: COPY value, alloc: NIL } AS Any)], lowered_node_id: NIL, ownership_consumption: NIL } };
END
FN mIRLowering__node_create_mir(MUTABLE self: MIRLowering, MUTABLE value: Emittable, destination: Type, MUTABLE source_node: Locatable) RETURNS !MIRMethodCall ->
    MUTABLE payload = UNWRAP (TRY (type__node_payload_type(destination)));
    MUTABLE zig_type = TRY (mIRLowering__transpile_type(self, MIRLoweringType{ StringValue: COPY CAST(type__resolved(payload) AS String) }));
    MUTABLE shared = type__shared_node?(destination);
    IF !(shared) THEN
      &self.state.function_state.node_store_types.insert(zig_type);
    END
    MUTABLE store = TRY (mIRLowering__node_store_type_mir(&self, zig_type, shared));
    MUTABLE call = MIRMethodCall{ receiver: Emittable{ Call: COPY store }, method: "createBound", args: [CAST(Ident{ name: mIRLowering__node_store_binding_name(self, zig_type, shared), lowered_node_id: NIL, ownership_consumption: NIL } AS Any), CAST(value AS Any)], try_wrap: TRUE, callable_contract: TRY (callableContract__no_ownership(2)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    call.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY destination }));
    RETURN castEmittableToMIRMethodCall(TRY (mIRLowering__with_ownership_consumption_for_value(&self, Emittable{ MIRMethodCall: COPY call }, &value, &source_node, IF shared THEN
      "SharedNodeStore.createBound"
    ELSE
      "NodeStore.createBound"
    END, :owned_sink, :heap)));
END
FN mIRLowering__node_store_type_mir(MUTABLE self: MIRLowering, zig_type: String, shared_value: Bool = FALSE) RETURNS !Call ->
    RETURN Call{ callee: IF shared_value THEN
      "CheatLib.SharedNodeStore"
    ELSE
      "CheatLib.NodeStore"
    END, args: [Emittable{ Ident: COPY Ident{ name: COPY zig_type, lowered_node_id: NIL, ownership_consumption: NIL } }], try_wrap: FALSE, owned_return: FALSE, callable_contract: TRY (callableContract__no_ownership(1)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL };
END
FN mIRLowering__shared_node_store_types_in_mir(MUTABLE self: MIRLowering, nodes: []Emittable, include_bodies: Bool = TRUE) RETURNS ![]String ->
    MUTABLE found: [Set]String = Set[];
    MUTABLE pending: []Emittable = COPY nodes;
    WHILE !((pending.length() == 0)) DO
      MUTABLE node = UNWRAP (&pending.pop());
      IF ((IF node IS_A MIRMethodCall AS mir_method_call THEN mir_method_call.receiver IS_A Call ELSE FALSE END) AND ((CAST(emittable__receiver(node) AS Call)).callee == "CheatLib.SharedNodeStore")) THEN
        MUTABLE arg: ?Emittable = COPY ((CAST(emittable__receiver(node) AS Call)).args).first();
        IF arg? IS_A Ident AS ident THEN
          &found.insert(COPY ident.name);
        END
      END
      FOR _ IN emittable__child_exprs(node) DO
        &pending.append(COPY _);
      END
      IF ((include_bodies OR node IS_A ScopeBlock) OR node IS_A MIRBlockExpr) THEN
        FOR _ IN emittable__body_slots(node) DO
        FOR _ IN locatable__body( CAST(_ AS Locatable)) DO
        &pending.append(COPY _);
        END
        END
      END
    END
    RETURN (found |> SELECT COPY _) |> ORDER_BY _;
END
FN mIRLowering__guard_shared_node_statement(MUTABLE self: MIRLowering, stmt: MIRLoweringLowerableStmt, nodes: []Emittable) RETURNS ![]Emittable ->
    MUTABLE types = TRY (mIRLowering__shared_node_store_types_in_mir(&self, nodes, FALSE));
    IF (types.length() == 0) THEN
      RETURN COPY nodes;
    END
    MUTABLE write = ((stmt IS_A Assignment OR stmt IS_A MethodCall) OR (nodes |> ANY mIRLowering__shared_node_write_mir?(&self, _)));
    MUTABLE lock_method: String = "";
    IF write THEN
      lock_method = "lockWrite";
    ELSE
      lock_method = "lockRead";
    END
    MUTABLE unlock_method: String = "";
    IF write THEN
      unlock_method = "unlockWrite";
    ELSE
      unlock_method = "unlockRead";
    END
    MUTABLE prefix: []Emittable = List[];
    FOR _ IN types DO
    MUTABLE store = TRY (mIRLowering__node_store_type_mir(&self, _, TRUE));
    MUTABLE binding = mIRLowering__node_store_binding_name(self, _, TRUE);
    &prefix.append(Emittable{ Let: COPY Let{ name: COPY binding, init: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Call: COPY store }, method: COPY lock_method, args: [CAST(Ident{ name: mIRLowering__runtime_binding_name(&self), lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: TRUE, callable_contract: TRY (callableContract__no_ownership(1)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
    &prefix.append(Emittable{ MIRDeferStmt: COPY MIRDeferStmt{ body: DeferBody{ Emittable: COPY CAST(COPY MIRMethodCall{ receiver: Emittable{ Call: COPY store }, method: COPY unlock_method, args: [CAST(Ident{ name: COPY binding, lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(1)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } AS Emittable) }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    END
    MUTABLE access_nodes = nodes |> WHERE !(((TRY (mIRLowering__shared_node_store_types_in_mir(&self, [_], FALSE))).length() == 0));
    IF (access_nodes.length() == 1) THEN
    IF ((access_nodes.first() != NIL) AND (access_nodes.first() IS_A Let)) THEN
      MUTABLE binding: Let = COPY castOptionalEmittableToLet(access_nodes.first());
      MUTABLE label = "__shared_node_access_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_12 = mIRLowering__lowering_counters(&self);
      mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_12)) }}";
      MUTABLE original_init = COPY binding.init;
      MUTABLE body: []Emittable = COPY prefix;
      IF TRY (mIRLowering__mir_allocates?(&self, original_init)) THEN
        MUTABLE value_name = "__shared_node_value_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_13 = mIRLowering__lowering_counters(&self);
        mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_13)) }}";
        MUTABLE value_type_branch_value: ?Type = NIL;
        IF (TRUE AND emittable__result_type(original_init)) THEN
          value_type_branch_value = TRY (type__new( CAST(emittable__result_type(original_init) AS TypeConstructionInput)));
        ELSE
          value_type_branch_value = (binding.annotation OR_ELSE TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })));
        END
        MUTABLE value_type: Type = value_type_branch_value?;
        MUTABLE value_alloc = (mIRLowering__mir_owned_alloc(&self, original_init) OR_ELSE :heap);
        MUTABLE materialized = BindingMaterialization{ name: COPY value_name, expr: COPY original_init, alloc: COPY value_alloc, type_info: COPY value_type, mutable: FALSE, annotation: NIL, suppression: NIL, cleanup_entry: NIL, cleanup_mode: :normal, scope: NIL, ownership_tracked: TRUE };
        body = ruby_array_concat_Emittable__mir_lowering(body, CAST(TRY (bindingMaterialization__statements(materialized)) AS []Emittable));
        body = ruby_array_concat_Emittable__mir_lowering(body, CAST(TRY (mIRLowering__ownership_transfer_marks(&self, value_name, :block_result, value_alloc)) AS []Emittable));
        &body.append(Emittable{ BreakStmt: COPY BreakStmt{ label: COPY label, value: Emittable{ Ident: COPY Ident{ name: COPY value_name, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
      ELSE
        &body.append(Emittable{ BreakStmt: COPY BreakStmt{ label: COPY label, value: COPY original_init, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
      END
      MUTABLE block = MIRBlockExpr{ label: COPY label, body: body, lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
      IF TRUE THEN
        block.result_type = emittable__result_type(original_init);
      END
      binding.init = Emittable{ MIRBlockExpr: COPY block };
      RETURN COPY nodes;
    END
    END
    RETURN CAST([Emittable{ ScopeBlock: COPY ScopeBlock{ body: COPY (prefix + nodes), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable);
END
FN mIRLowering__shared_node_write_mir?(MUTABLE self: MIRLowering, node: Emittable) RETURNS Bool
  EFFECTS REENTRANT ->
    IF node IS_A MIRMethodCall AS mir_method_call THEN
      IF mir_method_call.receiver IS_A Call THEN
        IF ((CAST(emittable__receiver(node) AS Call)).callee == "CheatLib.SharedNodeStore") THEN
          IF (["createBound", "removeBound"]).contains?(COPY mir_method_call.method) THEN
            RETURN TRUE;
          END
        END
      END
    END
    IF (emittable__child_exprs(node) |> ANY mIRLowering__shared_node_write_mir?(&self, _)) THEN
      RETURN TRUE;
    END
    FOR slot IN emittable__body_slots(node) DO
      IF (slot.body |> ANY mIRLowering__shared_node_write_mir?(&self, _)) THEN
        RETURN TRUE;
      END
    END
    RETURN FALSE;
END
FN mIRLowering__optional_nil_mir(MUTABLE self: MIRLowering, type: Type) RETURNS !Emittable ->
    IF TRY (type__node_reference?(type)) THEN
      RETURN Emittable{ StructInit: COPY StructInit{ zig_type: TRY (type__zig_type(type)), fields: List[], lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE
      MUTABLE optional_type_branch_value: ?Type = NIL;
      IF type__optional?(type) THEN
        optional_type_branch_value = COPY type;
      ELSE
        optional_type_branch_value = TRY (type__optional_of(TypeTypeInput{ Type: COPY type }));
      END
      MUTABLE optional_type: Type = optional_type_branch_value?;
      RETURN Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ Lit: COPY Lit{ value: "null", lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: COPY TRY (type__zig_type(optional_type)), method: :as, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
END
FN mIRLowering__destination_placement_plan(MUTABLE self: MIRLowering, MUTABLE mir: Emittable, MUTABLE ast_node: Locatable, dest_alloc: ?String@symbol, dest_type: ?TypeTypeInput) RETURNS !DestinationPlacementPlan ->
    IF dest_alloc EXISTS AS dest_alloc_value THEN
      MUTABLE dest_alloc_value_mutable = COPY dest_alloc_value;
      MUTABLE ti = TRY (mIRLowering__destination_type( &self, ast_node, dest_type));
      IF ((type__symbol?(ti) OR (((TRUE AND TRY (locatable__typed?(ast_node))) AND ((type__symbol?(TRY (type__from_node_mut( ast_node, "placement symbol probe"))))))))) THEN
        RETURN mIRLowering__destination_keep_plan(&self, dest_alloc_value_mutable);
      END
      IF (placement__heap?(dest_alloc_value_mutable) AND TRY (mIRLowering__heap_indirect_destination?(&self, mir, ast_node, CAST(ti AS Type)))) THEN
        RETURN DestinationPlacementPlan{ action: :heap_indirect, type_info: CAST(COPY ti AS ?Type), dest_alloc: COPY dest_alloc_value_mutable, source_alloc: NIL };
      END
      IF mIRLowering__cast_wrapped_or?(&self, mir, &ast_node) THEN
        RETURN DestinationPlacementPlan{ action: :cast_wrapped_or, type_info: CAST(COPY ti AS ?Type), dest_alloc: COPY dest_alloc_value_mutable, source_alloc: NIL };
      END
      IF (TRY (type__string?(ti)) AND type__rodata?(ti)) THEN
        RETURN mIRLowering__destination_keep_plan(&self, dest_alloc_value_mutable);
      END
      IF TRY (mIRLowering__borrowed_string_destination?(&self, ast_node, CAST(ti AS Type), dest_alloc_value_mutable)) THEN
        RETURN mIRLowering__destination_keep_plan(&self, dest_alloc_value_mutable);
      END
      IF TRY (mIRLowering__owned_or_destination?(&self, mir, &ast_node, CAST(ti AS Type), :orelse)) THEN
        RETURN DestinationPlacementPlan{ action: :owned_orelse, type_info: CAST(COPY ti AS ?Type), dest_alloc: COPY dest_alloc_value_mutable, source_alloc: NIL };
      END
      IF TRY (mIRLowering__owned_or_destination?(&self, mir, &ast_node, CAST(ti AS Type), :try_catch)) THEN
        RETURN DestinationPlacementPlan{ action: :owned_try_catch, type_info: CAST(COPY ti AS ?Type), dest_alloc: COPY dest_alloc_value_mutable, source_alloc: NIL };
      END
      MUTABLE source_alloc: ?String@symbol = TRY (mIRLowering__mir_owned_alloc(&self, mir));
      IF TRY (mIRLowering__heap_owned_future_handle_destination?(&self, mir, ast_node, dest_alloc_value_mutable, CAST(ti AS Type))) THEN
        RETURN mIRLowering__destination_keep_plan(&self, dest_alloc_value_mutable);
      END
      IF (((source_alloc != NIL) AND (source_alloc != dest_alloc_value_mutable)) AND TRY (mIRLowering__ownership_bearing_type?(&self, CAST(ti AS Type)))) THEN
        RETURN DestinationPlacementPlan{ action: :owned_alloc_mismatch, type_info: CAST(COPY ti AS ?Type), dest_alloc: COPY dest_alloc_value_mutable, source_alloc: COPY source_alloc };
      END
      MUTABLE source = TRY (mIRLowering__destination_source_fact(&self, mir, &ast_node));
      MUTABLE needs_recursive_copy = (((TRY (mIRLowering__ownership_bearing_type?(&self, CAST(ti AS Type))) AND source.borrowed) AND !(source.owner_transfer)) AND !(source.heap_owned_result));
      IF (TRY (destinationSourceFact__needs_owned_copy?(&source, CAST(ti AS Type))) OR needs_recursive_copy) THEN
        RETURN DestinationPlacementPlan{ action: :owned_copy, type_info: CAST(COPY ti AS ?Type), dest_alloc: COPY dest_alloc_value_mutable, source_alloc: NIL };
      END
      IF (TRY (type__string?(ti)) AND mIRLowering__or_binary?(&self, ast_node)) THEN
        RETURN DestinationPlacementPlan{ action: :string_or, type_info: CAST(COPY ti AS ?Type), dest_alloc: COPY dest_alloc_value_mutable, source_alloc: NIL };
      END
      IF type__symbol?(ti) THEN
        RETURN mIRLowering__destination_keep_plan(&self, dest_alloc_value_mutable);
      END
      IF TRY (type__string?(ti)) THEN
        RETURN DestinationPlacementPlan{ action: :string, type_info: CAST(COPY ti AS ?Type), dest_alloc: COPY dest_alloc_value_mutable, source_alloc: NIL };
      END
      RETURN mIRLowering__destination_keep_plan(&self, dest_alloc_value_mutable);
    ELSE
      RETURN mIRLowering__destination_keep_plan(&self, dest_alloc);
    END
END
FN mIRLowering__destination_keep_plan(MUTABLE self: MIRLowering, dest_alloc: ?String@symbol) RETURNS DestinationPlacementPlan ->
    RETURN DestinationPlacementPlan{ action: :keep, type_info: NIL, dest_alloc: COPY dest_alloc, source_alloc: NIL };
END
FN mIRLowering__destination_type(MUTABLE self: MIRLowering, ast_node: Locatable, dest_type: ?TypeTypeInput) RETURNS !Type ->
    MUTABLE ti: ?TypeTypeInput = COPY dest_type;
    IF ti == NIL THEN
      ti = TypeTypeInput{ Type: COPY TRY (type__from_node_mut(ast_node, "destination placement type")) };
    END
    IF ti IS_A Type AS type THEN
      RETURN type;
    ELSE
      RETURN TRY (type__new(castTypeTypeInputToTypeConstructionInput__mir_lowering(UNWRAP (ti))));
    END
END
FN mIRLowering__or_binary?(MUTABLE self: MIRLowering, node: ?Locatable) RETURNS Bool ->
    RETURN (IF node? IS_A BinaryOp AS binary_op THEN (((binary_op.op == symbol("OR_ELSE")) OR (binary_op.op == symbol("OR")))) ELSE FALSE END);
END
FN mIRLowering__destination_source_fact(MUTABLE self: MIRLowering, mir: Emittable, MUTABLE ast_node: Locatable) RETURNS !DestinationSourceFact ->
    MUTABLE node = mIRLowering__destination_source_node(&self, ast_node);
    RETURN DestinationSourceFact{ borrowed: TRY (mIRLowering__borrowed_destination_node?(&self, node)), owner_transfer: TRY (mIRLowering__owner_transfer_node?(&self, node)), heap_owned_result: TRY (mIRLowering__heap_owned_result?(&self, mir, node)) };
END
FN mIRLowering__destination_source_node(MUTABLE self: MIRLowering, node: Locatable) RETURNS Locatable ->
    IF (IF node IS_A BinaryOp AS binary_op THEN mIRLowering__or_binary?(&self, Locatable{ BinaryOp: COPY binary_op }) ELSE FALSE END) THEN
      RETURN CAST(UNWRAP (COPY locatable__left(node)) AS Locatable);
    ELSE
      RETURN COPY node;
    END
END
FN mIRLowering__borrowed_destination_node?(MUTABLE self: MIRLowering, node: Locatable) RETURNS !Bool ->
    IF TRY (mIRLowering__unit_union_variant_constructor?(&self, node)) THEN
      RETURN FALSE;
    END
    RETURN (node IS_A GetField OR node IS_A GetIndex);
END
FN mIRLowering__owner_transfer_node?(MUTABLE self: MIRLowering, node: Locatable) RETURNS !Bool ->
    IF aST__container_borrow?(node) THEN
      RETURN FALSE;
    END
    IF aST__moved?(node) THEN
      RETURN TRUE;
    END
    IF (IF node IS_A GetField AS get_field THEN (get_field.indirect_field == TRUE) ELSE FALSE END) THEN
      RETURN TRUE;
    END
    IF node IS_A GetField AS get_field THEN
      MUTABLE get_field_mutable = COPY get_field;
      RETURN type__indirect_type?(TRY (aST__full_type_mut( Locatable{ GetField: COPY get_field_mutable })));
    END
    RETURN FALSE;
END
FN mIRLowering__cast_wrapped_or?(MUTABLE self: MIRLowering, mir: Emittable, MUTABLE ast_node: Locatable) RETURNS Bool ->
    RETURN !(!(((IF mir IS_A MIRCast AS mir_cast THEN mIRLowering__or_binary?(&self, ast_node) ELSE FALSE END))));
END
FN mIRLowering__heap_indirect_destination?(MUTABLE self: MIRLowering, mir: Emittable, ast_node: Locatable, ti: Type) RETURNS !Bool ->
    IF !(((type__indirect?(ti) AND !(type__any_sync?(ti))) AND (type__ownership(ti) == :affine))) THEN
      RETURN FALSE;
    END
    IF mir IS_A HeapCreate AS heap_create THEN
      RETURN FALSE;
    END
    MUTABLE source_t: ?Type = TRY (type__from_node_mut(ast_node, "heap indirect destination source"));
    RETURN !(type__indirect_type?( UNWRAP (source_t)));
END
FN mIRLowering__owned_or_destination?(MUTABLE self: MIRLowering, mir: Emittable, MUTABLE ast_node: Locatable, ti: Type, kind: String@symbol) RETURNS !Bool ->
    IF !((mIRLowering__or_binary?(&self, ast_node) AND TRY (mIRLowering__ownership_bearing_type?(&self, ti)))) THEN
      RETURN FALSE;
    END
    RETURN PARTIAL MATCH kind START
      :orelse -> mir IS_A Orelse,
      :try_catch -> mir IS_A TryCatch,
      DEFAULT -> FALSE
    END;
END
FN mIRLowering__borrowed_string_destination?(MUTABLE self: MIRLowering, ast_node: Locatable, ti: Type, dest_alloc: ?String@symbol) RETURNS !Bool ->
    RETURN ((TRY (type__string?(ti)) AND !(placement__heap?(dest_alloc))) AND aST__container_borrow?(ast_node));
END
FN mIRLowering__heap_owned_future_handle_destination?(MUTABLE self: MIRLowering, mir: Emittable, ast_node: Locatable, dest_alloc: String@symbol, type_info: Type) RETURNS !Bool ->
    IF !(placement__frame?(dest_alloc)) THEN
      RETURN FALSE;
    END
    MUTABLE source_type: ?Type = TRY (type__from_node_mut(ast_node, "async boundary destination"));
    IF !((TRY (type__single_future?(type_info)) OR TRY (type__single_future?( UNWRAP (source_type))))) THEN
      RETURN FALSE;
    END
    MUTABLE effect = TRY (ownershipEffect__of(mir));
    RETURN (((effect.produces_owned AND placement__heap?(effect.alloc))) == TRUE);
END
FN mIRLowering__place_indirect_value_for_heap_destination(MUTABLE self: MIRLowering, MUTABLE mir: Emittable, ti: Type) RETURNS !Emittable ->
    RETURN TRY (mIRLowering__with_ownership_consumption(&self, Emittable{ HeapCreate: COPY HeapCreate{ zig_type: COPY TRY (mIRLowering__transpile_type(self, MIRLoweringType{ StringValue: COPY CAST(type__resolved(ti) AS String) })), init: COPY mir, alloc: :heap, label: "blk", lowered_node_id: NIL, ownership_consumption: NIL } }, TRY (mIRLowering__mir_ident_names(self, mir)), "MIR::HeapCreate", :owned_sink, :heap));
END
FN mIRLowering__place_owned_orelse_for_destination(MUTABLE self: MIRLowering, MUTABLE mir: Orelse, ti: Type, dest_alloc: String@symbol) RETURNS !Emittable
  EFFECTS REENTRANT ->
    MUTABLE tmp_id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_15 = mIRLowering__lowering_counters(&self);
    mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_15) };
    MUTABLE capture = "__or_val_${mIRLoweringGeneratedId__to_s(tmp_id)}";
    MUTABLE left = TRY (mIRLowering__place_owned_branch_value_for_destination(&self, Emittable{ Ident: COPY Ident{ name: COPY capture, lowered_node_id: NIL, ownership_consumption: NIL } }, ti, dest_alloc));
    MUTABLE right = TRY (mIRLowering__place_owned_branch_value_for_destination(&self, &mir.fallback, ti, dest_alloc));
    MUTABLE out = IfOptional{ optional: COPY mir.expr, capture: COPY capture, then_expr: COPY left, else_expr: COPY right, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    out.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY ti }));
    RETURN Emittable{ MIRBlockExpr: COPY TRY (mIRLowering__owned_branch_result_value(&self, Emittable{ IfOptional: COPY out }, ti, dest_alloc)) };
END
FN mIRLowering__place_owned_try_catch_for_destination(MUTABLE self: MIRLowering, MUTABLE mir: TryCatch, ti: Type, dest_alloc: String@symbol) RETURNS !Emittable ->
    MUTABLE right = TRY (mIRLowering__place_owned_branch_value_for_destination(&self, &mir.catch_body, ti, dest_alloc));
    IF TRY (mIRLowering__mir_allocates?(&self, right)) THEN
      right = Emittable{ MIRBlockExpr: COPY TRY (mIRLowering__owned_branch_result_value(&self, right, ti, dest_alloc)) };
    END
    MUTABLE source_alloc: ?String@symbol = (IF TRY (mIRLowering__mir_owned_alloc(&self, mir.expr)) != NIL THEN TRY (mIRLowering__mir_owned_alloc(&self, mir.expr)) ELSE TRY (mIRLowering__mir_owned_alloc(&self, Emittable{ TryCatch: COPY mir })) END);
    IF ((source_alloc != NIL) AND (source_alloc != dest_alloc)) THEN
      MUTABLE tmp_id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_16 = mIRLowering__lowering_counters(&self);
      mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_16) };
      MUTABLE label = "__try_place_${mIRLoweringGeneratedId__to_s(tmp_id)}";
      MUTABLE success = "__try_val_${mIRLoweringGeneratedId__to_s(tmp_id)}";
      MUTABLE catch_break = BreakExpr{ label: COPY label, value: COPY right, lowered_node_id: NIL, ownership_consumption: NIL };
      MUTABLE success_try = TryCatch{ expr: COPY mir.expr, catch_body: Emittable{ BreakExpr: COPY catch_break }, capture: mir.capture, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
      success_try.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY ti }));
      MUTABLE success_cleanup = cleanupEntry__build(:uniform, source_alloc, FALSE);
      TRY (mIRLowering__build_drop_entry_mut(&self, &success_cleanup, ti, NIL));
      MUTABLE materialized = BindingMaterialization{ name: COPY success, expr: Emittable{ TryCatch: COPY success_try }, alloc: COPY source_alloc, type_info: COPY ti, mutable: FALSE, cleanup_entry: success_cleanup, annotation: NIL, suppression: NIL, cleanup_mode: :normal, scope: NIL, ownership_tracked: TRUE };
      MUTABLE body = TRY (bindingMaterialization__statements(materialized));
      &body.append(CAST(BreakStmt{ label: COPY label, value: COPY TRY (mIRLowering__place_owned_branch_value_for_destination(&self, Emittable{ Ident: COPY Ident{ name: COPY success, lowered_node_id: NIL, ownership_consumption: NIL } }, ti, dest_alloc)), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable));
      MUTABLE out_block = MIRBlockExpr{ label: COPY label, body: COPY body, lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
      out_block.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY ti }));
      RETURN Emittable{ MIRBlockExpr: COPY out_block };
    END
    MUTABLE out = TryCatch{ expr: COPY mir.expr, catch_body: COPY right, capture: mir.capture, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    out.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY ti }));
    RETURN Emittable{ TryCatch: COPY out };
END
FN mIRLowering__owned_branch_result_value(MUTABLE self: MIRLowering, mir: Emittable, ti: Type, dest_alloc: String@symbol) RETURNS !MIRBlockExpr ->
    MUTABLE tmp_id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_17 = mIRLowering__lowering_counters(&self);
    mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_17) };
    MUTABLE label = "__owned_branch_${mIRLoweringGeneratedId__to_s(tmp_id)}";
    MUTABLE name = "__owned_branch_val_${mIRLoweringGeneratedId__to_s(tmp_id)}";
    MUTABLE materialized = BindingMaterialization{ name: COPY name, expr: COPY mir, alloc: COPY dest_alloc, type_info: COPY ti, mutable: FALSE, annotation: NIL, suppression: NIL, cleanup_entry: NIL, cleanup_mode: :normal, scope: NIL, ownership_tracked: TRUE };
    MUTABLE body: []Emittable = TRY (bindingMaterialization__statements(materialized));
    body = ruby_array_concat_Stmt(body, TRY (mIRLowering__ownership_transfer_marks(&self, name, :block_result, dest_alloc)));
    &body.append(CAST(BreakStmt{ label: COPY label, value: Emittable{ Ident: COPY Ident{ name: COPY name, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable));
    MUTABLE out = MIRBlockExpr{ label: COPY label, body: COPY body, lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
    out.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY ti }));
    RETURN out;
END
FN mIRLowering__place_owned_alloc_mismatch_for_destination(MUTABLE self: MIRLowering, mir: Emittable, ti: Type, dest_alloc: String@symbol, source_alloc: String@symbol) RETURNS !Emittable
  EFFECTS REENTRANT ->
    IF (IF mir IS_A Ident AS ident THEN TRY (mIRLowering__owned_binding_visible?(&self, ident.name)) ELSE FALSE END) THEN
      RETURN TRY (mIRLowering__copy_owned_value_for_destination(&self, mir, ti, dest_alloc));
    END
    MUTABLE tmp_id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_18 = mIRLowering__lowering_counters(&self);
    mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_18) };
    MUTABLE label = "__owned_place_${mIRLoweringGeneratedId__to_s(tmp_id)}";
    MUTABLE name = "__owned_val_${mIRLoweringGeneratedId__to_s(tmp_id)}";
    MUTABLE cleanup = cleanupEntry__build(:uniform, source_alloc, FALSE);
    TRY (mIRLowering__build_drop_entry_mut(&self, &cleanup, ti, NIL));
    MUTABLE materialized = BindingMaterialization{ name: COPY name, expr: COPY mir, alloc: COPY source_alloc, type_info: COPY ti, mutable: FALSE, cleanup_entry: cleanup, annotation: NIL, suppression: NIL, cleanup_mode: :normal, scope: NIL, ownership_tracked: TRUE };
    MUTABLE body = TRY (bindingMaterialization__statements(materialized));
    &body.append(CAST(BreakStmt{ label: COPY label, value: COPY TRY (mIRLowering__place_owned_branch_value_for_destination(&self, Emittable{ Ident: COPY Ident{ name: COPY name, lowered_node_id: NIL, ownership_consumption: NIL } }, ti, dest_alloc)), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable));
    MUTABLE out = MIRBlockExpr{ label: COPY label, body: COPY body, lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
    out.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY ti }));
    RETURN Emittable{ MIRBlockExpr: COPY out };
END
FN mIRLowering__retain_handle_for_destination(MUTABLE self: MIRLowering, mir: Emittable, ti: Type) RETURNS !?Emittable ->
    MUTABLE payload: ?Type = NIL;
    IF type__optional?(ti) THEN
      payload = TRY (type__wrapped_type(ti));
    ELSE
      payload = COPY ti;
    END
    MUTABLE payload_is_rc: Bool = FALSE;
    IF payload EXISTS AS payload_value THEN
      payload_is_rc = TRY (type__any_rc?(payload_value));
    END
    IF !(payload_is_rc) THEN
      RETURN NIL;
    END
    MUTABLE fn: String = "";
    IF type__shared?( UNWRAP (payload)) THEN
      fn = "arcRetain";
    ELSE
      fn = "rcRetain";
    END
    MUTABLE zig = TRY (mIRLowering__rc_payload_zig_type(self, UNWRAP (payload)));
    IF !(type__optional?(ti)) THEN
      RETURN Emittable{ RcRetain: COPY RcRetain{ source: COPY mir, zig_base: COPY zig, func: COPY fn, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    MUTABLE capture = "__retain_rc_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_21 = mIRLowering__lowering_counters(&self);
    mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_21)) }}";
    MUTABLE retained = IfOptional{ optional: COPY mir, capture: COPY capture, then_expr: Emittable{ RcRetain: COPY RcRetain{ source: Emittable{ Ident: COPY Ident{ name: COPY capture, lowered_node_id: NIL, ownership_consumption: NIL } }, zig_base: COPY zig, func: COPY fn, lowered_node_id: NIL, ownership_consumption: NIL } }, else_expr: Emittable{ Lit: COPY Lit{ value: "null", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    retained.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY ti }));
    RETURN Emittable{ IfOptional: COPY retained };
END
FN mIRLowering__copy_owned_value_for_destination(MUTABLE self: MIRLowering, mir: Emittable, ti: Type, dest_alloc: String@symbol) RETURNS !Emittable ->
    IF TRY (type__string?(ti)) THEN
      RETURN Emittable{ DupeSlice: COPY DupeSlice{ source: COPY mir, alloc: COPY dest_alloc, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    MUTABLE retained: ?Emittable = TRY (mIRLowering__retain_handle_for_destination(&self, mir, ti));
    IF retained EXISTS AS retained_value THEN
      RETURN COPY retained_value;
    END
    RETURN Emittable{ DeepCopy: COPY DeepCopy{ source: COPY mir, zig_type: COPY TRY (type__zig_type(ti)), elem_type: NIL, strategy: :full_value, alloc: COPY dest_alloc, copy_shape: COPY deepCopy__copy_shape_for_zig_type(TRY (type__zig_type(ti))), type_info: COPY ti, lowered_node_id: NIL, ownership_consumption: NIL } };
END
FN mIRLowering__place_string_or_for_heap_destination(MUTABLE self: MIRLowering, mir: Emittable, ast_node: BinaryOp) RETURNS !Emittable ->
    MUTABLE left_t: ?Type = TRY (type__from_node_mut(ast_node.left, "string OR destination left"));
    IF type__optional?( UNWRAP (left_t)) THEN
      RETURN TRY (mIRLowering__place_string_value_for_heap_destination(&self, mir, Locatable{ BinaryOp: COPY ast_node }));
    END
    IF mir IS_A TryCatch AS try_catch THEN
      MUTABLE try_catch_mutable = COPY try_catch;
      IF !(TRY (mIRLowering__heap_owned_result?(&self, tryCatch__expr(try_catch_mutable), ast_node.left))) THEN
        RETURN TRY (mIRLowering__place_string_value_for_heap_destination(&self, Emittable{ TryCatch: COPY try_catch_mutable }, Locatable{ BinaryOp: COPY ast_node }));
      END
      MUTABLE left = TRY (mIRLowering__place_or_branch_value_for_destination(&self, tryCatch__expr(try_catch_mutable), ast_node.left));
      MUTABLE right = TRY (mIRLowering__place_or_branch_value_for_destination(&self, try_catch_mutable.catch_body, ast_node.right));
      MUTABLE out = TryCatch{ expr: COPY left, catch_body: COPY right, capture: try_catch_mutable.capture, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
      out.result_type = TRY (type__from_node_mut(Locatable{ BinaryOp: COPY ast_node }, "string OR destination result"));
      RETURN Emittable{ TryCatch: COPY out };
    ELSE_IF mir IS_A Orelse AS orelse THEN
      MUTABLE orelse_mutable = COPY orelse;
      MUTABLE left = TRY (mIRLowering__place_or_branch_value_for_destination(&self, orelse__expr(orelse_mutable), ast_node.left));
      MUTABLE right = TRY (mIRLowering__place_or_branch_value_for_destination(&self, orelse_mutable.fallback, ast_node.right));
      MUTABLE out = Orelse{ expr: COPY left, fallback: COPY right, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
      out.result_type = TRY (type__from_node_mut(Locatable{ BinaryOp: COPY ast_node }, "string OR destination result"));
      RETURN Emittable{ Orelse: COPY out };
    ELSE
      RETURN TRY (mIRLowering__place_string_value_for_heap_destination(&self, mir, Locatable{ BinaryOp: COPY ast_node }));
    END
END
FN mIRLowering__widen_symbol_to_bytes(MUTABLE self: MIRLowering, mir: Emittable, source_node: ?Locatable) RETURNS !Emittable ->
    IF source_node EXISTS AS source_node_value THEN
      MUTABLE ti: ?Type = TRY (type__from_node_mut(source_node_value, "symbol widening"));
      IF !(type__symbol?( UNWRAP (ti))) THEN
        RETURN COPY mir;
      END
      RETURN Emittable{ FieldGet: COPY FieldGet{ object: COPY mir, field: "bytes", lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE
      RETURN COPY mir;
    END
END
FN mIRLowering__place_owned_branch_value_for_destination(MUTABLE self: MIRLowering, MUTABLE mir: Emittable, dst_ti: Type, dest_alloc: String@symbol) RETURNS !Emittable
  EFFECTS REENTRANT ->
    IF mir IS_A Orelse AS MUTABLE orelse THEN
      RETURN TRY (mIRLowering__place_owned_orelse_for_destination(&self, &orelse, dst_ti, dest_alloc));
    END
    IF mir IS_A MIRBlockExpr AS mir_block_expr THEN
      RETURN Emittable{ MIRBlockExpr: COPY TRY (mIRLowering__copy_lazy_owned_branch_for_destination(&self, Emittable{ MIRBlockExpr: COPY mir_block_expr }, dst_ti, dest_alloc)) };
    END
    MUTABLE owned_alloc: ?String@symbol = TRY (mIRLowering__mir_owned_alloc(&self, mir));
    IF (owned_alloc == dest_alloc) THEN
      IF mir IS_A Ident AS ident THEN
        RETURN TRY (mIRLowering__transfer_owned_branch_binding(&self, Emittable{ Ident: COPY ident }, dst_ti, dest_alloc));
      END
      IF TRY (mIRLowering__mir_allocates?(&self, mir)) THEN
        RETURN Emittable{ MIRBlockExpr: COPY TRY (mIRLowering__owned_branch_result_value(&self, mir, dst_ti, dest_alloc)) };
      END
    END
    IF owned_alloc EXISTS AS owned_alloc_value THEN
      RETURN TRY (mIRLowering__place_owned_alloc_mismatch_for_destination(&self, mir, dst_ti, dest_alloc, owned_alloc_value));
    END
    IF TRY (type__string?(dst_ti)) THEN
      RETURN Emittable{ DupeSlice: COPY DupeSlice{ source: COPY mir, alloc: COPY dest_alloc, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    MUTABLE retained: ?Emittable = TRY (mIRLowering__retain_handle_for_destination(&self, mir, dst_ti));
    IF retained EXISTS AS retained_value THEN
      RETURN COPY retained_value;
    END
    IF TRY (mIRLowering__mir_allocates?(&self, mir)) THEN
      RETURN Emittable{ MIRBlockExpr: COPY TRY (mIRLowering__copy_lazy_owned_branch_for_destination(&self, mir, dst_ti, dest_alloc)) };
    END
    RETURN Emittable{ DeepCopy: COPY DeepCopy{ source: COPY mir, zig_type: COPY TRY (type__zig_type(dst_ti)), elem_type: NIL, strategy: :full_value, alloc: COPY dest_alloc, copy_shape: COPY deepCopy__copy_shape_for_zig_type(TRY (type__zig_type(dst_ti))), type_info: COPY dst_ti, lowered_node_id: NIL, ownership_consumption: NIL } };
END
# Ruby's `Array#rindex { }` has no CLEAR counterpart; the scan runs back to
# front by index, the way escape_analysis reverses a list.
FN mIRLoweringRindexBreakStmt(items: []Emittable) RETURNS ?Int64 ->
  MUTABLE idx: Int64 = (items.length() - 1);
  WHILE idx >= 0 DO
    IF items[idx]? IS_A BreakStmt THEN
      RETURN idx;
    END
    idx = idx - 1;
  END
  RETURN NIL;
END
FN mIRLowering__claim_block_result_ownership_mut(MUTABLE self: MIRLowering, mir: Emittable) RETURNS !Bool ->
    IF mir IS_A MIRBlockExpr AS mir_block_expr THEN
      MUTABLE mir_block_expr_mutable = COPY mir_block_expr;
      FOR stmt IN TRY (blockExpr__body(mir_block_expr_mutable)) DO
        IF stmt IS_A TransferMark AS transfer_mark THEN
          IF (transfer_mark.target == :block_result) THEN
            RETURN TRUE;
          END
        END
      END
      MUTABLE break_index_opt: ?Int64 = mIRLoweringRindexBreakStmt(TRY (blockExpr__body(mir_block_expr_mutable)));
      IF break_index_opt == NIL THEN
        RETURN FALSE;
      END
      MUTABLE break_index: Int64 = break_index_opt;
      MUTABLE owner: ?String = COPY (TRY (mIRLowering__mir_ident_names(self, (CAST(UNWRAP ((TRY (blockExpr__body(mir_block_expr_mutable)))[break_index]) AS BreakStmt)).value))).first();
      IF owner EXISTS AS owner_value THEN
        MUTABLE owner_value_mutable = COPY owner_value;
        MUTABLE cleanup_found: Bool = FALSE;
        FOR stmt IN TRY (blockExpr__body(mir_block_expr_mutable)) DO
          IF stmt IS_A Cleanup AS cleanup_stmt THEN
            IF ((cleanup_stmt.name == owner_value_mutable) AND cleanupEntry__has_moved_guard?(cleanup_stmt.cleanup_entry)) THEN
              cleanup_found = TRUE;
            END
          END
        END
        IF !(cleanup_found) THEN
          RETURN FALSE;
        END
        # Ruby's `body[break_index, 0] = marks` INSERTS before the break; an
        # indexed store would overwrite it.
        MUTABLE spliced: []Emittable = List[];
        MUTABLE splice_idx: Int64 = 0;
        FOR stmt IN TRY (blockExpr__body(mir_block_expr_mutable)) DO
          IF splice_idx == break_index THEN
            FOR mark IN TRY (mIRLowering__ownership_transfer_marks(&self, owner_value_mutable, :block_result, NIL, TRUE)) DO
              &spliced.append(COPY mark);
            END
          END
          &spliced.append(COPY stmt);
          splice_idx = splice_idx + 1;
        END
        mir_block_expr_mutable.body = spliced;
        RETURN TRUE;
      ELSE
        RETURN FALSE;
      END
    ELSE
      RETURN FALSE;
    END
END
FN mIRLowering__owned_branch_source_owns?(MUTABLE self: MIRLowering, mir: Emittable) RETURNS !Bool ->
    MUTABLE result = COPY mir;
    IF mir IS_A MIRBlockExpr AS mir_block_expr THEN
      MUTABLE body_stmts = TRY (blockExpr__body(mir_block_expr));
      MUTABLE tail: ?Emittable = NIL;
      MUTABLE tail_idx = body_stmts.length() - 1;
      WHILE tail_idx >= 0 DO
        IF body_stmts[tail_idx] EXISTS AS body_stmt THEN
          IF body_stmt IS_A BreakStmt THEN
            tail = COPY body_stmt;
            tail_idx = -1;
          END
        END
        tail_idx = tail_idx - 1;
      END
      IF tail EXISTS AS tail_value THEN
        IF tail_value IS_A BreakStmt AS break_stmt THEN
          IF break_stmt.value EXISTS AS break_value THEN
            result = COPY break_value;
          END
        END
      END
    END
    IF result IS_A Ident AS ident THEN
      RETURN TRUE;
    END
    IF (TRY (ownershipEffect__of(result))).produces_owned THEN
      RETURN TRUE;
    END
    RETURN emittable__materializes_value?(result);
END
FN mIRLowering__copy_lazy_owned_branch_for_destination(MUTABLE self: MIRLowering, mir: Emittable, type_info: Type, dest_alloc: String@symbol) RETURNS !MIRBlockExpr ->
    MUTABLE tmp_id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_23 = mIRLowering__lowering_counters(&self);
    mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_23) };
    MUTABLE label = "__owned_branch_copy_${mIRLoweringGeneratedId__to_s(tmp_id)}";
    MUTABLE source_name = "__owned_branch_src_${mIRLoweringGeneratedId__to_s(tmp_id)}";
    MUTABLE copy_name = "__owned_branch_copy_val_${mIRLoweringGeneratedId__to_s(tmp_id)}";
    MUTABLE claimed = TRY (mIRLowering__claim_block_result_ownership_mut(&self, mir));
    MUTABLE source_alloc:? = ((IF TRY (mIRLowering__mir_owned_alloc(&self, mir)) != NIL THEN TRY (mIRLowering__mir_owned_alloc(&self, mir)) ELSE TRY (ownershipEffect__alloc_of(mir)) END));
    MUTABLE source_owned = (claimed OR TRY (mIRLowering__owned_branch_source_owns?(&self, mir)));
    MUTABLE source_cleanup: ?CleanupEntry@multiowned = NIL;
    IF source_owned THEN
      source_cleanup = cleanupEntry__build(:uniform, UNWRAP (source_alloc), FALSE, NIL, TRY (type__zig_type(type_info)));
      IF source_cleanup EXISTS AS MUTABLE drop_entry THEN
        TRY (mIRLowering__build_drop_entry_mut(&self, &drop_entry, type_info, NIL));
      END
    END
    MUTABLE source = BindingMaterialization{ name: COPY source_name, expr: COPY mir, alloc: CAST(COPY source_alloc AS String), type_info: COPY type_info, mutable: FALSE, cleanup_entry: source_cleanup, ownership_tracked: source_owned, annotation: NIL, suppression: NIL, cleanup_mode: :normal, scope: NIL };
    MUTABLE copied_expr = (TRY (mIRLowering__retain_handle_for_destination(&self, Emittable{ Ident: COPY Ident{ name: COPY source_name, lowered_node_id: NIL, ownership_consumption: NIL } }, type_info)) OR_ELSE Emittable{ DeepCopy: COPY DeepCopy{ source: Emittable{ Ident: COPY Ident{ name: COPY source_name, lowered_node_id: NIL, ownership_consumption: NIL } }, zig_type: COPY TRY (type__zig_type(type_info)), elem_type: NIL, strategy: :full_value, alloc: COPY dest_alloc, copy_shape: COPY deepCopy__copy_shape_for_zig_type(TRY (type__zig_type(type_info))), type_info: COPY type_info, lowered_node_id: NIL, ownership_consumption: NIL } });
    MUTABLE copy_cleanup = cleanupEntry__build(:uniform, dest_alloc, TRUE, NIL, TRY (type__zig_type(type_info)));
    TRY (mIRLowering__build_drop_entry_mut(&self, &copy_cleanup, type_info, NIL));
    MUTABLE copied = BindingMaterialization{ name: COPY copy_name, expr: COPY copied_expr, alloc: COPY dest_alloc, type_info: COPY type_info, mutable: FALSE, cleanup_entry: copy_cleanup, cleanup_mode: :err, annotation: NIL, suppression: NIL, scope: NIL, ownership_tracked: TRUE };
    MUTABLE body: []Emittable = (TRY (bindingMaterialization__statements(source)) + TRY (bindingMaterialization__statements(copied)));
    body = ruby_array_concat_Stmt(body, TRY (mIRLowering__ownership_transfer_marks(&self, copy_name, :block_result, dest_alloc, TRUE)));
    &body.append(CAST(BreakStmt{ label: COPY label, value: Emittable{ Ident: COPY Ident{ name: COPY copy_name, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable));
    MUTABLE out = MIRBlockExpr{ label: COPY label, body: COPY body, lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
    out.lazy_boundary = TRUE;
    out.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY type_info }));
    RETURN out;
END
FN mIRLowering__transfer_owned_branch_binding(MUTABLE self: MIRLowering, mir: Emittable, type_info: Type, dest_alloc: String@symbol) RETURNS !Emittable ->
    IF mir IS_A Ident AS ident THEN
      MUTABLE ident_mutable = COPY ident;
      MUTABLE name = COPY ident_mutable.name;
      IF (mIRLowering__function_state(&self).current_reassignment_target == name) THEN
        RETURN COPY Emittable{ Ident: COPY ident_mutable };
      END
      MUTABLE entry = ((TRY (functionState__bindings(mIRLowering__function_state(&self))))[name] OR_ELSE cleanupEntry__none());
      MUTABLE plan: ?LifecyclePlan = cleanupEntry__lifecycle_plan(entry);
      IF !((cleanupEntry__present?(entry) AND (IF plan EXISTS AS plan_value THEN lifecyclePlan__needs_drop?(plan_value) ELSE FALSE END))) THEN
        RETURN COPY Emittable{ Ident: COPY ident_mutable };
      END
      cleanupEntry__mark_moved_guard_mut(&entry);
      mIRLowering__mark_guarded_cleanup_name_mut(&self, name);
      MUTABLE label = "__owned_branch_transfer_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_24 = mIRLowering__lowering_counters(&self);
      mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_24)) }}";
      MUTABLE body = TRY (mIRLowering__ownership_transfer_marks(&self, name, :block_result, dest_alloc, TRUE));
      &body.append(CAST(BreakStmt{ label: COPY label, value: Emittable{ Ident: COPY ident_mutable }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable));
      MUTABLE result = MIRBlockExpr{ label: COPY label, body: COPY body, lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
      result.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY type_info }));
      RETURN Emittable{ MIRBlockExpr: COPY result };
    ELSE
      RETURN COPY mir;
    END
END
FN mIRLowering__place_or_branch_value_for_destination(MUTABLE self: MIRLowering, mir: Emittable, ast_node: Locatable) RETURNS !Emittable ->
    MUTABLE placed = TRY (mIRLowering__place_string_value_for_heap_destination(&self, mir, ast_node));
    IF !(TRY (mIRLowering__mir_allocates?(&self, placed))) THEN
      RETURN placed;
    END
    RETURN Emittable{ MIRBlockExpr: COPY TRY (mIRLowering__scoped_owning_branch_value(&self, placed, ast_node)) };
END
FN mIRLowering__place_string_value_for_heap_destination(MUTABLE self: MIRLowering, mir_input: Emittable, ast_node: Locatable) RETURNS !Emittable ->
    MUTABLE mir = COPY mir_input;
    IF TRY (mIRLowering__heap_owned_result?(&self, Emittable{ TryExpr: CAST(COPY mir AS TryExpr)}, ast_node)) THEN
      RETURN COPY Emittable{ TryExpr: CAST(COPY mir AS TryExpr)};
    END
    IF type__error_union?( TRY (type__from_node_mut(ast_node, "heap destination placement"))) THEN
      mir = TryExpr{ expr: Emittable{ TryExpr: CAST(COPY mir AS TryExpr)}, lowered_node_id: NIL, ownership_consumption: NIL };
    END
    RETURN Emittable{ DupeSlice: COPY DupeSlice{ source: Emittable{ TryExpr: CAST(COPY mir AS TryExpr)}, alloc: :heap, lowered_node_id: NIL, ownership_consumption: NIL } };
END
FN mIRLowering__place_string_value_for_destination(MUTABLE self: MIRLowering, mir_input: Emittable, ast_node: Locatable, dest_alloc: String@symbol) RETURNS !Emittable ->
    MUTABLE mir = COPY mir_input;
    MUTABLE effect = TRY (ownershipEffect__of(Emittable{ TryExpr: CAST(COPY mir AS TryExpr)}));
    IF effect.produces_owned THEN
      MUTABLE source_alloc: ?String@symbol = COPY effect.alloc;
      IF (source_alloc == dest_alloc) THEN
        RETURN COPY Emittable{ TryExpr: CAST(COPY mir AS TryExpr)};
      END
      IF source_alloc EXISTS AS source_alloc_value THEN
        RETURN TRY (mIRLowering__place_owned_alloc_mismatch_for_destination(&self, Emittable{ TryExpr: CAST(COPY mir AS TryExpr)}, TRY (type__from_node_mut(ast_node, "string destination placement")), dest_alloc, source_alloc_value));
      END
    END
    IF placement__heap?(dest_alloc) THEN
      RETURN TRY (mIRLowering__place_string_value_for_heap_destination(&self, Emittable{ TryExpr: CAST(COPY mir AS TryExpr)}, ast_node));
    END
    IF type__error_union?( TRY (type__from_node_mut(ast_node, "string destination placement"))) THEN
      mir = TryExpr{ expr: Emittable{ TryExpr: CAST(COPY mir AS TryExpr)}, lowered_node_id: NIL, ownership_consumption: NIL };
    END
    RETURN Emittable{ DupeSlice: COPY DupeSlice{ source: Emittable{ TryExpr: CAST(COPY mir AS TryExpr)}, alloc: COPY dest_alloc, lowered_node_id: NIL, ownership_consumption: NIL } };
END
FN mIRLowering__escaping_value_alloc(MUTABLE self: MIRLowering, type_info: ?Type) RETURNS !?String@symbol ->
    MUTABLE ti: ?Type = NIL;
    IF type_info != NIL THEN
      ti = COPY TRY (type__success_type(type_info));
    END
    IF ((ti != NIL) AND TRY (mIRLowering__ownership_bearing_type?(&self, ti))) THEN
      RETURN :heap;
    END
    RETURN NIL;
END
FN mIRLowering__active_tag_call(MUTABLE self: MIRLowering, value: Emittable) RETURNS !Call ->
    RETURN Call{ callee: "std.meta.activeTag", args: [value], try_wrap: FALSE, owned_return: FALSE, callable_contract: TRY (callableContract__no_ownership(1)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL };
END
FN mIRLowering__alloc_mark_type_info(MUTABLE self: MIRLowering, expr: Emittable, ast_node: Locatable, context: String) RETURNS !Type ->
    MUTABLE ti_opt: ?Type = TRY (type__from_node_mut(ast_node, context));
    IF !(ti_opt EXISTS) THEN
      RAISE Input, CompilerError, "${context}: missing type info";
    END
    MUTABLE ti: Type = UNWRAP (ti_opt);
    IF expr IS_A DeepCopy AS deep_copy THEN
    IF (deep_copy.zig_type OR_ELSE "").startsWith?("*") THEN
        IF TRY (type__heap_ptr?(ti)) THEN
          RETURN ti;
        END
        RETURN TRY (type__new( TypeConstructionInput{ Type: COPY ti }, NIL, NIL, :indirect));
      ELSE
        RETURN ti;
      END
    ELSE
      RETURN ti;
    END
END
FN mIRLowering__return_destination_alloc(MUTABLE self: MIRLowering, node: ReturnNode) RETURNS !?String@symbol ->
    IF !(node.value) THEN
      RETURN NIL;
    END
    MUTABLE value_type: ?Type = TRY (type__from_node_mut(node.value, "return destination allocation"));
    MUTABLE declared_type: ?Type@multiowned = TRY (mIRLowering__return_value_destination_type(&self, node));
    IF mIRLowering__current_function_heap_carry_return?(&self) THEN
      IF ((declared_type != NIL) AND TRY (mIRLowering__ownership_bearing_type?(&self, TRY (type__success_type(declared_type))))) THEN
        RETURN :heap;
      END
      RETURN TRY (mIRLowering__escaping_value_alloc(&self, value_type));
    END
    MUTABLE borrowed_owned = (TRY (mIRLowering__ownership_bearing_type?(&self, TRY (type__success_type( UNWRAP (value_type))))) OR (((declared_type != NIL) AND TRY (mIRLowering__ownership_bearing_type?(&self, TRY (type__success_type(declared_type)))))));
    IF (TRY (mIRLowering__borrowed_destination_node?(&self, UNWRAP (node.value))) AND borrowed_owned) THEN
      RETURN :heap;
    END
    RETURN NIL;
END
FN mIRLowering__scoped_owning_branch_value(MUTABLE self: MIRLowering, mir: Emittable, ast_node: Locatable) RETURNS !MIRBlockExpr ->
    MUTABLE block_id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_25 = mIRLowering__lowering_counters(&self);
    mIRLoweringCounters__next_block_expr_id(&rtoc_mutable_receiver_25) };
    MUTABLE tmp_id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_26 = mIRLowering__lowering_counters(&self);
    mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_26) };
    MUTABLE label = "__own_branch_${mIRLoweringGeneratedId__to_s(block_id)}";
    MUTABLE name = "__tmp_${mIRLoweringGeneratedId__to_s(tmp_id)}";
    MUTABLE type_info: ?Type = TRY (mIRLowering__alloc_mark_type_info(&self, mir, ast_node, "branch ownership placement"));
    MUTABLE entry: ?CleanupEntry@multiowned = TRY (mIRLowering__hoist_cleanup_entry(&self, mir, ast_node));
    IF entry EXISTS AS entry_value THEN
      MUTABLE entry_value_mutable = COPY entry_value;
      cleanupEntry__mark_moved_guard_mut(&entry_value_mutable);
    END
    MUTABLE materialized = BindingMaterialization{ name: COPY name, expr: COPY mir, alloc: :heap, type_info: CAST(COPY type_info AS Type), mutable: FALSE, cleanup_entry: entry, cleanup_mode: IF entry != NIL THEN
      :err
    ELSE
      :normal
    END, scope: :heap, annotation: NIL, suppression: NIL, ownership_tracked: TRUE };
    MUTABLE body: []Emittable = TRY (bindingMaterialization__statements(materialized));
    IF entry EXISTS AS entry_value THEN
      body = ruby_array_concat_Stmt(body, TRY (mIRLowering__ownership_transfer_marks(&self, name, :block_result, NIL, TRUE)));
    END
    &body.append(CAST(BreakStmt{ label: COPY label, value: Emittable{ Ident: COPY Ident{ name: COPY name, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable));
    MUTABLE out = MIRBlockExpr{ label: COPY label, body: COPY body, lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
    out.result_type = CAST(type_info AS ?Type);
    RETURN out;
END
FN mIRLowering__heap_owned_result?(MUTABLE self: MIRLowering, mir: Emittable, ast_node: Locatable) RETURNS !Bool ->
    MUTABLE effect = TRY (ownershipEffect__of(mir));
    IF (effect.produces_owned AND placement__heap?(effect.alloc)) THEN
      RETURN TRUE;
    END
    MUTABLE node = COPY ast_node;
    IF node IS_A MoveNode AS move_node THEN
      node = CAST(move_node.value AS Locatable);
    END
    IF (IF node IS_A Identifier AS identifier THEN aST__moved?(ast_node) ELSE FALSE END) THEN
      RETURN (TRY (mIRLowering__placement_for_node(&self, node)) == :heap);
    END
    RETURN !(!(((IF node IS_A Identifier AS identifier THEN ((identifier.symbol != NIL) AND ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_27 = ((identifier.symbol)?);
    symbolEntry__heap_storage?(rtoc_local_receiver_27) } == TRUE)) ELSE FALSE END))));
END
# Ruby's `lower` hands back either a node or an ARRAY of nodes, which the body
# builder splices. CLEAR's `lower` returns one node, so a multi-node lowering
# puts the rest where every other multi-statement lowering does: the pending
# list the packet builder flushes just before this statement.
PRIVATE FN mIRLoweringSpliceLoweredMir(MUTABLE self: MIRLowering, lowered: MIRLoweringLoweredMir) RETURNS ?Emittable ->
  IF lowered IS_A MIRLoweringLoweredMir.Emittable AS single THEN
    RETURN COPY single;
  END
  IF lowered IS_A MIRLoweringLoweredMir.ArrayValue AS items THEN
    FOR item IN items DO
      &self.state.function_state.pending_stmts.append(COPY item);
    END
  END
  RETURN NIL;
END
PUB FN mIRLowering__lower(MUTABLE self: MIRLowering, MUTABLE node: MIRLoweringLowerableStmt) RETURNS !?Emittable
  EFFECTS REENTRANT ->
    MUTABLE mir: ?Emittable = PARTIAL MATCH node START
      MIRLoweringLowerableStmt.ASTProgram AS MUTABLE ast_program -> Emittable{ MIRProgram: COPY UNWRAP (TRY (mIRLowering__lower_program(&self, &ast_program))) },
      MIRLoweringLowerableStmt.ImplementationDef AS implementation_def -> NIL,
      MIRLoweringLowerableStmt.ConformanceDef AS conformance_def -> NIL,
      MIRLoweringLowerableStmt.ProtocolDef AS protocol_def -> NIL,
      MIRLoweringLowerableStmt.Drop AS MUTABLE drop -> Emittable{ Cleanup: COPY TRY (mIRLowering__lower_drop(&self, drop)) },
      MIRLoweringLowerableStmt.AllocMark AS alloc_mark -> {
        MUTABLE rtoc_value_block_marker = 0;
        &self.state.function_state.lowered_alloc_names.insert(COPY alloc_mark.name);
        Emittable{ AllocMark: COPY alloc_mark }
      },
      MIRLoweringLowerableStmt.SuppressCleanup AS suppress_cleanup -> {
        MUTABLE rtoc_value_block_marker = 0;
        MUTABLE safe = mIRLowering__zig_safe_name(self, suppress_cleanup.name);
        # Ruby returns the marks as an ARRAY, which the body builder splices in.
        # CLEAR's `lower` hands back one node, so the marks go where every other
        # multi-statement lowering puts them: the pending list the packet
        # builder flushes just before this statement.
        IF mIRLowering__pipeline_guarded_cleanup_name?(&self, safe) THEN
          FOR mark IN TRY (mIRLowering__ownership_transfer_marks(&self, safe, :owned_sink, :heap, TRUE)) DO
            &self.state.function_state.pending_stmts.append(COPY mark);
          END
        END
        NIL
      },
      MIRLoweringLowerableStmt.Return AS return -> {
        MUTABLE rtoc_value_block_marker = 0;
        MUTABLE rename_map = TRY (functionState__rename_map(mIRLowering__function_state(&self)));
        MUTABLE escaped = (return.escaped_vars OR_ELSE Set[]) |> SELECT {
        MUTABLE escaped_safe_name = mIRLowering__zig_safe_name(self, _);
        (rename_map[escaped_safe_name] OR_ELSE escaped_safe_name)
      };
        Emittable{ ReturnMark: COPY ReturnMark{ escaped_vars: escaped, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }
      },
      MIRLoweringLowerableStmt.ReassignCleanup AS reassign_cleanup -> Emittable{ ReassignMark: COPY ReassignMark{ name: COPY reassign_cleanup.name, alloc: UNWRAP (COPY reassign_cleanup.alloc), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } },
      MIRLoweringLowerableStmt.FieldCleanup AS field_cleanup -> Emittable{ FieldCleanupMark: COPY FieldCleanupMark{ target_name: UNWRAP (COPY field_cleanup.target_name), field: CAST(COPY field_cleanup.field AS String), alloc: UNWRAP (COPY field_cleanup.alloc), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } },
      MIRLoweringLowerableStmt.EnumDef AS enum_def -> Emittable{ MIREnumDef: COPY mIRLowering__lower_enum_def(&self, enum_def) },
      MIRLoweringLowerableStmt.UnionDef AS MUTABLE union_def -> mIRLoweringSpliceLoweredMir(&self, TRY (mIRLowering__lower_union_def(&self, &union_def))),
      MIRLoweringLowerableStmt.StructDef AS MUTABLE struct_def -> TRY (mIRLowering__lower_struct_def(&self, &struct_def)),
      MIRLoweringLowerableStmt.ExternFnDecl AS MUTABLE extern_fn_decl -> TRY (mIRLowering__lower_extern_fn(&self, extern_fn_decl)),
      MIRLoweringLowerableStmt.ExternStructDecl AS MUTABLE extern_struct_decl -> castMIRLoweringReturnValueToEmittable__mir_lowering(TRY (mIRLowering__lower_extern_struct(&self, extern_struct_decl))),
      MIRLoweringLowerableStmt.VarDecl AS MUTABLE var_decl -> castNodeRootToEmittable(TRY (mIRLowering__lower_var_decl(&self, &var_decl))),
      MIRLoweringLowerableStmt.BindExpr AS MUTABLE bind_expr -> castNodeRootToEmittable(TRY (mIRLowering__lower_bind_expr(&self, &bind_expr))),
      MIRLoweringLowerableStmt.Assignment AS MUTABLE assignment -> TRY (mIRLowering__lower_assignment(&self, &assignment)),
      MIRLoweringLowerableStmt.DestructuringAssignment AS MUTABLE destructuring_assignment -> Emittable{ DestructureSet: COPY TRY (mIRLowering__lower_destructuring_assignment(&self, &destructuring_assignment)) },
      MIRLoweringLowerableStmt.IfStatement AS if_statement -> TRY (mIRLowering__lower_if(&self, if_statement)),
      MIRLoweringLowerableStmt.IsA AS MUTABLE is_a -> TRY (mIRLowering__lower_is_a(&self, &is_a)),
      MIRLoweringLowerableStmt.IfBind AS if_bind -> Emittable{ IfBindStmt: COPY TRY (mIRLowering__lower_if_bind(&self, if_bind)) },
      MIRLoweringLowerableStmt.WhileLoop AS while_loop -> Emittable{ WhileStmt: COPY TRY (mIRLowering__lower_while(&self, while_loop)) },
      MIRLoweringLowerableStmt.WhileBindLoop AS while_bind_loop -> Emittable{ WhileStmt: COPY TRY (mIRLowering__lower_while_bind(&self, while_bind_loop)) },
      MIRLoweringLowerableStmt.ForEach AS for_each -> TRY (mIRLowering__lower_for_each(&self, for_each)),
      MIRLoweringLowerableStmt.ForRange AS for_range -> Emittable{ ScopeBlock: COPY TRY (mIRLowering__lower_for_range(&self, for_range)) },
      MIRLoweringLowerableStmt.MatchStatement AS match_statement -> TRY (mIRLowering__lower_match(&self, match_statement)),
      MIRLoweringLowerableStmt.ReturnNode AS MUTABLE return_node -> castNodeRootToEmittable(TRY (mIRLowering__lower_return(&self, &return_node))),
      MIRLoweringLowerableStmt.BreakNode AS break_node -> Emittable{ BreakStmt: COPY BreakStmt{ label: NIL, value: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } },
      MIRLoweringLowerableStmt.OrElseBreak -> Emittable{ BreakStmt: COPY BreakStmt{ label: NIL, value: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } },
      MIRLoweringLowerableStmt.ContinueNode AS continue_node -> Emittable{ ContinueStmt: COPY ContinueStmt{ unused: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } },
      MIRLoweringLowerableStmt.PassStmt AS pass_stmt -> Emittable{ Noop: COPY Noop{ reason: "pass", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } },
      MIRLoweringLowerableStmt.DeferStmt AS MUTABLE defer_stmt -> Emittable{ MIRDeferStmt: COPY TRY (mIRLowering__lower_defer_stmt(&self, &defer_stmt)) },
      MIRLoweringLowerableStmt.FunctionDefMultiowned AS function_def_multiowned -> castMIRLoweringReturnValueToEmittable__mir_lowering(TRY (mIRLowering__lower_function_def(&self, CAST(COPY function_def_multiowned AS FunctionDef)))),
      MIRLoweringLowerableStmt.FuncCall AS MUTABLE func_call -> TRY (mIRLowering__lower_func_call(&self, &func_call)),
      MIRLoweringLowerableStmt.MethodCall AS MUTABLE method_call -> TRY (mIRLowering__lower_method_call(&self, &method_call)),
      MIRLoweringLowerableStmt.LambdaLit AS MUTABLE lambda_lit -> Emittable{ LambdaExpr: COPY TRY (mIRLowering__lower_lambda(&self, lambda_lit)) },
      MIRLoweringLowerableStmt.ListLit AS MUTABLE list_lit -> TRY (mIRLowering__lower_list_lit(&self, &list_lit)),
      MIRLoweringLowerableStmt.TupleLit AS MUTABLE tuple_lit -> Emittable{ TupleLiteral: COPY TRY (mIRLowering__lower_tuple_lit(&self, tuple_lit)) },
      MIRLoweringLowerableStmt.DefaultArrayLit AS MUTABLE default_array_lit -> Emittable{ ArrayDefaultInit: COPY TRY (mIRLowering__lower_default_array_lit(self, default_array_lit)) },
      MIRLoweringLowerableStmt.HashLit AS MUTABLE hash_lit -> TRY (mIRLowering__lower_hash_lit(&self, &hash_lit)),
      MIRLoweringLowerableStmt.Literal AS MUTABLE literal -> TRY (mIRLowering__lower_literal(self, literal)),
      MIRLoweringLowerableStmt.DefaultLit AS default_lit -> Emittable{ DefaultValue: COPY DefaultValue{ kind: :aggregate_empty, zig_type: NIL } },
      MIRLoweringLowerableStmt.Identifier AS MUTABLE identifier -> TRY (mIRLowering__lower_identifier(&self, &identifier)),
      MIRLoweringLowerableStmt.BinaryOp AS MUTABLE binary_op -> TRY (mIRLowering__lower_binary_op(&self, &binary_op)),
      MIRLoweringLowerableStmt.UnaryOp AS unary_op -> TRY (mIRLowering__lower_unary_op(&self, unary_op)),
      MIRLoweringLowerableStmt.GetField AS MUTABLE get_field -> TRY (mIRLowering__lower_get_field(&self, &get_field)),
      MIRLoweringLowerableStmt.GetIndex AS MUTABLE get_index -> TRY (mIRLowering__lower_get_index(&self, &get_index)),
      MIRLoweringLowerableStmt.StructLit AS MUTABLE struct_lit -> TRY (mIRLowering__lower_struct_lit(&self, &struct_lit)),
      MIRLoweringLowerableStmt.UnionVariantLit AS MUTABLE union_variant_lit -> TRY (mIRLowering__lower_union_variant_lit(&self, &union_variant_lit)),
      MIRLoweringLowerableStmt.StringConcat AS MUTABLE string_concat -> Emittable{ ConcatStr: COPY TRY (mIRLowering__lower_string_concat(&self, string_concat)) },
      MIRLoweringLowerableStmt.BlockExpr AS block_expr -> castMIRLoweringReturnValueToEmittable__mir_lowering(TRY (mIRLowering__lower_block_expr(&self, block_expr))),
      MIRLoweringLowerableStmt.RangeLit AS range_lit -> Emittable{ MIRRangeLit: COPY TRY (mIRLowering__lower_range_lit(&self, range_lit)) },
      MIRLoweringLowerableStmt.OptionalUnwrap AS optional_unwrap -> TRY (mIRLowering__lower_optional_unwrap(&self, optional_unwrap)),
      MIRLoweringLowerableStmt.Assert AS MUTABLE assert -> castMIRLoweringReturnValueToEmittable__mir_lowering(TRY (mIRLowering__lower_assert(&self, &assert))),
      MIRLoweringLowerableStmt.Raise AS raise_value -> Emittable{ ScopeBlock: COPY TRY (mIRLowering__lower_raise(&self, raise_value)) },
      MIRLoweringLowerableStmt.Cast AS cast -> TRY (mIRLowering__lower_cast(&self, cast)),
      MIRLoweringLowerableStmt.ThrowNode AS throw_node -> Emittable{ ReturnStmt: COPY ReturnStmt{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "error", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "CheatError", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } },
      MIRLoweringLowerableStmt.DieNode AS die_node -> {
        MUTABLE status_text: String = COPY "1";
        IF die_node.status EXISTS AS die_status THEN
          status_text = COPY CAST(die_status AS String);
        END
        Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ Call: COPY Call{ callee: "std.process.exit", args: [Emittable{ Lit: COPY Lit{ value: COPY status_text, lowered_node_id: NIL, ownership_consumption: NIL } }], try_wrap: FALSE, owned_return: FALSE, callable_contract: NIL, lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }
      },
      MIRLoweringLowerableStmt.CopyNode AS MUTABLE copy_node -> TRY (mIRLowering__lower_copy(&self, &copy_node)),
      MIRLoweringLowerableStmt.KeepNode AS MUTABLE keep_node -> TRY (mIRLowering__lower_clone(&self, keep_node)),
      MIRLoweringLowerableStmt.MoveNode AS MUTABLE move_node -> TRY (mIRLowering__lower_move(&self, &move_node)),
      MIRLoweringLowerableStmt.ShareNode AS MUTABLE share_node -> TRY (mIRLowering__lower_share(&self, share_node)),
      MIRLoweringLowerableStmt.CapabilityWrap AS MUTABLE capability_wrap -> TRY (mIRLowering__lower_cap_wrap(&self, &capability_wrap)),
      MIRLoweringLowerableStmt.LinkNode AS MUTABLE link_node -> Emittable{ RcDowngrade: COPY TRY (mIRLowering__lower_link(&self, link_node)) },
      MIRLoweringLowerableStmt.ResolveNode AS MUTABLE resolve_node -> Emittable{ WeakUpgrade: COPY TRY (mIRLowering__lower_resolve(&self, resolve_node)) },
      MIRLoweringLowerableStmt.FreezeNode AS MUTABLE freeze_node -> Emittable{ FreezeExpr: COPY TRY (mIRLowering__lower_freeze(&self, &freeze_node)) },
      MIRLoweringLowerableStmt.Copy AS copy -> {
        MUTABLE copy_value = castLocatableToMIRLoweringLowerableStmt__mir_lowering(COPY copy.value);
        TRY (mIRLowering__lower(&self, &copy_value))
      },
      MIRLoweringLowerableStmt.Slice AS MUTABLE slice -> Emittable{ SliceExpr: COPY TRY (mIRLowering__lower_slice(&self, &slice)) },
      MIRLoweringLowerableStmt.BgBlock AS MUTABLE bg_block -> Emittable{ MIRBgBlock: COPY TRY (mIRLowering__lower_bg_block(&self, &bg_block)) },
      MIRLoweringLowerableStmt.BgStreamBlock AS MUTABLE bg_stream_block -> castMIRLoweringReturnValueToEmittable__mir_lowering(TRY (mIRLowering__lower_bg_stream_block(&self, bg_stream_block))),
      MIRLoweringLowerableStmt.WithBlockMultiowned AS with_block_multiowned -> castMIRLoweringReturnValueToEmittable__mir_lowering(TRY (mIRLowering__lower_with_block(&self, CAST(COPY with_block_multiowned AS WithBlock)))),
      MIRLoweringLowerableStmt.DoBlock AS do_block -> Emittable{ MIRDoBlock: COPY TRY (mIRLowering__lower_do_block(&self, do_block)) },
      MIRLoweringLowerableStmt.TestBlock AS MUTABLE test_block -> {
        FOR test_def IN TRY (mIRLowering__lower_test_block(&self, test_block)) DO
          &self.state.function_state.pending_stmts.append(Emittable{ TestDef: COPY test_def });
        END
        NIL
      },
      MIRLoweringLowerableStmt.RequireNode AS MUTABLE require_node -> mIRLoweringSpliceLoweredMir(&self, TRY (mIRLowering__lower_require(&self, require_node))),
      MIRLoweringLowerableStmt.YieldExpr AS MUTABLE yield_expr -> TRY (mIRLowering__lower_yield(&self, &yield_expr)),
      MIRLoweringLowerableStmt.CloseStream AS close_stream -> TRY (mIRLowering__lower_close_stream(&self, close_stream)),
      MIRLoweringLowerableStmt.NextExpr AS MUTABLE next_expr -> TRY (mIRLowering__lower_next_expr(&self, &next_expr)),
      MIRLoweringLowerableStmt.StaticCall AS MUTABLE static_call -> TRY (mIRLowering__lower_static_call(&self, static_call)),
      MIRLoweringLowerableStmt.OrElseRaise -> Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "error", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "OrElseRaise", lowered_node_id: NIL, ownership_consumption: NIL } },
      MIRLoweringLowerableStmt.OrElsePass -> Emittable{ DefaultValue: COPY DefaultValue{ kind: :undefined, zig_type: NIL } },
      MIRLoweringLowerableStmt.OrElsePrune -> Emittable{ DefaultValue: COPY DefaultValue{ kind: :undefined, zig_type: NIL } },
      MIRLoweringLowerableStmt.OrElseExit AS or_else_exit -> Emittable{ ScopeBlock: COPY TRY (mIRLowering__lower_or_else_exit(&self, or_else_exit)) },
      MIRLoweringLowerableStmt.ThenChain AS then_chain -> panic("Internal: ThenChain should be flattened by BgBlock lowering"),
      MIRLoweringLowerableStmt.AssertRaisesMultiowned AS assert_raises_multiowned -> Emittable{ AssertRaisesCheck: COPY TRY (mIRLowering__lower_assert_raises(&self, CAST(COPY assert_raises_multiowned AS AssertRaises))) },
      MIRLoweringLowerableStmt.StubDecl AS MUTABLE stub_decl -> castNodeRootToEmittable(UNWRAP (TRY (mIRLowering__lower_stub_decl(&self, &stub_decl)))),
      MIRLoweringLowerableStmt.BenchmarkStmtMultiowned AS benchmark_stmt_multiowned -> Emittable{ Comment: COPY mIRLowering__lower_benchmark(self, CAST(COPY benchmark_stmt_multiowned AS BenchmarkStmt)) },
      MIRLoweringLowerableStmt.SmashStmtMultiowned AS smash_stmt_multiowned -> Emittable{ Comment: COPY mIRLowering__lower_smash(self, CAST(COPY smash_stmt_multiowned AS SmashStmt)) },
      MIRLoweringLowerableStmt.ProfileStmtMultiowned AS profile_stmt_multiowned -> Emittable{ Comment: COPY mIRLowering__lower_profile(self, CAST(COPY profile_stmt_multiowned AS ProfileStmt)) },
      DEFAULT -> panic("MIRLowering: unhandled node type {} at {}")
    END;
    # Ruby's `node.is_a?(AST::Locatable)`: this union names the AST nodes
    # individually alongside the MIR markers, so the question is whether the
    # node projects back to a Locatable at all.
    IF castMIRLoweringLowerableStmtToLocatable(node) EXISTS AS locatable THEN
      MUTABLE locatable_mutable = COPY locatable;
      RETURN TRY (mIRLowering__apply_lowered_coercion(&self, &mir, &locatable_mutable));
    ELSE
      RETURN mir;
    END
END
FN mIRLowering__apply_lowered_coercion(MUTABLE self: MIRLowering, MUTABLE mir: ?Emittable, MUTABLE node: Locatable) RETURNS !?Emittable ->
    IF !((((mir != NIL) AND TRUE) AND locatable__coerced_type(node))) THEN
      RETURN COPY mir;
    END
    MUTABLE coerced_type = TRY (type__new( CAST((locatable__coerced_type_info(node) OR locatable__coerced_type(node)) AS TypeConstructionInput)));
    IF !(locatable__typed?(node)) THEN
      RETURN COPY mir;
    END
    MUTABLE actual_type = TRY (aST__full_type_mut(node));
    IF (type__semantic_type_key(coerced_type) == type__semantic_type_key(actual_type)) THEN
      RETURN COPY mir;
    END
    IF TRY (mIRLowering__stack_fixed_array_coercion?(&self, node)) THEN
      RETURN COPY mir;
    END
    IF (TRY (type__node_reference?(coerced_type)) AND TRY (type__node_reference?(actual_type))) THEN
      RETURN COPY mir;
    END
    IF TRY (mIRLowering__carrier_only_coercion?(&self, actual_type, coerced_type)) THEN
      RETURN COPY mir;
    END
    IF (TRY (type__node_reference?(coerced_type)) AND !(TRY (type__node_reference?(actual_type)))) THEN
      IF (type__resolved(actual_type) == symbol("NIL")) THEN
        RETURN COPY CAST(StructInit{ zig_type: TRY (type__zig_type(coerced_type)), fields: List[], lowered_node_id: NIL, ownership_consumption: NIL } AS Emittable);
      END
      MUTABLE coerced_mir: Emittable = COPY mir;
      RETURN COPY TRY (mIRLowering__node_create_mir(&self, &coerced_mir, coerced_type, &node));
    END
    MUTABLE union_wrapped: ?Emittable = TRY (mIRLowering__lower_union_payload_coercion(&self, mir, &node, actual_type, coerced_type));
    IF union_wrapped EXISTS AS union_wrapped_value THEN
      RETURN COPY union_wrapped_value;
    END
    IF TRY (mIRLowering__mir_cast(self, mir, actual_type, TypeTypeInput{ Type: COPY coerced_type })) != NIL THEN
    RETURN TRY (mIRLowering__mir_cast(self, mir, actual_type, TypeTypeInput{ Type: COPY coerced_type }));
    ELSE
    RETURN COPY mir;
    END
END
FN mIRLowering__carrier_only_coercion?(MUTABLE self: MIRLowering, actual_type: Type, coerced_type: Type) RETURNS !Bool ->
    MUTABLE coerced_payload = TRY (type__non_optional_type(coerced_type));
    MUTABLE actual_payload = TRY (type__non_optional_type(actual_type));
    IF !((TRY (type__any_rc?(coerced_payload)) OR type__any_sync?(coerced_payload))) THEN
      RETURN FALSE;
    END
    IF (TRY (type__any_rc?(actual_payload)) OR type__any_sync?(actual_payload)) THEN
      RETURN FALSE;
    END
    RETURN (type__resolved(coerced_payload) == type__resolved(actual_payload));
END
FN mIRLowering__lower_union_payload_coercion(MUTABLE self: MIRLowering, mir: Emittable, MUTABLE node: Locatable, actual_type: Type, coerced_type: Type) RETURNS !?Emittable ->
    MUTABLE target_type = TRY (type__value_payload_type(coerced_type));
    MUTABLE schema: ?UnionSchema@multiowned = COPY (TRY (mIRLowering__union_schemas(&self)))[type__resolved(target_type)];
    IF schema == NIL THEN
      MUTABLE schema_lookup = mIRLowering__mir_schema_lookup(&self);
      IF schema_lookup(type__resolved(target_type)) EXISTS AS looked_up THEN
        IF looked_up IS_A UnionSchema AS looked_up_schema THEN
          schema = COPY looked_up_schema;
        END
      END
    END
    IF schema EXISTS AS schema_value THEN
      MUTABLE schema_value_mutable = COPY schema_value;
      MUTABLE compared_actual_branch_value: ?Type = NIL;
      IF type__optional?(actual_type) THEN
        compared_actual_branch_value = UNWRAP (TRY (type__wrapped_type(actual_type)));
      ELSE
        compared_actual_branch_value = COPY actual_type;
      END
      MUTABLE compared_actual: Type = compared_actual_branch_value?;
      MUTABLE variant_name, payload_type = TRY (mIRLowering__unique_mir_union_payload_variant(&self, schema_value_mutable, compared_actual));
      IF variant_name EXISTS AS variant_name_value THEN
        MUTABLE variant_name_value_mutable = COPY variant_name_value;
        IF payload_type THEN
          IF (type__optional?(actual_type) AND type__optional?(coerced_type)) THEN
            MUTABLE capture = "_union_payload_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_30 = mIRLowering__lowering_counters(&self);
            mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_30)) }}";
            MUTABLE wrapped = StructInit{ zig_type: TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY target_type })), fields: [CAST(StructInitField{ name: symbol(variant_name_value_mutable), value: Emittable{ Ident: COPY Ident{ name: COPY capture, lowered_node_id: NIL, ownership_consumption: NIL } }, alloc: NIL } AS Any)], lowered_node_id: NIL, ownership_consumption: NIL };
            MUTABLE result = IfOptional{ optional: COPY mir, capture: COPY capture, then_expr: Emittable{ StructInit: COPY wrapped }, else_expr: Emittable{ Lit: COPY Lit{ value: "null", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
            result.result_type = COPY coerced_type;
            RETURN Emittable{ IfOptional: COPY result };
          END
          RETURN TRY (mIRLowering__union_payload_coercion_value(&self, mir, node, target_type, variant_name_value_mutable, CAST(COPY payload_type AS Type)));
        ELSE
          RETURN NIL;
        END
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
END
FN mIRLowering__unique_mir_union_payload_variant(MUTABLE self: MIRLowering, schema: UnionSchema, actual_type: Type) RETURNS !Tuple<?String, ?Type> ->
    # Ruby's `variants.filter_map { |name, payload| ... }` walks the PAIRS of a
    # hash; CLEAR pipelines a list, so the walk is over the keys.
    MUTABLE matches: []Tuple<String, Type> = List[];
    FOR variant_name IN schema.variants.keys() DO
      IF schema.variants[variant_name] EXISTS AS payload_value THEN
        IF payload_value IS_A Type AS payload_type THEN
          IF TRY (mIRLowering__mir_union_payload_matches?(&self, payload_type, actual_type)) THEN
            &matches.append(Tuple{COPY CAST(variant_name AS String), COPY payload_type});
          END
        END
      END
    END
    IF (matches.length() == 1) THEN
      MUTABLE only_match = UNWRAP (matches[0]);
      RETURN Tuple{COPY only_match._0, COPY only_match._1};
    END
    RETURN CAST(Tuple{NIL, NIL} AS Tuple<?String, ?Type>);
END
FN mIRLowering__mir_union_payload_matches?(MUTABLE self: MIRLowering, payload_type: Type, actual_type: Type) RETURNS !Bool ->
    MUTABLE payload_surface = TRY (type__coercion_surface_name(TypeTypeInput{ Type: COPY payload_type }));
    MUTABLE actual_surface = TRY (type__coercion_surface_name(TypeTypeInput{ Type: COPY actual_type }));
    IF (payload_surface == actual_surface) THEN
      RETURN TRUE;
    END
    IF (TRY (type__string?(payload_type)) OR TRY (type__string?(actual_type))) THEN
      RETURN FALSE;
    END
    RETURN TRY (type__accepts?(payload_type, actual_type));
END
FN mIRLowering__union_payload_coercion_value(MUTABLE self: MIRLowering, mir: Emittable, node: Locatable, union_type: Type, variant_name: String, payload_type: Type) RETURNS !Emittable ->
    MUTABLE ast_node = COPY node;
    MUTABLE target_alloc: String@symbol = (mIRLowering__function_state(&self).current_decl_alloc OR_ELSE TRY (mIRLowering__alloc_for_node(&self, ast_node)));
    MUTABLE payload = TRY (mIRLowering__materialize_owned_sink_value(&self, mir, ast_node, target_alloc, TypeTypeInput{ Type: COPY payload_type }));
    IF TRY (mIRLowering__mir_allocates?(&self, payload)) THEN
      payload = TRY (mIRLowering__hoist_alloc(&self, &payload, &ast_node, TRUE));
    END
    RETURN Emittable{ StructInit: COPY castEmittableToStructInit(TRY (mIRLowering__with_ownership_consumption(&self, Emittable{ StructInit: COPY StructInit{ zig_type: TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY union_type })), fields: [CAST(StructInitField{ name: symbol(variant_name), value: COPY payload, alloc: NIL } AS Any)], lowered_node_id: NIL, ownership_consumption: NIL } }, TRY (mIRLowering__mir_ident_names(self, payload)), "MIR::StructInit", :owned_sink, target_alloc))) };
END
FN mIRLowering__stack_fixed_array_coercion?(MUTABLE self: MIRLowering, node: Locatable) RETURNS !Bool ->
    IF node IS_A ListLit AS list_lit THEN
      MUTABLE list_lit_mutable = COPY list_lit;
    IF (list_lit_mutable.storage == :stack) THEN
        MUTABLE coerced_type = TRY (aST__full_type_mut( Locatable{ ListLit: COPY list_lit_mutable }));
        RETURN ((TRUE) AND (type__fixed?(coerced_type) == TRUE));
      ELSE
        RETURN FALSE;
      END
    ELSE
      RETURN FALSE;
    END
END
PUB FN mIRLowering__lower_body(MUTABLE self: MIRLowering, stmts: []MIRLoweringLowerableStmt) RETURNS ![]Emittable
  EFFECTS REENTRANT ->
    RETURN TRY (mIRLowering__finalize_lowered_body_construction_mut(&self, TRY (mIRLowering__construct_lowered_body(&self, stmts))));
END
FN mIRLowering__construct_lowered_body(MUTABLE self: MIRLowering, stmts: []MIRLoweringLowerableStmt) RETURNS !LoweredBodyConstruction
  EFFECTS REENTRANT ->
    MUTABLE state = mIRLowering__initial_ownership_finalization_context(&self);
    MUTABLE packets: []LoweredStmtPacket = List[];
    FOR MUTABLE rtoc_for_elem_1903 IN stmts DO
    MUTABLE packet: ?LoweredStmtPacket = TRY (mIRLowering__lowered_stmt_packet(&self, state, &rtoc_for_elem_1903));
    IF packet EXISTS AS packet_value THEN
        &packets.append(packet_value);
    END
    END
    RETURN LoweredBodyConstruction{ packets: COPY packets, finalization_context: COPY state };
END
FN mIRLowering__initial_ownership_finalization_context(MUTABLE self: MIRLowering) RETURNS OwnershipFinalizationContext ->
    MUTABLE state = OwnershipFinalizationContext{ inherited_alloc_names: COPY mIRLowering__function_state(&self).lowered_alloc_names, parent: NIL, out: List[], guarded_cleanup_names: COPY mIRLowering__function_state(&self).lowered_guarded_cleanup_names, alloc_marks: {}, body_alloc_mark_names: COPY Set[], transfer_mark_names: COPY Set[], body_transfer_mark_names: COPY Set[], move_mark_names: COPY Set[], cleanup_by_name: {} };
    RETURN state;
END
FN mIRLowering__finalize_lowered_body_construction_mut(MUTABLE self: MIRLowering, construction: LoweredBodyConstruction) RETURNS ![]Emittable ->
    MUTABLE state = COPY construction.finalization_context;
    mIRLowering__seed_cleanup_owner_index_mut(&self, &state, construction.packets |> UNNEST (_.pending + loweredMir__nodes(_.mir)));
    FOR _ IN construction.packets DO
    TRY (mIRLowering__append_pending_packet_nodes_mut(&self, &state, _));
    TRY (mIRLowering__append_lowered_statement_packet_mut(&self, &state, _));
    END
    TRY (mIRLowering__mark_ownership_finalized_body_mut(&self, state.out));
    RETURN COPY state.out;
END
FN mIRLowering__mark_ownership_finalized_body_mut(MUTABLE self: MIRLowering, body: []Emittable) RETURNS ![]Emittable ->
    &self.state.ownership.finalized_body_ids.insert(COPY mIRLowering__lowered_body_id(&self, body));
    RETURN COPY body;
END
FN mIRLowering__ownership_finalized_body?(MUTABLE self: MIRLowering, body: []Emittable) RETURNS Bool ->
    RETURN mIRLowering__ownership_state(&self).finalized_body_ids.contains?(mIRLowering__lowered_body_id(&self, body));
END
FN mIRLowering__ownership_finalized_node?(MUTABLE self: MIRLowering, node: Emittable) RETURNS Bool ->
    MUTABLE node_id: ?LoweredNodeId = emittable__lowered_node_id(node);
    RETURN !(!(((node_id AND mIRLowering__ownership_state(&self).finalized_node_ids.contains?(node_id)))));
END
FN mIRLowering__mark_ownership_finalized_node_mut(MUTABLE self: MIRLowering, MUTABLE node: Emittable) RETURNS Void ->
    &self.state.ownership.finalized_node_ids.insert(mIRLowering__ensure_lowered_node_id(&self, &node));
    NIL;
END
FN mIRLowering__ensure_lowered_node_id(MUTABLE self: MIRLowering, MUTABLE node: Emittable) RETURNS LoweredNodeId ->
    MUTABLE existing: ?LoweredNodeId = emittable__lowered_node_id(node);
    IF existing THEN
      RETURN existing;
    END
    MUTABLE next_id = self.state.ownership.next_lowered_node_id;
    self.state.ownership.next_lowered_node_id = (next_id + 1);
    MUTABLE assigned = LoweredNodeId{ value: next_id };
    emittable__set_lowered_node_id_mut(&node, assigned);
    RETURN assigned;
END
# Ruby recognises a child it already yielded with `equal?`. A value language
# has no object identity, so the walk stamps every child with a lowered node id
# first -- the same ids Ruby's ensure_lowered_node_id hands out lazily.
FN mIRLowering__ensure_expr_child_ids_mut(MUTABLE self: MIRLowering, MUTABLE node: Emittable) RETURNS Void ->
    MUTABLE next_id = self.state.ownership.next_lowered_node_id;
    next_id = emittable__ensure_expr_child_ids_mut(&node, next_id);
    self.state.ownership.next_lowered_node_id = next_id;
END
FN mIRLowering__lowered_body_id(MUTABLE self: MIRLowering, body: []Emittable) RETURNS LoweredBodyId ->
    MUTABLE node_ids: []LoweredNodeId = List[];
    FOR MUTABLE rtoc_mutable_block_param_35 IN body DO
    &node_ids.append(mIRLowering__ensure_lowered_node_id(&self, &rtoc_mutable_block_param_35));
    END
    RETURN LoweredBodyId{ node_ids: COPY node_ids };
END
FN mIRLowering__mark_ownership_finalized_nodes_mut(MUTABLE self: MIRLowering, nodes: []Emittable) RETURNS Void ->
    FOR MUTABLE rtoc_for_elem_1995 IN nodes DO
    mIRLowering__mark_ownership_finalized_node_mut(&self, &rtoc_for_elem_1995);
    END
    NIL;
END
FN mIRLowering__append_pending_packet_nodes_mut(MUTABLE self: MIRLowering, MUTABLE state: OwnershipFinalizationContext, packet: LoweredStmtPacket) RETURNS !Void ->
    FOR MUTABLE rtoc_for_elem_2005 IN (packet.pending |> WHERE TRUE) DO
    TRY (mIRLowering__append_ownership_finalized_node_mut(&self, &state, &rtoc_for_elem_2005, [rtoc_for_elem_2005], NIL, NIL));
    END
    NIL;
END
FN mIRLowering__seed_cleanup_owner_index_mut(MUTABLE self: MIRLowering, MUTABLE state: OwnershipFinalizationContext, body: []Emittable) RETURNS Void
  EFFECTS REENTRANT ->
    FOR _ IN body DO
    IF _ IS_A Cleanup AS cleanup THEN
      MUTABLE name = COPY CAST(cleanup.name AS String);
      state.cleanup_by_name[COPY name] = (COPY state.cleanup_by_name[name] OR_ELSE Emittable{ Cleanup: COPY cleanup });
      IF mIRLowering__cleanup_entry_moved_guard?(&self, cleanup.cleanup_entry) THEN
        &state.guarded_cleanup_names.insert(name);
      END
    ELSE_IF _ IS_A ErrCleanup AS err_cleanup THEN
      MUTABLE name = COPY CAST(err_cleanup.name AS String);
      state.cleanup_by_name[COPY name] = (COPY state.cleanup_by_name[name] OR_ELSE Emittable{ ErrCleanup: COPY err_cleanup });
      IF mIRLowering__cleanup_entry_moved_guard?(&self, err_cleanup.cleanup_entry) THEN
        &state.guarded_cleanup_names.insert(name);
      END
    ELSE
      # `child_exprs` and `body_slots` already hold Emittables; Ruby's
      # `when MIR::Emittable` guard has no CLEAR counterpart because the
      # element type carries it.
      FOR child IN emittable__child_exprs(_) DO
        mIRLowering__seed_cleanup_owner_index_mut(&self, &state, [child]);
      END
      FOR slot IN emittable__body_slots(_) DO
        mIRLowering__seed_cleanup_owner_index_mut(&self, &state, slot.body);
      END
    END
    END
    NIL;
END
FN mIRLowering__cleanup_entry_moved_guard?(MUTABLE self: MIRLowering, entry: CleanupEntry) RETURNS Bool ->
    RETURN cleanupEntry__has_moved_guard?(entry);
END
FN mIRLowering__append_lowered_statement_packet_mut(MUTABLE self: MIRLowering, MUTABLE state: OwnershipFinalizationContext, packet: LoweredStmtPacket) RETURNS !Void ->
    MUTABLE packet_mir = COPY packet.mir;
    MUTABLE packet_nodes: []Emittable = List[];
    IF packet_mir IS_A []Emittable AS array THEN
      packet_nodes = COPY array;
    ELSE
      packet_nodes = CAST([CAST(packet_mir AS Emittable)] AS []Emittable);
    END
    MUTABLE mir_nodes = TRY (mIRLowering__normalize_allocating_mir_body(&self, packet_nodes));
    TRY (mIRLowering__merge_body_mark_names_mut(&self, &state, NodeRoot{ ArrayValue: COPY mir_nodes }));
    MUTABLE line: ?Int64 = packet.source_line;
    MUTABLE col: ?Int64 = packet.source_column;
    IF line EXISTS AS line_value THEN
      &state.out.append(Emittable{ Comment: COPY Comment{ text: "CLR:${line_value.toString()}", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    END
    TRY (mIRLowering__append_transfer_marks_to_body_mut(&self, &state, packet.stmt_transfer_marks, line, col));
    FOR MUTABLE rtoc_for_item_2076 IN mir_nodes DO
    TRY (mIRLowering__append_ownership_finalized_node_mut(&self, &state, &rtoc_for_item_2076, mir_nodes, line, col));
    END
    MUTABLE marks = mir_nodes |> UNNEST TRY (mIRLowering__ownership_transfers_for_node(&self, _, state));
    TRY (mIRLowering__append_transfer_marks_to_body_mut(&self, &state, TRY (mIRLowering__dedupe_transfer_marks(&self, marks)), line, col));
    NIL;
END
FN mIRLowering__append_already_finalized_node_mut(MUTABLE self: MIRLowering, MUTABLE state: OwnershipFinalizationContext, MUTABLE node: Emittable) RETURNS !Void
  EFFECTS REENTRANT ->
    &state.out.append(COPY node);
    TRY (mIRLowering__record_ownership_finalization_node_mut(&self, &state, NodeRoot{ Emittable: COPY node }));
    TRY (mIRLowering__append_transfer_marks_mut(&self, TRY (mIRLowering__ownership_transfers_for_targets(&self, TRY (mIRLowering__ownership_transfer_operands_for_node(&self, node, state)), state)), &state));
    NIL;
END
FN mIRLowering__append_ownership_finalized_node_mut(MUTABLE self: MIRLowering, MUTABLE state: OwnershipFinalizationContext, MUTABLE node: Emittable, body: []Emittable, line: ?Int64, col: ?Int64) RETURNS !Void ->
    IF mIRLowering__ownership_finalized_node?(&self, node) THEN
      TRY (mIRLowering__append_already_finalized_node_mut(&self, &state, &node));
      RETURN;
    END
    TRY (mIRLowering__finalize_nested_mir_bodies_mut(&self, &node, state));
    mIRLowering__stamp_source_line_mut(&self, &node, line, col);
    TRY (mIRLowering__append_transfer_marks_to_body_mut(&self, &state, TRY (mIRLowering__pre_terminator_transfer_marks(&self, node, state.out, body)), line, col));
    MUTABLE node_index = state.out.length();
    &state.out.append(COPY node);
    TRY (mIRLowering__append_move_guard_for_transfer_mark_mut(&self, node, &state));
    MUTABLE surface = TRY (mIRLowering__scan_ownership_surface_mut(&self, &state, NodeRoot{ Emittable: COPY node }, TRUE, TRUE));
    state.out = ruby_array_concat_Emittable__mir_lowering(state.out, CAST(surface.facts AS []Emittable));
    mIRLowering__mark_ownership_finalized_node_mut(&self, &node);
    mIRLowering__mark_ownership_finalized_nodes_mut(&self, CAST(surface.facts AS []Emittable));
    MUTABLE transfer_index = state.out.length();
    TRY (mIRLowering__append_transfer_marks_to_body_mut(&self, &state, TRY (mIRLowering__ownership_transfers_for_targets(&self, surface.transfer_targets, state)), line, col));
    IF (mIRLowering__terminator_stmt?(&self, node) AND (state.out.length() > transfer_index)) THEN
      MUTABLE moved_tail: []Emittable = ( { MUTABLE rtoc_tail_list: []Emittable = List[]; rtoc_tail_list } );
      MUTABLE tail_idx: Int64 = transfer_index;
      WHILE (tail_idx < state.out.length()) DO
        &moved_tail.append(COPY UNWRAP (state.out[tail_idx]));
        tail_idx = (tail_idx + 1);
      END
      WHILE (state.out.length() > transfer_index) DO
        &state.out.remove(state.out.length() - 1);
      END
      MUTABLE insert_idx: Int64 = 0;
      WHILE (insert_idx < moved_tail.length()) DO
        &state.out.insertAt((node_index + insert_idx), COPY UNWRAP (moved_tail[insert_idx]));
        insert_idx = (insert_idx + 1);
      END
    END
    NIL;
END
FN mIRLowering__terminator_stmt?(MUTABLE self: MIRLowering, node: Emittable) RETURNS Bool ->
    RETURN ((node IS_A ReturnStmt OR node IS_A BreakStmt) OR node IS_A ContinueStmt);
END
FN mIRLowering__append_transfer_marks_to_body_mut(MUTABLE self: MIRLowering, MUTABLE state: OwnershipFinalizationContext, marks: []Emittable, line: ?Int64, col: ?Int64) RETURNS !Void ->
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < marks.length() DO
      IF (marks[rtoc_idx]? IS_A MoveMark AND state.move_mark_names.contains?(CAST((emittable__name(UNWRAP (marks[rtoc_idx]))) AS String))) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF (marks[rtoc_idx]? IS_A TransferMark AND state.transfer_mark_names.contains?(CAST((emittable__name(UNWRAP (marks[rtoc_idx]))) AS String))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF mIRLowering__ownership_finalized_node?(&self, castStmtToEmittable(marks[rtoc_idx]?)) THEN
          TRY (mIRLowering__append_already_finalized_node_mut(&self, &state, castStmtToEmittable(marks[rtoc_idx]?)));
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      mIRLowering__stamp_source_line_mut(&self, castStmtToEmittable(marks[rtoc_idx]?), line, col);
      &state.out.append(castStmtToEmittable(COPY marks[rtoc_idx]?));
      MUTABLE facts: []MIRLoweringOwnershipFact = List[];
      MUTABLE mark_emittable: Emittable = castStmtToEmittable(marks[rtoc_idx]?);
      facts = TRY (mIRLowering__ownership_facts_for_structural_node(&self, &mark_emittable));
      state.out = ruby_array_concat_Emittable__mir_lowering(state.out, CAST(facts AS []Emittable));
      mIRLowering__mark_ownership_finalized_node_mut(&self, castStmtToEmittable(marks[rtoc_idx]?));
      mIRLowering__mark_ownership_finalized_nodes_mut(&self, CAST(facts AS []Emittable));
      TRY (mIRLowering__record_ownership_finalization_node_mut(&self, &state, castStmtToNodeRoot(marks[rtoc_idx]?)));
      IF !(marks[rtoc_idx]? IS_A TransferMark) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE before_guard = state.out.length();
      TRY (mIRLowering__append_move_guard_for_transfer_mark_mut(&self, castStmtToEmittable(marks[rtoc_idx]?), &state));
      IF (state.out.length() > before_guard) THEN
          # Ruby's `out[before_guard..]`; CLEAR lists have no slice, so the
          # tail is walked by index.
          MUTABLE stamp_idx: Int64 = before_guard;
          WHILE stamp_idx < state.out.length() DO
            MUTABLE stamp_node: Emittable = UNWRAP (state.out[stamp_idx]);
            mIRLowering__stamp_source_line_mut(&self, &stamp_node, line, col);
            state.out[stamp_idx] = COPY stamp_node;
            stamp_idx = stamp_idx + 1;
          END
      END
    rtoc_idx = rtoc_idx + 1;
    END
    NIL;
END
FN mIRLowering__emitted_guarded_cleanup_for_name?(MUTABLE self: MIRLowering, nodes: []Emittable, name: String) RETURNS Bool ->
    RETURN nodes |> ANY (IF !((_ IS_A Cleanup OR _ IS_A ErrCleanup)) THEN FALSE ELSE ((emittable__name(_) == name) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_37: ?CleanupEntry@multiowned = emittable__cleanup_entry(_);
    cleanupEntry__has_moved_guard?( UNWRAP (rtoc_local_receiver_37)) }) END);
END
FN mIRLowering__dedupe_transfer_marks(MUTABLE self: MIRLowering, marks: []Emittable) RETURNS ![]Emittable ->
    MUTABLE seen: [Set]String = Set[];
    MUTABLE deduped: []Emittable = List[];
    FOR mark IN marks DO
      MUTABLE mark_name: String = "";
      IF aST__node_name(castEmittableToLocatable__mir_lowering(mark)) EXISTS AS named THEN
        mark_name = COPY CAST(named AS String);
      END
      MUTABLE mark_target: String = "";
      IF emittable__transfer_target(mark) EXISTS AS targeted THEN
        mark_target = COPY CAST(targeted AS String);
      END
      MUTABLE key = "${emittable__variant_name(mark)}|${mark_name}|${mark_target}";
      IF !(seen.contains?(key)) THEN
        &seen.insert(COPY key);
        &deduped.append(COPY mark);
      END
    END
    RETURN deduped;
END
FN mIRLowering__lowered_stmt_packet(MUTABLE self: MIRLowering, state: OwnershipFinalizationContext, MUTABLE stmt: MIRLoweringLowerableStmt) RETURNS !?LoweredStmtPacket
  EFFECTS REENTRANT ->
    MUTABLE mir: ?Emittable = TRY (mIRLowering__lower(&self, &stmt));
    MUTABLE discard_result = TRY (mIRLowering__materialize_statement_discard(&self, stmt, NodeRoot{ Emittable: COPY UNWRAP (mir) }));
    mir = castNodeRootToEmittable(COPY discard_result._0);
    MUTABLE hoisted_discard: Bool = discard_result._1;
    MUTABLE pending = TRY (mIRLowering__flush_pending(&self));
    IF (mIRLowering__discard_expr_stmt?(&self, stmt, mir) AND !(hoisted_discard)) THEN
      mir = Emittable{ ExprStmt: COPY ExprStmt{ expr: COPY UNWRAP (mir), discard: TRUE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
    MUTABLE token: ?Token = NIL;
    IF castMIRLoweringLowerableStmtToLocatable(stmt) EXISTS AS stmt_locatable THEN
      token = mIRLoweringLowerableStmt__token(stmt);
    END
    MUTABLE transfer_only = stmt IS_A MoveNode;
    MUTABLE stmt_transfer_marks: []Emittable = List[];
    IF transfer_only THEN
      stmt_transfer_marks = TRY (mIRLowering__ownership_marks_for_transferred_temp(&self, CAST(mir AS Emittable)));
    ELSE
      stmt_transfer_marks = TRY (mIRLowering__dedupe_transfer_marks(&self, TRY (mIRLowering__ownership_transfers_for_stmt(&self, stmt, state.guarded_cleanup_names))));
    END
    # `lower` hands back at most one node here: the multi-node lowerings put
    # their extra statements in the pending list instead.
    MUTABLE statement_nodes: []Emittable = List[];
    IF mir EXISTS AS mir_value THEN
      statement_nodes = [COPY mir_value];
    END
    MUTABLE guarded_nodes: []Emittable = List[];
    IF !(transfer_only) THEN
      guarded_nodes = TRY (mIRLowering__guard_shared_node_statement(&self, stmt, (pending + statement_nodes)));
    END
    MUTABLE packet_mir: []Emittable = List[];
    MUTABLE packet_pending: []Emittable = List[];
    MUTABLE packet_line: ?Int64 = NIL;
    MUTABLE packet_column: ?Int64 = NIL;
    IF transfer_only THEN
      packet_pending = COPY pending;
    ELSE
      packet_mir = COPY guarded_nodes;
      IF token EXISTS AS packet_token THEN
        packet_line = packet_token.line;
        packet_column = packet_token.column;
      END
    END
    RETURN LoweredStmtPacket{ mir: MIRLoweringLoweredMir{ ArrayValue: COPY packet_mir }, pending: COPY packet_pending, stmt_transfer_marks: COPY stmt_transfer_marks, source_line: packet_line, source_column: packet_column };
END
FN mIRLowering__materialize_statement_discard(MUTABLE self: MIRLowering, stmt: MIRLoweringLowerableStmt, mir_input: NodeRoot) RETURNS !Tuple<NodeRoot, Bool> ->
    MUTABLE mir = COPY mir_input;
    IF castMIRLoweringLowerableStmtToLocatable(stmt) EXISTS AS locatable THEN
      MUTABLE locatable_mutable = COPY locatable;
      IF !(mIRLowering__discard_expr_stmt?(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(locatable_mutable), castNodeRootToEmittable(COPY mir))) THEN
        RETURN CAST(Tuple{mir, FALSE} AS Tuple<NodeRoot, Bool>);
      END
      MUTABLE discard_type: ?Type = TRY (type__from_node_mut(locatable_mutable, "discard allocation mark"));
      mir = TRY (mIRLowering__place_discarded_owned_branch_value(&self, castNodeRootToEmittable(mir), UNWRAP (discard_type)));
      MUTABLE normalized_prefix = TRY (mIRLowering__normalize_allocating_result_expr_mut(&self, castNodeRootToEmittable(mir)));
      IF !((normalized_prefix.length() == 0)) THEN
        FOR concat_stmt IN normalized_prefix DO
          &self.state.function_state.pending_stmts.append(COPY concat_stmt);
        END
      END
      MUTABLE discard_mir: ?Emittable = castNodeRootToEmittable(COPY mir);
      IF !((TRY (mIRLowering__mir_allocates?(&self, discard_mir)) AND !(mIRLowering__mutating_receiver_allocator_op?(self, discard_mir)))) THEN
        RETURN CAST(Tuple{mir, FALSE} AS Tuple<NodeRoot, Bool>);
      END
      MUTABLE entry: ?CleanupEntry@multiowned = TRY (mIRLowering__hoist_cleanup_entry(&self, castNodeRootToEmittable(mir), locatable_mutable));
      IF entry EXISTS AS entry_value THEN
        MUTABLE entry_value_mutable = COPY entry_value;
        MUTABLE discard_name = "__discard_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_40 = mIRLowering__lowering_counters(&self);
        mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_40)) }}";
        MUTABLE alloc = cleanupEntry__alloc(entry_value_mutable);
        MUTABLE materialized = BindingMaterialization{ name: COPY discard_name, expr: castNodeRootToEmittable(COPY mir), alloc: COPY alloc, type_info: UNWRAP (COPY discard_type), mutable: TRUE, annotation: COPY TRY (type__new(TypeConstructionInput{ StringValue: COPY TRY (mIRLowering__discard_owned_zig_type(self, locatable_mutable, entry_value_mutable)) })), suppression: "_ = &${discard_name};", cleanup_entry: entry_value_mutable, cleanup_mode: :normal, scope: NIL, ownership_tracked: TRUE };
        TRY (mIRLowering__stamp_allocating_result_target_mut(&self, castNodeRootToEmittable(mir), discard_name, alloc));
        RETURN CAST(Tuple{ScopeBlock{ body: CAST(Body{ Emittable: COPY CAST(COPY TRY (bindingMaterialization__statements(materialized)) AS Emittable) } AS []Emittable), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }, TRUE} AS Tuple<NodeRoot, Bool>);
      ELSE
        RETURN CAST(Tuple{mir, FALSE} AS Tuple<NodeRoot, Bool>);
      END
    ELSE
      RETURN CAST(Tuple{mir, FALSE} AS Tuple<NodeRoot, Bool>);
    END
END
FN mIRLowering__place_discarded_owned_branch_value(MUTABLE self: MIRLowering, MUTABLE mir: Emittable, type_info: Type) RETURNS !Emittable ->
    IF !(TRY (mIRLowering__mir_allocates?(&self, mir))) THEN
      RETURN COPY mir;
    END
    MUTABLE result_type = TRY (type__success_type(type_info));
    IF !(TRY (mIRLowering__ownership_bearing_type?(&self, result_type))) THEN
      RETURN COPY mir;
    END
    MUTABLE dest_alloc = (mIRLowering__mir_owned_alloc(&self, mir) OR_ELSE :heap);
    IF mir IS_A TryCatch AS MUTABLE try_catch THEN
      RETURN TRY (mIRLowering__place_owned_try_catch_for_destination(&self, &try_catch, result_type, dest_alloc));
    ELSE_IF mir IS_A Orelse AS MUTABLE orelse THEN
      RETURN TRY (mIRLowering__place_owned_orelse_for_destination(&self, &orelse, result_type, dest_alloc));
    ELSE
      RETURN COPY mir;
    END
END
FN mIRLowering__discard_expr_stmt?(MUTABLE self: MIRLowering, stmt: MIRLoweringLowerableStmt, mir: ?Emittable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF castMIRLoweringLowerableStmtToLocatable(stmt) EXISTS AS locatable THEN
      IF mir == NIL THEN
        RETURN FALSE;
      END
      IF !(emittable__expr?(mir)) THEN
        RETURN FALSE;
      END
      MUTABLE ast_stmt: Locatable = COPY locatable;
      WHILE (ast_stmt IS_A UnaryOp AND (aST__node_op(ast_stmt) == :TRY)) DO
        ast_stmt = UNWRAP (aST__node_right( ast_stmt));
      END
      IF !((aST__call?( ast_stmt) OR ast_stmt IS_A BinaryOp)) THEN
        RETURN FALSE;
      END
      MUTABLE resolved: ?String@symbol = locatable__resolved_type(locatable);
      RETURN !(!(((resolved AND (resolved != :Void)))));
    ELSE
      RETURN FALSE;
    END
}
END
FN mIRLowering__record_ownership_finalization_node_mut(MUTABLE self: MIRLowering, MUTABLE state: OwnershipFinalizationContext, root: NodeRoot) RETURNS !Void ->
