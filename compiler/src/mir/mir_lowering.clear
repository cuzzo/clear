END
PRIVATE FN mIRLowering__lower_union_lifecycle_methods(self: MIRLowering, node: UnionDef, facts: []UnionVariantLoweringFact) RETURNS ![]FnDef
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE cleanup_arms: []UnionMatchArm = ( { MUTABLE rtoc_empty_list_141: []UnionMatchArm = List[]; rtoc_empty_list_141 } );
    MUTABLE needs_cleanup: Bool = FALSE;
    MUTABLE copy_forbidden: Bool = FALSE;
    MUTABLE clone_arms: []UnionMatchArm = ( { MUTABLE rtoc_empty_list_142: []UnionMatchArm = List[]; rtoc_empty_list_142 } );
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < facts.length() DO
      MUTABLE data: ?MIRLoweringUnionVariantPayload = COPY facts[rtoc_idx]?.data;
      IF (data == NIL) THEN
          &cleanup_arms.append(UnionMatchArm{ variant: COPY facts[rtoc_idx]?.name, payload: NIL, body: ( { MUTABLE rtoc_empty_list_143: []Emittable = List[]; rtoc_empty_list_143 } ), pointer_payload: FALSE });
          &clone_arms.append(UnionMatchArm{ variant: COPY facts[rtoc_idx]?.name, payload: NIL, body: [Emittable{ ReturnStmt: COPY ReturnStmt{ value: Emittable{ StructInit: COPY StructInit{ zig_type: NIL, fields: [CAST({:name: facts[rtoc_idx]?.name, :value: Lit{ value: "void{}", lowered_node_id: NIL, ownership_consumption: NIL }} AS Any)], lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], pointer_payload: FALSE });
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE payload = "__payload_${mIRLowering__zig_safe_name(rtoc_self_view, facts[rtoc_idx]?.name)}";
      MUTABLE body: []Emittable = ( { MUTABLE rtoc_empty_list_144: []Emittable = List[]; rtoc_empty_list_144 } );
      MUTABLE copy_strategy: String@symbol = :bit_copy;
      IF facts[rtoc_idx]?.inline_struct THEN
          MUTABLE inline: InlineStructVariant@multiowned = castOptionalMIRLoweringUnionVariantPayloadToInlineStructVariantMultiowned(data);
          MUTABLE drop_payload: Bool = inline.deinit_entries |> ANY _;
          FOR _ IN inline.fields.values() DO
        MUTABLE plan = COPY UNWRAP (mIRLowering__lifecycle_registry(rtoc_self_view)[TRY (type__from_input(_))]);
        copy_forbidden = (copy_forbidden OR (plan.copy_strategy == :forbidden));
        IF (plan.copy_strategy != :bit_copy) THEN
              copy_strategy = :deep_clone;
        END
        drop_payload = (drop_payload OR lifecyclePlan__needs_drop?(plan));
          END
          IF drop_payload THEN
            &body.append(Emittable{ ExprStmt: COPY ExprStmt{ expr: castMIRLoweringReturnValueToEmittable(COPY TRY (mIRLowering__emit_builtin(rtoc_self_view, :cleanup, [Emittable{ Ident: COPY Ident{ name: COPY facts[rtoc_idx]?.zig_type, lowered_node_id: NIL, ownership_consumption: NIL } }, Emittable{ Ident: COPY Ident{ name: "alloc", lowered_node_id: NIL, ownership_consumption: NIL } }, Emittable{ Ident: COPY Ident{ name: payload, lowered_node_id: NIL, ownership_consumption: NIL } }]))), discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
          END
      ELSE
          MUTABLE variant_type = TRY (type__from_variant_input(castOptionalMIRLoweringUnionVariantPayloadToOptionalSchemasUnionSchemaVariantValue(data)));
          MUTABLE plan = COPY UNWRAP (mIRLowering__lifecycle_registry(rtoc_self_view)[variant_type]);
          copy_forbidden = (copy_forbidden OR (plan.copy_strategy == :forbidden));
          copy_strategy = COPY plan.copy_strategy;
          IF (plan.drop_strategy == :resource_close) THEN
            &body.append(Emittable{ ResourceClose: COPY ResourceClose{ target: Emittable{ Deref: COPY Deref{ expr: Emittable{ Ident: COPY Ident{ name: payload, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, close_plan: COPY UNWRAP (plan.resource_close_plan), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
          ELSE_IF lifecyclePlan__needs_drop?(plan) THEN
            &body.append(Emittable{ ExprStmt: COPY ExprStmt{ expr: castMIRLoweringReturnValueToEmittable(COPY TRY (mIRLowering__emit_builtin(rtoc_self_view, :cleanup, [Emittable{ Ident: COPY Ident{ name: COPY facts[rtoc_idx]?.zig_type, lowered_node_id: NIL, ownership_consumption: NIL } }, Emittable{ Ident: COPY Ident{ name: "alloc", lowered_node_id: NIL, ownership_consumption: NIL } }, Emittable{ Ident: COPY Ident{ name: payload, lowered_node_id: NIL, ownership_consumption: NIL } }]))), discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
          END
      END
      needs_cleanup = (needs_cleanup OR body |> ANY _);
      MUTABLE clone_payload: String = "";
        IF (copy_strategy == :bit_copy) THEN
          clone_payload = "${payload}.*";
        ELSE
          clone_payload = "try CheatLib.dupeValue(@TypeOf(${payload}.*), ${payload}.*, alloc)";
        END
      &clone_arms.append(UnionMatchArm{ variant: COPY facts[rtoc_idx]?.name, payload: COPY payload, pointer_payload: TRUE, body: [Emittable{ ReturnStmt: COPY ReturnStmt{ value: Emittable{ StructInit: COPY StructInit{ zig_type: NIL, fields: [CAST({:name: facts[rtoc_idx]?.name, :value: Lit{ value: COPY clone_payload, lowered_node_id: NIL, ownership_consumption: NIL }} AS Any)], lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] });
      &cleanup_arms.append(UnionMatchArm{ variant: COPY facts[rtoc_idx]?.name, payload: COPY payload, pointer_payload: TRUE, body: COPY body });
    rtoc_idx = rtoc_idx + 1;
    END
    MUTABLE methods: []FnDef = ( { MUTABLE rtoc_empty_list_145: []FnDef = List[]; rtoc_empty_list_145 } );
    MUTABLE statements: []Stmt = [Stmt{ Emittable: COPY CAST(Suppress{ name: "alloc", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) }, Stmt{ Emittable: COPY CAST(UnionMatchStmt{ subject: Emittable{ Deref: COPY Deref{ expr: Emittable{ Ident: COPY Ident{ name: "self", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, arms: cleanup_arms, default_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) }];
    &methods.append(FnDef{ name: "__clear_drop", params: [MIRParam{ name: "self", zig_type: "*@This()", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL }, MIRParam{ name: "alloc", zig_type: "std.mem.Allocator", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL }], ret_type: "void", body: Body{ ArrayValue: statements |> SELECT castStmtToLocatable(_) }, visibility: :pub, can_fail: FALSE, comptime_params: List[], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
    IF !(copy_forbidden) THEN
      &methods.append(FnDef{ name: "__clear_clone", params: [MIRParam{ name: "self", zig_type: "@This()", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL }, MIRParam{ name: "alloc", zig_type: "std.mem.Allocator", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL }], ret_type: "@This()", body: COPY CAST(Tuple{Suppress{ name: "alloc", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }, UnionMatchStmt{ subject: Emittable{ Ident: COPY Ident{ name: "self", lowered_node_id: NIL, ownership_consumption: NIL } }, arms: clone_arms, default_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }} AS Tuple<Suppress, UnionMatchStmt>), visibility: :pub, can_fail: TRUE, comptime_params: List[], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
    END
    RETURN methods;
}
END
PRIVATE FN mIRLowering__union_variant_lowering_facts(self: MIRLowering, node: UnionDef) RETURNS ![]UnionVariantLoweringFact
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN node.variants |> SELECT {
    MUTABLE inline_struct = schemas__inline_struct?(_._1);
    MUTABLE name = COPY CAST(_._0 AS String);
    MUTABLE zig_type: String = "";
      IF (_._1 == NIL) THEN
        zig_type = "void";
      ELSE_IF inline_struct THEN
        zig_type = "${node.name}_${name}";
      ELSE
        zig_type = mIRLowering__transpile_type(rtoc_self_view, _._1, FALSE, TRUE);
      END
    UnionVariantLoweringFact{ owner_name: COPY node.name, name: COPY name, data: COPY _._1, inline_struct: inline_struct, zig_type: COPY zig_type }
    };
}
END
PRIVATE FN mIRLowering__lower_cast(MUTABLE self: MIRLowering, node: Cast) RETURNS !Emittable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE inner = TRY (mIRLowering__lower(&rtoc_self_view, node.value));
    IF hoist__noreturn_value?(node.value) THEN
      RETURN inner;
    END
    MUTABLE target_type = mIRLowering__transpile_type(rtoc_self_view, node.target);
    MUTABLE cast_target = TRY (type__new(node.target));
    IF (TRY (type__byte_string?(cast_target)) AND !(type__optional?(cast_target))) THEN
      MUTABLE widened = TRY (mIRLowering__widen_symbol_to_bytes(rtoc_self_view, inner, node.value));
      IF !(widened.equal?(inner)) THEN
        RETURN widened;
      END
    END
    MUTABLE target_base = type__resolved((TRY (type__value_payload_type((TRY (type__new(node.target)))))));
    IF (TRY (mIRLowering__enum_schemas(rtoc_self_view))).contains?(target_base) THEN
      RETURN Emittable{ MIRCast: COPY MIRCast{ expr: COPY inner, target_type: COPY target_type, method: :enumFromInt, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    RETURN Emittable{ MIRCast: COPY MIRCast{ expr: COPY inner, target_type: COPY target_type, method: :as, lowered_node_id: NIL, ownership_consumption: NIL } };
}
END
PRIVATE FN mIRLowering__lower_static_call(MUTABLE self: MIRLowering, node: StaticCall) RETURNS !Emittable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE mir_args: []Emittable = List[];
    MUTABLE inherent_call: ?FuncCall = COPY node.inherent_call;
    IF inherent_call EXISTS AS inherent_call_value THEN
      MUTABLE inherent_call_value_mutable = COPY inherent_call_value;
      RETURN mIRLowering__lower_func_call(&rtoc_self_view, inherent_call_value_mutable);
    END
    MUTABLE stdlib_def: ?FunctionSignature@multiowned = functionSignature__unwrap(ruby_wrap_optional_FunctionSignature_multiowned_X(KEEP node.matched_stdlib_def));
    IF stdlib_def EXISTS AS stdlib_def_value THEN
      MUTABLE stdlib_def_value_mutable = COPY stdlib_def_value;
      IF TRY (functionSignature__intrinsic_bc?(&stdlib_def_value_mutable)) THEN
        mir_args = node.args |> SELECT mIRLowering__hoist_alloc(rtoc_self_view, TRY (mIRLowering__lower(&rtoc_self_view, _)), _);
        RETURN Emittable{ InlineBc: COPY InlineBc{ op: COPY TRY (functionSignature__intrinsic_bc_op_or(&stdlib_def_value_mutable, symbol((CAST(node.method_name AS String))))), args: COPY mir_args, stdlib_def: stdlib_def_value_mutable, suppress_try: FALSE, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
      mir_args = node.args |> SELECT mIRLowering__hoist_alloc(rtoc_self_view, TRY (mIRLowering__lower(&rtoc_self_view, _)), _);
      RETURN Emittable{ RegistryCall: COPY RegistryCall{ entry: stdlib_def_value_mutable, args: COPY mir_args |> SELECT RegistryCallArg{ expr: COPY _, coerce_type: NIL }, reason: "static_call", ownership_contract: TRY (ownershipContract__empty()), allocs: NIL, owned_result_alloc: NIL, target_var: NIL, result_type: NIL, result_ownership_bearing: NIL, key_type: NIL, value_type: NIL, suppress_try: FALSE } };
    ELSE
      panic("lower_static_call: missing stdlib signature for {}");
    END
}
END
PRIVATE FN mIRLowering__lower_or_else_exit(MUTABLE self: MIRLowering, node: OrElseExit) RETURNS !ScopeBlock
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE msg_mir = NIL;
    MUTABLE facts = mIRLowering__or_else_exit_facts(rtoc_self_view, node, node.token.line);
    IF mIRLowering__bc_target?(rtoc_self_view) THEN
      msg_mir = IF node.message THEN
        TRY (mIRLowering__lower(&rtoc_self_view, node.message))
      ELSE
        NIL
      END;
      RETURN ScopeBlock{ body: COPY CAST(Tuple{ExprStmt{ expr: Emittable{ OrElseExitBcRewrite: COPY mIRLowering__or_else_exit_bc_reassign(rtoc_self_view, facts, msg_mir) }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }, ReturnStmt{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "error", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "CheatError", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }} AS Tuple<ExprStmt, ReturnStmt>), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    END
    msg_mir = IF node.message THEN
      TRY (mIRLowering__lower(&rtoc_self_view, node.message))
    ELSE
      NIL
    END;
    RETURN mIRLowering__or_else_exit_scope(rtoc_self_view, facts, msg_mir, Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "error", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "CheatError", lowered_node_id: NIL, ownership_consumption: NIL } });
}
END
PRIVATE FN mIRLowering__lower_require(MUTABLE self: MIRLowering, node: RequireNode) RETURNS !MIRLoweringLoweredMir
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE importer: ?ModuleImporter = COPY mIRLowering__program_state(rtoc_self_view).importer;
    MUTABLE pkg_inline = (((node.kind == :package) AND (importer != NIL)) AND (moduleImporter__stdlib_package?(importer, node.path) != NIL));
    IF ((node.kind == :package) AND !(pkg_inline)) THEN
      MUTABLE import_name = (node.namespace OR node.path);
      IF ((importer != NIL) AND TRUE) THEN
        import_name = moduleImporter__owning_package_name(importer, import_name);
      END
      MUTABLE zig_import_name = mIRLowering__zig_module_alias(rtoc_self_view, import_name);
      IF !(mIRLowering__program_state(rtoc_self_view).emitted_require_modules.add?("pkg-import:${import_name}")) THEN
        RETURN List[];
      END
      MUTABLE items: []Emittable = [Emittable{ Import: COPY Import{ alias_name: COPY zig_import_name, module_path: "${import_name}.zig", member: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }];
      MUTABLE pkg_mod: ?CompiledModule = NIL;
      IF importer != NIL THEN
        pkg_mod = COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_146 = (importer?);
      TRY (moduleImporter__compile_package(&rtoc_mutable_receiver_146, node.path, UNWRAP (mIRLowering__program_state(rtoc_self_view).source_dir))) };
      END
      IF pkg_mod EXISTS AS pkg_mod_value THEN
        mIRLowering__merge_module_schemas_mut(rtoc_self_view, pkg_mod_value);
      END
      mIRLowering__record_module_const_init_mut(rtoc_self_view, pkg_mod, zig_import_name);
      MUTABLE pkg_scope: ?Any = COPY pkg_mod?.global_scope;
      IF pkg_scope EXISTS AS pkg_scope_value THEN
        MUTABLE alias_target = zig_import_name;
        FOR rtoc_key IN pkg_scope_value.types().keys() DO
    MUTABLE type_entry: Any = COPY UNWRAP (pkg_scope_value.types()[rtoc_key]);
    MUTABLE vis = ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_147 = type_entry.schema();
    functionSignature__visibility(rtoc_local_receiver_147) } OR :package);
    IF !((vis == :pub)) THEN
            CONTINUE;
    END
    IF !(mIRLowering__program_state(rtoc_self_view).emitted_import_type_aliases.add?(CAST(rtoc_key AS String))) THEN
            CONTINUE;
    END
    &items.append(Emittable{ TypeAlias: COPY TypeAlias{ name: COPY CAST(rtoc_key AS String), target: "${alias_target}.${rtoc_key}", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
        END
      END
      RETURN MIRLoweringLoweredMir{ ArrayValue: COPY items };
    ELSE
      IF importer EXISTS AS importer_value THEN
        MUTABLE importer_value_mutable = COPY importer_value;
        MUTABLE mod_branch_value: ?CompiledModule = NIL;
        IF pkg_inline THEN
          mod_branch_value = TRY (moduleImporter__compile_package(&importer_value_mutable, node.path, UNWRAP (mIRLowering__program_state(rtoc_self_view).source_dir)));
        ELSE
          mod_branch_value = TRY (moduleImporter__compile_file(&importer_value_mutable, node.path, UNWRAP (mIRLowering__program_state(rtoc_self_view).source_dir)));
        END
        MUTABLE mod: ?CompiledModule = mod_branch_value;
        mIRLowering__merge_module_schemas_mut(rtoc_self_view, mod?);
        IF (UNWRAP (mod)).ast THEN
          MUTABLE rtoc_each_items_148 = ((UNWRAP (mod)).ast).statements();
          MUTABLE rtoc_idx = 0;
          WHILE rtoc_idx < rtoc_each_items_148.length() DO
      IF !(rtoc_each_items_148[rtoc_idx] IS_A FunctionDef) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF (rtoc_each_items_148[rtoc_idx].name() == name) THEN
                rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE rtoc_index_receiver_149 = TRY (mIRLowering__fn_sigs(rtoc_self_view));
      rtoc_index_receiver_149[rtoc_each_items_148[rtoc_idx].name()] = TRY (functionSignature__from_function_def(rtoc_each_items_148[rtoc_idx]));
    rtoc_idx = rtoc_idx + 1;
          END
          MUTABLE module_scope = (UNWRAP (mod)).global_scope;
          IF module_scope THEN
            functionSignature__merge_imported_signatures_mut(TRY (mIRLowering__fn_sigs(rtoc_self_view)), module_scope);
          END
        END
        MUTABLE same_dir = ((UNWRAP (mod)).source_dir == mIRLowering__program_state(rtoc_self_view).source_dir);
        MUTABLE dependency_items = TRY (mIRLowering__imported_module_dependency_items(&rtoc_self_view, mod?));
        MUTABLE namespace_items = mIRLowering__with_lifecycle_registry(&rtoc_self_view, (UNWRAP (mod)).lifecycle_registry, %() USE(mod, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_150 = TRY (mIRLowering__imported_module_items(&rtoc_self_view, mod?));
    rtoc_lambda_result_150
        });
        IF mIRLowering__bc_target?(rtoc_self_view) THEN
          MUTABLE helper_fns = TRY (mIRLowering__imported_bc_helper_fns(rtoc_self_view, mod?, namespace_items));
          IF helper_fns |> ANY _ THEN
            RETURN MIRLoweringLoweredMir{ ArrayValue: helper_fns |> SELECT Emittable{ FnDef: COPY _ } };
          END
        END
        MUTABLE module_key = (UNWRAP (mod)).object_id();
        IF !(mIRLowering__program_state(rtoc_self_view).emitted_require_modules.add?(CAST(module_key AS String))) THEN
          RETURN List[];
        END
        RETURN (dependency_items + TRY (mIRLowering__imported_module_extern_items(&rtoc_self_view, mod?)) + TRY (mIRLowering__visible_type_items(rtoc_self_view, mod?, same_dir)) + [ModuleNamespace{ name: mIRLowering__zig_module_alias(rtoc_self_view, node.namespace), items: COPY namespace_items, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }]);
      ELSE
        panic("MIRLowering: REQUIRE \\\"{}\\\" but no importer available");
      END
    END
}
END
PRIVATE FN mIRLowering__imported_module_extern_items(MUTABLE self: MIRLowering, mod_value: CompiledModule) RETURNS ![]Emittable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(mod_value.ast) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_151: []Emittable = List[]; rtoc_empty_list_151 } ) AS []Emittable);
    END
    RETURN ((mod_value.ast.statements() |> SELECT:? (IF !((_ IS_A ExternFnDecl OR _ IS_A ExternStructDecl)) THEN NIL ELSE TRY (mIRLowering__lower(&rtoc_self_view, _)) END) |> WHERE _ != NIL).flatten()) |> WHERE _ IS_A Emittable;
}
END
PRIVATE FN mIRLowering__record_module_const_init_mut(self: MIRLowering, mod_value: ?CompiledModule, alias_name: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE items: ?Any = COPY mod_value?.mir_items;
    IF items EXISTS AS items_value THEN
      MUTABLE has_init = items_value.flatten() |> ANY (_ IS_A FnDef AND (CAST(_.name() AS String) == "__clear_init_consts"));
      IF has_init THEN
        mIRLowering__program_state(rtoc_self_view).module_const_inits.insert(COPY alias_name);
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN mIRLowering__merge_module_schemas_mut(self: MIRLowering, mod_value: CompiledModule) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE struct_schemas = mod_value.struct_schemas;
    MUTABLE enum_schemas = mod_value.enum_schemas;
    MUTABLE union_schemas = mod_value.union_schemas;
    MUTABLE rtoc_mutable_receiver_152 = mIRLowering__lowering_schemas(rtoc_self_view);
    mIRLoweringSchemas__merge_mut(&rtoc_mutable_receiver_152, struct_schemas, enum_schemas, union_schemas);
}
END
PRIVATE FN mIRLowering__visible_type_items(self: MIRLowering, mod_value: CompiledModule, same_dir: Bool = FALSE) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE items = mod_value.type_items;
    IF !(items) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_153: []Emittable = List[]; rtoc_empty_list_153 } ) AS []Emittable);
    END
    MUTABLE visible_names = TRY (mIRLowering__visible_imported_type_names(rtoc_self_view, mod_value, same_dir));
    IF visible_names.empty?() THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_154: []Emittable = List[]; rtoc_empty_list_154 } ) AS []Emittable);
    END
    RETURN items |> SELECT:? (IF !(_ IS_A Emittable) THEN NIL ELSE (IF !(_ IS_A NamedEmittable) THEN NIL ELSE   IF visible_names.contains?(CAST(_.name() AS String)) THEN
      _
    ELSE
      NIL
    END END) END) |> WHERE _ != NIL;
}
END
PRIVATE FN mIRLowering__visible_imported_type_names(self: MIRLowering, mod_value: CompiledModule, same_dir: Bool = FALSE) RETURNS ![Set]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE visible_names = Set[];
    IF !(mod_value.ast) THEN
      RETURN visible_names;
    END
    MUTABLE rtoc_each_items_155 = mod_value.ast.statements();
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_155.length() DO
    IF (rtoc_each_items_155[rtoc_idx] IS_A StructDef) OR (rtoc_each_items_155[rtoc_idx] IS_A EnumDef) OR (rtoc_each_items_155[rtoc_idx] IS_A UnionDef) THEN
        MUTABLE vis = (functionSignature__visibility(rtoc_each_items_155[rtoc_idx]) OR :package);
        IF (vis == :private) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
        END
        IF !((((vis == :pub)) OR same_dir)) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
        END
        MUTABLE name = COPY CAST(rtoc_each_items_155[rtoc_idx].name() AS String);
        IF mIRLowering__program_state(rtoc_self_view).emitted_types.contains?(name) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
        END
        &visible_names.insert(name);
        mIRLowering__program_state(rtoc_self_view).emitted_types.insert(name);
        IF rtoc_each_items_155[rtoc_idx] IS_A UnionDef THEN
          FOR rtoc_key IN rtoc_each_items_155[rtoc_idx].variants().keys() DO
      MUTABLE var_data: Any = COPY UNWRAP (rtoc_each_items_155[rtoc_idx].variants()[rtoc_key]);
      IF !(schemas__inline_struct?(var_data)) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE syn = "${rtoc_each_items_155[rtoc_idx].name()}_${rtoc_key}";
      &visible_names.insert(syn);
      mIRLowering__program_state(rtoc_self_view).emitted_types.insert(syn);
          END
        END
    END
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN visible_names;
}
END
PRIVATE FN mIRLowering__imported_module_items(MUTABLE self: MIRLowering, mod_value: CompiledModule) RETURNS ![]Emittable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF mod_value.ast THEN
      MUTABLE hidden_type_items = mod_value.ast.statements() |> SELECT:? (IF !(mIRLowering__hidden_imported_type_statement?(rtoc_self_view, _, mod_value)) THEN NIL ELSE TRY (mIRLowering__lower(&rtoc_self_view, _)) END) |> WHERE _ != NIL;
      MUTABLE fn_items = ((mod_value.ast.statements() |> SELECT:? { MUTABLE rtoc_mutable_block_param_156 = COPY _;
      (IF (rtoc_mutable_block_param_156 IS_A FunctionDef AND (rtoc_mutable_block_param_156.name() == name)) THEN NIL ELSE (IF rtoc_mutable_block_param_156 IS_A FunctionDef THEN mIRLowering__lower_function_def(&rtoc_self_view, &rtoc_mutable_block_param_156) ELSE (IF (rtoc_mutable_block_param_156 IS_A VarDecl OR rtoc_mutable_block_param_156 IS_A BindExpr) THEN TRY (mIRLowering__lower(&rtoc_self_view, rtoc_mutable_block_param_156)) ELSE NIL END) END) END) } |> WHERE _ != NIL).flatten()) |> WHERE _ IS_A Emittable;
      RETURN ([hidden_type_items, fn_items]).flatten() |> WHERE _ IS_A Emittable;
    END
    MUTABLE items = mod_value.mir_items;
    IF items IS_A []Any THEN
      RETURN items |> WHERE mIRLowering__importable_module_item?(rtoc_self_view, _);
    END
    RETURN CAST(( { MUTABLE rtoc_empty_list_157: []Emittable = List[]; rtoc_empty_list_157 } ) AS []Emittable);
}
END
PRIVATE FN mIRLowering__hidden_imported_type_statement?(self: MIRLowering, stmt: Locatable, mod_value: CompiledModule) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(((stmt IS_A StructDef OR stmt IS_A EnumDef) OR stmt IS_A UnionDef)) THEN
      RETURN FALSE;
    END
    MUTABLE same_dir = (mod_value.source_dir == mIRLowering__program_state(rtoc_self_view).source_dir);
    MUTABLE vis = (stmt.visibility() OR :package);
    IF (vis == :pub) THEN
      RETURN FALSE;
    END
    IF ((vis == :package) AND same_dir) THEN
      RETURN FALSE;
    END
    RETURN TRUE;
}
END
PRIVATE FN mIRLowering__importable_module_item?(self: MIRLowering, item: Emittable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (IF item IS_A FnDef AS fn_def THEN (CAST(fn_def.name AS String) == name) ELSE FALSE END) THEN
      RETURN FALSE;
    END
    IF item IS_A ModuleNamespace AS module_namespace THEN
      RETURN FALSE;
    END
    RETURN TRUE;
}
END
PRIVATE FN mIRLowering__imported_module_dependency_items(MUTABLE self: MIRLowering, mod_value: CompiledModule) RETURNS ![]Emittable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  IF !(mod_value.ast) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_158: []Emittable = List[]; rtoc_empty_list_158 } ) AS []Emittable);
  END
  MUTABLE prev_source_dir: ?String = COPY mIRLowering__program_state(rtoc_self_view).source_dir;
  DEFER MUTABLE rtoc_writer_receiver_159: MIRLoweringProgramState = mIRLowering__program_state(rtoc_self_view);
  rtoc_writer_receiver_159.source_dir = prev_source_dir;
  MUTABLE rtoc_writer_receiver_160: MIRLoweringProgramState = mIRLowering__program_state(rtoc_self_view);
  rtoc_writer_receiver_160.source_dir = mod_value.source_dir;
  RETURN (mod_value.ast.statements() |> SELECT:? (IF !(_ IS_A RequireNode) THEN NIL ELSE TRY (mIRLowering__lower_require(&rtoc_self_view, _)) END) |> WHERE _ != NIL).flatten() |> WHERE _ IS_A Emittable;
}
END
PRIVATE FN mIRLowering__imported_bc_helper_fns(self: MIRLowering, mod_value: CompiledModule, items: []Emittable) RETURNS ![]FnDef
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN items |> SELECT:? (IF !(_ IS_A FnDef) THEN NIL ELSE _ END) |> WHERE _ != NIL;
}
END
FN mIRLowering__task_config_variant(self: MIRLowering, stack_size: ?String@symbol, computed_tier: ?String@symbol) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE default: String = "";
    IF mIRLowering__program_state(rtoc_self_view).debug_mode THEN
      default = "Large";
    ELSE
      default = "Standard";
    END
    IF stack_size EXISTS AS stack_size_value THEN
      IF (stack_size_value == :stack) THEN
        RETURN ({NIL: "Standard", :micro: "Micro", :standard: "Standard", :large: "Large", :xl: "Xl", "micro": "Micro", "standard": "Standard", "large": "Large", "xl": "Xl", :service: "Huge"}[(computed_tier OR_ELSE :standard)] OR_ELSE default);
      ELSE
        RETURN ({NIL: "Standard", :micro: "Micro", :standard: "Standard", :large: "Large", :xl: "Xl", "micro": "Micro", "standard": "Standard", "large": "Large", "xl": "Xl", :service: "Huge"}[stack_size_value] OR_ELSE default);
      END
    ELSE
    IF computed_tier EXISTS AS computed_tier_value THEN
        MUTABLE computed = ({NIL: "Standard", :micro: "Micro", :standard: "Standard", :large: "Large", :xl: "Xl", "micro": "Micro", "standard": "Standard", "large": "Large", "xl": "Xl", :service: "Huge"}[computed_tier_value] OR_ELSE default);
        IF (({"Micro": 0, "Standard": 1, "Large": 2, "Xl": 3, "Huge": 4}[computed] OR_ELSE 0) >= ({"Micro": 0, "Standard": 1, "Large": 2, "Xl": 3, "Huge": 4}[default] OR_ELSE 0)) THEN
          RETURN computed;
        ELSE
          RETURN default;
        END
    ELSE
        RETURN default;
    END
    END
}
END
PRIVATE FN mIRLowering__profile_dispatch_id(self: MIRLowering, dispatch: MIRLoweringBackgroundDispatch) RETURNS Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN PARTIAL MATCH dispatch START
      :parallel -> 2,
      :shared -> 3,
      DEFAULT -> 1
    END;
}
END
PRIVATE FN mIRLowering__bg_profile_site_comment(self: MIRLowering, site_id: Int64, line: Int64, col: Int64, dispatch: MIRLoweringBackgroundDispatch, form: String@symbol) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN "// CLEAR_PROFILE_TASK_SITE id=${site_id.toString()} kind=BG line=${line.toString()} column=${col.toString()} dispatch=${dispatch} form=${form}";
}
END
PRIVATE FN mIRLowering__lower_struct_pattern(MUTABLE self: MIRLowering, subject: Ident, pat: StructPattern) RETURNS !Tuple<[]Emittable, []Let>
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE conditions: []Emittable = ( { MUTABLE rtoc_empty_list_161: []Emittable = List[]; rtoc_empty_list_161 } );
    MUTABLE bindings: []Let = ( { MUTABLE rtoc_empty_list_162: []Let = List[]; rtoc_empty_list_162 } );
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < pat.fields.length() DO
      IF patternField__wildcard?(pat.fields[rtoc_idx]?) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF patternField__bind?(pat.fields[rtoc_idx]?) THEN
          MUTABLE field_access = FieldGet{ object: Emittable{ Ident: COPY subject }, field: COPY (pat.fields[rtoc_idx]?.name), lowered_node_id: NIL, ownership_consumption: NIL };
          &bindings.append(Let{ name: COPY (pat.fields[rtoc_idx]?.name), init: Emittable{ FieldGet: COPY field_access }, mutable: FALSE, annotation: NIL, suppression: "_ = &${pat.fields[rtoc_idx]?.name};", alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL });
      ELSE
          MUTABLE val: Emittable = CAST(TRY (mIRLowering__lower(&rtoc_self_view, patternField__expr(pat.fields[rtoc_idx]?))) AS Emittable);
          MUTABLE field_access = FieldGet{ object: Emittable{ Ident: COPY subject }, field: COPY (pat.fields[rtoc_idx]?.name), lowered_node_id: NIL, ownership_consumption: NIL };
          &conditions.append(Emittable{ MIRBinOp: COPY MIRBinOp{ op: "==", left: Emittable{ FieldGet: COPY field_access }, right: COPY val, lowered_node_id: NIL, ownership_consumption: NIL } });
      END
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN CAST(Tuple{conditions, bindings} AS Tuple<[]Emittable, []Let>);
}
END
PRIVATE FN mIRLowering__lower_macro_print(MUTABLE self: MIRLowering, node: FuncCall) RETURNS !Call
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE formats = (node.args |> SELECT { MUTABLE rtoc_mutable_block_param_163 = COPY _;
    mIRLowering__zig_format_for_type(rtoc_self_view, TRY (aST__full_type_mut(rtoc_mutable_block_param_163))) }).join(" ");
    MUTABLE args_mir = node.args |> SELECT mIRLowering__hoist_alloc(rtoc_self_view, TRY (mIRLowering__widen_symbol_to_bytes(rtoc_self_view, TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(_))), _)), _);
    MUTABLE format_lit = Lit{ value: "\"${formats}\\n\"", lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE tuple = TupleLiteral{ items: COPY args_mir, lowered_node_id: NIL, ownership_consumption: NIL };
    RETURN Call{ callee: "std.debug.print", args: [Emittable{ Lit: COPY format_lit }, Emittable{ TupleLiteral: COPY tuple }], try_wrap: FALSE, owned_return: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(2)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL };
}
END
PRIVATE FN mIRLowering__zig_format_for_type(self: MIRLowering, flux_type: Type) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (TRY (type__string?(flux_type)) OR ((type__array?(flux_type) AND ((TRY (type__element_type(flux_type)) != NIL) AND type__byte?(((TRY (type__element_type(flux_type)))?)))))) THEN
      RETURN "{s}";
    END
    IF (((type__resolved(flux_type) == :Number) OR (type__resolved(flux_type) == :Int64)) OR type__byte?(flux_type)) THEN
      RETURN "{d}";
    END
    IF (((type__resolved(flux_type) == :Bool) OR (type__resolved(flux_type) == :Boolean)) OR type__void?(flux_type)) THEN
      RETURN "{}";
    END
    RETURN "{any}";
}
END
PRIVATE FN mIRLowering__callee_can_fail?(self: MIRLowering, name: String) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (name.length() == 0) THEN
      RETURN TRUE;
    END
    MUTABLE sig: ?FunctionSignature@multiowned = TRY (mIRLowering__fn_sig_for(rtoc_self_view, Name{ StringValue: COPY name }));
    IF sig EXISTS AS sig_value THEN
      RETURN (functionSignature__can_fail(sig_value) != FALSE);
    ELSE
      RETURN TRUE;
    END
}
END
PRIVATE FN mIRLowering__collect_identifier_names(self: MIRLowering, nodes: []Node) RETURNS ![Set]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE names = Set[];
    aST__each_locatable(nodes, %(node: Locatable) USE(MUTABLE names) -> {
    IF node IS_A Identifier AS identifier THEN
        &names.insert(identifier__name(identifier));
    END
    rubyToClearVoid()
    });
    RETURN names;
}
END
