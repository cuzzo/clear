    comptime_args = comptime_args;
    runtime_ast_args = runtime_ast_args;
    MUTABLE comptime_mir = comptime_args |> SELECT mIRLowering__lower_extern_arg(&rtoc_self_view, _);
    MUTABLE sig: ?FunctionSignature@multiowned = TRY (mIRLowering__fn_sig_for(rtoc_self_view, node.name));
    MUTABLE sig_params = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_412: ?[]Param = NIL;
    IF sig != NIL THEN
