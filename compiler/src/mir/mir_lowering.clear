# as `unsupportedRuby` stubs that did not even resolve.
PRIVATE FN mIRLowering__lower_intrinsic_arg(MUTABLE self: MIRLowering, arg: Locatable, sink_type: ?Type, takes: Bool, pre_resolved_alloc: ?String@symbol) RETURNS !Emittable
