PRIVATE FN mIRLowering__materialize_with_capability_binding(MUTABLE self: MIRLowering, MUTABLE materialization: WithBindingMaterialization, context: WithCapabilityBindingContext) RETURNS !Void ->
    IF (context.cap.capability == :multiowned) OR (context.cap.capability == :shared) THEN
      withBindingMaterialization__add_binding( &materialization, WithBindingNode{ ArrayValue: COPY TRY (mIRLowering__shared_capability_binding(self, context)) });
    ELSE_IF (context.cap.capability == symbol("EXCLUSIVE")) THEN
      MUTABLE exclusive = TRY (mIRLowering__exclusive_capability_binding(&self, context));
      IF !((exclusive.length() == 0)) THEN
        withBindingMaterialization__add_binding( &materialization, WithBindingNode{ ArrayValue: COPY exclusive });
      END
      IF (!((exclusive.length() == 0)) AND (context.clause != NIL)) THEN
        TRY (mIRLowering__append_fallible_clause(&self, &materialization, context));
      END
    ELSE_IF (context.cap.capability == :write_locked_read) THEN
      MUTABLE read_lock = TRY (mIRLowering__read_locked_capability_binding(&self, context));
      IF !((read_lock.length() == 0)) THEN
        withBindingMaterialization__add_binding( &materialization, WithBindingNode{ ArrayValue: COPY read_lock });
      END
      IF (!((read_lock.length() == 0)) AND (context.clause != NIL)) THEN
        TRY (mIRLowering__append_fallible_clause(&self, &materialization, context));
      END
    ELSE_IF (context.cap.capability == symbol("BORROWED")) THEN
      withBindingMaterialization__add_binding( &materialization, WithBindingNode{ ArrayValue: COPY TRY (mIRLowering__borrowed_capability_binding(self, context)) });
    ELSE_IF (context.cap.capability == symbol("RESTRICT")) THEN
      MUTABLE restrict = TRY (mIRLowering__restrict_capability_binding(self, context));
      IF !((restrict.length() == 0)) THEN
        withBindingMaterialization__add_binding( &materialization, WithBindingNode{ ArrayValue: COPY restrict });
      END
    ELSE_IF (context.cap.capability == symbol("VIEW")) THEN
      withBindingMaterialization__add_binding( &materialization, WithBindingNode{ ArrayValue: COPY TRY (mIRLowering__view_capability_binding(self, context)) });
    ELSE_IF (context.cap.capability == :UNSAFE_VIEW) THEN
      withBindingMaterialization__add_binding( &materialization, WithBindingNode{ ArrayValue: COPY TRY (mIRLowering__unsafe_foreign_view_binding(self, context)) });
    ELSE_IF (context.cap.capability == symbol("SNAPSHOT")) THEN
      MUTABLE snapshot: ?SnapshotRead = TRY (mIRLowering__snapshot_capability_binding(&self, context));
      IF snapshot EXISTS AS snapshot_value THEN
        withBindingMaterialization__add_binding( &materialization, WithBindingNode{ Emittable: Emittable{ SnapshotRead: COPY snapshot_value } });
      END
    ELSE_IF (context.cap.capability == :MATERIALIZED_VIEW) THEN
      FOR _ IN TRY (mIRLowering__materialized_view_capability_bindings(self, context)) DO
      withBindingMaterialization__add_binding( &materialization, _);
      END
    END
END
PRIVATE FN mIRLowering__append_fallible_clause(MUTABLE self: MIRLowering, MUTABLE materialization: WithBindingMaterialization, context: WithCapabilityBindingContext) RETURNS !Void ->
    MUTABLE clause: ?ErrorClause = COPY context.clause;
    IF clause EXISTS AS clause_value THEN
