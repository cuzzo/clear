    END
    rtoc_indexed_output_415
    };
    MUTABLE return_type = mIRLowering__extern_trampoline_return_type(rtoc_self_view, Locatable{ FuncCall: COPY node }, sig);
    RETURN ExternTrampoline{ id: id.value, callee_name: COPY CAST(((source.symbol() OR_ELSE node.name)) AS String), module_alias: COPY mod_alias, comptime_args: COPY comptime_mir, runtime_args: COPY args_with_types, alloc_kind: COPY alloc_kind, return_type: CAST(COPY return_type AS Type), stdlib_def: mIRLowering__extern_trampoline_stdlib_def(rtoc_self_view, CAST(return_type AS Type), alloc_kind, Locatable{ FuncCall: COPY node }), method_name: NIL, receiver: NIL };
}
END
PRIVATE FN mIRLowering__build_extern_trampoline_method(MUTABLE self: MIRLowering, MUTABLE node: MethodCall) RETURNS !ExternTrampoline
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE signature: ?FunctionSignature@multiowned = NIL;
    MUTABLE id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_416 = mIRLowering__lowering_counters(rtoc_self_view);
    mIRLoweringCounters__next_extern_id(&rtoc_mutable_receiver_416) };
    MUTABLE obj: Emittable = CAST(TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(node.object))) AS Emittable);
    MUTABLE args = node.args |> SELECT ExternTrampolineArg{ expr: COPY mIRLowering__lower_extern_arg(&rtoc_self_view, _), field_type: NIL, field_zig_type: NIL };
    signature = functionSignature__unwrap(ruby_wrap_optional_FunctionSignature_multiowned_X(KEEP node.matched_signature));
    MUTABLE return_type = mIRLowering__extern_trampoline_return_type(rtoc_self_view, &node, signature);
    RETURN ExternTrampoline{ id: id.value, callee_name: COPY node.name, method_name: COPY node.name, receiver: COPY obj, runtime_args: COPY args, alloc_kind: COPY (IF node.extern_effects != NIL THEN
      node.extern_effects[:alloc]
    ELSE
      NIL
    END), return_type: CAST(COPY return_type AS Type), stdlib_def: mIRLowering__extern_trampoline_stdlib_def(rtoc_self_view, CAST(return_type AS Type), (IF node.extern_effects != NIL THEN
      node.extern_effects[:alloc]
    ELSE
      NIL
    END), node), module_alias: NIL, comptime_args: List[] };
}
END
PRIVATE FN mIRLowering__extern_trampoline_return_type(self: MIRLowering, MUTABLE node: Locatable, signature: ?FunctionSignature) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE expression_type = TRY (aST__full_type_mut(node));
    IF !(type__error_union?((IF signature != NIL THEN
      functionSignature__return_type(signature)
    ELSE
      NIL
    END))) THEN
      RETURN expression_type;
    END
    IF expression_type.error_union?() THEN
      RETURN expression_type;
    END
    RETURN TRY (type__error_union_of(expression_type));
}
END
PRIVATE FN mIRLowering__extern_trampoline_stdlib_def(self: MIRLowering, return_type: Type, alloc_kind: ?String@symbol, ast_node: Locatable) RETURNS !FunctionSignature@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE payload_t_branch_value: ?Type = NIL;
    IF type__error_union?(return_type) THEN
      payload_t_branch_value = UNWRAP (TRY (type__payload_type(return_type)));
    ELSE
      payload_t_branch_value = COPY return_type;
    END
    MUTABLE payload_t: Type = payload_t_branch_value?;
    MUTABLE ast_symbol = IF respondsTo?(ast_node, "symbol") THEN
      ast_node.symbol()
    ELSE
      NIL
    END;
    MUTABLE is_heap = (!(TRY (type__c_string?(payload_t))) AND ((((alloc_kind == :heap) OR ((ast_symbol != NIL) AND (ast_symbol.heap_storage?() == TRUE))) OR type__heap?(payload_t))));
    IF is_heap THEN
      RETURN TRY (functionSignature__allocating_intrinsic());
    ELSE
      RETURN TRY (functionSignature__borrowing_intrinsic());
    END
}
END
PRIVATE FN mIRLowering__c_abi_param_uses_address?(self: MIRLowering, param: ?Param) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF param EXISTS AS param_value THEN
      MUTABLE type = TRY (type__new(TypeConstructionInput{ Type: COPY param_value.type }));
      RETURN ((param_value.mutable == TRUE) OR (((type__array?(type) AND (type__fixed?(type) == TRUE)) AND !(TRY (type__string?(type))))));
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN mIRLowering__c_abi_param_zig_type(self: MIRLowering, param: Param) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE type = TRY (type__new(TypeConstructionInput{ Type: COPY param.type }));
    MUTABLE zig_type = TRY (type__zig_type(type, TRUE));
    IF ((type__array?(type) AND type__fixed?(type)) AND !(TRY (type__string?(type)))) THEN
      RETURN "${IF param.mutable != NIL THEN
        "*"
      ELSE
        "*const "
      END}${zig_type}";
    END
    IF param.mutable EXISTS AS mutable_value THEN
      RETURN "*${zig_type}";
    ELSE
      RETURN zig_type;
    END
}
END
PRIVATE FN mIRLowering__lower_c_abi_callback_arg(MUTABLE self: MIRLowering, arg: Locatable, param: ?Param, source: ?ExternSource) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lowered = mIRLowering__lower_extern_arg(&rtoc_self_view, arg);
    IF !((((source != NIL) AND (source.abi == :c)) AND (param != NIL))) THEN
      RETURN lowered;
    END
    MUTABLE type = TRY (type__new(TypeConstructionInput{ Type: COPY param.type }));
    MUTABLE signature: ?FunctionType = type__function_type(type);
    IF !(((signature != NIL) AND (signature.abi == :c))) THEN
      RETURN lowered;
    END
    MUTABLE clear_function_branch_value: ?Emittable = NIL;
    IF lowered IS_A AddressOf AS address_of THEN
      clear_function_branch_value = addressOf__expr(address_of);
    ELSE
      clear_function_branch_value = lowered;
    END
    MUTABLE clear_function: Emittable = clear_function_branch_value?;
    RETURN Emittable{ CFunctionAdapter: COPY CFunctionAdapter{ clear_function: COPY clear_function, signature: COPY signature? } };
}
END
PRIVATE FN mIRLowering__lambda_tail_pipeline?(self: MIRLowering, expr: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE node: Any = COPY expr;
    WHILE (node IS_A BlockExpr OR node IS_A Cast) DO
      node = IF node IS_A BlockExpr THEN
        node.result()
      ELSE
        node.value()
      END;
    END
    IF !(node IS_A BinaryOp) THEN
      RETURN FALSE;
    END
    RETURN (node.smooth?() == TRUE);
}
END
PRIVATE FN mIRLowering__lower_lambda(MUTABLE self: MIRLowering, MUTABLE node: LambdaLit) RETURNS !LambdaExpr
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
