WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE is_param = mIRLowering__with_cap_is_param?(rtoc_self_view, context.var_node);
    IF ((COPY context.node).polymorphic AND is_param) THEN
      RETURN NIL;
    ELSE
