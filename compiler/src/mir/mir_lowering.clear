    MUTABLE source_receiver = FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__ctx_map${id.toString()}", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "source", lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE source_guard_branch_value: ?DeferStmt = NIL;
      IF (operation.handle_use == TenseHandleUse.SharedRead) THEN
