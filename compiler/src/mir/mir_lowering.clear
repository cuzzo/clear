->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A Identifier AS identifier THEN
      RETURN ((IF mIRLowering__capture_state(rtoc_self_view).do_capture_map != NIL THEN
        (mIRLowering__capture_state(rtoc_self_view).do_capture_map)[identifier__name(identifier)]
      ELSE
        NIL
      END) OR_ELSE identifier__name(identifier));
    ELSE_IF node IS_A GetField AS get_field THEN
      RETURN "${mIRLowering__build_field_path_zig(rtoc_self_view, castLocatableToFieldPathNode(get_field.target))}.${get_field.field}";
    ELSE
      RETURN COPY CAST(node AS String);
    END
}
END
PRIVATE FN mIRLowering__with_binding_materialization(MUTABLE self: MIRLowering, node: WithBlock, with_label: ?String, rt_name: String) RETURNS WithBindingMaterialization
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE materialization = WithBindingMaterialization{ bindings: ( { MUTABLE rtoc_empty_list_426: []WithBindingNode = List[]; rtoc_empty_list_426 } ), fallible_clauses: ( { MUTABLE rtoc_empty_list_427: []FallibleClauseFact = List[]; rtoc_empty_list_427 } ) };
    MUTABLE caps = mIRLowering__with_capability_specs(rtoc_self_view, node);
    MUTABLE clause: ?ErrorClause = COPY CAST(node.lock_error_clause AS ?ErrorClause);
    MUTABLE fallible_caps = caps |> WHERE ([symbol("EXCLUSIVE"), :write_locked_read]).contains?(_.capability);
    MUTABLE needs_sort = (fallible_caps.length() >= 2);
    IF needs_sort THEN
      mIRLowering__materialize_sorted_lock_bindings(&rtoc_self_view, node, materialization, fallible_caps, clause, with_label);
    END
    FOR _ IN caps DO
    MUTABLE context = mIRLowering__with_capability_binding_context(rtoc_self_view, node, _, clause, with_label, needs_sort, rt_name);
    mIRLowering__materialize_with_capability_binding(&rtoc_self_view, materialization, context);
    END
    RETURN materialization;
}
END
PRIVATE FN mIRLowering__with_capability_specs(self: MIRLowering, node: WithBlock) RETURNS ![]CapabilityTransition
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY (TRY (capabilityPlan__require_for(node))).all;
}
END
PRIVATE FN mIRLowering__materialize_sorted_lock_bindings(MUTABLE self: MIRLowering, node: WithBlock, materialization: WithBindingMaterialization, fallible_caps: []CapabilityTransition, clause: ?ErrorClause, with_label: ?String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF clause EXISTS AS clause_value THEN
      MUTABLE clause_value_mutable = COPY clause_value;
      withBindingMaterialization__add_binding(materialization, WithBindingNode{ Emittable: COPY CAST(mIRLowering__sorted_lock_acquire(&rtoc_self_view, fallible_caps, clause_value_mutable, with_label, node) AS Emittable) });
      FOR _ IN fallible_caps DO
    MUTABLE var_name = COPY _.target_label;
    MUTABLE alias_name = COPY _.alias_name;
    withBindingMaterialization__add_fallible_clause(materialization, mIRLowering__build_fallible_clause_mir(&rtoc_self_view, var_name, alias_name, clause_value_mutable));
      END
    ELSE
      withBindingMaterialization__add_binding(materialization, WithBindingNode{ Emittable: COPY CAST(mIRLowering__sorted_lock_acquire(&rtoc_self_view, fallible_caps, NIL, with_label, node) AS Emittable) });
    END
}
END
PRIVATE FN mIRLowering__with_capability_binding_context(self: MIRLowering, node: WithBlock, cap: CapabilityTransition, clause: ?ErrorClause, with_label: ?String, needs_sort: Bool, rt_name: String) RETURNS WithCapabilityBindingContext
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE var_node: CapabilityVarNode = COPY castLocatableToCapabilityVarNode(cap.var_node);
    MUTABLE var_name = COPY cap.target_label;
    MUTABLE alias_name = COPY cap.alias_name;
    RETURN WithCapabilityBindingContext{ node: node, cap: COPY cap, var_node: COPY var_node, var_name: COPY var_name, alias_name: COPY alias_name, resolved_type: COPY cap.resolved_type, var_sync: COPY cap.sync, var_storage: COPY cap.storage, zig_var: COPY mIRLowering__with_cap_zig_target(rtoc_self_view, var_node, var_name), clause: COPY clause, with_label: COPY with_label, needs_sort: COPY needs_sort, rt_name: COPY rt_name };
}
END
PRIVATE FN mIRLowering__materialize_with_capability_binding(MUTABLE self: MIRLowering, materialization: WithBindingMaterialization, context: WithCapabilityBindingContext) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (context.cap.capability == :multiowned) OR (context.cap.capability == :shared) THEN
      withBindingMaterialization__add_binding(materialization, WithBindingNode{ ArrayValue: COPY mIRLowering__shared_capability_binding(rtoc_self_view, context) });
    ELSE_IF (context.cap.capability == symbol("EXCLUSIVE")) THEN
      MUTABLE exclusive = mIRLowering__exclusive_capability_binding(&rtoc_self_view, context);
      IF !((exclusive.length() == 0)) THEN
        withBindingMaterialization__add_binding(materialization, WithBindingNode{ ArrayValue: COPY exclusive });
      END
      IF (!((exclusive.length() == 0)) AND (context.clause != NIL)) THEN
        mIRLowering__append_fallible_clause(&rtoc_self_view, materialization, context);
      END
    ELSE_IF (context.cap.capability == :write_locked_read) THEN
      MUTABLE read_lock = mIRLowering__read_locked_capability_binding(&rtoc_self_view, context);
      IF !((read_lock.length() == 0)) THEN
        withBindingMaterialization__add_binding(materialization, WithBindingNode{ ArrayValue: COPY read_lock });
      END
      IF (!((read_lock.length() == 0)) AND (context.clause != NIL)) THEN
        mIRLowering__append_fallible_clause(&rtoc_self_view, materialization, context);
      END
    ELSE_IF (context.cap.capability == symbol("BORROWED")) THEN
      withBindingMaterialization__add_binding(materialization, WithBindingNode{ ArrayValue: COPY mIRLowering__borrowed_capability_binding(rtoc_self_view, context) });
    ELSE_IF (context.cap.capability == symbol("RESTRICT")) THEN
      MUTABLE restrict = mIRLowering__restrict_capability_binding(rtoc_self_view, context);
      IF !((restrict.length() == 0)) THEN
        withBindingMaterialization__add_binding(materialization, WithBindingNode{ ArrayValue: COPY restrict });
      END
    ELSE_IF (context.cap.capability == symbol("VIEW")) THEN
      withBindingMaterialization__add_binding(materialization, WithBindingNode{ ArrayValue: COPY mIRLowering__view_capability_binding(rtoc_self_view, context) });
    ELSE_IF (context.cap.capability == :UNSAFE_VIEW) THEN
      withBindingMaterialization__add_binding(materialization, WithBindingNode{ ArrayValue: COPY mIRLowering__unsafe_foreign_view_binding(rtoc_self_view, context) });
    ELSE_IF (context.cap.capability == symbol("SNAPSHOT")) THEN
      MUTABLE snapshot: ?SnapshotRead = mIRLowering__snapshot_capability_binding(rtoc_self_view, context);
      IF snapshot EXISTS AS snapshot_value THEN
        withBindingMaterialization__add_binding(materialization, WithBindingNode{ Emittable: Emittable{ SnapshotRead: COPY snapshot_value } });
      END
    ELSE_IF (context.cap.capability == :MATERIALIZED_VIEW) THEN
      FOR _ IN mIRLowering__materialized_view_capability_bindings(rtoc_self_view, context) DO
      withBindingMaterialization__add_binding(materialization, _);
      END
    END
}
END
PRIVATE FN mIRLowering__append_fallible_clause(MUTABLE self: MIRLowering, materialization: WithBindingMaterialization, context: WithCapabilityBindingContext) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE clause: ?ErrorClause = COPY context.clause;
    IF clause EXISTS AS clause_value THEN
      MUTABLE clause_value_mutable = COPY clause_value;
      withBindingMaterialization__add_fallible_clause(materialization, mIRLowering__build_fallible_clause_mir(&rtoc_self_view, context.var_name, context.alias_name, clause_value_mutable));
    ELSE
      RETURN;
    END
}
END
PRIVATE FN mIRLowering__with_capability_source_mir(self: MIRLowering, var_node: CapabilityVarNode, raw_atomic: Bool = FALSE) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE lowerer: MIRLowering@multiowned = CAST(rtoc_self_view AS MIRLowering@multiowned);
    MUTABLE prev_locked: ?{String}LockedUnwrapMapValue = COPY mIRLowering__capability_state(lowerer).locked_unwrap_map;
    MUTABLE prev_rc: ?{String}String = COPY mIRLowering__capability_state(lowerer).rc_unwrap_map;
    MUTABLE prev_raw = mIRLowering__capability_state(lowerer).atomic_emit_raw;
    MUTABLE rtoc_writer_receiver_428: MIRLoweringCapabilityState = mIRLowering__capability_state(lowerer);
    rtoc_writer_receiver_428.locked_unwrap_map = NIL;
    MUTABLE rtoc_writer_receiver_429: MIRLoweringCapabilityState = mIRLowering__capability_state(lowerer);
    rtoc_writer_receiver_429.rc_unwrap_map = NIL;
    IF raw_atomic THEN
      MUTABLE rtoc_writer_receiver_430: MIRLoweringCapabilityState = mIRLowering__capability_state(lowerer);
      rtoc_writer_receiver_430.atomic_emit_raw = TRUE;
    END
    DEFER {
    MUTABLE rtoc_writer_receiver_431: MIRLoweringCapabilityState = mIRLowering__capability_state(lowerer);
    rtoc_writer_receiver_431.atomic_emit_raw = prev_raw;
    MUTABLE rtoc_writer_receiver_432: MIRLoweringCapabilityState = mIRLowering__capability_state(lowerer);
    rtoc_writer_receiver_432.locked_unwrap_map = prev_locked;
    MUTABLE rtoc_writer_receiver_433: MIRLoweringCapabilityState = mIRLowering__capability_state(lowerer);
    rtoc_writer_receiver_433.rc_unwrap_map = prev_rc;
    }
    RETURN CAST(TRY (mIRLowering__lower(&lowerer, castCapabilityVarNodeToMIRLoweringLowerableStmt(var_node))) AS Emittable);
}
END
PRIVATE FN mIRLowering__safe_with_capability_alias(self: MIRLowering, alias_name: String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE cleaned: String = "";
    IF ((alias_name.endsWith?("!") OR alias_name.endsWith?("?"))) THEN
      cleaned = COPY alias_name.substr(0, (((alias_name.length() - 2) - 0) + 1));
    ELSE
      cleaned = COPY alias_name;
    END
    IF (cleaned == name) THEN
      cleaned = zig_name;
    END
    IF zigType__primitive_numeric_identifier?(cleaned) THEN
      RETURN "@\"${cleaned}\"";
    ELSE
      RETURN cleaned;
    END
}
END
