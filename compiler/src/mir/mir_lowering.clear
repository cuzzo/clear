      proxy.storage = node.storage();
      proxy.slot_size = node.slot_size;
      proxy.resource_close_plan = COPY node.resource_close_plan;
      proxy.var_used = node.var_used;
      IF (TRUE AND TRUE) THEN
        proxy.container_borrow = node.container_borrow;
      END
      IF (TRUE AND TRUE) THEN
        proxy.symbol = COPY node.symbol;
      END
      IF (TRUE AND TRUE) THEN
        proxy.mir_binding_entry = node.mir_binding_entry;
      END
      proxy.ownership_transport_plan = node.ownership_transport_plan;
      MUTABLE result = mIRLowering__lower_var_decl(&rtoc_self_view, proxy);
      MUTABLE decl_name_map = TRY (functionState__decl_zig_names(mIRLowering__function_state(rtoc_self_view)));
      IF decl_name_map.contains?(proxy.object_id()) THEN
        MUTABLE safe_name = COPY UNWRAP (decl_name_map[proxy.object_id()]);
        decl_name_map[node.object_id()] = COPY safe_name;
