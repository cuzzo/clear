    pp = (pp OR (_.mutable() == TRUE));
    IF (_.mutable() AND !(type_str.startsWith?("*"))) THEN
        type_str = "*${type_str}";
    END
    MIRParam{ name: COPY _.name(), zig_type: COPY type_str, pointer_passed: pp, lowered_node_id: NIL, ownership_consumption: NIL }
    }));
    MUTABLE return_type_zig = TRY (type__zig_type(functionSignature__return_type(sig)));
    MUTABLE ret_str = zigType__anyerror_return_type(zigType__new(return_type_zig));
    MUTABLE body_mir = List[];
    &body_mir.append(Suppress{ name: "_rt", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
    FOR _ IN params_list DO
    &body_mir.append(Suppress{ name: COPY _.name(), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
    END
    MUTABLE body_nodes = TRY (aST__lambda_body_nodes(node.body));
    MUTABLE prefix_nodes = (body_nodes.substr(0, ((body_nodes.length() - 1) - 0)) OR_ELSE List[]);
    MUTABLE return_expr = COPY UNWRAP (body_nodes.last());
