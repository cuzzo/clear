    &stmts.append(Stmt{ Emittable: COPY CAST(ReturnStmt{ value: COPY return_value, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) });
    RETURN ScopeBlock{ body: COPY stmts |> SELECT ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_570: ?Stmt = NIL;
