PUB STRUCT MIRLowering {
  active_lifecycle_registry: ?LifecycleRegistry@multiowned,
  state: MIRLoweringState,
  # Ruby holds the function whose kept-liveness is being computed, its memoized
  # liveness result, and a stack because kept-edge calls nest.
  kept_liveness_fn: ?FunctionDef@multiowned,
  kept_liveness: ?KeptEdgeLiveness@multiowned,
  kept_edge_temp_stack: []KeptEdgeCallFrame
}

UNION MIRLoweringOwnershipFact { OwnedCreate: OwnedCreate, OwnedDestroy: OwnedDestroy, OwnedTransfer: OwnedTransfer, OwnedBorrow: OwnedBorrow, OwnedStore: OwnedStore, OwnedReturn: OwnedReturn }
