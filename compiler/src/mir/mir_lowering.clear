    MUTABLE prev_rt = mIRLowering__runtime_binding_name(&rtoc_self_view);
    rtoc_self_view.state.capture.do_capture_map = new_entries.keys() |> REDUCE(COPY prev_map) { acc[_] = COPY UNWRAP (new_entries[_]); acc };
    rtoc_self_view.state.capture.current_fiber_capture_symbols = capture_symbols.keys() |> REDUCE(COPY prev_syms) { acc[_] = COPY UNWRAP (capture_symbols[_]); acc };
    rtoc_self_view.state.runtime.rt_name = COPY rt_override;
