    Locatable.CloseStream AS cast_payload -> RETURN MIRLoweringLowerableStmt{ CloseStream: COPY cast_payload };,
    Locatable.NextExpr AS cast_payload -> RETURN MIRLoweringLowerableStmt{ NextExpr: COPY cast_payload };,
    Locatable.MatchStatement AS cast_payload -> RETURN MIRLoweringLowerableStmt{ MatchStatement: COPY cast_payload };,
    Locatable.ForRange AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ForRange: COPY cast_payload };,
    Locatable.ForEach AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ForEach: COPY cast_payload };,
    Locatable.TestBlock AS cast_payload -> RETURN MIRLoweringLowerableStmt{ TestBlock: COPY cast_payload };,
    Locatable.WhenBlock AS cast_payload -> RETURN MIRLoweringLowerableStmt{ WhenBlock: COPY cast_payload };,
    Locatable.LetBinding AS cast_payload -> RETURN MIRLoweringLowerableStmt{ LetBinding: COPY cast_payload };,
    Locatable.TestThat AS cast_payload -> RETURN MIRLoweringLowerableStmt{ TestThat: COPY cast_payload };,
    Locatable.AssertRaises AS cast_payload -> RETURN MIRLoweringLowerableStmt{ AssertRaises: COPY cast_payload };,
    Locatable.BenchmarkStmt AS cast_payload -> RETURN MIRLoweringLowerableStmt{ BenchmarkStmt: COPY cast_payload };,
    Locatable.SmashStmt AS cast_payload -> RETURN MIRLoweringLowerableStmt{ SmashStmt: COPY cast_payload };,
    Locatable.ProfileStmt AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ProfileStmt: COPY cast_payload };,
    Locatable.StubDecl AS cast_payload -> RETURN MIRLoweringLowerableStmt{ StubDecl: COPY cast_payload };,
    Locatable.Drop AS cast_payload -> RETURN MIRLoweringLowerableStmt{ Drop: COPY cast_payload };,
    Locatable.SuppressCleanup AS cast_payload -> RETURN MIRLoweringLowerableStmt{ SuppressCleanup: COPY cast_payload };,
    Locatable.Return AS cast_payload -> RETURN MIRLoweringLowerableStmt{ Return: COPY cast_payload };,
    Locatable.ReassignCleanup AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ReassignCleanup: COPY cast_payload };,
    Locatable.FieldCleanup AS cast_payload -> RETURN MIRLoweringLowerableStmt{ FieldCleanup: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to MIRLoweringLowerableStmt");
  END
  panic("Invalid cast to MIRLoweringLowerableStmt");
END

# The list form of the same cast, moved for the same reason.
PUB FN castLocatableListToMIRLoweringLowerableStmtList(values: []Locatable) RETURNS []MIRLoweringLowerableStmt ->
  MUTABLE out: []MIRLoweringLowerableStmt = List[];
  FOR value IN values DO
    &out.append(castLocatableToMIRLoweringLowerableStmt(value));
  END
  RETURN out;
END

# Ruby asks `respond_to?(:name)` and then reads it. A union variant either
# carries the field or it does not, so the question is answered here.
PUB FN mIRLoweringTransferMark__name(value: MIRLoweringTransferMark) RETURNS ?String ->
  PARTIAL MATCH value START
    MIRLoweringTransferMark.TransferMark AS item -> RETURN COPY item.name;,
    MIRLoweringTransferMark.MoveMark AS item -> RETURN COPY item.name;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END

# Ruby asks `respond_to?(:token)` and then reads it. A union variant either
# carries the field or it does not, so the question is answered here.
PUB FN mIRLoweringLowerableStmt__token(value: MIRLoweringLowerableStmt) RETURNS ?Token ->
