          END
        ELSE_IF last_mir THEN
          MUTABLE ctx_ident = Ident{ name: "__ctx_${UNWRAP (ctx_id).toString()}", lowered_node_id: NIL, ownership_consumption: NIL };
          MUTABLE target = FieldGet{ object: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY ctx_ident }, field: "inner", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "result", lowered_node_id: NIL, ownership_consumption: NIL };
          MUTABLE result_value = mIRLowering__coerce_fsm_result_value(rtoc_self_view, mIRLowering__strip_try(rtoc_self_view, UNWRAP (last_mir)), expr_t);
          result_value = mIRLowering__async_payload_storage_value(rtoc_self_view, result_value, (async_result_shape OR_ELSE TRY (asyncResultShape__promise(result_destination_type))));
          MUTABLE result_set = Set{ target: Emittable{ FieldGet: COPY target }, value: COPY result_value, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
          MUTABLE transfer_facts = mIRLowering__fsm_result_transfer_facts(rtoc_self_view, UNWRAP (last_mir), last_step_value_mutable.expr, result_destination_type);
          mIRLowering__capture_state(rtoc_self_view).last_fsm_result_transfer_facts = ruby_array_concat_FsmResultTransferFact(mIRLowering__capture_state(rtoc_self_view).last_fsm_result_transfer_facts, transfer_facts);
          mIRLowering__guard_fsm_result_cleanup_mut(rtoc_self_view, result_mir, transfer_facts);
