PRIVATE FN mIRLowering__lower_struct_lifecycle_methods(MUTABLE self: MIRLowering, node: StructDef) RETURNS ![]FnDef
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE self_ref = Ident{ name: "self", lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE alloc_ref = Ident{ name: "alloc", lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE drop_statements: []Emittable = List[];
    MUTABLE clone_statements: []Emittable = [CAST(Let{ name: COPY "result", init: Emittable{ Ident: COPY self_ref }, mutable: TRUE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } AS Emittable)];
    MUTABLE clone_fields: []String = List[];
    MUTABLE copy_forbidden: Bool = FALSE;
    FOR rtoc_key IN node.field_decls.keys() DO
    MUTABLE field: StructField@multiowned = COPY UNWRAP (node.field_decls[rtoc_key]);
    IF structField__borrowed(field) THEN
      CONTINUE;
    END
    MUTABLE field_type = structField__type(field);
    MUTABLE rtoc_recv_4595 = mIRLowering__lifecycle_registry(&rtoc_self_view);
    MUTABLE plan = COPY TRY (lifecycleRegistry__fetch(rtoc_recv_4595, field_type));
    MUTABLE field_ref = FieldGet{ object: Emittable{ Ident: COPY self_ref }, field: COPY rtoc_key, lowered_node_id: NIL, ownership_consumption: NIL };
    IF (plan.drop_strategy == :resource_close) THEN
        &drop_statements.append(CAST(ResourceClose{ target: Emittable{ FieldGet: COPY field_ref }, close_plan: UNWRAP (plan.resource_close_plan), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable));
    ELSE_IF type__optional?(field_type) THEN
        MUTABLE wrapped = UNWRAP (TRY (type__wrapped_type(field_type)));
        MUTABLE rtoc_recv_4602 = mIRLowering__lifecycle_registry(&rtoc_self_view);
        MUTABLE wrapped_plan = COPY TRY (lifecycleRegistry__fetch(rtoc_recv_4602, wrapped));
        IF (wrapped_plan.drop_strategy == :resource_close) THEN
          MUTABLE capture = "__close_${mIRLowering__zig_safe_name(rtoc_self_view, rtoc_key)}";
          &drop_statements.append(CAST(IfBindStmt{ bindings: [MIRIfBinding{ expr: CAST(COPY field_ref AS Emittable), capture: MirCapture{ StringValue: COPY capture }, node_ref: NIL, owns_capture: NIL, predicate: NIL, pointer_capture: TRUE }], then_body: [Emittable{ ResourceClose: COPY ResourceClose{ target: Emittable{ Deref: COPY Deref{ expr: Emittable{ Ident: COPY Ident{ name: COPY capture, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, close_plan: UNWRAP (wrapped_plan.resource_close_plan), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable));
        ELSE_IF lifecyclePlan__needs_drop?(plan) THEN
          &drop_statements.append(TRY (mIRLowering__lifecycle_cleanup_statement(&rtoc_self_view, Expr{ Emittable: Emittable{ FieldGet: COPY field_ref } }, field_type, Expr{ Emittable: Emittable{ Ident: COPY alloc_ref } })));
        END
    ELSE_IF lifecyclePlan__needs_drop?(plan) THEN
        &drop_statements.append(TRY (mIRLowering__lifecycle_cleanup_statement(&rtoc_self_view, Expr{ Emittable: Emittable{ FieldGet: COPY field_ref } }, field_type, Expr{ Emittable: Emittable{ Ident: COPY alloc_ref } })));
    END
    IF (plan.copy_strategy == :forbidden) THEN
        copy_forbidden = TRUE;
    ELSE_IF (plan.copy_strategy != :bit_copy) THEN
        &clone_fields.append(COPY rtoc_key);
        MUTABLE field_source = "self.${mIRLowering__zig_safe_name(rtoc_self_view, rtoc_key)}";
        MUTABLE tmp_name = "__clone_${rtoc_key}";
        &clone_statements.append(CAST(Let{ name: COPY tmp_name, init: Emittable{ Lit: COPY Lit{ value: "try CheatLib.dupeValue(@TypeOf(${field_source}), ${field_source}, alloc)", lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } AS Emittable));
        &clone_statements.append(CAST(ExprStmt{ expr: Emittable{ Lit: COPY Lit{ value: "errdefer CheatLib.cleanup(@TypeOf(${tmp_name}), alloc, &${tmp_name})", lowered_node_id: NIL, ownership_consumption: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable));
        &clone_statements.append(CAST(Set{ target: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "result", lowered_node_id: NIL, ownership_consumption: NIL } }, field: COPY rtoc_key, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Ident: COPY Ident{ name: COPY tmp_name, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable));
    END
    END
    MUTABLE methods: []FnDef = List[];
    drop_statements = ([Emittable{ Suppress: COPY Suppress{ name: "alloc", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] + drop_statements);
    IF (drop_statements.length() == 1) THEN
      drop_statements = ([Emittable{ Suppress: COPY Suppress{ name: "self", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] + drop_statements);
    END
    &methods.append(FnDef{ name: "__clear_drop", params: [MIRParam{ name: "self", zig_type: "*@This()", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL }, MIRParam{ name: "alloc", zig_type: "std.mem.Allocator", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL }], ret_type: "void", body: COPY drop_statements, visibility: :pub, can_fail: FALSE, comptime_params: List[], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
    IF !(copy_forbidden) THEN
      clone_statements[0] = Let{ name: COPY "result", init: Emittable{ Ident: COPY self_ref }, mutable: !(clone_fields.empty?()), annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL };
      clone_statements = ([Emittable{ Suppress: COPY Suppress{ name: "alloc", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] + clone_statements);
      &clone_statements.append(CAST(ReturnStmt{ value: Emittable{ Ident: COPY Ident{ name: "result", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable));
      &methods.append(FnDef{ name: "__clear_clone", params: [MIRParam{ name: "self", zig_type: "@This()", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL }, MIRParam{ name: "alloc", zig_type: "std.mem.Allocator", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL }], ret_type: "@This()", body: COPY clone_statements, visibility: :pub, can_fail: TRUE, comptime_params: List[], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
    END
    RETURN methods;
}
END
PRIVATE FN mIRLowering__lifecycle_cleanup_statement(MUTABLE self: MIRLowering, field_ref: Expr, field_type: Type, alloc_ref: Expr) RETURNS !Emittable ->
    RETURN CAST(ExprStmt{ expr: castMIRLoweringReturnValueToEmittable__mir_lowering(COPY TRY (mIRLowering__emit_builtin(&self, :cleanup, [Emittable{ Ident: COPY Ident{ name: TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY field_type }, FALSE, TRUE)), lowered_node_id: NIL, ownership_consumption: NIL } }, castExprToEmittable__mir_lowering(alloc_ref), Emittable{ AddressOf: COPY AddressOf{ expr: castExprToEmittable__mir_lowering(COPY field_ref), lowered_node_id: NIL, ownership_consumption: NIL } }]))), discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable);
