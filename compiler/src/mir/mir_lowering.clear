PRIVATE FN mIRLowering__collection_param_receiver?(MUTABLE self: MIRLowering, target: Locatable) RETURNS Bool ->
    RETURN (IF target IS_A Identifier AS identifier THEN ((mIRLowering__current_function_collection_param?(&self, identifier__name(identifier)) OR ((mIRLowering__capability_state(&self).with_alias_owner_map != NIL) AND (((mIRLowering__capability_state(&self).with_alias_owner_map)?).contains?(identifier__name(identifier)) == TRUE)))) ELSE FALSE END);
END
PRIVATE FN mIRLowering__with_if_bind_alias_maps<RESULT>(MUTABLE self: MIRLowering, node: IfBind, blk: FN() -> RESULT) RETURNS !RESULT
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE prev_alias_alloc: ?{String}?String@symbol = COPY mIRLowering__capability_state(&rtoc_self_view).with_alias_alloc_map;
  MUTABLE prev_alias_owner: ?{String}String = COPY mIRLowering__capability_state(&rtoc_self_view).with_alias_owner_map;
  MUTABLE prev_if_bind_aliases: [Set]String = COPY mIRLowering__capability_state(&rtoc_self_view).if_bind_aliases;
  MUTABLE prev_pointer_aliases: [Set]String = COPY mIRLowering__capability_state(&rtoc_self_view).if_bind_pointer_aliases;
  DEFER {
  rtoc_self_view.state.capabilities.with_alias_alloc_map = prev_alias_alloc;
  rtoc_self_view.state.capabilities.with_alias_owner_map = prev_alias_owner;
  rtoc_self_view.state.capabilities.if_bind_aliases = prev_if_bind_aliases;
  rtoc_self_view.state.capabilities.if_bind_pointer_aliases = prev_pointer_aliases;
  }
  MUTABLE alias_alloc_map: {String}?String@symbol = COPY ((prev_alias_alloc OR_ELSE {}));
  MUTABLE alias_owner_map: {String}String = COPY ((prev_alias_owner OR_ELSE {}));
  MUTABLE if_bind_aliases: [Set]String = COPY prev_if_bind_aliases;
  MUTABLE pointer_aliases: [Set]String = COPY prev_pointer_aliases;
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < node.bindings.length() DO
      MUTABLE owner: ?String = TRY (mIRLowering__extract_root_var_name(&rtoc_self_view, UNWRAP (node.bindings[rtoc_idx]?.expr)));
      IF !(owner) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE alias_name = COPY (node.bindings[rtoc_idx]?.name);
      alias_owner_map[alias_name] = owner;
      alias_alloc_map[alias_name] = TRY (mIRLowering__placement_for_node(&rtoc_self_view, UNWRAP (node.bindings[rtoc_idx]?.expr)));
      &if_bind_aliases.insert(alias_name);
      IF TRY (mIRLowering__if_bind_pointer_alias?(&rtoc_self_view, UNWRAP (node.bindings[rtoc_idx]?.expr))) THEN
          RETURN &pointer_aliases.insert(alias_name);
      END
    rtoc_idx = rtoc_idx + 1;
  END
  rtoc_self_view.state.capabilities.with_alias_alloc_map = alias_alloc_map;
  rtoc_self_view.state.capabilities.with_alias_owner_map = alias_owner_map;
  rtoc_self_view.state.capabilities.if_bind_aliases = if_bind_aliases;
  rtoc_self_view.state.capabilities.if_bind_pointer_aliases = pointer_aliases;
  RETURN blk();
}
END
PRIVATE FN mIRLowering__if_bind_pointer_alias?(MUTABLE self: MIRLowering, expr: Locatable) RETURNS !Bool ->
    IF expr IS_A GetIndex AS get_index THEN
      MUTABLE get_index_mutable = COPY get_index;
      MUTABLE receiver: ?Type = TRY (type__from_node_mut(aST__node_target(Locatable{ GetIndex: COPY get_index_mutable }), "IF binding runtime shape"));
      RETURN ((type__pool?( UNWRAP (receiver)) OR TRY (mIRLowering__mutable_struct_list_bind?(self, Locatable{ GetIndex: COPY get_index_mutable }))) OR TRY (mIRLowering__plain_map_pointer_bind?(&self, Locatable{ GetIndex: COPY get_index_mutable })));
    END
    RETURN (expr IS_A MethodCall AND (locatable__pool_method(expr) == :get));
END
PRIVATE FN mIRLowering__capture_expr_payload_type(self: MIRLowering, expr: Locatable) RETURNS !Type ->
    MUTABLE ti = TRY (aST__capture_expr_source_type(expr));
    IF TRY (type__stream_step?(ti)) THEN
