PRIVATE FN mIRLowering__payload_binding_name(MUTABLE self: MIRLowering, binding: String, decl: ?Locatable, line: ?Int64) RETURNS !String ->
    MUTABLE safe = mIRLowering__zig_safe_name(self, binding);
    IF (TRY (functionState__alloc_marked_names(mIRLowering__function_state(&self)))).contains?(safe) THEN
      MUTABLE suffix: String = "";
