    &dupe_stmts.append(Stmt{ Emittable: COPY CAST(Let{ name: COPY tmp_name, init: Emittable{ Lit: COPY Lit{ value: "try CheatLib.dupeValue(@TypeOf(${field_source}), ${field_source}, alloc)", lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } AS Emittable) });
    &dupe_stmts.append(Stmt{ Emittable: COPY CAST(ExprStmt{ expr: Emittable{ Lit: COPY Lit{ value: "errdefer CheatLib.cleanup(@TypeOf(${tmp_name}), alloc, &${tmp_name})", lowered_node_id: NIL, ownership_consumption: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) });
    &dupe_stmts.append(Stmt{ Emittable: COPY CAST(Set{ target: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY result_ref }, field: COPY _.field, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Ident: COPY Ident{ name: tmp_name, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) });
      END
      &dupe_stmts.append(Stmt{ Emittable: COPY CAST(ReturnStmt{ value: Emittable{ Ident: COPY result_ref }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) });
      MUTABLE dupe_fn = FnDef{ name: "__clear_clone", params: [MIRParam{ name: "self", zig_type: "@This()", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL }, MIRParam{ name: "alloc", zig_type: "std.mem.Allocator", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL }], ret_type: "!@This()", body: Body{ ArrayValue: dupe_stmts |> SELECT castStmtToLocatable(_) }, visibility: :pub, can_fail: FALSE, comptime_params: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
      methods = [deinit_fn, dupe_fn];
