    END
    val = TRY (mIRLowering__place_value_for_destination(rtoc_self_view, val, node.value, dispatch.sink_alloc, TypeTypeInput{ Type: COPY sink_type }));
    IF !((dispatch.shard_direct AND mIRLowering__rodata_ownership_ast?(rtoc_self_view, node.value))) THEN
      val = TRY (mIRLowering__materialize_owned_sink_value(rtoc_self_view, val, node.value, dispatch.sink_alloc));
    END
    val = mIRLowering__hoist_alloc(rtoc_self_view, val, node.value, TRUE);
    IF (!(mIRLowering__bc_target?(rtoc_self_view)) AND type__rc_map?(receiver_type)) THEN
      target = Deref{ expr: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Deref: COPY target }, field: "ctrl", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "data", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL };
