PRIVATE FN mIRLowering__compute_used_let_names(self: MIRLowering, let_ast_map: {String}LetBinding, ast_subtrees: []?AstIdentifierSearchNode) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (let_ast_map.count() == 0) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_230: []String = List[]; rtoc_empty_list_230 } ) AS []String);
    END
    MUTABLE referenced = Set[];
    FOR _ IN ast_subtrees DO
    mIRLowering__collect_identifier_refs(rtoc_self_view, _, let_ast_map, &referenced);
    END
    MUTABLE changed: Bool = TRUE;
    WHILE changed DO
      changed = FALSE;
      MUTABLE rtoc_each_items_231 = (referenced |> SELECT COPY _);
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < rtoc_each_items_231.length() DO
      MUTABLE let_binding: ?LetBinding = COPY let_ast_map[rtoc_each_items_231[rtoc_idx]];
      IF !(let_binding) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE rhs = COPY let_binding.expr;
      MUTABLE before = referenced.size();
      mIRLowering__collect_identifier_refs(rtoc_self_view, castLocatableToOptionalAstIdentifierSearchNode(rhs), let_ast_map, &referenced);
      IF (referenced.size() > before) THEN
            changed = TRUE;
      END
    rtoc_idx = rtoc_idx + 1;
      END
    END
    RETURN let_ast_map.keys() |> WHERE referenced.contains?(_);
}
END
PRIVATE FN mIRLowering__collect_identifier_refs(self: MIRLowering, node: ?AstIdentifierSearchNode, name_set: {String}LetBinding, MUTABLE out: [Set]String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    aST__each_locatable(node, TRUE, %(candidate: Locatable) USE(name_set, MUTABLE out) -> {
    IF (IF candidate IS_A Identifier AS identifier THEN name_set.contains?(identifier__name(identifier)) ELSE FALSE END) THEN
        &out.insert(candidate.name());
    END
    rubyToClearVoid()
    });
}
END
