PRIVATE FN mIRLowering__lower_link(MUTABLE self: MIRLowering, node: LinkNode) RETURNS !RcDowngrade ->
    MUTABLE inner: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt(node.value)));
