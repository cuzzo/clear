PRIVATE FN mIRLowering__lower_template_indexed_assignment(MUTABLE self: MIRLowering, node: Assignment, target_node: Locatable, receiver_type: Type, target: Emittable, idx: Emittable, kind: String@symbol, op: FunctionSignature) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE val_node = COPY node.value;
    MUTABLE value_type_for_transfer = TRY (type__from_node_mut(val_node, "indexed assignment value transfer"));
    MUTABLE dispatch = mIRLowering__indexed_assignment_dispatch(rtoc_self_view, kind, receiver_type, target_node, node, op);
    MUTABLE sink_type_branch_value: ?Type = NIL;
    IF ((kind == :array) OR (kind == :list)) THEN
      sink_type_branch_value = (TRY (type__element_type(receiver_type)) OR_ELSE value_type_for_transfer);
    ELSE
      sink_type_branch_value = TRY (type__value_type(receiver_type));
    END
    MUTABLE sink_type: Type = sink_type_branch_value?;
    MUTABLE owns_transferred_value = mIRLowering__ownership_tracked_transfer_type?(rtoc_self_view, sink_type);
    MUTABLE val = mIRLowering__with_decl_alloc(rtoc_self_view, dispatch.sink_alloc, %() USE(node, sink_type, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_698 = mIRLowering__with_sink_type(rtoc_self_view, sink_type, %() USE(node, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_697 = TRY (mIRLowering__lower(&rtoc_self_view, node.value));
    rtoc_lambda_result_697
    });
    rtoc_lambda_result_698
    });
    IF !(dispatch.shard_direct) THEN
      val = TRY (mIRLowering__place_value_for_destination(rtoc_self_view, val, val_node, dispatch.sink_alloc, TypeTypeInput{ Type: COPY sink_type }));
      IF owns_transferred_value THEN
        val = TRY (mIRLowering__materialize_owned_sink_value(rtoc_self_view, val, val_node, dispatch.sink_alloc, TypeTypeInput{ Type: COPY sink_type }));
      END
      IF mIRLowering__mir_allocates?(rtoc_self_view, val) THEN
        val = mIRLowering__hoist_alloc(rtoc_self_view, val, val_node, TRUE);
      END
      IF val IS_A Ident THEN
        mIRLowering__move_mark_field_mut(rtoc_self_view, &val_node);
      END
    END
    MUTABLE ownership_operands = TRY (mIRLowering__ownership_operands_for_value(rtoc_self_view, val, val_node, "indexed assignment", dispatch.sink_alloc));
    MUTABLE consumed_names: []String = ownership_operands |> SELECT:? (IF !((_.kind == :owned_binding)) THEN NIL ELSE _.name END) |> WHERE _ != NIL;
    MUTABLE entry: FunctionSignature@multiowned = op;
    MUTABLE ownership_contract = TRY (ownershipContract__consume_operands(ownership_operands));
    MUTABLE setAt_stmt = ExprStmt{ expr: Emittable{ IndexedStore: COPY IndexedStore{ target: COPY target, index: COPY idx, value: COPY val, entry: entry, template_kind: COPY dispatch.template_kind, map_kind: COPY kind, ownership_contract: ownership_contract, allocs: KEEP dispatch.resolved_allocs, target_var: COPY mIRLowering__extract_root_var_name(rtoc_self_view, target_node), key_type: COPY dispatch.key_type, value_type: COPY dispatch.value_type } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    MUTABLE post_transfer_marks = consumed_names |> UNNEST {
    MUTABLE guarded = mIRLowering__pipeline_guarded_cleanup_name?(rtoc_self_view, _);
    TRY (mIRLowering__ownership_transfer_marks(rtoc_self_view, _, :owned_sink, dispatch.sink_alloc, guarded))
    };
    IF ((kind == :array) OR (kind == :list)) THEN
      MUTABLE elem_ti = UNWRAP (TRY (type__element_type(receiver_type)));
      IF mIRLowering__ownership_tracked_transfer_type?(rtoc_self_view, elem_ti) THEN
        MUTABLE elem_zig = TRY (type__zig_type(elem_ti));
        MUTABLE cleanup_call = TRY (mIRLowering__emit_builtin(rtoc_self_view, :cleanupAt, [Emittable{ Ident: COPY Ident{ name: elem_zig, lowered_node_id: NIL, ownership_consumption: NIL } }, target, Emittable{ AllocatorRef: COPY AllocatorRef{ kind: COPY dispatch.sink_alloc, lowered_node_id: NIL, ownership_consumption: NIL } }, idx]));
        RETURN Emittable{ ScopeBlock: COPY ScopeBlock{ body: COPY ([ExprStmt{ expr: castMIRLoweringReturnValueToEmittable(COPY cleanup_call), discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }, setAt_stmt] + post_transfer_marks), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
      END
    END
    IF post_transfer_marks |> ANY _ THEN
      RETURN Emittable{ ScopeBlock: COPY ScopeBlock{ body: COPY ([setAt_stmt] + post_transfer_marks), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
    RETURN Emittable{ ExprStmt: COPY setAt_stmt };
}
END
PRIVATE FN mIRLowering__indexed_assignment_dispatch(self: MIRLowering, kind: String@symbol, receiver_type: Type, target_node: Locatable, assignment: Assignment, op: FunctionSignature) RETURNS !IndexedAssignmentDispatch
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE target_var: ?String = mIRLowering__indexed_assignment_target_var(rtoc_self_view, target_node);
    MUTABLE shard: ?{String@symbol}String = TRY (mIRLowering__shard_context(rtoc_self_view));
    MUTABLE shard_direct = !(!(((((shard != NIL) AND (target_var == shard[:map])) AND (TRY (functionSignature__intrinsic_template(&op, IntrinsicTemplateKind.ShardDirectZig)) != NIL)))));
    MUTABLE template_kind =   IF shard_direct THEN
      IntrinsicTemplateKind.ShardDirectZig
    ELSE_IF (((type__sharded?(receiver_type) OR type__striped?(receiver_type))) AND (TRY (functionSignature__intrinsic_template(&op, IntrinsicTemplateKind.ShardedZig)) != NIL)) THEN
      IntrinsicTemplateKind.ShardedZig
    ELSE
      IntrinsicTemplateKind.Zig
    END;
    MUTABLE resolved_allocs = mIRLowering__indexed_assignment_allocs(rtoc_self_view, op, target_node, assignment);
    MUTABLE receiver_alloc = mIRLowering__placement_for_node(rtoc_self_view, target_node);
    RETURN IndexedAssignmentDispatch{ target_var: COPY target_var, shard_direct: shard_direct, template_kind: COPY template_kind, key_type: COPY ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_699: ?Type = NIL;
    IF (kind == :numeric_map) THEN
      rtoc_ternary_value_699 = TRY (type__key_type(receiver_type));
    ELSE
      rtoc_ternary_value_699 = NIL;
    END
    rtoc_ternary_value_699? }), value_type: COPY ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_700: ?Type = NIL;
    IF (kind == :numeric_map) THEN
      rtoc_ternary_value_700 = TRY (type__value_type(receiver_type));
    ELSE
      rtoc_ternary_value_700 = NIL;
    END
    rtoc_ternary_value_700? }), resolved_allocs: resolved_allocs, sink_alloc: COPY ((IF (IF inlineAllocMetadata__value_alloc(resolved_allocs) != NIL THEN inlineAllocMetadata__value_alloc(resolved_allocs) ELSE inlineAllocMetadata__primary(resolved_allocs) END) != NIL THEN (IF inlineAllocMetadata__value_alloc(resolved_allocs) != NIL THEN inlineAllocMetadata__value_alloc(resolved_allocs) ELSE inlineAllocMetadata__primary(resolved_allocs) END) ELSE inlineAllocMetadata__shard_alloc(resolved_allocs) END) OR_ELSE receiver_alloc) };
}
END
PRIVATE FN mIRLowering__indexed_assignment_target_var(self: MIRLowering, target_node: Locatable) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF target_node IS_A Identifier AS identifier THEN
      RETURN COPY identifier__name(identifier);
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN mIRLowering__indexed_assignment_allocs(self: MIRLowering, op: FunctionSignature, target_node: Locatable, assignment: Assignment) RETURNS InlineAllocMetadata@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN inlineAllocMetadata__new(mIRLowering__indexed_assignment_resolved_alloc(rtoc_self_view, op, IntrinsicAllocationKind.Alloc, target_node, assignment), mIRLowering__indexed_assignment_resolved_alloc(rtoc_self_view, op, IntrinsicAllocationKind.KeyAlloc, target_node, assignment), mIRLowering__indexed_assignment_resolved_alloc(rtoc_self_view, op, IntrinsicAllocationKind.ValAlloc, target_node, assignment), mIRLowering__indexed_assignment_resolved_alloc(rtoc_self_view, op, IntrinsicAllocationKind.ShardAlloc, target_node, assignment));
