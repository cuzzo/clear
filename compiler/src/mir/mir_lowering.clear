PRIVATE FN mIRLowering__lower_while_bind(MUTABLE self: MIRLowering, MUTABLE node: WhileBindLoop) RETURNS !WhileStmt ->
    MUTABLE rt = Ident{ name: mIRLowering__runtime_binding_name(&self), lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE cond, cond_pending = mIRLowering__lower_head(&self, %() USE(MUTABLE node, MUTABLE self) -> TRY (mIRLowering__lower_control_condition(self, &node.condition, TRUE)));
    MUTABLE body = TRY (mIRLowering__lower_body(&self, castLocatableListToMIRLoweringLowerableStmtList(node.do_branch)));
    MUTABLE capture_cleanup: ?CleanupEntry@multiowned = TRY (mIRLowering__bind_capture_cleanup(&self, node.condition));
    IF capture_cleanup EXISTS AS capture_cleanup_value THEN
      MUTABLE capture_name = COPY CAST(node.binding_name AS String);
