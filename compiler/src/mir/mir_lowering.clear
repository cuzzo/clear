PRIVATE FN mIRLowering__function_param_zig_type(self: MIRLowering, param: Param, type_info: Type, base_zig: String) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE type_sym = type__resolved(param.type);
    MUTABLE is_user_struct = (TRY (mIRLowering__struct_schemas(rtoc_self_view))).contains?(type_sym);
    MUTABLE polymorphic_generic_struct = (((param.mutable != NIL) AND type__generic_instance?(type_info)) AND (TRY (mIRLowering__struct_schemas(rtoc_self_view))).contains?(type__generic_base(type_info)));
    MUTABLE sym = param.symbol;
    MUTABLE atomic_sync =   IF sym THEN
      {
    MUTABLE rtoc_value_block_marker = 0;
    families = sym.sync_families();
    (sym.atomic?() OR (IF families THEN
      families.contains?(:ATOMIC)
    ELSE
      FALSE
    END))
    }
    ELSE
      FALSE
    END;
    IF (type__shared?(type_info) AND type__generic_type_parameter?(type_info)) THEN
      RETURN "CheatLib.Arc(${type__resolved(type_info)})";
    END
    IF (IF sym != NIL THEN
      { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_293 = CAST(sym AS SymbolEntry);
    symbolEntry__kept_identity(rtoc_local_receiver_293) }
    ELSE
      NIL
    END) THEN
      MUTABLE payload = IF type__optional?(type_info) THEN
        (((IF TRY (type__wrapped_type(type_info)) != NIL THEN
        type__resolved((TRY (type__wrapped_type(type_info))))
      ELSE
        NIL
      END) OR_ELSE type_sym))
      ELSE
        type_sym
      END;
      MUTABLE handle = "CheatLib.Rc(${payload})";
      IF type__optional?(type_info) THEN
        RETURN "?${handle}";
      ELSE
        RETURN handle;
      END
    END
    IF ((param.takes AND TRY (type__any_rc?(type_info))) AND type__collection?(type_info)) THEN
      RETURN "*const ${base_zig}";
    END
    IF ((((is_user_struct OR polymorphic_generic_struct) OR type__collection?(type_info)) OR type__canonical_stream?(type_info)) OR atomic_sync) THEN
      RETURN "anytype";
    END
    RETURN COPY base_zig;
}
END
PRIVATE FN mIRLowering__body_has_faulting_alloc?(self: MIRLowering, body: []Emittable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE found: Bool = FALSE;
    mIR__each_node(NodeRoot{ ArrayValue: COPY body }, %(mir: Emittable) USE(MUTABLE found, rtoc_self_view) -> {
    IF found THEN
        RETURN;
    END
    IF !((respondsTo?(mir, "expr?") AND mir.expr?())) THEN
        RETURN;
    END
    IF (mIRLowering__mir_allocates?(rtoc_self_view, mir) OR (((IF mir IS_A MIRMethodCall AS mir_method_call THEN (mir_method_call.method == "bind") ELSE FALSE END) AND mir.try_wrap()))) THEN
        found = TRUE;
    END
    rubyToClearVoid()
    });
    RETURN found;
}
END
