      mIRLowering__mark_ownership_finalized_nodes_mut(&self, CAST(facts AS []Emittable));
      TRY (mIRLowering__record_ownership_finalization_node_mut(&self, &state, castStmtToNodeRoot(marks[rtoc_idx]?)));
      TRY (mIRLowering__append_move_guard_for_transfer_mark_mut(&self, castStmtToEmittable(marks[rtoc_idx]?), &state));
