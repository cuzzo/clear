FN mIRLowering__walk_ast_calls(self: MIRLowering, node: ?Locatable, blk: FN(Locatable) -> Void) RETURNS Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((node != NIL)) THEN
      RETURN;
    END
    IF aST__call?(UNWRAP (node)) THEN
      blk(node);
    END
    aST__each_child_node(UNWRAP (node), %(child: Locatable) USE(blk, rtoc_self_view) -> {
    mIRLowering__walk_ast_calls(rtoc_self_view, child, blk);
    rubyToClearVoid()
    });
}
END
