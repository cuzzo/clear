    body_mir = TRY (mIRLowering__append_ownership_transfers_for_mir_body(rtoc_self_view, body_mir));
    MUTABLE hoisted_returns = mIRLowering__hoist_unhoisted_return_allocs(rtoc_self_view, body_mir, [Locatable{ ReturnNode: COPY lambda_return }]);
