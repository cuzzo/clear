    END, value: COPY return_expr, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
    MUTABLE previous_pointer_params = COPY mIRLowering__capture_state(rtoc_self_view).current_lambda_pointer_params;
    MUTABLE rtoc_writer_receiver_418: MIRLoweringCaptureState = mIRLowering__capture_state(rtoc_self_view);
    rtoc_writer_receiver_418.current_lambda_pointer_params = (params_list |> WHERE (_.mutable() == TRUE)) |> SELECT CAST(_.name() AS String) |> DISTINCT _;
    body_mir = ruby_array_concat_Any(body_mir, CAST({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_420 = mIRLowering__runtime_state(rtoc_self_view); mIRLoweringRuntimeState__with_rt_name(&rtoc_mutable_receiver_420, "_rt", %() USE(prefix_nodes, MUTABLE rtoc_self_view) -> { rtoc_lambda_result_419 = TRY (mIRLowering__lower_body(&rtoc_self_view, prefix_nodes)); rtoc_lambda_result_419 }) } AS []Any));
