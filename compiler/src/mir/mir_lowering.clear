PRIVATE FN mIRLowering__inline_union_deinit_statements(self: MIRLowering, entry: InlineStructDeinitEntry, self_ref: Expr, alloc_ref: Expr) RETURNS ![]Stmt
  REQUIRES self: LOCAL
