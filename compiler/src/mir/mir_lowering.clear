      END
      IF !((CAST((scoped[rtoc_idx]?.name()) AS String) == _)) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE rtoc_mutable_receiver_245 = (scoped[rtoc_idx]?.cleanup_entry());
      cleanupEntry__mark_moved_guard_mut(&rtoc_mutable_receiver_245);
      MUTABLE rtoc_index_receiver_246 = mIRLowering__function_state(rtoc_self_view).guarded_cleanup_names;
      rtoc_index_receiver_246[_] = TRUE;
      mIRLowering__function_state(rtoc_self_view).lowered_guarded_cleanup_names.insert(_);
    rtoc_idx = rtoc_idx + 1;
    END
    END
    MUTABLE transfer_marks = alloc_names.intersection(result_names) |> UNNEST TRY (mIR__ownership_transfer_marks(_, :block_result, alloc_by_name[_], mIRLowering__pipeline_guarded_cleanup_name?(rtoc_self_view, _)));
    MUTABLE block = MIRBlockExpr{ label: label, body: COPY ((scoped + transfer_marks) + [BreakStmt{ label: COPY label, value: COPY result, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }]), lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
    block.lazy_boundary = TRUE;
    IF (respondsTo?(result, "result_type") AND result.result_type()) THEN
      block.result_type = TRY (type__new(result.result_type()));
    END
    RETURN Emittable{ MIRBlockExpr: COPY block };
}
END
PUB FN mIRLowering__lower_head(self: MIRLowering, blk: FN() -> ?Emittable) RETURNS ?Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE prev = COPY mIRLowering__function_state(rtoc_self_view).pending_stmts;
    MUTABLE rtoc_writer_receiver_248: FunctionState = mIRLowering__function_state(rtoc_self_view);
    rtoc_writer_receiver_248.pending_stmts = ( { MUTABLE rtoc_empty_list_247: []Stmt = List[]; rtoc_empty_list_247 } );
    MUTABLE result = blk();
    MUTABLE produced = COPY mIRLowering__function_state(rtoc_self_view).pending_stmts;
    MUTABLE rtoc_writer_receiver_249: FunctionState = mIRLowering__function_state(rtoc_self_view);
    rtoc_writer_receiver_249.pending_stmts = prev;
    RETURN [result, produced];
}
END
PRIVATE FN mIRLowering__with_pending(self: MIRLowering, pending_value: []Emittable, node: Emittable) RETURNS Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (pending_value.length() == 0) THEN
      RETURN COPY node;
    ELSE
      RETURN Emittable{ ScopeBlock: COPY ScopeBlock{ body: COPY (pending_value + [node]), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
}
END
PRIVATE FN mIRLowering__descend(MUTABLE self: MIRLowering, parent: BinaryOp, field: String@symbol) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE child_branch_value: ?Locatable = NIL;
    PARTIAL MATCH field START
      :left ->
      child_branch_value = COPY parent.left;,
      :right ->
      child_branch_value = COPY parent.right;,
      DEFAULT ->
      panic("unknown BinaryOp field {}");
    END
    MUTABLE child: Locatable = child_branch_value?;
    IF (TRUE AND binaryOp__lazy_fields(parent).contains?(field)) THEN
      mIRLowering__lower_scoped(rtoc_self_view, %() USE(child, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_250 = TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(child)));
    rtoc_lambda_result_250
      });
    ELSE
      TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(child)));
    END
}
END
PRIVATE FN mIRLowering__hoist_lazy_alloc_result(self: MIRLowering, MUTABLE expr: Emittable, ast_node: Locatable) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(mIRLowering__mir_allocates?(rtoc_self_view, expr)) THEN
      RETURN COPY expr;
    END
    MUTABLE name = "__tmp_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_251 = mIRLowering__lowering_counters(rtoc_self_view);
    mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_251) }}";
    MUTABLE ti = TRY (mIRLowering__alloc_mark_type_info(rtoc_self_view, expr, ast_node, "lazy allocating expression"));
    MUTABLE alloc = (mIRLowering__mir_owned_alloc(rtoc_self_view, expr) OR_ELSE :heap);
    MUTABLE materialized = BindingMaterialization{ name: COPY name, expr: COPY expr, alloc: COPY alloc, type_info: CAST(COPY ti AS Type), mutable: FALSE, annotation: NIL, suppression: NIL, cleanup_entry: NIL, cleanup_mode: :normal, scope: NIL, ownership_tracked: TRUE };
    mIRLowering__function_state(rtoc_self_view).pending_stmts = ruby_array_concat_Stmt(mIRLowering__function_state(rtoc_self_view).pending_stmts, TRY (bindingMaterialization__statements(materialized)));
    mIRLowering__function_state(rtoc_self_view).lowered_alloc_names.insert(name);
    mIRLowering__stamp_allocating_result_target_mut(rtoc_self_view, &expr, name, alloc);
    RETURN Emittable{ Ident: COPY Ident{ name: name, lowered_node_id: NIL, ownership_consumption: NIL } };
}
END
PRIVATE FN mIRLowering__mir_produces_owned_result?(self: MIRLowering, node: ?Emittable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node EXISTS AS node_value THEN
      IF ownershipEffect__hoistable_owned_result?(node_value) THEN
        RETURN TRUE;
      END
      IF node_value IS_A Call AS call THEN
        RETURN mIRLowering__owned_call_result_requires_cleanup?(rtoc_self_view, call);
      END
      IF node_value IS_A MIRBgBlock AS mir_bg_block THEN
        RETURN TRUE;
      END
      RETURN FALSE;
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN mIRLowering__owned_call_result_requires_cleanup?(self: MIRLowering, call: Call) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(call__owned_return?(call)) THEN
      RETURN FALSE;
    END
    MUTABLE raw_type = (IF call.result_type != NIL THEN call.result_type ELSE { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_252 = call.callable_contract?.signature;
    functionSignature__return_type(rtoc_local_receiver_252) } END);
    IF !(raw_type) THEN
      RETURN TRUE;
    END
    MUTABLE ti = TRY (type__new(raw_type));
    ti = TRY (type__success_type(ti));
    RETURN (((((((((TRY (type__string?(ti)) OR type__collection?(ti)) OR TRY (type__collection_value?(ti))) OR TRY (type__recursive_cleanup_shape?(ti, mIRLowering__mir_schema_lookup(rtoc_self_view)))) OR TRY (type__needs_cleanup?(ti, mIRLowering__mir_schema_lookup(rtoc_self_view)))) OR TRY (type__heap_ptr?(ti))) OR type__indirect?(ti)) OR TRY (type__any_rc?(ti))) OR type__any_sync?(ti)) OR type__resource?(ti));
}
END
PRIVATE FN mIRLowering__mir_allocates?(self: MIRLowering, node: ?Emittable) RETURNS Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node EXISTS AS node_value THEN
      IF !(TRUE) THEN
        RETURN FALSE;
      END
      IF mIRLowering__mir_produces_owned_result?(rtoc_self_view, node_value) THEN
        RETURN TRUE;
      END
      IF !(respondsTo?(node_value, "child_exprs")) THEN
        RETURN FALSE;
      END
      RETURN node_value.child_exprs() |> ANY mIRLowering__mir_allocates?(rtoc_self_view, _);
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN mIRLowering__node_store_create_call?(self: MIRLowering, node: ?Emittable) RETURNS Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node EXISTS AS node_value THEN
      IF (IF node_value IS_A MIRMethodCall AS mir_method_call THEN (mir_method_call.method == "createBound") ELSE FALSE END) THEN
        RETURN TRUE;
      END
      IF !(respondsTo?(node_value, "child_exprs")) THEN
        RETURN FALSE;
      END
      RETURN node_value.child_exprs() |> ANY mIRLowering__node_store_create_call?(rtoc_self_view, _);
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN mIRLowering__hoist_evaluation_barrier(self: MIRLowering, expr: Emittable) RETURNS Ident
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE name = "__eval_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_253 = mIRLowering__lowering_counters(rtoc_self_view);
    mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_253) }}";
    mIRLowering__function_state(rtoc_self_view).pending_stmts.append(Stmt{ Emittable: COPY CAST(Let{ name: COPY name, init: COPY expr, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } AS Emittable) });
    RETURN Ident{ name: name, lowered_node_id: NIL, ownership_consumption: NIL };
}
END
PRIVATE FN mIRLowering__mutating_receiver_allocator_op?(self: MIRLowering, node: ?Emittable) RETURNS Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node? IS_A ShardedMapPut AS sharded_map_put THEN
      RETURN (shardedMapPut__mutating_receiver_allocator_op?(sharded_map_put) == TRUE);
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN mIRLowering__each_mir_expr_child(self: MIRLowering, node: Emittable, blk: FN(Emittable) -> Void) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(respondsTo?(node.class(), "members")) THEN
      IF mIRLowering__replaceable_t_struct?(rtoc_self_view, node) THEN
        FOR rtoc_each_val IN node.child_exprs() DO
    blk(rtoc_each_val);
        END
      END
      RETURN;
    END
    FOR _ IN node.class().members() DO
    MUTABLE value = node[_];
    mIRLowering__each_mir_expr_in_value(rtoc_self_view, value, blk);
    END
    NIL;
}
END
PRIVATE FN mIRLowering__each_mir_expr_in_value<T>(self: MIRLowering, value: T, blk: FN(Emittable) -> Void) RETURNS Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF mIRLowering__mir_expr_child?(rtoc_self_view, value) THEN
      blk(value);
    ELSE_IF T IS_A []@multiowned Any THEN
      FOR _ IN value DO
      mIRLowering__each_mir_expr_in_value(rtoc_self_view, _, blk);
      END
    ELSE_IF T IS_A {}Any THEN
      FOR _ IN value.values() DO
      mIRLowering__each_mir_expr_in_value(rtoc_self_view, _, blk);
      END
    END
    NIL;
}
END
PRIVATE FN mIRLowering__mir_expr_child?(self: MIRLowering, value: ?Emittable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF value EXISTS AS value_expr THEN
      RETURN emittable__expr?(value_expr);
    END
    RETURN FALSE;
}
END
PRIVATE FN mIRLowering__hoist_alloc(self: MIRLowering, MUTABLE expr: Emittable, MUTABLE ast_node: ?Locatable = NIL, err_cleanup: ?Bool = FALSE, mutable_value: Bool = FALSE, transfer_on_success: Bool = TRUE, ownership_materialization_alloc: ?String@symbol = NIL) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (IF expr IS_A MIRBlockExpr AS mir_block_expr THEN (blockExpr__lazy_boundary(&mir_block_expr) != NIL) ELSE FALSE END) THEN
      RETURN COPY expr;
    END
    MUTABLE composite_materialization: ?OwnedCompositeMaterialization = mIRLowering__owned_composite_transfer_materialization(rtoc_self_view, expr, ast_node, ownership_materialization_alloc);
    IF (respondsTo?(expr, "expr?") AND expr.expr?()) THEN
      mIRLowering__function_state(rtoc_self_view).pending_stmts = ruby_array_concat_Stmt(mIRLowering__function_state(rtoc_self_view).pending_stmts, CAST(mIRLowering__normalize_allocating_result_expr_mut(rtoc_self_view, expr, (err_cleanup == TRUE), ownershipEffect__of(expr).produces_owned) AS []Stmt));
    END
    MUTABLE union_return_needs_hoist = ((ast_node != NIL) AND mIRLowering__call_union_return_needs_hoist?(rtoc_self_view, expr, &ast_node));
    IF !(((mIRLowering__mir_produces_owned_result?(rtoc_self_view, expr) OR union_return_needs_hoist) OR composite_materialization)) THEN
      RETURN COPY expr;
    END
    MUTABLE plan = mIRLowering__allocating_hoist_plan(rtoc_self_view, expr, mutable_value, (err_cleanup == TRUE), (composite_materialization?.type_info OR_ELSE TRY (mIRLowering__alloc_mark_type_info(rtoc_self_view, expr, UNWRAP (ast_node), "MIR allocating hoist"))), (IF (IF composite_materialization != NIL THEN
      ownedCompositeMaterialization__cleanup_entry(composite_materialization)
    ELSE
      NIL
    END) != NIL THEN (IF composite_materialization != NIL THEN
      ownedCompositeMaterialization__cleanup_entry(composite_materialization)
    ELSE
      NIL
    END) ELSE mIRLowering__hoist_cleanup_entry(rtoc_self_view, expr, ast_node) END), ruby_wrap_optional_string_to_symbol(composite_materialization?.alloc));
    mIRLowering__stamp_allocating_result_target_mut(rtoc_self_view, &expr, plan.name, plan.alloc);
    mIRLowering__function_state(rtoc_self_view).pending_stmts = ruby_array_concat_Stmt(mIRLowering__function_state(rtoc_self_view).pending_stmts, TRY (bindingMaterialization__statements(plan)));
    mIRLowering__record_hoisted_allocation_mut(rtoc_self_view, plan);
    RETURN Emittable{ Ident: COPY Ident{ name: COPY plan.name, lowered_node_id: NIL, ownership_consumption: NIL } };
}
END
PRIVATE FN mIRLowering__owned_composite_transfer_materialization(self: MIRLowering, expr: Emittable, ast_node: ?Locatable, sink_alloc: ?String@symbol) RETURNS !?OwnedCompositeMaterialization
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF sink_alloc EXISTS AS sink_alloc_value THEN
      IF ast_node THEN
        IF !(((expr IS_A StructInit OR expr IS_A ArrayInit) OR expr IS_A TupleLiteral)) THEN
          RETURN NIL;
        END
        MUTABLE type_info = TRY (type__from_node_mut(ast_node, "owned composite argument materialization"));
        type_info = TRY (type__success_type(type_info));
        MUTABLE lifecycle_plan = COPY UNWRAP (mIRLowering__lifecycle_registry(rtoc_self_view)[type_info]);
        IF !(lifecyclePlan__needs_drop?(lifecycle_plan)) THEN
          RETURN NIL;
        END
        RETURN OwnedCompositeMaterialization{ type_info: COPY type_info, lifecycle_plan: COPY lifecycle_plan, alloc: COPY mIRLowering__composite_materialization_alloc(rtoc_self_view, type_info, sink_alloc_value) };
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN mIRLowering__composite_materialization_alloc(self: MIRLowering, type_info: Type, sink_alloc: String@symbol) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE inherited: ?CleanupEntry@multiowned = TRY (cleanupClassifier__owned_value_entry(type_info, mIRLowering__mir_schema_lookup(rtoc_self_view)));
    IF inherited EXISTS AS inherited_value THEN
      IF inherited_value[:fixed_alloc] THEN
        RETURN cleanupEntry__alloc(inherited_value);
      ELSE
        RETURN sink_alloc;
      END
    ELSE
      RETURN sink_alloc;
    END
}
END
PRIVATE FN mIRLowering__mir_alloc_mark_type_info(self: MIRLowering, mir: Emittable, ast_node: ?Locatable = NIL, context: String = "MIR allocation") RETURNS !Type
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF ast_node EXISTS AS ast_node_value THEN
      RETURN CAST(TRY (mIRLowering__alloc_mark_type_info(rtoc_self_view, mir, ast_node_value, context)) AS Type);
    END
    MUTABLE explicit_type: ?Type@multiowned = mIRLowering__mir_explicit_result_type(rtoc_self_view, mir);
    IF explicit_type EXISTS AS explicit_type_value THEN
      RETURN CAST(explicit_type_value AS Type);
    END
    MUTABLE alloc = (mIRLowering__mir_owned_alloc(rtoc_self_view, mir) OR_ELSE :heap);
    IF mir IS_A DupeSlice AS dupe_slice THEN
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :String }, NIL, NIL, NIL, alloc));
    ELSE_IF mir IS_A ConcatStr AS concat_str THEN
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :String }, NIL, NIL, NIL, alloc));
    ELSE_IF mir IS_A AllocSlice AS alloc_slice THEN
      RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY "${alloc_slice.elem_type}[]" }, NIL, NIL, NIL, alloc));
    ELSE_IF mir IS_A OwnedSlice AS owned_slice THEN
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :Slice }, NIL, NIL, NIL, alloc));
    ELSE_IF mir IS_A MakeList AS make_list THEN
      RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY "${make_list.elem_type}[]" }, NIL, NIL, NIL, alloc, :list));
    ELSE_IF mir IS_A HeapCreate AS heap_create THEN
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: COPY type__to_sym(heap_create.zig_type.deletePrefix("*")) }, NIL, NIL, :indirect));
    ELSE_IF mir IS_A ContainerInit AS container_init THEN
      RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY container_init.zig_type }, NIL, NIL, NIL, alloc));
    ELSE_IF mir IS_A StructInit AS struct_init THEN
      IF !(struct_init.zig_type) THEN
        panic("{}: allocating anonymous MIR::StructInit has no result type");
      END
      RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY CAST(struct_init.zig_type AS String) }, NIL, NIL, NIL, alloc));
    ELSE_IF mir IS_A DeepCopy AS deep_copy THEN
      IF deep_copy.type_info THEN
        RETURN TRY (type__new(TypeConstructionInput{ Type: COPY UNWRAP (deep_copy.type_info) }, NIL, NIL, NIL, alloc));
      ELSE
        RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY mIRLowering__deep_copy_zig_type(rtoc_self_view, deep_copy, NIL) }, NIL, NIL, NIL, alloc));
      END
    ELSE_IF mir IS_A CapWrap AS cap_wrap THEN
      MUTABLE wrapped = (cap_wrap.sync_type OR_ELSE cap_wrap.zig_base);
      MUTABLE ownership = PARTIAL MATCH cap_wrap.own_fn START
        "rcCreate" -> :multiowned,
        "arcCreate" -> :shared,
        DEFAULT -> NIL
      END;
      RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY wrapped }, ownership, NIL, IF (IF cap_wrap.sync_fn != NIL THEN cap_wrap.sync_fn ELSE cap_wrap.own_fn END) THEN
        :indirect
      ELSE
        NIL
      END, alloc));
    ELSE_IF mir IS_A SharePromote AS share_promote THEN
      RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY share_promote.zig_base }, :shared, NIL, NIL, :heap));
    ELSE_IF mir IS_A WeakUpgrade AS weak_upgrade THEN
      RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY CAST(weak_upgrade.zig_base AS String) }, :shared, NIL, NIL, :heap));
    ELSE_IF mir IS_A RcRetain AS rc_retain THEN
      RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY CAST(rc_retain.zig_base AS String) }, :multiowned, NIL, NIL, :heap));
    ELSE_IF mir IS_A RcDowngrade AS rc_downgrade THEN
      RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY CAST(rc_downgrade.zig_base AS String) }, :multiowned, NIL, NIL, :heap));
    ELSE_IF mir IS_A FreezeExpr AS freeze_expr THEN
      RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY freeze_expr.zig_base }, :multiowned, NIL, NIL, :heap));
    ELSE_IF mir IS_A MonomorphicKeep AS monomorphic_keep THEN
      RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY CAST(monomorphic_keep.zig_base AS String) }, :multiowned, NIL, NIL, :heap));
    ELSE_IF mir IS_A MIRCast AS mir_cast THEN
      RETURN CAST(mIRLowering__mir_alloc_mark_type_info(rtoc_self_view, cast__expr(mir_cast), NIL, context) AS Type);
    ELSE_IF mir IS_A TryExpr AS try_expr THEN
      RETURN CAST(mIRLowering__mir_alloc_mark_type_info(rtoc_self_view, tryExpr__expr(try_expr), NIL, context) AS Type);
    ELSE_IF mir IS_A TryOptional AS try_optional THEN
      RETURN CAST(mIRLowering__mir_alloc_mark_type_info(rtoc_self_view, tryOptional__expr(try_optional), NIL, context) AS Type);
    ELSE_IF mir IS_A MIROptionalUnwrap AS mir_optional_unwrap THEN
      RETURN CAST(mIRLowering__mir_alloc_mark_type_info(rtoc_self_view, optionalUnwrap__expr(mir_optional_unwrap), NIL, context) AS Type);
    ELSE_IF mir IS_A Call AS call THEN
      panic("{}: allocating {} has no callable return type");
    ELSE_IF mir IS_A MIRMethodCall AS mir_method_call THEN
      panic("{}: allocating {} has no callable return type");
    ELSE_IF mir IS_A TailCall AS tail_call THEN
      panic("{}: allocating {} has no callable return type");
    ELSE_IF mir IS_A InlineBc AS inline_bc THEN
      panic("{}: allocating {} has no typed stdlib return");
    ELSE_IF mir IS_A MIRBgBlock AS mir_bg_block THEN
      panic("{}: allocating MIR::BgBlock has no result type");
    ELSE_IF mir IS_A Pipeline AS pipeline THEN
      IF pipeline.ast_node THEN
        RETURN TRY (type__from_node_mut(pipeline.ast_node, context));
      ELSE_IF (pipeline.inner AND mIRLowering__mir_allocates?(rtoc_self_view, pipeline.inner)) THEN
        RETURN CAST(mIRLowering__mir_alloc_mark_type_info(rtoc_self_view, pipeline.inner, NIL, context) AS Type);
      ELSE
        panic("{}: allocating MIR::Pipeline has no typed result");
      END
    ELSE_IF mir IS_A TryCatch AS try_catch THEN
      panic("{}: allocating MIR::TryCatch has no result type");
    ELSE_IF mir IS_A MIRBlockExpr AS mir_block_expr THEN
      MUTABLE inferred: ?Type@multiowned = mIRLowering__block_expr_result_type(rtoc_self_view, mir_block_expr);
      IF inferred EXISTS AS inferred_value THEN
        RETURN CAST(inferred_value AS Type);
      END
      MUTABLE effect = ownershipEffect__of(Emittable{ MIRBlockExpr: COPY mir_block_expr });
      IF (effect.cleanup_kind == :heap_string) THEN
        RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :String }, NIL, NIL, NIL, (effect.alloc OR_ELSE alloc)));
      END
      panic("{}: allocating MIR::BlockExpr has no result type");
    ELSE_IF mir IS_A Orelse AS orelse THEN
      panic("{}: allocating {} has no typed allocation result");
    ELSE_IF mir IS_A IfOptional AS if_optional THEN
      panic("{}: allocating {} has no typed allocation result");
    ELSE
      panic("{}: unhandled allocating MIR node {}");
    END
}
END
PRIVATE FN mIRLowering__mir_explicit_result_type(self: MIRLowering, mir: Emittable) RETURNS !?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE raw_type =   IF (respondsTo?(mir, "result_type") AND mir.result_type()) THEN
      mir.result_type()
    ELSE_IF (respondsTo?(mir, "return_type") AND mir.return_type()) THEN
      mir.return_type()
    ELSE_IF respondsTo?(mir, "callable_contract") THEN
      (IF mir.callable_contract() != NIL THEN
      { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_256 = (mir.callable_contract()).signature();
    functionSignature__return_type(rtoc_local_receiver_256) }
    ELSE
      NIL
    END)
    ELSE_IF (mir IS_A RegistryCall OR mir IS_A InlineBc) THEN
      (IF functionSignature__unwrap(mir.stdlib_def()) != NIL THEN
      { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_257 = (functionSignature__unwrap(mir.stdlib_def()));
    functionSignature__return_type(rtoc_local_receiver_257) }
    ELSE
      NIL
    END)
    ELSE_IF (IF mir IS_A Pipeline AS pipeline THEN pipeline.ast_node ELSE FALSE END) THEN
      TRY (type__from_node_mut(mir.ast_node(), "pipeline cleanup result"))
    ELSE
      NIL
    END;
    IF raw_type THEN
      RETURN TRY (type__new(raw_type));
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN mIRLowering__block_expr_result_type(self: MIRLowering, mir: MIRBlockExpr) RETURNS !?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE marks: []AllocMark = ( { MUTABLE rtoc_empty_list_258: []AllocMark = List[]; rtoc_empty_list_258 } );
    MUTABLE body = COPY mir.body;
    FOR _ IN body DO
    IF _ IS_A AllocMark THEN
      &marks.append(_);
    END
    END
    MUTABLE break_stmt = body.reverse().grep(MIR.BreakStmt).first();
    MUTABLE value = (IF break_stmt != NIL THEN
      break_stmt.value()
    ELSE
      NIL
    END);
    IF (value IS_A StructInit) THEN
      RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY CAST((TRY (type__zig_type(value))) AS String) }));
    ELSE_IF (value IS_A Ident) THEN
      MUTABLE let = body.grep(MIR.Let) |> FIND (CAST(_.name() AS String) == CAST(value.name() AS String));
      MUTABLE init = (IF let != NIL THEN
        let.init()
      ELSE
        NIL
      END);
      IF init IS_A StructInit THEN
        RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY CAST((TRY (type__zig_type(init))) AS String) }));
      END
      IF init IS_A ContainerInit THEN
        RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY CAST((TRY (type__zig_type(init))) AS String) }));
      END
      MUTABLE mark: ?AllocMark = marks |> FIND (_.name == CAST(value.name() AS String));
      IF mark EXISTS AS mark_value THEN
        RETURN TRY (type__new(TypeConstructionInput{ Type: COPY mark_value.type_info }));
      END
    END
    MUTABLE typed_marks = marks |> SELECT TRY (type__new(TypeConstructionInput{ Type: COPY _.type_info }));
    IF (typed_marks.length() == 1) THEN
      RETURN COPY typed_marks.first();
    END
    RETURN NIL;
}
END
PRIVATE FN mIRLowering__hoist_normalized_alloc_expr(self: MIRLowering, MUTABLE expr: Emittable, transfer_on_success: Bool = FALSE, type_info: ?Type = NIL, cleanup_entry: ?CleanupEntry = NIL) RETURNS !Tuple<[]Emittable, Ident>
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE plan = mIRLowering__allocating_hoist_plan(rtoc_self_view, expr, FALSE, transfer_on_success, (type_info OR_ELSE mIRLowering__mir_alloc_mark_type_info(rtoc_self_view, expr, NIL, "normalized MIR allocation")), (IF cleanup_entry != NIL THEN cleanup_entry ELSE mIRLowering__hoist_cleanup_entry(rtoc_self_view, expr, NIL) END));
    mIRLowering__stamp_allocating_result_target_mut(rtoc_self_view, &expr, plan.name, plan.alloc);
    mIRLowering__record_hoisted_allocation_mut(rtoc_self_view, plan);
    RETURN CAST(Tuple{TRY (bindingMaterialization__statements(plan)), Ident{ name: COPY plan.name, lowered_node_id: NIL, ownership_consumption: NIL }} AS Tuple<[]Emittable, Ident>);
}
END
PRIVATE FN mIRLowering__allocating_hoist_plan(self: MIRLowering, expr: Emittable, mutable_value: Bool, transfer_on_success: Bool, type_info: Type, cleanup_entry: ?CleanupEntry, alloc: ?String@symbol = NIL) RETURNS BindingMaterialization
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE tmp_id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_259 = mIRLowering__lowering_counters(rtoc_self_view);
    mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_259) };
    MUTABLE entry: ?CleanupEntry@multiowned = cleanup_entry;
    IF entry EXISTS AS entry_value THEN
      MUTABLE entry_value_mutable = COPY entry_value;
      IF transfer_on_success THEN
        cleanupEntry__mark_moved_guard_mut(&entry_value_mutable);
      ELSE
        cleanupEntry__clear_moved_guard_mut(&entry_value_mutable);
      END
    END
    RETURN BindingMaterialization{ name: "__tmp_${tmp_id}", expr: COPY expr, alloc: COPY ((IF alloc != NIL THEN alloc ELSE mIRLowering__mir_owned_alloc(rtoc_self_view, expr) END) OR_ELSE :heap), type_info: COPY type_info, mutable: COPY mutable_value, cleanup_entry: entry, cleanup_mode: IF transfer_on_success THEN
      :err
    ELSE
      :normal
    END, annotation: NIL, suppression: NIL, scope: NIL, ownership_tracked: TRUE };
}
END
PRIVATE FN mIRLowering__record_hoisted_allocation_mut(self: MIRLowering, plan: BindingMaterialization) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    mIRLowering__function_state(rtoc_self_view).lowered_alloc_names.insert(COPY plan.name);
    MUTABLE entry: ?CleanupEntry@multiowned = COPY KEEP plan.cleanup_entry;
    IF !((IF entry != NIL THEN
      cleanupEntry__has_moved_guard?(entry)
    ELSE
      NIL
    END)) THEN
      RETURN;
    END
    MUTABLE rtoc_index_receiver_260 = mIRLowering__function_state(rtoc_self_view).guarded_cleanup_names;
    rtoc_index_receiver_260[plan.name] = TRUE;
    mIRLowering__function_state(rtoc_self_view).lowered_guarded_cleanup_names.insert(COPY plan.name);
}
END
PRIVATE FN mIRLowering__hoist_normalized_value_expr(self: MIRLowering, expr: Emittable) RETURNS Tuple<[]Emittable, Ident>
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE name = "__tmp_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_261 = mIRLowering__lowering_counters(rtoc_self_view);
    mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_261) }}";
    RETURN CAST(Tuple{[Let{ name: COPY name, init: COPY expr, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }], Ident{ name: name, lowered_node_id: NIL, ownership_consumption: NIL }} AS Tuple<[]Emittable, Ident>);
}
END
PRIVATE FN mIRLowering__consumes_owned_children?(self: MIRLowering, node: Emittable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN node.ownership_consumption() IS_A OwnershipConsumptionFact;
}
END
PRIVATE FN mIRLowering__normalize_allocating_mir_body(self: MIRLowering, body: []Emittable) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE out: []Emittable = ( { MUTABLE rtoc_empty_list_262: []Emittable = List[]; rtoc_empty_list_262 } );
    FOR _ IN body DO
    MUTABLE rtoc_mutable_block_param_263 = COPY _;
    MUTABLE prefix = mIRLowering__normalize_allocating_mir_stmt_mut(rtoc_self_view, &rtoc_mutable_block_param_263);
    ruby_array_concat_Emittable(out, prefix);
    &out.append(COPY rtoc_mutable_block_param_263);
    END
    RETURN out;
}
END
PRIVATE FN mIRLowering__normalize_allocating_mir_stmt_mut(self: MIRLowering, MUTABLE stmt: Emittable) RETURNS ![]Emittable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE prefix: []Emittable = ( { MUTABLE rtoc_empty_list_264: []Emittable = List[]; rtoc_empty_list_264 } );
    IF stmt IS_A Let AS let THEN
      prefix = ruby_array_concat_Emittable(prefix, mIRLowering__normalize_allocating_result_expr_mut(rtoc_self_view, let.init, FALSE, TRUE));
    ELSE_IF stmt IS_A Set AS set THEN
      prefix = ruby_array_concat_Emittable(prefix, mIRLowering__normalize_used_expr_attr_mut(rtoc_self_view, Emittable{ Set: COPY set }, :target));
      prefix = ruby_array_concat_Emittable(prefix, mIRLowering__normalize_allocating_result_expr_mut(rtoc_self_view, set.value));
    ELSE_IF stmt IS_A ReassignWithCleanup AS reassign_with_cleanup THEN
      IF !(mIRLowering__fallible_self_fallback_reassign?(rtoc_self_view, CAST(reassign_with_cleanup.name AS String), reassign_with_cleanup.value)) THEN
        prefix = ruby_array_concat_Emittable(prefix, mIRLowering__normalize_used_expr_attr_mut(rtoc_self_view, Emittable{ ReassignWithCleanup: COPY reassign_with_cleanup }, :value));
      END
    ELSE_IF stmt IS_A ExprStmt AS expr_stmt THEN
      IF mIRLowering__mir_produces_owned_result?(rtoc_self_view, exprStmt__expr(expr_stmt)) THEN
        prefix = ruby_array_concat_Emittable(prefix, mIRLowering__normalize_used_expr_attr_mut(rtoc_self_view, Emittable{ ExprStmt: COPY expr_stmt }, :expr));
      ELSE
        prefix = ruby_array_concat_Emittable(prefix, mIRLowering__normalize_allocating_result_expr_mut(rtoc_self_view, exprStmt__expr(expr_stmt)));
      END
    ELSE_IF stmt IS_A ReturnStmt AS return_stmt THEN
      prefix = ruby_array_concat_Emittable(prefix, mIRLowering__normalize_used_expr_attr_mut(rtoc_self_view, Emittable{ ReturnStmt: COPY return_stmt }, :value, TRUE));
    ELSE_IF stmt IS_A BreakStmt AS break_stmt THEN
      prefix = ruby_array_concat_Emittable(prefix, mIRLowering__normalize_used_expr_attr_mut(rtoc_self_view, Emittable{ BreakStmt: COPY break_stmt }, :value, TRUE));
    ELSE_IF stmt IS_A IfStmt AS if_stmt THEN
      prefix = ruby_array_concat_Emittable(prefix, mIRLowering__normalize_used_expr_attr_mut(rtoc_self_view, Emittable{ IfStmt: COPY if_stmt }, :cond));
    ELSE_IF stmt IS_A IfBindStmt AS if_bind_stmt THEN
      MUTABLE if_bind_stmt_mutable = COPY if_bind_stmt;
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < if_bind_stmt_mutable.bindings.length() DO
      MUTABLE expr = if_bind_stmt_mutable.bindings[rtoc_idx][:expr];
      MUTABLE capture = COPY CAST(if_bind_stmt_mutable.bindings[rtoc_idx][:capture] AS String);
      MUTABLE capture_cleanup: ?ResourceClose = if_bind_stmt_mutable.then_body |> FIND (_ IS_A Cleanup AND (CAST(_.name() AS String) == capture));
      MUTABLE expr_prefix, normalized = mIRLowering__normalize_allocating_used_expr(rtoc_self_view, expr, ((capture_cleanup != NIL) AND (capture_cleanup IS_A Cleanup)));
      MUTABLE rtoc_index_receiver_265 = if_bind_stmt_mutable.bindings[rtoc_idx];
      rtoc_index_receiver_265[:expr] = COPY normalized;
      ruby_array_concat_Emittable(prefix, expr_prefix);
      IF !(normalized IS_A Ident) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !(((capture_cleanup != NIL) AND (capture_cleanup IS_A Cleanup))) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF mIRLowering__if_bind_transfer_present?(rtoc_self_view, if_bind_stmt_mutable, CAST(normalized.name() AS String)) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE target_alloc = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_266 = ownedCompositeMaterialization__cleanup_entry(capture_cleanup);
      cleanupEntry__alloc(rtoc_local_receiver_266) };
      MUTABLE then_marks = TRY (mIR__ownership_transfer_marks(CAST(normalized.name() AS String), :owned_sink, target_alloc, TRUE));
      if_bind_stmt_mutable.then_body = (then_marks + if_bind_stmt_mutable.then_body);
      if_bind_stmt_mutable.else_body = (if_bind_stmt_mutable.else_body OR_ELSE List[]);
      MUTABLE else_marks = TRY (mIR__ownership_transfer_marks(CAST(normalized.name() AS String), :owned_sink, target_alloc, TRUE));
      if_bind_stmt_mutable.else_body = (else_marks + if_bind_stmt_mutable.else_body);
    rtoc_idx = rtoc_idx + 1;
      END
    ELSE_IF stmt IS_A WhileStmt AS while_stmt THEN
      MUTABLE while_stmt_mutable = COPY while_stmt;
      IF !(while_stmt_mutable.capture) THEN
        prefix = ruby_array_concat_Emittable(prefix, mIRLowering__normalize_used_expr_attr_mut(rtoc_self_view, Emittable{ WhileStmt: COPY while_stmt_mutable }, :cond));
      END
      IF while_stmt_mutable.update THEN
        prefix = ruby_array_concat_Emittable(prefix, mIRLowering__normalize_used_expr_attr_mut(rtoc_self_view, Emittable{ WhileStmt: COPY while_stmt_mutable }, :update));
      END
    ELSE_IF stmt IS_A ForStmt AS for_stmt THEN
      prefix = ruby_array_concat_Emittable(prefix, mIRLowering__normalize_used_expr_attr_mut(rtoc_self_view, Emittable{ ForStmt: COPY for_stmt }, :iter));
    ELSE_IF stmt IS_A SwitchStmt AS switch_stmt THEN
      prefix = ruby_array_concat_Emittable(prefix, mIRLowering__normalize_used_expr_attr_mut(rtoc_self_view, Emittable{ SwitchStmt: COPY switch_stmt }, :subject));
    ELSE_IF stmt IS_A UnionMatchStmt AS union_match_stmt THEN
      prefix = ruby_array_concat_Emittable(prefix, mIRLowering__normalize_used_expr_attr_mut(rtoc_self_view, Emittable{ UnionMatchStmt: COPY union_match_stmt }, :subject));
    ELSE_IF stmt IS_A IfChain AS if_chain THEN
      IF if_chain.branches != NIL THEN
            FOR _ IN if_chain.branches DO
          MUTABLE cond = _.cond();
          MUTABLE cond_prefix, normalized = mIRLowering__normalize_allocating_used_expr(rtoc_self_view, cond);
          _.cond = COPY normalized;
          ruby_array_concat_Emittable(prefix, cond_prefix);
            END
      END
    ELSE_IF stmt IS_A MIRDeferStmt AS mir_defer_stmt THEN
      MUTABLE mir_defer_stmt_mutable = COPY mir_defer_stmt;
      MUTABLE defer_body = deferStmt__body(mir_defer_stmt_mutable);
      IF defer_body IS_A []Emittable AS array THEN
        mir_defer_stmt_mutable.body = DeferBody{ ArrayValue: COPY mIRLowering__normalize_allocating_mir_body(rtoc_self_view, array) };
      ELSE
        prefix = ruby_array_concat_Emittable(prefix, mIRLowering__normalize_allocating_mir_stmt_mut(rtoc_self_view, &defer_body));
      END
    ELSE_IF stmt IS_A ErrDeferStmt AS err_defer_stmt THEN
      MUTABLE err_defer_stmt_mutable = COPY err_defer_stmt;
      MUTABLE defer_body = errDeferStmt__body(err_defer_stmt_mutable);
      IF defer_body IS_A []Emittable AS array THEN
        err_defer_stmt_mutable.body = DeferBody{ ArrayValue: COPY mIRLowering__normalize_allocating_mir_body(rtoc_self_view, array) };
      ELSE
        prefix = ruby_array_concat_Emittable(prefix, mIRLowering__normalize_allocating_mir_stmt_mut(rtoc_self_view, &defer_body));
      END
    ELSE_IF stmt IS_A BatchWindowPush AS batch_window_push THEN
      prefix = ruby_array_concat_Emittable(prefix, mIRLowering__normalize_used_expr_attr_mut(rtoc_self_view, Emittable{ BatchWindowPush: COPY batch_window_push }, :item_expr));
      prefix = ruby_array_concat_Emittable(prefix, mIRLowering__normalize_used_expr_attr_mut(rtoc_self_view, Emittable{ BatchWindowPush: COPY batch_window_push }, :value_expr));
    ELSE_IF stmt IS_A BatchWindowFlush AS batch_window_flush THEN
      prefix = ruby_array_concat_Emittable(prefix, mIRLowering__normalize_used_expr_attr_mut(rtoc_self_view, Emittable{ BatchWindowFlush: COPY batch_window_flush }, :value_expr));
    ELSE
      prefix = ruby_array_concat_Emittable(prefix, mIRLowering__normalize_stmt_child_exprs_mut(rtoc_self_view, stmt));
    END
    RETURN prefix;
}
END
PRIVATE FN mIRLowering__normalize_stmt_child_exprs_mut(self: MIRLowering, stmt: Emittable) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE prefix: []Emittable = ( { MUTABLE rtoc_empty_list_267: []Emittable = List[]; rtoc_empty_list_267 } );
    IF !(respondsTo?(stmt, "child_exprs")) THEN
      RETURN prefix;
    END
    MUTABLE rtoc_each_items_268 = stmt.child_exprs();
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_268.length() DO
      IF !(rtoc_each_items_268[rtoc_idx]) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE child_prefix, normalized = mIRLowering__normalize_allocating_used_expr(rtoc_self_view, rtoc_each_items_268[rtoc_idx]);
      mIRLowering__replace_mir_expr_child_mut(rtoc_self_view, stmt, rtoc_each_items_268[rtoc_idx], normalized);
      ruby_array_concat_Emittable(prefix, child_prefix);
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN prefix;
}
END
PRIVATE FN mIRLowering__normalize_used_expr_attr_mut(self: MIRLowering, MUTABLE stmt: Emittable, attr: String@symbol, transfer_on_success: Bool = FALSE) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE value: ?Emittable = mIRLowering__normalized_expr_attr(rtoc_self_view, stmt, attr);
    IF value EXISTS AS value_value THEN
      MUTABLE prefix, normalized = mIRLowering__normalize_allocating_used_expr(rtoc_self_view, value_value, transfer_on_success);
      mIRLowering__set_normalized_expr_attr_mut(rtoc_self_view, &stmt, attr, normalized);
      RETURN COPY prefix;
    ELSE
      RETURN CAST(( { MUTABLE rtoc_empty_list_269: []Emittable = List[]; rtoc_empty_list_269 } ) AS []Emittable);
    END
}
END
PRIVATE FN mIRLowering__normalized_expr_attr(self: MIRLowering, stmt: Emittable, attr: String@symbol) RETURNS ?Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (attr == :target) THEN
      RETURN COPY castEmittableToSet(stmt).target;
    ELSE_IF (attr == :value) THEN
      IF stmt IS_A ReassignWithCleanup AS reassign_with_cleanup THEN
        RETURN COPY reassign_with_cleanup.value;
      ELSE_IF stmt IS_A ReturnStmt AS return_stmt THEN
        RETURN COPY return_stmt.value;
      ELSE_IF stmt IS_A BreakStmt AS break_stmt THEN
        RETURN COPY break_stmt.value;
      ELSE
        RETURN NIL;
      END
    ELSE_IF (attr == :expr) THEN
      RETURN COPY castEmittableToExprStmt(stmt).expr;
    ELSE_IF (attr == :cond) THEN
      IF stmt IS_A IfStmt AS if_stmt THEN
        RETURN COPY if_stmt.cond;
      ELSE
        RETURN COPY castEmittableToWhileStmt(stmt).cond;
      END
    ELSE_IF (attr == :update) THEN
      RETURN COPY castEmittableToWhileStmt(stmt).update;
    ELSE_IF (attr == :iter) THEN
      RETURN COPY castEmittableToForStmt(stmt).iter;
    ELSE_IF (attr == :subject) THEN
      IF stmt IS_A SwitchStmt AS switch_stmt THEN
        RETURN COPY switch_stmt.subject;
      ELSE
        RETURN COPY castEmittableToUnionMatchStmt(stmt).subject;
      END
    ELSE_IF (attr == :item_expr) THEN
      RETURN COPY castEmittableToBatchWindowPush(stmt).item_expr;
    ELSE_IF (attr == :value_expr) THEN
      IF stmt IS_A BatchWindowPush AS batch_window_push THEN
        RETURN COPY batch_window_push.value_expr;
      ELSE
        RETURN COPY castEmittableToBatchWindowFlush(stmt).value_expr;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN mIRLowering__set_normalized_expr_attr_mut(self: MIRLowering, MUTABLE stmt: Emittable, attr: String@symbol, value: Emittable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (attr == :target) THEN
      MUTABLE rtoc_writer_receiver_270: Set = castEmittableToSet(stmt);
      rtoc_writer_receiver_270.target = COPY value;
    ELSE_IF (attr == :value) THEN
      IF stmt IS_A ReassignWithCleanup AS reassign_with_cleanup THEN
        MUTABLE reassign_with_cleanup_mutable = COPY reassign_with_cleanup;
        reassign_with_cleanup_mutable.value = COPY value;
      ELSE_IF stmt IS_A ReturnStmt AS return_stmt THEN
        MUTABLE return_stmt_mutable = COPY return_stmt;
        return_stmt_mutable.value = COPY value;
      ELSE_IF stmt IS_A BreakStmt AS break_stmt THEN
        MUTABLE break_stmt_mutable = COPY break_stmt;
        break_stmt_mutable.value = COPY value;
      END
    ELSE_IF (attr == :expr) THEN
      MUTABLE rtoc_writer_receiver_271: ExprStmt = castEmittableToExprStmt(stmt);
      rtoc_writer_receiver_271.expr = COPY value;
    ELSE_IF (attr == :cond) THEN
      IF stmt IS_A IfStmt AS if_stmt THEN
        MUTABLE if_stmt_mutable = COPY if_stmt;
        if_stmt_mutable.cond = COPY value;
      ELSE
        MUTABLE rtoc_writer_receiver_272: WhileStmt = castEmittableToWhileStmt(stmt);
        rtoc_writer_receiver_272.cond = COPY value;
      END
    ELSE_IF (attr == :update) THEN
      MUTABLE rtoc_writer_receiver_273: WhileStmt = castEmittableToWhileStmt(stmt);
      rtoc_writer_receiver_273.update = COPY value;
    ELSE_IF (attr == :iter) THEN
      MUTABLE rtoc_writer_receiver_274: ForStmt = castEmittableToForStmt(stmt);
      rtoc_writer_receiver_274.iter = COPY value;
    ELSE_IF (attr == :subject) THEN
      IF stmt IS_A SwitchStmt AS switch_stmt THEN
        MUTABLE switch_stmt_mutable = COPY switch_stmt;
        switch_stmt_mutable.subject = COPY value;
      ELSE
        MUTABLE rtoc_writer_receiver_275: UnionMatchStmt = castEmittableToUnionMatchStmt(stmt);
        rtoc_writer_receiver_275.subject = COPY value;
      END
    ELSE_IF (attr == :item_expr) THEN
      MUTABLE rtoc_writer_receiver_276: BatchWindowPush = castEmittableToBatchWindowPush(stmt);
      rtoc_writer_receiver_276.item_expr = COPY value;
    ELSE_IF (attr == :value_expr) THEN
      IF stmt IS_A BatchWindowPush AS batch_window_push THEN
        MUTABLE batch_window_push_mutable = COPY batch_window_push;
        batch_window_push_mutable.value_expr = COPY value;
      ELSE
        MUTABLE rtoc_writer_receiver_277: BatchWindowFlush = castEmittableToBatchWindowFlush(stmt);
        rtoc_writer_receiver_277.value_expr = COPY value;
      END
    END
}
END
PRIVATE FN mIRLowering__if_bind_transfer_present?(self: MIRLowering, stmt: IfBindStmt, name: String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (CAST(Tuple{stmt.then_body, stmt.else_body} AS Tuple<[]ResourceClose, Any>)) |> ANY _ |> ANY (_ IS_A TransferMark AND (_.name() == name));
}
END
PRIVATE FN mIRLowering__normalize_nested_mir_bodies_mut(self: MIRLowering, node: Emittable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    FOR _ IN node.body_slots() DO
    MUTABLE rtoc_mutable_block_param_278 = COPY _;
    &rtoc_mutable_block_param_278.replace(mIRLowering__normalize_allocating_mir_body(rtoc_self_view, rtoc_mutable_block_param_278.body()));
    END
    NIL;
}
END
PRIVATE FN mIRLowering__normalize_allocating_result_expr_mut(self: MIRLowering, expr: Emittable, transfer_on_success: Bool = FALSE, owned_position: Bool = FALSE) RETURNS ![]Emittable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE prefix: []Emittable = ( { MUTABLE rtoc_empty_list_279: []Emittable = List[]; rtoc_empty_list_279 } );
    IF !((respondsTo?(expr, "expr?") AND expr.expr?())) THEN
      RETURN prefix;
    END
    IF (IF expr IS_A MIRBlockExpr AS mir_block_expr THEN (blockExpr__lazy_boundary(&mir_block_expr) != NIL) ELSE FALSE END) THEN
      RETURN prefix;
    END
    IF expr IS_A TryCatch AS try_catch THEN
      RETURN prefix;
    END
    IF expr IS_A IfOptional AS if_optional THEN
      MUTABLE optional_prefix, optional_normalized = mIRLowering__normalize_allocating_used_expr(rtoc_self_view, if_optional.optional, FALSE);
      mIRLowering__replace_mir_expr_child_mut(rtoc_self_view, Emittable{ IfOptional: COPY if_optional }, if_optional.optional, optional_normalized);
      prefix = ruby_array_concat_Emittable(prefix, optional_prefix);
      RETURN prefix;
    END
    MUTABLE result_children = expr.ownership_source_exprs();
    MUTABLE owned_sources: [Set]Emittable = expr.owned_position_source_exprs() |> DISTINCT _;
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < result_children.length() DO
      IF (((owned_position OR expr IS_A TryExpr)) AND owned_sources.contains?(result_children[rtoc_idx])) THEN
          prefix = ruby_array_concat_Emittable(prefix, mIRLowering__normalize_allocating_result_expr_mut(rtoc_self_view, result_children[rtoc_idx], transfer_on_success, TRUE));
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF mIRLowering__mir_produces_owned_result?(rtoc_self_view, result_children[rtoc_idx]) THEN
          MUTABLE owned_prefix, owned_normalized = mIRLowering__normalize_allocating_used_expr(rtoc_self_view, result_children[rtoc_idx], mIRLowering__consumes_owned_children?(rtoc_self_view, expr));
          mIRLowering__replace_mir_expr_child_mut(rtoc_self_view, expr, result_children[rtoc_idx], owned_normalized);
          prefix = ruby_array_concat_Emittable(prefix, owned_prefix);
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF mIRLowering__mir_allocates?(rtoc_self_view, result_children[rtoc_idx]) THEN
          prefix = ruby_array_concat_Emittable(prefix, mIRLowering__normalize_allocating_result_expr_mut(rtoc_self_view, result_children[rtoc_idx], transfer_on_success));
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE child_prefix, child_normalized = mIRLowering__normalize_allocating_used_expr(rtoc_self_view, result_children[rtoc_idx], mIRLowering__consumes_owned_children?(rtoc_self_view, expr));
      mIRLowering__replace_mir_expr_child_mut(rtoc_self_view, expr, result_children[rtoc_idx], child_normalized);
      ruby_array_concat_Emittable(prefix, child_prefix);
    rtoc_idx = rtoc_idx + 1;
    END
    mIRLowering__each_mir_expr_child(rtoc_self_view, expr, %(child: Emittable) USE(expr, MUTABLE prefix, result_children, rtoc_self_view) -> {
    IF result_children |> ANY _.equal?(child) THEN
        RETURN;
    END
    MUTABLE other_prefix, other_normalized = mIRLowering__normalize_allocating_used_expr(rtoc_self_view, child, mIRLowering__consumes_owned_children?(rtoc_self_view, expr));
    mIRLowering__replace_mir_expr_child_mut(rtoc_self_view, expr, child, other_normalized);
    ruby_array_concat_Emittable(prefix, other_prefix);
    rubyToClearVoid()
    });
    RETURN prefix;
}
END
PRIVATE FN mIRLowering__normalize_allocating_used_expr(self: MIRLowering, expr: Emittable, transfer_on_success: Bool = FALSE) RETURNS Tuple<[]Emittable, Emittable>
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE hoisted = NIL;
    MUTABLE ident = NIL;
    MUTABLE nested: []Emittable = List[];
    MUTABLE prefix: []Emittable = ( { MUTABLE rtoc_empty_list_280: []Emittable = List[]; rtoc_empty_list_280 } );
    IF !((respondsTo?(expr, "expr?") AND expr.expr?())) THEN
      RETURN CAST(Tuple{prefix, expr} AS Tuple<[]Emittable, Emittable>);
    END
    IF expr IS_A Ident AS ident THEN
      RETURN CAST(Tuple{prefix, ident} AS Tuple<[]Emittable, Emittable>);
    END
    IF (IF expr IS_A MIRBlockExpr AS mir_block_expr THEN (blockExpr__lazy_boundary(&mir_block_expr) != NIL) ELSE FALSE END) THEN
      RETURN CAST(Tuple{prefix, expr} AS Tuple<[]Emittable, Emittable>);
    END
    IF expr IS_A IfOptional AS if_optional THEN
      MUTABLE optional_prefix, optional_normalized = mIRLowering__normalize_allocating_used_expr(rtoc_self_view, if_optional.optional, FALSE);
      mIRLowering__replace_mir_expr_child_mut(rtoc_self_view, Emittable{ IfOptional: COPY if_optional }, if_optional.optional, optional_normalized);
      prefix = ruby_array_concat_Emittable(prefix, optional_prefix);
      RETURN CAST(Tuple{prefix, if_optional} AS Tuple<[]Emittable, Emittable>);
    END
    IF (!(mIRLowering__mutating_receiver_allocator_op?(rtoc_self_view, expr)) AND mIRLowering__mir_produces_owned_result?(rtoc_self_view, expr)) THEN
      MUTABLE type_info = mIRLowering__mir_alloc_mark_type_info(rtoc_self_view, expr, NIL, "normalized MIR allocation");
      MUTABLE cleanup_entry: ?CleanupEntry@multiowned = mIRLowering__hoist_cleanup_entry(rtoc_self_view, expr, NIL);
      nested = mIRLowering__normalize_allocating_result_expr_mut(rtoc_self_view, expr, transfer_on_success);
      prefix = ruby_array_concat_Emittable(prefix, nested);
      IF mIRLowering__normalized_alloc_wrapper_alias?(rtoc_self_view, expr) THEN
        RETURN CAST(Tuple{prefix, expr} AS Tuple<[]Emittable, Emittable>);
      END
      hoisted, ident = mIRLowering__hoist_normalized_alloc_expr(rtoc_self_view, expr, transfer_on_success, CAST(type_info AS ?Type), cleanup_entry);
      prefix = ruby_array_concat_Emittable(prefix, CAST(hoisted AS []Emittable));
      RETURN CAST(Tuple{prefix, ident} AS Tuple<[]Emittable, Emittable>);
    END
    IF mIRLowering__mir_consumes_owned_operands?(rtoc_self_view, expr) THEN
      nested = mIRLowering__normalize_allocating_result_expr_mut(rtoc_self_view, expr, transfer_on_success);
      prefix = ruby_array_concat_Emittable(prefix, nested);
      hoisted, ident = mIRLowering__hoist_normalized_value_expr(rtoc_self_view, expr);
      prefix = ruby_array_concat_Emittable(prefix, CAST(hoisted AS []Emittable));
      RETURN CAST(Tuple{prefix, ident} AS Tuple<[]Emittable, Emittable>);
    END
    mIRLowering__each_mir_expr_child(rtoc_self_view, expr, %(child: Emittable) USE(expr, MUTABLE prefix, rtoc_self_view) -> {
    MUTABLE child_prefix, normalized = mIRLowering__normalize_allocating_used_expr(rtoc_self_view, child, mIRLowering__consumes_owned_children?(rtoc_self_view, expr));
    mIRLowering__replace_mir_expr_child_mut(rtoc_self_view, expr, child, normalized);
    ruby_array_concat_Emittable(prefix, child_prefix);
    rubyToClearVoid()
    });
    RETURN CAST(Tuple{prefix, expr} AS Tuple<[]Emittable, Emittable>);
}
END
PRIVATE FN mIRLowering__normalized_alloc_wrapper_alias?(self: MIRLowering, expr: Emittable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN PARTIAL MATCH expr START
      Emittable.MIRCast AS mir_cast -> cast__expr(mir_cast) IS_A Ident,
      Emittable.MIROptionalUnwrap AS mir_optional_unwrap -> optionalUnwrap__expr(mir_optional_unwrap) IS_A Ident,
      DEFAULT -> FALSE
    END;
}
END
PRIVATE FN mIRLowering__mir_consumes_owned_operands?(self: MIRLowering, expr: Emittable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE contract: ?OwnershipContract@multiowned = mIRLowering__ownership_contract_for_node(rtoc_self_view, expr);
    IF !((contract != NIL)) THEN
      RETURN FALSE;
    END
    RETURN contract.operands |> ANY (!(_.borrowed) AND (_.name != NIL));
}
END
PRIVATE FN mIRLowering__replace_mir_expr_child_mut(self: MIRLowering, MUTABLE parent: Emittable, old_child: Emittable, new_child: Emittable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF old_child.equal?(new_child) THEN
      RETURN;
    END
    IF !((respondsTo?(parent, "mir?") AND parent.mir?())) THEN
      RETURN;
    END
    IF !(respondsTo?(parent.class(), "members")) THEN
      mIRLowering__replace_t_struct_expr_child_mut(rtoc_self_view, parent, old_child, new_child);
      RETURN;
    END
    MUTABLE rtoc_each_items_281 = parent.class().members();
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_281.length() DO
      MUTABLE value = parent[rtoc_each_items_281[rtoc_idx]];
      IF value.equal?(old_child) THEN
          parent[rtoc_each_items_281[rtoc_idx]] = COPY new_child;
          mIRLowering__refresh_ownership_consumption_for_replaced_child_mut(rtoc_self_view, &parent, old_child, new_child);
          RETURN;
      ELSE_IF (value IS_A []@multiowned Any OR value IS_A {}Any) THEN
          IF mIRLowering__replace_mir_expr_in_value_mut(rtoc_self_view, &value, old_child, new_child) THEN
            mIRLowering__refresh_ownership_consumption_for_replaced_child_mut(rtoc_self_view, &parent, old_child, new_child);
            RETURN;
          END
      END
    rtoc_idx = rtoc_idx + 1;
    END
    NIL;
}
END
PRIVATE FN mIRLowering__replaceable_t_struct?(self: MIRLowering, node: Emittable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN node IS_A RegistryCall;
}
END
PRIVATE FN mIRLowering__replace_t_struct_expr_child_mut(self: MIRLowering, MUTABLE parent: Emittable, old_child: Emittable, new_child: Emittable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(respondsTo?(parent.class(), "props")) THEN
      RETURN;
    END
    unsupportedRuby("CallNode at 1488:4: each_key block contains unsupported ReturnNode");
    NIL;
}
END
PRIVATE FN mIRLowering__replace_mir_expr_in_value_mut(self: MIRLowering, MUTABLE value: MirAggregate, old_child: Emittable, new_child: Emittable) RETURNS Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (value == Array) THEN
      MUTABLE replaced: Bool = FALSE;
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < value.length() DO
      IF value[rtoc_idx].equal?(old_child) THEN
            value[rtoc_idx] = COPY new_child;
            replaced = TRUE;
            BREAK;
      END
      IF (value[rtoc_idx] IS_A []@multiowned Any OR value[rtoc_idx] IS_A {}Any) THEN
            IF mIRLowering__replace_mir_expr_in_value_mut(rtoc_self_view, &value[rtoc_idx], old_child, new_child) THEN
              replaced = TRUE;
              BREAK;
            END
      END
    rtoc_idx = rtoc_idx + 1;
      END
      RETURN replaced;
    ELSE_IF (value == Hash) THEN
      MUTABLE replaced: Bool = FALSE;
      FOR _ IN value.keys() DO
    MUTABLE item = value[_];
    IF item.equal?(old_child) THEN
          value[_] = COPY new_child;
          replaced = TRUE;
          BREAK;
    END
    IF (item IS_A []@multiowned Any OR item IS_A {}Any) THEN
          IF mIRLowering__replace_mir_expr_in_value_mut(rtoc_self_view, &item, old_child, new_child) THEN
            replaced = TRUE;
            BREAK;
          END
    END
      END
      RETURN replaced;
    END
    RETURN FALSE;
}
END
PRIVATE FN mIRLowering__refresh_ownership_consumption_for_replaced_child_mut(self: MIRLowering, MUTABLE parent: Emittable, old_child: Emittable, new_child: Emittable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fact = parent.ownership_consumption();
    MUTABLE old_names = (mIRLowering__mir_ident_names(rtoc_self_view, old_child) |> SELECT _.toString()) |> DISTINCT _;
    MUTABLE new_names = mIRLowering__mir_ident_names(rtoc_self_view, new_child) |> SELECT _.toString();
    MUTABLE visible_names = new_names |> WHERE mIRLowering__owned_binding_visible?(rtoc_self_view, CAST(_ AS String));
    IF (visible_names.length() == 0) THEN
      RETURN;
    END
    IF !(fact IS_A OwnershipConsumptionFact) THEN
      IF !(((parent IS_A StructInit OR parent IS_A ArrayInit) OR parent IS_A TupleLiteral)) THEN
        RETURN;
      END
      MUTABLE allocs = (visible_names |> SELECT:? (IF (TRY (functionState__bindings(mIRLowering__function_state(rtoc_self_view))))[CAST(_ AS String)] != NIL THEN
        { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_282 = ((TRY (functionState__bindings(mIRLowering__function_state(rtoc_self_view))))[CAST(_ AS String)]);
      cleanupEntry__alloc(rtoc_local_receiver_282) }
      ELSE
        NIL
      END) |> WHERE _ != NIL) |> DISTINCT _ |> SELECT COPY _;
      MUTABLE target_alloc: ?String@symbol =     IF allocs.one?() THEN
        allocs.first()
      ELSE
        (IF (IF ownershipEffect__alloc_of(old_child) != NIL THEN ownershipEffect__alloc_of(old_child) ELSE mIRLowering__mir_owned_alloc(rtoc_self_view, new_child) END) != NIL THEN (IF ownershipEffect__alloc_of(old_child) != NIL THEN ownershipEffect__alloc_of(old_child) ELSE mIRLowering__mir_owned_alloc(rtoc_self_view, new_child) END) ELSE mIRLowering__function_state(rtoc_self_view).current_decl_alloc END)
      END;
      parent.ownership_consumption = OwnershipConsumptionFact{ operands: COPY visible_names |> SELECT ownershipOperandFact__owned_binding(CAST(_ AS String), TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })), "hoist replacement", target_alloc), target: :owned_sink, target_alloc: COPY target_alloc, source: COPY parent.class().name(), covers_consuming_params: TRUE };
      RETURN;
    END
    MUTABLE operands = (TRY (callOwnershipFacts__operands(fact))) |> WHERE !((_.name AND old_names.contains?(CAST(((_.name)?) AS String))));
    FOR _ IN visible_names DO
    &operands.append(ownershipOperandFact__owned_binding(CAST(_ AS String), TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })), "hoist replacement", fact.target_alloc()));
    END
    parent.ownership_consumption = OwnershipConsumptionFact{ operands: COPY operands, target: COPY fact.target(), target_alloc: COPY fact.target_alloc(), source: COPY fact.source(), covers_consuming_params: fact.covers_consuming_params() };
    NIL;
}
END
PRIVATE FN mIRLowering__stamp_allocating_result_target_mut(self: MIRLowering, MUTABLE expr: Emittable, name: String, alloc: ?String@symbol = NIL) RETURNS Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (name.length() == 0) THEN
      RETURN;
    END
    IF expr IS_A RegistryCall AS registry_call THEN
      MUTABLE registry_call_mutable = COPY registry_call;
      IF !((registryCall__has_alloc_metadata?(registry_call_mutable) OR ownershipEffect__of(Emittable{ RegistryCall: COPY registry_call_mutable }).produces_owned)) THEN
        RETURN;
      END
      IF registryCall__mutating_receiver_allocator_op?(registry_call_mutable) THEN
        RETURN;
      END
      registry_call_mutable.target_var = COPY name;
      IF alloc EXISTS AS alloc_value THEN
        IF KEEP registry_call_mutable.allocs != NIL THEN
          registry_call_mutable.allocs = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_284 = ((KEEP registry_call_mutable.allocs)?);
        inlineAllocMetadata__with_all(rtoc_local_receiver_284, alloc_value) };
        ELSE
          registry_call_mutable.allocs = NIL;
        END
      END
    ELSE
      IF (((alloc != NIL) AND ownershipEffect__of(expr).produces_owned) AND respondsTo?(expr, "alloc=")) THEN
        expr.alloc = COPY alloc;
      END
      FOR _ IN expr.ownership_source_exprs() DO
    MUTABLE rtoc_mutable_block_param_285 = COPY _;
    MUTABLE has_alloc_metadata = (respondsTo?(rtoc_mutable_block_param_285, "has_alloc_metadata?") AND rtoc_mutable_block_param_285.has_alloc_metadata?());
    IF (has_alloc_metadata OR mIRLowering__mir_allocates?(rtoc_self_view, rtoc_mutable_block_param_285)) THEN
          mIRLowering__stamp_allocating_result_target_mut(rtoc_self_view, &rtoc_mutable_block_param_285, name, alloc);
    END
      END
    END
    NIL;
}
END
PRIVATE FN mIRLowering__copy_container_borrow_if_needed(self: MIRLowering, expr: Emittable, ast_node: Locatable) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(mIRHoistFacts__container_borrow_expr?(ast_node)) THEN
      RETURN COPY expr;
    END
    IF mIRLowering__mir_allocates?(rtoc_self_view, expr) THEN
      RETURN COPY expr;
    END
    MUTABLE ti = TRY (type__from_node_mut(ast_node, "container borrow copy"));
    ti = TRY (type__success_type(ti));
    IF !((TRY (mIRLowering__union_schemas(rtoc_self_view))).contains?(type__resolved(ti))) THEN
      RETURN COPY expr;
    END
    MUTABLE copied = DeepCopy{ source: COPY expr, zig_type: COPY TRY (type__zig_type(ti)), elem_type: NIL, strategy: :full_value, alloc: :heap, copy_shape: NIL, type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL };
    RETURN mIRLowering__hoist_alloc(rtoc_self_view, Emittable{ DeepCopy: COPY copied }, ast_node, TRUE);
}
END
PRIVATE FN mIRLowering__rc_cleanup_entry(self: MIRLowering, ast_node: ?Locatable, source: String, mir: ?Emittable = NIL) RETURNS !CleanupEntry@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE ti =   IF ast_node THEN
      TRY (type__from_node_mut(ast_node, "RC hoist cleanup"))
    ELSE_IF mir THEN
      mIRLowering__mir_alloc_mark_type_info(rtoc_self_view, UNWRAP (mir), NIL, "RC hoist cleanup for ${source}")
    ELSE
      panic("RC hoist cleanup: missing type info for {}")
    END;
    MUTABLE zig_t = TRY (type__zig_type(ti));
    MUTABLE rc_entry = cleanupEntry__build(:rc, :heap, FALSE, NIL, zig_t);
    rc_entry.rc_variant = :standard;
    rc_entry.rc_alloc = :heap;
    RETURN rc_entry;
}
END
PRIVATE FN mIRLowering__uniform_cleanup_entry(self: MIRLowering, zig_type: String, alloc: String@symbol = :heap) RETURNS CleanupEntry@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN cleanupEntry__build(:uniform, alloc, FALSE, NIL, zig_type);
}
END
PRIVATE FN mIRLowering__heap_string_entry(self: MIRLowering, alloc: String@symbol = :heap) RETURNS CleanupEntry@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN cleanupEntry__build(:heap_string, alloc, TRUE);
}
END
PRIVATE FN mIRLowering__mir_owned_alloc(self: MIRLowering, mir: ?Emittable) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE effect_alloc: ?String@symbol = ownershipEffect__alloc_of(mir);
    IF effect_alloc EXISTS AS effect_alloc_value THEN
      RETURN effect_alloc_value;
    END
    IF mir? IS_A Ident AS ident THEN
      MUTABLE entry = ((TRY (functionState__bindings(mIRLowering__function_state(rtoc_self_view))))[CAST(ident.name AS String)] OR_ELSE new());
      IF cleanupEntry__present?(entry) THEN
        RETURN entry.alloc();
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN mIRLowering__hoist_cleanup_entry(self: MIRLowering, mir: Emittable, ast_node: ?Locatable) RETURNS !?CleanupEntry@multiowned
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE alloc = (mIRLowering__mir_owned_alloc(rtoc_self_view, mir) OR_ELSE :heap);
    IF mir IS_A DupeSlice AS dupe_slice THEN
      RETURN mIRLowering__heap_string_entry(rtoc_self_view, alloc);
    ELSE_IF mir IS_A ConcatStr AS concat_str THEN
      RETURN mIRLowering__heap_string_entry(rtoc_self_view, alloc);
    ELSE_IF mir IS_A AllocSlice AS alloc_slice THEN
      MUTABLE e = mIRLowering__uniform_cleanup_entry(rtoc_self_view, "[]${alloc_slice.elem_type}", alloc);
      e[:elem_zig_type] = alloc_slice.elem_type;
      RETURN e;
    ELSE_IF mir IS_A MakeList AS make_list THEN
      RETURN mIRLowering__uniform_cleanup_entry(rtoc_self_view, "std.ArrayListUnmanaged(${make_list.elem_type})", alloc);
    ELSE_IF mir IS_A OwnedSlice AS owned_slice THEN
      RETURN mIRLowering__uniform_cleanup_entry(rtoc_self_view, "[]", alloc);
    ELSE_IF mir IS_A HeapCreate AS heap_create THEN
      RETURN mIRLowering__uniform_cleanup_entry(rtoc_self_view, heap_create.zig_type, alloc);
    ELSE_IF mir IS_A ContainerInit AS container_init THEN
      RETURN mIRLowering__uniform_cleanup_entry(rtoc_self_view, container_init.zig_type, alloc);
    ELSE_IF mir IS_A DeepCopy AS deep_copy THEN
      IF !((deep_copy.strategy == :full_value)) THEN
        panic("hoist_cleanup_entry: unexpected DeepCopy strategy :{}");
      END
      RETURN mIRLowering__uniform_cleanup_entry(rtoc_self_view, mIRLowering__deep_copy_zig_type(rtoc_self_view, deep_copy, ast_node), alloc);
    ELSE_IF mir IS_A CapWrap AS cap_wrap THEN
      IF cap_wrap.sync_fn THEN
        RETURN mIRLowering__uniform_cleanup_entry(rtoc_self_view, UNWRAP (cap_wrap.sync_type), alloc);
      ELSE_IF cap_wrap.own_fn THEN
        RETURN mIRLowering__rc_cleanup_entry(rtoc_self_view, ast_node, "MIR::CapWrap (own_fn=${cap_wrap.own_fn})", Emittable{ CapWrap: COPY cap_wrap });
      ELSE_IF (cap_wrap.strategy == :local) THEN
        RETURN mIRLowering__uniform_cleanup_entry(rtoc_self_view, "*${cap_wrap.zig_base}", alloc);
      END
    ELSE_IF mir IS_A SharePromote AS share_promote THEN
      RETURN mIRLowering__rc_cleanup_entry(rtoc_self_view, ast_node, "MIR::SharePromote", Emittable{ SharePromote: COPY share_promote });
    ELSE_IF mir IS_A RcRetain AS rc_retain THEN
      IF mIRLowering__cleanup_entry_for_owned_result(rtoc_self_view, ast_node, alloc) != NIL THEN
    RETURN (mIRLowering__cleanup_entry_for_owned_result(rtoc_self_view, ast_node, alloc))?;
      ELSE
    RETURN cleanupEntry__build(:rc, alloc, FALSE);
      END
    ELSE_IF mir IS_A RcDowngrade AS rc_downgrade THEN
      IF mIRLowering__cleanup_entry_for_owned_result(rtoc_self_view, ast_node, alloc) != NIL THEN
    RETURN (mIRLowering__cleanup_entry_for_owned_result(rtoc_self_view, ast_node, alloc))?;
      ELSE
    RETURN cleanupEntry__build(:rc, alloc, FALSE);
      END
    ELSE_IF mir IS_A WeakUpgrade AS weak_upgrade THEN
      IF mIRLowering__cleanup_entry_for_owned_result(rtoc_self_view, ast_node, alloc) != NIL THEN
    RETURN (mIRLowering__cleanup_entry_for_owned_result(rtoc_self_view, ast_node, alloc))?;
