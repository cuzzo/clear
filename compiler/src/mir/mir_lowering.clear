PRIVATE FN mIRLowering__indexed_assignment_resolved_alloc(self: MIRLowering, op: FunctionSignature, alloc_key: IntrinsicAllocationKind, target_node: Locatable, assignment: Assignment) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE registry_alloc: ?String@symbol = mIRLowering__indexed_assignment_registry_alloc(rtoc_self_view, op, alloc_key);
    IF registry_alloc EXISTS AS registry_alloc_value THEN
      RETURN TRY (mIRLowering__resolve_alloc_sym(rtoc_self_view, registry_alloc_value, target_node, Locatable{ Assignment: COPY assignment }));
    ELSE
