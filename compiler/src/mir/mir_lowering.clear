PRIVATE FN mIRLowering__enforce_bg_capture_strategies_mut(self: MIRLowering, node: Node, ignored_captured: {String}Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE strategies: {Any}Any = {};
    IF node.capture_analysis() THEN
      strategies = node.capture_analysis().strategies();
    ELSE
      strategies = {};
    END
    MUTABLE refused = strategies |> WHERE _._1 IS_A Refuse;
    IF (refused.count() == 0) THEN
      RETURN;
    END
    MUTABLE lines = refused.keys() |> SELECT {
    MUTABLE hint = PARTIAL MATCH (COPY UNWRAP (refused[_])).reason() START
        :pointer_passed_without_transfer -> "'${_}' is @pool/@map/HashMap \u{2014} wrap in @shared:locked, or GIVE/COPY inside the BG body.",
        :list_borrow_without_transfer -> "'${_}' is @list \u{2014} GIVE inside the BG body to transfer ownership, or COPY to deep-copy.",
        :pool_borrow_without_transfer -> "'${_}' is @pool \u{2014} wrap in @shared:locked, or GIVE inside the BG body.",
        :array_borrow_without_transfer -> "'${_}' is a slice borrow \u{2014} COPY inside the BG body for a fresh heap copy.",
        :heap_backed_without_transfer -> "'${_}' is heap-backed \u{2014} GIVE/COPY inside the BG body, or use @multiowned/@shared.",
        DEFAULT -> "'${_}' cannot be safely captured (${(COPY UNWRAP (refused[_])).reason()})."
      END;
    "  - ${hint}"
    };
    panic((("BG block captures values that cannot safely cross the fiber boundary:\n" $+ lines.join("\n")) $+ "\n(See docs/agents/vm-bugs.md for the ownership rules.)"));
}
END
