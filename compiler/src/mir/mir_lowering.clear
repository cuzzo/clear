FN mIRLowering__with_fiber_capture_map<U>(MUTABLE self: MIRLowering, new_entries: {String}String, capture_symbols: {String}SymbolEntry, rt_override: String = "__rt", blk: FN() -> U) RETURNS U
  REQUIRES self: LOCAL
