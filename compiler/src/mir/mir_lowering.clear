    AstIdentifierSearchNode.DistinctOp AS cast_payload -> RETURN Locatable{ DistinctOp: COPY cast_payload };,
    AstIdentifierSearchNode.TakeWhileOp AS cast_payload -> RETURN Locatable{ TakeWhileOp: COPY cast_payload };,
    AstIdentifierSearchNode.WindowOp AS cast_payload -> RETURN Locatable{ WindowOp: COPY cast_payload };,
    AstIdentifierSearchNode.BatchWindowOp AS cast_payload -> RETURN Locatable{ BatchWindowOp: COPY cast_payload };,
    AstIdentifierSearchNode.FindOp AS cast_payload -> RETURN Locatable{ FindOp: COPY cast_payload };,
    AstIdentifierSearchNode.AnyOp AS cast_payload -> RETURN Locatable{ AnyOp: COPY cast_payload };,
    AstIdentifierSearchNode.AllOp AS cast_payload -> RETURN Locatable{ AllOp: COPY cast_payload };,
    AstIdentifierSearchNode.CountOp AS cast_payload -> RETURN Locatable{ CountOp: COPY cast_payload };,
    AstIdentifierSearchNode.SumOp AS cast_payload -> RETURN Locatable{ SumOp: COPY cast_payload };,
    AstIdentifierSearchNode.AverageOp AS cast_payload -> RETURN Locatable{ AverageOp: COPY cast_payload };,
    AstIdentifierSearchNode.MinOp AS cast_payload -> RETURN Locatable{ MinOp: COPY cast_payload };,
    AstIdentifierSearchNode.MaxOp AS cast_payload -> RETURN Locatable{ MaxOp: COPY cast_payload };,
    AstIdentifierSearchNode.AssertRaises AS cast_payload -> RETURN Locatable{ AssertRaises: COPY cast_payload };,
    AstIdentifierSearchNode.BenchmarkStmt AS cast_payload -> RETURN Locatable{ BenchmarkStmt: COPY cast_payload };,
    AstIdentifierSearchNode.SmashStmt AS cast_payload -> RETURN Locatable{ SmashStmt: COPY cast_payload };,
    AstIdentifierSearchNode.ProfileStmt AS cast_payload -> RETURN Locatable{ ProfileStmt: COPY cast_payload };,
    DEFAULT -> RETURN panic("unreachable identifier search node");
  END
  RETURN panic("unreachable identifier search node");
END
PRIVATE FN mIRLowering__collect_identifier_refs(self: MIRLowering, node: ?AstIdentifierSearchNode, name_set: {String}LetBinding, MUTABLE out: [Set]String) RETURNS Void ->
    IF node == NIL THEN
      RETURN;
    END
    aST__each_locatable(castAstIdentifierSearchNodeToLocatable(node), TRUE, %(candidate: Locatable) USE(name_set, MUTABLE out) -> {
    IF (IF candidate IS_A Identifier AS identifier THEN name_set.contains?(identifier__name(identifier)) ELSE FALSE END) THEN
        IF locatable__name(candidate) EXISTS AS candidate_name THEN
        &out.insert(COPY CAST(candidate_name AS String));
      END
    END
    rubyToClearVoid__mir_lowering()
    });
END
PRIVATE FN mIRLowering__lower_assert_raises(MUTABLE self: MIRLowering, node: AssertRaises) RETURNS !AssertRaisesCheck ->
    RETURN AssertRaisesCheck{ expr: UNWRAP (COPY TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(node.expression)))), rt_name: mIRLowering__runtime_binding_name(&self), kind: node.kind, error_name: node.error_name, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN mIRLowering__stub_intercept_for(MUTABLE self: MIRLowering, fn_name: String, receiver: ?Locatable, args: []Locatable) RETURNS !?Emittable ->
    MUTABLE stub_info_opt:? = (COPY mIRLowering__test_state(&self).active_stubs)[fn_name];
    IF stub_info_opt == NIL THEN
      RETURN NIL;
    END
    MUTABLE stub_info: StubInfo = COPY stub_info_opt;
    MUTABLE call_inputs = ([receiver] + args);
    MUTABLE suppress_names = (call_inputs |> UNNEST TRY (mIRLowering__stub_local_idents(&self, UNWRAP (_)))) |> DISTINCT _ |> SELECT COPY _;
    MUTABLE suppress_stmts = suppress_names |> SELECT Suppress{ name: COPY _, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    MUTABLE counter = (mIRLowering__test_state(&self).stub_label_counter + 1);
    self.state.test.stub_label_counter = counter;
    IF (stub_info.kind == :returns) THEN
      IF (suppress_stmts.length() == 0) THEN
        RETURN Emittable{ Ident: COPY Ident{ name: COPY (stub_info).var, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
      MUTABLE label = "__stub_ret_${counter.toString()}";
      RETURN Emittable{ MIRBlockExpr: COPY MIRBlockExpr{ label: COPY label, body: CAST(COPY (suppress_stmts + [Emittable{ BreakStmt: COPY BreakStmt{ label: COPY label, value: Emittable{ Ident: COPY Ident{ name: COPY (stub_info).var, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }]) AS []Emittable), lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL } };
    ELSE_IF ((stub_info).kind == :captures) THEN
      MUTABLE cnt = Ident{ name: COPY (stub_info).var, lowered_node_id: NIL, ownership_consumption: NIL };
      MUTABLE inc = Set{ target: Emittable{ Ident: COPY cnt }, value: Emittable{ MIRBinOp: COPY MIRBinOp{ op: "+", left: Emittable{ Ident: COPY cnt }, right: Emittable{ Lit: COPY Lit{ value: "1", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
      RETURN Emittable{ MIRBlockExpr: COPY MIRBlockExpr{ label: NIL, body: CAST(COPY (suppress_stmts + [Emittable{ Set: COPY inc }]) AS []Emittable), lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL } };
    ELSE_IF ((stub_info).kind == :sequence) THEN
      MUTABLE label = "__stub_seq_${counter.toString()}";
      MUTABLE seq = Ident{ name: "${(stub_info).var}_seq", lowered_node_id: NIL, ownership_consumption: NIL };
      MUTABLE idx = Ident{ name: "${(stub_info).var}_idx", lowered_node_id: NIL, ownership_consumption: NIL };
      MUTABLE si = "__stub_si_${counter.toString()}";
      RETURN Emittable{ MIRBlockExpr: COPY MIRBlockExpr{ label: COPY label, body: CAST(COPY (suppress_stmts + [Emittable{ Let: COPY Let{ name: COPY si, init: Emittable{ Ident: COPY idx }, mutable: FALSE, annotation: COPY TRY (type__new(TypeConstructionInput{ StringValue: COPY "usize" })), suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }, Emittable{ Set: COPY Set{ target: Emittable{ Ident: COPY idx }, value: Emittable{ MIRBinOp: COPY MIRBinOp{ op: "+", left: Emittable{ Ident: COPY idx }, right: Emittable{ Lit: COPY Lit{ value: "1", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ BreakStmt: COPY BreakStmt{ label: COPY label, value: Emittable{ IndexGet: COPY IndexGet{ object: Emittable{ Ident: COPY seq }, index: Emittable{ Ident: COPY Ident{ name: COPY si, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }]) AS []Emittable), lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL } };
    ELSE_IF ((stub_info).kind == :with) THEN
      MUTABLE args_mir: []Emittable = List[];
      FOR call_input IN call_inputs DO
        MUTABLE call_input_stmt = castOptionalLocatableToMIRLoweringLowerableStmt(COPY call_input);
        IF TRY (mIRLowering__lower(&self, &call_input_stmt)) EXISTS AS call_input_mir THEN
          &args_mir.append(COPY call_input_mir);
        END
      END
      RETURN Emittable{ Call: COPY Call{ callee: COPY (stub_info).var, args: COPY ([Emittable{ Ident: COPY Ident{ name: mIRLowering__runtime_binding_name(&self), lowered_node_id: NIL, ownership_consumption: NIL } }] + args_mir), try_wrap: TRUE, owned_return: FALSE, callable_contract: NIL, lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL } };
    ELSE
      RETURN NIL;
    END
END
PRIVATE FN mIRLowering__stub_local_idents(MUTABLE self: MIRLowering, node: Locatable) RETURNS ![]String ->
    IF node IS_A Identifier AS identifier THEN
      MUTABLE name = identifier__name(identifier);
      MUTABLE decl: ?SymbolEntryRegInput = NIL;
      IF identifier.symbol != NIL THEN
        decl = COPY ((identifier.symbol)?).reg;
      END
      MUTABLE renamed: String = COPY name;
      IF (TRY (functionState__rename_map(mIRLowering__function_state(&self))))[name] EXISTS AS mapped_name THEN
        renamed = COPY mapped_name;
      END
      IF decl EXISTS AS decl_value THEN
        IF (TRY (functionState__decl_zig_names(mIRLowering__function_state(&self))))[aST__node_identity(castSymbolEntryRegInputToLocatable(decl_value))] EXISTS AS decl_zig_name THEN
          renamed = COPY decl_zig_name;
        END
      END
      RETURN CAST([renamed] AS []String);
    ELSE
      RETURN CAST(List[] AS []String);
    END
END
PRIVATE FN mIRLowering__lower_stub_decl(MUTABLE self: MIRLowering, MUTABLE node: StubDecl) RETURNS !?NodeRoot ->
    MUTABLE fn_name = node.function_name;
    MUTABLE stub_var = "__stub_${fn_name}";
    IF (node.kind == :returns) THEN
      MUTABLE stub_value_stmt = castOptionalLocatableToMIRLoweringLowerableStmt(castStubValueToLocatable(UNWRAP (node.value)));
      MUTABLE val: ?Emittable = TRY (mIRLowering__lower(&self, &stub_value_stmt));
      self.state.test.active_stubs[COPY fn_name] = StubInfo{ kind: :returns, var: COPY stub_var };
      RETURN NodeRoot{ Emittable: COPY CAST(Let{ name: COPY stub_var, init: COPY UNWRAP (val), mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } AS Emittable) };
    ELSE_IF (node.kind == :captures) THEN
      MUTABLE cap_name: ?StubValue@boxed = COPY node.value;
      MUTABLE rtoc_index_receiver_236 = COPY mIRLowering__test_state(&self).active_stubs;
      rtoc_index_receiver_236[fn_name] = StubInfo{ kind: :captures, var: CAST(cap_name AS String) };
      RETURN NodeRoot{ Emittable: COPY CAST(Let{ name: CAST(COPY cap_name AS String), init: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: COPY TRY (type__new(TypeConstructionInput{ StringValue: COPY "i64" })), suppression: "_ = &${CAST(cap_name AS String)};", alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } AS Emittable) };
    ELSE_IF (node.kind == :sequence) THEN
      MUTABLE values_locatable: Locatable = UNWRAP (castStubValueToLocatable(UNWRAP (node.value)));
      MUTABLE items_mir: []Emittable = List[];
      IF aST__node_items(values_locatable) EXISTS AS stub_items THEN
        FOR stub_item IN stub_items DO
          MUTABLE stub_item_stmt = castLocatableToMIRLoweringLowerableStmt__mir_lowering(COPY stub_item);
          IF TRY (mIRLowering__lower(&self, &stub_item_stmt)) EXISTS AS stub_item_mir THEN
            &items_mir.append(COPY stub_item_mir);
          END
        END
      ELSE
        MUTABLE values_stmt = castLocatableToMIRLoweringLowerableStmt__mir_lowering(COPY values_locatable);
        &items_mir.append(UNWRAP (TRY (mIRLowering__lower(&self, &values_stmt))));
      END
      self.state.test.active_stubs[COPY fn_name] = StubInfo{ kind: :sequence, var: COPY stub_var };
      RETURN NodeRoot{ ArrayValue: [Let{ name: COPY "${stub_var}_seq", init: Emittable{ ArrayInit: COPY ArrayInit{ elem_type: "[]const u8", count: "_", items: COPY items_mir, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }, Let{ name: COPY "${stub_var}_idx", init: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: COPY TRY (type__new(TypeConstructionInput{ StringValue: COPY "usize" })), suppression: "_ = &${stub_var}_idx;", alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }] |> SELECT Emittable{ Let: COPY _ } };
    ELSE_IF (node.kind == :with) THEN
      MUTABLE with_value_stmt = castOptionalLocatableToMIRLoweringLowerableStmt(castStubValueToLocatable(UNWRAP (node.value)));
      MUTABLE val: ?Emittable = TRY (mIRLowering__lower(&self, &with_value_stmt));
      MUTABLE rtoc_index_receiver_238 = COPY mIRLowering__test_state(&self).active_stubs;
      rtoc_index_receiver_238[fn_name] = StubInfo{ kind: :with, var: COPY stub_var };
      RETURN NodeRoot{ Emittable: COPY CAST(Let{ name: COPY stub_var, init: COPY UNWRAP (val), mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } AS Emittable) };
    ELSE
      panic("MIRLowering: unhandled StubDecl kind: {} for {}");
    END
END
PRIVATE FN mIRLowering__lower_benchmark(self: MIRLowering, node: BenchmarkStmt) RETURNS Comment ->
    RETURN Comment{ text: "benchmark lowering placeholder", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN mIRLowering__lower_smash(self: MIRLowering, node: SmashStmt) RETURNS Comment ->
    RETURN Comment{ text: "smash test placeholder", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN mIRLowering__lower_profile(self: MIRLowering, node: ProfileStmt) RETURNS Comment ->
    RETURN Comment{ text: "profile placeholder", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN mIRLowering__flush_pending(MUTABLE self: MIRLowering) RETURNS ![]Emittable ->
    MUTABLE stmts = COPY mIRLowering__function_state(&self).pending_stmts;
    self.state.function_state.pending_stmts = List[];
    RETURN stmts;
END
PRIVATE FN mIRLowering__lower_scoped(MUTABLE self: MIRLowering, blk: FN() -> Emittable) RETURNS !Emittable ->
    MUTABLE prev = COPY mIRLowering__function_state(&self).pending_stmts;
    self.state.function_state.pending_stmts = List[];
    MUTABLE result = blk();
    MUTABLE scoped = COPY mIRLowering__function_state(&self).pending_stmts;
    self.state.function_state.pending_stmts = prev;
    IF (scoped.length() == 0) THEN
      RETURN result;
    END
    MUTABLE label = "__lazy_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_244 = mIRLowering__lowering_counters(&self);
    mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_block_expr_id(&rtoc_mutable_receiver_244)) }}";
    MUTABLE alloc_names: [Set]String = Set[];
    MUTABLE alloc_by_name: {String}String@symbol = {};
    FOR scoped_stmt IN scoped DO
      IF scoped_stmt IS_A AllocMark AS scoped_mark THEN
        &alloc_names.insert(COPY scoped_mark.name);
        alloc_by_name[COPY scoped_mark.name] = COPY scoped_mark.alloc;
      END
    END
    MUTABLE result_names: [Set]String = Set[];
    FOR result_name IN TRY (mIRLowering__mir_ident_names(self, result)) DO
      &result_names.insert(COPY result_name);
    END
    FOR _ IN (alloc_names |> WHERE result_names.contains?(_)) DO
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < scoped.length() DO
      IF !((scoped[rtoc_idx]? IS_A Cleanup OR scoped[rtoc_idx]? IS_A ErrCleanup)) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !((CAST((emittable__name(UNWRAP (scoped[rtoc_idx]))) AS String) == _)) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF emittable__cleanup_entry(UNWRAP (scoped[rtoc_idx])) EXISTS AS MUTABLE scoped_entry THEN
        cleanupEntry__mark_moved_guard_mut(&scoped_entry);
      END
      self.state.function_state.guarded_cleanup_names[COPY _] = TRUE;
      &self.state.function_state.lowered_guarded_cleanup_names.insert(COPY _);
    rtoc_idx = rtoc_idx + 1;
    END
    END
    MUTABLE transfer_marks: []Emittable = List[];
    FOR _ IN (alloc_names |> WHERE result_names.contains?(_)) DO
      FOR transfer_mark IN TRY (mIR__ownership_transfer_marks(_, :block_result, alloc_by_name[_], mIRLowering__pipeline_guarded_cleanup_name?(&self, _))) DO
        &transfer_marks.append(COPY transfer_mark);
      END
    END
    MUTABLE block = MIRBlockExpr{ label: COPY label, body: COPY ((scoped + transfer_marks) + [Emittable{ BreakStmt: COPY BreakStmt{ label: COPY label, value: COPY result, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }]), lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
    block.lazy_boundary = TRUE;
    IF (TRUE AND emittable__result_type(result)) THEN
      block.result_type = TRY (type__new( CAST(emittable__result_type(result) AS TypeConstructionInput)));
    END
    RETURN Emittable{ MIRBlockExpr: COPY block };
END
PUB FN mIRLowering__lower_head(MUTABLE self: MIRLowering, blk: FN() -> ?Emittable) RETURNS Tuple<?Emittable, []Emittable> ->
    MUTABLE prev = COPY mIRLowering__function_state(&self).pending_stmts;
    self.state.function_state.pending_stmts = List[];
    MUTABLE result:? = blk();
    MUTABLE produced = COPY mIRLowering__function_state(&self).pending_stmts;
    self.state.function_state.pending_stmts = prev;
    RETURN Tuple{result, produced};
END
PRIVATE FN mIRLowering__with_pending(self: MIRLowering, pending_value: []Emittable, node: Emittable) RETURNS Emittable ->
    IF (pending_value.length() == 0) THEN
      RETURN COPY node;
    ELSE
      RETURN Emittable{ ScopeBlock: COPY ScopeBlock{ body: COPY (pending_value + [node]), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
END
PRIVATE FN mIRLowering__descend(MUTABLE self: MIRLowering, parent: BinaryOp, field: String@symbol) RETURNS !Void ->
    MUTABLE child_branch_value: ?Locatable = NIL;
    PARTIAL MATCH field START
      :left ->
      child_branch_value = COPY parent.left;,
      :right ->
      child_branch_value = COPY parent.right;,
      DEFAULT ->
      panic("unknown BinaryOp field {}");
    END
    MUTABLE child: Locatable = child_branch_value?;
    IF (TRUE AND binaryOp__lazy_fields(parent).contains?(field)) THEN
      TRY (mIRLowering__lower_scoped(&self, %() USE(child, MUTABLE self) -> {
    MUTABLE rtoc_lambda_result_250: Emittable = UNWRAP (TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(child))));
    rtoc_lambda_result_250
      }));
    ELSE
      TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(child)));
    END
END
PRIVATE FN mIRLowering__hoist_lazy_alloc_result(MUTABLE self: MIRLowering, MUTABLE expr: Emittable, ast_node: Locatable) RETURNS !Emittable ->
    IF !(TRY (mIRLowering__mir_allocates?(&self, expr))) THEN
      RETURN COPY expr;
    END
    MUTABLE name = "__tmp_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_251 = mIRLowering__lowering_counters(&self);
    mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_251)) }}";
    MUTABLE ti: ?Type = TRY (mIRLowering__alloc_mark_type_info(&self, expr, ast_node, "lazy allocating expression"));
    MUTABLE alloc = (mIRLowering__mir_owned_alloc(&self, expr) OR_ELSE :heap);
    MUTABLE materialized = BindingMaterialization{ name: COPY name, expr: COPY expr, alloc: COPY alloc, type_info: CAST(COPY ti AS Type), mutable: FALSE, annotation: NIL, suppression: NIL, cleanup_entry: NIL, cleanup_mode: :normal, scope: NIL, ownership_tracked: TRUE };
    FOR materialized_stmt IN TRY (bindingMaterialization__statements(materialized)) DO
      &self.state.function_state.pending_stmts.append(COPY materialized_stmt);
    END
    &self.state.function_state.lowered_alloc_names.insert(name);
    TRY (mIRLowering__stamp_allocating_result_target_mut(&self, &expr, name, alloc));
    RETURN Emittable{ Ident: COPY Ident{ name: COPY name, lowered_node_id: NIL, ownership_consumption: NIL } };
END
PRIVATE FN mIRLowering__mir_produces_owned_result?(MUTABLE self: MIRLowering, node: ?Emittable) RETURNS !Bool ->
    IF node EXISTS AS node_value THEN
      IF TRY (ownershipEffect__hoistable_owned_result?(node_value)) THEN
        RETURN TRUE;
      END
      IF node_value IS_A Call AS call THEN
        RETURN TRY (mIRLowering__owned_call_result_requires_cleanup?(&self, call));
      END
      IF node_value IS_A MIRBgBlock AS mir_bg_block THEN
        RETURN TRUE;
      END
      RETURN FALSE;
    ELSE
      RETURN FALSE;
    END
END
PRIVATE FN mIRLowering__owned_call_result_requires_cleanup?(MUTABLE self: MIRLowering, call: Call) RETURNS !Bool ->
    IF !(call__owned_return?(call)) THEN
      RETURN FALSE;
    END
    MUTABLE raw_type:? = (IF call.result_type != NIL THEN call.result_type ELSE { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_252 = call.callable_contract?.signature;
    functionSignature__return_type( UNWRAP (rtoc_local_receiver_252)) } END);
    IF !(raw_type) THEN
      RETURN TRUE;
    END
    MUTABLE ti = TRY (type__new( TypeConstructionInput{ Type: raw_type }));
    ti = TRY (type__success_type(ti));
    RETURN (((((((((TRY (type__string?(ti)) OR type__collection?(ti)) OR TRY (type__collection_value?(ti))) OR TRY (type__recursive_cleanup_shape?(ti, mIRLowering__mir_schema_lookup(&self)))) OR TRY (type__needs_cleanup?(ti, mIRLowering__mir_schema_lookup(&self)))) OR TRY (type__heap_ptr?(ti))) OR type__indirect?(ti)) OR TRY (type__any_rc?(ti))) OR type__any_sync?(ti)) OR type__resource?(ti));
END
PRIVATE FN mIRLowering__mir_allocates?(MUTABLE self: MIRLowering, node: ?Emittable) RETURNS !Bool
  EFFECTS REENTRANT ->
    IF node EXISTS AS node_value THEN
      IF TRY (mIRLowering__mir_produces_owned_result?(&self, node_value)) THEN
        RETURN TRUE;
      END
      IF !(TRUE) THEN
        RETURN FALSE;
      END
      RETURN emittable__child_exprs(node_value) |> ANY TRY (mIRLowering__mir_allocates?(&self, _));
    ELSE
      RETURN FALSE;
    END
END
PRIVATE FN mIRLowering__node_store_create_call?(self: MIRLowering, node: ?Emittable) RETURNS Bool
  EFFECTS REENTRANT ->
    IF node EXISTS AS node_value THEN
      IF (IF node_value IS_A MIRMethodCall AS mir_method_call THEN (mir_method_call.method == "createBound") ELSE FALSE END) THEN
        RETURN TRUE;
      END
      IF !(TRUE) THEN
        RETURN FALSE;
      END
      RETURN emittable__child_exprs(node_value) |> ANY mIRLowering__node_store_create_call?(self, _);
    ELSE
      RETURN FALSE;
    END
END
PRIVATE FN mIRLowering__hoist_evaluation_barrier(MUTABLE self: MIRLowering, expr: Emittable) RETURNS Ident ->
    MUTABLE name = "__eval_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_253 = mIRLowering__lowering_counters(&self);
    mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_253)) }}";
    &self.state.function_state.pending_stmts.append(CAST(Let{ name: COPY name, init: COPY expr, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } AS Emittable));
    RETURN Ident{ name: COPY name, lowered_node_id: NIL, ownership_consumption: NIL };
END
PRIVATE FN mIRLowering__mutating_receiver_allocator_op?(self: MIRLowering, node: ?Emittable) RETURNS Bool
  EFFECTS REENTRANT ->
    IF node? IS_A ShardedMapPut AS sharded_map_put THEN
      RETURN (shardedMapPut__mutating_receiver_allocator_op?(sharded_map_put) == TRUE);
    ELSE
      RETURN FALSE;
    END
END
PRIVATE FN mIRLowering__each_mir_expr_child(self: MIRLowering, node: Emittable, blk: FN(Emittable) -> Void) RETURNS !Void ->
    FOR rtoc_child IN TRY (emittable__expr_children(node)) DO
    mIRLowering__each_mir_expr_in_value(self, rtoc_child, blk);
    END
    NIL;
END
PRIVATE FN mIRLowering__each_mir_expr_in_value<T>(self: MIRLowering, value: T, blk: FN(Emittable) -> Void) RETURNS Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    COMPTIME IF T IS_A []@multiowned Any THEN
      FOR _ IN value DO
      mIRLowering__each_mir_expr_in_value(rtoc_self_view, _, blk);
      END
    ELSE_IF T IS_A {}Any THEN
      FOR _ IN value.values() DO
      mIRLowering__each_mir_expr_in_value(rtoc_self_view, _, blk);
      END
    ELSE_IF T IS_A Emittable THEN
      IF mIRLowering__mir_expr_child?(rtoc_self_view, CAST(value AS ?Emittable)) THEN
        blk( CAST(value AS Emittable));
      END
    END
    NIL;
}
END
PRIVATE FN mIRLowering__mir_expr_child?(self: MIRLowering, value: ?Emittable) RETURNS Bool ->
    IF value EXISTS AS value_expr THEN
      RETURN emittable__expr?(value_expr);
    END
    RETURN FALSE;
END
PRIVATE FN mIRLowering__hoist_alloc(MUTABLE self: MIRLowering, MUTABLE expr: Emittable, MUTABLE ast_node: ?Locatable = NIL, err_cleanup: ?Bool = FALSE, mutable_value: Bool = FALSE, transfer_on_success: Bool = TRUE, ownership_materialization_alloc: ?String@symbol = NIL, alloc: ?String@symbol = NIL) RETURNS !Emittable ->
    IF (IF expr IS_A MIRBlockExpr AS MUTABLE mir_block_expr THEN blockExpr__lazy_boundary(mir_block_expr) ELSE FALSE END) THEN
      RETURN COPY expr;
    END
    MUTABLE composite_materialization: ?OwnedCompositeMaterialization = TRY (mIRLowering__owned_composite_transfer_materialization(&self, expr, ast_node, ownership_materialization_alloc));
    IF emittable__expr?(expr) THEN
      self.state.function_state.pending_stmts = ruby_array_concat_Stmt(mIRLowering__function_state(&self).pending_stmts, CAST(TRY (mIRLowering__normalize_allocating_result_expr_mut(&self, &expr, (err_cleanup == TRUE), (TRY (ownershipEffect__of(expr))).produces_owned)) AS []Emittable));
    END
    MUTABLE union_return_needs_hoist = ((ast_node != NIL) AND TRY (mIRLowering__call_union_return_needs_hoist?(&self, expr, ast_node)));
    IF !(((TRY (mIRLowering__mir_produces_owned_result?(&self, expr)) OR union_return_needs_hoist) OR composite_materialization)) THEN
      RETURN COPY expr;
    END
    MUTABLE plan = TRY (mIRLowering__allocating_hoist_plan(&self, expr, mutable_value, (err_cleanup == TRUE), (composite_materialization?.type_info OR_ELSE TRY (mIRLowering__alloc_mark_type_info(&self, expr, UNWRAP (ast_node), "MIR allocating hoist"))), (IF (IF composite_materialization != NIL THEN
      TRY (ownedCompositeMaterialization__cleanup_entry(composite_materialization))
    ELSE
      NIL
    END) != NIL THEN (IF composite_materialization != NIL THEN
      TRY (ownedCompositeMaterialization__cleanup_entry(composite_materialization))
    ELSE
      NIL
    END) ELSE TRY (mIRLowering__hoist_cleanup_entry(&self, expr, ast_node)) END), (ruby_wrap_optional_string_to_symbol__mir_lowering(composite_materialization?.alloc) OR_ELSE alloc)));
    TRY (mIRLowering__stamp_allocating_result_target_mut(&self, &expr, plan.name, plan.alloc));
    self.state.function_state.pending_stmts = ruby_array_concat_Stmt(mIRLowering__function_state(&self).pending_stmts, TRY (bindingMaterialization__statements(plan)));
    mIRLowering__record_hoisted_allocation_mut(&self, plan);
    RETURN Emittable{ Ident: COPY Ident{ name: COPY plan.name, lowered_node_id: NIL, ownership_consumption: NIL } };
END
PRIVATE FN mIRLowering__owned_composite_transfer_materialization(MUTABLE self: MIRLowering, expr: Emittable, ast_node: ?Locatable, sink_alloc: ?String@symbol) RETURNS !?OwnedCompositeMaterialization ->
    IF sink_alloc EXISTS AS sink_alloc_value THEN
      IF ast_node THEN
        IF !(((expr IS_A StructInit OR expr IS_A ArrayInit) OR expr IS_A TupleLiteral)) THEN
          RETURN NIL;
        END
        MUTABLE type_info: ?Type = TRY (type__from_node_mut(ast_node, "owned composite argument materialization"));
        type_info = TRY (type__success_type( UNWRAP (type_info)));
        MUTABLE lifecycle_plan = COPY TRY (lifecycleRegistry__fetch(mIRLowering__lifecycle_registry(&self), UNWRAP (type_info)));
        IF !(lifecyclePlan__needs_drop?(lifecycle_plan)) THEN
          RETURN NIL;
        END
        RETURN OwnedCompositeMaterialization{ type_info: UNWRAP (COPY type_info), lifecycle_plan: COPY lifecycle_plan, alloc: COPY TRY (mIRLowering__composite_materialization_alloc(&self, UNWRAP (type_info), sink_alloc_value)) };
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
END
PRIVATE FN mIRLowering__composite_materialization_alloc(MUTABLE self: MIRLowering, type_info: Type, sink_alloc: String@symbol) RETURNS !String@symbol ->
    MUTABLE inherited: ?CleanupEntry@multiowned = TRY (cleanupClassifier__owned_value_entry(type_info, mIRLowering__mir_schema_lookup(&self)));
    IF inherited EXISTS AS inherited_value THEN
      IF cleanupEntry__fixed_alloc?(inherited_value) THEN
        RETURN cleanupEntry__alloc(inherited_value);
      ELSE
        RETURN sink_alloc;
      END
    ELSE
      RETURN sink_alloc;
    END
END
PRIVATE FN mIRLowering__mir_alloc_mark_type_info(MUTABLE self: MIRLowering, mir: Emittable, ast_node: ?Locatable = NIL, context: String = "MIR allocation") RETURNS !Type
  EFFECTS REENTRANT ->
    IF ast_node EXISTS AS ast_node_value THEN
      RETURN CAST(TRY (mIRLowering__alloc_mark_type_info(&self, mir, ast_node_value, context)) AS Type);
    END
    MUTABLE explicit_type: ?Type@multiowned = TRY (mIRLowering__mir_explicit_result_type(self, mir));
    IF explicit_type EXISTS AS explicit_type_value THEN
      RETURN CAST(explicit_type_value AS Type);
    END
    MUTABLE alloc = (mIRLowering__mir_owned_alloc(&self, mir) OR_ELSE :heap);
    IF mir IS_A DupeSlice AS dupe_slice THEN
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :String }, NIL, NIL, NIL, alloc));
    ELSE_IF mir IS_A ConcatStr AS concat_str THEN
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :String }, NIL, NIL, NIL, alloc));
    ELSE_IF mir IS_A AllocSlice AS alloc_slice THEN
      RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY "${alloc_slice.elem_type}[]" }, NIL, NIL, NIL, alloc));
    ELSE_IF mir IS_A OwnedSlice AS owned_slice THEN
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :Slice }, NIL, NIL, NIL, alloc));
    ELSE_IF mir IS_A MakeList AS make_list THEN
      RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY "${make_list.elem_type}[]" }, NIL, NIL, NIL, alloc, :list));
    ELSE_IF mir IS_A HeapCreate AS heap_create THEN
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol(heap_create.zig_type.deletePrefix("*")) }, NIL, NIL, :indirect));
    ELSE_IF mir IS_A ContainerInit AS container_init THEN
      RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY container_init.zig_type }, NIL, NIL, NIL, alloc));
    ELSE_IF mir IS_A StructInit AS struct_init THEN
      IF !(struct_init.zig_type) THEN
        panic("{}: allocating anonymous MIR::StructInit has no result type");
      END
      RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY CAST(struct_init.zig_type AS String) }, NIL, NIL, NIL, alloc));
    ELSE_IF mir IS_A DeepCopy AS deep_copy THEN
      IF deep_copy.type_info THEN
        RETURN TRY (type__new(TypeConstructionInput{ Type: COPY UNWRAP (deep_copy.type_info) }, NIL, NIL, NIL, alloc));
      ELSE
        RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY TRY (mIRLowering__deep_copy_zig_type(self, deep_copy, NIL)) }, NIL, NIL, NIL, alloc));
      END
    ELSE_IF mir IS_A CapWrap AS cap_wrap THEN
      MUTABLE wrapped = (cap_wrap.sync_type OR_ELSE cap_wrap.zig_base);
      MUTABLE ownership:? = PARTIAL MATCH cap_wrap.own_fn START
        "rcCreate" -> :multiowned,
        "arcCreate" -> :shared,
        DEFAULT -> NIL
      END;
      RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY wrapped }, ownership, NIL, IF (IF cap_wrap.sync_fn != NIL THEN cap_wrap.sync_fn ELSE cap_wrap.own_fn END) THEN
        :indirect
      ELSE
        NIL
      END, alloc));
    ELSE_IF mir IS_A SharePromote AS share_promote THEN
      RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY share_promote.zig_base }, :shared, NIL, NIL, :heap));
    ELSE_IF mir IS_A WeakUpgrade AS weak_upgrade THEN
      RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY CAST(weak_upgrade.zig_base AS String) }, :shared, NIL, NIL, :heap));
    ELSE_IF mir IS_A RcRetain AS rc_retain THEN
      RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY CAST(rc_retain.zig_base AS String) }, :multiowned, NIL, NIL, :heap));
    ELSE_IF mir IS_A RcDowngrade AS rc_downgrade THEN
      RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY CAST(rc_downgrade.zig_base AS String) }, :multiowned, NIL, NIL, :heap));
    ELSE_IF mir IS_A FreezeExpr AS freeze_expr THEN
      RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY freeze_expr.zig_base }, :multiowned, NIL, NIL, :heap));
    ELSE_IF mir IS_A MonomorphicKeep AS monomorphic_keep THEN
      RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY CAST(monomorphic_keep.zig_base AS String) }, :multiowned, NIL, NIL, :heap));
    ELSE_IF mir IS_A MIRCast AS mir_cast THEN
      RETURN CAST(mIRLowering__mir_alloc_mark_type_info(&self, cast__expr(mir_cast), NIL, context) AS Type);
    ELSE_IF mir IS_A TryExpr AS try_expr THEN
      RETURN CAST(mIRLowering__mir_alloc_mark_type_info(&self, tryExpr__expr(try_expr), NIL, context) AS Type);
    ELSE_IF mir IS_A TryOptional AS try_optional THEN
      RETURN CAST(mIRLowering__mir_alloc_mark_type_info(&self, tryOptional__expr(try_optional), NIL, context) AS Type);
    ELSE_IF mir IS_A MIROptionalUnwrap AS mir_optional_unwrap THEN
      RETURN CAST(mIRLowering__mir_alloc_mark_type_info(&self, optionalUnwrap__expr(mir_optional_unwrap), NIL, context) AS Type);
    ELSE_IF mir IS_A Call AS call THEN
      panic("{}: allocating {} has no callable return type");
    ELSE_IF mir IS_A MIRMethodCall AS mir_method_call THEN
      panic("{}: allocating {} has no callable return type");
    ELSE_IF mir IS_A TailCall AS tail_call THEN
      panic("{}: allocating {} has no callable return type");
    ELSE_IF mir IS_A InlineBc AS inline_bc THEN
      panic("{}: allocating {} has no typed stdlib return");
    ELSE_IF mir IS_A MIRBgBlock AS mir_bg_block THEN
      panic("{}: allocating MIR::BgBlock has no result type");
    ELSE_IF mir IS_A Pipeline AS pipeline THEN
      IF pipeline.ast_node THEN
        RETURN TRY (type__from_node_mut(pipeline.ast_node, context));
      ELSE_IF TRY (mIRLowering__mir_allocates?(&self, pipeline.inner)) THEN
        RETURN CAST(mIRLowering__mir_alloc_mark_type_info(&self, pipeline.inner, NIL, context) AS Type);
      ELSE
        panic("{}: allocating MIR::Pipeline has no typed result");
      END
    ELSE_IF mir IS_A TryCatch AS try_catch THEN
      panic("{}: allocating MIR::TryCatch has no result type");
    ELSE_IF mir IS_A MIRBlockExpr AS mir_block_expr THEN
      MUTABLE inferred: ?Type@multiowned = TRY (mIRLowering__block_expr_result_type(self, mir_block_expr));
      IF inferred EXISTS AS inferred_value THEN
        RETURN CAST(inferred_value AS Type);
      END
      MUTABLE effect = TRY (ownershipEffect__of(Emittable{ MIRBlockExpr: COPY mir_block_expr }));
      IF (effect.cleanup_kind == :heap_string) THEN
        RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :String }, NIL, NIL, NIL, (effect.alloc OR_ELSE alloc)));
      END
      panic("{}: allocating MIR::BlockExpr has no result type");
    ELSE_IF mir IS_A Orelse AS orelse THEN
      panic("{}: allocating {} has no typed allocation result");
    ELSE_IF mir IS_A IfOptional AS if_optional THEN
      panic("{}: allocating {} has no typed allocation result");
    ELSE
      panic("{}: unhandled allocating MIR node {}");
    END
END
PRIVATE FN mIRLowering__mir_explicit_result_type(self: MIRLowering, mir: Emittable) RETURNS !?Type ->
    MUTABLE raw_type: ?TypeConstructionInput = NIL;
    IF emittable__result_type(mir) EXISTS AS result_type_value THEN
      raw_type = TypeConstructionInput{ Type: COPY result_type_value };
    ELSE_IF (emittable__responds_to_return_type?(mir) AND (emittable__return_type(mir) EXISTS)) THEN
      raw_type = emittable__return_type(mir);
    ELSE_IF emittable__callable_contract(mir) EXISTS AS contract THEN
      raw_type = TypeConstructionInput{ Type: COPY functionSignature__return_type(contract.signature) };
    ELSE_IF (mir IS_A RegistryCall OR mir IS_A InlineBc) THEN
      IF emittable__stdlib_def(mir) EXISTS AS stdlib_signature THEN
        raw_type = TypeConstructionInput{ Type: COPY functionSignature__return_type(stdlib_signature) };
      END
    ELSE_IF mir IS_A Pipeline AS pipeline THEN
      raw_type = TypeConstructionInput{ Type: COPY TRY (type__from_node_mut(pipeline.ast_node, "pipeline cleanup result")) };
    END
    IF raw_type EXISTS AS raw_type_value THEN
      RETURN TRY (type__new(raw_type_value));
    END
    RETURN NIL;
END
PRIVATE FN mIRLowering__block_expr_result_type(self: MIRLowering, mir: MIRBlockExpr) RETURNS !?Type ->
    MUTABLE marks: []AllocMark = List[];
    MUTABLE body = COPY mir.body;
    FOR _ IN body DO
    IF _ IS_A AllocMark THEN
      &marks.append(COPY _);
    END
    END
    MUTABLE value: ?Emittable = NIL;
    MUTABLE break_idx = body.length() - 1;
    WHILE break_idx >= 0 DO
      IF body[break_idx] EXISTS AS body_stmt THEN
        IF body_stmt IS_A BreakStmt AS break_stmt THEN
          value = COPY break_stmt.value;
          break_idx = -1;
        END
      END
      break_idx = break_idx - 1;
    END
    IF value IS_A StructInit AS struct_init THEN
      RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY (struct_init.zig_type OR_ELSE "") }));
    END
    IF value IS_A Ident AS value_ident THEN
      MUTABLE init: ?Emittable = NIL;
      FOR body_stmt IN body DO
        IF body_stmt IS_A Let AS let_stmt THEN
          IF (CAST(let_stmt.name AS String) == CAST(value_ident.name AS String)) THEN
            init = COPY let_stmt.init;
          END
        END
      END
      IF init EXISTS AS init_value THEN
        IF init_value IS_A StructInit AS init_struct THEN
          RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY (init_struct.zig_type OR_ELSE "") }));
        END
        IF init_value IS_A ContainerInit AS init_container THEN
          RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY init_container.zig_type }));
        END
      END
      MUTABLE mark: ?AllocMark = marks |> FIND (_.name == CAST(value_ident.name AS String));
      IF mark EXISTS AS mark_value THEN
        RETURN TRY (type__new(TypeConstructionInput{ Type: COPY mark_value.type_info }));
      END
    END
    MUTABLE typed_marks = marks |> SELECT TRY (type__new(TypeConstructionInput{ Type: COPY _.type_info }));
    IF (typed_marks.length() == 1) THEN
      RETURN COPY typed_marks.first();
    END
    RETURN NIL;
END
PRIVATE FN mIRLowering__hoist_normalized_alloc_expr(MUTABLE self: MIRLowering, MUTABLE expr: Emittable, transfer_on_success: Bool = FALSE, type_info: ?Type = NIL, cleanup_entry: ?CleanupEntry = NIL) RETURNS !Tuple<[]Emittable, Ident> ->
    MUTABLE plan = TRY (mIRLowering__allocating_hoist_plan(&self, expr, FALSE, transfer_on_success, (type_info OR_ELSE TRY (mIRLowering__mir_alloc_mark_type_info(&self, expr, NIL, "normalized MIR allocation"))), (IF cleanup_entry != NIL THEN cleanup_entry ELSE TRY (mIRLowering__hoist_cleanup_entry(&self, expr, NIL)) END)));
    TRY (mIRLowering__stamp_allocating_result_target_mut(&self, &expr, plan.name, plan.alloc));
    mIRLowering__record_hoisted_allocation_mut(&self, plan);
    RETURN CAST(Tuple{TRY (bindingMaterialization__statements(plan)), Ident{ name: COPY plan.name, lowered_node_id: NIL, ownership_consumption: NIL }} AS Tuple<[]Emittable, Ident>);
END
PRIVATE FN mIRLowering__allocating_hoist_plan(MUTABLE self: MIRLowering, expr: Emittable, mutable_value: Bool, transfer_on_success: Bool, type_info: Type, cleanup_entry: ?CleanupEntry, alloc: ?String@symbol = NIL) RETURNS !BindingMaterialization ->
    MUTABLE tmp_id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_259 = mIRLowering__lowering_counters(&self);
    mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_259) };
    MUTABLE chosen_alloc: String@symbol = ((alloc OR_ELSE TRY (mIRLowering__mir_owned_alloc(&self, expr))) OR_ELSE :heap);
    MUTABLE entry: ?CleanupEntry@multiowned = cleanup_entry;
    IF entry EXISTS AS entry_value THEN
      MUTABLE entry_value_mutable = COPY entry_value;
      IF transfer_on_success THEN
        cleanupEntry__mark_moved_guard_mut(&entry_value_mutable);
      ELSE
        cleanupEntry__clear_moved_guard_mut(&entry_value_mutable);
      END
      # The AllocMark above fixes this temp's allocator, and a binding has
      # exactly one (INV-1). A recipe inherited from the expression may name a
      # different one -- a heap String recipe for a frame-placed element view.
      entry = cleanupEntry__with_alloc(entry_value_mutable, chosen_alloc);
    END
    RETURN BindingMaterialization{ name: "__tmp_${mIRLoweringGeneratedId__to_s(tmp_id)}", expr: COPY expr, alloc: COPY chosen_alloc, type_info: COPY type_info, mutable: mutable_value, cleanup_entry: entry, cleanup_mode: IF transfer_on_success THEN
      :err
    ELSE
      :normal
    END, annotation: NIL, suppression: NIL, scope: NIL, ownership_tracked: TRUE };
END
PRIVATE FN mIRLowering__record_hoisted_allocation_mut(MUTABLE self: MIRLowering, plan: BindingMaterialization) RETURNS Void ->
    &self.state.function_state.lowered_alloc_names.insert(COPY plan.name);
    MUTABLE entry: ?CleanupEntry@multiowned = COPY plan.cleanup_entry;
    IF !((IF entry != NIL THEN
      cleanupEntry__has_moved_guard?(entry)
    ELSE
      NIL
    END)) THEN
      RETURN;
    END
    MUTABLE rtoc_index_receiver_260 = mIRLowering__function_state(&self).guarded_cleanup_names;
    rtoc_index_receiver_260[plan.name] = TRUE;
    &self.state.function_state.lowered_guarded_cleanup_names.insert(COPY plan.name);
END
PRIVATE FN mIRLowering__hoist_normalized_value_expr(MUTABLE self: MIRLowering, expr: Emittable) RETURNS Tuple<[]Emittable, Ident> ->
    MUTABLE name = "__tmp_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_261 = mIRLowering__lowering_counters(&self);
    mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_261)) }}";
    RETURN CAST(Tuple{[Let{ name: COPY name, init: COPY expr, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }], Ident{ name: COPY name, lowered_node_id: NIL, ownership_consumption: NIL }} AS Tuple<[]Emittable, Ident>);
END
PRIVATE FN mIRLowering__consumes_owned_children?(self: MIRLowering, node: Emittable) RETURNS Bool ->
    RETURN (emittable__ownership_consumption(node) != NIL);
END
PRIVATE FN mIRLowering__normalize_allocating_mir_body(MUTABLE self: MIRLowering, body: []Emittable) RETURNS ![]Emittable ->
    MUTABLE out: []Emittable = List[];
    FOR MUTABLE rtoc_mutable_block_param_263 IN body DO
    MUTABLE prefix = TRY (mIRLowering__normalize_allocating_mir_stmt_mut(&self, &rtoc_mutable_block_param_263));
    out = ruby_array_concat_Emittable__mir_lowering(out, prefix);
    &out.append(COPY rtoc_mutable_block_param_263);
    END
    RETURN out;
END
PRIVATE FN mIRLowering__normalize_allocating_mir_stmt_mut(MUTABLE self: MIRLowering, MUTABLE stmt: Emittable) RETURNS ![]Emittable
  EFFECTS REENTRANT ->
    MUTABLE prefix: []Emittable = List[];
    IF stmt IS_A Let AS MUTABLE let THEN
      prefix = ruby_array_concat_Emittable__mir_lowering(prefix, TRY (mIRLowering__normalize_allocating_result_expr_mut(&self, &let.init, FALSE, TRUE)));
    ELSE_IF stmt IS_A Set AS MUTABLE set THEN
      prefix = ruby_array_concat_Emittable__mir_lowering(prefix, TRY (mIRLowering__normalize_used_expr_attr_mut(&self, Emittable{ Set: COPY set }, :target)));
      prefix = ruby_array_concat_Emittable__mir_lowering(prefix, TRY (mIRLowering__normalize_allocating_result_expr_mut(&self, &set.value)));
    ELSE_IF stmt IS_A ReassignWithCleanup AS reassign_with_cleanup THEN
      IF !(mIRLowering__fallible_self_fallback_reassign?(self, CAST(reassign_with_cleanup.name AS String), reassign_with_cleanup.value)) THEN
        prefix = ruby_array_concat_Emittable__mir_lowering(prefix, TRY (mIRLowering__normalize_used_expr_attr_mut(&self, Emittable{ ReassignWithCleanup: COPY reassign_with_cleanup }, :value)));
      END
    ELSE_IF stmt IS_A ExprStmt AS expr_stmt THEN
      IF TRY (mIRLowering__mir_produces_owned_result?(&self, exprStmt__expr(expr_stmt))) THEN
        prefix = ruby_array_concat_Emittable__mir_lowering(prefix, TRY (mIRLowering__normalize_used_expr_attr_mut(&self, Emittable{ ExprStmt: COPY expr_stmt }, :expr)));
      ELSE
        prefix = ruby_array_concat_Emittable__mir_lowering(prefix, TRY (mIRLowering__normalize_allocating_result_expr_mut(&self, exprStmt__expr(expr_stmt))));
      END
    ELSE_IF stmt IS_A ReturnStmt AS return_stmt THEN
      prefix = ruby_array_concat_Emittable__mir_lowering(prefix, TRY (mIRLowering__normalize_used_expr_attr_mut(&self, Emittable{ ReturnStmt: COPY return_stmt }, :value, TRUE)));
    ELSE_IF stmt IS_A BreakStmt AS break_stmt THEN
      prefix = ruby_array_concat_Emittable__mir_lowering(prefix, TRY (mIRLowering__normalize_used_expr_attr_mut(&self, Emittable{ BreakStmt: COPY break_stmt }, :value, TRUE)));
    ELSE_IF stmt IS_A IfStmt AS if_stmt THEN
      prefix = ruby_array_concat_Emittable__mir_lowering(prefix, TRY (mIRLowering__normalize_used_expr_attr_mut(&self, Emittable{ IfStmt: COPY if_stmt }, :cond)));
    ELSE_IF stmt IS_A IfBindStmt AS if_bind_stmt THEN
      MUTABLE if_bind_stmt_mutable = COPY if_bind_stmt;
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < if_bind_stmt_mutable.bindings.length() DO
      MUTABLE binding = UNWRAP (if_bind_stmt_mutable.bindings[rtoc_idx]);
      MUTABLE expr = COPY binding.expr;
      MUTABLE capture = mirCapture__to_s(binding.capture);
      MUTABLE capture_cleanup: ?Emittable = if_bind_stmt_mutable.then_body |> FIND ((_ IS_A Cleanup) AND (CAST(emittable__name(_) AS String) == capture));
      MUTABLE expr_prefix, normalized = TRY (mIRLowering__normalize_allocating_used_expr(&self, &expr, ((capture_cleanup != NIL) AND (capture_cleanup IS_A Cleanup))));
      binding.expr = COPY normalized;
      if_bind_stmt_mutable.bindings[rtoc_idx] = COPY binding;
      prefix = ruby_array_concat_Emittable__mir_lowering(prefix, expr_prefix);
      IF !(normalized IS_A Ident) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !(((capture_cleanup != NIL) AND (capture_cleanup IS_A Cleanup))) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF mIRLowering__if_bind_transfer_present?(&self, if_bind_stmt_mutable, CAST(emittable__name(normalized) AS String)) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE target_alloc = cleanupEntry__alloc(UNWRAP (emittable__cleanup_entry(capture_cleanup)));
      MUTABLE then_marks = TRY (mIR__ownership_transfer_marks(CAST(emittable__name(normalized) AS String), :owned_sink, target_alloc, TRUE));
      if_bind_stmt_mutable.then_body = (then_marks + if_bind_stmt_mutable.then_body);
      if_bind_stmt_mutable.else_body = (if_bind_stmt_mutable.else_body OR_ELSE List[]);
      MUTABLE else_marks = TRY (mIR__ownership_transfer_marks(CAST(emittable__name(normalized) AS String), :owned_sink, target_alloc, TRUE));
      if_bind_stmt_mutable.else_body = (else_marks + UNWRAP (if_bind_stmt_mutable.else_body));
    rtoc_idx = rtoc_idx + 1;
      END
    ELSE_IF stmt IS_A WhileStmt AS while_stmt THEN
      MUTABLE while_stmt_mutable = COPY while_stmt;
      IF !(while_stmt_mutable.capture) THEN
        prefix = ruby_array_concat_Emittable__mir_lowering(prefix, TRY (mIRLowering__normalize_used_expr_attr_mut(&self, Emittable{ WhileStmt: COPY while_stmt_mutable }, :cond)));
      END
      IF while_stmt_mutable.update THEN
        prefix = ruby_array_concat_Emittable__mir_lowering(prefix, TRY (mIRLowering__normalize_used_expr_attr_mut(&self, Emittable{ WhileStmt: COPY while_stmt_mutable }, :update)));
      END
    ELSE_IF stmt IS_A ForStmt AS for_stmt THEN
      prefix = ruby_array_concat_Emittable__mir_lowering(prefix, TRY (mIRLowering__normalize_used_expr_attr_mut(&self, Emittable{ ForStmt: COPY for_stmt }, :iter)));
    ELSE_IF stmt IS_A SwitchStmt AS switch_stmt THEN
      prefix = ruby_array_concat_Emittable__mir_lowering(prefix, TRY (mIRLowering__normalize_used_expr_attr_mut(&self, Emittable{ SwitchStmt: COPY switch_stmt }, :subject)));
    ELSE_IF stmt IS_A UnionMatchStmt AS union_match_stmt THEN
      prefix = ruby_array_concat_Emittable__mir_lowering(prefix, TRY (mIRLowering__normalize_used_expr_attr_mut(&self, Emittable{ UnionMatchStmt: COPY union_match_stmt }, :subject)));
    ELSE_IF stmt IS_A IfChain AS if_chain THEN
      MUTABLE if_chain_mutable = COPY if_chain;
      MUTABLE rtoc_branch_idx = 0;
      WHILE rtoc_branch_idx < if_chain_mutable.branches.length() DO
        MUTABLE branch = UNWRAP (if_chain_mutable.branches[rtoc_branch_idx]);
        MUTABLE cond = COPY branch.cond;
        MUTABLE cond_prefix, normalized = TRY (mIRLowering__normalize_allocating_used_expr(&self, &cond));
        branch.cond = COPY normalized;
        if_chain_mutable.branches[rtoc_branch_idx] = COPY branch;
        prefix = ruby_array_concat_Emittable__mir_lowering(prefix, cond_prefix);
        rtoc_branch_idx = rtoc_branch_idx + 1;
      END
    ELSE_IF stmt IS_A MIRDeferStmt AS mir_defer_stmt THEN
      MUTABLE mir_defer_stmt_mutable = COPY mir_defer_stmt;
      MUTABLE defer_body = deferStmt__body(mir_defer_stmt_mutable);
      IF defer_body IS_A []Emittable AS array THEN
        mir_defer_stmt_mutable.body = DeferBody{ ArrayValue: COPY TRY (mIRLowering__normalize_allocating_mir_body(&self, array)) };
      ELSE_IF defer_body IS_A Emittable AS defer_stmt_value THEN
        MUTABLE defer_stmt_mutable = COPY defer_stmt_value;
        prefix = ruby_array_concat_Emittable__mir_lowering(prefix, mIRLowering__normalize_allocating_mir_stmt_mut(&self, &defer_stmt_mutable));
      END
    ELSE_IF stmt IS_A ErrDeferStmt AS err_defer_stmt THEN
      MUTABLE err_defer_stmt_mutable = COPY err_defer_stmt;
      MUTABLE defer_body = errDeferStmt__body(err_defer_stmt_mutable);
      IF defer_body IS_A []Emittable AS array THEN
        err_defer_stmt_mutable.body = DeferBody{ ArrayValue: COPY TRY (mIRLowering__normalize_allocating_mir_body(&self, array)) };
      ELSE_IF defer_body IS_A Emittable AS defer_stmt_value THEN
        MUTABLE defer_stmt_mutable = COPY defer_stmt_value;
        prefix = ruby_array_concat_Emittable__mir_lowering(prefix, mIRLowering__normalize_allocating_mir_stmt_mut(&self, &defer_stmt_mutable));
      END
    ELSE_IF stmt IS_A BatchWindowPush AS batch_window_push THEN
      prefix = ruby_array_concat_Emittable__mir_lowering(prefix, TRY (mIRLowering__normalize_used_expr_attr_mut(&self, Emittable{ BatchWindowPush: COPY batch_window_push }, :item_expr)));
      prefix = ruby_array_concat_Emittable__mir_lowering(prefix, TRY (mIRLowering__normalize_used_expr_attr_mut(&self, Emittable{ BatchWindowPush: COPY batch_window_push }, :value_expr)));
    ELSE_IF stmt IS_A BatchWindowFlush AS batch_window_flush THEN
      prefix = ruby_array_concat_Emittable__mir_lowering(prefix, TRY (mIRLowering__normalize_used_expr_attr_mut(&self, Emittable{ BatchWindowFlush: COPY batch_window_flush }, :value_expr)));
    ELSE
      prefix = ruby_array_concat_Emittable__mir_lowering(prefix, TRY (mIRLowering__normalize_stmt_child_exprs_mut(&self, &stmt)));
    END
    RETURN prefix;
END
PRIVATE FN mIRLowering__normalize_stmt_child_exprs_mut(MUTABLE self: MIRLowering, MUTABLE stmt: Emittable) RETURNS ![]Emittable ->
    MUTABLE prefix: []Emittable = List[];
    # The capture binds only inside the branches, so nothing may be hoisted
    # across that boundary -- the rule normalize_allocating_used_expr already
    # applies when the same node is reached as an EXPRESSION. In statement
    # position the branches are ordinary child_exprs, and hoisting a branch's
    # retain out left it reading a capture that does not exist yet.
    IF stmt IS_A IfOptional AS if_optional THEN
      MUTABLE optional_expr = COPY if_optional.optional;
      MUTABLE optional_old = COPY if_optional.optional;
      MUTABLE optional_prefix, optional_normalized = TRY (mIRLowering__normalize_allocating_used_expr(&self, &optional_expr));
      TRY (mIRLowering__replace_mir_expr_child_mut(&self, &stmt, &optional_old, &optional_normalized));
      RETURN COPY optional_prefix;
    END
    mIRLowering__ensure_expr_child_ids_mut(&self, &stmt);
    MUTABLE children = TRY (emittable__child_exprs(stmt));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < children.length() DO
      MUTABLE child = UNWRAP (children[rtoc_idx]);
      MUTABLE child_prefix, normalized = TRY (mIRLowering__normalize_allocating_used_expr(&self, &child));
      TRY (mIRLowering__replace_mir_expr_child_mut(&self, &stmt, UNWRAP (children[rtoc_idx]), &normalized));
      prefix = ruby_array_concat_Emittable__mir_lowering(prefix, child_prefix);
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN prefix;
END
PRIVATE FN mIRLowering__normalize_used_expr_attr_mut(MUTABLE self: MIRLowering, MUTABLE stmt: Emittable, attr: String@symbol, transfer_on_success: Bool = FALSE) RETURNS ![]Emittable ->
    MUTABLE value: ?Emittable = mIRLowering__normalized_expr_attr(self, stmt, attr);
    IF value EXISTS AS MUTABLE value_value THEN
      MUTABLE prefix, normalized = TRY (mIRLowering__normalize_allocating_used_expr(&self, &value_value, transfer_on_success));
      mIRLowering__set_normalized_expr_attr_mut(&self, stmt, attr, normalized);
      RETURN COPY prefix;
    ELSE
      RETURN CAST(List[] AS []Emittable);
    END
END
PRIVATE FN mIRLowering__normalized_expr_attr(self: MIRLowering, stmt: Emittable, attr: String@symbol) RETURNS ?Emittable ->
    IF (attr == :target) THEN
      RETURN COPY castEmittableToSet(stmt).target;
    ELSE_IF (attr == :value) THEN
      IF stmt IS_A ReassignWithCleanup AS reassign_with_cleanup THEN
        RETURN COPY reassign_with_cleanup.value;
      ELSE_IF stmt IS_A ReturnStmt AS return_stmt THEN
        RETURN COPY return_stmt.value;
      ELSE_IF stmt IS_A BreakStmt AS break_stmt THEN
        RETURN COPY break_stmt.value;
      ELSE
        RETURN NIL;
      END
    ELSE_IF (attr == :expr) THEN
      RETURN COPY castEmittableToExprStmt(stmt).expr;
    ELSE_IF (attr == :cond) THEN
      IF stmt IS_A IfStmt AS if_stmt THEN
        RETURN COPY if_stmt.cond;
      ELSE
        RETURN COPY castEmittableToWhileStmt(stmt).cond;
      END
    ELSE_IF (attr == :update) THEN
      RETURN COPY castEmittableToWhileStmt(stmt).update;
    ELSE_IF (attr == :iter) THEN
      RETURN COPY castEmittableToForStmt(stmt).iter;
    ELSE_IF (attr == :subject) THEN
      IF stmt IS_A SwitchStmt AS switch_stmt THEN
        RETURN COPY switch_stmt.subject;
      ELSE
        RETURN COPY castEmittableToUnionMatchStmt(stmt).subject;
      END
    ELSE_IF (attr == :item_expr) THEN
      RETURN COPY castEmittableToBatchWindowPush(stmt).item_expr;
    ELSE_IF (attr == :value_expr) THEN
      IF stmt IS_A BatchWindowPush AS batch_window_push THEN
        RETURN COPY batch_window_push.value_expr;
      ELSE
        RETURN COPY castEmittableToBatchWindowFlush(stmt).value_expr;
      END
    ELSE
      RETURN NIL;
    END
END
PRIVATE FN mIRLowering__set_normalized_expr_attr_mut(MUTABLE self: MIRLowering, stmt: Emittable, attr: String@symbol, value: Emittable) RETURNS Void ->
    IF (attr == :target) THEN
      MUTABLE rtoc_writer_receiver_270: Set = castEmittableToSet(stmt);
      rtoc_writer_receiver_270.target = COPY value;
    ELSE_IF (attr == :value) THEN
      IF stmt IS_A ReassignWithCleanup AS reassign_with_cleanup THEN
        MUTABLE reassign_with_cleanup_mutable = COPY reassign_with_cleanup;
        reassign_with_cleanup_mutable.value = COPY value;
      ELSE_IF stmt IS_A ReturnStmt AS return_stmt THEN
        MUTABLE return_stmt_mutable = COPY return_stmt;
        return_stmt_mutable.value = COPY value;
      ELSE_IF stmt IS_A BreakStmt AS break_stmt THEN
        MUTABLE break_stmt_mutable = COPY break_stmt;
        break_stmt_mutable.value = COPY value;
      END
    ELSE_IF (attr == :expr) THEN
      MUTABLE rtoc_writer_receiver_271: ExprStmt = castEmittableToExprStmt(stmt);
      rtoc_writer_receiver_271.expr = COPY value;
    ELSE_IF (attr == :cond) THEN
      IF stmt IS_A IfStmt AS if_stmt THEN
        MUTABLE if_stmt_mutable = COPY if_stmt;
        if_stmt_mutable.cond = COPY value;
      ELSE
        MUTABLE rtoc_writer_receiver_272: WhileStmt = castEmittableToWhileStmt(stmt);
        rtoc_writer_receiver_272.cond = COPY value;
      END
    ELSE_IF (attr == :update) THEN
      MUTABLE rtoc_writer_receiver_273: WhileStmt = castEmittableToWhileStmt(stmt);
      rtoc_writer_receiver_273.update = COPY value;
    ELSE_IF (attr == :iter) THEN
      MUTABLE rtoc_writer_receiver_274: ForStmt = castEmittableToForStmt(stmt);
      rtoc_writer_receiver_274.iter = COPY value;
    ELSE_IF (attr == :subject) THEN
      IF stmt IS_A SwitchStmt AS switch_stmt THEN
        MUTABLE switch_stmt_mutable = COPY switch_stmt;
        switch_stmt_mutable.subject = COPY value;
      ELSE
        MUTABLE rtoc_writer_receiver_275: UnionMatchStmt = castEmittableToUnionMatchStmt(stmt);
        rtoc_writer_receiver_275.subject = COPY value;
      END
    ELSE_IF (attr == :item_expr) THEN
      MUTABLE rtoc_writer_receiver_276: BatchWindowPush = castEmittableToBatchWindowPush(stmt);
      rtoc_writer_receiver_276.item_expr = COPY value;
    ELSE_IF (attr == :value_expr) THEN
      IF stmt IS_A BatchWindowPush AS batch_window_push THEN
        MUTABLE batch_window_push_mutable = COPY batch_window_push;
        batch_window_push_mutable.value_expr = COPY value;
      ELSE
        MUTABLE rtoc_writer_receiver_277: BatchWindowFlush = castEmittableToBatchWindowFlush(stmt);
        rtoc_writer_receiver_277.value_expr = COPY value;
      END
    END
END
PRIVATE FN mIRLowering__if_bind_transfer_present?(MUTABLE self: MIRLowering, stmt: IfBindStmt, name: String) RETURNS Bool ->
    FOR branch_stmt IN stmt.then_body DO
      IF branch_stmt IS_A TransferMark AS transfer_mark THEN
        IF (transfer_mark.name == name) THEN
          RETURN TRUE;
        END
      END
    END
    IF stmt.else_body EXISTS AS else_body THEN
      FOR branch_stmt IN else_body DO
        IF branch_stmt IS_A TransferMark AS transfer_mark THEN
          IF (transfer_mark.name == name) THEN
            RETURN TRUE;
          END
        END
      END
    END
    RETURN FALSE;
END
PRIVATE FN mIRLowering__normalize_nested_mir_bodies_mut(MUTABLE self: MIRLowering, node: Emittable) RETURNS !Void ->
    FOR MUTABLE rtoc_mutable_block_param_278 IN emittable__body_slots(node) DO
      rtoc_mutable_block_param_278.body = TRY (mIRLowering__normalize_allocating_mir_body(&self, COPY rtoc_mutable_block_param_278.body));
    END
    NIL;
END
PRIVATE FN mIRLowering__normalize_allocating_result_expr_mut(MUTABLE self: MIRLowering, MUTABLE expr: Emittable, transfer_on_success: Bool = FALSE, owned_position: Bool = FALSE) RETURNS ![]Emittable
  EFFECTS REENTRANT ->
    MUTABLE prefix: []Emittable = List[];
    IF !(emittable__expr?(expr)) THEN
      RETURN prefix;
    END
    IF (IF expr IS_A MIRBlockExpr AS mir_block_expr THEN blockExpr__lazy_boundary(mir_block_expr) ELSE FALSE END) THEN
      RETURN prefix;
    END
    IF expr IS_A TryCatch AS try_catch THEN
      RETURN prefix;
    END
    IF expr IS_A IfOptional AS MUTABLE if_optional THEN
      MUTABLE optional_expr = COPY if_optional.optional;
      MUTABLE optional_old = COPY if_optional.optional;
      MUTABLE optional_parent = Emittable{ IfOptional: COPY if_optional };
      MUTABLE optional_prefix, optional_normalized = TRY (mIRLowering__normalize_allocating_used_expr(&self, &optional_expr, FALSE));
      TRY (mIRLowering__replace_mir_expr_child_mut(&self, &optional_parent, &optional_old, &optional_normalized));
      prefix = ruby_array_concat_Emittable__mir_lowering(prefix, optional_prefix);
      RETURN prefix;
    END
    mIRLowering__ensure_expr_child_ids_mut(&self, &expr);
    MUTABLE result_children: []Emittable = (TRY (emittable__ownership_source_exprs(expr)) OR_ELSE List[]);
    MUTABLE owned_sources: [Set]Emittable = (TRY (emittable__owned_position_source_exprs(expr)) OR_ELSE List[]) |> DISTINCT _;
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < result_children.length() DO
      # Every callee below takes its expression MUTABLE, so the element has to
      # be a named local; an index read is a borrow of the list.
      MUTABLE result_child = UNWRAP (result_children[rtoc_idx]);
      MUTABLE result_child_old = UNWRAP (result_children[rtoc_idx]);
      IF (((owned_position OR expr IS_A TryExpr)) AND owned_sources.contains?(result_child)) THEN
          prefix = ruby_array_concat_Emittable__mir_lowering(prefix, TRY (mIRLowering__normalize_allocating_result_expr_mut(&self, &result_child, transfer_on_success, TRUE)));
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF TRY (mIRLowering__mir_produces_owned_result?(&self, result_child)) THEN
          MUTABLE owned_prefix, owned_normalized = TRY (mIRLowering__normalize_allocating_used_expr(&self, &result_child, mIRLowering__consumes_owned_children?(self, expr)));
          TRY (mIRLowering__replace_mir_expr_child_mut(&self, &expr, &result_child_old, &owned_normalized));
          prefix = ruby_array_concat_Emittable__mir_lowering(prefix, owned_prefix);
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF TRY (mIRLowering__mir_allocates?(&self, result_child)) THEN
          prefix = ruby_array_concat_Emittable__mir_lowering(prefix, TRY (mIRLowering__normalize_allocating_result_expr_mut(&self, &result_child, transfer_on_success)));
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE child_prefix, child_normalized = TRY (mIRLowering__normalize_allocating_used_expr(&self, &result_child, mIRLowering__consumes_owned_children?(self, expr)));
      TRY (mIRLowering__replace_mir_expr_child_mut(&self, &expr, &result_child_old, &child_normalized));
      prefix = ruby_array_concat_Emittable__mir_lowering(prefix, child_prefix);
    rtoc_idx = rtoc_idx + 1;
    END
    TRY (mIRLowering__each_mir_expr_child(self, expr, %(child: Emittable) USE(MUTABLE expr, MUTABLE prefix, result_children, MUTABLE self) -> {
    IF result_children |> ANY mir__same_node?(_, child) THEN
        RETURN;
    END
    MUTABLE other_expr = COPY child;
    MUTABLE other_old = COPY child;
    MUTABLE other_prefix, other_normalized = TRY (mIRLowering__normalize_allocating_used_expr(&self, &other_expr, mIRLowering__consumes_owned_children?(self, expr)));
    TRY (mIRLowering__replace_mir_expr_child_mut(&self, &expr, &other_old, &other_normalized));
    prefix = ruby_array_concat_Emittable__mir_lowering(prefix, other_prefix);
    rubyToClearVoid__mir_lowering()
    }));
    RETURN prefix;
END
PRIVATE FN mIRLowering__normalize_allocating_used_expr(MUTABLE self: MIRLowering, MUTABLE expr: Emittable, transfer_on_success: Bool = FALSE) RETURNS !Tuple<[]Emittable, Emittable>
  EFFECTS REENTRANT ->
    MUTABLE hoisted = NIL;
    MUTABLE ident = NIL;
    MUTABLE nested: []Emittable = List[];
    MUTABLE prefix: []Emittable = List[];
    IF !(emittable__expr?(expr)) THEN
      RETURN CAST(Tuple{prefix, COPY expr} AS Tuple<[]Emittable, Emittable>);
    END
    IF expr IS_A Ident AS ident THEN
      RETURN CAST(Tuple{prefix, COPY ident} AS Tuple<[]Emittable, Emittable>);
    END
    IF (IF expr IS_A MIRBlockExpr AS mir_block_expr THEN blockExpr__lazy_boundary(mir_block_expr) ELSE FALSE END) THEN
      RETURN CAST(Tuple{prefix, COPY expr} AS Tuple<[]Emittable, Emittable>);
    END
    IF expr IS_A IfOptional AS MUTABLE if_optional THEN
      MUTABLE optional_expr = COPY if_optional.optional;
      MUTABLE optional_old = COPY if_optional.optional;
      MUTABLE optional_parent = Emittable{ IfOptional: COPY if_optional };
      MUTABLE optional_prefix, optional_normalized = TRY (mIRLowering__normalize_allocating_used_expr(&self, &optional_expr, FALSE));
      TRY (mIRLowering__replace_mir_expr_child_mut(&self, &optional_parent, &optional_old, &optional_normalized));
      prefix = ruby_array_concat_Emittable__mir_lowering(prefix, optional_prefix);
      RETURN CAST(Tuple{prefix, COPY if_optional} AS Tuple<[]Emittable, Emittable>);
    END
    IF (!(mIRLowering__mutating_receiver_allocator_op?(self, expr)) AND TRY (mIRLowering__mir_produces_owned_result?(&self, expr))) THEN
      MUTABLE type_info = TRY (mIRLowering__mir_alloc_mark_type_info(&self, expr, NIL, "normalized MIR allocation"));
      MUTABLE cleanup_entry: ?CleanupEntry@multiowned = TRY (mIRLowering__hoist_cleanup_entry(&self, expr, NIL));
      nested = TRY (mIRLowering__normalize_allocating_result_expr_mut(&self, &expr, transfer_on_success));
      prefix = ruby_array_concat_Emittable__mir_lowering(prefix, nested);
      IF mIRLowering__normalized_alloc_wrapper_alias?(self, expr) THEN
        RETURN CAST(Tuple{prefix, COPY expr} AS Tuple<[]Emittable, Emittable>);
      END
      hoisted, ident = TRY (mIRLowering__hoist_normalized_alloc_expr(&self, &expr, transfer_on_success, CAST(type_info AS ?Type), cleanup_entry));
      prefix = ruby_array_concat_Emittable__mir_lowering(prefix, CAST(hoisted AS []Emittable));
      RETURN CAST(Tuple{prefix, COPY ident} AS Tuple<[]Emittable, Emittable>);
    END
    IF mIRLowering__mir_consumes_owned_operands?(self, &expr) THEN
      nested = TRY (mIRLowering__normalize_allocating_result_expr_mut(&self, &expr, transfer_on_success));
      prefix = ruby_array_concat_Emittable__mir_lowering(prefix, nested);
      hoisted, ident = mIRLowering__hoist_normalized_value_expr(&self, expr);
      prefix = ruby_array_concat_Emittable__mir_lowering(prefix, CAST(hoisted AS []Emittable));
      RETURN CAST(Tuple{prefix, COPY ident} AS Tuple<[]Emittable, Emittable>);
    END
    mIRLowering__ensure_expr_child_ids_mut(&self, &expr);
    TRY (mIRLowering__each_mir_expr_child(self, expr, %(child: Emittable) USE(MUTABLE expr, MUTABLE prefix, MUTABLE self) -> {
    MUTABLE nested_expr = COPY child;
    MUTABLE nested_old = COPY child;
    MUTABLE child_prefix, normalized = TRY (mIRLowering__normalize_allocating_used_expr(&self, &nested_expr, mIRLowering__consumes_owned_children?(self, expr)));
    TRY (mIRLowering__replace_mir_expr_child_mut(&self, &expr, &nested_old, &normalized));
    prefix = ruby_array_concat_Emittable__mir_lowering(prefix, child_prefix);
    rubyToClearVoid__mir_lowering()
    }));
    RETURN CAST(Tuple{prefix, COPY expr} AS Tuple<[]Emittable, Emittable>);
END
PRIVATE FN mIRLowering__normalized_alloc_wrapper_alias?(self: MIRLowering, expr: Emittable) RETURNS Bool ->
    RETURN PARTIAL MATCH expr START
      Emittable.MIRCast AS mir_cast -> cast__expr(mir_cast) IS_A Ident,
      Emittable.MIROptionalUnwrap AS mir_optional_unwrap -> optionalUnwrap__expr(mir_optional_unwrap) IS_A Ident,
      DEFAULT -> FALSE
    END;
END
PRIVATE FN mIRLowering__mir_consumes_owned_operands?(self: MIRLowering, MUTABLE expr: Emittable) RETURNS Bool ->
    MUTABLE contract: ?OwnershipContract@multiowned = mIRLowering__ownership_contract_for_node(self, expr);
    IF !((contract != NIL)) THEN
      RETURN FALSE;
    END
    RETURN contract.operands |> ANY (!(_.borrowed) AND (_.name != NIL));
END
PRIVATE FN mIRLowering__replace_mir_expr_child_mut(MUTABLE self: MIRLowering, MUTABLE parent: Emittable, MUTABLE old_child: Emittable, MUTABLE new_child: Emittable) RETURNS !Void
  EFFECTS REENTRANT ->
    IF mir__same_node?(old_child, new_child) THEN
      RETURN;
    END
    IF !((emittable__mir?(parent) OR_ELSE FALSE)) THEN
      RETURN;
    END
    IF emittable__replace_expr_child(&parent, old_child, new_child) THEN
      TRY (mIRLowering__refresh_ownership_consumption_for_replaced_child_mut(&self, &parent, &old_child, &new_child));
    END
    NIL;
END
PRIVATE FN mIRLowering__replaceable_t_struct?(MUTABLE self: MIRLowering, node: Emittable) RETURNS Bool ->
    RETURN node IS_A RegistryCall;
END
PRIVATE FN mIRLowering__refresh_ownership_consumption_for_replaced_child_mut(MUTABLE self: MIRLowering, MUTABLE parent: Emittable, MUTABLE old_child: Emittable, MUTABLE new_child: Emittable) RETURNS !Void ->
    MUTABLE fact: ?OwnershipConsumptionFact = emittable__ownership_consumption(parent);
    MUTABLE old_names = TRY (mIRLowering__mir_ident_names(self, old_child)) |> DISTINCT _;
    MUTABLE new_names = TRY (mIRLowering__mir_ident_names(self, new_child));
    MUTABLE visible_names = new_names |> WHERE TRY (mIRLowering__owned_binding_visible?(&self, CAST(_ AS String)));
    IF (visible_names.length() == 0) THEN
      RETURN;
    END
    IF !(fact EXISTS) THEN
      IF !(((parent IS_A StructInit OR parent IS_A ArrayInit) OR parent IS_A TupleLiteral)) THEN
        RETURN;
      END
      # Ruby's `visible_names.filter_map { ... }.uniq`. A CLEAR `SELECT:?` keeps
      # the optional in the element type, so the stream cannot be DISTINCTed;
      # the loop drops the absent ones and dedupes in one pass.
      MUTABLE allocs: []String@symbol = List[];
      FOR visible_name IN visible_names DO
        IF (TRY (functionState__bindings(mIRLowering__function_state(&self))))[CAST(visible_name AS String)] EXISTS AS visible_entry THEN
          MUTABLE visible_alloc = cleanupEntry__alloc(visible_entry);
          IF !(allocs.contains?(visible_alloc)) THEN
            &allocs.append(COPY visible_alloc);
          END
        END
      END
      MUTABLE target_alloc: ?String@symbol =     IF (allocs.length() == 1) THEN
        allocs.first()
      ELSE
        (IF (IF TRY (ownershipEffect__alloc_of(old_child)) != NIL THEN TRY (ownershipEffect__alloc_of(old_child)) ELSE TRY (mIRLowering__mir_owned_alloc(&self, new_child)) END) != NIL THEN (IF TRY (ownershipEffect__alloc_of(old_child)) != NIL THEN TRY (ownershipEffect__alloc_of(old_child)) ELSE TRY (mIRLowering__mir_owned_alloc(&self, new_child)) END) ELSE mIRLowering__function_state(&self).current_decl_alloc END)
      END;
      emittable__set_ownership_consumption_mut(&parent, OwnershipConsumptionFact{ operands: COPY visible_names |> SELECT ownershipOperandFact__owned_binding(CAST(_ AS String), TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })), "hoist replacement", target_alloc), target: :owned_sink, target_alloc: COPY target_alloc, source: COPY emittable__variant_name(parent), covers_consuming_params: TRUE });
      RETURN;
    END
    MUTABLE operands = (TRY (callOwnershipFacts__operands( CAST(fact AS CallOwnershipFacts)))) |> WHERE !(((_.name EXISTS) AND old_names.contains?(CAST(((_.name)?) AS String))));
    FOR _ IN visible_names DO
    &operands.append(ownershipOperandFact__owned_binding(CAST(_ AS String), TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })), "hoist replacement", fact.target_alloc));
    END
    emittable__set_ownership_consumption_mut(&parent, OwnershipConsumptionFact{ operands: COPY operands, target: CAST(COPY locatable__target( CAST(fact AS Locatable)) AS String), target_alloc: COPY fact.target_alloc, source: COPY fact.source, covers_consuming_params: fact.covers_consuming_params });
    NIL;
END
PRIVATE FN mIRLowering__stamp_allocating_result_target_mut(MUTABLE self: MIRLowering, MUTABLE expr: Emittable, name: String, alloc: ?String@symbol = NIL) RETURNS !Void
  EFFECTS REENTRANT ->
    IF (name.length() == 0) THEN
      RETURN;
    END
    IF expr IS_A RegistryCall AS registry_call THEN
      MUTABLE registry_call_mutable = COPY registry_call;
      IF !((registryCall__has_alloc_metadata?(registry_call_mutable) OR (TRY (ownershipEffect__of(Emittable{ RegistryCall: COPY registry_call_mutable }))).produces_owned)) THEN
        RETURN;
      END
      IF TRY (registryCall__mutating_receiver_allocator_op?(registry_call_mutable)) THEN
        RETURN;
      END
      registry_call_mutable.target_var = COPY name;
      IF alloc EXISTS AS alloc_value THEN
        IF KEEP registry_call_mutable.allocs != NIL THEN
          registry_call_mutable.allocs = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_284 = UNWRAP (KEEP registry_call_mutable.allocs);
        inlineAllocMetadata__with_all(rtoc_local_receiver_284, alloc_value) };
        ELSE
          registry_call_mutable.allocs = NIL;
        END
      END
    ELSE
      IF alloc EXISTS AS alloc_value THEN
        IF ((TRY (ownershipEffect__of(expr))).produces_owned AND (aST__node_alloc(castEmittableToLocatable__mir_lowering(expr)) EXISTS)) THEN
          emittable__set_alloc_mut(&expr, alloc_value);
        END
      END
      FOR MUTABLE rtoc_mutable_block_param_285 IN (TRY (emittable__ownership_source_exprs(expr)) OR_ELSE List[]) DO
    MUTABLE has_alloc_metadata = emittable__has_alloc_metadata?(rtoc_mutable_block_param_285);
    IF (has_alloc_metadata OR TRY (mIRLowering__mir_allocates?(&self, rtoc_mutable_block_param_285))) THEN
          mIRLowering__stamp_allocating_result_target_mut(&self, &rtoc_mutable_block_param_285, name, alloc);
    END
      END
    END
    NIL;
END
PRIVATE FN mIRLowering__copy_container_borrow_if_needed(MUTABLE self: MIRLowering, MUTABLE expr: Emittable, MUTABLE ast_node: Locatable) RETURNS !Emittable ->
    IF !(mIRHoistFacts__container_borrow_expr?(ast_node)) THEN
      RETURN COPY expr;
    END
    IF TRY (mIRLowering__mir_allocates?(&self, expr)) THEN
      RETURN COPY expr;
    END
    MUTABLE ti: ?Type = TRY (type__from_node_mut(ast_node, "container borrow copy"));
    ti = TRY (type__success_type( UNWRAP (ti)));
    IF !((TRY (mIRLowering__union_schemas(&self))).contains?(type__resolved( UNWRAP (ti)))) THEN
      RETURN COPY expr;
    END
    MUTABLE copied = DeepCopy{ source: COPY expr, zig_type: COPY TRY ( type__zig_type( UNWRAP (ti))), elem_type: NIL, strategy: :full_value, alloc: :heap, copy_shape: deepCopy__copy_shape_for_zig_type(COPY TRY (type__zig_type( UNWRAP (ti)))), type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL };
    RETURN TRY (mIRLowering__hoist_alloc(&self, Emittable{ DeepCopy: COPY copied }, &ast_node, TRUE));
END
PRIVATE FN mIRLowering__rc_cleanup_entry(MUTABLE self: MIRLowering, ast_node: ?Locatable, source: String, mir: ?Emittable = NIL) RETURNS !CleanupEntry@multiowned ->
    MUTABLE ti:? =   IF ast_node THEN
      TRY (type__from_node_mut(ast_node, "RC hoist cleanup"))
    ELSE_IF mir THEN
      TRY (mIRLowering__mir_alloc_mark_type_info(&self, mir, NIL, "RC hoist cleanup for ${source}"))
    ELSE
      panic("RC hoist cleanup: missing type info for {}")
    END;
    MUTABLE zig_t = TRY (type__zig_type( UNWRAP (ti)));
    MUTABLE rc_entry = cleanupEntry__build(:rc, :heap, FALSE, NIL, zig_t);
    rc_entry.rc_variant = :standard;
    rc_entry.rc_alloc = :heap;
    RETURN rc_entry;
END
PRIVATE FN mIRLowering__uniform_cleanup_entry(self: MIRLowering, zig_type: String, alloc: String@symbol = :heap) RETURNS CleanupEntry@multiowned ->
    RETURN cleanupEntry__build(:uniform, alloc, FALSE, NIL, zig_type);
END
PRIVATE FN mIRLowering__heap_string_entry(self: MIRLowering, alloc: String@symbol = :heap) RETURNS CleanupEntry@multiowned ->
    RETURN cleanupEntry__build(:heap_string, alloc, TRUE);
END
PRIVATE FN mIRLowering__mir_owned_alloc(MUTABLE self: MIRLowering, mir: ?Emittable) RETURNS !?String@symbol ->
    MUTABLE effect_alloc: ?String@symbol = TRY (ownershipEffect__alloc_of(mir));
    IF effect_alloc EXISTS AS effect_alloc_value THEN
      RETURN effect_alloc_value;
    END
    IF mir? IS_A Ident AS ident THEN
      MUTABLE entry = ((TRY (functionState__bindings(mIRLowering__function_state(&self))))[CAST(ident.name AS String)] OR_ELSE cleanupEntry__none());
      IF cleanupEntry__present?(entry) THEN
        RETURN cleanupEntry__alloc(entry);
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
END
PRIVATE FN mIRLowering__hoist_cleanup_entry(MUTABLE self: MIRLowering, mir: Emittable, ast_node: ?Locatable) RETURNS !?CleanupEntry@multiowned
  EFFECTS REENTRANT ->
    MUTABLE alloc = (mIRLowering__mir_owned_alloc(&self, mir) OR_ELSE :heap);
    IF mir IS_A DupeSlice AS dupe_slice THEN
      RETURN mIRLowering__heap_string_entry(self, alloc);
    ELSE_IF mir IS_A ConcatStr AS concat_str THEN
      RETURN mIRLowering__heap_string_entry(self, alloc);
    ELSE_IF mir IS_A AllocSlice AS alloc_slice THEN
      MUTABLE e = mIRLowering__uniform_cleanup_entry(self, "[]${alloc_slice.elem_type}", alloc);
      cleanupEntry__set_elem_zig_type_mut(&e, COPY alloc_slice.elem_type);
      RETURN e;
    ELSE_IF mir IS_A MakeList AS make_list THEN
      RETURN mIRLowering__uniform_cleanup_entry(self, "std.ArrayListUnmanaged(${make_list.elem_type})", alloc);
    ELSE_IF mir IS_A OwnedSlice AS owned_slice THEN
      RETURN mIRLowering__uniform_cleanup_entry(self, "[]", alloc);
    ELSE_IF mir IS_A HeapCreate AS heap_create THEN
      RETURN mIRLowering__uniform_cleanup_entry(self, heap_create.zig_type, alloc);
    ELSE_IF mir IS_A ContainerInit AS container_init THEN
      RETURN mIRLowering__uniform_cleanup_entry(self, container_init.zig_type, alloc);
    ELSE_IF mir IS_A DeepCopy AS deep_copy THEN
      IF !((deep_copy.strategy == :full_value)) THEN
        panic("hoist_cleanup_entry: unexpected DeepCopy strategy :{}");
      END
      RETURN mIRLowering__uniform_cleanup_entry(self, TRY (mIRLowering__deep_copy_zig_type(self, deep_copy, ast_node)), alloc);
    ELSE_IF mir IS_A CapWrap AS cap_wrap THEN
      IF cap_wrap.sync_fn THEN
        RETURN mIRLowering__uniform_cleanup_entry(self, UNWRAP (cap_wrap.sync_type), alloc);
      ELSE_IF cap_wrap.own_fn THEN
        RETURN TRY (mIRLowering__rc_cleanup_entry(&self, ast_node, "MIR::CapWrap (own_fn=${(cap_wrap.own_fn OR_ELSE "")})", Emittable{ CapWrap: COPY cap_wrap }));
      ELSE_IF (cap_wrap.strategy == :local) THEN
        RETURN mIRLowering__uniform_cleanup_entry(self, "*${cap_wrap.zig_base}", alloc);
      END
    ELSE_IF mir IS_A SharePromote AS share_promote THEN
      RETURN TRY (mIRLowering__rc_cleanup_entry(&self, ast_node, "MIR::SharePromote", Emittable{ SharePromote: COPY share_promote }));
    ELSE_IF mir IS_A RcRetain AS rc_retain THEN
      IF TRY (mIRLowering__cleanup_entry_for_owned_result(&self, ast_node, alloc)) != NIL THEN
    RETURN (TRY (mIRLowering__cleanup_entry_for_owned_result(&self, ast_node, alloc)))?;
      ELSE
    RETURN cleanupEntry__build(:rc, alloc, FALSE);
      END
    ELSE_IF mir IS_A RcDowngrade AS rc_downgrade THEN
      IF TRY (mIRLowering__cleanup_entry_for_owned_result(&self, ast_node, alloc)) != NIL THEN
    RETURN (TRY (mIRLowering__cleanup_entry_for_owned_result(&self, ast_node, alloc)))?;
      ELSE
    RETURN cleanupEntry__build(:rc, alloc, FALSE);
      END
    ELSE_IF mir IS_A WeakUpgrade AS weak_upgrade THEN
      IF TRY (mIRLowering__cleanup_entry_for_owned_result(&self, ast_node, alloc)) != NIL THEN
    RETURN (TRY (mIRLowering__cleanup_entry_for_owned_result(&self, ast_node, alloc)))?;
      ELSE
    RETURN cleanupEntry__build(:rc, alloc, FALSE);
      END
    ELSE_IF mir IS_A MonomorphicKeep AS monomorphic_keep THEN
      IF TRY (mIRLowering__cleanup_entry_for_owned_result(&self, ast_node, alloc)) != NIL THEN
    RETURN (TRY (mIRLowering__cleanup_entry_for_owned_result(&self, ast_node, alloc)))?;
      ELSE
    RETURN cleanupEntry__build(:rc, alloc, FALSE);
      END
    ELSE_IF mir IS_A FreezeExpr AS freeze_expr THEN
      # Ruby's `CleanupEntry.build(..., fixed_alloc: true)` passes the extra
      # through **extra; CLEAR's build takes named parameters, so the flag is
      # set through its own accessor.
      MUTABLE frozen_entry = cleanupEntry__build(:frozen, :heap, FALSE);
      cleanupEntry__set_fixed_alloc_mut(&frozen_entry, TRUE);
      RETURN frozen_entry;
    ELSE_IF mir IS_A MIRCast AS mir_cast THEN
      RETURN mIRLowering__hoist_cleanup_entry(&self, cast__expr(mir_cast), ast_node);
    ELSE_IF mir IS_A TryExpr AS try_expr THEN
      RETURN mIRLowering__hoist_cleanup_entry(&self, tryExpr__expr(try_expr), ast_node);
    ELSE_IF mir IS_A TryOptional AS try_optional THEN
      RETURN mIRLowering__hoist_cleanup_entry(&self, tryOptional__expr(try_optional), ast_node);
    ELSE_IF mir IS_A MIROptionalUnwrap AS mir_optional_unwrap THEN
      RETURN mIRLowering__hoist_cleanup_entry(&self, optionalUnwrap__expr(mir_optional_unwrap), ast_node);
    ELSE_IF mir IS_A UnionPayloadGet THEN
      # Reading a variant's payload allocates nothing: the UNION owns it, and
      # its cleanup frees it. `mir_allocates?` is true here only because the
      # subject allocates, so a hoist of this projection is a borrow of that
      # buffer -- giving it a cleanup of its own frees what the union frees.
      RETURN NIL;
    ELSE_IF mir IS_A AsyncPayloadTake AS async_payload_take THEN
      # Ruby chains these with `||`, which evaluates each at most once.
      RETURN ((TRY (mIRLowering__cleanup_entry_for_owned_result(&self, ast_node, alloc)) OR_ELSE TRY (mIRLowering__typed_cleanup_entry_for_mir_result(&self, Emittable{ AsyncPayloadTake: COPY async_payload_take }, alloc))) OR_ELSE TRY (mIRLowering__cleanup_entry_for_ownership_effect(&self, Emittable{ AsyncPayloadTake: COPY async_payload_take }, alloc)));
    ELSE_IF mir IS_A DirectTenseMap AS direct_tense_map THEN
      # Ruby chains these with `||`, which evaluates each at most once.
      RETURN ((TRY (mIRLowering__cleanup_entry_for_owned_result(&self, ast_node, alloc)) OR_ELSE TRY (mIRLowering__typed_cleanup_entry_for_mir_result(&self, Emittable{ DirectTenseMap: COPY direct_tense_map }, alloc))) OR_ELSE TRY (mIRLowering__cleanup_entry_for_ownership_effect(&self, Emittable{ DirectTenseMap: COPY direct_tense_map }, alloc)));
    ELSE_IF mir IS_A Call AS call THEN
      # Ruby chains these with `||`, which evaluates each at most once.
      RETURN ((TRY (mIRLowering__cleanup_entry_for_owned_result(&self, ast_node, alloc)) OR_ELSE TRY (mIRLowering__typed_cleanup_entry_for_mir_result(&self, Emittable{ Call: COPY call }, alloc))) OR_ELSE TRY (mIRLowering__cleanup_entry_for_ownership_effect(&self, Emittable{ Call: COPY call }, alloc)));
    ELSE_IF mir IS_A MIRMethodCall AS mir_method_call THEN
      # Ruby chains these with `||`, which evaluates each at most once.
      RETURN ((TRY (mIRLowering__cleanup_entry_for_owned_result(&self, ast_node, alloc)) OR_ELSE TRY (mIRLowering__typed_cleanup_entry_for_mir_result(&self, Emittable{ MIRMethodCall: COPY mir_method_call }, alloc))) OR_ELSE TRY (mIRLowering__cleanup_entry_for_ownership_effect(&self, Emittable{ MIRMethodCall: COPY mir_method_call }, alloc)));
    ELSE_IF mir IS_A TryCatch AS try_catch THEN
      # Ruby chains these with `||`, which evaluates each at most once.
      RETURN ((TRY (mIRLowering__cleanup_entry_for_owned_result(&self, ast_node, alloc)) OR_ELSE TRY (mIRLowering__typed_cleanup_entry_for_mir_result(&self, Emittable{ TryCatch: COPY try_catch }, alloc))) OR_ELSE TRY (mIRLowering__cleanup_entry_for_ownership_effect(&self, Emittable{ TryCatch: COPY try_catch }, alloc)));
    ELSE_IF mir IS_A Orelse AS orelse THEN
      # Ruby chains these with `||`, which evaluates each at most once.
      RETURN ((TRY (mIRLowering__cleanup_entry_for_owned_result(&self, ast_node, alloc)) OR_ELSE TRY (mIRLowering__typed_cleanup_entry_for_mir_result(&self, Emittable{ Orelse: COPY orelse }, alloc))) OR_ELSE TRY (mIRLowering__cleanup_entry_for_ownership_effect(&self, Emittable{ Orelse: COPY orelse }, alloc)));
    ELSE_IF mir IS_A IfOptional AS if_optional THEN
      # Ruby chains these with `||`, which evaluates each at most once.
      RETURN ((TRY (mIRLowering__cleanup_entry_for_owned_result(&self, ast_node, alloc)) OR_ELSE TRY (mIRLowering__typed_cleanup_entry_for_mir_result(&self, Emittable{ IfOptional: COPY if_optional }, alloc))) OR_ELSE TRY (mIRLowering__cleanup_entry_for_ownership_effect(&self, Emittable{ IfOptional: COPY if_optional }, alloc)));
    ELSE_IF mir IS_A MIRBlockExpr AS mir_block_expr THEN
      # Ruby chains these with `||`, which evaluates each at most once.
      RETURN ((TRY (mIRLowering__cleanup_entry_for_owned_result(&self, ast_node, alloc)) OR_ELSE TRY (mIRLowering__typed_cleanup_entry_for_mir_result(&self, Emittable{ MIRBlockExpr: COPY mir_block_expr }, alloc))) OR_ELSE TRY (mIRLowering__cleanup_entry_for_ownership_effect(&self, Emittable{ MIRBlockExpr: COPY mir_block_expr }, alloc)));
    ELSE_IF mir IS_A Pipeline AS pipeline THEN
      # Ruby chains these with `||`, which evaluates each at most once.
      RETURN ((TRY (mIRLowering__cleanup_entry_for_owned_result(&self, ast_node, alloc)) OR_ELSE TRY (mIRLowering__typed_cleanup_entry_for_mir_result(&self, Emittable{ Pipeline: COPY pipeline }, alloc))) OR_ELSE TRY (mIRLowering__cleanup_entry_for_ownership_effect(&self, Emittable{ Pipeline: COPY pipeline }, alloc)));
    ELSE_IF mir IS_A InlineBc AS inline_bc THEN
      # Ruby chains these with `||`, which evaluates each at most once.
      RETURN ((TRY (mIRLowering__cleanup_entry_for_owned_result(&self, ast_node, alloc)) OR_ELSE TRY (mIRLowering__typed_cleanup_entry_for_mir_result(&self, Emittable{ InlineBc: COPY inline_bc }, alloc))) OR_ELSE TRY (mIRLowering__cleanup_entry_for_ownership_effect(&self, Emittable{ InlineBc: COPY inline_bc }, alloc)));
    ELSE_IF mir IS_A RegistryCall AS registry_call THEN
      # Ruby chains these with `||`, which evaluates each at most once.
      RETURN ((TRY (mIRLowering__cleanup_entry_for_owned_result(&self, ast_node, alloc)) OR_ELSE TRY (mIRLowering__typed_cleanup_entry_for_mir_result(&self, Emittable{ RegistryCall: COPY registry_call }, alloc))) OR_ELSE TRY (mIRLowering__cleanup_entry_for_ownership_effect(&self, Emittable{ RegistryCall: COPY registry_call }, alloc)));
    ELSE_IF mir IS_A IndexedStore AS indexed_store THEN
      # Ruby chains these with `||`, which evaluates each at most once.
      RETURN ((TRY (mIRLowering__cleanup_entry_for_owned_result(&self, ast_node, alloc)) OR_ELSE TRY (mIRLowering__typed_cleanup_entry_for_mir_result(&self, Emittable{ IndexedStore: COPY indexed_store }, alloc))) OR_ELSE TRY (mIRLowering__cleanup_entry_for_ownership_effect(&self, Emittable{ IndexedStore: COPY indexed_store }, alloc)));
    ELSE_IF mir IS_A ExternTrampoline AS extern_trampoline THEN
      # Ruby chains these with `||`, which evaluates each at most once.
      RETURN ((TRY (mIRLowering__cleanup_entry_for_owned_result(&self, ast_node, alloc)) OR_ELSE TRY (mIRLowering__typed_cleanup_entry_for_mir_result(&self, Emittable{ ExternTrampoline: COPY extern_trampoline }, alloc))) OR_ELSE TRY (mIRLowering__cleanup_entry_for_ownership_effect(&self, Emittable{ ExternTrampoline: COPY extern_trampoline }, alloc)));
    ELSE_IF mir IS_A MIRBgBlock AS mir_bg_block THEN
      # Ruby chains these with `||`, which evaluates each at most once.
      RETURN ((TRY (mIRLowering__cleanup_entry_for_owned_result(&self, ast_node, alloc)) OR_ELSE TRY (mIRLowering__typed_cleanup_entry_for_mir_result(&self, Emittable{ MIRBgBlock: COPY mir_bg_block }, alloc))) OR_ELSE TRY (mIRLowering__cleanup_entry_for_ownership_effect(&self, Emittable{ MIRBgBlock: COPY mir_bg_block }, alloc)));
    ELSE_IF mir IS_A ShardedMapGet AS sharded_map_get THEN
      # Ruby chains these with `||`, which evaluates each at most once.
      RETURN ((TRY (mIRLowering__cleanup_entry_for_owned_result(&self, ast_node, alloc)) OR_ELSE TRY (mIRLowering__typed_cleanup_entry_for_mir_result(&self, Emittable{ ShardedMapGet: COPY sharded_map_get }, alloc))) OR_ELSE TRY (mIRLowering__cleanup_entry_for_ownership_effect(&self, Emittable{ ShardedMapGet: COPY sharded_map_get }, alloc)));
    ELSE
      panic("{}mir_allocates? returned true but no cleanup entry is defined. Add a case.");
    END
END
PRIVATE FN mIRLowering__deep_copy_zig_type(self: MIRLowering, mir: DeepCopy, ast_node: ?Locatable) RETURNS !String ->
    IF mir.zig_type EXISTS AS zig_type_value THEN
      RETURN COPY zig_type_value;
    END
    MUTABLE ti: ?Type = TRY (type__from_node_mut(UNWRAP (ast_node), "deep-copy zig type"));
    MUTABLE bare = TRY (type__new( TypeConstructionInput{ Type: COPY UNWRAP (ti) }));
    type__mark_stack_value_mut(&bare);
    RETURN TRY (type__zig_type(bare));
END
PRIVATE FN mIRLowering__cleanup_entry_for_owned_result(MUTABLE self: MIRLowering, ast_node: ?Locatable, alloc: String@symbol = :heap) RETURNS !?CleanupEntry@multiowned ->
    IF ast_node EXISTS AS ast_node_value THEN
      MUTABLE ti: ?Type = TRY (type__from_node_mut(ast_node_value, "owned result cleanup entry"));
      ti = TRY (type__success_type( UNWRAP (ti)));
      IF ( type__symbol?( UNWRAP (ti)) OR type__raw?( UNWRAP (ti))) THEN
        RETURN NIL;
      END
      IF TRY (type__string?(UNWRAP (ti))) THEN
        RETURN mIRLowering__heap_string_entry(self, alloc);
      END
      IF type__collection?(UNWRAP (ti)) THEN
        RETURN mIRLowering__uniform_cleanup_entry(self, TRY (type__zig_type(UNWRAP (ti))), alloc);
      END
      IF !(((((TRY (type__needs_explicit_cleanup?(UNWRAP (ti), alloc, mIRLowering__mir_schema_lookup(&self))) OR TRY (type__recursive_cleanup_shape?( UNWRAP (ti), mIRLowering__mir_schema_lookup(&self)))) OR TRY (type__needs_cleanup?( UNWRAP (ti), mIRLowering__mir_schema_lookup(&self)))) OR TRY (type__heap_ptr?( UNWRAP (ti)))) OR TRY (type__collection_value?( UNWRAP (ti))))) THEN
        RETURN NIL;
      END
      MUTABLE zig_t = ((TRY (type__zig_type((TRY (type__new(TypeConstructionInput{ StringValue: CAST(type__resolved( UNWRAP (ti)) AS String) })))))));
      IF !(zig_t) THEN
        RETURN NIL;
      END
      RETURN mIRLowering__uniform_cleanup_entry(self, zig_t, alloc);
    ELSE
      RETURN NIL;
    END
END
PRIVATE FN mIRLowering__typed_cleanup_entry_for_mir_result(MUTABLE self: MIRLowering, mir: Emittable, alloc: String@symbol = :heap) RETURNS !?CleanupEntry@multiowned ->
    MUTABLE typed_result: ?Type@multiowned = TRY (mIRLowering__mir_explicit_result_type(self, mir));
    IF typed_result EXISTS AS typed_result_value THEN
      MUTABLE ti = typed_result_value;
      ti = TRY (type__success_type(ti));
      IF (type__symbol?(ti) OR type__raw?(ti)) THEN
        RETURN NIL;
      END
      IF TRY (type__string?(ti)) THEN
        RETURN mIRLowering__heap_string_entry(self, alloc);
      END
      IF ((type__collection?(ti) OR TRY (type__recursive_cleanup_shape?(ti, mIRLowering__mir_schema_lookup(&self)))) OR TRY (type__needs_cleanup?(ti, mIRLowering__mir_schema_lookup(&self)))) THEN
        RETURN mIRLowering__uniform_cleanup_entry(self, TRY (type__zig_type(ti)), alloc);
      END
    END
    RETURN NIL;
END
PRIVATE FN mIRLowering__cleanup_entry_for_ownership_effect(MUTABLE self: MIRLowering, mir: Emittable, alloc: String@symbol = :heap) RETURNS !?CleanupEntry@multiowned ->
    MUTABLE effect = TRY (ownershipEffect__of(mir));
    IF mir IS_A MIRBlockExpr AS mir_block_expr THEN
      MUTABLE transferred: ?String = COPY effect.target_var;
      IF transferred EXISTS AS transferred_value THEN
        MUTABLE let: ?Emittable = (TRY (blockExpr__body(mir_block_expr))) |> WHERE (_ IS_A Let) |> FIND (CAST(emittable__name(_) AS String) == transferred_value);
        IF let EXISTS AS transferred_let THEN
          RETURN TRY (mIRLowering__hoist_cleanup_entry(&self, UNWRAP (emittable__init(transferred_let)), NIL));
        END
      END
    END
    IF !(effect.produces_owned) THEN
      RETURN NIL;
    END
    IF (effect.cleanup_kind == :heap_string) THEN
      RETURN mIRLowering__heap_string_entry(self, alloc);
    ELSE_IF (effect.cleanup_kind == :uniform) THEN
      MUTABLE typed: ?Type@multiowned = TRY (mIRLowering__mir_explicit_result_type(self, mir));
      IF typed EXISTS AS typed_value THEN
        RETURN mIRLowering__uniform_cleanup_entry(self, TRY (type__zig_type(typed_value)), alloc);
      END
      IF mir IS_A MIRBlockExpr AS mir_block_expr THEN
        typed = TRY (mIRLowering__block_expr_result_type(self, mir_block_expr));
      ELSE
        typed = NIL;
      END
      IF typed EXISTS AS typed_value THEN
        RETURN mIRLowering__uniform_cleanup_entry(self, TRY (type__zig_type(typed_value)), alloc);
      END
      panic("uniform owned MIR {} has no typed cleanup result");
    ELSE_IF (effect.cleanup_kind == :rc) THEN
      RETURN cleanupEntry__build(:rc, alloc, FALSE);
    ELSE_IF (effect.cleanup_kind == :frozen) THEN
      MUTABLE frozen_result_entry = cleanupEntry__build(:frozen, :heap, FALSE);
      cleanupEntry__set_fixed_alloc_mut(&frozen_result_entry, TRUE);
      RETURN frozen_result_entry;
    ELSE
      RETURN NIL;
    END
END
PRIVATE FN mIRLowering__mir_ident_names(self: MIRLowering, node: ?Emittable) RETURNS ![]String
  EFFECTS REENTRANT ->
    IF UNWRAP (node) IS_A Ident AS ident THEN
      RETURN CAST([CAST(ident.name AS String)] AS []String);
    ELSE_IF UNWRAP (node) IS_A MIRBlockExpr AS mir_block_expr THEN
      MUTABLE local_names: [Set]String = Set[];
      FOR stmt IN TRY (blockExpr__body(mir_block_expr)) DO
        IF stmt IS_A AllocMark AS local_alloc_mark THEN
          &local_names.insert(COPY local_alloc_mark.name);
        END
        IF stmt IS_A Let AS local_let THEN
          &local_names.insert(COPY local_let.name);
        END
      END
      MUTABLE transferred_names: [Set]String = Set[];
      FOR stmt IN TRY (blockExpr__body(mir_block_expr)) DO
        IF stmt IS_A TransferMark AS transfer_mark THEN
          IF (transfer_mark.target == :block_result) THEN
            &transferred_names.insert(COPY transfer_mark.name);
          END
        END
      END
      # Ruby's `body.reverse.grep(MIR::BreakStmt).first` -- the LAST break in
      # the body. A backward index walk says the same thing without building a
      # reversed copy.
      MUTABLE last: ?Emittable = NIL;
      MUTABLE block_body = TRY (blockExpr__body(mir_block_expr));
      MUTABLE break_idx = block_body.length();
      WHILE break_idx > 0 DO
        break_idx = break_idx - 1;
        MUTABLE candidate = UNWRAP (block_body[break_idx]);
        IF candidate IS_A BreakStmt THEN
          last = COPY candidate;
          BREAK;
        END
      END
      IF last EXISTS AS last_break THEN
        RETURN (mIRLowering__mir_ident_names(self, emittable__value(last_break))) |> WHERE !((local_names.contains?(_) OR transferred_names.contains?(_)));
      ELSE
        RETURN CAST(List[] AS []String);
      END
    ELSE
      MUTABLE names: []String = List[];
      IF node EXISTS AS node_value THEN
        IF !(emittable__responds_to_ownership_source_exprs?(node_value)) THEN
          RETURN CAST(List[] AS []String);
        END
        FOR MUTABLE rtoc_for_item_8364 IN (TRY (emittable__ownership_source_exprs(node_value)) OR_ELSE List[]) DO
        FOR rtoc_for_item_8364 IN mIRLowering__mir_ident_names(self, rtoc_for_item_8364) DO
        &names.append(COPY rtoc_for_item_8364);
        END
        END
        RETURN dedupeStrings(names);
      ELSE
        RETURN CAST(List[] AS []String);
      END
    END
END
PRIVATE FN mIRLowering__lower_extern_fn(MUTABLE self: MIRLowering, node: ExternFnDecl) RETURNS !Emittable ->
    MUTABLE source: ?ExternSource = COPY node.extern_source;
    IF ((source != NIL) AND (source.abi == :c)) THEN
      MUTABLE params = (node.params OR_ELSE List[]) |> SELECT {
    MUTABLE zig_type = TRY (mIRLowering__c_abi_param_zig_type(self, _));
    MIRParam{ name: COPY _.name, zig_type: COPY zig_type, pointer_passed: (_.mutable OR_ELSE FALSE), lowered_node_id: NIL, ownership_consumption: NIL }
      };
      RETURN Emittable{ CExternFnDecl: COPY CExternFnDecl{ name: CAST((source.symbol OR node.name) AS String), params: params, return_type: TRY (type__zig_type(TRY (externFnDecl__annotation_return_type(node)))), library: source.dependency, callconv: source.callconv, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
    MUTABLE mod: String = COPY (node.from_module OR_ELSE "");
    IF &self.state.program.emitted_extern_modules.insert(mod) THEN
      MUTABLE mod_parts = mod.split(".");
      MUTABLE root_module: String = UNWRAP (mod_parts.first());
      MUTABLE tail_modules = mod_parts |> SKIP 1;
      MUTABLE import_expr = ("@import(\"${root_module}\")" $+ ((tail_modules |> SELECT ".${_}").join("")));
      MUTABLE mod_alias = mIRLowering__zig_module_alias(self, mod);
      MUTABLE module_path: String = "";
      IF ((["std", "builtin", "cheat_runtime"]) |> DISTINCT _).contains?(root_module) THEN
        module_path = root_module;
      ELSE
        module_path = "${root_module}.zig";
      END
      RETURN Emittable{ Import: COPY Import{ alias_name: COPY mod_alias, module_path: COPY module_path, member: IF tail_modules.empty?() THEN
        NIL
      ELSE
        tail_modules.join(".")
      END, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    ELSE
      RETURN Emittable{ Noop: COPY Noop{ reason: "extern_fn_import_already_emitted", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
END
PRIVATE FN mIRLowering__lower_extern_struct(MUTABLE self: MIRLowering, node: ExternStructDecl) RETURNS !MIRLoweringReturnValue ->
    MUTABLE fields: []FieldDef = List[];
    MUTABLE source: ?ExternSource = COPY node.extern_source;
    IF ((source != NIL) AND (source.abi == :c)) THEN
      IF (node.field_decls.length() == 0) THEN
        MUTABLE opaque_name = "${node.name}__opaque";
        RETURN MIRLoweringReturnValue{ ArrayValue: [TypeAlias{ name: COPY opaque_name, target: "opaque {}", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }, TypeAlias{ name: COPY node.name, target: "*${opaque_name}", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }] |> SELECT Emittable{ TypeAlias: COPY _ } };
      END
      fields = node.field_decls.keys() |> SELECT FieldDef{ name: COPY _, zig_type: TRY (type__zig_type((structField__type((COPY UNWRAP (node.field_decls[_])))), FALSE, TRUE)), default: NIL, lowered_node_id: NIL, ownership_consumption: NIL, boxed_capture: NIL };
      RETURN MIRLoweringReturnValue{ Emittable: COPY CAST(CExternStructDef{ name: node.name, fields: fields, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) };
    END
    MUTABLE mod: ?String = COPY node.from_module;
    IF mod EXISTS AS mod_value THEN
      MUTABLE mod_parts = mod_value.split(".");
      MUTABLE mod_alias = mIRLowering__zig_module_alias(self, mod_value);
      MUTABLE items: []Emittable = List[];
      IF &self.state.program.emitted_extern_modules.insert(mod_value) THEN
        MUTABLE root_module = COPY UNWRAP (mod_parts.first());
        MUTABLE tail_modules = mod_parts |> SKIP 1;
        MUTABLE member_chain:? = IF tail_modules.empty?() THEN
          NIL
        ELSE
          tail_modules.join(".")
        END;
        MUTABLE module_path: String = "";
        IF ((["std", "builtin", "cheat_runtime"]) |> DISTINCT _).contains?(root_module) THEN
          module_path = COPY root_module;
        ELSE
          module_path = "${root_module}.zig";
        END
        &items.append(Emittable{ Import: COPY Import{ alias_name: COPY mod_alias, module_path: COPY module_path, member: member_chain, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
      END
      IF &self.state.program.emitted_import_type_aliases.insert(CAST(node.name AS String)) THEN
        MUTABLE zig_rhs: String = "";
        IF node.as_type EXISTS AS as_type_value THEN
          zig_rhs = "${mod_alias}.${as_type_value}";
        ELSE
          zig_rhs = "${mod_alias}.${node.name}";
        END
        &items.append(Emittable{ TypeAlias: COPY TypeAlias{ name: COPY node.name, target: COPY zig_rhs, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
      END
      IF (items.length() == 0) THEN
        RETURN MIRLoweringReturnValue{ Emittable: COPY CAST(Noop{ reason: "duplicate_extern_struct_alias", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) };
      END
      IF (items.length() == 1) THEN
        RETURN COPY castEmittableToMIRLoweringReturnValue(UNWRAP (items.first()));
      ELSE
        RETURN MIRLoweringReturnValue{ ArrayValue: COPY items };
      END
    ELSE
    IF (node.field_decls.length() == 0) THEN
        RETURN MIRLoweringReturnValue{ Emittable: COPY CAST(Noop{ reason: "empty_local_extern_struct", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) };
    ELSE
        fields = node.field_decls.keys() |> SELECT {
    MUTABLE zig_t = TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY structField__type((COPY UNWRAP (node.field_decls[_]))) }, FALSE, TRUE));
    FieldDef{ name: COPY _, zig_type: COPY zig_t, default: NIL, lowered_node_id: NIL, ownership_consumption: NIL, boxed_capture: NIL }
        };
        RETURN MIRLoweringReturnValue{ Emittable: COPY CAST(MIRStructDef{ name: node.name, fields: fields, methods: NIL, visibility: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) };
    END
    END
END
PRIVATE FN mIRLowering__lower_function_def(MUTABLE self: MIRLowering, MUTABLE node: FunctionDef) RETURNS !MIRLoweringReturnValue ->
    MUTABLE body_mir: []Emittable = List[];
    MUTABLE sig: ?FunctionSignature@multiowned = NIL;
    self.kept_liveness_fn = COPY node;
    self.kept_liveness = NIL;
    MUTABLE ret_type: !Type = functionDef__lowering_return_type(node);
    IF ((TRUE AND type__frame?( TRY (ret_type))) AND TRY (type__struct?( TRY (ret_type)))) THEN
      ret_type = TRY (type__new(TypeConstructionInput{ StringValue: CAST(type__resolved( TRY (ret_type)) AS String) }));
    END
    MUTABLE final_type = TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: TRY (COPY ret_type)}));
    MUTABLE fn_needs_rt = (((TRY (mIRLowering__finalized_needs_rt_mut(&self, node)) OR_ELSE FALSE) OR TRY (mIRLowering__function_return_retains_shared_handle?(&self, node))) OR TRY (mIRLowering__function_uses_node_store?(&self, node)));
    IF fn_needs_rt THEN
      sig = (IF (TRY (mIRLowering__fn_sigs(self)))[symbol(CAST(node.name AS String))] != NIL THEN (TRY (mIRLowering__fn_sigs(self)))[symbol(CAST(node.name AS String))] ELSE (TRY (mIRLowering__fn_sigs(self)))[symbol(node.name)] END);
      IF sig EXISTS AS sig_value THEN
        MUTABLE sig_value_mutable = COPY sig_value;
        functionSignature__mark_runtime_required_mut(&sig_value_mutable);
      END
      node.needs_rt = TRUE;
    END
    MUTABLE fn_can_fail:? = IF (node.can_fail == NIL) THEN
      TRUE
    ELSE
      node.can_fail
    END;
    MUTABLE param_facts = TRY (mIRLowering__function_param_facts(&self, node.params, node.generic_params));
    MUTABLE context = TRY (mIRLowering__function_lowering_context(&self, &node, final_type, ReturnTypeNode{ Type: TRY (COPY ret_type)}, fn_needs_rt, param_facts));
    mIRLowering__activate_function_context(&self, context);
    MUTABLE params_mir: []MIRParam = param_facts |> UNNEST {
    MUTABLE params = [functionParamFact__to_mir_param(_)];
    IF _.protocol_map THEN
        &params.append(MIRParam{ name: COPY mIRLowering__protocol_map_allocator_name(self, _.name), zig_type: "std.mem.Allocator", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL });
    END
    params
    };
    IF fn_needs_rt THEN
      params_mir = ([MIRParam{ name: "rt", zig_type: "*Runtime", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL }] + params_mir);
    END
    MUTABLE comptime_params = node.type_params |> SELECT "comptime ${_}: type";
    MUTABLE tied_shared_return: ?String = mIRLowering__tied_shared_family_return_param(self, node, context.mutable_scalar_params);
    MUTABLE final_zig_type = zigType__new(final_type);
    MUTABLE return_type_str =   IF tied_shared_return THEN
      tied_shared_return
    ELSE_IF fn_can_fail THEN
      zigType__fallible_return_type_for(final_zig_type, functionDef__recursive_reentrance_declared?(node))
    ELSE
      final_type
    END;
    MUTABLE vis = IF ((node.visibility == :pub)) THEN
      :pub
    ELSE
      :private
    END;
    MUTABLE used_names = TRY (mIRLowering__collect_identifier_names(self, CAST(node.body AS []Node)));
    MUTABLE entry_plan = TRY (mIRLowering__function_entry_plan(&self, &node, fn_needs_rt, context.mutable_scalar_params, used_names));
    MUTABLE prologue = COPY entry_plan.prologue;
    MUTABLE takes_mir = COPY entry_plan.takes_mir;
    MUTABLE pointer_param_mir = context.protocol_map_allocators.values() |> SELECT Suppress{ name: COPY _, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    MUTABLE catch_clauses = TRY (mIRLowering__function_catch_clauses(self, node));
    MUTABLE has_catch = context.has_catch;
    IF node.thunk_plan THEN
      body_mir = ((takes_mir + pointer_param_mir) + [TRY (emit__build_trampoline(node, self))]);
    ELSE_IF node.mutual_thunk_plan THEN
      body_mir = ((takes_mir + pointer_param_mir) + [TRY (emit__build_mutual_trampoline(node, self))]);
    ELSE
      MUTABLE pre_checks = TRY (mIRLowering__lower_pre_clauses(&self, node));
      MUTABLE lowered_body = TRY (mIRLowering__lower_body(&self, castLocatableListToMIRLoweringLowerableStmtList(node.body)));
      MUTABLE node_stores = ((mIRLowering__function_state(&self).node_store_types |> SELECT COPY _) |> ORDER_BY _) |> UNNEST {
    MUTABLE bind_call = MIRMethodCall{ receiver: Emittable{ Call: COPY TRY (mIRLowering__node_store_type_mir(&self, _)) }, method: "bind", args: [CAST(Ident{ name: mIRLowering__runtime_binding_name(&self), lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: TRUE, callable_contract: TRY (callableContract__no_ownership(1)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    MUTABLE binding = Ident{ name: mIRLowering__node_store_binding_name(self, _), lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE release_call = MIRMethodCall{ receiver: Emittable{ Call: COPY TRY (mIRLowering__node_store_type_mir(&self, _)) }, method: "releaseBound", args: [CAST(binding AS Any)], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(1)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    [Emittable{ Let: COPY Let{ name: COPY mIRLowering__node_store_binding_name(self, _), init: Emittable{ MIRMethodCall: COPY bind_call }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }, Emittable{ MIRDeferStmt: COPY MIRDeferStmt{ body: DeferBody{ Emittable: COPY CAST(COPY release_call AS Emittable) }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }]
      };
      body_mir = ((((takes_mir + pointer_param_mir) + pre_checks) + node_stores) + lowered_body);
    END
    body_mir = TRY (mIRLowering__append_ownership_transfers_for_mir_body(&self, body_mir));
    IF (!(fn_can_fail) AND TRY (mIRLowering__body_has_faulting_alloc?(&self, body_mir))) THEN
      fn_can_fail = TRUE;
      return_type_str = mIRLowering__faulting_return_type_str(self, final_type, node);
      sig = (IF (TRY (mIRLowering__fn_sigs(self)))[symbol(CAST(node.name AS String))] != NIL THEN (TRY (mIRLowering__fn_sigs(self)))[symbol(CAST(node.name AS String))] ELSE (TRY (mIRLowering__fn_sigs(self)))[symbol(node.name)] END);
      IF sig EXISTS AS sig_value THEN
        MUTABLE sig_value_mutable = COPY sig_value;
        functionSignature__mark_faulting_allocation_mut(&sig_value_mutable);
      END
      node.can_fail = TRUE;
    END
    MUTABLE has_post = ((TRUE AND node.post_clauses) AND (node.post_clauses).any?());
    IF has_post THEN
      RETURN MIRLoweringReturnValue{ ArrayValue: COPY [Emittable{ FnDef: COPY mIRLowering__build_post_inner_fn(self, node, params_mir, return_type_str, prologue, body_mir, comptime_params) }, Emittable{ FnDef: COPY TRY (mIRLowering__build_post_outer_fn(&self, node, params_mir, return_type_str, fn_needs_rt, vis, comptime_params)) }] };
    ELSE_IF has_catch THEN
      MUTABLE inner_name = "__${mIRLowering__zig_safe_name(self, node.name)}_body";
      MUTABLE inner_ret: String = "";
      IF zigType__error_union?(final_zig_type) THEN
        inner_ret = COPY final_zig_type.source;
      ELSE_IF fn_can_fail THEN
        inner_ret = zigType__concrete_fallible_return_type(final_zig_type);
      ELSE
        inner_ret = zigType__fallible_return_type(final_zig_type);
      END
      MUTABLE inner_fn = FnDef{ name: COPY inner_name, params: COPY params_mir, ret_type: COPY inner_ret, body: TRY (mIRLowering__append_ownership_transfers_for_mir_body(&self, (prologue + body_mir))), visibility: :private, can_fail: FALSE, comptime_params: comptime_params, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
      MUTABLE call_args: []String = List[];
      IF fn_needs_rt THEN
        &call_args.append(COPY "rt");
      END
      FOR rtoc_param IN node.params DO
        &call_args.append(COPY rtoc_param.name);
      END
      MUTABLE inner_call = Call{ callee: COPY inner_name, args: COPY call_args |> SELECT Emittable{ Ident: COPY Ident{ name: COPY _, lowered_node_id: NIL, ownership_consumption: NIL } }, try_wrap: FALSE, owned_return: FALSE, callable_contract: COPY TRY (callableContract__no_ownership((call_args).length())), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL };
      MUTABLE catch_plan = TRY (mIRLowering__build_catch_clauses(&self, &node, (fn_can_fail OR_ELSE FALSE)));
      MUTABLE error_reassigns = TRY (mIRLowering__collect_catch_reassigns(self, &node));
      MUTABLE outer_body = [Emittable{ CatchWrapper: COPY CatchWrapper{ inner_call: Emittable{ Call: COPY inner_call }, error_reassigns: error_reassigns, clauses: COPY catch_plan.clauses, default_body: catch_plan.default_body, default_action: catch_plan.default_action, snapshot_type: catch_plan.snapshot_type, rt_name: mIRLowering__runtime_binding_name(&self), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }];
      MUTABLE outer_fn = FnDef{ name: mIRLowering__zig_safe_name(self, node.name), params: COPY params_mir, ret_type: COPY return_type_str, body: TRY (mIRLowering__append_ownership_transfers_for_mir_body(&self, outer_body)), visibility: COPY vis, can_fail: FALSE, comptime_params: comptime_params, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
      RETURN MIRLoweringReturnValue{ ArrayValue: COPY [Emittable{ FnDef: COPY inner_fn }, Emittable{ FnDef: COPY outer_fn }] };
    ELSE
      RETURN MIRLoweringReturnValue{ FnDef: COPY FnDef{ name: mIRLowering__zig_safe_name(self, node.name), params: COPY params_mir, ret_type: COPY return_type_str, body: TRY (mIRLowering__append_ownership_transfers_for_mir_body(&self, (prologue + body_mir))), visibility: COPY vis, can_fail: FALSE, comptime_params: comptime_params, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
END
PRIVATE FN mIRLowering__function_uses_node_store?(MUTABLE self: MIRLowering, node: FunctionDef) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node.params |> ANY TRY (type__node_reference?((TRY (type__new(TypeConstructionInput{ Type: COPY _.type }))))) THEN
      RETURN TRUE;
    END
    MUTABLE return_type: ?Type = COPY node.return_type;
    IF return_type EXISTS AS return_type_value THEN
      IF TRY (type__node_reference?(return_type_value)) THEN
      RETURN TRUE;
    END
    END
    MUTABLE found: Bool = FALSE;
    aST__each_locatable_list(node.body, FALSE, %(candidate: Locatable) USE(MUTABLE found) -> {
    # Ruby breaks out of the walk; a CLEAR lambda cannot, so the first hit
    # latches and every later candidate returns immediately.
    IF found THEN
        RETURN;
    END
    MUTABLE type = TRY (aST__full_type_mut(candidate));
    MUTABLE coerced: ?Type = locatable__coerced_type_object(candidate);
    IF (TRY (type__node_reference?(type)) OR (IF coerced EXISTS AS coerced_type THEN type__node_reference?(coerced_type) ELSE FALSE END)) THEN
        found = TRUE;
        RETURN;
    END
    rubyToClearVoid__mir_lowering()
    });
    RETURN found;
}
END
PRIVATE FN mIRLowering__function_lowering_context(MUTABLE self: MIRLowering, MUTABLE node: FunctionDef, final_type: String, return_type_node: ReturnTypeNode, fn_needs_rt: Bool, param_facts: []FunctionParamFact) RETURNS !FunctionLoweringContext ->
    MUTABLE mutable_scalar_params: [Set]String = Set[];
    MUTABLE collection_params: [Set]String = Set[];
    MUTABLE protocol_map_allocators: {String}String = {};
    FOR _ IN param_facts DO
    IF _.mutable_scalar THEN
        &mutable_scalar_params.insert(COPY _.name);
    END
    IF _.collection_param THEN
        &collection_params.insert(COPY _.name);
    END
    IF _.protocol_map THEN
        protocol_map_allocators[_.name] = mIRLowering__protocol_map_allocator_name(self, _.name);
    END
    END
    MUTABLE bindings: {String}CleanupEntry@multiowned = {};
    IF node.cleanup_bindings EXISTS AS declared_bindings THEN
      bindings = CAST(COPY declared_bindings AS {String}CleanupEntry@multiowned);
    END
    FOR _ IN collection_params DO
    bindings[_] = (bindings[_] OR_ELSE cleanupEntry__no_cleanup(:heap, :heap));
    END
    MUTABLE has_catch = ((TRY (mIRLowering__function_catch_clauses(self, node))).length() > 0);
    MUTABLE return_type_info: Type = TRY (type__from_node_mut( CAST(return_type_node AS ?Locatable), "function lowering return type"));
    MUTABLE return_payload: ?Type = TRY (type__plain_return_payload_type(return_type_info));
    RETURN FunctionLoweringContext{ bindings: bindings, binding_types: {}, collection_params: COPY collection_params, protocol_map_allocators: COPY protocol_map_allocators, mutable_scalar_params: COPY mutable_scalar_params, param_names: COPY (node.params |> SELECT CAST(_.name AS String)) |> DISTINCT _, takes_param_names: COPY (node.params |> WHERE (_.takes OR_ELSE FALSE)) |> SELECT CAST(_.name AS String) |> DISTINCT _, heap_carry_return_vars: COPY mIRLowering__typed_name_set(&self, node.heap_carry_return_vars), returned_names: COPY TRY (mIRLowering__collect_fn_returned_names(&self, node.body)), snapshot_types: COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_291: ?[Set]String = NIL;
    IF has_catch THEN
      rtoc_ternary_value_291 = mIRLowering__typed_name_set(&self, node.snapshot_types);
    ELSE
      rtoc_ternary_value_291 = Set[];
    END
    rtoc_ternary_value_291? }, fn_alloc_marked_names: COPY node.params |> REDUCE({"rt": TRUE}) {
    acc[mIRLowering__zig_safe_name(self, CAST(_.name AS String))] = TRUE;
    acc
    }, lowered_alloc_names: COPY Set[], lowered_guarded_cleanup_names: COPY Set[], decl_zig_name_map: {}, guarded_cleanup_names: {}, fn_name_rename_map: {}, has_rt: COPY fn_needs_rt, tail_call: (node.tail_call == TRUE), zig_name: COPY mIRLowering__zig_safe_name(self, node.name), return_payload_zig: COPY IF return_payload != NIL THEN
      TRY (type__zig_type(return_payload))
    ELSE
      final_type
    END, return_type: COPY return_type_info, heap_carry_return: (TRUE AND (node.heap_carry_return == TRUE)), has_catch: has_catch, source_start_line: (node.source_range?.start_line OR_ELSE 0) };
END
PRIVATE FN mIRLowering__activate_function_context(MUTABLE self: MIRLowering, context: FunctionLoweringContext) RETURNS Void ->
    MUTABLE rtoc_mutable_receiver_292 = mIRLowering__function_state(&self);
    functionState__activate_mut(&rtoc_mutable_receiver_292, context);
END
PRIVATE FN mIRLowering__typed_name_set(MUTABLE self: MIRLowering, values: ?[Set]String) RETURNS [Set]String ->
    MUTABLE names: [Set]String = Set[];
    IF values EXISTS AS present_values THEN
        FOR _ IN present_values DO
        &names.insert(COPY _);
        END
    END
    RETURN names;
END
PRIVATE FN mIRLowering__finalized_needs_rt_mut(MUTABLE self: MIRLowering, node: FunctionDef) RETURNS !?Bool ->
    IF (node.thunk_plan OR node.mutual_thunk_plan) THEN
      RETURN TRUE;
    END
    IF ((node.needs_rt == TRUE) OR (node.needs_rt == FALSE)) THEN
      RETURN node.needs_rt;
    END
    panic("function {} missing finalized needs_rt metadata before MIR lowering");
END
PRIVATE FN mIRLowering__function_return_retains_shared_handle?(MUTABLE self: MIRLowering, node: FunctionDef) RETURNS !Bool ->
    MUTABLE ret: ?Type = COPY node.return_type;
    IF !((TRUE AND TRY (type__any_rc?( UNWRAP (ret))))) THEN
      RETURN FALSE;
    END
    MUTABLE found: Bool = FALSE;
    aST__each_locatable_list(node.body, FALSE, %(child: Locatable) USE(MUTABLE self) -> {
    IF !((IF child IS_A ReturnNode AS return_node THEN return_node.value ELSE FALSE END)) THEN
        RETURN;
    END
    IF (TRY (mIRLowering__rc_retain_needed?(&self, UNWRAP (aST__node_value(child)))) AND !(TRY (mIRLowering__return_transfers_heap_binding?(&self, UNWRAP (aST__node_value(child)))))) THEN
        found = TRUE;
    END
    rubyToClearVoid__mir_lowering()
    });
    RETURN found;
END
PRIVATE FN mIRLowering__function_param_facts(MUTABLE self: MIRLowering, params: []Param, generic_params: []GenericParamDecl) RETURNS ![]FunctionParamFact ->
    RETURN params |> SELECT TRY (mIRLowering__function_param_fact(&self, _, generic_params));
END
PRIVATE FN mIRLowering__function_param_fact(MUTABLE self: MIRLowering, param: Param, generic_params: []GenericParamDecl) RETURNS !FunctionParamFact ->
    MUTABLE type_info = COPY param.type;
    MUTABLE base_zig = TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY param.type }, TRUE));
    MUTABLE protocol_map_param = generic_params |> ANY ((symbol(_.name) == type__resolved(type_info)) AND (_.bounds |> ANY (type__resolved(_.type) == :Map)));
    MUTABLE collection_param = !(!((((type__needs_pointer_passing?(type_info) OR (((param.mutable != NIL) AND type__list_collection?(type_info)))) OR protocol_map_param))));
    MUTABLE mutable_scalar = !(!(((((((param.mutable != NIL) AND !(protocol_map_param)) AND !(type__collection?(type_info))) AND !(type__needs_pointer_passing?(type_info))) AND !((base_zig.startsWith?("[]") OR base_zig.startsWith?("*")))))));
    MUTABLE zig_type: String = "";
    IF protocol_map_param THEN
      zig_type = "*${base_zig}";
    ELSE
      zig_type = TRY (mIRLowering__function_param_zig_type(&self, param, type_info, base_zig));
    END
    IF (mutable_scalar AND (zig_type != "anytype")) THEN
      zig_type = "*${zig_type}";
    END
    RETURN FunctionParamFact{ param: COPY param, name: COPY CAST(param.name AS String), mir_name: COPY IF mutable_scalar THEN
      "_m_${param.name}"
    ELSE
      mIRLowering__zig_safe_name(self, CAST(param.name AS String))
    END, zig_type: COPY zig_type, mutable_scalar: mutable_scalar, collection_param: collection_param, pointer_passed: (collection_param OR mutable_scalar), protocol_map: protocol_map_param };
END
PRIVATE FN mIRLowering__protocol_map_allocator_name(self: MIRLowering, name: String) RETURNS String ->
    RETURN "__clear_map_alloc_${name}";
END
PRIVATE FN mIRLowering__function_param_zig_type(MUTABLE self: MIRLowering, param: Param, type_info: Type, base_zig: String) RETURNS !String ->
    MUTABLE type_sym = type__resolved(param.type);
    MUTABLE is_user_struct = (TRY (mIRLowering__struct_schemas(&self))).contains?(type_sym);
    MUTABLE polymorphic_generic_struct = (((param.mutable != NIL) AND type__generic_instance?(type_info)) AND (TRY (mIRLowering__struct_schemas(&self))).contains?(type__generic_base(type_info)));
    MUTABLE sym: ?SymbolEntry@multiowned = COPY param.symbol;
    MUTABLE atomic_sync = FALSE;
    IF sym EXISTS AS sym_value THEN
      MUTABLE families: ?[Set]String@symbol = COPY sym_value.sync_families;
      atomic_sync = (symbolEntry__atomic?(sym_value) OR (IF families EXISTS AS families_value THEN families_value.contains?(:ATOMIC) ELSE FALSE END));
    END
    IF (type__shared?(type_info) AND type__generic_type_parameter?(type_info)) THEN
      RETURN COPY "CheatLib.Arc(${type__resolved(type_info)})";
    END
    IF (IF sym != NIL THEN
      { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_293 = CAST(sym AS SymbolEntry);
    symbolEntry__kept_identity(rtoc_local_receiver_293) }
    ELSE
      NIL
    END) THEN
      MUTABLE payload = type_sym;
      IF type__optional?(type_info) THEN
        IF TRY (type__wrapped_type(type_info)) EXISTS AS wrapped_payload THEN
          payload = type__resolved(wrapped_payload);
        END
      END
      MUTABLE handle = "CheatLib.Rc(${payload})";
      IF type__optional?(type_info) THEN
        RETURN COPY "?${handle}";
      ELSE
        RETURN handle;
      END
    END
    IF (((param.takes OR_ELSE FALSE) AND TRY (type__any_rc?(type_info))) AND type__collection?(type_info)) THEN
      RETURN COPY "*const ${base_zig}";
    END
    IF ((((is_user_struct OR polymorphic_generic_struct) OR type__collection?(type_info)) OR type__canonical_stream?(type_info)) OR atomic_sync) THEN
      RETURN COPY "anytype";
    END
    RETURN COPY base_zig;
END
PRIVATE FN mIRLowering__body_has_faulting_alloc?(MUTABLE self: MIRLowering, body: []Emittable) RETURNS !Bool ->
    MUTABLE found: Bool = FALSE;
    TRY (mIR__each_node(NodeRoot{ ArrayValue: COPY body }, %(mir: Emittable) USE(MUTABLE found, MUTABLE self) -> {
    IF found THEN
        RETURN;
    END
    IF !emittable__expr?(mir) THEN
        RETURN;
    END
    IF (TRY (mIRLowering__mir_allocates?(&self, mir)) OR (((IF mir IS_A MIRMethodCall AS mir_method_call THEN (mir_method_call.method == "bind") ELSE FALSE END) AND (emittable__try_wrap(mir) OR_ELSE FALSE)))) THEN
        found = TRUE;
    END
    rubyToClearVoid__mir_lowering()
    }));
    RETURN found;
END
PRIVATE FN mIRLowering__faulting_return_type_str(self: MIRLowering, final_type: String, node: FunctionDef) RETURNS String ->
    RETURN zigType__fallible_return_type_for(zigType__new(final_type), functionDef__recursive_reentrance_declared?(node));
END
PRIVATE FN mIRLowering__default_catch_body(self: MIRLowering, node: FunctionDef) RETURNS ![]Locatable ->
    MUTABLE body: ?[]Locatable = COPY node.default_catch;
    IF UNWRAP (body) IS_A []Any THEN
      RETURN COPY UNWRAP (body);
    ELSE
      RETURN CAST(List[] AS []Locatable);
    END
END
PRIVATE FN mIRLowering__function_catch_clauses(self: MIRLowering, node: FunctionDef) RETURNS ![]CatchClause ->
    RETURN COPY node.catch_clauses;
END
PRIVATE FN mIRLowering__has_default_catch?(self: MIRLowering, MUTABLE node: FunctionDef) RETURNS !Bool ->
    RETURN !(((TRY (mIRLowering__default_catch_body(self, node))).length() == 0));
END
PRIVATE FN mIRLowering__function_entry_plan(MUTABLE self: MIRLowering, MUTABLE node: FunctionDef, fn_needs_rt: Bool, mutable_scalar_params: [Set]String, used_names: [Set]String) RETURNS !FunctionEntryPlan ->
    MUTABLE prologue: []Emittable = List[];
    prologue = ruby_array_concat_Emittable__mir_lowering(prologue, TRY (mIRLowering__recursion_yield_prologue(&self, &node, fn_needs_rt)));
    prologue = ruby_array_concat_Emittable__mir_lowering(prologue, TRY (mIRLowering__reentrance_guard_prologue(self, node)));
    prologue = ruby_array_concat_Emittable__mir_lowering(prologue, TRY (mIRLowering__runtime_frame_prologue(&self, node, fn_needs_rt)));
    prologue = ruby_array_concat_Emittable__mir_lowering(prologue, TRY (mIRLowering__unused_param_suppressions(self, node, mutable_scalar_params, used_names)));
    prologue = ruby_array_concat_Emittable__mir_lowering(prologue, TRY (mIRLowering__mutable_scalar_param_shadows(self, mutable_scalar_params, used_names)));
    MUTABLE takes_mir = TRY (mIRLowering__takes_param_ownership_mir(&self, node));
    TRY (mIRLowering__record_lowered_entry_markers_mut(&self, takes_mir));
    RETURN FunctionEntryPlan{ prologue: COPY prologue, takes_mir: COPY takes_mir };
END
PRIVATE FN mIRLowering__runtime_frame_prologue(MUTABLE self: MIRLowering, node: FunctionDef, fn_needs_rt: Bool) RETURNS ![]Emittable ->
    IF !(fn_needs_rt) THEN
      RETURN CAST(List[] AS []Emittable);
    END
    MUTABLE ret_type_obj: Type = TRY (functionDef__lowering_return_type(node));
    MUTABLE bare_ret = TRY (type__success_type(ret_type_obj));
    MUTABLE returns_value_type = ((((type__void?(bare_ret) OR type__primitive?(bare_ret)) OR type__resource?(bare_ret)) OR (TRY (mIRLowering__enum_schemas(&self))).contains?(type__resolved(bare_ret))) OR (TRY (mIRLowering__union_schemas(&self))).contains?(type__resolved(bare_ret)));
    MUTABLE returns_string = TRY (type__string?(bare_ret));
    MUTABLE heap_carry_return = !(!(((TRUE AND (node.heap_carry_return OR_ELSE FALSE)))));
    MUTABLE has_frame_bindings = (node.uses_frame OR_ELSE FALSE);
    IF node.cleanup_bindings EXISTS AS declared_cleanup_bindings THEN
      has_frame_bindings = FALSE;
      FOR binding_name IN declared_cleanup_bindings.keys() DO
        IF cleanupEntry__frame?(UNWRAP (declared_cleanup_bindings[binding_name])) THEN
          has_frame_bindings = TRUE;
        END
      END
    END
    MUTABLE out: []Emittable = [Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ Call: COPY Call{ callee: "@setEvalBranchQuota", args: [Emittable{ Lit: COPY Lit{ value: "100000", lowered_node_id: NIL, ownership_consumption: NIL } }], try_wrap: FALSE, owned_return: FALSE, callable_contract: TRY (callableContract__no_ownership(1)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }];
    IF mIRLowering__runtime_frame_save_required?(self, has_frame_bindings, returns_value_type, returns_string, heap_carry_return) THEN
      &out.append(Emittable{ FrameSave: COPY FrameSave{ rt_expr: mIRLowering__runtime_binding_name(&self), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
      &out.append(Emittable{ FrameRestore: COPY FrameRestore{ rt_expr: mIRLowering__runtime_binding_name(&self), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    ELSE
      &out.append(Emittable{ Suppress: COPY Suppress{ name: "rt", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    END
    RETURN out;
END
PRIVATE FN mIRLowering__runtime_frame_save_required?(self: MIRLowering, has_frame_bindings: Bool, returns_value_type: Bool, returns_string: Bool, heap_carry_return: Bool) RETURNS Bool ->
    RETURN (has_frame_bindings AND ((returns_value_type OR ((returns_string AND heap_carry_return)))));
END
PRIVATE FN mIRLowering__reentrance_guard_prologue(self: MIRLowering, node: FunctionDef) RETURNS ![]Emittable ->
    IF !(functionDef__reentrance_guard_required?(node)) THEN
      RETURN CAST(List[] AS []Emittable);
    END
    IF node.max_depth_n THEN
      MUTABLE enter_call = Call{ callee: "safety.enterDepth", args: [Emittable{ Call: COPY Call{ callee: "@src", args: List[], try_wrap: FALSE, owned_return: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL } }, Emittable{ Lit: COPY Lit{ value: COPY CAST(node.max_depth_n AS String), lowered_node_id: NIL, ownership_consumption: NIL } }], try_wrap: FALSE, owned_return: FALSE, callable_contract: TRY (callableContract__no_ownership(2)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL };
      RETURN CAST([Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ TryExpr: COPY TryExpr{ expr: Emittable{ Call: COPY enter_call }, lowered_node_id: NIL, ownership_consumption: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ MIRDeferStmt: COPY MIRDeferStmt{ body: DeferBody{ Emittable: COPY CAST(COPY Call{ callee: "safety.exitDepth", args: [Emittable{ Call: COPY Call{ callee: "@src", args: List[], try_wrap: FALSE, owned_return: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL } }], try_wrap: FALSE, owned_return: FALSE, callable_contract: TRY (callableContract__no_ownership(1)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL } AS Emittable) }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable);
    ELSE
      MUTABLE guard_init = Let{ name: COPY "_guard", init: Emittable{ TryExpr: COPY TryExpr{ expr: Emittable{ Call: COPY Call{ callee: "safety.StackGuard.enter", args: [Emittable{ Call: COPY Call{ callee: "@src", args: List[], try_wrap: FALSE, owned_return: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL } }], try_wrap: FALSE, owned_return: FALSE, callable_contract: TRY (callableContract__no_ownership(1)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL };
      MUTABLE guard_push = ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: "_guard", lowered_node_id: NIL, ownership_consumption: NIL } }, method: "push", args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
      MUTABLE guard_defer = MIRDeferStmt{ body: DeferBody{ Emittable: COPY CAST(COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: "_guard", lowered_node_id: NIL, ownership_consumption: NIL } }, method: "pop", args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } AS Emittable) }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
      RETURN CAST([Emittable{ Let: COPY guard_init }, Emittable{ ExprStmt: COPY guard_push }, Emittable{ MIRDeferStmt: COPY guard_defer }] AS []Emittable);
    END
END
PRIVATE FN mIRLowering__recursion_yield_prologue(MUTABLE self: MIRLowering, MUTABLE node: FunctionDef, fn_needs_rt: Bool) RETURNS ![]Emittable ->
    IF !((fn_needs_rt AND mIRLowering__needs_recursion_yield?(self, node))) THEN
      RETURN CAST(List[] AS []Emittable);
    END
    RETURN CAST([Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: mIRLowering__runtime_binding_name(&self), lowered_node_id: NIL, ownership_consumption: NIL } }, method: "checkYield", args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable);
END
PRIVATE FN mIRLowering__unused_param_suppressions(self: MIRLowering, node: FunctionDef, mutable_scalar_params: [Set]String, used_names: [Set]String) RETURNS ![]Emittable ->
    MUTABLE out: []Emittable = List[];
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < node.params.length() DO
      IF used_names.contains?(node.params[rtoc_idx]?.name) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE suppress_name: String = "";
        IF mutable_scalar_params.contains?(node.params[rtoc_idx]?.name) THEN
          suppress_name = "_m_${UNWRAP (node.params[rtoc_idx]?.name)}";
        ELSE
          suppress_name = mIRLowering__zig_safe_name(self, UNWRAP (node.params[rtoc_idx]?.name));
        END
      &out.append(Emittable{ Suppress: COPY Suppress{ name: COPY suppress_name, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN out;
END
PRIVATE FN mIRLowering__mutable_scalar_param_shadows(self: MIRLowering, mutable_scalar_params: [Set]String, used_names: [Set]String) RETURNS ![]Emittable ->
    MUTABLE out: []Emittable = List[];
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < mutable_scalar_params.length() DO
      IF !(used_names.contains?(mutable_scalar_params[rtoc_idx])) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE ptr_name = "_m_${UNWRAP (mutable_scalar_params[rtoc_idx])}";
      MUTABLE shadow_name = mIRLowering__zig_safe_name(self, UNWRAP (COPY mutable_scalar_params[rtoc_idx]));
      &out.append(Emittable{ Let: COPY Let{ name: COPY shadow_name, init: Emittable{ Deref: COPY Deref{ expr: Emittable{ Ident: COPY Ident{ name: COPY ptr_name, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: NIL, suppression: "_ = &${shadow_name};", alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
      &out.append(Emittable{ MIRDeferStmt: COPY MIRDeferStmt{ body: DeferBody{ Emittable: COPY CAST(COPY ScopeBlock{ body: [Emittable{ Set: COPY Set{ target: Emittable{ Deref: COPY Deref{ expr: Emittable{ Ident: COPY Ident{ name: COPY ptr_name, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Ident: COPY Ident{ name: COPY shadow_name, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN out;
END
PRIVATE FN mIRLowering__kept_store_liveness(MUTABLE self: MIRLowering) RETURNS ?KeptEdgeLiveness@multiowned ->
    MUTABLE fn: ?FunctionDef@multiowned = COPY self.kept_liveness_fn;
    IF !(fn EXISTS) THEN
      RETURN NIL;
    END
    IF locatable__body( Locatable{ FunctionDef: COPY fn }) EXISTS AS fn_body THEN
      self.kept_liveness = (self.kept_liveness OR_ELSE keptEdgeLiveness__new(fn_body));
    END
    RETURN COPY self.kept_liveness;
END
PRIVATE FN mIRLowering__takes_param_ownership_mir(MUTABLE self: MIRLowering, node: FunctionDef) RETURNS ![]Emittable ->
    MUTABLE out: []Emittable = List[];
    MUTABLE rtoc_each_items_316 = (node.params |> WHERE ((_.takes OR_ELSE FALSE) OR (IF _.symbol != NIL THEN
      { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_315 = CAST(_.symbol AS SymbolEntry);
    symbolEntry__kept_identity(rtoc_local_receiver_315) }
    ELSE
      NIL
    END)));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_316.length() DO
      MUTABLE entry = ((TRY (functionState__bindings(mIRLowering__function_state(&self))))[CAST((rtoc_each_items_316[rtoc_idx].name) AS String)] OR_ELSE cleanupEntry__none());
      MUTABLE ti = COPY rtoc_each_items_316[rtoc_idx].type;
      IF !(((((IF rtoc_each_items_316[rtoc_idx].symbol != NIL THEN
          { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_317 = CAST((rtoc_each_items_316[rtoc_idx].symbol) AS SymbolEntry);
      symbolEntry__kept_identity(rtoc_local_receiver_317) }
        ELSE
          NIL
        END) != NIL) OR TRY (mIRLowering__ownership_tracked_transfer_type?(&self, ti))) OR ((cleanupEntry__present?(entry) AND cleanupEntry__heap?(entry))))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE kept = (!(rtoc_each_items_316[rtoc_idx].takes) AND !(((IF rtoc_each_items_316[rtoc_idx].symbol != NIL THEN
          { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_318 = CAST((rtoc_each_items_316[rtoc_idx].symbol) AS SymbolEntry);
      symbolEntry__kept_identity(rtoc_local_receiver_318) }
        ELSE
          NIL
        END) == NIL)));
      IF kept THEN
          ti = TRY (type__new(TypeConstructionInput{ StringValue: COPY CAST(type__resolved(ti) AS String) }, :multiowned, NIL, NIL, :heap));
      END
      MUTABLE drop_entry = COPY entry;
      MUTABLE alloc = IF cleanupEntry__present?(entry) THEN
          cleanupEntry__alloc(entry)
        ELSE
          :heap
        END;
      MUTABLE scope = IF cleanupEntry__present?(entry) THEN
          cleanupEntry__scope(entry)
        ELSE
          :heap
        END;
      MUTABLE mark = AllocMark{ name: COPY CAST((emittable__name( CAST(rtoc_each_items_316[rtoc_idx] AS Emittable))) AS String), alloc: COPY alloc, type_info: COPY ti, scope: COPY scope, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
      IF cleanupEntry__needs_cleanup?(entry) THEN
          IF !(kept) THEN
            TRY (mIRLowering__build_drop_entry_mut(&self, &drop_entry, ti, NIL));
          END
          IF cleanupEntry__has_moved_guard?(drop_entry) THEN
            MUTABLE rtoc_index_receiver_319 = mIRLowering__function_state(&self).guarded_cleanup_names;
            rtoc_index_receiver_319[mIRLowering__zig_safe_name(self, CAST((emittable__name( CAST(rtoc_each_items_316[rtoc_idx] AS Emittable))) AS String))] = TRUE;
          END
          out = ruby_array_concat_Emittable__mir_lowering(out, CAST(TRY (materializationPacket__statements((materializationPacket__markers(mark, CAST(Cleanup{ name: mIRLowering__zig_safe_name(self, CAST((emittable__name( CAST(rtoc_each_items_316[rtoc_idx] AS Emittable))) AS String)), cleanup_entry: drop_entry, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable))))) AS []Emittable));
      ELSE
          out = ruby_array_concat_Emittable__mir_lowering(out, CAST(TRY (materializationPacket__statements(materializationPacket__markers(mark))) AS []Emittable));
      END
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN out;
END
PRIVATE FN mIRLowering__record_lowered_entry_markers_mut(MUTABLE self: MIRLowering, nodes: []Emittable) RETURNS !Void ->
    FOR _ IN nodes DO
    IF _ IS_A AllocMark AS alloc_mark THEN
        &self.state.function_state.lowered_alloc_names.insert(COPY alloc_mark.name);
    END
    IF (((_ IS_A Cleanup OR _ IS_A ErrCleanup)) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_322 = TRY (ownedCompositeMaterialization__cleanup_entry( CAST(_ AS OwnedCompositeMaterialization)));
    cleanupEntry__has_moved_guard?(rtoc_local_receiver_322) }) THEN
        &self.state.function_state.lowered_guarded_cleanup_names.insert(COPY CAST(emittable__name(_) AS String));
    END
    END
END
PRIVATE FN mIRLowering__build_post_inner_fn(self: MIRLowering, node: FunctionDef, params_mir: []MIRParam, return_type_str: String, prologue: []Emittable, body_mir: []Emittable, comptime_params: []String) RETURNS FnDef ->
    MUTABLE inner_name = "__${mIRLowering__zig_safe_name(self, node.name)}_post_body";
    RETURN FnDef{ name: COPY inner_name, params: COPY params_mir, ret_type: COPY return_type_str, body: COPY (prologue + body_mir), visibility: :private, can_fail: FALSE, comptime_params: COPY comptime_params, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN mIRLowering__build_post_outer_fn(MUTABLE self: MIRLowering, node: FunctionDef, params_mir: []MIRParam, return_type_str: String, fn_needs_rt: Bool, vis: String@symbol, comptime_params: []String) RETURNS !FnDef ->
    MUTABLE inner_name = "__${mIRLowering__zig_safe_name(self, node.name)}_post_body";
    MUTABLE mutable_scalar = ((((node.params |> WHERE ((_.mutable != NIL) AND !(((TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY _.type }, TRUE))).startsWith?("[]") OR (TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY _.type }, TRUE))).startsWith?("*")))))) |> SELECT _.name)) |> DISTINCT _;
    MUTABLE forward_name = %(p: Param) USE(mutable_scalar) -> {
    IF mutable_scalar.contains?(p.name) THEN
      RETURN "_m_${p.name}";
    ELSE
      RETURN p.name;
    END
    NIL
    };
    MUTABLE arg_idents = node.params |> SELECT Emittable{ Ident: COPY Ident{ name: forward_name(_), lowered_node_id: NIL, ownership_consumption: NIL } };
    IF fn_needs_rt THEN
      arg_idents = ([Emittable{ Ident: COPY Ident{ name: "rt", lowered_node_id: NIL, ownership_consumption: NIL } }] + arg_idents);
    END
    MUTABLE rt_obj: ?Type = COPY node.return_type;
    MUTABLE is_error_union = FALSE;
    MUTABLE payload_type: ?Type = NIL;
    IF rt_obj EXISTS AS return_type_value THEN
      is_error_union = type__error_union?(return_type_value);
      IF is_error_union THEN
        payload_type = TRY (type__payload_type(return_type_value));
      ELSE
        payload_type = COPY return_type_value;
      END
    END
    MUTABLE is_void = (IF payload_type EXISTS AS payload_value THEN type__void?(payload_value) ELSE FALSE END);
    MUTABLE inner_sig = TRY (functionSignature__from_function_def(node));
    MUTABLE inner_contract = callableContract__new(inner_sig, TRY (ownershipContract__new(List[], List[], List[], TRUE)), node.params.length());
    MUTABLE inner_call_mir = Call{ callee: COPY inner_name, args: COPY arg_idents, try_wrap: is_error_union, owned_return: TRY (mIRLowering__call_owned_return?(&self, Node{ FunctionDef: COPY node })), callable_contract: COPY inner_contract, lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL };
    inner_call_mir.result_type = TRY (type__new((IF payload_type EXISTS AS inner_payload THEN TypeConstructionInput{ Type: COPY inner_payload } ELSE TypeConstructionInput{ SymbolValue: :Void } END)));
    MUTABLE check_stmts = (((node.post_clauses OR_ELSE List[]))) |> SELECT {
    MUTABLE expr: Locatable = CAST(UNWRAP (_[:expr]) AS Locatable);
    MUTABLE source: String = CAST((_[:source] OR_ELSE ContractClauseValue{ StringValue: "" }) AS String);
    MUTABLE cond_mir: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(expr)));
    MUTABLE msg_text: String = "DEBUG_POST failed";
      IF !(source.empty?()) THEN
        msg_text = "DEBUG_POST failed: ${source}";
      END
    IfStmt{ cond: Emittable{ MIRUnaryOp: COPY MIRUnaryOp{ op: "!", operand: COPY UNWRAP (cond_mir), lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: [Emittable{ Panic: COPY Panic{ message: COPY msg_text, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL }
    };
    MUTABLE debug_stmts: []Emittable = List[];
    IF !((check_stmts.length() == 0)) THEN
      debug_stmts = [Emittable{ DebugOnly: COPY DebugOnly{ body: check_stmts |> SELECT Emittable{ IfStmt: COPY _ }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }];
    END
    MUTABLE body: []Emittable = List[];
    IF is_void THEN
      body = ([Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ Call: COPY inner_call_mir }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] + debug_stmts  + [Emittable{ ReturnStmt: COPY ReturnStmt{ value: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }]);
    ELSE
      body = ([Emittable{ Let: COPY Let{ name: COPY "result", init: Emittable{ Call: COPY inner_call_mir }, mutable: FALSE, annotation: NIL, suppression: "_ = &result;", alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }] + debug_stmts  + [Emittable{ ReturnStmt: COPY ReturnStmt{ value: Emittable{ Ident: COPY Ident{ name: "result", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }]);
    END
    RETURN FnDef{ name: mIRLowering__zig_safe_name(self, node.name), params: COPY params_mir, ret_type: COPY return_type_str, body: COPY body, visibility: COPY vis, can_fail: FALSE, comptime_params: COPY comptime_params, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN mIRLowering__build_catch_clauses(MUTABLE self: MIRLowering, MUTABLE node: FunctionDef, fn_can_fail: Bool) RETURNS !CatchLoweringPlan ->
    MUTABLE clauses: []MIRCatchClause = List[];
    MUTABLE snap_types: [Set]String = (node.snapshot_types OR_ELSE Set[]);
    MUTABLE snapshot_type_branch_value: ?Type = NIL;
    IF (snap_types.length() == 1) THEN
      FOR snap_type_name IN snap_types DO
        snapshot_type_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol(snap_type_name) }));
      END
    ELSE
      snapshot_type_branch_value = NIL;
    END
    MUTABLE snapshot_type: ?Type = snapshot_type_branch_value;
    FOR _ IN TRY (mIRLowering__function_catch_clauses(self, node)) DO
    MUTABLE clause_mir = TRY (mIRLowering__lower_body(&self, castLocatableListToMIRLoweringLowerableStmtList(_.body)));
    MUTABLE clause_body: []Emittable = clause_mir;
    &clauses.append(MIRCatchClause{ meta: COPY CatchClauseMeta{ kinds: COPY _.kinds |> SELECT _.toString(), types: COPY _.types |> SELECT _.toString(), filter_types: COPY _.filter_types |> SELECT _.toString(), filter_messages: COPY _.filter_messages |> SELECT CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(_))) AS Emittable) }, body: COPY clause_body });
    END
    MUTABLE default_body: []Emittable = List[];
    MUTABLE default_action: CatchDefaultAction = CatchDefaultAction.Unreachable;
    IF TRY (mIRLowering__has_default_catch?(self, &node)) THEN
      MUTABLE default_mir = TRY (mIRLowering__lower_body(&self, castLocatableListToMIRLoweringLowerableStmtList(TRY (mIRLowering__default_catch_body(self, node)))));
      default_body = default_mir;
      default_action = CatchDefaultAction.Body;
    ELSE_IF fn_can_fail THEN
      default_action = CatchDefaultAction.Propagate;
    END
    RETURN CatchLoweringPlan{ clauses: COPY clauses, default_body: COPY default_body, default_action: COPY default_action, snapshot_type: COPY snapshot_type };
END
PRIVATE FN mIRLowering__collect_catch_reassigns(self: MIRLowering, MUTABLE node: FunctionDef) RETURNS ![]CatchReassign ->
    MUTABLE reassigns: []CatchReassign = List[];
    MUTABLE catch_bodies: [][]Locatable = List[];
    FOR _ IN TRY (mIRLowering__function_catch_clauses(self, node)) DO
    IF _.body THEN
      &catch_bodies.append(COPY _.body);
    END
    END
    MUTABLE default_body = TRY (mIRLowering__default_catch_body(self, node));
    IF !((default_body.length() == 0)) THEN
      &catch_bodies.append(default_body);
    END
    FOR _ IN catch_bodies DO
    TRY (mIRLowering__walk_catch_body_for_reassigns(self, CAST(_ AS []Locatable), &reassigns));
    END
    RETURN reassigns;
END
PRIVATE FN mIRLowering__walk_catch_body_for_reassigns(self: MIRLowering, stmts: []Locatable, MUTABLE reassigns: []CatchReassign) RETURNS !Void
  EFFECTS REENTRANT ->
    FOR _ IN stmts DO
    IF _ IS_A BindExpr AS bind_expr THEN
      IF (bind_expr.mode == :assign) THEN
        MUTABLE alloc: ?String@symbol = mIRLowering__infer_catch_value_allocator(self, bind_expr.value);
        IF alloc EXISTS AS alloc_value THEN
          &reassigns.append(CatchReassign{ name: COPY CAST(bind_expr.name AS String), alloc: COPY alloc_value, line: bind_expr.token.line });
        END
      END
    ELSE_IF _ IS_A Assignment AS assignment THEN
      IF assignment.name IS_A Identifier THEN
        MUTABLE alloc: ?String@symbol = mIRLowering__infer_catch_value_allocator(self, assignment.value);
        IF alloc EXISTS AS alloc_value THEN
          &reassigns.append(CatchReassign{ name: COPY CAST(assignmentName__name(assignment.name) AS String), alloc: COPY alloc_value, line: assignment.token.line });
        END
      END
    ELSE_IF _ IS_A IfStatement AS if_statement THEN
      mIRLowering__walk_catch_body_for_reassigns(self, if_statement.then_branch, &reassigns);
      mIRLowering__walk_catch_body_for_reassigns(self, UNWRAP (if_statement.else_branch), &reassigns);
    ELSE_IF _ IS_A MatchStatement AS match_statement THEN
      FOR _ IN match_statement.cases DO
      mIRLowering__walk_catch_body_for_reassigns(self, TRY (matchCase__body(_)), &reassigns);
      END
      mIRLowering__walk_catch_body_for_reassigns(self, UNWRAP (match_statement.default_case), &reassigns);
    END
    END
END
PRIVATE FN mIRLowering__infer_catch_value_allocator(self: MIRLowering, expr: ?Locatable) RETURNS ?String@symbol ->
    IF expr EXISTS AS expr_value THEN
      IF ((aST__node__symbol(expr_value) EXISTS) AND ((locatable__symbol(expr_value) != NIL) AND ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_331 = ((locatable__symbol(expr_value))?);
      symbolEntry__heap_storage?(rtoc_local_receiver_331) } == TRUE))) THEN
        RETURN :heap;
      END
      MUTABLE sym_storage:? = IF (aST__node__symbol(expr_value) EXISTS) THEN
        (IF locatable__symbol(expr_value) != NIL THEN
        symbolEntry__storage(UNWRAP ((locatable__symbol(expr_value))))
      ELSE
        NIL
      END)
      ELSE
        NIL
      END;
      IF symbolEntry__frame_storage_value?(sym_storage) THEN
        RETURN :frame;
      END
      MUTABLE storage: ?String@symbol = aST__node_storage(expr_value);
      IF symbolEntry__heap_storage_value?(storage) THEN
        RETURN :heap;
      END
      IF symbolEntry__frame_storage_value?(storage) THEN
        RETURN :frame;
      END
      RETURN NIL;
    ELSE
      RETURN NIL;
    END
END
PRIVATE FN mIRLowering__with_alias_pointer_shaped?(MUTABLE self: MIRLowering, a: Locatable) RETURNS Bool ->
    IF !(a IS_A Identifier) THEN
      RETURN FALSE;
    END
    MUTABLE name = CAST(aST__node_name(a) AS String);
    MUTABLE owner_map: ?{String}String = COPY mIRLowering__capability_state(&self).with_alias_owner_map;
    IF !((IF owner_map EXISTS AS alias_owners THEN alias_owners.contains?(name) ELSE FALSE END)) THEN
      RETURN FALSE;
    END
    IF mIRLowering__capability_state(&self).if_bind_aliases.contains?(name) THEN
      RETURN mIRLowering__capability_state(&self).if_bind_pointer_aliases.contains?(name);
    END
    IF locatable__symbol(a) EXISTS AS alias_symbol THEN
      RETURN symbolEntry__borrowed_alias(alias_symbol);
    END
    RETURN FALSE;
END
PRIVATE FN mIRLowering__arg_already_pointer_shaped?(MUTABLE self: MIRLowering, a: Locatable) RETURNS Bool ->
    IF !(a IS_A Identifier) THEN
      RETURN FALSE;
    END
    MUTABLE name = CAST(aST__node_name(a) AS String);
    IF mIRLowering__current_function_collection_param?(&self, name) THEN
      RETURN TRUE;
    END
    IF mIRLowering__with_alias_pointer_shaped?(&self, a) THEN
      RETURN TRUE;
    END
    IF mIRLowering__capture_state(&self).current_lambda_pointer_params.contains?(name) THEN
      RETURN TRUE;
    END
    IF mIRLowering__capture_state(&self).current_bg_pointer_captures EXISTS AS bg_pointer_captures THEN
      RETURN bg_pointer_captures.contains?(name);
    END
    RETURN FALSE;
END
PRIVATE FN mIRLowering__wants_ptr?(MUTABLE self: MIRLowering, a: Locatable, ti: ?Type, callee_param: ?Param, callee_param_type: Type, callee_sig: ?FunctionSignature, idx: Int64) RETURNS !Bool ->
    MUTABLE mutable_callee = (IF callee_param EXISTS AS mutable_check_param THEN (mutable_check_param.mutable OR_ELSE FALSE) ELSE FALSE END);
    MUTABLE wants_ptr_mut_list = FALSE;
    IF mutable_callee THEN
      IF callee_param EXISTS AS list_check_param THEN
        wants_ptr_mut_list = type__list_collection?(list_check_param.type);
      END
    END
    MUTABLE wants_ptr_mut_value = ((mutable_callee AND !(wants_ptr_mut_list)) AND !(type__needs_pointer_passing?(callee_param_type)));
    # `T` generic parameters are emitted as an anytype value. Passing a
    # map/list by address here changes the instantiated T to *Map/*List and
    # breaks value-returning generic functions; their own body decides whether
    # to borrow or materialize the concrete payload.
    MUTABLE wants_ptr_intrinsic = FALSE;
    IF ti EXISTS AS arg_type THEN
      wants_ptr_intrinsic = (type__needs_pointer_passing?(arg_type) AND !(type__generic_type_parameter?(callee_param_type)));
    END
    MUTABLE wants_ptr_protocol_map = FALSE;
    IF callee_sig EXISTS AS protocol_sig THEN
      IF callee_param EXISTS AS protocol_param THEN
        wants_ptr_protocol_map = mIRLowering__protocol_map_signature_param?(self, protocol_sig, protocol_param);
      END
    END
    MUTABLE wants_ptr_poly = TRY (mIRLowering__universal_poly_arg_needs_addr?(self, a, callee_sig, idx));
    RETURN ((((wants_ptr_mut_list OR wants_ptr_mut_value) OR wants_ptr_intrinsic) OR wants_ptr_protocol_map) OR wants_ptr_poly);
END
PRIVATE FN mIRLowering__cross_boundary_arg(MUTABLE self: MIRLowering, arg_input: Emittable, MUTABLE a: Locatable, callee_param: ?Param, callee_param_type: Type, callee_sig: ?FunctionSignature, idx: Int64) RETURNS !Emittable ->
    MUTABLE arg = COPY arg_input;
    MUTABLE ti: ?Type = TRY (type__from_node_mut(a, "call boundary argument"));
    MUTABLE moved_arg = (((a IS_A CopyNode OR a IS_A KeepNode) OR a IS_A MoveNode) OR (((((aST__moved?(a) AND !(a IS_A CopyNode)) AND !(a IS_A KeepNode)) AND !(arg IS_A DupeSlice)) AND !(arg IS_A DeepCopy))));
    IF ((((ti != NIL) AND type__symbol?(ti)) AND TRY (type__byte_string?(callee_param_type))) AND ((callee_param == NIL) OR (callee_param.carrier_contract != :monomorphic))) THEN
      MUTABLE widened = FieldGet{ object: COPY arg, field: "bytes", lowered_node_id: NIL, ownership_consumption: NIL };
      IF callee_param?.takes EXISTS AS takes_value THEN
        RETURN Emittable{ DupeSlice: COPY DupeSlice{ source: Emittable{ FieldGet: COPY widened }, alloc: :heap, lowered_node_id: NIL, ownership_consumption: NIL } };
      ELSE
        RETURN Emittable{ FieldGet: COPY widened };
      END
    END
    IF (((callee_param != NIL) AND (callee_param.takes OR_ELSE FALSE)) AND (callee_param.carrier_contract == :monomorphic)) THEN
      IF TRY (mIRLowering__wants_ptr?(&self, a, ti, callee_param, callee_param_type, callee_sig, idx)) THEN
        RETURN Emittable{ AddressOf: COPY AddressOf{ expr: COPY arg, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
      RETURN COPY arg;
    END
    IF ((((((callee_param != NIL) AND (callee_param.takes OR_ELSE FALSE)) AND TRY (type__any_rc?( UNWRAP (ti)))) AND !(TRY (type__any_rc?(callee_param_type)))) AND !(type__generic_type_parameter?(callee_param_type))) AND (callee_param.carrier_contract != :monomorphic)) THEN
      MUTABLE sink_alloc = TRY (mIRLowering__allocator_for_takes_param_mut(&self, callee_param));
      MUTABLE payload = TRY (mIRLowering__rc_payload_value(self, arg, UNWRAP (ti)));
      MUTABLE materialized = DeepCopy{ source: COPY payload, zig_type: COPY TRY (type__zig_type(callee_param_type)), elem_type: NIL, strategy: :full_value, alloc: COPY sink_alloc, copy_shape: deepCopy__copy_shape_for_zig_type(COPY TRY (type__zig_type(callee_param_type))), type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL };
      materialized = castEmittableToDeepCopy(TRY (mIRLowering__hoist_alloc(&self, Emittable{ DeepCopy: COPY materialized }, &a, TRUE)));
      IF TRY (mIRLowering__owned_slice_argument_required?(self, callee_param, moved_arg, UNWRAP (ti), callee_param_type)) THEN
        MUTABLE owned_slice = OwnedSlice{ expr: Emittable{ DeepCopy: COPY materialized }, alloc: COPY sink_alloc, lowered_node_id: NIL, ownership_consumption: NIL };
        RETURN Emittable{ OwnedSlice: COPY castEmittableToOwnedSlice(TRY (mIRLowering__with_ownership_consumption(&self, Emittable{ OwnedSlice: COPY owned_slice }, TRY (mIRLowering__mir_ident_names(self, Emittable{ DeepCopy: COPY materialized })), "MIR::OwnedSlice(managed payload)", :owned_sink, sink_alloc))) };
      END
      IF TRY (mIRLowering__wants_ptr?(&self, a, ti, callee_param, callee_param_type, callee_sig, idx)) THEN
        RETURN Emittable{ AddressOf: COPY AddressOf{ expr: Emittable{ DeepCopy: COPY materialized }, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
      RETURN Emittable{ DeepCopy: COPY materialized };
    END
    IF TRY (mIRLowering__owned_slice_argument_required?(self, callee_param, moved_arg, UNWRAP (ti), callee_param_type)) THEN
      MUTABLE sink_alloc = TRY (mIRLowering__allocator_for_takes_param_mut(&self, callee_param));
      MUTABLE owned_slice = OwnedSlice{ expr: COPY arg, alloc: COPY sink_alloc, lowered_node_id: NIL, ownership_consumption: NIL };
      MUTABLE owns_slice_input = (TRY (mIRLowering__ownership_tracked_transfer_type?(&self, ti)) OR (TRY (mIRLowering__mir_ident_names(self, arg)) |> ANY mIRLowering__function_state(&self).lowered_alloc_names.contains?(_)));
      IF !(owns_slice_input) THEN
        RETURN Emittable{ OwnedSlice: COPY owned_slice };
      END
      RETURN Emittable{ OwnedSlice: COPY castEmittableToOwnedSlice(TRY (mIRLowering__with_ownership_consumption(&self, Emittable{ OwnedSlice: COPY owned_slice }, TRY (mIRLowering__mir_ident_names(self, arg)), "MIR::OwnedSlice", :owned_sink, sink_alloc))) };
    END
    IF callee_param?.takes EXISTS AS takes_value THEN
      MUTABLE sink_alloc = TRY (mIRLowering__allocator_for_takes_param_mut(&self, callee_param));
      MUTABLE placed = TRY (mIRLowering__materialize_owned_sink_value(&self, arg, a, sink_alloc, TypeTypeInput{ Type: COPY callee_param_type }));
      arg = TRY (mIRLowering__hoist_alloc(&self, &placed, &a, TRUE));
    END
    IF ((((callee_param != NIL) AND !(callee_param.takes)) AND arg IS_A Orelse) AND ((TRY (type__recursive_cleanup_shape?( UNWRAP (ti), mIRLowering__mir_schema_lookup(&self))) OR TRY (type__needs_cleanup?( UNWRAP (ti), mIRLowering__mir_schema_lookup(&self)))))) THEN
      MUTABLE arg_alloc = TRY (mIRLowering__placement_for_node(&self, a));
      MUTABLE placed = TRY (mIRLowering__place_owned_orelse_for_destination(&self, castEmittableToOrelse(arg), UNWRAP (ti), arg_alloc));
      arg = TRY (mIRLowering__hoist_alloc(&self, &placed, &a, FALSE, FALSE, FALSE));
    END
    IF (((callee_param != NIL) AND !(callee_param.takes)) AND (((arg IS_A StructInit OR arg IS_A TupleLiteral) OR arg IS_A ArrayInit))) THEN
      arg = TRY (mIRLowering__hoist_alloc(&self, &arg, &a, FALSE, FALSE, FALSE, TRY (mIRLowering__placement_for_node(&self, a))));
    END
    IF TRY (mIRLowering__borrowed_array_argument_required?(self, UNWRAP (ti), a, callee_param_type)) THEN
      RETURN Emittable{ ItemsAccess: COPY ItemsAccess{ expr: COPY arg, safe: TRUE, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF (((callee_param != NIL) AND (callee_param.mutable OR_ELSE FALSE)) AND symbolEntry__always_mutable_sync?(type__sync( UNWRAP (ti)))) THEN
      RETURN Emittable{ AddressOf: COPY AddressOf{ expr: Emittable{ FieldGet: COPY FieldGet{ object: COPY arg, field: "data", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF (((mIRLowering__with_alias_pointer_shaped?(&self, a) AND (callee_param != NIL)) AND !(callee_param.mutable)) AND !(type__needs_pointer_passing?(callee_param_type))) THEN
      RETURN Emittable{ Deref: COPY Deref{ expr: COPY arg, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF !(TRY (mIRLowering__wants_ptr?(&self, a, ti, callee_param, callee_param_type, callee_sig, idx))) THEN
      RETURN COPY arg;
    END
    IF mIRLowering__arg_already_pointer_shaped?(&self, a) THEN
      RETURN COPY arg;
    END
    IF (((callee_param != NIL) AND (callee_param.mutable OR_ELSE FALSE)) AND (aST__root_identifier(a) == NIL)) THEN
      MUTABLE arg = TRY (mIRLowering__materialize_mutable_call_temporary(&self, &arg, &a));
    END
    RETURN Emittable{ AddressOf: COPY AddressOf{ expr: COPY arg, lowered_node_id: NIL, ownership_consumption: NIL } };
END
PRIVATE FN mIRLowering__materialize_mutable_call_temporary(MUTABLE self: MIRLowering, MUTABLE arg: Emittable, MUTABLE ast_arg: Locatable) RETURNS !Emittable ->
    MUTABLE hoisted = TRY (mIRLowering__hoist_alloc(&self, &arg, &ast_arg, FALSE, TRUE));
    IF !(mir__same_node?(hoisted, arg)) THEN
      RETURN hoisted;
    END
    MUTABLE owned_temp: ?Let = mIRLowering__pending_owned_let(&self, arg);
    IF owned_temp EXISTS AS owned_temp_value THEN
      MUTABLE owned_temp_value_mutable = COPY owned_temp_value;
      owned_temp_value_mutable.mutable = TRUE;
      RETURN COPY arg;
    END
    MUTABLE name = "__mutable_arg_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_332 = mIRLowering__lowering_counters(&self);
    mIRLoweringGeneratedId__to_s(mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_332)) }}";
    &self.state.function_state.pending_stmts.append(CAST(Let{ name: COPY name, init: COPY arg, mutable: TRUE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } AS Emittable));
    RETURN Emittable{ Ident: COPY Ident{ name: COPY name, lowered_node_id: NIL, ownership_consumption: NIL } };
END
PRIVATE FN mIRLowering__pending_owned_let(MUTABLE self: MIRLowering, arg: Emittable) RETURNS ?Let ->
    IF arg IS_A Ident AS ident THEN
      MUTABLE name = COPY ident.name;
      RETURN CAST(mIRLowering__function_state(&self).pending_stmts |> FIND (_ IS_A Let AND (emittable__name(_) == name)) AS ?Let);
    ELSE
      RETURN NIL;
    END
END
PRIVATE FN mIRLowering__owned_slice_argument_required?(self: MIRLowering, callee_param: ?Param, moved_arg: Bool, ti: Type, callee_param_type: Type) RETURNS !Bool ->
    RETURN !(!(((((((callee_param != NIL) AND (callee_param.takes OR_ELSE FALSE)) AND moved_arg) AND TRY (type__direct_indexable_collection?(ti))) AND !(type__collection?(callee_param_type))))));
END
PRIVATE FN mIRLowering__borrowed_array_argument_required?(self: MIRLowering, ti: Type, ast_arg: Locatable, callee_param_type: Type) RETURNS !Bool ->
    RETURN (((TRY (type__borrowed_array_argument?(ti)) AND !(ast_arg IS_A MoveNode)) AND !(type__collection?(callee_param_type))) AND !(type__generic_type_parameter?(callee_param_type)));
END
PRIVATE FN mIRLowering__callable_contract_for(MUTABLE self: MIRLowering, sig: ?FunctionSignature, ast_args: []Locatable) RETURNS !?CallableContract@multiowned ->
    IF sig EXISTS AS sig_value THEN
      MUTABLE facts = TRY (mIRLowering__call_ownership_facts_for_signature(&self, sig_value, ast_args));
      RETURN callableContract__new(sig_value, TRY (callOwnershipFacts__ownership_contract(facts)), ast_args.length());
    ELSE
      RETURN NIL;
    END
END
PRIVATE FN mIRLowering__callable_contract_for_lowered_args(MUTABLE self: MIRLowering, sig: ?FunctionSignature, ast_args: []Locatable, MUTABLE mir_args: []Emittable, edge_plans: {Int64}CallEdgeOwnershipPlan = {}) RETURNS !?CallableContract@multiowned ->
    IF sig EXISTS AS sig_value THEN
      MUTABLE takes_indices: [Set]Int64 = Set[];
      MUTABLE consumed: []String = List[];
      MUTABLE operands: []OwnershipOperandFact = List[];
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < ast_args.length() DO
      MUTABLE param: ?Param = COPY (TRY (functionSignature__params(sig_value)))[rtoc_idx];
      MUTABLE kept_edge = !((edge_plans[rtoc_idx] == NIL));
      IF kept_edge THEN
            &takes_indices.insert(COPY rtoc_idx);
            FOR _ IN TRY (mIRLowering__ownership_consumed_arg_names(self, &mir_args[rtoc_idx])) DO
        &consumed.append(COPY _);
        &operands.append(ownershipOperandFact__owned_binding(_, TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })), "kept call argument ${rtoc_idx.toString()}", :heap));
            END
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !(mIRLowering__call_arg_consumes_ownership?(&self, ast_args[rtoc_idx]?, param)) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE arg_type = TRY (type__new(TypeConstructionInput{ Type: COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_335: ?Type = NIL;
          IF (TRUE AND locatable__coerced_type_info(UNWRAP (ast_args[rtoc_idx]))) THEN
            rtoc_ternary_value_335 = locatable__coerced_type_info(UNWRAP (ast_args[rtoc_idx]));
          ELSE
            rtoc_ternary_value_335 = TRY (type__from_node_mut(ast_args[rtoc_idx]?, "lowered call ownership argument"));
          END
          rtoc_ternary_value_335? } }));
      &takes_indices.insert(COPY rtoc_idx);
      IF !(TRY (mIRLowering__ownership_tracked_transfer_type?(&self, arg_type))) THEN
            &operands.append(ownershipOperandFact__non_owning(arg_type, "call argument ${rtoc_idx.toString()}"));
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE sink_alloc = TRY (mIRLowering__allocator_for_takes_param_mut(&self, param));
      IF mIRLowering__borrowed_ownership_operand?(self, ast_args[rtoc_idx]?) THEN
            &operands.append(ownershipOperandFact__borrowed_access(TRY (mIRLowering__moved_arg_root(&self, ast_args[rtoc_idx]?)), arg_type, "call argument ${rtoc_idx.toString()}", sink_alloc));
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      FOR _ IN TRY (mIRLowering__ownership_consumed_arg_names(self, &mir_args[rtoc_idx])) DO
      &consumed.append(COPY _);
      END
      FOR _ IN TRY (mIRLowering__ownership_consumed_arg_names(self, &mir_args[rtoc_idx])) DO
      &operands.append(ownershipOperandFact__owned_binding(_, arg_type, "call argument ${rtoc_idx.toString()}", sink_alloc));
      END
    rtoc_idx = rtoc_idx + 1;
      END
      MUTABLE facts = CallOwnershipFacts{ takes_indices: COPY takes_indices, consumed_names: COPY dedupeStrings(consumed), consumed_operands: COPY operands };
      RETURN callableContract__new(sig_value, TRY (callOwnershipFacts__ownership_contract(facts)), ast_args.length());
    ELSE
      RETURN NIL;
    END
END
PRIVATE FN mIRLowering__ownership_consumed_arg_names(self: MIRLowering, MUTABLE arg: ?Emittable) RETURNS ![]String
  EFFECTS REENTRANT ->
    IF UNWRAP (arg) IS_A Ident AS ident THEN
      RETURN CAST([CAST(ident.name AS String)] AS []String);
    ELSE_IF UNWRAP (arg) IS_A OwnedSlice AS owned_slice THEN
      RETURN TRY (mIRLowering__ownership_consumed_arg_names(self, ownedSlice__expr(owned_slice)));
    ELSE_IF UNWRAP (arg) IS_A MIRCast AS mir_cast THEN
      RETURN TRY (mIRLowering__ownership_consumed_arg_names(self, cast__expr(mir_cast)));
    ELSE_IF UNWRAP (arg) IS_A TryExpr AS try_expr THEN
      RETURN TRY (mIRLowering__ownership_consumed_arg_names(self, tryExpr__expr(try_expr)));
    ELSE_IF UNWRAP (arg) IS_A TryOptional AS try_optional THEN
      RETURN TRY (mIRLowering__ownership_consumed_arg_names(self, tryOptional__expr(try_optional)));
    ELSE_IF UNWRAP (arg) IS_A AddressOf AS address_of THEN
      RETURN TRY (mIRLowering__ownership_consumed_arg_names(self, addressOf__expr(address_of)));
    ELSE_IF UNWRAP (arg) IS_A Deref AS deref THEN
      RETURN TRY (mIRLowering__ownership_consumed_arg_names(self, deref__expr(deref)));
    ELSE
      RETURN TRY (mIRLowering__mir_ident_names(self, arg));
    END
END
PRIVATE FN mIRLowering__call_arg_facts(MUTABLE self: MIRLowering, ast_arg: Locatable, callee_sig: ?FunctionSignature, param_index: Int64, edge_plan: ?CallEdgeOwnershipPlan = NIL) RETURNS !CallArgFacts ->
    MUTABLE ti: ?Type = TRY (type__from_node_mut(ast_arg, "call argument"));
    MUTABLE callee_param_branch_value: ?Param = NIL;
    IF callee_sig EXISTS AS callee_sig_value THEN
      callee_param_branch_value = COPY (TRY (functionSignature__params(callee_sig_value)))[param_index];
    ELSE
      callee_param_branch_value = NIL;
    END
    MUTABLE callee_param: ?Param = callee_param_branch_value;
    MUTABLE takes = mIRLowering__call_arg_consumes_ownership?(&self, ast_arg, callee_param);
    MUTABLE callee_param_type: Type = TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }));
    IF callee_param EXISTS AS callee_param_value THEN
      callee_param_type = COPY callee_param_value.type;
    END
    MUTABLE copy_to_owning = ((((IF ast_arg IS_A CopyNode AS copy_node THEN type__collection?(callee_param_type) ELSE FALSE END) AND TRY (type__collection_value?( UNWRAP (ti))))) == TRUE);
    MUTABLE copy_source:? = IF copy_to_owning THEN
      castLocatableToCopyNode(ast_arg).value
    ELSE
      NIL
    END;
    RETURN CallArgFacts{ ast_arg: COPY ast_arg, copy_source: COPY copy_source, type_info: COPY UNWRAP (ti), callee_sig: callee_sig, callee_param: COPY callee_param, callee_param_type: COPY callee_param_type, takes: takes, copy_to_owning: copy_to_owning, arg_alloc: COPY IF takes THEN
      TRY (mIRLowering__allocator_for_takes_param_mut(&self, callee_param))
    ELSE
      :heap
    END, param_index: COPY param_index, edge_plan: ( { MUTABLE rtoc_optional_or_source_336: ?CallEdgeOwnershipPlan = edge_plan; MUTABLE rtoc_optional_or_result_337: ?CallEdgeOwnershipPlan = NIL; IF rtoc_optional_or_source_336 != NIL THEN rtoc_optional_or_result_337 = COPY rtoc_optional_or_source_336; ELSE rtoc_optional_or_result_337 = (aST__node_kept_edge_plan(ast_arg)); END rtoc_optional_or_result_337 } ) };
END
PRIVATE FN mIRLowering__call_ownership_facts_for_signature(MUTABLE self: MIRLowering, sig: FunctionSignature, ast_args: []Locatable) RETURNS !CallOwnershipFacts ->
    MUTABLE takes_indices: [Set]Int64 = Set[];
    MUTABLE consumed: []String = List[];
    MUTABLE operands: []OwnershipOperandFact = List[];
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < ast_args.length() DO
      MUTABLE callee_param: ?Param = COPY (TRY (functionSignature__params(sig)))[rtoc_idx];
      IF !(mIRLowering__call_arg_consumes_ownership?(&self, ast_args[rtoc_idx]?, callee_param)) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE arg_type = TRY (type__new(TypeConstructionInput{ Type: COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_340: ?Type = NIL;
        IF (TRUE AND locatable__coerced_type_info(UNWRAP (ast_args[rtoc_idx]))) THEN
          rtoc_ternary_value_340 = locatable__coerced_type_info(UNWRAP (ast_args[rtoc_idx]));
        ELSE
          rtoc_ternary_value_340 = TRY (type__from_node_mut(ast_args[rtoc_idx]?, "call ownership argument"));
        END
        rtoc_ternary_value_340? } }));
      &takes_indices.insert(COPY rtoc_idx);
      IF !(TRY (mIRLowering__ownership_tracked_transfer_type?(&self, arg_type))) THEN
          &operands.append(ownershipOperandFact__non_owning(arg_type, "call argument ${rtoc_idx.toString()}"));
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE sink_alloc = TRY (mIRLowering__allocator_for_takes_param_mut(&self, callee_param));
      IF mIRLowering__borrowed_ownership_operand?(self, ast_args[rtoc_idx]?) THEN
          &operands.append(ownershipOperandFact__borrowed_access(TRY (mIRLowering__moved_arg_root(&self, ast_args[rtoc_idx]?)), arg_type, "call argument ${rtoc_idx.toString()}", sink_alloc));
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE root: ?String = TRY (mIRLowering__moved_arg_root(&self, ast_args[rtoc_idx]?));
      IF !(root) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE entry = ((TRY (functionState__bindings(mIRLowering__function_state(&self))))[root] OR_ELSE cleanupEntry__none());
      IF !(cleanupEntry__present?(entry)) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      &consumed.append(TRY (mIRLowering__transfer_binding_name(&self, root)));
      &operands.append(ownershipOperandFact__owned_binding(TRY (mIRLowering__transfer_binding_name(&self, root)), arg_type, "call argument ${rtoc_idx.toString()}", sink_alloc));
    rtoc_idx = rtoc_idx + 1;
    END
