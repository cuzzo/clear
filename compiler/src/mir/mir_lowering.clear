PRIVATE FN mIRLowering__auto_lock_assignment_facts(self: MIRLowering, node: Assignment) RETURNS AutoLockAssignmentFacts
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
