PRIVATE FN mIRLowering__lower_step_stmts(MUTABLE self: MIRLowering, stmts: []Locatable, no_result: Bool, ctx_id: ?Int64 = NIL, async_result_shape: ?AsyncResultShape = NIL) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE flat_steps: []ThenStep = ( { MUTABLE rtoc_empty_list_192: []ThenStep = List[]; rtoc_empty_list_192 } );
    FOR _ IN stmts DO
    IF _ IS_A ThenChain AS then_chain THEN
      FOR _ IN then_chain.steps DO
      &flat_steps.append(COPY _);
      END
    ELSE
      &flat_steps.append(ThenStep{ expr: COPY _, binding: NIL });
    END
    END
    IF no_result THEN
      MUTABLE out: []Emittable = ( { MUTABLE rtoc_empty_list_193: []Emittable = List[]; rtoc_empty_list_193 } );
      FOR _ IN flat_steps DO
    MUTABLE chunk = mIRLowering__lower_one_step_to_mir(&rtoc_self_view, _);
    IF chunk THEN
