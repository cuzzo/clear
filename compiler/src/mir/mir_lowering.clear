PRIVATE FN mIRLowering__emit_stackful_bg_block(self: MIRLowering, MUTABLE node: BgBlock, names: BgLoweringNames, types: BgTypePlan, capture: BgCaptureMaterialization, body: BgBodyMaterialization, scheduler: BgSchedulerPlan, rt_name: String, captured: {String}Type, analysis: ?CaptureAnalysis) RETURNS !MIRBgBlock
