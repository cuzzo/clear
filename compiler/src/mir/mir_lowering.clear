PRIVATE FN mIRLowering__list_literal_capability_wrap_needed?(self: MIRLowering, ti: Type) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF type__striped?(ti) THEN
      RETURN FALSE;
    END
    RETURN ((type__any_sync?(ti) OR type__shared?(ti)) OR type__multiowned?(ti));
}
END
PRIVATE FN mIRLowering__wrap_list_literal_capability(self: MIRLowering, inner: Emittable, ti: Type, alloc: String@symbol) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(mIRLowering__list_literal_capability_wrap_needed?(rtoc_self_view, ti)) THEN
      RETURN COPY inner;
    END
    RETURN mIRLowering__compose_capability_wrap(rtoc_self_view, inner, TRY (type__zig_type((TRY (type__bare_data_type(ti))))), ti, alloc);
}
END
PRIVATE FN mIRLowering__lower_default_array_lit(self: MIRLowering, MUTABLE node: DefaultArrayLit) RETURNS !ArrayDefaultInit
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE type_info = &node.full_type_mut("default fixed-array literal");
    MUTABLE elem_type = UNWRAP (TRY (type__element_type(type_info)));
    MUTABLE elem_zig = mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ Type: COPY elem_type });
    MUTABLE count: ?TypeArrayCapacity = type__capacity(type_info);
    IF count? IS_A Int64 AS int64 THEN
      RETURN ArrayDefaultInit{ elem_type: COPY elem_zig, count: COPY int64.toString(), default_value: Emittable{ Lit: COPY mIRLowering__default_array_value(rtoc_self_view, elem_type) }, alloc: :frame, lowered_node_id: type_info, ownership_consumption: NIL, result_type: NIL };
    ELSE
      panic("default fixed-array literal requires an integer capacity");
    END
}
END
PRIVATE FN mIRLowering__default_array_value(self: MIRLowering, elem_type: Type) RETURNS !Lit
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (type__resolved(elem_type) == :Int64) OR (type__resolved(elem_type) == :Int32) OR (type__resolved(elem_type) == :Int16) OR (type__resolved(elem_type) == :Int8) THEN
      RETURN Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL };
    ELSE_IF (type__resolved(elem_type) == :Float64) OR (type__resolved(elem_type) == :Float32) THEN
      RETURN Lit{ value: "0.0", lowered_node_id: NIL, ownership_consumption: NIL };
    ELSE_IF (type__resolved(elem_type) == :String) THEN
      RETURN Lit{ value: "\"\"", lowered_node_id: NIL, ownership_consumption: NIL };
    ELSE_IF (type__resolved(elem_type) == :Bool) OR (type__resolved(elem_type) == :Boolean) THEN
      RETURN Lit{ value: "false", lowered_node_id: NIL, ownership_consumption: NIL };
    ELSE
      panic("unsupported fixed-array default element type {}");
    END
}
END
PRIVATE FN mIRLowering__lower_hash_lit(MUTABLE self: MIRLowering, MUTABLE node: HashLit) RETURNS Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE plan = mIRLowering__hash_literal_plan(rtoc_self_view, &node);
    MUTABLE capability = mIRLowering__hash_literal_capability_plan(rtoc_self_view, plan);
    IF node.pairs.empty?() THEN
      IF capability.empty_result EXISTS AS empty_result_value THEN
        RETURN COPY empty_result_value;
      END
      RETURN Emittable{ ContainerInit: COPY mIRLowering__empty_hash_literal(rtoc_self_view, plan, capability.zig_type) };
    END
    RETURN Emittable{ MIRBlockExpr: COPY mIRLowering__non_empty_hash_literal(&rtoc_self_view, node, plan, capability) };
}
END
PRIVATE FN mIRLowering__hash_literal_capability_plan(self: MIRLowering, plan: HashLiteralPlan) RETURNS HashLiteralCapabilityPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(hashLiteralPlan__capability_wrapped?(plan)) THEN
      RETURN mIRLowering__unwrapped_hash_literal_capability_plan(rtoc_self_view, plan);
    END
    IF type__striped?(plan.type_info) THEN
      RETURN mIRLowering__striped_hash_literal_capability_plan(rtoc_self_view, plan);
    ELSE
      RETURN mIRLowering__composed_hash_literal_capability_plan(rtoc_self_view, plan);
    END
}
END
PRIVATE FN mIRLowering__unwrapped_hash_literal_capability_plan(self: MIRLowering, plan: HashLiteralPlan) RETURNS HashLiteralCapabilityPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN HashLiteralCapabilityPlan{ zig_type: COPY plan.zig_type, init_value: NIL, empty_result: NIL, result_wrap: NIL, result_wrap_fn: NIL };
}
END
PRIVATE FN mIRLowering__striped_hash_literal_capability_plan(self: MIRLowering, plan: HashLiteralPlan) RETURNS !HashLiteralCapabilityPlan
