      rtoc_arg_lowered = mIRLowering__with_decl_alloc(&self, pre_resolved_alloc, %() USE(arg, MUTABLE self) -> {
        TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(arg)))
      });
    ELSE
      rtoc_arg_lowered = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(arg)));
    END
    UNWRAP (rtoc_arg_lowered)
    });
END
PRIVATE FN mIRLowering__intrinsic_signature_for(self: MIRLowering, node: Node) RETURNS !?FunctionSignature@multiowned ->
    MUTABLE matched: ?FunctionSignature@multiowned = aST__node_matched_stdlib_def( UNWRAP (castNodeToLocatable(node)));
    MUTABLE found: ?FunctionSignature@multiowned = functionSignature__unwrap( (IF matched EXISTS AS rtoc_wrap_9647 THEN X{ FunctionSignature: COPY rtoc_wrap_9647 } ELSE NIL END));
    IF found EXISTS AS found_value THEN
      RETURN KEEP found_value;
    END
    MUTABLE fallback: ?LookupResult = TRY (intrinsicRegistry__lookup(:std_lib, RegistryKey{ StringValue: COPY CAST(aST__node_name(UNWRAP (castNodeToLocatable(node))) AS String) }));
    IF fallback? IS_A []FunctionSignature@multiowned AS array THEN
      MUTABLE array: ?FunctionSignature@multiowned = COPY array.first();
    END
    RETURN functionSignature__unwrap(castOptionalLookupResultToOptionalX__mir_lowering(fallback));
END
PRIVATE FN mIRLowering__stdlib_sink_type_for_arg(self: MIRLowering, receiver_type: ?Type, takes_value: Bool) RETURNS !?Type ->
    IF !(takes_value) THEN
      RETURN NIL;
    END
    IF receiver_type EXISTS AS receiver THEN
      # Every registry arg marked `takes` is the value that lands in a container
      # slot, so the sink is the receiver's slot type -- not a fixed position.
      # (`insertAt(index, value)` puts it third; `put(key, value)` second.)
      IF type__map?(receiver) THEN
        RETURN TRY (type__value_type(receiver));
      END
      IF TRY (type__linear_collection?(receiver)) THEN
        RETURN TRY (type__element_type(receiver));
      END
    END
    RETURN NIL;
END
PRIVATE FN mIRLowering__empty_stdlib_call_facts(self: MIRLowering) RETURNS StdlibCallFacts ->
