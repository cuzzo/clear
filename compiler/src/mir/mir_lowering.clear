END
PRIVATE FN mIRLowering__deep_copy_zig_type(self: MIRLowering, mir: DeepCopy, ast_node: ?Locatable) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF mir.zig_type EXISTS AS zig_type_value THEN
      RETURN COPY zig_type_value;
    END
    MUTABLE ti = TRY (type__from_node_mut(UNWRAP (ast_node), "deep-copy zig type"));
    MUTABLE bare = TRY (type__new(TypeConstructionInput{ Type: COPY ti }));
    type__mark_stack_value_mut(&bare);
    RETURN TRY (type__zig_type(bare));
}
END
PRIVATE FN mIRLowering__cleanup_entry_for_owned_result(self: MIRLowering, ast_node: ?Locatable, alloc: String@symbol = :heap) RETURNS !?CleanupEntry@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF ast_node EXISTS AS ast_node_value THEN
      MUTABLE ti = TRY (type__from_node_mut(ast_node_value, "owned result cleanup entry"));
      ti = TRY (type__success_type(ti));
      IF (type__symbol?(ti) OR type__raw?(ti)) THEN
        RETURN NIL;
      END
      IF TRY (type__string?(ti)) THEN
        RETURN mIRLowering__heap_string_entry(rtoc_self_view, alloc);
      END
      IF type__collection?(ti) THEN
        RETURN mIRLowering__uniform_cleanup_entry(rtoc_self_view, TRY (type__zig_type(ti)), alloc);
      END
      IF !(((((TRY (type__needs_explicit_cleanup?(ti, alloc, mIRLowering__mir_schema_lookup(rtoc_self_view))) OR TRY (type__recursive_cleanup_shape?(ti, mIRLowering__mir_schema_lookup(rtoc_self_view)))) OR TRY (type__needs_cleanup?(ti, mIRLowering__mir_schema_lookup(rtoc_self_view)))) OR TRY (type__heap_ptr?(ti))) OR TRY (type__collection_value?(ti)))) THEN
        RETURN NIL;
      END
      MUTABLE zig_t = ((TRY (type__zig_type((TRY (type__new(TypeConstructionInput{ StringValue: CAST(type__resolved(ti) AS String) }))))) OR_ELSE NIL));
      IF !(zig_t) THEN
        RETURN NIL;
      END
      RETURN mIRLowering__uniform_cleanup_entry(rtoc_self_view, zig_t, alloc);
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN mIRLowering__typed_cleanup_entry_for_mir_result(self: MIRLowering, mir: Emittable, alloc: String@symbol = :heap) RETURNS !?CleanupEntry@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE typed_result: ?Type@multiowned = mIRLowering__mir_explicit_result_type(rtoc_self_view, mir);
    IF typed_result EXISTS AS typed_result_value THEN
      MUTABLE ti = typed_result_value;
      ti = TRY (type__success_type(ti));
      IF (type__symbol?(ti) OR type__raw?(ti)) THEN
        RETURN NIL;
      END
      IF TRY (type__string?(ti)) THEN
        RETURN mIRLowering__heap_string_entry(rtoc_self_view, alloc);
      END
      IF ((type__collection?(ti) OR TRY (type__recursive_cleanup_shape?(ti, mIRLowering__mir_schema_lookup(rtoc_self_view)))) OR TRY (type__needs_cleanup?(ti, mIRLowering__mir_schema_lookup(rtoc_self_view)))) THEN
        RETURN mIRLowering__uniform_cleanup_entry(rtoc_self_view, TRY (type__zig_type(ti)), alloc);
      END
    END
    RETURN NIL;
}
END
PRIVATE FN mIRLowering__cleanup_entry_for_ownership_effect(self: MIRLowering, mir: Emittable, alloc: String@symbol = :heap) RETURNS !?CleanupEntry@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE effect = ownershipEffect__of(mir);
    IF mir IS_A MIRBlockExpr AS mir_block_expr THEN
      MUTABLE transferred: ?String = COPY effect.target_var;
      IF transferred EXISTS AS transferred_value THEN
        MUTABLE let = blockExpr__body(mir_block_expr).grep(MIR.Let) |> FIND (CAST(_.name() AS String) == transferred_value);
        IF let THEN
          RETURN mIRLowering__hoist_cleanup_entry(rtoc_self_view, let.init(), NIL);
        END
      END
    END
    IF !(effect.produces_owned) THEN
      RETURN NIL;
    END
    IF (effect.cleanup_kind == :heap_string) THEN
      RETURN mIRLowering__heap_string_entry(rtoc_self_view, alloc);
    ELSE_IF (effect.cleanup_kind == :uniform) THEN
      MUTABLE typed: ?Type@multiowned = mIRLowering__mir_explicit_result_type(rtoc_self_view, mir);
      IF typed EXISTS AS typed_value THEN
        RETURN mIRLowering__uniform_cleanup_entry(rtoc_self_view, TRY (type__zig_type(typed_value)), alloc);
      END
      IF mir IS_A MIRBlockExpr AS mir_block_expr THEN
        typed = mIRLowering__block_expr_result_type(rtoc_self_view, mir_block_expr);
      ELSE
        typed = NIL;
      END
      IF typed EXISTS AS typed_value THEN
        RETURN mIRLowering__uniform_cleanup_entry(rtoc_self_view, TRY (type__zig_type(typed_value)), alloc);
      END
      panic("uniform owned MIR {} has no typed cleanup result");
    ELSE_IF (effect.cleanup_kind == :rc) THEN
      RETURN cleanupEntry__build(:rc, alloc, FALSE);
    ELSE_IF (effect.cleanup_kind == :frozen) THEN
      RETURN cleanupEntry__build(:frozen, :heap, FALSE, {:fixed_alloc: TRUE});
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN mIRLowering__mir_ident_names(self: MIRLowering, node: ?Emittable) RETURNS ![]String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A Ident AS ident THEN
      RETURN CAST([CAST(ident.name AS String)] AS []String);
    ELSE_IF node IS_A MIRBlockExpr AS mir_block_expr THEN
      MUTABLE local_names = blockExpr__body(mir_block_expr).each_with_object(Set[], %(stmt, names: [Set]Any) -> {
    IF stmt IS_A AllocMark THEN
          &names.insert(COPY CAST(stmt.name() AS String));
    END
    IF stmt IS_A Let THEN
      RETURN &names.insert(COPY CAST(stmt.name() AS String));
    END
    NIL
      });
      MUTABLE transferred_names = blockExpr__body(mir_block_expr).each_with_object(Set[], %(stmt, names: [Set]Any) -> {
    IF (stmt IS_A TransferMark AND (stmt.target() == :block_result)) THEN
      RETURN &names.insert(COPY CAST(stmt.name() AS String));
    END
    NIL
      });
      MUTABLE last = blockExpr__body(mir_block_expr).reverse().grep(MIR.BreakStmt).first();
      IF last THEN
        RETURN (mIRLowering__mir_ident_names(rtoc_self_view, last.value())) |> WHERE !((local_names.contains?(_) OR transferred_names.contains?(_)));
      ELSE
        RETURN CAST(( { MUTABLE rtoc_empty_list_286: []String = List[]; rtoc_empty_list_286 } ) AS []String);
      END
    ELSE
      MUTABLE names: []String = ( { MUTABLE rtoc_empty_list_287: []String = List[]; rtoc_empty_list_287 } );
      IF node EXISTS AS node_value THEN
        IF !(respondsTo?(node_value, "ownership_source_exprs")) THEN
          RETURN CAST(( { MUTABLE rtoc_empty_list_288: []String = List[]; rtoc_empty_list_288 } ) AS []String);
        END
        FOR _ IN node_value.ownership_source_exprs() DO
        FOR _ IN mIRLowering__mir_ident_names(rtoc_self_view, _) DO
        &names.append(COPY _);
        END
        END
        RETURN dedupeStrings(names);
      ELSE
        RETURN CAST(( { MUTABLE rtoc_empty_list_289: []String = List[]; rtoc_empty_list_289 } ) AS []String);
      END
    END
}
END
PRIVATE FN mIRLowering__lower_extern_fn(self: MIRLowering, node: ExternFnDecl) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE source = node.extern_source;
    IF ((source != NIL) AND (source.abi() == :c)) THEN
      MUTABLE params = node.params |> SELECT {
    MUTABLE zig_type = mIRLowering__c_abi_param_zig_type(rtoc_self_view, _);
    MIRParam{ name: COPY _.name(), zig_type: COPY zig_type, pointer_passed: (_.mutable() OR FALSE), lowered_node_id: NIL, ownership_consumption: NIL }
      };
      RETURN Emittable{ CExternFnDecl: COPY CExternFnDecl{ name: (source.symbol() OR node.name), params: params, return_type: TRY (type__zig_type(externFnDecl__annotation_return_type(node))), library: source.dependency(), callconv: source.callconv(), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
    MUTABLE mod = node.from_module;
    IF mIRLowering__program_state(rtoc_self_view).emitted_extern_modules.add?(mod) THEN
      MUTABLE mod_parts = mod.split(".");
      MUTABLE root_module = mod_parts.first();
      MUTABLE tail_modules = mod_parts |> SKIP 1;
      MUTABLE import_expr = ("@import(\"${root_module}\")" $+ ((tail_modules |> SELECT ".${_}").join("")));
      MUTABLE mod_alias = mIRLowering__zig_module_alias(rtoc_self_view, mod);
      MUTABLE module_path: String = "";
      IF ((["std", "builtin", "cheat_runtime"]) |> DISTINCT _).contains?(root_module) THEN
        module_path = root_module;
      ELSE
        module_path = "${root_module}.zig";
      END
      RETURN Emittable{ Import: COPY Import{ alias_name: COPY mod_alias, module_path: COPY module_path, member: IF tail_modules.empty?() THEN
        NIL
      ELSE
        tail_modules.join(".")
      END, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    ELSE
      RETURN Emittable{ Noop: COPY Noop{ reason: "extern_fn_import_already_emitted", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
}
END
PRIVATE FN mIRLowering__lower_extern_struct(self: MIRLowering, node: ExternStructDecl) RETURNS !MIRLoweringReturnValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fields: []FieldDef = List[];
    MUTABLE source = node.extern_source;
    IF ((source != NIL) AND (source.abi() == :c)) THEN
      IF (node.field_decls.count() == 0) THEN
        MUTABLE opaque_name = "${node.name}__opaque";
        RETURN MIRLoweringReturnValue{ ArrayValue: [TypeAlias{ name: COPY opaque_name, target: "opaque {}", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }, TypeAlias{ name: COPY node.name, target: "*${opaque_name}", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }] |> SELECT Emittable{ TypeAlias: COPY _ } };
      END
      fields = node.field_decls.keys() |> SELECT FieldDef{ name: COPY _, zig_type: TRY (type__zig_type((structField__type((COPY UNWRAP (node.field_decls[_])))), FALSE, TRUE)), default: NIL, lowered_node_id: NIL, ownership_consumption: NIL, boxed_capture: NIL };
      RETURN MIRLoweringReturnValue{ Emittable: COPY CAST(CExternStructDef{ name: node.name, fields: fields, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) };
    END
    MUTABLE mod: ?String = COPY node.from_module;
    IF mod EXISTS AS mod_value THEN
      MUTABLE mod_parts = mod_value.split(".");
      MUTABLE mod_alias = mIRLowering__zig_module_alias(rtoc_self_view, mod_value);
      MUTABLE items: []Emittable = ( { MUTABLE rtoc_empty_list_290: []Emittable = List[]; rtoc_empty_list_290 } );
      IF mIRLowering__program_state(rtoc_self_view).emitted_extern_modules.add?(mod_value) THEN
        MUTABLE root_module = COPY UNWRAP (mod_parts.first());
        MUTABLE tail_modules = mod_parts |> SKIP 1;
        MUTABLE member_chain = IF tail_modules.empty?() THEN
          NIL
        ELSE
          tail_modules.join(".")
        END;
        MUTABLE module_path: String = "";
        IF ((["std", "builtin", "cheat_runtime"]) |> DISTINCT _).contains?(root_module) THEN
          module_path = COPY root_module;
        ELSE
          module_path = "${root_module}.zig";
        END
        &items.append(Emittable{ Import: COPY Import{ alias_name: COPY mod_alias, module_path: COPY module_path, member: member_chain, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
      END
      IF mIRLowering__program_state(rtoc_self_view).emitted_import_type_aliases.add?(CAST(node.name AS String)) THEN
        MUTABLE zig_rhs: String = "";
        IF node.as_type EXISTS AS as_type_value THEN
          zig_rhs = "${mod_alias}.${as_type_value}";
        ELSE
          zig_rhs = "${mod_alias}.${node.name}";
        END
        &items.append(Emittable{ TypeAlias: COPY TypeAlias{ name: COPY node.name, target: COPY zig_rhs, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
      END
      IF (items.length() == 0) THEN
        RETURN MIRLoweringReturnValue{ Emittable: COPY CAST(Noop{ reason: "duplicate_extern_struct_alias", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) };
      END
      IF (items.length() == 1) THEN
        RETURN COPY castEmittableToMIRLoweringReturnValue(UNWRAP (items.first()));
      ELSE
        RETURN MIRLoweringReturnValue{ ArrayValue: COPY items };
      END
    ELSE
    IF (node.field_decls.count() == 0) THEN
        RETURN MIRLoweringReturnValue{ Emittable: COPY CAST(Noop{ reason: "empty_local_extern_struct", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) };
    ELSE
        fields = node.field_decls.keys() |> SELECT {
    MUTABLE zig_t = mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ Type: COPY structField__type((COPY UNWRAP (node.field_decls[_]))) }, FALSE, TRUE);
    FieldDef{ name: COPY _, zig_type: zig_t, default: NIL, lowered_node_id: NIL, ownership_consumption: NIL, boxed_capture: NIL }
        };
        RETURN MIRLoweringReturnValue{ Emittable: COPY CAST(MIRStructDef{ name: node.name, fields: fields, methods: NIL, visibility: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) };
    END
    END
}
END
PRIVATE FN mIRLowering__lower_function_def(MUTABLE self: MIRLowering, MUTABLE node: FunctionDef) RETURNS !MIRLoweringReturnValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE body_mir: []Emittable = List[];
    MUTABLE sig: ?FunctionSignature@multiowned = NIL;
    rtoc_self_view.kept_liveness_fn = COPY node;
    rtoc_self_view.kept_liveness = NIL;
    MUTABLE ret_type = functionDef__lowering_return_type(node);
    IF ((TRUE AND type__frame?(ret_type)) AND TRY (type__struct?(ret_type))) THEN
      ret_type = TRY (type__new(TypeConstructionInput{ StringValue: CAST(type__resolved(ret_type) AS String) }));
    END
    MUTABLE final_type = mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ Type: COPY ret_type });
    MUTABLE fn_needs_rt = ((mIRLowering__finalized_needs_rt_mut(rtoc_self_view, UNWRAP (node)) OR mIRLowering__function_return_retains_shared_handle?(rtoc_self_view, UNWRAP (node))) OR mIRLowering__function_uses_node_store?(rtoc_self_view, UNWRAP (node)));
    IF fn_needs_rt THEN
      sig = (IF (TRY (mIRLowering__fn_sigs(rtoc_self_view)))[symbol(CAST(node.name AS String))] != NIL THEN (TRY (mIRLowering__fn_sigs(rtoc_self_view)))[symbol(CAST(node.name AS String))] ELSE (TRY (mIRLowering__fn_sigs(rtoc_self_view)))[type__to_sym(node.name)] END);
      IF sig EXISTS AS sig_value THEN
        MUTABLE sig_value_mutable = COPY sig_value;
        functionSignature__mark_runtime_required_mut(&sig_value_mutable);
      END
      node.needs_rt = TRUE;
    END
    MUTABLE fn_can_fail = IF (node.can_fail == NIL) THEN
      TRUE
    ELSE
      node.can_fail
    END;
    MUTABLE param_facts = mIRLowering__function_param_facts(rtoc_self_view, node.params, node.generic_params);
    MUTABLE context = mIRLowering__function_lowering_context(rtoc_self_view, UNWRAP (node), final_type, ReturnTypeNode{ Type: COPY ret_type }, fn_needs_rt, param_facts);
    mIRLowering__activate_function_context(rtoc_self_view, context);
    MUTABLE params_mir: []MIRParam = param_facts |> UNNEST {
    MUTABLE params = [functionParamFact__to_mir_param(_)];
    IF _.protocol_map THEN
        &params.append(MIRParam{ name: COPY mIRLowering__protocol_map_allocator_name(rtoc_self_view, _.name), zig_type: "std.mem.Allocator", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL });
    END
    params
    };
    IF fn_needs_rt THEN
      &params_mir.unshift(MIRParam{ name: "rt", zig_type: "*Runtime", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL });
    END
    MUTABLE comptime_params = node.type_params |> SELECT "comptime ${_}: type";
    MUTABLE tied_shared_return: ?String = mIRLowering__tied_shared_family_return_param(rtoc_self_view, UNWRAP (node), context.mutable_scalar_params);
    MUTABLE final_zig_type = zigType__new(final_type);
    MUTABLE return_type_str =   IF tied_shared_return THEN
      tied_shared_return
    ELSE_IF fn_can_fail THEN
      zigType__fallible_return_type_for(final_zig_type, functionDef__recursive_reentrance_declared?(node))
    ELSE
      final_type
    END;
    MUTABLE vis = IF ((node.visibility == :pub)) THEN
      :pub
    ELSE
      :private
    END;
    MUTABLE used_names = TRY (mIRLowering__collect_identifier_names(rtoc_self_view, node.body));
    MUTABLE entry_plan = mIRLowering__function_entry_plan(rtoc_self_view, UNWRAP (node), fn_needs_rt, context.mutable_scalar_params, used_names);
    MUTABLE prologue = COPY entry_plan.prologue;
    MUTABLE takes_mir = COPY entry_plan.takes_mir;
    MUTABLE pointer_param_mir = context.protocol_map_allocators.values() |> SELECT Suppress{ name: COPY _, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    MUTABLE catch_clauses = mIRLowering__function_catch_clauses(rtoc_self_view, UNWRAP (node));
    MUTABLE has_catch = context.has_catch;
    IF node.thunk_plan THEN
      body_mir = ((takes_mir + pointer_param_mir) + [TRY (emit__build_trampoline(UNWRAP (node), rtoc_self_view))]);
    ELSE_IF node.mutual_thunk_plan THEN
      body_mir = ((takes_mir + pointer_param_mir) + [TRY (emit__build_mutual_trampoline(UNWRAP (node), rtoc_self_view))]);
    ELSE
      MUTABLE pre_checks = mIRLowering__lower_pre_clauses(&rtoc_self_view, UNWRAP (node));
      MUTABLE lowered_body = TRY (mIRLowering__lower_body(&rtoc_self_view, node.body));
      MUTABLE node_stores = ((mIRLowering__function_state(rtoc_self_view).node_store_types |> SELECT COPY _) |> ORDER_BY _) |> UNNEST {
    MUTABLE bind_call = MIRMethodCall{ receiver: Emittable{ Call: COPY TRY (mIRLowering__node_store_type_mir(rtoc_self_view, _)) }, method: "bind", args: [CAST(Ident{ name: mIRLowering__runtime_binding_name(rtoc_self_view), lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: TRUE, callable_contract: COPY TRY (callableContract__no_ownership(1)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    MUTABLE binding = Ident{ name: mIRLowering__node_store_binding_name(rtoc_self_view, _), lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE release_call = MIRMethodCall{ receiver: Emittable{ Call: COPY TRY (mIRLowering__node_store_type_mir(rtoc_self_view, _)) }, method: "releaseBound", args: [CAST(binding AS Any)], try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(1)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    CAST(Tuple{Let{ name: COPY mIRLowering__node_store_binding_name(rtoc_self_view, _), init: Emittable{ MIRMethodCall: COPY bind_call }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }, MIRDeferStmt{ body: DeferBody{ Emittable: COPY CAST(COPY release_call AS Emittable) }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }} AS Tuple<Let, MIRDeferStmt>)
      };
      body_mir = ((((takes_mir + pointer_param_mir) + pre_checks) + node_stores) + lowered_body);
    END
    body_mir = TRY (mIRLowering__append_ownership_transfers_for_mir_body(rtoc_self_view, body_mir));
    IF (!(fn_can_fail) AND mIRLowering__body_has_faulting_alloc?(rtoc_self_view, body_mir)) THEN
      fn_can_fail = TRUE;
      return_type_str = mIRLowering__faulting_return_type_str(rtoc_self_view, final_type, UNWRAP (node));
      sig = (IF (TRY (mIRLowering__fn_sigs(rtoc_self_view)))[symbol(CAST(node.name AS String))] != NIL THEN (TRY (mIRLowering__fn_sigs(rtoc_self_view)))[symbol(CAST(node.name AS String))] ELSE (TRY (mIRLowering__fn_sigs(rtoc_self_view)))[type__to_sym(node.name)] END);
      IF sig EXISTS AS sig_value THEN
        MUTABLE sig_value_mutable = COPY sig_value;
        functionSignature__mark_faulting_allocation_mut(&sig_value_mutable);
      END
      node.can_fail = TRUE;
    END
    MUTABLE has_post = ((TRUE AND node.post_clauses) AND type__any?(node.post_clauses));
    IF has_post THEN
      RETURN MIRLoweringReturnValue{ ArrayValue: COPY [mIRLowering__build_post_inner_fn(rtoc_self_view, UNWRAP (node), params_mir, return_type_str, prologue, body_mir, comptime_params), mIRLowering__build_post_outer_fn(&rtoc_self_view, UNWRAP (node), params_mir, return_type_str, fn_needs_rt, vis, comptime_params)] };
    ELSE_IF has_catch THEN
      MUTABLE inner_name = "__${mIRLowering__zig_safe_name(rtoc_self_view, node.name)}_body";
      MUTABLE inner_ret: String = "";
      IF zigType__error_union?(final_zig_type) THEN
        inner_ret = COPY final_zig_type.source;
      ELSE_IF fn_can_fail THEN
        inner_ret = zigType__concrete_fallible_return_type(final_zig_type);
      ELSE
        inner_ret = zigType__fallible_return_type(final_zig_type);
      END
      MUTABLE inner_fn = FnDef{ name: inner_name, params: COPY params_mir, ret_type: COPY inner_ret, body: Body{ ArrayValue: TRY (mIRLowering__append_ownership_transfers_for_mir_body(rtoc_self_view, (prologue + body_mir))) |> SELECT castEmittableToLocatable(_) }, visibility: :private, can_fail: FALSE, comptime_params: comptime_params, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
      MUTABLE call_args = IF fn_needs_rt THEN
        (["rt"] + (node.params |> SELECT _.name))
      ELSE
        node.params |> SELECT _.name
      END;
      MUTABLE inner_call = Call{ callee: COPY inner_name, args: COPY call_args |> SELECT Ident{ name: _, lowered_node_id: NIL, ownership_consumption: NIL }, try_wrap: FALSE, owned_return: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(scopeBindings__length(call_args))), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL };
      MUTABLE catch_plan = mIRLowering__build_catch_clauses(&rtoc_self_view, UNWRAP (node), fn_can_fail);
      MUTABLE error_reassigns = mIRLowering__collect_catch_reassigns(rtoc_self_view, UNWRAP (node));
      MUTABLE outer_body = [CatchWrapper{ inner_call: Emittable{ Call: COPY inner_call }, error_reassigns: error_reassigns, clauses: COPY catch_plan.clauses, default_body: COPY catch_plan.default_body, default_action: COPY catch_plan.default_action, snapshot_type: COPY catch_plan.snapshot_type, rt_name: mIRLowering__runtime_binding_name(rtoc_self_view), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }];
      MUTABLE outer_fn = FnDef{ name: mIRLowering__zig_safe_name(rtoc_self_view, node.name), params: COPY params_mir, ret_type: COPY return_type_str, body: Body{ ArrayValue: TRY (mIRLowering__append_ownership_transfers_for_mir_body(rtoc_self_view, outer_body)) |> SELECT castEmittableToLocatable(_) }, visibility: COPY vis, can_fail: FALSE, comptime_params: comptime_params, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
      RETURN MIRLoweringReturnValue{ ArrayValue: COPY [inner_fn, outer_fn] };
    ELSE
      RETURN MIRLoweringReturnValue{ FnDef: COPY FnDef{ name: mIRLowering__zig_safe_name(rtoc_self_view, node.name), params: COPY params_mir, ret_type: COPY return_type_str, body: Body{ ArrayValue: TRY (mIRLowering__append_ownership_transfers_for_mir_body(rtoc_self_view, (prologue + body_mir))) |> SELECT castEmittableToLocatable(_) }, visibility: COPY vis, can_fail: FALSE, comptime_params: comptime_params, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
}
END
PRIVATE FN mIRLowering__function_uses_node_store?(self: MIRLowering, node: FunctionDef) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node.params |> ANY TRY (type__node_reference?((TRY (type__new(TypeConstructionInput{ Type: COPY _.type }))))) THEN
      RETURN TRUE;
    END
    MUTABLE return_type: ?Type = COPY node.return_type;
    IF (IF return_type != NIL THEN
      TRY (type__node_reference?(return_type))
    ELSE
      NIL
    END) THEN
      RETURN TRUE;
    END
    MUTABLE found: Bool = FALSE;
    aST__each_locatable(node.body, %(candidate: Locatable) -> {
    MUTABLE type = &candidate.full_type_mut("@node function scan");
    MUTABLE coerced = IF respondsTo?(candidate, "coerced_type_info") THEN
        candidate.coerced_type_info()
      ELSE
        NIL
      END;
    IF (TRY (type__node_reference?(type)) OR coerced.node_reference?()) THEN
        found = TRUE;
        BREAK;
    END
    rubyToClearVoid()
    });
    RETURN found;
}
END
PRIVATE FN mIRLowering__function_lowering_context(self: MIRLowering, node: FunctionDef, final_type: String, return_type_node: ReturnTypeNode, fn_needs_rt: Bool, param_facts: []FunctionParamFact) RETURNS !FunctionLoweringContext
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE mutable_scalar_params: NameSet = Set[];
    MUTABLE collection_params: NameSet = Set[];
    MUTABLE protocol_map_allocators: {String}String = {};
    FOR _ IN param_facts DO
    IF _.mutable_scalar THEN
        &mutable_scalar_params.append(COPY _.name);
    END
    IF _.collection_param THEN
        &collection_params.append(COPY _.name);
    END
    IF _.protocol_map THEN
        protocol_map_allocators[_.name] = mIRLowering__protocol_map_allocator_name(rtoc_self_view, _.name);
    END
    END
    MUTABLE bindings: {String}CleanupEntry@multiowned = COPY ((node.cleanup_bindings OR {}));
    FOR _ IN collection_params DO
    bindings[_] = (bindings[_] OR_ELSE cleanupEntry__no_cleanup(:heap, :heap));
    END
    MUTABLE has_catch = mIRLowering__function_catch_clauses(rtoc_self_view, node) |> ANY _;
    MUTABLE return_type_info = TRY (type__from_node_mut(return_type_node, "function lowering return type"));
    MUTABLE return_payload: ?Type = TRY (type__plain_return_payload_type(return_type_info));
    RETURN FunctionLoweringContext{ bindings: bindings, binding_types: {}, collection_params: COPY collection_params, protocol_map_allocators: COPY protocol_map_allocators, mutable_scalar_params: COPY mutable_scalar_params, param_names: COPY (node.params |> SELECT CAST(_.name AS String)) |> DISTINCT _, takes_param_names: COPY (node.params |> WHERE _.takes) |> SELECT CAST(_.name AS String) |> DISTINCT _, heap_carry_return_vars: COPY mIRLowering__typed_name_set(rtoc_self_view, node.heap_carry_return_vars), returned_names: COPY mIRLowering__collect_fn_returned_names(rtoc_self_view, node.body), snapshot_types: COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_291: ?[Set]String = NIL;
    IF has_catch THEN
      rtoc_ternary_value_291 = mIRLowering__typed_name_set(rtoc_self_view, node.snapshot_types);
    ELSE
      rtoc_ternary_value_291 = Set[];
    END
    rtoc_ternary_value_291? }, fn_alloc_marked_names: COPY node.params |> REDUCE({"rt": TRUE}) {
    acc[mIRLowering__zig_safe_name(rtoc_self_view, CAST(_.name AS String))] = TRUE;
    acc
    }, lowered_alloc_names: COPY Set[], lowered_guarded_cleanup_names: COPY Set[], decl_zig_name_map: {}, guarded_cleanup_names: {}, fn_name_rename_map: {}, has_rt: COPY fn_needs_rt, tail_call: (node.tail_call == TRUE), zig_name: COPY mIRLowering__zig_safe_name(rtoc_self_view, node.name), return_payload_zig: COPY IF return_payload != NIL THEN
      TRY (type__zig_type(return_payload))
    ELSE
      final_type
    END, return_type: COPY return_type_info, heap_carry_return: (TRUE AND (node.heap_carry_return == TRUE)), has_catch: has_catch, source_start_line: node.source_range.start_line };
}
END
PRIVATE FN mIRLowering__activate_function_context(self: MIRLowering, context: FunctionLoweringContext) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rtoc_mutable_receiver_292 = mIRLowering__function_state(rtoc_self_view);
    functionState__activate_mut(&rtoc_mutable_receiver_292, context);
}
END
PRIVATE FN mIRLowering__typed_name_set(self: MIRLowering, values: ?[]ValuesItem) RETURNS NameSet
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE names: NameSet = Set[];
    IF values != NIL THEN
        FOR _ IN values DO
        &names.append(COPY CAST(_ AS String));
        END
    END
    RETURN names;
}
END
PRIVATE FN mIRLowering__finalized_needs_rt_mut(self: MIRLowering, node: FunctionDef) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (node.thunk_plan OR node.mutual_thunk_plan) THEN
      RETURN TRUE;
    END
    IF ((node.needs_rt == TRUE) OR (node.needs_rt == FALSE)) THEN
      RETURN node.needs_rt;
    END
    panic("function {} missing finalized needs_rt metadata before MIR lowering");
}
END
PRIVATE FN mIRLowering__function_return_retains_shared_handle?(self: MIRLowering, node: FunctionDef) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE ret: ?Type = COPY node.return_type;
    IF !((TRUE AND TRY (type__any_rc?(ret)))) THEN
      RETURN FALSE;
    END
    MUTABLE found: Bool = FALSE;
    aST__each_locatable(node.body, %(child: Locatable) USE(rtoc_self_view) -> {
    IF !((IF child IS_A ReturnNode AS return_node THEN return_node.value ELSE FALSE END)) THEN
        RETURN;
    END
    IF (TRY (mIRLowering__rc_retain_needed?(rtoc_self_view, child.value())) AND !(mIRLowering__return_transfers_heap_binding?(rtoc_self_view, child.value()))) THEN
        found = TRUE;
    END
    rubyToClearVoid()
    });
    RETURN found;
}
END
PRIVATE FN mIRLowering__function_param_facts(self: MIRLowering, params: []Param, generic_params: []GenericParamDecl) RETURNS ![]FunctionParamFact
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN params |> SELECT mIRLowering__function_param_fact(rtoc_self_view, _, generic_params);
}
END
PRIVATE FN mIRLowering__function_param_fact(self: MIRLowering, param: Param, generic_params: []GenericParamDecl) RETURNS FunctionParamFact
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE type_info = COPY param.type;
    MUTABLE base_zig = mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ Type: COPY param.type }, TRUE);
    MUTABLE protocol_map_param = generic_params |> ANY ((symbol(_.name) == type__resolved(type_info)) AND (_.bounds |> ANY (type__resolved(_.type) == :Map)));
    MUTABLE collection_param = !(!((((type__needs_pointer_passing?(type_info) OR (((param.mutable != NIL) AND type__list_collection?(type_info)))) OR protocol_map_param))));
    MUTABLE mutable_scalar = !(!(((((((param.mutable != NIL) AND !(protocol_map_param)) AND !(type__collection?(type_info))) AND !(type__needs_pointer_passing?(type_info))) AND !((base_zig.startsWith?("[]") OR base_zig.startsWith?("*")))))));
    MUTABLE zig_type: String = "";
    IF protocol_map_param THEN
      zig_type = "*${base_zig}";
    ELSE
      zig_type = mIRLowering__function_param_zig_type(rtoc_self_view, param, type_info, base_zig);
    END
    IF (mutable_scalar AND (zig_type != "anytype")) THEN
      zig_type = "*${zig_type}";
    END
    RETURN FunctionParamFact{ param: COPY param, name: COPY CAST(param.name AS String), mir_name: COPY IF mutable_scalar THEN
      "_m_${param.name}"
    ELSE
      mIRLowering__zig_safe_name(rtoc_self_view, CAST(param.name AS String))
    END, zig_type: COPY zig_type, mutable_scalar: mutable_scalar, collection_param: collection_param, pointer_passed: (collection_param OR mutable_scalar), protocol_map: protocol_map_param };
}
END
PRIVATE FN mIRLowering__protocol_map_allocator_name(self: MIRLowering, name: String) RETURNS String
  REQUIRES self: LOCAL
->
