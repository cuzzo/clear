      RETURN FALSE;
    END
    IF (aST__node_rodata_provenance?(node) AND symbolEntry__rodata_provenance?( CAST(node AS SymbolEntry))) THEN
      RETURN FALSE;
    END
    IF (aST__node_borrow_provenance?(node) AND symbolEntry__borrow_provenance?( CAST(node AS SymbolEntry))) THEN
      RETURN FALSE;
    END
    IF (aST__node_needs_heap_create(node) OR_ELSE FALSE) THEN
      RETURN TRUE;
    END
    IF (aST__node_heap_storage?(node) AND symbolEntry__heap_storage?( CAST(node AS SymbolEntry))) THEN
