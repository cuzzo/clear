    END
    MUTABLE label = "__lazy_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_244 = mIRLowering__lowering_counters(rtoc_self_view);
    mIRLoweringCounters__next_block_expr_id(&rtoc_mutable_receiver_244) }}";
    MUTABLE alloc_names = scoped |> REDUCE(Set[]) {
    IF _ IS_A AllocMark THEN
        &acc.insert(COPY CAST(_.name() AS String));
    END
    acc
    };
    MUTABLE result_names = ( { MUTABLE rtoc_pipe_src = mIRLowering__mir_ident_names(rtoc_self_view, result); rtoc_pipe_src |> DISTINCT _ } );
    MUTABLE alloc_by_name = scoped |> REDUCE({}) {
