END
PRIVATE FN mIRLowering__with_capability_source_mir(self: MIRLowering, var_node: CapabilityVarNode, raw_atomic: Bool = FALSE) RETURNS !Emittable ->
    MUTABLE lowerer: MIRLowering@multiowned = CAST(self AS MIRLowering@multiowned);
    MUTABLE prev_locked: ?{String}LockedUnwrapMapValue = COPY mIRLowering__capability_state(&lowerer).locked_unwrap_map;
    MUTABLE prev_rc: ?{String}String = COPY mIRLowering__capability_state(&lowerer).rc_unwrap_map;
    MUTABLE prev_raw = mIRLowering__capability_state(&lowerer).atomic_emit_raw;
    lowerer.state.capabilities.locked_unwrap_map = NIL;
    lowerer.state.capabilities.rc_unwrap_map = NIL;
    IF raw_atomic THEN
      lowerer.state.capabilities.atomic_emit_raw = TRUE;
    END
    DEFER {
    lowerer.state.capabilities.atomic_emit_raw = prev_raw;
    lowerer.state.capabilities.locked_unwrap_map = prev_locked;
    lowerer.state.capabilities.rc_unwrap_map = prev_rc;
