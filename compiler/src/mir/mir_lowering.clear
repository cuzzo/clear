      IF (helper_structs.length() > 0) THEN
        MUTABLE union_items: []Emittable = List[];
      FOR helper IN helper_structs DO
        IF helper EXISTS AS helper_value THEN
          &union_items.append(Emittable{ MIRStructDef: COPY helper_value });
        END
      END
      &union_items.append(Emittable{ UnionTypeDef: COPY union_node });
      RETURN MIRLoweringLoweredMir{ ArrayValue: COPY union_items };
      ELSE
        RETURN MIRLoweringLoweredMir{ Emittable: Emittable{ UnionTypeDef: COPY union_node } };
      END
    END
END
PRIVATE FN mIRLowering__lower_inline_union_helper_struct(MUTABLE self: MIRLowering, fact: UnionVariantLoweringFact) RETURNS !?MIRStructDef
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(fact.inline_struct) THEN
      RETURN NIL;
    END
    MUTABLE data: InlineStructVariant@multiowned = COPY castOptionalMIRLoweringUnionVariantPayloadToInlineStructVariantMultiowned(fact.data);
    MUTABLE fields = data.fields.keys() |> SELECT {
    MUTABLE zig_t = TRY (mIRLowering__transpile_type(rtoc_self_view, castTypeTypeInputToZigTypeMapperType(COPY UNWRAP (data.fields[_])), FALSE, TRUE));
    FieldDef{ name: COPY CAST(_ AS String), zig_type: COPY zig_t, default: NIL, lowered_node_id: NIL, ownership_consumption: NIL, boxed_capture: NIL }
    };
    MUTABLE alloc_ref = Ident{ name: "alloc", lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE self_ref = Ident{ name: "self", lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE deinit_entries = COPY data.deinit_entries;
    MUTABLE deinit_stmts = deinit_entries |> UNNEST TRY (mIRLowering__inline_union_deinit_statements(&rtoc_self_view, _, Expr{ Emittable: Emittable{ Ident: COPY self_ref } }, Expr{ Emittable: Emittable{ Ident: COPY alloc_ref } }));
    MUTABLE methods: ?[]FnDef = NIL;
    IF (deinit_stmts.length() > 0) THEN
      MUTABLE deinit_fn = FnDef{ name: "__clear_drop", params: [MIRParam{ name: "self", zig_type: "*@This()", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL }, MIRParam{ name: "alloc", zig_type: "std.mem.Allocator", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL }], ret_type: "void", body: COPY deinit_stmts, visibility: :pub, can_fail: FALSE, comptime_params: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
      MUTABLE result_ref = Ident{ name: "result", lowered_node_id: NIL, ownership_consumption: NIL };
      MUTABLE dupe_stmts: []Emittable = [CAST(Let{ name: COPY "result", init: Emittable{ Ident: COPY Ident{ name: "self", lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } AS Emittable)];
      FOR _ IN deinit_entries DO
    MUTABLE tmp_name = "__dupe_${_.field}";
    MUTABLE field_source = "self.${mIRLowering__zig_safe_name(rtoc_self_view, _.field)}";
    &dupe_stmts.append(CAST(Let{ name: COPY tmp_name, init: Emittable{ Lit: COPY Lit{ value: "try CheatLib.dupeValue(@TypeOf(${field_source}), ${field_source}, alloc)", lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } AS Emittable));
    &dupe_stmts.append(CAST(ExprStmt{ expr: Emittable{ Lit: COPY Lit{ value: "errdefer CheatLib.cleanup(@TypeOf(${tmp_name}), alloc, &${tmp_name})", lowered_node_id: NIL, ownership_consumption: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable));
    &dupe_stmts.append(CAST(Set{ target: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY result_ref }, field: COPY _.field, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Ident: COPY Ident{ name: COPY tmp_name, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable));
      END
      &dupe_stmts.append(CAST(ReturnStmt{ value: Emittable{ Ident: COPY result_ref }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable));
      MUTABLE dupe_fn = FnDef{ name: "__clear_clone", params: [MIRParam{ name: "self", zig_type: "@This()", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL }, MIRParam{ name: "alloc", zig_type: "std.mem.Allocator", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL }], ret_type: "!@This()", body: COPY dupe_stmts, visibility: :pub, can_fail: FALSE, comptime_params: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
      methods = [deinit_fn, dupe_fn];
    END
    RETURN MIRStructDef{ name: unionVariantLoweringFact__helper_name(fact), fields: fields, methods: CAST(methods AS ?[]Emittable), visibility: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
}
END
PRIVATE FN mIRLowering__inline_union_deinit_statements(MUTABLE self: MIRLowering, entry: InlineStructDeinitEntry, self_ref: Expr, alloc_ref: Expr) RETURNS ![]Emittable ->
