FN mIRLowering__dedupe_ownership_facts(MUTABLE self: MIRLowering, facts: []MIRLoweringOwnershipFact) RETURNS ![]MIRLoweringOwnershipFact ->
    MUTABLE seen: [Set]String = Set[];
    RETURN facts |> WHERE { MUTABLE rtoc_value_block_marker = 0; MUTABLE key: ?String = mIRLowering__ownership_fact_dedupe_key(&self, _); (IF !(key) THEN TRUE ELSE (IF seen.contains?(key) THEN FALSE ELSE { MUTABLE rtoc_value_block_marker = 0; &seen.insert(key); TRUE } END) END) };
END
FN mIRLowering__ownership_fact_dedupe_key(MUTABLE self: MIRLowering, fact: MIRLoweringOwnershipFact) RETURNS ?String ->
    IF fact IS_A OwnedCreate AS owned_create THEN
      RETURN "OwnedCreate:${owned_create.name}:${owned_create.alloc}:${owned_create.source}";
    ELSE_IF fact IS_A OwnedDestroy AS owned_destroy THEN
      RETURN "OwnedDestroy:${owned_destroy.name}:${owned_destroy.alloc}:${owned_destroy.source}";
    ELSE_IF fact IS_A OwnedTransfer AS owned_transfer THEN
      RETURN "OwnedTransfer:${owned_transfer.name}:${(owned_transfer.target OR_ELSE "")}:${owned_transfer.source}";
    ELSE_IF fact IS_A OwnedBorrow AS owned_borrow THEN
      RETURN "OwnedBorrow:${owned_borrow.name}:${owned_borrow.source}";
    ELSE_IF fact IS_A OwnedStore AS owned_store THEN
      RETURN "OwnedStore:${owned_store.name}:${owned_store.target}:${(owned_store.alloc OR_ELSE "")}:${owned_store.source}";
    ELSE_IF fact IS_A OwnedReturn AS owned_return THEN
      RETURN "OwnedReturn:${owned_return.name}:${owned_return.source}";
    ELSE
      RETURN NIL;
    END
END
FN mIRLowering__append_ownership_facts_for_mir_node_mut(MUTABLE self: MIRLowering, MUTABLE facts: []MIRLoweringOwnershipFact, MUTABLE node: Emittable) RETURNS !Void ->
    mIRLowering__append_ownership_facts_for_structural_node_mut(&self, &facts, node);
    mIRLowering__append_ownership_store_facts_for_consumption_mut(&self, &facts, &node);
    mIRLowering__append_ownership_transfer_facts_for_consumption_mut(&self, &facts, &node);
    FOR MUTABLE rtoc_for_item_2711 IN (TRY (mIRLowering__ownership_fact_targets_for_node(&self, &node))) DO
    IF rtoc_for_item_2711.include_owned_result THEN
        TRY (mIRLowering__append_ownership_facts_for_owned_result_mut(&self, &facts, rtoc_for_item_2711.name, &rtoc_for_item_2711.expr, UNWRAP (rtoc_for_item_2711.type_info)));
    END
    IF rtoc_for_item_2711.include_transfer_contract THEN
        TRY (mIRLowering__append_ownership_transfer_facts_for_contract_mut(&self, &facts, &rtoc_for_item_2711.expr));
    END
    IF rtoc_for_item_2711.expr IS_A MIRBgBlock THEN
        &facts.append(MIRLoweringOwnershipFact{ OwnedReturn: COPY OwnedReturn{ name: COPY rtoc_for_item_2711.name, source: mIRLowering__ownership_fact_source(&self, &rtoc_for_item_2711.expr), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    END
    END
    NIL;
END
FN mIRLowering__ownership_fact_targets_for_node(MUTABLE self: MIRLowering, MUTABLE node: Emittable) RETURNS ![]OwnershipFactTarget ->
    IF node IS_A Let AS let THEN
      MUTABLE let_init: Emittable = COPY let.init;
      RETURN TRY (mIRLowering__ownership_fact_target_for_expr(&self, CAST(let.name AS String), &let_init, let.annotation));
    ELSE_IF node IS_A ExprStmt AS expr_stmt THEN
      MUTABLE expr_stmt_expr: Emittable = COPY exprStmt__expr(expr_stmt);
      RETURN TRY (mIRLowering__ownership_fact_target_for_expr(&self, mIRLowering__ownership_fact_source(&self, &expr_stmt_expr), &expr_stmt_expr, NIL));
    ELSE_IF node IS_A Set AS MUTABLE set THEN
      RETURN CAST([mIRLowering__ownership_transfer_only_target(&self, &set.value)] AS []OwnershipFactTarget);
    ELSE_IF node IS_A IfBindStmt AS MUTABLE if_bind_stmt THEN
      RETURN TRY (mIRLowering__if_bind_ownership_fact_targets(&self, if_bind_stmt));
    ELSE_IF node IS_A ReturnStmt AS return_stmt THEN
      MUTABLE value:? = return_stmt.value;
