    MUTABLE rtoc_indexed_output_415 = [];
    MUTABLE rtoc_indexed_i_414 = 0;
    WHILE rtoc_indexed_i_414 < rtoc_indexed_items_413.length() DO
      &rtoc_indexed_output_415.append({
