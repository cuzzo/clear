        mIRLowering__alloc_from_sym(rtoc_self_view, &rp.alloc_mut())
      ELSE
        (IF cleanupEntry__present?(binding_entry) THEN
        binding_entry.alloc()
      ELSE
        NIL
      END)
      END)
      END;
      MUTABLE source_type = TRY (type__from_node_mut(node.value, "reassignment value type"));
      MUTABLE target_type_branch_value: ?Type = NIL;
