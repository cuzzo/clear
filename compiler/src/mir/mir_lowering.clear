          IF mIRLowering__struct_field_wants_slice?(rtoc_self_view, expected_ft, K{ StringValue: COPY _ }, node) THEN
              field_value = mIRLowering__aggregate_dynamic_slice_field_value(rtoc_self_view, field_value, expected_ft, borrowed_field, field_sink_alloc, field_node);
          END
          MUTABLE field_alloc: ?String@symbol = mIRLowering__mir_owned_alloc(rtoc_self_view, field_value);
          MUTABLE lowered = mIRLowering__hoist_alloc(rtoc_self_view, field_value, field_node, TRUE);
          IF (TRUE AND mIRLowering__recursive_field_copy_required?(rtoc_self_view, expected_ft, field_node, field_alloc, field_sink_alloc)) THEN
            MUTABLE copy = (TRY (mIRLowering__retain_handle_for_destination(rtoc_self_view, lowered, expected_ft)) OR_ELSE Emittable{ DeepCopy: COPY DeepCopy{ source: COPY lowered, zig_type: COPY TRY (type__zig_type(expected_ft)), elem_type: NIL, strategy: :full_value, alloc: COPY field_sink_alloc, copy_shape: NIL, type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL } });
            RETURN mIRLowering__hoist_alloc(rtoc_self_view, copy, field_node, TRUE);
          ELSE
            RETURN lowered;
          END
