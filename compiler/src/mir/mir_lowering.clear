PRIVATE FN mIRLowering__coerce_fsm_result_value(self: MIRLowering, value: Emittable, result_type: Type) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (type__error_union?(result_type) OR type__optional?(result_type)) THEN
      RETURN COPY value;
    END
    IF !(type__integer?(result_type)) THEN
      RETURN COPY value;
    END
    IF value IS_A MIRCast AS mir_cast THEN
      RETURN COPY Emittable{ MIRCast: COPY mir_cast };
    END
    RETURN Emittable{ MIRCast: COPY MIRCast{ expr: COPY value, target_type: COPY TRY (type__zig_type(result_type)), method: :intCast, lowered_node_id: NIL, ownership_consumption: NIL } };
}
