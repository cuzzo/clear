    END;
    MUTABLE literal_fields = mIRLowering__struct_lit_fields_with_callsite_defaults(rtoc_self_view, node);
    MUTABLE fields = literal_fields.keys() |> SELECT {
    MUTABLE ft: ?StructLitFieldType = COPY field_types[_];
    MUTABLE field_type_input_branch_value: ?TypeTypeInput = NIL;
      IF ft? IS_A InlineStructVariant AS inline_struct_variant THEN
        field_type_input_branch_value = NIL;
      ELSE
        field_type_input_branch_value = castOptionalStructLitFieldTypeToOptionalTypeTypeInput(ft);
      END
    MUTABLE field_type_input: ?TypeTypeInput = field_type_input_branch_value;
    MUTABLE borrowed_field: Bool = ((node.borrowed_field_names != NIL) AND (((node.borrowed_field_names)?).contains?(_) == TRUE));
    MUTABLE field_node = mIRLowering__struct_literal_field_node(rtoc_self_view, borrowed_field, COPY UNWRAP (literal_fields[_]));
    MUTABLE field_sink_alloc = mIRLowering__aggregate_field_sink_alloc(rtoc_self_view, field_type_input, field_node, struct_alloc);
    mIRLowering__move_mark_field_mut(rtoc_self_view, &field_node);
    MUTABLE expected_ft = IF field_type_input != NIL THEN
        ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_576: ?TypeTypeInput = NIL;
      IF field_type_input IS_A Type THEN
        rtoc_ternary_value_576 = field_type_input;
      ELSE
        rtoc_ternary_value_576 = TRY (type__new(castTypeTypeInputToTypeConstructionInput(field_type_input)));
      END
      rtoc_ternary_value_576? })
      ELSE
        NIL
      END;
    MUTABLE val, field_hoists = mIRLowering__lower_head(rtoc_self_view, %() USE(borrowed_field, expected_ft, field_node, field_sink_alloc, field_type_input, node, _, MUTABLE rtoc_self_view) -> {
      rtoc_lambda_result_579 = mIRLowering__with_decl_alloc(rtoc_self_view, field_sink_alloc, %() USE(borrowed_field, expected_ft, field_node, field_sink_alloc, field_type_input, node, _, MUTABLE rtoc_self_view) -> {
      rtoc_lambda_result_578 = mIRLowering__with_expected_type(rtoc_self_view, expected_ft, %() USE(borrowed_field, expected_ft, field_node, field_sink_alloc, field_type_input, node, _, MUTABLE rtoc_self_view) -> {
      rtoc_lambda_result_577 = mIRLowering__with_sink_type(rtoc_self_view, expected_ft, %() USE(borrowed_field, expected_ft, field_node, field_sink_alloc, field_type_input, node, _, MUTABLE rtoc_self_view) -> {
      IF borrowed_field THEN
        RETURN mIRLowering__aggregate_dynamic_slice_field_value(rtoc_self_view, TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(field_node))), expected_ft, TRUE, field_sink_alloc, field_node);
      ELSE_IF TRY (mIRLowering__rc_retain_needed?(rtoc_self_view, field_node)) THEN
        RETURN mIRLowering__hoist_alloc(rtoc_self_view, Emittable{ RcRetain: COPY TRY (mIRLowering__make_rc_retain(&rtoc_self_view, castLocatableToIdentifier(field_node))) }, field_node, TRUE);
      ELSE
        MUTABLE kept_orelse: ?Emittable = mIRLowering__kept_identity_orelse_field_value(&rtoc_self_view, field_node, expected_ft, field_sink_alloc);
        IF kept_orelse THEN
          IF mIRLowering__mir_allocates?(rtoc_self_view, kept_orelse) THEN
            RETURN mIRLowering__hoist_alloc(rtoc_self_view, UNWRAP (kept_orelse), field_node, TRUE);
          ELSE
            RETURN kept_orelse;
          END
        ELSE_IF ((IF field_node IS_A CopyNode AS copy_node THEN ((expected_ft != NIL) AND type__collection?((expected_ft?))) ELSE FALSE END) AND !(TRY (type__any_rc?(expected_ft)))) THEN
          RETURN mIRLowering__hoist_alloc(rtoc_self_view, Emittable{ DeepCopy: COPY DeepCopy{ source: COPY TRY (mIRLowering__lower(&rtoc_self_view, field_node.value())), zig_type: COPY TRY (type__zig_type(expected_ft)), elem_type: NIL, strategy: :full_value, alloc: COPY field_sink_alloc, copy_shape: NIL, type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL } }, field_node, TRUE);
        ELSE
