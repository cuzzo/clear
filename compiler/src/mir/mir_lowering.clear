FN mIRLowering__zig_module_alias(self: MIRLowering, name: String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE importer: ?ModuleImporter = COPY mIRLowering__program_state(rtoc_self_view).importer;
    MUTABLE canonical: String = "";
    IF ((importer != NIL) AND TRUE) THEN
      canonical = moduleImporter__owning_package_name(importer, name);
    ELSE
      canonical = COPY name;
    END
    RETURN "__clear_module_${canonical.replace(".", "_")}";
}
END
STRUCT AllocatingResultFact {
  name: String,
  ownership_effect: OwnershipEffect,
  type_info: Type,
  scope: String@symbol
}

FN allocatingResultFact__alloc(self: AllocatingResultFact) RETURNS String@symbol EFFECTS REENTRANT ->
  IF self.ownership_effect.alloc != NIL THEN
  RETURN (self.ownership_effect.alloc)?;
  ELSE
  RETURN :heap;
  END
END
FN allocatingResultFact__alloc_mark(self: AllocatingResultFact) RETURNS AllocMark ->
  RETURN AllocMark{ name: COPY self.name, alloc: COPY allocatingResultFact__alloc(self), type_info: COPY self.type_info, scope: COPY self.scope, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
STRUCT DestinationPlacementPlan {
  action: String@symbol,
  type_info: ?Type,
  dest_alloc: ?String@symbol,
  source_alloc: ?String@symbol
}

FN destinationPlacementPlan__keep?(self: DestinationPlacementPlan) RETURNS Bool ->
  RETURN (self.action == :keep);
END
FN destinationPlacementPlan__heap?(self: DestinationPlacementPlan) RETURNS Bool ->
  RETURN (self.dest_alloc == :heap);
END
FN destinationPlacementPlan__place(self: DestinationPlacementPlan, lowering: MIRLowering, mir: Emittable, ast_node: Locatable) RETURNS !Emittable ->
  IF destinationPlacementPlan__keep?(self) THEN
    RETURN COPY mir;
  END
  IF (self.action == :heap_indirect) THEN
    RETURN TRY (mIRLowering__place_indirect_value_for_heap_destination(lowering, mir, UNWRAP (self.type_info)));
  ELSE_IF (self.action == :cast_wrapped_or) THEN
    MUTABLE cast: MIRCast = COPY castEmittableToMIRCast(mir);
    MUTABLE placed = TRY (mIRLowering__place_value_for_destination(lowering, cast.expr, ast_node, self.dest_alloc, ruby_wrap_optional_Type_TypeTypeInput(self.type_info)));
    RETURN Emittable{ MIRCast: COPY MIRCast{ expr: COPY placed, target_type: COPY cast.target_type, method: COPY cast.method, lowered_node_id: NIL, ownership_consumption: NIL } };
  ELSE_IF (self.action == :owned_orelse) THEN
    RETURN TRY (mIRLowering__place_owned_orelse_for_destination(lowering, castEmittableToOrelse(mir), UNWRAP (self.type_info), symbol(UNWRAP (self.dest_alloc))));
  ELSE_IF (self.action == :owned_try_catch) THEN
    RETURN TRY (mIRLowering__place_owned_try_catch_for_destination(lowering, castEmittableToTryCatch(mir), UNWRAP (self.type_info), symbol(UNWRAP (self.dest_alloc))));
  ELSE_IF (self.action == :owned_alloc_mismatch) THEN
    RETURN TRY (mIRLowering__place_owned_alloc_mismatch_for_destination(lowering, mir, UNWRAP (self.type_info), symbol(UNWRAP (self.dest_alloc)), symbol(UNWRAP (self.source_alloc))));
  ELSE_IF (self.action == :owned_copy) THEN
    RETURN TRY (mIRLowering__place_owned_branch_value_for_destination(lowering, mir, UNWRAP (self.type_info), symbol(UNWRAP (self.dest_alloc))));
  ELSE_IF (self.action == :string_or) THEN
    RETURN TRY (mIRLowering__place_string_or_for_heap_destination(lowering, mir, castLocatableToBinaryOp(ast_node)));
  ELSE_IF (self.action == :string) THEN
    RETURN TRY (mIRLowering__place_string_value_for_destination(lowering, mir, ast_node, symbol(UNWRAP (self.dest_alloc))));
  ELSE
    panic("unknown destination placement action {}");
  END
END
STRUCT DestinationSourceFact {
  borrowed: Bool,
  owner_transfer: Bool,
  heap_owned_result: Bool
}

FN destinationSourceFact__needs_owned_copy?(MUTABLE self: DestinationSourceFact, type_info: Type) RETURNS !Bool ->
  RETURN (((TRY (type__ownership_bearing?(type_info)) AND self.borrowed) AND !(self.owner_transfer)) AND !(self.heap_owned_result));
END
STRUCT PipelineAllocMarkFact {
  alloc: String@symbol,
  mark: AllocMark,
  cleanup_entry: ?CleanupEntry@multiowned
}
STRUCT OwnedSinkPlan {
  action: String@symbol,
  target_alloc: String@symbol,
  zig_type: ?String,
  copy_mode: ?String@symbol,
  rc_func: ?String,
  source_slice_view: Bool
}

FN ownedSinkPlan__keep?(self: OwnedSinkPlan) RETURNS Bool ->
  RETURN (self.action == :keep);
END
STRUCT OwnedSinkSourceFact {
  source_alloc: ?String@symbol,
  moved_without_copy: Bool,
  owned_parameter: Bool,
  needs_heap_create: Bool,
  same_alloc_verifiable: Bool,
  same_alloc_transfer_source: Bool,
  transfer_without_local_cleanup: Bool,
  already_owned_value: Bool,
  existing_owned_source: Bool,
  borrowed_union_sink: Bool
}

FN ownedSinkSourceFact__satisfies_sink?(self: OwnedSinkSourceFact, sink_alloc: String@symbol, ti: Type) RETURNS !Bool ->
  MUTABLE same_alloc = (self.source_alloc == sink_alloc);
  MUTABLE same_alloc_satisfies = (same_alloc AND (((((self.moved_without_copy AND ((!(TRY (type__string?(ti))) OR !(type__rodata?(ti)))))) OR self.same_alloc_verifiable) OR self.same_alloc_transfer_source)));
  MUTABLE owned_value_matches_sink = (self.already_owned_value AND (((self.source_alloc == NIL) OR same_alloc)));
  RETURN ((((same_alloc_satisfies OR self.owned_parameter) OR self.needs_heap_create) OR ((self.transfer_without_local_cleanup AND same_alloc))) OR owned_value_matches_sink);
END
FN ownedSinkSourceFact__satisfies_rc_sink?(self: OwnedSinkSourceFact) RETURNS Bool ->
  RETURN (((self.moved_without_copy OR self.owned_parameter) OR self.needs_heap_create) OR self.already_owned_value);
END
STRUCT LoweredStmtPacket {
  mir: MIRLoweringLoweredMir,
  pending: []Emittable,
  stmt_transfer_marks: []Stmt,
  source_line: ?Int64,
  source_column: ?Int64
}
STRUCT LoweredItemTarget {
  items: []Emittable,
  line: ?Int64
}
STRUCT LoweredModuleItems {
  items: []Emittable,
  type_items: []Emittable
}

FN loweredModuleItems__get_index(self: LoweredModuleItems, key: String@symbol) RETURNS ![]Emittable ->
  IF (key == :items) THEN
    RETURN COPY self.items;
  ELSE_IF (key == :type_items) THEN
    RETURN COPY self.type_items;
  ELSE
    RETURN CAST(( { MUTABLE rtoc_empty_list_1: []Emittable = List[]; rtoc_empty_list_1 } ) AS []Emittable);
  END
END
STRUCT UnionVariantLoweringFact {
  owner_name: String,
  name: String,
  data: ?MIRLoweringUnionVariantPayload,
  inline_struct: Bool,
  zig_type: String
}

FN unionVariantLoweringFact__helper_name(self: UnionVariantLoweringFact) RETURNS String ->
  RETURN "${self.owner_name}_${self.name}";
END
STRUCT OwnershipFinalizationContext {
  inherited_alloc_names: [Set]String,
  parent: ?OwnershipFinalizationContext@boxed,
  out: []Emittable,
  guarded_cleanup_names: [Set]String,
  alloc_marks: {String}AllocMark,
  body_alloc_mark_names: [Set]String,
  transfer_mark_names: [Set]String,
  body_transfer_mark_names: [Set]String,
  move_mark_names: [Set]String,
  cleanup_by_name: Any@multiowned
}
STRUCT LoweredBodyConstruction {
  packets: []LoweredStmtPacket,
  finalization_context: OwnershipFinalizationContext
}
STRUCT OwnershipFactTarget {
  name: String,
  expr: Emittable,
  type_info: ?Type,
  include_owned_result: Bool,
  include_transfer_contract: Bool
}
STRUCT OwnershipTransferTarget {
  name: String,
  target: String@symbol,
  target_alloc: ?String@symbol
}
STRUCT OwnershipSurfaceScan {
  facts: []MIRLoweringOwnershipFact,
  transfer_targets: []OwnershipTransferTarget
}
FN mIRLowering__fn_sigs(self: MIRLowering) RETURNS !{String@symbol}FunctionSignature@multiowned
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY mIRLowering__program_state(rtoc_self_view).fn_sigs;
}
END
FN mIRLowering__shard_context(self: MIRLowering) RETURNS !?{String@symbol}String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY mIRLowering__program_state(rtoc_self_view).shard_context;
}
END
FN mIRLowering__set_shard_context(self: MIRLowering, context: ?{String@symbol}String) RETURNS !?{String@symbol}String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rtoc_writer_receiver_2: MIRLoweringProgramState = mIRLowering__program_state(rtoc_self_view);
    rtoc_writer_receiver_2.shard_context = COPY context;
    RETURN context;
}
END
FN mIRLowering__ast_void_type?(self: MIRLowering, type_info: ?TypeTypeInput) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF type_info EXISTS AS type_info_value THEN
      IF ruby_union_scalar_equal_TypeTypeInput_String_symbol(type_info_value, :Void) THEN
        RETURN TRUE;
      ELSE
        MUTABLE ti: ?Type = TRY (type__from_node(type_info_value));
        IF ti EXISTS AS ti_value THEN
          RETURN type__void?(ti_value);
        ELSE
          RETURN FALSE;
        END
      END
    ELSE
      RETURN TRUE;
    END
}
END
