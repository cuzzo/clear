WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE prev = COPY mIRLowering__function_state(rtoc_self_view).pending_stmts;
    MUTABLE rtoc_writer_receiver_242: FunctionState = mIRLowering__function_state(rtoc_self_view);
    rtoc_writer_receiver_242.pending_stmts = ( { MUTABLE rtoc_empty_list_241: []Stmt = List[]; rtoc_empty_list_241 } );
    MUTABLE result = blk();
    MUTABLE scoped = COPY mIRLowering__function_state(rtoc_self_view).pending_stmts;
    MUTABLE rtoc_writer_receiver_243: FunctionState = mIRLowering__function_state(rtoc_self_view);
    rtoc_writer_receiver_243.pending_stmts = prev;
    IF (scoped.length() == 0) THEN
