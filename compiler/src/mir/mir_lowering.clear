PRIVATE FN mIRLowering__kept_edge_temp_stack(MUTABLE self: MIRLowering) RETURNS ![]KeptEdgeCallFrame ->
    RETURN COPY self.kept_edge_temp_stack;
END
PRIVATE FN mIRLowering__with_kept_edge_call_frame(MUTABLE self: MIRLowering, blk: FN() -> ![]Emittable) RETURNS ![]Emittable ->
    &self.kept_edge_temp_stack.append(KeptEdgeCallFrame{ temps: List[], moved_sources: List[] });
    MUTABLE args_mir = TRY (blk());
    MUTABLE frame = UNWRAP (&self.kept_edge_temp_stack.pop());
    IF ((frame.temps.length() == 0) AND (frame.moved_sources.length() == 0)) THEN
      RETURN args_mir;
    END
