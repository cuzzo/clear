      END
      MUTABLE guarded_result: []Emittable = List[];
      IF last_step EXISTS AS last_step_value THEN
        guarded_result = TRY (mIRLowering__guard_shared_node_statement(rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(last_step_value.expr), result_mir));
      ELSE
