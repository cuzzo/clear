PUB FN mIRLowering__append_ownership_transfers_for_mir_body(MUTABLE self: MIRLowering, body: []Emittable, inherited_alloc_names: [Set]String = Set[], inherited_guarded_names: [Set]String = Set[]) RETURNS ![]Emittable ->
    MUTABLE normalized = TRY (mIRLowering__normalize_allocating_mir_body(&self, body));
    MUTABLE state = OwnershipFinalizationContext{ inherited_alloc_names: COPY inherited_alloc_names, parent: NIL, out: List[], guarded_cleanup_names: COPY inherited_guarded_names, alloc_marks: {}, body_alloc_mark_names: COPY TRY (mIRLowering__body_alloc_mark_names_in_body(&self, NodeRoot{ ArrayValue: COPY normalized })), transfer_mark_names: COPY Set[], body_transfer_mark_names: COPY TRY (mIRLowering__body_transfer_mark_names_in_body(&self, NodeRoot{ ArrayValue: COPY normalized })), move_mark_names: COPY Set[], cleanup_by_name: {} };
