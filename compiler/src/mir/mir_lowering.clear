      IF TRUE THEN
        decl_branch_value = COPY (MATCH var_node START CapabilityVarNode.Identifier AS item -> item.symbol, CapabilityVarNode.GetField AS item -> item.symbol, CapabilityVarNode.GetIndex AS item -> item.symbol END)?.reg;
      ELSE
        decl_branch_value = NIL;
