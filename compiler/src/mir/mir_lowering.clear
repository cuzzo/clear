FN mIRLowering__with_lifecycle_registry<Result>(MUTABLE self: MIRLowering, registry: ?LifecycleRegistry, block: FN() -> Result) RETURNS Result
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  IF !(registry) THEN
      RETURN block();
  END
  MUTABLE previous: ?LifecycleRegistry@multiowned = COPY rtoc_self_view.active_lifecycle_registry;
  DEFER IF registry EXISTS AS registry_value THEN
      MUTABLE registry_value_mutable = COPY registry_value;
      mIRLowering__restore_lifecycle_registry_mut(&rtoc_self_view, previous?);
  END
  rtoc_self_view.active_lifecycle_registry = COPY registry;
  RETURN block();
}
END
