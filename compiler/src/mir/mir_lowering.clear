FN mIRLowering__record_ownership_finalization_surface_node_mut(MUTABLE self: MIRLowering, MUTABLE state: OwnershipFinalizationContext, node: Emittable) RETURNS Void ->
    IF node IS_A AllocMark AS alloc_mark THEN
      state.alloc_marks[alloc_mark.name] = COPY alloc_mark;
      &state.body_alloc_mark_names.insert(COPY alloc_mark.name);
    ELSE_IF node IS_A TransferMark AS transfer_mark THEN
      &state.transfer_mark_names.insert(COPY transfer_mark.name);
      &state.body_transfer_mark_names.insert(COPY transfer_mark.name);
    ELSE_IF node IS_A MoveMark AS move_mark THEN
      &state.move_mark_names.insert(COPY move_mark.name);
    ELSE_IF node IS_A Cleanup AS cleanup THEN
      MUTABLE cleanup_mutable = COPY cleanup;
      MUTABLE name = COPY cleanup_mutable.name;
      state.cleanup_by_name[name] = Emittable{ Cleanup: COPY cleanup_mutable };
      IF mIRLowering__cleanup_entry_moved_guard?(&self, cleanup_mutable.cleanup_entry) THEN
        &state.guarded_cleanup_names.insert(name);
      END
    ELSE_IF node IS_A ErrCleanup AS err_cleanup THEN
      MUTABLE err_cleanup_mutable = COPY err_cleanup;
      MUTABLE name = COPY err_cleanup_mutable.name;
      state.cleanup_by_name[name] = Emittable{ ErrCleanup: COPY err_cleanup_mutable };
      IF mIRLowering__cleanup_entry_moved_guard?(&self, err_cleanup_mutable.cleanup_entry) THEN
        &state.guarded_cleanup_names.insert(name);
      END
    END
    NIL;
END
FN mIRLowering__scan_ownership_surface_mut(MUTABLE self: MIRLowering, MUTABLE state: OwnershipFinalizationContext, root: NodeRoot, collect_facts: Bool, collect_transfers: Bool) RETURNS !OwnershipSurfaceScan ->
