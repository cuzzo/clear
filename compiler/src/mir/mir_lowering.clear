      END;
    MUTABLE placed = TRY (mIRLowering__place_value_for_destination(rtoc_self_view, inner_map, node, :heap, TypeTypeInput{ Type: COPY inner_result_type }));
    MUTABLE result_lifecycle = COPY UNWRAP (mIRLowering__lifecycle_registry(rtoc_self_view)[inner_result_type]);
