PRIVATE FN mIRLowering__lower_or_else(MUTABLE self: MIRLowering, MUTABLE node: BinaryOp) RETURNS !Emittable ->
    MUTABLE msg_mir: ?Emittable = NIL;
    MUTABLE facts = TRY (mIRLowering__or_else_facts(&self, node));
    MUTABLE left: Emittable = CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(node.left))) AS Emittable);
    IF node.right IS_A OrElseRaise THEN
      IF left IS_A ExternTrampoline AS extern_trampoline THEN
        RETURN Emittable{ ExternTrampoline: COPY extern_trampoline };
      END
      IF (node.retain_error_channel == TRUE) THEN
        RETURN mIRLowering__strip_try(self, left);
      END
      IF facts.left_is_error THEN
        RETURN Emittable{ TryExpr: COPY TryExpr{ expr: COPY mIRLowering__strip_try(self, left), lowered_node_id: NIL, ownership_consumption: NIL } };
      END
      RETURN left;
    END
    IF node.right IS_A OrElseExit THEN
      IF (facts.left_is_error AND (facts.target == :bc)) THEN
        MUTABLE ex = COPY node.right;
        MUTABLE exit_facts = TRY (mIRLowering__or_else_exit_facts(self, CAST(ex AS OrElseExit), facts.line));
        IF ex.message THEN
          msg_mir = CAST(TRY (mIRLowering__lower(&self, ex.message)) AS Emittable);
        ELSE
          msg_mir = NIL;
        END
        MUTABLE catch_block = ScopeBlock{ body: COPY [Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ OrElseExitBcRewrite: COPY mIRLowering__or_else_exit_bc_reassign(self, exit_facts, msg_mir) }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ ReturnStmt: COPY ReturnStmt{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "error", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "CheatError", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
        RETURN Emittable{ TryCatch: COPY TRY (mIRLowering__try_catch_with_provenance(self, left, Emittable{ ScopeBlock: COPY catch_block }, "__exit_err")) };
      END
      IF facts.left_is_error THEN
        MUTABLE ex = COPY node.right;
        MUTABLE exit_facts = TRY (mIRLowering__or_else_exit_facts(self, CAST(ex AS OrElseExit), facts.line));
        IF ex.message THEN
          msg_mir = CAST(TRY (mIRLowering__lower(&self, ex.message)) AS Emittable);
        ELSE
          msg_mir = NIL;
        END
        MUTABLE catch_block = TRY (mIRLowering__or_else_exit_scope(&self, exit_facts, msg_mir, Emittable{ Ident: COPY Ident{ name: "__exit_err", lowered_node_id: NIL, ownership_consumption: NIL } }));
        RETURN Emittable{ TryCatch: COPY TRY (mIRLowering__try_catch_with_provenance(self, left, Emittable{ ScopeBlock: COPY catch_block }, "__exit_err")) };
      END
      RETURN left;
    END
    IF node.right IS_A OrElsePass THEN
      IF facts.left_is_error THEN
        RETURN Emittable{ TryCatch: COPY TRY (mIRLowering__try_catch_with_provenance(self, left, Emittable{ DefaultValue: COPY TRY (mIRLowering__or_else_pass_fallback(self, node.left)) }, NIL)) };
      END
      RETURN left;
    END
    IF node.right IS_A OrElseBreak THEN
      IF facts.left_is_error THEN
        RETURN Emittable{ TryCatch: COPY TRY (mIRLowering__try_catch_with_provenance(self, left, Emittable{ BreakExpr: COPY BreakExpr{ label: NIL, value: NIL, lowered_node_id: NIL, ownership_consumption: NIL } }, NIL)) };
      END
      RETURN left;
    END
    IF node.right IS_A OrElsePrune THEN
      IF facts.left_is_error THEN
        RETURN Emittable{ TryCatch: COPY TRY (mIRLowering__try_catch_with_provenance(self, left, Emittable{ DefaultValue: COPY TRY (mIRLowering__or_else_pass_fallback(self, node.left)) }, NIL)) };
      END
      RETURN left;
    END
    MUTABLE left_type: ?Type = TRY (type__from_node_mut(node.left, "OR_ELSE definite left"));
    IF !((facts.left_is_error OR type__optional?( UNWRAP (left_type)))) THEN
      RETURN left;
    END
    MUTABLE fallback_type = TRY (mIRLowering__or_fallback_expected_type(&self, node));
    MUTABLE right = mIRLowering__lower_scoped(&self, %() USE(fallback_type, MUTABLE node, MUTABLE self) -> {
    MUTABLE rtoc_lambda_result_556: ?Emittable = mIRLowering__with_expected_type(&self, CAST(fallback_type AS ?Type), %() USE(MUTABLE node, MUTABLE self) -> {
    MUTABLE fallback_mir: Emittable = CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(node.right))) AS Emittable);
    MUTABLE merge_type: ?Type = TRY (type__from_node_mut(Locatable{ BinaryOp: COPY node }, "OR_ELSE merge type"));
    IF TRY (type__byte_string?( UNWRAP (merge_type))) THEN
        fallback_mir = TRY (mIRLowering__widen_symbol_to_bytes(&self, fallback_mir, node.right));
    ELSE_IF ((type__symbol?( UNWRAP (merge_type)) AND node.right IS_A Literal) AND (castLocatableToLiteral__mir_lowering(node.right).type == :STRING)) THEN
        fallback_mir = Emittable{ Call: COPY Call{ callee: "CheatLib.symbolOf", args: [fallback_mir], try_wrap: FALSE, owned_return: FALSE, callable_contract: TRY (callableContract__no_ownership(1)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL } };
    END
    TRY (mIRLowering__materialize_or_fallback_value(&self, &fallback_mir, &node.right))
    });
    rtoc_lambda_result_556
    });
    IF facts.left_is_error THEN
      MUTABLE caught = TRY (mIRLowering__try_catch_with_provenance(self, left, right, NIL, castEmittableToOptionalMIRLoweringFallback(right)));
      IF facts.left_success_optional THEN
        MUTABLE out = Orelse{ expr: Emittable{ TryCatch: COPY caught }, fallback: COPY right, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
        out.result_type = TRY (type__from_node_mut(Locatable{ BinaryOp: COPY node }, "fallible optional OR_ELSE result"));
        RETURN Emittable{ Orelse: COPY out };
      END
      RETURN Emittable{ TryCatch: COPY caught };
    END
    MUTABLE out = Orelse{ expr: COPY left, fallback: COPY right, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    MUTABLE result_type: ?Type = TRY (type__from_node_mut(Locatable{ BinaryOp: COPY node }, "optional OR_ELSE result"));
    out.result_type = result_type;
    MUTABLE left_named_owner = (((node.left IS_A Identifier AND locatable__symbol(node.left)) AND !({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_557 = node.left.symbol;
    symbolEntry__rodata_provenance?(rtoc_local_receiver_557) })) AND !({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_558 = node.left.symbol;
    symbolEntry__borrow_provenance?(rtoc_local_receiver_558) }));
    IF (TRY (mIRLowering__ownership_bearing_type?(&self, UNWRAP (result_type))) AND left_named_owner) THEN
      RETURN TRY (mIRLowering__place_owned_orelse_for_destination(&self, &out, UNWRAP (result_type), (mIRLowering__function_state(&self).current_decl_alloc OR_ELSE :heap)));
    END
    RETURN Emittable{ Orelse: COPY out };
END
PRIVATE FN mIRLowering__or_fallback_expected_type(MUTABLE self: MIRLowering, node: BinaryOp) RETURNS !Type ->
    self.state.function_state.current_expected_type = COPY mIRLowering__function_state(&self).current_expected_type;
    MUTABLE left_type: ?Type = TRY (type__from_node_mut(node.left, "OR_ELSE fallback left type"));
    MUTABLE value_payload = TRY (type__value_payload_type( UNWRAP (left_type)));
    IF !(type__any?(value_payload)) THEN
      RETURN value_payload;
    END
    MUTABLE error_union:? = IF (locatable__error_union_type(node.left) != NIL) THEN
      locatable__error_union_type(node.left)
    ELSE
      NIL
    END;
    IF error_union THEN
      MUTABLE eu_type = TRY (type__new( TypeConstructionInput{ Type: error_union }));
      MUTABLE eu_payload = TRY (type__value_payload_type(eu_type));
      IF !(type__any?(eu_payload)) THEN
        RETURN eu_payload;
      END
    END
    IF mIRLowering__function_state(&self).current_expected_type != NIL THEN
    RETURN COPY (mIRLowering__function_state(&self).current_expected_type)?;
    ELSE
    RETURN TRY (aST__full_type_mut(Locatable{ BinaryOp: COPY node }));
    END
END
PRIVATE FN mIRLowering__materialize_or_fallback_value(MUTABLE self: MIRLowering, MUTABLE value: Emittable, MUTABLE ast_node: Locatable) RETURNS !Emittable ->
    IF TRY (mIRLowering__mir_allocates?(&self, value)) THEN
      RETURN TRY (mIRLowering__hoist_alloc(&self, &value, &ast_node, FALSE));
    END
    IF TRY (mIRLowering__unit_union_variant_constructor?(&self, ast_node)) THEN
      RETURN COPY value;
    END
    IF !(mIRLowering__or_fallback_access_path?(self, ast_node)) THEN
      RETURN COPY value;
    END
    MUTABLE ti = TRY (aST__full_type_mut(ast_node));
    IF !(((TRY (type__string?(ti)) OR TRY (type__recursive_cleanup_shape?(ti, mIRLowering__mir_schema_lookup(&self)))) OR type__needs_cleanup?(ti, mIRLowering__mir_schema_lookup(&self)))) THEN
      RETURN COPY value;
    END
    MUTABLE alloc = (mIRLowering__function_state(&self).current_decl_alloc OR_ELSE :heap);
    MUTABLE copied = (TRY (mIRLowering__retain_handle_for_destination(&self, value, ti)) OR_ELSE Emittable{ DeepCopy: COPY DeepCopy{ source: COPY value, zig_type: COPY TRY (type__zig_type(ti)), elem_type: NIL, strategy: :full_value, alloc: COPY alloc, copy_shape: deepCopy__copy_shape_for_zig_type(COPY TRY (type__zig_type(ti))), type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL } });
    RETURN TRY (mIRLowering__hoist_alloc(&self, &copied, &ast_node, FALSE));
END
PRIVATE FN mIRLowering__or_fallback_access_path?(self: MIRLowering, ast_node: Locatable) RETURNS Bool ->
    RETURN (ast_node IS_A GetField OR ast_node IS_A GetIndex);
END
PRIVATE FN mIRLowering__or_else_facts(MUTABLE self: MIRLowering, node: BinaryOp) RETURNS !OrElseFacts ->
    MUTABLE plan: ?TenseOperationPlan = COPY CAST(node.tense_plan AS ?TenseOperationPlan);
    IF !((IF plan != NIL THEN
      tenseOperationPlan__recovery_operation?(plan)
    ELSE
      NIL
    END)) THEN
      panic("OR_ELSE lowering requires its annotation-produced TenseOperationPlan at line {}");
    END
    MUTABLE left_is_error = (plan?.backend_form == TenseBackendForm.ZigCatch);
    MUTABLE left_success_optional = (left_is_error AND type__optional?((TRY (type__success_type(UNWRAP (plan).input_type)))));
    RETURN OrElseFacts{ left_is_error: left_is_error, left_success_optional: left_success_optional, line: (node.token.line), target: COPY mIRLowering__lowering_target(&self) };
END
PRIVATE FN mIRLowering__or_else_pass_fallback(self: MIRLowering, node: Locatable) RETURNS !DefaultValue ->
    MUTABLE ti: ?Type = TRY (type__from_node_mut(node, "OR_ELSE fallback"));
    ti = TRY (type__success_type( UNWRAP (ti)));
    IF TRY (type__string?( UNWRAP (ti))) THEN
      RETURN DefaultValue{ kind: :string_empty, zig_type: NIL };
    END
    IF type__list_collection?( UNWRAP (ti)) THEN
      RETURN DefaultValue{ kind: :collection_empty, zig_type: COPY TRY (type__zig_type( UNWRAP (ti))) };
    END
    RETURN DefaultValue{ kind: :undefined, zig_type: NIL };
END
PRIVATE FN mIRLowering__lower_get_field(MUTABLE self: MIRLowering, MUTABLE node: GetField) RETURNS !Emittable ->
    MUTABLE shared: Bool = FALSE;
    MUTABLE zig_type: String = "";
    MUTABLE constructor: ?StructInit = TRY (mIRLowering__unit_variant_constructor(&self, node));
    IF constructor EXISTS AS constructor_value THEN
      RETURN Emittable{ StructInit: COPY constructor_value };
    END
    IF node.target IS_A TenseNavigation THEN
      RETURN TRY (mIRLowering__lower_tense_navigation_field(&self, &node, castLocatableToTenseNavigation__mir_lowering(node.target)));
    END
    MUTABLE target_node = COPY node.target;
    MUTABLE implicit_safe_nav = ((aST__node_safe_nav_chain(target_node) EXISTS) AND (locatable__safe_nav_chain(target_node) == TRUE));
    MUTABLE explicit_safe_nav = (target_node IS_A OptionalUnwrap AND (locatable__safe_navigation?(target_node) OR_ELSE FALSE));
    IF (explicit_safe_nav OR implicit_safe_nav) THEN
      MUTABLE inner_ast_branch_value: ?Locatable = NIL;
      IF explicit_safe_nav THEN
        inner_ast_branch_value = locatable__target(target_node);
      ELSE
        inner_ast_branch_value = target_node;
      END
      MUTABLE inner_ast: Locatable = inner_ast_branch_value?;
      MUTABLE inner_mir: Emittable = CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(inner_ast))) AS Emittable);
      MUTABLE inner_type: ?Type = TRY (type__from_node_mut(inner_ast, "optional @node field target"));
      IF TRY (type__node_reference?( UNWRAP (inner_type))) THEN
        MUTABLE payload = UNWRAP (TRY (type__node_payload_type( UNWRAP (inner_type))));
        zig_type = TRY (mIRLowering__transpile_type(self, MIRLoweringType{ StringValue: COPY type__resolved(payload) }));
        shared = type__shared_node?( UNWRAP (inner_type));
        IF !(shared) THEN
          &self.state.function_state.node_store_types.insert(zig_type);
        END
        MUTABLE store = TRY (mIRLowering__node_store_type_mir(&self, zig_type, shared));
        inner_mir = Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Call: COPY store }, method: "getBound", args: [CAST(Ident{ name: mIRLowering__node_store_binding_name(self, zig_type, shared), lowered_node_id: NIL, ownership_consumption: NIL } AS Any), CAST(inner_mir AS Any)], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(1)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } };
      END
      MUTABLE safe_root: Emittable = Emittable{ Ident: COPY Ident{ name: "_r", lowered_node_id: NIL, ownership_consumption: NIL } };
      IF type__indirect?( UNWRAP (inner_type)) THEN
        safe_root = Emittable{ Deref: COPY Deref{ expr: COPY safe_root, lowered_node_id: NIL, ownership_consumption: NIL } };
      END
      MUTABLE plan = TRY (mIRLowering__field_access_plan(&self, node, safe_root));
      MUTABLE result_type = TRY (aST__full_type_mut(Locatable{ GetField: COPY node }));
      IF !(type__optional?(result_type)) THEN
        result_type = TRY (type__optional_of(TypeTypeInput{ Type: COPY result_type }));
      END
      MUTABLE result = IfOptional{ optional: COPY inner_mir, capture: "_r", then_expr: COPY fieldAccessPlan__value(plan), else_expr: COPY TRY (mIRLowering__optional_nil_mir(&self, result_type)), lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
      result.result_type = result_type;
      RETURN Emittable{ IfOptional: COPY result };
    END
    MUTABLE target: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(node.target)));
    MUTABLE target_type: ?Type = TRY (type__from_node_mut(node.target, "@node field target"));
    IF TRY (type__node_reference?( UNWRAP (target_type))) THEN
      MUTABLE payload = UNWRAP (TRY (type__node_payload_type( UNWRAP (target_type))));
      zig_type = TRY (mIRLowering__transpile_type(self, MIRLoweringType{ StringValue: COPY type__resolved(payload) }));
      shared = type__shared_node?( UNWRAP (target_type));
      IF !(shared) THEN
        &self.state.function_state.node_store_types.insert(zig_type);
      END
      MUTABLE store = TRY (mIRLowering__node_store_type_mir(&self, zig_type, shared));
      MUTABLE resolved = MIRMethodCall{ receiver: Emittable{ Call: COPY store }, method: "getBound", args: [CAST(Ident{ name: mIRLowering__node_store_binding_name(self, zig_type, shared), lowered_node_id: NIL, ownership_consumption: NIL } AS Any), CAST(CAST(target AS Emittable) AS Any)], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(1)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
      target = MIROptionalUnwrap{ expr: Emittable{ MIRMethodCall: COPY resolved }, lowered_node_id: NIL, ownership_consumption: NIL };
    END
    RETURN fieldAccessPlan__value((TRY (mIRLowering__field_access_plan(&self, node, CAST(target AS Emittable)))));
END
PRIVATE FN mIRLowering__lower_tense_navigation_field(MUTABLE self: MIRLowering, MUTABLE node: GetField, navigation: TenseNavigation) RETURNS !Emittable ->
    RETURN TRY (mIRLowering__lower_tense_navigation(&self, Locatable{ GetField: COPY node }, navigation, %(receiver: String) USE(MUTABLE node, MUTABLE self) -> fieldAccessPlan__value(TRY (mIRLowering__field_access_plan(&self, node, Emittable{ Ident: COPY Ident{ name: COPY receiver, lowered_node_id: NIL, ownership_consumption: NIL } })))));
END
PRIVATE FN mIRLowering__lower_tense_navigation(MUTABLE self: MIRLowering, MUTABLE node: Locatable, navigation: TenseNavigation, mapper: FN(String) -> Emittable) RETURNS !Emittable ->
    MUTABLE plan: ?TenseOperationPlan = CAST(locatable__tense_plan(node) AS ?TenseOperationPlan);
    IF !((plan?.operation == TenseOperationKind.Navigate)) THEN
      panic("tense navigation lowering requires its annotation-produced TenseOperationPlan");
    END
    MUTABLE plan_value: TenseOperationPlan = plan?;
    MUTABLE source: Emittable = CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(navigation.target))) AS Emittable);
    MUTABLE future_map = tenseOperationPlan__owns_result?(plan_value);
    MUTABLE source_prefix, normalized_source = TRY (mIRLowering__normalize_allocating_used_expr(&self, &source, (future_map AND tenseOperationPlan__consumes_handle?(plan_value))));
    FOR concat_stmt IN source_prefix DO
      &self.state.function_state.pending_stmts.append(COPY concat_stmt);
    END
    source = COPY normalized_source;
    MUTABLE split = tenseEnvelope__split_future((TRY (tenseEnvelope__from_type(plan_value.input_type))));
    MUTABLE id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_560 = mIRLowering__lowering_counters(&self);
    mIRLoweringCounters__next_background_block_id(&rtoc_mutable_receiver_560) };
    MUTABLE raw_id = id.value;
    MUTABLE outer_bindings = TRY (mIRLowering__tense_map_bindings(self, raw_id, "outer", split.outer.length()));
    MUTABLE source_for_future_branch_value: ?Ident = NIL;
    IF (outer_bindings.length() == 0) THEN
      source_for_future_branch_value = castEmittableToIdent(source);
    ELSE
      source_for_future_branch_value = Ident{ name: COPY UNWRAP (outer_bindings.last()), lowered_node_id: NIL, ownership_consumption: NIL };
    END
    MUTABLE source_for_future: Ident = source_for_future_branch_value?;
    MUTABLE mapped_branch_value: ?MIRBgBlock = NIL;
    IF tenseOperationPlan__owns_result?(plan_value) THEN
      mapped_branch_value = TRY (mIRLowering__lower_future_tense_map(&self, &node, plan_value, Emittable{ Ident: COPY source_for_future }, split.inner, raw_id, mapper));
    ELSE
      MUTABLE bindings = TRY (mIRLowering__tense_map_bindings(self, raw_id, "direct", plan_value.navigation_layers.length()));
      MUTABLE value = mapper(UNWRAP (bindings.last()));
      RETURN Emittable{ DirectTenseMap: COPY mIRLowering__direct_tense_map(self, source, value, plan_value.navigation_layers, bindings, raw_id, plan_value.result_type) };
    END
    MUTABLE mapped: MIRBgBlock = mapped_branch_value?;
    IF (split.outer.length() == 0) THEN
      RETURN Emittable{ MIRBgBlock: COPY mapped };
    END
    MUTABLE outer = mIRLowering__direct_tense_map(self, source, Emittable{ MIRBgBlock: COPY mapped }, split.outer, outer_bindings, raw_id, plan_value.result_type);
    IF tenseOperationPlan__consumes_handle?(plan_value) THEN
    IF source IS_A Ident AS ident THEN
      MUTABLE ident_mutable = COPY ident;
      TRY (mIRLowering__with_ownership_consumption(&self, Emittable{ DirectTenseMap: COPY outer }, [ident_mutable.name], "tense navigation future capture", :capture, :heap));
    END
    END
    RETURN Emittable{ DirectTenseMap: COPY outer };
END
PRIVATE FN mIRLowering__lower_future_tense_map(MUTABLE self: MIRLowering, MUTABLE node: Locatable, operation: TenseOperationPlan, source: Emittable, inner_layers: []TenseLayer, id: Int64, mapper: FN(String) -> Emittable) RETURNS !MIRBgBlock ->
    MUTABLE source_value = "__tense_value${id.toString()}";
    MUTABLE inner_bindings = TRY (mIRLowering__tense_map_bindings(self, id, "inner", inner_layers.length()));
