      ELSE
        RETURN CAST(List[] AS []OwnershipFactTarget);
      END
    ELSE_IF node IS_A BreakStmt AS break_stmt THEN
      MUTABLE value:? = break_stmt.value;
      IF value THEN
        RETURN TRY (mIRLowering__ownership_fact_target_for_expr(&self, mIRLowering__ownership_fact_source(&self, &value), &value, NIL));
      ELSE
        RETURN CAST(List[] AS []OwnershipFactTarget);
      END
    ELSE_IF node IS_A ReassignWithCleanup AS reassign_with_cleanup THEN
      MUTABLE reassign_value: Emittable = COPY reassign_with_cleanup.value;
      RETURN TRY (mIRLowering__ownership_fact_target_for_expr(&self, CAST(reassign_with_cleanup.name AS String), &reassign_value, NIL));
    ELSE_IF node IS_A MIRBgBlock AS mir_bg_block THEN
      RETURN CAST([OwnershipFactTarget{ name: COPY mIRLowering__ownership_fact_source(&self, Emittable{ MIRBgBlock: COPY mir_bg_block }), expr: Emittable{ MIRBgBlock: COPY mir_bg_block }, type_info: NIL, include_owned_result: FALSE, include_transfer_contract: FALSE }] AS []OwnershipFactTarget);
    ELSE
      RETURN TRY (mIRLowering__ownership_fact_target_for_expr(&self, mIRLowering__ownership_fact_source(&self, &node), &node, NIL));
    END
END
FN mIRLowering__ownership_fact_target_for_expr(MUTABLE self: MIRLowering, name: String, MUTABLE expr: Emittable, type_info: ?Type) RETURNS ![]OwnershipFactTarget ->
    MUTABLE source_expr = mIRLowering__ownership_contract_source_node(&self, expr);
    MUTABLE include_owned_result = (TRY (mIRLowering__ownership_owned_result_fact_relevant?(&self, &expr)) AND !(source_expr IS_A MIRBgBlock));
    MUTABLE include_transfer_contract = TRY (mIRLowering__ownership_transfer_contract_relevant?(&self, &expr));
    IF !((include_owned_result OR include_transfer_contract)) THEN
      RETURN CAST(List[] AS []OwnershipFactTarget);
    END
    MUTABLE owned_result_type:? =   IF include_owned_result THEN
      (type_info OR_ELSE TRY (mIRLowering__mir_alloc_mark_type_info(&self, source_expr, NIL, "owned MIR result fact")))
    ELSE
      NIL
    END;
    RETURN CAST([OwnershipFactTarget{ name: COPY name, expr: COPY expr, type_info: COPY owned_result_type, include_owned_result: include_owned_result, include_transfer_contract: include_transfer_contract }] AS []OwnershipFactTarget);
END
FN mIRLowering__ownership_owned_result_fact_relevant?(MUTABLE self: MIRLowering, MUTABLE expr: Emittable) RETURNS !Bool ->
    MUTABLE source_expr = mIRLowering__ownership_contract_source_node(&self, expr);
    IF source_expr IS_A MIRBgBlock AS mir_bg_block THEN
      RETURN TRUE;
    END
    MUTABLE effect = TRY (ownershipEffect__of(source_expr));
    IF effect.produces_owned THEN
      RETURN TRUE;
    END
    IF (IF source_expr IS_A ShardedMapPut AS sharded_map_put THEN shardedMapPut__mutating_receiver_allocator_op?(sharded_map_put) ELSE FALSE END) THEN
      RETURN FALSE;
    END
    MUTABLE sig_branch_value: ?FunctionSignature@multiowned = NIL;
    IF (emittable__stdlib_def(source_expr) != NIL) THEN
      sig_branch_value = functionSignature__unwrap( (IF emittable__stdlib_def(source_expr) EXISTS AS rtoc_wrap_2795 THEN X{ FunctionSignature: COPY rtoc_wrap_2795 } ELSE NIL END));
    ELSE
      sig_branch_value = NIL;
    END
    MUTABLE sig: ?FunctionSignature@multiowned = sig_branch_value;
    RETURN ((sig != NIL) AND (TRY (functionSignature__emits_allocating?(sig)) == TRUE));
END
FN mIRLowering__ownership_transfer_contract_relevant?(MUTABLE self: MIRLowering, MUTABLE expr: Emittable) RETURNS !Bool ->
    MUTABLE source_expr = mIRLowering__ownership_contract_source_node(&self, expr);
    MUTABLE contract: ?OwnershipContract@multiowned = TRY (emittable__explicit_ownership_contract(source_expr));
    IF contract EXISTS AS contract_value THEN
      RETURN !((TRY (ownershipContract__owned_operand_names(contract_value))).empty?());
    END
    RETURN FALSE;
END
FN mIRLowering__ownership_transfer_only_target(MUTABLE self: MIRLowering, MUTABLE expr: Emittable) RETURNS OwnershipFactTarget ->
    RETURN OwnershipFactTarget{ name: COPY mIRLowering__ownership_fact_source(&self, &expr), expr: COPY expr, type_info: NIL, include_owned_result: FALSE, include_transfer_contract: TRUE };
END
FN mIRLowering__if_bind_ownership_fact_targets(MUTABLE self: MIRLowering, node: IfBindStmt) RETURNS ![]OwnershipFactTarget ->
    # `bindings` is a list of MIRIfBinding structs here, not Ruby hashes: the
    # capture and the expression are fields, not keys.
    MUTABLE targets: []OwnershipFactTarget = List[];
    FOR binding IN node.bindings DO
      MUTABLE binding_expr: Emittable = COPY binding.expr;
      FOR target IN TRY (mIRLowering__ownership_fact_target_for_expr(&self, CAST(binding.capture AS String), &binding_expr, NIL)) DO
        &targets.append(COPY target);
      END
    END
    RETURN targets;
END
FN mIRLowering__append_ownership_store_facts_for_consumption_mut(MUTABLE self: MIRLowering, MUTABLE facts: []MIRLoweringOwnershipFact, MUTABLE node: Emittable) RETURNS Void ->
    MUTABLE fact_optional: ?OwnershipConsumptionFact = emittable__ownership_consumption(node);
    IF !(fact_optional) THEN
      RETURN;
    END
    MUTABLE fact: OwnershipConsumptionFact = fact_optional;
    MUTABLE source = mIRLowering__ownership_fact_source(&self, &node);
    FOR _ IN ownershipConsumptionFact__names(fact) DO
    &facts.append(MIRLoweringOwnershipFact{ OwnedStore: COPY OwnedStore{ name: COPY CAST(_ AS String), target: COPY fact.source, alloc: COPY fact.target_alloc, source: COPY source, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    END
    NIL;
END
FN mIRLowering__append_ownership_transfer_facts_for_consumption_mut(MUTABLE self: MIRLowering, MUTABLE facts: []MIRLoweringOwnershipFact, MUTABLE node: Emittable) RETURNS Void ->
    MUTABLE fact_optional: ?OwnershipConsumptionFact = emittable__ownership_consumption(node);
    IF !(fact_optional) THEN
      RETURN;
    END
    MUTABLE fact: OwnershipConsumptionFact = fact_optional;
    MUTABLE source = mIRLowering__ownership_fact_source(&self, &node);
    FOR _ IN ownershipConsumptionFact__names(fact) DO
    &facts.append(MIRLoweringOwnershipFact{ OwnedTransfer: COPY OwnedTransfer{ name: COPY CAST(_ AS String), target: fact.target, source: COPY source, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    END
    NIL;
END
FN mIRLowering__ownership_facts_for_structural_node(MUTABLE self: MIRLowering, MUTABLE node: Emittable) RETURNS ![]MIRLoweringOwnershipFact ->
    MUTABLE facts: []MIRLoweringOwnershipFact = List[];
    mIRLowering__append_ownership_facts_for_structural_node_mut(&self, &facts, node);
    RETURN facts;
END
FN mIRLowering__append_ownership_facts_for_structural_node_mut(MUTABLE self: MIRLowering, MUTABLE facts: []MIRLoweringOwnershipFact, node: Emittable) RETURNS Void ->
    IF node IS_A AllocMark AS alloc_mark THEN
      &facts.append(MIRLoweringOwnershipFact{ OwnedCreate: COPY mIRLowering__owned_create_fact_for_alloc_mark(&self, COPY alloc_mark, mIRLowering__ownership_fact_source(&self, Emittable{ AllocMark: COPY alloc_mark })) });
    ELSE_IF node IS_A Cleanup AS cleanup THEN
      &facts.append(MIRLoweringOwnershipFact{ OwnedDestroy: COPY OwnedDestroy{ name: COPY CAST(cleanup.name AS String), alloc: COPY cleanup.cleanup_entry.alloc, source: COPY mIRLowering__ownership_fact_source(&self, Emittable{ Cleanup: COPY cleanup }), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    ELSE_IF node IS_A ErrCleanup AS err_cleanup THEN
      &facts.append(MIRLoweringOwnershipFact{ OwnedDestroy: COPY OwnedDestroy{ name: COPY CAST(err_cleanup.name AS String), alloc: COPY err_cleanup.cleanup_entry.alloc, source: COPY mIRLowering__ownership_fact_source(&self, Emittable{ ErrCleanup: COPY err_cleanup }), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    ELSE_IF node IS_A TransferMark AS mir_lowering_transfer_mark THEN
      &facts.append(MIRLoweringOwnershipFact{ OwnedTransfer: COPY OwnedTransfer{ name: COPY COPY mir_lowering_transfer_mark.name, target: mir_lowering_transfer_mark.target, source: mIRLowering__ownership_fact_source(&self, Emittable{ TransferMark: COPY mir_lowering_transfer_mark }), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    END
    NIL;
END
FN mIRLowering__owned_create_fact_for_alloc_mark(MUTABLE self: MIRLowering, mark: AllocMark, source: String) RETURNS OwnedCreate ->
    RETURN OwnedCreate{ name: COPY mark.name, alloc: COPY mark.alloc, type_info: COPY mark.type_info, source: COPY source, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
FN mIRLowering__append_ownership_facts_for_owned_result_mut(MUTABLE self: MIRLowering, MUTABLE facts: []MIRLoweringOwnershipFact, target_name: String, MUTABLE expr: Emittable, type_info: Type) RETURNS !Void ->
    MUTABLE source_expr = mIRLowering__ownership_contract_source_node(&self, expr);
    IF source_expr IS_A MIRBgBlock AS mir_bg_block THEN
      &facts.append(MIRLoweringOwnershipFact{ OwnedReturn: COPY OwnedReturn{ name: COPY target_name, source: mIRLowering__ownership_fact_source(&self, Emittable{ MIRBgBlock: COPY mir_bg_block }), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
      RETURN;
    END
    MUTABLE effect = TRY (ownershipEffect__of(source_expr));
    IF !(effect.produces_owned) THEN
      MUTABLE sig_branch_value: ?FunctionSignature@multiowned = NIL;
      IF (emittable__stdlib_def(source_expr) != NIL) THEN
        sig_branch_value = functionSignature__unwrap( (IF emittable__stdlib_def(source_expr) EXISTS AS rtoc_wrap_2904 THEN X{ FunctionSignature: COPY rtoc_wrap_2904 } ELSE NIL END));
      ELSE
        sig_branch_value = NIL;
      END
      MUTABLE sig: ?FunctionSignature@multiowned = sig_branch_value;
      IF !((IF sig != NIL THEN
        TRY (functionSignature__emits_allocating?(sig))
      ELSE
        NIL
      END)) THEN
        RETURN;
      END
      &facts.append(MIRLoweringOwnershipFact{ OwnedCreate: COPY OwnedCreate{ name: COPY target_name, alloc: COPY (mIRLowering__mir_owned_alloc(&self, source_expr) OR_ELSE :heap), type_info: COPY type_info, source: COPY mIRLowering__ownership_fact_source(&self, &source_expr), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
      RETURN;
    END
    &facts.append(MIRLoweringOwnershipFact{ OwnedCreate: COPY OwnedCreate{ name: COPY target_name, alloc: COPY ((effect.alloc OR_ELSE TRY (mIRLowering__mir_owned_alloc(&self, source_expr))) OR_ELSE :heap), type_info: COPY type_info, source: COPY mIRLowering__ownership_fact_source(&self, &source_expr), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    NIL;
END
FN mIRLowering__append_ownership_transfer_facts_for_contract_mut(MUTABLE self: MIRLowering, MUTABLE facts: []MIRLoweringOwnershipFact, MUTABLE expr: Emittable) RETURNS !Void ->
    MUTABLE names = TRY (mIRLowering__ownership_contract_consumes_unwrapped(&self, &expr));
    IF (names.length() == 0) THEN
      RETURN;
    END
    MUTABLE source = mIRLowering__ownership_fact_source(&self, &expr);
    FOR _ IN names DO
    &facts.append(MIRLoweringOwnershipFact{ OwnedTransfer: COPY OwnedTransfer{ name: COPY _, target: :owned_sink, source: COPY source, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    END
    NIL;
END
FN mIRLowering__ownership_contract_consumes_unwrapped(MUTABLE self: MIRLowering, MUTABLE node: Emittable) RETURNS ![]String ->
    MUTABLE unwrapped = mIRLowering__ownership_contract_source_node(&self, node);
    RETURN TRY (mIRLowering__ownership_contract_consumes(&self, unwrapped));
END
FN mIRLowering__ownership_fact_source(MUTABLE self: MIRLowering, MUTABLE node: Emittable) RETURNS String ->
    MUTABLE source_node = mIRLowering__ownership_contract_source_node(&self, node);
    IF (source_node IS_A ReassignWithCleanup OR source_node IS_A ShardedMapPut) THEN
      RETURN COPY emittable__variant_name(source_node);
    END
    IF ((emittable__target_var(source_node) != NIL) AND emittable__target_var(source_node)) THEN
      RETURN COPY CAST(emittable__target_var(source_node) AS String);
    END
    IF (source_node IS_A Call OR source_node IS_A TailCall) THEN
      RETURN COPY CAST(emittable__callee(source_node) AS String);
    END
    IF source_node IS_A MIRMethodCall AS mir_method_call THEN
      RETURN COPY mir_method_call.method;
    END
    IF source_node IS_A MIRBgBlock AS mir_bg_block THEN
      RETURN COPY "MIR::BgBlock";
    END
    IF source_node IS_A StreamSpawn AS stream_spawn THEN
      RETURN COPY "MIR::StreamSpawn";
    END
    IF ((emittable__reason(source_node) != NIL) AND emittable__reason(source_node)) THEN
      RETURN COPY CAST(emittable__reason(source_node) AS String);
    END
    IF (aST__node_name(castEmittableToLocatable__mir_lowering(source_node)) EXISTS) THEN
      RETURN COPY CAST(emittable__name(source_node) AS String);
    END
    RETURN emittable__variant_name(source_node);
END
FN mIRLowering__ownership_contract_source_node(MUTABLE self: MIRLowering, node: Emittable) RETURNS Emittable ->
    MUTABLE current: Emittable = COPY node;
    WHILE mIR__expr_wrapper?(current) DO
      current = CAST(emittable__expr(current) AS Emittable);
    END
    RETURN current;
END
FN mIRLowering__transfer_mark_present?(MUTABLE self: MIRLowering, nodes: []Emittable, name: String) RETURNS Bool ->
    RETURN nodes |> ANY (IF _ IS_A TransferMark AS transfer_mark THEN (transfer_mark.name == name) ELSE FALSE END);
END
FN mIRLowering__pre_terminator_transfer_marks(MUTABLE self: MIRLowering, node: Emittable, emitted: []Emittable, remaining: []Emittable) RETURNS ![]Emittable ->
    IF node IS_A ReturnStmt AS return_stmt THEN
      MUTABLE return_stmt_mutable = COPY return_stmt;
      MUTABLE value: ?Emittable = COPY return_stmt_mutable.value;
      IF value == NIL THEN
        RETURN CAST(List[] AS []Emittable);
      END
      IF !(value IS_A Ident) THEN
        RETURN CAST(List[] AS []Emittable);
      END
      MUTABLE name: String = COPY CAST(emittable__name(value) AS String);
      IF (mIRLowering__transfer_mark_present?(&self, emitted, name) OR mIRLowering__transfer_mark_present?(&self, remaining, name)) THEN
        RETURN CAST(List[] AS []Emittable);
      END
      # Ruby scans `emitted.reverse.find`; CLEAR lists have no reverse, so the
      # scan runs back to front by index.
      MUTABLE cleanup: ?Emittable = NIL;
      MUTABLE scan_idx: Int64 = (emitted.length() - 1);
      WHILE scan_idx >= 0 DO
        MUTABLE scan_node: Emittable = UNWRAP (emitted[scan_idx]);
        IF scan_node IS_A ErrCleanup AS scan_err_cleanup THEN
          IF ((scan_err_cleanup.name == name) AND (cleanup == NIL)) THEN
            cleanup = COPY scan_node;
          END
        END
        scan_idx = scan_idx - 1;
      END
      IF cleanup EXISTS AS cleanup_value THEN
        MUTABLE cleanup_value_mutable = COPY cleanup_value;
        IF !(emitted |> ANY (IF _ IS_A AllocMark AS alloc_mark THEN (alloc_mark.name == name) ELSE FALSE END)) THEN
          RETURN CAST(List[] AS []Emittable);
        END
        MUTABLE rtoc_mutable_receiver_61 = CAST(castEmittableToErrCleanup(cleanup_value_mutable).cleanup_entry AS CleanupEntry);
        cleanupEntry__mark_moved_guard_mut(&rtoc_mutable_receiver_61);
        RETURN TRY (ownershipTransferPlan__marks((OwnershipTransferPlan{ name: COPY name, target: :return, target_alloc: NIL, move_guarded: TRUE })));
      ELSE
        RETURN CAST(List[] AS []Emittable);
      END
    ELSE
      RETURN CAST(List[] AS []Emittable);
    END
END
FN mIRLowering__finalize_nested_mir_bodies_mut(MUTABLE self: MIRLowering, MUTABLE node: Emittable, parent_state: OwnershipFinalizationContext, inherited_alloc_names: [Set]String = Set[], inherited_guarded_names: [Set]String = Set[]) RETURNS !Void
  EFFECTS REENTRANT ->
    FOR _ IN emittable__child_exprs(node) DO
    TRY (mIRLowering__finalize_nested_mir_expr_bodies_mut(&self, _, inherited_alloc_names, inherited_guarded_names, parent_state));
    END
    # Ruby's `slot.replace(...)` writes the slot's body back; the slot is a
    # struct here, so the body field is assigned directly.
    FOR MUTABLE body_slot IN emittable__body_slots(node) DO
      body_slot.body = TRY (mIRLowering__append_nested_ownership_transfers_for_mir_body(&self, COPY body_slot.body, inherited_alloc_names, inherited_guarded_names, parent_state));
    END
    NIL;
END
FN mIRLowering__finalize_nested_mir_expr_bodies_mut(MUTABLE self: MIRLowering, expr: ?Emittable, inherited_alloc_names: [Set]String, inherited_guarded_names: [Set]String, parent_state: OwnershipFinalizationContext) RETURNS !Void
  EFFECTS REENTRANT ->
    IF expr EXISTS AS expr_value THEN
      IF !(emittable__expr?(expr_value)) THEN
        RETURN;
      END
      FOR MUTABLE rtoc_mutable_block_param_65 IN emittable__body_slots(expr_value) DO
        rtoc_mutable_block_param_65.body = TRY (mIRLowering__append_nested_ownership_transfers_for_mir_body(&self, COPY rtoc_mutable_block_param_65.body, inherited_alloc_names, inherited_guarded_names, parent_state));
      END
      TRY (mIRLowering__each_mir_expr_child(self, expr_value, %(MUTABLE child: Emittable) USE(inherited_alloc_names, inherited_guarded_names, parent_state, MUTABLE self) -> {
    TRY (mIRLowering__finalize_nested_mir_expr_bodies_mut(&self, child, inherited_alloc_names, inherited_guarded_names, parent_state));
    rubyToClearVoid__mir_lowering()
      }));
      NIL;
    ELSE
      RETURN;
    END
END
FN mIRLowering__implicit_alloc_mark_for_mir_node(MUTABLE self: MIRLowering, MUTABLE node: Emittable, state: OwnershipFinalizationContext) RETURNS !?AllocMark ->
    MUTABLE fact: ?AllocatingResultFact = TRY (mIRLowering__implicit_allocating_result_fact(&self, node, state));
    IF fact != NIL THEN
    RETURN allocatingResultFact__alloc_mark(fact);
    ELSE
    RETURN NIL;
    END
END
FN mIRLowering__implicit_allocating_result_fact(MUTABLE self: MIRLowering, node: Emittable, state: OwnershipFinalizationContext) RETURNS !?AllocatingResultFact ->
    IF node IS_A Let AS let THEN
      MUTABLE init = let.init;
      IF !(TRY (mIRLowering__mir_allocates?(&self, init))) THEN
        RETURN NIL;
      END
      IF mIRLowering__mutating_receiver_allocator_op?(self, init) THEN
        RETURN NIL;
      END
      MUTABLE name = COPY let.name;
      MUTABLE existing_mark: ?AllocMark = COPY state.alloc_marks[name];
      IF existing_mark EXISTS AS existing_mark_value THEN
        TRY (mIRLowering__stamp_allocating_result_target_mut(&self, &init, name, existing_mark_value.alloc));
        RETURN NIL;
      END
      MUTABLE effect = TRY (ownershipEffect__of(init));
      MUTABLE alloc:? = ((IF effect.alloc != NIL THEN effect.alloc ELSE TRY (mIRLowering__mir_owned_alloc(&self, init)) END));
      TRY (mIRLowering__stamp_allocating_result_target_mut(&self, &init, name, alloc));
      MUTABLE type_info = (let.annotation OR_ELSE TRY (mIRLowering__mir_alloc_mark_type_info(&self, init, NIL, "implicit MIR allocation fact")));
      RETURN AllocatingResultFact{ name: COPY name, ownership_effect: { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_66: ?OwnershipEffect = NIL;
      IF effect.produces_owned THEN
        rtoc_ternary_value_66 = ownershipEffect__with_target(effect, name);
      ELSE
        rtoc_ternary_value_66 = ownershipEffect__owned(alloc, :uniform, TRUE, name);
      END
      rtoc_ternary_value_66? }, type_info: COPY type_info, scope: COPY placement__alloc_scope(alloc) };
    ELSE
      RETURN NIL;
    END
END
FN mIRLowering__ownership_transfers_for_stmt(MUTABLE self: MIRLowering, stmt: MIRLoweringLowerableStmt, guarded_cleanup_names: [Set]String) RETURNS ![]Emittable ->
    IF castMIRLoweringLowerableStmtToLocatable(stmt) EXISTS AS locatable THEN
      IF locatable IS_A ReturnNode AS return_node THEN
        RETURN CAST(List[] AS []Emittable);
      END
      IF aST__ownership_transfer_stmt?(locatable) THEN
        RETURN CAST(List[] AS []Emittable);
      END
      MUTABLE marks: []Emittable = List[];
      MUTABLE rtoc_each_items_70 = (CAST(((TRY (mIRLowering__collect_bg_capture_transfer_roots(&self, locatable))) |> DISTINCT _) AS []String));
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < rtoc_each_items_70.length() DO
      MUTABLE safe = mIRLowering__zig_safe_name(self, UNWRAP (rtoc_each_items_70[rtoc_idx]));
      MUTABLE rename_map = TRY (functionState__rename_map(mIRLowering__function_state(&self)));
      IF rename_map.contains?(safe) THEN
            safe = UNWRAP (COPY rename_map[safe]);
      END
      MUTABLE entry = ((TRY (functionState__bindings(mIRLowering__function_state(&self))))[UNWRAP (rtoc_each_items_70[rtoc_idx])] OR_ELSE cleanupEntry__none());
      IF !(cleanupEntry__present?(entry)) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      marks = ruby_array_concat_Stmt(marks, TRY (ownershipTransferPlan__marks((mIRLowering__ownership_transfer_plan(self, safe, :owned_sink, guarded_cleanup_names, cleanupEntry__alloc(entry))))));
    rtoc_idx = rtoc_idx + 1;
      END
      RETURN marks;
    ELSE
      RETURN CAST(List[] AS []Emittable);
    END
END
FN mIRLowering__ownership_transfers_for_node(MUTABLE self: MIRLowering, node: Emittable, state: OwnershipFinalizationContext) RETURNS ![]Emittable ->
    IF node IS_A ReturnStmt AS return_stmt THEN
      RETURN CAST(List[] AS []Emittable);
    END
    RETURN TRY (mIRLowering__ownership_transfers_for_targets(&self, TRY (mIRLowering__ownership_transfer_operands_for_node(&self, node, state)), state));
END
FN mIRLowering__ownership_transfers_for_targets(MUTABLE self: MIRLowering, operand_targets: []OwnershipTransferTarget, state: OwnershipFinalizationContext) RETURNS ![]Emittable ->
    MUTABLE marks: []Emittable = List[];
    MUTABLE generated_mark_names: [Set]String = Set[];
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < operand_targets.length() DO
      MUTABLE name: String = COPY UNWRAP (operand_targets[rtoc_idx]).name;
      IF (name.length() == 0) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF (state.body_transfer_mark_names.contains?(name) OR generated_mark_names.contains?(name)) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE operand_target = UNWRAP (operand_targets[rtoc_idx]);
      marks = ruby_array_concat_Stmt(marks, TRY (ownershipTransferPlan__marks(mIRLowering__ownership_transfer_plan(self, COPY name, COPY operand_target.target, state.guarded_cleanup_names, COPY operand_target.target_alloc))));
      &generated_mark_names.insert(name);
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN marks;
END
FN mIRLowering__ownership_transfer_operands_for_node(MUTABLE self: MIRLowering, node: Emittable, state: OwnershipFinalizationContext) RETURNS ![]OwnershipTransferTarget ->
    MUTABLE operands: []OwnershipTransferTarget = List[];
    TRY (mIR__each_surface_node(NodeRoot{ Emittable: COPY node }, %(MUTABLE surface_node: Emittable) USE(MUTABLE operands, state, MUTABLE self) -> {
    TRY (mIRLowering__append_ownership_transfer_targets_for_surface_node_mut(&self, &operands, &surface_node, state));
    rubyToClearVoid__mir_lowering()
    }));
    MUTABLE seen: [Set]String = Set[];
    MUTABLE deduped: []OwnershipTransferTarget = List[];
    FOR operand IN operands DO
      MUTABLE key = "${operand.name}|${CAST(operand.target AS String)}|${(CAST(operand.target_alloc AS ?String) OR_ELSE "")}";
      IF !(seen.contains?(key)) THEN
        &seen.insert(COPY key);
        &deduped.append(COPY operand);
      END
    END
    RETURN deduped;
END
FN mIRLowering__append_ownership_transfer_targets_for_surface_node_mut(MUTABLE self: MIRLowering, MUTABLE operands: []OwnershipTransferTarget, MUTABLE surface_node: Emittable, state: OwnershipFinalizationContext) RETURNS !Void ->
    MUTABLE fact: ?OwnershipConsumptionFact = mIRLowering__ownership_consumption_for_node(self, surface_node);
    IF fact EXISTS AS fact_value THEN
      FOR operand IN fact_value.operands DO
        IF !(operand.borrowed) THEN
          IF operand.name EXISTS AS operand_name THEN
            &operands.append(OwnershipTransferTarget{ name: COPY operand_name, target: COPY fact_value.target, target_alloc: (COPY operand.target_alloc OR_ELSE COPY fact_value.target_alloc) });
          END
        END
      END
    ELSE_IF surface_node IS_A CapWrap AS cap_wrap THEN
      MUTABLE rtoc_each_items_77 = TRY (mIRLowering__mir_ident_names(self, cap_wrap.inner));
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < rtoc_each_items_77.length() DO
      IF !((state.body_alloc_mark_names.contains?(rtoc_each_items_77[rtoc_idx]?) OR TRY (mIRLowering__owned_binding_visible?(&self, rtoc_each_items_77[rtoc_idx]?)))) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      &operands.append(OwnershipTransferTarget{ name: COPY rtoc_each_items_77[rtoc_idx]?, target: :owned_sink, target_alloc: COPY cap_wrap.alloc });
    rtoc_idx = rtoc_idx + 1;
      END
    END
    MUTABLE contract: ?OwnershipContract@multiowned = mIRLowering__ownership_contract_for_node(self, surface_node);
    IF contract EXISTS AS contract_value THEN
      FOR operand IN contract_value.operands DO
        IF !(operand.borrowed) THEN
          IF operand.name EXISTS AS operand_name THEN
            &operands.append(OwnershipTransferTarget{ name: COPY operand_name, target: :owned_sink, target_alloc: COPY operand.target_alloc });
          END
        END
      END
    END
    NIL;
END
FN mIRLowering__ownership_consumption_for_node(self: MIRLowering, node: Emittable) RETURNS ?OwnershipConsumptionFact ->
    MUTABLE fact: ?OwnershipConsumptionFact = emittable__ownership_consumption(node);
    IF fact EXISTS THEN
      RETURN fact;
    END
    IF node IS_A Let AS rtoc_let THEN
    IF emittable__ownership_consumption(rtoc_let.init) EXISTS AS rtoc_let_fact THEN
      RETURN rtoc_let_fact;
    END
    END
    IF node IS_A ExprStmt AS rtoc_expr_stmt THEN
    IF emittable__ownership_consumption(exprStmt__expr(rtoc_expr_stmt)) EXISTS AS rtoc_expr_fact THEN
      RETURN rtoc_expr_fact;
    END
    END
    RETURN NIL;
END
FN mIRLowering__ownership_contract_for_node(self: MIRLowering, node: ?Emittable) RETURNS !?OwnershipContract@multiowned ->
    IF (node != NIL) THEN
      RETURN emittable__explicit_ownership_contract(node);
    ELSE
      RETURN NIL;
    END
END
FN mIRLowering__ownership_transfer_plan(self: MIRLowering, name: String, target: String@symbol, guarded_cleanup_names: [Set]String, target_alloc: ?String@symbol = NIL) RETURNS OwnershipTransferPlan ->
    RETURN OwnershipTransferPlan{ name: COPY name, target: COPY target, target_alloc: COPY target_alloc, move_guarded: guarded_cleanup_names.contains?(name) };
END
FN mIRLowering__ownership_transfer_marks(MUTABLE self: MIRLowering, name: String, target: String@symbol, target_alloc: ?String@symbol = NIL, move_guarded: Bool = FALSE) RETURNS ![]Emittable ->
    RETURN TRY (ownershipTransferPlan__marks((OwnershipTransferPlan{ name: COPY name, target: COPY target, target_alloc: COPY target_alloc, move_guarded: move_guarded })));
END
FN mIRLowering__ownership_contract_consumes(MUTABLE self: MIRLowering, node: Emittable) RETURNS ![]String ->
    MUTABLE contract: !?OwnershipContract@multiowned = emittable__explicit_ownership_contract(node);
    IF !(contract) THEN
      RETURN CAST(List[] AS []String);
    END
    RETURN (TRY (ownershipContract__owned_operand_names(contract))) |> SELECT _.toString();
END
FN mIRLowering__with_ownership_consumption(MUTABLE self: MIRLowering, MUTABLE node: Emittable, names: []String, source: String, target: String@symbol = :owned_sink, target_alloc: ?String@symbol = NIL, require_visible: Bool = TRUE) RETURNS !Emittable ->
    MUTABLE operands = TRY (mIRLowering__ownership_consumed_name_operands(&self, names, source, target_alloc, require_visible));
    IF ((operands.length() == 0) AND !(TRY (mIRLowering__ownership_consumer_requires_fact?(&self, node)))) THEN
      RETURN COPY node;
    END
    emittable__set_ownership_consumption_mut(&node, OwnershipConsumptionFact{ operands: COPY operands, target: COPY target, target_alloc: COPY target_alloc, source: COPY source, covers_consuming_params: TRUE });    RETURN COPY node;
END
FN mIRLowering__ownership_consumer_requires_fact?(MUTABLE self: MIRLowering, node: Emittable) RETURNS !Bool ->
    IF node IS_A ReassignWithCleanup AS reassign_with_cleanup THEN
      RETURN TRUE;
    END
    IF !((emittable__stdlib_def(node) != NIL)) THEN
      RETURN FALSE;
    END
    MUTABLE sig: ?FunctionSignature@multiowned = emittable__stdlib_def(node);
    IF !(sig) THEN
      RETURN FALSE;
    END
    MUTABLE params: ?[]Param = aST__node_params( CAST(sig AS Locatable));
    IF ((params OR_ELSE List[]) |> ANY (_.takes == TRUE)) THEN
      RETURN TRUE;
    END
    RETURN (TRUE AND TRY (functionSignature__takes_ownership?(&sig)));
END
FN mIRLowering__ownership_consumed_name_operands(MUTABLE self: MIRLowering, names: []String, source: String, target_alloc: ?String@symbol, require_visible: Bool = TRUE) RETURNS ![]OwnershipOperandFact ->
    # Ruby maps/rejects/uniqs the NAMES and then builds one fact per surviving
    # name. rtoc cast the name list itself to a list of facts.
    MUTABLE facts: []OwnershipOperandFact = List[];
    MUTABLE seen: [Set]String = Set[];
    FOR raw_name IN names DO
      IF !(raw_name.empty?()) THEN
        IF !(seen.contains?(raw_name)) THEN
          &seen.insert(COPY raw_name);
          MUTABLE entry: CleanupEntry@multiowned = ((TRY (functionState__bindings(mIRLowering__function_state(&self))))[raw_name] OR_ELSE cleanupEntry__none());
          MUTABLE has_alloc_mark: Bool = mIRLowering__function_state(&self).lowered_alloc_names.contains?(raw_name);
          IF (!(require_visible) OR (has_alloc_mark OR cleanupEntry__needs_cleanup?(entry))) THEN
            &facts.append(ownershipOperandFact__owned_binding(COPY raw_name, TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })), COPY source, COPY target_alloc));
          END
        END
      END
    END
    RETURN facts;
END
FN mIRLowering__with_ownership_consumption_for_value(MUTABLE self: MIRLowering, MUTABLE node: Emittable, MUTABLE value_mir: Emittable, MUTABLE ast_value: Locatable, source: String, target: String@symbol = :owned_sink, target_alloc: ?String@symbol = NIL, value_type: ?Type = NIL) RETURNS !Emittable ->
    MUTABLE operands: []OwnershipOperandFact = List[];
    IF value_type EXISTS AS value_type_value THEN
      operands = TRY (mIRLowering__ownership_operands_for_sink_value(&self, &value_mir, &ast_value, value_type_value, source, target_alloc, FALSE));
    ELSE
      operands = TRY (mIRLowering__ownership_operands_for_value(&self, &value_mir, &ast_value, source, target_alloc));
    END
    IF ((operands.length() == 0) AND !(TRY (mIRLowering__ownership_consumer_requires_fact?(&self, node)))) THEN
      RETURN COPY node;
    END
    emittable__set_ownership_consumption_mut(&node, OwnershipConsumptionFact{ operands: COPY operands, target: COPY target, target_alloc: COPY target_alloc, source: COPY source, covers_consuming_params: TRUE });    RETURN COPY node;
END
FN mIRLowering__ownership_operands_for_value(MUTABLE self: MIRLowering, MUTABLE value_mir: Emittable, MUTABLE ast_value: Locatable, source: String, target_alloc: ?String@symbol = NIL) RETURNS ![]OwnershipOperandFact ->
    MUTABLE ti = TRY (mIRLowering__ownership_operand_type(&self, ast_value, "ownership operand"));
    RETURN TRY (mIRLowering__ownership_operands_for_sink_value(&self, &value_mir, &ast_value, CAST(ti AS Type), source, target_alloc, FALSE));
END
FN mIRLowering__ownership_operands_for_lowered_takes_arg(MUTABLE self: MIRLowering, MUTABLE value_mir: Emittable, MUTABLE ast_value: Locatable, source: String, target_alloc: ?String@symbol, sink_type: ?Type = NIL) RETURNS ![]OwnershipOperandFact ->
    MUTABLE ti = (sink_type OR_ELSE TRY (mIRLowering__ownership_operand_type(&self, ast_value, "ownership sink argument")));
    RETURN TRY (mIRLowering__ownership_operands_for_sink_value(&self, &value_mir, &ast_value, ti, source, target_alloc, TRUE));
END
FN mIRLowering__ownership_operand_type(MUTABLE self: MIRLowering, ast_value: Locatable, context: String) RETURNS !Type ->
    MUTABLE coerced: ?Type = locatable__coerced_type_object(ast_value);
    RETURN TRY (type__new( TypeConstructionInput{ Type: COPY UNWRAP (coerced) }));
END
FN mIRLowering__ownership_operands_for_sink_value(MUTABLE self: MIRLowering, MUTABLE value_mir: Emittable, MUTABLE ast_value: Locatable, ti: Type, source: String, target_alloc: ?String@symbol, require_visible_owned: Bool) RETURNS ![]OwnershipOperandFact ->
    IF TRY (type__node_reference?(ti)) THEN
      RETURN CAST([ownershipOperandFact__non_owning(ti, source)] AS []OwnershipOperandFact);
    END
    MUTABLE fact_holder: Emittable = COPY value_mir;
    WHILE (((fact_holder IS_A MIRCast OR fact_holder IS_A TryExpr) OR fact_holder IS_A TryOptional) OR fact_holder IS_A TryCatch) DO
      fact_holder = UNWRAP (emittable__expr(fact_holder));
    END
    MUTABLE explicit_fact: ?OwnershipConsumptionFact = emittable__ownership_consumption(fact_holder);
    IF explicit_fact EXISTS THEN
      RETURN TRY (mIRLowering__retarget_ownership_operands(&self, explicit_fact.operands, target_alloc));
    END
    IF (IF value_mir IS_A Ident AS ident THEN mIRLowering__materialized_owned_binding_visible?(&self, CAST(ident.name AS String)) ELSE FALSE END) THEN
      RETURN CAST([ownershipOperandFact__owned_binding(CAST(emittable__name(value_mir) AS String), ti, source, target_alloc)] AS []OwnershipOperandFact);
    END
    IF TRY (mIRLowering__mir_produces_owned_result?(&self, value_mir)) THEN
      RETURN CAST([ownershipOperandFact__owned_result(ti, source, target_alloc)] AS []OwnershipOperandFact);
    END
    IF !(TRY (mIRLowering__ownership_tracked_transfer_type?(&self, ti))) THEN
      RETURN CAST([ownershipOperandFact__non_owning(ti, source)] AS []OwnershipOperandFact);
    END
    MUTABLE visible_name: ?String = TRY (mIRLowering__mir_ident_names(self, value_mir)) |> FIND TRY (mIRLowering__owned_binding_visible?(&self, _));
    IF visible_name EXISTS AS visible_name_value THEN
      RETURN CAST([ownershipOperandFact__owned_binding(visible_name_value, ti, source, target_alloc)] AS []OwnershipOperandFact);
    END
    IF mIRLowering__rodata_ownership_ast?(&self, ast_value) THEN
      RETURN CAST([ownershipOperandFact__non_owning(ti, source)] AS []OwnershipOperandFact);
    END
    IF mIRLowering__non_consuming_owned_value_expr?(&self, value_mir) THEN
      RETURN CAST([ownershipOperandFact__non_owning(ti, source)] AS []OwnershipOperandFact);
    END
    # A COPY hands over a NEW buffer; the source keeps the one it had. The
    # operand is that fresh value -- naming the copied BINDING transfers it,
    # and the next read of it is then a use after transfer. `ownership_root_
    # name` reaches through COPY on purpose (a reassignment's provenance is
    # its source), so the check has to come before it.
    IF ast_value IS_A CopyNode THEN
      RETURN CAST([ownershipOperandFact__owned_result(ti, source, target_alloc)] AS []OwnershipOperandFact);
    END
    IF TRY (mIRLowering__borrowed_ownership_ast?(&self, ast_value)) THEN
      RETURN CAST([ownershipOperandFact__borrowed_access(mIRLowering__ownership_root_name(&self, ast_value), ti, source, target_alloc)] AS []OwnershipOperandFact);
    END
    MUTABLE root: ?String = mIRLowering__ownership_root_name(&self, ast_value);
    IF root EXISTS AS root_value THEN
      MUTABLE mapped = TRY (mIRLowering__transfer_binding_name(&self, root_value));
      IF (TRY (mIRLowering__owned_binding_visible?(&self, mapped)) OR ((!(require_visible_owned) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_79 = (((TRY (functionState__bindings(mIRLowering__function_state(&self))))[root_value] OR_ELSE cleanupEntry__none()));
      cleanupEntry__present?(rtoc_local_receiver_79) }))) THEN
        RETURN CAST([ownershipOperandFact__owned_binding(mapped, ti, source, target_alloc)] AS []OwnershipOperandFact);
      END
      IF TRY (mIRLowering__visible_owned_operand_value?(&self, ast_value, value_mir, mapped)) THEN
        RETURN CAST([ownershipOperandFact__owned_binding(mapped, ti, source, target_alloc)] AS []OwnershipOperandFact);
      END
    END
    IF !(require_visible_owned) THEN
      RETURN CAST(List[] AS []OwnershipOperandFact);
    END
    RETURN CAST([ownershipOperandFact__borrowed_access(mIRLowering__ownership_root_name(&self, ast_value), ti, "${source} missing owned binding", target_alloc)] AS []OwnershipOperandFact);
END
FN mIRLowering__visible_owned_operand_value?(MUTABLE self: MIRLowering, ast_value_input: Locatable, value_mir: Emittable, mapped: String) RETURNS !Bool ->
    MUTABLE ast_value = COPY ast_value_input;
    IF ast_value IS_A MoveNode AS move_node THEN
      ast_value = CAST(move_node.value AS Locatable);
    END
    RETURN !(!(((((IF ast_value IS_A Identifier AS identifier THEN value_mir IS_A Ident ELSE FALSE END) AND (CAST(emittable__name(value_mir) AS String) == mapped)) AND !(TRY (mIRLowering__borrowed_ownership_ast?(&self, ast_value)))))));
END
FN mIRLowering__retarget_ownership_operands(MUTABLE self: MIRLowering, operands: []OwnershipOperandFact, target_alloc: ?String@symbol) RETURNS ![]OwnershipOperandFact ->
    RETURN operands |> SELECT {
    MUTABLE alloc: ?String@symbol = (IF target_alloc != NIL THEN target_alloc ELSE _.target_alloc END);
    (  IF _.borrowed THEN
        ownershipOperandFact__borrowed_access(_.name, _.type_info, _.source, alloc)
      ELSE_IF _.name THEN
        ownershipOperandFact__owned_binding(UNWRAP (_.name), _.type_info, _.source, alloc)
      ELSE_IF (_.kind == :owned_result) THEN
        ownershipOperandFact__owned_result(_.type_info, _.source, alloc)
      ELSE
        ownershipOperandFact__non_owning(_.type_info, _.source)
      END)
    };
END
FN mIRLowering__non_consuming_owned_value_expr?(MUTABLE self: MIRLowering, value_mir: Emittable) RETURNS Bool ->
    MUTABLE source: Emittable = COPY value_mir;
    WHILE source IS_A MIRCast DO
      source = UNWRAP (emittable__expr(source));
    END
    RETURN ((((((source IS_A Lit OR source IS_A StructInit) OR source IS_A ArrayInit) OR source IS_A DeepCopy) OR source IS_A RcRetain) OR source IS_A RcDowngrade) OR source IS_A WeakUpgrade);
END
FN mIRLowering__rodata_ownership_ast?(MUTABLE self: MIRLowering, node: Locatable) RETURNS Bool ->
    MUTABLE ast_node: Locatable = COPY node;
    IF node IS_A MoveNode THEN
      ast_node = UNWRAP (aST__node_value(node));
    END
    IF (ast_node IS_A Literal AND (locatable__type(ast_node) == :STRING)) THEN
      RETURN TRUE;
    END
    RETURN aST__node_rodata_provenance?(ast_node);
END
FN mIRLowering__owned_binding_visible?(MUTABLE self: MIRLowering, name: String) RETURNS !Bool ->
    IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_83 = (((TRY (functionState__bindings(mIRLowering__function_state(&self))))[name] OR_ELSE cleanupEntry__none()));
    cleanupEntry__present?(rtoc_local_receiver_83) } THEN
      RETURN TRUE;
    END
    IF mIRLowering__function_state(&self).pending_stmts |> ANY ((IF _ IS_A AllocMark AS alloc_mark THEN (alloc_mark.name == name) ELSE FALSE END)) THEN
      RETURN TRUE;
    END
    IF mIRLowering__capture_state(&self).current_fsm_inherited_alloc_names.contains?(name) THEN
      RETURN TRUE;
    END
    RETURN mIRLowering__function_state(&self).lowered_alloc_names.contains?(name);
END
FN mIRLowering__materialized_owned_binding_visible?(MUTABLE self: MIRLowering, name: String) RETURNS Bool ->
    IF mIRLowering__function_state(&self).pending_stmts |> ANY ((IF _ IS_A AllocMark AS alloc_mark THEN (alloc_mark.name == name) ELSE FALSE END)) THEN
      RETURN TRUE;
    END
    IF mIRLowering__capture_state(&self).current_fsm_inherited_alloc_names.contains?(name) THEN
      RETURN TRUE;
    END
    RETURN mIRLowering__function_state(&self).lowered_alloc_names.contains?(name);
END
FN mIRLowering__borrowed_ownership_ast?(MUTABLE self: MIRLowering, node: ?Locatable) RETURNS !Bool ->
    IF node EXISTS AS node_value THEN
      MUTABLE node_value_mutable = COPY node_value;
      IF TRY (mIRLowering__owner_transfer_node?(&self, node_value_mutable)) THEN
        RETURN FALSE;
      END
      RETURN aST__borrowed_ownership_view?(node_value_mutable);
    ELSE
      RETURN FALSE;
    END
END
FN mIRLowering__ownership_root_name(MUTABLE self: MIRLowering, node: ?Locatable) RETURNS ?String ->
    MUTABLE current: ?Locatable = COPY node;
    IF ((((current != NIL) AND (current IS_A MoveNode)) OR ((current != NIL) AND (current IS_A CopyNode))) OR ((current != NIL) AND (current IS_A KeepNode))) THEN
      current = aST__node_value( UNWRAP (current));
    END
    WHILE (((current != NIL) AND (current IS_A GetField)) OR ((current != NIL) AND (current IS_A GetIndex))) DO
      current = aST__node_target(UNWRAP (current));
    END
    IF current? IS_A Identifier AS identifier THEN
      RETURN COPY identifier__name(identifier);
    END
    RETURN NIL;
END
FN mIRLowering__ownership_scanner(MUTABLE self: MIRLowering) RETURNS !MIRLoweringOwnershipScanner ->
    RETURN MIRLoweringOwnershipScanner{ schema_lookup: COPY mIRLowering__mir_schema_lookup(&self), bindings: TRY (functionState__bindings(mIRLowering__function_state(&self))), capture_map: COPY (mIRLowering__capture_state(&self).do_capture_map OR_ELSE {}), rename_map: COPY TRY (functionState__rename_map(mIRLowering__function_state(&self))), safe_name: %(name) USE(MUTABLE self) -> mIRLowering__zig_safe_name(self, name) };
END
FN mIRLowering__collect_bg_capture_transfer_roots(MUTABLE self: MIRLowering, stmt: ?Locatable) RETURNS ![]String
  EFFECTS REENTRANT ->
    IF !((stmt != NIL)) THEN
      RETURN CAST(List[] AS []String);
    END
    RETURN TRY (mIRLoweringOwnershipScanner__collect_bg_capture_transfer_roots(TRY (mIRLowering__ownership_scanner(&self)), stmt));
END
FN mIRLowering__collect_explicit_move_roots(MUTABLE self: MIRLowering, node: ?Locatable) RETURNS ![]String
  EFFECTS REENTRANT ->
    IF !((node != NIL)) THEN
      RETURN CAST(List[] AS []String);
    END
    RETURN TRY (mIRLoweringOwnershipScanner__collect_explicit_move_roots(TRY (mIRLowering__ownership_scanner(&self)), node));
END
FN mIRLowering__bg_stream_boundary_stmt?(MUTABLE self: MIRLowering, stmt: ?Locatable) RETURNS !Bool ->
    MUTABLE found: Bool = FALSE;
    aST__each_bg_block_in_stmt( UNWRAP (stmt), %(bg_value: BgNode) -> {
    IF bg_value IS_A BgStreamBlock AS bg_stream_block THEN
        found = TRUE;
    END
    rubyToClearVoid__mir_lowering()
    });
    RETURN found;
END
FN mIRLowering__collect_stdlib_consumed_roots(MUTABLE self: MIRLowering, MUTABLE stmt: ?Locatable) RETURNS ![]String ->
    MUTABLE names: []String = List[];
    mIRLowering__walk_ast_calls(self, stmt, %(call: Locatable) USE(MUTABLE names, MUTABLE self) -> {
    FOR _ IN (TRY (mIRLowering__stdlib_call_ownership_facts(&self, call))).consumed_names DO
    &names.append(COPY _);
    END
    rubyToClearVoid__mir_lowering()
    });
    RETURN dedupeStrings(names);
END
FN mIRLowering__walk_ast_calls(self: MIRLowering, node: ?Locatable, blk: FN(Locatable) -> Void) RETURNS Void
  EFFECTS REENTRANT ->
    IF !((node != NIL)) THEN
      RETURN;
    END
    IF aST__call?(node) THEN
      blk( node);
    END
    aST__each_child_node(node, %(MUTABLE child: Locatable) USE(blk, self) -> {
    mIRLowering__walk_ast_calls(self, child, blk);
    rubyToClearVoid__mir_lowering()
    });
END
FN mIRLowering__collect_moved_arg_roots(MUTABLE self: MIRLowering, stmt: ?Locatable) RETURNS ![]String
  EFFECTS REENTRANT ->
    IF !((stmt != NIL)) THEN
      RETURN CAST(List[] AS []String);
    END
    RETURN TRY (mIRLoweringOwnershipScanner__collect_moved_arg_roots(TRY (mIRLowering__ownership_scanner(&self)), stmt));
END
FN mIRLowering__ownership_tracked_transfer_type?(MUTABLE self: MIRLowering, ti: Type) RETURNS !Bool ->
    IF (((type__primitive?(ti) OR type__void?(ti)) OR type__any?(ti)) OR type__id_handle?(ti)) THEN
      RETURN FALSE;
    END
    MUTABLE rtoc_recv_3634 = mIRLowering__lifecycle_registry(&self);
    RETURN lifecyclePlan__needs_drop?((TRY (lifecycleRegistry__fetch(rtoc_recv_3634, ti))));
END
FN mIRLowering__walk_ast_for_moved_args(MUTABLE self: MIRLowering, node: Locatable, blk: FN(Locatable) -> Void) RETURNS !Void
  EFFECTS REENTRANT ->
    mIRLoweringOwnershipScanner__walk_ast_for_moved_args(TRY (mIRLowering__ownership_scanner(&self)), node, blk);
END
FN mIRLowering__moved_arg_root(MUTABLE self: MIRLowering, arg: Locatable) RETURNS !?String
  EFFECTS REENTRANT ->
    RETURN mIRLoweringOwnershipScanner__moved_arg_root(TRY (mIRLowering__ownership_scanner(&self)), arg);
END
FN mIRLowering__transfer_binding_name(MUTABLE self: MIRLowering, name: String) RETURNS !String
  EFFECTS REENTRANT ->
    RETURN mIRLoweringOwnershipScanner__transfer_binding_name(TRY (mIRLowering__ownership_scanner(&self)), name);
END
FN mIRLowering__stdlib_call_ownership_facts(MUTABLE self: MIRLowering, call: Locatable) RETURNS !CallOwnershipFacts ->
    RETURN COPY (TRY (mIRLowering__stdlib_call_facts(&self, castLocatableToNode__mir_lowering(call)))).ownership;
END
FN mIRLowering__ownership_bearing_type?(MUTABLE self: MIRLowering, type_info: Type) RETURNS !Bool ->
    RETURN TRY (type__ownership_bearing?(type_info, mIRLowering__mir_schema_lookup(&self)));
END
FN mIRLowering__consumed_binding_root(self: MIRLowering, arg: ?Locatable) RETURNS ?String ->
    IF (((arg != NIL) AND (arg IS_A CopyNode)) OR ((arg != NIL) AND (arg IS_A KeepNode))) THEN
      RETURN NIL;
    END
    IF arg == NIL THEN
      RETURN NIL;
    END
    MUTABLE node: Locatable = COPY arg;
    IF arg IS_A MoveNode THEN
      node = UNWRAP (aST__node_value(arg));
    END
    IF node IS_A Identifier THEN
      RETURN COPY CAST(locatable__name(node) AS String);
    END
    MUTABLE root: ?Identifier = (aST__root_identifier(node));
    IF root EXISTS AS root_identifier THEN
      RETURN COPY root_identifier.name;
    ELSE
    RETURN NIL;
    END
END
FN mIRLowering__discard_owned_zig_type(self: MIRLowering, node: Locatable, entry: CleanupEntry) RETURNS !String ->
    IF entry.zig_type EXISTS AS rtoc_zig_type THEN
      RETURN COPY rtoc_zig_type;
    END
    MUTABLE ti: ?Type = TRY (type__from_node_mut(node, "discard owned type"));
    ti = TRY (type__success_type( UNWRAP (ti)));
    IF TRY (type__string?( UNWRAP (ti))) THEN
      RETURN COPY "[]const u8";
    END
    RETURN TRY (type__zig_type( UNWRAP (ti)));
END
FN mIRLowering__stamp_source_line_mut(MUTABLE self: MIRLowering, MUTABLE node: Emittable, line: ?Int64, column: ?Int64 = NIL) RETURNS Void ->
    IF line EXISTS AS line_value THEN
      emittable__set_source_line_mut(&node, (emittable__source_line(node) OR_ELSE line_value));
      IF column EXISTS AS column_value THEN
        emittable__set_source_column_mut(&node, (emittable__source_column(node) OR_ELSE column_value));
      END
    ELSE
      RETURN;
    END
END
FN mIRLowering__noreturn_result_expr?(MUTABLE self: MIRLowering, node: ?MIRLoweringLowerableStmt) RETURNS Bool ->
    IF node EXISTS AS rtoc_node THEN
      IF castMIRLoweringLowerableStmtToLocatable(rtoc_node) EXISTS AS rtoc_locatable THEN
        RETURN (locatable__resolved_type(rtoc_locatable) == :NoReturn);
      END
    END
    RETURN FALSE;
END
FN mIRLowering__lower_body_with_break(MUTABLE self: MIRLowering, stmts: []MIRLoweringLowerableStmt, label: String) RETURNS ![]Emittable ->
    IF (stmts.length() == 0) THEN
      RETURN CAST(List[] AS []Emittable);
    END
    # Ruby scans with `rindex { }`; CLEAR lists have no rindex, so the scan
    # runs back to front by index.
    MUTABLE last_user_idx: ?Int64 = NIL;
    MUTABLE scan_idx: Int64 = (stmts.length() - 1);
    WHILE scan_idx >= 0 DO
      MUTABLE s: MIRLoweringLowerableStmt = UNWRAP (stmts[scan_idx]);
      IF (((((!(s IS_A Drop) AND !(s IS_A AllocMark)) AND !(s IS_A Return)) AND !(s IS_A SuppressCleanup)) AND !(s IS_A ReassignCleanup)) AND !(s IS_A FieldCleanup)) THEN
        IF last_user_idx == NIL THEN
          last_user_idx = scan_idx;
        END
      END
      scan_idx = scan_idx - 1;
    END
    IF last_user_idx == NIL THEN
      RETURN TRY (mIRLowering__lower_body(&self, stmts));
    END
    MUTABLE break_idx: Int64 = last_user_idx;
    MUTABLE prefix_stmts: []MIRLoweringLowerableStmt = List[];
    MUTABLE prefix_idx: Int64 = 0;
    WHILE prefix_idx < break_idx DO
      &prefix_stmts.append(COPY UNWRAP (stmts[prefix_idx]));
      prefix_idx = prefix_idx + 1;
    END
    MUTABLE prefix_lowered = TRY (mIRLowering__lower_body(&self, prefix_stmts));
    MUTABLE result_stmt = COPY UNWRAP (stmts[break_idx]);
    MUTABLE result_mir, pending = mIRLowering__lower_head(&self, %() USE(MUTABLE result_stmt, MUTABLE self) -> {
    MUTABLE rtoc_lambda_result_91: ?Emittable = TRY (mIRLowering__lower(&self, &result_stmt));
    rtoc_lambda_result_91
    });
    MUTABLE suffix_lowered = TRY (mIRLowering__lower_body(&self, stmts |> SKIP (break_idx + 1)));
    MUTABLE terminator_branch_value: ?BreakStmt = NIL;
    IF mIRLowering__noreturn_result_expr?(&self, result_stmt) THEN
      terminator_branch_value = castEmittableToBreakStmt__mir_lowering(CAST(result_mir AS Emittable));
    ELSE
      terminator_branch_value = BreakStmt{ label: COPY label, value: COPY CAST(result_mir AS Emittable), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    END
    MUTABLE terminator: BreakStmt = terminator_branch_value?;
    MUTABLE tail = ((pending + suffix_lowered) + [terminator]);
    RETURN (prefix_lowered + TRY (mIRLowering__normalize_allocating_mir_body(&self, tail)));
END
FN mIRLowering__lower_program(MUTABLE self: MIRLowering, MUTABLE node: Program, use_c_allocator: Bool = FALSE, needs_safety_input: Bool = FALSE, use_debug_allocator: Bool = FALSE) RETURNS !?MIRProgram
  EFFECTS REENTRANT ->
    MUTABLE needs_safety = COPY needs_safety_input;
    TRY (mIRPassState__class_require_mut(PassStateProgram{ Program: COPY node }, :mir_pass_complete, "MIRLowering"));
    mIRLowering__reset_unit_import_dedup_mut(&self);
    self.state.program.use_debug_allocator = COPY use_debug_allocator;
    MUTABLE rtoc_writer_receiver_93: MIRLoweringProgramState = mIRLowering__program_state(self);
    rtoc_writer_receiver_93.fn_nodes = node.statements |> REDUCE({}) {
    IF _ IS_A FunctionDef AS function_def THEN
        MUTABLE function_def_mutable = COPY function_def;
        acc[CAST(function_def_mutable.name AS String)] = COPY function_def_mutable;
    END
    acc
    };
    MUTABLE items: []Emittable = List[];
    needs_safety = (needs_safety OR (node.statements |> ANY (IF _ IS_A FunctionDef AS function_def THEN functionDef__reentrance_guard_required?(function_def) ELSE FALSE END)));
    &items.append(Emittable{ Import: COPY Import{ alias_name: "std", module_path: "std", member: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    &items.append(Emittable{ Import: COPY Import{ alias_name: "CheatHeader", module_path: "runtime/runtime-header.zig", member: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    &items.append(Emittable{ TypeAlias: COPY TypeAlias{ name: "CheatLib", target: "CheatHeader.CheatLib", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    &items.append(Emittable{ TypeAlias: COPY TypeAlias{ name: "Runtime", target: "CheatHeader.Runtime", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    &items.append(Emittable{ TypeAlias: COPY TypeAlias{ name: "EbrContext", target: "CheatHeader.EbrContext", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    IF needs_safety THEN
      &items.append(Emittable{ Import: COPY Import{ alias_name: "safety", module_path: "runtime/../lib/safety.zig", member: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    END
    items = ruby_array_concat_Any__mir_lowering(items, CAST(TRY (mIRLowering__lower_protocol_adapters(self, node)) AS []Any));
    IF (use_c_allocator OR mIRLowering__program_state(self).used_sharded_map) THEN
      &items.append(PubConst{ name: "USE_C_ALLOCATOR", value: "true", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
    END
    IF mIRLowering__program_state(self).use_debug_allocator EXISTS AS use_debug_allocator_value THEN
      &items.append(PubConst{ name: "USE_DEBUG_ALLOCATOR", value: "true", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
    END
    FOR _ IN node.statements DO
    IF _ IS_A FunctionDef AS function_def THEN
        MUTABLE function_def_mutable = COPY function_def;
        MUTABLE seed: ?MIRLoweringCounterSnapshot = COPY mIRLowering__lowering_input(self).function_counter_seeds[function_def_mutable.name];
        IF seed EXISTS AS seed_value THEN
          MUTABLE seed_value_mutable = COPY seed_value;
          MUTABLE rtoc_mutable_receiver_94 = mIRLowering__lowering_counters(&self);
          mIRLoweringCounters__restore_mut(&rtoc_mutable_receiver_94, seed_value_mutable);
        END
        MUTABLE rtoc_index_receiver_96 = mIRLowering__program_state(self).function_counter_snapshots;
        rtoc_index_receiver_96[function_def_mutable.name] = COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_95 = mIRLowering__lowering_counters(&self);
        mIRLoweringCounters__snapshot(rtoc_local_receiver_95) };
    END
    MUTABLE lowered: ?MIRLoweringLoweredMir = TRY (mIRLowering__lower_top_level(&self, _));
    TRY (mIRLowering__reject_module_scope_cleanup_mut(&self, _, UNWRAP (lowered)));
    MUTABLE item_line: ?Int64 = NIL;
    IF locatable__token(_) EXISTS AS item_token THEN
      item_line = item_token.line;
    END
    mIRLowering__append_lowered_items_mut(&self, LoweredItemTarget{ items: CAST(COPY items AS []Emittable), line: item_line }, UNWRAP (lowered));
    END
    MUTABLE const_items: []Emittable = CAST(COPY items AS []Emittable);
    TRY (mIRLowering__inject_const_init_mut(&self, &const_items));
    items = CAST(COPY const_items AS []Emittable);
    MUTABLE state = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_97 = mIRPassState__for_mut(PassStateProgram{ Program: COPY node });
    mIRPassState__copy(rtoc_local_receiver_97) };
    TRY (mIRPassState__mark_mut(&state, :mir_lowered));
    RETURN MIRProgram{ items: COPY items, pass_state: KEEP state };
END
FN mIRLowering__inject_const_init_mut(MUTABLE self: MIRLowering, MUTABLE items: []Emittable, module_scope: Bool = FALSE) RETURNS !Void ->
    MUTABLE entries = COPY mIRLowering__program_state(self).runtime_init_consts;
    MUTABLE module_inits = mIRLowering__program_state(self).module_const_inits |> SELECT COPY _;
    IF ((entries.length() == 0) AND module_inits.empty?()) THEN
      RETURN;
    END
    MUTABLE raw: []Emittable = List[];
    IF module_scope THEN
      &items.append(Emittable{ Let: COPY Let{ name: COPY "__clear_consts_ready", init: Emittable{ Lit: COPY Lit{ value: "false", lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :Bool })), suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
      &raw.append(Emittable{ IfStmt: COPY IfStmt{ cond: Emittable{ Ident: COPY Ident{ name: "__clear_consts_ready", lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: [Emittable{ ReturnStmt: COPY ReturnStmt{ value: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL } });
      &raw.append(Emittable{ Set: COPY Set{ target: Emittable{ Ident: COPY Ident{ name: "__clear_consts_ready", lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Lit: COPY Lit{ value: "true", lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    END
    FOR _ IN module_inits DO
    &raw.append(Emittable{ Call: COPY Call{ callee: "${_}.${"__clear_init_consts"}", args: [Emittable{ Ident: COPY Ident{ name: "rt", lowered_node_id: NIL, ownership_consumption: NIL } }], try_wrap: TRUE, owned_return: FALSE, callable_contract: TRY (callableContract__no_ownership(1)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL } });
    END
    FOR _ IN entries DO
    MUTABLE tmp = "__ci_${_.name}";
    raw = ruby_array_concat_Emittable__mir_lowering(raw, _.prelude);
    &raw.append(Emittable{ AllocMark: COPY AllocMark{ name: COPY tmp, alloc: :heap, type_info: UNWRAP (COPY _.type_info), scope: :heap, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    &raw.append(Emittable{ Let: COPY Let{ name: COPY tmp, init: COPY _.init, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
    &raw.append(Emittable{ Set: COPY Set{ target: Emittable{ Ident: COPY Ident{ name: COPY _.name, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Ident: COPY Ident{ name: COPY tmp, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    raw = ruby_array_concat_Emittable__mir_lowering(raw, CAST(TRY (mIRLowering__ownership_transfer_marks(&self, tmp, :owned_sink, :heap)) AS []Emittable));
    END
    MUTABLE body = TRY (mIRLowering__finalize_synthetic_const_init_body_mut(&self, raw));
    &items.append(Emittable{ FnDef: COPY FnDef{ name: "__clear_init_consts", params: [MIRParam{ name: "rt", zig_type: "*Runtime", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL }], ret_type: "void", body: body, visibility: IF module_scope THEN
      :pub
    ELSE
      :private
    END, can_fail: TRUE, comptime_params: List[], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    # `items` owns the FnDef by value, so the prologue has to be written BACK
    # into the slot: mutating a FIND result would update a copy.
    MUTABLE main_idx = 0;
    WHILE main_idx < items.length() DO
      PARTIAL MATCH (items[main_idx])? START
        Emittable.FnDef AS MUTABLE fn_def ->
        IF ((CAST(fn_def.name AS String) == entrypointZigName()) OR (CAST(fn_def.name AS String) == entrypointName())) THEN
          MUTABLE prologue: []Emittable = [Emittable{ Call: COPY Call{ callee: COPY "__clear_init_consts", args: [Emittable{ Ident: COPY Ident{ name: "rt", lowered_node_id: NIL, ownership_consumption: NIL } }], try_wrap: TRUE, owned_return: FALSE, callable_contract: TRY (callableContract__no_ownership(1)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL } }];
          FOR _ IN entries DO
            &prologue.append(Emittable{ ModuleConstFree: COPY ModuleConstFree{ name: COPY _.name, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
          END
          fn_def.body = (prologue + fn_def.body);
          items[main_idx] = Emittable{ FnDef: COPY fn_def };
          BREAK;
        END
    END
      main_idx = main_idx + 1;
    END
END
FN mIRLowering__finalize_synthetic_const_init_body_mut(MUTABLE self: MIRLowering, nodes: []Emittable) RETURNS ![]Emittable ->
    MUTABLE state = mIRLowering__initial_ownership_finalization_context(&self);
    mIRLowering__seed_cleanup_owner_index_mut(&self, &state, nodes);
    FOR MUTABLE rtoc_for_item_3898 IN nodes DO
    TRY (mIRLowering__finalize_ownership_for_mir_node_mut(&self, &rtoc_for_item_3898, nodes, &state));
    END
    RETURN COPY state.out;
END
FN mIRLowering__reject_module_scope_cleanup_mut(MUTABLE self: MIRLowering, stmt: Locatable, lowered: ?MIRLoweringLoweredMir) RETURNS !Void ->
    IF !((stmt IS_A VarDecl OR stmt IS_A BindExpr)) THEN
      RETURN;
    END
    # Ruby's `[lowered].flatten.compact` over a node-or-array; here the union
    # says which it is.
    MUTABLE nodes: []Emittable = List[];
    IF lowered EXISTS AS lowered_value THEN
      IF lowered_value IS_A MIRLoweringLoweredMir.Emittable AS single THEN
        &nodes.append(COPY single);
      END
      IF lowered_value IS_A MIRLoweringLoweredMir.ArrayValue AS many THEN
        FOR item IN many DO
          &nodes.append(COPY item);
        END
      END
    END
    IF !(nodes |> ANY (_ IS_A Cleanup OR _ IS_A ErrCleanup)) THEN
      RETURN;
    END
    MUTABLE name: String = COPY "value";
    IF locatable__name(stmt) EXISTS AS stmt_name THEN
      name = COPY stmt_name;
    END
    RAISE Input, CompilerError, "{}but CLEAR has no module initialization/termination lifetime. Use a fixed-size comptime value, or construct it inside a function.";
END
FN mIRLowering__reset_unit_import_dedup_mut(MUTABLE self: MIRLowering) RETURNS Void ->
    MUTABLE stale_require_modules: []String = [];
    FOR require_key IN mIRLowering__program_state(self).emitted_require_modules DO
      IF require_key.startsWith?("pkg-import:") THEN
        &stale_require_modules.append(COPY require_key);
      END
    END
    FOR stale_key IN stale_require_modules DO
      &self.state.program.emitted_require_modules.remove(stale_key);
    END
    &self.state.program.emitted_import_type_aliases.clear();
END
FN mIRLowering__append_lowered_items_mut(MUTABLE self: MIRLowering, MUTABLE target: LoweredItemTarget, lowered: ?MIRLoweringLoweredMir) RETURNS Void ->
    IF lowered EXISTS AS lowered_value THEN
      MUTABLE nodes = loweredMir__nodes(lowered_value);
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < nodes.length() DO
      IF (rtoc_idx.zero?() AND (target.line != NIL)) THEN
            &target.items.append(Emittable{ Comment: COPY Comment{ text: "CLR:${(target.line OR_ELSE 0).toString()}", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
      END
      &target.items.append(COPY nodes[rtoc_idx]);
    rtoc_idx = rtoc_idx + 1;
      END
      NIL;
    ELSE
      RETURN;
    END
END
FN mIRLowering__lower_protocol_adapters(self: MIRLowering, program: Program) RETURNS ![]ProtocolAdapterDef ->
    MUTABLE protocols: []ProtocolDef = List[];
    MUTABLE conformances: {String}[]ConformanceDef = {};
    FOR rtoc_stmt IN program.statements DO
      IF rtoc_stmt IS_A ProtocolDef AS rtoc_protocol THEN
        &protocols.append(COPY rtoc_protocol);
      ELSE_IF rtoc_stmt IS_A ConformanceDef AS rtoc_conformance THEN
        MUTABLE rtoc_base = mIRLowering__protocol_base_name_for_lowering(self, rtoc_conformance.protocol_type);
        MUTABLE rtoc_bucket: []ConformanceDef = (COPY conformances[rtoc_base] OR_ELSE List[]);
        &rtoc_bucket.append(COPY rtoc_conformance);
        conformances[COPY rtoc_base] = rtoc_bucket;
      END
    END
    MUTABLE adapters: []ProtocolAdapterDef = List[];
    FOR rtoc_protocol IN protocols DO
      MUTABLE cases: []ProtocolConformanceCase = List[];
      FOR rtoc_declaration IN (COPY conformances[rtoc_protocol.name] OR_ELSE List[]) DO
        &cases.append(TRY (mIRLowering__lower_protocol_conformance_case(self, rtoc_protocol, rtoc_declaration)));
      END
      MUTABLE requirements: []ProtocolRequirementAdapter = List[];
      FOR rtoc_requirement IN rtoc_protocol.requirements DO
        &requirements.append(ProtocolRequirementAdapter{ name: COPY rtoc_requirement.name, argument_count: rtoc_requirement.params.length(), return_type: COPY TRY (mIRLowering__protocol_requirement_return_type(self, rtoc_protocol, rtoc_requirement)) });
      END
      MUTABLE associated: []String = List[];
      FOR rtoc_assoc IN rtoc_protocol.associated_types DO
        &associated.append(COPY rtoc_assoc.name);
      END
      &adapters.append(ProtocolAdapterDef{ protocol: COPY rtoc_protocol.name, associated_types: associated, requirements: requirements, conformances: cases, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
    END
    RETURN adapters;
END
FN mIRLowering__lower_protocol_conformance_case(self: MIRLowering, protocol: ProtocolDef, declaration: ConformanceDef) RETURNS !ProtocolConformanceCase ->
    MUTABLE generic = (declaration.binders.length() > 0);
    MUTABLE associated = {
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE rtoc_indexed_items_103: []GenericParamDecl = protocol.associated_types;
    MUTABLE rtoc_indexed_output_105 = {};
    MUTABLE rtoc_indexed_i_104 = 0;
    WHILE rtoc_indexed_i_104 < rtoc_indexed_items_103.length() DO
      MUTABLE binding = COPY UNWRAP ((TRY (type__generic_args(declaration.protocol_type)))[rtoc_indexed_i_104]);
      rtoc_indexed_output_105[COPY UNWRAP (rtoc_indexed_items_103[rtoc_indexed_i_104]).name] = TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY binding }));
      rtoc_indexed_i_104 = rtoc_indexed_i_104 + 1;
    END
    rtoc_indexed_output_105
    };
    # Ruby's `members.to_h { |m| [k, v] }`; CLEAR builds the map by walking.
    MUTABLE operations: {String}String = {};
    FOR member IN declaration.members DO
      operations[COPY CAST(member.source_name AS String)] = mIRLowering__zig_safe_name(self, member.name);
    END
    MUTABLE owner_name = mIRLowering__protocol_base_name_for_lowering(self, declaration.owner_type);
    RETURN ProtocolConformanceCase{ owner_type: COPY IF generic THEN
      NIL
    ELSE
      TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY declaration.owner_type }))
    END, owner_marker: IF generic THEN
      "__clear_nominal_${mIRLowering__zig_safe_name(self, owner_name)}"
    ELSE
      NIL
    END, type_params: COPY declaration.binders |> SELECT _.name, associated_types: COPY associated, operations: COPY operations };
END
FN mIRLowering__protocol_requirement_return_type(self: MIRLowering, protocol: ProtocolDef, requirement: ProtocolRequirement) RETURNS !String ->
    MUTABLE replacements: {String@symbol}TypeExpression = {};
    FOR _ IN protocol.associated_types DO
    replacements[symbol(_.name)] = typeExpression__of( TypeExpressionKind{ TypeProjectionExpression: COPY TypeProjectionExpression{ owner: :T, member: COPY symbol(_.name), protocol: COPY symbol(protocol.name) } });
    END
    replacements[:Self] = typeExpression__of( TypeExpressionKind{ NamedTypeExpression: COPY NamedTypeExpression{ name: :T, arguments: List[] } });
    MUTABLE expression = typeExpressionTree__transform(requirement.return_type.shape.expression, %(candidate: TypeExpression) USE(replacements) -> {
    MUTABLE candidate_kind = candidate.kind;
    IF candidate_kind IS_A NamedTypeExpression AS named_kind THEN
      IF (named_kind.arguments.empty?() AND replacements.contains?(named_kind.name)) THEN
        RETURN UNWRAP (replacements[named_kind.name]);
      END
    END
    RETURN candidate;
    NIL
    });
    MUTABLE result = TRY (type__new(TypeConstructionInput{ TypeExpression: COPY expression }));
    IF type__error_union?(result) THEN
      MUTABLE payload = TRY (type__success_type(result));
      RETURN "anyerror!${TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY payload }))}";
    END
    RETURN TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY result }));
END
FN mIRLowering__protocol_base_name_for_lowering(self: MIRLowering, type: Type) RETURNS String ->
    RETURN COPY CAST((IF type__generic_instance?(type) THEN
      type__generic_base(type)
    ELSE
      type__resolved(type)
    END) AS String);
END
FN mIRLowering__lower_module(MUTABLE self: MIRLowering, node: Program) RETURNS !LoweredModuleItems ->
    TRY (mIRPassState__class_require_mut(PassStateProgram{ Program: COPY node }, :mir_pass_complete, "MIRLowering.lower_module"));
    mIRLowering__reset_unit_import_dedup_mut(&self);
    MUTABLE type_items: []Emittable = List[];
    MUTABLE fn_items: []Emittable = List[];
    FOR _ IN node.statements DO
    IF _ IS_A FunctionDef AS function_def THEN
      MUTABLE function_def_mutable = COPY function_def;
      mIRLowering__append_lowered_items_mut(&self, LoweredItemTarget{ items: COPY fn_items, line: function_def_mutable.token.line }, UNWRAP (TRY (mIRLowering__lower_top_level(&self, Locatable{ FunctionDef: COPY function_def_mutable }))));
    ELSE_IF (_ IS_A StructDef) OR (_ IS_A EnumDef) OR (_ IS_A UnionDef) THEN
      mIRLowering__append_lowered_items_mut(&self, LoweredItemTarget{ items: COPY type_items, line: UNWRAP (locatable__token(_)).line }, UNWRAP (TRY (mIRLowering__lower_top_level(&self, _))));
    ELSE_IF _ IS_A RequireNode AS require_node THEN
      MUTABLE require_node_mutable = COPY require_node;
      mIRLowering__append_lowered_items_mut(&self, LoweredItemTarget{ items: COPY fn_items, line: NIL }, UNWRAP (TRY (mIRLowering__lower_top_level(&self, Locatable{ RequireNode: COPY require_node_mutable }))));
    ELSE_IF _ IS_A ExternFnDecl AS extern_fn_decl THEN
      MUTABLE extern_fn_decl_mutable = COPY extern_fn_decl;
      mIRLowering__append_lowered_items_mut(&self, LoweredItemTarget{ items: COPY fn_items, line: extern_fn_decl_mutable.token.line }, UNWRAP (TRY (mIRLowering__lower_top_level(&self, Locatable{ ExternFnDecl: COPY extern_fn_decl_mutable }))));
    ELSE_IF _ IS_A ExternStructDecl AS extern_struct_decl THEN
      MUTABLE extern_struct_decl_mutable = COPY extern_struct_decl;
      mIRLowering__append_lowered_items_mut(&self, LoweredItemTarget{ items: COPY fn_items, line: extern_struct_decl_mutable.token.line }, UNWRAP (TRY (mIRLowering__lower_top_level(&self, Locatable{ ExternStructDecl: COPY extern_struct_decl_mutable }))));
    ELSE_IF _ IS_A VarDecl AS var_decl THEN
      MUTABLE var_decl_mutable = COPY var_decl;
      MUTABLE lowered: ?MIRLoweringLoweredMir = TRY (mIRLowering__lower_top_level(&self, Locatable{ VarDecl: COPY var_decl_mutable }));
      TRY (mIRLowering__reject_module_scope_cleanup_mut(&self, Locatable{ VarDecl: COPY var_decl_mutable }, UNWRAP (lowered)));
      mIRLowering__append_lowered_items_mut(&self, LoweredItemTarget{ items: COPY fn_items, line: varDecl__token(var_decl_mutable).line }, UNWRAP (lowered));
    ELSE_IF _ IS_A BindExpr AS bind_expr THEN
      MUTABLE bind_expr_mutable = COPY bind_expr;
      MUTABLE lowered: ?MIRLoweringLoweredMir = TRY (mIRLowering__lower_top_level(&self, Locatable{ BindExpr: COPY bind_expr_mutable }));
      TRY (mIRLowering__reject_module_scope_cleanup_mut(&self, Locatable{ BindExpr: COPY bind_expr_mutable }, UNWRAP (lowered)));
      mIRLowering__append_lowered_items_mut(&self, LoweredItemTarget{ items: COPY fn_items, line: bind_expr_mutable.token.line }, UNWRAP (lowered));
    END
    END
    TRY (mIRLowering__inject_const_init_mut(&self, &fn_items, TRUE));
    RETURN LoweredModuleItems{ items: COPY fn_items, type_items: COPY type_items };
END
PRIVATE FN mIRLowering__lower_top_level(MUTABLE self: MIRLowering, stmt: Locatable) RETURNS !?MIRLoweringLoweredMir
  EFFECTS REENTRANT ->
    self.state.function_state.pending_stmts = List[];
    IF (IF stmt IS_A VarDecl AS var_decl THEN !(varDecl__module_const(var_decl)) ELSE FALSE END) THEN
      &self.state.program.module_global_names.insert(COPY CAST(locatable__name(stmt) AS String));
    END
    MUTABLE lowered: ?Emittable = TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(stmt)));
    # `lower` hands back at most one node; clearing a Let's suppression is a
    # field write through the union.
    IF lowered EXISTS AS MUTABLE lowered_value THEN
      IF lowered_value IS_A Let AS MUTABLE lowered_let THEN
        lowered_let.suppression = NIL;
      END
    END
    RETURN lowered;
END
PRIVATE FN mIRLowering__zig_safe_name(self: MIRLowering, name: String) RETURNS String ->
    MUTABLE cleaned: String = "";
    IF name.endsWith?("?") THEN
      cleaned = "${name.substr(0, (((name.length() - 2) - 0) + 1))}${"_p"}";
    ELSE_IF name.endsWith?("!") THEN
      cleaned = "${name.substr(0, (((name.length() - 2) - 0) + 1))}${"_bang"}";
    ELSE
      cleaned = COPY name;
    END
    IF (cleaned == entrypointName()) THEN
      cleaned = entrypointZigName();
    END
    cleaned = COPY cleaned;
    IF zigType__reserved_identifier?(cleaned) THEN
      RETURN "@\"${cleaned}\"";
    ELSE
      RETURN cleaned;
    END
END
PRIVATE FN mIRLowering__node_store_binding_name(self: MIRLowering, zig_type: String, shared_value: Bool = FALSE) RETURNS String ->
    MUTABLE encoded = "";
    MUTABLE char_idx = 0;
    WHILE char_idx < zig_type.length() DO
      MUTABLE ch = zig_type.charAt(char_idx);
      MUTABLE alpha = ((((ch >= "A") AND (ch <= "Z"))) OR (((ch >= "a") AND (ch <= "z"))));
      MUTABLE digit = ((ch >= "0") AND (ch <= "9"));
      IF ((alpha OR digit) OR (ch == "_")) THEN
        encoded = "${encoded}${ch}";
      ELSE
        encoded = "${encoded}_";
      END
      char_idx = char_idx + 1;
    END
    IF shared_value THEN
      RETURN "__shared_node_guard_${encoded}";
    ELSE
      RETURN "__node_store_${encoded}";
    END
END
PRIVATE FN mIRLowering__alloc_for_node(MUTABLE self: MIRLowering, node: Locatable) RETURNS !String@symbol ->
    RETURN TRY (mIRLowering__placement_for_node(&self, node));
END
PRIVATE FN mIRLowering__with_decl_alloc<U>(MUTABLE self: MIRLowering, alloc: ?String@symbol, blk: FN() -> U) RETURNS U
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE prev: ?String@symbol = COPY mIRLowering__function_state(&rtoc_self_view).current_decl_alloc;
  DEFER rtoc_self_view.state.function_state.current_decl_alloc = prev;
  rtoc_self_view.state.function_state.current_decl_alloc = COPY alloc;
  RETURN blk();
}
END
PRIVATE FN mIRLowering__with_reassignment_target<U>(MUTABLE self: MIRLowering, name: String, blk: FN() -> U) RETURNS U
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE previous: ?String = COPY mIRLowering__function_state(&rtoc_self_view).current_reassignment_target;
  DEFER rtoc_self_view.state.function_state.current_reassignment_target = previous;
  rtoc_self_view.state.function_state.current_reassignment_target = COPY name;
  RETURN blk();
}
END
PRIVATE FN mIRLowering__with_expected_type<U>(MUTABLE self: MIRLowering, type_info: ?Type, blk: FN() -> U) RETURNS U
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE prev: ?Type = COPY mIRLowering__function_state(&rtoc_self_view).current_expected_type;
  DEFER rtoc_self_view.state.function_state.current_expected_type = prev;
  rtoc_self_view.state.function_state.current_expected_type = COPY type_info;
  RETURN blk();
}
END
PRIVATE FN mIRLowering__with_sink_type<U>(MUTABLE self: MIRLowering, type_info: ?Type, blk: FN() -> U) RETURNS U
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE prev: ?Type = COPY mIRLowering__function_state(&rtoc_self_view).current_sink_type;
  DEFER rtoc_self_view.state.function_state.current_sink_type = prev;
  rtoc_self_view.state.function_state.current_sink_type = COPY type_info;
  RETURN blk();
}
END
PRIVATE FN mIRLowering__allocator_for_takes_param_mut(MUTABLE self: MIRLowering, callee_param: ?Param) RETURNS !String@symbol ->
    IF callee_param EXISTS AS callee_param_value THEN
      RETURN :heap;
    ELSE
      panic("TAKES argument allocator requested without a callee parameter");
    END
END
PRIVATE FN mIRLowering__call_arg_consumes_ownership?(MUTABLE self: MIRLowering, arg: Locatable, callee_param: ?Param) RETURNS Bool ->
    IF callee_param EXISTS AS param THEN
      RETURN (param.takes == TRUE);
    END
    RETURN FALSE;
END
PRIVATE FN mIRLowering__symbol_storage_for_node(self: MIRLowering, node: ?Locatable) RETURNS ?String@symbol ->
    IF node EXISTS AS node_value THEN
      MUTABLE sym: ?SymbolEntry@multiowned = aST__node__symbol(node_value);
      IF !(sym) THEN
        RETURN NIL;
      END
      MUTABLE auth: SymbolEntry = COPY sym;
      IF sym.reg EXISTS AS decl THEN
        IF aST__node__symbol(castSymbolEntryRegInputToLocatable(decl)) EXISTS AS decl_symbol THEN
          auth = COPY decl_symbol;
        END
      END
      IF symbolEntry__heap_storage?(auth) THEN
        RETURN :heap;
      ELSE
        RETURN :frame;
      END
    ELSE
      RETURN NIL;
    END
END
PRIVATE FN mIRLowering__placement_for_node(MUTABLE self: MIRLowering, node_input: Locatable) RETURNS !String@symbol ->
    MUTABLE node = COPY node_input;
    IF node IS_A MoveNode AS move_node THEN
      node = COPY CAST(move_node.value AS Locatable);
    END
    MUTABLE root: ?Identifier = mIRLowering__root_receiver_node(self, node);
    IF root EXISTS AS root_value THEN
      MUTABLE alias_alloc: ?String@symbol = NIL;
      IF mIRLowering__capability_state(&self).with_alias_alloc_map EXISTS AS alias_alloc_map THEN
        alias_alloc = COPY alias_alloc_map[CAST(root_value.name AS String)];
      END
      IF alias_alloc EXISTS AS alias_alloc_value THEN
        RETURN alias_alloc_value;
      END
      IF mIRLowering__current_function_collection_param?(&self, root_value.name) THEN
        RETURN :heap;
      END
      MUTABLE entry: ?CleanupEntry@multiowned = COPY (TRY (functionState__bindings(mIRLowering__function_state(&self))))[CAST(root_value.name AS String)];
      IF entry EXISTS AS entry_value THEN
        IF !(cleanupEntry__alloc(entry_value).empty?()) THEN
          RETURN symbol(cleanupEntry__alloc(entry_value));
        END
      END
      IF root_value.symbol EXISTS AS sym THEN
        MUTABLE lifetime_sources = TRY (symbolEntry__lifetime_sources(sym));
        IF !((lifetime_sources.length() == 0)) THEN
          IF lifetime_sources |> ANY symbolEntry__heap_storage?(_) THEN
            RETURN :heap;
          END
          RETURN :frame;
        END
      END
    END
    MUTABLE node_storage: ?String@symbol = NIL;
    IF root EXISTS AS storage_root THEN
      node_storage = mIRLowering__symbol_storage_for_node(self, Locatable{ Identifier: COPY storage_root });
    END
    IF node_storage EXISTS AS node_storage_value THEN
      RETURN node_storage_value;
    END
    IF mIRLowering__function_state(&self).current_decl_alloc EXISTS AS decl_alloc THEN
      RETURN decl_alloc;
    END
    RETURN :frame;
END
PRIVATE FN mIRLowering__alloc_expr(self: MIRLowering, kind: String@symbol, ignored_rt_name: ?RtName = NIL) RETURNS String@symbol ->
    RETURN placement__alloc(kind, :frame);
END
PRIVATE FN mIRLowering__alloc_from_sym(self: MIRLowering, sym: String@symbol) RETURNS String@symbol ->
    RETURN placement__alloc(sym, :heap);
END
PRIVATE FN mIRLowering__resolve_alloc_sym(MUTABLE self: MIRLowering, alloc_sym: String@symbol, target_node: ?Locatable = NIL, node: ?Locatable = NIL) RETURNS !String@symbol ->
    IF (alloc_sym == :frame) THEN
      RETURN :frame;
    ELSE_IF (alloc_sym == :receiver_storage) THEN
      MUTABLE receiver: ?Locatable = COPY target_node;
      IF ((node != NIL) AND (node IS_A MethodCall)) THEN
        receiver = (receiver OR_ELSE locatable__object(node));
      END
      IF (IF node? IS_A FuncCall AS func_call THEN (func_call.mutates_receiver != NIL) ELSE FALSE END) THEN
        receiver = (receiver OR_ELSE UNWRAP (locatable__args( UNWRAP (node))).first());
      END
      MUTABLE root: ?Identifier = mIRLowering__root_receiver_node(self, receiver);
      MUTABLE selected: ?Locatable = COPY node;
      IF receiver EXISTS AS receiver_value THEN
        selected = COPY receiver_value;
      END
      IF root EXISTS AS root_value THEN
        selected = Locatable{ Identifier: COPY root_value };
      END
      MUTABLE selected_type: ?Type = TRY (type__from_node_mut(UNWRAP (selected), "allocator receiver"));
      IF TRY (type__node_reference?( UNWRAP (selected_type))) THEN
        RETURN :heap;
      END
      RETURN TRY (mIRLowering__placement_for_node(&self, UNWRAP (selected)));
    ELSE_IF (alloc_sym == :node_storage) THEN
      IF mIRLowering__function_state(&self).current_decl_alloc != NIL THEN
    RETURN (mIRLowering__function_state(&self).current_decl_alloc)?;
      ELSE
    RETURN TRY (mIRLowering__placement_for_node(&self, castOptionalLocatableToLocatable((IF target_node != NIL THEN target_node ELSE UNWRAP (node) END))));
      END
    ELSE
      RETURN :heap;
    END
END
PRIVATE FN mIRLowering__root_receiver_node(self: MIRLowering, node: ?Locatable) RETURNS ?Identifier
  EFFECTS REENTRANT ->
    IF !((node != NIL)) THEN
      RETURN NIL;
    END
    MUTABLE root: ?Identifier = aST__root_identifier(node);
    IF root EXISTS AS root_value THEN
      RETURN COPY root_value;
    END
    IF (node IS_A GetField) OR (node IS_A GetIndex) OR (node IS_A OptionalUnwrap) OR (node IS_A Slice) THEN
      RETURN mIRLowering__root_receiver_node(self, aST__node_target(node));
    ELSE
      RETURN NIL;
    END
END
PRIVATE FN mIRLowering__extract_root_var_name(MUTABLE self: MIRLowering, MUTABLE node: Locatable) RETURNS !?String ->
    MUTABLE root_opt: ?Identifier = mIRLowering__root_receiver_node(self, node);
    IF root_opt EXISTS AS root THEN
      IF mIRLowering__capability_state(&self).with_alias_owner_map EXISTS AS owner_map THEN
        IF owner_map[root.name] EXISTS AS owner_value THEN
          RETURN COPY owner_value;
        END
      END
      IF root.symbol EXISTS AS root_symbol THEN
        IF root_symbol.reg EXISTS AS decl THEN
          MUTABLE decl_names = TRY (functionState__decl_zig_names(mIRLowering__function_state(&self)));
          IF decl_names[aST__node_identity(castSymbolEntryRegInputToLocatable(decl))] EXISTS AS mapped THEN
            RETURN COPY mapped;
          END
        END
      END
      RETURN COPY root.name;
    END
    RETURN NIL;
END
PRIVATE FN mIRLowering__mir_cast(self: MIRLowering, mir_node: Emittable, from_type: Type, to_type: TypeTypeInput) RETURNS !?Emittable ->
    MUTABLE from_t = COPY from_type;
    IF (type__resolved(from_t) == :NoReturn) THEN
      RETURN COPY mir_node;
    END
    MUTABLE to_t: Type = TRY (type__new(castTypeTypeInputToTypeConstructionInput__mir_lowering(to_type)));
    IF to_type IS_A Type AS to_type_struct THEN
      to_t = COPY to_type_struct;
    END
    IF (type__semantic_type_key(from_t) == type__semantic_type_key(to_t)) THEN
      RETURN NIL;
    END
    IF ((type__indirect?(to_t) AND !(type__indirect?(from_t))) AND (type__resolved(from_t) == type__resolved(to_t))) THEN
      RETURN NIL;
    END
    IF (TRY (type__zig_type(from_t)) == TRY (type__zig_type(to_t))) THEN
      RETURN NIL;
    END
    MUTABLE zig_to = TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY to_t }));
    IF (type__fn_type?(from_t) OR type__fn_type?(to_t)) THEN
      RETURN Emittable{ MIRCast: COPY MIRCast{ expr: COPY mir_node, target_type: COPY zig_to, method: :as, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF (type__integer?(from_t) AND type__float?( to_t)) THEN
      RETURN Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ MIRCast: COPY MIRCast{ expr: COPY mir_node, target_type: NIL, method: :floatFromInt, lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: COPY zig_to, method: :as, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF (type__float?(from_t) AND type__integer?( to_t)) THEN
      RETURN Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ MIRCast: COPY MIRCast{ expr: COPY mir_node, target_type: NIL, method: :intFromFloat, lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: COPY zig_to, method: :as, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF (type__integer?( from_t) AND type__integer?(to_t)) THEN
      RETURN Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ MIRCast: COPY MIRCast{ expr: COPY mir_node, target_type: NIL, method: :intCast, lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: COPY zig_to, method: :as, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF (type__float?( from_t) AND type__float?(to_t)) THEN
      RETURN Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ MIRCast: COPY MIRCast{ expr: COPY mir_node, target_type: NIL, method: :floatCast, lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: COPY zig_to, method: :as, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF (type__dynamic?( from_t) AND type__dynamic?(to_t)) THEN
      RETURN NIL;
    END
    IF (type__fixed?(from_t) AND type__empty_list?( to_t)) THEN
      RETURN NIL;
    END
    IF (type__fixed?(from_t) AND type__dynamic?( to_t)) THEN
      MUTABLE from_elem: ?Type = TRY (type__element_type(from_t));
      MUTABLE to_elem: ?Type = TRY (type__element_type(to_t));
      IF from_elem EXISTS AS from_elem_value THEN
        IF to_elem EXISTS AS to_elem_value THEN
          IF (TRY (type__surface_name(TypeTypeInput{ Type: COPY from_elem_value })) == TRY (type__surface_name(TypeTypeInput{ Type: COPY to_elem_value }))) THEN
            RETURN NIL;
          END
        END
      END
    END
    IF (type__map?( from_t) AND type__map?(to_t)) THEN
      RETURN NIL;
    END
    IF type__error_union?(to_t) THEN
      MUTABLE payload_type: Type = UNWRAP (TRY (type__payload_type(to_t)));
      MUTABLE from_matches = (TRY (type__surface_name(TypeTypeInput{ Type: COPY from_t })) == TRY (type__surface_name(TypeTypeInput{ Type: COPY payload_type })));
      from_matches = (from_matches OR (TRY (type__string?(from_t)) AND TRY (type__string?(payload_type))));
      IF from_matches THEN
        RETURN NIL;
      END
    END
    RETURN Emittable{ MIRCast: COPY MIRCast{ expr: COPY mir_node, target_type: COPY zig_to, method: :as, lowered_node_id: NIL, ownership_consumption: NIL } };
END
PRIVATE FN mIRLowering__build_drop_entry_mut(MUTABLE self: MIRLowering, MUTABLE entry: CleanupEntry, ti: Type, source_node: ?VarDecl) RETURNS !?Bool ->
    MUTABLE plan = (cleanupEntry__lifecycle_plan(entry) OR_ELSE ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_122: ?LifecyclePlan = NIL;
    IF source_node != NIL THEN
      rtoc_ternary_value_122 = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_121 = mIRLowering__lifecycle_registry(&self);
    TRY (lifecycleRegistry__fetch_binding(rtoc_local_receiver_121, Locatable{ VarDecl: COPY source_node }, ti)) };
    ELSE
      MUTABLE rtoc_recv_4450 = mIRLowering__lifecycle_registry(&self);
      rtoc_ternary_value_122 = TRY (lifecycleRegistry__fetch(rtoc_recv_4450, ti));
    END
    rtoc_ternary_value_122? }));
    IF !(lifecyclePlan__needs_drop?(plan)) THEN
      MUTABLE source: String = "";
      IF source_node EXISTS AS source_node_value THEN
        source = " binding ${source_node_value.name} at line ${source_node_value.token.line.toString()}";
      ELSE
        source = "";
      END
      panic("lowering attempted DROP for non-owning type {}{}");
    END
    cleanupEntry__set_lifecycle_plan_mut(&entry, plan);
    RETURN TRUE;
END
PRIVATE FN mIRLowering__lower_drop(MUTABLE self: MIRLowering, node: Drop) RETURNS !Cleanup ->
    MUTABLE safe = mIRLowering__zig_safe_name(self, node.name);
    IF node.cleanup_entry EXISTS AS entry THEN
      MUTABLE plan: ?LifecyclePlan = cleanupEntry__lifecycle_plan(entry);
      IF !((IF plan EXISTS AS plan_value THEN
        lifecyclePlan__needs_drop?(plan_value)
      ELSE
        FALSE
      END)) THEN
        panic("MIR::Drop lacks annotation lifecycle plan for {}");
      END
      IF cleanupEntry__has_moved_guard?(entry) THEN
        self.state.function_state.guarded_cleanup_names[safe] = TRUE;
      END
      RETURN Cleanup{ name: COPY safe, cleanup_entry: KEEP entry, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    END
    panic("MIR::Drop lacks annotation lifecycle plan for {}");
END
PRIVATE FN mIRLowering__lower_enum_def(MUTABLE self: MIRLowering, node: EnumDef) RETURNS MIREnumDef ->
    MUTABLE rtoc_mutable_receiver_126 = mIRLowering__lowering_schemas(&self);
    mIRLoweringSchemas__register_enum(&rtoc_mutable_receiver_126, symbol(node.name), CAST(node.variants AS []TypeEnumVariantsItem));
    RETURN MIREnumDef{ name: node.name, variants: node.variants |> SELECT _.toString(), visibility: node.visibility, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN mIRLowering__lower_field_default(MUTABLE self: MIRLowering, node: Locatable) RETURNS !Emittable
  EFFECTS REENTRANT ->
    IF node IS_A DefaultLit AS default_lit THEN
      RETURN Emittable{ DefaultValue: COPY DefaultValue{ kind: :aggregate_empty, zig_type: NIL } };
    ELSE
      RETURN CAST(TRY (mIRLowering__lower(&self, castLocatableToMIRLoweringLowerableStmt__mir_lowering(node))) AS Emittable);
    END
END
PRIVATE FN mIRLowering__lower_struct_field_default(MUTABLE self: MIRLowering, field: StructField) RETURNS !?Emittable
  EFFECTS REENTRANT ->
    IF mIRLowering__callsite_struct_field_default?(self, field) THEN
      RETURN NIL;
    END
    IF (((type__optional?(field.type) AND TRY (type__node_reference?(field.type))) AND ((field.default != NIL) AND (UNWRAP (field.default) IS_A Literal))) AND FALSE) THEN
      RETURN Emittable{ StructInit: COPY StructInit{ zig_type: TRY (type__zig_type(field.type, FALSE, TRUE)), fields: List[], lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF field.default EXISTS AS default_value THEN
      MUTABLE default_value_mutable = COPY default_value;
      RETURN TRY (mIRLowering__lower_field_default(&self, default_value_mutable));
    END
    MUTABLE type = COPY field.type;
    IF (type__optional?(type) AND TRY (type__node_reference?(type))) THEN
      RETURN Emittable{ StructInit: COPY StructInit{ zig_type: TRY (type__zig_type(type, FALSE, TRUE)), fields: List[], lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    IF (type__list_collection?(type) AND !(TRY (type__any_rc?(type)))) THEN
      RETURN Emittable{ ContainerInit: COPY ContainerInit{ zig_type: COPY TRY (type__zig_type(type, FALSE, TRUE)), strategy: :array_list_empty, alloc: NIL, capacity: NIL, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    RETURN NIL;
END
PRIVATE FN mIRLowering__callsite_struct_field_default?(self: MIRLowering, field: StructField) RETURNS Bool ->
    RETURN (((field.default != NIL) AND (UNWRAP (field.default) IS_A HashLit)) OR ((field.default != NIL) AND (UNWRAP (field.default) IS_A ListLit)));
END
PRIVATE FN mIRLowering__lower_struct_def(MUTABLE self: MIRLowering, MUTABLE node: StructDef) RETURNS !Emittable
  EFFECTS REENTRANT ->
    MUTABLE rtoc_mutable_receiver_130 = mIRLowering__lowering_schemas(&self);
    mIRLoweringSchemas__register_struct(&rtoc_mutable_receiver_130, symbol(COPY node.name), TRY (structSchema__new( castStructFieldMapToSchemasStructSchemaFieldInputMap(node.field_decls), node.type_params |> SELECT symbol(_), List[], {}, {})));
    IF (node.type_params.length() > 0) THEN
      MUTABLE comptime_params = node.type_params |> SELECT "comptime ${_}: type";
      MUTABLE fields_mir = node.field_decls.keys() |> SELECT {
    MUTABLE zig_t = TRY (mIRLowering__transpile_type(self, MIRLoweringType{ Type: COPY structField__type((COPY UNWRAP (node.field_decls[_]))) }, FALSE, TRUE));
    MUTABLE default_mir: ?Emittable = TRY (mIRLowering__lower_struct_field_default(&self, CAST(COPY UNWRAP (node.field_decls[_]) AS StructField)));
    FieldDef{ name: COPY _, zig_type: COPY zig_t, default: default_mir, lowered_node_id: NIL, ownership_consumption: NIL, boxed_capture: NIL }
      };
