WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE name = COPY node.name;
    IF mIRLowering__conditional_field_assignment?(rtoc_self_view, castAssignmentNameToName(name)) THEN
      RETURN Stmt{ Emittable: COPY CAST(mIRLowering__lower_conditional_field_assignment(&rtoc_self_view, node) AS Emittable) };
    END
    IF name IS_A GetIndex AS get_index THEN
      MUTABLE get_index_mutable = COPY get_index;
      RETURN castEmittableToStmt(mIRLowering__lower_indexed_assignment(&rtoc_self_view, node));
    END
    IF (IF name IS_A GetField AS get_field THEN node.auto_lock ELSE FALSE END) THEN
      RETURN castEmittableToStmt(mIRLowering__lower_auto_lock_assignment(&rtoc_self_view, node));
    END
    IF (IF name IS_A GetField AS get_field THEN node.field_pre_cleanup ELSE FALSE END) THEN
      RETURN Stmt{ Emittable: COPY CAST(mIRLowering__lower_field_assignment_with_cleanup(&rtoc_self_view, node) AS Emittable) };
    END
    RETURN NIL;
}
END
PRIVATE FN mIRLowering__conditional_field_assignment?(self: MIRLowering, name: Name) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (IF name IS_A GetField AS get_field THEN get_field.target IS_A OptionalUnwrap ELSE FALSE END);
}
END
PRIVATE FN mIRLowering__lower_conditional_field_assignment(MUTABLE self: MIRLowering, node: Assignment) RETURNS !IfBindStmt
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE field: GetField = COPY castAssignmentNameToGetField(node.name);
    MUTABLE unwrap: OptionalUnwrap = COPY CAST(field.target AS OptionalUnwrap);
    MUTABLE source = COPY unwrap.target;
    MUTABLE target_alloc = mIRLowering__placement_for_node(rtoc_self_view, source);
    MUTABLE source_type = TRY (type__from_node_mut(source, "conditional assignment receiver"));
    MUTABLE optional_ptr_branch_value: ?MethodCall = NIL;
    IF source IS_A GetIndex AS get_index THEN
      MUTABLE index = get_index;
      MUTABLE receiver = TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(index.target)));
      IF !(mIRLowering__collection_param_receiver?(rtoc_self_view, index.target)) THEN
        receiver = AddressOf{ expr: Emittable{ AddressOf: COPY receiver }, lowered_node_id: NIL, ownership_consumption: NIL };
      END
      target_alloc = mIRLowering__placement_for_node(rtoc_self_view, index.target);
      optional_ptr_branch_value = TRY (mIRLowering__emit_builtin(rtoc_self_view, :getAtPtrOpt, [Emittable{ AddressOf: COPY receiver }, TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(index.index)))]));
    ELSE
      IF TRY (type__node_reference?(source_type)) THEN
        MUTABLE payload = UNWRAP (TRY (type__node_payload_type(source_type)));
        MUTABLE zig_type = mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ StringValue: COPY CAST(type__resolved(payload) AS String) });
        MUTABLE shared = type__shared_node?(source_type);
        IF !(shared) THEN
          mIRLowering__function_state(rtoc_self_view).node_store_types.insert(zig_type);
        END
        optional_ptr_branch_value = MIRMethodCall{ receiver: Emittable{ Call: COPY TRY (mIRLowering__node_store_type_mir(rtoc_self_view, zig_type, shared)) }, method: "getBound", args: [CAST(Ident{ name: mIRLowering__node_store_binding_name(rtoc_self_view, zig_type, shared), lowered_node_id: NIL, ownership_consumption: NIL } AS Any), CAST(CAST(TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(source))) AS Emittable) AS Any)], try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(1)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
      ELSE
        optional_ptr_branch_value = TRY (mIRLowering__emit_builtin(rtoc_self_view, :getOptionalPtr, [Emittable{ AddressOf: COPY AddressOf{ expr: COPY CAST(TRY (mIRLowering__lower(&rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(source))) AS Emittable), lowered_node_id: NIL, ownership_consumption: NIL } }]));
      END
    END
    MUTABLE optional_ptr: MethodCall = optional_ptr_branch_value?;
    MUTABLE capture = "__conditional_mut_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_690 = mIRLowering__lowering_counters(rtoc_self_view);
    mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_690) }}";
    MUTABLE target = FieldGet{ object: Emittable{ Ident: COPY Ident{ name: capture, lowered_node_id: NIL, ownership_consumption: NIL } }, field: COPY CAST(field.field AS String), lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE field_type = &field.full_type_mut("conditional assignment field");
    IF ((field.safe_nav_chain == TRUE) AND type__optional?(field_type)) THEN
      field_type = UNWRAP (TRY (type__wrapped_type(field_type)));
    END
    MUTABLE field_lifecycle = COPY UNWRAP (mIRLowering__lifecycle_registry(rtoc_self_view)[field_type]);
    MUTABLE value, value_pending = mIRLowering__lower_head(rtoc_self_view, %() USE(field_lifecycle, field_type, node, target_alloc, MUTABLE rtoc_self_view) -> {
    MUTABLE lowered = mIRLowering__with_decl_alloc(rtoc_self_view, target_alloc, %() USE(field_type, node, target_alloc, MUTABLE rtoc_self_view) -> {
      MUTABLE raw = TRY (mIRLowering__lower(&rtoc_self_view, node.value));
      TRY (mIRLowering__place_value_for_destination(rtoc_self_view, raw, node.value, target_alloc, TypeTypeInput{ Type: COPY field_type }))
    });
    MUTABLE materialized =   IF lifecyclePlan__needs_drop?(field_lifecycle) THEN
        TRY (mIRLowering__materialize_owned_sink_value(rtoc_self_view, lowered, node.value, target_alloc))
      ELSE
        lowered
      END;
    IF mIRLowering__node_store_create_call?(rtoc_self_view, materialized) THEN
      RETURN mIRLowering__hoist_evaluation_barrier(rtoc_self_view, materialized);
    ELSE_IF mIRLowering__mir_allocates?(rtoc_self_view, materialized) THEN
      RETURN mIRLowering__hoist_alloc(rtoc_self_view, materialized, node.value, TRUE);
    ELSE
      RETURN materialized;
    END
    NIL
    });
    MUTABLE set = Set{ target: Emittable{ FieldGet: COPY target }, value: COPY value, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    MUTABLE stmt = TRY (mIRLowering__with_ownership_consumption_for_value(rtoc_self_view, Emittable{ Set: COPY set }, value, node.value, "MIR::Set", :owned_sink, target_alloc));
    MUTABLE then_body: []Stmt = ( { MUTABLE rtoc_empty_list_691: []Stmt = List[]; rtoc_empty_list_691 } );
    then_body = ruby_array_concat_Stmt(then_body, CAST(value_pending AS []Stmt));
    IF lifecyclePlan__needs_drop?(field_lifecycle) THEN
      MUTABLE cleanup_call = Call{ callee: "CheatLib.cleanup", args: [Emittable{ TypeOf: COPY TypeOf{ expr: Emittable{ FieldGet: COPY target }, lowered_node_id: NIL, ownership_consumption: NIL } }, Emittable{ AllocatorRef: COPY AllocatorRef{ kind: COPY target_alloc, lowered_node_id: NIL, ownership_consumption: NIL } }, Emittable{ AddressOf: COPY AddressOf{ expr: Emittable{ FieldGet: COPY target }, lowered_node_id: NIL, ownership_consumption: NIL } }], try_wrap: FALSE, owned_return: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(3)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL };
      &then_body.append(Stmt{ Emittable: COPY CAST(ExprStmt{ expr: Emittable{ Call: COPY cleanup_call }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) });
    END
    &then_body.append(castEmittableToStmt(stmt));
    RETURN IfBindStmt{ bindings: COPY [{:expr: optional_ptr, :capture: capture, :node_ref: FALSE}], then_body: COPY then_body, else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
}
END
PRIVATE FN mIRLowering__assignment_target_plan(MUTABLE self: MIRLowering, node: Assignment) RETURNS !AssignmentTargetPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE name = COPY node.name;
    IF name IS_A String AS string THEN
      RETURN AssignmentTargetPlan{ target: Emittable{ Ident: COPY Ident{ name: mIRLowering__assignment_storage_name(rtoc_self_view, string, FALSE), lowered_node_id: NIL, ownership_consumption: NIL } }, cleanup_field: NIL };
    END
    MUTABLE field_branch_value: ?AssignmentName = NIL;
    IF name IS_A GetField AS get_field THEN
      field_branch_value = AssignmentName{ GetField: COPY get_field };
    ELSE
      field_branch_value = NIL;
    END
    MUTABLE field: ?AssignmentName = field_branch_value;
    MUTABLE cleanup_field_branch_value: ?AssignmentName = NIL;
    IF ((field != NIL) AND !(node.field_pre_cleanup)) THEN
      cleanup_field_branch_value = field;
    ELSE
      cleanup_field_branch_value = NIL;
    END
    MUTABLE cleanup_field: ?AssignmentName = cleanup_field_branch_value;
    RETURN AssignmentTargetPlan{ target: COPY CAST(TRY (mIRLowering__lower(&rtoc_self_view, castAssignmentNameToMIRLoweringLowerableStmt(name))) AS Emittable), cleanup_field: castOptionalAssignmentNameToOptionalGetField(COPY cleanup_field) };
}
END
PRIVATE FN mIRLowering__assignment_value(MUTABLE self: MIRLowering, node: Assignment) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE value: Emittable = CAST(TRY (mIRLowering__lower(&rtoc_self_view, node.value)) AS Emittable);
    IF mIRLowering__node_store_create_call?(rtoc_self_view, value) THEN
      value = Emittable{ Ident: COPY mIRLowering__hoist_evaluation_barrier(rtoc_self_view, value) };
    END
    RETURN mIRLowering__copy_container_borrow_if_needed(rtoc_self_view, value, node.value);
}
END
PRIVATE FN mIRLowering__mark_field_assignment_cleanup_mut(self: MIRLowering, MUTABLE result: Set, plan: AssignmentTargetPlan) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE field: ?GetField = COPY plan.cleanup_field;
    IF ((field != NIL) AND lifecyclePlan__needs_drop?((UNWRAP (mIRLowering__lifecycle_registry(rtoc_self_view)[TRY (aST__full_type_mut(field))])))) THEN
      result.needs_field_cleanup = TRUE;
    END
    NIL;
}
END
PRIVATE FN mIRLowering__field_assignment_root_identifier(self: MIRLowering, field: GetField) RETURNS ?Identifier
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE root: Any = COPY field.target;
    WHILE root IS_A GetField DO
      root = root.target();
    END
    IF root IS_A Identifier THEN
      RETURN root;
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN mIRLowering__ownership_marks_for_transferred_temp(self: MIRLowering, value: Emittable, target_alloc: ?String@symbol = NIL) RETURNS ![]Stmt
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF value IS_A Ident AS ident THEN
      MUTABLE name = COPY ident.name;
      MUTABLE entry = ((TRY (functionState__bindings(mIRLowering__function_state(rtoc_self_view))))[name] OR_ELSE new());
      MUTABLE guarded = mIRLowering__pipeline_guarded_cleanup_name?(rtoc_self_view, name);
      IF !((guarded OR cleanupEntry__present?(entry))) THEN
        RETURN CAST(( { MUTABLE rtoc_empty_list_692: []Stmt = List[]; rtoc_empty_list_692 } ) AS []Stmt);
      END
      MUTABLE alloc = (target_alloc OR_ELSE (IF cleanupEntry__present?(entry) THEN
        entry.alloc()
      ELSE
        :heap
      END));
      RETURN TRY (mIRLowering__ownership_transfer_marks(rtoc_self_view, name, :owned_sink, alloc, guarded));
    ELSE
      RETURN CAST(( { MUTABLE rtoc_empty_list_693: []Stmt = List[]; rtoc_empty_list_693 } ) AS []Stmt);
    END
}
END
PRIVATE FN mIRLowering__lower_indexed_assignment(MUTABLE self: MIRLowering, node: Assignment) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE call = NIL;
    IF (node.name.protocol_operation() == :map_put) THEN
      call = mIRLowering__lower_protocol_map_put_call(&rtoc_self_view, node.name.target(), node.name.indexOf(), node.value);
      RETURN Emittable{ ExprStmt: COPY ExprStmt{ expr: COPY call, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
    MUTABLE target_node = node.name.target();
    MUTABLE ti = &target_node.full_type_mut({:context: "indexed assignment target"});
    IF mIRLowering__bc_target?(rtoc_self_view) THEN
      RETURN Emittable{ Set: COPY mIRLowering__lower_direct_indexed_set(&rtoc_self_view, node, FALSE) };
    END
    MUTABLE receiver_type = TRY (type__new(ti));
    IF type__rank?(receiver_type) THEN
      MUTABLE target = AddressOf{ expr: COPY CAST(TRY (mIRLowering__lower(&rtoc_self_view, target_node)) AS Emittable), lowered_node_id: NIL, ownership_consumption: NIL };
      MUTABLE index_nodes: []?Int64 = List[];
      IF FALSE THEN
        index_nodes = node.name.indexOf().items();
      ELSE
        index_nodes = [node.name.indexOf()];
      END
      MUTABLE lowered_indices = index_nodes |> SELECT CAST(TRY (mIRLowering__lower(&rtoc_self_view, _)) AS Emittable);
      MUTABLE coordinates = mIRLowering__rank_coordinates(rtoc_self_view, Emittable{ AddressOf: COPY target }, receiver_type, lowered_indices);
      MUTABLE value: Emittable = CAST(TRY (mIRLowering__lower(&rtoc_self_view, node.value)) AS Emittable);
      call = RuntimeCall{ spec: COPY runtimeCalls__rank_set_spec(), args: [Emittable{ AddressOf: COPY target }, coordinates.dimensions, Emittable{ ArrayInit: COPY coordinates.indices }, value], lowered_node_id: NIL, ownership_consumption: NIL };
      RETURN Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ RuntimeCall: COPY call }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
    IF ((type__fixed?(receiver_type) AND !(TRY (type__string?(receiver_type)))) AND !(type__collection?(receiver_type))) THEN
      RETURN Emittable{ Set: COPY mIRLowering__lower_direct_indexed_set(&rtoc_self_view, node, TRUE) };
    END
    MUTABLE kind = TRY (type__dispatch_key(ti));
    MUTABLE op_spec = (kind AND (IF ({:string_map: {:get: {:zig: "{target}.get({index})", :shard_direct_zig: "{target}.getDirect({shard_idx}, {shard_key})", :return_type: :r_optional_value, :container_borrow: TRUE, :bc: TRUE, :bc_op: :map_get}, :set: {:zig: "try {target}.put({key_alloc}, {val_alloc}, {index}, {value})", :takes_value: TRUE, :allocates: TRUE, :key_alloc: :receiver_storage, :val_alloc: :receiver_storage, :shard_direct_zig: "try {target}.putDirect({shard_idx}, {shard_alloc}, {shard_key}, {value})", :shard_alloc: :heap, :bc: TRUE, :bc_op: :map_set}}, :numeric_map: {:get: {:zig: "CheatLib.numericMapGet({key_zig}, {val_zig}, {target}, {index})", :sharded_zig: "{target}.get({index})", :shard_direct_zig: "{target}.getDirect({shard_idx}, {shard_key})", :return_type: :r_optional_value, :container_borrow: TRUE, :bc: TRUE, :bc_op: :map_get}, :set: {:zig: "try CheatLib.numericMapPut({key_zig}, {val_zig}, {alloc}, &{target}, {index}, {value})", :takes_value: TRUE, :allocates: TRUE, :alloc: :receiver_storage, :sharded_zig: "try {target}.put({alloc}, {alloc}, {index}, {value})", :shard_direct_zig: "try {target}.putDirect({shard_idx}, {shard_alloc}, {shard_key}, {value})", :shard_alloc: :heap, :bc: TRUE, :bc_op: :map_set}}, :array: {:get: {:zig: "CheatLib.getAt({target}, {index})", :return_type: :r_element_of, :container_borrow: TRUE}, :set: {:zig: "CheatLib.setAt({target}, {index}, {value})", :takes_value: TRUE, :val_alloc: :receiver_storage}}, :list: {:get: {:zig: "CheatLib.getAtOpt({target}, {index})", :builtin: :getAtOpt, :return_type: :r_optional_element, :container_borrow: TRUE}, :set: {:zig: "CheatLib.setAt({target}, {index}, {value})", :takes_value: TRUE, :val_alloc: :receiver_storage}}, :pool: {:get: {:zig: "{target}.get({index})", :return_type: :r_optional_element, :container_borrow: TRUE}, :set: {:zig: "try {target}.insert({alloc}, {value})", :takes_value: TRUE, :allocates: TRUE, :alloc: :heap}}, :set_collection: {:get: {:zig: "if ({target}.contains({index})) {index} else null", :return_type: :r_optional_element, :container_borrow: TRUE}, :set: {:zig: "try {target}.insert({alloc}, {value})", :takes_value: TRUE, :allocates: TRUE, :alloc: :heap}}, :string_raw: {:get: {:builtin: :charAt, :return_type: {:type: :String, :sync: :raw}, :container_borrow: TRUE}}, :string_symbol: {:get: {:builtin: :charAt, :return_type: {:type: :String, :sync: :symbol}, :container_borrow: TRUE}}})[kind] != NIL THEN
    ((({:string_map: {:get: {:zig: "{target}.get({index})", :shard_direct_zig: "{target}.getDirect({shard_idx}, {shard_key})", :return_type: :r_optional_value, :container_borrow: TRUE, :bc: TRUE, :bc_op: :map_get}, :set: {:zig: "try {target}.put({key_alloc}, {val_alloc}, {index}, {value})", :takes_value: TRUE, :allocates: TRUE, :key_alloc: :receiver_storage, :val_alloc: :receiver_storage, :shard_direct_zig: "try {target}.putDirect({shard_idx}, {shard_alloc}, {shard_key}, {value})", :shard_alloc: :heap, :bc: TRUE, :bc_op: :map_set}}, :numeric_map: {:get: {:zig: "CheatLib.numericMapGet({key_zig}, {val_zig}, {target}, {index})", :sharded_zig: "{target}.get({index})", :shard_direct_zig: "{target}.getDirect({shard_idx}, {shard_key})", :return_type: :r_optional_value, :container_borrow: TRUE, :bc: TRUE, :bc_op: :map_get}, :set: {:zig: "try CheatLib.numericMapPut({key_zig}, {val_zig}, {alloc}, &{target}, {index}, {value})", :takes_value: TRUE, :allocates: TRUE, :alloc: :receiver_storage, :sharded_zig: "try {target}.put({alloc}, {alloc}, {index}, {value})", :shard_direct_zig: "try {target}.putDirect({shard_idx}, {shard_alloc}, {shard_key}, {value})", :shard_alloc: :heap, :bc: TRUE, :bc_op: :map_set}}, :array: {:get: {:zig: "CheatLib.getAt({target}, {index})", :return_type: :r_element_of, :container_borrow: TRUE}, :set: {:zig: "CheatLib.setAt({target}, {index}, {value})", :takes_value: TRUE, :val_alloc: :receiver_storage}}, :list: {:get: {:zig: "CheatLib.getAtOpt({target}, {index})", :builtin: :getAtOpt, :return_type: :r_optional_element, :container_borrow: TRUE}, :set: {:zig: "CheatLib.setAt({target}, {index}, {value})", :takes_value: TRUE, :val_alloc: :receiver_storage}}, :pool: {:get: {:zig: "{target}.get({index})", :return_type: :r_optional_element, :container_borrow: TRUE}, :set: {:zig: "try {target}.insert({alloc}, {value})", :takes_value: TRUE, :allocates: TRUE, :alloc: :heap}}, :set_collection: {:get: {:zig: "if ({target}.contains({index})) {index} else null", :return_type: :r_optional_element, :container_borrow: TRUE}, :set: {:zig: "try {target}.insert({alloc}, {value})", :takes_value: TRUE, :allocates: TRUE, :alloc: :heap}}, :string_raw: {:get: {:builtin: :charAt, :return_type: {:type: :String, :sync: :raw}, :container_borrow: TRUE}}, :string_symbol: {:get: {:builtin: :charAt, :return_type: {:type: :String, :sync: :symbol}, :container_borrow: TRUE}}})[kind])?)[:set]
    ELSE
    NIL
    END));
    MUTABLE target = TRY (mIRLowering__lower(&rtoc_self_view, target_node));
    MUTABLE idx = TRY (mIRLowering__lower(&rtoc_self_view, node.name.indexOf()));
    IF !(op_spec) THEN
      MUTABLE val = TRY (mIRLowering__lower(&rtoc_self_view, node.value));
      RETURN Emittable{ ExprStmt: COPY ExprStmt{ expr: castMIRLoweringReturnValueToEmittable(COPY TRY (mIRLowering__emit_builtin(rtoc_self_view, :setAt, [Emittable{ AddressOf: COPY target }, idx, val]))), discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
    MUTABLE op: ?FunctionSignature@multiowned = functionSignature__unwrap(ruby_wrap_optional_FunctionSignature_multiowned_X(TRY (intrinsicRegistry__fs(op_spec, RegistryKey{ SymbolValue: COPY symbol("${kind}_set") }))));
    IF op EXISTS AS op_value THEN
      MUTABLE op_value_mutable = COPY op_value;
      IF ((kind == :string_map) OR (kind == :numeric_map)) THEN
        RETURN Emittable{ ShardedMapPut: COPY mIRLowering__lower_map_indexed_assignment(&rtoc_self_view, node, target_node, receiver_type, Emittable{ AddressOf: COPY target }, idx, kind, op_value_mutable) };
      END
      RETURN mIRLowering__lower_template_indexed_assignment(&rtoc_self_view, node, target_node, receiver_type, Emittable{ AddressOf: COPY target }, idx, kind, op_value_mutable);
    ELSE
      panic("indexed assignment: missing registry signature for {}");
    END
}
END
PRIVATE FN mIRLowering__lower_direct_indexed_set(MUTABLE self: MIRLowering, node: Assignment, cast_index: Bool) RETURNS !Set
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE target = TRY (mIRLowering__lower(&rtoc_self_view, node.name.target()));
    MUTABLE idx = TRY (mIRLowering__lower(&rtoc_self_view, node.name.indexOf()));
    IF cast_index THEN
      idx = MIRCast{ expr: Emittable{ MIRCast: COPY idx }, target_type: "usize", method: :intCast, lowered_node_id: NIL, ownership_consumption: NIL };
    END
    MUTABLE target_alloc = mIRLowering__placement_for_node(rtoc_self_view, node.name.target());
    MUTABLE value_type = TRY (type__from_node_mut(node.value, "direct indexed assignment value"));
    MUTABLE val = mIRLowering__with_decl_alloc(rtoc_self_view, target_alloc, %() USE(node, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_694 = TRY (mIRLowering__lower(&rtoc_self_view, node.value));
    rtoc_lambda_result_694
    });
    IF mIRLowering__ownership_tracked_transfer_type?(rtoc_self_view, value_type) THEN
      val = TRY (mIRLowering__place_value_for_destination(rtoc_self_view, val, node.value, target_alloc, TypeTypeInput{ Type: COPY value_type }));
      val = TRY (mIRLowering__materialize_owned_sink_value(rtoc_self_view, val, node.value, target_alloc, TypeTypeInput{ Type: COPY value_type }));
      IF mIRLowering__mir_allocates?(rtoc_self_view, val) THEN
        val = mIRLowering__hoist_alloc(rtoc_self_view, val, node.value, TRUE);
      END
    END
    MUTABLE set = Set{ target: Emittable{ IndexGet: COPY IndexGet{ object: COPY target, index: Emittable{ MIRCast: COPY idx }, lowered_node_id: NIL, ownership_consumption: NIL } }, value: COPY val, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    TRY (mIRLowering__with_ownership_consumption_for_value(rtoc_self_view, Emittable{ Set: COPY set }, val, node.value, "MIR::Set", :owned_sink, target_alloc));
    RETURN set;
}
END
PRIVATE FN mIRLowering__lower_map_indexed_assignment(MUTABLE self: MIRLowering, node: Assignment, target_node: Locatable, receiver_type: Type, target_input: Emittable, idx_input: Emittable, kind: String@symbol, op: FunctionSignature) RETURNS !ShardedMapPut
