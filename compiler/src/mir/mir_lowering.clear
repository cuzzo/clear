      END
      MUTABLE source_slice_view: Bool = ((!((sink_type == NIL)) AND TRY (type__direct_indexable_collection?(ti))) AND !(type__collection?(dst_ti)));
      RETURN OwnedSinkPlan{ action: IF TRY (type__string?(ti)) THEN
        :dupe_slice
      ELSE
        :deep_copy
