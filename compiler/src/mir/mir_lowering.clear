      mIRLowering__mark_ownership_finalized_node_mut(&self, Emittable{ AllocMark: COPY alloc_mark_value });
      mIRLowering__mark_ownership_finalized_node_mut(&self, Emittable{ OwnedCreate: COPY fact });
