PRIVATE FN mIRLowering__safe_with_capability_alias(self: MIRLowering, alias_name: String) RETURNS String ->
    MUTABLE cleaned: String = "";
    IF ((alias_name.endsWith?("!") OR alias_name.endsWith?("?"))) THEN
      cleaned = COPY alias_name.substr(0, (((alias_name.length() - 2) - 0) + 1));
    ELSE
      cleaned = COPY alias_name;
    END
    IF (cleaned == entrypointName()) THEN
      cleaned = entrypointZigName();
    END
    IF zigType__primitive_numeric_identifier?(cleaned) THEN
      RETURN "@\"${cleaned}\"";
    ELSE
      RETURN cleaned;
    END
END
