    RETURN AutoLockAssignmentFacts{ var_name: COPY var_name, sync: COPY auto_lock.sync, guard_var: "__${var_name}_guard", alias_var: "__${var_name}_inner", zig_var: COPY CAST((((IF mIRLowering__capture_state(rtoc_self_view).do_capture_map != NIL THEN
      (mIRLowering__capture_state(rtoc_self_view).do_capture_map)[var_name]
    ELSE
      NIL
    END) OR_ELSE var_name)) AS String), field: COPY CAST(node.name.field() AS String), cleanup_alloc: COPY cleanup_alloc, alloc_sym: COPY (cleanup_alloc OR_ELSE mIRLowering__placement_for_node(rtoc_self_view, (mIRLowering__root_receiver_node(rtoc_self_view, castAssignmentNameToOptionalLocatable(node.name)) OR_ELSE node.name))) };
}
