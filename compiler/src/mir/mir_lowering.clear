FN mIRLowering__node_create_mir(self: MIRLowering, value: Emittable, destination: Type, source_node: Locatable) RETURNS !MIRMethodCall
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE payload = UNWRAP (TRY (type__node_payload_type(destination)));
    MUTABLE zig_type = mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ StringValue: COPY CAST(type__resolved(payload) AS String) });
    MUTABLE shared = type__shared_node?(destination);
    IF !(shared) THEN
      mIRLowering__function_state(rtoc_self_view).node_store_types.insert(zig_type);
    END
    MUTABLE store = TRY (mIRLowering__node_store_type_mir(rtoc_self_view, zig_type, shared));
    MUTABLE call = MIRMethodCall{ receiver: Emittable{ Call: COPY store }, method: "createBound", args: [CAST(Ident{ name: mIRLowering__node_store_binding_name(rtoc_self_view, zig_type, shared), lowered_node_id: NIL, ownership_consumption: NIL } AS Any), CAST(value AS Any)], try_wrap: TRUE, callable_contract: COPY TRY (callableContract__no_ownership(2)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    call.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY destination }));
    RETURN castEmittableToMIRMethodCall(TRY (mIRLowering__with_ownership_consumption_for_value(rtoc_self_view, Emittable{ MIRMethodCall: COPY call }, value, source_node, IF shared THEN
      "SharedNodeStore.createBound"
    ELSE
      "NodeStore.createBound"
    END, :owned_sink, :heap)));
}
END
FN mIRLowering__node_store_type_mir(self: MIRLowering, zig_type: String, shared_value: Bool = FALSE) RETURNS !Call
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN Call{ callee: IF shared_value THEN
      "CheatLib.SharedNodeStore"
    ELSE
      "CheatLib.NodeStore"
    END, args: [Emittable{ Ident: COPY Ident{ name: COPY zig_type, lowered_node_id: NIL, ownership_consumption: NIL } }], try_wrap: FALSE, owned_return: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(1)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL };
}
END
FN mIRLowering__shared_node_store_types_in_mir(self: MIRLowering, nodes: []Emittable, include_bodies: Bool = TRUE) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE found: [Set]String = Set[];
    MUTABLE pending: []Emittable = COPY nodes;
    WHILE !((pending.length() == 0)) DO
      MUTABLE node = UNWRAP (&pending.pop());
      IF ((IF node IS_A MIRMethodCall AS mir_method_call THEN mir_method_call.receiver IS_A Call ELSE FALSE END) AND ((CAST(node.receiver() AS Call)).callee == "CheatLib.SharedNodeStore")) THEN
        MUTABLE arg: ?Emittable = COPY ((CAST(node.receiver() AS Call)).args).first();
        IF arg? IS_A Ident AS ident THEN
          &found.insert(ident.name);
        END
      END
      FOR _ IN node.child_exprs() DO
      IF _ IS_A Emittable THEN
        &pending.append(_);
      END
      END
      IF ((include_bodies OR node IS_A ScopeBlock) OR node IS_A MIRBlockExpr) THEN
        FOR _ IN node.body_slots() DO
        FOR _ IN _.body() DO
        &pending.append(COPY _);
        END
        END
      END
    END
    RETURN (found |> SELECT COPY _) |> ORDER_BY _;
}
END
FN mIRLowering__guard_shared_node_statement(self: MIRLowering, stmt: MIRLoweringLowerableStmt, nodes: []Emittable) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE types = TRY (mIRLowering__shared_node_store_types_in_mir(rtoc_self_view, nodes, FALSE));
    IF (types.length() == 0) THEN
      RETURN COPY nodes;
    END
    MUTABLE write = ((stmt IS_A Assignment OR stmt IS_A MethodCall) OR (nodes |> ANY mIRLowering__shared_node_write_mir?(rtoc_self_view, _)));
    MUTABLE lock_method: String = "";
    IF write THEN
      lock_method = "lockWrite";
    ELSE
      lock_method = "lockRead";
    END
    MUTABLE unlock_method: String = "";
    IF write THEN
      unlock_method = "unlockWrite";
    ELSE
      unlock_method = "unlockRead";
    END
    MUTABLE prefix: []Emittable = ( { MUTABLE rtoc_empty_list_11: []Emittable = List[]; rtoc_empty_list_11 } );
    FOR _ IN types DO
    MUTABLE store = TRY (mIRLowering__node_store_type_mir(rtoc_self_view, _, TRUE));
    MUTABLE binding = mIRLowering__node_store_binding_name(rtoc_self_view, _, TRUE);
    &prefix.append(Emittable{ Let: COPY Let{ name: COPY binding, init: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Call: COPY store }, method: COPY lock_method, args: [CAST(Ident{ name: mIRLowering__runtime_binding_name(rtoc_self_view), lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: TRUE, callable_contract: COPY TRY (callableContract__no_ownership(1)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
    &prefix.append(Emittable{ MIRDeferStmt: COPY MIRDeferStmt{ body: DeferBody{ Emittable: COPY CAST(COPY MIRMethodCall{ receiver: Emittable{ Call: COPY store }, method: COPY unlock_method, args: [CAST(Ident{ name: binding, lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(1)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } AS Emittable) }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    END
    MUTABLE access_nodes = nodes |> WHERE !(((TRY (mIRLowering__shared_node_store_types_in_mir(rtoc_self_view, [_], FALSE))).length() == 0));
    IF (access_nodes.length() == 1) THEN
    IF ((access_nodes.first() != NIL) AND (access_nodes.first() IS_A Let)) THEN
      MUTABLE binding: Let = COPY castOptionalEmittableToLet(access_nodes.first());
      MUTABLE label = "__shared_node_access_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_12 = mIRLowering__lowering_counters(rtoc_self_view);
      mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_12) }}";
      MUTABLE original_init = COPY binding.init;
      MUTABLE body: []Emittable = prefix;
      IF mIRLowering__mir_allocates?(rtoc_self_view, original_init) THEN
        MUTABLE value_name = "__shared_node_value_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_13 = mIRLowering__lowering_counters(rtoc_self_view);
        mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_13) }}";
        MUTABLE value_type_branch_value: ?Type = NIL;
        IF (respondsTo?(original_init, "result_type") AND original_init.result_type()) THEN
          value_type_branch_value = TRY (type__new(original_init.result_type()));
        ELSE
          value_type_branch_value = (binding.annotation OR_ELSE TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })));
        END
        MUTABLE value_type: Type = value_type_branch_value?;
        MUTABLE value_alloc = (mIRLowering__mir_owned_alloc(rtoc_self_view, original_init) OR_ELSE :heap);
        MUTABLE materialized = BindingMaterialization{ name: COPY value_name, expr: COPY original_init, alloc: COPY value_alloc, type_info: COPY value_type, mutable: FALSE, annotation: NIL, suppression: NIL, cleanup_entry: NIL, cleanup_mode: :normal, scope: NIL, ownership_tracked: TRUE };
        body = ruby_array_concat_Emittable(body, CAST(TRY (bindingMaterialization__statements(materialized)) AS []Emittable));
        body = ruby_array_concat_Emittable(body, CAST(TRY (mIRLowering__ownership_transfer_marks(rtoc_self_view, value_name, :block_result, value_alloc)) AS []Emittable));
        &body.append(Emittable{ BreakStmt: COPY BreakStmt{ label: COPY label, value: Emittable{ Ident: COPY Ident{ name: value_name, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
      ELSE
        &body.append(Emittable{ BreakStmt: COPY BreakStmt{ label: COPY label, value: COPY original_init, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
      END
      MUTABLE block = MIRBlockExpr{ label: label, body: Body{ ArrayValue: body |> SELECT castEmittableToLocatable(_) }, lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
      IF respondsTo?(original_init, "result_type") THEN
        block.result_type = original_init.result_type();
      END
      binding.init = Emittable{ MIRBlockExpr: COPY block };
      RETURN COPY nodes;
    END
    END
    RETURN CAST([Emittable{ ScopeBlock: COPY ScopeBlock{ body: COPY (prefix + nodes), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable);
}
END
FN mIRLowering__shared_node_write_mir?(self: MIRLowering, node: Emittable) RETURNS Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF ((IF node IS_A MIRMethodCall AS mir_method_call THEN mir_method_call.receiver IS_A Call ELSE FALSE END) AND ((CAST(node.receiver() AS Call)).callee == "CheatLib.SharedNodeStore")) THEN
      IF (["createBound", "removeBound"]).contains?(node.method()) THEN
        RETURN TRUE;
      END
    END
    IF !(TRUE) THEN
      RETURN FALSE;
    END
    RETURN ((node.child_exprs() |> ANY (_ IS_A Emittable AND mIRLowering__shared_node_write_mir?(rtoc_self_view, _))) OR (node.body_slots() |> ANY _.body() |> ANY mIRLowering__shared_node_write_mir?(rtoc_self_view, _)));
}
END
FN mIRLowering__optional_nil_mir(self: MIRLowering, type: Type) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF TRY (type__node_reference?(type)) THEN
      RETURN Emittable{ StructInit: COPY StructInit{ zig_type: TRY (type__zig_type(type)), fields: ( { MUTABLE rtoc_empty_list_14: []Any = List[]; rtoc_empty_list_14 } ), lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE
      MUTABLE optional_type_branch_value: ?Type = NIL;
      IF type__optional?(type) THEN
        optional_type_branch_value = COPY type;
      ELSE
        optional_type_branch_value = TRY (type__optional_of(TypeTypeInput{ Type: COPY type }));
      END
      MUTABLE optional_type: Type = optional_type_branch_value?;
      RETURN Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ Lit: COPY Lit{ value: "null", lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: COPY TRY (type__zig_type(optional_type)), method: :as, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
}
END
FN mIRLowering__destination_placement_plan(self: MIRLowering, mir: Emittable, ast_node: Locatable, dest_alloc: ?String@symbol, dest_type: ?TypeTypeInput) RETURNS !DestinationPlacementPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF dest_alloc EXISTS AS dest_alloc_value THEN
      MUTABLE dest_alloc_value_mutable = COPY dest_alloc_value;
      MUTABLE ti = TRY (mIRLowering__destination_type(rtoc_self_view, ast_node, dest_type));
      IF (type__symbol?(ti) OR (((respondsTo?(ast_node, "typed?") AND ast_node.typed?()) AND ((type__symbol?((TRY (type__from_node_mut(ast_node, "placement symbol probe")))) OR_ELSE FALSE))))) THEN
        RETURN mIRLowering__destination_keep_plan(rtoc_self_view, dest_alloc_value_mutable);
      END
      IF (placement__heap?(dest_alloc_value_mutable) AND TRY (mIRLowering__heap_indirect_destination?(rtoc_self_view, mir, ast_node, CAST(ti AS Type)))) THEN
        RETURN DestinationPlacementPlan{ action: :heap_indirect, type_info: CAST(COPY ti AS ?Type), dest_alloc: COPY dest_alloc_value_mutable, source_alloc: NIL };
      END
      IF mIRLowering__cast_wrapped_or?(rtoc_self_view, mir, ast_node) THEN
        RETURN DestinationPlacementPlan{ action: :cast_wrapped_or, type_info: CAST(COPY ti AS ?Type), dest_alloc: COPY dest_alloc_value_mutable, source_alloc: NIL };
      END
      IF (TRY (type__string?(ti)) AND type__rodata?(ti)) THEN
        RETURN mIRLowering__destination_keep_plan(rtoc_self_view, dest_alloc_value_mutable);
      END
      IF mIRLowering__borrowed_string_destination?(rtoc_self_view, ast_node, CAST(ti AS Type), dest_alloc_value_mutable) THEN
        RETURN mIRLowering__destination_keep_plan(rtoc_self_view, dest_alloc_value_mutable);
      END
      IF mIRLowering__owned_or_destination?(rtoc_self_view, mir, ast_node, CAST(ti AS Type), :orelse) THEN
        RETURN DestinationPlacementPlan{ action: :owned_orelse, type_info: CAST(COPY ti AS ?Type), dest_alloc: COPY dest_alloc_value_mutable, source_alloc: NIL };
      END
      IF mIRLowering__owned_or_destination?(rtoc_self_view, mir, ast_node, CAST(ti AS Type), :try_catch) THEN
        RETURN DestinationPlacementPlan{ action: :owned_try_catch, type_info: CAST(COPY ti AS ?Type), dest_alloc: COPY dest_alloc_value_mutable, source_alloc: NIL };
      END
      MUTABLE source_alloc: ?String@symbol = mIRLowering__mir_owned_alloc(rtoc_self_view, mir);
      IF TRY (mIRLowering__heap_owned_future_handle_destination?(rtoc_self_view, mir, ast_node, dest_alloc_value_mutable, CAST(ti AS Type))) THEN
        RETURN mIRLowering__destination_keep_plan(rtoc_self_view, dest_alloc_value_mutable);
      END
      IF (((source_alloc != NIL) AND (source_alloc != dest_alloc_value_mutable)) AND mIRLowering__ownership_bearing_type?(rtoc_self_view, CAST(ti AS Type))) THEN
        RETURN DestinationPlacementPlan{ action: :owned_alloc_mismatch, type_info: CAST(COPY ti AS ?Type), dest_alloc: COPY dest_alloc_value_mutable, source_alloc: COPY source_alloc };
      END
      MUTABLE source = TRY (mIRLowering__destination_source_fact(rtoc_self_view, mir, ast_node));
      MUTABLE needs_recursive_copy = (((mIRLowering__ownership_bearing_type?(rtoc_self_view, CAST(ti AS Type)) AND source.borrowed) AND !(source.owner_transfer)) AND !(source.heap_owned_result));
      IF (destinationSourceFact__needs_owned_copy?(&source, CAST(ti AS Type)) OR needs_recursive_copy) THEN
        RETURN DestinationPlacementPlan{ action: :owned_copy, type_info: CAST(COPY ti AS ?Type), dest_alloc: COPY dest_alloc_value_mutable, source_alloc: NIL };
      END
      IF (TRY (type__string?(ti)) AND mIRLowering__or_binary?(rtoc_self_view, ast_node)) THEN
        RETURN DestinationPlacementPlan{ action: :string_or, type_info: CAST(COPY ti AS ?Type), dest_alloc: COPY dest_alloc_value_mutable, source_alloc: NIL };
      END
      IF type__symbol?(ti) THEN
        RETURN mIRLowering__destination_keep_plan(rtoc_self_view, dest_alloc_value_mutable);
      END
      IF TRY (type__string?(ti)) THEN
        RETURN DestinationPlacementPlan{ action: :string, type_info: CAST(COPY ti AS ?Type), dest_alloc: COPY dest_alloc_value_mutable, source_alloc: NIL };
      END
      RETURN mIRLowering__destination_keep_plan(rtoc_self_view, dest_alloc_value_mutable);
    ELSE
      RETURN mIRLowering__destination_keep_plan(rtoc_self_view, dest_alloc);
    END
}
END
FN mIRLowering__destination_keep_plan(self: MIRLowering, dest_alloc: ?String@symbol) RETURNS DestinationPlacementPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN DestinationPlacementPlan{ action: :keep, type_info: NIL, dest_alloc: COPY dest_alloc, source_alloc: NIL };
}
END
FN mIRLowering__destination_type(self: MIRLowering, ast_node: Locatable, dest_type: ?TypeTypeInput) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE ti = (dest_type OR_ELSE TypeTypeInput{ Type: COPY TRY (type__from_node_mut(ast_node, "destination placement type")) });
    IF ti IS_A Type AS type THEN
      RETURN type;
    ELSE
      RETURN TRY (type__new(castTypeTypeInputToTypeConstructionInput(ti)));
    END
}
END
FN mIRLowering__or_binary?(self: MIRLowering, node: ?Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (IF node? IS_A BinaryOp AS binary_op THEN (((binary_op.op == symbol("OR_ELSE")) OR (binary_op.op == symbol("OR")))) ELSE FALSE END);
}
END
FN mIRLowering__destination_source_fact(self: MIRLowering, mir: Emittable, ast_node: Locatable) RETURNS !DestinationSourceFact
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE node = mIRLowering__destination_source_node(rtoc_self_view, ast_node);
    RETURN DestinationSourceFact{ borrowed: TRY (mIRLowering__borrowed_destination_node?(rtoc_self_view, node)), owner_transfer: mIRLowering__owner_transfer_node?(rtoc_self_view, &node), heap_owned_result: mIRLowering__heap_owned_result?(rtoc_self_view, mir, node) };
}
END
FN mIRLowering__destination_source_node(self: MIRLowering, node: Locatable) RETURNS Locatable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (IF node IS_A BinaryOp AS binary_op THEN mIRLowering__or_binary?(rtoc_self_view, Locatable{ BinaryOp: COPY binary_op }) ELSE FALSE END) THEN
      RETURN COPY node.left();
    ELSE
      RETURN COPY node;
    END
}
END
FN mIRLowering__borrowed_destination_node?(self: MIRLowering, node: Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF TRY (mIRLowering__unit_union_variant_constructor?(rtoc_self_view, node)) THEN
      RETURN FALSE;
    END
    RETURN (node IS_A GetField OR node IS_A GetIndex);
}
END
FN mIRLowering__owner_transfer_node?(self: MIRLowering, MUTABLE node: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF aST__container_borrow?(node) THEN
      RETURN FALSE;
    END
    IF aST__moved?(node) THEN
      RETURN TRUE;
    END
    IF (IF node IS_A GetField AS get_field THEN (get_field.indirect_field == TRUE) ELSE FALSE END) THEN
      RETURN TRUE;
    END
    IF node IS_A GetField AS get_field THEN
      MUTABLE get_field_mutable = COPY get_field;
      RETURN type__indirect_type?(&get_field_mutable.full_type_mut("owner transfer source"));
    END
    RETURN FALSE;
}
END
FN mIRLowering__cast_wrapped_or?(self: MIRLowering, mir: Emittable, ast_node: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN !(!(((IF mir IS_A MIRCast AS mir_cast THEN mIRLowering__or_binary?(rtoc_self_view, ast_node) ELSE FALSE END))));
}
END
FN mIRLowering__heap_indirect_destination?(self: MIRLowering, mir: Emittable, ast_node: Locatable, ti: Type) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(((type__indirect?(ti) AND !(type__any_sync?(ti))) AND (type__ownership(ti) == :affine))) THEN
      RETURN FALSE;
    END
    IF mir IS_A HeapCreate AS heap_create THEN
      RETURN FALSE;
    END
    MUTABLE source_t = TRY (type__from_node_mut(ast_node, "heap indirect destination source"));
    RETURN !(type__indirect_type?(source_t));
}
END
FN mIRLowering__owned_or_destination?(self: MIRLowering, mir: Emittable, ast_node: Locatable, ti: Type, kind: String@symbol) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((mIRLowering__or_binary?(rtoc_self_view, ast_node) AND mIRLowering__ownership_bearing_type?(rtoc_self_view, ti))) THEN
      RETURN FALSE;
    END
    RETURN PARTIAL MATCH kind START
      :orelse -> mir IS_A Orelse,
      :try_catch -> mir IS_A TryCatch,
      DEFAULT -> FALSE
    END;
}
END
FN mIRLowering__borrowed_string_destination?(self: MIRLowering, ast_node: Locatable, ti: Type, dest_alloc: ?String@symbol) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ((TRY (type__string?(ti)) AND !(placement__heap?(dest_alloc))) AND aST__container_borrow?(ast_node));
}
END
FN mIRLowering__heap_owned_future_handle_destination?(self: MIRLowering, mir: Emittable, ast_node: Locatable, dest_alloc: String@symbol, type_info: Type) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(placement__frame?(dest_alloc)) THEN
      RETURN FALSE;
    END
    MUTABLE source_type = TRY (type__from_node_mut(ast_node, "async boundary destination"));
    IF !((TRY (type__single_future?(type_info)) OR TRY (type__single_future?(source_type)))) THEN
      RETURN FALSE;
    END
    MUTABLE effect = ownershipEffect__of(mir);
    RETURN (((effect.produces_owned AND placement__heap?(effect.alloc))) == TRUE);
}
END
FN mIRLowering__place_indirect_value_for_heap_destination(self: MIRLowering, mir: Emittable, ti: Type) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (mIRLowering__with_ownership_consumption(rtoc_self_view, Emittable{ HeapCreate: COPY HeapCreate{ zig_type: COPY mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ StringValue: COPY CAST(type__resolved(ti) AS String) }), init: COPY mir, alloc: :heap, label: "blk", lowered_node_id: NIL, ownership_consumption: NIL } }, mIRLowering__mir_ident_names(rtoc_self_view, mir), "MIR::HeapCreate", :owned_sink, :heap));
}
END
FN mIRLowering__place_owned_orelse_for_destination(self: MIRLowering, mir: Orelse, ti: Type, dest_alloc: String@symbol) RETURNS !Emittable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE tmp_id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_15 = mIRLowering__lowering_counters(rtoc_self_view);
    mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_15) };
    MUTABLE capture = "__or_val_${tmp_id}";
    MUTABLE left = TRY (mIRLowering__place_owned_branch_value_for_destination(rtoc_self_view, Emittable{ Ident: COPY Ident{ name: capture, lowered_node_id: NIL, ownership_consumption: NIL } }, ti, dest_alloc));
    MUTABLE right = TRY (mIRLowering__place_owned_branch_value_for_destination(rtoc_self_view, mir.fallback, ti, dest_alloc));
    MUTABLE out = IfOptional{ optional: COPY mir.expr, capture: capture, then_expr: COPY left, else_expr: COPY right, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    out.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY ti }));
    RETURN Emittable{ MIRBlockExpr: COPY TRY (mIRLowering__owned_branch_result_value(rtoc_self_view, Emittable{ IfOptional: COPY out }, ti, dest_alloc)) };
}
END
FN mIRLowering__place_owned_try_catch_for_destination(self: MIRLowering, mir: TryCatch, ti: Type, dest_alloc: String@symbol) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE right = TRY (mIRLowering__place_owned_branch_value_for_destination(rtoc_self_view, mir.catch_body, ti, dest_alloc));
    IF mIRLowering__mir_allocates?(rtoc_self_view, right) THEN
      right = Emittable{ MIRBlockExpr: COPY TRY (mIRLowering__owned_branch_result_value(rtoc_self_view, right, ti, dest_alloc)) };
    END
    MUTABLE source_alloc: ?String@symbol = (IF mIRLowering__mir_owned_alloc(rtoc_self_view, mir.expr) != NIL THEN mIRLowering__mir_owned_alloc(rtoc_self_view, mir.expr) ELSE mIRLowering__mir_owned_alloc(rtoc_self_view, Emittable{ TryCatch: COPY mir }) END);
    IF ((source_alloc != NIL) AND (source_alloc != dest_alloc)) THEN
      MUTABLE tmp_id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_16 = mIRLowering__lowering_counters(rtoc_self_view);
      mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_16) };
      MUTABLE label = "__try_place_${tmp_id}";
      MUTABLE success = "__try_val_${tmp_id}";
      MUTABLE catch_break = BreakExpr{ label: label, value: COPY right, lowered_node_id: NIL, ownership_consumption: NIL };
      MUTABLE success_try = TryCatch{ expr: COPY mir.expr, catch_body: Emittable{ BreakExpr: COPY catch_break }, capture: COPY mir.capture, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
      success_try.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY ti }));
      MUTABLE success_cleanup = cleanupEntry__build(:uniform, source_alloc, FALSE);
      TRY (mIRLowering__build_drop_entry_mut(rtoc_self_view, &success_cleanup, ti, NIL));
      MUTABLE materialized = BindingMaterialization{ name: COPY success, expr: Emittable{ TryCatch: COPY success_try }, alloc: COPY source_alloc, type_info: COPY ti, mutable: FALSE, cleanup_entry: success_cleanup, annotation: NIL, suppression: NIL, cleanup_mode: :normal, scope: NIL, ownership_tracked: TRUE };
      MUTABLE body = TRY (bindingMaterialization__statements(materialized));
      &body.append(Stmt{ Emittable: COPY CAST(BreakStmt{ label: COPY label, value: COPY TRY (mIRLowering__place_owned_branch_value_for_destination(rtoc_self_view, Emittable{ Ident: COPY Ident{ name: success, lowered_node_id: NIL, ownership_consumption: NIL } }, ti, dest_alloc)), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) });
      MUTABLE out_block = MIRBlockExpr{ label: label, body: Body{ ArrayValue: body |> SELECT castStmtToLocatable(_) }, lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
      out_block.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY ti }));
      RETURN Emittable{ MIRBlockExpr: COPY out_block };
    END
    MUTABLE out = TryCatch{ expr: COPY mir.expr, catch_body: COPY right, capture: COPY mir.capture, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    out.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY ti }));
    RETURN Emittable{ TryCatch: COPY out };
}
END
FN mIRLowering__owned_branch_result_value(self: MIRLowering, mir: Emittable, ti: Type, dest_alloc: String@symbol) RETURNS !MIRBlockExpr
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE tmp_id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_17 = mIRLowering__lowering_counters(rtoc_self_view);
    mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_17) };
    MUTABLE label = "__owned_branch_${tmp_id}";
    MUTABLE name = "__owned_branch_val_${tmp_id}";
    MUTABLE materialized = BindingMaterialization{ name: COPY name, expr: COPY mir, alloc: COPY dest_alloc, type_info: COPY ti, mutable: FALSE, annotation: NIL, suppression: NIL, cleanup_entry: NIL, cleanup_mode: :normal, scope: NIL, ownership_tracked: TRUE };
    MUTABLE body: []Stmt = TRY (bindingMaterialization__statements(materialized));
    body = ruby_array_concat_Stmt(body, TRY (mIRLowering__ownership_transfer_marks(rtoc_self_view, name, :block_result, dest_alloc)));
    &body.append(Stmt{ Emittable: COPY CAST(BreakStmt{ label: COPY label, value: Emittable{ Ident: COPY Ident{ name: name, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) });
    MUTABLE out = MIRBlockExpr{ label: label, body: Body{ ArrayValue: body |> SELECT castStmtToLocatable(_) }, lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
    out.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY ti }));
    RETURN out;
}
END
FN mIRLowering__place_owned_alloc_mismatch_for_destination(self: MIRLowering, mir: Emittable, ti: Type, dest_alloc: String@symbol, source_alloc: String@symbol) RETURNS !Emittable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (IF mir IS_A Ident AS ident THEN mIRLowering__owned_binding_visible?(rtoc_self_view, ident.name) ELSE FALSE END) THEN
      RETURN TRY (mIRLowering__copy_owned_value_for_destination(rtoc_self_view, mir, ti, dest_alloc));
    END
    MUTABLE tmp_id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_18 = mIRLowering__lowering_counters(rtoc_self_view);
    mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_18) };
    MUTABLE label = "__owned_place_${tmp_id}";
    MUTABLE name = "__owned_val_${tmp_id}";
    MUTABLE cleanup = cleanupEntry__build(:uniform, source_alloc, FALSE);
    TRY (mIRLowering__build_drop_entry_mut(rtoc_self_view, &cleanup, ti, NIL));
    MUTABLE materialized = BindingMaterialization{ name: COPY name, expr: COPY mir, alloc: COPY source_alloc, type_info: COPY ti, mutable: FALSE, cleanup_entry: cleanup, annotation: NIL, suppression: NIL, cleanup_mode: :normal, scope: NIL, ownership_tracked: TRUE };
    MUTABLE body = TRY (bindingMaterialization__statements(materialized));
    &body.append(Stmt{ Emittable: COPY CAST(BreakStmt{ label: COPY label, value: COPY TRY (mIRLowering__place_owned_branch_value_for_destination(rtoc_self_view, Emittable{ Ident: COPY Ident{ name: name, lowered_node_id: NIL, ownership_consumption: NIL } }, ti, dest_alloc)), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) });
    MUTABLE out = MIRBlockExpr{ label: label, body: Body{ ArrayValue: body |> SELECT castStmtToLocatable(_) }, lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
    out.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY ti }));
    RETURN Emittable{ MIRBlockExpr: COPY out };
}
END
FN mIRLowering__retain_handle_for_destination(self: MIRLowering, mir: Emittable, ti: Type) RETURNS !?Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE payload = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_20: ?Type = NIL;
    IF type__optional?(ti) THEN
      rtoc_ternary_value_20 = TRY (type__wrapped_type(ti));
    ELSE
      rtoc_ternary_value_20 = ti;
    END
    rtoc_ternary_value_20 };
    IF !((IF payload != NIL THEN
      TRY (type__any_rc?(payload))
    ELSE
      NIL
    END)) THEN
      RETURN NIL;
    END
    MUTABLE fn: String = "";
    IF type__shared?(payload) THEN
      fn = "arcRetain";
    ELSE
      fn = "rcRetain";
    END
    MUTABLE zig = mIRLowering__rc_payload_zig_type(rtoc_self_view, payload);
    IF !(type__optional?(ti)) THEN
      RETURN Emittable{ RcRetain: COPY RcRetain{ source: COPY mir, zig_base: zig, func: fn, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    MUTABLE capture = "__retain_rc_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_21 = mIRLowering__lowering_counters(rtoc_self_view);
    mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_21) }}";
    MUTABLE retained = IfOptional{ optional: COPY mir, capture: capture, then_expr: Emittable{ RcRetain: COPY RcRetain{ source: Emittable{ Ident: COPY Ident{ name: capture, lowered_node_id: NIL, ownership_consumption: NIL } }, zig_base: zig, func: fn, lowered_node_id: NIL, ownership_consumption: NIL } }, else_expr: Emittable{ Lit: COPY Lit{ value: "null", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    retained.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY ti }));
    RETURN Emittable{ IfOptional: COPY retained };
}
END
FN mIRLowering__copy_owned_value_for_destination(self: MIRLowering, mir: Emittable, ti: Type, dest_alloc: String@symbol) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF TRY (type__string?(ti)) THEN
      RETURN Emittable{ DupeSlice: COPY DupeSlice{ source: COPY mir, alloc: COPY dest_alloc, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    MUTABLE retained: ?Emittable = TRY (mIRLowering__retain_handle_for_destination(rtoc_self_view, mir, ti));
    IF retained EXISTS AS retained_value THEN
      RETURN COPY retained_value;
    END
    RETURN Emittable{ DeepCopy: COPY DeepCopy{ source: COPY mir, zig_type: COPY TRY (type__zig_type(ti)), elem_type: NIL, strategy: :full_value, alloc: COPY dest_alloc, copy_shape: COPY deepCopy__copy_shape_for_zig_type(TRY (type__zig_type(ti))), type_info: COPY ti, lowered_node_id: NIL, ownership_consumption: NIL } };
}
END
FN mIRLowering__place_string_or_for_heap_destination(self: MIRLowering, mir: Emittable, ast_node: BinaryOp) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE left_t = TRY (type__from_node_mut(ast_node.left, "string OR destination left"));
    IF type__optional?(left_t) THEN
      RETURN TRY (mIRLowering__place_string_value_for_heap_destination(rtoc_self_view, mir, Locatable{ BinaryOp: COPY ast_node }));
    END
    IF mir IS_A TryCatch AS try_catch THEN
      MUTABLE try_catch_mutable = COPY try_catch;
      IF !(mIRLowering__heap_owned_result?(rtoc_self_view, tryCatch__expr(try_catch_mutable), ast_node.left)) THEN
        RETURN TRY (mIRLowering__place_string_value_for_heap_destination(rtoc_self_view, Emittable{ TryCatch: COPY try_catch_mutable }, Locatable{ BinaryOp: COPY ast_node }));
      END
      MUTABLE left = TRY (mIRLowering__place_or_branch_value_for_destination(rtoc_self_view, tryCatch__expr(try_catch_mutable), ast_node.left));
      MUTABLE right = TRY (mIRLowering__place_or_branch_value_for_destination(rtoc_self_view, try_catch_mutable.catch_body, ast_node.right));
      MUTABLE out = TryCatch{ expr: COPY left, catch_body: COPY right, capture: COPY try_catch_mutable.capture, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
      out.result_type = TRY (type__from_node_mut(ast_node, "string OR destination result"));
      RETURN Emittable{ TryCatch: COPY out };
    ELSE_IF mir IS_A Orelse AS orelse THEN
      MUTABLE orelse_mutable = COPY orelse;
      MUTABLE left = TRY (mIRLowering__place_or_branch_value_for_destination(rtoc_self_view, orelse__expr(orelse_mutable), ast_node.left));
      MUTABLE right = TRY (mIRLowering__place_or_branch_value_for_destination(rtoc_self_view, orelse_mutable.fallback, ast_node.right));
      MUTABLE out = Orelse{ expr: COPY left, fallback: COPY right, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
      out.result_type = TRY (type__from_node_mut(ast_node, "string OR destination result"));
      RETURN Emittable{ Orelse: COPY out };
    ELSE
      RETURN TRY (mIRLowering__place_string_value_for_heap_destination(rtoc_self_view, mir, Locatable{ BinaryOp: COPY ast_node }));
    END
}
END
FN mIRLowering__widen_symbol_to_bytes(self: MIRLowering, mir: Emittable, source_node: ?Locatable) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF source_node EXISTS AS source_node_value THEN
      MUTABLE ti = TRY (type__from_node_mut(source_node_value, "symbol widening"));
      IF !(type__symbol?(ti)) THEN
        RETURN COPY mir;
      END
      RETURN Emittable{ FieldGet: COPY FieldGet{ object: COPY mir, field: "bytes", lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE
      RETURN COPY mir;
    END
}
END
FN mIRLowering__place_owned_branch_value_for_destination(self: MIRLowering, mir: Emittable, dst_ti: Type, dest_alloc: String@symbol) RETURNS !Emittable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF mir IS_A Orelse AS orelse THEN
      RETURN TRY (mIRLowering__place_owned_orelse_for_destination(rtoc_self_view, orelse, dst_ti, dest_alloc));
    END
    IF mir IS_A MIRBlockExpr AS mir_block_expr THEN
      RETURN Emittable{ MIRBlockExpr: COPY TRY (mIRLowering__copy_lazy_owned_branch_for_destination(rtoc_self_view, Emittable{ MIRBlockExpr: COPY mir_block_expr }, dst_ti, dest_alloc)) };
    END
    MUTABLE owned_alloc: ?String@symbol = mIRLowering__mir_owned_alloc(rtoc_self_view, mir);
    IF (owned_alloc == dest_alloc) THEN
      IF mir IS_A Ident AS ident THEN
        RETURN TRY (mIRLowering__transfer_owned_branch_binding(rtoc_self_view, Emittable{ Ident: COPY ident }, dst_ti, dest_alloc));
      END
      IF mIRLowering__mir_allocates?(rtoc_self_view, mir) THEN
        RETURN Emittable{ MIRBlockExpr: COPY TRY (mIRLowering__owned_branch_result_value(rtoc_self_view, mir, dst_ti, dest_alloc)) };
      END
    END
    IF owned_alloc EXISTS AS owned_alloc_value THEN
      RETURN TRY (mIRLowering__place_owned_alloc_mismatch_for_destination(rtoc_self_view, mir, dst_ti, dest_alloc, owned_alloc_value));
    END
    IF TRY (type__string?(dst_ti)) THEN
      RETURN Emittable{ DupeSlice: COPY DupeSlice{ source: COPY mir, alloc: COPY dest_alloc, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    MUTABLE retained: ?Emittable = TRY (mIRLowering__retain_handle_for_destination(rtoc_self_view, mir, dst_ti));
    IF retained EXISTS AS retained_value THEN
      RETURN COPY retained_value;
    END
    IF mIRLowering__mir_allocates?(rtoc_self_view, mir) THEN
      RETURN Emittable{ MIRBlockExpr: COPY TRY (mIRLowering__copy_lazy_owned_branch_for_destination(rtoc_self_view, mir, dst_ti, dest_alloc)) };
    END
    RETURN Emittable{ DeepCopy: COPY DeepCopy{ source: COPY mir, zig_type: COPY TRY (type__zig_type(dst_ti)), elem_type: NIL, strategy: :full_value, alloc: COPY dest_alloc, copy_shape: COPY deepCopy__copy_shape_for_zig_type(TRY (type__zig_type(dst_ti))), type_info: COPY dst_ti, lowered_node_id: NIL, ownership_consumption: NIL } };
}
END
FN mIRLowering__claim_block_result_ownership_mut(self: MIRLowering, mir: Emittable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF mir IS_A MIRBlockExpr AS mir_block_expr THEN
      MUTABLE mir_block_expr_mutable = COPY mir_block_expr;
      IF blockExpr__body(mir_block_expr_mutable) |> ANY (_ IS_A TransferMark AND (_.target() == :block_result)) THEN
        RETURN TRUE;
      END
      MUTABLE break_index = blockExpr__body(mir_block_expr_mutable).rindex(%(stmt) -> stmt IS_A BreakStmt);
      IF !(break_index) THEN
        RETURN FALSE;
      END
      MUTABLE owner: ?String = COPY (mIRLowering__mir_ident_names(rtoc_self_view, (CAST(blockExpr__body(mir_block_expr_mutable).substr(break_index, 1) AS BreakStmt)).value)).first();
      IF owner EXISTS AS owner_value THEN
        MUTABLE owner_value_mutable = COPY owner_value;
        MUTABLE cleanup = blockExpr__body(mir_block_expr_mutable) |> FIND ((_ IS_A Cleanup AND (CAST(_.name() AS String) == owner_value_mutable)) AND ((ownedCompositeMaterialization__cleanup_entry(_) != NIL) AND ((ownedCompositeMaterialization__cleanup_entry(_))?)[:has_moved_guard]));
        IF !(cleanup) THEN
          RETURN FALSE;
        END
        MUTABLE rtoc_index_receiver_22 = blockExpr__body(mir_block_expr_mutable);
        rtoc_index_receiver_22[break_index] = TRY (mIRLowering__ownership_transfer_marks(rtoc_self_view, owner_value_mutable, :block_result, NIL, TRUE));
        RETURN TRUE;
      ELSE
        RETURN FALSE;
      END
    ELSE
      RETURN FALSE;
    END
}
END
FN mIRLowering__owned_branch_source_owns?(self: MIRLowering, mir: Emittable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE result = COPY mir;
    IF mir IS_A MIRBlockExpr AS mir_block_expr THEN
      MUTABLE tail: ?Emittable = blockExpr__body(mir_block_expr).reverse() |> FIND _ IS_A BreakStmt;
      IF tail EXISTS AS tail_value THEN
        IF tail_value IS_A BreakStmt AS break_stmt THEN
          result = COPY break_stmt.value;
        END
      END
    END
    IF result IS_A Ident AS ident THEN
      RETURN TRUE;
    END
    IF ownershipEffect__of(result).produces_owned THEN
      RETURN TRUE;
    END
    RETURN result.materializes_value?();
}
END
FN mIRLowering__copy_lazy_owned_branch_for_destination(self: MIRLowering, mir: Emittable, type_info: Type, dest_alloc: String@symbol) RETURNS !MIRBlockExpr
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE tmp_id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_23 = mIRLowering__lowering_counters(rtoc_self_view);
    mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_23) };
    MUTABLE label = "__owned_branch_copy_${tmp_id}";
    MUTABLE source_name = "__owned_branch_src_${tmp_id}";
    MUTABLE copy_name = "__owned_branch_copy_val_${tmp_id}";
    MUTABLE claimed = TRY (mIRLowering__claim_block_result_ownership_mut(rtoc_self_view, mir));
    MUTABLE source_alloc = ((IF mIRLowering__mir_owned_alloc(rtoc_self_view, mir) != NIL THEN mIRLowering__mir_owned_alloc(rtoc_self_view, mir) ELSE ownershipEffect__alloc_of(mir) END) OR_ELSE dest_alloc);
    MUTABLE source_owned = (claimed OR mIRLowering__owned_branch_source_owns?(rtoc_self_view, mir));
    MUTABLE source_cleanup = NIL;
    IF source_owned THEN
      source_cleanup = cleanupEntry__build(:uniform, source_alloc, FALSE, NIL, TRY (type__zig_type(type_info)));
      TRY (mIRLowering__build_drop_entry_mut(rtoc_self_view, &source_cleanup, type_info, NIL));
    END
    MUTABLE source = BindingMaterialization{ name: COPY source_name, expr: COPY mir, alloc: COPY source_alloc, type_info: COPY type_info, mutable: FALSE, cleanup_entry: source_cleanup, ownership_tracked: source_owned, annotation: NIL, suppression: NIL, cleanup_mode: :normal, scope: NIL };
    MUTABLE copied_expr = (TRY (mIRLowering__retain_handle_for_destination(rtoc_self_view, Emittable{ Ident: COPY Ident{ name: source_name, lowered_node_id: NIL, ownership_consumption: NIL } }, type_info)) OR_ELSE Emittable{ DeepCopy: COPY DeepCopy{ source: Emittable{ Ident: COPY Ident{ name: source_name, lowered_node_id: NIL, ownership_consumption: NIL } }, zig_type: COPY TRY (type__zig_type(type_info)), elem_type: NIL, strategy: :full_value, alloc: COPY dest_alloc, copy_shape: COPY deepCopy__copy_shape_for_zig_type(TRY (type__zig_type(type_info))), type_info: COPY type_info, lowered_node_id: NIL, ownership_consumption: NIL } });
    MUTABLE copy_cleanup = cleanupEntry__build(:uniform, dest_alloc, TRUE, NIL, TRY (type__zig_type(type_info)));
    TRY (mIRLowering__build_drop_entry_mut(rtoc_self_view, &copy_cleanup, type_info, NIL));
    MUTABLE copied = BindingMaterialization{ name: COPY copy_name, expr: COPY copied_expr, alloc: COPY dest_alloc, type_info: COPY type_info, mutable: FALSE, cleanup_entry: copy_cleanup, cleanup_mode: :err, annotation: NIL, suppression: NIL, scope: NIL, ownership_tracked: TRUE };
    MUTABLE body: []Stmt = (TRY (bindingMaterialization__statements(source)) + TRY (bindingMaterialization__statements(copied)));
    body = ruby_array_concat_Stmt(body, TRY (mIRLowering__ownership_transfer_marks(rtoc_self_view, copy_name, :block_result, dest_alloc, TRUE)));
    &body.append(Stmt{ Emittable: COPY CAST(BreakStmt{ label: COPY label, value: Emittable{ Ident: COPY Ident{ name: copy_name, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) });
    MUTABLE out = MIRBlockExpr{ label: label, body: Body{ ArrayValue: body |> SELECT castStmtToLocatable(_) }, lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
    out.lazy_boundary = TRUE;
    out.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY type_info }));
    RETURN out;
}
END
FN mIRLowering__transfer_owned_branch_binding(self: MIRLowering, mir: Emittable, type_info: Type, dest_alloc: String@symbol) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF mir IS_A Ident AS ident THEN
      MUTABLE ident_mutable = COPY ident;
      MUTABLE name = COPY ident_mutable.name;
      IF (mIRLowering__function_state(rtoc_self_view).current_reassignment_target == name) THEN
        RETURN COPY Emittable{ Ident: COPY ident_mutable };
      END
      MUTABLE entry = ((TRY (functionState__bindings(mIRLowering__function_state(rtoc_self_view))))[name] OR_ELSE new());
      MUTABLE plan = entry.lifecycle_plan();
      IF !((cleanupEntry__present?(entry) AND ((plan != NIL) AND lifecyclePlan__needs_drop?((plan?))))) THEN
        RETURN COPY Emittable{ Ident: COPY ident_mutable };
      END
      cleanupEntry__mark_moved_guard_mut(&entry);
      mIRLowering__mark_guarded_cleanup_name_mut(rtoc_self_view, name);
      MUTABLE label = "__owned_branch_transfer_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_24 = mIRLowering__lowering_counters(rtoc_self_view);
      mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_24) }}";
      MUTABLE body = TRY (mIRLowering__ownership_transfer_marks(rtoc_self_view, name, :block_result, dest_alloc, TRUE));
      &body.append(Stmt{ Emittable: COPY CAST(BreakStmt{ label: COPY label, value: Emittable{ Ident: COPY ident_mutable }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) });
      MUTABLE result = MIRBlockExpr{ label: label, body: Body{ ArrayValue: body |> SELECT castStmtToLocatable(_) }, lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
      result.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY type_info }));
      RETURN Emittable{ MIRBlockExpr: COPY result };
    ELSE
      RETURN COPY mir;
    END
}
END
FN mIRLowering__place_or_branch_value_for_destination(self: MIRLowering, mir: Emittable, ast_node: Locatable) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE placed = TRY (mIRLowering__place_string_value_for_heap_destination(rtoc_self_view, mir, ast_node));
    IF !(mIRLowering__mir_allocates?(rtoc_self_view, placed)) THEN
      RETURN placed;
    END
    RETURN Emittable{ MIRBlockExpr: COPY TRY (mIRLowering__scoped_owning_branch_value(rtoc_self_view, placed, ast_node)) };
}
END
FN mIRLowering__place_string_value_for_heap_destination(self: MIRLowering, mir_input: Emittable, ast_node: Locatable) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE mir = COPY mir_input;
    IF mIRLowering__heap_owned_result?(rtoc_self_view, Emittable{ TryExpr: COPY mir }, ast_node) THEN
      RETURN COPY Emittable{ TryExpr: COPY mir };
    END
    IF type__error_union?((TRY (type__from_node_mut(ast_node, "heap destination placement")))) THEN
      mir = TryExpr{ expr: Emittable{ TryExpr: COPY mir }, lowered_node_id: NIL, ownership_consumption: NIL };
    END
    RETURN Emittable{ DupeSlice: COPY DupeSlice{ source: Emittable{ TryExpr: COPY mir }, alloc: :heap, lowered_node_id: NIL, ownership_consumption: NIL } };
}
END
FN mIRLowering__place_string_value_for_destination(self: MIRLowering, mir_input: Emittable, ast_node: Locatable, dest_alloc: String@symbol) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE mir = COPY mir_input;
    MUTABLE effect = ownershipEffect__of(Emittable{ TryExpr: COPY mir });
    IF effect.produces_owned THEN
      MUTABLE source_alloc: ?String@symbol = COPY effect.alloc;
      IF (source_alloc == dest_alloc) THEN
        RETURN COPY Emittable{ TryExpr: COPY mir };
      END
      IF source_alloc EXISTS AS source_alloc_value THEN
        RETURN TRY (mIRLowering__place_owned_alloc_mismatch_for_destination(rtoc_self_view, Emittable{ TryExpr: COPY mir }, TRY (type__from_node_mut(ast_node, "string destination placement")), dest_alloc, source_alloc_value));
      END
    END
    IF placement__heap?(dest_alloc) THEN
      RETURN TRY (mIRLowering__place_string_value_for_heap_destination(rtoc_self_view, Emittable{ TryExpr: COPY mir }, ast_node));
    END
    IF type__error_union?((TRY (type__from_node_mut(ast_node, "string destination placement")))) THEN
      mir = TryExpr{ expr: Emittable{ TryExpr: COPY mir }, lowered_node_id: NIL, ownership_consumption: NIL };
    END
    RETURN Emittable{ DupeSlice: COPY DupeSlice{ source: Emittable{ TryExpr: COPY mir }, alloc: COPY dest_alloc, lowered_node_id: NIL, ownership_consumption: NIL } };
}
END
FN mIRLowering__escaping_value_alloc(self: MIRLowering, type_info: ?Type) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE ti: ?Type = NIL;
    IF type_info != NIL THEN
      ti = COPY TRY (type__success_type((type_info?)));
    END
    IF ((ti != NIL) AND mIRLowering__ownership_bearing_type?(rtoc_self_view, ti)) THEN
      RETURN :heap;
    END
    RETURN NIL;
}
END
FN mIRLowering__active_tag_call(self: MIRLowering, value: Emittable) RETURNS !Call
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN Call{ callee: "std.meta.activeTag", args: [value], try_wrap: FALSE, owned_return: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(1)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL };
}
END
FN mIRLowering__alloc_mark_type_info(self: MIRLowering, expr: Emittable, ast_node: Locatable, context: String) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE ti = TRY (type__from_node_mut(ast_node, context));
    IF expr IS_A DeepCopy AS deep_copy THEN
    IF (deep_copy.zig_type OR_ELSE "").startsWith?("*") THEN
        IF TRY (type__heap_ptr?(ti)) THEN
          RETURN ti;
        END
        RETURN TRY (type__new(TypeConstructionInput{ Type: COPY ti }, NIL, NIL, :indirect));
      ELSE
        RETURN ti;
      END
    ELSE
      RETURN ti;
    END
}
END
FN mIRLowering__return_destination_alloc(self: MIRLowering, node: ReturnNode) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(node.value) THEN
      RETURN NIL;
    END
    MUTABLE value_type = TRY (type__from_node_mut(node.value, "return destination allocation"));
    MUTABLE declared_type: ?Type@multiowned = mIRLowering__return_value_destination_type(rtoc_self_view, node);
    IF mIRLowering__current_function_heap_carry_return?(rtoc_self_view) THEN
      IF ((declared_type != NIL) AND mIRLowering__ownership_bearing_type?(rtoc_self_view, TRY (type__success_type(declared_type)))) THEN
        RETURN :heap;
      END
      RETURN mIRLowering__escaping_value_alloc(rtoc_self_view, value_type);
    END
    MUTABLE borrowed_owned = (mIRLowering__ownership_bearing_type?(rtoc_self_view, TRY (type__success_type(value_type))) OR (((declared_type != NIL) AND mIRLowering__ownership_bearing_type?(rtoc_self_view, TRY (type__success_type(declared_type))))));
    IF (TRY (mIRLowering__borrowed_destination_node?(rtoc_self_view, node.value)) AND borrowed_owned) THEN
      RETURN :heap;
    END
    RETURN NIL;
}
END
FN mIRLowering__scoped_owning_branch_value(self: MIRLowering, mir: Emittable, ast_node: Locatable) RETURNS !MIRBlockExpr
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE block_id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_25 = mIRLowering__lowering_counters(rtoc_self_view);
    mIRLoweringCounters__next_block_expr_id(&rtoc_mutable_receiver_25) };
    MUTABLE tmp_id = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_26 = mIRLowering__lowering_counters(rtoc_self_view);
    mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_26) };
    MUTABLE label = "__own_branch_${block_id}";
    MUTABLE name = "__tmp_${tmp_id}";
    MUTABLE type_info = TRY (mIRLowering__alloc_mark_type_info(rtoc_self_view, mir, ast_node, "branch ownership placement"));
    MUTABLE entry: ?CleanupEntry@multiowned = mIRLowering__hoist_cleanup_entry(rtoc_self_view, mir, ast_node);
    IF entry EXISTS AS entry_value THEN
      MUTABLE entry_value_mutable = COPY entry_value;
      cleanupEntry__mark_moved_guard_mut(&entry_value_mutable);
    END
    MUTABLE materialized = BindingMaterialization{ name: COPY name, expr: COPY mir, alloc: :heap, type_info: CAST(COPY type_info AS Type), mutable: FALSE, cleanup_entry: entry, cleanup_mode: IF entry != NIL THEN
      :err
    ELSE
      :normal
    END, scope: :heap, annotation: NIL, suppression: NIL, ownership_tracked: TRUE };
    MUTABLE body: []Stmt = TRY (bindingMaterialization__statements(materialized));
    IF entry EXISTS AS entry_value THEN
      body = ruby_array_concat_Stmt(body, TRY (mIRLowering__ownership_transfer_marks(rtoc_self_view, name, :block_result, NIL, TRUE)));
    END
    &body.append(Stmt{ Emittable: COPY CAST(BreakStmt{ label: COPY label, value: Emittable{ Ident: COPY Ident{ name: name, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) });
    MUTABLE out = MIRBlockExpr{ label: label, body: Body{ ArrayValue: body |> SELECT castStmtToLocatable(_) }, lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
    out.result_type = CAST(type_info AS ?Type);
    RETURN out;
}
END
FN mIRLowering__heap_owned_result?(self: MIRLowering, mir: Emittable, ast_node: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE effect = ownershipEffect__of(mir);
    IF (effect.produces_owned AND placement__heap?(effect.alloc)) THEN
      RETURN TRUE;
    END
    MUTABLE node = COPY ast_node;
    IF node IS_A MoveNode AS move_node THEN
      MUTABLE move_node = move_node.value;
    END
    IF (IF node IS_A Identifier AS identifier THEN aST__moved?(ast_node) ELSE FALSE END) THEN
      RETURN (mIRLowering__placement_for_node(rtoc_self_view, node) == :heap);
    END
    RETURN !(!(((IF node IS_A Identifier AS identifier THEN ((identifier.symbol != NIL) AND ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_27 = ((identifier.symbol)?);
    symbolEntry__heap_storage?(rtoc_local_receiver_27) } == TRUE)) ELSE FALSE END))));
}
END
PUB FN mIRLowering__lower(MUTABLE self: MIRLowering, MUTABLE node: MIRLoweringLowerableStmt) RETURNS !?Emittable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE mir = PARTIAL MATCH node START
      MIRLoweringLowerableStmt.ASTProgram AS ast_program -> TRY (mIRLowering__lower_program(&rtoc_self_view, ast_program)),
      MIRLoweringLowerableStmt.ImplementationDef AS implementation_def -> NIL,
      MIRLoweringLowerableStmt.ConformanceDef AS conformance_def -> NIL,
      MIRLoweringLowerableStmt.ProtocolDef AS protocol_def -> NIL,
      MIRLoweringLowerableStmt.Drop AS drop -> TRY (mIRLowering__lower_drop(rtoc_self_view, drop)),
      MIRLoweringLowerableStmt.AllocMark AS alloc_mark -> {
        MUTABLE rtoc_value_block_marker = 0;
        mIRLowering__function_state(rtoc_self_view).lowered_alloc_names.insert(COPY alloc_mark.name);
        alloc_mark
      },
      MIRLoweringLowerableStmt.SuppressCleanup AS suppress_cleanup -> {
        MUTABLE rtoc_value_block_marker = 0;
        MUTABLE safe = mIRLowering__zig_safe_name(rtoc_self_view, suppress_cleanup.name);
        (IF mIRLowering__pipeline_guarded_cleanup_name?(rtoc_self_view, safe) THEN
          TRY (mIRLowering__ownership_transfer_marks(rtoc_self_view, safe, :owned_sink, :heap, TRUE))
        ELSE
          List[]
        END)
      },
      MIRLoweringLowerableStmt.Return AS return -> {
        MUTABLE rtoc_value_block_marker = 0;
        MUTABLE rename_map = TRY (functionState__rename_map(mIRLowering__function_state(rtoc_self_view)));
        MUTABLE escaped = return.escaped_vars |> SELECT {
        MUTABLE escaped_safe_name = mIRLowering__zig_safe_name(rtoc_self_view, _);
        (rename_map[escaped_safe_name] OR_ELSE escaped_safe_name)
      };
        ReturnMark{ escaped_vars: escaped, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }
      },
      MIRLoweringLowerableStmt.ReassignCleanup AS reassign_cleanup -> ReassignMark{ name: COPY reassign_cleanup.name, alloc: COPY reassign_cleanup.alloc, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL },
      MIRLoweringLowerableStmt.FieldCleanup AS field_cleanup -> FieldCleanupMark{ target_name: COPY field_cleanup.target_name, field: COPY field_cleanup.field, alloc: COPY field_cleanup.alloc, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL },
      AST.EnumDef -> mIRLowering__lower_enum_def(rtoc_self_view, node),
      MIRLoweringLowerableStmt.UnionDef AS union_def -> TRY (mIRLowering__lower_union_def(rtoc_self_view, union_def)),
      AST.StructDef -> TRY (mIRLowering__lower_struct_def(&rtoc_self_view, node)),
      MIRLoweringLowerableStmt.ExternFnDecl AS extern_fn_decl -> mIRLowering__lower_extern_fn(rtoc_self_view, extern_fn_decl),
      MIRLoweringLowerableStmt.ExternStructDecl AS extern_struct_decl -> mIRLowering__lower_extern_struct(rtoc_self_view, extern_struct_decl),
      MIRLoweringLowerableStmt.VarDecl AS var_decl -> mIRLowering__lower_var_decl(&rtoc_self_view, var_decl),
      MIRLoweringLowerableStmt.BindExpr AS bind_expr -> mIRLowering__lower_bind_expr(&rtoc_self_view, &bind_expr),
      MIRLoweringLowerableStmt.Assignment AS assignment -> mIRLowering__lower_assignment(&rtoc_self_view, assignment),
      MIRLoweringLowerableStmt.DestructuringAssignment AS destructuring_assignment -> mIRLowering__lower_destructuring_assignment(&rtoc_self_view, destructuring_assignment),
      MIRLoweringLowerableStmt.IfStatement AS if_statement -> mIRLowering__lower_if(&rtoc_self_view, if_statement),
      MIRLoweringLowerableStmt.IsA AS is_a -> mIRLowering__lower_is_a(&rtoc_self_view, is_a),
      MIRLoweringLowerableStmt.IfBind AS if_bind -> mIRLowering__lower_if_bind(&rtoc_self_view, if_bind),
      MIRLoweringLowerableStmt.WhileLoop AS while_loop -> mIRLowering__lower_while(&rtoc_self_view, while_loop),
      MIRLoweringLowerableStmt.WhileBindLoop AS while_bind_loop -> mIRLowering__lower_while_bind(&rtoc_self_view, while_bind_loop),
      MIRLoweringLowerableStmt.ForEach AS for_each -> mIRLowering__lower_for_each(&rtoc_self_view, for_each),
      MIRLoweringLowerableStmt.ForRange AS for_range -> mIRLowering__lower_for_range(&rtoc_self_view, for_range),
      MIRLoweringLowerableStmt.MatchStatement AS match_statement -> mIRLowering__lower_match(&rtoc_self_view, match_statement),
      MIRLoweringLowerableStmt.ReturnNode AS return_node -> mIRLowering__lower_return(&rtoc_self_view, return_node),
      MIRLoweringLowerableStmt.BreakNode AS break_node -> BreakStmt{ label: NIL, value: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL },
      AST.OrElseBreak -> BreakStmt{ label: NIL, value: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL },
      MIRLoweringLowerableStmt.ContinueNode AS continue_node -> ContinueStmt{ unused: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL },
      MIRLoweringLowerableStmt.PassStmt AS pass_stmt -> Noop{ reason: "pass", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL },
      AST.DeferStmt -> TRY (mIRLowering__lower_defer_stmt(&rtoc_self_view, node)),
      MIRLoweringLowerableStmt.FunctionDefMultiowned AS function_def_multiowned -> mIRLowering__lower_function_def(&rtoc_self_view, CAST(COPY function_def_multiowned AS FunctionDef)),
      MIRLoweringLowerableStmt.FuncCall AS func_call -> mIRLowering__lower_func_call(&rtoc_self_view, func_call),
      AST.MethodCall -> mIRLowering__lower_method_call(&rtoc_self_view, node),
      MIRLoweringLowerableStmt.LambdaLit AS lambda_lit -> mIRLowering__lower_lambda(&rtoc_self_view, &lambda_lit),
      MIRLoweringLowerableStmt.ListLit AS list_lit -> mIRLowering__lower_list_lit(&rtoc_self_view, &list_lit),
      MIRLoweringLowerableStmt.TupleLit AS tuple_lit -> mIRLowering__lower_tuple_lit(&rtoc_self_view, &tuple_lit),
      MIRLoweringLowerableStmt.DefaultArrayLit AS default_array_lit -> mIRLowering__lower_default_array_lit(rtoc_self_view, &default_array_lit),
      MIRLoweringLowerableStmt.HashLit AS hash_lit -> mIRLowering__lower_hash_lit(&rtoc_self_view, hash_lit),
      MIRLoweringLowerableStmt.Literal AS literal -> mIRLowering__lower_literal(rtoc_self_view, literal),
      MIRLoweringLowerableStmt.DefaultLit AS default_lit -> DefaultValue{ kind: :aggregate_empty, zig_type: NIL },
      MIRLoweringLowerableStmt.Identifier AS identifier -> mIRLowering__lower_identifier(rtoc_self_view, &identifier),
      MIRLoweringLowerableStmt.BinaryOp AS binary_op -> mIRLowering__lower_binary_op(&rtoc_self_view, binary_op),
      AST.UnaryOp -> mIRLowering__lower_unary_op(&rtoc_self_view, node),
      MIRLoweringLowerableStmt.GetField AS get_field -> mIRLowering__lower_get_field(&rtoc_self_view, &get_field),
      MIRLoweringLowerableStmt.GetIndex AS get_index -> mIRLowering__lower_get_index(&rtoc_self_view, &get_index),
      MIRLoweringLowerableStmt.StructLit AS struct_lit -> mIRLowering__lower_struct_lit(&rtoc_self_view, struct_lit),
      MIRLoweringLowerableStmt.UnionVariantLit AS union_variant_lit -> mIRLowering__lower_union_variant_lit(&rtoc_self_view, union_variant_lit),
      MIRLoweringLowerableStmt.StringConcat AS string_concat -> mIRLowering__lower_string_concat(&rtoc_self_view, string_concat),
      blockexpr -> mIRLowering__lower_block_expr(&rtoc_self_view, node),
      AST.RangeLit -> mIRLowering__lower_range_lit(&rtoc_self_view, &node),
      AST.OptionalUnwrap -> mIRLowering__lower_optional_unwrap(&rtoc_self_view, node),
      MIRLoweringLowerableStmt.Assert AS assert -> mIRLowering__lower_assert(&rtoc_self_view, assert),
      raise_value -> mIRLowering__lower_raise(&rtoc_self_view, node),
      AST.Cast -> TRY (mIRLowering__lower_cast(&rtoc_self_view, node)),
      MIRLoweringLowerableStmt.ThrowNode AS throw_node -> ReturnStmt{ value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "error", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "CheatError", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL },
      MIRLoweringLowerableStmt.DieNode AS die_node -> ExprStmt{ expr: Emittable{ Call: COPY Call{ callee: "std.process.exit", args: [Emittable{ Lit: COPY Lit{ value: COPY CAST(((die_node.status OR 1)) AS String), lowered_node_id: NIL, ownership_consumption: NIL } }], try_wrap: FALSE, owned_return: FALSE, callable_contract: NIL, lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL },
      MIRLoweringLowerableStmt.CopyNode AS copy_node -> mIRLowering__lower_copy(&rtoc_self_view, &copy_node),
      MIRLoweringLowerableStmt.KeepNode AS keep_node -> mIRLowering__lower_clone(&rtoc_self_view, keep_node),
      MIRLoweringLowerableStmt.MoveNode AS move_node -> mIRLowering__lower_move(&rtoc_self_view, move_node),
      MIRLoweringLowerableStmt.ShareNode AS share_node -> mIRLowering__lower_share(&rtoc_self_view, share_node),
      MIRLoweringLowerableStmt.CapabilityWrap AS capability_wrap -> mIRLowering__lower_cap_wrap(&rtoc_self_view, &capability_wrap),
      MIRLoweringLowerableStmt.LinkNode AS link_node -> mIRLowering__lower_link(&rtoc_self_view, link_node),
      MIRLoweringLowerableStmt.ResolveNode AS resolve_node -> mIRLowering__lower_resolve(&rtoc_self_view, resolve_node),
      MIRLoweringLowerableStmt.FreezeNode AS freeze_node -> mIRLowering__lower_freeze(&rtoc_self_view, freeze_node),
      MIRLoweringLowerableStmt.Copy AS copy -> TRY (mIRLowering__lower(&rtoc_self_view, copy.value)),
      MIRLoweringLowerableStmt.Slice AS slice -> mIRLowering__lower_slice(&rtoc_self_view, slice),
      AST.BgBlock -> mIRLowering__lower_bg_block(&rtoc_self_view, node),
      MIRLoweringLowerableStmt.BgStreamBlock AS bg_stream_block -> mIRLowering__lower_bg_stream_block(&rtoc_self_view, &bg_stream_block),
      MIRLoweringLowerableStmt.WithBlockMultiowned AS with_block_multiowned -> mIRLowering__lower_with_block(&rtoc_self_view, CAST(COPY with_block_multiowned AS WithBlock)),
      doblock -> mIRLowering__lower_do_block(&rtoc_self_view, node),
      MIRLoweringLowerableStmt.TestBlock AS test_block -> mIRLowering__lower_test_block(&rtoc_self_view, test_block),
      MIRLoweringLowerableStmt.RequireNode AS require_node -> TRY (mIRLowering__lower_require(&rtoc_self_view, require_node)),
      MIRLoweringLowerableStmt.YieldExpr AS yield_expr -> mIRLowering__lower_yield(&rtoc_self_view, yield_expr),
      MIRLoweringLowerableStmt.CloseStream AS close_stream -> mIRLowering__lower_close_stream(rtoc_self_view, close_stream),
      MIRLoweringLowerableStmt.NextExpr AS next_expr -> mIRLowering__lower_next_expr(&rtoc_self_view, next_expr),
      MIRLoweringLowerableStmt.StaticCall AS static_call -> TRY (mIRLowering__lower_static_call(&rtoc_self_view, static_call)),
      AST.OrElseRaise -> FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "error", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "OrElseRaise", lowered_node_id: NIL, ownership_consumption: NIL },
      AST.OrElsePass -> DefaultValue{ kind: :undefined, zig_type: NIL },
      AST.OrElsePrune -> DefaultValue{ kind: :undefined, zig_type: NIL },
      AST.OrElseExit -> TRY (mIRLowering__lower_or_else_exit(&rtoc_self_view, node)),
      MIRLoweringLowerableStmt.ThenChain AS then_chain -> panic("Internal: ThenChain should be flattened by BgBlock lowering"),
      MIRLoweringLowerableStmt.AssertRaisesMultiowned AS assert_raises_multiowned -> mIRLowering__lower_assert_raises(&rtoc_self_view, CAST(COPY assert_raises_multiowned AS AssertRaises)),
      MIRLoweringLowerableStmt.StubDecl AS stub_decl -> mIRLowering__lower_stub_decl(&rtoc_self_view, stub_decl),
      MIRLoweringLowerableStmt.BenchmarkStmtMultiowned AS benchmark_stmt_multiowned -> mIRLowering__lower_benchmark(rtoc_self_view, CAST(COPY benchmark_stmt_multiowned AS BenchmarkStmt)),
      MIRLoweringLowerableStmt.SmashStmtMultiowned AS smash_stmt_multiowned -> mIRLowering__lower_smash(rtoc_self_view, CAST(COPY smash_stmt_multiowned AS SmashStmt)),
      MIRLoweringLowerableStmt.ProfileStmtMultiowned AS profile_stmt_multiowned -> mIRLowering__lower_profile(rtoc_self_view, CAST(COPY profile_stmt_multiowned AS ProfileStmt)),
      DEFAULT -> panic("MIRLowering: unhandled node type {} at {}")
    END;
    IF node IS_A Locatable AS locatable THEN
      MUTABLE locatable_mutable = COPY locatable;
      RETURN TRY (mIRLowering__apply_lowered_coercion(rtoc_self_view, mir, &locatable_mutable));
    ELSE
      RETURN mir;
    END
}
END
FN mIRLowering__apply_lowered_coercion(self: MIRLowering, mir: ?MIRLoweringLoweredMir, MUTABLE node: Locatable) RETURNS !?MIRLoweringLoweredMir
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((((mir != NIL) AND respondsTo?(node, "coerced_type")) AND node.coerced_type())) THEN
      RETURN COPY mir;
    END
    MUTABLE coerced_type = TRY (type__new((node.coerced_type_info() OR node.coerced_type())));
    IF !(node.typed?()) THEN
      RETURN COPY mir;
    END
    MUTABLE actual_type = TRY (aST__full_type_mut(node));
    IF (type__semantic_type_key(coerced_type) == type__semantic_type_key(actual_type)) THEN
      RETURN COPY mir;
    END
    IF mIRLowering__stack_fixed_array_coercion?(rtoc_self_view, &node) THEN
      RETURN COPY mir;
    END
    IF !(((mir != NIL) AND (mir IS_A Emittable))) THEN
      RETURN COPY mir;
    END
    IF (TRY (type__node_reference?(coerced_type)) AND TRY (type__node_reference?(actual_type))) THEN
      RETURN COPY mir;
    END
    IF mIRLowering__carrier_only_coercion?(rtoc_self_view, actual_type, coerced_type) THEN
      RETURN COPY mir;
    END
    IF (TRY (type__node_reference?(coerced_type)) AND !(TRY (type__node_reference?(actual_type)))) THEN
      IF (actual_type.resolved() == symbol("NIL")) THEN
        RETURN MIRLoweringLoweredMir{ Emittable: COPY CAST(StructInit{ zig_type: TRY (type__zig_type(coerced_type)), fields: ( { MUTABLE rtoc_empty_list_28: []Any = List[]; rtoc_empty_list_28 } ), lowered_node_id: NIL, ownership_consumption: NIL } AS Emittable) };
      END
      RETURN MIRLoweringLoweredMir{ Emittable: COPY CAST(TRY (mIRLowering__node_create_mir(rtoc_self_view, mir, coerced_type, node)) AS Emittable) };
    END
    MUTABLE union_wrapped: ?Emittable = TRY (mIRLowering__lower_union_payload_coercion(rtoc_self_view, mir, node, actual_type, coerced_type));
    IF union_wrapped EXISTS AS union_wrapped_value THEN
      RETURN MIRLoweringLoweredMir{ Emittable: COPY union_wrapped_value };
    END
    IF TRY (mIRLowering__mir_cast(rtoc_self_view, mir, actual_type, TypeTypeInput{ Type: COPY coerced_type })) != NIL THEN
    RETURN ruby_wrap_optional_Emittable_MIRLoweringLoweredMir(TRY (mIRLowering__mir_cast(rtoc_self_view, mir, actual_type, TypeTypeInput{ Type: COPY coerced_type })));
    ELSE
    RETURN COPY mir;
    END
}
END
FN mIRLowering__carrier_only_coercion?(self: MIRLowering, actual_type: Type, coerced_type: Type) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE coerced_payload = TRY (type__non_optional_type(coerced_type));
    MUTABLE actual_payload = TRY (type__non_optional_type(actual_type));
    IF !((TRY (type__any_rc?(coerced_payload)) OR type__any_sync?(coerced_payload))) THEN
      RETURN FALSE;
    END
    IF (TRY (type__any_rc?(actual_payload)) OR type__any_sync?(actual_payload)) THEN
      RETURN FALSE;
    END
    RETURN (type__resolved(coerced_payload) == type__resolved(actual_payload));
}
END
FN mIRLowering__lower_union_payload_coercion(self: MIRLowering, mir: Emittable, node: Locatable, actual_type: Type, coerced_type: Type) RETURNS !?Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE target_type = TRY (type__value_payload_type(coerced_type));
    MUTABLE schema: ?UnionSchema@multiowned = COPY (TRY (mIRLowering__union_schemas(rtoc_self_view)))[type__resolved(target_type)];
    schema = (schema OR_ELSE { MUTABLE rtoc_value_block_marker = 0; MUTABLE looked_up: ?MIRLoweringSchemasSchemaLookupResult = mIRLowering__mir_schema_lookup(rtoc_self_view)(type__resolved(target_type));
    ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_29: ?MIRLoweringSchemasSchemaLookupResult = NIL;
    IF ((looked_up != NIL) AND (looked_up IS_A UnionSchema)) THEN
      rtoc_ternary_value_29 = looked_up;
    ELSE
      rtoc_ternary_value_29 = NIL;
    END
    rtoc_ternary_value_29 }) });
    IF schema EXISTS AS schema_value THEN
      MUTABLE schema_value_mutable = COPY schema_value;
      MUTABLE compared_actual_branch_value: ?Type = NIL;
      IF type__optional?(actual_type) THEN
        compared_actual_branch_value = UNWRAP (TRY (type__wrapped_type(actual_type)));
      ELSE
        compared_actual_branch_value = COPY actual_type;
      END
      MUTABLE compared_actual: Type = compared_actual_branch_value?;
      MUTABLE variant_name, payload_type = TRY (mIRLowering__unique_mir_union_payload_variant(rtoc_self_view, schema_value_mutable, compared_actual));
      IF variant_name EXISTS AS variant_name_value THEN
        MUTABLE variant_name_value_mutable = COPY variant_name_value;
        IF payload_type THEN
          IF (type__optional?(actual_type) AND type__optional?(coerced_type)) THEN
            MUTABLE capture = "_union_payload_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_30 = mIRLowering__lowering_counters(rtoc_self_view);
            mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_30) }}";
            MUTABLE wrapped = StructInit{ zig_type: mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ Type: COPY target_type }), fields: [CAST({:name: variant_name_value_mutable, :value: Ident{ name: capture, lowered_node_id: NIL, ownership_consumption: NIL }} AS Any)], lowered_node_id: NIL, ownership_consumption: NIL };
            MUTABLE result = IfOptional{ optional: COPY mir, capture: capture, then_expr: Emittable{ StructInit: COPY wrapped }, else_expr: Emittable{ Lit: COPY Lit{ value: "null", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
            result.result_type = COPY coerced_type;
            RETURN Emittable{ IfOptional: COPY result };
          END
          RETURN TRY (mIRLowering__union_payload_coercion_value(rtoc_self_view, mir, node, target_type, variant_name_value_mutable, CAST(COPY payload_type AS Type)));
        ELSE
          RETURN NIL;
        END
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
FN mIRLowering__unique_mir_union_payload_variant(self: MIRLowering, schema: UnionSchema, actual_type: Type) RETURNS !Tuple<?String, ?Type>
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE matches = schema.variants |> SELECT:? (IF !(((_._1 != NIL) AND (_._1 IS_A Type))) THEN NIL ELSE (IF !(TRY (mIRLowering__mir_union_payload_matches?(rtoc_self_view, castOptionalSchemasUnionSchemaVariantValueToType(_._1), actual_type))) THEN NIL ELSE CAST(Tuple{CAST(_._0 AS String), _._1} AS Tuple<?String, ?Type>) END) END) |> WHERE _ != NIL;
    IF matches.one?() THEN
      RETURN COPY CAST(matches.first() AS Tuple<String, Type>);
    ELSE
      RETURN CAST(Tuple{NIL, NIL} AS Tuple<?String, ?Type>);
    END
}
END
FN mIRLowering__mir_union_payload_matches?(self: MIRLowering, payload_type: Type, actual_type: Type) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE payload_surface = TRY (type__coercion_surface_name(TypeTypeInput{ Type: COPY payload_type }));
    MUTABLE actual_surface = TRY (type__coercion_surface_name(TypeTypeInput{ Type: COPY actual_type }));
    IF (payload_surface == actual_surface) THEN
      RETURN TRUE;
    END
    IF (TRY (type__string?(payload_type)) OR TRY (type__string?(actual_type))) THEN
      RETURN FALSE;
    END
    RETURN TRY (type__accepts?(payload_type, actual_type));
}
END
FN mIRLowering__union_payload_coercion_value(self: MIRLowering, mir: Emittable, node: Locatable, union_type: Type, variant_name: String, payload_type: Type) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE ast_node = COPY node;
    MUTABLE target_alloc = (mIRLowering__function_state(rtoc_self_view).current_decl_alloc OR_ELSE mIRLowering__alloc_for_node(rtoc_self_view, ast_node));
    MUTABLE payload = TRY (mIRLowering__materialize_owned_sink_value(rtoc_self_view, mir, ast_node, target_alloc, TypeTypeInput{ Type: COPY payload_type }));
    IF mIRLowering__mir_allocates?(rtoc_self_view, payload) THEN
      payload = mIRLowering__hoist_alloc(rtoc_self_view, payload, ast_node, TRUE);
    END
    RETURN Emittable{ StructInit: COPY castEmittableToStructInit(TRY (mIRLowering__with_ownership_consumption(rtoc_self_view, Emittable{ StructInit: COPY StructInit{ zig_type: mIRLowering__transpile_type(rtoc_self_view, ZigTypeMapperType{ Type: COPY union_type }), fields: [CAST({:name: variant_name, :value: payload} AS Any)], lowered_node_id: NIL, ownership_consumption: NIL } }, mIRLowering__mir_ident_names(rtoc_self_view, payload), "MIR::StructInit", :owned_sink, target_alloc))) };
}
END
FN mIRLowering__stack_fixed_array_coercion?(self: MIRLowering, MUTABLE node: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A ListLit AS list_lit THEN
      MUTABLE list_lit_mutable = COPY list_lit;
    IF (list_lit_mutable.storage == :stack) THEN
        MUTABLE coerced_type = TRY (aST__full_type_mut(list_lit_mutable));
        RETURN ((coerced_type != NIL) AND (coerced_type.fixed?() == TRUE));
      ELSE
        RETURN FALSE;
      END
    ELSE
      RETURN FALSE;
    END
}
END
FN mIRLowering__lower_body(MUTABLE self: MIRLowering, stmts: []MIRLoweringLowerableStmt) RETURNS ![]Emittable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN TRY (mIRLowering__finalize_lowered_body_construction_mut(rtoc_self_view, TRY (mIRLowering__construct_lowered_body(&rtoc_self_view, stmts))));
}
END
FN mIRLowering__construct_lowered_body(MUTABLE self: MIRLowering, stmts: []MIRLoweringLowerableStmt) RETURNS !LoweredBodyConstruction
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE state = mIRLowering__initial_ownership_finalization_context(rtoc_self_view);
    MUTABLE packets: []LoweredStmtPacket = ( { MUTABLE rtoc_empty_list_31: []LoweredStmtPacket = List[]; rtoc_empty_list_31 } );
    FOR _ IN stmts DO
    MUTABLE packet: ?LoweredStmtPacket = TRY (mIRLowering__lowered_stmt_packet(&rtoc_self_view, state, _));
    IF packet EXISTS AS packet_value THEN
        &packets.append(packet_value);
    END
    END
    RETURN LoweredBodyConstruction{ packets: COPY packets, finalization_context: COPY state };
}
END
FN mIRLowering__initial_ownership_finalization_context(self: MIRLowering) RETURNS OwnershipFinalizationContext
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE state = OwnershipFinalizationContext{ inherited_alloc_names: COPY mIRLowering__function_state(rtoc_self_view).lowered_alloc_names, parent: NIL, out: ( { MUTABLE rtoc_empty_list_32: []Emittable = List[]; rtoc_empty_list_32 } ), guarded_cleanup_names: COPY mIRLowering__function_state(rtoc_self_view).lowered_guarded_cleanup_names, alloc_marks: {}, body_alloc_mark_names: COPY Set[], transfer_mark_names: COPY Set[], body_transfer_mark_names: COPY Set[], move_mark_names: COPY Set[], cleanup_by_name: {} };
    RETURN state;
}
END
FN mIRLowering__finalize_lowered_body_construction_mut(self: MIRLowering, construction: LoweredBodyConstruction) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE state = COPY construction.finalization_context;
    mIRLowering__seed_cleanup_owner_index_mut(rtoc_self_view, state, construction.packets |> UNNEST ((_.pending |> WHERE _ != NIL) + (_.mir |> WHERE _ != NIL)));
    FOR _ IN construction.packets DO
    TRY (mIRLowering__append_pending_packet_nodes_mut(rtoc_self_view, state, _));
    TRY (mIRLowering__append_lowered_statement_packet_mut(rtoc_self_view, state, _));
    END
    TRY (mIRLowering__mark_ownership_finalized_body_mut(rtoc_self_view, state.out));
    RETURN COPY state.out;
}
END
FN mIRLowering__mark_ownership_finalized_body_mut(self: MIRLowering, body: []Emittable) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    mIRLowering__ownership_state(rtoc_self_view).finalized_body_ids.insert(COPY mIRLowering__lowered_body_id(rtoc_self_view, body));
    RETURN COPY body;
}
END
FN mIRLowering__ownership_finalized_body?(self: MIRLowering, body: []Emittable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN mIRLowering__ownership_state(rtoc_self_view).finalized_body_ids.contains?(mIRLowering__lowered_body_id(rtoc_self_view, body));
}
END
FN mIRLowering__ownership_finalized_node?(self: MIRLowering, node: Emittable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(TRUE) THEN
      RETURN FALSE;
    END
    MUTABLE node_id = node.lowered_node_id();
    RETURN !(!(((node_id AND mIRLowering__ownership_state(rtoc_self_view).finalized_node_ids.contains?(node_id)))));
}
END
FN mIRLowering__mark_ownership_finalized_node_mut(self: MIRLowering, MUTABLE node: Emittable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    mIRLowering__ownership_state(rtoc_self_view).finalized_node_ids.insert(mIRLowering__ensure_lowered_node_id(rtoc_self_view, &node));
    NIL;
}
END
FN mIRLowering__ensure_lowered_node_id(self: MIRLowering, MUTABLE node: Emittable) RETURNS LoweredNodeId
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE existing = node.lowered_node_id();
    IF existing THEN
      RETURN existing;
    END
    MUTABLE next_id = mIRLowering__ownership_state(rtoc_self_view).next_lowered_node_id;
    MUTABLE rtoc_writer_receiver_33: MIRLoweringOwnershipState = mIRLowering__ownership_state(rtoc_self_view);
    rtoc_writer_receiver_33.next_lowered_node_id = (next_id + 1);
    MUTABLE assigned = LoweredNodeId{ value: next_id };
    node.lowered_node_id = assigned;
    RETURN assigned;
}
END
FN mIRLowering__lowered_body_id(self: MIRLowering, body: []Emittable) RETURNS LoweredBodyId
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE node_ids: []LoweredNodeId = ( { MUTABLE rtoc_empty_list_34: []LoweredNodeId = List[]; rtoc_empty_list_34 } );
    FOR _ IN body DO
    MUTABLE rtoc_mutable_block_param_35 = COPY _;
    &node_ids.append(mIRLowering__ensure_lowered_node_id(rtoc_self_view, &rtoc_mutable_block_param_35));
    END
    RETURN LoweredBodyId{ node_ids: COPY node_ids };
}
END
FN mIRLowering__mark_ownership_finalized_nodes_mut(self: MIRLowering, nodes: []Emittable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    FOR _ IN nodes DO
    mIRLowering__mark_ownership_finalized_node_mut(rtoc_self_view, _);
    END
    NIL;
}
END
FN mIRLowering__append_pending_packet_nodes_mut(self: MIRLowering, state: OwnershipFinalizationContext, packet: LoweredStmtPacket) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    FOR _ IN (packet.pending |> WHERE _ != NIL) DO
    TRY (mIRLowering__append_ownership_finalized_node_mut(rtoc_self_view, state, _, [_], NIL, NIL));
    END
    NIL;
}
END
FN mIRLowering__seed_cleanup_owner_index_mut(self: MIRLowering, state: OwnershipFinalizationContext, body: []Emittable) RETURNS Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    FOR _ IN body DO
    IF (_ == Array) THEN
      mIRLowering__seed_cleanup_owner_index_mut(rtoc_self_view, state, _);
    ELSE_IF (_ == Hash) THEN
      MUTABLE nested_body = _[:body];
      IF nested_body IS_A []@multiowned Any THEN
        mIRLowering__seed_cleanup_owner_index_mut(rtoc_self_view, state, nested_body);
      END
    ELSE_IF _ IS_A Cleanup AS cleanup THEN
      MUTABLE name = COPY CAST(cleanup.name AS String);
      state.cleanup_by_name[name] = (KEEP state.cleanup_by_name[name] OR_ELSE KEEP cleanup);
      IF mIRLowering__cleanup_entry_moved_guard?(rtoc_self_view, cleanup.cleanup_entry) THEN
        &state.guarded_cleanup_names.insert(name);
      END
    ELSE_IF _ IS_A ErrCleanup AS err_cleanup THEN
      MUTABLE name = COPY CAST(err_cleanup.name AS String);
      state.cleanup_by_name[name] = (KEEP state.cleanup_by_name[name] OR_ELSE KEEP err_cleanup);
      IF mIRLowering__cleanup_entry_moved_guard?(rtoc_self_view, err_cleanup.cleanup_entry) THEN
        &state.guarded_cleanup_names.insert(name);
      END
    ELSE_IF (_ IS_A Emittable) THEN
      FOR _ IN _.child_exprs() DO
      IF _ IS_A Emittable THEN
        mIRLowering__seed_cleanup_owner_index_mut(rtoc_self_view, state, [_]);
      END
      END
      FOR _ IN _.body_slots() DO
      mIRLowering__seed_cleanup_owner_index_mut(rtoc_self_view, state, _.body());
      END
    END
    END
    NIL;
}
END
FN mIRLowering__cleanup_entry_moved_guard?(self: MIRLowering, entry: CleanupEntry) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN cleanupEntry__has_moved_guard?(entry);
}
END
FN mIRLowering__append_lowered_statement_packet_mut(self: MIRLowering, state: OwnershipFinalizationContext, packet: LoweredStmtPacket) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE packet_mir = COPY packet.mir;
    MUTABLE packet_nodes: []MIRLoweringLoweredMir = List[];
    IF packet_mir IS_A []Emittable AS array THEN
      packet_nodes = array |> WHERE _ != NIL;
    ELSE
      packet_nodes = [packet_mir];
    END
    MUTABLE mir_nodes = mIRLowering__normalize_allocating_mir_body(rtoc_self_view, packet_nodes);
    TRY (mIRLowering__merge_body_mark_names_mut(rtoc_self_view, state, NodeRoot{ ArrayValue: COPY mir_nodes }));
    MUTABLE line: ?Int64 = packet.source_line;
    MUTABLE col: ?Int64 = packet.source_column;
    IF line EXISTS AS line_value THEN
      &state.out.append(Emittable{ Comment: COPY Comment{ text: "CLR:${line_value.toString()}", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    END
    TRY (mIRLowering__append_transfer_marks_to_body_mut(rtoc_self_view, state, packet.stmt_transfer_marks, line, col));
    FOR _ IN mir_nodes DO
    TRY (mIRLowering__append_ownership_finalized_node_mut(rtoc_self_view, state, _, mir_nodes, line, col));
    END
    MUTABLE marks = mir_nodes |> UNNEST TRY (mIRLowering__ownership_transfers_for_node(rtoc_self_view, _, state));
    TRY (mIRLowering__append_transfer_marks_to_body_mut(rtoc_self_view, state, TRY (mIRLowering__dedupe_transfer_marks(rtoc_self_view, marks)), line, col));
    NIL;
}
END
FN mIRLowering__append_already_finalized_node_mut(self: MIRLowering, state: OwnershipFinalizationContext, node: Emittable) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    &state.out.append(COPY node);
    mIRLowering__record_ownership_finalization_node_mut(rtoc_self_view, state, NodeRoot{ Emittable: COPY node });
    TRY (mIRLowering__append_transfer_marks_mut(rtoc_self_view, TRY (mIRLowering__ownership_transfers_for_targets(rtoc_self_view, TRY (mIRLowering__ownership_transfer_operands_for_node(rtoc_self_view, node, state)), state)), state));
    NIL;
}
END
FN mIRLowering__append_ownership_finalized_node_mut(self: MIRLowering, state: OwnershipFinalizationContext, node: Emittable, body: []Emittable, line: ?Int64, col: ?Int64) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF mIRLowering__ownership_finalized_node?(rtoc_self_view, node) THEN
      TRY (mIRLowering__append_already_finalized_node_mut(rtoc_self_view, state, node));
      RETURN;
    END
    TRY (mIRLowering__finalize_nested_mir_bodies_mut(rtoc_self_view, node, state));
    mIRLowering__stamp_source_line_mut(rtoc_self_view, node, line, col);
    TRY (mIRLowering__append_transfer_marks_to_body_mut(rtoc_self_view, state, TRY (mIRLowering__pre_terminator_transfer_marks(rtoc_self_view, node, state.out, body)), line, col));
    MUTABLE node_index = state.out.length();
    &state.out.append(COPY node);
    TRY (mIRLowering__append_move_guard_for_transfer_mark_mut(rtoc_self_view, node, state));
    MUTABLE surface = TRY (mIRLowering__scan_ownership_surface_mut(rtoc_self_view, state, NodeRoot{ Emittable: COPY node }, TRUE, TRUE));
    state.out = ruby_array_concat_Emittable(state.out, CAST(surface.facts AS []Emittable));
    mIRLowering__mark_ownership_finalized_node_mut(rtoc_self_view, node);
    mIRLowering__mark_ownership_finalized_nodes_mut(rtoc_self_view, surface.facts);
    MUTABLE transfer_index = state.out.length();
    TRY (mIRLowering__append_transfer_marks_to_body_mut(rtoc_self_view, state, TRY (mIRLowering__ownership_transfers_for_targets(rtoc_self_view, surface.transfer_targets, state)), line, col));
    IF (mIRLowering__terminator_stmt?(rtoc_self_view, node) AND (state.out.length() > transfer_index)) THEN
      MUTABLE moved_tail: []Emittable = ( { MUTABLE rtoc_tail_list: []Emittable = List[]; rtoc_tail_list } );
      MUTABLE tail_idx: Int64 = transfer_index;
      WHILE (tail_idx < state.out.length()) DO
        &moved_tail.append(COPY UNWRAP (state.out[tail_idx]));
        tail_idx = (tail_idx + 1);
      END
      WHILE (state.out.length() > transfer_index) DO
        &state.out.removeAt(state.out.length() - 1);
      END
      MUTABLE insert_idx: Int64 = 0;
      WHILE (insert_idx < moved_tail.length()) DO
        &state.out.insertAt((node_index + insert_idx), COPY UNWRAP (moved_tail[insert_idx]));
        insert_idx = (insert_idx + 1);
      END
    END
    NIL;
}
END
FN mIRLowering__terminator_stmt?(self: MIRLowering, node: Emittable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ((node IS_A ReturnStmt OR node IS_A BreakStmt) OR node IS_A ContinueStmt);
}
END
FN mIRLowering__append_transfer_marks_to_body_mut(self: MIRLowering, state: OwnershipFinalizationContext, marks: []Stmt, line: ?Int64, col: ?Int64) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < marks.length() DO
      IF (marks[rtoc_idx]? IS_A MoveMark AND state.move_mark_names.contains?(CAST((marks[rtoc_idx]?.name()) AS String))) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF (marks[rtoc_idx]? IS_A TransferMark AND state.transfer_mark_names.contains?(CAST((marks[rtoc_idx]?.name()) AS String))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF mIRLowering__ownership_finalized_node?(rtoc_self_view, castStmtToEmittable(marks[rtoc_idx]?)) THEN
          TRY (mIRLowering__append_already_finalized_node_mut(rtoc_self_view, state, castStmtToEmittable(marks[rtoc_idx]?)));
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      mIRLowering__stamp_source_line_mut(rtoc_self_view, castStmtToEmittable(marks[rtoc_idx]?), line, col);
      &state.out.append(castStmtToEmittable(COPY marks[rtoc_idx]?));
      MUTABLE facts: []MIRLoweringOwnershipFact = ( { MUTABLE rtoc_empty_list_36: []MIRLoweringOwnershipFact = List[]; rtoc_empty_list_36 } );
      IF marks[rtoc_idx]? IS_A Emittable AS emittable THEN
          facts = TRY (mIRLowering__ownership_facts_for_structural_node(rtoc_self_view, emittable));
      END
      ruby_array_concat_Emittable(state.out, CAST(facts AS []Emittable));
      mIRLowering__mark_ownership_finalized_node_mut(rtoc_self_view, castStmtToEmittable(marks[rtoc_idx]?));
      mIRLowering__mark_ownership_finalized_nodes_mut(rtoc_self_view, facts);
      mIRLowering__record_ownership_finalization_node_mut(rtoc_self_view, state, castStmtToNodeRoot(marks[rtoc_idx]?));
      IF !(marks[rtoc_idx]? IS_A TransferMark) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE before_guard = state.out.length();
      TRY (mIRLowering__append_move_guard_for_transfer_mark_mut(rtoc_self_view, castStmtToEmittable(marks[rtoc_idx]?), state));
      IF (state.out.length() > before_guard) THEN
          FOR _ IN UNWRAP (state.out.substr(before_guard, (state.out.length() - before_guard))) DO
          mIRLowering__stamp_source_line_mut(rtoc_self_view, _, line, col);
          END
      END
    rtoc_idx = rtoc_idx + 1;
    END
    NIL;
}
END
FN mIRLowering__emitted_guarded_cleanup_for_name?(self: MIRLowering, nodes: []Emittable, name: String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN nodes |> ANY (IF !((_ IS_A Cleanup OR _ IS_A ErrCleanup)) THEN FALSE ELSE ((_.name() == name) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_37 = _.cleanup_entry();
    cleanupEntry__has_moved_guard?(rtoc_local_receiver_37) }) END);
}
END
FN mIRLowering__dedupe_transfer_marks(self: MIRLowering, marks: []Stmt) RETURNS ![]Stmt
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN marks |> DISTINCT [_.class(), IF respondsTo?(_, "name") THEN
      _.name()
    ELSE
      NIL
    END, IF respondsTo?(_, "target") THEN
      _.target()
    ELSE
      NIL
    END];
}
END
FN mIRLowering__lowered_stmt_packet(MUTABLE self: MIRLowering, state: OwnershipFinalizationContext, stmt: MIRLoweringLowerableStmt) RETURNS !?LoweredStmtPacket
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE mir = TRY (mIRLowering__lower(&rtoc_self_view, stmt));
    mir, MUTABLE hoisted_discard = TRY (mIRLowering__materialize_statement_discard(rtoc_self_view, stmt, NodeRoot{ Emittable: Emittable{ ExprStmt: COPY mir } }));
    MUTABLE pending = mIRLowering__flush_pending(rtoc_self_view);
    IF (mIRLowering__discard_expr_stmt?(rtoc_self_view, stmt, mir) AND !(hoisted_discard)) THEN
      mir = ExprStmt{ expr: Emittable{ ExprStmt: COPY mir }, discard: TRUE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    END
    MUTABLE token = IF stmt IS_A Locatable THEN
      stmt.token()
    ELSE
      NIL
    END;
    MUTABLE transfer_only = stmt IS_A MoveNode;
    MUTABLE stmt_transfer_marks: []Stmt = List[];
    IF transfer_only THEN
      stmt_transfer_marks = mIRLowering__ownership_marks_for_transferred_temp(rtoc_self_view, CAST(mir AS Emittable));
    ELSE
      stmt_transfer_marks = TRY (mIRLowering__dedupe_transfer_marks(rtoc_self_view, TRY (mIRLowering__ownership_transfers_for_stmt(rtoc_self_view, stmt, state.guarded_cleanup_names))));
    END
    MUTABLE statement_nodes: []ExprStmt = List[];
    IF mir IS_A []Any THEN
      statement_nodes = mir |> WHERE _ != NIL;
    ELSE
      statement_nodes = [mir];
    END
    MUTABLE guarded_nodes =   IF transfer_only THEN
      List[]
    ELSE
      TRY (mIRLowering__guard_shared_node_statement(rtoc_self_view, stmt, ((pending |> WHERE _ != NIL) + statement_nodes)))
    END;
    RETURN LoweredStmtPacket{ mir: COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_38: ?[]Any = NIL;
    IF transfer_only THEN
      rtoc_ternary_value_38 = List[];
    ELSE
      rtoc_ternary_value_38 = guarded_nodes;
    END
    rtoc_ternary_value_38? }, pending: COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_39: ?[]Stmt = NIL;
    IF transfer_only THEN
      rtoc_ternary_value_39 = pending;
    ELSE
      rtoc_ternary_value_39 = List[];
    END
    rtoc_ternary_value_39? }, stmt_transfer_marks: COPY stmt_transfer_marks, source_line: IF transfer_only THEN
      NIL
    ELSE
      token.line()
    END, source_column: IF transfer_only THEN
      NIL
    ELSE
      token.column()
    END };
}
END
FN mIRLowering__materialize_statement_discard(self: MIRLowering, stmt: MIRLoweringLowerableStmt, MUTABLE mir_input: NodeRoot) RETURNS !Tuple<NodeRoot, Bool>
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE mir = COPY mir_input;
    IF stmt IS_A Locatable AS locatable THEN
      MUTABLE locatable_mutable = COPY locatable;
      IF !(mIRLowering__discard_expr_stmt?(rtoc_self_view, castLocatableToMIRLoweringLowerableStmt(locatable_mutable), mir)) THEN
        RETURN CAST(Tuple{mir, FALSE} AS Tuple<NodeRoot, Bool>);
      END
      MUTABLE discard_type = TRY (type__from_node_mut(locatable_mutable, "discard allocation mark"));
      mir = TRY (mIRLowering__place_discarded_owned_branch_value(rtoc_self_view, mir, discard_type));
      MUTABLE normalized_prefix = mIRLowering__normalize_allocating_result_expr_mut(rtoc_self_view, mir);
      IF !((normalized_prefix.length() == 0)) THEN
        mIRLowering__function_state(rtoc_self_view).pending_stmts = ruby_array_concat_Stmt(mIRLowering__function_state(rtoc_self_view).pending_stmts, CAST(normalized_prefix AS []Stmt));
      END
      IF !((mIRLowering__mir_allocates?(rtoc_self_view, mir) AND !(mIRLowering__mutating_receiver_allocator_op?(rtoc_self_view, mir)))) THEN
        RETURN CAST(Tuple{mir, FALSE} AS Tuple<NodeRoot, Bool>);
      END
      MUTABLE entry: ?CleanupEntry@multiowned = mIRLowering__hoist_cleanup_entry(rtoc_self_view, mir, locatable_mutable);
      IF entry EXISTS AS entry_value THEN
        MUTABLE entry_value_mutable = COPY entry_value;
        MUTABLE discard_name = "__discard_${{ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_40 = mIRLowering__lowering_counters(rtoc_self_view);
        mIRLoweringCounters__next_tmp_id(&rtoc_mutable_receiver_40) }}";
        MUTABLE alloc = cleanupEntry__alloc(entry_value_mutable);
        MUTABLE materialized = BindingMaterialization{ name: COPY discard_name, expr: COPY mir, alloc: COPY alloc, type_info: COPY discard_type, mutable: TRUE, annotation: COPY TRY (type__new(TypeConstructionInput{ StringValue: COPY TRY (mIRLowering__discard_owned_zig_type(rtoc_self_view, locatable_mutable, entry_value_mutable)) })), suppression: "_ = &${discard_name};", cleanup_entry: entry_value_mutable, cleanup_mode: :normal, scope: NIL, ownership_tracked: TRUE };
        mIRLowering__stamp_allocating_result_target_mut(rtoc_self_view, &mir, discard_name, alloc);
        RETURN CAST(Tuple{ScopeBlock{ body: Body{ Emittable: COPY CAST(COPY TRY (bindingMaterialization__statements(materialized)) AS Emittable) }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }, TRUE} AS Tuple<NodeRoot, Bool>);
      ELSE
        RETURN CAST(Tuple{mir, FALSE} AS Tuple<NodeRoot, Bool>);
      END
    ELSE
      RETURN CAST(Tuple{mir, FALSE} AS Tuple<NodeRoot, Bool>);
    END
}
END
FN mIRLowering__place_discarded_owned_branch_value(self: MIRLowering, mir: Emittable, type_info: Type) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(mIRLowering__mir_allocates?(rtoc_self_view, mir)) THEN
      RETURN COPY mir;
    END
    MUTABLE result_type = TRY (type__success_type(type_info));
    IF !(mIRLowering__ownership_bearing_type?(rtoc_self_view, result_type)) THEN
      RETURN COPY mir;
    END
    MUTABLE dest_alloc = (mIRLowering__mir_owned_alloc(rtoc_self_view, mir) OR_ELSE :heap);
    IF mir IS_A TryCatch AS try_catch THEN
      RETURN TRY (mIRLowering__place_owned_try_catch_for_destination(rtoc_self_view, try_catch, result_type, dest_alloc));
    ELSE_IF mir IS_A Orelse AS orelse THEN
      RETURN TRY (mIRLowering__place_owned_orelse_for_destination(rtoc_self_view, orelse, result_type, dest_alloc));
    ELSE
      RETURN COPY mir;
    END
}
END
FN mIRLowering__discard_expr_stmt?<T>(self: MIRLowering, stmt: MIRLoweringLowerableStmt, mir: T) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF stmt IS_A Locatable AS locatable THEN
      IF !((T IS_A Emittable AND mir.expr?())) THEN
        RETURN FALSE;
      END
      MUTABLE ast_stmt: Locatable = COPY locatable;
      WHILE (ast_stmt IS_A UnaryOp AND (ast_stmt.op() == :TRY)) DO
        ast_stmt = ast_stmt.right();
      END
      IF !((aST__call?(ast_stmt) OR ast_stmt IS_A BinaryOp)) THEN
        RETURN FALSE;
      END
      MUTABLE resolved = locatable.resolved_type();
      RETURN !(!(((resolved AND (resolved != :Void)))));
    ELSE
      RETURN FALSE;
    END
}
END
FN mIRLowering__record_ownership_finalization_node_mut(self: MIRLowering, state: OwnershipFinalizationContext, root: NodeRoot) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    mIR__each_surface_node(root, %(node: Emittable) USE(state, rtoc_self_view) -> {
    mIRLowering__record_ownership_finalization_surface_node_mut(rtoc_self_view, state, node);
    rubyToClearVoid()
    });
    MUTABLE rtoc_writer_receiver_41: FunctionState = mIRLowering__function_state(rtoc_self_view);
    rtoc_writer_receiver_41.lowered_guarded_cleanup_names = COPY state.guarded_cleanup_names;
    NIL;
}
END
FN mIRLowering__record_ownership_finalization_surface_node_mut(self: MIRLowering, state: OwnershipFinalizationContext, node: Emittable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A AllocMark AS alloc_mark THEN
      state.alloc_marks[alloc_mark.name] = COPY alloc_mark;
      &state.body_alloc_mark_names.insert(COPY alloc_mark.name);
    ELSE_IF node IS_A MIRLoweringTransferMark AS mir_lowering_transfer_mark THEN
      &state.transfer_mark_names.insert(COPY mir_lowering_transfer_mark.name());
      &state.body_transfer_mark_names.insert(COPY mir_lowering_transfer_mark.name());
    ELSE_IF node IS_A MoveMark AS move_mark THEN
      &state.move_mark_names.insert(COPY move_mark.name);
    ELSE_IF node IS_A Cleanup AS cleanup THEN
      MUTABLE cleanup_mutable = COPY cleanup;
      MUTABLE name = COPY cleanup_mutable.name;
      MUTABLE rtoc_index_receiver_42 = KEEP state.cleanup_by_name;
      rtoc_index_receiver_42[name] = COPY cleanup_mutable;
      IF mIRLowering__cleanup_entry_moved_guard?(rtoc_self_view, cleanup_mutable.cleanup_entry) THEN
        &state.guarded_cleanup_names.insert(name);
      END
    ELSE_IF node IS_A ErrCleanup AS err_cleanup THEN
      MUTABLE err_cleanup_mutable = COPY err_cleanup;
      MUTABLE name = COPY err_cleanup_mutable.name;
      MUTABLE rtoc_index_receiver_43 = KEEP state.cleanup_by_name;
      rtoc_index_receiver_43[name] = COPY err_cleanup_mutable;
      IF mIRLowering__cleanup_entry_moved_guard?(rtoc_self_view, err_cleanup_mutable.cleanup_entry) THEN
        &state.guarded_cleanup_names.insert(name);
      END
    END
    NIL;
}
END
FN mIRLowering__scan_ownership_surface_mut(self: MIRLowering, state: OwnershipFinalizationContext, root: NodeRoot, collect_facts: Bool, collect_transfers: Bool) RETURNS !OwnershipSurfaceScan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE facts: []MIRLoweringOwnershipFact = ( { MUTABLE rtoc_empty_list_44: []MIRLoweringOwnershipFact = List[]; rtoc_empty_list_44 } );
    MUTABLE transfer_targets: []OwnershipTransferTarget = ( { MUTABLE rtoc_empty_list_45: []OwnershipTransferTarget = List[]; rtoc_empty_list_45 } );
    mIR__each_surface_node(root, %(node: Emittable) USE(collect_facts, collect_transfers, MUTABLE facts, state, MUTABLE transfer_targets, rtoc_self_view) -> {
    mIRLowering__record_ownership_finalization_surface_node_mut(rtoc_self_view, state, node);
    IF collect_facts THEN
        TRY (mIRLowering__append_ownership_facts_for_mir_node_mut(rtoc_self_view, &facts, node));
    END
    IF collect_transfers THEN
        mIRLowering__append_ownership_transfer_targets_for_surface_node_mut(rtoc_self_view, &transfer_targets, node, state);
    END
    rubyToClearVoid()
    });
    MUTABLE rtoc_writer_receiver_46: FunctionState = mIRLowering__function_state(rtoc_self_view);
    rtoc_writer_receiver_46.lowered_guarded_cleanup_names = COPY state.guarded_cleanup_names;
    RETURN OwnershipSurfaceScan{ facts: COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_47: ?[]MIRLoweringOwnershipFact = NIL;
    IF collect_facts THEN
      rtoc_ternary_value_47 = TRY (mIRLowering__dedupe_ownership_facts(rtoc_self_view, facts));
    ELSE
      rtoc_ternary_value_47 = facts;
    END
    rtoc_ternary_value_47? }, transfer_targets: COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_48: ?[]OwnershipTransferTarget = NIL;
    IF collect_transfers THEN
      rtoc_ternary_value_48 = CAST((transfer_targets |> DISTINCT _) AS []OwnershipTransferTarget);
    ELSE
      rtoc_ternary_value_48 = transfer_targets;
    END
    rtoc_ternary_value_48? } };
}
END
FN mIRLowering__merge_body_mark_names_mut(self: MIRLowering, state: OwnershipFinalizationContext, body: NodeRoot) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    state.body_alloc_mark_names.merge(TRY (mIRLowering__body_alloc_mark_names_in_body(rtoc_self_view, body)));
    state.body_transfer_mark_names.merge(TRY (mIRLowering__body_transfer_mark_names_in_body(rtoc_self_view, body)));
    NIL;
}
END
FN mIRLowering__body_alloc_mark_names_in_body(self: MIRLowering, body: NodeRoot) RETURNS ![Set]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE names: [Set]String = Set[];
    mIR__each_surface_node(body, %(node: Emittable) USE(MUTABLE names) -> {
    IF node IS_A AllocMark AS alloc_mark THEN
        &names.insert(COPY alloc_mark.name);
    END
    rubyToClearVoid()
    });
    RETURN names;
}
END
FN mIRLowering__body_transfer_mark_names_in_body(self: MIRLowering, body: NodeRoot) RETURNS ![Set]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE names: [Set]String = Set[];
    mIR__each_surface_node(body, %(node: Emittable) USE(MUTABLE names) -> {
    IF node IS_A TransferMark AS transfer_mark THEN
        &names.insert(COPY CAST(transfer_mark.name() AS String));
    END
    rubyToClearVoid()
    });
    RETURN names;
}
END
FN mIRLowering__append_ownership_transfers_for_mir_body(self: MIRLowering, body: []Emittable, inherited_alloc_names: [Set]String = Set[], inherited_guarded_names: [Set]String = Set[]) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE normalized = mIRLowering__normalize_allocating_mir_body(rtoc_self_view, body);
    MUTABLE state = OwnershipFinalizationContext{ inherited_alloc_names: COPY inherited_alloc_names, parent: NIL, out: ( { MUTABLE rtoc_empty_list_49: []Emittable = List[]; rtoc_empty_list_49 } ), guarded_cleanup_names: COPY inherited_guarded_names, alloc_marks: {}, body_alloc_mark_names: COPY TRY (mIRLowering__body_alloc_mark_names_in_body(rtoc_self_view, NodeRoot{ ArrayValue: COPY normalized })), transfer_mark_names: COPY Set[], body_transfer_mark_names: COPY TRY (mIRLowering__body_transfer_mark_names_in_body(rtoc_self_view, NodeRoot{ ArrayValue: COPY normalized })), move_mark_names: COPY Set[], cleanup_by_name: {} };
    mIRLowering__seed_cleanup_owner_index_mut(rtoc_self_view, state, normalized);
    FOR _ IN normalized DO
    TRY (mIRLowering__finalize_ownership_for_mir_node_mut(rtoc_self_view, _, normalized, state));
    END
    RETURN TRY (mIRLowering__mark_ownership_finalized_body_mut(rtoc_self_view, state.out));
}
END
FN mIRLowering__append_nested_ownership_transfers_for_mir_body(self: MIRLowering, body: []Emittable, inherited_alloc_names: [Set]String, inherited_guarded_names: [Set]String, parent: OwnershipFinalizationContext) RETURNS ![]Emittable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF mIRLowering__ownership_finalized_body?(rtoc_self_view, body) THEN
      RETURN COPY body;
    END
    MUTABLE normalized = mIRLowering__normalize_allocating_mir_body(rtoc_self_view, body);
    MUTABLE state = OwnershipFinalizationContext{ inherited_alloc_names: COPY inherited_alloc_names, parent: COPY parent, out: ( { MUTABLE rtoc_empty_list_50: []Emittable = List[]; rtoc_empty_list_50 } ), guarded_cleanup_names: COPY inherited_guarded_names, alloc_marks: {}, body_alloc_mark_names: COPY TRY (mIRLowering__body_alloc_mark_names_in_body(rtoc_self_view, NodeRoot{ ArrayValue: COPY normalized })), transfer_mark_names: COPY Set[], body_transfer_mark_names: COPY TRY (mIRLowering__body_transfer_mark_names_in_body(rtoc_self_view, NodeRoot{ ArrayValue: COPY normalized })), move_mark_names: COPY Set[], cleanup_by_name: {} };
    mIRLowering__seed_cleanup_owner_index_mut(rtoc_self_view, state, normalized);
    FOR _ IN normalized DO
    TRY (mIRLowering__finalize_ownership_for_mir_node_mut(rtoc_self_view, _, normalized, state));
    END
    RETURN TRY (mIRLowering__mark_ownership_finalized_body_mut(rtoc_self_view, state.out));
}
END
FN mIRLowering__finalize_ownership_for_mir_node_mut(self: MIRLowering, node: Emittable, body: []Emittable, state: OwnershipFinalizationContext) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF mIRLowering__ownership_finalized_node?(rtoc_self_view, node) THEN
      TRY (mIRLowering__append_already_finalized_node_mut(rtoc_self_view, state, node));
      RETURN;
    END
    TRY (mIRLowering__finalize_nested_mir_bodies_mut(rtoc_self_view, node, state, state.inherited_alloc_names, state.guarded_cleanup_names));
    mIRLowering__append_implicit_alloc_fact_mut(rtoc_self_view, node, state);
    TRY (mIRLowering__append_block_result_transfer_mut(rtoc_self_view, node, body, state));
    TRY (mIRLowering__append_transfer_marks_mut(rtoc_self_view, TRY (mIRLowering__pre_terminator_transfer_marks(rtoc_self_view, node, state.out, body)), state));
    IF node IS_A BreakStmt AS break_stmt THEN
      TRY (mIRLowering__append_transfer_marks_mut(rtoc_self_view, TRY (mIRLowering__ownership_transfers_for_node(rtoc_self_view, Emittable{ BreakStmt: COPY break_stmt }, state)), state));
    END
    &state.out.append(COPY node);
    TRY (mIRLowering__append_move_guard_for_transfer_mark_mut(rtoc_self_view, node, state));
    MUTABLE surface: ?OwnershipSurfaceScan = NIL;
    MUTABLE facts: []MIRLoweringOwnershipFact = List[];
    IF node IS_A BreakStmt AS break_stmt THEN
      facts = TRY (mIRLowering__ownership_facts_for_mir_surface(rtoc_self_view, Emittable{ BreakStmt: COPY break_stmt }));
    ELSE
      surface = TRY (mIRLowering__scan_ownership_surface_mut(rtoc_self_view, state, NodeRoot{ Emittable: COPY node }, TRUE, TRUE));
      facts = COPY surface.facts;
    END
    state.out = ruby_array_concat_Emittable(state.out, CAST(facts AS []Emittable));
    mIRLowering__mark_ownership_finalized_node_mut(rtoc_self_view, node);
    mIRLowering__mark_ownership_finalized_nodes_mut(rtoc_self_view, facts);
    IF !(surface) THEN
      mIRLowering__record_ownership_finalization_node_mut(rtoc_self_view, state, NodeRoot{ Emittable: COPY node });
    END
    IF !(node IS_A BreakStmt) THEN
      TRY (mIRLowering__append_transfer_marks_mut(rtoc_self_view, TRY (mIRLowering__ownership_transfers_for_targets(rtoc_self_view, (UNWRAP (surface)).transfer_targets, state)), state));
    END
    NIL;
}
END
FN mIRLowering__append_move_guard_for_transfer_mark_mut(self: MIRLowering, node: Emittable, state: OwnershipFinalizationContext) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A TransferMark AS transfer_mark THEN
      MUTABLE transfer_mark_mutable = COPY transfer_mark;
      IF !(((transfer_mark_mutable.target() == :owned_sink) OR (transfer_mark_mutable.target() == :return))) THEN
        RETURN;
      END
      MUTABLE name = COPY transfer_mark_mutable.name();
      MUTABLE guarded = state.guarded_cleanup_names.contains?(name);
      IF !(guarded) THEN
        MUTABLE owner_cleanup: ?MIRLoweringReturnValue = mIRLowering__owner_cleanup_for_transfer(rtoc_self_view, state, name);
        IF owner_cleanup EXISTS AS owner_cleanup_value THEN
          MUTABLE owner_cleanup_value_mutable = COPY owner_cleanup_value;
          MUTABLE rtoc_mutable_receiver_51 = owner_cleanup_value_mutable.cleanup_entry();
          cleanupEntry__mark_moved_guard_mut(&rtoc_mutable_receiver_51);
          &state.guarded_cleanup_names.insert(name);
          state.parent?.guarded_cleanup_names.insert(name);
          guarded = TRUE;
        ELSE
        MUTABLE entry: ?CleanupEntry@multiowned = COPY (TRY (functionState__bindings(mIRLowering__function_state(rtoc_self_view))))[name];
        IF ((entry) AND cleanupEntry__needs_cleanup?(entry)) THEN
            cleanupEntry__mark_moved_guard_mut(&entry);
            &state.guarded_cleanup_names.insert(name);
            state.parent?.guarded_cleanup_names.insert(name);
            guarded = TRUE;
        END
        END
      END
      IF !(guarded) THEN
        RETURN;
      END
      IF state.move_mark_names.contains?(transfer_mark_mutable.name()) THEN
        RETURN;
      END
      MUTABLE move = COPY UNWRAP ((TRY (ownershipTransferPlan__marks((OwnershipTransferPlan{ name: COPY transfer_mark_mutable.name(), target: COPY transfer_mark_mutable.target(), target_alloc: COPY transfer_mark_mutable.target_alloc(), move_guarded: TRUE })))).last());
      &state.out.append(castStmtToEmittable(move));
      state.out = ruby_array_concat_Emittable(state.out, CAST(TRY (mIRLowering__ownership_facts_for_structural_node(rtoc_self_view, UNWRAP (state.out.last()))) AS []Emittable));
      mIRLowering__record_ownership_finalization_node_mut(rtoc_self_view, state, castStmtToNodeRoot(move));
      NIL;
    ELSE
      RETURN;
    END
}
END
FN mIRLowering__owner_cleanup_for_transfer(self: MIRLowering, state: OwnershipFinalizationContext, name: String) RETURNS ?MIRLoweringReturnValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE current: ?OwnershipFinalizationContext = COPY state;
    WHILE current DO
      MUTABLE found = (KEEP current.cleanup_by_name)[name];
      IF found THEN
        RETURN found;
      END
      current = COPY current.parent;
    END
    RETURN NIL;
}
END
FN mIRLowering__append_implicit_alloc_fact_mut(self: MIRLowering, node: Emittable, state: OwnershipFinalizationContext) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE alloc_mark: ?AllocMark = mIRLowering__implicit_alloc_mark_for_mir_node(rtoc_self_view, node, state);
    IF alloc_mark EXISTS AS alloc_mark_value THEN
      &state.out.append(Emittable{ AllocMark: COPY alloc_mark_value });
      MUTABLE fact = mIRLowering__owned_create_fact_for_alloc_mark(rtoc_self_view, alloc_mark_value, mIRLowering__ownership_fact_source(rtoc_self_view, Emittable{ AllocMark: COPY alloc_mark_value }));
      &state.out.append(Emittable{ OwnedCreate: COPY fact });
      mIRLowering__mark_ownership_finalized_node_mut(rtoc_self_view, Emittable{ AllocMark: COPY alloc_mark_value });
      mIRLowering__mark_ownership_finalized_node_mut(rtoc_self_view, Emittable{ OwnedCreate: COPY fact });
      mIRLowering__record_ownership_finalization_node_mut(rtoc_self_view, state, NodeRoot{ Emittable: Emittable{ AllocMark: COPY alloc_mark_value } });
      NIL;
    ELSE
      RETURN;
    END
}
END
FN mIRLowering__append_block_result_transfer_mut(self: MIRLowering, node: Emittable, body: []Emittable, state: OwnershipFinalizationContext) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A BreakStmt AS break_stmt THEN
      MUTABLE value = break_stmt.value;
      IF !(value IS_A Ident) THEN
        RETURN;
      END
      MUTABLE name = COPY value.name();
      IF state.body_transfer_mark_names.contains?(name) THEN
        RETURN;
      END
      IF !((state.alloc_marks.contains?(name) OR state.body_alloc_mark_names.contains?(name))) THEN
        RETURN;
      END
      MUTABLE guarded = state.guarded_cleanup_names.contains?(name);
      FOR _ IN (TRY (mIRLowering__ownership_transfer_marks(rtoc_self_view, name, :block_result, NIL, guarded))) DO
    &state.out.append(castStmtToEmittable(COPY _));
    mIRLowering__record_ownership_finalization_node_mut(rtoc_self_view, state, castStmtToNodeRoot(_));
      END
      NIL;
    ELSE
      RETURN;
    END
}
END
FN mIRLowering__alloc_mark_present?(self: MIRLowering, nodes: []Emittable, name: String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN nodes |> ANY (IF _ IS_A AllocMark AS alloc_mark THEN (alloc_mark.name == name) ELSE FALSE END);
}
END
FN mIRLowering__append_transfer_marks_mut(self: MIRLowering, marks: []Stmt, state: OwnershipFinalizationContext) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < marks.length() DO
      IF (marks[rtoc_idx]? IS_A MoveMark AND state.move_mark_names.contains?(CAST((marks[rtoc_idx]?.name()) AS String))) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF (marks[rtoc_idx]? IS_A TransferMark AND state.transfer_mark_names.contains?(CAST((marks[rtoc_idx]?.name()) AS String))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF mIRLowering__ownership_finalized_node?(rtoc_self_view, castStmtToEmittable(marks[rtoc_idx]?)) THEN
          TRY (mIRLowering__append_already_finalized_node_mut(rtoc_self_view, state, castStmtToEmittable(marks[rtoc_idx]?)));
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      &state.out.append(castStmtToEmittable(COPY marks[rtoc_idx]?));
      MUTABLE facts = TRY (mIRLowering__ownership_facts_for_structural_node(rtoc_self_view, castStmtToEmittable(marks[rtoc_idx]?)));
      ruby_array_concat_Emittable(state.out, CAST(facts AS []Emittable));
      mIRLowering__mark_ownership_finalized_node_mut(rtoc_self_view, castStmtToEmittable(marks[rtoc_idx]?));
      mIRLowering__mark_ownership_finalized_nodes_mut(rtoc_self_view, facts);
      mIRLowering__record_ownership_finalization_node_mut(rtoc_self_view, state, castStmtToNodeRoot(marks[rtoc_idx]?));
      TRY (mIRLowering__append_move_guard_for_transfer_mark_mut(rtoc_self_view, castStmtToEmittable(marks[rtoc_idx]?), state));
    rtoc_idx = rtoc_idx + 1;
    END
    NIL;
}
END
FN mIRLowering__ownership_facts_for_mir_surface(self: MIRLowering, node: Emittable) RETURNS ![]MIRLoweringOwnershipFact
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE facts: []MIRLoweringOwnershipFact = ( { MUTABLE rtoc_empty_list_52: []MIRLoweringOwnershipFact = List[]; rtoc_empty_list_52 } );
    mIR__each_surface_node(NodeRoot{ Emittable: COPY node }, %(surface_node: Emittable) USE(MUTABLE facts, rtoc_self_view) -> {
    TRY (mIRLowering__append_ownership_facts_for_mir_node_mut(rtoc_self_view, &facts, surface_node));
    rubyToClearVoid()
    });
    RETURN TRY (mIRLowering__dedupe_ownership_facts(rtoc_self_view, facts));
}
END
FN mIRLowering__dedupe_ownership_facts(self: MIRLowering, facts: []MIRLoweringOwnershipFact) RETURNS ![]MIRLoweringOwnershipFact
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE seen: [Set]String = Set[];
    RETURN facts |> WHERE { MUTABLE rtoc_value_block_marker = 0; MUTABLE key: ?String = mIRLowering__ownership_fact_dedupe_key(rtoc_self_view, _); (IF !(key) THEN TRUE ELSE (IF seen.contains?(key) THEN FALSE ELSE { MUTABLE rtoc_value_block_marker = 0; &seen.insert(UNWRAP (key)); TRUE } END) END) };
}
END
FN mIRLowering__ownership_fact_dedupe_key(self: MIRLowering, fact: MIRLoweringOwnershipFact) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF fact IS_A OwnedCreate AS owned_create THEN
      RETURN "OwnedCreate:${owned_create.name}:${owned_create.alloc}:${owned_create.source}";
    ELSE_IF fact IS_A OwnedDestroy AS owned_destroy THEN
      RETURN "OwnedDestroy:${owned_destroy.name}:${owned_destroy.alloc}:${owned_destroy.source}";
    ELSE_IF fact IS_A OwnedTransfer AS owned_transfer THEN
      RETURN "OwnedTransfer:${owned_transfer.name}:${owned_transfer.target}:${owned_transfer.source}";
    ELSE_IF fact IS_A OwnedBorrow AS owned_borrow THEN
      RETURN "OwnedBorrow:${owned_borrow.name}:${owned_borrow.source}";
    ELSE_IF fact IS_A OwnedStore AS owned_store THEN
      RETURN "OwnedStore:${owned_store.name}:${owned_store.target}:${UNWRAP (owned_store.alloc)}:${owned_store.source}";
    ELSE_IF fact IS_A OwnedReturn AS owned_return THEN
      RETURN "OwnedReturn:${owned_return.name}:${owned_return.source}";
    ELSE
      RETURN NIL;
    END
}
END
FN mIRLowering__append_ownership_facts_for_mir_node_mut(self: MIRLowering, MUTABLE facts: []MIRLoweringOwnershipFact, node: Emittable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    mIRLowering__append_ownership_facts_for_structural_node_mut(rtoc_self_view, &facts, node);
    mIRLowering__append_ownership_store_facts_for_consumption_mut(rtoc_self_view, &facts, node);
    mIRLowering__append_ownership_transfer_facts_for_consumption_mut(rtoc_self_view, &facts, node);
    FOR _ IN (TRY (mIRLowering__ownership_fact_targets_for_node(rtoc_self_view, node))) DO
    IF _.include_owned_result THEN
        mIRLowering__append_ownership_facts_for_owned_result_mut(rtoc_self_view, &facts, _.name, _.expr, UNWRAP (_.type_info));
    END
    IF _.include_transfer_contract THEN
        TRY (mIRLowering__append_ownership_transfer_facts_for_contract_mut(rtoc_self_view, &facts, _.expr));
    END
    IF _.expr IS_A MIRBgBlock THEN
        &facts.append(MIRLoweringOwnershipFact{ OwnedReturn: COPY OwnedReturn{ name: COPY _.name, source: mIRLowering__ownership_fact_source(rtoc_self_view, _.expr), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    END
    END
    NIL;
}
END
FN mIRLowering__ownership_fact_targets_for_node(self: MIRLowering, node: Emittable) RETURNS ![]OwnershipFactTarget
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A Let AS let THEN
      RETURN TRY (mIRLowering__ownership_fact_target_for_expr(rtoc_self_view, CAST(let.name AS String), let.init, let.annotation));
    ELSE_IF node IS_A ExprStmt AS expr_stmt THEN
      RETURN TRY (mIRLowering__ownership_fact_target_for_expr(rtoc_self_view, mIRLowering__ownership_fact_source(rtoc_self_view, exprStmt__expr(expr_stmt)), exprStmt__expr(expr_stmt), NIL));
    ELSE_IF node IS_A Set AS set THEN
      RETURN CAST([mIRLowering__ownership_transfer_only_target(rtoc_self_view, set.value)] AS []OwnershipFactTarget);
    ELSE_IF node IS_A IfBindStmt AS if_bind_stmt THEN
      RETURN TRY (mIRLowering__if_bind_ownership_fact_targets(rtoc_self_view, if_bind_stmt));
    ELSE_IF node IS_A ReturnStmt AS return_stmt THEN
      MUTABLE value = return_stmt.value;
      IF value THEN
        RETURN TRY (mIRLowering__ownership_fact_target_for_expr(rtoc_self_view, mIRLowering__ownership_fact_source(rtoc_self_view, value), value, NIL));
      ELSE
        RETURN CAST(( { MUTABLE rtoc_empty_list_53: []OwnershipFactTarget = List[]; rtoc_empty_list_53 } ) AS []OwnershipFactTarget);
      END
    ELSE_IF node IS_A BreakStmt AS break_stmt THEN
      MUTABLE value = break_stmt.value;
      IF value THEN
        RETURN TRY (mIRLowering__ownership_fact_target_for_expr(rtoc_self_view, mIRLowering__ownership_fact_source(rtoc_self_view, value), value, NIL));
      ELSE
        RETURN CAST(( { MUTABLE rtoc_empty_list_54: []OwnershipFactTarget = List[]; rtoc_empty_list_54 } ) AS []OwnershipFactTarget);
      END
    ELSE_IF node IS_A ReassignWithCleanup AS reassign_with_cleanup THEN
      RETURN TRY (mIRLowering__ownership_fact_target_for_expr(rtoc_self_view, CAST(reassign_with_cleanup.name AS String), reassign_with_cleanup.value, NIL));
    ELSE_IF node IS_A MIRBgBlock AS mir_bg_block THEN
      RETURN CAST([OwnershipFactTarget{ name: COPY mIRLowering__ownership_fact_source(rtoc_self_view, Emittable{ MIRBgBlock: COPY mir_bg_block }), expr: Emittable{ MIRBgBlock: COPY mir_bg_block }, type_info: NIL, include_owned_result: FALSE, include_transfer_contract: FALSE }] AS []OwnershipFactTarget);
    ELSE
      RETURN TRY (mIRLowering__ownership_fact_target_for_expr(rtoc_self_view, mIRLowering__ownership_fact_source(rtoc_self_view, node), node, NIL));
    END
}
END
FN mIRLowering__ownership_fact_target_for_expr(self: MIRLowering, name: String, expr: Emittable, type_info: ?Type) RETURNS ![]OwnershipFactTarget
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE source_expr = mIRLowering__ownership_contract_source_node(rtoc_self_view, expr);
    MUTABLE include_owned_result = (mIRLowering__ownership_owned_result_fact_relevant?(rtoc_self_view, expr) AND !(source_expr IS_A MIRBgBlock));
    MUTABLE include_transfer_contract = mIRLowering__ownership_transfer_contract_relevant?(rtoc_self_view, expr);
    IF !((include_owned_result OR include_transfer_contract)) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_55: []OwnershipFactTarget = List[]; rtoc_empty_list_55 } ) AS []OwnershipFactTarget);
    END
    MUTABLE owned_result_type =   IF include_owned_result THEN
      (type_info OR_ELSE mIRLowering__mir_alloc_mark_type_info(rtoc_self_view, source_expr, NIL, "owned MIR result fact"))
    ELSE
      NIL
    END;
    RETURN CAST([OwnershipFactTarget{ name: COPY name, expr: COPY expr, type_info: COPY owned_result_type, include_owned_result: include_owned_result, include_transfer_contract: include_transfer_contract }] AS []OwnershipFactTarget);
}
END
FN mIRLowering__ownership_owned_result_fact_relevant?(self: MIRLowering, expr: Emittable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE source_expr = mIRLowering__ownership_contract_source_node(rtoc_self_view, expr);
    IF source_expr IS_A MIRBgBlock AS mir_bg_block THEN
      RETURN TRUE;
    END
    MUTABLE effect = ownershipEffect__of(source_expr);
    IF effect.produces_owned THEN
      RETURN TRUE;
    END
    IF (IF source_expr IS_A ShardedMapPut AS sharded_map_put THEN shardedMapPut__mutating_receiver_allocator_op?(sharded_map_put) ELSE FALSE END) THEN
      RETURN FALSE;
    END
    MUTABLE sig_branch_value: ?FunctionSignature@multiowned = NIL;
    IF respondsTo?(source_expr, "stdlib_def") THEN
      sig_branch_value = functionSignature__unwrap(source_expr.stdlib_def());
    ELSE
      sig_branch_value = NIL;
    END
    MUTABLE sig: ?FunctionSignature@multiowned = sig_branch_value;
    RETURN ((sig != NIL) AND (TRY (functionSignature__emits_allocating?(&sig)) == TRUE));
}
END
FN mIRLowering__ownership_transfer_contract_relevant?(self: MIRLowering, expr: Emittable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE source_expr = mIRLowering__ownership_contract_source_node(rtoc_self_view, expr);
    IF !(TRUE) THEN
      RETURN FALSE;
    END
    MUTABLE contract = source_expr.explicit_ownership_contract();
    RETURN (contract IS_A OwnershipContract@multiowned AND !((TRY (ownershipContract__owned_operand_names(contract))).empty?()));
}
END
FN mIRLowering__ownership_transfer_only_target(self: MIRLowering, expr: Emittable) RETURNS OwnershipFactTarget
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN OwnershipFactTarget{ name: COPY mIRLowering__ownership_fact_source(rtoc_self_view, expr), expr: COPY expr, type_info: NIL, include_owned_result: FALSE, include_transfer_contract: TRUE };
}
END
FN mIRLowering__if_bind_ownership_fact_targets(self: MIRLowering, node: IfBindStmt) RETURNS ![]OwnershipFactTarget
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE targets = (node.bindings) |> UNNEST (IF !(_ IS_A {}Any) THEN NIL ELSE { MUTABLE rtoc_value_block_marker = 0; MUTABLE capture = _[:capture]; { MUTABLE rtoc_value_block_marker = 0; MUTABLE expr = _[:expr]; (IF !((capture AND expr)) THEN NIL ELSE TRY (mIRLowering__ownership_fact_target_for_expr(rtoc_self_view, CAST(capture AS String), CAST(expr AS Emittable), NIL)) END) } } END);
    RETURN targets |> WHERE _ != NIL;
}
END
FN mIRLowering__append_ownership_store_facts_for_consumption_mut(self: MIRLowering, MUTABLE facts: []MIRLoweringOwnershipFact, node: Emittable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fact = node.ownership_consumption();
    IF !(fact) THEN
      RETURN;
    END
    MUTABLE source = mIRLowering__ownership_fact_source(rtoc_self_view, node);
    FOR _ IN fact.names() DO
    &facts.append(MIRLoweringOwnershipFact{ OwnedStore: COPY OwnedStore{ name: COPY CAST(_ AS String), target: COPY fact.source(), alloc: COPY fact.target_alloc(), source: COPY source, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    END
    NIL;
}
END
FN mIRLowering__append_ownership_transfer_facts_for_consumption_mut(self: MIRLowering, MUTABLE facts: []MIRLoweringOwnershipFact, node: Emittable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fact = node.ownership_consumption();
    IF !(fact) THEN
      RETURN;
    END
    MUTABLE source = mIRLowering__ownership_fact_source(rtoc_self_view, node);
    FOR _ IN fact.names() DO
    &facts.append(MIRLoweringOwnershipFact{ OwnedTransfer: COPY OwnedTransfer{ name: COPY CAST(_ AS String), target: COPY fact.target(), source: source, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    END
    NIL;
}
END
FN mIRLowering__ownership_facts_for_structural_node(self: MIRLowering, node: Emittable) RETURNS ![]MIRLoweringOwnershipFact
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE facts: []MIRLoweringOwnershipFact = ( { MUTABLE rtoc_empty_list_56: []MIRLoweringOwnershipFact = List[]; rtoc_empty_list_56 } );
    mIRLowering__append_ownership_facts_for_structural_node_mut(rtoc_self_view, &facts, node);
    RETURN facts;
}
END
FN mIRLowering__append_ownership_facts_for_structural_node_mut(self: MIRLowering, MUTABLE facts: []MIRLoweringOwnershipFact, node: Emittable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A AllocMark AS alloc_mark THEN
      &facts.append(MIRLoweringOwnershipFact{ OwnedCreate: COPY mIRLowering__owned_create_fact_for_alloc_mark(rtoc_self_view, alloc_mark, mIRLowering__ownership_fact_source(rtoc_self_view, Emittable{ AllocMark: COPY alloc_mark })) });
    ELSE_IF node IS_A Cleanup AS cleanup THEN
      &facts.append(MIRLoweringOwnershipFact{ OwnedDestroy: COPY OwnedDestroy{ name: COPY CAST(cleanup.name AS String), alloc: COPY cleanup.cleanup_entry.alloc(), source: COPY mIRLowering__ownership_fact_source(rtoc_self_view, Emittable{ Cleanup: COPY cleanup }), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    ELSE_IF node IS_A ErrCleanup AS err_cleanup THEN
      &facts.append(MIRLoweringOwnershipFact{ OwnedDestroy: COPY OwnedDestroy{ name: COPY CAST(err_cleanup.name AS String), alloc: COPY err_cleanup.cleanup_entry.alloc(), source: COPY mIRLowering__ownership_fact_source(rtoc_self_view, Emittable{ ErrCleanup: COPY err_cleanup }), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    ELSE_IF node IS_A MIRLoweringTransferMark AS mir_lowering_transfer_mark THEN
      &facts.append(MIRLoweringOwnershipFact{ OwnedTransfer: COPY OwnedTransfer{ name: COPY CAST(mir_lowering_transfer_mark.name() AS String), target: COPY mir_lowering_transfer_mark.target(), source: mIRLowering__ownership_fact_source(rtoc_self_view, castMIRLoweringTransferMarkToEmittable(mir_lowering_transfer_mark)), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    END
    NIL;
}
END
FN mIRLowering__owned_create_fact_for_alloc_mark(self: MIRLowering, mark: AllocMark, source: String) RETURNS OwnedCreate
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN OwnedCreate{ name: COPY mark.name, alloc: COPY mark.alloc, type_info: COPY mark.type_info, source: COPY source, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
}
END
FN mIRLowering__append_ownership_facts_for_owned_result_mut(self: MIRLowering, MUTABLE facts: []MIRLoweringOwnershipFact, target_name: String, expr: Emittable, type_info: Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE source_expr = mIRLowering__ownership_contract_source_node(rtoc_self_view, expr);
    IF source_expr IS_A MIRBgBlock AS mir_bg_block THEN
      &facts.append(MIRLoweringOwnershipFact{ OwnedReturn: COPY OwnedReturn{ name: COPY target_name, source: mIRLowering__ownership_fact_source(rtoc_self_view, Emittable{ MIRBgBlock: COPY mir_bg_block }), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
      RETURN;
    END
    MUTABLE effect = ownershipEffect__of(source_expr);
    IF !(effect.produces_owned) THEN
      MUTABLE sig_branch_value: ?FunctionSignature@multiowned = NIL;
      IF respondsTo?(source_expr, "stdlib_def") THEN
        sig_branch_value = functionSignature__unwrap(source_expr.stdlib_def());
      ELSE
        sig_branch_value = NIL;
      END
      MUTABLE sig: ?FunctionSignature@multiowned = sig_branch_value;
      IF !((IF sig != NIL THEN
        TRY (functionSignature__emits_allocating?(&sig))
      ELSE
        NIL
      END)) THEN
        RETURN;
      END
      &facts.append(MIRLoweringOwnershipFact{ OwnedCreate: COPY OwnedCreate{ name: COPY target_name, alloc: COPY (mIRLowering__mir_owned_alloc(rtoc_self_view, source_expr) OR_ELSE :heap), type_info: COPY type_info, source: COPY mIRLowering__ownership_fact_source(rtoc_self_view, source_expr), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
      RETURN;
    END
    &facts.append(MIRLoweringOwnershipFact{ OwnedCreate: COPY OwnedCreate{ name: COPY target_name, alloc: COPY ((IF effect.alloc != NIL THEN effect.alloc ELSE mIRLowering__mir_owned_alloc(rtoc_self_view, source_expr) END) OR_ELSE :heap), type_info: COPY type_info, source: COPY mIRLowering__ownership_fact_source(rtoc_self_view, source_expr), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    NIL;
}
END
FN mIRLowering__append_ownership_transfer_facts_for_contract_mut(self: MIRLowering, MUTABLE facts: []MIRLoweringOwnershipFact, expr: Emittable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE names = TRY (mIRLowering__ownership_contract_consumes_unwrapped(rtoc_self_view, expr));
    IF (names.length() == 0) THEN
      RETURN;
    END
    MUTABLE source = mIRLowering__ownership_fact_source(rtoc_self_view, expr);
    FOR _ IN names DO
    &facts.append(MIRLoweringOwnershipFact{ OwnedTransfer: COPY OwnedTransfer{ name: COPY _, target: :owned_sink, source: source, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    END
    NIL;
}
END
FN mIRLowering__ownership_contract_consumes_unwrapped(self: MIRLowering, node: Emittable) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE unwrapped = mIRLowering__ownership_contract_source_node(rtoc_self_view, node);
    IF !(TRUE) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_57: []String = List[]; rtoc_empty_list_57 } ) AS []String);
    END
    RETURN TRY (mIRLowering__ownership_contract_consumes(rtoc_self_view, unwrapped));
}
END
FN mIRLowering__ownership_fact_source(self: MIRLowering, node: Emittable) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE source_node = mIRLowering__ownership_contract_source_node(rtoc_self_view, node);
    IF (source_node IS_A ReassignWithCleanup OR source_node IS_A ShardedMapPut) THEN
      RETURN COPY CAST(source_node.class().name() AS String);
    END
    IF (respondsTo?(source_node, "target_var") AND source_node.target_var()) THEN
      RETURN COPY CAST(source_node.target_var() AS String);
    END
    IF (source_node IS_A Call OR source_node IS_A TailCall) THEN
      RETURN COPY CAST(source_node.callee() AS String);
    END
    IF source_node IS_A MIRMethodCall AS mir_method_call THEN
      RETURN COPY mir_method_call.method;
    END
    IF source_node IS_A MIRBgBlock AS mir_bg_block THEN
      RETURN "MIR::BgBlock";
    END
    IF source_node IS_A StreamSpawn AS stream_spawn THEN
      RETURN "MIR::StreamSpawn";
    END
    IF (respondsTo?(source_node, "reason") AND source_node.reason()) THEN
      RETURN COPY CAST(source_node.reason() AS String);
    END
    IF respondsTo?(source_node, "name") THEN
      RETURN COPY CAST(source_node.name() AS String);
    END
    RETURN (source_node.class().name() OR CAST(source_node.class() AS String));
}
END
FN mIRLowering__ownership_contract_source_node(self: MIRLowering, node: Emittable) RETURNS Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE current: Emittable = COPY node;
    WHILE mIR__expr_wrapper?(current) DO
      current = CAST(current.expr() AS Emittable);
    END
    RETURN current;
}
END
FN mIRLowering__transfer_mark_present?(self: MIRLowering, nodes: []Emittable, name: String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN nodes |> ANY (IF _ IS_A TransferMark AS transfer_mark THEN (transfer_mark.name() == name) ELSE FALSE END);
}
END
FN mIRLowering__pre_terminator_transfer_marks(self: MIRLowering, node: Emittable, emitted: []Emittable, remaining: []Emittable) RETURNS ![]Stmt
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A ReturnStmt AS return_stmt THEN
      MUTABLE return_stmt_mutable = COPY return_stmt;
      MUTABLE value = return_stmt_mutable.value;
      IF !(value IS_A Ident) THEN
        RETURN CAST(( { MUTABLE rtoc_empty_list_58: []Stmt = List[]; rtoc_empty_list_58 } ) AS []Stmt);
      END
      MUTABLE name = COPY value.name();
      IF (mIRLowering__transfer_mark_present?(rtoc_self_view, emitted, name) OR mIRLowering__transfer_mark_present?(rtoc_self_view, remaining, name)) THEN
        RETURN CAST(( { MUTABLE rtoc_empty_list_59: []Stmt = List[]; rtoc_empty_list_59 } ) AS []Stmt);
      END
      MUTABLE cleanup: ?Emittable = emitted.reverse() |> FIND (IF _ IS_A ErrCleanup AS err_cleanup THEN (err_cleanup.name == name) ELSE FALSE END);
      IF cleanup EXISTS AS cleanup_value THEN
        MUTABLE cleanup_value_mutable = COPY cleanup_value;
        IF !(emitted |> ANY (IF _ IS_A AllocMark AS alloc_mark THEN (alloc_mark.name == name) ELSE FALSE END)) THEN
          RETURN CAST(( { MUTABLE rtoc_empty_list_60: []Stmt = List[]; rtoc_empty_list_60 } ) AS []Stmt);
        END
        MUTABLE rtoc_mutable_receiver_61 = CAST(castEmittableToErrCleanup(cleanup_value_mutable).cleanup_entry AS CleanupEntry);
        cleanupEntry__mark_moved_guard_mut(&rtoc_mutable_receiver_61);
        RETURN TRY (ownershipTransferPlan__marks((OwnershipTransferPlan{ name: COPY name, target: :return, target_alloc: NIL, move_guarded: TRUE })));
      ELSE
        RETURN CAST(( { MUTABLE rtoc_empty_list_62: []Stmt = List[]; rtoc_empty_list_62 } ) AS []Stmt);
      END
    ELSE
      RETURN CAST(( { MUTABLE rtoc_empty_list_63: []Stmt = List[]; rtoc_empty_list_63 } ) AS []Stmt);
    END
}
END
FN mIRLowering__finalize_nested_mir_bodies_mut(self: MIRLowering, node: Emittable, parent_state: OwnershipFinalizationContext, inherited_alloc_names: [Set]String = Set[], inherited_guarded_names: [Set]String = Set[]) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    FOR _ IN node.child_exprs() DO
    TRY (mIRLowering__finalize_nested_mir_expr_bodies_mut(rtoc_self_view, _, inherited_alloc_names, inherited_guarded_names, parent_state));
    END
    FOR _ IN node.body_slots() DO
    MUTABLE rtoc_mutable_block_param_64 = COPY _;
    &rtoc_mutable_block_param_64.replace(TRY (mIRLowering__append_nested_ownership_transfers_for_mir_body(rtoc_self_view, rtoc_mutable_block_param_64.body(), inherited_alloc_names, inherited_guarded_names, parent_state)));
    END
    NIL;
}
END
FN mIRLowering__finalize_nested_mir_expr_bodies_mut(self: MIRLowering, expr: ?Emittable, inherited_alloc_names: [Set]String, inherited_guarded_names: [Set]String, parent_state: OwnershipFinalizationContext) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF expr EXISTS AS expr_value THEN
      IF !(expr_value.expr?()) THEN
        RETURN;
      END
      FOR _ IN expr_value.body_slots() DO
    MUTABLE rtoc_mutable_block_param_65 = COPY _;
      &rtoc_mutable_block_param_65.replace(TRY (mIRLowering__append_nested_ownership_transfers_for_mir_body(rtoc_self_view, rtoc_mutable_block_param_65.body(), inherited_alloc_names, inherited_guarded_names, parent_state)));
      END
      mIRLowering__each_mir_expr_child(rtoc_self_view, expr_value, %(child: Emittable) USE(inherited_alloc_names, inherited_guarded_names, parent_state, rtoc_self_view) -> {
    TRY (mIRLowering__finalize_nested_mir_expr_bodies_mut(rtoc_self_view, child, inherited_alloc_names, inherited_guarded_names, parent_state));
    rubyToClearVoid()
      });
      NIL;
    ELSE
      RETURN;
    END
}
END
FN mIRLowering__implicit_alloc_mark_for_mir_node(self: MIRLowering, node: Emittable, state: OwnershipFinalizationContext) RETURNS ?AllocMark
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fact: ?AllocatingResultFact = mIRLowering__implicit_allocating_result_fact(rtoc_self_view, node, state);
    IF fact != NIL THEN
    RETURN allocatingResultFact__alloc_mark((fact?));
    ELSE
    RETURN NIL;
    END
}
END
FN mIRLowering__implicit_allocating_result_fact(self: MIRLowering, node: Emittable, state: OwnershipFinalizationContext) RETURNS ?AllocatingResultFact
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A Let AS let THEN
      MUTABLE init = let.init;
      IF !(mIRLowering__mir_allocates?(rtoc_self_view, init)) THEN
        RETURN NIL;
      END
      IF mIRLowering__mutating_receiver_allocator_op?(rtoc_self_view, init) THEN
        RETURN NIL;
      END
      MUTABLE name = COPY let.name;
      MUTABLE existing_mark: ?AllocMark = COPY state.alloc_marks[name];
      IF existing_mark EXISTS AS existing_mark_value THEN
        mIRLowering__stamp_allocating_result_target_mut(rtoc_self_view, &init, name, existing_mark_value.alloc);
        RETURN NIL;
      END
      MUTABLE effect = ownershipEffect__of(init);
      MUTABLE alloc = ((IF effect.alloc != NIL THEN effect.alloc ELSE mIRLowering__mir_owned_alloc(rtoc_self_view, init) END) OR_ELSE :heap);
      mIRLowering__stamp_allocating_result_target_mut(rtoc_self_view, &init, name, alloc);
      MUTABLE type_info = (let.annotation OR_ELSE mIRLowering__mir_alloc_mark_type_info(rtoc_self_view, init, NIL, "implicit MIR allocation fact"));
      RETURN AllocatingResultFact{ name: COPY name, ownership_effect: { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_66: ?OwnershipEffect = NIL;
      IF effect.produces_owned THEN
        rtoc_ternary_value_66 = ownershipEffect__with_target(effect, name);
      ELSE
        rtoc_ternary_value_66 = ownershipEffect__owned(alloc, :uniform, TRUE, name);
      END
      rtoc_ternary_value_66? }, type_info: COPY type_info, scope: COPY placement__alloc_scope(alloc) };
    ELSE
      RETURN NIL;
    END
}
END
FN mIRLowering__ownership_transfers_for_stmt(self: MIRLowering, stmt: MIRLoweringLowerableStmt, guarded_cleanup_names: [Set]String) RETURNS ![]Stmt
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF stmt IS_A Locatable AS locatable THEN
      IF locatable IS_A ReturnNode AS return_node THEN
        RETURN CAST(( { MUTABLE rtoc_empty_list_67: []Stmt = List[]; rtoc_empty_list_67 } ) AS []Stmt);
      END
      IF aST__ownership_transfer_stmt?(locatable) THEN
        RETURN CAST(( { MUTABLE rtoc_empty_list_68: []Stmt = List[]; rtoc_empty_list_68 } ) AS []Stmt);
      END
      MUTABLE marks: []Stmt = ( { MUTABLE rtoc_empty_list_69: []Stmt = List[]; rtoc_empty_list_69 } );
      MUTABLE rtoc_each_items_70 = (CAST(((TRY (mIRLowering__collect_bg_capture_transfer_roots(rtoc_self_view, locatable))) |> DISTINCT _) AS []String));
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < rtoc_each_items_70.length() DO
      MUTABLE safe = mIRLowering__zig_safe_name(rtoc_self_view, rtoc_each_items_70[rtoc_idx]);
      MUTABLE rename_map = TRY (functionState__rename_map(mIRLowering__function_state(rtoc_self_view)));
      IF rename_map.contains?(safe) THEN
            safe = UNWRAP (COPY rename_map[safe]);
      END
      MUTABLE entry = ((TRY (functionState__bindings(mIRLowering__function_state(rtoc_self_view))))[rtoc_each_items_70[rtoc_idx]] OR_ELSE new());
      IF !(cleanupEntry__present?(entry)) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      ruby_array_concat_Stmt(marks, TRY (ownershipTransferPlan__marks((mIRLowering__ownership_transfer_plan(rtoc_self_view, safe, :owned_sink, guarded_cleanup_names, entry.alloc())))));
    rtoc_idx = rtoc_idx + 1;
      END
      RETURN marks;
    ELSE
      RETURN CAST(( { MUTABLE rtoc_empty_list_71: []Stmt = List[]; rtoc_empty_list_71 } ) AS []Stmt);
    END
}
END
FN mIRLowering__ownership_transfers_for_node(self: MIRLowering, node: Emittable, state: OwnershipFinalizationContext) RETURNS ![]Stmt
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A ReturnStmt AS return_stmt THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_72: []Stmt = List[]; rtoc_empty_list_72 } ) AS []Stmt);
    END
    RETURN TRY (mIRLowering__ownership_transfers_for_targets(rtoc_self_view, TRY (mIRLowering__ownership_transfer_operands_for_node(rtoc_self_view, node, state)), state));
}
END
FN mIRLowering__ownership_transfers_for_targets(self: MIRLowering, operand_targets: []OwnershipTransferTarget, state: OwnershipFinalizationContext) RETURNS ![]Stmt
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE marks: []Stmt = ( { MUTABLE rtoc_empty_list_73: []Stmt = List[]; rtoc_empty_list_73 } );
    MUTABLE generated_mark_names: [Set]String = Set[];
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < operand_targets.length() DO
      MUTABLE name = COPY operand_targets[rtoc_idx]?.name;
      IF (name.length() == 0) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF (state.body_transfer_mark_names.contains?(name) OR generated_mark_names.contains?(name)) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      ruby_array_concat_Stmt(marks, TRY (ownershipTransferPlan__marks(mIRLowering__ownership_transfer_plan(rtoc_self_view, name, operand_targets[rtoc_idx]?.target, state.guarded_cleanup_names, operand_targets[rtoc_idx]?.target_alloc))));
      &generated_mark_names.insert(name);
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN marks;
}
END
FN mIRLowering__ownership_transfer_operands_for_node(self: MIRLowering, node: Emittable, state: OwnershipFinalizationContext) RETURNS ![]OwnershipTransferTarget
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE operands: []OwnershipTransferTarget = ( { MUTABLE rtoc_empty_list_74: []OwnershipTransferTarget = List[]; rtoc_empty_list_74 } );
    mIR__each_surface_node(NodeRoot{ Emittable: COPY node }, %(surface_node: Emittable) USE(MUTABLE operands, state, rtoc_self_view) -> {
    mIRLowering__append_ownership_transfer_targets_for_surface_node_mut(rtoc_self_view, &operands, surface_node, state);
    rubyToClearVoid()
    });
    RETURN operands |> DISTINCT CAST(Tuple{_.name, _.target, _.target_alloc} AS Tuple<String, String@symbol, ?String@symbol>);
}
END
FN mIRLowering__append_ownership_transfer_targets_for_surface_node_mut(self: MIRLowering, MUTABLE operands: []OwnershipTransferTarget, surface_node: Emittable, state: OwnershipFinalizationContext) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fact: ?OwnershipConsumptionFact = mIRLowering__ownership_consumption_for_node(rtoc_self_view, surface_node);
    IF (fact != NIL) THEN
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < fact.operands.length() DO
      IF (fact.operands[rtoc_idx]?.borrowed OR ((fact.operands[rtoc_idx]?.name) == NIL)) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      &operands.append(OwnershipTransferTarget{ name: COPY UNWRAP (fact.operands[rtoc_idx]?.name), target: COPY fact.target, target_alloc: ( { MUTABLE rtoc_optional_or_source_75: ?String@symbol = fact.operands[rtoc_idx]?.target_alloc; MUTABLE rtoc_optional_or_result_76: ?String@symbol = NIL; IF rtoc_optional_or_source_75 != NIL THEN rtoc_optional_or_result_76 = COPY rtoc_optional_or_source_75; ELSE rtoc_optional_or_result_76 = fact.target_alloc; END rtoc_optional_or_result_76 } ) });
    rtoc_idx = rtoc_idx + 1;
      END
    ELSE_IF surface_node IS_A CapWrap AS cap_wrap THEN
      MUTABLE rtoc_each_items_77 = mIRLowering__mir_ident_names(rtoc_self_view, cap_wrap.inner);
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < rtoc_each_items_77.length() DO
      IF !((state.body_alloc_mark_names.contains?(rtoc_each_items_77[rtoc_idx]?) OR mIRLowering__owned_binding_visible?(rtoc_self_view, rtoc_each_items_77[rtoc_idx]?))) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      &operands.append(OwnershipTransferTarget{ name: COPY rtoc_each_items_77[rtoc_idx]?, target: :owned_sink, target_alloc: COPY cap_wrap.alloc });
    rtoc_idx = rtoc_idx + 1;
      END
    END
    MUTABLE contract: ?OwnershipContract@multiowned = mIRLowering__ownership_contract_for_node(rtoc_self_view, surface_node);
    IF contract EXISTS AS contract_value THEN
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < contract_value.operands.length() DO
      IF (contract_value.operands[rtoc_idx]?.borrowed OR ((contract_value.operands[rtoc_idx]?.name) == NIL)) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      &operands.append(OwnershipTransferTarget{ name: COPY UNWRAP (contract_value.operands[rtoc_idx]?.name), target: :owned_sink, target_alloc: COPY contract_value.operands[rtoc_idx]?.target_alloc });
    rtoc_idx = rtoc_idx + 1;
      END
    END
    NIL;
}
END
FN mIRLowering__ownership_consumption_for_node(self: MIRLowering, node: Emittable) RETURNS ?OwnershipConsumptionFact
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fact = IF respondsTo?(node, "ownership_consumption") THEN
      node.ownership_consumption()
    ELSE
      NIL
    END;
    IF fact IS_A OwnershipConsumptionFact THEN
      RETURN fact;
    END
    IF (IF node IS_A Let AS let THEN respondsTo?(let.init, "ownership_consumption") ELSE FALSE END) THEN
    IF node.init().ownership_consumption() IS_A OwnershipConsumptionFact THEN
      RETURN node.init().ownership_consumption();
    END
    END
    IF (IF node IS_A ExprStmt AS expr_stmt THEN respondsTo?(exprStmt__expr(expr_stmt), "ownership_consumption") ELSE FALSE END) THEN
    IF node.expr().ownership_consumption() IS_A OwnershipConsumptionFact THEN
      RETURN node.expr().ownership_consumption();
    END
    END
    RETURN NIL;
}
END
FN mIRLowering__ownership_contract_for_node(self: MIRLowering, node: ?Emittable) RETURNS ?OwnershipContract@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (node != NIL) THEN
      RETURN node.explicit_ownership_contract();
    ELSE
      RETURN NIL;
    END
}
END
FN mIRLowering__ownership_transfer_plan(self: MIRLowering, name: String, target: String@symbol, guarded_cleanup_names: [Set]String, target_alloc: ?String@symbol = NIL) RETURNS OwnershipTransferPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN OwnershipTransferPlan{ name: COPY name, target: COPY target, target_alloc: COPY target_alloc, move_guarded: guarded_cleanup_names.contains?(name) };
}
END
FN mIRLowering__ownership_transfer_marks(self: MIRLowering, name: String, target: String@symbol, target_alloc: ?String@symbol = NIL, move_guarded: Bool = FALSE) RETURNS ![]Stmt
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (ownershipTransferPlan__marks((OwnershipTransferPlan{ name: COPY name, target: COPY target, target_alloc: COPY target_alloc, move_guarded: COPY move_guarded })));
}
END
FN mIRLowering__ownership_contract_consumes(self: MIRLowering, node: Emittable) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE contract = node.explicit_ownership_contract();
    IF !(contract) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_78: []String = List[]; rtoc_empty_list_78 } ) AS []String);
    END
    RETURN (TRY (ownershipContract__owned_operand_names(contract))) |> SELECT _.toString();
}
END
FN mIRLowering__with_ownership_consumption(self: MIRLowering, MUTABLE node: Emittable, names: []String, source: String, target: String@symbol = :owned_sink, target_alloc: ?String@symbol = NIL, require_visible: Bool = TRUE) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE operands = TRY (mIRLowering__ownership_consumed_name_operands(rtoc_self_view, names, source, target_alloc, require_visible));
    IF ((operands.length() == 0) AND !(mIRLowering__ownership_consumer_requires_fact?(rtoc_self_view, node))) THEN
      RETURN COPY node;
    END
    node.ownership_consumption = OwnershipConsumptionFact{ operands: COPY operands, target: COPY target, target_alloc: COPY target_alloc, source: COPY source, covers_consuming_params: TRUE };
    RETURN COPY node;
}
END
FN mIRLowering__ownership_consumer_requires_fact?(self: MIRLowering, node: Emittable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A ReassignWithCleanup AS reassign_with_cleanup THEN
      RETURN TRUE;
    END
    IF !(respondsTo?(node, "stdlib_def")) THEN
      RETURN FALSE;
    END
    MUTABLE sig = node.stdlib_def();
    IF !(sig) THEN
      RETURN FALSE;
    END
    MUTABLE params = IF respondsTo?(sig, "params") THEN
      sig.params()
    ELSE
      NIL
    END;
    IF (respondsTo?(params, "any?") AND (params |> ANY (respondsTo?(_, "takes") AND _.takes()))) THEN
      RETURN TRUE;
    END
    RETURN (TRUE AND TRY (functionSignature__takes_ownership?(&sig)));
}
END
FN mIRLowering__ownership_consumed_name_operands(self: MIRLowering, names: []String, source: String, target_alloc: ?String@symbol, require_visible: Bool = TRUE) RETURNS ![]OwnershipOperandFact
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (CAST(((names |> SELECT _.toString()) |> WHERE !(_.empty?()) |> DISTINCT _) AS []OwnershipOperandFact)) |> SELECT:? { MUTABLE rtoc_value_block_marker = 0; MUTABLE entry = ((TRY (functionState__bindings(mIRLowering__function_state(rtoc_self_view))))[_] OR_ELSE new()); { MUTABLE rtoc_value_block_marker = 0; MUTABLE has_alloc_mark = mIRLowering__function_state(rtoc_self_view).lowered_alloc_names.contains?(_); (IF (require_visible AND !(((has_alloc_mark OR ((entry AND cleanupEntry__present?(entry))))))) THEN NIL ELSE ownershipOperandFact__owned_binding(_, TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })), source, target_alloc) END) } } |> WHERE _ != NIL;
}
END
FN mIRLowering__with_ownership_consumption_for_value(self: MIRLowering, MUTABLE node: Emittable, value_mir: Emittable, ast_value: Locatable, source: String, target: String@symbol = :owned_sink, target_alloc: ?String@symbol = NIL, value_type: ?Type = NIL) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE operands: []OwnershipOperandFact = List[];
    IF value_type EXISTS AS value_type_value THEN
      operands = TRY (mIRLowering__ownership_operands_for_sink_value(rtoc_self_view, value_mir, ast_value, value_type_value, source, target_alloc, FALSE));
    ELSE
      operands = TRY (mIRLowering__ownership_operands_for_value(rtoc_self_view, value_mir, ast_value, source, target_alloc));
    END
    IF ((operands.length() == 0) AND !(mIRLowering__ownership_consumer_requires_fact?(rtoc_self_view, node))) THEN
      RETURN COPY node;
    END
    node.ownership_consumption = OwnershipConsumptionFact{ operands: COPY operands, target: COPY target, target_alloc: COPY target_alloc, source: COPY source, covers_consuming_params: TRUE };
    RETURN COPY node;
}
END
FN mIRLowering__ownership_operands_for_value(self: MIRLowering, value_mir: Emittable, MUTABLE ast_value: Locatable, source: String, target_alloc: ?String@symbol = NIL) RETURNS ![]OwnershipOperandFact
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE ti = TRY (mIRLowering__ownership_operand_type(rtoc_self_view, &ast_value, "ownership operand"));
    RETURN TRY (mIRLowering__ownership_operands_for_sink_value(rtoc_self_view, value_mir, ast_value, CAST(ti AS Type), source, target_alloc, FALSE));
}
END
FN mIRLowering__ownership_operands_for_lowered_takes_arg(self: MIRLowering, value_mir: Emittable, MUTABLE ast_value: Locatable, source: String, target_alloc: ?String@symbol, sink_type: ?Type = NIL) RETURNS ![]OwnershipOperandFact
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE ti = (sink_type OR_ELSE TRY (mIRLowering__ownership_operand_type(rtoc_self_view, &ast_value, "ownership sink argument")));
    RETURN TRY (mIRLowering__ownership_operands_for_sink_value(rtoc_self_view, value_mir, ast_value, ti, source, target_alloc, TRUE));
}
END
FN mIRLowering__ownership_operand_type(self: MIRLowering, MUTABLE ast_value: Locatable, context: String) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE coerced = IF respondsTo?(ast_value, "coerced_type_info") THEN
      ast_value.coerced_type_info()
    ELSE
      NIL
    END;
    RETURN TRY (type__new(coerced));
}
END
FN mIRLowering__ownership_operands_for_sink_value(self: MIRLowering, value_mir: Emittable, ast_value: Locatable, ti: Type, source: String, target_alloc: ?String@symbol, MUTABLE require_visible_owned: Bool) RETURNS ![]OwnershipOperandFact
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF TRY (type__node_reference?(ti)) THEN
      RETURN CAST([ownershipOperandFact__non_owning(ti, source)] AS []OwnershipOperandFact);
    END
    MUTABLE fact_holder: Emittable = COPY value_mir;
    WHILE (((fact_holder IS_A MIRCast OR fact_holder IS_A TryExpr) OR fact_holder IS_A TryOptional) OR fact_holder IS_A TryCatch) DO
      fact_holder = fact_holder.expr();
    END
    MUTABLE explicit_fact = IF respondsTo?(fact_holder, "ownership_consumption") THEN
      fact_holder.ownership_consumption()
    ELSE
      NIL
    END;
    IF explicit_fact IS_A OwnershipConsumptionFact THEN
      RETURN TRY (mIRLowering__retarget_ownership_operands(rtoc_self_view, explicit_fact.operands(), target_alloc));
    END
    IF (IF value_mir IS_A Ident AS ident THEN mIRLowering__materialized_owned_binding_visible?(rtoc_self_view, CAST(ident.name AS String)) ELSE FALSE END) THEN
      RETURN CAST([ownershipOperandFact__owned_binding(CAST(value_mir.name() AS String), ti, source, target_alloc)] AS []OwnershipOperandFact);
    END
    IF mIRLowering__mir_produces_owned_result?(rtoc_self_view, value_mir) THEN
      RETURN CAST([ownershipOperandFact__owned_result(ti, source, target_alloc)] AS []OwnershipOperandFact);
    END
    IF !(mIRLowering__ownership_tracked_transfer_type?(rtoc_self_view, ti)) THEN
      RETURN CAST([ownershipOperandFact__non_owning(ti, source)] AS []OwnershipOperandFact);
    END
    MUTABLE visible_name: ?String = mIRLowering__mir_ident_names(rtoc_self_view, value_mir) |> FIND mIRLowering__owned_binding_visible?(rtoc_self_view, _);
    IF visible_name EXISTS AS visible_name_value THEN
      RETURN CAST([ownershipOperandFact__owned_binding(visible_name_value, ti, source, target_alloc)] AS []OwnershipOperandFact);
    END
    IF mIRLowering__rodata_ownership_ast?(rtoc_self_view, ast_value) THEN
      RETURN CAST([ownershipOperandFact__non_owning(ti, source)] AS []OwnershipOperandFact);
    END
    IF mIRLowering__non_consuming_owned_value_expr?(rtoc_self_view, value_mir) THEN
      RETURN CAST([ownershipOperandFact__non_owning(ti, source)] AS []OwnershipOperandFact);
    END
    IF mIRLowering__borrowed_ownership_ast?(rtoc_self_view, ast_value) THEN
      RETURN CAST([ownershipOperandFact__borrowed_access(mIRLowering__ownership_root_name(rtoc_self_view, ast_value), ti, source, target_alloc)] AS []OwnershipOperandFact);
    END
    MUTABLE root: ?String = mIRLowering__ownership_root_name(rtoc_self_view, ast_value);
    IF root EXISTS AS root_value THEN
      MUTABLE mapped = mIRLowering__transfer_binding_name(rtoc_self_view, root_value);
      IF (mIRLowering__owned_binding_visible?(rtoc_self_view, mapped) OR ((!(require_visible_owned) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_79 = (((TRY (functionState__bindings(mIRLowering__function_state(rtoc_self_view))))[root_value] OR_ELSE new()));
      cleanupEntry__present?(rtoc_local_receiver_79) }))) THEN
        RETURN CAST([ownershipOperandFact__owned_binding(mapped, ti, source, target_alloc)] AS []OwnershipOperandFact);
      END
      IF mIRLowering__visible_owned_operand_value?(rtoc_self_view, ast_value, value_mir, mapped) THEN
        RETURN CAST([ownershipOperandFact__owned_binding(mapped, ti, source, target_alloc)] AS []OwnershipOperandFact);
      END
    END
    IF !(require_visible_owned) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_80: []OwnershipOperandFact = List[]; rtoc_empty_list_80 } ) AS []OwnershipOperandFact);
    END
    RETURN CAST([ownershipOperandFact__borrowed_access(mIRLowering__ownership_root_name(rtoc_self_view, ast_value), ti, "${source} missing owned binding", target_alloc)] AS []OwnershipOperandFact);
}
END
FN mIRLowering__visible_owned_operand_value?(self: MIRLowering, ast_value_input: Locatable, value_mir: Emittable, mapped: String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE ast_value = COPY ast_value_input;
    IF ast_value IS_A MoveNode AS move_node THEN
      MUTABLE move_node = move_node.value;
    END
    RETURN !(!(((((IF ast_value IS_A Identifier AS identifier THEN value_mir IS_A Ident ELSE FALSE END) AND (CAST(value_mir.name() AS String) == mapped)) AND !(mIRLowering__borrowed_ownership_ast?(rtoc_self_view, ast_value))))));
}
END
FN mIRLowering__retarget_ownership_operands(self: MIRLowering, operands: []OwnershipOperandFact, target_alloc: ?String@symbol) RETURNS ![]OwnershipOperandFact
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN operands |> SELECT {
    MUTABLE alloc: ?String@symbol = (IF target_alloc != NIL THEN target_alloc ELSE _.target_alloc END);
    (  IF _.borrowed THEN
        ownershipOperandFact__borrowed_access(_.name, _.type_info, _.source, alloc)
      ELSE_IF _.name THEN
        ownershipOperandFact__owned_binding(UNWRAP (_.name), _.type_info, _.source, alloc)
      ELSE_IF (_.kind == :owned_result) THEN
        ownershipOperandFact__owned_result(_.type_info, _.source, alloc)
      ELSE
        ownershipOperandFact__non_owning(_.type_info, _.source)
      END)
    };
}
END
FN mIRLowering__non_consuming_owned_value_expr?(self: MIRLowering, value_mir: Emittable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE source: Emittable = COPY value_mir;
    WHILE source IS_A MIRCast DO
      source = source.expr();
    END
    RETURN ((((((source IS_A Lit OR source IS_A StructInit) OR source IS_A ArrayInit) OR source IS_A DeepCopy) OR source IS_A RcRetain) OR source IS_A RcDowngrade) OR source IS_A WeakUpgrade);
}
END
FN mIRLowering__rodata_ownership_ast?(self: MIRLowering, node: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE ast_node = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_82: ?Void = NIL;
    IF node IS_A MoveNode THEN
      rtoc_ternary_value_82 = node.value();
    ELSE
      rtoc_ternary_value_82 = node;
    END
    rtoc_ternary_value_82? };
    IF (ast_node IS_A Literal AND (ast_node.type() == :STRING)) THEN
      RETURN TRUE;
    END
    RETURN !(!(((TRUE AND symbolEntry__rodata_provenance?(ast_node)))));
}
END
FN mIRLowering__owned_binding_visible?(self: MIRLowering, name: String) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_83 = (((TRY (functionState__bindings(mIRLowering__function_state(rtoc_self_view))))[name] OR_ELSE new()));
    cleanupEntry__present?(rtoc_local_receiver_83) } THEN
      RETURN TRUE;
    END
    IF mIRLowering__function_state(rtoc_self_view).pending_stmts |> ANY (_ IS_A AllocMark AND (_.name() == name)) THEN
      RETURN TRUE;
    END
    IF mIRLowering__capture_state(rtoc_self_view).current_fsm_inherited_alloc_names.contains?(name) THEN
      RETURN TRUE;
    END
    RETURN mIRLowering__function_state(rtoc_self_view).lowered_alloc_names.contains?(name);
}
END
FN mIRLowering__materialized_owned_binding_visible?(self: MIRLowering, name: String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF mIRLowering__function_state(rtoc_self_view).pending_stmts |> ANY (_ IS_A AllocMark AND (_.name() == name)) THEN
      RETURN TRUE;
    END
    IF mIRLowering__capture_state(rtoc_self_view).current_fsm_inherited_alloc_names.contains?(name) THEN
      RETURN TRUE;
    END
    RETURN mIRLowering__function_state(rtoc_self_view).lowered_alloc_names.contains?(name);
}
END
FN mIRLowering__borrowed_ownership_ast?(self: MIRLowering, MUTABLE node: ?Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node EXISTS AS node_value THEN
      MUTABLE node_value_mutable = COPY node_value;
      IF mIRLowering__owner_transfer_node?(rtoc_self_view, &node_value_mutable) THEN
        RETURN FALSE;
      END
      RETURN aST__borrowed_ownership_view?(node_value_mutable);
    ELSE
      RETURN FALSE;
    END
}
END
FN mIRLowering__ownership_root_name(self: MIRLowering, node: ?Locatable) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE current: ?Locatable = COPY node;
    IF ((((current != NIL) AND (current IS_A MoveNode)) OR ((current != NIL) AND (current IS_A CopyNode))) OR ((current != NIL) AND (current IS_A KeepNode))) THEN
      current = current.value();
    END
    WHILE (((current != NIL) AND (current IS_A GetField)) OR ((current != NIL) AND (current IS_A GetIndex))) DO
      current = current.target();
    END
    IF current? IS_A Identifier AS identifier THEN
      RETURN COPY identifier__name(identifier);
    END
    RETURN NIL;
}
END
