          TRY (mIRLowering__append_already_finalized_node_mut(&self, &state, castStmtToEmittable(marks[rtoc_idx]?)));
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      &state.out.append(castStmtToEmittable(COPY marks[rtoc_idx]?));
      MUTABLE facts = TRY (mIRLowering__ownership_facts_for_structural_node(&self, castStmtToEmittable(marks[rtoc_idx]?)));
      state.out = ruby_array_concat_Emittable__mir_lowering(state.out, CAST(facts AS []Emittable));
