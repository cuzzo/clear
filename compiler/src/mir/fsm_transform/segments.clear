PUB STRUCT SplitResult {
  segments: []Segment
}
PUB FN segments__suspend_tail?(tail: ?SegmentTail) RETURNS Bool ->
  RETURN ((((tail != NIL) AND (tail IS_A IoSuspend)) OR ((tail != NIL) AND (tail IS_A NextSuspend))) OR ((tail != NIL) AND (tail IS_A LockSuspend)));
END
PUB FN segments__split(body_input: []Locatable, lowering: Any) RETURNS !?SplitResult ->
  MUTABLE body = COPY body_input;
  body = TRY (segments__rewrite_pipeline_io(body));
  MUTABLE loop_result: ?SplitResult = TRY (segments__split_while_loop_next(body));
  IF loop_result EXISTS AS loop_result_value THEN
    RETURN COPY loop_result_value;
  END
  IF segments__contains_unsupported_shape?(body) THEN
    RETURN NIL;
  END
  MUTABLE segments: []Segment = ( { MUTABLE rtoc_empty_list_1: []Segment = List[]; rtoc_empty_list_1 } );
  MUTABLE current_stmts: []Locatable = ( { MUTABLE rtoc_empty_list_2: []Locatable = List[]; rtoc_empty_list_2 } );
  FOR _ IN body DO
  MUTABLE suspend: ?SegmentTail = segments__classify_suspend(_);
  IF suspend EXISTS AS suspend_value THEN
      &segments.append(Segment{ index: segments.length(), stmts: current_stmts, tail: suspend_value });
      current_stmts = ( { MUTABLE rtoc_empty_list_3: []Locatable = List[]; rtoc_empty_list_3 } );
  ELSE
      &current_stmts.append(COPY _);
  END
  END
  &segments.append(Segment{ index: segments.length(), stmts: current_stmts, tail: Done{ _: NIL } });
  RETURN SplitResult{ segments: COPY segments };
END
PRIVATE FN segments__split_while_loop_next(body: []Locatable) RETURNS !?SplitResult ->
  IF !(TRUE) THEN
    RETURN NIL;
  END
  MUTABLE loop_idx: ?Int64 = NIL;
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < body.length() DO
  IF body[rtoc_idx]? IS_A WhileLoop AS while_loop THEN
      IF segments__contains_suspend_anywhere?(while_loop.do_branch) THEN
        IF loop_idx EXISTS AS loop_idx_value THEN
          RETURN NIL;
        END
        loop_idx = rtoc_idx;
      END
  ELSE_IF body[rtoc_idx]? IS_A WhileBindLoop AS while_bind_loop THEN
      IF segments__contains_suspend_anywhere?(while_bind_loop.do_branch) THEN
        IF loop_idx EXISTS AS loop_idx_value THEN
          RETURN NIL;
        END
        loop_idx = rtoc_idx;
      END
  END
  rtoc_idx = rtoc_idx + 1;
  END
  IF loop_idx EXISTS AS loop_idx_value THEN
    MUTABLE pre = TRY (segments__segment_slice(body, 0, loop_idx_value));
    MUTABLE post = TRY (segments__segment_slice(body, (loop_idx_value + 1), body.length()));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < pre.length() DO
  IF segments__contains_suspend_anywhere?([pre[rtoc_idx]?]) THEN
        RETURN NIL;
  END
  rtoc_idx = rtoc_idx + 1;
    END
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < post.length() DO
  IF segments__contains_suspend_anywhere?([post[rtoc_idx]?]) THEN
        RETURN NIL;
  END
  rtoc_idx = rtoc_idx + 1;
    END
    MUTABLE loop_node = COPY UNWRAP (body[loop_idx_value]);
    MUTABLE loop_body: ?[]Locatable = TRY (segments__loop_body_for(loop_node));
    IF loop_body EXISTS AS loop_body_value THEN
      MUTABLE sus_idx: ?Int64 = NIL;
      MUTABLE sus_tail: ?SegmentTail = NIL;
      MUTABLE index = 0;
      WHILE (index < loop_body_value.length()) DO
        MUTABLE s = UNWRAP (loop_body_value[index]);
        MUTABLE sus: ?SegmentTail = segments__classify_suspend(s);
        IF (sus == NIL) THEN
          IF segments__contains_suspend_anywhere?([s]) THEN
            RETURN NIL;
          END
        ELSE
          IF !((NIL == NIL)) THEN
            RETURN NIL;
          END
          sus_idx = index;
          sus_tail = sus;
        END
        index = (index + 1);
      END
      IF sus_idx EXISTS AS sus_idx_value THEN
        MUTABLE loop_pre = TRY (segments__segment_slice(loop_body_value, 0, sus_idx_value));
        MUTABLE loop_post = TRY (segments__segment_slice(loop_body_value, (sus_idx_value + 1), loop_body_value.length()));
        MUTABLE rtoc_idx = 0;
        WHILE rtoc_idx < loop_pre.length() DO
  IF segments__contains_suspend_anywhere?([loop_pre[rtoc_idx]?]) THEN
            RETURN NIL;
  END
  rtoc_idx = rtoc_idx + 1;
        END
        MUTABLE rtoc_idx = 0;
        WHILE rtoc_idx < loop_post.length() DO
  IF segments__contains_suspend_anywhere?([loop_post[rtoc_idx]?]) THEN
            RETURN NIL;
  END
  rtoc_idx = rtoc_idx + 1;
        END
        MUTABLE cond_node: ?Locatable = segments__loop_condition_for(loop_node);
        IF cond_node EXISTS AS cond_node_value THEN
          MUTABLE segments = [Segment{ index: 0, stmts: pre, tail: Goto{ target_index: 1 } }, Segment{ index: 1, stmts: List[], tail: CondBranch{ cond_ast: cond_node_value, then_index: 2, else_index: 4 } }, Segment{ index: 2, stmts: loop_pre, tail: sus_tail }, Segment{ index: 3, stmts: loop_post, tail: LoopBack{ target_index: 1 } }, Segment{ index: 4, stmts: post, tail: Done{ _: NIL } }];
          RETURN SplitResult{ segments: COPY segments };
        ELSE
          RETURN NIL;
        END
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
  ELSE
    RETURN NIL;
  END
END
PRIVATE FN segments__segment_slice(body: []Locatable, start_index: Int64, end_index: Int64) RETURNS ![]Locatable ->
  MUTABLE result: []Locatable = ( { MUTABLE rtoc_empty_list_5: []Locatable = List[]; rtoc_empty_list_5 } );
  MUTABLE index = start_index;
  WHILE (index < end_index) DO
    &result.append(COPY UNWRAP (body[index]));
    index = (index + 1);
  END
  RETURN result;
END
PRIVATE FN segments__loop_body_for(node: Locatable) RETURNS !?[]Locatable ->
  IF node IS_A WhileLoop AS while_loop THEN
    RETURN COPY while_loop.do_branch;
  ELSE_IF node IS_A WhileBindLoop AS while_bind_loop THEN
    RETURN COPY while_bind_loop.do_branch;
  ELSE
    RETURN NIL;
  END
END
PRIVATE FN segments__loop_condition_for(node: Locatable) RETURNS ?Locatable ->
  IF node IS_A WhileLoop AS while_loop THEN
    RETURN COPY castLocatableToLocatable(while_loop.condition);
  ELSE_IF node IS_A WhileBindLoop AS while_bind_loop THEN
    RETURN COPY castLocatableToLocatable(while_bind_loop.condition);
  ELSE
    RETURN NIL;
  END
END
PRIVATE FN segments__contains_unsupported_shape?(body: []Locatable) RETURNS Bool ->
  RETURN body |> ANY segments__stmt_unsupported?(_);
END
PRIVATE FN segments__stmt_unsupported?(stmt: Locatable) RETURNS Bool ->
  IF stmt IS_A WhileLoop AS while_loop THEN
    RETURN segments__contains_suspend_anywhere?(while_loop.do_branch);
  ELSE_IF stmt IS_A WhileBindLoop AS while_bind_loop THEN
    RETURN segments__contains_suspend_anywhere?(while_bind_loop.do_branch);
  ELSE_IF stmt IS_A ForRange AS for_range THEN
    RETURN segments__contains_suspend_anywhere?(for_range.body);
  ELSE_IF stmt IS_A ForEach AS for_each THEN
    RETURN segments__contains_suspend_anywhere?(for_each.body);
  ELSE_IF stmt IS_A WithBlock AS with_block THEN
    RETURN TRUE;
  ELSE_IF stmt IS_A CatchBlock AS catch_block THEN
    RETURN TRUE;
  ELSE_IF stmt IS_A IfStatement AS if_statement THEN
    IF segments__contains_suspend_anywhere?(if_statement.then_branch) THEN
      RETURN TRUE;
    END
    MUTABLE else_branch: ?[]Locatable = if_statement.else_branch;
    IF else_branch EXISTS AS else_branch_value THEN
      RETURN segments__contains_suspend_anywhere?(else_branch_value);
    ELSE
      RETURN FALSE;
    END
  ELSE
    RETURN FALSE;
  END
END
PRIVATE FN segments__contains_suspend_anywhere?(stmts: ?[]Locatable) RETURNS Bool EFFECTS REENTRANT ->
  IF stmts EXISTS AS stmts_value THEN
    MUTABLE items = COPY stmts_value;
    MUTABLE index = 0;
    WHILE (index < items.length()) DO
      MUTABLE stmt = UNWRAP (items[index]);
      IF stmt IS_A WhileLoop AS while_loop THEN
        IF segments__contains_suspend_anywhere?(while_loop.do_branch) THEN
          RETURN TRUE;
        END
      ELSE_IF stmt IS_A WhileBindLoop AS while_bind_loop THEN
        IF segments__contains_suspend_anywhere?(while_bind_loop.do_branch) THEN
          RETURN TRUE;
        END
      ELSE_IF stmt IS_A ForRange AS for_range THEN
        IF segments__contains_suspend_anywhere?(for_range.body) THEN
          RETURN TRUE;
        END
      ELSE_IF stmt IS_A ForEach AS for_each THEN
        IF segments__contains_suspend_anywhere?(for_each.body) THEN
          RETURN TRUE;
        END
      ELSE_IF (stmt IS_A WithBlock) OR (stmt IS_A CatchBlock) THEN
        RETURN TRUE;
      ELSE_IF stmt IS_A IfStatement AS if_stmt THEN
        IF segments__contains_suspend_anywhere?(if_stmt.then_branch) THEN
          RETURN TRUE;
        END
        IF if_stmt.else_branch EXISTS AS else_branch THEN
          IF segments__contains_suspend_anywhere?(else_branch) THEN
            RETURN TRUE;
          END
        END
      ELSE
        IF !((segments__classify_suspend(stmt) == NIL)) THEN
          RETURN TRUE;
        END
      END
      index = (index + 1);
    END
    RETURN FALSE;
  ELSE
    RETURN FALSE;
  END
END
PUB FN segments__classify_suspend(stmt: Locatable) RETURNS ?SegmentTail ->
  IF (stmt IS_A FuncCall) OR (stmt IS_A MethodCall) OR (stmt IS_A NextExpr) THEN
    RETURN segments__suspend_for(stmt, NIL);
  ELSE_IF stmt IS_A VarDecl AS var_decl THEN
    RETURN segments__suspend_for(var_decl.value, var_decl.name);
  ELSE_IF stmt IS_A BindExpr AS bind_expr THEN
    RETURN segments__suspend_for(bind_expr.value, bind_expr.name);
  ELSE_IF stmt IS_A Assignment AS assignment THEN
    RETURN segments__suspend_for(assignment.value, castOptionalAssignmentNameToOptionalString({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_6: ?AssignmentName = NIL;
    IF TRUE THEN
      rtoc_ternary_value_6 = assignment.name;
    ELSE
      rtoc_ternary_value_6 = NIL;
    END
    rtoc_ternary_value_6? }));
  ELSE_IF stmt IS_A DestructuringAssignment AS destructuring_assignment THEN
    RETURN segments__suspend_for(destructuring_assignment.value, NIL);
  ELSE
    RETURN NIL;
  END
END
PRIVATE FN segments__suspend_for(v: ?Locatable, name: ?String) RETURNS ?SegmentTail ->
  IF v EXISTS AS v_value THEN
    MUTABLE value = COPY v_value;
    IF (value IS_A FuncCall) OR (value IS_A MethodCall) THEN
      IF segments__io_suspending_call?(castLocatableToCallNode(value)) THEN
        RETURN SegmentTail{ IoSuspend: COPY IoSuspend{ call_node: COPY value, stdlib_def: aST__node__matched_signature(value), result_var: COPY name, next_index: NIL } };
      END
    ELSE_IF value IS_A NextExpr AS next_expr THEN
      RETURN SegmentTail{ NextSuspend: COPY NextSuspend{ promise_ast: nextExpr__expr(next_expr), result_var: COPY name, next_index: NIL } };
    ELSE
      RETURN NIL;
    END
  ELSE
    RETURN NIL;
  END
END
PRIVATE FN segments__io_suspending_call?(call_node: SegmentsCallNode) RETURNS !Bool ->
  MUTABLE md: ?FunctionSignature@multiowned = NIL;
  MATCH call_node START
    SegmentsCallNode.FuncCall AS item ->
      md = COPY item.matched_stdlib_def;,
    SegmentsCallNode.MethodCall AS item ->
      md = COPY item.matched_stdlib_def;,
  END
  IF md EXISTS AS md_value THEN
    MUTABLE md_mutable = COPY md_value;
    IF TRY (functionSignature__intrinsic_suspends?(&md_mutable)) THEN
      MUTABLE contract = TRY (functionSignature__intrinsic_contract(&md_mutable));
      RETURN intrinsicBehaviorContract__fsm_setup_present(contract.behavior);
    END
  END
  RETURN FALSE;
END
PUB FN segments__suspending_call?(expr: Locatable) RETURNS Bool ->
  RETURN ((aST__call?(expr)) AND segments__io_suspending_call?(castLocatableToCallNode(expr)));
END
PRIVATE FN segments__rewrite_pipeline_io(body: []Locatable) RETURNS ![]Locatable ->
  IF !(TRUE) THEN
    RETURN COPY body;
  END
  MUTABLE out = List[];
  MUTABLE pipe_counter = 0;
  FOR _ IN body DO
  MUTABLE rtoc_mutable_block_param_8 = COPY _;
  MUTABLE pipe_lhs: ?Locatable = NIL;
  MUTABLE pipe_binop_op: String@symbol = :SMOOTH;
  MUTABLE pipe_binop_right: ?Locatable = NIL;
  IF rtoc_mutable_block_param_8 IS_A BinaryOp AS binary_op THEN
    IF binaryOp__smooth?(binary_op) THEN
      pipe_lhs = COPY binary_op.left;
      pipe_binop_op = COPY binary_op.op;
      pipe_binop_right = COPY binary_op.right;
    END
  END
  MUTABLE pipe_lhs_suspends: Bool = FALSE;
  IF pipe_lhs EXISTS AS lhs_probe THEN
    pipe_lhs_suspends = segments__io_suspending_call?(castLocatableToCallNode(lhs_probe));
  END
  IF pipe_lhs_suspends THEN
    MUTABLE pipe_lhs_value: Locatable = COPY UNWRAP (pipe_lhs);
    MUTABLE synth_name = "__pipe_v_${pipe_counter.toString()}";
    pipe_counter = (pipe_counter + 1);
    MUTABLE tok = aST__node__token(pipe_lhs_value);
    MUTABLE bind = BindExpr{ token: COPY tok, name: COPY synth_name, type: NIL, value: COPY pipe_lhs_value, compound_op: NIL, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, mode: NIL, reassign_cleanup: NIL, mir_binding_entry: NIL, auto_atomic_op: NIL, ownership_transport_plan: NIL };
    bind.mode = :decl;
    TRY (aST__stamp_synthetic_type_mut(Locatable{ BindExpr: COPY bind }, TRY (aST__full_type_mut(pipe_lhs_value)), "synthetic AST type"));
    &out.append(bind);
    MUTABLE ident = Identifier{ token: COPY tok, name: COPY synth_name, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, fn_ref: NIL, heap_dupe_result: NIL, atomic_borrow: NIL, ownership_pending_transfer: NIL };
    TRY (aST__stamp_synthetic_type_mut(Locatable{ Identifier: COPY ident }, TRY (aST__full_type_mut(pipe_lhs_value)), "synthetic AST type"));
    MUTABLE rewritten = BinaryOp{ token: COPY aST__node__token(rtoc_mutable_block_param_8), left: Locatable{ Identifier: COPY ident }, op: COPY pipe_binop_op, right: COPY UNWRAP (pipe_binop_right), paren_bind: NIL, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, string_concat: NIL, or_fallback_dupe: NIL, error_union_type: NIL, observable_terminal: NIL, observable_dest: NIL, retain_error_channel: NIL };
    TRY (aST__stamp_synthetic_type_mut(Locatable{ BinaryOp: COPY rewritten }, &rtoc_mutable_block_param_8.full_type_mut("FSM pipeline split"), "synthetic AST type"));
    &out.append(rewritten);
  ELSE
    &out.append(COPY rtoc_mutable_block_param_8);
  END
  END
  RETURN out;
END
