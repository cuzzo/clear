PUB FN lockSuspend__initialize(MUTABLE self: LockSuspend, with_node: WithBlock, cap: LockCap, prior_caps: []LockCap, post_acquire_idx: ?Int64, next_index: ?Int64, lock_index: ?Int64 = NIL, prior_lock_indices: []Int64) RETURNS Void ->

END
PUB FN lockSuspend__kind(self: LockSuspend) RETURNS String@symbol ->
  RETURN :lock;
END
PUB STRUCT LoopBack {
  target_index: Int64
}

PUB FN loopBack__kind(self: LoopBack) RETURNS String@symbol ->
  RETURN :loop_back;
END
PUB STRUCT Goto {
  target_index: Int64
