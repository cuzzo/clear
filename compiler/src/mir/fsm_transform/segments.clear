# Ruby module FsmTransform
# Ruby module FsmTransform::Segments
PUB UNION LockCap { CapabilityTransition: CapabilityTransition, SymbolValue: String@symbol }
PUB STRUCT Done {
  _: Any@multiowned
}

PUB FN done__kind(self: Done) RETURNS String@symbol ->
  RETURN :done;
END
PUB STRUCT IoSuspend {
  call_node: ?Locatable,
  stdlib_def: ?FunctionSignature,
  result_var: ?String,
  next_index: ?Int64
}

PUB FN ioSuspend__kind(self: IoSuspend) RETURNS String@symbol ->
  RETURN :io;
END
PUB FN ioSuspend__suspend?(self: IoSuspend) RETURNS Bool ->
  RETURN TRUE;
END
PUB FN ioSuspend__with_next_index(self: IoSuspend, index_value: ?Int64) RETURNS IoSuspend ->
  RETURN IoSuspend{ call_node: self.call_node, stdlib_def: self.stdlib_def, result_var: COPY self.result_var, next_index: COPY index_value };
END
PUB FN ioSuspend__result_type(self: IoSuspend) RETURNS !?Type ->
  IF self.call_node EXISTS AS call_node_value THEN
    MUTABLE node: Locatable = COPY call_node_value;
    IF aST__node_type_object(node) EXISTS AS type_object THEN
      IF type__untyped?(type_object) THEN
        panic("FSM IO suspend result: unresolved type info");
      END
      RETURN COPY type_object;
    END
    panic("FSM IO suspend result: missing type info");
  END
  RETURN NIL;
END
PUB STRUCT NextSuspend {
  promise_ast: ?Locatable,
  result_var: ?String,
  next_index: ?Int64
}

PUB FN nextSuspend__kind(self: NextSuspend) RETURNS String@symbol ->
  RETURN :next;
END
PUB FN nextSuspend__suspend?(self: NextSuspend) RETURNS Bool ->
  RETURN TRUE;
END
PUB FN nextSuspend__with_next_index(self: NextSuspend, index_value: ?Int64) RETURNS NextSuspend ->
  RETURN NextSuspend{ promise_ast: self.promise_ast, result_var: COPY self.result_var, next_index: COPY index_value };
END
PUB FN nextSuspend__result_type(self: NextSuspend) RETURNS !?Type ->
  IF !(self.promise_ast) THEN
    RETURN NIL;
  END
  MUTABLE node: Locatable = COPY UNWRAP (self.promise_ast);
  MUTABLE type_object: ?Type = aST__node_type_object(node);
  IF !(type_object) THEN
    panic("FSM NEXT suspend result: missing type info");
  END
  MUTABLE concrete_type: Type = COPY UNWRAP (type_object);
  IF type__untyped?(concrete_type) THEN
    panic("FSM NEXT suspend result: unresolved type info");
  END
  MUTABLE pt: Type = COPY concrete_type;
  RETURN TRY (type__tense_type(pt));
END
PUB STRUCT LockSuspend {
  with_node: WithBlock@multiowned,
  cap: LockCap,
  prior_caps: []LockCap,
  post_acquire_idx: ?Int64,
  next_index: ?Int64,
  lock_index: ?Int64,
  prior_lock_indices: []Int64
