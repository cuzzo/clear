  END
  panic("Invalid cast to Locatable");
END
FN castOptionalAssignmentNameToOptionalString(value: ?AssignmentName) RETURNS ?String ->
  IF value != NIL THEN
    IF value IS_A String AS cast_payload THEN
      RETURN cast_payload;
    END
  END
  RETURN NIL;
END
