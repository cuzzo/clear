  stmts: Any@multiowned,
  tail: Any@multiowned
}
PUB UNION SegmentTail { Done: Done, IoSuspend: IoSuspend, NextSuspend: NextSuspend, LockSuspend: LockSuspend, LoopBack: LoopBack, Goto: Goto, CondBranch: CondBranch }
