    SegmentStmt.MinOp AS item -> RETURN TRUE;,
    SegmentStmt.MaxOp AS item -> RETURN TRUE;,
    SegmentStmt.AssertRaises AS item -> RETURN TRUE;,
    SegmentStmt.BenchmarkStmt AS item -> RETURN TRUE;,
    SegmentStmt.SmashStmt AS item -> RETURN TRUE;,
    SegmentStmt.ProfileStmt AS item -> RETURN TRUE;,
    DEFAULT -> RETURN FALSE;
  END
  RETURN FALSE;
END
PRIVATE FN fsmRecursiveSplitter__stmt_introduces_split?(stmt: ?SegmentStmt) RETURNS !Bool ->
  IF stmt EXISTS AS stmt_value THEN
    IF (IF segmentStmt__locatable?(stmt_value) THEN (TRY (segments__classify_suspend(castOptionalSegmentStmtToLocatable(stmt_value))) != NIL) ELSE FALSE END) THEN
      RETURN TRUE;
    END
    IF stmt_value IS_A WithBlock@multiowned AS with_block_multiowned THEN
      RETURN (TRY (fsmRecursiveSplitter__with_lock_suspend?(CAST(COPY with_block_multiowned AS WithBlock))) OR (TRY (fsmRecursiveSplitter__contains_suspend_anywhere?( CAST(Stmts{ ArrayValue: with_block_multiowned.body |> SELECT castLocatableToSegmentStmt(_) } AS ?[]Locatable)))));
    ELSE
      IF !(segmentStmt__locatable?(stmt_value)) THEN
        RETURN FALSE;
      END
      RETURN (aST__child_bodies(castSegmentStmtToLocatable(stmt_value))) |> ANY TRY (fsmRecursiveSplitter__contains_suspend_anywhere?( CAST(Stmts{ ArrayValue: _ |> SELECT castNodeToSegmentStmt( castLocatableToNode__auto_inference(_)) } AS ?[]Locatable)));
    END
  ELSE
    RETURN FALSE;
  END
END
PRIVATE FN fsmRecursiveSplitter__contains_suspend_anywhere?(stmts: ?[]Locatable) RETURNS !Bool EFFECTS REENTRANT ->
  FOR rtoc_stmt IN (stmts OR_ELSE List[]) DO
    IF segments__classify_suspend(rtoc_stmt) THEN
      RETURN TRUE;
    END
    IF rtoc_stmt IS_A WithBlock AS rtoc_with THEN
      IF (TRY (fsmRecursiveSplitter__with_lock_suspend?(rtoc_with)) OR TRY (fsmRecursiveSplitter__contains_suspend_anywhere?(COPY rtoc_with.body))) THEN
        RETURN TRUE;
      END
    ELSE
      FOR rtoc_child_body IN aST__child_bodies(rtoc_stmt) DO
        IF TRY (fsmRecursiveSplitter__contains_suspend_anywhere?(COPY rtoc_child_body)) THEN
          RETURN TRUE;
        END
      END
    END
  END
  RETURN FALSE;
END
PRIVATE FN fsmRecursiveSplitter__with_lock_suspend?(with_node: WithBlock) RETURNS !Bool ->
  RETURN ((TRY (withCapabilityPlan__locks((TRY (capabilityPlan__require_for(with_node)))))).length() > 0);
END
PRIVATE FN fsmRecursiveSplitter__contains_unsupported?(body: ?[]Locatable) RETURNS !Bool EFFECTS REENTRANT ->
  FOR rtoc_stmt IN (body OR_ELSE List[]) DO
    IF rtoc_stmt IS_A WithBlock AS rtoc_with THEN
      IF TRY (fsmRecursiveSplitter__with_unsupported?(rtoc_with)) THEN
        RETURN TRUE;
      END
    ELSE_IF rtoc_stmt IS_A CatchBlock THEN
      RETURN TRUE;
    ELSE_IF rtoc_stmt IS_A WhileLoop AS rtoc_while THEN
      IF TRY (fsmRecursiveSplitter__contains_unsupported?(COPY rtoc_while.do_branch)) THEN
        RETURN TRUE;
      END
    ELSE_IF rtoc_stmt IS_A WhileBindLoop AS rtoc_while_bind THEN
      IF TRY (fsmRecursiveSplitter__contains_unsupported?(COPY rtoc_while_bind.do_branch)) THEN
        RETURN TRUE;
      END
    ELSE_IF rtoc_stmt IS_A IfStatement AS rtoc_if THEN
      IF (TRY (fsmRecursiveSplitter__contains_unsupported?(COPY rtoc_if.then_branch)) OR TRY (fsmRecursiveSplitter__contains_unsupported?(COPY rtoc_if.else_branch))) THEN
        RETURN TRUE;
      END
    ELSE
      IF TRY (fsmRecursiveSplitter__stmt_unsupported_suspend?(castLocatableToOptionalSegmentStmt(rtoc_stmt))) THEN
        RETURN TRUE;
      END
      FOR rtoc_child IN aST__child_bodies(rtoc_stmt) DO
        IF TRY (fsmRecursiveSplitter__contains_unsupported?(COPY rtoc_child)) THEN
          RETURN TRUE;
        END
      END
    END
  END
  RETURN FALSE;
END
PRIVATE FN fsmRecursiveSplitter__with_unsupported?(with_node: WithBlock) RETURNS !Bool EFFECTS REENTRANT ->
  IF TRY (fsmRecursiveSplitter__with_lock_suspend?(with_node)) THEN
    MUTABLE with_plan = TRY (capabilityPlan__require_for(with_node));
    IF !((with_plan.all.length() == (TRY (withCapabilityPlan__locks(with_plan))).length())) THEN
      RETURN TRUE;
    END
  END
  RETURN TRY (fsmRecursiveSplitter__contains_unsupported?(COPY with_node.body));
END
PRIVATE FN fsmRecursiveSplitter__stmt_unsupported_suspend?(stmt: ?SegmentStmt) RETURNS !Bool ->
  MUTABLE sus: ?SegmentTail = NIL;
  IF stmt EXISTS THEN
    sus = TRY (segments__classify_suspend(castOptionalSegmentStmtToLocatable(stmt)));
  END
  IF !(IF sus EXISTS AS rtoc_sus THEN rtoc_sus IS_A NextSuspend ELSE FALSE END) THEN
    RETURN FALSE;
  END
  MUTABLE rtoc_promise_ast: ?Locatable = NIL;
  PARTIAL MATCH UNWRAP (COPY sus) START SegmentTail.NextSuspend AS rtoc_next_suspend -> rtoc_promise_ast = COPY rtoc_next_suspend.promise_ast;, END
  MUTABLE pt: ?Type = TRY (type__from_node_mut(UNWRAP (rtoc_promise_ast), "FSM suspend promise"));
  IF !(type__future?( UNWRAP (pt))) THEN
    RETURN TRUE;
  END
  IF (TRUE AND TRY (type__stream?( UNWRAP (pt)))) THEN
    RETURN TRUE;
  END
  IF (TRUE AND type__promise_list?( UNWRAP (pt))) THEN
    RETURN TRUE;
  END
  RETURN FALSE;
END
# Ruby raises UnsupportedShape here and emit_stmts_or_nil rescues it; RAISE
# is not valid in a MATCH arm, so the arm calls through to it.
PRIVATE FN fsmRecursiveSplitter__unsupported_pivot() RETURNS !Int64 ->
  RAISE Input, FsmUnsupportedShape, "Unhandled pivot kind {}";
END
PRIVATE FN fsmRecursiveSplitter__emit_pivot(stmt: SegmentStmt, after_idx: Int64, MUTABLE builder: Builder, MUTABLE lowering: MIRLowering, ctx: {String@symbol}?TransformValue) RETURNS !Int64 EFFECTS REENTRANT ->
  MUTABLE sus: ?SegmentTail = TRY (segments__classify_suspend(castSegmentStmtToLocatable(stmt)));
  IF sus THEN
    RETURN TRY (fsmRecursiveSplitter__emit_suspend(CAST(sus AS SuspendTail), after_idx, &builder));
  END
  RETURN PARTIAL MATCH stmt START
    SegmentStmt.WhileLoop AS while_loop -> TRY (fsmRecursiveSplitter__emit_while_fragment(SplitterWhileStmt{ WhileLoop: COPY while_loop }, after_idx, builder, lowering, ctx)),
    SegmentStmt.WhileBindLoop AS while_bind_loop -> TRY (fsmRecursiveSplitter__emit_while_fragment(SplitterWhileStmt{ WhileBindLoop: COPY while_bind_loop }, after_idx, builder, lowering, ctx)),
    SegmentStmt.ForRange AS for_range -> TRY (fsmRecursiveSplitter__emit_for_range_fragment(for_range, after_idx, builder, lowering, ctx)),
    SegmentStmt.ForEach AS for_each -> TRY (fsmRecursiveSplitter__emit_for_each_fragment(for_each, after_idx, builder, lowering, ctx)),
    SegmentStmt.IfStatement AS if_statement -> TRY (fsmRecursiveSplitter__emit_if_fragment(if_statement, after_idx, builder, lowering, ctx)),
    SegmentStmt.WithBlockMultiowned AS with_block_multiowned -> TRY (fsmRecursiveSplitter__emit_with_fragment(CAST(COPY with_block_multiowned AS WithBlock), after_idx, &builder, &lowering, ctx)),
    DEFAULT -> TRY (fsmRecursiveSplitter__unsupported_pivot())
  END;
END
PRIVATE FN fsmRecursiveSplitter__emit_suspend(susp_tail: SuspendTail, after_idx: Int64, MUTABLE builder: Builder) RETURNS !Int64 ->
  MUTABLE idx = builder__reserve_index(&builder);
  IF !(segments__suspend_tail?(castSuspendTailToOptionalSegmentTail(susp_tail))) THEN
    RAISE Input, FsmUnsupportedShape, "Unhandled suspend kind {}";
  END
  MUTABLE tail = suspendTail__with_next_index(susp_tail, after_idx);
  builder__fill(&builder, idx, List[], tail);
  RETURN idx;
END
PRIVATE FN fsmRecursiveSplitter__emit_while_fragment(while_stmt: SplitterWhileStmt, after_idx: Int64, builder: Builder, lowering: MIRLowering, ctx: {String@symbol}?TransformValue) RETURNS !Int64 ->
  MUTABLE _: Tuple<SplitterWhileStmt, Int64, Builder, MIRLowering, {String@symbol}?TransformValue> = CAST(Tuple{COPY while_stmt, after_idx, COPY builder, COPY lowering, COPY ctx} AS Tuple<SplitterWhileStmt, Int64, Builder, MIRLowering, {String@symbol}?TransformValue>);
  panic("WhileLoop recursive FSM lowering requires structural MIR conditions");
END
PRIVATE FN fsmRecursiveSplitter__emit_for_range_fragment(for_stmt: ForRange, after_idx: Int64, builder: Builder, lowering: MIRLowering, ctx: {String@symbol}?TransformValue) RETURNS !Int64 ->
  MUTABLE _: Tuple<ForRange, Int64, Builder, MIRLowering, {String@symbol}?TransformValue> = CAST(Tuple{COPY for_stmt, after_idx, COPY builder, COPY lowering, COPY ctx} AS Tuple<ForRange, Int64, Builder, MIRLowering, {String@symbol}?TransformValue>);
  panic("ForRange recursive FSM lowering requires structural MIR loop state");
END
PRIVATE FN fsmRecursiveSplitter__emit_for_each_fragment(for_stmt: ForEach, after_idx: Int64, builder: Builder, lowering: MIRLowering, ctx: {String@symbol}?TransformValue) RETURNS !Int64 ->
  MUTABLE _: Tuple<ForEach, Int64, Builder, MIRLowering, {String@symbol}?TransformValue> = CAST(Tuple{COPY for_stmt, after_idx, COPY builder, COPY lowering, COPY ctx} AS Tuple<ForEach, Int64, Builder, MIRLowering, {String@symbol}?TransformValue>);
  panic("ForEach recursive FSM lowering requires structural MIR iterator state");
END
PRIVATE FN fsmRecursiveSplitter__emit_if_fragment(if_stmt: IfStatement, after_idx: Int64, builder: Builder, lowering: MIRLowering, ctx: {String@symbol}?TransformValue) RETURNS !Int64 ->
  MUTABLE _: Tuple<IfStatement, Int64, Builder, MIRLowering, {String@symbol}?TransformValue> = CAST(Tuple{COPY if_stmt, after_idx, COPY builder, COPY lowering, COPY ctx} AS Tuple<IfStatement, Int64, Builder, MIRLowering, {String@symbol}?TransformValue>);
  panic("IfStatement recursive FSM lowering requires structural MIR conditions");
END
PRIVATE FN fsmRecursiveSplitter__emit_with_fragment(with_stmt: WithBlock, after_idx: Int64, MUTABLE builder: Builder, MUTABLE lowering: MIRLowering, ctx: {String@symbol}?TransformValue) RETURNS !Int64 EFFECTS REENTRANT ->
  MUTABLE caps = TRY (withCapabilityPlan__locks((TRY (capabilityPlan__require_for(with_stmt)))));
  IF (caps.length() == 0) THEN
    panic("WITH with no capabilities");
  END
  MUTABLE ctx_id_raw: ?TransformValue = COPY ctx[:id];
  IF ctx_id_raw? IS_A Int64 AS int64 THEN
    MUTABLE int64_mutable = COPY int64;
    MUTABLE ctx_id: Int64 = CAST(int64_mutable AS Int64);
    MUTABLE captured: {String}Type@multiowned = castTransformValueToHashMapStringTypeMultiowned(ctx[:captured]);
    MUTABLE bg_rt_raw: ?TransformValue = COPY ctx[:bg_rt];
    IF bg_rt_raw? IS_A String AS string THEN
      MUTABLE string_mutable = COPY string;
      MUTABLE bg_rt: String = CAST(string_mutable AS String);
      MUTABLE caps_meta: []{String@symbol}FsmCapMetadataValue = List[];
      FOR _ IN caps DO
    MUTABLE m: ?{String@symbol}FsmCapMetadataValue = TRY (mIRLowering__fsm_cap_metadata(lowering, _, with_stmt, ctx_id, captured));
  IF (m == NIL) THEN
          panic("fsm_cap_metadata failed");
  END
  &caps_meta.append(CAST(m AS {String@symbol}FsmCapMetadataValue));
      END
      MUTABLE cap_indices = caps |> SELECT builder__reserve_index(&builder);
      MUTABLE lock_indices = caps |> SELECT builder__reserve_lock_index(&builder);
      MUTABLE release_idx = builder__reserve_index(&builder);
      MUTABLE body_stmts = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_8: ?[]Locatable = NIL;
      IF with_stmt.body IS_A []Any THEN
        rtoc_ternary_value_8 = with_stmt.body;
      ELSE
        rtoc_ternary_value_8 = COPY with_stmt.body;
      END
      rtoc_ternary_value_8? };
      MUTABLE alias_overrides: {String}String = {};
      FOR _ IN caps_meta DO
      alias_overrides[CAST(_[:alias_name]? AS String)] = COPY CAST(_[:alias_data_ref]? AS String);
      END
      MUTABLE cs_entry: Int64 = CAST(builder__with_alias_overrides(&builder, alias_overrides, %() USE(alias_overrides, bg_rt, body_stmts, MUTABLE builder, ctx, MUTABLE lowering, release_idx) -> {
  rtoc_lambda_result_14 = mIRLowering__with_fiber_capture_map(&lowering, alias_overrides, {}, bg_rt, %() USE(body_stmts, MUTABLE builder, ctx, MUTABLE lowering, release_idx) -> {
  rtoc_lambda_result_13 = TRY (fsmRecursiveSplitter__emit_stmts(CAST(body_stmts AS []SegmentStmt), release_idx, &builder, &lowering, ctx));
  rtoc_lambda_result_13
      });
  rtoc_lambda_result_14
      }) AS Int64);
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < caps.length() DO
    MUTABLE post_acquire: Int64 = 0_i64;
          IF (((rtoc_idx + 1) < caps.length())) THEN
            post_acquire = COPY UNWRAP (cap_indices[(rtoc_idx + 1)]);
          ELSE
            post_acquire = cs_entry;
          END
    MUTABLE prior: []LockCap = (caps |> LIMIT rtoc_idx) |> SELECT LockCap{ CapabilityTransition: COPY _ };
    builder__fill(&builder, UNWRAP (cap_indices[rtoc_idx]), List[], SegmentTail{ LockSuspend: COPY LockSuspend{ with_node: COPY with_stmt, cap: LockCap{ CapabilityTransition: COPY caps[rtoc_idx]? }, prior_caps: COPY prior, post_acquire_idx: post_acquire, next_index: COPY after_idx, lock_index: COPY UNWRAP (lock_indices[rtoc_idx]), prior_lock_indices: COPY (lock_indices |> LIMIT rtoc_idx) } });
  rtoc_idx = rtoc_idx + 1;
      END
      MUTABLE release_stmts: []Emittable = List[];
      # Ruby: caps_meta.each_with_index.to_a.reverse.each { |m, i| ... }
      MUTABLE rel_i = caps_meta.length() - 1;
      WHILE rel_i >= 0 DO
        MUTABLE rel_meta = COPY UNWRAP (caps_meta[rel_i]);
        release_stmts = ruby_array_concat_Emittable__recursive_splitter(release_stmts, TRY (fsmRecursiveSplitter__lock_release_stmts(ctx_id, UNWRAP (lock_indices[rel_i]), CAST((UNWRAP (rel_meta[:lock_field_ref])) AS String), CAST((UNWRAP (rel_meta[:unlock_method])) AS String))));
        rel_i = rel_i - 1;
      END
      builder__fill(&builder, release_idx, fsmRecursiveSplitter__as_mir_body(release_stmts), SegmentTail{ Goto: COPY Goto{ target_index: COPY after_idx } });
      RETURN UNWRAP (cap_indices.first());
    ELSE
      panic("WITH split without runtime");
    END
  ELSE
    panic("WITH split without ctx");
  END
END
PRIVATE FN fsmRecursiveSplitter__lock_release_stmts(ctx_id: Int64, lock_index: Int64, lock_field_ref: String, unlock_method: String) RETURNS ![]Emittable ->
  RETURN CAST([Emittable{ Set: COPY Set{ target: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__ctx_${ctx_id.toString()}", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "__lock_held_${lock_index.toString()}", lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Lit: COPY Lit{ value: "false", lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: COPY lock_field_ref, lowered_node_id: NIL, ownership_consumption: NIL } }, method: COPY unlock_method, args: List[], try_wrap: FALSE, callable_contract: NIL, owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable);
END
PRIVATE FN fsmRecursiveSplitter__renumber_with_entry(segments: []Segment, entry: Int64) RETURNS Tuple<[]Segment, {Int64}Int64> ->
  MUTABLE mapping: {Int64}Int64 = {};
    mapping[entry] = 0;
  MUTABLE next_id = 1;
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < segments.length() DO
    IF (rtoc_idx == entry) THEN
      rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    mapping[rtoc_idx] = next_id;
    next_id = (next_id + 1);
  rtoc_idx = rtoc_idx + 1;
  END
  MUTABLE remapped = (segments |> SELECT {
  MUTABLE new_idx: Int64 = UNWRAP (mapping[_.index]);
  MUTABLE new_tail = fsmRecursiveSplitter__remap_tail(_.tail, mapping);
  Segment{ index: COPY new_idx, stmts: COPY _.stmts, tail: COPY new_tail }
  }) |> ORDER_BY _.index;
  RETURN CAST(Tuple{remapped, COPY mapping} AS Tuple<[]Segment, {Int64}Int64>);
END
PRIVATE FN fsmRecursiveSplitter__remap_tail(tail: SegmentTail, mapping: {Int64}Int64) RETURNS SegmentTail ->
  IF tail IS_A Goto AS goto THEN
    RETURN SegmentTail{ Goto: COPY Goto{ target_index: mapping[goto.target_index]? } };
  ELSE_IF tail IS_A LoopBack AS loop_back THEN
    RETURN SegmentTail{ LoopBack: COPY LoopBack{ target_index: mapping[loop_back.target_index]? } };
  ELSE_IF tail IS_A CondBranch AS cond_branch THEN
    RETURN SegmentTail{ CondBranch: COPY CondBranch{ cond_ast: cond_branch.cond_ast, then_index: mapping[cond_branch.then_index]?, else_index: mapping[cond_branch.else_index]? } };
  ELSE_IF tail IS_A IoSuspend AS io_suspend THEN
    RETURN ioSuspend__with_next_index(io_suspend, IF io_suspend.next_index THEN
      mapping[UNWRAP (io_suspend.next_index)]?
    ELSE
      NIL
    END);
  ELSE_IF tail IS_A NextSuspend AS next_suspend THEN
    RETURN nextSuspend__with_next_index(next_suspend, IF next_suspend.next_index THEN
      mapping[UNWRAP (next_suspend.next_index)]?
    ELSE
      NIL
    END);
  ELSE_IF tail IS_A LockSuspend AS lock_suspend THEN
    RETURN SegmentTail{ LockSuspend: COPY LockSuspend{ with_node: KEEP lock_suspend.with_node, cap: COPY lock_suspend.cap, prior_caps: COPY lock_suspend.prior_caps, post_acquire_idx: IF lock_suspend.post_acquire_idx THEN
      mapping[UNWRAP (lock_suspend.post_acquire_idx)]?
    ELSE
      NIL
    END, next_index: IF lock_suspend.next_index THEN
      mapping[UNWRAP (lock_suspend.next_index)]?
    ELSE
      NIL
    END, lock_index: lock_suspend.lock_index, prior_lock_indices: COPY lock_suspend.prior_lock_indices } };
  ELSE
    RETURN COPY tail;
  END
END
