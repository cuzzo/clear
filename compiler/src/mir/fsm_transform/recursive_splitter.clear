d, MaxOpMultiowned: MaxOp@multiowned, ShardOp: ShardOp, ConcurrentOp: ConcurrentOp, Placeholder: Placeholder, Copy: Copy, MIROptionalUnwrap: MIROptionalUnwrap, TenseNavigation: TenseNavigation, MutableBorrow: MutableBorrow, OrElseRaise: OrElseRaise, OrElseExit: OrElseExit, OrElsePass: OrElsePass, OrElsePrune: OrElsePrune, OrElseBreak: OrElseBreak, CatchBlock: CatchBlock, RecoverOp: RecoverOp, MIRBlockExpr: MIRBlockExpr, StringConcat: StringConcat, CapabilityWrap: CapabilityWrap, MoveNode: MoveNode, CopyNode: CopyNode, KeepNode: KeepNode, ShareNode: ShareNode, LinkNode: LinkNode, ResolveNode: ResolveNode, FreezeNode: FreezeNode, PassStmt: PassStmt, StructPattern: StructPattern, MIRRangeLit: MIRRangeLit, ExternFnDecl: ExternFnDecl, ExternStructDecl: ExternStructDecl, MIREnumDef: MIREnumDef, UnionDef: UnionDef, UnionVariantLit: UnionVariantLit, StaticCall: StaticCall, MIRDoBlock: MIRDoBlock, MIRBgBlock: MIRBgBlock, ThenChain: ThenChain, BgStreamBlock: BgStreamBlock, YieldExpr: YieldExpr, CloseStream: CloseStream, NextExpr: NextExpr, MatchStatement: MatchStatement, ForRange: ForRange, ForEach: ForEach, TestBlock: TestBlock, WhenBlock: WhenBlock, LetBinding: LetBinding, TestThat: TestThat, AssertRaisesMultiowned: AssertRaises@multiowned, BenchmarkStmtMultiowned: BenchmarkStmt@multiowned, SmashStmtMultiowned: SmashStmt@multiowned, ProfileStmtMultiowned: ProfileStmt@multiowned, StubDecl: StubDecl, Drop: Drop, SuppressCleanup: SuppressCleanup, Return: Return, ReassignCleanup: ReassignCleanup, FieldCleanup: FieldCleanup, Emittable: Emittable, FunctionDef: FunctionDef, WithBlock: WithBlock, SelectOp: SelectOp, WhereOp: WhereOp, IndexOp: IndexOp, ReduceOp: ReduceOp, OrderByOp: OrderByOp, UnnestOp: UnnestOp, DistinctOp: DistinctOp, TakeWhileOp: TakeWhileOp, WindowOp: WindowOp, BatchWindowOp: BatchWindowOp, FindOp: FindOp, AnyOp: AnyOp, AllOp: AllOp, CountOp: CountOp, SumOp: SumOp, AverageOp: AverageOp, MinOp: MinOp, MaxOp: MaxOp, AssertRaises: AssertRaises, BenchmarkStmt: BenchmarkStmt, SmashStmt: SmashStmt, ProfileStmt: ProfileStmt }
PUB UNION SegmentSlot { Segment: Segment, SymbolValue: String@symbol }
PUB STRUCT SegmentList {
  segments: []Segment,
  synthetic_fields: []ContextFieldDecl,
  alias_overrides_by_index: {Int64}{String}String
}

PUB FN segmentList__alias_overrides_for(self: SegmentList, index_value: Int64) RETURNS !?{String}String ->
  RETURN COPY self.alias_overrides_by_index[index_value];
END
PUB STRUCT Builder {
  alias_overrides_for: {Int64}{String}String,
  current_alias_overrides: ?{String}String,
  next_lock_index: Int64,
  segments: []SegmentSlot,
  synthetic_fields: []ContextFieldDecl
}

PUB STRUCT Finalized {
  segments: []Segment,
  alias_overrides_by_index: {Int64}{String}String
}
PUB FN builder__initialize(MUTABLE self: Builder) RETURNS Void ->
    self.segments = List[];
    self.synthetic_fields = List[];
    self.alias_overrides_for = {};
    self.current_alias_overrides = NIL;
    self.next_lock_index = 0;
END
PUB FN builder__with_alias_overrides<U>(MUTABLE self: Builder, overrides: {String}String, blk: FN() -> U) RETURNS U
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE prev: ?{String}String = COPY rtoc_self_view.current_alias_overrides;
  DEFER rtoc_self_view.current_alias_overrides = prev;
  MUTABLE merged: {String}String = (COPY prev OR_ELSE {});
  &merged.merge_mut(COPY overrides);
  rtoc_self_view.current_alias_overrides = merged;
  RETURN blk();
}
END
PUB FN builder__stamp_overrides(MUTABLE self: Builder, idx: Int64) RETURNS Void ->
    IF self.current_alias_overrides EXISTS THEN
      MUTABLE current_alias_overrides_value: {String}String = COPY UNWRAP (self.current_alias_overrides);
      IF (current_alias_overrides_value.length() == 0) THEN
        RETURN;
      ELSE
        self.alias_overrides_for[idx] = current_alias_overrides_value;
      END
    ELSE
      RETURN;
    END
END
PUB FN builder__add_synthetic_field(MUTABLE self: Builder, decl: ContextFieldDecl) RETURNS Void ->
    IF !(self.synthetic_fields |> ANY (_.name == decl.name)) THEN
      &self.synthetic_fields.append(COPY decl);
    END
    NIL;
END
PUB FN builder__reserve_index(MUTABLE self: Builder) RETURNS Int64 ->
    MUTABLE idx = self.segments.length();
    &self.segments.append(SegmentSlot{ SymbolValue: :placeholder });
    RETURN idx;
END
PUB FN builder__reserve_lock_index(MUTABLE self: Builder) RETURNS Int64 ->
    MUTABLE idx = self.next_lock_index;
    self.next_lock_index = (self.next_lock_index + 1);
    RETURN idx;
END
PUB FN builder__fill(MUTABLE self: Builder, idx: Int64, stmts: []SegmentBodyItem, tail: SegmentTail) RETURNS Int64 ->
    self.segments[idx] = Segment{ index: COPY idx, stmts: COPY stmts, tail: COPY tail };
    builder__stamp_overrides(&self, idx);
    RETURN COPY idx;
END
PUB FN builder__push(MUTABLE self: Builder, stmts: []SegmentBodyItem, tail: SegmentTail) RETURNS Int64 ->
    MUTABLE idx = builder__reserve_index(&self);
    builder__fill(&self, idx, stmts, tail);
    RETURN idx;
END
PUB FN builder__finalize(self: Builder) RETURNS !Finalized ->
    MUTABLE unfilled = {
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE rtoc_indexed_items_1: []SegmentSlot = self.segments;
    MUTABLE rtoc_indexed_output_3 = [];
    MUTABLE rtoc_indexed_i_2 = 0;
    WHILE rtoc_indexed_i_2 < rtoc_indexed_items_1.length() DO
      IF ruby_union_scalar_equal_SegmentSlot_String_symbol(UNWRAP (rtoc_indexed_items_1[rtoc_indexed_i_2]), :placeholder) THEN
        &rtoc_indexed_output_3.append(COPY UNWRAP (rtoc_indexed_items_1[rtoc_indexed_i_2]));
      END
      rtoc_indexed_i_2 = rtoc_indexed_i_2 + 1;
    END
    rtoc_indexed_output_3
    };
    IF (unfilled).any?() THEN
      panic("RecursiveSplitter: unfilled segments at indices {}");
    END
    RETURN Finalized{ segments: COPY CAST(self.segments AS []Segment), alias_overrides_by_index: COPY self.alias_overrides_for };
END
PUB FN builder__new() RETURNS Builder@multiowned ->
  MUTABLE self = Builder{ alias_overrides_for: {}, current_alias_overrides: NIL, next_lock_index: 0, segments: List[], synthetic_fields: List[] };
  builder__initialize(&self);
  RETURN self @multiowned;
END
PUB FN fsmRecursiveSplitter__split(body: []Locatable, MUTABLE lowering: MIRLowering, ctx: ?{String@symbol}?TransformValue = NIL) RETURNS !?SegmentList ->
  IF TRY (fsmRecursiveSplitter__contains_unsupported?( CAST(CAST(COPY body AS ?Body) AS ?[]Locatable))) THEN
    RETURN NIL;
  END
  MUTABLE builder = builder__new();
  MUTABLE done_idx = builder__reserve_index(&builder);
  MUTABLE entry: ?Int64 = TRY (fsmRecursiveSplitter__emit_stmts_or_nil(body, done_idx, &builder, &lowering, (ctx OR_ELSE {})));
  IF entry EXISTS AS entry_value THEN
    MUTABLE entry_value_mutable = COPY entry_value;
    builder__fill(&builder, done_idx, List[], SegmentTail{ Done: COPY Done{ _: NIL } });
    MUTABLE finalized = TRY (builder__finalize(builder));
    MUTABLE pre_renumber_overrides = COPY finalized.alias_overrides_by_index;
    MUTABLE segments, mapping = fsmRecursiveSplitter__renumber_with_entry(finalized.segments, entry_value_mutable);
    MUTABLE synth = COPY builder.synthetic_fields;
    # Ruby: pre_renumber_overrides.each_with_object({}) { |(orig, ov), h| ... }
    MUTABLE alias_table: {Int64}{String}String = {};
    FOR rtoc_alias_key IN pre_renumber_overrides.keys() DO
      MUTABLE ov = COPY UNWRAP (pre_renumber_overrides[rtoc_alias_key]);
      MUTABLE new_idx = UNWRAP (mapping[rtoc_alias_key]);
      alias_table[new_idx] = ov;
    END
    RETURN SegmentList{ segments: COPY segments, synthetic_fields: COPY synth, alias_overrides_by_index: COPY alias_table };
  ELSE
    RETURN NIL;
  END
END
PRIVATE FN fsmRecursiveSplitter__emit_stmts_or_nil(body: []Locatable, after_idx: Int64, MUTABLE builder: Builder, MUTABLE lowering: MIRLowering, ctx: {String@symbol}?TransformValue) RETURNS !?Int64 ->
  RETURN TRY (fsmRecursiveSplitter__emit_stmts(castLocatableListToSegmentStmtList(body), after_idx, &builder, &lowering, ctx));
CATCH Input
  RETURN NIL;
END
PRIVATE FN fsmRecursiveSplitter__emit_stmts(stmts: []SegmentStmt, after_idx: Int64, MUTABLE builder: Builder, MUTABLE lowering: MIRLowering, ctx: {String@symbol}?TransformValue) RETURNS !Int64 EFFECTS REENTRANT ->
  IF (FALSE OR (stmts.length() == 0)) THEN
    RETURN COPY after_idx;
  END
  MUTABLE pivot_idx: ?Int64 = NIL;
  MUTABLE rtoc_scan = 0;
  WHILE (rtoc_scan < stmts.length()) DO
    IF TRY (fsmRecursiveSplitter__stmt_introduces_split?(stmts[rtoc_scan])) THEN
      pivot_idx = rtoc_scan;
      BREAK;
    END
    rtoc_scan = (rtoc_scan + 1);
  END
  IF (pivot_idx == NIL) THEN
    RETURN builder__push(&builder, fsmRecursiveSplitter__as_body(stmts), SegmentTail{ Goto: COPY Goto{ target_index: COPY after_idx } });
  END
  MUTABLE rtoc_pivot_at: Int64 = pivot_idx;
  MUTABLE pre: []SegmentStmt = List[];
  MUTABLE rest: []SegmentStmt = List[];
  MUTABLE rtoc_split = 0;
  WHILE (rtoc_split < stmts.length()) DO
    IF (rtoc_split < rtoc_pivot_at) THEN
      &pre.append(COPY UNWRAP (stmts[rtoc_split]));
    ELSE_IF (rtoc_split > rtoc_pivot_at) THEN
      &rest.append(COPY UNWRAP (stmts[rtoc_split]));
    END
    rtoc_split = (rtoc_split + 1);
  END
  MUTABLE pivot: ?SegmentStmt = COPY stmts[rtoc_pivot_at];
  MUTABLE rest_entry = TRY (fsmRecursiveSplitter__emit_stmts(rest, after_idx, &builder, &lowering, ctx));
  MUTABLE sus: ?SegmentTail = NIL;
  IF pivot EXISTS AS rtoc_pivot_value THEN
    sus = TRY (segments__classify_suspend(castOptionalSegmentStmtToLocatable(rtoc_pivot_value)));
  END
  IF sus EXISTS AS rtoc_suspend_tail THEN
    RETURN TRY (fsmRecursiveSplitter__emit_suspend_with_pre(castSegmentTailToSuspendTail(rtoc_suspend_tail), pre, rest_entry, &builder));
  ELSE
    MUTABLE pivot_entry = TRY (fsmRecursiveSplitter__emit_pivot(UNWRAP (pivot), rest_entry, &builder, &lowering, ctx));
    IF pre.empty?() THEN
      RETURN pivot_entry;
    ELSE
      RETURN builder__push(&builder, fsmRecursiveSplitter__as_body(pre), SegmentTail{ Goto: COPY Goto{ target_index: pivot_entry } });
    END
  END
END
PRIVATE FN fsmRecursiveSplitter__emit_suspend_with_pre(susp_tail: SuspendTail, pre_value: []SegmentStmt, after_idx: Int64, MUTABLE builder: Builder) RETURNS !Int64 ->
  MUTABLE idx = builder__reserve_index(&builder);
  IF !(segments__suspend_tail?(castSuspendTailToOptionalSegmentTail(susp_tail))) THEN
    RAISE Input, FsmUnsupportedShape, "Unhandled suspend kind {}";
  END
  MUTABLE tail = suspendTail__with_next_index(susp_tail, after_idx);
  builder__fill(&builder, idx, fsmRecursiveSplitter__as_body(pre_value), tail);
  RETURN idx;
END
# Ruby asks `stmt.is_a?(AST::Locatable)`. SegmentStmt carries both the AST
# nodes and the MIR ones, so the question is whether this variant is one of
# the AST kinds.
PRIVATE FN segmentStmt__locatable?(value: SegmentStmt) RETURNS Bool ->
  PARTIAL MATCH value START
    SegmentStmt.RequireNode AS item -> RETURN TRUE;,
    SegmentStmt.ProtocolRequirement AS item -> RETURN TRUE;,
    SegmentStmt.ProtocolDef AS item -> RETURN TRUE;,
    SegmentStmt.ImplementationDef AS item -> RETURN TRUE;,
    SegmentStmt.ConformanceDef AS item -> RETURN TRUE;,
    SegmentStmt.VarDecl AS item -> RETURN TRUE;,
