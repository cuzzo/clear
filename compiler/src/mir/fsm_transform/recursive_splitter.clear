FN castSuspendTailToOptionalSegmentTail(value: SuspendTail) RETURNS ?SegmentTail ->
  PARTIAL MATCH value START
    SuspendTail.IoSuspend AS cast_payload -> RETURN SegmentTail{ IoSuspend: COPY cast_payload };,
    SuspendTail.NextSuspend AS cast_payload -> RETURN SegmentTail{ NextSuspend: COPY cast_payload };,
    SuspendTail.LockSuspend AS cast_payload -> RETURN SegmentTail{ LockSuspend: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to ?SegmentTail");
  END
  panic("Invalid cast to ?SegmentTail");
END
FN castTransformValueToHashMapStringTypeMultiowned(value: TransformValue) RETURNS {String}Type@multiowned ->
  IF value IS_A {String}Type@multiowned AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN {};
END
FN ruby_array_concat_Emittable(left: []Emittable, right: []Emittable) RETURNS []Emittable ->
  MUTABLE result: []Emittable = [];
  FOR rtoc_left_item IN left DO
    &result.append(COPY rtoc_left_item);
  END
  FOR rtoc_right_item IN right DO
    &result.append(COPY rtoc_right_item);
  END
  RETURN result;
END
FN ruby_union_scalar_equal_SegmentSlot_String_symbol(value: SegmentSlot, expected: String@symbol) RETURNS Bool ->
  IF value IS_A String@symbol AS equality_payload THEN
    RETURN equality_payload == expected;
  END
  FALSE;
END
