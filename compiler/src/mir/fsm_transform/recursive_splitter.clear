PRIVATE FN recursiveSplitter__emit_with_fragment(with_stmt: WithBlock, after_idx: Int64, MUTABLE builder: Builder, lowering: MIRLowering, ctx: {String@symbol}?TransformValue) RETURNS !Int64 ->
  MUTABLE caps = TRY (withCapabilityPlan__locks((TRY (capabilityPlan__require_for(with_stmt)))));
  IF (caps.length == 0) THEN
    panic("WITH with no capabilities");
  END
  MUTABLE ctx_id_raw: ?TransformValue = COPY ctx[:id];
  IF ctx_id_raw? IS_A Int64 AS int64 THEN
    MUTABLE int64_mutable = COPY int64;
    MUTABLE ctx_id: Int64 = CAST(int64_mutable AS Int64);
    MUTABLE captured: {String}Type@multiowned = castTransformValueToHashMapStringTypeMultiowned((ctx[:captured] OR_ELSE {}));
    MUTABLE bg_rt_raw: ?TransformValue = COPY ctx[:bg_rt];
    IF bg_rt_raw? IS_A String AS string THEN
      MUTABLE string_mutable = COPY string;
      MUTABLE bg_rt: String = CAST(string_mutable AS String);
      MUTABLE caps_meta: []{String@symbol}FsmCapMetadataValue = ( { MUTABLE rtoc_empty_list_6: []{String@symbol}FsmCapMetadataValue = List[]; rtoc_empty_list_6 } );
      FOR _ IN caps DO
  MUTABLE m = mIRLowering__fsm_cap_metadata(lowering, _, with_stmt, ctx_id, captured);
  IF (m == NIL) THEN
          panic("fsm_cap_metadata failed");
  END
  &caps_meta.append(CAST(m AS {String@symbol}FsmCapMetadataValue));
      END
      MUTABLE cap_indices = caps |> SELECT builder__reserve_index(&builder);
      MUTABLE lock_indices = caps |> SELECT builder__reserve_lock_index(&builder);
      MUTABLE release_idx = builder__reserve_index(&builder);
      MUTABLE body_stmts = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_8: ?[]Locatable = NIL;
      IF with_stmt.body IS_A []Any THEN
        rtoc_ternary_value_8 = with_stmt.body;
      ELSE
        rtoc_ternary_value_8 = [with_stmt.body];
      END
      rtoc_ternary_value_8? };
      MUTABLE alias_overrides: {String}String = {};
      FOR _ IN caps_meta DO
      alias_overrides[CAST(_[:alias_name]? AS String)] = COPY CAST(_[:alias_data_ref]? AS String);
      END
      MUTABLE cs_entry: Int64 = CAST(builder__with_alias_overrides(&builder, alias_overrides, %() USE(alias_overrides, bg_rt, body_stmts, MUTABLE builder, ctx, lowering, release_idx) -> {
  rtoc_lambda_result_14 = mIRLowering__with_fiber_capture_map(lowering, alias_overrides, {:rt_override: bg_rt}, %() USE(body_stmts, MUTABLE builder, ctx, lowering, release_idx) -> {
  rtoc_lambda_result_13 = TRY (recursiveSplitter__emit_stmts(body_stmts, release_idx, &builder, lowering, ctx));
  rtoc_lambda_result_13
      });
  rtoc_lambda_result_14
      }) AS Int64);
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < caps.length DO
    MUTABLE post_acquire: Int64 = 0_i64;
          IF (((rtoc_idx + 1) < caps.length)) THEN
            post_acquire = COPY UNWRAP (cap_indices[(rtoc_idx + 1)]);
          ELSE
            post_acquire = cs_entry;
          END
    MUTABLE prior = COPY UNWRAP (caps.substr(0, (rtoc_idx - 0)));
    builder__fill(&builder, UNWRAP (cap_indices[rtoc_idx]), ( { MUTABLE rtoc_empty_list_15: []SegmentStmt = List[]; rtoc_empty_list_15 } ), SegmentTail{ LockSuspend: COPY LockSuspend{ with_node: with_stmt, cap: LockCap{ CapabilityTransition: COPY caps[rtoc_idx]? }, prior_caps: COPY prior, post_acquire_idx: post_acquire, next_index: COPY after_idx, lock_index: COPY UNWRAP (lock_indices[rtoc_idx]), prior_lock_indices: COPY (lock_indices.substr(0, (rtoc_idx - 0)) OR_ELSE List[]) } });
  rtoc_idx = rtoc_idx + 1;
      END
      MUTABLE release_stmts: []Emittable = ( { MUTABLE rtoc_empty_list_16: []Emittable = List[]; rtoc_empty_list_16 } );
      ({
  MUTABLE rtoc_value_block_marker = 0;
  MUTABLE rtoc_indexed_items_17: []{String@symbol}FsmCapMetadataValue = caps_meta;
  MUTABLE rtoc_indexed_output_19 = [];
  MUTABLE rtoc_indexed_i_18 = 0;
  WHILE rtoc_indexed_i_18 < rtoc_indexed_items_17.length DO
    &rtoc_indexed_output_19.append(Tuple{COPY rtoc_indexed_items_17[rtoc_indexed_i_18], rtoc_indexed_i_18});
    rtoc_indexed_i_18 = rtoc_indexed_i_18 + 1;
  END
  rtoc_indexed_output_19
      }).reverse().keys() |> EACH {
  MUTABLE i: Any = (({
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE rtoc_indexed_items_17: []{String@symbol}FsmCapMetadataValue = caps_meta;
    MUTABLE rtoc_indexed_output_19 = [];
    MUTABLE rtoc_indexed_i_18 = 0;
    WHILE rtoc_indexed_i_18 < rtoc_indexed_items_17.length DO
      &rtoc_indexed_output_19.append(Tuple{COPY rtoc_indexed_items_17[rtoc_indexed_i_18], rtoc_indexed_i_18});
      rtoc_indexed_i_18 = rtoc_indexed_i_18 + 1;
    END
    rtoc_indexed_output_19
  }).reverse()[_] OR_ELSE panic("missing hash key"));
      ruby_array_concat_Emittable(release_stmts, TRY (recursiveSplitter__lock_release_stmts(ctx_id, UNWRAP (lock_indices[i]), CAST((UNWRAP (_[:lock_field_ref])) AS String), CAST((UNWRAP (_[:unlock_method])) AS String))));
      };
      builder__fill(&builder, release_idx, release_stmts, SegmentTail{ Goto: COPY Goto{ target_index: COPY after_idx } });
      RETURN UNWRAP (cap_indices.first());
    ELSE
      panic("WITH split without runtime");
    END
  ELSE
    panic("WITH split without ctx");
  END
END
PRIVATE FN recursiveSplitter__lock_release_stmts(ctx_id: Int64, lock_index: Int64, lock_field_ref: String, unlock_method: String) RETURNS ![]Emittable ->
  RETURN CAST([Emittable{ Set: COPY Set{ target: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__ctx_${ctx_id.toString()}", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "__lock_held_${lock_index.toString()}", lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Lit: COPY Lit{ value: "false", lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: COPY Ident{ name: COPY lock_field_ref, lowered_node_id: NIL, ownership_consumption: NIL }, method: COPY unlock_method, args: ( { MUTABLE rtoc_empty_list_21: []Any = List[]; rtoc_empty_list_21 } ), try_wrap: FALSE, callable_contract: NIL, owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable);
END
PRIVATE FN recursiveSplitter__renumber_with_entry(segments: []Segment, entry: Int64) RETURNS Tuple<[]Segment, {Int64}Int64> ->
  MUTABLE mapping = {entry: 0};
  MUTABLE next_id = 1;
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < segments.length DO
    IF (rtoc_idx == entry) THEN
      rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    mapping[rtoc_idx] = next_id;
    next_id = (next_id + 1);
  rtoc_idx = rtoc_idx + 1;
  END
  MUTABLE remapped = (segments |> SELECT {
  MUTABLE new_idx: ?Any = COPY mapping[_.index];
  MUTABLE new_tail = recursiveSplitter__remap_tail(_.tail, mapping);
  Segment{ index: COPY new_idx, stmts: COPY _.stmts, tail: COPY new_tail }
  }) |> ORDER_BY _.index;
  RETURN CAST(Tuple{remapped, mapping} AS Tuple<[]Segment, {Int64}Int64>);
END
PRIVATE FN recursiveSplitter__remap_tail(tail: SegmentTail, mapping: {Int64}Int64) RETURNS SegmentTail ->
  IF tail IS_A Goto AS goto THEN
    RETURN SegmentTail{ Goto: COPY Goto{ target_index: mapping[goto.target_index]? } };
  ELSE_IF tail IS_A LoopBack AS loop_back THEN
    RETURN SegmentTail{ LoopBack: COPY LoopBack{ target_index: mapping[loop_back.target_index]? } };
  ELSE_IF tail IS_A CondBranch AS cond_branch THEN
    RETURN SegmentTail{ CondBranch: COPY CondBranch{ cond_ast: cond_branch.cond_ast, then_index: mapping[cond_branch.then_index]?, else_index: mapping[cond_branch.else_index]? } };
  ELSE_IF tail IS_A IoSuspend AS io_suspend THEN
    RETURN ioSuspend__with_next_index(io_suspend, IF io_suspend.next_index THEN
      mapping[io_suspend.next_index]?
    ELSE
      NIL
    END);
  ELSE_IF tail IS_A NextSuspend AS next_suspend THEN
    RETURN nextSuspend__with_next_index(next_suspend, IF next_suspend.next_index THEN
      mapping[next_suspend.next_index]?
    ELSE
      NIL
    END);
  ELSE_IF tail IS_A LockSuspend AS lock_suspend THEN
    RETURN SegmentTail{ LockSuspend: COPY LockSuspend{ with_node: KEEP lock_suspend.with_node, cap: COPY lock_suspend.cap, prior_caps: COPY lock_suspend.prior_caps, post_acquire_idx: IF lock_suspend.post_acquire_idx THEN
      mapping[lock_suspend.post_acquire_idx]?
    ELSE
      NIL
    END, next_index: IF lock_suspend.next_index THEN
      mapping[lock_suspend.next_index]?
    ELSE
      NIL
    END, lock_index: lock_suspend.lock_index, prior_lock_indices: COPY lock_suspend.prior_lock_indices } };
  ELSE
    RETURN COPY tail;
  END
END
