    SegmentStmt.BinaryOp AS item -> RETURN TRUE;,
    SegmentStmt.IsA AS item -> RETURN TRUE;,
    SegmentStmt.CallSiteOverride AS item -> RETURN TRUE;,
    SegmentStmt.Identifier AS item -> RETURN TRUE;,
    SegmentStmt.Literal AS item -> RETURN TRUE;,
    SegmentStmt.ListLit AS item -> RETURN TRUE;,
    SegmentStmt.TupleLit AS item -> RETURN TRUE;,
    SegmentStmt.DefaultArrayLit AS item -> RETURN TRUE;,
    SegmentStmt.HashLit AS item -> RETURN TRUE;,
    SegmentStmt.DefaultLit AS item -> RETURN TRUE;,
    SegmentStmt.StructLit AS item -> RETURN TRUE;,
