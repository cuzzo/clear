FN castLocatableToOptionalSegmentStmt(value: Locatable) RETURNS ?SegmentStmt ->
  PARTIAL MATCH value START
    Locatable.RequireNode AS cast_payload -> RETURN SegmentStmt{ RequireNode: COPY cast_payload };,
    Locatable.ProtocolRequirement AS cast_payload -> RETURN SegmentStmt{ ProtocolRequirement: COPY cast_payload };,
    Locatable.ProtocolDef AS cast_payload -> RETURN SegmentStmt{ ProtocolDef: COPY cast_payload };,
    Locatable.FunctionDef AS cast_payload -> RETURN SegmentStmt{ FunctionDef: COPY cast_payload };,
    Locatable.ImplementationDef AS cast_payload -> RETURN SegmentStmt{ ImplementationDef: COPY cast_payload };,
    Locatable.ConformanceDef AS cast_payload -> RETURN SegmentStmt{ ConformanceDef: COPY cast_payload };,
    Locatable.VarDecl AS cast_payload -> RETURN SegmentStmt{ VarDecl: COPY cast_payload };,
    Locatable.Assignment AS cast_payload -> RETURN SegmentStmt{ Assignment: COPY cast_payload };,
    Locatable.DestructuringAssignment AS cast_payload -> RETURN SegmentStmt{ DestructuringAssignment: COPY cast_payload };,
    Locatable.BindExpr AS cast_payload -> RETURN SegmentStmt{ BindExpr: COPY cast_payload };,
    Locatable.BinaryOp AS cast_payload -> RETURN SegmentStmt{ BinaryOp: COPY cast_payload };,
    Locatable.IsA AS cast_payload -> RETURN SegmentStmt{ IsA: COPY cast_payload };,
    Locatable.CallSiteOverride AS cast_payload -> RETURN SegmentStmt{ CallSiteOverride: COPY cast_payload };,
    Locatable.Identifier AS cast_payload -> RETURN SegmentStmt{ Identifier: COPY cast_payload };,
    Locatable.Literal AS cast_payload -> RETURN SegmentStmt{ Literal: COPY cast_payload };,
    Locatable.ListLit AS cast_payload -> RETURN SegmentStmt{ ListLit: COPY cast_payload };,
    Locatable.TupleLit AS cast_payload -> RETURN SegmentStmt{ TupleLit: COPY cast_payload };,
    Locatable.DefaultArrayLit AS cast_payload -> RETURN SegmentStmt{ DefaultArrayLit: COPY cast_payload };,
    Locatable.HashLit AS cast_payload -> RETURN SegmentStmt{ HashLit: COPY cast_payload };,
    Locatable.DefaultLit AS cast_payload -> RETURN SegmentStmt{ DefaultLit: COPY cast_payload };,
    Locatable.StructLit AS cast_payload -> RETURN SegmentStmt{ StructLit: COPY cast_payload };,
    Locatable.LambdaLit AS cast_payload -> RETURN SegmentStmt{ LambdaLit: COPY cast_payload };,
    Locatable.IfStatement AS cast_payload -> RETURN SegmentStmt{ IfStatement: COPY cast_payload };,
    Locatable.IfBind AS cast_payload -> RETURN SegmentStmt{ IfBind: COPY cast_payload };,
    Locatable.WhileLoop AS cast_payload -> RETURN SegmentStmt{ WhileLoop: COPY cast_payload };,
    Locatable.WhileBindLoop AS cast_payload -> RETURN SegmentStmt{ WhileBindLoop: COPY cast_payload };,
    Locatable.BreakNode AS cast_payload -> RETURN SegmentStmt{ BreakNode: COPY cast_payload };,
    Locatable.ContinueNode AS cast_payload -> RETURN SegmentStmt{ ContinueNode: COPY cast_payload };,
    Locatable.FuncCall AS cast_payload -> RETURN SegmentStmt{ FuncCall: COPY cast_payload };,
    Locatable.GetField AS cast_payload -> RETURN SegmentStmt{ GetField: COPY cast_payload };,
    Locatable.GetIndex AS cast_payload -> RETURN SegmentStmt{ GetIndex: COPY cast_payload };,
    Locatable.ReturnNode AS cast_payload -> RETURN SegmentStmt{ ReturnNode: COPY cast_payload };,
    Locatable.Assert AS cast_payload -> RETURN SegmentStmt{ Assert: COPY cast_payload };,
    Locatable.Raise AS cast_payload -> RETURN SegmentStmt{ Raise: COPY cast_payload };,
    Locatable.ThrowNode AS cast_payload -> RETURN SegmentStmt{ ThrowNode: COPY cast_payload };,
    Locatable.DieNode AS cast_payload -> RETURN SegmentStmt{ DieNode: COPY cast_payload };,
    Locatable.Slice AS cast_payload -> RETURN SegmentStmt{ Slice: COPY cast_payload };,
    Locatable.Require AS cast_payload -> RETURN SegmentStmt{ Require: COPY cast_payload };,
    Locatable.WithBlock AS cast_payload -> RETURN SegmentStmt{ WithBlock: COPY cast_payload };,
    Locatable.SyncPolicyDecl AS cast_payload -> RETURN SegmentStmt{ SyncPolicyDecl: COPY cast_payload };,
    Locatable.SelectOp AS cast_payload -> RETURN SegmentStmt{ SelectOp: COPY cast_payload };,
    Locatable.WhereOp AS cast_payload -> RETURN SegmentStmt{ WhereOp: COPY cast_payload };,
    Locatable.IndexOp AS cast_payload -> RETURN SegmentStmt{ IndexOp: COPY cast_payload };,
    Locatable.ReduceOp AS cast_payload -> RETURN SegmentStmt{ ReduceOp: COPY cast_payload };,
    Locatable.OrderByOp AS cast_payload -> RETURN SegmentStmt{ OrderByOp: COPY cast_payload };,
    Locatable.LimitOp AS cast_payload -> RETURN SegmentStmt{ LimitOp: COPY cast_payload };,
    Locatable.UnnestOp AS cast_payload -> RETURN SegmentStmt{ UnnestOp: COPY cast_payload };,
    Locatable.DistinctOp AS cast_payload -> RETURN SegmentStmt{ DistinctOp: COPY cast_payload };,
    Locatable.EachOp AS cast_payload -> RETURN SegmentStmt{ EachOp: COPY cast_payload };,
    Locatable.TapOp AS cast_payload -> RETURN SegmentStmt{ TapOp: COPY cast_payload };,
    Locatable.SkipOp AS cast_payload -> RETURN SegmentStmt{ SkipOp: COPY cast_payload };,
    Locatable.CollectOp AS cast_payload -> RETURN SegmentStmt{ CollectOp: COPY cast_payload };,
    Locatable.TakeWhileOp AS cast_payload -> RETURN SegmentStmt{ TakeWhileOp: COPY cast_payload };,
    Locatable.WindowOp AS cast_payload -> RETURN SegmentStmt{ WindowOp: COPY cast_payload };,
    Locatable.BatchWindowOp AS cast_payload -> RETURN SegmentStmt{ BatchWindowOp: COPY cast_payload };,
    Locatable.JoinOp AS cast_payload -> RETURN SegmentStmt{ JoinOp: COPY cast_payload };,
