FN castSegmentTailToSuspendTail(value: SegmentTail) RETURNS SuspendTail ->
  PARTIAL MATCH value START
    SegmentTail.IoSuspend AS cast_payload -> RETURN SuspendTail{ IoSuspend: COPY cast_payload };,
