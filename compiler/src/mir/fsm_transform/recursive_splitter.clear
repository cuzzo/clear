# Ruby module FsmTransform::RecursiveSplitter
PUB UNION SegmentStmt { MIRProgram: MIRProgram, RequireNode: RequireNode, ProtocolRequirement: ProtocolRequirement, ProtocolDef: ProtocolDef, FunctionDefMultiowned: FunctionDef@multiowned, ImplementationDef: ImplementationDef, ConformanceDef: ConformanceDef, MIRStructDef: MIRStructDef, VarDecl: VarDecl, Assignment: Assignment, MIRDestructureTarget: MIRDestructureTarget, DestructuringAssignment: DestructuringAssignment, BindExpr: BindExpr, BinaryOp: BinaryOp, IsA: IsA, MIRUnaryOp: MIRUnaryOp, CallSiteOverride: CallSiteOverride, Identifier: Identifier, Literal: Literal, ListLit: ListLit, TupleLit: TupleLit, DefaultArrayLit: DefaultArrayLit, HashLit: HashLit, DefaultLit: DefaultLit, StructLit: StructLit, LambdaLit: LambdaLit, IfStatement: IfStatement, IfBind: IfBind, WhileLoop: WhileLoop, WhileBindLoop: WhileBindLoop, BreakNode: BreakNode, ContinueNode: ContinueNode, FuncCall: FuncCall, MIRMethodCall: MIRMethodCall, GetField: GetField, GetIndex: GetIndex, MIRCast: MIRCast, ReturnNode: ReturnNode, Assert: Assert, Raise: Raise, ThrowNode: ThrowNode, DieNode: DieNode, Slice: Slice, Require: Require, MIRDeferStmt: MIRDeferStmt, WithBlockMultiowned: WithBlock@multiowned, SyncPolicyDecl: SyncPolicyDecl, SelectOpMultiowned: SelectOp@multiowned, WhereOpMultiowned: WhereOp@multiowned, IndexOpMultiowned: IndexOp@multiowned, ReduceOpMultiowned: ReduceOp@multiowned, OrderByOpMultiowned: OrderByOp@multiowned, LimitOp: LimitOp, UnnestOpMultiowned: UnnestOp@multiowned, DistinctOpMultiowned: DistinctOp@multiowned, EachOp: EachOp, TapOp: TapOp, SkipOp: SkipOp, CollectOp: CollectOp, TakeWhileOpMultiowned: TakeWhileOp@multiowned, WindowOpMultiowned: WindowOp@multiowned, BatchWindowOpMultiowned: BatchWindowOp@multiowned, JoinOp: JoinOp, FindOpMultiowned: FindOp@multiowned, AnyOpMultiowned: AnyOp@multiowned, AllOpMultiowned: AllOp@multiowned, CountOpMultiowned: CountOp@multiowned, SumOpMultiowned: SumOp@multiowned, AverageOpMultiowned: AverageOp@multiowned, MinOpMultiowned: MinOp@multiowned, MaxOpMultiowned: MaxOp@multiowned, ShardOp: ShardOp, ConcurrentOp: ConcurrentOp, Placeholder: Placeholder, Copy: Copy, MIROptionalUnwrap: MIROptionalUnwrap, TenseNavigation: TenseNavigation, MutableBorrow: MutableBorrow, OrElseRaise: OrElseRaise, OrElseExit: OrElseExit, OrElsePass: OrElsePass, OrElsePrune: OrElsePrune, OrElseBreak: OrElseBreak, CatchBlock: CatchBlock, RecoverOp: RecoverOp, MIRBlockExpr: MIRBlockExpr, StringConcat: StringConcat, CapabilityWrap: CapabilityWrap, MoveNode: MoveNode, CopyNode: CopyNode, KeepNode: KeepNode, ShareNode: ShareNode, LinkNode: LinkNode, ResolveNode: ResolveNode, FreezeNode: FreezeNode, PassStmt: PassStmt, StructPattern: StructPattern, MIRRangeLit: MIRRangeLit, ExternFnDecl: ExternFnDecl, ExternStructDecl: ExternStructDecl, MIREnumDef: MIREnumDef, UnionDef: UnionDef, UnionVariantLit: UnionVariantLit, StaticCall: StaticCall, MIRDoBlock: MIRDoBlock, MIRBgBlock: MIRBgBlock, ThenChain: ThenChain, BgStreamBlock: BgStreamBlock, YieldExpr: YieldExpr, CloseStream: CloseStream, NextExpr: NextExpr, MatchStatement: MatchStatement, ForRange: ForRange, ForEach: ForEach, TestBlock: TestBlock, WhenBlock: WhenBlock, LetBinding: LetBinding, TestThat: TestThat, AssertRaisesMultiowned: AssertRaises@multiowned, BenchmarkStmtMultiowned: BenchmarkStmt@multiowned, SmashStmtMultiowned: SmashStmt@multiowned, ProfileStmtMultiowned: ProfileStmt@multiowned, StubDecl: StubDecl, Drop: Drop, SuppressCleanup: SuppressCleanup, Return: Return, ReassignCleanup: ReassignCleanup, FieldCleanup: FieldCleanup, Emittable: Emittable, FunctionDef: FunctionDef, WithBlock: WithBlock, SelectOp: SelectOp, WhereOp: WhereOp, IndexOp: IndexOp, ReduceOp: ReduceOp, OrderByOp: OrderByOp, UnnestOp: UnnestOp, DistinctOp: DistinctOp, TakeWhileOp: TakeWhileOp, WindowOp: WindowOp, BatchWindowOp: BatchWindowOp, FindOp: FindOp, AnyOp: AnyOp, AllOp: AllOp, CountOp: CountOp, SumOp: SumOp, AverageOp: AverageOp, MinOp: MinOp, MaxOp: MaxOp, AssertRaises: AssertRaises, BenchmarkStmt: BenchmarkStmt, SmashStmt: SmashStmt, ProfileStmt: ProfileStmt }
PUB UNION SegmentSlot { Segment: Segment, SymbolValue: String@symbol }
PUB STRUCT SegmentList {
  segments: []Segment,
  synthetic_fields: []ContextFieldDecl,
  alias_overrides_by_index: {Int64}{String}String
}

PUB FN segmentList__alias_overrides_for(self: SegmentList, index_value: Int64) RETURNS !?{String}String ->
  RETURN COPY self.alias_overrides_by_index[index_value];
END
PUB STRUCT Builder {
  alias_overrides_for: {Int64}{String}String,
  current_alias_overrides: ?{String}String,
  next_lock_index: Int64,
  segments: []SegmentSlot,
  synthetic_fields: []ContextFieldDecl
}

PUB STRUCT Finalized {
  segments: []Segment,
  alias_overrides_by_index: {Int64}{String}String
}
PUB FN builder__initialize(MUTABLE self: Builder) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.segments = List[];
    rtoc_self_view.synthetic_fields = List[];
    rtoc_self_view.alias_overrides_for = {};
    rtoc_self_view.current_alias_overrides = NIL;
    rtoc_self_view.next_lock_index = 0;
}
END
PUB FN builder__with_alias_overrides<U>(MUTABLE self: Builder, overrides: {String}String, blk: FN() -> U) RETURNS U
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE prev: ?{String}String = COPY rtoc_self_view.current_alias_overrides;
  DEFER rtoc_self_view.current_alias_overrides = prev;
  rtoc_self_view.current_alias_overrides = ((prev OR_ELSE {})).merge(overrides);
  RETURN blk();
}
END
PUB FN builder__stamp_overrides(MUTABLE self: Builder, idx: Int64) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF rtoc_self_view.current_alias_overrides EXISTS AS current_alias_overrides_value THEN
      IF (current_alias_overrides_value.count == 0) THEN
        RETURN;
      ELSE
        rtoc_self_view.alias_overrides_for[idx] = UNWRAP (COPY current_alias_overrides_value);
      END
    ELSE
      RETURN;
    END
}
END
PUB FN builder__add_synthetic_field(MUTABLE self: Builder, decl: ContextFieldDecl) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(rtoc_self_view.synthetic_fields |> ANY (_.name == decl.name)) THEN
      &rtoc_self_view.synthetic_fields.append(COPY decl);
    END
    NIL;
}
END
PUB FN builder__reserve_index(MUTABLE self: Builder) RETURNS Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE idx = rtoc_self_view.segments.length;
    &rtoc_self_view.segments.append(SegmentSlot{ SymbolValue: :placeholder });
    RETURN idx;
}
END
PUB FN builder__reserve_lock_index(MUTABLE self: Builder) RETURNS Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE idx = rtoc_self_view.next_lock_index;
    rtoc_self_view.next_lock_index = (rtoc_self_view.next_lock_index + 1);
    RETURN idx;
}
END
PUB FN builder__fill(MUTABLE self: Builder, idx: Int64, stmts: []SegmentStmt, tail: SegmentTail) RETURNS Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.segments[idx] = Segment{ index: COPY idx, stmts: COPY stmts, tail: COPY tail };
    builder__stamp_overrides(&rtoc_self_view, idx);
    RETURN COPY idx;
}
END
PUB FN builder__push(MUTABLE self: Builder, stmts: []SegmentStmt, tail: SegmentTail) RETURNS Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE idx = builder__reserve_index(&rtoc_self_view);
    builder__fill(&rtoc_self_view, idx, stmts, tail);
    RETURN idx;
}
END
PUB FN builder__finalize(self: Builder) RETURNS !Finalized
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE unfilled = {
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE rtoc_indexed_items_1: []SegmentSlot = rtoc_self_view.segments;
    MUTABLE rtoc_indexed_output_3 = [];
    MUTABLE rtoc_indexed_i_2 = 0;
    WHILE rtoc_indexed_i_2 < rtoc_indexed_items_1.length DO
      IF ruby_union_scalar_equal_SegmentSlot_String_symbol(rtoc_indexed_items_1[rtoc_indexed_i_2], :placeholder) THEN
        &rtoc_indexed_output_3.append(COPY rtoc_indexed_items_1[rtoc_indexed_i_2]);
      END
      rtoc_indexed_i_2 = rtoc_indexed_i_2 + 1;
    END
    rtoc_indexed_output_3
    };
    IF type__any?(unfilled) THEN
      panic("RecursiveSplitter: unfilled segments at indices {}");
    END
    RETURN Finalized{ segments: COPY CAST(rtoc_self_view.segments AS []Segment), alias_overrides_by_index: COPY rtoc_self_view.alias_overrides_for };
}
END
PUB FN builder__new() RETURNS Builder@multiowned ->
  MUTABLE self = Builder{ alias_overrides_for: {}, current_alias_overrides: NIL, next_lock_index: 0, segments: List[], synthetic_fields: List[] };
  builder__initialize(&self);
  RETURN self @multiowned;
END
PUB FN recursiveSplitter__split(body: []Locatable, lowering: MIRLowering, ctx: ?{String@symbol}?TransformValue = NIL) RETURNS !?SegmentList ->
  IF TRY (recursiveSplitter__contains_unsupported?(Body{ ArrayValue: COPY body })) THEN
    RETURN NIL;
  END
  MUTABLE builder = builder__new();
  MUTABLE done_idx = builder__reserve_index(&builder);
  MUTABLE entry: ?Int64 = TRY (recursiveSplitter__emit_stmts_or_nil(body, done_idx, builder, lowering, (ctx OR_ELSE {})));
  IF entry EXISTS AS entry_value THEN
    MUTABLE entry_value_mutable = COPY entry_value;
    builder__fill(&builder, done_idx, ( { MUTABLE rtoc_empty_list_4: []SegmentStmt = List[]; rtoc_empty_list_4 } ), SegmentTail{ Done: COPY Done{ _: NIL } });
    MUTABLE finalized = TRY (builder__finalize(builder));
    MUTABLE pre_renumber_overrides = COPY finalized.alias_overrides_by_index;
    MUTABLE segments, mapping = recursiveSplitter__renumber_with_entry(finalized.segments, entry_value_mutable);
    MUTABLE synth = COPY builder.synthetic_fields;
    MUTABLE alias_table = pre_renumber_overrides.each_with_object({}, %(tuple_param_0, h: Tuple<Int64,{String}String>) USE(mapping) -> {
  MUTABLE orig = tuple_param_0._0;
  MUTABLE ov = tuple_param_0._1;
  MUTABLE new_idx = mapping[orig]?;
  h[new_idx] = ov;
  NIL
    });
    RETURN SegmentList{ segments: COPY segments, synthetic_fields: COPY synth, alias_overrides_by_index: COPY alias_table };
  ELSE
    RETURN NIL;
  END
END
PRIVATE FN recursiveSplitter__emit_stmts_or_nil(body: []Locatable, after_idx: Int64, MUTABLE builder: Builder, lowering: MIRLowering, ctx: {String@symbol}?TransformValue) RETURNS !?Int64 ->
  RETURN TRY (recursiveSplitter__emit_stmts(body, after_idx, &builder, lowering, ctx));
CATCH UnsupportedShape
  RETURN NIL;
END
PRIVATE FN recursiveSplitter__emit_stmts(stmts: []SegmentStmt, after_idx: Int64, MUTABLE builder: Builder, lowering: MIRLowering, ctx: {String@symbol}?TransformValue) RETURNS !Int64 EFFECTS REENTRANT ->
  IF (FALSE OR (stmts.length == 0)) THEN
    RETURN COPY after_idx;
  END
  MUTABLE pivot_idx = stmts.indexOf();
  IF (pivot_idx == NIL) THEN
    RETURN builder__push(&builder, stmts, SegmentTail{ Goto: COPY Goto{ target_index: COPY after_idx } });
  END
  MUTABLE pre = COPY UNWRAP (stmts.substr(0, (pivot_idx - 0)));
  MUTABLE pivot: ?SegmentStmt = COPY stmts[pivot_idx];
  MUTABLE rest = (stmts.substr(((pivot_idx + 1)), (stmts.length - ((pivot_idx + 1)))) OR_ELSE List[]);
  MUTABLE rest_entry = TRY (recursiveSplitter__emit_stmts(rest, after_idx, &builder, lowering, ctx));
  MUTABLE pivot_ast_branch_value: ?SegmentStmt = NIL;
  IF pivot? IS_A Locatable AS locatable THEN
    pivot_ast_branch_value = castLocatableToOptionalSegmentStmt(locatable);
  ELSE
    pivot_ast_branch_value = NIL;
  END
  MUTABLE pivot_ast: ?SegmentStmt = pivot_ast_branch_value;
  MUTABLE sus = IF pivot_ast != NIL THEN
    Segments.classify_suspend(castSegmentStmtToLocatable(pivot_ast))
  ELSE
    NIL
  END;
  IF sus THEN
    RETURN TRY (recursiveSplitter__emit_suspend_with_pre(sus, pre, rest_entry, &builder));
  ELSE
    MUTABLE pivot_entry = TRY (recursiveSplitter__emit_pivot(UNWRAP (pivot), rest_entry, builder, lowering, ctx));
    IF pre.empty?() THEN
      RETURN pivot_entry;
    ELSE
      RETURN builder__push(&builder, pre, SegmentTail{ Goto: COPY Goto{ target_index: pivot_entry } });
    END
  END
END
PRIVATE FN recursiveSplitter__emit_suspend_with_pre(susp_tail: SuspendTail, pre_value: []SegmentStmt, after_idx: Int64, MUTABLE builder: Builder) RETURNS !Int64 ->
  MUTABLE idx = builder__reserve_index(&builder);
  IF !(Segments.suspend_tail?(castSuspendTailToOptionalSegmentTail(susp_tail))) THEN
    panic("Unhandled suspend kind {}");
  END
  MUTABLE tail = susp_tail.with_next_index(after_idx);
  builder__fill(&builder, idx, pre_value, tail);
  RETURN idx;
END
PRIVATE FN recursiveSplitter__stmt_introduces_split?(stmt: ?SegmentStmt) RETURNS !Bool ->
  IF stmt EXISTS AS stmt_value THEN
    IF (IF stmt_value IS_A Locatable AS locatable THEN Segments.classify_suspend(locatable) ELSE FALSE END) THEN
      RETURN TRUE;
    END
    IF stmt_value IS_A WithBlock@multiowned AS with_block_multiowned THEN
      RETURN (TRY (recursiveSplitter__with_lock_suspend?(CAST(COPY with_block_multiowned AS WithBlock))) OR (TRY (recursiveSplitter__contains_suspend_anywhere?(Stmts{ ArrayValue: with_block_multiowned.body |> SELECT castLocatableToSegmentStmt(_) }))));
    ELSE
      IF !(stmt_value IS_A Struct) THEN
        RETURN FALSE;
      END
      RETURN (TRY (aST__child_bodies(castSegmentStmtToLocatable(stmt_value)))) |> ANY TRY (recursiveSplitter__contains_suspend_anywhere?(Stmts{ ArrayValue: _ |> SELECT castNodeToSegmentStmt(_) }));
    END
  ELSE
    RETURN FALSE;
  END
END
PRIVATE FN recursiveSplitter__contains_suspend_anywhere?(stmts: ?Stmts) RETURNS !Bool EFFECTS REENTRANT ->
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < stmts.length DO
    IF (stmts[rtoc_idx] IS_A Locatable AND Segments.classify_suspend(stmts[rtoc_idx])) THEN
        RETURN TRUE;
    END
    IF (stmts[rtoc_idx] IS_A WithBlock) THEN
        IF (TRY (recursiveSplitter__with_lock_suspend?(stmts[rtoc_idx])) OR TRY (recursiveSplitter__contains_suspend_anywhere?(stmts[rtoc_idx].body()))) THEN
          RETURN TRUE;
        END
    ELSE
        IF !(stmts[rtoc_idx] IS_A Struct) THEN
          rtoc_idx = rtoc_idx + 1;
  CONTINUE;
        END
        IF (TRY (aST__child_bodies(stmts[rtoc_idx]))) |> ANY TRY (recursiveSplitter__contains_suspend_anywhere?(Stmts{ ArrayValue: _ |> SELECT castNodeToSegmentStmt(_) })) THEN
          RETURN TRUE;
        END
    END
  rtoc_idx = rtoc_idx + 1;
  END
  RETURN FALSE;
END
PRIVATE FN recursiveSplitter__with_lock_suspend?(with_node: WithBlock) RETURNS !Bool ->
  RETURN (TRY (withCapabilityPlan__locks((TRY (capabilityPlan__require_for(with_node)))))) |> ANY _;
END
PRIVATE FN recursiveSplitter__contains_unsupported?(body: ?Body) RETURNS !Bool EFFECTS REENTRANT ->
  RETURN body |> ANY PARTIAL MATCH _ START
    AST.WithBlock -> TRY (recursiveSplitter__with_unsupported?(_)),
    AST.CatchBlock -> TRUE,
    AST.WhileLoop -> TRY (recursiveSplitter__contains_unsupported?(_.do_branch)),
    AST.WhileBindLoop -> TRY (recursiveSplitter__contains_unsupported?(_.do_branch)),
    AST.ForRange -> TRY (recursiveSplitter__contains_unsupported?(_.body)),
    AST.ForEach -> TRY (recursiveSplitter__contains_unsupported?(_.body)),
    AST.IfStatement -> (TRY (recursiveSplitter__contains_unsupported?(_.then_branch)) OR TRY (recursiveSplitter__contains_unsupported?((_.else_branch OR List[])))),
    DEFAULT -> TRY (recursiveSplitter__stmt_unsupported_suspend?(_))
  END;
END
PRIVATE FN recursiveSplitter__with_unsupported?(with_node: WithBlock) RETURNS !Bool ->
  IF TRY (recursiveSplitter__with_lock_suspend?(with_node)) THEN
    MUTABLE with_plan = TRY (capabilityPlan__require_for(with_node));
    IF !((with_plan.all.length == (TRY (withCapabilityPlan__locks(with_plan))).length())) THEN
      RETURN TRUE;
    END
  END
  RETURN TRY (recursiveSplitter__contains_unsupported?(Body{ ArrayValue: COPY with_node.body }));
END
PRIVATE FN recursiveSplitter__stmt_unsupported_suspend?(stmt: ?SegmentStmt) RETURNS !Bool ->
  MUTABLE sus = IF ((stmt != NIL) AND (stmt IS_A Locatable)) THEN
    Segments.classify_suspend(castOptionalSegmentStmtToLocatable(stmt))
  ELSE
    NIL
  END;
  IF !(sus IS_A NextSuspend) THEN
    RETURN FALSE;
  END
  MUTABLE pt = TRY (type__from_node_mut(sus.promise_ast, "FSM suspend promise"));
  IF !(type__future?(pt)) THEN
    RETURN TRUE;
  END
  IF (TRUE AND TRY (type__stream?(pt))) THEN
    RETURN TRUE;
  END
  IF (TRUE AND type__promise_list?(pt)) THEN
    RETURN TRUE;
  END
  RETURN FALSE;
END
PRIVATE FN recursiveSplitter__emit_pivot(stmt: SegmentStmt, after_idx: Int64, MUTABLE builder: Builder, lowering: MIRLowering, ctx: {String@symbol}?TransformValue) RETURNS !Int64 ->
  MUTABLE sus = IF stmt IS_A Locatable THEN
    Segments.classify_suspend(castSegmentStmtToLocatable(stmt))
  ELSE
    NIL
  END;
  IF sus THEN
    RETURN TRY (recursiveSplitter__emit_suspend(CAST(sus AS SuspendTail), after_idx, &builder));
  END
  RETURN PARTIAL MATCH stmt START
    SegmentStmt.WhileLoop AS while_loop -> TRY (recursiveSplitter__emit_while_fragment(SplitterWhileStmt{ WhileLoop: COPY while_loop }, after_idx, builder, lowering, ctx)),
    SegmentStmt.WhileBindLoop AS while_bind_loop -> TRY (recursiveSplitter__emit_while_fragment(SplitterWhileStmt{ WhileBindLoop: COPY while_bind_loop }, after_idx, builder, lowering, ctx)),
    SegmentStmt.ForRange AS for_range -> TRY (recursiveSplitter__emit_for_range_fragment(for_range, after_idx, builder, lowering, ctx)),
    SegmentStmt.ForEach AS for_each -> TRY (recursiveSplitter__emit_for_each_fragment(for_each, after_idx, builder, lowering, ctx)),
    SegmentStmt.IfStatement AS if_statement -> TRY (recursiveSplitter__emit_if_fragment(if_statement, after_idx, builder, lowering, ctx)),
    SegmentStmt.WithBlockMultiowned AS with_block_multiowned -> TRY (recursiveSplitter__emit_with_fragment(CAST(COPY with_block_multiowned AS WithBlock), after_idx, &builder, lowering, ctx)),
    DEFAULT -> panic("Unhandled pivot kind {}")
  END;
END
PRIVATE FN recursiveSplitter__emit_suspend(susp_tail: SuspendTail, after_idx: Int64, MUTABLE builder: Builder) RETURNS !Int64 ->
  MUTABLE idx = builder__reserve_index(&builder);
  IF !(Segments.suspend_tail?(castSuspendTailToOptionalSegmentTail(susp_tail))) THEN
    panic("Unhandled suspend kind {}");
  END
  MUTABLE tail = susp_tail.with_next_index(after_idx);
  builder__fill(&builder, idx, ( { MUTABLE rtoc_empty_list_5: []SegmentStmt = List[]; rtoc_empty_list_5 } ), tail);
  RETURN idx;
END
