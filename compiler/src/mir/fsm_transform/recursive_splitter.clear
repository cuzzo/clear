PUB FN castLocatableListToSegmentStmtList(values: []Locatable) RETURNS []SegmentStmt ->
  MUTABLE out: []SegmentStmt = List[];
  FOR value IN values DO
    &out.append(castLocatableToSegmentStmt(value));
  END
  RETURN out;
END
