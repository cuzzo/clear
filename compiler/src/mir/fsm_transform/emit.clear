REQUIRE "pkg:rtoc_6d69722f6d69725f6c6f776572696e672e636c656172"
REQUIRE "pkg:rtoc_6173742f747970652e636c656172" AS type
REQUIRE "pkg:rtoc_6d69722f6d69722e636c656172" AS mir
REQUIRE "pkg:rtoc_6d69722f66736d5f7472616e73666f726d2f636f6e746578742e636c656172" AS context
REQUIRE "pkg:rtoc_6d69722f66736d5f7472616e73666f726d2f7365676d656e74732e636c656172" AS segments
REQUIRE "pkg:rtoc_6d69722f66736d5f7472616e73666f726d2f7265637572736976655f73706c69747465722e636c656172" AS recursive_splitter
REQUIRE "pkg:rtoc_6d69722f66736d5f7472616e73666f726d2f6c6976656e6573732e636c656172" AS liveness
REQUIRE "pkg:rtoc_6d69722f66736d5f7472616e73666f726d2f73757370656e645f7265736f6c766572732e636c656172" AS suspend_resolvers
REQUIRE "pkg:rtoc_6d69722f66736d5f7472616e73666f726d2e636c656172" AS fsm_transform
REQUIRE "pkg:rtoc_6173742f6173742e636c656172" AS ast
REQUIRE "pkg:rtoc_6d69722f66736d5f6c6f776572696e672e636c656172" AS fsm_lowering
REQUIRE "pkg:rtoc_6d69722f66736d5f7472616e73666f726d2f6c6f776572696e675f70726f746f636f6c2e636c656172" AS lowering_protocol
REQUIRE "pkg:rtoc_6d69722f636c65616e75705f656e7472792e636c656172" AS cleanup_entry
REQUIRE "pkg:rtoc_73656d616e7469632f6361706162696c6974795f706c616e2e636c656172" AS capability_plan
REQUIRE "pkg:rtoc_616e6e6f7461746f722f68656c706572732f66756e6374696f6e5f72657475726e2e636c656172" AS function_return
PUB UNION Dispatch { SymbolValue: String@symbol, BoolValue: Bool }
# Ruby module FsmTransform
# Ruby module FsmTransform::Emit
PUB UNION PromotableFsmValue { Emittable: Emittable, ArrayValue: []Emittable }
PUB STRUCT FsmBodyItem {
  emission: Emittable,
  fact_node_value: ?Emittable
}

PUB FN fsmBodyItem__mir(node: Emittable) RETURNS FsmBodyItem ->
  RETURN FsmBodyItem{ emission: COPY node, fact_node_value: COPY node };
END
PUB FN fsmBodyItem__emit_value(self: FsmBodyItem) RETURNS Emittable ->
  RETURN COPY self.emission;
END
PUB FN fsmBodyItem__fact_node(self: FsmBodyItem) RETURNS ?Emittable ->
  RETURN COPY self.fact_node_value;
END
PUB STRUCT FsmSegmentFacts {
  ctx_reads: []String,
  required_move_guards: []String,
  move_guard_writes: []String,
  result_names: []String,
  ownership_facts: []FsmOwnershipFact
}

PUB FN fsmSegmentFacts__empty() RETURNS FsmSegmentFacts ->
  RETURN FsmSegmentFacts{ ctx_reads: List[], required_move_guards: List[], move_guard_writes: List[], result_names: List[], ownership_facts: List[] };
END
PUB UNION EmitSegmentTail { Done: Done, Goto: Goto, LoopBack: LoopBack, CondBranch: CondBranch, IoSuspend: IoSuspend, NextSuspend: NextSuspend, LockSuspend: LockSuspend, FsmTailDone: FsmTailDone, FsmTailJump: FsmTailJump, FsmTailYield: FsmTailYield, FsmTailRegisterYield: FsmTailRegisterYield, FsmTailCondJump: FsmTailCondJump, FsmTailCondSkip: FsmTailCondSkip, FsmTailLockTry: FsmTailLockTry, FsmTailWokenCheck: FsmTailWokenCheck, FsmTailRetryOrError: FsmTailRetryOrError }
PUB STRUCT FsmSegmentSpec {
  index: Int64,
  prologue_stmts: []FsmBodyItem,
  body_stmts: []FsmBodyItem,
  structure_stmts: []Emittable,
  tail: EmitSegmentTail,
  descriptor: ?SuspendDescriptor,
  fsm_result_transfer_facts: []FsmResultTransferFact,
  fn_name: ?String,
  suppress_runtime_ref: Bool,
  err_cleanups: []Emittable,
  pre_body_skip: ?FsmTailCondSkip,
  pre_body_stmts: []Emittable,
  extra_prologue_stmts: []Emittable,
  facts: FsmSegmentFacts
}

PUB FN fsmSegmentSpec__with_facts(self: FsmSegmentSpec, facts: FsmSegmentFacts) RETURNS FsmSegmentSpec ->
  RETURN FsmSegmentSpec{ index: self.index, prologue_stmts: COPY self.prologue_stmts, body_stmts: COPY self.body_stmts, structure_stmts: COPY self.structure_stmts, tail: COPY self.tail, descriptor: COPY self.descriptor, fsm_result_transfer_facts: COPY self.fsm_result_transfer_facts, fn_name: COPY self.fn_name, suppress_runtime_ref: self.suppress_runtime_ref, err_cleanups: COPY self.err_cleanups, pre_body_skip: COPY self.pre_body_skip, pre_body_stmts: COPY self.pre_body_stmts, extra_prologue_stmts: COPY self.extra_prologue_stmts, facts: COPY facts };
END
PUB STRUCT ExpandedLockSegment {
  lock_try_spec: FsmSegmentSpec,
  appended_specs: []FsmSegmentSpec,
  extra_fields: []ContextFieldDecl
}
PRIVATE FN emit__build_fsm_unified(ctx: FsmEmitContext, segment_specs_input: []FsmSegmentSpec, promoted_field_decls_input: []ContextFieldDecl, lowering: MIRLowering) RETURNS !?FsmLoweringResult ->
  MUTABLE promoted_field_decls = COPY promoted_field_decls_input;
  MUTABLE segment_specs = COPY segment_specs_input;
  IF (segment_specs.length() == 0) THEN
    RETURN NIL;
  END
  MUTABLE id = ctx.id;
  MUTABLE bg_rt = COPY ctx.bg_rt;
  MUTABLE destroy_actions = TRY (emit__ordered_fsm_destroy_actions(ctx));
  segment_specs = TRY (emit__materialize_fsm_segment_facts(segment_specs, id, TRY (emit__fsm_destroy_cleanup_names(destroy_actions))));
  MUTABLE bind_for_index: {Int64}[]FsmBodyItem = {};
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < segment_specs.length() DO
    MUTABLE d: ?SuspendDescriptor = COPY segment_specs[rtoc_idx]?.descriptor;
    IF !(((d != NIL) AND !(d.bind_stmts.empty?()))) THEN
        rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    MUTABLE target = (emit__tail_resume_target( UNWRAP (segment_specs[rtoc_idx]?.tail)) OR_ELSE (rtoc_idx + 1));
    bind_for_index[target] = TRY (emit__fsm_body_mir_items(d.bind_stmts));
  rtoc_idx = rtoc_idx + 1;
  END
  MUTABLE body_fn_names_by_index: {Int64}String = {};
  MUTABLE member_fns = (segment_specs |> SELECT:? { MUTABLE rtoc_value_block_marker = 0; MUTABLE body: []FsmBodyItem = List[]; { MUTABLE rtoc_value_block_marker = 0; ruby_array_concat_FsmBodyItem(body, _.prologue_stmts); { MUTABLE rtoc_value_block_marker = 0; MUTABLE incoming_bind: ?[]FsmBodyItem = COPY bind_for_index[_.index]; { MUTABLE rtoc_value_block_marker = 0; MUTABLE fn_name: ?String = COPY _.fn_name; { MUTABLE rtoc_value_block_marker = 0; IF incoming_bind EXISTS AS incoming_bind_value THEN
    fn_name = (fn_name OR_ELSE "runSeg${_.index.toString()}");
    body = ruby_array_concat_FsmBodyItem(body, CAST(incoming_bind_value AS []FsmBodyItem));
  END (IF (fn_name == NIL) THEN NIL ELSE { MUTABLE rtoc_value_block_marker = 0; body_fn_names_by_index[_.index] = fn_name; { MUTABLE rtoc_value_block_marker = 0; ruby_array_concat_FsmBodyItem(body, _.body_stmts); { MUTABLE rtoc_value_block_marker = 0; MUTABLE d: ?SuspendDescriptor = COPY _.descriptor;
  IF d EXISTS AS d_value THEN
    body = ruby_array_concat_FsmBodyItem(body, TRY (emit__fsm_body_mir_items(d_value.setup_stmts)));
  END FsmMemberFn{ fn_name: fn_name, ctx_id: id, bg_rt: COPY bg_rt, suppress_runtime_ref: _.suppress_runtime_ref, body_stmts: TRY (emit__fsm_body_emit_values(body)), extra_prologue_stmts: _.extra_prologue_stmts } } } } END) } } } } } |> WHERE _ != NIL).compact();
  MUTABLE arms = segment_specs |> SELECT {
  MUTABLE tail = TRY (emit__build_dispatch_tail(_));
  FsmStateArm{ index: _.index, pre_body_skip: CAST(COPY _.pre_body_skip AS ?FsmPreBodySkip), pre_body_stmts: COPY _.pre_body_stmts, body_fn_name: UNWRAP (COPY body_fn_names_by_index[_.index]), err_cleanups: COPY _.err_cleanups, tail: tail }
  };
  MUTABLE dispatch = FsmDispatch{ ctx_id: id, arms: arms, uses_loop_label: TRUE };
  MUTABLE extra_field_decls: []ContextFieldDecl = [emit__ctx_field_decl("step", "u8", Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } })];
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < segment_specs.length() DO
    MUTABLE d: ?SuspendDescriptor = COPY segment_specs[rtoc_idx]?.descriptor;
    IF !(d) THEN
        rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    extra_field_decls = ruby_array_concat_ContextFieldDecl(extra_field_decls, CAST(d.ctx_field_decls AS []ContextFieldDecl));
  rtoc_idx = rtoc_idx + 1;
  END
  extra_field_decls = ruby_array_concat_ContextFieldDecl(extra_field_decls, ctx.extra_ctx_fields);
  MUTABLE seen_extra_names: [Set]String = Set[];
  extra_field_decls = extra_field_decls |> WHERE !({
  MUTABLE name = COPY _.name;
  MUTABLE duplicate = seen_extra_names.contains?(name);
  &seen_extra_names.insert(name);
  duplicate
  });
  MUTABLE capture_field_names: [Set]String = (ctx.capture_fields |> SELECT _.name) |> DISTINCT _;
  extra_field_decls = extra_field_decls |> WHERE !(capture_field_names.contains?(_.name));
  MUTABLE extra_field_names: [Set]String = COPY capture_field_names;
  FOR _ IN extra_field_decls DO
  &extra_field_names.insert(COPY _.name);
  END
  promoted_field_decls = promoted_field_decls |> WHERE !(extra_field_names.contains?(_.name));
  MUTABLE ctx_struct = FsmGenericCtxStruct{ type_name: COPY ctx.ctx_type, promise_zig: COPY ctx.promise_zig, capture_fields: COPY ctx.capture_fields, extra_field_decls: extra_field_decls, promoted_field_decls: promoted_field_decls, member_fns: member_fns, dispatch: dispatch, destroy_actions: destroy_actions };
  MUTABLE spawn_setup = TRY (emit__build_spawn_setup(ctx));
  MUTABLE fsm_body = FsmGenericBody{ blk_label: COPY ctx.blk_label, ctx_struct: ctx_struct, spawn_setup: spawn_setup, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
  RETURN FsmLoweringResult{ body: MIRFsmLoweringResultFsmBody{ FsmGenericBody: COPY fsm_body }, structure: COPY TRY (emit__build_fsm_structure(ctx, segment_specs, destroy_actions, id)) };
END
PRIVATE FN emit__build_fsm_structure(ctx: FsmEmitContext, segment_specs: []FsmSegmentSpec, destroy_actions: []FsmDestroyAction, id: Int64) RETURNS !FsmStructure ->
  MUTABLE cleanup_names = TRY (emit__fsm_destroy_cleanup_names(destroy_actions));
  MUTABLE captured = COPY ctx.captured;
  MUTABLE capture_names = captured.keys() |> SELECT _.toString();
  MUTABLE captures = capture_names |> SELECT:? (IF !(cleanup_names.contains?(_)) THEN NIL ELSE FsmCaptureFact{ name: COPY _, cleanup_at: :finalize } END) |> WHERE _ != NIL;
  MUTABLE steps = segment_specs |> SELECT FsmStepFact{ index: _.index, reads: COPY _.facts.ctx_reads, cleanups: List[] };
  MUTABLE structure = FsmStructure{ captures: captures |> SELECT UNWRAP (_), state_fields: List[], steps: steps, finalize_cleanups: cleanup_names, ctx_id: COPY id, result_aliases_finalized: NIL, lowered_node_id: NIL, ownership_consumption: NIL, facts: FsmStructureFacts{ required_move_guards: List[], move_guard_writes: List[], ownership_facts: List[], destroy_actions: List[] }, owned_result_required: NIL };
  TRY (fsmStructure__set_required_move_guards(&structure, (segment_specs |> UNNEST _.facts.required_move_guards) |> DISTINCT _ |> SELECT COPY _));
  TRY (fsmStructure__set_move_guard_writes(&structure, (segment_specs |> UNNEST _.facts.move_guard_writes) |> DISTINCT _ |> SELECT COPY _));
  TRY (fsmStructure__set_ownership_facts(&structure, TRY (emit__unique_fsm_ownership_facts(segment_specs |> UNNEST _.facts.ownership_facts))));
  TRY (fsmStructure__set_destroy_actions(&structure, destroy_actions));
  RETURN structure;
END
PRIVATE FN emit__fsm_destroy_actions(ctx: FsmEmitContext) RETURNS ![]FsmDestroyAction ->
  RETURN COPY ctx.destroy_actions;
END
PRIVATE FN emit__ordered_fsm_destroy_actions(ctx: FsmEmitContext) RETURNS ![]FsmDestroyAction ->
  RETURN ({
  MUTABLE rtoc_value_block_marker = 0;
  MUTABLE rtoc_indexed_items_3: []FsmDestroyAction = TRY (emit__fsm_destroy_actions(ctx));
  MUTABLE rtoc_indexed_output_5: []Tuple<FsmDestroyAction, []?Int64> = [];
  MUTABLE rtoc_indexed_i_4 = 0;
  WHILE rtoc_indexed_i_4 < rtoc_indexed_items_3.length() DO
    &rtoc_indexed_output_5.append(Tuple{COPY UNWRAP (rtoc_indexed_items_3[rtoc_indexed_i_4]), [UNWRAP fsmDestroyAction__destroy_order_bucket(UNWRAP (rtoc_indexed_items_3[rtoc_indexed_i_4])), UNWRAP fsmDestroyAction__destroy_order_index(UNWRAP (rtoc_indexed_items_3[rtoc_indexed_i_4]), rtoc_indexed_i_4)]});
    rtoc_indexed_i_4 = rtoc_indexed_i_4 + 1;
  END
  rtoc_indexed_output_5 |> ORDER_BY _._1 |> SELECT _._0
  });
END
PUB FN emit__fsm_destroy_cleanup_names(actions: []FsmDestroyAction) RETURNS ![]String ->
  RETURN (actions |> SELECT:? fsmDestroyAction__cleanup_name(_) |> WHERE _ != NIL).compact() |> DISTINCT _ |> SELECT COPY _;
END
PRIVATE FN emit__tail_resume_target(tail: EmitSegmentTail) RETURNS ?Int64 ->
  IF tail IS_A IoSuspend AS io_suspend THEN
    RETURN io_suspend.next_index;
  ELSE_IF tail IS_A NextSuspend AS next_suspend THEN
    RETURN next_suspend.next_index;
  ELSE_IF tail IS_A LockSuspend AS lock_suspend THEN
    RETURN lock_suspend.next_index;
  ELSE_IF tail IS_A FsmTailJump AS fsm_tail_jump THEN
    RETURN fsm_tail_jump.next_step;
  ELSE_IF tail IS_A FsmTailYield AS fsm_tail_yield THEN
    RETURN fsm_tail_yield.next_step;
  ELSE_IF tail IS_A FsmTailRegisterYield AS fsm_tail_register_yield THEN
    RETURN fsm_tail_register_yield.next_step;
  ELSE
    RETURN NIL;
  END
END
PRIVATE FN emit__materialize_fsm_segment_facts(segment_specs: []FsmSegmentSpec, id: Int64, cleanup_names: []String) RETURNS ![]FsmSegmentSpec ->
  RETURN segment_specs |> SELECT fsmSegmentSpec__with_facts(_, TRY (emit__build_fsm_segment_facts(_, id, cleanup_names)));
END
PRIVATE FN emit__build_fsm_segment_facts(spec: FsmSegmentSpec, id: Int64, cleanup_names: []String) RETURNS !FsmSegmentFacts ->
  MUTABLE nodes = TRY (emit__collect_fsm_nodes(TRY (emit__fsm_segment_fact_roots(spec))));
  MUTABLE result_names = TRY (emit__collect_result_names(nodes, id));
  MUTABLE result_facts = result_names |> SELECT FsmOwnershipFact{ name: COPY _, target: :result, target_alloc: :heap, move_guarded: TRUE };
  MUTABLE structured_facts = spec.fsm_result_transfer_facts |> SELECT:? { MUTABLE rtoc_value_block_marker = 0; MUTABLE guard_name = emit__fsm_fact_guard_name(_.name); (IF (guard_name.length() == 0) THEN NIL ELSE FsmOwnershipFact{ name: COPY guard_name, target: :result, target_alloc: COPY _.target_alloc, move_guarded: _.move_guarded } END) } |> WHERE _ != NIL;
  RETURN FsmSegmentFacts{ ctx_reads: COPY TRY (emit__collect_ctx_field_reads(nodes, id)), required_move_guards: COPY TRY (emit__collect_required_move_guards(nodes, id, cleanup_names)), move_guard_writes: COPY TRY (emit__collect_move_guard_writes(nodes, id)), result_names: COPY result_names, ownership_facts: COPY TRY (emit__unique_fsm_ownership_facts( CAST((structured_facts + result_facts) AS []FsmOwnershipFact))) };
END
PRIVATE FN emit__fsm_segment_fact_roots(spec: FsmSegmentSpec) RETURNS ![]Emittable ->
  MUTABLE roots: []Emittable = List[];
  roots = ruby_array_concat_Emittable__emit(roots, TRY (emit__fsm_body_mir_nodes(spec.prologue_stmts)));
  roots = ruby_array_concat_Emittable__emit(roots, { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_7: ?[]Emittable = NIL; IF (spec.structure_stmts.length() == 0) THEN rtoc_ternary_value_7 = TRY (emit__fsm_body_mir_nodes(spec.body_stmts)); ELSE rtoc_ternary_value_7 = spec.structure_stmts; END rtoc_ternary_value_7? });
  MUTABLE descriptor: ?SuspendDescriptor = COPY spec.descriptor;
  IF descriptor EXISTS AS descriptor_value THEN
    roots = ruby_array_concat_Emittable__emit(roots, CAST(descriptor_value.setup_stmts AS []Emittable));
    roots = ruby_array_concat_Emittable__emit(roots, CAST(descriptor_value.bind_stmts AS []Emittable));
  END
  RETURN roots;
END
PUB FN emit__fsm_body_mir_nodes(stmts: []FsmBodyItem) RETURNS ![]Emittable ->
  RETURN stmts |> SELECT:? fsmBodyItem__fact_node(_) |> WHERE _ != NIL |> SELECT UNWRAP (_);
END
PUB FN emit__fsm_body_mir_item(node: Emittable) RETURNS FsmBodyItem ->
  RETURN fsmBodyItem__mir(node);
END
PUB FN emit__fsm_body_mir_items(nodes: []Emittable) RETURNS ![]FsmBodyItem ->
  RETURN nodes |> SELECT emit__fsm_body_mir_item(_);
END
PRIVATE FN emit__fsm_body_emit_values(items: []FsmBodyItem) RETURNS ![]Emittable ->
  RETURN items |> SELECT fsmBodyItem__emit_value(_);
END
PRIVATE FN emit__mir_nodes_reference_ident?(nodes: []Emittable, name: String) RETURNS !Bool ->
  RETURN (TRY (mIR__nodes(NodeRoot{ ArrayValue: COPY nodes }))) |> ANY (IF _ IS_A Ident AS rtoc_ident THEN (rtoc_ident.name == name) ELSE FALSE END);
END
PRIVATE FN emit__prior_lock_release_stmts(ctx_id: Int64, lock_index: Int64, lock_ref: String, unlock_method: String) RETURNS ![]Emittable ->
  RETURN CAST([Emittable{ Set: COPY Set{ target: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__ctx_${ctx_id.toString()}", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "__lock_held_${lock_index.toString()}", lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Lit: COPY Lit{ value: "false", lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: COPY lock_ref, lowered_node_id: NIL, ownership_consumption: NIL } }, method: COPY unlock_method, args: List[], try_wrap: FALSE, callable_contract: NIL, owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable);
END
PUB FN emit__unique_fsm_ownership_facts(facts: []FsmOwnershipFact) RETURNS ![]FsmOwnershipFact ->
  MUTABLE seen: [Set]String = Set[];
  MUTABLE unique: []FsmOwnershipFact = List[];
  FOR rtoc_fact IN facts DO
    MUTABLE rtoc_key = "${rtoc_fact.name}|${rtoc_fact.target.toString()}|${(rtoc_fact.target_alloc OR_ELSE :none).toString()}|${(IF rtoc_fact.move_guarded THEN "1" ELSE "0" END)}";
    IF &seen.insert(rtoc_key) THEN
      &unique.append(COPY rtoc_fact);
    END
  END
  RETURN unique;
END
PRIVATE FN emit__collect_required_move_guards(nodes: []Emittable, id: Int64, cleanup_names: []String) RETURNS ![]String ->
  MUTABLE out: []String = List[];
  FOR _ IN nodes DO
    IF _ IS_A TransferMark AS transfer_mark THEN
      IF ((transfer_mark.target == :owned_sink) OR (transfer_mark.target == :return)) THEN
        MUTABLE name = emit__normalized_ctx_field_name(CAST(transfer_mark.name AS String), id);
        IF cleanup_names.contains?(name) THEN
          &out.append(COPY name);
        END
      END
    END
  END
  RETURN out |> DISTINCT _ |> SELECT COPY _;
END
PRIVATE FN emit__collect_move_guard_writes(nodes: []Emittable, id: Int64) RETURNS ![]String ->
  MUTABLE out: []String = List[];
  FOR _ IN nodes DO
    IF _ IS_A MoveMark AS move_mark THEN
      MUTABLE name = COPY CAST(move_mark.name AS String);
      MUTABLE normalized = emit__normalized_ctx_field_name(name, id);
      &out.append(COPY normalized);
      &out.append("__ctx_${id.toString()}.${normalized}");
    ELSE_IF _ IS_A Set AS set_node THEN
      IF emit__true_literal?(set_node.value) THEN
        MUTABLE field: ?String = emit__ctx_field_name(set_node.target, id);
        IF field EXISTS AS field_value THEN
          IF field_value.endsWith?("_moved") THEN
            &out.append(rtoc_delete_suffix(field_value, "_moved"));
          END
        END
      END
    END
  END
  RETURN out |> DISTINCT _ |> SELECT COPY _;
END
PUB FN emit__normalized_ctx_field_name(name: String, id: Int64) RETURNS String ->
  RETURN name.deletePrefix("__ctx_${id.toString()}.");
END
PRIVATE FN emit__collect_result_names(nodes: []Emittable, id: Int64) RETURNS ![]String ->
  MUTABLE names: []String = List[];
  FOR rtoc_node IN nodes DO
    IF rtoc_node IS_A Set AS rtoc_set THEN
      IF emit__ctx_inner_result_target?(rtoc_set.target, id) THEN
        IF emit__result_source_name(rtoc_set.value, id) EXISTS AS rtoc_name THEN
          IF !(names.contains?(rtoc_name)) THEN
            &names.append(COPY rtoc_name);
          END
        END
      END
    END
  END
  RETURN names;
END
PRIVATE FN emit__fsm_fact_guard_name(name: String) RETURNS String ->
  IF emit__fsm_ctx_name?(name) THEN
    RETURN COPY "";
  END
  IF emit__fsm_ctx_field_prefix(name) != NIL THEN
  RETURN (emit__fsm_ctx_field_prefix(name))?;
  ELSE
  RETURN COPY name;
  END
END
PRIVATE FN emit__fsm_ctx_name?(name: String) RETURNS Bool ->
  IF !(name.startsWith?("__ctx_")) THEN
    RETURN FALSE;
  END
  MUTABLE suffix = name.deletePrefix("__ctx_");
  RETURN emit__decimal_digits?(suffix);
END
PRIVATE FN emit__fsm_ctx_field_prefix(name: String) RETURNS ?String ->
  IF !(name.startsWith?("__ctx_")) THEN
    RETURN NIL;
  END
  MUTABLE dot_index: ?Int64 = name.indexOf(".");
  IF dot_index EXISTS AS dot_index_value THEN
    MUTABLE ctx_id = name.substr("__ctx_".codepointCount(), (dot_index_value - "__ctx_".codepointCount()));
    IF !(emit__decimal_digits?(ctx_id)) THEN
      RETURN NIL;
    END
    RETURN COPY name.substr(((dot_index_value + 1)), (name.length() - ((dot_index_value + 1))));
  ELSE
    RETURN NIL;
  END
END
PRIVATE FN emit__decimal_digits?(value: String) RETURNS Bool ->
  IF (value.length() == 0) THEN
    RETURN FALSE;
  END
  MUTABLE digit_idx = 0;
  WHILE digit_idx < value.length() DO
    MUTABLE ch = value.charAt(digit_idx);
    IF !(((ch >= "0") AND (ch <= "9"))) THEN
      RETURN FALSE;
    END
    digit_idx = digit_idx + 1;
  END
  RETURN TRUE;
END
PRIVATE FN emit__collect_ctx_field_reads(nodes: []Emittable, id: Int64) RETURNS ![]String ->
  RETURN (nodes |> SELECT:? emit__ctx_field_name(_, id) |> WHERE _ != NIL).compact() |> DISTINCT _ |> SELECT COPY _;
END
PRIVATE FN emit__collect_fsm_nodes(roots: []Emittable) RETURNS ![]Emittable ->
  MUTABLE out: []Emittable = List[];
  TRY (mIR__each_node(NodeRoot{ ArrayValue: COPY roots }, %(node: Emittable) USE(MUTABLE out) -> {
  &out.append(COPY node);
  rubyToClearVoid__emit()
  }));
  RETURN out;
END
PUB FN emit__ctx_field_name(expr: Emittable, id: Int64) RETURNS ?String ->
  IF expr IS_A FieldGet AS field_get THEN
    MUTABLE object = field_get.object;
    IF object IS_A Ident AS ident THEN
      IF !((ident.name == "__ctx_${id.toString()}")) THEN
        RETURN NIL;
      END
      RETURN COPY field_get.field;
    ELSE
      RETURN NIL;
    END
  ELSE
    RETURN NIL;
  END
END
PRIVATE FN emit__ctx_inner_result_target?(expr: Emittable, id: Int64) RETURNS Bool ->
  IF expr IS_A FieldGet AS field_get THEN
    IF !((field_get.field == "result")) THEN
      RETURN FALSE;
    END
    MUTABLE inner = field_get.object;
    IF inner IS_A FieldGet AS field_get THEN
      IF !((field_get.field == "inner")) THEN
        RETURN FALSE;
      END
      MUTABLE object = field_get.object;
      RETURN (IF object IS_A Ident AS ident THEN (ident.name == "__ctx_${id.toString()}") ELSE FALSE END);
    ELSE
      RETURN FALSE;
    END
  ELSE
    RETURN FALSE;
  END
END
PRIVATE FN emit__result_source_name(expr: Emittable, id: Int64) RETURNS ?String ->
  IF expr IS_A Ident AS ident THEN
    RETURN COPY ident.name;
  ELSE
    RETURN emit__ctx_field_name(expr, id);
  END
END
PRIVATE FN emit__true_literal?(expr: Emittable) RETURNS Bool ->
  RETURN (IF expr IS_A Lit AS lit THEN (lit.value == "true") ELSE FALSE END);
END
PRIVATE FN emit__build_dispatch_tail(spec: FsmSegmentSpec) RETURNS !FsmTail ->
  MUTABLE tail = COPY spec.tail;
  MUTABLE desc: ?SuspendDescriptor = COPY spec.descriptor;
  MUTABLE index = spec.index;
  MUTABLE next_step = (index + 1);
  IF tail IS_A FsmTailLockTry AS fsm_tail_lock_try THEN
    RETURN FsmTail{ FsmTailLockTry: COPY fsm_tail_lock_try };
  ELSE_IF tail IS_A FsmTailWokenCheck AS fsm_tail_woken_check THEN
    RETURN FsmTail{ FsmTailWokenCheck: COPY fsm_tail_woken_check };
  ELSE_IF tail IS_A FsmTailRetryOrError AS fsm_tail_retry_or_error THEN
    RETURN FsmTail{ FsmTailRetryOrError: COPY fsm_tail_retry_or_error };
  ELSE_IF tail IS_A FsmTailJump AS fsm_tail_jump THEN
    RETURN FsmTail{ FsmTailJump: COPY fsm_tail_jump };
  ELSE_IF tail IS_A FsmTailDone AS fsm_tail_done THEN
    RETURN FsmTail{ FsmTailDone: COPY fsm_tail_done };
  END
  IF tail IS_A Done AS done THEN
    RETURN FsmTail{ FsmTailDone: COPY FsmTailDone{ _: NIL } };
  ELSE_IF tail IS_A Goto AS goto THEN
    RETURN FsmTail{ FsmTailJump: COPY FsmTailJump{ next_step: goto.target_index } };
  ELSE_IF tail IS_A LoopBack AS loop_back THEN
    RETURN FsmTail{ FsmTailJump: COPY FsmTailJump{ next_step: loop_back.target_index } };
  ELSE_IF tail IS_A CondBranch AS cond_branch THEN
    MUTABLE condition = COPY cond_branch.cond_ast;
    RETURN FsmTail{ FsmTailCondJump: COPY FsmTailCondJump{ condition: CAST(condition AS Emittable), then_step: cond_branch.then_index, else_step: cond_branch.else_index } };
  ELSE_IF tail IS_A IoSuspend AS io_suspend THEN
    IF desc EXISTS AS desc_value THEN
      MUTABLE explicit_next:? = io_suspend.next_index;
      MUTABLE target_step:? = explicit_next;
      MUTABLE desc_tail = desc_value.tail;
      IF desc_tail IS_A FsmTailYield AS rtoc_fsm_tail_yield THEN
        RETURN FsmTail{ FsmTailYield: COPY FsmTailYield{ next_step: target_step, yield_reason: rtoc_fsm_tail_yield.yield_reason } };
      ELSE_IF desc_tail IS_A FsmTailRegisterYield AS rtoc_fsm_tail_register_yield THEN
        RETURN FsmTail{ FsmTailRegisterYield: COPY FsmTailRegisterYield{ next_step: target_step, register_expr: rtoc_fsm_tail_register_yield.register_expr, yield_reason: rtoc_fsm_tail_register_yield.yield_reason } };
      ELSE
        panic("Unsupported descriptor tail {} in segment {}");
      END
    ELSE
      panic("Suspend tail in segment {} has no descriptor");
    END
  ELSE_IF tail IS_A NextSuspend AS next_suspend THEN
    IF desc EXISTS AS desc_value THEN
      MUTABLE explicit_next:? = next_suspend.next_index;
      MUTABLE target_step:? = explicit_next;
      MUTABLE desc_tail = desc_value.tail;
      IF desc_tail IS_A FsmTailYield AS rtoc_fsm_tail_yield THEN
        RETURN FsmTail{ FsmTailYield: COPY FsmTailYield{ next_step: target_step, yield_reason: rtoc_fsm_tail_yield.yield_reason } };
      ELSE_IF desc_tail IS_A FsmTailRegisterYield AS rtoc_fsm_tail_register_yield THEN
        RETURN FsmTail{ FsmTailRegisterYield: COPY FsmTailRegisterYield{ next_step: target_step, register_expr: rtoc_fsm_tail_register_yield.register_expr, yield_reason: rtoc_fsm_tail_register_yield.yield_reason } };
      ELSE
        panic("Unsupported descriptor tail {} in segment {}");
      END
    ELSE
      panic("Suspend tail in segment {} has no descriptor");
    END
  ELSE
    panic("Unsupported segment tail {} in segment {}");
  END
END
PUB FN emit__build_recursive(MUTABLE ctx: FsmEmitContext, segment_list: SegmentList, liveness: LivenessResult, MUTABLE lowering: MIRLowering) RETURNS !?FsmLoweringResult ->
  MUTABLE segment_nodes = COPY segment_list.segments;
  IF (segment_nodes.length() == 0) THEN
    RETURN NIL;
  END
  MUTABLE id = ctx.id;
  MUTABLE bg_rt = COPY ctx.bg_rt;
  MUTABLE captured = COPY ctx.captured;
  MUTABLE pointer_captures = COPY ctx.pointer_captures;
  MUTABLE arena_init_flag = ctx.arena_init_flag;
  MUTABLE recursive_promoted_names = COPY ctx.recursive_promoted_names;
  MUTABLE is_void = ctx.is_void;
  MUTABLE fsm_promoted_names = ((liveness.cross_segment_vars.keys() + recursive_promoted_names)) |> DISTINCT _ |> SELECT COPY _;
  MUTABLE capture_map = TRY (emit__build_recursive_capture_map(ctx, segment_nodes, liveness));
  MUTABLE arena_init_stmt_branch_value: ?Set = NIL;
  IF arena_init_flag THEN
    arena_init_stmt_branch_value = Set{ target: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: COPY bg_rt, lowered_node_id: NIL, ownership_consumption: NIL } }, field: "arena_mode", lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Lit: COPY Lit{ value: "true", lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
  ELSE
    arena_init_stmt_branch_value = NIL;
  END
  MUTABLE arena_init_stmt: Set = arena_init_stmt_branch_value?;
  TRY (emit__register_recursive_destroy_actions_mut(&ctx));
  MUTABLE conservative_promoted = COPY recursive_promoted_names;
  MUTABLE done_idx: ?Int64 = NIL;
  MUTABLE rtoc_done_i = 0;
  WHILE rtoc_done_i < segment_nodes.length() DO
    IF ((done_idx == NIL) AND UNWRAP (segment_nodes[rtoc_done_i]).tail IS_A Done) THEN
      done_idx = rtoc_done_i;
    END
    rtoc_done_i = rtoc_done_i + 1;
  END
  MUTABLE rtoc_indexed_acc_13 = Set[];
  MUTABLE rtoc_indexed_i_12 = 0;
  WHILE rtoc_indexed_i_12 < segment_nodes.length() DO
    IF UNWRAP (segment_nodes[rtoc_indexed_i_12]).stmts.empty?() THEN
        CONTINUE;
    END
    MUTABLE rtoc_seg = UNWRAP (segment_nodes[rtoc_indexed_i_12]);
    MUTABLE rtoc_is_result = FALSE;
    IF rtoc_seg.tail IS_A Done THEN
      rtoc_is_result = TRUE;
    ELSE_IF rtoc_seg.tail IS_A Goto AS rtoc_goto THEN
      IF done_idx EXISTS AS rtoc_done_idx THEN
        rtoc_is_result = (rtoc_goto.target_index == rtoc_done_idx);
      END
    END
    IF rtoc_is_result THEN
      &rtoc_indexed_acc_13.insert(rtoc_seg.index);
    END
    rtoc_indexed_i_12 = rtoc_indexed_i_12 + 1;
  END
  MUTABLE result_seg_indices = rtoc_indexed_acc_13;
  MUTABLE owned_result_guards = TRY (emit__fsm_owned_result_guards(segment_nodes, &lowering));
  MUTABLE seg_result_facts: {Int64}[]FsmResultTransferFact = {};
  MUTABLE seg_mir_codes: [][]Emittable = List[];
  MUTABLE rtoc_indexed_result_15 = {
  MUTABLE rtoc_value_block_marker = 0;
  MUTABLE rtoc_indexed_items_16: []Segment = segment_nodes;
  MUTABLE rtoc_indexed_output_20: [][]FsmBodyItem = List[];
  MUTABLE rtoc_indexed_i_17 = 0;
  WHILE rtoc_indexed_i_17 < rtoc_indexed_items_16.length() DO
    &rtoc_indexed_output_20.append({
  MUTABLE mir_stmts: []Emittable = List[];
  MUTABLE ast_stmts: []Locatable = List[];
  FOR _ IN UNWRAP (rtoc_indexed_items_16[rtoc_indexed_i_17]).stmts DO
  IF _ IS_A SegmentBodyItem.Emittable AS mir_stmt THEN
      &mir_stmts.append(COPY mir_stmt);
  ELSE_IF _ IS_A SegmentBodyItem.Locatable AS ast_stmt THEN
      &ast_stmts.append(COPY ast_stmt);
  END
  END
  MUTABLE seg_items: []FsmBodyItem = List[];
  IF (ast_stmts.length() == 0) THEN
    seg_mir_codes[rtoc_indexed_i_17] = mir_stmts;
    seg_items = TRY (emit__fsm_body_mir_items(mir_stmts));
  ELSE
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE want_result = (!(is_void) AND result_seg_indices.contains?(UNWRAP (rtoc_indexed_items_16[rtoc_indexed_i_17]).index));
    MUTABLE inherited_capture_names: [Set]String = ((TRY (emit__fsm_destroy_actions(ctx))) |> SELECT:? fsmDestroyAction__ctx_cleanup_target_name(_) |> WHERE _ != NIL).compact() |> DISTINCT _;
    FOR _ IN captured.keys() DO
  &inherited_capture_names.insert("__ctx_${id.toString()}.${_}");
  END
    MUTABLE lowering_api = COPY lowering;
    MUTABLE seg_overrides: ?{String}String = TRY (segmentList__alias_overrides_for(segment_list, UNWRAP (rtoc_indexed_items_16[rtoc_indexed_i_17]).index));
    MUTABLE eff_capture_map: {String}String = {};
    IF seg_overrides EXISTS AS seg_overrides_value THEN
      eff_capture_map = seg_overrides_value.keys() |> REDUCE(COPY capture_map) { acc[_] = COPY (seg_overrides_value[_] OR_ELSE CAST(panic("missing hash key") AS String)); acc };
    ELSE
      eff_capture_map = capture_map;
    END
    MUTABLE lowered_mir = mIRLowering__with_fsm_segment_lowering_context(&lowering_api, pointer_captures, inherited_capture_names, inherited_capture_names, owned_result_guards, %() USE(ast_stmts, bg_rt, ctx, eff_capture_map, id, MUTABLE lowering_api, want_result) -> mIRLowering__with_fiber_capture_map(&lowering_api, eff_capture_map, {}, bg_rt, %() USE(ast_stmts, ctx, id, MUTABLE lowering_api, want_result) -> {
    IF want_result THEN
      RETURN TRY (mIRLowering__lower_finalized_fsm_step_mir( &lowering_api, ast_stmts, FALSE, id, ctx.async_result_shape));
    ELSE
      RETURN TRY (mIRLowering__lower_finalized_fsm_step_mir( &lowering_api, ast_stmts, TRUE));
    END
    NIL
  }));
    MUTABLE facts: []FsmResultTransferFact = CAST(TRY (mIRLowering__last_fsm_result_transfer_facts(&lowering_api)) AS []FsmResultTransferFact);
    seg_result_facts[UNWRAP (rtoc_indexed_items_16[rtoc_indexed_i_17]).index] = facts;
    lowered_mir = ruby_array_concat_Emittable__emit(mir_stmts, lowered_mir);
    MUTABLE all_promoted = (fsm_promoted_names + (captured.keys() |> SELECT _.toString()));
    IF (all_promoted).any?() THEN
      MUTABLE promoted_names = all_promoted |> DISTINCT _ |> SELECT COPY _;
      lowered_mir = TRY (emit__promote_fsm_mir_to_ctx_fields(lowered_mir, promoted_names, id));
      lowered_mir = TRY (emit__lift_ctx_cleanups_to_destroy_mut(lowered_mir, promoted_names, "__ctx_${id.toString()}", &ctx));
  END
    seg_mir_codes[rtoc_indexed_i_17] = lowered_mir;
    seg_items = TRY (emit__fsm_body_mir_items(lowered_mir));
  END
  seg_items
  });
    rtoc_indexed_i_17 = rtoc_indexed_i_17 + 1;
  END
  rtoc_indexed_output_20
  };
  MUTABLE seg_codes = rtoc_indexed_result_15;
  TRY (emit__check_fsm_cleanup_invariant_mut(seg_mir_codes, segment_nodes, liveness, captured, conservative_promoted));
  MUTABLE void_assign_stmt_branch_value: ?Set = NIL;
  IF is_void THEN
    void_assign_stmt_branch_value = Set{ target: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__ctx_${id.toString()}", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "inner", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "result", lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ VoidLiteral: COPY VoidLiteral{ lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
  ELSE
    void_assign_stmt_branch_value = NIL;
  END
  MUTABLE void_assign_stmt: Set = void_assign_stmt_branch_value?;
  MUTABLE sp_indices = TRY (emit__compute_sp_indices(segment_nodes));
  MUTABLE rtoc_indexed_result_21 = {
  MUTABLE rtoc_value_block_marker = 0;
  MUTABLE rtoc_indexed_items_22: []Segment = segment_nodes;
  MUTABLE rtoc_indexed_output_31: []FsmSegmentSpec = List[];
  MUTABLE rtoc_indexed_i_23 = 0;
  WHILE rtoc_indexed_i_23 < rtoc_indexed_items_22.length() DO
    &rtoc_indexed_output_31.append({
  MUTABLE tail = UNWRAP (rtoc_indexed_items_22[rtoc_indexed_i_23]).tail;
  MUTABLE descriptor_branch_value: ?SuspendDescriptor = NIL;
    IF (tail IS_A IoSuspend OR tail IS_A NextSuspend) THEN
      descriptor_branch_value = TRY (emit__build_segment_descriptor(UNWRAP (rtoc_indexed_items_22[rtoc_indexed_i_23]), ctx, &lowering, capture_map, sp_indices[UNWRAP (rtoc_indexed_items_22[rtoc_indexed_i_23]).index]));
    ELSE
      descriptor_branch_value = NIL;
    END
  MUTABLE descriptor: ?SuspendDescriptor = descriptor_branch_value;
  IF (((tail IS_A IoSuspend OR tail IS_A NextSuspend)) AND (descriptor == NIL)) THEN
      RETURN NIL;
  END
  MUTABLE prologue: ?[]FsmBodyItem = NIL;
  IF (rtoc_indexed_i_23 == 0) THEN
    MUTABLE parts: []FsmBodyItem = List[];
    IF arena_init_stmt THEN
      &parts.append(emit__fsm_body_mir_item(Emittable{ Set: COPY arena_init_stmt }));
    END
    IF (parts.length() == 0) THEN
      prologue = NIL;
    ELSE
      prologue = parts;
    END
  END
  MUTABLE body_stmts: []FsmBodyItem = seg_codes[rtoc_indexed_i_23] OR_ELSE List[];
  IF void_assign_stmt THEN
  IF UNWRAP (rtoc_indexed_items_22[rtoc_indexed_i_23]).tail IS_A Done THEN
      body_stmts = (body_stmts + [emit__fsm_body_mir_item(Emittable{ Set: COPY void_assign_stmt })]);
  END
  END
  MUTABLE prologue_stmts = (prologue OR_ELSE List[]);
  MUTABLE rt_roots: []Emittable = List[];
  rt_roots = ruby_array_concat_Emittable__emit(rt_roots, TRY (emit__fsm_body_mir_nodes(body_stmts)));
  rt_roots = ruby_array_concat_Emittable__emit(rt_roots, TRY (emit__fsm_body_mir_nodes(prologue_stmts)));
  rt_roots = ruby_array_concat_Emittable__emit(rt_roots, CAST((descriptor?.setup_stmts OR_ELSE List[]) AS []Emittable));
  MUTABLE rt_used = TRY (emit__mir_nodes_reference_ident?(rt_roots, bg_rt));
  MUTABLE suppress_runtime_ref = !(rt_used);
  FsmSegmentSpec{ index: UNWRAP (rtoc_indexed_items_22[rtoc_indexed_i_23]).index, prologue_stmts: COPY prologue_stmts, body_stmts: COPY body_stmts, tail: COPY castSegmentTailToEmitSegmentTail(UNWRAP (rtoc_indexed_items_22[rtoc_indexed_i_23]).tail), descriptor: COPY descriptor, fsm_result_transfer_facts: COPY (seg_result_facts[UNWRAP (rtoc_indexed_items_22[rtoc_indexed_i_23]).index] OR_ELSE List[]), fn_name: "runSeg${UNWRAP (rtoc_indexed_items_22[rtoc_indexed_i_23]).index.toString()}", suppress_runtime_ref: suppress_runtime_ref, structure_stmts: List[], err_cleanups: List[], pre_body_skip: NIL, pre_body_stmts: List[], extra_prologue_stmts: List[], facts: fsmSegmentFacts__empty() }
  });
    rtoc_indexed_i_23 = rtoc_indexed_i_23 + 1;
  END
  rtoc_indexed_output_31
  };
  MUTABLE segment_specs = rtoc_indexed_result_21;
  TRY (emit__register_owned_suspend_result_cleanups_mut(segment_specs, &ctx, id));
  MUTABLE lock_extra_fields: []ContextFieldDecl = List[];
  MUTABLE next_lock_segment_index = segment_specs.length();
  MUTABLE expanded_specs: []FsmSegmentSpec = List[];
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < segment_specs.length() DO
  MUTABLE spec = UNWRAP (segment_specs[rtoc_idx]);
  IF (spec.tail) IS_A LockSuspend THEN
      MUTABLE out: ?ExpandedLockSegment = TRY (emit__expand_lock_segment(spec, &ctx, capture_map, lowering, next_lock_segment_index));
      IF out EXISTS AS out_value THEN
        &expanded_specs.append(COPY out_value.lock_try_spec);
        expanded_specs = ruby_array_concat_FsmSegmentSpec(expanded_specs, out_value.appended_specs);
        lock_extra_fields = ruby_array_concat_ContextFieldDecl(lock_extra_fields, out_value.extra_fields);
        next_lock_segment_index = (next_lock_segment_index + out_value.appended_specs.length());
      ELSE
        RETURN NIL;
      END
  ELSE
      &expanded_specs.append(COPY spec);
  END
  rtoc_idx = rtoc_idx + 1;
  END
  MUTABLE synthetic = COPY segment_list.synthetic_fields;
  MUTABLE all_fields = ((ctx.extra_ctx_fields + synthetic) + lock_extra_fields);
  MUTABLE deduped = TRY (emit__dedupe_context_fields(all_fields));
  MUTABLE ctx_with_extras = fsmEmitContext__with_extra_ctx_fields(ctx, deduped);
  MUTABLE suspend_result_vars = segment_nodes |> SELECT:? {
  MUTABLE tail = _.tail;
  (IF tail IS_A IoSuspend AS rtoc_io_tail THEN
      rtoc_io_tail.result_var
    ELSE_IF tail IS_A NextSuspend AS rtoc_next_tail THEN
      rtoc_next_tail.result_var
    ELSE
      NIL
    END)
  } |> WHERE _ != NIL;
  MUTABLE conservative_names = recursive_promoted_names |> REDUCE({}) {
  acc[_] = TRUE;
  acc
  };
  MUTABLE promoted_value_decls: []ContextFieldDecl = List[];
  FOR rtoc_csv_key IN liveness.cross_segment_vars.keys() DO
    IF !((suspend_result_vars.contains?(rtoc_csv_key) OR conservative_names.contains?(rtoc_csv_key))) THEN
      MUTABLE rtoc_csv_info = COPY UNWRAP (liveness.cross_segment_vars[rtoc_csv_key]);
      MUTABLE type_info: ?Type = rtoc_csv_info.type_info;
      MUTABLE rtoc_zig_type: String = "anyopaque";
      IF type_info EXISTS AS rtoc_type_info THEN
        rtoc_zig_type = TRY (type__zig_type(rtoc_type_info));
      END
      &promoted_value_decls.append(emit__ctx_field_decl(CAST(rtoc_csv_key AS String), rtoc_zig_type, Emittable{ Undef: COPY Undef{ zig_type: NIL, lowered_node_id: NIL, ownership_consumption: NIL } }));
    END
  END
  MUTABLE promoted_guard_decls = fsm_promoted_names |> SELECT emit__ctx_field_decl("${_}_moved", "bool", Emittable{ Lit: COPY Lit{ value: "false", lowered_node_id: NIL, ownership_consumption: NIL } });
  MUTABLE promoted_field_decls = (promoted_value_decls + promoted_guard_decls);
  RETURN TRY (emit__build_fsm_unified(ctx_with_extras, expanded_specs, promoted_field_decls, lowering));
END
PRIVATE FN emit__build_recursive_capture_map(ctx: FsmEmitContext, segments: []Segment, liveness: LivenessResult) RETURNS !{String}String ->
  MUTABLE id = ctx.id;
  MUTABLE capture_map: {String}String = {};
  FOR _ IN ctx.captured.keys() DO
  capture_map[_] = "__ctx_${id.toString()}.${_}";
  END
  FOR _ IN liveness.cross_segment_vars.keys() DO
  capture_map[_] = (capture_map[_] OR_ELSE "__ctx_${id.toString()}.${_}");
  END
  FOR _ IN ctx.recursive_promoted_names DO
  capture_map[_] = (capture_map[_] OR_ELSE "__ctx_${id.toString()}.${_}");
  END
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < segments.length() DO
    MUTABLE tail: SegmentTail = COPY UNWRAP (segments[rtoc_idx]).tail;
    MUTABLE rv: ?String = NIL;
    IF tail IS_A IoSuspend AS rtoc_io THEN
      rv = COPY rtoc_io.result_var;
    ELSE_IF tail IS_A NextSuspend AS rtoc_next THEN
      rv = COPY rtoc_next.result_var;
    ELSE
        rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    IF ((rv != NIL) AND (rv != "_")) THEN
        capture_map[rv] = (capture_map[rv] OR_ELSE "__ctx_${id.toString()}.${rv}");
    END
  rtoc_idx = rtoc_idx + 1;
  END
  RETURN capture_map;
END
PRIVATE FN emit__register_recursive_destroy_actions_mut(MUTABLE ctx: FsmEmitContext) RETURNS !Void ->
  MUTABLE id = ctx.id;
  ctx.destroy_actions = List[];
  FOR rtoc_each_key IN ctx.captured.keys() DO
  MUTABLE ignored_1: Type = COPY UNWRAP (ctx.captured[rtoc_each_key]);
  MUTABLE close_plan: ?ResourceClosePlan = COPY ctx.capture_close_plans[rtoc_each_key];
  IF !(close_plan) THEN
      CONTINUE;
  END
  &ctx.destroy_actions.append(FsmDestroyAction{ FsmDestroyCleanup: COPY FsmDestroyCleanup{ source_kind: :capture, name: COPY rtoc_each_key, target: Emittable{ FieldGet: COPY emit__fsm_ctx_field(id, rtoc_each_key) }, cleanup_entry: cleanupEntry__build(:resource, :heap, FALSE, close_plan), guard: NIL, allocator: NIL } });
  END
  FOR _ IN ctx.fresh_heap_cleanup_names DO
  &ctx.destroy_actions.append(FsmDestroyAction{ FsmDestroyCleanup: COPY FsmDestroyCleanup{ source_kind: :fresh_heap, name: COPY _, target: Emittable{ FieldGet: COPY emit__fsm_ctx_field(id, _) }, cleanup_entry: cleanupEntry__build(:uniform, :heap, TRUE), allocator: Emittable{ FieldGet: COPY emit__fsm_ctx_field(id, "alloc") }, guard: NIL } });
  END
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < ctx.capture_finalizers.length() DO
    MUTABLE name: ?String = emit__fsm_destroy_finalizer_name(ctx.capture_finalizers[rtoc_idx]?);
    IF !(name) THEN
        rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    &ctx.destroy_actions.append(FsmDestroyAction{ FsmDestroyStmt: COPY FsmDestroyStmt{ source_kind: :capture, name: COPY name, stmt: COPY ctx.capture_finalizers[rtoc_idx]? } });
  rtoc_idx = rtoc_idx + 1;
  END
END
PRIVATE FN emit__dedupe_context_fields(fields: []ContextFieldDecl) RETURNS ![]ContextFieldDecl ->
  MUTABLE seen_names: {String}Bool = {};
  RETURN fields |> WHERE !({ MUTABLE rtoc_value_block_marker = 0; MUTABLE name = COPY _.name; (IF (name.length() == 0) THEN FALSE ELSE   IF seen_names[name] THEN
    TRUE
  ELSE
    {
  MUTABLE rtoc_value_block_marker = 0;
  seen_names[name] = TRUE;
  FALSE
  }
  END END) });
END
PRIVATE FN emit__promote_fsm_mir_to_ctx_fields(body: []Emittable, promoted_names: []String, id: Int64) RETURNS ![]Emittable ->
  RETURN body |> SELECT castPromotableFsmValueToEmittable(emit__rewrite_promoted_fsm_node(PromotableFsmValue{ Emittable: COPY _ }, promoted_names, id));
END
PRIVATE FN emit__rewrite_promoted_fsm_node(MUTABLE node: PromotableFsmValue, promoted_names: []String, id: Int64) RETURNS PromotableFsmValue EFFECTS REENTRANT ->
  IF node IS_A []Emittable AS array THEN
    MUTABLE array_mutable = COPY array;
    RETURN PromotableFsmValue{ ArrayValue: COPY array_mutable |> SELECT castPromotableFsmValueToEmittable(emit__rewrite_promoted_fsm_node(PromotableFsmValue{ Emittable: COPY _ }, promoted_names, id)) };
  ELSE_IF (IF node IS_A Emittable AS rtoc_inner THEN rtoc_inner IS_A Let ELSE FALSE END) THEN
    MUTABLE rtoc_let: Let = Let{ name: COPY "", init: Emittable{ VoidLiteral: COPY VoidLiteral{ lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    PARTIAL MATCH castPromotableFsmValueToEmittable(node) START Emittable.Let AS rtoc_let_payload -> rtoc_let = COPY rtoc_let_payload;, END
    MUTABLE promoted_name: ?String = emit__promoted_fsm_field_name(COPY rtoc_let.name, promoted_names);
    MUTABLE rewritten_init: Emittable = castPromotableFsmValueToEmittable(emit__rewrite_promoted_fsm_node(PromotableFsmValue{ Emittable: COPY rtoc_let.init }, promoted_names, id));
    IF promoted_name EXISTS AS promoted_name_value THEN
      RETURN PromotableFsmValue{ Emittable: COPY CAST(Set{ target: Emittable{ FieldGet: COPY emit__fsm_ctx_field(id, promoted_name_value) }, value: COPY rewritten_init, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } AS Emittable) };
    END
    rtoc_let.init = rewritten_init;
    RETURN PromotableFsmValue{ Emittable: Emittable{ Let: COPY rtoc_let } };
  ELSE_IF (IF node IS_A Emittable AS rtoc_ident_inner THEN rtoc_ident_inner IS_A Ident ELSE FALSE END) THEN
    MUTABLE rtoc_ident: Ident = Ident{ name: COPY "", lowered_node_id: NIL, ownership_consumption: NIL };
    PARTIAL MATCH castPromotableFsmValueToEmittable(node) START Emittable.Ident AS rtoc_ident_payload -> rtoc_ident = COPY rtoc_ident_payload;, END
    IF emit__promoted_fsm_field_name(COPY rtoc_ident.name, promoted_names) EXISTS AS promoted_name_value THEN
      RETURN PromotableFsmValue{ Emittable: Emittable{ FieldGet: COPY emit__fsm_ctx_field(id, promoted_name_value) } };
    END
    RETURN COPY node;
  END
  IF node IS_A Emittable THEN
    emit__rewrite_promoted_fsm_struct_fields_mut(castPromotableFsmValueToEmittable(node), promoted_names, id);
  END
  RETURN COPY node;
END
