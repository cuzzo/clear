      rtoc_m.shard_idx = castPromotableFsmValueToEmittable(emit__rewrite_promoted_fsm_node(PromotableFsmValue{ Emittable: COPY rtoc_f }, promoted_names, id));
    END
    IF rtoc_m.shard_key EXISTS AS rtoc_f THEN
      rtoc_m.shard_key = castPromotableFsmValueToEmittable(emit__rewrite_promoted_fsm_node(PromotableFsmValue{ Emittable: COPY rtoc_f }, promoted_names, id));
    END
    node = Emittable{ ShardedMapGet: COPY rtoc_m };
    RETURN;
  END
  NIL;
END
PUB FN emit__fsm_ctx_field(id: Int64, name: String) RETURNS FieldGet ->
  RETURN FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__ctx_${id.toString()}", lowered_node_id: NIL, ownership_consumption: NIL } }, field: COPY name, lowered_node_id: NIL, ownership_consumption: NIL };
END
PRIVATE FN emit__fsm_destroy_finalizer_name(finalizer: Emittable) RETURNS ?String ->
  IF finalizer IS_A RcRelease AS rc_release THEN
    MUTABLE source = rc_release.source;
    IF source IS_A FieldGet AS field_get THEN
      RETURN COPY field_get.field;
    ELSE
      RETURN NIL;
    END
  ELSE
    RETURN NIL;
  END
END
PUB FN emit__promoted_fsm_field_name(name: String, promoted_names: []String) RETURNS ?String ->
  IF promoted_names.contains?(name) THEN
    RETURN COPY name;
  END
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < promoted_names.length() DO
    MUTABLE local_prefix = "${promoted_names[rtoc_idx]?}_L";
    IF name.startsWith?(local_prefix) THEN
        MUTABLE suffix = name.deletePrefix(local_prefix);
        IF emit__decimal_digits?(suffix) THEN
          RETURN COPY promoted_names[rtoc_idx]?;
        END
    END
    MUTABLE moved = "${promoted_names[rtoc_idx]?}_moved";
    IF (name == moved) THEN
        RETURN moved;
    END
    MUTABLE moved_local_prefix = "${promoted_names[rtoc_idx]?}_L";
    IF (name.startsWith?(moved_local_prefix) AND name.endsWith?("_moved")) THEN
        MUTABLE middle = rtoc_delete_suffix(name.deletePrefix(moved_local_prefix), "_moved");
        IF emit__decimal_digits?(middle) THEN
          RETURN moved;
        END
    END
  rtoc_idx = rtoc_idx + 1;
  END
  RETURN NIL;
END
PRIVATE FN emit__lift_ctx_cleanups_to_destroy_mut(body: []Emittable, promoted_names: []String, ctx_ref: String, MUTABLE ctx: FsmEmitContext) RETURNS ![]Emittable ->
  RETURN (body |> SELECT:? {
  MUTABLE rtoc_keep: ?Emittable = COPY _;
  IF (_ IS_A Cleanup OR _ IS_A ErrCleanup) THEN
      MUTABLE promoted_name: ?String = emit__promoted_fsm_field_name(CAST(emittable__name(_) AS String), promoted_names);
      IF promoted_name EXISTS AS promoted_name_value THEN
        &ctx.destroy_actions.append(FsmDestroyAction{ FsmDestroyCleanup: COPY FsmDestroyCleanup{ source_kind: :body, name: COPY promoted_name_value, target: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: COPY ctx_ref, lowered_node_id: NIL, ownership_consumption: NIL } }, field: COPY promoted_name_value, lowered_node_id: NIL, ownership_consumption: NIL } }, cleanup_entry: UNWRAP (emittable__cleanup_entry(_)), guard: NIL, allocator: NIL } });
        rtoc_keep = NIL;
      END
  END
  rtoc_keep
  } |> WHERE _ != NIL).compact();
END
PRIVATE FN emit__fsm_owned_result_guards(segments: []Segment, MUTABLE lowering: MIRLowering) RETURNS !{String}String ->
  MUTABLE guards = {};
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < segments.length() DO
    MUTABLE seg_tail = UNWRAP (segments[rtoc_idx]).tail;
    MUTABLE result_var: ?String = NIL;
    MUTABLE result_type: ?Type = NIL;
    IF seg_tail IS_A IoSuspend AS rtoc_io THEN
      result_var = COPY rtoc_io.result_var;
      result_type = TRY (ioSuspend__result_type(rtoc_io));
    ELSE_IF seg_tail IS_A NextSuspend AS rtoc_next THEN
      result_var = COPY rtoc_next.result_var;
      result_type = TRY (nextSuspend__result_type(rtoc_next));
    ELSE
      rtoc_idx = rtoc_idx + 1;
      CONTINUE;
    END
    IF !((result_var AND (result_var != "_"))) THEN
      rtoc_idx = rtoc_idx + 1;
      CONTINUE;
    END
    IF !(suspendResolvers__ownership_bearing_result_type?(result_type, &lowering)) THEN
        rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    guards[CAST(result_var AS String)] = suspendResolvers__fsm_owned_guard_name(CAST(result_var AS String));
  rtoc_idx = rtoc_idx + 1;
  END
  RETURN guards;
END
PRIVATE FN emit__register_owned_suspend_result_cleanups_mut(segment_specs: []FsmSegmentSpec, MUTABLE ctx: FsmEmitContext, id: Int64) RETURNS !Void ->
  MUTABLE seen = Set[];
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < segment_specs.length() DO
    MUTABLE desc: ?SuspendDescriptor = COPY segment_specs[rtoc_idx]?.descriptor;
    IF !((((desc != NIL) AND (desc.result_needs_cleanup OR_ELSE FALSE)) AND desc.result_var)) THEN
        rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    MUTABLE name = COPY CAST(desc.result_var AS String);
    IF !(&seen.insert(name)) THEN
        rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    MUTABLE guard = suspendResolvers__fsm_owned_guard_name(name);
    &ctx.destroy_actions.append(FsmDestroyAction{ FsmDestroyCleanup: COPY FsmDestroyCleanup{ source_kind: :owned_result, name: COPY name, target: Emittable{ FieldGet: COPY emit__fsm_ctx_field(id, name) }, cleanup_entry: cleanupEntry__build(:uniform, :heap, FALSE), guard: Emittable{ FieldGet: COPY emit__fsm_ctx_field(id, guard) }, allocator: NIL } });
  rtoc_idx = rtoc_idx + 1;
  END
END
PRIVATE FN emit__check_fsm_cleanup_invariant_mut(seg_codes: [][]Emittable, segments: []Segment, liveness: LivenessResult, captured: {String}Type@multiowned, conservative_promoted: []String) RETURNS !Void ->
  MUTABLE forbidden = COPY liveness.cross_segment_vars.keys();
  forbidden = (forbidden + (captured).keys());
  forbidden = (forbidden + conservative_promoted);
  MUTABLE forbidden_set = ((forbidden |> WHERE TRUE) |> DISTINCT _ |> SELECT COPY _) |> DISTINCT _;
  IF forbidden_set.empty?() THEN
    RETURN;
  END
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < seg_codes.length() DO
  TRY (mIR__each_node(NodeRoot{ ArrayValue: COPY seg_codes[rtoc_idx]? }, %(node: Emittable) USE(forbidden_set, segments, rtoc_idx) -> {
    IF !((node IS_A Cleanup OR node IS_A ErrCleanup)) THEN
        RETURN;
    END
    MUTABLE name = COPY CAST(emittable__name(node) AS String);
    IF !(forbidden_set.contains?(name)) THEN
        RETURN;
    END
    MUTABLE segment = COPY UNWRAP (segments[rtoc_idx]);
    MUTABLE seg_idx = segment.index;
    panic("{}{}field. The defer would fire when this runSegN returns, before the BG body completes. Lift the cleanup to destroyTask via ctx[:fsm_destroy_actions].");
    rubyToClearVoid__emit()
  }));
  rtoc_idx = rtoc_idx + 1;
  END
END
PRIVATE FN emit__expand_lock_segment(spec: FsmSegmentSpec, MUTABLE ctx: FsmEmitContext, capture_map: {String}String, lowering: MIRLowering, base_idx: Int64) RETURNS !?ExpandedLockSegment ->
  MUTABLE lowering_api = COPY lowering;
  MUTABLE tail: LockSuspend = COPY castSegmentTailToLockSuspend(spec.tail);
  MUTABLE with_node = COPY tail.with_node;
  MUTABLE cap = COPY tail.cap;
  MUTABLE prior = tail.prior_caps;
  MUTABLE after_idx: ?Int64 = tail.next_index;
  MUTABLE bg_rt = COPY ctx.bg_rt;
  MUTABLE id = ctx.id;
  MUTABLE captured = COPY ctx.captured;
  MUTABLE meta: ?{String@symbol}FsmCapMetadataValue = TRY (mIRLowering__fsm_cap_metadata(lowering_api, castLockCapToCapabilityTransition(cap), with_node, id, captured));
  IF (meta == NIL) THEN
    RETURN NIL;
  END
  MUTABLE cap_idx: ?Int64 = tail.lock_index;
  MUTABLE woken_idx = base_idx;
  MUTABLE retry_idx = (base_idx + 1);
  MUTABLE fail_idx = (base_idx + 2);
  MUTABLE held_set_idx = (base_idx + 3);
  MUTABLE try_success_idx = COPY held_set_idx;
  MUTABLE prior_meta: []{String@symbol}FsmCapMetadataValue = ( { MUTABLE rtoc_map_results_37: []{String@symbol}FsmCapMetadataValue = List[];
  FOR rtoc_map_item_36 IN prior DO
  MUTABLE m: ?{String@symbol}FsmCapMetadataValue = TRY (mIRLowering__fsm_cap_metadata(lowering_api, castLockCapToCapabilityTransition(rtoc_map_item_36), with_node, id, captured));
  IF (m == NIL) THEN
      RETURN NIL;
  END
  &rtoc_map_results_37.append(COPY CAST(m AS {String@symbol}FsmCapMetadataValue));
  END
  rtoc_map_results_37 } );
  MUTABLE pointer_captures = COPY ctx.pointer_captures;
  MUTABLE err:? =   IF with_node.lock_error_clause THEN
    TRY (mIRLowering__emit_fsm_lock_error_arm_split( &lowering_api, UNWRAP (with_node.lock_error_clause), id, with_node, capture_map, pointer_captures, bg_rt))
  ELSE
    mIRLowering__default_fsm_lock_error_arm_split(lowering_api, id)
  END;
  IF (err == NIL) THEN
    RETURN NIL;
  END
  MUTABLE prior_release_stmts = ({
  MUTABLE rtoc_value_block_marker = 0;
  MUTABLE rtoc_indexed_items_38: []{String@symbol}FsmCapMetadataValue = prior_meta;
  MUTABLE rtoc_indexed_output_40: [][]Emittable = List[];
  MUTABLE rtoc_indexed_i_39 = 0;
  WHILE rtoc_indexed_i_39 < rtoc_indexed_items_38.length() DO
    &rtoc_indexed_output_40.append(TRY (emit__prior_lock_release_stmts(id, CAST(tail.prior_lock_indices[rtoc_indexed_i_39] AS Int64), CAST(UNWRAP (rtoc_indexed_items_38[rtoc_indexed_i_39])[:lock_field_ref] AS String), CAST(UNWRAP (rtoc_indexed_items_38[rtoc_indexed_i_39])[:unlock_method] AS String))));
    rtoc_indexed_i_39 = rtoc_indexed_i_39 + 1;
  END
  rtoc_indexed_output_40
  });
  MUTABLE prior_release_flat: []Emittable = List[];
  MUTABLE rtoc_group_idx = (prior_release_stmts.length() - 1);
  WHILE rtoc_group_idx >= 0 DO
    FOR rtoc_group_stmt IN UNWRAP (prior_release_stmts[rtoc_group_idx]) DO
      &prior_release_flat.append(COPY rtoc_group_stmt);
    END
    rtoc_group_idx = (rtoc_group_idx - 1);
  END
  MUTABLE fail_body_stmts = (prior_release_flat + err.body_stmts);
  MUTABLE fail_tail = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_42: ?EmitSegmentTail = NIL;
  IF (err.exit_kind == :done) THEN
    rtoc_ternary_value_42 = EmitSegmentTail{ Done: COPY Done{ _: NIL } };
  ELSE
    rtoc_ternary_value_42 = EmitSegmentTail{ Goto: COPY Goto{ target_index: UNWRAP (after_idx)} };
  END
  rtoc_ternary_value_42? };
  MUTABLE has_step_work = (!((spec.prologue_stmts.length() == 0)) OR !((spec.body_stmts.length() == 0)));
  MUTABLE lock_try_spec = FsmSegmentSpec{ index: spec.index, prologue_stmts: COPY spec.prologue_stmts, body_stmts: COPY spec.body_stmts, structure_stmts: COPY spec.structure_stmts, tail: EmitSegmentTail{ FsmTailLockTry: COPY FsmTailLockTry{ try_method: CAST(meta[:try_method] AS String), lock_field_ref: CAST(meta[:lock_field_ref] AS String), ok_step: try_success_idx, wait_step: woken_idx, error_step: retry_idx } }, descriptor: NIL, fsm_result_transfer_facts: COPY spec.fsm_result_transfer_facts, fn_name: COPY IF has_step_work THEN
    spec.fn_name
  ELSE
    NIL
  END, suppress_runtime_ref: spec.suppress_runtime_ref, err_cleanups: List[], pre_body_skip: NIL, pre_body_stmts: List[], extra_prologue_stmts: List[], facts: fsmSegmentFacts__empty() };
  MUTABLE woken_spec = FsmSegmentSpec{ index: woken_idx, body_stmts: List[], tail: EmitSegmentTail{ FsmTailWokenCheck: COPY FsmTailWokenCheck{ ok_step: try_success_idx, error_step: retry_idx } }, descriptor: NIL, fn_name: NIL, suppress_runtime_ref: TRUE, prologue_stmts: List[], structure_stmts: List[], fsm_result_transfer_facts: List[], err_cleanups: List[], pre_body_skip: NIL, pre_body_stmts: List[], extra_prologue_stmts: List[], facts: fsmSegmentFacts__empty() };
  MUTABLE retry_spec = FsmSegmentSpec{ index: retry_idx, body_stmts: List[], tail: EmitSegmentTail{ FsmTailRetryOrError: COPY FsmTailRetryOrError{ retries: CAST(meta[:retries] AS ?Int64), retry_step: spec.index, fail_step: fail_idx } }, descriptor: NIL, fn_name: NIL, suppress_runtime_ref: TRUE, prologue_stmts: List[], structure_stmts: List[], fsm_result_transfer_facts: List[], err_cleanups: List[], pre_body_skip: NIL, pre_body_stmts: List[], extra_prologue_stmts: List[], facts: fsmSegmentFacts__empty() };
  MUTABLE fail_spec = FsmSegmentSpec{ index: fail_idx, body_stmts: List[], pre_body_stmts: COPY fail_body_stmts, tail: COPY fail_tail, descriptor: NIL, fn_name: NIL, suppress_runtime_ref: TRUE, prologue_stmts: List[], structure_stmts: List[], fsm_result_transfer_facts: List[], err_cleanups: List[], pre_body_skip: NIL, extra_prologue_stmts: List[], facts: fsmSegmentFacts__empty() };
  MUTABLE held_set_stmt = Set{ target: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__ctx_${id.toString()}", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "__lock_held_${cap_idx}", lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Lit: COPY Lit{ value: "true", lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
  MUTABLE held_set_spec = FsmSegmentSpec{ index: held_set_idx, body_stmts: List[], pre_body_stmts: [Emittable{ Set: COPY held_set_stmt }], tail: EmitSegmentTail{ Goto: COPY Goto{ target_index: UNWRAP (tail.post_acquire_idx) } }, descriptor: NIL, fn_name: NIL, suppress_runtime_ref: TRUE, prologue_stmts: List[], structure_stmts: List[], fsm_result_transfer_facts: List[], err_cleanups: List[], pre_body_skip: NIL, extra_prologue_stmts: List[], facts: fsmSegmentFacts__empty() };
  MUTABLE extra_fields = [emit__ctx_field_decl("lock_waiter", "CheatHeader.WaiterNode", Emittable{ Undef: COPY Undef{ zig_type: NIL, lowered_node_id: NIL, ownership_consumption: NIL } }), emit__ctx_field_decl("__lock_held_${cap_idx}", "bool", Emittable{ Lit: COPY Lit{ value: "false", lowered_node_id: NIL, ownership_consumption: NIL } })];
  IF ((CAST(meta[:retries] AS ?Int64) OR_ELSE 0) > 0) THEN
    &extra_fields.append(emit__ctx_field_decl("retry_count", "u32", Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }));
  END
  &ctx.destroy_actions.append(FsmDestroyAction{ FsmDestroyLockRelease: COPY FsmDestroyLockRelease{ name: COPY CAST(meta[:lock_field_ref] AS String), ctx_id: id, guard_index: UNWRAP (cap_idx), lock_ref: Emittable{ Ident: COPY Ident{ name: COPY CAST(meta[:lock_field_ref] AS String), lowered_node_id: NIL, ownership_consumption: NIL } }, unlock_method: COPY CAST(meta[:unlock_method] AS String) } });
  RETURN ExpandedLockSegment{ lock_try_spec: COPY lock_try_spec, appended_specs: [woken_spec, retry_spec, fail_spec, held_set_spec], extra_fields: COPY extra_fields };
END
PRIVATE FN emit__build_segment_descriptor(seg: Segment, ctx: FsmEmitContext, MUTABLE lowering: MIRLowering, capture_map: {String}String, sp_idx: ?Int64 = NIL) RETURNS !?SuspendDescriptor ->
  MUTABLE lowering_api = COPY lowering;
  MUTABLE tail = seg.tail;
  IF !(segments__suspend_tail?(tail)) THEN
    RETURN NIL;
  END
  MUTABLE bg_rt = COPY ctx.bg_rt;
  MUTABLE pointer_captures = COPY ctx.pointer_captures;
  MUTABLE result = mIRLowering__with_bg_fiber_body_context(&lowering_api, pointer_captures, %() USE(bg_rt, capture_map, ctx, MUTABLE lowering_api, seg, sp_idx) -> {
  rtoc_lambda_result_48 = mIRLowering__with_fiber_capture_map(&lowering_api, capture_map, {}, bg_rt, %() USE(ctx, MUTABLE lowering_api, seg, sp_idx) -> {
  MUTABLE eff_sp = (sp_idx OR_ELSE ((seg.index + 1)));
  TRY (suspendResolvers__resolve(seg, ctx, &lowering_api, eff_sp))
  });
  rtoc_lambda_result_48
  });
  RETURN CAST(result AS ?SuspendDescriptor);
END
PRIVATE FN emit__compute_sp_indices(segments: []Segment) RETURNS !{Int64}Int64 ->
  MUTABLE out: {Int64}Int64 = {};
  MUTABLE counter: Int64 = 1;
  MUTABLE visited: {Int64}Bool = {};
  MUTABLE stack: []Int64 = [0];
  WHILE TRUE DO
    MUTABLE idx: ?Int64 = &stack.pop();
    IF !(idx) THEN
      BREAK;
    END
    MUTABLE idx_value: Int64 = UNWRAP (idx);
    IF visited[idx_value] THEN
      CONTINUE;
    END
    visited[idx_value] = TRUE;
    MUTABLE seg: ?Segment = COPY segments[idx_value];
    IF seg EXISTS AS seg_value THEN
      IF (seg_value.tail IS_A IoSuspend OR seg_value.tail IS_A NextSuspend) THEN
        out[seg_value.index] = counter;
        counter = (counter + 1);
      END
      IF seg_value.tail IS_A Goto AS rtoc_goto THEN
        &stack.push(rtoc_goto.target_index);
      ELSE_IF seg_value.tail IS_A LoopBack AS rtoc_loopback THEN
        &stack.push(rtoc_loopback.target_index);
      ELSE_IF seg_value.tail IS_A CondBranch AS rtoc_cond THEN
        &stack.push(rtoc_cond.then_index);
        &stack.push(rtoc_cond.else_index);
      ELSE_IF seg_value.tail IS_A LockSuspend AS rtoc_locksusp THEN
        IF rtoc_locksusp.next_index EXISTS AS rtoc_lock_next THEN
          &stack.push(rtoc_lock_next);
        END
      ELSE_IF seg_value.tail IS_A IoSuspend AS rtoc_iosusp THEN
        IF rtoc_iosusp.next_index EXISTS AS rtoc_io_next THEN
          &stack.push(rtoc_io_next);
        END
      ELSE_IF seg_value.tail IS_A NextSuspend AS rtoc_nextsusp THEN
        IF rtoc_nextsusp.next_index EXISTS AS rtoc_next_next THEN
          &stack.push(rtoc_next_next);
        END
      END
    ELSE
      CONTINUE;
    END
  END
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < segments.length() DO
    IF out.contains?(segments[rtoc_idx]?.index) THEN
      rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    IF !(((segments[rtoc_idx]?.tail) IS_A IoSuspend OR (segments[rtoc_idx]?.tail) IS_A NextSuspend)) THEN
        rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    out[segments[rtoc_idx]?.index] = counter;
    counter = (counter + 1);
  rtoc_idx = rtoc_idx + 1;
  END
  RETURN out;
END
PRIVATE FN emit__build_spawn_setup(ctx: FsmEmitContext) RETURNS !FsmSpawnSetup ->
  MUTABLE is_local_pin: Bool = FALSE;
  PARTIAL MATCH ctx.pin_mode START
    TransformValue.BoolValue AS rtoc_pin_bool -> is_local_pin = rtoc_pin_bool;,
    TransformValue.SymbolValue AS rtoc_pin_sym -> is_local_pin = (rtoc_pin_sym == :local);,
    DEFAULT -> is_local_pin = FALSE;
  END
  MUTABLE pin_mode_false: Bool = FALSE;
  PARTIAL MATCH ctx.pin_mode START
    TransformValue.BoolValue AS rtoc_pin_unset -> pin_mode_false = !(rtoc_pin_unset);,
    DEFAULT -> pin_mode_false = FALSE;
  END
  MUTABLE is_default_local = (((ctx.pin_mode == NIL) OR pin_mode_false) AND !(ctx.parallel));
  MUTABLE is_local_dispatch = (is_local_pin OR is_default_local);
  MUTABLE dispatch = IF is_local_dispatch THEN
    :local
  ELSE
    :parallel
  END;
  MUTABLE spawn_call = FsmSpawnCall{ target: IF is_local_dispatch THEN
    :runtime_submit
  ELSE
    :best
  END, runtime_name: COPY IF is_local_dispatch THEN
    ctx.rt_name
  ELSE
    NIL
  END, ctx_var: COPY ctx.ctx_var };
  MUTABLE alloc_expr =   IF is_local_dispatch THEN
    {
  MUTABLE rtoc_value_block_marker = 0;
  sched = MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: COPY ctx.rt_name, lowered_node_id: NIL, ownership_consumption: NIL } }, method: "getSched", args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
  FieldGet{ object: Emittable{ MIRMethodCall: COPY sched }, field: "allocator", lowered_node_id: NIL, ownership_consumption: NIL }
  }
  ELSE
    MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: COPY ctx.rt_name, lowered_node_id: NIL, ownership_consumption: NIL } }, method: "heapAlloc", args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL }
  END;
  MUTABLE capture_inits = ctx.capture_inits |> WHERE !(((CAST(_.name AS String) == "inner") OR (CAST(_.name AS String) == "alloc")));
  MUTABLE ctx_init_fields = ([StructInitField{ name: :task, value: Emittable{ Undef: COPY Undef{ zig_type: NIL, lowered_node_id: NIL, ownership_consumption: NIL } }, alloc: NIL }, StructInitField{ name: :rt, value: Emittable{ Undef: COPY Undef{ zig_type: NIL, lowered_node_id: NIL, ownership_consumption: NIL } }, alloc: NIL }, StructInitField{ name: :inner, value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: COPY ctx.promise_var, lowered_node_id: NIL, ownership_consumption: NIL } }, field: "inner", lowered_node_id: NIL, ownership_consumption: NIL } }, alloc: NIL }, StructInitField{ name: :alloc, value: Emittable{ Ident: COPY Ident{ name: COPY ctx.alloc_var, lowered_node_id: NIL, ownership_consumption: NIL } }, alloc: NIL }] + capture_inits);
  MUTABLE profile_site_branch_value: ?ProfileTaskSite = NIL;
  IF ctx.profile_site_id EXISTS AS profile_site_id_value THEN
    profile_site_branch_value = ProfileTaskSite{ site_id: profile_site_id_value, line: (ctx.profile_line OR_ELSE 0), column: (ctx.profile_column OR_ELSE 0), dispatch: COPY dispatch, form: :fsm };
  ELSE
    profile_site_branch_value = NIL;
  END
  MUTABLE profile_site: ?ProfileTaskSite = COPY profile_site_branch_value;
  RETURN FsmSpawnSetup{ alloc_var: ctx.alloc_var, alloc_expr: alloc_expr, promise_var: ctx.promise_var, promise_zig: COPY ctx.promise_zig, promoted_decls: ctx.promoted_decls, ctx_var: ctx.ctx_var, ctx_type: ctx.ctx_type, ctx_init_fields: ctx_init_fields, spawn_call: spawn_call, rt_name: COPY ctx.rt_name, profile_site_id: ctx.profile_site_id, profile_dispatch_id: emit__profile_dispatch_id(dispatch), profile_site: profile_site };
END
PUB FN emit__ctx_field_decl(name: String, type_zig: String, default_value: ?Emittable) RETURNS ContextFieldDecl ->
  RETURN ContextFieldDecl{ name: COPY name, type_zig: COPY type_zig, default_value: COPY default_value };
END
PUB FN emit__profile_dispatch_id(dispatch: String@symbol) RETURNS Int64 ->
  RETURN PARTIAL MATCH dispatch START
    :parallel -> 2,
    :shared -> 3,
    DEFAULT -> 1
  END;
END
PUB FN emit__bg_profile_site_comment(ctx: FsmEmitContext, dispatch: Dispatch, form: String@symbol) RETURNS String ->
  RETURN "// CLEAR_PROFILE_TASK_SITE id=${(ctx.profile_site_id OR_ELSE 0).toString()} kind=BG line=${(ctx.profile_line OR_ELSE 0).toString()} column=${(ctx.profile_column OR_ELSE 0).toString()} dispatch=${CAST(dispatch AS String)} form=${CAST(form AS String)}";
END
# End Ruby module FsmTransform::Emit
# End Ruby module FsmTransform
FN castLockCapToCapabilityTransition(value: LockCap) RETURNS CapabilityTransition ->
  IF value IS_A CapabilityTransition AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to CapabilityTransition");
END
FN castPromotableFsmValueToEmittable(value: PromotableFsmValue) RETURNS Emittable ->
  IF value IS_A Emittable AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to Emittable");
END
# emit.rb:44 defines its OWN SegmentTail = Segments' seven tails PLUS FsmTail,
# and rtoc names that wider union EmitSegmentTail to avoid the clash with
# segments.clear's SegmentTail. Ruby needs no conversion because T.any is
# structural and the narrow alias is simply a subset; CLEAR unions are nominal,
# so widening is an explicit re-wrap of the same payload.
FN castSegmentTailToEmitSegmentTail(value: SegmentTail) RETURNS EmitSegmentTail ->
  PARTIAL MATCH value START
    SegmentTail.Done AS cast_payload -> RETURN EmitSegmentTail{ Done: COPY cast_payload };,
    SegmentTail.Goto AS cast_payload -> RETURN EmitSegmentTail{ Goto: COPY cast_payload };,
    SegmentTail.LoopBack AS cast_payload -> RETURN EmitSegmentTail{ LoopBack: COPY cast_payload };,
    SegmentTail.CondBranch AS cast_payload -> RETURN EmitSegmentTail{ CondBranch: COPY cast_payload };,
    SegmentTail.IoSuspend AS cast_payload -> RETURN EmitSegmentTail{ IoSuspend: COPY cast_payload };,
    SegmentTail.NextSuspend AS cast_payload -> RETURN EmitSegmentTail{ NextSuspend: COPY cast_payload };,
    SegmentTail.LockSuspend AS cast_payload -> RETURN EmitSegmentTail{ LockSuspend: COPY cast_payload };,
  END
  panic("segment tail has no emit-tail form");
END
FN castSegmentTailToLockSuspend(value: EmitSegmentTail) RETURNS LockSuspend ->
  IF value IS_A LockSuspend AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to LockSuspend");
END
FN rtoc_delete_suffix(s: String, affix: String) RETURNS String ->
  IF s.endsWith?(affix) THEN
    RETURN s.substr(0, (s.length() - affix.length()));
  END
  RETURN COPY s;
END
FN rubyToClearVoid__emit() RETURNS Void ->
  RETURN;
END
FN ruby_array_concat_ContextFieldDecl(left: []ContextFieldDecl, right: []ContextFieldDecl) RETURNS []ContextFieldDecl ->
  MUTABLE result: []ContextFieldDecl = [];
  FOR rtoc_left_item IN left DO
    &result.append(COPY rtoc_left_item);
  END
  FOR rtoc_right_item IN right DO
    &result.append(COPY rtoc_right_item);
  END
  RETURN result;
END
FN ruby_array_concat_Emittable__emit(left: []Emittable, right: []Emittable) RETURNS []Emittable ->
  MUTABLE result: []Emittable = [];
  FOR rtoc_left_item IN left DO
    &result.append(COPY rtoc_left_item);
  END
  FOR rtoc_right_item IN right DO
    &result.append(COPY rtoc_right_item);
  END
  RETURN result;
END
FN ruby_array_concat_FsmBodyItem(left: []FsmBodyItem, right: []FsmBodyItem) RETURNS []FsmBodyItem ->
  MUTABLE result: []FsmBodyItem = [];
  FOR rtoc_left_item IN left DO
    &result.append(COPY rtoc_left_item);
  END
  FOR rtoc_right_item IN right DO
    &result.append(COPY rtoc_right_item);
  END
  RETURN result;
END
FN ruby_array_concat_FsmSegmentSpec(left: []FsmSegmentSpec, right: []FsmSegmentSpec) RETURNS []FsmSegmentSpec ->
  MUTABLE result: []FsmSegmentSpec = [];
  FOR rtoc_left_item IN left DO
    &result.append(COPY rtoc_left_item);
  END
  FOR rtoc_right_item IN right DO
    &result.append(COPY rtoc_right_item);
  END
  RETURN result;
END
