FN rtocChildrenOfCollectValueYieldExpr(v: YieldExpr) RETURNS []CollectValue ->
  MUTABLE out: []CollectValue = [];
  &out.append(castLocatableToCollectValue(COPY v.expr));
  RETURN out;
END
FN rubyToClearVoid__liveness() RETURNS Void ->
  RETURN;
END

# Ruby asks `respond_to?(:type)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN bindingStmt__type(value: BindingStmt) RETURNS ?Type ->
  PARTIAL MATCH value START
    BindingStmt.VarDecl AS item -> RETURN COPY item.type;,
    BindingStmt.BindExpr AS item -> RETURN COPY item.type;,
    BindingStmt.DestructureTarget AS item -> RETURN COPY item.type;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END

FN castBindingStmtToLocatable(value: BindingStmt) RETURNS Locatable ->
  PARTIAL MATCH value START
    BindingStmt.VarDecl AS cast_payload -> RETURN Locatable{ VarDecl: COPY cast_payload };,
    BindingStmt.BindExpr AS cast_payload -> RETURN Locatable{ BindExpr: COPY cast_payload };,
    BindingStmt.DestructureTarget AS cast_payload -> RETURN Locatable{ DestructureTarget: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Locatable");
  END
  panic("Invalid cast to Locatable");
END

# Ruby asks `respond_to?(:value)` and then reads it. A union variant either
# carries the field or it does not, so the question is answered here.
PUB FN bindingStmt__value(value: BindingStmt) RETURNS ?Locatable@boxed ->
  PARTIAL MATCH value START
    BindingStmt.VarDecl AS item -> RETURN COPY item.value;,
    BindingStmt.BindExpr AS item -> RETURN COPY item.value;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
