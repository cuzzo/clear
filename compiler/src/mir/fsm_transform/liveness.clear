FN castOptionalTransformValueToHashMapStringTypeMultiowned(value: ?TransformValue) RETURNS {String}Type@multiowned ->
  IF value EXISTS AS value_present THEN
    PARTIAL MATCH value_present START
      TransformValue.HashMapValue AS cast_payload -> RETURN COPY cast_payload;,
    END
  END
  RETURN {};
END
FN castTypeTypeInputToTypeConstructionInput__liveness(value: TypeTypeInput) RETURNS TypeConstructionInput ->
  PARTIAL MATCH value START
    TypeTypeInput.FunctionType AS cast_payload -> RETURN TypeConstructionInput{ FunctionType: COPY cast_payload };,
    TypeTypeInput.Type AS cast_payload -> RETURN TypeConstructionInput{ Type: COPY cast_payload };,
    TypeTypeInput.SymbolValue AS cast_payload -> RETURN TypeConstructionInput{ SymbolValue: COPY cast_payload };,
    TypeTypeInput.StringValue AS cast_payload -> RETURN TypeConstructionInput{ StringValue: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to TypeConstructionInput");
  END
  panic("Invalid cast to TypeConstructionInput");
END
FN rtocChildrenCollectValue(node: CollectValue) RETURNS []CollectValue ->
  PARTIAL MATCH node START
    CollectValue.FunctionDefMultiowned AS v -> RETURN rtocChildrenOfCollectValueFunctionDefMultiowned(v);,
    CollectValue.Assignment AS v -> RETURN rtocChildrenOfCollectValueAssignment(v);,
    CollectValue.BinaryOp AS v -> RETURN rtocChildrenOfCollectValueBinaryOp(v);,
    CollectValue.ListLit AS v -> RETURN rtocChildrenOfCollectValueListLit(v);,
    CollectValue.LambdaLit AS v -> RETURN rtocChildrenOfCollectValueLambdaLit(v);,
    CollectValue.IfStatement AS v -> RETURN rtocChildrenOfCollectValueIfStatement(v);,
    CollectValue.WhileLoop AS v -> RETURN rtocChildrenOfCollectValueWhileLoop(v);,
    CollectValue.WhileBindLoop AS v -> RETURN rtocChildrenOfCollectValueWhileBindLoop(v);,
    CollectValue.FuncCall AS v -> RETURN rtocChildrenOfCollectValueFuncCall(v);,
    CollectValue.GetField AS v -> RETURN rtocChildrenOfCollectValueGetField(v);,
    CollectValue.GetIndex AS v -> RETURN rtocChildrenOfCollectValueGetIndex(v);,
    CollectValue.WithBlockMultiowned AS v -> RETURN rtocChildrenOfCollectValueWithBlockMultiowned(v);,
    CollectValue.TenseNavigation AS v -> RETURN rtocChildrenOfCollectValueTenseNavigation(v);,
    CollectValue.StringConcat AS v -> RETURN rtocChildrenOfCollectValueStringConcat(v);,
    CollectValue.MoveNode AS v -> RETURN rtocChildrenOfCollectValueMoveNode(v);,
    CollectValue.CopyNode AS v -> RETURN rtocChildrenOfCollectValueCopyNode(v);,
    CollectValue.KeepNode AS v -> RETURN rtocChildrenOfCollectValueKeepNode(v);,
    CollectValue.ShareNode AS v -> RETURN rtocChildrenOfCollectValueShareNode(v);,
    CollectValue.StaticCall AS v -> RETURN rtocChildrenOfCollectValueStaticCall(v);,
    CollectValue.YieldExpr AS v -> RETURN rtocChildrenOfCollectValueYieldExpr(v);,
    CollectValue.NextExpr AS v -> RETURN rtocChildrenOfCollectValueNextExpr(v);,
    CollectValue.MatchStatement AS v -> RETURN rtocChildrenOfCollectValueMatchStatement(v);,
    CollectValue.ForRange AS v -> RETURN rtocChildrenOfCollectValueForRange(v);,
    CollectValue.LetBinding AS v -> RETURN rtocChildrenOfCollectValueLetBinding(v);,
    CollectValue.FunctionDef AS v -> RETURN rtocChildrenOfCollectValueFunctionDef(v);,
    CollectValue.WithBlock AS v -> RETURN rtocChildrenOfCollectValueWithBlock(v);,
  END
  MUTABLE rtoc_no_children: []CollectValue = [];
  RETURN rtoc_no_children;
END
FN rtocChildrenOfCollectValueAssignment(v: Assignment) RETURNS []CollectValue ->
  MUTABLE out: []CollectValue = [];
  &out.append(castAssignmentNameToCollectValue(COPY v.name));
  &out.append(castLocatableToCollectValue(COPY v.value));
  RETURN out;
END
FN rtocChildrenOfCollectValueBinaryOp(v: BinaryOp) RETURNS []CollectValue ->
  MUTABLE out: []CollectValue = [];
  &out.append(castLocatableToCollectValue(COPY v.left));
  &out.append(castLocatableToCollectValue(COPY v.right));
  RETURN out;
END
FN rtocChildrenOfCollectValueCopyNode(v: CopyNode) RETURNS []CollectValue ->
  MUTABLE out: []CollectValue = [];
  &out.append(castLocatableToCollectValue(COPY v.value));
  RETURN out;
END
FN rtocChildrenOfCollectValueForRange(v: ForRange) RETURNS []CollectValue ->
  MUTABLE out: []CollectValue = [];
  &out.append(castLocatableToCollectValue(COPY v.start_expr));
  &out.append(castLocatableToCollectValue(COPY v.end_expr));
  FOR rtoc_arr_child IN v.body DO
    &out.append(castLocatableToCollectValue(COPY rtoc_arr_child));
  END
  RETURN out;
END
FN rtocChildrenOfCollectValueFuncCall(v: FuncCall) RETURNS []CollectValue ->
  MUTABLE out: []CollectValue = [];
  FOR rtoc_arr_child IN v.args DO
    &out.append(castLocatableToCollectValue(COPY rtoc_arr_child));
  END
  RETURN out;
END
FN rtocChildrenOfCollectValueFunctionDef(v: FunctionDef) RETURNS []CollectValue ->
  MUTABLE out: []CollectValue = [];
  FOR rtoc_arr_child IN v.body DO
    &out.append(castLocatableToCollectValue(COPY rtoc_arr_child));
  END
  RETURN out;
END
FN rtocChildrenOfCollectValueFunctionDefMultiowned(v: FunctionDef) RETURNS []CollectValue ->
  MUTABLE out: []CollectValue = [];
  FOR rtoc_arr_child IN v.body DO
    &out.append(castLocatableToCollectValue(COPY rtoc_arr_child));
  END
  RETURN out;
END
FN rtocChildrenOfCollectValueGetField(v: GetField) RETURNS []CollectValue ->
  MUTABLE out: []CollectValue = [];
  &out.append(castLocatableToCollectValue(COPY v.target));
  RETURN out;
END
FN rtocChildrenOfCollectValueGetIndex(v: GetIndex) RETURNS []CollectValue ->
  MUTABLE out: []CollectValue = [];
  &out.append(castLocatableToCollectValue(COPY v.target));
  &out.append(castLocatableToCollectValue(COPY v.index));
  RETURN out;
END
FN rtocChildrenOfCollectValueIfStatement(v: IfStatement) RETURNS []CollectValue ->
  MUTABLE out: []CollectValue = [];
  &out.append(castLocatableToCollectValue(COPY v.condition));
  FOR rtoc_arr_child IN v.then_branch DO
    &out.append(castLocatableToCollectValue(COPY rtoc_arr_child));
  END
  IF v.else_branch EXISTS AS rtoc_opt_child THEN
    FOR rtoc_arr_child IN rtoc_opt_child DO
      &out.append(castLocatableToCollectValue(COPY rtoc_arr_child));
    END
  END
  RETURN out;
END
FN rtocChildrenOfCollectValueKeepNode(v: KeepNode) RETURNS []CollectValue ->
  MUTABLE out: []CollectValue = [];
  &out.append(castLocatableToCollectValue(COPY v.value));
  RETURN out;
END
FN rtocChildrenOfCollectValueLambdaLit(v: LambdaLit) RETURNS []CollectValue ->
  MUTABLE out: []CollectValue = [];
  &out.append(castLambdaBodyToCollectValue(COPY v.body));
  RETURN out;
END
FN rtocChildrenOfCollectValueLetBinding(v: LetBinding) RETURNS []CollectValue ->
  MUTABLE out: []CollectValue = [];
  &out.append(castLocatableToCollectValue(COPY v.expr));
  RETURN out;
END
FN rtocChildrenOfCollectValueListLit(v: ListLit) RETURNS []CollectValue ->
  MUTABLE out: []CollectValue = [];
  FOR rtoc_arr_child IN v.items DO
    &out.append(castLocatableToCollectValue(COPY rtoc_arr_child));
  END
  RETURN out;
END
FN rtocChildrenOfCollectValueMatchStatement(v: MatchStatement) RETURNS []CollectValue ->
  MUTABLE out: []CollectValue = [];
  &out.append(castLocatableToCollectValue(COPY v.expr));
  RETURN out;
END
FN rtocChildrenOfCollectValueMoveNode(v: MoveNode) RETURNS []CollectValue ->
  MUTABLE out: []CollectValue = [];
  &out.append(castLocatableToCollectValue(COPY v.value));
  RETURN out;
END
FN rtocChildrenOfCollectValueNextExpr(v: NextExpr) RETURNS []CollectValue ->
  MUTABLE out: []CollectValue = [];
  &out.append(castLocatableToCollectValue(COPY v.expr));
  RETURN out;
END
FN rtocChildrenOfCollectValueShareNode(v: ShareNode) RETURNS []CollectValue ->
  MUTABLE out: []CollectValue = [];
  &out.append(castLocatableToCollectValue(COPY v.value));
  RETURN out;
END
FN rtocChildrenOfCollectValueStaticCall(v: StaticCall) RETURNS []CollectValue ->
  MUTABLE out: []CollectValue = [];
  IF v.inherent_call EXISTS AS rtoc_opt_child THEN
    &out.append(CollectValue{ FuncCall: COPY rtoc_opt_child });
  END
  RETURN out;
END
FN rtocChildrenOfCollectValueStringConcat(v: StringConcat) RETURNS []CollectValue ->
  MUTABLE out: []CollectValue = [];
  FOR rtoc_arr_child IN v.parts DO
    &out.append(castLocatableToCollectValue(COPY rtoc_arr_child));
  END
  RETURN out;
END
FN rtocChildrenOfCollectValueTenseNavigation(v: TenseNavigation) RETURNS []CollectValue ->
  MUTABLE out: []CollectValue = [];
  &out.append(castLocatableToCollectValue(COPY v.target));
  RETURN out;
END
FN rtocChildrenOfCollectValueWhileBindLoop(v: WhileBindLoop) RETURNS []CollectValue ->
  MUTABLE out: []CollectValue = [];
  &out.append(castLocatableToCollectValue(COPY v.condition));
  FOR rtoc_arr_child IN v.do_branch DO
    &out.append(castLocatableToCollectValue(COPY rtoc_arr_child));
  END
  RETURN out;
END
FN rtocChildrenOfCollectValueWhileLoop(v: WhileLoop) RETURNS []CollectValue ->
  MUTABLE out: []CollectValue = [];
  &out.append(castLocatableToCollectValue(COPY v.condition));
  FOR rtoc_arr_child IN v.do_branch DO
    &out.append(castLocatableToCollectValue(COPY rtoc_arr_child));
