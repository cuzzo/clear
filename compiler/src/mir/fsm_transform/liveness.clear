PUB FN liveness__analyze(segments: []Segment, ctx: {String@symbol}?TransformValue) RETURNS !LivenessResult ->
  MUTABLE captured: {String}Type@multiowned = COPY castOptionalTransformValueToHashMapStringTypeMultiowned((ctx[:captured] OR_ELSE {}));
  MUTABLE capture_names: [Set]String = captured.keys() |> DISTINCT _;
  MUTABLE defs_by_seg: {Int64}{String}?Type = {};
  MUTABLE uses_by_seg: {Int64}[Set]String = {};
  FOR _ IN segments DO
  defs_by_seg[_.index] = {};
  uses_by_seg[_.index] = (uses_by_seg[_.index] OR_ELSE Set[]);
  FOR _ IN _.stmts DO
    TRY (liveness__collect_defs(_, defs_by_seg[_.index]));
    liveness__collect_uses(_, &uses_by_seg[_.index]);
  END
  liveness__collect_tail_uses(_, uses_by_seg);
  IF ((((_.tail IS_A NextSuspend OR _.tail IS_A IoSuspend)) AND _.tail.result_var()) AND (_.tail.kind() != :io)) THEN
      MUTABLE rtoc_index_receiver_1 = UNWRAP (defs_by_seg[_.index]);
      rtoc_index_receiver_1[_.tail.result_var()] = NIL;
  END
  END
  MUTABLE first_def: {String}Int64 = {};
  MUTABLE last_use: {String}Int64 = {};
  MUTABLE type_by_name: {String}Type = {};
  defs_by_seg.keys() |> EACH {
  MUTABLE defs: {String}?Type = (defs_by_seg[_] OR_ELSE CAST(panic("missing hash key") AS {String}?Type));
  defs.keys() |> EACH {
  MUTABLE type: ?Type = (defs[_] OR_ELSE CAST(panic("missing hash key") AS ?Type));
  first_def[_] = (first_def[_] OR_ELSE _);
  IF type EXISTS AS type_value THEN
      type_by_name[_] = (type_by_name[_] OR_ELSE type_value);
  END
  };
  };
  uses_by_seg.keys() |> EACH {
  MUTABLE uses: [Set]String = (uses_by_seg[_] OR_ELSE CAST(panic("missing hash key") AS [Set]String));
  FOR _ IN uses DO
  last_use[_] = COPY _;
  END
  };
  MUTABLE cyclic_segs = TRY (liveness__compute_cyclic_segments(segments));
  MUTABLE cross: {String}CrossSegmentVarFact = {};
  FOR rtoc_each_2 IN first_def.keys() DO
  MUTABLE def_seg: Int64 = (first_def[rtoc_each_2] OR_ELSE CAST(panic("missing hash key") AS Int64));
  IF capture_names.contains?(rtoc_each_2) THEN
    CONTINUE;
  END
  MUTABLE use_seg: ?Int64 = last_use[rtoc_each_2];
  IF (use_seg == NIL) THEN
      CONTINUE;
  END
  IF !((use_seg > def_seg)) THEN
      IF !(cyclic_segs.contains?(def_seg)) THEN
        CONTINUE;
      END
  END
  cross[rtoc_each_2] = CrossSegmentVarFact{ type_info: COPY type_by_name[rtoc_each_2], first_def_seg: def_seg, last_use_seg: UNWRAP (use_seg) };
    END
  RETURN LivenessResult{ cross_segment_vars: cross };
END
PRIVATE FN liveness__compute_cyclic_segments(segments: []Segment) RETURNS ![Set]Int64 ->
  MUTABLE adj = {};
  FOR _ IN segments DO
  adj[_.index] = TRY (liveness__tail_targets(_));
  END
  MUTABLE cyclic = Set[];
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < segments.length() DO
    MUTABLE stack: ?Any = COPY (adj[segments[rtoc_idx]?.index]);
    MUTABLE visited = Set[];
    WHILE !(stack.empty?()) DO
        MUTABLE cur = &stack.shift();
        IF (cur == segments[rtoc_idx]?.index) THEN
          &cyclic.insert(segments[rtoc_idx]?.index);
          BREAK;
        END
        IF !(visited.add?(cur)) THEN
          rtoc_idx = rtoc_idx + 1;
  CONTINUE;
        END
        FOR _ IN ((adj[cur] OR_ELSE List[])) DO
        &stack.append(COPY _);
        END
    END
  rtoc_idx = rtoc_idx + 1;
  END
  RETURN cyclic;
END
PRIVATE FN liveness__tail_targets(seg: Segment) RETURNS ![]Int64 ->
  IF (seg.tail IS_A Done) THEN
    RETURN CAST(( { MUTABLE rtoc_empty_list_2: []Int64 = List[]; rtoc_empty_list_2 } ) AS []Int64);
  ELSE_IF (seg.tail IS_A Goto) OR (seg.tail IS_A LoopBack) THEN
    RETURN CAST([seg.tail.target_index()] AS []Int64);
  ELSE_IF (seg.tail IS_A CondBranch) THEN
    RETURN CAST([seg.tail.then_index(), seg.tail.else_index()] AS []Int64);
  ELSE_IF (seg.tail IS_A LockSuspend) THEN
    RETURN CAST([(seg.index + 1)] AS []Int64);
  ELSE
    IF Segments.suspend_tail?(seg.tail) THEN
      RETURN CAST([(seg.index + 1)] AS []Int64);
    ELSE
      RETURN CAST(( { MUTABLE rtoc_empty_list_3: []Int64 = List[]; rtoc_empty_list_3 } ) AS []Int64);
    END
  END
END
PRIVATE FN liveness__collect_tail_uses(seg: Segment, uses_by_seg: {Int64}[Set]String) RETURNS Void ->
  MUTABLE tail = seg.tail;
  IF (tail IS_A IoSuspend) THEN
    MUTABLE next_idx = (seg.index + 1);
    uses_by_seg[next_idx] = (uses_by_seg[next_idx] OR_ELSE Set[]);
    MUTABLE bucket: ?[Set]String = COPY uses_by_seg[next_idx];
    MUTABLE call_node = tail.call_node();
    IF call_node IS_A MethodCall THEN
      liveness__walk_idents(call_node.object(), %(name: String) USE(bucket) -> {
  (bucket?).insert(COPY name);
  rubyToClearVoid()
      });
    END
    FOR _ IN call_node.args() DO
    liveness__walk_idents(_, %(name: String) USE(bucket) -> {
  (bucket?).insert(COPY name);
  rubyToClearVoid()
    });
    END
  END
END
PRIVATE FN liveness__collect_defs(MUTABLE stmt: Stmt, into: Any) RETURNS !Void ->
  IF stmt IS_A VarDecl AS var_decl THEN
    MUTABLE var_decl_mutable = COPY var_decl;
    IF var_decl_mutable.name IS_A String THEN
      IF ((var_decl_mutable IS_A BindExpr AND FALSE) AND (var_decl_mutable.mode() != :decl)) THEN
        RETURN;
      END
      MUTABLE t: ?Type@multiowned = TRY (liveness__stmt_decl_type(BindingStmt{ VarDecl: COPY var_decl_mutable }));
      into[var_decl_mutable.name] = (into[var_decl_mutable.name] OR_ELSE t);
    END
  ELSE_IF stmt IS_A BindExpr AS bind_expr THEN
    MUTABLE bind_expr_mutable = COPY bind_expr;
    IF bind_expr_mutable.name IS_A String THEN
      IF ((TRUE AND TRUE) AND (bind_expr_mutable.mode != :decl)) THEN
        RETURN;
      END
      MUTABLE t: ?Type@multiowned = TRY (liveness__stmt_decl_type(BindingStmt{ BindExpr: COPY bind_expr_mutable }));
      into[bind_expr_mutable.name] = (into[bind_expr_mutable.name] OR_ELSE t);
    END
  ELSE_IF stmt IS_A Assignment AS assignment THEN
    IF assignment.name IS_A String THEN
      into[assignment.name] = (into[assignment.name] OR_ELSE NIL);
    END
  ELSE_IF stmt IS_A DestructuringAssignment AS destructuring_assignment THEN
    MUTABLE destructuring_assignment_mutable = COPY destructuring_assignment;
    MUTABLE rtoc_each_items_4 = destructuringAssignment__targets(destructuring_assignment_mutable);
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_4.length() DO
    IF (rtoc_each_items_4[rtoc_idx]?.name == "_") THEN
      rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    into[rtoc_each_items_4[rtoc_idx]?.name] = (into[rtoc_each_items_4[rtoc_idx]?.name] OR_ELSE TRY (liveness__stmt_decl_type(BindingStmt{ DestructureTarget: COPY rtoc_each_items_4[rtoc_idx]? })));
  rtoc_idx = rtoc_idx + 1;
    END
  END
END
PRIVATE FN liveness__stmt_decl_type(MUTABLE stmt: BindingStmt) RETURNS !?Type ->
  MUTABLE candidates: []?TypeTypeInput = List[];
  &candidates.append(&stmt.full_type_mut("FSM liveness declaration"));
  &candidates.append(UNWRAP (CAST((MATCH stmt START BindingStmt.VarDecl AS item -> item.type, BindingStmt.BindExpr AS item -> item.type, BindingStmt.DestructureTarget AS item -> item.type END) AS ?TypeTypeInput)));
  IF respondsTo?(stmt, "declared_type") THEN
    &candidates.append(UNWRAP (CAST(stmt.declared_type() AS ?TypeTypeInput)));
  END
  MUTABLE value: ?Locatable = NIL;
  IF (stmt IS_A VarDecl OR stmt IS_A BindExpr) THEN
    value = stmt.value();
  END
  IF value EXISTS AS value_value THEN
    MUTABLE value_value_mutable = COPY value_value;
    &candidates.append(&value_value_mutable.full_type_mut("FSM liveness declaration value"));
  END
  RETURN CAST(TRY (liveness__normalize_decl_type((candidates |> WHERE _ != NIL).first())) AS ?Type);
END
PRIVATE FN liveness__normalize_decl_type(value: ?TypeTypeInput) RETURNS !?Type ->
  IF value EXISTS AS value_value THEN
    RETURN TRY (type__new(castTypeTypeInputToTypeConstructionInput(value_value)));
  ELSE
    RETURN NIL;
  END
END
PRIVATE FN liveness__collect_uses(stmt: Any, MUTABLE into: ?[Set]String) RETURNS Void ->
  IF into EXISTS AS into_value THEN
    MUTABLE into_value_mutable = COPY into_value;
    liveness__walk_idents(stmt, %(name: String) USE(MUTABLE into_value_mutable) -> {
  &into_value_mutable.insert(COPY name);
  rubyToClearVoid()
    });
  ELSE
    RETURN;
  END
END
PUB FN liveness__walk_idents(node: ?AstIdentWalkRoot, block: FN(String) -> Void) RETURNS Void ->
  IF node EXISTS AS node_value THEN
    MUTABLE stack: []CollectValue = ( { MUTABLE rtoc_empty_list_5: []CollectValue = List[]; rtoc_empty_list_5 } );
    IF node_value IS_A []Node AS array THEN
      MUTABLE rtoc_reverse_items_6: []Node = array;
      MUTABLE rtoc_reverse_i_7 = rtoc_reverse_items_6.length() - 1;
      WHILE rtoc_reverse_i_7 >= 0 DO
  IF (((rtoc_reverse_items_6[rtoc_reverse_i_7])?) IS_A Locatable OR ((rtoc_reverse_items_6[rtoc_reverse_i_7])?) IS_A Emittable) THEN
          &stack.append(castNodeToCollectValue(COPY (rtoc_reverse_items_6[rtoc_reverse_i_7])?));
  END
  rtoc_reverse_i_7 = rtoc_reverse_i_7 - 1;
      END
    ELSE_IF (node_value IS_A Locatable) THEN
      &stack.append(castAstIdentWalkRootToCollectValue(COPY node_value));
    ELSE_IF node_value IS_A Emittable AS emittable THEN
      &stack.append(castEmittableToCollectValue(COPY emittable));
    END
    WHILE !((stack.length() == 0)) DO
      MUTABLE current = UNWRAP (&stack.pop());
      IF current IS_A Identifier AS identifier THEN
        block(identifier__name(identifier));
        CONTINUE;
      END
      IF current IS_A Ident THEN
        block(CAST(current.name() AS String));
        CONTINUE;
      END
      IF current IS_A Emittable AS emittable THEN
        FOR _ IN emittable.child_exprs().reverse() DO
        &stack.append(COPY _);
        END
        FOR _ IN emittable.body_slots().reverse() DO
        FOR _ IN _.body().reverse() DO
        &stack.append(COPY _);
        END
        END
        CONTINUE;
      END
      IF !(TRUE) THEN
        CONTINUE;
      END
      FOR rtoc_walk_child_8 IN rtocChildrenCollectValue(current) DO
      IF (rtoc_walk_child_8 == Array) THEN
        FOR _ IN rtoc_walk_child_8.reverse() DO
        IF _ IS_A Locatable THEN
          &stack.append(_);
        END
        END
      ELSE_IF (rtoc_walk_child_8 == Hash) THEN
        rtoc_walk_child_8.keys() |> EACH {
  MUTABLE child: Any = (rtoc_walk_child_8[_] OR_ELSE panic("missing hash key"));
  IF _ IS_A Locatable THEN
            &stack.append(_);
  END
  IF child IS_A Locatable THEN
            &stack.append(child);
  END
        };
      ELSE_IF (rtoc_walk_child_8 IS_A Locatable) THEN
        &stack.append(COPY rtoc_walk_child_8);
      END
      END
    END
  ELSE
    RETURN;
  END
END
# End Ruby module FsmTransform::Liveness
