FN castEmittableToCollectValue(value: Emittable) RETURNS CollectValue ->
  PARTIAL MATCH value START
    Emittable.MIRProgram AS cast_payload -> RETURN CollectValue{ MIRProgram: COPY cast_payload };,
    Emittable.MIRStructDef AS cast_payload -> RETURN CollectValue{ MIRStructDef: COPY cast_payload };,
