PUB FN liveness__walk_idents(node: ?AstIdentWalkRoot, block: FN(String) -> Void) RETURNS !Void ->
  IF node EXISTS AS node_value THEN
    MUTABLE stack: []CollectValue = List[];
    IF node_value IS_A []Node AS array THEN
      MUTABLE rtoc_reverse_items_6: []Node = array;
      MUTABLE rtoc_reverse_i_7 = rtoc_reverse_items_6.length() - 1;
      WHILE rtoc_reverse_i_7 >= 0 DO
  IF TRUE THEN
          &stack.append(castNodeToCollectValue(COPY (rtoc_reverse_items_6[rtoc_reverse_i_7])?));
  END
  rtoc_reverse_i_7 = rtoc_reverse_i_7 - 1;
      END
    ELSE_IF node_value IS_A Emittable AS emittable THEN
      &stack.append(castEmittableToCollectValue(COPY emittable));
    ELSE
      # Ruby's `when AST::Locatable` -- the union names the AST nodes
      # individually and nests the MIR ones under Emittable, so anything that
      # is not an Emittable is the AST case.
      &stack.append(castAstIdentWalkRootToCollectValue(COPY node_value));
    END
    WHILE !((stack.length() == 0)) DO
      MUTABLE current = UNWRAP (&stack.pop());
      IF current IS_A Identifier AS identifier THEN
        block(identifier__name(identifier));
        CONTINUE;
      END
      # Ruby asks `current.is_a?(MIR::Ident)`; CollectValue nests the MIR
      # nodes under its Emittable variant, so the test goes through it.
      IF current IS_A Emittable AS current_emittable THEN
        IF current_emittable IS_A Ident AS mir_ident THEN
          block(CAST(mir_ident.name AS String));
          CONTINUE;
        END
      END
      IF current IS_A Emittable AS emittable THEN
        MUTABLE walk_child_exprs = TRY (emittable__child_exprs(emittable));
        MUTABLE walk_ce_i = walk_child_exprs.length() - 1;
        WHILE walk_ce_i >= 0 DO
          &stack.append(castEmittableToCollectValue(COPY (walk_child_exprs[walk_ce_i])?));
          walk_ce_i = walk_ce_i - 1;
        END
        MUTABLE walk_body_slots = TRY (emittable__body_slots(emittable));
        MUTABLE walk_bs_i = walk_body_slots.length() - 1;
        WHILE walk_bs_i >= 0 DO
          MUTABLE walk_slot_body = COPY (UNWRAP (walk_body_slots[walk_bs_i])).body;
          MUTABLE walk_sb_i = walk_slot_body.length() - 1;
          WHILE walk_sb_i >= 0 DO
            &stack.append(castEmittableToCollectValue(COPY (walk_slot_body[walk_sb_i])?));
            walk_sb_i = walk_sb_i - 1;
          END
          walk_bs_i = walk_bs_i - 1;
        END
        CONTINUE;
      END
      FOR rtoc_walk_child_8 IN rtocChildrenCollectValue(current) DO
      # Ruby walks the node's fields with each_pair and pushes the Locatable
      # values it finds. rtocChildrenCollectValue is the generated form of that
      # walk, so its output is already the child list.
      &stack.append(COPY rtoc_walk_child_8);
      END
    END
  ELSE
    RETURN;
  END
END
# End Ruby module FsmTransform::Liveness
# End Ruby module FsmTransform
FN castAssignmentNameToCollectValue(value: AssignmentName) RETURNS CollectValue ->
  PARTIAL MATCH value START
    AssignmentName.Identifier AS cast_payload -> RETURN CollectValue{ Identifier: COPY cast_payload };,
    AssignmentName.GetField AS cast_payload -> RETURN CollectValue{ GetField: COPY cast_payload };,
    AssignmentName.GetIndex AS cast_payload -> RETURN CollectValue{ GetIndex: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to CollectValue");
  END
  panic("Invalid cast to CollectValue");
END
