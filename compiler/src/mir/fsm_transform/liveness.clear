PUB FN liveness__analyze(segments: []Segment, ctx: {String@symbol}?TransformValue) RETURNS !LivenessResult ->
  MUTABLE captured: {String}Type@multiowned = COPY castOptionalTransformValueToHashMapStringTypeMultiowned((ctx[:captured] OR_ELSE TransformValue{ HashMapValue: {} }));
  MUTABLE capture_names: [Set]String = captured.keys() |> DISTINCT _;
  MUTABLE defs_by_seg: {Int64}{String}?Type = {};
  MUTABLE uses_by_seg: {Int64}[Set]String = {};
  FOR seg IN segments DO
  defs_by_seg[seg.index] = {};
  uses_by_seg[seg.index] = (uses_by_seg[seg.index] OR_ELSE Set[]);
  MUTABLE seg_defs: {String}?Type = UNWRAP (defs_by_seg[seg.index]);
  MUTABLE seg_uses: [Set]String = UNWRAP (uses_by_seg[seg.index]);
  FOR stmt IN seg.stmts DO
    IF stmt IS_A SegmentBodyItem.Locatable AS ast_stmt THEN
      TRY (liveness__collect_defs(ast_stmt, &seg_defs));
    END
    TRY (liveness__collect_uses(stmt, seg_uses));
  END
  defs_by_seg[seg.index] = seg_defs;
  uses_by_seg[seg.index] = seg_uses;
  TRY (liveness__collect_tail_uses(seg, &uses_by_seg));
  IF ((((seg.tail IS_A NextSuspend OR seg.tail IS_A IoSuspend)) AND (segmentTail__result_var(seg.tail) != NIL)) AND (segmentTail__kind(seg.tail) != :io)) THEN
      MUTABLE tail_defs: {String}?Type = UNWRAP (defs_by_seg[seg.index]);
      tail_defs[UNWRAP (segmentTail__result_var(seg.tail))] = NIL;
      defs_by_seg[seg.index] = tail_defs;
  END
  END
  MUTABLE first_def: {String}Int64 = {};
  MUTABLE last_use: {String}Int64 = {};
  MUTABLE type_by_name: {String}Type = {};
  FOR seg_idx IN defs_by_seg.keys() DO
  MUTABLE defs: {String}?Type = (defs_by_seg[seg_idx] OR_ELSE CAST(panic("missing hash key") AS {String}?Type));
  FOR def_name IN defs.keys() DO
  MUTABLE type: ?Type = (defs[def_name] OR_ELSE CAST(panic("missing hash key") AS ?Type));
  first_def[def_name] = (first_def[def_name] OR_ELSE seg_idx);
  IF type EXISTS AS type_value THEN
      type_by_name[def_name] = (type_by_name[def_name] OR_ELSE type_value);
  END
  END
  END
  FOR use_seg_idx IN uses_by_seg.keys() DO
  MUTABLE uses: [Set]String = (uses_by_seg[use_seg_idx] OR_ELSE CAST(panic("missing hash key") AS [Set]String));
  FOR use_name IN uses DO
  last_use[use_name] = use_seg_idx;
  END
  END
  MUTABLE cyclic_segs = TRY (liveness__compute_cyclic_segments(segments));
  MUTABLE cross: {String}CrossSegmentVarFact = {};
  FOR rtoc_each_2 IN first_def.keys() DO
  MUTABLE def_seg: Int64 = (first_def[rtoc_each_2] OR_ELSE CAST(panic("missing hash key") AS Int64));
  IF capture_names.contains?(rtoc_each_2) THEN
    CONTINUE;
  END
  MUTABLE use_seg: ?Int64 = last_use[rtoc_each_2];
  IF (use_seg == NIL) THEN
      CONTINUE;
  END
  IF !((use_seg > def_seg)) THEN
      IF !(cyclic_segs.contains?(def_seg)) THEN
        CONTINUE;
      END
  END
  cross[rtoc_each_2] = CrossSegmentVarFact{ type_info: COPY type_by_name[rtoc_each_2], first_def_seg: def_seg, last_use_seg: use_seg };
    END
  RETURN LivenessResult{ cross_segment_vars: cross };
END
PRIVATE FN liveness__compute_cyclic_segments(segments: []Segment) RETURNS ![Set]Int64 ->
  MUTABLE adj: {Int64}[]Int64 = {};
  FOR _ IN segments DO
  adj[_.index] = TRY (liveness__tail_targets(_));
  END
  MUTABLE cyclic: [Set]Int64 = Set[];
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < segments.length() DO
    MUTABLE seg_index: Int64 = UNWRAP (segments[rtoc_idx]?.index);
    MUTABLE stack: []Int64 = COPY (UNWRAP (adj[seg_index]));
    MUTABLE visited = Set[];
    WHILE !(stack.empty?()) DO
        MUTABLE cur: Int64 = UNWRAP (&stack.shift());
        IF (cur == seg_index) THEN
          &cyclic.insert(seg_index);
          BREAK;
        END
        # Ruby's `next unless visited.add?(cur)` continues the INNER
        # `until stack.empty?` loop; advancing the outer counter here would
        # skip segments.
        IF !(&visited.insert(cur)) THEN
  CONTINUE;
        END
        FOR _ IN ((adj[cur] OR_ELSE List[])) DO
        &stack.append(COPY _);
        END
    END
  rtoc_idx = rtoc_idx + 1;
  END
  RETURN cyclic;
END
PRIVATE FN liveness__tail_targets(seg: Segment) RETURNS ![]Int64 ->
  IF (seg.tail IS_A Done) THEN
    RETURN CAST(List[] AS []Int64);
  ELSE_IF seg.tail IS_A Goto AS goto THEN
    RETURN CAST([goto.target_index] AS []Int64);
  ELSE_IF seg.tail IS_A LoopBack AS loop_back THEN
    RETURN CAST([loop_back.target_index] AS []Int64);
  ELSE_IF seg.tail IS_A CondBranch AS cond_branch THEN
    RETURN CAST([cond_branch.then_index, cond_branch.else_index] AS []Int64);
  ELSE_IF (seg.tail IS_A LockSuspend) THEN
    RETURN CAST([(seg.index + 1)] AS []Int64);
  ELSE
    IF segments__suspend_tail?(seg.tail) THEN
      RETURN CAST([(seg.index + 1)] AS []Int64);
    ELSE
      RETURN CAST(List[] AS []Int64);
    END
  END
END
PRIVATE FN liveness__collect_tail_uses(seg: Segment, MUTABLE uses_by_seg: {Int64}[Set]String) RETURNS !Void ->
  IF seg.tail IS_A IoSuspend AS io_tail THEN
    MUTABLE next_idx = (seg.index + 1);
    MUTABLE bucket: [Set]String = (COPY uses_by_seg[next_idx] OR_ELSE Set[]);
    MUTABLE call_node: Locatable = UNWRAP (COPY io_tail.call_node);
    IF call_node IS_A MethodCall AS method_call THEN
      TRY (liveness__walk_idents(castLocatableToOptionalAstIdentWalkRoot(method_call.object), %(name: String) USE(MUTABLE bucket) -> {
  &bucket.insert(COPY name);
  rubyToClearVoid__liveness()
      }));
    END
    FOR _ IN (locatable__args(call_node) OR_ELSE List[]) DO
    TRY (liveness__walk_idents(castLocatableToOptionalAstIdentWalkRoot(_), %(name: String) USE(MUTABLE bucket) -> {
  &bucket.insert(COPY name);
  rubyToClearVoid__liveness()
    }));
    END
    uses_by_seg[next_idx] = bucket;
  END
END
PRIVATE FN liveness__collect_defs(stmt: Locatable, MUTABLE into: {String}?Type) RETURNS !Void ->
  IF stmt IS_A VarDecl AS var_decl THEN
    MUTABLE var_decl_mutable = COPY var_decl;
    IF TRUE THEN
      # Ruby tests stmt.is_a?(AST::BindExpr) here, inside the VarDecl arm.
      IF FALSE THEN
        RETURN;
      END
      MUTABLE t: ?Type@multiowned = TRY (liveness__stmt_decl_type(BindingStmt{ VarDecl: COPY var_decl_mutable }));
      into[var_decl_mutable.name] = (into[var_decl_mutable.name] OR_ELSE t);
    END
  ELSE_IF stmt IS_A BindExpr AS bind_expr THEN
    MUTABLE bind_expr_mutable = COPY bind_expr;
    IF TRUE THEN
      IF ((TRUE AND TRUE) AND (bind_expr_mutable.mode != :decl)) THEN
        RETURN;
      END
      MUTABLE t: ?Type@multiowned = TRY (liveness__stmt_decl_type(BindingStmt{ BindExpr: COPY bind_expr_mutable }));
      into[bind_expr_mutable.name] = (into[bind_expr_mutable.name] OR_ELSE t);
    END
  ELSE_IF stmt IS_A Assignment AS assignment THEN
    IF assignment.name IS_A String AS assignment_name THEN
      into[assignment_name] = (into[assignment_name]);
    END
  ELSE_IF stmt IS_A DestructuringAssignment AS destructuring_assignment THEN
    MUTABLE destructuring_assignment_mutable = COPY destructuring_assignment;
    MUTABLE rtoc_each_items_4 = destructuringAssignment__targets(destructuring_assignment_mutable);
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_4.length() DO
    IF (emittable__name( CAST(UNWRAP (rtoc_each_items_4[rtoc_idx]) AS Emittable)) == "_") THEN
      rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    MUTABLE rtoc_key_1: String = COPY UNWRAP (rtoc_each_items_4[rtoc_idx]).name;
    into[rtoc_key_1] = (into[rtoc_key_1] OR_ELSE TRY (liveness__stmt_decl_type(BindingStmt{ DestructureTarget: COPY rtoc_each_items_4[rtoc_idx]? })));
  rtoc_idx = rtoc_idx + 1;
    END
  END
END
PRIVATE FN liveness__stmt_decl_type(stmt: BindingStmt) RETURNS !?Type ->
  MUTABLE candidates: []?TypeTypeInput = List[];
  &candidates.append(TRY (aST__full_type_mut( castBindingStmtToLocatable(stmt))));
  &candidates.append(UNWRAP (CAST(bindingStmt__type(stmt) AS ?TypeTypeInput)));
  # Ruby guards this with `stmt.respond_to?(:declared_type)`, and no AST node
  # defines declared_type -- the branch cannot run.
  IF FALSE THEN
    NIL;
  END
  MUTABLE value: ?Locatable = NIL;
  IF (stmt IS_A VarDecl OR stmt IS_A BindExpr) THEN
    value = bindingStmt__value(stmt);
  END
  IF value EXISTS AS value_value THEN
    MUTABLE value_value_mutable = COPY value_value;
    &candidates.append(TRY (aST__full_type_mut(value_value_mutable)));
  END
  RETURN CAST(TRY (liveness__normalize_decl_type((candidates |> WHERE _ != NIL).first())) AS ?Type);
END
PRIVATE FN liveness__normalize_decl_type(value: ?TypeTypeInput) RETURNS !?Type ->
  IF value EXISTS AS value_value THEN
    RETURN TRY (type__new(castTypeTypeInputToTypeConstructionInput__liveness(value_value)));
  ELSE
    RETURN NIL;
  END
END
PRIVATE FN liveness__collect_uses(stmt: Any, into: ?[Set]String) RETURNS !Void ->
  IF into EXISTS AS into_value THEN
    MUTABLE into_value_mutable = COPY into_value;
    TRY (liveness__walk_idents(stmt, %(name: String) USE(MUTABLE into_value_mutable) -> {
  &into_value_mutable.insert(COPY name);
  rubyToClearVoid__liveness()
    }));
  ELSE
    RETURN;
  END
END
FN castLocatableToOptionalAstIdentWalkRoot(value: Locatable) RETURNS ?AstIdentWalkRoot ->
  PARTIAL MATCH value START
    Locatable.RequireNode AS cast_payload -> RETURN AstIdentWalkRoot{ RequireNode: COPY cast_payload };,
    Locatable.ProtocolRequirement AS cast_payload -> RETURN AstIdentWalkRoot{ ProtocolRequirement: COPY cast_payload };,
    Locatable.ProtocolDef AS cast_payload -> RETURN AstIdentWalkRoot{ ProtocolDef: COPY cast_payload };,
    Locatable.FunctionDef AS cast_payload -> RETURN AstIdentWalkRoot{ FunctionDef: COPY cast_payload };,
    Locatable.ImplementationDef AS cast_payload -> RETURN AstIdentWalkRoot{ ImplementationDef: COPY cast_payload };,
    Locatable.ConformanceDef AS cast_payload -> RETURN AstIdentWalkRoot{ ConformanceDef: COPY cast_payload };,
    Locatable.VarDecl AS cast_payload -> RETURN AstIdentWalkRoot{ VarDecl: COPY cast_payload };,
    Locatable.Assignment AS cast_payload -> RETURN AstIdentWalkRoot{ Assignment: COPY cast_payload };,
    Locatable.DestructuringAssignment AS cast_payload -> RETURN AstIdentWalkRoot{ DestructuringAssignment: COPY cast_payload };,
    Locatable.BindExpr AS cast_payload -> RETURN AstIdentWalkRoot{ BindExpr: COPY cast_payload };,
    Locatable.BinaryOp AS cast_payload -> RETURN AstIdentWalkRoot{ BinaryOp: COPY cast_payload };,
    Locatable.IsA AS cast_payload -> RETURN AstIdentWalkRoot{ IsA: COPY cast_payload };,
    Locatable.CallSiteOverride AS cast_payload -> RETURN AstIdentWalkRoot{ CallSiteOverride: COPY cast_payload };,
    Locatable.Identifier AS cast_payload -> RETURN AstIdentWalkRoot{ Identifier: COPY cast_payload };,
    Locatable.Literal AS cast_payload -> RETURN AstIdentWalkRoot{ Literal: COPY cast_payload };,
    Locatable.ListLit AS cast_payload -> RETURN AstIdentWalkRoot{ ListLit: COPY cast_payload };,
    Locatable.TupleLit AS cast_payload -> RETURN AstIdentWalkRoot{ TupleLit: COPY cast_payload };,
    Locatable.DefaultArrayLit AS cast_payload -> RETURN AstIdentWalkRoot{ DefaultArrayLit: COPY cast_payload };,
    Locatable.HashLit AS cast_payload -> RETURN AstIdentWalkRoot{ HashLit: COPY cast_payload };,
    Locatable.DefaultLit AS cast_payload -> RETURN AstIdentWalkRoot{ DefaultLit: COPY cast_payload };,
    Locatable.StructLit AS cast_payload -> RETURN AstIdentWalkRoot{ StructLit: COPY cast_payload };,
    Locatable.LambdaLit AS cast_payload -> RETURN AstIdentWalkRoot{ LambdaLit: COPY cast_payload };,
    Locatable.IfStatement AS cast_payload -> RETURN AstIdentWalkRoot{ IfStatement: COPY cast_payload };,
    Locatable.IfBind AS cast_payload -> RETURN AstIdentWalkRoot{ IfBind: COPY cast_payload };,
    Locatable.WhileLoop AS cast_payload -> RETURN AstIdentWalkRoot{ WhileLoop: COPY cast_payload };,
    Locatable.WhileBindLoop AS cast_payload -> RETURN AstIdentWalkRoot{ WhileBindLoop: COPY cast_payload };,
    Locatable.BreakNode AS cast_payload -> RETURN AstIdentWalkRoot{ BreakNode: COPY cast_payload };,
    Locatable.ContinueNode AS cast_payload -> RETURN AstIdentWalkRoot{ ContinueNode: COPY cast_payload };,
    Locatable.FuncCall AS cast_payload -> RETURN AstIdentWalkRoot{ FuncCall: COPY cast_payload };,
    Locatable.GetField AS cast_payload -> RETURN AstIdentWalkRoot{ GetField: COPY cast_payload };,
    Locatable.GetIndex AS cast_payload -> RETURN AstIdentWalkRoot{ GetIndex: COPY cast_payload };,
    Locatable.ReturnNode AS cast_payload -> RETURN AstIdentWalkRoot{ ReturnNode: COPY cast_payload };,
    Locatable.Assert AS cast_payload -> RETURN AstIdentWalkRoot{ Assert: COPY cast_payload };,
    Locatable.Raise AS cast_payload -> RETURN AstIdentWalkRoot{ Raise: COPY cast_payload };,
    Locatable.ThrowNode AS cast_payload -> RETURN AstIdentWalkRoot{ ThrowNode: COPY cast_payload };,
    Locatable.DieNode AS cast_payload -> RETURN AstIdentWalkRoot{ DieNode: COPY cast_payload };,
    Locatable.Slice AS cast_payload -> RETURN AstIdentWalkRoot{ Slice: COPY cast_payload };,
    Locatable.Require AS cast_payload -> RETURN AstIdentWalkRoot{ Require: COPY cast_payload };,
    Locatable.WithBlock AS cast_payload -> RETURN AstIdentWalkRoot{ WithBlock: COPY cast_payload };,
    Locatable.SyncPolicyDecl AS cast_payload -> RETURN AstIdentWalkRoot{ SyncPolicyDecl: COPY cast_payload };,
    Locatable.SelectOp AS cast_payload -> RETURN AstIdentWalkRoot{ SelectOp: COPY cast_payload };,
    Locatable.WhereOp AS cast_payload -> RETURN AstIdentWalkRoot{ WhereOp: COPY cast_payload };,
    Locatable.IndexOp AS cast_payload -> RETURN AstIdentWalkRoot{ IndexOp: COPY cast_payload };,
    Locatable.ReduceOp AS cast_payload -> RETURN AstIdentWalkRoot{ ReduceOp: COPY cast_payload };,
    Locatable.OrderByOp AS cast_payload -> RETURN AstIdentWalkRoot{ OrderByOp: COPY cast_payload };,
    Locatable.LimitOp AS cast_payload -> RETURN AstIdentWalkRoot{ LimitOp: COPY cast_payload };,
    Locatable.UnnestOp AS cast_payload -> RETURN AstIdentWalkRoot{ UnnestOp: COPY cast_payload };,
    Locatable.DistinctOp AS cast_payload -> RETURN AstIdentWalkRoot{ DistinctOp: COPY cast_payload };,
    Locatable.EachOp AS cast_payload -> RETURN AstIdentWalkRoot{ EachOp: COPY cast_payload };,
    Locatable.TapOp AS cast_payload -> RETURN AstIdentWalkRoot{ TapOp: COPY cast_payload };,
    Locatable.SkipOp AS cast_payload -> RETURN AstIdentWalkRoot{ SkipOp: COPY cast_payload };,
    Locatable.CollectOp AS cast_payload -> RETURN AstIdentWalkRoot{ CollectOp: COPY cast_payload };,
    Locatable.TakeWhileOp AS cast_payload -> RETURN AstIdentWalkRoot{ TakeWhileOp: COPY cast_payload };,
    Locatable.WindowOp AS cast_payload -> RETURN AstIdentWalkRoot{ WindowOp: COPY cast_payload };,
    Locatable.BatchWindowOp AS cast_payload -> RETURN AstIdentWalkRoot{ BatchWindowOp: COPY cast_payload };,
