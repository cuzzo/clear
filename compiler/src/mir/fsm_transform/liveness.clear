FN castAssignmentNameToCollectValue(value: AssignmentName) RETURNS CollectValue ->
  PARTIAL MATCH value START
    AssignmentName.Identifier AS cast_payload -> RETURN CollectValue{ Identifier: COPY cast_payload };,
    AssignmentName.GetField AS cast_payload -> RETURN CollectValue{ GetField: COPY cast_payload };,
    AssignmentName.GetIndex AS cast_payload -> RETURN CollectValue{ GetIndex: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to CollectValue");
  END
  panic("Invalid cast to CollectValue");
END
FN castAstIdentWalkRootToCollectValue(value: AstIdentWalkRoot) RETURNS CollectValue ->
  PARTIAL MATCH value START
    AstIdentWalkRoot.MIRProgram AS cast_payload -> RETURN CollectValue{ MIRProgram: COPY cast_payload };,
    AstIdentWalkRoot.RequireNode AS cast_payload -> RETURN CollectValue{ RequireNode: COPY cast_payload };,
    AstIdentWalkRoot.ProtocolRequirement AS cast_payload -> RETURN CollectValue{ ProtocolRequirement: COPY cast_payload };,
    AstIdentWalkRoot.ProtocolDef AS cast_payload -> RETURN CollectValue{ ProtocolDef: COPY cast_payload };,
    AstIdentWalkRoot.FunctionDefMultiowned AS cast_payload -> RETURN CollectValue{ FunctionDefMultiowned: COPY cast_payload };,
    AstIdentWalkRoot.ImplementationDef AS cast_payload -> RETURN CollectValue{ ImplementationDef: COPY cast_payload };,
    AstIdentWalkRoot.ConformanceDef AS cast_payload -> RETURN CollectValue{ ConformanceDef: COPY cast_payload };,
    AstIdentWalkRoot.MIRStructDef AS cast_payload -> RETURN CollectValue{ MIRStructDef: COPY cast_payload };,
    AstIdentWalkRoot.VarDecl AS cast_payload -> RETURN CollectValue{ VarDecl: COPY cast_payload };,
    AstIdentWalkRoot.Assignment AS cast_payload -> RETURN CollectValue{ Assignment: COPY cast_payload };,
    AstIdentWalkRoot.MIRDestructureTarget AS cast_payload -> RETURN CollectValue{ MIRDestructureTarget: COPY cast_payload };,
    AstIdentWalkRoot.DestructuringAssignment AS cast_payload -> RETURN CollectValue{ DestructuringAssignment: COPY cast_payload };,
    AstIdentWalkRoot.BindExpr AS cast_payload -> RETURN CollectValue{ BindExpr: COPY cast_payload };,
    AstIdentWalkRoot.BinaryOp AS cast_payload -> RETURN CollectValue{ BinaryOp: COPY cast_payload };,
    AstIdentWalkRoot.IsA AS cast_payload -> RETURN CollectValue{ IsA: COPY cast_payload };,
    AstIdentWalkRoot.MIRUnaryOp AS cast_payload -> RETURN CollectValue{ MIRUnaryOp: COPY cast_payload };,
    AstIdentWalkRoot.CallSiteOverride AS cast_payload -> RETURN CollectValue{ CallSiteOverride: COPY cast_payload };,
    AstIdentWalkRoot.Identifier AS cast_payload -> RETURN CollectValue{ Identifier: COPY cast_payload };,
    AstIdentWalkRoot.Literal AS cast_payload -> RETURN CollectValue{ Literal: COPY cast_payload };,
    AstIdentWalkRoot.ListLit AS cast_payload -> RETURN CollectValue{ ListLit: COPY cast_payload };,
    AstIdentWalkRoot.TupleLit AS cast_payload -> RETURN CollectValue{ TupleLit: COPY cast_payload };,
    AstIdentWalkRoot.DefaultArrayLit AS cast_payload -> RETURN CollectValue{ DefaultArrayLit: COPY cast_payload };,
    AstIdentWalkRoot.HashLit AS cast_payload -> RETURN CollectValue{ HashLit: COPY cast_payload };,
    AstIdentWalkRoot.DefaultLit AS cast_payload -> RETURN CollectValue{ DefaultLit: COPY cast_payload };,
    AstIdentWalkRoot.StructLit AS cast_payload -> RETURN CollectValue{ StructLit: COPY cast_payload };,
    AstIdentWalkRoot.LambdaLit AS cast_payload -> RETURN CollectValue{ LambdaLit: COPY cast_payload };,
    AstIdentWalkRoot.IfStatement AS cast_payload -> RETURN CollectValue{ IfStatement: COPY cast_payload };,
    AstIdentWalkRoot.IfBind AS cast_payload -> RETURN CollectValue{ IfBind: COPY cast_payload };,
    AstIdentWalkRoot.WhileLoop AS cast_payload -> RETURN CollectValue{ WhileLoop: COPY cast_payload };,
