PUB FN fsmEmitContext__with_extra_ctx_fields(self: FsmEmitContext, fields: []ContextFieldDecl) RETURNS FsmEmitContext ->
  RETURN FsmEmitContext{ id: self.id, bg_rt: COPY self.bg_rt, blk_label: COPY self.blk_label, ctx_type: COPY self.ctx_type, promise_zig: COPY self.promise_zig, async_result_shape: COPY self.async_result_shape, capture_fields: COPY self.capture_fields, alloc_var: COPY self.alloc_var, promise_var: COPY self.promise_var, ctx_var: COPY self.ctx_var, rt_name: COPY self.rt_name, promoted_decls: COPY self.promoted_decls, capture_inits: COPY self.capture_inits, captured: COPY self.captured, capture_close_plans: COPY self.capture_close_plans, pointer_captures: COPY self.pointer_captures, extra_ctx_fields: COPY fields, recursive_promoted_names: COPY self.recursive_promoted_names, fresh_heap_cleanup_names: COPY self.fresh_heap_cleanup_names, capture_finalizers: COPY self.capture_finalizers, arena_init_flag: self.arena_init_flag, is_void: self.is_void, pin_mode: KEEP self.pin_mode, parallel: self.parallel, profile_site_id: self.profile_site_id, profile_line: self.profile_line, profile_column: self.profile_column, destroy_actions: COPY self.destroy_actions };
