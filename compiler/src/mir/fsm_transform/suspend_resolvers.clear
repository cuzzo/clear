REQUIRE "pkg:rtoc_6173742f747970652e636c656172" AS type
REQUIRE "pkg:rtoc_6d69722f6d69722e636c656172" AS mir
REQUIRE "pkg:rtoc_6d69722f66736d5f7472616e73666f726d2f636f6e746578742e636c656172" AS context
REQUIRE "pkg:rtoc_6d69722f66736d5f6f70732e636c656172" AS fsm_ops
REQUIRE "pkg:rtoc_6173742f6173742e636c656172" AS ast
REQUIRE "pkg:rtoc_6d69722f66736d5f7472616e73666f726d2f7365676d656e74732e636c656172" AS segments
REQUIRE "pkg:rtoc_6d69722f66736d5f7472616e73666f726d2e636c656172" AS fsm_transform
REQUIRE "pkg:rtoc_6d69722f66736d5f7472616e73666f726d2f656d69742e636c656172" AS emit
REQUIRE "pkg:rtoc_6d69722f6d69725f6c6f776572696e672e636c656172" AS mir_lowering
REQUIRE "pkg:rtoc_6d69722f66736d5f7472616e73666f726d2f6c6f776572696e675f70726f746f636f6c2e636c656172" AS lowering_protocol
# Ruby module FsmTransform
# Ruby module FsmTransform::SuspendResolvers
PUB FN suspendResolvers__resolve(seg: Segment, ctx: FsmEmitContext, MUTABLE lowering: MIRLowering, susp_idx: ?Int64 = NIL) RETURNS !SuspendDescriptor ->
  IF (seg.tail IS_A IoSuspend) THEN
    RETURN TRY (suspendResolvers__resolve_io( CAST(seg.tail AS IoSuspend), ctx, &lowering));
  ELSE_IF (seg.tail IS_A NextSuspend) THEN
    RETURN TRY (suspendResolvers__resolve_next( CAST(seg.tail AS NextSuspend), ctx, &lowering, (susp_idx OR_ELSE ((seg.index + 1)))));
  ELSE
    panic("{}Add a resolve_<kind> branch when introducing a new suspend kind.");
  END
END
PRIVATE FN suspendResolvers__resolve_io(io_tail: IoSuspend, ctx: FsmEmitContext, MUTABLE lowering: MIRLowering) RETURNS !SuspendDescriptor ->
  MUTABLE stdlib_def: ?FunctionSignature = COPY io_tail.stdlib_def;
  IF !(stdlib_def) THEN
    panic("IoSuspend missing stdlib_def");
  END
  MUTABLE id = ctx.id;
  MUTABLE em: ?IntrinsicEmit = functionSignature__emit(stdlib_def);
  MUTABLE setup_ops: []Any = List[];
  IF em != NIL THEN
    setup_ops = COPY em.fsm_setup;
  END
  MUTABLE finish_block: []Any = List[];
  IF em != NIL THEN
    finish_block = COPY em.fsm_finish_block;
  END
  MUTABLE finish_value:? = (IF em != NIL THEN
    em.fsm_finish_value
  ELSE
    NIL
  END);
  MUTABLE state_decls: []Any = List[];
  IF em != NIL THEN
    state_decls = COPY em.fsm_state_decls;
  END
  MUTABLE state_finalize: []Any = List[];
  IF em != NIL THEN
    state_finalize = COPY em.fsm_state_finalize;
  END
  MUTABLE arg_mirs: []Emittable = List[];
  FOR MUTABLE arg_node IN (locatable__args(UNWRAP (io_tail.call_node)) OR_ELSE List[]) DO
    &arg_mirs.append(UNWRAP (TRY (mIRLowering__lower(&lowering, castLocatableToMIRLoweringLowerableStmt(arg_node)))));
  END
  MUTABLE lowerer = lowerer__new(id, arg_mirs);
  MUTABLE setup_mir = TRY (lowerer__lower_stmts(lowerer, setup_ops));
  MUTABLE state_finalize_m = TRY (lowerer__lower_stmts(lowerer, state_finalize));
  MUTABLE finish_block_mir = TRY (lowerer__lower_stmts(lowerer, finish_block));
  MUTABLE finish_value_mir_branch_value: ?Emittable = NIL;
  IF finish_value THEN
    finish_value_mir_branch_value = TRY (lowerer__lower_expr(lowerer, finish_value));
  ELSE
    finish_value_mir_branch_value = NIL;
  END
  MUTABLE finish_value_mir: ?Emittable = finish_value_mir_branch_value;
  MUTABLE finish_value_template_owned = TRY (fsmOps__finish_value_aliases_finalized_state?(finish_value, state_finalize));
  MUTABLE bind_stmts = List[];
  bind_stmts = ruby_array_concat_Any__suspend_resolvers(bind_stmts, CAST(state_finalize_m AS []Any));
  bind_stmts = ruby_array_concat_Any__suspend_resolvers(bind_stmts, CAST(finish_block_mir AS []Any));
  MUTABLE result_var: ?String = COPY io_tail.result_var;
  MUTABLE result_zig_type: ?String = NIL;
  MUTABLE result_needs_cleanup = FALSE;
  MUTABLE ctx_field_decls = state_decls |> SELECT suspendResolvers__state_field_decl(_);
  IF (((finish_value_mir != NIL) AND result_var) AND (result_var != "_")) THEN
    MUTABLE ft: ?Type = TRY (type__from_node_mut(io_tail.call_node, "FSM IO tail result"));
    result_zig_type = IF ft THEN
      TRY (type__zig_type((TRY (type__new(castTypeToTypeConstructionInput__suspend_resolvers(ft))))))
    ELSE
      NIL
    END;
    IF !(result_zig_type) THEN
      panic("FSM IO result {} missing Zig type");
    END
    MUTABLE ctx_ident = Ident{ name: "__ctx_${id.toString()}", lowered_node_id: NIL, ownership_consumption: NIL };
    &ctx_field_decls.append(suspendResolvers__ctx_field_decl( result_var, result_zig_type, Emittable{ Undef: COPY Undef{ zig_type: NIL, lowered_node_id: NIL, ownership_consumption: NIL } }));
    &bind_stmts.append(Set{ target: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY ctx_ident }, field: COPY result_var, lowered_node_id: NIL, ownership_consumption: NIL } }, value: COPY finish_value_mir, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
    result_needs_cleanup = (TRY (suspendResolvers__ownership_bearing_result_type?(ft, &lowering)) AND !(finish_value_template_owned));
  ELSE_IF finish_value_mir THEN
    &bind_stmts.append(ExprStmt{ expr: COPY finish_value_mir, discard: TRUE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
  END
  IF ((result_var AND TRUE) AND result_needs_cleanup) THEN
    MUTABLE ctx_ident = Ident{ name: "__ctx_${id.toString()}", lowered_node_id: NIL, ownership_consumption: NIL };
    &ctx_field_decls.append(suspendResolvers__fsm_owned_guard_decl( result_var));
    &bind_stmts.append(Set{ target: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY ctx_ident }, field: COPY suspendResolvers__fsm_owned_guard_name( result_var), lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Lit: COPY Lit{ value: "true", lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
  END
  RETURN SuspendDescriptor{ setup_stmts: setup_mir, bind_stmts: bind_stmts, tail: FsmTail{ FsmTailYield: COPY FsmTailYield{ next_step: NIL, yield_reason: "WaitForLock" } }, ctx_field_decls: ctx_field_decls, result_var: COPY result_var, result_zig_type: result_zig_type, result_needs_cleanup: result_needs_cleanup };
END
PRIVATE FN suspendResolvers__resolve_next(next_tail: NextSuspend, ctx: FsmEmitContext, MUTABLE lowering: MIRLowering, susp_idx: Int64) RETURNS !SuspendDescriptor ->
  MUTABLE id = ctx.id;
  MUTABLE sp_field = "sp_${susp_idx.toString()}";
  MUTABLE promise_expr_mir: ?Emittable = TRY (mIRLowering__lower( &lowering, castLocatableToMIRLoweringLowerableStmt( UNWRAP (next_tail.promise_ast))));
  MUTABLE ctx_ident = Ident{ name: "__ctx_${id.toString()}", lowered_node_id: NIL, ownership_consumption: NIL };
  MUTABLE setup_stmts = [Emittable{ Set: COPY Set{ target: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY ctx_ident }, field: COPY sp_field, lowered_node_id: NIL, ownership_consumption: NIL } }, value: UNWRAP (COPY promise_expr_mir), needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }];
  MUTABLE captured_promise_guard_name: ?String = NIL;
  MUTABLE captured_names = ctx.captured.keys() |> SELECT _.toString();
  MUTABLE promise_root:? = (aST__root_identifier(UNWRAP (next_tail.promise_ast)));
  IF (promise_root AND captured_names.contains?(CAST(identifier__name(promise_root) AS String))) THEN
    captured_promise_guard_name = "${identifier__name(promise_root)}_moved";
    &setup_stmts.append(Set{ target: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY ctx_ident }, field: UNWRAP (COPY captured_promise_guard_name), lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Lit: COPY Lit{ value: "true", lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
  END
  MUTABLE register_expr = MIRMethodCall{ receiver: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY ctx_ident }, field: COPY sp_field, lowered_node_id: NIL, ownership_consumption: NIL } }, field: "inner", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "wg", lowered_node_id: NIL, ownership_consumption: NIL } }, method: "registerFsmWaiter", args: [CAST(FieldGet{ object: Emittable{ Ident: COPY ctx_ident }, field: "task", lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: FALSE, callable_contract: NIL, owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
  MUTABLE tail = FsmTailRegisterYield{ next_step: NIL, register_expr: Emittable{ MIRMethodCall: register_expr }, yield_reason: "WaitForLock" };
  MUTABLE result_var: ?String = COPY next_tail.result_var;
  MUTABLE promise_ft: ?Type = TRY (type__from_node_mut(next_tail.promise_ast, "FSM NEXT tail promise"));
  MUTABLE sp_zig = TRY (type__zig_type((TRY (type__new(castTypeToTypeConstructionInput__suspend_resolvers( UNWRAP (promise_ft)))))));
  MUTABLE inner_type_info: ?Type = NIL;
  MUTABLE promise_type = TRY (type__new(castTypeToTypeConstructionInput__suspend_resolvers( UNWRAP (promise_ft))));
  MUTABLE inner_zig: ?String =   IF type__future?(promise_type) THEN
    {
  MUTABLE rtoc_value_block_marker = 0;
  inner_type_info = TRY (type__new(castTypeToTypeConstructionInput__suspend_resolvers(TRY (type__tense_type(promise_type)))));
  TRY (type__zig_type(UNWRAP (inner_type_info)))
  }
  ELSE
    NIL
  END;
  MUTABLE result_needs_cleanup = TRY (suspendResolvers__ownership_bearing_result_type?(inner_type_info, &lowering));
  MUTABLE finish_call = MIRMethodCall{ receiver: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY ctx_ident }, field: COPY sp_field, lowered_node_id: NIL, ownership_consumption: NIL } }, method: "finishFsmNext", args: List[], try_wrap: FALSE, callable_contract: NIL, owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
  MUTABLE err_name = "__err_${susp_idx.toString()}";
  MUTABLE finish_expr = TryCatch{ expr: Emittable{ MIRMethodCall: COPY finish_call }, catch_body: Emittable{ ScopeBlock: COPY ScopeBlock{ body: [Emittable{ ReturnStmt: COPY ReturnStmt{ value: Emittable{ Ident: COPY Ident{ name: COPY err_name, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, capture: COPY err_name, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
  IF inner_type_info EXISTS AS inner_type_info_value THEN
    MUTABLE inner_type_info_value_mutable = COPY inner_type_info_value;
    finish_expr.result_type = inner_type_info_value_mutable;
  END
  MUTABLE bind_stmts: []Emittable = List[];
  IF result_var THEN
  MUTABLE rtoc_value_block_marker = 0;
  MUTABLE res_name = "__res_${susp_idx.toString()}";
  MUTABLE stmts = [Emittable{ Let: COPY Let{ name: COPY res_name, init: Emittable{ TryCatch: COPY finish_expr }, mutable: FALSE, annotation: COPY TRY (type__new(TypeConstructionInput{ StringValue: COPY UNWRAP (inner_zig) })), suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }, Emittable{ Set: COPY Set{ target: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY ctx_ident }, field: COPY result_var, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Ident: COPY Ident{ name: COPY res_name, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }];
  IF result_needs_cleanup THEN
    &stmts.append(Set{ target: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY ctx_ident }, field: COPY suspendResolvers__fsm_owned_guard_name( result_var), lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Lit: COPY Lit{ value: "true", lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
  END
    bind_stmts = CAST(stmts AS []Emittable);
  ELSE
    bind_stmts = CAST([Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ TryCatch: COPY finish_expr }, discard: TRUE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable);
  END
  MUTABLE ctx_field_decls = [suspendResolvers__ctx_field_decl(sp_field, sp_zig, Emittable{ Undef: COPY Undef{ zig_type: NIL, lowered_node_id: NIL, ownership_consumption: NIL } })];
  IF captured_promise_guard_name EXISTS AS captured_promise_guard_name_value THEN
    &ctx_field_decls.append(suspendResolvers__ctx_field_decl(captured_promise_guard_name_value, "bool", Emittable{ Lit: COPY Lit{ value: "false", lowered_node_id: NIL, ownership_consumption: NIL } }));
  END
  IF (result_var AND (inner_zig != NIL)) THEN
    &ctx_field_decls.append(suspendResolvers__ctx_field_decl( result_var, inner_zig, Emittable{ Undef: COPY Undef{ zig_type: NIL, lowered_node_id: NIL, ownership_consumption: NIL } }));
    IF result_needs_cleanup THEN
      &ctx_field_decls.append(suspendResolvers__fsm_owned_guard_decl( result_var));
    END
  END
  RETURN SuspendDescriptor{ setup_stmts: setup_stmts, bind_stmts: bind_stmts, tail: FsmTail{ FsmTailRegisterYield: COPY tail }, ctx_field_decls: ctx_field_decls, result_var: COPY result_var, result_zig_type: inner_zig, result_needs_cleanup: result_needs_cleanup };
END
PUB FN suspendResolvers__fsm_owned_guard_name(name: String) RETURNS String ->
  RETURN "__owned_${name}_init";
END
PUB FN suspendResolvers__fsm_owned_guard_decl(name: String) RETURNS ContextFieldDecl ->
  RETURN suspendResolvers__ctx_field_decl(suspendResolvers__fsm_owned_guard_name(name), "bool", Emittable{ Lit: COPY Lit{ value: "false", lowered_node_id: NIL, ownership_consumption: NIL } });
END
PRIVATE FN suspendResolvers__ctx_field_decl(name: String, type_zig: String, default_value: ?Emittable) RETURNS ContextFieldDecl ->
  RETURN ContextFieldDecl{ name: COPY name, type_zig: COPY type_zig, default_value: COPY default_value };
END
PRIVATE FN suspendResolvers__state_field_decl(decl: StateFieldDecl) RETURNS ContextFieldDecl ->
  RETURN suspendResolvers__ctx_field_decl(decl.name, decl.zig_type, decl.default_value);
END
PUB FN suspendResolvers__ownership_bearing_result_type?(type_info: ?Type, MUTABLE lowering: MIRLowering) RETURNS !Bool ->
  IF type_info EXISTS AS type_info_value THEN
    MUTABLE schema_lookup = mIRLowering__mir_schema_lookup(&lowering);
    RETURN (((TRY (type__string?(type_info_value)) OR TRY (type__heap_ptr?(type_info_value))) OR TRY (type__collection_value?(type_info_value))) OR TRY (type__recursive_cleanup_shape?(type_info_value, schema_lookup)));
  ELSE
    RETURN FALSE;
  END
CATCH Transient, Input, System, NotFound, Permission, Canceled
  RETURN FALSE;
END
# End Ruby module FsmTransform::SuspendResolvers
# End Ruby module FsmTransform
FN castLocatableToMIRLoweringLowerableStmt(value: Locatable) RETURNS MIRLoweringLowerableStmt ->
  PARTIAL MATCH value START
    Locatable.Program AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ASTProgram: COPY cast_payload };,
    Locatable.StructDef AS cast_payload -> RETURN MIRLoweringLowerableStmt{ StructDef: COPY cast_payload };,
    Locatable.BgBlock AS cast_payload -> RETURN MIRLoweringLowerableStmt{ BgBlock: COPY cast_payload };,
    Locatable.Cast AS cast_payload -> RETURN MIRLoweringLowerableStmt{ Cast: COPY cast_payload };,
    Locatable.DeferStmt AS cast_payload -> RETURN MIRLoweringLowerableStmt{ DeferStmt: COPY cast_payload };,
    Locatable.OptionalUnwrap AS cast_payload -> RETURN MIRLoweringLowerableStmt{ OptionalUnwrap: COPY cast_payload };,
    Locatable.OrElseBreak AS cast_payload -> RETURN MIRLoweringLowerableStmt{ OrElseBreak: COPY cast_payload };,
    Locatable.OrElseExit AS cast_payload -> RETURN MIRLoweringLowerableStmt{ OrElseExit: COPY cast_payload };,
    Locatable.OrElsePass AS cast_payload -> RETURN MIRLoweringLowerableStmt{ OrElsePass: COPY cast_payload };,
    Locatable.OrElsePrune AS cast_payload -> RETURN MIRLoweringLowerableStmt{ OrElsePrune: COPY cast_payload };,
    Locatable.OrElseRaise AS cast_payload -> RETURN MIRLoweringLowerableStmt{ OrElseRaise: COPY cast_payload };,
    Locatable.RangeLit AS cast_payload -> RETURN MIRLoweringLowerableStmt{ RangeLit: COPY cast_payload };,
    Locatable.UnaryOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ UnaryOp: COPY cast_payload };,
    Locatable.BlockExpr AS cast_payload -> RETURN MIRLoweringLowerableStmt{ BlockExpr: COPY cast_payload };,
    Locatable.DoBlock AS cast_payload -> RETURN MIRLoweringLowerableStmt{ DoBlock: COPY cast_payload };,
    Locatable.Raise AS cast_payload -> RETURN MIRLoweringLowerableStmt{ Raise: COPY cast_payload };,
    Locatable.RequireNode AS cast_payload -> RETURN MIRLoweringLowerableStmt{ RequireNode: COPY cast_payload };,
    Locatable.ProtocolRequirement AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ProtocolRequirement: COPY cast_payload };,
    Locatable.ProtocolDef AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ProtocolDef: COPY cast_payload };,
    Locatable.FunctionDef AS cast_payload -> RETURN MIRLoweringLowerableStmt{ FunctionDef: COPY cast_payload };,
    Locatable.ImplementationDef AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ImplementationDef: COPY cast_payload };,
    Locatable.ConformanceDef AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ConformanceDef: COPY cast_payload };,
    Locatable.VarDecl AS cast_payload -> RETURN MIRLoweringLowerableStmt{ VarDecl: COPY cast_payload };,
    Locatable.Assignment AS cast_payload -> RETURN MIRLoweringLowerableStmt{ Assignment: COPY cast_payload };,
    Locatable.DestructuringAssignment AS cast_payload -> RETURN MIRLoweringLowerableStmt{ DestructuringAssignment: COPY cast_payload };,
    Locatable.BindExpr AS cast_payload -> RETURN MIRLoweringLowerableStmt{ BindExpr: COPY cast_payload };,
    Locatable.BinaryOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ BinaryOp: COPY cast_payload };,
    Locatable.IsA AS cast_payload -> RETURN MIRLoweringLowerableStmt{ IsA: COPY cast_payload };,
    Locatable.CallSiteOverride AS cast_payload -> RETURN MIRLoweringLowerableStmt{ CallSiteOverride: COPY cast_payload };,
    Locatable.Identifier AS cast_payload -> RETURN MIRLoweringLowerableStmt{ Identifier: COPY cast_payload };,
    Locatable.Literal AS cast_payload -> RETURN MIRLoweringLowerableStmt{ Literal: COPY cast_payload };,
    Locatable.ListLit AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ListLit: COPY cast_payload };,
    Locatable.TupleLit AS cast_payload -> RETURN MIRLoweringLowerableStmt{ TupleLit: COPY cast_payload };,
    Locatable.DefaultArrayLit AS cast_payload -> RETURN MIRLoweringLowerableStmt{ DefaultArrayLit: COPY cast_payload };,
    Locatable.HashLit AS cast_payload -> RETURN MIRLoweringLowerableStmt{ HashLit: COPY cast_payload };,
    Locatable.DefaultLit AS cast_payload -> RETURN MIRLoweringLowerableStmt{ DefaultLit: COPY cast_payload };,
    Locatable.StructLit AS cast_payload -> RETURN MIRLoweringLowerableStmt{ StructLit: COPY cast_payload };,
    Locatable.LambdaLit AS cast_payload -> RETURN MIRLoweringLowerableStmt{ LambdaLit: COPY cast_payload };,
    Locatable.IfStatement AS cast_payload -> RETURN MIRLoweringLowerableStmt{ IfStatement: COPY cast_payload };,
    Locatable.IfBind AS cast_payload -> RETURN MIRLoweringLowerableStmt{ IfBind: COPY cast_payload };,
    Locatable.WhileLoop AS cast_payload -> RETURN MIRLoweringLowerableStmt{ WhileLoop: COPY cast_payload };,
    Locatable.WhileBindLoop AS cast_payload -> RETURN MIRLoweringLowerableStmt{ WhileBindLoop: COPY cast_payload };,
    Locatable.BreakNode AS cast_payload -> RETURN MIRLoweringLowerableStmt{ BreakNode: COPY cast_payload };,
    Locatable.ContinueNode AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ContinueNode: COPY cast_payload };,
    Locatable.FuncCall AS cast_payload -> RETURN MIRLoweringLowerableStmt{ FuncCall: COPY cast_payload };,
    Locatable.GetField AS cast_payload -> RETURN MIRLoweringLowerableStmt{ GetField: COPY cast_payload };,
    Locatable.GetIndex AS cast_payload -> RETURN MIRLoweringLowerableStmt{ GetIndex: COPY cast_payload };,
    Locatable.ReturnNode AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ReturnNode: COPY cast_payload };,
    Locatable.Assert AS cast_payload -> RETURN MIRLoweringLowerableStmt{ Assert: COPY cast_payload };,
    Locatable.ThrowNode AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ThrowNode: COPY cast_payload };,
    Locatable.DieNode AS cast_payload -> RETURN MIRLoweringLowerableStmt{ DieNode: COPY cast_payload };,
    Locatable.Slice AS cast_payload -> RETURN MIRLoweringLowerableStmt{ Slice: COPY cast_payload };,
    Locatable.Require AS cast_payload -> RETURN MIRLoweringLowerableStmt{ Require: COPY cast_payload };,
    Locatable.WithBlock AS cast_payload -> RETURN MIRLoweringLowerableStmt{ WithBlock: COPY cast_payload };,
    Locatable.SyncPolicyDecl AS cast_payload -> RETURN MIRLoweringLowerableStmt{ SyncPolicyDecl: COPY cast_payload };,
    Locatable.SelectOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ SelectOp: COPY cast_payload };,
    Locatable.WhereOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ WhereOp: COPY cast_payload };,
    Locatable.IndexOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ IndexOp: COPY cast_payload };,
    Locatable.ReduceOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ReduceOp: COPY cast_payload };,
    Locatable.OrderByOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ OrderByOp: COPY cast_payload };,
    Locatable.LimitOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ LimitOp: COPY cast_payload };,
    Locatable.UnnestOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ UnnestOp: COPY cast_payload };,
    Locatable.DistinctOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ DistinctOp: COPY cast_payload };,
    Locatable.EachOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ EachOp: COPY cast_payload };,
    Locatable.TapOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ TapOp: COPY cast_payload };,
    Locatable.SkipOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ SkipOp: COPY cast_payload };,
    Locatable.CollectOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ CollectOp: COPY cast_payload };,
