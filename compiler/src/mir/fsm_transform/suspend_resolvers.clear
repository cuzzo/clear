FN castTypeToTypeConstructionInput__suspend_resolvers(value: Type) RETURNS TypeConstructionInput ->
  RETURN TypeConstructionInput{ Type: COPY value };
END
FN ruby_array_concat_Any__suspend_resolvers(left: []Any, right: []Any) RETURNS []Any ->
  MUTABLE result: []Any = [];
  FOR rtoc_left_item IN left DO
    &result.append(COPY rtoc_left_item);
  END
  FOR rtoc_right_item IN right DO
    &result.append(COPY rtoc_right_item);
  END
  RETURN result;
END
