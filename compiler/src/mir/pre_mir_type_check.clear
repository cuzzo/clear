    WalkNode.OrElseBreak AS v -> RETURN rtocChildrenOfWalkNodeOrElseBreak(v);,
    WalkNode.CatchBlock AS v -> RETURN rtocChildrenOfWalkNodeCatchBlock(v);,
    WalkNode.RecoverOp AS v -> RETURN rtocChildrenOfWalkNodeRecoverOp(v);,
    WalkNode.StringConcat AS v -> RETURN rtocChildrenOfWalkNodeStringConcat(v);,
    WalkNode.CapabilityWrap AS v -> RETURN rtocChildrenOfWalkNodeCapabilityWrap(v);,
    WalkNode.MoveNode AS v -> RETURN rtocChildrenOfWalkNodeMoveNode(v);,
    WalkNode.CopyNode AS v -> RETURN rtocChildrenOfWalkNodeCopyNode(v);,
    WalkNode.KeepNode AS v -> RETURN rtocChildrenOfWalkNodeKeepNode(v);,
    WalkNode.ShareNode AS v -> RETURN rtocChildrenOfWalkNodeShareNode(v);,
    WalkNode.LinkNode AS v -> RETURN rtocChildrenOfWalkNodeLinkNode(v);,
    WalkNode.ResolveNode AS v -> RETURN rtocChildrenOfWalkNodeResolveNode(v);,
    WalkNode.FreezeNode AS v -> RETURN rtocChildrenOfWalkNodeFreezeNode(v);,
