# Ruby asks `respond_to?(:token)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN walkNode__token(value: WalkNode) RETURNS ?Token ->
  PARTIAL MATCH value START
    WalkNode.RequireNode AS item -> RETURN COPY item.token;,
    WalkNode.ProtocolRequirement AS item -> RETURN COPY item.token;,
    WalkNode.ProtocolDef AS item -> RETURN COPY item.token;,
    WalkNode.FunctionDefMultiowned AS item -> RETURN COPY item.token;,
