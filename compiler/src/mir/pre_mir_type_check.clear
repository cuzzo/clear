    WalkNode.ThenChain AS v -> RETURN rtocChildrenOfWalkNodeThenChain(v);,
    WalkNode.BgStreamBlock AS v -> RETURN rtocChildrenOfWalkNodeBgStreamBlock(v);,
    WalkNode.YieldExpr AS v -> RETURN rtocChildrenOfWalkNodeYieldExpr(v);,
    WalkNode.CloseStream AS v -> RETURN rtocChildrenOfWalkNodeCloseStream(v);,
    WalkNode.NextExpr AS v -> RETURN rtocChildrenOfWalkNodeNextExpr(v);,
    WalkNode.MatchStatement AS v -> RETURN rtocChildrenOfWalkNodeMatchStatement(v);,
    WalkNode.ForRange AS v -> RETURN rtocChildrenOfWalkNodeForRange(v);,
    WalkNode.ForEach AS v -> RETURN rtocChildrenOfWalkNodeForEach(v);,
    WalkNode.TestBlock AS v -> RETURN rtocChildrenOfWalkNodeTestBlock(v);,
    WalkNode.WhenBlock AS v -> RETURN rtocChildrenOfWalkNodeWhenBlock(v);,
    WalkNode.LetBinding AS v -> RETURN rtocChildrenOfWalkNodeLetBinding(v);,
    WalkNode.TestThat AS v -> RETURN rtocChildrenOfWalkNodeTestThat(v);,
    WalkNode.AssertRaisesMultiowned AS v -> RETURN rtocChildrenOfWalkNodeAssertRaisesMultiowned(v);,
    WalkNode.BenchmarkStmtMultiowned AS v -> RETURN rtocChildrenOfWalkNodeBenchmarkStmtMultiowned(v);,
    WalkNode.SmashStmtMultiowned AS v -> RETURN rtocChildrenOfWalkNodeSmashStmtMultiowned(v);,
    WalkNode.ProfileStmtMultiowned AS v -> RETURN rtocChildrenOfWalkNodeProfileStmtMultiowned(v);,
    WalkNode.StubDecl AS v -> RETURN rtocChildrenOfWalkNodeStubDecl(v);,
    WalkNode.Drop AS v -> RETURN rtocChildrenOfWalkNodeDrop(v);,
    WalkNode.SuppressCleanup AS v -> RETURN rtocChildrenOfWalkNodeSuppressCleanup(v);,
    WalkNode.Return AS v -> RETURN rtocChildrenOfWalkNodeReturn(v);,
    WalkNode.ReassignCleanup AS v -> RETURN rtocChildrenOfWalkNodeReassignCleanup(v);,
    WalkNode.FieldCleanup AS v -> RETURN rtocChildrenOfWalkNodeFieldCleanup(v);,
    WalkNode.TokenMultiowned AS v -> RETURN rtocChildrenOfWalkNodeTokenMultiowned(v);,
    WalkNode.FunctionDef AS v -> RETURN rtocChildrenOfWalkNodeFunctionDef(v);,
    WalkNode.SelectOp AS v -> RETURN rtocChildrenOfWalkNodeSelectOp(v);,
    WalkNode.WhereOp AS v -> RETURN rtocChildrenOfWalkNodeWhereOp(v);,
    WalkNode.IndexOp AS v -> RETURN rtocChildrenOfWalkNodeIndexOp(v);,
    WalkNode.ReduceOp AS v -> RETURN rtocChildrenOfWalkNodeReduceOp(v);,
    WalkNode.OrderByOp AS v -> RETURN rtocChildrenOfWalkNodeOrderByOp(v);,
    WalkNode.UnnestOp AS v -> RETURN rtocChildrenOfWalkNodeUnnestOp(v);,
    WalkNode.DistinctOp AS v -> RETURN rtocChildrenOfWalkNodeDistinctOp(v);,
    WalkNode.TakeWhileOp AS v -> RETURN rtocChildrenOfWalkNodeTakeWhileOp(v);,
    WalkNode.WindowOp AS v -> RETURN rtocChildrenOfWalkNodeWindowOp(v);,
    WalkNode.BatchWindowOp AS v -> RETURN rtocChildrenOfWalkNodeBatchWindowOp(v);,
    WalkNode.FindOp AS v -> RETURN rtocChildrenOfWalkNodeFindOp(v);,
    WalkNode.AnyOp AS v -> RETURN rtocChildrenOfWalkNodeAnyOp(v);,
    WalkNode.AllOp AS v -> RETURN rtocChildrenOfWalkNodeAllOp(v);,
    WalkNode.CountOp AS v -> RETURN rtocChildrenOfWalkNodeCountOp(v);,
    WalkNode.SumOp AS v -> RETURN rtocChildrenOfWalkNodeSumOp(v);,
    WalkNode.AverageOp AS v -> RETURN rtocChildrenOfWalkNodeAverageOp(v);,
    WalkNode.MinOp AS v -> RETURN rtocChildrenOfWalkNodeMinOp(v);,
    WalkNode.MaxOp AS v -> RETURN rtocChildrenOfWalkNodeMaxOp(v);,
    WalkNode.AssertRaises AS v -> RETURN rtocChildrenOfWalkNodeAssertRaises(v);,
