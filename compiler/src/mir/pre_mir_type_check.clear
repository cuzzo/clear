    WalkNode.TakeWhileOpMultiowned AS v -> RETURN rtocChildrenOfWalkNodeTakeWhileOpMultiowned(v);,
    WalkNode.WindowOpMultiowned AS v -> RETURN rtocChildrenOfWalkNodeWindowOpMultiowned(v);,
    WalkNode.BatchWindowOpMultiowned AS v -> RETURN rtocChildrenOfWalkNodeBatchWindowOpMultiowned(v);,
    WalkNode.JoinOp AS v -> RETURN rtocChildrenOfWalkNodeJoinOp(v);,
    WalkNode.FindOpMultiowned AS v -> RETURN rtocChildrenOfWalkNodeFindOpMultiowned(v);,
