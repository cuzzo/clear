FN rtocChildrenOfWalkNodeFunctionDef(v: FunctionDef) RETURNS []WalkNode ->
  MUTABLE out: []WalkNode = [];
  &out.append(WalkNode{ TokenMultiowned: COPY v.token });
  &out.append(WalkNode{ ArrayValue: COPY v.name });
  &out.append(WalkNode{ ArrayValue: COPY v.captures });
  IF v.return_type EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ TypeMultiowned: COPY rtoc_opt_child });
  END
  &out.append(WalkNode{ ArrayValue: COPY v.return_lifetime });
  FOR rtoc_arr_child IN v.body DO
    &out.append(castLocatableToWalkNode(COPY rtoc_arr_child));
  END
  &out.append(WalkNode{ ArrayValue: COPY v.catch_clauses });
  &out.append(WalkNode{ ArrayValue: COPY v.default_catch });
