FN rtocChildrenOfWalkNodeWindowOpMultiowned(v: WindowOp@multiowned) RETURNS []WalkNode ->
  MUTABLE out: []WalkNode = [];
  &out.append(WalkNode{ TokenMultiowned: COPY v.token });
  &out.append(WalkNode{ ArrayValue: COPY v.size });
  &out.append(WalkNode{ ArrayValue: COPY v.expression });
  IF v.can_fail EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.coerced_type_object EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ TypeMultiowned: COPY rtoc_opt_child });
  END
  IF v.collection_return EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ TypeMultiowned: COPY rtoc_opt_child });
  END
  IF v.container_borrow EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.error_kind EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ SymbolValue: COPY rtoc_opt_child });
  END
  IF v.error_type EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ SymbolValue: COPY rtoc_opt_child });
  END
  IF v.implicit_layout_cost EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.layout_transport EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ SymbolValue: COPY rtoc_opt_child });
  END
  IF v.mutates_receiver EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.needs_heap_create EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.needs_mut_ref EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.stdlib_allocates EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.storage_override EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ SymbolValue: COPY rtoc_opt_child });
  END
  IF v.symbol EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ SymbolEntryMultiowned: COPY rtoc_opt_child });
  END
  IF v.type_object EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ TypeMultiowned: COPY rtoc_opt_child });
  END
  IF v.var_mutated EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.var_used EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.was_moved EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.zig_pattern EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ SymbolValue: COPY rtoc_opt_child });
  END
  RETURN out;
END
FN rtocChildrenOfWalkNodeWithBlock(v: WithBlock) RETURNS []WalkNode ->
  MUTABLE out: []WalkNode = [];
  &out.append(WalkNode{ TokenMultiowned: COPY v.token });
  FOR rtoc_arr_child IN v.body DO
    &out.append(castLocatableToWalkNode(COPY rtoc_arr_child));
  END
  &out.append(WalkNode{ ArrayValue: COPY v.deferred_drops });
  IF v.can_fail EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.coerced_type_object EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ TypeMultiowned: COPY rtoc_opt_child });
  END
  IF v.collection_return EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ TypeMultiowned: COPY rtoc_opt_child });
  END
  IF v.container_borrow EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.error_kind EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ SymbolValue: COPY rtoc_opt_child });
  END
  IF v.error_type EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ SymbolValue: COPY rtoc_opt_child });
  END
  IF v.implicit_layout_cost EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.layout_transport EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ SymbolValue: COPY rtoc_opt_child });
  END
  IF v.mutates_receiver EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.needs_heap_create EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.needs_mut_ref EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.stdlib_allocates EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.storage_override EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ SymbolValue: COPY rtoc_opt_child });
  END
  IF v.symbol EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ SymbolEntryMultiowned: COPY rtoc_opt_child });
  END
  IF v.type_object EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ TypeMultiowned: COPY rtoc_opt_child });
  END
  IF v.var_mutated EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.var_used EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.was_moved EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.zig_pattern EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ SymbolValue: COPY rtoc_opt_child });
  END
  &out.append(WalkNode{ ArrayValue: COPY v.lock_error_clause });
  &out.append(WalkNode{ ArrayValue: COPY v.deadlock_escape });
  &out.append(WalkNode{ ArrayValue: COPY v.view_kind });
  &out.append(WalkNode{ ArrayValue: COPY v.snapshot_mode });
  &out.append(WalkNode{ ArrayValue: COPY v.polymorphic });
  &out.append(WalkNode{ ArrayValue: COPY v.universal_poly });
  RETURN out;
END
