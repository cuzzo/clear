ringValue: String, Float64Value: Float64, BoolValue: Bool, TypeMultiowned: Type@multiowned, ArrayValue2: [Set]Any@multiowned, FunctionDef: FunctionDef, SelectOp: SelectOp, WhereOp: WhereOp, IndexOp: IndexOp, ReduceOp: ReduceOp, OrderByOp: OrderByOp, UnnestOp: UnnestOp, DistinctOp: DistinctOp, TakeWhileOp: TakeWhileOp, WindowOp: WindowOp, BatchWindowOp: BatchWindowOp, FindOp: FindOp, AnyOp: AnyOp, AllOp: AllOp, CountOp: CountOp, SumOp: SumOp, AverageOp: AverageOp, MinOp: MinOp, MaxOp: MaxOp, AssertRaises: AssertRaises, BenchmarkStmt: BenchmarkStmt, SmashStmt: SmashStmt, ProfileStmt: ProfileStmt, Token: Token, Type: Type }
PUB FN preMirTypeCheck__verify_mut(program: Program) RETURNS !Void ->
  TRY (mIRPassState__class_require_mut(PassStateProgram{ Program: COPY program }, :hoisted, {:consumer: "PreMirTypeCheck"}));
  MUTABLE violations = List[];
  preMirTypeCheck__walk(program, &violations, {});
  IF (violations.length() == 0) THEN
    MUTABLE rtoc_mutable_receiver_1 = (mIRPassState__for_mut(MIRPassStateProgram{ Emittable: COPY CAST(program AS Emittable) }));
    TRY (mIRPassState__mark_mut(&rtoc_mutable_receiver_1, :premir_type_checked));
    RETURN;
  END
  MUTABLE sample = (violations.first(30) |> SELECT "  - ${_[:cls]} @ ${_[:loc]}").join("\n");
  MUTABLE more: String = "";
  IF (violations.length() > 30) THEN
    more = "\n  ... (+${(violations.length() - 30)} more)";
  ELSE
    more = "";
  END
  RAISE Input, InternalTypeResolutionError, "      Internal Compiler Error: {} AST node(s) reached MIR\n      lowering without a resolved type (full_type is the :Untyped\n      sentinel). Every evaluatable node must be typed (Void for\n      statements / void expressions) by the end of annotation.\n\n      This is a bug in the CLEAR compiler, not an error in your\n      program. Sorry for the inconvenience -- please report it.\n\n{}{}\n";
END
PRIVATE FN preMirTypeCheck__walk(node: ?WalkNode, MUTABLE violations: []{String@symbol}String, MUTABLE seen: {Int64}Bool) RETURNS Void EFFECTS REENTRANT ->
  IF node EXISTS AS node_value THEN
    MUTABLE node_value_mutable = COPY node_value;
    IF (node_value_mutable IS_A String@symbol OR node_value_mutable IS_A String OR node_value_mutable IS_A Float64 OR node_value_mutable IS_A Bool OR node_value_mutable IS_A Bool OR node_value_mutable IS_A Void OR node_value_mutable IS_A Token OR node_value_mutable IS_A SymbolEntry OR node_value_mutable IS_A Scope OR node_value_mutable IS_A EnumSchema OR node_value_mutable IS_A InlineStructVariant OR node_value_mutable IS_A ResourceSchema OR node_value_mutable IS_A StructSchema OR node_value_mutable IS_A UnionSchema OR node_value_mutable IS_A [Set]Any) THEN
      RETURN;
    ELSE
      IF TRUE THEN
      IF node_value_mutable IS_A Type AS type THEN
        RETURN;
      END
      END
      MUTABLE oid = node_value_mutable.object_id();
      IF seen[oid] THEN
        RETURN;
      END
      seen[oid] = TRUE;
      IF (IF node_value_mutable IS_A Locatable AS locatable THEN type__untyped?(locatable.full_type()) ELSE FALSE END) THEN
        MUTABLE tok: ?Token = walkNode__token(node_value_mutable);
        MUTABLE loc: String = "";
        IF (TRUE AND respondsTo?(tok, "line")) THEN
          loc = "${tok.line()}:${tok.column()}";
        ELSE
          loc = "?";
        END
        &violations.append(CAST({:cls: UNWRAP ((CAST(node_value_mutable.class().name() AS String)).split("::").last()), :loc: loc} AS {String@symbol}String));
      END
      IF (node_value_mutable IS_A []Node OR node_value_mutable IS_A [Set]Any) THEN
        FOR _ IN node_value_mutable DO
        preMirTypeCheck__walk(_, &violations, &seen);
        END
      ELSE_IF node_value_mutable IS_A {Any@multiowned}Any@multiowned AS hash THEN
        FOR _ IN hash.values() DO
        preMirTypeCheck__walk(_, &violations, &seen);
        END
      ELSE_IF TRUE THEN
        FOR rtoc_walk_child_2 IN rtocChildrenWalkNode(node_value_mutable) DO
  IF (((node_value_mutable IS_A FunctionDef OR node_value_mutable IS_A ExternFnDecl)) AND (member == :return_lifetime)) THEN
    CONTINUE;
  END
  preMirTypeCheck__walk(rtoc_walk_child_2, &violations, &seen);
        END
      END
    END
  ELSE
    RETURN;
  END
END
