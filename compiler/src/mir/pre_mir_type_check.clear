    LambdaBody.SmashStmt AS cast_payload -> RETURN WalkNode{ SmashStmt: COPY cast_payload };,
    LambdaBody.ProfileStmt AS cast_payload -> RETURN WalkNode{ ProfileStmt: COPY cast_payload };,
    LambdaBody.StubDecl AS cast_payload -> RETURN WalkNode{ StubDecl: COPY cast_payload };,
