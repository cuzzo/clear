    &out.append(WalkNode{ TypeMultiowned: COPY rtoc_opt_child });
  END
  IF v.var_mutated EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.var_used EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.was_moved EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.zig_pattern EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ SymbolValue: COPY rtoc_opt_child });
  END
  &out.append(WalkNode{ ArrayValue: COPY v.before_each });
  &out.append(WalkNode{ ArrayValue: COPY v.after_each });
  &out.append(WalkNode{ ArrayValue: COPY v.before_all });
  &out.append(WalkNode{ ArrayValue: COPY v.after_all });
  &out.append(WalkNode{ ArrayValue: COPY v.lets });
  RETURN out;
END
