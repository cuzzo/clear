    LambdaBody.ArrayValue AS cast_payload -> RETURN WalkNode{ ArrayValue: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to WalkNode");
  END
  panic("Invalid cast to WalkNode");
END
