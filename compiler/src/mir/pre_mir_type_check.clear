FN castAssignmentNameToWalkNode(value: AssignmentName) RETURNS WalkNode ->
  PARTIAL MATCH value START
    AssignmentName.StringValue AS cast_payload -> RETURN WalkNode{ StringValue: COPY cast_payload };,
    AssignmentName.Identifier AS cast_payload -> RETURN WalkNode{ Identifier: COPY cast_payload };,
    AssignmentName.GetField AS cast_payload -> RETURN WalkNode{ GetField: COPY cast_payload };,
    AssignmentName.GetIndex AS cast_payload -> RETURN WalkNode{ GetIndex: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to WalkNode");
  END
  panic("Invalid cast to WalkNode");
END
