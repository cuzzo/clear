FN rtocChildrenOfWalkNodeToken(v: Token) RETURNS []WalkNode ->
  MUTABLE out: []WalkNode = [];
  &out.append(WalkNode{ SymbolValue: COPY v.type });
  IF v.value EXISTS AS rtoc_opt_child THEN
    &out.append(castTokenValueToWalkNode(COPY rtoc_opt_child));
  END
  IF v.file EXISTS AS rtoc_opt_child THEN
    &out.append(WalkNode{ SymbolValue: COPY rtoc_opt_child });
  END
  RETURN out;
END
