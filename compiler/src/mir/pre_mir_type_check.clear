FN rtocChildrenOfWalkNodeIfStatement(v: IfStatement) RETURNS []WalkNode ->
  MUTABLE out: []WalkNode = [];
  &out.append(WalkNode{ TokenMultiowned: COPY v.token });
  &out.append(castLocatableToWalkNode(COPY v.condition));
  FOR rtoc_arr_child IN v.then_branch DO
    &out.append(castLocatableToWalkNode(COPY rtoc_arr_child));
  END
  IF v.else_branch EXISTS AS rtoc_opt_child THEN
    FOR rtoc_arr_child IN rtoc_opt_child DO
      &out.append(castLocatableToWalkNode(COPY rtoc_arr_child));
    END
  END
  &out.append(WalkNode{ ArrayValue: COPY v.then_drops });
  &out.append(WalkNode{ ArrayValue: COPY v.else_drops });
  &out.append(WalkNode{ BoolValue: COPY v.comptime });
  IF v.can_fail EXISTS AS rtoc_opt_child THEN
