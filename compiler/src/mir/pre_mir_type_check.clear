    LambdaBody.WhenBlock AS cast_payload -> RETURN WalkNode{ WhenBlock: COPY cast_payload };,
    LambdaBody.LetBinding AS cast_payload -> RETURN WalkNode{ LetBinding: COPY cast_payload };,
    LambdaBody.TestThat AS cast_payload -> RETURN WalkNode{ TestThat: COPY cast_payload };,
