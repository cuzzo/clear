FN rtocChildrenWalkNode(node: WalkNode) RETURNS []WalkNode ->
  PARTIAL MATCH node START
    WalkNode.RequireNode AS v -> RETURN rtocChildrenOfWalkNodeRequireNode(v);,
    WalkNode.ProtocolRequirement AS v -> RETURN rtocChildrenOfWalkNodeProtocolRequirement(v);,
    WalkNode.ProtocolDef AS v -> RETURN rtocChildrenOfWalkNodeProtocolDef(v);,
    WalkNode.FunctionDefMultiowned AS v -> RETURN rtocChildrenOfWalkNodeFunctionDefMultiowned(v);,
    WalkNode.ImplementationDef AS v -> RETURN rtocChildrenOfWalkNodeImplementationDef(v);,
    WalkNode.ConformanceDef AS v -> RETURN rtocChildrenOfWalkNodeConformanceDef(v);,
    WalkNode.VarDecl AS v -> RETURN rtocChildrenOfWalkNodeVarDecl(v);,
    WalkNode.Assignment AS v -> RETURN rtocChildrenOfWalkNodeAssignment(v);,
    WalkNode.DestructuringAssignment AS v -> RETURN rtocChildrenOfWalkNodeDestructuringAssignment(v);,
    WalkNode.BindExpr AS v -> RETURN rtocChildrenOfWalkNodeBindExpr(v);,
    WalkNode.BinaryOp AS v -> RETURN rtocChildrenOfWalkNodeBinaryOp(v);,
    WalkNode.IsA AS v -> RETURN rtocChildrenOfWalkNodeIsA(v);,
    WalkNode.CallSiteOverride AS v -> RETURN rtocChildrenOfWalkNodeCallSiteOverride(v);,
    WalkNode.Identifier AS v -> RETURN rtocChildrenOfWalkNodeIdentifier(v);,
    WalkNode.Literal AS v -> RETURN rtocChildrenOfWalkNodeLiteral(v);,
    WalkNode.ListLit AS v -> RETURN rtocChildrenOfWalkNodeListLit(v);,
    WalkNode.TupleLit AS v -> RETURN rtocChildrenOfWalkNodeTupleLit(v);,
    WalkNode.DefaultArrayLit AS v -> RETURN rtocChildrenOfWalkNodeDefaultArrayLit(v);,
    WalkNode.HashLit AS v -> RETURN rtocChildrenOfWalkNodeHashLit(v);,
    WalkNode.DefaultLit AS v -> RETURN rtocChildrenOfWalkNodeDefaultLit(v);,
    WalkNode.StructLit AS v -> RETURN rtocChildrenOfWalkNodeStructLit(v);,
    WalkNode.LambdaLit AS v -> RETURN rtocChildrenOfWalkNodeLambdaLit(v);,
    WalkNode.IfStatement AS v -> RETURN rtocChildrenOfWalkNodeIfStatement(v);,
    WalkNode.IfBind AS v -> RETURN rtocChildrenOfWalkNodeIfBind(v);,
    WalkNode.WhileLoop AS v -> RETURN rtocChildrenOfWalkNodeWhileLoop(v);,
    WalkNode.WhileBindLoop AS v -> RETURN rtocChildrenOfWalkNodeWhileBindLoop(v);,
    WalkNode.BreakNode AS v -> RETURN rtocChildrenOfWalkNodeBreakNode(v);,
    WalkNode.ContinueNode AS v -> RETURN rtocChildrenOfWalkNodeContinueNode(v);,
    WalkNode.FuncCall AS v -> RETURN rtocChildrenOfWalkNodeFuncCall(v);,
    WalkNode.GetField AS v -> RETURN rtocChildrenOfWalkNodeGetField(v);,
    WalkNode.GetIndex AS v -> RETURN rtocChildrenOfWalkNodeGetIndex(v);,
    WalkNode.ReturnNode AS v -> RETURN rtocChildrenOfWalkNodeReturnNode(v);,
    WalkNode.Assert AS v -> RETURN rtocChildrenOfWalkNodeAssert(v);,
    WalkNode.Raise AS v -> RETURN rtocChildrenOfWalkNodeRaise(v);,
    WalkNode.ThrowNode AS v -> RETURN rtocChildrenOfWalkNodeThrowNode(v);,
    WalkNode.DieNode AS v -> RETURN rtocChildrenOfWalkNodeDieNode(v);,
    WalkNode.Slice AS v -> RETURN rtocChildrenOfWalkNodeSlice(v);,
    WalkNode.Require AS v -> RETURN rtocChildrenOfWalkNodeRequire(v);,
    WalkNode.WithBlock AS v -> RETURN rtocChildrenOfWalkNodeWithBlock(v);,
    WalkNode.SyncPolicyDecl AS v -> RETURN rtocChildrenOfWalkNodeSyncPolicyDecl(v);,
    WalkNode.SelectOpMultiowned AS v -> RETURN rtocChildrenOfWalkNodeSelectOpMultiowned(v);,
    WalkNode.WhereOpMultiowned AS v -> RETURN rtocChildrenOfWalkNodeWhereOpMultiowned(v);,
    WalkNode.IndexOpMultiowned AS v -> RETURN rtocChildrenOfWalkNodeIndexOpMultiowned(v);,
    WalkNode.ReduceOpMultiowned AS v -> RETURN rtocChildrenOfWalkNodeReduceOpMultiowned(v);,
    WalkNode.OrderByOpMultiowned AS v -> RETURN rtocChildrenOfWalkNodeOrderByOpMultiowned(v);,
    WalkNode.LimitOp AS v -> RETURN rtocChildrenOfWalkNodeLimitOp(v);,
    WalkNode.UnnestOpMultiowned AS v -> RETURN rtocChildrenOfWalkNodeUnnestOpMultiowned(v);,
    WalkNode.DistinctOpMultiowned AS v -> RETURN rtocChildrenOfWalkNodeDistinctOpMultiowned(v);,
    WalkNode.EachOp AS v -> RETURN rtocChildrenOfWalkNodeEachOp(v);,
    WalkNode.TapOp AS v -> RETURN rtocChildrenOfWalkNodeTapOp(v);,
    WalkNode.SkipOp AS v -> RETURN rtocChildrenOfWalkNodeSkipOp(v);,
