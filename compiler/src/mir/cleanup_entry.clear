REQUIRE "pkg:rtoc_6173742f747970652e636c656172"
REQUIRE "pkg:rtoc_73656d616e7469632f6c6966656379636c655f706c616e2e636c656172"
REQUIRE "pkg:rtoc_6d69722f706c6163656d656e742e636c656172"

# Hand-written: the Ruby CleanupEntry subclasses Hash, so ruby-to-clear emitted
# `new()` plus untyped `e[:key]` writes, neither of which exists in CLEAR. The
# recipe's field universe is closed and documented in cleanup_entry.rb, so it
# translates to a struct with typed fields.
#
# Only the fields the annotator closure reaches are declared. MIR lowering and
# the cleanup classifier carry more keys (tuple_cleanup_fields, inner, ...);
# add them as those files migrate, rather than reintroducing an untyped bag.
PUB STRUCT CleanupEntry {
  needs_cleanup: Bool,
  alloc: String@symbol,
  scope: String@symbol,
  kind: String@symbol,
  has_moved_guard: Bool,
  match_as: Bool,
  via_pointer: Bool,
  needs_release_fields: Bool,
  fixed_alloc: Bool,
  elem_needs_cleanup: Bool,
  rc_alloc: ?String@symbol,
  base_zig: ?String,
  zig_type: ?String,
  source_kind: ?String@symbol,
  sync: ?String@symbol,
  resource_close_plan: ?ResourceClosePlan,
  lifecycle_plan: ?LifecyclePlan
}

FN cleanupEntry__blank() RETURNS CleanupEntry ->
  RETURN CleanupEntry{
    needs_cleanup: FALSE, alloc: :none, scope: :function, kind: :none,
    has_moved_guard: FALSE, match_as: FALSE, via_pointer: FALSE,
    needs_release_fields: FALSE, fixed_alloc: FALSE, elem_needs_cleanup: FALSE,
    rc_alloc: NIL, base_zig: NIL, zig_type: NIL, source_kind: NIL, sync: NIL,
    resource_close_plan: NIL, lifecycle_plan: NIL
  };
END

PUB FN cleanupEntry__build(kind: String@symbol, alloc: String@symbol = :heap, has_moved_guard: Bool = TRUE, resource_close_plan: ?ResourceClosePlan = NIL, zig_type: ?String = NIL) RETURNS CleanupEntry@multiowned ->
  MUTABLE self = cleanupEntry__blank();
  self.needs_cleanup = TRUE;
  self.alloc = COPY alloc;
  self.scope = cleanupEntry__cleanup_scope_for_alloc(alloc, :function);
  self.kind = COPY kind;
  self.has_moved_guard = COPY has_moved_guard;
  self.resource_close_plan = COPY resource_close_plan;
  self.zig_type = COPY zig_type;
  RETURN self @multiowned;
END

PUB FN cleanupEntry__no_cleanup(alloc: String@symbol, scope: String@symbol) RETURNS CleanupEntry@multiowned ->
  MUTABLE self = cleanupEntry__blank();
  self.alloc = COPY alloc;
  self.scope = COPY scope;
  RETURN self @multiowned;
END

# The Ruby NONE sentinel is a frozen empty entry compared by identity; a value
# type cannot do identity, so `none?` asks the question the sentinel encodes:
# "no cleanup and no allocator".
PUB FN cleanupEntry__none() RETURNS CleanupEntry@multiowned ->
  RETURN cleanupEntry__blank() @multiowned;
END

PUB FN cleanupEntry__cleanup_scope_for_alloc(alloc: String@symbol, frame_scope: String@symbol) RETURNS String@symbol ->
  IF placement__heap?(alloc) THEN
    RETURN :heap;
  END
  RETURN COPY frame_scope;
END

PUB FN cleanupEntry__kind(self: CleanupEntry) RETURNS String@symbol ->
  RETURN COPY self.kind;
END

PUB FN cleanupEntry__alloc(self: CleanupEntry) RETURNS String@symbol ->
  RETURN COPY self.alloc;
END

PUB FN cleanupEntry__scope(self: CleanupEntry) RETURNS String@symbol ->
  RETURN COPY self.scope;
END

PUB FN cleanupEntry__none?(self: CleanupEntry) RETURNS Bool ->
  RETURN (!(self.needs_cleanup) AND (self.alloc == :none));
END

PUB FN cleanupEntry__present?(self: CleanupEntry) RETURNS Bool ->
  RETURN !(cleanupEntry__none?(self));
END

PUB FN cleanupEntry__needs_cleanup?(self: CleanupEntry) RETURNS Bool ->
  RETURN self.needs_cleanup;
END

PUB FN cleanupEntry__has_moved_guard?(self: CleanupEntry) RETURNS Bool ->
  RETURN self.has_moved_guard;
END

PUB FN cleanupEntry__heap?(self: CleanupEntry) RETURNS Bool ->
  RETURN (self.alloc == :heap);
END

PUB FN cleanupEntry__frame?(self: CleanupEntry) RETURNS Bool ->
  RETURN (self.alloc == :frame);
END

PUB FN cleanupEntry__match_as?(self: CleanupEntry) RETURNS Bool ->
  RETURN self.match_as;
END

PUB FN cleanupEntry__via_pointer?(self: CleanupEntry) RETURNS Bool ->
  RETURN self.via_pointer;
END

PRIVATE FN cleanupEntry__needs_release_fields?(self: CleanupEntry) RETURNS Bool ->
  RETURN self.needs_release_fields;
END

PUB FN cleanupEntry__rc_release_fields_cleanup?(self: CleanupEntry) RETURNS Bool ->
  RETURN ((self.kind == :rc) AND cleanupEntry__needs_release_fields?(self));
END

PUB FN cleanupEntry__mark_moved_guard_mut(MUTABLE self: CleanupEntry) RETURNS Void ->
  self.has_moved_guard = TRUE;
END

PUB FN cleanupEntry__clear_moved_guard_mut(MUTABLE self: CleanupEntry) RETURNS Void ->
  self.has_moved_guard = FALSE;
END

PUB FN cleanupEntry__suppress_cleanup_mut(MUTABLE self: CleanupEntry) RETURNS Void ->
  self.needs_cleanup = FALSE;
  self.has_moved_guard = FALSE;
END

PUB FN cleanupEntry__set_cleanup_scope_mut(MUTABLE self: CleanupEntry, scope: String@symbol) RETURNS Void ->
  self.scope = COPY scope;
END

PUB FN cleanupEntry__set_alloc_mut(MUTABLE self: CleanupEntry, alloc: String@symbol) RETURNS Void ->
  self.scope = cleanupEntry__cleanup_scope_for_alloc(alloc, self.scope);
  self.alloc = COPY alloc;
END

PUB FN cleanupEntry__promote_to_cleanup_mut(MUTABLE self: CleanupEntry, kind: String@symbol, alloc: String@symbol, has_moved_guard: Bool) RETURNS Void ->
  self.needs_cleanup = TRUE;
  self.kind = COPY kind;
  self.alloc = COPY alloc;
  self.scope = cleanupEntry__cleanup_scope_for_alloc(alloc, :function);
  self.has_moved_guard = COPY has_moved_guard;
END

PUB FN cleanupEntry__with_alloc(self: CleanupEntry, alloc: String@symbol) RETURNS CleanupEntry@multiowned ->
  MUTABLE updated = COPY self;
  cleanupEntry__set_alloc_mut(&updated, alloc);
  RETURN updated @multiowned;
END

PUB FN cleanupEntry__with_moved_guard(self: CleanupEntry) RETURNS CleanupEntry@multiowned ->
  MUTABLE updated = COPY self;
  cleanupEntry__mark_moved_guard_mut(&updated);
  RETURN updated @multiowned;
END

PUB FN cleanupEntry__rc_alloc(self: CleanupEntry) RETURNS ?String@symbol ->
  RETURN COPY self.rc_alloc;
END

PUB FN cleanupEntry__base_zig(self: CleanupEntry) RETURNS ?String ->
  RETURN COPY self.base_zig;
END

PUB FN cleanupEntry__resource_close_plan(self: CleanupEntry) RETURNS ?ResourceClosePlan ->
  RETURN COPY self.resource_close_plan;
END

PUB FN cleanupEntry__lifecycle_plan(self: CleanupEntry) RETURNS ?LifecyclePlan ->
  RETURN COPY self.lifecycle_plan;
END

PUB FN cleanupEntry__set_lifecycle_plan_mut(MUTABLE self: CleanupEntry, plan: LifecyclePlan) RETURNS Void ->
  self.lifecycle_plan = COPY plan;
END
