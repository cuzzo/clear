  e[_] = v;
  };
  RETURN e;
END
FN cleanupEntry__cleanup_scope_for_alloc(alloc: String@symbol, frame_scope: String@symbol) RETURNS String@symbol ->
  IF placement__heap?(alloc) THEN
    RETURN :heap;
  ELSE
    RETURN frame_scope;
  END
END
