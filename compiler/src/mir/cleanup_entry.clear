FN cleanupEntry__build(kind: String@symbol, alloc: String@symbol = :heap, has_moved_guard: Bool = TRUE, extra: {String@symbol}Any = {}) RETURNS CleanupEntry@multiowned ->
  MUTABLE e = new();
  e[:needs_cleanup] = TRUE;
  e[:alloc] = COPY alloc;
  e[:scope] = cleanupEntry__cleanup_scope_for_alloc(alloc, :function);
  e[:kind] = COPY kind;
  e[:has_moved_guard] = COPY has_moved_guard;
  extra.keys() |> EACH {
  MUTABLE v: Any = (extra[_] OR_ELSE panic("missing hash key"));
  e[_] = v;
  };
  RETURN e;
END
FN cleanupEntry__no_cleanup(alloc: String@symbol, scope: String@symbol) RETURNS CleanupEntry@multiowned ->
  MUTABLE e = new();
  e[:needs_cleanup] = FALSE;
