PRIVATE FN ownershipDataflow__delete_state_entry_mut(self: OwnershipDataflow, MUTABLE state: {PlaceId}OwnerEntry, place: Place) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE resolved = ownershipDataflow__resolve_state_place(state, place);
    &state.delete(resolved);
    NIL;
}
