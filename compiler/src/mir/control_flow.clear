PRIVATE FN ownershipDataflow__exit_ownership_state(self: OwnershipDataflow) RETURNS !{PlaceId}OwnerEntry
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF rtoc_self_view.block_in[(KEEP rtoc_self_view.cfg.exit_block).id] != NIL THEN
    RETURN COPY (rtoc_self_view.block_in[(KEEP rtoc_self_view.cfg.exit_block).id])?;
    ELSE
    RETURN TRY (ownershipDataflow__empty_ownership_state(rtoc_self_view));
    END
}
END
PRIVATE FN ownershipDataflow__cleanup_decision_facts(self: OwnershipDataflow, body: []Locatable) RETURNS !CleanupDecisionFacts
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE match_takes_vars: [Set]String = Set[];
    MUTABLE loop_declared_names: [Set]String = Set[];
    MUTABLE stack: []CleanupDecisionFrame = [CleanupDecisionFrame{ body: COPY body, loop_depth: 0 }];
    WHILE !((stack.length() == 0)) DO
      MUTABLE frame = UNWRAP (&stack.pop());
      FOR _ IN frame.body DO
    IF (IF _ IS_A MatchStatement AS match_statement THEN match_statement.takes ELSE FALSE END) THEN
          MUTABLE expr = _.expr();
          IF expr IS_A Identifier THEN
            &match_takes_vars.insert(COPY CAST(expr.name() AS String));
          END
    END
    IF (frame.loop_depth.positive?() AND ((_ IS_A VarDecl OR _ IS_A BindExpr))) THEN
          MUTABLE name: ?String = localBindingAnalysis__binding_decl_name(_);
          IF name EXISTS AS name_value THEN
            &loop_declared_names.insert(name_value);
          END
    END
    MUTABLE child_depth = (frame.loop_depth + (IF aST__loop_node?(_) THEN
          1
        ELSE
          0
        END));
    FOR _ IN (TRY (aST__child_bodies(_))) DO
    &stack.append(CleanupDecisionFrame{ body: COPY _, loop_depth: child_depth });
    END
      END
    END
    RETURN CleanupDecisionFacts{ match_takes_vars: COPY match_takes_vars, loop_declared_names: COPY loop_declared_names };
}
END
PRIVATE FN ownershipDataflow__analyze(fn_node: FunctionDef, can_fail_fns: ?[Set]String = NIL, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL) RETURNS !OwnershipDataflow@multiowned ->
  MUTABLE cfg = TRY (functionCFG__build(fn_node, can_fail_fns));
  RETURN { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_14 = ownershipDataflow__new(cfg, fn_node, schema_lookup);
  TRY (ownershipDataflow__analyze_mut(&rtoc_mutable_receiver_14)) };
END
PRIVATE FN ownershipDataflow__init_entry_state(self: OwnershipDataflow) RETURNS !{PlaceId}OwnerEntry
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE state = TRY (ownershipDataflow__empty_ownership_state(rtoc_self_view));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_self_view.fn_node.params.length() DO
      IF !(rtoc_self_view.fn_node.params[rtoc_idx]?.takes) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE name = COPY (rtoc_self_view.fn_node.params[rtoc_idx]?.name);
      MUTABLE ti = COPY rtoc_self_view.fn_node.params[rtoc_idx]?.type;
      IF !(ownershipDataflow__ownership_tracked_type?(rtoc_self_view, ti, TRUE)) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE needs = TRY (type__needs_explicit_cleanup?(ti, :heap, rtoc_self_view.schema_lookup));
      ownershipDataflow__set_state_entry_mut(rtoc_self_view, &state, Place{ PlaceId: COPY ownershipDataflow__place_for_binding_node(name, rtoc_self_view.fn_node.params[rtoc_idx]?) }, OwnerEntry{ state: COPY :owned, allocator: :heap, needs_cleanup: needs });
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN state;
}
END
PRIVATE FN ownershipDataflow__join_predecessors(self: OwnershipDataflow, block: BasicBlock) RETURNS !{PlaceId}OwnerEntry
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE preds: []BasicBlock@multiowned = block.predecessors |> WHERE rtoc_self_view.block_out[_.id];
    IF (preds.length() == 0) THEN
      RETURN TRY (ownershipDataflow__empty_ownership_state(rtoc_self_view));
    END
    MUTABLE first_out = COPY UNWRAP (rtoc_self_view.block_out[(UNWRAP (preds.first())).id]);
    IF (preds.length() == 1) THEN
      RETURN first_out;
    END
    MUTABLE result = TRY (ownershipDataflow__dup_state(rtoc_self_view, first_out));
    FOR _ IN (preds |> SKIP 1) DO
    MUTABLE pred_out = COPY UNWRAP (rtoc_self_view.block_out[_.id()]);
    pred_out.keys() |> EACH {
      MUTABLE b: OwnerEntry = (pred_out[_] OR_ELSE CAST(panic("missing hash key") AS OwnerEntry));
    result[_] = ownershipDataflow__join_entry(rtoc_self_view, result[_], b);
    };
    END
    RETURN result;
}
END
PRIVATE FN ownershipDataflow__join_entry(self: OwnershipDataflow, a: ?OwnerEntry, b: ?OwnerEntry) RETURNS OwnerEntry
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF a EXISTS AS a_value THEN
      IF b EXISTS AS b_value THEN
        MUTABLE a_st = COPY a_value.state;
        MUTABLE b_st = COPY b_value.state;
        MUTABLE joined_state = ownershipDataflow__join_state(rtoc_self_view, a_st, b_st);
        IF (joined_state == a_value.state) THEN
          RETURN COPY a_value;
        END
        RETURN OwnerEntry{ state: COPY joined_state, allocator: COPY a_value.allocator, needs_cleanup: a_value.needs_cleanup };
      ELSE
        RETURN COPY a_value;
      END
    ELSE
      RETURN COPY b?;
    END
}
END
PRIVATE FN ownershipDataflow__join_state(self: OwnershipDataflow, a: String@symbol, b: String@symbol) RETURNS String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (a == :uninit) THEN
      RETURN b;
    END
    IF (b == :uninit) THEN
      RETURN a;
    END
    IF (a == b) THEN
      RETURN a;
    END
    RETURN :maybe_moved;
}
END
PRIVATE FN ownershipDataflow__apply_transfer(self: OwnershipDataflow, block: BasicBlock, state: {PlaceId}OwnerEntry) RETURNS !{PlaceId}OwnerEntry
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    FOR _ IN block.stmts DO
    TRY (ownershipDataflow__transfer_stmt(rtoc_self_view, castNodeToLocatable(_), state));
    END
    RETURN COPY state;
}
END
PRIVATE FN ownershipDataflow__mark_moved_mut(self: OwnershipDataflow, MUTABLE state: {PlaceId}OwnerEntry, place: PlaceId) RETURNS ?OwnerEntry
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE resolved = ownershipDataflow__resolve_state_place(state, place);
    MUTABLE existing: ?OwnerEntry = COPY state[resolved];
    IF existing EXISTS AS existing_value THEN
      MUTABLE existing_value_mutable = COPY existing_value;
      IF (existing_value_mutable.state == :moved) THEN
        RETURN existing_value_mutable;
      END
      MUTABLE moved_entry = OwnerEntry{ state: COPY :moved, allocator: COPY existing_value_mutable.allocator, needs_cleanup: existing_value_mutable.needs_cleanup };
      ownershipDataflow__set_state_entry_mut(rtoc_self_view, &state, resolved, moved_entry);
      RETURN moved_entry;
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN ownershipDataflow__make_owner_entry(self: OwnershipDataflow, MUTABLE node: Locatable) RETURNS ?OwnerEntry
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE ti = &node.full_type_mut("ownership dataflow owner");
    IF (respondsTo?(node, "borrow_provenance?") AND node.borrow_provenance?()) THEN
      RETURN NIL;
    END
    MUTABLE is_heap: Bool = FALSE;
    IF TRUE THEN
      is_heap = (node.heap_storage?() == TRUE);
    ELSE
      is_heap = FALSE;
    END
    IF !((TRUE AND ownershipDataflow__ownership_tracked_type?(rtoc_self_view, ti, is_heap))) THEN
      RETURN NIL;
    END
    MUTABLE allocator = IF ti THEN
      ((((ti.provenance_alloc() OR_ELSE NIL)) OR (IF is_heap THEN
      :heap
    ELSE
      :frame
    END)))
    ELSE
      :frame
    END;
    MUTABLE needs = IF ti THEN
      ((ti.needs_explicit_cleanup?(allocator, rtoc_self_view.schema_lookup) OR_ELSE FALSE))
    ELSE
      FALSE
    END;
    RETURN OwnerEntry{ state: COPY :owned, allocator: COPY allocator, needs_cleanup: needs };
}
END
PRIVATE FN ownershipDataflow__ownership_tracked_type?(self: OwnershipDataflow, ti: Type, heap_storage: Bool) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (TRY (type__string?(ti)) AND heap_storage) THEN
      RETURN TRUE;
    END
    MUTABLE is_atomic_ptr = type__atomic_ptr?(ti);
    RETURN !((((((type__primitive?(ti) OR TRY (type__string?(ti))) OR type__any?(ti)) OR type__void?(ti)) OR ((TRY (type__any_rc?(ti)) AND !(is_atomic_ptr))))));
}
END
PRIVATE FN ownershipDataflow__resource_captures(self: OwnershipDataflow, node: Locatable) RETURNS ![]String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE analysis = IF respondsTo?(node, "capture_analysis") THEN
      node.capture_analysis()
    ELSE
      NIL
    END;
    RETURN (analysis.resource_captures() OR_ELSE List[]);
}
END
PRIVATE FN ownershipDataflow__transfer_stmt(self: OwnershipDataflow, stmt: Locatable, state: {PlaceId}OwnerEntry) RETURNS !{PlaceId}OwnerEntry
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF stmt IS_A VarDecl AS var_decl THEN
      MUTABLE plan = var_decl.ownership_transport_plan;
      IF !((plan IS_A OwnershipTransportPlan AND (plan.action() != :move))) THEN
        FOR _ IN (TRY (ownershipDataflow__collect_binding_move_places(rtoc_self_view, var_decl.value, state))) DO
        ownershipDataflow__mark_moved_mut(rtoc_self_view, state, _);
        END
      END
      ownershipDataflow__update_declared_owner_mut(rtoc_self_view, state, CAST(var_decl.name AS String), Locatable{ VarDecl: COPY var_decl });
    ELSE_IF stmt IS_A BindExpr AS bind_expr THEN
      MUTABLE plan = bind_expr.ownership_transport_plan;
      IF !((plan IS_A OwnershipTransportPlan AND (plan.action() != :move))) THEN
        FOR _ IN (TRY (ownershipDataflow__collect_binding_move_places(rtoc_self_view, bind_expr.value, state))) DO
        ownershipDataflow__mark_moved_mut(rtoc_self_view, state, _);
        END
      END
      IF (bind_expr.mode == :decl) THEN
        ownershipDataflow__update_declared_owner_mut(rtoc_self_view, state, CAST(bind_expr.name AS String), Locatable{ BindExpr: COPY bind_expr });
      END
    ELSE_IF stmt IS_A Assignment AS assignment THEN
      FOR _ IN (TRY (ownershipDataflow__collect_binding_move_places(rtoc_self_view, assignment.value, state))) DO
      ownershipDataflow__mark_moved_mut(rtoc_self_view, state, _);
      END
    ELSE_IF stmt IS_A DestructuringAssignment AS destructuring_assignment THEN
      FOR _ IN (TRY (ownershipDataflow__collect_binding_move_places(rtoc_self_view, destructuring_assignment.value, state))) DO
      ownershipDataflow__mark_moved_mut(rtoc_self_view, state, _);
      END
    ELSE_IF stmt IS_A ReturnNode AS return_node THEN
      FOR _ IN (TRY (ownershipDataflow__collect_binding_move_places(rtoc_self_view, return_node.value, state))) DO
      ownershipDataflow__mark_moved_mut(rtoc_self_view, state, _);
      END
    ELSE_IF stmt IS_A MoveNode AS move_node THEN
      MUTABLE inner = move_node.value;
      IF inner IS_A Identifier THEN
        MUTABLE place = ownershipDataflow__place_for_binding_node(CAST(inner.name() AS String), inner);
        IF ownershipDataflow__state_entry(rtoc_self_view, state, place) THEN
          ownershipDataflow__mark_moved_mut(rtoc_self_view, state, place);
        END
      END
    ELSE_IF (stmt IS_A FuncCall) OR (stmt IS_A MethodCall) THEN
      FOR _ IN (TRY (ownershipDataflow__collect_explicit_move_places(rtoc_self_view, stmt, state))) DO
      ownershipDataflow__mark_moved_mut(rtoc_self_view, state, _);
      END
      FOR _ IN (TRY (ownershipDataflow__collect_bg_capture_places_in_args(rtoc_self_view, castLocatableToStmt(stmt), state))) DO
      ownershipDataflow__mark_moved_mut(rtoc_self_view, state, _);
      END
    ELSE_IF stmt IS_A WithBlock AS with_block THEN
  
    ELSE_IF (stmt IS_A DoBlock) THEN
  
    ELSE_IF (stmt IS_A BgBlock) OR (stmt IS_A BgStreamBlock) THEN
      FOR _ IN (TRY (ownershipDataflow__resource_captures(rtoc_self_view, stmt))) DO
    MUTABLE capture_place = ownershipDataflow__resolve_state_place(state, _);
    IF ownershipDataflow__state_entry(rtoc_self_view, state, capture_place) THEN
          ownershipDataflow__mark_moved_mut(rtoc_self_view, state, capture_place);
    END
      END
      FOR _ IN (TRY (ownershipDataflow__collect_bg_body_gives(rtoc_self_view, castLocatableToBgNode(stmt)))) DO
    MUTABLE give_place = ownershipDataflow__resolve_state_place(state, _);
    IF ownershipDataflow__state_entry(rtoc_self_view, state, give_place) THEN
          ownershipDataflow__mark_moved_mut(rtoc_self_view, state, give_place);
    END
      END
    ELSE
      MUTABLE header: ?ControlHeaderTransfer = ownershipDataflow__control_header_transfer(rtoc_self_view, stmt);
      IF header EXISTS AS header_value THEN
        MUTABLE condition: ?Locatable = COPY header_value.condition;
        IF condition EXISTS AS condition_value THEN
          FOR _ IN (TRY (ownershipDataflow__collect_explicit_move_places(rtoc_self_view, condition_value, state))) DO
          ownershipDataflow__mark_moved_mut(rtoc_self_view, state, _);
          END
        END
        MUTABLE loop_name: ?String = COPY header_value.loop_name;
        MUTABLE loop_binding: ?Locatable = COPY header_value.loop_binding;
        IF ((loop_name != NIL) AND (loop_binding != NIL)) THEN
          ownershipDataflow__update_declared_owner_mut(rtoc_self_view, state, loop_name, loop_binding);
        END
      ELSE
        FOR _ IN (TRY (ownershipDataflow__collect_explicit_move_places(rtoc_self_view, stmt, state))) DO
        ownershipDataflow__mark_moved_mut(rtoc_self_view, state, _);
        END
      END
    END
    RETURN COPY state;
}
END
PRIVATE FN ownershipDataflow__control_header_transfer(self: OwnershipDataflow, stmt: Locatable) RETURNS ?ControlHeaderTransfer
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF stmt IS_A IfStatement AS if_statement THEN
      RETURN ControlHeaderTransfer{ condition: COPY if_statement.condition, loop_name: NIL, loop_binding: NIL };
    END
    IF stmt IS_A WhileLoop AS while_loop THEN
      RETURN ControlHeaderTransfer{ condition: COPY while_loop.condition, loop_name: NIL, loop_binding: NIL };
    END
    IF stmt IS_A MatchStatement AS match_statement THEN
      RETURN ControlHeaderTransfer{ condition: COPY matchStatement__expr(match_statement), loop_name: NIL, loop_binding: NIL };
    END
    IF stmt IS_A ForEach AS for_each THEN
      RETURN ControlHeaderTransfer{ condition: COPY for_each.collection, loop_name: COPY CAST(for_each.var_name AS String), loop_binding: Locatable{ ForEach: COPY for_each } };
    END
    IF stmt IS_A ForRange AS for_range THEN
      RETURN ControlHeaderTransfer{ condition: NIL, loop_name: COPY CAST(for_range.var_name AS String), loop_binding: Locatable{ ForRange: COPY for_range } };
    END
    RETURN NIL;
}
END
PRIVATE FN ownershipDataflow__update_declared_owner_mut(self: OwnershipDataflow, MUTABLE state: {PlaceId}OwnerEntry, name: String, MUTABLE node: Locatable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE place = ownershipDataflow__place_for_binding_node(name, node);
    MUTABLE entry: ?OwnerEntry = ownershipDataflow__make_owner_entry(rtoc_self_view, &node);
    IF entry EXISTS AS entry_value THEN
      MUTABLE entry_value_mutable = COPY entry_value;
      ownershipDataflow__set_state_entry_mut(rtoc_self_view, &state, place, entry_value_mutable);
    ELSE
      ownershipDataflow__delete_state_entry_mut(rtoc_self_view, &state, place);
    END
    NIL;
}
END
PRIVATE FN ownershipDataflow__collect_binding_move_places(self: OwnershipDataflow, node: ?Locatable, state: {PlaceId}OwnerEntry) RETURNS ![]PlaceId
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node EXISTS AS node_value THEN
      MUTABLE step = DataflowStep{ state: COPY state, consumed: COPY Set[] };
      TRY (ownershipDataflow__collect_ownership_transfers(rtoc_self_view, node_value, step));
      RETURN step.consumed |> SELECT COPY _;
    ELSE
      RETURN CAST(( { MUTABLE rtoc_empty_list_15: []PlaceId = List[]; rtoc_empty_list_15 } ) AS []PlaceId);
    END
}
END
PRIVATE FN ownershipDataflow__collect_ownership_transfers(self: OwnershipDataflow, MUTABLE node: ?Locatable, step: DataflowStep) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node EXISTS AS node_value THEN
      MUTABLE node_value_mutable = COPY node_value;
      IF node_value_mutable IS_A Identifier AS identifier THEN
        MUTABLE identifier_mutable = COPY identifier;
        MUTABLE place = ownershipDataflow__place_for_binding_node(identifier__name(identifier_mutable), identifier_mutable);
        IF !(ownershipDataflow__state_entry(rtoc_self_view, step.state, place)) THEN
          RETURN;
        END
        IF ownershipDataflow__copy_type?(rtoc_self_view, &identifier_mutable) THEN
          RETURN;
        END
        &step.consumed.insert(COPY place);
      ELSE_IF node_value_mutable IS_A StructLit AS struct_lit THEN
        IF struct_lit.fields != NIL THEN
                FOR _ IN struct_lit.fields.values() DO
                TRY (ownershipDataflow__collect_ownership_transfers(rtoc_self_view, _, step));
                END
        END
      ELSE_IF (node_value_mutable IS_A MethodCall) THEN
        IF (node_value_mutable.object() IS_A Identifier AND ((node_value_mutable.object().token() != NIL) AND (((node_value_mutable.object().token())?).type() == :TYPE_ID))) THEN
          FOR _ IN node_value_mutable.args() DO
          TRY (ownershipDataflow__collect_ownership_transfers(rtoc_self_view, _, step));
          END
        ELSE
          TRY (ownershipDataflow__collect_explicit_in(rtoc_self_view, node_value_mutable, step));
        END
      ELSE_IF node_value_mutable IS_A ListLit AS list_lit THEN
        FOR _ IN list_lit.items DO
        TRY (ownershipDataflow__collect_ownership_transfers(rtoc_self_view, _, step));
        END
      ELSE_IF node_value_mutable IS_A GetField AS get_field THEN
        TRY (ownershipDataflow__collect_field_owner_transfer(rtoc_self_view, get_field, step));
      ELSE_IF node_value_mutable IS_A MoveNode AS move_node THEN
        MUTABLE inner = move_node.value;
        IF inner IS_A Identifier THEN
          MUTABLE place = ownershipDataflow__place_for_binding_node(CAST(inner.name() AS String), inner);
          IF ownershipDataflow__state_entry(rtoc_self_view, step.state, place) THEN
            &step.consumed.insert(COPY place);
          END
        END
      ELSE_IF node_value_mutable IS_A ShareNode AS share_node THEN
        TRY (ownershipDataflow__collect_share_transfer(rtoc_self_view, share_node, step));
      ELSE_IF node_value_mutable IS_A CopyNode AS copy_node THEN
    
      ELSE_IF node_value_mutable IS_A KeepNode AS keep_node THEN
    
      ELSE_IF node_value_mutable IS_A FreezeNode AS freeze_node THEN
    
      ELSE_IF node_value_mutable IS_A CapabilityWrap AS capability_wrap THEN
        TRY (ownershipDataflow__collect_ownership_transfers(rtoc_self_view, capability_wrap.value, step));
      ELSE_IF (node_value_mutable IS_A BgBlock) OR (node_value_mutable IS_A BgStreamBlock) THEN
        FOR _ IN (TRY (ownershipDataflow__resource_captures(rtoc_self_view, node_value_mutable))) DO
    MUTABLE capture_place = ownershipDataflow__resolve_state_place(step.state, _);
    IF ownershipDataflow__state_entry(rtoc_self_view, step.state, capture_place) THEN
            &step.consumed.insert(COPY capture_place);
    END
        END
        FOR _ IN (TRY (ownershipDataflow__collect_bg_body_gives(rtoc_self_view, castLocatableToBgNode(node_value_mutable)))) DO
    MUTABLE give_place = ownershipDataflow__resolve_state_place(step.state, _);
    IF ownershipDataflow__state_entry(rtoc_self_view, step.state, give_place) THEN
            &step.consumed.insert(COPY give_place);
    END
        END
      ELSE
        TRY (ownershipDataflow__collect_explicit_in(rtoc_self_view, node_value_mutable, step));
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN ownershipDataflow__collect_explicit_in(self: OwnershipDataflow, node: ?Locatable, step: DataflowStep) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    ownershipDataflow__walk_expr_node(rtoc_self_view, node, TRUE, %(n: Locatable) USE(step, rtoc_self_view) -> {
    IF !((IF n IS_A Identifier AS identifier THEN (identifier.was_moved != NIL) ELSE FALSE END)) THEN
        RETURN;
    END
    MUTABLE place = ownershipDataflow__place_for_binding_node(CAST(n.name() AS String), n);
    IF !(ownershipDataflow__state_entry(rtoc_self_view, step.state, place)) THEN
        RETURN;
    END
    IF ownershipDataflow__copy_type?(rtoc_self_view, castLocatableToIdentifier(n)) THEN
        RETURN;
    END
    &step.consumed.insert(COPY place);
    rubyToClearVoid()
    });
    TRY (ownershipDataflow__collect_share_transfers_in(rtoc_self_view, node, step));
}
END
PRIVATE FN ownershipDataflow__collect_field_owner_transfer(self: OwnershipDataflow, MUTABLE node: GetField, step: DataflowStep) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(ownershipDataflow__owning_field_move?(rtoc_self_view, Locatable{ GetField: COPY node })) THEN
      TRY (ownershipDataflow__collect_explicit_in(rtoc_self_view, Locatable{ GetField: COPY node }, step));
      RETURN;
    END
    MUTABLE root: ?Identifier = aST__root_identifier(Locatable{ GetField: COPY node });
    IF root EXISTS AS root_value THEN
      MUTABLE place = ownershipDataflow__place_for_binding_node(root_value.name, root_value);
      IF ownershipDataflow__state_entry(rtoc_self_view, step.state, place) THEN
        &step.consumed.insert(COPY place);
      END
      NIL;
    ELSE
      RETURN;
    END
}
END
PRIVATE FN ownershipDataflow__collect_explicit_move_places(self: OwnershipDataflow, node: ?Locatable, state: {PlaceId}OwnerEntry) RETURNS ![]PlaceId
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node EXISTS AS node_value THEN
      MUTABLE step = DataflowStep{ state: COPY state, consumed: COPY Set[] };
      TRY (ownershipDataflow__collect_explicit_in(rtoc_self_view, node_value, step));
      RETURN step.consumed |> SELECT COPY _;
    ELSE
      RETURN CAST(( { MUTABLE rtoc_empty_list_16: []PlaceId = List[]; rtoc_empty_list_16 } ) AS []PlaceId);
    END
}
END
PRIVATE FN ownershipDataflow__collect_share_transfers_in(self: OwnershipDataflow, node: ?Locatable, step: DataflowStep) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    ownershipDataflow__walk_expr_node(rtoc_self_view, node, %(n: Locatable) USE(step, rtoc_self_view) -> {
    IF n IS_A ShareNode AS share_node THEN
        TRY (ownershipDataflow__collect_share_transfer(rtoc_self_view, share_node, step));
    END
    rubyToClearVoid()
    });
}
END
PRIVATE FN ownershipDataflow__collect_share_transfer(self: OwnershipDataflow, node: ShareNode, step: DataflowStep) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE source = COPY node.value;
    IF source IS_A CopyNode THEN
      RETURN;
    END
    IF source IS_A Identifier THEN
      MUTABLE ti = TRY (type__from_node_mut(source, "share transfer"));
      IF type__shared?(ti) THEN
        RETURN;
      END
      MUTABLE place = ownershipDataflow__place_for_binding_node(CAST(source.name() AS String), source);
      IF ownershipDataflow__state_entry(rtoc_self_view, step.state, place) THEN
        &step.consumed.insert(COPY place);
      END
      RETURN;
    END
    TRY (ownershipDataflow__collect_ownership_transfers(rtoc_self_view, source, step));
}
END
PRIVATE FN ownershipDataflow__collect_bg_capture_places_in_args(self: OwnershipDataflow, stmt: Stmt, state: {PlaceId}OwnerEntry) RETURNS ![]PlaceId
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE consumed: []PlaceId = ( { MUTABLE rtoc_empty_list_17: []PlaceId = List[]; rtoc_empty_list_17 } );
    MUTABLE args = (stmt.args() OR List[]);
    FOR _ IN args DO
    ownershipDataflow__walk_expr_node(rtoc_self_view, _, %(expr: Locatable) USE(MUTABLE consumed, state, rtoc_self_view) -> {
    IF !((expr IS_A BgBlock OR expr IS_A BgStreamBlock)) THEN
        RETURN;
    END
    FOR _ IN (TRY (ownershipDataflow__resource_captures(rtoc_self_view, expr))) DO
      MUTABLE place = ownershipDataflow__resolve_state_place(state, _);
      IF state[place] THEN
          &consumed.append(place);
      END
    END
    FOR _ IN (TRY (ownershipDataflow__collect_bg_body_gives(rtoc_self_view, castLocatableToBgNode(expr)))) DO
      MUTABLE place = ownershipDataflow__resolve_state_place(state, _);
      IF state[place] THEN
          &consumed.append(place);
      END
    END
    rubyToClearVoid()
    });
    END
    RETURN consumed;
}
END
PRIVATE FN ownershipDataflow__collect_bg_body_gives(self: OwnershipDataflow, bg_node: BgNode) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (TRY (effectSet__to_a((IF bg_node.capture_analysis() != NIL THEN
      (bg_node.capture_analysis()).move_mark_names()
    ELSE
      NIL
    END))) OR List[]);
}
END
PRIVATE FN ownershipDataflow__copy_type?(self: OwnershipDataflow, MUTABLE ident: Identifier) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE ti = &ident.full_type_mut("ownership dataflow copy type");
    IF (TRY (type__string?(ti)) AND ((ident.symbol != NIL) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_18 = ((ident.symbol)?);
    symbolEntry__heap_storage?(rtoc_local_receiver_18) })) THEN
      RETURN FALSE;
    END
    MUTABLE is_atomic_ptr = type__atomic_ptr?(ti);
    RETURN (((((TRY (type__node_reference?(ti)) OR type__primitive?(ti)) OR TRY (type__string?(ti))) OR type__any?(ti)) OR type__void?(ti)) OR ((TRY (type__any_rc?(ti)) AND !(is_atomic_ptr))));
}
END
PRIVATE FN ownershipDataflow__owning_field_move?(self: OwnershipDataflow, MUTABLE node: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A GetField AS get_field THEN
      MUTABLE get_field_mutable = COPY get_field;
      IF aST__container_borrow?(Locatable{ GetField: COPY get_field_mutable }) THEN
        RETURN FALSE;
      END
      MUTABLE ti = &get_field_mutable.full_type_mut("ownership dataflow field move");
      RETURN type__indirect_type?(CAST(ti AS Type));
    ELSE
      RETURN FALSE;
    END
}
CATCH Transient, Input, System, NotFound, Permission, Canceled
  RETURN FALSE;
END
PRIVATE FN ownershipDataflow__dup_state(self: OwnershipDataflow, state: {PlaceId}OwnerEntry) RETURNS !{PlaceId}OwnerEntry
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY state;
}
END
PRIVATE FN ownershipDataflow__walk_expr_node(self: OwnershipDataflow, node: ?Locatable, skip_copy: Bool = FALSE, block: FN(Locatable) -> Void) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node EXISTS AS node_value THEN
      block(node_value);
      FOR _ IN (TRY (mIRControlFlowExpr__children(node_value, skip_copy))) DO
      ownershipDataflow__walk_expr_node(rtoc_self_view, _, skip_copy, block);
      END
      NIL;
    ELSE
      RETURN;
    END
}
END
PUB FN ownershipDataflow__new(cfg: FunctionCFG, fn_node: FunctionDef, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL) RETURNS OwnershipDataflow@multiowned ->
  MUTABLE self = OwnershipDataflow{ block_in: {}, block_out: {}, cfg: COPY cfg, fn_node: COPY fn_node, schema_lookup: COPY schema_lookup };
  ownershipDataflow__initialize(&self, cfg, fn_node, schema_lookup);
  RETURN self @multiowned;
END
PUB STRUCT UseAfterMoveChecker {
  dataflow: OwnershipDataflow,
  errors: []String,
  fn_node: FunctionDef
}

PUB FN useAfterMoveChecker__initialize(MUTABLE self: UseAfterMoveChecker, fn_node: FunctionDef, dataflow: OwnershipDataflow) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.fn_node = COPY fn_node;
    rtoc_self_view.dataflow = COPY dataflow;
    rtoc_self_view.errors = List[];
}
END
PUB FN useAfterMoveChecker__check_mut(MUTABLE self: UseAfterMoveChecker) RETURNS !UseAfterMoveChecker@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN ((KEEP rtoc_self_view.dataflow.cfg).blocks) DO
    MUTABLE state = TRY (ownershipDataflow__replay_state_for_block(rtoc_self_view.dataflow, _));
    FOR _ IN _.stmts DO
      TRY (useAfterMoveChecker__check_stmt_reads(&rtoc_self_view, castNodeToLocatable(_), state));
      TRY (ownershipDataflow__replay_transfer_stmt_mut(rtoc_self_view.dataflow, castNodeToLocatable(_), state));
    END
    END
    MUTABLE rtoc_owned_return_19: UseAfterMoveChecker@multiowned = rtoc_self_view;
    RETURN rtoc_owned_return_19;
}
END
PUB FN useAfterMoveChecker__check(fn_node: FunctionDef, can_fail_fns: ?[Set]String = NIL, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL) RETURNS ![]String ->
  MUTABLE df = TRY (ownershipDataflow__analyze(fn_node, can_fail_fns, schema_lookup));
  MUTABLE checker = useAfterMoveChecker__new(fn_node, df);
  TRY (useAfterMoveChecker__check_mut(&checker));
  RETURN COPY checker.errors;
END
PRIVATE FN useAfterMoveChecker__check_stmt_reads(MUTABLE self: UseAfterMoveChecker, stmt: Locatable, state: {PlaceId}OwnerEntry) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF stmt IS_A VarDecl AS var_decl THEN
      MUTABLE var_decl_mutable = COPY var_decl;
      TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, var_decl_mutable.value, state));
    ELSE_IF stmt IS_A BindExpr AS bind_expr THEN
      MUTABLE bind_expr_mutable = COPY bind_expr;
      TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, bind_expr_mutable.value, state));
    ELSE_IF stmt IS_A DestructuringAssignment AS destructuring_assignment THEN
      MUTABLE destructuring_assignment_mutable = COPY destructuring_assignment;
      TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, destructuring_assignment_mutable.value, state));
    ELSE_IF stmt IS_A ReturnNode AS return_node THEN
      MUTABLE return_node_mutable = COPY return_node;
      TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, return_node_mutable.value, state));
    ELSE_IF stmt IS_A Assignment AS assignment THEN
      MUTABLE assignment_mutable = COPY assignment;
      IF (assignment_mutable.name IS_A GetField OR assignment_mutable.name IS_A GetIndex) THEN
        TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, castAssignmentNameToOptionalLocatable(assignment_mutable.name), state));
      END
      TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, assignment_mutable.value, state));
    ELSE_IF stmt IS_A MoveNode AS move_node THEN
      MUTABLE move_node_mutable = COPY move_node;
      MUTABLE inner = move_node_mutable.value;
      IF !(inner IS_A Identifier) THEN
        TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, inner, state));
      END
    ELSE_IF stmt IS_A FuncCall AS func_call THEN
      MUTABLE func_call_mutable = COPY func_call;
      TRY (useAfterMoveChecker__check_call_reads(&rtoc_self_view, CallNode{ FuncCall: COPY func_call_mutable }, state));
    ELSE_IF (stmt IS_A MethodCall) THEN
      TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, stmt.object(), state));
      TRY (useAfterMoveChecker__check_call_reads(&rtoc_self_view, castLocatableToCallNode(stmt), state));
    ELSE_IF stmt IS_A IfStatement AS if_statement THEN
      MUTABLE if_statement_mutable = COPY if_statement;
      TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, if_statement_mutable.condition, state));
    ELSE_IF stmt IS_A WhileLoop AS while_loop THEN
      MUTABLE while_loop_mutable = COPY while_loop;
      TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, while_loop_mutable.condition, state));
    ELSE_IF stmt IS_A MatchStatement AS match_statement THEN
      MUTABLE match_statement_mutable = COPY match_statement;
      TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, matchStatement__expr(match_statement_mutable), state));
    ELSE_IF stmt IS_A ForEach AS for_each THEN
      MUTABLE for_each_mutable = COPY for_each;
      TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, for_each_mutable.collection, state));
    ELSE_IF (stmt IS_A BgBlock) OR (stmt IS_A BgStreamBlock) THEN
      MUTABLE captures = (IF stmt.capture_analysis() != NIL THEN
        (stmt.capture_analysis()).captures()
      ELSE
        NIL
      END);
      MUTABLE resource_captures = ( { MUTABLE rtoc_pipe_src = ((IF stmt.capture_analysis() != NIL THEN
        { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_20 = (stmt.capture_analysis());
      TRY (ownershipDataflow__resource_captures(rtoc_local_receiver_20)) }
      ELSE
        NIL
      END) OR_ELSE List[]); rtoc_pipe_src |> DISTINCT _ } );
      FOR _ IN ((captures OR {})).keys() DO
    IF resource_captures.contains?(_) THEN
      CONTINUE;
    END
    useAfterMoveChecker__check_identifier_read(&rtoc_self_view, CAST(_ AS String), state, stmt.token());
      END
    END
}
END
PRIVATE FN useAfterMoveChecker__check_call_reads(MUTABLE self: UseAfterMoveChecker, call_node: CallNode, state: {PlaceId}OwnerEntry) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_each_items_21 = ((MATCH call_node START CallNode.FuncCall AS item -> item.args, CallNode.MethodCall AS item -> item.args END));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_21.length() DO
    IF (rtoc_each_items_21[rtoc_idx] IS_A Identifier AND rtoc_each_items_21[rtoc_idx].was_moved()) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
    ELSE_IF rtoc_each_items_21[rtoc_idx] IS_A MoveNode THEN
        IF !(rtoc_each_items_21[rtoc_idx].value() IS_A Identifier) THEN
          TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, rtoc_each_items_21[rtoc_idx], state));
        END
    ELSE_IF rtoc_each_items_21[rtoc_idx] IS_A ShareNode THEN
        TRY (useAfterMoveChecker__check_share_reads(&rtoc_self_view, rtoc_each_items_21[rtoc_idx], state));
    ELSE_IF ((rtoc_each_items_21[rtoc_idx] IS_A CopyNode OR rtoc_each_items_21[rtoc_idx] IS_A KeepNode) OR rtoc_each_items_21[rtoc_idx] IS_A FreezeNode) THEN
        TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, rtoc_each_items_21[rtoc_idx].value(), state));
    ELSE
        TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, rtoc_each_items_21[rtoc_idx], state));
    END
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PRIVATE FN useAfterMoveChecker__check_reads_in_expr(MUTABLE self: UseAfterMoveChecker, node: ?Locatable, state: {PlaceId}OwnerEntry) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node EXISTS AS node_value THEN
      MUTABLE node_value_mutable = COPY node_value;
      IF node_value_mutable IS_A Identifier AS identifier THEN
        MUTABLE identifier_mutable = COPY identifier;
        useAfterMoveChecker__check_identifier_node_read(&rtoc_self_view, identifier_mutable, state);
      ELSE_IF node_value_mutable IS_A CopyNode AS copy_node THEN
        MUTABLE copy_node_mutable = COPY copy_node;
        TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, copy_node_mutable.value, state));
      ELSE_IF node_value_mutable IS_A KeepNode AS keep_node THEN
        MUTABLE keep_node_mutable = COPY keep_node;
        TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, keep_node_mutable.value, state));
      ELSE_IF node_value_mutable IS_A FreezeNode AS freeze_node THEN
        MUTABLE freeze_node_mutable = COPY freeze_node;
        TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, freeze_node_mutable.value, state));
      ELSE_IF node_value_mutable IS_A MoveNode AS move_node THEN
        MUTABLE move_node_mutable = COPY move_node;
        IF !(move_node_mutable.value IS_A Identifier) THEN
          TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, move_node_mutable.value, state));
        END
      ELSE_IF node_value_mutable IS_A ShareNode AS share_node THEN
        MUTABLE share_node_mutable = COPY share_node;
        TRY (useAfterMoveChecker__check_share_reads(&rtoc_self_view, share_node_mutable, state));
      ELSE_IF node_value_mutable IS_A BinaryOp AS binary_op THEN
        MUTABLE binary_op_mutable = COPY binary_op;
        TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, binary_op_mutable.left, state));
        TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, binary_op_mutable.right, state));
      ELSE_IF (node_value_mutable IS_A UnaryOp) THEN
        TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, node_value_mutable.right(), state));
      ELSE_IF node_value_mutable IS_A FuncCall AS func_call THEN
        MUTABLE func_call_mutable = COPY func_call;
        TRY (useAfterMoveChecker__check_call_reads(&rtoc_self_view, CallNode{ FuncCall: COPY func_call_mutable }, state));
      ELSE_IF (node_value_mutable IS_A MethodCall) THEN
        TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, node_value_mutable.object(), state));
        TRY (useAfterMoveChecker__check_call_reads(&rtoc_self_view, castLocatableToCallNode(node_value_mutable), state));
      ELSE_IF node_value_mutable IS_A GetField AS get_field THEN
        MUTABLE get_field_mutable = COPY get_field;
        TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, get_field_mutable.target, state));
      ELSE_IF node_value_mutable IS_A GetIndex AS get_index THEN
        MUTABLE get_index_mutable = COPY get_index;
        TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, get_index_mutable.target, state));
        TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, get_index_mutable.indexOf(), state));
      ELSE_IF node_value_mutable IS_A StructLit AS struct_lit THEN
        MUTABLE struct_lit_mutable = COPY struct_lit;
        IF struct_lit_mutable.fields != NIL THEN
                FOR _ IN struct_lit_mutable.fields.values() DO
                TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, _, state));
                END
        END
      ELSE_IF node_value_mutable IS_A ListLit AS list_lit THEN
        MUTABLE list_lit_mutable = COPY list_lit;
        FOR _ IN list_lit_mutable.items DO
        TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, _, state));
        END
      ELSE_IF node_value_mutable IS_A HashLit AS hash_lit THEN
        MUTABLE hash_lit_mutable = COPY hash_lit;
        hash_lit_mutable.pairs.keys() |> EACH {
    MUTABLE v: Locatable = (hash_lit_mutable.pairs[_] OR_ELSE CAST(panic("missing hash key") AS Locatable));
    TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, _, state));
    MUTABLE val = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_23: ?String = NIL;
          IF v IS_A []Any THEN
            rtoc_ternary_value_23 = v.substr(1, 1);
          ELSE
            rtoc_ternary_value_23 = v;
          END
          rtoc_ternary_value_23? };
    TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, val, state));
        };
      ELSE_IF node_value_mutable IS_A Literal AS literal THEN
    
      ELSE_IF node_value_mutable IS_A StringConcat AS string_concat THEN
        MUTABLE string_concat_mutable = COPY string_concat;
        IF string_concat_mutable.parts != NIL THEN
                FOR _ IN string_concat_mutable.parts DO
                TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, _, state));
                END
        END
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN useAfterMoveChecker__check_share_reads(MUTABLE self: UseAfterMoveChecker, node: ShareNode, state: {PlaceId}OwnerEntry) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE source = COPY node.value;
    IF source IS_A CopyNode THEN
      TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, source.value(), state));
    ELSE_IF source IS_A Identifier THEN
      MUTABLE ti = TRY (type__from_node_mut(source, "share read"));
      IF type__shared?(ti) THEN
        useAfterMoveChecker__check_identifier_node_read(&rtoc_self_view, source, state);
      END
    ELSE
      TRY (useAfterMoveChecker__check_reads_in_expr(&rtoc_self_view, source, state));
    END
}
END
PRIVATE FN useAfterMoveChecker__check_identifier_node_read(MUTABLE self: UseAfterMoveChecker, node: Identifier, state: {PlaceId}OwnerEntry) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE place = ownershipDataflow__place_for_binding_node(node.name, Node{ Identifier: COPY node });
    useAfterMoveChecker__check_identifier_read(&rtoc_self_view, node.name, state, node.token, place);
}
END
PRIVATE FN useAfterMoveChecker__check_identifier_read(MUTABLE self: UseAfterMoveChecker, name: String, state: {PlaceId}OwnerEntry, token: Token, place: ?PlaceId = NIL) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE entry: ?OwnerEntry = ownershipDataflow__lookup_state_entry(state, (place OR_ELSE name));
    IF entry EXISTS AS entry_value THEN
      MUTABLE st = entry_value.state;
      IF (st == moved) THEN
        MUTABLE loc = " (line ${token.line.toString()})";
        &rtoc_self_view.errors.append("[USE_AFTER_MOVE] ${rtoc_self_view.fn_node.name}::${name} -- used after being moved${loc}");
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN useAfterMoveChecker__walk_expr_node(self: UseAfterMoveChecker, node: ?Locatable, skip_copy: Bool = FALSE, block: FN(Locatable) -> Void) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node EXISTS AS node_value THEN
      block(node_value);
      FOR _ IN (TRY (mIRControlFlowExpr__children(node_value, skip_copy))) DO
      useAfterMoveChecker__walk_expr_node(rtoc_self_view, _, skip_copy, block);
      END
      NIL;
    ELSE
      RETURN;
    END
}
END
PUB FN useAfterMoveChecker__new(fn_node: FunctionDef, dataflow: OwnershipDataflow) RETURNS UseAfterMoveChecker@multiowned ->
  MUTABLE self = UseAfterMoveChecker{ dataflow: COPY dataflow, errors: List[], fn_node: COPY fn_node };
  useAfterMoveChecker__initialize(&self, fn_node, dataflow);
  RETURN self @multiowned;
END
# Ruby module LoopFrameAnalysis
PUB UNION LoopNode { WhileLoop: WhileLoop, WhileBindLoop: WhileBindLoop, ForRange: ForRange, ForEach: ForEach }
PUB FN loopFrameAnalysis__analyze_mut(fn_nodes: {String}FunctionDef, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL) RETURNS !{String}FunctionDef ->
  FOR _ IN fn_nodes.values() DO
  IF !(_.body) THEN
    CONTINUE;
  END
  TRY (loopFrameAnalysis__walk_stmts_mut(_.body, schema_lookup, fn_nodes));
  TRY (loopFrameAnalysis__update_shard_contexts_mut(_.body, fn_nodes));
  END
  RETURN NIL;
END
PUB FN loopFrameAnalysis__walk_stmts_mut(stmts: []Locatable, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL, fn_nodes: {String}FunctionDef) RETURNS !Void ->
  FOR _ IN stmts DO
  TRY (loopFrameAnalysis__walk_stmt_mut(castLocatableToOptionalStmt(_), schema_lookup, fn_nodes));
  END
END
PUB FN loopFrameAnalysis__walk_stmt_mut(stmt: ?Stmt, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL, fn_nodes: {String}FunctionDef) RETURNS !Void ->
  MUTABLE child_bodies = TRY (aST__child_bodies(castOptionalStmtToLocatable(stmt)));
  FOR _ IN child_bodies DO
  TRY (loopFrameAnalysis__walk_stmts_mut(_, schema_lookup, fn_nodes));
  END
  IF aST__loop_node?(castOptionalStmtToLocatable(stmt)) THEN
    TRY (loopFrameAnalysis__process_loop_mut(castOptionalStmtToLoopNode(stmt), (child_bodies.first() OR_ELSE List[]), schema_lookup, fn_nodes));
  END
  NIL;
END
PUB FN loopFrameAnalysis__process_loop_mut(MUTABLE loop_node: LoopNode, body: []Locatable, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL, fn_nodes: {String}FunctionDef) RETURNS !Void ->
  IF (MATCH loop_node START LoopNode.WhileLoop AS item -> item.tight, LoopNode.WhileBindLoop AS item -> item.tight, LoopNode.ForRange AS item -> item.tight, LoopNode.ForEach AS item -> item.tight END) THEN
    RETURN;
  END
  MUTABLE local_facts = TRY (localBindingAnalysis__direct_loop_body_facts(body));
  MUTABLE local_names = COPY local_facts.names;
  MUTABLE has_iteration_frame_locals = ((((local_facts.iteration_frame_decls |> ANY _) OR loopFrameAnalysis__loop_capture_frame_alloc?(castLoopNodeToLocatable(loop_node), schema_lookup))) OR TRY (loopFrameAnalysis__direct_loop_expression_frame_alloc?(body, fn_nodes, local_names)));
  MUTABLE has_extended_frame_locals = ((local_facts.frame_decls |> ANY {
  MUTABLE entry: ?CleanupEntry@multiowned = localBindingAnalysis__binding_entry(_);
  ((((entry != NIL) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_24 = (entry?);
  cleanupEntry__present?(rtoc_local_receiver_24) }) AND cleanupEntry__frame?(entry)) AND (cleanupEntry__scope(entry) != :iteration))
  }) OR TRY (loopFrameAnalysis__outer_frame_receiver_alloc?(body, local_names)));
  MATCH loop_node START
    LoopNode.WhileLoop AS item ->
      MUTABLE item_mutable = COPY item;
      item_mutable.mark_per_iter = (has_iteration_frame_locals AND !(has_extended_frame_locals));
      loop_node = LoopNode{ WhileLoop: item_mutable };,
    LoopNode.WhileBindLoop AS item ->
      MUTABLE item_mutable = COPY item;
      item_mutable.mark_per_iter = (has_iteration_frame_locals AND !(has_extended_frame_locals));
      loop_node = LoopNode{ WhileBindLoop: item_mutable };,
    LoopNode.ForRange AS item ->
      MUTABLE item_mutable = COPY item;
      item_mutable.mark_per_iter = (has_iteration_frame_locals AND !(has_extended_frame_locals));
      loop_node = LoopNode{ ForRange: item_mutable };,
    LoopNode.ForEach AS item ->
      MUTABLE item_mutable = COPY item;
      item_mutable.mark_per_iter = (has_iteration_frame_locals AND !(has_extended_frame_locals));
      loop_node = LoopNode{ ForEach: item_mutable };,
  END
  NIL;
END
PUB FN loopFrameAnalysis__direct_loop_expression_frame_alloc?(body: []Locatable, fn_nodes: {String}FunctionDef, local_names: [Set]String = Set[]) RETURNS !Bool ->
  MUTABLE found: Bool = FALSE;
  TRY (localBindingAnalysis__each_direct_loop_node(body, %(stmt: Locatable) USE(fn_nodes, MUTABLE found, local_names) -> {
  IF loopFrameAnalysis__direct_loop_expression_boundary?(stmt) THEN
      RETURN;
  END
  TRY (loopFrameAnalysis__each_loop_local_locatable(stmt, local_names, %(node: Locatable) USE(fn_nodes, MUTABLE found) -> {
    IF !(found) THEN
        IF loopFrameAnalysis__expression_allocates_frame_value?(&node, fn_nodes) THEN
          found = TRUE;
        END
    END
    rubyToClearVoid()
  }));
  rubyToClearVoid()
  }));
  RETURN found;
END
PUB FN loopFrameAnalysis__each_loop_local_locatable(root: Locatable, local_names: [Set]String = Set[], block: FN(Locatable) -> Void) RETURNS !Void ->
  MUTABLE stack: []Locatable = [root];
  MUTABLE seen: [Set]Int64 = Set[];
  WHILE !((stack.length() == 0)) DO
    MUTABLE node = UNWRAP (&stack.pop());
    IF !(seen.add?(aST__node_identity(node))) THEN
      CONTINUE;
    END
    block(node);
    IF (!(node.equal?(root)) AND loopFrameAnalysis__direct_loop_expression_boundary?(node)) THEN
      CONTINUE;
    END
    IF loopFrameAnalysis__outer_mutating_receiver_call?(node, local_names) THEN
      CONTINUE;
    END
    MUTABLE rtoc_reverse_items_25: []Locatable = (TRY (loopFrameAnalysis__loop_local_children(node)));
    MUTABLE rtoc_reverse_i_26 = rtoc_reverse_items_25.length() - 1;
    WHILE rtoc_reverse_i_26 >= 0 DO
  &stack.append(COPY (rtoc_reverse_items_25[rtoc_reverse_i_26])?);
  rtoc_reverse_i_26 = rtoc_reverse_i_26 - 1;
    END
  END
  NIL;
END
PUB FN loopFrameAnalysis__loop_local_children(node: Locatable) RETURNS ![]Locatable ->
  MUTABLE children: []Locatable = ( { MUTABLE rtoc_empty_list_27: []Locatable = List[]; rtoc_empty_list_27 } );
  FOR _ IN node.class().members() DO
  MUTABLE value = COPY node.substr(_, 1);
  IF (value == Array) THEN
      FOR _ IN value DO
      IF _ IS_A Locatable THEN
        &children.append(_);
      END
      END
  ELSE_IF (value == Hash) THEN
      FOR _ IN value.values() DO
      IF _ IS_A Locatable THEN
        &children.append(_);
      END
      END
  ELSE_IF (value IS_A Locatable) THEN
      &children.append(value);
  END
  END
  RETURN children;
END
PUB FN loopFrameAnalysis__direct_loop_expression_boundary?(node: Locatable) RETURNS Bool ->
  RETURN ((((aST__loop_node?(node) OR node IS_A FunctionDef) OR node IS_A LambdaLit) OR node IS_A BgBlock) OR node IS_A BgStreamBlock);
END
PUB FN loopFrameAnalysis__expression_allocates_frame_value?(MUTABLE node: Locatable, fn_nodes: {String}FunctionDef) RETURNS !Bool ->
  IF !(loopFrameAnalysis__expression_node_allocates_value?(node)) THEN
    RETURN FALSE;
  END
  IF node IS_A FuncCall AS func_call THEN
    MUTABLE fn: ?FunctionDef = COPY fn_nodes[funcCall__name(func_call)];
    IF fn?.uses_frame THEN
      RETURN TRUE;
    END
  END
  MUTABLE sig_branch_value: ?FunctionSignature@multiowned = NIL;
  IF TRUE THEN
    sig_branch_value = functionSignature__unwrap(aST__node__matched_signature(node));
  ELSE
    sig_branch_value = NIL;
  END
  MUTABLE sig: ?FunctionSignature@multiowned = sig_branch_value;
  IF ((sig != NIL) AND !(TRY (functionSignature__mutates_receiver?(&sig)))) THEN
    IF placement__frame?(TRY (functionSignature__return_alloc(&sig))) THEN
      RETURN TRUE;
    END
    IF (TRY (functionSignature__emits_allocating?(&sig)) AND placement__frame?(TRY (functionSignature__intrinsic_alloc(&sig, IntrinsicAllocationKind.Alloc)))) THEN
      RETURN TRUE;
    END
  END
  MUTABLE storage: ?String@symbol = IF respondsTo?(node, "storage") THEN
    node.storage()
  ELSE
    NIL
  END;
  IF placement__frame?(storage) THEN
    RETURN TRUE;
  END
  MUTABLE type_info = &node.full_type_mut("loop frame allocation");
  IF type_info.frame?() THEN
    RETURN TRUE;
  END
  RETURN (type_info.needs_cleanup?() AND (TRY (type__cleanup_allocator(type_info)) == :frame));
END
PUB FN loopFrameAnalysis__outer_mutating_receiver_call?(node: Locatable, local_names: [Set]String) RETURNS !Bool ->
  IF !((node IS_A MethodCall OR node IS_A FuncCall)) THEN
    RETURN FALSE;
  END
  MUTABLE sig_branch_value: ?FunctionSignature@multiowned = NIL;
  IF TRUE THEN
    sig_branch_value = functionSignature__unwrap(aST__node__matched_signature(node));
  ELSE
    sig_branch_value = NIL;
  END
  MUTABLE sig: ?FunctionSignature@multiowned = sig_branch_value;
  IF sig EXISTS AS sig_value THEN
    MUTABLE sig_value_mutable = COPY sig_value;
    IF !(TRY (functionSignature__mutates_receiver?(&sig_value_mutable))) THEN
      RETURN FALSE;
    END
    MUTABLE receiver =     IF node IS_A MethodCall THEN
      node.object()
    ELSE
      node.args().first()
    END;
    MUTABLE root = (aST__root_identifier(receiver) OR_ELSE NIL);
    IF !((IF root != NIL THEN
      root.symbol()
    ELSE
      NIL
    END)) THEN
      RETURN FALSE;
    END
    RETURN !(local_names.contains?(CAST(root.name() AS String)));
  ELSE
    RETURN FALSE;
  END
END
PUB FN loopFrameAnalysis__outer_frame_receiver_alloc?(body: []Locatable, local_names: [Set]String) RETURNS !Bool ->
  MUTABLE found: Bool = FALSE;
  TRY (localBindingAnalysis__each_direct_loop_node(body, %(node: Locatable) USE(local_names) -> {
  IF !(node IS_A MethodCall) THEN
      RETURN;
  END
  MUTABLE sig: ?FunctionSignature@multiowned = functionSignature__unwrap(aST__node__matched_signature(node));
  IF !(sig) THEN
      RETURN;
  END
  IF !((TRY (functionSignature__emits_allocating?(&sig)) AND TRY (functionSignature__mutates_receiver?(&sig)))) THEN
      RETURN;
  END
  MUTABLE root: ?Identifier = aST__root_identifier(node.object());
  IF !(root?.symbol) THEN
      RETURN;
  END
  IF local_names.contains?(root.name) THEN
      RETURN;
  END
  MUTABLE root_symbol = COPY UNWRAP (root.symbol);
  MUTABLE sym = (aST__declaration_symbol(root_symbol) OR_ELSE root_symbol);
  IF !(symbolEntry__heap_storage?(sym)) THEN
      found = TRUE;
  END
  rubyToClearVoid()
  }));
  RETURN found;
END
PUB FN loopFrameAnalysis__loop_capture_frame_alloc?(loop_node: Locatable, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL) RETURNS !Bool ->
  IF loop_node IS_A WhileBindLoop AS while_bind_loop THEN
    MUTABLE cond_t = &while_bind_loop.condition.full_type_mut("loop capture condition");
    MUTABLE inner = TRY (type__wrapped_type(cond_t));
    IF !(inner IS_A Type) THEN
      RETURN FALSE;
    END
    RETURN (inner.needs_cleanup?(schema_lookup) AND (TRY (type__cleanup_allocator(inner, schema_lookup)) == :frame));
  ELSE
    RETURN FALSE;
  END
END
PUB FN loopFrameAnalysis__walk_all_nodes(nodes: ?ControlFlowNodeInput, visited: [Set]Int64 = Set[], block: FN(Locatable) -> Void) RETURNS Void ->
  aST__each_locatable(nodes, TRUE, %(node: Locatable) USE(visited) -> {
  IF !(visited.add?(aST__node_identity(node))) THEN
      RETURN;
  END
  block(node);
  rubyToClearVoid()
  });
END
PUB FN loopFrameAnalysis__update_shard_contexts_mut(body: []Node, fn_nodes: {String}FunctionDef) RETURNS !Void ->
  loopFrameAnalysis__walk_all_nodes(ControlFlowNodeInput{ ArrayValue: COPY body }, %(node: Locatable) USE(fn_nodes) -> {
  MUTABLE dynamic_node = COPY node;
  IF !((IF node IS_A ConcurrentOp AS concurrent_op THEN dynamic_node.shard_context() ELSE FALSE END)) THEN
      RETURN;
  END
  MUTABLE ctx: PipelineShardContext = CAST(dynamic_node.shard_context() AS PipelineShardContext);
  MUTABLE key_allocates_frame = loopFrameAnalysis__key_allocates_frame?(ctx.key_expr, fn_nodes);
  MUTABLE each_body = IF (respondsTo?(node, "op") AND respondsTo?(dynamic_node.op(), "body")) THEN
      dynamic_node.op().body()
    ELSE
      NIL
    END;
  MUTABLE body_allocates_frame = IF each_body THEN
      ((TRY (localBindingAnalysis__direct_loop_body_facts(each_body))).frame_decls) |> ANY _
    ELSE
      ctx.body_allocates_frame
    END;
  TRY (mIRLowering__set_shard_context(dynamic_node, pipelineShardContext__with_frame_allocations(ctx, key_allocates_frame, body_allocates_frame)));
  rubyToClearVoid()
  });
END
PUB FN loopFrameAnalysis__key_allocates_frame?(expr: Locatable, fn_nodes: {String}FunctionDef) RETURNS !Bool ->
  MUTABLE found: Bool = FALSE;
  loopFrameAnalysis__walk_all_nodes(castLocatableToOptionalControlFlowNodeInput(expr), %(node: Locatable) USE(fn_nodes) -> {
  IF !(TRUE) THEN
      RETURN;
  END
  IF node IS_A FuncCall AS func_call THEN
      MUTABLE fn: ?FunctionDef = COPY fn_nodes[funcCall__name(func_call)];
      IF fn?.uses_frame THEN
        found = TRUE;
      END
  END
  IF !(loopFrameAnalysis__expression_node_allocates_value?(node)) THEN
      RETURN;
  END
  MUTABLE storage: ?String@symbol = IF respondsTo?(node, "storage") THEN
      node.storage()
    ELSE
      NIL
    END;
  IF (storage == :frame) THEN
      found = TRUE;
  END
  MUTABLE ti = &node.full_type_mut("SHARD frame allocation");
  IF (ti.needs_cleanup?() AND (TRY (type__cleanup_allocator(ti)) == :frame)) THEN
      found = TRUE;
  END
  rubyToClearVoid()
  });
  RETURN found;
END
PUB FN loopFrameAnalysis__expression_node_allocates_value?(node: Locatable) RETURNS Bool ->
  IF loopFrameAnalysis__statement_like_expression_container?(node) THEN
    RETURN FALSE;
  END
  IF (node IS_A Identifier OR node IS_A Literal) THEN
    RETURN FALSE;
  END
  IF (node IS_A GetField OR node IS_A GetIndex) THEN
    RETURN FALSE;
  END
  RETURN TRUE;
END
PUB FN loopFrameAnalysis__statement_like_expression_container?(node: Locatable) RETURNS Bool ->
  RETURN (((((((((((((((node IS_A VarDecl OR node IS_A BindExpr) OR node IS_A Assignment) OR node IS_A DestructuringAssignment) OR node IS_A IfStatement) OR node IS_A IfBind) OR node IS_A MatchStatement) OR node IS_A WithBlock) OR node IS_A DoBlock) OR node IS_A ReturnNode) OR node IS_A Assert) OR node IS_A Raise) OR node IS_A ThrowNode) OR node IS_A DieNode) OR node IS_A BreakNode) OR node IS_A ContinueNode);
END
