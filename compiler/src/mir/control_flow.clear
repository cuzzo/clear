PUB STRUCT BorrowChecker {
  errors: []String,
  fn_name: String,
  fn_node: FunctionDef,
  schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult
}

PUB STRUCT BorrowState {
  borrows: {String}[]String@symbol
}

PUB FN borrowState__empty() RETURNS BorrowState ->
  RETURN BorrowState{ borrows: {} };
END
PUB FN borrowState__empty?(self: BorrowState) RETURNS Bool EFFECTS REENTRANT ->
  RETURN (self.borrows.count() == 0);
END
PUB FN borrowState__kind_for(self: BorrowState, name: String) RETURNS ?String@symbol ->
  IF self.borrows[name] != NIL THEN
  RETURN ((self.borrows[name])?).last();
  ELSE
  RETURN NIL;
  END
END
PUB FN borrowState__mutable?(self: BorrowState, name: String) RETURNS Bool ->
  RETURN ((self.borrows[name] OR_ELSE List[])).contains?(:mutable);
END
PUB FN borrowState__conflicts_with?(self: BorrowState, name: String, kind: String@symbol) RETURNS Bool ->
  MUTABLE active = (self.borrows[name] OR_ELSE List[]);
  IF active.empty?() THEN
    RETURN FALSE;
  END
  RETURN ((kind == :mutable) OR borrowState__mutable?(self, name));
END
PUB FN borrowState__add(self: BorrowState, name: String, kind: String@symbol) RETURNS BorrowState ->
  MUTABLE updated = {name: (((self.borrows[name] OR_ELSE List[])) + [kind])}.keys() |> REDUCE(COPY self.borrows) { acc[_] = COPY ({name: (((self.borrows[name] OR_ELSE List[])) + [kind])}[_] OR_ELSE panic("missing hash key")); acc };
  RETURN BorrowState{ borrows: COPY updated };
END
PUB FN borrowChecker__check(fn_node: FunctionDef, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS ![]String ->
  RETURN { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_28 = borrowChecker__new(fn_node, schema_lookup);
  TRY (borrowChecker__check_mut(&rtoc_mutable_receiver_28)) };
END
PUB FN borrowChecker__initialize(MUTABLE self: BorrowChecker, fn_node: FunctionDef, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.fn_name = COPY fn_node.name;
    rtoc_self_view.fn_node = COPY fn_node;
    rtoc_self_view.schema_lookup = COPY schema_lookup;
    rtoc_self_view.errors = List[];
}
END
PUB FN borrowChecker__check_mut(MUTABLE self: BorrowChecker) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_mutable_alias_arg_29 = COPY rtoc_self_view.fn_node.body;
    TRY (borrowChecker__check_stmts(&rtoc_self_view, rtoc_mutable_alias_arg_29, borrowState__empty()));
    RETURN COPY rtoc_self_view.errors;
}
END
PRIVATE FN borrowChecker__cap_source_name(self: BorrowChecker, var_node: Locatable) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF aST__root_identifier(var_node) != NIL THEN
    RETURN COPY ((aST__root_identifier(var_node))?).name;
    ELSE
    RETURN NIL;
    END
}
END
PRIVATE FN borrowChecker__line_info(self: BorrowChecker, token: Token) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF token.line THEN
      RETURN " (line ${token.line.toString()})";
    ELSE
      RETURN "";
    END
}
END
PRIVATE FN borrowChecker__check_stmts(MUTABLE self: BorrowChecker, stmts: []Locatable, state: BorrowState) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN stmts DO
    TRY (borrowChecker__check_stmt(&rtoc_self_view, _, state));
    END
}
END
PRIVATE FN borrowChecker__check_stmt(MUTABLE self: BorrowChecker, stmt: Locatable, state: BorrowState) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF stmt IS_A WithBlock AS with_block THEN
      MUTABLE with_block_mutable = COPY with_block;
      TRY (borrowChecker__handle_with_block(&rtoc_self_view, with_block_mutable, state));
    ELSE_IF stmt IS_A VarDecl AS var_decl THEN
      MUTABLE var_decl_mutable = COPY var_decl;
      IF borrowState__empty?(state) THEN
        RETURN;
      END
      TRY (borrowChecker__check_binding_moves(&rtoc_self_view, var_decl_mutable.value, varDecl__token(var_decl_mutable), state));
    ELSE_IF stmt IS_A BindExpr AS bind_expr THEN
      MUTABLE bind_expr_mutable = COPY bind_expr;
      IF borrowState__empty?(state) THEN
        RETURN;
      END
      TRY (borrowChecker__check_binding_moves(&rtoc_self_view, bind_expr_mutable.value, bind_expr_mutable.token, state));
    ELSE_IF stmt IS_A Assignment AS assignment THEN
      MUTABLE assignment_mutable = COPY assignment;
      IF borrowState__empty?(state) THEN
        RETURN;
      END
      TRY (borrowChecker__check_binding_moves(&rtoc_self_view, assignment_mutable.value, assignment_mutable.token, state));
    ELSE_IF stmt IS_A DestructuringAssignment AS destructuring_assignment THEN
      MUTABLE destructuring_assignment_mutable = COPY destructuring_assignment;
      IF borrowState__empty?(state) THEN
        RETURN;
      END
      TRY (borrowChecker__check_binding_moves(&rtoc_self_view, destructuring_assignment_mutable.value, destructuring_assignment_mutable.token, state));
    ELSE_IF stmt IS_A ReturnNode AS return_node THEN
      MUTABLE return_node_mutable = COPY return_node;
      IF borrowState__empty?(state) THEN
        RETURN;
      END
      TRY (borrowChecker__check_binding_moves(&rtoc_self_view, return_node_mutable.value, return_node_mutable.token, state));
    ELSE_IF stmt IS_A MoveNode AS move_node THEN
      MUTABLE move_node_mutable = COPY move_node;
      IF borrowState__empty?(state) THEN
        RETURN;
      END
      MUTABLE inner = move_node_mutable.value;
      IF inner IS_A Identifier THEN
        borrowChecker__check_borrowed_move(&rtoc_self_view, CAST(inner.name() AS String), move_node_mutable.token, state);
      END
    ELSE_IF (stmt IS_A FuncCall) OR (stmt IS_A MethodCall) THEN
      IF borrowState__empty?(state) THEN
        RETURN;
      END
      TRY (borrowChecker__check_explicit_moves(&rtoc_self_view, stmt, stmt.token(), state));
    ELSE_IF (stmt IS_A BgBlock) OR (stmt IS_A BgStreamBlock) THEN
      IF !(borrowState__empty?(state)) THEN
        FOR _ IN (IF stmt.capture_analysis() != NIL THEN
          { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_30 = (stmt.capture_analysis());
        TRY (ownershipDataflow__resource_captures(rtoc_local_receiver_30)) }
        ELSE
          NIL
        END) DO
        borrowChecker__check_borrowed_move(&rtoc_self_view, _, stmt.token(), state);
        END
      END
      FOR _ IN (TRY (aST__child_bodies(stmt))) DO
      TRY (borrowChecker__check_stmts(&rtoc_self_view, _, state));
      END
    ELSE
      FOR _ IN (TRY (aST__child_bodies(stmt))) DO
      TRY (borrowChecker__check_stmts(&rtoc_self_view, _, state));
      END
    END
}
END
PRIVATE FN borrowChecker__handle_with_block(MUTABLE self: BorrowChecker, stmt: WithBlock, state: BorrowState) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE body_state = COPY state;
    MUTABLE rtoc_each_items_31 = ((TRY (capabilityPlan__require_for(stmt))).all);
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_31.length() DO
      MUTABLE var_node = COPY rtoc_each_items_31[rtoc_idx]?.var_node;
      MUTABLE source: ?String = borrowChecker__cap_source_name(rtoc_self_view, var_node);
      IF !(source) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !((capabilityTransition__restrict?(rtoc_each_items_31[rtoc_idx]?) OR capabilityTransition__borrowed?(rtoc_each_items_31[rtoc_idx]?))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE kind = IF capabilityTransition__restrict?(rtoc_each_items_31[rtoc_idx]?) THEN
          :mutable
        ELSE
          :immutable
        END;
      MUTABLE token = (var_node.token() OR stmt.token);
      IF borrowState__conflicts_with?(body_state, UNWRAP (source), kind) THEN
          IF (kind == :mutable) THEN
            &rtoc_self_view.errors.append("[ALIAS_VIOLATION] ${rtoc_self_view.fn_name}::${source} -- mutable borrow (RESTRICT) while already borrowed${borrowChecker__line_info(rtoc_self_view, token)}");
          ELSE_IF borrowState__mutable?(body_state, UNWRAP (source)) THEN
            &rtoc_self_view.errors.append("[ALIAS_VIOLATION] ${rtoc_self_view.fn_name}::${source} -- immutable borrow while mutably borrowed (RESTRICT)${borrowChecker__line_info(rtoc_self_view, token)}");
          END
      END
      body_state = borrowState__add(body_state, source, kind);
    rtoc_idx = rtoc_idx + 1;
    END
    TRY (borrowChecker__check_stmts(&rtoc_self_view, stmt.body, body_state));
}
END
PRIVATE FN borrowChecker__check_binding_moves(MUTABLE self: BorrowChecker, expr: ?Locatable, token: Token, state: BorrowState) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF expr EXISTS AS expr_value THEN
      MUTABLE expr_value_mutable = COPY expr_value;
      FOR _ IN (TRY (borrowChecker__collect_moved_names(&rtoc_self_view, expr_value_mutable))) DO
      borrowChecker__check_borrowed_move(&rtoc_self_view, _, token, state);
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN borrowChecker__check_explicit_moves(MUTABLE self: BorrowChecker, stmt: Locatable, token: Token, state: BorrowState) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE owner_state = TRY (borrowChecker__synthetic_owner_state(rtoc_self_view));
    FOR _ IN ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_32 = (TRY (borrowChecker__transfer_collector(&rtoc_self_view)));
    TRY (ownershipDataflow__explicit_move_places(rtoc_local_receiver_32, stmt, owner_state)) }) DO
    borrowChecker__check_borrowed_move(&rtoc_self_view, _.path, token, state);
    END
}
END
PRIVATE FN borrowChecker__check_borrowed_move(MUTABLE self: BorrowChecker, name: String, token: Token, state: BorrowState) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE borrow_kind = borrowState__kind_for(state, name);
    IF !(borrow_kind) THEN
      RETURN;
    END
    &rtoc_self_view.errors.append("[MOVE_WHILE_BORROWED] ${rtoc_self_view.fn_name}::${name} -- cannot move while ${borrow_kind} borrow is active${borrowChecker__line_info(rtoc_self_view, token)}");
}
END
PRIVATE FN borrowChecker__collect_moved_names(MUTABLE self: BorrowChecker, node: Locatable) RETURNS ![Set]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN (({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_33 = (TRY (borrowChecker__transfer_collector(&rtoc_self_view)));
    TRY (ownershipDataflow__binding_move_places(rtoc_local_receiver_33, node, TRY (borrowChecker__synthetic_owner_state(rtoc_self_view)))) }) |> SELECT _.path) |> DISTINCT _;
}
END
PRIVATE FN borrowChecker__transfer_collector(MUTABLE self: BorrowChecker) RETURNS !OwnershipDataflow@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.transfer_collector = (rtoc_self_view.transfer_collector OR ownershipDataflow__new(TRY (functionCFG__build(rtoc_self_view.fn_node)), rtoc_self_view.fn_node, rtoc_self_view.schema_lookup));
    RETURN rtoc_self_view.transfer_collector;
}
END
PRIVATE FN borrowChecker__synthetic_owner_state(self: BorrowChecker) RETURNS !{PlaceId}OwnerEntry
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE default_entry = OwnerEntry{ state: COPY owned, allocator: :heap, needs_cleanup: TRUE };
    RETURN {};
}
END
PRIVATE FN borrowChecker__walk_expr_node(self: BorrowChecker, node: ?Locatable, skip_copy: Bool = FALSE, block: FN(Locatable) -> Void) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node EXISTS AS node_value THEN
      block(node_value);
      FOR _ IN (TRY (mIRControlFlowExpr__children(node_value, skip_copy))) DO
      borrowChecker__walk_expr_node(rtoc_self_view, _, skip_copy, block);
      END
      NIL;
    ELSE
      RETURN;
    END
}
END
PUB FN borrowChecker__new(fn_node: FunctionDef, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS BorrowChecker@multiowned ->
  MUTABLE self = BorrowChecker{ errors: List[], fn_name: "", fn_node: COPY fn_node, schema_lookup: COPY schema_lookup };
  borrowChecker__initialize(&self, fn_node, schema_lookup);
  RETURN self @multiowned;
END
FN castAssignmentNameToOptionalLocatable(value: AssignmentName) RETURNS ?Locatable ->
  PARTIAL MATCH value START
    AssignmentName.Identifier AS cast_payload -> RETURN Locatable{ Identifier: COPY cast_payload };,
    AssignmentName.GetField AS cast_payload -> RETURN Locatable{ GetField: COPY cast_payload };,
    AssignmentName.GetIndex AS cast_payload -> RETURN Locatable{ GetIndex: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to ?Locatable");
  END
  panic("Invalid cast to ?Locatable");
END
FN castLocatableToBgNode(value: Locatable) RETURNS BgNode ->
  PARTIAL MATCH value START
    Locatable.MIRBgBlock AS cast_payload -> RETURN BgNode{ MIRBgBlock: COPY cast_payload };,
    Locatable.BgStreamBlock AS cast_payload -> RETURN BgNode{ BgStreamBlock: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to BgNode");
  END
  panic("Invalid cast to BgNode");
END
FN castLocatableToCallNode(value: Locatable) RETURNS CallNode ->
  PARTIAL MATCH value START
    Locatable.FuncCall AS cast_payload -> RETURN CallNode{ FuncCall: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to CallNode");
  END
  panic("Invalid cast to CallNode");
END
FN castLocatableToIdentifier(value: Locatable) RETURNS Identifier ->
  IF value IS_A Identifier AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to Identifier");
END
