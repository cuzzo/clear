# Ruby module MIRControlFlowExpr
PUB FN mIRControlFlowExpr__children(node: ?Locatable, skip_copy: Bool = FALSE) RETURNS ![]Locatable ->
  RETURN TRY (aST__expression_children(UNWRAP (node), skip_copy));
END
# End Ruby module MIRControlFlowExpr
PUB STRUCT BasicBlock {
  id: Int64,
  predecessors: []BasicBlock@multiowned,
  stmts: []Node,
  successors: []BasicBlock@multiowned
}

PUB FN basicBlock__initialize(MUTABLE self: BasicBlock, id: Int64) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.id = COPY id;
    rtoc_self_view.stmts = List[];
    rtoc_self_view.successors = List[];
    rtoc_self_view.predecessors = List[];
}
END
PUB FN basicBlock__add_successor(MUTABLE self: BasicBlock, block: BasicBlock) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(rtoc_self_view.successors.contains?(block)) THEN
      &rtoc_self_view.successors.append(block);
    END
    IF !(block.predecessors.contains?(rtoc_self_view)) THEN
      &block.predecessors.append(rtoc_self_view);
    END
}
END
PUB FN basicBlock__terminator(self: BasicBlock) RETURNS ?Locatable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY castOptionalNodeToOptionalLocatable(rtoc_self_view.stmts.last());
}
END
PUB FN basicBlock__new(id: Int64) RETURNS BasicBlock@multiowned ->
  MUTABLE self = BasicBlock{ id: id, predecessors: List[], stmts: List[], successors: List[] };
  basicBlock__initialize(&self, id);
  RETURN self @multiowned;
END
PUB STRUCT FunctionCFG {
  block_counter: Int64,
  blocks: []BasicBlock@multiowned,
  can_fail_fns: ?[Set]String,
  entry: BasicBlock@multiowned,
  exit_block: BasicBlock@multiowned,
  fn_name: String
}

PUB FN functionCFG__initialize(MUTABLE self: FunctionCFG, fn_name: String, can_fail_fns: ?[Set]String = NIL) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.fn_name = COPY fn_name;
    rtoc_self_view.can_fail_fns = COPY can_fail_fns;
    rtoc_self_view.blocks = List[];
    rtoc_self_view.block_counter = 0;
    rtoc_self_view.entry = functionCFG__new_block(&rtoc_self_view);
    rtoc_self_view.exit_block = functionCFG__new_block(&rtoc_self_view);
}
END
PUB FN functionCFG__can_fail_fns(self: FunctionCFG) RETURNS !?[Set]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY rtoc_self_view.can_fail_fns;
}
END
PUB FN functionCFG__new_block(MUTABLE self: FunctionCFG) RETURNS BasicBlock@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE block = basicBlock__new(rtoc_self_view.block_counter);
    rtoc_self_view.block_counter = (rtoc_self_view.block_counter + 1);
    &rtoc_self_view.blocks.append(KEEP block);
    RETURN block;
}
END
PUB FN functionCFG__build(fn_node: FunctionDef, can_fail_fns: ?[Set]String = NIL) RETURNS !FunctionCFG@multiowned ->
  MUTABLE cfg = functionCFG__new(fn_node.name, can_fail_fns);
  MUTABLE last_block: ?BasicBlock = TRY (functionCFG__build_body(fn_node.body, KEEP cfg.entry, KEEP cfg.exit_block, cfg));
  IF last_block EXISTS AS last_block_value THEN
    MUTABLE last_block_value_mutable = COPY last_block_value;
    basicBlock__add_successor(&last_block_value_mutable, KEEP cfg.exit_block);
  END
  RETURN cfg;
END
PRIVATE FN functionCFG__build_body(stmts_input: []Node, current_block_input: BasicBlock, exit_target: BasicBlock, cfg: FunctionCFG, break_target: ?BasicBlock = NIL, continue_target: ?BasicBlock = NIL) RETURNS !?BasicBlock@multiowned EFFECTS REENTRANT ->
  MUTABLE current_block = COPY current_block_input;
  MUTABLE stmts = COPY stmts_input;
  IF !(TRUE) THEN
    stmts = [stmts];
  END
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < stmts.length() DO
  IF (stmts[rtoc_idx]? IS_A IfStatement) THEN
      &current_block.stmts.append(COPY stmts[rtoc_idx]?);
      MUTABLE then_block = functionCFG__new_block(&cfg);
      MUTABLE else_block_branch_value: ?BasicBlock = NIL;
      IF stmts[rtoc_idx]?.else_branch() THEN
        else_block_branch_value = functionCFG__new_block(&cfg);
      ELSE
        else_block_branch_value = NIL;
      END
      MUTABLE else_block: ?BasicBlock = else_block_branch_value;
      MUTABLE join_block = functionCFG__new_block(&cfg);
      basicBlock__add_successor(&current_block, then_block);
      basicBlock__add_successor(&current_block, (else_block OR_ELSE join_block));
      MUTABLE then_exit: ?BasicBlock = TRY (functionCFG__build_body((stmts[rtoc_idx]?.then_branch() OR List[]), then_block, exit_target, cfg, break_target, continue_target));
      IF then_exit EXISTS AS then_exit_value THEN
        MUTABLE then_exit_value_mutable = COPY then_exit_value;
        basicBlock__add_successor(&then_exit_value_mutable, join_block);
      END
      IF stmts[rtoc_idx]?.else_branch() THEN
        MUTABLE else_exit: ?BasicBlock = TRY (functionCFG__build_body(stmts[rtoc_idx]?.else_branch(), else_block?, exit_target, cfg, break_target, continue_target));
        IF else_exit EXISTS AS else_exit_value THEN
          MUTABLE else_exit_value_mutable = COPY else_exit_value;
          basicBlock__add_successor(&else_exit_value_mutable, join_block);
        END
      END
      current_block = KEEP join_block;
  ELSE_IF (stmts[rtoc_idx]? IS_A WhileLoop) THEN
      &current_block.stmts.append(COPY stmts[rtoc_idx]?);
      MUTABLE body_block = functionCFG__new_block(&cfg);
      MUTABLE after_block = functionCFG__new_block(&cfg);
      basicBlock__add_successor(&current_block, body_block);
      basicBlock__add_successor(&current_block, after_block);
      MUTABLE body_exit: ?BasicBlock = TRY (functionCFG__build_body((stmts[rtoc_idx]?.do_branch() OR List[]), body_block, exit_target, cfg, after_block, current_block));
      IF body_exit != NIL THEN
            basicBlock__add_successor(&body_exit, current_block);
      END
      current_block = KEEP after_block;
  ELSE_IF (stmts[rtoc_idx]? IS_A ForRange) OR (stmts[rtoc_idx]? IS_A ForEach) THEN
      &current_block.stmts.append(COPY stmts[rtoc_idx]?);
      MUTABLE body_block = functionCFG__new_block(&cfg);
      MUTABLE after_block = functionCFG__new_block(&cfg);
      basicBlock__add_successor(&current_block, body_block);
      basicBlock__add_successor(&current_block, after_block);
      MUTABLE body_exit: ?BasicBlock = TRY (functionCFG__build_body(stmts[rtoc_idx]?.body(), body_block, exit_target, cfg, after_block, current_block));
      IF body_exit != NIL THEN
            basicBlock__add_successor(&body_exit, current_block);
      END
      current_block = KEEP after_block;
  ELSE_IF (stmts[rtoc_idx]? IS_A MatchStatement) THEN
      &current_block.stmts.append(COPY stmts[rtoc_idx]?);
      MUTABLE join_block = functionCFG__new_block(&cfg);
      FOR _ IN (stmts[rtoc_idx]?.cases()) DO
    MUTABLE case_block = functionCFG__new_block(&cfg);
    basicBlock__add_successor(&current_block, case_block);
    MUTABLE case_exit: ?BasicBlock = TRY (functionCFG__build_body(_.body(), case_block, exit_target, cfg, break_target, continue_target));
    IF case_exit EXISTS AS case_exit_value THEN
          MUTABLE case_exit_value_mutable = COPY case_exit_value;
          basicBlock__add_successor(&case_exit_value_mutable, join_block);
    END
      END
      IF stmts[rtoc_idx]?.default_case() THEN
        MUTABLE default_block = functionCFG__new_block(&cfg);
        basicBlock__add_successor(&current_block, default_block);
        MUTABLE default_exit: ?BasicBlock = TRY (functionCFG__build_body(stmts[rtoc_idx]?.default_case(), default_block, exit_target, cfg, break_target, continue_target));
        IF default_exit EXISTS AS default_exit_value THEN
          MUTABLE default_exit_value_mutable = COPY default_exit_value;
          basicBlock__add_successor(&default_exit_value_mutable, join_block);
        END
      END
      current_block = KEEP join_block;
  ELSE_IF (stmts[rtoc_idx]? IS_A WithBlock) THEN
      &current_block.stmts.append(COPY stmts[rtoc_idx]?);
      MUTABLE body_block = functionCFG__new_block(&cfg);
      MUTABLE after_block = functionCFG__new_block(&cfg);
      basicBlock__add_successor(&current_block, body_block);
      basicBlock__add_successor(&current_block, after_block);
      MUTABLE body_exit: ?BasicBlock = TRY (functionCFG__build_body(stmts[rtoc_idx]?.body(), body_block, exit_target, cfg, break_target, continue_target));
      IF body_exit EXISTS AS body_exit_value THEN
        MUTABLE body_exit_value_mutable = COPY body_exit_value;
        basicBlock__add_successor(&body_exit_value_mutable, after_block);
      END
      current_block = KEEP after_block;
  ELSE_IF (stmts[rtoc_idx]? IS_A DoBlock) THEN
      &current_block.stmts.append(COPY stmts[rtoc_idx]?);
      MUTABLE join_block = functionCFG__new_block(&cfg);
      FOR _ IN (stmts[rtoc_idx]?.branches()) DO
    MUTABLE branch_block = functionCFG__new_block(&cfg);
    basicBlock__add_successor(&current_block, branch_block);
    MUTABLE branch_exit: ?BasicBlock = TRY (functionCFG__build_body(_.body(), branch_block, exit_target, cfg, break_target, continue_target));
    IF branch_exit EXISTS AS branch_exit_value THEN
          MUTABLE branch_exit_value_mutable = COPY branch_exit_value;
          basicBlock__add_successor(&branch_exit_value_mutable, join_block);
    END
      END
      basicBlock__add_successor(&current_block, join_block);
      current_block = join_block;
  ELSE_IF (stmts[rtoc_idx]? IS_A BgBlock) OR (stmts[rtoc_idx]? IS_A BgStreamBlock) THEN
      &current_block.stmts.append(COPY stmts[rtoc_idx]?);
      MUTABLE body_block = functionCFG__new_block(&cfg);
      MUTABLE after_block = functionCFG__new_block(&cfg);
      basicBlock__add_successor(&current_block, body_block);
      basicBlock__add_successor(&current_block, after_block);
      TRY (functionCFG__build_body(stmts[rtoc_idx]?.body(), body_block, exit_target, cfg, break_target, continue_target));
      current_block = after_block;
  ELSE_IF (stmts[rtoc_idx]? IS_A ReturnNode) OR (stmts[rtoc_idx]? IS_A Raise) THEN
      &current_block.stmts.append(COPY stmts[rtoc_idx]?);
      basicBlock__add_successor(&current_block, KEEP cfg.exit_block);
      RETURN NIL;
  ELSE_IF (stmts[rtoc_idx]? IS_A BreakNode) THEN
      &current_block.stmts.append(COPY stmts[rtoc_idx]?);
      IF break_target EXISTS AS break_target_value THEN
        MUTABLE break_target_value_mutable = COPY break_target_value;
        basicBlock__add_successor(&current_block, break_target_value_mutable);
      END
      RETURN NIL;
  ELSE_IF (stmts[rtoc_idx]? IS_A ContinueNode) THEN
      &current_block.stmts.append(COPY stmts[rtoc_idx]?);
      IF continue_target EXISTS AS continue_target_value THEN
        MUTABLE continue_target_value_mutable = COPY continue_target_value;
        basicBlock__add_successor(&current_block, continue_target_value_mutable);
      END
      RETURN NIL;
  ELSE
      IF ((cfg.can_fail_fns != NIL) AND TRY (functionCFG__stmt_can_fail?(stmts[rtoc_idx]?, (cfg.can_fail_fns)?))) THEN
        basicBlock__add_successor(&current_block, KEEP cfg.exit_block);
        MUTABLE next_block = functionCFG__new_block(&cfg);
        basicBlock__add_successor(&current_block, next_block);
        &next_block.stmts.append(COPY stmts[rtoc_idx]?);
        current_block = next_block;
      ELSE
        &current_block.stmts.append(COPY stmts[rtoc_idx]?);
      END
  END
  rtoc_idx = rtoc_idx + 1;
  END
  MUTABLE rtoc_owned_return_1: ?BasicBlock@multiowned = current_block;
  RETURN rtoc_owned_return_1;
END
PRIVATE FN functionCFG__stmt_can_fail?(node: Locatable, can_fail_fns: [Set]String) RETURNS !Bool EFFECTS REENTRANT ->
  IF (node IS_A FuncCall OR node IS_A MethodCall) THEN
    IF node.can_fail() THEN
      RETURN TRUE;
    END
    IF can_fail_fns.contains?(node.name()) THEN
      RETURN TRUE;
    END
  END
  IF (IF node IS_A StaticCall AS static_call THEN (static_call.can_fail != NIL) ELSE FALSE END) THEN
    RETURN TRUE;
  END
  IF ((node IS_A FreezeNode OR node IS_A Raise) OR node IS_A OrElseRaise) THEN
    RETURN TRUE;
  END
  RETURN (TRY (mIRControlFlowExpr__children(node))) |> ANY TRY (functionCFG__stmt_can_fail?(_, can_fail_fns));
END
PUB FN functionCFG__new(fn_name: String, can_fail_fns: ?[Set]String = NIL) RETURNS FunctionCFG@multiowned ->
  MUTABLE self = FunctionCFG{ block_counter: 0, blocks: List[], can_fail_fns: COPY can_fail_fns, entry: NIL, exit_block: NIL, fn_name: COPY fn_name };
  functionCFG__initialize(&self, fn_name, can_fail_fns);
  RETURN self @multiowned;
END
PUB STRUCT OwnershipDataflow {
  block_in: {Int64}{PlaceId}OwnerEntry,
  block_out: {Int64}?{PlaceId}OwnerEntry,
  cfg: FunctionCFG@multiowned,
  fn_node: FunctionDef,
  schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult
}

PUB STRUCT OwnerEntry {
  state: String@symbol,
  allocator: String@symbol,
  needs_cleanup: Bool
}

PUB FN ownerEntry__equals?(self: OwnerEntry, other: Any) RETURNS Bool EFFECTS REENTRANT ->
  RETURN PARTIAL MATCH other START
    OwnerEntry -> (self.state == other.state()),
    Symbol -> (self.state == other),
    DEFAULT -> FALSE
  END;
END
FN ownerEntry__eql?(self: OwnerEntry, other: Any) RETURNS Bool ->
  ownerEntry__equals?(self, other);
END
PUB FN ownerEntry__hash(self: OwnerEntry) RETURNS Int64 EFFECTS REENTRANT ->
  RETURN self.state.hash();
END
PUB STRUCT DataflowStep {
  state: {PlaceId}OwnerEntry,
  consumed: [Set]PlaceId
}
PUB STRUCT ControlHeaderTransfer {
  condition: ?Locatable,
  loop_name: ?String,
  loop_binding: ?Locatable
}
PUB STRUCT OwnershipSnapshot {
  entries: {PlaceId}OwnerEntry
}

PUB FN ownershipSnapshot__initialize(MUTABLE self: OwnershipSnapshot, entries: {PlaceId}OwnerEntry) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.entries = entries;
}
END
PUB FN ownershipSnapshot__from_state(state: {String}OwnerEntry) RETURNS !OwnershipSnapshot@multiowned ->
  RETURN ownershipSnapshot__from_ownership_state(TRY (ownershipDataflow__state_from_names(state)));
END
PUB FN ownershipSnapshot__from_ownership_state(state: {PlaceId}OwnerEntry) RETURNS OwnershipSnapshot@multiowned ->
  MUTABLE entries: {PlaceId}OwnerEntry = {};
  state.keys() |> EACH {
  MUTABLE entry: OwnerEntry = (state[_] OR_ELSE CAST(panic("missing hash key") AS OwnerEntry));
  entries[_] = COPY entry;
  };
  RETURN ownershipSnapshot__new(entries);
END
PUB FN ownershipSnapshot__entry_for(self: OwnershipSnapshot, name: String) RETURNS ?OwnerEntry
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE place = placeid.from_path(Path{ StringValue: COPY name });
    IF rtoc_self_view.entries[place] != NIL THEN
    RETURN COPY (rtoc_self_view.entries[place])?;
    ELSE
    RETURN COPY ( { MUTABLE rtoc_transform_keys_result_3: {Any}OwnerEntry = {}; FOR rtoc_key IN rtoc_self_view.entries.keys() DO rtoc_transform_keys_result_3[rtoc_key.path] = (rtoc_self_view.entries[rtoc_key] OR_ELSE CAST(panic("missing hash key") AS OwnerEntry)); END rtoc_transform_keys_result_3 } )[place.path()];
    END
}
END
PUB FN ownershipSnapshot__each_entry(self: OwnershipSnapshot, block: FN(PlaceId, OwnerEntry) -> Void) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    rtoc_self_view.entries.keys() |> EACH {
    MUTABLE entry: OwnerEntry = (rtoc_self_view.entries[_] OR_ELSE CAST(panic("missing hash key") AS OwnerEntry));
    block(_, entry);
    };
    NIL;
}
END
PUB FN ownershipSnapshot__names(self: OwnershipSnapshot) RETURNS ![Set]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (rtoc_self_view.entries.keys() |> SELECT _.path) |> DISTINCT _;
}
END
PUB FN ownershipSnapshot__new(entries: {PlaceId}OwnerEntry) RETURNS OwnershipSnapshot@multiowned ->
  MUTABLE self = OwnershipSnapshot{ entries: {} };
  ownershipSnapshot__initialize(&self, entries);
  RETURN self @multiowned;
END
PUB STRUCT CleanupDecisionFacts {
  match_takes_vars: [Set]String,
  loop_declared_names: [Set]String
}
PUB STRUCT CleanupDecisionFrame {
  body: []Locatable,
  loop_depth: Int64
}
PUB STRUCT CleanupDecision {
  needs_cleanup: Bool,
  has_moved_guard: Bool
}
PUB STRUCT CleanupEntryPair {
  place: PlaceId,
  name: String,
  entry: CleanupEntry@multiowned
}
PUB FN ownershipDataflow__state_from_names(state: {String}OwnerEntry) RETURNS !{PlaceId}OwnerEntry ->
  MUTABLE entries: {PlaceId}OwnerEntry = {};
  state.keys() |> EACH {
  MUTABLE entry: OwnerEntry = (state[_] OR_ELSE CAST(panic("missing hash key") AS OwnerEntry));
  entries[placeid.from_path(Path{ StringValue: COPY _ })] = COPY entry;
  };
  RETURN entries;
END
PUB FN ownershipDataflow__place_for_binding_node(name: String, node: Node) RETURNS PlaceId ->
  MUTABLE sym = IF TRUE THEN
    aST__node__symbol(node)
  ELSE
    NIL
  END;
  MUTABLE symbol = IF sym IS_A SymbolEntry THEN
    sym
  ELSE
    NIL
  END;
  RETURN placeid.from_symbol(name, symbol);
END
PUB FN ownershipDataflow__resolve_state_place(state: {PlaceId}OwnerEntry, place: Place) RETURNS PlaceId ->
  MUTABLE candidate = placeid.from_path(castPlaceToPath(place));
  IF state[candidate] THEN
    RETURN candidate;
  END
  IF state.keys() |> FIND (_.path == candidate.path()) != NIL THEN
  RETURN (state.keys() |> FIND (_.path == candidate.path()))?;
  ELSE
  RETURN candidate;
  END
END
PUB FN ownershipDataflow__lookup_state_entry(state: {PlaceId}OwnerEntry, place: Place) RETURNS ?OwnerEntry ->
  RETURN COPY state[ownershipDataflow__resolve_state_place(state, place)];
END
PUB FN ownershipDataflow__initialize(MUTABLE self: OwnershipDataflow, cfg: FunctionCFG, fn_node: FunctionDef, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.cfg = COPY cfg;
    rtoc_self_view.fn_node = COPY fn_node;
    rtoc_self_view.schema_lookup = COPY schema_lookup;
    rtoc_self_view.block_in = {};
    rtoc_self_view.block_out = {};
}
END
PUB FN ownershipDataflow__cfg(self: OwnershipDataflow) RETURNS FunctionCFG@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN KEEP rtoc_self_view.cfg;
}
END
PUB FN ownershipDataflow__analyze_mut(MUTABLE self: OwnershipDataflow) RETURNS !OwnershipDataflow@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN rtoc_self_view.cfg.blocks DO
    rtoc_self_view.block_in[_.id] = TRY (ownershipDataflow__empty_ownership_state(rtoc_self_view));
    rtoc_self_view.block_out[_.id] = NIL;
    END
    rtoc_self_view.block_in[(KEEP rtoc_self_view.cfg.entry).id] = TRY (ownershipDataflow__init_entry_state(rtoc_self_view));
    MUTABLE order_index = TRY (ownershipDataflow__reverse_postorder_index(rtoc_self_view));
    MUTABLE worklist: []BasicBlock@multiowned = rtoc_self_view.cfg.blocks |> ORDER_BY (order_index[_.id] OR_ELSE rtoc_self_view.cfg.blocks.length());
    MUTABLE in_worklist = {};
    FOR _ IN worklist DO
    in_worklist[_.id] = TRUE;
    END
    WHILE !((worklist.length() == 0)) DO
      MUTABLE block = UNWRAP (&worklist.shift());
      &in_worklist.delete(block.id);
      MUTABLE new_in =     IF (block == KEEP rtoc_self_view.cfg.entry) THEN
        rtoc_self_view.block_in[(KEEP rtoc_self_view.cfg.entry).id]
      ELSE
        TRY (ownershipDataflow__join_predecessors(rtoc_self_view, block))
      END;
      new_in = new_in;
      rtoc_self_view.block_in[block.id] = new_in;
      MUTABLE new_out = TRY (ownershipDataflow__apply_transfer(rtoc_self_view, block, TRY (ownershipDataflow__dup_state(rtoc_self_view, new_in))));
      MUTABLE old_out: ?{PlaceId}OwnerEntry = COPY rtoc_self_view.block_out[block.id];
      IF !(((old_out != NIL) AND (new_out == old_out))) THEN
        rtoc_self_view.block_out[block.id] = new_out;
        FOR _ IN block.successors DO
        IF !(in_worklist[_.id]) THEN
          ownershipDataflow__insert_ordered_worklist_mut(rtoc_self_view, &worklist, _, order_index);
          in_worklist[_.id] = TRUE;
        END
        END
      END
    END
    MUTABLE rtoc_owned_return_4: OwnershipDataflow@multiowned = rtoc_self_view;
    RETURN rtoc_owned_return_4;
}
END
PUB FN ownershipDataflow__reverse_postorder_index(self: OwnershipDataflow) RETURNS !{Int64}Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE visited: [Set]Int64 = Set[];
    MUTABLE order: []BasicBlock@multiowned = ( { MUTABLE rtoc_empty_list_5: []BasicBlock@multiowned = List[]; rtoc_empty_list_5 } );
    MUTABLE visit: ?Any@multiowned = NIL;
    visit = %(block) USE(MUTABLE order, visit, MUTABLE visited) -> {
    IF visited.contains?(block.id()) THEN
        RETURN NIL;
    END
    &visited.insert(block.id());
    FOR _ IN block.successors() DO
    runtimeCallSpec__call(CAST(UNWRAP (visit) AS RuntimeCallSpec), _);
    END
    &order.append(COPY block)
    };
    runtimeCallSpec__call(CAST(visit AS RuntimeCallSpec), KEEP rtoc_self_view.cfg.entry);
    FOR _ IN rtoc_self_view.cfg.blocks DO
    runtimeCallSpec__call(CAST(visit AS RuntimeCallSpec), _);
    END
    RETURN {
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE rtoc_indexed_items_6: []BasicBlock@multiowned = order.reverse();
    MUTABLE rtoc_indexed_output_8 = {};
    MUTABLE rtoc_indexed_i_7 = 0;
    WHILE rtoc_indexed_i_7 < rtoc_indexed_items_6.length() DO
      MUTABLE rtoc_indexed_pair_9 = [rtoc_indexed_items_6[rtoc_indexed_i_7].id, rtoc_indexed_i_7];
      rtoc_indexed_output_8[rtoc_indexed_pair_9._0] = rtoc_indexed_pair_9._1;
      rtoc_indexed_i_7 = rtoc_indexed_i_7 + 1;
    END
    rtoc_indexed_output_8
    };
}
END
PUB FN ownershipDataflow__insert_ordered_worklist_mut(self: OwnershipDataflow, MUTABLE worklist: []BasicBlock@multiowned, block: BasicBlock, order_index: {Int64}Int64) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rank = (order_index[block.id] OR_ELSE worklist.length());
    MUTABLE idx = worklist.indexOf();
    IF idx THEN
      worklist[idx] = [block];
    ELSE
      &worklist.append(COPY block);
    END
    NIL;
}
END
PUB FN ownershipDataflow__exit_states(self: OwnershipDataflow) RETURNS !{String}OwnerEntry
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (ownershipDataflow__state_to_names(rtoc_self_view, TRY (ownershipDataflow__exit_ownership_state(rtoc_self_view))));
}
END
PUB FN ownershipDataflow__exit_snapshot(self: OwnershipDataflow) RETURNS !OwnershipSnapshot@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ownershipSnapshot__from_ownership_state(TRY (ownershipDataflow__exit_ownership_state(rtoc_self_view)));
}
END
PUB FN ownershipDataflow__cleanup_summary(self: OwnershipDataflow) RETURNS !{String}CleanupDecision
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (TRY (ownershipDataflow__cleanup_summary_by_place(rtoc_self_view))).each_with_object({}, %(tuple_param_0, out: Tuple<PlaceId,CleanupDecision>) -> {
    MUTABLE place = tuple_param_0._0;
    MUTABLE decision = tuple_param_0._1;
    out[place.path()] = decision;
    NIL
    });
}
END
PUB FN ownershipDataflow__cleanup_summary_by_place(self: OwnershipDataflow) RETURNS !{PlaceId}CleanupDecision
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE summary: {PlaceId}CleanupDecision = {};
    MUTABLE rtoc_local_receiver_10 = (TRY (ownershipDataflow__exit_snapshot(rtoc_self_view)));
    ownershipSnapshot__each_entry(rtoc_local_receiver_10, %(place: PlaceId, entry: OwnerEntry) USE(MUTABLE summary) -> {
    MUTABLE st = entry.state;
    IF (st == :owned) THEN
        summary[place] = CleanupDecision{ needs_cleanup: TRUE, has_moved_guard: FALSE };
    ELSE_IF (st == :maybe_moved) THEN
        summary[place] = CleanupDecision{ needs_cleanup: TRUE, has_moved_guard: TRUE };
    ELSE_IF (st == :moved) THEN
        summary[place] = CleanupDecision{ needs_cleanup: FALSE, has_moved_guard: FALSE };
    END
    rubyToClearVoid()
    });
    RETURN summary;
}
END
PUB FN ownershipDataflow__cleanup_decisions_mut(self: OwnershipDataflow, fn_node: FunctionDef, facts: FrozenCleanupFacts) RETURNS !FrozenCleanupFacts
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE summary = TRY (ownershipDataflow__cleanup_summary_by_place(rtoc_self_view));
    MUTABLE block_summaries = TRY (ownershipDataflow__block_exit_cleanup_summaries(rtoc_self_view));
    MUTABLE ambiguous_names = TRY (ownershipDataflow__duplicate_binding_names(rtoc_self_view, fn_node.body));
    MUTABLE decision_facts = TRY (ownershipDataflow__cleanup_decision_facts(rtoc_self_view, fn_node.body));
    MUTABLE checker = useAfterMoveChecker__new(fn_node, rtoc_self_view);
    TRY (useAfterMoveChecker__check_mut(&checker));
    IF !((checker.errors.length() == 0)) THEN
      panic("[Ownership Error] {}");
    END
    MUTABLE rtoc_each_items_11 = (TRY (ownershipDataflow__cleanup_entry_pairs(rtoc_self_view, fn_node, facts)));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_11.length() DO
      MUTABLE var = COPY rtoc_each_items_11[rtoc_idx]?.name;
      MUTABLE entry = COPY KEEP rtoc_each_items_11[rtoc_idx]?.entry;
      IF !(cleanupEntry__needs_cleanup?(entry)) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE block_entry: ?CleanupDecision = COPY block_summaries[rtoc_each_items_11[rtoc_idx]?.place];
      MUTABLE df_entry_branch_value: ?CleanupDecision = NIL;
        IF ((block_entry != NIL) AND !(block_entry.needs_cleanup)) THEN
          df_entry_branch_value = COPY block_entry;
        ELSE
          df_entry_branch_value = (IF summary[rtoc_each_items_11[rtoc_idx]?.place] != NIL THEN summary[rtoc_each_items_11[rtoc_idx]?.place] ELSE block_entry END);
        END
      MUTABLE df_entry: ?CleanupDecision = df_entry_branch_value;
      IF !(df_entry) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !(df_entry.needs_cleanup) THEN
          IF ownershipDataflow__preserve_guard_after_full_move?(rtoc_self_view, var, entry, decision_facts, ambiguous_names) THEN
            cleanupEntry__mark_moved_guard_mut(&entry);
          ELSE
            cleanupEntry__suppress_cleanup_mut(&entry);
          END
      ELSE_IF (!(df_entry.has_moved_guard) AND cleanupEntry__has_moved_guard?(entry)) THEN
          cleanupEntry__clear_moved_guard_mut(&entry);
      ELSE_IF (df_entry.has_moved_guard AND !(cleanupEntry__has_moved_guard?(entry))) THEN
          cleanupEntry__mark_moved_guard_mut(&entry);
      END
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN COPY facts;
}
END
PUB FN ownershipDataflow__preserve_guard_after_full_move?(self: OwnershipDataflow, var: String, entry: CleanupEntry, decision_facts: CleanupDecisionFacts, ambiguous_names: [Set]String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ((((cleanupEntry__kind(entry) == :takes_union) OR decision_facts.match_takes_vars.contains?(var)) OR decision_facts.loop_declared_names.contains?(var)) OR ambiguous_names.contains?(var));
}
END
PUB FN ownershipDataflow__cleanup_entry_pairs(self: OwnershipDataflow, fn_node: FunctionDef, facts: FrozenCleanupFacts) RETURNS ![]CleanupEntryPair
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE pairs: []CleanupEntryPair = ( { MUTABLE rtoc_empty_list_12: []CleanupEntryPair = List[]; rtoc_empty_list_12 } );
    MUTABLE seen: [Set]Int64 = Set[];
    aST__each_locatable(fn_node.body, %(node: Locatable) USE(MUTABLE pairs, MUTABLE seen, rtoc_self_view) -> {
    IF !((node IS_A VarDecl OR ((IF node IS_A BindExpr AS bind_expr THEN (bind_expr.mode != :assign) ELSE FALSE END)))) THEN
        RETURN;
    END
    MUTABLE entry = node.mir_binding_entry();
    IF !(entry) THEN
        RETURN;
    END
    IF entry.none?() THEN
        RETURN;
    END
    MUTABLE name = COPY CAST(node.name() AS String);
    &pairs.append(CleanupEntryPair{ place: COPY ownershipDataflow__place_for_binding_node(name, node), name: COPY name, entry: entry });
    &seen.insert(aST__node_identity(entry));
    rubyToClearVoid()
    });
    frozenCleanupFacts__each_entry(facts, %(place: PlaceId, entry: CleanupEntry) USE(MUTABLE pairs, seen) -> {
    IF seen.contains?(aST__node_identity(entry)) THEN
        RETURN;
    END
    &pairs.append(CleanupEntryPair{ place: COPY place, name: COPY place.path, entry: entry });
    rubyToClearVoid()
    });
    RETURN pairs;
}
END
PUB FN ownershipDataflow__duplicate_binding_names(self: OwnershipDataflow, body: []Locatable) RETURNS ![Set]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE counts: {String}Int64 = {};
    aST__each_locatable(body, %(node: Locatable) USE(MUTABLE counts) -> {
    IF !((node IS_A VarDecl OR ((IF node IS_A BindExpr AS bind_expr THEN (bind_expr.mode != :assign) ELSE FALSE END)))) THEN
        RETURN;
    END
    MUTABLE name = COPY CAST(node.name() AS String);
    counts[name] = (UNWRAP (counts[name]) + 1);
    rubyToClearVoid()
    });
    RETURN counts.each_with_object(Set[], %(tuple_param_0, out: Tuple<String,Int64>) -> {
    MUTABLE name = tuple_param_0._0;
    MUTABLE count = tuple_param_0._1;
    IF (count > 1) THEN
      RETURN &out.append(name);
    END
    NIL
    });
}
END
PUB FN ownershipDataflow__linear_scope_decl_always_moves?(self: OwnershipDataflow, stmts: []Locatable, var: String) RETURNS !Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < stmts.length() DO
      IF ownershipDataflow__declares_name?(rtoc_self_view, stmts[rtoc_idx]?, var) THEN
          RETURN (stmts.substr(((rtoc_idx + 1)), (stmts.length() - ((rtoc_idx + 1))))).to_a() |> ANY TRY (ownershipDataflow__stmt_moves_name?(rtoc_self_view, _, var));
      END
      MUTABLE nested = (TRY (aST__child_bodies(stmts[rtoc_idx]?))).flatten();
      IF (!(nested.empty?()) AND TRY (ownershipDataflow__linear_scope_decl_always_moves?(rtoc_self_view, nested, var))) THEN
          RETURN TRUE;
      END
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN FALSE;
}
END
PUB FN ownershipDataflow__declares_name?(self: OwnershipDataflow, stmt: Locatable, var: String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (localBindingAnalysis__binding_decl_name(stmt) == var);
}
END
PUB FN ownershipDataflow__binding_move_places(self: OwnershipDataflow, node: ?Locatable, state: {PlaceId}OwnerEntry) RETURNS ![]PlaceId
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (ownershipDataflow__collect_binding_move_places(rtoc_self_view, node, state));
}
END
PUB FN ownershipDataflow__explicit_move_places(self: OwnershipDataflow, node: ?Locatable, state: {PlaceId}OwnerEntry) RETURNS ![]PlaceId
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (ownershipDataflow__collect_explicit_move_places(rtoc_self_view, node, state));
}
END
PRIVATE FN ownershipDataflow__stmt_moves_name?(self: OwnershipDataflow, stmt: Locatable, var: String) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF stmt IS_A ReturnNode AS return_node THEN
      RETURN FALSE;
    END
    MUTABLE state = TRY (ownershipDataflow__state_from_names({var: OwnerEntry{ state: COPY :owned, allocator: :heap, needs_cleanup: TRUE }}));
    RETURN (((TRY (ownershipDataflow__collect_binding_move_places(rtoc_self_view, stmt, state))) |> ANY (_.path == var)) OR (((aST__call?(stmt) AND ((TRY (ownershipDataflow__collect_bg_capture_places_in_args(rtoc_self_view, CAST(stmt AS Any@multiowned), state))) |> ANY (_.path == var))))));
}
END
PUB FN ownershipDataflow__block_exit_cleanup_summaries(self: OwnershipDataflow) RETURNS !{PlaceId}CleanupDecision
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE saw: {PlaceId}{String@symbol}Bool = {};
    FOR _ IN rtoc_self_view.block_out.values() DO
    IF !(_) THEN
      CONTINUE;
    END
    FOR rtoc_each_1 IN _.keys() DO
      MUTABLE entry: Any = (rtoc_each_1[rtoc_each_1] OR_ELSE panic("missing hash key"));
      IF !(entry IS_A OwnerEntry) THEN
        CONTINUE;
      END
      saw[rtoc_each_1] = (saw[rtoc_each_1] OR_ELSE {:any_moved: FALSE, :any_maybe: FALSE, :any_not_moved: FALSE});
      MUTABLE rec = UNWRAP (saw[rtoc_each_1]);
      IF (entry.state() == :moved) THEN
          rec[:any_moved] = TRUE;
      ELSE_IF (entry.state() == :maybe_moved) THEN
          rec[:any_maybe] = TRUE;
      ELSE
          rec[:any_not_moved] = TRUE;
      END
        END
    END
    RETURN ( { MUTABLE rtoc_transform_values_result_13: {PlaceId}CleanupDecision = {}; FOR rtoc_key IN saw.keys() DO rtoc_transform_values_result_13[rtoc_key] = { MUTABLE rtoc_value_block_marker = 0;
    MUTABLE rec: {String@symbol}Bool = (saw[rtoc_key] OR_ELSE CAST(panic("missing hash key") AS {String@symbol}Bool));
    MUTABLE moved = ((rec[:any_moved] != NIL) AND !(rec[:any_maybe]));
    CleanupDecision{ needs_cleanup: !(moved), has_moved_guard: (rec[:any_maybe]? OR ((!(moved) AND rec[:any_moved]?))) }
    }; END rtoc_transform_values_result_13 } );
}
END
PUB FN ownershipDataflow__replay_state_for_block(self: OwnershipDataflow, block: BasicBlock) RETURNS !{PlaceId}OwnerEntry
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (ownershipDataflow__dup_state(rtoc_self_view, (rtoc_self_view.block_in[block.id] OR_ELSE TRY (ownershipDataflow__empty_ownership_state(rtoc_self_view)))));
}
END
