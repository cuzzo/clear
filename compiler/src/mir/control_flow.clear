FN castOptionalStmtToLoopNode(value: ?Stmt) RETURNS LoopNode ->
  IF value == NIL THEN
    panic("Invalid cast to LoopNode");
  END
  PARTIAL MATCH value? START
    Stmt.WhileLoop AS cast_payload -> RETURN LoopNode{ WhileLoop: COPY cast_payload };,
    Stmt.WhileBindLoop AS cast_payload -> RETURN LoopNode{ WhileBindLoop: COPY cast_payload };,
    Stmt.ForRange AS cast_payload -> RETURN LoopNode{ ForRange: COPY cast_payload };,
    Stmt.ForEach AS cast_payload -> RETURN LoopNode{ ForEach: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to LoopNode");
  END
  panic("Invalid cast to LoopNode");
END
FN castPlaceToPath(value: Place) RETURNS Path ->
  PARTIAL MATCH value START
    Place.StringValue AS cast_payload -> RETURN Path{ StringValue: COPY cast_payload };,
    Place.SymbolValue AS cast_payload -> RETURN Path{ SymbolValue: COPY cast_payload };,
    Place.PlaceId AS cast_payload -> RETURN Path{ PlaceId: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Path");
  END
  panic("Invalid cast to Path");
END
FN rubyToClearVoid() RETURNS Void ->
  RETURN;
END
PUB FN ownershipDataflow__schema_lookup_call(self: OwnershipDataflow, arg0: String@symbol) RETURNS ?TypeSchemaLookupResult ->
  MUTABLE fn_value = UNWRAP (self.schema_lookup);
  RETURN fn_value(arg0);
END
PUB FN borrowChecker__schema_lookup_call(self: BorrowChecker, arg0: String@symbol) RETURNS ?TypeSchemaLookupResult ->
  MUTABLE fn_value = UNWRAP (self.schema_lookup);
  RETURN fn_value(arg0);
END
