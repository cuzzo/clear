PRIVATE FN ownershipDataflow__set_state_entry_mut(self: OwnershipDataflow, MUTABLE state: {PlaceId}OwnerEntry, place: Place, entry: OwnerEntry) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    state[placeid.from_path(castPlaceToPath(place))] = COPY entry;
