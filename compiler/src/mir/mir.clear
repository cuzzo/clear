FN program__ownership_source_exprs(self: MIRProgram) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE empty_child_exprs: []Emittable = [];
    RETURN empty_child_exprs;
}
END
FN program__owned_position_source_exprs(self: MIRProgram) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE empty_child_exprs: []Emittable = [];
    RETURN empty_child_exprs;
