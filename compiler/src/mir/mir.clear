PUB STRUCT IfStmt {
  cond: Emittable,
  then_body: Any@multiowned,
  else_body: Any@multiowned,
  comptime: Any@multiowned,
  lowered_node_id: ?LoweredNodeId,
  ownership_consumption: ?OwnershipConsumptionFact,
  source_column: ?Int64,
  source_line: ?Int64
}

FN ifStmt__child_exprs(self: IfStmt) RETURNS ![]Emittable EFFECTS REENTRANT ->
