  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.body = COPY body;
    MUTABLE rtoc_writer = COPY rtoc_self_view.writer;
    rtoc_writer(body);
}
END
FN bodySlot__new(name: String@symbol, body: []Emittable, writer: FN(Emittable[]) -> Void) RETURNS MIRBodySlot@multiowned ->
  MUTABLE self = MIRBodySlot{ body: COPY body, name: COPY name, writer: COPY writer };
  bodySlot__initialize(&self, name, body, writer);
  RETURN self @multiowned;
END
PUB STRUCT LoweredNodeId {
  value: Int64
}

FN loweredNodeId__equals?<T>(self: LoweredNodeId, other: T) RETURNS Bool EFFECTS REENTRANT ->
  COMPTIME IF !(T IS_A LoweredNodeId) THEN
    RETURN FALSE;
  END
  MUTABLE other_id: LoweredNodeId = CAST(other AS LoweredNodeId);
  RETURN (other_id.value == self.value);
END
FN loweredNodeId__eql?(self: LoweredNodeId, other: Any) RETURNS Bool ->
  RETURN (self == other);
END
FN loweredNodeId__hash(self: LoweredNodeId) RETURNS Int64 EFFECTS REENTRANT ->
  RETURN self.value;
END
PUB STRUCT LoweredBodyId {
  node_ids: []LoweredNodeId
}

FN loweredBodyId__equals?<T>(self: LoweredBodyId, other: T) RETURNS Bool EFFECTS REENTRANT ->
  COMPTIME IF !(T IS_A LoweredBodyId) THEN
    RETURN FALSE;
  END
  MUTABLE other_body: LoweredBodyId = CAST(other AS LoweredBodyId);
  RETURN (other_body.node_ids == self.node_ids);
END
FN loweredBodyId__eql?(self: LoweredBodyId, other: Any) RETURNS Bool ->
  RETURN (self == other);
END
FN loweredBodyId__hash(self: LoweredBodyId) RETURNS Int64 EFFECTS REENTRANT ->
  MUTABLE combined: Int64 = 0;
  FOR node_id IN self.node_ids DO
    combined = ((combined * 31) + loweredNodeId__hash(node_id));
  END
  RETURN combined;
END
# Ruby module MIR::Emittable
# End Ruby module MIR::Emittable
# Ruby module MIR::NamedEmittable
# Ruby module MIR::Stmt
# Ruby module MIR::Expr
FN ownershipEffect__of(node: ?Emittable) RETURNS !OwnershipEffect EFFECTS REENTRANT ->
  IF node EXISTS AS node_value THEN
    RETURN TRY (emittable__ownership_effect(node_value));
  END
  RETURN ownershipEffect__none();
END
FN ownershipEffect__hoistable_owned_result?(node: ?Emittable) RETURNS !Bool ->
  MUTABLE effect = TRY (ownershipEffect__of(node));
  RETURN (effect.produces_owned AND effect.requires_hoist);
END
FN ownershipEffect__alloc_of(node: ?Emittable) RETURNS !?String@symbol EFFECTS REENTRANT ->
  RETURN TRY (ownershipEffect__of(node)).alloc;
END
FN ownershipEffect__from_effects(effects_value: []OwnershipEffect) RETURNS !OwnershipEffect EFFECTS REENTRANT ->
  MUTABLE owned: []OwnershipEffect = [];
  FOR effect IN effects_value DO
    IF effect.produces_owned THEN
      &owned.append(COPY effect);
    END
  END
  RETURN TRY (ownershipEffect__effect_when(!((owned.length() == 0)), ownershipEffect__owned(ownershipEffect__converged_effect_alloc(owned), :uniform)));
END
FN ownershipEffect__from_children(children: []Emittable) RETURNS !OwnershipEffect EFFECTS REENTRANT ->
  MUTABLE child_effects: []OwnershipEffect = [];
  FOR child IN children DO
    &child_effects.append(TRY (emittable__ownership_effect(child)));
  END
  RETURN ownershipEffect__from_effects(child_effects);
END
FN ownershipEffect__from_try_fallback(left: OwnershipEffect, right: OwnershipEffect, result_type: ?Type, fallback_is_literal: Bool, left_never_success: Bool) RETURNS !OwnershipEffect EFFECTS REENTRANT ->
  RETURN TRY (ownershipEffect__first_active_effect([Tuple{ownershipEffect__same_owned_alloc?(left, right), left}, Tuple{TRY (ownershipEffect__owned_cleanup_result?(left, result_type)), left}, Tuple{(left.produces_owned AND fallback_is_literal), left}, Tuple{(right.produces_owned AND left_never_success), right}]));
END
FN ownershipEffect__from_optional_fallback(left: OwnershipEffect, right: OwnershipEffect, result_type: ?Type) RETURNS !OwnershipEffect EFFECTS REENTRANT ->
  RETURN TRY (ownershipEffect__first_active_effect([Tuple{ownershipEffect__same_owned_alloc?(left, right), left}, Tuple{TRY (ownershipEffect__owned_cleanup_result?(left, result_type)), left}, Tuple{TRY (ownershipEffect__owned_cleanup_result?(right, result_type)), right}]));
END
FN ownershipEffect__from_required_branch_pair(left: OwnershipEffect, right: OwnershipEffect) RETURNS !OwnershipEffect EFFECTS REENTRANT ->
  RETURN TRY (ownershipEffect__effect_when(ownershipEffect__same_owned_alloc?(left, right), left));
END
FN ownershipEffect__from_pipeline(sink_alloc: ?String@symbol, inner: ?Emittable) RETURNS !OwnershipEffect EFFECTS REENTRANT ->
  RETURN TRY (ownershipEffect__first_active_effect([Tuple{!((sink_alloc == NIL)), ownershipEffect__owned(sink_alloc)}, Tuple{TRUE, TRY (ownershipEffect__of(inner))}]));
END
FN ownershipEffect__from_block_body(body: []Emittable, result_type: ?Type, borrowed_view: Bool = FALSE) RETURNS !OwnershipEffect EFFECTS REENTRANT ->
  MUTABLE stmts = COPY body;
  MUTABLE value: ?Emittable = NIL;
  MUTABLE idx: Int64 = (stmts.length() - 1);
  WHILE (idx >= 0) DO
    IF UNWRAP (stmts[idx]) IS_A BreakStmt AS break_stmt THEN
      value = COPY break_stmt.value;
      idx = -1;
    ELSE
      idx = (idx - 1);
    END
  END
  RETURN TRY (ownershipEffect__first_active_effect([
    Tuple{TRUE, ownershipEffect__transferred_break_ident_effect(stmts, value)},
    Tuple{TRUE, TRY (ownershipEffect__of(value))},
    Tuple{TRUE, ownershipEffect__block_result_transfer_effect(stmts, value)},
    Tuple{(TRY (ownershipEffect__cleanup_result_type?(result_type)) AND !((borrowed_view OR ownershipEffect__borrowed_break_value?(value)))), ownershipEffect__owned(NIL, :uniform)}
  ]));
END
PRIVATE FN ownershipEffect__borrowed_break_value?(value: ?Emittable) RETURNS Bool ->
  RETURN ((value != NIL) AND (value IS_A SliceExpr));
END
FN ownershipEffect__borrowed_view_result?(node: ?Emittable) RETURNS Bool ->
  IF node EXISTS AS node_value THEN
    IF node_value IS_A MIRBlockExpr AS block THEN
      IF block.borrowed_view THEN
        RETURN TRUE;
      END
      MUTABLE value: ?Emittable = NIL;
      MUTABLE idx: Int64 = (block.body.length() - 1);
      WHILE (idx >= 0) DO
        IF UNWRAP (block.body[idx]) IS_A BreakStmt AS break_stmt THEN
          value = COPY break_stmt.value;
          idx = -1;
        ELSE
          idx = (idx - 1);
        END
      END
      RETURN ownershipEffect__borrowed_break_value?(value);
    END
  END
  RETURN FALSE;
END
PRIVATE FN ownershipEffect__effect_when(active: Bool, effect: OwnershipEffect) RETURNS !OwnershipEffect EFFECTS REENTRANT ->
  RETURN TRY (ownershipEffect__first_active_effect([CAST(Tuple{active, effect} AS Tuple<Bool, OwnershipEffect>)]));
END
PRIVATE FN ownershipEffect__first_active_effect(candidates: []Tuple<Bool, OwnershipEffect>) RETURNS !OwnershipEffect EFFECTS REENTRANT ->
  FOR candidate IN candidates DO
    IF (candidate._0 AND candidate._1.produces_owned) THEN
      RETURN COPY candidate._1;
    END
  END
  RETURN ownershipEffect__none();
END
PRIVATE FN ownershipEffect__converged_effect_alloc(effects_value: []OwnershipEffect) RETURNS ?String@symbol EFFECTS REENTRANT ->
  MUTABLE allocs: []String@symbol = [];
  FOR effect IN effects_value DO
    IF effect.alloc EXISTS AS effect_alloc THEN
      IF !(allocs.contains?(effect_alloc)) THEN
        &allocs.append(COPY effect_alloc);
      END
    END
  END
  RETURN ownershipEffect__unique_symbol_or_nil(allocs);
END
PRIVATE FN ownershipEffect__unique_symbol_or_nil(symbols: []String@symbol) RETURNS ?String@symbol EFFECTS REENTRANT ->
  MUTABLE unique: []String@symbol = [];
  FOR symbol_value IN symbols DO
    IF !(unique.contains?(symbol_value)) THEN
      &unique.append(COPY symbol_value);
    END
  END
  IF (unique.length() == 1) THEN
    RETURN COPY symbols.first();
  END
  RETURN NIL;
END
PRIVATE FN ownershipEffect__same_owned_alloc?(left: OwnershipEffect, right: OwnershipEffect) RETURNS Bool ->
  RETURN ((left.produces_owned AND right.produces_owned) AND (left.alloc == right.alloc));
END
PRIVATE FN ownershipEffect__owned_cleanup_result?(effect: OwnershipEffect, result_type: ?Type) RETURNS !Bool ->
  RETURN (((effect.produces_owned AND TRY (ownershipEffect__cleanup_result_type?(result_type)))) == TRUE);
END
PRIVATE FN ownershipEffect__cleanup_result_type?(result_type: ?Type) RETURNS !Bool ->
  IF result_type EXISTS AS result_type_value THEN
    RETURN ((TRY (type__needs_cleanup?(result_type_value, NIL)) OR TRY (type__recursive_cleanup_shape?(result_type_value, NIL))) OR TRY (type__specialization_may_need_cleanup?(result_type_value)));
  ELSE
    RETURN FALSE;
  END
END
PRIVATE FN ownershipEffect__transferred_break_ident_effect(stmts: []Emittable, value: ?Emittable) RETURNS !OwnershipEffect EFFECTS REENTRANT ->
  MUTABLE name: String = "";
  IF value EXISTS AS value_node THEN
    IF value_node IS_A Ident AS ident THEN
      name = COPY ident.name;
    END
  END
  MUTABLE mark_alloc: ?String@symbol = NIL;
  MUTABLE has_mark = FALSE;
  MUTABLE has_transfer = FALSE;
  MUTABLE init_effect = ownershipEffect__none();
  FOR stmt IN stmts DO
    IF stmt IS_A AllocMark AS alloc_mark THEN
      IF (alloc_mark.name == name) THEN
        has_mark = TRUE;
        mark_alloc = COPY alloc_mark.alloc;
      END
    ELSE_IF stmt IS_A TransferMark AS transfer_mark THEN
      IF (transfer_mark.name == name) THEN
        has_transfer = TRUE;
      END
    ELSE_IF stmt IS_A Let AS let_stmt THEN
      IF (let_stmt.name == name) THEN
        init_effect = TRY (ownershipEffect__of(let_stmt.init));
      END
    END
  END
  MUTABLE cleanup_kind: String@symbol = :uniform;
  IF init_effect.produces_owned THEN
    IF init_effect.cleanup_kind EXISTS AS init_cleanup_kind THEN
      cleanup_kind = COPY init_cleanup_kind;
    END
  END
  MUTABLE active = ((!((name.length() == 0)) AND has_mark) AND has_transfer);
  RETURN TRY (ownershipEffect__effect_when(active, ownershipEffect__owned(mark_alloc, cleanup_kind, TRUE, name)));
END
PRIVATE FN ownershipEffect__block_result_transfer_effect(stmts: []Emittable, value: ?Emittable) RETURNS !OwnershipEffect EFFECTS REENTRANT ->
  MUTABLE result_names = TRY (ownershipEffect__ident_names_in_expr(value));
  IF result_names.empty?() THEN
    RETURN ownershipEffect__none();
  END
  MUTABLE transferred_allocs: []String@symbol = [];
  FOR stmt IN stmts DO
    IF stmt IS_A TransferMark AS transfer_mark THEN
      IF ((transfer_mark.target == :block_result) OR (transfer_mark.target == :owned_sink)) THEN
        IF result_names.contains?(transfer_mark.name) THEN
          IF transfer_mark.target_alloc EXISTS AS transfer_alloc THEN
            &transferred_allocs.append(COPY transfer_alloc);
          END
        END
      END
    END
  END
  RETURN TRY (ownershipEffect__effect_when(!(transferred_allocs.empty?()), ownershipEffect__owned(ownershipEffect__unique_symbol_or_nil(transferred_allocs), :uniform)));
END
PRIVATE FN ownershipEffect__ident_names_in_expr(value: ?Emittable) RETURNS ![]String EFFECTS REENTRANT ->
  MUTABLE names: []String = [];
  IF value EXISTS AS value_node THEN
    IF value_node IS_A Ident AS ident THEN
      &names.append(COPY ident.name);
      RETURN names;
    END
    FOR child IN (TRY (emittable__child_exprs(value_node))) DO
      FOR child_name IN (TRY (ownershipEffect__ident_names_in_expr(child))) DO
        IF !(names.contains?(child_name)) THEN
          &names.append(COPY child_name);
        END
      END
    END
  END
  RETURN names;
END
PUB STRUCT StructInitField {
  name: String@symbol,
  value: Emittable,
  alloc: ?String@symbol
}

FN structInitField__get_index(self: StructInitField, key: String@symbol) RETURNS ?StructInitFieldValue ->
  IF (key == :name) THEN
    RETURN StructInitFieldValue{ SymbolValue: COPY self.name };
  ELSE_IF (key == :value) THEN
    RETURN COPY StructInitFieldValue{ Emittable: COPY self.value };
  ELSE_IF (key == :alloc) THEN
    RETURN ruby_wrap_optional_String_symbol_StructInitFieldValue(self.alloc);
  ELSE
    RETURN NIL;
  END
END
FN mIR__named_field(name: String@symbol, value: Emittable) RETURNS StructInitField ->
  RETURN StructInitField{ name: COPY name, value: COPY value, alloc: NIL };
END
FN mIR__if_binding(expr: Emittable, capture: MirCapture) RETURNS !{String@symbol}NamedMirFieldValue ->
  MUTABLE binding: {String@symbol}NamedMirFieldValue = {};
  binding[:expr] = NamedMirFieldValue{ Emittable: COPY expr };
  binding[:capture] = castCaptureToNamedMirFieldValue(COPY capture);
  RETURN binding;
END
FN mIR__struct_init_field_name(field: StructInitFieldInput) RETURNS ?MIRReturnValue ->
  IF field IS_A StructInitField AS struct_init_field THEN
    RETURN COPY MIRReturnValue{ SymbolValue: COPY struct_init_field.name };
  END
  IF field IS_A {String@symbol}NamedMirFieldValue AS hash THEN
    RETURN ruby_wrap_optional_String_symbol_MIRReturnValue(castOptionalNamedMirFieldValueToOptionalStringSymbol(hash[:name]));
  END
  RETURN NIL;
END
FN mIR__struct_init_field_value(field: StructInitFieldInput) RETURNS ?Emittable ->
  IF field IS_A StructInitField AS struct_init_field THEN
    RETURN COPY struct_init_field.value;
  END
  IF field IS_A {String@symbol}NamedMirFieldValue AS hash THEN
    RETURN COPY castOptionalNamedMirFieldValueToOptionalEmittable(hash[:value]);
  END
  RETURN NIL;
END
FN mIR__struct_init_field_alloc(field: StructInitFieldInput) RETURNS ?String@symbol ->
  IF field IS_A StructInitField AS struct_init_field THEN
    RETURN COPY struct_init_field.alloc;
  END
  IF field IS_A {String@symbol}NamedMirFieldValue AS hash THEN
    RETURN castOptionalNamedMirFieldValueToOptionalStringSymbol(hash[:alloc]);
  END
  RETURN NIL;
END
FN mIR__each_node(root: ?NodeRoot, blk: FN(Emittable) -> Void) RETURNS !Void ->
  TRY (mIR__each_node_inner(root, FALSE, NIL, blk));
END
FN mIR__each_node_until(root: ?NodeRoot, stop: FN(Emittable) -> Bool, blk: FN(Emittable) -> Void) RETURNS !Void ->
  TRY (mIR__each_node_inner(root, FALSE, stop, blk));
END
FN mIR__nodes(root: ?NodeRoot) RETURNS ![]Emittable ->
  MUTABLE out: []Emittable = ( { MUTABLE rtoc_empty_list_197: []Emittable = List[]; rtoc_empty_list_197 } );
  mIR__each_node(UNWRAP (root), %(node: Emittable) USE(MUTABLE out) -> {
  &out.append(COPY node);
  rubyToClearVoid()
  });
  RETURN out;
END
FN mIR__each_surface_node(root: ?NodeRoot, blk: FN(Emittable) -> Void) RETURNS !Void ->
  TRY (mIR__each_surface_node_inner(UNWRAP (root), blk));
END
FN mIR__surface_nodes(root: ?NodeRoot) RETURNS ![]Emittable ->
  MUTABLE out: []Emittable = ( { MUTABLE rtoc_empty_list_198: []Emittable = List[]; rtoc_empty_list_198 } );
  mIR__each_surface_node(UNWRAP (root), %(node: Emittable) USE(MUTABLE out) -> {
  &out.append(COPY node);
  rubyToClearVoid()
  });
  RETURN out;
END
FN mIR__each_node_inner(root: ?NodeRoot, stop_at_block_expr: Bool, stop: ?FN(Emittable) -> Bool = NIL, blk: FN(Emittable) -> Void) RETURNS !Void EFFECTS REENTRANT ->
  IF root EXISTS AS root_value THEN
    IF root_value IS_A []Emittable AS array THEN
      FOR _ IN array DO
      TRY (mIR__each_node_inner(NodeRoot{ Emittable: COPY _ }, stop_at_block_expr, stop, blk));
      END
      RETURN;
    END
    MUTABLE node: ?Emittable = NIL;
    IF root_value IS_A Emittable AS root_node THEN
      node = COPY root_node;
    END
    IF node == NIL THEN
      RETURN;
    END
    MUTABLE node_value = COPY UNWRAP (node);
    blk(node_value);
    IF stop_at_block_expr THEN
    IF node_value IS_A MIRBlockExpr THEN
      RETURN;
    END
    END
    IF stop EXISTS AS stop_fn THEN
      IF stop_fn(node_value) THEN
        RETURN;
      END
    END
    FOR _ IN TRY (emittable__child_exprs(node_value)) DO
    TRY (mIR__each_node_inner(NodeRoot{ Emittable: COPY _ }, stop_at_block_expr, stop, blk));
    END
    FOR _ IN TRY (emittable__body_slots(node_value)) DO
    TRY (mIR__each_node_inner(NodeRoot{ ArrayValue: COPY _.body }, stop_at_block_expr, stop, blk));
    END
    NIL;
  ELSE
    RETURN;
  END
END
FN mIR__each_surface_node_inner(root: ?NodeRoot, blk: FN(Emittable) -> Void) RETURNS !Void EFFECTS REENTRANT ->
  IF root EXISTS AS root_value THEN
    IF root_value IS_A []Emittable AS array THEN
      FOR _ IN array DO
      TRY (mIR__each_surface_node_inner(NodeRoot{ Emittable: COPY _ }, blk));
      END
      RETURN;
    END
    MUTABLE node: ?Emittable = NIL;
    IF root_value IS_A Emittable AS root_node THEN
      node = COPY root_node;
    END
    IF node == NIL THEN
      RETURN;
    END
    MUTABLE node_value = COPY UNWRAP (node);
    blk(node_value);
    IF node_value IS_A MIRBlockExpr THEN
      RETURN;
    END
    FOR _ IN TRY (emittable__child_exprs(node_value)) DO
    TRY (mIR__each_surface_node_inner(NodeRoot{ Emittable: COPY _ }, blk));
    END
    NIL;
  ELSE
    RETURN;
  END
END
PUB STRUCT InlineAllocMetadata {
  slots: {String@symbol}String@symbol
}

FN inlineAllocMetadata__initialize(MUTABLE self: InlineAllocMetadata, alloc: ?String@symbol = NIL, key_alloc: ?String@symbol = NIL, val_alloc: ?String@symbol = NIL, shard_alloc: ?String@symbol = NIL) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE slots: {String@symbol}String@symbol = {};
    IF alloc EXISTS AS alloc_value THEN
      slots[:alloc] = COPY alloc_value;
    END
    IF key_alloc EXISTS AS key_alloc_value THEN
      slots[:key_alloc] = COPY key_alloc_value;
    END
    IF val_alloc EXISTS AS val_alloc_value THEN
      slots[:val_alloc] = COPY val_alloc_value;
    END
    IF shard_alloc EXISTS AS shard_alloc_value THEN
      slots[:shard_alloc] = COPY shard_alloc_value;
    END
    rtoc_self_view.slots = slots;
}
END
FN inlineAllocMetadata__empty?(self: InlineAllocMetadata) RETURNS Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (rtoc_self_view.slots.count() == 0);
}
END
FN inlineAllocMetadata__each(self: InlineAllocMetadata, blk: FN(String@symbol, String@symbol) -> Void) RETURNS Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    FOR rtoc_each_key IN rtoc_self_view.slots.keys() DO
    MUTABLE alloc: String@symbol = COPY UNWRAP (rtoc_self_view.slots[rtoc_each_key]);
    blk(symbol(rtoc_each_key), alloc);
    END
    NIL;
}
END
PRIVATE FN inlineAllocMetadata__values(self: InlineAllocMetadata) RETURNS ![]String@symbol
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN rtoc_self_view.slots.values();
}
END
PUB FN inlineAllocMetadata__slot(self: InlineAllocMetadata, key: String@symbol) RETURNS ?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN rtoc_self_view.slots[key];
}
END
FN inlineAllocMetadata__primary(self: InlineAllocMetadata) RETURNS ?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN inlineAllocMetadata__slot(rtoc_self_view, :alloc);
}
END
FN inlineAllocMetadata__key_alloc(self: InlineAllocMetadata) RETURNS ?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN inlineAllocMetadata__slot(rtoc_self_view, :key_alloc);
}
END
FN inlineAllocMetadata__value_alloc(self: InlineAllocMetadata) RETURNS ?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN inlineAllocMetadata__slot(rtoc_self_view, :val_alloc);
}
END
FN inlineAllocMetadata__shard_alloc(self: InlineAllocMetadata) RETURNS ?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN inlineAllocMetadata__slot(rtoc_self_view, :shard_alloc);
}
END
FN inlineAllocMetadata__sink_alloc(self: InlineAllocMetadata) RETURNS ?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF inlineAllocMetadata__value_alloc(rtoc_self_view) != NIL THEN
    RETURN (inlineAllocMetadata__value_alloc(rtoc_self_view))?;
    ELSE
    RETURN inlineAllocMetadata__primary(rtoc_self_view);
    END
}
END
FN inlineAllocMetadata__requires_target_alloc?(self: InlineAllocMetadata) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (!((inlineAllocMetadata__primary(rtoc_self_view) == NIL)) OR !((inlineAllocMetadata__key_alloc(rtoc_self_view) == NIL)));
}
END
FN inlineAllocMetadata__single_alloc(self: InlineAllocMetadata) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE uniq: []String@symbol = [];
    FOR alloc_value IN (TRY (inlineAllocMetadata__values(rtoc_self_view))) DO
      IF !(uniq.contains?(alloc_value)) THEN
        &uniq.append(COPY alloc_value);
      END
    END
    IF (uniq.length() == 1) THEN
      RETURN uniq.first();
    ELSE
      RETURN NIL;
    END
}
END
FN inlineAllocMetadata__any_heap?(self: InlineAllocMetadata) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (TRY (inlineAllocMetadata__values(rtoc_self_view))).contains?(:heap);
}
END
FN inlineAllocMetadata__any_frame?(self: InlineAllocMetadata) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (TRY (inlineAllocMetadata__values(rtoc_self_view))).contains?(:frame);
}
END
FN inlineAllocMetadata__with_all(self: InlineAllocMetadata, alloc: String@symbol) RETURNS InlineAllocMetadata@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE updated: {String@symbol}String@symbol = {};
    FOR rtoc_each_key IN rtoc_self_view.slots.keys() DO
    MUTABLE ignored_slot_alloc: String@symbol = COPY UNWRAP (rtoc_self_view.slots[rtoc_each_key]);
    updated[rtoc_each_key] = COPY alloc;
    END
    RETURN inlineAllocMetadata__new(updated[:alloc], updated[:key_alloc], updated[:val_alloc], updated[:shard_alloc]);
}
END
FN inlineAllocMetadata__inspect(self: InlineAllocMetadata) RETURNS String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN compilerInspectValue();
}
END
FN inlineAllocMetadata__new(alloc: ?String@symbol = NIL, key_alloc: ?String@symbol = NIL, val_alloc: ?String@symbol = NIL, shard_alloc: ?String@symbol = NIL) RETURNS InlineAllocMetadata@multiowned ->
  MUTABLE self = InlineAllocMetadata{ slots: {} };
  inlineAllocMetadata__initialize(&self, alloc, key_alloc, val_alloc, shard_alloc);
  RETURN self @multiowned;
END
