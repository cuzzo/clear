  MUTABLE out = MIRMethodCall{ receiver: COPY self.receiver, method: COPY self.method, args: COPY self.args, try_wrap: FALSE, callable_contract: COPY self.callable_contract, owned_result_alloc: COPY self.owned_result_alloc, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
  IF self.result_type EXISTS AS result_type_value THEN
    MUTABLE result_type_value_mutable = COPY result_type_value;
