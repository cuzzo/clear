END
FN deferStmt__body_slots(MUTABLE self: MIRDeferStmt) RETURNS ![]MIRBodySlot EFFECTS REENTRANT ->
  IF self.body IS_A []Emittable THEN
    RETURN CAST([deferStmt__body_slot(self, :body, castDeferBodyToEmittable(self.body), %(new_body: []Emittable) USE(MUTABLE self) -> {
