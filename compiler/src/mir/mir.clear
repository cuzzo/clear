PUB STRUCT SwitchStmt {
  subject: Emittable,
  arms: []SwitchArm,
  default_body: Any@multiowned,
  lowered_node_id: ?LoweredNodeId,
  ownership_consumption: ?OwnershipConsumptionFact,
  source_column: ?Int64,
  source_line: ?Int64
}

FN switchStmt__child_exprs(self: SwitchStmt) RETURNS ![]Emittable EFFECTS REENTRANT ->
  MUTABLE pattern_exprs: []Emittable = ( { MUTABLE rtoc_empty_list_24: []Emittable = List[]; rtoc_empty_list_24 } );
  FOR arm IN self.arms DO
    FOR pattern IN arm.patterns DO
      IF pattern IS_A Emittable AS pattern_expr THEN
        &pattern_exprs.append(COPY pattern_expr);
      END
    END
  END
  &pattern_exprs.append(COPY self.subject);
  RETURN switchStmt__compact_child_exprs(self, pattern_exprs);
END
FN switchStmt__body_slots(MUTABLE self: SwitchStmt) RETURNS ![]MIRBodySlot EFFECTS REENTRANT ->
  MUTABLE slots: []MIRBodySlot = ( { MUTABLE rtoc_empty_list_25: []MIRBodySlot = List[]; rtoc_empty_list_25 } );
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < self.arms.length() DO
  &slots.append(switchStmt__body_slot(self, symbol("arms_${rtoc_idx.toString()}"), UNWRAP (self.arms[rtoc_idx]).body, %(new_body: []Emittable) USE(MUTABLE self, rtoc_idx) -> {
    MUTABLE rtoc_slot_arm = COPY UNWRAP (self.arms[rtoc_idx]);
    rtoc_slot_arm.body = new_body;
    self.arms[rtoc_idx] = rtoc_slot_arm;
    rubyToClearVoid()
  }));
  rtoc_idx = rtoc_idx + 1;
  END
  IF self.default_body THEN
    &slots.append(switchStmt__body_slot(self, :default_body, self.default_body, %(new_body: []Emittable) USE(MUTABLE self) -> {
  self.default_body = new_body;
  rubyToClearVoid()
    }));
  END
  RETURN slots;
END
FN switchStmt__mir?(self: SwitchStmt) RETURNS Bool ->
  RETURN TRUE;
END
FN switchStmt__expr?(self: SwitchStmt) RETURNS Bool ->
  RETURN FALSE;
END
FN switchStmt__ownership_effect(self: SwitchStmt) RETURNS OwnershipEffect EFFECTS REENTRANT ->
  RETURN ownershipEffect__none();
END
FN switchStmt__ownership_source_exprs(self: SwitchStmt) RETURNS ![]Emittable ->
  MUTABLE empty_child_exprs: []Emittable = [];
  RETURN empty_child_exprs;
END
FN switchStmt__owned_position_source_exprs(self: SwitchStmt) RETURNS ![]Emittable ->
  MUTABLE empty_child_exprs: []Emittable = [];
  RETURN empty_child_exprs;
END
