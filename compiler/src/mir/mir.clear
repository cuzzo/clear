PUB STRUCT WithMatchDispatch {
  cell: Emittable,
  alias_name: String,
  snapshot_mode: Any@multiowned,
  rt_name: String,
  arms: []MIRWithMatchArm,
  lowered_node_id: ?LoweredNodeId,
  ownership_consumption: ?OwnershipConsumptionFact,
  source_column: ?Int64,
  source_line: ?Int64
}

FN withMatchDispatch__stmt?(self: WithMatchDispatch) RETURNS Bool ->
  RETURN TRUE;
END
