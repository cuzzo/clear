PUB STRUCT ProtocolAdapterDef {
  lowered_node_id: ?LoweredNodeId,
  ownership_consumption: ?OwnershipConsumptionFact,
  source_column: ?Int64,
  source_line: ?Int64,
  protocol: String,
  associated_types: []String,
  requirements: []ProtocolRequirementAdapter,
  conformances: []ProtocolConformanceCase
}

FN protocolAdapterDef__mir?(self: ProtocolAdapterDef) RETURNS Bool ->
  RETURN TRUE;
END
FN protocolAdapterDef__expr?(self: ProtocolAdapterDef) RETURNS Bool ->
  RETURN FALSE;
END
FN protocolAdapterDef__ownership_effect(self: ProtocolAdapterDef) RETURNS OwnershipEffect EFFECTS REENTRANT ->
  RETURN ownershipEffect__none();
END
FN protocolAdapterDef__child_exprs(self: ProtocolAdapterDef) RETURNS ![]Emittable EFFECTS REENTRANT ->
  MUTABLE empty_child_exprs: []Emittable = [];
  RETURN empty_child_exprs;
END
FN protocolAdapterDef__ownership_source_exprs(self: ProtocolAdapterDef) RETURNS ![]Emittable ->
  MUTABLE empty_child_exprs: []Emittable = [];
  RETURN empty_child_exprs;
END
FN protocolAdapterDef__owned_position_source_exprs(self: ProtocolAdapterDef) RETURNS ![]Emittable ->
  MUTABLE empty_child_exprs: []Emittable = [];
  RETURN empty_child_exprs;
END
FN protocolAdapterDef__body_slots(self: ProtocolAdapterDef) RETURNS ![]MIRBodySlot EFFECTS REENTRANT ->
  MUTABLE empty_body_slots: []MIRBodySlot = [];
  RETURN empty_body_slots;
END
FN protocolAdapterDef__without_try(self: ProtocolAdapterDef) RETURNS Emittable ->
  RETURN COPY self;
END
FN protocolAdapterDef__explicit_ownership_contract(self: ProtocolAdapterDef) RETURNS ?OwnershipContract@multiowned EFFECTS REENTRANT ->
  RETURN NIL;
END
FN protocolAdapterDef__compact_child_exprs(self: ProtocolAdapterDef, values: []Any) RETURNS ![]Emittable ->
  MUTABLE children: []Emittable = ( { MUTABLE rtoc_empty_list_200: []Emittable = List[]; rtoc_empty_list_200 } );
  FOR _ IN values DO
  protocolAdapterDef__append_child_expr(self, &children, _);
  END
  RETURN children;
END
FN protocolAdapterDef__append_child_expr<T>(self: ProtocolAdapterDef, MUTABLE children: []Emittable, value: T) RETURNS Void EFFECTS REENTRANT ->
  COMPTIME IF T IS_A []@multiowned Any THEN
    FOR _ IN value DO
    protocolAdapterDef__append_child_expr(self, &children, _);
    END
  ELSE_IF T IS_A Emittable THEN
    &children.append(value);
  END
  RETURN NIL;
END
FN protocolAdapterDef__body_slot(self: ProtocolAdapterDef, name: String@symbol, body: []Emittable, writer: FN([]Emittable) -> Void) RETURNS MIRBodySlot@multiowned ->
  RETURN bodySlot__new(name, body, writer);
END
FN protocolAdapterDef__owned_effect_for_alloc(self: ProtocolAdapterDef, alloc: ?String@symbol, cleanup_kind: String@symbol = :uniform) RETURNS OwnershipEffect ->
  RETURN ownershipEffect__owned(alloc, cleanup_kind);
END
FN protocolAdapterDef__stmt?(self: ProtocolAdapterDef) RETURNS Bool ->
  RETURN TRUE;
END
PUB STRUCT UnionTypeVariant {
  name: String@symbol,
  zig_type: String
}

FN unionTypeVariant__get_index(self: UnionTypeVariant, key: String@symbol) RETURNS ?UnionTypeVariantReturnValue ->
  IF (key == :name) THEN
    RETURN UnionTypeVariantReturnValue{ SymbolValue: COPY self.name };
  ELSE_IF (key == :zig_type) THEN
    RETURN COPY UnionTypeVariantReturnValue{ StringValue: COPY self.zig_type };
  ELSE
    RETURN NIL;
  END
END
PUB STRUCT EnumSwitchPattern {
  variant: String
}
PUB STRUCT SwitchArm {
  patterns: []SwitchPattern,
  body: []Emittable
}
PUB STRUCT UnionMatchArm {
  variant: String,
  payload: ?String,
  pointer_payload: Bool,
  body: []Emittable
}
PUB STRUCT IfChainBranch {
  cond: Emittable,
  body: []Emittable
}
PUB STRUCT ThunkBaseCase {
  cond: Emittable,
  value: Emittable
}

FN thunkBaseCase__fetch(self: ThunkBaseCase, key: String@symbol) RETURNS !Emittable ->
  IF (key == :cond) THEN
    RETURN COPY self.cond;
  ELSE_IF (key == :value) THEN
    RETURN COPY self.value;
  ELSE
    panic("key not found: {}");
  END
END
PUB STRUCT ThunkFrameInit {
  field_name: String,
  value: Emittable
}

FN thunkFrameInit__fetch(self: ThunkFrameInit, key: String@symbol) RETURNS !ThunkFrameInitReturnValue ->
  IF (key == :field_name) THEN
    RETURN COPY ThunkFrameInitReturnValue{ StringValue: COPY self.field_name };
  ELSE_IF (key == :value) THEN
    RETURN COPY ThunkFrameInitReturnValue{ Emittable: COPY self.value };
  ELSE
    panic("key not found: {}");
  END
END
PUB STRUCT ThunkFrameField {
  name: String,
  type_info: Type
}
PUB STRUCT ThunkVariant {
  name: String,
  param_fields: []ThunkFrameField
}

FN thunkVariant__fetch(self: ThunkVariant, key: String@symbol) RETURNS !ThunkVariantReturnValue ->
  IF (key == :name) THEN
    RETURN COPY ThunkVariantReturnValue{ StringValue: COPY self.name };
  ELSE_IF (key == :param_fields) THEN
    RETURN COPY ThunkVariantReturnValue{ ArrayValue: COPY self.param_fields };
  ELSE
    panic("key not found: {}");
  END
END
PUB STRUCT MutualThunkArm {
  variant_name: String,
  base_cases: []ThunkBaseCase,
  target_variant: String,
  target_arg_inits: []ThunkFrameInit
}

FN mutualThunkArm__fetch(self: MutualThunkArm, key: String@symbol) RETURNS !MutualThunkArmReturnValue ->
  IF (key == :variant_name) THEN
    RETURN COPY MutualThunkArmReturnValue{ StringValue: COPY self.variant_name };
  ELSE_IF (key == :base_cases) THEN
    RETURN COPY MutualThunkArmReturnValue{ ArrayValue: COPY self.base_cases };
  ELSE_IF (key == :target_variant) THEN
    RETURN COPY MutualThunkArmReturnValue{ StringValue: COPY self.target_variant };
  ELSE_IF (key == :target_arg_inits) THEN
    RETURN COPY MutualThunkArmReturnValue{ ArrayValue2: COPY self.target_arg_inits };
  ELSE
    panic("key not found: {}");
  END
END
PUB STRUCT ThunkTrampoline {
  lowered_node_id: ?LoweredNodeId,
  ownership_consumption: ?OwnershipConsumptionFact,
  source_column: ?Int64,
  source_line: ?Int64,
  fn_name: String,
  return_type: Type,
  param_fields: []ThunkFrameField,
  param_init_fields: []ThunkFrameInit,
  base_cases: []ThunkBaseCase,
  recurse_arg_inits: []ThunkFrameInit,
  combine_lhs: Emittable,
  combine_op: String@symbol,
  yield_policy: String@symbol
}

FN thunkTrampoline__mir?(self: ThunkTrampoline) RETURNS Bool ->
  RETURN TRUE;
