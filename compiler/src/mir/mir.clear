  body: []Emittable,
  name: String@symbol,
  writer: FN(Emittable[]) -> Void
}

FN bodySlot__initialize(MUTABLE self: MIRBodySlot, name: String@symbol, body: []Emittable, writer: FN(Emittable[]) -> Void) RETURNS Void
  REQUIRES self: LOCAL
