FN thunkTrampoline__compact_child_exprs(self: ThunkTrampoline, values: []Any) RETURNS ![]Emittable ->
  MUTABLE children: []Emittable = ( { MUTABLE rtoc_empty_list_201: []Emittable = List[]; rtoc_empty_list_201 } );
  FOR _ IN values DO
  thunkTrampoline__append_child_expr(self, &children, _);
  END
  RETURN children;
