FN bgBlock__initialize(MUTABLE self: MIRBgBlock, code: BgBlockPlan, captures_value: {String}Type, run_body: []Emittable, fsm_structure: ?Emittable = NIL) RETURNS !Void ->
  IF !(mIR__structural_bg_block_plan?(code)) THEN
    panic("MIR::BgBlock code must be a structural emission plan, got {}");
  END
END
FN bgBlock__result_type(MUTABLE self: MIRBgBlock) RETURNS ?Type ->
  IF !(TRUE) THEN
    self.result_type = NIL;
  END
  RETURN COPY self.result_type;
END
FN bgBlock__set_result_type(MUTABLE self: MIRBgBlock, value: ?Type) RETURNS ?Type ->
  self.result_type = COPY value;
  RETURN COPY value;
END
FN bgBlock__boundary_fact(MUTABLE self: MIRBgBlock) RETURNS ?ExecutionBoundaryFact ->
  IF !(TRUE) THEN
    self.boundary_fact = NIL;
  END
  RETURN COPY self.boundary_fact;
