    END
  END
  MUTABLE marks: []Emittable = [];
  FOR transfer_name IN unique_names DO
    FOR mark IN (TRY (ownershipTransferPlan__marks(OwnershipTransferPlan{ name: COPY transfer_name, target: :owned_sink, target_alloc: :heap, move_guarded: TRUE }))) DO
      &marks.append(COPY mark);
    END
  END
  RETURN marks;
END
