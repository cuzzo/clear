END
PUB STRUCT OwnershipContract {
  borrows: []String,
  covers_consuming_params: Bool,
  operands: []OwnershipOperandFact,
  produces: []String
}

FN ownershipContract__initialize(MUTABLE self: OwnershipContract, operands: []OwnershipOperandFact, produces: []String, borrows: []String, covers_consuming_params: Bool = FALSE) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.operands = COPY operands;
    rtoc_self_view.produces = TRY (ownershipContract__normalize_names(rtoc_self_view, produces));
    rtoc_self_view.borrows = TRY (ownershipContract__normalize_names(rtoc_self_view, borrows));
    rtoc_self_view.covers_consuming_params = COPY covers_consuming_params;
}
END
FN ownershipContract__empty() RETURNS !OwnershipContract@multiowned ->
  MUTABLE no_operands: []OwnershipOperandFact = [];
  MUTABLE no_produces: []String = [];
  MUTABLE no_borrows: []String = [];
  RETURN TRY (ownershipContract__new(no_operands, no_produces, no_borrows));
END
FN ownershipContract__consume_operands(operands: []OwnershipOperandFact) RETURNS !OwnershipContract@multiowned ->
  RETURN TRY (ownershipContract__new(operands, ( { MUTABLE rtoc_empty_list_186: []String = List[]; rtoc_empty_list_186 } ), ( { MUTABLE rtoc_empty_list_187: []String = List[]; rtoc_empty_list_187 } ), TRUE));
END
FN ownershipContract__owned_operand_names(self: OwnershipContract) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE names: []String = ( { MUTABLE rtoc_empty_list_188: []String = List[]; rtoc_empty_list_188 } );
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_self_view.operands.length() DO
      IF rtoc_self_view.operands[rtoc_idx]?.borrowed THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE name: ?String = COPY rtoc_self_view.operands[rtoc_idx]?.name;
      IF !(name) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF name EXISTS AS string_name THEN
        IF !((string_name.length() == 0)) THEN
          &names.append(COPY string_name);
        END
      END
    rtoc_idx = rtoc_idx + 1;
    END
    MUTABLE distinct_names: []String = [];
    FOR raw_name IN names DO
      IF !(distinct_names.contains?(raw_name)) THEN
        &distinct_names.append(COPY raw_name);
      END
    END
    RETURN distinct_names;
}
END
FN ownershipContract__empty?(MUTABLE self: OwnershipContract) RETURNS Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN ((((rtoc_self_view.operands.length() == 0) AND (rtoc_self_view.produces.length() == 0)) AND (rtoc_self_view.borrows.length() == 0)) AND !(rtoc_self_view.covers_consuming_params));
}
END
PRIVATE FN ownershipContract__normalize_names(self: OwnershipContract, names: []String) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE normalized: []String = [];
    FOR raw_name IN names DO
      IF !(raw_name.empty?()) THEN
        IF !(normalized.contains?(raw_name)) THEN
          &normalized.append(COPY raw_name);
        END
      END
    END
    RETURN normalized;
}
END
FN ownershipContract__new(operands: []OwnershipOperandFact, produces: []String, borrows: []String, covers_consuming_params: Bool = FALSE) RETURNS !OwnershipContract@multiowned ->
  MUTABLE self = OwnershipContract{ borrows: List[], covers_consuming_params: covers_consuming_params, operands: List[], produces: List[] };
  TRY (ownershipContract__initialize(&self, operands, produces, borrows, covers_consuming_params));
  RETURN self @multiowned;
END
PUB STRUCT CallableContract {
  checked_arg_count: Int64,
  ownership_contract: OwnershipContract,
  signature: FunctionSignature
}

FN callableContract__initialize(MUTABLE self: CallableContract, signature: FunctionSignature, ownership_contract: OwnershipContract, checked_arg_count: Int64) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.signature = COPY signature;
    rtoc_self_view.ownership_contract = COPY ownership_contract;
    rtoc_self_view.checked_arg_count = COPY checked_arg_count;
}
END
FN callableContract__no_ownership(checked_arg_count: Int64) RETURNS !CallableContract@multiowned ->
  MUTABLE params: []Param = ( { MUTABLE rtoc_empty_list_189: []Param = List[]; rtoc_empty_list_189 } );
  MUTABLE idx: Int64 = 0;
  WHILE (idx < checked_arg_count) DO
  &params.append(Param{ name: "__arg${idx.toString()}", type: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })), default: NIL, mutable: NIL, takes: NIL, comptime: NIL, name_token: NIL, required: NIL, sync: NIL, symbol: NIL, carrier_contract: :polymorphic });
    idx = (idx + 1);
  END
  RETURN callableContract__new(TRY (functionSignature__new(params, TypeTypeInput{ Type: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :Void })) }, NIL, NIL, ( { MUTABLE rtoc_empty_list_190: []String@symbol = List[]; rtoc_empty_list_190 } ), {}, FALSE, FALSE, NIL, NIL, NIL, ( { MUTABLE rtoc_empty_list_191: []String@symbol = List[]; rtoc_empty_list_191 } ), NIL, ( { MUTABLE rtoc_empty_list_192: []String@symbol = List[]; rtoc_empty_list_192 } ))), TRY (ownershipContract__new(( { MUTABLE rtoc_empty_list_193: []OwnershipOperandFact = List[]; rtoc_empty_list_193 } ), ( { MUTABLE rtoc_empty_list_194: []String = List[]; rtoc_empty_list_194 } ), ( { MUTABLE rtoc_empty_list_195: []String = List[]; rtoc_empty_list_195 } ), TRUE)), checked_arg_count);
END
FN callableContract__new(signature: FunctionSignature, ownership_contract: OwnershipContract, checked_arg_count: Int64) RETURNS CallableContract@multiowned ->
  MUTABLE self = CallableContract{ checked_arg_count: checked_arg_count, ownership_contract: COPY ownership_contract, signature: COPY signature };
  callableContract__initialize(&self, signature, ownership_contract, checked_arg_count);
  RETURN self @multiowned;
END
PUB STRUCT OwnershipEffect {
  produces_owned: Bool,
  alloc: ?String@symbol,
  cleanup_kind: ?String@symbol,
  requires_hoist: Bool,
  target_var: ?String
}

FN ownershipEffect__none() RETURNS OwnershipEffect EFFECTS REENTRANT ->
  RETURN OwnershipEffect{ produces_owned: FALSE, alloc: NIL, cleanup_kind: NIL, requires_hoist: FALSE, target_var: NIL };
END
FN ownershipEffect__owned(alloc: ?String@symbol, cleanup_kind: String@symbol = :uniform, requires_hoist: Bool = TRUE, target_var: ?String = NIL) RETURNS OwnershipEffect EFFECTS REENTRANT ->
  RETURN OwnershipEffect{ produces_owned: TRUE, alloc: COPY alloc, cleanup_kind: COPY cleanup_kind, requires_hoist: COPY requires_hoist, target_var: COPY target_var };
END
FN ownershipEffect__from_callable_facts(emits_allocating: Bool, MUTABLE heap_return_alloc: Bool, fixed_void_without_alloc_metadata: Bool, mutates_receiver_without_heap_return: Bool, result_owns: ?Bool, result_type: ?Type, alloc: ?String@symbol, target_var: ?String) RETURNS !OwnershipEffect EFFECTS REENTRANT ->
  MUTABLE active = (emits_allocating OR heap_return_alloc);
  MUTABLE explicitly_not_owned = (heap_return_alloc AND (result_owns == FALSE));
  MUTABLE unknown_owned_result = FALSE;
  IF (heap_return_alloc AND (result_owns == NIL)) THEN
    IF result_type EXISTS AS result_type_value THEN
      unknown_owned_result = !(ownershipEffect__owned_result_type?(result_type_value));
    END
  END
  MUTABLE missing_allocator = ((alloc == NIL) AND !(heap_return_alloc));
  MUTABLE blocked = ((((fixed_void_without_alloc_metadata OR mutates_receiver_without_heap_return) OR explicitly_not_owned) OR unknown_owned_result) OR missing_allocator);
  IF !(active) THEN
    RETURN ownershipEffect__none();
  END
  IF blocked THEN
    RETURN ownershipEffect__none();
  END
  RETURN ownershipEffect__owned(alloc, :uniform, TRUE, target_var);
END
FN ownershipEffect__owned_result_type?(type_info: Type) RETURNS !Bool ->
  MUTABLE ti = TRY (type__success_type(type_info));
  IF type__optional?(ti) THEN
    IF (TRY (type__wrapped_type(ti))) EXISTS AS wrapped THEN
      ti = COPY wrapped;
    END
  END
  RETURN TRY (type__ownership_bearing?(ti));
END
FN ownershipEffect__with_target(self: OwnershipEffect, name: String) RETURNS OwnershipEffect EFFECTS REENTRANT ->
  RETURN OwnershipEffect{ produces_owned: self.produces_owned, alloc: COPY self.alloc, cleanup_kind: COPY self.cleanup_kind, requires_hoist: self.requires_hoist, target_var: COPY name };
END
