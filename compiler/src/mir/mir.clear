FN thunkTrampoline__append_child_expr<T>(self: ThunkTrampoline, MUTABLE children: []Emittable, value: T) RETURNS Void EFFECTS REENTRANT ->
  COMPTIME IF T IS_A []@multiowned Any THEN
    FOR _ IN value DO
    thunkTrampoline__append_child_expr(self, &children, _);
    END
  ELSE_IF T IS_A Emittable THEN
    &children.append(value);
  END
  RETURN NIL;
END
