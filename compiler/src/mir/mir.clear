FN ownershipOperandFact__owned_binding(name: String, type_info: Type, source: String, target_alloc: ?String@symbol = NIL) RETURNS OwnershipOperandFact ->
  RETURN OwnershipOperandFact{ kind: :owned_binding, name: COPY name, borrowed: FALSE, type_info: COPY type_info, source: COPY source, target_alloc: COPY target_alloc };
END
FN ownershipOperandFact__owned_result(type_info: Type, source: String, target_alloc: ?String@symbol = NIL) RETURNS OwnershipOperandFact ->
  RETURN OwnershipOperandFact{ kind: :owned_result, name: NIL, borrowed: FALSE, type_info: COPY type_info, source: COPY source, target_alloc: COPY target_alloc };
END
FN ownershipOperandFact__borrowed_access(name: ?String, type_info: Type, source: String, target_alloc: ?String@symbol = NIL) RETURNS OwnershipOperandFact ->
  RETURN OwnershipOperandFact{ kind: :borrowed_access, name: COPY name, borrowed: TRUE, type_info: COPY type_info, source: COPY source, target_alloc: COPY target_alloc };
