PUB STRUCT DeepCopy {
  source: Emittable,
  zig_type: ?String,
  elem_type: ?String,
  strategy: String@symbol,
  alloc: ?String@symbol,
  copy_shape: String@symbol,
  type_info: ?Type,
  lowered_node_id: ?LoweredNodeId,
  ownership_consumption: ?OwnershipConsumptionFact
}

FN deepCopy__initialize(MUTABLE self: DeepCopy, source: Any, zig_type: ?String, elem_type: ?String, strategy: String@symbol, alloc: ?String@symbol, copy_shape: String@symbol = deepCopy__copy_shape_for_zig_type(zig_type), type_info: ?Type = NIL) RETURNS Void ->

END
FN deepCopy__copy_shape_for_zig_type(zig_type: ?String) RETURNS String@symbol ->
  MUTABLE text = COPY (zig_type OR_ELSE "");
  RETURN ((CAST({"": :inferred, "*": :pointer, "[]": :slice} AS {String}String@symbol))[text.substr(0, 2)] OR_ELSE ((CAST({"": :inferred, "*": :pointer, "[]": :slice} AS {String}String@symbol))[text.substr(0, 1)] OR_ELSE :value));
END
FN deepCopy__child_exprs(self: DeepCopy) RETURNS ![]Emittable EFFECTS REENTRANT ->
  RETURN deepCopy__compact_child_exprs(self, [CAST(self.source AS Any)]);
END
FN deepCopy__ownership_effect(self: DeepCopy) RETURNS OwnershipEffect EFFECTS REENTRANT ->
  IF (self.strategy == :passthrough) THEN
    RETURN ownershipEffect__none();
  END
  RETURN deepCopy__owned_effect_for_alloc(self, self.alloc);
END
FN deepCopy__mir?(self: DeepCopy) RETURNS Bool ->
  RETURN TRUE;
END
FN deepCopy__stmt?(self: DeepCopy) RETURNS Bool ->
  RETURN FALSE;
END
