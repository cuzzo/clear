  self.boundary_fact = COPY value;
  RETURN COPY value;
END
FN bgBlock__expr?(self: MIRBgBlock) RETURNS Bool ->
  RETURN TRUE;
END
FN bgBlock__body_slots(MUTABLE self: MIRBgBlock) RETURNS ![]MIRBodySlot EFFECTS REENTRANT ->
  IF self.run_body THEN
    RETURN CAST([bgBlock__body_slot(self, :run_body, self.run_body, %(new_body: []Emittable) USE(MUTABLE self) -> {
  self.run_body = new_body;
  rubyToClearVoid()
    })] AS []MIRBodySlot);
  ELSE
    RETURN CAST(( { MUTABLE rtoc_empty_list_55: []MIRBodySlot = List[]; rtoc_empty_list_55 } ) AS []MIRBodySlot);
  END
END
