  IF value IS_A OrElseExitBcRewrite AS payload THEN
    RETURN orElseExitBcRewrite__ownership_effect(payload);
  END
  IF value IS_A ShardedMapPut AS payload THEN
    RETURN TRY (shardedMapPut__ownership_effect(payload));
  END
  IF value IS_A ShardedMapGet AS payload THEN
    RETURN shardedMapGet__ownership_effect(payload);
  END
  RETURN ownershipEffect__none();
END

