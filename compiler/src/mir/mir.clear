PUB STRUCT CatchWrapper {
  inner_call: Emittable,
  error_reassigns: Any@multiowned,
  clauses: []MIRCatchClause,
  default_body: Any@multiowned,
  default_action: Any@multiowned,
  snapshot_type: Any@multiowned,
  rt_name: String,
  lowered_node_id: ?LoweredNodeId,
  ownership_consumption: ?OwnershipConsumptionFact,
  source_column: ?Int64,
  source_line: ?Int64
}

FN catchWrapper__child_exprs(self: CatchWrapper) RETURNS ![]Emittable EFFECTS REENTRANT ->
  MUTABLE exprs: []Emittable = [COPY self.inner_call];
  FOR clause IN self.clauses DO
    FOR filter_message IN clause.meta.filter_messages DO
      &exprs.append(COPY filter_message);
    END
  END
  RETURN catchWrapper__compact_child_exprs(self, exprs);
END
FN catchWrapper__clause_bodies(self: CatchWrapper) RETURNS ![][]Emittable ->
  MUTABLE bodies: [][]Emittable = (self.clauses) |> SELECT COPY _.body;
  IF catchWrapper__has_default(self) THEN
    &bodies.append(KEEP self.default_body);
  END
  RETURN bodies;
END
FN catchWrapper__clause_meta(self: CatchWrapper) RETURNS ![]CatchClauseMeta ->
  RETURN (self.clauses) |> SELECT COPY _.meta;
END
FN catchWrapper__has_default(self: CatchWrapper) RETURNS Bool ->
  RETURN (self.default_action == CatchDefaultAction.Body);
END
FN catchWrapper__body_slots(MUTABLE self: CatchWrapper) RETURNS ![]MIRBodySlot EFFECTS REENTRANT ->
  MUTABLE slots: []MIRBodySlot = ( { MUTABLE rtoc_empty_list_68: []MIRBodySlot = List[]; rtoc_empty_list_68 } );
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < self.clauses.length() DO
  &slots.append(catchWrapper__body_slot(self, symbol("clauses_${rtoc_idx.toString()}"), UNWRAP (self.clauses[rtoc_idx]).body, %(new_body: []Emittable) USE(MUTABLE self, rtoc_idx) -> {
    MUTABLE rtoc_slot_arm = COPY UNWRAP (self.clauses[rtoc_idx]);
    rtoc_slot_arm.body = new_body;
    self.clauses[rtoc_idx] = rtoc_slot_arm;
    rubyToClearVoid()
  }));
  rtoc_idx = rtoc_idx + 1;
  END
  IF catchWrapper__has_default(self) THEN
    &slots.append(catchWrapper__body_slot(self, :default_body, self.default_body, %(new_body: []Emittable) USE(MUTABLE self) -> {
  self.default_body = new_body;
  rubyToClearVoid()
    }));
  END
  RETURN slots;
END
FN catchWrapper__mir?(self: CatchWrapper) RETURNS Bool ->
  RETURN TRUE;
END
FN catchWrapper__expr?(self: CatchWrapper) RETURNS Bool ->
  RETURN FALSE;
END
FN catchWrapper__ownership_effect(self: CatchWrapper) RETURNS OwnershipEffect EFFECTS REENTRANT ->
  RETURN ownershipEffect__none();
END
FN catchWrapper__ownership_source_exprs(self: CatchWrapper) RETURNS ![]Emittable ->
  MUTABLE empty_child_exprs: []Emittable = [];
  RETURN empty_child_exprs;
END
FN catchWrapper__owned_position_source_exprs(self: CatchWrapper) RETURNS ![]Emittable ->
  MUTABLE empty_child_exprs: []Emittable = [];
  RETURN empty_child_exprs;
END
FN catchWrapper__without_try(self: CatchWrapper) RETURNS Emittable ->
  RETURN COPY self;
END
FN catchWrapper__explicit_ownership_contract(self: CatchWrapper) RETURNS ?OwnershipContract@multiowned EFFECTS REENTRANT ->
  RETURN NIL;
END
FN catchWrapper__compact_child_exprs(self: CatchWrapper, values: []Any) RETURNS ![]Emittable ->
  MUTABLE children: []Emittable = ( { MUTABLE rtoc_empty_list_69: []Emittable = List[]; rtoc_empty_list_69 } );
  FOR _ IN values DO
  catchWrapper__append_child_expr(self, &children, _);
  END
  RETURN children;
END
FN catchWrapper__append_child_expr<T>(self: CatchWrapper, MUTABLE children: []Emittable, value: T) RETURNS Void EFFECTS REENTRANT ->
  COMPTIME IF T IS_A []@multiowned Any THEN
    FOR _ IN value DO
    catchWrapper__append_child_expr(self, &children, _);
    END
  ELSE_IF T IS_A Emittable THEN
    &children.append(value);
  END
  RETURN NIL;
END
FN catchWrapper__body_slot(self: CatchWrapper, name: String@symbol, body: []Emittable, writer: FN([]Emittable) -> Void) RETURNS MIRBodySlot@multiowned ->
  RETURN bodySlot__new(name, body, writer);
END
