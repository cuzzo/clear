FN ownershipTransferPlan__marks(self: OwnershipTransferPlan) RETURNS ![]Emittable ->
  MUTABLE out: []Emittable = [Emittable{ TransferMark: COPY TransferMark{ name: COPY self.name, target: COPY self.target, target_alloc: COPY self.target_alloc, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }];
