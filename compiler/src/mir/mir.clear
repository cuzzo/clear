  MUTABLE sig: ?FunctionSignature@multiowned = functionSignature__unwrap(self.stdlib_def);
  IF sig EXISTS AS sig_value THEN
    MUTABLE sig_value_mutable = COPY sig_value;
    MUTABLE heap_return = (TRY (functionSignature__heap_return_alloc?(&sig_value_mutable)) == TRUE);
