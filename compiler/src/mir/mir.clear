  self.borrowed_view = COPY value;
END
FN blockExpr__body_slots(MUTABLE self: MIRBlockExpr) RETURNS ![]MIRBodySlot EFFECTS REENTRANT ->
  RETURN CAST([blockExpr__body_slot(self, :body, self.body, %(new_body: []Emittable) USE(MUTABLE self) -> {
  self.body = new_body;
  rubyToClearVoid()
  })] AS []MIRBodySlot);
END
FN blockExpr__body(self: MIRBlockExpr) RETURNS ![]Emittable ->
  RETURN COPY self.body;
END
FN blockExpr__ownership_effect(MUTABLE self: MIRBlockExpr) RETURNS !OwnershipEffect EFFECTS REENTRANT ->
  RETURN TRY (ownershipEffect__from_block_body(self.body, self.result_type, UNWRAP (self.borrowed_view)));
END
