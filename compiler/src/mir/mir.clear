  RETURN NIL;
END
FN bgBlock__compact_child_exprs(self: MIRBgBlock, values: []Any) RETURNS ![]Emittable ->
  MUTABLE children: []Emittable = ( { MUTABLE rtoc_empty_list_56: []Emittable = List[]; rtoc_empty_list_56 } );
  FOR _ IN values DO
  bgBlock__append_child_expr(self, &children, _);
  END
  RETURN children;
