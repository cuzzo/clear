  COPY self.lowered_node_id;
END
PUB FN mIRBgBlock__ownership_consumption(self: MIRBgBlock) RETURNS ?OwnershipConsumptionFact ->
  COPY self.ownership_consumption;
END
PUB FN mIRBgBlock__result_type(self: MIRBgBlock) RETURNS ?Type ->
  self.result_type;
END
