FN structDef__body_slots(MUTABLE self: MIRStructDef) RETURNS ![]MIRBodySlot EFFECTS REENTRANT ->
  IF !(self.methods) THEN
    MUTABLE empty_body_slots: []MIRBodySlot = [];
    RETURN empty_body_slots;
  END
  RETURN CAST([structDef__body_slot(self, :methods, self.methods, %(new_methods: []Emittable) USE(MUTABLE self) -> {
  self.methods = new_methods;
  rubyToClearVoid()
  })] AS []MIRBodySlot);
END
