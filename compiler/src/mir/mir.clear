}

FN ownershipConsumptionFact__names(self: OwnershipConsumptionFact) RETURNS ![]String ->
  MUTABLE names: []String = [];
  FOR operand IN self.operands DO
    IF operand.name EXISTS AS operand_name THEN
      IF !(operand_name.empty?()) THEN
        IF !(names.contains?(operand_name)) THEN
          &names.append(COPY operand_name);
        END
      END
    END
