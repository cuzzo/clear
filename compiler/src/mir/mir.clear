  RETURN self.const_visibility;
END
FN let__set_const_visibility(MUTABLE self: Let, value: ?String@symbol) RETURNS Void ->
  self.const_visibility = COPY value;
END
FN let__initialize(MUTABLE self: Let, name: String, init: Emittable, mutable_value: Bool, annotation: ?Type = NIL, suppression: ?String = NIL, alias_safe: ?Bool = NIL) RETURNS Void ->
  self.module_const = NIL;
  self.const_visibility = NIL;
END
