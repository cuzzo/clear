PUB STRUCT ExternTrampoline {
  lowered_node_id: ?LoweredNodeId,
  ownership_consumption: ?OwnershipConsumptionFact,
  id: Int64,
  callee_name: String,
  module_alias: ?String,
  method_name: ?String,
  receiver: ?Emittable,
  comptime_args: []Emittable,
  runtime_args: []ExternTrampolineArg,
  alloc_kind: ?String@symbol,
  return_type: Type,
  stdlib_def: FunctionSignature@multiowned
}

FN externTrampoline__child_exprs(self: ExternTrampoline) RETURNS ![]Emittable EFFECTS REENTRANT ->
  MUTABLE children: []Emittable = [];
  MUTABLE current_receiver: ?Emittable = COPY self.receiver;
  IF current_receiver EXISTS AS current_receiver_value THEN
    &children.append(current_receiver_value);
  END
  FOR _ IN self.comptime_args DO
  &children.append(COPY _);
  END
  FOR _ IN self.runtime_args DO
  &children.append(COPY _.expr);
  END
  RETURN externTrampoline__compact_child_exprs(self, children);
END
FN externTrampoline__ownership_effect(self: ExternTrampoline) RETURNS !OwnershipEffect EFFECTS REENTRANT ->
  MUTABLE heap_return = ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_234 = (KEEP self.stdlib_def);
  TRY (functionSignature__heap_return_alloc?(&rtoc_mutable_receiver_234)) } == TRUE);
  MUTABLE actual_return = TRY (type__success_type(self.return_type));
  IF type__resource?(actual_return) THEN
    RETURN ownershipEffect__owned(self.alloc_kind, :resource, FALSE);
  END
  RETURN TRY (ownershipEffect__from_callable_facts(({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_235 = (KEEP self.stdlib_def);
  TRY (functionSignature__emits_allocating?(&rtoc_mutable_receiver_235)) } == TRUE), &heap_return, ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_236 = (KEEP self.stdlib_def);
  TRY (functionSignature__fixed_return?(rtoc_local_receiver_236)) } AND type__void?(actual_return)), ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_237 = (KEEP self.stdlib_def);
  TRY (functionSignature__mutates_receiver?(&rtoc_mutable_receiver_237)) } AND !(heap_return)), NIL, self.return_type, self.alloc_kind, NIL));
END
FN externTrampoline__mir?(self: ExternTrampoline) RETURNS Bool ->
  RETURN TRUE;
END
FN externTrampoline__stmt?(self: ExternTrampoline) RETURNS Bool ->
  RETURN FALSE;
END
