FN program__without_try(self: MIRProgram) RETURNS Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY rtoc_self_view;
}
END
FN program__explicit_ownership_contract(self: MIRProgram) RETURNS ?OwnershipContract@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN NIL;
}
END
FN program__compact_child_exprs(self: MIRProgram, values: []Any) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE children: []Emittable = ( { MUTABLE rtoc_empty_list_199: []Emittable = List[]; rtoc_empty_list_199 } );
    FOR _ IN values DO
    program__append_child_expr(rtoc_self_view, &children, _);
    END
    RETURN children;
}
END
FN program__append_child_expr<T>(self: MIRProgram, MUTABLE children: []Emittable, value: T) RETURNS Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    COMPTIME IF T IS_A []@multiowned Any THEN
      FOR _ IN value DO
      program__append_child_expr(rtoc_self_view, &children, _);
      END
    ELSE_IF T IS_A Emittable THEN
      &children.append(value);
    END
    NIL;
}
END
FN program__body_slot(self: MIRProgram, name: String@symbol, body: []Emittable, writer: FN([]Emittable) -> Void) RETURNS MIRBodySlot@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN bodySlot__new(name, body, writer);
}
END
FN program__owned_effect_for_alloc(self: MIRProgram, alloc: ?String@symbol, cleanup_kind: String@symbol = :uniform) RETURNS OwnershipEffect
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ownershipEffect__owned(alloc, cleanup_kind);
}
END
FN program__new(items: []Emittable, pass_state: ?MIRPassState = NIL) RETURNS MIRProgram@multiowned ->
  MUTABLE self = MIRProgram{ items: COPY items, pass_state: COPY pass_state };
  program__initialize(&self, items, pass_state);
  RETURN self @multiowned;
END
