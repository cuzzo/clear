PUB STRUCT FailureAction {
  lowered_node_id: ?LoweredNodeId,
  ownership_consumption: ?OwnershipConsumptionFact,
  kind: FailureActionKind,
  error_type: String@symbol,
  error_kind: String@symbol,
  default_message: String,
  line: String,
  rt_name: String,
  with_label: ?String,
  message: ?Emittable,
  return_value: ?Emittable,
  body: []Emittable
}

FN failureAction__child_exprs(self: FailureAction) RETURNS ![]Emittable EFFECTS REENTRANT ->
  MUTABLE values: []Emittable = [];
  IF self.message EXISTS AS message_value THEN
    &values.append(COPY message_value);
  END
  IF self.return_value EXISTS AS return_value_value THEN
    &values.append(COPY return_value_value);
  END
  RETURN failureAction__compact_child_exprs(self, values);
END
FN failureAction__body_slots(MUTABLE self: FailureAction) RETURNS ![]MIRBodySlot EFFECTS REENTRANT ->
  IF !((self.kind == FailureActionKind.Block)) THEN
    RETURN CAST(( { MUTABLE rtoc_empty_list_206: []MIRBodySlot = List[]; rtoc_empty_list_206 } ) AS []MIRBodySlot);
  END
  RETURN CAST([failureAction__body_slot(self, :body, self.body, %(new_body: []Emittable) USE(MUTABLE self) -> {
  self.body = new_body;
  rubyToClearVoid()
  })] AS []MIRBodySlot);
END
FN failureAction__mir?(self: FailureAction) RETURNS Bool ->
  RETURN TRUE;
END
FN failureAction__stmt?(self: FailureAction) RETURNS Bool ->
  RETURN FALSE;
END
FN failureAction__expr?(self: FailureAction) RETURNS Bool ->
  RETURN FALSE;
END
FN failureAction__ownership_effect(self: FailureAction) RETURNS OwnershipEffect EFFECTS REENTRANT ->
  RETURN ownershipEffect__none();
END
FN failureAction__ownership_source_exprs(self: FailureAction) RETURNS ![]Emittable ->
  MUTABLE empty_child_exprs: []Emittable = [];
  RETURN empty_child_exprs;
END
FN failureAction__owned_position_source_exprs(self: FailureAction) RETURNS ![]Emittable ->
  MUTABLE empty_child_exprs: []Emittable = [];
  RETURN empty_child_exprs;
END
FN failureAction__without_try(self: FailureAction) RETURNS Emittable ->
  RETURN COPY self;
END
FN failureAction__explicit_ownership_contract(self: FailureAction) RETURNS ?OwnershipContract@multiowned EFFECTS REENTRANT ->
  RETURN NIL;
END
FN failureAction__compact_child_exprs(self: FailureAction, values: []Any) RETURNS ![]Emittable ->
  MUTABLE children: []Emittable = ( { MUTABLE rtoc_empty_list_207: []Emittable = List[]; rtoc_empty_list_207 } );
  FOR _ IN values DO
  failureAction__append_child_expr(self, &children, _);
  END
  RETURN children;
END
FN failureAction__append_child_expr<T>(self: FailureAction, MUTABLE children: []Emittable, value: T) RETURNS Void EFFECTS REENTRANT ->
  COMPTIME IF T IS_A []@multiowned Any THEN
    FOR _ IN value DO
    failureAction__append_child_expr(self, &children, _);
    END
  ELSE_IF T IS_A Emittable THEN
    &children.append(value);
  END
  RETURN NIL;
END
