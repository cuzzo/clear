PUB STRUCT Call {
  callee: String,
  args: []Emittable,
  try_wrap: Bool,
  owned_return: Bool,
  callable_contract: ?CallableContract@multiowned,
  lowered_node_id: ?LoweredNodeId,
  never_success: Bool,
  ownership_consumption: ?OwnershipConsumptionFact,
  result_type: ?Type
}

FN call__result_type(MUTABLE self: Call) RETURNS ?Type ->
  IF !(TRUE) THEN
    self.result_type = NIL;
  END
  RETURN COPY self.result_type;
END
FN call__set_result_type(MUTABLE self: Call, value: ?Type) RETURNS ?Type ->
  self.result_type = COPY value;
  RETURN COPY value;
END
FN call__initialize(MUTABLE self: Call, callee: String, args: []Emittable, try_wrap: Bool, owned_return: Bool = FALSE, callable_contract: ?CallableContract = NIL) RETURNS Void ->
  self.never_success = FALSE;
END
FN call__owned_return?(self: Call) RETURNS Bool ->
  RETURN (self.owned_return == TRUE);
END
FN call__never_success(self: Call) RETURNS Bool ->
  RETURN self.never_success;
END
FN call__set_never_success(MUTABLE self: Call, value: Bool) RETURNS Void ->
  self.never_success = COPY value;
END
FN call__child_exprs(self: Call) RETURNS ![]Emittable EFFECTS REENTRANT ->
  RETURN call__compact_child_exprs(self, [CAST(self.args AS Any)]);
END
FN call__explicit_ownership_contract(self: Call) RETURNS ?OwnershipContract@multiowned EFFECTS REENTRANT ->
  IF self.callable_contract != NIL THEN
  RETURN COPY ((self.callable_contract)?).ownership_contract @multiowned;
  ELSE
  RETURN NIL;
  END
END
FN call__without_try(MUTABLE self: Call) RETURNS !Call ->
  MUTABLE out = Call{ callee: COPY self.callee, args: COPY self.args, try_wrap: FALSE, owned_return: self.owned_return, callable_contract: COPY self.callable_contract, lowered_node_id: NIL, never_success: FALSE, ownership_consumption: NIL, result_type: NIL };
  out.never_success = self.never_success;
  IF self.result_type EXISTS AS result_type_value THEN
    MUTABLE result_type_value_mutable = COPY result_type_value;
    out.result_type = TRY (type__new(TypeConstructionInput{ Type: COPY result_type_value_mutable }));
  END
  IF self.ownership_consumption THEN
    out.ownership_consumption = self.ownership_consumption;
  END
  RETURN out;
END
FN call__ownership_effect(self: Call) RETURNS OwnershipEffect EFFECTS REENTRANT ->
  IF !(call__owned_return?(self)) THEN
    RETURN ownershipEffect__none();
  END
  MUTABLE alloc: String@symbol = :heap;
  FOR arg IN self.args DO
    IF arg IS_A AllocatorRef AS allocator_ref THEN
      alloc = COPY allocator_ref.kind;
    END
  END
  RETURN ownershipEffect__owned(alloc);
END
FN call__mir?(self: Call) RETURNS Bool ->
  RETURN TRUE;
END
FN call__stmt?(self: Call) RETURNS Bool ->
  RETURN FALSE;
END
FN call__ownership_source_exprs(self: Call) RETURNS ![]Emittable ->
  MUTABLE empty_child_exprs: []Emittable = [];
  RETURN empty_child_exprs;
END
FN call__owned_position_source_exprs(self: Call) RETURNS ![]Emittable ->
  MUTABLE empty_child_exprs: []Emittable = [];
  RETURN empty_child_exprs;
END
FN call__body_slots(self: Call) RETURNS ![]MIRBodySlot EFFECTS REENTRANT ->
  MUTABLE empty_body_slots: []MIRBodySlot = [];
  RETURN empty_body_slots;
END
FN call__compact_child_exprs(self: Call, values: []Any) RETURNS ![]Emittable ->
  MUTABLE children: []Emittable = ( { MUTABLE rtoc_empty_list_122: []Emittable = List[]; rtoc_empty_list_122 } );
  FOR _ IN values DO
  call__append_child_expr(self, &children, _);
  END
  RETURN children;
END
FN call__append_child_expr<T>(self: Call, MUTABLE children: []Emittable, value: T) RETURNS Void EFFECTS REENTRANT ->
  COMPTIME IF T IS_A []@multiowned Any THEN
    FOR _ IN value DO
    call__append_child_expr(self, &children, _);
    END
  ELSE_IF T IS_A Emittable THEN
    &children.append(value);
  END
  RETURN NIL;
END
FN call__body_slot(self: Call, name: String@symbol, body: []Emittable, writer: FN([]Emittable) -> Void) RETURNS MIRBodySlot@multiowned ->
  RETURN bodySlot__new(name, body, writer);
END
FN call__owned_effect_for_alloc(self: Call, alloc: ?String@symbol, cleanup_kind: String@symbol = :uniform) RETURNS OwnershipEffect ->
  RETURN ownershipEffect__owned(alloc, cleanup_kind);
END
FN call__expr?(self: Call) RETURNS Bool ->
  RETURN TRUE;
END
