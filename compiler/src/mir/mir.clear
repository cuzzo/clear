  self.result_type = COPY value;
END
FN blockExpr__borrowed_view(MUTABLE self: MIRBlockExpr) RETURNS Bool ->
  IF !(TRUE) THEN
    self.borrowed_view = NIL;
  END
  RETURN (self.borrowed_view == TRUE);
END
