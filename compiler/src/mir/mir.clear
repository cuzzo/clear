    &out.append(Emittable{ MoveMark: COPY MoveMark{ name: COPY self.name, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
  END
  RETURN out;
END
FN mIR__kept_edge_transfer_boundary(names: []String) RETURNS ![]Emittable ->
  MUTABLE unique_names: []String = [];
  FOR transfer_name IN names DO
    IF !(unique_names.contains?(transfer_name)) THEN
