PUB STRUCT FsmDestroyCleanup {
  source_kind: String@symbol,
  name: String,
  target: Emittable,
  cleanup_entry: CleanupEntry@multiowned,
  guard: ?Emittable,
  allocator: ?Emittable
}

FN fsmDestroyCleanup__destroy_order_bucket(self: FsmDestroyCleanup) RETURNS Int64 ->
  MUTABLE ranks: {String@symbol}Int64 = {:capture: 1, :fresh_heap: 1, :body: 2, :owned_result: 2};
  IF ranks[self.source_kind] EXISTS AS rank THEN
    RETURN rank;
  END
  RETURN 0;
END
FN fsmDestroyCleanup__destroy_order_index(self: FsmDestroyCleanup, index_value: Int64) RETURNS Int64 ->
  RETURN COPY index_value;
END
FN fsmDestroyCleanup__cleanup_name(self: FsmDestroyCleanup) RETURNS ?String ->
  RETURN COPY self.name;
END
FN fsmDestroyCleanup__ctx_cleanup_target_name(self: FsmDestroyCleanup) RETURNS ?String ->
  MUTABLE target_expr = COPY self.target;
  IF target_expr IS_A FieldGet AS field_get THEN
    MUTABLE object = field_get.object;
    IF object IS_A Ident AS ident THEN
      RETURN "${ident.name}.${field_get.field}";
    ELSE
      RETURN NIL;
    END
  ELSE
    RETURN NIL;
  END
END
PUB STRUCT FsmDestroyLockRelease {
  name: String,
  ctx_id: Int64,
  guard_index: Int64,
  lock_ref: Emittable,
  unlock_method: String
}

FN fsmDestroyLockRelease__guard_field(self: FsmDestroyLockRelease) RETURNS String ->
  RETURN "__lock_held_${self.guard_index.toString()}";
END
FN fsmDestroyLockRelease__destroy_order_bucket(self: FsmDestroyLockRelease) RETURNS Int64 ->
  RETURN 0;
END
FN fsmDestroyLockRelease__destroy_order_index(self: FsmDestroyLockRelease, index_value: Int64) RETURNS Int64 ->
  RETURN (-index_value);
END
FN fsmDestroyLockRelease__cleanup_name(self: FsmDestroyLockRelease) RETURNS ?String ->
  RETURN NIL;
END
FN fsmDestroyLockRelease__ctx_cleanup_target_name(self: FsmDestroyLockRelease) RETURNS ?String ->
  RETURN NIL;
END
PUB STRUCT FsmDestroyStmt {
  source_kind: String@symbol,
  name: String,
  stmt: Emittable
}

FN fsmDestroyStmt__destroy_order_bucket(self: FsmDestroyStmt) RETURNS Int64 ->
  MUTABLE ranks: {String@symbol}Int64 = {:capture: 1, :fresh_heap: 1, :body: 2, :owned_result: 2};
  IF ranks[self.source_kind] EXISTS AS rank THEN
    RETURN rank;
  END
  RETURN 2;
END
FN fsmDestroyStmt__destroy_order_index(self: FsmDestroyStmt, index_value: Int64) RETURNS Int64 ->
  RETURN COPY index_value;
END
FN fsmDestroyStmt__cleanup_name(self: FsmDestroyStmt) RETURNS ?String ->
  RETURN COPY self.name;
END
FN fsmDestroyStmt__ctx_cleanup_target_name(self: FsmDestroyStmt) RETURNS ?String ->
  MUTABLE current_stmt = COPY self.stmt;
  IF current_stmt IS_A RcRelease AS rc_release THEN
    MUTABLE source = rc_release.source;
    IF source IS_A FieldGet AS field_get THEN
      MUTABLE object = field_get.object;
      IF object IS_A Ident AS ident THEN
        RETURN "${ident.name}.${field_get.field}";
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
  ELSE
    RETURN NIL;
  END
END
