FN mIR__validate_defer_body_mut(body: DeferBodyInput, label: String) RETURNS !Void ->
  MUTABLE valid = FALSE;
  IF body IS_A []Emittable THEN
    valid = TRUE;
  ELSE_IF body IS_A Emittable THEN
    valid = TRUE;
  END
  IF valid THEN
    RETURN;
  END
  panic("{} body must be structural MIR, got {}");
END
