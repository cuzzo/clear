  self.result_type;
END

FN blockExpr__lazy_boundary(MUTABLE self: MIRBlockExpr) RETURNS Bool ->
  IF !(TRUE) THEN
    self.lazy_boundary = NIL;
  END
  RETURN (self.lazy_boundary == TRUE);
END
FN blockExpr__set_lazy_boundary(MUTABLE self: MIRBlockExpr, value: Bool) RETURNS Void ->
  self.lazy_boundary = COPY value;
END
FN blockExpr__result_type(MUTABLE self: MIRBlockExpr) RETURNS ?Type ->
  IF !(TRUE) THEN
    self.result_type = NIL;
  END
  RETURN COPY self.result_type;
END
