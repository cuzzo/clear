reeSlice, DestroyPtr: DestroyPtr, Cleanup: Cleanup, ErrCleanup: ErrCleanup, MoveMark: MoveMark, DeepCopy: DeepCopy, ContainerInit: ContainerInit, CapWrap: CapWrap, SharePromote: SharePromote, RcRetain: RcRetain, ComptimeCarrierPayload: ComptimeCarrierPayload, MonomorphicKeep: MonomorphicKeep, RcRelease: RcRelease, RcDowngrade: RcDowngrade, WeakUpgrade: WeakUpgrade, AllocatorRef: AllocatorRef, FreezeExpr: FreezeExpr, MakeList: MakeList, FrameSave: FrameSave, FrameRestore: FrameRestore, CapabilityUnwrap: CapabilityUnwrap, SnapshotRead: SnapshotRead, SnapshotTransaction: SnapshotTransaction, SnapshotMultiTxn: SnapshotMultiTxn, PolymorphicMutate: PolymorphicMutate, PolymorphicMutateFlow: PolymorphicMutateFlow, PolymorphicFlowSignal: PolymorphicFlowSignal, WithMatchDispatch: WithMatchDispatch, AllocMark: AllocMark, OwnedCreate: OwnedCreate, OwnedDestroy: OwnedDestroy, OwnedTransfer: OwnedTransfer, OwnedBorrow: OwnedBorrow, OwnedStore: OwnedStore, OwnedReturn: OwnedReturn, ReturnMark: ReturnMark, TransferMark: TransferMark, ReassignMark: ReassignMark, FieldCleanupMark: FieldCleanupMark, Call: Call, RuntimeCall: RuntimeCall, TailCall: TailCall, MIRMethodCall: MIRMethodCall, FieldGet: FieldGet, UnionPayloadGet: UnionPayloadGet, IndexGet: IndexGet, ProtocolCall: ProtocolCall, MIRBinOp: MIRBinOp, MIRUnaryOp: MIRUnaryOp, FallibleOk: FallibleOk, FutureReady: FutureReady, Lit: Lit, SymbolLit: SymbolLit, VoidLiteral: VoidLiteral, DefaultValue: DefaultValue, EnumTag: EnumTag, EnumOrdinal: EnumOrdinal, Ident: Ident, TupleLiteral: TupleLiteral, FnRef: FnRef, LockAcquire: LockAcquire, TypeOf: TypeOf, TypeEq: TypeEq, StructInit: StructInit, ArrayInit: ArrayInit, ArrayDefaultInit: ArrayDefaultInit, SliceExpr: SliceExpr, MIRBlockExpr: MIRBlockExpr, ConcatStr: ConcatStr, MIRCast: MIRCast, TryExpr: TryExpr, TryCatch: TryCatch, Orelse: Orelse, Conditional: Conditional, IfOptional: IfOptional, Comptime: Comptime, UnionVariantGet: UnionVariantGet, ListItems: ListItems, ListLength: ListLength, AddressOf: AddressOf, Deref: Deref, PointerCast: PointerCast, ConstCast: ConstCast, DefaultStreamCapacity: DefaultStreamCapacity, NextPromiseList: NextPromiseList, Undef: Undef, TypeSentinel: TypeSentinel, IterRange: IterRange, MIROptionalUnwrap: MIROptionalUnwrap, TryOptional: TryOptional, ForeignOwnedUnwrap: ForeignOwnedUnwrap, ForeignSliceView: ForeignSliceView, MIRRangeLit: MIRRangeLit, HasField: HasField, ItemsAccess: ItemsAccess, OwnedSlice: OwnedSlice, LambdaExpr: LambdaExpr, Pipeline: Pipeline, RegistryCall: RegistryCall, IndexedStore: IndexedStore, CFunctionAdapter: CFunctionAdapter, ExternTrampoline: ExternTrampoline, ObservableConsumerSpawn: ObservableConsumerSpawn, ShardConcurrentEach: ShardConcurrentEach, InlineBc: InlineBc, OrElseExitBcRewrite: OrElseExitBcRewrite, ShardedMapPut: ShardedMapPut, ShardedMapGet: ShardedMapGet }
PUB UNION NodeRoot { Emittable: Emittable, ArrayValue: []Emittable }
PUB UNION DeferBody { Emittable: Emittable, ArrayValue: []Emittable }
PUB UNION DeferBodyInput { Emittable: Emittable, ArrayValue: []Emittable, StringValue: String }
PUB UNION FsmBody { FsmIoBody: FsmIoBody, FsmB1Body: FsmB1Body, FsmGenericBody: FsmGenericBody }
PUB UNION BgBlockPlan { BgStackfulPlan: BgStackfulPlan, BgStreamPlan: BgStreamPlan, FutureMapPlan: FutureMapPlan, FsmIoBody: FsmIoBody, FsmB1Body: FsmB1Body, FsmGenericBody: FsmGenericBody }
PUB UNION NamedMirFieldValue { StringValue: String, SymbolValue: String@symbol, Emittable: Emittable }
PUB UNION StructInitFieldValue { StringValue: String, SymbolValue: String@symbol, Emittable: Emittable }
PUB UNION StructInitFieldInput { StructInitField: StructInitField, HashMapValue: {String@symbol}NamedMirFieldValue }
PUB STRUCT FnDef {
  name: String,
  params: []MIRParam,
  ret_type: Any@multiowned,
  body: []Emittable,
  visibility: String@symbol,
  can_fail: Any@multiowned,
  comptime_params: Any@multiowned,
  lowered_node_id: ?LoweredNodeId,
  ownership_consumption: ?OwnershipConsumptionFact,
  source_column: ?Int64,
  source_line: ?Int64
}

FN fnDef__params(self: FnDef) RETURNS ![]MIRParam ->
  RETURN COPY self.params;
END
FN fnDef__has_own_frame?(self: FnDef) RETURNS Bool ->
  RETURN TRUE;
END
FN fnDef__body_slots(MUTABLE self: FnDef) RETURNS ![]MIRBodySlot EFFECTS REENTRANT ->
  RETURN CAST([fnDef__body_slot(self, :body, self.body, %(new_body: []Emittable) USE(MUTABLE self) -> {
  self.body = new_body;
  rubyToClearVoid()
  })] AS []MIRBodySlot);
END
FN fnDef__body(self: FnDef) RETURNS ![]Emittable ->
  RETURN COPY self.body;
END
FN fnDef__mir?(self: FnDef) RETURNS Bool ->
  RETURN TRUE;
END
FN fnDef__expr?(self: FnDef) RETURNS Bool ->
  RETURN FALSE;
END
FN fnDef__ownership_effect(self: FnDef) RETURNS OwnershipEffect EFFECTS REENTRANT ->
  RETURN ownershipEffect__none();
END
FN fnDef__child_exprs(self: FnDef) RETURNS ![]Emittable EFFECTS REENTRANT ->
  MUTABLE empty_child_exprs: []Emittable = [];
  RETURN empty_child_exprs;
END
FN fnDef__ownership_source_exprs(self: FnDef) RETURNS ![]Emittable ->
  MUTABLE empty_child_exprs: []Emittable = [];
  RETURN empty_child_exprs;
END
FN fnDef__owned_position_source_exprs(self: FnDef) RETURNS ![]Emittable ->
  MUTABLE empty_child_exprs: []Emittable = [];
  RETURN empty_child_exprs;
END
FN fnDef__without_try(self: FnDef) RETURNS Emittable ->
  RETURN COPY self;
END
FN fnDef__explicit_ownership_contract(self: FnDef) RETURNS ?OwnershipContract@multiowned EFFECTS REENTRANT ->
  RETURN NIL;
END
FN fnDef__compact_child_exprs(self: FnDef, values: []Any) RETURNS ![]Emittable ->
  MUTABLE children: []Emittable = ( { MUTABLE rtoc_empty_list_1: []Emittable = List[]; rtoc_empty_list_1 } );
  FOR _ IN values DO
  fnDef__append_child_expr(self, &children, _);
  END
  RETURN children;
END
FN fnDef__append_child_expr<T>(self: FnDef, MUTABLE children: []Emittable, value: T) RETURNS Void EFFECTS REENTRANT ->
  COMPTIME IF T IS_A []@multiowned Any THEN
    FOR _ IN value DO
    fnDef__append_child_expr(self, &children, _);
    END
  ELSE_IF T IS_A Emittable THEN
    &children.append(value);
  END
  RETURN NIL;
END
FN fnDef__body_slot(self: FnDef, name: String@symbol, body: []Emittable, writer: FN([]Emittable) -> Void) RETURNS MIRBodySlot@multiowned ->
  RETURN bodySlot__new(name, body, writer);
END
FN fnDef__owned_effect_for_alloc(self: FnDef, alloc: ?String@symbol, cleanup_kind: String@symbol = :uniform) RETURNS OwnershipEffect ->
  RETURN ownershipEffect__owned(alloc, cleanup_kind);
END
FN fnDef__stmt?(self: FnDef) RETURNS Bool ->
  RETURN TRUE;
END
