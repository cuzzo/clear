  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.items = COPY items;
    rtoc_self_view.pass_state = COPY pass_state;
}
END
FN program__mir_pass_state(self: MIRProgram) RETURNS ?MIRPassState@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN KEEP rtoc_self_view.pass_state;
}
END
FN program__set_mir_pass_state(MUTABLE self: MIRProgram, state: ?MIRPassState) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.pass_state = COPY state;
}
END
