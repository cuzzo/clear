END
FN ifStmt__body_slots(MUTABLE self: IfStmt) RETURNS ![]MIRBodySlot EFFECTS REENTRANT ->
  MUTABLE slots: []MIRBodySlot = [ifStmt__body_slot(self, :then_body, self.then_body, %(new_body: []Emittable) USE(MUTABLE self) -> {
  self.then_body = new_body;
  rubyToClearVoid()
  })];
  IF self.else_body THEN
    &slots.append(ifStmt__body_slot(self, :else_body, self.else_body, %(new_body: []Emittable) USE(MUTABLE self) -> {
  self.else_body = new_body;
  rubyToClearVoid()
    }));
  END
  RETURN slots;
END
