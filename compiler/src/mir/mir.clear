FN withMatchDispatch__body_slots(self: WithMatchDispatch) RETURNS ![]MIRBodySlot EFFECTS REENTRANT ->
  MUTABLE slots: []MIRBodySlot = ( { MUTABLE rtoc_empty_list_108: []MIRBodySlot = List[]; rtoc_empty_list_108 } );
  IF TRUE THEN
      MUTABLE rtoc_each_items_109 = COPY self.arms;
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < rtoc_each_items_109.length() DO
      &slots.append(withMatchDispatch__body_slot(self, symbol("arms_${rtoc_idx.toString()}"), UNWRAP (rtoc_each_items_109[rtoc_idx]).body, %(new_body: []Emittable) USE(MUTABLE self, rtoc_idx) -> {
        MUTABLE rtoc_slot_arm = COPY UNWRAP (self.arms[rtoc_idx]);
        rtoc_slot_arm.body = new_body;
        self.arms[rtoc_idx] = rtoc_slot_arm;
        rubyToClearVoid()
      }));
      rtoc_idx = rtoc_idx + 1;
      END
  END
  RETURN slots;
END
