# Ruby module MIR::StdlibDefFsCoercion prepends a coercing setter so an
# untyped registry hash becomes a FunctionSignature on assignment. These
# carriers declare the field as FunctionSignature, so there is nothing to
# coerce.
# End Ruby module MIR
FN castCaptureToNamedMirFieldValue(value: MirCapture) RETURNS NamedMirFieldValue ->
  PARTIAL MATCH value START
    MirCapture.StringValue AS cast_payload -> RETURN NamedMirFieldValue{ StringValue: COPY cast_payload };,
    MirCapture.SymbolValue AS cast_payload -> RETURN NamedMirFieldValue{ SymbolValue: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to NamedMirFieldValue");
  END
  panic("Invalid cast to NamedMirFieldValue");
END
FN castDeferBodyToEmittable(value: DeferBody) RETURNS []Emittable ->
  IF value IS_A []Emittable AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN List[];
END
FN castNameToStringSymbol(value: Name) RETURNS String@symbol ->
  IF value IS_A String@symbol AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to String@symbol");
END
FN castOptionalNamedMirFieldValueToOptionalEmittable(value: ?NamedMirFieldValue) RETURNS ?Emittable ->
  IF value != NIL THEN
    IF value IS_A Emittable AS cast_payload THEN
      RETURN cast_payload;
    END
  END
  RETURN NIL;
END
FN castOptionalNamedMirFieldValueToOptionalStringSymbol(value: ?NamedMirFieldValue) RETURNS ?String@symbol ->
  IF value != NIL THEN
    IF value IS_A String@symbol AS cast_payload THEN
      RETURN cast_payload;
    END
  END
  RETURN NIL;
END
FN rubyToClearVoid() RETURNS Void ->
  RETURN;
END
FN ruby_array_concat_MIRBodySlot(left: []MIRBodySlot, right: []MIRBodySlot) RETURNS []MIRBodySlot ->
  MUTABLE result: []MIRBodySlot = [];
  FOR slot IN left DO
    &result.append(COPY slot);
  END
  FOR slot IN right DO
    &result.append(COPY slot);
  END
  RETURN result;
END
FN ruby_wrap_optional_String_symbol_MIRReturnValue(value: ?String@symbol) RETURNS ?MIRReturnValue ->
  IF value EXISTS AS optional_payload THEN
    RETURN MIRReturnValue{ SymbolValue: COPY optional_payload };
  END
  RETURN NIL;
END
FN ruby_wrap_optional_String_symbol_StructInitFieldValue(value: ?String@symbol) RETURNS ?StructInitFieldValue ->
  IF value EXISTS AS optional_payload THEN
    RETURN StructInitFieldValue{ SymbolValue: COPY optional_payload };
  END
  RETURN NIL;
END

FN emittable__explicit_ownership_contract(value: Emittable) RETURNS !?OwnershipContract@multiowned EFFECTS REENTRANT ->
  PARTIAL MATCH value START
    Emittable.FnDef AS payload -> RETURN fnDef__explicit_ownership_contract(payload);,
    Emittable.ProtocolAdapterDef AS payload -> RETURN protocolAdapterDef__explicit_ownership_contract(payload);,
    Emittable.FieldDef AS payload -> RETURN fieldDef__explicit_ownership_contract(payload);,
    Emittable.UnionTypeDef AS payload -> RETURN unionTypeDef__explicit_ownership_contract(payload);,
    Emittable.Import AS payload -> RETURN import__explicit_ownership_contract(payload);,
    Emittable.TypeAlias AS payload -> RETURN typeAlias__explicit_ownership_contract(payload);,
    Emittable.CExternFnDecl AS payload -> RETURN cExternFnDecl__explicit_ownership_contract(payload);,
    Emittable.CExternStructDef AS payload -> RETURN cExternStructDef__explicit_ownership_contract(payload);,
    Emittable.ModuleNamespace AS payload -> RETURN moduleNamespace__explicit_ownership_contract(payload);,
    Emittable.TestDef AS payload -> RETURN testDef__explicit_ownership_contract(payload);,
    Emittable.Let AS payload -> RETURN TRY (let__explicit_ownership_contract(payload));,
    Emittable.Set AS payload -> RETURN set__explicit_ownership_contract(payload);,
