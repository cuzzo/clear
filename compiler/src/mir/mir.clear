FN let__explicit_ownership_contract(self: Let) RETURNS !?OwnershipContract@multiowned EFFECTS REENTRANT ->
  IF TRUE THEN
    RETURN TRY (emittable__explicit_ownership_contract(self.init));
  ELSE
    RETURN NIL;
  END
END
