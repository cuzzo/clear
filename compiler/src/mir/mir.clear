  MUTABLE children: []Emittable = ( { MUTABLE rtoc_empty_list_26: []Emittable = List[]; rtoc_empty_list_26 } );
  FOR _ IN values DO
  switchStmt__append_child_expr(self, &children, _);
  END
  RETURN children;
