PUB UNION MirCapture { StringValue: String, SymbolValue: String@symbol }
PUB UNION EnumDefReturnValue { StringValue: String, SymbolValue: String@symbol }
PUB UNION MIRReturnValue { StringValue: String, SymbolValue: String@symbol }
PUB UNION MutualThunkArmReturnValue { StringValue: String, ArrayValue: []ThunkBaseCase, ArrayValue2: []ThunkFrameInit }
PUB UNION StructDefReturnValue { StringValue: String, SymbolValue: String@symbol }
PUB UNION ThunkFrameInitReturnValue { StringValue: String, Emittable: Emittable }
PUB UNION ThunkVariantReturnValue { StringValue: String, ArrayValue: []ThunkFrameField }
PUB UNION TypeAliasReturnValue { StringValue: String, SymbolValue: String@symbol }
PUB UNION UnionTypeDefReturnValue { StringValue: String, SymbolValue: String@symbol }
PUB UNION UnionTypeVariantReturnValue { StringValue: String, SymbolValue: String@symbol }
# Ruby module MIR
