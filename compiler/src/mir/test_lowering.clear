REQUIRE "pkg:rtoc_6173742f747970652e636c656172" AS type
REQUIRE "pkg:rtoc_6d69722f6d69722e636c656172" AS mir
REQUIRE "pkg:rtoc_6173742f6173742e636c656172" AS ast
REQUIRE "pkg:rtoc_6173742f6c657865722e636c656172" AS lexer
REQUIRE "pkg:rtoc_6d69722f6d69725f6c6f776572696e672e636c656172" AS mir_lowering
# Ruby module TestLowering
PUB UNION AstIdentifierSearchNode { ASTProgram: ASTProgram, RequireNode: RequireNode, ProtocolRequirement: ProtocolRequirement, ProtocolDef: ProtocolDef, FunctionDefMultiowned: FunctionDef@multiowned, ImplementationDef: ImplementationDef, ConformanceDef: ConformanceDef, MIRStructDef: MIRStructDef, VarDecl: VarDecl, Assignment: Assignment, MIRDestructureTarget: MIRDestructureTarget, DestructuringAssignment: DestructuringAssignment, BindExpr: BindExpr, BinaryOp: BinaryOp, IsA: IsA, MIRUnaryOp: MIRUnaryOp, CallSiteOverride: CallSiteOverride, Identifier: Identifier, Literal: Literal, ListLit: ListLit, TupleLit: TupleLit, DefaultArrayLit: DefaultArrayLit, HashLit: HashLit, DefaultLit: DefaultLit, StructLit: StructLit, LambdaLit: LambdaLit, IfStatement: IfStatement, IfBind: IfBind, WhileLoop: WhileLoop, WhileBindLoop: WhileBindLoop, BreakNode: BreakNode, ContinueNode: ContinueNode, FuncCall: FuncCall, MIRMethodCall: MIRMethodCall, GetField: GetField, GetIndex: GetIndex, MIRCast: MIRCast, ReturnNode: ReturnNode, Assert: Assert, TenseRecoveryRaise: TenseRecoveryRaise, ThrowNode: ThrowNode, DieNode: DieNode, Slice: Slice, Require: Require, MIRDeferStmt: MIRDeferStmt, WithBlockMultiowned: WithBlock@multiowned, SyncPolicyDecl: SyncPolicyDecl, SelectOpMultiowned: SelectOp@multiowned, WhereOpMultiowned: WhereOp@multiowned, IndexOpMultiowned: IndexOp@multiowned, ReduceOpMultiowned: ReduceOp@multiowned, OrderByOpMultiowned: OrderByOp@multiowned, LimitOp: LimitOp, UnnestOpMultiowned: UnnestOp@multiowned, DistinctOpMultiowned: DistinctOp@multiowned, EachOp: EachOp, TapOp: TapOp, SkipOp: SkipOp, CollectOp: CollectOp, TakeWhileOpMultiowned: TakeWhileOp@multiowned, WindowOpMultiowned: WindowOp@multiowned, BatchWindowOpMultiowned: BatchWindowOp@multiowned, JoinOp: JoinOp, FindOpMultiowned: FindOp@multiowned, AnyOpMultiowned: AnyOp@multiowned, AllOpMultiowned: AllOp@multiowned, CountOpMultiowned: CountOp@multiowned, SumOpMultiowned: SumOp@multiowned, AverageOpMultiowned: AverageOp@multiowned, MinOpMultiowned: MinOp@multiowned, MaxOpMultiowned: MaxOp@multiowned, ShardOp: ShardOp, ConcurrentOp: ConcurrentOp, Placeholder: Placeholder, Copy: Copy, MIROptionalUnwrap: MIROptionalUnwrap, TenseNavigation: TenseNavigation, MutableBorrow: MutableBorrow, TenseOperationKindOrElseRaise: TenseOperationKindOrElseRaise, TenseOperationKindOrElseExit: TenseOperationKindOrElseExit, TenseOperationKindOrElsePass: TenseOperationKindOrElsePass, TenseOperationKindOrElsePrune: TenseOperationKindOrElsePrune, TenseOperationKindOrElseBreak: TenseOperationKindOrElseBreak, CatchBlock: CatchBlock, RecoverOp: RecoverOp, MIRBlockExpr: MIRBlockExpr, StringConcat: StringConcat, CapabilityWrap: CapabilityWrap, MoveNode: MoveNode, CopyNode: CopyNode, KeepNode: KeepNode, ShareNode: ShareNode, LinkNode: LinkNode, ResolveNode: ResolveNode, FreezeNode: FreezeNode, PassStmt: PassStmt, StructPattern: StructPattern, MIRRangeLit: MIRRangeLit, ExternFnDecl: ExternFnDecl, ExternStructDecl: ExternStructDecl, MIREnumDef: MIREnumDef, UnionDef: UnionDef, UnionVariantLit: UnionVariantLit, StaticCall: StaticCall, MIRDoBlock: MIRDoBlock, MIRBgBlock: MIRBgBlock, ThenChain: ThenChain, BgStreamBlock: BgStreamBlock, YieldExpr: YieldExpr, CloseStream: CloseStream, NextExpr: NextExpr, MatchStatement: MatchStatement, ForRange: ForRange, ForEach: ForEach, TestBlock: TestBlock, WhenBlock: WhenBlock, LetBinding: LetBinding, TestThat: TestThat, AssertRaisesMultiowned: AssertRaises@multiowned, BenchmarkStmtMultiowned: BenchmarkStmt@multiowned, SmashStmtMultiowned: SmashStmt@multiowned, ProfileStmtMultiowned: ProfileStmt@multiowned, StubDecl: StubDecl, Drop: Drop, SuppressCleanup: SuppressCleanup, Return: Return, ReassignCleanup: ReassignCleanup, FieldCleanup: FieldCleanup, ArrayValue: []Node, TokenMultiowned: Token@multiowned, SymbolValue: String@symbol, StringValue: String, Float64Value: Float64, BoolValue: Bool, TypeMultiowned: Type@multiowned, FunctionDef: FunctionDef, WithBlock: WithBlock, SelectOp: SelectOp, WhereOp: WhereOp, IndexOp: IndexOp, ReduceOp: ReduceOp, OrderByOp: OrderByOp, UnnestOp: UnnestOp, DistinctOp: DistinctOp, TakeWhileOp: TakeWhileOp, WindowOp: WindowOp, BatchWindowOp: BatchWindowOp, FindOp: FindOp, AnyOp: AnyOp, AllOp: AllOp, CountOp: CountOp, SumOp: SumOp, AverageOp: AverageOp, MinOp: MinOp, MaxOp: MaxOp, AssertRaises: AssertRaises, BenchmarkStmt: BenchmarkStmt, SmashStmt: SmashStmt, ProfileStmt: ProfileStmt, Token: Token, Type: Type }
PUB UNION StubInfoValue { SymbolValue: String@symbol, StringValue: String }
PUB STRUCT TestBlockCtx {
  lowering: MIRLowering,
  setup_mir: []Emittable,
  test_after_each_mir: [List, List]Emittable,
  test_before_each_mir: [List, List]Emittable,
  test_block: TestBlock,
  test_name: String
}

PUB FN testBlockCtx__initialize(MUTABLE self: TestBlockCtx, test_block: TestBlock, lowering: MIRLowering) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.test_block = COPY test_block;
    rtoc_self_view.test_name = COPY test_block.name;
    rtoc_self_view.lowering = COPY lowering;
    rtoc_self_view.setup_mir = TRY (mIRLowering__lower_body(&lowering, test_block.setup));
    rtoc_self_view.test_before_each_mir = (((test_block.before_each OR List[]))) |> SELECT TRY (mIRLowering__lower_body(&lowering, _));
    rtoc_self_view.test_after_each_mir = (((test_block.after_each OR List[]))) |> SELECT TRY (mIRLowering__lower_body(&lowering, _));
}
END
PUB FN testBlockCtx__fresh_preamble(self: TestBlockCtx) RETURNS TestPreamble
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TestPreamble{ unused: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
}
END
PUB FN testBlockCtx__emit_all_hooks(MUTABLE self: TestBlockCtx, bodies: [List, List]Locatable, name_kind: String, desc_prefix: String, MUTABLE tests: []TestDef) RETURNS ![]TestDef
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < bodies.length() DO
      MUTABLE name = "${rtoc_self_view.test_name}: ${desc_prefix}${name_kind}_${(rtoc_idx + 1)}";
      &tests.append(TestDef{ name: name, body: COPY ([testBlockCtx__fresh_preamble(rtoc_self_view)] + TRY (mIRLowering__lower_body(&rtoc_self_view.lowering, bodies[rtoc_idx]?))), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, needs_scheduler: NIL });
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN COPY tests;
}
END
PUB FN testBlockCtx__new(test_block: TestBlock, lowering: MIRLowering) RETURNS TestBlockCtx@multiowned ->
  MUTABLE self = TestBlockCtx{ lowering: COPY lowering, setup_mir: List[], test_after_each_mir: List[], test_before_each_mir: List[], test_block: COPY test_block, test_name: "" };
  testBlockCtx__initialize(&self, test_block, lowering);
  RETURN self @multiowned;
END
PUB STRUCT TestThatEnv {
  ctx: Any@multiowned,
  when_block: Any@multiowned,
  when_desc: Any@multiowned,
  tag_suffix: Any@multiowned,
  stub_mir: Any@multiowned,
  when_setup_mir: Any@multiowned,
  when_before_each_mir: Any@multiowned,
  when_after_each_mir: Any@multiowned,
  let_ast_map: Any@multiowned
}
# End Ruby module TestLowering
