    RETURN CAST([Emittable{ Let: COPY key_let }, Emittable{ ExprStmt: COPY TRY (pipelineSetIndexLowerer__distinct_insert_stmt(self, alloc, Emittable{ Ident: COPY Ident{ name: "dist_key", lowered_node_id: NIL, ownership_consumption: NIL } }, uses_allocator)) }] AS []Emittable);
  END
