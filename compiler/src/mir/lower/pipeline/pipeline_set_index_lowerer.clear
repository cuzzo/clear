PUB FN pipelineSetIndexLowerer__lower_index(self: PipelineSetIndexLowerer, MUTABLE list_node: Locatable, smooth_node: BinaryOp, expr_node: Locatable) RETURNS !MIRBlockExpr ->
  MUTABLE elem_zig: String = "";
