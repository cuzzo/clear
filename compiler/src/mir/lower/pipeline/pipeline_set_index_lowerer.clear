  IF range_chain EXISTS AS range_chain_value THEN
    MUTABLE range_chain_value_mutable = COPY range_chain_value;
    RETURN TRY (pipelineSetIndexLowerer__lower_range_distinct(self, range_chain_value_mutable, &smooth_node, distinct_node, set_zig, alloc));
  END
  MUTABLE insert_body = TRY (pipelineSetIndexLowerer__distinct_insert_body(self, expr_mir, distinct_node.expression, elem_type, elem_zig, alloc, TRUE));
  RETURN pipelineSetIndexLowerer__pipeline_block_call(self, list_node, %(items, label) USE(alloc, insert_body, set_zig, MUTABLE smooth_node, self) -> {
  rtoc_lambda_result_1 = (TRY (pipelineSetIndexLowerer__distinct_set_alloc_stmts(self, &smooth_node, set_zig, alloc)) + [ForStmt{ iter: Emittable{ Ident: COPY Ident{ name: COPY items, lowered_node_id: NIL, ownership_consumption: NIL } }, capture: "it", body: Body{ ArrayValue: insert_body |> SELECT castEmittableToLocatable(_) }, index_capture: NIL, mark_per_iter: NIL, tight: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }] + TRY (pipelineSetIndexLowerer__distinct_set_transfer_marks(self, alloc)) + [BreakStmt{ label: label, value: Emittable{ Ident: COPY Ident{ name: "dist_set", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }]);
  rtoc_lambda_result_1
  });
