    RETURN stmts;
  ELSE
    RETURN CAST([Emittable{ Let: COPY key_let }, Emittable{ ExprStmt: COPY TRY (pipelineSetIndexLowerer__distinct_insert_stmt(self, alloc, owned_value, uses_allocator)) }] AS []Emittable);
  END
END
