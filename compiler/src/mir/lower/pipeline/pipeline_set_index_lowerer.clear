  END;
  IF ((pipelineSetIndexLowerer__bc_target_call(self) AND range_chain.source IS_A Identifier) AND TRY (type__runtime_stream?(source_type))) THEN
    RETURN MIRBlockExpr{ label: label, body: COPY (TRY (pipelineLazyRangePrefix__outer_setup_stmts(prefix)) + [Let{ name: COPY "dist_set", init: Emittable{ ContainerInit: COPY ContainerInit{ zig_type: COPY set_zig, strategy: :set_empty, alloc: NIL, capacity: NIL, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }, TRY (pipelineLazyRangePrefix__loop_stmt(prefix, pipelineSetIndexLowerer__visit_mir_call(self, range_chain.source), [Emittable{ Let: COPY Let{ name: COPY "dist_key", init: COPY key_expr_mir, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }, Emittable{ ExprStmt: COPY TRY (pipelineSetIndexLowerer__distinct_insert_stmt(self, alloc, Emittable{ Ident: COPY Ident{ name: "dist_key", lowered_node_id: NIL, ownership_consumption: NIL } }, FALSE)) }])), BreakStmt{ label: label, value: Emittable{ Ident: COPY Ident{ name: "dist_set", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }]), lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
