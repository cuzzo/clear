PUB FN pipelineSetIndexLowerer__lower_distinct(self: PipelineSetIndexLowerer, list_node: Locatable, MUTABLE smooth_node: BinaryOp, distinct_node: DistinctOp) RETURNS !MIRBlockExpr ->
