  IF fact EXISTS AS fact_value THEN
    fact_value.mark.scope = IF placement__heap?(fact_value.alloc) THEN
      :heap
    ELSE
      :function
    END;
    MUTABLE entry: ?CleanupEntry@multiowned = COPY KEEP fact_value.cleanup_entry;
    MUTABLE stmts: []Emittable = [Emittable{ Let: COPY key_let }, Emittable{ AllocMark: COPY fact_value.mark }, Emittable{ Let: COPY Let{ name: COPY temp_name, init: COPY owned_value, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }];
    IF entry EXISTS AS entry_value THEN
      &stmts.append(Emittable{ ErrCleanup: COPY ErrCleanup{ name: temp_name, cleanup_entry: cleanupEntry__with_moved_guard(entry_value), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    END
    &stmts.append(Emittable{ ExprStmt: COPY TRY (pipelineSetIndexLowerer__distinct_insert_stmt(self, alloc, Emittable{ Ident: COPY Ident{ name: COPY temp_name, lowered_node_id: NIL, ownership_consumption: NIL } }, uses_allocator, ownershipOperandFact__owned_binding(temp_name, elem_type, "DISTINCT insert transfers the key to the set", alloc))) });
