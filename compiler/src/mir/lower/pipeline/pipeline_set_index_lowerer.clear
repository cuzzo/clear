PRIVATE FN pipelineSetIndexLowerer__bc_index_iter(self: PipelineSetIndexLowerer, range_source: Locatable) RETURNS ?Emittable ->
  IF range_source IS_A RangeLit THEN
    MUTABLE start_mir = pipelineSetIndexLowerer__visit_mir_call(self, range_source.start);
    MUTABLE end_mir = pipelineSetIndexLowerer__visit_mir_call(self, range_source.finish);
    MUTABLE end_expr_branch_value: ?BinOp = NIL;
    IF range_source.inclusive THEN
      end_expr_branch_value = BinOp{ op: "+", left: COPY end_mir, right: Emittable{ Lit: COPY Lit{ value: "1", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL };
    ELSE
      end_expr_branch_value = end_mir;
    END
    MUTABLE end_expr: BinOp = end_expr_branch_value?;
    RETURN Emittable{ IterRange: COPY IterRange{ start: start_mir, end_val: end_expr, capture_type: :i64, lowered_node_id: NIL, ownership_consumption: NIL } };
  END
  IF range_source IS_A Identifier AS identifier THEN
    RETURN pipelineSetIndexLowerer__visit_mir_call(self, identifier);
  END
  RETURN NIL;
END
PRIVATE FN pipelineSetIndexLowerer__index_result_let(self: PipelineSetIndexLowerer, map_type: String, alloc: String@symbol) RETURNS !Let ->
  RETURN Let{ name: COPY "idx_result", init: Emittable{ StructInit: COPY StructInit{ zig_type: NIL, fields: [CAST(StructInitField{ name: symbol("alloc"), value: Emittable{ AllocatorRef: COPY AllocatorRef{ kind: COPY alloc, lowered_node_id: NIL, ownership_consumption: NIL } }, alloc: NIL } AS Any)], lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: COPY TRY (type__new(TypeConstructionInput{ StringValue: COPY map_type })), suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL };
END
PRIVATE FN pipelineSetIndexLowerer__build_index_gop_body(self: PipelineSetIndexLowerer, expr_mir: Emittable, alloc: String@symbol, item_var: String, expr_node: ?Locatable, item_type: ?Type, value_ownership: PipelineIndexValueOwnership) RETURNS ![]Emittable ->
  MUTABLE elem_zig_type = "@TypeOf(${item_var})";
  MUTABLE prepared = TRY (pipelineSetIndexLowerer__index_prepared_value(self, item_var, elem_zig_type, alloc, item_type, value_ownership));
  MUTABLE insert = IndexInsert{ map: Emittable{ Ident: COPY Ident{ name: "idx_result", lowered_node_id: NIL, ownership_consumption: NIL } }, key_expr: Emittable{ Ident: COPY Ident{ name: "idx_key", lowered_node_id: NIL, ownership_consumption: NIL } }, value_expr: COPY prepared.value, key_zig_type: "u8", elem_zig_type: elem_zig_type, alloc: COPY alloc, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
  MUTABLE owned_insert = pipelineSetIndexLowerer__pipeline_index_insert_with_ownership_call(self, insert, prepared.value, prepared.owns_heap, alloc);
  MUTABLE body: []Emittable = (CAST([Emittable{ Let: COPY Let{ name: COPY "idx_key", init: COPY expr_mir, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }] AS []Emittable) + COPY prepared.setup_stmts + CAST([Emittable{ IndexInsert: COPY owned_insert }] AS []Emittable));
  MUTABLE entry: ?CleanupEntry@multiowned = (KEEP self.pipeline_owned_cleanup_entry)(expr_mir, expr_node);
  IF entry EXISTS AS entry_value THEN
    &body.append(Emittable{ Cleanup: COPY Cleanup{ name: "idx_key", cleanup_entry: entry_value, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
  END
  RETURN body;
END
PRIVATE FN pipelineSetIndexLowerer__index_prepared_value(self: PipelineSetIndexLowerer, item_var: String, elem_zig_type: String, alloc: String@symbol, item_type: ?Type, value_ownership: PipelineIndexValueOwnership) RETURNS !PipelineIndexPreparedValue ->
  MUTABLE item_owns = IF item_type != NIL THEN
    pipelineSetIndexLowerer__cleanup_bearing_type_call(self, item_type)
  ELSE
    TRUE
  END;
  MUTABLE item_value = pipelineSetIndexLowerer__index_item_value(self, item_var, elem_zig_type, alloc, value_ownership);
  IF pipelineSetIndexLowerer__preserve_owned_index_item?(self, item_owns, value_ownership) THEN
    RETURN PipelineIndexPreparedValue{ value: COPY item_value, setup_stmts: [Emittable{ AllocMark: COPY AllocMark{ name: COPY item_var, alloc: COPY alloc, type_info: COPY (item_type OR_ELSE TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }))), scope: COPY placement__alloc_scope(alloc), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], owns_heap: item_owns };
  END
  RETURN pipelineSetIndexLowerer__copied_index_value(self, item_value, alloc, item_owns);
END
PRIVATE FN pipelineSetIndexLowerer__preserve_owned_index_item?(self: PipelineSetIndexLowerer, item_owns: Bool, value_ownership: PipelineIndexValueOwnership) RETURNS Bool ->
  RETURN (item_owns AND (value_ownership == PipelineIndexValueOwnership.Owned));
END
PRIVATE FN pipelineSetIndexLowerer__copied_index_value(self: PipelineSetIndexLowerer, item_value: Emittable, alloc: String@symbol, item_owns: Bool) RETURNS PipelineIndexPreparedValue ->
  MUTABLE fact: ?PipelineIndexAllocationFact = pipelineSetIndexLowerer__pipeline_alloc_mark_fact_call(self, item_value, pipelineSetIndexLowerer__index_temp_name_call(self), alloc, NIL, "INDEX bucket item", TRUE);
  IF fact EXISTS AS fact_value THEN
    MUTABLE value_name = COPY fact_value.mark.name;
    MUTABLE setup_stmts: []Emittable = [Emittable{ AllocMark: COPY fact_value.mark }, Emittable{ Let: COPY Let{ name: COPY value_name, init: COPY item_value, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }];
    MUTABLE entry: ?CleanupEntry@multiowned = COPY KEEP fact_value.cleanup_entry;
    IF entry EXISTS AS entry_value THEN
      &setup_stmts.append(Emittable{ ErrCleanup: COPY ErrCleanup{ name: value_name, cleanup_entry: cleanupEntry__with_moved_guard(entry_value), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    END
    RETURN PipelineIndexPreparedValue{ value: Emittable{ Ident: COPY Ident{ name: COPY value_name, lowered_node_id: NIL, ownership_consumption: NIL } }, setup_stmts: COPY setup_stmts, owns_heap: COPY item_owns };
  ELSE
    RETURN PipelineIndexPreparedValue{ value: COPY item_value, setup_stmts: ( { MUTABLE rtoc_empty_list_4: []Emittable = List[]; rtoc_empty_list_4 } ), owns_heap: COPY item_owns };
  END
END
PRIVATE FN pipelineSetIndexLowerer__index_item_value(self: PipelineSetIndexLowerer, item_var: String, elem_zig_type: String, alloc: String@symbol, value_ownership: PipelineIndexValueOwnership) RETURNS Emittable ->
  IF (value_ownership == PipelineIndexValueOwnership.Borrowed) THEN
    RETURN Emittable{ DeepCopy: COPY DeepCopy{ source: COPY Ident{ name: COPY item_var, lowered_node_id: NIL, ownership_consumption: NIL }, zig_type: COPY elem_zig_type, elem_type: NIL, strategy: :full_value, alloc: COPY alloc, copy_shape: NIL, type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL } };
  ELSE
    RETURN Emittable{ Ident: COPY Ident{ name: COPY item_var, lowered_node_id: NIL, ownership_consumption: NIL } };
  END
END
FN castEmittableToLocatable(value: Emittable) RETURNS Locatable ->
  PARTIAL MATCH value START
    Emittable.MIRProgram AS cast_payload -> RETURN Locatable{ MIRProgram: COPY cast_payload };,
    Emittable.MIRStructDef AS cast_payload -> RETURN Locatable{ MIRStructDef: COPY cast_payload };,
    Emittable.MIREnumDef AS cast_payload -> RETURN Locatable{ MIREnumDef: COPY cast_payload };,
    Emittable.MIRDestructureTarget AS cast_payload -> RETURN Locatable{ MIRDestructureTarget: COPY cast_payload };,
    Emittable.MIRDeferStmt AS cast_payload -> RETURN Locatable{ MIRDeferStmt: COPY cast_payload };,
    Emittable.MIRBgBlock AS cast_payload -> RETURN Locatable{ MIRBgBlock: COPY cast_payload };,
    Emittable.MIRDoBlock AS cast_payload -> RETURN Locatable{ MIRDoBlock: COPY cast_payload };,
    Emittable.MIRMethodCall AS cast_payload -> RETURN Locatable{ MIRMethodCall: COPY cast_payload };,
    Emittable.MIRUnaryOp AS cast_payload -> RETURN Locatable{ MIRUnaryOp: COPY cast_payload };,
    Emittable.MIRBlockExpr AS cast_payload -> RETURN Locatable{ MIRBlockExpr: COPY cast_payload };,
    Emittable.MIRCast AS cast_payload -> RETURN Locatable{ MIRCast: COPY cast_payload };,
    Emittable.MIROptionalUnwrap AS cast_payload -> RETURN Locatable{ MIROptionalUnwrap: COPY cast_payload };,
    Emittable.MIRRangeLit AS cast_payload -> RETURN Locatable{ MIRRangeLit: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Locatable");
  END
  panic("Invalid cast to Locatable");
END
FN ruby_array_concat_Emittable(left: []Emittable, right: []Emittable) RETURNS []Emittable ->
  MUTABLE result: []Emittable = [];
  FOR rtoc_left_item IN left DO
    &result.append(COPY rtoc_left_item);
  END
  FOR rtoc_right_item IN right DO
    &result.append(COPY rtoc_right_item);
  END
  RETURN result;
END
