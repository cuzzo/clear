PRIVATE FN pipelineSetIndexLowerer__distinct_insert_body(self: PipelineSetIndexLowerer, expr_mir: Emittable, expr_node: Locatable, elem_type: Type, elem_zig: String, alloc: String@symbol, uses_allocator: Bool) RETURNS ![]Emittable ->
