  MUTABLE elem_type = UNWRAP (TRY (type__element_type((TRY (aST__full_type_mut(smooth_node))))));
  MUTABLE elem_zig = pipelineSetIndexLowerer__transpile_type_call(self, CAST(type__resolved(elem_type) AS String));
  MUTABLE set_zig = "CheatLib.Set(${elem_zig})";
  MUTABLE alloc = pipelineSetIndexLowerer__pipeline_alloc_call(self, smooth_node);
  MUTABLE expr_mir = pipelineSetIndexLowerer__visit_mir_with_placeholder_call(self, distinct_node.expression, "it");
