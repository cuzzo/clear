  MUTABLE range_chain: ?PipelineRangeChain = pipelineSetIndexLowerer__range_chain_call(self, list_node);
  IF range_chain EXISTS AS range_chain_value THEN
    MUTABLE prefix = pipelineSetIndexLowerer__lazy_range_prefix_call(self, range_chain_value.source, range_chain_value.stages, NIL, TRUE);
    RETURN pipelineSetIndexLowerer__range_fold_observable_distinct_call(self, prefix, distinct_node, smooth_node, pipelineSetIndexLowerer__next_label_call(self), range_chain_value.source);
  ELSE
    RETURN NIL;
  END
