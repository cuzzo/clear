PRIVATE FN pipelineSetIndexLowerer__distinct_insert_stmt(self: PipelineSetIndexLowerer, alloc: String@symbol, insert_value: Emittable, uses_allocator: Bool, consumes: ?OwnershipOperandFact = NIL) RETURNS !ExprStmt ->
