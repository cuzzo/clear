  MUTABLE owned_value =   IF key_owned THEN
    Ident{ name: "dist_key", lowered_node_id: NIL, ownership_consumption: NIL }
  ELSE
    DeepCopy{ source: COPY Ident{ name: "dist_key", lowered_node_id: NIL, ownership_consumption: NIL }, zig_type: COPY elem_zig, elem_type: NIL, strategy: :full_value, alloc: COPY alloc, copy_shape: NIL, type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL }
