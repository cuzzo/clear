  rtoc_lambda_result_2 = CAST(Tuple{TRY (pipelineSetIndexLowerer__index_result_let(self, map_type, alloc)), ForStmt{ iter: Emittable{ Ident: COPY Ident{ name: COPY items, lowered_node_id: NIL, ownership_consumption: NIL } }, capture: "it", body: Body{ ArrayValue: TRY (pipelineSetIndexLowerer__build_index_gop_body(self, expr_mir, alloc, "it", expr_node, CAST(elem_type AS ?Type), PipelineIndexValueOwnership.Borrowed)) |> SELECT castEmittableToLocatable(_) }, index_capture: NIL, mark_per_iter: NIL, tight: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }, BreakStmt{ label: label, value: Emittable{ Ident: COPY Ident{ name: "idx_result", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }} AS Tuple<Let, ForStmt, BreakStmt>);
