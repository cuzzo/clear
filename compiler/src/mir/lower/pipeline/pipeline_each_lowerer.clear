REQUIRE "pkg:rtoc_6173742f747970652e636c656172" AS type
REQUIRE "pkg:rtoc_6173742f6173742e636c656172" AS ast
REQUIRE "pkg:rtoc_6d69722f6d69722e636c656172" AS mir
REQUIRE "pkg:rtoc_6d69722f6c6f7765722f706970656c696e652f706970656c696e655f72616e67655f6c6f77657265722e636c656172" AS pipeline_range_lowerer
REQUIRE "pkg:rtoc_6d69722f706c6163656d656e742e636c656172" AS placement
UNION PipelineEachLowererReturnValue { ForStmt: ForStmt, ScopeBlock: ScopeBlock }
PUB UNION PipelineEachResult { ForStmt: ForStmt, ScopeBlock: ScopeBlock }
PUB STRUCT PipelineEachSoaBody {
  body: []Emittable,
  fields: []String
}
PUB ENUM PipelineEachSourceKind { Sharded, Soa, Pool, RangeChain, List, Set, RangeLiteral, Unsupported }
PUB STRUCT PipelineEachPlan {
  source_kind: PipelineEachSourceKind,
  list_node: Locatable,
  each_op: EachOp,
  lhs_type: Type,
  range_chain: ?PipelineRangeChain,
  bc_target: Bool
}
PUB STRUCT PipelineEachLowerer {
  bc_target: FN() -> Bool,
  visit_mir: FN(Locatable) -> Emittable,
  visit_body_with_placeholder: FN(Locatable[], String) -> ![]Emittable,
  soa_body: FN(Locatable[]) -> PipelineEachSoaBody,
  range_chain: FN(Locatable) -> ?PipelineRangeChain,
  lower_each_range: FN(Locatable, Locatable[], EachOp) -> ScopeBlock,
  lower_sharded_each: FN(Locatable, EachOp) -> ScopeBlock,
  ast_stmts_use_placeholder: FN(Locatable[]) -> Bool,
  next_index_name: FN() -> String,
  loop_mark_stmts: FN() -> ![]Emittable,
  source_alloc_fact: FN(Emittable, String, Type) -> ?Tuple<AllocMark, CleanupEntry@multiowned>
}

PUB FN pipelineEachLowerer__lower(self: PipelineEachLowerer, MUTABLE list_node: Locatable, each_op: EachOp) RETURNS !?PipelineEachResult ->
  RETURN TRY (pipelineEachLowerer__lower_plan(self, pipelineEachLowerer__each_plan(self, &list_node, each_op)));
END
PRIVATE FN pipelineEachLowerer__each_plan(self: PipelineEachLowerer, MUTABLE list_node: Locatable, each_op: EachOp) RETURNS PipelineEachPlan ->
  MUTABLE lhs_type = &list_node.full_type_mut();
  MUTABLE bc_target = self.bc_target();
  MUTABLE range_chain: ?PipelineRangeChain = self.range_chain(list_node);
  RETURN PipelineEachPlan{ source_kind: COPY pipelineEachLowerer__each_source_kind(self, list_node, lhs_type, range_chain, &bc_target), list_node: COPY list_node, each_op: COPY each_op, lhs_type: COPY lhs_type, range_chain: COPY range_chain, bc_target: bc_target };
END
PRIVATE FN pipelineEachLowerer__lower_plan(self: PipelineEachLowerer, plan: PipelineEachPlan) RETURNS !?PipelineEachResult ->
  RETURN TRY (pipelineEachLowerer__lower_source_plan(self, plan.source_kind, plan));
END
PRIVATE FN pipelineEachLowerer__lower_source_plan(self: PipelineEachLowerer, source_kind: PipelineEachSourceKind, plan: PipelineEachPlan) RETURNS !?PipelineEachResult ->
  IF (source_kind == PipelineEachSourceKind.Sharded) THEN
    RETURN PipelineEachResult{ ScopeBlock: COPY self.lower_sharded_each(plan.list_node, plan.each_op) };
  ELSE_IF (source_kind == PipelineEachSourceKind.Soa) THEN
    RETURN PipelineEachResult{ ScopeBlock: COPY pipelineEachLowerer__lower_soa_each(self, plan.list_node, plan.lhs_type, plan.each_op) };
  ELSE_IF (source_kind == PipelineEachSourceKind.Pool) THEN
    RETURN castPipelineEachLowererReturnValueToOptionalPipelineEachResult(TRY (pipelineEachLowerer__lower_pool_each(self, plan.list_node, plan.lhs_type, plan.each_op, plan.bc_target)));
  ELSE_IF (source_kind == PipelineEachSourceKind.RangeChain) THEN
    MUTABLE chain = COPY UNWRAP (plan.range_chain);
    RETURN PipelineEachResult{ ScopeBlock: COPY self.lower_each_range(chain.source, chain.stages, plan.each_op) };
  ELSE_IF (source_kind == PipelineEachSourceKind.List) THEN
    RETURN PipelineEachResult{ ScopeBlock: COPY TRY (pipelineEachLowerer__lower_list_each(self, &plan.list_node, plan.each_op, plan.bc_target)) };
  ELSE_IF (source_kind IS_A Set) THEN
    RETURN PipelineEachResult{ ScopeBlock: COPY TRY (pipelineEachLowerer__lower_set_each(self, plan.list_node, plan.each_op)) };
  ELSE_IF (source_kind == PipelineEachSourceKind.RangeLiteral) THEN
    RETURN PipelineEachResult{ ForStmt: COPY pipelineEachLowerer__lower_range_literal_each(self, plan.list_node, plan.each_op) };
  ELSE_IF (source_kind == PipelineEachSourceKind.Unsupported) THEN
    RETURN NIL;
  ELSE
    RETURN NIL;
  END
END
PRIVATE FN pipelineEachLowerer__each_source_kind(self: PipelineEachLowerer, list_node: Locatable, lhs_type: Type, range_chain: ?PipelineRangeChain, MUTABLE bc_target: Bool) RETURNS PipelineEachSourceKind ->
  IF (type__sharded?(lhs_type) AND !(bc_target)) THEN
    RETURN PipelineEachSourceKind.Sharded;
  END
  IF (type__soa_linear_collection?(lhs_type) AND !(bc_target)) THEN
    RETURN PipelineEachSourceKind.Soa;
  END
  IF type__pool?(lhs_type) THEN
    RETURN PipelineEachSourceKind.Pool;
  END
  IF pipelineEachLowerer__range_chain_usable?(self, list_node, range_chain, bc_target) THEN
    RETURN PipelineEachSourceKind.RangeChain;
  END
  IF (type__list_collection?(lhs_type) OR type__fixed_soa?(lhs_type)) THEN
    RETURN PipelineEachSourceKind.List;
  END
  IF type__set_collection?(lhs_type) THEN
    RETURN PipelineEachSourceKind.Set;
  END
  IF list_node IS_A RangeLit THEN
    RETURN PipelineEachSourceKind.RangeLiteral;
  END
  IF type__array?(lhs_type) THEN
    RETURN PipelineEachSourceKind.List;
  END
  RETURN PipelineEachSourceKind.Unsupported;
END
PRIVATE FN pipelineEachLowerer__range_chain_usable?(self: PipelineEachLowerer, list_node: Locatable, range_chain: ?PipelineRangeChain, bc_target: Bool) RETURNS Bool ->
  IF range_chain EXISTS AS range_chain_value THEN
    RETURN !((((bc_target AND list_node IS_A RangeLit) AND (range_chain_value.stages.length() == 0))));
  ELSE
    RETURN FALSE;
  END
END
PRIVATE FN pipelineEachLowerer__lower_soa_each(self: PipelineEachLowerer, list_node: Locatable, lhs_type: Type, each_op: EachOp) RETURNS ScopeBlock ->
  MUTABLE source_mir = self.visit_mir(list_node);
  MUTABLE soa = self.soa_body(each_op.body);
  MUTABLE alive_guard: []Emittable = ( { MUTABLE rtoc_empty_list_1: []Emittable = List[]; rtoc_empty_list_1 } );
  IF type__pool?(lhs_type) THEN
    &alive_guard.append(Emittable{ IfStmt: COPY IfStmt{ cond: Emittable{ MIRUnaryOp: COPY MIRUnaryOp{ op: "!", operand: Emittable{ IndexGet: COPY IndexGet{ object: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__soa_src", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "alive", lowered_node_id: NIL, ownership_consumption: NIL } }, index: Emittable{ Ident: COPY Ident{ name: "__soa_i", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: [ContinueStmt{ unused: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL } });
  END
  RETURN ScopeBlock{ body: COPY ([Let{ name: COPY "__soa_src", init: Emittable{ MIRUnaryOp: COPY MIRUnaryOp{ op: "&", operand: COPY source_mir, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }] + soa.fields |> SELECT Let{ name: Name{ StringValue: COPY "__soa_${_}" }, init: Emittable{ SoaFieldAccess: COPY SoaFieldAccess{ soa_expr: COPY Ident{ name: "__soa_src", lowered_node_id: NIL, ownership_consumption: NIL }, field_name: COPY _, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } + [ForStmt{ iter: Emittable{ IterRange: COPY IterRange{ start: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL }, end_val: MIRCast{ expr: Emittable{ ListLength: COPY ListLength{ expr: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__soa_src", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "data", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: "usize", method: :intCast, lowered_node_id: NIL, ownership_consumption: NIL }, capture_type: :usize, lowered_node_id: NIL, ownership_consumption: NIL } }, capture: "__soa_i", body: COPY (alive_guard + soa.body), index_capture: NIL, mark_per_iter: NIL, tight: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }]), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN pipelineEachLowerer__lower_pool_each(self: PipelineEachLowerer, list_node: Locatable, lhs_type: Type, each_op: EachOp, bc_target: Bool) RETURNS !PipelineEachLowererReturnValue ->
  MUTABLE source_mir = self.visit_mir(list_node);
  MUTABLE pool_body_mir = TRY (self.visit_body_with_placeholder(each_op.body, "__each_item"));
  IF bc_target THEN
  IF list_node IS_A Identifier AS identifier THEN
    RETURN PipelineEachLowererReturnValue{ ForStmt: COPY pipelineEachLowerer__lower_bc_indexed_each(self, Locatable{ Identifier: COPY identifier }, pool_body_mir, TRUE) };
  END
  END
  RETURN PipelineEachLowererReturnValue{ ScopeBlock: COPY ScopeBlock{ body: COPY CAST(Tuple{Let{ name: COPY "__each_src", init: Emittable{ MIRUnaryOp: COPY MIRUnaryOp{ op: "&", operand: COPY source_mir, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }, ForStmt{ iter: Emittable{ IterRange: COPY IterRange{ start: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL }, end_val: MIRCast{ expr: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__each_src", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "capacity", lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: "usize", method: :intCast, lowered_node_id: NIL, ownership_consumption: NIL }, capture_type: :usize, lowered_node_id: NIL, ownership_consumption: NIL } }, capture: "__each_idx", body: COPY ([IfStmt{ cond: Emittable{ MIRUnaryOp: COPY MIRUnaryOp{ op: "!", operand: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: COPY Ident{ name: "__each_src", lowered_node_id: NIL, ownership_consumption: NIL }, method: "isAliveIndex", args: [CAST(Ident{ name: "__each_idx", lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(1)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: [ContinueStmt{ unused: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL }, Let{ name: COPY "__each_item", init: Emittable{ MIRUnaryOp: COPY MIRUnaryOp{ op: "&", operand: Emittable{ IndexGet: COPY IndexGet{ object: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__each_src", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "values", lowered_node_id: NIL, ownership_consumption: NIL } }, index: Emittable{ Ident: COPY Ident{ name: "__each_idx", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }] + pool_body_mir), index_capture: NIL, mark_per_iter: NIL, tight: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }} AS Tuple<Let, ForStmt>), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
END
PRIVATE FN pipelineEachLowerer__lower_bc_indexed_each(self: PipelineEachLowerer, list_node: Locatable, body_mir: []Emittable, skip_nil: Bool) RETURNS ForStmt ->
  MUTABLE idx_name = self.next_index_name();
  MUTABLE src_ident = Ident{ name: COPY castLocatableToIdentifier(list_node).name, lowered_node_id: NIL, ownership_consumption: NIL };
  MUTABLE body: []Emittable = [Emittable{ Let: COPY Let{ name: COPY "__each_item", init: Emittable{ IndexGet: COPY IndexGet{ object: Emittable{ Ident: COPY src_ident }, index: Emittable{ Ident: COPY Ident{ name: COPY idx_name, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }];
  IF skip_nil THEN
    &body.append(Emittable{ IfStmt: COPY IfStmt{ cond: Emittable{ MIRBinOp: COPY MIRBinOp{ op: "==", left: Emittable{ Ident: COPY Ident{ name: "__each_item", lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Lit: COPY Lit{ value: "nil", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: [ContinueStmt{ unused: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL } });
  END
  body = ruby_array_concat_Emittable(body, body_mir);
  &body.append(Emittable{ Set: COPY Set{ target: Emittable{ IndexGet: COPY IndexGet{ object: Emittable{ Ident: COPY src_ident }, index: Emittable{ Ident: COPY Ident{ name: COPY idx_name, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Ident: COPY Ident{ name: "__each_item", lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
  RETURN ForStmt{ iter: Emittable{ IterRange: COPY IterRange{ start: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL }, end_val: ListLength{ expr: Emittable{ Ident: COPY src_ident }, lowered_node_id: NIL, ownership_consumption: NIL }, capture_type: :usize, lowered_node_id: NIL, ownership_consumption: NIL } }, capture: COPY idx_name, body: Body{ ArrayValue: body |> SELECT castEmittableToLocatable(_) }, index_capture: NIL, mark_per_iter: NIL, tight: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN pipelineEachLowerer__lower_list_each(self: PipelineEachLowerer, MUTABLE list_node: Locatable, each_op: EachOp, bc_target: Bool) RETURNS !ScopeBlock ->
  MUTABLE source_mir = self.visit_mir(list_node);
  MUTABLE list_body_mir = TRY (self.visit_body_with_placeholder(each_op.body, "__each_item"));
  IF bc_target THEN
  IF list_node IS_A Identifier AS identifier THEN
    RETURN ScopeBlock{ body: COPY [pipelineEachLowerer__lower_bc_indexed_each(self, Locatable{ Identifier: COPY identifier }, list_body_mir, FALSE)], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
  END
  END
  MUTABLE stmts: []Emittable = ( { MUTABLE rtoc_empty_list_2: []Emittable = List[]; rtoc_empty_list_2 } );
  MUTABLE fact: ?Tuple<AllocMark, CleanupEntry@multiowned> = self.source_alloc_fact(source_mir, "__each_src", &list_node.full_type_mut());
  IF fact EXISTS AS fact_value THEN
    &stmts.append(COPY fact_value._0);
  END
  &stmts.append(Emittable{ Let: COPY Let{ name: COPY "__each_src", init: COPY source_mir, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
  IF fact EXISTS AS fact_value THEN
    &stmts.append(Emittable{ Cleanup: COPY Cleanup{ name: "__each_src", cleanup_entry: COPY fact_value._1, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
  END
  &stmts.append(Emittable{ Let: COPY Let{ name: COPY "__each_items", init: Emittable{ ItemsAccess: COPY ItemsAccess{ expr: Emittable{ Ident: COPY Ident{ name: "__each_src", lowered_node_id: NIL, ownership_consumption: NIL } }, safe: TRUE, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
  &stmts.append(Emittable{ ForStmt: COPY ForStmt{ iter: Emittable{ Ident: COPY Ident{ name: "__each_items", lowered_node_id: NIL, ownership_consumption: NIL } }, capture: "__each_item", body: COPY ([Suppress{ name: "__each_item", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }] + TRY (pipelineEachLowerer__with_iteration_rewind(self, list_body_mir))), index_capture: NIL, mark_per_iter: NIL, tight: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
  RETURN ScopeBlock{ body: Body{ ArrayValue: stmts |> SELECT castEmittableToLocatable(_) }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN pipelineEachLowerer__with_iteration_rewind(self: PipelineEachLowerer, body: []Emittable) RETURNS ![]Emittable ->
  IF !(pipelineEachLowerer__body_frame_transients?(self, body)) THEN
    RETURN COPY body;
  END
  RETURN (COPY (TRY (self.loop_mark_stmts())) + body);
END
PRIVATE FN pipelineEachLowerer__body_frame_transients?(self: PipelineEachLowerer, body: []Emittable) RETURNS Bool ->
  MUTABLE found: Bool = FALSE;
  MUTABLE boundary = %(node) -> (node IS_A MIRBgBlock OR node IS_A LambdaExpr);
  mIR__each_node_until(NodeRoot{ ArrayValue: COPY body }, boundary, %(node: Emittable) -> {
  IF (IF node IS_A AllocMark AS alloc_mark THEN placement__frame?(alloc_mark.alloc) ELSE FALSE END) THEN
      found = TRUE;
  END
  rubyToClearVoid()
  });
  RETURN found;
END
PRIVATE FN pipelineEachLowerer__lower_set_each(self: PipelineEachLowerer, list_node: Locatable, each_op: EachOp) RETURNS !ScopeBlock ->
  MUTABLE source_mir = self.visit_mir(list_node);
  MUTABLE set_body_mir = TRY (self.visit_body_with_placeholder(each_op.body, "__each_item"));
  RETURN ScopeBlock{ body: COPY CAST(Tuple{Let{ name: COPY "__each_src", init: Emittable{ MIRUnaryOp: COPY MIRUnaryOp{ op: "&", operand: COPY source_mir, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }, Let{ name: COPY "__each_iter", init: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: COPY Ident{ name: "__each_src", lowered_node_id: NIL, ownership_consumption: NIL }, method: "keyIterator", args: ( { MUTABLE rtoc_empty_list_3: []Any = List[]; rtoc_empty_list_3 } ), try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, mutable: TRUE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }, WhileStmt{ cond: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: COPY Ident{ name: "__each_iter", lowered_node_id: NIL, ownership_consumption: NIL }, method: "next", args: ( { MUTABLE rtoc_empty_list_4: []Any = List[]; rtoc_empty_list_4 } ), try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, body: COPY ([Let{ name: COPY "__each_item", init: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__each_kptr", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "*", lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }] + set_body_mir), capture: "__each_kptr", update: NIL, mark_per_iter: NIL, tight: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }} AS Tuple<Let, Let, WhileStmt>), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN pipelineEachLowerer__lower_range_literal_each(self: PipelineEachLowerer, list_node: Locatable, each_op: EachOp) RETURNS !ForStmt ->
  MUTABLE range: RangeLit = COPY CAST(list_node AS RangeLit);
  MUTABLE start_mir = self.visit_mir(range.start);
  MUTABLE end_mir = self.visit_mir(range.finish);
  MUTABLE end_expr_branch_value: ?BinOp = NIL;
  IF range.inclusive THEN
    end_expr_branch_value = MIRBinOp{ op: "+", left: COPY end_mir, right: Emittable{ Lit: COPY Lit{ value: "1", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL };
  ELSE
    end_expr_branch_value = end_mir;
  END
  MUTABLE end_expr: BinOp = end_expr_branch_value?;
  MUTABLE range_body_mir = TRY (self.visit_body_with_placeholder(each_op.body, "__each_item"));
  RETURN ForStmt{ iter: Emittable{ IterRange: COPY IterRange{ start: castEmittableToLit(COPY start_mir), end_val: end_expr, capture_type: :i64, lowered_node_id: NIL, ownership_consumption: NIL } }, capture: "__each_item", body: COPY ([Suppress{ name: "__each_item", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }] + range_body_mir), index_capture: NIL, mark_per_iter: NIL, tight: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
FN castEmittableToLit(value: Emittable) RETURNS Lit ->
  IF value IS_A Lit AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to Lit");
END
FN castEmittableToLocatable(value: Emittable) RETURNS Locatable ->
  PARTIAL MATCH value START
    Emittable.MIRProgram AS cast_payload -> RETURN Locatable{ MIRProgram: COPY cast_payload };,
    Emittable.MIRStructDef AS cast_payload -> RETURN Locatable{ MIRStructDef: COPY cast_payload };,
    Emittable.MIREnumDef AS cast_payload -> RETURN Locatable{ MIREnumDef: COPY cast_payload };,
    Emittable.MIRDestructureTarget AS cast_payload -> RETURN Locatable{ MIRDestructureTarget: COPY cast_payload };,
    Emittable.MIRDeferStmt AS cast_payload -> RETURN Locatable{ MIRDeferStmt: COPY cast_payload };,
    Emittable.MIRBgBlock AS cast_payload -> RETURN Locatable{ MIRBgBlock: COPY cast_payload };,
    Emittable.MIRDoBlock AS cast_payload -> RETURN Locatable{ MIRDoBlock: COPY cast_payload };,
    Emittable.MIRMethodCall AS cast_payload -> RETURN Locatable{ MIRMethodCall: COPY cast_payload };,
    Emittable.MIRUnaryOp AS cast_payload -> RETURN Locatable{ MIRUnaryOp: COPY cast_payload };,
    Emittable.MIRBlockExpr AS cast_payload -> RETURN Locatable{ MIRBlockExpr: COPY cast_payload };,
    Emittable.MIRCast AS cast_payload -> RETURN Locatable{ MIRCast: COPY cast_payload };,
    Emittable.MIROptionalUnwrap AS cast_payload -> RETURN Locatable{ MIROptionalUnwrap: COPY cast_payload };,
    Emittable.MIRRangeLit AS cast_payload -> RETURN Locatable{ MIRRangeLit: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Locatable");
  END
  panic("Invalid cast to Locatable");
END
FN castLocatableToIdentifier(value: Locatable) RETURNS Identifier ->
  IF value IS_A Identifier AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to Identifier");
END
FN castPipelineEachLowererReturnValueToOptionalPipelineEachResult(value: PipelineEachLowererReturnValue) RETURNS ?PipelineEachResult ->
  PARTIAL MATCH value START
    PipelineEachLowererReturnValue.ForStmt AS cast_payload -> RETURN PipelineEachResult{ ForStmt: COPY cast_payload };,
    PipelineEachLowererReturnValue.ScopeBlock AS cast_payload -> RETURN PipelineEachResult{ ScopeBlock: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to ?PipelineEachResult");
  END
  panic("Invalid cast to ?PipelineEachResult");
END
FN rubyToClearVoid() RETURNS Void ->
  RETURN;
END
FN ruby_array_concat_Emittable(left: []Emittable, right: []Emittable) RETURNS []Emittable ->
  MUTABLE result: []Emittable = [];
  FOR rtoc_left_item IN left DO
    &result.append(COPY rtoc_left_item);
  END
  FOR rtoc_right_item IN right DO
    &result.append(COPY rtoc_right_item);
  END
  RETURN result;
END
