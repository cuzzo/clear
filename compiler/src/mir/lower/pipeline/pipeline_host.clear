FN castOptionalPipelineEachResultToOptionalPipelineLoweringResult(value: ?PipelineEachResult) RETURNS ?PipelineLoweringResult ->
  IF value == NIL THEN
    panic("Invalid cast to ?PipelineLoweringResult");
  END
  PARTIAL MATCH value? START
    PipelineEachResult.ForStmt AS cast_payload -> RETURN PipelineLoweringResult{ ForStmt: COPY cast_payload };,
    PipelineEachResult.ScopeBlock AS cast_payload -> RETURN PipelineLoweringResult{ ScopeBlock: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to ?PipelineLoweringResult");
