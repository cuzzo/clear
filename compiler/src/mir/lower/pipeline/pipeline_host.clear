PRIVATE FN pipelineHost__transpile_type(self: PipelineHost, type: Type, is_param: Bool = FALSE, is_field: Bool = FALSE) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE t_branch_value: ?Type = NIL;
    IF TRUE THEN
      t_branch_value = COPY type;
    ELSE
      t_branch_value = TRY (type__new(castTypeToTypeConstructionInput(type)));
    END
    MUTABLE t: Type = t_branch_value?;
    RETURN TRY (type__zig_type(t, is_param, is_field));
}
END
PUB FN pipelineHost__new(lowering: MIRLowering, emitter: MIREmitter) RETURNS !PipelineHost@multiowned ->
  MUTABLE self = PipelineHost{ batch_window_lowerer: NIL, binding_chain_lowerer: NIL, concurrent_lowerer: NIL, do_rt_name: NIL, each_idx_counter: 0, each_lowerer: NIL, fn_sigs: {}, label_state: pipelineLabelState__new(), list_lowerer: NIL, lowering_bridge: pipelineLoweringBridge__new(COPY lowering, COPY emitter), materializer: pipelineMaterializer__new(pipelineHost__build_materializer_host(&self)), mir_mode: FALSE, pipe_temp_counter: 0, pipeline_context: NIL, pipeline_node_alloc: NIL, plan_builder: NIL, range_lowerer: pipelineRangeLowerer__new(TRY (pipelineHost__build_range_lowerer_host(self))), scalar_lowerer: NIL, set_index_lowerer: NIL, stream_select_counter: 0 };
  TRY (pipelineHost__initialize(&self, lowering, emitter));
  RETURN self @multiowned;
END
FN castEmittableToLocatable(value: Emittable) RETURNS Locatable ->
  PARTIAL MATCH value START
    Emittable.MIRProgram AS cast_payload -> RETURN Locatable{ MIRProgram: COPY cast_payload };,
    Emittable.MIRStructDef AS cast_payload -> RETURN Locatable{ MIRStructDef: COPY cast_payload };,
    Emittable.MIREnumDef AS cast_payload -> RETURN Locatable{ MIREnumDef: COPY cast_payload };,
    Emittable.MIRDestructureTarget AS cast_payload -> RETURN Locatable{ MIRDestructureTarget: COPY cast_payload };,
    Emittable.WhileLoop AS cast_payload -> RETURN Locatable{ WhileLoop: COPY cast_payload };,
    Emittable.WhileBindLoop AS cast_payload -> RETURN Locatable{ WhileBindLoop: COPY cast_payload };,
    Emittable.MIRDeferStmt AS cast_payload -> RETURN Locatable{ MIRDeferStmt: COPY cast_payload };,
    Emittable.MIRBgBlock AS cast_payload -> RETURN Locatable{ MIRBgBlock: COPY cast_payload };,
    Emittable.MIRDoBlock AS cast_payload -> RETURN Locatable{ MIRDoBlock: COPY cast_payload };,
    Emittable.FuncCall AS cast_payload -> RETURN Locatable{ FuncCall: COPY cast_payload };,
    Emittable.MIRMethodCall AS cast_payload -> RETURN Locatable{ MIRMethodCall: COPY cast_payload };,
    Emittable.MIRUnaryOp AS cast_payload -> RETURN Locatable{ MIRUnaryOp: COPY cast_payload };,
    Emittable.MIRBlockExpr AS cast_payload -> RETURN Locatable{ MIRBlockExpr: COPY cast_payload };,
    Emittable.MIRCast AS cast_payload -> RETURN Locatable{ MIRCast: COPY cast_payload };,
    Emittable.MIROptionalUnwrap AS cast_payload -> RETURN Locatable{ MIROptionalUnwrap: COPY cast_payload };,
    Emittable.MIRRangeLit AS cast_payload -> RETURN Locatable{ MIRRangeLit: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Locatable");
  END
  panic("Invalid cast to Locatable");
END
FN castEmittableToPipelineHostReturnValue(value: Emittable) RETURNS PipelineHostReturnValue ->
  PARTIAL MATCH value START
    Emittable.Lit AS cast_payload -> RETURN PipelineHostReturnValue{ Lit: COPY cast_payload };,
    Emittable.TypeSentinel AS cast_payload -> RETURN PipelineHostReturnValue{ TypeSentinel: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to PipelineHostReturnValue");
  END
  panic("Invalid cast to PipelineHostReturnValue");
END
