PUB FN pipelineHost__visit(self: PipelineHost, node: Locatable) RETURNS PipelineHostReturnValue
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF rtoc_self_view.mir_mode THEN
      RETURN castEmittableToPipelineHostReturnValue(pipelineHost__visit_mir(rtoc_self_view, node));
    END
    MUTABLE context = pipelineHost__current_context(rtoc_self_view);
    IF node IS_A Identifier AS identifier THEN
      MUTABLE replacement: ?String = pipelineContextState__replacement_for_identifier(context, identifier__name(identifier));
      IF replacement EXISTS AS replacement_value THEN
        RETURN PipelineHostReturnValue{ StringValue: COPY replacement_value };
      END
    END
    IF (context.soa_rewrite_active AND aST__soa_placeholder_field?(node)) THEN
      MUTABLE target: GetField = COPY castLocatableToGetField(node);
      &context.soa_needed_fields.insert(COPY target.field);
      RETURN PipelineHostReturnValue{ StringValue: COPY "__soa_${target.field}[__soa_i]" };
    END
    IF (context.soa_rewrite_active AND aST__soa_placeholder_assignment?(node)) THEN
      MUTABLE assignment: Any@multiowned = COPY CAST(node AS Any@multiowned);
      MUTABLE target: GetField = CAST(assignment.name() AS GetField);
      MUTABLE field = target.field;
      &context.soa_needed_fields.insert(COPY field);
      MUTABLE value: String = castPipelineHostReturnValueToString(pipelineHost__visit(rtoc_self_view, CAST(assignment.value() AS Locatable)));
      RETURN PipelineHostReturnValue{ StringValue: COPY "__soa_${field}[__soa_i] = ${value};" };
    END
    MUTABLE substituted = pipelineHost__substitute_placeholders(rtoc_self_view, node);
    MUTABLE mir_node = pipelineLoweringBridge__lower_node(rtoc_self_view.lowering_bridge, substituted);
    RETURN PipelineHostReturnValue{ StringValue: COPY UNWRAP (pipelineLoweringBridge__emit_mir(rtoc_self_view.lowering_bridge, mir_node)) };
}
END
PUB FN pipelineHost__visit_mir(self: PipelineHost, node: Locatable) RETURNS Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE substituted = pipelineHost__substitute_placeholders(rtoc_self_view, node);
    RETURN pipelineLoweringBridge__lower_node(rtoc_self_view.lowering_bridge, substituted);
}
END
PUB FN pipelineHost__visit_mir_head(self: PipelineHost, node: Locatable) RETURNS PipelineElementHead
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE substituted = pipelineHost__substitute_placeholders(rtoc_self_view, node);
    MUTABLE head = pipelineLoweringBridge__lower_head(rtoc_self_view.lowering_bridge, %() USE(substituted, rtoc_self_view) -> pipelineLoweringBridge__lower_node(rtoc_self_view.lowering_bridge, substituted));
    MUTABLE owned = (ownershipEffect__of(head.value).produces_owned OR (head.pending |> ANY _ IS_A AllocMark));
    RETURN PipelineElementHead{ value: COPY head.value, pending: COPY head.pending, owned: owned };
}
END
PUB FN pipelineHost__visit_pipeline_body_mir(MUTABLE self: PipelineHost, body_stmts: []Locatable, placeholder: String) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_alias_arg_24 = COPY %() USE(body_stmts, rtoc_self_view) -> {
    MUTABLE substituted = body_stmts |> SELECT pipelineHost__substitute_placeholders(rtoc_self_view, _);
    TRY (pipelineLoweringBridge__lower_body(rtoc_self_view.lowering_bridge, substituted))
    };
    pipelineHost__with_pipeline_context(&rtoc_self_view, placeholder, rtoc_mutable_alias_arg_24) };
}
END
