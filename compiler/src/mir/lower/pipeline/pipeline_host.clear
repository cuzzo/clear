}
END
PUB FN pipelineHost__pipeline_result_heap?(self: PipelineHost, smooth_node: BinaryOp) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (pipelineHost__pipeline_alloc(rtoc_self_view, smooth_node) == :heap);
}
END
PUB FN pipelineHost__lower_pipeline(MUTABLE self: PipelineHost, MUTABLE node: BinaryOp) RETURNS !?PipelineLoweringResult
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE previous_alloc: ?String@symbol = COPY rtoc_self_view.pipeline_node_alloc;
  DEFER rtoc_self_view.pipeline_node_alloc = previous_alloc;
  rtoc_self_view.pipeline_node_alloc = pipelineHost__pipeline_alloc(rtoc_self_view, node);
  RETURN TRY (pipelineHost__lower_pipeline_body(&rtoc_self_view, &node));
}
END
PUB FN pipelineHost__pipeline_builder_alloc(self: PipelineHost) RETURNS String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF rtoc_self_view.pipeline_node_alloc != NIL THEN
    RETURN (rtoc_self_view.pipeline_node_alloc)?;
    ELSE
    RETURN pipelineHost__pipeline_result_alloc(rtoc_self_view);
    END
}
END
PUB FN pipelineHost__lower_pipeline_body(MUTABLE self: PipelineHost, MUTABLE node: BinaryOp) RETURNS !?PipelineLoweringResult
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (node.right IS_A SelectOp AND TRY (type__canonical_stream_result?((TRY (type__new(TypeConstructionInput{ Type: COPY TRY (aST__full_type_mut(node)) })))))) THEN
      RETURN PipelineLoweringResult{ MIRBgBlock: COPY TRY (pipelineHost__lower_stream_select(&rtoc_self_view, PipelineSite{ list: COPY node.left, options: COPY node }, castLocatableToSelectOp(node.right))) };
    END
    MUTABLE plan: ?PipelineOperationPlan = TRY (pipelinePlanBuilder__build(rtoc_self_view.plan_builder, node));
    IF plan EXISTS AS plan_value THEN
      MUTABLE plan_value_mutable = COPY plan_value;
      MUTABLE lowered: ?PipelineLoweringResult = TRY (pipelineHost__lower_dispatch_plan(&rtoc_self_view, plan_value_mutable));
      IF TRY (pipelineHost__concurrent_async_stream_select?(rtoc_self_view, &node)) THEN
        RETURN PipelineLoweringResult{ MIRBlockExpr: COPY TRY (pipelineHost__lower_concurrent_async_stream_result(&rtoc_self_view, &node, castOptionalPipelineLoweringResultToPromises(UNWRAP (lowered)))) };
      END
      RETURN lowered;
    ELSE
      RETURN NIL;
    END
}
END
PUB FN pipelineHost__concurrent_async_stream_select?(self: PipelineHost, MUTABLE node: BinaryOp) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE concurrent = COPY node.right;
    IF concurrent IS_A ConcurrentOp AS concurrent_op THEN
      MUTABLE select = concurrent_op.op;
      IF !(select IS_A SelectOp) THEN
        RETURN FALSE;
      END
      IF !(tenseSelectorPlan__asynchronous?((TRY (pipelineHost__select_tense_plan(rtoc_self_view, select))))) THEN
        RETURN FALSE;
      END
      MUTABLE result_type = TRY (type__new(TypeConstructionInput{ Type: COPY TRY (aST__full_type_mut(node)) }));
      RETURN (TRY (type__canonical_stream_result?(result_type)) AND TRY (type__dynamic_stream?(({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_26: ?Type = NIL;
      IF type__error_union?(result_type) THEN
        rtoc_ternary_value_26 = UNWRAP (TRY (type__payload_type(result_type)));
      ELSE
        rtoc_ternary_value_26 = result_type;
      END
      rtoc_ternary_value_26? }))));
    ELSE
      RETURN FALSE;
    END
}
END
PUB FN pipelineHost__lower_concurrent_async_stream_result(MUTABLE self: PipelineHost, MUTABLE node: BinaryOp, promises: Promises) RETURNS !MIRBlockExpr
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE result_type = TRY (type__new(TypeConstructionInput{ Type: COPY TRY (aST__full_type_mut(node)) }));
    MUTABLE stream_type_branch_value: ?Type = NIL;
    IF type__error_union?(result_type) THEN
      stream_type_branch_value = UNWRAP (TRY (type__payload_type(result_type)));
    ELSE
      stream_type_branch_value = result_type;
    END
    MUTABLE stream_type: Type = stream_type_branch_value?;
    MUTABLE item_type = UNWRAP (TRY (type__canonical_stream_item_type(stream_type)));
    MUTABLE promises_name = "__concurrent_select_promises_${{ MUTABLE rtoc_value_block_marker = 0; rtoc_self_view.stream_select_counter = (rtoc_self_view.stream_select_counter + 1); rtoc_self_view.stream_select_counter.toString() }}";
    MUTABLE call = pipelineLoweringBridge__emit_builtin(rtoc_self_view.lowering_bridge, :promiseListToStream, [Emittable{ Ident: COPY Ident{ name: COPY TRY (type__nested_zig_type(item_type)), lowered_node_id: NIL, ownership_consumption: NIL } }, Emittable{ AllocatorRef: COPY AllocatorRef{ kind: pipelineHost__pipeline_result_alloc(rtoc_self_view), lowered_node_id: NIL, ownership_consumption: NIL } }, Emittable{ Ident: COPY Ident{ name: COPY (rtoc_self_view.do_rt_name OR_ELSE "rt"), lowered_node_id: NIL, ownership_consumption: NIL } }, Emittable{ Ident: COPY Ident{ name: COPY promises_name, lowered_node_id: NIL, ownership_consumption: NIL } }]);
    MUTABLE label = pipelineHost__next_pipe_label(&rtoc_self_view);
    RETURN pipelineHost__typed_block_expr(rtoc_self_view, label, (CAST([Emittable{ Let: COPY Let{ name: COPY promises_name, init: castPromisesToEmittable(COPY promises), mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }, Emittable{ BreakStmt: COPY BreakStmt{ label: COPY label, value: COPY call, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable) + TRY (ownershipTransferPlan__marks((OwnershipTransferPlan{ name: COPY promises_name, target: :call, target_alloc: :heap, move_guarded: FALSE })))), result_type);
}
END
PUB FN pipelineHost__lower_dispatch_plan(MUTABLE self: PipelineHost, plan: PipelineOperationPlan) RETURNS !?PipelineLoweringResult
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN TRY (pipelineHost__lower_execution_plan(&rtoc_self_view, plan.execution, plan));
}
END
PUB FN pipelineHost__lower_execution_plan(MUTABLE self: PipelineHost, execution: PipelineExecutionKind, plan: PipelineOperationPlan) RETURNS !?PipelineLoweringResult
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (execution == PipelineExecutionKind.SoaScalarFold) THEN
      RETURN PipelineLoweringResult{ MIRBlockExpr: COPY TRY (pipelineHost__lower_soa_scalar_fold(&rtoc_self_view, plan.site, CAST(plan.rhs AS PipelineMaterializedScalarOp))) };
    ELSE_IF (execution == PipelineExecutionKind.FusedRangeFold) THEN
      MUTABLE range_chain = COPY UNWRAP (plan.source.range_chain);
      RETURN PipelineLoweringResult{ MIRBlockExpr: COPY pipelineHost__lower_range_fold(rtoc_self_view, range_chain.source, range_chain.stages, CAST(plan.rhs AS PipelineDefaultObservableFoldOp), plan.site.options) };
    ELSE_IF (execution == PipelineExecutionKind.FusedRangeReduce) THEN
      MUTABLE range_chain = COPY UNWRAP (plan.source.range_chain);
      RETURN PipelineLoweringResult{ MIRBlockExpr: COPY pipelineHost__lower_range_reduce(rtoc_self_view, range_chain.source, range_chain.stages, castLocatableToReduceOp(plan.rhs), plan.site.options) };
    ELSE_IF (execution == PipelineExecutionKind.BindingChain) THEN
      RETURN PipelineLoweringResult{ MIRBlockExpr: COPY pipelineHost__lower_binding_chain(rtoc_self_view, UNWRAP (plan.source.binding_chain), plan.site.options) };
    ELSE_IF (execution == PipelineExecutionKind.MaterializedScalar) THEN
      RETURN PipelineLoweringResult{ MIRBlockExpr: COPY TRY (pipelineScalarLowerer__lower(rtoc_self_view.scalar_lowerer, plan.site, CAST(plan.rhs AS PipelineMaterializedScalarOp))) };
    ELSE_IF (execution == PipelineExecutionKind.MaterializedList) THEN
      RETURN PipelineLoweringResult{ MIRBlockExpr: COPY TRY (pipelineListLowerer__lower(rtoc_self_view.list_lowerer, plan.site, castLocatableToPipelineListTerminalOp(plan.rhs))) };
    ELSE_IF (execution == PipelineExecutionKind.SetDistinct) THEN
      RETURN PipelineLoweringResult{ MIRBlockExpr: COPY pipelineHost__lower_distinct(rtoc_self_view, plan.site, castLocatableToDistinctOp(plan.rhs)) };
    ELSE_IF (execution == PipelineExecutionKind.BatchWindow) THEN
      RETURN PipelineLoweringResult{ MIRBlockExpr: COPY pipelineHost__lower_batch_window(rtoc_self_view, plan.site, castLocatableToBatchWindowOp(plan.rhs)) };
    ELSE_IF (execution == PipelineExecutionKind.SetIndex) THEN
      RETURN PipelineLoweringResult{ MIRBlockExpr: COPY pipelineHost__lower_index(rtoc_self_view, plan.site, castLocatableToIndexOp(plan.rhs).expression) };
    ELSE_IF (execution == PipelineExecutionKind.Each) THEN
      RETURN castOptionalPipelineEachResultToOptionalPipelineLoweringResult(pipelineHost__lower_each(rtoc_self_view, plan.site, castLocatableToEachOp(plan.rhs)));
    ELSE_IF (execution == PipelineExecutionKind.Concurrent) THEN
      RETURN castPipelineConcurrentResultToOptionalPipelineLoweringResult(pipelineHost__lower_concurrent(rtoc_self_view, plan.site, castLocatableToConcurrentOp(plan.rhs)));
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN pipelineHost__lower_stream_select(MUTABLE self: PipelineHost, site: PipelineSite, op: SelectOp) RETURNS !MIRBgBlock
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.stream_select_counter = (rtoc_self_view.stream_select_counter + 1);
    MUTABLE id = rtoc_self_view.stream_select_counter;
    MUTABLE result_type = TRY (type__new(TypeConstructionInput{ Type: COPY &site.options.full_type_mut() }));
    MUTABLE stream_type_branch_value: ?Type = NIL;
    IF type__error_union?(result_type) THEN
      stream_type_branch_value = UNWRAP (TRY (type__payload_type(result_type)));
    ELSE
      stream_type_branch_value = result_type;
    END
    MUTABLE stream_type: Type = stream_type_branch_value?;
    MUTABLE item_type = UNWRAP (TRY (type__canonical_stream_item_type(result_type)));
    MUTABLE source_type = TRY (type__new(&site.list.full_type_mut()));
    MUTABLE ctx_type = "__SelectStreamCtx${id.toString()}";
    MUTABLE alloc_var = "__select_stream${id.toString()}_alloc";
    MUTABLE stream_var = "__select_stream${id.toString()}_stream";
    MUTABLE ctx_var = "__select_stream${id.toString()}_ctx";
    MUTABLE label = "__select_stream${id.toString()}";
    MUTABLE local_stream = "__select_stream${id.toString()}_local";
    MUTABLE analysis: ?CaptureAnalysis = COPY CAST(op.capture_analysis AS ?CaptureAnalysis);
    MUTABLE caps = TRY (fiberCtxBuilder__build(analysis, "ctx", {}, alloc_var, (10000 + id), {}, %(name) USE(rtoc_self_view) -> pipelineHost__pipeline_schema_lookup(rtoc_self_view)(name)));
    MUTABLE source_mir = pipelineHost__visit_mir(rtoc_self_view, site.list);
    MUTABLE source_type_zig: String = "";
    IF source_mir IS_A Ident AS ident THEN
      source_type_zig = "*@TypeOf(${ident.name})";
    ELSE
      source_type_zig = "*${TRY (type__zig_type(source_type))}";
    END
    MUTABLE capture_fields = ([ContextFieldDecl{ name: "source", type_zig: COPY source_type_zig, default_value: NIL }] + (caps.specs |> SELECT ContextFieldDecl{ name: COPY _.name, type_zig: COPY _.field_type_zig, default_value: NIL }));
    MUTABLE capture_inits = ([StructInitField{ name: :stream_inner, value: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: COPY stream_var, lowered_node_id: NIL, ownership_consumption: NIL } }, field: "inner", lowered_node_id: NIL, ownership_consumption: NIL } }, alloc: NIL }, StructInitField{ name: :alloc, value: Emittable{ Ident: COPY Ident{ name: COPY alloc_var, lowered_node_id: NIL, ownership_consumption: NIL } }, alloc: NIL }, StructInitField{ name: :source, value: Emittable{ AddressOf: COPY AddressOf{ expr: COPY source_mir, lowered_node_id: NIL, ownership_consumption: NIL } }, alloc: NIL }] + (caps.specs |> SELECT StructInitField{ name: symbol(COPY _.name), value: COPY _.init_value_mir, alloc: NIL }));
    MUTABLE selector_prefix: []Emittable = ( { MUTABLE rtoc_empty_list_27: []Emittable = List[]; rtoc_empty_list_27 } );
    MUTABLE selector_head = pipelineLoweringBridge__lower_head(rtoc_self_view.lowering_bridge, %() USE(caps, op, MUTABLE rtoc_self_view) -> pipelineHost__with_pipeline_context(&rtoc_self_view, "__select_item", %() USE(caps, op, rtoc_self_view) -> pipelineHost__with_fiber_capture_map(rtoc_self_view, caps.capture_map, caps.capture_symbols, "__rt", %() USE(op, rtoc_self_view) -> pipelineHost__visit_mir(rtoc_self_view, op.expression))));
    MUTABLE selector: Emittable = COPY selector_head.value;
    selector_prefix = ruby_array_concat_Emittable(selector_prefix, selector_head.pending);
    MUTABLE tense_plan = TRY (pipelineHost__select_tense_plan(rtoc_self_view, op));
    IF tenseSelectorPlan__asynchronous?(tense_plan) THEN
      MUTABLE promise_name = "__select_promise${id.toString()}";
      MUTABLE expression_type_branch_value: ?Type = NIL;
      IF (respondsTo?(op.expression, "error_union_type") AND op.expression.error_union_type()) THEN
        expression_type_branch_value = TRY (type__new(op.expression.error_union_type()));
      ELSE
        expression_type_branch_value = TRY (type__new(&op.expression.full_type_mut()));
      END
      MUTABLE expression_type: Type = expression_type_branch_value?;
      MUTABLE outer_fallible = tenseEnvelope__split_future(tense_plan.envelope).outer |> ANY (_.kind == TenseLayerKind.Fallible);
      MUTABLE promise_source =     IF selector IS_A TryExpr THEN
        selector.expr().without_try()
      ELSE
        selector.without_try()
      END;
      MUTABLE promise_value = TryExpr{ expr: COPY promise_source, lowered_node_id: NIL, ownership_consumption: NIL };
      &selector_prefix.append(Emittable{ Let: COPY Let{ name: COPY promise_name, init: Emittable{ TryExpr: COPY promise_value }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
      MUTABLE promise_type_branch_value: ?Type = NIL;
      IF outer_fallible THEN
        promise_type_branch_value = UNWRAP (TRY (type__payload_type(expression_type)));
      ELSE
        promise_type_branch_value = expression_type;
      END
      MUTABLE promise_type: Type = promise_type_branch_value?;
      MUTABLE async_shape = TRY (asyncResultShape__promise(TRY (type__tense_type(promise_type))));
      MUTABLE next_contract = callableContract__new((TRY (callableContract__no_ownership(0))).signature, TRY (ownershipContract__consume_operands([ownershipOperandFact__owned_binding(promise_name, promise_type, "stream SELECT awaits selector promise", :heap)])), 0);
      MUTABLE next_call = MIRMethodCall{ receiver: Ident{ name: COPY promise_name, lowered_node_id: NIL, ownership_consumption: NIL }, method: "next", args: ( { MUTABLE rtoc_empty_list_28: []Any = List[]; rtoc_empty_list_28 } ), try_wrap: !(asyncResultShape__boxes_fallible_payload?(async_shape)), callable_contract: COPY next_contract, owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
      IF asyncResultShape__boxes_fallible_payload?(async_shape) THEN
        selector = Emittable{ AsyncPayloadTake: COPY AsyncPayloadTake{ source: Emittable{ TryExpr: COPY TryExpr{ expr: Emittable{ MIRMethodCall: COPY next_call }, lowered_node_id: NIL, ownership_consumption: NIL } }, result_type: COPY TRY (type__new(castTypeToTypeConstructionInput(async_shape.payload_type))) } };
      ELSE
        selector = Emittable{ MIRMethodCall: COPY next_call };
      END
    END
    MUTABLE identity_selector = pipelinePlaceholderUsage__identity_placeholder?(op.expression);
    MUTABLE fresh_composite = ((((selector IS_A StructInit OR selector IS_A TupleLiteral) OR selector IS_A ArrayInit)) AND TRY (type__recursive_cleanup_shape?(item_type, pipelineHost__pipeline_schema_lookup(rtoc_self_view))));
    MUTABLE selector_owned = (((ownershipEffect__of(selector).produces_owned OR (selector_prefix |> ANY _ IS_A AllocMark))) OR fresh_composite);
    IF ((!(selector_owned) AND !(identity_selector)) AND TRY (type__recursive_cleanup_shape?(item_type, pipelineHost__pipeline_schema_lookup(rtoc_self_view)))) THEN
      selector = Emittable{ DeepCopy: COPY DeepCopy{ source: selector, zig_type: COPY TRY (type__zig_type(item_type)), elem_type: NIL, strategy: :full_value, alloc: :heap, copy_shape: NIL, type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL } };
      selector_owned = TRUE;
    END
    MUTABLE push_stmts: []Emittable = ( { MUTABLE rtoc_empty_list_29: []Emittable = List[]; rtoc_empty_list_29 } );
    IF selector_owned THEN
      MUTABLE push_contract: ?CallableContract@multiowned = NIL;
      MUTABLE transfer_name: ?String = NIL;
      MUTABLE pushed: ?Emittable = NIL;
      IF selector IS_A Ident AS ident THEN
        MUTABLE ident_mutable = COPY ident;
        transfer_name = COPY ident_mutable.name;
        MUTABLE rtoc_idx = 0;
        WHILE rtoc_idx < selector_prefix.length() DO
      IF !((((selector_prefix[rtoc_idx]? IS_A Cleanup OR selector_prefix[rtoc_idx]? IS_A ErrCleanup)) AND (CAST((selector_prefix[rtoc_idx]?.name()) AS String) == transfer_name))) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE rtoc_mutable_receiver_30 = (selector_prefix[rtoc_idx]?.cleanup_entry());
      cleanupEntry__mark_moved_guard_mut(&rtoc_mutable_receiver_30);
    rtoc_idx = rtoc_idx + 1;
        END
        pushed = Emittable{ Ident: COPY ident_mutable };
      ELSE
        transfer_name = "__select_push${id.toString()}";
        MUTABLE entry = (TRY (cleanupClassifier__owned_value_entry(item_type, pipelineHost__pipeline_schema_lookup(rtoc_self_view))) OR_ELSE cleanupEntry__build(:uniform, :heap, TRUE, NIL, TRY (type__zig_type(item_type))));
        entry = cleanupEntry__with_alloc(entry, :heap);
        cleanupEntry__mark_moved_guard_mut(&entry);
        &push_stmts.append(Emittable{ AllocMark: COPY AllocMark{ name: UNWRAP (COPY transfer_name), alloc: :heap, type_info: COPY item_type, scope: :heap, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
        &push_stmts.append(Emittable{ Let: COPY Let{ name: COPY UNWRAP (COPY transfer_name), init: COPY selector, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
        &push_stmts.append(Emittable{ ErrCleanup: COPY ErrCleanup{ name: transfer_name, cleanup_entry: entry, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
        pushed = Emittable{ Ident: COPY Ident{ name: UNWRAP (COPY transfer_name), lowered_node_id: NIL, ownership_consumption: NIL } };
      END
      push_contract = callableContract__new((TRY (callableContract__no_ownership(1))).signature, TRY (ownershipContract__consume_operands([ownershipOperandFact__owned_binding(UNWRAP (transfer_name), item_type, "stream SELECT push transfers the item to the consumer", :heap)])), 1);
      &push_stmts.append(Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ MethodCall: COPY MIRMethodCall{ receiver: Ident{ name: COPY local_stream, lowered_node_id: NIL, ownership_consumption: NIL }, method: "push", args: [CAST(pushed AS Any)], try_wrap: TRUE, callable_contract: COPY push_contract, owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
      push_stmts = ruby_array_concat_Emittable(push_stmts, CAST(TRY (ownershipTransferPlan__marks((OwnershipTransferPlan{ name: UNWRAP (COPY transfer_name), target: :owned_sink, target_alloc: :heap, move_guarded: TRUE }))) AS []Emittable));
    ELSE
      &push_stmts.append(Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ MethodCall: COPY MIRMethodCall{ receiver: Ident{ name: COPY local_stream, lowered_node_id: NIL, ownership_consumption: NIL }, method: "push", args: [CAST(selector AS Any)], try_wrap: TRUE, callable_contract: COPY TRY (callableContract__no_ownership(1)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
    END
    MUTABLE item_body: []Emittable = (selector_prefix + push_stmts);
    MUTABLE source_item_type: ?Type = TRY (type__runtime_stream_storage_element_type(source_type));
    IF ((!(type__array?(source_type)) AND (source_item_type != NIL)) AND !(pipelinePlaceholderUsage__identity_placeholder?(op.expression))) THEN
      MUTABLE owned_stmts = TRY (pipelineRangeLowerer__owned_stream_item_stmts(rtoc_self_view.range_lowerer, "__select_item", source_item_type));
      IF !((owned_stmts.length() == 0)) THEN
        item_body = (owned_stmts + item_body);
      END
    END
    MUTABLE source_ref = FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "ctx", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "source", lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE loop =   IF type__array?(source_type) THEN
      ForStmt{ iter: Emittable{ ItemsAccess: COPY ItemsAccess{ expr: Emittable{ FieldGet: COPY source_ref }, safe: TRUE, lowered_node_id: NIL, ownership_consumption: NIL } }, capture: "__select_item", body: Body{ ArrayValue: item_body |> SELECT castEmittableToLocatable(_) }, index_capture: NIL, mark_per_iter: NIL, tight: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }
    ELSE
      {
    MUTABLE rtoc_value_block_marker = 0;
      IF (TRY (type__inf_stream?(source_type)) OR TRY (type__bounded_stream?(source_type))) THEN
      next_method = "nextOrNull";
    ELSE
      next_method = "next";
    END
    WhileStmt{ cond: Emittable{ MethodCall: COPY MIRMethodCall{ receiver: source_ref, method: COPY next_method, args: ( { MUTABLE rtoc_empty_list_32: []Any = List[]; rtoc_empty_list_32 } ), try_wrap: TRUE, callable_contract: COPY TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, body: Body{ ArrayValue: item_body |> SELECT castEmittableToLocatable(_) }, capture: "__select_item", update: NIL, mark_per_iter: NIL, tight: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }
    }
    END;
    MUTABLE stream_zig: String = "";
    IF TRY (type__inf_stream?(stream_type)) THEN
      stream_zig = "CheatLib.InfStream(${TRY (type__nested_zig_type(item_type))})";
    ELSE_IF TRY (type__bounded_stream?(stream_type)) THEN
      stream_zig = "CheatLib.BoundedStream(${TRY (type__nested_zig_type(item_type))}, ${TRY (type__stream_capacity(stream_type))})";
    ELSE
      stream_zig = "CheatLib.Stream(${TRY (type__nested_zig_type(item_type))})";
    END
    MUTABLE task_config = TaskConfigPlan{ stack_variant: "Large", profile_site_id: NIL, profile_dispatch_id: NIL };
    MUTABLE spawn_call = FiberSpawnCall{ target: :runtime_submit, runtime_name: "rt", ctx_type: COPY ctx_type, ctx_var: COPY ctx_var, task_config: COPY task_config, wait_group_name: NIL, pass_ctx_by_address: FALSE };
    MUTABLE plan = BgStreamPlan{ id: (10000 + id), ctx_type: COPY ctx_type, alloc_var: COPY alloc_var, stream_var: COPY stream_var, ctx_var: COPY ctx_var, blk_label: COPY label, stream_zig: COPY stream_zig, local_stream: COPY local_stream, capture_fields: COPY capture_fields, capture_inits: COPY capture_inits, promoted_decls: COPY caps.specs |> UNNEST _.setup_mir, capture_cleanups: COPY caps.specs |> SELECT:? TRY (captureSpec__cleanup_mir_for(_, "ctx")) |> WHERE _ != NIL, body: [loop], spawn_call: COPY spawn_call, rt_name: "rt" };
    MUTABLE bg = MIRBgBlock{ code: BgBlockPlan{ BgStreamPlan: COPY plan }, captures: COPY (analysis?.captures OR_ELSE {}), run_body: [loop], fsm_structure: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, boundary_fact: NIL, result_type: NIL };
    bg.result_type = result_type;
    bg.boundary_fact = pipelineLoweringBridge__execution_boundary_fact(rtoc_self_view.lowering_bridge, :bg_stream, :local, analysis);
    RETURN bg;
}
END
PRIVATE FN pipelineHost__select_tense_plan(self: PipelineHost, op: SelectOp) RETURNS !TenseSelectorPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE plan: ?TensePlanValue = COPY op.tense_plan;
    IF plan EXISTS AS plan_value THEN
      RETURN CAST(plan_value AS TenseSelectorPlan);
    ELSE
      panic("SELECT reached MIR without an annotation-produced tense plan");
    END
}
END
