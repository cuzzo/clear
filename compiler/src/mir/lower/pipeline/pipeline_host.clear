PRIVATE FN pipelineHost__lower_soa_scalar_fold(MUTABLE self: PipelineHost, site: PipelineSite, fold_node: PipelineMaterializedScalarOp) RETURNS !MIRBlockExpr
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE list_node = COPY site.list;
    MUTABLE label = pipelineHost__next_pipe_label(&rtoc_self_view);
    MUTABLE source_mir = pipelineHost__visit_mir(rtoc_self_view, list_node);
    pipelineHost__set_current_pipe_label(&rtoc_self_view, label);
    MUTABLE expr_mir: ?Emittable = NIL;
    MUTABLE fields: []String = ( { MUTABLE rtoc_empty_list_33: []String = List[]; rtoc_empty_list_33 } );
    MUTABLE needs_whole_item: Bool = FALSE;
    pipelineHost__with_soa_rewrite(&rtoc_self_view, FALSE, %() USE(fold_node, MUTABLE rtoc_self_view) -> {
      expr_mir = pipelineHost__with_pipeline_context(&rtoc_self_view, "it", %() USE(fold_node, rtoc_self_view) -> pipelineHost__visit_mir(rtoc_self_view, (MATCH fold_node START PipelineMaterializedScalarOp.CountOpMultiowned AS item -> item.expression, PipelineMaterializedScalarOp.SumOpMultiowned AS item -> item.expression, PipelineMaterializedScalarOp.AverageOpMultiowned AS item -> item.expression, PipelineMaterializedScalarOp.MinOpMultiowned AS item -> item.expression, PipelineMaterializedScalarOp.MaxOpMultiowned AS item -> item.expression, PipelineMaterializedScalarOp.AnyOpMultiowned AS item -> item.expression, PipelineMaterializedScalarOp.AllOpMultiowned AS item -> item.expression, PipelineMaterializedScalarOp.FindOpMultiowned AS item -> item.expression END)));
    fields = (pipelineHost__current_context(rtoc_self_view).soa_needed_fields |> SELECT _.toString()) |> ORDER_BY _;
    needs_whole_item = (fold_node IS_A FindOp OR !(!(((TRUE AND pipelineHost__ast_uses_bare_placeholder?(rtoc_self_view, (MATCH fold_node START PipelineMaterializedScalarOp.CountOpMultiowned AS item -> item.expression, PipelineMaterializedScalarOp.SumOpMultiowned AS item -> item.expression, PipelineMaterializedScalarOp.AverageOpMultiowned AS item -> item.expression, PipelineMaterializedScalarOp.MinOpMultiowned AS item -> item.expression, PipelineMaterializedScalarOp.MaxOpMultiowned AS item -> item.expression, PipelineMaterializedScalarOp.AnyOpMultiowned AS item -> item.expression, PipelineMaterializedScalarOp.AllOpMultiowned AS item -> item.expression, PipelineMaterializedScalarOp.FindOpMultiowned AS item -> item.expression END)))))));
    NIL
    });
    RETURN TRY (pipelineHost__build_soa_scalar_fold_block(rtoc_self_view, site, fold_node, label, source_mir, UNWRAP (expr_mir), fields, needs_whole_item));
}
END
PRIVATE FN pipelineHost__build_soa_scalar_fold_block(self: PipelineHost, site: PipelineSite, fold_node: PipelineMaterializedScalarOp, label: String, source_mir: Emittable, expr_mir: Emittable, fields: []String, needs_whole_item: Bool) RETURNS !MIRBlockExpr
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE list_node = COPY site.list;
    MUTABLE lhs_type = TRY (aST__full_type_mut(list_node));
    MUTABLE smooth_node = COPY site.options;
    MUTABLE len_expr_branch_value: ?MIRCast = NIL;
    IF lhs_type.pool?() THEN
      len_expr_branch_value = MIRCast{ expr: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__soa_src", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "live_count", lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: "usize", method: :intCast, lowered_node_id: NIL, ownership_consumption: NIL };
    ELSE
      len_expr_branch_value = MIRCast{ expr: Emittable{ ListLength: COPY ListLength{ expr: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__soa_src", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "data", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: "usize", method: :intCast, lowered_node_id: NIL, ownership_consumption: NIL };
    END
    MUTABLE len_expr: MIRCast = len_expr_branch_value?;
    MUTABLE iter_expr = IterRange{ start: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL }, end_val: COPY MIRCast{ expr: Emittable{ ListLength: COPY ListLength{ expr: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__soa_src", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "data", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: "usize", method: :intCast, lowered_node_id: NIL, ownership_consumption: NIL }, capture_type: :usize, lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE pre_loop = ([Let{ name: COPY "__soa_src", init: Emittable{ MIRUnaryOp: COPY MIRUnaryOp{ op: "&", operand: COPY source_mir, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }] + fields |> SELECT Let{ name: Name{ StringValue: COPY "__soa_${_}" }, init: Emittable{ SoaFieldAccess: COPY SoaFieldAccess{ soa_expr: COPY Ident{ name: "__soa_src", lowered_node_id: NIL, ownership_consumption: NIL }, field_name: COPY _, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL });
    MUTABLE loop_prefix = List[];
    IF lhs_type.pool?() THEN
      &loop_prefix.append(IfStmt{ cond: Emittable{ MIRUnaryOp: COPY MIRUnaryOp{ op: "!", operand: Emittable{ IndexGet: COPY IndexGet{ object: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__soa_src", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "alive", lowered_node_id: NIL, ownership_consumption: NIL } }, index: Emittable{ Ident: COPY Ident{ name: "__soa_i", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: [ContinueStmt{ unused: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL });
    END
    IF needs_whole_item THEN
      &loop_prefix.append(Let{ name: COPY "it", init: Emittable{ MethodCall: COPY MIRMethodCall{ receiver: FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__soa_src", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "data", lowered_node_id: NIL, ownership_consumption: NIL }, method: "get", args: [CAST(Ident{ name: "__soa_i", lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(1)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL });
    END
    MUTABLE result_type = pipelineHost__transpile_type(rtoc_self_view, Type{ StringValue: COPY type__to_s((TRY (aST__full_type_mut(smooth_node)))) });
    MUTABLE init_stmts = List[];
    MUTABLE loop_body = List[];
    MUTABLE final_expr = NIL;
    IF fold_node IS_A CountOp@multiowned AS count_op_multiowned THEN
      &init_stmts.append(Let{ name: COPY "count_result", init: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: COPY TRY (type__new(TypeConstructionInput{ StringValue: COPY "i64" })), suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL });
      &loop_body.append(IfStmt{ cond: COPY expr_mir, then_body: [Set{ target: Emittable{ Ident: COPY Ident{ name: "count_result", lowered_node_id: NIL, ownership_consumption: NIL } }, value: COPY BinOp{ op: "+", left: Emittable{ Ident: COPY Ident{ name: "count_result", lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Lit: COPY Lit{ value: "1", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL }, needs_field_cleanup: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL });
      final_expr = Ident{ name: "count_result", lowered_node_id: NIL, ownership_consumption: NIL };
    ELSE_IF fold_node IS_A SumOp@multiowned AS sum_op_multiowned THEN
      &init_stmts.append(Let{ name: COPY "sum_result", init: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: COPY TRY (type__new(TypeConstructionInput{ StringValue: COPY result_type })), suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL });
      &loop_body.append(Set{ target: Emittable{ Ident: COPY Ident{ name: "sum_result", lowered_node_id: NIL, ownership_consumption: NIL } }, value: COPY BinOp{ op: "+", left: Emittable{ Ident: COPY Ident{ name: "sum_result", lowered_node_id: NIL, ownership_consumption: NIL } }, right: COPY expr_mir, lowered_node_id: NIL, ownership_consumption: NIL }, needs_field_cleanup: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
      final_expr = Ident{ name: "sum_result", lowered_node_id: NIL, ownership_consumption: NIL };
    ELSE_IF fold_node IS_A AverageOp@multiowned AS average_op_multiowned THEN
      &init_stmts.append(Let{ name: COPY "avg_sum", init: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: COPY TRY (type__new(TypeConstructionInput{ StringValue: COPY "f64" })), suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL });
      &init_stmts.append(Let{ name: COPY "avg_count", init: Emittable{ MIRCast: COPY len_expr }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL });
      &loop_body.append(Set{ target: Emittable{ Ident: COPY Ident{ name: "avg_sum", lowered_node_id: NIL, ownership_consumption: NIL } }, value: COPY BinOp{ op: "+", left: Emittable{ Ident: COPY Ident{ name: "avg_sum", lowered_node_id: NIL, ownership_consumption: NIL } }, right: COPY expr_mir, lowered_node_id: NIL, ownership_consumption: NIL }, needs_field_cleanup: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL });
      final_expr = Conditional{ cond: COPY BinOp{ op: "==", left: Emittable{ Ident: COPY Ident{ name: "avg_count", lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL }, then_val: Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: "f64", method: :as, lowered_node_id: NIL, ownership_consumption: NIL } }, else_val: COPY BinOp{ op: "/", left: Emittable{ Ident: COPY Ident{ name: "avg_sum", lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ Ident: COPY Ident{ name: "avg_count", lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: NIL, method: :floatFromInt, lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: "f64", method: :as, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL }, lowered_node_id: NIL, ownership_consumption: NIL };
    ELSE_IF fold_node IS_A MinOp@multiowned AS min_op_multiowned THEN
      &init_stmts.append(IfStmt{ cond: COPY BinOp{ op: "==", left: Emittable{ MIRCast: COPY len_expr }, right: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL }, then_body: [Panic{ message: "MIN applied to empty list", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL });
      &init_stmts.append(Let{ name: COPY "min_result", init: Emittable{ TypeSentinel: COPY TypeSentinel{ extreme: :max, zig_type: COPY result_type, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: COPY TRY (type__new(TypeConstructionInput{ StringValue: COPY result_type })), suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL });
      &loop_body.append(Let{ name: COPY "min_val", init: COPY expr_mir, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL });
      &loop_body.append(IfStmt{ cond: COPY BinOp{ op: "<", left: Emittable{ Ident: COPY Ident{ name: "min_val", lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Ident: COPY Ident{ name: "min_result", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL }, then_body: [Set{ target: Emittable{ Ident: COPY Ident{ name: "min_result", lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Ident: COPY Ident{ name: "min_val", lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL });
      final_expr = Ident{ name: "min_result", lowered_node_id: NIL, ownership_consumption: NIL };
    ELSE_IF fold_node IS_A MaxOp@multiowned AS max_op_multiowned THEN
      &init_stmts.append(IfStmt{ cond: COPY BinOp{ op: "==", left: Emittable{ MIRCast: COPY len_expr }, right: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL }, then_body: [Panic{ message: "MAX applied to empty list", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL });
      &init_stmts.append(Let{ name: COPY "max_result", init: Emittable{ TypeSentinel: COPY TypeSentinel{ extreme: :min, zig_type: COPY result_type, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: COPY TRY (type__new(TypeConstructionInput{ StringValue: COPY result_type })), suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL });
      &loop_body.append(Let{ name: COPY "max_val", init: COPY expr_mir, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL });
      &loop_body.append(IfStmt{ cond: COPY BinOp{ op: ">", left: Emittable{ Ident: COPY Ident{ name: "max_val", lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Ident: COPY Ident{ name: "max_result", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL }, then_body: [Set{ target: Emittable{ Ident: COPY Ident{ name: "max_result", lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Ident: COPY Ident{ name: "max_val", lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL });
      final_expr = Ident{ name: "max_result", lowered_node_id: NIL, ownership_consumption: NIL };
    ELSE_IF fold_node IS_A AnyOp@multiowned AS any_op_multiowned THEN
      &init_stmts.append(Let{ name: COPY "any_result", init: Emittable{ Lit: COPY Lit{ value: "false", lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL });
      &loop_body.append(IfStmt{ cond: COPY expr_mir, then_body: CAST(Tuple{Set{ target: Emittable{ Ident: COPY Ident{ name: "any_result", lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Lit: COPY Lit{ value: "true", lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }, BreakStmt{ label: NIL, value: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }} AS Tuple<Set, BreakStmt>), else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL });
      final_expr = Ident{ name: "any_result", lowered_node_id: NIL, ownership_consumption: NIL };
    ELSE_IF fold_node IS_A AllOp@multiowned AS all_op_multiowned THEN
      &init_stmts.append(Let{ name: COPY "all_result", init: Emittable{ Lit: COPY Lit{ value: "true", lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL });
      &loop_body.append(IfStmt{ cond: Emittable{ MIRUnaryOp: COPY MIRUnaryOp{ op: "!", operand: COPY expr_mir, lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: CAST(Tuple{Set{ target: Emittable{ Ident: COPY Ident{ name: "all_result", lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Lit: COPY Lit{ value: "false", lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }, BreakStmt{ label: NIL, value: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }} AS Tuple<Set, BreakStmt>), else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL });
      final_expr = Ident{ name: "all_result", lowered_node_id: NIL, ownership_consumption: NIL };
    ELSE_IF fold_node IS_A FindOp@multiowned AS find_op_multiowned THEN
      MUTABLE elem_zig_type = pipelineHost__transpile_type(rtoc_self_view, Type{ StringValue: COPY CAST((TRY (aST__full_type_mut(list_node))).element_type().resolved() AS String) });
      &init_stmts.append(Let{ name: COPY "find_result", init: Emittable{ Undef: COPY Undef{ zig_type: NIL, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: COPY TRY (type__new(TypeConstructionInput{ StringValue: COPY elem_zig_type })), suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL });
      &init_stmts.append(Let{ name: COPY "find_found", init: Emittable{ Lit: COPY Lit{ value: "false", lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL });
      &loop_body.append(Let{ name: COPY "find_matches", init: COPY expr_mir, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL });
      &loop_body.append(IfStmt{ cond: Emittable{ Ident: COPY Ident{ name: "find_matches", lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: CAST(Tuple{Set{ target: Emittable{ Ident: COPY Ident{ name: "find_result", lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Ident: COPY Ident{ name: "it", lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }, Set{ target: Emittable{ Ident: COPY Ident{ name: "find_found", lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Lit: COPY Lit{ value: "true", lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }, BreakStmt{ label: NIL, value: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }} AS Tuple<Set, Set, BreakStmt>), else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL });
      final_expr = Conditional{ cond: Emittable{ Ident: COPY Ident{ name: "find_found", lowered_node_id: NIL, ownership_consumption: NIL } }, then_val: Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ Ident: COPY Ident{ name: "find_result", lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: "?${elem_zig_type}", method: :as, lowered_node_id: NIL, ownership_consumption: NIL } }, else_val: Emittable{ Lit: COPY Lit{ value: "null", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL };
    END
    RETURN MIRBlockExpr{ label: COPY label, body: COPY (pre_loop + init_stmts + [ForStmt{ iter: Emittable{ IterRange: COPY iter_expr }, capture: "__soa_i", body: COPY (loop_prefix + loop_body), index_capture: NIL, mark_per_iter: NIL, tight: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }, BreakStmt{ label: COPY label, value: COPY final_expr, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }]), lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
}
END
