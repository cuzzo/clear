PRIVATE FN pipelineConcurrentLowerer__assignment_targets_placeholder?(self: PipelineConcurrentLowerer, node: PipelineConcurrentLowererAssignmentTargetScanNode) RETURNS Bool EFFECTS REENTRANT ->
  IF node IS_A Assignment AS assignment THEN
    RETURN pipelineConcurrentLowerer__target_rooted_at_placeholder?(self, castAssignmentNameToLocatable(assignment.name));
  END
  IF node IS_A Struct AS struct THEN
    RETURN struct.members() |> ANY (IF ([:token, :location]).contains?(_) THEN FALSE ELSE { MUTABLE rtoc_value_block_marker = 0; MUTABLE value = COPY struct[_]; (    IF value IS_A []@multiowned Any THEN
      value |> ANY (_ IS_A Struct AND pipelineConcurrentLowerer__assignment_targets_placeholder?(self, _))
    ELSE_IF value IS_A Struct THEN
      pipelineConcurrentLowerer__assignment_targets_placeholder?(self, value)
    ELSE
      FALSE
    END) } END);
  ELSE
    RETURN FALSE;
  END
END
PRIVATE FN pipelineConcurrentLowerer__target_rooted_at_placeholder?(self: PipelineConcurrentLowerer, target: Locatable) RETURNS Bool ->
  RETURN ((aST__root_identifier(target) != NIL) AND (((aST__root_identifier(target))?).name == "_"));
END
