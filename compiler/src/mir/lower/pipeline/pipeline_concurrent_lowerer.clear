    RETURN PipelineConcurrentResult{ MIRBlockExpr: COPY TRY (pipelineConcurrentLowerer__lower_concurrent_bounded_select(self, &lhs, plan.conc_op, castLocatableToSelectOp(plan.inner))) };
  ELSE_IF (terminal_kind == PipelineConcurrentTerminalKind.Where) THEN
    RETURN PipelineConcurrentResult{ MIRBlockExpr: COPY TRY (pipelineConcurrentLowerer__lower_concurrent_bounded_where(self, &lhs, plan.conc_op, castLocatableToWhereOp(plan.inner))) };
  ELSE_IF (terminal_kind == PipelineConcurrentTerminalKind.Each) THEN
    RETURN PipelineConcurrentResult{ ScopeBlock: COPY TRY (pipelineConcurrentLowerer__lower_concurrent_bounded_each(self, &lhs, plan.conc_op, castLocatableToEachOp(plan.inner))) };
  ELSE
    panic("CONCURRENT over bounded streams only supports SELECT/WHERE/EACH");
  END
END
