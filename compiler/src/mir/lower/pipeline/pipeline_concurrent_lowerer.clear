REQUIRE "pkg:rtoc_6173742f747970652e636c656172" AS type
REQUIRE "pkg:rtoc_6173742f6173742e636c656172" AS ast
REQUIRE "pkg:rtoc_6173742f73796d626f6c5f656e7472792e636c656172" AS symbol_entry
REQUIRE "pkg:rtoc_6d69722f6d69722e636c656172" AS mir
REQUIRE "pkg:rtoc_6d69722f636c65616e75705f656e7472792e636c656172" AS cleanup_entry
REQUIRE "pkg:rtoc_6d69722f66696265725f6374785f6275696c6465722e636c656172" AS fiber_ctx_builder
REQUIRE "pkg:rtoc_6173742f706172616d2e636c656172" AS param
UNION Inner { AverageOp: AverageOp, MaxOp: MaxOp, MinOp: MinOp, SumOp: SumOp }
UNION ReturnType { StringValue: String, SymbolValue: String@symbol, Type: Type }
PUB UNION PipelineConcurrentResult { MIRBlockExpr: MIRBlockExpr, ForStmt: ForStmt, ScopeBlock: ScopeBlock, ShardConcurrentEach: ShardConcurrentEach }
PUB STRUCT PipelineConcurrentBcExpression {
  policy: String@symbol,
  expr: Locatable
}
PUB ENUM PipelineConcurrentSourceKind { ShardEach, BcMaterialized, BoundedStream, RuntimeStream, RuntimeList }
PUB ENUM PipelineConcurrentTerminalKind { Select, Where, Each, Count, Sum, Average, Min, Max, Unsupported }
PUB ENUM PipelineConcurrentCallbackBodyKind { Expr, Each }
PUB ENUM PipelineConcurrentReduceKind { Sum, Average, Min, Max }
PUB STRUCT PipelineConcurrentPlan {
  source_kind: PipelineConcurrentSourceKind,
  terminal_kind: PipelineConcurrentTerminalKind,
  lhs: Locatable,
  real_lhs: Locatable,
  smooth_node: BinaryOp,
  conc_op: ConcurrentOp,
  inner: Locatable,
  binding_name: ?String,
  shard_context: ?PipelineShardContext,
  bc_expression: ?PipelineConcurrentBcExpression,
  list_each_mutates_placeholder: Bool
}
PUB STRUCT PipelineConcurrentAllocationFact {
  alloc: String@symbol,
  mark: AllocMark,
  cleanup_entry: ?CleanupEntry@multiowned
}
PUB STRUCT PipelineConcurrentHeadResult {
  value: Emittable,
  pending: []Emittable
}
PUB STRUCT PipelineConcurrentCallback {
  id: Int64,
  ctx_name: String,
  ctx_def: MIRStructDef,
  ctx_var: String,
  ctx_let: Let,
  pre_ctx_stmts: []Emittable,
  post_ctx_stmts: []Emittable,
  apply_ident: Emittable,
  context_arg: AddressOf,
  context_stmts: []Emittable
}
PUB STRUCT PipelineConcurrentInvocation {
  id: Int64,
  apply_ident: Emittable,
  context_arg: AddressOf,
  context_stmts: []Emittable,
  worker_count: Emittable,
  batch_size: Emittable,
  parallel: Emittable,
  task_config: Emittable,
  bounded_runtime_args: []Emittable
}

PUB FN pipelineConcurrentInvocation__sharded_each_args(self: PipelineConcurrentInvocation, source_pointer: Emittable, alive_filter: Emittable) RETURNS ![]Emittable ->
  RETURN CAST([self.apply_ident, Emittable{ Ident: COPY Ident{ name: "rt", lowered_node_id: NIL, ownership_consumption: NIL } }, source_pointer, alive_filter, self.task_config, Emittable{ AddressOf: COPY self.context_arg }] AS []Emittable);
END
PUB FN pipelineConcurrentInvocation__bounded_each_args(self: PipelineConcurrentInvocation, source_pointer: Emittable) RETURNS ![]Emittable ->
  RETURN CAST((CAST([self.apply_ident, Emittable{ Ident: COPY Ident{ name: "rt", lowered_node_id: NIL, ownership_consumption: NIL } }, source_pointer] AS []Emittable) + COPY self.bounded_runtime_args) AS []Emittable);
END
PUB FN pipelineConcurrentInvocation__bounded_allocating_args(self: PipelineConcurrentInvocation, source_pointer: Emittable, alloc: String@symbol) RETURNS ![]Emittable ->
  RETURN CAST((CAST([self.apply_ident, Emittable{ AllocatorRef: COPY AllocatorRef{ kind: COPY alloc, lowered_node_id: NIL, ownership_consumption: NIL } }, Emittable{ Ident: COPY Ident{ name: "rt", lowered_node_id: NIL, ownership_consumption: NIL } }, source_pointer] AS []Emittable) + COPY self.bounded_runtime_args) AS []Emittable);
END
PUB FN pipelineConcurrentInvocation__stream_allocating_args(self: PipelineConcurrentInvocation, source_pointer: Emittable, capacity: Emittable, alloc: String@symbol, is_inf: Emittable) RETURNS ![]Emittable ->
  RETURN CAST([self.apply_ident, is_inf, Emittable{ AllocatorRef: COPY AllocatorRef{ kind: COPY alloc, lowered_node_id: NIL, ownership_consumption: NIL } }, Emittable{ Ident: COPY Ident{ name: "rt", lowered_node_id: NIL, ownership_consumption: NIL } }, source_pointer, self.worker_count, capacity, self.batch_size, self.parallel, self.task_config, Emittable{ AddressOf: COPY self.context_arg }] AS []Emittable);
END
PUB FN pipelineConcurrentInvocation__stream_each_args(self: PipelineConcurrentInvocation, source_pointer: Emittable, capacity: Emittable, alloc: String@symbol, is_inf: Emittable) RETURNS ![]Emittable ->
  RETURN CAST([self.apply_ident, is_inf, Emittable{ AllocatorRef: COPY AllocatorRef{ kind: COPY alloc, lowered_node_id: NIL, ownership_consumption: NIL } }, Emittable{ Ident: COPY Ident{ name: "rt", lowered_node_id: NIL, ownership_consumption: NIL } }, source_pointer, self.worker_count, capacity, self.batch_size, self.parallel, self.task_config, Emittable{ AddressOf: COPY self.context_arg }] AS []Emittable);
END
PUB FN pipelineConcurrentInvocation__scoped_body(self: PipelineConcurrentInvocation, before_context: []Emittable, after_context: []Emittable) RETURNS ![]Emittable ->
  RETURN CAST((COPY before_context + COPY self.context_stmts + COPY after_context) AS []Emittable);
END
PUB STRUCT PipelineConcurrentSourcePointer {
  setup: []Emittable,
  pointer: Emittable
}
PUB STRUCT PipelineConcurrentLowerer {
  bc_target: FN() -> Bool,
  visit_mir: FN(Locatable) -> Emittable,
  visit_mir_with_placeholder: FN(Locatable, String) -> Emittable,
  visit_body_with_placeholder: FN(Locatable[], String) -> ![]Emittable,
  lower_head_with_placeholder: FN(Locatable, String) -> PipelineConcurrentHeadResult,
  callback_expr_mir: FN(Locatable, String, {String}String, {String}SymbolEntry@multiowned, String) -> Emittable,
  callback_body_mir: FN(Locatable[], String, HashMap<String, String>, HashMap<String, SymbolEntry@multiowned>, String) -> ![]Emittable,
  callback_body_mir_with_shard: FN(Locatable[], String, HashMap<String, String>, HashMap<String, SymbolEntry@multiowned>, String, ?HashMap<String@symbol, String>) -> ![]Emittable,
  pipeline_alloc_mark_fact: FN(Emittable, String, String@symbol, Type, Locatable, Bool, Bool) -> ?PipelineConcurrentAllocationFact,
  append_ownership_transfers: FN(Emittable[]) -> ![]Emittable,
  pipeline_block: FN(Locatable, FN(String, String) -> !Emittable[]) -> MIRBlockExpr,
  transpile_type: FN(String) -> String,
  pipeline_alloc: FN(BinaryOp) -> String@symbol,
  pipeline_result_alloc: FN() -> String@symbol,
  source_setup: FN(Locatable) -> ![]Emittable,
  emit_builtin: FN(String@symbol, Emittable[]) -> Emittable,
  lower_mir: FN(Locatable) -> Emittable,
  next_label: FN() -> String,
  typed_block_expr: FN(String, Emittable[], Type) -> MIRBlockExpr,
  task_config_variant: FN(?String@symbol) -> String,
  guarded_cleanup_name: FN(String) -> Bool,
  do_rt_name: FN() -> String,
  agg_min_sentinel_mir: FN(String) -> TypeSentinel,
  agg_max_sentinel_mir: FN(String, Type) -> Any@multiowned,
  lower_select: FN(Locatable, BinaryOp, Locatable) -> PipelineConcurrentResult,
  lower_where: FN(Locatable, BinaryOp, Locatable) -> PipelineConcurrentResult,
  lower_each: FN(Locatable, BinaryOp, EachOp) -> PipelineConcurrentResult,
  lower_sum: FN(Locatable, BinaryOp, SumOp) -> PipelineConcurrentResult,
  lower_count: FN(Locatable, BinaryOp, CountOp) -> PipelineConcurrentResult,
  lower_min: FN(Locatable, BinaryOp, MinOp) -> PipelineConcurrentResult,
  lower_max: FN(Locatable, BinaryOp, MaxOp) -> PipelineConcurrentResult,
  lower_average: FN(Locatable, BinaryOp, AverageOp) -> PipelineConcurrentResult,
  with_optional_named_binding: FN(?String, String, FN() -> PipelineConcurrentResult) -> PipelineConcurrentResult
}

PUB FN pipelineConcurrentLowerer__lower(self: PipelineConcurrentLowerer, smooth_node: BinaryOp, conc_op: ConcurrentOp) RETURNS !PipelineConcurrentResult ->
  RETURN TRY (pipelineConcurrentLowerer__lower_plan(self, TRY (pipelineConcurrentLowerer__concurrent_plan(self, smooth_node, conc_op))));
END
PRIVATE FN pipelineConcurrentLowerer__concurrent_plan(self: PipelineConcurrentLowerer, smooth_node: BinaryOp, conc_op: ConcurrentOp) RETURNS !PipelineConcurrentPlan ->
  MUTABLE lhs: Locatable = COPY castLocatableToLocatable(smooth_node.left);
  MUTABLE inner: Locatable = COPY CAST(conc_op.op AS Locatable);
  MUTABLE binding_name, real_lhs = pipelineConcurrentLowerer__unwrap_binding_source(self, lhs);
  MUTABLE lhs_type = TRY (aST__full_type_mut(lhs));
  MUTABLE real_lhs_type = TRY (aST__full_type_mut(real_lhs));
  MUTABLE terminal_kind = pipelineConcurrentLowerer__concurrent_terminal_kind(self, inner);
  MUTABLE source_kind: ?PipelineConcurrentSourceKind = pipelineConcurrentLowerer__concurrent_source_kind(self, lhs, real_lhs, lhs_type, real_lhs_type, conc_op);
  IF !(source_kind) THEN
    TRY (pipelineConcurrentLowerer__unsupported_concurrent_shape_mut(self, lhs, lhs_type, inner));
  END
  RETURN PipelineConcurrentPlan{ source_kind: UNWRAP (COPY source_kind), terminal_kind: COPY terminal_kind, lhs: COPY lhs, real_lhs: COPY real_lhs, smooth_node: COPY smooth_node, conc_op: COPY conc_op, inner: COPY inner, binding_name: COPY binding_name, shard_context: COPY pipelineConcurrentLowerer__shard_context(self, conc_op), bc_expression: COPY pipelineConcurrentLowerer__bc_expression_for(self, terminal_kind, inner), list_each_mutates_placeholder: pipelineConcurrentLowerer__list_each_mutates_placeholder?(self, UNWRAP (source_kind), terminal_kind, inner) };
END
PRIVATE FN pipelineConcurrentLowerer__lower_plan(self: PipelineConcurrentLowerer, plan: PipelineConcurrentPlan) RETURNS !PipelineConcurrentResult ->
  RETURN TRY (pipelineConcurrentLowerer__lower_source_plan(self, plan.source_kind, plan));
END
PRIVATE FN pipelineConcurrentLowerer__lower_source_plan(self: PipelineConcurrentLowerer, source_kind: PipelineConcurrentSourceKind, plan: PipelineConcurrentPlan) RETURNS !PipelineConcurrentResult ->
  IF (source_kind == PipelineConcurrentSourceKind.ShardEach) THEN
    RETURN TRY (pipelineConcurrentLowerer__lower_shard_concurrent_each(self, plan.lhs, plan.conc_op, plan.smooth_node));
  ELSE_IF (source_kind == PipelineConcurrentSourceKind.BcMaterialized) THEN
    RETURN TRY (pipelineConcurrentLowerer__lower_bc_plan(self, plan));
  ELSE_IF (source_kind == PipelineConcurrentSourceKind.BoundedStream) THEN
    RETURN TRY (pipelineConcurrentLowerer__lower_bounded_stream_plan(self, plan));
  ELSE_IF (source_kind == PipelineConcurrentSourceKind.RuntimeStream) THEN
    RETURN TRY (pipelineConcurrentLowerer__lower_stream_plan(self, plan));
  ELSE_IF (source_kind == PipelineConcurrentSourceKind.RuntimeList) THEN
    RETURN TRY (pipelineConcurrentLowerer__lower_list_plan(self, plan));
  ELSE
    RETURN NIL;
  END
END
PRIVATE FN pipelineConcurrentLowerer__concurrent_source_kind(self: PipelineConcurrentLowerer, MUTABLE lhs: Locatable, real_lhs: Locatable, lhs_type: Type, real_lhs_type: Type, conc_op: ConcurrentOp) RETURNS ?PipelineConcurrentSourceKind ->
  IF pipelineConcurrentLowerer__shard_context(self, conc_op) THEN
    RETURN PipelineConcurrentSourceKind.ShardEach;
  END
  IF (pipelineConcurrentLowerer__bc_target_call(self) AND !(pipelineConcurrentLowerer__stream_type?(self, lhs_type))) THEN
    RETURN PipelineConcurrentSourceKind.BcMaterialized;
  END
  IF pipelineConcurrentLowerer__bounded_identifier_stream?(self, &lhs) THEN
    RETURN PipelineConcurrentSourceKind.BoundedStream;
  END
  IF pipelineConcurrentLowerer__runtime_stream_source?(self, lhs, lhs_type) THEN
    RETURN PipelineConcurrentSourceKind.RuntimeStream;
  END
  IF (!(pipelineConcurrentLowerer__bc_target_call(self)) AND ((pipelineConcurrentLowerer__range_runtime_source?(self, real_lhs) OR pipelineConcurrentLowerer__list_runtime_source?(self, real_lhs_type)))) THEN
    RETURN PipelineConcurrentSourceKind.RuntimeList;
  END
  RETURN NIL;
END
PRIVATE FN pipelineConcurrentLowerer__concurrent_terminal_kind(self: PipelineConcurrentLowerer, inner: Locatable) RETURNS PipelineConcurrentTerminalKind ->
  IF inner IS_A SelectOp AS select_op THEN
    RETURN PipelineConcurrentTerminalKind.Select;
  ELSE_IF inner IS_A WhereOp AS where_op THEN
    RETURN PipelineConcurrentTerminalKind.Where;
  ELSE_IF inner IS_A EachOp AS each_op THEN
    RETURN PipelineConcurrentTerminalKind.Each;
  ELSE_IF inner IS_A CountOp AS count_op THEN
    RETURN PipelineConcurrentTerminalKind.Count;
  ELSE_IF inner IS_A SumOp AS sum_op THEN
    RETURN PipelineConcurrentTerminalKind.Sum;
  ELSE_IF inner IS_A AverageOp AS average_op THEN
    RETURN PipelineConcurrentTerminalKind.Average;
  ELSE_IF inner IS_A MinOp AS min_op THEN
    RETURN PipelineConcurrentTerminalKind.Min;
  ELSE_IF inner IS_A MaxOp AS max_op THEN
    RETURN PipelineConcurrentTerminalKind.Max;
  ELSE
    RETURN PipelineConcurrentTerminalKind.Unsupported;
  END
END
PRIVATE FN pipelineConcurrentLowerer__bc_expression_for(self: PipelineConcurrentLowerer, terminal_kind: PipelineConcurrentTerminalKind, inner: Locatable) RETURNS ?PipelineConcurrentBcExpression ->
  IF (terminal_kind IS_A Select) THEN
    RETURN pipelineConcurrentLowerer__bc_error_policy(self, castLocatableToSelectOp(inner).expression);
  ELSE_IF (terminal_kind == PipelineConcurrentTerminalKind.Where) THEN
    RETURN pipelineConcurrentLowerer__bc_error_policy(self, castLocatableToWhereOp(inner).expression);
  ELSE
    RETURN NIL;
  END
END
PRIVATE FN pipelineConcurrentLowerer__list_each_mutates_placeholder?(self: PipelineConcurrentLowerer, source_kind: PipelineConcurrentSourceKind, terminal_kind: PipelineConcurrentTerminalKind, inner: Locatable) RETURNS Bool ->
  IF !((source_kind == PipelineConcurrentSourceKind.RuntimeList)) THEN
    RETURN FALSE;
  END
  IF !((terminal_kind == PipelineConcurrentTerminalKind.Each)) THEN
    RETURN FALSE;
  END
  RETURN pipelineConcurrentLowerer__each_body_mutates_placeholder?(self, castLocatableToEachOp(inner).body);
END
PRIVATE FN pipelineConcurrentLowerer__unsupported_concurrent_shape_mut(self: PipelineConcurrentLowerer, lhs: Locatable, lhs_type: Type, inner: Locatable) RETURNS !Any@multiowned ->
  panic("lower_concurrent: unsupported non-legacy CONCURRENT shape lhs={} lhs_type={} op={}");
END
PUB FN pipelineConcurrentLowerer__lower_sharded_each(self: PipelineConcurrentLowerer, MUTABLE list_node: Locatable, MUTABLE each_op: EachOp) RETURNS !ScopeBlock ->
  MUTABLE lhs_type = TRY (aST__full_type_mut(list_node));
  MUTABLE item_t = TRY (type__new(lhs_type.element_type().resolved()));
  MUTABLE shard_count = type__shard_count(lhs_type);
  MUTABLE conc = ConcurrentOp{ token: COPY each_op.token, op: COPY each_op, options: {}, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, shard_context: NIL, capture_analysis: NIL };
  TRY (aST__stamp_synthetic_type_mut(Locatable{ ConcurrentOp: COPY conc }, SyntheticTypeInput{ Type: COPY &each_op.full_type_mut("sharded EACH result") }, "synthetic AST type"));
  MUTABLE cb = TRY (pipelineConcurrentLowerer__build_bounded_concurrent_callback_pointer(self, conc, item_t));
  MUTABLE invoke = pipelineConcurrentLowerer__bounded_invocation(self, conc, cb);
  MUTABLE source_mir = pipelineConcurrentLowerer__visit_mir_call(self, list_node);
  MUTABLE setup: []Let = List[];
  IF list_node IS_A Identifier AS identifier THEN
    setup = [Let{ name: COPY "__sh_each_src", init: Emittable{ AddressOf: COPY AddressOf{ expr: COPY source_mir, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }];
  ELSE
    setup = [Let{ name: COPY "__sh_each_val", init: COPY source_mir, mutable: TRUE, annotation: NIL, suppression: "_ = &__sh_each_val;", alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }, Let{ name: COPY "__sh_each_src", init: Emittable{ AddressOf: COPY AddressOf{ expr: Emittable{ Ident: COPY Ident{ name: "__sh_each_val", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }];
  END
  MUTABLE helper = IF lhs_type.pool?() THEN
    :concurrentShardedPoolEachInPlace
  ELSE
    :concurrentShardedListEachInPlace
  END;
  MUTABLE call = pipelineConcurrentLowerer__emit_builtin_call(self, helper, ([Ident{ name: COPY TRY (type__zig_type(item_t)), lowered_node_id: NIL, ownership_consumption: NIL }, Lit{ value: COPY CAST(shard_count AS String), lowered_node_id: NIL, ownership_consumption: NIL }] + TRY (pipelineConcurrentInvocation__sharded_each_args(invoke, Emittable{ Ident: COPY Ident{ name: "__sh_each_src", lowered_node_id: NIL, ownership_consumption: NIL } }, Emittable{ Lit: COPY Lit{ value: "false", lowered_node_id: NIL, ownership_consumption: NIL } }))));
  RETURN ScopeBlock{ body: Body{ ArrayValue: TRY (pipelineConcurrentInvocation__scoped_body(invoke, ( { MUTABLE rtoc_empty_list_1: []Emittable = List[]; rtoc_empty_list_1 } ), (setup + CAST([Emittable{ ExprStmt: COPY ExprStmt{ expr: COPY call, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable)))) |> SELECT castEmittableToLocatable(_) }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN pipelineConcurrentLowerer__lower_shard_concurrent_each(self: PipelineConcurrentLowerer, lhs: Locatable, conc_op: ConcurrentOp, smooth_node: BinaryOp) RETURNS !PipelineConcurrentResult ->
  MUTABLE ctx = UNWRAP (pipelineConcurrentLowerer__shard_context(self, conc_op));
  MUTABLE each_op: EachOp = COPY CAST(conc_op.op AS EachOp);
  MUTABLE range_node_branch_value: ?RangeLit = NIL;
  IF ctx.auto_detected THEN
    range_node_branch_value = COPY CAST(lhs AS RangeLit);
  ELSE
    range_node_branch_value = COPY CAST(castLocatableToBinaryOp(lhs).left AS RangeLit);
  END
  MUTABLE range_node: RangeLit = range_node_branch_value?;
  MUTABLE id = pipelineConcurrentLowerer__numeric_label_id(self, pipelineConcurrentLowerer__next_label_call(self));
  MUTABLE idx_var = "__sh${id.toString()}_i";
  MUTABLE key_var = "__sh${id.toString()}_key";
  MUTABLE start_mir = pipelineConcurrentLowerer__visit_mir_call(self, range_node.start);
  MUTABLE finish_mir = pipelineConcurrentLowerer__visit_mir_call(self, range_node.finish);
  IF !(pipelineConcurrentLowerer__bc_target_call(self)) THEN
    RETURN PipelineConcurrentResult{ ShardConcurrentEach: COPY TRY (pipelineConcurrentLowerer__lower_shard_concurrent_each_zig(self, ctx, each_op, conc_op, range_node, id, idx_var, key_var, start_mir, finish_mir)) };
  END
  MUTABLE end_mir = finish_mir;
  MUTABLE end_expr_branch_value: ?BinOp = NIL;
  IF range_node.inclusive THEN
    end_expr_branch_value = BinOp{ op: "+", left: COPY end_mir, right: Emittable{ Lit: COPY Lit{ value: "1", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL };
  ELSE
    end_expr_branch_value = end_mir;
  END
  MUTABLE end_expr: BinOp = end_expr_branch_value?;
  MUTABLE head = pipelineConcurrentLowerer__lower_head_with_placeholder_call(self, ctx.key_expr, idx_var);
  MUTABLE body_mir = TRY (pipelineConcurrentLowerer__visit_body_with_placeholder_call(self, each_op.body, key_var));
  MUTABLE inner: []Emittable = ( { MUTABLE rtoc_empty_list_2: []Emittable = List[]; rtoc_empty_list_2 } );
  IF ctx.key_allocates_frame THEN
    inner = ruby_array_concat_Emittable(inner, TRY (pipelineConcurrentLowerer__shard_loop_mark_pair(self, "__sh${id.toString()}_loop_mark", pipelineConcurrentLowerer__do_rt_name_call(self))));
  END
  inner = ruby_array_concat_Emittable(inner, head.pending);
  MUTABLE fact: ?PipelineConcurrentAllocationFact = pipelineConcurrentLowerer__pipeline_alloc_mark_fact_call(self, head.value, key_var, :heap, TRY (type__from_node_mut(ctx.key_expr, "SHARD key binding")), ctx.key_expr, TRUE, TRUE);
  IF fact EXISTS AS fact_value THEN
    &inner.append(Emittable{ AllocMark: COPY fact_value.mark });
    &inner.append(Emittable{ Let: COPY Let{ name: COPY key_var, init: COPY head.value, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
    IF KEEP fact_value.cleanup_entry EXISTS AS cleanup_entry_value THEN
      &inner.append(castCleanupToEmittable(Cleanup{ name: COPY key_var, cleanup_entry: COPY cleanup_entry_value, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }));
    END
  ELSE
    &inner.append(Emittable{ Let: COPY Let{ name: COPY key_var, init: COPY head.value, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
  END
  inner = ruby_array_concat_Emittable(inner, CAST(body_mir AS []Emittable));
  RETURN PipelineConcurrentResult{ ForStmt: COPY ForStmt{ iter: Emittable{ IterRange: COPY IterRange{ start: start_mir, end_val: end_expr, capture_type: :i64, lowered_node_id: NIL, ownership_consumption: NIL } }, capture: COPY idx_var, body: COPY TRY (pipelineConcurrentLowerer__append_ownership_transfers_call(self, inner)), index_capture: NIL, mark_per_iter: NIL, tight: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
END
PRIVATE FN pipelineConcurrentLowerer__lower_shard_concurrent_each_zig(self: PipelineConcurrentLowerer, ctx: PipelineShardContext, each_op: EachOp, conc_op: ConcurrentOp, range_node: RangeLit, id: Int64, idx_var: String, key_var: String, start_mir: Emittable, finish_mir: Emittable) RETURNS !ShardConcurrentEach ->
  MUTABLE map_node: Identifier = COPY castLocatableToIdentifier(ctx.map_var);
  MUTABLE map_var_name = COPY map_node.name;
  MUTABLE map_type = TRY (type__from_node_mut(map_node, "SHARD target map"));
  MUTABLE shard_count: ?Int64 = (IF ctx.shard_count != NIL THEN ctx.shard_count ELSE type__shard_count(map_type) END);
  IF shard_count EXISTS AS shard_count_value THEN
    MUTABLE key_type = pipelineConcurrentLowerer__shard_key_type(self, map_type);
    MUTABLE head = pipelineConcurrentLowerer__lower_head_with_placeholder_call(self, ctx.key_expr, idx_var);
    MUTABLE key_setup: []Emittable = COPY head.pending;
    MUTABLE key_cleanup: []Emittable = ( { MUTABLE rtoc_empty_list_3: []Emittable = List[]; rtoc_empty_list_3 } );
