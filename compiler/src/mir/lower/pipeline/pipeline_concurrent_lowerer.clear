PRIVATE FN pipelineConcurrentLowerer__lower_bc_select_expression(self: PipelineConcurrentLowerer, policy_value: String@symbol, expr: PipelineConcurrentBcExpression, plan: PipelineConcurrentPlan) RETURNS !PipelineConcurrentResult ->
