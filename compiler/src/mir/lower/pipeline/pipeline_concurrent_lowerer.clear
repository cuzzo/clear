FN castLocatableToSelectOp(value: Locatable) RETURNS SelectOp ->
  IF value IS_A SelectOp AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to SelectOp");
END
FN castLocatableToSumOp(value: Locatable) RETURNS SumOp ->
  IF value IS_A SumOp AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to SumOp");
END
FN castLocatableToWhereOp(value: Locatable) RETURNS WhereOp ->
