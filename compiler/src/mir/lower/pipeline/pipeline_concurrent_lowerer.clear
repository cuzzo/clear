PRIVATE FN pipelineConcurrentLowerer__bc_error_policy(self: PipelineConcurrentLowerer, expr: Locatable) RETURNS PipelineConcurrentBcExpression ->
  IF expr IS_A BinaryOp AS binary_op THEN
  IF (binary_op.op == symbol("OR_ELSE")) THEN
      MUTABLE policy: ?String@symbol = pipelineConcurrentLowerer__bc_rescue_policy(self, castLocatableToLocatable(binary_op.right));
      IF policy EXISTS AS policy_value THEN
        RETURN PipelineConcurrentBcExpression{ policy: COPY policy_value, expr: COPY castLocatableToLocatable(binary_op.left) };
      ELSE
        RETURN pipelineConcurrentLowerer__default_bc_expression(self, Locatable{ BinaryOp: COPY binary_op });
      END
    ELSE
      RETURN pipelineConcurrentLowerer__default_bc_expression(self, Locatable{ BinaryOp: COPY binary_op });
    END
  ELSE
    RETURN pipelineConcurrentLowerer__default_bc_expression(self, expr);
  END
END
PRIVATE FN pipelineConcurrentLowerer__default_bc_expression(self: PipelineConcurrentLowerer, expr: Locatable) RETURNS PipelineConcurrentBcExpression ->
  RETURN PipelineConcurrentBcExpression{ policy: :default, expr: COPY expr };
