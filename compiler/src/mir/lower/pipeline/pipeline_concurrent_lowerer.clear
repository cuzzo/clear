    RETURN pipelineConcurrentLowerer__lower_count_call(self, plan.real_lhs, plan.smooth_node, castLocatableToCountOp(plan.inner));
  ELSE_IF (terminal_kind == PipelineConcurrentTerminalKind.Min) THEN
    RETURN pipelineConcurrentLowerer__lower_min_call(self, plan.real_lhs, plan.smooth_node, castLocatableToMinOp(plan.inner));
  ELSE_IF (terminal_kind == PipelineConcurrentTerminalKind.Max) THEN
    RETURN pipelineConcurrentLowerer__lower_max_call(self, plan.real_lhs, plan.smooth_node, castLocatableToMaxOp(plan.inner));
  ELSE_IF (terminal_kind == PipelineConcurrentTerminalKind.Average) THEN
    RETURN pipelineConcurrentLowerer__lower_average_call(self, plan.real_lhs, plan.smooth_node, castLocatableToAverageOp(plan.inner));
