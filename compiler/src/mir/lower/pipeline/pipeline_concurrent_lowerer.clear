PRIVATE FN pipelineConcurrentLowerer__bc_rescue_policy(self: PipelineConcurrentLowerer, expr: Locatable) RETURNS ?String@symbol ->
  IF (expr IS_A OrElsePrune) THEN
    RETURN :prune;
  ELSE_IF (expr IS_A OrElseRaise) THEN
    RETURN :raise;
  ELSE
    RETURN NIL;
  END
END
