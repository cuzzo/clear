  MUTABLE call = pipelineConcurrentLowerer__emit_builtin_call(self, :concurrentListCount, ([Ident{ name: COPY TRY (type__zig_type(item_t)), lowered_node_id: NIL, ownership_consumption: NIL }] + TRY (pipelineConcurrentInvocation__bounded_each_args(invoke, Emittable{ Ident: COPY Ident{ name: "pipe_items", lowered_node_id: NIL, ownership_consumption: NIL } }))));
  MUTABLE label = pipelineConcurrentLowerer__next_label_call(self);
  RETURN pipelineConcurrentLowerer__typed_block_expr_call(self, label, TRY (pipelineConcurrentInvocation__scoped_body(invoke, setup_stmts, [Emittable{ BreakStmt: COPY BreakStmt{ label: COPY label, value: COPY call, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }])), TRY (type__from_node_mut(conc_op, "list concurrent COUNT result")));
END
PRIVATE FN pipelineConcurrentLowerer__lower_concurrent_list_reduce(self: PipelineConcurrentLowerer, MUTABLE lhs: Locatable, conc_op: ConcurrentOp, inner: Inner, MUTABLE smooth_node: BinaryOp) RETURNS !MIRBlockExpr ->
  MUTABLE item_t = TRY (pipelineConcurrentLowerer__concurrent_list_item_type(self, &lhs));
  MUTABLE result_t = TRY (type__new(TypeConstructionInput{ Type: COPY TRY (aST__full_type_mut(smooth_node)) }));
  MUTABLE result_zig = TRY (type__zig_type(result_t));
  MUTABLE kind = pipelineConcurrentLowerer__list_reduce_kind(self, inner);
  MUTABLE initial = pipelineConcurrentLowerer__list_reduce_initial(self, kind, result_zig, result_t);
  MUTABLE invoke = TRY (pipelineConcurrentLowerer__bounded_expr_invocation(self, conc_op, CAST(item_t AS Type), castTypeToReturnType(result_t)));
  MUTABLE setup_stmts = TRY (pipelineConcurrentLowerer__source_setup_call(self, lhs));
  MUTABLE call = pipelineConcurrentLowerer__emit_builtin_call(self, :concurrentListReduce, ([Ident{ name: COPY TRY (type__zig_type(item_t)), lowered_node_id: NIL, ownership_consumption: NIL }, Ident{ name: COPY result_zig, lowered_node_id: NIL, ownership_consumption: NIL }] + TRY (pipelineConcurrentInvocation__bounded_each_args(invoke, Emittable{ Ident: COPY Ident{ name: "pipe_items", lowered_node_id: NIL, ownership_consumption: NIL } })) + [initial, EnumTag{ variant: COPY kind.serialize() }]));
  MUTABLE label = pipelineConcurrentLowerer__next_label_call(self);
  RETURN pipelineConcurrentLowerer__typed_block_expr_call(self, label, TRY (pipelineConcurrentInvocation__scoped_body(invoke, setup_stmts, [Emittable{ BreakStmt: COPY BreakStmt{ label: COPY label, value: COPY call, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }])), result_t);
END
PRIVATE FN pipelineConcurrentLowerer__lower_concurrent_list_each(self: PipelineConcurrentLowerer, MUTABLE lhs: Locatable, conc_op: ConcurrentOp, inner: EachOp) RETURNS !ScopeBlock ->
  MUTABLE item_t = TRY (pipelineConcurrentLowerer__concurrent_list_item_type(self, &lhs));
  MUTABLE invoke = TRY (pipelineConcurrentLowerer__bounded_each_invocation(self, conc_op, CAST(item_t AS Type)));
  MUTABLE setup_stmts = TRY (pipelineConcurrentLowerer__source_setup_call(self, lhs));
  MUTABLE call = pipelineConcurrentLowerer__emit_builtin_call(self, :concurrentListEach, ([Ident{ name: COPY TRY (type__zig_type(item_t)), lowered_node_id: NIL, ownership_consumption: NIL }] + TRY (pipelineConcurrentInvocation__bounded_each_args(invoke, Emittable{ Ident: COPY Ident{ name: "pipe_items", lowered_node_id: NIL, ownership_consumption: NIL } }))));
  RETURN ScopeBlock{ body: Body{ ArrayValue: TRY (pipelineConcurrentInvocation__scoped_body(invoke, setup_stmts, [Emittable{ ExprStmt: COPY ExprStmt{ expr: COPY call, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }])) |> SELECT castEmittableToLocatable(_) }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN pipelineConcurrentLowerer__lower_concurrent_list_each_in_place(self: PipelineConcurrentLowerer, MUTABLE lhs: Locatable, conc_op: ConcurrentOp, inner: EachOp) RETURNS !ScopeBlock ->
  MUTABLE item_t = TRY (pipelineConcurrentLowerer__concurrent_list_item_type(self, &lhs));
  MUTABLE invoke = TRY (pipelineConcurrentLowerer__bounded_pointer_invocation(self, conc_op, CAST(item_t AS Type)));
  MUTABLE setup_stmts = TRY (pipelineConcurrentLowerer__source_setup_call(self, lhs));
  MUTABLE call = pipelineConcurrentLowerer__emit_builtin_call(self, :concurrentListEachInPlace, ([Ident{ name: COPY TRY (type__zig_type(item_t)), lowered_node_id: NIL, ownership_consumption: NIL }] + TRY (pipelineConcurrentInvocation__bounded_each_args(invoke, Emittable{ ConstCast: COPY ConstCast{ expr: Emittable{ Ident: COPY Ident{ name: "pipe_items", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }))));
  RETURN ScopeBlock{ body: Body{ ArrayValue: TRY (pipelineConcurrentInvocation__scoped_body(invoke, setup_stmts, [Emittable{ ExprStmt: COPY ExprStmt{ expr: COPY call, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }])) |> SELECT castEmittableToLocatable(_) }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN pipelineConcurrentLowerer__build_bounded_concurrent_callback_pointer(self: PipelineConcurrentLowerer, conc_op: ConcurrentOp, item_type: Type) RETURNS !PipelineConcurrentCallback ->
  MUTABLE id = pipelineConcurrentLowerer__numeric_label_id(self, pipelineConcurrentLowerer__next_label_call(self));
  MUTABLE ctx_name = "__BoundedConcurrentCtx${id.toString()}";
  MUTABLE caps = TRY (fiberCtxBuilder__build(conc_op.capture_analysis, "ctx", {}, NIL, 0, {}));
  MUTABLE specs = COPY caps.specs;
  MUTABLE capture_map = COPY caps.capture_map;
  MUTABLE capture_symbols = COPY caps.capture_symbols;
  MUTABLE fields = specs |> SELECT pipelineConcurrentLowerer__capture_field_def(self, _, capture_symbols);
  MUTABLE raw_ctx = MIRParam{ name: "raw_ctx", zig_type: "?*anyopaque", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL };
  MUTABLE params: []MIRParam = [MIRParam{ name: "__rt", zig_type: "*Runtime", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL }, raw_ctx, MIRParam{ name: "__item", zig_type: "*${TRY (type__zig_type((TRY (type__new(castTypeToTypeConstructionInput(item_type))))))}", pointer_passed: FALSE, lowered_node_id: NIL, ownership_consumption: NIL }];
  MUTABLE body = TRY (pipelineConcurrentLowerer__callback_prelude(self, specs));
  body = ruby_array_concat_Emittable(body, CAST(TRY (pipelineConcurrentLowerer__callback_body_mir_call(self, (CAST(conc_op.op AS EachOp)).body, "__item", capture_map, capture_symbols, "__rt")) AS []Emittable));
  &body.append(Emittable{ ReturnStmt: COPY ReturnStmt{ value: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
  MUTABLE fn = FnDef{ name: "apply", params: COPY params, ret_type: "void", body: Body{ ArrayValue: body |> SELECT castEmittableToLocatable(_) }, visibility: NIL, can_fail: TRUE, comptime_params: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
  RETURN TRY (pipelineConcurrentLowerer__callback_record(self, id, ctx_name, fields, fn, specs));
END
PRIVATE FN pipelineConcurrentLowerer__unwrap_binding_source(self: PipelineConcurrentLowerer, lhs: Locatable) RETURNS Tuple<?String, Locatable> ->
  IF (IF lhs IS_A BinaryOp AS binary_op THEN (binary_op.op == :BIND_VAR) ELSE FALSE END) THEN
    RETURN CAST(Tuple{(CAST(lhs.right() AS Identifier)).name, CAST(lhs.left() AS Locatable)} AS Tuple<?String, Locatable>);
  ELSE
    RETURN CAST(Tuple{NIL, lhs} AS Tuple<?String, Locatable>);
  END
END
PRIVATE FN pipelineConcurrentLowerer__bounded_identifier_stream?(self: PipelineConcurrentLowerer, MUTABLE lhs: Locatable) RETURNS Bool ->
  RETURN ((!(lhs IS_A RangeLit) AND lhs IS_A Identifier) AND (TRY (aST__full_type_mut(lhs))).bounded_stream?());
END
PRIVATE FN pipelineConcurrentLowerer__stream_type?(self: PipelineConcurrentLowerer, type_info: Type) RETURNS !Bool ->
  RETURN (((TRY (type__dynamic_stream?(type_info)) OR TRY (type__bounded_stream?(type_info))) OR TRY (type__open_stream?(type_info))) OR TRY (type__inf_stream?(type_info)));
END
PRIVATE FN pipelineConcurrentLowerer__range_runtime_source?(self: PipelineConcurrentLowerer, lhs: Locatable) RETURNS Bool ->
  RETURN lhs IS_A RangeLit;
END
PRIVATE FN pipelineConcurrentLowerer__list_runtime_source?(self: PipelineConcurrentLowerer, lhs_type: Type) RETURNS !Bool ->
  IF pipelineConcurrentLowerer__stream_type?(self, lhs_type) THEN
    RETURN FALSE;
  END
  RETURN !(((TRY (type__element_type(lhs_type))) == NIL));
END
PRIVATE FN pipelineConcurrentLowerer__shard_context(self: PipelineConcurrentLowerer, conc_op: ConcurrentOp) RETURNS ?PipelineShardContext EFFECTS REENTRANT ->
  RETURN COPY CAST(conc_op.shard_context AS ?PipelineShardContext);
END
PRIVATE FN pipelineConcurrentLowerer__shard_key_type(self: PipelineConcurrentLowerer, map_type: Type) RETURNS !Type ->
  RETURN TRY (type__key_type(map_type));
END
PRIVATE FN pipelineConcurrentLowerer__shard_capture_map(self: PipelineConcurrentLowerer, map_var_name: String, caps: FiberCtxBuilderResult) RETURNS !{String}String ->
  RETURN {map_var_name: "ctx.__shard_map.*"}.keys() |> REDUCE(COPY caps.capture_map) { acc[_] = COPY ({map_var_name: "ctx.__shard_map.*"}[_] OR_ELSE panic("missing hash key")); acc };
END
PRIVATE FN pipelineConcurrentLowerer__shard_direct_context(self: PipelineConcurrentLowerer, map_var_name: String, key_var: String) RETURNS !{String@symbol}String ->
  RETURN CAST({:map: map_var_name, :idx: "ctx.shard", :key: key_var, :hash: "0"} AS {String@symbol}String);
END
PRIVATE FN pipelineConcurrentLowerer__shard_capture_fields(self: PipelineConcurrentLowerer, caps: FiberCtxBuilderResult) RETURNS ![]ContextFieldDecl ->
  RETURN caps.specs |> UNNEST {
  MUTABLE fields: []ContextFieldDecl = [ContextFieldDecl{ name: COPY _.name, type_zig: COPY _.field_type_zig, default_value: NIL }];
  IF captureSpec__needs_moved_guard?(_) THEN
      &fields.append(ContextFieldDecl{ name: "${_.name}_moved", type_zig: "bool", default_value: Emittable{ Lit: COPY Lit{ value: "false", lowered_node_id: NIL, ownership_consumption: NIL } } });
  END
  fields
  };
END
PRIVATE FN pipelineConcurrentLowerer__shard_capture_inits(self: PipelineConcurrentLowerer, caps: FiberCtxBuilderResult) RETURNS ![]StructInitField ->
  RETURN caps.specs |> SELECT StructInitField{ name: symbol(COPY _.name), value: COPY _.init_value_mir, alloc: NIL };
END
PRIVATE FN pipelineConcurrentLowerer__shard_capture_setup(self: PipelineConcurrentLowerer, caps: FiberCtxBuilderResult) RETURNS ![]Emittable ->
  RETURN caps.specs |> UNNEST _.setup_mir;
END
PRIVATE FN pipelineConcurrentLowerer__shard_task_config_variant(self: PipelineConcurrentLowerer, conc_op: ConcurrentOp) RETURNS String ->
  MUTABLE size_node: ?Locatable = pipelineConcurrentLowerer__concurrent_option(self, conc_op, "size");
  MUTABLE size_name: ?String@symbol = IF ((size_node != NIL) AND (size_node IS_A Identifier)) THEN
    type__to_sym(size_node.name().downcase())
  ELSE
    NIL
  END;
  RETURN pipelineConcurrentLowerer__task_config_variant_call(self, size_name);
END
PRIVATE FN pipelineConcurrentLowerer__concurrent_option(self: PipelineConcurrentLowerer, conc_op: ConcurrentOp, key: String) RETURNS ?Locatable ->
  RETURN COPY conc_op.options[key];
END
PRIVATE FN pipelineConcurrentLowerer__shard_loop_mark_pair(self: PipelineConcurrentLowerer, var: String, rt: String) RETURNS ![]Emittable ->
  MUTABLE rt_ident = Ident{ name: COPY rt, lowered_node_id: NIL, ownership_consumption: NIL };
  RETURN CAST([Emittable{ Let: COPY Let{ name: COPY var, init: Emittable{ MethodCall: COPY MIRMethodCall{ receiver: COPY rt_ident, method: "saveLoopMark", args: ( { MUTABLE rtoc_empty_list_21: []Any = List[]; rtoc_empty_list_21 } ), try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }, Emittable{ MIRDeferStmt: COPY MIRDeferStmt{ body: DeferBody{ Emittable: COPY CAST(COPY MIRMethodCall{ receiver: COPY rt_ident, method: "restoreLoopMark", args: [CAST(Ident{ name: COPY var, lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(1)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } AS Emittable) }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable);
END
PRIVATE FN pipelineConcurrentLowerer__bounded_invocation(self: PipelineConcurrentLowerer, conc_op: ConcurrentOp, cb: PipelineConcurrentCallback) RETURNS PipelineConcurrentInvocation ->
  MUTABLE worker_count = pipelineConcurrentLowerer__bounded_concurrent_worker_count_for_call_mir(self, conc_op);
  MUTABLE batch_size = pipelineConcurrentLowerer__bounded_concurrent_batch_mir(self, conc_op);
  MUTABLE parallel = pipelineConcurrentLowerer__bounded_concurrent_parallel_mir(self, conc_op);
  MUTABLE task_config = pipelineConcurrentLowerer__bounded_concurrent_task_cfg_mir(self, conc_op);
  RETURN PipelineConcurrentInvocation{ id: cb.id, apply_ident: COPY cb.apply_ident, context_arg: COPY cb.context_arg, context_stmts: COPY cb.context_stmts, worker_count: Emittable{ MIRCast: COPY worker_count }, batch_size: COPY batch_size, parallel: COPY parallel, task_config: Emittable{ StructInit: COPY task_config }, bounded_runtime_args: [Emittable{ MIRCast: COPY worker_count }, batch_size, parallel, Emittable{ StructInit: COPY task_config }, Emittable{ AddressOf: COPY cb.context_arg }] };
END
PRIVATE FN pipelineConcurrentLowerer__bounded_expr_invocation(self: PipelineConcurrentLowerer, conc_op: ConcurrentOp, item_type: Type, return_type: ReturnType) RETURNS !PipelineConcurrentInvocation ->
  RETURN pipelineConcurrentLowerer__bounded_invocation(self, conc_op, TRY (pipelineConcurrentLowerer__build_bounded_concurrent_callback(self, conc_op, item_type, return_type, PipelineConcurrentCallbackBodyKind.Expr)));
END
PRIVATE FN pipelineConcurrentLowerer__bounded_each_invocation(self: PipelineConcurrentLowerer, conc_op: ConcurrentOp, item_type: Type) RETURNS !PipelineConcurrentInvocation ->
  RETURN pipelineConcurrentLowerer__bounded_invocation(self, conc_op, TRY (pipelineConcurrentLowerer__build_bounded_concurrent_callback(self, conc_op, item_type, ReturnType{ SymbolValue: :Void }, PipelineConcurrentCallbackBodyKind.Each)));
END
PRIVATE FN pipelineConcurrentLowerer__bounded_pointer_invocation(self: PipelineConcurrentLowerer, conc_op: ConcurrentOp, item_type: Type) RETURNS !PipelineConcurrentInvocation ->
  RETURN pipelineConcurrentLowerer__bounded_invocation(self, conc_op, TRY (pipelineConcurrentLowerer__build_bounded_concurrent_callback_pointer(self, conc_op, item_type)));
END
PRIVATE FN pipelineConcurrentLowerer__capture_field_def(self: PipelineConcurrentLowerer, spec: CaptureSpec, capture_symbols: {String}SymbolEntry) RETURNS FieldDef ->
  MUTABLE field = FieldDef{ name: COPY spec.name, zig_type: COPY spec.field_type_zig, default: NIL, lowered_node_id: NIL, ownership_consumption: NIL, boxed_capture: NIL };
  MUTABLE sym: ?SymbolEntry = COPY capture_symbols[spec.name];
  IF (IF sym != NIL THEN
    symbolEntry__boxed_capture_storage?(sym)
  ELSE
    NIL
  END) THEN
    field.boxed_capture = ((pipelineConcurrentLowerer__struct_name_hint_for_sym(self, sym) != NIL) OR TRUE);
  END
  RETURN field;
END
PRIVATE FN pipelineConcurrentLowerer__struct_name_hint_for_sym(self: PipelineConcurrentLowerer, sym: ?SymbolEntry) RETURNS !?String ->
  IF sym EXISTS AS sym_value THEN
    MUTABLE bare = TRY (type__bare_data_type(symbolEntry__type(sym_value)));
    IF ((bare AND TRUE) AND TRY (type__struct?(bare))) THEN
      RETURN COPY type__to_s(bare);
    END
    RETURN NIL;
  ELSE
    RETURN NIL;
  END
END
PRIVATE FN pipelineConcurrentLowerer__callback_prelude(self: PipelineConcurrentLowerer, specs: []CaptureSpec) RETURNS ![]Emittable ->
  MUTABLE body: []Emittable = [Emittable{ Suppress: COPY Suppress{ name: "__rt", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }];
  IF (specs.length() == 0) THEN
    &body.append(Emittable{ Suppress: COPY Suppress{ name: "raw_ctx", lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
  ELSE
    MUTABLE ctx_cast = PointerCast{ expr: Emittable{ MIROptionalUnwrap: COPY MIROptionalUnwrap{ expr: Emittable{ Ident: COPY Ident{ name: "raw_ctx", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: "*@This()", lowered_node_id: NIL, ownership_consumption: NIL };
    &body.append(Emittable{ Let: COPY Let{ name: COPY "ctx", init: Emittable{ PointerCast: COPY ctx_cast }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
  END
  RETURN body;
END
PRIVATE FN pipelineConcurrentLowerer__callback_body(self: PipelineConcurrentLowerer, conc_op: ConcurrentOp, body_kind: PipelineConcurrentCallbackBodyKind, ret_type: Type, capture_map: {String}String, capture_symbols: {String}SymbolEntry) RETURNS ![]Emittable ->
  IF (body_kind IS_A Expr) THEN
    MUTABLE expr_node = TRY (pipelineConcurrentLowerer__callback_expression(self, conc_op));
    MUTABLE expr_mir = pipelineConcurrentLowerer__callback_expr_mir_call(self, expr_node, "__item", capture_map, capture_symbols, "__rt");
    IF (expr_mir IS_A Call OR expr_mir IS_A MIRMethodCall) THEN
      expr_mir.try_wrap = FALSE;
    END
    MUTABLE expr_type = TRY (aST__full_type_mut(expr_node));
    IF ((expr_type AND type__integer?((TRY (type__new(expr_type))))) AND type__float?(ret_type)) THEN
      expr_mir = Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ MIRCast: COPY MIRCast{ expr: COPY expr_mir, target_type: NIL, method: :floatFromInt, lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: TRY (type__zig_type(ret_type)), method: :as, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    RETURN CAST([Emittable{ ReturnStmt: COPY ReturnStmt{ value: COPY expr_mir, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable);
  ELSE_IF (body_kind == PipelineConcurrentCallbackBodyKind.Each) THEN
    RETURN CAST((TRY (pipelineConcurrentLowerer__callback_body_mir_call(self, (CAST(conc_op.op AS EachOp)).body, "__item", capture_map, capture_symbols, "__rt")) + CAST([Emittable{ ReturnStmt: COPY ReturnStmt{ value: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable)) AS []Emittable);
  ELSE
    panic("unknown bounded concurrent callback kind {}");
  END
END
PRIVATE FN pipelineConcurrentLowerer__callback_expression(self: PipelineConcurrentLowerer, conc_op: ConcurrentOp) RETURNS !Locatable ->
  MUTABLE op = COPY conc_op.op;
  IF (op IS_A AverageOp) OR (op IS_A CountOp) OR (op IS_A MaxOp) OR (op IS_A MinOp) OR (op IS_A SelectOp) OR (op IS_A SumOp) OR (op IS_A WhereOp) THEN
    RETURN op.expression();
  ELSE
    panic("concurrent callback expression expected expression op, got {}");
  END
END
PRIVATE FN pipelineConcurrentLowerer__numeric_label_id(self: PipelineConcurrentLowerer, MUTABLE label: String) RETURNS !Int64 ->
  RETURN TRY ((&label.delete("^0-9")).toInt());
END
PRIVATE FN pipelineConcurrentLowerer__callback_record(self: PipelineConcurrentLowerer, id: Int64, ctx_name: String, fields: []FieldDef, fn_value: FnDef, specs: []CaptureSpec) RETURNS !PipelineConcurrentCallback ->
  MUTABLE callback_fields = (fields + [FieldDef{ name: "alloc", zig_type: "std.mem.Allocator", default: NIL, lowered_node_id: NIL, ownership_consumption: NIL, boxed_capture: NIL }]);
  MUTABLE ctx_init = StructInit{ zig_type: COPY ctx_name, fields: COPY ((specs |> SELECT StructInitField{ name: symbol(COPY _.name), value: COPY _.init_value_mir, alloc: NIL }) + [StructInitField{ name: :alloc, value: Emittable{ MethodCall: COPY MIRMethodCall{ receiver: COPY Ident{ name: COPY pipelineConcurrentLowerer__do_rt_name_call(self), lowered_node_id: NIL, ownership_consumption: NIL }, method: "heapAlloc", args: ( { MUTABLE rtoc_empty_list_22: []Any = List[]; rtoc_empty_list_22 } ), try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, alloc: NIL }]), lowered_node_id: NIL, ownership_consumption: NIL };
  MUTABLE ctx_var = "__bounded_conc_ctx_${id.toString()}";
  MUTABLE ctx_def = MIRStructDef{ name: COPY ctx_name, fields: callback_fields, methods: [fn_value], visibility: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
  MUTABLE ctx_let = Let{ name: COPY ctx_var, init: Emittable{ StructInit: COPY ctx_init }, mutable: TRUE, annotation: NIL, suppression: "_ = &${ctx_var};", alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL };
  MUTABLE pre_ctx_stmts = specs |> UNNEST {
  MUTABLE setup = COPY _.setup_mir;
  (setup)
  };
  MUTABLE post_ctx_stmts = specs |> SELECT:? TRY (captureSpec__cleanup_mir_for(_, ctx_var)) |> WHERE _ != NIL;
  RETURN PipelineConcurrentCallback{ id: COPY id, ctx_name: COPY ctx_name, ctx_def: COPY ctx_def, ctx_var: COPY ctx_var, ctx_let: COPY ctx_let, pre_ctx_stmts: COPY pre_ctx_stmts, post_ctx_stmts: COPY post_ctx_stmts, apply_ident: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: COPY ctx_name, lowered_node_id: NIL, ownership_consumption: NIL } }, field: "apply", lowered_node_id: NIL, ownership_consumption: NIL } }, context_arg: COPY AddressOf{ expr: Emittable{ Ident: COPY Ident{ name: COPY ctx_var, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL }, context_stmts: (CAST([Emittable{ MIRStructDef: COPY ctx_def }] AS []Emittable) + pre_ctx_stmts + CAST([Emittable{ Let: COPY ctx_let }] AS []Emittable) + post_ctx_stmts) };
END
PRIVATE FN pipelineConcurrentLowerer__list_reduce_initial(self: PipelineConcurrentLowerer, kind: PipelineConcurrentReduceKind, result_zig: String, result_type: Type) RETURNS Emittable ->
  IF (kind == PipelineConcurrentReduceKind.Sum) THEN
    RETURN Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } };
  ELSE_IF (kind == PipelineConcurrentReduceKind.Average) THEN
    RETURN Emittable{ Lit: COPY Lit{ value: "0.0", lowered_node_id: NIL, ownership_consumption: NIL } };
  ELSE_IF (kind == PipelineConcurrentReduceKind.Min) THEN
    RETURN Emittable{ TypeSentinel: COPY pipelineConcurrentLowerer__agg_min_sentinel_mir_call(self, result_zig) };
  ELSE_IF (kind == PipelineConcurrentReduceKind.Max) THEN
    RETURN (KEEP self.agg_max_sentinel_mir)(result_zig, result_type);
  ELSE
    RETURN panic("unreachable: exhaustive union match");
  END
END
PRIVATE FN pipelineConcurrentLowerer__list_reduce_kind(self: PipelineConcurrentLowerer, inner: Inner) RETURNS PipelineConcurrentReduceKind ->
  IF inner IS_A SumOp AS sum_op THEN
    RETURN PipelineConcurrentReduceKind.Sum;
  ELSE_IF inner IS_A AverageOp AS average_op THEN
    RETURN PipelineConcurrentReduceKind.Average;
  ELSE_IF inner IS_A MinOp AS min_op THEN
    RETURN PipelineConcurrentReduceKind.Min;
  ELSE_IF inner IS_A MaxOp AS max_op THEN
    RETURN PipelineConcurrentReduceKind.Max;
  ELSE
    RETURN panic("unreachable: exhaustive union match");
  END
END
PRIVATE FN pipelineConcurrentLowerer__each_body_mutates_placeholder?(self: PipelineConcurrentLowerer, body_stmts: []Locatable) RETURNS Bool ->
  RETURN body_stmts |> ANY pipelineConcurrentLowerer__assignment_targets_placeholder?(self, castLocatableToPipelineConcurrentLowererAssignmentTargetScanNode(_));
END
