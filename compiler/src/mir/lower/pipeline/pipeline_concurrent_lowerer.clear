    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to WhereOp");
END
FN castReturnTypeToTypeConstructionInput(value: ReturnType) RETURNS TypeConstructionInput ->
  PARTIAL MATCH value START
    ReturnType.StringValue AS cast_payload -> RETURN TypeConstructionInput{ StringValue: COPY cast_payload };,
    ReturnType.SymbolValue AS cast_payload -> RETURN TypeConstructionInput{ SymbolValue: COPY cast_payload };,
    ReturnType.Type AS cast_payload -> RETURN TypeConstructionInput{ Type: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to TypeConstructionInput");
  END
  panic("Invalid cast to TypeConstructionInput");
END
FN castTypeToReturnType(value: Type) RETURNS ReturnType ->
  PARTIAL MATCH value START
    Type.StringValue AS cast_payload -> RETURN ReturnType{ StringValue: COPY cast_payload };,
    Type.SymbolValue AS cast_payload -> RETURN ReturnType{ SymbolValue: COPY cast_payload };,
    Type.Type AS cast_payload -> RETURN ReturnType{ Type: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to ReturnType");
  END
  panic("Invalid cast to ReturnType");
END
