PUB FN pipelineMaterializer__source_binding_name(self: PipelineMaterializer, label: ?String = NIL) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE raw = COPY (label OR_ELSE "");
    WHILE raw.startsWith?("_") DO
      raw = raw.substr(1, (raw.length - 1));
    END
    RETURN "pipe_src_list_${raw}";
}
END
PUB FN pipelineMaterializer__items_binding_name(self: PipelineMaterializer) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE label = COPY CAST(((runtimeHost__materializer_current_label(rtoc_self_view.host) OR "items")) AS String);
    MUTABLE raw = label;
    WHILE raw.startsWith?("_") DO
      raw = raw.substr(1, (raw.length - 1));
    END
    RETURN "pipe_items_${raw}";
}
END
PUB FN pipelineMaterializer__source_ident(self: PipelineMaterializer) RETURNS Ident
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN Ident{ name: COPY pipelineMaterializer__source_binding_name(rtoc_self_view, runtimeHost__materializer_current_label(rtoc_self_view.host)), lowered_node_id: NIL, ownership_consumption: NIL };
}
END
PUB FN pipelineMaterializer__pipeline_block(self: PipelineMaterializer, MUTABLE list_node: Locatable, blk: FN(String, String) -> ![]Emittable) RETURNS !MIRBlockExpr
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE label = runtimeHost__materializer_next_label(rtoc_self_view.host);
    MUTABLE src_name = pipelineMaterializer__source_binding_name(rtoc_self_view, label);
    MUTABLE source_mir = runtimeHost__materializer_visit_mir(rtoc_self_view.host, list_node);
    MUTABLE source_prefix: []Emittable = ( { MUTABLE rtoc_empty_list_1: []Emittable = List[]; rtoc_empty_list_1 } );
    MUTABLE source_cleanup: ?Cleanup = NIL;
    MUTABLE forced_alloc: ?String@symbol = pipelineMaterializer__inline_source_alloc(rtoc_self_view, source_mir);
    MUTABLE fact = runtimeHost__materializer_alloc_mark_fact(rtoc_self_view.host, source_mir, src_name, (forced_alloc OR_ELSE :heap), TRY (aST__full_type_mut(list_node)), NIL, "pipeline allocation", !((forced_alloc == NIL)));
    IF fact THEN
      &source_prefix.append(fact.mark);
      source_cleanup = Cleanup{ name: src_name, cleanup_entry: COPY cleanupEntry__build(:uniform, fact.alloc, FALSE, NIL, TRY (type__zig_type((TRY (aST__full_type_mut(list_node)))))), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    END
    runtimeHost__materializer_set_current_label(rtoc_self_view.host, label);
    MUTABLE item_setup = TRY (pipelineMaterializer__items_setup(rtoc_self_view, TRY (aST__full_type_mut(list_node)), TRUE));
    MUTABLE body_stmts = TRY (blk(item_setup.items_ident, label));
    RETURN MIRBlockExpr{ label: label, body: COPY (source_prefix + [Let{ name: COPY src_name, init: COPY source_mir, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }, source_cleanup] + item_setup.statements + body_stmts), lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
}
END
PUB FN pipelineMaterializer__items_setup(self: PipelineMaterializer, lhs_type: Type, per_label: Bool = FALSE) RETURNS !ItemSetup
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE kind = pipelineMaterializer__item_kind(rtoc_self_view, lhs_type);
    MUTABLE name: String = "";
    IF ((per_label AND (kind == ItemKind.Default))) THEN
      name = pipelineMaterializer__items_binding_name(rtoc_self_view);
    ELSE
      name = "pipe_items";
    END
    MUTABLE setup = TRY (pipelineMaterializer__item_setup_stmts(rtoc_self_view, kind, lhs_type, name));
    RETURN ItemSetup{ statements: COPY setup, items_ident: COPY name };
}
END
PUB FN pipelineMaterializer__item_kind(self: PipelineMaterializer, lhs_type: Type) RETURNS ItemKind
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE bc = pipelineMaterializer__bc_target?(rtoc_self_view);
    IF (type__pool?(lhs_type) AND type__sharded?(lhs_type)) THEN
      RETURN ItemKind.ShardedPool;
    END
    IF ((!(bc) AND type__pool?(lhs_type)) AND type__soa?(lhs_type)) THEN
      RETURN ItemKind.SoaPool;
    END
    IF (!(bc) AND type__pool?(lhs_type)) THEN
      RETURN ItemKind.Pool;
    END
    IF (!(bc) AND type__soa_list_materialization?(lhs_type)) THEN
      RETURN ItemKind.SoaList;
    END
    IF ((!(bc) AND type__list_collection?(lhs_type)) AND type__sharded?(lhs_type)) THEN
      RETURN ItemKind.ShardedList;
    END
    IF type__set_collection?(lhs_type) THEN
      RETURN ItemKind.Set;
    END
    RETURN ItemKind.Default;
}
END
PUB FN pipelineMaterializer__item_setup_stmts(self: PipelineMaterializer, kind: ItemKind, lhs_type: Type, items_name: String) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (kind == ItemKind.ShardedPool) THEN
      RETURN TRY (pipelineMaterializer__build_sharded_pool(rtoc_self_view, lhs_type));
    ELSE_IF (kind == ItemKind.SoaPool) THEN
      RETURN TRY (pipelineMaterializer__build_soa_pool(rtoc_self_view, lhs_type));
    ELSE_IF (kind == ItemKind.Pool) THEN
      RETURN TRY (pipelineMaterializer__build_pool(rtoc_self_view, lhs_type));
    ELSE_IF (kind == ItemKind.SoaList) THEN
      RETURN TRY (pipelineMaterializer__build_soa_list(rtoc_self_view, lhs_type));
    ELSE_IF (kind == ItemKind.ShardedList) THEN
      RETURN TRY (pipelineMaterializer__build_sharded_list(rtoc_self_view, lhs_type));
    ELSE_IF (kind IS_A Set) THEN
      RETURN TRY (pipelineMaterializer__build_set(rtoc_self_view, lhs_type));
    ELSE_IF (kind == ItemKind.Default) THEN
      RETURN CAST([Emittable{ Let: COPY Let{ name: COPY items_name, init: Emittable{ ItemsAccess: COPY ItemsAccess{ expr: Emittable{ Ident: COPY pipelineMaterializer__source_ident(rtoc_self_view) }, safe: TRUE, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }] AS []Emittable);
    ELSE
      RETURN NIL;
    END
}
END
PUB FN pipelineMaterializer__borrowed_pipeline_value(self: PipelineMaterializer, value: Emittable, type_info: Type, alloc: String@symbol) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((TRY (type__recursive_cleanup_shape?(type_info, pipelineMaterializer__schema_lookup(rtoc_self_view))) OR TRY (type__heap_ptr?(type_info)))) THEN
      RETURN COPY value;
    END
    RETURN Emittable{ DeepCopy: COPY DeepCopy{ source: COPY value, zig_type: COPY TRY (type__zig_type(type_info)), elem_type: NIL, strategy: :full_value, alloc: COPY alloc, copy_shape: NIL, type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL } };
}
END
PUB FN pipelineMaterializer__cleanup_bearing_type?(self: PipelineMaterializer, type_info: Type) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (type__recursive_cleanup_shape?(type_info, pipelineMaterializer__schema_lookup(rtoc_self_view)));
}
END
PUB FN pipelineMaterializer__owning_pipeline_temp_stmts(self: PipelineMaterializer, name: String, source: Emittable, type_info: Type, zig_type: String, alloc: String@symbol) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE mark = AllocMark{ name: COPY name, alloc: COPY alloc, type_info: COPY type_info, scope: IF placement__heap?(alloc) THEN
      :heap
    ELSE
      :function
    END, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    MUTABLE entry = cleanupEntry__build(:uniform, alloc, TRUE, NIL, zig_type);
    RETURN CAST([Emittable{ AllocMark: COPY mark }, Emittable{ Let: COPY Let{ name: COPY name, init: Emittable{ DeepCopy: COPY DeepCopy{ source: COPY source, zig_type: COPY zig_type, elem_type: NIL, strategy: :full_value, alloc: COPY alloc, copy_shape: NIL, type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: FALSE, annotation: COPY TRY (type__new(TypeConstructionInput{ StringValue: COPY zig_type })), suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }, Emittable{ ErrCleanup: COPY ErrCleanup{ name: COPY name, cleanup_entry: entry, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable);
}
END
PUB FN pipelineMaterializer__append_owned_value_stmt(self: PipelineMaterializer, receiver: String, alloc: String@symbol, value_expr: Emittable, known_owned: Bool = FALSE, owned_type: ?Type = NIL) RETURNS !Emittable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fact = runtimeHost__materializer_alloc_mark_fact(rtoc_self_view.host, value_expr, runtimeHost__materializer_next_item_temp_name(rtoc_self_view.host), alloc, owned_type, NIL, "pipeline owned append item", known_owned);
    IF (fact AND (fact.alloc != alloc)) THEN
      fact.mark.scope = IF placement__heap?(fact.alloc) THEN
        :heap
      ELSE
        :iteration
      END;
      MUTABLE src_name = COPY CAST(fact.mark.name() AS String);
      MUTABLE src_entry = cleanupEntry__build(:uniform, fact.alloc, FALSE, NIL, ((IF owned_type != NIL THEN
        TRY (type__zig_type(owned_type))
      ELSE
        NIL
      END) OR_ELSE pipelineMaterializer__zig_type_for(rtoc_self_view, value_expr)));
      MUTABLE copy = DeepCopy{ source: Ident{ name: COPY src_name, lowered_node_id: NIL, ownership_consumption: NIL }, zig_type: ( { MUTABLE rtoc_optional_or_source_2: ?String = (IF owned_type != NIL THEN
        TRY (type__zig_type(owned_type))
      ELSE
        NIL
      END); MUTABLE rtoc_optional_or_result_3: ?String = NIL; IF rtoc_optional_or_source_2 != NIL THEN rtoc_optional_or_result_3 = COPY rtoc_optional_or_source_2; ELSE rtoc_optional_or_result_3 = pipelineMaterializer__zig_type_for(rtoc_self_view, value_expr); END rtoc_optional_or_result_3 } ), elem_type: NIL, strategy: :full_value, alloc: COPY alloc, copy_shape: NIL, type_info: NIL, lowered_node_id: NIL, ownership_consumption: NIL };
      RETURN Emittable{ ScopeBlock: COPY ScopeBlock{ body: COPY [fact.mark, Let{ name: COPY src_name, init: COPY value_expr, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }, Cleanup{ name: src_name, cleanup_entry: COPY src_entry, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }, TRY (pipelineMaterializer__append_owned_value_stmt(rtoc_self_view, receiver, alloc, Emittable{ DeepCopy: COPY copy }, TRUE, owned_type))], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
    IF fact THEN
      fact.mark.scope = IF placement__heap?(fact.alloc) THEN
        :heap
      ELSE
        :function
      END;
      MUTABLE temp_name = COPY CAST(fact.mark.name() AS String);
      MUTABLE entry = cleanupEntry__build(:uniform, fact.alloc, TRUE, NIL, ((IF owned_type != NIL THEN
        TRY (type__zig_type(owned_type))
      ELSE
        NIL
      END) OR_ELSE pipelineMaterializer__zig_type_for(rtoc_self_view, value_expr)));
      RETURN Emittable{ ScopeBlock: COPY ScopeBlock{ body: COPY ([fact.mark, Let{ name: COPY temp_name, init: COPY value_expr, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }, ErrCleanup{ name: COPY temp_name, cleanup_entry: entry, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }, ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Ident{ name: COPY receiver, lowered_node_id: NIL, ownership_consumption: NIL }, method: "append", args: [CAST(AllocatorRef{ kind: COPY alloc, lowered_node_id: NIL, ownership_consumption: NIL } AS Any), CAST(Ident{ name: COPY temp_name, lowered_node_id: NIL, ownership_consumption: NIL } AS Any)], try_wrap: TRUE, callable_contract: COPY TRY (callableContract__no_ownership(2)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }] + TRY (ownershipTransferPlan__marks((OwnershipTransferPlan{ name: COPY temp_name, target: :owned_sink, target_alloc: COPY alloc, move_guarded: TRUE })))), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
    END
    RETURN Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Ident{ name: COPY receiver, lowered_node_id: NIL, ownership_consumption: NIL }, method: "append", args: [CAST(AllocatorRef{ kind: COPY alloc, lowered_node_id: NIL, ownership_consumption: NIL } AS Any), CAST(value_expr AS Any)], try_wrap: TRUE, callable_contract: COPY TRY (callableContract__no_ownership(2)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
}
END
PUB FN pipelineMaterializer__concurrent_source_setup(self: PipelineMaterializer, MUTABLE lhs: Locatable) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF lhs IS_A RangeLit THEN
      RETURN TRY (pipelineMaterializer__range_concurrent_source_setup(rtoc_self_view, lhs));
    END
    MUTABLE lhs_type = TRY (aST__full_type_mut(lhs));
    MUTABLE label = runtimeHost__materializer_next_label(rtoc_self_view.host);
    MUTABLE src_name = pipelineMaterializer__source_binding_name(rtoc_self_view, label);
    MUTABLE source_mir = runtimeHost__materializer_visit_mir(rtoc_self_view.host, lhs);
    MUTABLE source_prefix: []Emittable = ( { MUTABLE rtoc_empty_list_4: []Emittable = List[]; rtoc_empty_list_4 } );
    MUTABLE source_cleanup: ?Cleanup = NIL;
    MUTABLE fact = runtimeHost__materializer_alloc_mark_fact(rtoc_self_view.host, source_mir, src_name, :heap, TRY (aST__full_type_mut(lhs)));
    IF fact THEN
      &source_prefix.append(fact.mark);
      source_cleanup = Cleanup{ name: src_name, cleanup_entry: COPY cleanupEntry__build(:uniform, fact.alloc, FALSE, NIL, TRY (type__zig_type(lhs_type))), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    END
    runtimeHost__materializer_set_current_label(rtoc_self_view.host, label);
    MUTABLE item_setup = TRY (pipelineMaterializer__items_setup(rtoc_self_view, lhs_type));
    RETURN (source_prefix + [Let{ name: COPY src_name, init: COPY source_mir, mutable: !((source_cleanup == NIL)), annotation: NIL, suppression: "_ = &${src_name};", alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }, source_cleanup] + item_setup.statements);
}
END
PRIVATE FN pipelineMaterializer__inline_source_alloc(self: PipelineMaterializer, source_mir: Emittable) RETURNS ?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE effect = ownershipEffect__of(source_mir);
    IF (effect.produces_owned AND (effect.alloc != NIL)) THEN
      RETURN (effect.alloc)?;
    END
    MUTABLE metadata = IF respondsTo?(source_mir, "allocs") THEN
      source_mir.allocs
    ELSE
      NIL
    END;
    IF !((metadata IS_A InlineAllocMetadata AND !(metadata.empty?()))) THEN
      RETURN NIL;
    END
    IF metadata.any_heap?() THEN
      RETURN :heap;
    ELSE
      RETURN :frame;
    END
}
END
