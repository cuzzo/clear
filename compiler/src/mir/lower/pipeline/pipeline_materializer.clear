PRIVATE FN pipelineMaterializer__zig_type_for(self: PipelineMaterializer, value_expr: Emittable) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE zig_type = PARTIAL MATCH value_expr START
      Emittable.DeepCopy AS deep_copy -> deep_copy.zig_type,
      Emittable.ContainerInit AS container_init -> container_init.zig_type,
      Emittable.StructInit AS struct_init -> struct_init.zig_type,
      Emittable.TypeSentinel AS type_sentinel -> type_sentinel.zig_type,
      Emittable.Undef AS undef -> undef.zig_type,
      Emittable.HeapCreate AS heap_create -> heap_create.zig_type,
      Emittable.DiscardOwned AS discard_owned -> discard_owned.zig_type,
      Emittable.UnionVariantGet AS union_variant_get -> union_variant_get.zig_type,
      DEFAULT -> NIL
    END;
    RETURN pipelineMaterializer__normalized_zig_type(rtoc_self_view, zig_type);
}
END
PRIVATE FN pipelineMaterializer__normalized_zig_type(self: PipelineMaterializer, zig_type: ?String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF zig_type EXISTS AS zig_type_value THEN
      IF (zig_type_value.length == 0) THEN
        RETURN "void";
      ELSE
        RETURN COPY zig_type_value;
      END
    ELSE
      RETURN "void";
    END
}
END
