PUB FN runtimeHost__new(visit_mir: FN(Locatable) -> Emittable, alloc_mark_fact: FN(Emittable, String, String@symbol, ?Type, ?Locatable, String, Bool) -> ?AllocationFact, result_alloc: FN() -> String@symbol, bc_target: FN() -> Bool, schema_lookup: FN() -> FN(MIRLoweringSchemasSchemaName) -> ?MIRLoweringSchemasSchemaLookupResult, next_label: FN() -> String, set_current_label: FN(String) -> Void, next_item_temp_name: FN() -> String) RETURNS RuntimeHost@multiowned ->
  MUTABLE self = RuntimeHost{ alloc_mark_fact: COPY alloc_mark_fact, bc_target: COPY bc_target, current_label: NIL, next_item_temp_name: COPY next_item_temp_name, next_label: COPY next_label, result_alloc: COPY result_alloc, schema_lookup: COPY schema_lookup, set_current_label: COPY set_current_label, visit_mir: COPY visit_mir };
  runtimeHost__initialize(&self, visit_mir, alloc_mark_fact, result_alloc, bc_target, schema_lookup, next_label, set_current_label, next_item_temp_name);
  RETURN self @multiowned;
END
PUB FN pipelineMaterializer__initialize(MUTABLE self: PipelineMaterializer, host: RuntimeHost) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.host = COPY host;
}
END
PUB FN pipelineMaterializer__result_alloc(self: PipelineMaterializer) RETURNS String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN runtimeHost__materializer_result_alloc(rtoc_self_view.host);
}
END
PUB FN pipelineMaterializer__schema_lookup(self: PipelineMaterializer) RETURNS FN(MIRLoweringSchemasSchemaName) -> ?MIRLoweringSchemasSchemaLookupResult
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN runtimeHost__materializer_schema_lookup(rtoc_self_view.host);
}
