PUB STRUCT PipelineMaterializer {
  host: RuntimeHost
}

PUB ENUM ItemKind { ShardedPool, SoaPool, Pool, SoaList, ShardedList, Set, Default }
PUB STRUCT AllocationFact {
  alloc: String@symbol,
  mark: AllocMark
}
PUB STRUCT ItemSetup {
  statements: []Emittable,
  items_ident: String
}
PUB STRUCT BufferSetup {
  var_decl: Let,
  defer_stmt: MIRDeferStmt
}
# Ruby module PipelineMaterializer::RuntimeHost
PUB STRUCT RuntimeHost {
  alloc_mark_fact: FN(Emittable, String, String@symbol, ?Type, ?Locatable, String, Bool) -> ?AllocationFact,
  bc_target: FN() -> Bool,
  current_label: ?String,
  next_item_temp_name: FN() -> String,
  next_label: FN() -> String,
  result_alloc: FN() -> String@symbol,
  schema_lookup: FN() -> FN(MIRLoweringSchemasSchemaName) -> ?MIRLoweringSchemasSchemaLookupResult,
  set_current_label: FN(String) -> Void,
  visit_mir: FN(Locatable) -> Emittable
}

PUB FN runtimeHost__initialize(MUTABLE self: RuntimeHost, visit_mir: FN(Locatable) -> Emittable, alloc_mark_fact: FN(Emittable, String, String@symbol, ?Type, ?Locatable, String, Bool) -> ?AllocationFact, result_alloc: FN() -> String@symbol, bc_target: FN() -> Bool, schema_lookup: FN() -> FN(MIRLoweringSchemasSchemaName) -> ?MIRLoweringSchemasSchemaLookupResult, next_label: FN() -> String, set_current_label: FN(String) -> Void, next_item_temp_name: FN() -> String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.visit_mir = COPY visit_mir;
    rtoc_self_view.alloc_mark_fact = COPY alloc_mark_fact;
    rtoc_self_view.result_alloc = COPY result_alloc;
    rtoc_self_view.bc_target = COPY bc_target;
    rtoc_self_view.schema_lookup = COPY schema_lookup;
    rtoc_self_view.next_label = COPY next_label;
    rtoc_self_view.set_current_label = COPY set_current_label;
    rtoc_self_view.next_item_temp_name = COPY next_item_temp_name;
    rtoc_self_view.current_label = NIL;
}
END
PUB FN runtimeHost__materializer_visit_mir(self: RuntimeHost, node: Locatable) RETURNS Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN runtimeHost__visit_mir_call(rtoc_self_view, node);
}
END
PUB FN runtimeHost__materializer_alloc_mark_fact(self: RuntimeHost, value: Emittable, name: String, fallback_alloc: String@symbol, type_info: ?Type = NIL, ast_node: ?Locatable = NIL, context: String = "pipeline allocation", known_allocating: Bool = FALSE) RETURNS ?AllocationFact
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN runtimeHost__alloc_mark_fact_call(rtoc_self_view, value, name, fallback_alloc, type_info, ast_node, context, known_allocating);
}
END
