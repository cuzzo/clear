    Locatable.TestThat AS cast_payload -> RETURN MIRLoweringLowerableStmt{ TestThat: COPY cast_payload };,
    Locatable.StubDecl AS cast_payload -> RETURN MIRLoweringLowerableStmt{ StubDecl: COPY cast_payload };,
