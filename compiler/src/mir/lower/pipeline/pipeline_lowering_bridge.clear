  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN castMIRLoweringReturnValueToEmittable(TRY (mIRLowering__emit_builtin(rtoc_self_view.lowering, name, args)));
}
END
PUB FN pipelineLoweringBridge__lower_head(self: PipelineLoweringBridge, blk: FN() -> Emittable) RETURNS PipelineLowerHeadResult
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE value, pending = rtoc_self_view.mIRLowering__lower_head(lowering, %() USE(blk) -> blk());
    MUTABLE typed_pending: []Emittable = COPY pending;
    RETURN PipelineLowerHeadResult{ value: COPY CAST(value AS Emittable), pending: COPY typed_pending };
}
END
