PUB FN pipelineLoweringBridge__with_shard_context<U>(MUTABLE self: PipelineLoweringBridge, context: ?{String@symbol}String, blk: FN() -> U) RETURNS !U
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE previous: ?{String@symbol}String = TRY (mIRLowering__shard_context(rtoc_self_view.lowering));
  DEFER TRY (mIRLowering__set_shard_context(rtoc_self_view.lowering, previous));
  TRY (mIRLowering__set_shard_context(rtoc_self_view.lowering, context));
  RETURN blk();
}
END
PUB FN pipelineLoweringBridge__new(lowering: MIRLowering, emitter: MIREmitter) RETURNS PipelineLoweringBridge@multiowned ->
  MUTABLE self = PipelineLoweringBridge{ lowering: COPY lowering };
  pipelineLoweringBridge__initialize(&self, lowering, emitter);
  RETURN self @multiowned;
END
