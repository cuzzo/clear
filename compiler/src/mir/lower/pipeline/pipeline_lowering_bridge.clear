PUB FN pipelineLoweringBridge__initialize(MUTABLE self: PipelineLoweringBridge, lowering: MIRLowering, emitter: MIREmitter) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.lowering = COPY lowering;
    MUTABLE rtoc_writer_receiver_1: MIRLoweringRuntimeState = mIRLowering__runtime_state(rtoc_self_view.lowering);
    rtoc_writer_receiver_1.emitter = emitter;
}
END
