PUB FN pipelineLoweringBridge__lower_node(MUTABLE self: PipelineLoweringBridge, node: Locatable) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN CAST(TRY (mIRLowering__lower(&rtoc_self_view.lowering, castLocatableToMIRLoweringLowerableStmt(node))) AS Emittable);
}
END
