    Locatable.Return AS cast_payload -> RETURN MIRLoweringLowerableStmt{ Return: COPY cast_payload };,
    Locatable.ReassignCleanup AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ReassignCleanup: COPY cast_payload };,
    Locatable.FieldCleanup AS cast_payload -> RETURN MIRLoweringLowerableStmt{ FieldCleanup: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to MIRLoweringLowerableStmt");
  END
  panic("Invalid cast to MIRLoweringLowerableStmt");
END
FN castMIRLoweringReturnValueToEmittable(value: MIRLoweringReturnValue) RETURNS Emittable ->
  PARTIAL MATCH value START
    MIRLoweringReturnValue.Cleanup AS cast_payload -> RETURN Emittable{ Cleanup: COPY cast_payload };,
    MIRLoweringReturnValue.ErrCleanup AS cast_payload -> RETURN Emittable{ ErrCleanup: COPY cast_payload };,
    MIRLoweringReturnValue.InlineBc AS cast_payload -> RETURN Emittable{ InlineBc: COPY cast_payload };,
    MIRLoweringReturnValue.RegistryCall AS cast_payload -> RETURN Emittable{ RegistryCall: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Emittable");
  END
  panic("Invalid cast to Emittable");
END
