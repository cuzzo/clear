    Locatable.BindExpr AS cast_payload -> RETURN MIRLoweringLowerableStmt{ BindExpr: COPY cast_payload };,
    Locatable.BinaryOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ BinaryOp: COPY cast_payload };,
    Locatable.IsA AS cast_payload -> RETURN MIRLoweringLowerableStmt{ IsA: COPY cast_payload };,
    Locatable.CallSiteOverride AS cast_payload -> RETURN MIRLoweringLowerableStmt{ CallSiteOverride: COPY cast_payload };,
    Locatable.Identifier AS cast_payload -> RETURN MIRLoweringLowerableStmt{ Identifier: COPY cast_payload };,
    Locatable.Literal AS cast_payload -> RETURN MIRLoweringLowerableStmt{ Literal: COPY cast_payload };,
    Locatable.ListLit AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ListLit: COPY cast_payload };,
    Locatable.TupleLit AS cast_payload -> RETURN MIRLoweringLowerableStmt{ TupleLit: COPY cast_payload };,
    Locatable.DefaultArrayLit AS cast_payload -> RETURN MIRLoweringLowerableStmt{ DefaultArrayLit: COPY cast_payload };,
    Locatable.HashLit AS cast_payload -> RETURN MIRLoweringLowerableStmt{ HashLit: COPY cast_payload };,
    Locatable.DefaultLit AS cast_payload -> RETURN MIRLoweringLowerableStmt{ DefaultLit: COPY cast_payload };,
    Locatable.StructLit AS cast_payload -> RETURN MIRLoweringLowerableStmt{ StructLit: COPY cast_payload };,
    Locatable.LambdaLit AS cast_payload -> RETURN MIRLoweringLowerableStmt{ LambdaLit: COPY cast_payload };,
