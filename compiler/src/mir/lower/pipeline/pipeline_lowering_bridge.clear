PUB FN pipelineLoweringBridge__pipeline_alloc_mark_fact(self: PipelineLoweringBridge, value: Emittable, name: String, fallback_alloc: String@symbol, type_info: ?Type = NIL, ast_node: ?Locatable = NIL, context: String = "pipeline allocation", known_allocating: Bool = FALSE, accept_owned_call: Bool = FALSE, include_cleanup: Bool = FALSE) RETURNS ?PipelineBridgeAllocationFact
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fact: ?PipelineAllocMarkFact = mIRLowering__pipeline_alloc_mark_fact(rtoc_self_view.lowering, value, name, fallback_alloc, type_info, ast_node, context, known_allocating, accept_owned_call, include_cleanup);
    IF fact EXISTS AS fact_value THEN
      RETURN PipelineBridgeAllocationFact{ alloc: COPY fact_value.alloc, mark: COPY fact_value.mark, cleanup_entry: KEEP fact_value.cleanup_entry };
    ELSE
      RETURN NIL;
    END
}
END
