PUB FN pipelineLoweringBridge__emit_mir(self: PipelineLoweringBridge, node: Emittable) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_3 = ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_2 = mIRLowering__runtime_state(rtoc_self_view.lowering);
    mIRLoweringRuntimeState__emitter_mut(&rtoc_mutable_receiver_2) });
    TRY (mIREmitter__emit(&rtoc_mutable_receiver_3, node)) };
}
END
