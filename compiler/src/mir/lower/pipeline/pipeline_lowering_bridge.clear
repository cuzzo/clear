    Locatable.CloseStream AS cast_payload -> RETURN MIRLoweringLowerableStmt{ CloseStream: COPY cast_payload };,
    Locatable.NextExpr AS cast_payload -> RETURN MIRLoweringLowerableStmt{ NextExpr: COPY cast_payload };,
    Locatable.MatchStatement AS cast_payload -> RETURN MIRLoweringLowerableStmt{ MatchStatement: COPY cast_payload };,
    Locatable.ForRange AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ForRange: COPY cast_payload };,
    Locatable.ForEach AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ForEach: COPY cast_payload };,
    Locatable.TestBlock AS cast_payload -> RETURN MIRLoweringLowerableStmt{ TestBlock: COPY cast_payload };,
    Locatable.WhenBlock AS cast_payload -> RETURN MIRLoweringLowerableStmt{ WhenBlock: COPY cast_payload };,
