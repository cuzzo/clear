PRIVATE FN pipelineBindingChainLowerer__fold_plan(self: PipelineBindingChainLowerer, init: []Emittable, body: []Emittable, post_inner: []Emittable, result: Emittable) RETURNS PipelineBindingFoldPlan ->
  RETURN PipelineBindingFoldPlan{ init_stmts: COPY init, loop_body_stmts: COPY body, post_inner_stmts: COPY post_inner, result_expr: COPY result };
END
PRIVATE FN pipelineBindingChainLowerer__binding_chain_shape?(self: PipelineBindingChainLowerer, node: BinaryOp) RETURNS Bool ->
  MUTABLE has_bind_source: Bool = FALSE;
  MUTABLE has_unnest_stage: Bool = FALSE;
  MUTABLE cursor: Locatable = COPY node.left;
  WHILE cursor IS_A BinaryOp DO
    IF (cursor.op() == :BIND_VAR) THEN
      has_bind_source = TRUE;
    END
    MUTABLE rhs = cursor.right();
    IF rhs IS_A UnnestOp THEN
      has_unnest_stage = TRUE;
      MUTABLE unnest_expr = rhs.expression();
      IF (unnest_expr IS_A BinaryOp AND (unnest_expr.op() == :BIND_VAR)) THEN
        has_bind_source = TRUE;
      END
    END
    IF !(cursor.smooth?()) THEN
      BREAK;
    END
    cursor = cursor.left();
  END
  RETURN (has_bind_source AND has_unnest_stage);
END
PRIVATE FN pipelineBindingChainLowerer__wrap_stages(self: PipelineBindingChainLowerer, stages: []Locatable, placeholder: String, accum_stmts: []Emittable) RETURNS ![]Emittable ->
  MUTABLE body: []Emittable = COPY accum_stmts;
  MUTABLE rtoc_reverse_items_11: []Locatable = stages;
  MUTABLE rtoc_reverse_i_12 = rtoc_reverse_items_11.length() - 1;
  WHILE rtoc_reverse_i_12 >= 0 DO
    IF (rtoc_reverse_items_11[rtoc_reverse_i_12])? IS_A SelectOp AS select_op THEN
        panic("SELECT is not supported in AS $v binding chains. Use WHERE to filter or name the projection with AS $o before the fold.");
    END
    IF !(((rtoc_reverse_items_11[rtoc_reverse_i_12])?) IS_A WhereOp) THEN
        rtoc_reverse_i_12 = rtoc_reverse_i_12 - 1;
  CONTINUE;
    END
    MUTABLE pred = pipelineBindingChainLowerer__visit_placeholder_expr(self, ((rtoc_reverse_items_11[rtoc_reverse_i_12])?).expression(), placeholder);
    body = [Emittable{ IfStmt: COPY IfStmt{ cond: COPY pred, then_body: body, else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL } }];
  rtoc_reverse_i_12 = rtoc_reverse_i_12 - 1;
  END
  RETURN body;
END
PRIVATE FN pipelineBindingChainLowerer__visit_placeholder_expr(self: PipelineBindingChainLowerer, expr: Locatable, placeholder: String) RETURNS Emittable ->
  RETURN pipelineBindingChainLowerer__visit_mir_with_placeholder_call(self, expr, placeholder);
END
FN castEmittableToLocatable(value: Emittable) RETURNS Locatable ->
  PARTIAL MATCH value START
    Emittable.MIRProgram AS cast_payload -> RETURN Locatable{ MIRProgram: COPY cast_payload };,
    Emittable.MIRStructDef AS cast_payload -> RETURN Locatable{ MIRStructDef: COPY cast_payload };,
    Emittable.MIREnumDef AS cast_payload -> RETURN Locatable{ MIREnumDef: COPY cast_payload };,
    Emittable.MIRDestructureTarget AS cast_payload -> RETURN Locatable{ MIRDestructureTarget: COPY cast_payload };,
    Emittable.MIRDeferStmt AS cast_payload -> RETURN Locatable{ MIRDeferStmt: COPY cast_payload };,
    Emittable.MIRBgBlock AS cast_payload -> RETURN Locatable{ MIRBgBlock: COPY cast_payload };,
    Emittable.MIRDoBlock AS cast_payload -> RETURN Locatable{ MIRDoBlock: COPY cast_payload };,
    Emittable.MIRMethodCall AS cast_payload -> RETURN Locatable{ MIRMethodCall: COPY cast_payload };,
    Emittable.MIRUnaryOp AS cast_payload -> RETURN Locatable{ MIRUnaryOp: COPY cast_payload };,
    Emittable.MIRBlockExpr AS cast_payload -> RETURN Locatable{ MIRBlockExpr: COPY cast_payload };,
    Emittable.MIRCast AS cast_payload -> RETURN Locatable{ MIRCast: COPY cast_payload };,
    Emittable.MIROptionalUnwrap AS cast_payload -> RETURN Locatable{ MIROptionalUnwrap: COPY cast_payload };,
    Emittable.MIRRangeLit AS cast_payload -> RETURN Locatable{ MIRRangeLit: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Locatable");
  END
  panic("Invalid cast to Locatable");
END
FN castLocatableToPipelineBindingFoldOp(value: Locatable) RETURNS PipelineBindingFoldOp ->
  PARTIAL MATCH value START
    Locatable.FindOp AS cast_payload -> RETURN PipelineBindingFoldOp{ FindOp: COPY cast_payload };,
    Locatable.AnyOp AS cast_payload -> RETURN PipelineBindingFoldOp{ AnyOp: COPY cast_payload };,
    Locatable.AllOp AS cast_payload -> RETURN PipelineBindingFoldOp{ AllOp: COPY cast_payload };,
    Locatable.CountOp AS cast_payload -> RETURN PipelineBindingFoldOp{ CountOp: COPY cast_payload };,
    Locatable.SumOp AS cast_payload -> RETURN PipelineBindingFoldOp{ SumOp: COPY cast_payload };,
    Locatable.AverageOp AS cast_payload -> RETURN PipelineBindingFoldOp{ AverageOp: COPY cast_payload };,
    Locatable.MinOp AS cast_payload -> RETURN PipelineBindingFoldOp{ MinOp: COPY cast_payload };,
    Locatable.MaxOp AS cast_payload -> RETURN PipelineBindingFoldOp{ MaxOp: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to PipelineBindingFoldOp");
  END
  panic("Invalid cast to PipelineBindingFoldOp");
END
