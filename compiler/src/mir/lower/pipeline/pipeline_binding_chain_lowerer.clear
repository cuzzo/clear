REQUIRE "pkg:rtoc_6173742f747970652e636c656172" AS type
REQUIRE "pkg:rtoc_6173742f6173742e636c656172" AS ast
REQUIRE "pkg:rtoc_6d69722f6d69722e636c656172" AS mir
REQUIRE "pkg:rtoc_6d69722f6c6f7765722f706970656c696e652f706970656c696e655f7265636f7264732e636c656172" AS pipeline_records
EXTERN STRUCT CompilerRegex {} FROM "compiler_regex";
EXTERN FN compilerRegexCompile(pattern: String) RETURNS CompilerRegex EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexReplaceFirst(subject: String, regex: CompilerRegex, replacement: String) RETURNS String EFFECTS :safe FROM "compiler_regex";
PUB UNION PipelineBindingFoldOp { SumOpMultiowned: SumOp@multiowned, CountOpMultiowned: CountOp@multiowned, AverageOpMultiowned: AverageOp@multiowned, MinOpMultiowned: MinOp@multiowned, MaxOpMultiowned: MaxOp@multiowned, AnyOpMultiowned: AnyOp@multiowned, AllOpMultiowned: AllOp@multiowned, FindOpMultiowned: FindOp@multiowned, SumOp: SumOp, CountOp: CountOp, AverageOp: AverageOp, MinOp: MinOp, MaxOp: MaxOp, AnyOp: AnyOp, AllOp: AllOp, FindOp: FindOp }
PUB STRUCT PipelineBindingUnnestChain {
  source: Locatable,
  outer_binding: String,
  unnest_expr: Locatable,
  inner_binding: ?String,
  stages: []Locatable,
  fold: PipelineBindingFoldOp
}
PUB STRUCT PipelineBindingNames {
  source: String,
  unnest: String,
  accumulator: String,
  sum: String,
  count: String,
  value: String,
  result: String,
  found: String
}
PUB STRUCT PipelineBindingFoldPlan {
  init_stmts: []Emittable,
  loop_body_stmts: []Emittable,
  post_inner_stmts: []Emittable,
  result_expr: Emittable
}
PUB STRUCT PipelineBindingChainLowerer {
  bc_target: FN() -> Bool,
  next_label: FN() -> String,
  set_current_label: FN(String) -> Void,
  pipe_binding_zig_name: FN(String) -> String,
  visit_mir: FN(Locatable) -> Emittable,
  visit_mir_with_placeholder: FN(Locatable, String) -> Emittable,
  visit_mir_with_reduce_placeholders: FN(Locatable, String, String) -> Emittable,
  transpile_type: FN(PipelineTypeInput) -> String,
  with_named_bindings: FN({String}String, FN() -> MIRBlockExpr) -> MIRBlockExpr,
  ast_uses_placeholder: FN(Locatable) -> Bool
}

PUB FN pipelineBindingChainLowerer__unwrap_chain(self: PipelineBindingChainLowerer, node: BinaryOp) RETURNS !?PipelineBindingUnnestChain ->
  IF !(binaryOp__smooth?(node)) THEN
    RETURN NIL;
  END
  MUTABLE fold = COPY node.right;
  IF !(aST__pipeline_range_fold?(fold)) THEN
    IF pipelineBindingChainLowerer__binding_chain_shape?(self, node) THEN
      panic("Materializing terminals are not supported in AS $v binding chains. End the chain with a fold terminal (COUNT/SUM/MIN/MAX/AVERAGE/ANY/ALL/FIND), or restructure as nested pipelines (e.g. UNNEST _.field |> SELECT ...).");
    END
    RETURN NIL;
  END
  MUTABLE cursor: Locatable = COPY node.left;
  MUTABLE stages: []Locatable = ( { MUTABLE rtoc_empty_list_1: []Locatable = List[]; rtoc_empty_list_1 } );
  MUTABLE cursor_is_smooth: Bool = FALSE;
  IF cursor IS_A BinaryOp AS binary_op THEN
    cursor_is_smooth = binaryOp__smooth?(binary_op);
  END
  WHILE cursor_is_smooth DO
    cursor_is_smooth = FALSE;
    IF cursor IS_A BinaryOp AS stage_op THEN
      MUTABLE stage_rhs: Locatable = COPY stage_op.right;
      IF aST__pipeline_select_filter_op?(stage_rhs) THEN
        stages = ([stage_rhs] + stages);
        cursor = COPY stage_op.left;
        IF cursor IS_A BinaryOp AS next_op THEN
          cursor_is_smooth = binaryOp__smooth?(next_op);
        END
      END
    END
  END
  IF cursor IS_A BinaryOp AS binary_op THEN
  IF binaryOp__smooth?(binary_op) THEN
      MUTABLE lhs = binary_op.left;
      MUTABLE rhs = binary_op.right;
      IF rhs IS_A UnnestOp AS unnest_op THEN
        MUTABLE unnest_expr: Locatable = unnestOp__expression(unnest_op);
        MUTABLE inner_binding: ?String = NIL;
        IF (IF unnest_expr IS_A BinaryOp AS binary_op THEN (binary_op.op == :BIND_VAR) ELSE FALSE END) THEN
          inner_binding = COPY CAST(unnest_expr.right().name() AS String);
          unnest_expr = unnest_expr.left();
        END
        IF lhs IS_A BinaryOp AS binary_op THEN
        IF (binary_op.op == :BIND_VAR) THEN
            RETURN PipelineBindingUnnestChain{ source: COPY binary_op.left, outer_binding: COPY CAST(binary_op.right.name() AS String), unnest_expr: COPY unnest_expr, inner_binding: COPY inner_binding, stages: COPY stages, fold: COPY castLocatableToPipelineBindingFoldOp(fold) };
          ELSE
            RETURN NIL;
          END
        ELSE
          RETURN NIL;
        END
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
  ELSE
    RETURN NIL;
  END
END
PUB FN pipelineBindingChainLowerer__lower(self: PipelineBindingChainLowerer, chain: PipelineBindingUnnestChain, MUTABLE smooth_node: BinaryOp) RETURNS !MIRBlockExpr ->
  MUTABLE outer_name = COPY chain.outer_binding;
  MUTABLE outer_zig = pipelineBindingChainLowerer__pipe_binding_zig_name_call(self, outer_name);
  MUTABLE inner_name: ?String = COPY chain.inner_binding;
  MUTABLE inner_zig: String = "";
  IF inner_name EXISTS AS inner_name_value THEN
    inner_zig = pipelineBindingChainLowerer__pipe_binding_zig_name_call(self, inner_name_value);
  ELSE
    inner_zig = "__bc_inner";
  END
  MUTABLE label = pipelineBindingChainLowerer__next_label_call(self);
  pipelineBindingChainLowerer__set_current_label_call(self, label);
  MUTABLE names = pipelineBindingChainLowerer__binding_names(self, label);
  MUTABLE bindings: {String}String = CAST({outer_name: outer_zig} AS {String}String);
  IF inner_name EXISTS AS inner_name_value THEN
    bindings[inner_name_value] = inner_zig;
  END
  RETURN pipelineBindingChainLowerer__with_named_bindings_call(self, bindings, %() USE(chain, inner_zig, label, names, outer_zig, MUTABLE smooth_node, self) -> {
  MUTABLE source_mir = pipelineBindingChainLowerer__visit_mir_call(self, chain.source);
  MUTABLE unnest_mir = pipelineBindingChainLowerer__visit_mir_call(self, chain.unnest_expr);
  MUTABLE fold_plan = TRY (pipelineBindingChainLowerer__lower_binding_fold(self, chain.fold, chain.stages, inner_zig, &smooth_node, names));
  MUTABLE loop_body = TRY (pipelineBindingChainLowerer__binding_loop_body(self, chain, inner_zig, fold_plan.loop_body_stmts));
  MUTABLE inner_loop = ForStmt{ iter: Emittable{ ItemsAccess: COPY ItemsAccess{ expr: Emittable{ Ident: COPY Ident{ name: COPY names.unnest, lowered_node_id: NIL, ownership_consumption: NIL } }, safe: TRUE, lowered_node_id: NIL, ownership_consumption: NIL } }, capture: inner_zig, body: Body{ ArrayValue: loop_body |> SELECT castEmittableToLocatable(_) }, index_capture: NIL, mark_per_iter: NIL, tight: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
  MUTABLE outer_loop = ForStmt{ iter: Emittable{ ItemsAccess: COPY ItemsAccess{ expr: Emittable{ Ident: COPY Ident{ name: COPY names.source, lowered_node_id: NIL, ownership_consumption: NIL } }, safe: TRUE, lowered_node_id: NIL, ownership_consumption: NIL } }, capture: outer_zig, body: COPY ([Let{ name: COPY names.unnest, init: COPY unnest_mir, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }, inner_loop] + fold_plan.post_inner_stmts), index_capture: NIL, mark_per_iter: NIL, tight: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
  MIRBlockExpr{ label: label, body: COPY ([Let{ name: COPY names.source, init: COPY source_mir, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }] + fold_plan.init_stmts + [outer_loop, BreakStmt{ label: label, value: COPY fold_plan.result_expr, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }]), lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL }
  });
END
PRIVATE FN pipelineBindingChainLowerer__binding_names(self: PipelineBindingChainLowerer, label: String) RETURNS PipelineBindingNames ->
  MUTABLE suffix: String = "";
  IF pipelineBindingChainLowerer__bc_target_call(self) THEN
    suffix = "_${compilerRegexReplaceFirst(label, compilerRegexCompile("__pblk"), "b")}";
  ELSE
    suffix = "";
  END
  RETURN PipelineBindingNames{ source: "__bc_src${suffix}", unnest: "__bc_unn${suffix}", accumulator: "__bc_acc${suffix}", sum: "__bc_sum${suffix}", count: "__bc_cnt${suffix}", value: "__bc_val${suffix}", result: "__bc_result${suffix}", found: "__bc_found${suffix}" };
END
PRIVATE FN pipelineBindingChainLowerer__binding_loop_body(self: PipelineBindingChainLowerer, chain: PipelineBindingUnnestChain, inner_zig: String, loop_body: []Emittable) RETURNS ![]Emittable ->
  IF ((chain.inner_binding != NIL) OR pipelineBindingChainLowerer__inner_capture_required?(self, chain)) THEN
    RETURN COPY loop_body;
  END
  RETURN CAST((CAST([Emittable{ Suppress: COPY Suppress{ name: COPY inner_zig, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable) + COPY loop_body) AS []Emittable);
END
PRIVATE FN pipelineBindingChainLowerer__inner_capture_required?(self: PipelineBindingChainLowerer, chain: PipelineBindingUnnestChain) RETURNS Bool ->
  IF chain.fold IS_A FindOp THEN
    RETURN TRUE;
  END
  MUTABLE fold_expr: ?Locatable = pipelineBindingChainLowerer__fold_expression(self, chain.fold);
  IF ((fold_expr != NIL) AND pipelineBindingChainLowerer__ast_uses_placeholder_call(self, fold_expr)) THEN
    RETURN TRUE;
  END
  RETURN chain.stages |> ANY (IF _ IS_A WhereOp AS where_op THEN pipelineBindingChainLowerer__ast_uses_placeholder_call(self, whereOp__expression(where_op)) ELSE FALSE END);
END
PRIVATE FN pipelineBindingChainLowerer__fold_expression(self: PipelineBindingChainLowerer, fold: PipelineBindingFoldOp) RETURNS ?Locatable ->
  IF fold IS_A SumOp@multiowned AS sum_op_multiowned THEN
    RETURN sumOp__expression(sum_op_multiowned);
  ELSE_IF fold IS_A CountOp@multiowned AS count_op_multiowned THEN
    RETURN countOp__expression(count_op_multiowned);
  ELSE_IF fold IS_A AverageOp@multiowned AS average_op_multiowned THEN
    RETURN averageOp__expression(average_op_multiowned);
  ELSE_IF fold IS_A MinOp@multiowned AS min_op_multiowned THEN
    RETURN minOp__expression(min_op_multiowned);
  ELSE_IF fold IS_A MaxOp@multiowned AS max_op_multiowned THEN
    RETURN maxOp__expression(max_op_multiowned);
  ELSE_IF fold IS_A AnyOp@multiowned AS any_op_multiowned THEN
    RETURN anyOp__expression(any_op_multiowned);
  ELSE_IF fold IS_A AllOp@multiowned AS all_op_multiowned THEN
    RETURN allOp__expression(all_op_multiowned);
  ELSE_IF fold IS_A FindOp@multiowned AS find_op_multiowned THEN
    RETURN findOp__expression(find_op_multiowned);
  ELSE
    RETURN NIL;
  END
END
PRIVATE FN pipelineBindingChainLowerer__lower_binding_fold(self: PipelineBindingChainLowerer, fold: PipelineBindingFoldOp, stages: []Locatable, placeholder: String, MUTABLE smooth_node: BinaryOp, names: PipelineBindingNames) RETURNS !PipelineBindingFoldPlan ->
  IF fold IS_A SumOp@multiowned AS sum_op_multiowned THEN
    MUTABLE expr = pipelineBindingChainLowerer__visit_placeholder_expr(self, sumOp__expression(sum_op_multiowned), placeholder);
    MUTABLE result_type = TRY (type__new(TypeConstructionInput{ Type: COPY TRY (aST__full_type_mut(smooth_node)) }));
    MUTABLE init_literal: String = "";
    IF type__integer?(result_type) THEN
      init_literal = "0";
    ELSE
      init_literal = "0.0";
    END
    MUTABLE init = [Let{ name: COPY names.accumulator, init: Emittable{ Lit: COPY Lit{ value: COPY init_literal, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: COPY result_type, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }];
    MUTABLE accum = [Set{ target: Emittable{ Ident: COPY Ident{ name: COPY names.accumulator, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ MIRBinOp: COPY MIRBinOp{ op: "+", left: Emittable{ Ident: COPY Ident{ name: COPY names.accumulator, lowered_node_id: NIL, ownership_consumption: NIL } }, right: COPY expr, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }];
    RETURN pipelineBindingChainLowerer__fold_plan(self, init, TRY (pipelineBindingChainLowerer__wrap_stages(self, stages, placeholder, accum)), ( { MUTABLE rtoc_empty_list_2: []Emittable = List[]; rtoc_empty_list_2 } ), Emittable{ Ident: COPY Ident{ name: COPY names.accumulator, lowered_node_id: NIL, ownership_consumption: NIL } });
  ELSE_IF fold IS_A CountOp@multiowned AS count_op_multiowned THEN
    MUTABLE pred = pipelineBindingChainLowerer__visit_placeholder_expr(self, countOp__expression(count_op_multiowned), placeholder);
    MUTABLE init = [Let{ name: COPY names.accumulator, init: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: COPY TRY (type__new(TypeConstructionInput{ StringValue: COPY "i64" })), suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }];
    MUTABLE accum = [IfStmt{ cond: COPY pred, then_body: [Set{ target: Emittable{ Ident: COPY Ident{ name: COPY names.accumulator, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ MIRBinOp: COPY MIRBinOp{ op: "+", left: Emittable{ Ident: COPY Ident{ name: COPY names.accumulator, lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Lit: COPY Lit{ value: "1", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL }];
    RETURN pipelineBindingChainLowerer__fold_plan(self, init, TRY (pipelineBindingChainLowerer__wrap_stages(self, stages, placeholder, accum)), ( { MUTABLE rtoc_empty_list_3: []Emittable = List[]; rtoc_empty_list_3 } ), Emittable{ Ident: COPY Ident{ name: COPY names.accumulator, lowered_node_id: NIL, ownership_consumption: NIL } });
  ELSE_IF fold IS_A AverageOp@multiowned AS average_op_multiowned THEN
    MUTABLE expr = pipelineBindingChainLowerer__visit_placeholder_expr(self, averageOp__expression(average_op_multiowned), placeholder);
    MUTABLE init = [Let{ name: COPY names.sum, init: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: COPY TRY (type__new(TypeConstructionInput{ StringValue: COPY "f64" })), suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }, Let{ name: COPY names.count, init: Emittable{ Lit: COPY Lit{ value: "0.0", lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: COPY TRY (type__new(TypeConstructionInput{ StringValue: COPY "f64" })), suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }];
    MUTABLE accum = [Set{ target: Emittable{ Ident: COPY Ident{ name: COPY names.sum, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ MIRBinOp: COPY MIRBinOp{ op: "+", left: Emittable{ Ident: COPY Ident{ name: COPY names.sum, lowered_node_id: NIL, ownership_consumption: NIL } }, right: COPY expr, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }, Set{ target: Emittable{ Ident: COPY Ident{ name: COPY names.count, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ MIRBinOp: COPY MIRBinOp{ op: "+", left: Emittable{ Ident: COPY Ident{ name: COPY names.count, lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Lit: COPY Lit{ value: "1.0", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }];
    MUTABLE result = Conditional{ cond: Emittable{ MIRBinOp: COPY MIRBinOp{ op: "==", left: Emittable{ Ident: COPY Ident{ name: COPY names.count, lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Lit: COPY Lit{ value: "0.0", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, then_val: Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: "f64", method: :as, lowered_node_id: NIL, ownership_consumption: NIL } }, else_val: Emittable{ MIRBinOp: COPY MIRBinOp{ op: "/", left: Emittable{ Ident: COPY Ident{ name: COPY names.sum, lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Ident: COPY Ident{ name: COPY names.count, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL };
    RETURN pipelineBindingChainLowerer__fold_plan(self, init, TRY (pipelineBindingChainLowerer__wrap_stages(self, stages, placeholder, accum)), ( { MUTABLE rtoc_empty_list_4: []Emittable = List[]; rtoc_empty_list_4 } ), Emittable{ Conditional: COPY result });
  ELSE_IF fold IS_A MinOp@multiowned AS min_op_multiowned THEN
    MUTABLE expr = pipelineBindingChainLowerer__visit_placeholder_expr(self, minOp__expression(min_op_multiowned), placeholder);
    MUTABLE result_type = TRY (type__new(minOp__expression(min_op_multiowned).full_type_mut()));
    MUTABLE zig_type = TRY (type__zig_type(result_type));
    MUTABLE init = [Let{ name: COPY names.accumulator, init: Emittable{ TypeSentinel: COPY TypeSentinel{ extreme: :max, zig_type: zig_type, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: COPY result_type, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }];
    MUTABLE accum: Tuple<Let, IfStmt> = CAST(Tuple{Let{ name: COPY names.value, init: COPY expr, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }, IfStmt{ cond: Emittable{ MIRBinOp: COPY MIRBinOp{ op: "<", left: Emittable{ Ident: COPY Ident{ name: COPY names.value, lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Ident: COPY Ident{ name: COPY names.accumulator, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: [Set{ target: Emittable{ Ident: COPY Ident{ name: COPY names.accumulator, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Ident: COPY Ident{ name: COPY names.value, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL }} AS Tuple<Let, IfStmt>);
    RETURN pipelineBindingChainLowerer__fold_plan(self, init, TRY (pipelineBindingChainLowerer__wrap_stages(self, stages, placeholder, accum)), ( { MUTABLE rtoc_empty_list_5: []Emittable = List[]; rtoc_empty_list_5 } ), Emittable{ Ident: COPY Ident{ name: COPY names.accumulator, lowered_node_id: NIL, ownership_consumption: NIL } });
  ELSE_IF fold IS_A MaxOp@multiowned AS max_op_multiowned THEN
    MUTABLE expr = pipelineBindingChainLowerer__visit_placeholder_expr(self, maxOp__expression(max_op_multiowned), placeholder);
    MUTABLE result_type = TRY (type__new(maxOp__expression(max_op_multiowned).full_type_mut()));
    MUTABLE zig_type = TRY (type__zig_type(result_type));
    MUTABLE sentinel = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_7: ?Lit = NIL;
    IF type__unsigned_integer?(result_type) THEN
      rtoc_ternary_value_7 = Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL };
    ELSE
      rtoc_ternary_value_7 = TypeSentinel{ extreme: :min, zig_type: zig_type, lowered_node_id: NIL, ownership_consumption: NIL };
    END
    rtoc_ternary_value_7? };
    MUTABLE init = [Let{ name: COPY names.accumulator, init: COPY sentinel, mutable: TRUE, annotation: COPY result_type, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }];
    MUTABLE accum: Tuple<Let, IfStmt> = CAST(Tuple{Let{ name: COPY names.value, init: COPY expr, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }, IfStmt{ cond: Emittable{ MIRBinOp: COPY MIRBinOp{ op: ">", left: Emittable{ Ident: COPY Ident{ name: COPY names.value, lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Ident: COPY Ident{ name: COPY names.accumulator, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: [Set{ target: Emittable{ Ident: COPY Ident{ name: COPY names.accumulator, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Ident: COPY Ident{ name: COPY names.value, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL }} AS Tuple<Let, IfStmt>);
    RETURN pipelineBindingChainLowerer__fold_plan(self, init, TRY (pipelineBindingChainLowerer__wrap_stages(self, stages, placeholder, accum)), ( { MUTABLE rtoc_empty_list_8: []Emittable = List[]; rtoc_empty_list_8 } ), Emittable{ Ident: COPY Ident{ name: COPY names.accumulator, lowered_node_id: NIL, ownership_consumption: NIL } });
  ELSE_IF fold IS_A AnyOp@multiowned AS any_op_multiowned THEN
    MUTABLE pred = pipelineBindingChainLowerer__visit_placeholder_expr(self, anyOp__expression(any_op_multiowned), placeholder);
    MUTABLE init = [Let{ name: COPY names.accumulator, init: Emittable{ Lit: COPY Lit{ value: "false", lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }];
