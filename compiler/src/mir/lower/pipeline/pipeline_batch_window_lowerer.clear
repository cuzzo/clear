REQUIRE "pkg:rtoc_6d69722f6c6f7765722f706970656c696e652f706970656c696e655f7265636f7264732e636c656172" AS pipeline_records
PUB UNION PipelineBatchWindowTypeInput { TypeMultiowned: Type@multiowned, SymbolValue: String@symbol, StringValue: String, Type: Type }
PUB ENUM PipelineBatchWindowSourceKind { BcInfiniteStream, BcMaterialized, ZigRuntimeStream, ZigBoundedStream, ZigMaterialized }
PUB STRUCT PipelineBatchWindowPlan {
  source_kind: PipelineBatchWindowSourceKind,
  list_node: Locatable,
  smooth_node: BinaryOp,
  element_zig: String,
  result_zig: String,
  size_mir: Emittable,
  make_expr: FN() -> Emittable,
  alloc: String@symbol,
  placeholder_var: String,
  timeout_ns: String,
  stream_pop_method: ?String
}
PUB STRUCT PipelineBatchWindowLowerer {
  bc_target: FN() -> Bool,
  visit_mir: FN(Locatable) -> Emittable,
  visit_mir_with_placeholder: FN(Locatable, String) -> Emittable,
  visit_expr_head: FN(Locatable, String) -> PipelineElementHead,
  pipeline_block: FN(Locatable, FN(String, String) -> !Emittable[]) -> MIRBlockExpr,
  next_label: FN() -> String,
  set_current_label: FN(String) -> Void,
  transpile_type: FN(PipelineBatchWindowTypeInput) -> String,
  pipeline_alloc: FN(BinaryOp) -> String@symbol
}

batch_window_time_units: [4]String = ["min", "ms", "s", "h"];
PUB FN pipelineBatchWindowLowerer__lower(self: PipelineBatchWindowLowerer, MUTABLE list_node: Locatable, smooth_node: BinaryOp, bw_node: BatchWindowOp) RETURNS !MIRBlockExpr ->
  RETURN TRY (pipelineBatchWindowLowerer__lower_plan(self, TRY (pipelineBatchWindowLowerer__batch_window_plan(self, &list_node, smooth_node, bw_node))));
END
PRIVATE FN pipelineBatchWindowLowerer__batch_window_plan(self: PipelineBatchWindowLowerer, MUTABLE list_node: Locatable, smooth_node: BinaryOp, bw_node: BatchWindowOp) RETURNS !PipelineBatchWindowPlan ->
  MUTABLE lhs_type = TRY (aST__full_type_mut(list_node));
  MUTABLE placeholder_var = "__bw_batch";
  RETURN PipelineBatchWindowPlan{ source_kind: COPY pipelineBatchWindowLowerer__source_kind_for(self, list_node, lhs_type), list_node: COPY list_node, smooth_node: COPY smooth_node, element_zig: COPY pipelineBatchWindowLowerer__transpile_type_call(self, type__to_s((TRY (pipelineBatchWindowLowerer__batch_element_type(self, lhs_type))))), result_zig: COPY pipelineBatchWindowLowerer__transpile_type_call(self, CAST((&bw_node.expression.full_type_mut()) AS String)), size_mir: COPY pipelineBatchWindowLowerer__batch_size_mir(self, bw_node), make_expr: COPY pipelineBatchWindowLowerer__batch_expr_builder(self, bw_node, placeholder_var), alloc: COPY pipelineBatchWindowLowerer__pipeline_alloc_call(self, smooth_node), placeholder_var: COPY placeholder_var, timeout_ns: COPY pipelineBatchWindowLowerer__batch_window_timeout_ns(self, bw_node), stream_pop_method: COPY pipelineBatchWindowLowerer__runtime_stream_pop_method(self, lhs_type) };
END
PRIVATE FN pipelineBatchWindowLowerer__lower_plan(self: PipelineBatchWindowLowerer, plan: PipelineBatchWindowPlan) RETURNS !MIRBlockExpr ->
  RETURN TRY (pipelineBatchWindowLowerer__lower_source_plan(self, plan.source_kind, plan));
END
PRIVATE FN pipelineBatchWindowLowerer__lower_source_plan(self: PipelineBatchWindowLowerer, source_kind: PipelineBatchWindowSourceKind, plan: PipelineBatchWindowPlan) RETURNS !MIRBlockExpr ->
  IF (source_kind == PipelineBatchWindowSourceKind.BcInfiniteStream) THEN
    RETURN TRY (pipelineBatchWindowLowerer__lower_bc_infinite_stream(self, plan));
  ELSE_IF (source_kind == PipelineBatchWindowSourceKind.BcMaterialized) THEN
    RETURN TRY (pipelineBatchWindowLowerer__lower_bc_materialized(self, plan));
  ELSE_IF (source_kind == PipelineBatchWindowSourceKind.ZigRuntimeStream) THEN
    RETURN TRY (pipelineBatchWindowLowerer__lower_zig_runtime_stream(self, plan));
  ELSE_IF (source_kind == PipelineBatchWindowSourceKind.ZigBoundedStream) THEN
    RETURN TRY (pipelineBatchWindowLowerer__lower_zig_bounded_stream(self, plan));
  ELSE_IF (source_kind == PipelineBatchWindowSourceKind.ZigMaterialized) THEN
    RETURN TRY (pipelineBatchWindowLowerer__lower_zig_materialized(self, plan));
  ELSE
    RETURN NIL;
  END
END
PRIVATE FN pipelineBatchWindowLowerer__source_kind_for(self: PipelineBatchWindowLowerer, list_node: Locatable, lhs_type: Type) RETURNS !PipelineBatchWindowSourceKind ->
  IF pipelineBatchWindowLowerer__bc_target_call(self) THEN
    IF (IF list_node IS_A Identifier AS identifier THEN TRY (type__inf_stream?(lhs_type)) ELSE FALSE END) THEN
      RETURN PipelineBatchWindowSourceKind.BcInfiniteStream;
    END
    RETURN PipelineBatchWindowSourceKind.BcMaterialized;
  END
  IF pipelineBatchWindowLowerer__runtime_stream?(self, lhs_type) THEN
    RETURN PipelineBatchWindowSourceKind.ZigRuntimeStream;
  END
  IF TRY (type__bounded_stream?(lhs_type)) THEN
    RETURN PipelineBatchWindowSourceKind.ZigBoundedStream;
  END
  RETURN PipelineBatchWindowSourceKind.ZigMaterialized;
END
PRIVATE FN pipelineBatchWindowLowerer__runtime_stream?(self: PipelineBatchWindowLowerer, lhs_type: Type) RETURNS !Bool ->
  RETURN ((TRY (type__open_stream?(lhs_type)) OR TRY (type__dynamic_stream?(lhs_type))) OR TRY (type__inf_stream?(lhs_type)));
END
PRIVATE FN pipelineBatchWindowLowerer__runtime_stream_pop_method(self: PipelineBatchWindowLowerer, lhs_type: Type) RETURNS !?String ->
  IF !(pipelineBatchWindowLowerer__runtime_stream?(self, lhs_type)) THEN
    RETURN NIL;
  END
  IF TRY (type__inf_stream?(lhs_type)) THEN
    RETURN "nextOrNull";
  ELSE
    RETURN "next";
  END
END
PRIVATE FN pipelineBatchWindowLowerer__batch_element_type(self: PipelineBatchWindowLowerer, lhs_type: Type) RETURNS !Type ->
  IF TRY (type__bounded_stream?(lhs_type)) THEN
    RETURN TRY (type__new(TypeConstructionInput{ StringValue: CAST(type__resolved((CAST(TRY (type__stream_element_type(lhs_type)) AS Type))) AS String) }));
  END
  IF TRY (type__runtime_stream_storage_element_type(lhs_type)) != NIL THEN
  RETURN (TRY (type__runtime_stream_storage_element_type(lhs_type)))?;
  ELSE
  RETURN UNWRAP (TRY (type__element_type(lhs_type)));
  END
END
PRIVATE FN pipelineBatchWindowLowerer__batch_expr_builder(self: PipelineBatchWindowLowerer, bw_node: BatchWindowOp, placeholder_var: String) RETURNS FN() -> Emittable ->
  RETURN %() USE(bw_node, placeholder_var, self) -> {
  MUTABLE head = pipelineBatchWindowLowerer__visit_expr_head_call(self, bw_node.expression, placeholder_var);
  IF ((head.pending.length() == 0) AND !(head.owned)) THEN
      RETURN head.value;
  END
  MUTABLE label = pipelineBatchWindowLowerer__next_label_call(self);
  MUTABLE block = MIRBlockExpr{ label: label, body: COPY (head.pending + [BreakStmt{ label: label, value: COPY head.value, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }]), lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
  block.lazy_boundary = TRUE;
  block
  };
END
PRIVATE FN pipelineBatchWindowLowerer__batch_size_mir(self: PipelineBatchWindowLowerer, bw_node: BatchWindowOp) RETURNS Emittable ->
  MUTABLE size = bw_node.options["size"];
  IF !(size) THEN
    RETURN Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } };
  END
  RETURN pipelineBatchWindowLowerer__visit_mir_call(self, size);
END
PRIVATE FN pipelineBatchWindowLowerer__batch_window_timeout_ns(self: PipelineBatchWindowLowerer, bw_node: BatchWindowOp) RETURNS String ->
  MUTABLE time: ?Literal = CAST(bw_node.options["time"] AS ?Literal);
  IF time EXISTS AS time_value THEN
    MUTABLE raw_value = COPY CAST(time_value.value AS String);
    MUTABLE unit = batch_window_time_units |> FIND raw_value.endsWith?(_);
    IF !(unit) THEN
      RETURN "0";
    END
    MUTABLE amount = raw_value.substr(0, (raw_value.codepointCount() - unit.length()));
    IF !(pipelineBatchWindowLowerer__decimal_literal?(self, amount)) THEN
      RETURN "0";
    END
    RETURN COPY (((amount.toFloat() OR_ELSE 0.0) * ([CAST(Tuple{"ms", 1000000} AS Tuple<String, Int64>), CAST(Tuple{"s", 1000000000} AS Tuple<String, Int64>), CAST(Tuple{"min", 60000000000} AS Tuple<String, Int64>), CAST(Tuple{"h", 3600000000000} AS Tuple<String, Int64>)]).to_h()[unit]?)).toInt().toString();
  ELSE
    RETURN "0";
  END
END
PRIVATE FN pipelineBatchWindowLowerer__decimal_literal?(self: PipelineBatchWindowLowerer, value: String) RETURNS Bool ->
  IF (value.length() == 0) THEN
    RETURN FALSE;
  END
  MUTABLE saw_digit: Bool = FALSE;
  MUTABLE saw_dot: Bool = FALSE;
  value.each_char(%(char) USE(MUTABLE saw_dot) -> {
  IF (char == ".") THEN
      IF saw_dot THEN
        RETURN FALSE;
      END
      saw_dot = TRUE;
  ELSE_IF ((char >= "0") AND (char <= "9")) THEN
      saw_digit = TRUE;
  ELSE
      RETURN FALSE;
  END
  rubyToClearVoid()
  });
  RETURN saw_digit;
END
