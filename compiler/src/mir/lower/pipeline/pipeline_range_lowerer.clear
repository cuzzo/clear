PUB FN pipelineRangeLowerer__finite_stream_source_node?(self: PipelineRangeLowerer, MUTABLE node: Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ((((node IS_A RangeLit OR TRY (type__dynamic_stream?((&node.full_type_mut())))) OR TRY (type__open_stream?((&node.full_type_mut())))) OR TRY (type__bounded_stream?((&node.full_type_mut())))) OR TRY (type__inf_stream?((&node.full_type_mut()))));
}
END
PUB FN pipelineRangeLowerer__unwrap_range_chain(self: PipelineRangeLowerer, MUTABLE node: Locatable) RETURNS ?PipelineRangeChain
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((IF node IS_A BinaryOp AS binary_op THEN binaryOp__smooth?(binary_op) ELSE FALSE END)) THEN
      IF pipelineRangeLowerer__finite_stream_source_node?(rtoc_self_view, &node) THEN
        RETURN PipelineRangeChain{ source: COPY node, stages: ( { MUTABLE rtoc_empty_list_4: []Locatable = List[]; rtoc_empty_list_4 } ) };
      END
      RETURN NIL;
    END
    MUTABLE stages: []Locatable = ( { MUTABLE rtoc_empty_list_5: []Locatable = List[]; rtoc_empty_list_5 } );
    MUTABLE cursor: Locatable = COPY node;
    WHILE (IF cursor IS_A BinaryOp AS binary_op THEN binaryOp__smooth?(binary_op) ELSE FALSE END) DO
      MUTABLE rhs = cursor.right();
      IF aST__pipeline_fusible_stage?(rhs) THEN
        &stages.unshift(rhs);
        cursor = cursor.left();
      ELSE
        RETURN NIL;
      END
    END
    IF !(pipelineRangeLowerer__finite_stream_source_node?(rtoc_self_view, &cursor)) THEN
      RETURN NIL;
    END
    RETURN PipelineRangeChain{ source: COPY cursor, stages: COPY stages };
}
END
PUB FN pipelineRangeLowerer__build_lazy_range_prefix(self: PipelineRangeLowerer, MUTABLE source_node: Locatable, stages: []Locatable, on_skip: ?[]FN(String) -> !Emittable = NIL, source_alloc: ?String@symbol = NIL, fiber_rt: ?String = NIL, track_owned_items: Bool = FALSE) RETURNS !PipelineLazyRangePrefix
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE source_ti = &source_node.full_type_mut();
    MUTABLE elem_t = (TRY (type__runtime_stream_storage_element_type(source_ti)) OR TRY (pipelineRangeLowerer__range_literal_element_type(rtoc_self_view, source_node)));
    MUTABLE elem_zig = TRY (type__zig_type(elem_t));
    MUTABLE initial_capture = "__each_item";
    MUTABLE item_var: String = initial_capture;
    MUTABLE item_counter = 0;
    MUTABLE item_used: Bool = FALSE;
    MUTABLE outer_stmts: []Emittable = ( { MUTABLE rtoc_empty_list_6: []Emittable = List[]; rtoc_empty_list_6 } );
    MUTABLE stage_stmts: []Emittable = ( { MUTABLE rtoc_empty_list_7: []Emittable = List[]; rtoc_empty_list_7 } );
    MUTABLE track_owned = (track_owned_items AND !(rtoc_self_view.host.range_bc_target?()));
    MUTABLE current_type: Type = elem_t;
    MUTABLE current_owned: Bool = FALSE;
    IF (track_owned AND TRY (type__runtime_stream?(source_ti))) THEN
      MUTABLE owned_stmts = TRY (pipelineRangeLowerer__owned_stream_item_stmts(rtoc_self_view, initial_capture, elem_t));
      stage_stmts = ruby_array_concat_Emittable(stage_stmts, owned_stmts);
      current_owned = !((owned_stmts.length() == 0));
    END
    MUTABLE lower_stages = %() USE(MUTABLE current_owned, MUTABLE current_type, initial_capture, item_counter, MUTABLE item_var, on_skip, MUTABLE outer_stmts, MUTABLE stage_stmts, stages, MUTABLE track_owned, MUTABLE owned_stmts, rtoc_self_view) -> {
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < stages.length() DO
      IF stages[rtoc_idx]? IS_A SelectOp AS select_op THEN
          item_used = TRUE;
          IF pipelinePlaceholderUsage__identity_placeholder?(selectOp__expression(select_op)) THEN
            RETURN NIL;
          END
          item_counter = (item_counter + 1);
          MUTABLE next_item = "__each_item_${item_counter.toString()}";
          MUTABLE head = rtoc_self_view.host.range_lower_head_with_context(selectOp__expression(select_op), item_var);
          stage_stmts = ruby_array_concat_Emittable(stage_stmts, CAST(head.pending() AS []Emittable));
          &stage_stmts.append(Emittable{ Let: COPY Let{ name: Name{ StringValue: COPY next_item }, init: COPY head.value(), mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
          item_var = COPY next_item;
          current_type = TRY (type__new(selectOp__expression(select_op).full_type_mut()));
          IF (!(track_owned) OR pipelinePlaceholderUsage__placeholder_projection?(selectOp__expression(select_op))) THEN
            current_owned = FALSE;
          ELSE
            MUTABLE owned_stmts = TRY (pipelineRangeLowerer__owned_stream_item_stmts(rtoc_self_view, next_item, current_type));
            stage_stmts = ruby_array_concat_Emittable(stage_stmts, owned_stmts);
            current_owned = !((owned_stmts.length() == 0));
            IF current_owned THEN
              MUTABLE stage_value: Emittable = head.value();
              MUTABLE fact_source = PARTIAL MATCH stage_value START
                Emittable.Call AS call -> call.callee,
                Emittable.MIRMethodCall AS mir_method_call -> mir_method_call.method,
                DEFAULT -> next_item
              END;
              &stage_stmts.append(Emittable{ OwnedCreate: COPY OwnedCreate{ name: COPY next_item, alloc: :heap, type_info: COPY current_type, source: COPY fact_source, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
            END
          END
      ELSE_IF stages[rtoc_idx]? IS_A WhereOp AS where_op THEN
          IF (item_var == initial_capture) THEN
            item_used = TRUE;
          END
          MUTABLE pred_mir = rtoc_self_view.host.range_visit_mir_with_context(whereOp__expression(where_op), item_var);
          MUTABLE skip_stmts = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_13: ?[]Any = NIL;
          IF on_skip != NIL THEN
            rtoc_ternary_value_13 = (on_skip.call(item_var) + [ContinueStmt{ unused: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }]);
          ELSE
            rtoc_ternary_value_13 = [ContinueStmt{ unused: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }];
          END
          rtoc_ternary_value_13? };
          &stage_stmts.append(Emittable{ IfStmt: COPY IfStmt{ cond: Emittable{ MIRUnaryOp: COPY MIRUnaryOp{ op: "!", operand: COPY pred_mir, lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: skip_stmts, else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL } });
      ELSE_IF stages[rtoc_idx]? IS_A TakeWhileOp AS take_while_op THEN
          IF (item_var == initial_capture) THEN
            item_used = TRUE;
          END
          MUTABLE pred_mir = rtoc_self_view.host.range_visit_mir_with_context(takeWhileOp__expression(take_while_op), item_var);
          MUTABLE skip_stmts = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_15: ?[]Any = NIL;
          IF on_skip != NIL THEN
            rtoc_ternary_value_15 = (on_skip.call(item_var) + [BreakStmt{ label: NIL, value: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }]);
          ELSE
            rtoc_ternary_value_15 = [BreakStmt{ label: NIL, value: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }];
          END
          rtoc_ternary_value_15? };
          &stage_stmts.append(Emittable{ IfStmt: COPY IfStmt{ cond: Emittable{ MIRUnaryOp: COPY MIRUnaryOp{ op: "!", operand: COPY pred_mir, lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: skip_stmts, else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL } });
      ELSE_IF stages[rtoc_idx]? IS_A LimitOp AS limit_op THEN
          item_counter = (item_counter + 1);
          MUTABLE cvar = "__limit_cnt_${item_counter.toString()}";
          MUTABLE cnt_var = "__limit_max_${item_counter.toString()}";
          MUTABLE cnt_mir = rtoc_self_view.host.range_visit_mir(limit_op.count);
          &outer_stmts.append(Emittable{ Let: COPY Let{ name: Name{ StringValue: COPY cvar }, init: Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: "i64", method: :as, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
          &outer_stmts.append(Emittable{ Let: COPY Let{ name: Name{ StringValue: COPY cnt_var }, init: COPY cnt_mir, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
          &stage_stmts.append(Emittable{ IfStmt: COPY IfStmt{ cond: Emittable{ MIRBinOp: COPY MIRBinOp{ op: ">=", left: Emittable{ Ident: COPY Ident{ name: COPY cvar, lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Ident: COPY Ident{ name: COPY cnt_var, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: [BreakStmt{ label: NIL, value: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL } });
          &stage_stmts.append(Emittable{ Set: COPY Set{ target: Emittable{ Ident: COPY Ident{ name: COPY cvar, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ MIRBinOp: COPY MIRBinOp{ op: "+", left: Emittable{ Ident: COPY Ident{ name: COPY cvar, lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Lit: COPY Lit{ value: "1", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
      ELSE_IF stages[rtoc_idx]? IS_A SkipOp AS skip_op THEN
          item_counter = (item_counter + 1);
          MUTABLE cvar = "__skip_cnt_${item_counter.toString()}";
          MUTABLE cnt_var = "__skip_max_${item_counter.toString()}";
          MUTABLE cnt_mir = rtoc_self_view.host.range_visit_mir(skip_op.count);
          &outer_stmts.append(Emittable{ Let: COPY Let{ name: Name{ StringValue: COPY cvar }, init: Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: "i64", method: :as, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
          &outer_stmts.append(Emittable{ Let: COPY Let{ name: Name{ StringValue: COPY cnt_var }, init: COPY cnt_mir, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
          &stage_stmts.append(Emittable{ IfStmt: COPY IfStmt{ cond: Emittable{ MIRBinOp: COPY MIRBinOp{ op: "<", left: Emittable{ Ident: COPY Ident{ name: COPY cvar, lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Ident: COPY Ident{ name: COPY cnt_var, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: CAST(Tuple{Set{ target: Emittable{ Ident: COPY Ident{ name: COPY cvar, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ MIRBinOp: COPY MIRBinOp{ op: "+", left: Emittable{ Ident: COPY Ident{ name: COPY cvar, lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Lit: COPY Lit{ value: "1", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }, ContinueStmt{ unused: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }} AS Tuple<Set, ContinueStmt>), else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL } });
      ELSE_IF stages[rtoc_idx]? IS_A TapOp AS tap_op THEN
          IF (item_var == initial_capture) THEN
            item_used = TRUE;
          END
          stage_stmts = ruby_array_concat_Emittable(stage_stmts, CAST(rtoc_self_view.host.range_visit_pipeline_body_mir(tap_op.body, item_var) AS []Emittable));
      END
      rtoc_idx = rtoc_idx + 1;
    END
    NIL
    };
    IF fiber_rt EXISTS AS fiber_rt_value THEN
      rtoc_self_view.host.range_with_fiber_rt(fiber_rt_value, %() USE(lower_stages) -> runtimeCallSpec__call(lower_stages));
    ELSE
      runtimeCallSpec__call(lower_stages);
    END
    MUTABLE is_var_stream = (IF source_node IS_A Identifier AS identifier THEN ((((TRY (type__dynamic_stream?(source_ti)) OR TRY (type__open_stream?(source_ti))) OR TRY (type__bounded_stream?(source_ti))) OR TRY (type__inf_stream?(source_ti)))) ELSE FALSE END);
    MUTABLE source_name: String = "";
    IF is_var_stream THEN
      MUTABLE resolved = rtoc_self_view.host.range_visit_mir(source_node);
      IF resolved IS_A Ident THEN
        source_name = COPY CAST(resolved.name() AS String);
      ELSE
        source_name = COPY CAST(source_node.name() AS String);
      END
    ELSE
      source_name = "__range_src";
    END
    MUTABLE range_let = IF !(is_var_stream) THEN
      {
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE source_mir =   IF source_alloc THEN
      rtoc_self_view.host.range_visit_mir_with_decl_alloc(source_node, symbol(UNWRAP (source_alloc)))
    ELSE
      rtoc_self_view.host.range_visit_mir(source_node)
    END;
    Let{ name: Name{ StringValue: COPY "__range_src" }, init: COPY source_mir, mutable: TRUE, annotation: NIL, suppression: "_ = &__range_src;", alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }
    }
    ELSE
      NIL
    END;
    MUTABLE range_mark_branch_value: ?AllocMark = NIL;
    IF (range_let AND (source_alloc != NIL)) THEN
      range_mark_branch_value = AllocMark{ name: "__range_src", alloc: symbol(UNWRAP (COPY source_alloc)), type_info: COPY source_ti, scope: :heap, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    ELSE
      range_mark_branch_value = NIL;
    END
    MUTABLE range_mark: AllocMark = range_mark_branch_value?;
    MUTABLE next_method: String = "";
    IF ((TRY (type__bounded_stream?(source_ti)) OR TRY (type__inf_stream?(source_ti)))) THEN
      next_method = "nextOrNull";
    ELSE
      next_method = "next";
    END
    RETURN PipelineLazyRangePrefix{ range_mark: COPY range_mark, range_let: COPY range_let, source_name: COPY source_name, outer_stmts: COPY outer_stmts, stage_stmts: COPY stage_stmts, item_var: COPY item_var, initial_capture: COPY initial_capture, item_used: item_used, elem_zig: COPY elem_zig, next_method: COPY next_method, item_type: COPY current_type, item_owned: current_owned };
}
END
PUB FN pipelineRangeLowerer__range_literal_element_type(self: PipelineRangeLowerer, source_node: Locatable) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE start_ft_branch_value: ?Type = NIL;
    IF source_node IS_A RangeLit THEN
      start_ft_branch_value = source_node.start().full_type_mut({:context: "lazy range start"});
    ELSE
      start_ft_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: :Int64 }));
    END
    MUTABLE start_ft: Type = start_ft_branch_value?;
    RETURN TRY (type__new(TypeConstructionInput{ Type: COPY start_ft }));
}
END
PUB FN pipelineRangeLowerer__lower_each_range(self: PipelineRangeLowerer, MUTABLE range_lit: Locatable, stages: []Locatable, each_op: EachOp) RETURNS !ScopeBlock
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE prefix = TRY (pipelineRangeLowerer__build_lazy_range_prefix(rtoc_self_view, &range_lit, stages, NIL, NIL, NIL, TRUE));
    MUTABLE item_var = COPY prefix.item_var;
    MUTABLE initial_capture = COPY prefix.initial_capture;
    MUTABLE item_used = prefix.item_used;
    MUTABLE body_mir = rtoc_self_view.host.range_visit_pipeline_body_mir(each_op.body, item_var);
    MUTABLE body_uses_initial = (((item_var == initial_capture)) AND rtoc_self_view.host.range_ast_stmts_use_placeholder?(each_op.body));
    item_used = (item_used OR body_uses_initial);
    MUTABLE capture_name: String = "";
    IF item_used THEN
      capture_name = initial_capture;
    ELSE
      capture_name = "_";
    END
    MUTABLE source_ti = &range_lit.full_type_mut();
    MUTABLE defer_deinit_branch_value: ?MIRDeferStmt = NIL;
    IF TRY (type__bounded_stream?(source_ti)) THEN
      defer_deinit_branch_value = TRY (pipelineLazyRangePrefix__deinit_stmt(prefix));
    ELSE
      defer_deinit_branch_value = NIL;
    END
    MUTABLE defer_deinit: ?MIRDeferStmt = defer_deinit_branch_value;
    MUTABLE bc_iter: ?PipelineRangeLoopIter = pipelineRangeLowerer__bc_loop_iter(rtoc_self_view, range_lit, source_ti, IF (capture_name == "_") THEN
      "_"
    ELSE
      initial_capture
    END);
    IF bc_iter EXISTS AS bc_iter_value THEN
      RETURN ScopeBlock{ body: COPY (TRY (pipelineLazyRangePrefix__outer_setup_stmts(prefix)) + [TRY (pipelineLazyRangePrefix__loop_stmt(prefix, bc_iter_value.iter, body_mir, bc_iter_value.capture_name))]), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    END
    RETURN ScopeBlock{ body: COPY (TRY (pipelineLazyRangePrefix__setup_stmts(prefix)) + (([defer_deinit])) + [TRY (pipelineLazyRangePrefix__loop_stmt(prefix, NIL, body_mir, capture_name))]), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
}
END
PUB FN pipelineRangeLowerer__bc_for_iter_range(self: PipelineRangeLowerer, range_lit: RangeLit, capture_name: ?String) RETURNS Tuple<IterRange, ?String>
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE start_mir = rtoc_self_view.host.range_visit_mir(range_lit.start);
    MUTABLE end_mir = rtoc_self_view.host.range_visit_mir(range_lit.finish);
    MUTABLE end_expr_branch_value: ?MIRBinOp = NIL;
    IF range_lit.inclusive THEN
      end_expr_branch_value = MIRBinOp{ op: "+", left: COPY end_mir, right: Emittable{ Lit: COPY Lit{ value: "1", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL };
    ELSE
      end_expr_branch_value = end_mir;
    END
    MUTABLE end_expr: MIRBinOp = end_expr_branch_value?;
    RETURN CAST(Tuple{IterRange{ start: start_mir, end_val: end_expr, capture_type: :i64, lowered_node_id: NIL, ownership_consumption: NIL }, capture_name} AS Tuple<IterRange, ?String>);
}
END
PUB FN pipelineRangeLowerer__numeric_fold_expr_typed(self: PipelineRangeLowerer, MUTABLE expr_ast: Locatable, item_var: String, acc_zig: String) RETURNS !Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE expr_mir = rtoc_self_view.host.range_visit_mir_with_context(expr_ast, item_var);
    MUTABLE expr_type = &expr_ast.full_type_mut();
    MUTABLE expr_is_int = type__integer?((TRY (type__new(expr_type))));
    MUTABLE acc_is_float = ((acc_zig == "f64") OR (acc_zig == "f32"));
    IF (expr_is_int AND acc_is_float) THEN
      RETURN Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ MIRCast: COPY MIRCast{ expr: COPY expr_mir, target_type: NIL, method: :floatFromInt, lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: COPY acc_zig, method: :as, lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE
      RETURN expr_mir;
    END
}
END
PUB FN pipelineRangeLowerer__lower_range_fold(self: PipelineRangeLowerer, MUTABLE range_lit: Locatable, stages: []Locatable, fold_op: PipelineDefaultObservableFoldOp, MUTABLE smooth_node: BinaryOp) RETURNS !MIRBlockExpr
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE label = NIL;
    IF smooth_node.observable_dest THEN
      MUTABLE terminal: ?String@symbol = COPY (TRY (type__observable_terminals())).each_with_object({}, %(tuple_param_0, h) -> {
    MUTABLE sym = tuple_param_0._0;
    MUTABLE entry = tuple_param_0._1;
    MUTABLE tag = entry.ast_class();
    IF !((tag == NIL)) THEN
          MUTABLE klass: ?Any@multiowned = (CAST({:sum: AST.SumOp, :count: AST.CountOp, :avg: AST.AverageOp, :max: AST.MaxOp, :min: AST.MinOp, :any: AST.AnyOp, :all: AST.AllOp, :find: AST.FindOp} AS {String@symbol}Any@multiowned))[tag];
          IF !((klass == NIL)) THEN
            h[klass] = sym;
          END
    END
    NIL
      })[fold_op.class()];
      IF terminal EXISTS AS terminal_value THEN
        MUTABLE terminal_value_mutable = COPY terminal_value;
        MUTABLE fid = rtoc_self_view.host.range_next_observable_id();
        MUTABLE prefix = TRY (pipelineRangeLowerer__build_lazy_range_prefix(rtoc_self_view, &range_lit, stages, NIL, :heap, "__rt_obs_${fid}", TRUE));
        label = rtoc_self_view.host.range_next_label();
        RETURN TRY (pipelineRangeLowerer__lower_range_fold_observable_default(rtoc_self_view, prefix, fold_op, &smooth_node, label, range_lit, terminal_value_mutable, fid));
      ELSE
        RAISE Input, CompilerError, "lower_range_fold: observable_dest set but no terminal registered for {}";
      END
    END
    MUTABLE prefix = TRY (pipelineRangeLowerer__build_lazy_range_prefix(rtoc_self_view, &range_lit, stages, NIL, NIL, NIL, TRUE));
    label = rtoc_self_view.host.range_next_label();
    MUTABLE names = pipelineRangeFoldNames__for_label(label, rtoc_self_view.host.range_bc_target?());
    MUTABLE plan = TRY (pipelineRangeLowerer__scalar_fold_plan(rtoc_self_view, prefix, fold_op, smooth_node, names));
    RETURN pipelineRangeLowerer__range_accumulating_block(rtoc_self_view, &range_lit, prefix, label, plan, prefix.initial_capture);
}
END
PUB FN pipelineRangeLowerer__lower_range_reduce(self: PipelineRangeLowerer, MUTABLE range_lit: Locatable, stages: []Locatable, MUTABLE reduce_op: ReduceOp, MUTABLE smooth_node: ?BinaryOp = NIL) RETURNS !MIRBlockExpr
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE label = NIL;
    MUTABLE prefix = TRY (pipelineRangeLowerer__build_lazy_range_prefix(rtoc_self_view, &range_lit, stages, NIL, IF smooth_node?.observable_dest THEN
      :heap
    ELSE
      NIL
    END, NIL, TRUE));
    MUTABLE item_var = COPY prefix.item_var;
    IF smooth_node?.observable_dest THEN
      label = rtoc_self_view.host.range_next_label();
      RETURN TRY (pipelineRangeLowerer__lower_range_reduce_observable(rtoc_self_view, prefix, reduce_op, UNWRAP (smooth_node), label, range_lit));
    END
    label = rtoc_self_view.host.range_next_label();
    MUTABLE acc_zig = rtoc_self_view.host.range_transpile_type(PipelineRangeTypeInput{ StringValue: COPY type__to_s((&reduce_op.full_type_mut())) });
    MUTABLE init_mir = rtoc_self_view.host.range_visit_mir(reduce_op.initial_value);
    MUTABLE expr_mir = rtoc_self_view.host.range_visit_mir_with_context(reduce_op.expression, item_var, "acc");
    MUTABLE plan = PipelineRangeFoldPlan{ acc_init_stmts: [Emittable{ Let: COPY Let{ name: Name{ StringValue: COPY "acc" }, init: COPY init_mir, mutable: TRUE, annotation: COPY TRY (type__new(acc_zig)), suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }], loop_acc_stmts: [Emittable{ Set: COPY Set{ target: Emittable{ Ident: COPY Ident{ name: "acc", lowered_node_id: NIL, ownership_consumption: NIL } }, value: COPY expr_mir, needs_field_cleanup: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], post_loop_stmts: ( { MUTABLE rtoc_empty_list_16: []Emittable = List[]; rtoc_empty_list_16 } ), result_expr: Emittable{ Ident: COPY Ident{ name: "acc", lowered_node_id: NIL, ownership_consumption: NIL } } };
    RETURN pipelineRangeLowerer__range_accumulating_block(rtoc_self_view, &range_lit, prefix, label, plan, prefix.initial_capture);
}
END
PUB FN pipelineRangeLowerer__scalar_fold_plan(self: PipelineRangeLowerer, prefix: PipelineLazyRangePrefix, fold_op: PipelineDefaultObservableFoldOp, MUTABLE smooth_node: BinaryOp, names: PipelineRangeFoldNames) RETURNS !PipelineRangeFoldPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF fold_op IS_A CountOp@multiowned AS count_op_multiowned THEN
      RETURN TRY (pipelineRangeLowerer__count_fold_plan(rtoc_self_view, prefix, CAST(COPY count_op_multiowned AS CountOp), names));
    ELSE_IF fold_op IS_A SumOp@multiowned AS sum_op_multiowned THEN
      MUTABLE sum_op_multiowned_mutable = COPY sum_op_multiowned;
      RETURN TRY (pipelineRangeLowerer__sum_fold_plan(rtoc_self_view, prefix, CAST(COPY sum_op_multiowned_mutable AS SumOp), &smooth_node, names));
    ELSE_IF fold_op IS_A AverageOp@multiowned AS average_op_multiowned THEN
      RETURN TRY (pipelineRangeLowerer__average_fold_plan(rtoc_self_view, prefix, CAST(COPY average_op_multiowned AS AverageOp), names));
    ELSE_IF fold_op IS_A MinOp@multiowned AS min_op_multiowned THEN
      RETURN TRY (pipelineRangeLowerer__min_fold_plan(rtoc_self_view, prefix, CAST(COPY min_op_multiowned AS MinOp), smooth_node, names));
    ELSE_IF fold_op IS_A MaxOp@multiowned AS max_op_multiowned THEN
      RETURN TRY (pipelineRangeLowerer__max_fold_plan(rtoc_self_view, prefix, CAST(COPY max_op_multiowned AS MaxOp), smooth_node, names));
    ELSE_IF fold_op IS_A AnyOp@multiowned AS any_op_multiowned THEN
      RETURN pipelineRangeLowerer__any_fold_plan(rtoc_self_view, prefix, CAST(COPY any_op_multiowned AS AnyOp), names);
    ELSE_IF fold_op IS_A AllOp@multiowned AS all_op_multiowned THEN
      RETURN pipelineRangeLowerer__all_fold_plan(rtoc_self_view, prefix, CAST(COPY all_op_multiowned AS AllOp), names);
    ELSE_IF fold_op IS_A FindOp@multiowned AS find_op_multiowned THEN
      MUTABLE find_op_multiowned_mutable = COPY find_op_multiowned;
      RETURN TRY (pipelineRangeLowerer__find_fold_plan(rtoc_self_view, prefix, CAST(COPY find_op_multiowned_mutable AS FindOp), &smooth_node, names));
    ELSE
      RETURN NIL;
    END
}
END
PUB FN pipelineRangeLowerer__count_fold_plan(self: PipelineRangeLowerer, prefix: PipelineLazyRangePrefix, fold_op: CountOp, names: PipelineRangeFoldNames) RETURNS !PipelineRangeFoldPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE pred_mir = rtoc_self_view.host.range_visit_mir_with_context(fold_op.expression, prefix.item_var);
    RETURN PipelineRangeFoldPlan{ acc_init_stmts: [Emittable{ Let: COPY Let{ name: Name{ StringValue: COPY names.acc }, init: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: COPY TRY (type__new(TypeConstructionInput{ StringValue: COPY "i64" })), suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }], loop_acc_stmts: [Emittable{ IfStmt: COPY IfStmt{ cond: COPY pred_mir, then_body: [Set{ target: Emittable{ Ident: COPY Ident{ name: COPY names.acc, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ MIRBinOp: COPY MIRBinOp{ op: "+", left: Emittable{ Ident: COPY Ident{ name: COPY names.acc, lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Lit: COPY Lit{ value: "1", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL } }], post_loop_stmts: ( { MUTABLE rtoc_empty_list_17: []Emittable = List[]; rtoc_empty_list_17 } ), result_expr: Emittable{ Ident: COPY Ident{ name: COPY names.acc, lowered_node_id: NIL, ownership_consumption: NIL } } };
}
END
PUB FN pipelineRangeLowerer__sum_fold_plan(self: PipelineRangeLowerer, prefix: PipelineLazyRangePrefix, fold_op: SumOp, MUTABLE smooth_node: BinaryOp, names: PipelineRangeFoldNames) RETURNS !PipelineRangeFoldPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
