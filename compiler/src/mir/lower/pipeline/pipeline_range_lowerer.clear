PUB FN pipelineRangeLowerer__find_fold_plan(self: PipelineRangeLowerer, prefix: PipelineLazyRangePrefix, fold_op: FindOp, smooth_node: BinaryOp, names: PipelineRangeFoldNames) RETURNS !PipelineRangeFoldPlan ->
    MUTABLE result_ft = TRY (type__new(TypeConstructionInput{ Type: COPY TRY (aST__full_type_mut(Locatable{ BinaryOp: COPY smooth_node })) }));
    MUTABLE find_zig: String = "";
    IF type__optional?(result_ft) THEN
      find_zig = runtimeHost__range_transpile_type(self.host, PipelineTypeInput{ StringValue: COPY CAST((type__resolved(UNWRAP (TRY (type__wrapped_type(result_ft))))) AS String) });
    ELSE
      find_zig = COPY prefix.elem_zig;
    END
    MUTABLE pred_mir = runtimeHost__range_visit_mir_with_context(self.host, UNWRAP (fold_op.expression), prefix.item_var);
    MUTABLE owned_marks: []Emittable = CAST(List[] AS []Emittable);
    IF prefix.item_owned THEN
      owned_marks = TRY (ownershipTransferPlan__marks((OwnershipTransferPlan{ name: COPY prefix.item_var, target: :owned_sink, target_alloc: :heap, move_guarded: TRUE })));
    END
    RETURN PipelineRangeFoldPlan{ acc_init_stmts: [Emittable{ Let: COPY Let{ name: COPY names.result, init: Emittable{ Undef: COPY Undef{ zig_type: NIL, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: COPY TRY (type__new(TypeConstructionInput{ StringValue: COPY find_zig })), suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }, Emittable{ Let: COPY Let{ name: COPY names.found, init: Emittable{ Lit: COPY Lit{ value: "false", lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }], loop_acc_stmts: [Emittable{ IfStmt: COPY IfStmt{ cond: COPY pred_mir, then_body: (owned_marks + [Emittable{ Set: COPY Set{ target: Emittable{ Ident: COPY Ident{ name: COPY names.result, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Ident: COPY Ident{ name: COPY prefix.item_var, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ Set: COPY Set{ target: Emittable{ Ident: COPY Ident{ name: COPY names.found, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Lit: COPY Lit{ value: "true", lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ BreakStmt: COPY BreakStmt{ label: NIL, value: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }]), else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL } }], post_loop_stmts: List[], result_expr: Emittable{ Conditional: COPY Conditional{ cond: Emittable{ Ident: COPY Ident{ name: COPY names.found, lowered_node_id: NIL, ownership_consumption: NIL } }, then_val: Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ Ident: COPY Ident{ name: COPY names.result, lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: "?${find_zig}", method: :as, lowered_node_id: NIL, ownership_consumption: NIL } }, else_val: Emittable{ Lit: COPY Lit{ value: "null", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } } };
END
PUB FN pipelineRangeLowerer__range_accumulating_block(self: PipelineRangeLowerer, range_lit: Locatable, prefix: PipelineLazyRangePrefix, label: String, plan: PipelineRangeFoldPlan, capture_name: String) RETURNS !MIRBlockExpr ->
    MUTABLE source_ti = TRY (aST__full_type_mut(range_lit));
    MUTABLE defer_deinit_branch_value: ?MIRDeferStmt = NIL;
    IF TRY (type__bounded_stream?(source_ti)) THEN
      defer_deinit_branch_value = TRY (pipelineLazyRangePrefix__deinit_stmt(prefix));
    ELSE
      defer_deinit_branch_value = NIL;
    END
    MUTABLE defer_deinit: ?MIRDeferStmt = defer_deinit_branch_value;
    MUTABLE bc_iter: ?PipelineRangeLoopIter = TRY (pipelineRangeLowerer__bc_loop_iter(self, range_lit, source_ti, capture_name));
    IF bc_iter EXISTS AS bc_iter_value THEN
      RETURN MIRBlockExpr{ label: COPY label, body: COPY (TRY (pipelineLazyRangePrefix__outer_setup_stmts(prefix)) + plan.acc_init_stmts + [castPipelineLazyRangePrefixReturnValueToEmittable__pipeline_range_lowerer(TRY (pipelineLazyRangePrefix__loop_stmt(prefix, bc_iter_value.iter, plan.loop_acc_stmts, bc_iter_value.capture_name)))] + plan.post_loop_stmts + [Emittable{ BreakStmt: COPY BreakStmt{ label: COPY label, value: COPY plan.result_expr, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }]), lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
    END
    RETURN MIRBlockExpr{ label: COPY label, body: COPY (TRY (pipelineLazyRangePrefix__setup_stmts(prefix)) + plan.acc_init_stmts + (([defer_deinit])) + [castPipelineLazyRangePrefixReturnValueToEmittable__pipeline_range_lowerer(TRY (pipelineLazyRangePrefix__loop_stmt(prefix, NIL, plan.loop_acc_stmts, capture_name)))] + plan.post_loop_stmts + [Emittable{ BreakStmt: COPY BreakStmt{ label: COPY label, value: COPY plan.result_expr, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }]), lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
END
PUB FN pipelineRangeLowerer__lower_range_fold_observable(self: PipelineRangeLowerer, p: PipelineLazyRangePrefix, smooth_node: BinaryOp, label: String, source_node: Locatable, acc_alloc_expr: Emittable, publish_stmts: []Emittable, observable_id: ?Int64 = NIL) RETURNS !MIRBlockExpr ->
    MUTABLE source_name = COPY p.source_name;
    MUTABLE obs_type: ?Type = TRY (type__from_node_mut(Locatable{ BinaryOp: COPY smooth_node }, "observable accumulator"));
    MUTABLE rt_name = runtimeHost__range_runtime_name(self.host);
    MUTABLE wg_init = HeapCreate{ zig_type: "CheatHeader.WaitGroup", init: Emittable{ Call: COPY Call{ callee: "CheatHeader.WaitGroup.init", args: [Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: COPY rt_name, lowered_node_id: NIL, ownership_consumption: NIL } }, method: "getSched", args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }], try_wrap: FALSE, owned_return: FALSE, callable_contract: TRY (callableContract__no_ownership(1)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL } }, alloc: :heap, label: "__obs_wg_alloc", lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE obs_wg_anyopaque = MIRCast{ expr: Emittable{ Call: COPY Call{ callee: "@ptrCast", args: [Emittable{ Ident: COPY Ident{ name: "__obs_wg", lowered_node_id: NIL, ownership_consumption: NIL } }], try_wrap: FALSE, owned_return: FALSE, callable_contract: TRY (callableContract__no_ownership(1)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL } }, target_type: "*anyopaque", method: :as, lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE set_completion_contract = callableContract__new(TRY (functionSignature__new([Param{ name: "ctx", type: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })), default: NIL, mutable: NIL, takes: NIL, comptime: NIL, name_token: NIL, required: NIL, sync: NIL, symbol: NIL, carrier_contract: NIL }, Param{ name: "done", type: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })), default: NIL, mutable: NIL, takes: NIL, comptime: NIL, name_token: NIL, required: NIL, sync: NIL, symbol: NIL, carrier_contract: NIL }, Param{ name: "wait", type: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })), default: NIL, mutable: NIL, takes: NIL, comptime: NIL, name_token: NIL, required: NIL, sync: NIL, symbol: NIL, carrier_contract: NIL }, Param{ name: "destroy", type: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })), default: NIL, mutable: NIL, takes: NIL, comptime: NIL, name_token: NIL, required: NIL, sync: NIL, symbol: NIL, carrier_contract: NIL }], TypeTypeInput{ Type: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :Void })) }, NIL, NIL, List[], {}, FALSE, FALSE, NIL, NIL, NIL, List[], NIL, List[])), TRY (ownershipContract__consume_operands([ownershipOperandFact__owned_binding("__obs_wg", TRY (type__new(TypeConstructionInput{ SymbolValue: symbol("CheatHeader.WaitGroup") }, NIL, NIL, :indirect)), "observable completion", :heap)])), 4);
    MUTABLE set_completion = MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: "__obs_acc", lowered_node_id: NIL, ownership_consumption: NIL } }, method: "setCompletion", args: [Emittable{ MIRCast: COPY obs_wg_anyopaque }, Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "CheatHeader", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "obsWgDone", lowered_node_id: NIL, ownership_consumption: NIL } }, Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "CheatHeader", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "obsWgWait", lowered_node_id: NIL, ownership_consumption: NIL } }, Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "CheatHeader", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "obsWgDestroy", lowered_node_id: NIL, ownership_consumption: NIL } }], try_wrap: FALSE, callable_contract: COPY set_completion_contract, owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    MUTABLE acc_init_stmts = (TRY (pipelineLazyRangePrefix__setup_stmts(p)) + [Emittable{ AllocMark: COPY AllocMark{ name: "__obs_acc", alloc: :heap, type_info: UNWRAP (COPY obs_type), scope: :heap, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ Let: COPY Let{ name: COPY "__obs_acc", init: COPY acc_alloc_expr, mutable: FALSE, annotation: COPY obs_type, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }, Emittable{ AllocMark: COPY AllocMark{ name: "__obs_wg", alloc: :heap, type_info: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: symbol("CheatHeader.WaitGroup") }, NIL, NIL, :indirect)), scope: :heap, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ Let: COPY Let{ name: COPY "__obs_wg", init: Emittable{ HeapCreate: COPY wg_init }, mutable: FALSE, annotation: COPY TRY (type__new(TypeConstructionInput{ StringValue: COPY "*CheatHeader.WaitGroup" })), suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }, Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: "__obs_wg", lowered_node_id: NIL, ownership_consumption: NIL } }, method: "add", args: [Emittable{ Lit: COPY Lit{ value: "1", lowered_node_id: NIL, ownership_consumption: NIL } }], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(1)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ MIRMethodCall: COPY set_completion }, discard: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }]);
    MUTABLE body_mir = [castPipelineLazyRangePrefixReturnValueToEmittable__pipeline_range_lowerer(TRY (pipelineLazyRangePrefix__loop_stmt(p, NIL, publish_stmts)))];
    MUTABLE fid = (observable_id OR_ELSE runtimeHost__range_next_observable_id(self.host));
    MUTABLE spawn = ObservableConsumerSpawn{ id: fid, acc_name: "__obs_acc", source_name: COPY source_name, acc_type: UNWRAP (COPY obs_type), runtime_name: COPY rt_name, task_config_variant: COPY runtimeHost__range_task_config_variant(self.host), stdlib_def: pipeline_alloc_ref_def, ownership_contract: TRY (ownershipContract__consume_operands([ownershipOperandFact__owned_binding(source_name, TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })), "observable consumer spawn", :heap)])), body: COPY body_mir };
    RETURN MIRBlockExpr{ label: COPY label, body: COPY (acc_init_stmts + [Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ ObservableConsumerSpawn: COPY spawn }, discard: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ BreakStmt: COPY BreakStmt{ label: COPY label, value: Emittable{ Ident: COPY Ident{ name: "__obs_acc", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }]), lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
END
PUB FN pipelineRangeLowerer__lower_range_fold_observable_default(self: PipelineRangeLowerer, p: PipelineLazyRangePrefix, fold_op: PipelineDefaultObservableFoldOp, MUTABLE smooth_node: BinaryOp, label: String, source_node: Locatable, terminal: String@symbol, observable_id: ?Int64 = NIL) RETURNS !MIRBlockExpr ->
    MUTABLE terminal_spec: ?ObservableTerminalSpec = (TRY (type__observable_terminals()))[terminal];
    MUTABLE spec = pipelinePublishSpec__from(UNWRAP (UNWRAP (terminal_spec).publish));
    MUTABLE item = COPY p.item_var;
    MUTABLE inner_recv = FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__obs_acc", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "inner", lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE fid = (observable_id OR_ELSE runtimeHost__range_next_observable_id(self.host));
    MUTABLE arg = runtimeHost__range_with_fiber_rt(self.host, "__rt_obs_${fid.toString()}", %() USE(fold_op, item, MUTABLE smooth_node, spec, self) -> {
    MUTABLE publish_args: []Emittable = CAST(List[] AS []Emittable);
    IF (spec.expr == :typed) THEN
        MUTABLE inner_zig = runtimeHost__range_transpile_type(self.host, PipelineTypeInput{ TypeMultiowned: COPY TRY (type__tense_type((TRY (aST__full_type_mut(Locatable{ BinaryOp: COPY smooth_node }))))) });
        publish_args = [TRY (pipelineRangeLowerer__numeric_fold_expr_typed(self, UNWRAP (pipelineDefaultObservableFoldOp__expression(fold_op)), item, inner_zig))];
    ELSE_IF (spec.expr == :f64) THEN
        publish_args = [TRY (pipelineRangeLowerer__numeric_fold_expr_typed(self, UNWRAP (pipelineDefaultObservableFoldOp__expression(fold_op)), item, "f64"))];
    ELSE_IF (spec.expr == :pred) THEN
        publish_args = [runtimeHost__range_visit_mir_with_context(self.host, UNWRAP (pipelineDefaultObservableFoldOp__expression(fold_op)), item)];
    ELSE_IF (spec.expr == :item) THEN
        publish_args = [Emittable{ Ident: COPY Ident{ name: COPY item, lowered_node_id: NIL, ownership_consumption: NIL } }];
    ELSE_IF (spec.expr == :none) THEN
        publish_args = CAST(List[] AS []Emittable);
    ELSE
        panic("unsupported observable publish expr {}");
    END
    publish_args
    });
    MUTABLE published_item_type_branch_value: ?Type = NIL;
    IF p.item_owned THEN
      published_item_type_branch_value = COPY p.item_type;
    ELSE
      published_item_type_branch_value = NIL;
    END
    MUTABLE published_item_type: ?Type = published_item_type_branch_value;
    MUTABLE callable_contract_branch_value: ?CallableContract = NIL;
    IF (spec.transfers_item_on_success AND (published_item_type != NIL)) THEN
      callable_contract_branch_value = callableContract__new(TRY (functionSignature__new([Param{ name: "item", type: COPY published_item_type, takes: TRUE, default: NIL, mutable: NIL, comptime: NIL, name_token: NIL, required: NIL, sync: NIL, symbol: NIL, carrier_contract: NIL }], TypeTypeInput{ Type: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :Void })) }, NIL, NIL, List[], {}, FALSE, FALSE, NIL, NIL, NIL, List[], NIL, List[])), TRY (ownershipContract__consume_operands([ownershipOperandFact__owned_binding(item, published_item_type, "observable publish item", :heap)])), 1);
    ELSE
      callable_contract_branch_value = TRY (callableContract__no_ownership(arg.length()));
    END
    MUTABLE callable_contract: CallableContract = callable_contract_branch_value?;
    MUTABLE call = ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ FieldGet: inner_recv }, method: COPY spec.publish_method, args: COPY arg, try_wrap: FALSE, callable_contract: COPY callable_contract, owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    MUTABLE publish = PARTIAL MATCH spec.gate START
      :always -> [Emittable{ ExprStmt: COPY call }],
      :pred -> {
        MUTABLE rtoc_value_block_marker = 0;
        MUTABLE pred_mir = runtimeHost__range_with_fiber_rt(self.host, "__rt_obs_${fid.toString()}", %() USE(fold_op, item, self) -> runtimeHost__range_visit_mir_with_context(self.host, UNWRAP (pipelineDefaultObservableFoldOp__expression(fold_op)), item));
        (IF (spec.transfers_item_on_success AND (published_item_type != NIL)) THEN
          [Emittable{ IfStmt: COPY IfStmt{ cond: COPY pred_mir, then_body: (TRY (ownershipTransferPlan__marks((OwnershipTransferPlan{ name: COPY item, target: :call, target_alloc: :heap, move_guarded: TRUE }))) + [Emittable{ ExprStmt: COPY call }]), else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL } }]
        ELSE
          [Emittable{ IfStmt: COPY IfStmt{ cond: COPY pred_mir, then_body: [Emittable{ ExprStmt: COPY call }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL } }]
        END)
      },
      DEFAULT -> panic("unsupported observable publish gate {}")
    END;
    RETURN TRY (pipelineRangeLowerer__lower_range_fold_observable(self, p, smooth_node, label, source_node, Emittable{ TryCatch: COPY TRY (pipelineRangeLowerer__default_obs_alloc_expr(self, smooth_node)) }, publish, fid));
END
PUB FN pipelineRangeLowerer__pipeline_element_owns_heap?(self: PipelineRangeLowerer, type_info: Type) RETURNS !Bool ->
    RETURN (((TRY (type__string?(type_info)) OR TRY (type__heap_ptr?(type_info))) OR TRY (type__recursive_cleanup_shape?(type_info, runtimeHost__range_schema_lookup(self.host)))) OR TRY (type__needs_explicit_cleanup?(type_info, :heap, runtimeHost__range_schema_lookup(self.host))));
END
PUB FN pipelineRangeLowerer__bc_loop_iter(self: PipelineRangeLowerer, range_lit: Locatable, source_ti: Type, capture_name: ?String) RETURNS !?PipelineRangeLoopIter ->
    IF !(runtimeHost__range_bc_target?(self.host)) THEN
      RETURN NIL;
    END
    IF range_lit IS_A RangeLit AS range_lit_narrowed THEN
      MUTABLE iter, cap = pipelineRangeLowerer__bc_for_iter_range(self, range_lit_narrowed, capture_name);
      RETURN PipelineRangeLoopIter{ iter: Emittable{ IterRange: COPY iter }, capture_name: COPY cap };
    END
    IF range_lit IS_A Identifier AS identifier THEN
    IF TRY (type__runtime_stream?(source_ti)) THEN
        RETURN PipelineRangeLoopIter{ iter: COPY runtimeHost__range_visit_mir(self.host, Locatable{ Identifier: COPY identifier }), capture_name: COPY capture_name };
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
END
PUB FN pipelineRangeLowerer__owned_stream_item_stmts(self: PipelineRangeLowerer, item_var: String, elem_t: ?Type) RETURNS ![]Emittable ->
    IF elem_t EXISTS AS elem_t_value THEN
      MUTABLE elem_t_value_mutable = COPY elem_t_value;
      IF TRY (pipelineRangeLowerer__pipeline_element_owns_heap?(self, elem_t_value_mutable)) THEN
        MUTABLE entry: ?CleanupEntry@multiowned = TRY (cleanupClassifier__owned_value_entry(elem_t_value_mutable, runtimeHost__range_schema_lookup(self.host)));
        IF !((IF entry != NIL THEN
          cleanupEntry__needs_cleanup?(entry)
        ELSE
          NIL
        END)) THEN
          RETURN CAST(List[] AS []Emittable);
        END
        entry = cleanupEntry__with_alloc( UNWRAP (entry), :heap);
        cleanupEntry__mark_moved_guard_mut( UNWRAP (entry));
        RETURN CAST([Emittable{ AllocMark: COPY AllocMark{ name: COPY item_var, alloc: :heap, type_info: COPY elem_t_value_mutable, scope: :heap, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ Cleanup: COPY Cleanup{ name: COPY item_var, cleanup_entry: UNWRAP (entry), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable);
      ELSE
        RETURN CAST(List[] AS []Emittable);
      END
    ELSE
      RETURN CAST(List[] AS []Emittable);
    END
END
PUB FN pipelineRangeLowerer__lower_range_reduce_observable(self: PipelineRangeLowerer, p: PipelineLazyRangePrefix, reduce_op: ReduceOp, smooth_node: BinaryOp, label: String, source_node: Locatable) RETURNS !MIRBlockExpr ->
    MUTABLE inner_zig = runtimeHost__range_transpile_type(self.host, PipelineTypeInput{ TypeMultiowned: COPY TRY (type__tense_type((TRY (aST__full_type_mut(Locatable{ BinaryOp: COPY smooth_node }))))) });
    MUTABLE init_mir = runtimeHost__range_visit_mir(self.host, UNWRAP (reduce_op.initial_value));
    MUTABLE fid = runtimeHost__range_next_observable_id(self.host);
    MUTABLE curr_var = "__obs_reduce_curr_${fid.toString()}";
    MUTABLE next_var = "__obs_reduce_next_${fid.toString()}";
    MUTABLE actual_var = "__obs_reduce_actual_${fid.toString()}";
    MUTABLE blk_label = "__obs_reduce_blk_${fid.toString()}";
    MUTABLE item_var = COPY p.item_var;
    MUTABLE body_mir = runtimeHost__range_visit_mir_with_context(self.host, UNWRAP (reduce_op.expression), item_var, curr_var);
    MUTABLE inner_recv = FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__obs_acc", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "inner", lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE publish = [Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ MIRBlockExpr: COPY MIRBlockExpr{ label: COPY blk_label, body: COPY [Emittable{ Let: COPY Let{ name: COPY curr_var, init: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ FieldGet: COPY inner_recv }, method: "view", args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, mutable: TRUE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }, Emittable{ WhileStmt: COPY WhileStmt{ cond: Emittable{ Lit: COPY Lit{ value: "true", lowered_node_id: NIL, ownership_consumption: NIL } }, body: COPY [Emittable{ Let: COPY Let{ name: COPY next_var, init: COPY body_mir, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }, Emittable{ IfBindStmt: COPY IfBindStmt{ bindings: [MIRIfBinding{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ FieldGet: COPY inner_recv }, method: "tryCommit", args: [Emittable{ Ident: COPY Ident{ name: COPY curr_var, lowered_node_id: NIL, ownership_consumption: NIL } }, Emittable{ Ident: COPY Ident{ name: COPY next_var, lowered_node_id: NIL, ownership_consumption: NIL } }], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(2)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, capture: MirCapture{ StringValue: COPY actual_var }, node_ref: NIL, owns_capture: NIL, predicate: NIL, pointer_capture: NIL }], then_body: [Emittable{ Set: COPY Set{ target: Emittable{ Ident: COPY Ident{ name: COPY curr_var, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ Ident: COPY Ident{ name: COPY actual_var, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], else_body: [Emittable{ BreakStmt: COPY BreakStmt{ label: NIL, value: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], capture: NIL, update: NIL, mark_per_iter: NIL, tight: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ ExprStmt: COPY ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ FieldGet: COPY inner_recv }, method: "markSeen", args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ BreakStmt: COPY BreakStmt{ label: COPY blk_label, value: Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: "i32", method: :as, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL } }, discard: TRUE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }];
    MUTABLE obs_target = pipelineRangeLowerer__without_pointer_prefix(self, runtimeHost__range_transpile_type(self.host, PipelineTypeInput{ TypeMultiowned: COPY TRY (aST__full_type_mut(Locatable{ BinaryOp: COPY smooth_node })) }));
    MUTABLE acc_alloc = TRY (pipelineRangeLowerer__observable_alloc_expr(self, obs_target, "newWith", [Emittable{ AllocatorRef: COPY AllocatorRef{ kind: :heap, lowered_node_id: NIL, ownership_consumption: NIL } }, Emittable{ RuntimeCall: COPY RuntimeCall{ spec: COPY TRY (runtimeCalls__atomic_reduce_init_spec(inner_zig)), args: [init_mir], lowered_node_id: NIL, ownership_consumption: NIL } }]));
    RETURN TRY (pipelineRangeLowerer__lower_range_fold_observable(self, p, smooth_node, label, source_node, Emittable{ TryCatch: COPY acc_alloc }, publish, fid));
END
PUB FN pipelineRangeLowerer__lower_range_fold_observable_distinct(self: PipelineRangeLowerer, p: PipelineLazyRangePrefix, distinct_op: DistinctOp, smooth_node: BinaryOp, label: String, source_node: Locatable) RETURNS !MIRBlockExpr ->
    MUTABLE item_var = COPY p.item_var;
    MUTABLE key_expr_mir = runtimeHost__range_visit_mir_with_context(self.host, UNWRAP (distinct_op.expression), item_var);
    MUTABLE obs_zig = runtimeHost__range_transpile_type(self.host, PipelineTypeInput{ TypeMultiowned: COPY TRY (aST__full_type_mut(Locatable{ BinaryOp: COPY smooth_node })) });
    MUTABLE target = pipelineRangeLowerer__without_pointer_prefix(self, obs_zig);
    MUTABLE set_type = TRY (type__tense_type((TRY (aST__full_type_mut(Locatable{ BinaryOp: COPY smooth_node })))));
    MUTABLE elem_type = UNWRAP (TRY (type__element_type(set_type)));
    MUTABLE elem_zig = runtimeHost__range_transpile_type(self.host, PipelineTypeInput{ TypeMultiowned: COPY elem_type });
    MUTABLE is_bounded = type__fixed?(set_type);
    MUTABLE cap: ?TypeArrayCapacity = type__capacity(set_type);
    MUTABLE submit_contract_branch_value: ?CallableContract = NIL;
    IF TRY (pipelineRangeLowerer__pipeline_element_owns_heap?(self, elem_type)) THEN
      submit_contract_branch_value = callableContract__new(TRY (functionSignature__new([Param{ name: "item", type: COPY elem_type, takes: TRUE, default: NIL, mutable: NIL, comptime: NIL, name_token: NIL, required: NIL, sync: NIL, symbol: NIL, carrier_contract: NIL }], TypeTypeInput{ Type: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :Void })) }, NIL, NIL, List[], {}, FALSE, FALSE, NIL, NIL, NIL, List[], NIL, List[])), TRY (ownershipContract__consume_operands([ownershipOperandFact__owned_binding(item_var, elem_type, "observable distinct item", :heap)])), 1);
    ELSE
      submit_contract_branch_value = TRY (callableContract__no_ownership(1));
    END
    MUTABLE submit_contract: CallableContract = submit_contract_branch_value?;
    MUTABLE submit_expr: Emittable = Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: Emittable{ FieldGet: COPY FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__obs_acc", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "inner", lowered_node_id: NIL, ownership_consumption: NIL } }, method: "submit", args: [key_expr_mir], try_wrap: FALSE, callable_contract: COPY submit_contract, owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL  } };
    IF !(is_bounded) THEN
      MUTABLE rtoc_inner_submit: Emittable = COPY submit_expr;
      submit_expr = Emittable{ TryCatch: COPY TryCatch{ expr: rtoc_inner_submit, catch_body: Emittable{ Lit: COPY Lit{ value: "unreachable", lowered_node_id: NIL, ownership_consumption: NIL } }, capture: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL  } };
    END
    MUTABLE publish = [Emittable{ ExprStmt: COPY ExprStmt{ expr: COPY submit_expr, discard: TRUE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }];
    MUTABLE inner_ctor_branch_value: ?TryCatch = NIL;
    IF is_bounded THEN
    MUTABLE rtoc_cap_text: String = "0";
    IF cap EXISTS AS rtoc_cap THEN
      MATCH rtoc_cap START
        TypeArrayCapacity.Int64Value AS n -> rtoc_cap_text = n.toString();,
        TypeArrayCapacity.SymbolValue AS sym -> rtoc_cap_text = COPY CAST(sym AS String);
      END
    END
      inner_ctor_branch_value = pipelineRangeLowerer__observable_catch_unreachable(self, Emittable{ Call: COPY Call{ callee: "CheatLib.obs.StreamSetBounded(${elem_zig}, ${rtoc_cap_text}).init", args: [Emittable{ AllocatorRef: COPY AllocatorRef{ kind: :heap, lowered_node_id: NIL, ownership_consumption: NIL } }], try_wrap: FALSE, owned_return: FALSE, callable_contract: TRY (callableContract__no_ownership(1)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL } });
    ELSE
      inner_ctor_branch_value = pipelineRangeLowerer__observable_catch_unreachable(self, Emittable{ Call: COPY Call{ callee: "CheatLib.obs.StreamSet(${elem_zig}).init", args: [Emittable{ AllocatorRef: COPY AllocatorRef{ kind: :heap, lowered_node_id: NIL, ownership_consumption: NIL } }], try_wrap: FALSE, owned_return: FALSE, callable_contract: TRY (callableContract__no_ownership(1)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL } });
    END
    MUTABLE inner_ctor: TryCatch = inner_ctor_branch_value?;
    RETURN TRY (pipelineRangeLowerer__lower_range_fold_observable(self, p, smooth_node, label, source_node, Emittable{ TryCatch: COPY TRY (pipelineRangeLowerer__observable_alloc_expr(self, target, "newWith", [Emittable{ AllocatorRef: COPY AllocatorRef{ kind: :heap, lowered_node_id: NIL, ownership_consumption: NIL } }, Emittable{ TryCatch: COPY inner_ctor }])) }, publish));
END
PUB FN pipelineRangeLowerer__default_obs_alloc_expr(self: PipelineRangeLowerer, smooth_node: BinaryOp) RETURNS !TryCatch ->
    MUTABLE target = pipelineRangeLowerer__without_pointer_prefix(self, runtimeHost__range_transpile_type(self.host, PipelineTypeInput{ TypeMultiowned: COPY TRY (aST__full_type_mut(Locatable{ BinaryOp: COPY smooth_node })) }));
    RETURN TRY (pipelineRangeLowerer__observable_alloc_expr(self, target, "new", [Emittable{ AllocatorRef: COPY AllocatorRef{ kind: :heap, lowered_node_id: NIL, ownership_consumption: NIL } }]));
END
PUB FN pipelineRangeLowerer__observable_catch_unreachable(self: PipelineRangeLowerer, expr: Emittable) RETURNS TryCatch ->
    RETURN TryCatch{ expr: COPY expr, catch_body: Emittable{ Lit: COPY Lit{ value: "unreachable", lowered_node_id: NIL, ownership_consumption: NIL } }, capture: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
END
PUB FN pipelineRangeLowerer__observable_alloc_expr(self: PipelineRangeLowerer, target: String, method_value: String, args: []Emittable) RETURNS !TryCatch ->
    RETURN pipelineRangeLowerer__observable_catch_unreachable(self, Emittable{ Call: COPY Call{ callee: "${target}.${method_value}", args: COPY args, try_wrap: FALSE, owned_return: TRUE, callable_contract: COPY TRY (callableContract__no_ownership(args.length())), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL } });
END
PUB FN pipelineRangeLowerer__without_const_prefix(self: PipelineRangeLowerer, type_name: String) RETURNS String ->
    MUTABLE prefix = "const ";
    IF !(type_name.startsWith?(prefix)) THEN
      RETURN COPY type_name;
    END
    RETURN type_name.substr(prefix.codepointCount(), (type_name.length() - prefix.codepointCount()));
END
PUB FN pipelineRangeLowerer__without_pointer_prefix(self: PipelineRangeLowerer, type_name: String) RETURNS String ->
    IF !(type_name.startsWith?("*")) THEN
      RETURN COPY type_name;
    END
    RETURN type_name.substr(1, (type_name.length() - 1));
END
PUB FN pipelineRangeLowerer__replace_zig_identifier(self: PipelineRangeLowerer, source: String, needle: String, replacement: String) RETURNS String ->
    IF (needle.length() == 0) THEN
      RETURN COPY source;
    END
    MUTABLE idx = 0;
    MUTABLE needle_len = needle.bytes();
    MUTABLE result = "";
    WHILE (idx < source.bytes()) DO
      IF (((source.substr(idx, needle_len) == needle) AND pipelineRangeLowerer__zig_identifier_boundary?(self, source, (idx - 1))) AND pipelineRangeLowerer__zig_identifier_boundary?(self, source, (idx + needle_len))) THEN
        &result.append(COPY replacement);
        idx = (idx + needle_len);
      ELSE
        &result.append(source.substr(idx, 1));
        idx = (idx + 1);
      END
    END
    RETURN result;
END
PUB FN pipelineRangeLowerer__zig_identifier_boundary?(self: PipelineRangeLowerer, source: String, idx: Int64) RETURNS Bool ->
    IF ((idx < 0) OR (idx >= source.bytes())) THEN
      RETURN TRUE;
    END
    MUTABLE byte = byteAt(source, idx);
    RETURN !(pipelineRangeLowerer__zig_identifier_byte?(self, byte));
END
PUB FN pipelineRangeLowerer__zig_identifier_byte?(self: PipelineRangeLowerer, byte: Int64) RETURNS Bool ->
    RETURN ((((((byte >= 65) AND (byte <= 90))) OR (((byte >= 97) AND (byte <= 122)))) OR (((byte >= 48) AND (byte <= 57)))) OR (byte == 95));
END
PUB FN pipelineRangeLowerer__new(host: RuntimeHost) RETURNS PipelineRangeLowerer@multiowned ->
  MUTABLE self = PipelineRangeLowerer{ host: COPY host };
  pipelineRangeLowerer__initialize(&self, host);
  RETURN self @multiowned;
END
FN castEmittableToLocatable__pipeline_range_lowerer(value: Emittable) RETURNS Locatable ->
  PARTIAL MATCH value START
    DEFAULT -> panic("Invalid cast to Locatable");
  END
  panic("Invalid cast to Locatable");
END
FN ruby_array_concat_Emittable__pipeline_range_lowerer(left: []Emittable, right: []Emittable) RETURNS []Emittable ->
  MUTABLE result: []Emittable = [];
  FOR rtoc_left_item IN left DO
    &result.append(COPY rtoc_left_item);
  END
  FOR rtoc_right_item IN right DO
    &result.append(COPY rtoc_right_item);
  END
  RETURN result;
END
