    RETURN runtimeHost__visit_mir_call(self, node);
END
PUB FN runtimeHost__range_visit_mir_with_decl_alloc(self: RuntimeHost, node: Locatable, alloc: String@symbol) RETURNS Emittable ->
    RETURN runtimeHost__visit_mir_with_decl_alloc_call(self, node, alloc);
END
PUB FN runtimeHost__range_visit_mir_with_context(self: RuntimeHost, node: Locatable, placeholder: ?String, acc: ?String = NIL) RETURNS Emittable ->
    RETURN runtimeHost__visit_mir_with_context_call(self, node, placeholder, acc);
END
PUB FN runtimeHost__range_lower_head_with_context(self: RuntimeHost, node: Locatable, placeholder: ?String) RETURNS PipelineLowerHeadResult ->
    RETURN runtimeHost__lower_head_with_context_call(self, node, placeholder);
END
PUB FN runtimeHost__range_with_fiber_rt<U>(self: RuntimeHost, rt_name: String, blk: FN() -> U) RETURNS U
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN runtimeHost__with_fiber_rt_call(rtoc_self_view, rt_name, blk);
}
END
PUB FN runtimeHost__range_visit_pipeline_body_mir(self: RuntimeHost, body_stmts: []Locatable, placeholder: String) RETURNS ![]Emittable ->
    RETURN TRY (runtimeHost__visit_pipeline_body_mir_call(self, body_stmts, placeholder));
END
PUB FN runtimeHost__range_ast_stmts_use_placeholder?(self: RuntimeHost, body_stmts: []Locatable) RETURNS Bool ->
