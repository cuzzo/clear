  acc_init_stmts: []Emittable,
  loop_acc_stmts: []Emittable,
  post_loop_stmts: []Emittable,
  result_expr: Emittable
}
PUB STRUCT PipelineRangeLoopIter {
  iter: Emittable,
  capture_name: ?String
}
