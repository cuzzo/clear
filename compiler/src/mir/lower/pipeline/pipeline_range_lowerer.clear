PUB FN runtimeHost__new(visit_mir: FN(Locatable) -> Emittable, visit_mir_with_decl_alloc: FN(Locatable, String@symbol) -> Emittable, visit_mir_with_context: FN(Locatable, ?String, ?String) -> Emittable, lower_head_with_context: FN(Locatable, ?String) -> PipelineLowerHeadResult, with_fiber_rt: FN(String, FN() -> Any) -> Any, visit_pipeline_body_mir: FN(Locatable[], String) -> ![]Emittable, ast_stmts_use_placeholder: FN(Locatable[]) -> Bool, bc_target: FN() -> Bool, next_label: FN() -> String, transpile_type: FN(PipelineTypeInput) -> String, schema_lookup: FN() -> FN(String@symbol) -> ?TypeSchemaLookupResult, runtime_name: FN() -> String, next_observable_id: FN() -> Int64, task_config_variant: FN() -> String) RETURNS RuntimeHost@multiowned ->
  MUTABLE self = RuntimeHost{ ast_stmts_use_placeholder: COPY ast_stmts_use_placeholder, bc_target: COPY bc_target, lower_head_with_context: COPY lower_head_with_context, next_label: COPY next_label, next_observable_id: COPY next_observable_id, runtime_name: COPY runtime_name, schema_lookup: COPY schema_lookup, task_config_variant: COPY task_config_variant, transpile_type: COPY transpile_type, visit_mir: COPY visit_mir, visit_mir_with_context: COPY visit_mir_with_context, visit_mir_with_decl_alloc: COPY visit_mir_with_decl_alloc, visit_pipeline_body_mir: COPY visit_pipeline_body_mir, with_fiber_rt: COPY with_fiber_rt };
  runtimeHost__initialize(&self, visit_mir, visit_mir_with_decl_alloc, visit_mir_with_context, lower_head_with_context, with_fiber_rt, visit_pipeline_body_mir, ast_stmts_use_placeholder, bc_target, next_label, transpile_type, schema_lookup, runtime_name, next_observable_id, task_config_variant);
  RETURN self @multiowned;
END
MUTABLE pipeline_alloc_ref_def: FunctionSignature@multiowned = TRY (functionSignature__borrowing_intrinsic());
PUB FN pipelineRangeLowerer__initialize(MUTABLE self: PipelineRangeLowerer, host: RuntimeHost) RETURNS Void ->
    self.host = COPY host;
END
PUB FN pipelineRangeLowerer__finite_stream_source_node?(self: PipelineRangeLowerer, node: Locatable) RETURNS !Bool ->
    RETURN ((((node IS_A RangeLit OR TRY (type__dynamic_stream?((TRY (aST__full_type_mut(node)))))) OR TRY (type__open_stream?((TRY (aST__full_type_mut(node)))))) OR TRY (type__bounded_stream?((TRY (aST__full_type_mut(node)))))) OR TRY (type__inf_stream?((TRY (aST__full_type_mut(node))))));
END
PUB FN pipelineRangeLowerer__unwrap_range_chain(self: PipelineRangeLowerer, MUTABLE node: Locatable) RETURNS !?PipelineRangeChain ->
    IF !((IF node IS_A BinaryOp AS binary_op THEN binaryOp__smooth?(binary_op) ELSE FALSE END)) THEN
      IF TRY (pipelineRangeLowerer__finite_stream_source_node?(self, node)) THEN
        RETURN PipelineRangeChain{ source: COPY node, stages: List[] };
      END
      RETURN NIL;
    END
    MUTABLE stages: []Locatable = List[];
    MUTABLE cursor: Locatable = COPY node;
    WHILE (IF cursor IS_A BinaryOp AS binary_op THEN binaryOp__smooth?(binary_op) ELSE FALSE END) DO
      MUTABLE rhs: ?Locatable = aST__node_right(cursor);
      IF aST__pipeline_fusible_stage?( UNWRAP (rhs)) THEN
        stages = ([UNWRAP (rhs)] + stages);
        cursor = UNWRAP (locatable__left(cursor));
      ELSE
        RETURN NIL;
      END
    END
    IF !(TRY (pipelineRangeLowerer__finite_stream_source_node?(self, cursor))) THEN
      RETURN NIL;
    END
    RETURN PipelineRangeChain{ source: COPY cursor, stages: COPY stages };
END
PUB FN pipelineRangeLowerer__build_lazy_range_prefix(self: PipelineRangeLowerer, source_node: Locatable, stages: []Locatable, on_skip: ?(FN(String) -> !Emittable[]) = NIL, source_alloc: ?String@symbol = NIL, fiber_rt: ?String = NIL, track_owned_items: Bool = FALSE) RETURNS !PipelineLazyRangePrefix ->
    MUTABLE source_ti = TRY (aST__full_type_mut(source_node));
    MUTABLE elem_t = (TRY (type__runtime_stream_storage_element_type(source_ti)) OR_ELSE TRY (pipelineRangeLowerer__range_literal_element_type(self, source_node)));
    MUTABLE elem_zig = TRY (type__zig_type( CAST(elem_t AS Type)));
    MUTABLE initial_capture = "__each_item";
    MUTABLE item_var: String = initial_capture;
    MUTABLE item_counter = 0;
    MUTABLE item_used: Bool = FALSE;
    MUTABLE outer_stmts: []Emittable = List[];
    MUTABLE stage_stmts: []Emittable = List[];
    MUTABLE track_owned = (track_owned_items AND !(runtimeHost__range_bc_target?(self.host)));
    MUTABLE current_type: Type = elem_t;
    MUTABLE current_owned: Bool = FALSE;
    MUTABLE owned_stmts: []Emittable = List[];
    IF (track_owned AND TRY (type__runtime_stream?(source_ti))) THEN
      owned_stmts = TRY (pipelineRangeLowerer__owned_stream_item_stmts(self, initial_capture, CAST(elem_t AS ?Type)));
      stage_stmts = ruby_array_concat_Emittable__pipeline_range_lowerer(stage_stmts, owned_stmts);
      current_owned = !((owned_stmts.length() == 0));
    END
    MUTABLE lower_stages = %() USE(MUTABLE current_owned, MUTABLE current_type, initial_capture, MUTABLE item_counter, MUTABLE item_used, MUTABLE item_var, on_skip, MUTABLE outer_stmts, MUTABLE stage_stmts, stages, MUTABLE track_owned, MUTABLE owned_stmts, self) -> {
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < stages.length() DO
      IF stages[rtoc_idx]? IS_A SelectOp AS select_op THEN
          item_used = TRUE;
          IF pipelinePlaceholderUsage__identity_placeholder?(selectOp__expression(select_op)) THEN
            RETURN NIL;
          END
          item_counter = (item_counter + 1);
          MUTABLE next_item = "__each_item_${item_counter.toString()}";
          MUTABLE head = runtimeHost__range_lower_head_with_context(self.host, selectOp__expression(select_op), item_var);
          stage_stmts = ruby_array_concat_Emittable__pipeline_range_lowerer(stage_stmts, CAST(head.pending AS []Emittable));
          &stage_stmts.append(Emittable{ Let: COPY Let{ name: COPY next_item, init: COPY head.value, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
          item_var = COPY next_item;
          current_type = TRY (type__new(TypeConstructionInput{ Type: COPY TRY (aST__full_type_mut(selectOp__expression(select_op))) }));
          IF (!(track_owned) OR pipelinePlaceholderUsage__placeholder_projection?(selectOp__expression(select_op))) THEN
            current_owned = FALSE;
          ELSE
            owned_stmts = TRY (pipelineRangeLowerer__owned_stream_item_stmts(self, next_item, current_type));
            stage_stmts = ruby_array_concat_Emittable__pipeline_range_lowerer(stage_stmts, owned_stmts);
            current_owned = !((owned_stmts.length() == 0));
            IF current_owned THEN
              MUTABLE stage_value: Emittable = head.value;
              MUTABLE fact_source: String = COPY next_item;
              PARTIAL MATCH stage_value START
                Emittable.Call AS call -> fact_source = call.callee;,
                Emittable.MIRMethodCall AS mir_method_call -> fact_source = mir_method_call.method;,
                DEFAULT -> fact_source = COPY next_item;
              END
              &stage_stmts.append(Emittable{ OwnedCreate: COPY OwnedCreate{ name: COPY next_item, alloc: :heap, type_info: COPY current_type, source: COPY fact_source, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
            END
          END
      ELSE_IF stages[rtoc_idx]? IS_A WhereOp AS where_op THEN
          IF (item_var == initial_capture) THEN
            item_used = TRUE;
          END
          MUTABLE pred_mir = runtimeHost__range_visit_mir_with_context(self.host, whereOp__expression(where_op), item_var);
          MUTABLE skip_stmts: []Emittable = List[];
          IF on_skip EXISTS AS skip_fn THEN
            skip_stmts = TRY (skip_fn(COPY item_var));
          END
          &skip_stmts.append(Emittable{ ContinueStmt: COPY ContinueStmt{ unused: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
          &stage_stmts.append(Emittable{ IfStmt: COPY IfStmt{ cond: Emittable{ MIRUnaryOp: COPY MIRUnaryOp{ op: "!", operand: COPY pred_mir, lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: skip_stmts, else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL } });
      ELSE_IF stages[rtoc_idx]? IS_A TakeWhileOp AS take_while_op THEN
          IF (item_var == initial_capture) THEN
            item_used = TRUE;
          END
          MUTABLE pred_mir = runtimeHost__range_visit_mir_with_context(self.host, UNWRAP (takeWhileOp__expression(take_while_op)), item_var);
          MUTABLE skip_stmts: []Emittable = List[];
          IF on_skip EXISTS AS skip_fn THEN
            skip_stmts = TRY (skip_fn(COPY item_var));
          END
          &skip_stmts.append(Emittable{ BreakStmt: COPY BreakStmt{ label: NIL, value: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
          &stage_stmts.append(Emittable{ IfStmt: COPY IfStmt{ cond: Emittable{ MIRUnaryOp: COPY MIRUnaryOp{ op: "!", operand: COPY pred_mir, lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: skip_stmts, else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL } });
      ELSE_IF stages[rtoc_idx]? IS_A LimitOp AS limit_op THEN
          item_counter = (item_counter + 1);
          MUTABLE cvar = "__limit_cnt_${item_counter.toString()}";
          MUTABLE cnt_var = "__limit_max_${item_counter.toString()}";
          MUTABLE cnt_mir = runtimeHost__range_visit_mir(self.host, UNWRAP (limit_op.count));
          &outer_stmts.append(Emittable{ Let: COPY Let{ name: COPY cvar, init: Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: "i64", method: :as, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
          &outer_stmts.append(Emittable{ Let: COPY Let{ name: COPY cnt_var, init: COPY cnt_mir, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
          &stage_stmts.append(Emittable{ IfStmt: COPY IfStmt{ cond: Emittable{ MIRBinOp: COPY MIRBinOp{ op: ">=", left: Emittable{ Ident: COPY Ident{ name: COPY cvar, lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Ident: COPY Ident{ name: COPY cnt_var, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: [Emittable{ BreakStmt: COPY BreakStmt{ label: NIL, value: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL } });
          &stage_stmts.append(Emittable{ Set: COPY Set{ target: Emittable{ Ident: COPY Ident{ name: COPY cvar, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ MIRBinOp: COPY MIRBinOp{ op: "+", left: Emittable{ Ident: COPY Ident{ name: COPY cvar, lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Lit: COPY Lit{ value: "1", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } });
      ELSE_IF stages[rtoc_idx]? IS_A SkipOp AS skip_op THEN
          item_counter = (item_counter + 1);
          MUTABLE cvar = "__skip_cnt_${item_counter.toString()}";
          MUTABLE cnt_var = "__skip_max_${item_counter.toString()}";
          MUTABLE cnt_mir = runtimeHost__range_visit_mir(self.host, UNWRAP (skip_op.count));
          &outer_stmts.append(Emittable{ Let: COPY Let{ name: COPY cvar, init: Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: "i64", method: :as, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
          &outer_stmts.append(Emittable{ Let: COPY Let{ name: COPY cnt_var, init: COPY cnt_mir, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
          &stage_stmts.append(Emittable{ IfStmt: COPY IfStmt{ cond: Emittable{ MIRBinOp: COPY MIRBinOp{ op: "<", left: Emittable{ Ident: COPY Ident{ name: COPY cvar, lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Ident: COPY Ident{ name: COPY cnt_var, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: [Emittable{ Set: COPY Set{ target: Emittable{ Ident: COPY Ident{ name: COPY cvar, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ MIRBinOp: COPY MIRBinOp{ op: "+", left: Emittable{ Ident: COPY Ident{ name: COPY cvar, lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Lit: COPY Lit{ value: "1", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ ContinueStmt: COPY ContinueStmt{ unused: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL } });
      ELSE_IF stages[rtoc_idx]? IS_A TapOp AS tap_op THEN
          IF (item_var == initial_capture) THEN
            item_used = TRUE;
          END
          stage_stmts = ruby_array_concat_Emittable__pipeline_range_lowerer(stage_stmts, CAST(TRY (runtimeHost__range_visit_pipeline_body_mir(self.host, tap_op.body, item_var)) AS []Emittable));
      END
      rtoc_idx = rtoc_idx + 1;
    END
    NIL
    };
    IF fiber_rt EXISTS AS fiber_rt_value THEN
      runtimeHost__range_with_fiber_rt(self.host, fiber_rt_value, %() USE(lower_stages) -> lower_stages());
    ELSE
      lower_stages();
    END
    MUTABLE is_var_stream = (IF source_node IS_A Identifier AS identifier THEN ((((TRY (type__dynamic_stream?(source_ti)) OR TRY (type__open_stream?(source_ti))) OR TRY (type__bounded_stream?(source_ti))) OR TRY (type__inf_stream?(source_ti)))) ELSE FALSE END);
    MUTABLE source_name: String = "";
    IF is_var_stream THEN
      MUTABLE resolved = runtimeHost__range_visit_mir(self.host, source_node);
      IF resolved IS_A Ident THEN
        source_name = COPY CAST(emittable__name(resolved) AS String);
      ELSE
        source_name = COPY CAST(locatable__name(source_node) AS String);
      END
    ELSE
      source_name = "__range_src";
    END
    MUTABLE range_let: ?Let = IF !(is_var_stream) THEN
      {
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE source_mir =   IF source_alloc THEN
      runtimeHost__range_visit_mir_with_decl_alloc(self.host, source_node, symbol(source_alloc))
    ELSE
      runtimeHost__range_visit_mir(self.host, source_node)
    END;
    Let{ name: COPY "__range_src", init: COPY source_mir, mutable: TRUE, annotation: NIL, suppression: "_ = &__range_src;", alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }
    }
    ELSE
      NIL
    END;
    MUTABLE range_mark_branch_value: ?AllocMark = NIL;
    IF (range_let AND (source_alloc != NIL)) THEN
      range_mark_branch_value = AllocMark{ name: "__range_src", alloc: symbol(COPY source_alloc), type_info: COPY source_ti, scope: :heap, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    ELSE
      range_mark_branch_value = NIL;
    END
    MUTABLE range_mark: AllocMark = range_mark_branch_value?;
    MUTABLE next_method: String = "";
    IF ((TRY (type__bounded_stream?(source_ti)) OR TRY (type__inf_stream?(source_ti)))) THEN
      next_method = "nextOrNull";
    ELSE
      next_method = "next";
    END
    RETURN PipelineLazyRangePrefix{ range_mark: COPY range_mark, range_let: COPY range_let, source_name: COPY source_name, outer_stmts: COPY outer_stmts, stage_stmts: COPY stage_stmts, item_var: COPY item_var, initial_capture: COPY initial_capture, item_used: item_used, elem_zig: COPY elem_zig, next_method: COPY next_method, item_type: COPY current_type, item_owned: current_owned };
END
PUB FN pipelineRangeLowerer__range_literal_element_type(self: PipelineRangeLowerer, source_node: Locatable) RETURNS !Type ->
    MUTABLE start_ft_branch_value: ?Type = NIL;
    IF source_node IS_A RangeLit THEN
      start_ft_branch_value = TRY (aST__full_type_mut(UNWRAP (locatable__start(source_node))));
    ELSE
      start_ft_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: :Int64 }));
    END
    MUTABLE start_ft: Type = start_ft_branch_value?;
    RETURN TRY (type__new(TypeConstructionInput{ Type: COPY start_ft }));
END
PUB FN pipelineRangeLowerer__lower_each_range(self: PipelineRangeLowerer, MUTABLE range_lit: Locatable, stages: []Locatable, each_op: EachOp) RETURNS !ScopeBlock ->
    MUTABLE prefix: PipelineLazyRangePrefix = TRY (pipelineRangeLowerer__build_lazy_range_prefix(self, range_lit, stages, NIL, NIL, NIL, TRUE));
    MUTABLE item_var = COPY prefix.item_var;
    MUTABLE initial_capture = COPY prefix.initial_capture;
    MUTABLE item_used = prefix.item_used;
    MUTABLE body_mir = TRY (runtimeHost__range_visit_pipeline_body_mir(self.host, each_op.body, item_var));
    MUTABLE body_uses_initial = (((item_var == initial_capture)) AND runtimeHost__range_ast_stmts_use_placeholder?(self.host, each_op.body));
    item_used = (item_used OR body_uses_initial);
    MUTABLE capture_name: String = "";
    IF item_used THEN
      capture_name = COPY initial_capture;
    ELSE
      capture_name = "_";
    END
    MUTABLE source_ti = TRY (aST__full_type_mut(range_lit));
    MUTABLE defer_deinit_branch_value: ?MIRDeferStmt = NIL;
    IF TRY (type__bounded_stream?(source_ti)) THEN
      defer_deinit_branch_value = TRY (pipelineLazyRangePrefix__deinit_stmt( prefix));
    ELSE
      defer_deinit_branch_value = NIL;
    END
    MUTABLE defer_deinit: ?MIRDeferStmt = defer_deinit_branch_value;
    MUTABLE bc_iter: ?PipelineRangeLoopIter = TRY (pipelineRangeLowerer__bc_loop_iter(self, range_lit, source_ti, IF (capture_name == "_") THEN
      "_"
    ELSE
      initial_capture
    END));
    IF bc_iter EXISTS AS bc_iter_value THEN
      RETURN ScopeBlock{ body: COPY (TRY (pipelineLazyRangePrefix__outer_setup_stmts( prefix)) + [castPipelineLazyRangePrefixReturnValueToEmittable__pipeline_range_lowerer(TRY (pipelineLazyRangePrefix__loop_stmt( prefix, bc_iter_value.iter, body_mir, bc_iter_value.capture_name)))]), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    END
    RETURN ScopeBlock{ body: COPY (TRY (pipelineLazyRangePrefix__setup_stmts( prefix)) + (([defer_deinit])) + [castPipelineLazyRangePrefixReturnValueToEmittable__pipeline_range_lowerer(TRY (pipelineLazyRangePrefix__loop_stmt( prefix, NIL, body_mir, capture_name)))]), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PUB FN pipelineRangeLowerer__bc_for_iter_range(self: PipelineRangeLowerer, range_lit: RangeLit, capture_name: ?String) RETURNS Tuple<IterRange, ?String> ->
    MUTABLE start_mir = runtimeHost__range_visit_mir(self.host, range_lit.start);
    MUTABLE end_mir = runtimeHost__range_visit_mir(self.host, range_lit.finish);
    MUTABLE end_expr: Emittable = COPY end_mir;
    IF range_lit.inclusive THEN
      end_expr = Emittable{ MIRBinOp: COPY MIRBinOp{ op: "+", left: COPY end_mir, right: Emittable{ Lit: COPY Lit{ value: "1", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } };
    END
    RETURN CAST(Tuple{IterRange{ start: start_mir, end_val: end_expr, capture_type: :i64, lowered_node_id: NIL, ownership_consumption: NIL }, COPY capture_name} AS Tuple<IterRange, ?String>);
END
PUB FN pipelineRangeLowerer__numeric_fold_expr_typed(self: PipelineRangeLowerer, expr_ast: Locatable, item_var: String, acc_zig: String) RETURNS !Emittable ->
    MUTABLE expr_mir = runtimeHost__range_visit_mir_with_context(self.host, expr_ast, item_var);
    MUTABLE expr_type = TRY (aST__full_type_mut(expr_ast));
    MUTABLE expr_is_int = type__integer?((TRY (type__new( TypeConstructionInput{ Type: COPY expr_type }))));
    MUTABLE acc_is_float = ((acc_zig == "f64") OR (acc_zig == "f32"));
    IF (expr_is_int AND acc_is_float) THEN
      RETURN Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ MIRCast: COPY MIRCast{ expr: COPY expr_mir, target_type: NIL, method: :floatFromInt, lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: COPY acc_zig, method: :as, lowered_node_id: NIL, ownership_consumption: NIL } };
    ELSE
      RETURN expr_mir;
    END
END
PUB FN pipelineRangeLowerer__lower_range_fold(self: PipelineRangeLowerer, MUTABLE range_lit: Locatable, stages: []Locatable, fold_op: PipelineDefaultObservableFoldOp, MUTABLE smooth_node: BinaryOp) RETURNS !MIRBlockExpr ->
    MUTABLE label: String = "";
    IF smooth_node.observable_dest THEN
      MUTABLE terminal: ?String@symbol = pipelineRangeLowerer__fold_op_observable_terminal(fold_op);
      IF terminal EXISTS AS terminal_value THEN
        MUTABLE terminal_value_mutable = COPY terminal_value;
        MUTABLE fid = runtimeHost__range_next_observable_id(self.host);
        MUTABLE prefix: PipelineLazyRangePrefix = TRY (pipelineRangeLowerer__build_lazy_range_prefix(self, range_lit, stages, NIL, :heap, "__rt_obs_${fid.toString()}", TRUE));
        label = runtimeHost__range_next_label(self.host);
        RETURN TRY (pipelineRangeLowerer__lower_range_fold_observable_default(self, prefix, fold_op, &smooth_node, label, range_lit, terminal_value_mutable, fid));
      ELSE
        RAISE Input, CompilerError, "lower_range_fold: observable_dest set but no terminal registered for {}";
      END
    END
    MUTABLE prefix: PipelineLazyRangePrefix = TRY (pipelineRangeLowerer__build_lazy_range_prefix(self, range_lit, stages, NIL, NIL, NIL, TRUE));
    label = runtimeHost__range_next_label(self.host);
    MUTABLE names = pipelineRangeFoldNames__for_label(label, runtimeHost__range_bc_target?(self.host));
    MUTABLE plan: ?PipelineRangeFoldPlan = TRY (pipelineRangeLowerer__scalar_fold_plan(self, prefix, fold_op, &smooth_node, names));
    RETURN TRY (pipelineRangeLowerer__range_accumulating_block(self, range_lit, prefix, label, UNWRAP (plan), prefix.initial_capture));
END
PUB FN pipelineRangeLowerer__lower_range_reduce(self: PipelineRangeLowerer, MUTABLE range_lit: Locatable, stages: []Locatable, reduce_op: ReduceOp, smooth_node: ?BinaryOp = NIL) RETURNS !MIRBlockExpr ->
    MUTABLE label: String = "";
    MUTABLE prefix: PipelineLazyRangePrefix = TRY (pipelineRangeLowerer__build_lazy_range_prefix(self, range_lit, stages, NIL, IF smooth_node?.observable_dest THEN
      :heap
    ELSE
      NIL
    END, NIL, TRUE));
    MUTABLE item_var = COPY prefix.item_var;
    IF smooth_node?.observable_dest THEN
      label = runtimeHost__range_next_label(self.host);
      RETURN TRY (pipelineRangeLowerer__lower_range_reduce_observable(self, prefix, reduce_op, UNWRAP (smooth_node), label, range_lit));
    END
    label = runtimeHost__range_next_label(self.host);
    MUTABLE acc_zig = runtimeHost__range_transpile_type(self.host, PipelineTypeInput{ StringValue: COPY type__to_s((TRY (aST__full_type_mut(Locatable{ ReduceOp: COPY reduce_op })))) });
    MUTABLE init_mir = runtimeHost__range_visit_mir(self.host, UNWRAP (reduce_op.initial_value));
    MUTABLE expr_mir = runtimeHost__range_visit_mir_with_context(self.host, UNWRAP (reduce_op.expression), item_var, "acc");
    MUTABLE plan = PipelineRangeFoldPlan{ acc_init_stmts: [Emittable{ Let: COPY Let{ name: COPY "acc", init: COPY init_mir, mutable: TRUE, annotation: COPY TRY (type__new( TypeConstructionInput{ StringValue: COPY acc_zig })), suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }], loop_acc_stmts: [Emittable{ Set: COPY Set{ target: Emittable{ Ident: COPY Ident{ name: "acc", lowered_node_id: NIL, ownership_consumption: NIL } }, value: COPY expr_mir, needs_field_cleanup: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], post_loop_stmts: List[], result_expr: Emittable{ Ident: COPY Ident{ name: "acc", lowered_node_id: NIL, ownership_consumption: NIL } } };
    RETURN TRY (pipelineRangeLowerer__range_accumulating_block(self, range_lit, prefix, label, plan, prefix.initial_capture));
END
PUB FN pipelineRangeLowerer__scalar_fold_plan(self: PipelineRangeLowerer, prefix: PipelineLazyRangePrefix, fold_op: PipelineDefaultObservableFoldOp, MUTABLE smooth_node: BinaryOp, names: PipelineRangeFoldNames) RETURNS !?PipelineRangeFoldPlan ->
    IF fold_op IS_A CountOp@multiowned AS count_op_multiowned THEN
      RETURN TRY (pipelineRangeLowerer__count_fold_plan(self, prefix, CAST(COPY count_op_multiowned AS CountOp), names));
    ELSE_IF fold_op IS_A SumOp@multiowned AS sum_op_multiowned THEN
      MUTABLE sum_op_multiowned_mutable = COPY sum_op_multiowned;
      RETURN TRY (pipelineRangeLowerer__sum_fold_plan(self, prefix, CAST(COPY sum_op_multiowned_mutable AS SumOp), smooth_node, names));
    ELSE_IF fold_op IS_A AverageOp@multiowned AS average_op_multiowned THEN
      RETURN TRY (pipelineRangeLowerer__average_fold_plan(self, prefix, CAST(COPY average_op_multiowned AS AverageOp), names));
    ELSE_IF fold_op IS_A MinOp@multiowned AS min_op_multiowned THEN
      RETURN TRY (pipelineRangeLowerer__min_fold_plan(self, prefix, CAST(COPY min_op_multiowned AS MinOp), &smooth_node, names));
    ELSE_IF fold_op IS_A MaxOp@multiowned AS max_op_multiowned THEN
      RETURN TRY (pipelineRangeLowerer__max_fold_plan(self, prefix, CAST(COPY max_op_multiowned AS MaxOp), &smooth_node, names));
    ELSE_IF fold_op IS_A AnyOp@multiowned AS any_op_multiowned THEN
      RETURN pipelineRangeLowerer__any_fold_plan(self, prefix, CAST(COPY any_op_multiowned AS AnyOp), names);
    ELSE_IF fold_op IS_A AllOp@multiowned AS all_op_multiowned THEN
      RETURN pipelineRangeLowerer__all_fold_plan(self, prefix, CAST(COPY all_op_multiowned AS AllOp), names);
    ELSE_IF fold_op IS_A FindOp@multiowned AS find_op_multiowned THEN
      MUTABLE find_op_multiowned_mutable = COPY find_op_multiowned;
      RETURN TRY (pipelineRangeLowerer__find_fold_plan(self, prefix, CAST(COPY find_op_multiowned_mutable AS FindOp), smooth_node, names));
    ELSE
      RETURN NIL;
    END
END
PUB FN pipelineRangeLowerer__count_fold_plan(self: PipelineRangeLowerer, prefix: PipelineLazyRangePrefix, fold_op: CountOp, names: PipelineRangeFoldNames) RETURNS !PipelineRangeFoldPlan ->
    MUTABLE pred_mir = runtimeHost__range_visit_mir_with_context(self.host, UNWRAP (fold_op.expression), prefix.item_var);
    RETURN PipelineRangeFoldPlan{ acc_init_stmts: [Emittable{ Let: COPY Let{ name: COPY names.acc, init: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: COPY TRY (type__new(TypeConstructionInput{ StringValue: COPY "i64" })), suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }], loop_acc_stmts: [Emittable{ IfStmt: COPY IfStmt{ cond: COPY pred_mir, then_body: [Emittable{ Set: COPY Set{ target: Emittable{ Ident: COPY Ident{ name: COPY names.acc, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ MIRBinOp: COPY MIRBinOp{ op: "+", left: Emittable{ Ident: COPY Ident{ name: COPY names.acc, lowered_node_id: NIL, ownership_consumption: NIL } }, right: Emittable{ Lit: COPY Lit{ value: "1", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL } }], post_loop_stmts: List[], result_expr: Emittable{ Ident: COPY Ident{ name: COPY names.acc, lowered_node_id: NIL, ownership_consumption: NIL } } };
END
PUB FN pipelineRangeLowerer__sum_fold_plan(self: PipelineRangeLowerer, prefix: PipelineLazyRangePrefix, MUTABLE fold_op: SumOp, smooth_node: BinaryOp, names: PipelineRangeFoldNames) RETURNS !PipelineRangeFoldPlan ->
    MUTABLE acc_zig = runtimeHost__range_transpile_type(self.host, PipelineTypeInput{ StringValue: COPY type__to_s((TRY (aST__full_type_mut(Locatable{ BinaryOp: COPY smooth_node })))) });
    MUTABLE expr_mir = TRY (pipelineRangeLowerer__numeric_fold_expr_typed(self, UNWRAP (fold_op.expression), prefix.item_var, acc_zig));
    RETURN PipelineRangeFoldPlan{ acc_init_stmts: [Emittable{ Let: COPY Let{ name: COPY names.acc, init: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: COPY TRY (type__new( TypeConstructionInput{ StringValue: COPY acc_zig })), suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } }], loop_acc_stmts: [Emittable{ Set: COPY Set{ target: Emittable{ Ident: COPY Ident{ name: COPY names.acc, lowered_node_id: NIL, ownership_consumption: NIL } }, value: Emittable{ MIRBinOp: COPY MIRBinOp{ op: "+", left: Emittable{ Ident: COPY Ident{ name: COPY names.acc, lowered_node_id: NIL, ownership_consumption: NIL } }, right: COPY expr_mir, lowered_node_id: NIL, ownership_consumption: NIL } }, needs_field_cleanup: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }], post_loop_stmts: List[], result_expr: Emittable{ Ident: COPY Ident{ name: COPY names.acc, lowered_node_id: NIL, ownership_consumption: NIL } } };
END
PUB FN pipelineRangeLowerer__average_fold_plan(self: PipelineRangeLowerer, prefix: PipelineLazyRangePrefix, MUTABLE fold_op: AverageOp, names: PipelineRangeFoldNames) RETURNS !PipelineRangeFoldPlan ->
    MUTABLE expr_f64 = TRY (pipelineRangeLowerer__numeric_fold_expr_typed(self, UNWRAP (fold_op.expression), prefix.item_var, "f64"));
