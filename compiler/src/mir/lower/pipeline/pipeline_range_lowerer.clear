urce_column: NIL, source_line: NIL }], else_body: [BreakStmt{ label: NIL, value: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }], lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }} AS Tuple<Let, IfBindStmt>), capture: NIL, update: NIL, mark_per_iter: NIL, tight: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }, ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: inner_recv, method: "markSeen", args: ( { MUTABLE rtoc_empty_list_35: []Any = List[]; rtoc_empty_list_35 } ), try_wrap: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: FALSE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }, BreakStmt{ label: COPY blk_label, value: Emittable{ MIRCast: COPY MIRCast{ expr: Emittable{ Lit: COPY Lit{ value: "0", lowered_node_id: NIL, ownership_consumption: NIL } }, target_type: "i32", method: :as, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }} AS Tuple<Let, WhileStmt, ExprStmt, BreakStmt>), lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL } }, discard: TRUE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }];
    MUTABLE obs_target = pipelineRangeLowerer__without_pointer_prefix(rtoc_self_view, rtoc_self_view.host.range_transpile_type(PipelineRangeTypeInput{ TypeMultiowned: COPY &smooth_node.full_type_mut() }));
    MUTABLE acc_alloc = TRY (pipelineRangeLowerer__observable_alloc_expr(rtoc_self_view, obs_target, "newWith", [Emittable{ AllocatorRef: COPY AllocatorRef{ kind: :heap, lowered_node_id: NIL, ownership_consumption: NIL } }, Emittable{ RuntimeCall: COPY RuntimeCall{ spec: COPY runtimeCalls__atomic_reduce_init_spec(inner_zig), args: [init_mir], lowered_node_id: NIL, ownership_consumption: NIL } }]));
    RETURN TRY (pipelineRangeLowerer__lower_range_fold_observable(rtoc_self_view, p, smooth_node, label, source_node, Emittable{ TryCatch: COPY acc_alloc }, publish, fid));
}
END
PUB FN pipelineRangeLowerer__lower_range_fold_observable_distinct(self: PipelineRangeLowerer, p: PipelineLazyRangePrefix, distinct_op: DistinctOp, MUTABLE smooth_node: BinaryOp, label: String, source_node: Locatable) RETURNS !MIRBlockExpr
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE item_var = COPY p.item_var;
    MUTABLE key_expr_mir = rtoc_self_view.host.range_visit_mir_with_context(distinct_op.expression, item_var);
    MUTABLE obs_zig = rtoc_self_view.host.range_transpile_type(PipelineRangeTypeInput{ TypeMultiowned: COPY &smooth_node.full_type_mut() });
    MUTABLE target = pipelineRangeLowerer__without_pointer_prefix(rtoc_self_view, obs_zig);
    MUTABLE set_type = TRY (type__tense_type((&smooth_node.full_type_mut())));
    MUTABLE elem_type = UNWRAP (TRY (type__element_type(set_type)));
    MUTABLE elem_zig = rtoc_self_view.host.range_transpile_type(PipelineRangeTypeInput{ TypeMultiowned: COPY elem_type });
    MUTABLE is_bounded = type__fixed?(set_type);
    MUTABLE cap: ?TypeArrayCapacity = type__capacity(set_type);
    MUTABLE submit_contract_branch_value: ?CallableContract = NIL;
    IF pipelineRangeLowerer__pipeline_element_owns_heap?(rtoc_self_view, elem_type) THEN
      submit_contract_branch_value = callableContract__new(TRY (functionSignature__new([Param{ name: "item", type: COPY elem_type, takes: TRUE, default: NIL, mutable: NIL, comptime: NIL, name_token: NIL, required: NIL, sync: NIL, symbol: NIL, carrier_contract: NIL }], TypeTypeInput{ Type: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :Void })) }, NIL, NIL, ( { MUTABLE rtoc_empty_list_36: []String@symbol = List[]; rtoc_empty_list_36 } ), {}, FALSE, FALSE, NIL, NIL, NIL, ( { MUTABLE rtoc_empty_list_37: []String@symbol = List[]; rtoc_empty_list_37 } ), NIL, ( { MUTABLE rtoc_empty_list_38: []String@symbol = List[]; rtoc_empty_list_38 } ))), TRY (ownershipContract__consume_operands([ownershipOperandFact__owned_binding(item_var, elem_type, "observable distinct item", :heap)])), 1);
    ELSE
      submit_contract_branch_value = TRY (callableContract__no_ownership(1));
    END
    MUTABLE submit_contract: CallableContract = submit_contract_branch_value?;
    MUTABLE submit_expr = MIRMethodCall{ receiver: FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__obs_acc", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "inner", lowered_node_id: NIL, ownership_consumption: NIL }, method: "submit", args: [CAST(key_expr_mir AS Any)], try_wrap: FALSE, callable_contract: COPY submit_contract, owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    IF !(is_bounded) THEN
      submit_expr = TryCatch{ expr: Emittable{ MIRMethodCall: COPY submit_expr }, catch_body: Emittable{ Lit: COPY Lit{ value: "unreachable", lowered_node_id: NIL, ownership_consumption: NIL } }, capture: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
    END
    MUTABLE publish = [ExprStmt{ expr: Emittable{ MIRMethodCall: COPY submit_expr }, discard: TRUE, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }];
    MUTABLE inner_ctor_branch_value: ?TryCatch = NIL;
    IF is_bounded THEN
      inner_ctor_branch_value = pipelineRangeLowerer__observable_catch_unreachable(rtoc_self_view, Emittable{ Call: COPY Call{ callee: "CheatLib.obs.StreamSetBounded(${elem_zig}, ${cap}).init", args: [Emittable{ AllocatorRef: COPY AllocatorRef{ kind: :heap, lowered_node_id: NIL, ownership_consumption: NIL } }], try_wrap: FALSE, owned_return: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(1)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL } });
    ELSE
      inner_ctor_branch_value = pipelineRangeLowerer__observable_catch_unreachable(rtoc_self_view, Emittable{ Call: COPY Call{ callee: "CheatLib.obs.StreamSet(${elem_zig}).init", args: [Emittable{ AllocatorRef: COPY AllocatorRef{ kind: :heap, lowered_node_id: NIL, ownership_consumption: NIL } }], try_wrap: FALSE, owned_return: FALSE, callable_contract: COPY TRY (callableContract__no_ownership(1)), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL } });
    END
    MUTABLE inner_ctor: TryCatch = inner_ctor_branch_value?;
    RETURN TRY (pipelineRangeLowerer__lower_range_fold_observable(rtoc_self_view, p, smooth_node, label, source_node, Emittable{ TryCatch: COPY TRY (pipelineRangeLowerer__observable_alloc_expr(rtoc_self_view, target, "newWith", [Emittable{ AllocatorRef: COPY AllocatorRef{ kind: :heap, lowered_node_id: NIL, ownership_consumption: NIL } }, Emittable{ TryCatch: COPY inner_ctor }])) }, publish));
}
END
PUB FN pipelineRangeLowerer__default_obs_alloc_expr(self: PipelineRangeLowerer, MUTABLE smooth_node: BinaryOp) RETURNS !TryCatch
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE target = pipelineRangeLowerer__without_pointer_prefix(rtoc_self_view, rtoc_self_view.host.range_transpile_type(PipelineRangeTypeInput{ TypeMultiowned: COPY &smooth_node.full_type_mut() }));
    RETURN TRY (pipelineRangeLowerer__observable_alloc_expr(rtoc_self_view, target, "new", [Emittable{ AllocatorRef: COPY AllocatorRef{ kind: :heap, lowered_node_id: NIL, ownership_consumption: NIL } }]));
}
END
PUB FN pipelineRangeLowerer__observable_catch_unreachable(self: PipelineRangeLowerer, expr: Emittable) RETURNS TryCatch
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TryCatch{ expr: COPY expr, catch_body: Emittable{ Lit: COPY Lit{ value: "unreachable", lowered_node_id: NIL, ownership_consumption: NIL } }, capture: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
}
END
PUB FN pipelineRangeLowerer__observable_alloc_expr(self: PipelineRangeLowerer, target: String, method_value: String, args: []Emittable) RETURNS !TryCatch
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN pipelineRangeLowerer__observable_catch_unreachable(rtoc_self_view, Emittable{ Call: COPY Call{ callee: "${target}.${method_value}", args: COPY args, try_wrap: FALSE, owned_return: TRUE, callable_contract: COPY TRY (callableContract__no_ownership(args.length())), lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL } });
}
END
PUB FN pipelineRangeLowerer__without_const_prefix(self: PipelineRangeLowerer, type_name: String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE prefix = "const ";
    IF !(type_name.startsWith?(prefix)) THEN
      RETURN COPY type_name;
    END
    RETURN type_name.substr(prefix.codepointCount(), (type_name.length() - prefix.codepointCount()));
}
END
PUB FN pipelineRangeLowerer__without_pointer_prefix(self: PipelineRangeLowerer, type_name: String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(type_name.startsWith?("*")) THEN
      RETURN COPY type_name;
    END
    RETURN type_name.substr(1, (type_name.length() - 1));
}
END
PUB FN pipelineRangeLowerer__replace_zig_identifier(self: PipelineRangeLowerer, source: String, needle: String, replacement: String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (needle.length() == 0) THEN
      RETURN COPY source;
    END
    MUTABLE idx = 0;
    MUTABLE needle_len = needle.bytes();
    MUTABLE result = "";
    WHILE (idx < source.bytes()) DO
      IF (((source.byteslice(idx, needle_len) == needle) AND pipelineRangeLowerer__zig_identifier_boundary?(rtoc_self_view, source, (idx - 1))) AND pipelineRangeLowerer__zig_identifier_boundary?(rtoc_self_view, source, (idx + needle_len))) THEN
        &result.append(COPY replacement);
        idx = (idx + needle_len);
      ELSE
        &result.append(source.byteslice(idx, 1));
        idx = (idx + 1);
      END
    END
    RETURN result;
}
END
PUB FN pipelineRangeLowerer__zig_identifier_boundary?(self: PipelineRangeLowerer, source: String, idx: Int64) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF ((idx < 0) OR (idx >= source.bytes())) THEN
      RETURN TRUE;
    END
    MUTABLE byte = source.getbyte(idx);
    RETURN !(pipelineRangeLowerer__zig_identifier_byte?(rtoc_self_view, byte));
}
END
PUB FN pipelineRangeLowerer__zig_identifier_byte?(self: PipelineRangeLowerer, byte: Int64) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ((((((byte >= 65) AND (byte <= 90))) OR (((byte >= 97) AND (byte <= 122)))) OR (((byte >= 48) AND (byte <= 57)))) OR (byte == 95));
}
END
PUB FN pipelineRangeLowerer__new(host: Host) RETURNS PipelineRangeLowerer@multiowned ->
  MUTABLE self = PipelineRangeLowerer{ host: COPY host };
  pipelineRangeLowerer__initialize(&self, host);
  RETURN self @multiowned;
END
FN castEmittableToLocatable(value: Emittable) RETURNS Locatable ->
  PARTIAL MATCH value START
    Emittable.MIRProgram AS cast_payload -> RETURN Locatable{ MIRProgram: COPY cast_payload };,
    Emittable.MIRStructDef AS cast_payload -> RETURN Locatable{ MIRStructDef: COPY cast_payload };,
    Emittable.MIREnumDef AS cast_payload -> RETURN Locatable{ MIREnumDef: COPY cast_payload };,
    Emittable.MIRDestructureTarget AS cast_payload -> RETURN Locatable{ MIRDestructureTarget: COPY cast_payload };,
    Emittable.MIRDeferStmt AS cast_payload -> RETURN Locatable{ MIRDeferStmt: COPY cast_payload };,
    Emittable.MIRBgBlock AS cast_payload -> RETURN Locatable{ MIRBgBlock: COPY cast_payload };,
    Emittable.MIRDoBlock AS cast_payload -> RETURN Locatable{ MIRDoBlock: COPY cast_payload };,
    Emittable.MIRMethodCall AS cast_payload -> RETURN Locatable{ MIRMethodCall: COPY cast_payload };,
    Emittable.MIRUnaryOp AS cast_payload -> RETURN Locatable{ MIRUnaryOp: COPY cast_payload };,
    Emittable.MIRBlockExpr AS cast_payload -> RETURN Locatable{ MIRBlockExpr: COPY cast_payload };,
    Emittable.MIRCast AS cast_payload -> RETURN Locatable{ MIRCast: COPY cast_payload };,
    Emittable.MIROptionalUnwrap AS cast_payload -> RETURN Locatable{ MIROptionalUnwrap: COPY cast_payload };,
    Emittable.MIRRangeLit AS cast_payload -> RETURN Locatable{ MIRRangeLit: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Locatable");
  END
  panic("Invalid cast to Locatable");
END
FN ruby_array_concat_Emittable(left: []Emittable, right: []Emittable) RETURNS []Emittable ->
  MUTABLE result: []Emittable = [];
  left |> EACH { &result.append(COPY _); };
  right |> EACH { &result.append(COPY _); };
  RETURN result;
END
