PUB UNION PipelineLazyRangePrefixReturnValue { ForStmt: ForStmt, WhileStmt: WhileStmt }
PUB UNION PipelineDefaultObservableFoldOp { AllOpMultiowned: AllOp@multiowned, AnyOpMultiowned: AnyOp@multiowned, AverageOpMultiowned: AverageOp@multiowned, CountOpMultiowned: CountOp@multiowned, FindOpMultiowned: FindOp@multiowned, MaxOpMultiowned: MaxOp@multiowned, MinOpMultiowned: MinOp@multiowned, SumOpMultiowned: SumOp@multiowned, AllOp: AllOp, AnyOp: AnyOp, AverageOp: AverageOp, CountOp: CountOp, FindOp: FindOp, MaxOp: MaxOp, MinOp: MinOp, SumOp: SumOp }
PUB STRUCT PipelinePublishSpec {
  publish_method: String,
  expr: String@symbol,
  gate: String@symbol,
  transfers_item_on_success: Bool
}

PUB FN pipelinePublishSpec__from(raw: ObservablePublishSpec) RETURNS PipelinePublishSpec ->
  MUTABLE expr = COPY raw.expr;
  MUTABLE gate = COPY raw.gate;
  RETURN PipelinePublishSpec{ publish_method: COPY raw.publish_method, expr: COPY expr, gate: COPY gate, transfers_item_on_success: ((expr == :item) AND (gate == :pred)) };
END
PUB STRUCT PipelineRangeChain {
  source: Locatable,
  stages: []Locatable
}
PUB STRUCT PipelineLazyRangePrefix {
  range_mark: ?AllocMark,
  range_let: ?Let,
  source_name: String,
  outer_stmts: []Emittable,
  stage_stmts: []Emittable,
  item_var: String,
  initial_capture: String,
  item_used: Bool,
  elem_zig: String,
  next_method: String,
  item_type: ?Type,
  item_owned: Bool
}

PUB FN pipelineLazyRangePrefix__setup_stmts(self: PipelineLazyRangePrefix) RETURNS ![]Emittable ->
  MUTABLE stmts: []Emittable = List[];
  MUTABLE source_mark: ?AllocMark = COPY self.range_mark;
  IF source_mark EXISTS AS source_mark_value THEN
    &stmts.append(Emittable{ AllocMark: COPY source_mark_value });
  END
  MUTABLE source_setup: ?Let = COPY self.range_let;
  IF source_setup EXISTS AS source_setup_value THEN
    &stmts.append(Emittable{ Let: COPY source_setup_value });
  END
  stmts = ruby_array_concat_Emittable__pipeline_range_lowerer(stmts, self.outer_stmts);
  RETURN stmts;
END
PUB FN pipelineLazyRangePrefix__outer_setup_stmts(self: PipelineLazyRangePrefix) RETURNS ![]Emittable ->
  RETURN COPY self.outer_stmts;
END
PUB FN pipelineLazyRangePrefix__stage_body(self: PipelineLazyRangePrefix, body_stmts: []Emittable) RETURNS ![]Emittable ->
  RETURN (self.stage_stmts + body_stmts);
END
PUB FN pipelineLazyRangePrefix__next_call(self: PipelineLazyRangePrefix) RETURNS !MIRMethodCall ->
  RETURN MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: COPY self.source_name, lowered_node_id: NIL, ownership_consumption: NIL } }, method: COPY self.next_method, args: List[], try_wrap: TRUE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL };
END
PUB FN pipelineLazyRangePrefix__deinit_stmt(self: PipelineLazyRangePrefix) RETURNS !MIRDeferStmt ->
  RETURN MIRDeferStmt{ body: DeferBody{ Emittable: COPY CAST(COPY MIRMethodCall{ receiver: Emittable{ Ident: COPY Ident{ name: COPY self.source_name, lowered_node_id: NIL, ownership_consumption: NIL } }, method: "deinit", args: List[], try_wrap: FALSE, callable_contract: TRY (callableContract__no_ownership(0)), owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } AS Emittable) }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN castPipelineLazyRangePrefixReturnValueToEmittable__pipeline_range_lowerer(value: PipelineLazyRangePrefixReturnValue) RETURNS Emittable ->
  PARTIAL MATCH value START
    PipelineLazyRangePrefixReturnValue.ForStmt AS item -> RETURN Emittable{ ForStmt: COPY item };,
    PipelineLazyRangePrefixReturnValue.WhileStmt AS item -> RETURN Emittable{ WhileStmt: COPY item };,
    DEFAULT -> RETURN panic("unreachable loop statement variant");
  END
  RETURN panic("unreachable loop statement variant");
END
PUB FN pipelineLazyRangePrefix__loop_stmt(self: PipelineLazyRangePrefix, iter: ?Emittable, body_stmts: []Emittable, capture_name: ?String = self.initial_capture) RETURNS !PipelineLazyRangePrefixReturnValue ->
  MUTABLE body = TRY (pipelineLazyRangePrefix__stage_body(self, body_stmts));
  IF iter EXISTS AS iter_value THEN
    RETURN PipelineLazyRangePrefixReturnValue{ ForStmt: COPY ForStmt{ iter: COPY iter_value, capture: COPY capture_name, body: body, index_capture: NIL, mark_per_iter: NIL, tight: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
  ELSE
    RETURN PipelineLazyRangePrefixReturnValue{ WhileStmt: COPY WhileStmt{ cond: Emittable{ MIRMethodCall: COPY TRY (pipelineLazyRangePrefix__next_call(self)) }, body: body, capture: capture_name?, update: NIL, mark_per_iter: NIL, tight: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } };
  END
END
PUB STRUCT PipelineRangeFoldNames {
  acc: String,
  cnt: String,
  sum: String,
  val: String,
  found: String,
  result: String
}

PUB FN pipelineRangeFoldNames__for_label(label: String, bc_target: Bool) RETURNS PipelineRangeFoldNames ->
  MUTABLE suffix: String = "";
  IF bc_target THEN
    suffix = "_${compilerRegexReplaceFirst(label, compilerRegexCompile("__pblk"), "b")}";
  ELSE
    suffix = "";
  END
  RETURN PipelineRangeFoldNames{ acc: "__fold_acc${suffix}", cnt: "__fold_cnt${suffix}", sum: "__fold_sum${suffix}", val: "__fold_val${suffix}", found: "__fold_found${suffix}", result: "__fold_result${suffix}" };
END
