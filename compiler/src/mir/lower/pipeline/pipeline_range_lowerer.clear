PUB FN pipelineRangeLowerer__lower_range_fold_observable_default(self: PipelineRangeLowerer, p: PipelineLazyRangePrefix, fold_op: PipelineDefaultObservableFoldOp, MUTABLE smooth_node: BinaryOp, label: String, source_node: Locatable, terminal: String@symbol, observable_id: ?Int64 = NIL) RETURNS !MIRBlockExpr
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE spec = COPY (TRY (type__observable_terminals())).each_with_object({}, %(tuple_param_0, h) -> {
    MUTABLE sym = tuple_param_0._0;
    MUTABLE entry = tuple_param_0._1;
    IF entry.publish() THEN
      h[sym] = pipelinePublishSpec__from(entry.publish());
      RETURN NIL;
    END
    NIL
    })[terminal]?;
    MUTABLE item = COPY p.item_var;
    MUTABLE inner_recv = FieldGet{ object: Emittable{ Ident: COPY Ident{ name: "__obs_acc", lowered_node_id: NIL, ownership_consumption: NIL } }, field: "inner", lowered_node_id: NIL, ownership_consumption: NIL };
    MUTABLE fid = (observable_id OR_ELSE rtoc_self_view.host.range_next_observable_id());
    MUTABLE arg = rtoc_self_view.host.range_with_fiber_rt("__rt_obs_${fid}", %() USE(fold_op, item, MUTABLE smooth_node, spec, rtoc_self_view) -> {
    IF (spec.expr == :typed) THEN
        MUTABLE inner_zig = rtoc_self_view.host.range_transpile_type(PipelineRangeTypeInput{ TypeMultiowned: COPY TRY (type__tense_type((&smooth_node.full_type_mut()))) });
        [TRY (pipelineRangeLowerer__numeric_fold_expr_typed(rtoc_self_view, (MATCH fold_op START PipelineDefaultObservableFoldOp.AllOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.AnyOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.AverageOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.CountOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.FindOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.MaxOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.MinOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.SumOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.AllOp AS item -> item.expression, PipelineDefaultObservableFoldOp.AnyOp AS item -> item.expression, PipelineDefaultObservableFoldOp.AverageOp AS item -> item.expression, PipelineDefaultObservableFoldOp.CountOp AS item -> item.expression, PipelineDefaultObservableFoldOp.FindOp AS item -> item.expression, PipelineDefaultObservableFoldOp.MaxOp AS item -> item.expression, PipelineDefaultObservableFoldOp.MinOp AS item -> item.expression, PipelineDefaultObservableFoldOp.SumOp AS item -> item.expression END), item, inner_zig))];
    ELSE_IF (spec.expr == :f64) THEN
        [TRY (pipelineRangeLowerer__numeric_fold_expr_typed(rtoc_self_view, (MATCH fold_op START PipelineDefaultObservableFoldOp.AllOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.AnyOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.AverageOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.CountOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.FindOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.MaxOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.MinOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.SumOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.AllOp AS item -> item.expression, PipelineDefaultObservableFoldOp.AnyOp AS item -> item.expression, PipelineDefaultObservableFoldOp.AverageOp AS item -> item.expression, PipelineDefaultObservableFoldOp.CountOp AS item -> item.expression, PipelineDefaultObservableFoldOp.FindOp AS item -> item.expression, PipelineDefaultObservableFoldOp.MaxOp AS item -> item.expression, PipelineDefaultObservableFoldOp.MinOp AS item -> item.expression, PipelineDefaultObservableFoldOp.SumOp AS item -> item.expression END), item, "f64"))];
    ELSE_IF (spec.expr == :pred) THEN
        [rtoc_self_view.host.range_visit_mir_with_context((MATCH fold_op START PipelineDefaultObservableFoldOp.AllOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.AnyOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.AverageOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.CountOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.FindOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.MaxOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.MinOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.SumOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.AllOp AS item -> item.expression, PipelineDefaultObservableFoldOp.AnyOp AS item -> item.expression, PipelineDefaultObservableFoldOp.AverageOp AS item -> item.expression, PipelineDefaultObservableFoldOp.CountOp AS item -> item.expression, PipelineDefaultObservableFoldOp.FindOp AS item -> item.expression, PipelineDefaultObservableFoldOp.MaxOp AS item -> item.expression, PipelineDefaultObservableFoldOp.MinOp AS item -> item.expression, PipelineDefaultObservableFoldOp.SumOp AS item -> item.expression END), item)];
    ELSE_IF (spec.expr == :item) THEN
        [Ident{ name: COPY item, lowered_node_id: NIL, ownership_consumption: NIL }];
    ELSE_IF (spec.expr == :none) THEN
        List[];
    ELSE
        panic("unsupported observable publish expr {}");
    END
    NIL
    });
    MUTABLE published_item_type_branch_value: ?Type = NIL;
    IF p.item_owned THEN
      published_item_type_branch_value = COPY p.item_type;
    ELSE
      published_item_type_branch_value = NIL;
    END
    MUTABLE published_item_type: ?Type = published_item_type_branch_value;
    MUTABLE callable_contract_branch_value: ?CallableContract = NIL;
    IF (spec.transfers_item_on_success AND (published_item_type != NIL)) THEN
      callable_contract_branch_value = callableContract__new(TRY (functionSignature__new([Param{ name: "item", type: UNWRAP (COPY published_item_type), takes: TRUE, default: NIL, mutable: NIL, comptime: NIL, name_token: NIL, required: NIL, sync: NIL, symbol: NIL, carrier_contract: NIL }], TypeTypeInput{ Type: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :Void })) }, NIL, NIL, ( { MUTABLE rtoc_empty_list_28: []String@symbol = List[]; rtoc_empty_list_28 } ), {}, FALSE, FALSE, NIL, NIL, NIL, ( { MUTABLE rtoc_empty_list_29: []String@symbol = List[]; rtoc_empty_list_29 } ), NIL, ( { MUTABLE rtoc_empty_list_30: []String@symbol = List[]; rtoc_empty_list_30 } ))), TRY (ownershipContract__consume_operands([ownershipOperandFact__owned_binding(item, UNWRAP (published_item_type), "observable publish item", :heap)])), 1);
    ELSE
      callable_contract_branch_value = TRY (callableContract__no_ownership(arg.length()));
    END
    MUTABLE callable_contract: CallableContract = callable_contract_branch_value?;
    MUTABLE call = ExprStmt{ expr: Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: inner_recv, method: COPY spec.publish_method, args: COPY arg, try_wrap: FALSE, callable_contract: COPY callable_contract, owned_result_alloc: NIL, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } }, discard: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
    MUTABLE publish = PARTIAL MATCH spec.gate START
      :always -> [call],
      :pred -> {
        MUTABLE rtoc_value_block_marker = 0;
        MUTABLE pred_mir = rtoc_self_view.host.range_with_fiber_rt("__rt_obs_${fid}", %() USE(fold_op, item, rtoc_self_view) -> rtoc_self_view.host.range_visit_mir_with_context((MATCH fold_op START PipelineDefaultObservableFoldOp.AllOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.AnyOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.AverageOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.CountOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.FindOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.MaxOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.MinOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.SumOpMultiowned AS item -> item.expression, PipelineDefaultObservableFoldOp.AllOp AS item -> item.expression, PipelineDefaultObservableFoldOp.AnyOp AS item -> item.expression, PipelineDefaultObservableFoldOp.AverageOp AS item -> item.expression, PipelineDefaultObservableFoldOp.CountOp AS item -> item.expression, PipelineDefaultObservableFoldOp.FindOp AS item -> item.expression, PipelineDefaultObservableFoldOp.MaxOp AS item -> item.expression, PipelineDefaultObservableFoldOp.MinOp AS item -> item.expression, PipelineDefaultObservableFoldOp.SumOp AS item -> item.expression END), item));
        (IF (spec.transfers_item_on_success AND (published_item_type != NIL)) THEN
          [IfStmt{ cond: COPY pred_mir, then_body: (TRY (ownershipTransferPlan__marks((OwnershipTransferPlan{ name: COPY item, target: :call, target_alloc: :heap, move_guarded: TRUE }))) + [call]), else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL }]
        ELSE
          [IfStmt{ cond: COPY pred_mir, then_body: [call], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL }]
        END)
      },
      DEFAULT -> panic("unsupported observable publish gate {}")
    END;
    RETURN TRY (pipelineRangeLowerer__lower_range_fold_observable(rtoc_self_view, p, smooth_node, label, source_node, Emittable{ TryCatch: COPY TRY (pipelineRangeLowerer__default_obs_alloc_expr(rtoc_self_view, &smooth_node)) }, publish, fid));
}
END
PUB FN pipelineRangeLowerer__pipeline_element_owns_heap?(self: PipelineRangeLowerer, type_info: Type) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (((TRY (type__string?(type_info)) OR TRY (type__heap_ptr?(type_info))) OR TRY (type__recursive_cleanup_shape?(type_info, rtoc_self_view.host.range_schema_lookup()))) OR TRY (type__needs_explicit_cleanup?(type_info, :heap, rtoc_self_view.host.range_schema_lookup())));
}
END
PUB FN pipelineRangeLowerer__bc_loop_iter(self: PipelineRangeLowerer, range_lit: Locatable, source_ti: Type, capture_name: ?String) RETURNS !?PipelineRangeLoopIter
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(rtoc_self_view.host.range_bc_target?()) THEN
      RETURN NIL;
    END
    IF range_lit IS_A RangeLit THEN
      MUTABLE iter, cap = pipelineRangeLowerer__bc_for_iter_range(rtoc_self_view, range_lit, capture_name);
      RETURN PipelineRangeLoopIter{ iter: Emittable{ IterRange: COPY iter }, capture_name: COPY cap };
    END
    IF range_lit IS_A Identifier AS identifier THEN
    IF TRY (type__runtime_stream?(source_ti)) THEN
        RETURN PipelineRangeLoopIter{ iter: COPY rtoc_self_view.host.range_visit_mir(Locatable{ Identifier: COPY identifier }), capture_name: COPY capture_name };
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PUB FN pipelineRangeLowerer__owned_stream_item_stmts(self: PipelineRangeLowerer, item_var: String, elem_t: ?Type) RETURNS ![]Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF elem_t EXISTS AS elem_t_value THEN
      MUTABLE elem_t_value_mutable = COPY elem_t_value;
      IF pipelineRangeLowerer__pipeline_element_owns_heap?(rtoc_self_view, elem_t_value_mutable) THEN
        MUTABLE entry: ?CleanupEntry@multiowned = TRY (cleanupClassifier__owned_value_entry(elem_t_value_mutable, rtoc_self_view.host.range_schema_lookup()));
        IF !((IF entry != NIL THEN
          cleanupEntry__needs_cleanup?(entry)
        ELSE
          NIL
        END)) THEN
          RETURN CAST(( { MUTABLE rtoc_empty_list_32: []Emittable = List[]; rtoc_empty_list_32 } ) AS []Emittable);
        END
        entry = cleanupEntry__with_alloc(entry, :heap);
        cleanupEntry__mark_moved_guard_mut(&entry);
        RETURN CAST([Emittable{ AllocMark: COPY AllocMark{ name: COPY item_var, alloc: :heap, type_info: COPY elem_t_value_mutable, scope: :heap, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }, Emittable{ Cleanup: COPY Cleanup{ name: COPY item_var, cleanup_entry: entry, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable);
      ELSE
        RETURN CAST(( { MUTABLE rtoc_empty_list_31: []Emittable = List[]; rtoc_empty_list_31 } ) AS []Emittable);
      END
    ELSE
      RETURN CAST(( { MUTABLE rtoc_empty_list_33: []Emittable = List[]; rtoc_empty_list_33 } ) AS []Emittable);
    END
}
END
PUB FN pipelineRangeLowerer__lower_range_reduce_observable(self: PipelineRangeLowerer, p: PipelineLazyRangePrefix, reduce_op: ReduceOp, MUTABLE smooth_node: BinaryOp, label: String, source_node: Locatable) RETURNS !MIRBlockExpr
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE inner_zig = rtoc_self_view.host.range_transpile_type(PipelineRangeTypeInput{ TypeMultiowned: COPY TRY (type__tense_type((&smooth_node.full_type_mut()))) });
    MUTABLE init_mir = rtoc_self_view.host.range_visit_mir(reduce_op.initial_value);
