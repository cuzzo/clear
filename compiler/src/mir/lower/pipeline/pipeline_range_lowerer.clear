PUB STRUCT RuntimeHost {
  ast_stmts_use_placeholder: FN(Locatable[]) -> Bool,
  bc_target: FN() -> Bool,
  lower_head_with_context: FN(Locatable, ?String) -> PipelineLowerHeadResult,
  next_label: FN() -> String,
  next_observable_id: FN() -> Int64,
  runtime_name: FN() -> String,
  schema_lookup: FN() -> FN(String@symbol) -> ?TypeSchemaLookupResult,
  task_config_variant: FN() -> String,
  transpile_type: FN(PipelineTypeInput) -> String,
  visit_mir: FN(Locatable) -> Emittable,
  visit_mir_with_context: FN(Locatable, ?String, ?String) -> Emittable,
  visit_mir_with_decl_alloc: FN(Locatable, String@symbol) -> Emittable,
  visit_pipeline_body_mir: FN(Locatable[], String) -> ![]Emittable,
  with_fiber_rt: FN(String, FN() -> Any@multiowned) -> Any@multiowned
}

PUB FN runtimeHost__initialize(MUTABLE self: RuntimeHost, visit_mir: FN(Locatable) -> Emittable, visit_mir_with_decl_alloc: FN(Locatable, String@symbol) -> Emittable, visit_mir_with_context: FN(Locatable, ?String, ?String) -> Emittable, lower_head_with_context: FN(Locatable, ?String) -> PipelineLowerHeadResult, with_fiber_rt: FN(String, FN() -> Any) -> Any, visit_pipeline_body_mir: FN(Locatable[], String) -> ![]Emittable, ast_stmts_use_placeholder: FN(Locatable[]) -> Bool, bc_target: FN() -> Bool, next_label: FN() -> String, transpile_type: FN(PipelineTypeInput) -> String, schema_lookup: FN() -> FN(String@symbol) -> ?TypeSchemaLookupResult, runtime_name: FN() -> String, next_observable_id: FN() -> Int64, task_config_variant: FN() -> String) RETURNS Void ->
    self.visit_mir = COPY visit_mir;
    self.visit_mir_with_decl_alloc = COPY visit_mir_with_decl_alloc;
    self.visit_mir_with_context = COPY visit_mir_with_context;
    self.lower_head_with_context = COPY lower_head_with_context;
    self.with_fiber_rt = COPY with_fiber_rt;
    self.visit_pipeline_body_mir = COPY visit_pipeline_body_mir;
    self.ast_stmts_use_placeholder = COPY ast_stmts_use_placeholder;
    self.bc_target = COPY bc_target;
    self.next_label = COPY next_label;
    self.transpile_type = COPY transpile_type;
    self.schema_lookup = COPY schema_lookup;
    self.runtime_name = COPY runtime_name;
    self.next_observable_id = COPY next_observable_id;
    self.task_config_variant = COPY task_config_variant;
END
