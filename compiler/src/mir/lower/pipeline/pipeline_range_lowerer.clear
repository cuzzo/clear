# Ruby asks `respond_to?(:expression)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PRIVATE FN pipelineRangeLowerer__fold_op_observable_terminal(fold_op: PipelineDefaultObservableFoldOp) RETURNS ?String@symbol ->
  PARTIAL MATCH fold_op START
    PipelineDefaultObservableFoldOp.AllOpMultiowned -> RETURN :all;,
    PipelineDefaultObservableFoldOp.AnyOpMultiowned -> RETURN :any;,
    PipelineDefaultObservableFoldOp.AverageOpMultiowned -> RETURN :avg;,
    PipelineDefaultObservableFoldOp.CountOpMultiowned -> RETURN :count;,
    PipelineDefaultObservableFoldOp.FindOpMultiowned -> RETURN :find;,
    PipelineDefaultObservableFoldOp.MaxOpMultiowned -> RETURN :max;,
    PipelineDefaultObservableFoldOp.MinOpMultiowned -> RETURN :min;,
    PipelineDefaultObservableFoldOp.SumOpMultiowned -> RETURN :sum;,
    PipelineDefaultObservableFoldOp.AllOp -> RETURN :all;,
    PipelineDefaultObservableFoldOp.AnyOp -> RETURN :any;,
    PipelineDefaultObservableFoldOp.AverageOp -> RETURN :avg;,
    PipelineDefaultObservableFoldOp.CountOp -> RETURN :count;,
    PipelineDefaultObservableFoldOp.FindOp -> RETURN :find;,
    PipelineDefaultObservableFoldOp.MaxOp -> RETURN :max;,
    PipelineDefaultObservableFoldOp.MinOp -> RETURN :min;,
    PipelineDefaultObservableFoldOp.SumOp -> RETURN :sum;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
PUB FN pipelineDefaultObservableFoldOp__expression(value: PipelineDefaultObservableFoldOp) RETURNS ?Locatable@boxed ->
  PARTIAL MATCH value START
    PipelineDefaultObservableFoldOp.AllOpMultiowned AS item -> RETURN COPY item.expression;,
    PipelineDefaultObservableFoldOp.AnyOpMultiowned AS item -> RETURN COPY item.expression;,
    PipelineDefaultObservableFoldOp.AverageOpMultiowned AS item -> RETURN COPY item.expression;,
    PipelineDefaultObservableFoldOp.CountOpMultiowned AS item -> RETURN COPY item.expression;,
    PipelineDefaultObservableFoldOp.FindOpMultiowned AS item -> RETURN COPY item.expression;,
    PipelineDefaultObservableFoldOp.MaxOpMultiowned AS item -> RETURN COPY item.expression;,
    PipelineDefaultObservableFoldOp.MinOpMultiowned AS item -> RETURN COPY item.expression;,
    PipelineDefaultObservableFoldOp.SumOpMultiowned AS item -> RETURN COPY item.expression;,
    PipelineDefaultObservableFoldOp.AllOp AS item -> RETURN COPY item.expression;,
    PipelineDefaultObservableFoldOp.AnyOp AS item -> RETURN COPY item.expression;,
    PipelineDefaultObservableFoldOp.AverageOp AS item -> RETURN COPY item.expression;,
    PipelineDefaultObservableFoldOp.CountOp AS item -> RETURN COPY item.expression;,
    PipelineDefaultObservableFoldOp.FindOp AS item -> RETURN COPY item.expression;,
    PipelineDefaultObservableFoldOp.MaxOp AS item -> RETURN COPY item.expression;,
    PipelineDefaultObservableFoldOp.MinOp AS item -> RETURN COPY item.expression;,
    PipelineDefaultObservableFoldOp.SumOp AS item -> RETURN COPY item.expression;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
