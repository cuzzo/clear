PUB FN pipelinePlaceholderUsage__statements_use_placeholder?(stmts: []Locatable) RETURNS Bool ->
  RETURN stmts |> ANY pipelinePlaceholderUsage__contains_placeholder?(_, FALSE);
END
PUB FN pipelinePlaceholderUsage__node_uses_placeholder?(node: ?Locatable) RETURNS Bool ->
  IF node EXISTS AS node_value THEN
    RETURN pipelinePlaceholderUsage__contains_placeholder?(node_value, FALSE);
  ELSE
    RETURN FALSE;
  END
END
PUB FN pipelinePlaceholderUsage__node_uses_bare_placeholder?(node: ?Locatable) RETURNS Bool ->
  IF node EXISTS AS node_value THEN
    RETURN pipelinePlaceholderUsage__contains_placeholder?(node_value, TRUE);
  ELSE
    RETURN FALSE;
  END
END
PUB FN pipelinePlaceholderUsage__identity_placeholder?(node: ?Locatable) RETURNS Bool ->
  IF node EXISTS AS node_value THEN
    RETURN (IF node_value IS_A Identifier AS identifier THEN pipelinePlaceholderUsage__placeholder_identifier?(Locatable{ Identifier: COPY identifier }) ELSE FALSE END);
  ELSE
    RETURN FALSE;
  END
END
PUB FN pipelinePlaceholderUsage__placeholder_projection?(node: ?Locatable) RETURNS Bool EFFECTS REENTRANT ->
  IF node EXISTS AS node_value THEN
    IF node_value IS_A GetField AS get_field THEN
      MUTABLE target: ?Locatable = castLocatableToOptionalLocatable(get_field.target);
      RETURN (((IF target? IS_A Identifier AS identifier THEN (identifier__name(identifier) == "_") ELSE FALSE END)) OR pipelinePlaceholderUsage__placeholder_projection?(target));
    ELSE_IF node_value IS_A GetIndex AS get_index THEN
      MUTABLE target: ?Locatable = castLocatableToOptionalLocatable(get_index.target);
      RETURN (((IF target? IS_A Identifier AS identifier THEN (identifier__name(identifier) == "_") ELSE FALSE END)) OR pipelinePlaceholderUsage__placeholder_projection?(target));
    ELSE
      RETURN FALSE;
    END
  ELSE
    RETURN FALSE;
  END
END
PUB FN pipelinePlaceholderUsage__moved_placeholder?(node: ?Locatable) RETURNS Bool EFFECTS REENTRANT ->
  IF node EXISTS AS node_value THEN
    IF pipelinePlaceholderUsage__placeholder_identifier?(node_value) THEN
      RETURN aST__moved?(node_value);
    END
    IF node_value IS_A MoveNode AS move_node THEN
      RETURN pipelinePlaceholderUsage__contains_placeholder?(Locatable{ MoveNode: COPY move_node }, FALSE);
    END
    MUTABLE found: Bool = FALSE;
    aST__each_child_node(node_value, %(child: Locatable) -> {
  IF pipelinePlaceholderUsage__moved_placeholder?(child) THEN
        found = TRUE;
  END
  rubyToClearVoid()
    });
    RETURN found;
  ELSE
    RETURN FALSE;
  END
END
PRIVATE FN pipelinePlaceholderUsage__contains_placeholder?(node: ?Locatable, bare: Bool) RETURNS Bool EFFECTS REENTRANT ->
  IF node EXISTS AS node_value THEN
    IF (bare AND aST__soa_placeholder_field?(node_value)) THEN
      RETURN FALSE;
    END
    IF pipelinePlaceholderUsage__placeholder_identifier?(node_value) THEN
      RETURN TRUE;
    END
    MUTABLE found: Bool = FALSE;
    aST__each_child_node(node_value, %(child: Locatable) USE(bare) -> {
  IF pipelinePlaceholderUsage__contains_placeholder?(child, bare) THEN
        found = TRUE;
  END
  rubyToClearVoid()
    });
    RETURN found;
  ELSE
    RETURN FALSE;
  END
END
PRIVATE FN pipelinePlaceholderUsage__placeholder_identifier?(node: Locatable) RETURNS Bool ->
  RETURN (IF node IS_A Identifier AS identifier THEN (identifier__name(identifier) == "_") ELSE FALSE END);
END
