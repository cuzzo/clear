    IF (new_cond == node.condition) THEN
      RETURN COPY Locatable{ Assert: COPY node };
    END
    MUTABLE new_assert = Assert{ token: COPY node.token, condition: new_cond, message: node.message, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
    pipelinePlaceholderRewriter__copy_type_info(rtoc_self_view, PipelineRewriteNode{ Assert: COPY node }, PipelineRewriteNode{ Assert: COPY new_assert });
    RETURN Locatable{ Assert: COPY new_assert };
