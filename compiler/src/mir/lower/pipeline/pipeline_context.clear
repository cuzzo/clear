PRIVATE FN pipelinePlaceholderRewriter__soa_field_slice_type(self: PipelinePlaceholderRewriter, field_node: GetField) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE field_type: ?Type@multiowned = COPY field_node.type_object;
    IF field_type EXISTS AS field_type_value THEN
      MUTABLE concrete_type = field_type_value;
      IF type__untyped?(concrete_type) THEN
        panic("SOA field slice: unresolved annotated type");
      END
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("${type__resolved(concrete_type)}[]") }));
    ELSE
      panic("SOA field slice: missing annotated type");
    END
}
END
PUB FN pipelinePlaceholderRewriter__new(context: PipelineContextState) RETURNS PipelinePlaceholderRewriter@multiowned ->
  MUTABLE self = PipelinePlaceholderRewriter{ context: COPY context };
  pipelinePlaceholderRewriter__initialize(&self, context);
  RETURN self @multiowned;
END
