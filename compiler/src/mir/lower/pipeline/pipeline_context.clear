REQUIRE "pkg:rtoc_6173742f747970652e636c656172" AS type
REQUIRE "pkg:rtoc_6173742f6173742e636c656172" AS ast
REQUIRE "pkg:rtoc_73656d616e7469632f6361706162696c6974795f706c616e2e636c656172" AS capability_plan
PUB UNION Field { SymbolValue: String@symbol, StringValue: String }
PUB UNION PipelineSoaFieldSetItem { SymbolValue: String@symbol, StringValue: String }
PUB STRUCT PipelineContextState {
  placeholder_name: ?String,
  acc_placeholder: ?String,
  join_param_map: ?{String}String,
  named_bindings: {String}String,
  soa_each_mode: Bool,
  soa_rewrite_active: Bool,
  soa_needed_fields: [Set]PipelineSoaFieldSetItem
}

PUB FN pipelineContextState__empty() RETURNS PipelineContextState ->
  RETURN PipelineContextState{ placeholder_name: NIL, acc_placeholder: NIL, join_param_map: NIL, named_bindings: {}, soa_each_mode: FALSE, soa_rewrite_active: FALSE, soa_needed_fields: COPY Set[] };
END
PUB FN pipelineContextState__with_pipeline_values(self: PipelineContextState, placeholder: ?String, acc: ?String) RETURNS PipelineContextState ->
  RETURN PipelineContextState{ placeholder_name: COPY placeholder, acc_placeholder: COPY acc, join_param_map: COPY self.join_param_map, named_bindings: COPY self.named_bindings, soa_each_mode: self.soa_each_mode, soa_rewrite_active: self.soa_rewrite_active, soa_needed_fields: COPY self.soa_needed_fields };
END
PUB FN pipelineContextState__with_named_binding(self: PipelineContextState, clear_name: String, zig_var: String) RETURNS PipelineContextState ->
  RETURN PipelineContextState{ placeholder_name: COPY self.placeholder_name, acc_placeholder: COPY self.acc_placeholder, join_param_map: COPY self.join_param_map, named_bindings: COPY {clear_name: zig_var}.keys() |> REDUCE(COPY self.named_bindings) { acc[_] = COPY ({clear_name: zig_var}[_] OR_ELSE panic("missing hash key")); acc }, soa_each_mode: self.soa_each_mode, soa_rewrite_active: self.soa_rewrite_active, soa_needed_fields: COPY self.soa_needed_fields };
END
PUB FN pipelineContextState__with_join_params(self: PipelineContextState, join_params: ?{String}String) RETURNS PipelineContextState ->
  RETURN PipelineContextState{ placeholder_name: COPY self.placeholder_name, acc_placeholder: COPY self.acc_placeholder, join_param_map: COPY join_params, named_bindings: COPY self.named_bindings, soa_each_mode: self.soa_each_mode, soa_rewrite_active: self.soa_rewrite_active, soa_needed_fields: COPY self.soa_needed_fields };
END
PUB FN pipelineContextState__with_soa_rewrite(self: PipelineContextState, each_mode: Bool, fields: [Set]PipelineSoaFieldSetItem) RETURNS PipelineContextState ->
  RETURN PipelineContextState{ placeholder_name: COPY self.placeholder_name, acc_placeholder: COPY self.acc_placeholder, join_param_map: COPY self.join_param_map, named_bindings: COPY self.named_bindings, soa_each_mode: COPY each_mode, soa_rewrite_active: TRUE, soa_needed_fields: COPY fields };
END
PUB FN pipelineContextState__active?(self: PipelineContextState) RETURNS Bool ->
  IF !((self.placeholder_name == NIL)) THEN
    RETURN TRUE;
  END
  IF !((self.acc_placeholder == NIL)) THEN
    RETURN TRUE;
  END
  IF !((self.join_param_map == NIL)) THEN
    RETURN TRUE;
  END
  IF self.soa_each_mode THEN
    RETURN TRUE;
  END
  IF self.soa_rewrite_active THEN
    RETURN TRUE;
  END
  RETURN !((self.named_bindings.count() == 0));
END
PUB FN pipelineContextState__replacement_for_identifier(self: PipelineContextState, name: String) RETURNS ?String ->
  IF ((name == "_") AND (self.placeholder_name != NIL)) THEN
    RETURN COPY (self.placeholder_name)?;
  END
  IF ((name == "acc") AND (self.acc_placeholder != NIL)) THEN
    RETURN COPY (self.acc_placeholder)?;
  END
  MUTABLE map: ?{String}String = COPY self.join_param_map;
  IF map EXISTS AS map_value THEN
    MUTABLE joined: ?String = COPY map_value[name];
    IF joined EXISTS AS joined_value THEN
      RETURN COPY joined_value;
    END
  END
  RETURN COPY self.named_bindings[name];
END
PUB FN pipelineContextState__soa_each_field_node?(self: PipelineContextState, node: Locatable) RETURNS Bool ->
  IF !(self.soa_each_mode) THEN
    RETURN FALSE;
  END
  RETURN PARTIAL MATCH node START
    Locatable.GetField AS get_field -> pipelineContextState__placeholder_identifier?(self, get_field.target),
    DEFAULT -> FALSE
  END;
END
PUB FN pipelineContextState__soa_rewrite_field_node?(self: PipelineContextState, node: GetField) RETURNS Bool ->
  RETURN (self.soa_rewrite_active AND pipelineContextState__placeholder_identifier?(self, node.target));
END
PUB FN pipelineContextState__placeholder_identifier?(self: PipelineContextState, node: Locatable) RETURNS Bool ->
  RETURN PARTIAL MATCH node START
    Locatable.Identifier AS identifier -> (identifier__name(identifier) == "_"),
    DEFAULT -> FALSE
  END;
END
PUB FN pipelineContextState__record_soa_field(MUTABLE self: PipelineContextState, field: String) RETURNS Void ->
  &self.soa_needed_fields.insert(PipelineSoaFieldSetItem{ StringValue: COPY field });
END
PUB STRUCT PipelinePlaceholderRewriter {
  context: PipelineContextState
}

PUB FN pipelinePlaceholderRewriter__initialize(MUTABLE self: PipelinePlaceholderRewriter, context: PipelineContextState) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.context = COPY context;
}
END
PUB FN pipelinePlaceholderRewriter__substitute(MUTABLE self: PipelinePlaceholderRewriter, MUTABLE node: Locatable) RETURNS !Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(pipelineContextState__active?(rtoc_self_view.context)) THEN
      RETURN COPY node;
    END
    IF pipelinePlaceholderRewriter__soa_each_field?(rtoc_self_view, node) THEN
      RETURN Locatable{ Identifier: COPY pipelinePlaceholderRewriter__soa_each_field(&rtoc_self_view, castLocatableToGetField(node)) };
    END
    IF node IS_A Identifier AS identifier THEN
      RETURN pipelinePlaceholderRewriter__substitute_identifier(rtoc_self_view, identifier);
    ELSE_IF node IS_A FuncCall AS func_call THEN
      MUTABLE func_call_mutable = COPY func_call;
      RETURN TRY (pipelinePlaceholderRewriter__substitute_func_call(&rtoc_self_view, func_call_mutable));
    ELSE_IF node IS_A MethodCall AS method_call THEN
      MUTABLE method_call_mutable = COPY method_call;
      RETURN TRY (pipelinePlaceholderRewriter__substitute_method_call(&rtoc_self_view, method_call_mutable));
    ELSE_IF node IS_A BinaryOp AS binary_op THEN
      MUTABLE binary_op_mutable = COPY binary_op;
      RETURN TRY (pipelinePlaceholderRewriter__substitute_binary_op(&rtoc_self_view, binary_op_mutable));
    ELSE_IF node IS_A GetField AS get_field THEN
      MUTABLE get_field_mutable = COPY get_field;
      RETURN TRY (pipelinePlaceholderRewriter__substitute_get_field(&rtoc_self_view, get_field_mutable));
    ELSE_IF node IS_A GetIndex AS get_index THEN
      MUTABLE get_index_mutable = COPY get_index;
      RETURN TRY (pipelinePlaceholderRewriter__substitute_get_index(&rtoc_self_view, get_index_mutable));
    ELSE_IF node IS_A VarDecl AS var_decl THEN
      MUTABLE var_decl_mutable = COPY var_decl;
      RETURN TRY (pipelinePlaceholderRewriter__substitute_var_decl(&rtoc_self_view, &var_decl_mutable));
    ELSE_IF node IS_A BindExpr AS bind_expr THEN
      MUTABLE bind_expr_mutable = COPY bind_expr;
      RETURN TRY (pipelinePlaceholderRewriter__substitute_bind_expr(&rtoc_self_view, bind_expr_mutable));
    ELSE_IF node IS_A Assignment AS assignment THEN
      MUTABLE assignment_mutable = COPY assignment;
      RETURN TRY (pipelinePlaceholderRewriter__substitute_assignment(&rtoc_self_view, assignment_mutable));
    ELSE_IF (node IS_A UnaryOp) THEN
      IF node IS_A UnaryOp AS unary_op THEN
        MUTABLE unary_op_mutable = COPY unary_op;
        RETURN TRY (pipelinePlaceholderRewriter__substitute_unary_op(&rtoc_self_view, unary_op_mutable));
      END
      RETURN COPY node;
    ELSE_IF (node IS_A OptionalUnwrap) THEN
      IF node IS_A OptionalUnwrap AS optional_unwrap THEN
        MUTABLE optional_unwrap_mutable = COPY optional_unwrap;
        RETURN TRY (pipelinePlaceholderRewriter__substitute_optional_unwrap(&rtoc_self_view, optional_unwrap_mutable));
      END
      RETURN COPY node;
    ELSE_IF node IS_A IsA AS is_a THEN
      MUTABLE is_a_mutable = COPY is_a;
      RETURN TRY (pipelinePlaceholderRewriter__substitute_is_a(&rtoc_self_view, &is_a_mutable));
    ELSE_IF node IS_A CopyNode AS copy_node THEN
      MUTABLE copy_node_mutable = COPY copy_node;
      RETURN TRY (pipelinePlaceholderRewriter__substitute_value_wrapper(&rtoc_self_view, Node{ CopyNode: COPY copy_node_mutable }));
    ELSE_IF node IS_A MoveNode AS move_node THEN
      MUTABLE move_node_mutable = COPY move_node;
      RETURN TRY (pipelinePlaceholderRewriter__substitute_value_wrapper(&rtoc_self_view, Node{ MoveNode: COPY move_node_mutable }));
    ELSE_IF node IS_A KeepNode AS keep_node THEN
      MUTABLE keep_node_mutable = COPY keep_node;
      RETURN TRY (pipelinePlaceholderRewriter__substitute_value_wrapper(&rtoc_self_view, Node{ KeepNode: COPY keep_node_mutable }));
    ELSE_IF node IS_A ShareNode AS share_node THEN
      MUTABLE share_node_mutable = COPY share_node;
      RETURN TRY (pipelinePlaceholderRewriter__substitute_value_wrapper(&rtoc_self_view, Node{ ShareNode: COPY share_node_mutable }));
    ELSE_IF node IS_A WithBlock AS with_block THEN
      MUTABLE with_block_mutable = COPY with_block;
      RETURN TRY (pipelinePlaceholderRewriter__substitute_with_block(&rtoc_self_view, with_block_mutable));
    ELSE_IF node IS_A StructLit AS struct_lit THEN
      MUTABLE struct_lit_mutable = COPY struct_lit;
      RETURN TRY (pipelinePlaceholderRewriter__substitute_struct_lit(&rtoc_self_view, struct_lit_mutable));
    ELSE_IF node IS_A HashLit AS hash_lit THEN
      MUTABLE hash_lit_mutable = COPY hash_lit;
      RETURN TRY (pipelinePlaceholderRewriter__substitute_hash_lit(&rtoc_self_view, hash_lit_mutable));
    ELSE_IF node IS_A ListLit AS list_lit THEN
      MUTABLE list_lit_mutable = COPY list_lit;
      RETURN TRY (pipelinePlaceholderRewriter__substitute_list_lit(&rtoc_self_view, list_lit_mutable));
    ELSE_IF node IS_A TupleLit AS tuple_lit THEN
      MUTABLE tuple_lit_mutable = COPY tuple_lit;
      RETURN TRY (pipelinePlaceholderRewriter__substitute_tuple_lit(&rtoc_self_view, tuple_lit_mutable));
    ELSE_IF (node IS_A Cast) THEN
      IF node IS_A Cast AS cast_node THEN
        MUTABLE cast_node_mutable = COPY cast_node;
        RETURN TRY (pipelinePlaceholderRewriter__substitute_cast(&rtoc_self_view, cast_node_mutable));
      END
      RETURN COPY node;
    ELSE_IF (node IS_A BlockExpr) THEN
      IF node IS_A BlockExpr AS block_expr THEN
        MUTABLE block_expr_mutable = COPY block_expr;
        RETURN TRY (pipelinePlaceholderRewriter__substitute_block_expr(&rtoc_self_view, block_expr_mutable));
      END
      RETURN COPY node;
    ELSE_IF node IS_A Assert AS assert THEN
      MUTABLE assert_mutable = COPY assert;
      RETURN TRY (pipelinePlaceholderRewriter__substitute_assert(&rtoc_self_view, assert_mutable));
    ELSE_IF node IS_A IfStatement AS if_statement THEN
      MUTABLE if_statement_mutable = COPY if_statement;
      RETURN TRY (pipelinePlaceholderRewriter__substitute_if_statement(&rtoc_self_view, if_statement_mutable));
    ELSE
      RETURN COPY node;
    END
}
END
PRIVATE FN pipelinePlaceholderRewriter__soa_each_field?(self: PipelinePlaceholderRewriter, node: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN pipelineContextState__soa_each_field_node?(rtoc_self_view.context, node);
}
END
PRIVATE FN pipelinePlaceholderRewriter__soa_each_field(MUTABLE self: PipelinePlaceholderRewriter, node: GetField) RETURNS Identifier
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    pipelineContextState__record_soa_field(&rtoc_self_view.context, node.field);
    MUTABLE new_id = Identifier{ token: COPY node.token, name: "__soa_${node.field}[__soa_i]", can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, fn_ref: NIL, heap_dupe_result: NIL, atomic_borrow: NIL, ownership_pending_transfer: NIL };
    pipelinePlaceholderRewriter__copy_type_info(rtoc_self_view, PipelineRewriteNode{ GetField: COPY node }, PipelineRewriteNode{ Identifier: COPY new_id });
    RETURN new_id;
}
END
PRIVATE FN pipelinePlaceholderRewriter__substitute_identifier(self: PipelinePlaceholderRewriter, node: Identifier) RETURNS Locatable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE replacement: ?String = pipelineContextState__replacement_for_identifier(rtoc_self_view.context, node.name);
    IF replacement EXISTS AS replacement_value THEN
      MUTABLE replacement_value_mutable = COPY replacement_value;
      MUTABLE new_id = Identifier{ token: COPY node.token, name: COPY replacement_value_mutable, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, fn_ref: NIL, heap_dupe_result: NIL, atomic_borrow: NIL, ownership_pending_transfer: NIL };
      pipelinePlaceholderRewriter__copy_type_info(rtoc_self_view, PipelineRewriteNode{ Identifier: COPY node }, PipelineRewriteNode{ Identifier: COPY new_id });
      RETURN Locatable{ Identifier: COPY new_id };
    ELSE
      RETURN COPY Locatable{ Identifier: COPY node };
    END
}
END
PRIVATE FN pipelinePlaceholderRewriter__substitute_func_call(MUTABLE self: PipelinePlaceholderRewriter, node: FuncCall) RETURNS !Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE new_args = node.args |> SELECT TRY (pipelinePlaceholderRewriter__substitute(&rtoc_self_view, COPY _));
    IF (new_args == node.args) THEN
      RETURN COPY Locatable{ FuncCall: COPY node };
    END
    MUTABLE new_call = FuncCall{ token: COPY node.token, name: node.name, args: COPY new_args, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, explicit_mutable_argument_tokens: NIL, module_alias: NIL, extern_call: NIL, extern_effects: NIL, extern_source: NIL, generic_type_args: NIL, fn_var_call: NIL, pipe_lhs: NIL, heap_dupe_result: NIL, arg_families: NIL, collapsed_errors: NIL, error_union_type: NIL, protocol_name: NIL, protocol_operation: NIL, protocol_receiver_index: NIL, retain_error_channel: NIL };
    pipelinePlaceholderRewriter__copy_type_info(rtoc_self_view, PipelineRewriteNode{ FuncCall: COPY node }, PipelineRewriteNode{ FuncCall: COPY new_call });
    pipelinePlaceholderRewriter__copy_call_metadata(rtoc_self_view, PipelineRewriteNode{ FuncCall: COPY node }, PipelineRewriteNode{ FuncCall: COPY new_call });
    RETURN Locatable{ FuncCall: COPY new_call };
}
END
PRIVATE FN pipelinePlaceholderRewriter__substitute_method_call(MUTABLE self: PipelinePlaceholderRewriter, node: MethodCall) RETURNS !Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE new_target = TRY (pipelinePlaceholderRewriter__substitute(&rtoc_self_view, COPY node.object));
    MUTABLE new_args = node.args |> SELECT TRY (pipelinePlaceholderRewriter__substitute(&rtoc_self_view, COPY _));
    IF ((new_target == node.object) AND (new_args == node.args)) THEN
      RETURN COPY node;
    END
    MUTABLE new_mc = MethodCall{ token: COPY node.token, object: COPY new_target, name: COPY node.name, args: COPY new_args, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, explicit_mutable_argument_tokens: NIL, pool_method: NIL, set_method: NIL, map_method: NIL, extern_call: NIL, extern_effects: NIL, extern_source: NIL, generic_type_args: NIL, heap_dupe_result: NIL, safe_nav_chain: NIL, error_union_type: NIL, explicit_mutable_receiver_token: NIL, protocol_name: NIL, protocol_operation: NIL, retain_error_channel: NIL, source_method_name: NIL };
    MUTABLE rtoc_rewrite_new_mc: PipelineRewriteNode = PipelineRewriteNode{ MethodCall: COPY new_mc };
    pipelinePlaceholderRewriter__copy_type_info(rtoc_self_view, PipelineRewriteNode{ MethodCall: COPY node }, &rtoc_rewrite_new_mc);
    IF rtoc_rewrite_new_mc IS_A MethodCall AS rtoc_updated_new_mc THEN
      new_mc = COPY rtoc_updated_new_mc;
    END
    MUTABLE rtoc_meta_new_mc: PipelineRewriteNode = PipelineRewriteNode{ MethodCall: COPY new_mc };
    pipelinePlaceholderRewriter__copy_call_metadata(rtoc_self_view, PipelineRewriteNode{ MethodCall: COPY node }, &rtoc_meta_new_mc);
    IF rtoc_meta_new_mc IS_A MethodCall AS rtoc_meta_updated_new_mc THEN
      new_mc = COPY rtoc_meta_updated_new_mc;
    END
    RETURN new_mc;
}
END
PRIVATE FN pipelinePlaceholderRewriter__substitute_binary_op(MUTABLE self: PipelinePlaceholderRewriter, node: BinaryOp) RETURNS !Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE new_left = TRY (pipelinePlaceholderRewriter__substitute(&rtoc_self_view, COPY node.left));
    MUTABLE new_right = TRY (pipelinePlaceholderRewriter__substitute(&rtoc_self_view, COPY node.right));
    IF ((new_left == node.left) AND (new_right == node.right)) THEN
      RETURN COPY Locatable{ BinaryOp: COPY node };
    END
    MUTABLE new_bin = BinaryOp{ token: COPY node.token, left: COPY new_left, op: COPY node.op, right: COPY new_right, paren_bind: NIL, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, string_concat: NIL, or_fallback_dupe: NIL, error_union_type: NIL, observable_terminal: NIL, observable_dest: NIL, retain_error_channel: NIL };
    pipelinePlaceholderRewriter__copy_type_info(rtoc_self_view, PipelineRewriteNode{ BinaryOp: COPY node }, PipelineRewriteNode{ BinaryOp: COPY new_bin });
    IF (node.string_concat == TRUE) THEN
      new_bin.string_concat = TRUE;
    END
    RETURN Locatable{ BinaryOp: COPY new_bin };
}
END
PRIVATE FN pipelinePlaceholderRewriter__substitute_get_field(MUTABLE self: PipelinePlaceholderRewriter, node: GetField) RETURNS !Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF pipelineContextState__soa_rewrite_field_node?(rtoc_self_view.context, node) THEN
      pipelineContextState__record_soa_field(&rtoc_self_view.context, node.field);
      MUTABLE soa_field = Identifier{ token: COPY node.token, name: "__soa_${node.field}", can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, fn_ref: NIL, heap_dupe_result: NIL, atomic_borrow: NIL, ownership_pending_transfer: NIL };
      soa_field.type_object = CAST(TRY (pipelinePlaceholderRewriter__soa_field_slice_type(rtoc_self_view, node)) AS ?Type);
