FN castNodeToPipelineRewriteNode(value: Node) RETURNS PipelineRewriteNode ->
  PARTIAL MATCH value START
    Node.Assignment AS cast_payload -> RETURN PipelineRewriteNode{ Assignment: COPY cast_payload };,
    Node.BindExpr AS cast_payload -> RETURN PipelineRewriteNode{ BindExpr: COPY cast_payload };,
    Node.BinaryOp AS cast_payload -> RETURN PipelineRewriteNode{ BinaryOp: COPY cast_payload };,
    Node.Identifier AS cast_payload -> RETURN PipelineRewriteNode{ Identifier: COPY cast_payload };,
    Node.ListLit AS cast_payload -> RETURN PipelineRewriteNode{ ListLit: COPY cast_payload };,
    Node.TupleLit AS cast_payload -> RETURN PipelineRewriteNode{ TupleLit: COPY cast_payload };,
    Node.HashLit AS cast_payload -> RETURN PipelineRewriteNode{ HashLit: COPY cast_payload };,
    Node.StructLit AS cast_payload -> RETURN PipelineRewriteNode{ StructLit: COPY cast_payload };,
    Node.IfStatement AS cast_payload -> RETURN PipelineRewriteNode{ IfStatement: COPY cast_payload };,
    Node.FuncCall AS cast_payload -> RETURN PipelineRewriteNode{ FuncCall: COPY cast_payload };,
    Node.GetField AS cast_payload -> RETURN PipelineRewriteNode{ GetField: COPY cast_payload };,
    Node.GetIndex AS cast_payload -> RETURN PipelineRewriteNode{ GetIndex: COPY cast_payload };,
    Node.Assert AS cast_payload -> RETURN PipelineRewriteNode{ Assert: COPY cast_payload };,
    Node.WithBlock AS cast_payload -> RETURN PipelineRewriteNode{ WithBlock: COPY cast_payload };,
    Node.MoveNode AS cast_payload -> RETURN PipelineRewriteNode{ MoveNode: COPY cast_payload };,
    Node.CopyNode AS cast_payload -> RETURN PipelineRewriteNode{ CopyNode: COPY cast_payload };,
    Node.KeepNode AS cast_payload -> RETURN PipelineRewriteNode{ KeepNode: COPY cast_payload };,
    Node.ShareNode AS cast_payload -> RETURN PipelineRewriteNode{ ShareNode: COPY cast_payload };,
    Node.StaticCall AS cast_payload -> RETURN PipelineRewriteNode{ StaticCall: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to PipelineRewriteNode");
  END
  panic("Invalid cast to PipelineRewriteNode");
END
FN castOptionalPipelineRewriteNodeToLocatable(value: ?PipelineRewriteNode) RETURNS Locatable ->
  IF value == NIL THEN
    panic("Invalid cast to Locatable");
  END
  PARTIAL MATCH value? START
    PipelineRewriteNode.Identifier AS cast_payload -> RETURN Locatable{ Identifier: COPY cast_payload };,
    PipelineRewriteNode.FuncCall AS cast_payload -> RETURN Locatable{ FuncCall: COPY cast_payload };,
    PipelineRewriteNode.BinaryOp AS cast_payload -> RETURN Locatable{ BinaryOp: COPY cast_payload };,
    PipelineRewriteNode.GetField AS cast_payload -> RETURN Locatable{ GetField: COPY cast_payload };,
    PipelineRewriteNode.GetIndex AS cast_payload -> RETURN Locatable{ GetIndex: COPY cast_payload };,
    PipelineRewriteNode.BindExpr AS cast_payload -> RETURN Locatable{ BindExpr: COPY cast_payload };,
    PipelineRewriteNode.Assignment AS cast_payload -> RETURN Locatable{ Assignment: COPY cast_payload };,
    PipelineRewriteNode.CopyNode AS cast_payload -> RETURN Locatable{ CopyNode: COPY cast_payload };,
    PipelineRewriteNode.MoveNode AS cast_payload -> RETURN Locatable{ MoveNode: COPY cast_payload };,
    PipelineRewriteNode.KeepNode AS cast_payload -> RETURN Locatable{ KeepNode: COPY cast_payload };,
    PipelineRewriteNode.ShareNode AS cast_payload -> RETURN Locatable{ ShareNode: COPY cast_payload };,
    PipelineRewriteNode.WithBlock AS cast_payload -> RETURN Locatable{ WithBlock: COPY cast_payload };,
    PipelineRewriteNode.StructLit AS cast_payload -> RETURN Locatable{ StructLit: COPY cast_payload };,
    PipelineRewriteNode.HashLit AS cast_payload -> RETURN Locatable{ HashLit: COPY cast_payload };,
    PipelineRewriteNode.ListLit AS cast_payload -> RETURN Locatable{ ListLit: COPY cast_payload };,
    PipelineRewriteNode.Assert AS cast_payload -> RETURN Locatable{ Assert: COPY cast_payload };,
    PipelineRewriteNode.IfStatement AS cast_payload -> RETURN Locatable{ IfStatement: COPY cast_payload };,
    PipelineRewriteNode.StaticCall AS cast_payload -> RETURN Locatable{ StaticCall: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Locatable");
  END
  panic("Invalid cast to Locatable");
END
