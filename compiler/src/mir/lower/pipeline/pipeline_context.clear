PRIVATE FN pipelinePlaceholderRewriter__substitute_if_statement(MUTABLE self: PipelinePlaceholderRewriter, node: IfStatement) RETURNS !Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE new_cond = TRY (pipelinePlaceholderRewriter__substitute(&rtoc_self_view, node.condition));
    MUTABLE new_then = node.then_branch |> SELECT TRY (pipelinePlaceholderRewriter__substitute(&rtoc_self_view, _));
    MUTABLE new_else: ?[]Locatable = NIL;
    IF node.else_branch != NIL THEN
      new_else = COPY ((node.else_branch)?) |> SELECT TRY (pipelinePlaceholderRewriter__substitute(&rtoc_self_view, _));
    END
    IF (((new_cond == node.condition) AND (new_then == node.then_branch)) AND (new_else == node.else_branch)) THEN
      RETURN COPY Locatable{ IfStatement: COPY node };
    END
    MUTABLE new_if = IfStatement{ token: COPY node.token, condition: COPY new_cond, then_branch: COPY new_then, else_branch: COPY new_else, then_drops: node.then_drops, else_drops: node.else_drops, comptime: FALSE, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, expr_mode: NIL, then_result_type: NIL, else_result_type: NIL };
    new_if.expr_mode = node.expr_mode;
    new_if.then_result_type = node.then_result_type;
    new_if.else_result_type = node.else_result_type;
    pipelinePlaceholderRewriter__copy_type_info(rtoc_self_view, PipelineRewriteNode{ IfStatement: COPY node }, PipelineRewriteNode{ IfStatement: COPY new_if });
    RETURN Locatable{ IfStatement: COPY new_if };
}
END
PRIVATE FN pipelinePlaceholderRewriter__copy_type_info(self: PipelinePlaceholderRewriter, src: PipelineRewriteNode, MUTABLE dst: PipelineRewriteNode) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    aST__copy_pipeline_rewrite_metadata_mut(&dst, src);
}
END
PRIVATE FN pipelinePlaceholderRewriter__copy_call_metadata(self: PipelinePlaceholderRewriter, src: PipelineRewriteNode, MUTABLE dst: PipelineRewriteNode) RETURNS Void
