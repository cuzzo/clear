    pipelinePlaceholderRewriter__copy_type_info(rtoc_self_view, PipelineRewriteNode{ Cast: COPY node }, &rtoc_rewrite_new_cast);
    IF rtoc_rewrite_new_cast IS_A Cast AS rtoc_updated_new_cast THEN
      new_cast = COPY rtoc_updated_new_cast;
    END
    RETURN new_cast;
}
END
PRIVATE FN pipelinePlaceholderRewriter__substitute_hash_lit(MUTABLE self: PipelinePlaceholderRewriter, node: HashLit) RETURNS !Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE pairs: {Locatable}Locatable = COPY node.pairs;
    MUTABLE new_pairs: {Locatable}Locatable = {};
    FOR rtoc_each_key IN pairs.keys() DO
    MUTABLE value: Locatable = COPY UNWRAP (pairs[rtoc_each_key]);
    new_pairs[rtoc_each_key] = TRY (pipelinePlaceholderRewriter__substitute(&rtoc_self_view, value));
    END
    IF (new_pairs == pairs) THEN
      RETURN COPY Locatable{ HashLit: COPY node };
    END
    MUTABLE new_hl = HashLit{ token: COPY node.token, pairs: COPY new_pairs, storage: COPY node.storage, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
    pipelinePlaceholderRewriter__copy_type_info(rtoc_self_view, PipelineRewriteNode{ HashLit: COPY node }, PipelineRewriteNode{ HashLit: COPY new_hl });
    RETURN Locatable{ HashLit: COPY new_hl };
}
END
PRIVATE FN pipelinePlaceholderRewriter__substitute_block_expr(MUTABLE self: PipelinePlaceholderRewriter, node: BlockExpr) RETURNS !Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE body: []Locatable = COPY node.body;
    MUTABLE new_body: []Locatable = ( { MUTABLE rtoc_empty_list_3: []Locatable = List[]; rtoc_empty_list_3 } );
    MUTABLE index = 0;
    WHILE (index < body.length()) DO
      &new_body.append(TRY (pipelinePlaceholderRewriter__substitute(&rtoc_self_view, UNWRAP (body[index]))));
      index = (index + 1);
    END
    MUTABLE result: ?Locatable = COPY node.result;
    MUTABLE new_result_branch_value: ?Locatable = NIL;
    IF result EXISTS AS result_value THEN
      new_result_branch_value = TRY (pipelinePlaceholderRewriter__substitute(&rtoc_self_view, result_value));
    ELSE
      new_result_branch_value = NIL;
    END
    MUTABLE new_result: ?Locatable = new_result_branch_value;
    IF ((new_body == node.body) AND (new_result == node.result)) THEN
      RETURN COPY node;
    END
    MUTABLE new_block = BlockExpr{ token: COPY node.token, body: COPY new_body, result: COPY new_result, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
    MUTABLE rtoc_rewrite_new_block: PipelineRewriteNode = PipelineRewriteNode{ BlockExpr: COPY new_block };
    pipelinePlaceholderRewriter__copy_type_info(rtoc_self_view, PipelineRewriteNode{ BlockExpr: COPY node }, &rtoc_rewrite_new_block);
    IF rtoc_rewrite_new_block IS_A BlockExpr AS rtoc_updated_new_block THEN
      new_block = COPY rtoc_updated_new_block;
    END
    RETURN new_block;
}
END
