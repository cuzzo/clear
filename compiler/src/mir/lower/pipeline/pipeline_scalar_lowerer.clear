REQUIRE "pkg:rtoc_6173742f6173742e636c656172" AS ast
REQUIRE "pkg:rtoc_6d69722f6d69722e636c656172" AS mir
REQUIRE "pkg:rtoc_6d69722f6c6f7765722f706970656c696e652f706970656c696e655f7265636f7264732e636c656172" AS pipeline_records
REQUIRE "pkg:rtoc_6d69722f706c6163656d656e742e636c656172" AS placement
PUB UNION PipelineMaterializedScalarOp { CountOpMultiowned: CountOp@multiowned, SumOpMultiowned: SumOp@multiowned, AverageOpMultiowned: AverageOp@multiowned, MinOpMultiowned: MinOp@multiowned, MaxOpMultiowned: MaxOp@multiowned, AnyOpMultiowned: AnyOp@multiowned, AllOpMultiowned: AllOp@multiowned, FindOpMultiowned: FindOp@multiowned, CountOp: CountOp, SumOp: SumOp, AverageOp: AverageOp, MinOp: MinOp, MaxOp: MaxOp, AnyOp: AnyOp, AllOp: AllOp, FindOp: FindOp }
PUB STRUCT PipelineScalarLowerer {
  visit_expr: FN(Locatable, Locatable, String) -> Emittable,
  pipeline_block: FN(Locatable, FN(String, String) -> !Emittable[]) -> MIRBlockExpr,
  transpile_type: FN(PipelineTypeInput) -> String,
  loop_mark_stmts: FN() -> ![]Emittable
}

PUB FN pipelineScalarLowerer__lower(self: PipelineScalarLowerer, site: PipelineSite, op: PipelineMaterializedScalarOp) RETURNS !?MIRBlockExpr ->
  IF op IS_A CountOp@multiowned AS count_op_multiowned THEN
    RETURN TRY (pipelineScalarLowerer__lower_count(self, site, CAST(COPY count_op_multiowned AS CountOp)));
  ELSE_IF op IS_A SumOp@multiowned AS sum_op_multiowned THEN
    RETURN TRY (pipelineScalarLowerer__lower_sum(self, site, CAST(COPY sum_op_multiowned AS SumOp)));
  ELSE_IF op IS_A AverageOp@multiowned AS average_op_multiowned THEN
    RETURN TRY (pipelineScalarLowerer__lower_average(self, site, CAST(COPY average_op_multiowned AS AverageOp)));
  ELSE_IF op IS_A MinOp@multiowned AS min_op_multiowned THEN
    RETURN TRY (pipelineScalarLowerer__lower_min(self, site, CAST(COPY min_op_multiowned AS MinOp)));
  ELSE_IF op IS_A MaxOp@multiowned AS max_op_multiowned THEN
    RETURN TRY (pipelineScalarLowerer__lower_max(self, site, CAST(COPY max_op_multiowned AS MaxOp)));
  ELSE_IF op IS_A AnyOp@multiowned AS any_op_multiowned THEN
    RETURN TRY (pipelineScalarLowerer__lower_any(self, site, CAST(COPY any_op_multiowned AS AnyOp)));
  ELSE_IF op IS_A AllOp@multiowned AS all_op_multiowned THEN
    RETURN TRY (pipelineScalarLowerer__lower_all(self, site, CAST(COPY all_op_multiowned AS AllOp)));
  ELSE_IF op IS_A FindOp@multiowned AS find_op_multiowned THEN
    RETURN TRY (pipelineScalarLowerer__lower_find(self, site, CAST(COPY find_op_multiowned AS FindOp)));
  ELSE
    RETURN NIL;
  END
END
