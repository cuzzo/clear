PRIVATE FN pipelineScalarLowerer__visit_pipeline_expr_mir(self: PipelineScalarLowerer, list_node: Locatable, expr_node: Locatable, placeholder: String = "it") RETURNS Emittable ->
  RETURN pipelineScalarLowerer__visit_expr_call(self, list_node, expr_node, placeholder);
END
PRIVATE FN pipelineScalarLowerer__scalar_loop(self: PipelineScalarLowerer, iter: Emittable, capture: String, body: []Emittable, mark: ?Bool = NIL) RETURNS !ForStmt ->
  RETURN ForStmt{ iter: COPY iter, capture: COPY capture, body: Body{ ArrayValue: TRY (pipelineScalarLowerer__with_iteration_rewind(self, body)) |> SELECT castEmittableToLocatable(_) }, index_capture: COPY mark, mark_per_iter: NIL, tight: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL };
END
PRIVATE FN pipelineScalarLowerer__with_iteration_rewind(self: PipelineScalarLowerer, body: []Emittable) RETURNS ![]Emittable ->
  MUTABLE found: Bool = FALSE;
  MUTABLE boundary = %(node) -> (node IS_A MIRBgBlock OR node IS_A LambdaExpr);
  mIR__each_node_until(NodeRoot{ ArrayValue: COPY body }, boundary, %(node: Emittable) -> {
  IF (IF node IS_A AllocMark AS alloc_mark THEN placement__frame?(alloc_mark.alloc) ELSE FALSE END) THEN
      found = TRUE;
  END
  rubyToClearVoid()
  });
  IF !(found) THEN
    RETURN COPY body;
  END
  RETURN (COPY (TRY (pipelineScalarLowerer__loop_mark_stmts_call(self))) + body);
END
FN castEmittableToLocatable(value: Emittable) RETURNS Locatable ->
  PARTIAL MATCH value START
    Emittable.MIRProgram AS cast_payload -> RETURN Locatable{ MIRProgram: COPY cast_payload };,
    Emittable.MIRStructDef AS cast_payload -> RETURN Locatable{ MIRStructDef: COPY cast_payload };,
    Emittable.MIREnumDef AS cast_payload -> RETURN Locatable{ MIREnumDef: COPY cast_payload };,
    Emittable.MIRDestructureTarget AS cast_payload -> RETURN Locatable{ MIRDestructureTarget: COPY cast_payload };,
    Emittable.MIRDeferStmt AS cast_payload -> RETURN Locatable{ MIRDeferStmt: COPY cast_payload };,
    Emittable.MIRBgBlock AS cast_payload -> RETURN Locatable{ MIRBgBlock: COPY cast_payload };,
    Emittable.MIRDoBlock AS cast_payload -> RETURN Locatable{ MIRDoBlock: COPY cast_payload };,
    Emittable.MIRMethodCall AS cast_payload -> RETURN Locatable{ MIRMethodCall: COPY cast_payload };,
    Emittable.MIRUnaryOp AS cast_payload -> RETURN Locatable{ MIRUnaryOp: COPY cast_payload };,
    Emittable.MIRBlockExpr AS cast_payload -> RETURN Locatable{ MIRBlockExpr: COPY cast_payload };,
    Emittable.MIRCast AS cast_payload -> RETURN Locatable{ MIRCast: COPY cast_payload };,
    Emittable.MIROptionalUnwrap AS cast_payload -> RETURN Locatable{ MIROptionalUnwrap: COPY cast_payload };,
    Emittable.MIRRangeLit AS cast_payload -> RETURN Locatable{ MIRRangeLit: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Locatable");
  END
  panic("Invalid cast to Locatable");
END
FN rubyToClearVoid() RETURNS Void ->
  RETURN;
END
PUB FN pipelineScalarLowerer__visit_expr_call(self: PipelineScalarLowerer, arg0: Locatable, arg1: Locatable, arg2: String) RETURNS Emittable ->
  MUTABLE fn_value = self.visit_expr;
  RETURN fn_value(arg0, arg1, arg2);
END
PUB FN pipelineScalarLowerer__transpile_type_call(self: PipelineScalarLowerer, arg0: PipelineTypeInput) RETURNS String ->
  MUTABLE fn_value = self.transpile_type;
  RETURN fn_value(arg0);
END
PUB FN pipelineScalarLowerer__loop_mark_stmts_call(self: PipelineScalarLowerer) RETURNS ![]Emittable ->
  MUTABLE fn_value = self.loop_mark_stmts;
  RETURN fn_value();
END
PUB FN pipelineScalarLowerer__pipeline_block_call(self: PipelineScalarLowerer, arg0: Locatable, arg1: FN(String, String) -> !Emittable[]) RETURNS MIRBlockExpr ->
  MUTABLE fn_value = self.pipeline_block;
  RETURN fn_value(arg0, arg1);
END
