PUB UNION PipelineListTerminalOp { WhereOpMultiowned: WhereOp@multiowned, SelectOpMultiowned: SelectOp@multiowned, LimitOp: LimitOp, TakeWhileOpMultiowned: TakeWhileOp@multiowned, SkipOp: SkipOp, UnnestOpMultiowned: UnnestOp@multiowned, ReduceOpMultiowned: ReduceOp@multiowned, WindowOpMultiowned: WindowOp@multiowned, OrderByOpMultiowned: OrderByOp@multiowned, JoinOp: JoinOp, TapOp: TapOp, WhereOp: WhereOp, SelectOp: SelectOp, TakeWhileOp: TakeWhileOp, UnnestOp: UnnestOp, ReduceOp: ReduceOp, WindowOp: WindowOp, OrderByOp: OrderByOp }
PUB STRUCT PipelineListLowerer {
  visit_mir: FN(Locatable) -> Emittable,
  visit_expr: FN(Locatable, Locatable, String) -> Emittable,
  visit_expr_head: FN(Locatable, String, String@symbol) -> PipelineElementHead,
  visit_reduce_expr: FN(Locatable, String, String) -> Emittable,
  visit_body: FN(Locatable[], String) -> ![]Emittable,
  visit_join_lambda: FN(Locatable, {String}String) -> Emittable,
  pipeline_block: FN(Locatable, FN(String, String) -> !Emittable[]) -> MIRBlockExpr,
  transpile_type: FN(PipelineTypeInput) -> String,
  pipeline_alloc: FN(BinaryOp) -> String@symbol,
  pipeline_result_alloc: FN() -> String@symbol,
  source_shape: FN(Locatable) -> PipelineSourceShape,
  next_label: FN() -> String,
  set_current_label: FN(String) -> Void,
  append_owned_value_stmt: FN(String, String@symbol, Emittable) -> Emittable,
  append_fresh_owned_value_stmt: FN(String, String@symbol, Emittable, Type) -> Emittable,
  borrowed_pipeline_value: FN(Emittable, Type, String@symbol) -> Emittable,
  cleanup_bearing_type: FN(Type) -> Bool,
  owning_pipeline_temp_stmts: FN(String, Emittable, Type, String, String@symbol) -> ![]Emittable,
  loop_mark_stmts: FN() -> ![]Emittable
}

PUB FN pipelineListLowerer__lower(self: PipelineListLowerer, site: PipelineSite, MUTABLE op: PipelineListTerminalOp) RETURNS !MIRBlockExpr ->
  IF op IS_A WhereOp@multiowned AS where_op_multiowned THEN
    RETURN TRY (pipelineListLowerer__lower_where(self, site, whereOp__expression(where_op_multiowned)));
  ELSE_IF op IS_A SelectOp@multiowned AS select_op_multiowned THEN
    RETURN TRY (pipelineListLowerer__lower_select(self, site, selectOp__expression(select_op_multiowned)));
  ELSE_IF op IS_A LimitOp AS limit_op THEN
    RETURN TRY (pipelineListLowerer__lower_limit(self, site, limit_op));
  ELSE_IF op IS_A TakeWhileOp@multiowned AS take_while_op_multiowned THEN
    RETURN TRY (pipelineListLowerer__lower_take_while(self, site, takeWhileOp__expression(take_while_op_multiowned)));
  ELSE_IF op IS_A SkipOp AS skip_op THEN
    RETURN TRY (pipelineListLowerer__lower_skip(self, site, skip_op));
  ELSE_IF op IS_A UnnestOp@multiowned AS unnest_op_multiowned THEN
    MUTABLE unnest_op_multiowned_mutable = COPY unnest_op_multiowned;
    RETURN TRY (pipelineListLowerer__lower_unnest(self, site, CAST(COPY unnest_op_multiowned_mutable AS UnnestOp)));
  ELSE_IF op IS_A ReduceOp@multiowned AS reduce_op_multiowned THEN
    MUTABLE reduce_op_multiowned_mutable = COPY reduce_op_multiowned;
    RETURN TRY (pipelineListLowerer__lower_reduce(self, site, CAST(COPY reduce_op_multiowned_mutable AS ReduceOp)));
  ELSE_IF op IS_A WindowOp@multiowned AS window_op_multiowned THEN
    RETURN TRY (pipelineListLowerer__lower_window(self, site, CAST(COPY window_op_multiowned AS WindowOp)));
  ELSE_IF op IS_A OrderByOp@multiowned AS order_by_op_multiowned THEN
    RETURN TRY (pipelineListLowerer__lower_order_by(self, site, CAST(COPY order_by_op_multiowned AS OrderByOp)));
  ELSE_IF op IS_A JoinOp AS join_op THEN
    RETURN TRY (pipelineListLowerer__lower_join(self, site, join_op));
  ELSE_IF op IS_A TapOp AS tap_op THEN
    RETURN pipelineListLowerer__lower_tap(self, site, tap_op);
  ELSE
    RETURN NIL;
  END
END
PUB FN pipelineListLowerer__lower_where_expr(self: PipelineListLowerer, site: PipelineSite, expr_node: Locatable) RETURNS !MIRBlockExpr ->
  RETURN TRY (pipelineListLowerer__lower_where(self, site, expr_node));
END
PUB FN pipelineListLowerer__lower_select_expr(self: PipelineListLowerer, site: PipelineSite, expr_node: Locatable) RETURNS !MIRBlockExpr ->
  RETURN TRY (pipelineListLowerer__lower_select(self, site, expr_node));
END
PUB FN pipelineListLowerer__lower_take_while_expr(self: PipelineListLowerer, site: PipelineSite, expr_node: Locatable) RETURNS !MIRBlockExpr ->
  RETURN TRY (pipelineListLowerer__lower_take_while(self, site, expr_node));
END
PRIVATE FN pipelineListLowerer__lower_where(self: PipelineListLowerer, site: PipelineSite, expr_node: Locatable) RETURNS !MIRBlockExpr ->
  MUTABLE list_node = COPY site.list;
  MUTABLE smooth_node = COPY site.options;
  MUTABLE elem_type = COPY CAST((&list_node.full_type_mut()).element_type().resolved() AS String);
  MUTABLE elem_zig = self.transpile_type(elem_type);
  MUTABLE alloc = self.pipeline_alloc(smooth_node);
  MUTABLE pred_mir = pipelineListLowerer__visit_pipeline_expr_mir(self, list_node, expr_node);
  RETURN self.pipeline_block(list_node, %(items, label) USE(alloc, elem_type, elem_zig, pred_mir, self) -> {
  MUTABLE res = pipelineListLowerer__result_binding_name(self, label);
  CAST(Tuple{Let{ name: Name{ StringValue: COPY res }, init: Emittable{ MakeList: COPY MakeList{ elem_type: COPY elem_zig, items: ( { MUTABLE rtoc_empty_list_1: []Emittable = List[]; rtoc_empty_list_1 } ), alloc: COPY alloc, minimum_capacity: NIL, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }, ForStmt{ iter: Emittable{ Ident: COPY Ident{ name: COPY items, lowered_node_id: NIL, ownership_consumption: NIL } }, capture: "it", body: COPY CAST(Tuple{Let{ name: Name{ StringValue: COPY "matches" }, init: COPY pred_mir, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }, IfStmt{ cond: Emittable{ Ident: COPY Ident{ name: "matches", lowered_node_id: NIL, ownership_consumption: NIL } }, then_body: [castEmittableToBreakStmt(self.append_owned_value_stmt(res, alloc, self.borrowed_pipeline_value(Ident{ name: "it", lowered_node_id: NIL, ownership_consumption: NIL }, TRY (type__new(TypeConstructionInput{ StringValue: COPY elem_type })), alloc)))], else_body: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, comptime: NIL }} AS Tuple<Let, IfStmt>), index_capture: NIL, mark_per_iter: NIL, tight: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }, BreakStmt{ label: label, value: Emittable{ Ident: COPY Ident{ name: COPY res, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }} AS Tuple<Let, ForStmt, BreakStmt>)
  });
END
PRIVATE FN pipelineListLowerer__lower_select(self: PipelineListLowerer, site: PipelineSite, MUTABLE expr_node: Locatable) RETURNS !MIRBlockExpr ->
  MUTABLE list_node = COPY site.list;
  MUTABLE smooth_node = COPY site.options;
  MUTABLE res_type = TRY (pipelineListLowerer__select_result_type(self, &expr_node));
  MUTABLE res_zig = self.transpile_type(res_type);
  MUTABLE alloc = self.pipeline_alloc(smooth_node);
  RETURN self.pipeline_block(list_node, %(items, label) USE(alloc, expr_node, res_type, res_zig, MUTABLE smooth_node, self) -> {
  MUTABLE res = pipelineListLowerer__result_binding_name(self, label);
  MUTABLE raw_it = COPY CAST(label AS String);
  WHILE raw_it.startsWith?("_") DO
      raw_it = raw_it.substr(1, (raw_it.length() - 1));
  END
  MUTABLE it_name = "it_${raw_it}";
  MUTABLE head = self.visit_expr_head(expr_node, it_name, alloc);
  MUTABLE rewind_per_iter = ((alloc == :heap) AND pipelineListLowerer__element_head_frame_transients?(self, head));
