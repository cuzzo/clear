PRIVATE FN pipelineListLowerer__visit_pipeline_expr_mir(self: PipelineListLowerer, list_node: Locatable, expr_node: Locatable, placeholder: String = "it") RETURNS Emittable ->
  RETURN self.visit_expr(list_node, expr_node, placeholder);
END
PRIVATE FN pipelineListLowerer__join_predicate_mir(self: PipelineListLowerer, list_node: Locatable, join_node: JoinOp) RETURNS Emittable ->
  MUTABLE key_expr = join_node.key_expr;
  IF key_expr IS_A LambdaLit THEN
    MUTABLE params = key_expr.params();
    MUTABLE left_param = params[0].name();
    MUTABLE right_param = params[1].name();
    MUTABLE join_params: {String}String = CAST({left_param: "__jl", right_param: "__jr"} AS {String}String);
    RETURN self.visit_join_lambda(CAST(key_expr.body() AS Locatable), join_params);
  END
  MUTABLE left_key_mir = self.visit_expr(list_node, key_expr, "__jl");
  MUTABLE right_key_mir = self.visit_expr(list_node, key_expr, "__jr");
  RETURN Emittable{ RuntimeCall: COPY RuntimeCall{ spec: COPY runtimeCalls__eql_spec(), args: [left_key_mir, right_key_mir], lowered_node_id: NIL, ownership_consumption: NIL } };
END
PRIVATE FN pipelineListLowerer__ownership_sink_marks(self: PipelineListLowerer, left_owns: Bool, right_owns: Bool) RETURNS ![]Emittable ->
  MUTABLE marks: []Emittable = ( { MUTABLE rtoc_empty_list_16: []Emittable = List[]; rtoc_empty_list_16 } );
  IF left_owns THEN
    marks = ruby_array_concat_Emittable(marks, CAST(TRY (ownershipTransferPlan__marks((OwnershipTransferPlan{ name: "__jl_owned", target: :owned_sink, target_alloc: COPY self.pipeline_result_alloc(), move_guarded: TRUE }))) AS []Emittable));
  END
  IF right_owns THEN
    marks = ruby_array_concat_Emittable(marks, CAST(TRY (ownershipTransferPlan__marks((OwnershipTransferPlan{ name: "__match", target: :owned_sink, target_alloc: COPY self.pipeline_result_alloc(), move_guarded: TRUE }))) AS []Emittable));
  END
  RETURN marks;
END
PRIVATE FN pipelineListLowerer__right_cleanup_stmts(self: PipelineListLowerer, right_owns: Bool, alloc: String@symbol, right_zig: String) RETURNS ![]Emittable ->
  IF !(right_owns) THEN
    RETURN CAST(( { MUTABLE rtoc_empty_list_17: []Emittable = List[]; rtoc_empty_list_17 } ) AS []Emittable);
  END
  RETURN CAST([Emittable{ ErrCleanup: COPY ErrCleanup{ name: "__match", cleanup_entry: COPY cleanupEntry__build(:uniform, alloc, TRUE, {:zig_type: "?${right_zig}"}), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL } }] AS []Emittable);
END
FN castEmittableToBreakStmt(value: Emittable) RETURNS BreakStmt ->
  IF value IS_A BreakStmt AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to BreakStmt");
END
FN castEmittableToLocatable(value: Emittable) RETURNS Locatable ->
  PARTIAL MATCH value START
    Emittable.MIRProgram AS cast_payload -> RETURN Locatable{ MIRProgram: COPY cast_payload };,
    Emittable.MIRStructDef AS cast_payload -> RETURN Locatable{ MIRStructDef: COPY cast_payload };,
    Emittable.MIREnumDef AS cast_payload -> RETURN Locatable{ MIREnumDef: COPY cast_payload };,
    Emittable.MIRDestructureTarget AS cast_payload -> RETURN Locatable{ MIRDestructureTarget: COPY cast_payload };,
    Emittable.MIRDeferStmt AS cast_payload -> RETURN Locatable{ MIRDeferStmt: COPY cast_payload };,
    Emittable.MIRBgBlock AS cast_payload -> RETURN Locatable{ MIRBgBlock: COPY cast_payload };,
    Emittable.MIRDoBlock AS cast_payload -> RETURN Locatable{ MIRDoBlock: COPY cast_payload };,
    Emittable.MIRMethodCall AS cast_payload -> RETURN Locatable{ MIRMethodCall: COPY cast_payload };,
    Emittable.MIRUnaryOp AS cast_payload -> RETURN Locatable{ MIRUnaryOp: COPY cast_payload };,
    Emittable.MIRBlockExpr AS cast_payload -> RETURN Locatable{ MIRBlockExpr: COPY cast_payload };,
    Emittable.MIRCast AS cast_payload -> RETURN Locatable{ MIRCast: COPY cast_payload };,
    Emittable.MIROptionalUnwrap AS cast_payload -> RETURN Locatable{ MIROptionalUnwrap: COPY cast_payload };,
    Emittable.MIRRangeLit AS cast_payload -> RETURN Locatable{ MIRRangeLit: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Locatable");
  END
  panic("Invalid cast to Locatable");
END
FN rubyToClearVoid() RETURNS Void ->
  RETURN;
END
FN ruby_array_concat_Emittable(left: []Emittable, right: []Emittable) RETURNS []Emittable ->
  MUTABLE result: []Emittable = [];
  FOR rtoc_left_item IN left DO
    &result.append(COPY rtoc_left_item);
  END
  FOR rtoc_right_item IN right DO
    &result.append(COPY rtoc_right_item);
  END
  RETURN result;
END
