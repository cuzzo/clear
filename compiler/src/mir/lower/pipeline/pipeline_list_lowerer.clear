      body = ( { MUTABLE rtoc_empty_list_2: []Emittable = List[]; rtoc_empty_list_2 } );
    END
  ruby_array_concat_Emittable(body, head.pending);
  IF element_owned THEN
      &body.append(self.append_fresh_owned_value_stmt(res, alloc, head.value, res_type));
  ELSE
      &body.append(Emittable{ Let: COPY Let{ name: Name{ StringValue: COPY "val" }, init: COPY head.value, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL } });
      &body.append(self.append_owned_value_stmt(res, alloc, self.borrowed_pipeline_value(Ident{ name: "val", lowered_node_id: NIL, ownership_consumption: NIL }, res_type, alloc)));
  END
  ([AllocMark{ name: COPY res, alloc: COPY alloc, type_info: COPY TRY (type__new(TypeConstructionInput{ Type: COPY &smooth_node.full_type_mut() })), scope: COPY placement__alloc_scope(alloc), lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }, Let{ name: Name{ StringValue: COPY res }, init: Emittable{ MakeList: COPY MakeList{ elem_type: COPY res_zig, items: ( { MUTABLE rtoc_empty_list_3: []Emittable = List[]; rtoc_empty_list_3 } ), alloc: COPY alloc, minimum_capacity: NIL, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: TRUE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }, ForStmt{ iter: Emittable{ Ident: COPY Ident{ name: COPY items, lowered_node_id: NIL, ownership_consumption: NIL } }, capture: COPY it_name, body: Body{ ArrayValue: body |> SELECT castEmittableToLocatable(_) }, index_capture: NIL, mark_per_iter: NIL, tight: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }] + TRY (ownershipTransferPlan__marks((OwnershipTransferPlan{ name: COPY res, target: :block_result, target_alloc: COPY alloc, move_guarded: FALSE }))) + [BreakStmt{ label: label, value: Emittable{ Ident: COPY Ident{ name: COPY res, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }])
  });
END
PRIVATE FN pipelineListLowerer__element_head_frame_transients?(self: PipelineListLowerer, head: PipelineElementHead) RETURNS Bool ->
  MUTABLE found: Bool = FALSE;
  MUTABLE boundary = %(node) -> (node IS_A MIRBgBlock OR node IS_A LambdaExpr);
  MUTABLE nodes: []Emittable = (COPY head.pending + CAST([head.value] AS []Emittable));
  mIR__each_node_until(NodeRoot{ ArrayValue: COPY nodes }, boundary, %(node: Emittable) -> {
  IF (IF node IS_A AllocMark AS alloc_mark THEN placement__frame?(alloc_mark.alloc) ELSE FALSE END) THEN
      found = TRUE;
  END
  rubyToClearVoid()
  });
  RETURN found;
END
PRIVATE FN pipelineListLowerer__result_binding_name(self: PipelineListLowerer, label: String) RETURNS String ->
  MUTABLE raw = COPY label;
  WHILE raw.startsWith?("_") DO
    raw = raw.substr(1, (raw.length() - 1));
  END
  RETURN "res_list_${raw}";
END
PRIVATE FN pipelineListLowerer__select_result_type(self: PipelineListLowerer, MUTABLE expr_node: Locatable) RETURNS !Type ->
  MUTABLE retained_error =   IF ((respondsTo?(expr_node, "retain_error_channel") AND (expr_node.retain_error_channel() == TRUE)) AND respondsTo?(expr_node, "error_union_type")) THEN
    expr_node.error_union_type()
  ELSE
    NIL
  END;
  IF retained_error THEN
    RETURN TRY (type__new(retained_error));
  ELSE
    RETURN &expr_node.full_type_mut("SELECT result");
  END
END
