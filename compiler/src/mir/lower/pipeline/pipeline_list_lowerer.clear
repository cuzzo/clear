PRIVATE FN pipelineListLowerer__lower_tap(self: PipelineListLowerer, site: PipelineSite, tap_op: TapOp) RETURNS !MIRBlockExpr ->
  MUTABLE list_node = COPY site.list;
  MUTABLE label = self.next_label();
  MUTABLE source_mir = self.visit_mir(list_node);
  self.set_current_label(label);
  MUTABLE body_mir = TRY (self.visit_body(tap_op.body, "__tap_item"));
  RETURN MIRBlockExpr{ label: label, body: COPY CAST(Tuple{Let{ name: Name{ StringValue: COPY "__tap_src" }, init: COPY source_mir, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }, Let{ name: Name{ StringValue: COPY "__tap_items" }, init: Emittable{ ItemsAccess: COPY ItemsAccess{ expr: Emittable{ Ident: COPY Ident{ name: "__tap_src", lowered_node_id: NIL, ownership_consumption: NIL } }, safe: TRUE, lowered_node_id: NIL, ownership_consumption: NIL } }, mutable: FALSE, annotation: NIL, suppression: NIL, alias_safe: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL, const_visibility: NIL, module_const: NIL }, ForStmt{ iter: Emittable{ Ident: COPY Ident{ name: "__tap_items", lowered_node_id: NIL, ownership_consumption: NIL } }, capture: "__tap_item", body: COPY body_mir, index_capture: NIL, mark_per_iter: NIL, tight: NIL, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }, BreakStmt{ label: label, value: Emittable{ Ident: COPY Ident{ name: "__tap_src", lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL, source_column: NIL, source_line: NIL }} AS Tuple<Let, Let, ForStmt, BreakStmt>), lowered_node_id: NIL, ownership_consumption: NIL, borrowed_view: NIL, lazy_boundary: NIL, result_type: NIL };
