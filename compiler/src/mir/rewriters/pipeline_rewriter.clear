PRIVATE FN pipelineRewriter__select_stage_value_type(self: PipelineRewriter, stage: SelectOp) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE expression = COPY stage.expression;
    IF (((((stage.effect_mode == :fallible) OR (stage.effect_mode == :fallible_optional))) AND TRUE) AND expression.error_union_type()) THEN
      RETURN TRY (type__new(expression.error_union_type()));
    END
    RETURN &expression.full_type_mut("SELECT stage value");
}
END
PRIVATE FN pipelineRewriter__build_terminal_action(MUTABLE self: PipelineRewriter, terminal: ?Locatable, MUTABLE current_val: Identifier, res_var: String, token: Token, res_type: ?Type = NIL) RETURNS ![]Node
