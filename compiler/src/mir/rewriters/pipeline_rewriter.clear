        symbolEntry__storage( UNWRAP (var_decl_mutable.symbol))
      ELSE
        NIL
      END) != NIL THEN (IF var_decl_mutable.symbol != NIL THEN
        symbolEntry__storage( UNWRAP (var_decl_mutable.symbol))
      ELSE
        NIL
