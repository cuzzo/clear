PRIVATE FN pipelineRewriter__schema_lookup(MUTABLE self: PipelineRewriter) RETURNS Any@multiowned ->
    self.schema_lookup = (self.schema_lookup OR_ELSE %(name) USE(self) -> (IF self.annotator != NIL THEN
      semanticAnnotator__lookup_type_schema(UNWRAP (self.annotator), name)
    ELSE
      NIL
