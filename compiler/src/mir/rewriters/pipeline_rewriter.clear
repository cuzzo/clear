      RETURN CAST([Node{ IfStatement: COPY if_stmt }] AS []Node);
    ELSE_IF stage IS_A SkipOp AS skip_op THEN
      MUTABLE skip_op_mutable = COPY skip_op;
      MUTABLE cnt_var = pipelineRewriter__next_var(&rtoc_self_view, "__skip_cnt");
      MUTABLE zero = Literal{ token: COPY token, type: :INT64, value: 0, storage: NIL, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
