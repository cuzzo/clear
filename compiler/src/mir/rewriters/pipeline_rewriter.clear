      MUTABLE expr = pipelineRewriter__replace_placeholder(rtoc_self_view, selectOp__expression(select_op_mutable), current_val);
      MUTABLE selected_type = TRY (pipelineRewriter__select_stage_value_type(rtoc_self_view, select_op_mutable));
      MUTABLE sel_var = pipelineRewriter__next_var(&rtoc_self_view, "__sel");
