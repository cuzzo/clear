    END
    RETURN COPY node;
END
PRIVATE FN pipelineRewriter__rewrite_optional_node(MUTABLE self: PipelineRewriter, value: ?Locatable) RETURNS !?Locatable
  EFFECTS REENTRANT ->
    IF value EXISTS AS value_value THEN
      MUTABLE value_value_mutable = COPY value_value;
      RETURN TRY (pipelineRewriter__rewrite_mut(&self, &value_value_mutable));
    ELSE
      RETURN NIL;
    END
END
PRIVATE FN pipelineRewriter__rewrite_call_argument(MUTABLE self: PipelineRewriter, MUTABLE argument: Locatable) RETURNS !Locatable
  EFFECTS REENTRANT ->
  MUTABLE moved = aST__moved?(argument);
  MUTABLE prev_dest: ?String@symbol = COPY self.dest_storage;
  DEFER self.dest_storage = prev_dest;
  self.dest_storage = IF moved THEN
      :heap
    ELSE
      NIL
    END;
  MUTABLE replaced = TRY (pipelineRewriter__rewrite_mut(&self, &argument));
  IF (moved AND TRUE) THEN
      locatable__set_was_moved_mut(&replaced, TRUE);
  END
  RETURN replaced;
END
PRIVATE FN pipelineRewriter__rewrite_struct_field(MUTABLE self: PipelineRewriter, MUTABLE value: Locatable) RETURNS !Locatable
  EFFECTS REENTRANT ->
  MUTABLE prev_dest: ?String@symbol = COPY self.dest_storage;
  DEFER self.dest_storage = prev_dest;
  self.dest_storage = :heap;
  RETURN TRY (pipelineRewriter__rewrite_mut(&self, &value));
END
PRIVATE FN pipelineRewriter__rewrite_pipeline(MUTABLE self: PipelineRewriter, MUTABLE node: BinaryOp) RETURNS !Locatable
