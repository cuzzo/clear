->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (stages.length() == 0) THEN
      RETURN TRY (pipelineRewriter__build_terminal_action(&rtoc_self_view, terminal, &current_val, res_var, token, res_type));
    END
