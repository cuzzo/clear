PRIVATE FN pipelineRewriter__build_recursive_body(MUTABLE self: PipelineRewriter, stages: []Locatable, terminal: ?Locatable, MUTABLE current_val: Identifier, res_var: String, token: Token, MUTABLE stage_inits: []Node, res_type: ?Type = NIL) RETURNS ![]Node
