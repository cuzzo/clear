PRIVATE FN pipelineRewriter__select_stage_value_type(self: PipelineRewriter, stage: SelectOp) RETURNS !Type ->
    MUTABLE expression = COPY stage.expression;
    IF (((((stage.effect_mode == :fallible) OR (stage.effect_mode == :fallible_optional))) AND TRUE) AND locatable__error_union_type(expression)) THEN
      RETURN TRY (type__new( CAST(locatable__error_union_type(expression) AS TypeConstructionInput)));
    END
    RETURN TRY (aST__full_type_mut(expression));
