END
PRIVATE FN pipelineRewriter__is_fusible?(self: PipelineRewriter, node: ?Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN aST__pipeline_fusible_stage?( UNWRAP (node));
}
END
PRIVATE FN pipelineRewriter__binding_source?(self: PipelineRewriter, node: ?Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (IF node? IS_A BinaryOp AS binary_op THEN (binary_op.op == :BIND_VAR) ELSE FALSE END) THEN
      RETURN TRUE;
    END
    IF node? IS_A BinaryOp AS binary_op THEN
    IF binaryOp__smooth?(binary_op) THEN
        MUTABLE inner_src = COPY pipelineRewriter__collect_chain(rtoc_self_view, binary_op).source;
        RETURN (IF inner_src IS_A BinaryOp AS binary_op THEN (binary_op.op == :BIND_VAR) ELSE FALSE END);
      ELSE
        RETURN FALSE;
      END
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN pipelineRewriter__collect_chain(self: PipelineRewriter, node: BinaryOp) RETURNS PipelineChain
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE stages: []Locatable = ( { MUTABLE rtoc_empty_list_5: []Locatable = List[]; rtoc_empty_list_5 } );
    MUTABLE cursor: BinaryOp = COPY node;
    MUTABLE terminal: ?Locatable = NIL;
    MUTABLE right = COPY node.right;
    IF pipelineRewriter__is_fusible?(rtoc_self_view, right) THEN
      terminal = NIL;
      cursor = COPY node;
    ELSE
      terminal = right;
      cursor = castLocatableToBinaryOp__pipeline_rewriter(COPY node.left);
    END
    WHILE (TRUE AND binaryOp__smooth?(cursor)) DO
      MUTABLE r = COPY cursor.right;
      IF pipelineRewriter__is_fusible?(rtoc_self_view, r) THEN
        stages = ([r] + stages);
        cursor = castLocatableToBinaryOp__pipeline_rewriter(COPY cursor.left);
      ELSE
        BREAK;
      END
    END
    RETURN PipelineChain{ source: Locatable{ BinaryOp: COPY cursor }, stages: COPY stages, terminal: COPY terminal };
}
END
