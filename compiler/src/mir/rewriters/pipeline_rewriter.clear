REQUIRE "pkg:rtoc_6173742f747970652e636c656172" AS type
REQUIRE "pkg:rtoc_6173742f6173742e636c656172" AS ast
REQUIRE "pkg:rtoc_6173742f7374645f6c69622e636c656172" AS std_lib
REQUIRE "pkg:rtoc_616e6e6f7461746f722f68656c706572732f696e7472696e7369635f72656769737472792e636c656172" AS intrinsic_registry
REQUIRE "pkg:rtoc_6173742f73796d626f6c5f656e7472792e636c656172" AS symbol_entry
REQUIRE "pkg:rtoc_616e6e6f7461746f722f68656c706572732f66756e6374696f6e5f7369676e61747572652e636c656172" AS function_signature
REQUIRE "pkg:rtoc_6173742f6c657865722e636c656172" AS lexer
PUB STRUCT PipelineRewriter {
  annotator: ?SemanticAnnotator,
  dest_storage: ?String@symbol,
  list_res_symbols: {String}SymbolEntry@multiowned,
  reduce_acc_symbols: {String}SymbolEntry@multiowned,
  schema_lookup: ?Any@multiowned,
  var_counter: Int64
}

PUB STRUCT PipelineChain {
  source: Locatable,
  stages: []Locatable,
  terminal: ?Locatable
}
PUB FN pipelineRewriter__initialize(MUTABLE self: PipelineRewriter, annotator: ?SemanticAnnotator = NIL) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.annotator = COPY annotator;
    rtoc_self_view.var_counter = 0;
    rtoc_self_view.reduce_acc_symbols = {};
    rtoc_self_view.dest_storage = NIL;
    rtoc_self_view.list_res_symbols = {};
}
END
PUB FN pipelineRewriter__rewrite_mut(MUTABLE self: PipelineRewriter, MUTABLE node: Locatable) RETURNS !Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (IF node IS_A BinaryOp AS binary_op THEN binaryOp__smooth?(binary_op) ELSE FALSE END) THEN
      RETURN TRY (pipelineRewriter__rewrite_pipeline(&rtoc_self_view, castLocatableToBinaryOp__pipeline_rewriter(node)));
    END
    RETURN TRY (pipelineRewriter__rewrite_children_mut(&rtoc_self_view, &node));
}
END
PRIVATE FN pipelineRewriter__next_var(MUTABLE self: PipelineRewriter, prefix: String = "__v") RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.var_counter = (rtoc_self_view.var_counter + 1);
    RETURN "${prefix}${rtoc_self_view.var_counter.toString()}";
}
END
PRIVATE FN pipelineRewriter__rewrite_children_mut(MUTABLE self: PipelineRewriter, MUTABLE node: Locatable) RETURNS !Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (node IS_A Program) THEN
      node.statements = node.statements() |> SELECT TRY (pipelineRewriter__rewrite_mut(&rtoc_self_view, &_));
    ELSE_IF node IS_A FunctionDef AS function_def THEN
      MUTABLE function_def_mutable = COPY function_def;
      function_def_mutable.body = function_def_mutable.body |> SELECT TRY (pipelineRewriter__rewrite_mut(&rtoc_self_view, &_));
    ELSE_IF node IS_A VarDecl AS var_decl THEN
      MUTABLE var_decl_mutable = COPY var_decl;
      MUTABLE prev_dest: ?String@symbol = COPY rtoc_self_view.dest_storage;
      rtoc_self_view.dest_storage = (IF (IF var_decl_mutable.symbol != NIL THEN
        symbolEntry__storage(var_decl_mutable.symbol)
      ELSE
        NIL
      END) != NIL THEN (IF var_decl_mutable.symbol != NIL THEN
        symbolEntry__storage(var_decl_mutable.symbol)
      ELSE
        NIL
      END) ELSE var_decl_mutable.storage() END);
      DEFER rtoc_self_view.dest_storage = prev_dest;
      var_decl_mutable.value = castOptionalLocatableToLiteral(TRY (pipelineRewriter__rewrite_optional_node(&rtoc_self_view, Locatable{ Literal: COPY var_decl_mutable.value })));
    ELSE_IF node IS_A BindExpr AS bind_expr THEN
      MUTABLE bind_expr_mutable = COPY bind_expr;
      MUTABLE prev_dest: ?String@symbol = COPY rtoc_self_view.dest_storage;
      rtoc_self_view.dest_storage = (IF bind_expr_mutable.symbol != NIL THEN
        symbolEntry__storage(bind_expr_mutable.symbol)
      ELSE
        NIL
      END);
      DEFER rtoc_self_view.dest_storage = prev_dest;
      bind_expr_mutable.value = TRY (pipelineRewriter__rewrite_optional_node(&rtoc_self_view, bind_expr_mutable.value));
    ELSE_IF node IS_A Assignment AS assignment THEN
      MUTABLE assignment_mutable = COPY assignment;
      MUTABLE prev_dest: ?String@symbol = COPY rtoc_self_view.dest_storage;
      rtoc_self_view.dest_storage = (IF assignment_mutable.symbol != NIL THEN
        symbolEntry__storage(assignment_mutable.symbol)
      ELSE
        NIL
      END);
      DEFER rtoc_self_view.dest_storage = prev_dest;
      assignment_mutable.value = UNWRAP (TRY (pipelineRewriter__rewrite_optional_node(&rtoc_self_view, assignment_mutable.value)));
    ELSE_IF node IS_A ReturnNode AS return_node THEN
      MUTABLE return_node_mutable = COPY return_node;
      MUTABLE prev_dest: ?String@symbol = COPY rtoc_self_view.dest_storage;
      rtoc_self_view.dest_storage = :heap;
      DEFER rtoc_self_view.dest_storage = prev_dest;
      return_node_mutable.value = TRY (pipelineRewriter__rewrite_optional_node(&rtoc_self_view, return_node_mutable.value));
    ELSE_IF node IS_A DestructuringAssignment AS destructuring_assignment THEN
      MUTABLE destructuring_assignment_mutable = COPY destructuring_assignment;
      destructuring_assignment_mutable.value = TRY (pipelineRewriter__rewrite_optional_node(&rtoc_self_view, destructuring_assignment_mutable.value));
    ELSE_IF node IS_A IfStatement AS if_statement THEN
      MUTABLE if_statement_mutable = COPY if_statement;
      if_statement_mutable.condition = TRY (pipelineRewriter__rewrite_mut(&rtoc_self_view, if_statement_mutable.condition));
      MUTABLE then_branch = COPY if_statement_mutable.then_branch;
      MUTABLE else_branch: ?[]Locatable = COPY if_statement_mutable.else_branch;
      IF then_branch THEN
        then_branch = then_branch |> SELECT TRY (pipelineRewriter__rewrite_mut(&rtoc_self_view, &_));
      END
      IF else_branch EXISTS AS else_branch_value THEN
        MUTABLE else_branch_value_mutable = COPY else_branch_value;
        else_branch_value_mutable = else_branch_value_mutable |> SELECT TRY (pipelineRewriter__rewrite_mut(&rtoc_self_view, &_));
      END
    ELSE_IF node IS_A MatchStatement AS match_statement THEN
      MUTABLE match_statement_mutable = COPY match_statement;
      match_statement_mutable.expr = TRY (pipelineRewriter__rewrite_mut(&rtoc_self_view, matchStatement__expr(match_statement_mutable)));
      FOR _ IN match_statement_mutable.cases DO
    MUTABLE body = COPY TRY (matchCase__body(_));
    IF body THEN
          body = body |> SELECT TRY (pipelineRewriter__rewrite_mut(&rtoc_self_view, &_));
    END
      END
      MUTABLE default_case: ?[]Locatable = COPY match_statement_mutable.default_case;
      IF default_case EXISTS AS default_case_value THEN
        MUTABLE default_case_value_mutable = COPY default_case_value;
        default_case_value_mutable = default_case_value_mutable |> SELECT TRY (pipelineRewriter__rewrite_mut(&rtoc_self_view, &_));
      END
    ELSE_IF node IS_A WhileLoop AS while_loop THEN
      MUTABLE while_loop_mutable = COPY while_loop;
      while_loop_mutable.condition = TRY (pipelineRewriter__rewrite_mut(&rtoc_self_view, while_loop_mutable.condition));
      MUTABLE do_branch = COPY while_loop_mutable.do_branch;
      IF do_branch IS_A []Any THEN
        do_branch = do_branch |> SELECT TRY (pipelineRewriter__rewrite_mut(&rtoc_self_view, &_));
      END
    ELSE_IF node IS_A ForRange AS for_range THEN
      MUTABLE for_range_mutable = COPY for_range;
      for_range_mutable.start_expr = TRY (pipelineRewriter__rewrite_mut(&rtoc_self_view, for_range_mutable.start_expr));
      for_range_mutable.end_expr = TRY (pipelineRewriter__rewrite_mut(&rtoc_self_view, for_range_mutable.end_expr));
      for_range_mutable.body = for_range_mutable.body |> SELECT TRY (pipelineRewriter__rewrite_mut(&rtoc_self_view, &_));
    ELSE_IF node IS_A ForEach AS for_each THEN
      MUTABLE for_each_mutable = COPY for_each;
      for_each_mutable.collection = TRY (pipelineRewriter__rewrite_mut(&rtoc_self_view, for_each_mutable.collection));
      for_each_mutable.body = for_each_mutable.body |> SELECT TRY (pipelineRewriter__rewrite_mut(&rtoc_self_view, &_));
    ELSE_IF node IS_A BinaryOp AS binary_op THEN
      MUTABLE binary_op_mutable = COPY binary_op;
      binary_op_mutable.left = TRY (pipelineRewriter__rewrite_mut(&rtoc_self_view, binary_op_mutable.left));
      binary_op_mutable.right = TRY (pipelineRewriter__rewrite_mut(&rtoc_self_view, binary_op_mutable.right));
    ELSE_IF (node IS_A UnaryOp) THEN
      node.right = TRY (pipelineRewriter__rewrite_mut(&rtoc_self_view, aST__node_right(node)));
    ELSE_IF (node IS_A FuncCall) OR (node IS_A MethodCall) THEN
      node.args = locatable__args(node) |> SELECT TRY (pipelineRewriter__rewrite_call_argument(&rtoc_self_view, _));
    ELSE_IF node IS_A StructLit AS struct_lit THEN
      MUTABLE struct_lit_mutable = COPY struct_lit;
      FOR rtoc_key IN struct_lit_mutable.fields.keys() DO
    MUTABLE v: Any = COPY UNWRAP (struct_lit_mutable.fields[rtoc_key]);
      struct_lit_mutable.fields[rtoc_key] = TRY (pipelineRewriter__rewrite_struct_field(&rtoc_self_view, v));
      END
    ELSE_IF node IS_A ListLit AS list_lit THEN
      MUTABLE list_lit_mutable = COPY list_lit;
      list_lit_mutable.items = list_lit_mutable.items |> SELECT TRY (pipelineRewriter__rewrite_mut(&rtoc_self_view, &_));
    ELSE_IF (node IS_A BlockExpr) THEN
      node.body = node.body() |> SELECT TRY (pipelineRewriter__rewrite_mut(&rtoc_self_view, &_));
      node.result = TRY (pipelineRewriter__rewrite_optional_node(&rtoc_self_view, node.result()));
    END
    RETURN COPY node;
}
END
PRIVATE FN pipelineRewriter__rewrite_optional_node(MUTABLE self: PipelineRewriter, value: ?Locatable) RETURNS !?Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF value EXISTS AS value_value THEN
      MUTABLE value_value_mutable = COPY value_value;
      RETURN TRY (pipelineRewriter__rewrite_mut(&rtoc_self_view, &value_value_mutable));
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN pipelineRewriter__rewrite_call_argument(MUTABLE self: PipelineRewriter, argument: Locatable) RETURNS !Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE moved = aST__moved?(argument);
  MUTABLE prev_dest: ?String@symbol = COPY rtoc_self_view.dest_storage;
  DEFER rtoc_self_view.dest_storage = prev_dest;
  rtoc_self_view.dest_storage = IF moved THEN
      :heap
    ELSE
      NIL
    END;
  MUTABLE replaced = TRY (pipelineRewriter__rewrite_mut(&rtoc_self_view, &argument));
  IF (moved AND respondsTo?(replaced, "was_moved=")) THEN
      replaced.was_moved = TRUE;
      RETURN TRUE;
  END
  RETURN replaced;
}
END
PRIVATE FN pipelineRewriter__rewrite_struct_field(MUTABLE self: PipelineRewriter, value: Locatable) RETURNS !Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE prev_dest: ?String@symbol = COPY rtoc_self_view.dest_storage;
  DEFER rtoc_self_view.dest_storage = prev_dest;
  rtoc_self_view.dest_storage = :heap;
  RETURN TRY (pipelineRewriter__rewrite_mut(&rtoc_self_view, &value));
}
END
PRIVATE FN pipelineRewriter__rewrite_pipeline(MUTABLE self: PipelineRewriter, MUTABLE node: BinaryOp) RETURNS !Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lhs_node = NIL;
    MUTABLE source = COPY node.left;
    MUTABLE rhs = COPY node.right;
    MUTABLE chain = pipelineRewriter__collect_chain(rtoc_self_view, node);
    MUTABLE stages = COPY chain.stages;
    MUTABLE terminal: ?Locatable = COPY chain.terminal;
    MUTABLE real_source = COPY chain.source;
    IF pipelineRewriter__binding_source?(rtoc_self_view, real_source) THEN
      RETURN COPY Locatable{ BinaryOp: COPY node };
    END
    real_source = TRY (pipelineRewriter__rewrite_mut(&rtoc_self_view, &real_source));
    IF (pipelineRewriter__needs_transpiler_pipeline?(rtoc_self_view, &real_source) OR ((IF real_source IS_A BinaryOp AS binary_op THEN binaryOp__smooth?(binary_op) ELSE FALSE END))) THEN
        pipelineRewriter__patch_chain_source_mut(rtoc_self_view, node, real_source);
      RETURN COPY Locatable{ BinaryOp: COPY node };
    END
    MUTABLE is_range_fold_terminal = (((terminal != NIL) AND (terminal IS_A EachOp)) OR aST__pipeline_terminal_fold?(terminal));
    MUTABLE source_type = &real_source.full_type_mut();
    MUTABLE has_limit = stages |> ANY _ IS_A LimitOp;
    IF (TRY (type__canonical_stream_result?((TRY (type__new(TypeConstructionInput{ Type: COPY &node.full_type_mut() }))))) AND (stages |> ANY _ IS_A SelectOp)) THEN
        pipelineRewriter__patch_chain_source_mut(rtoc_self_view, node, real_source);
      RETURN COPY Locatable{ BinaryOp: COPY node };
    END
    IF (is_range_fold_terminal AND (stages |> ALL aST__pipeline_fusible_stage?(_))) THEN
      IF (real_source IS_A RangeLit OR TRY (type__bounded_pipeline_stream_source?(source_type, has_limit))) THEN
          pipelineRewriter__patch_chain_source_mut(rtoc_self_view, node, real_source);
        RETURN COPY Locatable{ BinaryOp: COPY node };
      END
    END
    IF (IF terminal? IS_A DistinctOp AS distinct_op THEN (stages |> ALL aST__pipeline_fusible_stage?(_)) ELSE FALSE END) THEN
        pipelineRewriter__patch_chain_source_mut(rtoc_self_view, node, real_source);
      RETURN COPY Locatable{ BinaryOp: COPY node };
    END
    MUTABLE is_stream_index = ((IF terminal? IS_A IndexOp AS index_op THEN TRY (type__bounded_pipeline_stream_source?(source_type, has_limit)) ELSE FALSE END) AND (stages |> ALL aST__pipeline_fusible_stage?(_)));
    IF is_stream_index THEN
        pipelineRewriter__patch_chain_source_mut(rtoc_self_view, node, real_source);
      RETURN COPY Locatable{ BinaryOp: COPY node };
    END
    MUTABLE is_fold = ((((terminal == NIL) OR (((terminal?) != NIL) AND ((terminal?) IS_A EachOp))) OR aST__pipeline_terminal_fold?(terminal)) OR aST__pipeline_list_terminal?(terminal));
    IF ((stages.length() > 0) OR ((is_fold AND (terminal != NIL)))) THEN
      IF is_fold THEN
        RETURN TRY (pipelineRewriter__fuse_pipeline(&rtoc_self_view, &node, &real_source, stages, &terminal));
      ELSE
        MUTABLE list_proxy = COPY node;
        MUTABLE rtoc_union_writeback_1: Locatable = Locatable{ BinaryOp: COPY list_proxy };
        TRY (aST__stamp_synthetic_type_mut(&rtoc_union_writeback_1, &real_source.full_type_mut(), "synthetic AST type"));
        PARTIAL MATCH rtoc_union_writeback_1 START Locatable.BinaryOp AS rtoc_union_writeback_1_item -> list_proxy = COPY rtoc_union_writeback_1_item;, END
        NIL;
        list_proxy.storage = locatable__storage(real_source);
        MUTABLE fused_loop = TRY (pipelineRewriter__fuse_pipeline(&rtoc_self_view, &list_proxy, &real_source, stages, NIL));
        MUTABLE outer_smooth = BinaryOp{ token: COPY node.token, left: COPY fused_loop, op: :SMOOTH, right: UNWRAP (COPY terminal), paren_bind: NIL, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, string_concat: NIL, or_fallback_dupe: NIL, error_union_type: NIL, observable_terminal: NIL, observable_dest: NIL, retain_error_channel: NIL };
        MUTABLE rtoc_union_writeback_2: Locatable = Locatable{ BinaryOp: COPY outer_smooth };
        TRY (aST__stamp_synthetic_type_mut(&rtoc_union_writeback_2, SyntheticTypeInput{ Type: COPY &node.full_type_mut() }, "synthetic AST type"));
        PARTIAL MATCH rtoc_union_writeback_2 START Locatable.BinaryOp AS rtoc_union_writeback_2_item -> outer_smooth = COPY rtoc_union_writeback_2_item;, END
        NIL;
        outer_smooth.storage = node.storage();
        RETURN TRY (pipelineRewriter__rewrite_pipeline(&rtoc_self_view, &outer_smooth));
      END
    END
    source = real_source;
    MUTABLE result_is_error = type__error_union?((TRY (type__new(TypeConstructionInput{ Type: COPY &node.full_type_mut() }))));
    result_is_error = (result_is_error OR pipelineRewriter__callee_returns_error?(rtoc_self_view, &rhs));
    MUTABLE needs_try = type__error_union?((TRY (type__new(&source.full_type_mut()))));
    IF (IF rhs IS_A FuncCall AS func_call THEN !(result_is_error) ELSE FALSE END) THEN
      IF needs_try THEN
        lhs_node = UnaryOp{ token: COPY rhs.token(), op: :TRY, right: COPY source, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
      ELSE
        lhs_node = COPY source;
      END
      IF needs_try THEN
        TRY (aST__stamp_synthetic_type_mut(&lhs_node, SyntheticTypeInput{ Type: COPY UNWRAP (TRY (type__payload_type((TRY (type__new(&source.full_type_mut())))))) }, "synthetic AST type"));
      END
      rhs.args().unshift(lhs_node);
      RETURN rhs;
    END
    IF (IF rhs IS_A Identifier AS identifier THEN !(result_is_error) ELSE FALSE END) THEN
      IF needs_try THEN
        lhs_node = UnaryOp{ token: COPY rhs.token(), op: :TRY, right: COPY source, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
      ELSE
        lhs_node = COPY source;
      END
      IF needs_try THEN
        TRY (aST__stamp_synthetic_type_mut(&lhs_node, SyntheticTypeInput{ Type: COPY UNWRAP (TRY (type__payload_type((TRY (type__new(&source.full_type_mut())))))) }, "synthetic AST type"));
      END
      MUTABLE call = FuncCall{ token: COPY rhs.token(), name: rhs.name(), args: COPY [lhs_node], can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, explicit_mutable_argument_tokens: NIL, module_alias: NIL, extern_call: NIL, extern_effects: NIL, extern_source: NIL, generic_type_args: NIL, fn_var_call: NIL, pipe_lhs: NIL, heap_dupe_result: NIL, arg_families: NIL, collapsed_errors: NIL, error_union_type: NIL, protocol_name: NIL, protocol_operation: NIL, protocol_receiver_index: NIL, retain_error_channel: NIL };
      MUTABLE rtoc_union_writeback_3: Locatable = Locatable{ FuncCall: COPY call };
      TRY (aST__stamp_synthetic_type_mut(&rtoc_union_writeback_3, SyntheticTypeInput{ Type: COPY &node.full_type_mut() }, "synthetic AST type"));
      PARTIAL MATCH rtoc_union_writeback_3 START Locatable.FuncCall AS rtoc_union_writeback_3_item -> call = COPY rtoc_union_writeback_3_item;, END
      NIL;
      call.storage = node.storage();
      MUTABLE config: ?LookupResult = TRY (intrinsicRegistry__lookup(std_lib, RegistryKey{ StringValue: COPY CAST(rhs.name() AS String) }));
      MUTABLE sig0_branch_value: ?FunctionSignature@multiowned = NIL;
      IF config? IS_A []FunctionSignature@multiowned AS array THEN
        sig0_branch_value = COPY array.first();
      ELSE
        sig0_branch_value = functionSignature__unwrap(castOptionalLookupResultToOptionalX__pipeline_rewriter(config));
      END
      MUTABLE sig0: ?FunctionSignature@multiowned = sig0_branch_value;
      IF sig0 EXISTS AS sig0_value THEN
        MUTABLE sig0_value_mutable = COPY sig0_value;
        call.zig_pattern = castOptionalFunctionSignatureReturnValueToOptionalStringSymbol__pipeline_rewriter(TRY (functionSignature__intrinsic_pattern(&sig0_value_mutable)));
      END
      RETURN Locatable{ FuncCall: COPY call };
