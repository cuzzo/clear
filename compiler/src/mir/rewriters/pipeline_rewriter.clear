        symbolEntry__storage(UNWRAP (bind_expr_mutable.symbol))
      ELSE
        NIL
      END);
      DEFER self.dest_storage = prev_dest;
      IF TRY (pipelineRewriter__rewrite_optional_node(&self, bind_expr_mutable.value)) EXISTS AS rewritten_bind_expr_mutable THEN
        bind_expr_mutable.value = COPY CAST(rewritten_bind_expr_mutable AS Locatable);
