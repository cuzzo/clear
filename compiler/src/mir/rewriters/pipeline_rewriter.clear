PRIVATE FN pipelineRewriter__schema_lookup(MUTABLE self: PipelineRewriter) RETURNS Any@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.schema_lookup = (rtoc_self_view.schema_lookup OR_ELSE %(name) USE(rtoc_self_view) -> (IF rtoc_self_view.annotator != NIL THEN
      rtoc_self_view.annotator.lookup_type_schema(name)
    ELSE
      NIL
    END));
    RETURN UNWRAP (rtoc_self_view.schema_lookup);
}
END
PRIVATE FN pipelineRewriter__callee_returns_error?(self: PipelineRewriter, MUTABLE rhs: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE ti = &rhs.full_type_mut("pipeline callee");
    MUTABLE function_type = type__function_type(ti);
    IF function_type THEN
      RETURN type__error_union?(functionSignature__return_type(function_type));
    END
    MUTABLE signature: ?FunctionSignature@multiowned = functionSignature__unwrap(ti);
    IF type__error_union?((IF signature != NIL THEN
      functionSignature__return_type(signature)
    ELSE
      NIL
    END)) != NIL THEN
    RETURN (type__error_union?((IF signature != NIL THEN
      functionSignature__return_type(signature)
    ELSE
      NIL
    END)))?;
    ELSE
    RETURN FALSE;
    END
}
END
PRIVATE FN pipelineRewriter__needs_transpiler_pipeline?(self: PipelineRewriter, MUTABLE source: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE ti = &source.full_type_mut("pipeline source");
    RETURN ((ti.pool?() OR type__soa?(ti)) OR type__sharded?(ti));
}
END
PRIVATE FN pipelineRewriter__patch_chain_source_mut(self: PipelineRewriter, node: BinaryOp, new_source: Locatable) RETURNS Locatable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE cursor: BinaryOp = COPY node;
    WHILE (cursor.left IS_A BinaryOp AND cursor.left.smooth?()) DO
      cursor = COPY castLocatableToBinaryOp__pipeline_rewriter(cursor.left);
    END
    cursor.left = COPY new_source;
    RETURN new_source;
}
END
PRIVATE FN pipelineRewriter__replace_named_placeholder(self: PipelineRewriter, node: Locatable, name: String, replacement: Identifier) RETURNS Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (IF node IS_A Identifier AS identifier THEN (identifier__name(identifier) == name) ELSE FALSE END) THEN
      RETURN Locatable{ Identifier: COPY replacement };
    END
    RETURN locatable__map_children(node, %(rtoc_child: Locatable) USE(rtoc_self_view, name, replacement) -> pipelineRewriter__replace_named_placeholder(rtoc_self_view, rtoc_child, name, replacement));
}
END
PRIVATE FN pipelineRewriter__replace_placeholder(self: PipelineRewriter, node: Locatable, replacement: Identifier) RETURNS Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (node IS_A Placeholder OR ((IF node IS_A Identifier AS identifier THEN (identifier__name(identifier) == "_") ELSE FALSE END))) THEN
      RETURN Locatable{ Identifier: COPY replacement };
    END
    IF (IF node IS_A BinaryOp AS binary_op THEN binaryOp__smooth?(binary_op) ELSE FALSE END) THEN
      MUTABLE new_node = COPY node;
      new_node.left = pipelineRewriter__replace_placeholder(rtoc_self_view, node.left(), replacement);
      new_node.right = pipelineRewriter__clone_ast_node(rtoc_self_view, aST__node_right(node));
      RETURN new_node;
    END
    RETURN locatable__map_children(node, %(rtoc_child: Locatable) USE(rtoc_self_view, replacement) -> pipelineRewriter__replace_placeholder(rtoc_self_view, rtoc_child, replacement));
}
END
PRIVATE FN pipelineRewriter__clone_ast_node(self: PipelineRewriter, node: Locatable) RETURNS Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE new_node = COPY node;
    RETURN new_node;
}
END
PUB FN pipelineRewriter__new(annotator: ?SemanticAnnotator = NIL) RETURNS PipelineRewriter@multiowned ->
  MUTABLE self = PipelineRewriter{ annotator: COPY annotator, dest_storage: NIL, list_res_symbols: {}, reduce_acc_symbols: {}, schema_lookup: NIL, var_counter: 0 };
  pipelineRewriter__initialize(&self, annotator);
  RETURN self @multiowned;
END
FN castLocatableToBinaryOp__pipeline_rewriter(value: Locatable) RETURNS BinaryOp ->
  IF value IS_A BinaryOp AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to BinaryOp");
END
FN castLocatableToLiteral__pipeline_rewriter(value: Locatable) RETURNS Literal ->
  IF value IS_A Literal AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to Literal");
END
FN castOptionalFunctionSignatureReturnValueToOptionalStringSymbol__pipeline_rewriter(value: ?FunctionSignatureReturnValue) RETURNS ?String@symbol ->
  IF value != NIL THEN
    IF value IS_A String@symbol AS cast_payload THEN
      RETURN cast_payload;
    END
  END
  RETURN NIL;
END
FN castOptionalLocatableToLiteral(value: ?Locatable) RETURNS Literal ->
  IF value != NIL THEN
    IF value IS_A Literal AS cast_payload THEN
      RETURN cast_payload;
    END
  END
  RETURN panic("Invalid cast to Literal");
END
FN castOptionalLookupResultToOptionalX__pipeline_rewriter(value: ?LookupResult) RETURNS ?X ->
  IF value == NIL THEN
    panic("Invalid cast to ?X");
  END
  PARTIAL MATCH value? START
    LookupResult.FunctionSignatureMultiowned AS cast_payload -> RETURN X{ FunctionSignatureMultiowned: COPY cast_payload };,
    LookupResult.ArrayValue AS cast_payload -> RETURN X{ ArrayValue: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to ?X");
  END
  panic("Invalid cast to ?X");
END
FN ruby_array_concat_Any__pipeline_rewriter(left: []Any, right: []Any) RETURNS []Any ->
  MUTABLE result: []Any = [];
  left |> EACH { &result.append(COPY _); };
  right |> EACH { &result.append(COPY _); };
  RETURN result;
END
