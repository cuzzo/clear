      MUTABLE rtoc_union_writeback_4: Locatable = Locatable{ BinaryOp: COPY op };
      TRY (aST__stamp_synthetic_type_mut(&rtoc_union_writeback_4, SyntheticTypeInput{ Type: COPY &node.full_type_mut() }, "synthetic AST type"));
      PARTIAL MATCH rtoc_union_writeback_4 START Locatable.BinaryOp AS rtoc_union_writeback_4_item -> op = COPY rtoc_union_writeback_4_item;, END
      NIL;
      op.storage = node.storage();
