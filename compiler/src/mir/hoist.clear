# Ruby module MIRHoistFacts
PUB FN mIRHoistFacts__container_borrow_expr?(ast_node: ?Locatable) RETURNS Bool EFFECTS REENTRANT ->
  IF ast_node EXISTS AS ast_node_value THEN
    IF (IF ast_node_value IS_A BinaryOp AS binary_op THEN (((binary_op.op == symbol("OR")) OR (binary_op.op == symbol("OR_ELSE")))) ELSE FALSE END) THEN
      RETURN mIRHoistFacts__container_borrow_expr?(aST__node_left(ast_node_value));
    END
    RETURN (TRUE AND (aST__node__container_borrow(ast_node_value) == TRUE));
  ELSE
    RETURN FALSE;
  END
END
# End Ruby module MIRHoistFacts
# Ruby module Hoist
PUB UNION CallLike { FuncCall: FuncCall, MethodCall: MethodCall }
PUB STRUCT HoistCounter {
  value: Int64
}

PUB FN hoistCounter__next_name(MUTABLE self: HoistCounter) RETURNS String ->
  MUTABLE next_value = (self.value + 1);
  self.value = next_value;
  RETURN "__hoist_${next_value.toString()}";
END
PUB STRUCT HoistResult {
  bindings_by_function: {String}[]VarDecl
}

PUB FN result__empty?(self: HoistResult) RETURNS Bool EFFECTS REENTRANT ->
  RETURN (self.bindings_by_function.count() == 0);
END
PUB FN hoist__apply_mut(ast: Program, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL) RETURNS !HoistResult ->
  MUTABLE hoist_pass_state = mIRPassState__for_mut(PassStateProgram{ Program: COPY ast });
  TRY (mIRPassState__require_mut(hoist_pass_state, :string_concat_rewritten, "Hoist"));
  MUTABLE bindings_by_function: {String}[]VarDecl = {};
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < ast.statements.length() DO
    MUTABLE stmt: Locatable = COPY UNWRAP (ast.statements[rtoc_idx]);
    IF stmt IS_A FunctionDef AS fn_stmt THEN
      IF !(hoist__synthesized_body?(fn_stmt)) THEN
        MUTABLE counter = HoistCounter{ value: 0 };
        MUTABLE generated: []VarDecl = ( { MUTABLE rtoc_empty_list_1: []VarDecl = List[]; rtoc_empty_list_1 } );
        MUTABLE fn_return: ?Type = COPY fn_stmt.return_type;
        TRY (hoist__hoist_body_mut(COPY fn_stmt.body, counter, schema_lookup, &generated, castTypeToOptionalTypeTypeInput(fn_return)));
        IF !((generated.length() == 0)) THEN
          bindings_by_function[fn_stmt.name] = generated;
        END
      END
    END
  rtoc_idx = rtoc_idx + 1;
  END
  MUTABLE rtoc_mutable_receiver_2 = mIRPassState__for_mut(PassStateProgram{ Program: COPY ast });
  TRY (mIRPassState__mark_mut(&rtoc_mutable_receiver_2, :hoisted));
  RETURN HoistResult{ bindings_by_function: COPY bindings_by_function };
END
PRIVATE FN hoist__synthesized_body?(fn_value: FunctionDef) RETURNS Bool ->
  RETURN !(!(((((TRUE AND fn_value.thunk_plan)) OR ((TRUE AND fn_value.mutual_thunk_plan))))));
END
PRIVATE FN hoist__hoist_body_mut(MUTABLE body: []Locatable, counter: HoistCounter, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult, MUTABLE generated: []VarDecl, return_type: ?TypeTypeInput = NIL) RETURNS !Void EFFECTS REENTRANT ->
  IF !(TRUE) THEN
    RETURN;
  END
  MUTABLE i = 0;
  WHILE (i < body.length()) DO
    MUTABLE stmt = COPY UNWRAP (body[i]);
    MUTABLE hoists: []VarDecl = ( { MUTABLE rtoc_empty_list_3: []VarDecl = List[]; rtoc_empty_list_3 } );
    TRY (hoist__collect_stmt_hoists_mut(&stmt, &hoists, counter, schema_lookup, return_type));
    IF !((hoists.length() == 0)) THEN
      MUTABLE rebuilt: []Locatable = ( { MUTABLE rtoc_rebuilt_list: []Locatable = List[]; rtoc_rebuilt_list } );
      MUTABLE copy_idx = 0;
      WHILE (copy_idx < i) DO
        &rebuilt.append(COPY UNWRAP (body[copy_idx]));
        copy_idx = (copy_idx + 1);
      END
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < hoists.length() DO
        &rebuilt.append(Locatable{ VarDecl: COPY UNWRAP (hoists[rtoc_idx]) });
        rtoc_idx = (rtoc_idx + 1);
      END
      WHILE (copy_idx < body.length()) DO
        &rebuilt.append(COPY UNWRAP (body[copy_idx]));
        copy_idx = (copy_idx + 1);
      END
      body = rebuilt;
    END
    generated = ruby_array_concat_VarDecl(generated, hoists);
    i = (i + hoists.length());
    FOR _ IN (TRY (hoist__child_bodies(stmt))) DO
  MUTABLE rtoc_mutable_block_param_4 = COPY _;
    TRY (hoist__hoist_body_mut(&rtoc_mutable_block_param_4, counter, schema_lookup, &generated, return_type));
    END
    i = (i + 1);
  END
  NIL;
END
PUB FN hoist__child_bodies(stmt: Locatable) RETURNS ![][]Node ->
  IF (stmt IS_A ForRange) OR (stmt IS_A ForEach) OR (stmt IS_A WithBlock) OR (stmt IS_A BgBlock) OR (stmt IS_A BgStreamBlock) THEN
    RETURN CAST([stmt.body()] AS [][]Node);
  ELSE_IF stmt IS_A WhileLoop AS while_loop THEN
    RETURN CAST([while_loop.do_branch] AS [][]Node);
  ELSE_IF stmt IS_A WhileBindLoop AS while_bind_loop THEN
    RETURN CAST([while_bind_loop.do_branch] AS [][]Node);
  ELSE_IF stmt IS_A IfStatement AS if_statement THEN
    RETURN (CAST(Tuple{if_statement.then_branch, if_statement.else_branch} AS Tuple<[]Locatable, ?[]Locatable>));
  ELSE_IF stmt IS_A IfBind AS if_bind THEN
    RETURN ([if_bind.then_branch, if_bind.else_branch]);
  ELSE_IF stmt IS_A MatchStatement AS match_statement THEN
    RETURN ((match_statement.cases |> SELECT matchCase__body(_)) + ([match_statement.default_case]));
  ELSE_IF (stmt IS_A DoBlock) THEN
    RETURN stmt.branches() |> SELECT _.body();
  ELSE
    RETURN CAST(( { MUTABLE rtoc_empty_list_5: [][]Node = List[]; rtoc_empty_list_5 } ) AS [][]Node);
  END
END
PRIVATE FN hoist__collect_stmt_hoists_mut(MUTABLE stmt: Locatable, MUTABLE hoists: []VarDecl, counter: HoistCounter, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult, return_type: ?TypeTypeInput = NIL) RETURNS !Void ->
  TRY (hoist__each_call(stmt, %(call: CallLike) USE(MUTABLE counter, MUTABLE hoists, schema_lookup, MUTABLE expected) -> {
  IF (IF call IS_A MethodCall AS method_call THEN TRY (hoist__collection_value_store_call?(method_call)) ELSE FALSE END) THEN
      RETURN;
  END
  MUTABLE rtoc_each_items_6 = (MATCH call START CallLike.FuncCall AS item -> item.args, CallLike.MethodCall AS item -> item.args END);
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < rtoc_each_items_6.length() DO
      IF (rtoc_each_items_6[rtoc_idx] IS_A MoveNode AND rtoc_each_items_6[rtoc_idx].value() IS_A Identifier) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !(hoist__allocating?(&rtoc_each_items_6[rtoc_idx], schema_lookup)) THEN
          RETURN;
      END
      MUTABLE expected_branch_value: ?Type = NIL;
        IF hoist__empty_list_literal?(rtoc_each_items_6[rtoc_idx]) THEN
          expected_branch_value = CAST(hoist__callee_param_type(castCallLikeToLocatable(call), rtoc_idx) AS ?Type);
        ELSE
          expected_branch_value = NIL;
        END
      MUTABLE expected: ?Type = expected_branch_value;
      MUTABLE replacement = TRY (hoist__make_temp_mut(rtoc_each_items_6[rtoc_idx], &hoists, hoistCounter__next_name(&counter), hoist__moved_arg?(rtoc_each_items_6[rtoc_idx]), ruby_wrap_optional_Type_TypeTypeInput(expected), schema_lookup));
      IF call IS_A FuncCall AS func_call THEN
          func_call.args[rtoc_idx] = replacement;
      ELSE_IF call IS_A MethodCall AS method_call THEN
          method_call.args[rtoc_idx] = replacement;
      END
    rtoc_idx = rtoc_idx + 1;
  END
  rubyToClearVoid()
  }));
  TRY (hoist__each_method_call(stmt, %(call: MethodCall) USE(MUTABLE counter, MUTABLE hoists) -> {
  IF !(TRY (hoist__collection_value_store_call?(call))) THEN
      RETURN;
  END
  IF !(TRY (hoist__composite_element_store?(call))) THEN
      RETURN;
  END
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < call.args.length() DO
    IF hoist__concat?(call.args[rtoc_idx]) THEN
        call.args[rtoc_idx] = TRY (hoist__make_temp_mut(call.args[rtoc_idx], &hoists, hoistCounter__next_name(&counter)));
    ELSE
        TRY (hoist__hoist_concats_within_mut(call.args[rtoc_idx], hoists, counter));
    END
    rtoc_idx = rtoc_idx + 1;
  END
  rubyToClearVoid()
  }));
  IF stmt IS_A ReturnNode AS return_node THEN
    MUTABLE return_node_mutable = COPY return_node;
    IF !(return_node_mutable.value) THEN
      RETURN;
    END
    MUTABLE expected: ?Type = TRY (type__from_node(return_type));
    IF expected EXISTS AS expected_value THEN
      MUTABLE expected_value = TRY (type__success_type(expected_value));
    END
    MUTABLE value_type = TRY (type__from_node_mut(return_node_mutable.value, "return value hoist"));
    IF (((value_type != NIL) AND type__collection?((value_type?))) AND !(hoist__empty_list_literal?(return_node_mutable.value))) THEN
      expected = COPY value_type;
    END
    IF (return_node_mutable.value IS_A BinaryOp AND (((return_node_mutable.value.op() == symbol("OR")) OR (return_node_mutable.value.op() == symbol("OR_ELSE"))))) THEN
      MUTABLE right_type_branch_value: ?Type = NIL;
      IF return_node_mutable.value.right() IS_A Locatable THEN
        right_type_branch_value = return_node_mutable.value.right().full_type_mut();
      ELSE
        right_type_branch_value = TRY (type__from_node_mut(return_node_mutable.value.right(), "return OR right hoist"));
      END
      MUTABLE right_type: Type = right_type_branch_value?;
      IF type__collection?(right_type) THEN
        expected = COPY right_type;
      END
    END
    return_node_mutable.value = TRY (hoist__hoist_escape_value_mut(return_node_mutable.value, hoists, counter, schema_lookup, ruby_wrap_optional_Type_TypeTypeInput(expected)));
  ELSE_IF stmt IS_A YieldExpr AS yield_expr THEN
    MUTABLE yield_expr_mutable = COPY yield_expr;
    IF yieldExpr__expr(yield_expr_mutable) THEN
      yield_expr_mutable.expr = TRY (hoist__hoist_escape_value_mut(yieldExpr__expr(yield_expr_mutable), hoists, counter, schema_lookup));
    END
  ELSE_IF stmt IS_A Assignment AS assignment THEN
    MUTABLE assignment_mutable = COPY assignment;
    IF assignment_mutable.name IS_A GetField THEN
      IF assignment_mutable.value THEN
        assignment_mutable.value = TRY (hoist__hoist_escape_value_mut(assignment_mutable.value, hoists, counter, schema_lookup, &assignment_mutable.name.full_type_mut("field assignment hoist destination")));
      END
    END
  ELSE_IF stmt IS_A DestructuringAssignment AS destructuring_assignment THEN
    MUTABLE destructuring_assignment_mutable = COPY destructuring_assignment;
    IF destructuring_assignment_mutable.value THEN
      destructuring_assignment_mutable.value = TRY (hoist__hoist_escape_value_mut(destructuring_assignment_mutable.value, hoists, counter, schema_lookup));
    END
  END
  NIL;
END
PRIVATE FN hoist__hoist_escape_value_mut(MUTABLE value: Locatable, MUTABLE hoists: []VarDecl, counter: HoistCounter, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult, expected_type: ?TypeTypeInput = NIL) RETURNS !Locatable ->
  IF value IS_A MoveNode AS move_node THEN
  IF move_node.value IS_A Identifier THEN
    RETURN COPY CAST(move_node AS Locatable);
  END
  END
  IF hoist__noreturn_value?(value) THEN
    RETURN COPY castLocatableToLocatable(value);
  END
  IF hoist__allocating?(&value, schema_lookup) THEN
    RETURN Locatable{ Identifier: COPY TRY (hoist__make_temp_mut(value, &hoists, hoistCounter__next_name(&counter), TRUE, expected_type)) };
  END
  IF ((value IS_A StructLit OR value IS_A UnionVariantLit) OR value IS_A ListLit) THEN
    TRY (hoist__hoist_concats_within_mut(value, hoists, counter));
  END
  RETURN COPY castLocatableToLocatable(value);
END
PRIVATE FN hoist__allocating?(MUTABLE node: ?Locatable, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Bool ->
  IF node EXISTS AS node_value THEN
    MUTABLE node_value_mutable = COPY node_value;
    IF (node_value_mutable IS_A Identifier OR node_value_mutable IS_A Literal) THEN
      RETURN FALSE;
    END
    IF hoist__ast_access_path?(node_value_mutable) THEN
      RETURN FALSE;
    END
    MUTABLE coerced = IF respondsTo?(node_value_mutable, "coerced_type_info") THEN
      node_value_mutable.coerced_type_info()
    ELSE
      NIL
    END;
    IF coerced.node_reference?() THEN
      RETURN FALSE;
    END
    IF ((hoist__concat?(node_value_mutable) OR node_value_mutable IS_A ListLit) OR node_value_mutable IS_A HashLit) THEN
      RETURN TRUE;
    END
    IF !(TRUE) THEN
      RETURN FALSE;
    END
    MUTABLE ti = &node_value_mutable.full_type_mut("hoist allocation candidate");
    IF TRY (type__c_string?(ti)) THEN
      RETURN FALSE;
    END
    IF TRY (type__implicitly_copyable?(ti, schema_lookup)) THEN
      RETURN FALSE;
    END
    RETURN (TRY (type__heap_ptr?(ti)) OR TRY (type__needs_explicit_cleanup?(ti, :heap, schema_lookup)));
  ELSE
    RETURN FALSE;
  END
END
PRIVATE FN hoist__moved_arg?(node: ?Locatable) RETURNS Bool ->
  RETURN aST__moved?(node);
END
PRIVATE FN hoist__each_method_call(node: Locatable, blk: FN(MethodCall) -> Void) RETURNS !Void ->
  TRY (hoist__each_call_like(node, %(candidate) -> candidate IS_A MethodCall, %(candidate: Locatable) USE(blk) -> {
  blk(CAST(candidate AS MethodCall));
  rubyToClearVoid()
  }));
END
PRIVATE FN hoist__each_call(node: Locatable, blk: FN(CallLike) -> Void) RETURNS !Void ->
  TRY (hoist__each_call_like(node, %(candidate) -> (candidate IS_A FuncCall OR candidate IS_A MethodCall), %(candidate: Locatable) USE(blk) -> {
  blk(castLocatableToCallLike(candidate));
  rubyToClearVoid()
  }));
END
PRIVATE FN hoist__each_call_like(node: ?Locatable, matches: FN(Locatable) -> Bool, blk: FN(Locatable) -> Void) RETURNS !Void ->
  IF node EXISTS AS node_value THEN
    IF node_value IS_A []Any THEN
      RETURN;
    ELSE
      IF !(node_value IS_A Struct) THEN
        RETURN;
      END
      IF aST__call_like_boundary?(node_value) THEN
        RETURN;
      END
      IF matches(node_value) THEN
        blk(node_value);
      END
      MUTABLE children: []Any@multiowned = TRY (hoist__non_body_exprs(node_value));
      FOR _ IN children DO
      TRY (hoist__each_call_like_child(_, matches, blk));
      END
    END
  ELSE
    RETURN;
  END
END
PRIVATE FN hoist__each_call_like_child(child: Any, matches: FN(Locatable) -> Bool, blk: FN(Locatable) -> Void) RETURNS !Void EFFECTS REENTRANT ->
  IF (child == Array) THEN
    FOR _ IN child DO
    TRY (hoist__each_call_like_child(_, matches, blk));
    END
  ELSE_IF (child == Hash) THEN
    FOR _ IN child.values() DO
    TRY (hoist__each_call_like_child(_, matches, blk));
    END
  ELSE_IF (child IS_A Locatable) THEN
    TRY (hoist__each_call_like(child, matches, blk));
  END
END
PUB FN hoist__pipeline_stage_node?(node: ?Locatable) RETURNS Bool ->
  RETURN (node IS_A SelectOp OR node IS_A WhereOp OR node IS_A EachOp OR node IS_A TapOp OR node IS_A AllOp OR node IS_A AnyOp OR node IS_A FindOp OR node IS_A CountOp OR node IS_A SumOp OR node IS_A AverageOp OR node IS_A MinOp OR node IS_A MaxOp OR node IS_A TakeWhileOp OR node IS_A SkipOp OR node IS_A OrderByOp OR node IS_A DistinctOp OR node IS_A UnnestOp OR node IS_A IndexOp OR node IS_A ReduceOp);
END
PRIVATE FN hoist__non_body_exprs(node: Locatable) RETURNS ![]Any@multiowned ->
  IF hoist__pipeline_stage_node?(node) THEN
    RETURN CAST(( { MUTABLE rtoc_empty_list_7: []Any@multiowned = List[]; rtoc_empty_list_7 } ) AS []Any@multiowned);
  END
  RETURN PARTIAL MATCH node START
    Locatable.IfStatement AS if_statement -> [node.condition()],
    Locatable.WhileLoop AS while_loop -> [node.condition()],
    Locatable.WhileBindLoop AS while_bind_loop -> [node.condition()],
    Locatable.IfBind AS if_bind -> if_bind.bindings |> SELECT binding__expr(_),
    Locatable.ForRange AS for_range -> [node.start_expr(), node.end_expr()],
    Locatable.ForEach AS for_each -> [node.collection()],
    Locatable.MatchStatement AS match_statement -> [node.expr()],
    DEFAULT -> ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_8: ?[]Any@multiowned = NIL;
      IF node IS_A Struct THEN
        rtoc_ternary_value_8 = CAST(node.to_a() AS []Any@multiowned);
      ELSE
        rtoc_ternary_value_8 = List[];
      END
      rtoc_ternary_value_8? })
  END;
END
PRIVATE FN hoist__hoist_concats_within_mut(node: Locatable, MUTABLE hoists: []VarDecl, counter: HoistCounter) RETURNS !Void EFFECTS REENTRANT ->
  IF node IS_A StructLit AS struct_lit THEN
    MUTABLE struct_lit_mutable = COPY struct_lit;
    FOR _ IN struct_lit_mutable.fields.keys() DO
  MUTABLE v = struct_lit_mutable.fields[_];
  IF hoist__concat?(v) THEN
        struct_lit_mutable.fields[_] = TRY (hoist__make_temp_mut(v, &hoists, hoistCounter__next_name(&counter)));
  ELSE
        TRY (hoist__hoist_concats_within_mut(v, hoists, counter));
  END
    END
  ELSE_IF node IS_A UnionVariantLit AS union_variant_lit THEN
    MUTABLE union_variant_lit_mutable = COPY union_variant_lit;
    FOR _ IN union_variant_lit_mutable.fields.keys() DO
  MUTABLE v = union_variant_lit_mutable.fields[_];
  IF hoist__concat?(v) THEN
        union_variant_lit_mutable.fields[_] = TRY (hoist__make_temp_mut(v, &hoists, hoistCounter__next_name(&counter)));
  ELSE
        TRY (hoist__hoist_concats_within_mut(v, hoists, counter));
  END
    END
  ELSE_IF node IS_A ListLit AS list_lit THEN
    MUTABLE list_lit_mutable = COPY list_lit;
    list_lit_mutable.items.each_index(%(idx) USE(MUTABLE counter, MUTABLE hoists, list_lit_mutable) -> {
  MUTABLE v = COPY UNWRAP (list_lit_mutable.items[idx]);
  IF hoist__concat?(v) THEN
    list_lit_mutable.items[idx] = TRY (hoist__make_temp_mut(v, &hoists, hoistCounter__next_name(&counter)));
    RETURN NIL;
  ELSE
    RETURN TRY (hoist__hoist_concats_within_mut(v, hoists, counter));
  END
  NIL
    });
  END
  NIL;
END
PRIVATE FN hoist__composite_element_store?(call: MethodCall) RETURNS !Bool ->
  MUTABLE ti = TRY (type__from_node_mut(call.object, "composite element-store receiver"));
  IF !(type__collection?(ti)) THEN
    RETURN FALSE;
  END
  MUTABLE et: ?Type = TRY (type__element_type(ti));
  RETURN !(!(((((et != NIL) AND !(type__primitive?(et))) AND !(TRY (type__string?(et)))))));
END
PRIVATE FN hoist__empty_list_literal?(node: ?Locatable) RETURNS Bool ->
  RETURN (IF node? IS_A ListLit AS list_lit THEN list_lit.items.empty?() ELSE FALSE END);
END
PRIVATE FN hoist__callee_param_type(call: Locatable, idx: Int64) RETURNS !?Type ->
  IF !(TRUE) THEN
    RETURN NIL;
  END
  MUTABLE signature: ?FunctionSignature@multiowned = functionSignature__unwrap(aST__node__matched_signature(call));
  IF signature != NIL THEN
  IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_9 = (signature?);
  TRY (functionSignature__params(rtoc_local_receiver_9)) } != NIL THEN
    IF (({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_9 = (signature?);
    TRY (functionSignature__params(rtoc_local_receiver_9)) })?)[idx] != NIL THEN
      RETURN (((({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_9 = (signature?);
    TRY (functionSignature__params(rtoc_local_receiver_9)) })?)[idx])?).type();
    ELSE
      RETURN NIL;
    END
  ELSE
    RETURN NIL;
  END
  ELSE
  RETURN NIL;
  END
END
PRIVATE FN hoist__collection_value_store_call?(call: MethodCall) RETURNS !Bool ->
  MUTABLE sig: ?FunctionSignature@multiowned = functionSignature__unwrap(ruby_wrap_optional_FunctionSignature_multiowned_X(KEEP call.matched_stdlib_def));
  sig = (sig OR_ELSE functionSignature__unwrap(ruby_wrap_optional_FunctionSignature_multiowned_X(KEEP call.matched_signature)));
  IF !((((((sig != NIL) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_10 = (sig?);
  TRY (functionSignature__mutates_receiver?(&rtoc_mutable_receiver_10)) }) AND TRY (functionSignature__takes_ownership?(&sig)))) OR TRY (intrinsicRegistry__collection_value_store_method?(Name{ StringValue: COPY call.name }, call.args.length())))) THEN
    RETURN FALSE;
  END
  MUTABLE ti = TRY (type__from_node_mut(call.object, "collection value-store receiver"));
  RETURN !(!(((TRUE AND type__collection?(ti)))));
END
PUB FN hoist__noreturn_value?(node: ?Locatable) RETURNS Bool ->
  IF !(respondsTo?(node, "resolved_type")) THEN
    RETURN FALSE;
  END
  MUTABLE resolved = node.resolved_type();
  IF resolved IS_A Type THEN
    resolved = resolved.resolved();
  END
  RETURN (resolved == :NoReturn);
END
PRIVATE FN hoist__concat?(node: ?Locatable) RETURNS Bool ->
  RETURN (((node != NIL) AND (node IS_A StringConcat)) OR ((IF node? IS_A BinaryOp AS binary_op THEN !(!(binary_op.string_concat)) ELSE FALSE END)));
END
PRIVATE FN hoist__make_temp_mut(concat: Locatable, MUTABLE hoists: []VarDecl, name: String, moved: Bool = TRUE, expected_type: ?TypeTypeInput = NIL, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL) RETURNS !Identifier ->
  MUTABLE tok = IF TRUE THEN
    aST__node__token(concat)
  ELSE
    NIL
  END;
  MUTABLE expected: ?Type = TRY (type__from_node(expected_type));
  MUTABLE ti =   IF ((expected != NIL) AND (IF concat IS_A BgStreamBlock THEN
    TRY (type__stream?(expected))
  ELSE
    TRUE
  END)) THEN
    expected
  ELSE
    TRY (type__from_node_mut(concat, "AST hoist temp"))
  END;
  MUTABLE storage =   IF TRY (hoist__owned_fallback_temp?(concat, schema_lookup)) THEN
    :heap
  ELSE_IF (hoist__ast_borrow_expr?(concat, moved) OR ((TRUE AND aST__node__container_borrow(concat)))) THEN
    :borrow
  ELSE_IF (moved AND TRY (type__needs_explicit_cleanup?(ti, :heap, schema_lookup))) THEN
    :heap
  ELSE
    (((respondsTo?(concat, "storage") AND concat.storage())) OR :frame)
  END;
  MUTABLE decl = VarDecl{ token: COPY tok, name: COPY name, type: NIL, value: COPY concat, mutable: FALSE, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, mir_binding_entry: NIL, ownership_transport_plan: NIL, const_visibility: NIL, module_const: NIL };
  TRY (aST__stamp_synthetic_type_mut(Locatable{ VarDecl: COPY decl }, ti, "synthetic AST type"));
  decl.var_used = TRUE;
  MUTABLE sym = TRY (symbolEntry__new(SymbolEntryRegInput{ VarDecl: COPY decl }, ti, FALSE, storage));
  decl.symbol = sym;
  IF (symbolEntry__borrow_provenance?(sym) AND TRUE) THEN
    decl.container_borrow = TRUE;
  END
  &hoists.append(decl);
  MUTABLE ident = Identifier{ token: COPY tok, name: COPY name, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, fn_ref: NIL, heap_dupe_result: NIL, atomic_borrow: NIL, ownership_pending_transfer: NIL };
  TRY (aST__stamp_synthetic_type_mut(Locatable{ Identifier: COPY ident }, ti, "synthetic AST type"));
  ident.symbol = sym;
  ident.was_moved = COPY moved;
  IF (respondsTo?(concat, "needs_heap_create") AND concat.needs_heap_create()) THEN
    ident.needs_heap_create = TRUE;
  END
  RETURN ident;
END
PRIVATE FN hoist__owned_fallback_temp?(ast_node: Locatable, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Bool ->
  IF ast_node IS_A BinaryOp AS binary_op THEN
  IF (((binary_op.op == symbol("OR")) OR (binary_op.op == symbol("OR_ELSE")))) THEN
      IF !(hoist__ast_container_borrow_expr?(binary_op.left)) THEN
        RETURN FALSE;
      END
      MUTABLE ti = TRY (type__from_node_mut(binary_op, "owned fallback temp"));
      RETURN (((TRY (type__string?(ti)) OR TRY (type__heap_ptr?(ti))) OR TRY (type__collection_value?(ti))) OR TRY (type__recursive_cleanup_shape?(ti, schema_lookup)));
    ELSE
      RETURN FALSE;
    END
  ELSE
    RETURN FALSE;
  END
END
PRIVATE FN hoist__ast_container_borrow_expr?(ast_node: ?Locatable) RETURNS Bool ->
  RETURN mIRHoistFacts__container_borrow_expr?(ast_node);
END
PRIVATE FN hoist__ast_borrow_expr?(ast_node: Locatable, moved: Bool) RETURNS Bool ->
  IF moved THEN
    RETURN FALSE;
  END
  IF hoist__ast_access_path?(ast_node) THEN
    RETURN TRUE;
  END
  RETURN hoist__ast_container_borrow_expr?(ast_node);
END
PRIVATE FN hoist__ast_access_path?(ast_node: Locatable) RETURNS Bool ->
  MUTABLE node = COPY ast_node;
  IF (IF node IS_A BinaryOp AS binary_op THEN (((binary_op.op == symbol("OR")) OR (binary_op.op == symbol("OR_ELSE")))) ELSE FALSE END) THEN
    node = node.left();
  END
  RETURN (node IS_A GetField OR node IS_A GetIndex);
END
# End Ruby module Hoist
# Ruby module MIRHoistLowering
alloc_mir_classes = [MIR.DupeSlice, MIR.AllocSlice, MIR.MakeList, MIR.CapWrap, MIR.SharePromote, MIR.RcRetain, MIR.RcDowngrade, MIR.WeakUpgrade, MIR.DeepCopy, MIR.ConcatStr, MIR.ContainerInit, MIR.MonomorphicKeep];
PUB UNION MirAggregate { ArrayValue: []Any@multiowned, HashMapValue: {Any@multiowned}Any@multiowned }
# End Ruby module MIRHoistLowering
FN castCallLikeToLocatable(value: CallLike) RETURNS Locatable ->
  PARTIAL MATCH value START
    CallLike.FuncCall AS cast_payload -> RETURN Locatable{ FuncCall: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Locatable");
  END
  panic("Invalid cast to Locatable");
END
FN castLocatableToCallLike(value: Locatable) RETURNS CallLike ->
  PARTIAL MATCH value START
    Locatable.FuncCall AS cast_payload -> RETURN CallLike{ FuncCall: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to CallLike");
  END
  panic("Invalid cast to CallLike");
END
