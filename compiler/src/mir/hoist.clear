FN rubyToClearVoid() RETURNS Void ->
  RETURN;
END
FN ruby_array_concat_VarDecl(left: []VarDecl, right: []VarDecl) RETURNS []VarDecl ->
  MUTABLE result: []VarDecl = [];
  FOR rtoc_left_item IN left DO
    &result.append(COPY rtoc_left_item);
  END
  FOR rtoc_right_item IN right DO
    &result.append(COPY rtoc_right_item);
  END
  RETURN result;
END
FN ruby_wrap_optional_FunctionSignature_multiowned_X(value: ?FunctionSignature@multiowned) RETURNS ?X ->
  IF value EXISTS AS optional_payload THEN
    RETURN X{ FunctionSignatureMultiowned: COPY optional_payload };
  END
  NIL;
END
FN ruby_wrap_optional_Type_TypeTypeInput(value: ?Type) RETURNS ?TypeTypeInput ->
  IF value EXISTS AS optional_payload THEN
    RETURN TypeTypeInput{ Type: COPY optional_payload };
  END
  NIL;
END
FN castTypeToOptionalTypeTypeInput(value: ?Type) RETURNS ?TypeTypeInput ->
  IF value EXISTS AS type_value THEN
    RETURN TypeTypeInput{ Type: COPY type_value };
  END
  RETURN NIL;
END
