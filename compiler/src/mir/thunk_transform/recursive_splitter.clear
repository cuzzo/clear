# Ruby module ThunkTransform
# Ruby module ThunkTransform::RecursiveSplitter
PUB UNION ThunkScanNode { Program: Program, RequireNode: RequireNode, ProtocolRequirement: ProtocolRequirement, ProtocolDef: ProtocolDef, FunctionDefMultiowned: FunctionDef@multiowned, ImplementationDef: ImplementationDef, ConformanceDef: ConformanceDef, StructDef: StructDef, VarDecl: VarDecl, Assignment: Assignment, DestructureTarget: DestructureTarget, DestructuringAssignment: DestructuringAssignment, BindExpr: BindExpr, BinaryOp: BinaryOp, IsA: IsA, UnaryOp: UnaryOp, CallSiteOverride: CallSiteOverride, Identifier: Identifier, Literal: Literal, ListLit: ListLit, TupleLit: TupleLit, DefaultArrayLit: DefaultArrayLit, HashLit: HashLit, DefaultLit: DefaultLit, StructLit: StructLit, LambdaLit: LambdaLit, IfStatement: IfStatement, IfBind: IfBind, WhileLoop: WhileLoop, WhileBindLoop: WhileBindLoop, BreakNode: BreakNode, ContinueNode: ContinueNode, FuncCall: FuncCall, MethodCall: MethodCall, GetField: GetField, GetIndex: GetIndex, Cast: Cast, ReturnNode: ReturnNode, Assert: Assert, Raise: Raise, ThrowNode: ThrowNode, DieNode: DieNode, Slice: Slice, Require: Require, DeferStmt: DeferStmt, WithBlock: WithBlock, SyncPolicyDecl: SyncPolicyDecl, SelectOpMultiowned: SelectOp@multiowned, WhereOpMultiowned: WhereOp@multiowned, IndexOpMultiowned: IndexOp@multiowned, ReduceOpMultiowned: ReduceOp@multiowned, OrderByOpMultiowned: OrderByOp@multiowned, LimitOp: LimitOp, UnnestOpMultiowned: UnnestOp@multiowned, DistinctOpMultiowned: DistinctOp@multiowned, EachOp: EachOp, TapOp: TapOp, SkipOp: SkipOp, CollectOp: CollectOp, TakeWhileOpMultiowned: TakeWhileOp@multiowned, WindowOpMultiowned: WindowOp@multiowned, BatchWindowOpMultiowned: BatchWindowOp@multiowned, JoinOp: JoinOp, FindOpMultiowned: FindOp@multiowned, AnyOpMultiowned: AnyOp@multiowned, AllOpMultiowned: AllOp@multiowned, CountOpMultiowned: CountOp@multiowned, SumOpMultiowned: SumOp@multiowned, AverageOpMultiowned: AverageOp@multiowned, MinOpMultiowned: MinOp@multiowned, MaxOpMultiowned: MaxOp@multiowned, ShardOp: ShardOp, ConcurrentOp: ConcurrentOp, Placeholder: Placeholder, Copy: Copy, OptionalUnwrap: OptionalUnwrap, TenseNavigation: TenseNavigation, MutableBorrow: MutableBorrow, OrElseRaise: OrElseRaise, OrElseExit: OrElseExit, OrElsePass: OrElsePass, OrElsePrune: OrElsePrune, OrElseBreak: OrElseBreak, CatchBlock: CatchBlock, RecoverOp: RecoverOp, BlockExpr: BlockExpr, StringConcat: StringConcat, CapabilityWrap: CapabilityWrap, MoveNode: MoveNode, CopyNode: CopyNode, KeepNode: KeepNode, ShareNode: ShareNode, LinkNode: LinkNode, ResolveNode: ResolveNode, FreezeNode: FreezeNode, PassStmt: PassStmt, StructPattern: StructPattern, RangeLit: RangeLit, ExternFnDecl: ExternFnDecl, ExternStructDecl: ExternStructDecl, EnumDef: EnumDef, UnionDef: UnionDef, UnionVariantLit: UnionVariantLit, StaticCall: StaticCall, DoBlock: DoBlock, BgBlock: BgBlock, ThenChain: ThenChain, BgStreamBlock: BgStreamBlock, YieldExpr: YieldExpr, CloseStream: CloseStream, NextExpr: NextExpr, MatchStatement: MatchStatement, ForRange: ForRange, ForEach: ForEach, TestBlock: TestBlock, WhenBlock: WhenBlock, LetBinding: LetBinding, TestThat: TestThat, AssertRaisesMultiowned: AssertRaises@multiowned, BenchmarkStmtMultiowned: BenchmarkStmt@multiowned, SmashStmtMultiowned: SmashStmt@multiowned, ProfileStmtMultiowned: ProfileStmt@multiowned, StubDecl: StubDecl, Drop: Drop, SuppressCleanup: SuppressCleanup, Return: Return, ReassignCleanup: ReassignCleanup, FieldCleanup: FieldCleanup, ArrayValue: []Node, FunctionDef: FunctionDef, SelectOp: SelectOp, WhereOp: WhereOp, IndexOp: IndexOp, ReduceOp: ReduceOp, OrderByOp: OrderByOp, UnnestOp: UnnestOp, DistinctOp: DistinctOp, TakeWhileOp: TakeWhileOp, WindowOp: WindowOp, BatchWindowOp: BatchWindowOp, FindOp: FindOp, AnyOp: AnyOp, AllOp: AllOp, CountOp: CountOp, SumOp: SumOp, AverageOp: AverageOp, MinOp: MinOp, MaxOp: MaxOp, AssertRaises: AssertRaises, BenchmarkStmt: BenchmarkStmt, SmashStmt: SmashStmt, ProfileStmt: ProfileStmt }
PUB STRUCT BaseCase {
  cond_ast: Locatable,
  value_ast: Locatable
}
PUB STRUCT RecursiveCombine {
  lhs: Locatable,
  op: String@symbol,
  args: []Locatable
}
PUB STRUCT MutualTailCall {
  name: String,
  args: []Locatable
}
PUB STRUCT Plan {
  base_cases: []BaseCase,
  combine_lhs: Locatable,
  combine_op: String@symbol,
  recurse_args: []Locatable,
  final_return: ReturnNode
}
PUB STRUCT MutualPlan {
  base_cases: []BaseCase,
  target_fn: String,
  target_args: []Locatable,
  final_return: ReturnNode
}
PUB STRUCT MutualThunkPlan {
  cycle_fns: []FunctionDef,
  own_plan: MutualPlan
}
supported_ops = [:ADD, :SUB, :MUL, :DIV];
PUB FN recursiveSplitter__split(body: []Locatable, fn_name: String) RETURNS ?Plan ->
  IF (body.length == 0) THEN
    RETURN NIL;
  END
  MUTABLE stmts = COPY body;
  MUTABLE base_cases = List[];
  MUTABLE i = 0;
  WHILE (i < (stmts.length - 1)) DO
    MUTABLE stmt = COPY UNWRAP (stmts[i]);
    MUTABLE bc: ?BaseCase = recursiveSplitter__match_base_case(stmt, fn_name);
    IF bc EXISTS AS bc_value THEN
      &base_cases.append(bc_value);
      i = (i + 1);
    ELSE
      RETURN NIL;
    END
  END
  MUTABLE final = COPY UNWRAP (stmts.last());
  IF final IS_A ReturnNode AS return_node THEN
    IF return_node.value == NIL THEN
      RETURN NIL;
    END
    MUTABLE final_value: Locatable = COPY UNWRAP (return_node.value);
    MUTABLE combine: ?RecursiveCombine = recursiveSplitter__match_recursive_combine(final_value, fn_name);
    IF combine EXISTS AS combine_value THEN
      RETURN Plan{ base_cases: COPY base_cases, combine_lhs: COPY combine_value.lhs, combine_op: COPY combine_value.op, recurse_args: COPY combine_value.args, final_return: COPY return_node };
    ELSE
      RETURN NIL;
    END
  ELSE
    RETURN NIL;
  END
END
PUB FN recursiveSplitter__split_mutual(body: []Locatable, fn_name: String, partner_names: []String) RETURNS ?MutualPlan ->
  IF (body.length == 0) THEN
    RETURN NIL;
  END
  MUTABLE cycle = ((partner_names + [fn_name])) |> SELECT _.toString() |> DISTINCT _;
  MUTABLE stmts = COPY body;
  MUTABLE base_cases = List[];
  MUTABLE i = 0;
  WHILE (i < (stmts.length - 1)) DO
    MUTABLE stmt = COPY UNWRAP (stmts[i]);
    MUTABLE bc: ?BaseCase = recursiveSplitter__match_mutual_base_case(stmt, cycle);
    IF bc EXISTS AS bc_value THEN
      &base_cases.append(bc_value);
      i = (i + 1);
    ELSE
      RETURN NIL;
    END
  END
  MUTABLE final = COPY UNWRAP (stmts.last());
  IF final IS_A ReturnNode AS return_node THEN
  IF return_node.value EXISTS AS return_value THEN
      MUTABLE target: ?MutualTailCall = recursiveSplitter__match_tail_mutual_call(return_value, partner_names);
      IF target EXISTS AS target_value THEN
        RETURN MutualPlan{ base_cases: COPY base_cases, target_fn: COPY target_value.name, target_args: COPY target_value.args, final_return: COPY return_node };
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
  ELSE
    RETURN NIL;
  END
END
PRIVATE FN recursiveSplitter__match_mutual_base_case(stmt: Locatable, cycle_names: [Set]String) RETURNS ?BaseCase ->
  IF stmt IS_A IfStatement AS if_statement THEN
    IF (!((if_statement.else_branch == NIL)) AND !((UNWRAP (if_statement.else_branch)).empty?())) THEN
      RETURN NIL;
    END
    MUTABLE then_b: ?[]Locatable = CAST(if_statement.then_branch AS ?[]Locatable);
    IF then_b EXISTS AS then_b_value THEN
      MUTABLE then_b_value = COPY then_b_value;
      IF (then_b_value.length != 1) THEN
        RETURN NIL;
      END
      MUTABLE ret: Locatable = COPY UNWRAP (then_b_value.first());
      IF ret IS_A ReturnNode AS ret_node THEN
        IF ret_node.value EXISTS AS ret_value THEN
          IF recursiveSplitter__contains_any_call?(castLocatableToOptionalThunkScanNode(if_statement.condition), cycle_names) THEN
            RETURN NIL;
          END
          IF recursiveSplitter__contains_any_call?(castLocatableToOptionalThunkScanNode(ret_value), cycle_names) THEN
            RETURN NIL;
          END
          RETURN BaseCase{ cond_ast: COPY if_statement.condition, value_ast: COPY ret_value };
        END
      END
      RETURN NIL;
    ELSE
      RETURN NIL;
    END
  ELSE
    RETURN NIL;
  END
END
PRIVATE FN recursiveSplitter__match_tail_mutual_call(node: Locatable, partner_names: []String) RETURNS ?MutualTailCall ->
  IF node IS_A FuncCall AS func_call THEN
    MUTABLE partners = (partner_names |> SELECT _.toString()) |> DISTINCT _;
    MUTABLE name: String = COPY CAST(func_call.name AS String);
    IF !(partners.contains?(name)) THEN
      RETURN NIL;
    END
    RETURN MutualTailCall{ name: COPY name, args: COPY func_call.args };
  ELSE
    RETURN NIL;
  END
END
PRIVATE FN recursiveSplitter__contains_any_call?(node: ?ThunkScanNode, names_set: [Set]String) RETURNS Bool ->
  IF node EXISTS AS node_value THEN
    MUTABLE stack: []Locatable = ( { MUTABLE rtoc_empty_list_1: []Locatable = List[]; rtoc_empty_list_1 } );
    IF node_value IS_A []Node AS array THEN
      MUTABLE rtoc_reverse_items_2: []Node = array;
      MUTABLE rtoc_reverse_i_3 = rtoc_reverse_items_2.length - 1;
      WHILE rtoc_reverse_i_3 >= 0 DO
  &stack.append(COPY (rtoc_reverse_items_2[rtoc_reverse_i_3])?);
  rtoc_reverse_i_3 = rtoc_reverse_i_3 - 1;
      END
    ELSE
      &stack.append(castThunkScanNodeToLocatable(COPY node_value));
    END
    WHILE !((stack.length == 0)) DO
      MUTABLE current = UNWRAP (&stack.pop());
      IF (current IS_A FunctionDef OR current IS_A LambdaLit) THEN
        CONTINUE;
      END
      IF current IS_A FuncCall AS func_call THEN
        MUTABLE name: String = CAST(func_call.name AS String);
        IF names_set.contains?(name) THEN
          RETURN TRUE;
        END
      END
      aST__each_child_node(current, %(child: Locatable) USE(MUTABLE stack) -> {
  &stack.append(COPY child);
  rubyToClearVoid()
      });
    END
    RETURN FALSE;
  ELSE
    RETURN FALSE;
  END
END
PRIVATE FN recursiveSplitter__match_base_case(stmt: Locatable, fn_name: String) RETURNS ?BaseCase ->
  IF stmt IS_A IfStatement AS if_statement THEN
    IF (!((if_statement.else_branch == NIL)) AND !((UNWRAP (if_statement.else_branch)).empty?())) THEN
      RETURN NIL;
    END
    MUTABLE then_b: ?[]Locatable = CAST(if_statement.then_branch AS ?[]Locatable);
    IF then_b EXISTS AS then_b_value THEN
      MUTABLE then_b_value = COPY then_b_value;
      IF (then_b_value.length != 1) THEN
        RETURN NIL;
      END
      MUTABLE ret: Locatable = COPY UNWRAP (then_b_value.first());
      IF ret IS_A ReturnNode AS ret_node THEN
        IF ret_node.value EXISTS AS ret_value THEN
          IF recursiveSplitter__contains_self_call?(castLocatableToOptionalThunkScanNode(if_statement.condition), fn_name) THEN
            RETURN NIL;
          END
          IF recursiveSplitter__contains_self_call?(castLocatableToOptionalThunkScanNode(ret_value), fn_name) THEN
            RETURN NIL;
          END
          RETURN BaseCase{ cond_ast: COPY if_statement.condition, value_ast: COPY ret_value };
        END
      END
      RETURN NIL;
    ELSE
      RETURN NIL;
    END
  ELSE
    RETURN NIL;
  END
END
PRIVATE FN recursiveSplitter__match_recursive_combine(expr: Locatable, fn_name: String) RETURNS ?RecursiveCombine ->
  IF expr IS_A BinaryOp AS binary_op THEN
    IF !(supported_ops.contains?(binary_op.op)) THEN
      RETURN NIL;
    END
    MUTABLE left_call: ?FuncCall = recursiveSplitter__direct_self_call(binary_op.left, fn_name);
    MUTABLE right_call: ?FuncCall = recursiveSplitter__direct_self_call(binary_op.right, fn_name);
    IF ((left_call != NIL) AND !(recursiveSplitter__contains_self_call?(castLocatableToOptionalThunkScanNode(binary_op.right), fn_name))) THEN
      RETURN RecursiveCombine{ lhs: COPY binary_op.right, op: COPY binary_op.op, args: COPY left_call.args };
    ELSE_IF ((right_call != NIL) AND !(recursiveSplitter__contains_self_call?(castLocatableToOptionalThunkScanNode(binary_op.left), fn_name))) THEN
      RETURN RecursiveCombine{ lhs: COPY binary_op.left, op: COPY binary_op.op, args: COPY right_call.args };
    ELSE
      RETURN NIL;
    END
  ELSE
    RETURN NIL;
  END
END
PRIVATE FN recursiveSplitter__direct_self_call(node: Locatable, fn_name: String) RETURNS ?FuncCall ->
  IF node IS_A FuncCall AS func_call THEN
    MUTABLE name: String = COPY CAST(func_call.name AS String);
    IF !((name == fn_name)) THEN
      RETURN NIL;
    END
    RETURN COPY func_call;
  ELSE
    RETURN NIL;
  END
END
PRIVATE FN recursiveSplitter__contains_self_call?(node: ?ThunkScanNode, fn_name: String) RETURNS Bool ->
  RETURN recursiveSplitter__contains_any_call?(node, [fn_name] |> DISTINCT _);
END
# End Ruby module ThunkTransform::RecursiveSplitter
