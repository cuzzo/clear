REQUIRE "pkg:rtoc_6d69722f6d69725f6c6f776572696e672e636c656172"
REQUIRE "../../ast/type.clear"
REQUIRE "../../backends/zig_type.clear"
REQUIRE "../mir.clear"
REQUIRE "../../ast/ast.clear"
REQUIRE "../../ast/param.clear"
REQUIRE "../thunk_transform.clear"
REQUIRE "recursive_splitter.clear"
# Ruby module ThunkTransform
# Ruby module ThunkTransform::Emit
STRUCT FrameBindingContext {
  receiver_name: String,
  param_names: [Set]String
}

FN frameBindingContext__binds?(self: FrameBindingContext, name: String) RETURNS Bool ->
  RETURN self.param_names.contains?(name);
END
FN frameBindingContext__field_ref(self: FrameBindingContext, name: String) RETURNS FieldGet ->
  RETURN FieldGet{ object: Emittable{ Ident: COPY Ident{ name: COPY self.receiver_name, lowered_node_id: NIL, ownership_consumption: NIL } }, field: COPY name, lowered_node_id: NIL, ownership_consumption: NIL };
END
STRUCT ThunkParamFact {
  name: String,
  type_info: Type
}

FN thunkParamFact__from_param(param: Param) RETURNS !ThunkParamFact ->
  RETURN ThunkParamFact{ name: COPY CAST(param.name AS String), type_info: COPY TRY (type__new(TypeConstructionInput{ Type: COPY param.type })) };
END
PUB FN emit__build_trampoline(fn_node: FunctionDef, lowering: MIRLowering) RETURNS !ThunkTrampoline ->
  MUTABLE plan = TRY (emit__thunk_plan_mut(fn_node));
  MUTABLE return_type = TRY (emit__return_type_info(fn_node, lowering));
  TRY (emit__assert_non_fallible_ret_mut(fn_node, CAST(return_type AS Type)));
  MUTABLE params = TRY (emit__function_params(fn_node));
  MUTABLE param_fields = params |> SELECT emit__frame_field(_.name, _.type_info);
  MUTABLE param_init_fields = params |> SELECT emit__frame_init(_.name, Emittable{ Ident: COPY Ident{ name: COPY _.name, lowered_node_id: NIL, ownership_consumption: NIL } });
  MUTABLE context = TRY (emit__current_frame_context(fn_node));
  MUTABLE base_cases = plan.base_cases |> SELECT ThunkBaseCase{ cond: COPY TRY (emit__lower_frame_expr(_.cond_ast, lowering, context)), value: COPY TRY (emit__lower_frame_expr( _.value_ast, lowering, context)) };
  MUTABLE recurse_arg_inits = {
  MUTABLE rtoc_value_block_marker = 0;
  MUTABLE rtoc_indexed_items_1: []Locatable = plan.recurse_args;
  MUTABLE rtoc_indexed_output_3 = [];
  MUTABLE rtoc_indexed_i_2 = 0;
  WHILE rtoc_indexed_i_2 < rtoc_indexed_items_1.length() DO
    &rtoc_indexed_output_3.append({
  MUTABLE param: ThunkParamFact = COPY UNWRAP (params[rtoc_indexed_i_2]);
  emit__frame_init(param.name, TRY (emit__lower_frame_expr(UNWRAP (rtoc_indexed_items_1[rtoc_indexed_i_2]), lowering, context)))
  });
    rtoc_indexed_i_2 = rtoc_indexed_i_2 + 1;
  END
  rtoc_indexed_output_3
  };
  MUTABLE combine_lhs = TRY (emit__lower_frame_expr(plan.combine_lhs, lowering, context));
  TRY (emit__validate_combine_op_mut(plan.combine_op));
  RETURN ThunkTrampoline{ fn_name: COPY fn_node.name, return_type: CAST(COPY return_type AS Type), param_fields: COPY param_fields, param_init_fields: COPY param_init_fields, base_cases: COPY base_cases, recurse_arg_inits: COPY recurse_arg_inits, combine_lhs: COPY combine_lhs, combine_op: COPY plan.combine_op, yield_policy: IF fn_node.tight_reentrance THEN
    :tight_skip
  ELSE
    :check
  END };
END
FN emit__lower_frame_expr(ast_expr: Locatable, lowering: MIRLowering, context: FrameBindingContext) RETURNS !Emittable ->
  MUTABLE lowering_api = COPY lowering;
  MUTABLE mir: ?Emittable = TRY (mIRLowering__lower( &lowering_api, castLocatableToMIRLoweringLowerableStmt(ast_expr)));
  RETURN emit__bind_frame_refs(UNWRAP (mir), context);
END
FN emit__frame_init(field_name: String, value: Emittable) RETURNS ThunkFrameInit ->
  RETURN ThunkFrameInit{ field_name: COPY field_name, value: COPY value };
END
FN emit__frame_field(field_name: String, type_info: Type) RETURNS ThunkFrameField ->
  RETURN ThunkFrameField{ name: COPY field_name, type_info: COPY type_info };
END
PRIVATE FN emit__current_frame_context(fn_node: FunctionDef) RETURNS !FrameBindingContext ->
  RETURN FrameBindingContext{ receiver_name: "current", param_names: COPY TRY (emit__param_names(fn_node)) };
END
PRIVATE FN emit__mutual_frame_context(fn_node: FunctionDef) RETURNS !FrameBindingContext ->
  RETURN FrameBindingContext{ receiver_name: "f", param_names: COPY TRY (emit__param_names(fn_node)) };
END
FN emit__param_names(fn_node: FunctionDef) RETURNS ![Set]String ->
  MUTABLE names: [Set]String = Set[];
  FOR _ IN (TRY (emit__function_params(fn_node))) DO
  &names.insert(COPY _.name);
  END
  RETURN names;
END
PRIVATE FN emit__bind_frame_refs(mir: Emittable, context: FrameBindingContext) RETURNS Emittable EFFECTS REENTRANT ->
  IF mir IS_A Ident AS ident THEN
    MUTABLE name = COPY ident.name;
    IF frameBindingContext__binds?(context, name) THEN
      RETURN Emittable{ FieldGet: COPY frameBindingContext__field_ref(context, name) };
    ELSE
      RETURN COPY Emittable{ Ident: COPY ident };
    END
  ELSE_IF mir IS_A MIRBinOp AS mir_bin_op THEN
    RETURN Emittable{ MIRBinOp: COPY MIRBinOp{ op: mir_bin_op.op, left: COPY emit__bind_frame_refs(mir_bin_op.left, context), right: COPY emit__bind_frame_refs(mir_bin_op.right, context), lowered_node_id: NIL, ownership_consumption: NIL } };
  ELSE_IF mir IS_A MIRUnaryOp AS mir_unary_op THEN
    RETURN Emittable{ MIRUnaryOp: COPY MIRUnaryOp{ op: mir_unary_op.op, operand: COPY emit__bind_frame_refs(mir_unary_op.operand, context), lowered_node_id: NIL, ownership_consumption: NIL } };
  ELSE_IF mir IS_A FieldGet AS field_get THEN
    RETURN Emittable{ FieldGet: COPY FieldGet{ object: COPY emit__bind_frame_refs(field_get.object, context), field: COPY field_get.field, lowered_node_id: NIL, ownership_consumption: NIL } };
  ELSE_IF mir IS_A IndexGet AS index_get THEN
    RETURN Emittable{ IndexGet: COPY IndexGet{ object: COPY emit__bind_frame_refs(index_get.object, context), index: COPY emit__bind_frame_refs(index_get.index, context), lowered_node_id: NIL, ownership_consumption: NIL } };
  ELSE_IF mir IS_A MIRMethodCall AS mir_method_call THEN
    RETURN Emittable{ MIRMethodCall: COPY MIRMethodCall{ receiver: COPY emit__bind_frame_refs(mir_method_call.receiver, context), method: COPY mir_method_call.method, args: COPY mir_method_call.args |> SELECT emit__bind_frame_refs(_, context), try_wrap: mir_method_call.try_wrap, callable_contract: COPY mir_method_call.callable_contract, owned_result_alloc: COPY mir_method_call.owned_result_alloc, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } };
  ELSE_IF mir IS_A Call AS call THEN
    RETURN Emittable{ Call: COPY Call{ callee: COPY call.callee, args: COPY call.args |> SELECT emit__bind_frame_refs(_, context), try_wrap: (call.try_wrap == TRUE), owned_return: call__owned_return?(call), callable_contract: COPY call.callable_contract, lowered_node_id: NIL, ownership_consumption: NIL, never_success: FALSE, result_type: NIL } };
  ELSE_IF mir IS_A RegistryCall AS registry_call THEN
    RETURN Emittable{ RegistryCall: COPY RegistryCall{ entry: KEEP registry_call.entry, args: COPY registry_call.args |> SELECT RegistryCallArg{ expr: COPY emit__bind_frame_refs(_.expr, context), coerce_type: COPY _.coerce_type }, reason: COPY registry_call.reason, ownership_contract: KEEP registry_call.ownership_contract, allocs: KEEP registry_call.allocs, target_var: COPY registry_call.target_var, result_type: COPY registry_call.result_type, result_ownership_bearing: registry_call.result_ownership_bearing, key_type: COPY registry_call.key_type, value_type: COPY registry_call.value_type, suppress_try: registry_call.suppress_try, owned_result_alloc: NIL } };
  ELSE_IF mir IS_A MIRCast AS mir_cast THEN
    RETURN Emittable{ MIRCast: COPY MIRCast{ expr: COPY emit__bind_frame_refs(cast__expr(mir_cast), context), target_type: mir_cast.target_type, method: mir_cast.method, lowered_node_id: NIL, ownership_consumption: NIL } };
  ELSE_IF mir IS_A TryExpr AS try_expr THEN
    RETURN Emittable{ TryExpr: COPY TryExpr{ expr: COPY emit__bind_frame_refs(tryExpr__expr(try_expr), context), lowered_node_id: NIL, ownership_consumption: NIL } };
  ELSE_IF mir IS_A TryOptional AS try_optional THEN
    RETURN Emittable{ TryOptional: COPY TryOptional{ expr: COPY emit__bind_frame_refs(tryOptional__expr(try_optional), context), lowered_node_id: NIL, ownership_consumption: NIL } };
  ELSE_IF mir IS_A TryCatch AS try_catch THEN
    RETURN Emittable{ TryCatch: COPY TryCatch{ expr: COPY emit__bind_frame_refs(tryCatch__expr(try_catch), context), catch_body: COPY emit__bind_frame_refs(try_catch.catch_body, context), capture: try_catch.capture, lowered_node_id: NIL, ownership_consumption: NIL, result_type: NIL } };
  ELSE_IF mir IS_A AddressOf AS address_of THEN
    RETURN Emittable{ AddressOf: COPY AddressOf{ expr: COPY emit__bind_frame_refs(addressOf__expr(address_of), context), lowered_node_id: NIL, ownership_consumption: NIL } };
  ELSE_IF mir IS_A Deref AS deref THEN
    RETURN Emittable{ Deref: COPY Deref{ expr: COPY emit__bind_frame_refs(deref__expr(deref), context), lowered_node_id: NIL, ownership_consumption: NIL } };
  ELSE_IF mir IS_A MIROptionalUnwrap AS mir_optional_unwrap THEN
    RETURN Emittable{ MIROptionalUnwrap: COPY MIROptionalUnwrap{ expr: COPY emit__bind_frame_refs(optionalUnwrap__expr(mir_optional_unwrap), context), lowered_node_id: NIL, ownership_consumption: NIL } };
  ELSE
    RETURN COPY mir;
  END
END
FN emit__return_type_info(fn_node: FunctionDef, ignored_lowering: MIRLowering) RETURNS !Type ->
  MUTABLE rt: ?Type = COPY fn_node.return_type;
  IF rt EXISTS AS rt_value THEN
    IF TRUE THEN
      RETURN rt_value;
    ELSE
      RETURN TRY (type__new(TypeConstructionInput{ Type: COPY rt_value }));
    END
  ELSE
    RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :Void }));
  END
END
PRIVATE FN emit__validate_combine_op_mut(op: String@symbol) RETURNS !Void ->
  IF ([:ADD, :SUB, :MUL, :DIV] |> DISTINCT _).contains?(op) THEN
    RETURN;
  END
  panic("thunk: unsupported op {}");
END
PRIVATE FN emit__assert_non_fallible_ret_mut(fn_node: FunctionDef, return_type: Type) RETURNS !Void ->
  MUTABLE return_type_zig = TRY (type__zig_type(return_type));
  IF !(zigType__inferred_error_union?(zigType__new(return_type_zig))) THEN
    RETURN;
  END
  panic("{}{}heap-allocated child Frames only on the normal return path; an error return would leak the in-flight chain. Before lifting the non-fallible invariant, extend `build_trampoline` and `build_mutual_trampoline` to emit an errdefer that walks `current.parent` and frees every non-initial Frame.");
END
PUB FN emit__build_mutual_trampoline(fn_node: FunctionDef, lowering: MIRLowering) RETURNS !MutualThunkTrampoline ->
  MUTABLE mtp = TRY (emit__mutual_thunk_plan_mut(fn_node));
  MUTABLE return_type = TRY (emit__return_type_info(fn_node, lowering));
  TRY (emit__assert_non_fallible_ret_mut(fn_node, CAST(return_type AS Type)));
  MUTABLE cycle_fns: []FunctionDef@multiowned = COPY mtp.cycle_fns;
  MUTABLE variants = cycle_fns |> SELECT ThunkVariant{ name: COPY _.name, param_fields: COPY (TRY (emit__function_params(CAST(COPY _ AS FunctionDef)))) |> SELECT emit__frame_field(_.name, _.type_info) };
  MUTABLE initial_fields = (TRY (emit__function_params(fn_node))) |> SELECT emit__frame_init(_.name, Emittable{ Ident: COPY Ident{ name: COPY _.name, lowered_node_id: NIL, ownership_consumption: NIL } });
  MUTABLE arms = cycle_fns |> SELECT TRY (emit__build_mutual_arm(CAST(COPY _ AS FunctionDef), mtp, lowering));
  RETURN MutualThunkTrampoline{ fn_name: COPY fn_node.name, return_type: CAST(COPY return_type AS Type), variants: COPY variants, initial_variant: COPY fn_node.name, initial_fields: COPY initial_fields, arms: COPY arms, yield_policy: IF fn_node.tight_reentrance THEN
    :tight_skip
  ELSE
    :check
  END };
END
PRIVATE FN emit__build_mutual_arm(cf: FunctionDef, ignored_mtp: MutualThunkPlan, lowering: MIRLowering) RETURNS !MutualThunkArm ->
  MUTABLE own_plan = COPY (TRY (emit__mutual_thunk_plan_mut(cf))).own_plan;
  MUTABLE context = TRY (emit__mutual_frame_context(cf));
  MUTABLE base_cases = own_plan.base_cases |> SELECT ThunkBaseCase{ cond: COPY TRY (emit__lower_frame_expr(_.cond_ast, lowering, context)), value: COPY TRY (emit__lower_frame_expr( _.value_ast, lowering, context)) };
  MUTABLE target_fn = COPY own_plan.target_fn;
  MUTABLE target_args = COPY own_plan.target_args;
  MUTABLE target_params = TRY (emit__function_params(CAST(TRY (emit__find_cycle_member(cf, target_fn)) AS FunctionDef)));
  IF (target_args.length() != target_params.length()) THEN
    panic("thunk: target arg/param count mismatch for '{}' -> '{}'");
  END
  MUTABLE arg_inits = {
  MUTABLE rtoc_value_block_marker = 0;
  MUTABLE rtoc_indexed_items_4: []Locatable = target_args;
  MUTABLE rtoc_indexed_output_6 = [];
  MUTABLE rtoc_indexed_i_5 = 0;
  WHILE rtoc_indexed_i_5 < rtoc_indexed_items_4.length() DO
    &rtoc_indexed_output_6.append({
  MUTABLE target_param = COPY UNWRAP (target_params[rtoc_indexed_i_5]);
  emit__frame_init(target_param.name, TRY (emit__lower_frame_expr(UNWRAP (rtoc_indexed_items_4[rtoc_indexed_i_5]), lowering, context)))
  });
    rtoc_indexed_i_5 = rtoc_indexed_i_5 + 1;
  END
  rtoc_indexed_output_6
  };
  RETURN MutualThunkArm{ variant_name: COPY cf.name, base_cases: COPY base_cases, target_variant: COPY target_fn, target_arg_inits: COPY arg_inits };
END
PRIVATE FN emit__find_cycle_member(cf: FunctionDef, name: String) RETURNS !FunctionDef ->
  MUTABLE rtoc_found: ?FunctionDef = ((TRY (emit__mutual_thunk_plan_mut(cf))).cycle_fns) |> FIND (_.name == name);
  IF rtoc_found EXISTS AS rtoc_found_value THEN
    RETURN COPY rtoc_found_value;
  END
  RETURN panic("thunk: cycle member '${name}' not found for '${cf.name}'");
END
PRIVATE FN emit__thunk_plan_mut(fn_node: FunctionDef) RETURNS !Plan ->
  MUTABLE plan: ?Plan = COPY fn_node.thunk_plan;
  IF plan EXISTS AS plan_value THEN
    RETURN plan_value;
  ELSE
    panic("fn '{}' has no thunk_plan");
  END
END
PRIVATE FN emit__mutual_thunk_plan_mut(fn_node: FunctionDef) RETURNS !MutualThunkPlan ->
  MUTABLE plan: ?MutualThunkPlan = COPY CAST(fn_node.mutual_thunk_plan AS ?MutualThunkPlan);
  IF plan EXISTS AS plan_value THEN
    RETURN plan_value;
  ELSE
    panic("fn '{}' has no mutual_thunk_plan");
  END
END
PRIVATE FN emit__function_params(fn_node: FunctionDef) RETURNS ![]ThunkParamFact ->
  RETURN fn_node.params |> SELECT TRY (thunkParamFact__from_param(_));
END
# End Ruby module ThunkTransform::Emit
# End Ruby module ThunkTransform
FN castLocatableToMIRLoweringLowerableStmt(value: Locatable) RETURNS MIRLoweringLowerableStmt ->
  PARTIAL MATCH value START
    Locatable.Program AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ASTProgram: COPY cast_payload };,
    Locatable.StructDef AS cast_payload -> RETURN MIRLoweringLowerableStmt{ StructDef: COPY cast_payload };,
    Locatable.BgBlock AS cast_payload -> RETURN MIRLoweringLowerableStmt{ BgBlock: COPY cast_payload };,
    Locatable.Cast AS cast_payload -> RETURN MIRLoweringLowerableStmt{ Cast: COPY cast_payload };,
    Locatable.DeferStmt AS cast_payload -> RETURN MIRLoweringLowerableStmt{ DeferStmt: COPY cast_payload };,
    Locatable.OptionalUnwrap AS cast_payload -> RETURN MIRLoweringLowerableStmt{ OptionalUnwrap: COPY cast_payload };,
    Locatable.OrElseBreak AS cast_payload -> RETURN MIRLoweringLowerableStmt{ OrElseBreak: COPY cast_payload };,
    Locatable.OrElseExit AS cast_payload -> RETURN MIRLoweringLowerableStmt{ OrElseExit: COPY cast_payload };,
    Locatable.OrElsePass AS cast_payload -> RETURN MIRLoweringLowerableStmt{ OrElsePass: COPY cast_payload };,
    Locatable.OrElsePrune AS cast_payload -> RETURN MIRLoweringLowerableStmt{ OrElsePrune: COPY cast_payload };,
    Locatable.OrElseRaise AS cast_payload -> RETURN MIRLoweringLowerableStmt{ OrElseRaise: COPY cast_payload };,
    Locatable.RangeLit AS cast_payload -> RETURN MIRLoweringLowerableStmt{ RangeLit: COPY cast_payload };,
    Locatable.UnaryOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ UnaryOp: COPY cast_payload };,
    Locatable.BlockExpr AS cast_payload -> RETURN MIRLoweringLowerableStmt{ BlockExpr: COPY cast_payload };,
    Locatable.DoBlock AS cast_payload -> RETURN MIRLoweringLowerableStmt{ DoBlock: COPY cast_payload };,
    Locatable.Raise AS cast_payload -> RETURN MIRLoweringLowerableStmt{ Raise: COPY cast_payload };,
    Locatable.RequireNode AS cast_payload -> RETURN MIRLoweringLowerableStmt{ RequireNode: COPY cast_payload };,
    Locatable.ProtocolRequirement AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ProtocolRequirement: COPY cast_payload };,
    Locatable.ProtocolDef AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ProtocolDef: COPY cast_payload };,
    Locatable.FunctionDef AS cast_payload -> RETURN MIRLoweringLowerableStmt{ FunctionDef: COPY cast_payload };,
    Locatable.ImplementationDef AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ImplementationDef: COPY cast_payload };,
    Locatable.ConformanceDef AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ConformanceDef: COPY cast_payload };,
    Locatable.VarDecl AS cast_payload -> RETURN MIRLoweringLowerableStmt{ VarDecl: COPY cast_payload };,
    Locatable.Assignment AS cast_payload -> RETURN MIRLoweringLowerableStmt{ Assignment: COPY cast_payload };,
    Locatable.DestructuringAssignment AS cast_payload -> RETURN MIRLoweringLowerableStmt{ DestructuringAssignment: COPY cast_payload };,
    Locatable.BindExpr AS cast_payload -> RETURN MIRLoweringLowerableStmt{ BindExpr: COPY cast_payload };,
    Locatable.BinaryOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ BinaryOp: COPY cast_payload };,
    Locatable.IsA AS cast_payload -> RETURN MIRLoweringLowerableStmt{ IsA: COPY cast_payload };,
    Locatable.CallSiteOverride AS cast_payload -> RETURN MIRLoweringLowerableStmt{ CallSiteOverride: COPY cast_payload };,
    Locatable.Identifier AS cast_payload -> RETURN MIRLoweringLowerableStmt{ Identifier: COPY cast_payload };,
    Locatable.Literal AS cast_payload -> RETURN MIRLoweringLowerableStmt{ Literal: COPY cast_payload };,
    Locatable.ListLit AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ListLit: COPY cast_payload };,
    Locatable.TupleLit AS cast_payload -> RETURN MIRLoweringLowerableStmt{ TupleLit: COPY cast_payload };,
    Locatable.DefaultArrayLit AS cast_payload -> RETURN MIRLoweringLowerableStmt{ DefaultArrayLit: COPY cast_payload };,
    Locatable.HashLit AS cast_payload -> RETURN MIRLoweringLowerableStmt{ HashLit: COPY cast_payload };,
    Locatable.DefaultLit AS cast_payload -> RETURN MIRLoweringLowerableStmt{ DefaultLit: COPY cast_payload };,
    Locatable.StructLit AS cast_payload -> RETURN MIRLoweringLowerableStmt{ StructLit: COPY cast_payload };,
    Locatable.LambdaLit AS cast_payload -> RETURN MIRLoweringLowerableStmt{ LambdaLit: COPY cast_payload };,
    Locatable.IfStatement AS cast_payload -> RETURN MIRLoweringLowerableStmt{ IfStatement: COPY cast_payload };,
    Locatable.IfBind AS cast_payload -> RETURN MIRLoweringLowerableStmt{ IfBind: COPY cast_payload };,
    Locatable.WhileLoop AS cast_payload -> RETURN MIRLoweringLowerableStmt{ WhileLoop: COPY cast_payload };,
    Locatable.WhileBindLoop AS cast_payload -> RETURN MIRLoweringLowerableStmt{ WhileBindLoop: COPY cast_payload };,
    Locatable.BreakNode AS cast_payload -> RETURN MIRLoweringLowerableStmt{ BreakNode: COPY cast_payload };,
    Locatable.ContinueNode AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ContinueNode: COPY cast_payload };,
    Locatable.FuncCall AS cast_payload -> RETURN MIRLoweringLowerableStmt{ FuncCall: COPY cast_payload };,
    Locatable.GetField AS cast_payload -> RETURN MIRLoweringLowerableStmt{ GetField: COPY cast_payload };,
    Locatable.GetIndex AS cast_payload -> RETURN MIRLoweringLowerableStmt{ GetIndex: COPY cast_payload };,
    Locatable.ReturnNode AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ReturnNode: COPY cast_payload };,
    Locatable.Assert AS cast_payload -> RETURN MIRLoweringLowerableStmt{ Assert: COPY cast_payload };,
    Locatable.ThrowNode AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ThrowNode: COPY cast_payload };,
    Locatable.DieNode AS cast_payload -> RETURN MIRLoweringLowerableStmt{ DieNode: COPY cast_payload };,
    Locatable.Slice AS cast_payload -> RETURN MIRLoweringLowerableStmt{ Slice: COPY cast_payload };,
    Locatable.Require AS cast_payload -> RETURN MIRLoweringLowerableStmt{ Require: COPY cast_payload };,
    Locatable.WithBlock AS cast_payload -> RETURN MIRLoweringLowerableStmt{ WithBlock: COPY cast_payload };,
    Locatable.SyncPolicyDecl AS cast_payload -> RETURN MIRLoweringLowerableStmt{ SyncPolicyDecl: COPY cast_payload };,
    Locatable.SelectOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ SelectOp: COPY cast_payload };,
    Locatable.WhereOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ WhereOp: COPY cast_payload };,
    Locatable.IndexOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ IndexOp: COPY cast_payload };,
    Locatable.ReduceOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ReduceOp: COPY cast_payload };,
    Locatable.OrderByOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ OrderByOp: COPY cast_payload };,
    Locatable.LimitOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ LimitOp: COPY cast_payload };,
    Locatable.UnnestOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ UnnestOp: COPY cast_payload };,
    Locatable.DistinctOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ DistinctOp: COPY cast_payload };,
    Locatable.EachOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ EachOp: COPY cast_payload };,
    Locatable.TapOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ TapOp: COPY cast_payload };,
    Locatable.SkipOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ SkipOp: COPY cast_payload };,
    Locatable.CollectOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ CollectOp: COPY cast_payload };,
    Locatable.TakeWhileOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ TakeWhileOp: COPY cast_payload };,
    Locatable.WindowOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ WindowOp: COPY cast_payload };,
    Locatable.BatchWindowOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ BatchWindowOp: COPY cast_payload };,
    Locatable.JoinOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ JoinOp: COPY cast_payload };,
    Locatable.FindOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ FindOp: COPY cast_payload };,
    Locatable.AnyOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ AnyOp: COPY cast_payload };,
    Locatable.AllOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ AllOp: COPY cast_payload };,
    Locatable.CountOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ CountOp: COPY cast_payload };,
    Locatable.SumOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ SumOp: COPY cast_payload };,
    Locatable.AverageOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ AverageOp: COPY cast_payload };,
    Locatable.MinOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ MinOp: COPY cast_payload };,
    Locatable.MaxOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ MaxOp: COPY cast_payload };,
    Locatable.ShardOp AS cast_payload -> RETURN MIRLoweringLowerableStmt{ ShardOp: COPY cast_payload };,
