REQUIRE "pkg:rtoc_6173742f747970652e636c656172"
# Ruby module AST
PUB STRUCT StructField {
  type: Type,
  default: ?Locatable@boxed,
  borrowed: Bool
}

# The slot holds the parsed default expression itself; it used to be wrapped in
# the metadata union it travels through, which every reader then had to unwrap.
PUB FN structField__node_default(node: ?Locatable) RETURNS ?Locatable ->
  RETURN COPY node;
END
PUB FN structField__default(self: StructField) RETURNS ?Locatable ->
  RETURN COPY self.default;
END
PUB FN structField__borrowed(self: StructField) RETURNS Bool ->
  RETURN !(!(self.borrowed));
END
# End Ruby module AST
