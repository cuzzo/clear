# Wraps a parsed default expression as the metadata value the slot holds.
PUB FN structField__node_default(node: ?Locatable) RETURNS ?SchemasResourceSchemaFieldMetadataValue ->
  IF node EXISTS AS present THEN
    RETURN SchemasResourceSchemaFieldMetadataValue{ Locatable: COPY present };
