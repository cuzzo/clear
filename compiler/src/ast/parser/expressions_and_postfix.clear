PRIVATE FN clearParser__parse_select_op(MUTABLE self: ClearParser) RETURNS !SelectOp
  EFFECTS REENTRANT ->
    MUTABLE token = TRY (clearParser__consume(&self, :KEYWORD, "SELECT"));
    TRY (clearParser__reject_legacy_select_effect_spelling_mut(&self));
    MUTABLE modifier_order: ?String = TRY (clearParser__parse_select_modifier_order(&self));
    MUTABLE effect_mode: ?String@symbol = clearParser__select_effect_mode_for(self, modifier_order);
    RETURN SelectOp{ token: COPY token, expression: TRY (clearParser__parse_expression(&self, 1)), effect_mode: COPY effect_mode, stream_mode: ((modifier_order != NIL) AND (modifier_order.contains?("~") == TRUE)), modifier_order: COPY modifier_order, capture_analysis: NIL, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
END
PRIVATE FN clearParser__reject_legacy_select_effect_spelling_mut(MUTABLE self: ClearParser) RETURNS !Void ->
    IF !((TRY (clearParser__match?(&self, :CHAR, "!")) OR TRY (clearParser__match?(&self, :CHAR, "?")))) THEN
      RETURN;
    END
    MUTABLE marker = token__display_value(clearParser__current(self));
    IF (((marker == "!") AND (clearParser__peek(self).type == :CHAR)) AND (token__text_is?(clearParser__peek(self), "?"))) THEN
      marker = (marker $+ "?");
    END
    MUTABLE fix = TRY (fix__new(TRY (clearParser__fix_description(self, :INSERT_SELECT_EFFECT_COLON, {:selector: "SELECT:${marker}"})), [edit__new(span__new(NIL, clearParser__current(self).line, clearParser__current(self).column, 0), ":")], :auto));
    TRY (clearParser__fixable_mut(&self, clearParser__current(self), :syntax, [fix], NIL, :SELECT_EFFECT_COLON_REQUIRED, :error, TRUE, {:selector: "SELECT:${marker}"}));
END
PRIVATE FN clearParser__parse_select_modifier_order(MUTABLE self: ClearParser) RETURNS !?String
  EFFECTS REENTRANT ->
    IF !(TRY (clearParser__match?(&self, :CHAR, ":"))) THEN
      RETURN NIL;
    END
    MUTABLE modifier = clearParser__peek(self);
    IF !(((modifier.type == :CHAR) AND (["!", "?", "~"]).contains?(token__display_value(modifier)))) THEN
      RETURN NIL;
    END
    TRY (clearParser__consume(&self, :CHAR, ":"));
    MUTABLE order = "";
    WHILE ((TRY (clearParser__match?(&self, :CHAR, "!")) OR TRY (clearParser__match?(&self, :CHAR, "?"))) OR TRY (clearParser__match?(&self, :CHAR, "~"))) DO
      order = (order $+ token__display_value(clearParser__current(self)));
      TRY (clearParser__consume(&self, :CHAR, token__display_value(clearParser__current(self))));
    END
    IF !((valid_select_modifier_orders |> ANY (_ == order))) THEN
      TRY (clearParser__error_mut(&self, modifier, CodeOrMessage{ SymbolValue: :SELECT_MODIFIER_ORDER_INVALID }, [], {:order: "${order}"}));
    END
    RETURN order;
END
PRIVATE FN clearParser__select_effect_mode_for(self: ClearParser, order: ?String) RETURNS ?String@symbol ->
    IF order EXISTS AS order_value THEN
      IF (order_value == "~") THEN
        RETURN NIL;
      ELSE
        MUTABLE inner = replace(order_value, "~", "");
        IF (inner.contains?("!") AND inner.contains?("?")) THEN
          RETURN :fallible_optional;
        END
        IF inner.contains?("?") THEN
          RETURN :optional;
        END
        IF inner.contains?("!") THEN
          RETURN :fallible;
        END
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
END
