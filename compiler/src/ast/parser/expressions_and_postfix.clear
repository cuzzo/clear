          BREAK;
        END
        markers = markers $+ token__display_value(marker_token);
        offset = (offset + 1);
      ELSE
        BREAK;
      END
    END
    IF (markers.length == 0) THEN
      RETURN NIL;
    END
    MUTABLE dot: ?Token = clearParser__peek_at(rtoc_self_view, offset);
    IF dot EXISTS AS dot_token THEN
      IF ((dot_token.type != :CHAR) OR !(token__text_is?(dot_token, "."))) THEN
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
    RETURN COPY markers;
}
