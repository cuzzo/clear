    clearParser__fixable_mut(rtoc_self_view, token, :syntax, [fix], NIL, :OPERATOR_TYPO_SUGGESTION, :error, FALSE, {:match: "${COPY legacy}", :replace: "${COPY replacement}"});
    MUTABLE canonical: Token = COPY token;
    canonical.type = :KEYWORD;
    canonical.value = replacement;
    RETURN canonical;
}
