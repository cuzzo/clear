PRIVATE FN clearParser__reject_legacy_select_effect_spelling_mut(self: ClearParser) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((clearParser__match?(rtoc_self_view, :CHAR, "!") OR clearParser__match?(rtoc_self_view, :CHAR, "?"))) THEN
      RETURN;
    END
    MUTABLE marker = token__display_value(clearParser__current(rtoc_self_view));
    IF (((marker == "!") AND (clearParser__peek(rtoc_self_view).type == :CHAR)) AND (token__text_is?(clearParser__peek(rtoc_self_view), "?"))) THEN
      marker = (marker $+ "?");
    END
    MUTABLE fix = TRY (fix__new(clearParser__fix_description(rtoc_self_view, :INSERT_SELECT_EFFECT_COLON, {:selector: "SELECT:${marker}"}), [edit__new(span__new(NIL, clearParser__current(rtoc_self_view).line, clearParser__current(rtoc_self_view).column, 0), ":")], :auto));
    clearParser__fixable_mut(rtoc_self_view, clearParser__current(rtoc_self_view), :syntax, [fix], NIL, :SELECT_EFFECT_COLON_REQUIRED, :error, TRUE, {:selector: "SELECT:${marker}"});
}
END
PRIVATE FN clearParser__parse_select_modifier_order(MUTABLE self: ClearParser) RETURNS !?String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(clearParser__match?(rtoc_self_view, :CHAR, ":")) THEN
      RETURN NIL;
    END
    MUTABLE modifier = clearParser__peek(rtoc_self_view);
    IF !(((modifier.type == :CHAR) AND (["!", "?", "~"]).contains?(token__display_value(modifier)))) THEN
      RETURN NIL;
    END
    clearParser__consume(&rtoc_self_view, :CHAR, ":");
    MUTABLE order = "";
    WHILE ((clearParser__match?(rtoc_self_view, :CHAR, "!") OR clearParser__match?(rtoc_self_view, :CHAR, "?")) OR clearParser__match?(rtoc_self_view, :CHAR, "~")) DO
      order = (order $+ token__display_value(clearParser__current(rtoc_self_view)));
      clearParser__consume(&rtoc_self_view, :CHAR, token__display_value(clearParser__current(rtoc_self_view)));
    END
    IF !(valid_select_modifier_orders.contains?(order)) THEN
      clearParser__error_mut(rtoc_self_view, modifier, CodeOrMessage{ SymbolValue: :SELECT_MODIFIER_ORDER_INVALID }, [], {:order: "${order}"});
    END
    RETURN order;
}
END
PRIVATE FN clearParser__select_effect_mode_for(self: ClearParser, MUTABLE order: ?String) RETURNS ?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF order EXISTS AS order_value THEN
      IF (order_value == "~") THEN
        RETURN NIL;
      ELSE
        MUTABLE inner = replace(order_value, "~", "");
        IF (inner.contains?("!") AND inner.contains?("?")) THEN
          RETURN :fallible_optional;
        END
        IF inner.contains?("?") THEN
          RETURN :optional;
        END
        IF inner.contains?("!") THEN
          RETURN :fallible;
        END
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
