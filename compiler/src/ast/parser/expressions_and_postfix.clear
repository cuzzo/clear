    MUTABLE token = clearParser__current(self);
    MUTABLE markers = UNWRAP (clearParser__tense_navigation_marker_run(self));
    IF !((typeExpression__valid_tense_order?(markers) AND !((markers.length() == 0)))) THEN
      TRY (clearParser__error_mut(&self, token, CodeOrMessage{ SymbolValue: :TENSE_NAVIGATION_ORDER }, [], {:markers: "${COPY markers}"}));
    END
    MUTABLE marker_index = 0;
    WHILE marker_index < markers.length() DO
      TRY (clearParser__consume(&self, :CHAR, markers.charAt(marker_index)));
      marker_index = marker_index + 1;
    END
