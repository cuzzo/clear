PRIVATE FN clearParser__tense_navigation_marker_run(self: ClearParser) RETURNS ?String ->
    MUTABLE offset: Int64 = 0;
    MUTABLE markers = "";
    WHILE TRUE DO
      MUTABLE peeked: ?Token = clearParser__peek_at(self, offset);
      IF peeked EXISTS AS marker_token THEN
        IF ((marker_token.type != :CHAR) OR !((["!", "?", "~"]).contains?(token__display_value(marker_token)))) THEN
          BREAK;
        END
        markers = markers $+ token__display_value(marker_token);
        offset = (offset + 1);
      ELSE
        BREAK;
      END
    END
    IF (markers.length() == 0) THEN
      RETURN NIL;
    END
    MUTABLE dot: ?Token = clearParser__peek_at(self, offset);
    IF dot EXISTS AS dot_token THEN
      IF ((dot_token.type != :CHAR) OR !(token__text_is?(dot_token, "."))) THEN
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
    RETURN COPY markers;
