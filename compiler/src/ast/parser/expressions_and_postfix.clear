PRIVATE FN clearParser__tense_navigation_marker_run(self: ClearParser) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE offset: Int64 = 0;
    MUTABLE markers = "";
    WHILE TRUE DO
      MUTABLE peeked: ?Token = clearParser__peek_at(rtoc_self_view, offset);
      IF peeked EXISTS AS marker_token THEN
