PUB FN clearParser__emit_legacy_optional_binding_mut(MUTABLE self: ClearParser, as_token: Token) RETURNS !Void ->
    MUTABLE fix = TRY (fix__new(TRY (clearParser__fix_description(self, :INSERT_EXISTS_BEFORE_AS)), [edit__new(span__new(NIL, as_token.line, as_token.column, 0), "EXISTS ")], :auto));
    TRY (clearParser__fixable_mut(&self, as_token, :syntax, [fix], NIL, :OPTIONAL_BINDING_REQUIRES_EXISTS, :error, FALSE, {}));
END
PRIVATE FN clearParser__dispatch_suffix_rule(MUTABLE self: ClearParser, rule: ParserRule, lhs: Locatable) RETURNS !Locatable
  EFFECTS REENTRANT ->
    IF (rule.action == :parse_index_suffix) THEN
      RETURN TRY (clearParser__parse_index_suffix(&self, lhs));
    ELSE_IF (rule.action == :parse_static_call_suffix) THEN
      RETURN Locatable{ StaticCall: COPY TRY (clearParser__parse_static_call_suffix(&self, lhs)) };
    ELSE_IF (rule.action == :parse_dot_suffix) THEN
      RETURN TRY (clearParser__parse_dot_suffix(&self, lhs));
    ELSE_IF (rule.action == :parse_func_call_suffix) THEN
      RETURN Locatable{ FuncCall: COPY TRY (clearParser__parse_func_call_suffix(&self, lhs)) };
    ELSE_IF (rule.action == :parse_optional_unwrap_suffix) THEN
      RETURN TRY (clearParser__parse_optional_unwrap_suffix(&self, lhs));
    ELSE_IF (rule.action == :parse_tense_navigation_suffix) THEN
      RETURN TRY (clearParser__parse_tense_navigation_suffix(&self, lhs));
    ELSE_IF (rule.action == :parse_exists_suffix) THEN
      RETURN Locatable{ UnaryOp: COPY TRY (clearParser__parse_exists_suffix(&self, lhs)) };
    ELSE_IF (rule.action == :parse_is_ok_suffix) THEN
      RETURN Locatable{ UnaryOp: COPY TRY (clearParser__parse_is_ok_suffix(&self, lhs)) };
    ELSE_IF (rule.action == :parse_is_ready_suffix) THEN
      RETURN Locatable{ UnaryOp: COPY TRY (clearParser__parse_is_ready_suffix(&self, lhs)) };
    ELSE_IF (rule.action == :parse_capability_wrap_suffix) THEN
      RETURN Locatable{ CapabilityWrap: COPY TRY (clearParser__parse_capability_wrap_suffix(&self, lhs)) };
    ELSE_IF (rule.action == :parse_inline_union_variant_suffix) THEN
      RETURN Locatable{ UnionVariantLit: COPY TRY (clearParser__parse_inline_union_variant_suffix(&self, lhs)) };
    ELSE
      panic("Unknown suffix parser action {}");
    END
END
PRIVATE FN clearParser__suffix_rule_applicable?(MUTABLE self: ClearParser, rule: ParserRule, lhs: Locatable) RETURNS !Bool ->
    RETURN PARTIAL MATCH rule.action START
      :parse_exists_suffix -> !(clearParser__conditional_binding_suffix?(self)),
      :parse_is_ok_suffix -> !(clearParser__conditional_binding_suffix?(self)),
      :parse_inline_union_variant_suffix -> (!(TRY (clearParser__match_destructure_brace?(&self))) AND aST__inline_union_constructor_target?(lhs)),
      :parse_tense_navigation_suffix -> !((clearParser__tense_navigation_marker_run(self) == NIL)),
      DEFAULT -> TRUE
    END;
END
PRIVATE FN clearParser__conditional_binding_suffix?(self: ClearParser) RETURNS Bool ->
    RETURN ((clearParser__peek(self).type == :KEYWORD) AND (token__text_is?(clearParser__peek(self), "AS")));
END
PRIVATE FN clearParser__parse_exists_suffix(MUTABLE self: ClearParser, lhs: Locatable) RETURNS !UnaryOp
  EFFECTS REENTRANT ->
    MUTABLE token = TRY (clearParser__consume(&self, :KEYWORD, "EXISTS"));
    RETURN UnaryOp{ token: COPY token, op: :EXISTS, right: COPY lhs, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
