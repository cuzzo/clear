PRIVATE FN clearParser__dispatch_suffix_rule(MUTABLE self: ClearParser, rule: ParserRule, lhs: Locatable) RETURNS !Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (rule.action == :parse_index_suffix) THEN
      RETURN TRY (clearParser__parse_index_suffix(&rtoc_self_view, lhs));
    ELSE_IF (rule.action == :parse_static_call_suffix) THEN
      RETURN Locatable{ StaticCall: COPY TRY (clearParser__parse_static_call_suffix(&rtoc_self_view, lhs)) };
    ELSE_IF (rule.action == :parse_dot_suffix) THEN
      RETURN TRY (clearParser__parse_dot_suffix(&rtoc_self_view, lhs));
    ELSE_IF (rule.action == :parse_func_call_suffix) THEN
