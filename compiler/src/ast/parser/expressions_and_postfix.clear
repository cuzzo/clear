PRIVATE FN clearParser__parse_expression_body(MUTABLE self: ClearParser, precedence: Int64) RETURNS !Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE start_token = clearParser__current(rtoc_self_view);
    MUTABLE lhs = TRY (clearParser__parse_unary(&rtoc_self_view));
    WHILE TRUE DO
      MUTABLE raw_op_token = clearParser__current(rtoc_self_view);
      MUTABLE op_prec: ?Int64 = TRY (clearParser__binary_operator_precedence(rtoc_self_view, &raw_op_token));
      IF op_prec EXISTS AS op_prec_value THEN
        MUTABLE op_prec_value_mutable = COPY op_prec_value;
        IF (op_prec_value_mutable > precedence) THEN
          MUTABLE op_token = TRY (clearParser__canonical_binary_operator_token(rtoc_self_view, &raw_op_token));
          IF ((TRY (token__text_mut(op_token)) == "AS") AND (((clearParser__peek(rtoc_self_view).type == :TYPE_ID) OR ((TRY (token__text_mut(clearParser__peek(rtoc_self_view)))).charAt(0) != "$")))) THEN
            BREAK;
          END
          clearParser__consume(&rtoc_self_view, raw_op_token.type);
          lhs = TRY (clearParser__parse_binary_op(&rtoc_self_view, lhs, &op_token, op_prec_value_mutable));
        ELSE
          BREAK;
        END
      ELSE
        BREAK;
      END
    END
    RETURN clearParser__stamp_source_range_mut(rtoc_self_view, &lhs, start_token, clearParser__previous(rtoc_self_view));
}
END
PRIVATE FN clearParser__binary_operator_precedence(self: ClearParser, MUTABLE token: Token) RETURNS !?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (token.type == :LEGACY_LOGICAL) THEN
      IF (TRY (token__text_mut(token)) == "&&") THEN
        RETURN 5;
      ELSE
        RETURN 4;
      END
    END
    RETURN clearParser__get_precedence(rtoc_self_view, &token);
}
END
PRIVATE FN clearParser__get_precedence(self: ClearParser, MUTABLE token: Token) RETURNS !?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(((((((token.type == :CHAR) OR (token.type == :KEYWORD)) OR (token.type == :SMOOTH)) OR (token.type == symbol("OR_ELSE"))) OR (token.type == :RANGE_EXCL)) OR (token.type == :RANGE_INCL))) THEN
      RETURN NIL;
    END
    IF (TRY (token__text_mut(token)) == "|>") THEN
      RETURN 1;
    ELSE_IF (TRY (token__text_mut(token)) == "OR_ELSE") OR (TRY (token__text_mut(token)) == "AS") THEN
      RETURN 2;
    ELSE_IF (TRY (token__text_mut(token)) == "..<") OR (TRY (token__text_mut(token)) == "..<=") OR (TRY (token__text_mut(token)) == "..=") THEN
      RETURN 3;
    ELSE_IF (TRY (token__text_mut(token)) == "OR") THEN
      RETURN 4;
    ELSE_IF (TRY (token__text_mut(token)) == "AND") THEN
      RETURN 5;
    ELSE_IF (TRY (token__text_mut(token)) == "IS_A") OR (TRY (token__text_mut(token)) == "==") OR (TRY (token__text_mut(token)) == "!=") OR (TRY (token__text_mut(token)) == "<") OR (TRY (token__text_mut(token)) == ">") OR (TRY (token__text_mut(token)) == "<=") OR (TRY (token__text_mut(token)) == ">=") THEN
      RETURN 6;
    ELSE_IF (TRY (token__text_mut(token)) == "BIT_OR") THEN
      RETURN 7;
    ELSE_IF (TRY (token__text_mut(token)) == "XOR") THEN
      RETURN 8;
    ELSE_IF (TRY (token__text_mut(token)) == "BIT_AND") THEN
      RETURN 9;
    ELSE_IF (TRY (token__text_mut(token)) == "<<") OR (TRY (token__text_mut(token)) == ">>") THEN
      RETURN 10;
    ELSE_IF (TRY (token__text_mut(token)) == "+") OR (TRY (token__text_mut(token)) == "$+") OR (TRY (token__text_mut(token)) == "-") OR (TRY (token__text_mut(token)) == "%+") OR (TRY (token__text_mut(token)) == "%-") OR (TRY (token__text_mut(token)) == "!+") OR (TRY (token__text_mut(token)) == "!-") THEN
      RETURN 11;
    ELSE_IF (TRY (token__text_mut(token)) == "*") OR (TRY (token__text_mut(token)) == "/") OR (TRY (token__text_mut(token)) == "MOD") OR (TRY (token__text_mut(token)) == "%*") OR (TRY (token__text_mut(token)) == "!*") THEN
      RETURN 12;
    ELSE_IF (TRY (token__text_mut(token)) == "**") THEN
      RETURN 13;
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN clearParser__canonical_binary_operator_token(self: ClearParser, MUTABLE token: Token) RETURNS !Token
