    ELSE_IF (rule.action == :parse_tense_navigation_suffix) THEN
      RETURN TRY (clearParser__parse_tense_navigation_suffix(&rtoc_self_view, lhs));
    ELSE_IF (rule.action == :parse_exists_suffix) THEN
      RETURN Locatable{ UnaryOp: COPY TRY (clearParser__parse_exists_suffix(&rtoc_self_view, lhs)) };
    ELSE_IF (rule.action == :parse_is_ok_suffix) THEN
      RETURN Locatable{ UnaryOp: COPY TRY (clearParser__parse_is_ok_suffix(&rtoc_self_view, lhs)) };
    ELSE_IF (rule.action == :parse_is_ready_suffix) THEN
      RETURN Locatable{ UnaryOp: COPY TRY (clearParser__parse_is_ready_suffix(&rtoc_self_view, lhs)) };
    ELSE_IF (rule.action == :parse_capability_wrap_suffix) THEN
      RETURN Locatable{ CapabilityWrap: COPY clearParser__parse_capability_wrap_suffix(&rtoc_self_view, lhs) };
    ELSE_IF (rule.action == :parse_inline_union_variant_suffix) THEN
      RETURN Locatable{ UnionVariantLit: COPY TRY (clearParser__parse_inline_union_variant_suffix(&rtoc_self_view, lhs)) };
