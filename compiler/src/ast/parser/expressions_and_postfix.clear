valid_select_modifier_orders: [11]String = ["!", "?", "!?", "~", "~!", "~?", "~!?", "!~", "!~!", "!~?", "!~!?"];
PUB FN castBgNodeToLocatable(value: BgNode) RETURNS Locatable ->
  PARTIAL MATCH value START
    BgNode.BgBlock AS payload -> RETURN Locatable{ BgBlock: COPY payload };,
    BgNode.BgStreamBlock AS payload -> RETURN Locatable{ BgStreamBlock: COPY payload };
  END
  panic("Invalid cast to Locatable");
END
PUB FN castWindowPipelineOpToLocatable(value: ClearParserWindowPipelineOp) RETURNS Locatable ->
  PARTIAL MATCH value START
    ClearParserWindowPipelineOp.WindowOp AS payload -> RETURN Locatable{ WindowOp: COPY payload };,
    ClearParserWindowPipelineOp.BatchWindowOp AS payload -> RETURN Locatable{ BatchWindowOp: COPY payload };
  END
  panic("Invalid cast to Locatable");
END
