PUB FN clearParser__parse_expression(MUTABLE self: ClearParser, precedence: Int64 = 0) RETURNS !Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE rtoc_mutable_receiver_5 = KEEP rtoc_self_view.budget;
  TRY (frontendResourceBudget__enter_mut(&rtoc_mutable_receiver_5));
  MUTABLE prev_ambient: ?Int64 = rtoc_self_view.wrapper_operand_precedence;
  DEFER rtoc_self_view.wrapper_operand_precedence = prev_ambient;
  rtoc_self_view.wrapper_operand_precedence = COPY precedence;
  MUTABLE expression = TRY (clearParser__parse_expression_body(&rtoc_self_view, precedence));
  MUTABLE rtoc_mutable_receiver_6 = KEEP rtoc_self_view.budget;
  frontendResourceBudget__leave_mut(&rtoc_mutable_receiver_6);
  RETURN expression;
}
END
PRIVATE FN clearParser__wrapper_operand_precedence(self: ClearParser) RETURNS Int64
