->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE token = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "CONCURRENT"));
    MUTABLE options: {String}Locatable = {};
