FN regexReplaceFirst__expressions_and_postfix(subject: String, pattern: String, replacement: String) RETURNS String ->
  RETURN compilerRegexReplaceFirst(subject, compilerRegexCompile(pattern), replacement);
END

FN regexMatch__expressions_and_postfix?(subject: String, pattern: String) RETURNS Bool ->
  RETURN compilerRegexMatch(subject, compilerRegexCompile(pattern));
END
EXTERN FN compilerInspectValue() RETURNS String EFFECTS :safe FROM "compiler_regex";
EXTERN STRUCT CompilerRegex {} FROM "compiler_regex";
EXTERN FN compilerRegexCompile(pattern: String) RETURNS CompilerRegex EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexMatch(subject: String, regex: CompilerRegex) RETURNS Bool EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexReplaceFirst(subject: String, regex: CompilerRegex, replacement: String) RETURNS String EFFECTS :safe FROM "compiler_regex";

valid_select_modifier_orders: [11]String = ["!", "?", "!?", "~", "~!", "~?", "~!?", "!~", "!~!", "!~?", "!~!?"];
PUB FN castBgNodeToLocatable(value: BgNode) RETURNS Locatable ->
  PARTIAL MATCH value START
    BgNode.BgBlock AS payload -> RETURN Locatable{ BgBlock: COPY payload };,
    BgNode.BgStreamBlock AS payload -> RETURN Locatable{ BgStreamBlock: COPY payload };
  END
  panic("Invalid cast to Locatable");
END
PUB FN castWindowPipelineOpToLocatable(value: ClearParserWindowPipelineOp) RETURNS Locatable ->
  PARTIAL MATCH value START
    ClearParserWindowPipelineOp.WindowOp AS payload -> RETURN Locatable{ WindowOp: COPY payload };,
    ClearParserWindowPipelineOp.BatchWindowOp AS payload -> RETURN Locatable{ BatchWindowOp: COPY payload };
  END
  panic("Invalid cast to Locatable");
END
