    MUTABLE wrapped_branch_value: ?Locatable = NIL;
    PARTIAL MATCH node START
      Locatable.GetField AS get_field ->
      wrapped_branch_value = COPY get_field.target;,
      Locatable.GetIndex AS get_index ->
      wrapped_branch_value = COPY get_index.target;,
      Locatable.OptionalUnwrap AS optional_unwrap ->
      wrapped_branch_value = COPY optional_unwrap.target;,
