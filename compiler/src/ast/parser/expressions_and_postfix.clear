PRIVATE FN clearParser__suffix_rule_applicable?(self: ClearParser, rule: ParserRule, lhs: Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN PARTIAL MATCH rule.action START
      :parse_exists_suffix -> !(clearParser__conditional_binding_suffix?(rtoc_self_view)),
      :parse_is_ok_suffix -> !(clearParser__conditional_binding_suffix?(rtoc_self_view)),
      :parse_inline_union_variant_suffix -> (!(TRY (clearParser__match_destructure_brace?(rtoc_self_view))) AND aST__inline_union_constructor_target?(lhs)),
      :parse_tense_navigation_suffix -> !((clearParser__tense_navigation_marker_run(rtoc_self_view) == NIL)),
      DEFAULT -> TRUE
    END;
}
END
