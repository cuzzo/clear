PUB FN clearParser__source_range_from_node(self: ClearParser, first: Locatable, last: Token) RETURNS !SourceRange
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE source_range: ?SourceRange = NIL;
    MATCH first START
      Locatable.Program AS item ->
        source_range = COPY item.source_range;,
      Locatable.RequireNode AS item ->
        source_range = COPY item.source_range;,
      Locatable.ProtocolRequirement AS item ->
        source_range = COPY item.source_range;,
      Locatable.ProtocolDef AS item ->
        source_range = COPY item.source_range;,
      Locatable.FunctionDef AS item ->
        source_range = COPY item.source_range;,
      Locatable.ImplementationDef AS item ->
        source_range = COPY item.source_range;,
      Locatable.ConformanceDef AS item ->
        source_range = COPY item.source_range;,
      Locatable.StructDef AS item ->
        source_range = COPY item.source_range;,
      Locatable.VarDecl AS item ->
        source_range = COPY item.source_range;,
      Locatable.Assignment AS item ->
        source_range = COPY item.source_range;,
      Locatable.DestructureTarget AS item ->
        source_range = COPY item.source_range;,
      Locatable.DestructuringAssignment AS item ->
        source_range = COPY item.source_range;,
      Locatable.BindExpr AS item ->
        source_range = COPY item.source_range;,
      Locatable.BinaryOp AS item ->
        source_range = COPY item.source_range;,
      Locatable.IsA AS item ->
        source_range = COPY item.source_range;,
      Locatable.UnaryOp AS item ->
        source_range = COPY item.source_range;,
      Locatable.CallSiteOverride AS item ->
        source_range = COPY item.source_range;,
      Locatable.Identifier AS item ->
        source_range = COPY item.source_range;,
      Locatable.Literal AS item ->
        source_range = COPY item.source_range;,
      Locatable.ListLit AS item ->
        source_range = COPY item.source_range;,
      Locatable.TupleLit AS item ->
        source_range = COPY item.source_range;,
      Locatable.DefaultArrayLit AS item ->
        source_range = COPY item.source_range;,
      Locatable.HashLit AS item ->
        source_range = COPY item.source_range;,
      Locatable.DefaultLit AS item ->
        source_range = COPY item.source_range;,
      Locatable.StructLit AS item ->
        source_range = COPY item.source_range;,
      Locatable.LambdaLit AS item ->
        source_range = COPY item.source_range;,
      Locatable.IfStatement AS item ->
        source_range = COPY item.source_range;,
      Locatable.IfBind AS item ->
        source_range = COPY item.source_range;,
      Locatable.WhileLoop AS item ->
        source_range = COPY item.source_range;,
      Locatable.WhileBindLoop AS item ->
        source_range = COPY item.source_range;,
      Locatable.BreakNode AS item ->
        source_range = COPY item.source_range;,
      Locatable.ContinueNode AS item ->
        source_range = COPY item.source_range;,
      Locatable.FuncCall AS item ->
        source_range = COPY item.source_range;,
      Locatable.MethodCall AS item ->
        source_range = COPY item.source_range;,
      Locatable.GetField AS item ->
        source_range = COPY item.source_range;,
