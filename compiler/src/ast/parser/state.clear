      Locatable.StructPattern AS item ->
        source_range = COPY item.source_range;,
      Locatable.RangeLit AS item ->
        source_range = COPY item.source_range;,
      Locatable.ExternFnDecl AS item ->
        source_range = COPY item.source_range;,
      Locatable.ExternStructDecl AS item ->
        source_range = COPY item.source_range;,
      Locatable.EnumDef AS item ->
        source_range = COPY item.source_range;,
      Locatable.UnionDef AS item ->
        source_range = COPY item.source_range;,
      Locatable.UnionVariantLit AS item ->
        source_range = COPY item.source_range;,
      Locatable.StaticCall AS item ->
        source_range = COPY item.source_range;,
      Locatable.DoBlock AS item ->
        source_range = COPY item.source_range;,
      Locatable.BgBlock AS item ->
        source_range = COPY item.source_range;,
      Locatable.ThenChain AS item ->
        source_range = COPY item.source_range;,
      Locatable.BgStreamBlock AS item ->
        source_range = COPY item.source_range;,
      Locatable.YieldExpr AS item ->
        source_range = COPY item.source_range;,
      Locatable.CloseStream AS item ->
        source_range = COPY item.source_range;,
      Locatable.NextExpr AS item ->
        source_range = COPY item.source_range;,
      Locatable.MatchStatement AS item ->
        source_range = COPY item.source_range;,
      Locatable.ForRange AS item ->
        source_range = COPY item.source_range;,
      Locatable.ForEach AS item ->
        source_range = COPY item.source_range;,
      Locatable.TestBlock AS item ->
        source_range = COPY item.source_range;,
      Locatable.WhenBlock AS item ->
        source_range = COPY item.source_range;,
      Locatable.LetBinding AS item ->
        source_range = COPY item.source_range;,
      Locatable.TestThat AS item ->
        source_range = COPY item.source_range;,
      Locatable.AssertRaises AS item ->
        source_range = COPY item.source_range;,
      Locatable.BenchmarkStmt AS item ->
        source_range = COPY item.source_range;,
      Locatable.SmashStmt AS item ->
        source_range = COPY item.source_range;,
      Locatable.ProfileStmt AS item ->
        source_range = COPY item.source_range;,
      Locatable.StubDecl AS item ->
        source_range = COPY item.source_range;,
      Locatable.Drop AS item ->
        source_range = COPY item.source_range;,
      Locatable.SuppressCleanup AS item ->
        source_range = COPY item.source_range;,
      Locatable.Return AS item ->
        source_range = COPY item.source_range;,
      Locatable.ReassignCleanup AS item ->
        source_range = COPY item.source_range;,
      Locatable.FieldCleanup AS item ->
        source_range = COPY item.source_range;,
    END
    IF source_range EXISTS AS source_range_value THEN
      MUTABLE range: SourceRange = COPY source_range_value;
      MUTABLE end_offset = (last.end_offset OR_ELSE ((((last.start_offset OR_ELSE range.end_offset)) + (token__display_value(last)).bytes())));
      MUTABLE range_file: ?String = COPY range.file;
      IF (range_file == NIL) THEN
        range_file = COPY last.file;
      END
      RETURN SourceRange{ file: range_file, start_offset: range.start_offset, end_offset: end_offset, start_line: range.start_line, start_column: range.start_column, end_line: (last.end_line OR_ELSE last.line), end_column: (last.end_column OR_ELSE ((last.column + (token__display_value(last)).codepointCount()))) };
    END
    panic("Internal: source range missing from postfix receiver");
}
END
FN clearParser__source_code(self: ClearParser) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {

}
END
PUB FN clearParser__error_mut(self: ClearParser, node_or_token: ?Token, code_or_message: CodeOrMessage, args: Any[] = [], kwargs: {String@symbol}String = {}) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE token: ?Token = clearParser__diagnostic_token(rtoc_self_view, node_or_token);
    MUTABLE message: String = "";
    IF code_or_message IS_A String@symbol AS string_symbol THEN
      message = UNWRAP (TRY (diagnosticRegistry__format_from_hash(string_symbol, args, kwargs)));
    ELSE
      message = castCodeOrMessageToString(COPY code_or_message);
    END
    MUTABLE source_token: ?Token = clearParser__source_error_token(rtoc_self_view, token);
    MUTABLE diagnostic_code: ?String@symbol = NIL;
    IF code_or_message IS_A String@symbol AS string_symbol THEN
      diagnostic_code = COPY (string_symbol);
    END
    RETURN clearParser__raise_source_error_mut(rtoc_self_view, source_token, message, diagnostic_code);
}
END
FN clearParser__format_diagnostic_template(self: ClearParser, template: String, args: Any[], kwargs: {String@symbol}String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN diagnosticRegistry__format_template(template, args, kwargs);
}
END
PUB FN clearParser__diagnostic_message(self: ClearParser, code: String@symbol, args: Any[] = [], kwargs: {String@symbol}String = {}) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE message: ?String = TRY (diagnosticRegistry__format_from_hash(code, args, kwargs));
    IF message EXISTS AS message_value THEN
      RETURN COPY message_value;
    ELSE
      panic("Internal Compiler Error: Unknown error code :{}");
    END
}
END
PUB FN clearParser__fix_description(self: ClearParser, code: String@symbol, kwargs: {String@symbol}String = {}) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (diagnosticRegistry__fix_description_from_hash(code, kwargs));
}
END
PUB FN clearParser__fix_description_from_hash(self: ClearParser, code: String@symbol, kwargs: {String@symbol}String) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (diagnosticRegistry__fix_description_from_hash(code, kwargs));
}
END
PUB FN clearParser__note_mut(self: ClearParser, node_or_token: ?Token, message: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE token: ?Token = clearParser__source_error_token(rtoc_self_view, clearParser__diagnostic_token(rtoc_self_view, node_or_token));
    MUTABLE loc: String = "";
    IF token EXISTS AS token_value THEN
      loc = " (line ${token_value.line.toString()})";
    ELSE
      loc = "";
    END
    clearParser__diagnostic_output(rtoc_self_view, "\x1B[36m[Note]\x1B[0m ${message}${loc}");
    NIL;
}
END
PUB FN clearParser__warning_mut(self: ClearParser, node_or_token: ?Token, message: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE token: ?Token = clearParser__source_error_token(rtoc_self_view, clearParser__diagnostic_token(rtoc_self_view, node_or_token));
    MUTABLE loc: String = "";
    IF token EXISTS AS token_value THEN
      loc = " (line ${token_value.line.toString()})";
    ELSE
      loc = "";
    END
    clearParser__diagnostic_output(rtoc_self_view, "\x1B[33m[Warning]\x1B[0m ${message}${loc}");
    NIL;
}
END
PUB FN clearParser__fixable_mut(self: ClearParser, node_or_token: ?Token, category: String@symbol, fixes: []Fix, message: ?String = NIL, code: ?String@symbol = NIL, level: String@symbol = :warning, raise_in_collector: Bool = FALSE, kwargs: {String@symbol}String = {}) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rendered_message = (message OR_ELSE clearParser__diagnostic_message(rtoc_self_view, code?, [], kwargs));
    MUTABLE token: ?Token = clearParser__diagnostic_token(rtoc_self_view, node_or_token);
    MUTABLE source_token: ?Token = clearParser__source_error_token(rtoc_self_view, token);
    MUTABLE finding = TRY (fixableFinding__new(level, rendered_message, token, category, fixes));
    IF fixCollector__enabled?() THEN
      TRY (fixCollector__push(finding, (level == :error)));
      IF !(raise_in_collector) THEN
        RETURN;
      END
      clearParser__raise_source_error_mut(rtoc_self_view, source_token, rendered_message);
    END
    IF (level == :hint) OR (level == :info) OR (level == :warning) THEN
      MUTABLE loc: String = "";
      IF source_token EXISTS AS source_token_value THEN
        loc = " (line ${source_token_value.line.toString()})";
      ELSE
        loc = "";
      END
      MUTABLE tag: String = "";
      IF (level == :warning) THEN
        tag = "\x1B[33m[Warning]\x1B[0m";
      ELSE
        tag = "\x1B[36m[${level.capitalize()}]\x1B[0m";
      END
      RETURN clearParser__diagnostic_output(rtoc_self_view, "${tag} ${rendered_message}${loc}");
    ELSE_IF (level == :error) THEN
      RETURN clearParser__raise_source_error_mut(rtoc_self_view, source_token, rendered_message);
    ELSE
      RETURN;
    END
}
END
FN clearParser__diagnostic_source_code(self: ClearParser) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY rtoc_self_view.source_code;
}
END
PUB FN clearParser__raise_source_error_mut(self: ClearParser, token: ?Token, message: String, code: ?String@symbol = NIL) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF clearParser__parser_error_host?(rtoc_self_view) THEN
      RAISE Input, ParserError, message;
    END
    RAISE Input, CompilerError, message;
}
END
PUB FN clearParser__diagnostic_token(self: ClearParser, node_or_token: ?Token) RETURNS ?Token
  REQUIRES self: LOCAL
->
  RETURN COPY node_or_token;
END
PUB FN clearParser__source_error_token(self: ClearParser, token: ?Token) RETURNS ?Token
  REQUIRES self: LOCAL
->
  RETURN COPY token;
END
PUB FN clearParser__diagnostic_output(self: ClearParser, message: String) RETURNS Void
  REQUIRES self: LOCAL
->
  print(message);
END
PUB FN castCodeOrMessageToString(value: CodeOrMessage) RETURNS String ->
  IF value IS_A String AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN "";
END
