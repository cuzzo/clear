EXTERN STRUCT CompilerRegex {} FROM "compiler_regex";
EXTERN FN compilerRegexCompile(pattern: String) RETURNS CompilerRegex EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexReplaceAll(subject: String, regex: CompilerRegex, replacement: String) RETURNS String EFFECTS :safe FROM "compiler_regex";
PUB FN regexReplaceAll(subject: String, pattern: String, replacement: String) RETURNS String ->
  RETURN compilerRegexReplaceAll(subject, compilerRegexCompile(pattern), replacement);
END

PUB UNION ClearParserReturnValue { VarDecl: VarDecl, DestructuringAssignment: DestructuringAssignment, ExternFnDecl: ExternFnDecl, ExternStructDecl: ExternStructDecl, ImplementationDef: ImplementationDef, ConformanceDef: ConformanceDef, Token: Token, BoolValue: Bool, ForRange: ForRange, ForEach: ForEach, Program: Program, RequireNode: RequireNode, ProtocolRequirement: ProtocolRequirement, ProtocolDef: ProtocolDef, FunctionDef: FunctionDef, StructDef: StructDef, Assignment: Assignment, DestructureTarget: DestructureTarget, BindExpr: BindExpr, BinaryOp: BinaryOp, IsA: IsA, UnaryOp: UnaryOp, CallSiteOverride: CallSiteOverride, Identifier: Identifier, Literal: Literal, ListLit: ListLit, TupleLit: TupleLit, DefaultArrayLit: DefaultArrayLit, HashLit: HashLit, DefaultLit: DefaultLit, StructLit: StructLit, LambdaLit: LambdaLit, IfStatement: IfStatement, IfBind: IfBind, WhileLoop: WhileLoop, WhileBindLoop: WhileBindLoop, BreakNode: BreakNode, ContinueNode: ContinueNode, FuncCall: FuncCall, MethodCall: MethodCall, GetField: GetField, GetIndex: GetIndex, Cast: Cast, ReturnNode: ReturnNode, Assert: Assert, Raise: Raise, ThrowNode: ThrowNode, DieNode: DieNode, Slice: Slice, Require: Require, DeferStmt: DeferStmt, WithBlock: WithBlock, SyncPolicyDecl: SyncPolicyDecl, SelectOp: SelectOp, WhereOp: WhereOp, IndexOp: IndexOp, ReduceOp: ReduceOp, OrderByOp: OrderByOp, LimitOp: LimitOp, UnnestOp: UnnestOp, DistinctOp: DistinctOp, EachOp: EachOp, TapOp: TapOp, SkipOp: SkipOp, CollectOp: CollectOp, TakeWhileOp: TakeWhileOp, WindowOp: WindowOp, BatchWindowOp: BatchWindowOp, JoinOp: JoinOp, FindOp: FindOp, AnyOp: AnyOp, AllOp: AllOp, CountOp: CountOp, SumOp: SumOp, AverageOp: AverageOp, MinOp: MinOp, MaxOp: MaxOp, ShardOp: ShardOp, ConcurrentOp: ConcurrentOp, Placeholder: Placeholder, Copy: Copy, OptionalUnwrap: OptionalUnwrap, TenseNavigation: TenseNavigation, MutableBorrow: MutableBorrow, OrElseRaise: OrElseRaise, OrElseExit: OrElseExit, OrElsePass: OrElsePass, OrElsePrune: OrElsePrune, OrElseBreak: OrElseBreak, CatchBlock: CatchBlock, RecoverOp: RecoverOp, BlockExpr: BlockExpr, StringConcat: StringConcat, CapabilityWrap: CapabilityWrap, MoveNode: MoveNode, CopyNode: CopyNode, KeepNode: KeepNode, ShareNode: ShareNode, LinkNode: LinkNode, ResolveNode: ResolveNode, FreezeNode: FreezeNode, PassStmt: PassStmt, StructPattern: StructPattern, RangeLit: RangeLit, EnumDef: EnumDef, UnionDef: UnionDef, UnionVariantLit: UnionVariantLit, StaticCall: StaticCall, DoBlock: DoBlock, BgBlock: BgBlock, ThenChain: ThenChain, BgStreamBlock: BgStreamBlock, YieldExpr: YieldExpr, CloseStream: CloseStream, NextExpr: NextExpr, MatchStatement: MatchStatement, TestBlock: TestBlock, WhenBlock: WhenBlock, LetBinding: LetBinding, TestThat: TestThat, AssertRaises: AssertRaises, BenchmarkStmt: BenchmarkStmt, SmashStmt: SmashStmt, ProfileStmt: ProfileStmt, StubDecl: StubDecl, Drop: Drop, SuppressCleanup: SuppressCleanup, Return: Return, ReassignCleanup: ReassignCleanup, FieldCleanup: FieldCleanup, Type: Type, FunctionDefMultiowned: FunctionDef@multiowned, SelectOpMultiowned: SelectOp@multiowned, WhereOpMultiowned: WhereOp@multiowned, IndexOpMultiowned: IndexOp@multiowned, ReduceOpMultiowned: ReduceOp@multiowned, OrderByOpMultiowned: OrderByOp@multiowned, UnnestOpMultiowned: UnnestOp@multiowned, DistinctOpMultiowned: DistinctOp@multiowned, TakeWhileOpMultiowned: TakeWhileOp@multiowned, WindowOpMultiowned: WindowOp@multiowned, BatchWindowOpMultiowned: BatchWindowOp@multiowned, FindOpMultiowned: FindOp@multiowned, AnyOpMultiowned: AnyOp@multiowned, AllOpMultiowned: AllOp@multiowned, CountOpMultiowned: CountOp@multiowned, SumOpMultiowned: SumOp@multiowned, AverageOpMultiowned: AverageOp@multiowned, MinOpMultiowned: MinOp@multiowned, MaxOpMultiowned: MaxOp@multiowned, AssertRaisesMultiowned: AssertRaises@multiowned, BenchmarkStmtMultiowned: BenchmarkStmt@multiowned, SmashStmtMultiowned: SmashStmt@multiowned, ProfileStmtMultiowned: ProfileStmt@multiowned, TypeMultiowned: Type@multiowned, TokenMultiowned: Token@multiowned }
PUB UNION CodeOrMessage { StringValue: String, SymbolValue: String@symbol }
PUB STRUCT ClearParser {
  budget: FrontendResourceBudget@multiowned,
  wrapper_operand_precedence: ?Int64,
  delimiter_closings: []?Int64,
  gradual: Bool,
  pos: Int64,
  source_code: String,
  tokens: []Token
}

syntax_tokens_at_statement_end: [4]String = [";", "THEN", "DO", "->"];
PUB FN clearParser__parser_error_host?(self: ClearParser) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRUE;
}
END
PUB FN clearParser__index_delimiter_closings(self: ClearParser, tokens: []Token) RETURNS ![]?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE opening_chars: []String = List[];
    MUTABLE opening_indices: []Int64 = List[];
    MUTABLE closings: []?Int64 = List[];
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < tokens.length DO
      &closings.append(NIL);
      IF !((tokens[rtoc_idx]?.type == :CHAR)) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE value = TRY (token__text_mut(tokens[rtoc_idx]?));
      IF "([{".contains?(value) THEN
          &opening_chars.append(value);
          &opening_indices.append(COPY rtoc_idx);
      ELSE_IF !((opening_chars.length == 0)) THEN
          MUTABLE opening = COPY UNWRAP (opening_chars.last());
          MUTABLE closing = ")]}".substr(UNWRAP ("([{".indexOf(opening)), 1);
          IF !((closing == value)) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
          END
          &opening_chars.pop();
          MUTABLE opening_index: ?Int64 = &opening_indices.pop();
          closings[opening_index?] = rtoc_idx;
      END
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN closings;
}
END
PUB FN clearParser__peek(self: ClearParser) RETURNS Token
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE token: ?Token = COPY rtoc_self_view.tokens[(rtoc_self_view.pos + 1)];
    IF token EXISTS AS token_value THEN
      RETURN COPY token_value;
    END
    RETURN Token{ type: :EOF, value: TokenValue{ StringValue: COPY "" }, line: clearParser__current(rtoc_self_view).line, column: clearParser__current(rtoc_self_view).column, file: NIL, start_offset: NIL, end_offset: NIL, end_line: NIL, end_column: NIL };
}
END
PUB FN clearParser__peek_at(self: ClearParser, n: Int64) RETURNS ?Token
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY rtoc_self_view.tokens[(rtoc_self_view.pos + n)];
}
END
PUB FN clearParser__current(self: ClearParser) RETURNS Token
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY UNWRAP (rtoc_self_view.tokens[rtoc_self_view.pos]);
}
END
PUB FN clearParser__previous(self: ClearParser) RETURNS Token
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY UNWRAP (rtoc_self_view.tokens[(rtoc_self_view.pos - 1)]);
}
END
PUB FN clearParser__consume_number(MUTABLE self: ClearParser) RETURNS !Token
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_cur_0 = clearParser__current(rtoc_self_view);
    IF ((rtoc_cur_0.type == :NUMBER) OR (rtoc_cur_0.type == :INT64)) THEN
      MUTABLE tok = clearParser__current(rtoc_self_view);
      rtoc_self_view.pos = (rtoc_self_view.pos + 1);
      RETURN tok;
    ELSE
      TRY (clearParser__error_mut(rtoc_self_view, clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :EXPECTED_NUMBER }, [], {:value: "${token__display_value(clearParser__current(rtoc_self_view))}", :type: "${clearParser__current(rtoc_self_view).type}"}));
      RETURN clearParser__current(rtoc_self_view);
    END
}
END
PUB FN clearParser__consume(MUTABLE self: ClearParser, type: String@symbol, value: ?String = NIL) RETURNS !Token
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE token = clearParser__current(rtoc_self_view);
    MUTABLE matches_value: Bool = FALSE;
    IF value EXISTS AS value_value THEN
      MUTABLE expected_value = COPY value_value;
      # Ruby guards on `token.value.is_a?(String)`; without it, text_mut raises
      # TokenPayloadError for every token whose payload is not a String.
      IF (COPY token.value) EXISTS AS payload THEN
        IF payload IS_A String THEN
          matches_value = (TRY (token__text_mut(token)) == expected_value);
        END
      END
    END
    IF (((token.type == type)) OR matches_value) THEN
      IF ((value != NIL) AND !(matches_value)) THEN
        TRY (clearParser__emit_consume_error_with_fix(rtoc_self_view, token, type, value));
      END
      rtoc_self_view.pos = (rtoc_self_view.pos + 1);
      RETURN token;
    ELSE
      TRY (clearParser__emit_consume_error_with_fix(rtoc_self_view, token, type, value));
      RETURN token;
    END
}
END
PRIVATE FN clearParser__emit_consume_error_with_fix(self: ClearParser, token: Token, expected_type: String@symbol, expected_value: ?String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE prev_tok: ?Token = NIL;
    IF (rtoc_self_view.pos > 0) THEN
      prev_tok = COPY rtoc_self_view.tokens[(rtoc_self_view.pos - 1)];
    END
    IF expected_value EXISTS AS expected_text THEN
     IF prev_tok EXISTS AS prev_tok_value THEN
      IF syntax_tokens_at_statement_end.contains?(expected_text) THEN
       IF (prev_tok_value.line < token.line) THEN
        RETURN TRY (clearParser__emit_syntax_insert_end_of_line_mut(rtoc_self_view, prev_tok_value, token, expected_text));
       END
       IF ((["THEN", "DO", "->"]).contains?(expected_text) AND (prev_tok_value.line == token.line)) THEN
        RETURN TRY (clearParser__emit_syntax_insert_before_token_mut(rtoc_self_view, token, expected_text));
       END
      END
     END
    END
    IF prev_tok EXISTS AS prev_suffix_tok THEN
     IF ((((token.type == :CHAR) AND (TRY (token__text_mut(token)) == "!")) AND ([:VAR_ID, :TYPE_ID]).contains?(prev_suffix_tok.type)) AND (prev_suffix_tok.end_offset == token.start_offset)) THEN
      clearParser__error_mut(rtoc_self_view, token, CodeOrMessage{ SymbolValue: :LEGACY_MUTATION_NAME_SUFFIX });
     END
    END
    TRY (clearParser__error_mut(rtoc_self_view, token, CodeOrMessage{ SymbolValue: :PARSER_EXPECTED }, [], {:expected: "${(expected_value OR_ELSE expected_type)}", :got: "${token__display_value(token)}", :type: "${token.type}", :line: token.line.toString()}));
}
END
PRIVATE FN clearParser__emit_syntax_insert_end_of_line_mut(self: ClearParser, prev_tok: Token, next_tok: Token, expected_value: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    # split() builds a temporary list; the element is a borrow INTO it, so the
    # binding needs its own copy or both free the same bytes.
    MUTABLE line_text = COPY (rtoc_self_view.source_code.split("\n")[(prev_tok.line - 1)] OR_ELSE "");
    MUTABLE insert_col = (regexReplaceAll(line_text, "\\s+\\z", "").length() + 1);
    MUTABLE leader: String = "";
    IF ((expected_value == ";")) THEN
      leader = "";
    ELSE
      leader = " ";
    END
    MUTABLE fix = TRY (fix__new(clearParser__fix_description(rtoc_self_view, :INSERT_EXPECTED_AT_END_OF_LINE, {:expected: "${expected_value}", :line: prev_tok.line.toString()}), [edit__new(span__new(NIL, prev_tok.line, insert_col, 0), "${leader}${expected_value}")], :auto));
    RETURN clearParser__fixable_mut(rtoc_self_view, next_tok, :type, [fix], NIL, :PARSER_EXPECTED_AT_END_OF_LINE, :error, TRUE, {:expected: "${expected_value}", :expected_line: prev_tok.line.toString(), :got: "${token__display_value(next_tok)}", :got_line: next_tok.line.toString()});
}
END
PRIVATE FN clearParser__emit_syntax_insert_before_token_mut(self: ClearParser, token: Token, expected_value: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fix = TRY (fix__new(clearParser__fix_description(rtoc_self_view, :INSERT_EXPECTED_BEFORE_TOKEN, {:expected: "${expected_value}", :got: "${token__display_value(token)}", :line: token.line.toString()}), [edit__new(span__new(NIL, token.line, token.column, 0), "${expected_value} ")], :auto));
    RETURN clearParser__fixable_mut(rtoc_self_view, token, :type, [fix], NIL, :PARSER_EXPECTED_BEFORE_TOKEN, :error, TRUE, {:expected: "${expected_value}", :got: "${token__display_value(token)}", :line: token.line.toString()});
}
END
PUB FN clearParser__match?(self: ClearParser, type: String@symbol, val: ?String = NIL) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE token = clearParser__current(rtoc_self_view);
    IF !((token.type == type)) THEN
      RETURN FALSE;
    END
    IF val EXISTS AS val_value THEN
      MUTABLE expected_value = COPY val_value;
      RETURN (TRY (token__text_mut(token)) == expected_value);
    ELSE
      RETURN TRUE;
    END
}
END
PUB FN clearParser__generic_close?(self: ClearParser) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (TRY (clearParser__match?(rtoc_self_view, :CHAR, ">")) OR TRY (clearParser__match?(rtoc_self_view, :CHAR, ">>")));
}
END
PUB FN clearParser__consume_generic_close(MUTABLE self: ClearParser) RETURNS !Token
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(clearParser__match?(rtoc_self_view, :CHAR, ">>")) THEN
      RETURN TRY (clearParser__consume(&rtoc_self_view, :CHAR, ">"));
    END
    MUTABLE combined = clearParser__current(rtoc_self_view);
    MUTABLE first: Token = OWN COPY combined;
    MUTABLE second: Token = OWN COPY combined;
    first.value = TokenValue{ StringValue: COPY ">" };
    IF combined.start_offset EXISTS AS combined_start THEN
      first.end_offset = (combined_start + 1);
    END
    first.end_column = (combined.column + 1);
    second.value = TokenValue{ StringValue: COPY ">" };
    second.column = (combined.column + 1);
    IF combined.start_offset EXISTS AS combined_start_second THEN
      second.start_offset = (combined_start_second + 1);
    END
    rtoc_self_view.tokens[rtoc_self_view.pos] = COPY second;
    RETURN first;
}
END
PUB FN clearParser__match_at?(self: ClearParser, n: Int64, type: String@symbol, val: ?String = NIL) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE tok: ?Token = clearParser__peek_at(rtoc_self_view, n);
    IF tok EXISTS AS tok_value THEN
      MUTABLE tok_value_mutable = COPY tok_value;
      IF !((tok_value_mutable.type == type)) THEN
        RETURN FALSE;
      END
      IF val EXISTS AS val_value THEN
        MUTABLE expected_value = COPY val_value;
        RETURN (TRY (token__text_mut(tok_value_mutable)) == expected_value);
      ELSE
        RETURN TRUE;
      END
    ELSE
      RETURN FALSE;
    END
}
END
PUB FN clearParser__multi_pattern_continues?(self: ClearParser) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE nxt: ?Token = clearParser__peek_at(rtoc_self_view, 1);
    IF nxt EXISTS AS nxt_value THEN
      MUTABLE nxt_value_mutable = COPY nxt_value;
      IF ((nxt_value_mutable.type == :ARROW) OR (nxt_value_mutable.type == :EOF)) THEN
        RETURN FALSE;
      END
      IF ((nxt_value_mutable.type == :KEYWORD) AND (["AS", "WHEN", "DEFAULT", "END"]).contains?(TRY (token__text_mut(nxt_value_mutable)))) THEN
        RETURN FALSE;
      END
      IF ((nxt_value_mutable.type == :CHAR) AND (TRY (token__text_mut(nxt_value_mutable)) == "{")) THEN
        RETURN FALSE;
      END
      RETURN TRUE;
    ELSE
      RETURN FALSE;
    END
}
END
PUB FN clearParser__match_mut(MUTABLE self: ClearParser, type: String@symbol, value: ?String = NIL) RETURNS !ClearParserReturnValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF clearParser__match?(rtoc_self_view, type, value) THEN
      MUTABLE matched: Token@multiowned = COPY TRY (clearParser__consume(&rtoc_self_view, type));
      RETURN ClearParserReturnValue{ TokenMultiowned: matched };
    ELSE
      RETURN ClearParserReturnValue{ BoolValue: FALSE };
    END
}
END
PUB FN clearParser__stamp_source_range_mut(self: ClearParser, MUTABLE node: Locatable, first: Token, last: Token) RETURNS Locatable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE start_offset = (first.start_offset OR_ELSE 0);
    MUTABLE end_offset = (last.end_offset OR_ELSE ((start_offset + token__display_value(last).bytes())));
    MATCH node START
      Locatable.Program AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.source_range = SourceRange{ file: ( { MUTABLE rtoc_optional_or_source_3: ?String = first.file; MUTABLE rtoc_optional_or_result_4: ?String = NIL; IF rtoc_optional_or_source_3 != NIL THEN rtoc_optional_or_result_4 = COPY rtoc_optional_or_source_3; ELSE rtoc_optional_or_result_4 = last.file; END rtoc_optional_or_result_4 } ), start_offset: start_offset, end_offset: end_offset, start_line: first.line, start_column: first.column, end_line: (last.end_line OR_ELSE last.line), end_column: (last.end_column OR_ELSE ((last.column + (token__display_value(last)).codepointCount()))) };
        node = Locatable{ Program: item_mutable };,
      Locatable.RequireNode AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.source_range = SourceRange{ file: ( { MUTABLE rtoc_optional_or_source_3: ?String = first.file; MUTABLE rtoc_optional_or_result_4: ?String = NIL; IF rtoc_optional_or_source_3 != NIL THEN rtoc_optional_or_result_4 = COPY rtoc_optional_or_source_3; ELSE rtoc_optional_or_result_4 = last.file; END rtoc_optional_or_result_4 } ), start_offset: start_offset, end_offset: end_offset, start_line: first.line, start_column: first.column, end_line: (last.end_line OR_ELSE last.line), end_column: (last.end_column OR_ELSE ((last.column + (token__display_value(last)).codepointCount()))) };
        node = Locatable{ RequireNode: item_mutable };,
      Locatable.ProtocolRequirement AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.source_range = SourceRange{ file: ( { MUTABLE rtoc_optional_or_source_3: ?String = first.file; MUTABLE rtoc_optional_or_result_4: ?String = NIL; IF rtoc_optional_or_source_3 != NIL THEN rtoc_optional_or_result_4 = COPY rtoc_optional_or_source_3; ELSE rtoc_optional_or_result_4 = last.file; END rtoc_optional_or_result_4 } ), start_offset: start_offset, end_offset: end_offset, start_line: first.line, start_column: first.column, end_line: (last.end_line OR_ELSE last.line), end_column: (last.end_column OR_ELSE ((last.column + (token__display_value(last)).codepointCount()))) };
        node = Locatable{ ProtocolRequirement: item_mutable };,
      Locatable.ProtocolDef AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.source_range = SourceRange{ file: ( { MUTABLE rtoc_optional_or_source_3: ?String = first.file; MUTABLE rtoc_optional_or_result_4: ?String = NIL; IF rtoc_optional_or_source_3 != NIL THEN rtoc_optional_or_result_4 = COPY rtoc_optional_or_source_3; ELSE rtoc_optional_or_result_4 = last.file; END rtoc_optional_or_result_4 } ), start_offset: start_offset, end_offset: end_offset, start_line: first.line, start_column: first.column, end_line: (last.end_line OR_ELSE last.line), end_column: (last.end_column OR_ELSE ((last.column + (token__display_value(last)).codepointCount()))) };
        node = Locatable{ ProtocolDef: item_mutable };,
      Locatable.FunctionDef AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.source_range = SourceRange{ file: ( { MUTABLE rtoc_optional_or_source_3: ?String = first.file; MUTABLE rtoc_optional_or_result_4: ?String = NIL; IF rtoc_optional_or_source_3 != NIL THEN rtoc_optional_or_result_4 = COPY rtoc_optional_or_source_3; ELSE rtoc_optional_or_result_4 = last.file; END rtoc_optional_or_result_4 } ), start_offset: start_offset, end_offset: end_offset, start_line: first.line, start_column: first.column, end_line: (last.end_line OR_ELSE last.line), end_column: (last.end_column OR_ELSE ((last.column + (token__display_value(last)).codepointCount()))) };
        node = Locatable{ FunctionDef: item_mutable };,
      Locatable.ImplementationDef AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.source_range = SourceRange{ file: ( { MUTABLE rtoc_optional_or_source_3: ?String = first.file; MUTABLE rtoc_optional_or_result_4: ?String = NIL; IF rtoc_optional_or_source_3 != NIL THEN rtoc_optional_or_result_4 = COPY rtoc_optional_or_source_3; ELSE rtoc_optional_or_result_4 = last.file; END rtoc_optional_or_result_4 } ), start_offset: start_offset, end_offset: end_offset, start_line: first.line, start_column: first.column, end_line: (last.end_line OR_ELSE last.line), end_column: (last.end_column OR_ELSE ((last.column + (token__display_value(last)).codepointCount()))) };
        node = Locatable{ ImplementationDef: item_mutable };,
      Locatable.ConformanceDef AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.source_range = SourceRange{ file: ( { MUTABLE rtoc_optional_or_source_3: ?String = first.file; MUTABLE rtoc_optional_or_result_4: ?String = NIL; IF rtoc_optional_or_source_3 != NIL THEN rtoc_optional_or_result_4 = COPY rtoc_optional_or_source_3; ELSE rtoc_optional_or_result_4 = last.file; END rtoc_optional_or_result_4 } ), start_offset: start_offset, end_offset: end_offset, start_line: first.line, start_column: first.column, end_line: (last.end_line OR_ELSE last.line), end_column: (last.end_column OR_ELSE ((last.column + (token__display_value(last)).codepointCount()))) };
        node = Locatable{ ConformanceDef: item_mutable };,
