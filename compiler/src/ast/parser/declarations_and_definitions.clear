FN clearParser__parse_when_block(MUTABLE self: ClearParser) RETURNS !WhenBlock
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE tok = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "WHEN"));
    MUTABLE desc = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :STRING)));
    MUTABLE tags = TRY (clearParser__parse_when_tags(&rtoc_self_view));
    clearParser__consume(&rtoc_self_view, :KEYWORD, "DO");
    MUTABLE setup: []Locatable = List[];
    MUTABLE tests: []TestThat = List[];
    MUTABLE benchmarks: []BenchmarkEntry = List[];
    MUTABLE before_each: [][]Locatable = List[];
    MUTABLE after_each: [][]Locatable = List[];
    MUTABLE before_all: [][]Locatable = List[];
    MUTABLE after_all: [][]Locatable = List[];
    MUTABLE lets: []LetBinding = List[];
    WHILE !(clearParser__match?(rtoc_self_view, :KEYWORD, "END")) DO
      IF (clearParser__match?(rtoc_self_view, :KEYWORD, "TEST") AND ((rtoc_self_view.tokens[(rtoc_self_view.pos + 1)] != NIL) AND (token__text_is?(((rtoc_self_view.tokens[(rtoc_self_view.pos + 1)])?), "THAT")))) THEN
        &tests.append(clearParser__parse_test_that(&rtoc_self_view));
      ELSE_IF ((clearParser__match?(rtoc_self_view, :KEYWORD, "PENDING") AND ((rtoc_self_view.tokens[(rtoc_self_view.pos + 1)] != NIL) AND (token__text_is?(((rtoc_self_view.tokens[(rtoc_self_view.pos + 1)])?), "TEST")))) AND ((rtoc_self_view.tokens[(rtoc_self_view.pos + 2)] != NIL) AND (token__text_is?(((rtoc_self_view.tokens[(rtoc_self_view.pos + 2)])?), "THAT")))) THEN
        clearParser__consume(&rtoc_self_view, :KEYWORD, "PENDING");
        MUTABLE tt = TRY (clearParser__parse_test_that(&rtoc_self_view));
        tt.pending = TRUE;
        &tests.append(tt);
      ELSE_IF TRY (clearParser__test_hook_match?(rtoc_self_view, "BEFORE", "EACH")) THEN
        &before_each.append(TRY (clearParser__parse_test_hook(&rtoc_self_view, "BEFORE", "EACH")));
      ELSE_IF TRY (clearParser__test_hook_match?(rtoc_self_view, "AFTER", "EACH")) THEN
        &after_each.append(TRY (clearParser__parse_test_hook(&rtoc_self_view, "AFTER", "EACH")));
      ELSE_IF TRY (clearParser__test_hook_match?(rtoc_self_view, "BEFORE", "ALL")) THEN
        &before_all.append(TRY (clearParser__parse_test_hook(&rtoc_self_view, "BEFORE", "ALL")));
      ELSE_IF TRY (clearParser__test_hook_match?(rtoc_self_view, "AFTER", "ALL")) THEN
        &after_all.append(TRY (clearParser__parse_test_hook(&rtoc_self_view, "AFTER", "ALL")));
      ELSE_IF clearParser__match?(rtoc_self_view, :KEYWORD, "LET") THEN
        &lets.append(clearParser__parse_let_binding(&rtoc_self_view));
      ELSE_IF clearParser__match?(rtoc_self_view, :KEYWORD, "BENCHMARK") THEN
        &benchmarks.append(BenchmarkEntry{ BenchmarkStmt: COPY clearParser__parse_benchmark_stmt(&rtoc_self_view) });
      ELSE_IF clearParser__match?(rtoc_self_view, :KEYWORD, "SMASH") THEN
        &benchmarks.append(BenchmarkEntry{ SmashStmt: COPY TRY (clearParser__parse_smash_stmt(&rtoc_self_view)) });
      ELSE_IF clearParser__match?(rtoc_self_view, :KEYWORD, "PROFILE") THEN
        &benchmarks.append(BenchmarkEntry{ ProfileStmt: COPY TRY (clearParser__parse_profile_stmt(&rtoc_self_view)) });
      ELSE_IF clearParser__match?(rtoc_self_view, :KEYWORD, "STUB") THEN
        &setup.append(Locatable{ StubDecl: COPY TRY (clearParser__parse_stub(&rtoc_self_view)) });
      ELSE
        &setup.append(TRY (clearParser__parse_statement(&rtoc_self_view)));
      END
    END
    clearParser__consume(&rtoc_self_view, :KEYWORD, "END");
    MUTABLE block = WhenBlock{ token: COPY tok, description: COPY desc, setup: setup, tests: tests, benchmarks: benchmarks, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, before_each: NIL, after_each: NIL, before_all: NIL, after_all: NIL, lets: NIL, tags: NIL };
    block.before_each = before_each;
    block.after_each = after_each;
    block.before_all = before_all;
    block.after_all = after_all;
    block.lets = lets;
    block.tags = tags;
    RETURN block;
}
END
FN clearParser__parse_when_tags(MUTABLE self: ClearParser) RETURNS ![]String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "TAGS"))) THEN
      MUTABLE no_tags: []String = List[];
      RETURN no_tags;
    END
    clearParser__consume(&rtoc_self_view, :CHAR, "[");
    MUTABLE names: []String = List[];
    WHILE !(clearParser__match?(rtoc_self_view, :CHAR, "]")) DO
      MUTABLE tag_tok = TRY (clearParser__consume(&rtoc_self_view, :VAR_ID));
      &names.append(TRY (token__text_mut(tag_tok)));
      IF !(castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, ","))) THEN
        BREAK;
      END
    END
    clearParser__consume(&rtoc_self_view, :CHAR, "]");
    RETURN names;
}
END
