->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    clearParser__consume(&rtoc_self_view, :CHAR, "{");
    MUTABLE members: []FunctionDef = List[];
    WHILE !(clearParser__match?(rtoc_self_view, :CHAR, "}")) DO
      MUTABLE member_start = clearParser__current(rtoc_self_view);
      MUTABLE visibility: String@symbol = :package;
      IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "PUB")) THEN
        visibility = :pub;
      ELSE_IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "PRIVATE")) THEN
        visibility = :private;
      END
      MUTABLE member_branch_value: ?FunctionDef = NIL;
