PRIVATE FN clearParser__parse_extern_effects(MUTABLE self: ClearParser) RETURNS !ParsedExternEffects
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE effects = ParsedExternEffects{ alloc: NIL, safe: FALSE };
    IF !(castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "EFFECTS"))) THEN
      RETURN effects;
    END
    WHILE TRUE DO
      clearParser__consume(&rtoc_self_view, :CHAR, ":");
      MUTABLE effect_token = TRY (clearParser__consume(&rtoc_self_view, :VAR_ID));
      MUTABLE effect = symbol((TRY (token__text_mut(effect_token))));
      IF !(([:alloc, :safe]).contains?(effect)) THEN
        clearParser__emit_typo_suggestion_mut(rtoc_self_view, effect_token, TRY (token__text_mut(effect_token)), ["alloc", "safe"], "Unknown effect ':${effect}'", "closest effect", :type, TRUE);
      END
      IF (effect == :safe) THEN
        effects.safe = TRUE;
      ELSE_IF ((effect == :alloc) AND clearParser__match?(rtoc_self_view, :CHAR, ":")) THEN
        clearParser__consume(&rtoc_self_view, :CHAR, ":");
        MUTABLE qualifier_token = TRY (clearParser__consume(&rtoc_self_view, :VAR_ID));
        MUTABLE qualifier = symbol((TRY (token__text_mut(qualifier_token))));
        IF !(([:frame, :heap]).contains?(qualifier)) THEN
          clearParser__emit_typo_suggestion_mut(rtoc_self_view, qualifier_token, TRY (token__text_mut(qualifier_token)), ["frame", "heap"], "Unknown alloc qualifier ':${qualifier}'", "closest alloc qualifier", :type, TRUE);
        END
        effects.alloc = qualifier;
      ELSE
        effects.alloc = :frame;
      END
      IF !(castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, ","))) THEN
        BREAK;
      END
    END
    RETURN effects;
}
END
