EXTERN FN compilerInspectValue() RETURNS String EFFECTS :safe FROM "compiler_regex";
EXTERN STRUCT CompilerRegex {} FROM "compiler_regex";
EXTERN FN compilerRegexCompile(pattern: String) RETURNS CompilerRegex EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexMatch(subject: String, regex: CompilerRegex) RETURNS Bool EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexReplaceAll(subject: String, regex: CompilerRegex, replacement: String) RETURNS String EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexReplaceFirst(subject: String, regex: CompilerRegex, replacement: String) RETURNS String EFFECTS :safe FROM "compiler_regex";
PUB FN regexMatch?(subject: String, pattern: String) RETURNS Bool ->
  RETURN compilerRegexMatch(subject, compilerRegexCompile(pattern));
END

PRIVATE FN clearParser__parse_argument_specs(MUTABLE self: ClearParser) RETURNS ![]Capture
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN COPY (TRY (clearParser__parse_comma_seq(&rtoc_self_view, :CHAR, "(", ")", %(MUTABLE rtoc_view: ClearParser) -> {
    MUTABLE takes = TRY (clearParser__match_mut(&rtoc_view, :KEYWORD, "TAKES"));
    MUTABLE is_mutable = TRY (clearParser__match_mut(&rtoc_view, :KEYWORD, "MUTABLE"));
    MUTABLE is_comptime = FALSE;
    rtoc_cur_0 = clearParser__current(rtoc_view);
    IF (clearParser__match?(rtoc_view, :VAR_ID) AND (token__text_is?(rtoc_cur_0, "comptime"))) THEN
        IF (((clearParser__peek_at(rtoc_view, 1) != NIL) AND (((clearParser__peek_at(rtoc_view, 1))?).type == :CHAR)) AND ((clearParser__peek_at(rtoc_view, 1) != NIL) AND (token__text_is?(((clearParser__peek_at(rtoc_view, 1))?), ":")))) THEN
          clearParser__consume(&rtoc_view, :VAR_ID);
          is_comptime = TRUE;
        END
    END
    MUTABLE name_tok: ?Token = NIL;
    IF !(is_comptime) THEN
      name_tok = TRY (clearParser__consume(&rtoc_view, :VAR_ID));
    END
    MUTABLE p_name: ?String = NIL;
    IF name_tok EXISTS AS name_token THEN
      p_name = TRY (token__text_mut(name_token));
    END
    MUTABLE p_type: ?Type = NIL;
    MUTABLE default_val: ?Locatable = NIL;
    MUTABLE carrier_contract: String@symbol = :polymorphic;
    IF is_comptime THEN
        clearParser__consume(&rtoc_view, :CHAR, ":");
        p_type = TRY (type__new(TypeConstructionInput{ SymbolValue: symbol((TRY (token__text_mut(clearParser__consume(&rtoc_view, :TYPE_ID))))) }));
        p_name = "comptime";
    ELSE
        IF castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_view, :CHAR, ":"))) THEN
          carrier_contract = TRY (clearParser__parse_carrier_contract(&rtoc_view));
          p_type = TRY (clearParser__parse_type_annotation(&rtoc_view));
          IF p_type EXISTS AS annotated_type THEN
            IF ((carrier_contract == :polymorphic) AND type__polymorphic_shared?(annotated_type)) THEN
              carrier_contract = :shared;
            END
          END
          IF castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_view, :CHAR, "="))) THEN
            default_val = TRY (clearParser__parse_expression(&rtoc_view));
          END
        ELSE_IF castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_view, :CHAR, "="))) THEN
          default_val = TRY (clearParser__parse_expression(&rtoc_view));
          IF castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_view, :CHAR, ":"))) THEN
            p_type = TRY (clearParser__parse_type_annotation(&rtoc_view));
          END
        ELSE_IF rtoc_view.gradual THEN
          p_type = (TRY (type__new(TypeConstructionInput{ SymbolValue: symbol("Auto") }, NIL, NIL, NIL, NIL, NIL, NIL, NIL, NIL, NIL, TRUE)));
        END
    END
    Capture{ name: UNWRAP (COPY p_name), type: COPY (p_type OR_ELSE TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }))), default: COPY default_val, mutable: castClearParserReturnValueToBool(is_mutable), takes: castClearParserReturnValueToBool(takes), comptime: is_comptime, name_token: COPY name_tok, carrier_contract: carrier_contract, storage: NIL }
    })))._1;
}
END
PRIVATE FN clearParser__parse_carrier_contract(MUTABLE self: ClearParser) RETURNS !String@symbol
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :KEYWORD, "UNIQUE"))) THEN
      RETURN :unique;
    END
    IF castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :KEYWORD, "MONOMORPHIC"))) THEN
      RETURN :monomorphic;
    END
    RETURN :polymorphic;
}
END
PUB FN clearParser__parse_argument_list(MUTABLE self: ClearParser) RETURNS ![]Param
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN (TRY (clearParser__parse_argument_specs(&rtoc_self_view))) |> SELECT Param{ name: COPY _.name, type: COPY _.type, default: COPY _.default, mutable: _.mutable, takes: _.takes, comptime: _.comptime, name_token: COPY _.name_token, carrier_contract: _.carrier_contract, required: NIL, sync: NIL, symbol: NIL };
}
END
PUB FN clearParser__parse_capture_list(MUTABLE self: ClearParser) RETURNS ![]Capture
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN TRY (clearParser__parse_argument_specs(&rtoc_self_view));
}
END
PRIVATE FN clearParser__parse_mutable_var_decl(MUTABLE self: ClearParser) RETURNS !ClearParserReturnValue
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE start_token = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "MUTABLE"));
    IF clearParser__destructuring_assignment?(rtoc_self_view) THEN
      RETURN TRY (clearParser__parse_destructuring_assign(&rtoc_self_view, TRUE));
    END
    MUTABLE name = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :VAR_ID)));
    MUTABLE type_annotation: ?Type = NIL;
    IF castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :CHAR, ":"))) THEN
      type_annotation = (clearParser__parse_inferred_wrapper_annotation(&rtoc_self_view) OR_ELSE TRY (clearParser__parse_type_annotation(&rtoc_self_view)));
    END
    IF castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :CHAR, "="))) THEN
      MUTABLE value = TRY (clearParser__parse_expression(&rtoc_self_view));
      clearParser__consume(&rtoc_self_view, :CHAR, ";");
      RETURN ClearParserReturnValue{ VarDecl: COPY VarDecl{ token: COPY start_token, name: COPY name, type: COPY type_annotation, value: value, mutable: TRUE, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, mir_binding_entry: NIL, ownership_transport_plan: NIL, const_visibility: NIL, module_const: NIL } };
    END
    clearParser__consume(&rtoc_self_view, :CHAR, ";");
    IF type_annotation EXISTS AS type_annotation_value THEN
      MUTABLE value = Locatable{ DefaultArrayLit: COPY TRY (clearParser__synthesize_default_for_type(rtoc_self_view, start_token, type_annotation_value)) };
      RETURN ClearParserReturnValue{ VarDecl: COPY VarDecl{ token: COPY start_token, name: COPY name, type: COPY type_annotation_value, value: value, mutable: TRUE, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, mir_binding_entry: NIL, ownership_transport_plan: NIL, const_visibility: NIL, module_const: NIL } };
    END
    TRY (clearParser__error_mut(rtoc_self_view, start_token, CodeOrMessage{ SymbolValue: :MUTABLE_BARE_NEEDS_TYPE }));
    panic("clearParser__error_mut raises");
}
END
PRIVATE FN clearParser__parse_const_decl(MUTABLE self: ClearParser, visibility: String@symbol = :package) RETURNS !VarDecl
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE start_token = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "CONST"));
    MUTABLE name_tok = TRY (clearParser__consume(&rtoc_self_view, :TYPE_ID));
    IF !(clearParser__match?(rtoc_self_view, :TYPE_ID)) THEN
      name_tok = TRY (clearParser__consume(&rtoc_self_view, :VAR_ID));
    END
    MUTABLE name = TRY (token__text_mut(name_tok));
    IF !(regexMatch?(name, "\\A[A-Z][A-Z0-9_]*\\z")) THEN
      clearParser__error_mut(rtoc_self_view, name_tok, CodeOrMessage{ SymbolValue: :CONST_NEEDS_CAPS }, [], {:name: "${COPY name}"});
    END
    IF !(castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :CHAR, ":")))) THEN
      clearParser__error_mut(rtoc_self_view, start_token, CodeOrMessage{ SymbolValue: :CONST_NEEDS_TYPE }, [], {:name: "${COPY name}"});
    END
    MUTABLE type_annotation = (clearParser__parse_inferred_wrapper_annotation(&rtoc_self_view) OR_ELSE TRY (clearParser__parse_type_annotation(&rtoc_self_view)));
    IF !(castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :CHAR, "=")))) THEN
      clearParser__error_mut(rtoc_self_view, start_token, CodeOrMessage{ SymbolValue: :CONST_NEEDS_VALUE }, [], {:name: "${COPY name}"});
    END
    MUTABLE value = TRY (clearParser__parse_expression(&rtoc_self_view));
    clearParser__consume(&rtoc_self_view, :CHAR, ";");
    MUTABLE decl = VarDecl{ token: COPY start_token, name: COPY name, type: COPY type_annotation, value: value, mutable: FALSE, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, mir_binding_entry: NIL, ownership_transport_plan: NIL, const_visibility: NIL, module_const: NIL };
    decl.module_const = TRUE;
    decl.const_visibility = COPY visibility;
    RETURN decl;
}
END
PRIVATE FN clearParser__synthesize_default_for_type(self: ClearParser, tok: Token, type: Type) RETURNS !DefaultArrayLit
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(type__fixed?(type)) THEN
      clearParser__error_mut(rtoc_self_view, tok, CodeOrMessage{ SymbolValue: :MUTABLE_BARE_NEEDS_FIXED }, [], {:type: "${type__resolved(type)}"});
    END
    MUTABLE elem: ?Type = TRY (type__element_type(type));
    MUTABLE elem_value: Type = elem?;
    MUTABLE elem_resolved = type__resolved(elem_value);
    IF !(([:Int64, :Int32, :Int16, :Int8, :Float64, :Float32, :String, :Bool, :Boolean]).contains?(elem_resolved)) THEN
      clearParser__error_mut(rtoc_self_view, tok, CodeOrMessage{ SymbolValue: :MUTABLE_BARE_BAD_ELEMENT }, [], {:type: "${compilerInspectValue()}"});
    END
    RETURN DefaultArrayLit{ token: COPY tok, type_info: COPY TRY (type__new(TypeConstructionInput{ Type: COPY type })), storage: :stack, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
}
END
PRIVATE FN clearParser__parse_require(MUTABLE self: ClearParser) RETURNS !RequireNode
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE path: String = "";
    MUTABLE tok = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "REQUIRE"));
    MUTABLE raw = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :STRING)));
    MUTABLE namespace: String = "";
    MUTABLE kind: String@symbol = :local;
    IF raw.startsWith?("pkg:") THEN
      MUTABLE pkg_name = regexReplaceFirst(raw, "\\Apkg:", "");
      path = COPY pkg_name;
      namespace = regexReplaceFirst(regexReplaceAll(pkg_name, "[^a-zA-Z0-9_]", "_"), "\\A(\\d)", "_\\1");
      kind = :package;
    ELSE
      path = raw;
      namespace = regexReplaceFirst((regexReplaceAll(basename(path, ".clear"), "[^a-zA-Z0-9_]", "_")), "\\A(\\d)", "_\\1");
      kind = :local;
    END
    IF castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :KEYWORD, "AS"))) THEN
      namespace = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :VAR_ID)));
    END
    clearParser__match_mut(&rtoc_self_view, :CHAR, ";");
    RETURN RequireNode{ token: COPY tok, path: path, namespace: namespace, kind: COPY kind, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
}
END
PRIVATE FN clearParser__parse_visibility_decl(MUTABLE self: ClearParser, visibility: String@symbol) RETURNS !Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    clearParser__consume(&rtoc_self_view, :KEYWORD);
    IF clearParser__match?(rtoc_self_view, :KEYWORD, "FN") THEN
      RETURN Locatable{ FunctionDef: COPY TRY (clearParser__parse_function_def(&rtoc_self_view, visibility)) };
    ELSE_IF clearParser__match?(rtoc_self_view, :KEYWORD, "METHOD") THEN
      RETURN Locatable{ FunctionDef: COPY TRY (clearParser__parse_function_def(&rtoc_self_view, visibility, TRUE)) };
    ELSE_IF clearParser__match?(rtoc_self_view, :KEYWORD, "STRUCT") THEN
      RETURN Locatable{ StructDef: COPY TRY (clearParser__parse_struct_def(&rtoc_self_view, visibility)) };
    ELSE_IF clearParser__match?(rtoc_self_view, :KEYWORD, "PROTOCOL") THEN
      RETURN Locatable{ ProtocolDef: COPY TRY (clearParser__parse_protocol_def(&rtoc_self_view, visibility)) };
    ELSE_IF clearParser__match?(rtoc_self_view, :KEYWORD, "ENUM") THEN
      RETURN Locatable{ EnumDef: COPY clearParser__parse_enum_def(&rtoc_self_view, visibility) };
    ELSE_IF clearParser__match?(rtoc_self_view, :KEYWORD, "UNION") THEN
      RETURN Locatable{ UnionDef: COPY TRY (clearParser__parse_union_def(&rtoc_self_view, visibility)) };
    ELSE_IF clearParser__match?(rtoc_self_view, :KEYWORD, "CONST") THEN
      RETURN Locatable{ VarDecl: COPY clearParser__parse_const_decl(&rtoc_self_view, visibility) };
    ELSE
      TRY (clearParser__error_mut(rtoc_self_view, clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :VISIBILITY_BAD_KIND }, [], {:got: "${token__display_value(clearParser__current(rtoc_self_view))}"}));
      panic("clearParser__error_mut raises");
    END
}
END
