    ELSE_IF clearParser__match?(rtoc_self_view, :KEYWORD, "STRUCT") THEN
      RETURN ClearParserReturnValue{ ExternStructDecl: COPY TRY (clearParser__parse_extern_struct(&rtoc_self_view, tok)) };
    ELSE
