      END
    END
    IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "HEADER")) THEN
      header = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :STRING)));
    END
    RETURN ExternSource{ dependency: COPY dependency, abi: COPY abi, symbol: COPY native_name, callconv: COPY callconv, header: COPY header };
