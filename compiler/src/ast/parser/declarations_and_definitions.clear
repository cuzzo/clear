FN clearParser__parse_test_block(MUTABLE self: ClearParser) RETURNS !TestBlock
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE tok = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "TEST"));
    MUTABLE name = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :TYPE_ID)));
    clearParser__consume(&rtoc_self_view, :KEYWORD, "DO");
    MUTABLE setup: []Locatable = List[];
    MUTABLE whens: []WhenBlock = List[];
    MUTABLE before_each: [][]Locatable = List[];
    MUTABLE after_each: [][]Locatable = List[];
    MUTABLE before_all: [][]Locatable = List[];
    MUTABLE after_all: [][]Locatable = List[];
    MUTABLE lets: []LetBinding = List[];
    WHILE !(clearParser__match?(rtoc_self_view, :KEYWORD, "END")) DO
      IF clearParser__match?(rtoc_self_view, :KEYWORD, "WHEN") THEN
        &whens.append(TRY (clearParser__parse_when_block(&rtoc_self_view)));
      ELSE_IF TRY (clearParser__test_hook_match?(rtoc_self_view, "BEFORE", "EACH")) THEN
        &before_each.append(TRY (clearParser__parse_test_hook(&rtoc_self_view, "BEFORE", "EACH")));
      ELSE_IF TRY (clearParser__test_hook_match?(rtoc_self_view, "AFTER", "EACH")) THEN
        &after_each.append(TRY (clearParser__parse_test_hook(&rtoc_self_view, "AFTER", "EACH")));
      ELSE_IF TRY (clearParser__test_hook_match?(rtoc_self_view, "BEFORE", "ALL")) THEN
        &before_all.append(TRY (clearParser__parse_test_hook(&rtoc_self_view, "BEFORE", "ALL")));
      ELSE_IF TRY (clearParser__test_hook_match?(rtoc_self_view, "AFTER", "ALL")) THEN
        &after_all.append(TRY (clearParser__parse_test_hook(&rtoc_self_view, "AFTER", "ALL")));
      ELSE_IF clearParser__match?(rtoc_self_view, :KEYWORD, "LET") THEN
        &lets.append(clearParser__parse_let_binding(&rtoc_self_view));
      ELSE
        &setup.append(TRY (clearParser__parse_statement(&rtoc_self_view)));
      END
    END
    clearParser__consume(&rtoc_self_view, :KEYWORD, "END");
    MUTABLE block = TestBlock{ token: COPY tok, name: COPY name, setup: setup, whens: whens, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, before_each: NIL, after_each: NIL, before_all: NIL, after_all: NIL, lets: NIL };
    block.before_each = before_each;
    block.after_each = after_each;
    block.before_all = before_all;
    block.after_all = after_all;
    block.lets = lets;
    RETURN block;
}
END
FN clearParser__parse_let_binding(MUTABLE self: ClearParser) RETURNS !LetBinding
