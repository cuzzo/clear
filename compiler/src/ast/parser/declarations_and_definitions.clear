          MUTABLE no_deinit_entries: []InlineStructDeinitEntry = List[];
          variants[var_name] = SchemasUnionSchemaVariantInput{ InlineStructVariantMultiowned: TRY (inlineStructVariant__new(ruby_pairs_to_hash_String_TypeTypeInput(field_pairs), no_deinit_entries)) };
        ELSE_IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, ":")) THEN
          MUTABLE vtype = TRY (clearParser__parse_type_annotation(&rtoc_self_view));
          TRY (clearParser__reject_auto_in_aggregate_field_mut(rtoc_self_view, vtype, var_name, NIL, "UNION variant payload"));
          variants[var_name] = SchemasUnionSchemaVariantInput{ Type: COPY vtype };
        ELSE
          variants[var_name] = NIL;
        END
      END
      clearParser__match_mut(&rtoc_self_view, :CHAR, ",");
    END
    clearParser__consume(&rtoc_self_view, :CHAR, "}");
    MUTABLE node = UnionDef{ token: COPY tok, name: COPY name, variants: COPY variants, visibility: COPY visibility, type_params: COPY generic_params |> SELECT _.name, methods: COPY method_reqs, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, generic_params: List[] };
    node.generic_params = generic_params;
    RETURN node;
}
END
PRIVATE FN clearParser__source_slice_between(self: ClearParser, start_tok: Token, end_tok: Token) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(((TRUE AND TRUE) AND TRUE)) THEN
      RETURN "";
    END
    MUTABLE lines = rtoc_self_view.source_code.split("\n");
    MUTABLE sl, sc = [start_tok.line, start_tok.column];
    MUTABLE el, ec = [end_tok.line, end_tok.column];
    IF ((sl < 1) OR (sl > lines.length())) THEN
      RETURN "";
    END
    IF (sl == el) THEN
      RETURN ((UNWRAP (lines[(sl - 1)])).substr((sc - 1), (ec - sc))).trim();
    ELSE
      MUTABLE parts: []String = List[];
      &parts.append(COPY (UNWRAP (lines[(sl - 1)])).substr((sc - 1), ((UNWRAP (lines[(sl - 1)])).length() - (sc - 1))));
      FOR _ IN (((sl + 1)) ..= ((el - 1))) DO
      &parts.append(COPY UNWRAP (lines[(_ - 1)]));
      END
      &parts.append(((UNWRAP (lines[(el - 1)])).substr(0, (ec - 1))));
      RETURN parts.join("").trim();
    END
}
END
PRIVATE FN clearParser__parse_function_def(MUTABLE self: ClearParser, visibility: String@symbol = :package, is_method_input: Bool = FALSE) RETURNS !FunctionDef
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE is_method = COPY is_method_input;
    MUTABLE fn_token_branch_value: ?Token = NIL;
    IF is_method THEN
      fn_token_branch_value = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "METHOD"));
    ELSE_IF clearParser__match?(rtoc_self_view, :KEYWORD, "METHOD") THEN
      is_method = TRUE;
      fn_token_branch_value = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "METHOD"));
    ELSE
      fn_token_branch_value = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "FN"));
    END
    MUTABLE fn_token: Token = fn_token_branch_value?;
    MUTABLE name_tok = TRY (clearParser__consume(&rtoc_self_view, :VAR_ID));
    MUTABLE name = TRY (token__text_mut(name_tok));
    IF clearParser__match?(rtoc_self_view, :CHAR, "?") THEN
      clearParser__consume(&rtoc_self_view, :CHAR, "?");
      name = "${name}?";
    END
    MUTABLE generic_params = TRY (clearParser__parse_generic_type_params(&rtoc_self_view));
    MUTABLE type_params = generic_params |> SELECT _.name;
    MUTABLE params = TRY (clearParser__parse_argument_list(&rtoc_self_view));
    MUTABLE captures: []Capture = List[];
    IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "USE")) THEN
      captures = TRY (clearParser__parse_capture_list(&rtoc_self_view));
    END
    MUTABLE return_type: ?Type = NIL;
    MUTABLE return_type_token: ?Token = NIL;
    MUTABLE return_lifetime_token: ?Token = NIL;
    MUTABLE return_lifetime: ?ClearParserReturnLifetime = NIL;
    MUTABLE explicit_return = TRY (clearParser__match?(rtoc_self_view, :KEYWORD, "RETURNS"));
    IF (!(explicit_return) AND rtoc_self_view.gradual) THEN
      return_type = TRY (type__new(TypeConstructionInput{ SymbolValue: symbol("Auto") }, NIL, NIL, NIL, NIL, NIL, NIL, NIL, NIL, NIL, TRUE));
      explicit_return = TRUE;
    END
    IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "RETURNS")) THEN
      MUTABLE shared_return = TRY (clearParser__match_mut(&rtoc_self_view, :KEYWORD, "SHARED"));
      IF clearParser__match?(rtoc_self_view, :CHAR, "(") THEN
        return_lifetime_token = TRY (clearParser__consume(&rtoc_self_view, :CHAR, "("));
        MUTABLE names: []Locatable = List[];
        WHILE !(clearParser__match?(rtoc_self_view, :CHAR, ")")) DO
          &names.append(clearParser__parse_var_id(&rtoc_self_view));
          clearParser__match_mut(&rtoc_self_view, :CHAR, ",");
        END
        clearParser__consume(&rtoc_self_view, :CHAR, ")");
        clearParser__consume(&rtoc_self_view, :CHAR, ":");
        return_lifetime = ClearParserReturnLifetime{ ArrayValue: COPY names };
      ELSE_IF clearParser__match?(rtoc_self_view, :CHAR, "*") THEN
        return_lifetime_token = TRY (clearParser__consume(&rtoc_self_view, :CHAR, "*"));
        clearParser__consume(&rtoc_self_view, :CHAR, ":");
        return_lifetime = ClearParserReturnLifetime{ SymbolValue: :wildcard };
      ELSE_IF (clearParser__current(rtoc_self_view).type == :VAR_ID) THEN
        return_lifetime_token = clearParser__current(rtoc_self_view);
        MUTABLE names: []Locatable = [clearParser__parse_var_id(&rtoc_self_view)];
        return_lifetime = ClearParserReturnLifetime{ ArrayValue: COPY names };
        clearParser__consume(&rtoc_self_view, :CHAR, ":");
      END
      return_type_token = clearParser__current(rtoc_self_view);
      return_type = TRY (clearParser__parse_type_annotation(&rtoc_self_view));
      IF castClearParserReturnValueToBool(shared_return) THEN
        return_type = TRY (clearParser__mark_polymorphic_shared_type(rtoc_self_view, UNWRAP (COPY return_type)));
      END
    END
    MUTABLE requires_clause: ?{String}[Set]String@symbol = NIL;
    MUTABLE early_requires_clauses: {String}String@symbol = {};
    IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "REQUIRES")) THEN
      MUTABLE parsed_requires = TRY (clearParser__parse_requires_clause(&rtoc_self_view));
      requires_clause = COPY parsed_requires.capabilities;
      early_requires_clauses = COPY parsed_requires.reentrance;
    END
    MUTABLE parsed_effects = TRY (clearParser__parse_effects_decl(&rtoc_self_view));
    MUTABLE effects_decl: ?String@symbol = COPY parsed_effects.kind;
    MUTABLE effects_span: ?EffectSpan = COPY parsed_effects.span;
    MUTABLE requires_clauses = TRY (clearParser__parse_requires_clauses(&rtoc_self_view, name));
    IF !((early_requires_clauses.length() == 0)) THEN
      early_requires_clauses.keys() |> EACH {
    MUTABLE v: String@symbol = (early_requires_clauses[_] OR_ELSE panic("missing hash key"));
    IF requires_clauses.contains?(_) THEN
          clearParser__error_mut(rtoc_self_view, fn_token, CodeOrMessage{ SymbolValue: :DUPLICATE_REQUIRES_CLAUSE }, [], {:fn: "${name}", :name: "${_}"});
    END
    requires_clauses[_] = COPY v;
      };
    END
    MUTABLE pre_clauses: []{String@symbol}ContractClauseValue = List[];
    WHILE castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "PRE")) DO
      clearParser__consume(&rtoc_self_view, :CHAR, ":");
      MUTABLE start_tok = clearParser__current(rtoc_self_view);
      MUTABLE expr = TRY (clearParser__parse_expression(&rtoc_self_view));
      MUTABLE end_tok = clearParser__current(rtoc_self_view);
      &pre_clauses.append({:expr: ContractClauseValue{ Locatable: COPY expr }, :source: ContractClauseValue{ StringValue: COPY clearParser__source_slice_between(rtoc_self_view, start_tok, end_tok) }});
    END
    MUTABLE post_clauses: []{String@symbol}ContractClauseValue = List[];
    WHILE castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "DEBUG_POST")) DO
      clearParser__consume(&rtoc_self_view, :CHAR, ":");
      start_tok = clearParser__current(rtoc_self_view);
      expr = TRY (clearParser__parse_expression(&rtoc_self_view));
      end_tok = clearParser__current(rtoc_self_view);
      &post_clauses.append({:expr: ContractClauseValue{ Locatable: COPY expr }, :source: ContractClauseValue{ StringValue: COPY clearParser__source_slice_between(rtoc_self_view, start_tok, end_tok) }});
    END
    MUTABLE arrow_token = clearParser__current(rtoc_self_view);
    clearParser__consume(&rtoc_self_view, :ARROW, "->");
    MUTABLE body = TRY (clearParser__parse_block_body(&rtoc_self_view, ["END", "CATCH"]));
    MUTABLE catch_clauses: []CatchClause = List[];
    MUTABLE default_body: ?[]Locatable = NIL;
    IF clearParser__match?(rtoc_self_view, :KEYWORD, "CATCH") THEN
      WHILE clearParser__match?(rtoc_self_view, :KEYWORD, "CATCH") DO
        clearParser__consume(&rtoc_self_view, :KEYWORD, "CATCH");
        MUTABLE items: []CatchItem = List[];
        &items.append(TRY (clearParser__parse_catch_item(&rtoc_self_view)));
        WHILE castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, ",")) DO
          &items.append(TRY (clearParser__parse_catch_item(&rtoc_self_view)));
        END
        MUTABLE filters: []CatchFilter = List[];
        IF clearParser__match?(rtoc_self_view, :KEYWORD, "WITH") THEN
          clearParser__consume(&rtoc_self_view, :KEYWORD, "WITH");
          clearParser__consume(&rtoc_self_view, :CHAR, "(");
          &filters.append(TRY (clearParser__parse_catch_filter(&rtoc_self_view)));
          WHILE castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, ",")) DO
            &filters.append(TRY (clearParser__parse_catch_filter(&rtoc_self_view)));
          END
          clearParser__consume(&rtoc_self_view, :CHAR, ")");
        END
        MUTABLE clause_body = TRY (clearParser__parse_block_body(&rtoc_self_view, ["CATCH", "DEFAULT", "END"]));
        &catch_clauses.append(CatchClause{ items: COPY items, filters: COPY filters, body: COPY clause_body, kinds: List[], types: List[], filter_types: List[], filter_messages: List[] });
      END
      IF clearParser__match?(rtoc_self_view, :KEYWORD, "DEFAULT") THEN
        clearParser__consume(&rtoc_self_view, :KEYWORD, "DEFAULT");
        default_body = TRY (clearParser__parse_block_body(&rtoc_self_view, ["END"]));
      END
    END
    clearParser__consume(&rtoc_self_view, :KEYWORD, "END");
    MUTABLE max_depth_n: ?Int64 = parsed_effects.max_depth;
    MUTABLE tight_reentrance = parsed_effects.tight;
    MUTABLE stored_requires_clauses_branch_value: ?{String}String@symbol = NIL;
    IF (requires_clauses.length() == 0) THEN
      stored_requires_clauses_branch_value = NIL;
    ELSE
      stored_requires_clauses_branch_value = requires_clauses;
    END
    MUTABLE stored_requires_clauses: ?{String}String@symbol = stored_requires_clauses_branch_value;
    MUTABLE stored_pre_clauses_branch_value: ?[]{String@symbol}ContractClauseValue = NIL;
    IF (pre_clauses.length() == 0) THEN
      stored_pre_clauses_branch_value = NIL;
    ELSE
      stored_pre_clauses_branch_value = pre_clauses;
    END
    MUTABLE stored_pre_clauses: ?[]{String@symbol}ContractClauseValue = stored_pre_clauses_branch_value;
    MUTABLE stored_post_clauses_branch_value: ?[]{String@symbol}ContractClauseValue = NIL;
    IF (post_clauses.length() == 0) THEN
      stored_post_clauses_branch_value = NIL;
    ELSE
      stored_post_clauses_branch_value = post_clauses;
    END
    MUTABLE stored_post_clauses: ?[]{String@symbol}ContractClauseValue = stored_post_clauses_branch_value;
    MUTABLE node = FunctionDef{ token: COPY fn_token, name: COPY name, params: COPY params, captures: captures, return_type: COPY return_type, return_lifetime: return_lifetime, body: COPY body, catch_clauses: catch_clauses, default_catch: default_body, visibility: COPY visibility, deferred_drops: NIL, uses_frame: NIL, explicit_return_type: explicit_return, type_params: COPY type_params, tail_call: (effects_decl == :reentrant_tail_call), requires: requires_clause, arrow_token: COPY arrow_token, name_token: COPY name_tok, effects_decl: effects_decl, effects_span: effects_span, max_depth_n: max_depth_n, tight_reentrance: tight_reentrance, requires_clauses: stored_requires_clauses, return_type_token: COPY return_type_token, pre_clauses: stored_pre_clauses, post_clauses: stored_post_clauses, is_method: COPY is_method, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, effect_set: NIL, inferred_effects: NIL, reentrance_kind: NIL, thunk_plan: NIL, mutual_thunk_plan: NIL, needs_rt: NIL, fn_value_ref: NIL, alloc_fault: NIL, error_fallible: NIL, uses_heap: NIL, uses_alloc: NIL, uses_rt: NIL, effects: NIL, snapshot_types: NIL, stack_tier: NIL, stack_vars_bytes: NIL, moved_guard_info: NIL, cleanup_bindings: NIL, heap_carry_return: NIL, heap_carry_return_vars: NIL, fsm_eligible: NIL, fsm_ineligible_reason: NIL, fsm_suspend_points: NIL, conformance_protocol: NIL, generic_params: List[], implementation_owner: NIL, semantic_with_blocks: List[], source_name: "" };
    node.generic_params = generic_params;
    RETURN node;
}
END
PRIVATE FN clearParser__parse_requires_clause(MUTABLE self: ClearParser) RETURNS !ParsedRequiresClause
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE requires_hash: {String}[Set]String@symbol = {};
    MUTABLE requires_reentrance: {String}String@symbol = {};
    WHILE TRUE DO
      MUTABLE names: []String = [TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :VAR_ID)))];
      WHILE castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, ",")) DO
        &names.append(TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :VAR_ID))));
      END
      clearParser__consume(&rtoc_self_view, :CHAR, ":");
      MUTABLE families: [Set]String@symbol = Set[];
      MUTABLE reentrance_kinds: []String@symbol = List[];
      MUTABLE first = TRY (clearParser__parse_requires_family_or_reentrance(&rtoc_self_view));
      MUTABLE family: ?String@symbol = COPY first.family;
      MUTABLE reentrance: ?String@symbol = COPY first.reentrance;
      IF family EXISTS AS family_value THEN
        &families.insert(family_value);
      END
      IF reentrance EXISTS AS reentrance_value THEN
        &reentrance_kinds.append(reentrance_value);
      END
      WHILE castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, "|")) DO
        MUTABLE nxt = TRY (clearParser__parse_requires_family_or_reentrance(&rtoc_self_view));
        family = COPY nxt.family;
        reentrance = COPY nxt.reentrance;
        IF family EXISTS AS family_value THEN
          &families.insert(family_value);
        END
        IF reentrance EXISTS AS reentrance_value THEN
          &reentrance_kinds.append(reentrance_value);
        END
      END
      FOR _ IN names DO
    IF !(families.empty?()) THEN
          requires_hash[_] = COPY families;
    END
    FOR kind IN reentrance_kinds DO
    requires_reentrance[kind] = COPY kind;
    END
      END
      IF !(castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, ","))) THEN
        BREAK;
      END
    END
    RETURN ParsedRequiresClause{ capabilities: COPY requires_hash, reentrance: COPY requires_reentrance };
}
END
PRIVATE FN clearParser__parse_requires_family_or_reentrance(MUTABLE self: ClearParser) RETURNS !RequiresKind
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE tok = TRY (clearParser__consume(&rtoc_self_view, :TYPE_ID));
    MUTABLE token_value = TRY (token__text_mut(tok));
    MUTABLE result_branch_value: ?RequiresKind = NIL;
    IF ((["LOCKED", "SNAPSHOTTED", "VERSIONED", "ATOMIC", "LOCAL", "ACTOR", "LOCK_FREE"]) |> DISTINCT _).contains?(token_value) THEN
      result_branch_value = RequiresKind{ family: COPY symbol(token_value), reentrance: NIL };
    ELSE_IF ((["NON_REENTRANT"]) |> DISTINCT _).contains?(token_value) THEN
      result_branch_value = RequiresKind{ reentrance: :non_reentrant, family: NIL };
    ELSE
      MUTABLE candidates: []String = List[];
      ["LOCKED", "SNAPSHOTTED", "VERSIONED", "ATOMIC", "LOCAL", "ACTOR", "LOCK_FREE"] |> EACH { &candidates.append(COPY _); };
      &candidates.append(COPY "NON_REENTRANT");
      TRY (clearParser__emit_typo_suggestion_mut(rtoc_self_view, tok, token_value, candidates, "Unknown REQUIRES family '${token_value}' (valid: ${(((["LOCKED", "SNAPSHOTTED", "VERSIONED", "ATOMIC", "LOCAL", "ACTOR", "LOCK_FREE"]) |> DISTINCT _) |> SELECT COPY _).join(", ")}; kinds: ${(((["NON_REENTRANT"]) |> DISTINCT _) |> SELECT COPY _).join(", ")})", "closest REQUIRES family/kind", :type, TRUE));
    END
    MUTABLE result: RequiresKind = result_branch_value?;
    RETURN result;
}
END
PUB FN clearParser__parse_requires_family(MUTABLE self: ClearParser) RETURNS !String@symbol
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE res = TRY (clearParser__parse_requires_family_or_reentrance(&rtoc_self_view));
    MUTABLE family: ?String@symbol = COPY res.family;
    IF (family == NIL) THEN
      clearParser__error_mut(rtoc_self_view, clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :EXPECTED_CAP_FAMILY });
    END
    RETURN symbol(UNWRAP (family));
}
END
PRIVATE FN clearParser__parse_requires_clauses(MUTABLE self: ClearParser, fn_name: String) RETURNS !{String}String@symbol
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE out: {String}String@symbol = {};
    WHILE clearParser__match?(rtoc_self_view, :KEYWORD, "REQUIRES") DO
      clearParser__consume(&rtoc_self_view, :KEYWORD, "REQUIRES");
      MUTABLE name_tok = TRY (clearParser__consume(&rtoc_self_view, :VAR_ID));
      MUTABLE name = TRY (token__text_mut(name_tok));
      clearParser__consume(&rtoc_self_view, :CHAR, ":");
      MUTABLE kind_tok = TRY (clearParser__consume(&rtoc_self_view, :TYPE_ID));
      MUTABLE kind_value = TRY (token__text_mut(kind_tok));
      IF !((kind_value == "NON_REENTRANT")) THEN
        clearParser__emit_typo_suggestion_mut(rtoc_self_view, kind_tok, kind_value, ["NON_REENTRANT"], "Unknown REQUIRES kind '${kind_value}'", "closest REQUIRES kind", :type, TRUE);
      END
      MUTABLE kind = :non_reentrant;
      IF out.contains?(name) THEN
        clearParser__error_mut(rtoc_self_view, name_tok, CodeOrMessage{ SymbolValue: :DUPLICATE_REQUIRES_CLAUSE }, [], {:fn: "${fn_name}", :name: "${COPY name}"});
      END
      out[name] = kind;
    END
    RETURN out;
}
END
PRIVATE FN clearParser__parse_effects_decl(MUTABLE self: ClearParser) RETURNS !ParsedEffectsDecl
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(clearParser__match?(rtoc_self_view, :KEYWORD, "EFFECTS")) THEN
      RETURN ParsedEffectsDecl{ kind: NIL, span: NIL, max_depth: NIL, tight: FALSE };
    END
    MUTABLE eff_kw = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "EFFECTS"));
    MUTABLE eff_tok = TRY (clearParser__consume(&rtoc_self_view, :TYPE_ID));
    MUTABLE effect_value = TRY (token__text_mut(eff_tok));
    IF !((effect_value == "REENTRANT")) THEN
      clearParser__emit_typo_suggestion_mut(rtoc_self_view, eff_tok, effect_value, ["REENTRANT"], "Unknown function effect '${effect_value}'", "closest function effect", :type, TRUE);
    END
    MUTABLE span_start = eff_kw;
    MUTABLE span_end_tok = eff_tok;
    IF !(castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, ":"))) THEN
      MUTABLE span = EffectSpan{ start_token: span_start, end_token: span_end_tok };
      RETURN ParsedEffectsDecl{ kind: :reentrant, span: COPY span, max_depth: NIL, tight: FALSE };
    END
    MUTABLE tight = FALSE;
    MUTABLE tight_tok: ?Token = NIL;
    IF clearParser__match?(rtoc_self_view, :KEYWORD, "TIGHT") THEN
      MUTABLE tight_token = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "TIGHT"));
      tight_tok = COPY tight_token;
      tight = TRUE;
      span_end_tok = tight_token;
      IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, ":")) THEN
    
      ELSE
        span = EffectSpan{ start_token: span_start, end_token: span_end_tok };
        RETURN ParsedEffectsDecl{ kind: :reentrant, span: COPY span, tight: TRUE, max_depth: NIL };
      END
    END
    MUTABLE variant_tok = TRY (clearParser__consume(&rtoc_self_view, :TYPE_ID));
    MUTABLE variant_value = TRY (token__text_mut(variant_tok));
    MUTABLE kind: String@symbol = :reentrant;
    IF (variant_value == "THUNK") THEN
      kind = :reentrant_thunk;
    ELSE_IF (variant_value == "TAIL_CALL") THEN
      kind = :reentrant_tail_call;
    ELSE_IF (variant_value == "NOT_LOGICAL") THEN
      kind = :reentrant_not_logical;
    ELSE_IF (variant_value == "MAX_DEPTH") THEN
      kind = :reentrant_max_depth;
    ELSE
      clearParser__emit_typo_suggestion_mut(rtoc_self_view, variant_tok, variant_value, ["THUNK", "TAIL_CALL", "NOT_LOGICAL", "MAX_DEPTH"], "Unknown REENTRANT variant '${variant_value}'", "closest REENTRANT variant", :type, TRUE);
    END
    IF (tight AND (((kind == :reentrant_not_logical) OR (kind == :reentrant_max_depth)))) THEN
      MUTABLE label: String = "";
      IF (kind == :reentrant_not_logical) THEN
        label = "NOT_LOGICAL";
      ELSE
        label = "MAX_DEPTH";
      END
      MUTABLE explanation: String = "";
      IF (label == "MAX_DEPTH") THEN
        explanation = "MAX_DEPTH(N) implies TIGHT (the bounded depth replaces the yield-check); just write :MAX_DEPTH(N).";
      ELSE
        explanation = "NOT_LOGICAL has depth=1 by runtime assertion, so TIGHT is meaningless.";
      END
      clearParser__error_mut(rtoc_self_view, variant_tok, CodeOrMessage{ SymbolValue: :INVALID_TIGHT_VARIANT }, [], {:label: "${label}", :explanation: "${explanation}"});
    END
    span_end_tok = variant_tok;
    MUTABLE max_depth_n: ?Int64 = NIL;
    IF (kind == :reentrant_max_depth) THEN
      clearParser__consume(&rtoc_self_view, :CHAR, "(");
      MUTABLE n_tok = clearParser__current(rtoc_self_view);
      MUTABLE n_lit = TRY (clearParser__consume_number(&rtoc_self_view));
      max_depth_n = TRY (token__integer_mut(n_lit));
      IF (max_depth_n <= 0) THEN
        clearParser__error_mut(rtoc_self_view, n_tok, CodeOrMessage{ SymbolValue: :MAX_DEPTH_NONPOSITIVE }, [], {:got: "${(UNWRAP max_depth_n).toString()}"});
      END
      MUTABLE close_tok = TRY (clearParser__consume(&rtoc_self_view, :CHAR, ")"));
      span_end_tok = close_tok;
    END
    span = EffectSpan{ start_token: span_start, end_token: span_end_tok };
    RETURN ParsedEffectsDecl{ kind: COPY kind, span: COPY span, max_depth: max_depth_n, tight: tight };
}
END
PRIVATE FN clearParser__parse_struct_body(MUTABLE self: ClearParser) RETURNS !{String}StructField
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE pairs: []Tuple<String, StructField> = List[];
    _, pairs = TRY (clearParser__parse_comma_seq(&rtoc_self_view, :CHAR, "{", "}", %(MUTABLE rtoc_view: ClearParser) -> {
    MUTABLE name_tok = TRY (clearParser__consume(&rtoc_view, :VAR_ID));
    MUTABLE name = TRY (token__text_mut(name_tok));
    MUTABLE default_val: ?Locatable = NIL;
    IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_view, :CHAR, "=")) THEN
        default_val = TRY (clearParser__parse_expression(&rtoc_view));
    END
    clearParser__consume(&rtoc_view, :CHAR, ":");
    MUTABLE borrowed: Bool = castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_view, :KEYWORD, "BORROWED"));
    MUTABLE type = TRY (clearParser__parse_type_annotation(&rtoc_view));
    TRY (clearParser__reject_auto_in_aggregate_field_mut(rtoc_view, type, name, name_tok, "STRUCT"));
    Tuple{name, StructField{ type: type, default: structField__node_default(default_val), borrowed: borrowed }}
    }));
    RETURN ruby_pairs_to_hash_String_StructField(pairs);
}
END
PRIVATE FN clearParser__reject_auto_in_aggregate_field_mut(self: ClearParser, type: Type, field_name: String, field_tok: ?Token, context_label: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(type__auto?(type)) THEN
      RETURN;
    END
    MUTABLE auto_tok_branch_value: ?Token = NIL;
    IF TRUE THEN
      auto_tok_branch_value = COPY type.auto_token;
    ELSE
      auto_tok_branch_value = NIL;
    END
    MUTABLE auto_tok: ?Token = auto_tok_branch_value;
    MUTABLE anchor: ?Token = COPY field_tok;
    IF auto_tok EXISTS AS auto_token THEN
      anchor = COPY auto_token;
    END
    clearParser__error_mut(rtoc_self_view, anchor, CodeOrMessage{ SymbolValue: :AUTO_NOT_ALLOWED_IN_FIELD }, [], {:context: "${context_label}", :field: "${field_name}"});
}
END
FN clearParser__parse_comma_seq<Elem>(MUTABLE self: ClearParser, type: String@symbol, open: String, close_value: String, blk: FN(MUTABLE ClearParser) -> Elem) RETURNS !Tuple<Token, []Elem>
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE start_token = TRY (clearParser__consume(&rtoc_self_view, type, open));
    MUTABLE items: []Elem = List[];
    WHILE !(clearParser__match?(rtoc_self_view, :CHAR, close_value)) DO
      &items.append(blk(&rtoc_self_view));
      clearParser__match_mut(&rtoc_self_view, :CHAR, ",");
    END
    clearParser__consume(&rtoc_self_view, :CHAR, close_value);
    RETURN Tuple{start_token, items};
}
END
FN clearParser__parse_generic_type_params(MUTABLE self: ClearParser) RETURNS ![]GenericParamDecl
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(clearParser__match?(rtoc_self_view, :CHAR, "<")) THEN
      MUTABLE none: []GenericParamDecl = List[];
      RETURN none;
    END
    _, MUTABLE params = TRY (clearParser__parse_comma_seq(&rtoc_self_view, :CHAR, "<", ">", %(MUTABLE rtoc_view: ClearParser) -> {
    MUTABLE name_token = TRY (clearParser__consume(&rtoc_view, :TYPE_ID));
    MUTABLE bounds: []GenericBoundDecl = List[];
    IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_view, :CHAR, ":")) THEN
        WHILE TRUE DO
          MUTABLE bound_token = clearParser__current(rtoc_view);
          &bounds.append(GenericBoundDecl{ token: bound_token, type: COPY clearParser__parse_type_annotation(&rtoc_view, FALSE) });
          IF !(castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_view, :CHAR, "&"))) THEN
            BREAK;
          END
        END
    END
    GenericParamDecl{ token: name_token, name: COPY TRY (token__text_mut(name_token)), bounds: COPY bounds }
    }));
    RETURN COPY params;
}
END
FN clearParser__starts_function_requirement?(self: ClearParser) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF clearParser__match?(rtoc_self_view, :KEYWORD, "FN") THEN
      RETURN TRUE;
    END
    IF !((clearParser__match?(rtoc_self_view, :KEYWORD, "PUB") OR clearParser__match?(rtoc_self_view, :KEYWORD, "PRIVATE"))) THEN
      RETURN FALSE;
    END
    RETURN ((clearParser__peek(rtoc_self_view).type == :KEYWORD) AND (token__text_is?(clearParser__peek(rtoc_self_view), "FN")));
}
END
FN clearParser__parse_generic_type_param_symbols(MUTABLE self: ClearParser) RETURNS ![]String@symbol
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE names: []String@symbol = List[];
    IF !(clearParser__match?(rtoc_self_view, :CHAR, "<")) THEN
      RETURN COPY names;
    END
    # parse_comma_seq is generic in its element; with a String element the
    # lambda argument and the element type get confused and the lambda itself
    # is copied as a string. Its body inlines to the same five lines.
    clearParser__consume(&rtoc_self_view, :CHAR, "<");
    WHILE !(clearParser__match?(rtoc_self_view, :CHAR, ">")) DO
      &names.append(symbol((TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :TYPE_ID))))));
      clearParser__match_mut(&rtoc_self_view, :CHAR, ",");
    END
    clearParser__consume(&rtoc_self_view, :CHAR, ">");
    RETURN COPY names;
}
END
