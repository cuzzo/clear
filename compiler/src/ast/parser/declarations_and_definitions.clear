FN clearParser__parse_assert_raises(MUTABLE self: ClearParser) RETURNS !AssertRaises
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE tok = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "ASSERT_RAISES"));
    MUTABLE kind = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :TYPE_ID)));
    clearParser__consume(&rtoc_self_view, :CHAR, ",");
    MUTABLE error_name: ?String = NIL;
    rtoc_cur_2 = clearParser__current(rtoc_self_view);
    IF (((rtoc_cur_2.type == :TYPE_ID) AND ((rtoc_self_view.tokens[(rtoc_self_view.pos + 1)] != NIL) AND (((rtoc_self_view.tokens[(rtoc_self_view.pos + 1)])?).type == :CHAR))) AND ((rtoc_self_view.tokens[(rtoc_self_view.pos + 1)] != NIL) AND (token__text_is?(((rtoc_self_view.tokens[(rtoc_self_view.pos + 1)])?), ",")))) THEN
      error_name = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :TYPE_ID)));
      clearParser__consume(&rtoc_self_view, :CHAR, ",");
    END
    MUTABLE expr = TRY (clearParser__parse_expression(&rtoc_self_view));
    clearParser__consume(&rtoc_self_view, :CHAR, ";");
    RETURN AssertRaises{ token: COPY tok, kind: COPY kind, error_name: error_name, expression: expr, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
}
END
FN clearParser__parse_benchmark_stmt(MUTABLE self: ClearParser) RETURNS !BenchmarkStmt
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE tok = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "BENCHMARK"));
    MUTABLE expr = TRY (clearParser__parse_expression(&rtoc_self_view));
    MUTABLE iterations = 1000;
    MUTABLE count_text = token__display_value(clearParser__current(rtoc_self_view));
    IF (clearParser__match?(rtoc_self_view, :VAR_ID) AND regexMatch?(count_text, "^x[0-9]+$")) THEN
      iterations = TRY (count_text.substr(1, (count_text.length() - 1)).toInt());
      clearParser__consume(&rtoc_self_view, :VAR_ID);
    END
    clearParser__consume(&rtoc_self_view, :CHAR, ";");
    RETURN BenchmarkStmt{ token: COPY tok, expression: expr, iterations: iterations, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
}
END
