PRIVATE FN clearParser__parse_extern_fn(MUTABLE self: ClearParser, extern_tok: Token) RETURNS !ExternFnDecl
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    clearParser__consume(&rtoc_self_view, :KEYWORD, "FN");
    MUTABLE owner_type: ?String = NIL;
    MUTABLE owner_type_params: []String@symbol = List[];
    MUTABLE fn_type_params: []String@symbol = List[];
    MUTABLE name: String = "";
    IF clearParser__match?(rtoc_self_view, :TYPE_ID) THEN
      MUTABLE type_name = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :TYPE_ID)));
      owner_type_params = TRY (clearParser__parse_generic_type_param_symbols(&rtoc_self_view));
      IF castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :CHAR, "."))) THEN
        owner_type = COPY type_name;
        name = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :VAR_ID)));
      ELSE
        name = type_name;
        fn_type_params = COPY owner_type_params;
        owner_type_params = List[];
      END
    ELSE
      name = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :VAR_ID)));
      fn_type_params = TRY (clearParser__parse_generic_type_param_symbols(&rtoc_self_view));
    END
    MUTABLE params = TRY (clearParser__parse_argument_list(&rtoc_self_view));
    MUTABLE explicit_return = TRY (clearParser__match_mut(&rtoc_self_view, :KEYWORD, "RETURNS"));
    MUTABLE return_lifetime: ?ClearParserReturnLifetime = NIL;
    MUTABLE return_type: ?Type = NIL;
    IF castClearParserReturnValueToBool(explicit_return) THEN
      return_lifetime = TRY (clearParser__parse_extern_return_lifetime(&rtoc_self_view));
      return_type = TRY (clearParser__parse_type_annotation(&rtoc_self_view));
    END
    MUTABLE effects = TRY (clearParser__parse_extern_effects(&rtoc_self_view));
    MUTABLE native_name: String = name;
    IF castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :KEYWORD, "AS"))) THEN
      native_name = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :STRING)));
    END
    clearParser__consume(&rtoc_self_view, :KEYWORD, "FROM");
    MUTABLE from_module = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :STRING)));
    MUTABLE source = TRY (clearParser__parse_extern_source(&rtoc_self_view, from_module, native_name));
    clearParser__match_mut(&rtoc_self_view, :CHAR, ";");
    RETURN ExternFnDecl{ token: COPY extern_tok, name: COPY name, params: COPY params, return_type: COPY return_type, from_module: COPY from_module, effects: COPY parsedExternEffects__to_h(effects), owner_type: COPY owner_type, owner_type_params: COPY owner_type_params, fn_type_params: COPY fn_type_params, extern_source: source, return_lifetime: return_lifetime, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
}
END
PRIVATE FN clearParser__parse_extern_return_lifetime(MUTABLE self: ClearParser) RETURNS !?ClearParserReturnLifetime
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE names: []Locatable = List[];
    IF clearParser__match?(rtoc_self_view, :CHAR, "(") THEN
      clearParser__consume(&rtoc_self_view, :CHAR, "(");
      names = List[];
      WHILE !(clearParser__match?(rtoc_self_view, :CHAR, ")")) DO
        &names.append(clearParser__parse_var_id(&rtoc_self_view));
        clearParser__match_mut(&rtoc_self_view, :CHAR, ",");
      END
      clearParser__consume(&rtoc_self_view, :CHAR, ")");
      clearParser__consume(&rtoc_self_view, :CHAR, ":");
      RETURN ClearParserReturnLifetime{ ArrayValue: COPY names };
    END
    IF clearParser__match?(rtoc_self_view, :CHAR, "*") THEN
      clearParser__consume(&rtoc_self_view, :CHAR, "*");
      clearParser__consume(&rtoc_self_view, :CHAR, ":");
      RETURN ClearParserReturnLifetime{ SymbolValue: :wildcard };
    END
    IF !(((clearParser__match?(rtoc_self_view, :VAR_ID) AND (clearParser__peek(rtoc_self_view).type == :CHAR)) AND (token__text_is?(clearParser__peek(rtoc_self_view), ":")))) THEN
      RETURN NIL;
    END
