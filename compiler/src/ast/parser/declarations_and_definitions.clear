        member_branch_value = TRY (clearParser__parse_function_def(&rtoc_self_view, visibility, TRUE));
      ELSE_IF clearParser__match?(rtoc_self_view, :KEYWORD, "FN") THEN
        member_branch_value = TRY (clearParser__parse_function_def(&rtoc_self_view, visibility));
      ELSE
        TRY (clearParser__error_mut(rtoc_self_view, clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :PARSER_EXPECTED }, [], {:expected: "FN, METHOD, or } in IMPLEMENTATION", :got: "${token__display_value(clearParser__current(rtoc_self_view))}", :type: "${clearParser__current(rtoc_self_view).type}", :line: clearParser__current(rtoc_self_view).line.toString()}));
      END
      MUTABLE member: FunctionDef = UNWRAP (member_branch_value);
      clearParser__stamp_source_range_mut(rtoc_self_view, Locatable{ FunctionDef: COPY member }, member_start, clearParser__previous(rtoc_self_view));
      &members.append(COPY member);
    END
    clearParser__consume(&rtoc_self_view, :CHAR, "}");
    RETURN members;
}
END
