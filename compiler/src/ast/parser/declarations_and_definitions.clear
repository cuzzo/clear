FN clearParser__parse_stub(MUTABLE self: ClearParser) RETURNS !StubDecl
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE tok = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "STUB"));
    MUTABLE fn_name = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :VAR_ID)));
    MUTABLE kind_tok = clearParser__current(rtoc_self_view);
    IF clearParser__match?(rtoc_self_view, :KEYWORD, "RETURNS") THEN
      clearParser__consume(&rtoc_self_view, :KEYWORD, "RETURNS");
      MUTABLE value = TRY (clearParser__parse_expression(&rtoc_self_view));
      clearParser__consume(&rtoc_self_view, :CHAR, ";");
      RETURN StubDecl{ token: COPY tok, function_name: COPY fn_name, kind: :returns, value: StubValue{ Locatable: COPY value }, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
    ELSE_IF clearParser__match?(rtoc_self_view, :KEYWORD, "CAPTURES") THEN
      clearParser__consume(&rtoc_self_view, :KEYWORD, "CAPTURES");
      MUTABLE var_name = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :VAR_ID)));
      clearParser__consume(&rtoc_self_view, :CHAR, ";");
      RETURN StubDecl{ token: COPY tok, function_name: COPY fn_name, kind: :captures, value: StubValue{ StringValue: COPY var_name }, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
    ELSE_IF clearParser__match?(rtoc_self_view, :KEYWORD, "SEQUENCE") THEN
      clearParser__consume(&rtoc_self_view, :KEYWORD, "SEQUENCE");
      MUTABLE bracket_tok, items = clearParser__parse_comma_seq(&rtoc_self_view, :CHAR, "[", "]", %(MUTABLE rtoc_view: ClearParser) -> clearParser__parse_expression(&rtoc_view));
      MUTABLE values = ListLit{ token: COPY bracket_tok, items: COPY items, storage: :stack, constructor_options: NIL, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
      clearParser__consume(&rtoc_self_view, :CHAR, ";");
      RETURN StubDecl{ token: COPY tok, function_name: COPY fn_name, kind: :sequence, value: StubValue{ Locatable: Locatable{ ListLit: COPY values } }, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
    ELSE_IF clearParser__match?(rtoc_self_view, :KEYWORD, "WITH") THEN
      clearParser__consume(&rtoc_self_view, :KEYWORD, "WITH");
      MUTABLE lambda_node = TRY (clearParser__parse_expression(&rtoc_self_view));
      clearParser__consume(&rtoc_self_view, :CHAR, ";");
      RETURN StubDecl{ token: COPY tok, function_name: COPY fn_name, kind: :with, value: StubValue{ Locatable: COPY lambda_node }, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
    ELSE
      TRY (clearParser__error_mut(rtoc_self_view, kind_tok, CodeOrMessage{ SymbolValue: :STUB_BAD_AFTER }, [], {:fn: "${fn_name}"}));
      panic("clearParser__error_mut raises");
    END
}
END
FN ruby_pairs_to_hash_String_StructField(pairs: []Tuple<String, StructField>) RETURNS {String}StructField ->
  MUTABLE result: {String}StructField = {};
  pairs |> EACH { result[COPY _._0] = COPY _._1; };
  RETURN result;
END
