PUB FN clearParser__parse_value_block_expr(MUTABLE self: ClearParser) RETURNS !BlockExpr
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE block_token = TRY (clearParser__consume(&rtoc_self_view, :CHAR, "{"));
    MUTABLE body: []Locatable = List[];
    MUTABLE result: ?Locatable = NIL;
    WHILE !((clearParser__match?(rtoc_self_view, :CHAR, "}") OR clearParser__match?(rtoc_self_view, :EOF))) DO
      rtoc_cur_1 = clearParser__current(rtoc_self_view);
      IF ((rtoc_cur_1.type == :VAR_ID) AND clearParser__destructuring_assignment?(rtoc_self_view)) THEN
        &body.append(Locatable{ DestructuringAssignment: COPY TRY (clearParser__parse_destructuring_assign(&rtoc_self_view)) });
        CONTINUE;
      END
      rtoc_cur_2 = clearParser__current(rtoc_self_view);
      IF (rtoc_cur_2.type == :VAR_ID) THEN
        MUTABLE parsed = TRY (clearParser__parse_var_form(&rtoc_self_view));
        IF (parsed.assignment OR castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :CHAR, ";")))) THEN
          IF parsed.assignment THEN
            clearParser__consume(&rtoc_self_view, :CHAR, ";");
          END
          &body.append(parsed.node);
          CONTINUE;
        END
        result = parsed.node;
        BREAK;
      END
      MUTABLE stmt: ?Locatable = TRY (clearParser__parse_value_block_keyword_statement(&rtoc_self_view));
      IF stmt EXISTS AS stmt_value THEN
        &body.append(COPY stmt_value);
        CONTINUE;
      END
      MUTABLE expr = TRY (clearParser__parse_expression(&rtoc_self_view));
      IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, ";")) THEN
        &body.append(COPY expr);
        CONTINUE;
      ELSE
        result = expr;
        BREAK;
      END
    END
    IF (result == NIL) THEN
      clearParser__error_mut(rtoc_self_view, clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :UNEXPECTED_TOKEN_LINE }, [], {:value: "${token__display_value(clearParser__current(rtoc_self_view))}", :type: "${clearParser__current(rtoc_self_view).type}", :line: clearParser__current(rtoc_self_view).line.toString()});
    END
    clearParser__consume(&rtoc_self_view, :CHAR, "}");
    RETURN BlockExpr{ token: COPY block_token, body: COPY body, result: COPY result, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
}
END
PRIVATE FN clearParser__parse_value_block_keyword_statement(MUTABLE self: ClearParser) RETURNS !?Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_cur_3 = clearParser__current(rtoc_self_view);
    IF !((rtoc_cur_3.type == :KEYWORD)) THEN
      RETURN NIL;
    END
    rtoc_cur_4 = clearParser__current(rtoc_self_view);
    IF !(VALUE_BLOCK_STATEMENT_KEYWORDS.contains?(token__display_value(rtoc_cur_4))) THEN
      RETURN NIL;
    END
    RETURN TRY (clearParser__parse_statement(&rtoc_self_view));
}
END
PUB FN clearParser__brace_literal_is_hash?(self: ClearParser) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(clearParser__match?(rtoc_self_view, :CHAR, "{")) THEN
      RETURN FALSE;
    END
    IF clearParser__match_at?(rtoc_self_view, 1, :CHAR, "}") THEN
      RETURN TRUE;
    END
    MUTABLE first: ?Token = clearParser__peek_at(rtoc_self_view, 1);
    IF (((first != NIL) AND (first.type == :KEYWORD)) AND VALUE_BLOCK_STATEMENT_KEYWORDS.contains?(token__display_value(first))) THEN
      RETURN FALSE;
    END
    MUTABLE depth = 0;
    MUTABLE offset = 0;
    WHILE TRUE DO
      MUTABLE token: ?Token = clearParser__peek_at(rtoc_self_view, offset);
      IF token EXISTS AS token_value THEN
        MUTABLE token_value_mutable = COPY token_value;
        IF (token_value_mutable.type == :CHAR) THEN
          MUTABLE token_text = TRY (token__text_mut(token_value_mutable));
          IF (token_text == "{") OR (token_text == "(") OR (token_text == "[") THEN
            MUTABLE closing_index: ?Int64 = rtoc_self_view.delimiter_closings[(rtoc_self_view.pos + offset)];
            IF (depth > 0) THEN
              IF closing_index EXISTS AS closing_at THEN
                offset = ((closing_at - rtoc_self_view.pos) + 1);
                CONTINUE;
              END
            END
            depth = (depth + 1);
          ELSE_IF (token_text == "}") OR (token_text == ")") OR (token_text == "]") THEN
            depth = (depth - 1);
            IF (depth <= 0) THEN
              RETURN FALSE;
            END
          ELSE_IF (token_text == ";") THEN
            IF (depth == 1) THEN
              RETURN FALSE;
            END
          ELSE_IF (token_text == ":") THEN
            IF (depth == 1) THEN
              RETURN !(clearParser__top_level_assignment_before_brace_delimiter?(rtoc_self_view, (offset + 1)));
            END
          END
        END
        offset = (offset + 1);
      ELSE
        RETURN FALSE;
      END
    END
    RETURN FALSE;
}
END
PRIVATE FN clearParser__top_level_assignment_before_brace_delimiter?(self: ClearParser, start_offset: Int64) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE depth = 1;
    MUTABLE offset = start_offset;
    WHILE TRUE DO
      MUTABLE token: ?Token = clearParser__peek_at(rtoc_self_view, offset);
      IF token EXISTS AS token_value THEN
        MUTABLE token_value_mutable = COPY token_value;
        IF ((token_value_mutable.type == :COMPOUND_ASSIGN) AND (depth == 1)) THEN
          RETURN TRUE;
        ELSE_IF (token_value_mutable.type == :CHAR) THEN
          MUTABLE token_text = TRY (token__text_mut(token_value_mutable));
          IF (token_text == "{") OR (token_text == "(") OR (token_text == "[") THEN
            MUTABLE closing_index: ?Int64 = rtoc_self_view.delimiter_closings[(rtoc_self_view.pos + offset)];
            IF closing_index EXISTS AS closing_index_value THEN
              offset = ((closing_index_value - rtoc_self_view.pos) + 1);
              CONTINUE;
            END
            depth = (depth + 1);
          ELSE_IF (token_text == "}") OR (token_text == ")") OR (token_text == "]") THEN
            depth = (depth - 1);
            IF (depth <= 0) THEN
              RETURN FALSE;
            END
          ELSE_IF (token_text == ",") OR (token_text == ";") THEN
            IF (depth == 1) THEN
              RETURN FALSE;
            END
          ELSE_IF (token_text == "=") THEN
            IF (depth == 1) THEN
              RETURN TRUE;
            END
          END
        END
        offset = (offset + 1);
      ELSE
        RETURN FALSE;
      END
    END
    RETURN FALSE;
}
END
PRIVATE FN clearParser__parse_match_expr(MUTABLE self: ClearParser, MUTABLE partial_value: Bool = FALSE) RETURNS !MatchStatement
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE start = TRY (clearParser__parse_match_start(&rtoc_self_view));
    MUTABLE cases: []MatchCase = List[];
    MUTABLE default_case: ?[]Locatable = NIL;
    WHILE !((clearParser__match?(rtoc_self_view, :KEYWORD, "END") OR clearParser__match?(rtoc_self_view, :EOF))) DO
