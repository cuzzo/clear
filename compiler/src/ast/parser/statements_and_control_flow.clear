CONST VALUE_BLOCK_STATEMENT_KEYWORDS: [Set]String = ["ASSERT", "ASSERT_RAISES", "BENCHMARK", "BREAK", "CONTINUE", "DEFER", "DIE", "DO", "ENUM", "EXIT", "EXTERN", "FN", "FOR", "METHOD", "MUTABLE", "IF", "MATCH", "PARTIAL", "PASS", "PRIVATE", "PROFILE", "PUB", "RAISE", "RETURN", "SMASH", "STRUCT", "STUB", "SYNC", "TEST", "TIGHT", "UNION", "WHILE", "WITH", "YIELD"] |> DISTINCT _;
PUB FN clearParser__dispatch_stmt_rule(MUTABLE self: ClearParser, rule: ParserRule) RETURNS !Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE result = PARTIAL MATCH rule.action START
      :parse_require -> Locatable{ RequireNode: clearParser__parse_require(&rtoc_self_view) },
      :parse_extern_decl -> castClearParserReturnValueToLocatable(clearParser__parse_extern_decl(&rtoc_self_view)),
      :parse_mutable_var_decl -> castClearParserReturnValueToLocatable(clearParser__parse_mutable_var_decl(&rtoc_self_view)),
      :parse_const_decl -> Locatable{ VarDecl: clearParser__parse_const_decl(&rtoc_self_view) },
      :parse_function_def -> Locatable{ FunctionDef: clearParser__parse_function_def(&rtoc_self_view) },
      :parse_method_function_def -> Locatable{ FunctionDef: clearParser__parse_function_def(&rtoc_self_view, :package, TRUE) },
      :parse_pub_visibility -> clearParser__parse_visibility_decl(&rtoc_self_view, :pub),
      :parse_private_visibility -> clearParser__parse_visibility_decl(&rtoc_self_view, :private),
      :parse_if_statement -> castClearParserReturnValueToLocatable(clearParser__parse_if_statement(&rtoc_self_view)),
      :parse_comptime_statement -> castClearParserReturnValueToLocatable(clearParser__parse_comptime_statement(&rtoc_self_view)),
      :parse_struct_def -> Locatable{ StructDef: clearParser__parse_struct_def(&rtoc_self_view) },
      :parse_protocol_def -> Locatable{ ProtocolDef: clearParser__parse_protocol_def(&rtoc_self_view) },
      :parse_implementation_def -> castClearParserReturnValueToLocatable(clearParser__parse_implementation_def(&rtoc_self_view)),
      :parse_enum_def -> Locatable{ EnumDef: clearParser__parse_enum_def(&rtoc_self_view) },
      :parse_union_def -> Locatable{ UnionDef: clearParser__parse_union_def(&rtoc_self_view) },
      :parse_while_loop -> castClearParserReturnValueToLocatable(clearParser__parse_while_loop(&rtoc_self_view)),
      :parse_for_range -> castClearParserReturnValueToLocatable(TRY (clearParser__parse_for_range(&rtoc_self_view))),
      :parse_tight_stmt -> TRY (clearParser__parse_tight_stmt(&rtoc_self_view)),
      :parse_return -> Locatable{ ReturnNode: TRY (clearParser__parse_return(&rtoc_self_view)) },
      :parse_assert -> Locatable{ Assert: clearParser__parse_assert(&rtoc_self_view) },
      :parse_defer -> Locatable{ DeferStmt: TRY (clearParser__parse_defer(&rtoc_self_view)) },
      :parse_assert_raises -> Locatable{ AssertRaises: clearParser__parse_assert_raises(&rtoc_self_view) },
      :parse_test_block -> Locatable{ TestBlock: clearParser__parse_test_block(&rtoc_self_view) },
      :parse_stub -> Locatable{ StubDecl: clearParser__parse_stub(&rtoc_self_view) },
      :parse_benchmark_stmt -> Locatable{ BenchmarkStmt: clearParser__parse_benchmark_stmt(&rtoc_self_view) },
      :parse_smash_stmt -> Locatable{ SmashStmt: TRY (clearParser__parse_smash_stmt(&rtoc_self_view)) },
      :parse_profile_stmt -> Locatable{ ProfileStmt: TRY (clearParser__parse_profile_stmt(&rtoc_self_view)) },
      :parse_raise_stmt -> Locatable{ Raise: clearParser__parse_raise_stmt(&rtoc_self_view) },
      :parse_exit -> Locatable{ ThrowNode: TRY (clearParser__parse_exit(&rtoc_self_view)) },
      :parse_die -> Locatable{ DieNode: TRY (clearParser__parse_die(&rtoc_self_view)) },
      :parse_break -> Locatable{ BreakNode: TRY (clearParser__parse_break(&rtoc_self_view)) },
      :parse_continue -> Locatable{ ContinueNode: TRY (clearParser__parse_continue(&rtoc_self_view)) },
      :parse_with_capability -> Locatable{ WithBlock: UNWRAP (TRY (clearParser__parse_with_capability(&rtoc_self_view))) },
      :parse_sync_policy_block -> Locatable{ SyncPolicyDecl: clearParser__parse_sync_policy_block(&rtoc_self_view) },
      :parse_do_block -> Locatable{ DoBlock: TRY (clearParser__parse_do_block(&rtoc_self_view)) },
      :parse_bg_block -> castBgNodeToLocatable(TRY (clearParser__parse_bg_block(&rtoc_self_view))),
      :parse_yield_expr -> Locatable{ YieldExpr: TRY (clearParser__parse_yield_expr(&rtoc_self_view)) },
      :parse_close_stream -> Locatable{ CloseStream: TRY (clearParser__parse_close_stream(&rtoc_self_view)) },
      :parse_match_statement -> Locatable{ MatchStatement: TRY (clearParser__parse_match_statement(&rtoc_self_view)) },
      :parse_partial_match_statement -> TRY (clearParser__parse_partial_match_statement(&rtoc_self_view)),
      :parse_pass_statement -> Locatable{ PassStmt: TRY (clearParser__parse_pass_statement(&rtoc_self_view)) },
      DEFAULT -> panic("Unknown statement parser action {}")
    END;
    RETURN result;
}
END
PRIVATE FN clearParser__parse_assert(MUTABLE self: ClearParser) RETURNS !Assert
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE token = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "ASSERT"));
    MUTABLE condition = TRY (clearParser__parse_expression(&rtoc_self_view));
    MUTABLE message: AssertMessage = AssertMessage{ SymbolValue: :Any };
    IF castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :CHAR, ","))) THEN
      message = AssertMessage{ StringValue: TRY (token__text_mut(TRY (clearParser__consume(&rtoc_self_view, :STRING)))) };
    END
    clearParser__consume(&rtoc_self_view, :CHAR, ";");
    RETURN Assert{ token: COPY token, condition: condition, message: message, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
}
END
PRIVATE FN clearParser__parse_defer(MUTABLE self: ClearParser) RETURNS !DeferStmt
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE token = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "DEFER"));
    MUTABLE body: []Locatable = List[];
    IF clearParser__match?(rtoc_self_view, :CHAR, "{") THEN
      clearParser__consume(&rtoc_self_view, :CHAR, "{");
      MUTABLE stmts: []Locatable = List[];
      WHILE !(clearParser__match?(rtoc_self_view, :CHAR, "}")) DO
        &stmts.append(TRY (clearParser__parse_statement(&rtoc_self_view)));
      END
      clearParser__consume(&rtoc_self_view, :CHAR, "}");
      body = stmts;
    ELSE
      body = [TRY (clearParser__parse_statement(&rtoc_self_view))];
    END
    TRY (clearParser__reject_defer_control_flow_mut(rtoc_self_view, token, body));
    RETURN DeferStmt{ token: COPY token, body: body, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
}
END
PRIVATE FN clearParser__reject_defer_control_flow_mut(self: ClearParser, token: Token, body: []Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    FOR rtoc_defer_root IN body DO
      MUTABLE found: ?String = clearParser__first_defer_control_flow(COPY rtoc_defer_root);
      IF found EXISTS AS control_flow_kind THEN
        TRY (clearParser__error_mut(rtoc_self_view, token, CodeOrMessage{ SymbolValue: :DEFER_NO_CONTROL_FLOW }, [], {:kind: control_flow_kind}));
      END
    END
}
END
# each_locatable takes a visitor lambda, and a lambda cannot capture the
# mutable local an accumulating visitor would need. The search returns its
# find instead, which is also what raise-on-first-hit means in Ruby.
PRIVATE FN clearParser__first_defer_control_flow(root: Locatable) RETURNS ?String EFFECTS REENTRANT ->
  MUTABLE kind: ?String = clearParser__defer_control_flow_kind(root);
  IF kind EXISTS AS control_flow_kind THEN
    RETURN COPY control_flow_kind;
  END
  IF root IS_A FunctionDef THEN
    RETURN NIL;
  END
  FOR child IN rtocChildrenLocatable(root) DO
    MUTABLE nested: ?String = clearParser__first_defer_control_flow(child);
    IF nested EXISTS AS nested_kind THEN
      RETURN COPY nested_kind;
    END
  END
  RETURN NIL;
END
PRIVATE FN clearParser__defer_control_flow_kind(node: Locatable) RETURNS ?String ->
  IF node IS_A ReturnNode THEN
    RETURN "ReturnNode";
  END
  IF node IS_A BreakNode THEN
    RETURN "BreakNode";
  END
  IF node IS_A ContinueNode THEN
    RETURN "ContinueNode";
  END
  IF node IS_A YieldExpr THEN
    RETURN "YieldExpr";
  END
  RETURN NIL;
END
