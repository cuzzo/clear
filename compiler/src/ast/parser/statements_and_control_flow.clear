PRIVATE FN clearParser__parse_match_start(MUTABLE self: ClearParser) RETURNS !ParsedMatchStart
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE token = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "MATCH"));
    MUTABLE takes = !(!(castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :KEYWORD, "TAKES")))));
    MUTABLE subject = TRY (clearParser__parse_expression(&rtoc_self_view));
    clearParser__consume(&rtoc_self_view, :KEYWORD, "START");
    RETURN ParsedMatchStart{ token: COPY token, subject: COPY subject, takes: takes };
}
END
PRIVATE FN clearParser__parse_match_arm(MUTABLE self: ClearParser) RETURNS !ParsedMatchArm
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "WHEN")) THEN
      MUTABLE condition = TRY (clearParser__parse_expression(&rtoc_self_view));
      clearParser__consume(&rtoc_self_view, :ARROW);
      RETURN ParsedMatchArm{ kind: :when, value: COPY condition, extra_values: List[], binding: NIL, destructure: NIL };
    END
    IF clearParser__match?(rtoc_self_view, :CHAR, "{") THEN
      MUTABLE pattern = TRY (clearParser__parse_struct_pattern(&rtoc_self_view));
      clearParser__consume(&rtoc_self_view, :ARROW);
      RETURN ParsedMatchArm{ kind: :struct_pattern, value: Locatable{ StructPattern: COPY pattern }, extra_values: List[], binding: NIL, destructure: NIL };
    END
    MUTABLE first_pattern = TRY (clearParser__parse_expression(&rtoc_self_view));
    MUTABLE extra_patterns: []Locatable = List[];
    WHILE (clearParser__match?(rtoc_self_view, :CHAR, ",") AND clearParser__multi_pattern_continues?(rtoc_self_view)) DO
      clearParser__consume(&rtoc_self_view, :CHAR, ",");
      &extra_patterns.append(clearParser__parse_expression(&rtoc_self_view));
    END
    MUTABLE binding: ?String = NIL;
    MUTABLE destructure: ?StructPattern = NIL;
    IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "AS")) THEN
      binding = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :VAR_ID)));
    ELSE_IF clearParser__match?(rtoc_self_view, :CHAR, "{") THEN
      destructure = TRY (clearParser__parse_struct_pattern(&rtoc_self_view));
    END
    clearParser__consume(&rtoc_self_view, :ARROW);
    RETURN ParsedMatchArm{ kind: :eq, value: COPY first_pattern, extra_values: COPY extra_patterns, binding: COPY binding, destructure: COPY destructure };
}
END
PRIVATE FN clearParser__build_match_case(self: ClearParser, arm: ParsedMatchArm, body: []Locatable) RETURNS MatchCase
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN MatchCase{ kind: COPY arm.kind, value: COPY arm.value, body: COPY body, binding: COPY arm.binding, destructure: COPY arm.destructure, extra_values: COPY arm.extra_values, indirect_payload_as: FALSE };
}
END
PRIVATE FN clearParser__parse_struct_pattern(MUTABLE self: ClearParser) RETURNS !StructPattern
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE tok = TRY (clearParser__consume(&rtoc_self_view, :CHAR, "{"));
    MUTABLE fields: []PatternField = List[];
    MUTABLE partial: Bool = FALSE;
    WHILE !((clearParser__match?(rtoc_self_view, :CHAR, "}") OR clearParser__match?(rtoc_self_view, :EOF))) DO
      IF clearParser__match?(rtoc_self_view, :ELLIPSIS, "...") THEN
        clearParser__consume(&rtoc_self_view, :ELLIPSIS, "...");
        partial = TRUE;
        BREAK;
      END
      MUTABLE name_tok = TRY (clearParser__consume(&rtoc_self_view, :VAR_ID));
      MUTABLE name = TRY (token__text_mut(name_tok));
      IF clearParser__match?(rtoc_self_view, :CHAR, ":") THEN
        clearParser__consume(&rtoc_self_view, :CHAR, ":");
        rtoc_cur_5 = clearParser__current(rtoc_self_view);
        IF ((rtoc_cur_5.type == :VAR_ID) AND (token__text_is?(rtoc_cur_5, "_"))) THEN
          clearParser__consume(&rtoc_self_view, :VAR_ID);
          &fields.append(PatternField{ name: COPY name, value: PatternFieldValue{ SymbolValue: :wildcard }, name_token: name_tok });
        ELSE
          &fields.append(PatternField{ name: COPY name, value: castLocatableToPatternFieldValue(COPY clearParser__parse_expression(&rtoc_self_view)), name_token: name_tok });
        END
      ELSE
        &fields.append(PatternField{ name: COPY name, value: PatternFieldValue{ SymbolValue: :bind }, name_token: name_tok });
      END
      clearParser__match_mut(&rtoc_self_view, :CHAR, ",");
    END
    clearParser__consume(&rtoc_self_view, :CHAR, "}");
    RETURN StructPattern{ token: COPY tok, fields: COPY fields, partial: partial, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
}
END
PUB FN clearParser__parse_catch_item(MUTABLE self: ClearParser) RETURNS !CatchItem
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE tok = TRY (clearParser__consume(&rtoc_self_view, :TYPE_ID));
    MUTABLE rtoc_kind_names = ruby_constant_error_kinds() |> SELECT _.toString();
    MUTABLE rtoc_tok_text = TRY (token__text_mut(tok));
    MUTABLE form = IF rtoc_kind_names.contains?(rtoc_tok_text) THEN
      :kind
    ELSE
      :type
    END;
    RETURN CatchItem{ form: COPY form, name: COPY TRY (token__text_mut(tok)), token: tok };
}
END
PUB FN clearParser__parse_catch_filter(MUTABLE self: ClearParser) RETURNS !CatchFilter
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF clearParser__match?(rtoc_self_view, :TYPE_ID) THEN
      MUTABLE tok = TRY (clearParser__consume(&rtoc_self_view, :TYPE_ID));
      RETURN CatchFilter{ form: :type, value: CatchFilterReturnValue{ StringValue: COPY TRY (token__text_mut(tok)) }, token: tok };
    ELSE_IF clearParser__match?(rtoc_self_view, :STRING) THEN
      tok = clearParser__current(rtoc_self_view);
      MUTABLE str_expr = TRY (clearParser__parse_expression(&rtoc_self_view));
      MUTABLE filter_value = castLocatableToCatchFilterReturnValue(COPY str_expr);
      RETURN CatchFilter{ form: :message, value: filter_value, token: tok };
    ELSE
      TRY (clearParser__error_mut(rtoc_self_view, clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :CATCH_WITH_BAD_INNER }));
      panic("clearParser__error_mut raises");
    END
}
END
PRIVATE FN clearParser__parse_raise_stmt(MUTABLE self: ClearParser) RETURNS !Raise
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE tok = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "RAISE"));
    IF clearParser__match?(rtoc_self_view, :STRING) THEN
      MUTABLE msg = TRY (clearParser__parse_expression(&rtoc_self_view));
      clearParser__consume(&rtoc_self_view, :CHAR, ";");
      RETURN Raise{ token: COPY tok, kind: :System, error_name: NIL, message_expr: msg, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
    END
    IF clearParser__match?(rtoc_self_view, :CHAR, ";") THEN
      clearParser__consume(&rtoc_self_view, :CHAR, ";");
      RETURN Raise{ token: COPY tok, kind: :System, error_name: NIL, message_expr: NIL, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
    END
    MUTABLE first_tok = TRY (clearParser__consume(&rtoc_self_view, :TYPE_ID));
    MUTABLE first_is_kind = (ruby_constant_error_kinds() |> SELECT _.toString()).contains?(TRY (token__text_mut(first_tok)));
    MUTABLE kind: ?String@symbol = symbol((TRY (token__text_mut(first_tok))));
    IF !(first_is_kind) THEN
      kind = NIL;
    END
    MUTABLE error_name: ?String = NIL;
    IF !(first_is_kind) THEN
      error_name = TRY (token__text_mut(first_tok));
    END
    MUTABLE message: ?Locatable = NIL;
    IF clearParser__match?(rtoc_self_view, :CHAR, ",") THEN
      clearParser__consume(&rtoc_self_view, :CHAR, ",");
      IF (first_is_kind AND clearParser__match?(rtoc_self_view, :TYPE_ID)) THEN
        error_name = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :TYPE_ID)));
        IF clearParser__match?(rtoc_self_view, :CHAR, ",") THEN
          clearParser__consume(&rtoc_self_view, :CHAR, ",");
          message = TRY (clearParser__parse_expression(&rtoc_self_view));
        END
      ELSE
        message = TRY (clearParser__parse_expression(&rtoc_self_view));
      END
    END
    clearParser__consume(&rtoc_self_view, :CHAR, ";");
    RETURN Raise{ token: COPY tok, kind: symbol(UNWRAP (COPY kind)), error_name: error_name, message_expr: message, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
}
