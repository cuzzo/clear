PRIVATE FN clearParser__parse_match_statement(MUTABLE self: ClearParser, MUTABLE partial_value: Bool = FALSE) RETURNS !MatchStatement
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE start = TRY (clearParser__parse_match_start(&rtoc_self_view));
    MUTABLE cases: []MatchCase = List[];
    MUTABLE default_case: ?[]Locatable = NIL;
    WHILE !((clearParser__match?(rtoc_self_view, :KEYWORD, "END") OR clearParser__match?(rtoc_self_view, :EOF))) DO
      IF clearParser__match?(rtoc_self_view, :KEYWORD, "DEFAULT") THEN
        clearParser__consume(&rtoc_self_view, :KEYWORD, "DEFAULT");
        clearParser__consume(&rtoc_self_view, :ARROW);
        default_case = TRY (clearParser__parse_block_body(&rtoc_self_view, ["END"]));
        BREAK;
      END
      MUTABLE arm = TRY (clearParser__parse_match_arm(&rtoc_self_view));
      MUTABLE body = TRY (clearParser__parse_block_body(&rtoc_self_view, [",", "DEFAULT", "WHEN", "END"]));
      &cases.append(clearParser__build_match_case(rtoc_self_view, arm, body));
      clearParser__match_mut(&rtoc_self_view, :CHAR, ",");
    END
    clearParser__consume(&rtoc_self_view, :KEYWORD, "END");
    RETURN MatchStatement{ token: COPY start.token, expr: COPY start.subject, cases: COPY cases, default_case: COPY default_case, case_drops: List[], default_drops: NIL, exhaustive: !(partial_value), takes: start.takes, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, string_match: NIL, expr_mode: NIL, case_result_types: NIL, default_result_type: NIL };
