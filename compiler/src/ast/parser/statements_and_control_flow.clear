PUB FN clearParser__parse_block_body(MUTABLE self: ClearParser, stop_words: []String) RETURNS ![]Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE stmts: []Locatable = List[];
    WHILE !(((stop_words |> ANY clearParser__match?(rtoc_self_view, clearParser__literal_token_type(rtoc_self_view, _), _)) OR clearParser__match?(rtoc_self_view, :EOF))) DO
      MUTABLE stmt = TRY (clearParser__parse_statement(&rtoc_self_view));
      &stmts.append(stmt);
    END
    RETURN stmts;
}
END
PRIVATE FN clearParser__parse_statement_block(MUTABLE self: ClearParser, type: String@symbol, open: String, close_value: String) RETURNS ![]Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    clearParser__consume(&rtoc_self_view, type, open);
    MUTABLE body = TRY (clearParser__parse_block_body(&rtoc_self_view, [close_value]));
    clearParser__consume(&rtoc_self_view, clearParser__literal_token_type(rtoc_self_view, close_value), close_value);
    RETURN body;
}
END
