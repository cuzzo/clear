PUB FN clearParser__parse_statement(MUTABLE self: ClearParser) RETURNS !Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_mutable_receiver_2 = KEEP rtoc_self_view.budget;
    TRY (frontendResourceBudget__enter_mut(&rtoc_mutable_receiver_2));
    MUTABLE statement = TRY (clearParser__parse_statement_body(&rtoc_self_view));
    MUTABLE rtoc_mutable_receiver_3 = KEEP rtoc_self_view.budget;
    frontendResourceBudget__leave_mut(&rtoc_mutable_receiver_3);
    RETURN statement;
}
END
PRIVATE FN clearParser__parse_statement_body(MUTABLE self: ClearParser) RETURNS !Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE start_token = clearParser__current(rtoc_self_view);
    MUTABLE node: ?Locatable = NIL;
    rtoc_cur_0 = clearParser__current(rtoc_self_view);
    IF (rtoc_cur_0.type == :VAR_ID) THEN
      IF clearParser__destructuring_assignment?(rtoc_self_view) THEN
        node = Locatable{ DestructuringAssignment: COPY TRY (clearParser__parse_destructuring_assign(&rtoc_self_view)) };
      ELSE
        MUTABLE parsed = TRY (clearParser__parse_var_form(&rtoc_self_view));
        clearParser__consume(&rtoc_self_view, :CHAR, ";");
        node = parsed.node;
      END
    ELSE
      MUTABLE rule: ?ParserRule = STMT_RULE_INDEX[clearParser__token_rule_key(clearParser__current(rtoc_self_view))];
      IF rule EXISTS AS matched_rule THEN
        node = TRY (clearParser__dispatch_stmt_rule(&rtoc_self_view, matched_rule));
      ELSE
        node = TRY (clearParser__parse_expression(&rtoc_self_view));
        clearParser__consume(&rtoc_self_view, :CHAR, ";");
      END
    END
    MUTABLE stamped: Locatable = UNWRAP (node);
    RETURN clearParser__stamp_source_range_mut(rtoc_self_view, &stamped, start_token, clearParser__previous(rtoc_self_view));
}
END
PUB FN clearParser__destructuring_assignment?(self: ClearParser) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF clearParser__match_at?(rtoc_self_view, 1, :CHAR, ",") THEN
      RETURN TRUE;
    END
    IF !(clearParser__match_at?(rtoc_self_view, 1, :CHAR, ":")) THEN
      RETURN FALSE;
    END
    MUTABLE offset = 2;
    MUTABLE delimiters: []String = List[];
    WHILE TRUE DO
      MUTABLE token_slot: ?Token = clearParser__peek_at(rtoc_self_view, offset);
      IF token_slot == NIL THEN
        RETURN FALSE;
      END
      MUTABLE token: Token = UNWRAP (token_slot);
      IF (token.type == :EOF) THEN
        RETURN FALSE;
      END
      IF (token.type == :CHAR) THEN
        MUTABLE value = TRY (token__text_mut(token));
        IF (value == "(") OR (value == "[") OR (value == "{") OR (value == "<") THEN
          &delimiters.append(value);
        ELSE_IF (value == ")") OR (value == "]") OR (value == "}") OR (value == ">") THEN
          IF !((delimiters.length() == 0)) THEN
            &delimiters.pop();
          END
        ELSE_IF (value == ",") THEN
          IF (delimiters.length() == 0) THEN
            RETURN TRUE;
          END
        ELSE_IF (value == "=") OR (value == ";") THEN
          IF (delimiters.length() == 0) THEN
            RETURN FALSE;
          END
        END
      END
      offset = (offset + 1);
    END
    RETURN FALSE;
}
END
PUB FN clearParser__parse_destructuring_assign(MUTABLE self: ClearParser, default_mutable: Bool = FALSE) RETURNS !DestructuringAssignment
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE start_token = clearParser__current(rtoc_self_view);
    MUTABLE targets: []DestructureTarget = List[];
    &targets.append(TRY (clearParser__parse_destructure_target(&rtoc_self_view, default_mutable)));
    WHILE castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :CHAR, ","))) DO
      &targets.append(clearParser__parse_destructure_target(&rtoc_self_view, default_mutable));
    END
    clearParser__consume(&rtoc_self_view, :CHAR, "=");
    MUTABLE value = TRY (clearParser__parse_expression(&rtoc_self_view));
    clearParser__consume(&rtoc_self_view, :CHAR, ";");
    RETURN DestructuringAssignment{ token: COPY start_token, targets: COPY targets, value: value, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
}
END
PRIVATE FN clearParser__parse_destructure_target(MUTABLE self: ClearParser, default_mutable: Bool = FALSE) RETURNS !DestructureTarget
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE mutable = default_mutable;
    IF castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :KEYWORD, "MUTABLE"))) THEN
      mutable = TRUE;
    END
    MUTABLE name_tok = TRY (clearParser__consume(&rtoc_self_view, :VAR_ID));
    MUTABLE type_annotation: ?Type = NIL;
    IF castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :CHAR, ":"))) THEN
      type_annotation = TRY (clearParser__parse_type_annotation(&rtoc_self_view));
    END
    RETURN DestructureTarget{ token: COPY name_tok, name: TRY (token__text_mut(name_tok)), type: COPY type_annotation, mutable: mutable, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, mir_binding_entry: NIL };
}
END
PUB FN clearParser__parse_var_form(MUTABLE self: ClearParser) RETURNS !ParsedVarForm
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE target_token = clearParser__current(rtoc_self_view);
    MUTABLE target = TRY (clearParser__parse_expression(&rtoc_self_view));
    MUTABLE opt_type: ?Type = NIL;
    IF target IS_A Identifier THEN
      IF clearParser__match?(rtoc_self_view, :CHAR, ":") THEN
        clearParser__consume(&rtoc_self_view, :CHAR, ":");
        opt_type = (TRY (clearParser__parse_inferred_wrapper_annotation(&rtoc_self_view)) OR_ELSE clearParser__parse_type_annotation(&rtoc_self_view));
      END
    END
    IF clearParser__match?(rtoc_self_view, :COMPOUND_ASSIGN) THEN
      IF !(((target IS_A Identifier OR target IS_A GetField) OR target IS_A GetIndex)) THEN
        clearParser__error_mut(rtoc_self_view, target_token, CodeOrMessage{ SymbolValue: :INVALID_ASSIGNMENT });
      END
      MUTABLE op_token = TRY (clearParser__consume(&rtoc_self_view, :COMPOUND_ASSIGN));
      MUTABLE op_char = (TRY (token__text_mut(op_token))).substr(0, 1);
      MUTABLE op_sym = (ruby_constant_op_to_op_code()[op_char] OR_ELSE symbol(op_char));
      MUTABLE rhs = TRY (clearParser__parse_expression(&rtoc_self_view));
      MUTABLE desugared_value = Locatable{ BinaryOp: COPY BinaryOp{ token: COPY op_token, left: clearParser__deep_clone_node(rtoc_self_view, target), op: COPY op_sym, right: rhs, paren_bind: NIL, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, string_concat: NIL, or_fallback_dupe: NIL, error_union_type: NIL, observable_terminal: NIL, observable_dest: NIL, retain_error_channel: NIL } };
      IF target IS_A Identifier AS identifier THEN
        MUTABLE bind = BindExpr{ token: COPY target_token, name: identifier__name(identifier), type: NIL, value: desugared_value, compound_op: NIL, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, mode: NIL, reassign_cleanup: NIL, mir_binding_entry: NIL, auto_atomic_op: NIL, ownership_transport_plan: NIL };
