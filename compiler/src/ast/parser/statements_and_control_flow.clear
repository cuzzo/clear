PRIVATE FN clearParser__parse_inferred_wrapper_annotation(MUTABLE self: ClearParser) RETURNS !?Type
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(((clearParser__match?(rtoc_self_view, :CHAR, "!") OR clearParser__match?(rtoc_self_view, :CHAR, "?")) OR clearParser__match?(rtoc_self_view, :CHAR, "~"))) THEN
      RETURN NIL;
    END
    MUTABLE start = token__display_value(clearParser__current(rtoc_self_view));
    MUTABLE next_token: ?Token = clearParser__peek_at(rtoc_self_view, 1);
    MUTABLE suffix =   IF (((start == "!") AND ((next_token != NIL) AND (next_token.type == :CHAR))) AND (token__text_is?(next_token, "?"))) THEN
      "!?"
    ELSE
      start
    END;
    MUTABLE required_count = suffix.length();
    MUTABLE terminal: ?Token = clearParser__peek_at(rtoc_self_view, required_count);
    IF !((((terminal != NIL) AND (terminal.type == :CHAR)) AND (token__text_is?(terminal, "=")))) THEN
      RETURN NIL;
    END
    MUTABLE consumed = 0;
    WHILE consumed < required_count DO
      TRY (clearParser__consume(&rtoc_self_view, :CHAR));
      consumed = (consumed + 1);
    END
    RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY "${suffix}Auto" }));
}
END
PRIVATE FN clearParser__parse_tight_stmt(MUTABLE self: ClearParser) RETURNS !Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE body: []Locatable = List[];
    MUTABLE tight_token = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "TIGHT"));
    IF clearParser__match?(rtoc_self_view, :KEYWORD, "FOR") THEN
      MUTABLE for_node = TRY (clearParser__parse_for_range(&rtoc_self_view));
      IF for_node IS_A ForRange AS for_range THEN
        MUTABLE tight_range = COPY for_range;
        tight_range.tight = TRUE;
        RETURN Locatable{ ForRange: COPY tight_range };
      END
      IF for_node IS_A ForEach AS for_each THEN
        MUTABLE tight_each = COPY for_each;
        tight_each.tight = TRUE;
        RETURN Locatable{ ForEach: COPY tight_each };
      END
      RETURN castClearParserReturnValueToLocatable(for_node);
    END
    IF !(clearParser__match?(rtoc_self_view, :KEYWORD, "WHILE")) THEN
      panic("Expected WHILE or FOR after TIGHT (got {})");
    END
    clearParser__consume(&rtoc_self_view, :KEYWORD, "WHILE");
    MUTABLE cond = TRY (clearParser__parse_expression(&rtoc_self_view));
    IF clearParser__match?(rtoc_self_view, :ARROW, "->") THEN
      clearParser__consume(&rtoc_self_view, :ARROW, "->");
      MUTABLE stmt = TRY (clearParser__parse_statement(&rtoc_self_view));
      body = ([stmt]);
    ELSE
      body = TRY (clearParser__parse_keyword_block(&rtoc_self_view, "DO"));
    END
    MUTABLE while_node = WhileLoop{ token: COPY tight_token, condition: COPY cond, do_branch: COPY body, deferred_drops: NIL, tight: FALSE, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, mark_per_iter: NIL };
    while_node.tight = TRUE;
    RETURN Locatable{ WhileLoop: COPY while_node };
}
END
