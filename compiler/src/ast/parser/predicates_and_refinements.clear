    Locatable.FieldCleanup AS cast_payload -> RETURN StepsItem{ FieldCleanup: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to StepsItem");
  END
  panic("Invalid cast to StepsItem");
END
FN castOptionalStepsItemToBinding(value: ?StepsItem) RETURNS Binding ->
  IF value != NIL THEN
    IF value IS_A Binding AS cast_payload THEN
      RETURN cast_payload;
    END
  END
  RETURN panic("Invalid cast to Binding");
END
