PUB FN clearParser__parse_comptime_statement(MUTABLE self: ClearParser) RETURNS !ClearParserReturnValue
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "COMPTIME"));
    IF !(clearParser__match?(rtoc_self_view, :KEYWORD, "IF")) THEN
      clearParser__error_mut(rtoc_self_view, clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :PARSER_EXPECTED }, [], {:expected: "IF", :got: "${token__display_value(clearParser__current(rtoc_self_view))}", :type: "${clearParser__current(rtoc_self_view).type}", :line: clearParser__current(rtoc_self_view).line.toString()});
    END
    RETURN TRY (clearParser__parse_if_statement(&rtoc_self_view, TRUE));
}
END
PUB FN clearParser__parse_if_statement(MUTABLE self: ClearParser, is_comptime: Bool = FALSE) RETURNS !ClearParserReturnValue
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE if_token = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "IF"));
    RETURN TRY (clearParser__parse_if_chain(&rtoc_self_view, if_token, is_comptime));
}
END
PRIVATE FN clearParser__parse_if_chain(MUTABLE self: ClearParser, if_token: Token, is_comptime: Bool = FALSE) RETURNS !ClearParserReturnValue
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF clearParser__conditional_capture_ahead?(rtoc_self_view) THEN
      RETURN TRY (clearParser__parse_refined_if_chain(&rtoc_self_view, if_token, is_comptime));
    END
    MUTABLE condition = TRY (clearParser__parse_expression(&rtoc_self_view));
    IF clearParser__match?(rtoc_self_view, :ARROW, "->") THEN
      TRY (clearParser__consume(&rtoc_self_view, :ARROW, "->"));
      MUTABLE stmt = TRY (clearParser__parse_statement(&rtoc_self_view));
      MUTABLE node = IfStatement{ token: COPY if_token, condition: COPY condition, then_branch: COPY [stmt], else_branch: COPY List[], then_drops: NIL, else_drops: NIL, comptime: FALSE, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, expr_mode: NIL, then_result_type: NIL, else_result_type: NIL };
      node.comptime = COPY is_comptime;
      RETURN ClearParserReturnValue{ IfStatement: COPY node };
    END
    IF clearParser__match?(rtoc_self_view, :KEYWORD, "AS") THEN
      clearParser__emit_legacy_optional_binding_mut(rtoc_self_view, clearParser__current(rtoc_self_view));
      TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "AS"));
      MUTABLE name_tok = TRY (clearParser__consume(&rtoc_self_view, :VAR_ID));
      IF (clearParser__match?(rtoc_self_view, :KEYWORD, "AND") OR clearParser__match?(rtoc_self_view, :LEGACY_LOGICAL, "&&")) THEN
        clearParser__error_mut(rtoc_self_view, if_token, CodeOrMessage{ SymbolValue: :MULTIPLE_BINDINGS_NEED_PARENS });
      END
      MUTABLE bindings = [Binding{ expr: COPY condition, name: COPY TRY (token__text_mut(name_tok)), name_token: name_tok, unwrapped_type: type__new(TypeConstructionInput{ SymbolValue: :Untyped }), symbol: NIL, capture: NIL, predicate: :exists, mir_binding_entry: NIL }];
      RETURN ClearParserReturnValue{ IfBind: COPY TRY (clearParser__parse_if_bind_body(&rtoc_self_view, if_token, bindings)) };
    END
    TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "THEN"));
    MUTABLE then_branch = TRY (clearParser__parse_block_body(&rtoc_self_view, ["ELSE", "ELSE_IF", "END"]));
    MUTABLE else_branch: []Locatable = List[];
    IF castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :KEYWORD, "ELSE_IF"))) THEN
      MUTABLE nested_if = TRY (clearParser__parse_if_chain(&rtoc_self_view, clearParser__previous(rtoc_self_view), is_comptime));
      &else_branch.append(castClearParserReturnValueToLocatable(nested_if));
    ELSE_IF castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :KEYWORD, "ELSE"))) THEN
      else_branch = TRY (clearParser__parse_block_body(&rtoc_self_view, ["END"]));
      TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "END"));
    ELSE
      TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "END"));
    END
    MUTABLE node = IfStatement{ token: COPY if_token, condition: COPY condition, then_branch: COPY then_branch, else_branch: COPY else_branch, then_drops: NIL, else_drops: NIL, comptime: FALSE, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, expr_mode: NIL, then_result_type: NIL, else_result_type: NIL };
    node.comptime = COPY is_comptime;
    RETURN ClearParserReturnValue{ IfStatement: COPY node };
}
END
PRIVATE FN clearParser__parse_refined_if_chain(MUTABLE self: ClearParser, if_token: Token, is_comptime: Bool = FALSE) RETURNS !ClearParserReturnValue
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE steps: []StepsItem = List[];
    WHILE TRUE DO
      MUTABLE atom = TRY (clearParser__parse_expression(&rtoc_self_view, 5));
      IF TRY (clearParser__conditional_binding_predicate?(rtoc_self_view)) THEN
        &steps.append(StepsItem{ Binding: TRY (clearParser__parse_conditional_binding(&rtoc_self_view, atom)) });
      ELSE
        MUTABLE rtoc_atom_steps = TRY (clearParser__refinement_steps(rtoc_self_view, atom, if_token));
        rtoc_atom_steps |> EACH { &steps.append(COPY _); };
      END
      IF !((clearParser__match?(rtoc_self_view, :KEYWORD, "AND") OR clearParser__match?(rtoc_self_view, :KEYWORD, "OR"))) THEN
        BREAK;
      END
      MUTABLE operator = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD));
      IF (token__text_is?(operator, "OR")) THEN
        clearParser__error_mut(rtoc_self_view, operator, CodeOrMessage{ SymbolValue: :CONDITIONAL_BINDING_UNDER_OR });
      END
    END
    IF clearParser__match?(rtoc_self_view, :ARROW, "->") THEN
      TRY (clearParser__consume(&rtoc_self_view, :ARROW, "->"));
      MUTABLE stmt = TRY (clearParser__parse_statement(&rtoc_self_view));
      RETURN clearParser__build_refined_if_tree(rtoc_self_view, if_token, steps, ([stmt]), List[], is_comptime);
    END
    TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "THEN"));
    MUTABLE then_branch = TRY (clearParser__parse_block_body(&rtoc_self_view, ["ELSE", "ELSE_IF", "END"]));
    MUTABLE else_branch: []Locatable = List[];
    IF castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :KEYWORD, "ELSE_IF"))) THEN
      &else_branch.append(castClearParserReturnValueToNode(TRY (clearParser__parse_if_chain(&rtoc_self_view, clearParser__previous(rtoc_self_view), is_comptime))));
    ELSE_IF castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :KEYWORD, "ELSE"))) THEN
      else_branch = TRY (clearParser__parse_block_body(&rtoc_self_view, ["END"]));
      TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "END"));
    ELSE
      TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "END"));
    END
    RETURN clearParser__build_refined_if_tree(rtoc_self_view, if_token, steps, then_branch, else_branch, is_comptime);
}
END
PRIVATE FN clearParser__conditional_capture_ahead?(self: ClearParser) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE offset: Int64 = 0;
    MUTABLE depth: Int64 = 0;
    WHILE TRUE DO
      MUTABLE token: ?Token = clearParser__peek_at(rtoc_self_view, offset);
      IF token EXISTS AS token_value THEN
        MUTABLE token_value_mutable = COPY token_value;
        IF (token_value_mutable.type == :CHAR) THEN
          IF "([{".contains?(TRY (token__text_mut(token_value_mutable))) THEN
            depth = (depth + 1);
          END
          IF ")]}".contains?(TRY (token__text_mut(token_value_mutable))) THEN
            depth = (depth - 1);
          END
        END
        IF ((depth == 0) AND ((((((token_value_mutable.type == :KEYWORD) AND (["THEN", "ELSE", "END"]).contains?(token__display_value(token_value_mutable)))) OR (token_value_mutable.type == :ARROW)) OR (token_value_mutable.type == :EOF)))) THEN
          RETURN FALSE;
        END
        IF ((token_value_mutable.type == :KEYWORD) AND (["EXISTS", "IS_OK"]).contains?(token__display_value(token_value_mutable))) THEN
          MUTABLE following: ?Token = clearParser__peek_at(rtoc_self_view, (offset + 1));
          IF (((following != NIL) AND (following.type == :KEYWORD)) AND (token__text_is?(following, "AS"))) THEN
            RETURN TRUE;
          END
        END
        offset = (offset + 1);
      ELSE
        RETURN FALSE;
      END
    END
    RETURN FALSE;
}
END
PRIVATE FN clearParser__refinement_steps(self: ClearParser, node: Locatable, if_token: Token) RETURNS ![]StepsItem
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A BinaryOp AS binary_op THEN
      IF (binary_op.op == :BIND_VAR) THEN
        MUTABLE right: Identifier = UNWRAP (aST__root_identifier(binary_op.right));
        MUTABLE predicate = IF (token__text_is?(binary_op.token, "IS_OK")) THEN
          :is_ok
        ELSE
          :exists
        END;
        RETURN [StepsItem{ Binding: COPY Binding{ expr: COPY binary_op.left, name: COPY right.name, name_token: right.token, predicate: COPY predicate, unwrapped_type: type__new(TypeConstructionInput{ SymbolValue: :Untyped }), symbol: NIL, capture: NIL, mir_binding_entry: NIL } }];
      END
      IF ((binary_op.op == symbol("OR")) AND clearParser__contains_refinement_binding?(rtoc_self_view, Locatable{ BinaryOp: COPY binary_op })) THEN
        clearParser__error_mut(rtoc_self_view, binary_op.token, CodeOrMessage{ SymbolValue: :CONDITIONAL_BINDING_UNDER_OR });
      END
      IF !((binary_op.op == symbol("AND"))) THEN
        RETURN [StepsItem{ BinaryOp: COPY binary_op }];
      END
      RETURN ruby_array_concat_StepsItem(TRY (clearParser__refinement_steps(rtoc_self_view, binary_op.left, if_token)), TRY (clearParser__refinement_steps(rtoc_self_view, binary_op.right, if_token)));
    ELSE
      RETURN [castLocatableToStepsItem(node)];
    END
}
END
PRIVATE FN clearParser__contains_refinement_binding?(self: ClearParser, node: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A BinaryOp AS binary_op THEN
      IF (binary_op.op == :BIND_VAR) THEN
        RETURN TRUE;
      END
      RETURN (clearParser__contains_refinement_binding?(rtoc_self_view, binary_op.left) OR clearParser__contains_refinement_binding?(rtoc_self_view, binary_op.right));
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN clearParser__build_refined_if_tree(self: ClearParser, if_token: Token, steps: []StepsItem, then_branch: []Locatable, else_branch: []Locatable, is_comptime: Bool) RETURNS ClearParserReturnValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE body: []Locatable = COPY then_branch;
    MUTABLE index = (steps.length - 1);
    WHILE (index >= 0) DO
      MUTABLE step = COPY UNWRAP (steps[index]);
      MUTABLE nested_branch_value: ?Locatable = NIL;
      IF step IS_A Binding AS binding THEN
        MUTABLE bindings: []Binding = List[];
        MUTABLE run_start = index;
        WHILE (run_start >= 0) DO
          MUTABLE candidate: ?StepsItem = steps[run_start];
          IF candidate EXISTS AS candidate_step THEN
            IF candidate_step IS_A Binding THEN
              run_start = (run_start - 1);
            ELSE
              BREAK;
            END
          ELSE
            BREAK;
          END
        END
        MUTABLE walk = (run_start + 1);
        WHILE (walk <= index) DO
          MUTABLE forward: ?StepsItem = steps[walk];
          IF forward EXISTS AS forward_step THEN
            IF forward_step IS_A Binding AS nested_binding THEN
              &bindings.append(COPY nested_binding);
            END
          END
          walk = (walk + 1);
        END
        index = run_start;
        nested_branch_value = Locatable{ IfBind: IfBind{ token: COPY if_token, bindings: COPY bindings, then_branch: body, else_branch: COPY else_branch, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL } };
      ELSE
        MUTABLE item = IfStatement{ token: COPY if_token, condition: castStepsItemToLocatable(COPY step), then_branch: COPY body, else_branch: COPY else_branch, then_drops: NIL, else_drops: NIL, comptime: FALSE, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, expr_mode: NIL, then_result_type: NIL, else_result_type: NIL };
        item.comptime = COPY is_comptime;
        index = (index - 1);
        nested_branch_value = Locatable{ IfStatement: item };
      END
      MUTABLE nested: Locatable = UNWRAP (nested_branch_value);
      clearParser__stamp_source_range_mut(rtoc_self_view, COPY nested, if_token, clearParser__previous(rtoc_self_view));
      body = [COPY nested];
    END
    RETURN castLocatableToClearParserReturnValue(UNWRAP (body[0]));
}
END
PRIVATE FN clearParser__conditional_binding_predicate?(self: ClearParser) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (clearParser__match?(rtoc_self_view, :KEYWORD, "EXISTS") OR clearParser__match?(rtoc_self_view, :KEYWORD, "IS_OK"));
}
END
PRIVATE FN clearParser__parse_conditional_binding(MUTABLE self: ClearParser, expr: Locatable) RETURNS !Binding
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE predicate_tok = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD));
    MUTABLE predicate = IF (token__text_is?(predicate_tok, "IS_OK")) THEN
      :is_ok
    ELSE
      :exists
    END;
    TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "AS"));
    MUTABLE name_tok = TRY (clearParser__consume(&rtoc_self_view, :VAR_ID));
    RETURN Binding{ expr: COPY expr, name: COPY TRY (token__text_mut(name_tok)), name_token: name_tok, predicate: COPY predicate, unwrapped_type: type__new(TypeConstructionInput{ SymbolValue: :Untyped }), symbol: NIL, capture: NIL, mir_binding_entry: NIL };
}
END
PRIVATE FN clearParser__parse_if_bind_body(MUTABLE self: ClearParser, if_token: Token, bindings: []Binding) RETURNS !IfBind
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "THEN"));
