END
PUB FN clearParser__parse_element_capability(MUTABLE self: ClearParser) RETURNS !ElementCapability
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE result = ElementCapability{ ownership: NIL, sync: NIL, layout: NIL };
    rtoc_cur_3 = clearParser__current(rtoc_self_view);
    IF !((clearParser__match?(rtoc_self_view, :VAR_ID) AND element_capability_tokens.contains?(token__display_value(rtoc_cur_3)))) THEN
      RETURN result;
