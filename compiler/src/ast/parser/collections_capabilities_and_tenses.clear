PUB FN clearParser__parse_capabilities(MUTABLE self: ClearParser) RETURNS !CapabilityParseResult
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE result = CapabilityParseResult{ ownership: NIL, sync: NIL, collection: NIL, is_soa: FALSE, is_indirect: FALSE, shard_count: NIL, observable: FALSE, observable_token: NIL };
    rtoc_cur_0 = clearParser__current(rtoc_self_view);
    IF !((clearParser__match?(rtoc_self_view, :VAR_ID) AND capability_tokens.contains?(token__display_value(rtoc_cur_0)))) THEN
      RETURN result;
    END
    MUTABLE capability_token = TRY (clearParser__consume(&rtoc_self_view, :VAR_ID));
    clearParser__apply_capability_mut(&rtoc_self_view, &result, capability_token, TRY (token__text_mut(capability_token)));
    MUTABLE no_restriction: []String = List[];
    clearParser__parse_capability_chain_mut(&rtoc_self_view, &result, no_restriction, NIL, FALSE);
    RETURN result;
}
END
PUB FN clearParser__parse_constructor_capabilities(MUTABLE self: ClearParser, type_token: Token, constructor_name: String) RETURNS !CapabilityParseResult
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE result = CapabilityParseResult{ ownership: NIL, sync: NIL, collection: NIL, is_soa: FALSE, is_indirect: FALSE, shard_count: NIL, observable: FALSE, observable_token: NIL };
    rtoc_cur_1 = clearParser__current(rtoc_self_view);
    IF !((((clearParser__match?(rtoc_self_view, :VAR_ID) AND capability_tokens.contains?(token__display_value(rtoc_cur_1)))) OR clearParser__match?(rtoc_self_view, :CHAR, ":"))) THEN
      RETURN result;
    END
    MUTABLE allowed = ["@soa", "@sharded"];
    MUTABLE cap_tok = Token{ type: :VAR_ID, value: TokenValue{ StringValue: COPY "@${constructor_name.downcase()}" }, line: type_token.line, column: type_token.column, file: NIL, start_offset: NIL, end_offset: NIL, end_line: NIL, end_column: NIL };
    IF clearParser__match?(rtoc_self_view, :VAR_ID) THEN
      MUTABLE tok = TRY (clearParser__consume(&rtoc_self_view, :VAR_ID));
      MUTABLE normalized: String = "";
      IF (TRY (token__text_mut(tok))).startsWith?("@") THEN
        normalized = TRY (token__text_mut(tok));
      ELSE
        normalized = "@${TRY (token__text_mut(tok))}";
      END
      IF !(allowed.contains?(normalized)) THEN
        clearParser__error_mut(rtoc_self_view, tok, CodeOrMessage{ SymbolValue: :CAP_BAD_MODIFIER }, [], {:cap: "${TRY (token__text_mut(cap_tok))}", :modifier: "${TRY (token__text_mut(tok))}"});
      END
      clearParser__apply_capability_mut(&rtoc_self_view, &result, tok, normalized, TRUE);
    END
    clearParser__parse_capability_chain_mut(&rtoc_self_view, &result, allowed, cap_tok, TRUE);
    RETURN result;
}
END
PRIVATE FN clearParser__parse_capability_chain_mut(MUTABLE self: ClearParser, MUTABLE result: CapabilityParseResult, allowed_values: []String, cap_tok: ?Token, validate_shard_count: Bool) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    WHILE clearParser__match?(rtoc_self_view, :CHAR, ":") DO
      clearParser__consume(&rtoc_self_view, :CHAR, ":");
      rtoc_cur_2 = clearParser__current(rtoc_self_view);
      IF !((rtoc_cur_2.type == :VAR_ID)) THEN
        clearParser__error_mut(rtoc_self_view, clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :EXPECTED_CAP_AFTER_COLON });
      END
      MUTABLE tok = TRY (clearParser__consume(&rtoc_self_view, :VAR_ID));
      MUTABLE normalized_value: String = "";
      IF (TRY (token__text_mut(tok))).startsWith?("@") THEN
        normalized_value = TRY (token__text_mut(tok));
      ELSE
        normalized_value = "@${TRY (token__text_mut(tok))}";
      END
      IF (!((allowed_values.length() == 0)) AND !(allowed_values.contains?(normalized_value))) THEN
        MUTABLE cap_label: String = "capability";
        IF cap_tok EXISTS AS cap_token THEN
          MUTABLE cap_token_mutable = COPY cap_token;
          cap_label = TRY (token__text_mut(cap_token_mutable));
        END
        clearParser__error_mut(rtoc_self_view, tok, CodeOrMessage{ SymbolValue: :CAP_BAD_MODIFIER }, [], {:cap: "${cap_label}", :modifier: "${TRY (token__text_mut(tok))}"});
      END
      clearParser__apply_capability_mut(&rtoc_self_view, &result, tok, normalized_value, validate_shard_count);
