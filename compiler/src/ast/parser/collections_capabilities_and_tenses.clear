FN clearParser__parse_snapshot_block(MUTABLE self: ClearParser, with_token: Token) RETURNS !?WithBlock
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE capabilities: []Capability = List[];
    MUTABLE any_mutable: Bool = FALSE;
    WHILE TRUE DO
      MUTABLE snapshot_tok = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "SNAPSHOT"));
      MUTABLE var_node = TRY (clearParser__parse_var_id(&rtoc_self_view));
      clearParser__consume(&rtoc_self_view, :KEYWORD, "AS");
      MUTABLE alias_mutable = FALSE;
      IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "MUTABLE")) THEN
        alias_mutable = TRUE;
      END
      MUTABLE alias_name = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :VAR_ID)));
      &capabilities.append(Capability{ capability: symbol("SNAPSHOT"), var_node: var_node, alias_value: COPY alias_name, alias_mutable: alias_mutable, snapshot_token: snapshot_tok, guard_expr: NIL, view_token: NIL, view_length: NIL, as_token: NIL, resolved_type: type__new(TypeConstructionInput{ SymbolValue: :Untyped }), old_scope: NIL });
      any_mutable = (any_mutable OR alias_mutable);
      IF !(castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, ","))) THEN
        BREAK;
      END
    END
    IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "MATCH")) THEN
      MUTABLE arms = TRY (clearParser__parse_with_match_arms(&rtoc_self_view));
      clearParser__consume(&rtoc_self_view, :KEYWORD, "END");
      MUTABLE node = WithBlock{ token: COPY with_token, capabilities: COPY capabilities, body: COPY List[], deferred_drops: NIL, capability_plan: NIL, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, lock_error_clause: NIL, deadlock_escape: NIL, view_kind: NIL, snapshot_mode: NIL, polymorphic: NIL, universal_poly: NIL, arms: NIL };
      node.arms = arms;
      node.snapshot_mode = IF any_mutable THEN
        :transaction
      ELSE
        :read
      END;
      RETURN node;
    END
    MUTABLE body = TRY (clearParser__parse_brace_block(&rtoc_self_view));
    MUTABLE clause: ?ErrorClause = TRY (clearParser__parse_lock_error_clause(&rtoc_self_view));
    MUTABLE node = WithBlock{ token: COPY with_token, capabilities: COPY capabilities, body: COPY body, deferred_drops: NIL, capability_plan: NIL, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, lock_error_clause: NIL, deadlock_escape: NIL, view_kind: NIL, snapshot_mode: NIL, polymorphic: NIL, universal_poly: NIL, arms: NIL };
    node.snapshot_mode = IF any_mutable THEN
      :transaction
    ELSE
      :read
    END;
    node.lock_error_clause = clause;
    RETURN node;
}
END
FN clearParser__parse_view_block(MUTABLE self: ClearParser, with_token: Token) RETURNS !WithBlock
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE body: []Locatable = List[];
    MUTABLE capability: String@symbol = symbol("VIEW");
    MUTABLE view_kind: ?String@symbol = NIL;
    MUTABLE view_token: ?Token = NIL;
    MUTABLE view_length: ?Locatable = NIL;
    IF clearParser__match?(rtoc_self_view, :KEYWORD, "UNSAFE") THEN
      view_token = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "UNSAFE"));
      clearParser__consume(&rtoc_self_view, :KEYWORD, "VIEW");
      view_kind = :unsafe_view;
      capability = :UNSAFE_VIEW;
    ELSE_IF clearParser__match?(rtoc_self_view, :KEYWORD, "MATERIALIZED") THEN
      MUTABLE mat_tok = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "MATERIALIZED"));
      view_token = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "VIEW"));
      view_kind = :materialized_view;
      capability = :MATERIALIZED_VIEW;
      view_token = mat_tok;
    ELSE
      view_token = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "VIEW"));
      view_kind = :view;
      capability = symbol("VIEW");
    END
    MUTABLE var_node = TRY (clearParser__parse_var_id(&rtoc_self_view));
    IF (view_kind == :unsafe_view) THEN
      clearParser__consume(&rtoc_self_view, :KEYWORD, "LENGTH");
      view_length = TRY (clearParser__parse_expression(&rtoc_self_view, 2));
    END
    MUTABLE as_token = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "AS"));
    MUTABLE alias_name = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :VAR_ID)));
    IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :ARROW, "->")) THEN
      body = TRY (clearParser__parse_block_body(&rtoc_self_view, ["END"]));
      clearParser__consume(&rtoc_self_view, :KEYWORD, "END");
    ELSE
      body = TRY (clearParser__parse_brace_block(&rtoc_self_view));
    END
    MUTABLE node = WithBlock{ token: COPY with_token, capabilities: [Capability{ capability: COPY capability, var_node: var_node, alias_value: COPY alias_name, alias_mutable: FALSE, view_token: view_token, view_length: view_length, as_token: as_token, guard_expr: NIL, snapshot_token: NIL, resolved_type: type__new(TypeConstructionInput{ SymbolValue: :Untyped }), old_scope: NIL }], body: COPY body, deferred_drops: NIL, capability_plan: NIL, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, lock_error_clause: NIL, deadlock_escape: NIL, view_kind: NIL, snapshot_mode: NIL, polymorphic: NIL, universal_poly: NIL, arms: NIL };
    node.view_kind = view_kind;
    RETURN node;
}
END
FN clearParser__parse_with_match_arms(MUTABLE self: ClearParser) RETURNS ![]WithMatchArm
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE arms: []WithMatchArm = List[];
    WHILE clearParser__match?(rtoc_self_view, :KEYWORD, "WHEN") DO
      MUTABLE when_tok = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "WHEN"));
      MUTABLE family = TRY (clearParser__parse_requires_family(&rtoc_self_view));
      clearParser__consume(&rtoc_self_view, :ARROW, "->");
      MUTABLE body = TRY (clearParser__parse_brace_block(&rtoc_self_view));
      MUTABLE lock_error_clauses: []ErrorClause = List[];
      WHILE (clearParser__match?(rtoc_self_view, :KEYWORD, "ON") OR clearParser__match?(rtoc_self_view, :KEYWORD, "RETRY")) DO
        MUTABLE clause: ?ErrorClause = TRY (clearParser__parse_lock_error_clause(&rtoc_self_view));
        IF clause EXISTS AS clause_value THEN
          &lock_error_clauses.append(COPY clause_value);
        END
      END
      &arms.append(WithMatchArm{ family: COPY family, body: COPY body, lock_error_clauses: COPY lock_error_clauses, token: when_tok });
    END
    IF (arms.length() == 0) THEN
      clearParser__error_mut(rtoc_self_view, clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :WITH_MATCH_NO_WHEN });
    END
    RETURN arms;
}
END
FN clearParser__parse_sync_policy_block(MUTABLE self: ClearParser) RETURNS !SyncPolicyDecl
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE sync_tok = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "SYNC"));
    clearParser__consume(&rtoc_self_view, :KEYWORD, "POLICY");
    clearParser__consume(&rtoc_self_view, :KEYWORD, "START");
    MUTABLE handlers: []ErrorClause = List[];
    WHILE (clearParser__match?(rtoc_self_view, :KEYWORD, "ON") OR clearParser__match?(rtoc_self_view, :KEYWORD, "RETRY")) DO
      MUTABLE clause: ?ErrorClause = TRY (clearParser__parse_lock_error_clause(&rtoc_self_view));
      IF clause EXISTS AS clause_value THEN
        &handlers.append(COPY clause_value);
      END
    END
    IF (handlers.length() == 0) THEN
      clearParser__error_mut(rtoc_self_view, clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :SYNC_POLICY_NO_HANDLER });
    END
    clearParser__consume(&rtoc_self_view, :KEYWORD, "END");
    RETURN SyncPolicyDecl{ token: COPY sync_tok, handlers: handlers, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
}
END
FN clearParser__parse_lock_error_clause(MUTABLE self: ClearParser) RETURNS !?ErrorClause
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF clearParser__match?(rtoc_self_view, :KEYWORD, "ON") THEN
      clearParser__consume(&rtoc_self_view, :KEYWORD, "ON");
      MUTABLE selectors = TRY (clearParser__parse_error_selectors(&rtoc_self_view));
      MUTABLE retries: ?Int64 = TRY (clearParser__match_optional_retry_mut(&rtoc_self_view));
      MUTABLE action = TRY (clearParser__parse_lock_action(&rtoc_self_view));
      RETURN errorClause__from_action(selectors, retries, action);
    ELSE_IF clearParser__match?(rtoc_self_view, :KEYWORD, "RETRY") THEN
      MUTABLE retries: ?Int64 = TRY (clearParser__match_optional_retry_mut(&rtoc_self_view));
      MUTABLE action = TRY (clearParser__parse_lock_action(&rtoc_self_view));
      RETURN errorClause__from_action([ErrorSelector{ form: :kind, name: :Transient, token: COPY action.token }], retries, action);
    ELSE
      RETURN NIL;
    END
}
END
FN clearParser__match_optional_retry_mut(MUTABLE self: ClearParser) RETURNS !?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "RETRY"))) THEN
      RETURN NIL;
    END
    clearParser__consume(&rtoc_self_view, :CHAR, "(");
    MUTABLE tok = TRY (clearParser__consume_number(&rtoc_self_view));
    MUTABLE n = TRY (token__number_as_integer(tok));
    IF (n <= 0) THEN
      clearParser__error_mut(rtoc_self_view, tok, CodeOrMessage{ SymbolValue: :RETRY_N_NONPOSITIVE }, [], {:got: "${n.toString()}"});
    END
    clearParser__consume(&rtoc_self_view, :CHAR, ")");
    clearParser__consume(&rtoc_self_view, :KEYWORD, "THEN");
    RETURN n;
}
END
FN clearParser__parse_error_selectors(MUTABLE self: ClearParser) RETURNS ![]ErrorSelector
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE selectors: []ErrorSelector = List[];
    &selectors.append(TRY (clearParser__parse_error_selector(&rtoc_self_view)));
    WHILE castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, ",")) DO
      &selectors.append(clearParser__parse_error_selector(&rtoc_self_view));
    END
    RETURN selectors;
}
END
FN clearParser__parse_error_selector(MUTABLE self: ClearParser) RETURNS !ErrorSelector
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(clearParser__match?(rtoc_self_view, :TYPE_ID)) THEN
      clearParser__error_mut(rtoc_self_view, clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :EXPECTED_ERROR_SELECTOR });
    END
    MUTABLE tok = TRY (clearParser__consume(&rtoc_self_view, :TYPE_ID));
    MUTABLE rtoc_kind_names = ruby_constant_error_kinds() |> SELECT _.toString();
    MUTABLE rtoc_tok_text = TRY (token__text_mut(tok));
    MUTABLE form = IF rtoc_kind_names.contains?(rtoc_tok_text) THEN
      :kind
    ELSE
      :type
    END;
    RETURN ErrorSelector{ form: COPY form, name: COPY symbol((TRY (token__text_mut(tok)))), token: tok };
}
END
FN clearParser__parse_lock_action(MUTABLE self: ClearParser) RETURNS !ErrorAction
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "RAISE")) THEN
      RETURN ErrorAction{ action: COPY ErrorActionKind.Raise, token: clearParser__previous(rtoc_self_view), value: NIL, message: NIL, body: List[] };
    ELSE_IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "PASS")) THEN
      RETURN ErrorAction{ action: COPY ErrorActionKind.Pass, token: clearParser__previous(rtoc_self_view), value: NIL, message: NIL, body: List[] };
    ELSE_IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "RETURN")) THEN
      MUTABLE tok = clearParser__previous(rtoc_self_view);
      MUTABLE value = TRY (clearParser__parse_expression(&rtoc_self_view));
      RETURN ErrorAction{ action: COPY ErrorActionKind.Return, value: COPY value, token: tok, message: NIL, body: List[] };
    ELSE_IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "EXIT")) THEN
      tok = clearParser__previous(rtoc_self_view);
      MUTABLE msg = TRY (clearParser__parse_expression(&rtoc_self_view));
      RETURN ErrorAction{ action: COPY ErrorActionKind.Exit, message: COPY msg, token: tok, value: NIL, body: List[] };
    ELSE_IF clearParser__match?(rtoc_self_view, :ARROW, "->") THEN
      tok = TRY (clearParser__consume(&rtoc_self_view, :ARROW, "->"));
      MUTABLE body = TRY (clearParser__parse_brace_block(&rtoc_self_view));
      RETURN ErrorAction{ action: COPY ErrorActionKind.Block, body: COPY body, token: tok, value: NIL, message: NIL };
    ELSE
      TRY (clearParser__error_mut(rtoc_self_view, clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :EXPECTED_AFTER_ERROR_CLAUSE }));
      panic("clearParser__error_mut raises");
    END
}
END
FN clearParser__parse_cap_join(MUTABLE self: ClearParser, tok: Token, first_attrs: SigilAttrs) RETURNS !CapJoin
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE dims = CapJoin{ ownership: NIL, sync: NIL, layout: NIL, lock_rank: NIL };
    TRY (clearParser__apply_cap_dim_mut(rtoc_self_view, tok, first_attrs, &dims));
    clearParser__parse_lock_rank_arg_mut(&rtoc_self_view, tok, first_attrs, &dims);
    WHILE clearParser__match?(rtoc_self_view, :CHAR, ":") DO
      clearParser__consume(&rtoc_self_view, :CHAR, ":");
      rtoc_cur_4 = clearParser__current(rtoc_self_view);
      IF !((rtoc_cur_4.type == :VAR_ID)) THEN
        clearParser__error_mut(rtoc_self_view, clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :EXPECTED_CAP_SIGIL_AFTER_COLON });
      END
      MUTABLE normalized: String = "";
      rtoc_cur_5 = clearParser__current(rtoc_self_view);
      IF token__display_value(rtoc_cur_5).startsWith?("@") THEN
        normalized = token__display_value(clearParser__current(rtoc_self_view));
      ELSE
        normalized = "@${token__display_value(clearParser__current(rtoc_self_view))}";
      END
      MUTABLE attrs: ?SigilAttrs = COPY (clearParser__cap_sigil_attrs())[normalized];
      IF (attrs == NIL) THEN
        MUTABLE has_at = token__display_value(clearParser__current(rtoc_self_view)).startsWith?("@");
        MUTABLE candidates: []String = List[];
        IF has_at THEN
          candidates = (clearParser__cap_sigil_attrs()).keys();
        ELSE
          candidates = (clearParser__cap_sigil_attrs()).keys() |> SELECT regexReplaceFirst(_, "^@", "");
        END
        clearParser__emit_typo_suggestion_mut(rtoc_self_view, clearParser__current(rtoc_self_view), token__display_value(clearParser__current(rtoc_self_view)), candidates, "Unknown capability sigil '${token__display_value(clearParser__current(rtoc_self_view))}'", "closest capability sigil", :capability, TRUE);
      END
      MUTABLE attrs_value: SigilAttrs = attrs?;
      MUTABLE next_tok = TRY (clearParser__consume(&rtoc_self_view, :VAR_ID));
      clearParser__emit_boxed_capability_migration(rtoc_self_view, next_tok);
      TRY (clearParser__apply_cap_dim_mut(rtoc_self_view, next_tok, attrs_value, &dims));
      clearParser__parse_lock_rank_arg_mut(&rtoc_self_view, next_tok, attrs_value, &dims);
    END
    rtoc_cur_6 = clearParser__current(rtoc_self_view);
    IF ((clearParser__match?(rtoc_self_view, :VAR_ID) AND token__display_value(rtoc_cur_6).startsWith?("@")) AND (clearParser__cap_sigil_attrs()).contains?(token__display_value(rtoc_cur_6))) THEN
      clearParser__error_mut(rtoc_self_view, clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :MIXED_AT_CAPABILITIES });
    END
    RETURN dims;
}
END
FN clearParser__apply_cap_dim_mut(self: ClearParser, tok: Token, attrs: SigilAttrs, MUTABLE dims: CapJoin) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE dim: ?String@symbol = COPY attrs.dim;
    MUTABLE val: ?String@symbol = COPY attrs.val;
    IF dim EXISTS AS dim_value THEN
      IF !((val == NIL)) THEN
        MUTABLE current_value_branch_value: ?String@symbol = NIL;
        PARTIAL MATCH dim_value START
          :ownership ->
          current_value_branch_value = COPY dims.ownership;,
          :sync ->
          current_value_branch_value = COPY dims.sync;,
          :layout ->
          current_value_branch_value = COPY dims.layout;,
          DEFAULT ->
          RETURN NIL;
        END
        MUTABLE current_value: ?String@symbol = current_value_branch_value;
        IF ((dim_value == :ownership) AND (((((current_value == :shared) AND (val == :node))) OR (((current_value == :node) AND (val == :shared)))))) THEN
          dims.ownership = :shared_node;
          RETURN :shared_node;
        END
        IF current_value EXISTS AS current_value_value THEN
          clearParser__error_mut(rtoc_self_view, tok, CodeOrMessage{ SymbolValue: :DUPLICATE_CAPABILITY_DIM }, [], {:dim: "${dim_value}", :current: "${current_value_value}", :attempted: "${val}"});
        END
        IF (dim_value == :ownership) THEN
          dims.ownership = val;
        ELSE_IF (dim_value == :sync) THEN
          dims.sync = val;
        ELSE_IF (dim_value == :layout) THEN
          dims.layout = val;
        END
        RETURN val;
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
FN clearParser__parse_lock_rank_arg_mut(MUTABLE self: ClearParser, sigil_tok: Token, attrs: SigilAttrs, MUTABLE dims: CapJoin) RETURNS !?Int64
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !((attrs.dim == :sync)) THEN
      RETURN NIL;
    END
    IF !(((attrs.val == :locked) OR (attrs.val == :write_locked))) THEN
      RETURN NIL;
    END
    IF !(clearParser__match?(rtoc_self_view, :CHAR, "(")) THEN
      RETURN NIL;
    END
    clearParser__consume(&rtoc_self_view, :CHAR, "(");
    IF !(clearParser__match?(rtoc_self_view, :VAR_ID, "rank")) THEN
      clearParser__error_mut(rtoc_self_view, clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :EXPECTED_RANK_KEYWORD }, [], {:sigil: "${attrs.val OR_ELSE ""}"});
    END
    clearParser__consume(&rtoc_self_view, :VAR_ID, "rank");
    clearParser__consume(&rtoc_self_view, :CHAR, ":");
    MUTABLE neg = TRY (clearParser__match_mut(&rtoc_self_view, :CHAR, "-"));
    MUTABLE num_tok = TRY (clearParser__consume_number(&rtoc_self_view));
    MUTABLE rank = TRY (token__number_as_integer(num_tok));
    IF castClearParserReturnValueToBool(neg) THEN
      rank = (-rank);
    END
    clearParser__consume(&rtoc_self_view, :CHAR, ")");
    IF dims.lock_rank EXISTS AS lock_rank_value THEN
      clearParser__error_mut(rtoc_self_view, sigil_tok, CodeOrMessage{ SymbolValue: :DUPLICATE_LOCK_RANK }, [], {:current: "${lock_rank_value.toString()}", :attempted: "${rank.toString()}"});
    END
    dims.lock_rank = rank;
    RETURN rank;
}
END
FN clearParser__parse_task_prefix(MUTABLE self: ClearParser, sigils: {String}SigilAttrs, kind: String, prefix_label: String, suggestion_label: String) RETURNS !TaskPrefix
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE pinned: Bool = FALSE;
    MUTABLE parallel: Bool = FALSE;
    MUTABLE arena: Bool = FALSE;
    MUTABLE can_smash: Bool = FALSE;
    MUTABLE stack_size: ?String@symbol = NIL;
    MUTABLE stack_size_token: ?Token = NIL;
    MUTABLE can_smash_token: ?Token = NIL;
    MUTABLE looks_like_sigil = ((clearParser__current(rtoc_self_view).type == :VAR_ID) AND token__display_value(clearParser__current(rtoc_self_view)).startsWith?("@"));
    IF !(looks_like_sigil) THEN
      RETURN TaskPrefix{ pinned: pinned, parallel: parallel, stack_size: COPY NIL, arena: arena, can_smash: can_smash, stack_size_token: NIL, can_smash_token: NIL };
    END
    WHILE TRUE DO
      MUTABLE tok = TRY (clearParser__consume(&rtoc_self_view, :VAR_ID));
      MUTABLE token_text = TRY (token__text_mut(tok));
      MUTABLE cap_name: String = "";
      IF token_text.startsWith?("@") THEN
        cap_name = COPY token_text;
      ELSE
        cap_name = "@${token_text}";
      END
      MUTABLE attrs: ?SigilAttrs = COPY sigils[cap_name];
      IF (attrs == NIL) THEN
        MUTABLE has_at = token_text.startsWith?("@");
        MUTABLE candidates: []String = List[];
        IF has_at THEN
          candidates = sigils.keys();
        ELSE
          candidates = sigils.keys() |> SELECT regexReplaceFirst(_, "^@", "");
        END
        clearParser__emit_typo_suggestion_mut(rtoc_self_view, tok, token_text, candidates, "Unknown ${prefix_label} prefix ${compilerInspectValue()}", suggestion_label, :type, TRUE);
      END
      MUTABLE attrs_value: SigilAttrs = attrs?;
      MUTABLE stack_size_attr: ?String@symbol = COPY attrs_value.stack_size;
      IF stack_size_attr EXISTS AS stack_size_attr_value THEN
        IF stack_size EXISTS AS stack_size_value THEN
          clearParser__error_mut(rtoc_self_view, tok, CodeOrMessage{ SymbolValue: :DUPLICATE_STACK_SIZE }, [], {:kind: "${COPY kind}"});
        END
        stack_size = stack_size_attr_value;
        stack_size_token = COPY tok;
      END
      IF attrs_value.pinned THEN
        pinned = TRUE;
      END
      IF attrs_value.parallel THEN
        parallel = TRUE;
      END
      IF attrs_value.arena THEN
        arena = TRUE;
      END
      IF attrs_value.can_smash THEN
        can_smash = TRUE;
        can_smash_token = tok;
      END
      IF !(clearParser__match?(rtoc_self_view, :CHAR, ":")) THEN
        BREAK;
      END
      clearParser__consume(&rtoc_self_view, :CHAR, ":");
    END
    clearParser__consume(&rtoc_self_view, :ARROW, "->");
    RETURN TaskPrefix{ pinned: pinned, parallel: parallel, stack_size: COPY stack_size, arena: arena, can_smash: can_smash, stack_size_token: COPY stack_size_token, can_smash_token: COPY can_smash_token };
}
END
FN clearParser__parse_do_block(MUTABLE self: ClearParser) RETURNS !DoBlock
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE do_token = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "DO"));
    clearParser__consume(&rtoc_self_view, :CHAR, "{");
    MUTABLE branches: []DoBranch = List[];
    WHILE !((clearParser__match?(rtoc_self_view, :CHAR, "}") OR clearParser__match?(rtoc_self_view, :EOF))) DO
      MUTABLE prefix = TRY (clearParser__parse_task_prefix(&rtoc_self_view, clearParser__bg_task_sigils(), "branch", "branch", "closest DO branch sigil"));
      MUTABLE stmt_branch_value: ?Locatable = NIL;
      IF clearParser__match?(rtoc_self_view, :KEYWORD) THEN
        stmt_branch_value = TRY (clearParser__parse_statement(&rtoc_self_view));
      ELSE
        stmt_branch_value = TRY (clearParser__parse_expression(&rtoc_self_view));
      END
      MUTABLE stmt: Locatable = stmt_branch_value?;
      &branches.append(DoBranch{ body: COPY [stmt], pinned: prefix.pinned, parallel: prefix.parallel, stack_size: COPY prefix.stack_size, can_smash: prefix.can_smash, computed_stack_tier: NIL, capture_analysis: NIL });
      IF !(castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, ","))) THEN
        BREAK;
      END
    END
    clearParser__consume(&rtoc_self_view, :CHAR, "}");
    RETURN DoBlock{ token: COPY do_token, branches: branches, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
}
END
FN clearParser__parse_bg_block(MUTABLE self: ClearParser) RETURNS !BgNode
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE bg_token = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "BG"));
    IF clearParser__match?(rtoc_self_view, :KEYWORD, "STREAM") THEN
      RETURN BgNode{ BgStreamBlock: COPY TRY (clearParser__parse_bg_stream_block(&rtoc_self_view, bg_token)) };
    END
    MUTABLE open_brace = TRY (clearParser__consume(&rtoc_self_view, :CHAR, "{"));
    MUTABLE prefix = TRY (clearParser__parse_task_prefix(&rtoc_self_view, clearParser__do_task_sigils(), "BG", "BG", "closest BG body sigil"));
    MUTABLE body = TRY (clearParser__parse_bg_then_body(&rtoc_self_view));
    clearParser__consume(&rtoc_self_view, :CHAR, "}");
    MUTABLE node = BgBlock{ token: COPY bg_token, body: body, deferred_drops: NIL, stack_size: COPY prefix.stack_size, pinned: prefix.pinned, parallel: prefix.parallel, arena_mode: prefix.arena, can_smash: prefix.can_smash, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, computed_stack_tier: NIL, captures_resource: NIL, capture_analysis: NIL, async_result_shape: NIL, declared_async_payload: NIL, spawn_form: NIL, fsm_ineligible_reason: NIL, fsm_suspend_points: NIL, open_brace_token: NIL, prefix_token: NIL, can_smash_token: NIL };
    node.open_brace_token = open_brace;
    node.prefix_token = COPY prefix.stack_size_token;
    node.can_smash_token = COPY prefix.can_smash_token;
    RETURN BgNode{ BgBlock: COPY node };
}
END
FN clearParser__parse_bg_then_body(MUTABLE self: ClearParser) RETURNS ![]Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE stmts: []Locatable = List[];
    WHILE !((clearParser__match?(rtoc_self_view, :CHAR, "}") OR clearParser__match?(rtoc_self_view, :EOF))) DO
      MUTABLE stmt = TRY (clearParser__parse_bg_body_stmt(&rtoc_self_view));
      &stmts.append(stmt);
    END
    RETURN stmts;
}
END
FN clearParser__parse_bg_body_stmt(MUTABLE self: ClearParser) RETURNS !Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_cur_7 = clearParser__current(rtoc_self_view);
    IF ((rtoc_cur_7.type == :VAR_ID) AND clearParser__destructuring_assignment?(rtoc_self_view)) THEN
      RETURN Locatable{ DestructuringAssignment: COPY TRY (clearParser__parse_destructuring_assign(&rtoc_self_view)) };
    END
    MUTABLE rule: ?ParserRule = COPY STMT_RULE_INDEX[clearParser__token_rule_key(clearParser__current(rtoc_self_view))];
    IF rule EXISTS AS rule_value THEN
      MUTABLE rule_value_mutable = COPY rule_value;
      RETURN TRY (clearParser__dispatch_stmt_rule(&rtoc_self_view, rule_value_mutable));
    END
    MUTABLE chain_anchor: Token = clearParser__current(rtoc_self_view);
    MUTABLE parsed_var_branch_value: ?ParsedVarForm = NIL;
    rtoc_cur_8 = clearParser__current(rtoc_self_view);
    IF (rtoc_cur_8.type == :VAR_ID) THEN
      parsed_var_branch_value = TRY (clearParser__parse_var_form(&rtoc_self_view));
    ELSE
      parsed_var_branch_value = NIL;
    END
    MUTABLE parsed_var: ?ParsedVarForm = parsed_var_branch_value;
    IF parsed_var EXISTS AS assigned_var THEN
      IF assigned_var.assignment THEN
        clearParser__consume(&rtoc_self_view, :CHAR, ";");
        RETURN COPY assigned_var.node;
      END
    END
    MUTABLE expr_branch_value: ?Locatable = NIL;
    IF parsed_var EXISTS AS parsed_var_value THEN
      expr_branch_value = COPY parsed_var_value.node;
    ELSE
      expr_branch_value = TRY (clearParser__parse_expression(&rtoc_self_view));
    END
    MUTABLE expr: Locatable = expr_branch_value?;
    IF (clearParser__match?(rtoc_self_view, :KEYWORD, "AS") OR clearParser__match?(rtoc_self_view, :KEYWORD, "THEN")) THEN
      MUTABLE binding_name: ?String = NIL;
      IF clearParser__match?(rtoc_self_view, :KEYWORD, "AS") THEN
        clearParser__consume(&rtoc_self_view, :KEYWORD, "AS");
        binding_name = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :VAR_ID)));
      END
      IF !(clearParser__match?(rtoc_self_view, :KEYWORD, "THEN")) THEN
        clearParser__error_mut(rtoc_self_view, clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :EXPECTED_THEN_AFTER_AS_BG }, [], {:got: "${compilerInspectValue()}"});
      END
      MUTABLE steps: []ThenStep = [ThenStep{ expr: COPY expr, binding: COPY binding_name }];
      WHILE clearParser__match?(rtoc_self_view, :KEYWORD, "THEN") DO
        clearParser__consume(&rtoc_self_view, :KEYWORD, "THEN");
        MUTABLE next_expr = TRY (clearParser__parse_expression(&rtoc_self_view));
        MUTABLE next_binding: ?String = NIL;
        IF clearParser__match?(rtoc_self_view, :KEYWORD, "AS") THEN
          clearParser__consume(&rtoc_self_view, :KEYWORD, "AS");
          next_binding = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :VAR_ID)));
        END
        &steps.append(ThenStep{ expr: COPY next_expr, binding: COPY next_binding });
      END
      clearParser__match_mut(&rtoc_self_view, :CHAR, ";");
      RETURN Locatable{ ThenChain: COPY ThenChain{ token: COPY chain_anchor, steps: steps, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL } };
    END
    clearParser__consume(&rtoc_self_view, :CHAR, ";");
    RETURN expr;
}
END
FN clearParser__parse_bg_stream_block(MUTABLE self: ClearParser, bg_token: Token) RETURNS !BgStreamBlock
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    clearParser__consume(&rtoc_self_view, :KEYWORD, "STREAM");
    MUTABLE yields_token: ?Token = NIL;
    MUTABLE declared_yield_type: ?Type = NIL;
    IF clearParser__match?(rtoc_self_view, :KEYWORD, "YIELDS") THEN
      yields_token = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "YIELDS"));
      declared_yield_type = TRY (clearParser__parse_type_annotation(&rtoc_self_view));
    END
    MUTABLE body = TRY (clearParser__parse_brace_block(&rtoc_self_view));
    MUTABLE node = BgStreamBlock{ token: COPY bg_token, body: body, deferred_drops: NIL, stack_size: NIL, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, computed_stack_tier: NIL, capture_analysis: NIL, spawn_form: NIL, fsm_ineligible_reason: NIL, fsm_suspend_points: NIL, declared_yield_type: NIL, yields_token: NIL };
    bgStreamBlock__set_yield_contract(&node, declared_yield_type, yields_token);
    RETURN node;
}
END
