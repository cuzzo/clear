PRIVATE FN clearParser__token_var?(self: ClearParser, token: ?Token) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ((token != NIL) AND (token.type == :VAR_ID));
}
END
PRIVATE FN clearParser__apply_capability_mut(MUTABLE self: ClearParser, MUTABLE result: CapabilityParseResult, token: Token, value: String, validate_shard_count: Bool = FALSE) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    clearParser__emit_boxed_capability_migration(rtoc_self_view, token);
    MUTABLE ownership: ?String@symbol = COPY clearParser__ownership_sigils()[value];
    IF ownership EXISTS AS ownership_value THEN
      MUTABLE current: ?String@symbol = COPY result.ownership;
      IF ((((current == :shared) AND (ownership_value == :node))) OR (((current == :node) AND (ownership_value == :shared)))) THEN
        result.ownership = :shared_node;
      ELSE
        IF current EXISTS AS current_value THEN
          clearParser__error_mut(rtoc_self_view, token, CodeOrMessage{ SymbolValue: :DUPLICATE_OWNERSHIP_CAP });
        END
        result.ownership = ownership_value;
      END
      RETURN;
    END
    MUTABLE sync: ?String@symbol = COPY clearParser__sync_sigils()[value];
    IF sync EXISTS AS sync_value THEN
      IF result.sync EXISTS AS sync_value_2 THEN
        clearParser__error_mut(rtoc_self_view, token, CodeOrMessage{ SymbolValue: :DUPLICATE_SYNC_CAP });
      END
      result.sync = sync_value;
      RETURN;
    END
    MUTABLE collection: ?String@symbol = COPY clearParser__collection_sigils()[value];
    IF collection EXISTS AS collection_value THEN
      IF result.collection EXISTS AS collection_value_2 THEN
        clearParser__error_mut(rtoc_self_view, token, CodeOrMessage{ SymbolValue: :DUPLICATE_COLLECTION_CAP });
      END
      result.collection = collection_value;
      RETURN;
    END
    IF (value == "@boxed") OR (value == "@indirect") THEN
      IF result.is_indirect THEN
        clearParser__error_mut(rtoc_self_view, token, CodeOrMessage{ SymbolValue: :DUPLICATE_LAYOUT_CAP });
      END
      result.is_indirect = TRUE;
    ELSE_IF (value == "@soa") THEN
      IF result.is_soa THEN
        clearParser__error_mut(rtoc_self_view, token, CodeOrMessage{ SymbolValue: :DUPLICATE_SOA_CAP });
      END
      result.is_soa = TRUE;
    ELSE_IF (value == "@sharded") THEN
      IF result.shard_count EXISTS AS shard_count_value THEN
        clearParser__error_mut(rtoc_self_view, token, CodeOrMessage{ SymbolValue: :DUPLICATE_SHARD_COUNT_CAP });
      END
      clearParser__consume(&rtoc_self_view, :CHAR, "(");
      MUTABLE count_tok = TRY (clearParser__consume_number(&rtoc_self_view));
      MUTABLE count = TRY (token__number_as_integer(count_tok));
      IF (validate_shard_count AND (count < 2)) THEN
        clearParser__error_mut(rtoc_self_view, count_tok, CodeOrMessage{ SymbolValue: :SHARDED_TOO_FEW }, [], {:count: "${count.toString()}"});
      END
      result.shard_count = count;
      clearParser__consume(&rtoc_self_view, :CHAR, ")");
    ELSE_IF (value == "@observable") THEN
      IF result.observable THEN
        clearParser__error_mut(rtoc_self_view, token, CodeOrMessage{ SymbolValue: :DUPLICATE_OBSERVABLE_CAP });
      END
      result.observable = TRUE;
      result.observable_token = COPY token;
    ELSE
      clearParser__emit_typo_suggestion_mut(rtoc_self_view, token, value, capability_tokens, "Unknown capability modifier '${value}'", "closest capability", :capability, TRUE);
    END
}
END
