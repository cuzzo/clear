END
PRIVATE FN clearParser__apply_element_capability_mut(self: ClearParser, MUTABLE result: ElementCapability, value: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (value == "@shared") THEN
      result.ownership = IF (result.ownership == :node) THEN
        :shared_node
      ELSE
        :shared
      END;
    ELSE_IF (value == "@multiowned") THEN
      result.ownership = :multiowned;
    ELSE_IF (value == "@node") THEN
      result.ownership = IF (result.ownership == :shared) THEN
        :shared_node
      ELSE
        :node
      END;
    ELSE_IF (value == "shared") THEN
      result.ownership = IF (result.ownership == :node) THEN
        :shared_node
      ELSE
        :shared
      END;
    ELSE_IF (value == "node") THEN
      result.ownership = IF (result.ownership == :shared) THEN
        :shared_node
      ELSE
        :node
      END;
    ELSE_IF (value == "@locked") OR (value == "locked") THEN
      result.sync = :locked;
    ELSE_IF (value == "@writeLocked") OR (value == "writeLocked") THEN
      result.sync = :write_locked;
    ELSE_IF (value == "@alwaysMutable") OR (value == "alwaysMutable") THEN
      result.sync = :always_mutable;
    ELSE_IF (value == "@link") THEN
      result.ownership = :link;
    ELSE_IF (value == "@boxed") OR (value == "boxed") OR (value == "@indirect") OR (value == "indirect") THEN
      result.layout = :indirect;
    END
}
END
PRIVATE FN clearParser__token_char?(self: ClearParser, token: ?Token, value: String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF token EXISTS AS token_value THEN
      RETURN ((token_value.type == :CHAR) AND token__text_is?(token_value, value));
    ELSE
      RETURN FALSE;
    END
}
