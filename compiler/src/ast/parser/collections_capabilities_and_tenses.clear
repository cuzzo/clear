    IF !(clearParser__element_capability_suffix?(rtoc_self_view)) THEN
      RETURN result;
    END
    MUTABLE token = TRY (clearParser__consume(&rtoc_self_view, :VAR_ID));
    clearParser__emit_boxed_capability_migration(rtoc_self_view, token);
    clearParser__apply_element_capability_mut(rtoc_self_view, &result, TRY (token__text_mut(token)));
    IF clearParser__match?(rtoc_self_view, :CHAR, ":") THEN
      clearParser__consume(&rtoc_self_view, :CHAR, ":");
      token = TRY (clearParser__consume(&rtoc_self_view, :VAR_ID));
      clearParser__emit_boxed_capability_migration(rtoc_self_view, token);
      clearParser__apply_element_capability_mut(rtoc_self_view, &result, TRY (token__text_mut(token)));
    END
    RETURN result;
}
END
PRIVATE FN clearParser__element_capability_suffix?(self: ClearParser) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE next_tok: ?Token = clearParser__peek_at(rtoc_self_view, 1);
    IF clearParser__token_char?(rtoc_self_view, next_tok, "[") THEN
      RETURN TRUE;
    END
    IF !(clearParser__token_char?(rtoc_self_view, next_tok, ":")) THEN
      RETURN FALSE;
    END
    MUTABLE sync_tok: ?Token = clearParser__peek_at(rtoc_self_view, 2);
    IF !((clearParser__token_var?(rtoc_self_view, sync_tok) AND clearParser__token_char?(rtoc_self_view, clearParser__peek_at(rtoc_self_view, 3), "["))) THEN
      RETURN FALSE;
    END
    MUTABLE joined = TRY (token__text_mut(UNWRAP (sync_tok)));
    RETURN (element_sync_tokens.contains?(joined) OR (["node", "@node", "shared", "@shared"]).contains?(joined));
