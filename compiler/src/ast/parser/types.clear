EXTERN STRUCT CompilerRegex {} FROM "compiler_regex";
EXTERN FN compilerRegexCompile(pattern: String) RETURNS CompilerRegex EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexReplaceAll(subject: String, regex: CompilerRegex, replacement: String) RETURNS String EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexMatchGroup(subject: String, regex: CompilerRegex, index: Int64) RETURNS (subject): ?String EFFECTS :safe FROM "compiler_regex";
FN regexMatchGroup(subject: String, pattern: String, index: Int64) RETURNS ?String ->
  RETURN COPY compilerRegexMatchGroup(subject, compilerRegexCompile(pattern), index);
END

PRIVATE FN clearParser__parse_fn_type_annotation(MUTABLE self: ClearParser) RETURNS !Type
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "FN"));
    TRY (clearParser__consume(&rtoc_self_view, :CHAR, "("));
    MUTABLE param_types: []Type = List[];
    WHILE !(clearParser__match?(rtoc_self_view, :CHAR, ")")) DO
      IF ((clearParser__match?(rtoc_self_view, :VAR_ID) AND (clearParser__peek(rtoc_self_view).type == :CHAR)) AND (token__text_is?(clearParser__peek(rtoc_self_view), ":"))) THEN
        TRY (clearParser__consume(&rtoc_self_view, :VAR_ID));
        TRY (clearParser__consume(&rtoc_self_view, :CHAR, ":"));
      END
      &param_types.append(TRY (clearParser__parse_type_annotation(&rtoc_self_view, FALSE)));
      IF !(castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :CHAR, ",")))) THEN
        BREAK;
      END
    END
    TRY (clearParser__consume(&rtoc_self_view, :CHAR, ")"));
    TRY (clearParser__consume(&rtoc_self_view, :ARROW, "->"));
    MUTABLE return_type = TRY (clearParser__parse_type_annotation(&rtoc_self_view, FALSE));
    MUTABLE abi: String@symbol = :clear;
    IF castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :KEYWORD, "CALLCONV"))) THEN
      MUTABLE abi_token = clearParser__current(rtoc_self_view);
      TRY (clearParser__consume(&rtoc_self_view, abi_token.type));
      abi = symbol((TRY (token__text_mut(abi_token))).downcase());
      IF !((abi == :c)) THEN
        clearParser__error_mut(rtoc_self_view, abi_token, CodeOrMessage{ SymbolValue: :PARSER_EXPECTED }, [], {:expected: "C", :got: "${token__display_value(abi_token)}", :type: "${abi_token.type}", :line: abi_token.line.toString()});
      END
    END
    rtoc_cur_0 = clearParser__current(rtoc_self_view);
    IF (clearParser__match?(rtoc_self_view, :VAR_ID) AND (["@reentrant", "@nonReentrant"]).contains?(token__display_value(rtoc_cur_0))) THEN
      clearParser__error_mut(rtoc_self_view, clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :PARSER_EXPECTED }, [], {:expected: "supported function type annotation", :got: "${token__display_value(clearParser__current(rtoc_self_view))}", :type: "${clearParser__current(rtoc_self_view).type}", :line: clearParser__current(rtoc_self_view).line.toString()});
    END
    RETURN TRY (type__function_type_from_parts(param_types, return_type, FALSE, NIL, abi));
}
END
PUB FN clearParser__parse_type_annotation(MUTABLE self: ClearParser, migration_root: Bool = TRUE) RETURNS !Type
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_mutable_receiver_1 = KEEP rtoc_self_view.budget;
    TRY (frontendResourceBudget__enter_mut(&rtoc_mutable_receiver_1));
    MUTABLE syntax = TRY (clearParser__parse_type_annotation_syntax(&rtoc_self_view, migration_root));
    MUTABLE rtoc_mutable_receiver_2 = KEEP rtoc_self_view.budget;
    frontendResourceBudget__leave_mut(&rtoc_mutable_receiver_2);
    RETURN TRY (typeSyntaxLowering__lower(syntax));
}
END
PUB FN clearParser__parse_type_annotation_syntax(MUTABLE self: ClearParser, migration_root: Bool = TRUE) RETURNS !ParsedTypeSyntax
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE start_token = UNWRAP (clearParser__peek_at(rtoc_self_view, 0));
    MUTABLE inline_syntax = clearParser__inline_type_annotation_start?(rtoc_self_view);
    MUTABLE parsed = TRY (clearParser__parse_type_annotation_body(&rtoc_self_view));
    IF migration_root THEN
      TRY (clearParser__validate_type_expression_budget_mut(rtoc_self_view, COPY start_token, COPY parsed.shape.expression));
    END
    IF (migration_root AND !(inline_syntax)) THEN
      TRY (clearParser__emit_legacy_type_migration(rtoc_self_view, COPY start_token, clearParser__previous(rtoc_self_view), COPY parsed));
    END
    RETURN ParsedTypeSyntax{ expression: COPY parsed.shape.expression, start_token: start_token, end_token: clearParser__previous(rtoc_self_view), auto_token: COPY parsed.auto_token, auto: type__auto?(parsed) };
}
END
PRIVATE FN clearParser__parse_type_annotation_body(MUTABLE self: ClearParser) RETURNS !Type
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE size: Int64 = 0_i64;
    IF clearParser__inline_type_annotation_start?(rtoc_self_view) THEN
      RETURN TRY (type__new(TypeConstructionInput{ TypeExpression: COPY TRY (clearParser__parse_inline_type_expression(&rtoc_self_view)) }));
    END
    IF clearParser__match?(rtoc_self_view, :KEYWORD, "FN") THEN
      RETURN TRY (clearParser__parse_fn_type_annotation(&rtoc_self_view));
    END
    IF clearParser__match?(rtoc_self_view, :KEYWORD, "SHARED") THEN
      TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "SHARED"));
      RETURN TRY (clearParser__mark_polymorphic_shared_type(rtoc_self_view, TRY (clearParser__parse_type_annotation(&rtoc_self_view, FALSE))));
    END
    MUTABLE tense_prefix = "";
    IF castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :CHAR, "~"))) THEN
      tense_prefix = "~";
    END
    MUTABLE error_prefix = "";
    IF castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :CHAR, "!"))) THEN
      error_prefix = "!";
    END
    MUTABLE optional_prefix = "";
    IF castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :CHAR, "?"))) THEN
      optional_prefix = "?";
    END
    IF ((optional_prefix == "?") AND clearParser__match?(rtoc_self_view, :CHAR, "(")) THEN
      IF ((tense_prefix != "") OR (error_prefix != "")) THEN
        clearParser__error_mut(rtoc_self_view, clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :PARSER_EXPECTED }, [], {:expected: "a grouped optional without an outer tense/error prefix", :got: "${token__display_value(clearParser__current(rtoc_self_view))}", :type: "${clearParser__current(rtoc_self_view).type}", :line: clearParser__current(rtoc_self_view).line.toString()});
      END
      TRY (clearParser__consume(&rtoc_self_view, :CHAR, "("));
      MUTABLE wrapped = TRY (clearParser__parse_type_annotation(&rtoc_self_view, FALSE));
      TRY (clearParser__consume(&rtoc_self_view, :CHAR, ")"));
      RETURN TRY (type__optional_of(TypeTypeInput{ Type: COPY wrapped }));
    END
    IF (clearParser__match?(rtoc_self_view, :KEYWORD, "Auto") AND ("${tense_prefix}${error_prefix}${optional_prefix}" != "")) THEN
      MUTABLE prefix_chars = "${tense_prefix}${error_prefix}${optional_prefix}";
      clearParser__error_mut(rtoc_self_view, clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :AUTO_PREFIX_NOT_SUPPORTED }, [], {:prefix: "${prefix_chars}", :prefix2: prefix_chars, :prefix3: prefix_chars, :prefix4: prefix_chars});
    END
    IF clearParser__match?(rtoc_self_view, :KEYWORD, "FN") THEN
      MUTABLE fn_type = TRY (clearParser__parse_fn_type_annotation(&rtoc_self_view));
      IF ((tense_prefix != "") OR (error_prefix != "")) THEN
        clearParser__error_mut(rtoc_self_view, clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :PARSER_EXPECTED }, [], {:expected: "plain or optional function type annotation", :got: "${tense_prefix}${error_prefix}FN", :type: "${clearParser__current(rtoc_self_view).type}", :line: clearParser__current(rtoc_self_view).line.toString()});
      END
      IF (optional_prefix == "?") THEN
        RETURN TRY (type__optional_of(TypeTypeInput{ Type: COPY fn_type }));
      ELSE
        RETURN fn_type;
      END
    END
    MUTABLE auto_tok: ?Token = NIL;
    MUTABLE auto_type = FALSE;
    MUTABLE base: String = "";
    MUTABLE generic_base: ?String@symbol = NIL;
    MUTABLE generic_argument_expressions: []TypeExpression = List[];
    IF clearParser__match?(rtoc_self_view, :KEYWORD, "Auto") THEN
      auto_tok = TRY (clearParser__consume(&rtoc_self_view, :KEYWORD, "Auto"));
      auto_type = TRUE;
      base = "Auto";
    ELSE
      base = TRY (token__text_mut((TRY (clearParser__consume(&rtoc_self_view, :TYPE_ID)))));
    END
    MUTABLE inner = "";
    IF clearParser__match?(rtoc_self_view, :DOUBLE_COLON) THEN
      TRY (clearParser__consume(&rtoc_self_view, :DOUBLE_COLON));
      MUTABLE member = TRY (token__text_mut((TRY (clearParser__consume(&rtoc_self_view, :TYPE_ID)))));
      RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY "${tense_prefix}${error_prefix}${optional_prefix}${base}::${member}" }));
    END
    IF clearParser__match?(rtoc_self_view, :CHAR, "<") THEN
      generic_base = symbol(base);
      TRY (clearParser__consume(&rtoc_self_view, :CHAR, "<"));
      MUTABLE type_args: []String = List[];
      WHILE !(clearParser__generic_close?(rtoc_self_view)) DO
        MUTABLE argument = TRY (clearParser__parse_type_annotation(&rtoc_self_view, FALSE));
        &type_args.append(TRY (clearParser__type_annotation_source(rtoc_self_view, COPY argument)));
        &generic_argument_expressions.append(COPY argument.shape.expression);
        TRY (clearParser__match_mut(&rtoc_self_view, :CHAR, ","));
      END
      TRY (clearParser__consume_generic_close(&rtoc_self_view));
      base = "${base}<${type_args.join(",")}>";
    END
    MUTABLE elem_caps = TRY (clearParser__parse_element_capability(&rtoc_self_view));
    MUTABLE elem_ownership: ?String@symbol = COPY elem_caps.ownership;
    MUTABLE elem_sync: ?String@symbol = COPY elem_caps.sync;
    MUTABLE elem_layout: ?String@symbol = COPY elem_caps.layout;
    IF castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :CHAR, "["))) THEN
      IF castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :CHAR, "]"))) THEN
        inner = "[]";
      ELSE_IF castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :CHAR, "*"))) THEN
        TRY (clearParser__consume(&rtoc_self_view, :CHAR, "]"));
        inner = "[*]";
      ELSE_IF (clearParser__match?(rtoc_self_view, :NUMBER) OR clearParser__match?(rtoc_self_view, :INT64)) THEN
        size = TRY (token__number_as_integer(TRY (clearParser__consume_number(&rtoc_self_view))));
        TRY (clearParser__consume(&rtoc_self_view, :CHAR, "]"));
        inner = "[${size.toString()}]";
      ELSE_IF clearParser__match?(rtoc_self_view, :CHAR, "?") THEN
        clearParser__error_mut(rtoc_self_view, clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :PARSER_EXPECTED }, [], {:expected: "[~]T, [~N]T, or [~INF]T stream syntax", :got: "[?]", :type: "${clearParser__current(rtoc_self_view).type}", :line: clearParser__current(rtoc_self_view).line.toString()});
      ELSE_IF (clearParser__match?(rtoc_self_view, :TYPE_ID) AND (token__text_is?(clearParser__current(rtoc_self_view), "INF"))) THEN
        TRY (clearParser__consume(&rtoc_self_view, :TYPE_ID));
        TRY (clearParser__consume(&rtoc_self_view, :CHAR, "]"));
        inner = "[INF]";
      ELSE
        clearParser__error_mut(rtoc_self_view, clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :ARRAY_TYPE_BAD });
      END
      WHILE clearParser__match?(rtoc_self_view, :CHAR, "[") DO
        TRY (clearParser__consume(&rtoc_self_view, :CHAR, "["));
        IF castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :CHAR, "]"))) THEN
          inner = (inner $+ "[]");
        ELSE_IF (clearParser__match?(rtoc_self_view, :NUMBER) OR clearParser__match?(rtoc_self_view, :INT64)) THEN
          size = TRY (token__number_as_integer(TRY (clearParser__consume_number(&rtoc_self_view))));
          TRY (clearParser__consume(&rtoc_self_view, :CHAR, "]"));
          inner = (inner $+ "[${size.toString()}]");
        ELSE
          clearParser__error_mut(rtoc_self_view, clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :ARRAY_TYPE_EXPECTED_SIZE });
        END
      END
    END
    MUTABLE legacy_card: ?String = regexMatchGroup(inner, "\\A\\[(\\d*|INF)\\]\\z", 1);
    IF (((tense_prefix == "~") AND (optional_prefix == "?")) AND (error_prefix == "")) THEN
      IF legacy_card EXISTS AS legacy_card_value THEN
        clearParser__error_mut(rtoc_self_view, clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :RETIRED_OPTIONAL_STREAM_SYNTAX }, [], {:got: "~?${base}${inner}", :replacement: "[~${legacy_card_value}]${base}"});
      END
    END
    MUTABLE caps = TRY (clearParser__parse_capabilities(&rtoc_self_view));
    MUTABLE ownership: ?String@symbol = COPY caps.ownership;
    MUTABLE sync: ?String@symbol = COPY caps.sync;
    MUTABLE collection: ?String@symbol = COPY caps.collection;
    MUTABLE is_soa = caps.is_soa;
    MUTABLE is_indirect = caps.is_indirect;
    MUTABLE shard_count: ?Int64 = COPY caps.shard_count;
    MUTABLE observable = caps.observable;
    MUTABLE observable_token: ?Token = COPY caps.observable_token;
    MUTABLE base_sym = symbol("${tense_prefix}${error_prefix}${optional_prefix}${base}${inner}");
    MUTABLE loc: ?String@symbol = IF is_indirect THEN
      :heap
    ELSE
      NIL
    END;
    MUTABLE layout: ?String@symbol = IF is_indirect THEN
      :indirect
    ELSE
      NIL
    END;
    IF (((sync == :atomic) AND (layout == :indirect)) AND FALSE) THEN
      ownership = :shared;
    END
    MUTABLE t = TRY (type__new(TypeConstructionInput{ SymbolValue: COPY base_sym }, ownership, sync, layout, loc, collection, shard_count, NIL, observable, NIL, auto_type));
    IF !((generic_base == NIL)) THEN
      MUTABLE expression = typeExpressionTree__with_nominal_arguments(t.shape.expression, generic_base, generic_argument_expressions);
      MUTABLE rtoc_mutable_alias_arg_4 = COPY TRY (typeShape__with_expression(t.shape, expression));
      type__replace_shape_mut(&t, rtoc_mutable_alias_arg_4);
    END
    IF auto_tok EXISTS AS auto_tok_value THEN
      t.auto_token = auto_tok_value;
    END
    TRY (type__apply_type_annotation_extras_mut(&t, is_soa, elem_ownership, elem_sync, elem_layout, observable_token));
    RETURN t;
}
END
PRIVATE FN clearParser__emit_legacy_type_migration(self: ClearParser, start_token: Token, end_token: Token, type: Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(fixCollector__type_migrations_enabled?()) THEN
      RETURN;
    END
    IF !((start_token.line == end_token.line)) THEN
      RETURN;
    END
    MUTABLE has_pivot_shape: Bool = FALSE;
    FOR pivot_node IN TRY (typeExpressionTree__each_node(type.shape.expression)) DO
      MUTABLE pivot_kind = typeExpressionTree__kind_of(pivot_node);
      IF ((pivot_kind IS_A LinearTypeExpression OR pivot_kind IS_A MapTypeExpression) OR pivot_kind IS_A StreamTypeExpression) THEN
        has_pivot_shape = TRUE;
      END
    END
    IF !(has_pivot_shape) THEN
      RETURN;
    END
    MUTABLE replacement: ?String = TRY (type__inline_migration_name(type));
    IF replacement EXISTS AS replacement_value THEN
      MUTABLE line: ?String = COPY rtoc_self_view.source_code.split("\n")[(start_token.line - 1)];
      IF line EXISTS AS line_value THEN
        MUTABLE length = ((end_token.column + (token__display_value(end_token)).codepointCount()) - start_token.column);
        MUTABLE original = COPY (line_value.substr(((start_token.column - 1)), length));
        IF (regexReplaceAll(original, "\\s+", "") == regexReplaceAll(replacement_value, "\\s+", "")) THEN
          RETURN;
        END
        MUTABLE edit = edit__new(span__new(NIL, start_token.line, start_token.column, length), replacement_value);
        TRY (fixCollector__push(TRY (fixableFinding__new(:info, "Legacy type syntax can be written in Inline Pivot form", start_token, :type_migration, [TRY (fix__new(clearParser__fix_description(rtoc_self_view, :REWRITE_INLINE_PIVOT_TYPE, {:type: "${replacement_value}"}), [edit], :auto))]))));
      ELSE
        RETURN;
      END
    ELSE
      RETURN;
    END
}
END
PUB FN clearParser__emit_boxed_capability_migration(self: ClearParser, token: Token) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(fixCollector__type_migrations_enabled?()) THEN
      RETURN;
    END
    IF !((["@indirect", "indirect"]).contains?(TRY (token__text_mut(token)))) THEN
      RETURN;
    END
    MUTABLE replacement: String = "";
    IF (TRY (token__text_mut(token))).startsWith?("@") THEN
      replacement = "@boxed";
    ELSE
      replacement = "boxed";
    END
    MUTABLE edit = edit__new(span__new(NIL, token.line, token.column, (TRY (token__text_mut(token))).codepointCount()), replacement);
    TRY (fixCollector__push(TRY (fixableFinding__new(:info, "Legacy @indirect capability is now spelled @boxed", token, :type_migration, [TRY (fix__new(clearParser__fix_description(rtoc_self_view, :RENAME_BOXED_CAPABILITY, {:old: "${TRY (token__text_mut(token))}", :new: "${replacement}"}), [edit], :auto))]))));
}
END
PRIVATE FN clearParser__inline_type_annotation_start?(self: ClearParser) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE offset: Int64 = 0;
    MUTABLE token = UNWRAP (clearParser__peek_at(rtoc_self_view, 0));
    MUTABLE prefixes: String = "";
    WHILE ((token.type == :CHAR) AND (["?", "!", "~"]).contains?(token__display_value(token))) DO
      prefixes = (prefixes $+ COPY token__display_value(token));
      offset = (offset + 1);
      token = (clearParser__peek_at(rtoc_self_view, offset) OR_ELSE token);
    END
    IF ((token.type == :CHAR) AND (["[", "{"]).contains?(token__display_value(token))) THEN
      RETURN TRUE;
    END
    RETURN (!((prefixes.length() == 0)) AND !((["~", "!", "?", "~!", "~?", "!?", "~!?"]).contains?(prefixes)));
}
END
PRIVATE FN clearParser__parse_inline_type_expression(MUTABLE self: ClearParser) RETURNS !TypeExpression
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE token = UNWRAP (clearParser__peek_at(rtoc_self_view, 0));
    IF (token.type == :CHAR) THEN
      IF (["?", "!", "~"]).contains?(token__display_value(token)) THEN
        RETURN TRY (clearParser__parse_inline_prefixed_expression(&rtoc_self_view));
      END
      IF (token__text_is?(token, "[")) THEN
        IF ((clearParser__peek_at(rtoc_self_view, 1) != NIL) AND (token__text_is?(((clearParser__peek_at(rtoc_self_view, 1))?), "~"))) THEN
          RETURN TRY (clearParser__parse_inline_stream_expression(&rtoc_self_view));
        END
        RETURN TRY (clearParser__parse_inline_linear_expression(&rtoc_self_view));
      END
      IF (token__text_is?(token, "{")) THEN
        RETURN TRY (clearParser__parse_inline_map_expression(&rtoc_self_view));
      END
    END
    RETURN TRY (clearParser__parse_inline_atom_expression(&rtoc_self_view));
}
END
PRIVATE FN clearParser__parse_inline_stream_expression(MUTABLE self: ClearParser) RETURNS !TypeExpression
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (clearParser__consume(&rtoc_self_view, :CHAR, "["));
    TRY (clearParser__consume(&rtoc_self_view, :CHAR, "~"));
    MUTABLE cardinality: TypeExpressionDimension = TypeExpressionDimension{ SymbolValue: :FINITE };
    IF (clearParser__match?(rtoc_self_view, :NUMBER) OR clearParser__match?(rtoc_self_view, :INT64)) THEN
      cardinality = TypeExpressionDimension{ Int64Value: TRY (token__number_as_integer(TRY (clearParser__consume_number(&rtoc_self_view)))) };
    ELSE_IF (clearParser__match?(rtoc_self_view, :TYPE_ID) AND (token__text_is?(clearParser__current(rtoc_self_view), "INF"))) THEN
      TRY (clearParser__consume(&rtoc_self_view, :TYPE_ID, "INF"));
      cardinality = TypeExpressionDimension{ SymbolValue: :INF };
    END
    TRY (clearParser__consume(&rtoc_self_view, :CHAR, "]"));
    MUTABLE caps = TRY (clearParser__parse_inline_capabilities(&rtoc_self_view));
    RETURN TypeExpression{ kind: TypeExpressionKind{ StreamTypeExpression: StreamTypeExpression{ cardinality: COPY cardinality, item: COPY TRY (clearParser__parse_inline_type_expression(&rtoc_self_view)) } }, capabilities: COPY caps };
}
END
PRIVATE FN clearParser__parse_inline_prefixed_expression(MUTABLE self: ClearParser) RETURNS !TypeExpression
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE prefix_token = TRY (clearParser__consume(&rtoc_self_view, :CHAR));
    MUTABLE prefix = TRY (token__text_mut(prefix_token));
    MUTABLE inner = TRY (clearParser__parse_inline_type_expression(&rtoc_self_view));
    IF (prefix == "?") THEN
      IF inner.kind IS_A StreamTypeExpression THEN
        clearParser__error_mut(rtoc_self_view, prefix_token, CodeOrMessage{ SymbolValue: :PARSER_EXPECTED }, [], {:expected: "an optional stream item such as [~]?T", :got: "?[~]T", :type: "${prefix_token.type}", :line: prefix_token.line.toString()});
      END
      RETURN typeExpression__of(TypeExpressionKind{ OptionalTypeExpression: OptionalTypeExpression{ inner: COPY inner } });
    END
    IF (prefix == "!") THEN
      RETURN typeExpression__of(TypeExpressionKind{ FallibleTypeExpression: FallibleTypeExpression{ inner: COPY inner, error_set: NIL } });
    END
    RETURN typeExpression__of(TypeExpressionKind{ FutureTypeExpression: FutureTypeExpression{ inner: COPY inner } });
}
END
PRIVATE FN clearParser__parse_inline_atom_expression(MUTABLE self: ClearParser) RETURNS !TypeExpression
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF clearParser__match?(rtoc_self_view, :KEYWORD, "FN") THEN
      MUTABLE expression = COPY ((TRY (clearParser__parse_fn_type_annotation(&rtoc_self_view))).shape).expression;
      RETURN typeExpressionTree__with_root_capabilities(expression, TRY (clearParser__parse_inline_capabilities(&rtoc_self_view)));
    END
    MUTABLE name = TRY (token__text_mut((TRY (clearParser__consume(&rtoc_self_view, :TYPE_ID)))));
    IF clearParser__match?(rtoc_self_view, :DOUBLE_COLON) THEN
      TRY (clearParser__consume(&rtoc_self_view, :DOUBLE_COLON));
      MUTABLE member = TRY (token__text_mut((TRY (clearParser__consume(&rtoc_self_view, :TYPE_ID)))));
      MUTABLE projection = TypeProjectionExpression{ owner: COPY symbol(name), member: COPY symbol(member), protocol: NIL };
      RETURN TypeExpression{ kind: TypeExpressionKind{ TypeProjectionExpression: COPY projection }, capabilities: COPY TRY (clearParser__parse_inline_capabilities(&rtoc_self_view)) };
    END
    MUTABLE arguments: []TypeExpression = List[];
    IF clearParser__match?(rtoc_self_view, :CHAR, "<") THEN
      TRY (clearParser__consume(&rtoc_self_view, :CHAR, "<"));
      WHILE !(clearParser__generic_close?(rtoc_self_view)) DO
        &arguments.append(TRY (clearParser__parse_inline_type_expression(&rtoc_self_view)));
        IF !(castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :CHAR, ",")))) THEN
          BREAK;
        END
      END
      TRY (clearParser__consume_generic_close(&rtoc_self_view));
    END
    MUTABLE node: ?TypeExpressionKind = NIL;
    IF (name == "Tuple") THEN
      node = TypeExpressionKind{ TupleTypeExpression: TupleTypeExpression{ items: COPY arguments } };
    ELSE
      node = TypeExpressionKind{ NamedTypeExpression: NamedTypeExpression{ name: COPY symbol(name), arguments: COPY arguments } };
    END
    RETURN TypeExpression{ kind: UNWRAP (node), capabilities: COPY TRY (clearParser__parse_inline_capabilities(&rtoc_self_view)) };
}
END
PRIVATE FN clearParser__parse_inline_linear_expression(MUTABLE self: ClearParser) RETURNS !TypeExpression
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE layout: String = "";
    TRY (clearParser__consume(&rtoc_self_view, :CHAR, "["));
    IF castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :CHAR, "]"))) THEN
      MUTABLE caps = TRY (clearParser__parse_inline_capabilities(&rtoc_self_view, :list));
      RETURN TypeExpression{ kind: TypeExpressionKind{ LinearTypeExpression: LinearTypeExpression{ kind: :list, dimensions: [TypeExpressionDimension{ SymbolValue: :LIST }], item: COPY TRY (clearParser__parse_inline_type_expression(&rtoc_self_view)), allocation_hint: NIL } }, capabilities: COPY caps };
    END
    MUTABLE kind: String@symbol = :array;
    MUTABLE dimensions: []TypeExpressionDimension = List[];
    MUTABLE dimension: ?TypeExpressionDimension = NIL;
    MUTABLE allocation_hint: ?Int64 = NIL;
    IF (clearParser__match?(rtoc_self_view, :NUMBER) OR clearParser__match?(rtoc_self_view, :INT64)) THEN
      dimension = TypeExpressionDimension{ Int64Value: TRY (token__number_as_integer(TRY (clearParser__consume_number(&rtoc_self_view)))) };
    ELSE
      layout = TRY (token__text_mut((TRY (clearParser__consume(&rtoc_self_view, :TYPE_ID)))));
      IF (layout == "List") OR (layout == "Set") THEN
        kind = symbol(layout.downcase());
        IF (layout == "List") THEN
          dimension = TypeExpressionDimension{ SymbolValue: :LIST };
        ELSE
          dimension = TypeExpressionDimension{ SymbolValue: :SET };
        END
        IF castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :CHAR, "("))) THEN
          allocation_hint = TRY (token__number_as_integer(TRY (clearParser__consume_number(&rtoc_self_view))));
          TRY (clearParser__consume(&rtoc_self_view, :CHAR, ")"));
        END
      ELSE_IF (layout == "Pool") THEN
        kind = :pool;
        TRY (clearParser__consume(&rtoc_self_view, :CHAR, "("));
        dimension = TypeExpressionDimension{ Int64Value: TRY (token__number_as_integer(TRY (clearParser__consume_number(&rtoc_self_view)))) };
        TRY (clearParser__consume(&rtoc_self_view, :CHAR, ")"));
      ELSE
        clearParser__error_mut(rtoc_self_view, clearParser__previous(rtoc_self_view), CodeOrMessage{ SymbolValue: :PARSER_EXPECTED }, [], {:expected: "an Inline Pivot dimension", :got: "${COPY layout}", :type: "${clearParser__previous(rtoc_self_view).type}", :line: clearParser__previous(rtoc_self_view).line.toString()});
      END
    END
    &dimensions.append(UNWRAP (dimension));
    WHILE castClearParserReturnValueToBool(TRY (clearParser__match_mut(&rtoc_self_view, :CHAR, ","))) DO
      IF ((!((allocation_hint == NIL)) OR (kind == :set)) OR (kind == :pool)) THEN
        clearParser__error_mut(rtoc_self_view, clearParser__previous(rtoc_self_view), CodeOrMessage{ SymbolValue: :PARSER_EXPECTED }, [], {:expected: "integer or List dimensions in a flat rank", :got: "${token__display_value(clearParser__previous(rtoc_self_view))}", :type: "${clearParser__previous(rtoc_self_view).type}", :line: clearParser__previous(rtoc_self_view).line.toString()});
      END
      IF (clearParser__match?(rtoc_self_view, :NUMBER) OR clearParser__match?(rtoc_self_view, :INT64)) THEN
        &dimensions.append(TypeExpressionDimension{ Int64Value: TRY (token__number_as_integer(TRY (clearParser__consume_number(&rtoc_self_view)))) });
      ELSE
        layout = TRY (token__text_mut((TRY (clearParser__consume(&rtoc_self_view, :TYPE_ID)))));
        IF !((layout == "List")) THEN
          clearParser__error_mut(rtoc_self_view, clearParser__previous(rtoc_self_view), CodeOrMessage{ SymbolValue: :PARSER_EXPECTED }, [], {:expected: "integer or List dimensions in a flat rank", :got: "${COPY layout}", :type: "${clearParser__previous(rtoc_self_view).type}", :line: clearParser__previous(rtoc_self_view).line.toString()});
        END
        &dimensions.append(TypeExpressionDimension{ SymbolValue: :LIST });
      END
    END
    TRY (clearParser__consume(&rtoc_self_view, :CHAR, "]"));
    IF (dimensions.length() > 1) THEN
      kind = :rank;
    END
    MUTABLE collection: ?String@symbol = kind;
    IF !(([:list, :set, :pool]).contains?(kind)) THEN
      collection = NIL;
    END
    MUTABLE caps = TRY (clearParser__parse_inline_capabilities(&rtoc_self_view, collection));
    RETURN TypeExpression{ kind: TypeExpressionKind{ LinearTypeExpression: LinearTypeExpression{ kind: COPY kind, dimensions: COPY dimensions, item: COPY TRY (clearParser__parse_inline_type_expression(&rtoc_self_view)), allocation_hint: allocation_hint } }, capabilities: COPY caps };
}
END
PRIVATE FN clearParser__parse_inline_map_expression(MUTABLE self: ClearParser) RETURNS !TypeExpression
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (clearParser__consume(&rtoc_self_view, :CHAR, "{"));
    MUTABLE key_branch_value: ?TypeExpression = NIL;
    IF clearParser__match?(rtoc_self_view, :CHAR, "}") THEN
      key_branch_value = typeExpression__of(TypeExpressionKind{ NamedTypeExpression: NamedTypeExpression{ name: :Symbol, arguments: List[] } });
    ELSE
      MUTABLE parsed_key = TRY (clearParser__parse_inline_type_expression(&rtoc_self_view));
      IF clearParser__match?(rtoc_self_view, :CHAR, ",") THEN
        clearParser__error_mut(rtoc_self_view, clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :PARSER_EXPECTED }, [], {:expected: "a closing brace; nested maps use separate brace layers", :got: "${token__display_value(clearParser__current(rtoc_self_view))}", :type: "${clearParser__current(rtoc_self_view).type}", :line: clearParser__current(rtoc_self_view).line.toString()});
      END
      key_branch_value = parsed_key;
    END
    MUTABLE key: TypeExpression = key_branch_value?;
    TRY (clearParser__consume(&rtoc_self_view, :CHAR, "}"));
    MUTABLE caps = TRY (clearParser__parse_inline_capabilities(&rtoc_self_view));
    RETURN TypeExpression{ kind: TypeExpressionKind{ MapTypeExpression: MapTypeExpression{ key: COPY key, value: COPY TRY (clearParser__parse_inline_type_expression(&rtoc_self_view)), key_implicit: FALSE, legacy_separator: "," } }, capabilities: COPY caps };
}
END
PRIVATE FN clearParser__parse_inline_capabilities(MUTABLE self: ClearParser, collection: ?String@symbol = NIL) RETURNS !TypeCapabilities
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE parsed = TRY (clearParser__parse_capabilities(&rtoc_self_view));
    IF !((parsed.collection == NIL)) THEN
      clearParser__error_mut(rtoc_self_view, clearParser__previous(rtoc_self_view), CodeOrMessage{ SymbolValue: :PARSER_EXPECTED }, [], {:expected: "collection topology in the Inline Pivot layer sigil", :got: "${token__display_value(clearParser__previous(rtoc_self_view))}", :type: "${clearParser__previous(rtoc_self_view).type}", :line: clearParser__previous(rtoc_self_view).line.toString()});
    END
    MUTABLE effective_collection: ?String@symbol = COPY collection;
    IF effective_collection == NIL THEN
      effective_collection = COPY parsed.collection;
    END
    MUTABLE layout: ?String@symbol = NIL;
    IF parsed.is_indirect THEN
      layout = :indirect;
    END
    MUTABLE effective_ownership: ?String@symbol = COPY parsed.ownership;
    IF effective_ownership == NIL THEN
      effective_ownership = :affine;
    END
    RETURN typeCapabilities__new(effective_ownership, FALSE, parsed.sync, layout, NIL, effective_collection, parsed.shard_count, parsed.is_soa, NIL, NIL, NIL, NIL, parsed.observable, NIL, parsed.observable_token);
}
END
PRIVATE FN clearParser__validate_type_expression_budget_mut(self: ClearParser, token: Token, expression: TypeExpression) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE node_count = TRY (typeExpressionTree__node_count(expression));
    IF (node_count > 32) THEN
      clearParser__error_mut(rtoc_self_view, token, CodeOrMessage{ SymbolValue: :TYPE_NODE_LIMIT }, [], {:count: "${node_count.toString()}", :limit: "32"});
    END
    MUTABLE capability_sites = TRY (typeExpressionTree__capability_site_count(expression));
    IF (capability_sites > 3) THEN
      clearParser__error_mut(rtoc_self_view, token, CodeOrMessage{ SymbolValue: :TYPE_CAPABILITY_SITE_LIMIT }, [], {:count: "${capability_sites.toString()}", :limit: "3"});
    END
}
END
PUB FN clearParser__mark_polymorphic_shared_type(self: ClearParser, type: Type) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE t = TRY (type__new(TypeConstructionInput{ Type: COPY type }));
    TRY (type__apply_reference_ownership_mut(&t, :shared));
    TRY (type__mark_polymorphic_shared_mut(&t));
    RETURN t;
}
END
PRIVATE FN clearParser__type_annotation_source(self: ClearParser, type: Type) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE t = COPY type;
    IF type__polymorphic_shared?(t) THEN
      MUTABLE shared_inner = TRY (type__new(TypeConstructionInput{ Type: COPY t }));
      TRY (type__apply_reference_ownership_mut(&shared_inner, :affine));
      TRY (type__mark_polymorphic_shared_mut(&shared_inner, FALSE));
      RETURN "SHARED ${TRY (clearParser__type_annotation_source(rtoc_self_view, shared_inner))}";
    END
    IF type__optional?(t) THEN
      MUTABLE wrapped = UNWRAP (TRY (type__wrapped_type(t)));
      MUTABLE inner = TRY (clearParser__type_annotation_source(rtoc_self_view, wrapped));
      IF (type__array?(wrapped) OR type__map?(wrapped)) THEN
        RETURN "?(${inner})";
      ELSE
        RETURN "?${inner}";
      END
    END
    MUTABLE base = COPY (type__strip_capability_suffix_from("${type__resolved(t)}")).base;
    MUTABLE capabilities: []String = List[];
    # A string literal assigned into an ?String slot is wrapped before the
    # copy, so the dupe receives an optional. Name the text plainly.
    MUTABLE collection: String = "";
    IF type__collection(t) EXISTS AS collection_kind THEN
      PARTIAL MATCH collection_kind START
        :list -> collection = "list";,
        :pool -> collection = "pool";,
        :set -> collection = "set";,
        DEFAULT -> collection = "";
      END
    END
    IF (collection.length() > 0) THEN
      MUTABLE rendered = COPY collection;
      IF type__soa?(t) THEN
        rendered = (rendered $+ ":soa");
      END
      IF type__sharded?(t) THEN
        IF type__shard_count(t) EXISTS AS shard_count THEN
          rendered = (rendered $+ ":sharded(${shard_count.toString()})");
        END
      END
      &capabilities.append(COPY rendered);
    END
    MUTABLE ownership: String = "";
    IF type__ownership(t) EXISTS AS ownership_kind THEN
      PARTIAL MATCH ownership_kind START
        :shared -> ownership = "shared";,
        :shared_node -> ownership = "shared:node";,
        :multiowned -> ownership = "multiowned";,
        :link -> ownership = "link";,
        :split -> ownership = "split";,
        :frozen -> ownership = "frozen";,
        DEFAULT -> ownership = "";
      END
    END
    IF (ownership.length() > 0) THEN
      &capabilities.append(COPY ownership);
    END
    MUTABLE sync: String = "";
    IF type__sync(t) EXISTS AS sync_kind THEN
      PARTIAL MATCH sync_kind START
        :locked -> sync = "locked";,
        :write_locked -> sync = "writeLocked";,
        :versioned -> sync = "versioned";,
        :atomic -> sync = "atomic";,
        :local -> sync = "local";,
        :always_mutable -> sync = "alwaysMutable";,
        DEFAULT -> sync = "";
      END
    END
    IF (sync.length() > 0) THEN
      &capabilities.append(COPY sync);
    END
    IF type__observable?(t) THEN
      &capabilities.append("observable");
    END
    IF (capabilities.length() == 0) THEN
      RETURN base;
    ELSE
      RETURN "${base}@${capabilities.join(":")}";
    END
}
END
