REQUIRE "pkg:rtoc_6173742f747970652e636c656172"
REQUIRE "pkg:rtoc_6173742f73796d626f6c5f656e7472792e636c656172"
REQUIRE "pkg:rtoc_6173742f6173742e636c656172"
REQUIRE "pkg:rtoc_6173742f6c657865722e636c656172"
REQUIRE "pkg:rtoc_6173742f706172616d2e636c656172"
PUB STRUCT Scope {
  binding_entries: {String}SymbolEntry@multiowned,
  bindings: ScopeBindings@multiowned,
  dependencies: {String}String,
  depth: Int64,
  owned_names: [Set]String,
  parent: ?Scope@multiowned,
  type_store: ScopeTypes@multiowned,
  types: {String@symbol}ScopeTypeEntry
}

PUB UNION ScopeMutabilityInput { BoolValue: Bool, TokenMultiowned: Token@multiowned, Token: Token }
PUB STRUCT ScopeTypeEntry {
  schema: SchemaValue
}
STRUCT ScopeBindings {
  entries: {String}SymbolEntry@multiowned
}

FN scopeBindings__initialize(MUTABLE self: ScopeBindings) RETURNS Void ->
    self.entries = {};
END
FN scopeBindings__get_index(self: ScopeBindings, name: String) RETURNS ?SymbolEntry@multiowned
  EFFECTS REENTRANT ->
    RETURN KEEP self.entries[name];
END
FN scopeBindings__set_index(MUTABLE self: ScopeBindings, name: String, entry: SymbolEntry) RETURNS SymbolEntry@multiowned
  EFFECTS REENTRANT ->
    self.entries[name] = entry;
    MUTABLE rtoc_owned_return_1: SymbolEntry@multiowned = entry;
    RETURN rtoc_owned_return_1;
END
FN scopeBindings__key?(self: ScopeBindings, name: String) RETURNS Bool
  EFFECTS REENTRANT ->
    RETURN self.entries.contains?(name);
END
FN scopeBindings__keys(self: ScopeBindings) RETURNS ![]String
  EFFECTS REENTRANT ->
    RETURN self.entries.keys();
END
PUB FN scopeBindings__length(self: ScopeBindings) RETURNS Int64
  EFFECTS REENTRANT ->
    RETURN self.entries.count();
END
FN scopeBindings__pairs(self: ScopeBindings) RETURNS ![]Tuple<String, SymbolEntry@multiowned> ->
    MUTABLE rtoc_tuple_return_2 = ( { MUTABLE rtoc_tuple_results = CAST([] AS []Tuple<String, SymbolEntry@multiowned>); self.entries.keys() |> EACH { &rtoc_tuple_results.append(COPY CAST(Tuple{COPY _, COPY (self.entries[_] OR_ELSE CAST(panic("missing hash key") AS SymbolEntry@multiowned))} AS Tuple<String, SymbolEntry@multiowned>)); }; rtoc_tuple_results } );
    RETURN rtoc_tuple_return_2;
END
FN scopeBindings__each(self: ScopeBindings, block: FN(String, SymbolEntry) -> Void) RETURNS Void
  EFFECTS REENTRANT ->
    FOR rtoc_each_key IN self.entries.keys() DO
    MUTABLE entry: SymbolEntry@multiowned = COPY UNWRAP (self.entries[rtoc_each_key]);
    block(rtoc_each_key, entry);
    END
    NIL;
END
FN scopeBindings__new() RETURNS ScopeBindings@multiowned ->
  MUTABLE self = ScopeBindings{ entries: {} };
  scopeBindings__initialize(&self);
  RETURN self @multiowned;
END
STRUCT ScopeTypes {
  entries: {String@symbol}ScopeTypeEntry
}

FN scopeTypes__initialize(MUTABLE self: ScopeTypes) RETURNS Void ->
    self.entries = {};
END
FN scopeTypes__declare(MUTABLE self: ScopeTypes, name: String@symbol, schema: SchemaValue) RETURNS ScopeTypeEntry ->
    self.entries[name] = COPY ScopeTypeEntry{ schema: COPY schema };
    RETURN ScopeTypeEntry{ schema: COPY schema };
END
FN scopeTypes__get_index(self: ScopeTypes, name: String@symbol) RETURNS !?ScopeTypeEntry
  EFFECTS REENTRANT ->
    RETURN COPY self.entries[name];
END
# TRY (scopeTypes__keys()) hands back map-owned Strings, not interned handles; see KeyList.
FN scopeTypes__keys(self: ScopeTypes) RETURNS ![]String
  EFFECTS REENTRANT ->
    RETURN self.entries.keys();
END
FN scopeTypes__new() RETURNS ScopeTypes@multiowned ->
  MUTABLE self = ScopeTypes{ entries: {} };
  scopeTypes__initialize(&self);
  RETURN self @multiowned;
END
FN scope__initialize(MUTABLE self: Scope) RETURNS Void ->
    self.parent = NIL;
    self.bindings = scopeBindings__new();
    self.binding_entries = COPY self.bindings.entries;
    self.dependencies = {};
    self.type_store = scopeTypes__new();
    self.types = COPY self.type_store.entries;
    self.owned_names = Set[];
    self.depth = 0;
END
PUB FN scope__declare(MUTABLE self: Scope, name: String, reg: ?SymbolEntryRegInput, type: ?SymbolEntryTypeInput, is_mutable: ?ScopeMutabilityInput = ScopeMutabilityInput{ BoolValue: TRUE }, is_rebindable: Bool = FALSE, size: ?Int64 = NIL, storage: String@symbol = :stack, capabilities: [Set]String@symbol = Set[], ignored_borrowed_paths: []SymbolEntry = List[], sync_value: ?String@symbol = NIL, layout: ?String@symbol = NIL, resource: ?Bool = NIL, close_plan: ?ResourceClosePlan = NIL) RETURNS !SymbolEntry@multiowned ->
    &self.owned_names.insert(COPY name);
    MUTABLE entry = TRY (symbolEntry__new(reg, type, !(!(is_mutable)), storage, sync_value, layout, is_rebindable, (size OR_ELSE 0), capabilities, TRUE, NIL, resource, close_plan));
    entry.scope = COPY self;
    entry.scope_depth = self.depth;
    scopeBindings__set_index(&self.bindings, name, entry);
    RETURN entry;
END
FN scope__install_entry(MUTABLE self: Scope, name: String, MUTABLE entry: SymbolEntry, owned: Bool = TRUE) RETURNS SymbolEntry@multiowned ->
    IF owned THEN
      &self.owned_names.insert(COPY name);
    END
    entry.scope = COPY self;
    entry.scope_depth = self.depth;
    scopeBindings__set_index(&self.bindings, name, entry);
    MUTABLE rtoc_owned_return_3: SymbolEntry@multiowned = entry;
    RETURN rtoc_owned_return_3;
END
FN scope__initialize_copy(MUTABLE self: Scope, original: Scope) RETURNS Void ->
    self.parent = COPY original;
    self.bindings = scopeBindings__new();
    self.binding_entries = COPY self.bindings.entries;
    self.dependencies = COPY original.dependencies;
    self.type_store = scopeTypes__new();
    self.types = COPY self.type_store.entries;
    self.owned_names = Set[];
END
PUB FN scope__live_param_syms(fn_value: FunctionDef) RETURNS !{String}SymbolEntry@multiowned ->
  RETURN fn_value.params |> REDUCE({}) {
  IF _.symbol THEN
      acc[CAST(_.name AS String)] = _.symbol;
  END
  acc
  };
END
PUB FN scope__install_type(MUTABLE self: Scope, name: String@symbol, schema: SchemaValue) RETURNS ScopeTypeEntry ->
    RETURN scopeTypes__declare(&self.type_store, name, schema);
END
PUB FN scope__declare_type(MUTABLE self: Scope, name: String@symbol, schema: SchemaValue) RETURNS ScopeTypeEntry ->
  scope__install_type(&self, name, schema);
END
PUB FN scope__resolve_type_definition(self: Scope, name: String@symbol) RETURNS !?SchemaValue ->
    IF TRY (scope__resolve_type_entry(self, name)) != NIL THEN
    RETURN COPY ((TRY (scope__resolve_type_entry(self, name)))?).schema;
    ELSE
    RETURN NIL;
    END
END
PUB FN scope__resolve_type_entry(self: Scope, name: String@symbol) RETURNS !?ScopeTypeEntry ->
    MUTABLE local: ?ScopeTypeEntry = COPY TRY (scopeTypes__get_index(self.type_store, name));
    IF local EXISTS AS local_value THEN
      RETURN COPY local_value;
    END
    MUTABLE cursor: ?Scope@multiowned = COPY self.parent;
    WHILE !((cursor == NIL)) DO
      MUTABLE ancestor = cursor?;
      MUTABLE inherited: ?ScopeTypeEntry = COPY ancestor.types[name];
      IF inherited EXISTS AS inherited_value THEN
        RETURN COPY inherited_value;
      END
      cursor = COPY KEEP ancestor.parent;
    END
    RETURN NIL;
END
FN scope__visible_types(self: Scope) RETURNS !{String@symbol}ScopeTypeEntry ->
    MUTABLE visible = COPY self.types;
    MUTABLE cursor: ?Scope@multiowned = COPY self.parent;
    WHILE !((cursor == NIL)) DO
      MUTABLE ancestor = cursor?;
      FOR rtoc_each_key IN ancestor.types.keys() DO
    MUTABLE entry: ScopeTypeEntry = COPY UNWRAP (ancestor.types[rtoc_each_key]);
      IF !(visible.contains?(rtoc_each_key)) THEN
        visible[rtoc_each_key] = COPY entry;
      END
      END
      cursor = COPY KEEP ancestor.parent;
    END
    RETURN visible;
END
PUB FN scope__local_entry(self: Scope, name: String) RETURNS ?SymbolEntry@multiowned ->
    RETURN KEEP scopeBindings__get_index(self.bindings, name);
END
PUB FN scope__local_entry_mut(MUTABLE self: Scope, name: String) RETURNS SymbolEntry@multiowned ->
    RETURN UNWRAP (scope__local_entry(self, name));
END
PUB FN scope__resolve_entry(self: Scope, name: String) RETURNS ?SymbolEntry@multiowned ->
    MUTABLE local: ?SymbolEntry@multiowned = COPY scopeBindings__get_index(self.bindings, name);
    IF local EXISTS AS local_value THEN
      RETURN COPY local_value;
    END
    MUTABLE cursor: ?Scope@multiowned = COPY self.parent;
    WHILE !((cursor == NIL)) DO
      MUTABLE ancestor = cursor?;
      MUTABLE inherited: ?SymbolEntry@multiowned = COPY ancestor.binding_entries[name];
      IF inherited EXISTS AS inherited_value THEN
        RETURN KEEP inherited_value;
      END
      cursor = COPY KEEP ancestor.parent;
    END
    RETURN NIL;
END
FN scope__resolve_entry_mut(MUTABLE self: Scope, name: String) RETURNS SymbolEntry@multiowned ->
    RETURN UNWRAP (scope__resolve_entry(self, name));
END
FN scope__local_entry?(MUTABLE self: Scope, name: String) RETURNS Bool ->
    RETURN scopeBindings__key?(self.bindings, name);
END
PUB FN scope__entry?(MUTABLE self: Scope, name: String) RETURNS Bool ->
    RETURN !((scope__resolve_entry(self, name) == NIL));
END
PUB FN scope__entry_for_write(MUTABLE self: Scope, name: String) RETURNS ?SymbolEntry@multiowned ->
    MUTABLE entry: ?SymbolEntry@multiowned = COPY scopeBindings__get_index(self.bindings, name);
    IF entry EXISTS AS entry_value THEN
      RETURN COPY entry_value;
    END
    MUTABLE inherited: ?SymbolEntry@multiowned = scope__resolve_entry(self, name);
    IF inherited EXISTS AS inherited_value THEN
      MUTABLE inherited_value_mutable = COPY inherited_value;
      MUTABLE materialized = scope__clone_entry_for_scope(self, inherited_value_mutable);
      scopeBindings__set_index(&self.bindings, name, materialized);
      RETURN materialized;
    ELSE
      RETURN NIL;
    END
END
PUB FN scope__entry_for_write_mut(MUTABLE self: Scope, name: String) RETURNS SymbolEntry@multiowned ->
    RETURN UNWRAP (scope__entry_for_write(&self, name));
END
PRIVATE FN scope__clone_entry_for_scope(self: Scope, entry: SymbolEntry) RETURNS SymbolEntry@multiowned ->
    MUTABLE new_entry = COPY entry;
    IF entry.capabilities.empty?() THEN
      new_entry.capabilities = Set[];
    ELSE
      new_entry.capabilities = COPY entry.capabilities;
    END
    new_entry.scope = COPY self;
    RETURN new_entry;
END
FN scope__local_entries(self: Scope) RETURNS !{String}SymbolEntry@multiowned ->
    RETURN COPY self.bindings.entries;
END
FN scope__local_entry_count(self: Scope) RETURNS Int64 ->
    RETURN scopeBindings__length(self.bindings);
END
FN scope__visible_entry_count(MUTABLE self: Scope) RETURNS !Int64 ->
    RETURN TRY (scope__count_visible_entries_mut(&self, Set[]));
END
FN scope__count_visible_entries_mut(MUTABLE self: Scope, MUTABLE seen: [Set]String) RETURNS !Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE count: Int64 = 0;
    MUTABLE cursor: ?Scope@multiowned = rtoc_self_view;
    WHILE !((cursor == NIL)) DO
      MUTABLE current = cursor?;
      FOR _ IN current.binding_entries.keys() DO
    IF seen.contains?(_) THEN
      CONTINUE;
    END
    &seen.insert(COPY _);
    count = (count + 1);
      END
      cursor = COPY KEEP current.parent;
    END
    RETURN count;
}
END
PUB FN scope__visible_entries(self: Scope) RETURNS !{String}SymbolEntry@multiowned ->
    MUTABLE visible = COPY self.binding_entries;
    MUTABLE cursor: ?Scope@multiowned = COPY self.parent;
    WHILE !((cursor == NIL)) DO
      MUTABLE ancestor = cursor?;
      FOR rtoc_each_key IN ancestor.binding_entries.keys() DO
    MUTABLE entry: SymbolEntry@multiowned = COPY UNWRAP (ancestor.binding_entries[rtoc_each_key]);
      IF !(visible.contains?(rtoc_each_key)) THEN
        visible[rtoc_each_key] = COPY entry;
      END
      END
      cursor = COPY KEEP ancestor.parent;
    END
    RETURN visible;
END
PUB FN scope__visible_names(self: Scope) RETURNS ![]String ->
    MUTABLE names: []String = List[];
    MUTABLE seen: [Set]String = Set[];
    TRY (scope__append_visible_names_mut(self, &names, &seen));
    RETURN names;
END
FN scope__append_visible_names_mut(self: Scope, MUTABLE names: []String, MUTABLE seen: [Set]String) RETURNS !Void ->
    FOR _ IN (TRY (scope__visible_entries(self))).keys() DO
    IF seen.contains?(_) THEN
      CONTINUE;
    END
    &seen.insert(COPY _);
    &names.append(COPY _);
    END
    NIL;
END
PUB FN scope__owned_entries(self: Scope) RETURNS ![]Tuple<String, SymbolEntry@multiowned> ->
    MUTABLE rtoc_tuple_return_5 = ( { MUTABLE rtoc_tuple_results = CAST([] AS []Tuple<String, SymbolEntry@multiowned>); self.owned_names |> EACH { IF scopeBindings__get_index(self.bindings, _) != NIL THEN &rtoc_tuple_results.append(COPY CAST(Tuple{_, (scopeBindings__get_index(self.bindings, _))?} AS Tuple<String, SymbolEntry@multiowned>)); END }; rtoc_tuple_results } );
    RETURN rtoc_tuple_return_5;
END
PUB FN scope__resolve_full_type(self: Scope, name: String) RETURNS !Type ->
    MUTABLE entry: ?SymbolEntry@multiowned = scope__resolve_entry(self, name);
    IF entry EXISTS AS entry_value THEN
      MUTABLE entry_value_mutable = COPY entry_value;
      MUTABLE base_type = TRY (type__new(TypeConstructionInput{ Type: COPY symbolEntry__type(entry_value_mutable) }));
      MUTABLE value_sync: ?String@symbol = NIL;
      IF symbolEntry__locked?(entry_value_mutable) THEN
        value_sync = :locked;
      ELSE_IF symbolEntry__write_locked?(entry_value_mutable) THEN
        value_sync = :write_locked;
      END
      TRY (type__apply_symbol_overlay_mut(&base_type, symbolEntry__storage(entry_value_mutable), symbolEntry__sync(entry_value_mutable), symbolEntry__layout(entry_value_mutable), value_sync, symbolEntry__link_source(entry_value_mutable), symbolEntry__atomic_ptr?(entry_value_mutable)));
      RETURN base_type;
    ELSE
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }));
    END
END
PUB FN scope__resolve_type(self: Scope, name: String) RETURNS !Type ->
    MUTABLE entry: ?SymbolEntry@multiowned = scope__resolve_entry(self, name);
    IF entry EXISTS AS entry_value THEN
      RETURN CAST(symbolEntry__type(entry_value) AS Type);
    ELSE
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }));
    END
END
PRIVATE FN scope__is_mutable?(self: Scope, name: String) RETURNS Bool ->
    MUTABLE entry: ?SymbolEntry@multiowned = scope__resolve_entry(self, name);
    IF entry EXISTS AS entry_value THEN
      RETURN entry_value.mutable;
    ELSE
      RETURN TRUE;
    END
END
PUB FN scope__is_immutable?(self: Scope, name: String) RETURNS Bool ->
    RETURN !(scope__is_mutable?(self, name));
END
PUB FN scope__is_restricted?(self: Scope, name: String) RETURNS Bool ->
    RETURN !(!((scope__resolve_entry(self, name)?.capabilities).contains?(symbol("RESTRICT"))));
END
PUB FN scope__mark_read(MUTABLE self: Scope, name: String) RETURNS Void ->
    MUTABLE entry: ?SymbolEntry@multiowned = scope__entry_for_write(&self, name);
    IF entry EXISTS AS entry_value THEN
      MUTABLE entry_value_mutable = COPY entry_value;
      symbolEntry__mark_read_mut(&entry_value_mutable);
    ELSE
      RETURN;
    END
END
PUB FN scope__declare_with_new_capability(MUTABLE self: Scope, capability: Capability) RETURNS ?SymbolEntry@multiowned ->
    MUTABLE var_node: Locatable = CAST(capability.var_node AS Locatable);
    MUTABLE old_scope: Scope@multiowned = CAST(capability.old_scope AS Scope@multiowned);
    MUTABLE name = COPY (UNWRAP (aST__root_identifier(var_node))).name;
    MUTABLE local: ?SymbolEntry@multiowned = scope__resolve_entry(old_scope, name);
    IF local EXISTS AS local_value THEN
      MUTABLE local_value_mutable = COPY local_value;
      MUTABLE local_value_mutable = OWN COPY local_value_mutable;
      local_value_mutable.capabilities = COPY local_value_mutable.capabilities;
      &local_value_mutable.capabilities.insert(symbol(UNWRAP (COPY capability.capability)));
      local_value_mutable.scope = COPY self;
      scopeBindings__set_index(&self.bindings, name, local_value_mutable);
      RETURN local_value_mutable;
    ELSE
      RETURN NIL;
    END
END
PUB FN scope__get_path_to_root(self: Scope, node: Locatable) RETURNS ![]String@symbol ->
    MUTABLE path: []String@symbol = List[];
    MUTABLE curr = COPY node;
    WHILE TRUE DO
      MUTABLE next_curr: ?Locatable = NIL;
      IF curr IS_A GetField AS get_field THEN
        &path.append(symbol(get_field.field));
        next_curr = COPY get_field.target;
      ELSE_IF curr IS_A GetIndex AS get_index THEN
        &path.append(symbol("*"));
        next_curr = COPY get_index.target;
      ELSE
        BREAK;
      END
      curr = UNWRAP (next_curr);
    END
    &path.append(symbol(castLocatableToIdentifier__scope(curr).name));
    MUTABLE reversed: []String@symbol = List[];
    MUTABLE i = (path.length() - 1);
    WHILE (i >= 0) DO
      &reversed.append(symbol(UNWRAP (path[i])));
      i = (i - 1);
    END
    RETURN reversed;
END
PUB FN scope__check_validity_mut(MUTABLE self: Scope, name: String) RETURNS !Void ->
    MUTABLE entry: ?SymbolEntry@multiowned = scope__resolve_entry(self, name);
    IF entry EXISTS AS entry_value THEN
      IF (symbolEntry__valid(entry_value) == FALSE) THEN
        panic("Compile Error: Cannot use variable '{}'. Reason: {}");
      END
    ELSE
      RETURN;
    END
END
PUB FN scope__new() RETURNS Scope@multiowned ->
  MUTABLE self = Scope{ binding_entries: {}, bindings: scopeBindings__new(), dependencies: {}, depth: 0, owned_names: Set[], parent: NIL, type_store: scopeTypes__new(), types: {} };
  scope__initialize(&self);
  RETURN self @multiowned;
END
# Ruby module ScopeHelper
FN castLocatableToIdentifier__scope(value: Locatable) RETURNS Identifier ->
  IF value IS_A Identifier AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to Identifier");
END

# Ruby reads class.name and strips the module prefix; the variant name is
# that name.
PUB FN scopeScopeTypeSchema__variant_name(value: SchemaValue) RETURNS String ->
  PARTIAL MATCH value START
    SchemaValue.EnumSchemaMultiowned AS item -> RETURN "EnumSchemaMultiowned";,
    SchemaValue.ResourceSchemaMultiowned AS item -> RETURN "ResourceSchemaMultiowned";,
    SchemaValue.StructSchemaMultiowned AS item -> RETURN "StructSchemaMultiowned";,
    SchemaValue.UnionSchemaMultiowned AS item -> RETURN "UnionSchemaMultiowned";,
    DEFAULT -> RETURN "";
  END
  RETURN "";
END

# Ruby asks `respond_to?(:extern_module)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN scopeScopeTypeSchema__extern_module(value: SchemaValue) RETURNS ?String ->
  PARTIAL MATCH value START
    SchemaValue.ResourceSchemaMultiowned AS item -> RETURN COPY item.extern_module;,
    SchemaValue.StructSchemaMultiowned AS item -> RETURN COPY item.extern_module;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END

# Ruby asks `respond_to?(:methods)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN scopeScopeTypeSchema__methods(value: SchemaValue) RETURNS ?{String@symbol}FunctionSignature@multiowned ->
  PARTIAL MATCH value START
    SchemaValue.ResourceSchemaMultiowned AS item -> RETURN COPY item.methods;,
    SchemaValue.StructSchemaMultiowned AS item -> RETURN COPY item.methods;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END

# Ruby asks `respond_to?(:fields)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN scopeScopeTypeSchema__fields(value: SchemaValue) RETURNS ?{String}StructField ->
  PARTIAL MATCH value START
    SchemaValue.ResourceSchemaMultiowned AS item -> RETURN COPY item.fields;,
    SchemaValue.StructSchemaMultiowned AS item -> RETURN COPY item.fields;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
