PUB FN stdLibRegistry__table(name: String@symbol) RETURNS !{String}[]FunctionSignature@multiowned ->
  IF (name == :std_lib) THEN
    RETURN TRY (stdLibRegistry__std_lib());
  END
  IF (name == :pool_methods) THEN
    RETURN TRY (stdLibRegistry__pool_methods());
  END
  IF (name == :set_methods) THEN
    RETURN TRY (stdLibRegistry__set_methods());
  END
  IF (name == :map_methods) THEN
    RETURN TRY (stdLibRegistry__map_methods());
  END
  IF (name == :index_ops) THEN
    RETURN TRY (stdLibRegistry__index_ops());
  END
  IF (name == :builtin_ops) THEN
    RETURN TRY (stdLibRegistry__builtin_ops());
  END
  RETURN {};
END
