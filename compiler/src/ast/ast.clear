    Locatable.ReassignCleanup AS cast_payload -> RETURN Node{ ReassignCleanup: COPY cast_payload };,
    Locatable.FieldCleanup AS cast_payload -> RETURN Node{ FieldCleanup: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Node");
  END
  panic("Invalid cast to Node");
END



