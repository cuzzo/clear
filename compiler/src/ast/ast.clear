    Locatable.RecoverOp AS item -> RETURN aST__token_identity(item.token, 84);,
    Locatable.BlockExpr AS item -> RETURN aST__token_identity(item.token, 85);,
    Locatable.StringConcat AS item -> RETURN aST__token_identity(item.token, 86);,
    Locatable.CapabilityWrap AS item -> RETURN aST__token_identity(item.token, 87);,
    Locatable.MoveNode AS item -> RETURN aST__token_identity(item.token, 88);,
    Locatable.CopyNode AS item -> RETURN aST__token_identity(item.token, 89);,
    Locatable.KeepNode AS item -> RETURN aST__token_identity(item.token, 90);,
    Locatable.ShareNode AS item -> RETURN aST__token_identity(item.token, 91);,
    Locatable.LinkNode AS item -> RETURN aST__token_identity(item.token, 92);,
    Locatable.ResolveNode AS item -> RETURN aST__token_identity(item.token, 93);,
    Locatable.FreezeNode AS item -> RETURN aST__token_identity(item.token, 94);,
    Locatable.PassStmt AS item -> RETURN aST__token_identity(item.token, 95);,
    Locatable.StructPattern AS item -> RETURN aST__token_identity(item.token, 96);,
    Locatable.RangeLit AS item -> RETURN aST__token_identity(item.token, 97);,
    Locatable.ExternFnDecl AS item -> RETURN aST__token_identity(item.token, 98);,
    Locatable.ExternStructDecl AS item -> RETURN aST__token_identity(item.token, 99);,
    Locatable.EnumDef AS item -> RETURN aST__token_identity(item.token, 100);,
    Locatable.UnionDef AS item -> RETURN aST__token_identity(item.token, 101);,
    Locatable.UnionVariantLit AS item -> RETURN aST__token_identity(item.token, 102);,
    Locatable.StaticCall AS item -> RETURN aST__token_identity(item.token, 103);,
    Locatable.DoBlock AS item -> RETURN aST__token_identity(item.token, 104);,
    Locatable.BgBlock AS item -> RETURN aST__token_identity(item.token, 105);,
    Locatable.ThenChain AS item -> RETURN aST__token_identity(item.token, 106);,
    Locatable.BgStreamBlock AS item -> RETURN aST__token_identity(item.token, 107);,
    Locatable.YieldExpr AS item -> RETURN aST__token_identity(item.token, 108);,
    Locatable.CloseStream AS item -> RETURN aST__token_identity(item.token, 109);,
    Locatable.NextExpr AS item -> RETURN aST__token_identity(item.token, 110);,
    Locatable.MatchStatement AS item -> RETURN aST__token_identity(item.token, 111);,
    Locatable.ForRange AS item -> RETURN aST__token_identity(item.token, 112);,
    Locatable.ForEach AS item -> RETURN aST__token_identity(item.token, 113);,
    Locatable.TestBlock AS item -> RETURN aST__token_identity(item.token, 114);,
    Locatable.WhenBlock AS item -> RETURN aST__token_identity(item.token, 115);,
    Locatable.LetBinding AS item -> RETURN aST__token_identity(item.token, 116);,
    Locatable.TestThat AS item -> RETURN aST__token_identity(item.token, 117);,
    Locatable.AssertRaises AS item -> RETURN aST__token_identity(item.token, 118);,
    Locatable.BenchmarkStmt AS item -> RETURN aST__token_identity(item.token, 119);,
    Locatable.SmashStmt AS item -> RETURN aST__token_identity(item.token, 120);,
    Locatable.ProfileStmt AS item -> RETURN aST__token_identity(item.token, 121);,
    Locatable.StubDecl AS item -> RETURN aST__token_identity(item.token, 122);,
    Locatable.Drop AS item -> RETURN aST__token_identity(item.token, 123);,
    Locatable.SuppressCleanup AS item -> RETURN aST__token_identity(item.token, 124);,
    Locatable.Return AS item -> RETURN aST__token_identity(item.token, 125);,
    Locatable.ReassignCleanup AS item -> RETURN aST__token_identity(item.token, 126);,
    Locatable.FieldCleanup AS item -> RETURN aST__token_identity(item.token, 127);
  END
  RETURN 0;
END

PUB FN aST__node_needs_heap_create(node: Locatable) RETURNS ?Bool ->
  PARTIAL MATCH node START
    Locatable.Program AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.RequireNode AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.ProtocolRequirement AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.ProtocolDef AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.FunctionDef AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.ImplementationDef AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.ConformanceDef AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.StructDef AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.VarDecl AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.Assignment AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.DestructureTarget AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.DestructuringAssignment AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.BindExpr AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.BinaryOp AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.IsA AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.UnaryOp AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.CallSiteOverride AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.Identifier AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.Literal AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.ListLit AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.TupleLit AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.DefaultArrayLit AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.HashLit AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.DefaultLit AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.StructLit AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.LambdaLit AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.IfStatement AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.IfBind AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.WhileLoop AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.WhileBindLoop AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.BreakNode AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.ContinueNode AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.FuncCall AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.MethodCall AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.GetField AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.GetIndex AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.Cast AS item -> RETURN COPY item.needs_heap_create;,
    Locatable.ReturnNode AS item -> RETURN COPY item.needs_heap_create;,
