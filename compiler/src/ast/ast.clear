PUB FN dedupeStrings(values: []String) RETURNS []String ->
  MUTABLE seen: [Set]String = Set[];
  MUTABLE unique: []String = [];
  FOR rtoc_dedupe_item IN values DO
    IF !(seen.contains?(rtoc_dedupe_item)) THEN
      &seen.insert(COPY rtoc_dedupe_item);
      &unique.append(COPY rtoc_dedupe_item);
    END
  END
  RETURN unique;
END
PUB FN aST__node_left(node: Locatable) RETURNS ?Locatable ->
  PARTIAL MATCH node START
    Locatable.BinaryOp AS item -> RETURN COPY item.left;,
    Locatable.IsA AS item -> RETURN COPY item.left;
  END
  RETURN NIL;
END
PUB FN binaryOp__smooth?(self: BinaryOp) RETURNS Bool ->
  RETURN (self.op == :SMOOTH);
END
PUB FN aST__pipeline_range_fold?(node: Locatable) RETURNS Bool ->
  PARTIAL MATCH node START
    Locatable.CountOp AS item -> RETURN TRUE;,
    Locatable.SumOp AS item -> RETURN TRUE;,
    Locatable.AverageOp AS item -> RETURN TRUE;,
    Locatable.MinOp AS item -> RETURN TRUE;,
    Locatable.MaxOp AS item -> RETURN TRUE;,
    Locatable.AnyOp AS item -> RETURN TRUE;,
    Locatable.AllOp AS item -> RETURN TRUE;,
    Locatable.FindOp AS item -> RETURN TRUE;
  END
  RETURN FALSE;
END
PUB FN whereOp__expression(self: WhereOp) RETURNS Locatable ->
  RETURN COPY self.expression;
END
PUB FN bodySlot__writer_call(self: BodySlot, arg0: Locatable[]) RETURNS Void ->
  MUTABLE fn_value = self.writer;
  RETURN fn_value(arg0);
END
PUB FN aST__pipeline_select_filter_op?(node: Locatable) RETURNS Bool ->
  PARTIAL MATCH node START
    Locatable.SelectOp AS item -> RETURN TRUE;,
    Locatable.WhereOp AS item -> RETURN TRUE;
  END
  RETURN FALSE;
END
PUB FN selectOp__expression(self: SelectOp) RETURNS Locatable ->
  RETURN COPY self.expression;
END
PUB FN nextExpr__expr(self: NextExpr) RETURNS Locatable ->
  RETURN COPY self.expr;
END
PUB FN allOp__expression(self: AllOp) RETURNS ?Locatable ->
  RETURN COPY self.expression;
END
PUB FN anyOp__expression(self: AnyOp) RETURNS ?Locatable ->
  RETURN COPY self.expression;
END
PUB FN averageOp__expression(self: AverageOp) RETURNS ?Locatable ->
  RETURN COPY self.expression;
END
PUB FN countOp__expression(self: CountOp) RETURNS ?Locatable ->
  RETURN COPY self.expression;
END
PUB FN findOp__expression(self: FindOp) RETURNS ?Locatable ->
  RETURN COPY self.expression;
END
PUB FN maxOp__expression(self: MaxOp) RETURNS ?Locatable ->
  RETURN COPY self.expression;
END
PUB FN minOp__expression(self: MinOp) RETURNS ?Locatable ->
  RETURN COPY self.expression;
END
PUB FN selectOp__capture_analysis(self: SelectOp) RETURNS ?CaptureAnalysis ->
  RETURN COPY self.capture_analysis;
END
PUB FN sumOp__expression(self: SumOp) RETURNS ?Locatable ->
  RETURN COPY self.expression;
END
PUB FN takeWhileOp__expression(self: TakeWhileOp) RETURNS ?Locatable ->
  RETURN COPY self.expression;
END
PUB FN unnestOp__expression(self: UnnestOp) RETURNS ?Locatable ->
  RETURN COPY self.expression;
END
PUB FN aST__node_right(node: Locatable) RETURNS ?Locatable ->
  PARTIAL MATCH node START
    Locatable.BinaryOp AS item -> RETURN COPY item.right;,
    Locatable.UnaryOp AS item -> RETURN COPY item.right;
  END
  RETURN NIL;
END
PUB FN unnestRightName(node: Locatable) RETURNS String ->
  IF node IS_A Identifier AS direct_identifier THEN
    RETURN COPY direct_identifier.name;
  END
  IF aST__node_right(node) EXISTS AS right_node THEN
    IF right_node IS_A Identifier AS identifier THEN
      RETURN COPY identifier.name;
    END
  END
  RETURN COPY "";
END
PUB FN aST__capture_expr_source_type(node: Locatable) RETURNS !Type ->
  IF aST__node_error_union_type(node) EXISTS AS fallible THEN
    RETURN COPY fallible;
  END
  RETURN TRY (aST__full_type_mut(node));
END
PUB FN aST__capture_expr_owns_result?(node: ?Locatable) RETURNS !Bool ->
  IF !(node EXISTS) THEN
    RETURN FALSE;
  END
  MUTABLE current: Locatable = COPY UNWRAP (node);
  WHILE current IS_A Cast DO
    PARTIAL MATCH current START
      Locatable.Cast AS cast_node -> current = COPY cast_node.value;
    END
  END
  IF aST__borrowed_ownership_view?(current) THEN
    RETURN FALSE;
  END
  IF aST__call?(current) THEN
    IF aST__node__matched_signature(current) EXISTS AS signature THEN
      IF !((TRY (functionSignature__return_lifetime(signature))).empty?()) THEN
        RETURN FALSE;
      END
    END
  END
  RETURN (((((aST__call?(current) OR current IS_A NextExpr) OR current IS_A ResolveNode) OR current IS_A CopyNode) OR current IS_A KeepNode) OR ((current IS_A MoveNode) OR (current IS_A ShareNode)));
END
PUB FN aST__call?(node: Locatable) RETURNS Bool ->
  RETURN ((node IS_A FuncCall) OR (node IS_A MethodCall));
END
