PUB STRUCT ErrorSelector {
  form: String@symbol,
  name: String@symbol,
  token: ?Token
}
PUB ENUM ErrorActionKind { Raise, Pass, Return, Exit, Block }
PUB STRUCT ErrorAction {
  action: ErrorActionKind,
  token: ?Token,
  value: ?Locatable@boxed,
  message: ?Locatable@boxed,
  body: []Locatable
}
PUB STRUCT ErrorClause {
  selectors: []ErrorSelector,
  action: ErrorActionKind,
  retries: ?Int64,
  token: ?Token,
  value: ?Locatable@boxed,
  message: ?Locatable@boxed,
  body: []Locatable,
  matched_types: []String@symbol,
  bubble_types: []String@symbol
}
PUB FN methodCall__mark_explicit_mutable_receiver_mut(MUTABLE self: MethodCall, token: Token) RETURNS Void ->
  self.explicit_mutable_receiver_token = COPY token;
END
PUB FN bgStreamBlock__set_yield_contract(MUTABLE self: BgStreamBlock, type: ?Type, token: ?Token) RETURNS Void ->
  self.declared_yield_type = COPY type;
  self.yields_token = COPY token;
END
PUB FN errorClause__from_action(selectors: []ErrorSelector, retries: ?Int64, action: ErrorAction) RETURNS ErrorClause ->
  RETURN ErrorClause{ selectors: COPY selectors, action: COPY action.action, retries: retries, token: COPY action.token, value: COPY action.value, message: COPY action.message, body: COPY action.body, matched_types: List[], bubble_types: List[] };
