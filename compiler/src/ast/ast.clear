# `op` means two different things across Locatable: a symbol on BinaryOp and
# UnaryOp, a pipeline op on ConcurrentOp. Ruby picks by the receiver's class;
# this reader answers the symbol question, and a ConcurrentOp receiver is
# narrowed at its call sites instead.
PUB FN locatable__symbol_op(value: Locatable) RETURNS ?String@symbol ->
  PARTIAL MATCH value START
    Locatable.BinaryOp AS item -> RETURN COPY item.op;,
    Locatable.UnaryOp AS item -> RETURN COPY item.op;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END

PUB FN castIsARightToLocatable(value: IsARight) RETURNS Locatable ->
  PARTIAL MATCH value START
    IsARight.Locatable AS cast_payload -> RETURN COPY cast_payload;,
    DEFAULT -> panic("Invalid cast to Locatable");
  END
  panic("Invalid cast to Locatable");
END
PUB FN castLocatableToNodeOrType(value: Locatable) RETURNS NodeOrType ->
