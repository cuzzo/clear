PUB FN aST__container_borrow?(node: ?Locatable) RETURNS Bool EFFECTS REENTRANT ->
  IF node EXISTS AS node_value THEN
    IF (TRUE AND (locatable__container_borrow(node_value) == TRUE)) THEN
      RETURN TRUE;
    END
    MUTABLE operand: ?Locatable = aST__borrow_transparent_operand(node_value);
    IF operand EXISTS AS operand_value THEN
      RETURN aST__container_borrow?(operand_value);
    ELSE
      RETURN FALSE;
    END
  ELSE
    RETURN FALSE;
  END
END
PUB FN aST__borrow_transparent_operand(node: Locatable) RETURNS ?Locatable ->
  IF node IS_A OptionalUnwrap AS optional_unwrap THEN
    RETURN COPY optional_unwrap.target;
  END
  IF node IS_A TenseNavigation AS tense_navigation THEN
    RETURN COPY tense_navigation.target;
  END
  IF node IS_A UnaryOp AS unary_op THEN
    IF (unary_op.op == :TRY) THEN
      RETURN COPY unary_op.right;
    END
  END
  IF node IS_A BinaryOp AS binary_op THEN
    IF ((binary_op.op == symbol("OR")) OR (binary_op.op == symbol("OR_ELSE"))) THEN
      RETURN COPY binary_op.left;
    END
  END
  RETURN NIL;
END
PUB FN aST__borrowed_ownership_view?(node: ?Locatable) RETURNS Bool ->
  IF node EXISTS AS node_value THEN
    IF (node_value IS_A CopyNode OR node_value IS_A KeepNode) THEN
      RETURN FALSE;
    END
    IF (IF node_value IS_A Identifier AS identifier THEN ((KEEP identifier.symbol != NIL) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_19 = ((KEEP identifier.symbol)?);
    symbolEntry__borrowed_alias(rtoc_local_receiver_19) }) ELSE FALSE END) THEN
      RETURN TRUE;
    END
    IF aST__container_borrow?(node_value) THEN
      RETURN TRUE;
    END
    IF node_value IS_A GetIndex AS get_index THEN
      RETURN TRUE;
    END
    IF node_value IS_A GetField AS get_field THEN
      MUTABLE root: ?Identifier = aST__root_identifier(Locatable{ GetField: COPY get_field });
      IF ((root?.token != NIL) AND (((root?.token)?).type == :TYPE_ID)) THEN
        RETURN FALSE;
      END
      MUTABLE sym: ?SymbolEntry@multiowned = NIL;
      IF root EXISTS AS root_value THEN
        sym = COPY KEEP root_value.symbol;
      END
      IF sym EXISTS AS sym_value THEN
        RETURN (symbolEntry__is_param(sym_value) OR (sym_value.reg != NIL));
      END
      RETURN FALSE;
    ELSE
      RETURN FALSE;
    END
  ELSE
    RETURN FALSE;
  END
END
PUB FN aST__inline_union_constructor_target?(node: ?Locatable) RETURNS Bool ->
  IF node? IS_A GetField AS get_field THEN
    MUTABLE target: Locatable = castLocatableToLocatable__ast(get_field.target);
    IF target IS_A Identifier AS identifier THEN
      RETURN !(!((regexMatch__ast?(identifier__name(identifier).substr(0, 1), "[A-Z]"))));
    ELSE
      RETURN FALSE;
    END
  ELSE
    RETURN FALSE;
  END
END
PUB FN aST__soa_placeholder_field?(node: ?Locatable) RETURNS Bool ->
  IF node? IS_A GetField AS get_field THEN
    MUTABLE target: Locatable = castLocatableToLocatable__ast(get_field.target);
    RETURN !(!(((IF target IS_A Identifier AS identifier THEN (identifier__name(identifier) == "_") ELSE FALSE END))));
  ELSE
    RETURN FALSE;
  END
END
PUB FN aST__soa_placeholder_assignment?(node: ?Locatable) RETURNS Bool ->
  IF node? IS_A BindExpr AS bind_expr THEN
    # BindExpr#name is always Identifier#name, i.e. a String, so the Ruby
    # soa_placeholder_field? call can never match a GetField.
    RETURN FALSE;
  END
  IF node? IS_A Assignment AS assignment THEN
    MUTABLE assignment: Assignment = COPY CAST(assignment AS Assignment);
    RETURN aST__soa_placeholder_field?(castAssignmentNameToOptionalLocatable__ast(assignment.name));
  END
  RETURN FALSE;
END
PUB FN aST__moved?(node: ?Locatable) RETURNS Bool ->
  RETURN !(!((((node != NIL) AND (locatable__was_moved(node) == TRUE)))));
END
