PUB FN binding__name(self: Binding) RETURNS String ->
  RETURN COPY self.name;
END
PUB FN binding__unwrapped_type(self: Binding) RETURNS Type ->
  RETURN COPY self.unwrapped_type;
END
PUB FN destructuringAssignment__targets(self: DestructuringAssignment) RETURNS []DestructureTarget ->
  RETURN COPY self.targets;
END
PUB FN distinctOp__expression(self: DistinctOp) RETURNS ?Locatable@boxed ->
  RETURN COPY self.expression;
END
PUB FN funcCall__name(self: FuncCall) RETURNS CallName@boxed ->
