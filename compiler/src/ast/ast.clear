    Locatable.SuppressCleanup AS item -> RETURN COPY item.token;,
    Locatable.Return AS item -> RETURN COPY item.token;,
    Locatable.ReassignCleanup AS item -> RETURN COPY item.token;,
    Locatable.FieldCleanup AS item -> RETURN COPY item.token;
  END
  RETURN CAST(panic("unreachable node accessor") AS Token);
END

