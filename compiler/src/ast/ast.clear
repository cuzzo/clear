# Ruby's `full_type=` normalises before storing: a Type is kept, a
# FunctionSignature is converted, anything else is constructed. This is that
# writer, so the union field store lives in exactly one place.
PUB FN aST__set_full_type_mut(MUTABLE node: Locatable, val: SyntheticTypeInput) RETURNS !Type ->
  MUTABLE resolved: Type = MATCH val START
    SyntheticTypeInput.TypeMultiowned AS item -> COPY item,
    SyntheticTypeInput.Type AS item -> COPY item,
    SyntheticTypeInput.FunctionSignatureMultiowned AS item -> TRY (type__from_function_signature(item)),
    SyntheticTypeInput.SymbolValue AS item -> TRY (type__new(TypeConstructionInput{ SymbolValue: COPY item })),
    SyntheticTypeInput.StringValue AS item -> TRY (type__new(TypeConstructionInput{ StringValue: COPY item }))
  END;
  locatable__set_type_object_mut(&node, resolved);
  RETURN COPY resolved;
END
# Ruby writes `capture_analysis` on whichever variant it holds. A variant either
# carries the field or it does not, so the write lands only where it fits.
PUB FN locatable__set_capture_analysis_mut(MUTABLE value: Locatable, new_value: ?CaptureAnalysis) RETURNS Void ->
  PARTIAL MATCH value START
    Locatable.SelectOp AS MUTABLE item -> item.capture_analysis = COPY new_value;,
    Locatable.ConcurrentOp AS MUTABLE item -> item.capture_analysis = COPY new_value;,
    Locatable.BgBlock AS MUTABLE item -> item.capture_analysis = COPY new_value;,
    Locatable.BgStreamBlock AS MUTABLE item -> item.capture_analysis = COPY new_value;,
    DEFAULT -> RETURN;
  END
END
