# Ruby asks `respond_to?(:matched_signature)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN node__matched_signature(value: Node) RETURNS ?FunctionSignature@multiowned ->
  PARTIAL MATCH value START
    Node.Program AS item -> RETURN COPY item.matched_signature;,
    Node.RequireNode AS item -> RETURN COPY item.matched_signature;,
    Node.ProtocolRequirement AS item -> RETURN COPY item.matched_signature;,
    Node.ProtocolDef AS item -> RETURN COPY item.matched_signature;,
    Node.FunctionDef AS item -> RETURN COPY item.matched_signature;,
    Node.ImplementationDef AS item -> RETURN COPY item.matched_signature;,
    Node.ConformanceDef AS item -> RETURN COPY item.matched_signature;,
    Node.StructDef AS item -> RETURN COPY item.matched_signature;,
    Node.VarDecl AS item -> RETURN COPY item.matched_signature;,
    Node.Assignment AS item -> RETURN COPY item.matched_signature;,
    Node.DestructureTarget AS item -> RETURN COPY item.matched_signature;,
    Node.DestructuringAssignment AS item -> RETURN COPY item.matched_signature;,
    Node.BindExpr AS item -> RETURN COPY item.matched_signature;,
    Node.BinaryOp AS item -> RETURN COPY item.matched_signature;,
    Node.IsA AS item -> RETURN COPY item.matched_signature;,
    Node.UnaryOp AS item -> RETURN COPY item.matched_signature;,
    Node.CallSiteOverride AS item -> RETURN COPY item.matched_signature;,
    Node.Identifier AS item -> RETURN COPY item.matched_signature;,
    Node.Literal AS item -> RETURN COPY item.matched_signature;,
    Node.ListLit AS item -> RETURN COPY item.matched_signature;,
    Node.TupleLit AS item -> RETURN COPY item.matched_signature;,
    Node.DefaultArrayLit AS item -> RETURN COPY item.matched_signature;,
    Node.HashLit AS item -> RETURN COPY item.matched_signature;,
    Node.DefaultLit AS item -> RETURN COPY item.matched_signature;,
    Node.StructLit AS item -> RETURN COPY item.matched_signature;,
    Node.LambdaLit AS item -> RETURN COPY item.matched_signature;,
    Node.IfStatement AS item -> RETURN COPY item.matched_signature;,
    Node.IfBind AS item -> RETURN COPY item.matched_signature;,
    Node.WhileLoop AS item -> RETURN COPY item.matched_signature;,
    Node.WhileBindLoop AS item -> RETURN COPY item.matched_signature;,
    Node.BreakNode AS item -> RETURN COPY item.matched_signature;,
    Node.ContinueNode AS item -> RETURN COPY item.matched_signature;,
    Node.FuncCall AS item -> RETURN COPY item.matched_signature;,
    Node.MethodCall AS item -> RETURN COPY item.matched_signature;,
    Node.GetField AS item -> RETURN COPY item.matched_signature;,
    Node.GetIndex AS item -> RETURN COPY item.matched_signature;,
    Node.Cast AS item -> RETURN COPY item.matched_signature;,
    Node.ReturnNode AS item -> RETURN COPY item.matched_signature;,
    Node.Assert AS item -> RETURN COPY item.matched_signature;,
    Node.Raise AS item -> RETURN COPY item.matched_signature;,
    Node.ThrowNode AS item -> RETURN COPY item.matched_signature;,
    Node.DieNode AS item -> RETURN COPY item.matched_signature;,
    Node.Slice AS item -> RETURN COPY item.matched_signature;,
    Node.Require AS item -> RETURN COPY item.matched_signature;,
    Node.DeferStmt AS item -> RETURN COPY item.matched_signature;,
    Node.WithBlock AS item -> RETURN COPY item.matched_signature;,
    Node.SyncPolicyDecl AS item -> RETURN COPY item.matched_signature;,
    Node.SelectOp AS item -> RETURN COPY item.matched_signature;,
    Node.WhereOp AS item -> RETURN COPY item.matched_signature;,
    Node.IndexOp AS item -> RETURN COPY item.matched_signature;,
