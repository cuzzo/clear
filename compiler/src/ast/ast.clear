    Node.ProtocolDef AS cast_payload -> RETURN NodeOrType{ ProtocolDef: COPY cast_payload };,
    Node.FunctionDef AS cast_payload -> RETURN NodeOrType{ FunctionDef: COPY cast_payload };,
