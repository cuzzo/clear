    Locatable.RecoverOp AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.BlockExpr AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.StringConcat AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.CapabilityWrap AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.MoveNode AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.CopyNode AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.KeepNode AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.ShareNode AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.LinkNode AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.ResolveNode AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.FreezeNode AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.PassStmt AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.StructPattern AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.RangeLit AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.ExternFnDecl AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.ExternStructDecl AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.EnumDef AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.UnionDef AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.UnionVariantLit AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.StaticCall AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.DoBlock AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.BgBlock AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.ThenChain AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.BgStreamBlock AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.YieldExpr AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.CloseStream AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.NextExpr AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.MatchStatement AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.ForRange AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.ForEach AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.TestBlock AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.WhenBlock AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.LetBinding AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.TestThat AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.AssertRaises AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.BenchmarkStmt AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.SmashStmt AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.ProfileStmt AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.StubDecl AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.Drop AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.SuppressCleanup AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.Return AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.ReassignCleanup AS MUTABLE item -> item.type_object = COPY value;,
    Locatable.FieldCleanup AS MUTABLE item -> item.type_object = COPY value;
  END
  RETURN TRY (aST__full_type_mut(node));
END
PUB FN aST__loop_node?(node: Locatable) RETURNS Bool ->
  RETURN ((((node IS_A WhileLoop) OR (node IS_A WhileBindLoop)) OR (node IS_A ForRange)) OR (node IS_A ForEach));
END
PUB FN assignmentNameString(value: AssignmentName) RETURNS String ->
  PARTIAL MATCH value START
    AssignmentName.StringValue AS item -> RETURN COPY item;
  END
  RETURN "";
END
PUB FN castStringToAssignmentName(value: String) RETURNS AssignmentName ->
  RETURN AssignmentName{ StringValue: COPY value };
END
