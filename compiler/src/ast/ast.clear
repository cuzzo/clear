    Node.Assignment AS cast_payload -> RETURN NodeOrType{ Assignment: COPY cast_payload };,
    Node.DestructureTarget AS cast_payload -> RETURN NodeOrType{ DestructureTarget: COPY cast_payload };,
    Node.DestructuringAssignment AS cast_payload -> RETURN NodeOrType{ DestructuringAssignment: COPY cast_payload };,
    Node.BindExpr AS cast_payload -> RETURN NodeOrType{ BindExpr: COPY cast_payload };,
    Node.BinaryOp AS cast_payload -> RETURN NodeOrType{ BinaryOp: COPY cast_payload };,
    Node.IsA AS cast_payload -> RETURN NodeOrType{ IsA: COPY cast_payload };,
    Node.UnaryOp AS cast_payload -> RETURN NodeOrType{ UnaryOp: COPY cast_payload };,
    Node.CallSiteOverride AS cast_payload -> RETURN NodeOrType{ CallSiteOverride: COPY cast_payload };,
