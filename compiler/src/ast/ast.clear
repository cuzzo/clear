# Ruby module AST::StatementVoidType
PUB FN aST__each_locatable(root: Locatable, MUTABLE descend_functions: Bool, visitor: FN(Locatable) -> Void) RETURNS Void EFFECTS REENTRANT ->
  visitor(root);
  IF !(descend_functions) AND (root IS_A FunctionDef) THEN
    RETURN;
  END
  FOR rtoc_walk_child IN rtocChildrenLocatable(root) DO
    aST__each_locatable(rtoc_walk_child, &descend_functions, visitor);
  END
END
PUB FN aST__root_identifier(node: Locatable) RETURNS ?Identifier EFFECTS REENTRANT:TAIL_CALL ->
  IF node IS_A MutableBorrow AS mutable_borrow THEN
    RETURN aST__root_identifier(mutable_borrow.target);
  ELSE_IF node IS_A GetField AS get_field THEN
    RETURN aST__root_identifier(get_field.target);
  ELSE_IF node IS_A GetIndex AS get_index THEN
    RETURN aST__root_identifier(get_index.target);
  ELSE_IF node IS_A Identifier AS identifier THEN
    RETURN COPY identifier;
  ELSE
    RETURN NIL;
  END
END
