    Node.AnyOp AS item -> RETURN COPY item.matched_signature;,
    Node.AllOp AS item -> RETURN COPY item.matched_signature;,
    Node.CountOp AS item -> RETURN COPY item.matched_signature;,
    Node.SumOp AS item -> RETURN COPY item.matched_signature;,
    Node.AverageOp AS item -> RETURN COPY item.matched_signature;,
    Node.MinOp AS item -> RETURN COPY item.matched_signature;,
    Node.MaxOp AS item -> RETURN COPY item.matched_signature;,
    Node.ShardOp AS item -> RETURN COPY item.matched_signature;,
    Node.ConcurrentOp AS item -> RETURN COPY item.matched_signature;,
    Node.Placeholder AS item -> RETURN COPY item.matched_signature;,
    Node.Copy AS item -> RETURN COPY item.matched_signature;,
    Node.OptionalUnwrap AS item -> RETURN COPY item.matched_signature;,
    Node.TenseNavigation AS item -> RETURN COPY item.matched_signature;,
    Node.MutableBorrow AS item -> RETURN COPY item.matched_signature;,
    Node.OrElseRaise AS item -> RETURN COPY item.matched_signature;,
    Node.OrElseExit AS item -> RETURN COPY item.matched_signature;,
    Node.OrElsePass AS item -> RETURN COPY item.matched_signature;,
    Node.OrElsePrune AS item -> RETURN COPY item.matched_signature;,
    Node.OrElseBreak AS item -> RETURN COPY item.matched_signature;,
    Node.CatchBlock AS item -> RETURN COPY item.matched_signature;,
    Node.RecoverOp AS item -> RETURN COPY item.matched_signature;,
    Node.BlockExpr AS item -> RETURN COPY item.matched_signature;,
    Node.StringConcat AS item -> RETURN COPY item.matched_signature;,
    Node.CapabilityWrap AS item -> RETURN COPY item.matched_signature;,
    Node.MoveNode AS item -> RETURN COPY item.matched_signature;,
    Node.CopyNode AS item -> RETURN COPY item.matched_signature;,
    Node.KeepNode AS item -> RETURN COPY item.matched_signature;,
    Node.ShareNode AS item -> RETURN COPY item.matched_signature;,
    Node.LinkNode AS item -> RETURN COPY item.matched_signature;,
    Node.ResolveNode AS item -> RETURN COPY item.matched_signature;,
    Node.FreezeNode AS item -> RETURN COPY item.matched_signature;,
    Node.PassStmt AS item -> RETURN COPY item.matched_signature;,
    Node.StructPattern AS item -> RETURN COPY item.matched_signature;,
    Node.RangeLit AS item -> RETURN COPY item.matched_signature;,
    Node.ExternFnDecl AS item -> RETURN COPY item.matched_signature;,
    Node.ExternStructDecl AS item -> RETURN COPY item.matched_signature;,
    Node.EnumDef AS item -> RETURN COPY item.matched_signature;,
    Node.UnionDef AS item -> RETURN COPY item.matched_signature;,
    Node.UnionVariantLit AS item -> RETURN COPY item.matched_signature;,
    Node.StaticCall AS item -> RETURN COPY item.matched_signature;,
    Node.DoBlock AS item -> RETURN COPY item.matched_signature;,
    Node.BgBlock AS item -> RETURN COPY item.matched_signature;,
    Node.ThenChain AS item -> RETURN COPY item.matched_signature;,
    Node.BgStreamBlock AS item -> RETURN COPY item.matched_signature;,
    Node.YieldExpr AS item -> RETURN COPY item.matched_signature;,
    Node.CloseStream AS item -> RETURN COPY item.matched_signature;,
    Node.NextExpr AS item -> RETURN COPY item.matched_signature;,
    Node.MatchStatement AS item -> RETURN COPY item.matched_signature;,
    Node.ForRange AS item -> RETURN COPY item.matched_signature;,
    Node.ForEach AS item -> RETURN COPY item.matched_signature;,
    Node.TestBlock AS item -> RETURN COPY item.matched_signature;,
    Node.WhenBlock AS item -> RETURN COPY item.matched_signature;,
    Node.LetBinding AS item -> RETURN COPY item.matched_signature;,
    Node.TestThat AS item -> RETURN COPY item.matched_signature;,
    Node.AssertRaises AS item -> RETURN COPY item.matched_signature;,
    Node.BenchmarkStmt AS item -> RETURN COPY item.matched_signature;,
    Node.SmashStmt AS item -> RETURN COPY item.matched_signature;,
    Node.ProfileStmt AS item -> RETURN COPY item.matched_signature;,
    Node.StubDecl AS item -> RETURN COPY item.matched_signature;,
    Node.Drop AS item -> RETURN COPY item.matched_signature;,
    Node.SuppressCleanup AS item -> RETURN COPY item.matched_signature;,
    Node.Return AS item -> RETURN COPY item.matched_signature;,
    Node.ReassignCleanup AS item -> RETURN COPY item.matched_signature;,
    Node.FieldCleanup AS item -> RETURN COPY item.matched_signature;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
# Ruby writes `alloc` on whichever variant it holds. A variant either
# carries the field or it does not, so the write lands only where it fits.
PUB FN locatable__set_alloc_mut(MUTABLE value: Locatable, new_value: ?String@symbol) RETURNS Void ->
  PARTIAL MATCH value START
    Locatable.CopyNode AS MUTABLE item -> item.alloc = COPY new_value;,
    Locatable.ReassignCleanup AS MUTABLE item -> item.alloc = COPY new_value;,
    Locatable.FieldCleanup AS MUTABLE item -> item.alloc = COPY new_value;,
    DEFAULT -> RETURN;
  END
END
