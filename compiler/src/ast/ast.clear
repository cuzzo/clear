  error_kind: ?String@symbol,
  error_type: ?String@symbol,
  implicit_layout_cost: ?Bool,
  kept_edge_plan: ?CallEdgeOwnershipPlan,
  kept_edge_plans: ?{Int64}CallEdgeOwnershipPlan,
  layout_transport: ?String@symbol,
  matched_signature: ?FunctionSignature@multiowned,
  matched_stdlib_def: ?FunctionSignature@multiowned,
  mutates_receiver: ?Bool,
  needs_heap_create: ?Bool,
  needs_mut_ref: ?Bool,
  resource_close_plan: ?ResourceClosePlan,
  slot_size: ?Int64,
  source_range: ?SourceRange,
  stdlib_allocates: ?Bool,
  storage_override: ?String@symbol,
  symbol: ?SymbolEntry@multiowned,
  tense_plan: ?TensePlanValue,
  type_object: ?Type,
  var_mutated: ?Bool,
  var_used: ?Bool,
  was_moved: ?Bool,
  zig_pattern: ?String@symbol,
  token: Token,
  name: String,
  params: []Param,
  return_type: Type,
