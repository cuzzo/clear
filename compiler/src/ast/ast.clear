    Locatable.StubDecl AS item -> RETURN COPY item.matched_signature;,
    Locatable.Drop AS item -> RETURN COPY item.matched_signature;,
    Locatable.SuppressCleanup AS item -> RETURN COPY item.matched_signature;,
    Locatable.Return AS item -> RETURN COPY item.matched_signature;,
    Locatable.ReassignCleanup AS item -> RETURN COPY item.matched_signature;,
    Locatable.FieldCleanup AS item -> RETURN COPY item.matched_signature;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END

# Ruby asks `respond_to?(:name)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN locatable__name(value: Locatable) RETURNS ?String ->
  PARTIAL MATCH value START
    Locatable.ProtocolRequirement AS item -> RETURN COPY item.name;,
    Locatable.ProtocolDef AS item -> RETURN COPY item.name;,
    Locatable.FunctionDef AS item -> RETURN COPY item.name;,
    Locatable.StructDef AS item -> RETURN COPY item.name;,
    Locatable.VarDecl AS item -> RETURN COPY item.name;,
    Locatable.DestructureTarget AS item -> RETURN COPY item.name;,
    Locatable.BindExpr AS item -> RETURN COPY item.name;,
    Locatable.Identifier AS item -> RETURN COPY item.name;,
    Locatable.StructLit AS item -> RETURN COPY item.name;,
    Locatable.MethodCall AS item -> RETURN COPY item.name;,
    Locatable.ExternFnDecl AS item -> RETURN COPY item.name;,
    Locatable.ExternStructDecl AS item -> RETURN COPY item.name;,
    Locatable.EnumDef AS item -> RETURN COPY item.name;,
    Locatable.UnionDef AS item -> RETURN COPY item.name;,
    Locatable.TestBlock AS item -> RETURN COPY item.name;,
    Locatable.LetBinding AS item -> RETURN COPY item.name;,
    Locatable.Drop AS item -> RETURN COPY item.name;,
    Locatable.SuppressCleanup AS item -> RETURN COPY item.name;,
    Locatable.ReassignCleanup AS item -> RETURN COPY item.name;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END

# Ruby reads class.name and strips the module prefix; the variant name is
# that name.
PUB FN locatable__variant_name(value: Locatable) RETURNS String ->
  PARTIAL MATCH value START
    Locatable.Program AS item -> RETURN "Program";,
    Locatable.RequireNode AS item -> RETURN "RequireNode";,
    Locatable.ProtocolRequirement AS item -> RETURN "ProtocolRequirement";,
    Locatable.ProtocolDef AS item -> RETURN "ProtocolDef";,
    Locatable.FunctionDef AS item -> RETURN "FunctionDef";,
    Locatable.ImplementationDef AS item -> RETURN "ImplementationDef";,
    Locatable.ConformanceDef AS item -> RETURN "ConformanceDef";,
    Locatable.StructDef AS item -> RETURN "StructDef";,
    Locatable.VarDecl AS item -> RETURN "VarDecl";,
    Locatable.Assignment AS item -> RETURN "Assignment";,
    Locatable.DestructureTarget AS item -> RETURN "DestructureTarget";,
    Locatable.DestructuringAssignment AS item -> RETURN "DestructuringAssignment";,
    Locatable.BindExpr AS item -> RETURN "BindExpr";,
    Locatable.BinaryOp AS item -> RETURN "BinaryOp";,
    Locatable.IsA AS item -> RETURN "IsA";,
    Locatable.UnaryOp AS item -> RETURN "UnaryOp";,
    Locatable.CallSiteOverride AS item -> RETURN "CallSiteOverride";,
    Locatable.Identifier AS item -> RETURN "Identifier";,
    Locatable.Literal AS item -> RETURN "Literal";,
    Locatable.ListLit AS item -> RETURN "ListLit";,
    Locatable.TupleLit AS item -> RETURN "TupleLit";,
    Locatable.DefaultArrayLit AS item -> RETURN "DefaultArrayLit";,
    Locatable.HashLit AS item -> RETURN "HashLit";,
    Locatable.DefaultLit AS item -> RETURN "DefaultLit";,
    Locatable.StructLit AS item -> RETURN "StructLit";,
    Locatable.LambdaLit AS item -> RETURN "LambdaLit";,
    Locatable.IfStatement AS item -> RETURN "IfStatement";,
    Locatable.IfBind AS item -> RETURN "IfBind";,
    Locatable.WhileLoop AS item -> RETURN "WhileLoop";,
    Locatable.WhileBindLoop AS item -> RETURN "WhileBindLoop";,
    Locatable.BreakNode AS item -> RETURN "BreakNode";,
    Locatable.ContinueNode AS item -> RETURN "ContinueNode";,
    Locatable.FuncCall AS item -> RETURN "FuncCall";,
    Locatable.MethodCall AS item -> RETURN "MethodCall";,
    Locatable.GetField AS item -> RETURN "GetField";,
    Locatable.GetIndex AS item -> RETURN "GetIndex";,
    Locatable.Cast AS item -> RETURN "Cast";,
    Locatable.ReturnNode AS item -> RETURN "ReturnNode";,
    Locatable.Assert AS item -> RETURN "Assert";,
    Locatable.Raise AS item -> RETURN "Raise";,
    Locatable.ThrowNode AS item -> RETURN "ThrowNode";,
    Locatable.DieNode AS item -> RETURN "DieNode";,
    Locatable.Slice AS item -> RETURN "Slice";,
    Locatable.Require AS item -> RETURN "Require";,
    Locatable.DeferStmt AS item -> RETURN "DeferStmt";,
    Locatable.WithBlock AS item -> RETURN "WithBlock";,
    Locatable.SyncPolicyDecl AS item -> RETURN "SyncPolicyDecl";,
    Locatable.SelectOp AS item -> RETURN "SelectOp";,
    Locatable.WhereOp AS item -> RETURN "WhereOp";,
    Locatable.IndexOp AS item -> RETURN "IndexOp";,
    Locatable.ReduceOp AS item -> RETURN "ReduceOp";,
    Locatable.OrderByOp AS item -> RETURN "OrderByOp";,
    Locatable.LimitOp AS item -> RETURN "LimitOp";,
    Locatable.UnnestOp AS item -> RETURN "UnnestOp";,
    Locatable.DistinctOp AS item -> RETURN "DistinctOp";,
    Locatable.EachOp AS item -> RETURN "EachOp";,
    Locatable.TapOp AS item -> RETURN "TapOp";,
    Locatable.SkipOp AS item -> RETURN "SkipOp";,
    Locatable.CollectOp AS item -> RETURN "CollectOp";,
    Locatable.TakeWhileOp AS item -> RETURN "TakeWhileOp";,
    Locatable.WindowOp AS item -> RETURN "WindowOp";,
    Locatable.BatchWindowOp AS item -> RETURN "BatchWindowOp";,
    Locatable.JoinOp AS item -> RETURN "JoinOp";,
    Locatable.FindOp AS item -> RETURN "FindOp";,
    Locatable.AnyOp AS item -> RETURN "AnyOp";,
    Locatable.AllOp AS item -> RETURN "AllOp";,
    Locatable.CountOp AS item -> RETURN "CountOp";,
    Locatable.SumOp AS item -> RETURN "SumOp";,
    Locatable.AverageOp AS item -> RETURN "AverageOp";,
    Locatable.MinOp AS item -> RETURN "MinOp";,
    Locatable.MaxOp AS item -> RETURN "MaxOp";,
    Locatable.ShardOp AS item -> RETURN "ShardOp";,
    Locatable.ConcurrentOp AS item -> RETURN "ConcurrentOp";,
    Locatable.Placeholder AS item -> RETURN "Placeholder";,
    Locatable.Copy AS item -> RETURN "Copy";,
    Locatable.OptionalUnwrap AS item -> RETURN "OptionalUnwrap";,
    Locatable.TenseNavigation AS item -> RETURN "TenseNavigation";,
    Locatable.MutableBorrow AS item -> RETURN "MutableBorrow";,
    Locatable.OrElseRaise AS item -> RETURN "OrElseRaise";,
    Locatable.OrElseExit AS item -> RETURN "OrElseExit";,
    Locatable.OrElsePass AS item -> RETURN "OrElsePass";,
    Locatable.OrElsePrune AS item -> RETURN "OrElsePrune";,
    Locatable.OrElseBreak AS item -> RETURN "OrElseBreak";,
    Locatable.CatchBlock AS item -> RETURN "CatchBlock";,
    Locatable.RecoverOp AS item -> RETURN "RecoverOp";,
    Locatable.BlockExpr AS item -> RETURN "BlockExpr";,
    Locatable.StringConcat AS item -> RETURN "StringConcat";,
    Locatable.CapabilityWrap AS item -> RETURN "CapabilityWrap";,
    Locatable.MoveNode AS item -> RETURN "MoveNode";,
    Locatable.CopyNode AS item -> RETURN "CopyNode";,
    Locatable.KeepNode AS item -> RETURN "KeepNode";,
    Locatable.ShareNode AS item -> RETURN "ShareNode";,
    Locatable.LinkNode AS item -> RETURN "LinkNode";,
    Locatable.ResolveNode AS item -> RETURN "ResolveNode";,
    Locatable.FreezeNode AS item -> RETURN "FreezeNode";,
    Locatable.PassStmt AS item -> RETURN "PassStmt";,
    Locatable.StructPattern AS item -> RETURN "StructPattern";,
    Locatable.RangeLit AS item -> RETURN "RangeLit";,
    Locatable.ExternFnDecl AS item -> RETURN "ExternFnDecl";,
    Locatable.ExternStructDecl AS item -> RETURN "ExternStructDecl";,
    Locatable.EnumDef AS item -> RETURN "EnumDef";,
    Locatable.UnionDef AS item -> RETURN "UnionDef";,
    Locatable.UnionVariantLit AS item -> RETURN "UnionVariantLit";,
    Locatable.StaticCall AS item -> RETURN "StaticCall";,
    Locatable.DoBlock AS item -> RETURN "DoBlock";,
    Locatable.BgBlock AS item -> RETURN "BgBlock";,
    Locatable.ThenChain AS item -> RETURN "ThenChain";,
    Locatable.BgStreamBlock AS item -> RETURN "BgStreamBlock";,
    Locatable.YieldExpr AS item -> RETURN "YieldExpr";,
    Locatable.CloseStream AS item -> RETURN "CloseStream";,
    Locatable.NextExpr AS item -> RETURN "NextExpr";,
    Locatable.MatchStatement AS item -> RETURN "MatchStatement";,
    Locatable.ForRange AS item -> RETURN "ForRange";,
    Locatable.ForEach AS item -> RETURN "ForEach";,
    Locatable.TestBlock AS item -> RETURN "TestBlock";,
    Locatable.WhenBlock AS item -> RETURN "WhenBlock";,
    Locatable.LetBinding AS item -> RETURN "LetBinding";,
    Locatable.TestThat AS item -> RETURN "TestThat";,
    Locatable.AssertRaises AS item -> RETURN "AssertRaises";,
    Locatable.BenchmarkStmt AS item -> RETURN "BenchmarkStmt";,
    Locatable.SmashStmt AS item -> RETURN "SmashStmt";,
    Locatable.ProfileStmt AS item -> RETURN "ProfileStmt";,
    Locatable.StubDecl AS item -> RETURN "StubDecl";,
    Locatable.Drop AS item -> RETURN "Drop";,
    Locatable.SuppressCleanup AS item -> RETURN "SuppressCleanup";,
    Locatable.Return AS item -> RETURN "Return";,
    Locatable.ReassignCleanup AS item -> RETURN "ReassignCleanup";,
    Locatable.FieldCleanup AS item -> RETURN "FieldCleanup";,
    DEFAULT -> RETURN "";
  END
  RETURN "";
END

# Ruby walks the node's struct members and collects every AST node among
# them, from list and map fields as well as direct ones. CLEAR answers the
# same question by narrowing to each variant that has children.
PUB FN locatable__child_nodes(value: Locatable) RETURNS []Locatable EFFECTS REENTRANT ->
  MUTABLE out: []Locatable = List[];
  IF value IS_A Program AS item THEN
    FOR rtoc_child IN item.statements DO
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A FunctionDef AS item THEN
    FOR rtoc_child IN item.body DO
      &out.append(COPY rtoc_child);
    END
    IF item.default_catch EXISTS AS rtoc_list THEN
      FOR rtoc_child IN rtoc_list DO
        &out.append(COPY rtoc_child);
      END
    END
  END
  IF value IS_A VarDecl AS item THEN
    &out.append(COPY item.value);
  END
  IF value IS_A Assignment AS item THEN
    &out.append(COPY item.value);
  END
  IF value IS_A DestructuringAssignment AS item THEN
    &out.append(COPY item.value);
  END
  IF value IS_A BindExpr AS item THEN
    &out.append(COPY item.value);
  END
  IF value IS_A BinaryOp AS item THEN
    &out.append(COPY item.left);
    &out.append(COPY item.right);
  END
  IF value IS_A IsA AS item THEN
    &out.append(COPY item.left);
  END
  IF value IS_A UnaryOp AS item THEN
    &out.append(COPY item.right);
  END
  IF value IS_A CallSiteOverride AS item THEN
    &out.append(COPY item.inner);
  END
  IF value IS_A ListLit AS item THEN
    FOR rtoc_child IN item.items DO
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A TupleLit AS item THEN
    FOR rtoc_child IN item.items DO
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A StructLit AS item THEN
    FOR rtoc_key IN item.fields.keys() DO
      &out.append(COPY UNWRAP (item.fields[rtoc_key]));
    END
  END
  IF value IS_A LambdaLit AS item THEN
    IF item.deferred_drops EXISTS AS rtoc_list THEN
      FOR rtoc_child IN rtoc_list DO
        &out.append(COPY rtoc_child);
      END
    END
  END
  IF value IS_A IfStatement AS item THEN
    &out.append(COPY item.condition);
    IF item.else_branch EXISTS AS rtoc_list THEN
      FOR rtoc_child IN rtoc_list DO
        &out.append(COPY rtoc_child);
      END
    END
    FOR rtoc_child IN item.then_branch DO
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A IfBind AS item THEN
    FOR rtoc_child IN item.else_branch DO
      &out.append(COPY rtoc_child);
    END
    FOR rtoc_child IN item.then_branch DO
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A WhileLoop AS item THEN
    &out.append(COPY item.condition);
    FOR rtoc_child IN item.do_branch DO
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A WhileBindLoop AS item THEN
    &out.append(COPY item.condition);
    FOR rtoc_child IN item.do_branch DO
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A FuncCall AS item THEN
    FOR rtoc_child IN item.args DO
      &out.append(COPY rtoc_child);
    END
    IF item.pipe_lhs EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A MethodCall AS item THEN
    FOR rtoc_child IN item.args DO
      &out.append(COPY rtoc_child);
    END
    &out.append(COPY item.object);
  END
  IF value IS_A GetField AS item THEN
    &out.append(COPY item.target);
  END
  IF value IS_A GetIndex AS item THEN
    &out.append(COPY item.index);
    &out.append(COPY item.target);
  END
  IF value IS_A Cast AS item THEN
    &out.append(COPY item.value);
  END
  IF value IS_A ReturnNode AS item THEN
    IF item.value EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A Assert AS item THEN
    &out.append(COPY item.condition);
  END
  IF value IS_A Raise AS item THEN
    IF item.message_expr EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A ThrowNode AS item THEN
    IF item.value EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A DieNode AS item THEN
    IF item.status EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A Slice AS item THEN
    IF item.end EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
    IF item.start EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
    &out.append(COPY item.target);
  END
  IF value IS_A DeferStmt AS item THEN
    FOR rtoc_child IN item.body DO
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A WithBlock AS item THEN
    FOR rtoc_child IN item.body DO
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A SelectOp AS item THEN
    &out.append(COPY item.expression);
  END
  IF value IS_A WhereOp AS item THEN
    &out.append(COPY item.expression);
  END
  IF value IS_A IndexOp AS item THEN
    IF item.expression EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A ReduceOp AS item THEN
    IF item.expression EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
    IF item.initial_value EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A OrderByOp AS item THEN
    IF item.expression EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A LimitOp AS item THEN
    IF item.count EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A UnnestOp AS item THEN
    IF item.expression EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A DistinctOp AS item THEN
    IF item.expression EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A EachOp AS item THEN
    FOR rtoc_child IN item.body DO
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A TapOp AS item THEN
    FOR rtoc_child IN item.body DO
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A SkipOp AS item THEN
    IF item.count EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A TakeWhileOp AS item THEN
    IF item.expression EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A WindowOp AS item THEN
    IF item.expression EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
    IF item.size EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A BatchWindowOp AS item THEN
    IF item.expression EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
    FOR rtoc_key IN item.options.keys() DO
      &out.append(COPY UNWRAP (item.options[rtoc_key]));
    END
  END
  IF value IS_A JoinOp AS item THEN
    IF item.key_expr EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
    IF item.right_source EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A FindOp AS item THEN
    IF item.expression EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A AnyOp AS item THEN
    IF item.expression EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A AllOp AS item THEN
    IF item.expression EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A CountOp AS item THEN
    IF item.expression EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A SumOp AS item THEN
    IF item.expression EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A AverageOp AS item THEN
    IF item.expression EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A MinOp AS item THEN
    IF item.expression EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A MaxOp AS item THEN
    IF item.expression EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A ShardOp AS item THEN
    IF item.key_expr EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
    IF item.target_map EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A ConcurrentOp AS item THEN
    FOR rtoc_key IN item.options.keys() DO
      &out.append(COPY UNWRAP (item.options[rtoc_key]));
    END
  END
  IF value IS_A Copy AS item THEN
    &out.append(COPY item.value);
  END
  IF value IS_A OptionalUnwrap AS item THEN
    &out.append(COPY item.target);
  END
  IF value IS_A TenseNavigation AS item THEN
    &out.append(COPY item.target);
  END
  IF value IS_A MutableBorrow AS item THEN
    &out.append(COPY item.target);
  END
  IF value IS_A OrElseExit AS item THEN
    IF item.message EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A CatchBlock AS item THEN
    IF item.default_body EXISTS AS rtoc_list THEN
      FOR rtoc_child IN rtoc_list DO
        &out.append(COPY rtoc_child);
      END
    END
  END
  IF value IS_A RecoverOp AS item THEN
    IF item.default_expr EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A BlockExpr AS item THEN
    FOR rtoc_child IN item.body DO
      &out.append(COPY rtoc_child);
    END
    IF item.result EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A StringConcat AS item THEN
    FOR rtoc_child IN item.parts DO
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A CapabilityWrap AS item THEN
    &out.append(COPY item.value);
  END
  IF value IS_A MoveNode AS item THEN
    &out.append(COPY item.value);
  END
  IF value IS_A CopyNode AS item THEN
    &out.append(COPY item.value);
  END
  IF value IS_A KeepNode AS item THEN
    &out.append(COPY item.value);
  END
  IF value IS_A ShareNode AS item THEN
    &out.append(COPY item.value);
  END
  IF value IS_A LinkNode AS item THEN
    &out.append(COPY item.value);
  END
  IF value IS_A ResolveNode AS item THEN
    &out.append(COPY item.value);
  END
  IF value IS_A FreezeNode AS item THEN
    &out.append(COPY item.value);
  END
  IF value IS_A RangeLit AS item THEN
    &out.append(COPY item.finish);
    &out.append(COPY item.start);
  END
  IF value IS_A UnionVariantLit AS item THEN
    FOR rtoc_key IN item.fields.keys() DO
      &out.append(COPY UNWRAP (item.fields[rtoc_key]));
    END
  END
  IF value IS_A StaticCall AS item THEN
    FOR rtoc_child IN item.args DO
      &out.append(COPY rtoc_child);
    END
    &out.append(COPY item.type_name);
  END
  IF value IS_A BgBlock AS item THEN
    FOR rtoc_child IN item.body DO
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A BgStreamBlock AS item THEN
    FOR rtoc_child IN item.body DO
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A YieldExpr AS item THEN
    &out.append(COPY item.expr);
  END
  IF value IS_A NextExpr AS item THEN
    &out.append(COPY item.expr);
  END
  IF value IS_A MatchStatement AS item THEN
    IF item.default_case EXISTS AS rtoc_list THEN
      FOR rtoc_child IN rtoc_list DO
        &out.append(COPY rtoc_child);
      END
    END
    &out.append(COPY item.expr);
  END
  IF value IS_A ForRange AS item THEN
    FOR rtoc_child IN item.body DO
      &out.append(COPY rtoc_child);
    END
    IF item.deferred_drops EXISTS AS rtoc_list THEN
      FOR rtoc_child IN rtoc_list DO
        &out.append(COPY rtoc_child);
      END
    END
    &out.append(COPY item.end_expr);
    &out.append(COPY item.start_expr);
  END
  IF value IS_A ForEach AS item THEN
    FOR rtoc_child IN item.body DO
      &out.append(COPY rtoc_child);
    END
    &out.append(COPY item.collection);
    IF item.deferred_drops EXISTS AS rtoc_list THEN
      FOR rtoc_child IN rtoc_list DO
        &out.append(COPY rtoc_child);
      END
    END
  END
  IF value IS_A TestBlock AS item THEN
    IF item.after_all EXISTS AS rtoc_lists THEN
      FOR rtoc_inner IN rtoc_lists DO
        FOR rtoc_child IN rtoc_inner DO
          &out.append(COPY rtoc_child);
        END
      END
    END
    IF item.after_each EXISTS AS rtoc_lists THEN
      FOR rtoc_inner IN rtoc_lists DO
        FOR rtoc_child IN rtoc_inner DO
          &out.append(COPY rtoc_child);
        END
      END
    END
    IF item.before_all EXISTS AS rtoc_lists THEN
      FOR rtoc_inner IN rtoc_lists DO
        FOR rtoc_child IN rtoc_inner DO
          &out.append(COPY rtoc_child);
        END
      END
    END
    IF item.before_each EXISTS AS rtoc_lists THEN
      FOR rtoc_inner IN rtoc_lists DO
        FOR rtoc_child IN rtoc_inner DO
          &out.append(COPY rtoc_child);
        END
      END
    END
    IF item.setup EXISTS AS rtoc_list THEN
      FOR rtoc_child IN rtoc_list DO
        &out.append(COPY rtoc_child);
      END
    END
  END
  IF value IS_A WhenBlock AS item THEN
    IF item.after_all EXISTS AS rtoc_lists THEN
      FOR rtoc_inner IN rtoc_lists DO
        FOR rtoc_child IN rtoc_inner DO
          &out.append(COPY rtoc_child);
        END
      END
    END
    IF item.after_each EXISTS AS rtoc_lists THEN
      FOR rtoc_inner IN rtoc_lists DO
        FOR rtoc_child IN rtoc_inner DO
          &out.append(COPY rtoc_child);
        END
      END
    END
    IF item.before_all EXISTS AS rtoc_lists THEN
      FOR rtoc_inner IN rtoc_lists DO
        FOR rtoc_child IN rtoc_inner DO
          &out.append(COPY rtoc_child);
        END
      END
    END
    IF item.before_each EXISTS AS rtoc_lists THEN
      FOR rtoc_inner IN rtoc_lists DO
        FOR rtoc_child IN rtoc_inner DO
          &out.append(COPY rtoc_child);
        END
      END
    END
    IF item.setup EXISTS AS rtoc_list THEN
      FOR rtoc_child IN rtoc_list DO
        &out.append(COPY rtoc_child);
      END
    END
  END
  IF value IS_A LetBinding AS item THEN
    &out.append(COPY item.expr);
  END
  IF value IS_A TestThat AS item THEN
    FOR rtoc_child IN item.body DO
      &out.append(COPY rtoc_child);
    END
  END
  IF value IS_A AssertRaises AS item THEN
    &out.append(COPY item.expression);
  END
  IF value IS_A BenchmarkStmt AS item THEN
    &out.append(COPY item.expression);
  END
  IF value IS_A SmashStmt AS item THEN
    &out.append(COPY item.expression);
  END
  IF value IS_A ProfileStmt AS item THEN
    &out.append(COPY item.expression);
  END
  IF value IS_A FieldCleanup AS item THEN
    IF item.field EXISTS AS rtoc_child THEN
      &out.append(COPY rtoc_child);
    END
  END
  RETURN out;
END

# Ruby rebuilds a node with each AST child passed through a function, walking
# the struct members to find them. CLEAR narrows to the variant instead, and
# every tree rewrite that Ruby writes as reflection is this one operation.
# Ruby's Locatable mixin defines these once for every AST node. `full_type`
# manufactures the :Untyped sentinel rather than NIL so no caller branches on
# nil; `type_object` reads the annotation storage without manufacturing it.
PUB FN locatable__type_object(value: Locatable) RETURNS ?Type ->
  PARTIAL MATCH value START
    Locatable.Program AS item -> RETURN COPY item.type_object;,
    Locatable.RequireNode AS item -> RETURN COPY item.type_object;,
    Locatable.ProtocolRequirement AS item -> RETURN COPY item.type_object;,
    Locatable.ProtocolDef AS item -> RETURN COPY item.type_object;,
    Locatable.FunctionDef AS item -> RETURN COPY item.type_object;,
    Locatable.ImplementationDef AS item -> RETURN COPY item.type_object;,
    Locatable.ConformanceDef AS item -> RETURN COPY item.type_object;,
    Locatable.StructDef AS item -> RETURN COPY item.type_object;,
    Locatable.VarDecl AS item -> RETURN COPY item.type_object;,
    Locatable.Assignment AS item -> RETURN COPY item.type_object;,
    Locatable.DestructureTarget AS item -> RETURN COPY item.type_object;,
    Locatable.DestructuringAssignment AS item -> RETURN COPY item.type_object;,
    Locatable.BindExpr AS item -> RETURN COPY item.type_object;,
    Locatable.BinaryOp AS item -> RETURN COPY item.type_object;,
    Locatable.IsA AS item -> RETURN COPY item.type_object;,
    Locatable.UnaryOp AS item -> RETURN COPY item.type_object;,
    Locatable.CallSiteOverride AS item -> RETURN COPY item.type_object;,
    Locatable.Identifier AS item -> RETURN COPY item.type_object;,
    Locatable.Literal AS item -> RETURN COPY item.type_object;,
    Locatable.ListLit AS item -> RETURN COPY item.type_object;,
    Locatable.TupleLit AS item -> RETURN COPY item.type_object;,
    Locatable.DefaultArrayLit AS item -> RETURN COPY item.type_object;,
    Locatable.HashLit AS item -> RETURN COPY item.type_object;,
    Locatable.DefaultLit AS item -> RETURN COPY item.type_object;,
    Locatable.StructLit AS item -> RETURN COPY item.type_object;,
    Locatable.LambdaLit AS item -> RETURN COPY item.type_object;,
    Locatable.IfStatement AS item -> RETURN COPY item.type_object;,
    Locatable.IfBind AS item -> RETURN COPY item.type_object;,
    Locatable.WhileLoop AS item -> RETURN COPY item.type_object;,
    Locatable.WhileBindLoop AS item -> RETURN COPY item.type_object;,
    Locatable.BreakNode AS item -> RETURN COPY item.type_object;,
    Locatable.ContinueNode AS item -> RETURN COPY item.type_object;,
    Locatable.FuncCall AS item -> RETURN COPY item.type_object;,
    Locatable.MethodCall AS item -> RETURN COPY item.type_object;,
    Locatable.GetField AS item -> RETURN COPY item.type_object;,
    Locatable.GetIndex AS item -> RETURN COPY item.type_object;,
    Locatable.Cast AS item -> RETURN COPY item.type_object;,
    Locatable.ReturnNode AS item -> RETURN COPY item.type_object;,
    Locatable.Assert AS item -> RETURN COPY item.type_object;,
    Locatable.Raise AS item -> RETURN COPY item.type_object;,
    Locatable.ThrowNode AS item -> RETURN COPY item.type_object;,
    Locatable.DieNode AS item -> RETURN COPY item.type_object;,
    Locatable.Slice AS item -> RETURN COPY item.type_object;,
    Locatable.Require AS item -> RETURN COPY item.type_object;,
    Locatable.DeferStmt AS item -> RETURN COPY item.type_object;,
    Locatable.WithBlock AS item -> RETURN COPY item.type_object;,
    Locatable.SyncPolicyDecl AS item -> RETURN COPY item.type_object;,
    Locatable.SelectOp AS item -> RETURN COPY item.type_object;,
    Locatable.WhereOp AS item -> RETURN COPY item.type_object;,
    Locatable.IndexOp AS item -> RETURN COPY item.type_object;,
    Locatable.ReduceOp AS item -> RETURN COPY item.type_object;,
    Locatable.OrderByOp AS item -> RETURN COPY item.type_object;,
    Locatable.LimitOp AS item -> RETURN COPY item.type_object;,
    Locatable.UnnestOp AS item -> RETURN COPY item.type_object;,
    Locatable.DistinctOp AS item -> RETURN COPY item.type_object;,
    Locatable.EachOp AS item -> RETURN COPY item.type_object;,
    Locatable.TapOp AS item -> RETURN COPY item.type_object;,
    Locatable.SkipOp AS item -> RETURN COPY item.type_object;,
    Locatable.CollectOp AS item -> RETURN COPY item.type_object;,
    Locatable.TakeWhileOp AS item -> RETURN COPY item.type_object;,
    Locatable.WindowOp AS item -> RETURN COPY item.type_object;,
    Locatable.BatchWindowOp AS item -> RETURN COPY item.type_object;,
    Locatable.JoinOp AS item -> RETURN COPY item.type_object;,
    Locatable.FindOp AS item -> RETURN COPY item.type_object;,
    Locatable.AnyOp AS item -> RETURN COPY item.type_object;,
    Locatable.AllOp AS item -> RETURN COPY item.type_object;,
    Locatable.CountOp AS item -> RETURN COPY item.type_object;,
    Locatable.SumOp AS item -> RETURN COPY item.type_object;,
    Locatable.AverageOp AS item -> RETURN COPY item.type_object;,
    Locatable.MinOp AS item -> RETURN COPY item.type_object;,
    Locatable.MaxOp AS item -> RETURN COPY item.type_object;,
    Locatable.ShardOp AS item -> RETURN COPY item.type_object;,
    Locatable.ConcurrentOp AS item -> RETURN COPY item.type_object;,
    Locatable.Placeholder AS item -> RETURN COPY item.type_object;,
    Locatable.Copy AS item -> RETURN COPY item.type_object;,
    Locatable.OptionalUnwrap AS item -> RETURN COPY item.type_object;,
    Locatable.TenseNavigation AS item -> RETURN COPY item.type_object;,
    Locatable.MutableBorrow AS item -> RETURN COPY item.type_object;,
    Locatable.OrElseRaise AS item -> RETURN COPY item.type_object;,
    Locatable.OrElseExit AS item -> RETURN COPY item.type_object;,
    Locatable.OrElsePass AS item -> RETURN COPY item.type_object;,
    Locatable.OrElsePrune AS item -> RETURN COPY item.type_object;,
    Locatable.OrElseBreak AS item -> RETURN COPY item.type_object;,
    Locatable.CatchBlock AS item -> RETURN COPY item.type_object;,
    Locatable.RecoverOp AS item -> RETURN COPY item.type_object;,
    Locatable.BlockExpr AS item -> RETURN COPY item.type_object;,
    Locatable.StringConcat AS item -> RETURN COPY item.type_object;,
    Locatable.CapabilityWrap AS item -> RETURN COPY item.type_object;,
    Locatable.MoveNode AS item -> RETURN COPY item.type_object;,
    Locatable.CopyNode AS item -> RETURN COPY item.type_object;,
    Locatable.KeepNode AS item -> RETURN COPY item.type_object;,
    Locatable.ShareNode AS item -> RETURN COPY item.type_object;,
    Locatable.LinkNode AS item -> RETURN COPY item.type_object;,
    Locatable.ResolveNode AS item -> RETURN COPY item.type_object;,
    Locatable.FreezeNode AS item -> RETURN COPY item.type_object;,
    Locatable.PassStmt AS item -> RETURN COPY item.type_object;,
    Locatable.StructPattern AS item -> RETURN COPY item.type_object;,
    Locatable.RangeLit AS item -> RETURN COPY item.type_object;,
    Locatable.ExternFnDecl AS item -> RETURN COPY item.type_object;,
    Locatable.ExternStructDecl AS item -> RETURN COPY item.type_object;,
    Locatable.EnumDef AS item -> RETURN COPY item.type_object;,
    Locatable.UnionDef AS item -> RETURN COPY item.type_object;,
    Locatable.UnionVariantLit AS item -> RETURN COPY item.type_object;,
    Locatable.StaticCall AS item -> RETURN COPY item.type_object;,
    Locatable.DoBlock AS item -> RETURN COPY item.type_object;,
    Locatable.BgBlock AS item -> RETURN COPY item.type_object;,
    Locatable.ThenChain AS item -> RETURN COPY item.type_object;,
    Locatable.BgStreamBlock AS item -> RETURN COPY item.type_object;,
    Locatable.YieldExpr AS item -> RETURN COPY item.type_object;,
    Locatable.CloseStream AS item -> RETURN COPY item.type_object;,
    Locatable.NextExpr AS item -> RETURN COPY item.type_object;,
    Locatable.MatchStatement AS item -> RETURN COPY item.type_object;,
    Locatable.ForRange AS item -> RETURN COPY item.type_object;,
    Locatable.ForEach AS item -> RETURN COPY item.type_object;,
    Locatable.TestBlock AS item -> RETURN COPY item.type_object;,
    Locatable.WhenBlock AS item -> RETURN COPY item.type_object;,
    Locatable.LetBinding AS item -> RETURN COPY item.type_object;,
    Locatable.TestThat AS item -> RETURN COPY item.type_object;,
    Locatable.AssertRaises AS item -> RETURN COPY item.type_object;,
    Locatable.BenchmarkStmt AS item -> RETURN COPY item.type_object;,
    Locatable.SmashStmt AS item -> RETURN COPY item.type_object;,
    Locatable.ProfileStmt AS item -> RETURN COPY item.type_object;,
    Locatable.StubDecl AS item -> RETURN COPY item.type_object;,
    Locatable.Drop AS item -> RETURN COPY item.type_object;,
    Locatable.SuppressCleanup AS item -> RETURN COPY item.type_object;,
    Locatable.Return AS item -> RETURN COPY item.type_object;,
    Locatable.ReassignCleanup AS item -> RETURN COPY item.type_object;,
    Locatable.FieldCleanup AS item -> RETURN COPY item.type_object;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
PUB FN locatable__typed?(value: Locatable) RETURNS !Bool ->
  RETURN !(type__untyped?(TRY (aST__full_type_mut(value))));
END
PUB FN locatable__resolved_type(value: Locatable) RETURNS ?String@symbol EFFECTS REENTRANT ->
  IF locatable__type_object(value) EXISTS AS rtoc_stored THEN
    RETURN type__resolved(rtoc_stored);
  END
  RETURN NIL;
END
PUB FN locatable__coerced_type(value: Locatable) RETURNS ?TypeShapeRaw EFFECTS REENTRANT ->
  IF locatable__coerced_type_object(value) EXISTS AS rtoc_coerced THEN
    RETURN type__raw(rtoc_coerced);
  END
  RETURN NIL;
END
PUB FN locatable__coerced_type_info(value: Locatable) RETURNS ?Type ->
  RETURN locatable__coerced_type_object(value);
END
PUB FN locatable__child_bodies(value: Locatable) RETURNS [][]Locatable EFFECTS REENTRANT ->
  MUTABLE out: [][]Locatable = List[];
  IF value IS_A FunctionDef AS item THEN
    &out.append(COPY item.body);
    RETURN out;
  END
  IF value IS_A BgBlock AS item THEN
    &out.append(COPY item.body);
    RETURN out;
  END
  IF value IS_A BgStreamBlock AS item THEN
    &out.append(COPY item.body);
    RETURN out;
  END
  IF value IS_A ForRange AS item THEN
    &out.append(COPY item.body);
    RETURN out;
  END
  IF value IS_A ForEach AS item THEN
    &out.append(COPY item.body);
    RETURN out;
  END
  IF value IS_A TestThat AS item THEN
    &out.append(COPY item.body);
    RETURN out;
  END
  IF value IS_A WhileLoop AS item THEN
    &out.append(COPY item.do_branch);
    RETURN out;
  END
  IF value IS_A WhileBindLoop AS item THEN
    &out.append(COPY item.do_branch);
    RETURN out;
  END
  IF value IS_A IfStatement AS item THEN
    &out.append(COPY item.then_branch);
    IF item.else_branch EXISTS AS rtoc_else THEN
      &out.append(COPY rtoc_else);
    END
    RETURN out;
  END
  IF value IS_A IfBind AS item THEN
    &out.append(COPY item.then_branch);
    &out.append(COPY item.else_branch);
    RETURN out;
  END
  IF value IS_A ImplementationDef AS item THEN
    FOR rtoc_member IN item.members DO
      &out.append(COPY rtoc_member.body);
    END
    RETURN out;
  END
  IF value IS_A ConformanceDef AS item THEN
    FOR rtoc_member IN item.members DO
      &out.append(COPY rtoc_member.body);
    END
    RETURN out;
  END
  IF value IS_A DoBlock AS item THEN
    FOR rtoc_branch IN item.branches DO
      &out.append(COPY rtoc_branch.body);
    END
    RETURN out;
  END
  IF value IS_A WithBlock AS item THEN
    &out.append(COPY item.body);
    IF item.arms EXISTS AS rtoc_arms THEN
      FOR rtoc_arm IN rtoc_arms DO
        &out.append(COPY rtoc_arm.body);
      END
    END
    RETURN out;
  END
  IF value IS_A MatchStatement AS item THEN
    FOR rtoc_case IN item.cases DO
      &out.append(COPY rtoc_case.body);
    END
    IF item.default_case EXISTS AS rtoc_default THEN
      &out.append(COPY rtoc_default);
    END
    RETURN out;
  END
  IF value IS_A TestBlock AS item THEN
    IF item.setup EXISTS AS rtoc_setup THEN
      &out.append(COPY rtoc_setup);
    END
    IF item.before_each EXISTS AS rtoc_before_each THEN
      FOR rtoc_hook IN rtoc_before_each DO
        &out.append(COPY rtoc_hook);
      END
    END
    IF item.after_each EXISTS AS rtoc_after_each THEN
      FOR rtoc_hook IN rtoc_after_each DO
        &out.append(COPY rtoc_hook);
      END
    END
    IF item.before_all EXISTS AS rtoc_before_all THEN
      FOR rtoc_hook IN rtoc_before_all DO
        &out.append(COPY rtoc_hook);
      END
    END
    IF item.after_all EXISTS AS rtoc_after_all THEN
      FOR rtoc_hook IN rtoc_after_all DO
        &out.append(COPY rtoc_hook);
      END
    END
    FOR rtoc_when IN item.whens DO
      IF rtoc_when.setup EXISTS AS rtoc_when_setup THEN
        &out.append(COPY rtoc_when_setup);
      END
      FOR rtoc_test IN rtoc_when.tests DO
        &out.append(COPY rtoc_test.body);
      END
    END
    RETURN out;
  END
  RETURN out;
END
PUB FN aST__child_bodies(node: Locatable) RETURNS [][]Locatable EFFECTS REENTRANT ->
  RETURN locatable__child_bodies(node);
END
PUB FN locatable__map_children(value: Locatable, blk: FN(Locatable) -> Locatable) RETURNS Locatable EFFECTS REENTRANT ->
  IF value IS_A Program AS rtoc_variant THEN
    MUTABLE item = COPY rtoc_variant;
    MUTABLE rtoc_statements: []Locatable = List[];
    FOR rtoc_child IN item.statements DO
      &rtoc_statements.append(blk(COPY rtoc_child));
    END
    item.statements = rtoc_statements;
    RETURN Locatable{ Program: COPY item };
  END
  IF value IS_A FunctionDef AS rtoc_variant THEN
    MUTABLE item = COPY rtoc_variant;
    MUTABLE rtoc_body: []Locatable = List[];
    FOR rtoc_child IN item.body DO
      &rtoc_body.append(blk(COPY rtoc_child));
    END
    item.body = rtoc_body;
    MUTABLE rtoc_new_default_catch: ?[]Locatable = NIL;
    IF item.default_catch EXISTS AS rtoc_list THEN
      MUTABLE rtoc_default_catch: []Locatable = List[];
      FOR rtoc_child IN rtoc_list DO
        &rtoc_default_catch.append(blk(COPY rtoc_child));
      END
      rtoc_new_default_catch = rtoc_default_catch;
    END
    item.default_catch = rtoc_new_default_catch;
    RETURN Locatable{ FunctionDef: COPY item };
  END
  IF value IS_A VarDecl AS rtoc_variant THEN
    MUTABLE item = COPY rtoc_variant;
    item.value = blk(COPY item.value);
    RETURN Locatable{ VarDecl: COPY item };
  END
  IF value IS_A Assignment AS rtoc_variant THEN
    MUTABLE item = COPY rtoc_variant;
    item.value = blk(COPY item.value);
    RETURN Locatable{ Assignment: COPY item };
  END
  IF value IS_A DestructuringAssignment AS rtoc_variant THEN
    MUTABLE item = COPY rtoc_variant;
    item.value = blk(COPY item.value);
    RETURN Locatable{ DestructuringAssignment: COPY item };
  END
  IF value IS_A BindExpr AS rtoc_variant THEN
    MUTABLE item = COPY rtoc_variant;
    item.value = blk(COPY item.value);
    RETURN Locatable{ BindExpr: COPY item };
  END
  IF value IS_A BinaryOp AS rtoc_variant THEN
    MUTABLE item = COPY rtoc_variant;
    item.left = blk(COPY item.left);
    item.right = blk(COPY item.right);
    RETURN Locatable{ BinaryOp: COPY item };
  END
  IF value IS_A IsA AS rtoc_variant THEN
    MUTABLE item = COPY rtoc_variant;
    item.left = blk(COPY item.left);
    RETURN Locatable{ IsA: COPY item };
  END
  IF value IS_A UnaryOp AS rtoc_variant THEN
    MUTABLE item = COPY rtoc_variant;
    item.right = blk(COPY item.right);
    RETURN Locatable{ UnaryOp: COPY item };
  END
  IF value IS_A CallSiteOverride AS rtoc_variant THEN
    MUTABLE item = COPY rtoc_variant;
    item.inner = blk(COPY item.inner);
    RETURN Locatable{ CallSiteOverride: COPY item };
  END
  IF value IS_A ListLit AS rtoc_variant THEN
    MUTABLE item = COPY rtoc_variant;
    MUTABLE rtoc_items: []Locatable = List[];
    FOR rtoc_child IN item.items DO
      &rtoc_items.append(blk(COPY rtoc_child));
    END
    item.items = rtoc_items;
    RETURN Locatable{ ListLit: COPY item };
  END
  IF value IS_A TupleLit AS rtoc_variant THEN
    MUTABLE item = COPY rtoc_variant;
    MUTABLE rtoc_items: []Locatable = List[];
    FOR rtoc_child IN item.items DO
      &rtoc_items.append(blk(COPY rtoc_child));
    END
    item.items = rtoc_items;
    RETURN Locatable{ TupleLit: COPY item };
  END
  IF value IS_A StructLit AS rtoc_variant THEN
    MUTABLE item = COPY rtoc_variant;
    MUTABLE rtoc_fields: {String}Locatable = {};
    FOR rtoc_key IN item.fields.keys() DO
      rtoc_fields[rtoc_key] = blk(COPY UNWRAP (item.fields[rtoc_key]));
    END
    item.fields = rtoc_fields;
    RETURN Locatable{ StructLit: COPY item };
  END
  IF value IS_A LambdaLit AS rtoc_variant THEN
    MUTABLE item = COPY rtoc_variant;
    MUTABLE rtoc_new_deferred_drops: ?[]Locatable = NIL;
    IF item.deferred_drops EXISTS AS rtoc_list THEN
      MUTABLE rtoc_deferred_drops: []Locatable = List[];
      FOR rtoc_child IN rtoc_list DO
        &rtoc_deferred_drops.append(blk(COPY rtoc_child));
      END
      rtoc_new_deferred_drops = rtoc_deferred_drops;
    END
    item.deferred_drops = rtoc_new_deferred_drops;
    RETURN Locatable{ LambdaLit: COPY item };
  END
  IF value IS_A IfStatement AS rtoc_variant THEN
    MUTABLE item = COPY rtoc_variant;
    item.condition = blk(COPY item.condition);
    MUTABLE rtoc_new_else_branch: ?[]Locatable = NIL;
    IF item.else_branch EXISTS AS rtoc_list THEN
      MUTABLE rtoc_else_branch: []Locatable = List[];
      FOR rtoc_child IN rtoc_list DO
        &rtoc_else_branch.append(blk(COPY rtoc_child));
      END
      rtoc_new_else_branch = rtoc_else_branch;
    END
    item.else_branch = rtoc_new_else_branch;
    MUTABLE rtoc_then_branch: []Locatable = List[];
    FOR rtoc_child IN item.then_branch DO
      &rtoc_then_branch.append(blk(COPY rtoc_child));
    END
    item.then_branch = rtoc_then_branch;
    RETURN Locatable{ IfStatement: COPY item };
  END
  IF value IS_A IfBind AS rtoc_variant THEN
    MUTABLE item = COPY rtoc_variant;
    MUTABLE rtoc_else_branch: []Locatable = List[];
    FOR rtoc_child IN item.else_branch DO
      &rtoc_else_branch.append(blk(COPY rtoc_child));
    END
    item.else_branch = rtoc_else_branch;
    MUTABLE rtoc_then_branch: []Locatable = List[];
    FOR rtoc_child IN item.then_branch DO
      &rtoc_then_branch.append(blk(COPY rtoc_child));
    END
    item.then_branch = rtoc_then_branch;
    RETURN Locatable{ IfBind: COPY item };
  END
  IF value IS_A WhileLoop AS rtoc_variant THEN
    MUTABLE item = COPY rtoc_variant;
    item.condition = blk(COPY item.condition);
    MUTABLE rtoc_do_branch: []Locatable = List[];
    FOR rtoc_child IN item.do_branch DO
      &rtoc_do_branch.append(blk(COPY rtoc_child));
    END
    item.do_branch = rtoc_do_branch;
    RETURN Locatable{ WhileLoop: COPY item };
  END
  IF value IS_A WhileBindLoop AS rtoc_variant THEN
    MUTABLE item = COPY rtoc_variant;
    item.condition = blk(COPY item.condition);
    MUTABLE rtoc_do_branch: []Locatable = List[];
    FOR rtoc_child IN item.do_branch DO
      &rtoc_do_branch.append(blk(COPY rtoc_child));
    END
    item.do_branch = rtoc_do_branch;
    RETURN Locatable{ WhileBindLoop: COPY item };
  END
  IF value IS_A FuncCall AS rtoc_variant THEN
    MUTABLE item = COPY rtoc_variant;
    MUTABLE rtoc_args: []Locatable = List[];
    FOR rtoc_child IN item.args DO
      &rtoc_args.append(blk(COPY rtoc_child));
    END
    item.args = rtoc_args;
    MUTABLE rtoc_new_pipe_lhs: ?Locatable = NIL;
    IF item.pipe_lhs EXISTS AS rtoc_child THEN
      rtoc_new_pipe_lhs = blk(COPY rtoc_child);
    END
    item.pipe_lhs = rtoc_new_pipe_lhs;
    RETURN Locatable{ FuncCall: COPY item };
  END
  IF value IS_A MethodCall AS rtoc_variant THEN
    MUTABLE item = COPY rtoc_variant;
    MUTABLE rtoc_args: []Locatable = List[];
    FOR rtoc_child IN item.args DO
      &rtoc_args.append(blk(COPY rtoc_child));
    END
    item.args = rtoc_args;
    item.object = blk(COPY item.object);
    RETURN Locatable{ MethodCall: COPY item };
  END
  IF value IS_A GetField AS rtoc_variant THEN
    MUTABLE item = COPY rtoc_variant;
    item.target = blk(COPY item.target);
    RETURN Locatable{ GetField: COPY item };
  END
  IF value IS_A GetIndex AS rtoc_variant THEN
    MUTABLE item = COPY rtoc_variant;
    item.index = blk(COPY item.index);
    item.target = blk(COPY item.target);
    RETURN Locatable{ GetIndex: COPY item };
  END
  IF value IS_A Cast AS rtoc_variant THEN
    MUTABLE item = COPY rtoc_variant;
    item.value = blk(COPY item.value);
    RETURN Locatable{ Cast: COPY item };
  END
  IF value IS_A ReturnNode AS rtoc_variant THEN
    MUTABLE item = COPY rtoc_variant;
    MUTABLE rtoc_new_value: ?Locatable = NIL;
    IF item.value EXISTS AS rtoc_child THEN
      rtoc_new_value = blk(COPY rtoc_child);
    END
    item.value = rtoc_new_value;
    RETURN Locatable{ ReturnNode: COPY item };
  END
  IF value IS_A Assert AS rtoc_variant THEN
    MUTABLE item = COPY rtoc_variant;
    item.condition = blk(COPY item.condition);
    RETURN Locatable{ Assert: COPY item };
  END
  IF value IS_A Raise AS rtoc_variant THEN
    MUTABLE item = COPY rtoc_variant;
    MUTABLE rtoc_new_message_expr: ?Locatable = NIL;
    IF item.message_expr EXISTS AS rtoc_child THEN
      rtoc_new_message_expr = blk(COPY rtoc_child);
    END
    item.message_expr = rtoc_new_message_expr;
    RETURN Locatable{ Raise: COPY item };
  END
  IF value IS_A ThrowNode AS rtoc_variant THEN
    MUTABLE item = COPY rtoc_variant;
    MUTABLE rtoc_new_value: ?Locatable = NIL;
    IF item.value EXISTS AS rtoc_child THEN
      rtoc_new_value = blk(COPY rtoc_child);
    END
    item.value = rtoc_new_value;
    RETURN Locatable{ ThrowNode: COPY item };
  END
  IF value IS_A DieNode AS rtoc_variant THEN
    MUTABLE item = COPY rtoc_variant;
