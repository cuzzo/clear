    Locatable.BindExpr AS item -> RETURN COPY item.source_range;,
    Locatable.BinaryOp AS item -> RETURN COPY item.source_range;,
    Locatable.IsA AS item -> RETURN COPY item.source_range;,
    Locatable.UnaryOp AS item -> RETURN COPY item.source_range;,
    Locatable.CallSiteOverride AS item -> RETURN COPY item.source_range;,
    Locatable.Identifier AS item -> RETURN COPY item.source_range;,
    Locatable.Literal AS item -> RETURN COPY item.source_range;,
    Locatable.ListLit AS item -> RETURN COPY item.source_range;,
