    PatternFieldValue.DestructureTarget AS item -> RETURN Locatable{ DestructureTarget: COPY item };,
    PatternFieldValue.DestructuringAssignment AS item -> RETURN Locatable{ DestructuringAssignment: COPY item };,
    PatternFieldValue.BindExpr AS item -> RETURN Locatable{ BindExpr: COPY item };,
    PatternFieldValue.BinaryOp AS item -> RETURN Locatable{ BinaryOp: COPY item };,
    PatternFieldValue.IsA AS item -> RETURN Locatable{ IsA: COPY item };,
    PatternFieldValue.UnaryOp AS item -> RETURN Locatable{ UnaryOp: COPY item };,
