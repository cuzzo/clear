    MUTABLE item = COPY rtoc_variant;
    MUTABLE rtoc_new_field: ?Locatable@boxed = NIL;
    IF item.field EXISTS AS rtoc_child THEN
      rtoc_new_field = blk(COPY rtoc_child);
    END
    item.field = rtoc_new_field;
    RETURN Locatable{ FieldCleanup: COPY item };
  END
  RETURN COPY value;
END
PUB FN castNodeListToLocatableList(values: []Node) RETURNS []Locatable ->
  MUTABLE out: []Locatable = List[];
  FOR value IN values DO
    &out.append(UNWRAP (castNodeToLocatable(value)));
  END
  RETURN out;
END
FN castNodeToLocatable(value: Node) RETURNS ?Locatable ->
  PARTIAL MATCH value START
    Node.Program AS item -> RETURN Locatable{ Program: COPY item };,
    Node.RequireNode AS item -> RETURN Locatable{ RequireNode: COPY item };,
    Node.ProtocolRequirement AS item -> RETURN Locatable{ ProtocolRequirement: COPY item };,
    Node.ProtocolDef AS item -> RETURN Locatable{ ProtocolDef: COPY item };,
    Node.FunctionDef AS item -> RETURN Locatable{ FunctionDef: COPY item };,
    Node.ImplementationDef AS item -> RETURN Locatable{ ImplementationDef: COPY item };,
