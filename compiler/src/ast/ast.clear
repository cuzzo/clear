    Locatable.UnionVariantLit AS cast_payload -> RETURN Locatable{ UnionVariantLit: COPY cast_payload };,
    Locatable.StaticCall AS cast_payload -> RETURN Locatable{ StaticCall: COPY cast_payload };,
    Locatable.DoBlock AS cast_payload -> RETURN Locatable{ DoBlock: COPY cast_payload };,
    Locatable.BgBlock AS cast_payload -> RETURN Locatable{ BgBlock: COPY cast_payload };,
    Locatable.ThenChain AS cast_payload -> RETURN Locatable{ ThenChain: COPY cast_payload };,
    Locatable.BgStreamBlock AS cast_payload -> RETURN Locatable{ BgStreamBlock: COPY cast_payload };,
    Locatable.YieldExpr AS cast_payload -> RETURN Locatable{ YieldExpr: COPY cast_payload };,
    Locatable.CloseStream AS cast_payload -> RETURN Locatable{ CloseStream: COPY cast_payload };,
    Locatable.NextExpr AS cast_payload -> RETURN Locatable{ NextExpr: COPY cast_payload };,
    Locatable.MatchStatement AS cast_payload -> RETURN Locatable{ MatchStatement: COPY cast_payload };,
    Locatable.ForRange AS cast_payload -> RETURN Locatable{ ForRange: COPY cast_payload };,
    Locatable.ForEach AS cast_payload -> RETURN Locatable{ ForEach: COPY cast_payload };,
    Locatable.TestBlock AS cast_payload -> RETURN Locatable{ TestBlock: COPY cast_payload };,
    Locatable.WhenBlock AS cast_payload -> RETURN Locatable{ WhenBlock: COPY cast_payload };,
    Locatable.LetBinding AS cast_payload -> RETURN Locatable{ LetBinding: COPY cast_payload };,
    Locatable.TestThat AS cast_payload -> RETURN Locatable{ TestThat: COPY cast_payload };,
    Locatable.AssertRaises AS cast_payload -> RETURN Locatable{ AssertRaises: COPY cast_payload };,
    Locatable.BenchmarkStmt AS cast_payload -> RETURN Locatable{ BenchmarkStmt: COPY cast_payload };,
    Locatable.SmashStmt AS cast_payload -> RETURN Locatable{ SmashStmt: COPY cast_payload };,
    Locatable.ProfileStmt AS cast_payload -> RETURN Locatable{ ProfileStmt: COPY cast_payload };,
    Locatable.StubDecl AS cast_payload -> RETURN Locatable{ StubDecl: COPY cast_payload };,
    Locatable.Drop AS cast_payload -> RETURN Locatable{ Drop: COPY cast_payload };,
    Locatable.SuppressCleanup AS cast_payload -> RETURN Locatable{ SuppressCleanup: COPY cast_payload };,
    Locatable.Return AS cast_payload -> RETURN Locatable{ Return: COPY cast_payload };,
    Locatable.ReassignCleanup AS cast_payload -> RETURN Locatable{ ReassignCleanup: COPY cast_payload };,
    Locatable.FieldCleanup AS cast_payload -> RETURN Locatable{ FieldCleanup: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Locatable");
  END
  panic("Invalid cast to Locatable");
END
PUB FN rtocChildrenLocatable(node: Locatable) RETURNS []Locatable ->
  PARTIAL MATCH node START
    Locatable.Program AS v -> RETURN rtocChildrenOfLocatableProgram(v);,
    Locatable.FunctionDef AS v -> RETURN rtocChildrenOfLocatableFunctionDef(v);,
    Locatable.Assignment AS v -> RETURN rtocChildrenOfLocatableAssignment(v);,
    Locatable.ListLit AS v -> RETURN rtocChildrenOfLocatableListLit(v);,
    Locatable.LambdaLit AS v -> RETURN rtocChildrenOfLocatableLambdaLit(v);,
    Locatable.IfStatement AS v -> RETURN rtocChildrenOfLocatableIfStatement(v);,
    Locatable.WhileLoop AS v -> RETURN rtocChildrenOfLocatableWhileLoop(v);,
    Locatable.WhileBindLoop AS v -> RETURN rtocChildrenOfLocatableWhileBindLoop(v);,
    Locatable.FuncCall AS v -> RETURN rtocChildrenOfLocatableFuncCall(v);,
    Locatable.MethodCall AS v -> RETURN rtocChildrenOfLocatableMethodCall(v);,
    Locatable.GetField AS v -> RETURN rtocChildrenOfLocatableGetField(v);,
    Locatable.WithBlock AS v -> RETURN rtocChildrenOfLocatableWithBlock(v);,
    Locatable.OptionalUnwrap AS v -> RETURN rtocChildrenOfLocatableOptionalUnwrap(v);,
    Locatable.TenseNavigation AS v -> RETURN rtocChildrenOfLocatableTenseNavigation(v);,
    Locatable.BlockExpr AS v -> RETURN rtocChildrenOfLocatableBlockExpr(v);,
    Locatable.StringConcat AS v -> RETURN rtocChildrenOfLocatableStringConcat(v);,
    Locatable.MoveNode AS v -> RETURN rtocChildrenOfLocatableMoveNode(v);,
    Locatable.CopyNode AS v -> RETURN rtocChildrenOfLocatableCopyNode(v);,
    Locatable.KeepNode AS v -> RETURN rtocChildrenOfLocatableKeepNode(v);,
    Locatable.ShareNode AS v -> RETURN rtocChildrenOfLocatableShareNode(v);,
    Locatable.StaticCall AS v -> RETURN rtocChildrenOfLocatableStaticCall(v);,
    Locatable.YieldExpr AS v -> RETURN rtocChildrenOfLocatableYieldExpr(v);,
    Locatable.NextExpr AS v -> RETURN rtocChildrenOfLocatableNextExpr(v);,
    Locatable.MatchStatement AS v -> RETURN rtocChildrenOfLocatableMatchStatement(v);,
    Locatable.LetBinding AS v -> RETURN rtocChildrenOfLocatableLetBinding(v);,
  END
  MUTABLE rtoc_no_children: []Locatable = [];
  RETURN rtoc_no_children;
END
FN rtocChildrenOfLocatableAssignment(v: Assignment) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(castAssignmentNameToLocatable__ast(COPY v.name));
  &out.append(COPY v.value);
  RETURN out;
END
FN rtocChildrenOfLocatableBlockExpr(v: BlockExpr) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  FOR rtoc_arr_child IN v.body DO
    &out.append(COPY rtoc_arr_child);
  END
  IF v.result EXISTS AS rtoc_opt_child THEN
    &out.append(COPY rtoc_opt_child);
  END
  RETURN out;
END
FN rtocChildrenOfLocatableCopyNode(v: CopyNode) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.value);
  RETURN out;
END
FN rtocChildrenOfLocatableFuncCall(v: FuncCall) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  FOR rtoc_arr_child IN v.args DO
    &out.append(COPY rtoc_arr_child);
  END
  RETURN out;
END
FN rtocChildrenOfLocatableFunctionDef(v: FunctionDef) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  FOR rtoc_arr_child IN v.body DO
    &out.append(COPY rtoc_arr_child);
  END
  RETURN out;
END
FN rtocChildrenOfLocatableGetField(v: GetField) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.target);
  RETURN out;
END
FN rtocChildrenOfLocatableIfStatement(v: IfStatement) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.condition);
  FOR rtoc_arr_child IN v.then_branch DO
    &out.append(COPY rtoc_arr_child);
  END
  IF v.else_branch EXISTS AS rtoc_opt_child THEN
    FOR rtoc_arr_child IN rtoc_opt_child DO
      &out.append(COPY rtoc_arr_child);
    END
  END
  RETURN out;
END
FN rtocChildrenOfLocatableKeepNode(v: KeepNode) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.value);
  RETURN out;
END
FN rtocChildrenOfLocatableLambdaLit(v: LambdaLit) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(castLambdaBodyToLocatable(COPY v.body));
  RETURN out;
END
FN rtocChildrenOfLocatableLetBinding(v: LetBinding) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.expr);
  RETURN out;
END
FN rtocChildrenOfLocatableListLit(v: ListLit) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  FOR rtoc_arr_child IN v.items DO
    &out.append(COPY rtoc_arr_child);
  END
  RETURN out;
END
FN rtocChildrenOfLocatableMatchStatement(v: MatchStatement) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.expr);
  RETURN out;
END
FN rtocChildrenOfLocatableMethodCall(v: MethodCall) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.object);
  FOR rtoc_arr_child IN v.args DO
    &out.append(COPY rtoc_arr_child);
  END
  RETURN out;
END
FN rtocChildrenOfLocatableMoveNode(v: MoveNode) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.value);
  RETURN out;
END
FN rtocChildrenOfLocatableNextExpr(v: NextExpr) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.expr);
  RETURN out;
END
FN rtocChildrenOfLocatableOptionalUnwrap(v: OptionalUnwrap) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.target);
  RETURN out;
END
FN rtocChildrenOfLocatableProgram(v: Program) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  FOR rtoc_arr_child IN v.statements DO
    &out.append(COPY rtoc_arr_child);
  END
  RETURN out;
END
FN rtocChildrenOfLocatableShareNode(v: ShareNode) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.value);
  RETURN out;
END
FN rtocChildrenOfLocatableStaticCall(v: StaticCall) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  IF v.inherent_call EXISTS AS rtoc_opt_child THEN
    &out.append(Locatable{ FuncCall: COPY rtoc_opt_child });
  END
  RETURN out;
END
FN rtocChildrenOfLocatableStringConcat(v: StringConcat) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  FOR rtoc_arr_child IN v.parts DO
    &out.append(COPY rtoc_arr_child);
  END
  RETURN out;
END
FN rtocChildrenOfLocatableTenseNavigation(v: TenseNavigation) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.target);
  RETURN out;
END
FN rtocChildrenOfLocatableWhileBindLoop(v: WhileBindLoop) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.condition);
  FOR rtoc_arr_child IN v.do_branch DO
    &out.append(COPY rtoc_arr_child);
  END
  RETURN out;
END
FN rtocChildrenOfLocatableWhileLoop(v: WhileLoop) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.condition);
  FOR rtoc_arr_child IN v.do_branch DO
    &out.append(COPY rtoc_arr_child);
  END
  RETURN out;
END
FN rtocChildrenOfLocatableWithBlock(v: WithBlock) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  FOR rtoc_arr_child IN v.body DO
    &out.append(COPY rtoc_arr_child);
  END
  RETURN out;
END
FN rtocChildrenOfLocatableYieldExpr(v: YieldExpr) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.expr);
  RETURN out;
END

# Node identity. Ruby keys visited-sets and slot ids by `object_id`; CLEAR has
# no address-of, so identity is derived from data: the node's source span plus
# its variant tag, which is unique for any two distinct nodes of the same kind.
PUB FN aST__token_identity(token: Token, kind_index: Int64) RETURNS Int64 ->
  MUTABLE start_value: Int64 = (token.start_offset OR_ELSE ((token.line * 4096) + token.column));
  MUTABLE end_value: Int64 = (token.end_offset OR_ELSE 0);
  RETURN ((((start_value * 10000000) + end_value) * 128) + kind_index);
END
PUB FN aST__node_identity(node: Locatable) RETURNS Int64 ->
  PARTIAL MATCH node START
    Locatable.Program AS item -> RETURN aST__token_identity(item.token, 0);,
    Locatable.RequireNode AS item -> RETURN aST__token_identity(item.token, 1);,
    Locatable.ProtocolRequirement AS item -> RETURN aST__token_identity(item.token, 2);,
    Locatable.ProtocolDef AS item -> RETURN aST__token_identity(item.token, 3);,
    Locatable.FunctionDef AS item -> RETURN aST__token_identity(item.token, 4);,
    Locatable.ImplementationDef AS item -> RETURN aST__token_identity(item.token, 5);,
    Locatable.ConformanceDef AS item -> RETURN aST__token_identity(item.token, 6);,
    Locatable.StructDef AS item -> RETURN aST__token_identity(item.token, 7);,
    Locatable.VarDecl AS item -> RETURN aST__token_identity(item.token, 8);,
    Locatable.Assignment AS item -> RETURN aST__token_identity(item.token, 9);,
    Locatable.DestructureTarget AS item -> RETURN aST__token_identity(item.token, 10);,
    Locatable.DestructuringAssignment AS item -> RETURN aST__token_identity(item.token, 11);,
    Locatable.BindExpr AS item -> RETURN aST__token_identity(item.token, 12);,
    Locatable.BinaryOp AS item -> RETURN aST__token_identity(item.token, 13);,
    Locatable.IsA AS item -> RETURN aST__token_identity(item.token, 14);,
    Locatable.UnaryOp AS item -> RETURN aST__token_identity(item.token, 15);,
    Locatable.CallSiteOverride AS item -> RETURN aST__token_identity(item.token, 16);,
    Locatable.Identifier AS item -> RETURN aST__token_identity(item.token, 17);,
    Locatable.Literal AS item -> RETURN aST__token_identity(item.token, 18);,
    Locatable.ListLit AS item -> RETURN aST__token_identity(item.token, 19);,
    Locatable.TupleLit AS item -> RETURN aST__token_identity(item.token, 20);,
    Locatable.DefaultArrayLit AS item -> RETURN aST__token_identity(item.token, 21);,
    Locatable.HashLit AS item -> RETURN aST__token_identity(item.token, 22);,
    Locatable.DefaultLit AS item -> RETURN aST__token_identity(item.token, 23);,
    Locatable.StructLit AS item -> RETURN aST__token_identity(item.token, 24);,
    Locatable.LambdaLit AS item -> RETURN aST__token_identity(item.token, 25);,
    Locatable.IfStatement AS item -> RETURN aST__token_identity(item.token, 26);,
    Locatable.IfBind AS item -> RETURN aST__token_identity(item.token, 27);,
    Locatable.WhileLoop AS item -> RETURN aST__token_identity(item.token, 28);,
    Locatable.WhileBindLoop AS item -> RETURN aST__token_identity(item.token, 29);,
    Locatable.BreakNode AS item -> RETURN aST__token_identity(item.token, 30);,
    Locatable.ContinueNode AS item -> RETURN aST__token_identity(item.token, 31);,
    Locatable.FuncCall AS item -> RETURN aST__token_identity(item.token, 32);,
    Locatable.MethodCall AS item -> RETURN aST__token_identity(item.token, 33);,
    Locatable.GetField AS item -> RETURN aST__token_identity(item.token, 34);,
    Locatable.GetIndex AS item -> RETURN aST__token_identity(item.token, 35);,
    Locatable.Cast AS item -> RETURN aST__token_identity(item.token, 36);,
    Locatable.ReturnNode AS item -> RETURN aST__token_identity(item.token, 37);,
    Locatable.Assert AS item -> RETURN aST__token_identity(item.token, 38);,
    Locatable.Raise AS item -> RETURN aST__token_identity(item.token, 39);,
    Locatable.ThrowNode AS item -> RETURN aST__token_identity(item.token, 40);,
    Locatable.DieNode AS item -> RETURN aST__token_identity(item.token, 41);,
    Locatable.Slice AS item -> RETURN aST__token_identity(item.token, 42);,
    Locatable.Require AS item -> RETURN aST__token_identity(item.token, 43);,
    Locatable.DeferStmt AS item -> RETURN aST__token_identity(item.token, 44);,
    Locatable.WithBlock AS item -> RETURN aST__token_identity(item.token, 45);,
    Locatable.SyncPolicyDecl AS item -> RETURN aST__token_identity(item.token, 46);,
    Locatable.SelectOp AS item -> RETURN aST__token_identity(item.token, 47);,
    Locatable.WhereOp AS item -> RETURN aST__token_identity(item.token, 48);,
    Locatable.IndexOp AS item -> RETURN aST__token_identity(item.token, 49);,
    Locatable.ReduceOp AS item -> RETURN aST__token_identity(item.token, 50);,
    Locatable.OrderByOp AS item -> RETURN aST__token_identity(item.token, 51);,
    Locatable.LimitOp AS item -> RETURN aST__token_identity(item.token, 52);,
    Locatable.UnnestOp AS item -> RETURN aST__token_identity(item.token, 53);,
    Locatable.DistinctOp AS item -> RETURN aST__token_identity(item.token, 54);,
    Locatable.EachOp AS item -> RETURN aST__token_identity(item.token, 55);,
    Locatable.TapOp AS item -> RETURN aST__token_identity(item.token, 56);,
    Locatable.SkipOp AS item -> RETURN aST__token_identity(item.token, 57);,
    Locatable.CollectOp AS item -> RETURN aST__token_identity(item.token, 58);,
    Locatable.TakeWhileOp AS item -> RETURN aST__token_identity(item.token, 59);,
    Locatable.WindowOp AS item -> RETURN aST__token_identity(item.token, 60);,
    Locatable.BatchWindowOp AS item -> RETURN aST__token_identity(item.token, 61);,
    Locatable.JoinOp AS item -> RETURN aST__token_identity(item.token, 62);,
    Locatable.FindOp AS item -> RETURN aST__token_identity(item.token, 63);,
    Locatable.AnyOp AS item -> RETURN aST__token_identity(item.token, 64);,
    Locatable.AllOp AS item -> RETURN aST__token_identity(item.token, 65);,
    Locatable.CountOp AS item -> RETURN aST__token_identity(item.token, 66);,
    Locatable.SumOp AS item -> RETURN aST__token_identity(item.token, 67);,
    Locatable.AverageOp AS item -> RETURN aST__token_identity(item.token, 68);,
    Locatable.MinOp AS item -> RETURN aST__token_identity(item.token, 69);,
    Locatable.MaxOp AS item -> RETURN aST__token_identity(item.token, 70);,
    Locatable.ShardOp AS item -> RETURN aST__token_identity(item.token, 71);,
    Locatable.ConcurrentOp AS item -> RETURN aST__token_identity(item.token, 72);,
    Locatable.Placeholder AS item -> RETURN aST__token_identity(item.token, 73);,
    Locatable.Copy AS item -> RETURN aST__token_identity(item.token, 74);,
    Locatable.OptionalUnwrap AS item -> RETURN aST__token_identity(item.token, 75);,
    Locatable.TenseNavigation AS item -> RETURN aST__token_identity(item.token, 76);,
    Locatable.MutableBorrow AS item -> RETURN aST__token_identity(item.token, 77);,
    Locatable.OrElseRaise AS item -> RETURN aST__token_identity(item.token, 78);,
    Locatable.OrElseExit AS item -> RETURN aST__token_identity(item.token, 79);,
    Locatable.OrElsePass AS item -> RETURN aST__token_identity(item.token, 80);,
    Locatable.OrElsePrune AS item -> RETURN aST__token_identity(item.token, 81);,
    Locatable.OrElseBreak AS item -> RETURN aST__token_identity(item.token, 82);,
