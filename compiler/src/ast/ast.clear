  PARTIAL MATCH node START
    Locatable.BinaryOp AS item -> RETURN COPY item.retain_error_channel;,
    Locatable.FuncCall AS item -> RETURN COPY item.retain_error_channel;,
    Locatable.MethodCall AS item -> RETURN COPY item.retain_error_channel;,
    Locatable.StaticCall AS item -> RETURN COPY item.retain_error_channel;,
