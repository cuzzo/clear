    Locatable.FuncCall AS item -> RETURN COPY item.error_union_type;,
    Locatable.MethodCall AS item -> RETURN COPY item.error_union_type;,
    Locatable.OptionalUnwrap AS item -> RETURN COPY item.error_union_type;,
    Locatable.StaticCall AS item -> RETURN COPY item.error_union_type;,
  END
