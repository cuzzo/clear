PUB FN aST__declaration_symbol(symbol: SymbolEntry) RETURNS ?SymbolEntry@multiowned ->
  RETURN KEEP symbolEntry__reg_symbol(symbol);
END
PUB FN aST__node_heap_storage?(node: Locatable) RETURNS Bool ->
  IF aST__node__symbol(node) EXISTS AS symbol THEN
    IF symbolEntry__heap_storage?(symbol) THEN
      RETURN TRUE;
    END
  END
  RETURN (aST__node_storage_override(node) == :heap);
END
PUB FN aST__node_borrow_provenance?(node: Locatable) RETURNS Bool ->
  IF aST__node__symbol(node) EXISTS AS symbol THEN
    IF symbolEntry__borrow_provenance?(symbol) THEN
      RETURN TRUE;
    END
  END
  RETURN (aST__node_storage_override(node) == :borrow);
END
PUB FN aST__node_rodata_provenance?(node: Locatable) RETURNS Bool ->
  IF aST__node__symbol(node) EXISTS AS symbol THEN
    IF symbolEntry__rodata_provenance?(symbol) THEN
      RETURN TRUE;
    END
  END
  RETURN (aST__node_storage_override(node) == :rodata);
END
PUB FN aST__node_alloc(node: Locatable) RETURNS ?String@symbol ->
  PARTIAL MATCH node START
    Locatable.CopyNode AS item -> RETURN COPY item.alloc;,
    Locatable.ReassignCleanup AS item -> RETURN COPY item.alloc;,
    Locatable.FieldCleanup AS item -> RETURN COPY item.alloc;
  END
  RETURN NIL;
END
PUB FN aST__node_capture_analysis(node: Locatable) RETURNS ?CaptureAnalysis ->
  PARTIAL MATCH node START
    Locatable.SelectOp AS item -> RETURN COPY item.capture_analysis;,
    Locatable.ConcurrentOp AS item -> RETURN COPY item.capture_analysis;,
    Locatable.BgBlock AS item -> RETURN COPY item.capture_analysis;,
    Locatable.BgStreamBlock AS item -> RETURN COPY item.capture_analysis;
  END
  RETURN NIL;
END
PUB FN aST__node_expr(node: Locatable) RETURNS ?Locatable ->
  PARTIAL MATCH node START
    Locatable.YieldExpr AS item -> RETURN COPY item.expr;,
    Locatable.NextExpr AS item -> RETURN COPY item.expr;,
    Locatable.MatchStatement AS item -> RETURN COPY item.expr;,
    Locatable.LetBinding AS item -> RETURN COPY item.expr;
  END
  RETURN NIL;
END
