    MUTABLE setup_items: []Locatable = COPY UNWRAP (item.setup);
    aST__each_locatable_list_mut(&setup_items, &descend_functions, visitor);
    item.setup = COPY setup_items;
  END
END
PRIVATE FN aST__walk_children_LetBinding_mut(MUTABLE item: LetBinding, MUTABLE descend_functions: Bool, visitor: FN(MUTABLE Locatable) -> Void) RETURNS Void EFFECTS REENTRANT ->
  MUTABLE expr_child: Locatable = COPY item.expr;
  aST__each_locatable_mut(&expr_child, &descend_functions, visitor);
  item.expr = COPY expr_child;
END
PRIVATE FN aST__walk_children_TestThat_mut(MUTABLE item: TestThat, MUTABLE descend_functions: Bool, visitor: FN(MUTABLE Locatable) -> Void) RETURNS Void EFFECTS REENTRANT ->
  MUTABLE body_items: []Locatable = COPY item.body;
  aST__each_locatable_list_mut(&body_items, &descend_functions, visitor);
  item.body = COPY body_items;
END
PRIVATE FN aST__walk_children_AssertRaises_mut(MUTABLE item: AssertRaises, MUTABLE descend_functions: Bool, visitor: FN(MUTABLE Locatable) -> Void) RETURNS Void EFFECTS REENTRANT ->
  MUTABLE expression_child: Locatable = COPY item.expression;
  aST__each_locatable_mut(&expression_child, &descend_functions, visitor);
  item.expression = COPY expression_child;
END
PRIVATE FN aST__walk_children_BenchmarkStmt_mut(MUTABLE item: BenchmarkStmt, MUTABLE descend_functions: Bool, visitor: FN(MUTABLE Locatable) -> Void) RETURNS Void EFFECTS REENTRANT ->
  MUTABLE expression_child: Locatable = COPY item.expression;
  aST__each_locatable_mut(&expression_child, &descend_functions, visitor);
  item.expression = COPY expression_child;
END
PRIVATE FN aST__walk_children_SmashStmt_mut(MUTABLE item: SmashStmt, MUTABLE descend_functions: Bool, visitor: FN(MUTABLE Locatable) -> Void) RETURNS Void EFFECTS REENTRANT ->
  MUTABLE expression_child: Locatable = COPY item.expression;
  aST__each_locatable_mut(&expression_child, &descend_functions, visitor);
  item.expression = COPY expression_child;
END
PRIVATE FN aST__walk_children_ProfileStmt_mut(MUTABLE item: ProfileStmt, MUTABLE descend_functions: Bool, visitor: FN(MUTABLE Locatable) -> Void) RETURNS Void EFFECTS REENTRANT ->
  MUTABLE expression_child: Locatable = COPY item.expression;
  aST__each_locatable_mut(&expression_child, &descend_functions, visitor);
  item.expression = COPY expression_child;
END
PRIVATE FN aST__walk_children_FieldCleanup_mut(MUTABLE item: FieldCleanup, MUTABLE descend_functions: Bool, visitor: FN(MUTABLE Locatable) -> Void) RETURNS Void EFFECTS REENTRANT ->
  IF item.field EXISTS THEN
    MUTABLE field_child: Locatable = COPY UNWRAP (item.field);
    aST__each_locatable_mut(&field_child, &descend_functions, visitor);
    item.field = COPY field_child;
  END
END
PUB FN aST__each_locatable_list(items: []Locatable, MUTABLE descend_functions: Bool, visitor: FN(Locatable) -> Void) RETURNS Void EFFECTS REENTRANT ->
  FOR item IN items DO
    aST__each_locatable(item, &descend_functions, visitor);
  END
END
PUB FN aST__each_locatable_mut(MUTABLE root: Locatable, MUTABLE descend_functions: Bool, visitor: FN(MUTABLE Locatable) -> Void) RETURNS Void EFFECTS REENTRANT ->
  visitor(&root);
  IF !(descend_functions) AND (root IS_A FunctionDef) THEN
    RETURN;
  END
  PARTIAL MATCH root START
    Locatable.Program AS MUTABLE item -> aST__walk_children_Program_mut(&item, &descend_functions, visitor);,
    Locatable.FunctionDef AS MUTABLE item -> aST__walk_children_FunctionDef_mut(&item, &descend_functions, visitor);,
    Locatable.VarDecl AS MUTABLE item -> aST__walk_children_VarDecl_mut(&item, &descend_functions, visitor);,
    Locatable.Assignment AS MUTABLE item -> aST__walk_children_Assignment_mut(&item, &descend_functions, visitor);,
    Locatable.DestructuringAssignment AS MUTABLE item -> aST__walk_children_DestructuringAssignment_mut(&item, &descend_functions, visitor);,
    Locatable.BindExpr AS MUTABLE item -> aST__walk_children_BindExpr_mut(&item, &descend_functions, visitor);,
    Locatable.BinaryOp AS MUTABLE item -> aST__walk_children_BinaryOp_mut(&item, &descend_functions, visitor);,
    Locatable.IsA AS MUTABLE item -> aST__walk_children_IsA_mut(&item, &descend_functions, visitor);,
    Locatable.UnaryOp AS MUTABLE item -> aST__walk_children_UnaryOp_mut(&item, &descend_functions, visitor);,
    Locatable.CallSiteOverride AS MUTABLE item -> aST__walk_children_CallSiteOverride_mut(&item, &descend_functions, visitor);,
    Locatable.ListLit AS MUTABLE item -> aST__walk_children_ListLit_mut(&item, &descend_functions, visitor);,
    Locatable.TupleLit AS MUTABLE item -> aST__walk_children_TupleLit_mut(&item, &descend_functions, visitor);,
    Locatable.LambdaLit AS MUTABLE item -> aST__walk_children_LambdaLit_mut(&item, &descend_functions, visitor);,
    Locatable.IfStatement AS MUTABLE item -> aST__walk_children_IfStatement_mut(&item, &descend_functions, visitor);,
    Locatable.IfBind AS MUTABLE item -> aST__walk_children_IfBind_mut(&item, &descend_functions, visitor);,
    Locatable.WhileLoop AS MUTABLE item -> aST__walk_children_WhileLoop_mut(&item, &descend_functions, visitor);,
    Locatable.WhileBindLoop AS MUTABLE item -> aST__walk_children_WhileBindLoop_mut(&item, &descend_functions, visitor);,
    Locatable.FuncCall AS MUTABLE item -> aST__walk_children_FuncCall_mut(&item, &descend_functions, visitor);,
    Locatable.MethodCall AS MUTABLE item -> aST__walk_children_MethodCall_mut(&item, &descend_functions, visitor);,
    Locatable.GetField AS MUTABLE item -> aST__walk_children_GetField_mut(&item, &descend_functions, visitor);,
    Locatable.GetIndex AS MUTABLE item -> aST__walk_children_GetIndex_mut(&item, &descend_functions, visitor);,
    Locatable.Cast AS MUTABLE item -> aST__walk_children_Cast_mut(&item, &descend_functions, visitor);,
    Locatable.ReturnNode AS MUTABLE item -> aST__walk_children_ReturnNode_mut(&item, &descend_functions, visitor);,
    Locatable.Assert AS MUTABLE item -> aST__walk_children_Assert_mut(&item, &descend_functions, visitor);,
    Locatable.Raise AS MUTABLE item -> aST__walk_children_Raise_mut(&item, &descend_functions, visitor);,
    Locatable.ThrowNode AS MUTABLE item -> aST__walk_children_ThrowNode_mut(&item, &descend_functions, visitor);,
    Locatable.DieNode AS MUTABLE item -> aST__walk_children_DieNode_mut(&item, &descend_functions, visitor);,
    Locatable.Slice AS MUTABLE item -> aST__walk_children_Slice_mut(&item, &descend_functions, visitor);,
    Locatable.DeferStmt AS MUTABLE item -> aST__walk_children_DeferStmt_mut(&item, &descend_functions, visitor);,
    Locatable.WithBlock AS MUTABLE item -> aST__walk_children_WithBlock_mut(&item, &descend_functions, visitor);,
    Locatable.SelectOp AS MUTABLE item -> aST__walk_children_SelectOp_mut(&item, &descend_functions, visitor);,
    Locatable.WhereOp AS MUTABLE item -> aST__walk_children_WhereOp_mut(&item, &descend_functions, visitor);,
    Locatable.IndexOp AS MUTABLE item -> aST__walk_children_IndexOp_mut(&item, &descend_functions, visitor);,
    Locatable.ReduceOp AS MUTABLE item -> aST__walk_children_ReduceOp_mut(&item, &descend_functions, visitor);,
    Locatable.OrderByOp AS MUTABLE item -> aST__walk_children_OrderByOp_mut(&item, &descend_functions, visitor);,
    Locatable.LimitOp AS MUTABLE item -> aST__walk_children_LimitOp_mut(&item, &descend_functions, visitor);,
    Locatable.UnnestOp AS MUTABLE item -> aST__walk_children_UnnestOp_mut(&item, &descend_functions, visitor);,
    Locatable.DistinctOp AS MUTABLE item -> aST__walk_children_DistinctOp_mut(&item, &descend_functions, visitor);,
    Locatable.EachOp AS MUTABLE item -> aST__walk_children_EachOp_mut(&item, &descend_functions, visitor);,
    Locatable.TapOp AS MUTABLE item -> aST__walk_children_TapOp_mut(&item, &descend_functions, visitor);,
    Locatable.SkipOp AS MUTABLE item -> aST__walk_children_SkipOp_mut(&item, &descend_functions, visitor);,
    Locatable.TakeWhileOp AS MUTABLE item -> aST__walk_children_TakeWhileOp_mut(&item, &descend_functions, visitor);,
    Locatable.WindowOp AS MUTABLE item -> aST__walk_children_WindowOp_mut(&item, &descend_functions, visitor);,
    Locatable.BatchWindowOp AS MUTABLE item -> aST__walk_children_BatchWindowOp_mut(&item, &descend_functions, visitor);,
    Locatable.JoinOp AS MUTABLE item -> aST__walk_children_JoinOp_mut(&item, &descend_functions, visitor);,
    Locatable.FindOp AS MUTABLE item -> aST__walk_children_FindOp_mut(&item, &descend_functions, visitor);,
    Locatable.AnyOp AS MUTABLE item -> aST__walk_children_AnyOp_mut(&item, &descend_functions, visitor);,
    Locatable.AllOp AS MUTABLE item -> aST__walk_children_AllOp_mut(&item, &descend_functions, visitor);,
    Locatable.CountOp AS MUTABLE item -> aST__walk_children_CountOp_mut(&item, &descend_functions, visitor);,
    Locatable.SumOp AS MUTABLE item -> aST__walk_children_SumOp_mut(&item, &descend_functions, visitor);,
    Locatable.AverageOp AS MUTABLE item -> aST__walk_children_AverageOp_mut(&item, &descend_functions, visitor);,
    Locatable.MinOp AS MUTABLE item -> aST__walk_children_MinOp_mut(&item, &descend_functions, visitor);,
    Locatable.MaxOp AS MUTABLE item -> aST__walk_children_MaxOp_mut(&item, &descend_functions, visitor);,
    Locatable.ShardOp AS MUTABLE item -> aST__walk_children_ShardOp_mut(&item, &descend_functions, visitor);,
    Locatable.Copy AS MUTABLE item -> aST__walk_children_Copy_mut(&item, &descend_functions, visitor);,
    Locatable.OptionalUnwrap AS MUTABLE item -> aST__walk_children_OptionalUnwrap_mut(&item, &descend_functions, visitor);,
    Locatable.TenseNavigation AS MUTABLE item -> aST__walk_children_TenseNavigation_mut(&item, &descend_functions, visitor);,
    Locatable.MutableBorrow AS MUTABLE item -> aST__walk_children_MutableBorrow_mut(&item, &descend_functions, visitor);,
    Locatable.OrElseExit AS MUTABLE item -> aST__walk_children_OrElseExit_mut(&item, &descend_functions, visitor);,
    Locatable.CatchBlock AS MUTABLE item -> aST__walk_children_CatchBlock_mut(&item, &descend_functions, visitor);,
    Locatable.RecoverOp AS MUTABLE item -> aST__walk_children_RecoverOp_mut(&item, &descend_functions, visitor);,
    Locatable.BlockExpr AS MUTABLE item -> aST__walk_children_BlockExpr_mut(&item, &descend_functions, visitor);,
    Locatable.StringConcat AS MUTABLE item -> aST__walk_children_StringConcat_mut(&item, &descend_functions, visitor);,
    Locatable.CapabilityWrap AS MUTABLE item -> aST__walk_children_CapabilityWrap_mut(&item, &descend_functions, visitor);,
    Locatable.MoveNode AS MUTABLE item -> aST__walk_children_MoveNode_mut(&item, &descend_functions, visitor);,
    Locatable.CopyNode AS MUTABLE item -> aST__walk_children_CopyNode_mut(&item, &descend_functions, visitor);,
    Locatable.KeepNode AS MUTABLE item -> aST__walk_children_KeepNode_mut(&item, &descend_functions, visitor);,
    Locatable.ShareNode AS MUTABLE item -> aST__walk_children_ShareNode_mut(&item, &descend_functions, visitor);,
    Locatable.LinkNode AS MUTABLE item -> aST__walk_children_LinkNode_mut(&item, &descend_functions, visitor);,
    Locatable.ResolveNode AS MUTABLE item -> aST__walk_children_ResolveNode_mut(&item, &descend_functions, visitor);,
    Locatable.FreezeNode AS MUTABLE item -> aST__walk_children_FreezeNode_mut(&item, &descend_functions, visitor);,
    Locatable.RangeLit AS MUTABLE item -> aST__walk_children_RangeLit_mut(&item, &descend_functions, visitor);,
    Locatable.StaticCall AS MUTABLE item -> aST__walk_children_StaticCall_mut(&item, &descend_functions, visitor);,
    Locatable.BgBlock AS MUTABLE item -> aST__walk_children_BgBlock_mut(&item, &descend_functions, visitor);,
    Locatable.BgStreamBlock AS MUTABLE item -> aST__walk_children_BgStreamBlock_mut(&item, &descend_functions, visitor);,
    Locatable.YieldExpr AS MUTABLE item -> aST__walk_children_YieldExpr_mut(&item, &descend_functions, visitor);,
    Locatable.NextExpr AS MUTABLE item -> aST__walk_children_NextExpr_mut(&item, &descend_functions, visitor);,
    Locatable.MatchStatement AS MUTABLE item -> aST__walk_children_MatchStatement_mut(&item, &descend_functions, visitor);,
    Locatable.ForRange AS MUTABLE item -> aST__walk_children_ForRange_mut(&item, &descend_functions, visitor);,
    Locatable.ForEach AS MUTABLE item -> aST__walk_children_ForEach_mut(&item, &descend_functions, visitor);,
    Locatable.TestBlock AS MUTABLE item -> aST__walk_children_TestBlock_mut(&item, &descend_functions, visitor);,
    Locatable.WhenBlock AS MUTABLE item -> aST__walk_children_WhenBlock_mut(&item, &descend_functions, visitor);,
    Locatable.LetBinding AS MUTABLE item -> aST__walk_children_LetBinding_mut(&item, &descend_functions, visitor);,
    Locatable.TestThat AS MUTABLE item -> aST__walk_children_TestThat_mut(&item, &descend_functions, visitor);,
    Locatable.AssertRaises AS MUTABLE item -> aST__walk_children_AssertRaises_mut(&item, &descend_functions, visitor);,
    Locatable.BenchmarkStmt AS MUTABLE item -> aST__walk_children_BenchmarkStmt_mut(&item, &descend_functions, visitor);,
    Locatable.SmashStmt AS MUTABLE item -> aST__walk_children_SmashStmt_mut(&item, &descend_functions, visitor);,
    Locatable.ProfileStmt AS MUTABLE item -> aST__walk_children_ProfileStmt_mut(&item, &descend_functions, visitor);,
    Locatable.FieldCleanup AS MUTABLE item -> aST__walk_children_FieldCleanup_mut(&item, &descend_functions, visitor);
  END
END
PUB FN aST__each_locatable_list_mut(MUTABLE items: []Locatable, MUTABLE descend_functions: Bool, visitor: FN(MUTABLE Locatable) -> Void) RETURNS Void EFFECTS REENTRANT ->
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < items.length() DO
    MUTABLE child: Locatable = COPY UNWRAP (items[rtoc_idx]);
    aST__each_locatable_mut(&child, &descend_functions, visitor);
    items[rtoc_idx] = COPY child;
    rtoc_idx = rtoc_idx + 1;
  END
END
PUB FN aST__wrapped_children(expr: Locatable) RETURNS []Locatable ->
  MUTABLE children: []Locatable = List[];
  IF expr IS_A StructLit AS struct_lit THEN
    children = children + struct_lit.fields.values();
  ELSE_IF expr IS_A UnionVariantLit AS union_variant_lit THEN
    children = children + union_variant_lit.fields.values();
  ELSE_IF expr IS_A ListLit AS list_lit THEN
    children = children + list_lit.items;
  ELSE_IF expr IS_A Cast AS cast_node THEN
    &children.append(COPY cast_node.value);
  ELSE_IF expr IS_A MoveNode AS move_node THEN
    &children.append(COPY move_node.value);
  ELSE_IF expr IS_A CopyNode AS copy_node THEN
    &children.append(COPY copy_node.value);
  ELSE_IF expr IS_A KeepNode AS keep_node THEN
    &children.append(COPY keep_node.value);
  ELSE_IF expr IS_A ShareNode AS share_node THEN
    &children.append(COPY share_node.value);
  ELSE_IF expr IS_A LinkNode AS link_node THEN
    &children.append(COPY link_node.value);
  ELSE_IF expr IS_A ResolveNode AS resolve_node THEN
    &children.append(COPY resolve_node.value);
  ELSE_IF expr IS_A MutableBorrow AS mutable_borrow THEN
    &children.append(COPY mutable_borrow.target);
  ELSE_IF expr IS_A FreezeNode AS freeze_node THEN
    &children.append(COPY freeze_node.value);
  ELSE_IF expr IS_A CapabilityWrap AS capability_wrap THEN
    &children.append(COPY capability_wrap.value);
  END
  RETURN children;
END
PUB FN aST__expression_children(node: Locatable, skip_copy: Bool = FALSE) RETURNS []Locatable ->
  MUTABLE children: []Locatable = List[];
  IF node IS_A CopyNode AS copy_node THEN
    &children.append(COPY copy_node.value);
  ELSE_IF node IS_A KeepNode AS keep_node THEN
    &children.append(COPY keep_node.value);
  ELSE_IF node IS_A FreezeNode AS freeze_node THEN
    &children.append(COPY freeze_node.value);
  ELSE_IF node IS_A TenseNavigation AS tense_navigation THEN
    &children.append(COPY tense_navigation.target);
  ELSE_IF node IS_A MoveNode AS move_node THEN
    &children.append(COPY move_node.value);
  ELSE_IF node IS_A ShareNode AS share_node THEN
    &children.append(COPY share_node.value);
  ELSE_IF node IS_A CapabilityWrap AS capability_wrap THEN
    &children.append(COPY capability_wrap.value);
  ELSE_IF node IS_A Cast AS cast_node THEN
    &children.append(COPY cast_node.value);
  ELSE_IF node IS_A MutableBorrow AS mutable_borrow THEN
    &children.append(COPY mutable_borrow.target);
  ELSE_IF node IS_A ReturnNode AS return_node THEN
    IF return_node.value EXISTS AS return_value THEN
      &children.append(COPY return_value);
    END
  ELSE_IF node IS_A Assignment AS assignment THEN
    &children.append(COPY assignment.value);
  ELSE_IF node IS_A VarDecl AS var_decl THEN
    &children.append(COPY var_decl.value);
  ELSE_IF node IS_A BindExpr AS bind_expr THEN
    &children.append(COPY bind_expr.value);
  ELSE_IF node IS_A DestructuringAssignment AS destructuring_assignment THEN
    &children.append(COPY destructuring_assignment.value);
  ELSE_IF node IS_A BinaryOp AS binary_op THEN
    &children.append(COPY binary_op.left);
    &children.append(COPY binary_op.right);
  ELSE_IF node IS_A UnaryOp AS unary_op THEN
    &children.append(COPY unary_op.right);
  ELSE_IF node IS_A FuncCall AS func_call THEN
    children = children + func_call.args;
  ELSE_IF node IS_A StaticCall AS static_call THEN
    children = children + static_call.args;
  ELSE_IF node IS_A MethodCall AS method_call THEN
    &children.append(COPY method_call.object);
    children = children + method_call.args;
  ELSE_IF node IS_A GetField AS get_field THEN
    &children.append(COPY get_field.target);
  ELSE_IF node IS_A GetIndex AS get_index THEN
    &children.append(COPY get_index.target);
    &children.append(COPY get_index.index);
  ELSE_IF node IS_A StructLit AS struct_lit THEN
    children = children + struct_lit.fields.values();
  ELSE_IF node IS_A UnionVariantLit AS union_variant_lit THEN
    children = children + union_variant_lit.fields.values();
  ELSE_IF node IS_A ListLit AS list_lit THEN
    children = children + list_lit.items;
  ELSE_IF node IS_A Assert AS assert_node THEN
    &children.append(COPY assert_node.condition);
  END
  RETURN children;
END
PUB FN aST__each_child_node(node: Locatable, visitor: FN(Locatable) -> Void) RETURNS Void EFFECTS REENTRANT ->
  FOR rtoc_walk_child IN rtocChildrenLocatable(node) DO
    visitor(rtoc_walk_child);
  END
END
