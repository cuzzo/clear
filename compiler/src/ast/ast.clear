    Locatable.DestructureTarget AS item -> RETURN COPY item.name;,
    Locatable.BindExpr AS item -> RETURN COPY item.name;,
    Locatable.Identifier AS item -> RETURN COPY item.name;,
    Locatable.StructLit AS item -> RETURN COPY item.name;,
    Locatable.FuncCall AS item -> RETURN CAST(item.name AS String);,
    Locatable.MethodCall AS item -> RETURN COPY item.name;,
    Locatable.ExternFnDecl AS item -> RETURN COPY item.name;,
    Locatable.ExternStructDecl AS item -> RETURN COPY item.name;,
    Locatable.EnumDef AS item -> RETURN COPY item.name;,
    Locatable.UnionDef AS item -> RETURN COPY item.name;,
    Locatable.TestBlock AS item -> RETURN COPY item.name;,
    Locatable.LetBinding AS item -> RETURN COPY item.name;,
    Locatable.Drop AS item -> RETURN COPY item.name;,
    Locatable.SuppressCleanup AS item -> RETURN COPY item.name;,
    Locatable.ReassignCleanup AS item -> RETURN COPY item.name;
  END
  RETURN NIL;
END
