  RETURN COPY self.module_const;
END
FN castPatternFieldValueToLocatable(value: PatternFieldValue) RETURNS ?Locatable ->
  PARTIAL MATCH value START
    PatternFieldValue.Program AS item -> RETURN Locatable{ Program: COPY item };,
    PatternFieldValue.RequireNode AS item -> RETURN Locatable{ RequireNode: COPY item };,
    PatternFieldValue.ProtocolRequirement AS item -> RETURN Locatable{ ProtocolRequirement: COPY item };,
    PatternFieldValue.ProtocolDef AS item -> RETURN Locatable{ ProtocolDef: COPY item };,
    PatternFieldValue.FunctionDef AS item -> RETURN Locatable{ FunctionDef: COPY item };,
    PatternFieldValue.ImplementationDef AS item -> RETURN Locatable{ ImplementationDef: COPY item };,
    PatternFieldValue.ConformanceDef AS item -> RETURN Locatable{ ConformanceDef: COPY item };,
    PatternFieldValue.StructDef AS item -> RETURN Locatable{ StructDef: COPY item };,
