PUB FN patternField__wildcard?(self: PatternField) RETURNS Bool ->
  PARTIAL MATCH self.value START
    PatternFieldValue.SymbolValue AS rtoc_sentinel -> RETURN (rtoc_sentinel == :wildcard);,
    DEFAULT -> RETURN FALSE;
  END
  RETURN FALSE;
END
PUB FN patternField__bind?(self: PatternField) RETURNS Bool ->
  PARTIAL MATCH self.value START
    PatternFieldValue.SymbolValue AS rtoc_sentinel -> RETURN (rtoc_sentinel == :bind);,
    DEFAULT -> RETURN FALSE;
  END
  RETURN FALSE;
END
# Ruby: the value when it is an AST node, NIL for the :wildcard / :bind sentinels.
PUB FN patternField__expr(self: PatternField) RETURNS ?Locatable ->
  RETURN castPatternFieldValueToLocatable(self.value);
END
PUB FN getField__wildcard?(self: GetField) RETURNS Bool ->
  RETURN (self.field == "*");
END
PUB FN functionDef__implicit_return_type?(self: FunctionDef) RETURNS Bool ->
  RETURN (self.return_type == NIL);
END
PUB FN functionDef__declared_return_type(self: FunctionDef) RETURNS ?Type ->
  RETURN COPY self.return_type;
END
PUB FN functionDef__lowering_return_type(self: FunctionDef) RETURNS !Type ->
  IF self.return_type EXISTS AS rtoc_declared THEN
    RETURN COPY rtoc_declared;
  END
  RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :Void }));
END
PUB FN functionDef__uses_runtime?(self: FunctionDef) RETURNS Bool ->
  RETURN ((((self.uses_frame == TRUE) OR (self.uses_heap == TRUE)) OR (self.uses_alloc == TRUE)) OR (self.uses_rt == TRUE));
END
PUB FN functionDef__reentrance_guard_required?(self: FunctionDef) RETURNS Bool ->
  RETURN ((self.reentrance_kind == :reentrant_not_logical) OR (self.reentrance_kind == :reentrant_max_depth));
END
PUB FN functionDef__declared_plain_reentrant?(self: FunctionDef) RETURNS Bool ->
  RETURN ((self.reentrance_kind OR_ELSE self.effects_decl) == :reentrant);
END
PUB FN capabilityWrap__indirect?(self: CapabilityWrap) RETURNS Bool ->
  RETURN (self.layout == :indirect);
END
PUB FN capabilityWrap__atomic?(self: CapabilityWrap) RETURNS Bool ->
  RETURN symbolEntry__atomic_sync?(self.sync);
END
PUB FN capabilityWrap__atomic_ptr?(self: CapabilityWrap) RETURNS Bool ->
  RETURN (capabilityWrap__atomic?(self) AND capabilityWrap__indirect?(self));
END
PUB FN literal__true_boolean?(self: Literal) RETURNS Bool ->
  IF self.value EXISTS AS rtoc_value THEN
    IF rtoc_value IS_A Bool AS rtoc_bool THEN
      RETURN ((self.type == :BOOLEAN) AND rtoc_bool);
    END
  END
  RETURN FALSE;
END
PUB FN capability__alias_mutable(self: Capability) RETURNS Bool ->
  RETURN COPY self.alias_mutable;
END
PUB FN capability__as_token(self: Capability) RETURNS ?Token ->
  RETURN COPY self.as_token;
END
PUB FN capability__capability(self: Capability) RETURNS ?String@symbol ->
  RETURN COPY self.capability;
END
PUB FN capability__old_scope(self: Capability) RETURNS ?PassStateValue ->
  RETURN COPY self.old_scope;
END
PUB FN capability__resolved_type(self: Capability) RETURNS Type ->
  RETURN COPY self.resolved_type;
END
PUB FN capability__var_node(self: Capability) RETURNS Locatable@boxed ->
  RETURN COPY self.var_node;
END
PUB FN capability__view_token(self: Capability) RETURNS ?Token ->
  RETURN COPY self.view_token;
END

# Ruby: `body.is_a?(Array) ? body : [body]` -- a lambda body is either a list of
# statements or a single expression, and callers want a list either way.
PUB FN aST__lambda_body_nodes(body: LambdaBody) RETURNS ![]Locatable EFFECTS REENTRANT ->
  IF body IS_A []Locatable AS rtoc_stmts THEN
    RETURN COPY rtoc_stmts;
  END
  IF body IS_A []Node AS rtoc_nodes THEN
    MUTABLE out: []Locatable = List[];
    FOR rtoc_node IN rtoc_nodes DO
      IF castNodeToLocatable(rtoc_node) EXISTS AS rtoc_one THEN
        &out.append(COPY rtoc_one);
      END
    END
    RETURN out;
  END
  RETURN [COPY castLambdaBodyToLocatable(body)];
END
PUB FN aST__recursion_yield_needed?(fn_node: FunctionDef) RETURNS Bool ->
  IF fn_node.tight_reentrance THEN
    RETURN FALSE;
  END
  RETURN (((fn_node.reentrance_kind == :reentrant) OR (fn_node.reentrance_kind == :reentrant_tail_call)) OR (fn_node.reentrance_kind == :reentrant_max_depth));
END

PUB FN aST__pipeline_fusible_stage?(node: Locatable) RETURNS Bool ->
  PARTIAL MATCH node START
    Locatable.WhereOp AS item -> RETURN TRUE;,
    Locatable.SelectOp AS item -> RETURN TRUE;,
    Locatable.TapOp AS item -> RETURN TRUE;,
    Locatable.TakeWhileOp AS item -> RETURN TRUE;,
    Locatable.LimitOp AS item -> RETURN TRUE;,
    Locatable.SkipOp AS item -> RETURN TRUE;,
    DEFAULT -> RETURN FALSE;
  END
  RETURN FALSE;
END
PUB FN aST__pipeline_complex_op?(node: Locatable) RETURNS Bool ->
  PARTIAL MATCH node START
    Locatable.SelectOp AS item -> RETURN TRUE;,
    Locatable.WhereOp AS item -> RETURN TRUE;,
    Locatable.IndexOp AS item -> RETURN TRUE;,
    Locatable.ReduceOp AS item -> RETURN TRUE;,
    Locatable.OrderByOp AS item -> RETURN TRUE;,
    Locatable.LimitOp AS item -> RETURN TRUE;,
    Locatable.UnnestOp AS item -> RETURN TRUE;,
    Locatable.DistinctOp AS item -> RETURN TRUE;,
    Locatable.EachOp AS item -> RETURN TRUE;,
    Locatable.FindOp AS item -> RETURN TRUE;,
    Locatable.AnyOp AS item -> RETURN TRUE;,
    Locatable.AllOp AS item -> RETURN TRUE;,
    Locatable.CountOp AS item -> RETURN TRUE;,
    Locatable.SumOp AS item -> RETURN TRUE;,
    Locatable.AverageOp AS item -> RETURN TRUE;,
    Locatable.MinOp AS item -> RETURN TRUE;,
    Locatable.MaxOp AS item -> RETURN TRUE;,
    Locatable.TakeWhileOp AS item -> RETURN TRUE;,
    Locatable.WindowOp AS item -> RETURN TRUE;,
    Locatable.BatchWindowOp AS item -> RETURN TRUE;,
    Locatable.JoinOp AS item -> RETURN TRUE;,
    Locatable.TapOp AS item -> RETURN TRUE;,
    Locatable.SkipOp AS item -> RETURN TRUE;,
    Locatable.ShardOp AS item -> RETURN TRUE;,
    Locatable.ConcurrentOp AS item -> RETURN TRUE;,
    DEFAULT -> RETURN FALSE;
  END
  RETURN FALSE;
END
PUB FN aST__pipeline_list_terminal?(node: Locatable) RETURNS Bool ->
  PARTIAL MATCH node START
    Locatable.UnnestOp AS item -> RETURN TRUE;,
    Locatable.DistinctOp AS item -> RETURN TRUE;,
    DEFAULT -> RETURN FALSE;
  END
  RETURN FALSE;
END
PUB FN aST__pipeline_stream_value_op?(node: Locatable) RETURNS Bool ->
  RETURN (aST__pipeline_select_filter_op?(node) OR (node IS_A EachOp));
END

PUB FN aST__pipeline_terminal_fold?(node: Locatable) RETURNS Bool ->
  PARTIAL MATCH node START
    Locatable.SumOp AS item -> RETURN TRUE;,
    Locatable.AverageOp AS item -> RETURN TRUE;,
    Locatable.CountOp AS item -> RETURN TRUE;,
    Locatable.ReduceOp AS item -> RETURN TRUE;,
    Locatable.MinOp AS item -> RETURN TRUE;,
    Locatable.MaxOp AS item -> RETURN TRUE;,
    Locatable.AnyOp AS item -> RETURN TRUE;,
    Locatable.AllOp AS item -> RETURN TRUE;,
    Locatable.FindOp AS item -> RETURN TRUE;,
    DEFAULT -> RETURN FALSE;
  END
  RETURN FALSE;
END
PUB FN aST__call_like_boundary?(node: Locatable) RETURNS Bool ->
  PARTIAL MATCH node START
    Locatable.FunctionDef AS item -> RETURN TRUE;,
    Locatable.LambdaLit AS item -> RETURN TRUE;,
    Locatable.BgBlock AS item -> RETURN TRUE;,
    Locatable.BgStreamBlock AS item -> RETURN TRUE;,
    Locatable.WithBlock AS item -> RETURN TRUE;,
    Locatable.DoBlock AS item -> RETURN TRUE;,
    DEFAULT -> RETURN FALSE;
  END
  RETURN FALSE;
END
PUB FN aST__recovery_wrapper?(node: Locatable) RETURNS Bool ->
  IF node IS_A UnaryOp AS rtoc_unary THEN
    RETURN (rtoc_unary.op == :TRY);
  END
  RETURN ((node IS_A OptionalUnwrap) OR (node IS_A TenseNavigation));
END
# Ruby: the value a recovery wrapper wraps, or the node itself when it is not one.
PUB FN aST__recovery_payload(node: Locatable) RETURNS Locatable EFFECTS REENTRANT ->
  IF node IS_A UnaryOp AS rtoc_unary THEN
    IF (rtoc_unary.op == :TRY) THEN
      RETURN COPY rtoc_unary.right;
    END
  END
  IF node IS_A OptionalUnwrap AS rtoc_unwrap THEN
    RETURN COPY rtoc_unwrap.target;
  END
  IF node IS_A TenseNavigation AS rtoc_nav THEN
    RETURN COPY rtoc_nav.target;
  END
  RETURN COPY node;
END

PUB FN functionDef__recursive_reentrance_declared?(self: FunctionDef) RETURNS Bool ->
  RETURN (((self.reentrance_kind == :reentrant) OR (self.reentrance_kind == :reentrant_thunk)) OR (self.reentrance_kind == :reentrant_tail_call));
END
PUB FN functionDef__runtime_stack_required?(self: FunctionDef, recursion_yield: Bool, declared_runtime_return: Bool) RETURNS Bool ->
  RETURN (((((functionDef__uses_runtime?(self) OR (self.fn_value_ref == TRUE)) OR (self.thunk_plan != NIL)) OR (self.mutual_thunk_plan != NIL)) OR recursion_yield) OR declared_runtime_return);
END
PUB FN listLit__constructor_collection(self: ListLit) RETURNS ?String@symbol ->
  IF self.constructor_options EXISTS AS rtoc_options THEN
    RETURN rtoc_options.collection;
  END
  RETURN NIL;
END
PUB FN listLit__constructor_soa?(self: ListLit) RETURNS Bool ->
  IF self.constructor_options EXISTS AS rtoc_options THEN
    RETURN (rtoc_options.soa == TRUE);
  END
  RETURN FALSE;
END
PUB FN listLit__constructor_shard_count(self: ListLit) RETURNS ?Int64 ->
  IF self.constructor_options EXISTS AS rtoc_options THEN
    RETURN rtoc_options.shard_count;
  END
  RETURN NIL;
END
# Ruby: `def name; target.name end` -- a GetField's name is its TARGET's name,
# not the field it reads.
PUB FN getField__name(self: GetField) RETURNS String ->
  RETURN (locatable__name(self.target) OR_ELSE "");
END

# Ruby yields every BG block reachable through an expression WITHOUT descending
# into a BG body -- the boundary is the point of the walk.
PUB FN aST__expr_each_bg_block_shallow(expr: ?Locatable, blk: FN(BgNode) -> Void) RETURNS Void EFFECTS REENTRANT ->
  IF expr EXISTS AS rtoc_expr THEN
    IF rtoc_expr IS_A BgBlock AS rtoc_bg THEN
      blk(BgNode{ BgBlock: COPY rtoc_bg });
      RETURN;
    END
    IF rtoc_expr IS_A BgStreamBlock AS rtoc_bg_stream THEN
      blk(BgNode{ BgStreamBlock: COPY rtoc_bg_stream });
      RETURN;
    END
    IF rtoc_expr IS_A FuncCall AS rtoc_call THEN
      FOR rtoc_arg IN rtoc_call.args DO
        aST__expr_each_bg_block_shallow(rtoc_arg, blk);
      END
      RETURN;
    END
    IF rtoc_expr IS_A MethodCall AS rtoc_method THEN
      aST__expr_each_bg_block_shallow(rtoc_method.object, blk);
      FOR rtoc_arg IN rtoc_method.args DO
        aST__expr_each_bg_block_shallow(rtoc_arg, blk);
      END
      RETURN;
    END
    IF rtoc_expr IS_A StructLit AS rtoc_struct THEN
      FOR rtoc_key IN rtoc_struct.fields.keys() DO
        aST__expr_each_bg_block_shallow(rtoc_struct.fields[rtoc_key], blk);
      END
      RETURN;
    END
    IF rtoc_expr IS_A UnionVariantLit AS rtoc_variant THEN
      FOR rtoc_key IN rtoc_variant.fields.keys() DO
        aST__expr_each_bg_block_shallow(rtoc_variant.fields[rtoc_key], blk);
      END
      RETURN;
    END
    IF rtoc_expr IS_A ListLit AS rtoc_list THEN
      FOR rtoc_item IN rtoc_list.items DO
        aST__expr_each_bg_block_shallow(rtoc_item, blk);
      END
      RETURN;
    END
    IF rtoc_expr IS_A HashLit AS rtoc_hash THEN
      FOR rtoc_pair IN rtoc_hash.pairs DO
        aST__expr_each_bg_block_shallow(rtoc_pair._0, blk);
        aST__expr_each_bg_block_shallow(rtoc_pair._1, blk);
      END
      RETURN;
    END
    IF rtoc_expr IS_A BinaryOp AS rtoc_binary THEN
      aST__expr_each_bg_block_shallow(rtoc_binary.left, blk);
      aST__expr_each_bg_block_shallow(rtoc_binary.right, blk);
      RETURN;
    END
  END
END
PUB FN aST__each_bg_block_in_stmt(stmt: Locatable, blk: FN(BgNode) -> Void) RETURNS Void EFFECTS REENTRANT ->
  IF stmt IS_A BgBlock AS rtoc_bg THEN
    blk(BgNode{ BgBlock: COPY rtoc_bg });
    RETURN;
  END
  IF stmt IS_A BgStreamBlock AS rtoc_bg_stream THEN
    blk(BgNode{ BgStreamBlock: COPY rtoc_bg_stream });
    RETURN;
  END
  IF stmt IS_A VarDecl AS rtoc_var_decl THEN
    aST__expr_each_bg_block_shallow(rtoc_var_decl.value, blk);
    RETURN;
  END
  IF stmt IS_A BindExpr AS rtoc_bind THEN
    aST__expr_each_bg_block_shallow(rtoc_bind.value, blk);
    RETURN;
  END
  IF stmt IS_A Assignment AS rtoc_assign THEN
    aST__expr_each_bg_block_shallow(rtoc_assign.value, blk);
    RETURN;
  END
  IF stmt IS_A DestructuringAssignment AS rtoc_destructure THEN
    aST__expr_each_bg_block_shallow(rtoc_destructure.value, blk);
    RETURN;
  END
  IF stmt IS_A ReturnNode AS rtoc_return THEN
    aST__expr_each_bg_block_shallow(rtoc_return.value, blk);
    RETURN;
  END
  IF stmt IS_A FuncCall AS rtoc_call THEN
    FOR rtoc_arg IN rtoc_call.args DO
      aST__expr_each_bg_block_shallow(rtoc_arg, blk);
    END
    RETURN;
  END
  IF stmt IS_A MethodCall AS rtoc_method THEN
    aST__expr_each_bg_block_shallow(rtoc_method.object, blk);
    FOR rtoc_arg IN rtoc_method.args DO
      aST__expr_each_bg_block_shallow(rtoc_arg, blk);
    END
    RETURN;
  END
END

PUB FN capabilityWrap__capability?(self: CapabilityWrap) RETURNS Bool ->
  RETURN (((self.ownership != NIL) OR (self.sync != NIL)) OR (self.layout != NIL));
END
PUB FN pipelineShardContext__with_frame_allocations(self: PipelineShardContext, key_allocates_frame: Bool, body_allocates_frame: Bool) RETURNS PipelineShardContext ->
  RETURN PipelineShardContext{ map_var: COPY self.map_var, key_expr: COPY self.key_expr, shard_count: self.shard_count, auto_detected: self.auto_detected, key_allocates_frame: key_allocates_frame, body_allocates_frame: body_allocates_frame };
END
PUB FN capabilityWrap__multiowned?(self: CapabilityWrap) RETURNS Bool ->
  RETURN (self.ownership == :multiowned);
END
PUB FN capabilityWrap__locked_sync?(self: CapabilityWrap) RETURNS Bool ->
  RETURN ((self.sync == :locked) OR (self.sync == :write_locked));
END
PUB FN aST__statement_result_void?(node: Locatable) RETURNS Bool ->
  PARTIAL MATCH node START
    Locatable.ReturnNode AS item -> RETURN TRUE;,
    Locatable.VarDecl AS item -> RETURN TRUE;,
    Locatable.BindExpr AS item -> RETURN TRUE;,
    Locatable.Assignment AS item -> RETURN TRUE;,
    Locatable.DestructuringAssignment AS item -> RETURN TRUE;,
    Locatable.WhileLoop AS item -> RETURN TRUE;,
    Locatable.ForRange AS item -> RETURN TRUE;,
    Locatable.ForEach AS item -> RETURN TRUE;,
    Locatable.MatchStatement AS item -> RETURN TRUE;,
    Locatable.Assert AS item -> RETURN TRUE;,
    Locatable.Raise AS item -> RETURN TRUE;,
    Locatable.WithBlock AS item -> RETURN TRUE;,
    Locatable.BgBlock AS item -> RETURN TRUE;,
    Locatable.DoBlock AS item -> RETURN TRUE;,
    Locatable.PassStmt AS item -> RETURN TRUE;,
    Locatable.DieNode AS item -> RETURN TRUE;,
    Locatable.ThrowNode AS item -> RETURN TRUE;,
    DEFAULT -> RETURN FALSE;
  END
  RETURN FALSE;
END
PUB FN aST__collection_method_call?(node: Locatable) RETURNS Bool ->
  IF node IS_A MethodCall AS rtoc_call THEN
    RETURN (((rtoc_call.pool_method != NIL) OR (rtoc_call.set_method != NIL)) OR (rtoc_call.map_method != NIL));
  END
  RETURN FALSE;
END
PUB FN selectOp__set_capture_analysis(MUTABLE self: SelectOp, value: ?CaptureAnalysis) RETURNS Void ->
  self.capture_analysis = value;
  RETURN;
END

