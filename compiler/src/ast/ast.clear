PUB FN listLit__collection_constructor?(self: ListLit) RETURNS Bool ->
  RETURN (self.constructor_options != NIL);
END
# Ruby: an AUTO-typed declaration whose value is an empty, non-constructor
# collection literal -- the shape inference has nothing to work from.
PUB FN aST__empty_auto_collection_literal_decl?(node: Locatable) RETURNS Bool ->
  MUTABLE declared: ?Type = NIL;
  MUTABLE value: ?Locatable = NIL;
  IF node IS_A VarDecl AS rtoc_var_decl THEN
    declared = COPY rtoc_var_decl.type;
    value = COPY rtoc_var_decl.value;
  END
  IF node IS_A BindExpr AS rtoc_bind THEN
    declared = COPY rtoc_bind.type;
    value = COPY rtoc_bind.value;
  END
  MUTABLE is_auto: Bool = FALSE;
  IF declared EXISTS AS rtoc_declared THEN
    is_auto = type__auto?(rtoc_declared);
  END
  IF !(is_auto) THEN
    RETURN FALSE;
  END
  IF value EXISTS AS rtoc_value THEN
    IF (locatable__type_object(rtoc_value) == NIL) THEN
      RETURN FALSE;
    END
    IF rtoc_value IS_A ListLit AS rtoc_list THEN
      RETURN ((rtoc_list.items.length() == 0) AND !(listLit__collection_constructor?(rtoc_list)));
    END
    IF rtoc_value IS_A HashLit AS rtoc_hash THEN
      RETURN (rtoc_hash.pairs.length() == 0);
    END
  END
  RETURN FALSE;
END
PUB FN aST__ownership_wrapper?(node: Locatable) RETURNS Bool ->
  PARTIAL MATCH node START
    Locatable.MoveNode AS item -> RETURN TRUE;,
    Locatable.CopyNode AS item -> RETURN TRUE;,
    Locatable.KeepNode AS item -> RETURN TRUE;,
    Locatable.ShareNode AS item -> RETURN TRUE;,
    Locatable.FreezeNode AS item -> RETURN TRUE;,
    Locatable.CapabilityWrap AS item -> RETURN TRUE;,
    DEFAULT -> RETURN FALSE;
  END
  RETURN FALSE;
END
PUB FN aST__ownership_transfer_stmt?(node: Locatable) RETURNS Bool ->
  PARTIAL MATCH node START
    Locatable.WhileLoop AS item -> RETURN TRUE;,
    Locatable.WhileBindLoop AS item -> RETURN TRUE;,
    Locatable.ForRange AS item -> RETURN TRUE;,
    Locatable.ForEach AS item -> RETURN TRUE;,
    Locatable.IfStatement AS item -> RETURN TRUE;,
    Locatable.MatchStatement AS item -> RETURN TRUE;,
    Locatable.WithBlock AS item -> RETURN TRUE;,
    Locatable.DoBlock AS item -> RETURN TRUE;,
    DEFAULT -> RETURN FALSE;
  END
  RETURN FALSE;
END
PUB FN aST__declaration_with_identifier_value?(node: Locatable) RETURNS Bool ->
  IF node IS_A VarDecl AS rtoc_var_decl THEN
    RETURN (rtoc_var_decl.value IS_A Identifier);
  END
  IF node IS_A BindExpr AS rtoc_bind THEN
    IF (rtoc_bind.mode != :decl) THEN
      RETURN FALSE;
    END
    RETURN (rtoc_bind.value IS_A Identifier);
  END
  RETURN FALSE;
END
# Ruby: only AND / OR / OR_ELSE defer their right operand.
PUB FN binaryOp__lazy_fields(self: BinaryOp) RETURNS []String@symbol ->
  IF (((self.op == symbol("AND")) OR (self.op == symbol("OR"))) OR (self.op == symbol("OR_ELSE"))) THEN
    RETURN [:right];
  END
  RETURN CAST(List[] AS []String@symbol);
END
PUB FN capabilityWrap__local_storage_wrap?(self: CapabilityWrap) RETURNS Bool ->
  IF (self.ownership == :local) THEN
    RETURN TRUE;
  END
  RETURN (((self.layout == :indirect) AND (self.sync == NIL)) AND (self.ownership == NIL));
END
# Ruby: `walk_body` is `AST.each_locatable` over a statement list.
PUB FN aST__walk_body(body: []Locatable, visitor: FN(Locatable) -> Void) RETURNS Void EFFECTS REENTRANT ->
  MUTABLE descend: Bool = FALSE;
  aST__each_locatable_list(body, &descend, visitor);
END

# Ruby yields every CaptureAnalysis reachable from a body: BG blocks, DO-block
# branches, and CONCURRENT pipeline ops. One pass per function, replacing the
# per-source-type iteration the lowerings used to each do themselves.
PUB FN aST__expr_each_concurrent_capture(node: ?Locatable, blk: FN(CaptureAnalysis) -> Void) RETURNS Void EFFECTS REENTRANT ->
  IF node EXISTS AS rtoc_node THEN
    IF rtoc_node IS_A ConcurrentOp AS rtoc_conc THEN
      IF rtoc_conc.capture_analysis EXISTS AS rtoc_analysis THEN
        blk(rtoc_analysis);
      END
      RETURN;
    END
    IF rtoc_node IS_A BinaryOp AS rtoc_binary THEN
      aST__expr_each_concurrent_capture(rtoc_binary.left, blk);
      aST__expr_each_concurrent_capture(rtoc_binary.right, blk);
      RETURN;
    END
    IF rtoc_node IS_A VarDecl AS rtoc_var_decl THEN
      aST__expr_each_concurrent_capture(rtoc_var_decl.value, blk);
      RETURN;
    END
    IF rtoc_node IS_A BindExpr AS rtoc_bind THEN
      aST__expr_each_concurrent_capture(rtoc_bind.value, blk);
      RETURN;
    END
    IF rtoc_node IS_A Assignment AS rtoc_assign THEN
      aST__expr_each_concurrent_capture(rtoc_assign.value, blk);
      RETURN;
    END
    IF rtoc_node IS_A DestructuringAssignment AS rtoc_destructure THEN
      aST__expr_each_concurrent_capture(rtoc_destructure.value, blk);
      RETURN;
    END
    IF rtoc_node IS_A ReturnNode AS rtoc_return THEN
      aST__expr_each_concurrent_capture(rtoc_return.value, blk);
      RETURN;
    END
    IF rtoc_node IS_A FuncCall AS rtoc_call THEN
      FOR rtoc_arg IN rtoc_call.args DO
        aST__expr_each_concurrent_capture(rtoc_arg, blk);
      END
      RETURN;
    END
    IF rtoc_node IS_A MethodCall AS rtoc_method THEN
      aST__expr_each_concurrent_capture(rtoc_method.object, blk);
      FOR rtoc_arg IN rtoc_method.args DO
        aST__expr_each_concurrent_capture(rtoc_arg, blk);
      END
      RETURN;
    END
  END
END
PUB FN aST__each_capture_analysis(body: []Locatable, blk: FN(CaptureAnalysis) -> Void) RETURNS Void EFFECTS REENTRANT ->
  FOR rtoc_stmt IN body DO
    aST__each_bg_block_in_stmt(rtoc_stmt, %(bg: BgNode) USE(blk) -> {
      IF bg IS_A BgBlock AS rtoc_bg THEN
        IF rtoc_bg.capture_analysis EXISTS AS rtoc_bg_analysis THEN
          blk(rtoc_bg_analysis);
        END
      END
      IF bg IS_A BgStreamBlock AS rtoc_bg_stream THEN
        IF rtoc_bg_stream.capture_analysis EXISTS AS rtoc_stream_analysis THEN
          blk(rtoc_stream_analysis);
        END
      END
      rubyToClearVoid__ast()
    });
  END
  MUTABLE descend: Bool = FALSE;
  aST__each_locatable_list(body, &descend, %(node: Locatable) USE(blk) -> {
    IF node IS_A DoBlock AS rtoc_do THEN
      FOR rtoc_branch IN rtoc_do.branches DO
        IF rtoc_branch.capture_analysis EXISTS AS rtoc_branch_analysis THEN
          blk(rtoc_branch_analysis);
        END
      END
    END
    aST__expr_each_concurrent_capture(node, blk);
    rubyToClearVoid__ast()
  });
END
FN rubyToClearVoid__ast() RETURNS Void ->
  RETURN;
END
# Ruby: a requirement's name and type as a plain Param -- no default, not
# mutable, not TAKES.
PUB FN unionMethodParamRequirement__to_param(self: UnionMethodParamRequirement) RETURNS Param ->
  RETURN Param{ name: COPY self.name, type: COPY self.type, default: NIL, mutable: FALSE, takes: FALSE, comptime: NIL, name_token: NIL, required: TRUE, sync: NIL, symbol: NIL, carrier_contract: NIL };
END

# Ruby asks `respond_to?(:args)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN node__args(value: Node) RETURNS ?[]Locatable ->
  PARTIAL MATCH value START
    Node.FuncCall AS item -> RETURN COPY item.args;,
    Node.MethodCall AS item -> RETURN COPY item.args;,
    Node.StaticCall AS item -> RETURN COPY item.args;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END

