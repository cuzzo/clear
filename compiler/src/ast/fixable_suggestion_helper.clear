REQUIRE "pkg:rtoc_6173742f747970652e636c656172"
REQUIRE "pkg:rtoc_6173742f736f757263655f6572726f722e636c656172"
REQUIRE "pkg:rtoc_6173742f646961676e6f737469635f72656769737472792e636c656172"
REQUIRE "pkg:rtoc_6173742f66697861626c655f6572726f722e636c656172"
# Ruby module FixableSuggestionHelper
PUB UNION NameCandidate { StringValue: String, SymbolValue: String@symbol }
PUB FN castStringListToNameCandidateList(values: []String) RETURNS []NameCandidate ->
  MUTABLE out: []NameCandidate = List[];
  FOR value IN values DO
    &out.append(NameCandidate{ StringValue: COPY value });
  END
  RETURN out;
END
PUB FN nameCandidate__text(value: NameCandidate) RETURNS String ->
  IF value IS_A String@symbol AS string_symbol THEN
    RETURN COPY "${string_symbol}";
  ELSE_IF value IS_A String AS text THEN
    RETURN COPY text;
  END
  RETURN COPY "";
END
# End Ruby module FixableSuggestionHelper

# Ruby interpolates this value directly; each variant renders the
# way Ruby renders it.
PUB FN nameCandidate__to_s(value: NameCandidate) RETURNS String ->
  PARTIAL MATCH value START
    NameCandidate.StringValue AS item -> RETURN COPY item;,
    NameCandidate.SymbolValue AS item -> RETURN CAST(item AS String);,
  END
  RETURN "";
END

# Ruby hands the node straight to a callee that wants one specific shape.
# The union either holds that variant or it does not.
PUB FN castNameCandidateToString(value: NameCandidate) RETURNS ?String EFFECTS REENTRANT ->
  IF value IS_A String AS item THEN
    RETURN item;
  END
  RETURN NIL;
END
