PUB FN type__list_collection?(self: Type) RETURNS Bool ->
  RETURN (type__collection(self) == :list);
END
PUB FN type__set_collection?(self: Type) RETURNS Bool ->
  RETURN (type__collection(self) == :set);
END
PUB FN type__collection?(self: Type) RETURNS Bool ->
  RETURN (((type__map?(self) OR type__pool?(self)) OR type__list_collection?(self)) OR type__set_collection?(self));
END
PUB FN type__collection_value?(self: Type) RETURNS !Bool ->
  RETURN (type__collection?(self) OR TRY (type__non_string_array?(self)));
END
PUB FN type__heap_ptr?(self: Type) RETURNS !Bool EFFECTS REENTRANT ->
  IF type__optional?(self) THEN
    RETURN TRY (type__heap_ptr?((CAST(TRY (type__wrapped_type(self)) AS Type))));
  END
  RETURN ((((TRY (type__string?(self)) OR type__indirect?(self)) OR TRY (type__tense_observable?(self))) OR type__collection?(self)) OR ((type__array?(self) AND !(type__fixed?(self)))));
END
PUB FN type__associative_collection?(self: Type) RETURNS Bool ->
  RETURN type__map?(self);
END
PUB FN type__linear_collection?(self: Type) RETURNS !Bool ->
  RETURN (((type__pool?(self) OR type__list_collection?(self)) OR type__set_collection?(self)) OR TRY (type__non_string_array?(self)));
END
PUB FN type__ownership_storage(self: Type) RETURNS ?String@symbol ->
  IF (type__shared?(self) OR type__multiowned?(self)) THEN
    RETURN type__ownership(self);
  END
  RETURN NIL;
END
PUB FN type__direct_indexable_collection?(self: Type) RETURNS !Bool ->
  RETURN (type__list_collection?(self) OR (((type__array?(self) AND !(TRY (type__string?(self)))) AND !(type__collection?(self)))));
END
PUB FN type__non_string_array?(self: Type) RETURNS !Bool ->
  RETURN (type__array?(self) AND !(TRY (type__string?(self))));
END
PUB FN type__indexed_container_borrow?(self: Type) RETURNS !Bool ->
  RETURN ((type__map?(self) OR type__pool?(self)) OR TRY (type__direct_indexable_collection?(self)));
END
PUB FN type__element_zig_type_or_anyopaque(self: Type) RETURNS !String ->
  MUTABLE elem: ?Type = TRY (type__element_type(self));
  IF elem EXISTS AS elem_value THEN
    RETURN TRY (type__zig_type(elem_value));
  ELSE
    RETURN "anyopaque";
  END
END
PUB FN type__key_zig_type(self: Type) RETURNS !String ->
  MUTABLE current_key_type = TRY (type__key_type(self));
  RETURN TRY (type__zig_type(current_key_type));
END
PUB FN type__fsm_foreach_descriptor(self: Type) RETURNS !?TypeFsmForEachDescriptor ->
  IF type__pool?(self) THEN
    RETURN TypeFsmForEachDescriptor{ kind: :pool_indexed, var_zig_type: COPY TRY (type__element_zig_type_or_anyopaque(self)), init_method: NIL, advance_method: NIL, deref: FALSE, slice_suffix: "" };
  ELSE_IF type__map?(self) THEN
    RETURN TypeFsmForEachDescriptor{ kind: :iterator, init_method: "keyIterator", advance_method: "next", deref: TRUE, var_zig_type: COPY TRY (type__key_zig_type(self)), slice_suffix: "" };
  ELSE_IF type__set_collection?(self) THEN
    RETURN TypeFsmForEachDescriptor{ kind: :iterator, init_method: "keyIterator", advance_method: "next", deref: TRUE, var_zig_type: COPY TRY (type__element_zig_type_or_anyopaque(self)), slice_suffix: "" };
  ELSE_IF (type__list_collection?(self) OR ((type__array?(self) AND type__dynamic?(self)))) THEN
    RETURN TypeFsmForEachDescriptor{ kind: :indexed_slice, slice_suffix: ".items", var_zig_type: COPY TRY (type__element_zig_type_or_anyopaque(self)), init_method: NIL, advance_method: NIL, deref: FALSE };
  ELSE_IF (type__array?(self) AND !(type__dynamic?(self))) THEN
    RETURN TypeFsmForEachDescriptor{ kind: :indexed_slice, slice_suffix: "", var_zig_type: COPY TRY (type__element_zig_type_or_anyopaque(self)), init_method: NIL, advance_method: NIL, deref: FALSE };
  ELSE
    RETURN NIL;
  END
END
PUB FN type__dispatch_key(self: Type) RETURNS !?String@symbol ->
  IF TRY (type__c_array_view?(self)) THEN
    RETURN NIL;
  END
  IF TRY (type__numeric_map?(self)) THEN
    RETURN :numeric_map;
  ELSE_IF type__map?(self) THEN
    RETURN :string_map;
  ELSE_IF type__pool?(self) THEN
    RETURN :pool;
  ELSE_IF type__set_collection?(self) THEN
    RETURN :set_collection;
  ELSE_IF type__list_collection?(self) THEN
    RETURN :list;
  ELSE_IF TRY (type__non_string_array?(self)) THEN
    RETURN :array;
  ELSE_IF (TRY (type__string?(self)) AND type__symbol?(self)) THEN
    RETURN :string_symbol;
  ELSE_IF (TRY (type__string?(self)) AND type__raw?(self)) THEN
    RETURN :string_raw;
  END
END
PUB FN type__needs_pointer_passing?(self: Type) RETURNS Bool ->
  RETURN (type__map?(self) OR type__pool?(self));
END
PUB FN type__needs_heap_backing?(self: Type) RETURNS !Bool ->
  RETURN ((type__sharded?(self) OR type__heap?(self)) OR TRY (type__tense_observable?(self)));
END
PUB FN type__heap_return_storage?(self: Type) RETURNS Bool ->
  RETURN (type__heap?(self) OR type__dynamic?(self));
END
PUB FN type__map_init_needs_alloc?(self: Type) RETURNS !Bool ->
  IF !(type__map?(self)) THEN
    RETURN FALSE;
  END
  IF TRY (type__numeric_map?(self)) THEN
    RETURN FALSE;
  END
  IF (type__sharded?(self) AND !(type__striped?(self))) THEN
    RETURN FALSE;
  END
  RETURN TRUE;
END
PUB FN type__captured_plain_string_map_needs_deinit?(self: Type) RETURNS !Bool ->
  RETURN (((((type__map?(self) AND !(TRY (type__numeric_map?(self)))) AND !(type__sharded?(self))) AND !(type__striped?(self))) AND !(TRY (type__any_rc?(self)))) AND !(type__any_sync?(self)));
END
PUB FN type__needs_escape_promotion?(self: Type) RETURNS !Bool ->
  IF type__sharded?(self) THEN
    RETURN FALSE;
  END
  RETURN (TRY (type__escape_class(self)) == :slice_managed);
END
PUB FN type__resource?(self: Type) RETURNS Bool ->
  IF type__node?(self) THEN
    RETURN FALSE;
  END
  IF (self.is_resource == TRUE) THEN
    RETURN TRUE;
  END
  RETURN type__resource_type_symbol?(type__resolved(self));
END
PUB STRUCT ResourceCloseResult {
  is_resource: Bool,
  close_plan: ?ResourceClosePlan
}
PUB FN type__schema_resolver(lookup_arg: ?FN(String@symbol) -> ?TypeSchemaLookupResult, lookup_block: ?FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS ?FN(String@symbol) -> ?TypeSchemaLookupResult ->
  IF !((lookup_arg == NIL)) THEN
    RETURN COPY lookup_arg;
  END
  IF lookup_block EXISTS AS lookup_block_value THEN
    RETURN COPY lookup_block_value;
  ELSE
    RETURN NIL;
  END
END
PUB FN type__resolve_resource_close(self: Type, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL) RETURNS !ResourceCloseResult ->
  IF type__node?(self) THEN
    RETURN ResourceCloseResult{ is_resource: FALSE, close_plan: NIL };
  END
  IF TRY (type__any_rc?(self)) THEN
    RETURN ResourceCloseResult{ is_resource: FALSE, close_plan: NIL };
  END
  IF ((TRY (type__open_stream?(self)) OR TRY (type__inf_stream?(self))) OR TRY (type__split_open_stream?(self))) THEN
    RETURN ResourceCloseResult{ is_resource: TRUE, close_plan: type__deinit_resource_close_plan() };
  END
  IF schema_lookup EXISTS AS schema_lookup_value THEN
    MUTABLE schema: ?TypeSchemaLookupResult = schema_lookup_value(type__resolved(self));
    IF schema? IS_A ResourceSchema AS resource_schema THEN
      RETURN ResourceCloseResult{ is_resource: TRUE, close_plan: resource_schema.close_plan };
    END
    RETURN ResourceCloseResult{ is_resource: FALSE, close_plan: NIL };
  ELSE
    RETURN ResourceCloseResult{ is_resource: FALSE, close_plan: NIL };
  END
END
PUB FN type__promise_list?(self: Type) RETURNS Bool ->
  RETURN (type__future?(self) AND type__list_collection?(self));
END
PUB FN type__sharded?(self: Type) RETURNS Bool ->
  RETURN !((type__shard_count(self) == NIL));
END
PUB FN type__soa?(self: Type) RETURNS Bool ->
  RETURN type__soa(self);
END
PUB FN type__fixed_soa?(self: Type) RETURNS Bool ->
  RETURN ((type__fixed?(self) AND type__soa?(self)) AND !(type__collection?(self)));
END
PUB FN type__soa_linear_collection?(self: Type) RETURNS Bool ->
  RETURN (type__soa?(self) AND (((type__pool?(self) OR type__list_collection?(self)) OR type__fixed_soa?(self))));
END
PUB FN type__list_requires_array_shape?(self: Type) RETURNS !Bool ->
  RETURN (((type__list_collection?(self) AND !(type__array?(self))) AND !(type__promise_list?(self))) AND !(((type__tense?(self) AND type__array?((TRY (type__tense_type(self))))))));
END
PUB FN type__observable_array_without_set?(self: Type) RETURNS !Bool ->
  RETURN !(!(((((type__tense?(self) AND type__observable?(self)) AND type__array?((TRY (type__tense_type(self))))) AND !(type__set_collection?(self))))));
END
PUB FN type__soa_requires_fixed_array?(self: Type) RETURNS Bool ->
  RETURN ((type__soa?(self) AND !(type__collection?(self))) AND ((!(type__array?(self)) OR !(type__fixed?(self)))));
END
PUB FN type__soa_list_materialization?(self: Type) RETURNS Bool ->
  RETURN (((type__list_collection?(self) OR type__fixed_soa?(self))) AND type__soa?(self));
END
PUB FN type__dynamic_field_array?(self: Type) RETURNS Bool ->
  RETURN (type__array?(self) AND ((type__dynamic?(self) OR type__list_collection?(self))));
END
PUB FN type__borrowed_array_argument?(self: Type) RETURNS !Bool ->
  RETURN (TRY (type__non_string_array?(self)) AND !(type__pool?(self)));
END
PUB FN type__string_comparable_with?(self: Type, other: ?Type) RETURNS !Bool ->
  IF !(TRY (type__string?(self))) THEN
    RETURN FALSE;
  END
  IF other EXISTS AS other_value THEN
    RETURN TRY (type__string?(other_value));
  ELSE
    RETURN TRUE;
  END
END
PUB FN type__plain_indirect_value?(self: Type) RETURNS Bool ->
  RETURN !(!(((((((type__indirect?(self) AND !(type__any_sync?(self))) AND (((type__ownership(self) == NIL) OR ((type__ownership(self))? == :affine)))) AND !(type__fn_type?(self))) AND !(type__error_union?(self))) AND !(type__optional?(self))))));
END
PUB FN type__striped?(self: Type) RETURNS Bool ->
  RETURN (type__sharded?(self) AND type__any_sync?(self));
END
PUB FN type__value_type(self: Type) RETURNS !Type ->
  MUTABLE kind = type__unwrap_optional_kind(type__unwrap_fallible_kind(self.shape.expression.kind));
  IF kind IS_A MapTypeExpression THEN
    RETURN TRY (type__from_child_expression((UNWRAP (typeExpressionKind__map(kind))).value));
  END
  RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }));
END
PUB FN type__generic_instance?(self: Type) RETURNS Bool ->
  RETURN typeShape__generic_instance(self.shape);
END
PUB FN type__projection?(self: Type) RETURNS Bool ->
  RETURN self.shape.expression.kind IS_A TypeProjectionExpression;
END
PUB FN type__specialization_may_need_cleanup?(self: Type) RETURNS !Bool EFFECTS REENTRANT ->
  IF (type__projection?(self) OR type__generic_instance?(self)) THEN
    RETURN TRUE;
  END
  IF type__error_union?(self) THEN
    MUTABLE payload: ?Type = TRY (type__payload_type(self));
    IF payload EXISTS AS payload_value THEN
    RETURN TRY (type__specialization_may_need_cleanup?(payload_value));
  END
  RETURN FALSE;
  END
  IF !(type__optional?(self)) THEN
    RETURN FALSE;
  END
  MUTABLE wrapped: ?Type = TRY (type__wrapped_type(self));
  IF wrapped EXISTS AS wrapped_value THEN
    RETURN TRY (type__specialization_may_need_cleanup?(wrapped_value));
  END
  RETURN FALSE;
END
PUB FN type__projection_owner(self: Type) RETURNS ?String@symbol ->
  MUTABLE kind = COPY self.shape.expression.kind;
  IF kind IS_A TypeProjectionExpression THEN
    RETURN (UNWRAP (typeExpressionKind__projection(kind))).owner;
  ELSE
    RETURN NIL;
  END
