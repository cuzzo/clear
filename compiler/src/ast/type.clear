PUB FN type__apply_type_annotation_extras_mut(MUTABLE self: Type, soa: Bool, elem_ownership: ?String@symbol, elem_sync: ?String@symbol, elem_layout: ?String@symbol, observable_token: ?Token) RETURNS !TypeCapabilities ->
  RETURN CAST(TRY (type__apply_capabilities_mut(&self, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, type__capability_boolean_or_unset(soa), type__capability_symbol_or_unset(elem_ownership), type__capability_symbol_or_unset(elem_sync), type__capability_symbol_or_unset(elem_layout), TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeBoolean{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, type__capability_token_or_unset(observable_token))) AS TypeCapabilities);
