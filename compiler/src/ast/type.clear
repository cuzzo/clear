PUB FN type__copy_placement_from_mut(MUTABLE self: Type, source: Type, preserve_existing: Bool = TRUE) RETURNS TypePlacement ->
  IF (preserve_existing AND !((type__provenance(self) == NIL))) THEN
    RETURN COPY self.placement;
  END
  RETURN type__apply_placement_mut(&self, type__placement_symbol_or_unset(type__provenance(source)));
END
PUB FN type__apply_cleanup_placement_mut(MUTABLE self: Type, value_type: ?Type, alloc: ?String@symbol) RETURNS TypePlacement ->
  IF !((type__provenance(self) == NIL)) THEN
    RETURN COPY self.placement;
  END
  IF value_type EXISTS AS value_type_value THEN
    IF !((type__provenance(value_type_value) == NIL)) THEN
      RETURN type__copy_placement_from_mut(&self, value_type_value, FALSE);
    ELSE_IF !((alloc == NIL)) THEN
      RETURN type__apply_placement_mut(&self, type__placement_symbol(alloc));
    ELSE
      RETURN COPY self.placement;
    END
  ELSE
  IF !((alloc == NIL)) THEN
      RETURN type__apply_placement_mut(&self, type__placement_symbol(alloc));
  ELSE
      RETURN COPY self.placement;
  END
  END
END
