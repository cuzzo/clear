    SchemasUnionSchemaVariantValue.StringValue AS cast_payload -> RETURN TypeTypeInput{ StringValue: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to TypeTypeInput");
  END
  panic("Invalid cast to TypeTypeInput");
END
