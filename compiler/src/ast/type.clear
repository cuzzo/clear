PUB FN type__sync_surface_name(self: Type) RETURNS ?String ->
  MUTABLE current_sync: ?String@symbol = type__sync(self);
  IF current_sync EXISTS AS current_sync_value THEN
    RETURN type__sync_surface_name_for(current_sync_value);
  ELSE
    RETURN NIL;
  END
END
PUB FN type__sync_family_name(self: Type) RETURNS ?String ->
  MUTABLE current_sync: ?String@symbol = type__sync(self);
  IF current_sync EXISTS AS current_sync_value THEN
    RETURN type__sync_family_name_for(current_sync_value);
  ELSE
    RETURN NIL;
  END
END
PUB FN type__generic_args(self: Type) RETURNS ![]Type ->
  MUTABLE kind = type__unwrap_optional_kind(type__unwrap_fallible_kind(self.shape.expression.kind));
  MUTABLE items: []TypeExpression = ( { MUTABLE rtoc_empty_list_6: []TypeExpression = List[]; rtoc_empty_list_6 } );
  IF kind IS_A TupleTypeExpression THEN
    FOR _ IN ((UNWRAP (typeExpressionKind__tuple(kind))).items) DO
    &items.append(COPY _);
    END
  ELSE_IF kind IS_A NamedTypeExpression THEN
    FOR _ IN ((UNWRAP (typeExpressionKind__named(kind))).arguments) DO
    &items.append(COPY _);
    END
  END
  MUTABLE args: []Type = ( { MUTABLE rtoc_empty_list_7: []Type = List[]; rtoc_empty_list_7 } );
  MUTABLE index: Int64 = 0;
  WHILE (index < items.length()) DO
    &args.append(TRY (type__from_child_expression(UNWRAP (items[index]))));
    index = (index + 1);
  END
  RETURN args;
END
PUB FN type__struct?(self: Type) RETURNS !Bool ->
  RETURN ((((((((((!(type__primitive?(self)) AND !(type__any?(self))) AND !(type__void?(self))) AND !(TRY (type__string?(self)))) AND !(type__array?(self))) AND !(type__map?(self))) AND !(type__tuple?(self))) AND !(type__optional?(self))) AND !(type__error_union?(self))) AND !(type__tense?(self))) AND !(type__fn_type?(self)));
END
PUB FN type__optional?(self: Type) RETURNS Bool ->
  RETURN (((typeShape__optional(self.shape) AND !(type__array?(self)))) == TRUE);
END
PUB FN type__optional_element_array?(self: Type) RETURNS Bool ->
  RETURN (((typeShape__optional(self.shape) AND type__array?(self))) == TRUE);
END
PUB FN type__wrapped_type(self: Type) RETURNS !?Type ->
  IF !(type__optional?(self)) THEN
    RETURN NIL;
  END
  MUTABLE kind = type__unwrap_fallible_kind(self.shape.expression.kind);
  IF !(kind IS_A OptionalTypeExpression) THEN
    RETURN NIL;
  END
  MUTABLE inner = TRY (type__from_child_expression((UNWRAP (typeExpressionKind__optional(kind))).inner));
  TRY (type__merge_capabilities_from_mut(&inner, self));
  type__copy_placement_from_mut(&inner, self);
  RETURN inner;
END
PUB FN type__error_union?(self: Type) RETURNS Bool ->
  RETURN typeShape__error_union(self.shape);
END
PUB FN type__payload_type(self: Type) RETURNS !?Type ->
  IF !(type__error_union?(self)) THEN
    RETURN NIL;
  END
  MUTABLE kind = COPY self.shape.expression.kind;
  IF !(kind IS_A FallibleTypeExpression) THEN
    RETURN NIL;
  END
  RETURN TRY (type__from_child_expression((UNWRAP (typeExpressionKind__fallible(kind))).inner));
END
PUB FN type__success_type(self: Type) RETURNS !Type ->
  IF !(type__error_union?(self)) THEN
    RETURN TRY (type__copy_type(self));
  END
  RETURN TRY (type__error_union_payload_with_outer_capabilities(self));
END
PUB FN type__error_union_payload_with_outer_capabilities(self: Type) RETURNS !Type ->
  MUTABLE payload = TRY (type__new(TypeConstructionInput{ Type: COPY CAST(TRY (type__payload_type(self)) AS Type) }));
  TRY (type__merge_capabilities_from_mut(&payload, self));
  type__copy_placement_from_mut(&payload, self);
  RETURN payload;
END
PUB FN type__value_payload_type(self: Type) RETURNS !Type ->
  MUTABLE t = TRY (type__success_type(self));
  IF type__optional?(t) THEN
    RETURN CAST(TRY (type__wrapped_type(t)) AS Type);
  ELSE
    RETURN t;
  END
END
PUB FN type__non_optional_type(self: Type) RETURNS !Type ->
  IF type__optional?(self) THEN
    RETURN CAST(TRY (type__wrapped_type(self)) AS Type);
  ELSE
    RETURN COPY self;
  END
END
PUB FN type__tense?(self: Type) RETURNS Bool ->
  RETURN typeShape__tense(self.shape);
END
PUB FN type__observable?(self: Type) RETURNS Bool ->
  RETURN type__is_observable(self);
END
PUB FN type__observable_array_future?(self: Type) RETURNS !Bool ->
  MUTABLE tt = TRY (type__tense_type(self));
  IF !(type__observable?(self)) THEN
    RETURN FALSE;
  END
  RETURN (type__array?(tt) == TRUE);
END
PUB FN type__tense_observable?(self: Type) RETURNS !Bool ->
  IF !((type__tense?(self) AND type__observable?(self))) THEN
    RETURN FALSE;
  END
  MUTABLE inner = TRY (type__tense_type(self));
  IF (!(type__array?(inner)) AND !(type__map?(inner))) THEN
    RETURN TRUE;
  END
  RETURN type__set_collection?(self);
END
PUB FN type__observable_terminals() RETURNS !{String@symbol}ObservableTerminalSpec ->
  RETURN CAST({:sum: ObservableTerminalSpec{ ast_class: :sum, publish: COPY ObservablePublishSpec{ publish_method: "add", expr: :typed, gate: :always } }, :count: ObservableTerminalSpec{ ast_class: :count, publish: COPY ObservablePublishSpec{ publish_method: "inc", expr: :none, gate: :pred } }, :avg: ObservableTerminalSpec{ ast_class: :avg, publish: COPY ObservablePublishSpec{ publish_method: "add", expr: :f64, gate: :always } }, :max: ObservableTerminalSpec{ ast_class: :max, publish: COPY ObservablePublishSpec{ publish_method: "submit", expr: :typed, gate: :always } }, :min: ObservableTerminalSpec{ ast_class: :min, publish: COPY ObservablePublishSpec{ publish_method: "submit", expr: :typed, gate: :always } }, :any: ObservableTerminalSpec{ ast_class: :any, publish: COPY ObservablePublishSpec{ publish_method: "submit", expr: :pred, gate: :always } }, :all: ObservableTerminalSpec{ ast_class: :all, publish: COPY ObservablePublishSpec{ publish_method: "submit", expr: :pred, gate: :always } }, :find: ObservableTerminalSpec{ ast_class: :find, publish: COPY ObservablePublishSpec{ publish_method: "submit", expr: :item, gate: :pred } }, :reduce: ObservableTerminalSpec{ ast_class: NIL, publish: NIL }, :distinct: ObservableTerminalSpec{ ast_class: NIL, publish: NIL }} AS {String@symbol}ObservableTerminalSpec);
END
PUB FN type__observable_wrapper_for_terminal(terminal: String@symbol, type_info: Type) RETURNS !?String EFFECTS REENTRANT ->
  IF (terminal == :sum) THEN
    RETURN "ObservableSum(${TRY (type__zig_type(type_info))})";
  END
  IF (terminal == :count) THEN
    RETURN "ObservableCount()";
  END
  IF (terminal == :avg) THEN
    RETURN "ObservableAvg(f64)";
  END
  IF (terminal == :max) THEN
    RETURN "ObservableMax(${TRY (type__zig_type(type_info))})";
  END
  IF (terminal == :min) THEN
    RETURN "ObservableMin(${TRY (type__zig_type(type_info))})";
  END
  IF (terminal == :any) THEN
    RETURN "ObservableAny()";
  END
  IF (terminal == :all) THEN
    RETURN "ObservableAll()";
  END
  IF (terminal == :find) THEN
    MUTABLE wrapped: ?Type = TRY (type__wrapped_type(type_info));
    IF wrapped EXISTS AS wrapped_value THEN
      RETURN "ObservableFind(${TRY (type__zig_type(wrapped_value))})";
    ELSE
      RETURN NIL;
    END
  END
  IF (terminal == :reduce) THEN
    RETURN "ObservableReduce(${TRY (type__zig_type(type_info))})";
  END
  IF (terminal == :distinct) THEN
    MUTABLE elem: ?Type = TRY (type__element_type(type_info));
    IF elem EXISTS AS elem_value THEN
      IF type__fixed?(type_info) THEN
        RETURN "ObservableStreamSetBounded(${TRY (type__zig_type(elem_value))}, ${type__array_capacity_label(type__capacity(type_info))})";
      END
      RETURN "ObservableStreamSet(${TRY (type__zig_type(elem_value))})";
    ELSE
      RETURN NIL;
    END
  END
  RETURN NIL;
END
PRIVATE FN type__observable_wrapper_zig(self: Type, tense_type: Type) RETURNS !String EFFECTS REENTRANT ->
  MUTABLE terminal: ?String@symbol = type__observable_terminal(self);
  IF terminal EXISTS AS terminal_value_2 THEN
    MUTABLE terminal_value: String@symbol = CAST(terminal_value_2 AS String@symbol);
    MUTABLE wrapper: ?String = type__observable_wrapper_for_terminal(terminal_value, tense_type);
    IF wrapper EXISTS AS wrapper_value THEN
      RETURN COPY wrapper_value;
    ELSE
      RAISE Input, CompilerError, "{}Add an entry to Type.observable_terminals in src/ast/type.rb.";
    END
  ELSE
    RAISE Input, CompilerError, "{}without an observable_terminal stamp. The terminal kind (:sum / :count / :max / :min / :avg / :any / :all / :find / :reduce / :distinct) is set by pipe_analysis's mark_observable_terminal! at fold-pipe analysis time; reaching here means an `@observable` Type was constructed by a path that bypasses that analyzer.";
  END
END
PUB FN type__future?(self: Type) RETURNS Bool ->
  RETURN type__tense?(self);
END
PUB FN type__tense_type(self: Type) RETURNS !Type ->
  MUTABLE kind = COPY self.shape.expression.kind;
  IF kind IS_A FutureTypeExpression THEN
    RETURN TRY (type__from_child_expression((UNWRAP (typeExpressionKind__future(kind))).inner));
  END
  IF kind IS_A StreamTypeExpression THEN
    MUTABLE stream_kind: StreamTypeExpression = UNWRAP (typeExpressionKind__stream(kind));
    MUTABLE dimension_branch_value: ?TypeExpressionDimension = NIL;
    IF ruby_union_scalar_equal_TypeExpressionDimension_String_symbol(stream_kind.cardinality, :FINITE) THEN
      dimension_branch_value = TypeExpressionDimension{ SymbolValue: :LIST };
    ELSE
      dimension_branch_value = COPY stream_kind.cardinality;
    END
    MUTABLE dimension: TypeExpressionDimension = dimension_branch_value?;
    RETURN TRY (type__from_child_expression(typeExpression__of(TypeExpressionKind{ LinearTypeExpression: COPY LinearTypeExpression{ kind: :array, dimensions: [dimension], item: COPY stream_kind.item, allocation_hint: NIL } })));
  END
  RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :Void }));
END
PUB FN type__canonical_stream?(self: Type) RETURNS Bool ->
  RETURN self.shape.expression.kind IS_A StreamTypeExpression;
END
PUB FN type__canonical_stream_result?(self: Type) RETURNS !Bool ->
  IF type__canonical_stream?(self) THEN
    RETURN TRUE;
  END
  IF !(type__error_union?(self)) THEN
    RETURN FALSE;
  END
  MUTABLE payload: ?Type = TRY (type__payload_type(self));
  IF payload EXISTS AS payload_value THEN
    RETURN type__canonical_stream?((payload_value));
  ELSE
    RETURN FALSE;
  END
END
PUB FN type__canonical_stream_item_type(self: Type) RETURNS !?Type ->
  MUTABLE stream_branch_value: ?Type = NIL;
  IF type__error_union?(self) THEN
    stream_branch_value = TRY (type__payload_type(self));
  ELSE
    stream_branch_value = COPY self;
  END
  MUTABLE stream: ?Type = stream_branch_value;
  IF stream EXISTS AS stream_value THEN
    MUTABLE stream_type: Type = COPY stream_value;
    IF !(type__canonical_stream?(stream_type)) THEN
      RETURN NIL;
    END
    MUTABLE kind = COPY stream_type.shape.expression.kind;
    IF !(kind IS_A StreamTypeExpression) THEN
      RETURN NIL;
    END
    RETURN TRY (type__from_child_expression((UNWRAP (typeExpressionKind__stream(kind))).item));
  ELSE
    RETURN NIL;
  END
END
PUB FN type__stream_step?(self: Type) RETURNS !Bool ->
  RETURN ((type__generic_instance?(self) AND (type__generic_base(self) == :StreamStep)) AND ((TRY (type__generic_args(self))).length() == 1));
END
PUB FN type__stream_step_item_type(self: Type) RETURNS !?Type ->
  IF !(TRY (type__stream_step?(self))) THEN
    RETURN NIL;
  END
  RETURN COPY (TRY (type__generic_args(self))).first();
END
PUB FN type__dynamic_stream?(self: Type) RETURNS !Bool ->
  MUTABLE kind = COPY self.shape.expression.kind;
  IF kind IS_A StreamTypeExpression THEN
    IF ruby_union_scalar_equal_TypeExpressionDimension_String_symbol((UNWRAP (typeExpressionKind__stream(kind))).cardinality, :FINITE) THEN
      RETURN TRUE;
    END
  END
  RETURN !(!((((((type__future?(self) AND type__dynamic?((TRY (type__tense_type(self))))) AND !(type__optional?((TRY (type__tense_type(self)))))) AND !(type__optional_element_array?((TRY (type__tense_type(self)))))) AND !(type__list_collection?(self))))));
END
PUB FN type__optional_stream_shape_type(self: Type) RETURNS !?Type ->
  IF !(type__future?(self)) THEN
    RETURN NIL;
  END
  MUTABLE stream_shape = TRY (type__tense_type(self));
  IF type__optional_element_array?(stream_shape) THEN
    MUTABLE element: ?Type = TRY (type__element_type(stream_shape));
    IF element EXISTS AS element_value THEN
      IF !(type__optional?(element_value)) THEN
        RETURN NIL;
      END
      RETURN TRY (type__array_of(TypeTypeInput{ Type: COPY CAST(TRY (type__wrapped_type(element_value)) AS Type) }, type__capacity(stream_shape)));
    ELSE
      RETURN NIL;
    END
  END
  IF !(type__optional?(stream_shape)) THEN
    RETURN NIL;
  END
  MUTABLE wrapped: ?Type = TRY (type__wrapped_type(stream_shape));
  IF wrapped EXISTS AS wrapped_value THEN
    MUTABLE wrapped_type: Type = COPY wrapped_value;
    IF type__array?(wrapped_type) THEN
      RETURN wrapped_type;
    END
    RETURN NIL;
  ELSE
    RETURN NIL;
  END
END
PRIVATE FN type__open_stream_alias?(self: Type) RETURNS !Bool ->
  MUTABLE shape: ?Type = TRY (type__optional_stream_shape_type(self));
  IF shape EXISTS AS shape_value THEN
    RETURN type__dynamic?(shape_value);
  ELSE
    RETURN FALSE;
  END
END
PUB FN type__stream?(self: Type) RETURNS !Bool ->
  RETURN ((((TRY (type__dynamic_stream?(self)) OR TRY (type__bounded_stream?(self))) OR TRY (type__open_stream?(self))) OR TRY (type__inf_stream?(self))) OR TRY (type__split_open_stream?(self)));
END
PUB FN type__runtime_stream?(self: Type) RETURNS !Bool ->
  RETURN (((TRY (type__dynamic_stream?(self)) OR TRY (type__bounded_stream?(self))) OR TRY (type__open_stream?(self))) OR TRY (type__inf_stream?(self)));
END
PUB FN type__runtime_stream_storage_element_type(self: Type) RETURNS !?Type ->
  IF TRY (type__open_stream?(self)) THEN
    RETURN TRY (type__open_stream_element_type(self));
  END
  IF (TRY (type__dynamic_stream?(self)) OR TRY (type__bounded_stream?(self))) THEN
    RETURN TRY (type__element_type((TRY (type__tense_type(self)))));
  END
  IF TRY (type__inf_stream?(self)) THEN
    RETURN TRY (type__inf_stream_element_type(self));
  END
  RETURN NIL;
END
PUB FN type__bounded_pipeline_stream_source?(self: Type, has_limit: Bool) RETURNS !Bool ->
  RETURN (((TRY (type__dynamic_stream?(self)) OR TRY (type__bounded_stream?(self))) OR TRY (type__open_stream?(self))) OR ((TRY (type__inf_stream?(self)) AND has_limit)));
END
PUB FN type__single_future?(self: Type) RETURNS !Bool ->
  RETURN (((type__future?(self) AND !(TRY (type__stream?(self)))) AND !(type__shared_promise?(self))) AND !(type__promise_list?(self)));
END
PUB FN type__split_open_stream?(self: Type) RETURNS !Bool ->
  IF !(type__split?(self)) THEN
    RETURN FALSE;
  END
  IF TRY (type__open_stream?(self)) THEN
    RETURN TRUE;
  END
  MUTABLE kind = COPY self.shape.expression.kind;
  RETURN (kind IS_A StreamTypeExpression AND ruby_union_scalar_equal_TypeExpressionDimension_String_symbol((UNWRAP (typeExpressionKind__stream(kind))).cardinality, :FINITE));
END
PUB FN type__bounded_stream?(self: Type) RETURNS !Bool ->
  MUTABLE kind = COPY self.shape.expression.kind;
  IF kind IS_A StreamTypeExpression THEN
    IF ((UNWRAP (typeExpressionKind__stream(kind))).cardinality) IS_A Int64 THEN
      RETURN TRUE;
    END
  END
  MUTABLE optional_shape: ?Type = TRY (type__optional_stream_shape_type(self));
  MUTABLE optional_bounded: Bool = FALSE;
  IF !((optional_shape == NIL)) THEN
    optional_bounded = (type__fixed?(optional_shape) AND !(TRY (type__string?(optional_shape))));
  END
  RETURN !(!(((type__future?(self) AND ((((type__fixed?((TRY (type__tense_type(self)))) AND !(TRY (type__string?((TRY (type__tense_type(self)))))))) OR optional_bounded))))));
END
PUB FN type__shared_promise?(self: Type) RETURNS Bool ->
  RETURN (type__future?(self) AND type__shared?(self));
END
PUB FN type__open_stream?(self: Type) RETURNS !Bool ->
  RETURN (type__future?(self) AND ((type__open_stream_marker?((TRY (type__tense_type(self)))) OR TRY (type__open_stream_alias?(self)))));
END
PUB FN type__open_stream_element_type(self: Type) RETURNS !?Type ->
  IF !((TRY (type__open_stream?(self)) OR TRY (type__split_open_stream?(self)))) THEN
    RETURN NIL;
  END
  IF (TRY (type__open_stream?(self)) AND TRY (type__open_stream_alias?(self))) THEN
    MUTABLE shape: ?Type = TRY (type__optional_stream_shape_type(self));
    IF shape EXISTS AS shape_value THEN
      RETURN TRY (type__element_type(shape_value));
    ELSE
      RETURN NIL;
    END
  END
  RETURN TRY (type__element_type((TRY (type__tense_type(self)))));
END
PUB FN type__inf_stream?(self: Type) RETURNS !Bool ->
  MUTABLE kind = COPY self.shape.expression.kind;
  IF kind IS_A StreamTypeExpression THEN
    IF ruby_union_scalar_equal_TypeExpressionDimension_String_symbol((UNWRAP (typeExpressionKind__stream(kind))).cardinality, :INF) THEN
      RETURN TRUE;
    END
  END
  RETURN (type__future?(self) AND type__inf_stream_marker?((TRY (type__tense_type(self)))));
END
PUB FN type__inf_stream_element_type(self: Type) RETURNS !?Type ->
  IF !(TRY (type__inf_stream?(self))) THEN
    RETURN NIL;
  END
  RETURN TRY (type__element_type((TRY (type__tense_type(self)))));
END
PUB FN type__stream_element_type(self: Type) RETURNS !?Type ->
  IF !(TRY (type__bounded_stream?(self))) THEN
    RETURN NIL;
  END
  MUTABLE optional_shape: ?Type = TRY (type__optional_stream_shape_type(self));
  IF !((optional_shape == NIL)) THEN
    IF type__fixed?(optional_shape) THEN
      MUTABLE element: ?Type = TRY (type__element_type(optional_shape));
      IF element EXISTS AS element_value THEN
        RETURN TRY (type__optional_of(type__type_input_string(TRY (type__surface_name_type(element_value)))));
      ELSE
        RETURN NIL;
      END
    END
  END
  RETURN TRY (type__element_type((TRY (type__tense_type(self)))));
END
PUB FN type__stream_capacity(self: Type) RETURNS !?TypeArrayCapacity ->
  IF !(TRY (type__bounded_stream?(self))) THEN
    RETURN NIL;
  END
  MUTABLE optional_shape: ?Type = TRY (type__optional_stream_shape_type(self));
  IF !((optional_shape == NIL)) THEN
    RETURN type__capacity(optional_shape);
  END
  RETURN type__capacity((TRY (type__tense_type(self))));
END
PUB FN type__element_type(self: Type) RETURNS !?Type EFFECTS REENTRANT ->
  IF !(type__array?(self)) THEN
    RETURN NIL;
  END
  MUTABLE kind = type__unwrap_fallible_kind(self.shape.expression.kind);
  IF kind IS_A OptionalTypeExpression THEN
    MUTABLE optional_inner = COPY ((UNWRAP (typeExpressionKind__optional(kind))).inner).kind;
    IF optional_inner IS_A LinearTypeExpression THEN
      kind = COPY optional_inner;
    END
  END
  IF !(kind IS_A LinearTypeExpression) THEN
    RETURN NIL;
  END
  RETURN TRY (type__from_child_expression((UNWRAP (typeExpressionKind__linear(kind))).item));
END
PUB FN type__slot_size(self: Type, lookup_arg: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL, lookup_block: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL) RETURNS !Int64 EFFECTS REENTRANT ->
  MUTABLE optional_resolver: ?FN(String@symbol) -> ?TypeSchemaLookupResult = type__schema_resolver(lookup_arg, lookup_block);
  IF type__scalar_slot?(self) THEN
    RETURN 1;
  END
  IF optional_resolver EXISTS AS optional_resolver_value THEN
    MUTABLE resolver: FN(String@symbol) -> ?TypeSchemaLookupResult = optional_resolver_value;
    MUTABLE fixed_slots: ?Int64 = TRY (type__fixed_array_slot_size(self, resolver));
    IF fixed_slots EXISTS AS fixed_slots_value THEN
      RETURN COPY fixed_slots_value;
    END
    IF !(TRY (type__struct?(self))) THEN
      RETURN 1;
    END
    MUTABLE schema: ?TypeSchemaLookupResult = resolver(type__resolved(self));
    IF schema EXISTS AS schema_value THEN
      IF schema_value IS_A StructSchema AS struct_schema THEN
        IF !((struct_schema.type_params.length() == 0)) THEN
          RETURN 1;
        END
        MUTABLE total: Int64 = 0;
        MUTABLE fields: []StructField@multiowned = struct_schema.fields.values();
        MUTABLE i: Int64 = 0;
        WHILE (i < fields.length()) DO
          MUTABLE field = COPY UNWRAP (fields[i]);
          total = (total + TRY (type__slot_size(field.type, resolver)));
          i = (i + 1);
        END
        RETURN total;
      END
    END
    RETURN 1;
  ELSE
    RETURN 1;
  END
END
PUB FN type__fixed_array_slot_size(self: Type, resolver: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !?Int64 EFFECTS REENTRANT ->
  IF !(type__fixed?(self)) THEN
    RETURN NIL;
  END
  MUTABLE fixed_capacity: ?TypeArrayCapacity = type__capacity(self);
  IF !(type__integer_array_capacity?(fixed_capacity)) THEN
    RETURN NIL;
  END
  MUTABLE elem: ?Type = TRY (type__element_type(self));
  IF elem EXISTS AS elem_value THEN
    RETURN (type__array_capacity_integer(fixed_capacity) * TRY (type__slot_size(elem_value, resolver)));
  ELSE
    RETURN NIL;
  END
END
PUB FN type__scalar_slot?(self: Type) RETURNS Bool ->
  RETURN (((((((type__primitive?(self) OR type__heap?(self)) OR type__dynamic?(self)) OR type__any?(self)) OR type__multiowned?(self)) OR type__shared?(self)) OR type__any_sync?(self)) OR type__generic_instance?(self));
END
PUB FN type__requires_move?(self: Type) RETURNS !Bool ->
  IF type__node?(self) THEN
    RETURN FALSE;
  END
  IF type__fn_type?(self) THEN
    RETURN FALSE;
  END
  IF TRY (type__bounded_stream?(self)) THEN
    RETURN FALSE;
  END
  IF type__shared_promise?(self) THEN
    RETURN FALSE;
  END
  IF TRY (type__open_stream?(self)) THEN
    RETURN FALSE;
  END
  IF TRY (type__inf_stream?(self)) THEN
    RETURN FALSE;
  END
  IF TRY (type__split_open_stream?(self)) THEN
    RETURN FALSE;
  END
  IF ((type__list_collection?(self) OR type__pool?(self)) OR type__set_collection?(self)) THEN
    RETURN FALSE;
  END
  IF type__map?(self) THEN
    RETURN FALSE;
  END
  IF type__tense?(self) THEN
    RETURN TRUE;
  END
  IF (type__multiowned?(self) OR type__shared?(self)) THEN
    RETURN FALSE;
  END
  IF type__any_sync?(self) THEN
    RETURN FALSE;
  END
  IF type__heap?(self) THEN
    RETURN TRUE;
  END
  IF type__array?(self) THEN
    RETURN TRUE;
  END
  RETURN !(type__primitive?(self));
END
PUB FN type__copyable?(self: Type, lookup_arg: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL, lookup_block: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL) RETURNS !Bool EFFECTS REENTRANT ->
  IF type__primitive?(self) THEN
    RETURN TRUE;
  END
  IF TRY (type__string?(self)) THEN
    RETURN TRUE;
  END
  IF type__array?(self) THEN
    RETURN FALSE;
  END
  IF ((type__multiowned?(self) OR type__shared?(self)) OR type__any_sync?(self)) THEN
    RETURN FALSE;
  END
  IF type__heap?(self) THEN
    RETURN FALSE;
  END
  IF (type__frame?(self) AND TRY (type__struct?(self))) THEN
    RETURN FALSE;
  END
  IF type__map?(self) THEN
    RETURN FALSE;
  END
  IF type__tuple?(self) THEN
    IF lookup_block EXISTS AS lookup_block_value THEN
      RETURN (TRY (type__generic_args(self))) |> ALL TRY (type__copyable?(_, lookup_block_value));
    END
    RETURN (TRY (type__generic_args(self))) |> ALL TRY (type__copyable?(_, lookup_arg));
  END
  IF !(TRY (type__struct?(self))) THEN
    RETURN FALSE;
  END
  MUTABLE resolver: ?FN(String@symbol) -> ?TypeSchemaLookupResult = type__schema_resolver(lookup_arg, lookup_block);
  IF resolver EXISTS AS resolver_value THEN
    MUTABLE resolver_fn = resolver_value;
    MUTABLE schema: ?TypeSchemaLookupResult = resolver_fn(type__resolved(self));
    IF schema EXISTS AS schema_value THEN
      IF schema_value IS_A StructSchema AS struct_schema THEN
        MUTABLE fields: []StructField@multiowned = struct_schema.fields.values();
        MUTABLE i: Int64 = 0;
        WHILE (i < fields.length()) DO
          IF !(TRY (type__copyable?((TRY (type__from_input(TypeTypeInput{ Type: COPY structField__type((UNWRAP (fields[i]))) }))), resolver_fn))) THEN
            RETURN FALSE;
          END
          i = (i + 1);
        END
        RETURN TRUE;
      END
      RETURN FALSE;
    ELSE
      RETURN FALSE;
    END
  ELSE
    RETURN FALSE;
  END
END
PUB FN type__bg_capture_is_value_copy?(self: Type, lookup_arg: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL, lookup_block: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL) RETURNS !Bool ->
  IF ((TRY (type__escape_class(self)) == :value) OR (TRY (type__escape_class(self)) == :slice_rodata)) THEN
    RETURN TRUE;
  END
  IF !((TRY (type__escape_class(self)) == :by_ref)) THEN
    RETURN FALSE;
  END
  MUTABLE resolver: ?FN(String@symbol) -> ?TypeSchemaLookupResult = type__schema_resolver(lookup_arg, lookup_block);
  IF resolver EXISTS AS resolver_value THEN
    MUTABLE resolver_fn = resolver_value;
    MUTABLE schema: ?TypeSchemaLookupResult = resolver_fn(type__resolved(self));
    IF ((schema == NIL) AND type__generic_instance?(self)) THEN
      schema = resolver_fn(type__generic_base(self));
    END
    IF schema EXISTS AS schema_value THEN
      IF schema_value IS_A EnumSchema AS enum_schema THEN
        RETURN TRUE;
      END
      IF schema_value IS_A UnionSchema AS union_schema THEN
        MUTABLE has_heap = union_schema.variants.values() |> ANY TRY (type__variant_has_heap?(_));
        RETURN !(has_heap);
      END
      RETURN FALSE;
    ELSE
      RETURN FALSE;
    END
  ELSE
    RETURN FALSE;
  END
END
PUB FN type__implicitly_copyable?(self: Type, lookup_arg: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL, lookup_block: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL) RETURNS !Bool EFFECTS REENTRANT ->
  IF type__node?(self) THEN
    RETURN TRUE;
  END
  IF type__primitive?(self) THEN
    RETURN TRUE;
  END
  IF ((type__indirect?(self) OR TRY (type__any_rc?(self))) OR type__link?(self)) THEN
    RETURN FALSE;
  END
  IF type__optional?(self) THEN
    MUTABLE wrapped: Type = CAST(TRY (type__wrapped_type(self)) AS Type);
    IF lookup_block EXISTS AS lookup_block_value THEN
      RETURN TRY (type__implicitly_copyable?(wrapped, lookup_block_value));
    ELSE
      RETURN TRY (type__implicitly_copyable?(wrapped, lookup_arg));
    END
  END
  IF type__id_handle?(self) THEN
    RETURN TRUE;
  END
  IF type__tuple?(self) THEN
    IF lookup_block EXISTS AS lookup_block_value THEN
      RETURN (TRY (type__generic_args(self))) |> ALL TRY (type__implicitly_copyable?(_, lookup_block_value));
    END
    RETURN (TRY (type__generic_args(self))) |> ALL TRY (type__implicitly_copyable?(_, lookup_arg));
  END
  IF (TRY (type__string?(self)) AND type__rodata?(self)) THEN
    RETURN TRUE;
  END
  IF ((((type__array?(self) AND !(type__list_collection?(self))) AND !(type__pool?(self))) AND !(type__set_collection?(self))) AND !(TRY (type__string?(self)))) THEN
    RETURN TRUE;
  END
  MUTABLE resolver: ?FN(String@symbol) -> ?TypeSchemaLookupResult = type__schema_resolver(lookup_arg, lookup_block);
  IF resolver EXISTS AS resolver_value THEN
    MUTABLE resolver_fn = resolver_value;
    MUTABLE schema: ?TypeSchemaLookupResult = resolver_fn(type__resolved(self));
    IF ((schema == NIL) AND type__generic_instance?(self)) THEN
      schema = resolver_fn(type__generic_base(self));
    END
    IF schema EXISTS AS schema_value THEN
      IF schema_value IS_A EnumSchema AS enum_schema THEN
        RETURN TRUE;
      END
      IF schema_value IS_A UnionSchema AS union_schema THEN
        MUTABLE has_heap = union_schema.variants.values() |> ANY TRY (type__variant_has_heap?(_));
        RETURN !(has_heap);
      END
      IF schema_value IS_A StructSchema AS struct_schema THEN
        MUTABLE raw_field_types = struct_schema.fields.values() |> SELECT COPY structField__type(_);
        MUTABLE field_types = raw_field_types |> SELECT TRY (type__substitute_generic_schema_field_type(self, TypeTypeInput{ Type: COPY _ }, Schema{ StructSchemaMultiowned: COPY struct_schema }));
        MUTABLE all_copy = field_types |> ALL TRY (type__implicitly_copyable?(_, resolver_fn));
        IF all_copy THEN
          RETURN TRUE;
        END
      END
      RETURN FALSE;
    ELSE
      RETURN FALSE;
    END
  ELSE
    RETURN FALSE;
  END
END
PUB FN type__recursive_cleanup_shape?(self: Type, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL, seen: ?[Set]String = NIL) RETURNS !Bool EFFECTS REENTRANT ->
  IF TRY (type__node_reference?(self)) THEN
    RETURN FALSE;
  END
  MUTABLE seen_set: [Set]String = (seen OR_ELSE Set[]);
  MUTABLE key = COPY type__type_id(self).key;
  IF seen_set.contains?(key) THEN
    RETURN FALSE;
  END
  &seen_set.insert(key);
  IF type__borrowed_reference?(self) THEN
    RETURN FALSE;
  END
  IF type__symbol?(self) THEN
    RETURN FALSE;
  END
  IF type__resource?(self) THEN
    RETURN TRUE;
  END
  IF type__optional?(self) THEN
    MUTABLE optional_inner: ?Type = TRY (type__wrapped_type(self));
    IF optional_inner EXISTS AS optional_inner_value THEN
      RETURN TRY (type__recursive_cleanup_shape?(optional_inner_value, schema_lookup, seen_set));
    ELSE
      RETURN FALSE;
    END
  END
  IF type__error_union?(self) THEN
    MUTABLE payload: ?Type = TRY (type__payload_type(self));
    IF payload EXISTS AS payload_value THEN
      RETURN TRY (type__recursive_cleanup_shape?(payload_value, schema_lookup, seen_set));
    ELSE
      RETURN FALSE;
    END
  END
  IF (((((((TRY (type__string?(self)) OR TRY (type__any_rc?(self))) OR type__any_sync?(self)) OR type__frozen?(self)) OR type__link?(self)) OR type__collection?(self)) OR type__indirect?(self)) OR type__future?(self)) THEN
    RETURN TRUE;
  END
  IF type__tuple?(self) THEN
    MUTABLE args = TRY (type__generic_args(self));
    MUTABLE index: Int64 = 0;
    WHILE (index < args.length()) DO
      IF TRY (type__recursive_cleanup_shape?((UNWRAP (args[index])), schema_lookup, seen_set)) THEN
        RETURN TRUE;
      END
      index = (index + 1);
    END
    RETURN FALSE;
  END
  IF type__array?(self) THEN
    IF !(type__fixed?(self)) THEN
      RETURN TRUE;
    END
    MUTABLE et: ?Type = TRY (type__element_type(self));
    IF et EXISTS AS et_value THEN
      RETURN TRY (type__recursive_cleanup_shape?(et_value, schema_lookup, seen_set));
    ELSE
      RETURN FALSE;
    END
  END
  IF schema_lookup EXISTS AS schema_lookup_value THEN
    MUTABLE lookup = COPY schema_lookup_value;
    MUTABLE schema: ?TypeSchemaLookupResult = lookup(type__resolved(self));
    IF schema EXISTS AS schema_value THEN
      IF schema_value IS_A ResourceSchema AS resource_schema THEN
        RETURN TRUE;
      END
      IF schema_value IS_A UnionSchema AS union_schema THEN
        MUTABLE values: []?SchemasUnionSchemaVariantValue = union_schema.variants.values();
        MUTABLE union_index: Int64 = 0;
        WHILE (union_index < values.length()) DO
          MUTABLE vt: ?SchemasUnionSchemaVariantValue = COPY values[union_index];
          IF vt EXISTS AS vt_value THEN
            IF vt_value IS_A InlineStructVariant AS inline_struct_variant THEN
              MUTABLE field_values = inline_struct_variant.fields.values();
              MUTABLE field_index: Int64 = 0;
              WHILE (field_index < field_values.length()) DO
                IF TRY (type__recursive_cleanup_shape?((TRY (type__from_input(UNWRAP (field_values[field_index])))), lookup, seen_set)) THEN
                  RETURN TRUE;
                END
                field_index = (field_index + 1);
              END
            ELSE
              IF TRY (type__recursive_cleanup_shape?((TRY (type__from_variant_input(vt_value))), lookup, seen_set)) THEN
                RETURN TRUE;
              END
            END
            union_index = (union_index + 1);
          ELSE
            union_index = (union_index + 1);
            CONTINUE;
          END
        END
        RETURN FALSE;
      END
      IF schema_value IS_A StructSchema AS struct_schema THEN
        MUTABLE struct_fields: []StructField@multiowned = struct_schema.fields.values();
        MUTABLE struct_index: Int64 = 0;
        WHILE (struct_index < struct_fields.length()) DO
          MUTABLE struct_field = COPY UNWRAP (struct_fields[struct_index]);
          IF structField__borrowed(struct_field) THEN
            struct_index = (struct_index + 1);
            CONTINUE;
          END
          IF TRY (type__recursive_cleanup_shape?((TRY (type__substitute_generic_schema_field_type(self, TypeTypeInput{ Type: COPY structField__type(struct_field) }, Schema{ StructSchemaMultiowned: COPY struct_schema }))), lookup, seen_set)) THEN
            RETURN TRUE;
          END
          struct_index = (struct_index + 1);
        END
        RETURN FALSE;
      END
      RETURN FALSE;
    ELSE
      RETURN FALSE;
    END
  ELSE
    RETURN FALSE;
  END
END
PUB FN type__needs_promotion?(self: Type, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL, seen: ?[Set]String = NIL) RETURNS !Bool EFFECTS REENTRANT ->
  IF TRY (type__node_reference?(self)) THEN
    RETURN FALSE;
  END
  IF ((TRY (type__string?(self)) OR type__list_collection?(self)) OR ((type__map?(self) AND !(TRY (type__numeric_map?(self)))))) THEN
    RETURN TRUE;
  END
  MUTABLE seen_set: [Set]String = (seen OR_ELSE Set[]);
  MUTABLE key = "promotion:${type__type_id(self).key}";
  IF seen_set.contains?(key) THEN
    RETURN FALSE;
  END
  &seen_set.insert(key);
  IF schema_lookup EXISTS AS schema_lookup_value THEN
    MUTABLE lookup = COPY schema_lookup_value;
    MUTABLE schema: ?TypeSchemaLookupResult = lookup(type__resolved(self));
    IF schema EXISTS AS schema_value THEN
      IF schema_value IS_A UnionSchema AS union_schema THEN
        RETURN TRY (type__schema_union_needs_promotion?(self, union_schema, lookup, seen_set));
      ELSE_IF schema_value IS_A StructSchema AS struct_schema THEN
        RETURN TRY (type__schema_struct_needs_promotion?(self, struct_schema, lookup, seen_set));
      END
    END
  END
  RETURN FALSE;
END
PUB FN type__needs_cleanup?(self: Type, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL, seen: ?[Set]String = NIL) RETURNS !Bool EFFECTS REENTRANT ->
  IF type__node?(self) THEN
    RETURN FALSE;
  END
  IF type__borrowed_reference?(self) THEN
    RETURN FALSE;
  END
  IF type__optional?(self) THEN
    MUTABLE inner: ?Type = TRY (type__wrapped_type(self));
    IF inner EXISTS AS inner_value THEN
      RETURN (TRY (type__needs_cleanup?(inner_value, schema_lookup, seen)) OR TRY (type__string?(inner_value)));
    ELSE
      RETURN FALSE;
    END
  END
  IF type__error_union?(self) THEN
    MUTABLE payload: ?Type = TRY (type__payload_type(self));
    IF payload EXISTS AS payload_value THEN
      RETURN (TRY (type__needs_cleanup?(payload_value, schema_lookup, seen)) OR TRY (type__string?(payload_value)));
    ELSE
      RETURN FALSE;
    END
  END
  IF TRY (type__non_string_array?(self)) THEN
    RETURN TRY (type__non_string_array_needs_cleanup?(self, schema_lookup, seen));
  END
  IF (((((((TRY (type__any_rc?(self)) OR type__link?(self)) OR type__resource?(self)) OR type__collection?(self)) OR type__future?(self)) OR ((TRY (type__string?(self)) AND type__heap?(self)))) OR type__any_sync?(self)) OR type__indirect?(self)) THEN
    RETURN TRUE;
  END
  MUTABLE seen_set: [Set]String = (seen OR_ELSE Set[]);
  MUTABLE key = "cleanup:${type__type_id(self).key}";
  IF seen_set.contains?(key) THEN
    RETURN FALSE;
  END
  &seen_set.insert(key);
  IF type__tuple?(self) THEN
    MUTABLE args = TRY (type__generic_args(self));
    MUTABLE index: Int64 = 0;
    WHILE (index < args.length()) DO
      IF TRY (type__needs_cleanup?((UNWRAP (args[index])), schema_lookup, seen_set)) THEN
        RETURN TRUE;
      END
      index = (index + 1);
    END
    RETURN FALSE;
  END
  IF schema_lookup EXISTS AS schema_lookup_value THEN
    MUTABLE lookup = COPY schema_lookup_value;
    MUTABLE schema: ?TypeSchemaLookupResult = lookup(type__resolved(self));
    IF schema EXISTS AS schema_value THEN
      IF schema_value IS_A UnionSchema AS union_schema THEN
        RETURN TRY (type__schema_union_needs_cleanup?(self, union_schema, lookup, seen_set));
      ELSE_IF schema_value IS_A StructSchema AS struct_schema THEN
        RETURN TRY (type__schema_struct_needs_cleanup?(self, struct_schema, lookup, seen_set));
      END
    END
  END
  RETURN FALSE;
END
PUB FN type__non_string_array_needs_cleanup?(self: Type, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult, seen: ?[Set]String = NIL) RETURNS !Bool EFFECTS REENTRANT ->
  IF !(type__fixed?(self)) THEN
    RETURN TRUE;
  END
  MUTABLE et: ?Type = TRY (type__element_type(self));
  IF et EXISTS AS et_value THEN
    RETURN TRY (type__needs_cleanup?(et_value, schema_lookup, seen));
  ELSE
    RETURN FALSE;
  END
END
PUB FN type__ownership_bearing?(self: Type, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL) RETURNS !Bool EFFECTS REENTRANT ->
  MUTABLE maybe_success_type = TRY (type__success_type(self));
  IF maybe_success_type THEN
    RETURN TRY (type__ownership_bearing_type?(maybe_success_type, schema_lookup));
  END
  RETURN TRY (type__ownership_bearing_type?(self, schema_lookup));
END
PUB FN type__parallel_boundary_forbidden_reason(self: Type, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL, seen: ?[Set]String = NIL) RETURNS !?String@symbol EFFECTS REENTRANT ->
  IF type__local?(self) THEN
    RETURN :local_scheduler_affinity;
  END
  IF type__multiowned?(self) THEN
    RETURN :non_atomic_rc;
  END
  IF (type__shared?(self) OR type__shared_node?(self)) THEN
    RETURN NIL;
  END
  IF type__node?(self) THEN
    RETURN :scheduler_local_node;
  END
  IF type__locked?(self) THEN
    RETURN :affine_locked;
  END
  IF type__write_locked?(self) THEN
    RETURN :affine_write_locked;
  END
  IF type__versioned?(self) THEN
    RETURN :affine_versioned;
  END
  MUTABLE child_types: []Type = List[];
  MUTABLE optional_child: ?Type = TRY (type__wrapped_type(self));
  IF optional_child EXISTS AS optional_child_value THEN
    &child_types.append(COPY optional_child_value);
  END
  MUTABLE array_child: ?Type = TRY (type__element_type(self));
  IF array_child EXISTS AS array_child_value THEN
    &child_types.append(COPY array_child_value);
  END
  IF type__map?(self) THEN
    &child_types.append(TRY (type__key_type(self)));
    &child_types.append(TRY (type__value_type(self)));
  END
  FOR _ IN (TRY (type__generic_args(self))) DO
  &child_types.append(COPY _);
  END
  MUTABLE child_index: Int64 = 0;
  WHILE (child_index < child_types.length()) DO
    MUTABLE reason: ?String@symbol = TRY (type__parallel_boundary_forbidden_reason((UNWRAP (child_types[child_index])), schema_lookup, seen));
    IF reason EXISTS AS reason_value THEN
      RETURN COPY reason_value;
    END
    child_index = (child_index + 1);
  END
  IF schema_lookup EXISTS AS schema_lookup_value THEN
    MUTABLE seen_types: [Set]String = (seen OR_ELSE Set[]);
    MUTABLE schema_key = COPY CAST(type__resolved(self) AS String);
    IF seen_types.contains?(schema_key) THEN
      RETURN NIL;
    END
    MUTABLE schema: ?TypeSchemaLookupResult = schema_lookup_value(type__resolved(self));
    IF schema EXISTS AS schema_value THEN
      MUTABLE next_seen = COPY seen_types;
      &next_seen.insert(schema_key);
      IF schema_value IS_A StructSchema AS struct_schema THEN
        FOR rtoc_each_item_9 IN struct_schema.fields.values() DO
  MUTABLE struct_reason: ?String@symbol = TRY (type__parallel_boundary_forbidden_reason((TRY (type__from_input(TypeTypeInput{ Type: COPY structField__type(rtoc_each_item_9) }))), schema_lookup_value, next_seen));
  IF struct_reason EXISTS AS struct_reason_value THEN
            RETURN COPY struct_reason_value;
  END
        END
      ELSE_IF schema_value IS_A ResourceSchema AS resource_schema THEN
        FOR rtoc_each_item_10 IN resource_schema.fields.values() DO
  MUTABLE resource_reason: ?String@symbol = TRY (type__parallel_boundary_forbidden_reason((TRY (type__from_input(TypeTypeInput{ Type: COPY structField__type(rtoc_each_item_10) }))), schema_lookup_value, next_seen));
  IF resource_reason EXISTS AS resource_reason_value THEN
            RETURN COPY resource_reason_value;
  END
        END
      ELSE_IF schema_value IS_A UnionSchema AS union_schema THEN
        FOR rtoc_each_item_11 IN union_schema.variants.values() DO
  IF (rtoc_each_item_11 == NIL) THEN
    CONTINUE;
  END
  IF rtoc_each_item_11? IS_A InlineStructVariant AS inline_struct_variant THEN
            FOR rtoc_each_item_12 IN inline_struct_variant.fields.values() DO
    MUTABLE inline_reason: ?String@symbol = TRY (type__parallel_boundary_forbidden_reason((TRY (type__from_input(rtoc_each_item_12))), schema_lookup_value, next_seen));
    IF inline_reason EXISTS AS inline_reason_value THEN
                RETURN COPY inline_reason_value;
    END
            END
  ELSE
            MUTABLE union_reason: ?String@symbol = TRY (type__parallel_boundary_forbidden_reason((TRY (type__from_input(castOptionalSchemasUnionSchemaVariantValueToTypeTypeInput(rtoc_each_item_11)))), schema_lookup_value, next_seen));
            IF union_reason EXISTS AS union_reason_value THEN
              RETURN COPY union_reason_value;
            END
  END
        END
      END
      RETURN NIL;
    ELSE
      RETURN NIL;
    END
  ELSE
    RETURN NIL;
  END
END
PUB FN type__ownership_bearing_type?(self: Type, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL) RETURNS !Bool EFFECTS REENTRANT ->
  IF ((type__primitive?(self) OR type__void?(self)) OR type__any?(self)) THEN
    RETURN FALSE;
  END
  IF (((type__symbol?(self) OR type__raw?(self)) OR TRY (type__c_string?(self))) OR TRY (type__c_array_view?(self))) THEN
    RETURN FALSE;
  END
  RETURN (((((TRY (type__string?(self)) OR type__future?(self)) OR TRY (type__stream?(self))) OR TRY (type__heap_ptr?(self))) OR TRY (type__needs_cleanup?(self, schema_lookup))) OR TRY (type__recursive_cleanup_shape?(self, schema_lookup)));
END
PUB FN type__needs_explicit_cleanup?(self: Type, allocator: String@symbol, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL) RETURNS !Bool EFFECTS REENTRANT ->
  IF TRY (type__node_reference?(self)) THEN
    RETURN FALSE;
  END
  IF ((type__primitive?(self) OR type__void?(self)) OR type__any?(self)) THEN
    RETURN FALSE;
  END
  IF TRY (type__implicitly_copyable?(self, schema_lookup)) THEN
    RETURN FALSE;
  END
  IF ((TRY (type__string?(self)) AND !(type__heap?(self))) AND (allocator == :frame)) THEN
    RETURN FALSE;
  END
  IF (allocator == :heap) THEN
    RETURN TRUE;
  END
  IF (TRY (type__any_rc?(self)) OR type__link?(self)) THEN
    RETURN TRUE;
  END
  IF type__any_sync?(self) THEN
    RETURN TRUE;
  END
  IF type__resource?(self) THEN
    RETURN TRUE;
  END
  IF type__collection?(self) THEN
    RETURN TRY (type__elem_has_heap_internals?(self, schema_lookup));
  END
  IF schema_lookup EXISTS AS schema_lookup_value THEN
    MUTABLE lookup = COPY schema_lookup_value;
    MUTABLE schema: ?TypeSchemaLookupResult = lookup(type__resolved(self));
    IF schema EXISTS AS schema_value THEN
      IF schema_value IS_A UnionSchema AS union_schema THEN
        RETURN union_schema.variants.values() |> ANY TRY (type__variant_has_heap?(_));
      ELSE_IF schema_value IS_A StructSchema AS struct_schema THEN
        RETURN TRY (type__schema_struct_has_heap_internals?(self, struct_schema));
      END
    END
  END
  RETURN FALSE;
END
PUB FN type__elem_has_heap_internals?(self: Type, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL) RETURNS !Bool EFFECTS REENTRANT ->
  MUTABLE et: ?Type = TRY (type__element_type(self));
  IF et EXISTS AS et_value THEN
    IF (((TRY (type__any_rc?(et_value)) OR type__link?(et_value)) OR type__any_sync?(et_value)) OR type__resource?(et_value)) THEN
      RETURN TRUE;
    END
    IF schema_lookup EXISTS AS schema_lookup_value THEN
      MUTABLE lookup = COPY schema_lookup_value;
      MUTABLE schema: ?TypeSchemaLookupResult = lookup(type__resolved(et_value));
      IF schema EXISTS AS schema_value THEN
        IF schema_value IS_A UnionSchema AS union_schema THEN
          RETURN union_schema.variants.values() |> ANY TRY (type__variant_has_heap?(_));
        ELSE_IF schema_value IS_A StructSchema AS struct_schema THEN
          RETURN TRY (type__schema_struct_any?(self, struct_schema, %(ft: Type) -> {
  rtoc_lambda_result_14 = (((TRY (type__any_rc?(ft)) OR type__link?(ft)) OR type__any_sync?(ft)) OR type__resource?(ft));
  rtoc_lambda_result_14
          }));
        END
      END
    END
    RETURN FALSE;
  ELSE
    RETURN FALSE;
  END
END
PUB FN type__cleanup_allocator(self: Type, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL) RETURNS !String@symbol EFFECTS REENTRANT ->
  IF TRY (type__heap_cleanup_allocator?(self)) THEN
    RETURN :heap;
  END
  IF schema_lookup EXISTS AS schema_lookup_value THEN
    MUTABLE lookup = COPY schema_lookup_value;
    MUTABLE schema: ?TypeSchemaLookupResult = lookup(type__resolved(self));
    IF schema EXISTS AS schema_value THEN
      IF schema_value IS_A StructSchema AS struct_schema THEN
        IF TRY (type__schema_struct_any?(self, struct_schema, %(t: Type) -> {
  rtoc_lambda_result_15 = ((type__link?(t) OR TRY (type__any_rc?(t))) OR TRY (type__string?(t)));
  rtoc_lambda_result_15
        })) THEN
          RETURN :heap;
        END
      ELSE_IF schema_value IS_A UnionSchema AS union_schema THEN
        IF union_schema.variants.values() |> ANY TRY (type__variant_has_heap?(_)) THEN
          RETURN :heap;
        END
      END
    END
  END
  RETURN :frame;
END
PUB FN type__heap_cleanup_allocator?(self: Type) RETURNS !Bool ->
  RETURN ((((((((type__heap?(self) OR type__map?(self)) OR TRY (type__any_rc?(self))) OR type__any_sync?(self)) OR type__resource?(self)) OR type__sharded?(self)) OR type__striped?(self)) OR type__link?(self)) OR TRY (type__tense_observable?(self)));
END
PUB FN type__plain_return_payload_type(self: Type) RETURNS !?Type ->
  IF !(type__error_union?(self)) THEN
    RETURN NIL;
  END
  RETURN TRY (type__error_union_payload_with_outer_capabilities(self));
END
PUB FN type__variant_has_heap?(vt: ?SchemasUnionSchemaVariantValue) RETURNS !Bool EFFECTS REENTRANT ->
  IF vt EXISTS AS vt_value THEN
    IF vt_value IS_A InlineStructVariant AS inline_struct_variant THEN
      MUTABLE fields = inline_struct_variant.fields;
      MUTABLE keys = fields.keys();
      MUTABLE i: Int64 = 0;
      WHILE (i < keys.length()) DO
        MUTABLE field_type = TRY (type__from_input(fields[UNWRAP (keys[i])]?));
        IF (TRY (type__heap_ptr?(field_type)) AND !(type__symbol?(field_type))) THEN
          RETURN TRUE;
        END
        i = (i + 1);
      END
      RETURN FALSE;
    END
    MUTABLE variant_type = TRY (type__from_variant_input(vt_value));
    RETURN (TRY (type__heap_ptr?(variant_type)) AND !(type__symbol?(variant_type)));
  ELSE
    RETURN FALSE;
  END
END
PUB FN type__zig_type(self: Type, is_param: Bool = FALSE, is_field: Bool = FALSE) RETURNS !String EFFECTS REENTRANT ->
  RETURN TRY (typeZigRenderer__render(self, is_param, is_field));
END
PUB FN type__nested_zig_type(self: Type, is_param: Bool = FALSE, is_field: Bool = FALSE) RETURNS !String EFFECTS REENTRANT ->
  RETURN TRY (typeZigRenderer__render(self, is_param, is_field, TRUE));
END
PUB FN type__render_zig_type(self: Type, is_param: Bool = FALSE, is_field: Bool = FALSE) RETURNS !String EFFECTS REENTRANT ->
  MUTABLE mutable_is_param: Bool = is_param;
  MUTABLE mutable_is_field: Bool = is_field;
  mutable_is_param = is_param;
  mutable_is_field = is_field;
  RETURN TRY (type__compute_zig_type(self, &mutable_is_param, &mutable_is_field));
END
PUB FN type__finalize_storage(self: Type, size: Int64, current_storage: ?String@symbol = NIL) RETURNS !String@symbol ->
  IF (type__frozen?(self) OR (current_storage == :frozen)) THEN
    RETURN :frozen;
  END
  IF (type__multiowned?(self) OR (current_storage == :multiowned)) THEN
    RETURN :multiowned;
  END
  IF (type__shared?(self) OR (current_storage == :shared)) THEN
    RETURN :shared;
  END
  IF (type__link?(self) OR (current_storage == :link)) THEN
    RETURN :link;
  END
  IF (type__any_sync?(self) OR ((current_storage == :heap) AND type__any_sync?(self))) THEN
    RETURN :heap;
  END
  IF ((current_storage == :rodata) OR type__rodata?(self)) THEN
    RETURN :rodata;
  END
  IF ((current_storage == :heap) OR type__heap?(self)) THEN
    RETURN :heap;
  END
  IF type__list_collection?(self) THEN
    RETURN :frame;
  END
  IF (type__primitive?(self) AND !(TRY (type__requires_move?(self)))) THEN
    RETURN :stack;
  END
  IF TRY (type__requires_move?(self)) THEN
    IF current_storage EXISTS AS current_storage_value THEN
      IF (CAST(current_storage_value AS String@symbol) == :stack) THEN
        IF (size > 128) THEN
          RETURN :frame;
        ELSE
          RETURN :stack;
        END
      END
    ELSE
      IF (size > 128) THEN
        RETURN :frame;
      ELSE
        RETURN :stack;
      END
    END
  END
  IF current_storage EXISTS AS current_storage_value THEN
    RETURN CAST(current_storage_value AS String@symbol);
  ELSE
    RETURN :stack;
  END
END
PRIVATE FN type__schema_field_type_for_query(self: Type, field_type: TypeTypeInput, schema: Schema) RETURNS !Type EFFECTS REENTRANT ->
  IF type__generic_instance?(self) THEN
    RETURN TRY (type__substitute_generic_schema_field_type(self, field_type, schema));
  END
  RETURN TRY (type__for_query(field_type));
END
PRIVATE FN type__for_query(type: TypeTypeInput) RETURNS !Type ->
  IF type IS_A Type AS type_as_type THEN
    RETURN COPY type_as_type;
  END
  RETURN TRY (type__from_input(type));
END
PRIVATE FN type__substitute_generic_schema_field_type(self: Type, field_type: TypeTypeInput, schema: Schema) RETURNS !Type ->
  MUTABLE normalized_field_type = TRY (type__from_input(field_type));
  IF !(type__generic_instance?(self)) THEN
    RETURN normalized_field_type;
  END
  MUTABLE params: []String@symbol = ( { MUTABLE rtoc_empty_list_16: []String@symbol = List[]; rtoc_empty_list_16 } );
  IF schema IS_A StructSchema AS struct_schema THEN
    params = struct_schema.type_params;
  ELSE_IF schema IS_A ResourceSchema AS resource_schema THEN
    params = resource_schema.type_params;
  END
  MUTABLE args = TRY (type__generic_args(self));
  IF ((params.length() == 0) OR (args.length() == 0)) THEN
    RETURN normalized_field_type;
  END
  MUTABLE subst: {String@symbol}Type = {};
  MUTABLE limit = IF (params.length() < args.length()) THEN
    params.length()
  ELSE
    args.length()
  END;
  MUTABLE i: Int64 = 0;
  WHILE (i < limit) DO
    MUTABLE param = COPY UNWRAP (params[i]);
    MUTABLE arg = COPY UNWRAP (args[i]);
    subst[symbol(param)] = TRY (type__new(TypeConstructionInput{ Type: COPY arg }));
    i = (i + 1);
  END
  IF subst[type__resolved(normalized_field_type)] != NIL THEN
  RETURN COPY (subst[type__resolved(normalized_field_type)])?;
  ELSE
  RETURN normalized_field_type;
  END
END
PRIVATE FN type__schema_union_needs_promotion?(self: Type, schema: UnionSchema, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, seen: [Set]String) RETURNS !Bool EFFECTS REENTRANT ->
  MUTABLE values: []?SchemasUnionSchemaVariantValue = schema.variants.values();
  MUTABLE i: Int64 = 0;
  WHILE (i < values.length()) DO
    MUTABLE vt: ?SchemasUnionSchemaVariantValue = COPY values[i];
    IF vt EXISTS AS vt_value THEN
      IF vt_value IS_A InlineStructVariant AS inline_struct_variant THEN
        IF TRY (type__inline_variant_needs_promotion?(self, inline_struct_variant, schema_lookup, seen)) THEN
          RETURN TRUE;
        END
      ELSE
        IF TRY (type__needs_promotion?((TRY (type__from_variant_input(vt_value))), schema_lookup, seen)) THEN
          RETURN TRUE;
        END
      END
      i = (i + 1);
    ELSE
      i = (i + 1);
      CONTINUE;
    END
  END
  RETURN FALSE;
END
PRIVATE FN type__inline_variant_needs_promotion?(self: Type, variant: InlineStructVariant, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, seen: [Set]String) RETURNS !Bool EFFECTS REENTRANT ->
  MUTABLE values = variant.fields.values();
  MUTABLE i: Int64 = 0;
  WHILE (i < values.length()) DO
    MUTABLE field_type = TRY (type__from_input(UNWRAP (values[i])));
    IF TRY (type__needs_promotion?(field_type, schema_lookup, seen)) THEN
      RETURN TRUE;
    END
    i = (i + 1);
  END
  RETURN FALSE;
END
PRIVATE FN type__schema_struct_needs_promotion?(self: Type, schema: StructSchema, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, seen: [Set]String) RETURNS !Bool EFFECTS REENTRANT ->
  MUTABLE values: []StructField@multiowned = schema.fields.values();
  MUTABLE i: Int64 = 0;
  WHILE (i < values.length()) DO
    MUTABLE field = COPY UNWRAP (values[i]);
    MUTABLE t = COPY field.type;
    IF field.borrowed THEN
      t = TRY (type__new(TypeConstructionInput{ Type: COPY t }));
      type__mark_borrowed_reference_mut(&t);
    END
    IF TRY (type__needs_promotion?((TRY (type__substitute_generic_schema_field_type(self, TypeTypeInput{ Type: COPY t }, Schema{ StructSchemaMultiowned: COPY schema }))), schema_lookup, seen)) THEN
      RETURN TRUE;
    END
    i = (i + 1);
  END
  RETURN FALSE;
END
PRIVATE FN type__schema_union_needs_cleanup?(self: Type, schema: UnionSchema, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, seen: [Set]String) RETURNS !Bool EFFECTS REENTRANT ->
  MUTABLE values: []?SchemasUnionSchemaVariantValue = schema.variants.values();
  MUTABLE i: Int64 = 0;
  WHILE (i < values.length()) DO
    MUTABLE vt: ?SchemasUnionSchemaVariantValue = COPY values[i];
    IF vt EXISTS AS vt_value THEN
      IF vt_value IS_A InlineStructVariant AS inline_struct_variant THEN
        IF TRY (type__inline_variant_needs_cleanup?(self, inline_struct_variant, schema_lookup, seen)) THEN
          RETURN TRUE;
        END
      ELSE
        IF TRY (type__needs_cleanup?((TRY (type__from_variant_input(vt_value))), schema_lookup, seen)) THEN
          RETURN TRUE;
        END
      END
      i = (i + 1);
    ELSE
      i = (i + 1);
      CONTINUE;
    END
  END
  RETURN FALSE;
END
PRIVATE FN type__inline_variant_needs_cleanup?(self: Type, variant: InlineStructVariant, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, seen: [Set]String) RETURNS !Bool EFFECTS REENTRANT ->
  MUTABLE values = variant.fields.values();
  MUTABLE i: Int64 = 0;
  WHILE (i < values.length()) DO
    MUTABLE field_type = TRY (type__from_input(UNWRAP (values[i])));
    IF TRY (type__needs_cleanup?(field_type, schema_lookup, seen)) THEN
      RETURN TRUE;
    END
    i = (i + 1);
  END
  RETURN FALSE;
END
PRIVATE FN type__schema_struct_needs_cleanup?(self: Type, schema: StructSchema, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, seen: [Set]String) RETURNS !Bool EFFECTS REENTRANT ->
  MUTABLE fields = COPY schema.fields;
  MUTABLE values: []StructField@multiowned = fields.values();
  MUTABLE i: Int64 = 0;
  WHILE (i < values.length()) DO
    MUTABLE field = COPY UNWRAP (values[i]);
    MUTABLE t = COPY field.type;
    IF field.borrowed THEN
      t = TRY (type__new(TypeConstructionInput{ Type: COPY t }));
      type__mark_borrowed_reference_mut(&t);
    END
    IF TRY (type__needs_cleanup?((TRY (type__substitute_generic_schema_field_type(self, TypeTypeInput{ Type: COPY t }, Schema{ StructSchemaMultiowned: COPY schema }))), schema_lookup, seen)) THEN
      RETURN TRUE;
    END
    i = (i + 1);
  END
  RETURN FALSE;
END
PRIVATE FN type__schema_struct_has_heap_internals?(self: Type, schema: StructSchema) RETURNS !Bool EFFECTS REENTRANT ->
  MUTABLE fields = COPY schema.fields;
  MUTABLE values: []StructField@multiowned = fields.values();
  MUTABLE i: Int64 = 0;
  WHILE (i < values.length()) DO
    MUTABLE field = COPY UNWRAP (values[i]);
    MUTABLE t = COPY field.type;
    IF field.borrowed THEN
      t = TRY (type__new(TypeConstructionInput{ Type: COPY t }));
      type__mark_borrowed_reference_mut(&t);
    END
    MUTABLE ft = TRY (type__substitute_generic_schema_field_type(self, TypeTypeInput{ Type: COPY t }, Schema{ StructSchemaMultiowned: COPY schema }));
    IF (((TRY (type__any_rc?(ft)) OR type__link?(ft)) OR type__any_sync?(ft)) OR type__resource?(ft)) THEN
      RETURN TRUE;
    END
    i = (i + 1);
  END
  RETURN FALSE;
END
PRIVATE FN type__schema_struct_any?(self: Type, schema: StructSchema, blk: FN(Type) -> Bool) RETURNS !Bool EFFECTS REENTRANT ->
  MUTABLE values: []StructField@multiowned = schema.fields.values();
  MUTABLE i: Int64 = 0;
  WHILE (i < values.length()) DO
    MUTABLE v = COPY UNWRAP (values[i]);
    MUTABLE t = TRY (type__from_input(TypeTypeInput{ Type: COPY v.type }));
    IF v.borrowed THEN
      t = TRY (type__copy_type(t));
      type__mark_borrowed_reference_mut(&t);
    END
    IF blk(t) THEN
      RETURN TRUE;
    END
    i = (i + 1);
  END
  RETURN FALSE;
END
PRIVATE FN type__schema_union_any?(self: Type, schema: UnionSchema, blk: FN(Type) -> Bool) RETURNS !Bool EFFECTS REENTRANT ->
  MUTABLE values: []?SchemasUnionSchemaVariantValue = schema.variants.values();
  MUTABLE i: Int64 = 0;
  WHILE (i < values.length()) DO
    MUTABLE vt: ?SchemasUnionSchemaVariantValue = COPY values[i];
    IF vt EXISTS AS vt_value THEN
      IF vt_value IS_A InlineStructVariant AS inline_struct_variant THEN
        i = (i + 1);
        CONTINUE;
      ELSE
        IF blk(TRY (type__from_variant_input(vt_value))) THEN
          RETURN TRUE;
        END
      END
      i = (i + 1);
    ELSE
      i = (i + 1);
      CONTINUE;
    END
  END
  RETURN FALSE;
END
PRIVATE FN type__accepts_fn_type?(self: Type, other_type: Type) RETURNS !Bool EFFECTS REENTRANT ->
  IF type__any?(other_type) THEN
    RETURN TRUE;
  END
  IF !(type__fn_type?(other_type)) THEN
    RETURN FALSE;
  END
  MUTABLE self_raw = UNWRAP (type__function_type(self));
  MUTABLE other_raw = UNWRAP (type__function_type(other_type));
  IF !(((self_raw.abi == other_raw.abi) OR (((self_raw.abi == :c) AND (other_raw.abi == :clear))))) THEN
    RETURN FALSE;
  END
  MUTABLE self_params = COPY self_raw.params;
  MUTABLE other_params = COPY other_raw.params;
  IF !((self_params.length() == other_params.length())) THEN
    RETURN FALSE;
  END
  IF !(TRY (type__accepts?(self_raw.return_type, other_raw.return_type))) THEN
    RETURN FALSE;
  END
  MUTABLE i: Int64 = 0;
  WHILE (i < self_params.length()) DO
    MUTABLE sp = COPY UNWRAP (self_params[i]);
    MUTABLE op = COPY UNWRAP (other_params[i]);
    MUTABLE sp_t = COPY sp.type;
    MUTABLE op_t = COPY op.type;
    IF !(TRY (type__accepts?(op_t, sp_t))) THEN
      RETURN FALSE;
    END
    i = (i + 1);
  END
  IF (other_raw.reentrant AND !(self_raw.reentrant)) THEN
    RETURN FALSE;
  END
  RETURN TRUE;
END
PRIVATE FN type__accepts_future?(self: Type, other_type: Type) RETURNS !Bool EFFECTS REENTRANT ->
  MUTABLE oe: ?Type = NIL;
  MUTABLE se: ?Type = NIL;
  IF (type__promise_list?(self) AND ((type__empty_list?(other_type) OR ((type__future?(other_type) AND type__dynamic?((TRY (type__tense_type(other_type))))))))) THEN
    RETURN TRUE;
  END
  IF !(type__future?(other_type)) THEN
    RETURN FALSE;
  END
  IF (type__canonical_stream?(other_type) AND TRY (type__dynamic_stream?(other_type))) THEN
    MUTABLE other_element: ?Type = TRY (type__element_type((TRY (type__tense_type(other_type)))));
    IF TRY (type__open_stream?(self)) THEN
      MUTABLE self_element: ?Type = TRY (type__open_stream_element_type(self));
      IF ((self_element != NIL) AND (other_element != NIL)) THEN
        RETURN TRY (type__accepts?(self_element, other_element));
      END
    ELSE_IF TRY (type__inf_stream?(self)) THEN
      MUTABLE self_element: ?Type = TRY (type__inf_stream_element_type(self));
      IF ((self_element != NIL) AND (other_element != NIL)) THEN
        RETURN TRY (type__accepts?(self_element, other_element));
      END
    END
  END
  IF (TRY (type__dynamic_stream?(self)) AND TRY (type__dynamic_stream?(other_type))) THEN
    se = TRY (type__element_type((TRY (type__tense_type(self)))));
    oe = TRY (type__element_type((TRY (type__tense_type(other_type)))));
    IF !(((se == NIL) OR (oe == NIL))) THEN
      RETURN TRY (type__accepts?(se, oe));
    END
  END
  IF (TRY (type__open_stream?(self)) AND TRY (type__open_stream?(other_type))) THEN
    se = TRY (type__open_stream_element_type(self));
    oe = TRY (type__open_stream_element_type(other_type));
    IF !(((se == NIL) OR (oe == NIL))) THEN
      RETURN TRY (type__accepts?(se, oe));
    END
  END
  IF (((TRY (type__inf_stream?(self)) AND TRY (type__open_stream?(other_type)))) OR ((TRY (type__open_stream?(self)) AND TRY (type__inf_stream?(other_type))))) THEN
    se = NIL;
    oe = NIL;
    IF TRY (type__inf_stream?(self)) THEN
      se = TRY (type__inf_stream_element_type(self));
    ELSE
      se = TRY (type__open_stream_element_type(self));
    END
    IF TRY (type__inf_stream?(other_type)) THEN
      oe = TRY (type__inf_stream_element_type(other_type));
    ELSE
      oe = TRY (type__open_stream_element_type(other_type));
    END
    IF !(((se == NIL) OR (oe == NIL))) THEN
      RETURN TRY (type__accepts?(se, oe));
    END
  END
  RETURN TRY (type__accepts?((TRY (type__tense_type(self))), TRY (type__tense_type(other_type))));
END
PRIVATE FN type__accepts_array?(self: Type, other_type: Type) RETURNS !Bool EFFECTS REENTRANT ->
  IF (type__any?(UNWRAP (TRY (type__element_type(self)))) AND type__future?(other_type)) THEN
    IF ((((TRY (type__dynamic_stream?(other_type)) OR type__promise_list?(other_type)) OR TRY (type__bounded_stream?(other_type))) OR TRY (type__open_stream?(other_type))) OR TRY (type__inf_stream?(other_type))) THEN
      RETURN TRUE;
    END
  END
  IF !(type__array?(other_type)) THEN
    RETURN FALSE;
  END
  IF type__empty_list?(other_type) THEN
    RETURN TRUE;
  END
  IF !(TRY (type__accepts?(UNWRAP (TRY (type__element_type(self))), UNWRAP (TRY (type__element_type(other_type)))))) THEN
    RETURN FALSE;
  END
  IF (type__dynamic?(self) AND type__fixed?(other_type)) THEN
    RETURN TRUE;
  END
  IF (type__fixed?(self) AND type__fixed?(other_type)) THEN
    MUTABLE other_capacity: ?TypeArrayCapacity = type__capacity(other_type);
    MUTABLE self_capacity: ?TypeArrayCapacity = type__capacity(self);
    RETURN (type__array_capacity_integer(other_capacity) <= type__array_capacity_integer(self_capacity));
  END
  RETURN (type__dynamic?(self) AND type__dynamic?(other_type));
END
PRIVATE FN type__parse_raw_input_mut(MUTABLE self: Type, raw_input: TypeRawParseInput, auto: Bool = FALSE) RETURNS !Void ->
  IF raw_input IS_A FunctionType AS function_type THEN
    MUTABLE function_type_mutable = COPY function_type;
    TRY (type__parse_function_type_input_mut(&self, function_type_mutable, auto));
    RETURN;
  END
  IF raw_input IS_A String@symbol AS string_symbol THEN
    MUTABLE string_symbol_mutable = COPY string_symbol;
    TRY (type__parse_raw_string_mut(&self, CAST(string_symbol_mutable AS String), auto));
  ELSE_IF raw_input IS_A String AS string THEN
    TRY (type__parse_raw_string_mut(&self, string, auto));
  END
END
PRIVATE FN type__parse_function_type_input_mut(MUTABLE self: Type, raw_input: FunctionType, auto: Bool = FALSE) RETURNS !Void EFFECTS REENTRANT ->
  self.shape = TRY (typeShape__from_raw(TypeShapeRaw{ FunctionType: COPY raw_input }, auto));
  self.capabilities = typeCapabilities__new(:affine);
END
PRIVATE FN type__parse_expression_input_mut(MUTABLE self: Type, expression: TypeExpression, auto: Bool = FALSE) RETURNS !Void EFFECTS REENTRANT ->
  self.shape = TRY (typeShape__from_raw(TypeShapeRaw{ SymbolValue: :Any }, auto, expression));
  self.capabilities = typeExpressionTree__root_capabilities(expression);
END
PRIVATE FN type__parse_raw_string_mut(MUTABLE self: Type, raw_str: String, auto: Bool = FALSE) RETURNS !Void EFFECTS REENTRANT ->
  MUTABLE normalized_str: String = COPY raw_str;
  IF (raw_str == "Number") THEN
    normalized_str = "Float64";
  ELSE_IF raw_str.contains?("Number") THEN
    normalized_str = regexReplaceAll(raw_str, "\\bNumber\\b", "Float64");
  END
  MUTABLE suffix: TypeCapabilitySuffix = TypeCapabilitySuffix{ base: COPY normalized_str, ownership: NIL, sync: NIL };
  IF ((!(normalized_str.contains?("<")) AND normalized_str.contains?("@")) AND !(normalized_str.startsWith?("@"))) THEN
    suffix = type__strip_capability_suffix_from(normalized_str);
  END
  self.shape = TRY (typeShape__from_core(suffix.base, auto));
  IF ((suffix.ownership != NIL) OR (suffix.sync != NIL)) THEN
    self.capabilities = typeCapabilities__new(:affine);
    MUTABLE suffix_ownership: ?String@symbol = COPY suffix.ownership;
    IF (suffix_ownership == NIL) THEN
      suffix_ownership = :affine;
    END
    TRY (type__apply_capabilities_mut(&self, type__capability_symbol_or_unset(suffix_ownership), type__capability_symbol_or_unset(suffix.sync), TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, NIL));
  ELSE
    self.capabilities = typeCapabilities__new(:affine);
  END
END
PRIVATE FN type__semantic_shape_key(self: Type) RETURNS String EFFECTS REENTRANT ->
  IF type__fn_type?(self) THEN
    RETURN type__function_type_key(self);
  END
  RETURN typeShape__semantic_key(self.shape);
END
PRIVATE FN type__function_type_key(self: Type) RETURNS String EFFECTS REENTRANT ->
  MUTABLE sig = UNWRAP (type__function_type(self));
  MUTABLE param_keys = sig.params |> SELECT type__semantic_type_key(_.type);
  MUTABLE params_key = param_keys.join(",");
  RETURN "fn(${params_key})->${type__semantic_type_key(sig.return_type)};reentrant=${(IF sig.reentrant THEN "true" ELSE "false" END)};abi=${sig.abi}";
END
PUB FN type__strip_capability_suffix_from(str: String) RETURNS TypeCapabilitySuffix ->
  IF !(str.contains?("@")) THEN
    RETURN TypeCapabilitySuffix{ base: COPY str, ownership: NIL, sync: NIL };
  END
  MUTABLE parts = regexReplaceAll(str, "\\s+", "").split("@");
  MUTABLE base = COPY (parts[0] OR_ELSE "");
  MUTABLE caps = parts |> SKIP 1;
  MUTABLE ownership: ?String@symbol = NIL;
  MUTABLE sync: ?String@symbol = NIL;
  FOR _ IN (caps |> UNNEST _.split(":")) DO
  IF (_ == "shared") THEN
    ownership = IF (ownership == :node) THEN
      :shared_node
    ELSE
      :shared
    END;
  ELSE_IF (_ == "node") THEN
    ownership = IF (ownership == :shared) THEN
      :shared_node
    ELSE
      :node
    END;
  ELSE_IF (_ == "multiOwned") OR (_ == "multiowned") THEN
    ownership = :multiowned;
  ELSE_IF (_ == "link") THEN
    ownership = :link;
  ELSE_IF (_ == "split") THEN
    ownership = :split;
  ELSE_IF (_ == "frozen") THEN
    ownership = :frozen;
  ELSE_IF (_ == "locked") THEN
    sync = :locked;
  ELSE_IF (_ == "writeLocked") OR (_ == "writelocked") THEN
    sync = :write_locked;
  ELSE_IF (_ == "versioned") THEN
    sync = :versioned;
  ELSE_IF (_ == "atomic") THEN
    sync = :atomic;
  ELSE_IF (_ == "local") THEN
    sync = :local;
  ELSE_IF (_ == "raw") THEN
    sync = :raw;
  ELSE_IF (_ == "symbol") THEN
    sync = :symbol;
  ELSE_IF (_ == "alwaysMutable") OR (_ == "alwaysmutable") THEN
    sync = :always_mutable;
  END
  END
  RETURN TypeCapabilitySuffix{ base: COPY base, ownership: COPY ownership, sync: COPY sync };
END
PRIVATE FN type__strip_capability_suffix(self: Type, str: String) RETURNS TypeCapabilitySuffix ->
  RETURN type__strip_capability_suffix_from(str);
END
PRIVATE FN type__tense_zig_type(self: Type, is_param: Bool, is_field: Bool) RETURNS !String EFFECTS REENTRANT ->
  MUTABLE elem_zig: String = "";
  IF (TRY (type__tense_observable?(self)) AND !(type__promise_list?(self))) THEN
    RETURN "*CheatLib.obs.${TRY (type__observable_wrapper_zig(self, TRY (type__tense_type(self))))}";
  END
  IF type__promise_list?(self) THEN
    MUTABLE payload = TRY (type__tense_type(self));
    MUTABLE item_expression = UNWRAP (typeExpressionTree__linear_item_envelope(payload.shape.expression));
    MUTABLE item_type = TRY (type__from_child_expression(item_expression));
    elem_zig = TRY (typeZigRenderer__render_async_payload(item_type, is_param, is_field));
    RETURN "std.ArrayListUnmanaged(CheatLib.Promise(${elem_zig}))";
  END
  IF type__canonical_stream?(self) THEN
    MUTABLE expression: StreamTypeExpression = COPY UNWRAP (typeExpressionKind__stream(self.shape.expression.kind));
    elem_zig = TRY (type__nested_zig_type((TRY (type__from_child_expression(expression.item))), is_param, is_field));
    IF ruby_union_scalar_equal_TypeExpressionDimension_String_symbol(expression.cardinality, :FINITE) THEN
      IF TRY (type__split_open_stream?(self)) THEN
        RETURN "CheatLib.SplitStream(${elem_zig})";
      ELSE
        RETURN "CheatLib.Stream(${elem_zig})";
      END
    END
    IF ruby_union_scalar_equal_TypeExpressionDimension_String_symbol(expression.cardinality, :INF) THEN
      RETURN "CheatLib.InfStream(${elem_zig})";
    END
    RETURN "CheatLib.BoundedStream(${elem_zig}, ${typeExpressionPrinter__dimension_text(expression.cardinality)})";
  END
  IF TRY (type__bounded_stream?(self)) THEN
    elem_zig = TRY (type__nested_zig_type(UNWRAP (TRY (type__stream_element_type(self))), is_param, is_field));
    RETURN "CheatLib.BoundedStream(${elem_zig}, ${type__capacity_text(TRY (type__stream_capacity(self)))})";
  END
  IF TRY (type__split_open_stream?(self)) THEN
    elem_zig = TRY (type__nested_zig_type(UNWRAP (TRY (type__open_stream_element_type(self))), is_param, is_field));
    RETURN "CheatLib.SplitStream(${elem_zig})";
  END
  IF TRY (type__dynamic_stream?(self)) THEN
    MUTABLE inner_t: Type = UNWRAP (TRY (type__element_type((TRY (type__tense_type(self))))));
    IF (type__resolved(inner_t) == :Int64) THEN
      RETURN "CheatLib.IntRange";
    ELSE_IF (type__resolved(inner_t) == :Float64) THEN
      RETURN "CheatLib.Range";
    ELSE
      RETURN "CheatLib.Stream(${TRY (type__nested_zig_type(inner_t, is_param, is_field))})";
    END
  END
  IF type__shared_promise?(self) THEN
    MUTABLE payload = TRY (type__tense_type(self));
    RETURN "CheatLib.SharedPromise(${TRY (typeZigRenderer__render_async_payload(payload, is_param, is_field))})";
  END
  IF TRY (type__split_open_stream?(self)) THEN
    elem_zig = TRY (type__nested_zig_type(UNWRAP (TRY (type__open_stream_element_type(self))), is_param, is_field));
    RETURN "CheatLib.SplitStream(${elem_zig})";
  END
  IF TRY (type__open_stream?(self)) THEN
    elem_zig = TRY (type__nested_zig_type(UNWRAP (TRY (type__open_stream_element_type(self))), is_param, is_field));
    RETURN "CheatLib.Stream(${elem_zig})";
  END
  IF TRY (type__inf_stream?(self)) THEN
    elem_zig = TRY (type__nested_zig_type(UNWRAP (TRY (type__inf_stream_element_type(self))), is_param, is_field));
    RETURN "CheatLib.InfStream(${elem_zig})";
  END
  MUTABLE payload = TRY (type__tense_type(self));
  RETURN "CheatLib.Promise(${TRY (typeZigRenderer__render_async_payload(payload, is_param, is_field))})";
END
PRIVATE FN type__capability_wrapped_zig_type(self: Type, is_param: Bool, is_field: Bool) RETURNS !?String EFFECTS REENTRANT ->
  IF !(((((type__ownership(self) != :affine) OR type__any_sync?(self))) AND !((((type__map?(self) AND type__striped?(self)) AND (type__ownership(self) == :affine)))))) THEN
    RETURN NIL;
  END
  MUTABLE inner_zig = TRY (type__capability_inner_zig_type(self, is_param, is_field));
  IF type__atomic_pointer_wrapped?(self) THEN
    RETURN "*${inner_zig}";
  END
  MUTABLE already_handle = (inner_zig.startsWith?("CheatLib.Rc(") OR inner_zig.startsWith?("CheatLib.Arc("));
  IF (already_handle AND (((type__ownership(self) == :multiowned) OR (type__ownership(self) == :shared)))) THEN
    RETURN inner_zig;
  END
  IF (type__ownership(self) == :multiowned) THEN
    RETURN "CheatLib.Rc(${inner_zig})";
  END
  IF (type__ownership(self) == :shared) THEN
    RETURN "CheatLib.Arc(${inner_zig})";
  END
  IF (type__ownership(self) == :link) THEN
    RETURN type__link_zig_type(self, inner_zig);
  END
  RETURN type__default_capability_zig_type(self, inner_zig);
END
PRIVATE FN type__link_zig_type(self: Type, inner_zig: String) RETURNS String EFFECTS REENTRANT ->
  IF (type__link_source(self) == :shared) THEN
    RETURN "CheatLib.WeakArc(${inner_zig})";
  ELSE
    RETURN "CheatLib.WeakRc(${inner_zig})";
  END
END
PRIVATE FN type__default_capability_zig_type(self: Type, inner_zig: String) RETURNS ?String EFFECTS REENTRANT ->
  IF (type__map?(self) AND type__striped?(self)) THEN
    RETURN NIL;
  END
  RETURN "*${inner_zig}";
END
PRIVATE FN type__capability_inner_zig_type(self: Type, is_param: Bool, is_field: Bool) RETURNS !String EFFECTS REENTRANT ->
  IF (type__map?(self) AND type__striped?(self)) THEN
    MUTABLE bare = TRY (type__new(TypeConstructionInput{ StringValue: CAST(type__resolved(self) AS String) }));
    TRY (type__apply_capabilities_mut(&bare, TypeCapabilitiesMaybeSymbol{ SymbolValue: :affine }, type__capability_symbol_or_unset(type__sync(self)), TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, type__capability_integer_or_unset(type__shard_count(self))));
    RETURN TRY (type__zig_type(bare, is_param, is_field));
  END
  MUTABLE inner_zig: String = "";
  IF type__fixed_soa?(self) THEN
    MUTABLE base_zig = TRY (type__nested_zig_type(UNWRAP (TRY (type__element_type(self))), is_param, is_field));
    inner_zig = "CheatLib.SoaList(${base_zig})";
  ELSE
    MUTABLE payload_is_field = (is_field AND !(((TRY (type__direct_indexable_collection?(self)) AND type__dynamic?(self)))));
    inner_zig = TRY (type__zig_type((TRY (type__bare_data_type(self))), is_param, payload_is_field));
  END
  IF type__locked?(self) THEN
    inner_zig = "CheatLib.Locked(${inner_zig})";
  END
  IF type__write_locked?(self) THEN
    inner_zig = "CheatLib.RwLocked(${inner_zig})";
  END
  IF (type__sync(self) == :always_mutable) THEN
    inner_zig = "CheatLib.RefCell(${inner_zig})";
  END
  IF type__versioned?(self) THEN
    inner_zig = "CheatLib.Versioned(${inner_zig})";
  END
  IF type__atomic_ptr?(self) THEN
    RETURN "CheatLib.AtomicPtr(${inner_zig})";
  ELSE_IF type__atomic?(self) THEN
    RETURN "CheatLib.Atomic(${inner_zig})";
  ELSE
    RETURN inner_zig;
  END
END
PRIVATE FN type__map_zig_type(self: Type) RETURNS !String EFFECTS REENTRANT ->
  MUTABLE current_shard_count: Int64 = 0_i64;
  MUTABLE val_zig = TRY (type__nested_zig_type((TRY (type__value_type(self)))));
  IF type__projection?((TRY (type__key_type(self)))) THEN
    RETURN "CheatLib.MapType(${TRY (type__zig_type((TRY (type__key_type(self)))))}, ${val_zig})";
  END
  IF type__striped?(self) THEN
    current_shard_count = UNWRAP (type__shard_count(self));
    IF TRY (type__numeric_map?(self)) THEN
      MUTABLE striped_key_zig = TRY (type__zig_type((TRY (type__key_type(self)))));
      RETURN "CheatLib.StripedNumericMap(${striped_key_zig}, ${val_zig}, ${current_shard_count.toString()})";
    END
    IF type__locked?(self) THEN
      RETURN "CheatLib.MutexShardedStringMap(${val_zig}, ${current_shard_count.toString()})";
    END
    RETURN "CheatLib.ShardedStringMap(${val_zig}, ${current_shard_count.toString()})";
  END
  IF type__sharded?(self) THEN
    current_shard_count = UNWRAP (type__shard_count(self));
    IF TRY (type__numeric_map?(self)) THEN
      MUTABLE partitioned_key_zig = TRY (type__zig_type((TRY (type__key_type(self)))));
      RETURN "CheatLib.PartitionedNumericMap(${partitioned_key_zig}, ${val_zig}, ${current_shard_count.toString()})";
    END
    RETURN "CheatLib.PartitionedStringMap(${val_zig}, ${current_shard_count.toString()})";
  END
  IF TRY (type__numeric_map?(self)) THEN
    MUTABLE numeric_key_zig = TRY (type__zig_type((TRY (type__key_type(self)))));
    RETURN "CheatLib.NumericMapType(${numeric_key_zig}, ${val_zig})";
  END
  RETURN "CheatLib.StringMap(${val_zig})";
END
PRIVATE FN type__compute_zig_type(self: Type, MUTABLE is_param: Bool = FALSE, MUTABLE is_field: Bool = FALSE) RETURNS !String EFFECTS REENTRANT ->
  MUTABLE base_zig: String = "";
  MUTABLE current_shard_count: Int64 = 0_i64;
  MUTABLE inner_zig: String = "";
  MUTABLE zig: String = "";
  IF type__projection?(self) THEN
    MUTABLE protocol: ?String@symbol = type__projection_protocol(self);
    MUTABLE facts: String = "CheatLib.MapFacts";
    IF !((protocol == NIL)) THEN
      MUTABLE protocol_value: String@symbol = CAST(protocol AS String@symbol);
      IF !((protocol_value == :Map)) THEN
        facts = "__clearProtocolFacts_${protocol_value}";
      END
    END
    RETURN "${facts}(${symbol(UNWRAP (type__projection_owner(self)))}).${symbol(UNWRAP (type__projection_member(self)))}";
  END
  IF type__tense?(self) THEN
    RETURN TRY (type__tense_zig_type(self, is_param, is_field));
  END
  IF type__error_union?(self) THEN
    inner_zig = TRY (type__zig_type((TRY (type__error_union_payload_with_outer_capabilities(self))), is_param, is_field));
    RETURN "!${inner_zig}";
  END
  IF type__optional?(self) THEN
    MUTABLE inner = UNWRAP (TRY (type__wrapped_type(self)));
    IF type__node?(inner) THEN
      RETURN TRY (type__zig_type(inner, is_param, is_field));
    END
    inner_zig = TRY (type__nested_zig_type(UNWRAP (TRY (type__wrapped_type(self))), is_param, is_field));
    RETURN "?${inner_zig}";
  END
  IF type__node?(self) THEN
    RETURN "CheatLib.NodeRef(${type__zig_type_name_for(type__resolved(self))})";
  END
  IF type__plain_indirect_value?(self) THEN
    MUTABLE pointee = TRY (type__copy_type(self));
    TRY (type__strip_layout_mut(&pointee));
    type__mark_stack_value_mut(&pointee);
    RETURN "*${TRY (type__zig_type(pointee, is_param, is_field))}";
  END
  IF type__fn_type?(self) THEN
    MUTABLE fn_raw = UNWRAP (type__function_type(self));
    MUTABLE param_types_zig: []String = ( { MUTABLE rtoc_empty_list_17: []String = List[]; rtoc_empty_list_17 } );
    MUTABLE i: Int64 = 0;
    WHILE (i < fn_raw.params.length()) DO
      MUTABLE p = COPY UNWRAP (fn_raw.params[i]);
      MUTABLE t = COPY p.type;
      &param_types_zig.append(TRY (type__zig_type(t, TRUE)));
      i = (i + 1);
    END
    MUTABLE ret_zig = TRY (type__zig_type(fn_raw.return_type));
    IF (fn_raw.abi == :c) THEN
      RETURN "*const fn(${param_types_zig.join(", ")}) callconv(.c) ${ret_zig}";
    END
    MUTABLE all_params = (["*Runtime"] + param_types_zig);
    MUTABLE ret_str = zigType__concrete_fallible_return_type(zigType__new(ret_zig));
    RETURN "*const fn(${all_params.join(", ")}) ${ret_str}";
  END
  MUTABLE wrapped_zig: ?String = TRY (type__capability_wrapped_zig_type(self, is_param, is_field));
  IF wrapped_zig EXISTS AS wrapped_zig_value THEN
    RETURN COPY wrapped_zig_value;
  END
  IF TRY (type__c_string?(self)) THEN
    RETURN "[*:0]const u8";
  END
  IF TRY (type__c_array_view?(self)) THEN
    RETURN "[*]const ${TRY (type__nested_zig_type(UNWRAP (TRY (type__element_type(self))), TRUE))}";
  END
  IF type__target_size?(self) THEN
    IF type__signed_integer?(self) THEN
      RETURN "isize";
    ELSE
      RETURN "usize";
    END
  END
  IF ((type__resolved(self) == :String) OR TRY (type__string?(self))) THEN
    RETURN "[]const u8";
  END
  IF type__rank?(self) THEN
    base_zig = TRY (type__nested_zig_type(UNWRAP (TRY (type__element_type(self))), is_param, is_field));
    IF TRY (type__dynamic_rank?(self)) THEN
      MUTABLE rank_value = TRY (type__rank(self));
      RETURN "CheatLib.Grid(${base_zig}, ${rank_value.toString()})";
    END
    RETURN "[${type__capacity_text(type__capacity(self))}]${base_zig}";
  END
  IF type__pool?(self) THEN
    base_zig = TRY (type__nested_zig_type(UNWRAP (TRY (type__element_type(self))), is_param, is_field));
    IF type__soa?(self) THEN
      RETURN "CheatLib.SoaPool(${base_zig})";
    END
    IF type__sharded?(self) THEN
      current_shard_count = UNWRAP (type__shard_count(self));
      RETURN "CheatLib.ShardedPool(${base_zig}, ${current_shard_count.toString()})";
    END
    RETURN "CheatLib.Pool(${base_zig})";
  END
  IF type__set_collection?(self) THEN
    MUTABLE elem = UNWRAP (TRY (type__element_type(self)));
    IF type__symbol?(elem) THEN
      RETURN "CheatLib.InternedStringSet()";
    END
    base_zig = TRY (type__nested_zig_type(elem, is_param, is_field));
    RETURN "CheatLib.Set(${base_zig})";
  END
  IF type__list_collection?(self) THEN
    base_zig = TRY (type__nested_zig_type(UNWRAP (TRY (type__element_type(self))), is_param, is_field));
    IF type__soa?(self) THEN
      RETURN "CheatLib.SoaList(${base_zig})";
    END
    IF type__sharded?(self) THEN
      current_shard_count = UNWRAP (type__shard_count(self));
      RETURN "CheatLib.ShardedList(${base_zig}, ${current_shard_count.toString()})";
    END
    RETURN "std.ArrayListUnmanaged(${base_zig})";
  END
  IF type__fixed_soa?(self) THEN
    base_zig = TRY (type__nested_zig_type(UNWRAP (TRY (type__element_type(self))), is_param, is_field));
    RETURN "CheatLib.SoaList(${base_zig})";
  END
  IF type__array?(self) THEN
    base_zig = TRY (type__nested_zig_type(UNWRAP (TRY (type__element_type(self))), is_param, is_field));
    MUTABLE array_capacity_value: ?TypeArrayCapacity = type__capacity(self);
    IF ((type__dynamic?(self) AND !(is_param)) AND !(is_field)) THEN
      RETURN "std.ArrayListUnmanaged(${base_zig})";
    ELSE_IF type__integer_array_capacity?(array_capacity_value) THEN
      MUTABLE current_capacity = type__array_capacity_integer(array_capacity_value);
      zig = "[${type__integer_string(current_capacity)}]${base_zig}";
    ELSE
      zig = "[]${base_zig}";
    END
    RETURN zig;
  END
  IF type__map?(self) THEN
    RETURN TRY (type__map_zig_type(self));
  END
  MUTABLE generic_zig: ?String = TRY (type__generic_instance_zig_type(self));
  IF generic_zig EXISTS AS generic_zig_value THEN
    RETURN COPY generic_zig_value;
  END
  RETURN type__zig_type_name_for(type__resolved(self));
END
PRIVATE FN type__generic_instance_zig_type(self: Type) RETURNS !?String EFFECTS REENTRANT ->
  IF !(type__generic_instance?(self)) THEN
    RETURN NIL;
  END
  IF type__id_handle?(self) THEN
    RETURN "u64";
  END
  MUTABLE args_zig_parts: []String = ( { MUTABLE rtoc_empty_list_18: []String = List[]; rtoc_empty_list_18 } );
  MUTABLE args = TRY (type__generic_args(self));
  MUTABLE i: Int64 = 0;
  WHILE (i < args.length()) DO
    MUTABLE arg_type = COPY UNWRAP (args[i]);
    &args_zig_parts.append(TRY (type__nested_zig_type(arg_type)));
    i = (i + 1);
  END
  MUTABLE args_zig = args_zig_parts.join(", ");
  IF type__tuple?(self) THEN
    RETURN "struct { ${args_zig} }";
  END
  IF (type__generic_base(self) == :StreamStep) THEN
    RETURN "CheatLib.StreamStep(${args_zig})";
  END
  MUTABLE base_name = type__symbol_or_default(typeShape__generic_base_raw(self.shape), type__resolved(self));
  RETURN "${base_name}(${args_zig})";
END
PUB FN type__new(raw_input: TypeConstructionInput, ownership: ?String@symbol = NIL, sync: ?String@symbol = NIL, layout: ?String@symbol = NIL, location: ?String@symbol = NIL, collection: ?String@symbol = NIL, shard_count: ?Int64 = NIL, stripe_count: ?Int64 = NIL, observable: ?Bool = NIL, observable_terminal: ?String@symbol = NIL, auto: Bool = FALSE) RETURNS !Type EFFECTS REENTRANT ->
  MUTABLE self = Type{ auto_token: NIL, capabilities: typeCapabilities__new(), generic_payload_type_arg: FALSE, is_resource: NIL, placement: TypePlacement{ provenance: NIL }, shape: TRY (typeShape__from_raw(TypeShapeRaw{ SymbolValue: :Any })) };
  TRY (type__initialize(&self, raw_input, ownership, sync, layout, location, collection, shard_count, stripe_count, observable, observable_terminal, auto));
  RETURN self;
END
STRUCT BinaryOpResult {
  type: ?Type,
  left_coercion: ?String@symbol,
  right_coercion: ?String@symbol,
  storage: ?String@symbol,
  error: ?String
}
# Ruby module TypeHelper
PUB FN structField__type(self: StructField) RETURNS Type ->
  RETURN COPY self.type;
END
# Ruby module Schemas



PUB FN resourceClosePlan__method(name: String, runtime_heap_alloc_args: Int64 = 0) RETURNS ResourceClosePlan ->
  RETURN ResourceClosePlan{ actions: [ResourceCloseAction{ call_kind: COPY ResourceCloseCallKind.Method, name: COPY name, runtime_heap_alloc_args: COPY runtime_heap_alloc_args, field_path: List[] }] };
END
PUB FN resourceClosePlan__function(name: String, runtime_heap_alloc_args: Int64 = 0) RETURNS ResourceClosePlan ->
  RETURN ResourceClosePlan{ actions: [ResourceCloseAction{ call_kind: COPY ResourceCloseCallKind.Function, name: COPY name, runtime_heap_alloc_args: COPY runtime_heap_alloc_args, field_path: List[] }] };
END
FN resourceClosePlan__c_function(name: String) RETURNS ResourceClosePlan ->
  RETURN ResourceClosePlan{ actions: [ResourceCloseAction{ call_kind: COPY ResourceCloseCallKind.CFunction, name: COPY name, field_path: List[], runtime_heap_alloc_args: 0 }] };
END
FN resourceClosePlan__composite(actions: []ResourceCloseAction) RETURNS ResourceClosePlan ->
  RETURN ResourceClosePlan{ actions: COPY actions };
END

FN resourceSchema__normalize_resource_field(self: ResourceSchema, field: SchemasResourceSchemaFieldInput) RETURNS !StructField
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF field IS_A StructField AS struct_field THEN
      RETURN COPY struct_field;
    END
    IF field IS_A {String@symbol}SchemasResourceSchemaFieldMetadataValue AS hash THEN
      MUTABLE raw_type_value: ?SchemasResourceSchemaFieldMetadataValue = COPY hash[:type];
      IF (raw_type_value == NIL) THEN
        raw_type_value = COPY hash[symbol("type")];
      END
      MUTABLE default_value: ?SchemasResourceSchemaFieldMetadataValue = COPY hash[:default];
      IF (default_value == NIL) THEN
        default_value = COPY hash[symbol("default")];
      END
      MUTABLE default_node: ?Locatable = NIL;
      IF default_value EXISTS AS default_present THEN
        IF default_present IS_A Locatable AS default_locatable THEN
          default_node = COPY default_locatable;
        END
      END
      MUTABLE borrowed_value: ?SchemasResourceSchemaFieldMetadataValue = COPY hash[:borrowed];
      IF (borrowed_value == NIL) THEN
        borrowed_value = COPY hash[symbol("borrowed")];
      END
      IF raw_type_value EXISTS AS raw_type_value_value THEN
        IF raw_type_value_value IS_A SchemasResourceSchemaFieldMetadataValue.Type AS field_type THEN
          RETURN StructField{ type: COPY field_type, default: COPY default_node, borrowed: !((borrowed_value == NIL)) };
        END
      ELSE
        RETURN StructField{ type: TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })), default: COPY default_node, borrowed: !((borrowed_value == NIL)) };
      END
    END
    IF field IS_A SchemasResourceSchemaFieldInput.Type AS field_type THEN
      RETURN StructField{ type: COPY field_type, default: NIL, borrowed: FALSE };
    END
    IF field IS_A SchemasResourceSchemaFieldInput.SymbolValue AS field_symbol THEN
      RETURN StructField{ type: TRY (type__new(TypeConstructionInput{ SymbolValue: COPY field_symbol })), default: NIL, borrowed: FALSE };
    END
    RETURN StructField{ type: TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })), default: NIL, borrowed: FALSE };
}
END

FN inlineStructDeinitEntry__indirect(field: String, zig_type: String) RETURNS InlineStructDeinitEntry ->
  RETURN InlineStructDeinitEntry{ field: COPY field, kind: :indirect, zig_type: COPY zig_type, elem_zig_type: NIL };
END
FN inlineStructDeinitEntry__uniform(field: String, zig_type: String) RETURNS InlineStructDeinitEntry ->
  RETURN InlineStructDeinitEntry{ field: COPY field, kind: :uniform, zig_type: COPY zig_type, elem_zig_type: NIL };
END
FN inlineStructDeinitEntry__array(field: String, elem_zig_type: String) RETURNS InlineStructDeinitEntry ->
  RETURN InlineStructDeinitEntry{ field: COPY field, kind: :array, zig_type: NIL, elem_zig_type: COPY elem_zig_type };
END



FN structSchema__normalize_struct_field(self: StructSchema, field: SchemasStructSchemaFieldInput) RETURNS !StructField
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF field IS_A StructField AS struct_field THEN
      RETURN COPY struct_field;
    END
    IF field IS_A {String@symbol}SchemasStructSchemaFieldMetadataValue AS hash THEN
      MUTABLE raw_type_value: ?SchemasStructSchemaFieldMetadataValue = COPY hash[:type];
      IF (raw_type_value == NIL) THEN
        raw_type_value = COPY hash[symbol("type")];
      END
      MUTABLE default_value: ?SchemasStructSchemaFieldMetadataValue = COPY hash[:default];
      IF (default_value == NIL) THEN
        default_value = COPY hash[symbol("default")];
      END
      MUTABLE borrowed_value: ?SchemasStructSchemaFieldMetadataValue = COPY hash[:borrowed];
      IF (borrowed_value == NIL) THEN
        borrowed_value = COPY hash[symbol("borrowed")];
      END
      MUTABLE default_node_metadata: ?Locatable = NIL;
      IF default_value EXISTS AS default_present THEN
        IF default_present IS_A Locatable AS default_node THEN
          default_node_metadata = COPY default_node;
        END
      END
      IF raw_type_value EXISTS AS raw_type_value_value THEN
        IF raw_type_value_value IS_A SchemasResourceSchemaFieldMetadataValue.Type AS field_type THEN
          RETURN StructField{ type: COPY field_type, default: default_node_metadata, borrowed: !((borrowed_value == NIL)) };
        END
      ELSE
        RETURN StructField{ type: TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })), default: default_node_metadata, borrowed: !((borrowed_value == NIL)) };
      END
    END
    IF field IS_A SchemasResourceSchemaFieldInput.Type AS field_type THEN
      RETURN StructField{ type: COPY field_type, default: NIL, borrowed: FALSE };
    END
    IF field IS_A SchemasResourceSchemaFieldInput.SymbolValue AS field_symbol THEN
      RETURN StructField{ type: TRY (type__new(TypeConstructionInput{ SymbolValue: COPY field_symbol })), default: NIL, borrowed: FALSE };
    END
    RETURN StructField{ type: TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })), default: NIL, borrowed: FALSE };
}
END
FN schemas__struct?(s: ?SchemaValue) RETURNS Bool ->
  RETURN ((s != NIL) AND (s IS_A StructSchema));
END
FN schemas__union?(s: ?SchemaValue) RETURNS Bool ->
  RETURN ((s != NIL) AND (s IS_A UnionSchema));
END
FN schemas__enum?(s: ?SchemaValue) RETURNS Bool ->
  RETURN ((s != NIL) AND (s IS_A EnumSchema));
END
FN schemas__resource?(s: ?SchemaValue) RETURNS Bool ->
  RETURN ((s != NIL) AND (s IS_A ResourceSchema));
END
FN schemas__inline_struct?(v: ?SchemasUnionSchemaVariantValue) RETURNS Bool ->
  RETURN ((v != NIL) AND (v IS_A InlineStructVariant));
END
FN schemas__field_bearing?(s: ?SchemaValue) RETURNS Bool ->
  RETURN (((s != NIL) AND (s IS_A StructSchema)) OR ((s != NIL) AND (s IS_A ResourceSchema)));
END
# End Ruby module Schemas
