PUB FN type__bare_data_type(self: Type) RETURNS !Type ->
  MUTABLE bare = TRY (type__copy_type(self));
  type__strip_runtime_capabilities_mut(&bare);
  type__reset_to_bare_data_placement_mut(&bare);
  type__clear_zig_type_cache_mut(bare);
  RETURN bare;
