PUB FN type__any_rc?(self: Type) RETURNS !Bool ->
  IF (type__shared_promise?(self) OR TRY (type__split_open_stream?(self))) THEN
    RETURN FALSE;
  END
  RETURN (type__multiowned?(self) OR type__shared?(self));
