PUB FN type__strip_layout_mut(MUTABLE self: Type) RETURNS !TypeCapabilities ->
  RETURN CAST(TRY (type__apply_capabilities_mut(&self, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, NIL)) AS TypeCapabilities);
END
PUB FN type__apply_storage_capability_mut(MUTABLE self: Type, storage: String@symbol, value_sync: ?String@symbol = NIL, link_source: ?String@symbol = NIL) RETURNS !TypeCapabilities ->
  IF (storage == :frozen) THEN
    RETURN CAST(TRY (type__apply_reference_ownership_mut(&self, :frozen)) AS TypeCapabilities);
  END
  IF (storage == :multiowned) THEN
    RETURN CAST(TRY (type__apply_reference_ownership_mut(&self, :multiowned)) AS TypeCapabilities);
  END
  IF (storage == :shared) THEN
    RETURN CAST(TRY (type__apply_reference_ownership_mut(&self, :shared)) AS TypeCapabilities);
  END
  IF (storage == :link) THEN
    RETURN CAST(TRY (type__apply_reference_ownership_mut(&self, :link, link_source)) AS TypeCapabilities);
  END
  IF (storage == :rodata) THEN
    type__mark_rodata_mut(&self);
    RETURN typeCapabilities__copy(self.capabilities);
  END
  IF (storage == :frame) THEN
    type__mark_frame_allocated_mut(&self);
    RETURN typeCapabilities__copy(self.capabilities);
  END
  IF (storage == :heap) THEN
    type__mark_heap_allocated_mut(&self);
    IF ((value_sync == :locked) OR (value_sync == :write_locked)) THEN
      RETURN CAST(TRY (type__apply_capabilities_mut(&self, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, type__capability_symbol(value_sync))) AS TypeCapabilities);
    END
    RETURN typeCapabilities__copy(self.capabilities);
  END
  IF (storage == :borrow) THEN
    type__mark_borrowed_reference_mut(&self);
    RETURN typeCapabilities__copy(self.capabilities);
  END
  RETURN typeCapabilities__copy(self.capabilities);
END
PUB FN type__apply_symbol_overlay_mut(MUTABLE self: Type, storage: String@symbol, entry_sync: ?String@symbol, entry_layout: ?String@symbol, value_sync: ?String@symbol, link_source: ?String@symbol, atomic_ptr: Bool) RETURNS !TypeCapabilities ->
  TRY (type__apply_storage_capability_mut(&self, storage, value_sync, link_source));
  RETURN CAST(TRY (type__apply_capabilities_mut(&self, type__capability_symbol_or_unset(IF (atomic_ptr AND (type__ownership(self) == :affine)) THEN
    :shared
  ELSE
    NIL
  END), type__capability_symbol_or_unset(IF (!((entry_sync == NIL)) AND (type__sync(self) == NIL)) THEN
    entry_sync
  ELSE
    NIL
  END), type__capability_symbol_or_unset(IF (!((entry_layout == NIL)) AND (type__layout(self) == NIL)) THEN
    entry_layout
  ELSE
    NIL
  END))) AS TypeCapabilities);
END
PUB FN type__apply_bg_capture_symbol_mut(MUTABLE self: Type, storage: String@symbol, sync_value: ?String@symbol) RETURNS !TypeCapabilities ->
  MUTABLE current_sync: ?String@symbol = COPY self.capabilities.sync;
  RETURN CAST(TRY (type__apply_capabilities_mut(&self, type__capability_symbol_or_unset(IF ((((storage == :multiowned) OR (storage == :shared))) AND (((type__ownership(self) == NIL) OR ((type__ownership(self))? == :affine)))) THEN
    storage
  ELSE
    NIL
  END), type__capability_symbol_or_unset(IF (!((sync_value == NIL)) AND (current_sync == NIL)) THEN
    sync_value
  ELSE
    NIL
  END))) AS TypeCapabilities);
END
PUB FN type__copy_collection_shape_from_mut(MUTABLE self: Type, source: Type) RETURNS !TypeCapabilities ->
  MUTABLE source_collection: ?String@symbol = type__collection(source);
  MUTABLE source_shard_count: ?Int64 = type__shard_count(source);
  MUTABLE current_element: ?Type = TRY (type__element_type(self));
  IF (current_element == NIL) THEN
    MUTABLE source_element: ?Type = TRY (type__element_type(source));
    IF !((source_element == NIL)) THEN
      self.shape = typeShape__copy(source.shape);
    END
  END
  RETURN CAST(TRY (type__apply_capabilities_mut(&self, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, type__capability_symbol_or_unset(IF ((type__collection(self) == NIL) AND !((source_collection == NIL))) THEN
    source_collection
  ELSE
    NIL
  END), type__capability_integer_or_unset(IF ((type__shard_count(self) == NIL) AND !((source_shard_count == NIL))) THEN
    source_shard_count
  ELSE
    NIL
  END), type__capability_boolean_or_unset((type__soa?(source) AND !(type__soa?(self)))))) AS TypeCapabilities);
END
PUB FN type__replace_shape_mut(MUTABLE self: Type, shape: TypeShape) RETURNS TypeShape ->
  self.shape = typeShape__copy(shape);
  RETURN COPY self.shape;
END
PUB FN type__replace_capabilities_mut(MUTABLE self: Type, capabilities: TypeCapabilities) RETURNS !TypeCapabilities ->
  self.capabilities = typeCapabilities__copy(capabilities);
  self.shape = TRY (typeShape__with_expression(self.shape, typeExpressionTree__with_root_capabilities(self.shape.expression, self.capabilities)));
  RETURN COPY self.capabilities;
END
PUB FN type__replace_placement_mut(MUTABLE self: Type, placement: TypePlacement) RETURNS TypePlacement ->
  self.placement = typePlacement__copy(placement);
  RETURN COPY self.placement;
END
PUB FN type__copy_topology_from_mut(MUTABLE self: Type, source: Type) RETURNS !TypeCapabilities ->
  MUTABLE source_shard_count: ?Int64 = type__shard_count(source);
  RETURN CAST(TRY (type__apply_capabilities_mut(&self, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, type__capability_integer_or_unset(IF ((type__shard_count(self) == NIL) AND !((source_shard_count == NIL))) THEN
    source_shard_count
  ELSE
    NIL
  END), type__capability_boolean_or_unset((type__soa?(source) AND !(type__soa?(self)))))) AS TypeCapabilities);
END
PUB FN type__copy_declared_collection_modifiers_from_mut(MUTABLE self: Type, source: Type) RETURNS !TypeCapabilities ->
  MUTABLE source_ownership: ?String@symbol = type__ownership(source);
  MUTABLE source_sync: ?String@symbol = type__sync(source);
  MUTABLE source_shard_count: ?Int64 = type__shard_count(source);
  RETURN CAST(TRY (type__apply_capabilities_mut(&self, type__capability_symbol_or_unset(IF (!((source_ownership == NIL)) AND (source_ownership != :affine)) THEN
    source_ownership
  ELSE
    NIL
  END), type__capability_symbol_or_unset(IF (!((source_sync == NIL)) AND (type__sync(self) == NIL)) THEN
    source_sync
  ELSE
    NIL
  END), TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, type__capability_integer_or_unset(IF (!((source_shard_count == NIL)) AND (type__shard_count(self) == NIL)) THEN
    source_shard_count
  ELSE
    NIL
  END))) AS TypeCapabilities);
END
PUB FN type__copy_element_capabilities_from_mut(MUTABLE self: Type, source: Type) RETURNS !TypeCapabilities ->
  RETURN CAST(TRY (type__apply_capabilities_mut(&self, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeBoolean{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, type__capability_symbol_or_unset(type__elem_ownership(source)), type__capability_symbol_or_unset(type__elem_sync(source)), type__capability_symbol_or_unset(type__elem_layout(source)))) AS TypeCapabilities);
END
PUB FN type__copy_striped_map_topology_from_mut(MUTABLE self: Type, source: Type) RETURNS !TypeCapabilities ->
  MUTABLE source_shard_count: ?Int64 = type__shard_count(source);
  MUTABLE source_sync: ?String@symbol = type__sync(source);
  RETURN CAST(TRY (type__apply_capabilities_mut(&self, type__capability_symbol(:affine), type__capability_symbol_or_unset(IF (!((source_shard_count == NIL)) AND !((source_sync == NIL))) THEN
    source_sync
  ELSE
    NIL
  END), TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, type__capability_integer_or_unset(source_shard_count))) AS TypeCapabilities);
END
PUB FN type__apply_finalized_value_shape_mut(MUTABLE self: Type, final_type: Type, value_type: ?Type) RETURNS !TypeCapabilities ->
  MUTABLE value_shard_count: ?Int64 = NIL;
  MUTABLE value_soa: Bool = FALSE;
  MUTABLE value_observable: Bool = FALSE;
  MUTABLE value_observable_terminal: ?String@symbol = NIL;
  MUTABLE value_elem_ownership: ?String@symbol = NIL;
  MUTABLE value_elem_sync: ?String@symbol = NIL;
  MUTABLE value_elem_layout: ?String@symbol = NIL;
  MUTABLE value_collection: ?String@symbol = NIL;
  MUTABLE link_src: ?String@symbol = NIL;
  IF value_type EXISTS AS value_type_value THEN
    value_shard_count = type__shard_count(value_type_value);
    value_soa = type__soa(value_type_value);
    value_observable = type__observable?(value_type_value);
    value_observable_terminal = type__observable_terminal(value_type_value);
    value_elem_ownership = type__elem_ownership(value_type_value);
    value_elem_sync = type__elem_sync(value_type_value);
    value_elem_layout = type__elem_layout(value_type_value);
    IF !(type__rank?(final_type)) THEN
      value_collection = type__collection(value_type_value);
    END
    IF type__link?(value_type_value) THEN
      link_src = type__link_source(value_type_value);
    END
  END
  MUTABLE declared_shard_count: ?Int64 = type__shard_count(final_type);
  MUTABLE final_shard_count: ?Int64 =   IF !((declared_shard_count == NIL)) THEN
    declared_shard_count
  ELSE
    value_shard_count
  END;
  MUTABLE final_soa = (type__soa(final_type) OR value_soa);
  MUTABLE observable = (type__observable?(final_type) OR value_observable);
  MUTABLE final_observable_terminal: ?String@symbol = type__observable_terminal(final_type);
  MUTABLE observable_terminal: ?String@symbol =   IF !((final_observable_terminal == NIL)) THEN
    final_observable_terminal
  ELSE_IF !((value_observable_terminal == NIL)) THEN
    value_observable_terminal
  ELSE
    NIL
  END;
  MUTABLE declared_elem_ownership: ?String@symbol = type__elem_ownership(final_type);
  MUTABLE declared_elem_sync: ?String@symbol = type__elem_sync(final_type);
  MUTABLE declared_elem_layout: ?String@symbol = type__elem_layout(final_type);
  MUTABLE elem_ownership: ?String@symbol =   IF !((declared_elem_ownership == NIL)) THEN
    declared_elem_ownership
  ELSE
    value_elem_ownership
  END;
  MUTABLE elem_sync: ?String@symbol =   IF !((declared_elem_sync == NIL)) THEN
    declared_elem_sync
  ELSE
    value_elem_sync
  END;
  MUTABLE elem_layout: ?String@symbol =   IF !((declared_elem_layout == NIL)) THEN
    declared_elem_layout
  ELSE
    value_elem_layout
  END;
  RETURN CAST(TRY (type__apply_capabilities_mut(&self, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, type__capability_symbol_or_unset(type__sync(final_type)), type__capability_symbol_or_unset(type__layout(final_type)), TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, type__capability_symbol_or_unset(value_collection), type__capability_integer_or_unset(final_shard_count), type__capability_boolean_or_unset(final_soa), type__capability_symbol_or_unset(elem_ownership), type__capability_symbol_or_unset(elem_sync), type__capability_symbol_or_unset(elem_layout), type__capability_symbol_or_unset(link_src), type__capability_boolean_or_unset(observable), type__capability_symbol_or_unset(observable_terminal))) AS TypeCapabilities);
END
PUB FN type__merge_capabilities_from_mut(MUTABLE self: Type, source: Type, MUTABLE preserve_existing: Bool = TRUE, include_affine_ownership: Bool = FALSE) RETURNS !TypeCapabilities ->
  MUTABLE source_ownership: ?String@symbol = type__ownership(source);
  MUTABLE source_collection: ?String@symbol = type__collection(source);
  MUTABLE source_shard_count: ?Int64 = type__shard_count(source);
  MUTABLE source_layout: ?String@symbol = type__layout(source);
  MUTABLE source_sync: ?String@symbol = type__sync(source);
  MUTABLE source_elem_ownership: ?String@symbol = type__elem_ownership(source);
  MUTABLE source_elem_sync: ?String@symbol = type__elem_sync(source);
  MUTABLE source_elem_layout: ?String@symbol = type__elem_layout(source);
  MUTABLE source_link_source: ?String@symbol = type__link_source(source);
  MUTABLE source_observable_terminal: ?String@symbol = type__observable_terminal(source);
  MUTABLE source_observable_token: ?Token = type__observable_token(source);
  MUTABLE should_copy_ownership = ((!((source_ownership == NIL)) AND !((((preserve_existing AND !((type__ownership(self) == NIL))) AND (type__ownership(self) != :affine))))) AND ((include_affine_ownership OR (source_ownership != :affine))));
  TRY (type__apply_capabilities_mut(&self, type__capability_symbol_or_unset(IF should_copy_ownership THEN
    source_ownership
  ELSE
    NIL
  END), type__capability_symbol_or_unset(IF (((!(preserve_existing) OR (type__sync(self) == NIL))) AND !((source_sync == NIL))) THEN
    source_sync
  ELSE
    NIL
  END), type__capability_symbol_or_unset(IF (((!(preserve_existing) OR (type__layout(self) == NIL))) AND !((source_layout == NIL))) THEN
    source_layout
  ELSE
    NIL
  END), TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, type__capability_symbol_or_unset(IF (((!(preserve_existing) OR (type__collection(self) == NIL))) AND !((source_collection == NIL))) THEN
    source_collection
  ELSE
    NIL
  END), type__capability_integer_or_unset(IF (((!(preserve_existing) OR (type__shard_count(self) == NIL))) AND !((source_shard_count == NIL))) THEN
    source_shard_count
  ELSE
    NIL
  END), type__capability_boolean_or_unset((type__soa?(source) AND ((!(preserve_existing) OR !(type__soa?(self)))))), type__capability_symbol_or_unset(IF (((!(preserve_existing) OR (type__elem_ownership(self) == NIL))) AND !((source_elem_ownership == NIL))) THEN
    source_elem_ownership
  ELSE
    NIL
  END), type__capability_symbol_or_unset(IF (((!(preserve_existing) OR (type__elem_sync(self) == NIL))) AND !((source_elem_sync == NIL))) THEN
    source_elem_sync
  ELSE
    NIL
  END), type__capability_symbol_or_unset(IF (((!(preserve_existing) OR (type__elem_layout(self) == NIL))) AND !((source_elem_layout == NIL))) THEN
    source_elem_layout
  ELSE
    NIL
  END), type__capability_symbol_or_unset(IF (((!(preserve_existing) OR (type__link_source(self) == NIL))) AND !((source_link_source == NIL))) THEN
    source_link_source
  ELSE
    NIL
  END), type__capability_boolean_or_unset((type__observable?(source) AND ((!(preserve_existing) OR !(type__observable?(self)))))), type__capability_symbol_or_unset(IF (((!(preserve_existing) OR (type__observable_terminal(self) == NIL))) AND !((source_observable_terminal == NIL))) THEN
    source_observable_terminal
  ELSE
    NIL
  END), TypeCapabilitiesMaybeToken{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, type__capability_boolean_or_unset((type__polymorphic_shared?(source) AND ((!(preserve_existing) OR !(type__polymorphic_shared?(self))))))));
  IF (((!(preserve_existing) OR (type__observable_token(self) == NIL))) AND !((source_observable_token == NIL))) THEN
    RETURN CAST(TRY (type__apply_capabilities_mut(&self, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeBoolean{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeBoolean{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, type__capability_token_or_unset(CAST(source_observable_token AS ?Token)))) AS TypeCapabilities);
  END
  RETURN typeCapabilities__copy(self.capabilities);
END
PUB FN type__strip_runtime_capabilities_mut(MUTABLE self: Type) RETURNS !TypeCapabilities ->
  self.capabilities = typeCapabilities__without_runtime_wrappers(self.capabilities);
  self.shape = TRY (typeShape__with_expression(self.shape, typeExpressionTree__with_root_capabilities(self.shape.expression, self.capabilities)));
  RETURN COPY self.capabilities;
END
PUB FN type__equals?(self: Type, other: TypeTypeInput) RETURNS !Bool EFFECTS REENTRANT ->
  IF type__fn_type?(self) THEN
    IF other IS_A Type AS type THEN
      IF !(type__fn_type?(type)) THEN
        RETURN FALSE;
      END
      RETURN (type__semantic_type_key(self) == type__semantic_type_key(type));
    ELSE
      RETURN FALSE;
    END
  END
  MUTABLE other_type = TRY (type__from_input(other));
  RETURN ((type__resolved(self) == type__to_sym(other_type)) OR (type__semantic_type_key(self) == type__semantic_type_key(other_type)));
END
PUB FN type__raw(self: Type) RETURNS TypeShapeRaw EFFECTS REENTRANT ->
  RETURN typeShape__raw(self.shape);
END
PUB FN type__name(self: Type) RETURNS Void ->
  RETURN NIL;
END
PUB FN type__capacity(self: Type) RETURNS ?TypeArrayCapacity EFFECTS REENTRANT ->
  RETURN typeShape__capacity(self.shape);
END
PUB FN type__allocation_hint(self: Type) RETURNS ?Int64 EFFECTS REENTRANT ->
  RETURN typeShape__allocation_hint(self.shape);
END
PUB FN type__preallocation_hint?(self: Type) RETURNS !Bool ->
  RETURN (TRY (typeExpressionTree__each_node(self.shape.expression))) |> ANY type__preallocation_expression?(_);
END
PUB FN type__to_s(self: Type) RETURNS String EFFECTS REENTRANT ->
  RETURN COPY CAST(type__resolved(self) AS String);
END
PUB FN type__to_sym(self: Type) RETURNS String@symbol EFFECTS REENTRANT ->
  RETURN type__resolved(self);
END
PUB FN type__resolved(self: Type) RETURNS String@symbol EFFECTS REENTRANT ->
  MUTABLE fn: ?FunctionType = type__function_type(self);
  IF !((fn == NIL)) THEN
    RETURN type__function_return_symbol(fn);
  END
  RETURN typeShape__resolved(self.shape);
END
PRIVATE FN type__type_id(self: Type) RETURNS TypeId ->
  RETURN TypeId{ key: COPY type__semantic_type_key(self) };
END
PUB FN type__semantic_type_key(self: Type) RETURNS String EFFECTS REENTRANT ->
  MUTABLE ownership_key: String = "";
  IF (type__ownership(self) == NIL) THEN
    ownership_key = "affine";
  ELSE
    ownership_key = COPY CAST(symbol(UNWRAP (type__ownership(self))) AS String);
  END
  MUTABLE sync_key: String = "";
  IF (type__sync(self) == NIL) THEN
    sync_key = "none";
  ELSE
    sync_key = COPY CAST(symbol(UNWRAP (type__sync(self))) AS String);
  END
  MUTABLE layout_key: String = "";
  IF (type__layout(self) == NIL) THEN
    layout_key = "direct";
  ELSE
    layout_key = COPY CAST(symbol(UNWRAP (type__layout(self))) AS String);
  END
  MUTABLE provenance_key: String = "";
  IF (type__provenance(self) == NIL) THEN
    provenance_key = "stack";
  ELSE
    provenance_key = COPY CAST(symbol(UNWRAP (type__provenance(self))) AS String);
  END
  MUTABLE collection_key: String = "";
  IF (type__collection(self) == NIL) THEN
    collection_key = "none";
  ELSE
    collection_key = COPY CAST(symbol(UNWRAP (type__collection(self))) AS String);
  END
  MUTABLE shards_key: String = "";
  IF (type__shard_count(self) == NIL) THEN
    shards_key = "0";
  ELSE
    shards_key = type__integer_string(UNWRAP (type__shard_count(self)));
  END
  MUTABLE elem_layout_key: String = "";
  IF (type__elem_layout(self) == NIL) THEN
    elem_layout_key = "direct";
  ELSE
    elem_layout_key = COPY CAST(symbol(UNWRAP (type__elem_layout(self))) AS String);
  END
  RETURN ([type__semantic_shape_key(self), "own=${ownership_key}", "sync=${sync_key}", "layout=${layout_key}", "loc=${provenance_key}", "collection=${collection_key}", "shards=${shards_key}", "elem_layout=${elem_layout_key}"]).join("|");
END
PUB FN type__lifecycle_type_key(self: Type) RETURNS String ->
  MUTABLE location: String = "owned";
  IF type__provenance(self) EXISTS AS provenance_kind THEN
    location = PARTIAL MATCH provenance_kind START
      :borrow -> "borrow",
      :rodata -> "rodata",
      DEFAULT -> "owned"
    END;
  END
  RETURN regexReplaceFirst(type__semantic_type_key(self), "\\|loc=[^|]+", "|loc=${location}");
END
PUB FN type__base_type(self: Type) RETURNS !String@symbol ->
  MUTABLE element_raw: ?String@symbol = TRY (typeShape__element_type_raw(self.shape));
  IF type__array?(self) THEN
    RETURN type__symbol_or_any(element_raw);
  END
  RETURN type__resolved(self);
END
PUB FN type__generic_type_parameter?(self: Type) RETURNS Bool ->
  MUTABLE raw_text = COPY CAST(type__resolved(self) AS String);
  RETURN (((raw_text.codepointCount() == 1) AND (raw_text >= "A")) AND (raw_text <= "Z"));
END
PUB FN type__primitive?(self: Type) RETURNS Bool ->
  RETURN type__primitive_symbol?(type__resolved(self));
END
PUB FN type__accepts?(self: Type, other_type: Type) RETURNS !Bool EFFECTS REENTRANT ->
  IF type__fn_type?(self) THEN
    RETURN type__accepts_fn_type?(self, other_type);
  END
  IF (type__any?(self) OR type__any?(other_type)) THEN
    RETURN TRUE;
  END
  IF (type__error_union?(other_type) AND !(type__error_union?(self))) THEN
    RETURN FALSE;
  END
  IF TRY (type__node_reference?(self)) THEN
    MUTABLE payload: ?Type = TRY (type__node_payload_type(self));
    MUTABLE other_payload: ?Type = TRY (type__node_payload_type(other_type));
    IF (((payload != NIL) AND (other_payload != NIL)) AND (type__resolved(payload) == type__resolved(other_payload))) THEN
      RETURN TRUE;
    END
    IF ((payload != NIL) AND (type__resolved(payload) == type__resolved(other_type))) THEN
      RETURN TRUE;
    END
  END
  IF (TRY (type__string?(self)) AND type__symbol?(self)) THEN
    RETURN (TRY (type__string?(other_type)) AND type__symbol?(other_type));
  END
  IF TRY (type__c_string?(self)) THEN
    IF !(TRY (type__string?(other_type))) THEN
      RETURN FALSE;
    END
    IF TRY (type__c_string?(other_type)) THEN
      RETURN TRUE;
    END
    RETURN type__rodata?(other_type);
  END
  IF (self == other_type) THEN
    RETURN TRUE;
  END
  IF type__optional?(self) THEN
    IF (type__resolved(other_type) == symbol("NIL")) THEN
      RETURN TRUE;
    END
    IF type__optional?(other_type) THEN
      RETURN TRY (type__accepts?((CAST(TRY (type__wrapped_type(self)) AS Type)), CAST(TRY (type__wrapped_type(other_type)) AS Type)));
    END
    RETURN TRY (type__accepts?((CAST(TRY (type__wrapped_type(self)) AS Type)), other_type));
  END
  IF type__error_union?(self) THEN
    IF type__error_union?(other_type) THEN
      RETURN TRY (type__accepts?((CAST(TRY (type__payload_type(self)) AS Type)), CAST(TRY (type__payload_type(other_type)) AS Type)));
    END
    RETURN TRY (type__accepts?((CAST(TRY (type__payload_type(self)) AS Type)), other_type));
  END
  IF (type__numeric?(self) AND type__numeric?(other_type)) THEN
    RETURN TRUE;
  END
  IF (TRY (type__string?(self)) AND ((type__byte?(other_type) OR TRY (type__string?(other_type))))) THEN
    RETURN TRUE;
  END
  IF type__future?(self) THEN
    RETURN TRY (type__accepts_future?(self, other_type));
  END
  IF type__array?(self) THEN
    RETURN TRY (type__accepts_array?(self, other_type));
  END
  IF (type__map?(self) AND type__map?(other_type)) THEN
    IF type__any?((TRY (type__value_type(other_type)))) THEN
      RETURN TRUE;
    END
    RETURN TRY (type__accepts?((TRY (type__value_type(self))), TRY (type__value_type(other_type))));
  END
  IF (((((type__generic_instance?(self) AND type__generic_instance?(other_type)) AND (type__generic_base(self) == type__generic_base(other_type))) AND (type__ownership(self) == type__ownership(other_type))) AND (type__sync(self) == type__sync(other_type))) AND (type__layout(self) == type__layout(other_type))) THEN
    MUTABLE expected_args = TRY (type__generic_args(self));
    MUTABLE actual_args = TRY (type__generic_args(other_type));
    IF !((expected_args.length() == actual_args.length())) THEN
      RETURN FALSE;
    END
    MUTABLE index: Int64 = 0;
    WHILE (index < expected_args.length()) DO
      IF !(TRY (type__accepts?((UNWRAP (expected_args[index])), UNWRAP (actual_args[index])))) THEN
        RETURN FALSE;
      END
      index = (index + 1);
    END
    RETURN TRUE;
  END
  RETURN FALSE;
END
PUB FN type__array_overflow?(self: Type, other_type: Type) RETURNS !?Bool ->
  IF (!(type__array?(other_type)) OR !(type__array?(self))) THEN
    RETURN FALSE;
  END
  IF (type__base_type(self) != type__base_type(other_type)) THEN
    RETURN FALSE;
  END
  IF (!(type__fixed?(other_type)) OR !(type__fixed?(self))) THEN
    RETURN FALSE;
  END
  MUTABLE other_capacity: ?TypeArrayCapacity = type__capacity(other_type);
  MUTABLE self_capacity: ?TypeArrayCapacity = type__capacity(self);
  IF !((type__integer_array_capacity?(other_capacity) AND type__integer_array_capacity?(self_capacity))) THEN
    RETURN FALSE;
  END
  IF (type__array_capacity_integer(other_capacity) > type__array_capacity_integer(self_capacity)) THEN
    RETURN TRUE;
  END
END
PUB FN type__integer_type_max(type_sym: String@symbol) RETURNS ?Int64 ->
  IF (type_sym == :Byte) OR (type_sym == :UInt8) THEN
    RETURN 255;
  ELSE_IF (type_sym == :UInt16) THEN
    RETURN 65535;
  ELSE_IF (type_sym == :UInt32) THEN
    RETURN 4294967295;
  ELSE_IF (type_sym == :UInt64) THEN
    RETURN 9223372036854775807;
  ELSE_IF (type_sym == :Int8) THEN
    RETURN 127;
  ELSE_IF (type_sym == :Int16) THEN
    RETURN 32767;
  ELSE_IF (type_sym == :Int32) THEN
    RETURN 2147483647;
  ELSE_IF (type_sym == :Int64) THEN
    RETURN 9223372036854775807;
  ELSE
    RETURN NIL;
  END
END
PUB FN type__integer_type_min(type_sym: String@symbol) RETURNS ?Int64 ->
  IF (type_sym == :Byte) OR (type_sym == :UInt8) OR (type_sym == :UInt16) OR (type_sym == :UInt32) OR (type_sym == :UInt64) THEN
    RETURN 0;
  ELSE_IF (type_sym == :Int8) THEN
    RETURN -128;
  ELSE_IF (type_sym == :Int16) THEN
    RETURN -32768;
  ELSE_IF (type_sym == :Int32) THEN
    RETURN -2147483648;
  ELSE_IF (type_sym == :Int64) THEN
    RETURN (-9223372036854775807 - 1);
  ELSE
    RETURN NIL;
  END
END
PUB FN type__numeric?(self: Type) RETURNS Bool ->
  RETURN type__numeric_symbol?(type__resolved(self));
END
PUB FN type__integer?(self: Type) RETURNS Bool ->
  RETURN type__integer_symbol?(type__resolved(self));
END
PUB FN type__signed_integer?(self: Type) RETURNS Bool ->
  RETURN type__signed_integer_symbol?(type__resolved(self));
END
PUB FN type__unsigned_integer?(self: Type) RETURNS Bool ->
  RETURN type__unsigned_integer_symbol?(type__resolved(self));
END
PUB FN type__float?(self: Type) RETURNS Bool ->
  RETURN type__float_symbol?(type__resolved(self));
END
PUB FN type__byte?(self: Type) RETURNS Bool ->
  RETURN (type__resolved(self) == :Byte);
END
PUB FN type__void?(self: Type) RETURNS Bool ->
  RETURN (type__resolved(self) == :Void);
END
PUB FN type__catch_snapshot_payload?(self: Type) RETURNS Bool ->
  RETURN (!(type__void?(self)) AND !(type__error_union?(self)));
END
PUB FN type__untyped?(self: Type) RETURNS Bool ->
  RETURN (type__resolved(self) == :Untyped);
END
PUB FN type__auto?(self: Type) RETURNS Bool ->
  RETURN self.shape.auto;
END
PUB FN type__fn_type?(self: Type) RETURNS Bool EFFECTS REENTRANT ->
  RETURN typeShape__fn_type?(self.shape);
END
PUB FN type__function_type(self: Type) RETURNS ?FunctionType ->
  MUTABLE raw_value = type__raw(self);
  IF raw_value IS_A FunctionType AS function_type THEN
    RETURN function_type;
  END
  RETURN NIL;
END
PUB FN type__array?(self: Type) RETURNS Bool ->
  RETURN typeShape__array(self.shape);
END
PUB FN type__rank?(self: Type) RETURNS Bool ->
  MUTABLE kind = type__unwrap_fallible_kind(self.shape.expression.kind);
  IF kind IS_A OptionalTypeExpression THEN
    MUTABLE optional_inner = COPY ((UNWRAP (typeExpressionKind__optional(kind))).inner).kind;
    IF optional_inner IS_A LinearTypeExpression THEN
      kind = COPY optional_inner;
    END
  END
  IF kind IS_A LinearTypeExpression AS rank_linear THEN
    RETURN ((rank_linear.dimensions).length() > 1);
  END
  RETURN FALSE;
END
PUB FN type__rank_dimensions(self: Type) RETURNS ![]TypeExpressionDimension ->
  IF !(type__rank?(self)) THEN
    RETURN CAST(( { MUTABLE rtoc_empty_list_5: []TypeExpressionDimension = List[]; rtoc_empty_list_5 } ) AS []TypeExpressionDimension);
  END
  MUTABLE kind = type__unwrap_optional_kind(type__unwrap_fallible_kind(self.shape.expression.kind));
  RETURN COPY (UNWRAP (typeExpressionKind__linear(kind))).dimensions;
END
PUB FN type__rank(self: Type) RETURNS !Int64 ->
  RETURN (TRY (type__rank_dimensions(self))).length();
END
PUB FN type__dynamic_rank?(self: Type) RETURNS !Bool ->
  RETURN (type__rank?(self) AND ((TRY (type__rank_dimensions(self))) |> ANY ruby_union_scalar_equal_TypeExpressionDimension_String_symbol(_, :LIST)));
