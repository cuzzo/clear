  IF (type__fixed?(self) AND !(type__dynamic?(self))) THEN
    RETURN castOptionalTypeArrayCapacityToOptionalInt64(type__capacity(self));
  END
  RETURN NIL;
END
PUB FN type__fixed_position_type(self: Type, index_value: Int64) RETURNS !?Type ->
  IF type__tuple?(self) THEN
    MUTABLE args = TRY (type__generic_args(self));
    IF (index_value.negative?() OR (index_value >= args.length())) THEN
      RETURN NIL;
    END
    RETURN COPY args[index_value];
  END
  MUTABLE count: ?Int64 = TRY (type__fixed_position_count(self));
  IF (((count == NIL) OR index_value.negative?()) OR (index_value >= count)) THEN
    RETURN NIL;
  END
  RETURN TRY (type__element_type(self));
