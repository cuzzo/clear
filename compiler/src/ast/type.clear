PRIVATE FN type__shared_or_multiowned?(self: Type) RETURNS Bool ->
  RETURN (type__shared?(self) OR type__multiowned?(self));
END
PUB FN type__rc_map?(self: Type) RETURNS Bool ->
  RETURN (type__map?(self) AND type__shared_or_multiowned?(self));
END
PUB FN type__sync_requires_heap_provenance?(self: Type) RETURNS Bool ->
  RETURN (type__any_sync?(self) AND (type__ownership(self) == :affine));
END
PUB FN type__atomic_pointer_wrapped?(self: Type) RETURNS Bool ->
  RETURN (type__atomic?(self) AND ((type__shared_or_multiowned?(self) OR type__indirect?(self))));
END
PUB FN type__map?(self: Type) RETURNS Bool ->
  RETURN typeShape__map(self.shape);
END
PUB FN type__numeric_map?(self: Type) RETURNS !Bool ->
  RETURN (type__map?(self) AND !(TRY (type__string_key_map?(self))));
END
PUB FN type__string_key_map?(self: Type) RETURNS !Bool ->
  RETURN (type__map?(self) AND (((TRY (type__string?((TRY (type__key_type(self))))) OR type__symbol?((TRY (type__key_type(self))))) OR (type__resolved((TRY (type__key_type(self)))) == :Symbol))));
END
PUB FN type__accepts_map_key?(self: Type, actual: Type) RETURNS !Bool ->
  IF !(type__map?(self)) THEN
    RETURN FALSE;
  END
  IF TRY (type__string_key_map?(self)) THEN
    RETURN TRY (type__string?(actual));
  END
  RETURN TRY (type__accepts?((TRY (type__key_type(self))), actual));
END
PUB FN type__plain_numeric_map?(self: Type) RETURNS !Bool ->
  RETURN ((TRY (type__numeric_map?(self)) AND !(type__sharded?(self))) AND !(type__striped?(self)));
END
PUB FN type__key_type(self: Type) RETURNS !Type ->
  MUTABLE kind = type__unwrap_optional_kind(type__unwrap_fallible_kind(self.shape.expression.kind));
  IF kind IS_A MapTypeExpression THEN
    RETURN TRY (type__from_child_expression((UNWRAP (typeExpressionKind__map(kind))).key));
  END
  RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :String }));
