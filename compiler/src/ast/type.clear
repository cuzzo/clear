REQUIRE "pkg:rtoc_6173742f736368656d61732e636c656172"
REQUIRE "pkg:rtoc_6173742f6c657865722e636c656172"
REQUIRE "pkg:rtoc_6173742f7374727563745f6669656c642e636c656172"
REQUIRE "pkg:rtoc_6173742f747970655f6361706162696c69746965732e636c656172"
REQUIRE "pkg:rtoc_6173742f747970655f65787072657373696f6e2e636c656172"
REQUIRE "pkg:rtoc_616e6e6f7461746f722f68656c706572732f66756e6374696f6e5f7369676e61747572652e636c656172"
REQUIRE "pkg:rtoc_6261636b656e64732f747970655f7a69675f72656e64657265722e636c656172"
REQUIRE "pkg:rtoc_6261636b656e64732f7a69675f747970652e636c656172"
EXTERN STRUCT CompilerRegex {} FROM "compiler_regex";
EXTERN FN compilerRegexCompile(pattern: String) RETURNS CompilerRegex EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexReplaceAll(subject: String, regex: CompilerRegex, replacement: String) RETURNS String EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexReplaceFirst(subject: String, regex: CompilerRegex, replacement: String) RETURNS String EFFECTS :safe FROM "compiler_regex";
FN regexReplaceAll(subject: String, pattern: String, replacement: String) RETURNS String ->
  RETURN compilerRegexReplaceAll(subject, compilerRegexCompile(pattern), replacement);
END
FN regexReplaceFirst(subject: String, pattern: String, replacement: String) RETURNS String ->
  RETURN compilerRegexReplaceFirst(subject, compilerRegexCompile(pattern), replacement);
END

PUB UNION Input { SymbolValue: String@symbol, Type: Type }
UNION Schema { StructSchemaMultiowned: StructSchema@multiowned, ResourceSchemaMultiowned: ResourceSchema@multiowned, StructSchema: StructSchema, ResourceSchema: ResourceSchema }
STRUCT TypePlacementUnset {

}
STRUCT TypePlacement {
  provenance: ?String@symbol
}

PUB UNION TypePlacementMaybeSymbol { TypePlacementUnset: TypePlacementUnset, SymbolValue: String@symbol }
FN typePlacement__with(self: TypePlacement, provenance: ?TypePlacementMaybeSymbol = TypePlacementMaybeSymbol{ TypePlacementUnset: COPY TypePlacementUnset{} }) RETURNS TypePlacement ->
  MUTABLE next_provenance: ?String@symbol = NIL;
  IF ((provenance != NIL) AND (provenance IS_A TypePlacementUnset)) THEN
    next_provenance = COPY self.provenance;
  ELSE
    next_provenance = COPY castOptionalTypePlacementMaybeSymbolToOptionalStringSymbol(provenance);
  END
  RETURN TypePlacement{ provenance: COPY next_provenance };
END
FN typePlacement__location(self: TypePlacement) RETURNS ?String@symbol ->
  RETURN self.provenance;
END
FN typePlacement__copy(self: TypePlacement) RETURNS TypePlacement ->
  RETURN typePlacement__with(self);
END
FN typePlacement__heap?(self: TypePlacement) RETURNS Bool ->
  RETURN (self.provenance == :heap);
END
FN typePlacement__frame?(self: TypePlacement) RETURNS Bool ->
  RETURN (self.provenance == :frame);
END
FN typePlacement__rodata?(self: TypePlacement) RETURNS Bool ->
  RETURN (self.provenance == :rodata);
END
FN typePlacement__alloc(self: TypePlacement) RETURNS ?String@symbol ->
  IF (self.provenance == :heap) THEN
    RETURN :heap;
  ELSE_IF (self.provenance == :frame) THEN
    RETURN :frame;
  ELSE
    RETURN NIL;
  END
END
PUB FN type__capacity_text(capacity: ?TypeArrayCapacity) RETURNS String ->
  IF capacity EXISTS AS present THEN
    IF present IS_A String@symbol AS string_symbol THEN
      RETURN "${string_symbol}";
    ELSE_IF present IS_A Int64 AS count THEN
      RETURN count.toString();
    END
  END
  RETURN "";
END
PUB UNION TypeSourceSignature { Unset: Bool }
PUB UNION TypeArrayCapacity { Int64Value: Int64, SymbolValue: String@symbol }
PUB STRUCT FunctionTypeParam {
  type: Type
}
PUB STRUCT FunctionType {
  params: []FunctionTypeParam,
  # Breaks the Type -> TypeShape -> TypeShapeRaw -> FunctionType -> Type cycle
  # with one indirection, the same way TypeExpression boxes its kind.
  return_type: Type@boxed,
  reentrant: Bool,
  source_signature: ?TypeSourceSignature,
  abi: String@symbol
}
FN type__function_type_expression_for(signature: FunctionType) RETURNS TypeExpressionKind ->
  RETURN TypeExpressionKind{ FunctionTypeExpression: COPY FunctionTypeExpression{ signature: COPY FunctionSignatureExpression{ params: COPY signature.params |> SELECT FunctionParamExpression{ expression: COPY _.type.shape.expression }, return_expression: COPY signature.return_type.shape.expression, reentrant: signature.reentrant, abi: COPY signature.abi, semantic_payload: NIL } } };
END
FN type__function_type_for_expression(expression: FunctionTypeExpression) RETURNS !FunctionType EFFECTS REENTRANT ->
  MUTABLE fn_params = expression.signature.params |> SELECT FunctionTypeParam{ type: COPY TRY (type__new(TypeConstructionInput{ TypeExpression: COPY _.expression })) };
  RETURN FunctionType{ params: COPY fn_params, return_type: COPY TRY (type__new(TypeConstructionInput{ TypeExpression: COPY expression.signature.return_expression })), reentrant: expression.signature.reentrant, abi: COPY expression.signature.abi, source_signature: NIL };
END
FN type__unwrap_fallible_kind(kind: TypeExpressionKind) RETURNS TypeExpressionKind ->
  IF !(kind IS_A FallibleTypeExpression) THEN
    RETURN COPY kind;
  END
  IF kind IS_A FallibleTypeExpression AS fallible THEN
    RETURN COPY typeExpressionTree__unbox(fallible.inner).kind;
  END
  panic("expected a fallible type expression");
END
FN type__unwrap_optional_kind(kind: TypeExpressionKind) RETURNS TypeExpressionKind ->
  IF !(kind IS_A OptionalTypeExpression) THEN
    RETURN COPY kind;
  END
  RETURN COPY ((UNWRAP (typeExpressionKind__optional(kind))).inner).kind;
END
PUB STRUCT TypeShape {
  auto: Bool,
  expression: TypeExpression,
  legacy_raw: TypeShapeRaw,
  semantic_key_value: String
}

PUB UNION TypeShapeRaw { FunctionType: FunctionType, SymbolValue: String@symbol, StringValue: String }
FN typeShape__from_raw(raw: TypeShapeRaw, auto: Bool = FALSE, expression: ?TypeExpression = NIL, optional: Bool = FALSE, wrapped_type_raw: ?String@symbol = NIL, wrapped_function_type_raw: ?FunctionType = NIL) RETURNS !TypeShape EFFECTS REENTRANT ->
  MUTABLE parsed: TypeExpression = (expression OR_ELSE ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_1: ?TypeExpression = NIL;
  IF raw IS_A FunctionType THEN
    rtoc_ternary_value_1 = typeExpression__of(type__function_type_expression_for(castTypeShapeRawToFunctionType(raw)));
  ELSE
    rtoc_ternary_value_1 = TRY (typeExpressionParser__parse(castTypeShapeRawToRaw(raw)));
  END
  rtoc_ternary_value_1? }));
  IF optional THEN
    IF wrapped_function_type_raw EXISTS AS wrapped_function_type_raw_value THEN
      parsed = typeExpression__of(TypeExpressionKind{ OptionalTypeExpression: COPY OptionalTypeExpression{ inner: COPY typeExpression__of(type__function_type_expression_for(wrapped_function_type_raw_value)) } });
    ELSE
    IF wrapped_type_raw EXISTS AS wrapped_type_raw_value THEN
        parsed = typeExpression__of(TypeExpressionKind{ OptionalTypeExpression: COPY OptionalTypeExpression{ inner: COPY TRY (typeExpressionParser__parse(Raw{ SymbolValue: COPY wrapped_type_raw_value })) } });
    END
    END
  END
  RETURN TypeShape{ auto: COPY auto, expression: COPY parsed, legacy_raw: COPY TRY (typeShape__render_legacy_raw(parsed)), semantic_key_value: COPY TRY (typeExpressionPrinter__semantic(parsed)) };
END
FN typeShape__from_core(core_str: String, auto: Bool = FALSE) RETURNS !TypeShape EFFECTS REENTRANT ->
  MUTABLE shape = TRY (typeShape__from_raw(TypeShapeRaw{ SymbolValue: COPY symbol(core_str) }, auto));
  RETURN shape;
END
FN typeShape__copy(self: TypeShape) RETURNS TypeShape ->
  RETURN COPY self;
END
FN typeShape__copy_with_auto(self: TypeShape, auto_value: Bool) RETURNS !TypeShape EFFECTS REENTRANT ->
  IF (auto_value == self.auto) THEN
    RETURN COPY self;
  END
  RETURN TRY (typeShape__from_raw(typeShape__raw(self), auto_value, self.expression));
END
PUB FN typeShape__with_expression(self: TypeShape, next_expression: TypeExpression) RETURNS !TypeShape EFFECTS REENTRANT ->
  RETURN TRY (typeShape__from_raw(TypeShapeRaw{ SymbolValue: :Any }, self.auto, next_expression));
END
FN typeShape__raw(self: TypeShape) RETURNS TypeShapeRaw ->
  RETURN COPY self.legacy_raw;
END
FN typeShape__semantic_key(self: TypeShape) RETURNS String ->
  RETURN COPY self.semantic_key_value;
END
PRIVATE FN typeShape__render_legacy_raw(current: TypeExpression) RETURNS !TypeShapeRaw EFFECTS REENTRANT ->
  MUTABLE current_kind = COPY current.kind;
  IF current_kind IS_A FunctionTypeExpression AS current_fn_kind THEN
    RETURN TypeShapeRaw{ FunctionType: COPY TRY (type__function_type_for_expression(current_fn_kind)) };
  END
  MUTABLE root_caps = typeExpressionTree__root_capabilities(current);
  MUTABLE shape_only = typeExpressionTree__with_root_capabilities(current, typeCapabilities__new(:affine, FALSE, NIL, NIL, NIL, root_caps.collection));
  RETURN TypeShapeRaw{ SymbolValue: COPY symbol((TRY (typeExpressionPrinter__legacy(shape_only)))) };
END
FN typeShape__resolved(self: TypeShape) RETURNS String@symbol ->
  MUTABLE raw_value = typeShape__raw(self);
  IF raw_value IS_A FunctionType AS function_type THEN
    RETURN :Any;
  END
  IF raw_value IS_A String@symbol AS string_symbol THEN
    RETURN CAST(string_symbol AS String@symbol);
  END
  RETURN symbol(castTypeShapeRawToString(raw_value));
END
FN typeShape__fn_type?(self: TypeShape) RETURNS Bool ->
  RETURN self.expression.kind IS_A FunctionTypeExpression;
END
FN typeShape__array(self: TypeShape) RETURNS Bool ->
  RETURN !((typeShape__linear_expression(self) == NIL));
END
FN typeShape__map(self: TypeShape) RETURNS Bool ->
  RETURN typeShape__structural_expression(self).kind IS_A MapTypeExpression;
END
FN typeShape__optional(self: TypeShape) RETURNS Bool ->
  MUTABLE current = COPY self.expression;
  MUTABLE current_kind = COPY current.kind;
  IF current_kind IS_A FallibleTypeExpression AS fallible THEN
    current = typeExpressionTree__unbox(fallible.inner);
  END
  MUTABLE kind = COPY current.kind;
  IF kind IS_A OptionalTypeExpression THEN
    RETURN TRUE;
  END
  IF kind IS_A LinearTypeExpression AS linear_kind THEN
    RETURN typeExpressionTree__kind_of(typeExpressionTree__unbox(linear_kind.item)) IS_A OptionalTypeExpression;
  END
  RETURN FALSE;
END
FN typeShape__error_union(self: TypeShape) RETURNS Bool ->
  RETURN self.expression.kind IS_A FallibleTypeExpression;
END
FN typeShape__tense(self: TypeShape) RETURNS Bool ->
  MUTABLE kind = COPY self.expression.kind;
  RETURN (kind IS_A FutureTypeExpression OR kind IS_A StreamTypeExpression);
END
FN typeShape__generic_instance(self: TypeShape) RETURNS Bool ->
  MUTABLE structural = COPY typeShape__structural_expression(self).kind;
  IF structural IS_A TupleTypeExpression THEN
    RETURN TRUE;
  END
  IF !(structural IS_A NamedTypeExpression) THEN
    RETURN FALSE;
  END
  RETURN !((((UNWRAP (typeExpressionKind__named(structural))).arguments).length() == 0));
END
FN typeShape__capacity(self: TypeShape) RETURNS ?TypeArrayCapacity ->
  MUTABLE linear: ?LinearTypeExpression = typeShape__linear_expression(self);
  IF linear EXISTS AS linear_value THEN
    IF (linear_value.dimensions.length() > 1) THEN
      IF !(linear_value.dimensions |> ALL _ IS_A Int64) THEN
        RETURN NIL;
      END
      RETURN linear_value.dimensions |> REDUCE(1) (acc * castOptionalTypeExpressionDimensionToInt64(_));
    END
    MUTABLE dimension: ?TypeExpressionDimension = COPY linear_value.dimensions.last();
    IF ruby_union_scalar_equal_optional_TypeExpressionDimension_String_symbol(dimension, :LIST) THEN
      RETURN NIL;
    ELSE
      RETURN COPY castOptionalTypeExpressionDimensionToOptionalTypeArrayCapacity(dimension);
    END
  ELSE
    RETURN NIL;
  END
END
FN typeShape__allocation_hint(self: TypeShape) RETURNS ?Int64 EFFECTS REENTRANT ->
  IF typeShape__linear_expression(self) != NIL THEN
  RETURN ((typeShape__linear_expression(self))?).allocation_hint;
  ELSE
  RETURN NIL;
  END
END
FN typeShape__payload_type_raw(self: TypeShape) RETURNS !?String@symbol ->
  MUTABLE kind = COPY self.expression.kind;
  IF !(kind IS_A FallibleTypeExpression) THEN
    RETURN NIL;
  END
  IF kind IS_A FallibleTypeExpression AS fallible THEN
    RETURN symbol((TRY (typeExpressionPrinter__legacy(typeExpressionTree__unbox(fallible.inner)))));
  END
  panic("expected a fallible type expression");
END
FN typeShape__wrapped_type_raw(self: TypeShape) RETURNS !?String@symbol ->
  MUTABLE kind = COPY self.expression.kind;
  IF !(kind IS_A OptionalTypeExpression) THEN
    RETURN NIL;
  END
  MUTABLE optional_kind: OptionalTypeExpression = UNWRAP (typeExpressionKind__optional(kind));
  IF optional_kind.inner.kind IS_A FunctionTypeExpression THEN
    RETURN NIL;
  END
  RETURN symbol((TRY (typeExpressionPrinter__legacy(optional_kind.inner))));
END
FN typeShape__wrapped_function_type_raw(self: TypeShape) RETURNS !?FunctionType ->
  MUTABLE kind = COPY self.expression.kind;
  IF !(kind IS_A OptionalTypeExpression) THEN
    RETURN NIL;
  END
  MUTABLE inner_kind = COPY ((UNWRAP (typeExpressionKind__optional(kind))).inner).kind;
  IF !(inner_kind IS_A FunctionTypeExpression) THEN
    RETURN NIL;
  END
  IF inner_kind IS_A FunctionTypeExpression AS inner_fn_kind THEN
    RETURN TRY (type__function_type_for_expression(inner_fn_kind));
  END
  panic("expected a function type expression");
END
FN typeShape__element_type_raw(self: TypeShape) RETURNS !?String@symbol ->
  MUTABLE linear: ?LinearTypeExpression = typeShape__linear_expression(self);
  IF linear EXISTS AS linear_value THEN
    MUTABLE item = COPY linear_value.item;
    MUTABLE item_kind = COPY item.kind;
    IF item_kind IS_A OptionalTypeExpression THEN
      item = COPY (UNWRAP (typeExpressionKind__optional(item_kind))).inner;
    END
    RETURN symbol((TRY (typeExpressionPrinter__legacy(item))));
  ELSE
    RETURN NIL;
  END
END
FN typeShape__key_type_raw(self: TypeShape) RETURNS !?String@symbol ->
  MUTABLE structural = COPY typeShape__structural_expression(self).kind;
  IF !(structural IS_A MapTypeExpression) THEN
    RETURN NIL;
  END
  RETURN symbol((TRY (typeExpressionPrinter__legacy((UNWRAP (typeExpressionKind__map(structural))).key))));
END
FN typeShape__value_type_raw(self: TypeShape) RETURNS !?String@symbol ->
  MUTABLE structural = COPY typeShape__structural_expression(self).kind;
  IF !(structural IS_A MapTypeExpression) THEN
    RETURN NIL;
  END
  RETURN symbol((TRY (typeExpressionPrinter__legacy((UNWRAP (typeExpressionKind__map(structural))).value))));
END
FN typeShape__generic_base_raw(self: TypeShape) RETURNS ?String@symbol ->
  MUTABLE structural = COPY typeShape__structural_expression(self).kind;
  IF structural IS_A TupleTypeExpression THEN
    RETURN :Tuple;
  END
  IF structural IS_A NamedTypeExpression THEN
    MUTABLE named: NamedTypeExpression = UNWRAP (typeExpressionKind__named(structural));
    IF !((named.arguments.length() == 0)) THEN
      RETURN named.name;
    END
  END
  RETURN NIL;
END
FN typeShape__generic_args_raw(self: TypeShape) RETURNS ![]String@symbol ->
  MUTABLE structural = COPY typeShape__structural_expression(self).kind;
  MUTABLE items: []TypeExpression = ( { MUTABLE rtoc_empty_list_2: []TypeExpression = List[]; rtoc_empty_list_2 } );
  IF structural IS_A TupleTypeExpression THEN
    FOR _ IN ((UNWRAP (typeExpressionKind__tuple(structural))).items) DO
    &items.append(COPY _);
    END
  ELSE_IF structural IS_A NamedTypeExpression THEN
    FOR _ IN ((UNWRAP (typeExpressionKind__named(structural))).arguments) DO
    &items.append(COPY _);
    END
  END
  RETURN items |> SELECT symbol((TRY (typeExpressionPrinter__legacy(_))));
END
FN typeShape__tense_type_raw(self: TypeShape) RETURNS !?String@symbol ->
  MUTABLE kind = COPY self.expression.kind;
  IF kind IS_A StreamTypeExpression THEN
    MUTABLE stream_kind: StreamTypeExpression = UNWRAP (typeExpressionKind__stream(kind));
    MUTABLE dimension_branch_value: ?TypeExpressionDimension = NIL;
    IF ruby_union_scalar_equal_TypeExpressionDimension_String_symbol(stream_kind.cardinality, :FINITE) THEN
      dimension_branch_value = TypeExpressionDimension{ SymbolValue: :LIST };
    ELSE
      dimension_branch_value = COPY stream_kind.cardinality;
    END
    MUTABLE dimension: TypeExpressionDimension = dimension_branch_value?;
    MUTABLE linear = typeExpression__of(TypeExpressionKind{ LinearTypeExpression: COPY LinearTypeExpression{ kind: :array, dimensions: [dimension], item: COPY stream_kind.item, allocation_hint: NIL } });
    RETURN symbol((TRY (typeExpressionPrinter__legacy(linear))));
  END
  IF !(kind IS_A FutureTypeExpression) THEN
    RETURN NIL;
  END
  RETURN symbol((TRY (typeExpressionPrinter__legacy((UNWRAP (typeExpressionKind__future(kind))).inner))));
END
FN typeShape__numeric_map?(self: TypeShape) RETURNS !Bool ->
  RETURN (typeShape__map(self) AND (TRY (typeShape__key_type_raw(self)) != :String));
END
PRIVATE FN typeShape__linear_expression(self: TypeShape) RETURNS ?LinearTypeExpression ->
  MUTABLE structural = COPY typeShape__structural_expression(self).kind;
  IF structural IS_A LinearTypeExpression AS structural_linear THEN
    RETURN COPY structural_linear;
  END
  RETURN NIL;
END
PRIVATE FN typeShape__structural_expression(self: TypeShape) RETURNS TypeExpression ->
  MUTABLE structural: TypeExpression = COPY self.expression;
  MUTABLE fallible_kind = COPY structural.kind;
  IF fallible_kind IS_A FallibleTypeExpression AS fallible_structural THEN
    structural = typeExpressionTree__unbox(fallible_structural.inner);
  END
  MUTABLE optional_kind = COPY structural.kind;
  IF optional_kind IS_A OptionalTypeExpression THEN
    MUTABLE optional_expression: OptionalTypeExpression = UNWRAP (typeExpressionKind__optional(optional_kind));
    IF !(optional_expression.inner.kind IS_A LinearTypeExpression) THEN
      structural = typeExpressionTree__unbox(optional_expression.inner);
    END
  END
  RETURN structural;
END
STRUCT TypeFsmForEachDescriptor {
  kind: String@symbol,
  var_zig_type: String,
  init_method: ?String,
  advance_method: ?String,
  deref: Bool,
  slice_suffix: String
}
STRUCT TypeId {
  key: String
}

FN typeId__to_s(self: TypeId) RETURNS String ->
  RETURN COPY self.key;
END
PUB STRUCT Type {
  auto_token: ?Token,
  capabilities: TypeCapabilities,
  generic_payload_type_arg: Bool,
  is_resource: ?Bool,
  placement: TypePlacement,
  shape: TypeShape
}

PUB UNION TypeTypeInput { FunctionType: FunctionType, Type: Type, SymbolValue: String@symbol, StringValue: String }
PUB UNION TypeConstructionInput { FunctionType: FunctionType, Type: Type, SymbolValue: String@symbol, StringValue: String, TypeExpression: TypeExpression }
UNION TypeRawParseInput { FunctionType: FunctionType, SymbolValue: String@symbol, StringValue: String }
STRUCT ObservablePublishSpec {
  publish_method: String,
  expr: String@symbol,
  gate: String@symbol
}
STRUCT ObservableTerminalSpec {
  ast_class: ?String@symbol,
  publish: ?ObservablePublishSpec
}
equality_ops = [:EQ, :NEQ];
ordering_ops = [:LT, :GT, :LTE, :GTE];
logical_ops = [symbol("AND"), symbol("OR")];
bitwise_ops = [symbol("XOR"), symbol("BIT_AND"), symbol("BIT_OR")];
shift_ops = [:SHL, :SHR];
number_result_ops = [:SUB, :MUL, :DIV, :POW, symbol("MOD"), :WRAP_SUB, :WRAP_MUL, :CHECK_SUB, :CHECK_MUL];
signed_int_types = [:Int8, :Int16, :Int32, :Int64, :TargetInt, :TargetLong, :TargetLongLong];
unsigned_int_types = [:UInt8, :Byte, :UInt16, :UInt32, :UInt64, :TargetUInt, :TargetULong, :TargetULongLong];
float_types = [:Float32, :Float64];
PUB UNION TypeSchemaLookupResult { EnumSchemaMultiowned: EnumSchema@multiowned, StructSchemaMultiowned: StructSchema@multiowned, UnionSchemaMultiowned: UnionSchema@multiowned, ResourceSchemaMultiowned: ResourceSchema@multiowned }
PUB FN type__indirect_type?(value: Type) RETURNS Bool ->
  IF !(TRUE) THEN
    RETURN FALSE;
  END
  RETURN (type__indirect?(value) == TRUE);
END
PUB FN type__from_input(type: TypeTypeInput) RETURNS !Type ->
  IF type IS_A Type AS type_as_type THEN
    RETURN TRY (type__copy_type(type_as_type));
  ELSE_IF type IS_A FunctionType AS function_type THEN
    RETURN TRY (type__new(TypeConstructionInput{ FunctionType: COPY function_type }));
  ELSE_IF type IS_A String@symbol AS string_symbol THEN
    RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: COPY string_symbol }));
  ELSE_IF type IS_A String AS string THEN
    RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY string }));
  END
  RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }));
END
PUB FN type__from_child_expression(expression: TypeExpression) RETURNS !Type ->
  RETURN TRY (type__new(TypeConstructionInput{ TypeExpression: COPY expression }));
END
PUB FN type__from_variant_input(vt: ?SchemasUnionSchemaVariantValue) RETURNS !Type ->
  IF vt EXISTS AS vt_value THEN
    IF vt_value IS_A InlineStructVariant AS inline_struct_variant THEN
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }));
    END
    RETURN TRY (type__from_input(castSchemasUnionSchemaVariantValueToTypeTypeInput(vt_value)));
  ELSE
    RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }));
  END
END
PUB FN type__capability_symbol(value: ?String@symbol) RETURNS ?TypeCapabilitiesMaybeSymbol ->
  RETURN ruby_wrap_optional_String_symbol_TypeCapabilitiesMaybeSymbol(value);
END
PUB FN type__capability_symbol_or_unset(value: ?String@symbol) RETURNS ?TypeCapabilitiesMaybeSymbol ->
  IF value EXISTS AS value_value THEN
    RETURN TypeCapabilitiesMaybeSymbol{ SymbolValue: COPY value_value };
  ELSE
    RETURN TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} };
  END
END
PUB FN type__capability_integer(value: ?Int64) RETURNS ?TypeCapabilitiesMaybeInteger ->
  RETURN COPY ruby_wrap_optional_Int64_TypeCapabilitiesMaybeInteger(value);
END
PUB FN type__capability_integer_or_unset(value: ?Int64) RETURNS ?TypeCapabilitiesMaybeInteger ->
  IF value EXISTS AS value_value THEN
    RETURN COPY TypeCapabilitiesMaybeInteger{ Int64Value: value_value };
  ELSE
    RETURN TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} };
  END
END
PUB FN type__capability_token(value: ?Token) RETURNS ?TypeCapabilitiesMaybeToken ->
  RETURN COPY ruby_wrap_optional_Token_TypeCapabilitiesMaybeToken(value);
END
PUB FN type__capability_token_or_unset(value: ?Token) RETURNS ?TypeCapabilitiesMaybeToken ->
  IF value EXISTS AS value_value THEN
    RETURN COPY TypeCapabilitiesMaybeToken{ TokenMultiowned: COPY value_value };
  ELSE
    RETURN TypeCapabilitiesMaybeToken{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} };
  END
END
PUB FN type__placement_symbol(value: ?String@symbol) RETURNS ?TypePlacementMaybeSymbol ->
  RETURN ruby_wrap_optional_String_symbol_TypePlacementMaybeSymbol(value);
END
PUB FN type__placement_symbol_or_unset(value: ?String@symbol) RETURNS ?TypePlacementMaybeSymbol ->
  IF value EXISTS AS value_value THEN
    RETURN TypePlacementMaybeSymbol{ SymbolValue: COPY value_value };
  ELSE
    RETURN TypePlacementMaybeSymbol{ TypePlacementUnset: COPY TypePlacementUnset{} };
  END
END
PUB FN type__prefer_legacy_element_capability(candidate: ?TypeCapabilitiesMaybeSymbol, legacy: ?String@symbol) RETURNS ?TypeCapabilitiesMaybeSymbol ->
  IF (((candidate != NIL) AND (candidate IS_A TypeCapabilityUnset)) AND !((legacy == NIL))) THEN
    RETURN ruby_wrap_optional_String_symbol_TypeCapabilitiesMaybeSymbol(legacy);
  END
  RETURN COPY candidate;
END
PUB FN type__root_element_capability(item_updated: Bool, candidate: ?TypeCapabilitiesMaybeSymbol) RETURNS ?TypeCapabilitiesMaybeSymbol ->
  IF item_updated THEN
    RETURN NIL;
  END
  RETURN COPY candidate;
END
PUB FN type__capability_observable_or_unset(value: ?Bool) RETURNS TypeCapabilitiesMaybeBoolean ->
  IF (value == TRUE) THEN
    RETURN TypeCapabilitiesMaybeBoolean{ BoolValue: TRUE };
  END
  RETURN TypeCapabilitiesMaybeBoolean{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} };
END
PUB FN type__capability_boolean_or_unset(value: Bool) RETURNS TypeCapabilitiesMaybeBoolean ->
  IF value THEN
    RETURN TypeCapabilitiesMaybeBoolean{ BoolValue: TRUE };
  END
  RETURN TypeCapabilitiesMaybeBoolean{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} };
END
PUB FN type__function_return_symbol(fn_value: FunctionType) RETURNS String@symbol EFFECTS REENTRANT ->
  RETURN type__to_sym(fn_value.return_type);
END
PUB FN type__integer_string(value: Int64) RETURNS String ->
  RETURN COPY value.toString();
END
PUB FN type__symbol_or_any(value: ?String@symbol) RETURNS String@symbol ->
  RETURN type__symbol_or_default(value, :Any);
END
PUB FN type__symbol_or_default(value: ?String@symbol, default_value: String@symbol) RETURNS String@symbol ->
  IF value EXISTS AS value_value THEN
    RETURN COPY value_value;
  ELSE
    RETURN default_value;
  END
END
PUB FN type__type_input_symbol_or_default(value: ?String@symbol, default_value: String@symbol) RETURNS TypeTypeInput ->
  RETURN TypeTypeInput{ SymbolValue: COPY type__symbol_or_default(value, default_value) };
END
PUB FN type__type_input_symbol_or_any(value: ?String@symbol) RETURNS TypeTypeInput ->
  RETURN type__type_input_symbol_or_default(value, :Any);
END
PUB FN type__type_input_string(value: String) RETURNS TypeTypeInput ->
  RETURN COPY TypeTypeInput{ StringValue: COPY value };
END
PUB FN type__integer_array_capacity?(capacity: ?TypeArrayCapacity) RETURNS Bool ->
  IF capacity EXISTS AS capacity_value THEN
    RETURN capacity_value IS_A Int64;
  ELSE
    RETURN FALSE;
  END
END
PUB FN type__array_capacity_integer(capacity: ?TypeArrayCapacity) RETURNS Int64 ->
  RETURN COPY castOptionalTypeArrayCapacityToInt64(capacity);
END
PUB FN type__array_capacity_symbol(capacity: ?TypeArrayCapacity) RETURNS ?String@symbol ->
  IF capacity EXISTS AS capacity_value THEN
    MUTABLE cap = COPY capacity_value;
    IF cap IS_A String@symbol AS string_symbol THEN
      RETURN string_symbol;
    END
    RETURN NIL;
  ELSE
    RETURN NIL;
  END
END
PUB FN type__preallocation_expression?(expression: TypeExpression) RETURNS Bool ->
  MUTABLE kind = COPY expression.kind;
  IF !(kind IS_A LinearTypeExpression) THEN
    RETURN FALSE;
  END
  IF kind IS_A LinearTypeExpression AS linear_kind THEN
    RETURN (((linearTypeExpression__list?(linear_kind) OR linearTypeExpression__set?(linear_kind))) AND !((linear_kind.allocation_hint == NIL)));
  END
  RETURN FALSE;
END
PUB FN type__signed_integer_symbol?(value: String@symbol) RETURNS Bool ->
  RETURN (((((((value == :Int8) OR (value == :Int16)) OR (value == :Int32)) OR (value == :Int64)) OR (value == :TargetInt)) OR (value == :TargetLong)) OR (value == :TargetLongLong));
END
PUB FN type__unsigned_integer_symbol?(value: String@symbol) RETURNS Bool ->
  RETURN ((((((((value == :UInt8) OR (value == :Byte)) OR (value == :UInt16)) OR (value == :UInt32)) OR (value == :UInt64)) OR (value == :TargetUInt)) OR (value == :TargetULong)) OR (value == :TargetULongLong));
END
PUB FN type__integer_symbol?(value: String@symbol) RETURNS Bool ->
  RETURN (type__signed_integer_symbol?(value) OR type__unsigned_integer_symbol?(value));
END
PUB FN type__float_symbol?(value: String@symbol) RETURNS Bool ->
  RETURN ((value == :Float32) OR (value == :Float64));
END
PUB FN type__numeric_symbol?(value: String@symbol) RETURNS Bool ->
  RETURN (type__integer_symbol?(value) OR type__float_symbol?(value));
END
PUB FN type__primitive_symbol?(value: String@symbol) RETURNS Bool ->
  RETURN (((value == :Number) OR (value == :Bool)) OR type__numeric_symbol?(value));
END
PUB FN type__resource_type_symbol?(value: String@symbol) RETURNS Bool ->
  RETURN (((value == :File) OR (value == :TCPClient)) OR (value == :TCPServer));
END
PUB FN type__ownership_surface_name_for(value: String@symbol) RETURNS ?String EFFECTS REENTRANT ->
  RETURN typeCapabilities__ownership_surface_name_for(value);
END
PUB FN type__sync_surface_name_for(value: String@symbol) RETURNS ?String EFFECTS REENTRANT ->
  RETURN typeCapabilities__sync_surface_name_for(value);
END
PUB FN type__sync_family_name_for(value: String@symbol) RETURNS ?String ->
  IF (value == :locked) THEN
    RETURN "locked";
  END
  IF (value == :write_locked) THEN
    RETURN "writeLocked";
  END
  IF (value == :versioned) THEN
    RETURN "versioned";
  END
  IF (value == :atomic) THEN
    RETURN "atomic";
  END
  IF (value == :always_mutable) THEN
    RETURN "alwaysMutable";
  END
  IF (value == :local) THEN
    RETURN "local";
  END
  RETURN NIL;
END
PUB FN type__zig_type_name_for(value: String@symbol) RETURNS String ->
  IF (value == :Float64) THEN
    RETURN "f64";
  END
  IF (value == :Int64) THEN
    RETURN "i64";
  END
  IF (value == :String) THEN
    RETURN "[]const u8";
  END
  IF (value == :Void) THEN
    RETURN "void";
  END
  IF (value == :Bool) THEN
    RETURN "bool";
  END
  IF (value == :Byte) THEN
    RETURN "u8";
  END
  IF (value == :Int8) THEN
    RETURN "i8";
  END
  IF (value == :Int16) THEN
    RETURN "i16";
  END
  IF (value == :Int32) THEN
    RETURN "i32";
  END
  IF (value == :UInt8) THEN
    RETURN "u8";
  END
  IF (value == :UInt16) THEN
    RETURN "u16";
  END
  IF (value == :UInt32) THEN
    RETURN "u32";
  END
  IF (value == :UInt64) THEN
    RETURN "u64";
  END
  IF (value == :Float32) THEN
    RETURN "f32";
  END
  IF (value == :TargetInt) THEN
    RETURN "c_int";
  END
  IF (value == :TargetUInt) THEN
    RETURN "c_uint";
  END
  IF (value == :TargetLong) THEN
    RETURN "c_long";
  END
  IF (value == :TargetULong) THEN
    RETURN "c_ulong";
  END
  IF (value == :TargetLongLong) THEN
    RETURN "c_longlong";
  END
  IF (value == :TargetULongLong) THEN
    RETURN "c_ulonglong";
  END
  IF (value == :Any) THEN
    RETURN "f64";
  END
  IF (value == :Range) THEN
    RETURN "CheatLib.Range";
  END
  IF (value == :File) THEN
    RETURN "CheatLib.File";
  END
  IF (value == :TCPServer) THEN
    RETURN "i32";
  END
  IF (value == :TCPClient) THEN
    RETURN "i32";
  END
  RETURN COPY CAST(value AS String);
END
PUB FN type__deinit_resource_close_plan() RETURNS ResourceClosePlan ->
  RETURN ResourceClosePlan{ actions: [ResourceCloseAction{ call_kind: COPY ResourceCloseCallKind.Method, name: "deinit", runtime_heap_alloc_args: 0, field_path: List[] }] };
END
PUB FN type__copy_type(type: Type) RETURNS !Type ->
  MUTABLE copy = TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }));
  type__replace_shape_mut(&copy, typeShape__copy(type.shape));
  type__replace_capabilities_mut(&copy, typeCapabilities__copy(type.capabilities));
  type__replace_placement_mut(&copy, typePlacement__copy(type.placement));
  RETURN copy;
END
PUB FN type__surface_name(type: TypeTypeInput) RETURNS !String EFFECTS REENTRANT ->
  RETURN TRY (type__surface_name_type(TRY (type__from_input(type))));
END
PUB FN type__inline_migration_name(type: Type) RETURNS !?String ->
  MUTABLE caps = COPY type.capabilities;
  IF !(typeCapabilities__inline_migration_safe?(caps)) THEN
    RETURN NIL;
  END
  MUTABLE expression = COPY type.shape.expression;
  IF expression.kind IS_A FunctionTypeExpression THEN
    RETURN NIL;
  END
  IF (TRY (typeExpressionTree__each_node(expression))) |> ANY _.kind IS_A FutureTypeExpression THEN
    RETURN NIL;
  END
  IF (TRY (typeExpressionTree__each_node(expression))) |> ANY type__unsafe_inline_linear_migration?(_, type) THEN
    RETURN NIL;
  END
  IF (typeExpressionTree__tense_wrapper?(expression) AND typeCapabilities__explicit_layer_capability?(expression.capabilities)) THEN
    RETURN NIL;
  END
  MUTABLE projected: ?TypeExpression = type__project_inline_collection(expression, type);
  IF projected EXISTS AS projected_value THEN
    RETURN TRY (typeExpressionPrinter__inline(projected_value));
  ELSE
    RETURN NIL;
  END
END
PUB FN type__unsafe_inline_linear_migration?(node: TypeExpression, type: Type) RETURNS Bool ->
  MUTABLE kind = COPY node.kind;
  IF !(kind IS_A LinearTypeExpression) THEN
    RETURN FALSE;
  END
  IF kind IS_A LinearTypeExpression AS inferred_linear THEN
    IF typeExpressionDimensions__has_symbol(inferred_linear.dimensions, :INFERRED) THEN
      RETURN TRUE;
    END
  END
  RETURN type__bare_legacy_slice?(node, type);
END
PUB FN type__bare_legacy_slice?(node: TypeExpression, type: Type) RETURNS Bool ->
  MUTABLE kind = COPY node.kind;
  IF !(((type__collection(type) == NIL) AND kind IS_A LinearTypeExpression)) THEN
    RETURN FALSE;
  END
  IF kind IS_A LinearTypeExpression AS list_linear THEN
    RETURN (linearTypeExpression__list?(list_linear) AND (node.capabilities.collection == NIL));
  END
  RETURN FALSE;
END
PRIVATE FN type__project_inline_collection(expression: TypeExpression, type: Type) RETURNS ?TypeExpression EFFECTS REENTRANT ->
  MUTABLE inner: ?TypeExpression = NIL;
  MUTABLE collection: ?String@symbol = type__collection(type);
  IF collection EXISTS AS collection_value THEN
    MUTABLE kind = COPY expression.kind;
    MUTABLE cap = COPY expression.capabilities;
    IF kind IS_A OptionalTypeExpression THEN
      inner = type__project_inline_collection((UNWRAP (typeExpressionKind__optional(kind))).inner, type);
      IF (inner == NIL) THEN
        RETURN NIL;
      ELSE
        RETURN typeExpression__of(TypeExpressionKind{ OptionalTypeExpression: COPY OptionalTypeExpression{ inner: COPY inner } });
      END
    END
    IF kind IS_A FallibleTypeExpression THEN
      MUTABLE fallible_kind: FallibleTypeExpression = UNWRAP (typeExpressionKind__fallible(kind));
      inner = type__project_inline_collection(fallible_kind.inner, type);
      IF (inner == NIL) THEN
        RETURN NIL;
      ELSE
        RETURN typeExpression__of(TypeExpressionKind{ FallibleTypeExpression: COPY FallibleTypeExpression{ inner: COPY inner, error_set: COPY fallible_kind.error_set } });
      END
    END
    IF !(kind IS_A LinearTypeExpression) THEN
      RETURN NIL;
    END
    MUTABLE linear_kind: LinearTypeExpression = UNWRAP (typeExpressionKind__linear(kind));
    MUTABLE hint: ?Int64 = linear_kind.allocation_hint;
    IF ((hint == NIL) AND type__pool?(type)) THEN
      MUTABLE pool_dimension: ?TypeExpressionDimension = linear_kind.dimensions |> FIND _ IS_A Int64;
      IF pool_dimension? IS_A Int64 AS int64 THEN
        hint = COPY int64;
      END
    END
    IF (type__pool?(type) AND (hint == NIL)) THEN
      RETURN NIL;
    END
    RETURN TypeExpression{ kind: COPY TypeExpressionKind{ LinearTypeExpression: COPY LinearTypeExpression{ kind: COPY collection_value, dimensions: COPY linear_kind.dimensions, item: COPY linear_kind.item, allocation_hint: hint } }, capabilities: COPY cap };
  ELSE
    RETURN COPY expression;
  END
END
PUB FN type__surface_name_type(t: Type) RETURNS !String EFFECTS REENTRANT ->
  IF type__tense?(t) THEN
    RETURN "~${TRY (type__surface_name_type(TRY (type__tense_type(t))))}";
  END
  IF type__error_union?(t) THEN
    MUTABLE payload: ?Type = TRY (type__payload_type(t));
    RETURN "!${TRY (type__surface_name_type(UNWRAP (payload)))}";
  END
  IF type__optional?(t) THEN
    MUTABLE wrapped: Type = CAST(TRY (type__wrapped_type(t)) AS Type);
    MUTABLE inner = TRY (type__surface_name_type(wrapped));
    RETURN "?${inner}";
  END
  IF type__array?(t) THEN
    MUTABLE element: Type = CAST(TRY (type__element_type(t)) AS Type);
    RETURN "${type__array_capacity_suffix(type__capacity(t))}${TRY (type__surface_name_type(element))}";
  END
  IF type__map?(t) THEN
    RETURN "{${TRY (type__surface_name_type(TRY (type__key_type(t))))}}${TRY (type__surface_name_type(TRY (type__value_type(t))))}";
  END
  IF type__fn_type?(t) THEN
    RETURN TRY (type__function_type_surface_name(t));
  END
  IF type__generic_instance?(t) THEN
    MUTABLE names: []String = (TRY (type__generic_args(t))) |> SELECT TRY (type__surface_name_type(_));
    RETURN "${type__generic_base(t)}<${names.join(",")}>";
  END
  RETURN COPY CAST(type__resolved(t) AS String);
END
PUB FN type__coercion_surface_name(type: TypeTypeInput) RETURNS !String ->
  MUTABLE t = TRY (type__from_input(type));
  RETURN TRY (type__coercion_surface_name_type(t));
END
PUB FN type__coercion_surface_name_type(t: Type) RETURNS !String ->
  RETURN "${TRY (type__surface_name_type(t))}${type__sync_surface_name(t) OR_ELSE ""}";
END
PUB FN type__array_of(element_type: TypeTypeInput, capacity: ?TypeArrayCapacity = NIL) RETURNS !Type ->
  MUTABLE element = TRY (type__from_input(element_type));
  MUTABLE item_expression = typeExpressionTree__with_root_capabilities(element.shape.expression, element.capabilities);
  MUTABLE dimension_branch_value: ?TypeExpressionDimension = NIL;
  IF (capacity == NIL) THEN
    dimension_branch_value = TypeExpressionDimension{ SymbolValue: :LIST };
  ELSE
    dimension_branch_value = castOptionalTypeArrayCapacityToTypeExpressionDimension(capacity);
  END
  MUTABLE dimension: TypeExpressionDimension = dimension_branch_value?;
  MUTABLE dimensions: []TypeExpressionDimension = [dimension];
  MUTABLE kind_branch_value: ?String@symbol = NIL;
  IF (capacity == NIL) THEN
    kind_branch_value = :list;
  ELSE
    kind_branch_value = :array;
  END
  MUTABLE kind: String@symbol = kind_branch_value?;
  MUTABLE collection_capabilities_branch_value: ?TypeCapabilities = NIL;
  IF (capacity == NIL) THEN
    collection_capabilities_branch_value = typeCapabilities__new(:affine, FALSE, NIL, NIL, NIL, :list);
  ELSE
    collection_capabilities_branch_value = typeCapabilities__new(:affine);
  END
  MUTABLE collection_capabilities: TypeCapabilities = collection_capabilities_branch_value?;
  RETURN TRY (type__new(TypeConstructionInput{ TypeExpression: COPY TypeExpression{ kind: COPY TypeExpressionKind{ LinearTypeExpression: COPY LinearTypeExpression{ kind: COPY kind, dimensions: COPY dimensions, item: COPY item_expression, allocation_hint: NIL } }, capabilities: COPY collection_capabilities } }));
END
PUB FN type__promise_list_of(element_type: TypeTypeInput) RETURNS !Type ->
  MUTABLE list = TRY (type__array_of(element_type));
  RETURN TRY (type__new(TypeConstructionInput{ TypeExpression: COPY TypeExpression{ kind: COPY TypeExpressionKind{ FutureTypeExpression: COPY FutureTypeExpression{ inner: COPY list.shape.expression } }, capabilities: COPY typeCapabilities__new(:affine, FALSE, NIL, NIL, NIL, :list) } }));
END
PUB FN type__set_of(element_type: TypeTypeInput, capacity: ?Int64 = NIL) RETURNS !Type ->
  MUTABLE element = TRY (type__from_input(element_type));
  MUTABLE item_expression = typeExpressionTree__with_root_capabilities(element.shape.expression, element.capabilities);
  RETURN TRY (type__new(TypeConstructionInput{ TypeExpression: COPY TypeExpression{ kind: COPY TypeExpressionKind{ LinearTypeExpression: COPY LinearTypeExpression{ kind: :set, dimensions: [TypeExpressionDimension{ SymbolValue: :SET }], item: COPY item_expression, allocation_hint: COPY capacity } }, capabilities: COPY typeCapabilities__new(NIL, FALSE, NIL, NIL, NIL, :set) } }));
END
PUB FN type__error_union_of(payload_type: TypeTypeInput) RETURNS !Type ->
  MUTABLE payload = TRY (type__new(castTypeTypeInputToTypeConstructionInput(payload_type)));
  IF type__error_union?(payload) THEN
    RETURN payload;
  END
  MUTABLE t = TRY (type__new(TypeConstructionInput{ TypeExpression: COPY typeExpression__of(TypeExpressionKind{ FallibleTypeExpression: COPY FallibleTypeExpression{ inner: COPY payload.shape.expression, error_set: NIL } }) }));
  TRY (type__merge_capabilities_from_mut(&t, payload, TRUE, TRUE));
  type__copy_placement_from_mut(&t, payload, FALSE);
  RETURN t;
END
PUB FN type__optional_of(wrapped_type: TypeTypeInput) RETURNS !Type EFFECTS REENTRANT ->
  MUTABLE wrapped = TRY (type__new(castTypeTypeInputToTypeConstructionInput(wrapped_type)));
  IF type__optional?(wrapped) THEN
    RETURN wrapped;
  END
  MUTABLE inner_expr = COPY wrapped.shape.expression;
  MUTABLE t = TRY (type__new(TypeConstructionInput{ TypeExpression: COPY typeExpression__of(TypeExpressionKind{ OptionalTypeExpression: COPY OptionalTypeExpression{ inner: inner_expr } }) }));
  TRY (type__merge_capabilities_from_mut(&t, wrapped, TRUE, TRUE));
  type__copy_placement_from_mut(&t, wrapped, FALSE);
  RETURN t;
END
PUB FN type__tense_of(value_type: TypeTypeInput) RETURNS !Type ->
  MUTABLE value = TRY (type__new(castTypeTypeInputToTypeConstructionInput(value_type)));
  MUTABLE inner_expr = COPY value.shape.expression;
  MUTABLE t = TRY (type__new(TypeConstructionInput{ TypeExpression: COPY typeExpression__of(TypeExpressionKind{ FutureTypeExpression: COPY FutureTypeExpression{ inner: inner_expr } }) }));
  TRY (type__merge_capabilities_from_mut(&t, value, TRUE, TRUE));
  type__copy_placement_from_mut(&t, value, FALSE);
  RETURN t;
END
PUB FN type__generic_instance_of(base: String@symbol, args: []TypeTypeInput) RETURNS !Type ->
  MUTABLE arguments: []TypeExpression = ( { MUTABLE rtoc_empty_list_3: []TypeExpression = List[]; rtoc_empty_list_3 } );
  MUTABLE index: Int64 = 0;
  WHILE (index < args.length()) DO
    MUTABLE argument = TRY (type__from_input(UNWRAP (args[index])));
    &arguments.append(typeExpressionTree__with_root_capabilities(argument.shape.expression, argument.capabilities));
    index = (index + 1);
  END
  RETURN TRY (type__new(TypeConstructionInput{ TypeExpression: COPY typeExpression__of(TypeExpressionKind{ NamedTypeExpression: COPY NamedTypeExpression{ name: COPY base, arguments: COPY arguments } }) }));
END
PUB FN type__stream_step_of(item_type: TypeTypeInput) RETURNS !Type ->
  RETURN TRY (type__generic_instance_of(:StreamStep, [item_type]));
END
PUB FN type__function_type_from_parts(param_types: []Type, return_type: Type, reentrant: Bool, source_signature: ?TypeSourceSignature, abi_value: String@symbol = :clear) RETURNS !Type ->
  MUTABLE params: []FunctionTypeParam = ( { MUTABLE rtoc_empty_list_4: []FunctionTypeParam = List[]; rtoc_empty_list_4 } );
  MUTABLE i: Int64 = 0;
  WHILE (i < param_types.length()) DO
    &params.append(FunctionTypeParam{ type: COPY TRY (type__copy_type(UNWRAP (param_types[i]))) });
    i = (i + 1);
  END
  RETURN TRY (type__new(TypeConstructionInput{ FunctionType: COPY FunctionType{ params: COPY params, return_type: COPY TRY (type__copy_type(return_type)), reentrant: COPY reentrant, source_signature: COPY source_signature, abi: COPY abi_value } }));
END
PUB FN type__array_capacity_suffix(capacity: ?TypeArrayCapacity) RETURNS String ->
  IF capacity EXISTS AS capacity_value THEN
    MUTABLE cap: ?String@symbol = type__array_capacity_symbol(capacity_value);
    IF !((cap == NIL)) THEN
      MUTABLE symbol_capacity = cap;
      IF (symbol_capacity == :STREAM_OPEN) THEN
        RETURN "[?]";
      END
      IF (symbol_capacity == :INF) THEN
        RETURN "[INF]";
      END
    END
    IF type__integer_array_capacity?(capacity_value) THEN
      RETURN "[${type__integer_string(type__array_capacity_integer(capacity_value))}]";
    END
    RETURN "[]";
  ELSE
    RETURN "[]";
  END
END
PUB FN type__array_capacity_label(capacity: ?TypeArrayCapacity) RETURNS String ->
  IF capacity EXISTS AS capacity_value THEN
    IF type__integer_array_capacity?(capacity_value) THEN
      RETURN type__integer_string(type__array_capacity_integer(capacity_value));
    END
    MUTABLE cap: ?String@symbol = type__array_capacity_symbol(capacity_value);
    IF !((cap == NIL)) THEN
      MUTABLE symbol_capacity = cap;
      IF (symbol_capacity == :STREAM_OPEN) THEN
        RETURN "STREAM_OPEN";
      END
      IF (symbol_capacity == :INF) THEN
        RETURN "INF";
      END
    END
    RETURN "unknown";
  ELSE
    RETURN "unknown";
  END
END
PUB FN type__function_type_surface_name(type: Type) RETURNS !String EFFECTS REENTRANT ->
  MUTABLE fn_raw = UNWRAP (type__function_type(type));
  MUTABLE params = fn_raw.params |> SELECT TRY (type__surface_name_type(_.type));
  MUTABLE callconv: String = "";
  IF (fn_raw.abi == :c) THEN
    callconv = " CALLCONV C";
  ELSE
    callconv = "";
  END
  RETURN "FN(${params.join(", ")}) -> ${TRY (type__surface_name_type(fn_raw.return_type))}${callconv}";
END
PUB FN type__logical_op?(op: String@symbol) RETURNS Bool ->
  RETURN ((op == symbol("AND")) OR (op == symbol("OR")));
END
PUB FN type__equality_op?(op: String@symbol) RETURNS Bool ->
  RETURN ((op == :EQ) OR (op == :NEQ));
END
PUB FN type__ordering_op?(op: String@symbol) RETURNS Bool ->
  RETURN ((((op == :LT) OR (op == :GT)) OR (op == :LTE)) OR (op == :GTE));
END
PUB FN type__bool_result_op?(op: String@symbol) RETURNS Bool ->
  RETURN (type__equality_op?(op) OR type__ordering_op?(op));
END
PUB FN type__number_result_op?(op: String@symbol) RETURNS Bool ->
  RETURN (((((((((op == :SUB) OR (op == :MUL)) OR (op == :DIV)) OR (op == :POW)) OR (op == symbol("MOD"))) OR (op == :WRAP_SUB)) OR (op == :WRAP_MUL)) OR (op == :CHECK_SUB)) OR (op == :CHECK_MUL));
END
PUB FN type__bitwise_op?(op: String@symbol) RETURNS Bool ->
  RETURN bitwise_ops.contains?(op);
END
PUB FN type__shift_op?(op: String@symbol) RETURNS Bool ->
  RETURN shift_ops.contains?(op);
END
PUB FN type__binary_op(op: String@symbol, left_type: Type, right_type: Type) RETURNS !BinaryOpResult ->
  MUTABLE auto_present = (type__auto?(left_type) OR type__auto?(right_type));
  IF auto_present THEN
    IF (op == :CONCAT) THEN
      RETURN BinaryOpResult{ type: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :String })), storage: :frame, left_coercion: NIL, right_coercion: NIL, error: NIL };
    END
    IF (type__logical_op?(op) OR type__bool_result_op?(op)) THEN
      RETURN BinaryOpResult{ type: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :Bool })), left_coercion: NIL, right_coercion: NIL, storage: NIL, error: NIL };
    END
    RETURN BinaryOpResult{ type: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: symbol("Auto") }, NIL, NIL, NIL, NIL, NIL, NIL, NIL, NIL, NIL, TRUE)), left_coercion: NIL, right_coercion: NIL, storage: NIL, error: NIL };
  END
  MUTABLE t_left = type__resolved(left_type);
  MUTABLE t_right = type__resolved(right_type);
  IF type__logical_op?(op) THEN
    RETURN TRY (type__resolve_logical_op(op, left_type, right_type));
  END
  IF type__equality_op?(op) THEN
    RETURN TRY (type__resolve_equality_op(op, left_type, right_type));
  END
  IF type__ordering_op?(op) THEN
    RETURN TRY (type__resolve_ordering_op(op, left_type, right_type));
  END
  IF (type__bitwise_op?(op) OR type__shift_op?(op)) THEN
    RETURN TRY (type__resolve_integer_op(op, left_type, right_type, type__shift_op?(op)));
  END
  IF ((type__number_result_op?(op) OR (op == :WRAP_ADD)) OR (op == :CHECK_ADD)) THEN
    RETURN TRY (type__resolve_numeric_op(left_type, right_type));
  END
  IF (op == :CONCAT) THEN
    RETURN TRY (type__resolve_concat_op(t_left, t_right, left_type, right_type));
  END
  IF (op == :ADD) THEN
    RETURN TRY (type__resolve_add_op(t_left, t_right, left_type, right_type));
  END
  RETURN BinaryOpResult{ error: "Unknown operator: ${op}", type: NIL, left_coercion: NIL, right_coercion: NIL, storage: NIL };
END
PUB FN type__coerce_error(source_type: Type, target_type: TypeTypeInput) RETURNS !?String ->
  MUTABLE target = TRY (type__from_input(target_type));
  IF type__auto?(target) THEN
    RETURN NIL;
  END
  IF type__auto?(source_type) THEN
    RETURN NIL;
  END
  IF TRY (type__accepts?(target, source_type)) THEN
    RETURN NIL;
  END
  IF TRY (type__array_overflow?(target, source_type)) THEN
    RETURN "Cannot initialize array of size ${type__array_capacity_label(type__capacity(target))} with ${type__array_capacity_label(type__capacity(source_type))} elements";
  ELSE
    RETURN "Type Mismatch: Cannot assign ${TRY (type__coercion_surface_name_type(source_type))} to ${TRY (type__coercion_surface_name_type(target))}";
  END
END
PRIVATE FN type__resolve_logical_op(op: String@symbol, left_type: Type, right_type: Type) RETURNS !BinaryOpResult ->
  IF ((type__resolved(left_type) == :Bool) AND (type__resolved(right_type) == :Bool)) THEN
    RETURN BinaryOpResult{ type: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :Bool })), left_coercion: NIL, right_coercion: NIL, storage: NIL, error: NIL };
  END
  RETURN BinaryOpResult{ error: "Operator ${op} requires Bool operands, got ${type__resolved(left_type)} and ${type__resolved(right_type)}", type: NIL, left_coercion: NIL, right_coercion: NIL, storage: NIL };
END
PRIVATE FN type__resolve_equality_op(op: String@symbol, left_type: Type, right_type: Type) RETURNS !BinaryOpResult ->
  IF TRY (type__equality_compatible?(left_type, right_type)) THEN
    RETURN BinaryOpResult{ type: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :Bool })), left_coercion: NIL, right_coercion: NIL, storage: NIL, error: NIL };
  END
  RETURN BinaryOpResult{ error: "Operator ${op} cannot compare ${type__resolved(left_type)} with ${type__resolved(right_type)}", type: NIL, left_coercion: NIL, right_coercion: NIL, storage: NIL };
END
PRIVATE FN type__resolve_ordering_op(op: String@symbol, left_type: Type, right_type: Type) RETURNS !BinaryOpResult ->
  IF TRY (type__ordered_compatible?(left_type, right_type)) THEN
    RETURN BinaryOpResult{ type: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :Bool })), left_coercion: NIL, right_coercion: NIL, storage: NIL, error: NIL };
  END
  RETURN BinaryOpResult{ error: "Operator ${op} requires ordered operands, got ${type__resolved(left_type)} and ${type__resolved(right_type)}", type: NIL, left_coercion: NIL, right_coercion: NIL, storage: NIL };
END
PRIVATE FN type__resolve_integer_op(op: String@symbol, left_type: Type, right_type: Type, preserve_left: Bool) RETURNS !BinaryOpResult ->
  IF (type__any?(left_type) OR type__any?(right_type)) THEN
    RETURN BinaryOpResult{ type: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })), left_coercion: NIL, right_coercion: NIL, storage: NIL, error: NIL };
  END
  IF !((type__integer?(left_type) AND type__integer?(right_type))) THEN
    RETURN BinaryOpResult{ error: "Operator ${op} requires integer operands, got ${type__resolved(left_type)} and ${type__resolved(right_type)}", type: NIL, left_coercion: NIL, right_coercion: NIL, storage: NIL };
  END
  IF preserve_left THEN
    RETURN BinaryOpResult{ type: COPY TRY (type__copy_type(left_type)), left_coercion: NIL, right_coercion: NIL, storage: NIL, error: NIL };
  END
  RETURN TRY (type__resolve_numeric_op(left_type, right_type));
END
PRIVATE FN type__equality_compatible?(left_type: Type, right_type: Type) RETURNS !Bool ->
  IF ((type__any?(left_type) OR type__any?(right_type)) OR type__optional_any_comparable?(left_type, right_type)) THEN
    RETURN TRUE;
  END
  RETURN ((((type__resolved(left_type) == type__resolved(right_type)) OR type__optional_nil_comparable?(left_type, right_type)) OR TRY (type__optional_payload_comparable?(left_type, right_type))) OR TRY (type__scalar_comparable?(left_type, right_type)));
END
PRIVATE FN type__optional_any_comparable?(left_type: Type, right_type: Type) RETURNS !Bool ->
  IF type__optional?(left_type) THEN
    IF type__any?((CAST(TRY (type__wrapped_type(left_type)) AS Type))) THEN
      RETURN TRUE;
    END
  END
  IF type__optional?(right_type) THEN
    IF type__any?((CAST(TRY (type__wrapped_type(right_type)) AS Type))) THEN
      RETURN TRUE;
    END
  END
  RETURN FALSE;
END
PRIVATE FN type__ordered_compatible?(left_type: Type, right_type: Type) RETURNS !Bool ->
  RETURN (TRY (type__scalar_comparable?(left_type, right_type)) OR TRY (type__optional_payload_ordered_comparable?(left_type, right_type)));
END
PRIVATE FN type__scalar_comparable?(left_type: Type, right_type: Type) RETURNS !Bool ->
  RETURN ((((type__numeric?(left_type) AND type__numeric?(right_type))) OR ((TRY (type__string?(left_type)) AND TRY (type__string?(right_type))))) OR type__same_generic_parameter?(left_type, right_type));
END
PRIVATE FN type__optional_nil_comparable?(left_type: Type, right_type: Type) RETURNS Bool ->
  RETURN (((type__optional?(left_type) AND (type__resolved(right_type) == symbol("NIL")))) OR ((type__optional?(right_type) AND (type__resolved(left_type) == symbol("NIL")))));
END
PRIVATE FN type__optional_payload_comparable?(left_type: Type, right_type: Type) RETURNS !Bool ->
  IF !((type__optional?(left_type) != type__optional?(right_type))) THEN
    RETURN FALSE;
  END
  IF type__optional?(left_type) THEN
    RETURN TRY (type__payload_comparable?(CAST(TRY (type__wrapped_type(left_type)) AS Type), right_type));
  END
  RETURN TRY (type__payload_comparable?(CAST(TRY (type__wrapped_type(right_type)) AS Type), left_type));
END
PRIVATE FN type__payload_comparable?(inner_type: Type, payload_type: Type) RETURNS !Bool ->
  RETURN ((type__resolved(inner_type) == type__resolved(payload_type)) OR TRY (type__scalar_comparable?(inner_type, payload_type)));
END
PRIVATE FN type__optional_payload_ordered_comparable?(left_type: Type, right_type: Type) RETURNS !Bool ->
  IF !((type__optional?(left_type) != type__optional?(right_type))) THEN
    RETURN FALSE;
  END
  IF type__optional?(left_type) THEN
    RETURN TRY (type__scalar_comparable?(CAST(TRY (type__wrapped_type(left_type)) AS Type), right_type));
  END
  RETURN TRY (type__scalar_comparable?(CAST(TRY (type__wrapped_type(right_type)) AS Type), left_type));
END
PRIVATE FN type__same_generic_parameter?(left_type: Type, right_type: Type) RETURNS Bool ->
  RETURN ((type__generic_type_parameter?(left_type) AND type__generic_type_parameter?(right_type)) AND (type__resolved(left_type) == type__resolved(right_type)));
END
PRIVATE FN type__resolve_numeric_op(left_type: Type, right_type: Type) RETURNS !BinaryOpResult ->
  MUTABLE t_left = type__resolved(left_type);
  MUTABLE t_right = type__resolved(right_type);
  IF (type__any?(left_type) OR type__any?(right_type)) THEN
    RETURN BinaryOpResult{ type: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })), left_coercion: NIL, right_coercion: NIL, storage: NIL, error: NIL };
  END
  IF type__same_generic_parameter?(left_type, right_type) THEN
    RETURN BinaryOpResult{ type: COPY TRY (type__copy_type(left_type)), left_coercion: NIL, right_coercion: NIL, storage: NIL, error: NIL };
  END
  IF !((type__numeric?(left_type) AND type__numeric?(right_type))) THEN
    RETURN BinaryOpResult{ error: "Numeric operator requires numeric operands, got ${t_left} and ${t_right}", type: NIL, left_coercion: NIL, right_coercion: NIL, storage: NIL };
  END
  IF (t_left == t_right) THEN
    RETURN BinaryOpResult{ type: COPY TRY (type__copy_type(left_type)), left_coercion: NIL, right_coercion: NIL, storage: NIL, error: NIL };
  END
  IF (type__integer?(left_type) AND type__integer?(right_type)) THEN
    IF (t_left == :Int64) THEN
      RETURN BinaryOpResult{ type: COPY TRY (type__copy_type(left_type)), left_coercion: NIL, right_coercion: IF (t_right == :Int64) THEN
        NIL
      ELSE
        :Int64
      END, storage: NIL, error: NIL };
    END
    RETURN BinaryOpResult{ type: COPY TRY (type__copy_type(right_type)), left_coercion: :Int64, right_coercion: IF (t_right == :Int64) THEN
      NIL
    ELSE
      :Int64
    END, storage: NIL, error: NIL };
  END
  IF (type__float?(left_type) AND type__float?(right_type)) THEN
    IF (t_left == :Float64) THEN
      RETURN BinaryOpResult{ type: COPY TRY (type__copy_type(left_type)), left_coercion: NIL, right_coercion: IF (t_right == :Float64) THEN
        NIL
      ELSE
        :Float64
      END, storage: NIL, error: NIL };
    END
    RETURN BinaryOpResult{ type: COPY TRY (type__copy_type(right_type)), left_coercion: :Float64, right_coercion: IF (t_right == :Float64) THEN
      NIL
    ELSE
      :Float64
    END, storage: NIL, error: NIL };
  END
  IF (type__integer?(left_type) AND type__float?(right_type)) THEN
    RETURN BinaryOpResult{ type: COPY TRY (type__copy_type(right_type)), left_coercion: COPY t_right, right_coercion: NIL, storage: NIL, error: NIL };
  END
  IF (type__float?(left_type) AND type__integer?(right_type)) THEN
    RETURN BinaryOpResult{ type: COPY TRY (type__copy_type(left_type)), right_coercion: COPY t_left, left_coercion: NIL, storage: NIL, error: NIL };
  END
  RETURN BinaryOpResult{ type: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :Float64 })), left_coercion: NIL, right_coercion: NIL, storage: NIL, error: NIL };
END
PRIVATE FN type__resolve_add_op(t_left: String@symbol, t_right: String@symbol, left_type: Type, right_type: Type) RETURNS !BinaryOpResult ->
  MUTABLE lt = TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol((CAST(t_left AS String))) }));
  MUTABLE rt = TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol((CAST(t_right AS String))) }));
  IF type__same_generic_parameter?(left_type, right_type) THEN
    RETURN BinaryOpResult{ type: COPY TRY (type__copy_type(left_type)), left_coercion: NIL, right_coercion: NIL, storage: NIL, error: NIL };
  END
  IF (type__numeric?(lt) AND type__numeric?(rt)) THEN
    RETURN TRY (type__resolve_numeric_op(left_type, right_type));
  END
  IF (type__array?(left_type) AND type__array?(right_type)) THEN
    RETURN BinaryOpResult{ type: COPY TRY (type__copy_type(left_type)), storage: :frame, left_coercion: NIL, right_coercion: NIL, error: NIL };
  END
  RETURN BinaryOpResult{ error: "Cannot add types: ${t_left} and ${t_right}", type: NIL, left_coercion: NIL, right_coercion: NIL, storage: NIL };
END
PRIVATE FN type__resolve_concat_op(t_left: String@symbol, t_right: String@symbol, left_type: Type, right_type: Type) RETURNS !BinaryOpResult ->
  IF !((TRY (type__string?(left_type)) OR TRY (type__string?(right_type)))) THEN
    RETURN BinaryOpResult{ error: "Operator $+ requires at least one String operand, got ${t_left} and ${t_right}", type: NIL, left_coercion: NIL, right_coercion: NIL, storage: NIL };
  END
  MUTABLE left_coercion: ?String@symbol = IF ((!(TRY (type__string?(left_type))) AND TRY (type__safe_autocast?(t_left, :String)))) THEN
    :String
  ELSE
    NIL
  END;
  MUTABLE right_coercion: ?String@symbol = IF ((!(TRY (type__string?(right_type))) AND TRY (type__safe_autocast?(t_right, :String)))) THEN
    :String
  ELSE
    NIL
  END;
  RETURN BinaryOpResult{ type: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :String })), left_coercion: COPY left_coercion, right_coercion: COPY right_coercion, storage: :frame, error: NIL };
END
PRIVATE FN type__safe_autocast?(from_type: String@symbol, to_type: String@symbol) RETURNS !Bool ->
  MUTABLE from_t = TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol((CAST(from_type AS String))) }));
  MUTABLE to_t = TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol((CAST(to_type AS String))) }));
  IF (type__fn_type?(from_t) OR type__fn_type?(to_t)) THEN
    RETURN FALSE;
  END
  IF (type__numeric?(from_t) AND type__numeric?(to_t)) THEN
    RETURN TRUE;
  END
  RETURN ([:Float64, :Int64, :Bool, :Byte]).contains?(type__resolved(from_t));
END
PUB FN type__initialize(MUTABLE self: Type, raw_input: TypeConstructionInput, ownership: ?String@symbol = NIL, sync_value: ?String@symbol = NIL, layout: ?String@symbol = NIL, location: ?String@symbol = NIL, collection: ?String@symbol = NIL, shard_count: ?Int64 = NIL, stripe_count: ?Int64 = NIL, observable: ?Bool = NIL, observable_terminal: ?String@symbol = NIL, auto: Bool = FALSE) RETURNS !Void EFFECTS REENTRANT ->
  self.shape = TRY (typeShape__from_raw(TypeShapeRaw{ SymbolValue: :Any }));
  self.capabilities = typeCapabilities__new();
  self.placement = TypePlacement{ provenance: NIL };
  self.is_resource = NIL;
  self.auto_token = NIL;
  self.generic_payload_type_arg = FALSE;
  IF raw_input IS_A Type AS type THEN
    self.shape = typeShape__copy(type.shape);
    IF auto THEN
      self.shape = TRY (typeShape__copy_with_auto(self.shape, TRUE));
    END
    self.capabilities = typeCapabilities__copy(type.capabilities);
    self.placement = typePlacement__copy(type.placement);
    self.auto_token = type.auto_token;
    self.generic_payload_type_arg = type__generic_payload_type_arg?(type);
  ELSE_IF raw_input IS_A TypeExpression AS type_expression THEN
    TRY (type__parse_expression_input_mut(&self, type_expression, auto));
  ELSE_IF raw_input IS_A FunctionType AS function_type THEN
    TRY (type__parse_function_type_input_mut(&self, function_type, auto));
  ELSE_IF raw_input IS_A String@symbol AS string_symbol THEN
    TRY (type__parse_raw_string_mut(&self, CAST(string_symbol AS String), auto));
  ELSE_IF raw_input IS_A String AS string THEN
    TRY (type__parse_raw_string_mut(&self, string, auto));
  END
  type__apply_declared_location_mut(&self, location);
  IF ((((((!((ownership == NIL)) OR !((sync_value == NIL))) OR !((layout == NIL))) OR !((collection == NIL))) OR !((shard_count == NIL))) OR (observable == TRUE)) OR !((observable_terminal == NIL))) THEN
    TRY (type__apply_capabilities_mut(&self, type__capability_symbol_or_unset(ownership), type__capability_symbol_or_unset(sync_value), type__capability_symbol_or_unset(layout), TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, type__capability_symbol_or_unset(collection), type__capability_integer_or_unset(shard_count), TypeCapabilitiesMaybeBoolean{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, type__capability_observable_or_unset(observable), type__capability_symbol_or_unset(observable_terminal)));
  END
  IF type__sync_requires_heap_provenance?(self) THEN
    type__pin_heap_for_sync_wrapper_mut(&self);
  END
  IF type__indirect?(self) THEN
    type__pin_heap_for_indirect_mut(&self);
  END
  IF type__symbol?(self) THEN
    type__mark_rodata_mut(&self);
  END
  IF type__pool?(self) THEN
    type__pin_heap_for_collection_mut(&self);
  END
END
PRIVATE FN type__escape_class(self: Type) RETURNS !String@symbol ->
  IF type__primitive?(self) THEN
    RETURN :value;
  END
  IF type__id_handle?(self) THEN
    RETURN :value;
  END
  IF TRY (type__any_rc?(self)) THEN
    RETURN :refcounted;
  END
  IF type__any_sync?(self) THEN
    RETURN :sync_wrapped;
  END
  IF TRY (type__string?(self)) THEN
    RETURN (IF type__rodata?(self) THEN
      :slice_rodata
    ELSE
      :slice_managed
    END);
  END
  IF type__collection?(self) THEN
    RETURN :slice_managed;
  END
  IF TRY (type__non_string_array?(self)) THEN
    RETURN :value;
  END
  RETURN :by_ref;
END
PUB FN type__set_ownership(MUTABLE self: Type, value: ?String@symbol) RETURNS !?String@symbol ->
  TRY (type__apply_capabilities_mut(&self, type__capability_symbol(value)));
  RETURN value;
END
PUB FN type__ownership(self: Type) RETURNS ?String@symbol EFFECTS REENTRANT ->
  RETURN self.capabilities.ownership;
END
PUB FN type__set_sync(MUTABLE self: Type, value: ?String@symbol) RETURNS !?String@symbol ->
  TRY (type__apply_capabilities_mut(&self, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, type__capability_symbol(value)));
  RETURN value;
END
PUB FN type__sync(self: Type) RETURNS ?String@symbol EFFECTS REENTRANT ->
  RETURN self.capabilities.sync;
END
PUB FN type__set_layout(MUTABLE self: Type, value: ?String@symbol) RETURNS !?String@symbol ->
  TRY (type__apply_capabilities_mut(&self, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, type__capability_symbol(value)));
  RETURN value;
END
PUB FN type__layout(self: Type) RETURNS ?String@symbol EFFECTS REENTRANT ->
  RETURN self.capabilities.layout;
END
PUB FN type__set_lock_rank(MUTABLE self: Type, value: ?Int64) RETURNS !?Int64 ->
  TRY (type__apply_capabilities_mut(&self, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, type__capability_integer(value)));
  RETURN COPY value;
END
PUB FN type__lock_rank(self: Type) RETURNS ?Int64 EFFECTS REENTRANT ->
  RETURN self.capabilities.lock_rank;
END
PUB FN type__set_collection(MUTABLE self: Type, value: ?String@symbol) RETURNS !?String@symbol ->
  TRY (type__apply_capabilities_mut(&self, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, type__capability_symbol(value)));
  IF type__pool?(self) THEN
    type__pin_heap_for_collection_mut(&self);
  END
  RETURN value;
END
PUB FN type__collection(self: Type) RETURNS ?String@symbol EFFECTS REENTRANT ->
  RETURN self.capabilities.collection;
END
PUB FN type__set_shard_count(MUTABLE self: Type, value: ?Int64) RETURNS !?Int64 ->
  TRY (type__apply_capabilities_mut(&self, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, type__capability_integer(value)));
  RETURN COPY value;
END
PUB FN type__shard_count(self: Type) RETURNS ?Int64 EFFECTS REENTRANT ->
  RETURN self.capabilities.shard_count;
END
PUB FN type__set_soa(MUTABLE self: Type, value: Bool) RETURNS !Bool ->
  TRY (type__apply_capabilities_mut(&self, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeBoolean{ BoolValue: value }));
  RETURN COPY value;
END
PUB FN type__soa(self: Type) RETURNS Bool EFFECTS REENTRANT ->
  RETURN self.capabilities.soa;
END
PUB FN type__set_elem_ownership(MUTABLE self: Type, value: ?String@symbol) RETURNS !?String@symbol ->
  TRY (type__apply_capabilities_mut(&self, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeBoolean{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, type__capability_symbol(value)));
  RETURN value;
END
PUB FN type__elem_ownership(self: Type) RETURNS ?String@symbol EFFECTS REENTRANT ->
  MUTABLE capabilities: ?TypeCapabilities = typeExpressionTree__linear_item_capabilities(self.shape.expression);
  IF capabilities EXISTS AS capabilities_value THEN
    MUTABLE value: ?String@symbol = COPY capabilities_value.ownership;
    IF ((value == :affine) AND !(capabilities_value.ownership_set)) THEN
      RETURN NIL;
    END
    RETURN value;
  ELSE
    RETURN self.capabilities.elem_ownership;
  END
END
PUB FN type__set_elem_sync(MUTABLE self: Type, value: ?String@symbol) RETURNS !?String@symbol ->
  TRY (type__apply_capabilities_mut(&self, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeBoolean{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, type__capability_symbol(value)));
  RETURN value;
END
PUB FN type__elem_sync(self: Type) RETURNS ?String@symbol EFFECTS REENTRANT ->
  MUTABLE capabilities: ?TypeCapabilities = typeExpressionTree__linear_item_capabilities(self.shape.expression);
  IF capabilities EXISTS AS capabilities_value THEN
    RETURN capabilities_value.sync;
  ELSE
    RETURN self.capabilities.elem_sync;
  END
END
PUB FN type__set_elem_layout(MUTABLE self: Type, value: ?String@symbol) RETURNS !?String@symbol ->
  TRY (type__apply_capabilities_mut(&self, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeBoolean{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, type__capability_symbol(value)));
  RETURN value;
END
PUB FN type__elem_layout(self: Type) RETURNS ?String@symbol EFFECTS REENTRANT ->
  MUTABLE capabilities: ?TypeCapabilities = typeExpressionTree__linear_item_capabilities(self.shape.expression);
  IF capabilities EXISTS AS capabilities_value THEN
    RETURN capabilities_value.layout;
  ELSE
    RETURN self.capabilities.elem_layout;
  END
END
PUB FN type__set_link_source(MUTABLE self: Type, value: ?String@symbol) RETURNS !?String@symbol ->
  TRY (type__apply_capabilities_mut(&self, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeBoolean{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, type__capability_symbol(value)));
  RETURN value;
END
PUB FN type__link_source(self: Type) RETURNS ?String@symbol EFFECTS REENTRANT ->
  RETURN self.capabilities.link_source;
