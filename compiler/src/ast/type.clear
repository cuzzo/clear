PRIVATE FN type__apply_declared_location_mut(MUTABLE self: Type, location: ?String@symbol) RETURNS TypePlacement ->
  IF location EXISTS AS location_value THEN
    MUTABLE location_value_mutable = COPY location_value;
    IF (location_value_mutable == :stack) THEN
      RETURN COPY self.placement;
    ELSE
      RETURN type__apply_placement_mut(&self, type__placement_symbol(location_value_mutable));
    END
  ELSE
    RETURN COPY self.placement;
  END
END
PUB FN type__mark_stack_value_mut(MUTABLE self: Type) RETURNS TypePlacement ->
  RETURN type__apply_placement_mut(&self, NIL);
END
PUB FN type__mark_heap_allocated_mut(MUTABLE self: Type) RETURNS TypePlacement ->
