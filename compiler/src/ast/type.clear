PUB FN type__projection_member(self: Type) RETURNS ?String@symbol ->
  MUTABLE kind = COPY self.shape.expression.kind;
  IF kind IS_A TypeProjectionExpression THEN
    RETURN (UNWRAP (typeExpressionKind__projection(kind))).member;
  ELSE
    RETURN NIL;
  END
END
PUB FN type__projection_protocol(self: Type) RETURNS ?String@symbol ->
  MUTABLE kind = COPY self.shape.expression.kind;
  IF kind IS_A TypeProjectionExpression THEN
    RETURN (UNWRAP (typeExpressionKind__projection(kind))).protocol;
  ELSE
    RETURN NIL;
  END
END
PUB FN type__generic_base(self: Type) RETURNS String@symbol ->
  RETURN type__symbol_or_default(typeShape__generic_base_raw(self.shape), type__resolved(self));
END
PUB FN type__tuple?(self: Type) RETURNS Bool ->
  RETURN (type__generic_instance?(self) AND (type__generic_base(self) == :Tuple));
END
PUB FN type__id_handle?(self: Type) RETURNS Bool ->
  RETURN (type__generic_instance?(self) AND (typeShape__generic_base_raw(self.shape) == :Id));
