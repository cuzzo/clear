PUB FN type__frame?(self: Type) RETURNS Bool EFFECTS REENTRANT ->
  RETURN typePlacement__frame?(self.placement);
END
PUB FN type__rodata?(self: Type) RETURNS Bool EFFECTS REENTRANT ->
