PUB FN type__node_payload_type(self: Type) RETURNS !?Type EFFECTS REENTRANT ->
  IF type__optional?(self) THEN
    MUTABLE wrapped: ?Type = TRY (type__wrapped_type(self));
    IF wrapped EXISTS AS wrapped_value THEN
      IF type__node?(wrapped_value) THEN
        RETURN TRY (type__node_payload_type(wrapped_value));
      END
    END
  END
  IF type__node?(self) THEN
    RETURN COPY self;
  END
  RETURN NIL;
END
PUB FN type__polymorphic_shared?(self: Type) RETURNS Bool ->
