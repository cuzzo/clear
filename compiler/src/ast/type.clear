PUB FN type__apply_declared_type_capabilities_mut(MUTABLE self: Type, ownership: ?String@symbol, sync_value: ?String@symbol, lock_rank: ?Int64, layout: ?String@symbol) RETURNS !TypeCapabilities ->
  RETURN CAST(TRY (type__apply_capabilities_mut(&self, type__capability_symbol_or_unset(ownership), type__capability_symbol_or_unset(sync_value), type__capability_symbol_or_unset(layout), type__capability_integer_or_unset(lock_rank))) AS TypeCapabilities);
