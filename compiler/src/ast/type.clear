PUB FN type__c_string?(self: Type) RETURNS !Bool ->
  RETURN (TRY (type__string?(self)) AND (type__sync(self) == :c));
END
PUB FN type__c_array_view?(self: Type) RETURNS !Bool ->
  RETURN ((type__array?(self) AND !(TRY (type__string?(self)))) AND (type__sync(self) == :c));
