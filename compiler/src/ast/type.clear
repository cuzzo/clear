PUB FN type__apply_capabilities_mut(MUTABLE self: Type, ownership: ?TypeCapabilitiesMaybeSymbol = TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, sync_value: ?TypeCapabilitiesMaybeSymbol = TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, layout: ?TypeCapabilitiesMaybeSymbol = TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, lock_rank: ?TypeCapabilitiesMaybeInteger = TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, collection: ?TypeCapabilitiesMaybeSymbol = TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, shard_count: ?TypeCapabilitiesMaybeInteger = TypeCapabilitiesMaybeInteger{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, soa: TypeCapabilitiesMaybeBoolean = TypeCapabilitiesMaybeBoolean{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, elem_ownership: ?TypeCapabilitiesMaybeSymbol = TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, elem_sync: ?TypeCapabilitiesMaybeSymbol = TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, elem_layout: ?TypeCapabilitiesMaybeSymbol = TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, link_source: ?TypeCapabilitiesMaybeSymbol = TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, observable: TypeCapabilitiesMaybeBoolean = TypeCapabilitiesMaybeBoolean{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, observable_terminal: ?TypeCapabilitiesMaybeSymbol = TypeCapabilitiesMaybeSymbol{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, observable_token: ?TypeCapabilitiesMaybeToken = TypeCapabilitiesMaybeToken{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, polymorphic_shared: TypeCapabilitiesMaybeBoolean = TypeCapabilitiesMaybeBoolean{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }) RETURNS !TypeCapabilities EFFECTS REENTRANT ->
  MUTABLE item_capabilities: ?TypeCapabilities = typeExpressionTree__linear_item_capabilities(self.shape.expression);
  MUTABLE update_item: Bool = FALSE;
  MUTABLE legacy_elem_ownership: ?String@symbol = COPY self.capabilities.elem_ownership;
  MUTABLE legacy_elem_sync: ?String@symbol = COPY self.capabilities.elem_sync;
  MUTABLE legacy_elem_layout: ?String@symbol = COPY self.capabilities.elem_layout;
  IF item_capabilities EXISTS AS item_capabilities_value THEN
    update_item = typeCapabilities__element_update_requested?(self.capabilities, elem_ownership, elem_sync, elem_layout);
    IF update_item THEN
      MUTABLE next_item_capabilities = typeCapabilities__with(item_capabilities_value, type__prefer_legacy_element_capability(elem_ownership, legacy_elem_ownership), TypeCapabilitiesMaybeBoolean{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, type__prefer_legacy_element_capability(elem_sync, legacy_elem_sync), type__prefer_legacy_element_capability(elem_layout, legacy_elem_layout));
      self.shape = TRY (typeShape__with_expression(self.shape, typeExpressionTree__with_linear_item_capabilities(self.shape.expression, next_item_capabilities)));
    END
  END
  self.capabilities = typeCapabilities__with(self.capabilities, ownership, TypeCapabilitiesMaybeBoolean{ TypeCapabilityUnset: COPY TypeCapabilityUnset{} }, sync_value, layout, lock_rank, collection, shard_count, soa, type__root_element_capability(update_item, elem_ownership), type__root_element_capability(update_item, elem_sync), type__root_element_capability(update_item, elem_layout), link_source, observable, observable_terminal, observable_token, polymorphic_shared);
  self.shape = TRY (typeShape__with_expression(self.shape, typeExpressionTree__with_root_capabilities(self.shape.expression, self.capabilities)));
  RETURN COPY self.capabilities;
END
