PUB FN type__ownership_surface_name(self: Type) RETURNS ?String ->
  MUTABLE own: ?String@symbol = type__ownership(self);
  IF own EXISTS AS own_value THEN
    RETURN type__ownership_surface_name_for(own_value);
  ELSE
    RETURN NIL;
  END
