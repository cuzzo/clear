PUB FN type__open_stream_marker?(self: Type) RETURNS Bool ->
  IF !(type__array?(self)) THEN
    RETURN FALSE;
  END
  MUTABLE cap: ?String@symbol = type__array_capacity_symbol(type__capacity(self));
  IF cap EXISTS AS cap_value THEN
