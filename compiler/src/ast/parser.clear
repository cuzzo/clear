FN clearParser__initialize(MUTABLE self: ClearParser, tokens: []Token, source_code: String = "", gradual: ?Bool = NIL, budget: ?FrontendResourceBudget = NIL) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.tokens = COPY tokens;
    rtoc_self_view.pos = 0;
    rtoc_self_view.source_code = COPY source_code;
    rtoc_self_view.budget = (budget OR_ELSE frontendResourceBudget__new());
    rtoc_self_view.delimiter_closings = TRY (clearParser__index_delimiter_closings(rtoc_self_view, tokens));
    rtoc_self_view.gradual = IF (gradual == NIL) THEN
      clearParser__gradual_mode()
    ELSE
      gradual
    END;
}
END
FN clearParser__gradual_mode() RETURNS Bool ->
  RETURN COPY gradual_mode_value;
END
FN clearParser__set_gradual_mode(value: Bool) RETURNS Bool ->
  gradual_mode_value = COPY value;
  RETURN COPY value;
END
FN clearParser__ownership_mode() RETURNS String@symbol ->
  RETURN COPY ownership_mode_value;
END
FN clearParser__set_ownership_mode(value: String@symbol) RETURNS String@symbol ->
  ownership_mode_value = COPY value;
  RETURN COPY value;
END
FN clearParser__parse_type_syntax(source: String, file: ?String = NIL) RETURNS !ParsedTypeSyntax
  EFFECTS REENTRANT
->
  MUTABLE budget = frontendResourceBudget__new();
  MUTABLE tokens = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_1 = (TRY (lexer__new(source, 0, file, 1, 1, 0, budget)));
  TRY (lexer__tokenize(&rtoc_mutable_receiver_1)) };
  MUTABLE parser = TRY (clearParser__new(tokens, source, NIL, budget));
  RETURN TRY (clearParser__parse_type_syntax_document(&parser));
END
FN clearParser__parse_type_syntax_document(MUTABLE self: ClearParser) RETURNS !ParsedTypeSyntax
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE syntax = TRY (clearParser__parse_type_annotation_syntax(&rtoc_self_view));
    MUTABLE current_token = clearParser__current(rtoc_self_view);
    IF !((current_token.type == :EOF)) THEN
      clearParser__error_mut(rtoc_self_view, current_token, CodeOrMessage{ SymbolValue: :PARSER_EXPECTED }, [], {:expected: "end of type", :got: "${token__display_value(current_token)}", :type: "${current_token.type}", :line: current_token.line.toString()});
    END
    RETURN syntax;
}
END
PUB FN clearParser__parse_source(source: String, file: ?String = NIL) RETURNS !Program
  EFFECTS REENTRANT
->
  MUTABLE budget = frontendResourceBudget__new();
  MUTABLE lexer = TRY (lexer__new(source, 0, file, 1, 1, 0, budget));
  MUTABLE tokens = TRY (lexer__tokenize(&lexer));
  MUTABLE parser = TRY (clearParser__new(tokens, source, NIL, budget));
  RETURN TRY (clearParser__parse(&parser));
END
FN clearParser__parse(MUTABLE self: ClearParser) RETURNS !Program
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
# Ruby converts a host SystemStackError here; CLEAR has no host stack to
# overflow, and FrontendResourceBudget already raises on nesting depth.
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN TRY (clearParser__parse_with_budget(&rtoc_self_view));
}
END
FN clearParser__parse_with_budget(MUTABLE self: ClearParser) RETURNS !Program
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE source_violation: ?Exceeded@multiowned = frontendResourceBudget__source_violation(rtoc_self_view.budget, rtoc_self_view.source_code);
    IF source_violation EXISTS AS source_violation_value THEN
      RAISE Input, ParserError, "Frontend ${source_violation_value.kind} resource limit exceeded (limit ${source_violation_value.limit.toString()})";
    END
    MUTABLE token_violation: ?Exceeded@multiowned = frontendResourceBudget__tokens_violation(rtoc_self_view.budget, rtoc_self_view.tokens.length);
    IF token_violation EXISTS AS token_violation_value THEN
      RAISE Input, ParserError, "Frontend ${token_violation_value.kind} resource limit exceeded (limit ${token_violation_value.limit.toString()})";
    END
    RETURN TRY (clearParser__parse_program(&rtoc_self_view));
}
END
FN clearParser__parse_program(MUTABLE self: ClearParser) RETURNS !Program
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE stmts: []Locatable = List[];
    WHILE (clearParser__current(rtoc_self_view).type != :EOF) DO
      MUTABLE stmt = TRY (clearParser__parse_statement(&rtoc_self_view));
      &stmts.append(stmt);
    END
    end_tok = clearParser__current(rtoc_self_view);
    MUTABLE program = Program{ token: COPY end_tok, statements: COPY stmts, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, sync_policy: NIL, mir_pass_state: NIL, language_mode: :default };
    MUTABLE first = (rtoc_self_view.tokens.first() OR_ELSE COPY end_tok);
    clearParser__stamp_source_range_mut(rtoc_self_view, Locatable{ Program: COPY program }, first, COPY end_tok);
    program.language_mode = IF rtoc_self_view.gradual THEN
      :easy
    ELSE
      clearParser__ownership_mode()
    END;
    RETURN program;
}
END
PRIVATE FN clearParser__closest_name(self: ClearParser, input: NameCandidate, candidates: []NameCandidate, max_distance: Int64 = 3) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE best: ?NameCandidate = NIL;
    MUTABLE best_distance: Int64 = (max_distance + 1);
    FOR _ IN candidates DO
    MUTABLE distance = clearParser__suggestion_levenshtein(rtoc_self_view, nameCandidate__text(input), nameCandidate__text(_));
    IF (distance < best_distance) THEN
        best = COPY _;
        best_distance = distance;
    END
    END
    IF (best_distance <= max_distance) THEN
      RETURN nameCandidate__text(UNWRAP (best));
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN clearParser__typo_anchor(token: ?Token) RETURNS AnchorToken ->
  IF token EXISTS AS tok THEN
    RETURN AnchorToken{ line: tok.line, column: tok.column };
  END
  RETURN AnchorToken{ line: 0, column: 0 };
END
PRIVATE FN clearParser__emit_typo_suggestion_mut(self: ClearParser, token: ?Token, name: String, candidates: []String, message: String, fix_label: String, category: String@symbol = :registry, cascade: Bool = TRUE) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE anchor: AnchorToken = clearParser__typo_anchor(token);
    MUTABLE token_line: Int64 = anchor.line;
    MUTABLE token_column: Int64 = anchor.column;
    MUTABLE named: []NameCandidate = candidates |> SELECT NameCandidate{ StringValue: COPY _ };
    MUTABLE best: ?String = clearParser__closest_name(rtoc_self_view, NameCandidate{ StringValue: COPY name }, named);
    MUTABLE fixes: []Fix = List[];
    IF best EXISTS AS best_value THEN
      &fixes.append(TRY (fix__new(TRY (diagnosticRegistry__fix_description(:REPLACE_IDENTIFIER_WITH_CANDIDATE, {:name: "${COPY name}", :best: "${best_value}", :label: "${fix_label}"})), [edit__new(span__new(NIL, token_line, token_column, name.codepointCount()), best_value)], :auto)));
    END
    IF (fixes.length == 0) THEN
      TRY (clearParser__error_mut(rtoc_self_view, token, CodeOrMessage{ SymbolValue: :TYPO_SUGGESTION_REJECTED }, [], {:detail: "${message}"}));
    END
    clearParser__fixable_mut(rtoc_self_view, token, category, fixes, NIL, :TYPO_SUGGESTION_REJECTED, :error, cascade, {:detail: "${message}"});
}
END
PRIVATE FN clearParser__suggestion_levenshtein(self: ClearParser, left: String, right: String) RETURNS Int64
  REQUIRES self: LOCAL
->
  IF (left.length == 0) THEN
    RETURN right.codepointCount();
  END
  IF (right.length == 0) THEN
    RETURN left.codepointCount();
  END
  MUTABLE previous: []Int64 = List[];
  MUTABLE fill = 0;
  WHILE fill <= right.length DO
    &previous.append(fill);
    fill = fill + 1;
  END
  MUTABLE left_index = 0;
  WHILE left_index < left.length DO
    MUTABLE current: []Int64 = [(left_index + 1)];
    MUTABLE right_index = 0;
    WHILE right_index < right.length DO
      MUTABLE rtoc_lc = left.substr(left_index, 1);
      MUTABLE rtoc_rc = right.substr(right_index, 1);
      MUTABLE cost = IF (rtoc_lc == rtoc_rc) THEN
          0
        ELSE
          1
        END;
      MUTABLE deletion = (UNWRAP (previous[(right_index + 1)]) + 1);
      MUTABLE insertion = (UNWRAP (current[right_index]) + 1);
      MUTABLE substitution = (UNWRAP (previous[right_index]) + cost);
      &current.append(min(min(insertion, deletion), substitution));
      right_index = right_index + 1;
    END
    previous = COPY current;
    left_index = left_index + 1;
  END
  RETURN UNWRAP (previous.last());
END
FN clearParser__new(tokens: []Token, source_code: String = "", gradual: ?Bool = NIL, budget: ?FrontendResourceBudget = NIL) RETURNS !ClearParser@multiowned ->
  MUTABLE self = ClearParser{ budget: (budget OR_ELSE frontendResourceBudget__new()), delimiter_closings: List[], gradual: FALSE, pos: 0, source_code: COPY source_code, tokens: COPY tokens, wrapper_operand_precedence: NIL };
  TRY (clearParser__initialize(&self, tokens, source_code, gradual, budget));
  RETURN self @multiowned;
END
