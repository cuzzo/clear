  safe: Bool
}

FN parsedExternEffects__to_h(self: ParsedExternEffects) RETURNS !{String@symbol}ExternEffectValue ->
  MUTABLE alloc_kind: ?String@symbol = COPY self.alloc;
  IF ((alloc_kind != NIL) AND self.safe) THEN
    RETURN {:alloc: ExternEffectValue{ SymbolValue: COPY alloc_kind }, :safe: ExternEffectValue{ BoolValue: TRUE }};
  END
  IF alloc_kind EXISTS AS alloc_kind_value THEN
    RETURN {:alloc: ExternEffectValue{ SymbolValue: COPY alloc_kind_value }};
  END
  IF self.safe THEN
    RETURN {:safe: ExternEffectValue{ BoolValue: TRUE }};
  END
  RETURN {};
END
