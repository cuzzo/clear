REQUIRE "pkg:rtoc_6173742f747970652e636c656172"
PUB STRUCT ParsedTypeSyntax {
  expression: TypeExpression,
  start_token: Token,
  end_token: Token,
  auto_token: ?Token,
  auto: Bool
}
PUB FN typeSyntaxLowering__lower(syntax: ParsedTypeSyntax) RETURNS !Type ->
  MUTABLE lowered = TRY (type__new(TypeConstructionInput{ TypeExpression: COPY syntax.expression }, NIL, NIL, NIL, NIL, NIL, NIL, NIL, NIL, NIL, syntax.auto));
  IF syntax.auto_token EXISTS AS auto_token_value THEN
    lowered.auto_token = auto_token_value;
  END
  RETURN lowered;
END
