FN diagnosticRegistry__all() RETURNS {String@symbol}{String@symbol}?DiagnosticEntryValue ->
  RETURN {:UNEXPECTED_TOKEN: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Unexpected token '%{value}' (%{type}). Expected an expression or statement." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Parser found a token where it expected something else." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The parser expected one shape (expression, statement, type, ...) and found a token that doesn't fit. Often comes from a missing keyword, a missed terminator, or a malformed expression." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Read the line where the unexpected token sits and the line above it. The grammar rule the parser was trying to match is usually obvious from context (in a function call, struct literal, type annotation, ...)." }}, :SELECT_EFFECT_COLON_REQUIRED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "SELECT effect annotations require a colon; use `%{selector}`." }, :summary: DiagnosticEntryValue{ StringValue: COPY "SELECT uses the same `:!`, `:?`, and `:!?` explicit-tense spelling as inferred bindings." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Insert `:` between SELECT and its effect marker." }}, :SELECT_MODIFIER_ORDER_INVALID: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Invalid SELECT modifier order `%{order}`. `?~`, `?!`, and `!?~` are not valid wrapper orderings." }, :summary: DiagnosticEntryValue{ StringValue: COPY "SELECT wrapper modifiers must follow the language's valid tense nesting order." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Put `~` outside `?`, and put `!` outside `?`; for example, use SELECT:~?, SELECT:!~, or SELECT:!~?." }}, :INVALID_ASSIGNMENT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Invalid assignment target. You can only SET variables, fields, or indices." }, :summary: DiagnosticEntryValue{ StringValue: COPY "The left-hand side of `=` is not a valid assignment target." }}, :MISSING_CAST_TYPE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Syntax Error: CAST expects a Type identifier after 'AS', got %{got}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "`CAST x AS <Type>` requires a TYPE_ID after `AS`." }}, :UNKNOWN_OPERATOR: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Unknown operator '%{value}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "The lexer saw an operator-shaped token it does not recognise." }}, :TYPE_NODE_LIMIT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type contains %{count} semantic nodes; the maximum is %{limit}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Type exceeds the compiler's semantic-node safety limit." }}, :TYPE_CAPABILITY_SITE_LIMIT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "Type contains %{count} capability-bearing nodes; the maximum is %{limit}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Type exceeds the capability-site readability limit." }}, :OPERATOR_TYPO_SUGGESTION: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Unknown operator `%{match}` -- did you mean `%{replace}`?" }, :summary: DiagnosticEntryValue{ StringValue: COPY "A source pre-scan found an operator typo with a mechanical replacement." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Accept the suggested replacement when the surrounding expression expects that operator." }}, :UNDEFINED_VAR: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Undefined variable '%{name}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "The named binding does not exist in scope." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The identifier doesn't resolve to any binding in the current scope (locals, parameters, captures) or any visible enclosing scope. Identifiers are resolved at annotation time; missing names always surface here." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Check the spelling. If the binding lives in a different module, add a REQUIRE. If it's a struct field or method, qualify with the receiver." }}, :UNRECOGNIZED_LITERAL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Unrecognized literal: %{value}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "The literal token doesn't match any known literal shape." }}, :IMMUTABLE_ASSIGNMENT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "Variable '%{name}' is immutable." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Assignment target was declared without `MUTABLE`; reassignment is rejected." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A binding declared without `MUTABLE` cannot be reassigned. CLEAR is immutable-by-default \u{2014} `MUTABLE x = 0` is required to allow `x = 1`." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Add `MUTABLE` at the binding's declaration site. `clear fix` offers this as an interactive fix when the declaration is locatable." }}, :NATIVE_CALL_ERROR: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :registry }, :template: DiagnosticEntryValue{ StringValue: COPY "native_call requires 'Class' and 'Method' string literals." }, :summary: DiagnosticEntryValue{ StringValue: COPY "`native_call` only accepts string-literal class/method args." }}, :FIXED_ARRAY_SIZE_AS_DYNAMIC: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot initialize fixed-array '%{name}' to an unknown size. You must TRUNCATE to a specific size, or use `[]` to create a dynamic array." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Fixed-size array `T[N]` requires a literal capacity." }}, :MUTABLE_BARE_NEEDS_TYPE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "MUTABLE bare declaration requires an explicit type annotation." }, :summary: DiagnosticEntryValue{ StringValue: COPY "`MUTABLE x;` (no `=` initializer) needs an explicit `: T[N]` so the parser can synthesize the default-zero list." }}, :CONST_NEEDS_TYPE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "CONST '%{name}' requires an explicit type annotation: `CONST %{name}: T = ...`." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A top-level CONST has no enclosing frame to infer from, so its type must be written explicitly." }}, :CONST_NEEDS_VALUE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "CONST '%{name}' requires an initializer: `CONST %{name}: T = expr`." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A CONST is an immutable comptime binding; it must be initialized at declaration." }}, :CONST_NEEDS_CAPS: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "CONST name '%{name}' must be SCREAMING_CASE (all uppercase)." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Constants are written in all-caps so a bare all-caps identifier reads as a constant reference; TitleCase names denote types." }}, :CONST_INIT_FALLIBLE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "CONST '%{name}' has a fallible initializer but a CONST has no error channel." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A runtime-initialized CONST is assigned once at program start; it cannot propagate a RAISE. Make the initializer infallible (allocation faults are still allowed) or compute the value inside a function." }}, :MUTABLE_BARE_NEEDS_FIXED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "MUTABLE bare declaration requires a fixed-size array type T[N]; got %{type}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Only `T[N]` (fixed-size primitive arrays) support default-init via `MUTABLE x: T[N];`. Use `= [...]` for other shapes." }}, :MUTABLE_BARE_BAD_ELEMENT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "MUTABLE bare declaration: cannot default-init element type %{type}; provide an explicit `= [...]` initializer." }, :summary: DiagnosticEntryValue{ StringValue: COPY "`MUTABLE xs: T[N];` only synthesizes zeros for primitive element types (Int, Float, String, Bool)." }}, :FIXED_ARRAY_SIZE_MISMATCH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot initialize array of size %{size} to fixed-size '%{name}'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Initializer's element count differs from the declared `T[N]`." }}, :IMMUTABLE_FIELD_ASSIGNMENT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot modify field '%{field}' of immutable object '%{name}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Field write through an immutable receiver is rejected." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A struct field assignment (`p.field = v`) requires the receiver binding `p` to be declared MUTABLE. CLEAR is immutable-by-default; without `MUTABLE p = ...`, no field of `p` can be reassigned." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Add `MUTABLE` at the receiver's declaration. Capability-wrapped bindings (`@locked`, `@alwaysMutable`) also permit field writes through their unwrapping rules." }}, :ILLEGAL_FIELD_LOOKUP: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Cannot determine struct type for field access '%{field}'. Receiver is '%{type}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Field access on a non-struct (or unresolved-type) target." }}, :OPTIONAL_FIELD_REQUIRES_SAFE_NAV: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Cannot access field '%{field}' on optional '%{type}' without safe navigation." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Field access on an optional value requires `?.` so NIL propagates safely." }, :cause: DiagnosticEntryValue{ StringValue: COPY "An indexed @list read and every other optional expression may be NIL. Plain `.` would silently assume a value exists and could turn an out-of-bounds read into a runtime trap." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use `%{target}?.%{field}`. The compiler then returns an optional field value and propagates NIL without dereferencing it." }}, :TENSE_NAVIGATION_MISMATCH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Tense navigation `%{markers}.` does not match receiver type `%{type}`; use `%{expected}.`." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Ordered tense navigation must name every effect layer on its receiver in exact order." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Skipping or reordering `!`, `~`, or `?` would make it unclear whether an error, future, or absence is being mapped." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Replace `%{markers}.` with `%{expected}.`, or explicitly consume a layer first with TRY, NEXT, UNWRAP, or OR_ELSE." }}, :TENSE_NAVIGATION_ORDER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "`%{markers}.` is not a valid ordered tense-navigation operator." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A tense layer may appear only in one of CLEAR's supported semantic orders." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Repeated, reversed, or skipped tense markers would make the navigation boundary ambiguous." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use the receiver's exact tense order: `?.`, `!.`, `!?.`, `~.`, `~!.`, `~?.`, `~!?.`, `!~.`, `!~!.`, `!~?.`, or `!~!?.`." }}, :TENSE_NAVIGATION_STREAM: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "`%{markers}.` maps one future value and cannot map stream `%{type}`." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Streams use SELECT rather than member-navigation mapping." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A stream can produce many values, while `~.` creates one derived future from one source future." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use `stream |> SELECT member` (with an ordered SELECT modifier when the member itself is fallible or optional)." }}, :TENSE_NAVIGATION_NESTED_FUTURE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Tense navigation cannot implicitly flatten nested future result `%{type}`." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Mapping an async member over a future would create an unsupported `~~T`." }, :cause: DiagnosticEntryValue{ StringValue: COPY "CLEAR has no implicit future flattening because that would hide an additional scheduling and ownership boundary." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use NEXT explicitly inside a BG block, or return a non-future member from the navigation." }}, :TENSE_NAVIGATION_MUTATION: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "Tense navigation `%{markers}.` cannot mutate an unresolved future payload." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Future mapping is read-only in this language version." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Mutation through `~.` would hide both a suspension boundary and the ownership location where the write occurs." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use NEXT inside a BG block, bind the resolved value explicitly, and mutate that binding with `&`." }}, :STRUCT_FIELD_UNRESOLVABLE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Struct '%{struct}' has no field '%{field}'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Field access on a struct that does not declare that field." }}, :ENUM_UNKNOWN_VARIANT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Enum '%{enum}' has no variant '%{variant}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Reference to a variant that the enum does not declare." }}, :ENUM_FIELD_ACCESS: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: '%{enum}' is an enum type. Enum values do not have fields." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Field access on an enum value (enum variants carry no fields)." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Enum variants in CLEAR are tag-only \u{2014} there's no payload to read. The set of enum values is fixed at declaration; `e.foo` would have nothing to return because variants carry no associated data." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use the enum value directly (`e == %{enum}.SomeVariant`), or `MATCH e START %{enum}.A -> ..., %{enum}.B -> ... END` for per-variant logic. If you need per-variant data, define a UNION instead \u{2014} variants there can carry payloads." }}, :UNION_UNKNOWN_VARIANT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Union '%{union}' has no variant '%{variant}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Reference to a variant that the union does not declare." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Union variants are closed-set: every legal variant name appears in the UNION declaration. References to variants outside that set can't be type-checked or pattern-matched, so the compiler rejects them at the use site." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Either pick an existing variant of `%{union}` (check the declaration), or add `%{variant}` to the UNION definition if it's a new case. Watch for typos \u{2014} the closest matching variant name is often what was intended." }}, :UNION_PAYLOAD_MISMATCH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Union variant '%{variant}' expects %{expected}, got %{got}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Union variant constructor passed a payload of the wrong type." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Each union variant declares a payload type at the UNION definition. Constructors must pass a value matching that declared type so the variant tag and payload stay in sync \u{2014} a `MATCH` on the variant later reads the payload as the declared type." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Pass a `%{expected}` for the payload, OR widen the declared payload type at the UNION definition if you legitimately want both types in this variant (consider a sibling variant for the alternative shape)." }}, :UNION_FIELD_ACCESS: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: '%{union}' is a union type. Access variants with 'Type.Variant(payload)'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Field access on a union value (use variant pattern matching instead)." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Union values carry a tag plus a payload; the payload's shape depends on the active variant. A bare `u.field` can't be type-checked because different variants have different (or no) fields. CLEAR routes you through MATCH so the active variant is known." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Pattern-match: `MATCH u START %{union}.SomeVariant AS x -> use(x), END`. The AS-binding gives you a typed handle on the payload only when the matched variant is active." }}, :UNION_INLINE_VARIANT_NEEDS_BRACES: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: '%{union}.%{variant}' is an inline struct variant \u{2014} use '%{union2}.%{variant2}{ field: value }' to construct it." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Inline-struct variant constructor requires braces, not parens." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Inline-struct variants carry named fields, not a single positional payload. Construction uses brace syntax (matching struct literals) so the field names are explicit at the construction site." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Switch from `%{union}.%{variant}(...)` to `%{union2}.%{variant2}{ field: value, ... }` \u{2014} each field named explicitly." }}, :UNION_INLINE_VARIANT_OLD_SYNTAX: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: '%{union}' variant '%{variant}' has inline struct fields \u{2014} use '%{union2}.%{variant2}{ field: value }' instead." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Old paren-style construction of an inline-struct variant." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Inline-struct variants migrated to brace-syntax construction; the old paren-style positional form was removed because it ambiguates field order across union evolution (adding a new field would silently shift positions)." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Rewrite the construction site to use named braces: `%{union2}.%{variant2}{ field: value, ... }`. Field order doesn't matter; missing fields raise an explicit error." }}, :UNION_INLINE_VARIANT_UNKNOWN_FIELD: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Union variant '%{union}.%{variant}' has no field '%{field}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Inline-struct variant literal references a field the variant doesn't declare." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Inline-struct variants are closed: their field set is fixed at the UNION definition. Constructors that name a field outside that set can't be checked, and silently dropping unknown fields would let typos pass." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Check the spelling against the declared fields of `%{union}.%{variant}`, drop the unknown field, or add it to the UNION's variant declaration if you need it." }}, :UNION_INLINE_VARIANT_TYPE_MISMATCH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Union variant '%{union}.%{variant}' field '%{field}' expects %{expected}, got %{got}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Inline-struct variant field receives a value of the wrong type." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Each field on an inline-struct variant declares a type at the UNION definition. The construction site must supply a value matching that type so MATCH-based readers see the field as the declared type." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Pass a `%{expected}` for `%{field}`, CAST the value if narrowing is intended (`CAST(value AS %{expected})`), or widen the field's declared type at the UNION definition." }}, :UNION_INLINE_VARIANT_MISSING_FIELD: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Union variant '%{union}.%{variant}' is missing required field '%{field}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Inline-struct variant literal omits a required field." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Inline-struct variants have no default values \u{2014} every declared field is required at construction so MATCH readers can rely on the payload being fully populated." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Add `%{field}: <value>` to the variant literal. If the field is genuinely optional, declare it as `?T` in the UNION definition and pass NIL when absent." }}, :UNION_INLINE_IN_GENERIC: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Inline struct variants are not supported in generic unions." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Generic unions don't yet support inline-struct variants." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Generic union variants currently support a single typed payload (`Variant: T`) so monomorphisation can substitute the payload type uniformly. Inline-struct variants would need per-instance field-type specialisation, which the monomorphiser doesn't yet handle." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Replace the inline-struct variant with a payload-typed variant whose payload is a separately-declared STRUCT (`STRUCT Foo { ... }; UNION U<T> { Bar: Foo, ... }`). The struct can still be generic via its own type parameter." }}, :UNION_METHOD_MISSING: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Union '%{union}' requires method '%{method}', but no function '%{fn}' exists." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Union METHOD-clause names a function that wasn't declared." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A `METHOD` clause on a UNION attaches an externally-declared function as a method on the union type. The compiler resolves the function by name when the UNION is annotated; if no matching function is in scope at that point, the method binding can't be created." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Define `FN %{fn}(...) ...` somewhere visible to the UNION declaration (same module, or imported via REQUIRE), or correct the name in the METHOD clause if it's a typo." }}, :UNION_METHOD_WRONG_ARITY: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Union '%{union}' method '%{method}' requires %{expected_arity} parameter(s), but function '%{fn}' has %{got_arity}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Method arity doesn't match the union's METHOD declaration." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The METHOD clause declares the method's signature (param count, types, return type); the bound function must match exactly so callers can dispatch through the union without surprises. Arity mismatch breaks the contract." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Adjust `%{fn}` to take exactly %{expected_arity} parameter(s), OR change the METHOD declaration on the UNION to match the function's actual arity." }}, :UNION_METHOD_PARAM_TYPE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Union '%{union}' method '%{method}' parameter %{index} expects '%{expected}', but function '%{fn}' has '%{got}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Method parameter type doesn't match the union's METHOD declaration." }, :cause: DiagnosticEntryValue{ StringValue: COPY "METHOD declarations specify each parameter's type; the bound function must match exactly so the union's method dispatch remains type-safe. A divergence here would let callers pass values the function won't accept." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Change `%{fn}`'s parameter %{index} to `%{expected}`, OR update the METHOD declaration to match the function's actual parameter type." }}, :UNION_METHOD_RETURN_TYPE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Union '%{union}' method '%{method}' requires return type '%{expected}', but function '%{fn}' returns '%{got}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Method return type doesn't match the union's METHOD declaration." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Callers of `u.%{method}()` see the return type declared on the UNION's METHOD clause; the bound function must return exactly that type so callers' downstream uses type-check. A mismatch would silently hand the caller a wrong-typed value." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Change `%{fn}`'s return type to `%{expected}`, OR update the METHOD declaration's return type to match the function." }}, :UNION_METHOD_WRONG_VISIBILITY: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Union '%{union}' method '%{method}' is declared %{declared_vis} but function '%{fn}' is %{fn_vis} \u{2014} visibility must match." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Method visibility doesn't match the union's METHOD declaration." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Union method visibility is declared on the METHOD clause and must match the underlying function's visibility. Allowing them to differ would let a private function leak as a public method (or vice-versa), breaking module boundaries." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Make the function's visibility match the METHOD declaration: change `FN %{fn}` to %{declared_vis}, OR change the METHOD declaration to %{fn_vis} so it matches the function." }}, :UNION_METHOD_DUPLICATE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Union '%{union}' declares method '%{method}' more than once." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Two METHOD clauses on the same union name the same function." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Each method name binds to exactly one function on a UNION. Two METHOD clauses with the same name would create dispatch ambiguity at every call site of `u.%{method}()`." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Drop one of the duplicate METHOD clauses, OR rename the second method on the UNION (and at its call sites) so each name is unique." }}, :MATCH_ENUM_CAPTURE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot capture payload from enum variant: enums have no payload. Remove 'AS %{binding}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "MATCH binding `AS x` not valid for enum variants (they have no payload)." }}, :MATCH_UNIT_CAPTURE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot bind 'AS %{binding}': '%{variant}' is a unit variant with no payload." }, :summary: DiagnosticEntryValue{ StringValue: COPY "MATCH binding `AS x` not valid for unit-shape union variants." }}, :GENERIC_DUPLICATE_TYPE_PARAM: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Duplicate type parameter '%{param}' in generic struct '%{struct}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Generic struct lists the same type parameter name twice." }}, :GENERIC_TYPE_PARAM_SHADOWS_BUILTIN: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Type parameter '%{param}' shadows built-in type '%{builtin}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Generic struct's type parameter shadows a built-in type name." }}, :GENERIC_MISSING_TYPE_ARGS: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: '%{type}' is a generic type \u{2014} type arguments are required (e.g., %{type2}<%{hint}>)." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Reference to a generic struct without supplying its type arguments." }}, :GENERIC_WRONG_ARG_COUNT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: '%{type}' expects %{expected} type argument(s), got %{got}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Generic instantiation has the wrong number of type arguments." }}, :GENERIC_UNKNOWN_TYPE_ARG: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Unknown type argument '%{type}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Type argument refers to a type that isn't in scope." }}, :GENERIC_NOT_GENERIC: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: '%{type}' is not a generic type \u{2014} remove the type arguments." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Type arguments supplied to a non-generic type." }}, :GENERIC_FN_DUPLICATE_PARAM: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Duplicate type parameter '%{param}' in generic function '%{fn}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Generic function lists the same type parameter name twice." }}, :GENERIC_FN_PARAM_SHADOWS_BUILTIN: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Type parameter '%{param}' in function '%{fn}' shadows built-in type '%{builtin}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Generic function's type parameter shadows a built-in type name." }}, :GENERIC_TYPE_PARAM_SHADOWS_NOMINAL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type parameter '%{param}' shadows a visible nominal type or protocol with the same name." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Generic parameter names must not hide visible type declarations." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Rename the parameter to a role name such as Item, ValueT, KeyT, or MapT." }}, :IMPLEMENTATION_UNKNOWN_OWNER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot implement unknown type '%{owner}'. Declare STRUCT %{owner} in this file first." }, :summary: DiagnosticEntryValue{ StringValue: COPY "An inherent implementation names no visible nominal type." }}, :IMPLEMENTATION_NONLOCAL_OWNER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot add inherent methods to non-local type '%{owner}'. Its STRUCT must be declared in this file." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Imported, foreign, built-in, and protocol-only types cannot be reopened with inherent methods." }}, :IMPLEMENTATION_DUPLICATE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type '%{owner}' already has an inherent IMPLEMENTATION block." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A nominal type has at most one inherent implementation." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Move these methods into the existing implementation block." }}, :IMPLEMENTATION_WRONG_FILE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot implement '%{owner}' in %{implementation_file}; its STRUCT is defined in %{owner_file}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Inherent methods must live in the exact file that defines their nominal type." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Move the IMPLEMENTATION block to the STRUCT's file, or keep the operation as a prefix FN." }}, :IMPLEMENTATION_BINDER_ARITY: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "IMPLEMENTATION %{owner} expects %{expected} owner binder(s) (%{expected_params}), got %{got}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "An implementation must bind every generic slot declared by its owner exactly once." }}, :IMPLEMENTATION_BINDER_HAS_BOUND: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Implementation binder '%{name}' must not repeat or replace the owner's bound." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Owner constraints are inherited from the primary STRUCT declaration." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Remove the ': ...' bound from the IMPLEMENTATION header." }}, :IMPLEMENTATION_BINDER_DUPLICATE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Implementation of '%{owner}' binds '%{name}' more than once." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Each owner generic slot needs a distinct local binder name." }}, :IMPLEMENTATION_BINDER_SHADOWS_TYPE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Implementation binder '%{name}' shadows a visible type with the same name." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Implementation binders must be unambiguous type-parameter names." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Rename the binder to a role name such as Item, ValueT, KeyT, or MapT." }}, :IMPLEMENTATION_DUPLICATE_MEMBER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "IMPLEMENTATION %{owner} declares '%{name}' more than once." }, :summary: DiagnosticEntryValue{ StringValue: COPY "An inherent implementation cannot contain duplicate member names." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Keep one member, or rename the operations so every owner/member pair is unique." }}, :IMPLEMENTATION_MEMBER_SHADOWS_OWNER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Member '%{member}' in IMPLEMENTATION %{owner} redeclares owner parameter '%{name}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Method-local generics cannot shadow generic parameters inherited from their owner." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Remove the repeated parameter from the METHOD, or give the method-local parameter a different role name." }}, :IMPLEMENTATION_METHOD_NEEDS_SELF: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "METHOD '%{name}' in IMPLEMENTATION %{owner} must declare self as its first parameter." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Inherent methods require an explicit receiver ownership parameter." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Start the parameter list with self, MUTABLE self, or TAKES self. Its owner type is inferred." }}, :CONFORMANCE_UNKNOWN_PROTOCOL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot implement unknown protocol %{protocol}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A conformance must name a declared PROTOCOL." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Declare or import the protocol before this IMPLEMENTATION." }}, :CONFORMANCE_ORPHAN: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot implement %{protocol} for non-local type %{owner}; this package owns neither side of the conformance." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Explicit conformances obey the orphan/coherence rule." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Move the conformance to the package defining the protocol or concrete STRUCT." }}, :CONFORMANCE_UNKNOWN_OWNER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot implement a protocol for unknown type %{owner}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A conformance owner must be a declared, imported, or built-in type." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Declare or import %{owner}, or correct the type name after FOR." }}, :CONFORMANCE_DUPLICATE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "%{owner} already has a %{protocol} conformance." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A protocol/concrete-type pair has exactly one conformance." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Keep one IMPLEMENTATION %{protocol} FOR %{owner} block." }}, :CONFORMANCE_PROTOCOL_ARITY: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Protocol %{protocol} expects %{expected} associated type argument(s), got %{got}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A conformance must bind every primary associated type exactly once." }}, :CONFORMANCE_OWNER_ARITY: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Conformance owner %{owner} expects %{expected} type argument(s), got %{got}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "The concrete type in a conformance must use its declared generic arity." }}, :CONFORMANCE_REQUIREMENTS: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "%{owner} does not satisfy %{protocol}: %{count} incompatible requirement(s):%{details}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "A conformance is checked completely at its declaration." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Implement every listed requirement with the exact receiver, parameter, return, ownership, and mutability contract." }}, :TOP_LEVEL_METHOD_REQUIRES_IMPLEMENTATION: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "METHOD '%{name}' must be inside IMPLEMENTATION Owner { ... }; top-level METHOD declarations are not owner-safe." }, :summary: DiagnosticEntryValue{ StringValue: COPY "User methods belong to the nominal type's same-file implementation block." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Move this declaration beside its STRUCT and wrap it in IMPLEMENTATION Owner<...> { ... }. Keep it as FN if it should remain a free prefix function." }}, :DOT_CALL_REQUIRES_METHOD: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "'%{name}' is a free FN, not a METHOD. Call %{name}(value, ...) or declare a same-file METHOD in the owner's IMPLEMENTATION block." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Dot syntax never falls through to an unrelated free function." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use prefix or pipeline syntax for FN, or declare an inherent METHOD on the receiver's nominal type." }}, :UNKNOWN_INHERENT_METHOD: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type %{type} has no inherent METHOD named '%{name}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Dot lookup found no intrinsic, extern, or owner-declared method." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Check the method name, use prefix syntax for a free FN, or add the METHOD to the type's defining-file IMPLEMENTATION block." }}, :GENERIC_UNKNOWN_PROTOCOL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Unknown generic protocol %{protocol}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A generic bound must name a declared protocol." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use Map for an intrinsic map constraint, or declare/import the intended PROTOCOL." }}, :GENERIC_PROTOCOL_BOUND_FAILED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "%{parameter} requires %{protocol}, but %{actual} does not conform." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A concrete generic argument does not satisfy its protocol bound." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Pass a concrete map such as {String}Value, or provide a valid protocol conformance." }}, :GENERIC_SHARED_BOUND_FAILED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "%{parameter} requires SHARED %{protocol}, but %{actual} is not shared." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A shared generic bound preserves synchronization at type formation." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use a shared map capability such as {String}@shared:locked Value." }}, :GENERIC_SHARED_MAP_REQUIRES_WITH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "%{type} has a caller-selected shared Map capability and cannot be accessed directly." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A SHARED Map generic must cross an explicit polymorphic synchronization boundary." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Wrap the operation in `WITH POLYMORPHIC %{type} AS map { ... }` and access the `map` alias inside the block." }}, :GENERIC_PROJECTION_UNKNOWN_OWNER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot resolve %{owner}::%{member}: %{owner} is not a generic parameter in this declaration." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Associated types can only be projected from an in-scope constrained parameter." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Declare %{owner} in <...>, or use the intended in-scope generic parameter name." }}, :GENERIC_PROJECTION_NEEDS_PROTOCOL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot resolve %{owner}::%{member}: %{owner} is not constrained by %{protocol}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "An associated projection requires a protocol that declares it." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Change the declaration to <%{owner}: %{protocol}>." }}, :GENERIC_UNKNOWN_ASSOCIATED_TYPE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "%{protocol} has no associated type %{owner}::%{member}; available: %{available}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "The projection is not declared by the parameter's protocol." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use one of the listed associated types." }}, :GENERIC_AMBIGUOUS_ASSOCIATED_TYPE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot resolve %{owner}::%{member}: it is declared by multiple bounds (%{protocols})." }, :summary: DiagnosticEntryValue{ StringValue: COPY "An associated projection must identify one protocol declaration." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use protocols with distinct associated-type names, or remove the redundant bound." }}, :GENERIC_PROTOCOL_METHOD_UNKNOWN: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "%{protocols} has no METHOD named '%{name}'. Available: %{available}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A constrained generic value exposes only methods declared by its protocols." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use a listed METHOD, strengthen the protocol, or call a free FN with prefix syntax." }}, :GENERIC_PROTOCOL_METHOD_AMBIGUOUS: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "METHOD '%{name}' is declared by multiple bounds: %{protocols}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Static protocol dispatch requires one unambiguous requirement." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use protocols with distinct method names or split this operation behind a named adapter FN." }}, :GENERIC_PROTOCOL_FUNCTION_AMBIGUOUS: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "FN '%{name}' is declared by multiple bounds: %{protocols}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Static protocol dispatch requires one unambiguous function requirement." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use protocols with distinct function names or introduce one explicitly named adapter FN." }}, :CONFORMANCE_BINDERS_CANNOT_INFER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot infer %{owner}'s %{expected} generic binder(s) from the protocol arguments; found %{got}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A generic conformance must bind every owner slot exactly once." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Name the missing binders before the protocol, for example `IMPLEMENTATION<T> Protocol FOR %{owner}`." }}, :GENERIC_MAP_KEY_MISMATCH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Map protocol indexing expects %{expected}, but this key is %{actual}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A constrained map must be indexed by its associated Key type." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use a value of the map's M::Key type." }}, :GENERIC_MAP_METHOD_UNKNOWN: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Map has no stable protocol method '%{name}'. Available: %{available}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Generic code may use only operations declared by its protocol bound." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use one of the stable Map operations, or add a stronger user protocol." }}, :GENERIC_MAP_METHOD_ARITY: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Map.%{name} expects %{expected} argument(s), but got %{actual}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "The generic Map operation was called with the wrong arity." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Pass exactly the required key/value arguments." }}, :GENERIC_MAP_METHOD_ARGUMENT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Map.%{name} argument %{position} expects %{expected}, but got %{actual}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "The argument does not match the Map conformance's associated type." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use the constrained map's M::Key or M::Value type." }}, :GENERIC_FN_CANNOT_INFER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Cannot infer type argument '%{param}' for '%{fn}' \u{2014} no parameter uses type '%{type}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Generic function call: a type parameter isn't constrained by any argument." }}, :GENERIC_FN_CONFLICT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Conflicting inference for '%{param}' in '%{fn}': got '%{first}' and '%{second}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Generic function call: the same type parameter inferred to two different types." }}, :IS_A_NEEDS_COMPTIME: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "`IS_A` type predicates must be written as `COMPTIME IF`." }, :summary: DiagnosticEntryValue{ StringValue: COPY "`IS_A` with a type operand is a compile-time predicate." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A type predicate branches while the compiler is specializing code, not while the program is running." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Insert `COMPTIME` before `IF`." }}, :IS_A_OPERAND_NEEDS_TYPE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: %{side} side of IS_A must be a type, got %{got}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "`IS_A` compares compile-time type values; both operands must be types." }, :cause: DiagnosticEntryValue{ StringValue: COPY "`IS_A` is a compile-time type predicate. A normal value such as an Int64, Bool, struct instance, or local variable cannot appear on either side." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use a type parameter or type name on both sides, and place the predicate under COMPTIME IF." }}, :IS_A_RUNTIME_NEEDS_UNION: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Runtime IS_A requires a union-typed value on the left, got %{got}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "`value IS_A Variant` only works for closed union values." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The runtime form of `IS_A` is sugar for checking a union value's active tag. Non-union values do not carry a variant tag." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use `COMPTIME IF T IS_A SomeType THEN ... END` for static type-parameter checks, or change the value's type to a UNION and test one of that union's variants." }}, :IS_A_RUNTIME_UNKNOWN_VARIANT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Runtime IS_A target %{target} is not a variant of union %{union}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "`value IS_A Target` must name a variant of the value's union type." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The compiler lowers runtime `IS_A` to an active-tag comparison. That requires resolving the target to exactly one variant in the subject union." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use the explicit variant path, for example `%{union}.SomeVariant`, or choose a payload type that appears in exactly one variant of the union." }}, :IS_A_RUNTIME_AMBIGUOUS_PAYLOAD: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Runtime IS_A target %{target} matches multiple variants of union %{union}: %{variants}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Payload-type shorthand for runtime `IS_A` must resolve to one variant." }, :cause: DiagnosticEntryValue{ StringValue: COPY "More than one variant in the union carries the requested payload type, so the shorthand would not say which active tag to test." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use the explicit variant path, for example `%{union}.SomeVariant`, to remove the ambiguity." }}, :MISSING_FUNCTION: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Missing function '%{name}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Call site refers to a function name that isn't declared." }}, :ARITY_MISMATCH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Function '%{name}' expects %{expected} arguments, got %{got}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Call site passes the wrong number of arguments." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The call site passes a different number of arguments than the function declares. CLEAR doesn't allow ad-hoc overloading; arity must match exactly (with optional defaults filling missing trailing args)." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Check the function's signature. If you wanted to skip arguments, declare them with defaults at the function. If you wanted variadic behaviour, use a list parameter." }}, :ARITY_MISMATCH_RANGE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Function '%{name}' expects between %{min} and %{max} arguments, got %{got}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Variadic-or-defaults function call passes a count outside the allowed range." }}, :ARGUMENT_TYPE_ERROR: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Function '%{fn}' argument %{index} expects %{expected}, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Argument value's type doesn't match the parameter's declared type." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The argument's type doesn't match the parameter's declared type. Coercion was tried (slice widening, primitive autocast, generic substitution) and failed." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Check the argument and the parameter's declared type \u{2014} the message gives both. Either change the argument, change the parameter's type, or use CAST." }}, :PRIMITIVE_PASSED_AS_MUTABLE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "Parameter '%{name}' is MUTABLE but has primitive type '%{type}'. Primitives are passed by value, so mutating them locally has no effect on the caller." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Declaring a primitive-typed parameter `MUTABLE` is meaningless (pass-by-value)." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Reserved for a future warning: declaring a primitive-typed parameter `MUTABLE` is a footgun. CLEAR's `MUTABLE x: T` mutates the caller's binding through the parameter \u{2014} but for primitives (Int64, Float64, Bool, etc.), the parameter is a copy and writes to it never reach the caller. The check would fire on `FN bump(MUTABLE x: Int64) -> x = x + 1; END`, suggesting either dropping `MUTABLE` (if the local-only mutation is intentional) or returning the new value." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "While the check isn't wired, ask: did you mean to mutate the caller's variable? If so, return the new value and assign at the call site. If the local-only mutation is intentional, drop `MUTABLE` from the parameter declaration." }, :pending: DiagnosticEntryValue{ BoolValue: TRUE }}, :IMMUTABLE_ARG_PASSED_AS_MUTABLE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "Argument %{index} ('%{param}') is MUTABLE, but you passed immutable variable '%{actual}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Callee's MUTABLE parameter requires a mutable binding at the call site." }}, :MUTABLE_ARGUMENT_REQUIRES_MARKER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mutability }, :template: DiagnosticEntryValue{ StringValue: COPY "Argument %{index} ('%{param}') is MUTABLE. Pass '%{actual}' as '&%{actual}' so the mutation is explicit at this call site." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A MUTABLE parameter requires an explicit `&` marker on the value it may mutate." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Insert `&` before the argument. If the local binding is immutable, also declare it MUTABLE." }}, :MUTABLE_MARKER_ON_IMMUTABLE_PARAM: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mutability }, :template: DiagnosticEntryValue{ StringValue: COPY "Argument %{index} ('%{param}') is not MUTABLE, so it must not be passed with '&'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "The call site claims the callee mutates an argument whose parameter is not MUTABLE." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Remove `&`, or make the callee parameter MUTABLE if mutation is part of its contract." }}, :MUTABLE_MARKER_ON_ANONYMOUS_VALUE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mutability }, :template: DiagnosticEntryValue{ StringValue: COPY "Argument %{index} ('%{param}') is an anonymous value. Pass it directly; '&' only marks mutation of existing storage." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Anonymous temporaries do not need an explicit mutation marker because no caller binding can observe their mutation." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Remove `&` from the anonymous expression." }}, :MUTABLE_MARKER_REQUIRES_CALL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mutability }, :template: DiagnosticEntryValue{ StringValue: COPY "'&' is only valid on an argument passed to a MUTABLE parameter or before a mutating method receiver." }, :summary: DiagnosticEntryValue{ StringValue: COPY "CLEAR's `&` is an explicit call-site mutation marker, not a first-class pointer/reference operator." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use `&value` only inside a call, or `&value.method(...)` when the method mutates value." }}, :LEGACY_MUTATION_NAME_SUFFIX: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mutability }, :template: DiagnosticEntryValue{ StringValue: COPY "Identifier suffix '!' no longer marks mutation. Mutation is declared by MUTABLE and made explicit on affected values with '&'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "CLEAR no longer encodes mutation in function or method names." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Remove the `!` suffix; the call-site checker will insert `&` on values passed to MUTABLE parameters." }}, :INF_STREAM_SELECT_MOVES_ITEM: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "SELECT over an infinite stream cannot MOVE the item (GIVE / TAKES): an [~INF]T rendezvous stream never drains, so moved payloads could be left in flight at teardown. Observe the item (borrow / COPY) or bound the stream with LIMIT into a finite pipeline first." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Ownership-moving selectors are rejected on infinite stream sources." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use a borrowing or COPY selector, or apply LIMIT before the moving SELECT." }}, :RETIRED_OPTIONAL_STREAM_SYNTAX: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Retired stream type syntax '%{got}'. Streams put the tense/cardinality layer first: use '%{replacement}'. ([~]T = unbound-finite, [~N]T = bound-finite, [~INF]T = infinite; NEXT on [~]T returns a StreamStep unwrapped with EXISTS.)" }, :summary: DiagnosticEntryValue{ StringValue: COPY "The '~?T[]' open-stream alias is retired; the accepted spellings are [~]T, [~N]T, and [~INF]T." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Replace the annotation with the suggested cardinality-first spelling." }}, :RETURN_MISMATCH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Function expected to return '%{expected}', but returned '%{got}'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "RETURN value's type doesn't match the function's declared return type." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A RETURN statement's value doesn't match the function's declared return type. Coercion was tried and failed." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Either change the returned value to match the declared return type, or change the declared return type to match what the function actually returns." }}, :STATIC_UNKNOWN_TYPE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Unknown type '%{type}'. Cannot perform '::' static method call." }, :summary: DiagnosticEntryValue{ StringValue: COPY "`T::method` where T is not a known type." }}, :STATIC_NOT_RESOURCE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: '%{type}' does not support '::' static method calls. Only resource types have static constructors." }, :summary: DiagnosticEntryValue{ StringValue: COPY "`T::method` only works on resource-shaped types (e.g., TCPServer::listen)." }}, :STATIC_UNKNOWN_METHOD: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: No static method '%{method}' on '%{type}'. Available: %{available}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "`T::method` where T is a resource type but doesn't declare that static method." }}, :STATIC_ARITY: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: '%{type}::%{method}' expects %{expected} argument(s), got %{got}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Static-method call passes the wrong number of arguments." }}, :STATIC_ARG_TYPE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Argument %{index} to '%{type}::%{method}': expected %{expected}, got %{got}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Static-method call argument has the wrong type." }}, :DUPLICATE_OWNERSHIP_CAP: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "Duplicate ownership" }, :summary: DiagnosticEntryValue{ StringValue: COPY "More than one ownership-axis sigil (`@multiowned`, `@shared`, `@split`, `@link`)." }}, :DUPLICATE_SYNC_CAP: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "Duplicate sync" }, :summary: DiagnosticEntryValue{ StringValue: COPY "More than one sync-axis sigil (`@locked`, `@writeLocked`, `@local`, `@versioned`, `@atomic`, `@raw`, `@symbol`)." }}, :DUPLICATE_LAYOUT_CAP: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "Duplicate layout" }, :summary: DiagnosticEntryValue{ StringValue: COPY "More than one layout-axis sigil (currently `@boxed` is the only layout sigil)." }}, :DUPLICATE_SOA_CAP: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "Duplicate soa" }, :summary: DiagnosticEntryValue{ StringValue: COPY "`@soa` applied more than once on the same type." }}, :DUPLICATE_COLLECTION_CAP: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "Duplicate collection" }, :summary: DiagnosticEntryValue{ StringValue: COPY "More than one collection sigil (`@list`, `@pool`, `@set`)." }}, :DUPLICATE_SHARD_COUNT_CAP: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "Duplicate shard count" }, :summary: DiagnosticEntryValue{ StringValue: COPY "`@sharded(N)` declared more than once on the same type." }}, :DUPLICATE_OBSERVABLE_CAP: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "Duplicate observable" }, :summary: DiagnosticEntryValue{ StringValue: COPY "`@observable` declared more than once on the same type." }}, :DUPLICATE_LOCK_RANK: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "Duplicate rank on capability chain (already %{current}, cannot also set %{attempted})." }, :summary: DiagnosticEntryValue{ StringValue: COPY "`@locked(rank: N)` / `@writeLocked(rank: N)` rank set twice on the same chain." }}, :DUPLICATE_CAPABILITY_DIM: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "Duplicate %{dim} capability: already have @%{current}, cannot add @%{attempted}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Two sigils on the same axis (ownership / sync / layout) \u{2014} pick one." }}, :UNKNOWN_CAPABILITY_MODIFIER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "Unknown capability modifier: %{value}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Capability sigil isn't recognised." }}, :UNKNOWN_CAPABILITY_SIGIL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "Unknown capability sigil '%{value}'. Expected @multiowned, @shared, @locked, @writeLocked, @local, @versioned, @atomic, or @boxed" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Capability sigil after `:` in a chain isn't one of the recognised set." }}, :UNKNOWN_WITH_CAPABILITY: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "Unknown WITH capability: %{value}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "WITH-block capability keyword (`EXCLUSIVE`, `BORROWED`, `RESTRICT`, `VIEW`, `MATERIALIZED`, `GUARD`) isn't recognised." }}, :MIXED_AT_CAPABILITIES: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot use two separate @ capabilities. Join with ':' instead (e.g., @shared:locked not @shared @locked)." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Two `@cap` sigils side-by-side \u{2014} they must be joined with `:`." }}, :EXPECTED_CAP_SIGIL_AFTER_COLON: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Expected a capability sigil after ':'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Capability-chain `:` not followed by a sigil." }}, :EXPECTED_CAP_AFTER_COLON: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Expected a capability modifier after ':'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Capability `:` not followed by a recognized modifier." }}, :EXPECTED_RANK_KEYWORD: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Expected 'rank' keyword inside @%{sigil}(...) arguments." }, :summary: DiagnosticEntryValue{ StringValue: COPY "`@locked(...)` / `@writeLocked(...)` argument list must start with `rank:`." }}, :CAP_BAD_MODIFIER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "Expected 'sharded(N)' or 'soa' after '%{cap}:' \u{2014} unknown modifier '%{modifier}'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Modifier after `@<container>:` isn't recognised (only `sharded(N)` and `soa` are valid)." }}, :SHARDED_TOO_FEW: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "@pool:sharded / @list:sharded requires N >= 2, got %{count}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "`@sharded(N)` requires at least 2 shards." }}, :SIGIL_N_NONPOSITIVE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "%{sigil}(N) requires a positive integer N (got %{count})." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Sigil with `(N)` parameter (`@sharded(N)`, etc) requires N > 0." }}, :DUPLICATE_REQUIRES_CLAUSE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Function '%{fn}' has duplicate REQUIRES clause for '%{name}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Same name listed in two REQUIRES clauses on one function." }}, :UNKNOWN_REQUIRES_FAMILY: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Unknown REQUIRES family or kind '%{name}'. Expected a capability family (%{families}) or a reentrance kind (%{kinds})." }, :summary: DiagnosticEntryValue{ StringValue: COPY "REQUIRES clause references a name that isn't a known family or kind." }}, :UNKNOWN_REQUIRES_KIND: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Unknown REQUIRES kind '%{value}'. Valid: NON_REENTRANT." }, :summary: DiagnosticEntryValue{ StringValue: COPY "REQUIRES kind isn't `NON_REENTRANT`." }}, :EXPECTED_CAP_FAMILY: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Expected capability family, got reentrance kind" }, :summary: DiagnosticEntryValue{ StringValue: COPY "REQUIRES expected a capability family (LOCKED, ATOMIC, ...) but saw a reentrance kind." }}, :UNKNOWN_EFFECT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Unknown effect ':%{value}'. Valid effects: :alloc, :safe" }, :summary: DiagnosticEntryValue{ StringValue: COPY "EXTERN-effect annotation references an unknown effect tag." }}, :UNKNOWN_FN_EFFECT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Unknown effect '%{value}'. Function-level EFFECTS only accepts REENTRANT today." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Function-level EFFECTS clause references something other than REENTRANT." }}, :UNKNOWN_ALLOC_QUALIFIER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Unknown alloc qualifier ':%{value}'. Use :alloc:frame or :alloc:heap" }, :summary: DiagnosticEntryValue{ StringValue: COPY "EXTERN `:alloc` effect needs a `:frame` or `:heap` qualifier." }}, :UNKNOWN_REENTRANT_VARIANT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Unknown REENTRANT variant ':%{value}'. Valid: :TIGHT, :TIGHT:THUNK, :TIGHT:TAIL_CALL, :THUNK, :TAIL_CALL, :NOT_LOGICAL, :MAX_DEPTH(N)." }, :summary: DiagnosticEntryValue{ StringValue: COPY "EFFECTS REENTRANT variant isn't one of the recognised set." }}, :INVALID_TIGHT_VARIANT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY ":TIGHT:%{label} is invalid. %{explanation}" }, :summary: DiagnosticEntryValue{ StringValue: COPY ":TIGHT:<label> only allows :THUNK or :TAIL_CALL." }}, :MAX_DEPTH_NONPOSITIVE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY ":MAX_DEPTH(N) requires a positive integer N (got %{got})." }, :summary: DiagnosticEntryValue{ StringValue: COPY "EFFECTS REENTRANT:MAX_DEPTH(N) needs N > 0." }}, :WITH_GUARD_REQUIRES_AS: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "WITH GUARD requires an AS alias so the guard can reference the unwrapped value" }, :summary: DiagnosticEntryValue{ StringValue: COPY "WITH GUARD must bind an alias (`AS x`) so the guard body can reference the unwrapped value." }}, :WITH_MATCH_NO_WHEN: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "WITH MATCH requires at least one WHEN arm." }, :summary: DiagnosticEntryValue{ StringValue: COPY "WITH MATCH block has no WHEN arms." }}, :SYNC_POLICY_NO_HANDLER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "SYNC POLICY block must contain at least one ON / RETRY handler." }, :summary: DiagnosticEntryValue{ StringValue: COPY "SYNC POLICY block needs at least one ON / RETRY clause." }}, :RETRY_N_NONPOSITIVE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "RETRY(N) requires N > 0, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "RETRY count must be positive." }}, :EXPECTED_ERROR_SELECTOR: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Expected error selector: a kind like 'Transient' or a type like 'LockTimeout'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "ON / CATCH clause needs a kind name (e.g. Transient) or type name (e.g. LockTimeout)." }}, :EXPECTED_AFTER_ERROR_CLAUSE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Expected RAISE, PASS, RETURN <expr>, EXIT \"msg\", or -> { ... } after error clause" }, :summary: DiagnosticEntryValue{ StringValue: COPY "ON / CATCH selector must be followed by an action." }}, :CATCH_WITH_BAD_INNER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Expected a type name (e.g. ParseErr) or a string message inside CATCH WITH(...)" }, :summary: DiagnosticEntryValue{ StringValue: COPY "`CATCH WITH(...)` filter takes a type or a string-literal message." }}, :UNKNOWN_BRANCH_PREFIX: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Unknown branch prefix %{value}. Valid: @micro, @stack, @standard, @large, @xl, @service, @pinned, @parallel, @canSmash." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Branch-prefix sigil on a DO block isn't recognised." }}, :DUPLICATE_STACK_SIZE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Duplicate stack size in %{kind} prefix" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Two stack-size sigils (`@micro`, `@stack`, `@standard`, `@large`, `@xl`, `@service`) on one block." }}, :UNKNOWN_BG_PREFIX: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Unknown BG prefix %{value}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "BG-block prefix sigil isn't recognised." }}, :EXPECTED_THEN_AFTER_AS_BG: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Expected THEN after AS binding in BG block, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "BG `{ AS name -> body }` binding must be followed by THEN." }}, :VISIBILITY_BAD_KIND: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Expected FN, METHOD, STRUCT, ENUM, or UNION after visibility modifier, got '%{got}'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "PUB / PRIVATE / PACKAGE must be followed by a declaration keyword." }}, :EXTERN_BAD_KIND: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Expected FN or STRUCT after EXTERN, got '%{got}'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "EXTERN must be followed by FN or STRUCT." }}, :STUB_BAD_AFTER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Expected RETURNS, CAPTURES, SEQUENCE, or WITH after STUB %{fn}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "STUB <fn-name> must be followed by RETURNS, CAPTURES, SEQUENCE, or WITH." }}, :MULTIPLE_BINDINGS_NEED_PARENS: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Syntax Error: Multiple optional bindings require parentheses around each binding.\n  Found: IF expr EXISTS AS name AND expr EXISTS AS name THEN\n  Use:   IF (expr EXISTS AS name) AND (expr EXISTS AS name) THEN" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Optional-binding chains in IF need each `expr EXISTS AS name` parenthesised." }}, :CONDITIONAL_BINDING_UNDER_OR: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "A conditional capture is not definite beneath `OR`; move `EXISTS AS`/`IS_OK AS` into an `AND` chain or use separate branches." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Conditional captures compose left-to-right through `AND`, but are not in scope after `OR`." }}, :FRONTEND_RESOURCE_LIMIT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Frontend %{kind} resource limit exceeded (limit %{limit}); simplify or split this source." }, :summary: DiagnosticEntryValue{ StringValue: COPY "The source exceeded a deterministic lexer/parser resource budget." }}, :OPTIONAL_BINDING_REQUIRES_EXISTS: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Optional binding must state its test: use `expr EXISTS AS name`, not `expr AS name`." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Optional conditional bindings require the explicit postfix `EXISTS` predicate." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Insert `EXISTS` before `AS`; `clear fix` applies this mechanically." }}, :EXISTS_REQUIRES_OPTIONAL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "`EXISTS` requires an optional value, got '%{got}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Postfix `EXISTS` tests whether `?T` contains a value." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Remove `EXISTS` when the value is already non-optional, or correct the expression's type to `?T`." }}, :AMBIGUOUS_OPTIONAL_BOOL_LOGIC: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Ambiguous ?Bool %{op} operand: presence and payload truth are different questions. Choose `value EXISTS` (is a Bool present?) or `(value OR_ELSE FALSE)` (is its payload true, defaulting NIL to false?)." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Logical use of `?Bool` must choose presence or payload truth explicitly." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use `value EXISTS` for presence, or `(value OR_ELSE FALSE)` for payload truth. `clear fix` offers both edits for named values." }}, :STRING_CONCAT_REQUIRES_DOLLAR: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "String concatenation uses `$+`; `+` is numeric addition." }, :summary: DiagnosticEntryValue{ StringValue: COPY "String concatenation must use the dedicated `$+` operator." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Replace `+` with `$+`; `clear fix` applies this when operand types prove the expression is string concatenation." }}, :IS_OK_REQUIRES_FALLIBLE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "`IS_OK` requires a fallible value, got '%{got}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Postfix `IS_OK` tests whether `!T` succeeded." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Remove `IS_OK` when the value is not fallible, or correct the expression's type to `!T`." }}, :IS_READY_CANNOT_BIND: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "`IS_READY` only polls settlement and cannot bind a payload. Use `IF future IS_READY THEN ...` and consume the outcome with `NEXT`." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Readiness does not imply that a future succeeded, so `IS_READY AS` is invalid." }}, :IS_READY_REQUIRES_FUTURE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "`IS_READY` requires a single future, got '%{got}'. Streams and promise lists have no single settled state." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Postfix `IS_READY` polls a single future without consuming it." }}, :INSERT_EXISTS_BEFORE_AS: {:severity: DiagnosticEntryValue{ SymbolValue: :hint }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Insert `EXISTS` before `AS`." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Migrates a legacy optional binding to explicit presence testing." }}, :EXPECTED_IDENT_AFTER_AS: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Syntax Error: Expected identifier after 'AS', got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "`AS` binding requires a plain identifier as the new name." }}, :EXPECTED_NUMBER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Expected a number, got %{value} (%{type})" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Numeric literal expected at this position." }}, :EXPECTED_SYMBOL_AFTER_COLON: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Expected a symbol name (lowercase identifier) after ':'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "After `:` in this context, the parser expects a lowercase symbol name." }}, :AUTO_NOT_ALLOWED_IN_FIELD: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Auto is not allowed in %{context} field declarations. Field '%{field}' must have a concrete type. Cross-callsite field inference is intentionally not supported -- replace `Auto` with the field's actual type (e.g. Int64, String, Foo[], HashMap<String, Bar>)." }, :summary: DiagnosticEntryValue{ StringValue: COPY "`Auto` cannot be used as the type of a struct / union / enum field." }}, :AUTO_PREFIX_NOT_SUPPORTED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "`%{prefix}Auto` is not supported. `Auto` cannot be combined with the prefix `%{prefix2}` -- the inferred type's wrapping is not defined yet. Use `Auto` alone (the inferencer will pick the concrete type) or write the wrapped type explicitly (e.g. `%{prefix3}Int64`, `%{prefix4}String`)." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Sigil-prefixed `Auto` (e.g. `?Any`, `!Auto`, `%Auto`) isn't supported." }}, :ARRAY_TYPE_BAD: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Syntax Error: Expected ']', '*', '?', 'INF', or size in array type." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Array type opener `[` not followed by a recognised size / capacity marker." }}, :ARRAY_TYPE_EXPECTED_SIZE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Syntax Error: Expected ']' or size in array type." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Array-type size position needs a literal or a recognised marker." }}, :CONCURRENT_BAD_OP: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Expected SELECT, WHERE, EACH, SUM, COUNT, MIN, MAX, or AVERAGE after CONCURRENT, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "CONCURRENT must be followed by a recognised pipeline stage." }}, :DEFER_NO_CONTROL_FLOW: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "%{kind} is not allowed inside a DEFER body \u{2014} deferred code runs during scope teardown, where redirecting control flow is meaningless." }, :summary: DiagnosticEntryValue{ StringValue: COPY "DEFER bodies cannot contain RETURN/BREAK/CONTINUE/YIELD (same restriction as Zig defer)." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Move the control-flow statement outside the DEFER body." }}, :PARSER_EXPECTED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Expected %{expected}, got %{got} (%{type}) line %{line}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Generic Expected-X-got-Y. Used by the central `consume()` parser helper." }}, :PARSER_EXPECTED_AT_END_OF_LINE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Expected `%{expected}` at end of line %{expected_line}; got '%{got}' on line %{got_line}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Parser expected a token at the end of the previous line." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Insert the expected token at the end of the previous line." }}, :PARSER_EXPECTED_BEFORE_TOKEN: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Expected `%{expected}`, got '%{got}' (line %{line})." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Parser expected a token before the current token." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Insert the expected token before the current token." }}, :UNEXPECTED_TOKEN_LINE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :syntax }, :template: DiagnosticEntryValue{ StringValue: COPY "Unexpected token %{value} (%{type}) line %{line}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Generic Unexpected-token. Used when the primary parser hits a token outside its grammar." }}, :WITH_CAP_BAD_TARGET: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "WITH %{capability} expects an identifier or field, got '%{got}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "WITH-block capture target must be a binding name or field, not an arbitrary expression." }, :cause: DiagnosticEntryValue{ StringValue: COPY "WITH unwraps a *binding* (or a field path rooted at one). The acquire/unwrap dance \u{2014} lock acquire, snapshot CAS, refcount bump \u{2014} needs a stable name to operate on. A function call or arbitrary expression has no scope-tracked identity, so the unwrap can't be paired with a release at scope exit." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Bind the value to a local first, then take WITH on the local: `x = produce(); WITH EXCLUSIVE x { ... }`. For field paths, name the root binding directly (`WITH EXCLUSIVE c.field { ... }`)." }}, :WITH_EXCLUSIVE_NEEDS_LOCK: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "EXCLUSIVE capability requires a @locked or @writeLocked variable, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "WITH EXCLUSIVE only applies to bindings declared with `@locked` or `@writeLocked`." }, :cause: DiagnosticEntryValue{ StringValue: COPY "WITH EXCLUSIVE acquires a write lock \u{2014} the binding must carry a lock to acquire. On a plain `T` there's nothing to lock, so the acquire would be a no-op or, worse, mask a missing-lock bug at runtime." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Either annotate the declaration with `@locked` (Mutex \u{2014} single-writer EXCLUSIVE access) or `@writeLocked` (RwLock \u{2014} readers via WITH READ; writers via WITH EXCLUSIVE), or drop WITH EXCLUSIVE if no lock is actually needed (the value can be used directly)." }}, :WITH_READ_NEEDS_WRITE_LOCK: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "WITH %{name}: read access requires a @writeLocked variable" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Read-style WITH on a `@locked` (read-only) cell is rejected \u{2014} use `@writeLocked` if reads need to coexist with writes." }, :cause: DiagnosticEntryValue{ StringValue: COPY "WITH READ takes a shared (reader) lock so multiple readers can coexist. A `@locked` Mutex has no reader/writer split \u{2014} every acquire is exclusive \u{2014} so WITH READ has nowhere to dispatch. Only `@writeLocked` (RwLock) supports the reader path." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Promote the binding from `@locked` to `@writeLocked` (RwLock \u{2014} readers via WITH READ alongside writers via WITH EXCLUSIVE), OR keep `@locked` and switch the reader to WITH EXCLUSIVE (single-writer access; readers and writers serialize)." }}, :WITH_RESTRICT_NEEDS_MUTABLE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "RESTRICT capability requires a mutable variable, but '%{name}' is immutable" }, :summary: DiagnosticEntryValue{ StringValue: COPY "WITH RESTRICT scopes mutable poisoning \u{2014} the captured binding must itself be MUTABLE." }, :cause: DiagnosticEntryValue{ StringValue: COPY "WITH RESTRICT establishes an exclusive mutable borrow scope: writes through the alias are visible to the source, and the source can't be aliased elsewhere during the block. Both halves of that contract require the source binding to be mutable in the first place \u{2014} there's nothing to RESTRICT on an immutable value." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Declare the binding with `MUTABLE` at its definition (`MUTABLE %{name} = ...`). If the binding is intentionally immutable, drop the RESTRICT and use `WITH BORROWED` (immutable read-through) instead." }}, :WITH_MATERIALIZED_NEEDS_TENSE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "WITH MATERIALIZED VIEW requires a `~T` (tense) source, got %{got} for '%{name}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "MATERIALIZED VIEW snapshots a tense / observable source \u{2014} the binding must have type `~T`." }, :cause: DiagnosticEntryValue{ StringValue: COPY "MATERIALIZED VIEW snapshots a *tense aggregate* (`~T`) at the WITH boundary \u{2014} copying its current contents into an owned, locally-scoped value. On a non-tense source there's no snapshot semantics: the binding is already concrete, and the MATERIALIZED prefix has no effect to apply." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Prefix the declared type with `~` so the source is tense (`MUTABLE %{name}: ~T = ...`), OR drop the MATERIALIZED clause and use the source directly (no WITH needed for a non-tense aggregate)." }}, :WITH_VIEW_NEEDS_OBSERVABLE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "WITH VIEW requires an `@observable` source, but '%{name}' has type %{got}. Use `WITH MATERIALIZED VIEW` for non-observable aggregates, or annotate the binding as `~T@observable`." }, :summary: DiagnosticEntryValue{ StringValue: COPY "WITH VIEW can only borrow a live observable aggregate." }, :cause: DiagnosticEntryValue{ StringValue: COPY "WITH VIEW reads a live observable aggregate in place. Non-observable tense values can still be read safely, but only by taking a materialized snapshot." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use `WITH MATERIALIZED VIEW` for non-observable aggregates, or change the binding declaration to `~T@observable` and initialize it from a pipeline-terminal fold." }}, :WITH_UNSAFE_VIEW_NEEDS_FOREIGN_POINTER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "WITH UNSAFE VIEW requires an `[]@c T` foreign pointer, got %{got}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "UNSAFE VIEW is the explicit trust boundary for a raw foreign pointer and asserted length." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Ordinary CLEAR collections already carry their bounds and can be indexed directly. Only a raw C pointer lacks the allocation extent that UNSAFE VIEW supplies." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use the ordinary collection directly, or bind an `[]@c T` result and write `WITH UNSAFE VIEW pointer LENGTH count AS values { ... }`." }}, :FOREIGN_VIEW_REQUIRES_WITH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "Foreign pointers do not have a `.view()` method. Use `WITH UNSAFE VIEW pointer LENGTH count AS values { ... }` so the asserted bound and borrow are lexical." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A foreign pointer-to-slice conversion must be visibly unsafe and scoped." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A raw C pointer does not carry its allocation length or lifetime. Returning a normal slice from a method call would let the asserted borrow escape and hide the unsafe boundary." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Replace `values = pointer.view(count)` with `WITH UNSAFE VIEW pointer LENGTH count AS values { ... }` and keep every use of `values` inside the block." }}, :FOREIGN_POINTER_DIRECT_INDEX: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot index %{name} directly: `[]@c T` has no trusted bound. Use `WITH UNSAFE VIEW %{name} LENGTH count AS values { ... }`." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Raw foreign pointers must be bounded in an explicit lexical unsafe view before indexing." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The C ABI supplies an address but no allocation extent. Direct indexing would silently trust an unknown bound and could invoke undefined behavior." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Wrap the statement in `WITH UNSAFE VIEW %{name} LENGTH count AS values { ... }`, replace `count` with the C allocation's real element count, and index `values` inside the block." }}, :WITH_VIEW_FOREIGN_NEEDS_UNSAFE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "`WITH VIEW %{name}` cannot safely view an unbounded C pointer. Use `WITH UNSAFE VIEW %{name} LENGTH count AS values { ... }`." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Foreign pointer views require an explicit unsafe marker and asserted element count." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Ordinary WITH VIEW borrows an object whose representation already knows its extent. An `[]@c T` pointer carries no extent, so using the safe form would conceal the programmer assertion." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Add `UNSAFE` and a `LENGTH` expression obtained from the C API. The suggested zero length is a safe scaffold and must be replaced before accessing elements." }}, :DIRECT_VIEW_ACCESS_REQUIRES_WITH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot access %{name} directly. Use `WITH %{permission} %{name} AS value { ... }` and access the scoped alias." }, :summary: DiagnosticEntryValue{ StringValue: COPY "This value requires a scoped view before its contents can be accessed." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The outer value represents live or capability-controlled state. Reading through it directly would bypass the snapshot/borrow boundary represented by WITH VIEW." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Wrap the containing statement in `WITH %{permission} %{name} AS value { ... }` and replace direct accesses with `value`." }}, :WITH_SNAPSHOT_NEEDS_VERSIONED_OR_ATOMIC: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "WITH SNAPSHOT requires a @versioned or @boxed:atomic variable. '%{name}' is %{actual}. Declare the binding as `T@versioned` / `T@shared:versioned` for an MVCC cell, or `T@boxed:atomic` for a lock-free atomic-pointer cell." }, :summary: DiagnosticEntryValue{ StringValue: COPY "WITH SNAPSHOT only works on MVCC cells (`@versioned`) or atomic-pointer cells (`@boxed:atomic`)." }, :cause: DiagnosticEntryValue{ StringValue: COPY "WITH SNAPSHOT reads a stable view of a cell that publishes new values atomically. MVCC (`@versioned`) and AtomicPtr (`@boxed:atomic`) are the two sync families that maintain such snapshots; other bindings have no snapshot infrastructure, so the SNAPSHOT acquire has nothing to capture." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Add `@versioned` (MVCC \u{2014} readers see a stable snapshot, writers retry on conflict) or `@boxed:atomic` (lock-free atomic pointer cell \u{2014} readers snapshot, writers CAS-publish) to `%{name}`'s declaration. For non-snapshotted reads, use WITH EXCLUSIVE (locks) or direct access (refcounted handles) instead." }}, :CAP_FIELD_NEEDS_WITH_EXCLUSIVE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot read field '%{field}' of %{cap} binding '%{name}' directly. Wrap with `WITH EXCLUSIVE %{name} AS x { ... x.%{field} ... }` to acquire the lock and unwrap the inner value." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Direct field access on a locked binding requires WITH EXCLUSIVE to acquire the lock first." }, :cause: DiagnosticEntryValue{ StringValue: COPY "`@locked` (Mutex) and `@writeLocked` (RwLock) bindings hide the inner T behind a lock. Reading `c.field` directly would skip the lock acquire \u{2014} which is unsound \u{2014} and the underlying type doesn't have the field anyway (it has `.ctrl`/`.data` and a lock). The compiler routes you through `WITH EXCLUSIVE` so the lock is acquired, the inner T is exposed via the alias, and the lock is released at scope end." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Wrap the access in a WITH EXCLUSIVE block: `WITH EXCLUSIVE c AS x { print(x.field.toString()); }`. Both `@locked` and `@writeLocked` bindings use WITH EXCLUSIVE \u{2014} there's no separate read-only form on a Mutex, and `@writeLocked` reads still need the writer lock to safely access state." }}, :CAP_FIELD_NEEDS_WITH_SNAPSHOT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot read field '%{field}' of %{cap} binding '%{name}' directly. Wrap with `WITH SNAPSHOT %{name} AS x { ... x.%{field} ... }` to take a stable snapshot of the cell." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Direct field access on an atomic-pointer cell requires WITH SNAPSHOT to read a stable T." }, :cause: DiagnosticEntryValue{ StringValue: COPY "`@boxed:atomic` is a CAS-published heap cell \u{2014} the inner T can be swapped out by other fibers between reads. Direct field access `c.field` would race against publishers, and the underlying `*AtomicPtr(T)` type doesn't have the field anyway. WITH SNAPSHOT loads the current pointer once and binds the alias to that snapshot; the alias's view is stable for the body's duration." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Wrap the access in a WITH SNAPSHOT block: `WITH SNAPSHOT c AS x { print(x.field.toString()); }`. For mutating updates, use `WITH SNAPSHOT MUTABLE c AS x { x.field = ...; }` \u{2014} the runtime CAS-publishes the modified clone at scope exit." }}, :WITH_NEEDS_MULTIOWNED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "WITH %{name}: expected a @multiowned variable" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Inferred capability requires a `@multiowned` (Rc) binding." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Plain `WITH x` infers the capability from `x`'s sigil. Inference resolved to `:multiowned` because the path expected a refcounted handle, but the binding doesn't carry `@multiowned` \u{2014} there's no Rc to clone, so the unwrap can't proceed. (Defensive check: in practice this branch fires only if storage briefly looks like multiowned but the symbol no longer carries it.)" }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Annotate the declaration with `@multiowned` (Rc \u{2014} single-scheduler refcount; cheap clones on WITH), OR pick a different capability whose semantics fit the binding (`@shared` for cross-fiber, `@locked` for mutable-shared)." }}, :WITH_NEEDS_SHARED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "WITH %{name}: expected a @shared variable" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Inferred capability requires a `@shared` (Arc) binding." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Plain `WITH x` resolved to `:shared` (Arc) capability but the binding doesn't carry `@shared` \u{2014} there's no atomic refcount to bump on WITH entry. (Defensive: like WITH_NEEDS_MULTIOWNED, fires only when storage briefly looks shared but the symbol disagrees.)" }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Annotate the declaration with `@shared` (Arc \u{2014} atomic refcount; safe to clone across fibers), OR pick a different capability if the binding doesn't need cross-fiber sharing." }}, :WITH_ATOMIC_NEEDS_SHARED_ATOMIC: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "WITH ATOMIC requires an @shared:atomic variable. '%{name}' is %{actual}, not @shared:atomic." }, :summary: DiagnosticEntryValue{ StringValue: COPY "WITH ATOMIC needs a binding declared `T@shared:atomic`." }, :cause: DiagnosticEntryValue{ StringValue: COPY "WITH ATOMIC dispatches to lock-free atomic primitives (load, store, fetchAdd, ...) on a `@shared:atomic` cell. Other bindings don't have those primitives wired \u{2014} the unwrap has no atomic-op surface to expose." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Add `@shared:atomic` to `%{name}`'s declaration so it lowers to a lock-free cell. For non-atomic shared mutation, use `@shared:locked` + `WITH EXCLUSIVE` instead." }}, :UNKNOWN_WITH_CAP_TYPE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "Unknown capability type: %{type}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Internal annotator error \u{2014} WITH-block dispatch saw a capability tag it doesn't know." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The annotator's WITH-block dispatch table doesn't have a handler for the capability tag `%{type}`. This is an internal compiler bug (or a stale build): every legal capability should have a corresponding dispatch arm. User code can't trigger this directly." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "If you saw this from a user program, please report it as a compiler bug with the source snippet that triggered it. As a workaround, verify the capability sigil is one of: `@multiowned`, `@shared`, `@locked`, `@writeLocked`, `@versioned`, `@shared:atomic`, `@boxed:atomic`, `@local`." }}, :WITH_CANNOT_INFER_CAP: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "WITH %{name}: cannot infer capability; variable must be @multiowned, @shared, @locked, @writeLocked, @versioned, @shared:atomic, or another capability type" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Plain WITH without an explicit capability needs the binding to carry a recognised one." }}, :WITH_GUARD_NOT_WITH_MATCH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "WITH GUARD is not supported with WITH MATCH yet. WITH MATCH dispatches per-arm based on the binding's sync family; GUARD evaluates a single predicate after acquire. The two haven't been integrated. Run the GUARD check before the WITH MATCH (in the surrounding scope), or split the polymorphic-dispatch and guard-predicate concerns into two separate blocks." }, :summary: DiagnosticEntryValue{ StringValue: COPY "WITH MATCH and WITH GUARD can't be combined in the current release." }, :cause: DiagnosticEntryValue{ StringValue: COPY "WITH MATCH switches the body shape based on the binding's sync family (LOCKED / ATOMIC / VERSIONED arms). WITH GUARD attaches a post-acquire predicate that aborts the body when false. The matching layer hasn't been wired through the per-arm preludes yet, so combining them is rejected." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Move the GUARD predicate to a regular `IF` at the top of the body (each WITH MATCH arm checks the predicate itself), or restructure so GUARD-checked bindings are acquired in a separate (non-MATCH) WITH block that nests inside or wraps the polymorphic block." }}, :WITH_GUARD_NOT_ON_SNAPSHOT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "WITH GUARD is not supported on mutable SNAPSHOT transactions in this release. Read-only SNAPSHOT works (the guard runs against the snapshot view); MUTABLE SNAPSHOT is rejected because the transaction would have to retry on guard failure, which interacts with the MVCC commit retry loop." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Mutable SNAPSHOT transactions don't support WITH GUARD yet." }, :cause: DiagnosticEntryValue{ StringValue: COPY "MUTABLE SNAPSHOT runs the body inside an MVCC retry loop \u{2014} on commit-failure it re-executes the body. GUARD-failure also wants to abort the body, but its semantics (don't retry, don't commit) conflict with the MVCC retry contract." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use read-only `WITH SNAPSHOT c AS s GUARD ...` (drop MUTABLE), check the predicate AFTER the SNAPSHOT block reads, or move the mutation into a separate non-snapshot path." }}, :WITH_GUARD_ALL_BINDINGS_NEED_AS: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "WITH GUARD requires every participating binding to have an `AS` alias so the guard predicate can read the unwrapped value. Add `AS <alias>` to each binding in the WITH clause." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Each binding in a WITH GUARD must use `AS <name>` so the guard body can read it." }, :cause: DiagnosticEntryValue{ StringValue: COPY "WITH GUARD's predicate runs after each acquire and reads the unwrapped value. Without an AS alias, the unwrapped form has no name in scope \u{2014} the predicate would have nothing to read." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Add `AS <name>` to every binding in the WITH clause: `WITH EXCLUSIVE c AS x EXCLUSIVE d AS y GUARD x.v + y.v > 0 { ... }`." }}, :WITH_GUARD_EXPR_MUST_BE_BOOL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "WITH GUARD expression must return Bool, got %{got}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "The guard predicate's type must be Bool." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The GUARD predicate gates body execution: TRUE proceeds, FALSE raises GuardFail. A non-Bool expression has no defined truth value, so it's rejected at type-check." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Wrap the guard expression so it returns Bool (e.g. `x.v > 0`, `x.name == \"ready\"`, `x.flags.contains(.active)`). If you intended a side effect, move it before the WITH and only test a Bool inside GUARD." }}, :WITH_GUARD_REFS_SIBLING_ALIAS: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "WITH GUARD '%{own_alias}' references '%{name}', a sibling alias bound by the same WITH. Multi-object consistency for aliased objects is not supported: synchronized sources (locked, atomic, versioned) cannot provide a cross-object atomic snapshot, so a guard spanning multiple aliases would be checking values that are no longer consistent by the time the body runs. Each GUARD may only reference its own alias. %{remediation}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "A WITH GUARD predicate can only read its own alias, not sibling aliases bound by the same WITH." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A GUARD expression in a multi-binding WITH block refers to a sibling alias from the same WITH. The sibling isn't in scope yet at guard-evaluation time \u{2014} guards run after each individual acquire, not after all of them." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Move the guarded binding to its own WITH block, or restructure so the guard only references the binding it guards." }}, :WITH_GUARD_MUTABLE_MUTATED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "WITH GUARD aliases cannot be MUTABLE and mutated inside the body: %{names} %{verb} declared MUTABLE and mutated inside the WITH. Only MUTABLE objects that change inside the body are rejected because their value could be modified after the GUARD predicate evaluates, silently invalidating it. Drop the mutation, drop MUTABLE from the alias, or move the mutation outside the guarded WITH." }, :summary: DiagnosticEntryValue{ StringValue: COPY "GUARD aliases mutated inside the body would silently invalidate the guard." }, :cause: DiagnosticEntryValue{ StringValue: COPY "GUARD predicates evaluate ONCE, immediately after acquire. If the body then mutates the alias, the post-mutation state may no longer satisfy the predicate \u{2014} but the body keeps running because there's no re-check. To prevent silent invalidation, the compiler rejects the alias being both MUTABLE and mutated inside the body." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Pick one: (a) drop `MUTABLE` from the alias if you don't need to write through it; (b) drop the body's mutation if the read-only path is enough; (c) move the mutation outside the guarded WITH (acquire, check, release, then re-acquire MUTABLE for the write)." }}, :BORROW_WILDCARD_NEEDS_STRUCT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "Wildcard borrow '*' requires a struct type, but '%{name}' is %{type}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "`WITH BORROWED x.*` only applies to struct-typed targets \u{2014} it expands to per-field borrows." }, :cause: DiagnosticEntryValue{ StringValue: COPY "`WITH BORROWED x.*` is sugar for `BORROWED x.field1 BORROWED x.field2 ...`. The wildcard expansion only makes sense on a struct (which has named fields). Lists, maps, primitives, etc. don't expand." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Borrow the whole binding instead: `WITH BORROWED %{name} { ... }`. For collections, iterate or index inside the body rather than borrowing each element." }}, :WITH_BORROWED_ON_QUALIFIED_VAR: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot use WITH BORROWED on %{qualifier} variable '%{name}'. %{remediation}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "WITH BORROWED rejected because the source binding is qualified in a way that conflicts." }, :cause: DiagnosticEntryValue{ StringValue: COPY "WITH BORROWED produces an immutable read-through alias. Some qualifier on the source (e.g. an `@boxed:atomic` cell, a tense source, a lock-only binding) requires going through that qualifier's unwrap \u{2014} a plain BORROWED would skip the synchronisation or transformation the qualifier provides." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use the unwrap form that matches the binding's qualifier: `WITH SNAPSHOT` for atomic / versioned cells, `WITH EXCLUSIVE` / `WITH READ` for locks, `WITH MATERIALIZED VIEW` for tense aggregates. The remediation in the message names the specific replacement." }}, :PRE_EXPR_MUST_BE_BOOL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "PRE expression must return Bool, got %{got}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "PRE-condition must be a Bool-typed expression." }}, :DEBUG_POST_EXPR_MUST_BE_BOOL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "DEBUG_POST expression must return Bool, got %{got}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "DEBUG_POST predicate must be a Bool-typed expression." }}, :DEBUG_POST_NEEDS_UNSYNC_PARAM: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "DEBUG_POST cannot reference synchronized parameter '%{name}'. The predicate runs after the function returns and any locks have been released; reading a synchronized field outside its lock is racy. Move the check inside a WITH block in the body, or assert against an unsynchronized snapshot value instead." }, :summary: DiagnosticEntryValue{ StringValue: COPY "DEBUG_POST runs after lock release \u{2014} referencing a synchronized parameter is a data race." }}, :DEBUG_POST_NOT_WITH_CATCH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "DEBUG_POST clauses cannot be combined with CATCH on the same function. Split into two functions (one with CATCH, one with DEBUG_POST that calls it), or move the assertion into a separate validation helper." }, :summary: DiagnosticEntryValue{ StringValue: COPY "DEBUG_POST and CATCH on the same function aren't supported." }}, :PRE_CLAUSES_NEED_EXPLICIT_FALLIBLE_RETURN: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Function '%{fn}' has PRE clauses but no explicit return type. PRE clauses can fail at runtime, so the function must declare an error-union return. Add `RETURNS !Void` (or `RETURNS !T` for a value-returning function) to the signature." }, :summary: DiagnosticEntryValue{ StringValue: COPY "PRE clauses require an explicit fallible return type." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Add `RETURNS !Void` for an otherwise Void function, or `RETURNS !T` for a value-returning function." }}, :FALLIBLE_RETURN_NEEDS_ERROR_UNION: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Function '%{fn}' can fail (%{hint}) but its return type doesn't declare it. Change `RETURNS %{return_type}` to `RETURNS !%{return_type}` so callers can see the error union and handle it (Zig-style discipline). Add a CATCH at the call site, propagate via `try`, or mark the call's result with `OR <action>`." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A fallible function must declare an error-union return type." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Prefix the declared return type with `!`, or handle the failure before it crosses the function boundary." }}, :PURE_FN_CANNOT_CALL_IMPURE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "%{surface} must be pure, but '%{callee}' %{reason}. %{hint}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "A pure context (PRE / GUARD / etc) calls something that has observable side effects." }}, :LOCAL_VAR_NOT_IN_PARALLEL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "@local variable cannot be used in @parallel block \u{2014} it requires single-scheduler affinity." }, :summary: DiagnosticEntryValue{ StringValue: COPY "`@local` storage is per-scheduler; `@parallel` distributes across schedulers, breaking the affinity guarantee." }}, :MULTIOWNED_NOT_IN_PARALLEL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "@multiowned (Rc) variable cannot be used in @parallel block \u{2014} Rc uses a non-atomic reference count. Use @shared (Arc) for cross-scheduler sharing." }, :summary: DiagnosticEntryValue{ StringValue: COPY "`@multiowned` uses non-atomic refcounting and isn't safe across `@parallel` schedulers." }}, :PIPE_BAD_DESTINATION: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Invalid pipe destination. Must be a Function Call or Identifier." }, :summary: DiagnosticEntryValue{ StringValue: COPY "The right-hand side of `|>` must be a function call or a bare identifier." }}, :PIPE_NOT_CALLABLE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot pipe into non-callable '%{name}' (Resolved Type: %{type})" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Tried to pipe into something that isn't a function or method." }}, :COLLECT_NEEDS_OBSERVABLE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "COLLECT requires a `~T@observable` source, got %{got}. Streaming aggregates produce observables when the source is a tense stream; non-observable sources fold synchronously and don't need COLLECT." }, :summary: DiagnosticEntryValue{ StringValue: COPY "COLLECT only applies to observable sources (`~T@observable`)." }}, :WHERE_NEEDS_BOOL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "WHERE clause must evaluate to a definite synchronous Bool, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "WHERE filter expressions cannot leave optional, fallible, or asynchronous predicate effects unresolved." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Resolve !Bool with TRY or OR_ELSE, resolve ?Bool with UNWRAP or OR_ELSE, and NEXT asynchronous work before it reaches WHERE." }}, :SELECT_EFFECT_ANNOTATION_REQUIRED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "SELECT expression returns %{got}. Preserve that effect explicitly with `%{selector}`, or consume it inside the SELECT expression." }, :summary: DiagnosticEntryValue{ StringValue: COPY "SELECT must not silently propagate fallible or optional element results." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use SELECT:!, SELECT:?, or SELECT:!? to retain element effects; use TRY, UNWRAP, or OR_ELSE inside SELECT to consume them." }}, :SELECT_EFFECT_ANNOTATION_MISMATCH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "SELECT:%{declared} does not match selector result %{got}; use `%{expected}`." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A SELECT effect annotation must exactly describe the unconsumed selector result." }}, :PIPE_CLAUSE_NEEDS_BOOL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "%{clause} clause must evaluate to Bool, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Predicate-style pipeline clauses (FIND / ANY / ALL / COUNT) need a Bool result." }}, :TAKE_WHILE_NEEDS_BOOL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "TAKE_WHILE predicate must evaluate to Bool, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "TAKE_WHILE's predicate must produce a Bool." }}, :PIPE_NEEDS_NUMERIC: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "%{op} requires a numeric expression, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Numeric-aggregation stages (SUM / AVERAGE / MIN / MAX) require a numeric expression." }}, :EACH_NEEDS_COLLECTION: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot EACH non-collection type %{got}. EACH requires an array, @list, @list:sharded(N), @pool, @pool:sharded(N), or a range" }, :summary: DiagnosticEntryValue{ StringValue: COPY "EACH operates on collections only." }}, :TAP_NEEDS_COLLECTION: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot TAP non-collection type %{got}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "TAP operates on collections only." }}, :UNNEST_NEEDS_ARRAY: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "UNNEST requires an array expression, got %{got}. Use SELECT instead for non-array fields." }, :summary: DiagnosticEntryValue{ StringValue: COPY "UNNEST flattens nested arrays \u{2014} non-array inputs should use SELECT." }}, :SELECT_NEEDS_LIST: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot SELECT from non-list type %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "SELECT operates on list-shaped inputs." }}, :PIPE_OP_NEEDS_LIST: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot %{op} non-list type %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Generic 'this pipeline op needs a list' \u{2014} message names which op." }}, :CONCURRENT_EACH_BAD_INPUT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "CONCURRENT EACH input must be a finite stream or collection, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "CONCURRENT EACH can't run on infinite streams." }}, :WINDOW_SIZE_NEEDS_NUMBER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "WINDOW size must be a number, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "WINDOW size: option must be a numeric expression." }}, :WINDOW_SIZE_NEEDS_POSITIVE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "WINDOW size must be > 0" }, :summary: DiagnosticEntryValue{ StringValue: COPY "WINDOW size: option must be a positive integer." }}, :WINDOW_TIME_NEEDS_STRING_LIT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "WINDOW time must be a string literal like '500ms' or '1s'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "WINDOW time: option needs a string literal in `<n><unit>` form." }}, :WINDOW_TIME_BAD_FORMAT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "WINDOW time format must be like '500ms', '1s', '2min', '1h', got '%{got}'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "WINDOW time: literal didn't match the supported unit shapes." }}, :WINDOW_TIME_NEEDS_POSITIVE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "WINDOW time must be > 0" }, :summary: DiagnosticEntryValue{ StringValue: COPY "WINDOW time: must resolve to a positive duration." }}, :WINDOW_NEEDS_SIZE_OR_TIME: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "WINDOW requires at least one of size: or time:" }, :summary: DiagnosticEntryValue{ StringValue: COPY "WINDOW needs at least one of size: / time: to define the boundary." }}, :WINDOW_BAD_OPTION: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Unknown WINDOW option '%{name}', valid: %{valid}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "WINDOW option key isn't recognised." }}, :WINDOW_NEEDS_COLLECTION_INPUT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "WINDOW(size:, time:) requires a collection or stream input" }, :summary: DiagnosticEntryValue{ StringValue: COPY "WINDOW only operates on collections / streams." }}, :LIMIT_COUNT_NEEDS_NUMBER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "LIMIT count must be a number, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "LIMIT N \u{2014} N must be a numeric expression." }}, :SKIP_COUNT_NEEDS_NUMBER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "SKIP count must be a number, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "SKIP N \u{2014} N must be a numeric expression." }}, :JOIN_RIGHT_NEEDS_LIST: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "JOIN right source must be a list, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "JOIN's right-hand source must be a list-shaped collection." }}, :JOIN_LAMBDA_ARITY: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "JOIN lambda must take exactly 2 parameters" }, :summary: DiagnosticEntryValue{ StringValue: COPY "JOIN's predicate lambda must accept exactly two arguments (left, right)." }}, :JOIN_LAMBDA_NEEDS_BOOL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "JOIN lambda must return Bool, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "JOIN's predicate lambda must produce Bool." }}, :CONCURRENT_OPT_NEEDS_NUMBER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "CONCURRENT %{name} must be a number, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "CONCURRENT numeric option (`capacity:`, `batch:`, etc.) needs a numeric expression." }}, :CONCURRENT_OPT_NEEDS_POSITIVE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "CONCURRENT %{name} must be greater than 0, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "CONCURRENT numeric option must be > 0." }}, :CONCURRENT_CAPACITY_BAD_INPUT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "CONCURRENT capacity only applies to stream or sharded sources; use batch: N to control work chunking for collections" }, :summary: DiagnosticEntryValue{ StringValue: COPY "`capacity:` is for stream / sharded inputs; collections use `batch:` instead." }}, :CONCURRENT_PARALLEL_NEEDS_BOOL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "CONCURRENT parallel must be a Bool (TRUE or FALSE), got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "`parallel:` accepts only TRUE / FALSE." }}, :CONCURRENT_SIZE_BAD_VALUE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "CONCURRENT size must be one of %{valid}, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "`size:` must be one of the recognised stack sizes." }}, :CONCURRENT_UNKNOWN_OPTION: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Unknown CONCURRENT option '%{name}'. Valid options: %{valid}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "CONCURRENT option key isn't in the recognised set." }}, :CONCURRENT_BAD_FOLLOWING_OP: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "CONCURRENT does not support %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "CONCURRENT can only modify a recognised pipeline op (SELECT / WHERE / EACH / ...)." }}, :SHARD_NEEDS_RANGE_OR_COLLECTION: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "SHARD input must be a range or collection, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "SHARD distributes a range or collection across partitions." }}, :SHARD_TARGET_BAD: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "SHARD target must be a HashMap@sharded(N) without :locked. %{remediation}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "SHARD into-clause needs a `HashMap@sharded(N)` without lock decoration." }}, :SHARD_KEY_NEEDS_STRING: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "SHARD key expression must evaluate to String for a String-keyed map, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "SHARD into a String-keyed map requires the key to resolve to String." }}, :SHARD_KEY_NEEDS_NUMERIC: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "SHARD key expression must evaluate to a numeric type for %{map_key_type}-keyed map, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "SHARD into a numeric-keyed map requires a numeric key." }}, :MODIFIER_NEEDS_ERROR_UNION: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "%{name} requires the expression to return an error union (!T), but got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Pipeline modifier (`RAISE`, `RECOVER`, etc.) needs an error-union-typed input." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Pipeline modifiers like `RAISE`, `RECOVER`, `OR_ELSE EXIT`, `OR_ELSE RAISE` operate on the error half of an error-union (`!T`). On a plain `T` they have nothing to dispatch on \u{2014} there's no error case to handle. CLEAR rejects them at compile time so the user catches the misuse early." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Either remove the modifier (the value is already plain T), make the upstream call fallible so it returns `!T` (e.g. mark the called fn `RETURNS !U`), or wrap the value with an explicit RAISE if you want to inject a failure." }}, :REQUIRE_NEEDS_IMPORTER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :registry }, :template: DiagnosticEntryValue{ StringValue: COPY "REQUIRE is only supported when using the Importer. Pass importer: and source_dir: to SemanticAnnotator.new." }, :summary: DiagnosticEntryValue{ StringValue: COPY "REQUIRE statement reached annotation without an active importer (script-mode invocation)." }}, :MUTABLE_UNUSED: {:severity: DiagnosticEntryValue{ SymbolValue: :warning }, :category: DiagnosticEntryValue{ SymbolValue: :lint }, :template: DiagnosticEntryValue{ StringValue: COPY "MUTABLE '%{name}' is never reassigned \u{2014} consider removing MUTABLE" }, :summary: DiagnosticEntryValue{ StringValue: COPY "A binding was declared MUTABLE but never reassigned." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Remove the MUTABLE keyword unless the declaration is intentionally reserving future mutability." }}, :LOCAL_NEVER_SHARED: {:severity: DiagnosticEntryValue{ SymbolValue: :info }, :category: DiagnosticEntryValue{ SymbolValue: :lint }, :template: DiagnosticEntryValue{ StringValue: COPY "Variable '%{name}' is @local but never shared across fibers. You are paying for a heap allocation with no sharing benefit. Consider removing @local." }, :summary: DiagnosticEntryValue{ StringValue: COPY "An @local binding never crosses a fiber boundary." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Remove `@local` from the declaration when the binding stays within one fiber." }}, :BARE_VERSIONED_UNSHARED: {:severity: DiagnosticEntryValue{ SymbolValue: :warning }, :category: DiagnosticEntryValue{ SymbolValue: :lint }, :template: DiagnosticEntryValue{ StringValue: COPY "Bare `@versioned` on '%{name}' is unusual: a single-owner MVCC cell isn't reachable from another thread, so the lock-free commit path has no concurrent benefit. Use `@shared:versioned` for cross-thread sharing, or remove `@versioned` if the cell is truly local." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A single-owner @versioned cell pays MVCC cost without cross-thread reachability." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use `@shared:versioned` for cross-thread sharing, or remove `@versioned` if the binding is truly local." }}, :DUPLICATE_DECLARATION: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Duplicate %{label} declaration '%{name}'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "A declaration name was registered more than once in the same namespace." }}, :DUPLICATE_FUNCTION_DECLARATION: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Duplicate function declaration '%{name}'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "A function name was registered more than once." }}, :DUPLICATE_EXTERN_METHOD_DECLARATION: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Duplicate extern method declaration '%{owner}.%{name}'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "An extern method was registered more than once for the same owner." }}, :REENTRANCE_DIRECT_RECURSIVE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :reentrance }, :template: DiagnosticEntryValue{ StringValue: COPY "Reentrancy Error: '%{name}' directly calls itself. Add `EFFECTS REENTRANT` to the function signature to declare the recursion budget." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Function calls itself directly without declaring the recursion budget." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Add `EFFECTS REENTRANT` to the function signature." }}, :REENTRANCE_INDIRECT_RECURSIVE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :reentrance }, :template: DiagnosticEntryValue{ StringValue: COPY "Reentrancy Error: '%{name}' calls itself recursively. Add `EFFECTS REENTRANT` to the function signature to allow this." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Function reaches itself through a call chain without declaring the recursion budget." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Add `EFFECTS REENTRANT` to the function signature to allow this." }}, :REENTRANCE_THUNK_NON_TAIL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :reentrance }, :template: DiagnosticEntryValue{ StringValue: COPY "EFFECTS REENTRANT:THUNK on '%{name}' has non-tail recursion in a shape this phase does not yet recognize. Supported: simple recurrence (zero or more `IF base -> RETURN const;` followed by a final `RETURN expr <op> %{name}(args);`). Wider shapes (multi-recursion, arbitrary control flow with recursion) land in later sub-phases. For now, declare ':TAIL_CALL' or use plain 'EFFECTS REENTRANT'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "EFFECTS REENTRANT:THUNK requires the recursion to be in tail position; this call isn't." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "a shape this phase does not yet recognize. Supported: simple recurrence (zero or more `IF base -> RETURN const;` followed by a final `RETURN expr <op> %{name}(args);`). Wider shapes (multi-recursion, arbitrary control flow with recursion) land in later sub-phases. For now, declare ':TAIL_CALL' or use plain 'EFFECTS REENTRANT'." }}, :REENTRANCE_TAIL_CALL_NOT_RECURSIVE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :reentrance }, :template: DiagnosticEntryValue{ StringValue: COPY "EFFECTS REENTRANT:TAIL_CALL on '%{name}' but the function is not recursive. Remove :TAIL_CALL - it only applies to self-recursive functions." }, :summary: DiagnosticEntryValue{ StringValue: COPY "`EFFECTS REENTRANT:TAIL_CALL` declared on a function that doesn't recurse." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Remove :TAIL_CALL - it only applies to self-recursive functions." }}, :IF_AS_NEEDS_OPTIONAL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "IF ... EXISTS AS binding requires an optional type, got '%{got}'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "`IF expr AS name THEN ...` requires `expr` to be optional (`?T`)." }, :cause: DiagnosticEntryValue{ StringValue: COPY "`IF expr AS x` is the optional-narrowing form: when `expr` is `?T` and non-NIL, `x` is bound to the unwrapped `T` inside the THEN branch. On a plain `T` there's nothing to unwrap, so the AS binding has no defined meaning." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Drop the `AS x` clause and use `expr` directly (it's already non-optional), OR make the source optional by returning `?T` from a fallible lookup so the AS narrow has something to unwrap." }}, :MATCH_NEEDS_STRUCT_TYPE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "MATCH struct pattern requires a struct type, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "MATCH with a struct-shaped pattern requires the matched expression to be a struct." }}, :MATCH_FIELD_UNKNOWN: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "MATCH struct pattern: field '%{field}' does not exist on type %{type}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "MATCH struct pattern references a field the struct doesn't declare." }}, :MATCH_FIELD_TYPE_MISMATCH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "MATCH struct pattern: field '%{field}' has type %{declared}, but pattern value has type %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "MATCH struct-pattern field comparison's literal type doesn't match the field's declared type." }}, :WHEN_NEEDS_BOOL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "WHEN condition must be Bool, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "MATCH ... WHEN clause's condition must be Bool-typed." }}, :MATCH_CASE_TYPE_MISMATCH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "MATCH case type %{case} does not match expression type %{expr}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "MATCH case literal's type doesn't match the matched expression's type." }}, :MATCH_DESTRUCTURE_FIELD_UNKNOWN: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "MATCH destructure: field '%{field}' does not exist on variant %{variant}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "MATCH inline-struct-variant destructure references a field the variant doesn't declare." }}, :MATCH_MULTI_ARM_PAYLOAD_MISMATCH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "MATCH multi-pattern arm: variants '%{head}' and '%{other}' have incompatible payloads, so the shared `%{kind} %{name}` cannot bind across both." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Multi-pattern MATCH arm with `AS` or `{ destructure }` requires every variant to share the same payload shape." }, :cause: DiagnosticEntryValue{ StringValue: COPY "`Pat1, Pat2 AS x -> body` evaluates one body with one binding `x` for whichever variant matched at runtime. CLEAR (and the underlying Zig switch) only allows the shared binding when every variant in the arm carries the SAME payload type \u{2014} same primitive, same inline-struct fields, or all unit. Variants with diverging payloads can't be unified into one binding without a runtime selector and a synthesized union type." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Either drop the `AS` / `{ destructure }` (the variants can still share a body without a shared binding), split the arm into separate single-pattern arms each with its own `AS` / destructure, or change the union so the listed variants share a payload type." }}, :MATCH_DUPLICATE_PATTERN: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "MATCH variant '%{variant}' is matched more than once. Duplicate patterns produce invalid Zig switch prongs." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Each enum / union variant may appear at most once across all MATCH arms (single or multi-pattern)." }, :cause: DiagnosticEntryValue{ StringValue: COPY "MATCH lowers to a Zig switch (or if-chain). A variant appearing in two arms \u{2014} or twice in the same multi-pattern arm \u{2014} would emit `case .A, .A => ...` or two separate `.A` prongs. Zig rejects both as duplicates; the catch in the annotator surfaces the user-side mistake clearly instead of letting it bottom out as a downstream codegen error." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Remove the redundant pattern. If two arms have different bodies for the same variant, keep the one you want and delete the other; if a multi-pattern arm lists a variant twice, drop the duplicate." }}, :FOR_RANGE_START_NEEDS_INT64: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "FOR range start must be Int64, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "`FOR i IN (a ..< b)` \u{2014} `a` must be Int64." }}, :FOR_RANGE_END_NEEDS_INT64: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "FOR range end must be Int64, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "`FOR i IN (a ..< b)` \u{2014} `b` must be Int64." }}, :FOR_IN_NEEDS_COLLECTION: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "FOR ... IN requires an array, list, or map, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "`FOR x IN coll` \u{2014} `coll` must be a collection." }}, :CONDITION_NEEDS_BOOL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Condition must be a Boolean, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "IF / WHILE condition must be Bool-typed." }}, :USE_OF_MOVED_IN_LOOP: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "%{detail}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Loop body consumes a value on the first iteration; subsequent iterations have nothing left to GIVE." }, :cause: DiagnosticEntryValue{ StringValue: COPY "An affine value can only be TAKEN once. The loop body moves (GIVE / TAKES / RETURN / etc.) the binding, so the second iteration would be reading something that's already been transferred." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Hoist the move out of the loop, or wrap the consuming reference with `COPY` (if the type permits) so each iteration gets its own owned copy. For shared aggregation, declare the binding `@multiowned` (single-scheduler Rc) or `@shared` (cross-fiber Arc)." }}, :USE_OF_MOVED_VALUE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "%{detail}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Binding was already TAKEN / GIVEN at a prior site and is no longer accessible." }, :cause: DiagnosticEntryValue{ StringValue: COPY "An affine binding has exactly one owner. A prior expression (a `TAKES` parameter, `GIVE`, `RETURN`, `SHARE`, `NEXT`, etc.) consumed ownership; the current use is left holding nothing." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Wrap the consuming reference with `COPY` (if the type permits \u{2014} primitives, strings, and enums are Copy by default; non-Copy types need `@multiowned` / `@shared` to share). Or restructure so only one site consumes the value." }}, :INFERRED_ALIAS_MUTATION: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "%{detail}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Mutation overlaps an implicitly inferred alias; CLEAR will not guess snapshot versus shared identity." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A plain assignment created two live names and one was mutated before the other's last use. Choosing COPY would isolate the mutation; choosing Rc/Arc identity would share it. That semantic choice is never inferred, including in EASY mode." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Write `COPY source` for an independent snapshot, or explicitly declare Rc/Arc identity (`@multiowned` or `@shared`) and write `CLONE source`. You can also shorten the alias lifetime so it ends before mutation." }}, :STRICT_IMPLICIT_OWNERSHIP_COST: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "%{detail}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "STRICT mode rejects an implicit copy or reference-count retain." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The common ownership planner proved the operation safe, but its selected transport has a runtime cost. STRICT requires that cost to be visible in source." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Write `COPY value` for a snapshot or `CLONE value` for an existing Rc/Arc identity, or shorten the lifetime so the operation can be a move/borrow." }}, :RECURSIVE_LAYOUT_REQUIRES_INDIRECT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Layout Error: recursive field %{edge} has infinite inline size. Choose an explicit topology: `@node` for most mutable graphs; `@boxed` for a unique owned recursive edge; `@multiowned` for local shared tree/DAG identity; `@shared` for cross-execution shared identity; or `@link` for a non-owning edge into an independently owned, potentially enormous/open topology." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Recursive inline storage requires an explicit topology choice in every mode." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A value cannot contain itself inline because its size would be infinite." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Prefer `@node` for ordinary graphs, `@boxed` for uniquely owned recursive trees, an RC capability for shared identity, or `@link` for non-owning cross-domain edges. CLEAR does not infer this performance- and identity-bearing choice, even in EASY." }}, :RECURSIVE_LAYOUT_AMBIGUOUS: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Layout Error: recursive component has multiple cycle-breaking choices (%{edges}). Choose explicitly: `@node` for most graphs; `@boxed` for selected unique-owner edges; `@multiowned` or `@shared` for shared identity; or `@link` for non-owning edges. These choices have different ownership, allocation, and traversal costs." }, :summary: DiagnosticEntryValue{ StringValue: COPY "The compiler will not choose among performance-distinct recursive layouts." }, :cause: DiagnosticEntryValue{ StringValue: COPY "More than one field can break the recursive layout cycle, and each choice changes allocation and cache behavior." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Prefer `@node` for ordinary graphs. Use `@boxed` only for a selected unique-owner edge, RC capabilities for shared identity, and `@link` for non-owning references into separately owned domains." }}, :INDIRECT_ARGUMENT_EXPLICIT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Layout Error: argument %{index} requires %{expected}. EASY may construct the forced indirect representation automatically; DEFAULT and STRICT require explicit `@boxed` layout." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A call cannot hide a heap-indirection choice outside EASY mode." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The callee ABI is pointer-backed but the argument is an inline value." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Construct or declare the value with `@boxed`, or use EASY mode when this destination contract uniquely forces the representation." }}, :INDIRECT_FIELD_EXPLICIT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Layout Error: field '%{field}' requires %{expected}. EASY may construct the forced indirect representation automatically; DEFAULT and STRICT require explicit `@boxed` layout." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A field initializer cannot hide a heap-indirection choice outside EASY mode." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The field representation is pointer-backed but the initializer is an inline value." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Construct or declare the value with `@boxed`, or use EASY when the field contract uniquely forces it." }}, :INDIRECT_ELEMENT_PRIMITIVE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Layout Error: `@boxed` element layout is not allowed for primitive %{type}; it adds an allocation and pointer chase without solving a recursive layout." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Primitive collection elements must remain inline." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Primitive values already have finite, compact layouts. Boxing each element would predictably damage locality and memory use." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use `%{type}[]@list`, or wrap the primitive in a STRUCT if stable identity is actually required." }}, :COLLECTION_HINT_VALUE_ONLY: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: collection pre-allocation hints are allowed only on initialized local bindings." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A capacity hint controls one allocation site; it is not part of a reusable type contract." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Parameters, returns, and fields describe value shapes and ABIs, but `[List(N)]` and `[Set(N)]` describe how a particular value should initially allocate storage." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use `[]T` or `[Set]T` in the reusable type, then put the capacity hint on the local binding that constructs the collection." }}, :RANK_INDEX_ARITY: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Index Error: rectangular rank expects %{expected} indices, got %{got}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Canonical rectangular indexing supplies one integer per axis." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A comma-rank is one flat layout, so a complete element lookup must identify every axis." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use `grid[x, y, ...]` with exactly one index for each declared dimension." }}, :RANK_INDEX_INTEGER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Index Error: rectangular rank indices must be integers, got %{got}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Every rectangular axis uses an integer coordinate." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Stride-based offset calculation is defined only for integer coordinates." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Convert the coordinate to an integer before indexing." }}, :RANK_LITERAL_SIZE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: flat rank literal requires %{expected} items, got %{got}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A fixed rectangular rank owns exactly the product of its extents." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The flat initializer does not fill the declared contiguous storage exactly." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Provide exactly the product of the declared dimensions as row-major items." }}, :RANK_DYNAMIC_LITERAL_NEEDS_SHAPE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: a non-empty dynamic rank initializer requires explicit shape metadata." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A flat item list cannot determine two or more dynamic extents unambiguously." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The same flat item count may correspond to several rectangular shapes." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Initialize an empty dynamic rank, then use the shaped grid constructor once available; fixed ranks may use a flat row-major literal." }}, :INDIRECT_ELEMENT_EXPLICIT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Layout Error: inserting inline %{type} into `%{type}@boxed[]@list` requires a heap allocation. EASY may apply this uniquely forced layout; DEFAULT and STRICT require an explicit `@boxed` construction." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A collection insertion cannot hide a heap allocation outside EASY mode." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The destination stores pointers, while the source is an inline value. Converting it requires allocating one unique box." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Construct the value with `@boxed`, change the collection to inline `%{type}[]@list`, or use `@node` when this is graph identity rather than unique indirection." }}, :INDIRECT_ELEMENT_IDENTITY: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Layout Error: %{actual} identity cannot be implicitly converted to unique `%{type}@boxed` ownership." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Identity-bearing capabilities are not interchangeable with a unique box." }, :cause: DiagnosticEntryValue{ StringValue: COPY "@node, @link, @multiowned, and @shared each have distinct identity and lifetime semantics. Unwrapping one into @boxed would silently change those semantics." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Make the destination use the same capability, explicitly COPY a payload when legal, or choose a different topology representation." }}, :INDIRECT_TRANSFER_REQUIRES_COPY: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "Layout Error: `%{name}` is still live after insertion into an `@boxed` destination. Boxing can move a payload at zero copy cost only when the source is consumed; write `COPY %{name}` for an explicit snapshot, construct/move an `@boxed` value, or shorten the source lifetime." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Automatic boxing will not hide a deep copy." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The destination needs ownership while the original binding remains live. Preserving both values requires a potentially expensive semantic copy." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use `COPY` explicitly, create the source as `@boxed` and move it, keep inline elements, or restructure so the source is dead at insertion." }}, :COLLECTION_ELEMENT_LAYOUT_MISMATCH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Layout Error: collection element layout mismatch; expected %{expected}, got %{actual}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Inline-element and indirect-element collections are different concrete representations." }, :cause: DiagnosticEntryValue{ StringValue: COPY "One collection stores payloads inline and the other stores pointers. Their ABIs and mutation costs are not interchangeable." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Change the parameter/collection to the same element layout, or move elements explicitly between the two collections." }}, :USE_OF_MOVED_IN_LOOP_SHORT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "%{detail}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Loop body uses a value that was already TAKEN on a prior iteration." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Same as USE_OF_MOVED_IN_LOOP \u{2014} the binding was consumed on the first iteration; the second iteration has nothing left to GIVE." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Same: hoist the move out of the loop, or `COPY` per-iteration, or upgrade to `@multiowned` / `@shared`." }}, :USE_OF_MOVED_PATH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "%{detail}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Path's owner (root binding) was already TAKEN or GIVEN; sub-paths are no longer accessible." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Sub-path access (`b.field`, `arr[i]`) reads through an owner. If the owner itself was transferred (TAKES / GIVE / RETURN / etc.), the sub-path goes with it \u{2014} the owner takes its fields along." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Either consume the field directly (`GIVE b.field`) before the owner is transferred, or `COPY` the field, or restructure so the owner isn't moved before the field's last use." }}, :WHILE_AS_NEEDS_OPTIONAL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "WHILE ... EXISTS AS binding requires an optional type, got '%{got}'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "`WHILE expr AS name DO ...` requires `expr` to be optional (`?T`)." }, :cause: DiagnosticEntryValue{ StringValue: COPY "`WHILE expr AS x DO ...` loops while `expr` returns a non-NIL `?T`, binding the unwrapped `T` to `x` per iteration. On a plain non-optional `T`, the loop has no NIL termination signal \u{2014} it would run forever \u{2014} so the form is rejected." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Make the source fallible (e.g. `iter.next()` on a stream returns `?T`), OR use a regular `WHILE <bool-expr> DO ...` for non-optional looping." }}, :WHILE_AS_IMMUTABLE_RECEIVER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "WHILE ... EXISTS AS binding: '%{method}' is called on immutable '%{recv}' -- the condition cannot advance and may loop forever. Declare '%{recv2}' as MUTABLE or use a regular WHILE loop." }, :summary: DiagnosticEntryValue{ StringValue: COPY "`WHILE recv.next() AS x` would never terminate if `recv` is immutable." }}, :BREAK_OUTSIDE_LOOP: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "BREAK must be used inside a loop" }, :summary: DiagnosticEntryValue{ StringValue: COPY "BREAK only makes sense inside a FOR / WHILE body." }}, :CONTINUE_OUTSIDE_LOOP: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "CONTINUE must be used inside a loop" }, :summary: DiagnosticEntryValue{ StringValue: COPY "CONTINUE only makes sense inside a FOR / WHILE body." }}, :ASSERT_NEEDS_BOOL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Assert condition must be Boolean" }, :summary: DiagnosticEntryValue{ StringValue: COPY "ASSERT's predicate must be Bool-typed." }}, :RETURN_VOID_FROM_TYPED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Function expects return type %{expected}, got Void" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Function returns nothing on a path where its declared return type expects a value." }}, :RETURN_FROM_WITH_SCOPED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :escape }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot RETURN '%{name}' from inside a WITH block. WITH aliases are borrows of locked data and cannot escape their scope. Either RETURN COPY alias (breaks the borrow), or restructure so the value's lifetime exceeds the WITH (move the value out of the cell before the WITH body ends)." }, :summary: DiagnosticEntryValue{ StringValue: COPY "WITH-scoped aliases (`AS x`) are non-escaping \u{2014} they can't be returned." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A WITH ... AS alias block creates a scoped binding that doesn't outlive the WITH body. Returning the alias would let the caller see a value whose backing storage is gone." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Either RETURN COPY alias (breaks the borrow), or restructure so the value's lifetime exceeds the WITH (move the value out of the cell before the WITH body ends)." }}, :RETURN_FIELD_FROM_WITH_SCOPED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :escape }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot RETURN a field of a WITH-scoped binding. Field access borrows from the locked data; the borrow cannot escape the WITH scope." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Field of a WITH-scoped binding can't be returned (would outlive the WITH)." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Field access borrows from the locked data; the borrow cannot escape the WITH scope." }}, :RETURN_INDEX_FROM_WITH_SCOPED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :escape }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot RETURN an indexed access of a WITH-scoped binding. Index access borrows from the locked data; the borrow cannot escape the WITH scope." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Indexed access on a WITH-scoped binding can't be returned (would outlive the WITH)." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Index access borrows from the locked data; the borrow cannot escape the WITH scope." }}, :INTRINSIC_NO_OVERLOAD: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "No overload for '%{name}' matches arguments (%{args}).\nCandidates: %{candidates}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Stdlib function has overloads but none match the call's argument types." }}, :ATOMIC_NO_MUL_DIV_COMPOUND: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "Atomic primitives do not support `%{op}`. Use a CAS loop via `c.compareAndSwap(old, new)` to update the cell atomically with an arbitrary computation, OR switch the binding from `@shared:atomic` to `@shared:locked` and do the math inside `WITH EXCLUSIVE c AS x { x.v *= 2; }` \u{2014} the lock makes the read-modify-write atomic." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Compound `*=` / `/=` not available on `@shared:atomic` targets." }, :cause: DiagnosticEntryValue{ StringValue: COPY "`@shared:atomic` lowers to single-instruction atomic primitives (load, store, fetchAdd, fetchSub, AND/OR/XOR). Multiplication and division have no single-instruction atomic form on any mainstream architecture, so they're rejected at compile time rather than silently lowered to a non-atomic load+op+store race." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use a CAS loop via `c.compareAndSwap(old, new)` to update the cell atomically with an arbitrary computation, OR switch the binding from `@shared:atomic` to `@shared:locked` and do the math inside `WITH EXCLUSIVE c AS x { x.v *= 2; }` \u{2014} the lock makes the read-modify-write atomic." }}, :ATOMIC_UNSUPPORTED_COMPOUND: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "Compound op %{op} is not supported on @shared:atomic targets." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Compound op other than `+=` / `-=` / `&=` / `|=` / `^=` not available on `@shared:atomic`." }, :cause: DiagnosticEntryValue{ StringValue: COPY "`@shared:atomic` only accepts compound ops that map to a single hardware atomic primitive. The supported set is exactly: `+=` (fetchAdd), `-=` (fetchSub), `&=` (fetchAnd), `|=` (fetchOr), `^=` (fetchXor). Anything else would require a non-atomic read-modify-write. Defensive code path: the lexer currently only produces `+= -= *= /=`, so this branch is unreachable in user code today; kept as a safety net for any future compound-op token." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Either rewrite the op as a `compareAndSwap` loop (`c.compareAndSwap(old, new)`) \u{2014} which atomically applies an arbitrary computation \u{2014} OR switch the binding to `@shared:locked` and perform the op inside `WITH EXCLUSIVE c AS x { ... }` so the lock guarantees atomicity." }}, :INVALID_ASSIGNMENT_TARGET: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Invalid assignment target: %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Left-hand side of `=` must be an identifier, field access, or index expression." }}, :ASSIGN_UNDEFINED_VAR: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot assign to undefined variable '%{name}'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Assignment target was never declared in any enclosing scope." }}, :ASSIGN_VAR_IMMUTABLE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "Variable '%{name}' is immutable" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Assignment target was declared without `MUTABLE`." }}, :ASSIGN_INDEX_IMMUTABLE_LIST: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot modify index of immutable list '%{name}'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Indexed write on a list whose binding is not MUTABLE." }}, :TYPE_MISMATCH_ASSIGN: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Mismatch: Cannot assign %{got} to %{expected}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Right-hand side's type doesn't fit the assignment target's type." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The value being assigned to an existing binding doesn't match the binding's declared type. Coercion was tried and failed." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Either change the value, change the declared type at the binding's declaration site, or use CAST for an explicit conversion." }}, :DESTRUCTURE_REQUIRES_FIXED_SHAPE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Destructuring assignment requires a fixed-size RHS, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Destructuring only accepts values whose element count is statically known." }, :cause: DiagnosticEntryValue{ StringValue: COPY "`a, b = value` must know exactly how many slots `value` contains at compile time. Dynamic arrays, streams, and unknown call results cannot be destructured safely." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use a fixed-size array or tuple-like value, or assign through explicit indexing after checking the shape." }}, :DESTRUCTURE_ARITY_MISMATCH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Destructuring target count %{targets} does not match RHS size %{values}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "The number of destructuring targets must match the RHS fixed size." }}, :DESTRUCTURE_REQUIRES_COPYABLE_RHS: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Destructuring assignment currently requires a copyable RHS, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Only fixed-size values with copyable elements can be destructured today." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Owned element destructuring needs explicit per-slot ownership transfer and cleanup metadata. Lowering it as a plain fixed array would obscure ownership." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use copyable fixed-size values, or assign owned elements explicitly until owned destructuring is implemented." }}, :NUMERIC_MAP_KEY_BAD: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Numeric map keys must be a number type, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "HashMap with numeric keys was indexed with a non-numeric value." }}, :STRING_MAP_KEY_BAD: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Map keys must be Strings, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "HashMap with String keys was indexed with a non-String value." }}, :STRING_INDEX_BY_INT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot index String by integer. Use String@raw for byte access, or .codepoints() for iteration." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Plain String can't be indexed by integer \u{2014} use `String@raw` or codepoint iteration." }}, :UNSUPPORTED_INDEX: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Unsupported Index" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Indexing-by-int isn't supported on this type." }}, :TUPLE_INDEX_SYNTAX: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Tuple values use positional fields, not array indexing." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Access Tuple positions with `._0`, `._1`, and so on." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A Tuple is a heterogeneous product whose positions may have different types; treating it as an array would imply homogeneous indexed access." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Replace `tuple[N]` with `tuple._N` when N is a compile-time Tuple position." }}, :FIXED_POSITION_OUT_OF_BOUNDS: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Position %{index} is out of bounds for %{type}, which has %{count} positions." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A compile-time positional access must name an existing field." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Fixed positional shapes expose exactly their declared number of positions, numbered from zero." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use a position from 0 through count - 1." }}, :HASHMAP_MIXED_VALUES: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "HashMap must have all values be the same type" }, :summary: DiagnosticEntryValue{ StringValue: COPY "HashMap literal contains values of different types." }}, :UNKNOWN_STRUCT_TYPE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Unknown struct type: '%{name}'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Struct literal references a struct name that wasn't declared." }}, :UNION_LITERAL_VARIANT_COUNT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Union literal '%{name}' must specify exactly one variant, got %{got}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Union literal `T{ Variant: ... }` must list exactly one variant." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A union value carries exactly one active variant at a time. The `T{ Variant: payload }` literal produces a single value; listing multiple variants would imply two simultaneously-active variants, which the tagged-union representation can't express." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Pick the one variant you intend to construct: `%{name}{ Variant: payload }`. If you need a value that could be one of several variants, construct the appropriate one in a CONDITIONAL (`IF cond -> %{name}.A(x), ELSE %{name}.B(y) END`)." }}, :UNION_VARIANT_IS_UNIT_NO_PAYLOAD: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Union variant '%{variant}' is a unit variant \u{2014} use '%{union}.%{variant2}' (no payload)." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Tried to construct a unit variant with payload syntax." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Unit variants (`Variant` declared without a `: T` clause in the UNION) carry no associated data. Calling them like a payloaded variant (`Type.Variant(x)`) would supply a value the variant has no slot for." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Drop the parentheses: `%{union}.%{variant2}` is the construction form for unit variants. If you need to carry data, declare the variant with a payload type (`%{variant}: T`) at the UNION definition." }}, :STRUCT_LITERAL_MISSING_FIELDS: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot use '%{name}{}' \u{2014} field(s) %{fields} have no default values" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Struct literal omits required fields (no defaults declared)." }}, :FIELD_TYPE_MISMATCH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Field '%{field}' expected %{expected}, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Struct literal field's value type doesn't match the field's declared type." }}, :BOUNDED_STREAM_MIXED_TYPES: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Bounded stream literal contains mixed promise types: %{types}. All BG blocks must produce the same type." }, :summary: DiagnosticEntryValue{ StringValue: COPY "`~T[]` bounded-stream literal must have homogeneous BG-block types." }}, :LIST_LITERAL_MIXED_TYPES: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "List literal contains mixed types: First item is %{base}, item %{index} is %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "List literal elements have inconsistent types." }}, :RANGE_START_NEEDS_NUMERIC: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Range start must be a numeric type, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "`a ..< b` \u{2014} `a` must be a numeric type." }}, :RANGE_END_NEEDS_NUMERIC: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Range end must be a numeric type, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "`a ..< b` \u{2014} `b` must be a numeric type." }}, :UNKNOWN_LITERAL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "UNKNOWN LITERAL!" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Internal annotator error \u{2014} saw a literal node it doesn't know how to type-infer." }}, :TYPE_ERROR_GENERIC: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: %{detail}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Generic type-error wrapper for messages produced elsewhere (e.g., Type#coerce_error)." }}, :AUTO_INFERRED_TYPE: {:severity: DiagnosticEntryValue{ SymbolValue: :info }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Inferred type for %{label}: %{type}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Auto inference resolved a type annotation." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Replace `Auto` with the inferred type if you want the source to be explicit." }}, :AUTO_INFERRED_BINDING_TYPE: {:severity: DiagnosticEntryValue{ SymbolValue: :info }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Inferred type for `%{name}`: %{type}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Auto inference resolved a binding type annotation." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Replace `Auto` with the inferred type if you want the source to be explicit." }}, :INFERRED_FALLIBLE_BINDING: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot infer `%{name}` from a fallible value." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Inferred bindings must not silently discard a `!T` error channel." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A fallible call was assigned to an unannotated binding. That makes it too easy to treat a failure as an ordinary value and lose the point at which the error must be handled." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use `TRY expr` to propagate and bind `T`, or write `name:! = expr` to retain the fallible value deliberately." }}, :INFERRED_OPTIONAL_BINDING: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot infer `%{name}` from an optional value." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Inferred bindings must not silently retain a `?T` optional wrapper." }, :cause: DiagnosticEntryValue{ StringValue: COPY "An optional result was assigned directly to an unannotated binding. The source should make whether absence is propagated, force-unwrapped, retained, or safely navigated explicit." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use `UNWRAP expr` to bind `T`, write `name:? = expr` to retain the optional value, or use `?.` navigation when the resulting optional is intentional." }}, :INFERRED_ASYNC_BINDING: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot infer `%{name}` from an asynchronous value. Use `%{expected_action}` to consume it, or write `%{name}:~ = expr` to retain the handle." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A future or stream must be consumed or retained explicitly." }, :cause: DiagnosticEntryValue{ StringValue: COPY "An asynchronous value was assigned to an unannotated binding. That makes it unclear whether the next operation should consume it or pass the asynchronous handle onward." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use `%{expected_action}` to consume the result, or write `name:~ = expr` to retain the asynchronous handle deliberately." }}, :AUTO_AMBIGUOUS_TYPE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "%{detail}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Auto inference found multiple incompatible candidate types." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Choose a concrete type and update the annotation, or narrow the call sites that produce incompatible observations." }}, :AUTO_UNRESOLVED_TYPE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "%{detail}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Auto inference could not observe enough uses to choose a type." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Replace `Auto` with a concrete type, or add enough typed use sites for inference to converge." }}, :OR_BREAK_OUTSIDE_WHILE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "OR_ELSE BREAK can only be used inside a WHILE loop" }, :summary: DiagnosticEntryValue{ StringValue: COPY "`expr OR_ELSE BREAK` is only valid inside a WHILE loop body." }, :cause: DiagnosticEntryValue{ StringValue: COPY "`OR_ELSE BREAK` is sugar for \"if the expression yielded NIL or an error, break out of the surrounding loop.\" Outside any loop there's nothing to break out of \u{2014} the keyword has no target." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Wrap the expression in a `WHILE` loop if iteration is what you want, OR use a different fallback (`OR_ELSE EXIT`, `OR_ELSE RAISE`, `OR <default>`) that has a defined meaning at the current scope." }}, :TYPE_MISMATCH_IN_OR: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type mismatch in OR_ELSE: expected %{expected}, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Right-hand side of `OR_ELSE` must match the optional/error-union's payload type." }, :cause: DiagnosticEntryValue{ StringValue: COPY "`expr OR_ELSE fallback` substitutes the fallback when `expr` is NIL (optional case) or an error (error-union case). The fallback's type must match the payload type because both branches feed into the same downstream binding \u{2014} without type alignment, the binding would have no determinable type." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Either change the fallback to produce a value of the expected payload type (e.g. `OR_ELSE 0` when the payload is `Int64`), CAST it explicitly (`OR_ELSE CAST(x AS PayloadT)`), or rewrite the LHS to widen its payload to a common type with the fallback." }}, :OR_ELSE_NEEDS_RECOVERABLE_LEFT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Syntax Error: OR_ELSE requires a fallible (!T) or optional (?T) left operand, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "OR_ELSE can only recover an error or absence." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A definite value has no failure or absence branch, so its OR_ELSE fallback is unreachable." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Remove OR_ELSE, make the left expression return !T or ?T, or use IF/MATCH when both branches represent real values." }}, :UNWRAP_NON_OPTIONAL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot unwrap non-optional type '%{got}' with '?'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "`expr?` only applies to optional types (`?T`)." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The `?` postfix is the optional-unwrap operator: it asserts non-NIL and yields the inner `T`. On a plain `T` it would be a no-op, but allowing it would mask later refactors that change the type \u{2014} so the compiler rejects it explicitly." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Drop the trailing `?` (the value is already non-optional). If you intended to PROPAGATE failure, use `OR_ELSE RAISE` / `OR_ELSE EXIT` / `OR <default>` on a fallible source instead." }}, :IF_EXPR_THEN_NEEDS_VALUE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "IF expression: THEN branch must end with a value expression" }, :summary: DiagnosticEntryValue{ StringValue: COPY "When IF is used as an expression, the THEN branch's last statement must be a value." }, :cause: DiagnosticEntryValue{ StringValue: COPY "`x = IF cond THEN ... END` is the expression form: every branch must yield a value because that value is what gets assigned to `x`. A THEN that ends in a statement (assignment, RETURN, side-effect call) has nothing to feed the assignment." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Make the last line of the THEN branch a value expression \u{2014} drop the trailing `;` from a single-expression branch, or end with the value you want to bind. If you don't need a value, use the statement form: `IF cond THEN ... END;` (no surrounding assignment)." }}, :IF_EXPR_NEEDS_ELSE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "IF used as expression requires an ELSE branch" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Expression-form IF must cover all paths via an ELSE." }, :cause: DiagnosticEntryValue{ StringValue: COPY "An expression-form IF must yield a value on every path. Without ELSE, the path where `cond` is false has no value to assign \u{2014} the binding would be uninitialised. CLEAR rejects this at compile time so there's no NIL/garbage path." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Add an `ELSE -> <value>` arm. If the false case should fall through with NIL, declare the binding as `?T` and `ELSE -> NIL`. If only the true path matters and you want side-effects, use the statement form (`IF cond THEN ... END;`)." }}, :IF_EXPR_ELSE_NEEDS_VALUE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "IF expression: ELSE branch must end with a value expression" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Expression-form IF's ELSE branch must end with a value." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Same rule as THEN: every branch of an expression-form IF must yield the binding's value. An ELSE that ends in a statement leaves the false-path binding uninitialised." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "End the ELSE branch with a value expression, or fall back to the statement form if the value is only needed on the true path." }}, :IF_EXPR_BRANCHES_INCOMPATIBLE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "IF expression branches have incompatible types: THEN returns %{then_type}, ELSE returns %{else_type}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Expression-form IF needs both branches to produce the same type." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The result of an expression-form IF feeds a single binding with a single declared type. Allowing the THEN and ELSE branches to produce different types would force the binding into an ad-hoc union \u{2014} CLEAR requires the user to declare that union explicitly." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Pick one type and convert the other branch (e.g. `%{then_type}.toString()` if `%{else_type}` is String). For genuine variant data, define a UNION and have both branches construct different variants of it." }}, :IF_EXPR_RESULT_NOT_COPYABLE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "IF expression result type '%{type}' must be implicitly copyable (primitive, symbol, or rodata string). Use statement-IF with RETURN for heap-allocated values." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Expression-form IF only supports implicitly-copyable result types." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Expression-form IF lowers each branch into a load-and-yield sequence; the result must be a value the compiler can implicitly COPY (primitive, symbol, rodata string). Heap-owned values would need an explicit ownership decision per branch \u{2014} handing them through expression-form IF would silently bypass the affine ownership rules." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Convert to the statement form with explicit ownership: `MUTABLE result; IF cond -> result = produce_owned(); ELSE -> result = other_owned(); END;` \u{2014} or for fn returns, use `IF cond -> RETURN A; ELSE -> RETURN B; END` directly." }}, :MATCH_EXPR_BRANCH_NEEDS_VALUE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "MATCH expression: every branch must end with a value expression" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Expression-form MATCH needs every branch to end with a value." }, :cause: DiagnosticEntryValue{ StringValue: COPY "`x = MATCH subject START ... END` requires every arm to yield a value \u{2014} the binding `x` reads from whichever arm matched. An arm ending in a statement (assignment, RETURN, side-effect) has nothing to feed the binding." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "End each arm with a value expression. For arms that genuinely have nothing to return, switch to the statement form (`MATCH subject START ... END;` with no surrounding assignment), or yield NIL and declare the binding `?T`." }}, :MATCH_EXPR_NEEDS_CASE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "MATCH expression must have at least one case" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Expression-form MATCH with no cases would have no value." }, :cause: DiagnosticEntryValue{ StringValue: COPY "An expression-form MATCH with zero cases can never yield a value \u{2014} there's no arm to dispatch to. The binding would be uninitialised on every path." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Add at least one `WHEN <pattern> -> <value>` arm. If the subject is genuinely unbounded and you want a catch-all, use `PARTIAL MATCH` with a `DEFAULT -> <value>`." }}, :MATCH_EXPR_BRANCHES_INCOMPATIBLE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "MATCH expression branches have incompatible types: %{types}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Expression-form MATCH branches must produce the same type." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The MATCH expression's binding has a single type; every arm must produce a value of that type. Allowing arms to produce different types would force an ad-hoc union \u{2014} CLEAR requires that union to be declared explicitly." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Pick a common result type and convert each arm's value to it (`Int.toString(x)` to lift to String, etc.), or declare a UNION and have each arm construct the appropriate variant." }}, :MATCH_EXPR_RESULT_NOT_COPYABLE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "MATCH expression result type '%{type}' must be implicitly copyable (primitive, symbol, or rodata string). Use statement-MATCH for heap-allocated values." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Expression-form MATCH only supports implicitly-copyable result types." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Expression-form MATCH lowers each arm into a load-and-yield sequence; the result must be implicitly copyable (primitive, symbol, rodata string). Heap-owned values would need explicit ownership routing per arm \u{2014} yielding them through expression-form MATCH would bypass affine ownership rules." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use the statement form with explicit ownership: `MUTABLE result; MATCH subject START WHEN A -> result = produce_a(); WHEN B -> result = produce_b(); END;` \u{2014} or RETURN directly from each arm if the value is the function's return." }}, :CAPABILITY_ON_PRIMITIVE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "Capability @%{cap} cannot be applied to primitive type %{type}. Wrap in a STRUCT (e.g. STRUCT Wrapper { value: %{type} }) and apply the capability to the struct." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Sigils that wrap a value (`@multiowned`, `@shared`, `@locked`, ...) only apply to heap-managed types." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Wrap in a STRUCT (e.g. STRUCT Wrapper { value: %{type} }) and apply the capability to the struct." }}, :MOVE_NEEDS_IDENTIFIER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "MOVE can only be applied to a variable identifier" }, :summary: DiagnosticEntryValue{ StringValue: COPY "`MOVE expr` requires `expr` to be a bare binding name." }}, :MOVE_OWNED_OPTIONAL_CAPTURE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot MOVE owned optional capture '%{name}' yet; its enclosing optional still owns the payload." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Moving an owned IF-AS payload would currently leave two cleanup paths for one value." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Zig optional value captures copy the payload out without a writable source slot. Until CLEAR lowers consuming captures through a guarded pointer capture, MOVE would double-free cleanup-bearing fields." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use COPY %{name} for an independent owned value, or consume the optional before entering IF-AS." }}, :GIVE_ON_COPY_TYPE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "GIVE cannot be applied to Copy types (%{type} is implicitly copyable)" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Implicitly-copyable values don't need GIVE \u{2014} they get copied automatically." }}, :STORE_WITH_SCOPED_INTO_CONTAINER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :escape }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot store WITH-scoped '%{name}' into %{container}. WITH bindings cannot escape their block." }, :summary: DiagnosticEntryValue{ StringValue: COPY "WITH-scoped binding can't be persisted into a container that outlives the WITH." }}, :STORE_STRING_NEEDS_COPY: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot store string variable '%{name}' into %{container} without COPY. Strings are frame-arena managed; use COPY for heap ownership." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Frame-arena strings need COPY before storing into a longer-lived container." }}, :LINK_NEEDS_SHARED_OR_MULTIOWNED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "LINK can only be applied to @shared or @multiowned variables, got '%{got}'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "LINK creates a weak reference and only applies to refcounted bindings." }}, :RESOLVE_NEEDS_LINK: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "RESOLVE can only be applied to @link variables, got '%{got}'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "RESOLVE upgrades a `@link` weak ref into an optional strong ref." }}, :FREEZE_NEEDS_OWNED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "FREEZE can only be applied to @multiowned or @shared values, got '%{got}'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "FREEZE turns an owned refcount handle into immutable shared data." }}, :GIVE_BAD_TARGET: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "GIVE can only be used on variables, fields, or array elements" }, :summary: DiagnosticEntryValue{ StringValue: COPY "GIVE must name a place \u{2014} not an expression result." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Reserved for the field/index variants of GIVE (`GIVE b.field`, `GIVE arr[i]`). Today the broader `visit_MoveNode` rejects every non-Identifier with MOVE_NEEDS_IDENTIFIER, so this code never fires. Once `visit_MoveNode` is relaxed to admit field/index targets, GIVE_BAD_TARGET will fire for the genuinely-invalid cases (literals, expressions)." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "While the lookup-style GIVE isn't supported, bind the value to a variable first and `GIVE` the variable." }, :pending: DiagnosticEntryValue{ BoolValue: TRUE }}, :GIVE_TO_BORROW_PARAM: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "GIVE passed to non-TAKES parameter '%{param}'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Ownership transfer must be declared on the callee parameter." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A call-site GIVE suppresses the caller's cleanup. If the callee parameter is not TAKES, the callee treats the value as a borrow and has no cleanup obligation, making ownership implicit and unverifiable." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Mark the callee parameter as TAKES, or pass COPY/CLONE/borrowed value instead of GIVE." }}, :COPY_NON_COPYABLE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot COPY non-copyable type '%{type}'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Some types (e.g., closed streams, raw fds) deliberately have no COPY semantics." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The value is, or transitively contains, a linear resource with a CLOSE contract. Duplicating the handle would make two owners close the same underlying resource." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use `CLONE` for shared / refcounted handles. For linear resources, transfer ownership via `GIVE` or pass through a borrow." }}, :KEEP_WITH_SCOPED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :escape }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot KEEP WITH-scoped '%{name}'. WITH bindings are protected borrows; use COPY to return owned data." }, :summary: DiagnosticEntryValue{ StringValue: COPY "KEEP on a WITH-scoped binding would create another owner that outlives the WITH." }}, :SHARE_NEEDS_TYPED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "SHARE requires a typed value" }, :summary: DiagnosticEntryValue{ StringValue: COPY "SHARE can't be applied to a value with no resolvable type." }}, :SHARE_WITH_SCOPED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :escape }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot SHARE WITH-scoped '%{name}'. WITH bindings are protected borrows; use COPY to return owned data." }, :summary: DiagnosticEntryValue{ StringValue: COPY "SHARE on a WITH-scoped binding would create a reference that outlives the WITH." }}, :ON_RETRY_NEEDS_FALLIBLE_CAP: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "ON / RETRY clause requires a WITH capability that can fail (EXCLUSIVE on @locked/@writeLocked, or read on @writeLocked). The declared capabilities never produce a lock-acquire error." }, :summary: DiagnosticEntryValue{ StringValue: COPY "ON / RETRY only attaches to WITH captures whose acquire can fail (locks with timeouts, snapshots, etc)." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "(EXCLUSIVE on @locked/@writeLocked, or read on @writeLocked). The declared capabilities never produce a lock-acquire error." }}, :SELECTORS_NO_MATCH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "Selectors [%{matched}] do not match %{possible}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "ON-clause error selectors don't match any of the WITH captures' fallible kinds." }}, :DO_CAPTURES_WITH_SCOPED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :escape }, :template: DiagnosticEntryValue{ StringValue: COPY "DO block captures a WITH-scoped (BORROWED/RESTRICT) binding. WITH bindings are stack aliases that become invalid when the WITH block exits. Move the DO block outside the WITH block, or use COPY to get an owned value." }, :summary: DiagnosticEntryValue{ StringValue: COPY "DO branches can't capture WITH-scoped bindings \u{2014} they must end with the WITH." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "WITH bindings are stack aliases that become invalid when the WITH block exits. Move the DO block outside the WITH block, or use COPY to get an owned value." }}, :BG_STREAM_NO_YIELD: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "BG STREAM block has no YIELD statements. Use BG { } for a plain promise." }, :summary: DiagnosticEntryValue{ StringValue: COPY "BG STREAM without YIELD has no stream output \u{2014} use BG instead." }}, :BG_STREAM_INCONSISTENT_YIELD: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "BG STREAM returns inconsistent types (%{types}) from its YIELD expressions. To return both, declare a named union covering %{union_shape}, add `YIELDS YourUnion`, and YIELD its explicit variants; OR change one of the YIELD expressions so every YIELD has the same base type." }, :summary: DiagnosticEntryValue{ StringValue: COPY "BG STREAM never infers an accidental payload union; declare the union contract or make the yields homogeneous." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use `BG STREAM YIELDS YourUnion { ... }` with explicit named-union variants, OR convert the conflicting YIELD expression to the other payload type. Optional (`?`) and fallible (`!`) widening of one base type does not need YIELDS." }}, :BG_STREAM_YIELDS_REQUIRED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "BG STREAM yields `%{type}`, which requires an explicit item contract. Write `BG STREAM YIELDS %{type} { ... }`. YIELDS is optional for one non-future base type widened only by `?` and/or `!`, but required for future and union item types." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Future and union stream items require an explicit YIELDS contract." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Insert `YIELDS %{type}` between `STREAM` and the opening brace." }}, :BG_STREAM_CAPTURES_WITH_SCOPED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :escape }, :template: DiagnosticEntryValue{ StringValue: COPY "BG STREAM block captures a WITH-scoped (BORROWED/RESTRICT) binding. WITH bindings are stack aliases that become invalid when the WITH block exits. Move the BG STREAM block outside the WITH block, or use COPY to get an owned value." }, :summary: DiagnosticEntryValue{ StringValue: COPY "BG STREAM fibers outlive the WITH \u{2014} they can't capture WITH-scoped bindings." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "WITH bindings are stack aliases that become invalid when the WITH block exits. Move the BG STREAM block outside the WITH block, or use COPY to get an owned value." }}, :YIELD_OUTSIDE_BG_STREAM: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "YIELD can only be used inside a BG STREAM { } block." }, :summary: DiagnosticEntryValue{ StringValue: COPY "YIELD only makes sense inside BG STREAM bodies." }}, :CLOSE_OUTSIDE_BG_STREAM: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "CLOSE can only be used inside a BG STREAM { } block." }, :summary: DiagnosticEntryValue{ StringValue: COPY "CLOSE terminates a BG STREAM producer." }}, :YIELD_AFTER_CLOSE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :concurrency }, :template: DiagnosticEntryValue{ StringValue: COPY "YIELD cannot follow CLOSE on the same BG STREAM control-flow path." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A closed stream cannot emit another item." }}, :STREAM_ALREADY_CLOSED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :concurrency }, :template: DiagnosticEntryValue{ StringValue: COPY "This BG STREAM control-flow path has already executed CLOSE." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A stream producer can close only once on a path." }}, :INFINITE_STREAM_CLOSE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :concurrency }, :template: DiagnosticEntryValue{ StringValue: COPY "An infinite stream cannot execute CLOSE; declare a finite [~]T stream instead." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Infinite streams have no normal completion event." }}, :INFINITE_STREAM_FALLTHROUGH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :concurrency }, :template: DiagnosticEntryValue{ StringValue: COPY "An infinite stream producer can reach the end of its body. Use a non-terminating loop or declare a finite [~]T stream." }, :summary: DiagnosticEntryValue{ StringValue: COPY "An infinite stream must not close by normal fallthrough." }}, :BG_ARENA_AND_PARALLEL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "@arena cannot be combined with @parallel \u{2014} arena memory is thread-local and cannot be stolen." }, :summary: DiagnosticEntryValue{ StringValue: COPY "`@arena` storage is per-scheduler; `@parallel` work-steals across schedulers, breaking arena affinity." }}, :BG_CAPTURES_WITH_SCOPED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :escape }, :template: DiagnosticEntryValue{ StringValue: COPY "BG block captures a WITH-scoped (BORROWED/RESTRICT) binding. Either capture a longer-lived value (the original binding the WITH aliases, or a COPY), restructure so the BG runs inside the WITH and finishes before it exits, or use SHARE to extend the lifetime via Arc." }, :summary: DiagnosticEntryValue{ StringValue: COPY "BG fibers outlive the WITH \u{2014} they can't capture WITH-scoped bindings." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A BG block captured a binding whose lifetime is bounded by an enclosing WITH alias. The fiber may outlive the WITH body \u{2014} the capture would dangle." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Either capture a longer-lived value (the original binding the WITH aliases, or a COPY), restructure so the BG runs inside the WITH and finishes before it exits, or use SHARE to extend the lifetime via Arc." }}, :BG_PINNED_CAPTURE_MISMATCH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "BG block inside @pinned scope captures local variables but is not @pinned. Thread-local memory cannot escape to a stealable fiber. Add @pinned to this BG block, or avoid capturing variables from the pinned scope." }, :summary: DiagnosticEntryValue{ StringValue: COPY "BG blocks inside `@pinned` scopes that capture locals must themselves be `@pinned`." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Thread-local memory cannot escape to a stealable fiber. Add @pinned to this BG block, or avoid capturing variables from the pinned scope." }}, :NEXT_NEEDS_FUTURE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "NEXT requires a future value (~T), got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "NEXT awaits a `~T` (future / stream) \u{2014} the operand must be one." }}, :MOVE_WITH_SCOPED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :escape }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot move WITH-scoped '%{name}'. WITH bindings cannot escape their block." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Moving a WITH-scoped binding would let it escape \u{2014} rejected." }}, :MOVE_BORROWED_INDEX: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot move borrowed value from '%{source}' (container index is a borrow). Use COPY for an explicit deep-copy." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Indexed access borrows from the container \u{2014} moves out aren't allowed." }}, :MOVE_BORROWED_PARAM: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot move borrowed value '%{name}'. Parameters are implicit borrows unless TAKES." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Function parameters are borrows; declare TAKES to allow moves out." }, :cause: DiagnosticEntryValue{ StringValue: COPY "MOVE / GIVE attempted to take ownership of a parameter that was passed as a borrow. Borrow parameters can't be moved \u{2014} the caller still owns the value." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "If the function should consume the parameter, declare it with TAKES at the parameter site. If the function should leave the caller's value intact, COPY the value before moving from the copy." }}, :BORROWED_VAR_NOT_FOUND: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "Variable not found" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Borrow analysis couldn't find the binding being borrowed." }}, :LIFETIME_ALREADY_BORROWED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "Lifetime Error: '%{name}' (or part of it) is already borrowed." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Borrow checker rejects a second simultaneous borrow." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A binding was borrowed (via WITH / BORROWED / RESTRICT) and the borrow is still live when a second borrow / mutation was attempted. CLEAR enforces single-mutable-borrow via lifetime tracking." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "End the existing borrow (close the WITH block) before starting a new one. If the operations need to interleave, restructure so they don't overlap, or use a synchronization primitive." }}, :ASSIGN_WHILE_BORROWED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "Lifetime Error: Cannot assign to '%{name}' because it is currently borrowed." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Borrow checker rejects mutation while a borrow is live." }}, :PROMISE_NOT_CONSUMED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "Promise '%{name}' must be consumed before it goes out of scope. Use NEXT, COLLECT, or RETURN it." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Every BG promise must be awaited (NEXT) or otherwise consumed before its scope ends." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A `~T` promise binding fell out of scope without being awaited or moved into a longer-lived owner. Unawaited promises leak the underlying allocation and represent silent fire-and-forget work." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Either AWAIT the promise to get the value, MOVE it to a binding that outlives the current scope (return, struct field, longer-lived pool), or explicitly DROP it if the result is discardable." }}, :TAIL_CALL_NEEDS_RECURSIVE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :reentrance }, :template: DiagnosticEntryValue{ StringValue: COPY "EFFECTS REENTRANT:TAIL_CALL on '%{fn}' requires at least one RETURN that directly calls '%{fn}' in tail position (e.g., RETURN %{fn}(...)). The recursive call cannot be wrapped in an expression." }, :summary: DiagnosticEntryValue{ StringValue: COPY "TAIL_CALL requires the function to actually contain a tail-recursive call." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "RETURN that directly calls '%{fn}' in tail position (e.g., RETURN %{fn}(...)). The recursive call cannot be wrapped in an expression." }}, :TAIL_CALL_NOT_TAIL_POSITION: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :reentrance }, :template: DiagnosticEntryValue{ StringValue: COPY "EFFECTS REENTRANT:TAIL_CALL: '%{fn}' is called in non-tail position. All recursive self-calls must be the ENTIRE return expression (e.g., RETURN %{fn}(...)). Non-tail recursion would consume the fiber stack on every invocation. If recursion is genuinely non-tail, declare ':THUNK' instead -- it handles arbitrary recursion via a heap state-struct." }, :summary: DiagnosticEntryValue{ StringValue: COPY "TAIL_CALL declared but the recursive call site isn't in tail position." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "All recursive self-calls must be the ENTIRE return expression (e.g., RETURN %{fn}(...)). Non-tail recursion would consume the fiber stack on every invocation. If recursion is genuinely non-tail, declare ':THUNK' instead -- it handles arbitrary recursion via a heap state-struct." }}, :STACK_SAFETY_MUTUAL_RECURSION: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :reentrance }, :template: DiagnosticEntryValue{ StringValue: COPY "Stack safety: this fiber transitively calls '%{callee}' which is `:MAX_DEPTH(N)` AND mutually recursive. Mutual depth-bounds compose as a product across counters and can't be statically bounded; the spawn site must be `@service` (OS thread). Either declare `@service` explicitly or break the cycle (see `:THUNK` for unbounded-depth fibers)." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Stack-tier analysis found mutual recursion that can't be bounded." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "which is `:MAX_DEPTH(N)` AND mutually recursive. Mutual depth-bounds compose as a product across counters and can't be statically bounded; the spawn site must be `@service` (OS thread). Either declare `@service` explicitly or break the cycle (see `:THUNK` for unbounded-depth fibers)." }}, :STACK_SAFETY_USER_SIZE_TOO_SMALL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :reentrance }, :template: DiagnosticEntryValue{ StringValue: COPY "Stack safety: @%{size} (%{budget} bytes) is too small for this fiber. Call-graph analysis requires at least @%{computed}. Use @%{computed} (or @service for OS-thread). (`@canSmash` is reserved for v0.3 -- runtime stack-hysteresis is implemented but not yet wired through the compiler.)" }, :summary: DiagnosticEntryValue{ StringValue: COPY "User-declared stack tier is too small for the fiber's worst-case path." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "is too small for this fiber. Call-graph analysis requires at least @%{computed}. Use @%{computed} (or @service for OS-thread). (`@canSmash` is reserved for v0.3 -- runtime stack-hysteresis is implemented but not yet wired through the compiler.)" }}, :STACK_SAFETY_STACK_ALIAS: {:severity: DiagnosticEntryValue{ SymbolValue: :warning }, :category: DiagnosticEntryValue{ SymbolValue: :reentrance }, :template: DiagnosticEntryValue{ StringValue: COPY "Stack sizing: @stack resolved to @%{computed}; replace @stack with @%{computed}. In STRICT mode, @stack will be rejected." }, :summary: DiagnosticEntryValue{ StringValue: COPY "`@stack` was accepted as a compatibility alias and resolved to a concrete stack tier." }}, :STORE_BORROWED_INTO_CONTAINER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot store borrowed value '%{name}' into %{container}. Use COPY for an explicit deep-copy." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Borrowed values can't be persisted into containers \u{2014} they don't own the underlying memory." }}, :HPT_LEAK: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Heap-returning call result discarded \u{2014} the allocated value never gets cleanup." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A call that allocates on the heap (e.g. `makeList`, `clone`, `intToString`) appeared in statement position without being bound to a variable. The MIR checker has no AllocMark to verify lifetime, so the heap allocation is structurally a leak." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Bind the result: `result = heapCall(...)` so the lowering inserts an AllocMark + matching Cleanup. If you genuinely don't need the value, bind to `_` to make the discard explicit." }}, :ALLOC_WITHOUT_CLEANUP: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "MIR::AllocMark with no matching Cleanup or ErrCleanup on every path." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Every heap allocation must have a matching cleanup on every control-flow path, including error paths and early returns. The checker found a path where the AllocMark is reachable but no Cleanup/ErrCleanup is." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Usually a lowering bug \u{2014} the cleanup classifier should have inserted the cleanup. Check src/mir/cleanup_classifier.rb. If your code has an unusual control-flow shape (early RETURN inside a complex block), that path may need explicit attention." }}, :CLEANUP_REQUIRED_WITHOUT_FINALIZER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Cleanup-bearing AllocMark has no checker-visible finalizer or transfer." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The MIR carries an AllocMark whose concrete Type says the binding owns cleanup-bearing data, but no Cleanup, ErrCleanup, DestroyPtr errdefer, or TransferMark closes the ownership path. Frame arena rewind is not sufficient for values that own internal resources or collection storage requiring deinit." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} make cleanup classification emit a Cleanup/ErrCleanup for the binding, or emit a TransferMark when ownership leaves the current scope. Do not rely on frame allocation alone as the cleanup story for cleanup-bearing types." }}, :CLEANUP_WITHOUT_ALLOC: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "MIR::Cleanup or ErrCleanup with no matching AllocMark \u{2014} orphan cleanup." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The MIR has a Cleanup node naming a binding the AllocMark side never declared. Means the lowering emitted cleanup for a value the allocator never tracked \u{2014} runtime would try to free unknown memory." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} the cleanup classifier disagreed with the alloc classifier. Trace the binding name through cleanup_classifier.rb." }}, :INDIRECT_DOUBLE_BOX: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "MIR::HeapCreate boxes a value whose Zig type is already a pointer (double indirection)." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A heap box is exactly one level of indirection: `HeapCreate(T)` produces `*T`. If T is itself `*U` the result is `**U` \u{2014} a double box. Reading it yields a dangling `*U` after the inner allocation is cleaned up (UAF), and the field/binding type no longer matches. This is the failure mode the @boxed single-source layout guards against." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} the HeapCreate cell type must be the BARE pointee (`transpile_type(base)`), never the already-pointerized field/binding type. Check the @boxed hoist sites in src/mir/mir_lowering.rb (lower_struct_lit / lower_union_variant_lit) use `field_type.resolved`, not `zig_type`." }}, :ALLOC_CLEANUP_MISMATCH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Cleanup's allocator (heap/frame) doesn't match its AllocMark's allocator." }, :cause: DiagnosticEntryValue{ StringValue: COPY "AllocMark allocated on heap but Cleanup is freeing on frame, or vice versa. Calling `frame.free()` on heap memory (or `heap.free()` on frame memory) is an allocator mismatch \u{2014} runtime crash or corruption." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} the per-binding allocator decision drifted between alloc and cleanup. Check that cleanup_classifier.rb gives both nodes the same allocator stamp." }}, :INLINE_ALLOC_MISMATCH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Structural MIR op uses an allocator that doesn't match the container's AllocMark." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Storing frame-allocated data into a heap container (or heap data into a frame container) leaves dangling pointers after frame rewind. The checker compares the op's `:alloc` / `:key_alloc` / `:val_alloc` metadata against the container's AllocMark allocator and rejects mismatches." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Make the container's allocator and the inserted data's allocator agree. Usually the fix is upgrading the container to heap (`@list:heap` or assignment-time promotion) or making the inserted data heap-owned." }}, :CROSS_FRAME_PARAM_ALLOC: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Allocator-bearing op on a pointer-passed parameter must not use the frame allocator." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A pointer-passed parameter (MUTABLE collection / `*T` Zig type) carries a lifetime that extends past this function's mark/restore. A `:frame` allocation here would die when the function returns, leaving the caller with a dangling buffer pointer \u{2014} a cross-frame use-after-free." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} `resolve_alloc_sym` for `:receiver_storage` should pick `:heap` when the receiver is a pointer-passed param. The matching escape promotion lives in escape_analysis.rb (Condition 9). If both look right, check that the MIR function context marks this as a collection parameter." }}, :INLINE_NO_CONTRACT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "A raw Zig MIR carrier has no verifier-visible callable contract." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Opaque Zig text is not a valid MIR surface. MIRChecker cannot prove that raw text does not allocate, free, borrow, or transfer." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Replace the raw Zig carrier with structural MIR, or lower it from a registry entry that carries a FunctionSignature and ownership metadata." }}, :OPAQUE_ZIG_OWNERSHIP: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Raw Zig hides allocator ownership operations." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Opaque Zig text contains allocator operations such as alloc, dupe, create, destroy, free, or deinit. A callable signature can describe boundary effects, but it cannot prove that arbitrary internal heap ownership is balanced." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Decompose the operation into structural MIR with AllocMark, Cleanup, ErrCleanup, DestroyPtr, and TransferMark nodes, or move the operation behind a runtime API whose implementation is outside compiler MIR." }}, :OWNERSHIP_FACT_REQUIRED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Ownership-capable MIR must be finalized into explicit ownership facts." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The MIR node can allocate, free, consume, store, capture, or return owned data, but that effect is still encoded through node-specific side channels. MIRChecker can only be a memory-safety gate when it reads a closed ownership fact stream." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} run ownership finalization before MIRChecker and emit MIR::OwnedCreate / OwnedDestroy / OwnedTransfer / OwnedStore / OwnedReturn facts for this operation. Do not hide ownership in raw Zig text or ad-hoc node fields." }}, :BOUNDARY_FACT_REQUIRED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Execution-boundary MIR must carry typed boundary/capture facts." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A BG, BG STREAM, DO branch, or similar execution boundary reached MIRChecker without the closed fact object that names its dispatch mode and captured capabilities. Without that fact, the checker cannot prove scheduler/capture safety." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} copy the annotated capture analysis into MIR::ExecutionBoundaryFact before MIRChecker. Do not rely on parser flags or pre-MIR booleans as the final authority." }}, :BOUNDARY_CAPTURE_NOT_PARALLEL_SAFE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "A non-parallel-safe capture crosses a parallel execution boundary." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The boundary dispatches work across schedulers, but one captured binding is scheduler-affine or non-atomic. That can break capability guarantees even if the emitted code happens to compile." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use a parallel-safe capability such as @shared where appropriate, pin the boundary instead of using @parallel, or avoid capturing the binding." }}, :MIR_CALL_NO_CONTRACT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "MIR call has no verifier-visible callable contract." }, :cause: DiagnosticEntryValue{ StringValue: COPY "`MIR::Call`, `MIR::TailCall`, and `MIR::MethodCall` only carry emitted callee text and arguments. Without a typed callable contract, MIRChecker cannot prove whether arguments are borrowed, consumed, or returned." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} attach a typed callable/effect contract to the MIR call or lower the operation into structural MIR nodes with explicit ownership events." }}, :FRAME_NO_REWIND: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Loop body frame-allocates but has no per-iteration restoreLoopMark defer." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A loop whose body frame-allocates (a `String[]@list = []` per iteration, an interpolated string, etc.) needs save/restore around each iteration so the arena rewinds between rounds. Without it, the frame grows unboundedly with each loop turn." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug if the loop is non-TIGHT \u{2014} the mark/restore should have been inserted automatically. If the loop is TIGHT, that's the cause: TIGHT skips the per-iteration mark/restore. Either remove TIGHT, or hoist the allocation out of the loop body." }}, :UNHOISTED_ALLOC: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Allocating expression appears in argument / sub-expression position without an AllocMark." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Every MIR node that allocates memory (DupeSlice, HeapCreate, ConcatStr, AllocSlice, MakeList, CapWrap, SharePromote, deep DeepCopy, ContainerInit) must appear as the direct init of a `MIR::Let` so it has an AllocMark. Found one in argument / return / field-value position instead." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} HPT hoisting (hoist_alloc) should have lifted the call into a Let. Check the producer pass that emitted the allocating node; it should bind the result to a fresh local." }}, :ALLOCATING_LET_WITHOUT_ALLOC: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Heap-allocating Let initializer has no checker-visible AllocMark." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A top-level MIR::Let may be the legal place for an allocating expression, but the binding still needs an AllocMark so MIRChecker can prove it is cleaned or explicitly transferred." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} emit AllocMark for the binding from its finalized storage, then emit Cleanup/ErrCleanup or TransferMark at the ownership boundary." }}, :OWNED_RETURN_WITHOUT_ALLOC: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Owned-return call is bound without a checker-visible AllocMark." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A call whose return value owns heap data was lowered directly into a binding, but the binding has no MIR::AllocMark. Without the marker, MIRChecker cannot verify that cleanup exists on every path." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} preserve return provenance through FunctionSignature import/reconstruction and make the cleanup classifier emit AllocMark + Cleanup for the binding." }}, :OWNED_RETURN_ALLOC_NOT_HEAP: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Owned-return call has a non-heap AllocMark." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A call whose return value owns heap data was paired with an AllocMark that says the value is frame-allocated. That lets AllocMark and Cleanup agree with each other while still freeing heap-owned data through the wrong allocator." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} the AllocMark for a heap-provenance return must use :heap or :cleanup, never :frame." }}, :OWNED_RESULT_WITHOUT_ALLOC: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Owned-result expression is bound without a checker-visible AllocMark." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A MIR expression declared that it produces owned storage, but the receiving binding has no AllocMark. Without the marker, MIRChecker cannot verify cleanup or transfer." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} propagate the expression's owned_result_alloc fact into the binding's allocation and cleanup plan." }}, :OWNED_RESULT_ALLOC_MISMATCH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Owned-result expression allocator disagrees with its binding AllocMark." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The producer declared that its result is owned by one allocator, while the receiving binding was stamped with another. AllocMark and Cleanup may match each other while still freeing through the wrong allocator." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} the receiving binding must use the producer's owned_result_alloc as the authoritative allocator." }}, :RETURN_TRANSFER_WITHOUT_ALLOC: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Return ownership transfer exists without a matching AllocMark." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A MIR::TransferMark(:return) says the caller owns a binding after return, but the callee has no checker-visible allocation event for that binding." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} return transfers must be attached to a named binding with an AllocMark." }}, :RETURN_TRANSFER_FRAME_ALLOC: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Return ownership transfer is backed by frame allocation." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A value whose ownership leaves the function cannot be allocated in the callee's frame arena. The frame rewinds before the caller's cleanup runs, producing a dangling buffer or allocator mismatch." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Escape analysis/lowering bug \u{2014} escaping owned returns must set the binding storage to heap before MIR lowering emits AllocMark." }}, :FRAME_ALLOC_ESCAPES: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Frame-allocated ownership transfers to an escaping owner." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A frame allocation is only valid within the current frame lifetime. Transferring it to a return value, container, captured boundary, or external parameter lets another owner observe memory after the frame rewinds." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Escape analysis bug \u{2014} the binding reached an escape sink but was not stamped heap before MIR lowering emitted AllocMark." }}, :TRANSFER_WITHOUT_ALLOC: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "TransferMark exists without a matching AllocMark." }, :cause: DiagnosticEntryValue{ StringValue: COPY "MIR::TransferMark suppresses local cleanup because ownership left the current scope. Without a matching AllocMark, there is no checker-visible allocation event to prove what was transferred." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} emit TransferMark only alongside the AllocMark for the owned binding being moved." }}, :OWNERSHIP_USE_AFTER_TRANSFER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "MIR reads an owned binding after ownership left the scope." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Once MIR emits a TransferMark or equivalent release for an owned binding, later reads of that binding are use-after-free unless the binding has been reallocated." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} emit the transfer at the actual ownership boundary after the final read, or materialize a separate owned copy before transferring." }}, :OWNERSHIP_DOUBLE_RELEASE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "MIR releases or transfers the same owned binding more than once." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A binding may have exactly one success-path owner at a time. Multiple TransferMark/release events for the same allocation are a double-free risk." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} collapse the ownership transfer to one event, or split distinct allocations into distinct bindings." }}, :OWNERSHIP_DOUBLE_FINALIZER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "MIR registers more than one cleanup finalizer for the same owned binding." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Multiple Cleanup/ErrCleanup registrations for one allocation mean the same owned value can be freed more than once." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} each AllocMark must own one cleanup strategy: normal cleanup, errcleanup plus transfer, destroy, or transfer." }}, :OWNERSHIP_UNVERIFIED_PATH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "MIR control flow rejoins with different ownership state." }, :cause: DiagnosticEntryValue{ StringValue: COPY "MIRChecker cannot prove memory safety when one branch owns/transfers/finalizes a binding differently from another branch." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} make ownership events explicit and identical at the join, or keep ownership entirely outside the branch." }}, :LINEAR_STMT_NOT_REGISTERED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "MIR statement is missing from linear ownership verification." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A statement node reached MIRChecker without being registered in the closed linear ownership traversal. Treating it as a generic expression would let new ownership-affecting statement types bypass leak/UAF/double-free checks." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Register the statement in MIRChecker::LINEAR_STATEMENT_NODE_TYPES and add the structural traversal it needs. If it can affect ownership, expose that through explicit MIR ownership facts." }}, :OWNERSHIP_IMPLICIT_MOVE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "MIR suppresses cleanup without an explicit ownership transfer." }, :cause: DiagnosticEntryValue{ StringValue: COPY "MoveMark changes runtime cleanup behavior. Without a matching TransferMark, the checker cannot prove who owns the value after cleanup is suppressed." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} emit a TransferMark for the same binding at the same ownership boundary, or remove the MoveMark." }}, :OWNERSHIP_CLEANUP_FOR_BORROW: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "MIR cleanup was emitted for a borrowed/non-owning binding." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A binding initialized from a borrowed view, such as an indexed element or field payload, received Cleanup/ErrCleanup even though it did not create or receive ownership. Cleaning that alias can free memory still owned by the source aggregate." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} either deep-copy into a fresh owned binding, transfer ownership explicitly, or keep the borrowed alias cleanup-free." }}, :OWNERSHIP_STRUCTURAL_RC_COPY: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Reference-counted handles cannot be structurally copied." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Rc/Arc/Weak handles own a control-block count. Copying their pointer fields without a retain fabricates an uncounted owner and causes premature release, leaks, or use-after-free." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} emit RcRetain/WeakUpgrade/RcDowngrade for direct handles. Aggregate copies must route RC fields through the runtime retain-aware dupeValue path." }}, :GENERIC_IDENTITY_FIELD_UNSUPPORTED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "STRUCT '%{struct}' declares identity field '%{field}: %{param} @multiowned', but identity capabilities on generic type parameters are not yet supported" }, :summary: DiagnosticEntryValue{ StringValue: COPY "A generic type parameter cannot yet carry an identity capability." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Substituting a concrete type into an identity-capable generic field either double-wraps an already-managed binding or fails to wrap a payload; generic keep-analysis has not been implemented." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use a concrete identity type for the field, or drop the capability and wrap at the binding site." }}, :KEPT_FN_VALUE_ABI: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "'%{name}' keeps parameter '%{param}' (%{sink}), so its compiled signature takes an owned handle and is incompatible with the plain function type '%{fn_type}'. Retention is not yet representable in function values" }, :summary: DiagnosticEntryValue{ StringValue: COPY "A retaining function cannot be used as a plain function value." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Keep-analysis changes the kept parameter's ABI to the ownership family's handle. An ordinary FN type carries no retained-parameter contract, so assigning the function to it would produce an incompatible function pointer." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Call the function directly, or wrap it: a non-retaining adapter that constructs/receives the identity explicitly can be passed as a function value." }}, :KEEP_ON_KNOWN_CARRIER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "KEEP on '%{name}' is redundant: its carrier is statically known (%{carrier}), so use COPY for an independent copy" }, :summary: DiagnosticEntryValue{ StringValue: COPY "KEEP is only for carrier-polymorphic values." }, :cause: DiagnosticEntryValue{ StringValue: COPY "KEEP preserves a caller-chosen carrier. A plain local or a UNIQUE parameter has a statically known carrier, so the polymorphic form carries no information and hides whether an independent copy was intended." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use COPY to create an independent copy." }}, :RETAINED_NEEDS_OWN_COPY: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "'%{name}' is a retained %{carrier} handle and cannot fill the plain parameter '%{param}': a handle can't be moved into a plain slot without an explicit carrier decision. Passing it bare would silently deep-copy the payload out of the shared handle" }, :summary: DiagnosticEntryValue{ StringValue: COPY "A retained handle can't silently fill a plain parameter." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The parameter is a plain (RawT) owned slot, but the argument is a @multiowned/@shared handle whose identity other owners may share. Crossing that carrier boundary must be explicit -- never a hidden allocation and deep copy." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use OWN COPY %{name} to own an independent copy of the payload, or declare the parameter '%{param}: SHARED T' (or MONOMORPHIC T) to keep the handle." }}, :OWN_ALONE_UNSUPPORTED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "OWN must be followed by COPY. OWN COPY x owns an independent copy of the payload (dereferencing a @multiowned/@shared handle); bare OWN x (moving the payload out of a handle) is not yet supported" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Bare OWN is not yet supported; write OWN COPY." }, :cause: DiagnosticEntryValue{ StringValue: COPY "OWN x alone would extract the payload out of a handle, which requires proving the handle is uniquely owned; that path is deferred. OWN COPY x always works because it copies the payload rather than moving it." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Write OWN COPY x to own an independent copy of the payload." }}, :UNIQUE_NEEDS_EXCLUSIVE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "'%{name}' is a retained %{carrier} value and is passed to the UNIQUE parameter '%{param}' without OWN COPY. A UNIQUE parameter requires exactly one owner; a live @multiowned/@shared handle is (or may be) multi-owned" }, :summary: DiagnosticEntryValue{ StringValue: COPY "A UNIQUE parameter cannot receive a live multi-owned handle." }, :cause: DiagnosticEntryValue{ StringValue: COPY "UNIQUE means the callee owns the value exclusively. A retained handle shares its identity with other owners, so handing it over bare would give the callee a non-exclusive value." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use OWN COPY %{name} to detach an independent payload for the UNIQUE parameter, or pass a plain/uniquely-owned value." }}, :COPY_RETAINED_NEEDS_UNIQUE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "COPY of '%{name}' is not allowed: it is a retained %{carrier} handle, and COPY is a memcpy -- copying the handle bits would duplicate a shared owner without touching the reference count" }, :summary: DiagnosticEntryValue{ StringValue: COPY "COPY (a memcpy) cannot copy a live @multiowned/@shared handle." }, :cause: DiagnosticEntryValue{ StringValue: COPY "COPY performs a bitwise copy of the value. For a retained carrier the value IS a handle, so a memcpy would create a second owner that never incremented the reference count -- a double free. Retaining another handle or detaching an independent payload are different operations." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use KEEP %{name} to retain another handle (carrier-preserving), or OWN COPY %{name} to own an independent copy of the payload." }}, :COPY_ON_POLYMORPHIC_PARAM: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "COPY on '%{name}' is not allowed: it is a carrier-polymorphic parameter, so COPY cannot guarantee independent identity when the caller passed a retained (@multiowned/@shared) value" }, :summary: DiagnosticEntryValue{ StringValue: COPY "COPY needs a local or UNIQUE value, not a carrier-polymorphic parameter." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A carrier-polymorphic parameter may be backed by a retained handle whose identity other owners share; COPY there would either retain (not independent) or require a hidden deep copy. The correctness choice must be explicit." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use KEEP to preserve the caller's carrier, or declare the parameter UNIQUE if independent identity is required." }}, :CARRIER_POLYMORPHIC_FANOUT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "%{detail}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "A carrier-polymorphic parameter is consumed then used again." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A TAKES parameter with no UNIQUE/SHARED constraint preserves the caller's ownership carrier. Consuming it once and using it again creates a second owner, which requires an explicit correctness choice: KEEP preserves the carrier; UNIQUE + COPY forces independent identity." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Wrap the first consuming use as KEEP, or declare the parameter UNIQUE and use COPY if independent identity is required." }}, :KEPT_IDENTITY_FAMILY_MISMATCH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "'%{name}' is @%{source_family} but is kept by '%{keeper}' (%{sink}), which requires an @%{dest_family} identity. %{source_family} and %{dest_family} use incompatible reference-counting (Arc is atomic, Rc is not), so the handle cannot be retained across the call without breaking the other owners' accounting" }, :summary: DiagnosticEntryValue{ StringValue: COPY "A kept edge cannot convert between reference-counting families." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Keep-analysis retains the caller's handle in the callee's identity field. @shared (Arc) and @multiowned (Rc) maintain their counts differently, so passing one where the other is retained would corrupt the surviving owners' counts." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Match the families (declare the source @%{dest_family}), or break identity with COPY %{name} so the keeper constructs an independent handle." }}, :KEPT_IDENTITY_NEEDS_MODEL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "'%{name}' is kept by '%{keeper}' (%{sink}) and is a plain MUTABLE binding. Unique ownership cannot satisfy a keep; declare the cost model at the declaration: '@multiowned' shares one identity (callers observe mutations), '@value' gives every keeper an independent copy, or pass 'GIVE %{name}' at the last use so the handle moves" }, :summary: DiagnosticEntryValue{ StringValue: COPY "A plain MUTABLE binding is kept, and no cost model is sound by default." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A kept destination stores the value's identity beyond the call. For an immutable binding the mechanism is unobservable, but a MUTABLE binding used after the call makes sharing-vs-copying observable, so the declaration must choose." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Append @multiowned or @value to the declaration, or relinquish with GIVE at the call." }}, :SHARDED_ELEMENT_REQUIRES_SHARED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "@sharded collections cannot store %{got}; cross-scheduler reference-counted elements must use @shared" }, :summary: DiagnosticEntryValue{ StringValue: COPY "A scheduler-sharded collection cannot own non-atomic reference counts." }, :cause: DiagnosticEntryValue{ StringValue: COPY "@multiowned uses scheduler-local non-atomic Rc state and allocator provenance. A shard may destroy or copy an element on a different scheduler, where releasing that Rc is unsafe." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Declare the element/value as @shared, or use an unsharded collection that remains on one scheduler." }}, :MOVEMARK_WITHOUT_GUARD: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "MoveMark exists outside the lexical scope that declares its moved guard." }, :cause: DiagnosticEntryValue{ StringValue: COPY "MIR::MoveMark emits `name_moved = true`, but that variable is only declared by a visible guarded Cleanup/ErrCleanup. If lowering moves the marker out of the binding's scope, Zig sees an undeclared guard and ownership cannot be verified." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} emit MoveMark only at the consuming expression in the same lexical body as the guarded cleanup, or remove it when success is represented by ErrCleanup + TransferMark." }}, :ERRCLEANUP_WITHOUT_TRANSFER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "ErrCleanup exists without an explicit success-path ownership transfer." }, :cause: DiagnosticEntryValue{ StringValue: COPY "MIR::ErrCleanup means the binding is cleaned only on error because success transfers ownership. Without a matching MIR::TransferMark, the success-path owner is implicit and MIRChecker cannot prove leak/double-free safety." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} emit MIR::TransferMark at the same ownership boundary that converts Cleanup to ErrCleanup, or keep a normal Cleanup if ownership does not transfer." }}, :AGGREGATE_CHILD_ALLOC_MISMATCH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Owned aggregate child allocator disagrees with the aggregate owner." }, :cause: DiagnosticEntryValue{ StringValue: COPY "An owned temporary was inserted into an aggregate whose owner uses a different allocator. The aggregate cleanup cannot be authoritative if nested children were independently placed." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} flow the aggregate destination allocator recursively into child materialization, or make the aggregate owner heap when its children must be heap." }}, :PROVENANCE_PLACEMENT_FORBIDDEN: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "MIR still carries provenance-based heap/frame placement." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Heap/frame placement must be closed before MIR lowering and represented by binding AllocMark/Cleanup facts. A MIR node carrying side-channel placement means downstream code is still deciding ownership after placement." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Delete the provenance path. Hoist the value to a binding if needed, stamp the binding's SymbolEntry#storage during escape analysis, then emit AllocMark/Cleanup from that binding placement." }}, :INLINE_ALLOC_WITHOUT_TARGET: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Allocator-bearing MIR op has no target binding for MIRChecker to verify." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Allocator-bearing MIR operations must be attached to the binding/container they mutate or produce. Without a target binding, MIRChecker cannot compare the operation allocator against authoritative placement." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Hoist the operation into a named binding or attach target_var to the receiver/result binding. Do not infer the allocator locally in lowering." }}, :INLINE_ALLOC_WITHOUT_ALLOCMARK: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Allocator-bearing MIR op targets a binding that has no AllocMark." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Allocator-bearing MIR operation named a target, but the target has no checker-visible allocation marker. That means the operation allocator cannot be compared against authoritative binding placement." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} the target binding must have an AllocMark emitted from CleanupClassifier placement before allocator-bearing operations can mutate it." }}, :INVALID_ALLOCATOR_MARK: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "MIR uses an allocator symbol outside the closed heap/frame set." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Placement must be finalized before MIR lowering. AllocMark, Cleanup, and structural allocator metadata may only carry :heap or :frame. Any other symbol is a downstream side channel." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Move the decision to escape analysis or cleanup classification, then emit only :heap or :frame into MIR." }}, :ALLOC_MARK_TYPE_MISSING: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "MIR::AllocMark has no concrete Type payload." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The lowering emitted an allocation ownership fact without the type needed to prove whether the value owns heap memory and what cleanup shape is legal. Nil or :Untyped type info makes cleanup verification coincidental." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} derive the AllocMark type from the allocation producer or already-typed AST source before MIRChecker runs." }}, :COPY_CLEANUP: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Cleanup attached to a primitive / Id<T> value \u{2014} value types don't own heap memory." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A Cleanup paired with an AllocMark whose `type_info` is a primitive (Int*, Float*, Bool, Byte) or `Id<T>` (with no sync/rc capability) can't be right \u{2014} these are pure value types that never own heap memory, so a cleanup is structurally meaningless." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug. Check that the cleanup classifier doesn't promote primitives to needing cleanup. The fix usually drops the cleanup node and the alloc-site decision rather than 'fixing' the cleanup." }}, :IMPLICIT_OWNERSHIP_TRANSFER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "A consuming MIR operation has no explicit ownership contract." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The stdlib registry declares a TAKES/consuming parameter, but the lowered structural MIR node did not carry a typed ownership operand fact for the concrete binding being consumed. MIRChecker cannot prove whether that binding is cleaned, transferred, double-freed, or leaked." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} carry typed MIR::OwnershipOperandFact entries from the annotated TAKES/GIVE site into the ownership contract, and emit matching MIR::TransferMark nodes. If the call deep-copies instead of consumes, do not mark the source moved." }}, :OWNERSHIP_CONTRACT_WITHOUT_TRANSFER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "An ownership contract consumes a binding with no TransferMark." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The ownership contract's typed owned operand facts say a binding leaves the current scope, but MIR has no TransferMark for that binding. The checker cannot distinguish an intended transfer from a missing cleanup." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} emit MIR::TransferMark at the consuming boundary, or keep the binding's normal Cleanup if ownership does not actually transfer." }}, :OWNERSHIP_TRANSFER_COPIED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "A consuming ownership contract was lowered as a deep copy." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Copying and consuming are different ownership events. A deep copy leaves the source owned by the current scope; a consuming TAKES transfer removes local ownership. Treating both as the same event causes leaks or double-frees." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} either pass the original binding and transfer it, or deep-copy into a separate owned temporary and consume that temporary while keeping the source cleanup." }}, :OWNERSHIP_CONSUMPTION_FACT_MISSING: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "A consuming MIR operation has no typed ownership operand fact." }, :cause: DiagnosticEntryValue{ StringValue: COPY "MIRChecker cannot prove ownership safety from node shape, Zig text, or inferred names. Every consuming edge must carry explicit operand provenance from lowering." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} emit a MIR::OwnershipConsumptionFact with typed MIR::OwnershipOperandFact entries at the consuming edge." }}, :OWNERSHIP_CONSUMPTION_OPERAND_MISSING: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "A consuming MIR operation has an empty ownership operand fact." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The lowered node claims to consume ownership but does not identify a concrete operand whose ownership can be tracked linearly." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug \u{2014} attach the concrete owned operand, or mark the call as covering consuming params with no ownership only when every TAKES argument is non-owning/copyable." }}, :OWNERSHIP_CONSUMPTION_BORROWED_OPERAND: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :mir }, :template: DiagnosticEntryValue{ StringValue: COPY "%{message}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "A borrowed operand was passed to an owning MIR sink." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Field/index access borrows from an owner. A borrowed access cannot be consumed because local cleanup still belongs to the container/root owner." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Lowering bug or source error \u{2014} consume an owned binding, use GIVE/remove to transfer ownership, or COPY to create an owned temporary." }}, :TIGHT_CALLS_EXTERN_FN: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :reentrance }, :template: DiagnosticEntryValue{ StringValue: COPY "TIGHT loop cannot call EXTERN FN '%{name}' (opaque to scheduler)" }, :summary: DiagnosticEntryValue{ StringValue: COPY "EXTERN FN calls in a TIGHT loop are opaque to the scheduler \u{2014} disallowed." }}, :TIGHT_CALLS_REENTRANT_FN: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :reentrance }, :template: DiagnosticEntryValue{ StringValue: COPY "TIGHT loop cannot call plain EFFECTS REENTRANT function '%{name}'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "TIGHT loops disallow calls to plain EFFECTS REENTRANT functions (unbounded depth)." }}, :REENTRANCY_MUTUAL_CYCLE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :reentrance }, :template: DiagnosticEntryValue{ StringValue: COPY "Reentrancy Error: '%{name}' is part of a mutually recursive call cycle. Add EFFECTS REENTRANT or a bounded REENTRANT variant to the function signature." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Function is in a mutual-recursion cycle but lacks an explicit reentrance declaration." }}, :PLAIN_REENTRANT_VARIANT_SUGGESTION: {:severity: DiagnosticEntryValue{ SymbolValue: :info }, :category: DiagnosticEntryValue{ SymbolValue: :reentrance }, :template: DiagnosticEntryValue{ StringValue: COPY "'%{fn}' is plain `EFFECTS REENTRANT` (forces callers onto `@service` / OS thread). %{reason} -- migrating to `%{suggestion}` lets callers stay on the regular fiber stack. (Phase 5 audit; opt-in via `clear fix`.)" }, :summary: DiagnosticEntryValue{ StringValue: COPY "A plain reentrant function appears to fit a bounded reentrance variant." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Accept the suggested bounded variant when the body shape and recursion semantics match." }}, :REENTRANT_MAX_DEPTH_MUTUAL_DEMOTED: {:severity: DiagnosticEntryValue{ SymbolValue: :warning }, :category: DiagnosticEntryValue{ SymbolValue: :reentrance }, :template: DiagnosticEntryValue{ StringValue: COPY "EFFECTS REENTRANT:MAX_DEPTH(%{max_depth}) on '%{fn}' is silently demoted to ':unbounded' stack tier (4 MB :service OS thread per fiber) because the function is part of a mutual cycle (%{cycle}) and the compiler can't bound the SCC's interleaved-counter product (Phase 5+ work). The MAX_DEPTH(N) bound on this fn alone does NOT cap the cycle's stack depth -- a bounce between members can still grow the fiber stack arbitrarily. To fix: refactor the cycle into ONE directly-self-recursive fn (inline the partner's body or pass a state tag in a single combined fn) so the MAX_DEPTH counter actually bounds it; or accept ':unbounded' explicitly via the auto-fix below." }, :summary: DiagnosticEntryValue{ StringValue: COPY "MAX_DEPTH on one member of a mutual-recursion cycle does not bound the whole cycle." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Refactor the cycle into one directly self-recursive function, or accept plain `EFFECTS REENTRANT` explicitly." }}, :UNCONSTRAINED_FN_PARAM_REENTRANCE: {:severity: DiagnosticEntryValue{ SymbolValue: :warning }, :category: DiagnosticEntryValue{ SymbolValue: :lint }, :template: DiagnosticEntryValue{ StringValue: COPY "Function '%{fn}' has %{subject} (%{candidates}). Add 'REQUIRES <name>: NON_REENTRANT' (rejects reentrant callbacks) or 'EFFECTS REENTRANT' on '%{fn}' (propagates the cost)." }, :summary: DiagnosticEntryValue{ StringValue: COPY "A function accepts callback parameters without constraining their reentrance cost." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Add a NON_REENTRANT requirement for callback parameters that must stay bounded, or declare the owner function reentrant." }}, :INT_LITERAL_OVERFLOW: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Integer literal (%{val}) overflows %{type} (range %{min}..%{max})" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Integer literal does not fit in the target integer type." }}, :STDLIB_METHOD_NO_ARGS: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "%{label}.%{method} takes no arguments, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Stdlib method takes no arguments but received some." }}, :STDLIB_METHOD_ARITY: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "%{label}.%{method} requires exactly %{expected} argument(s), got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Stdlib method called with the wrong number of arguments." }}, :STRICT_TEST_NEEDS_STUB: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :test }, :template: DiagnosticEntryValue{ StringValue: COPY "Strict test mode: '%{name}' is an IO function that must be stubbed. Add STUB %{name} RETURNS <value>; to the WHEN block." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Strict test mode requires every IO function to be stubbed." }}, :STRICT_TEST_HAS_IO_EFFECTS: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :test }, :template: DiagnosticEntryValue{ StringValue: COPY "Strict test mode: '%{name}' has IO effects (%{effects}). Either stub '%{name}' or stub the IO functions it calls." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Strict test mode rejects un-stubbed functions that transitively perform IO." }}, :UNION_TYPE_UNKNOWN: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Unknown union type: '%{name}'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Union type is not registered in this scope." }}, :NOT_A_UNION_TYPE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: '%{name}' is not a union type." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Identifier referenced as a union but is something else." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The construction site or MATCH subject treats `%{name}` as a UNION (`%{name}.Variant(...)` / `MATCH x START %{name}.A -> ...`). The compiler resolves `%{name}` to a struct, enum, or other non-union type \u{2014} operations that demand a UNION can't apply." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Either change the syntax to match `%{name}`'s actual kind (struct literal `%{name}{ field: value }`, enum value `%{name}.Variant`), or import / declare a UNION named `%{name}` if that was the intent." }}, :UNION_VARIANT_IS_UNIT_NO_FIELDS: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Union variant '%{variant}' is a unit variant \u{2014} use '%{union}.%{variant}' (no fields)." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Unit variant cannot accept inline-struct fields." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Unit variants carry no payload at all. Brace-syntax construction (`%{union}.%{variant}{ field: ... }`) implies inline-struct fields the variant doesn't declare; allowing it would silently drop the supplied fields." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Drop the braces: `%{union}.%{variant}` is the construction form for unit variants. If the variant needs to carry data, declare it with an inline-struct or payload type at the UNION definition." }}, :UNION_VARIANT_NEEDS_PAYLOAD_OBJECT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Union variant '%{variant}' takes a single typed payload \u{2014} use '%{union}{ %{variant}: value }' instead." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Single-payload variant cannot use the inline-struct '{ field: ... }' form." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Variants come in three shapes: unit (no data), single-payload (`Variant: T`), and inline-struct (`Variant: { f: T, ... }`). A single-payload variant takes exactly one positional payload; the brace-with-fields form is reserved for inline-struct variants and would set fields the variant doesn't declare." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use the colon form: `%{union}{ %{variant}: value }` (or shorthand `%{union}.%{variant}(value)` if the variant supports it). For per-field construction, redeclare the variant as an inline-struct at the UNION definition." }}, :REENTRANT_NEEDS_FALLIBLE_RETURN: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :reentrance }, :template: DiagnosticEntryValue{ StringValue: COPY "%{variant_text} on '%{fn}' requires an error-union return type (`!T`) so callers can handle the runtime guard's `System %{err}`. Declared return type is '%{rt}'; change it to '%{suggested}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Bounded-reentrance functions must return an error union so callers can catch the depth-guard error." }}, :REENTRANT_NOT_LOGICAL_BUT_RECURSIVE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :reentrance }, :template: DiagnosticEntryValue{ StringValue: COPY "EFFECTS REENTRANT:NOT_LOGICAL on '%{name}' but the function %{cycle_desc} -- the runtime StackGuard would raise System UnexpectedRecursion on every call. NOT_LOGICAL is for functions the user asserts are NEVER reachable from themselves (e.g. a callback hook that mustn't recurse). For real recursion, declare 'EFFECTS REENTRANT:THUNK' (heap-CPS trampoline; depth = number of frames the heap can hold) or 'EFFECTS REENTRANT:MAX_DEPTH(N)' (bounded recursion; raises System MaxDepthExceeded above N)." }, :summary: DiagnosticEntryValue{ StringValue: COPY "NOT_LOGICAL asserts non-recursion but the function is recursive." }}, :REENTRANT_THUNK_NOT_RECURSIVE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :reentrance }, :template: DiagnosticEntryValue{ StringValue: COPY "EFFECTS REENTRANT:THUNK on '%{name}' but the function is not recursive (neither direct nor mutual). Remove ':THUNK', or change to plain 'EFFECTS REENTRANT' if recursion may appear via callees registered later." }, :summary: DiagnosticEntryValue{ StringValue: COPY ":THUNK is reserved for recursive functions; this one isn't recursive." }}, :REQUIRES_NON_REENTRANT_NOT_PARAM: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :reentrance }, :template: DiagnosticEntryValue{ StringValue: COPY "Function '%{fn}' has 'REQUIRES %{name}: NON_REENTRANT' but '%{name}' is not a parameter of '%{fn}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "REQUIRES :NON_REENTRANT must reference a parameter." }}, :LOCK_RANK_INCONSISTENT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :concurrency }, :template: DiagnosticEntryValue{ StringValue: COPY "Inconsistent lock rank for type '%{type}': previously declared as rank %{previous}, now rank %{rank}. All declarations of a ranked lock type must agree on the rank." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Lock-rank declarations for the same type disagree." }}, :LOCK_NESTED_REACQUIRE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :concurrency }, :template: DiagnosticEntryValue{ StringValue: COPY "Nested lock re-acquire: '%{name}' is already held by an enclosing WITH (outer line %{outer_line}). This is a structural self-deadlock. If you know the instances are distinct and ordered, mark the inner WITH as POSSIBLE_DEADLOCK." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Inner WITH re-acquires a lock already held by an enclosing WITH." }}, :LOCK_RANK_VIOLATION: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :concurrency }, :template: DiagnosticEntryValue{ StringValue: COPY "Lock rank violation: acquiring ':%{cap}' at rank %{cap_rank} while ':%{held}' (rank %{held_rank}) is held. Ranks must be strictly ascending along the acquire path to prove LockCycle freedom by construction. If ordering is enforced by a different discipline, mark the inner WITH with POSSIBLE_LOCK_CYCLE." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Acquired lock has lower rank than a currently-held lock." }}, :SELECTOR_NOT_POSSIBLE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :concurrency }, :template: DiagnosticEntryValue{ StringValue: COPY "You are trying to handle `%{label}` which is not a possible error at this WITH. The static lock analysis proved it cannot fire. Remove the handler, or mark an upstream lock acquire with POSSIBLE_DEADLOCK / POSSIBLE_LOCK_CYCLE if you know a runtime path can reach it." }, :summary: DiagnosticEntryValue{ StringValue: COPY "ON-clause selector cannot fire at this WITH (provably impossible)." }}, :GENERIC_DUP_TYPE_PARAM_KIND: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Duplicate type parameter '%{param}' in generic %{kind} '%{name}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Generic STRUCT/FN declares the same type parameter twice." }}, :GENERIC_TYPE_PARAM_SHADOWS: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Type parameter '%{param}' shadows built-in type '%{param}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Generic type parameter shadows a built-in type name." }}, :FN_PARAM_NO_CAPABILITY: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Capability annotations are not allowed on function parameters. Use the plain type (e.g., 'Node' not 'Node @multiowned')." }, :summary: DiagnosticEntryValue{ StringValue: COPY "FN-type parameter syntax disallows capability sigils." }, :cause: DiagnosticEntryValue{ StringValue: COPY "CLEAR functions take *types*, not capabilities. Capabilities are properties of bindings (the caller's local), unwrapped at the call site via WITH. Allowing `@multiowned` etc. on a parameter would conflate the type with the caller's wrapping \u{2014} and would force every call site to wrap the value, even when the caller has a plain T." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Drop the sigil from the parameter type (e.g. `c: Counter` not `c: Counter @multiowned`). The caller wraps as needed (`WITH c { fn(c); }` for a multiowned binding). To require a sync family on the param, use `REQUIRES c: LOCKED` (or ATOMIC, VERSIONED) \u{2014} that's the supported way to constrain capabilities." }}, :ATSPLIT_STREAM_ONLY: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "@split is currently only supported on stream types." }, :summary: DiagnosticEntryValue{ StringValue: COPY "@split capability requires a stream type." }}, :COLLECTION_NEEDS_ARRAY_TYPE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Collection capability %{cap} requires an array type (e.g. %{example})" }, :summary: DiagnosticEntryValue{ StringValue: COPY "@list / @pool / @set must be applied to an array element type." }}, :OBSERVABLE_REQUIRES_SET: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "@observable on `T[]` requires `@set` (e.g. `~T[]@set:observable` for DISTINCT). Plain `~T[]@observable` is not a supported shape; the only collection observable today is the DISTINCT terminal's `~T[]@set:observable`." }, :summary: DiagnosticEntryValue{ StringValue: COPY "@observable on a list requires @set." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Observable collections need the underlying shape to support efficient diff publication. The only currently-supported collection observable is the DISTINCT terminal, which requires `@set` shape (set membership = O(1) diff). Plain `T[]` observables aren't lowered yet \u{2014} diff over duplicates would be ambiguous." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Add `@set` so the type is `~T[]@set:observable`. If you don't need set semantics (uniqueness), drop `@observable` and use a plain tense list (`~T[]`) \u{2014} observers would need to compute their own diffs." }}, :OBSERVABLE_NOT_COMBINABLE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "@observable cannot be combined with %{labels}. %{explain} Drop the wrapper or pick a non-observable type." }, :summary: DiagnosticEntryValue{ StringValue: COPY "@observable rejects certain combined capabilities." }, :cause: DiagnosticEntryValue{ StringValue: COPY "@observable layers a publish/subscribe channel on top of a tense source \u{2014} every write fans out to subscribers. Some other capabilities are incompatible because they impose a representation that the publish layer can't observe atomically (e.g., `@boxed:atomic` already CAS-publishes a different snapshot, `@locked` blocks subscribers)." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Drop one of the conflicting wrappers (typically @observable if the consumer doesn't need diff feeds), OR pick a different sync model: `@versioned` cells get observable-like snapshots via WITH SNAPSHOT without the publish layer." }}, :OBSERVABLE_TERMINAL_MISMATCH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Observable terminal mismatch: LHS stamped %{lhs}, pipe analyzer produced %{pipe}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Observable destination terminal disagrees with the pipeline terminal analyzer." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The observable destination already carried a terminal stamp that disagreed with the pipeline analyzer. Choosing either side would hide a stale phase fact, so annotation rejects the program." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Treat this as a compiler invariant failure unless the source explicitly declared conflicting observable shapes. The pipeline analyzer should be the authority for terminal kind." }}, :SOA_NEEDS_FIXED_ARRAY: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "@soa requires a fixed-size array type (e.g. Particle[10000]@soa)" }, :summary: DiagnosticEntryValue{ StringValue: COPY "@soa requires a fixed-size array." }}, :SHARDED_NEEDS_2_PLUS: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "@sharded requires N >= 2, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "@sharded(N) requires N >= 2." }}, :POOL_NEEDS_FIXED_CAPACITY: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Pool requires a fixed capacity \u{2014} use %{element}[N]@pool instead of []@pool" }, :summary: DiagnosticEntryValue{ StringValue: COPY "@pool requires a fixed capacity." }}, :UNKNOWN_TYPE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Unknown type '%{name}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Type identifier is not registered in this scope." }}, :POLY_SHARED_INCONSISTENT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: polymorphic @shared parameters in '%{fn}' must use the same synchronization capability. Parameter '%{first}' is %{first_cap}, but parameter '%{second}' is %{second_cap}. Pick one sync family across all `@shared` params (`%{first_cap}` or `%{second_cap}`), or restrict the function to a single concrete family by adding `REQUIRES p1: <family>, p2: <family>` with the same family for both. If the params genuinely belong to different families, split the function into separate specialised versions." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Polymorphic @shared parameters disagree on synchronization capability." }, :cause: DiagnosticEntryValue{ StringValue: COPY "When a function takes multiple `@shared` parameters and dispatches polymorphically (via REQUIRES with multiple sync families), every shared param must agree on its sync family. Allowing them to diverge would force per-pair monomorphisation across families \u{2014} the cross-product blows up combinatorially." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Pick one sync family across all `@shared` params (`%{first_cap}` or `%{second_cap}`), or restrict the function to a single concrete family by adding `REQUIRES p1: <family>, p2: <family>` with the same family for both. If the params genuinely belong to different families, split the function into separate specialised versions." }}, :RC_PROMISE_NEEDS_SHARED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "~T@multiOwned is not valid. Promises span fiber boundaries, so the ref-count must be atomic. Use ~T@shared instead." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Promise types require @shared (atomic refcount), not @multiOwned." }}, :ATSPLIT_NEEDS_OPEN_STREAM: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "@split is currently only valid on open streams ([~]@split T)." }, :summary: DiagnosticEntryValue{ StringValue: COPY "@split applies only to open streams." }}, :SOA_TO_EXTERN_FN: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "@soa collections cannot be passed to EXTERN FN \u{2014} SOA memory layout is incompatible with C ABI. Materialize to a regular array first." }, :summary: DiagnosticEntryValue{ StringValue: COPY "@soa collections have a structure-of-arrays layout that's incompatible with C ABI." }}, :C_EXTERN_UNSUPPORTED_TYPE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Unsupported ABI C %{position} type %{type}: %{reason}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "The declaration uses a CLEAR representation that has no sound C ABI lowering." }}, :NOT_A_FUNCTION: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot call '%{name}' - not a function" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Identifier is bound but is not a callable function." }}, :TAKES_NEEDS_OWNED_INDEX: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot pass container index access to TAKES parameter. Index access returns a borrow. Use .remove(i) to take ownership, or COPY to deep-copy." }, :summary: DiagnosticEntryValue{ StringValue: COPY "TAKES parameter needs ownership; container[i] is a borrow." }}, :TAKES_NEEDS_OWNED_BORROW: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot pass borrowed access to TAKES parameter. Use COPY for an explicit deep-copy or move an owned binding." }, :summary: DiagnosticEntryValue{ StringValue: COPY "TAKES parameter needs ownership; borrowed access paths are borrows." }}, :LINK_NEEDS_RESOLVE_FOR_CALL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot pass @link variable '%{name}' to parameter '%{param}' \u{2014} RESOLVE it first to get an optional strong reference." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Cannot pass a weak @link reference where a concrete value is expected." }}, :REENTRANT_FN_TO_NON_REENTRANT_PARAM: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :reentrance }, :template: DiagnosticEntryValue{ StringValue: COPY "Reentrancy Error: '%{name}' is plain EFFECTS REENTRANT but parameter '%{param}' does not accept plain reentrant callbacks. Add EFFECTS REENTRANT to the callee that owns '%{param}', or constrain the parameter explicitly with REQUIRES %{param}: NON_REENTRANT and pass a bounded/non-reentrant callback." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Plain EFFECTS REENTRANT function passed to a parameter that doesn't permit plain reentrant callees." }}, :ARG_NEEDS_ATOMIC_CELL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Argument %{index} to '%{fn}' expects an @atomic %{expected} cell, but '%{name}' is %{actual}. Pass an @atomic binding, or change the parameter to bare %{expected} to load a value." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Argument must be an @atomic cell binding (not a loaded value)." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The parameter is typed as `@atomic %{expected}` \u{2014} a *cell* the function will perform atomic ops on (load, fetchAdd, ...). Passing a loaded value (a plain `%{expected}`) would force the function to operate on a stack copy, defeating the atomic semantics." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Pass the `@atomic` binding by name (e.g. `fn(c)` where `c: %{expected} @shared:atomic`), OR change the function's param to bare `%{expected}` if the loaded snapshot is enough (use `c.load()` at the call site)." }}, :ARG_NEEDS_SHARED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Argument %{index} to '%{fn}' expects %{expected} @shared, got %{actual}.%{hint}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Argument must be a @shared handle to be retained across boundaries." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The function will retain the value past the call (typically because it spawns a fiber, stores into a shared container, or returns a borrow that outlives the param). Plain `%{actual}` is affine \u{2014} handing it to such a function would lose the original; only `@shared` (Arc) handles can be cloned cheaply at the boundary." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Promote the binding to `@shared` at its declaration (`x = ... @shared`), then pass it directly. If you can't change the source, COPY before passing (`fn(COPY x)`), accepting the deep-copy cost. Alternatively, if the function doesn't actually need to retain the value, change its signature to take bare `%{expected}`." }}, :ARG_ALIAS_CONFLICT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "Aliasing Error: Argument %{index} ('%{name}') conflicts with argument %{other_index}. Cannot pass the same variable defined at '%{path}' twice if one usage is MUTABLE. This violates exclusive mutability." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Two arguments share the same variable, and at least one is mutable." }}, :MUTABLE_ARG_RESTRICTED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :lifetime }, :template: DiagnosticEntryValue{ StringValue: COPY "Lifetime Error: Cannot pass '%{name}' as mutable argument because it is currently RESTRICTed." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Argument is RESTRICTed; cannot be passed as mutable." }}, :MUTABLE_PARAM_NEEDS_RESTRICT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :lifetime }, :template: DiagnosticEntryValue{ StringValue: COPY "Lifetime Error: param `%{name}` is mutable, must be RESTRICTed before it can be borrowed." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Mutable parameter must be RESTRICTed before being aliased." }}, :LIFETIME_RETURNS_REQUIRES_FAMILY_CONFLICT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :lifetime }, :template: DiagnosticEntryValue{ StringValue: COPY "Lifetime Error: function '%{fn}' declares `RETURNS %{name}:T` AND `REQUIRES %{name}: ATOMIC | %{others}`. The returned value's lifetime model differs by family: ATOMIC is a bare pointer to a scope-bounded cell, while %{others_label} is reference-counted via Arc. The compiler can't pick one lifetime story at the declaration site. Either split into two functions (one per family) or drop the ATOMIC family from REQUIRES." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Function declares RETURNS for a name whose REQUIRES mixes ATOMIC with another family." }}, :LIFETIME_ROOT_NOT_PARAM: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :lifetime }, :template: DiagnosticEntryValue{ StringValue: COPY "Lifetime Error: Scoped lifetime '%{name}' is not a parameter." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Lifetime annotation references a name that is not a parameter." }}, :LIFETIME_NOT_A_STRUCT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :lifetime }, :template: DiagnosticEntryValue{ StringValue: COPY "Lifetime Error: Type '%{type}' is not a struct, cannot access field '%{field}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Lifetime path drills into a field on a non-struct type." }}, :LIFETIME_NO_FIELD: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :lifetime }, :template: DiagnosticEntryValue{ StringValue: COPY "Lifetime Error: Type '%{type}' has no field '%{field}'." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Lifetime path references a field that doesn't exist on the struct." }}, :DEFAULT_NEEDS_STRUCT_PARAM: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: DEFAULT can only be used for struct-type parameters, not '%{type}'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "DEFAULT is only valid for struct-typed parameters." }}, :DEFAULT_STRUCT_MISSING_DEFAULTS: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: DEFAULT for '%{name}' requires '%{type}' to have defaults for all fields; missing: %{missing}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "DEFAULT requires every field of the struct to have a default." }}, :DEFAULT_VALUE_TYPE_MISMATCH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Type Error: Default value for '%{name}' expects %{expected}, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Default value's type doesn't match the parameter's declared type." }}, :CAPTURE_NO_DEFAULT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "Captures cannot have default values: '%{name}'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Lambda captures don't accept default values." }}, :CAPTURE_UNDEFINED_VAR: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot capture undefined variable '%{name}'" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Lambda capture references an undefined variable." }}, :CAPTURE_IMMUTABLE_AS_MUTABLE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :ownership }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot capture immutable variable '%{name}' as MUTABLE" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Lambda cannot capture an immutable binding as MUTABLE." }}, :AMBIGUOUS_RETURN: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Ambiguous Return: Function returns multiple types %{types}, specify :Any as type" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Function has multiple return types of differing kinds without an :Any annotation." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The function body has RETURN statements that yield different types (e.g. one returns Int64, another returns String). Without an explicit RETURNS annotation that admits the union \u{2014} typically `:Any` \u{2014} the inferred return type is ambiguous and callers can't be type-checked safely." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Either pick one return type and convert the others (`String.fromInt(x)` to lift Ints, etc.), declare `RETURNS :Any` to accept the polymorphic return (the auto-fix wires this in directly), or refactor to a UNION and have each branch return the appropriate variant." }}, :RETURN_BORROWED_NO_COPY_OR_LIFETIME: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :lifetime }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot return borrowed value without COPY or a lifetime annotation. Type '%{type}' is not implicitly copyable." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Returning a borrow without COPY or a `RETURNS x:T` lifetime annotation." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A RETURN statement returns a borrowed value (e.g. a field of a parameter) without either copying it or declaring a lifetime annotation on the function. CLEAR can't statically prove the return outlives the source." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Either COPY the value before returning, declare `RETURNS x:T` on the function so the lifetime propagates to the caller, or restructure to return an owned value." }}, :RETURN_LIFETIME_MISMATCH: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :lifetime }, :template: DiagnosticEntryValue{ StringValue: COPY "Lifetime Error: Expected return %{sources_msg}; actual return derived from: %{actual}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Returned value's lifetime path doesn't match any declared `RETURNS x:T` source." }}, :RETURN_LIFETIME_NOT_ASSOCIATED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :lifetime }, :template: DiagnosticEntryValue{ StringValue: COPY "Lifetime Error: Lifetime '%{sources}' specified on return, but returned value is not associated." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Function declares a lifetime source on its return, but the returned value's path can't be traced to that source." }}, :WITH_CAP_BINDING_LOST: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "Cannot add capability '%{capability}' to '%{name}': binding not found in its declaring scope." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Capability target binding is missing from the scope it was declared in." }}, :WITH_EXCLUSIVE_NEEDS_LOCK_GOT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :concurrency }, :template: DiagnosticEntryValue{ StringValue: COPY "EXCLUSIVE capability requires a @locked or @writeLocked variable, got %{got}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "EXCLUSIVE WITH-block needs a @locked or @writeLocked binding." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A WITH EXCLUSIVE block requires the binding to have a lock-axis sync capability (`@locked`, `@writeLocked`). Without one, there's nothing to acquire \u{2014} the EXCLUSIVE keyword has no meaning." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Either add `@locked` / `@writeLocked` to the binding's type, or remove the EXCLUSIVE keyword. If the binding is meant to be lock-free, the WITH block isn't needed." }}, :WITH_READ_NEEDS_WRITE_LOCK_NAME: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :concurrency }, :template: DiagnosticEntryValue{ StringValue: COPY "WITH %{name}: read access requires a @writeLocked variable" }, :summary: DiagnosticEntryValue{ StringValue: COPY "WITH (read) requires a @writeLocked binding for the read-side polymorphism to apply." }}, :SYNC_POLICY_DUPLICATE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :concurrency }, :template: DiagnosticEntryValue{ StringValue: COPY "Only one SYNC POLICY block is allowed per program. The first one was declared earlier in this file." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Multiple SYNC POLICY blocks declared." }}, :SYNC_POLICY_NEEDS_MAIN_FILE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :concurrency }, :template: DiagnosticEntryValue{ StringValue: COPY "SYNC POLICY may only be declared in the file containing `FN main`. Move the policy to the program's main file, or remove it here." }, :summary: DiagnosticEntryValue{ StringValue: COPY "SYNC POLICY must live next to FN main." }}, :SYNC_POLICY_INLINE_ONLY: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :concurrency }, :template: DiagnosticEntryValue{ StringValue: COPY "`%{name}` must be handled in-line \u{2014} SYNC POLICY defaults are not allowed for this error. Remove it from the policy and add an `ON %{name} ...` handler at the WITH site (use `WITH POLYMORPHIC POSSIBLE_%{escape} ...` if the static cycle check needs to be opted out)." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Some errors must be handled in-line at the WITH site, not via SYNC POLICY." }}, :SYNC_POLICY_INVALID_ERROR: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :concurrency }, :template: DiagnosticEntryValue{ StringValue: COPY "`%{name}` is not a valid SYNC POLICY error. SYNC POLICY only handles: %{required}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Selector names an error type that SYNC POLICY does not cover." }}, :SYNC_POLICY_NEEDS_TYPE_NOT_KIND: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :concurrency }, :template: DiagnosticEntryValue{ StringValue: COPY "SYNC POLICY handlers must name a specific error type, not a kind. `ON %{name} ...` (and the `RETRY(N) THEN` sugar that desugars to `ON Transient ...`) is rejected here. Use `ON LockTimeout ...`, `ON MvccConflict ...`, or `ON AtomicConflict ...` explicitly." }, :summary: DiagnosticEntryValue{ StringValue: COPY "SYNC POLICY selectors must be types, not kinds." }}, :SYNC_POLICY_INCOMPLETE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :concurrency }, :template: DiagnosticEntryValue{ StringValue: COPY "SYNC POLICY must handle every required error (%{required}). Missing: %{missing}." }, :summary: DiagnosticEntryValue{ StringValue: COPY "SYNC POLICY must cover every required error type." }}, :CATCH_WITH_UNREGISTERED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "CATCH ... WITH(%{name}): error type '%{name}' is not registered." }, :summary: DiagnosticEntryValue{ StringValue: COPY "CATCH ... WITH refers to an unregistered error type." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Error types in CLEAR are registered the first time they appear in a `RAISE Kind, Name, ...` site. CATCH WITH(Name) selects against that registry \u{2014} when the name has never been seen as a registered type, the selector has nothing to match." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Either register the type at its first RAISE site (`RAISE Transient, %{name}, \"msg\"`), import the module that defines it, or check the spelling against an already-registered name in the same scope." }}, :MATCH_NEEDS_ENUM_OR_UNION: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "MATCH requires an enum or union type, got '%{type}'. Use `PARTIAL MATCH` to match on non-discriminated types (WHEN guards, ranges, etc. require PARTIAL)." }, :summary: DiagnosticEntryValue{ StringValue: COPY "MATCH requires a discriminated subject (enum or union)." }}, :MATCH_FORBIDS_DEFAULT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "MATCH cannot have a DEFAULT branch \u{2014} every variant must be handled explicitly. If you want a catch-all, change to `PARTIAL MATCH` (which permits DEFAULT and WHEN guards)." }, :summary: DiagnosticEntryValue{ StringValue: COPY "MATCH must be exhaustive \u{2014} DEFAULT requires PARTIAL MATCH." }}, :MATCH_FORBIDS_WHEN: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "MATCH cannot contain WHEN guards \u{2014} every variant must be handled by an exact case. Use `PARTIAL MATCH` if you need WHEN guards." }, :summary: DiagnosticEntryValue{ StringValue: COPY "MATCH must be exhaustive \u{2014} WHEN guards require PARTIAL MATCH." }}, :MATCH_NON_EXHAUSTIVE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "MATCH on %{kind} '%{name}' is non-exhaustive: missing variants: %{missing}. Either add cases for the missing variants, or change to `PARTIAL MATCH` to allow non-exhaustive matching." }, :summary: DiagnosticEntryValue{ StringValue: COPY "MATCH does not cover every variant." }}, :ERROR_TYPE_NOT_REGISTERED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "Error type '%{name}' is not registered. The first RAISE / OR_ELSE EXIT site that names a new type must provide a kind: use 'RAISE Kind, %{name}, \"msg\"' or similar." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Error type was never registered with a kind." }, :cause: DiagnosticEntryValue{ StringValue: COPY "CLEAR's error registry binds a type name to a *kind* (Transient, Permanent, Internal, Reserved). The kind drives recovery semantics \u{2014} RETRY targets Transient, OR_ELSE EXIT exits on Permanent, etc. The first site that names a new type must declare the kind so the registry has it for every later use." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "At the first RAISE site for `%{name}`, include the kind: `RAISE Transient, %{name}, \"description\"` (or Permanent / Internal). Subsequent RAISE / CATCH sites can omit the kind \u{2014} the registered binding is reused." }}, :ERROR_TYPE_RESERVED_BY_STDLIB: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "'%{name}' is reserved by the stdlib as kind '%{kind}'. Pick a different type name." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Error type name conflicts with a stdlib-reserved one." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The CLEAR stdlib pre-registers a fixed set of error type names (e.g. `IO`, `Allocator`, `Overflow`) bound to specific kinds. User-declared types can't shadow these because cross-module CATCH selectors would become ambiguous." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Rename the user-declared type (`MyIO`, `AppIO`, etc.) so it doesn't collide with the stdlib-reserved name. The stdlib type stays available under its canonical name." }}, :ERROR_TYPE_KIND_CONFLICT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "'%{name}' is already mapped to kind '%{kind}'%{first_loc}. Either use the same kind here, or pick a different type name." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Same error type name registered with a different kind." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Each error type name binds to exactly one kind. Allowing the same name to mean two different kinds would break recovery dispatch (CATCH WITH(`%{name}`) would have to know which kind the call site actually raised)." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "At this RAISE site, use the previously-registered kind (`%{kind}`), OR pick a fresh name for the variant that legitimately needs a different kind." }}, :CALL_SITE_OVERRIDE_UNIMPLEMENTED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "%{sigil}(%{n}) is parsed but not yet implemented. Per-call-site monomorphization (cloning the callee + rewriting recursive calls inside the clone so the depth counter / trampoline applies to internal recursion) lands in v0.3 alongside the broader monomorphization pass. For now, declare the variant on the function instead: %{variant_hint} (call-site overrides will be a strictly additive feature when 4.1/4.2 land)." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Per-call-site reentrance override is reserved but not yet implemented." }}, :INDIRECT_ATOMIC_PRIMITIVE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "@boxed:atomic is for STRUCTS. For primitive type %{type}, use `@shared:atomic` (the v0.2 primitive-as-cell form). The atomic primitive already fits in a single CAS-able machine word; @boxed would add a pointless heap indirection." }, :summary: DiagnosticEntryValue{ StringValue: COPY "@boxed:atomic is for structs; primitives use @shared:atomic." }, :cause: DiagnosticEntryValue{ StringValue: COPY "`@boxed:atomic` publishes whole-T snapshots via atomic pointer swap \u{2014} every update CAS-publishes a fresh heap allocation. That's necessary for structs (which don't fit in a CAS word) but wasteful for primitives like `%{type}` that already fit in a single machine word and can be CAS'd directly." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Use `@shared:atomic` for primitive cells: `MUTABLE c: %{type} = 0 @shared:atomic;` \u{2014} direct atomic ops (`c.load()`, `c += 1`) without heap indirection. Reserve `@boxed:atomic` for structs." }}, :STRUCT_ATOMIC_NEEDS_INDIRECT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "@atomic on a STRUCT requires @boxed (publishes whole-T snapshots via atomic pointer swap). Use `%{type}{...} @boxed:atomic` instead. (For primitive cells like `Int64@shared:atomic`, atomic alone is correct -- those fit in a single CAS-able machine word.)" }, :summary: DiagnosticEntryValue{ StringValue: COPY "@atomic on a struct requires @boxed." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Struct atomic semantics need to publish the whole T as a single atomic operation. Hardware CAS only works on machine-word-sized values \u{2014} for any struct larger than that, you need pointer-level CAS, which means heap-allocating the struct and publishing the pointer. That's exactly what `@boxed:atomic` does." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Add `@boxed` to the sigil chain: `%{type}{...} @boxed:atomic` (or full form `%{type}{...} @shared:boxed:atomic`). Reads land in `WITH SNAPSHOT`; writes via `WITH SNAPSHOT MUTABLE`." }}, :LOCAL_INDIRECT_ATOMIC: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "@local:boxed:atomic is disallowed -- atomic without cross-thread visibility is pointless. Drop @local; @boxed:atomic implies cross-thread sharing." }, :summary: DiagnosticEntryValue{ StringValue: COPY "@local with @boxed:atomic is contradictory." }, :cause: DiagnosticEntryValue{ StringValue: COPY "`@local` declares the binding lives entirely on the current thread/scheduler \u{2014} no cross-thread visibility. But `@boxed:atomic` exists *specifically* to publish updates across threads. The two contradict: an atomic with no readers is paying for synchronisation hardware nobody can observe." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Drop `@local` \u{2014} `@boxed:atomic` already implies the cross-thread sharing semantics you need. If the value is genuinely thread-local, use plain affine ownership (no atomic, no @local needed)." }}, :MULTIOWNED_INDIRECT_ATOMIC: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "@multiowned:boxed:atomic is disallowed -- Rc isn't thread-safe (non-atomic refcount), so it can't back a cross-thread atomic-ptr cell. Drop @multiowned; @boxed:atomic uses Arc internally for the published-value lifetime." }, :summary: DiagnosticEntryValue{ StringValue: COPY "@multiowned with @boxed:atomic is unsound (Rc isn't atomic)." }, :cause: DiagnosticEntryValue{ StringValue: COPY "`@multiowned` is Rc \u{2014} single-scheduler, non-atomic refcount. `@boxed:atomic` publishes pointers across threads, and the published values' refcounts must be atomic-safe so receivers can release them safely. Rc would race on the refcount; the combination is genuinely unsound." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Drop `@multiowned` \u{2014} `@boxed:atomic` uses Arc internally for the published-value lifetime, so you get atomic-safe sharing for free. If you wanted explicit shared ownership for non-atomic uses, use `@shared` (Arc) instead of `@multiowned` (Rc)." }}, :WITH_MATCH_VERSIONED_AS_MUTABLE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :concurrency }, :template: DiagnosticEntryValue{ StringValue: COPY "WITH MATCH with `AS MUTABLE` and a VERSIONED arm is not supported: writes through a Versioned read-snapshot don't commit (silent data loss in the VERSIONED arm; only the LOCKED arm would mutate the live cell). For transactional mutation on a versioned cell use:\n    WITH SNAPSHOT %{name} AS MUTABLE va { ... } ON MvccConflict <action>\nand keep WITH MATCH for read-side polymorphism." }, :summary: DiagnosticEntryValue{ StringValue: COPY "WITH MATCH AS MUTABLE on a versioned cell silently drops writes." }}, :WITH_MATCH_MULTI_CELL: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :concurrency }, :template: DiagnosticEntryValue{ StringValue: COPY "WITH MATCH with multiple cells (%{names}) is not yet supported: lower_with_match_block emits the per-arm prelude for the first capability only. Split into separate WITH MATCH blocks (one per cell) until multi-cell dispatch lands." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Multi-cell WITH MATCH is not yet supported." }}, :WITH_RETRYABLE_FALLIBLE_BODY: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :concurrency }, :template: DiagnosticEntryValue{ StringValue: COPY "%{with_name} body must be non-fallible for atomicity, but it contains fallible work (%{detail}). Retryable synchronization bodies may run more than once and cannot safely propagate user failures from inside the update callback. Move fallible work outside the WITH body, store the result in a local, then commit only non-fallible mutations inside the WITH." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Retryable WITH body must not contain fallible work." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A retryable WITH (SNAPSHOT MUTABLE / POLYMORPHIC) body must be non-fallible \u{2014} it may run multiple times during retry. User-level `?` / `!` propagation from inside the body would lose track of which retry the failure belongs to." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Move fallible work outside the WITH (read state via WITH SNAPSHOT, do fallible work, then commit the result inside the WITH). The body should only contain the actual mutation." }}, :WITH_SNAPSHOT_BODY_NOT_PURE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :concurrency }, :template: DiagnosticEntryValue{ StringValue: COPY "WITH SNAPSHOT ... AS MUTABLE body must be pure for atomicity, but the body has %{kinds} effect(s). Yielding the fiber breaks the EBR pin and atomicity guarantees; IO can't be rolled back if the transaction aborts. Move the impure work outside the transaction (read state via WITH SNAPSHOT, do IO, then commit)." }, :summary: DiagnosticEntryValue{ StringValue: COPY "WITH SNAPSHOT AS MUTABLE body must be pure (no yields, no IO)." }}, :WITH_SNAPSHOT_NEEDS_HANDLER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :concurrency }, :template: DiagnosticEntryValue{ StringValue: COPY "WITH SNAPSHOT ... AS MUTABLE has no `ON %{error} ...` handler and the SYNC POLICY does not provide one. Either add `ON %{error} ...` at this WITH, or extend the program SYNC POLICY (a complete policy is mandatory)." }, :summary: DiagnosticEntryValue{ StringValue: COPY "WITH SNAPSHOT AS MUTABLE needs a conflict handler in-line or via SYNC POLICY." }}, :WITH_ATOMIC_HANDLER_WRONG_ERROR: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :concurrency }, :template: DiagnosticEntryValue{ StringValue: COPY "`ON MvccConflict` isn't valid on `@boxed:atomic`. AtomicPtr.update raises `AtomicConflict` (after 256 CAS losses), not `MvccConflict`. Use `ON AtomicConflict ...` instead, or drop the handler to fall back to the SYNC POLICY." }, :summary: DiagnosticEntryValue{ StringValue: COPY "@boxed:atomic raises AtomicConflict; ON MvccConflict is a category mismatch." }}, :INDIRECT_ATOMIC_FIELD_WRITE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :concurrency }, :template: DiagnosticEntryValue{ StringValue: COPY "`@boxed:atomic` requires `WITH SNAPSHOT %{name} AS MUTABLE x { x.%{field} = ...; }` for mutation. Atomic pointer swap publishes a new whole-T snapshot, not a per-field write -- the `WITH SNAPSHOT` block clones the snapshot, mutates the clone, and CAS-publishes it. (This is different from primitive `@shared:atomic` Int64/Float64/Bool, which use direct ops like `c += 1` because they fit in a single CAS-able machine word.)" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Per-field writes through @boxed:atomic must go via WITH SNAPSHOT AS MUTABLE." }}, :WITH_MULTI_OBJECT_ATOMIC: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :concurrency }, :template: DiagnosticEntryValue{ StringValue: COPY "Multi-object WITH cannot admit ATOMIC: `%{name}` is (or could be) `@atomic` / `@boxed:atomic`, which gives no atomicity across cells. Either narrow the binding's REQUIRES to a non-ATOMIC family (e.g. `LOCKED | VERSIONED`, or just `VERSIONED` for cross-cell MVCC transactions), or refactor to single-cell WITH blocks. Per design contract docs/agents/atomicptr.md \u{A7}4 + docs/agents/true-synchronization-polymorphism.md." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Multi-binding WITH cannot include ATOMIC cells (no portable multi-pointer atomic)." }}, :WITH_SNAPSHOT_MATCH_VERSIONED_NEEDS_HANDLER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :concurrency }, :template: DiagnosticEntryValue{ StringValue: COPY "WITH SNAPSHOT ... AS MUTABLE MATCH: VERSIONED arm has no `ON MvccConflict` handler and the SYNC POLICY does not provide one. Either add `WHEN VERSIONED -> { ... } ON MvccConflict ...`, or extend the program SYNC POLICY." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Per-arm VERSIONED needs an MvccConflict handler." }}, :WITH_SNAPSHOT_MATCH_ATOMIC_FORBIDS_HANDLER: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :concurrency }, :template: DiagnosticEntryValue{ StringValue: COPY "WITH SNAPSHOT ... AS MUTABLE MATCH: ATOMIC arm forbids conflict handlers (AtomicPtr.update retries until success -- Rust `rcu` semantics; there's no conflict path to handle). Drop the trailing handler clause from the ATOMIC arm." }, :summary: DiagnosticEntryValue{ StringValue: COPY "ATOMIC arm of WITH MATCH cannot carry a conflict handler." }}, :RETRY_ONLY_TRANSIENT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "RETRY only targets Transient errors. Non-retryable types in selector: %{types}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "RETRY clause must select Transient error types only." }, :cause: DiagnosticEntryValue{ StringValue: COPY "RETRY presumes the operation can succeed on a later attempt \u{2014} only Transient-kind errors carry that promise. Permanent errors (a missing file, a parse error) won't change between attempts; Internal errors signal a bug rather than something to retry. The compiler rejects RETRY clauses that select non-Transient kinds so retry storms can't accidentally hide real bugs." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Drop the non-Transient selector(s) from the RETRY clause, OR change the recovery action: `OR_ELSE RAISE` to propagate, `OR_ELSE EXIT` to exit the program, `CATCH e WITH(...) { ... }` to handle each kind explicitly." }}, :PARTIAL_MATCH_EXPR_NEEDS_DEFAULT: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "PARTIAL MATCH used in expression position requires a DEFAULT branch. Either add a DEFAULT case, or change to `MATCH` (which forces every variant to have an exact case)." }, :summary: DiagnosticEntryValue{ StringValue: COPY "PARTIAL MATCH expression must have a DEFAULT branch." }, :cause: DiagnosticEntryValue{ StringValue: COPY "PARTIAL MATCH relaxes exhaustiveness \u{2014} not every variant must have a case. In statement position that's fine (unmatched values fall through), but in expression position the binding needs a value on every path. Without a DEFAULT, an unmatched subject would leave the binding uninitialised." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Add `DEFAULT -> <value>` to cover the unmatched paths. If exhaustiveness is actually achievable, switch to plain `MATCH` (the compiler then verifies every variant has an arm at compile time and no DEFAULT is needed)." }}, :CAN_SMASH_NOT_SUPPORTED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :reentrance }, :template: DiagnosticEntryValue{ StringValue: COPY "`@canSmash` on BG/DO blocks is recognized but not yet supported by the compiler. The runtime has stack-hysteresis (page-guarded soft overflow detection) to protect fiber stacks, but the compiler does not yet wire that feature on. Use `@service` instead (spawns on a dedicated OS thread with a 4 MB pre-allocated stack); `@canSmash` is expected to be supported in v0.3." }, :summary: DiagnosticEntryValue{ StringValue: COPY "@canSmash is parsed but not yet implemented." }}, :CAPABILITY_VIOLATION_FIXABLE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "%{detail}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Capability mismatch with an interactive auto-fix available." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The capability declared on a binding (locked / write_locked / shared / multiowned / observable / ...) doesn't satisfy the operation being performed. The Capabilities validator computes a precise reason (wrong tense, missing wrapper, incompatible combination) and the message field carries the specific text." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Read the message \u{2014} it describes the exact mismatch and usually points at the right capability. `clear fix` typically offers an interactive auto-fix when the change is mechanical (add a missing wrapper, swap a tense)." }}, :PURITY_VIOLATION: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "%{detail}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "A pure function calls into impure code (effects / surface)." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A function declared as pure (PURE keyword or implied via REQUIRES) called into code that has effects (yield / alloc_heap / io / fail). The effect lattice is inferred per-function and propagated through the call graph; a pure caller cannot escape its purity." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Either remove the PURE declaration on the caller, or remove the impure call. If the impure work is needed, isolate it in a non-pure helper and only call into pure code from inside the pure body." }}, :VARDECL_TYPE_MISMATCH_FIXABLE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "%{detail}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Variable declaration's value type doesn't match the declared type, with an interactive fix." }, :cause: DiagnosticEntryValue{ StringValue: COPY "The value bound to the variable doesn't fit the declared type. Coercion was tried (slice widening, primitive autocast) and failed. An interactive fix is available when the language can suggest a literal CAST or the type annotation can be inferred from the value." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Either change the declared type to match the value, change the value to the declared type, or use `CAST x AS Type` for an explicit conversion." }}, :OBSERVABLE_BINDING_NEEDS_FOLD_PIPE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "`~T@observable` bindings must be initialized by a pipeline-terminal fold over a tense stream (e.g. `running: ~Int64@observable = stream |> SUM _`). The producer fiber, atomic accumulator, and WaitGroup wiring all live in the fold's codegen path -- a bare declaration or a non-fold initializer has no producer, so NEXT/COLLECT would deadlock and cleanup would touch an uninitialized wrapper." }, :summary: DiagnosticEntryValue{ StringValue: COPY "`~T@observable` bindings need a fold-pipe initializer." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Observable bindings are implemented by the fold-pipe codegen path. That path allocates the producer fiber, accumulator, and WaitGroup bridge. A bare observable declaration or arbitrary initializer would create a wrapper with no producer." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Initialize the binding from a pipeline-terminal fold over a tense stream, or drop `@observable` if this binding should behave like a regular tense value." }}, :ATOMIC_ESCAPE_ASSIGN: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :escape }, :template: DiagnosticEntryValue{ StringValue: COPY "%{detail}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Assigning a value whose lifetime is tied to a sync-axis source escapes the source's scope." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A value whose lifetime is tied to a sync-axis source (e.g. `@shared:atomic` cell) was assigned into a binding that outlives the source's scope. The atomic cell is bounded by its declaring scope; the assignment would dangle." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Migrate the source to `@shared:locked` (a longer lifetime model) \u{2014} `clear fix` offers this as an interactive transformation. Or restructure so the assignment doesn't escape the source scope." }}, :ATOMIC_ESCAPE_RETURN: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :escape }, :template: DiagnosticEntryValue{ StringValue: COPY "%{detail}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Returning a value whose lifetime is tied to a sync-axis source escapes the source's scope." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A value whose lifetime is tied to a sync-axis source was returned from a function that doesn't declare `RETURNS source:T`. The source is bounded by its declaring scope; returning the value would dangle." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Either declare `RETURNS x:T` on the function (propagates the lifetime to the caller), COPY the value before returning, or migrate the source to `@shared:locked`." }}, :STACK_NEEDS_SERVICE_FIXABLE: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :reentrance }, :template: DiagnosticEntryValue{ StringValue: COPY "Stack safety: this fiber transitively calls '%{reentrant_fn}' which is `EFFECTS REENTRANT` (plain) -- the call chain is unbounded and MUST run on an OS thread. Declare `@service` explicitly on the spawn site (the compiler no longer auto-infers this). Alternatively, change '%{reentrant_fn}' to a bounded reentrance variant: `:THUNK` (heap CPS, depth=1 fiber stack), `:TAIL_CALL` (TCO loop, depth=1), `:NOT_LOGICAL` (asserts non-recursion), or `:MAX_DEPTH(N)` (bounded counter)." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Spawn site transitively calls a plain :reentrant function and must run on @service (OS thread)." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A BG/DO spawn site transitively calls a function declared as plain `EFFECTS REENTRANT` (unbounded recursion). Plain reentrant chains can't fit on a fiber stack \u{2014} they require an OS thread (`@service`)." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Either declare `@service` on the spawn site (`clear fix` replaces the existing tier sigil), or change the callee to a bounded reentrance variant (`:THUNK`, `:TAIL_CALL`, `:NOT_LOGICAL`, `:MAX_DEPTH(N)`)." }}, :REENTRANT_MUTUAL_THUNK_UNSUPPORTED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :reentrance }, :template: DiagnosticEntryValue{ StringValue: COPY "EFFECTS REENTRANT:THUNK on '%{name}' is mutually recursive (cycle through other functions: %{cycle}) and the cycle's body shape isn't supported by the current tagged-union codegen (only IF base cases + a RETURN partner(args) tail call). Pick one: declare 'EFFECTS REENTRANT' on every cycle member (callers run on @service / OS thread); declare 'EFFECTS REENTRANT:NOT_LOGICAL' on every cycle member (return type changes from `T` to `!T`; runtime StackGuard raises System UnexpectedRecursion on actual re-entry); or declare 'EFFECTS REENTRANT:MAX_DEPTH(N)' on every cycle member (also `T` -> `!T`; runtime depth counter raises System MaxDepthExceeded above N -- pick N tight, this is NOT a workaround for being forced onto OS threads. If depth is unknown or unbounded, prefer ':THUNK' (heap CPS) or plain 'EFFECTS REENTRANT' + OS threads)." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Mutual-recursion cycle of :THUNK functions whose body shape isn't supported by the tagged-union codegen." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Mutual recursion through `:THUNK` functions requires a tagged-union trampoline whose codegen only handles a specific body shape: IF base cases plus a `RETURN partner(args)` tail call. The cycle's body shape isn't supported." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Three options: (a) declare plain `EFFECTS REENTRANT` on every cycle member (callers run on `@service` / OS thread), (b) declare `:NOT_LOGICAL` (asserts no actual recursion at runtime), (c) declare `:MAX_DEPTH(N)` (bounded counter). `clear fix` offers each as an interactive auto-fix." }}, :INTRINSIC_REJECTED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "%{detail}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Stdlib intrinsic rejected this call (the matched signature's reject_when fired)." }, :cause: DiagnosticEntryValue{ StringValue: COPY "A stdlib intrinsic (`.negative?`, `.zero?`, ...) rejected this call because the argument type isn't allowed. The stdlib uses `reject_when` patterns to rule out call shapes that look valid but produce wrong results \u{2014} e.g. `.negative?` on an unsigned int." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Check the message for the specific reject reason. Often the fix is to remove the call entirely (the answer is statically known) or use a different intrinsic." }}, :TYPE_COERCION_FAILED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "%{detail}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Type coercion produced an error (Type#coerce! returned a diagnostic)." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Type#coerce! tried to widen a value into the target type and failed. Common cases: array-overflow (initializer larger than `T[N]`), unrelated types (assigning Float64 to String), or capability mismatch." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "The error text describes the specific failure. Either change the source value, change the target type, or use `CAST x AS Type` for an explicit conversion." }}, :LOCK_CYCLE_DETECTED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :concurrency }, :template: DiagnosticEntryValue{ StringValue: COPY "Potential %{kind} over [%{types}]. Sites contributing to the cycle:\n%{sites}\nFix: acquire in a consistent order everywhere, or mark individual sites POSSIBLE_DEADLOCK / POSSIBLE_LOCK_CYCLE if the ordering is programmer-enforced." }, :summary: DiagnosticEntryValue{ StringValue: COPY "Static lock-acquire graph contains a cycle (potential deadlock)." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Static analysis of the lock-acquire graph found a cycle (or self-loop). Two locks A and B are acquired in inconsistent orders across different sites \u{2014} at runtime this can deadlock if two threads hit them simultaneously." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Fix the order \u{2014} pick a consistent total order (rank locks by type, name, or memory address) and acquire ascending everywhere. Or, when the order is enforced by a different discipline (sharded data, CAS-loop), mark individual sites POSSIBLE_DEADLOCK / POSSIBLE_LOCK_CYCLE." }}, :REGISTRY_MISMATCH_REJECTED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :registry }, :template: DiagnosticEntryValue{ StringValue: COPY "%{detail}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Identifier doesn't match any registered candidate, no typo-suggestion fix available." }, :cause: DiagnosticEntryValue{ StringValue: COPY "An identifier was checked against a closed registry (error kinds, error types, sync families) and didn't match any candidate. The Levenshtein distance to every candidate exceeded the typo-suggestion threshold, so no auto-fix is offered." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Check the spelling and the message for the list of valid candidates. The registry is closed \u{2014} only the listed identifiers are accepted." }}, :TYPO_SUGGESTION_REJECTED: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :registry }, :template: DiagnosticEntryValue{ StringValue: COPY "%{detail}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Identifier rejected, no close-enough candidate to suggest as a typo fix." }, :cause: DiagnosticEntryValue{ StringValue: COPY "An identifier didn't match any candidate in the relevant scope (variable, struct field, union variant, ...) and the closest candidate was outside the typo-suggestion threshold. No auto-fix is offered." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Check the spelling and the surrounding scope. If the identifier should exist, verify it's been declared / imported in this scope." }}, :EFFECT_INFERENCE_VIOLATION: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :type }, :template: DiagnosticEntryValue{ StringValue: COPY "%{detail}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Per-function effect inference (P3.x) rejected the program (yield-across-lock, naked nested-WITH, recursive lock acquire, etc.)." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Per-function effect inference (yield / alloc_heap / io / fail) detected a violation: hold-lock-across-yield, naked nested-WITH, recursive lock acquire on the same binding, etc. The specific check is described in the message." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Most are structural: split the WITH (no nested re-acquire), avoid yielding while holding a lock, add `EFFECTS REENTRANT` if recursion is intentional. The message names the specific check." }}, :CAPABILITY_INVALID: {:severity: DiagnosticEntryValue{ SymbolValue: :error }, :category: DiagnosticEntryValue{ SymbolValue: :capability }, :template: DiagnosticEntryValue{ StringValue: COPY "%{detail}" }, :summary: DiagnosticEntryValue{ StringValue: COPY "Capability declaration rejected by Capabilities.validate! (unsupported sigil combination, primitive cap, etc.)." }, :cause: DiagnosticEntryValue{ StringValue: COPY "Capabilities.validate! rejected the binding's capability stack \u{2014} either an unsupported sigil combination (`@local:atomic`), a capability on an incompatible type (capability on a primitive), or a missing required capability." }, :fix_hint: DiagnosticEntryValue{ StringValue: COPY "Read the message for the specific rejection. Common fixes: drop a contradictory sigil, wrap a primitive in a struct, add a missing wrapper (`@shared` for cross-fiber sharing)." }}};
END
EXTERN FN compilerInspectValue() RETURNS String EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerFormatTemplate(template: String) RETURNS (template): String EFFECTS :safe FROM "compiler_regex";
# Ruby module DiagnosticRegistry
UNION DiagnosticEntryValue { StringValue: String, SymbolValue: String@symbol, BoolValue: Bool }
categories_value: [14]String@symbol = [:type, :type_migration, :ownership, :mutability, :capability, :concurrency, :lifetime, :escape, :registry, :reentrance, :lint, :syntax, :mir, :test];
severities: [4]String@symbol = [:error, :warning, :hint, :info];
PUB FN diagnosticRegistry__categories() RETURNS ![14]String@symbol ->
  RETURN categories_value;
END
FN diagnosticRegistry__entry(severity: String@symbol, category: String@symbol, template: String, summary: String, cause: ?String = NIL, fix_hint: ?String = NIL, pending_value: Bool = FALSE) RETURNS !{String@symbol}?DiagnosticEntryValue ->
  MUTABLE out: {String@symbol}?DiagnosticEntryValue = {};
  out[:severity] = DiagnosticEntryValue{ SymbolValue: COPY severity };
  out[:category] = DiagnosticEntryValue{ SymbolValue: COPY category };
  out[:template] = DiagnosticEntryValue{ StringValue: COPY template };
  out[:summary] = DiagnosticEntryValue{ StringValue: COPY summary };
  IF cause EXISTS AS cause_value THEN
    out[:cause] = DiagnosticEntryValue{ StringValue: COPY cause_value };
  END
  IF fix_hint EXISTS AS fix_hint_value THEN
    out[:fix_hint] = DiagnosticEntryValue{ StringValue: COPY fix_hint_value };
  END
  IF pending_value THEN
    out[:pending] = DiagnosticEntryValue{ BoolValue: COPY pending_value };
  END
  RETURN out;
END
FN diagnosticRegistry__lookup(code: String@symbol) RETURNS !?{String@symbol}?DiagnosticEntryValue ->
  RETURN COPY diagnosticRegistry__all()[code];
END
FN diagnosticRegistry__known?(code: String@symbol) RETURNS Bool ->
  RETURN diagnosticRegistry__all().contains?(code);
END
# keys() hands back map-owned Strings, not interned handles; see KeyList.
FN diagnosticRegistry__codes() RETURNS ![]String ->
  RETURN diagnosticRegistry__all().keys();
END
FN diagnosticRegistry__pending?(code: String@symbol) RETURNS Bool ->
  IF ((code == :PRIMITIVE_PASSED_AS_MUTABLE) OR (code == :GIVE_BAD_TARGET)) THEN
    RETURN TRUE;
  END
  RETURN FALSE;
END
FN diagnosticRegistry__format(code: String@symbol, args: Any[], kwargs: {String@symbol}String = {}) RETURNS !?String ->
  RETURN TRY (diagnosticRegistry__format_from_hash(code, args, kwargs));
END
PUB FN diagnosticRegistry__format_from_hash(code: String@symbol, args: Any[], kwargs: {String@symbol}String) RETURNS !?String ->
  MUTABLE registry = diagnosticRegistry__all();
  MUTABLE entry: ?{String@symbol}?DiagnosticEntryValue = COPY registry[code];
  IF entry EXISTS AS entry_value THEN
    RETURN diagnosticRegistry__format_template(TRY (diagnosticRegistry__template_from_entry(entry_value)), args, kwargs);
  ELSE
    RETURN NIL;
  END
END
FN diagnosticRegistry__template_from_entry(entry: {String@symbol}?DiagnosticEntryValue) RETURNS !String ->
  MUTABLE rtoc_each_items_1 = entry.values();
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < rtoc_each_items_1.length() DO
  IF rtoc_each_items_1[rtoc_idx]? IS_A String AS string THEN
      RETURN COPY string;
  END
  rtoc_idx = rtoc_idx + 1;
  END
  panic("Internal Compiler Error: diagnostic entry has no template");
END
PUB FN diagnosticRegistry__format_template(template: String, args: Any[], kwargs: {String@symbol}String) RETURNS String ->
  IF (!((kwargs.count() == 0)) OR template.contains?("%{")) THEN
    IF (!(template.contains?("%{")) OR diagnosticRegistry__named_template_args_complete?(template, kwargs)) THEN
      RETURN compilerFormatTemplate(template);
    END
    RETURN "${template} [Internal Args Error: ${compilerInspectValue()}]";
  END
  IF diagnosticRegistry__positional_template_args_complete?(template, args) THEN
    RETURN compilerFormatTemplate(template);
  END
  RETURN "${template} [Internal Args Error: ${compilerInspectValue()}]";
END
FN diagnosticRegistry__named_template_args_complete?(template: String, kwargs: {String@symbol}String) RETURNS Bool ->
  MUTABLE offset: Int64 = 0;
  WHILE TRUE DO
    MUTABLE start_index: ?Int64 = template.indexOf("%{", offset);
    IF start_index EXISTS AS start_index_value THEN
      MUTABLE end_index: ?Int64 = template.indexOf("}", (start_index_value + 2));
      IF end_index EXISTS AS end_index_value THEN
        MUTABLE key = symbol((template.substr(((start_index_value + 2)), (end_index_value - ((start_index_value + 2))))));
        IF !(kwargs.contains?(key)) THEN
          RETURN FALSE;
        END
        offset = (end_index_value + 1);
      ELSE
        BREAK;
      END
    ELSE
      BREAK;
    END
  END
  RETURN TRUE;
END
FN diagnosticRegistry__named_template_keys(template: String) RETURNS ![]String@symbol ->
  MUTABLE keys: []String@symbol = ( { MUTABLE rtoc_empty_list_2: []String@symbol = List[]; rtoc_empty_list_2 } );
  MUTABLE offset: Int64 = 0;
  WHILE TRUE DO
    MUTABLE start_index: ?Int64 = template.indexOf("%{", offset);
    IF start_index EXISTS AS start_index_value THEN
      MUTABLE end_index: ?Int64 = template.indexOf("}", (start_index_value + 2));
      IF end_index EXISTS AS end_index_value THEN
        &keys.append(symbol((template.substr(((start_index_value + 2)), (end_index_value - ((start_index_value + 2)))))));
        offset = (end_index_value + 1);
      ELSE
        BREAK;
      END
    ELSE
      BREAK;
    END
  END
  RETURN keys;
END
FN diagnosticRegistry__positional_template_args_complete?(template: String, args: Any[]) RETURNS Bool ->
  RETURN (diagnosticRegistry__positional_placeholder_count(template) <= args.length());
END
FN diagnosticRegistry__positional_placeholder_count(template: String) RETURNS Int64 ->
  MUTABLE count: Int64 = 0;
  MUTABLE i: Int64 = 0;
  WHILE (i < (template.codepointCount() - 1)) DO
    IF (template.substr(i, 1) == "%") THEN
      MUTABLE spec = template.substr((i + 1), 1);
      IF ((spec == "s") OR (spec == "d")) THEN
        count = (count + 1);
        i = (i + 1);
      ELSE_IF (spec == "%") THEN
        i = (i + 1);
      END
    END
    i = (i + 1);
  END
  RETURN count;
END
PUB FN diagnosticRegistry__fix_description_from_hash(code: String@symbol, kwargs: {String@symbol}String) RETURNS !String ->
  MUTABLE template: ?String = COPY (CAST({:INSERT_SELECT_EFFECT_COLON: "Change the legacy SELECT effect spelling to %{selector}.", :INSERT_SELECT_EFFECT_ANNOTATION: "Change SELECT to %{selector} so the selected element effect is explicit.", :ADD_DECL_CAPABILITY_GENERIC: "Add `%{sigil}` to '%{name}' at its declaration (line %{line}).", :ADD_EFFECTS_REENTRANT: "Add `EFFECTS REENTRANT` so the runtime knows to schedule this fn on a service stack.", :ADD_STREAM_YIELDS_CONTRACT: "Add `YIELDS %{type}` so the stream's future or union item type is explicit.", :ADD_ERROR_UNION_TO_RETURN: "Add `!` to the return type to declare the error union (Zig-style fallible signature).", :PROPAGATE_ERROR_UNION_TO_CALLERS: "Declare the error union and make propagating call sites explicit.", :CONSUME_FUTURE_WITH_NEXT: "Consume the future with NEXT.", :CONSUME_STREAM_WITH_COLLECT: "Consume the stream with COLLECT.", :MAKE_VALUE_RECOVERY_EXPLICIT: "Make the unwrap/propagation explicit.", :ADD_NON_REENTRANT_REQUIRES: "Add %{requires} (rejects reentrant callbacks).", :ADD_WITH_GUARD_ALIASES: "Add `AS <alias>` to each binding so the GUARD predicate can read the unwrapped value.", :INSERT_MUTABLE_ARGUMENT_MARKER: "Pass '%{name}' as '&%{name}' for MUTABLE parameter '%{param}'.", :REMOVE_MUTABLE_ARGUMENT_MARKER: "Remove `&` because parameter '%{param}' is not MUTABLE.", :REMOVE_MUTATION_NAME_SUFFIX: "Remove the retired `!` mutation suffix from this identifier.", :RETAIN_ASYNC_WRAPPER: "Retain the %{kind} deliberately.", :RETAIN_VALUE_WRAPPER: "Retain the %{kind} wrapper deliberately.", :CHANGE_BINDING_CAPABILITY_FOR_MOVE: "Change '%{name}' to `%{cap}` at its declaration (%{reason}).", :CHANGE_DECL_CAPABILITY_GENERIC: "Change `%{old_sigil}` to `%{new_sigil}` on '%{name}' (line %{line}).", :CHOOSE_RECURSIVE_LAYOUT: "%{description} on %{edge} using `%{capability}`.", :CONSTRUCT_INDIRECT_LAYOUT: "Construct this value with explicit `@boxed` layout.", :DECLARE_FN_REENTRANT: "Declare '%{fn}' as 'EFFECTS REENTRANT' (propagates the cost; caller runs on @service).", :DECLARE_MAX_DEPTH_CYCLE: "Declare every cycle member ':MAX_DEPTH(%{depth})' and change each return type from `T` to `!T`. Runtime depth counter raises System MaxDepthExceeded above %{depth} entries. PICK N TIGHT: large N is not a workaround for being forced onto OS threads -- if depth is unknown/unbounded, prefer ':THUNK' (heap CPS) or plain 'EFFECTS REENTRANT' (OS threads).", :DECLARE_MUTABLE_BINDING: "Declare '%{name}' as MUTABLE at its binding site (line %{line}).", :DECLARE_NOT_LOGICAL_CYCLE: "Declare every cycle member ':NOT_LOGICAL' and change each return type from `T` to `!T`. Runtime StackGuard raises System UnexpectedRecursion if the cycle actually re-enters; callers must handle (or propagate via `!T`) that error.", :DROP_MAX_DEPTH_MUTUAL: "Drop ':MAX_DEPTH(%{max_depth})' and accept the ':unbounded' tier explicitly. Same runtime cost as today but the choice is now in the source.", :DROP_OBSERVABLE_CAPABILITY: "Drop `%{token}` from the binding's type annotation. The remaining type behaves as a regular binding (no producer fiber, no WITH VIEW); use this if you didn't actually want streaming-aggregate semantics.", :DROP_THUNK_CYCLE: "Drop ':THUNK' on every cycle member; use plain 'EFFECTS REENTRANT' (callers run on @service).", :DROP_WITH_GUARD_MUTABLE: "Drop `MUTABLE` from %{target} so the GUARD predicate stays valid (the body only reads through the alias).", :INSERT_EXPECTED_AT_END_OF_LINE: "Insert `%{expected}` at end of line %{line}.", :INSERT_EXPECTED_BEFORE_TOKEN: "Insert `%{expected}` before '%{got}' at line %{line}.", :INSERT_EXISTS_BEFORE_AS: "Insert `EXISTS` before `AS`.", :INSERT_COMPTIME_BEFORE_IF: "Insert COMPTIME before IF.", :INSERT_RETURNS_ANY: "Insert `RETURNS :Any` so the function accepts the polymorphic return.", :INSERT_RETURNS_FALLIBLE_VOID: "Insert `RETURNS !Void` so PRE-failure errors can propagate.", :INSERT_SAFE_NAVIGATION: "Insert `?` before field access so NIL propagates safely.", :INSERT_SERVICE_AFTER_OPEN_BRACE: "Insert `@service ->` after `{` (this fiber transitively calls a plain :reentrant fn).", :MIGRATE_ATOMIC_ESCAPE: "Migrate '%{name}' from `@shared:atomic` to `@shared:locked` so its lifetime can outlive the declaring scope. NOTE: `@shared:locked` typically needs a STRUCT wrap around the primitive (e.g. `STRUCT Counter { v: Int64 }; c = Counter{v: 0} @shared:locked`); read/write sites become `WITH EXCLUSIVE c AS a { ... }`. Alternatively, wait for v0.3 atomic struct fields, which lift this escape restriction without the Arc cost.", :PIN_AUTO_SLOT: "(%{position}) Pin %{label} to `%{type}`.%{note}", :PREFIX_TENSE_TYPE: "Prefix the declared type with `~` so '%{name}' becomes a tense (`~T`) source. MATERIALIZED VIEW snapshots a tense aggregate at the WITH boundary.", :PREFIX_COPY_SNAPSHOT: "Prefix the source with `COPY` to create an independent snapshot.", :PREFIX_EXPLICIT_OWNERSHIP_COST: "Prefix the source with `%{keyword}` to make the ownership cost explicit.", :REMOVE_LOCAL_CAPABILITY: "Remove `@local` capability from '%{name}' (never shared across fibers).", :REMOVE_MUTABLE_UNUSED: "Remove MUTABLE keyword (binding is never reassigned).", :REPLACE_CAN_SMASH_WITH_SERVICE: "Replace `@canSmash` with `@service` (OS-thread spawn -- supported today).", :REPLACE_IDENTIFIER_WITH_CANDIDATE: "Replace '%{name}' with '%{best}' (%{label}).", :REPLACE_LOCKED_WITH_WRITE_LOCKED: "Change `@locked` to `@writeLocked` on '%{name}' so concurrent readers can take `WITH READ` alongside `WITH EXCLUSIVE` writers.", :REPLACE_MATCH_WITH_PARTIAL: "Replace `MATCH` with `PARTIAL MATCH` (relaxes exhaustiveness; allows DEFAULT and WHEN guards).", :REPLACE_OPERATOR_TYPO: "Replace `%{match}` with `%{replace}` -- %{label}.", :REPLACE_STRING_CONCAT_OPERATOR: "Replace `+` with `$+` for string concatenation.", :REWRITE_INLINE_PIVOT_TYPE: "Rewrite as `%{type}`.", :RENAME_BOXED_CAPABILITY: "Replace legacy `%{old}` with `%{new}`.", :TEST_OPTIONAL_BOOL_PRESENCE: "Test whether the optional Bool is present with `%{name} EXISTS`.", :DEFAULT_OPTIONAL_BOOL_PAYLOAD: "Use the Bool payload, defaulting NIL to FALSE, with `(%{name} OR_ELSE FALSE)`.", :REPLACE_REENTRANT_WITH_VARIANT: "Replace `EFFECTS REENTRANT` with `%{suggestion}` (%{reason}).", :REPLACE_STACK_SIGIL_WITH_SERVICE: "Replace `@%{stack}` with `@service` (this fiber transitively calls a plain :reentrant fn).", :UPGRADE_VERSIONED_TO_SHARED: "Upgrade `@versioned` to `@shared:versioned` for cross-thread sharing.", :WITH_ADD_INDIRECT_ATOMIC: "Add `@boxed:atomic` to '%{name}' (lock-free atomic-pointer cell -- readers snapshot, writers CAS-publish).", :WITH_ADD_LOCKED: "Add `@locked` to '%{name}' (Mutex -- single-writer EXCLUSIVE access).", :WITH_ADD_MULTIOWNED: "Add `@multiowned` to '%{name}' (Rc -- single-scheduler refcount; cheap clones%{suffix}).", :WITH_ADD_SHARED: "Add `@shared` to '%{name}' (Arc -- atomic refcount; safe %{suffix}).", :WITH_ADD_SHARED_ATOMIC: "Add `@shared:atomic` to '%{name}' (lock-free atomic primitive -- `c.load()`, `c.fetchAdd(n)`, etc. via WITH ATOMIC).", :WITH_ADD_VERSIONED: "Add `@versioned` to '%{name}' (MVCC cell -- readers see a stable snapshot; writers retry on conflict).", :WITH_ADD_WRITE_LOCKED: "Add `@writeLocked` to '%{name}' (RwLock -- readers %{reader}; writers via `WITH EXCLUSIVE`).", :WITH_VIEW_TO_MATERIALIZED: "Replace `VIEW` with `MATERIALIZED VIEW` (owned O(N) snapshot, works on any `~T` aggregate).", :WIDEN_INT_ANNOTATION: "Widen annotation `%{old_type}` to `%{new_type}` (smallest type that fits %{value}).", :WIDEN_INT_SUFFIX: "Widen suffix `_%{old_suffix}` to `_%{new_suffix}` (smallest type that fits %{value}).", :WRAP_CAPABILITY_ACCESS: "Wrap with `WITH %{permission} %{name} AS %{alias_name} { ... }` to acquire the %{capability} unwrap; access the inner value through %{alias_name}.", :WRAP_FOREIGN_INDEX_UNSAFE_VIEW: "Wrap this access in `WITH UNSAFE VIEW %{name} LENGTH %{length} AS %{alias_name} { ... }`; verify that the C allocation really contains that many elements.", :CONVERT_FOREIGN_VIEW_TO_UNSAFE: "Change this to `WITH UNSAFE VIEW %{name} LENGTH 0 AS ...`; then replace 0 with the element count guaranteed by the C API.", :WRAP_DIRECT_VIEW_ACCESS: "Wrap this access in `WITH %{permission} %{name} AS %{alias_name} { ... }` and use the scoped alias.", :WRAP_CONSUMER_WITH_COPY: "Wrap the consuming reference with COPY at line %{line} (the original survives for the later use).", :WRAP_CONSUMER_WITH_KEEP: "Wrap the consuming reference with KEEP at line %{line} (preserves the caller's carrier: refcount retain for @multiowned/@shared/@split, payload copy for a plain value; both bindings stay live).", :WRAP_RETURN_WITH_COPY: "Wrap the returned value with `COPY ` so it doesn't borrow from the parameter.", :WRAP_VALUE_WITH_CAST: "Wrap value with `CAST(... AS %{type})` (narrowing -- verify it can't lose data).", :REPLACE_AUTO_WITH_INFERRED: "Replace `Auto` with the inferred type `%{type}`."} AS {String@symbol}String))[code];
  IF template EXISTS AS template_value THEN
    IF diagnosticRegistry__named_template_args_complete?(template_value, kwargs) THEN
      RETURN compilerFormatTemplate(template_value);
    END
    MUTABLE missing: ?String@symbol = diagnosticRegistry__missing_named_template_key(template_value, kwargs);
    MUTABLE detail: String = "";
    IF missing EXISTS AS missing_value THEN
      detail = "key{${missing_value}} not found kwargs=${compilerInspectValue()}";
    ELSE
      detail = "kwargs=${compilerInspectValue()}";
    END
    RETURN "${template_value} [Internal Args Error: ${detail}]";
  ELSE
    panic("Internal Compiler Error: Unknown fix description code :{}");
  END
END
FN diagnosticRegistry__missing_named_template_key(template: String, kwargs: {String@symbol}String) RETURNS ?String@symbol ->
  MUTABLE offset: Int64 = 0;
  WHILE TRUE DO
    MUTABLE start_index: ?Int64 = template.indexOf("%{", offset);
    IF start_index EXISTS AS start_index_value THEN
      MUTABLE end_index: ?Int64 = template.indexOf("}", (start_index_value + 2));
      IF end_index EXISTS AS end_index_value THEN
        MUTABLE key = symbol((template.substr(((start_index_value + 2)), (end_index_value - ((start_index_value + 2))))));
        IF !(kwargs.contains?(key)) THEN
          RETURN key;
        END
        offset = (end_index_value + 1);
      ELSE
        BREAK;
      END
    ELSE
      BREAK;
    END
  END
  RETURN NIL;
END
PUB FN diagnosticRegistry__fix_description(code: String@symbol, kwargs: {String@symbol}String = {}) RETURNS !String ->
  RETURN TRY (diagnosticRegistry__fix_description_from_hash(code, kwargs));
END
# End Ruby module DiagnosticRegistry
