PUB FN structSchema__field_defaults(self: StructSchema) RETURNS !{String}Locatable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE out: {String}Locatable = {};
    MUTABLE keys = rtoc_self_view.fields.keys();
    MUTABLE i: Int64 = 0;
    WHILE (i < keys.length()) DO
      MUTABLE default_value: ?Locatable = COPY (UNWRAP (rtoc_self_view.fields[UNWRAP (keys[i])])).default;
      IF default_value EXISTS AS present_default THEN
        out[UNWRAP (keys[i])] = COPY present_default;
      END
      i = (i + 1);
    END
    RETURN out;
}
END
PUB FN structSchema__borrowed_fields(self: StructSchema) RETURNS ![Set]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE out: [Set]String = Set[];
    MUTABLE keys = rtoc_self_view.fields.keys();
    MUTABLE i: Int64 = 0;
    WHILE (i < keys.length()) DO
      IF (UNWRAP (rtoc_self_view.fields[UNWRAP (keys[i])])).borrowed THEN
        &out.insert(COPY UNWRAP (keys[i]));
      END
      i = (i + 1);
    END
    RETURN out;
}
END
