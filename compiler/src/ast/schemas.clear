PUB UNION SchemasEnumSchemaVariantInputItem { StringValue: String, SymbolValue: String@symbol }
PUB FN castStringListToSchemasEnumSchemaVariantInputItemList(values: []String) RETURNS []SchemasEnumSchemaVariantInputItem ->
  MUTABLE out: []SchemasEnumSchemaVariantInputItem = List[];
  FOR value IN values DO
    &out.append(SchemasEnumSchemaVariantInputItem{ StringValue: COPY value });
  END
  RETURN out;
END
FN enumSchema__initialize(MUTABLE self: EnumSchema, variants: []SchemasEnumSchemaVariantInputItem, visibility: String@symbol = :package) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.variants = TRY (enumSchema__normalize_variants(rtoc_self_view, variants));
    rtoc_self_view.visibility = COPY visibility;
}
END
FN enumSchema__normalize_variants(self: EnumSchema, variants: []SchemasEnumSchemaVariantInputItem) RETURNS ![Set]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE normalized: [Set]String = Set[];
    FOR _ IN variants DO
    &normalized.insert(COPY CAST(_ AS String));
    END
    RETURN normalized;
}
END
