    MUTABLE keys = variants.keys();
    MUTABLE i: Int64 = 0;
    WHILE (i < keys.length()) DO
      MUTABLE key: String = COPY UNWRAP (keys[i]);
      out[key] = unionSchema__normalize_variant(rtoc_self_view, variants[key]);
      i = (i + 1);
    END
    RETURN out;
}
