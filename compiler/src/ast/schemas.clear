FN resourceCloseAction__for_field(self: ResourceCloseAction, field: String) RETURNS ResourceCloseAction ->
  RETURN ResourceCloseAction{ call_kind: COPY self.call_kind, name: COPY self.name, field_path: COPY ([field] + self.field_path), runtime_heap_alloc_args: self.runtime_heap_alloc_args };
END
