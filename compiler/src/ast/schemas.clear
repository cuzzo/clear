    rtoc_self_view.fields = TRY (resourceSchema__normalize_fields(rtoc_self_view, fields));
    rtoc_self_view.type_params = COPY type_params;
    rtoc_self_view.extern_module = COPY extern_module;
    rtoc_self_view.as_type = COPY as_type;
    rtoc_self_view.visibility = COPY visibility;
    rtoc_self_view.methods = COPY methods;
}
