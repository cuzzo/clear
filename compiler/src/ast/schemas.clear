FN resourceSchema__normalize_fields(self: ResourceSchema, fields: {String@symbol}SchemasResourceSchemaFieldInput) RETURNS !{String}StructField
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE out: {String}StructField = {};
    MUTABLE keys = fields.keys();
    MUTABLE i: Int64 = 0;
    WHILE (i < keys.length()) DO
      MUTABLE current_key: String = COPY UNWRAP (keys[i]);
      out[current_key] = CAST(resourceSchema__normalize_field(rtoc_self_view, UNWRAP (fields[current_key])) AS StructField);
      i = (i + 1);
    END
    RETURN out;
}
END
PUB FN resourceSchema__normalize_field(self: ResourceSchema, field: SchemasResourceSchemaFieldInput) RETURNS StructField
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF field IS_A StructField AS struct_field THEN
      RETURN COPY struct_field;
    END
    IF field IS_A {String@symbol}SchemasResourceSchemaFieldMetadataValue AS hash THEN
      MUTABLE raw_type_value: ?SchemasResourceSchemaFieldMetadataValue = COPY hash[:type];
      IF (raw_type_value == NIL) THEN
        raw_type_value = COPY hash[symbol("type")];
      END
      MUTABLE default_value: ?SchemasResourceSchemaFieldMetadataValue = COPY hash[:default];
      IF (default_value == NIL) THEN
        default_value = COPY hash[symbol("default")];
      END
      # `default` is stored in the metadata union but the field holds a
      # Locatable, so take that variant rather than the whole union.
      MUTABLE default_node: ?Locatable = NIL;
      IF default_value EXISTS AS default_present THEN
        IF default_present IS_A Locatable AS default_locatable THEN
          default_node = COPY default_locatable;
        END
      END
      MUTABLE borrowed_value: ?SchemasResourceSchemaFieldMetadataValue = COPY hash[:borrowed];
      IF (borrowed_value == NIL) THEN
        borrowed_value = COPY hash[symbol("borrowed")];
      END
      IF raw_type_value EXISTS AS raw_type_value_value THEN
        IF raw_type_value_value IS_A SchemasResourceSchemaFieldMetadataValue.Type AS field_type THEN
          RETURN StructField{ type: COPY field_type, default: COPY default_node, borrowed: !((borrowed_value == NIL)) };
        END
        IF raw_type_value_value IS_A SchemasResourceSchemaFieldMetadataValue.TypeMultiowned AS field_type THEN
          RETURN StructField{ type: COPY field_type, default: COPY default_node, borrowed: !((borrowed_value == NIL)) };
        END
      ELSE
        RETURN StructField{ type: TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })), default: COPY default_node, borrowed: !((borrowed_value == NIL)) };
      END
    END
    IF field IS_A SchemasResourceSchemaFieldInput.Type AS field_type THEN
      RETURN StructField{ type: COPY field_type, default: NIL, borrowed: FALSE };
    END
    IF field IS_A SchemasResourceSchemaFieldInput.TypeMultiowned AS field_type THEN
      RETURN StructField{ type: COPY field_type, default: NIL, borrowed: FALSE };
    END
    IF field IS_A SchemasResourceSchemaFieldInput.SymbolValue AS field_symbol THEN
      RETURN StructField{ type: TRY (type__new(TypeConstructionInput{ SymbolValue: COPY field_symbol })), default: NIL, borrowed: FALSE };
    END
    RETURN StructField{ type: TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })), default: NIL, borrowed: FALSE };
}
END
