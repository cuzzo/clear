}
END
PUB FN structSchema__normalize_field(self: StructSchema, field: SchemasStructSchemaFieldInput) RETURNS !StructField
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF field IS_A StructField AS struct_field THEN
      RETURN COPY struct_field;
    END
    IF field IS_A {String@symbol}SchemasStructSchemaFieldMetadataValue AS hash THEN
      MUTABLE raw_type_value: ?SchemasStructSchemaFieldMetadataValue = COPY hash[:type];
      IF (raw_type_value == NIL) THEN
        raw_type_value = COPY hash[symbol("type")];
      END
      MUTABLE default_value: ?SchemasStructSchemaFieldMetadataValue = COPY hash[:default];
      IF (default_value == NIL) THEN
        default_value = COPY hash[symbol("default")];
      END
      MUTABLE default_node: ?Locatable = NIL;
      IF default_value EXISTS AS default_present THEN
        IF default_present IS_A Locatable AS default_locatable THEN
          default_node = COPY default_locatable;
        END
      END
      MUTABLE borrowed_value: ?SchemasStructSchemaFieldMetadataValue = COPY hash[:borrowed];
      IF (borrowed_value == NIL) THEN
        borrowed_value = COPY hash[symbol("borrowed")];
      END
      IF raw_type_value EXISTS AS raw_type_value_value THEN
        IF raw_type_value_value IS_A SchemasResourceSchemaFieldMetadataValue.Type AS field_type THEN
          RETURN StructField{ type: COPY field_type, default: COPY default_node, borrowed: !((borrowed_value == NIL)) };
        END
        IF raw_type_value_value IS_A SchemasResourceSchemaFieldMetadataValue.TypeMultiowned AS field_type THEN
          RETURN StructField{ type: COPY field_type, default: COPY default_node, borrowed: !((borrowed_value == NIL)) };
        END
      ELSE
        RETURN StructField{ type: TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })), default: COPY default_node, borrowed: !((borrowed_value == NIL)) };
      END
    END
    IF field IS_A SchemasResourceSchemaFieldInput.Type AS field_type THEN
      RETURN StructField{ type: COPY field_type, default: NIL, borrowed: FALSE };
    END
    IF field IS_A SchemasResourceSchemaFieldInput.TypeMultiowned AS field_type THEN
      RETURN StructField{ type: COPY field_type, default: NIL, borrowed: FALSE };
    END
    IF field IS_A SchemasResourceSchemaFieldInput.SymbolValue AS field_symbol THEN
      RETURN StructField{ type: TRY (type__new(TypeConstructionInput{ SymbolValue: COPY field_symbol })), default: NIL, borrowed: FALSE };
    END
    RETURN StructField{ type: TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })), default: NIL, borrowed: FALSE };
}
END
PUB FN structSchema__new(fields: {String@symbol}SchemasStructSchemaFieldInput, type_params: []String@symbol, generic_params: []GenericParamDecl, methods: {String@symbol}FunctionSignature@multiowned, static_methods: {String@symbol}FunctionSignature@multiowned, visibility: String@symbol = :package, extern_module: ?String = NIL, as_type: ?String = NIL) RETURNS !StructSchema@multiowned ->
  MUTABLE self = StructSchema{ as_type: COPY as_type, extern_module: COPY extern_module, fields: {}, generic_params: COPY generic_params, methods: COPY methods, static_methods: COPY static_methods, type_params: COPY type_params, visibility: COPY visibility };
  TRY (structSchema__initialize(&self, fields, type_params, generic_params, methods, static_methods, visibility, extern_module, as_type));
  RETURN self @multiowned;
END
PUB UNION SchemaValue { EnumSchemaMultiowned: EnumSchema@multiowned, StructSchemaMultiowned: StructSchema@multiowned, UnionSchemaMultiowned: UnionSchema@multiowned, ResourceSchemaMultiowned: ResourceSchema@multiowned }
PUB FN schemaValue__fields(self: SchemaValue) RETURNS {String@symbol}StructField ->
  PARTIAL MATCH self START
    SchemaValue.StructSchemaMultiowned AS item -> RETURN COPY item.fields;,
    SchemaValue.ResourceSchemaMultiowned AS item -> RETURN COPY item.fields;
  END
  RETURN {};
END
PUB FN schemaValue__type_params(self: SchemaValue) RETURNS []String@symbol ->
  PARTIAL MATCH self START
    SchemaValue.StructSchemaMultiowned AS item -> RETURN COPY item.type_params;,
    SchemaValue.UnionSchemaMultiowned AS item -> RETURN COPY item.type_params;,
    SchemaValue.ResourceSchemaMultiowned AS item -> RETURN COPY item.type_params;
  END
  RETURN CAST(List[] AS []String@symbol);
END
PUB UNION FieldBearingSchema { StructSchemaMultiowned: StructSchema@multiowned, ResourceSchemaMultiowned: ResourceSchema@multiowned, InlineStructVariantMultiowned: InlineStructVariant@multiowned }
PUB FN struct?(s: ?SchemaValue) RETURNS Bool ->
  IF s EXISTS AS schema_value THEN
    RETURN schema_value IS_A StructSchema;
  END
  RETURN FALSE;
END
PUB FN union?(s: ?SchemaValue) RETURNS Bool ->
  IF s EXISTS AS schema_value THEN
    RETURN schema_value IS_A UnionSchema;
  END
  RETURN FALSE;
END
PUB FN enum?(s: ?SchemaValue) RETURNS Bool ->
  IF s EXISTS AS schema_value THEN
    RETURN schema_value IS_A EnumSchema;
  END
  RETURN FALSE;
END
PUB FN resource?(s: ?SchemaValue) RETURNS Bool ->
  IF s EXISTS AS schema_value THEN
    RETURN schema_value IS_A ResourceSchema;
  END
  RETURN FALSE;
END
PUB FN inline_struct?(v: ?SchemasUnionSchemaVariantValue) RETURNS Bool ->
  IF v EXISTS AS variant_value THEN
    RETURN variant_value IS_A InlineStructVariant;
  END
  RETURN FALSE;
END
PUB FN field_bearing?(s: ?SchemaValue) RETURNS Bool ->
  IF s EXISTS AS schema_value THEN
    RETURN ((schema_value IS_A StructSchema) OR (schema_value IS_A ResourceSchema));
  END
  RETURN FALSE;
END
# End Ruby module Schemas
PUB FN castSchemasUnionSchemaVariantInputToOptionalSchemasUnionSchemaVariantValue(value: SchemasUnionSchemaVariantInput) RETURNS ?SchemasUnionSchemaVariantValue ->
  PARTIAL MATCH value START
    SchemasUnionSchemaVariantInput.FunctionType AS cast_payload -> RETURN SchemasUnionSchemaVariantValue{ FunctionType: COPY cast_payload };,
    SchemasUnionSchemaVariantInput.TypeMultiowned AS cast_payload -> RETURN SchemasUnionSchemaVariantValue{ TypeMultiowned: COPY cast_payload };,
    SchemasUnionSchemaVariantInput.SymbolValue AS cast_payload -> RETURN SchemasUnionSchemaVariantValue{ SymbolValue: COPY cast_payload };,
    SchemasUnionSchemaVariantInput.StringValue AS cast_payload -> RETURN SchemasUnionSchemaVariantValue{ StringValue: COPY cast_payload };,
    SchemasUnionSchemaVariantInput.InlineStructVariantMultiowned AS cast_payload -> RETURN SchemasUnionSchemaVariantValue{ InlineStructVariantMultiowned: COPY cast_payload };,
    SchemasUnionSchemaVariantInput.Type AS cast_payload -> RETURN SchemasUnionSchemaVariantValue{ Type: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to ?SchemasUnionSchemaVariantValue");
  END
  panic("Invalid cast to ?SchemasUnionSchemaVariantValue");
END

# TypeSchemaLookupResult and SchemaValue are the same four variants under
# two names rtoc synthesized separately. This is the bridge between them,
# in the shape rtoc gives its other cast helpers.
PUB FN castTypeSchemaLookupResultToSchemaValue(value: TypeSchemaLookupResult) RETURNS SchemaValue ->
  PARTIAL MATCH value START
    TypeSchemaLookupResult.EnumSchemaMultiowned AS item -> RETURN SchemaValue{ EnumSchemaMultiowned: COPY item };,
    TypeSchemaLookupResult.StructSchemaMultiowned AS item -> RETURN SchemaValue{ StructSchemaMultiowned: COPY item };,
    TypeSchemaLookupResult.UnionSchemaMultiowned AS item -> RETURN SchemaValue{ UnionSchemaMultiowned: COPY item };,
    TypeSchemaLookupResult.ResourceSchemaMultiowned AS item -> RETURN SchemaValue{ ResourceSchemaMultiowned: COPY item };,
    DEFAULT -> panic("Invalid cast to SchemaValue");
  END
  panic("Invalid cast to SchemaValue");
END

# Ruby: each declared field's raw type, wrapped as a Type, keyed by name.
PUB FN inlineStructVariant__typed_fields(self: InlineStructVariant) RETURNS !{String}Type ->
  MUTABLE out: {String}Type = {};
  FOR rtoc_key IN self.fields.keys() DO
    out[CAST(rtoc_key AS String)] = TRY (type__new(castTypeTypeInputToTypeConstructionInput__inline_struct_variant(UNWRAP (self.fields[rtoc_key]))));
  END
  RETURN out;
END
FN castTypeTypeInputToTypeConstructionInput__inline_struct_variant(value: TypeTypeInput) RETURNS TypeConstructionInput ->
  PARTIAL MATCH value START
    TypeTypeInput.FunctionType AS rtoc_ft -> RETURN TypeConstructionInput{ FunctionType: COPY rtoc_ft };,
    TypeTypeInput.Type AS rtoc_ty -> RETURN TypeConstructionInput{ Type: COPY rtoc_ty };,
    TypeTypeInput.SymbolValue AS rtoc_sym -> RETURN TypeConstructionInput{ SymbolValue: COPY rtoc_sym };,
    TypeTypeInput.StringValue AS rtoc_str -> RETURN TypeConstructionInput{ StringValue: COPY rtoc_str };,
    DEFAULT -> RETURN TypeConstructionInput{ SymbolValue: :Untyped };
  END
  RETURN TypeConstructionInput{ SymbolValue: :Untyped };
END

# Ruby asks `respond_to?(:as_type)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN schemaValue__as_type(value: SchemaValue) RETURNS ?String ->
  PARTIAL MATCH value START
    SchemaValue.StructSchemaMultiowned AS item -> RETURN COPY item.as_type;,
    SchemaValue.ResourceSchemaMultiowned AS item -> RETURN COPY item.as_type;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END

# Ruby asks `respond_to?(:methods)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN schemaValue__methods(value: SchemaValue) RETURNS ?{String@symbol}FunctionSignature@multiowned ->
  PARTIAL MATCH value START
    SchemaValue.StructSchemaMultiowned AS item -> RETURN COPY item.methods;,
    SchemaValue.ResourceSchemaMultiowned AS item -> RETURN COPY item.methods;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END

# Ruby asks `respond_to?(:variants)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN schemaValue__variants(value: SchemaValue) RETURNS ?[Set]String ->
  PARTIAL MATCH value START
    SchemaValue.EnumSchemaMultiowned AS item -> RETURN COPY item.variants;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END

# Ruby asks `respond_to?(:kind)` and then calls it. The variants that
# can answer compute it; the rest do not respond.
PUB FN schemaValue__kind(value: SchemaValue) RETURNS ?String@symbol EFFECTS REENTRANT ->
  PARTIAL MATCH value START
    SchemaValue.EnumSchemaMultiowned AS item -> RETURN enumSchema__kind(item);,
    SchemaValue.StructSchemaMultiowned AS item -> RETURN structSchema__kind(item);,
    SchemaValue.UnionSchemaMultiowned AS item -> RETURN unionSchema__kind(item);,
    SchemaValue.ResourceSchemaMultiowned AS item -> RETURN resourceSchema__kind(item);,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END

# The schema constructors take their fields as the input union; a map of plain
# StructFields is converted entry by entry, in the same shape as the tree's
# list casts.
PUB FN castStructFieldMapToSchemasStructSchemaFieldInputMap(values: {String}StructField) RETURNS {String}SchemasStructSchemaFieldInput ->
  MUTABLE out: {String}SchemasStructSchemaFieldInput = {};
  FOR key IN values.keys() DO
    out[key] = SchemasStructSchemaFieldInput{ StructField: COPY (values[key] OR_ELSE panic("missing hash key")) };
  END
  RETURN out;
END

# The constructor takes its entries as the input union; a map of plain StructField
# is converted entry by entry, like the tree's list casts.
PUB FN castStructFieldMapToSchemasResourceSchemaFieldInputMap(values: {String}StructField) RETURNS {String}SchemasResourceSchemaFieldInput ->
  MUTABLE out: {String}SchemasResourceSchemaFieldInput = {};
  FOR key IN values.keys() DO
    out[key] = SchemasResourceSchemaFieldInput{ StructField: COPY (values[key] OR_ELSE panic("missing hash key")) };
  END
  RETURN out;
END
