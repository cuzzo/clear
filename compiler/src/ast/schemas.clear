PUB FN enumSchema__new(variants: []SchemasEnumSchemaVariantInputItem, visibility: String@symbol = :package) RETURNS !EnumSchema@multiowned ->
  MUTABLE self = EnumSchema{ variants: Set[], visibility: COPY visibility };
  TRY (enumSchema__initialize(&self, variants, visibility));
  RETURN self @multiowned;
END
PUB ENUM ResourceCloseCallKind { Method, Function, CFunction }
PUB STRUCT ResourceCloseAction {
  call_kind: ResourceCloseCallKind,
  name: String,
  field_path: []String,
  runtime_heap_alloc_args: Int64
}

FN resourceCloseAction__for_field(self: ResourceCloseAction, field: String) RETURNS ResourceCloseAction ->
  RETURN ResourceCloseAction{ call_kind: COPY self.call_kind, name: COPY self.name, field_path: COPY ([field] + self.field_path), runtime_heap_alloc_args: self.runtime_heap_alloc_args };
END
PUB STRUCT CaptureAnalysis {
  has_local: Bool,
  has_rc: Bool,
  has_shared: Bool,
  has_sharded: Bool,
  has_affine_locked: Bool,
  has_outer_ref: Bool,
  has_non_escaping_capture: Bool,
  captures: {String}Type,
  capture_symbols: {String}SymbolEntry@multiowned,
  close_plans: {String}ResourceClosePlan,
  pointer_captures: [Set]String,
  string_captures: [Set]String,
  resource_captures: [Set]String,
  site_moved: [Set]String,
  site_copied: [Set]String,
  strategies: {String}Strategy,
  move_mark_names: [Set]String,
  alloc_mark_entries: {String}String@symbol
}

PUB STRUCT ResourceClosePlan {
  actions: []ResourceCloseAction
}

PUB FN method(name: String, runtime_heap_alloc_args: Int64 = 0) RETURNS ResourceClosePlan ->
  RETURN ResourceClosePlan{ actions: [ResourceCloseAction{ call_kind: COPY ResourceCloseCallKind.Method, name: COPY name, runtime_heap_alloc_args: COPY runtime_heap_alloc_args, field_path: List[] }] };
END
PUB FN function(name: String, runtime_heap_alloc_args: Int64 = 0) RETURNS ResourceClosePlan ->
  RETURN ResourceClosePlan{ actions: [ResourceCloseAction{ call_kind: COPY ResourceCloseCallKind.Function, name: COPY name, runtime_heap_alloc_args: COPY runtime_heap_alloc_args, field_path: List[] }] };
END
PUB FN c_function(name: String) RETURNS ResourceClosePlan ->
  RETURN ResourceClosePlan{ actions: [ResourceCloseAction{ call_kind: COPY ResourceCloseCallKind.CFunction, name: COPY name, field_path: List[], runtime_heap_alloc_args: 0 }] };
END
PUB FN composite(actions: []ResourceCloseAction) RETURNS ResourceClosePlan ->
  RETURN ResourceClosePlan{ actions: COPY actions };
END
FN resourceClosePlan__for_field(self: ResourceClosePlan, field: String) RETURNS ResourceClosePlan EFFECTS REENTRANT ->
  MUTABLE mapped_actions = self.actions |> SELECT resourceCloseAction__for_field(_, field);
  RETURN ResourceClosePlan{ actions: COPY mapped_actions };
END
PUB FN resourceClosePlan__empty?(self: ResourceClosePlan) RETURNS Bool EFFECTS REENTRANT ->
  RETURN (self.actions.length() == 0);
END
