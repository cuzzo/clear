FN unionSchema__normalize_variant(self: UnionSchema, variant: ?SchemasUnionSchemaVariantInput) RETURNS ?SchemasUnionSchemaVariantValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF variant EXISTS AS variant_value THEN
      IF variant_value IS_A InlineStructVariant AS inline_struct_variant THEN
        RETURN COPY SchemasUnionSchemaVariantValue{ InlineStructVariantMultiowned: COPY inline_struct_variant };
      END
      RETURN COPY castSchemasUnionSchemaVariantInputToOptionalSchemasUnionSchemaVariantValue(variant_value);
    ELSE
      RETURN NIL;
    END
}
END
