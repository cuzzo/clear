FN resourceClosePlan__for_field(self: ResourceClosePlan, field: String) RETURNS ResourceClosePlan EFFECTS REENTRANT ->
  MUTABLE mapped_actions = self.actions |> SELECT resourceCloseAction__for_field(_, field);
  RETURN ResourceClosePlan{ actions: COPY mapped_actions };
END
