PUB FN structSchema__normalize_field(self: StructSchema, field: SchemasStructSchemaFieldInput) RETURNS StructField
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF field IS_A StructField AS struct_field THEN
      RETURN COPY struct_field;
    END
    IF field IS_A {String@symbol}SchemasStructSchemaFieldMetadataValue AS hash THEN
      MUTABLE raw_type_value: ?SchemasStructSchemaFieldMetadataValue = COPY hash[:type];
      IF (raw_type_value == NIL) THEN
        raw_type_value = COPY hash[symbol("type")];
      END
      MUTABLE default_value: ?SchemasResourceSchemaFieldMetadataValue = COPY hash[:default];
      IF (default_value == NIL) THEN
        default_value = COPY hash[symbol("default")];
      END
      MUTABLE borrowed_value: ?SchemasResourceSchemaFieldMetadataValue = COPY hash[:borrowed];
      IF (borrowed_value == NIL) THEN
        borrowed_value = COPY hash[symbol("borrowed")];
      END
      IF raw_type_value EXISTS AS raw_type_value_value THEN
        IF raw_type_value_value IS_A SchemasResourceSchemaFieldMetadataValue.Type AS field_type THEN
          RETURN StructField{ type: COPY field_type, default: COPY default_node, borrowed: !((borrowed_value == NIL)) };
        END
        IF raw_type_value_value IS_A SchemasResourceSchemaFieldMetadataValue.TypeMultiowned AS field_type THEN
          RETURN StructField{ type: COPY field_type, default: COPY default_node, borrowed: !((borrowed_value == NIL)) };
        END
      ELSE
        RETURN StructField{ type: TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })), default: COPY default_node, borrowed: !((borrowed_value == NIL)) };
      END
    END
    IF field IS_A SchemasResourceSchemaFieldInput.Type AS field_type THEN
      RETURN StructField{ type: COPY field_type, default: NIL, borrowed: FALSE };
    END
    IF field IS_A SchemasResourceSchemaFieldInput.TypeMultiowned AS field_type THEN
      RETURN StructField{ type: COPY field_type, default: NIL, borrowed: FALSE };
    END
    IF field IS_A SchemasResourceSchemaFieldInput.SymbolValue AS field_symbol THEN
      RETURN StructField{ type: TRY (type__new(TypeConstructionInput{ SymbolValue: COPY field_symbol })), default: NIL, borrowed: FALSE };
    END
    RETURN StructField{ type: TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })), default: NIL, borrowed: FALSE };
}
END
FN structSchema__new(fields: {String@symbol}SchemasStructSchemaFieldInput, type_params: []String@symbol, generic_params: []GenericParamDecl, methods: {String@symbol}FunctionSignature@multiowned, static_methods: {String@symbol}FunctionSignature@multiowned, visibility: String@symbol = :package, extern_module: ?String = NIL, as_type: ?String = NIL) RETURNS StructSchema@multiowned ->
  MUTABLE self = StructSchema{ as_type: COPY as_type, extern_module: COPY extern_module, fields: {}, generic_params: COPY generic_params, methods: COPY methods, static_methods: COPY static_methods, type_params: COPY type_params, visibility: COPY visibility };
  structSchema__initialize(&self, fields, type_params, generic_params, methods, static_methods, visibility, extern_module, as_type);
  RETURN self @multiowned;
END
PUB UNION SchemaValue { EnumSchemaMultiowned: EnumSchema@multiowned, StructSchemaMultiowned: StructSchema@multiowned, UnionSchemaMultiowned: UnionSchema@multiowned, ResourceSchemaMultiowned: ResourceSchema@multiowned }
PUB UNION FieldBearingSchema { StructSchemaMultiowned: StructSchema@multiowned, ResourceSchemaMultiowned: ResourceSchema@multiowned, InlineStructVariantMultiowned: InlineStructVariant@multiowned }
PUB FN struct?(s: ?SchemaValue) RETURNS Bool ->
  RETURN ((s != NIL) AND (s? IS_A StructSchema));
END
PUB FN union?(s: ?SchemaValue) RETURNS Bool ->
  RETURN ((s != NIL) AND (s? IS_A UnionSchema));
END
PUB FN enum?(s: ?SchemaValue) RETURNS Bool ->
  RETURN ((s != NIL) AND (s? IS_A EnumSchema));
END
PUB FN resource?(s: ?SchemaValue) RETURNS Bool ->
  RETURN ((s != NIL) AND (s? IS_A ResourceSchema));
END
PUB FN inline_struct?(v: Object) RETURNS Bool ->
  RETURN v IS_A InlineStructVariant;
END
PUB FN field_bearing?(s: ?SchemaValue) RETURNS Bool ->
  RETURN (((s != NIL) AND (s? IS_A StructSchema)) OR ((s != NIL) AND (s? IS_A ResourceSchema)));
END
# End Ruby module Schemas
FN castSchemasUnionSchemaVariantInputToOptionalSchemasUnionSchemaVariantValue(value: SchemasUnionSchemaVariantInput) RETURNS ?SchemasUnionSchemaVariantValue ->
  PARTIAL MATCH value START
    SchemasUnionSchemaVariantInput.FunctionType AS cast_payload -> RETURN SchemasUnionSchemaVariantValue{ FunctionType: COPY cast_payload };,
    SchemasUnionSchemaVariantInput.TypeMultiowned AS cast_payload -> RETURN SchemasUnionSchemaVariantValue{ TypeMultiowned: COPY cast_payload };,
    SchemasUnionSchemaVariantInput.SymbolValue AS cast_payload -> RETURN SchemasUnionSchemaVariantValue{ SymbolValue: COPY cast_payload };,
    SchemasUnionSchemaVariantInput.StringValue AS cast_payload -> RETURN SchemasUnionSchemaVariantValue{ StringValue: COPY cast_payload };,
    SchemasUnionSchemaVariantInput.InlineStructVariantMultiowned AS cast_payload -> RETURN SchemasUnionSchemaVariantValue{ InlineStructVariantMultiowned: COPY cast_payload };,
    SchemasUnionSchemaVariantInput.Type AS cast_payload -> RETURN SchemasUnionSchemaVariantValue{ Type: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to ?SchemasUnionSchemaVariantValue");
  END
  panic("Invalid cast to ?SchemasUnionSchemaVariantValue");
END
