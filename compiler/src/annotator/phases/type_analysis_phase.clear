PUB FN annotationTypeInventory__initialize(MUTABLE self: AnnotationTypeInventory, typed_node_count: Int64, violations: []Violation) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.typed_node_count = COPY typed_node_count;
    rtoc_self_view.violations = COPY violations;
}
END
PUB FN annotationTypeInventory__unresolved_node_count(self: AnnotationTypeInventory) RETURNS Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN rtoc_self_view.violations.length();
}
END
PUB FN annotationTypeInventory__verify_resolved_mut(MUTABLE self: AnnotationTypeInventory) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (rtoc_self_view.violations.length() == 0) THEN
      RETURN;
    END
    MUTABLE sample = (rtoc_self_view.violations[0..<min(20, rtoc_self_view.violations.length())] |> SELECT "  - ${_.class_name} @ ${_.location}: ${_.type_name}").join("\n");
    MUTABLE more: String = "";
    IF (rtoc_self_view.violations.length() > 20) THEN
      more = "\n  ... (+${(rtoc_self_view.violations.length() - 20).toString()} more)";
    ELSE
      more = "";
    END
    panic("annotation boundary has unresolved AST type facts:\\n{}{}");
}
END
PUB FN annotationTypeInventory__scan(program: Program) RETURNS !AnnotationTypeInventory@multiowned ->
  MUTABLE ignored_node_ids = TRY (annotationTypeInventory__ignored_node_ids(program));
  MUTABLE typed_node_count = 0;
  MUTABLE violations: []Violation = ( { MUTABLE rtoc_empty_list_1: []Violation = List[]; rtoc_empty_list_1 } );
  aST__each_locatable(Locatable{ Program: COPY program }, TRUE, %(MUTABLE node: Locatable) USE(ignored_node_ids, MUTABLE violations, MUTABLE typed_node_count) -> {
  IF ignored_node_ids.contains?(aST__node_identity(node)) THEN
      RETURN;
  END
  MUTABLE node_type = TRY (annotationTypeInventory__node_type(&node));
  IF (type__untyped?(node_type) OR type__auto?(node_type)) THEN
      &violations.append(Violation{ class_name: COPY annotationTypeInventory__class_name(node), location: COPY annotationTypeInventory__location(node), type_name: COPY type__to_s(node_type) });
  ELSE
      typed_node_count = (typed_node_count + 1);
  END
  rubyToClearVoid__type_analysis_phase()
  });
  RETURN annotationTypeInventory__new(typed_node_count, violations);
END
PRIVATE FN annotationTypeInventory__ignored_node_ids(program: Program) RETURNS ![Set]Int64 ->
  MUTABLE ignored: [Set]Int64 = Set[];
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < program.statements.length() DO
    IF !((UNWRAP (program.statements[rtoc_idx]) IS_A FunctionDef OR UNWRAP (program.statements[rtoc_idx]) IS_A ExternFnDecl)) THEN
      rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    annotationTypeInventory__add_lifetime_metadata_node_ids_mut(&ignored, (IF locatable__return_lifetime(UNWRAP (program.statements[rtoc_idx])) EXISTS AS rtoc_lifetime THEN castClearParserReturnLifetimeToAnnotatorPhasesAnnotationTypeInventoryLifetimeMetadata(rtoc_lifetime) ELSE NIL END));
  rtoc_idx = rtoc_idx + 1;
  END
  RETURN ignored;
END
PRIVATE FN annotationTypeInventory__add_lifetime_metadata_node_ids_mut(MUTABLE ignored: [Set]Int64, value: ?AnnotatorPhasesAnnotationTypeInventoryLifetimeMetadata) RETURNS Void EFFECTS REENTRANT ->
  IF castAnnotatorPhasesAnnotationTypeInventoryLifetimeMetadataToLocatable(UNWRAP (value)) EXISTS AS rtoc_metadata_node THEN
    aST__each_locatable(rtoc_metadata_node, TRUE, %(node: Locatable) USE(MUTABLE ignored) -> {
  &ignored.insert(aST__node_identity(node));
  rubyToClearVoid__type_analysis_phase()
    });
  ELSE_IF UNWRAP (value) IS_A ArrayValue AS array THEN
    MUTABLE array_mutable = COPY array;
    FOR _ IN array_mutable DO
    annotationTypeInventory__add_lifetime_metadata_node_ids_mut(&ignored, castAnnotatorPhasesAnnotationTypeInventoryLifetimeMetadataArrayItemToOptionalAnnotatorPhasesAnnotationTypeInventoryLifetimeMetadata(_));
    END
  END
END
PRIVATE FN annotationTypeInventory__node_type(MUTABLE node: Locatable) RETURNS !Type ->
  IF !(locatable__typed?(node)) THEN
    RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :Untyped }));
  END
  RETURN TRY (aST__full_type_mut(node));
END
PRIVATE FN annotationTypeInventory__class_name(node: Locatable) RETURNS String ->
  RETURN locatable__variant_name(node);
END
PRIVATE FN annotationTypeInventory__location(node: Locatable) RETURNS String ->
  MUTABLE token: ?Token = locatable__token(node);
  IF !(token) THEN
    RETURN "?";
  END
  RETURN "${(token.line).toString()}:${token.column.toString()}";
END
PUB FN annotationTypeInventory__new(typed_node_count: Int64, violations: []Violation) RETURNS AnnotationTypeInventory@multiowned ->
  MUTABLE self = AnnotationTypeInventory{ typed_node_count: typed_node_count, violations: List[] };
  annotationTypeInventory__initialize(&self, typed_node_count, violations);
  RETURN self @multiowned;
END
PUB FN typeAnalysisPhase__run(resolution: ResolutionFacts, MUTABLE session: TypeAnalysisSession) RETURNS !TypeAnalysisHandoff ->
  RETURN TRY (typeAnalysisSession__execute_type_analysis_mut(&session, resolution));
END
