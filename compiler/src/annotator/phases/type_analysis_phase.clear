# A return lifetime is a symbol or a list of nodes; the metadata union spells
# the same two cases with its own item type.
FN castClearParserReturnLifetimeToAnnotatorPhasesAnnotationTypeInventoryLifetimeMetadata(value: ClearParserReturnLifetime) RETURNS ?AnnotatorPhasesAnnotationTypeInventoryLifetimeMetadata ->
  PARTIAL MATCH value START
    ClearParserReturnLifetime.SymbolValue AS item -> RETURN AnnotatorPhasesAnnotationTypeInventoryLifetimeMetadata{ SymbolValue: COPY item };,
    ClearParserReturnLifetime.ArrayValue AS item -> RETURN AnnotatorPhasesAnnotationTypeInventoryLifetimeMetadata{ ArrayValue: COPY (item |> SELECT UNWRAP (castLocatableToAnnotatorPhasesAnnotationTypeInventoryLifetimeMetadataArrayItem(_))) };,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
