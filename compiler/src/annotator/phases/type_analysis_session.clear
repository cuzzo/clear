PRIVATE FN typeAnalysisSession__check_prefixed_int_range_mut(MUTABLE self: TypeAnalysisSession, node: Locatable, effective_type: ?TypeTypeInput) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF effective_type EXISTS AS effective_type_value THEN
      MUTABLE val: ?Int64 = typeAnalysisSession__integer_literal_range_value(&rtoc_self_view, node);
      IF val EXISTS AS val_value THEN
        MUTABLE literal_value = val_value;
        MUTABLE checked_type = COPY effective_type_value;
        MUTABLE t: ?String@symbol = TRY (typeAnalysisSession__integer_range_target_type(&rtoc_self_view, checked_type));
        IF t EXISTS AS t_value THEN
          MUTABLE type_sym = t_value;
          MUTABLE max: ?Int64 = type__integer_type_max(type_sym);
          IF max EXISTS AS max_value_2 THEN
            MUTABLE max_value = max_value_2;
            MUTABLE min = (type__integer_type_min(type_sym) OR_ELSE 0);
            IF ((literal_value < min) OR (literal_value > max_value)) THEN
              IF node IS_A Literal AS literal THEN
                MUTABLE rtoc_literal_slot = COPY literal;
                TRY (typeAnalysisSession__handle_prefixed_int_overflow_mut(&rtoc_self_view, &rtoc_literal_slot, literal_value, type_sym, min, max_value));
              ELSE
                TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY node }, TypeAnalysisCodeOrMessage{ SymbolValue: :INT_LITERAL_OVERFLOW }, [], CAST({:val: literal_value, :type: type_sym, :min: min, :max: max_value} AS {String@symbol}Any)));
              END
            END
          ELSE
            RETURN;
          END
        ELSE
          RETURN;
        END
      ELSE
        RETURN;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__integer_literal_range_value(MUTABLE self: TypeAnalysisSession, node: Locatable) RETURNS ?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node IS_A Literal AS literal THEN
      IF ((literal.type == :PREFIXED_INT) OR (literal.type == :INT64)) THEN
        IF literal.value EXISTS AS token_value THEN
          IF token_value IS_A Int64 AS int_value THEN
            RETURN COPY int_value;
          END
        END
        RETURN NIL;
      END
    END
    RETURN typeAnalysisSession__negative_integer_literal_range_value(&rtoc_self_view, node);
}
END
PRIVATE FN typeAnalysisSession__negative_integer_literal_range_value(MUTABLE self: TypeAnalysisSession, node: Locatable) RETURNS ?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(node IS_A UnaryOp) THEN
      RETURN NIL;
    END
    IF !((locatable__symbol_op(node) == :SUB)) THEN
      RETURN NIL;
    END
    MUTABLE lit: ?Locatable = aST__node_right(node);
    IF !(UNWRAP (lit) IS_A Literal) THEN
      RETURN NIL;
    END
    IF !(((UNWRAP (castLocatableToLiteral(UNWRAP (lit))).type == :INT64) OR (UNWRAP (castLocatableToLiteral(UNWRAP (lit))).type == :PREFIXED_INT))) THEN
      RETURN NIL;
    END
    RETURN (-tokenValue__to_f(UNWRAP (castLocatableToLiteral(UNWRAP (lit)))));
}
END
PRIVATE FN typeAnalysisSession__integer_range_target_type(MUTABLE self: TypeAnalysisSession, effective_type: TypeTypeInput) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE current_type = COPY effective_type;
    IF (IF current_type IS_A Type AS type THEN type__error_union?(type) ELSE FALSE END) THEN
      MUTABLE payload_type: !?Type = typeTypeInput__payload_type(current_type);
      IF !(payload_type) THEN
        RETURN NIL;
      END
      current_type = payload_type;
    END
    IF current_type IS_A Type AS type THEN
      RETURN type__resolved(type);
    ELSE_IF current_type IS_A String@symbol AS string_symbol THEN
      RETURN string_symbol;
    ELSE_IF current_type IS_A String AS string THEN
      RETURN symbol(string);
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__emit_protocol_projection_issue_mut(MUTABLE self: TypeAnalysisSession, node: Node, issue: ProtocolProjectionIssue) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE arguments = COPY issue.arguments;
    IF (issue.code == :GENERIC_PROJECTION_UNKNOWN_OWNER) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castNodeToLocatable(node)), TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_PROJECTION_UNKNOWN_OWNER }, [], CAST({:owner: UNWRAP (arguments[:owner]), :member: UNWRAP (arguments[:member])} AS {String@symbol}Any)));
    ELSE_IF (issue.code == :GENERIC_PROJECTION_NEEDS_PROTOCOL) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castNodeToLocatable(node)), TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_PROJECTION_NEEDS_PROTOCOL }, [], CAST({:owner: UNWRAP (arguments[:owner]), :member: UNWRAP (arguments[:member]), :protocol: UNWRAP (arguments[:protocol])} AS {String@symbol}Any)));
    ELSE_IF (issue.code == :GENERIC_UNKNOWN_ASSOCIATED_TYPE) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castNodeToLocatable(node)), TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_UNKNOWN_ASSOCIATED_TYPE }, [], CAST({:owner: UNWRAP (arguments[:owner]), :member: UNWRAP (arguments[:member]), :protocol: UNWRAP (arguments[:protocol]), :available: UNWRAP (arguments[:available])} AS {String@symbol}Any)));
    ELSE_IF (issue.code == :GENERIC_AMBIGUOUS_ASSOCIATED_TYPE) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castNodeToLocatable(node)), TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_AMBIGUOUS_ASSOCIATED_TYPE }, [], CAST({:owner: UNWRAP (arguments[:owner]), :member: UNWRAP (arguments[:member]), :protocols: UNWRAP (arguments[:protocols])} AS {String@symbol}Any)));
    ELSE
      panic("Unhandled protocol projection issue {}");
    END
}
END
PRIVATE FN typeAnalysisSession__validate_type_param_list_mut(MUTABLE self: TypeAnalysisSession, node: GenericDeclarationNode, type_params: []String, kind: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE seen = {};
    FOR _ IN type_params DO
    MUTABLE param_sym = symbol(_);
    IF seen[param_sym] THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castGenericDeclarationNodeToLocatable(node)), TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_DUP_TYPE_PARAM_KIND }, [], CAST({:param: _, :kind: kind, :name: aST__node_name(UNWRAP (castGenericDeclarationNodeToLocatable(node)))} AS {String@symbol}Any)));
    END
    IF genericAnalysis__builtin_types().contains?(param_sym) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castGenericDeclarationNodeToLocatable(node)), TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_TYPE_PARAM_SHADOWS }, [], CAST({:param: _} AS {String@symbol}Any)));
    END
    seen[param_sym] = TRUE;
    END
}
END
PRIVATE FN typeAnalysisSession__validate_type_annotation_mut(MUTABLE self: TypeAnalysisSession, node: AnnotationNode, MUTABLE type_obj: Type, is_param: Bool = FALSE) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF type__fn_type?(type_obj) THEN
      TRY (typeAnalysisSession__resolve_associated_projection_protocols_mut(&rtoc_self_view, node, &type_obj));
      RETURN;
    END
    TRY (typeAnalysisSession__resolve_associated_projection_protocols_mut(&rtoc_self_view, node, &type_obj));
    MUTABLE facts = TRY (typeAnalysisSession__type_annotation_facts(&rtoc_self_view, node, type_obj, is_param));
    TRY (typeAnalysisSession__validate_param_annotation_capabilities_mut(&rtoc_self_view, facts));
    TRY (typeAnalysisSession__validate_collection_annotation_capabilities_mut(&rtoc_self_view, facts));
    TRY (typeAnalysisSession__validate_collection_allocation_hint_mut(&rtoc_self_view, facts));
    TRY (typeAnalysisSession__validate_observable_annotation_capabilities_mut(&rtoc_self_view, facts));
    TRY (typeAnalysisSession__validate_shape_annotation_capabilities_mut(&rtoc_self_view, facts));
    TRY (typeAnalysisSession__validate_generic_annotation_mut(&rtoc_self_view, facts));
    NIL;
}
END
PRIVATE FN typeAnalysisSession__validate_collection_allocation_hint_mut(MUTABLE self: TypeAnalysisSession, facts: TypeAnnotationFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(TRY (type__preallocation_hint?(facts.type_obj))) THEN
      RETURN;
    END
    IF (!(facts.is_param) AND ((facts.node IS_A VarDecl OR facts.node IS_A BindExpr))) THEN
      RETURN;
    END
    TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castAnnotationNodeToLocatable(facts.node)), TypeAnalysisCodeOrMessage{ SymbolValue: :COLLECTION_HINT_VALUE_ONLY }));
}
END
PRIVATE FN typeAnalysisSession__type_annotation_facts(MUTABLE self: TypeAnalysisSession, node: AnnotationNode, type_obj: Type, is_param: Bool) RETURNS !TypeAnnotationFacts
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN TypeAnnotationFacts{ node: COPY node, type_obj: COPY type_obj, is_param: is_param, inner: CAST(COPY TRY (typeAnalysisSession__type_annotation_inner(&rtoc_self_view, type_obj)) AS Type), inner_array: (type__tense?(type_obj) AND (type__array?(TRY (type__tense_type(type_obj))) == TRUE)), fn_type_params: COPY TRY (typeAnalysisSession__current_function_type_params(&rtoc_self_view)) };
}
END
PRIVATE FN typeAnalysisSession__type_annotation_inner(MUTABLE self: TypeAnalysisSession, type_obj: Type) RETURNS !?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE inner = COPY type_obj;
    WHILE TRUE DO
      MUTABLE next_inner_branch_value: ?Type = NIL;
      IF type__error_union?(inner) THEN
        next_inner_branch_value = TRY (type__payload_type(inner));
      ELSE_IF type__optional?(inner) THEN
        next_inner_branch_value = TRY (type__wrapped_type(inner));
      ELSE
        next_inner_branch_value = NIL;
      END
      MUTABLE next_inner: ?Type = next_inner_branch_value;
      IF next_inner EXISTS AS next_inner_value THEN
        inner = next_inner_value;
      ELSE
        RETURN inner;
      END
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__validate_param_annotation_capabilities_mut(MUTABLE self: TypeAnalysisSession, facts: TypeAnnotationFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(facts.is_param) THEN
      RETURN;
    END
    MUTABLE type_obj = COPY facts.type_obj;
    MUTABLE has_ownership_cap = ([:multiowned, :split]).contains?(type__ownership(type_obj));
    MUTABLE primitive_atomic_param = (type__atomic?(type_obj) AND type__primitive?(type_obj));
    MUTABLE has_sync_cap = (((type__sync(type_obj) != NIL) AND !(primitive_atomic_param)) AND !(([:raw, :symbol, :c, :size]).contains?(type__sync(type_obj))));
    IF (has_ownership_cap OR has_sync_cap) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castAnnotationNodeToLocatable(facts.node)), TypeAnalysisCodeOrMessage{ SymbolValue: :FN_PARAM_NO_CAPABILITY }));
    END
}
END
PRIVATE FN typeAnalysisSession__validate_collection_annotation_capabilities_mut(MUTABLE self: TypeAnalysisSession, facts: TypeAnnotationFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE type_obj = COPY facts.type_obj;
    MUTABLE shape = COPY facts.inner;
    IF (type__split?(type_obj) AND !(TRY (type__stream?(type_obj)))) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castAnnotationNodeToLocatable(facts.node)), TypeAnalysisCodeOrMessage{ SymbolValue: :ATSPLIT_STREAM_ONLY }));
    END
    IF TRY (type__list_requires_array_shape?(shape)) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castAnnotationNodeToLocatable(facts.node)), TypeAnalysisCodeOrMessage{ SymbolValue: :COLLECTION_NEEDS_ARRAY_TYPE }, [], CAST({:cap: "@list", :example: "User[]@list or User[N]@list"} AS {String@symbol}Any)));
    END
    IF ((type__pool?(shape) AND !(type__array?(shape))) AND !(facts.inner_array)) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY UNWRAP (castAnnotationNodeToLocatable(facts.node)) }, TypeAnalysisCodeOrMessage{ SymbolValue: :COLLECTION_NEEDS_ARRAY_TYPE }, [], CAST({:cap: "@pool", :example: "User[]@pool or User[N]@pool"} AS {String@symbol}Any)));
    END
    IF ((type__set_collection?(shape) AND !(type__array?(shape))) AND !(facts.inner_array)) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY UNWRAP (castAnnotationNodeToLocatable(facts.node)) }, TypeAnalysisCodeOrMessage{ SymbolValue: :COLLECTION_NEEDS_ARRAY_TYPE }, [], CAST({:cap: "@set", :example: "String[]@set"} AS {String@symbol}Any)));
    END
    IF TRY (type__observable_array_without_set?(type_obj)) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY UNWRAP (castAnnotationNodeToLocatable(facts.node)) }, TypeAnalysisCodeOrMessage{ SymbolValue: :OBSERVABLE_REQUIRES_SET }));
    END
    MUTABLE payload = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_174: ?Type = NIL;
    IF type__map?(shape) THEN
      rtoc_ternary_value_174 = TRY (type__value_type(shape));
    ELSE
      rtoc_ternary_value_174 = TRY (type__element_type(shape));
    END
    rtoc_ternary_value_174? };
    IF (((TRUE) AND type__indirect?(payload)) AND type__primitive?(payload)) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY UNWRAP (castAnnotationNodeToLocatable(facts.node)) }, TypeAnalysisCodeOrMessage{ SymbolValue: :INDIRECT_ELEMENT_PRIMITIVE }, [], CAST({:type: type__resolved(payload)} AS {String@symbol}Any)));
    END
    IF (type__sharded?(type_obj) AND type__multiowned?(payload)) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(UNWRAP (castAnnotationNodeToLocatable(facts.node))), TypeAnalysisCodeOrMessage{ SymbolValue: :SHARDED_ELEMENT_REQUIRES_SHARED }, [], {:got: CAST(payload AS String)}));
    END
}
END
PRIVATE FN typeAnalysisSession__validate_observable_annotation_capabilities_mut(MUTABLE self: TypeAnalysisSession, facts: TypeAnnotationFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE offending_own: ?String@symbol = NIL;
    MUTABLE offending_sync: ?String@symbol = NIL;
    MUTABLE type_obj = COPY facts.type_obj;
    IF !((type__tense?(type_obj) AND type__observable?(type_obj))) THEN
      RETURN;
    END
    IF ((type__sync(type_obj) != NIL) AND !(([:raw, :symbol, :c, :size]).contains?(type__sync(type_obj)))) THEN
      offending_sync = type__sync(type_obj);
    END
    IF ([:multiowned, :shared, :split]).contains?(type__ownership(type_obj)) THEN
      offending_own = type__ownership(type_obj);
    END
    IF !((IF offending_sync != NIL THEN offending_sync ELSE offending_own END)) THEN
      RETURN;
    END
    MUTABLE labels = TRY (typeAnalysisSession__observable_capability_labels(&rtoc_self_view, offending_sync, offending_own));
    MUTABLE explain = typeAnalysisSession__observable_capability_explanation(&rtoc_self_view, offending_sync, offending_own);
    TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castAnnotationNodeToLocatable(facts.node)), TypeAnalysisCodeOrMessage{ SymbolValue: :OBSERVABLE_NOT_COMBINABLE }, [], CAST({:labels: labels.join(" / "), :explain: explain} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__observable_capability_labels(MUTABLE self: TypeAnalysisSession, offending_sync: ?String@symbol, offending_own: ?String@symbol) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE labels: []String = ( { MUTABLE rtoc_empty_list_175: []String = List[]; rtoc_empty_list_175 } );
    IF offending_sync EXISTS AS offending_sync_value THEN
      &labels.append("sync wrapper :${offending_sync_value}");
    END
    IF offending_own EXISTS AS offending_own_value THEN
      &labels.append("ownership wrapper :${offending_own_value}");
    END
    RETURN labels;
}
END
PRIVATE FN typeAnalysisSession__observable_capability_explanation(MUTABLE self: TypeAnalysisSession, offending_sync: ?String@symbol, offending_own: ?String@symbol) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF ((offending_sync != NIL) AND (offending_own != NIL)) THEN
      RETURN "The observable is already a lock-free single-producer accumulator (extra sync is redundant) AND its heap-pointer lifetime is owned by the producing scope (sharing it across owners would race the producer's `finish()` against the cleanup-side `wait(); destroy()`).";
    END
    IF offending_sync EXISTS AS offending_sync_value THEN
      RETURN "The observable is already a lock-free single-producer accumulator; layering :${offending_sync_value} on top would double-synchronize, and its guard semantics conflict with WITH VIEW (which is meant to be a non-blocking single-load).";
    END
    RETURN "The observable's heap-pointer lifetime is owned by the producing scope (the producer fiber's `defer ctx.acc.finish` plus the scope's `wait(); destroy()` cleanup assume exactly one owner). Sharing it via :${UNWRAP (offending_own)} would race the producer's lifetime against the destroy and corrupt the WaitGroup bridge.";
}
END
PRIVATE FN typeAnalysisSession__validate_shape_annotation_capabilities_mut(MUTABLE self: TypeAnalysisSession, facts: TypeAnnotationFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE type_obj = COPY facts.type_obj;
    IF type__soa_requires_fixed_array?(type_obj) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castAnnotationNodeToLocatable(facts.node)), TypeAnalysisCodeOrMessage{ SymbolValue: :SOA_NEEDS_FIXED_ARRAY }));
    END
    MUTABLE shard_count: ?Int64 = type__shard_count(type_obj);
    IF ((shard_count != NIL) AND (shard_count < 2)) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castAnnotationNodeToLocatable(facts.node)), TypeAnalysisCodeOrMessage{ SymbolValue: :SHARDED_NEEDS_2_PLUS }, [], CAST({:got: shard_count} AS {String@symbol}Any)));
    END
    IF (type__pool?(type_obj) AND !(type__fixed?(type_obj))) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY UNWRAP (castAnnotationNodeToLocatable(facts.node)) }, TypeAnalysisCodeOrMessage{ SymbolValue: :POOL_NEEDS_FIXED_CAPACITY }, [], CAST({:element: (IF TRY (type__element_type(type_obj)) != NIL THEN
        type__resolved( UNWRAP ((TRY (type__element_type( type_obj)))))
      ELSE
        NIL
      END)} AS {String@symbol}Any)));
    END
}
END
PRIVATE FN typeAnalysisSession__validate_generic_annotation_mut(MUTABLE self: TypeAnalysisSession, facts: TypeAnnotationFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF type__projection?(facts.inner) THEN
      TRY (typeAnalysisSession__validate_associated_projection_mut(&rtoc_self_view, facts.node, facts.inner));
      RETURN;
    END
    IF type__generic_instance?(facts.inner) THEN
      TRY (typeAnalysisSession__validate_generic_instance_annotation_mut(&rtoc_self_view, facts));
    ELSE
      TRY (typeAnalysisSession__validate_plain_type_annotation_mut(&rtoc_self_view, facts));
    END
}
END
PRIVATE FN typeAnalysisSession__validate_generic_instance_annotation_mut(MUTABLE self: TypeAnalysisSession, facts: TypeAnnotationFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE inner = COPY facts.inner;
    MUTABLE base_name = type__generic_base(inner);
    IF (base_name == :Id) THEN
      RETURN;
    END
    IF ((base_name == :Tuple) OR (base_name == :StreamStep)) THEN
      FOR _ IN (TRY (type__generic_args(inner))) DO
      TRY (typeAnalysisSession__validate_generic_type_arg_mut(&rtoc_self_view, facts, _));
      END
      RETURN;
    END
    MUTABLE schema: ?SchemaValue = TRY (typeAnalysisSession__annotation_schema_for_mut(&rtoc_self_view, facts.node, base_name));
    MUTABLE type_params = TRY (typeAnalysisSession__schema_type_params(&rtoc_self_view, schema));
    IF (type_params.length() == 0) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castAnnotationNodeToLocatable(facts.node)), TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_NOT_GENERIC }, [], CAST({:type: base_name} AS {String@symbol}Any)));
    END
    MUTABLE expected = type_params.length();
    MUTABLE actual = (TRY (type__generic_args(inner))).length();
    IF (actual != expected) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castAnnotationNodeToLocatable(facts.node)), TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_WRONG_ARG_COUNT }, [], CAST({:type: base_name, :expected: expected, :got: actual} AS {String@symbol}Any)));
    END
    FOR _ IN (TRY (type__generic_args(inner))) DO
    TRY (typeAnalysisSession__validate_generic_type_arg_mut(&rtoc_self_view, facts, _));
    END
    IF schema? IS_A StructSchema AS struct_schema THEN
      MUTABLE rtoc_gp_idx = 0;
      WHILE rtoc_gp_idx < struct_schema.generic_params.length() DO
        MUTABLE param: ?GenericParamDecl = struct_schema.generic_params[rtoc_gp_idx];
        MUTABLE argument: ?Type = (TRY (type__generic_args(inner)))[rtoc_gp_idx];
        IF ((param != NIL) AND (argument != NIL)) THEN
          TRY (typeAnalysisSession__validate_generic_argument_bounds_mut(&rtoc_self_view, facts.node, param, argument));
        END
        rtoc_gp_idx = rtoc_gp_idx + 1;
      END
    END
}
END
PRIVATE FN typeAnalysisSession__validate_generic_type_arg_mut(MUTABLE self: TypeAnalysisSession, facts: TypeAnnotationFacts, arg: Type) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF ((type__optional?(arg) OR type__error_union?(arg)) OR type__tense?(arg)) THEN
      MUTABLE wrapped: ?Type = (IF TRY (type__wrapped_type(arg)) != NIL THEN TRY (type__wrapped_type(arg)) ELSE UNWRAP (TRY (type__payload_type(arg))) END);
      TRY (typeAnalysisSession__validate_generic_type_arg_mut(&rtoc_self_view, facts, UNWRAP (wrapped)));
      RETURN;
    END
    IF type__array?(arg) THEN
      TRY (typeAnalysisSession__validate_generic_type_arg_mut(&rtoc_self_view, facts, UNWRAP (TRY (type__element_type(arg)))));
      RETURN;
    END
    IF type__projection?(arg) THEN
      TRY (typeAnalysisSession__validate_associated_projection_mut(&rtoc_self_view, facts.node, arg));
      RETURN;
    END
    IF type__map?(arg) THEN
      RETURN;
    END
    IF type__generic_instance?(arg) THEN
      IF ((type__generic_base(arg) == :Tuple) OR (type__generic_base(arg) == :StreamStep)) THEN
        FOR _ IN (TRY (type__generic_args(arg))) DO
        TRY (typeAnalysisSession__validate_generic_type_arg_mut(&rtoc_self_view, facts, _));
        END
        RETURN;
      END
      MUTABLE nested_schema: ?SchemaValue = CAST(TRY (typeAnalysisSession__lookup_type_schema(&rtoc_self_view, type__generic_base(arg))) AS ?SchemaValue);
      IF (nested_schema == NIL) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY UNWRAP (castAnnotationNodeToLocatable(facts.node)) }, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_UNKNOWN_TYPE_ARG }, [], CAST({:type: type__resolved(arg)} AS {String@symbol}Any)));
      END
      MUTABLE nested_params = TRY (typeAnalysisSession__schema_type_params(&rtoc_self_view, nested_schema));
      IF (nested_params.length() != (TRY (type__generic_args(arg))).length()) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY UNWRAP (castAnnotationNodeToLocatable(facts.node)) }, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_WRONG_ARG_COUNT }, [], CAST({:type: type__generic_base(arg), :expected: nested_params.length(), :got: (TRY (type__generic_args(arg))).length()} AS {String@symbol}Any)));
      END
      FOR _ IN (TRY (type__generic_args(arg))) DO
      TRY (typeAnalysisSession__validate_generic_type_arg_mut(&rtoc_self_view, facts, _));
      END
      RETURN;
    END
    IF genericAnalysis__builtin_types().contains?(type__resolved(arg)) THEN
      RETURN;
    END
    IF facts.fn_type_params.contains?(type__resolved(arg)) THEN
      RETURN;
    END
    MUTABLE arg_schema: ?SchemaValue = CAST(TRY (typeAnalysisSession__lookup_type_schema(&rtoc_self_view, type__resolved(arg))) AS ?SchemaValue);
    IF (arg_schema == NIL) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY UNWRAP (castAnnotationNodeToLocatable(facts.node)) }, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_UNKNOWN_TYPE_ARG }, [], CAST({:type: type__resolved(arg)} AS {String@symbol}Any)));
    END
    MUTABLE type_params = TRY (typeAnalysisSession__schema_type_params(&rtoc_self_view, arg_schema));
    IF (type_params.length() == 0) THEN
      RETURN;
    END
    MUTABLE params_hint = (type_params |> SELECT _.toString()).join(", ");
    TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY UNWRAP (castAnnotationNodeToLocatable(facts.node)) }, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_MISSING_TYPE_ARGS }, [], CAST({:type: type__resolved(arg), :type2: type__resolved(arg), :hint: params_hint} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__validate_plain_type_annotation_mut(MUTABLE self: TypeAnalysisSession, facts: TypeAnnotationFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE base_name = type__resolved(facts.inner);
    IF facts.fn_type_params.contains?(base_name) THEN
      RETURN;
    END
    MUTABLE schema: ?SchemaValue = CAST(TRY (typeAnalysisSession__lookup_type_schema(&rtoc_self_view, base_name)) AS ?SchemaValue);
    MUTABLE type_params = TRY (typeAnalysisSession__schema_type_params(&rtoc_self_view, schema));
    IF (type_params.length() == 0) THEN
      RETURN;
    END
    MUTABLE params_hint = (type_params |> SELECT _.toString()).join(", ");
    TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castAnnotationNodeToLocatable(facts.node)), TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_MISSING_TYPE_ARGS }, [], CAST({:type: base_name, :type2: base_name, :hint: params_hint} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__annotation_schema_for_mut(MUTABLE self: TypeAnalysisSession, node: AnnotationNode, base_name: String@symbol) RETURNS !?SchemaValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE schema: ?SchemaValue = CAST(TRY (typeAnalysisSession__lookup_type_schema(&rtoc_self_view, base_name)) AS ?SchemaValue);
    IF schema EXISTS AS schema_value THEN
      RETURN COPY schema_value;
    END
    MUTABLE tok: ?Token@multiowned = typeAnalysisSession__type_annotation_token(&rtoc_self_view, node);
    IF tok EXISTS AS tok_value THEN
      TRY (typeAnalysisSession__emit_typo_suggestion_mut(&rtoc_self_view, TypoToken{ TokenMultiowned: COPY tok_value }, CAST(base_name AS String), TRY (typeAnalysisSession__all_known_type_names(&rtoc_self_view)), "Unknown type '${base_name}'", "closest declared type", :type, TRUE));
    ELSE
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castAnnotationNodeToLocatable(node)), TypeAnalysisCodeOrMessage{ SymbolValue: :UNKNOWN_TYPE }, [], CAST({:name: base_name} AS {String@symbol}Any)));
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__type_annotation_token(MUTABLE self: TypeAnalysisSession, node: AnnotationNode) RETURNS ?Token
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN CAST(aST__node__token( UNWRAP (castAnnotationNodeToLocatable(node))) AS ?Token);
}
END
PRIVATE FN typeAnalysisSession__schema_type_params(MUTABLE self: TypeAnalysisSession, schema: ?SchemaValue) RETURNS ![]String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF schema EXISTS AS schema_value THEN
      RETURN schemaValue__type_params(schema_value);
    END
    RETURN CAST(( { MUTABLE rtoc_empty_list_176: []String@symbol = List[]; rtoc_empty_list_176 } ) AS []String@symbol);
}
END
PRIVATE FN typeAnalysisSession__infer_generic_type_args_mut(MUTABLE self: TypeAnalysisSession, node: GenericCallNode, signature: FunctionSignature, actual_args: []Locatable, type_params: []String@symbol) RETURNS !{String@symbol}GenericBinding
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE subst: {String@symbol}GenericBinding = {};
    MUTABLE rtoc_each_items_177 = (TRY (functionSignature__params(signature)));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_177.length() DO
      MUTABLE arg: ?Locatable = COPY actual_args[rtoc_idx];
      IF !(arg) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE param_type: ?Type = COPY rtoc_each_items_177[rtoc_idx]?.type;
      MUTABLE actual_type = TRY (aST__full_type_mut( arg));
      TRY (typeAnalysisSession__extract_type_bindings_mut(&rtoc_self_view, node, UNWRAP (param_type), actual_type, type_params, &subst));
    rtoc_idx = rtoc_idx + 1;
    END
    TRY (typeAnalysisSession__enforce_shared_family_call_sync_mut(&rtoc_self_view, node, signature, actual_args, type_params));
    FOR _ IN type_params DO
    IF !(subst.contains?(_)) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castGenericCallNodeToLocatable(node)), TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_FN_CANNOT_INFER }, [], CAST({:param: _, :fn: aST__node_name(UNWRAP (castGenericCallNodeToLocatable(node))), :type: _} AS {String@symbol}Any)));
    END
    TRY (typeAnalysisSession__validate_bound_types_mut(&rtoc_self_view, castGenericCallNodeToAnnotationNode(node), _, TRY (type__new(castGenericBindingToTypeConstructionInput(UNWRAP (subst[_])))), (signature.generic_bounds[_] OR_ELSE List[])));
    END
    RETURN subst;
}
END
PRIVATE FN typeAnalysisSession__validate_generic_argument_bounds_mut(MUTABLE self: TypeAnalysisSession, node: AnnotationNode, param: GenericParamDecl, argument: Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__validate_bound_types_mut(&rtoc_self_view, node, symbol(param.name), argument, ( { MUTABLE rtoc_map_results = CAST([] AS []Type); param.bounds |> EACH { &rtoc_map_results.append(COPY _.type); }; rtoc_map_results } )));
}
END
PRIVATE FN typeAnalysisSession__validate_bound_types_mut(MUTABLE self: TypeAnalysisSession, node: AnnotationNode, parameter: String@symbol, argument: Type, bounds: []Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < bounds.length() DO
      MUTABLE protocol = typeAnalysisSession__protocol_base_name(&rtoc_self_view, bounds[rtoc_idx]?);
      IF TRY (typeAnalysisSession__type_conforms_to_protocol?(&rtoc_self_view, argument, protocol)) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castAnnotationNodeToLocatable(node)), TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_PROTOCOL_BOUND_FAILED }, [], CAST({:parameter: parameter, :actual: TRY (type__surface_name(castTypeToTypeTypeInput__type_analysis_session(argument))), :protocol: protocol} AS {String@symbol}Any)));
    rtoc_idx = rtoc_idx + 1;
    END
    MUTABLE shared = bounds |> ANY type__polymorphic_shared?(_);
    IF ((shared AND !(type__shared?(argument))) AND !(TRY (typeAnalysisSession__generic_parameter_has_shared_map_bound?(&rtoc_self_view, type__resolved(argument))))) THEN
