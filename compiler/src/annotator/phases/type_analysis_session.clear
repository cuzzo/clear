      Locatable.TestBlock AS MUTABLE test_block -> TRY (typeAnalysisSession__visit_TestBlock(&rtoc_self_view, &test_block));,
      Locatable.WhenBlock AS MUTABLE when_block -> TRY (typeAnalysisSession__visit_WhenBlock(&rtoc_self_view, &when_block));,
      Locatable.TestThat AS MUTABLE test_that -> TRY (typeAnalysisSession__visit_TestThat(&rtoc_self_view, &test_that));,
      Locatable.AssertRaises AS MUTABLE assert_raises -> TRY (typeAnalysisSession__visit_AssertRaises(&rtoc_self_view, &assert_raises));,
      Locatable.BenchmarkStmt AS MUTABLE benchmark_stmt -> TRY (typeAnalysisSession__visit_BenchmarkStmt(&rtoc_self_view, &benchmark_stmt));,
      Locatable.SmashStmt AS MUTABLE smash_stmt -> TRY (typeAnalysisSession__visit_SmashStmt(&rtoc_self_view, &smash_stmt));,
      Locatable.ProfileStmt AS MUTABLE profile_stmt -> TRY (typeAnalysisSession__visit_ProfileStmt(&rtoc_self_view, &profile_stmt));,
      Locatable.StubDecl AS MUTABLE stub_decl -> TRY (typeAnalysisSession__visit_StubDecl(&rtoc_self_view, &stub_decl));,
      Locatable.DestructuringAssignment AS MUTABLE destructuring_assignment -> TRY (typeAnalysisSession__visit_DestructuringAssignment(&rtoc_self_view, &destructuring_assignment));,
      Locatable.UnionVariantLit AS MUTABLE union_variant_lit -> TRY (typeAnalysisSession__visit_UnionVariantLit(&rtoc_self_view, &union_variant_lit));,
      DEFAULT -> panic("BUG: no annotation visitor for {}");
    END
}
END
