    END
}
END
PRIVATE FN typeAnalysisSession__finalize_scope(MUTABLE self: TypeAnalysisSession, MUTABLE node: Locatable, branch: ?String@symbol = NIL) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE drops: []DeferredDrop = ( { MUTABLE rtoc_empty_list_485: []DeferredDrop = List[]; rtoc_empty_list_485 } );
    MUTABLE rtoc_each_items_486 = (TRY (typeAnalysisSession__current_scope(&rtoc_self_view))).owned_names;
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_486.length() DO
      MUTABLE info: ?SymbolEntry@multiowned = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_487 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
      scope__local_entry(rtoc_local_receiver_487, UNWRAP (rtoc_each_items_486[rtoc_idx])) };
      IF !(info) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE is_takes = (TRUE AND symbolEntry__takes( info));
      MUTABLE rtoc_graph_19752 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
      IF !(({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_488 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
      ownershipGraph__live?(rtoc_local_receiver_488, UNWRAP (rtoc_each_items_486[rtoc_idx])) } OR ((is_takes AND ((ownershipGraph__get_index(rtoc_graph_19752, UNWRAP (rtoc_each_items_486[rtoc_idx])) != NIL) AND ownershipNode__moved?(((ownershipGraph__get_index(rtoc_graph_19752, UNWRAP (rtoc_each_items_486[rtoc_idx])))?))))))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !(symbolEntry__ownership_kind( info)) THEN
          TRY (typeAnalysisSession__classify_ownership_mut(&rtoc_self_view, &info));
      END
      IF (symbolEntry__ownership_kind( info) == :resource) THEN
          &drops.append(TRY (typeAnalysisSession__deferred_drop_for(&rtoc_self_view, UNWRAP (rtoc_each_items_486[rtoc_idx]), info, TRUE)));
          TRY (typeAnalysisSession__og_drop(&rtoc_self_view, UNWRAP (rtoc_each_items_486[rtoc_idx])));
      ELSE_IF (symbolEntry__ownership_kind( info) == :affine) THEN
          MUTABLE t = TRY (type__new(TypeConstructionInput{ Type: COPY symbolEntry__type( info) }));
          IF (TRY (type__single_future?(t)) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_491 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
          ownershipGraph__live?(rtoc_local_receiver_491, UNWRAP (rtoc_each_items_486[rtoc_idx])) }) THEN
            TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY node }, TypeAnalysisCodeOrMessage{ SymbolValue: :PROMISE_NOT_CONSUMED }, [], CAST({:name: UNWRAP (rtoc_each_items_486[rtoc_idx])} AS {String@symbol}Any)));
          END
