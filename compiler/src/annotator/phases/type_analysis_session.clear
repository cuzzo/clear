    END
    IF node.target IS_A TenseNavigation THEN
      field_type = TRY (typeAnalysisSession__publish_tense_navigation_plan_mut(&rtoc_self_view, Locatable{ GetField: COPY node }, castLocatableToTenseNavigation__type_analysis_session(node.target), CAST(field_type AS Type)));
      IF locatable__safe_navigation?(node.target) THEN
        node.safe_nav_chain = TRUE;
      END
    END
    navigation = ((node.target IS_A OptionalUnwrap AND (locatable__safe_navigation?(node.target) OR_ELSE FALSE)) OR implicit_safe_nav);
    IF (navigation AND !(type__optional?(field_type))) THEN
      field_type = TRY (type__optional_of(TypeTypeInput{ Type: COPY field_type }));
      node.safe_nav_chain = TRUE;
    END
    RETURN TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ GetField: COPY node }, field_type));
}
END
PRIVATE FN typeAnalysisSession__emit_moved_field_path_error_if_needed_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: GetField) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE path = TRY (typeAnalysisSession__get_path_to_root(&rtoc_self_view, Node{ GetField: COPY node }));
    IF (path.length() == 0) THEN
      RETURN;
    END
    MUTABLE check: String = "";
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < path.length() DO
        IF (check.length() == 0) THEN
          check = COPY CAST(path[rtoc_idx]? AS String);
        ELSE
          check = "${check}.${path[rtoc_idx]?}";
        END
      IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_400 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
      ownershipGraph__moved?(rtoc_local_receiver_400, check) } THEN
          MUTABLE rtoc_graph_16153 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
          TRY (typeAnalysisSession__emit_use_of_moved_path_error_mut(&rtoc_self_view, &node, castStringListToNameCandidateList(path), ownershipGraph__get_index(rtoc_graph_16153, check)));
          BREAK;
      END
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PRIVATE FN typeAnalysisSession__emit_capability_field_access_error_if_needed_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: GetField) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(node.target IS_A Identifier) THEN
      RETURN;
    END
    IF node.is_assignment_lhs THEN
      RETURN;
    END
    MUTABLE sym: ?SymbolEntry@multiowned = locatable__symbol(node.target);
    MUTABLE in_auto_lock = (typeAnalysisSession__phase_traversal_state(&rtoc_self_view).auto_locked_assign_name == aST__node_name(node.target));
    MUTABLE in_with_block = typeAnalysisSession__inside_with_block?(&rtoc_self_view);
    MUTABLE cap_error = ([[(IF sym != NIL THEN
      symbolEntry__locked?(sym)
    ELSE
      NIL
    END), :CAP_FIELD_NEEDS_WITH_EXCLUSIVE, "EXCLUSIVE", "@locked"], [(IF sym != NIL THEN
      symbolEntry__write_locked?(UNWRAP (sym))
    ELSE
      NIL
    END), :CAP_FIELD_NEEDS_WITH_EXCLUSIVE, "EXCLUSIVE", "@writeLocked"], [(IF sym != NIL THEN
      symbolEntry__atomic_ptr?(UNWRAP (sym))
    ELSE
      NIL
    END), :CAP_FIELD_NEEDS_WITH_SNAPSHOT, "SNAPSHOT", "@boxed:atomic"]]) |> FIND _[0];
    IF ((cap_error AND !(in_auto_lock)) AND !(in_with_block)) THEN
      TRY (typeAnalysisSession__emit_cap_field_needs_with_mut(&rtoc_self_view, &node, cap_error[1], node.target.name(), node.field, cap_error[3], cap_error[2]));
    END
}
END
PRIVATE FN typeAnalysisSession__visit_Slice(MUTABLE self: TypeAnalysisSession, MUTABLE node: Slice) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.target));
    IF node.start THEN
      TRY (typeAnalysisSession__visit(&rtoc_self_view, node.start));
    END
    IF node.end THEN
      TRY (typeAnalysisSession__visit(&rtoc_self_view, node.end));
    END
    MUTABLE target_type = TRY (aST__full_type_mut(node.target));
    MUTABLE target_type_value = target_type;
    IF TRUE THEN
      IF type__array?(target_type_value) THEN
      MUTABLE element: ?Type = TRY (type__element_type(target_type));
      MUTABLE slice_type = TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("${type__resolved(UNWRAP (element))}[]") }));
      TRY (type__set_elem_ownership(&slice_type, type__ownership( UNWRAP (element))));
      TRY (type__set_elem_sync(&slice_type, type__sync(UNWRAP (element))));
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ Slice: COPY node }, slice_type));
      node.container_borrow = TRUE;
    ELSE
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ Slice: COPY node }, :Any));
    END
    END
}
END
PRIVATE FN typeAnalysisSession__visit_HashLit(MUTABLE self: TypeAnalysisSession, MUTABLE node: HashLit) RETURNS !Void
