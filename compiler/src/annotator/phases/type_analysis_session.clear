PRIVATE FN typeAnalysisSession__enforce_shared_family_call_sync_mut(MUTABLE self: TypeAnalysisSession, node: GenericCallNode, signature: FunctionSignature, actual_args: []Locatable, type_params: []String@symbol) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE shared_args: []SharedGenericArg = ( { MUTABLE rtoc_empty_list_182: []SharedGenericArg = List[]; rtoc_empty_list_182 } );
    MUTABLE rtoc_each_items_183 = (TRY (functionSignature__params(signature)));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_183.length() DO
      MUTABLE arg: ?Locatable = COPY actual_args[rtoc_idx];
      IF !(arg) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE param_type: ?Type = COPY rtoc_each_items_183[rtoc_idx]?.type;
      IF !((typeAnalysisSession__generic_shared_family_param?(&rtoc_self_view, UNWRAP (param_type)) AND type_params.contains?(type__resolved( UNWRAP (param_type))))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE actual_type = TRY (aST__full_type_mut( arg));
      IF !(type__shared?(actual_type)) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      &shared_args.append(SharedGenericArg{ name: COPY (UNWRAP (rtoc_each_items_183[rtoc_idx])).name, type: CAST(COPY TRY (typeAnalysisSession__generic_shared_payload_binding(&rtoc_self_view, actual_type)) AS Type) });
    rtoc_idx = rtoc_idx + 1;
    END
    IF (shared_args.length() < 2) THEN
      RETURN;
    END
    MUTABLE first: ?SharedGenericArg = COPY shared_args.first();
    IF first EXISTS AS first_value THEN
      MUTABLE mismatch: ?SharedGenericArg = shared_args |> FIND !(typeAnalysisSession__same_shared_call_capability?(&rtoc_self_view, first_value.type, _.type));
      IF mismatch EXISTS AS mismatch_value THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(UNWRAP (castGenericCallNodeToLocatable(node))), TypeAnalysisCodeOrMessage{ SymbolValue: :POLY_SHARED_INCONSISTENT }, [], CAST({:fn: genericCallNode__name(node), :first: first_value.name, :first_cap: typeAnalysisSession__shared_call_capability_display(&rtoc_self_view, first_value.type), :second: mismatch_value.name, :second_cap: typeAnalysisSession__shared_call_capability_display(&rtoc_self_view, mismatch_value.type)} AS {String@symbol}Any)));
      ELSE
        RETURN;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__extract_type_bindings_mut(MUTABLE self: TypeAnalysisSession, node: GenericCallNode, param_type: Type, actual_type: Type, type_params: []String@symbol, MUTABLE subst: {String@symbol}GenericBinding) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE p_res = type__resolved(param_type);
    MUTABLE a_res = type__resolved(actual_type);
    IF (type__fn_type?(param_type) AND type__fn_type?(actual_type)) THEN
      MUTABLE param_fn: ?FunctionType = type__function_type(param_type);
      MUTABLE actual_fn: ?FunctionType = type__function_type(actual_type);
      IF param_fn EXISTS AS param_fn_value THEN
        IF actual_fn EXISTS AS actual_fn_value THEN
          MUTABLE rtoc_zip_i = 0;
          WHILE rtoc_zip_i < param_fn_value.params.length() DO
            MUTABLE p_param: ?FunctionTypeParam = COPY param_fn_value.params[rtoc_zip_i];
            MUTABLE a_param: ?FunctionTypeParam = COPY actual_fn_value.params[rtoc_zip_i];
            IF p_param EXISTS AS rtoc_pp THEN
              IF a_param EXISTS AS rtoc_ap THEN
                TRY (typeAnalysisSession__extract_type_bindings_mut(&rtoc_self_view, node, rtoc_pp.type, rtoc_ap.type, type_params, &subst));
              END
            END
            rtoc_zip_i = rtoc_zip_i + 1;
          END
          TRY (typeAnalysisSession__extract_type_bindings_mut(&rtoc_self_view, node, param_fn_value.return_type, UNWRAP (actual_fn).return_type, type_params, &subst));
        ELSE
          RETURN;
        END
      ELSE
        RETURN;
      END
    ELSE_IF type_params.contains?(p_res) THEN
      MUTABLE actual_binding_branch_value: ?Type@multiowned = NIL;
      IF (typeAnalysisSession__generic_shared_family_param?(&rtoc_self_view, param_type) AND type__shared?(actual_type)) THEN
        actual_binding_branch_value = TRY (typeAnalysisSession__generic_shared_payload_binding(&rtoc_self_view, actual_type));
      ELSE
        actual_binding_branch_value = TRY (typeAnalysisSession__generic_binding_value(&rtoc_self_view, actual_type));
      END
      MUTABLE actual_binding: Type@multiowned = actual_binding_branch_value?;
      MUTABLE existing: ?GenericBinding = COPY subst[p_res];
      IF ((existing != NIL) AND !(TRY (typeAnalysisSession__same_generic_binding?(&rtoc_self_view, existing, GenericBinding{ TypeMultiowned: COPY actual_binding })))) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castGenericCallNodeToLocatable(node)), TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_FN_CONFLICT }, [], CAST({:param: p_res, :fn: genericCallNode__name(node), :first: TRY (typeAnalysisSession__generic_binding_source(&rtoc_self_view, existing)), :second: TRY (typeAnalysisSession__generic_binding_source(&rtoc_self_view, GenericBinding{ TypeMultiowned: COPY actual_binding }))} AS {String@symbol}Any)));
      END
      subst[p_res] = GenericBinding{ TypeMultiowned: COPY actual_binding };
    ELSE_IF ((type__generic_instance?(param_type) AND type__generic_instance?(actual_type)) AND (type__generic_base(param_type) == type__generic_base(actual_type))) THEN
      MUTABLE rtoc_p_args = TRY (type__generic_args(param_type));
      MUTABLE rtoc_a_args = TRY (type__generic_args(actual_type));
      MUTABLE rtoc_arg_i = 0;
      WHILE rtoc_arg_i < rtoc_p_args.length() DO
        MUTABLE p_arg: ?Type = COPY rtoc_p_args[rtoc_arg_i];
        MUTABLE a_arg: ?Type = COPY rtoc_a_args[rtoc_arg_i];
        IF p_arg EXISTS AS rtoc_pa THEN
          IF a_arg EXISTS AS rtoc_aa THEN
            TRY (typeAnalysisSession__extract_type_bindings_mut(&rtoc_self_view, node, rtoc_pa, rtoc_aa, type_params, &subst));
          END
        END
        rtoc_arg_i = rtoc_arg_i + 1;
      END
    END
}
END
PRIVATE FN typeAnalysisSession__apply_type_subst(MUTABLE self: TypeAnalysisSession, type_obj: TypeTypeInput, subst: {String@symbol}GenericBinding) RETURNS !Type
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE t = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_185: ?TypeTypeInput = NIL;
    IF type_obj IS_A Type THEN
      rtoc_ternary_value_185 = COPY type_obj;
    ELSE
      rtoc_ternary_value_185 = TRY (type__new(castTypeTypeInputToTypeConstructionInput__type_analysis_session(type_obj)));
    END
    rtoc_ternary_value_185? };
    IF typeTypeInput__fn_type?(t) THEN
      MUTABLE fn_type: ?FunctionType = type__function_type(UNWRAP (castTypeTypeInputToType(t)));
      IF !(fn_type) THEN
        RETURN UNWRAP (castTypeTypeInputToType(t));
      END
      MUTABLE params = fn_type.params |> SELECT FunctionTypeParam{ type: CAST(COPY TRY (typeAnalysisSession__apply_type_subst(&rtoc_self_view, TypeTypeInput{ Type: COPY _.type }, subst)) AS Type), mutable: FALSE };
      RETURN TRY (type__new(TypeConstructionInput{ FunctionType: COPY FunctionType{ params: COPY params, return_type: CAST(COPY typeAnalysisSession__apply_type_subst(&rtoc_self_view, TypeTypeInput{ Type: COPY fn_type.return_type }, subst) AS Type), reentrant: (fn_type).reentrant, source_signature: COPY fn_type.source_signature, abi: COPY fn_type.abi } }));
    ELSE
      RETURN TRY (type__new(TypeConstructionInput{ TypeExpression: COPY TRY (typeAnalysisSession__apply_expression_subst(&rtoc_self_view, UNWRAP (typeTypeInput__shape(t)).expression, subst)) }));
    END
}
END
PRIVATE FN typeAnalysisSession__apply_expression_subst(MUTABLE self: TypeAnalysisSession, expression: TypeExpression, subst: {String@symbol}GenericBinding) RETURNS !TypeExpression
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE kind = COPY expression.kind;
    MUTABLE cap = COPY expression.capabilities;
    IF (kind IS_A NamedTypeExpression) THEN
      IF (UNWRAP (typeExpressionKind__arguments(kind)).empty?() AND subst.contains?(UNWRAP (typeExpressionKind__name(kind)))) THEN
        MUTABLE replacement = TRY (type__new(castOptionalGenericBindingToTypeConstructionInput(subst[UNWRAP (typeExpressionKind__name(kind))])));
        IF (type__generic_payload_type_arg?(replacement) AND !(cap.polymorphic_shared)) THEN
          TRY (type__strip_runtime_capabilities_mut(&replacement));
        END
        MUTABLE parameter = TRY (type__new(TypeConstructionInput{ TypeExpression: COPY expression }));
        IF typeAnalysisSession__generic_type_has_capabilities?(&rtoc_self_view, parameter) THEN
          TRY (type__merge_capabilities_from_mut(&replacement, parameter));
        END
        RETURN COPY replacement.shape.expression;
      END
      RETURN TypeExpression{ kind: TypeExpressionKind{ NamedTypeExpression: COPY NamedTypeExpression{ name: COPY UNWRAP (typeExpressionKind__name(kind)), arguments: COPY (typeExpressionKind__arguments(kind) OR_ELSE List[]) |> SELECT typeAnalysisSession__apply_expression_subst(&rtoc_self_view, _, subst)  } }, capabilities: COPY cap };
    ELSE_IF (kind IS_A TypeProjectionExpression) THEN
      MUTABLE binding: ?GenericBinding = COPY subst[UNWRAP (typeExpressionKind__owner(kind))];
      IF binding EXISTS AS binding_value THEN
        MUTABLE concrete = TRY (type__new(castGenericBindingToTypeConstructionInput(binding_value)));
        MUTABLE projected: ?Type = NIL;
        IF (typeExpressionKind__member(kind) == :Key) THEN
          IF ((((typeExpressionKind__protocol(kind) == NIL) OR (typeExpressionKind__protocol(kind) == :Map))) AND type__map?(concrete)) THEN
            projected = TRY (type__key_type(concrete));
          END
        ELSE_IF (typeExpressionKind__member(kind) == :Value) THEN
          IF ((((typeExpressionKind__protocol(kind) == NIL) OR (typeExpressionKind__protocol(kind) == :Map))) AND type__map?(concrete)) THEN
            projected = TRY (type__value_type(concrete));
          END
        END
        IF (((projected == NIL) AND typeExpressionKind__protocol(kind)) AND (typeExpressionKind__protocol(kind) != :Map)) THEN
          MUTABLE match: ?ConformanceMatch = TRY (typeAnalysisSession__conformance_match(&rtoc_self_view, CAST(typeExpressionKind__protocol(kind) AS String), concrete));
          IF match EXISTS AS match_value THEN
            MUTABLE associated: ?Type = COPY match_value.resolution.associated_types[UNWRAP (typeExpressionKind__member(kind))];
            IF associated EXISTS AS associated_value THEN
              projected = CAST(TRY (typeAnalysisSession__apply_type_subst(&rtoc_self_view, castTypeToTypeTypeInput__type_analysis_session(associated_value), castMapTypeToMapGenericBinding(match_value.substitutions))) AS ?Type);
            END
          END
        END
        IF projected EXISTS AS projected_value THEN
          RETURN typeExpressionTree__with_root_capabilities(projected_value.shape.expression, cap);
        ELSE
          RETURN TypeExpression{ kind: TypeExpressionKind{ TypeProjectionExpression: COPY TypeProjectionExpression{ owner: COPY type__resolved(concrete), member: COPY UNWRAP (typeExpressionKind__member(kind)), protocol: COPY typeExpressionKind__protocol(kind) } }, capabilities: COPY cap };
        END
      ELSE
        RETURN COPY expression;
      END
    ELSE_IF (kind IS_A FunctionTypeExpression) THEN
      MUTABLE signature = TRY (type__function_type_for_expression(UNWRAP (castTypeExpressionKindToFunctionTypeExpression(kind))));
      RETURN TypeExpression{ kind: COPY type__function_type_expression_for(FunctionType{ params: COPY signature.params |> SELECT FunctionTypeParam{ type: CAST(COPY TRY (typeAnalysisSession__apply_type_subst(&rtoc_self_view, castTypeToTypeTypeInput__type_analysis_session(_.type), subst)) AS Type), mutable: FALSE }, return_type: CAST(COPY TRY (typeAnalysisSession__apply_type_subst(&rtoc_self_view, castTypeToTypeTypeInput__type_analysis_session(signature.return_type), subst)) AS Type), reentrant: signature.reentrant, source_signature: COPY signature.source_signature, abi: COPY signature.abi }), capabilities: COPY cap };
    ELSE_IF kind IS_A TupleTypeExpression AS rtoc_tuple_type_expression THEN
      RETURN TypeExpression{ kind: TypeExpressionKind{ TupleTypeExpression: COPY TupleTypeExpression{ items: COPY rtoc_tuple_type_expression.items |> SELECT typeAnalysisSession__apply_expression_subst(&rtoc_self_view, _, subst)  } }, capabilities: COPY cap };
    ELSE_IF kind IS_A OptionalTypeExpression AS rtoc_optional_type_expression THEN
      RETURN TypeExpression{ kind: TypeExpressionKind{ OptionalTypeExpression: COPY OptionalTypeExpression{ inner: COPY typeAnalysisSession__apply_expression_subst(&rtoc_self_view, rtoc_optional_type_expression.inner, subst)  } }, capabilities: COPY cap };
    ELSE_IF (kind IS_A FallibleTypeExpression) THEN
