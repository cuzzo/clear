    MUTABLE ti = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_517: ?TypeTypeInput = NIL;
    IF type_info IS_A Type THEN
      rtoc_ternary_value_517 = COPY type_info;
