    MUTABLE entry: ?SymbolEntry@multiowned = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_257 = typeAnalysisSession__semantic_root_scope(&rtoc_self_view);
    scope__local_entry(rtoc_local_receiver_257, fn_value.name) };
    IF entry EXISTS AS entry_value THEN
      MUTABLE entry_value_mutable = COPY entry_value;
      TRY (symbolEntry__set_type(&entry_value_mutable, castTypeToOptionalSymbolEntryTypeInput__type_analysis_session(TRY (type__from_function_signature(signature)))));
