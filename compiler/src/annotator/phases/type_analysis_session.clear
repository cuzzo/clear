    IF TRUE THEN
      IF type__error_union?(lhs_t_value) THEN
      MUTABLE fallback_type: Type = TRY (aST__full_type_mut(UNWRAP (locatable__default_expr(node.right))));
      MUTABLE plan = TRY (tenseOperationPlanner__or_else(lhs_t, fallback_type, TenseOperationKind.OrElseValue, TenseRecovery.Fallback));
      node.tense_plan = TensePlanValue{ TenseOperationPlan: COPY plan };
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY node }, plan.result_type));
    ELSE
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY node }, lhs_type));
    END
    END
    node.storage_override = :stack;
    RETURN :stack;
}
