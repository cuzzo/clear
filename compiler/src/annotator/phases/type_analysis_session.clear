WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE conc = castLocatableToConcurrentOp__type_analysis_session(COPY node.right);
    MUTABLE each_op: ?ClearParserConcurrentPipelineOp = conc.op;
    MUTABLE ti = TRY (aST__full_type_mut( UNWRAP (shard_node.target_map)));
    MUTABLE key_type: String@symbol = (IF type__numeric_map?(ti) THEN type__resolved(TRY (type__key_type(ti))) ELSE :String END);
    typeAnalysisSession__with_new_scope(&rtoc_self_view, NIL, %() USE(each_op, key_type, MUTABLE rtoc_self_view) -> {
    MUTABLE rtoc_mutable_receiver_148 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
    TRY (scope__declare(&rtoc_mutable_receiver_148, "_", NIL, SymbolEntryTypeInput{ SymbolValue: COPY key_type }, ScopeMutabilityInput{ BoolValue: TRUE }, FALSE, NIL, :stack));
    FOR _ IN clearParserConcurrentPipelineOp__body(UNWRAP (each_op)) DO
    TRY (typeAnalysisSession__visit(&rtoc_self_view, _));
    END
    NIL
    });
    MUTABLE ctx: ?PipelineShardContext = conc.shard_context;
    IF ctx THEN
      conc.shard_context = COPY pipelineShardContext__with_frame_allocations((CAST(ctx AS PipelineShardContext)), FALSE, FALSE);
    END
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY node }, :Void));
    node.storage_override = :stack;
    RETURN :stack;
}
END
PRIVATE FN typeAnalysisSession__emit_multi_map_warning(MUTABLE self: TypeAnalysisSession, conc: ConcurrentOp, sharded_names: [Set]String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_counts: []Int64 = List[];
    FOR _ IN sharded_names DO
      MUTABLE sc: ?Type@multiowned = NIL;
      IF TRY (typeAnalysisSession__lookup_scope_for(&rtoc_self_view, _)) EXISTS AS rtoc_scope_150 THEN
        IF scope__resolve_entry(rtoc_scope_150, _) EXISTS AS rtoc_entry_150 THEN
          sc = COPY symbolEntry__type(rtoc_entry_150);
        END
      END
      IF sc EXISTS AS rtoc_sc_value THEN
        IF type__shard_count(rtoc_sc_value) EXISTS AS rtoc_count_value THEN
          &rtoc_counts.append(rtoc_count_value);
        END
      END
    END
    MUTABLE shard_counts = rtoc_counts |> DISTINCT _ |> SELECT COPY _;
    MUTABLE names_str = (sharded_names |> SELECT COPY _).join(", ");
    IF ((shard_counts).length() == 1) THEN
      typeAnalysisSession__note_mut(&rtoc_self_view, Locatable{ ConcurrentOp: COPY conc }, "CONCURRENT EACH accesses ${sharded_names.length().toString()} @sharded maps (${names_str}). Co-located (same shard count ${UNWRAP (shard_counts.first()).toString()}), but auto-sharding requires a single map. Use explicit SHARD() or @sharded(N):locked.");
    ELSE
      typeAnalysisSession__note_mut(&rtoc_self_view, Locatable{ ConcurrentOp: COPY conc }, "CONCURRENT EACH accesses @sharded maps with different shard counts (${names_str}). Cross-shard routing is likely \u{2014} consider @sharded(N):locked.");
    END
}
END
PRIVATE FN typeAnalysisSession__collect_sharded_names(MUTABLE self: TypeAnalysisSession, node: ?ShardScanNode, MUTABLE names: [Set]String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__each_shard_scan_node(rtoc_self_view, node, %(n: Locatable) USE(MUTABLE names, MUTABLE rtoc_self_view) -> {
    IF (IF n IS_A Identifier AS identifier THEN TRY (typeAnalysisSession__sharded_unsynced_identifier?(&rtoc_self_view, identifier)) ELSE FALSE END) THEN
        &names.insert(UNWRAP (locatable__name(n)));
    END
    rubyToClearVoid__type_analysis_session()
    });
}
END
PRIVATE FN typeAnalysisSession__analyze_auto_shard_each_op(MUTABLE self: TypeAnalysisSession, MUTABLE smooth_node: BinaryOp, MUTABLE conc: ConcurrentOp, proxy: BinaryOp) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lhs_type = TRY (aST__full_type_mut(smooth_node.left));
    MUTABLE item_type: String@symbol = :Any;
    MUTABLE iterable = TRY (typeAnalysisSession__pipeline_source_fact(&rtoc_self_view, smooth_node.left, lhs_type));
    IF !(pipelineSourceFact__valid?(iterable)) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, (IF locatable__left(Locatable{ BinaryOp: COPY smooth_node }) EXISTS AS rtoc_wrap_6397 THEN DiagnosticAnchor{ Locatable: COPY rtoc_wrap_6397 } ELSE NIL END), TypeAnalysisCodeOrMessage{ SymbolValue: :CONCURRENT_EACH_BAD_INPUT }, [], CAST({:got: locatable__resolved_type(UNWRAP (locatable__left( Locatable{ BinaryOp: COPY smooth_node })))} AS {String@symbol}Any)));
      item_type = :Any;
    ELSE
      item_type = castTypeToStringSymbol(COPY iterable.item_type);
    END
    typeAnalysisSession__with_new_scope(&rtoc_self_view, NIL, %() USE(conc, item_type, MUTABLE rtoc_self_view) -> {
    MUTABLE rtoc_mutable_receiver_151 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
    TRY (scope__declare(&rtoc_mutable_receiver_151, "_", NIL, SymbolEntryTypeInput{ SymbolValue: COPY item_type }, ScopeMutabilityInput{ BoolValue: TRUE }, FALSE, NIL, :stack));
    FOR _ IN (clearParserConcurrentPipelineOp__body(UNWRAP (conc.op)) OR_ELSE List[]) DO
    TRY (typeAnalysisSession__visit(&rtoc_self_view, _));
    END
    NIL
    });
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY smooth_node }, :Void));
    smooth_node.storage_override = :stack;
    TRY (typeAnalysisSession__auto_detect_sharded_access(&rtoc_self_view, smooth_node, &conc));
}
END
PRIVATE FN typeAnalysisSession__auto_detect_sharded_access(MUTABLE self: TypeAnalysisSession, smooth_node: BinaryOp, MUTABLE conc: ConcurrentOp) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE each_op: ?ClearParserConcurrentPipelineOp@boxed = COPY conc.op;
    IF !(UNWRAP (each_op) IS_A EachOp) THEN
      RETURN;
    END
    MUTABLE sharded_accesses: []PipelineShardedAccess = ( { MUTABLE rtoc_empty_list_152: []PipelineShardedAccess = List[]; rtoc_empty_list_152 } );
    TRY (typeAnalysisSession__walk_for_sharded_access(&rtoc_self_view, UNWRAP (clearParserConcurrentPipelineOp__body(UNWRAP (each_op))), &sharded_accesses));
    IF (sharded_accesses.length() == 0) THEN
      RETURN;
    END
    MUTABLE first_access: ?PipelineShardedAccess = COPY sharded_accesses.first();
    IF first_access EXISTS AS first_access_value THEN
      MUTABLE first_access_value_mutable = COPY first_access_value;
      MUTABLE map_name = COPY first_access_value_mutable.map_name;
      MUTABLE scope: ?Scope@multiowned = TRY (typeAnalysisSession__lookup_scope_for(&rtoc_self_view, map_name));
      IF scope EXISTS AS scope_value THEN
        MUTABLE scope_value_mutable = COPY scope_value;
        MUTABLE entry: ?SymbolEntry@multiowned = scope__resolve_entry(scope_value_mutable, map_name);
        MUTABLE map_type: ?Type@multiowned = NIL;
        IF entry != NIL THEN
          map_type = COPY symbolEntry__type(entry);
        END
        IF !((map_type != NIL)) THEN
          map_type = TRY (type__new( TypeConstructionInput{ Type: COPY UNWRAP (map_type) }));
        END
        IF !((type__sharded?(UNWRAP (map_type)) AND ((IF entry != NIL THEN
          symbolEntry__sync(entry)
        ELSE
          NIL
        END) == NIL))) THEN
          RETURN;
        END
        MUTABLE this_map_accesses = sharded_accesses |> WHERE (_.map_name == map_name);
        MUTABLE key_sources = (this_map_accesses |> SELECT {
    MUTABLE key_expr = COPY _.key_expr;
    MUTABLE key_name: String = "";
          IF key_expr IS_A Identifier AS identifier THEN
            key_name = identifier__name(identifier);
          ELSE
            key_name = COPY CAST(key_expr AS String);
          END
    ((locatable__variant_name(key_expr) $+ ":") $+ key_name)
        }) |> DISTINCT _ |> SELECT COPY _;
        IF ((key_sources).length() > 1) THEN
          typeAnalysisSession__note_mut(&rtoc_self_view, Locatable{ ConcurrentOp: COPY conc }, "CONCURRENT EACH uses ${(key_sources).length().toString()} different key expressions on @sharded map '${map_name}'. Routing is based on the first key; other accesses with different keys may trigger cross-shard remote calls.");
        END
        MUTABLE key_expr = (UNWRAP (this_map_accesses.first())).key_expr;
        MUTABLE map_ident = Identifier{ token: CAST(COPY first_access_value_mutable.map_token AS Token), name: COPY map_name, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, fn_ref: NIL, heap_dupe_result: NIL, atomic_borrow: NIL, ownership_pending_transfer: NIL };
        TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ Identifier: COPY map_ident }, map_type));
        each_op = conc.op;
        conc.shard_context = PipelineShardContext{ map_var: Locatable{ Identifier: COPY map_ident }, shard_count: type__shard_count(UNWRAP (map_type)), key_expr: COPY key_expr, auto_detected: TRUE, key_allocates_frame: FALSE, body_allocates_frame: FALSE };
      ELSE
        RETURN;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__walk_for_sharded_access(MUTABLE self: TypeAnalysisSession, nodes: []Locatable, MUTABLE results: []PipelineShardedAccess) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__each_shard_scan_node(rtoc_self_view, ShardScanNode{ ArrayValue: nodes |> SELECT castLocatableToNode__type_analysis_session(_) }, %(node: Locatable) USE(MUTABLE results, MUTABLE rtoc_self_view) -> {
    MUTABLE access: ?PipelineShardedAccess = TRY (typeAnalysisSession__sharded_get_index_access(&rtoc_self_view, node, "sharded pipeline target"));
    IF access EXISTS AS access_value THEN
        &results.append(access_value);
    END
    rubyToClearVoid__type_analysis_session()
    });
}
END
PRIVATE FN typeAnalysisSession__each_shard_scan_node(self: TypeAnalysisSession, node: ?ShardScanNode, blk: FN(Locatable) -> Void) RETURNS Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node? IS_A []Node AS array THEN
      FOR _ IN array DO
      typeAnalysisSession__each_shard_scan_node(rtoc_self_view, castNodeToOptionalShardScanNode(_), blk);
      END
      RETURN;
    END
    IF node? IS_A Capability AS ast_capability THEN
      MUTABLE rtoc_cap_children: []?Locatable = [ast_capability.guard_expr, ast_capability.view_length];
      &rtoc_cap_children.append(ast_capability.var_node);
      FOR _ IN rtoc_cap_children DO
        IF _ EXISTS AS rtoc_cap_child THEN
          typeAnalysisSession__each_shard_scan_node(rtoc_self_view, castNodeToOptionalShardScanNode(castLocatableToNode__type_analysis_session(rtoc_cap_child)), blk);
        END
      END
      RETURN;
    END
    IF castShardScanNodeToLocatable(UNWRAP (node)) EXISTS AS locatable THEN
      blk(locatable);
      IF (locatable IS_A BgBlock OR locatable IS_A DoBlock) THEN
        RETURN;
      END
      FOR rtoc_child IN locatable__child_nodes(locatable) DO
        typeAnalysisSession__each_shard_scan_node(rtoc_self_view, castLocatableToShardScanNode(rtoc_child), blk);
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__sharded_unsynced_entry?(self: TypeAnalysisSession, entry: ?SymbolEntry) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF entry EXISTS AS entry_value THEN
      MUTABLE type = symbolEntry__type(entry_value);
      RETURN (type__sharded?(type) AND (symbolEntry__sync(entry_value) == NIL));
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__sharded_unsynced_identifier?(MUTABLE self: TypeAnalysisSession, node: Identifier) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node.symbol EXISTS AS declared THEN
      RETURN typeAnalysisSession__sharded_unsynced_entry?(rtoc_self_view, declared);
    END
    IF TRY (typeAnalysisSession__lookup_scope_for(&rtoc_self_view, node.name)) EXISTS AS scope THEN
      RETURN typeAnalysisSession__sharded_unsynced_entry?(rtoc_self_view, scope__resolve_entry(scope, node.name));
    END
    RETURN typeAnalysisSession__sharded_unsynced_entry?(rtoc_self_view, NIL);
}
END
PRIVATE FN typeAnalysisSession__sharded_get_index_access(MUTABLE self: TypeAnalysisSession, node: Locatable, context: String) RETURNS !?PipelineShardedAccess
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node IS_A GetIndex AS get_index THEN
    IF get_index.target IS_A Identifier THEN
        IF !(TRY (typeAnalysisSession__sharded_unsynced_identifier?(&rtoc_self_view, castLocatableToIdentifier__type_analysis_session(get_index.target)))) THEN
          RETURN NIL;
        END
        MUTABLE ti = TRY (aST__full_type_mut(get_index.target));
        IF !((TRUE AND type__sharded?(ti))) THEN
          RETURN NIL;
        END
        RETURN PipelineShardedAccess{ map_name: COPY UNWRAP (aST__node_name(get_index.target)), key_expr: COPY get_index.index, map_token: UNWRAP (locatable__token(get_index.target)) };
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__analyze_shard_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE shard_op = COPY node.right;
    MUTABLE lhs_type = TRY (aST__full_type_mut(node.left));
    MUTABLE iterable = TRY (typeAnalysisSession__pipeline_source_fact(&rtoc_self_view, node.left, lhs_type));
    IF !(pipelineSourceFact__valid?(iterable)) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, (IF locatable__left(Locatable{ BinaryOp: COPY node }) EXISTS AS rtoc_wrap_6577 THEN DiagnosticAnchor{ Locatable: COPY rtoc_wrap_6577 } ELSE NIL END), TypeAnalysisCodeOrMessage{ SymbolValue: :SHARD_NEEDS_RANGE_OR_COLLECTION }, [], CAST({:got: locatable__resolved_type(UNWRAP (locatable__left( Locatable{ BinaryOp: COPY node })))} AS {String@symbol}Any)));
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY node }, :Void));
      RETURN NIL;
    END
    MUTABLE item_type = COPY iterable.item_type;
    typeAnalysisSession__with_new_scope(&rtoc_self_view, NIL, %() USE(item_type, shard_op, MUTABLE rtoc_self_view) -> {
    MUTABLE rtoc_mutable_receiver_155 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
    TRY (scope__declare(&rtoc_mutable_receiver_155, "_", NIL, castTypeToOptionalSymbolEntryTypeInput__type_analysis_session(item_type), ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    TRY (typeAnalysisSession__visit(&rtoc_self_view, locatable__key_expr(shard_op)))
    });
    MUTABLE key_type: ?String@symbol = locatable__resolved_type(UNWRAP (locatable__key_expr(shard_op)));
    TRY (typeAnalysisSession__visit(&rtoc_self_view, locatable__target_map(shard_op)));
    MUTABLE target_info: Type = TRY (aST__full_type_mut(UNWRAP (locatable__target_map(shard_op))));
    MUTABLE target_sync: ?String@symbol = IF TRUE THEN
      (IF locatable__symbol(UNWRAP (locatable__target_map(shard_op))) != NIL THEN
      symbolEntry__sync(UNWRAP ((locatable__symbol(UNWRAP (locatable__target_map(shard_op))))))
    ELSE
      NIL
    END)
    ELSE
      NIL
    END;
    IF !((((TRUE) AND type__sharded?(target_info)) AND FALSE)) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY UNWRAP (locatable__target_map(shard_op)) }, TypeAnalysisCodeOrMessage{ SymbolValue: :SHARD_MAP_NOT_SHARDED }, [], CAST({} AS {String@symbol}Any)));
    END
    MUTABLE map_key: ?Type = (IF TRUE THEN
      TRY (type__key_type(target_info))
    ELSE
      NIL
    END);
    MUTABLE actual_key: Type = TRY (aST__full_type_mut(UNWRAP (locatable__key_expr(shard_op))));
    IF ((map_key != NIL) AND !(TRY (type__accepts_map_key?(target_info, actual_key)))) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY UNWRAP (locatable__key_expr(shard_op)) }, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_MAP_KEY_MISMATCH }, [], CAST({:expected: TRY (type__surface_name(TypeTypeInput{ Type: COPY map_key })), :actual: TRY (type__surface_name(TypeTypeInput{ Type: COPY actual_key }))} AS {String@symbol}Any)));
    END
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY node }, :Void));
    node.storage_override = :stack;
    RETURN :stack;
}
END
PRIVATE FN typeAnalysisSession__validate_positive_numeric_concurrent_option_mut(MUTABLE self: TypeAnalysisSession, name: String, expr: Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, expr));
    IF !(([:Float64, :Int64]).contains?(locatable__resolved_type(expr))) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY expr }, TypeAnalysisCodeOrMessage{ SymbolValue: :CONCURRENT_OPT_NEEDS_NUMBER }, [], CAST({:name: name, :got: locatable__resolved_type(expr)} AS {String@symbol}Any)));
    END
    MUTABLE literal_val: ?Float64 = typeAnalysisSession__numeric_literal_value(&rtoc_self_view, expr);
    IF ((literal_val != NIL) AND (literal_val <= 0)) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY expr }, TypeAnalysisCodeOrMessage{ SymbolValue: :CONCURRENT_OPT_NEEDS_POSITIVE }, [], CAST({:name: name, :got: literal_val.toInt()} AS {String@symbol}Any)));
    END
}
END
PRIVATE FN typeAnalysisSession__numeric_literal_value(MUTABLE self: TypeAnalysisSession, expr: Locatable) RETURNS ?Float64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF expr IS_A Literal AS literal THEN
      RETURN tokenValue__to_f(UNWRAP (literal.value));
    ELSE
    IF (IF expr IS_A UnaryOp AS rtoc_neg_op THEN (rtoc_neg_op.op == :SUB) ELSE FALSE END) THEN
        MUTABLE right: ?Locatable = aST__node_right(expr);
        IF UNWRAP (right) IS_A Literal THEN
          RETURN (-tokenValue__to_f(UNWRAP (castLocatableToLiteral(UNWRAP (right)))));
        END
    END
    END
}
END
PRIVATE FN typeAnalysisSession__queue_backed_concurrent_source?(MUTABLE self: TypeAnalysisSession, node: BinaryOp) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lhs = COPY node.left;
    MUTABLE lhs_type = TRY (aST__full_type_mut(lhs));
    RETURN (((((typeAnalysisSession__shard_concurrent_source?(rtoc_self_view, lhs) OR TRY (typeAnalysisSession__bounded_stream_source?(&rtoc_self_view, &lhs))) OR (IF TRUE THEN
      type__inf_stream?(lhs_type)
    ELSE
      FALSE
    END)) OR (IF TRUE THEN
      TRY (type__dynamic_stream?(lhs_type))
    ELSE
      FALSE
    END)) OR (IF TRUE THEN
      TRY (type__open_stream?(lhs_type))
    ELSE
      FALSE
    END)) OR lhs IS_A RangeLit);
}
END
PRIVATE FN typeAnalysisSession__shard_concurrent_source?(self: TypeAnalysisSession, lhs: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ((IF lhs IS_A BinaryOp AS binary_op THEN binaryOp__smooth?(binary_op) ELSE FALSE END) AND UNWRAP (aST__node_right(lhs)) IS_A ShardOp);
}
END
PRIVATE FN typeAnalysisSession__analyze_concurrent_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE conc = COPY node.right;
    MUTABLE options: {String}Locatable = CAST(locatable__options(conc) AS {String}Locatable);
    TRY (typeAnalysisSession__validate_concurrent_options_mut(&rtoc_self_view, node, castLocatableToConcurrentOp__type_analysis_session(conc), options));
    TRY (typeAnalysisSession__stamp_concurrent_option_values_mut(&rtoc_self_view, options));
    MUTABLE lhs_type = TRY (aST__full_type_mut(node.left));
    MUTABLE shard_node: ?ShardOp = typeAnalysisSession__prepare_concurrent_shard_context_mut(&rtoc_self_view, node, castLocatableToConcurrentOp__type_analysis_session(conc));
    MUTABLE proxy = BinaryOp{ token: COPY UNWRAP (locatable__token(Locatable{ BinaryOp: COPY node })), left: COPY UNWRAP (locatable__left(Locatable{ BinaryOp: COPY node })), op: :SMOOTH, right: COPY conc.op, paren_bind: NIL, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, string_concat: NIL, or_fallback_dupe: NIL, error_union_type: NIL, observable_terminal: NIL, observable_dest: NIL, retain_error_channel: NIL };
    IF (conc.op() IS_A SelectOp) OR (conc.op() IS_A WhereOp) THEN
      IF TRY (typeAnalysisSession__bounded_stream_source?(&rtoc_self_view, &node.left)) THEN
        TRY (typeAnalysisSession__analyze_concurrent_bounded_select_family_op(&rtoc_self_view, &node));
      ELSE_IF TRY (typeAnalysisSession__concurrent_stream_source?(&rtoc_self_view, node.left, lhs_type)) THEN
        TRY (typeAnalysisSession__analyze_concurrent_stream_select_family_op(&rtoc_self_view, &node));
      ELSE
        TRY (typeAnalysisSession__analyze_select_family_op(&rtoc_self_view, &proxy));
      END
    ELSE_IF (conc.op() IS_A EachOp) THEN
      IF TRY (typeAnalysisSession__bounded_stream_source?(&rtoc_self_view, &node.left)) THEN
        TRY (typeAnalysisSession__analyze_concurrent_bounded_each_op(&rtoc_self_view, &node));
      ELSE_IF TRY (typeAnalysisSession__concurrent_stream_source?(&rtoc_self_view, node.left, lhs_type)) THEN
        TRY (typeAnalysisSession__analyze_concurrent_stream_each_op(&rtoc_self_view, &node));
      ELSE_IF shard_node THEN
        TRY (typeAnalysisSession__analyze_shard_each_op(&rtoc_self_view, &node, UNWRAP (shard_node)));
      ELSE
        MUTABLE sharded_names = Set[];
        FOR _ IN conc.op().body() DO
        TRY (typeAnalysisSession__collect_sharded_names(&rtoc_self_view, _, &sharded_names));
        END
        conc.capture_analysis = typeAnalysisSession__with_fiber_capture_analysis(&rtoc_self_view, FALSE, FALSE, %() USE(conc, MUTABLE node, MUTABLE proxy, sharded_names, MUTABLE rtoc_self_view) -> {
    IF (sharded_names.length() > 1) THEN
            TRY (typeAnalysisSession__emit_multi_map_warning(&rtoc_self_view, castLocatableToConcurrentOp__type_analysis_session(conc), sharded_names));
            TRY (typeAnalysisSession__analyze_each_op(&rtoc_self_view, &proxy));
    ELSE_IF (sharded_names.length() == 1) THEN
            TRY (typeAnalysisSession__analyze_auto_shard_each_op(&rtoc_self_view, &node, castLocatableToConcurrentOp__type_analysis_session(conc), proxy));
    ELSE
            TRY (typeAnalysisSession__analyze_each_op(&rtoc_self_view, &proxy));
    END
    rubyToClearVoid__type_analysis_session()
        });
      END
    ELSE_IF (conc.op() IS_A SumOp) THEN
      TRY (typeAnalysisSession__analyze_sum_op(&rtoc_self_view, &proxy));
    ELSE_IF (conc.op() IS_A CountOp) THEN
      TRY (typeAnalysisSession__analyze_count_op(&rtoc_self_view, &proxy));
    ELSE_IF (conc.op() IS_A MinOp) THEN
      TRY (typeAnalysisSession__analyze_min_op(&rtoc_self_view, &proxy));
    ELSE_IF (conc.op() IS_A MaxOp) THEN
      TRY (typeAnalysisSession__analyze_max_op(&rtoc_self_view, &proxy));
    ELSE_IF (conc.op() IS_A AverageOp) THEN
      TRY (typeAnalysisSession__analyze_average_op(&rtoc_self_view, &proxy));
    ELSE
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, conc, TypeAnalysisCodeOrMessage{ SymbolValue: :CONCURRENT_BAD_FOLLOWING_OP }, [], CAST({:got: DiagnosticKwValue{ StringValue: locatable__variant_name(conc.op()) }} AS {String@symbol}Any)));
    END
    MUTABLE inner_expr = PARTIAL MATCH conc.op() START
      AST.SelectOp -> conc.op().expression(),
      AST.WhereOp -> conc.op().expression(),
      DEFAULT -> NIL
    END;
    IF (_ IS_A BinaryOp AND (_.op() == symbol("OR_ELSE"))) THEN
      MUTABLE modifier = inner_expr.right();
      IF (modifier IS_A OrElsePrune OR modifier IS_A OrElseRaise) THEN
        MUTABLE inner_fn_type = inner_expr.left().full_type_mut({:context: "inner pipeline left"});
        MUTABLE is_error_union = ((TRUE AND inner_expr.left().error_union_type));
        IF inner_fn_type != NIL THEN
          is_error_union = inner_fn_type.error_union?();
        END
        IF !(is_error_union) THEN
          MUTABLE mod_name: String = "";
          IF modifier IS_A OrElsePrune THEN
            mod_name = "OR_ELSE PRUNE";
          ELSE
            mod_name = "OR_ELSE RAISE";
          END
          TRY (typeAnalysisSession__error_mut(&rtoc_self_view, modifier, TypeAnalysisCodeOrMessage{ SymbolValue: :MODIFIER_NEEDS_ERROR_UNION }, [], CAST({:name: mod_name, :got: inner_expr.left().resolved_type} AS {String@symbol}Any)));
        END
        IF modifier IS_A OrElseRaise THEN
          inner_expr.retain_error_channel = TRUE;
        END
      END
    END
    MUTABLE stream_op_analyzed = (aST__pipeline_stream_value_op?(conc.op()) AND ((TRY (typeAnalysisSession__bounded_stream_source?(&rtoc_self_view, &node.left)) OR TRY (typeAnalysisSession__concurrent_stream_source?(&rtoc_self_view, node.left, lhs_type)))));
    IF !(_) THEN
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY node }, TRY (aST__full_type_mut(proxy))));
      node.storage_override = IF ((TRY (aST__full_type_mut(Locatable{ BinaryOp: COPY node })) == :Void)) THEN
        :stack
      ELSE
        :heap
      END;
    END
    MUTABLE inner = conc.op();
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, &_, TRY (aST__full_type_mut(Locatable{ BinaryOp: COPY node }))));
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__validate_concurrent_options_mut(MUTABLE self: TypeAnalysisSession, node: BinaryOp, conc: ConcurrentOp, options: {String}Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__validate_concurrent_numeric_option_mut(&rtoc_self_view, options, "workers"));
    TRY (typeAnalysisSession__validate_concurrent_capacity_option_mut(&rtoc_self_view, node, options));
    TRY (typeAnalysisSession__validate_concurrent_numeric_option_mut(&rtoc_self_view, options, "batch"));
    TRY (typeAnalysisSession__validate_concurrent_parallel_option_mut(&rtoc_self_view, options));
    TRY (typeAnalysisSession__validate_concurrent_size_option_mut(&rtoc_self_view, options));
    TRY (typeAnalysisSession__validate_known_concurrent_options_mut(&rtoc_self_view, conc, options));
}
END
PRIVATE FN typeAnalysisSession__validate_concurrent_numeric_option_mut(MUTABLE self: TypeAnalysisSession, options: {String}Locatable, name: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE expr: ?Locatable = COPY options[name];
    IF expr EXISTS AS expr_value THEN
      MUTABLE expr_value_mutable = COPY expr_value;
      TRY (typeAnalysisSession__validate_positive_numeric_concurrent_option_mut(&rtoc_self_view, name, expr_value_mutable));
    END
}
END
PRIVATE FN typeAnalysisSession__validate_concurrent_capacity_option_mut(MUTABLE self: TypeAnalysisSession, node: BinaryOp, options: {String}Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE cap: ?Locatable = COPY options["capacity"];
    IF cap EXISTS AS cap_value THEN
      MUTABLE cap_value_mutable = COPY cap_value;
      IF !(TRY (typeAnalysisSession__queue_backed_concurrent_source?(&rtoc_self_view, node))) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY cap_value_mutable }, TypeAnalysisCodeOrMessage{ SymbolValue: :CONCURRENT_CAPACITY_BAD_INPUT }));
      END
      TRY (typeAnalysisSession__validate_positive_numeric_concurrent_option_mut(&rtoc_self_view, "capacity", cap_value_mutable));
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__validate_concurrent_parallel_option_mut(MUTABLE self: TypeAnalysisSession, options: {String}Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE par_val: ?Locatable = COPY options["parallel"];
    IF par_val EXISTS AS par_val_value THEN
      IF typeAnalysisSession__concurrent_bool_option?(&rtoc_self_view, par_val_value) THEN
        RETURN;
      END
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY par_val_value }, TypeAnalysisCodeOrMessage{ SymbolValue: :CONCURRENT_PARALLEL_NEEDS_BOOL }, [], CAST({:got: typeAnalysisSession__concurrent_option_label(rtoc_self_view, par_val_value)} AS {String@symbol}Any)));
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__concurrent_bool_option?(MUTABLE self: TypeAnalysisSession, value: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN !(!(((((IF value IS_A Literal AS literal THEN (literal.type == :BOOLEAN) ELSE FALSE END)) OR ((IF value IS_A Identifier AS identifier THEN (["true", "false", "TRUE", "FALSE"]).contains?(identifier__name(identifier)) ELSE FALSE END))))));
}
END
PRIVATE FN typeAnalysisSession__validate_concurrent_size_option_mut(MUTABLE self: TypeAnalysisSession, options: {String}Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE size: ?Locatable = COPY options["size"];
    IF size EXISTS AS size_value THEN
      IF (IF size_value IS_A Identifier AS identifier THEN pipeAnalysis__valid_concurrent_sizes().contains?(identifier__name(identifier)) ELSE FALSE END) THEN
        RETURN;
      END
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY size_value }, TypeAnalysisCodeOrMessage{ SymbolValue: :CONCURRENT_SIZE_BAD_VALUE }, [], CAST({:valid: pipeAnalysis__valid_concurrent_sizes().join(", "), :got: typeAnalysisSession__concurrent_option_label(rtoc_self_view, size_value)} AS {String@symbol}Any)));
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__concurrent_option_label(self: TypeAnalysisSession, value: Locatable) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF value IS_A Identifier AS identifier THEN
      RETURN COPY identifier__name(identifier);
    END
    RETURN locatable__variant_name(value);
}
END
PRIVATE FN typeAnalysisSession__validate_known_concurrent_options_mut(MUTABLE self: TypeAnalysisSession, conc: ConcurrentOp, options: {String}Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN options.keys() DO
    IF !(pipeAnalysis__valid_concurrent_options().contains?(_)) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ ConcurrentOp: COPY conc } }, TypeAnalysisCodeOrMessage{ SymbolValue: :CONCURRENT_UNKNOWN_OPTION }, [], CAST({:name: _, :valid: pipeAnalysis__valid_concurrent_options().join(", ")} AS {String@symbol}Any)));
    END
    END
}
END
PRIVATE FN typeAnalysisSession__stamp_concurrent_option_values_mut(MUTABLE self: TypeAnalysisSession, options: {String}Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR MUTABLE rtoc_mutable_block_param_156 IN options.values() DO
    IF rtoc_mutable_block_param_156 IS_A Identifier THEN
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, &rtoc_mutable_block_param_156, TRY (type__new(TypeConstructionInput{ SymbolValue: :Type }))));
    ELSE
      TRY (typeAnalysisSession__visit(&rtoc_self_view, rtoc_mutable_block_param_156));
    END
    END
}
END
PRIVATE FN typeAnalysisSession__prepare_concurrent_shard_context_mut(MUTABLE self: TypeAnalysisSession, node: BinaryOp, MUTABLE conc: ConcurrentOp) RETURNS ?ShardOp
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(typeAnalysisSession__shard_concurrent_source?(rtoc_self_view, node.left)) THEN
      RETURN NIL;
    END
    MUTABLE shard_node: ?Locatable = aST__node_right(node.left);
    MUTABLE target_info: !Type = aST__full_type_mut(UNWRAP (locatable__target_map(UNWRAP (shard_node))));
    conc.shard_context = PipelineShardContext{ map_var: COPY UNWRAP (locatable__target_map(UNWRAP (shard_node))), shard_count: type__shard_count(TRY (target_info)), key_expr: COPY UNWRAP (locatable__key_expr(UNWRAP (shard_node))), auto_detected: FALSE, key_allocates_frame: FALSE, body_allocates_frame: FALSE };
    RETURN UNWRAP (castLocatableToShardOp(UNWRAP (shard_node)));
}
END
PRIVATE FN typeAnalysisSession__concurrent_stream_source?(MUTABLE self: TypeAnalysisSession, node: Locatable, lhs_type: Type) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN (((TRY (type__inf_stream?(lhs_type)) OR TRY (type__dynamic_stream?(lhs_type))) OR TRY (type__open_stream?(lhs_type))) OR node IS_A RangeLit);
}
END
PRIVATE FN typeAnalysisSession__analyze_concurrent_bounded_select_family_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lhs_type = TRY (aST__full_type_mut(node.left));
    MUTABLE item_type: ?Type = TRY (type__stream_element_type(lhs_type));
    MUTABLE is_parallel = typeAnalysisSession__concurrent_parallel_enabled?(&rtoc_self_view, locatable__options(node.right));
    MUTABLE analysis: ?CaptureAnalysis = typeAnalysisSession__with_fiber_capture_analysis(&rtoc_self_view, &is_parallel, FALSE, %() USE(item_type, node, MUTABLE rtoc_self_view) -> {
    typeAnalysisSession__with_new_scope(&rtoc_self_view, NIL, %() USE(item_type, node, MUTABLE rtoc_self_view) -> {
      MUTABLE rtoc_mutable_receiver_157 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
      TRY (scope__declare(&rtoc_mutable_receiver_157, "_", NIL, (IF item_type EXISTS AS rtoc_wrap_6915 THEN SymbolEntryTypeInput{ Type: COPY rtoc_wrap_6915 } ELSE NIL END), ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
      TRY (typeAnalysisSession__with_soa_tracking(&rtoc_self_view, node, UNWRAP (item_type), %() USE(node, MUTABLE rtoc_self_view) -> {
        rtoc_lambda_result_158 = TRY (typeAnalysisSession__visit(&rtoc_self_view, clearParserConcurrentPipelineOp__expression(UNWRAP (castLocatableToConcurrentOp__type_analysis_session(node.right).op))));
        rtoc_lambda_result_158
      }))
    });
    rubyToClearVoid__type_analysis_session()
    });
    locatable__set_capture_analysis_mut(&node.right, (TRY (typeAnalysisSession__validate_capture_analysis_mut(&rtoc_self_view, castLocatableToNode__type_analysis_session(UNWRAP (locatable__right(Locatable{ BinaryOp: COPY node }))), UNWRAP (analysis), &is_parallel, FALSE)) OR_ELSE analysis));
    TRY (typeAnalysisSession__validate_concurrent_where_expression_mut(&rtoc_self_view, UNWRAP (castLocatableToBinaryOp(Locatable{ BinaryOp: COPY node }))));
    MUTABLE result_type = TRY (typeAnalysisSession__concurrent_select_family_result_type(&rtoc_self_view, node, UNWRAP (item_type)));
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY node }, result_type));
    node.storage_override = :heap;
    IF typeAnalysisSession__current_fn_ctx(&rtoc_self_view) != NIL THEN
        MUTABLE rtoc_mutable_receiver_159: FunctionContext@multiowned = UNWRAP ((typeAnalysisSession__current_fn_ctx(&rtoc_self_view)));
        functionContext__record_frame_use_mut(&rtoc_mutable_receiver_159);
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__analyze_concurrent_bounded_each_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lhs_type = TRY (aST__full_type_mut(node.left));
    MUTABLE item_type: ?Type = TRY (type__stream_element_type(lhs_type));
    MUTABLE is_parallel = typeAnalysisSession__concurrent_parallel_enabled?(&rtoc_self_view, locatable__options(node.right));
    MUTABLE analysis: ?CaptureAnalysis = typeAnalysisSession__with_fiber_capture_analysis(&rtoc_self_view, &is_parallel, FALSE, %() USE(item_type, node, MUTABLE rtoc_self_view) -> {
    typeAnalysisSession__with_new_scope(&rtoc_self_view, typeAnalysisSession__current_scope(&rtoc_self_view), %() USE(item_type, node, MUTABLE rtoc_self_view) -> {
      MUTABLE rtoc_mutable_receiver_160 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
      TRY (scope__declare(&rtoc_mutable_receiver_160, "_", NIL, (IF item_type EXISTS AS rtoc_wrap_6945 THEN SymbolEntryTypeInput{ Type: COPY rtoc_wrap_6945 } ELSE NIL END), ScopeMutabilityInput{ BoolValue: TRUE }, FALSE, NIL, :stack));
      TRY (typeAnalysisSession__with_soa_tracking(&rtoc_self_view, node, UNWRAP (item_type), %() USE(node, MUTABLE rtoc_self_view) -> {
        FOR _ IN clearParserConcurrentPipelineOp__body(UNWRAP (castLocatableToConcurrentOp__type_analysis_session(node.right).op)) DO
        TRY (typeAnalysisSession__visit(&rtoc_self_view, _));
        END
        NIL
      }))
    });
    rubyToClearVoid__type_analysis_session()
    });
    locatable__set_capture_analysis_mut(&node.right, (TRY (typeAnalysisSession__validate_capture_analysis_mut(&rtoc_self_view, castLocatableToNode__type_analysis_session(UNWRAP (locatable__right(Locatable{ BinaryOp: COPY node }))), UNWRAP (analysis), &is_parallel, FALSE)) OR_ELSE analysis));
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY node }, :Void));
    node.storage_override = :stack;
    RETURN :stack;
}
END
PRIVATE FN typeAnalysisSession__analyze_concurrent_stream_select_family_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lhs_type = TRY (aST__full_type_mut(node.left));
    MUTABLE item_type = COPY (TRY (typeAnalysisSession__pipeline_source_fact(&rtoc_self_view, node.left, lhs_type, TRUE))).item_type;
    MUTABLE is_parallel = typeAnalysisSession__concurrent_parallel_enabled?(&rtoc_self_view, locatable__options(node.right));
    MUTABLE analysis: ?CaptureAnalysis = typeAnalysisSession__with_fiber_capture_analysis(&rtoc_self_view, &is_parallel, FALSE, %() USE(item_type, node, MUTABLE rtoc_self_view) -> {
    typeAnalysisSession__with_new_scope(&rtoc_self_view, NIL, %() USE(item_type, node, MUTABLE rtoc_self_view) -> {
      MUTABLE rtoc_mutable_receiver_161 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
      TRY (scope__declare(&rtoc_mutable_receiver_161, "_", NIL, castTypeToOptionalSymbolEntryTypeInput__type_analysis_session(item_type), ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
      TRY (typeAnalysisSession__with_soa_tracking(&rtoc_self_view, node, item_type, %() USE(node, MUTABLE rtoc_self_view) -> {
        rtoc_lambda_result_162 = TRY (typeAnalysisSession__visit(&rtoc_self_view, clearParserConcurrentPipelineOp__expression(UNWRAP (castLocatableToConcurrentOp__type_analysis_session(node.right).op))));
        rtoc_lambda_result_162
      }))
    });
    rubyToClearVoid__type_analysis_session()
    });
    locatable__set_capture_analysis_mut(&node.right, (TRY (typeAnalysisSession__validate_capture_analysis_mut(&rtoc_self_view, castLocatableToNode__type_analysis_session(UNWRAP (locatable__right(Locatable{ BinaryOp: COPY node }))), UNWRAP (analysis), &is_parallel, FALSE)) OR_ELSE analysis));
    TRY (typeAnalysisSession__validate_concurrent_where_expression_mut(&rtoc_self_view, UNWRAP (castLocatableToBinaryOp(Locatable{ BinaryOp: COPY node }))));
    MUTABLE result_type = TRY (typeAnalysisSession__concurrent_select_family_result_type(&rtoc_self_view, node, item_type));
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY node }, TRY (type__new(TypeConstructionInput{ Type: COPY result_type }))));
    node.storage_override = :heap;
    IF typeAnalysisSession__current_fn_ctx(&rtoc_self_view) != NIL THEN
        MUTABLE rtoc_mutable_receiver_163: FunctionContext@multiowned = UNWRAP ((typeAnalysisSession__current_fn_ctx(&rtoc_self_view)));
        functionContext__record_frame_use_mut(&rtoc_mutable_receiver_163);
    END
    RETURN 0;
}
END
PRIVATE FN typeAnalysisSession__validate_concurrent_where_expression_mut(MUTABLE self: TypeAnalysisSession, node: BinaryOp) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE concurrent: ConcurrentOp = COPY castLocatableToConcurrentOp__type_analysis_session(node.right);
    IF !(concurrent.op) THEN
      RETURN;
    END
    MUTABLE op: ClearParserConcurrentPipelineOp = UNWRAP (concurrent.op);
    IF op IS_A WhereOp AS where_op THEN
      TRY (typeAnalysisSession__validate_where_effect_contract_mut(&rtoc_self_view, where_op, TRY (typeAnalysisSession__selector_effect_fact(&rtoc_self_view, UNWRAP (clearParserConcurrentPipelineOp__expression(op))))));
    END
}
END
PRIVATE FN typeAnalysisSession__concurrent_select_family_result_type(MUTABLE self: TypeAnalysisSession, node: BinaryOp, item_type: Type) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE op: ClearParserConcurrentPipelineOp = UNWRAP (castLocatableToClearParserConcurrentPipelineOp(node.right));
    IF op IS_A SelectOp AS MUTABLE rtoc_select_op THEN
      MUTABLE effect = TRY (typeAnalysisSession__selector_effect_fact(&rtoc_self_view, UNWRAP (clearParserConcurrentPipelineOp__expression(op))));
      TRY (typeAnalysisSession__validate_select_effect_contract_mut(&rtoc_self_view, &rtoc_select_op, effect));
      IF selectorEffectFact__asynchronous(effect) THEN
        RETURN TRY (type__promise_list_of(TypeTypeInput{ Type: COPY selectorEffectFact__value_type(effect) }));
      ELSE
        RETURN TRY (type__array_of(TypeTypeInput{ Type: COPY selectorEffectFact__value_type(effect) }));
      END
    END
    IF op IS_A WhereOp THEN
      RETURN TRY (type__array_of(castTypeToTypeTypeInput__type_analysis_session(item_type)));
    END
    panic("expected CONCURRENT SELECT/WHERE, got {}");
}
END
PRIVATE FN typeAnalysisSession__analyze_concurrent_stream_each_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lhs_type = TRY (aST__full_type_mut(node.left));
    MUTABLE item_type = COPY (TRY (typeAnalysisSession__pipeline_source_fact(&rtoc_self_view, node.left, lhs_type, TRUE))).item_type;
    MUTABLE is_parallel = typeAnalysisSession__concurrent_parallel_enabled?(&rtoc_self_view, locatable__options(node.right));
    MUTABLE analysis: ?CaptureAnalysis = typeAnalysisSession__with_fiber_capture_analysis(&rtoc_self_view, &is_parallel, FALSE, %() USE(item_type, node, MUTABLE rtoc_self_view) -> {
    typeAnalysisSession__with_new_scope(&rtoc_self_view, typeAnalysisSession__current_scope(&rtoc_self_view), %() USE(item_type, node, MUTABLE rtoc_self_view) -> {
      MUTABLE rtoc_mutable_receiver_164 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
      TRY (scope__declare(&rtoc_mutable_receiver_164, "_", NIL, castTypeToOptionalSymbolEntryTypeInput__type_analysis_session(item_type), ScopeMutabilityInput{ BoolValue: TRUE }, FALSE, NIL, :stack));
      TRY (typeAnalysisSession__with_soa_tracking(&rtoc_self_view, node, item_type, %() USE(node, MUTABLE rtoc_self_view) -> {
        FOR _ IN clearParserConcurrentPipelineOp__body(UNWRAP (castLocatableToConcurrentOp__type_analysis_session(node.right).op)) DO
        TRY (typeAnalysisSession__visit(&rtoc_self_view, _));
        END
        NIL
      }))
    });
    rubyToClearVoid__type_analysis_session()
    });
    locatable__set_capture_analysis_mut(&node.right, (TRY (typeAnalysisSession__validate_capture_analysis_mut(&rtoc_self_view, castLocatableToNode__type_analysis_session(UNWRAP (locatable__right(Locatable{ BinaryOp: COPY node }))), UNWRAP (analysis), &is_parallel, FALSE)) OR_ELSE analysis));
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY node }, :Void));
    node.storage_override = :stack;
    RETURN :stack;
}
END
PRIVATE FN typeAnalysisSession__sum_result_clear_type(self: TypeAnalysisSession, expr_sym: String@symbol) RETURNS String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN PARTIAL MATCH expr_sym START
      :Int8 -> :Int64,
      :Int16 -> :Int64,
      :Int32 -> :Int64,
      :Int64 -> :Int64,
      :UInt8 -> :UInt64,
      :Byte -> :UInt64,
      :UInt16 -> :UInt64,
      :UInt32 -> :UInt64,
      :UInt64 -> :UInt64,
      :Float32 -> :Float32,
      DEFAULT -> :Float64
    END;
}
END
PRIVATE FN typeAnalysisSession__require_array_input_mut(MUTABLE self: TypeAnalysisSession, node: BinaryOp, op_name: String, allow_range: Bool = FALSE, allow_stream: Bool = FALSE) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lhs_type = TRY (aST__full_type_mut(node.left));
    IF (aST__metatype(UNWRAP (locatable__left( Locatable{ BinaryOp: COPY node }))) == :array) THEN
      RETURN;
    END
    MUTABLE lhs_type_value: Type = lhs_type;
    IF TRUE THEN
      IF type__collection?(lhs_type_value) THEN
      RETURN;
    END
    END
    IF allow_range THEN
    IF node.left IS_A RangeLit THEN
      RETURN;
    END
    END
    IF (allow_stream AND ((TRUE) AND type__runtime_stream?(lhs_type_value))) THEN
      RETURN;
    END
    IF (op_name == "SELECT") THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY node.left }, TypeAnalysisCodeOrMessage{ SymbolValue: :SELECT_NEEDS_LIST }, [], CAST({:got: locatable__resolved_type(node.left)} AS {String@symbol}Any)));
    ELSE
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY node.left }, TypeAnalysisCodeOrMessage{ SymbolValue: :PIPE_OP_NEEDS_LIST }, [], CAST({:op: op_name, :got: locatable__resolved_type(node.left)} AS {String@symbol}Any)));
    END
}
END
PRIVATE FN typeAnalysisSession__range_element_type(self: TypeAnalysisSession, range_node: RangeLit) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (aST__full_type_mut(range_node.start));
}
END
PRIVATE FN typeAnalysisSession__check_soa_opportunity_mut(MUTABLE self: TypeAnalysisSession, node: BinaryOp, item_type: Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE accessed: ?[Set]String = COPY typeAnalysisSession__phase_traversal_state(&rtoc_self_view).pipeline_accessed_fields;
    IF accessed EXISTS AS accessed_value THEN
      IF accessed_value.empty?() THEN
        RETURN;
      END
      MUTABLE schema: ?SchemaValue = TRY (typeAnalysisSession__lookup_type_schema(&rtoc_self_view, type__resolved(item_type)));
      IF !(schemas__field_bearing?(schema)) THEN
        RETURN;
      END
      MUTABLE total = schemaValue__fields(UNWRAP (schema)).keys().length();
      IF (total < 4) THEN
        RETURN;
      END
      MUTABLE ratio = (CAST(accessed_value.length() AS Float64) / total);
      IF (ratio < 0.5) THEN
        MUTABLE fields_str = ((accessed_value |> SELECT COPY _) |> ORDER_BY _).join(", ");
        typeAnalysisSession__note_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY node }, "Pipeline accesses ${accessed_value.length().toString()} of ${total.toString()} fields (${fields_str}). Consider @soa for better cache performance on '${castTypeToString(item_type)}'.");
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__with_soa_tracking(MUTABLE self: TypeAnalysisSession, node: BinaryOp, item_type: Type, blk: FN() -> !Void) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE traversal_state = typeAnalysisSession__phase_traversal_state(&rtoc_self_view);
  DEFER IF traversal_state THEN
      traversal_state.pipeline_accessed_fields = NIL;
  END
  traversal_state.pipeline_accessed_fields = Set[];
  blk();
  TRY (typeAnalysisSession__check_soa_opportunity_mut(&rtoc_self_view, node, item_type));
}
END
PRIVATE FN typeAnalysisSession__scope_stack_for_helper(MUTABLE self: TypeAnalysisSession) RETURNS []Scope@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN (typeAnalysisSession__scope_stack(&rtoc_self_view));
}
END
PRIVATE FN typeAnalysisSession__current_scope(MUTABLE self: TypeAnalysisSession) RETURNS !Scope@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN KEEP UNWRAP (((typeAnalysisSession__scope_stack_for_helper(&rtoc_self_view))).last());
}
END
PRIVATE FN typeAnalysisSession__lookup_scope_for(MUTABLE self: TypeAnalysisSession, name: String) RETURNS !?Scope@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_reverse_items_165: []Scope@multiowned = (typeAnalysisSession__scope_stack_for_helper(&rtoc_self_view));
    MUTABLE rtoc_reverse_i_166 = rtoc_reverse_items_165.length() - 1;
    WHILE rtoc_reverse_i_166 >= 0 DO
    IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_167 = ((rtoc_reverse_items_165[rtoc_reverse_i_166])?);
    scope__entry?(&rtoc_local_receiver_167, name) } THEN
        RETURN KEEP (rtoc_reverse_items_165[rtoc_reverse_i_166])?;
    END
    rtoc_reverse_i_166 = rtoc_reverse_i_166 - 1;
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__resolve_variable_scope(MUTABLE self: TypeAnalysisSession, name: String) RETURNS !?Scope@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE scope = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
    IF scope__entry?(&scope, name) THEN
      RETURN scope;
    ELSE
      MUTABLE outer_scope: ?Scope@multiowned = TRY (typeAnalysisSession__lookup_scope_for(&rtoc_self_view, name));
      IF outer_scope EXISTS AS outer_scope_value THEN
        IF functionSignature__unwrap(X{ Type: COPY TRY (scope__resolve_type(outer_scope_value, name)) }) THEN
          RETURN outer_scope_value;
        END
        IF (outer_scope_value.depth == 0) THEN
          RETURN outer_scope_value;
        END
        RETURN NIL;
      ELSE
        RETURN NIL;
      END
    END
}
END
PRIVATE FN typeAnalysisSession__lookup_type_schema(MUTABLE self: TypeAnalysisSession, name: String@symbol) RETURNS !?SchemaValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE base_name = symbol((compilerRegexReplaceFirst((CAST(name AS String)), compilerRegexCompile("<.*>$"), "")));
    MUTABLE rtoc_reverse_items_168: []Scope@multiowned = (typeAnalysisSession__scope_stack_for_helper(&rtoc_self_view));
    MUTABLE rtoc_reverse_i_169 = rtoc_reverse_items_168.length() - 1;
    WHILE rtoc_reverse_i_169 >= 0 DO
      MUTABLE schema: ?SchemaValue = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_170 = ((rtoc_reverse_items_168[rtoc_reverse_i_169])?);
      TRY (scope__resolve_type_definition(rtoc_local_receiver_170, base_name)) };
      IF schema THEN
          RETURN schema;
      END
    rtoc_reverse_i_169 = rtoc_reverse_i_169 - 1;
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__all_known_type_names(MUTABLE self: TypeAnalysisSession) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE names = List[];
    FOR _ IN (typeAnalysisSession__scope_stack_for_helper(&rtoc_self_view)) DO
    ruby_array_concat_Any__type_analysis_session(names, CAST(_.types.keys() |> SELECT _.toString() AS []Any));
    END
    RETURN CAST((names |> DISTINCT _) AS []Any);
}
END
PRIVATE FN typeAnalysisSession__with_new_scope<RESULT>(MUTABLE self: TypeAnalysisSession, scope: ?Scope = NIL, blk: FN() -> RESULT) RETURNS !RESULT
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  DEFER &rtoc_self_view.traversal_state.scopes.pop();
  MUTABLE new_scope = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_172: ?Scope = NIL;
    IF (scope == NIL) THEN
      rtoc_ternary_value_172 = scope__new();
    ELSE
      rtoc_ternary_value_172 = COPY scope;
    END
    rtoc_ternary_value_172? };
  new_scope.depth = rtoc_self_view.traversal_state.scopes.length();
  &rtoc_self_view.traversal_state.scopes.push(new_scope);
  RETURN blk();
}
END
PRIVATE FN typeAnalysisSession__to_type(self: TypeAnalysisSession, input: ?TypeAnalysisInput) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF input EXISTS AS input_value THEN
      MUTABLE value = COPY input_value;
      IF value IS_A Type AS type THEN
        RETURN TRY (type__copy_type(type));
      END
      IF value IS_A String@symbol AS string_symbol THEN
        RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: COPY string_symbol }));
      END
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }));
    ELSE
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }));
    END
}
END
PRIVATE FN typeAnalysisSession__is_safe_autocast?(self: TypeAnalysisSession, source_type: ?SourceType, target_type: TypeTypeInput) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE target = TRY (type__from_input(target_type));
    IF source_type EXISTS AS source_type_value THEN
      IF source_type_value IS_A Type AS type THEN
        RETURN TRY (type__accepts?(target, TRY (type__copy_type(type))));
      END
      IF source_type_value IS_A String@symbol AS string_symbol THEN
        RETURN TRY (type__accepts?(target, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY string_symbol }))));
      END
      RETURN TRY (type__accepts?(target, TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }))));
    ELSE
      RETURN TRY (type__accepts?(target, TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }))));
    END
}
END
PRIVATE FN typeAnalysisSession__error_mut(MUTABLE self: TypeAnalysisSession, node_or_token: ?DiagnosticAnchor, code_or_message: TypeAnalysisCodeOrMessage, args: []?DiagnosticKwValue = [], kwargs: {String@symbol}Any = {}) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE token: ?Any@multiowned = typeAnalysisSession__diagnostic_token(&rtoc_self_view, node_or_token);
    MUTABLE message: ?String = "";
    IF code_or_message IS_A String@symbol AS string_symbol THEN
      message = TRY (diagnosticRegistry__format_from_hash(string_symbol, args, kwargs));
      IF !(message) THEN
        panic("Internal Compiler Error: Unknown error code :{}");
      END
    ELSE
      message = castCodeOrMessageToOptionalString__type_analysis_session(COPY code_or_message);
    END
    MUTABLE source_token: ?Token@multiowned = typeAnalysisSession__source_error_token(rtoc_self_view, token);
    MUTABLE diagnostic_code: ?String@symbol = NIL;
    IF code_or_message IS_A String@symbol AS string_symbol THEN
      diagnostic_code = COPY string_symbol;
    END
    RETURN TRY (typeAnalysisSession__raise_source_error_mut(&rtoc_self_view, CAST(source_token AS ?Token), UNWRAP (message), diagnostic_code));
}
END
PRIVATE FN typeAnalysisSession__format_diagnostic_template(self: TypeAnalysisSession, template: String, args: []?DiagnosticKwValue, kwargs: {String@symbol}?DiagnosticKwValue) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN diagnosticRegistry__format_template(template, args, diagnosticKwargs__rendered(kwargs));
}
END
PRIVATE FN typeAnalysisSession__diagnostic_message(self: TypeAnalysisSession, code: String@symbol, args: []?DiagnosticKwValue = [], kwargs: {String@symbol}Any = {}) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE message: ?String = TRY (diagnosticRegistry__format_from_hash(code, args, kwargs));
    IF message EXISTS AS message_value THEN
      RETURN message_value;
    ELSE
      panic("Internal Compiler Error: Unknown error code :{}");
    END
}
END
PRIVATE FN typeAnalysisSession__fix_description(self: TypeAnalysisSession, code: String@symbol, kwargs: {String@symbol}?DiagnosticKwValue = {}) RETURNS !String
  REQUIRES self: LOCAL
