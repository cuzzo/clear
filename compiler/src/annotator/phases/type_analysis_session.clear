PRIVATE FN typeAnalysisSession__bg_sources_for_block(MUTABLE self: TypeAnalysisSession, expr: ?BgSourceWalkValue) RETURNS ![]SymbolEntry@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF expr EXISTS AS expr_value THEN
      IF aST__node_capture_analysis(UNWRAP (castBgSourceWalkValueToLocatable(expr_value))) EXISTS AS analysis THEN
        RETURN TRY (typeAnalysisSession__bg_lifetime_sources(&rtoc_self_view, analysis));
      END
    END
    RETURN CAST(( { MUTABLE rtoc_empty_list_513: []SymbolEntry@multiowned = List[]; rtoc_empty_list_513 } ) AS []SymbolEntry@multiowned);
}
END
PRIVATE FN typeAnalysisSession__bg_lifetime_sources(MUTABLE self: TypeAnalysisSession, analysis: CaptureAnalysis) RETURNS ![]SymbolEntry@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE sources: []SymbolEntry@multiowned = List[];
    FOR info IN analysis.capture_symbols.values() DO
      IF !(TRY (typeAnalysisSession__bg_capture_independent?(&rtoc_self_view, info))) THEN
        &sources.append(KEEP info);
      END
    END
    RETURN sources;
}
END
PRIVATE FN typeAnalysisSession__bg_capture_independent?(MUTABLE self: TypeAnalysisSession, info: SymbolEntry) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF ((([:shared, :heap] |> DISTINCT _).contains?(symbolEntry__storage(info))) AND (symbolEntry__sync(info) == NIL)) THEN
      RETURN TRUE;
    END
    IF symbolEntry__atomic_ptr?(info) THEN
      RETURN TRUE;
    END
    IF ((symbolEntry__sync(info) != NIL) AND (!(([:raw, :symbol, :c, :size] |> DISTINCT _).contains?(symbolEntry__sync(info))))) THEN
      RETURN FALSE;
    END
    IF (symbolEntry__storage(info) == :multiowned) THEN
      RETURN FALSE;
    END
    MUTABLE ti_branch_value: ?Type@multiowned = NIL;
    IF TRUE THEN
      ti_branch_value = symbolEntry__type(info);
    ELSE
      ti_branch_value = NIL;
    END
    MUTABLE ti: ?Type@multiowned = ti_branch_value;
    IF ti EXISTS AS ti_value THEN
      RETURN TRY (typeAnalysisSession__value_copy_capture?(&rtoc_self_view, CAST(ti_value AS Type)));
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__value_copy_capture?(MUTABLE self: TypeAnalysisSession, t: Type) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN TRY (type__bg_capture_is_value_copy?(t, %(name: String@symbol) USE(MUTABLE rtoc_self_view) -> TRY (typeAnalysisSession__schema_lookup_result(&rtoc_self_view, name))));
}
