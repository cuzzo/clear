PRIVATE FN typeAnalysisSession__og_set_live(self: TypeAnalysisSession, name: String) RETURNS ?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE graph_node: ?OwnershipNode = COPY ownershipGraph__get_index(typeAnalysisSession__ownership_graph(rtoc_self_view), name);
    IF graph_node EXISTS AS graph_node_value THEN
      MUTABLE graph_node_value_mutable = COPY graph_node_value;
      graph_node_value_mutable.state = :live;
      RETURN :live;
    ELSE
      RETURN NIL;
    END
}
