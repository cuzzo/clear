PRIVATE FN typeAnalysisSession__resolve_protocol_method_call_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MethodCall) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE receiver = TRY (aST__full_type_mut(node.object));
    IF TRY (typeAnalysisSession__resolve_user_protocol_method_call_mut(&rtoc_self_view, &node, receiver)) THEN
      RETURN TRUE;
    END
    IF !(TRY (typeAnalysisSession__map_requires_protocol_lowering?(&rtoc_self_view, receiver))) THEN
      RETURN FALSE;
    END
    TRY (typeAnalysisSession__require_generic_map_access_scope_mut(&rtoc_self_view, node.object, receiver));
    MUTABLE operation: ?String@symbol = ({"put": :put, "delete": :delete, "contains?": :contains, "count": :count, "length": :count, "empty?": :empty, "any?": :any})[node.name];
    IF !(operation) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ MethodCall: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_MAP_METHOD_UNKNOWN }, [], CAST({:name: node.name, :available: "put, delete, contains?, count, length, empty?, any?"} AS {String@symbol}Any)));
    END
    MUTABLE expected_arity = IF ([:count, :empty, :any]).contains?(operation) THEN
      0
    ELSE
      (IF (operation == :put) THEN
      2
    ELSE
      1
    END)
    END;
    IF (node.args.length() != expected_arity) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ MethodCall: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_MAP_METHOD_ARITY }, [], CAST({:name: node.name, :expected: expected_arity, :actual: node.args.length()} AS {String@symbol}Any)));
    END
    MUTABLE key_type = TRY (typeAnalysisSession__protocol_map_associated_type(&rtoc_self_view, receiver, :Key));
    MUTABLE value_type = TRY (typeAnalysisSession__protocol_map_associated_type(&rtoc_self_view, receiver, :Value));
    TRY (typeAnalysisSession__verify_generic_map_receiver_mutability_mut(&rtoc_self_view, &node, receiver, UNWRAP (operation)));
    IF expected_arity.positive?() THEN
      TRY (typeAnalysisSession__verify_protocol_method_argument_mut(&rtoc_self_view, &node, 0, CAST(key_type AS Type)));
    END
    IF (operation == :put) THEN
      TRY (typeAnalysisSession__verify_protocol_method_argument_mut(&rtoc_self_view, &node, 1, CAST(value_type AS Type)));
    END
    IF (operation == :put) THEN
      TRY (typeAnalysisSession__consume_generic_map_value_mut(&rtoc_self_view, UNWRAP (node.args[1]), CAST(value_type AS Type)));
    END
    MUTABLE result_branch_value: ?Type = NIL;
    PARTIAL MATCH operation START
      :contains ->
      result_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: :Bool }));,
      :empty ->
      result_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: :Bool }));,
      :any ->
      result_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: :Bool }));,
      :count ->
      result_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: :Int64 }));,
      DEFAULT ->
      result_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: :Void }));
    END
    MUTABLE result: Type = result_branch_value?;
    node.protocol_operation = operation;
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ MethodCall: COPY node }, result));
    IF (operation == :put) THEN
      IF typeAnalysisSession__current_fn_ctx(&rtoc_self_view) != NIL THEN
            MUTABLE rtoc_mutable_receiver_290: ?FunctionContext = (typeAnalysisSession__current_fn_ctx(&rtoc_self_view));
            MUTABLE rtoc_heap_ctx2 = UNWRAP (rtoc_mutable_receiver_290); functionContext__record_heap_use_mut(&rtoc_heap_ctx2);
      END
      IF typeAnalysisSession__current_fn_ctx(&rtoc_self_view) != NIL THEN
            MUTABLE rtoc_mutable_receiver_291: ?FunctionContext = (typeAnalysisSession__current_fn_ctx(&rtoc_self_view));
            MUTABLE rtoc_open_0 = UNWRAP (rtoc_mutable_receiver_291);
            functionContext__record_alloc_use_mut(&rtoc_open_0);
      END
      TRY (typeAnalysisSession__record_effect(&rtoc_self_view, symbol("HEAP")));
      node.can_fail = TRUE;
    END
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__verify_generic_map_receiver_mutability_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MethodCall, receiver: Type, operation: String@symbol) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE mutates = ([:put, :delete]).contains?(operation);
    IF !(mutates) THEN
      RETURN;
    END
    MUTABLE params: []Param = [Param{ name: "receiver", type: COPY receiver, required: TRUE, mutable: TRUE, takes: FALSE, default: NIL, comptime: NIL, name_token: NIL, sync: NIL, symbol: NIL, carrier_contract: NIL }];
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < node.args.length() DO
    &params.append(Param{ name: "arg${(rtoc_idx + 1).toString()}", type: COPY TRY (aST__full_type_mut(UNWRAP (node.args[rtoc_idx]))), required: TRUE, mutable: FALSE, takes: FALSE, default: NIL, comptime: NIL, name_token: NIL, sync: NIL, symbol: NIL, carrier_contract: NIL });
    rtoc_idx = rtoc_idx + 1;
    END
    TRY (typeAnalysisSession__verify_function_signature_mut(&rtoc_self_view, FunctionCallNode{ MethodCall: COPY node }, TRY (functionSignature__new(params, castTypeToOptionalTypeTypeInput__type_analysis_session(TRY (type__new(TypeConstructionInput{ SymbolValue: :Void }))), NIL, NIL, ( { MUTABLE rtoc_empty_list_292: []String@symbol = List[]; rtoc_empty_list_292 } ), {}, FALSE, FALSE, NIL, NIL, NIL, ( { MUTABLE rtoc_empty_list_293: []String@symbol = List[]; rtoc_empty_list_293 } ), NIL, ( { MUTABLE rtoc_empty_list_294: []String@symbol = List[]; rtoc_empty_list_294 } ))), ([node.object] + node.args)));
}
END
PRIVATE FN typeAnalysisSession__resolve_user_protocol_method_call_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MethodCall, receiver: Type) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE protocol_names = TRY (typeAnalysisSession__user_protocol_names_for_receiver(&rtoc_self_view, receiver));
    IF (protocol_names.length() == 0) THEN
      RETURN FALSE;
    END
    MUTABLE matches: []Tuple<ProtocolDef, ProtocolRequirement> = List[];
    FOR _ IN protocol_names DO
      MUTABLE protocol: ?ProtocolDef = typeAnalysisSession__semantic_protocol(&rtoc_self_view, _);
      MUTABLE requirement: ?ProtocolRequirement = (protocol?.requirements OR_ELSE List[]) |> FIND (_.is_method AND (_.name == node.name));
      IF protocol EXISTS AS rtoc_proto_v THEN
        IF requirement EXISTS AS rtoc_req_v THEN
          &matches.append(Tuple{COPY rtoc_proto_v, COPY rtoc_req_v});
        END
      END
    END
    IF (matches.length() > 1) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ MethodCall: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_PROTOCOL_METHOD_AMBIGUOUS }, [], CAST({:name: node.name, :protocols: (matches |> SELECT _._0.name).join(", ")} AS {String@symbol}Any)));
    END
    IF (matches.length() == 0) THEN
      MUTABLE rtoc_avail: [Set]String = Set[];
      FOR _ IN protocol_names DO
        IF typeAnalysisSession__semantic_protocol(&rtoc_self_view, _) EXISTS AS rtoc_proto_a THEN
          FOR rtoc_req IN rtoc_proto_a.requirements DO
            IF rtoc_req.is_method THEN
              &rtoc_avail.insert(COPY rtoc_req.name);
            END
          END
        END
      END
      MUTABLE available = (rtoc_avail |> SELECT COPY _) |> ORDER_BY _;
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ MethodCall: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_PROTOCOL_METHOD_UNKNOWN }, [], CAST({:name: node.name, :protocols: protocol_names.join(" & "), :available: IF available.empty?() THEN
        "none"
      ELSE
        available.join(", ")
      END} AS {String@symbol}Any)));
    END
    MUTABLE rtoc_first_match = UNWRAP (matches.first());
    MUTABLE protocol: ProtocolDef = COPY rtoc_first_match._0;
    MUTABLE requirement: ProtocolRequirement = COPY rtoc_first_match._1;
    MUTABLE signature = TRY (typeAnalysisSession__protocol_requirement_signature(&rtoc_self_view, protocol, requirement, receiver));
    TRY (typeAnalysisSession__verify_function_signature_mut(&rtoc_self_view, FunctionCallNode{ MethodCall: COPY node }, signature, ([node.object] + node.args)));
    node.matched_signature = signature;
    node.protocol_name = protocol.name;
    node.protocol_operation = symbol(requirement.name);
    TRY (typeAnalysisSession__stamp_resolved_call_result_mut(&rtoc_self_view, FunctionCallNode{ MethodCall: COPY node }, CAST(functionSignature__return_type(signature) AS Type), functionSignature__recoverable_result?(signature)));
    IF functionSignature__reentrant(signature) THEN
      TRY (typeAnalysisSession__record_effect(&rtoc_self_view, symbol("REENTRANT")));
    END
    IF typeAnalysisSession__current_fn_ctx(&rtoc_self_view) != NIL THEN
        MUTABLE rtoc_mutable_receiver_295 = UNWRAP (typeAnalysisSession__current_fn_ctx(&rtoc_self_view));
        functionContext__mark_runtime_used_mut(&rtoc_mutable_receiver_295);
    END
    TRY (typeAnalysisSession__record_predicate_call_site_mut(&rtoc_self_view, Node{ MethodCall: COPY node }));
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__user_protocol_names_for_receiver(MUTABLE self: TypeAnalysisSession, receiver: Type) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE bounded = (TRY (typeAnalysisSession__generic_parameter_protocol_names(&rtoc_self_view, type__resolved(receiver)))) |> WHERE !((_ == "Map"));
    IF !((bounded.length() == 0)) THEN
      RETURN bounded;
    END
    RETURN (TRY (typeAnalysisSession__semantic_protocols(&rtoc_self_view))).keys() |> WHERE !((TRY (typeAnalysisSession__conformance_match(&rtoc_self_view, _, receiver)) == NIL));
}
END
PRIVATE FN typeAnalysisSession__protocol_requirement_signature(MUTABLE self: TypeAnalysisSession, protocol: ProtocolDef, requirement: ProtocolRequirement, receiver: Type) RETURNS !FunctionSignature@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE substitutions = protocol.associated_types |> REDUCE({:Self: receiver}) {
    acc[symbol(_.name)] = TRY (type__new(TypeConstructionInput{ TypeExpression: COPY typeExpression__of( TypeExpressionKind{ TypeProjectionExpression: COPY TypeProjectionExpression{ owner: COPY type__resolved(receiver), member: COPY symbol(_.name), protocol: COPY symbol(protocol.name) } }) }));
    acc
    };
    RETURN TRY (functionSignature__new(requirement.params |> SELECT Param{ name: COPY _.name, type: CAST(COPY TRY (typeAnalysisSession__apply_type_subst(&rtoc_self_view, castTypeToTypeTypeInput__type_analysis_session(_.type), castMapTypeToMapGenericBinding(substitutions))) AS Type), required: TRUE, mutable: _.mutable, takes: _.takes, default: NIL, comptime: NIL, name_token: NIL, sync: NIL, symbol: NIL, carrier_contract: NIL }, TypeTypeInput{ Type: COPY TRY (typeAnalysisSession__apply_type_subst(&rtoc_self_view, castTypeToTypeTypeInput__type_analysis_session(requirement.return_type), castMapTypeToMapGenericBinding(substitutions))) }, NIL, NIL, ( { MUTABLE rtoc_empty_list_296: []String@symbol = List[]; rtoc_empty_list_296 } ), {}, (requirement.effects_decl == :reentrant), FALSE, NIL, NIL, NIL, ( { MUTABLE rtoc_empty_list_297: []String@symbol = List[]; rtoc_empty_list_297 } ), NIL, ( { MUTABLE rtoc_empty_list_298: []String@symbol = List[]; rtoc_empty_list_298 } )));
}
END
PRIVATE FN typeAnalysisSession__verify_protocol_method_argument_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MethodCall, index_value: Int64, expected: Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE argument = COPY UNWRAP (node.args[index_value]);
    MUTABLE actual = TRY (aST__full_type_mut(argument));
    IF TRY (type__accepts?(expected, actual)) THEN
      RETURN;
    END
    TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(argument), TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_MAP_METHOD_ARGUMENT }, [], CAST({:name: node.name, :position: (index_value + 1), :expected: TRY (type__surface_name(castTypeToTypeTypeInput__type_analysis_session(expected))), :actual: TRY (type__surface_name( TypeTypeInput{ Type: COPY actual }))} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__resolve_inherent_method_call_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MethodCall) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE receiver_type = TRY (aST__full_type_mut(node.object));
    MUTABLE owner = IF type__generic_instance?(receiver_type) THEN
      type__generic_base(receiver_type)
    ELSE
      type__resolved(receiver_type)
    END;
    MUTABLE schema: ?SchemaValue = TRY (typeAnalysisSession__lookup_type_schema(&rtoc_self_view, owner));
    IF !(schemas__struct?(schema)) THEN
      RETURN FALSE;
    END
    IF !(schemaValue__methods(UNWRAP (schema)).contains?(node.name)) THEN
      RETURN FALSE;
    END
    MUTABLE source_name = COPY node.name;
    node.source_method_name = source_name;
    node.name = implementationRegistration__function_name(CAST(owner AS String), source_name);
    TRY (typeAnalysisSession__resolve_call(&rtoc_self_view, FunctionCallNode{ MethodCall: COPY node }, ([node.object] + node.args)));
    TRY (typeAnalysisSession__reject_mutating_borrowed_receiver_mut(&rtoc_self_view, &node));
    TRY (typeAnalysisSession__record_predicate_call_site_mut(&rtoc_self_view, Node{ MethodCall: COPY node }));
    typeAnalysisSession__record_call_site(&rtoc_self_view, node.name);
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__reject_legacy_foreign_slice_view_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MethodCall) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE receiver_type = TRY (aST__full_type_mut(node.object));
