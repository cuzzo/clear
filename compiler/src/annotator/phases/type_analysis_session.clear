END
PRIVATE FN typeAnalysisSession__stamp_resolved_call_result_mut(self: TypeAnalysisSession, MUTABLE node: FunctionCallNode, return_type: Type, recoverable: Bool = FALSE) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE resolved = TRY (type__new(castTypeToTypeConstructionInput(return_type)));
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, castFunctionCallNodeToLocatable(node), resolved));
    IF !((type__error_union?(resolved) OR recoverable)) THEN
      RETURN;
    END
    MUTABLE error_union_branch_value: ?Type = NIL;
    IF type__error_union?(resolved) THEN
      error_union_branch_value = resolved;
    ELSE
      error_union_branch_value = TRY (type__error_union_of(castTypeToTypeTypeInput(resolved)));
    END
    MUTABLE error_union: Type = error_union_branch_value?;
    MATCH node START
      FunctionCallNode.FuncCall AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.error_union_type = error_union;
        node = FunctionCallNode{ FuncCall: item_mutable };,
      FunctionCallNode.MethodCall AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.error_union_type = error_union;
        node = FunctionCallNode{ MethodCall: item_mutable };,
    END
    MATCH node START
      FunctionCallNode.FuncCall AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.can_fail = TRUE;
        node = FunctionCallNode{ FuncCall: item_mutable };,
      FunctionCallNode.MethodCall AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.can_fail = TRUE;
        node = FunctionCallNode{ MethodCall: item_mutable };,
    END
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, castFunctionCallNodeToLocatable(node), TRY (type__success_type(error_union))));
}
END
PRIVATE FN typeAnalysisSession__mark_owned_c_out_parameters_mut(self: TypeAnalysisSession, signature: FunctionSignature, args: []Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(((functionSignature__extern_source(signature) != NIL) AND (((functionSignature__extern_source(signature))?).abi == :c))) THEN
      RETURN;
    END
    (TRY (functionSignature__params(signature))).zip(args).keys() |> EACH {
    MUTABLE arg: Any = ((TRY (functionSignature__params(signature))).zip(args)[_] OR_ELSE panic("missing hash key"));
    IF !((IF _ != NIL THEN
        _.mutable()
      ELSE
        NIL
      END)) THEN
      CONTINUE;
    END
    IF !(arg IS_A Identifier) THEN
        CONTINUE;
    END
    MUTABLE param_type = TRY (type__new(_.type()));
    MUTABLE payload_branch_value: ?Type = NIL;
      IF type__optional?(param_type) THEN
        payload_branch_value = TRY (type__wrapped_type(param_type));
      ELSE
        payload_branch_value = NIL;
      END
    MUTABLE payload: ?Type = payload_branch_value;
    IF !(payload) THEN
        CONTINUE;
    END
    MUTABLE schema = typeAnalysisSession__lookup_type_schema(rtoc_self_view, type__resolved(payload));
    IF !(schema IS_A ResourceSchema) THEN
        CONTINUE;
    END
    MUTABLE symbol = arg.symbol();
    IF symbol THEN
        symbolEntry__set_foreign_out_owner(&symbol, TRUE);
    END
    };
}
END
PRIVATE FN typeAnalysisSession__receiver_container_alloc(self: TypeAnalysisSession, node: FunctionCallNode) RETURNS ?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A MethodCall AS method_call THEN
      MUTABLE obj = method_call.object;
      MUTABLE sym = IF TRUE THEN
        aST__node__symbol(obj)
      ELSE
        NIL
      END;
      MUTABLE storage: ?String@symbol = sym.storage();
      IF storage EXISTS AS storage_value THEN
        IF (storage_value == :frame) THEN
          RETURN :frame;
        END
        IF (storage_value == :heap) THEN
          RETURN :heap;
        END
        RETURN NIL;
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__verify_function_signature_mut(MUTABLE self: TypeAnalysisSession, node: FunctionCallNode, signature: FunctionSignature, args_input: ?[]Locatable = NIL) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE args = COPY args_input;
    args = (args OR_ELSE (MATCH node START FunctionCallNode.FuncCall AS item -> item.args, FunctionCallNode.MethodCall AS item -> item.args END));
    MUTABLE site = typeAnalysisSession__call_signature_site(rtoc_self_view, node, args);
    callSignatureSite__assign_signature_mut(&site, signature);
    MUTABLE plan = typeAnalysisSession__call_arity_plan(rtoc_self_view, site, signature);
    typeAnalysisSession__verify_call_arity_mut(rtoc_self_view, plan);
    typeAnalysisSession__inject_default_arguments_mut(&rtoc_self_view, plan);
    MUTABLE encountered_args: []EncounteredCallArgument = ( { MUTABLE rtoc_empty_list_73: []EncounteredCallArgument = List[]; rtoc_empty_list_73 } );
    MUTABLE atomic_bare_value_args: []Locatable = ( { MUTABLE rtoc_empty_list_74: []Locatable = List[]; rtoc_empty_list_74 } );
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < site.args.length() DO
      MUTABLE param = COPY UNWRAP ((TRY (functionSignature__params(signature)))[rtoc_idx]);
      IF param.comptime EXISTS AS comptime_value THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE facts = typeAnalysisSession__call_argument_facts(rtoc_self_view, site, param, site.args[rtoc_idx]?, rtoc_idx);
      typeAnalysisSession__verify_param_lifetime_mut(rtoc_self_view, facts.arg_node, facts.param, signature);
      typeAnalysisSession__verify_mutable_argument_mut(rtoc_self_view, facts);
      typeAnalysisSession__verify_takes_argument_mut(rtoc_self_view, facts);
      typeAnalysisSession__verify_link_argument_mut(rtoc_self_view, facts);
      typeAnalysisSession__verify_argument_type_mut(rtoc_self_view, facts, signature, atomic_bare_value_args);
      typeAnalysisSession__verify_argument_aliases_mut(rtoc_self_view, facts, &encountered_args);
      typeAnalysisSession__verify_copy_retained_boundary_mut(rtoc_self_view, facts);
      typeAnalysisSession__verify_unique_argument_mut(rtoc_self_view, facts);
      typeAnalysisSession__verify_retained_into_plain_slot_mut(rtoc_self_view, facts);
    rtoc_idx = rtoc_idx + 1;
    END
    typeAnalysisSession__warn_multi_atomic_bare_value_call_mut(rtoc_self_view, site.node, atomic_bare_value_args);
    NIL;
}
END
PRIVATE FN typeAnalysisSession__call_signature_site(self: TypeAnalysisSession, node: FunctionCallNode, args_input: ?[]Locatable = NIL) RETURNS CallSignatureSite
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE args = COPY args_input;
    args = (args OR_ELSE (MATCH node START FunctionCallNode.FuncCall AS item -> item.args, FunctionCallNode.MethodCall AS item -> item.args END));
    MUTABLE source_name: String = "";
    IF (IF node IS_A MethodCall AS method_call THEN (methodCall__source_method_name(&method_call) != NIL) ELSE FALSE END) THEN
      source_name = node.source_method_name();
    ELSE
      source_name = COPY CAST(node.name() AS String);
    END
    RETURN CallSignatureSite{ node: COPY node, name: COPY source_name, args: COPY args };
}
END
PRIVATE FN typeAnalysisSession__call_arity_plan(self: TypeAnalysisSession, site: CallSignatureSite, signature: FunctionSignature) RETURNS !CallArityPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE params = TRY (functionSignature__params(signature));
    RETURN CallArityPlan{ site: COPY site, params: COPY params, min_args: params |> COUNT _.required, max_args: params.length(), given_args: site.args.length() };
}
END
PRIVATE FN typeAnalysisSession__verify_call_arity_mut(self: TypeAnalysisSession, plan: CallArityPlan) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(callArityPlan__mismatch?(plan)) THEN
      RETURN;
    END
    IF callArityPlan__exact?(plan) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, plan.site.node, TypeAnalysisCodeOrMessage{ SymbolValue: :ARITY_MISMATCH }, [], {:name: plan.site.name, :expected: plan.min_args, :got: plan.given_args});
    ELSE
      typeAnalysisSession__error_mut(rtoc_self_view, plan.site.node, TypeAnalysisCodeOrMessage{ SymbolValue: :ARITY_MISMATCH_RANGE }, [], {:name: plan.site.name, :min: plan.min_args, :max: plan.max_args, :got: plan.given_args});
    END
}
END
PRIVATE FN typeAnalysisSession__inject_default_arguments_mut(MUTABLE self: TypeAnalysisSession, plan: CallArityPlan) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN (TRY (callArityPlan__injectable_defaults(plan))) DO
    MUTABLE injected = typeAnalysisSession__default_argument_for(rtoc_self_view, _);
    TRY (typeAnalysisSession__visit(&rtoc_self_view, injected));
    callSignatureSite__append_arg_mut(plan.site, injected);
    END
}
END
PRIVATE FN typeAnalysisSession__default_argument_for(self: TypeAnalysisSession, param: Param) RETURNS Locatable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE default = param.default;
    IF default IS_A DefaultLit THEN
      RETURN Locatable{ StructLit: COPY StructLit{ token: COPY default.token(), name: COPY type__to_s(param.type), fields: COPY {}, storage: NIL, type_args: NIL, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, borrowed_field_names: NIL, field_tokens: {} } };
    END
    RETURN CAST(COPY default AS Locatable);
}
END
PRIVATE FN typeAnalysisSession__call_argument_facts(self: TypeAnalysisSession, site: CallSignatureSite, param: Param, MUTABLE arg_node: Locatable, index_value: Int64) RETURNS CallArgumentFacts
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE is_give = arg_node IS_A MoveNode;
    MUTABLE inner_node_branch_value: ?Locatable = NIL;
    IF is_give THEN
      inner_node_branch_value = CAST(arg_node.value() AS Locatable);
    ELSE
      inner_node_branch_value = COPY arg_node;
    END
    MUTABLE inner_node: Locatable = inner_node_branch_value?;
    MUTABLE arg_type = &arg_node.full_type_mut("call argument");
    MUTABLE actual = arg_node.resolved_type();
    RETURN CallArgumentFacts{ site: COPY site, index: COPY index_value, param: COPY param, arg_node: COPY arg_node, is_give: is_give, inner_node: COPY inner_node, arg_type: COPY arg_type, expected_type: COPY param.type, actual_type: COPY arg_type, actual: COPY actual, path: COPY typeAnalysisSession__get_path_to_root(rtoc_self_view, castLocatableToNode(arg_node)), explicit_mutable: callSignatureSite__explicit_mutable_argument?(site, index_value), mutable_marker_token: callSignatureSite__explicit_mutable_argument_token(site, index_value) };
}
END
PRIVATE FN typeAnalysisSession__verify_copy_retained_boundary_mut(self: TypeAnalysisSession, facts: CallArgumentFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE arg = COPY facts.arg_node;
    IF arg IS_A CopyNode AS copy_node THEN
      MUTABLE copy_node_mutable = COPY copy_node;
      MUTABLE src_type = (&copy_node_mutable.value.full_type_mut("COPY source carrier") OR_ELSE NIL);
      IF !(src_type IS_A Type) THEN
        RETURN;
      END
      MUTABLE carrier: String = "";
      IF src_type.multiowned?() THEN
        carrier = "@multiowned";
      ELSE_IF type__shared?(src_type) THEN
        carrier = "@shared";
      ELSE
        carrier = "";
      END
      IF copy_node_mutable.own THEN
        copy_node_mutable.carrier_op = :shared_to_unique_copy;
        RETURN;
      END
      MUTABLE name: String = "";
      IF copy_node_mutable.value IS_A Identifier THEN
        name = COPY (CAST(copy_node_mutable.value AS Identifier)).name;
      ELSE
        name = "the value";
      END
      (TRY (typeAnalysisSession__deferred_copy_retained_validations(rtoc_self_view))).append(DeferredCopyRetainedValidation{ arg_node: Locatable{ CopyNode: COPY copy_node_mutable }, name: COPY name, carrier: COPY carrier, callee_name: COPY facts.site.node.name(), param_index: facts.index });
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__warn_monomorphic_variant_explosion_mut(self: TypeAnalysisSession, node: FunctionDef) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE count = node.params |> COUNT (_.carrier_contract == :monomorphic);
    IF (count < 3) THEN
      RETURN;
    END
    MUTABLE variants = (3 ** count);
    print("\x1B[36m[Note]\x1B[0m '${node.name}' has ${count} MONOMORPHIC parameters, so Zig may stencil up to ${variants.toString()} (3^${count}) carrier variants of it. This is a combinatoric-explosion hazard for code size and instruction cache; if the extra carriers are not needed, constrain some parameters to a concrete carrier (plain / SHARED).");
}
END
PRIVATE FN typeAnalysisSession__verify_retained_into_plain_slot_mut(self: TypeAnalysisSession, facts: CallArgumentFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE arg = COPY facts.arg_node;
    IF arg IS_A CopyNode AS copy_node THEN
      RETURN;
    END
    IF arg IS_A KeepNode AS keep_node THEN
      RETURN;
    END
    IF !(facts.param.takes) THEN
      RETURN;
    END
    MUTABLE callee_fn: ?FunctionDef@multiowned = typeAnalysisSession__function_node_for(rtoc_self_view, facts.site.node.name());
    IF callee_fn EXISTS AS callee_fn_value THEN
      MUTABLE callee_param: ?Param = NIL;
      IF callee_fn_value.params != NIL THEN
        callee_param = COPY ((callee_fn_value.params)?[facts.index] OR_ELSE NIL);
      END
      MUTABLE contract: String@symbol = facts.param.carrier_contract;
      IF callee_param != NIL THEN
        contract = callee_param.carrier_contract;
      END
      IF (((contract == :shared) OR (contract == :monomorphic)) OR (contract == :unique)) THEN
        RETURN;
      END
      MUTABLE param_type = COPY facts.param.type;
      IF (TRUE AND ((type__generic_type_parameter?(param_type) OR TRY (type__any_rc?(param_type))))) THEN
        RETURN;
      END
      IF (IF arg IS_A Identifier AS identifier THEN ((identifier.symbol != NIL) AND ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_75 = ((identifier.symbol)?);
      symbolEntry__carrier_contract(rtoc_local_receiver_75) } == :monomorphic)) ELSE FALSE END) THEN
        RETURN typeAnalysisSession__error_mut(rtoc_self_view, arg, TypeAnalysisCodeOrMessage{ SymbolValue: :RETAINED_NEEDS_OWN_COPY }, [], {:name: arg.name(), :carrier: "MONOMORPHIC", :param: facts.param.name});
      END
      MUTABLE src_type = (&arg.full_type_mut("retained plain-slot argument") OR_ELSE NIL);
      IF !(src_type IS_A Type) THEN
        RETURN;
      END
      IF type__collection?(src_type) THEN
        RETURN;
      END
      MUTABLE carrier: String = "";
      IF src_type.multiowned?() THEN
        carrier = "@multiowned";
      ELSE_IF type__shared?(src_type) THEN
        carrier = "@shared";
      ELSE
        carrier = "";
      END
      MUTABLE name: String = "";
      IF arg IS_A Identifier AS identifier THEN
        name = identifier__name(identifier);
      ELSE
        name = "the value";
      END
      typeAnalysisSession__error_mut(rtoc_self_view, arg, TypeAnalysisCodeOrMessage{ SymbolValue: :RETAINED_NEEDS_OWN_COPY }, [], {:name: name, :carrier: carrier, :param: facts.param.name});
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__verify_unique_argument_mut(self: TypeAnalysisSession, facts: CallArgumentFacts) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE arg = COPY facts.arg_node;
    IF arg IS_A CopyNode AS copy_node THEN
      RETURN;
    END
    MUTABLE callee_param = ((typeAnalysisSession__function_node_for(rtoc_self_view, facts.site.node.name()))?.params[facts.index] OR_ELSE NIL);
    MUTABLE contract: String@symbol = facts.param.carrier_contract;
    IF callee_param != NIL THEN
      contract = symbolEntry__carrier_contract(callee_param);
    END
    IF !((contract == :unique)) THEN
      RETURN;
    END
    MUTABLE src_type = (&arg.full_type_mut("UNIQUE argument carrier") OR_ELSE NIL);
    IF !(src_type IS_A Type) THEN
      RETURN;
    END
    MUTABLE carrier: String = "";
    IF src_type.multiowned?() THEN
      carrier = "@multiowned";
    ELSE_IF type__shared?(src_type) THEN
      carrier = "@shared";
    ELSE
      carrier = "";
    END
    MUTABLE name: String = "";
    IF arg IS_A Identifier AS identifier THEN
      name = identifier__name(identifier);
    ELSE
      name = "the value";
    END
    typeAnalysisSession__error_mut(rtoc_self_view, arg, TypeAnalysisCodeOrMessage{ SymbolValue: :UNIQUE_NEEDS_EXCLUSIVE }, [], {:name: name, :carrier: carrier, :param: facts.param.name});
}
END
PRIVATE FN typeAnalysisSession__verify_mutable_argument_mut(self: TypeAnalysisSession, facts: CallArgumentFacts) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(typeAnalysisSession__param_mutable?(rtoc_self_view, facts.param)) THEN
      IF facts.explicit_mutable THEN
        typeAnalysisSession__emit_unexpected_mutable_argument_error_mut(rtoc_self_view, facts);
      END
      RETURN;
    END
    MUTABLE arg_node = COPY facts.arg_node;
    MUTABLE root: ?Identifier = aST__root_identifier(arg_node);
    IF root EXISTS AS root_value THEN
      MUTABLE interior_mutable = symbolEntry__always_mutable_sync?((&arg_node.full_type_mut("mutable argument")).sync());
      IF interior_mutable THEN
        typeAnalysisSession__mark_var_mutated_via_call(rtoc_self_view, root_value.name);
        RETURN;
      END
      MUTABLE missing_marker = !(facts.explicit_mutable);
      IF missing_marker THEN
        IF (typeAnalysisSession__language_mode(rtoc_self_view) == :easy) THEN
          IF fixCollector__enabled?() THEN
            typeAnalysisSession__emit_missing_mutable_marker_error_mut(rtoc_self_view, facts, typeAnalysisSession__current_scope(rtoc_self_view));
          END
          typeAnalysisSession__promote_mutable_call_argument_mut(rtoc_self_view, root_value);
        ELSE
          typeAnalysisSession__emit_missing_mutable_marker_error_mut(rtoc_self_view, facts, typeAnalysisSession__current_scope(rtoc_self_view));
        END
      END
      IF ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_76 = typeAnalysisSession__current_scope(rtoc_self_view);
      scope__is_immutable?(rtoc_local_receiver_76, root_value.name) } AND !(missing_marker)) THEN
        IF (typeAnalysisSession__language_mode(rtoc_self_view) == :easy) THEN
          typeAnalysisSession__promote_mutable_call_argument_mut(rtoc_self_view, root_value);
        ELSE
          typeAnalysisSession__emit_immutable_arg_error_mut(rtoc_self_view, root_value, typeAnalysisSession__current_scope(rtoc_self_view), (facts.index + 1), facts.param.name);
        END
      END
      typeAnalysisSession__mark_var_mutated_via_call(rtoc_self_view, root_value.name);
    ELSE
      IF facts.explicit_mutable THEN
        typeAnalysisSession__error_mut(rtoc_self_view, arg_node, TypeAnalysisCodeOrMessage{ SymbolValue: :MUTABLE_MARKER_ON_ANONYMOUS_VALUE }, [], {:index: (facts.index + 1), :param: facts.param.name});
      END
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__promote_mutable_call_argument_mut(self: TypeAnalysisSession, arg_node: Identifier) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE entry: ?SymbolEntry@multiowned = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_77 = typeAnalysisSession__current_scope(rtoc_self_view);
    scope__resolve_entry(rtoc_local_receiver_77, arg_node.name) };
    IF entry EXISTS AS entry_value THEN
      MUTABLE entry_value_mutable = COPY entry_value;
      entry_value_mutable.mutable = TRUE;
      IF respondsTo?(entry_value_mutable.reg, "mutable=") THEN
        entry_value_mutable.reg.mutable = TRUE;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__verify_takes_argument_mut(self: TypeAnalysisSession, facts: CallArgumentFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (facts.is_give AND !(facts.param.takes)) THEN
      typeAnalysisSession__record_deferred_give_validation_mut(rtoc_self_view, facts);
    END
    IF !((facts.param.takes OR facts.is_give)) THEN
      RETURN;
    END
    MUTABLE inner_identifier_branch_value: ?Identifier = NIL;
    IF facts.inner_node IS_A Identifier THEN
      inner_identifier_branch_value = COPY castLocatableToIdentifier(facts.inner_node);
    ELSE
      inner_identifier_branch_value = NIL;
    END
    MUTABLE inner_identifier: ?Identifier = inner_identifier_branch_value;
    typeAnalysisSession__verify_owned_takes_argument_mut(rtoc_self_view, facts);
    MUTABLE container_alloc = (typeAnalysisSession__receiver_container_alloc(rtoc_self_view, facts.site.node) OR_ELSE :heap);
    MUTABLE inner_type = &facts.inner_node.full_type_mut("TAKES representation transport");
    MUTABLE give_needs_representation_copy = (facts.is_give AND ((inner_type.list_collection?() OR ((TRY (type__string?(inner_type)) AND inner_type.rodata?())))));
    MUTABLE owned_branch_value: ?Locatable = NIL;
    IF (facts.is_give AND !(give_needs_representation_copy)) THEN
      owned_branch_value = NIL;
    ELSE
      owned_branch_value = typeAnalysisSession__ensure_owned_value_mut(rtoc_self_view, &facts.inner_node, castTypeToOptionalTypeTypeInput(facts.param.type), NIL, container_alloc);
    END
    MUTABLE owned: ?Locatable = owned_branch_value;
    IF owned EXISTS AS owned_value THEN
      callSignatureSite__replace_arg_mut(facts.site, facts.index, owned_value);
    END
    MUTABLE current_arg: ?Locatable = COPY facts.site.args[facts.index];
    IF (IF current_arg? IS_A CopyNode AS copy_node THEN (container_alloc != :heap) ELSE FALSE END) THEN
      current_arg.alloc = container_alloc;
    END
    IF owned EXISTS AS owned_value THEN
      RETURN;
    END
    IF ((((((typeAnalysisSession__language_mode(rtoc_self_view) != :strict) AND !(facts.is_give)) AND (inner_identifier != NIL)) AND !(TRY (type__implicitly_copyable?((&inner_identifier.full_type_mut("pending TAKES transport")), %(name) USE(rtoc_self_view) -> typeAnalysisSession__lookup_type_schema(rtoc_self_view, name))))) AND !(facts.arg_node IS_A CopyNode)) AND !(facts.arg_node IS_A KeepNode)) THEN
      inner_identifier.ownership_pending_transfer = TRUE;
      RETURN;
    END
    typeAnalysisSession__move_if_takes_ownership_mut(rtoc_self_view, &facts.inner_node, IF facts.is_give THEN
      :give
    ELSE
      :takes
    END, facts.param.type);
    facts.inner_node.was_moved = TRUE;
    facts.arg_node.was_moved = TRUE;
    IF respondsTo?(current_arg, "was_moved=") THEN
      current_arg.was_moved = TRUE;
    END
}
END
PRIVATE FN typeAnalysisSession__verify_owned_takes_argument_mut(self: TypeAnalysisSession, facts: CallArgumentFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(typeAnalysisSession__borrowed_takes_argument?(rtoc_self_view, facts.inner_node)) THEN
      RETURN;
    END
    MUTABLE arg_ti = &facts.inner_node.full_type_mut("TAKES index argument");
    IF TRY (type__implicitly_copyable?(arg_ti, %(type) USE(rtoc_self_view) -> typeAnalysisSession__lookup_type_schema(rtoc_self_view, type))) THEN
      RETURN;
    END
    IF facts.inner_node IS_A GetIndex THEN
      typeAnalysisSession__error_mut(rtoc_self_view, facts.inner_node, TypeAnalysisCodeOrMessage{ SymbolValue: :TAKES_NEEDS_OWNED_INDEX });
    ELSE
      typeAnalysisSession__error_mut(rtoc_self_view, facts.inner_node, TypeAnalysisCodeOrMessage{ SymbolValue: :TAKES_NEEDS_OWNED_BORROW });
    END
}
END
PRIVATE FN typeAnalysisSession__verify_link_argument_mut(self: TypeAnalysisSession, facts: CallArgumentFacts) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(type__link?(facts.arg_type)) THEN
      RETURN;
    END
    IF (type__any?(facts.expected_type) OR type__link?(facts.expected_type)) THEN
      RETURN;
    END
    typeAnalysisSession__error_mut(rtoc_self_view, facts.arg_node, TypeAnalysisCodeOrMessage{ SymbolValue: :LINK_NEEDS_RESOLVE_FOR_CALL }, [], {:name: typeAnalysisSession__argument_name(rtoc_self_view, facts.arg_node, "Expression"), :param: facts.param.name});
}
END
PRIVATE FN typeAnalysisSession__verify_argument_type_mut(self: TypeAnalysisSession, facts: CallArgumentFacts, signature: FunctionSignature, MUTABLE atomic_bare_value_args: []Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (type__array?(facts.expected_type) AND type__array?(facts.actual_type)) THEN
      MUTABLE expected_element: ?Type = TRY (type__element_type(facts.expected_type));
      MUTABLE actual_element: ?Type = TRY (type__element_type(facts.actual_type));
      IF ((((expected_element != NIL) AND (actual_element != NIL)) AND (type__resolved(expected_element) == type__resolved(actual_element))) AND (type__indirect?(expected_element) != type__indirect?(actual_element))) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, facts.arg_node, TypeAnalysisCodeOrMessage{ SymbolValue: :COLLECTION_ELEMENT_LAYOUT_MISMATCH }, [], {:expected: typeAnalysisSession__collection_layout_display(rtoc_self_view, facts.expected_type), :actual: typeAnalysisSession__collection_layout_display(rtoc_self_view, facts.actual_type)});
      END
    END
    IF ((type__indirect?(facts.expected_type) AND !(type__indirect?(facts.actual_type))) AND (type__resolved(facts.expected_type) == type__resolved(facts.actual_type))) THEN
      IF !((typeAnalysisSession__language_mode(rtoc_self_view) == :easy)) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, facts.arg_node, TypeAnalysisCodeOrMessage{ SymbolValue: :INDIRECT_ARGUMENT_EXPLICIT }, [], {:index: (facts.index + 1), :expected: TRY (type__coercion_surface_name(castTypeToTypeTypeInput(facts.expected_type)))});
      END
      facts.arg_node.coerced_type = COPY facts.expected_type;
    END
    MUTABLE match = typeAnalysisSession__fn_type_argument_match?(rtoc_self_view, facts);
    typeAnalysisSession__verify_atomic_argument_mut(rtoc_self_view, facts, signature, &atomic_bare_value_args);
    IF typeAnalysisSession__shared_argument_match?(rtoc_self_view, facts, match) THEN
      match = TRUE;
    END
    IF typeAnalysisSession__basic_argument_match?(rtoc_self_view, facts) THEN
      match = TRUE;
    END
    IF match THEN
      RETURN;
    END
    typeAnalysisSession__error_mut(rtoc_self_view, facts.arg_node, TypeAnalysisCodeOrMessage{ SymbolValue: :ARGUMENT_TYPE_ERROR }, [], {:fn: typeAnalysisSession__argument_name(rtoc_self_view, facts.arg_node, "Expression"), :index: (facts.index + 1), :expected: TRY (type__coercion_surface_name(castTypeToTypeTypeInput(facts.expected_type))), :got: TRY (type__coercion_surface_name(castTypeToTypeTypeInput(facts.actual_type)))});
}
END
PRIVATE FN typeAnalysisSession__collection_layout_display(self: TypeAnalysisSession, type: Type) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE element: ?Type = TRY (type__element_type(type));
    IF element EXISTS AS element_value THEN
      MUTABLE element_name = TRY (type__surface_name_type(element_value));
      IF type__indirect?(element_value) THEN
        element_name = (element_name $+ "@boxed");
      END
      MUTABLE collection_name: String = "";
      IF type__collection(type) THEN
        collection_name = "@${type__collection(type)}";
      ELSE
        collection_name = "";
      END
      RETURN "${element_name}[]${collection_name}";
    ELSE
      RETURN TRY (type__coercion_surface_name(castTypeToTypeTypeInput(type)));
    END
}
END
PRIVATE FN typeAnalysisSession__fn_type_argument_match?(self: TypeAnalysisSession, facts: CallArgumentFacts) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(type__fn_type?(facts.expected_type)) THEN
      RETURN FALSE;
    END
    MUTABLE actual_type = &facts.arg_node.full_type_mut("fn-typed argument");
    IF TRY (type__accepts?(facts.expected_type, actual_type)) THEN
      RETURN TRUE;
    END
    IF typeAnalysisSession__reentrant_fn_argument_allowed_by_callee?(rtoc_self_view, facts) THEN
      RETURN TRUE;
    END
    IF !(typeAnalysisSession__reentrant_fn_argument_rejected?(rtoc_self_view, facts)) THEN
      RETURN FALSE;
    END
    RETURN typeAnalysisSession__error_mut(rtoc_self_view, facts.arg_node, TypeAnalysisCodeOrMessage{ SymbolValue: :REENTRANT_FN_TO_NON_REENTRANT_PARAM }, [], {:name: typeAnalysisSession__argument_name(rtoc_self_view, facts.arg_node, "Expression"), :param: facts.param.name});
}
END
PRIVATE FN typeAnalysisSession__reentrant_fn_argument_allowed_by_callee?(self: TypeAnalysisSession, facts: CallArgumentFacts) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(type__fn_type?(facts.actual_type)) THEN
      RETURN FALSE;
    END
    MUTABLE actual_sig: ?Any@multiowned = type__function_signature(facts.actual_type);
    IF actual_sig EXISTS AS actual_sig_value THEN
      IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_78 = CAST(actual_sig_value AS FunctionSignature);
      functionSignature__reentrant(rtoc_local_receiver_78) } THEN
        MUTABLE callee: ?FunctionDef@multiowned = typeAnalysisSession__function_node_for(rtoc_self_view, facts.site.name);
        IF !((IF callee != NIL THEN
          functionDef__declared_plain_reentrant?(callee)
        ELSE
          NIL
        END)) THEN
          RETURN FALSE;
        END
        RETURN ((callee.requires_clauses == NIL) OR (((callee.requires_clauses)?)[facts.param.name] != :non_reentrant));
      ELSE
        RETURN FALSE;
      END
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__reentrant_fn_argument_rejected?(self: TypeAnalysisSession, facts: CallArgumentFacts) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(type__fn_type?(facts.actual_type)) THEN
      RETURN FALSE;
    END
    MUTABLE actual_sig: ?Any@multiowned = type__function_signature(facts.actual_type);
    IF actual_sig EXISTS AS actual_sig_value THEN
      IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_79 = CAST(actual_sig_value AS FunctionSignature);
      functionSignature__reentrant(rtoc_local_receiver_79) } THEN
        MUTABLE callee: ?FunctionDef@multiowned = typeAnalysisSession__function_node_for(rtoc_self_view, facts.site.name);
        MUTABLE constraint = (IF callee != NIL THEN
          callee.requires_clauses[facts.param.name]
        ELSE
          NIL
        END);
        IF (constraint == :non_reentrant) THEN
          RETURN TRUE;
        END
        RETURN ((callee == NIL) OR (functionDef__declared_plain_reentrant?(callee) != TRUE));
      ELSE
        RETURN FALSE;
      END
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__verify_atomic_argument_mut(self: TypeAnalysisSession, facts: CallArgumentFacts, signature: FunctionSignature, MUTABLE atomic_bare_value_args: []Locatable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE arg_node = COPY facts.arg_node;
    IF typeAnalysisSession__explicit_primitive_atomic_param?(rtoc_self_view, facts.expected_type) THEN
      IF !((IF arg_node IS_A Identifier AS identifier THEN typeAnalysisSession__atomic_cell_arg?(rtoc_self_view, identifier) ELSE FALSE END)) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, arg_node, TypeAnalysisCodeOrMessage{ SymbolValue: :ARG_NEEDS_ATOMIC_CELL }, [], {:index: (facts.index + 1), :fn: facts.site.name, :expected: type__resolved(facts.expected_type), :name: typeAnalysisSession__argument_name(rtoc_self_view, arg_node, "Expression"), :actual: type__resolved(facts.actual_type)});
      END
      IF arg_node IS_A Identifier AS identifier THEN
        identifier.atomic_borrow = TRUE;
      END
    END
    IF typeAnalysisSession__atomic_cell_to_bare_value_param?(rtoc_self_view, arg_node, facts.expected_type, facts.param) THEN
      &atomic_bare_value_args.append(arg_node);
    END
    IF typeAnalysisSession__atomic_cell_to_atomic_param?(rtoc_self_view, arg_node, facts.param, signature) THEN
      IF arg_node IS_A Identifier AS identifier THEN
        identifier.atomic_borrow = TRUE;
      END
    END
}
END
PRIVATE FN typeAnalysisSession__shared_argument_match?(self: TypeAnalysisSession, facts: CallArgumentFacts, matched: Bool) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF matched THEN
      RETURN FALSE;
    END
    IF !((type__shared?(facts.expected_type) AND (type__resolved(facts.expected_type) == type__resolved(facts.actual_type)))) THEN
      RETURN FALSE;
    END
    MUTABLE arg_node = COPY facts.arg_node;
    IF !(type__shared?(facts.actual_type)) THEN
      MUTABLE hint: String = "";
      IF arg_node IS_A Identifier AS identifier THEN
        hint = " Use SHARE ${identifier__name(identifier)} to create a shared handle.";
      ELSE
        hint = " Use SHARE <expr> to create a shared handle.";
      END
      typeAnalysisSession__error_mut(rtoc_self_view, arg_node, TypeAnalysisCodeOrMessage{ SymbolValue: :ARG_NEEDS_SHARED }, [], {:index: (facts.index + 1), :fn: facts.site.name, :expected: facts.expected_type, :actual: facts.actual_type, :hint: hint});
    END
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__basic_argument_match?(self: TypeAnalysisSession, facts: CallArgumentFacts) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    typeAnalysisSession__check_prefixed_int_range_mut(rtoc_self_view, facts.arg_node, castTypeToOptionalTypeTypeInput(facts.expected_type));
    IF ((type__any?(facts.expected_type) OR (facts.actual == :Any)) OR (type__semantic_type_key(facts.expected_type) == type__semantic_type_key(facts.actual_type))) THEN
      RETURN TRUE;
    END
    IF typeAnalysisSession__any_element_collection_param?(rtoc_self_view, facts.expected_type, facts.actual_type) THEN
      RETURN TRUE;
    END
    IF TRY (type__accepts?(facts.expected_type, facts.actual_type)) THEN
      IF (TRY (type__node_reference?(facts.expected_type)) AND !(TRY (type__node_reference?(facts.actual_type)))) THEN
        facts.arg_node.coerced_type = COPY facts.expected_type;
      END
      RETURN TRUE;
    END
    IF type__auto?(facts.expected_type) THEN
      RETURN TRUE;
    END
    IF !(typeAnalysisSession__is_safe_autocast?(rtoc_self_view, ruby_wrap_optional_String_symbol_SourceType(facts.actual), castTypeToTypeTypeInput(facts.expected_type))) THEN
      RETURN FALSE;
    END
    facts.arg_node.coerced_type = COPY facts.expected_type;
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__verify_argument_aliases_mut(self: TypeAnalysisSession, facts: CallArgumentFacts, MUTABLE encountered_args: []EncounteredCallArgument) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE current_path = COPY facts.path;
    IF (current_path.length() == 0) THEN
      RETURN;
    END
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < encountered_args.length() DO
      IF !((((typeAnalysisSession__param_mutable?(rtoc_self_view, facts.param) OR encountered_args[rtoc_idx]?.mutable)) AND typeAnalysisSession__paths_overlap?(rtoc_self_view, current_path, encountered_args[rtoc_idx]?.path))) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      typeAnalysisSession__error_mut(rtoc_self_view, facts.arg_node, TypeAnalysisCodeOrMessage{ SymbolValue: :ARG_ALIAS_CONFLICT }, [], {:index: (facts.index + 1), :name: typeAnalysisSession__argument_name(rtoc_self_view, facts.arg_node, "arg"), :other_index: (rtoc_idx + 1), :path: symbol(UNWRAP (current_path.first()))});
    rtoc_idx = rtoc_idx + 1;
    END
    &encountered_args.append(EncounteredCallArgument{ path: COPY current_path, mutable: typeAnalysisSession__param_mutable?(rtoc_self_view, facts.param), name: COPY typeAnalysisSession__argument_name(rtoc_self_view, facts.arg_node, "arg") });
}
END
PRIVATE FN typeAnalysisSession__argument_name(self: TypeAnalysisSession, node: Locatable, fallback: String) RETURNS String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (node IS_A Identifier) OR (node IS_A FuncCall) OR (node IS_A MethodCall) OR (node IS_A VarDecl) OR (node IS_A BindExpr) THEN
      RETURN COPY CAST(node.name() AS String);
    ELSE_IF node IS_A GetField AS get_field THEN
      RETURN typeAnalysisSession__argument_name(rtoc_self_view, get_field.target, fallback);
    ELSE_IF node IS_A GetIndex AS get_index THEN
      RETURN typeAnalysisSession__argument_name(rtoc_self_view, get_index.target, fallback);
    ELSE
      RETURN COPY fallback;
    END
}
END
PRIVATE FN typeAnalysisSession__param_mutable?(self: TypeAnalysisSession, param: Param) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN !(!(param.mutable));
}
END
PRIVATE FN typeAnalysisSession__borrowed_takes_argument?(self: TypeAnalysisSession, node: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN aST__borrowed_ownership_view?(node);
}
END
PRIVATE FN typeAnalysisSession__any_element_collection_param?(self: TypeAnalysisSession, expected_type: Type, actual_type: Type) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE expected_elem: ?Type = TRY (type__element_type(expected_type));
    MUTABLE expected_accepts_any_element = (((TRY (type__collection_value?(expected_type)) OR type__dynamic?(expected_type))) AND ((expected_elem != NIL) AND type__any?((expected_elem?))));
    MUTABLE actual_is_collection_like = (TRY (type__collection_value?(actual_type)) OR TRY (type__runtime_stream?(actual_type)));
    RETURN !(!(((expected_accepts_any_element AND actual_is_collection_like))));
}
END
PRIVATE FN typeAnalysisSession__atomic_cell_to_bare_value_param?(self: TypeAnalysisSession, arg_node: Locatable, expected_type_obj: Type, param: Param) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF arg_node IS_A Identifier AS identifier THEN
      MUTABLE sym: ?SymbolEntry = identifier.symbol;
      IF !((IF sym != NIL THEN
        symbolEntry__atomic?(sym)
      ELSE
        NIL
      END)) THEN
        RETURN FALSE;
      END
      IF symbolEntry__indirect?(sym) THEN
        RETURN FALSE;
      END
      IF param__atomic?(param) THEN
        RETURN FALSE;
      END
      IF (IF param.symbol != NIL THEN
        symbolEntry__atomic?(param.symbol)
      ELSE
        NIL
      END) THEN
        RETURN FALSE;
      END
      IF (type__any?(expected_type_obj) OR type__fn_type?(expected_type_obj)) THEN
        RETURN FALSE;
      END
      IF (type__shared?(expected_type_obj) OR type__any_sync?(expected_type_obj)) THEN
        RETURN FALSE;
      END
      RETURN type__primitive?(expected_type_obj);
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__atomic_cell_to_atomic_param?(self: TypeAnalysisSession, arg_node: Locatable, param: Param, signature: FunctionSignature) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF arg_node IS_A Identifier AS identifier THEN
      MUTABLE sym: ?SymbolEntry = identifier.symbol;
      IF !((IF sym != NIL THEN
        symbolEntry__atomic?(sym)
      ELSE
        NIL
      END)) THEN
        RETURN FALSE;
      END
      MUTABLE ptype = COPY param.type;
      IF (TRUE AND type__atomic?(ptype)) THEN
        RETURN TRUE;
      END
      IF param__atomic?(param) THEN
        RETURN TRUE;
      END
      IF (IF param.symbol != NIL THEN
        symbolEntry__atomic?(param.symbol)
      ELSE
        NIL
      END) THEN
        RETURN TRUE;
      END
      RETURN (TRY (functionSignature__requires(signature))[param.name] OR_ELSE Set[]).contains?(:ATOMIC);
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__atomic_cell_arg?(self: TypeAnalysisSession, arg_node: Identifier) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE sym: ?SymbolEntry = COPY arg_node.symbol;
    RETURN !(!(((((sym != NIL) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_80 = (sym?);
    symbolEntry__atomic?(rtoc_local_receiver_80) }) AND !(symbolEntry__indirect?(sym))))));
}
END
PRIVATE FN typeAnalysisSession__explicit_primitive_atomic_param?(self: TypeAnalysisSession, type: Type) RETURNS ?Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (type__atomic?(type) AND type__primitive?(type));
}
END
PRIVATE FN typeAnalysisSession__warn_multi_atomic_bare_value_call_mut(self: TypeAnalysisSession, node: FunctionCallNode, atomic_args: []Locatable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE unique_args = atomic_args |> WHERE _ != NIL;
    IF (scopeBindings__length(unique_args) < 2) THEN
      RETURN;
    END
    MUTABLE names = unique_args |> SELECT (IF _ IS_A Identifier THEN
      _.name()
    ELSE
      "<expr>"
    END);
    typeAnalysisSession__warning_mut(rtoc_self_view, castFunctionCallNodeToLocatable(node), "Call to '${node.name()}' reads multiple atomic values independently (${names.join(", ")}). This is not a multi-object-consistent snapshot; default mode allows it as ordinary atomic loads. STRICT/STRICT EXTREME will require an explicit @inconsistent call-site annotation.");
}
END
PRIVATE FN typeAnalysisSession__verify_param_lifetime_mut(self: TypeAnalysisSession, arg_node: Locatable, param: Param, signature: FunctionSignature) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(arg_node IS_A Identifier) THEN
      RETURN TRUE;
    END
    IF ((param.mutable != NIL) AND !({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_81 = typeAnalysisSession__ownership_graph(rtoc_self_view);
    TRY (ownershipGraph__can_write?(rtoc_local_receiver_81, arg_node.name())) })) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, arg_node, TypeAnalysisCodeOrMessage{ SymbolValue: :MUTABLE_ARG_RESTRICTED }, [], {:name: arg_node.name()});
    END
    MUTABLE lifetime_paths = TRY (functionSignature__return_lifetime(signature));
    IF (lifetime_paths.length() == 0) THEN
      RETURN TRUE;
    END
    IF ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_82 = typeAnalysisSession__current_scope(rtoc_self_view);
    scope__is_immutable?(rtoc_local_receiver_82, arg_node.name()) } OR { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_83 = typeAnalysisSession__current_scope(rtoc_self_view);
    scope__is_restricted?(rtoc_local_receiver_83, arg_node.name()) }) THEN
      RETURN TRUE;
    END
    MUTABLE base_paths = lifetime_paths |> UNNEST (IF ruby_union_scalar_equal_FunctionSignatureLifetimeSource_String_symbol(_, :wildcard) THEN [:wildcard] ELSE [(CAST(_ AS String)).split(".").first()] END);
    IF !((base_paths.contains?(:wildcard) OR base_paths.contains?(param.name))) THEN
      RETURN TRUE;
    END
    RETURN typeAnalysisSession__error_mut(rtoc_self_view, arg_node, TypeAnalysisCodeOrMessage{ SymbolValue: :MUTABLE_PARAM_NEEDS_RESTRICT }, [], {:name: param.name, :arg: arg_node.name(), :callee: "the callee"});
}
END
PRIVATE FN typeAnalysisSession__verify_lifetime_mut(self: TypeAnalysisSession, node: FunctionDef) RETURNS ?Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rl = node.return_lifetime;
    IF (rl == NIL) THEN
      RETURN TRUE;
    END
    IF (rl == :wildcard) THEN
      typeAnalysisSession__note_mut(rtoc_self_view, Locatable{ FunctionDef: COPY node }, "Function '${node.name}' uses wildcard return lifetime `RETURNS *:T`. Every parameter is conservatively folded into the source set. Consider replacing with the explicit list of parameters whose lifetimes the return value actually depends on; `clear fix` (lint) will offer the rewrite once the audit matrix lands.");
      RETURN TRUE;
    END
    MUTABLE sources: []Any = List[];
    IF rl IS_A []Any THEN
      sources = rl;
    ELSE
      sources = [CAST(rl AS Any)];
    END
    FOR _ IN sources DO
    typeAnalysisSession__verify_lifetime_source_mut(rtoc_self_view, node, _);
    END
    typeAnalysisSession__verify_no_mixed_atomic_returned_lifetime_mut(rtoc_self_view, node, sources);
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__verify_no_mixed_atomic_returned_lifetime_mut(self: TypeAnalysisSession, node: FunctionDef, sources: []FunctionSignatureLifetimeSource) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE requires_map: {Any}Any = {};
    IF TRUE THEN
      requires_map = ((node.requires OR {}));
    ELSE
      requires_map = {};
    END
    IF (requires_map.count() == 0) THEN
      RETURN;
    END
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < sources.length() DO
      MUTABLE path = typeAnalysisSession__get_path_to_root(rtoc_self_view, castFunctionSignatureLifetimeSourceToNode(sources[rtoc_idx]?));
      IF (path.length() == 0) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE root_name = COPY CAST(path.first() AS String);
      MUTABLE families: ?Any = COPY requires_map[root_name];
      IF !((((families != NIL) AND (families IS_A [Set]Any)) AND (families.size() > 1))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !(families.contains?(:ATOMIC)) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE others = (families - ([:ATOMIC] |> DISTINCT _));
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :LIFETIME_RETURNS_REQUIRES_FAMILY_CONFLICT }, [], {:fn: node.name, :name: root_name, :others: (TRY (effectSet__to_a(others))).join(" | "), :others_label: (TRY (effectSet__to_a(others))).join(" / ")});
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PRIVATE FN typeAnalysisSession__verify_lifetime_source_mut(self: TypeAnalysisSession, node: FunctionDef, source_node: SourceNode) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE path = typeAnalysisSession__get_path_to_root(rtoc_self_view, castSourceNodeToNode(source_node));
    IF (path.length() == 0) THEN
      RETURN;
    END
    MUTABLE root_param_name = COPY CAST(symbol(UNWRAP (path.first())) AS String);
    MUTABLE param: ?Param = node.params |> FIND (_.name == root_param_name);
    IF (param == NIL) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :LIFETIME_ROOT_NOT_PARAM }, [], {:name: root_param_name});
    END
    MUTABLE current_type_name: String@symbol = type__resolved(param.type);
    MUTABLE rtoc_each_items_84 = (path |> SKIP 1);
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_84.length() DO
      MUTABLE field_name = COPY CAST(rtoc_each_items_84[rtoc_idx] AS String);
      IF (rtoc_each_items_84[rtoc_idx] == symbol("*")) THEN
          BREAK;
      END
      MUTABLE schema = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_85 = typeAnalysisSession__current_scope(rtoc_self_view);
      scope__resolve_type_definition(rtoc_local_receiver_85, current_type_name) };
      MUTABLE sf = (schema.fields()[field_name] OR schema.fields()[rtoc_each_items_84[rtoc_idx]]);
      IF (sf == NIL) THEN
          typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :LIFETIME_NO_FIELD }, [], {:type: current_type_name, :field: field_name});
      END
      current_type_name = sf.type().resolved();
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PRIVATE FN typeAnalysisSession__declare_and_verify_params(MUTABLE self: TypeAnalysisSession, node: RoutineNode) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE requires_map: {String}[Set]String@symbol = {};
    IF node IS_A FunctionDef THEN
      requires_map = (node.requires() OR {});
    ELSE
      requires_map = {};
    END
    FOR _ IN node.params() DO
    MUTABLE param_default = _.default();
    IF param_default THEN
        IF param_default IS_A DefaultLit THEN
          MUTABLE param_type_sym = _.type().resolved();
          MUTABLE schema = typeAnalysisSession__lookup_type_schema(rtoc_self_view, param_type_sym);
          IF !(schemas__struct?(schema)) THEN
            typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :DEFAULT_NEEDS_STRUCT_PARAM }, [], {:type: _.type()});
          END
          MUTABLE field_names = schema.fields().keys();
          IF !(field_names.empty?()) THEN
            MUTABLE field_defaults = ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_86 = CAST(schema AS StructSchema);
            TRY (structSchema__field_defaults(rtoc_local_receiver_86)) } OR {});
            MUTABLE missing = field_names |> WHERE !(field_defaults.key?(_));
            IF type__any?(missing) THEN
              typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :DEFAULT_STRUCT_MISSING_DEFAULTS }, [], {:name: _.name(), :type: _.type(), :missing: missing.join(", ")});
            END
          END
          TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &param_default, _.type()));
        ELSE
          TRY (typeAnalysisSession__visit(&rtoc_self_view, param_default));
          MUTABLE def_type = &param_default.full_type_mut({:context: "parameter default"});
          MUTABLE param_type = _.type();
          IF !(typeAnalysisSession__is_safe_autocast?(rtoc_self_view, def_type, param_type)) THEN
            typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :DEFAULT_VALUE_TYPE_MISMATCH }, [], {:name: _.name(), :expected: param_type, :got: def_type});
          END
        END
    END
    MUTABLE param_sync = NIL;
    IF _.sync() THEN
        param_sync = _.sync();
    ELSE_IF type__any_sync?(_.type()) THEN
        param_sync = _.type().sync();
    ELSE_IF requires_map THEN
        MUTABLE families: ?[Set]String@symbol = COPY requires_map[CAST(_.name() AS String)];
        IF families EXISTS AS families_value THEN
          MUTABLE sync_by_family = {:LOCKED: :locked, :VERSIONED: :versioned, :ATOMIC: :atomic, :SNAPSHOTTED: :versioned, :LOCAL: :local};
          MUTABLE family: ?Any = sync_by_family.keys() |> FIND families_value.contains?(_);
          IF family EXISTS AS family_value THEN
            param_sync = COPY sync_by_family[family_value];
          END
        END
    END
    MUTABLE param_layout = NIL;
    IF (param_sync == :atomic) THEN
        MUTABLE param_t = _.type();
        IF (respondsTo?(param_t, "struct?") AND param_t.struct?()) THEN
          param_layout = :indirect;
        END
    END
    MUTABLE rtoc_mutable_receiver_88 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_88, _.name(), NIL, _.type(), !(!(_.mutable())), FALSE, NIL, :stack, Set[], ( { MUTABLE rtoc_empty_list_87: []SymbolEntry@multiowned = List[]; rtoc_empty_list_87 } ), param_sync, param_layout));
    _.symbol = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_89 = typeAnalysisSession__current_scope(rtoc_self_view);
    scope__local_entry_mut(rtoc_local_receiver_89, _.name()) };
    MUTABLE rtoc_mutable_receiver_90 = aST__node__symbol(_);
    symbolEntry__set_is_param(&rtoc_mutable_receiver_90, TRUE);
    aST__node__symbol(_).param_decl_token = _.name_token();
    IF symbolEntry__carrier_contract(_) THEN
        MUTABLE rtoc_mutable_receiver_91 = aST__node__symbol(_);
        symbolEntry__set_carrier_contract(&rtoc_mutable_receiver_91, symbolEntry__carrier_contract(_));
        MUTABLE pt = _.type();
        MUTABLE retainable = (((pt IS_A Type AND !(type__collection?(pt))) AND !(TRY (type__string?(pt)))) AND !(type__primitive?(pt)));
        IF ((_.takes() AND retainable) AND (((symbolEntry__carrier_contract(_) == :polymorphic) OR (symbolEntry__carrier_contract(_) == :monomorphic)))) THEN
          MUTABLE rtoc_mutable_receiver_92 = aST__node__symbol(_);
          symbolEntry__set_carrier_polymorphic(&rtoc_mutable_receiver_92, TRUE);
        END
    END
    IF requires_map THEN
        MUTABLE fams: ?[Set]String@symbol = COPY requires_map[CAST(_.name() AS String)];
        IF ((fams != NIL) AND !(fams.empty?())) THEN
          aST__node__symbol(_).sync_families = COPY fams;
        END
    END
    IF _.takes() THEN
        MUTABLE rtoc_mutable_receiver_94 = ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_93 = typeAnalysisSession__current_scope(rtoc_self_view);
        scope__local_entry_mut(rtoc_local_receiver_93, _.name()) });
        symbolEntry__set_takes(&rtoc_mutable_receiver_94, TRUE);
    END
    typeAnalysisSession__classify_ownership_mut(rtoc_self_view, { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_95 = typeAnalysisSession__current_scope(rtoc_self_view);
    scope__local_entry_mut(rtoc_local_receiver_95, _.name()) });
    typeAnalysisSession__og_declare(rtoc_self_view, _.name(), NIL, _.type());
    IF !(_.takes()) THEN
        MUTABLE graph_node: ?OwnershipNode = COPY ownershipGraph__get_index(typeAnalysisSession__ownership_graph(rtoc_self_view), _.name());
        IF graph_node EXISTS AS graph_node_value THEN
          MUTABLE graph_node_value_mutable = COPY graph_node_value;
          graph_node_value_mutable.kind = :borrowed;
        END
    END
    _.type();
    END
    NIL;
}
END
PRIVATE FN typeAnalysisSession__verify_captures_mut(self: TypeAnalysisSession, node: RoutineNode) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE captures: Any = NIL;
    MATCH node START
      RoutineNode.FunctionDefMultiowned AS item ->
        captures = COPY item.captures;,
      RoutineNode.LambdaLit AS item ->
        captures = COPY item.captures;,
    END
    IF ((captures == NIL) OR captures.empty?()) THEN
      RETURN;
    END
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < captures.length() DO
      MUTABLE cap_name = captures[rtoc_idx].name();
      IF captures[rtoc_idx].default() THEN
          typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :CAPTURE_NO_DEFAULT }, [], {:name: cap_name});
      END
      IF !({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_96 = typeAnalysisSession__current_scope(rtoc_self_view);
      scope__entry?(rtoc_local_receiver_96, cap_name) }) THEN
          MUTABLE owner_scope: ?Scope@multiowned = typeAnalysisSession__lookup_scope_for(rtoc_self_view, cap_name);
          IF (owner_scope == NIL) THEN
            typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :CAPTURE_UNDEFINED_VAR }, [], {:name: cap_name});
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
          END
      ELSE
          MUTABLE owner_scope = typeAnalysisSession__current_scope(rtoc_self_view);
      END
      MUTABLE entry = scope__entry_for_write_mut(&owner_scope, cap_name);
      IF (captures[rtoc_idx].mutable() AND !(entry.mutable)) THEN
      IF node IS_A FunctionDef THEN
          typeAnalysisSession__emit_capture_immutable_as_mutable_error_mut(rtoc_self_view, node, cap_name, owner_scope);
      END
      END
      scope__mark_read(&owner_scope, cap_name);
      captures[rtoc_idx].type = symbolEntry__type(entry);
      captures[rtoc_idx].storage = symbolEntry__storage(entry);
    rtoc_idx = rtoc_idx + 1;
    END
    NIL;
}
END
PRIVATE FN typeAnalysisSession__declare_captures(self: TypeAnalysisSession, node: RoutineNode) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE captures: Any = NIL;
    MATCH node START
      RoutineNode.FunctionDefMultiowned AS item ->
        captures = COPY item.captures;,
      RoutineNode.LambdaLit AS item ->
        captures = COPY item.captures;,
    END
    IF ((captures == NIL) OR captures.empty?()) THEN
      RETURN;
    END
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < captures.length() DO
      MUTABLE owner_entry: ?SymbolEntry@multiowned = NIL;
      IF typeAnalysisSession__lookup_scope_for(rtoc_self_view, captures[rtoc_idx].name()) != NIL THEN
          owner_entry = COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_97 = ((typeAnalysisSession__lookup_scope_for(rtoc_self_view, captures[rtoc_idx].name()))?);
      scope__resolve_entry(rtoc_local_receiver_97, captures[rtoc_idx].name()) };
        END
      MUTABLE capture_entry = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_98 = typeAnalysisSession__current_scope(rtoc_self_view);
      TRY (scope__declare(&rtoc_mutable_receiver_98, captures[rtoc_idx].name(), NIL, captures[rtoc_idx].type(), captures[rtoc_idx].mutable(), FALSE, NIL, captures[rtoc_idx].storage())) };
      IF !(owner_entry) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      symbolEntry__inherit_ownership_identity_mut(&capture_entry, UNWRAP (owner_entry));
      capture_entry.capabilities.merge(owner_entry.capabilities);
    rtoc_idx = rtoc_idx + 1;
    END
    NIL;
}
END
PRIVATE FN typeAnalysisSession__verify_returns(self: TypeAnalysisSession, node: RoutineNode, found_returns: []ReturnFact, declared_return: ?TypeTypeInput) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE declared_type_branch_value: ?Type = NIL;
    IF (declared_return == NIL) THEN
      declared_type_branch_value = NIL;
    ELSE
      declared_type_branch_value = TRY (type__new(castOptionalTypeTypeInputToTypeConstructionInput(declared_return)));
    END
    MUTABLE declared_type: ?Type = declared_type_branch_value;
    IF (found_returns.length() > 1) THEN
      IF (IF declared_type != NIL THEN
        type__any?(declared_type)
      ELSE
        NIL
      END) THEN
        RETURN;
      END
      IF declared_type EXISTS AS declared_type_value THEN
        IF found_returns |> ALL TRY (type__accepts?(declared_type_value, TRY (type__new(castTypeToTypeConstructionInput(_.type))))) THEN
          RETURN;
        END
      END
      MUTABLE normalized = (((found_returns |> SELECT {
    MUTABLE t = COPY CAST(_.type AS String);
    ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_100: ?String@symbol = NIL;
        IF ((t.startsWith?("Byte[") OR (t == "String"))) THEN
          rtoc_ternary_value_100 = :String;
        ELSE
          rtoc_ternary_value_100 = _.type;
        END
        rtoc_ternary_value_100? })
      })) |> DISTINCT _ |> SELECT COPY _).size();
      IF (normalized > 1) THEN
        IF node IS_A FunctionDef THEN
          typeAnalysisSession__emit_ambiguous_return_error_mut(rtoc_self_view, node, found_returns);
        END
      END
    END
}
END
PRIVATE FN typeAnalysisSession__get_return_strategy(self: TypeAnalysisSession, return_type: TypeTypeInput) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE type = TRY (type__new(castTypeTypeInputToTypeConstructionInput(return_type)));
    IF (!(TRY (type__requires_move?(type))) OR type__heap?(type)) THEN
      RETURN :register;
    ELSE_IF type__void?(type) THEN
      RETURN :void;
    ELSE
      RETURN :destination_pass;
    END
}
END
PRIVATE FN typeAnalysisSession__verify_return(self: TypeAnalysisSession, MUTABLE node: Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(typeAnalysisSession__return_is_borrow?(rtoc_self_view, node)) THEN
      RETURN TRUE;
    END
    IF node IS_A GetField AS get_field THEN
    IF get_field.target IS_A Identifier THEN
      MUTABLE schema = typeAnalysisSession__lookup_type_schema(rtoc_self_view, type__to_sym(get_field.target.name()));
      IF ((schemas__union?(schema) OR schemas__enum?(schema))) THEN
        RETURN TRUE;
      END
    END
    END
    MUTABLE lifetime_paths = COPY typeAnalysisSession__current_fn_ctx_mut(rtoc_self_view).lifetime;
    MUTABLE type_info = node.type_object();
    MUTABLE has_lifetime = !((lifetime_paths.length() == 0));
    MUTABLE schema_resolver = %(t) USE(rtoc_self_view) -> typeAnalysisSession__lookup_type_schema(rtoc_self_view, t);
    MUTABLE is_copyable = (((IF type_info != NIL THEN
      type_info.copyable?(schema_resolver)
    ELSE
      NIL
    END) OR_ELSE (IF type_info != NIL THEN
      TRY (type__implicitly_copyable?(type_info, schema_resolver))
    ELSE
      NIL
    END)));
    MUTABLE is_type_param = TRY (typeAnalysisSession__current_function_type_param?(rtoc_self_view, (IF type_info != NIL THEN
      type_info.resolved()
    ELSE
      NIL
    END)));
    IF !(((has_lifetime OR is_copyable) OR is_type_param)) THEN
      typeAnalysisSession__emit_return_borrowed_no_copy_error_mut(rtoc_self_view, &node);
    END
    IF !(has_lifetime) THEN
      RETURN TRUE;
    END
    MUTABLE is_wildcard = (lifetime_paths == [:wildcard]);
    IF is_wildcard THEN
      RETURN TRUE;
    END
    IF node IS_A Identifier AS identifier THEN
      RETURN TRUE;
    END
    MUTABLE actual_path = typeAnalysisSession__get_path_to_root(rtoc_self_view, castLocatableToNode(node));
    IF (actual_path.length() == 0) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :RETURN_LIFETIME_NOT_ASSOCIATED }, [], {:sources: lifetime_paths.join(", ")});
      RETURN TRUE;
    END
    MUTABLE matched = lifetime_paths |> ANY {
    MUTABLE lifetime_syms = (CAST(_ AS String)).split(".") |> SELECT symbol(_);
    (actual_path.substr(0, (lifetime_syms.length() - 0)) == lifetime_syms)
    };
    IF !(matched) THEN
      MUTABLE sources_msg: String = "";
      IF (lifetime_paths.length() == 1) THEN
        sources_msg = "derived from: ${castOptionalFunctionContextLifetimeSourceToString(lifetime_paths.first())}";
      ELSE
        sources_msg = "derived from one of: ${lifetime_paths.join(" | ")}";
      END
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :RETURN_LIFETIME_MISMATCH }, [], {:sources_msg: sources_msg, :actual: actual_path.join(".")});
    END
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__return_is_borrow?(self: TypeAnalysisSession, node: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE plan: ?TenseOperationPlan = CAST(node.tense_plan() AS ?TenseOperationPlan);
    IF (IF plan != NIL THEN
      tenseOperationPlan__owns_result?(plan)
    ELSE
      NIL
    END) THEN
      RETURN FALSE;
    END
    IF (node IS_A FuncCall OR node IS_A MethodCall) THEN
      RETURN typeAnalysisSession__call_returns_borrowed_view?(rtoc_self_view, castLocatableToCallNode(node));
    END
    IF node IS_A Identifier AS identifier THEN
      IF !(((ownershipGraph__get_index(typeAnalysisSession__ownership_graph(rtoc_self_view), identifier__name(identifier)) != NIL) AND (((ownershipGraph__get_index(typeAnalysisSession__ownership_graph(rtoc_self_view), identifier__name(identifier)))?).kind == :borrowed))) THEN
        RETURN FALSE;
      END
      MUTABLE scope: ?Scope@multiowned = typeAnalysisSession__lookup_scope_for(rtoc_self_view, identifier__name(identifier));
      MUTABLE reg: ?SymbolEntryRegInput = NIL;
      IF (IF scope != NIL THEN
        scope__resolve_entry(scope, identifier__name(identifier))
      ELSE
        NIL
      END) != NIL THEN
        reg = COPY (((IF scope != NIL THEN
        scope__resolve_entry(scope, identifier__name(identifier))
      ELSE
        NIL
      END))?).reg;
      END
      RETURN !(!(((TRUE AND (aST__node__container_borrow(reg) == TRUE)))));
    END
    IF node IS_A GetIndex AS get_index THEN
      RETURN TRUE;
    END
    IF node IS_A GetField AS get_field THEN
      RETURN TRUE;
    END
    RETURN FALSE;
}
END
PRIVATE FN typeAnalysisSession__paths_overlap?(self: TypeAnalysisSession, path_a: []String@symbol, path_b: []String@symbol) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (path_a.first() != path_b.first()) THEN
      RETURN FALSE;
    END
    MUTABLE len = ([path_a.length(), path_b.length()]).min();
    RETURN (path_a.substr(0, (len - 0)) == path_b.substr(0, (len - 0)));
}
END
PRIVATE FN typeAnalysisSession__reject_arg_type_matches?(self: TypeAnalysisSession, MUTABLE arg: Locatable, kind: String@symbol) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE pred: ?Any@multiowned = COPY (CAST({:unsigned_integer: %(t) -> (TRUE AND type__unsigned_integer?(t))} AS {String@symbol}Any@multiowned))[kind];
    IF pred EXISTS AS pred_value THEN
      MUTABLE type = &arg.full_type_mut("intrinsic reject argument");
      IF !(type IS_A Type) THEN
        RETURN FALSE;
      END
      RETURN runtimeCallSpec__call(CAST(pred_value AS RuntimeCallSpec), type);
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__find_matching_intrinsic(self: TypeAnalysisSession, definitions: []FunctionSignature@multiowned, args: []Locatable) RETURNS !?FunctionSignature@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE matched: ?FunctionSignature@multiowned = NIL;
    MUTABLE matched_score: Int64 = -1;
    MUTABLE varargs_fallback: ?FunctionSignature@multiowned = NIL;
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < definitions.length() DO
      IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_101 = definitions[rtoc_idx]?;
      functionSignature__intrinsic_varargs?(rtoc_local_receiver_101) } THEN
          varargs_fallback = (varargs_fallback OR_ELSE definitions[rtoc_idx]?);
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE specs = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_102 = definitions[rtoc_idx]?;
      TRY (functionSignature__intrinsic_arg_specs(rtoc_local_receiver_102)) };
      IF (args.length() != specs.length()) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE all_match = {
        MUTABLE rtoc_value_block_marker = 0;
        MUTABLE rtoc_indexed_items_103: []Locatable = args;
        MUTABLE rtoc_indexed_output_105 = true;
        MUTABLE rtoc_indexed_i_104 = 0;
        WHILE rtoc_indexed_i_104 < rtoc_indexed_items_103.length() AND rtoc_indexed_output_105 DO
          rtoc_indexed_output_105 = typeAnalysisSession__intrinsic_arg_matches?(rtoc_self_view, UNWRAP (specs[rtoc_indexed_i_104]), &rtoc_indexed_items_103[rtoc_indexed_i_104]);
          rtoc_indexed_i_104 = rtoc_indexed_i_104 + 1;
        END
        rtoc_indexed_output_105
      };
      IF !(all_match) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE score = {
        MUTABLE rtoc_value_block_marker = 0;
        MUTABLE rtoc_indexed_items_106: []Locatable = args;
        MUTABLE rtoc_indexed_output_108 = 0;
        MUTABLE rtoc_indexed_i_107 = 0;
        WHILE rtoc_indexed_i_107 < rtoc_indexed_items_106.length() DO
          IF {
        MUTABLE spec = COPY UNWRAP (specs[rtoc_indexed_i_107]);
        (!(intrinsicArgSpec__unconstrained_any?(spec)) AND (rtoc_indexed_items_106[rtoc_indexed_i_107].resolved_type() == spec.type))
      } THEN
            rtoc_indexed_output_108 = rtoc_indexed_output_108 + 1;
          END
          rtoc_indexed_i_107 = rtoc_indexed_i_107 + 1;
        END
        rtoc_indexed_output_108
      };
      IF !((score > matched_score)) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      matched = KEEP definitions[rtoc_idx]?;
      matched_score = score;
    rtoc_idx = rtoc_idx + 1;
    END
    IF matched != NIL THEN
    RETURN matched;
    ELSE
    RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__intrinsic_arg_matches?(self: TypeAnalysisSession, spec: IntrinsicArgSpec, MUTABLE arg: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF intrinsicArgSpec__unconstrained_any?(spec) THEN
      RETURN TRUE;
    END
    IF (ruby_union_scalar_equal_Type_String_symbol(spec.type, symbol("Any[]")) AND typeAnalysisSession__any_array_intrinsic_arg?(rtoc_self_view, castTypeToStringSymbol(spec.type), &arg)) THEN
      RETURN TRUE;
    END
    MUTABLE cast_source: Any = arg.resolved_type();
    IF (CAST(cast_source AS String)).contains?("[") THEN
      MUTABLE full = &arg.full_type_mut("intrinsic argument");
      IF type__array?(full) THEN
        cast_source = COPY full;
      END
    END
    IF !((ruby_union_scalar_equal_Type_String_symbol(spec.type, :Any) OR typeAnalysisSession__is_safe_autocast?(rtoc_self_view, cast_source, castTypeToTypeTypeInput(spec.type)))) THEN
      RETURN FALSE;
    END
    IF !(intrinsicArgSpec__capability_constrained?(spec)) THEN
      RETURN TRUE;
    END
    MUTABLE arg_type = &arg.full_type_mut("intrinsic capability argument");
    IF ((spec.sync != NIL) AND ((IF arg_type != NIL THEN
      arg_type.sync()
    ELSE
      NIL
    END) != (spec.sync)?)) THEN
      RETURN FALSE;
    END
    IF ((spec.ownership != NIL) AND ((IF arg_type != NIL THEN
      type__ownership(arg_type)
    ELSE
      NIL
    END) != (spec.ownership)?)) THEN
      RETURN FALSE;
    END
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__any_array_intrinsic_arg?(self: TypeAnalysisSession, spec: String@symbol, MUTABLE arg: Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((spec == symbol("Any[]"))) THEN
      RETURN FALSE;
    END
    MUTABLE type = &arg.full_type_mut("intrinsic Any[] argument");
    IF type__array?(type) THEN
      RETURN TRUE;
    END
    IF !(type__future?(type)) THEN
      RETURN FALSE;
    END
    RETURN ((((TRY (type__dynamic_stream?(type)) OR type.promise_list?()) OR type.bounded_stream?()) OR TRY (type__open_stream?(type))) OR type.inf_stream?());
}
END
PRIVATE FN typeAnalysisSession__visit_Smooth(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__with_smooth_context(rtoc_self_view, %() USE(MUTABLE node, MUTABLE rtoc_self_view) -> {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.left));
    MUTABLE source_type = &node.left.full_type_mut("pipeline left");
    IF type__catch_snapshot_payload?(source_type) THEN
        typeAnalysisSession__record_body_fact_pipe_input_type_mut(rtoc_self_view, CAST(source_type.resolved() AS String));
    END
    IF typeAnalysisSession__pipe_complex_op?(rtoc_self_view, node.right) THEN
        typeAnalysisSession__analyze_higher_order_op(&rtoc_self_view, &node);
    ELSE_IF node.right IS_A FuncCall THEN
        typeAnalysisSession__analyze_pipe_to_func_call(&rtoc_self_view, &node);
    ELSE_IF node.right IS_A Identifier THEN
        typeAnalysisSession__analyze_pipe_to_identifier(&rtoc_self_view, node);
    ELSE
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :PIPE_BAD_DESTINATION });
        TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, :Any));
    END
    MUTABLE result_ti = TRY (type__from_node_mut(node, "pipeline effect recording"));
    IF !(TRY (type__inf_stream?(result_ti))) THEN
        IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
              MUTABLE rtoc_mutable_receiver_109 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
              functionContext__record_frame_use_mut(&rtoc_mutable_receiver_109);
        END
        IF ((node.storage() == :heap) OR type__heap?(result_ti)) THEN
          IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
                  MUTABLE rtoc_mutable_receiver_110 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
                  functionContext__record_heap_use_mut(&rtoc_mutable_receiver_110);
          END
          IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
                  MUTABLE rtoc_mutable_receiver_111 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
                  functionContext__record_alloc_use_mut(&rtoc_mutable_receiver_111);
          END
        END
    END
    NIL
    });
    RETURN typeAnalysisSession__smooth_depth(rtoc_self_view);
}
END
PRIVATE FN typeAnalysisSession__select_element_forces_heap_result?(self: TypeAnalysisSession, expr: Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE found: Bool = FALSE;
    aST__each_locatable(expr, %(node: Locatable) -> {
    IF node IS_A BinaryOp AS binary_op THEN
        IF binaryOp__smooth?(binary_op) THEN
          found = TRUE;
        END
    ELSE_IF node IS_A StructLit AS struct_lit THEN
        MUTABLE constructed = (TRY (inlineAllocMetadata__values(struct_lit.fields))) |> ANY ((((_ IS_A CopyNode OR _ IS_A MoveNode) OR _ IS_A FuncCall) OR _ IS_A MethodCall) OR _ IS_A StringConcat);
        IF constructed THEN
          found = TRUE;
        END
    END
    rubyToClearVoid()
    });
    RETURN found;
}
END
PRIVATE FN typeAnalysisSession__pipe_complex_op?(self: TypeAnalysisSession, node: ?Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ((aST__pipeline_complex_op?(node) OR ((node != NIL) AND (node IS_A RecoverOp))) OR ((node != NIL) AND (node IS_A CollectOp)));
}
END
PRIVATE FN typeAnalysisSession__concurrent_parallel_enabled?(self: TypeAnalysisSession, options: {String}Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE value: ?Locatable = COPY options["parallel"];
    RETURN !(!(((IF value? IS_A Identifier AS identifier THEN (["true", "TRUE"]).contains?(identifier__name(identifier)) ELSE FALSE END))));
}
END
PRIVATE FN typeAnalysisSession__stamp_observable_terminal_mut(self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node.left IS_A RangeLit THEN
      RETURN;
    END
    MUTABLE ti = &node.left.full_type_mut("pipeline left");
    IF !(((ti AND type__future?(ti)) AND ((((TRY (type__dynamic_stream?(ti)) OR ti.inf_stream?()) OR TRY (type__open_stream?(ti))) OR ti.bounded_stream?())))) THEN
      RETURN;
    END
    node.observable_terminal = TRUE;
    node.observable_dest = TRUE;
    IF node.left IS_A Identifier THEN
      node.left.was_moved = TRUE;
      TRY (typeAnalysisSession__og_set_moved(rtoc_self_view, node.left.name(), node.left.token(), :takes));
    END
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__lift_to_observable_if_terminal_mut(self: TypeAnalysisSession, MUTABLE node: BinaryOp, terminal: String@symbol, raw: String@symbol, collection: ?String@symbol = NIL) RETURNS !?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(node.observable_terminal) THEN
      RETURN;
    END
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY raw }, NIL, NIL, NIL, NIL, collection, NIL, NIL, TRUE, terminal))));
}
END
PRIVATE FN typeAnalysisSession__mark_observable_terminal_mut(self: TypeAnalysisSession, MUTABLE node: BinaryOp, terminal: String@symbol, raw: String@symbol, collection: ?String@symbol = NIL) RETURNS ?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    typeAnalysisSession__stamp_observable_terminal_mut(rtoc_self_view, &node);
    RETURN CAST(typeAnalysisSession__lift_to_observable_if_terminal_mut(rtoc_self_view, node, terminal, raw, collection) AS ?Type);
}
END
PRIVATE FN typeAnalysisSession__bounded_stream_source?(self: TypeAnalysisSession, MUTABLE node: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (&node.full_type_mut("pipeline result")).bounded_stream?();
}
END
PRIVATE FN typeAnalysisSession__pipeline_source_fact(self: TypeAnalysisSession, source: Locatable, source_type: Type, include_inf_stream: Bool = FALSE) RETURNS !PipelineSourceFact
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (include_inf_stream AND TRY (type__inf_stream?(source_type))) THEN
      MUTABLE item = (IF TRY (type__canonical_stream_item_type(source_type)) != NIL THEN TRY (type__canonical_stream_item_type(source_type)) ELSE UNWRAP (TRY (type__inf_stream_element_type(source_type))) END);
      RETURN PipelineSourceFact{ kind: :inf_stream, item_type: COPY item };
    END
    IF source IS_A RangeLit THEN
      RETURN PipelineSourceFact{ kind: :range, item_type: CAST(COPY typeAnalysisSession__range_element_type(rtoc_self_view, source) AS Type) };
    END
    IF TRY (type__open_stream?(source_type)) THEN
      MUTABLE item = (IF TRY (type__canonical_stream_item_type(source_type)) != NIL THEN TRY (type__canonical_stream_item_type(source_type)) ELSE UNWRAP (TRY (type__open_stream_element_type(source_type))) END);
      RETURN PipelineSourceFact{ kind: :open_stream, item_type: COPY item };
    END
    IF TRY (type__dynamic_stream?(source_type)) THEN
      MUTABLE item = (IF TRY (type__canonical_stream_item_type(source_type)) != NIL THEN TRY (type__canonical_stream_item_type(source_type)) ELSE UNWRAP (TRY (type__element_type((TRY (type__tense_type(source_type)))))) END);
      RETURN PipelineSourceFact{ kind: :dynamic_stream, item_type: COPY item };
    END
    IF TRY (type__bounded_stream?(source_type)) THEN
      MUTABLE item = (IF TRY (type__canonical_stream_item_type(source_type)) != NIL THEN TRY (type__canonical_stream_item_type(source_type)) ELSE UNWRAP (TRY (type__element_type((TRY (type__tense_type(source_type)))))) END);
      RETURN PipelineSourceFact{ kind: :bounded_stream, item_type: COPY item };
    END
    MUTABLE element_type: ?Type = TRY (type__element_type(source_type));
    IF (TRY (type__linear_collection?(source_type)) AND (element_type != NIL)) THEN
      RETURN PipelineSourceFact{ kind: :collection, item_type: COPY element_type };
    END
    RETURN PipelineSourceFact{ kind: :invalid, item_type: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })) };
}
END
PRIVATE FN typeAnalysisSession__has_catch_blocks?(self: TypeAnalysisSession) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fn_name: ?String = COPY typeAnalysisSession__current_fn_ctx(rtoc_self_view)?.name;
    MUTABLE fn_nodes = TRY (typeAnalysisSession__function_node_map(rtoc_self_view));
    MUTABLE fn_branch_value: ?FunctionDef@multiowned = NIL;
    IF fn_name EXISTS AS fn_name_value THEN
      fn_branch_value = COPY fn_nodes[fn_name_value];
    ELSE
      fn_branch_value = NIL;
    END
    MUTABLE fn: ?FunctionDef@multiowned = fn_branch_value;
    IF fn EXISTS AS fn_value THEN
      RETURN typeAnalysisSession__function_has_catch_clauses?(rtoc_self_view, CAST(fn_value AS FunctionDef));
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__analyze_higher_order_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (node.right IS_A SelectOp) OR (node.right IS_A WhereOp) OR (node.right IS_A IndexOp) OR (node.right IS_A OrderByOp) THEN
      typeAnalysisSession__analyze_select_family_op(&rtoc_self_view, &node);
    ELSE_IF (node.right IS_A ReduceOp) THEN
      typeAnalysisSession__analyze_reduce_op(&rtoc_self_view, &node);
    ELSE_IF (node.right IS_A LimitOp) THEN
      typeAnalysisSession__analyze_limit_op(&rtoc_self_view, &node);
    ELSE_IF (node.right IS_A UnnestOp) THEN
      typeAnalysisSession__analyze_unnest_op(&rtoc_self_view, &node);
    ELSE_IF (node.right IS_A DistinctOp) THEN
      typeAnalysisSession__analyze_distinct_op(&rtoc_self_view, &node);
    ELSE_IF (node.right IS_A EachOp) THEN
      typeAnalysisSession__analyze_each_op(&rtoc_self_view, &node);
    ELSE_IF (node.right IS_A FindOp) THEN
      typeAnalysisSession__analyze_find_op(&rtoc_self_view, &node);
    ELSE_IF (node.right IS_A AnyOp) THEN
      typeAnalysisSession__analyze_any_op(&rtoc_self_view, &node);
    ELSE_IF (node.right IS_A AllOp) THEN
      typeAnalysisSession__analyze_all_op(&rtoc_self_view, &node);
    ELSE_IF (node.right IS_A CountOp) THEN
      typeAnalysisSession__analyze_count_op(&rtoc_self_view, &node);
    ELSE_IF (node.right IS_A SumOp) THEN
      typeAnalysisSession__analyze_sum_op(&rtoc_self_view, &node);
    ELSE_IF (node.right IS_A AverageOp) THEN
      typeAnalysisSession__analyze_average_op(&rtoc_self_view, &node);
    ELSE_IF (node.right IS_A MinOp) THEN
      typeAnalysisSession__analyze_min_op(&rtoc_self_view, &node);
    ELSE_IF (node.right IS_A MaxOp) THEN
      typeAnalysisSession__analyze_max_op(&rtoc_self_view, &node);
    ELSE_IF (node.right IS_A ConcurrentOp) THEN
      typeAnalysisSession__analyze_concurrent_op(&rtoc_self_view, &node);
    ELSE_IF (node.right IS_A ShardOp) THEN
      typeAnalysisSession__analyze_shard_op(&rtoc_self_view, &node);
    ELSE_IF (node.right IS_A SkipOp) THEN
      typeAnalysisSession__analyze_skip_op(&rtoc_self_view, &node);
    ELSE_IF (node.right IS_A TapOp) THEN
      typeAnalysisSession__analyze_tap_op(&rtoc_self_view, &node);
    ELSE_IF (node.right IS_A TakeWhileOp) THEN
      typeAnalysisSession__analyze_take_while_op(&rtoc_self_view, &node);
    ELSE_IF (node.right IS_A WindowOp) THEN
      typeAnalysisSession__analyze_window_op(&rtoc_self_view, &node);
    ELSE_IF (node.right IS_A BatchWindowOp) THEN
      typeAnalysisSession__analyze_batch_window_op(&rtoc_self_view, &node);
    ELSE_IF (node.right IS_A JoinOp) THEN
      typeAnalysisSession__analyze_join_op(&rtoc_self_view, &node);
    ELSE_IF (node.right IS_A RecoverOp) THEN
      typeAnalysisSession__analyze_recover_op(&rtoc_self_view, &node);
    ELSE_IF (node.right IS_A CollectOp) THEN
      typeAnalysisSession__analyze_collect_op(rtoc_self_view, &node);
    END
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node.right, &node.full_type_mut("pipeline result")));
}
END
PRIVATE FN typeAnalysisSession__annotate_pipeline_expression_mut(MUTABLE self: TypeAnalysisSession, parent: Locatable, MUTABLE expression: Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, expression));
    IF expression IS_A IfStatement AS if_statement THEN
      MUTABLE if_statement_mutable = COPY if_statement;
      typeAnalysisSession__promote_to_expr_if_mut(rtoc_self_view, parent, &if_statement_mutable);
    END
    IF expression IS_A MatchStatement AS match_statement THEN
      MUTABLE match_statement_mutable = COPY match_statement;
      typeAnalysisSession__promote_to_expr_match_mut(rtoc_self_view, parent, &match_statement_mutable);
    END
}
END
PRIVATE FN typeAnalysisSession__analyze_collect_op(self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE lhs_t = &node.left.full_type_mut("pipeline left");
    IF !((((lhs_t != NIL) AND type__future?((lhs_t?))) AND type__observable?(lhs_t))) THEN
      MUTABLE ty: String = "<unknown>";
      IF lhs_t != NIL THEN
        ty = lhs_t.resolved();
      END
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :COLLECT_NEEDS_OBSERVABLE }, [], {:got: ty});
    END
    IF node.left IS_A Identifier THEN
      TRY (typeAnalysisSession__og_set_moved(rtoc_self_view, node.left.name(), node.left.token(), :collect));
    END
    MUTABLE inner = (IF lhs_t != NIL THEN
      TRY (type__tense_type(lhs_t))
    ELSE
      NIL
    END);
    IF (((lhs_t != NIL) AND type__observable?((lhs_t?))) AND ((inner != NIL) AND type__array?((inner?)))) THEN
      MUTABLE elem_sym = type__to_sym(inner.element_type());
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("${elem_sym}[]") }))));
      node.storage = :heap;
      RETURN :heap;
    ELSE
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, IF inner THEN
        inner.resolved()
      ELSE
        :Any
      END));
      node.storage = :stack;
      RETURN :stack;
    END
}
END
PRIVATE FN typeAnalysisSession__analyze_select_family_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE is_filter = aST__pipeline_select_filter_op?(node.right);
    MUTABLE lhs_type = &node.left.full_type_mut("pipeline left");
    MUTABLE source = typeAnalysisSession__pipeline_source_fact(rtoc_self_view, node.left, lhs_type, is_filter);
    MUTABLE is_stream = (pipelineSourceFact__stream?(source) AND ((is_filter OR node.right IS_A IndexOp)));
    typeAnalysisSession__require_array_input_mut(rtoc_self_view, node, "SELECT", is_stream, is_stream);
    MUTABLE item_type = COPY source.item_type;
    MUTABLE selector_effect: ?SelectorEffectFact = NIL;
    typeAnalysisSession__with_new_scope(rtoc_self_view, %() USE(item_type, node, MUTABLE selector_effect, source, rtoc_self_view) -> {
    MUTABLE rtoc_mutable_receiver_112 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_112, "_", NIL, castTypeToOptionalSymbolEntryTypeInput(item_type), ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    IF (node.right IS_A SelectOp AND ((pipelineSourceFact__stream?(source) OR node.right.stream_mode()))) THEN
        MUTABLE analysis = typeAnalysisSession__with_fiber_capture_analysis(rtoc_self_view, FALSE, %() USE(item_type, node, rtoc_self_view) -> {
      typeAnalysisSession__with_soa_tracking(rtoc_self_view, node, item_type, %() USE(node, rtoc_self_view) -> typeAnalysisSession__annotate_pipeline_expression_mut(&rtoc_self_view, node.right, node.right.expression()));
      rubyToClearVoid()
        });
        node.right.capture_analysis = (typeAnalysisSession__validate_capture_analysis_mut(rtoc_self_view, castLocatableToNode(node.right), analysis, FALSE, FALSE) OR_ELSE analysis);
    ELSE
        typeAnalysisSession__with_soa_tracking(rtoc_self_view, node, item_type, %() USE(node, rtoc_self_view) -> typeAnalysisSession__annotate_pipeline_expression_mut(&rtoc_self_view, node.right, node.right.expression()));
    END
    selector_effect = typeAnalysisSession__selector_effect_fact(rtoc_self_view, node.right.expression());
    IF node.right IS_A WhereOp THEN
      RETURN typeAnalysisSession__validate_where_effect_contract_mut(rtoc_self_view, castLocatableToWhereOp(node.right), UNWRAP (selector_effect));
    ELSE_IF node.right IS_A SelectOp THEN
      typeAnalysisSession__validate_select_effect_contract_mut(rtoc_self_view, castLocatableToSelectOp(node.right), UNWRAP (selector_effect));
      IF (pipelineSourceFact__inf_stream?(source) AND pipelinePlaceholderUsage__moved_placeholder?(node.right.expression())) THEN
        RETURN typeAnalysisSession__error_mut(rtoc_self_view, node.right, TypeAnalysisCodeOrMessage{ SymbolValue: :INF_STREAM_SELECT_MOVES_ITEM });
      END
    END
    NIL
    });
    IF (node.right IS_A SelectOp) THEN
      MUTABLE effect = selector_effect?;
      MUTABLE result_type =     IF (pipelineSourceFact__stream?(source) OR node.right.stream_mode()) THEN
        typeAnalysisSession__select_stream_result_type(rtoc_self_view, lhs_type, source, effect)
      ELSE_IF selectorEffectFact__asynchronous(effect) THEN
        TRY (type__promise_list_of(TypeTypeInput{ Type: COPY TRY (selectorEffectFact__leaf_type(effect)) }))
      ELSE
        TRY (type__array_of(TypeTypeInput{ Type: COPY selectorEffectFact__value_type(effect) }))
      END;
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, result_type));
    ELSE_IF (node.right IS_A WhereOp) THEN
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, IF pipelineSourceFact__inf_stream?(source) THEN
        symbol("~${castTypeToString(item_type)}[INF]")
      ELSE
        symbol("${castTypeToString(item_type)}[]")
      END));
    ELSE_IF (node.right IS_A IndexOp) THEN
      MUTABLE key_type = node.right.expression().resolved_type();
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("HashMap<${castTypeToString(item_type)}[]>") }))));
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node.right, key_type));
    ELSE_IF (node.right IS_A OrderByOp) THEN
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("${castTypeToString(item_type)}[]") }))));
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node.right, node.right.expression().resolved_type()));
    END
    node.storage = IF type__promise_list?((&node.full_type_mut("pipeline result storage"))) THEN
      :heap
    ELSE
      :frame
    END;
    IF (((node.storage() == :frame) AND node.right IS_A SelectOp) AND typeAnalysisSession__select_element_forces_heap_result?(rtoc_self_view, node.right.expression())) THEN
      node.storage = :heap;
    END
    IF !(pipelineSourceFact__inf_stream?(source)) THEN
      IF (node.storage() == :heap) THEN
        IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
                MUTABLE rtoc_mutable_receiver_113 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
                functionContext__record_heap_use_mut(&rtoc_mutable_receiver_113);
        END
        IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
                MUTABLE rtoc_mutable_receiver_114 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
                functionContext__record_alloc_use_mut(&rtoc_mutable_receiver_114);
        END
      ELSE
        IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
                MUTABLE rtoc_mutable_receiver_115 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
                functionContext__record_frame_use_mut(&rtoc_mutable_receiver_115);
        END
      END
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__select_stream_result_type(self: TypeAnalysisSession, source_type: Type, source: PipelineSourceFact, effect: SelectorEffectFact) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE cardinality =   IF (pipelineSourceFact__stream?(source) AND source_type.shape.expression.kind IS_A StreamTypeExpression) THEN
      (CAST(source_type.shape.expression.kind AS StreamTypeExpression)).cardinality
    ELSE
      :FINITE
    END;
    RETURN CAST(TRY (tenseSelectorPlan__stream_result_type(effect.plan, cardinality)) AS Type);
}
END
PRIVATE FN typeAnalysisSession__selector_effect_fact(self: TypeAnalysisSession, MUTABLE expression: Locatable) RETURNS !SelectorEffectFact
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE expression_type = &expression.full_type_mut("pipeline selector expression");
    MUTABLE recoverable: ?Type@multiowned = typeAnalysisSession__recoverable_result_type(rtoc_self_view, &expression, "pipeline selector recovery");
    MUTABLE wrapped = (recoverable OR_ELSE expression_type);
    RETURN SelectorEffectFact{ plan: COPY TRY (tenseOperationPlanner__selector(wrapped)) };
}
END
PRIVATE FN typeAnalysisSession__validate_select_effect_contract_mut(self: TypeAnalysisSession, MUTABLE op: SelectOp, effect: SelectorEffectFact) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    op.tense_plan = COPY effect.plan;
    MUTABLE declared_order = COPY CAST(op.modifier_order AS String);
    MUTABLE required_order = selectorEffectFact__required_order(effect);
    IF (declared_order == required_order) THEN
      IF selectorEffectFact__fallible?(effect) THEN
        typeAnalysisSession__retain_select_error_channel_mut(rtoc_self_view, op.expression);
      END
      RETURN;
    END
    MUTABLE expected_selector: String = "";
    IF (required_order.length() == 0) THEN
      expected_selector = "SELECT";
    ELSE
      expected_selector = "SELECT:${required_order}";
    END
    IF (declared_order.length() == 0) THEN
      MUTABLE fixes = [TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :INSERT_SELECT_EFFECT_ANNOTATION, {:selector: DiagnosticKwValue{ StringValue: COPY expected_selector }}), [edit__new(span__new(NIL, op.token.line, (op.token.column + (TRY (token__text_mut(op.token))).codepointCount()), 0), ":${required_order}")], :auto))];
      typeAnalysisSession__fixable_mut(rtoc_self_view, op, :type, fixes, NIL, :SELECT_EFFECT_ANNOTATION_REQUIRED, :error, TRUE, {:got: TRY (type__surface_name_type(CAST(selectorEffectFact__value_type(effect) AS Type))), :selector: expected_selector});
      RETURN;
    END
    typeAnalysisSession__error_mut(rtoc_self_view, op, TypeAnalysisCodeOrMessage{ SymbolValue: :SELECT_EFFECT_ANNOTATION_MISMATCH }, [], {:declared: declared_order, :got: TRY (type__surface_name_type(CAST(selectorEffectFact__value_type(effect) AS Type))), :expected: expected_selector});
}
END
PRIVATE FN typeAnalysisSession__retain_select_error_channel_mut(self: TypeAnalysisSession, expression: Locatable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF respondsTo?(expression, "retain_error_channel=") THEN
      expression.retain_error_channel = TRUE;
    END
}
END
PRIVATE FN typeAnalysisSession__select_effect_suffix(self: TypeAnalysisSession, mode: ?String@symbol) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (mode == :fallible) THEN
      RETURN "!";
    ELSE_IF (mode == :optional) THEN
      RETURN "?";
    ELSE_IF (mode == :fallible_optional) THEN
      RETURN "!?";
    ELSE
      RETURN "";
    END
}
END
PRIVATE FN typeAnalysisSession__validate_where_effect_contract_mut(self: TypeAnalysisSession, op: WhereOp, effect: SelectorEffectFact) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF ((!(selectorEffectFact__asynchronous(effect)) AND (selectorEffectFact__required_mode(effect) == NIL)) AND (type__resolved(selectorEffectFact__value_type(effect)) == :Bool)) THEN
      RETURN;
    END
    typeAnalysisSession__error_mut(rtoc_self_view, op, TypeAnalysisCodeOrMessage{ SymbolValue: :WHERE_NEEDS_BOOL }, [], {:got: TRY (type__surface_name_type(CAST(selectorEffectFact__value_type(effect) AS Type)))});
}
END
PRIVATE FN typeAnalysisSession__analyze_take_while_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lhs_type = &node.left.full_type_mut("pipeline left");
    MUTABLE source = typeAnalysisSession__pipeline_source_fact(rtoc_self_view, node.left, lhs_type, TRUE);
    MUTABLE is_stream = pipelineSourceFact__stream?(source);
    typeAnalysisSession__require_array_input_mut(rtoc_self_view, node, "TAKE_WHILE", is_stream, is_stream);
    MUTABLE item_type = COPY source.item_type;
    typeAnalysisSession__with_new_scope(rtoc_self_view, %() USE(item_type, node, rtoc_self_view) -> {
    MUTABLE rtoc_mutable_receiver_116 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_116, "_", NIL, castTypeToOptionalSymbolEntryTypeInput(item_type), ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    typeAnalysisSession__annotate_pipeline_expression_mut(&rtoc_self_view, node.right, node.right.expression())
    });
    IF !((node.right.expression().resolved_type() == :Bool)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node.right, TypeAnalysisCodeOrMessage{ SymbolValue: :TAKE_WHILE_NEEDS_BOOL }, [], {:got: node.right.expression().resolved_type()});
    END
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, IF pipelineSourceFact__inf_stream?(source) THEN
      symbol("~${castTypeToString(item_type)}[INF]")
    ELSE
      symbol("${castTypeToString(item_type)}[]")
    END));
    node.storage = :frame;
    IF !(pipelineSourceFact__inf_stream?(source)) THEN
      IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
            MUTABLE rtoc_mutable_receiver_117 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
            functionContext__record_frame_use_mut(&rtoc_mutable_receiver_117);
      END
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__analyze_window_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__require_array_input_mut(rtoc_self_view, node, "WINDOW");
