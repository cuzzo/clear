PRIVATE FN typeAnalysisSession__validate_moved_values_not_reused_by_loop_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: Node, body: Body, pre_loop_states: LightweightSnapshot, code: String@symbol, ignored_name: ?String = NIL) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_each_items_361 = (TRY (typeAnalysisSession__collect_body_identifier_names(&rtoc_self_view, castBodyToNodes(body))));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_361.length() DO
      IF (rtoc_each_items_361[rtoc_idx] == ignored_name) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !((lightweightSnapshot__state_for(pre_loop_states, UNWRAP (rtoc_each_items_361[rtoc_idx])) == :live)) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE rtoc_graph_14235 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
      MUTABLE graph_node: ?OwnershipNode = COPY ownershipGraph__get_index(rtoc_graph_14235, UNWRAP (rtoc_each_items_361[rtoc_idx]));
      IF !(((graph_node != NIL) AND (graph_node.state == :moved))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF typeAnalysisSession__captured_move_consumed_by_loop?(&rtoc_self_view, UNWRAP (rtoc_each_items_361[rtoc_idx])) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF TRY (typeAnalysisSession__loop_value_copyable?(&rtoc_self_view, UNWRAP (rtoc_each_items_361[rtoc_idx]))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      TRY (typeAnalysisSession__emit_use_of_moved_in_loop_error_mut(&rtoc_self_view, &node, UNWRAP (rtoc_each_items_361[rtoc_idx]), graph_node, code));
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PRIVATE FN typeAnalysisSession__captured_move_consumed_by_loop?(MUTABLE self: TypeAnalysisSession, name: String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE graph = typeAnalysisSession__ownership_graph(&rtoc_self_view);
    IF ownershipGraph__get_index(graph, name) EXISTS AS graph_node THEN
      IF !((graph_node.move_action == :capture)) THEN
        RETURN FALSE;
      END
      IF typeAnalysisSession__current_capture_context(&rtoc_self_view)?.analysis EXISTS AS analysis THEN
        RETURN analysis.captures.contains?(name);
      END
    END
    RETURN FALSE;
}
