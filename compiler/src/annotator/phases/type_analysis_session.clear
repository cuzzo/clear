  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE previous: ?Locatable = COPY rtoc_self_view.current_if_is_a_condition;
  DEFER rtoc_self_view.current_if_is_a_condition = previous;
  rtoc_self_view.current_if_is_a_condition = COPY condition;
  blk();
}
END
PRIVATE FN typeAnalysisSession__annotate_runtime_is_a_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: IsA) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.left));
    MUTABLE subject_type = TRY (aST__full_type_mut(node.left));
    MUTABLE type_name_branch_value: ?String@symbol = NIL;
    IF type__generic_instance?(subject_type) THEN
      type_name_branch_value = type__generic_base(subject_type);
    ELSE
      type_name_branch_value = type__resolved(subject_type);
    END
    MUTABLE type_name: String@symbol = type_name_branch_value?;
    MUTABLE schema: ?MatchSchema = CAST(TRY (typeAnalysisSession__lookup_type_schema(&rtoc_self_view, type_name)) AS ?MatchSchema);
    IF !(schemas__union?(castOptionalMatchSchemaToOptionalSchemaValue(schema))) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY node.left }, TypeAnalysisCodeOrMessage{ SymbolValue: :IS_A_RUNTIME_NEEDS_UNION }, [], {:got: CAST(subject_type AS String)}));
    END
    MUTABLE union_schema: UnionSchema@multiowned = castOptionalMatchSchemaToUnionSchemaMultiowned(schema);
    MUTABLE subst = TRY (typeAnalysisSession__match_union_substitution(&rtoc_self_view, subject_type, MatchSchema{ UnionSchemaMultiowned: COPY union_schema }, TRUE));
    MUTABLE variant_name = TRY (typeAnalysisSession__resolve_runtime_is_a_variant_mut(&rtoc_self_view, &node, union_schema, type_name, subst));
    node.runtime_variant_name = variant_name;
    TRY (typeAnalysisSession__stamp_runtime_is_a_target_mut(&rtoc_self_view, castIsARightToNodeOrType(node.right), type_name));
    MUTABLE binding: ?String = COPY node.binding;
    IF !(binding) THEN
      RETURN;
    END
    MUTABLE raw_payload: ?MatchPayload = typeAnalysisSession__runtime_union_payload(&rtoc_self_view, union_schema, variant_name);
    IF raw_payload EXISTS AS raw_payload_value THEN
      MUTABLE match_case = MatchCase{ kind: :eq, value: COPY castIsARightToLocatable(node.right), binding: COPY binding, body: COPY List[], destructure: NIL, extra_values: List[], indirect_payload_as: FALSE };
      node.runtime_payload_type = TRY (typeAnalysisSession__match_payload_binding_type(&rtoc_self_view, MatchSubjectPlan{ expr_type: COPY subject_type, type_name: COPY type_name, schema: MatchSchema{ UnionSchemaMultiowned: COPY union_schema }, enum_subject: FALSE, union_subject: TRUE, union_subst: COPY subst }, variant_name, raw_payload_value, &match_case));
      node.runtime_indirect_payload_as = match_case.indirect_payload_as;
    ELSE
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ IsA: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :MATCH_UNIT_CAPTURE }, [], CAST({:binding: binding, :variant: variant_name} AS {String@symbol}Any)));
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__resolve_runtime_is_a_variant_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: IsA, schema: UnionSchema, union_type: String@symbol, union_subst: {String@symbol}String@symbol) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE target_names = TRY (typeAnalysisSession__runtime_is_a_target_names(rtoc_self_view, &node.castIsARightToNode(right)));
    MUTABLE variant_key = (target_names |> SELECT:? typeAnalysisSession__runtime_union_variant_key(&rtoc_self_view, schema, _) |> WHERE _ != NIL).first();
    IF variant_key THEN
      RETURN COPY CAST(variant_key AS String);
    END
    MUTABLE payload_matches = schema.variants.keys() |> WHERE {
    MUTABLE payload: ?MatchPayload = TRY (typeAnalysisSession__normalized_runtime_match_payload(&rtoc_self_view, castOptionalSchemasUnionSchemaVariantValueToOptionalMatchPayload(schema.variants[_]), union_subst));
    TRY (typeAnalysisSession__runtime_is_a_payload_matches?(&rtoc_self_view, payload, target_names, union_type, CAST(_ AS String)))
    };
    IF (payload_matches.length() == 1) THEN
      RETURN COPY CAST(payload_matches.first() AS String);
    ELSE_IF (payload_matches.length() > 1) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ IsA: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :IS_A_RUNTIME_AMBIGUOUS_PAYLOAD }, [], CAST({:target: TRY (typeAnalysisSession__runtime_is_a_target_label(&rtoc_self_view, UNWRAP (castIsARightToNode(node.right)))), :union: union_type, :variants: ((payload_matches |> SELECT _.toString()) |> ORDER_BY _).join(", ")} AS {String@symbol}Any)));
    END
    RETURN TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ IsA: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :IS_A_RUNTIME_UNKNOWN_VARIANT }, [], CAST({:target: TRY (typeAnalysisSession__runtime_is_a_target_label(&rtoc_self_view, &node.castIsARightToNode(right))), :union: union_type} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__runtime_is_a_target_names(self: TypeAnalysisSession, MUTABLE node: Node) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE segments = TRY (typeAnalysisSession__runtime_is_a_target_segments(rtoc_self_view, &node));
    MUTABLE full = segments.join(".");
    MUTABLE names: []String = [COPY full];
    IF segments.last() EXISTS AS last_segment THEN
      &names.append(COPY last_segment);
    END
    RETURN CAST((names |> DISTINCT _) AS []String);
}
END
PRIVATE FN typeAnalysisSession__runtime_is_a_target_segments(self: TypeAnalysisSession, MUTABLE node: Node) RETURNS ![]String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A Type AS type THEN
      RETURN CAST([TRY (type__coercion_surface_name(castTypeToTypeTypeInput__type_analysis_session(type)))] AS []String);
    ELSE_IF node IS_A Identifier AS identifier THEN
      RETURN CAST([identifier__name(identifier)] AS []String);
    ELSE_IF node IS_A GetField AS get_field THEN
      RETURN (typeAnalysisSession__runtime_is_a_target_segments(rtoc_self_view, castLocatableToNode__type_analysis_session(castLocatableToLocatable__type_analysis_session(get_field.target))) + [CAST(get_field.field AS String)]);
    ELSE
      RETURN CAST([CAST(UNWRAP (locatable__token(UNWRAP (castNodeToLocatable(node)))).value AS String)] AS []String);
    END
}
END
PRIVATE FN typeAnalysisSession__runtime_is_a_target_label(MUTABLE self: TypeAnalysisSession, MUTABLE node: Node) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN (TRY (typeAnalysisSession__runtime_is_a_target_segments(rtoc_self_view, &node))).join(".");
}
END
PRIVATE FN typeAnalysisSession__runtime_union_variant_key(MUTABLE self: TypeAnalysisSession, schema: UnionSchema, name: String) RETURNS ?TypeAnalysisSessionReturnValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN ruby_wrap_optional_String_symbol_TypeAnalysisSessionReturnValue(schema.variants.keys() |> FIND (CAST(_ AS String) == name));
}
END
PRIVATE FN typeAnalysisSession__runtime_union_payload(MUTABLE self: TypeAnalysisSession, schema: UnionSchema, variant_name: String) RETURNS ?MatchPayload
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE key: ?TypeAnalysisSessionReturnValue = typeAnalysisSession__runtime_union_variant_key(&rtoc_self_view, schema, variant_name);
    IF key EXISTS AS key_value THEN
      RETURN COPY castOptionalSchemasUnionSchemaVariantValueToOptionalMatchPayload(schema.variants[castControlFlowReturnValueToStringSymbol(key_value)]);
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__runtime_is_a_payload_matches?(MUTABLE self: TypeAnalysisSession, payload: ?MatchPayload, target_names: []String, union_type: String@symbol, variant_name: String) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF UNWRAP (payload) IS_A Type@multiowned AS type_multiowned THEN
      MUTABLE payload_name = TRY (type__coercion_surface_name(TypeTypeInput{ Type: COPY type_multiowned }));
      MUTABLE payload_names: [Set]String = [COPY payload_name, COPY (payload_name.split(".").last() OR_ELSE payload_name)] |> DISTINCT _;
      RETURN !(((payload_names |> WHERE target_names.contains?(_)).length() == 0));
    ELSE_IF UNWRAP (payload) IS_A InlineStructVariant@multiowned AS inline_struct_variant_multiowned THEN
      MUTABLE synthetic_name = "${union_type}_${variant_name}";
      RETURN type__any?((ruby_set_intersection_String([synthetic_name, variant_name], target_names)));
    ELSE_IF payload IS_A String@symbol AS string_symbol THEN
      MUTABLE payload_name = COPY CAST(string_symbol AS String);
      RETURN type__any?((ruby_set_intersection_String(CAST(Tuple{payload_name, payload_name.split(".").last()} AS Tuple<String, ?String>), target_names)));
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__stamp_runtime_is_a_target_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: NodeOrType, type_name: String@symbol) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node IS_A Type AS type THEN
      RETURN;
    ELSE_IF node IS_A GetField AS get_field THEN
      MUTABLE get_field_mutable = COPY get_field;
      TRY (typeAnalysisSession__stamp_runtime_is_a_target_mut(&rtoc_self_view, castNodeToNodeOrType(castLocatableToNode__type_analysis_session(get_field_mutable.target)), type_name));
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ GetField: COPY get_field_mutable }, type_name));
    ELSE_IF node IS_A Identifier AS identifier THEN
      MUTABLE identifier_mutable = COPY identifier;
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ Identifier: COPY identifier_mutable }, :Type));
    ELSE
      TRY (typeAnalysisSession__visit(&rtoc_self_view, castNodeToOptionalLocatable__type_analysis_session(castNodeOrTypeToNode(node))));
    END
}
END
PRIVATE FN typeAnalysisSession__annotate_is_a_operand_mut(MUTABLE self: TypeAnalysisSession, MUTABLE operand: IsARight, side: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF operand IS_A Type AS type THEN
      RETURN;
    END
    # Past the Type arm the operand is an AST node; the helpers below take
    # Ruby's T.any(AST::Node, Type), which is NodeOrType.
    MUTABLE node: NodeOrType = castLocatableToNodeOrType(castIsARightToLocatable(operand));
    IF TRY (typeAnalysisSession__static_type_expr?(&rtoc_self_view, &node)) THEN
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, castNodeToLocatable__type_analysis_session( castNodeOrTypeToNode(node)), :Type));
    ELSE
      TRY (typeAnalysisSession__visit(&rtoc_self_view, castNodeToOptionalLocatable__type_analysis_session(castNodeOrTypeToNode(node))));
    END
    MUTABLE type_info = TRY (aST__full_type_mut(castNodeToLocatable__type_analysis_session(castNodeOrTypeToNode(node))));
    IF (type__resolved(type_info) == :Type) THEN
      RETURN;
    END
    TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castNodeToLocatable(castNodeOrTypeToNode(node))), TypeAnalysisCodeOrMessage{ SymbolValue: :IS_A_OPERAND_NEEDS_TYPE }, [], {:side: side, :got: CAST(type_info AS String)}));
}
END
PRIVATE FN typeAnalysisSession__static_type_expr?(MUTABLE self: TypeAnalysisSession, MUTABLE node: NodeOrType) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node IS_A Type AS type THEN
      RETURN TRUE;
    ELSE_IF node IS_A Identifier AS identifier THEN
      MUTABLE name = symbol(identifier__name(identifier));
      RETURN ((TRY (typeAnalysisSession__current_function_type_param?(&rtoc_self_view, name)) OR (CAST({:Float64: "f64", :Int64: "i64", :String: "[]const u8", :Void: "void", :Bool: "bool", :Byte: "u8", :Int8: "i8", :Int16: "i16", :Int32: "i32", :UInt8: "u8", :UInt16: "u16", :UInt32: "u32", :UInt64: "u64", :Float32: "f32", :TargetInt: "c_int", :TargetUInt: "c_uint", :TargetLong: "c_long", :TargetULong: "c_ulong", :TargetLongLong: "c_longlong", :TargetULongLong: "c_ulonglong", :Any: "f64", :Range: "CheatLib.Range", :File: "CheatLib.File", :TCPServer: "i32", :TCPClient: "i32"} AS {String@symbol}String)).contains?(name)) OR !(!(TRY (typeAnalysisSession__lookup_type_schema(&rtoc_self_view, name)))));
    ELSE_IF node IS_A GetField AS MUTABLE get_field THEN
      RETURN typeAnalysisSession__static_dotted_type_expr?(&rtoc_self_view, &get_field);
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__static_dotted_type_expr?(MUTABLE self: TypeAnalysisSession, MUTABLE node: GetField) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(node.target IS_A Identifier) THEN
      RETURN FALSE;
    END
    MUTABLE namespace = COPY castLocatableToIdentifier__type_analysis_session(node.target).name;
    RETURN (namespace == "AST");
}
END
PRIVATE FN typeAnalysisSession__with_comptime_is_a_then_refinement<RESULT>(MUTABLE self: TypeAnalysisSession, condition: Locatable, blk: FN() -> RESULT) RETURNS !RESULT
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE refinement: ?[]Any@multiowned = TRY (typeAnalysisSession__comptime_is_a_type_param_refinement(&rtoc_self_view, condition));
    IF refinement EXISTS AS refinement_value THEN
      MUTABLE refinement_value_mutable = COPY refinement_value;
      MUTABLE type_param: String@symbol = CAST(refinement_value_mutable[0] AS String@symbol);
      MUTABLE narrowed_type: Type = CAST(refinement_value_mutable[1] AS Type);
      RETURN TRY (typeAnalysisSession__with_comptime_type_param_refinement(&rtoc_self_view, type_param, narrowed_type, %() USE(blk) -> blk()));
    ELSE
      RETURN blk();
    END
}
END
PRIVATE FN typeAnalysisSession__comptime_is_a_type_param_refinement(MUTABLE self: TypeAnalysisSession, condition: Locatable) RETURNS !?[]Any@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE condition_mutable = COPY condition;
    IF condition_mutable IS_A IsA AS MUTABLE is_a THEN
      MUTABLE left = is_a.left;
      IF !(left IS_A Identifier) THEN
        RETURN NIL;
      END
      MUTABLE type_param = symbol(UNWRAP (locatable__name(left)));
      IF !(TRY (typeAnalysisSession__current_function_type_param?(&rtoc_self_view, type_param))) THEN
        RETURN NIL;
      END
      MUTABLE narrowed_type: ?Type@multiowned = TRY (typeAnalysisSession__static_is_a_target_type(&rtoc_self_view, &is_a.castIsARightToNodeOrType(right)));
      IF narrowed_type EXISTS AS narrowed_type_value THEN
        RETURN CAST(Tuple{type_param, COPY narrowed_type_value} AS Tuple<String@symbol, Type@multiowned>);
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__static_is_a_target_type(MUTABLE self: TypeAnalysisSession, MUTABLE node: NodeOrType) RETURNS !?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node IS_A Type AS type THEN
      RETURN TRY (type__new(castTypeToTypeConstructionInput__type_analysis_session(type)));
    ELSE_IF node IS_A Identifier AS identifier THEN
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol(identifier__name(identifier)) }));
    ELSE_IF node IS_A GetField AS get_field THEN
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol(TRY (typeAnalysisSession__runtime_is_a_target_label(&rtoc_self_view, Node{ GetField: COPY get_field }))) }));
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__emit_is_a_needs_comptime_fix_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: IfStatement) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fix = TRY (fix__new(TRY (diagnosticRegistry__fix_description(:INSERT_COMPTIME_BEFORE_IF)), [edit__new(span__new(NIL, node.token.line, node.token.column, 0), "COMPTIME ")], :auto));
    TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ IfStatement: COPY node } }, :type, [fix], NIL, :IS_A_NEEDS_COMPTIME, :error, TRUE));
}
END
PRIVATE FN typeAnalysisSession__declare_is_a_binding_mut(MUTABLE self: TypeAnalysisSession, condition: Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF condition IS_A IsA AS is_a THEN
      MUTABLE is_a_mutable = COPY is_a;
      MUTABLE binding: ?String = is_a_mutable.binding;
      IF !(binding) THEN
        RETURN;
      END
      IF is_a_mutable.runtime_variant_name THEN
        MUTABLE payload_type: ?Type = is_a_mutable.runtime_payload_type;
        IF !(payload_type) THEN
          RETURN;
        END
        MUTABLE scope = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
        TRY (scope__declare(&scope, binding, SymbolEntryRegInput{ IsA: COPY is_a_mutable }, SymbolEntryTypeInput{ Type: COPY payload_type }, ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
        TRY (typeAnalysisSession__og_declare(&rtoc_self_view, binding, Node{ IsA: COPY is_a_mutable }, TypeTypeInput{ Type: COPY payload_type }));
        TRY (typeAnalysisSession__classify_ownership_mut(&rtoc_self_view, scope__local_entry_mut(&scope, binding)));
        TRY (typeAnalysisSession__borrow_match_payload_binding_mut(&rtoc_self_view, binding));
        RETURN;
      END
      MUTABLE rtoc_mutable_receiver_320 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
      TRY (scope__declare(&rtoc_mutable_receiver_320, binding, NIL, castTypeToOptionalSymbolEntryTypeInput__type_analysis_session(TRY (type__new(TypeConstructionInput{ SymbolValue: :Type }))), ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__visit_IfBind(MUTABLE self: TypeAnalysisSession, MUTABLE node: IfBind) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE branch_logic = [(%() USE(node, MUTABLE rtoc_self_view) -> {
    FOR MUTABLE rtoc_mutable_block_param_327 IN node.bindings DO
      IF (rtoc_mutable_block_param_327.predicate == :is_ok) THEN
          typeAnalysisSession__with_body_fact_failure_absorbed(&rtoc_self_view, TRUE, %() USE(rtoc_mutable_block_param_327, MUTABLE rtoc_self_view) -> {
        rtoc_lambda_result_321 = TRY (typeAnalysisSession__visit(&rtoc_self_view, rtoc_mutable_block_param_327.expr));
        rtoc_lambda_result_321
          });
      ELSE
          TRY (typeAnalysisSession__visit(&rtoc_self_view, rtoc_mutable_block_param_327.expr));
      END
      MUTABLE ti_branch_value: ?Type = NIL;
        IF (rtoc_mutable_block_param_327.predicate == :is_ok) THEN
          ti_branch_value = (typeAnalysisSession__recoverable_result_type(&rtoc_self_view, &rtoc_mutable_block_param_327.expr, "IF predicate binding expression") OR_ELSE TRY (type__new(TypeConstructionInput{ Type: COPY TRY (aST__full_type_mut(rtoc_mutable_block_param_327.expr)) })));
        ELSE
          ti_branch_value = TRY (type__new(TypeConstructionInput{ Type: COPY TRY (aST__full_type_mut(rtoc_mutable_block_param_327.expr)) }));
        END
      MUTABLE ti: Type = ti_branch_value?;
      MUTABLE unwrapped = TRY (typeAnalysisSession__if_bind_unwrapped_type_mut(&rtoc_self_view, &rtoc_mutable_block_param_327, ti));
      IF (rtoc_mutable_block_param_327.expr IS_A ResolveNode AND ((type__multiowned?(ti) OR type__shared?(ti)))) THEN
          TRY (type__apply_reference_ownership_mut(&unwrapped, type__ownership(ti), type__link_source(ti)));
      END
      rtoc_mutable_block_param_327.unwrapped_type = CAST(unwrapped AS Type);
      MUTABLE sym = type__resolved(unwrapped);
      MUTABLE root: ?Identifier = aST__root_identifier(rtoc_mutable_block_param_327.expr);
      MUTABLE mutable_slot_payload = (((TRY (type__struct?(unwrapped)) OR type__collection?(unwrapped))) AND !(TRY (type__any_rc?(unwrapped))));
      MUTABLE mutable_list_alias = (((rtoc_mutable_block_param_327.expr IS_A GetIndex AND (root != NIL)) AND !({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_322 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
      scope__is_immutable?(rtoc_local_receiver_322, root.name) })) AND mutable_slot_payload);
      MUTABLE rtoc_mutable_receiver_323 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
      TRY (scope__declare(&rtoc_mutable_receiver_323, rtoc_mutable_block_param_327.name, NIL, SymbolEntryTypeInput{ TypeMultiowned: COPY unwrapped }, ScopeMutabilityInput{ BoolValue: mutable_list_alias }, FALSE, NIL, :stack));
      MUTABLE entry = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_324 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
      scope__local_entry_mut(&rtoc_local_receiver_324, rtoc_mutable_block_param_327.name) };
      rtoc_mutable_block_param_327.symbol = entry;
      IF TRY (aST__capture_expr_owns_result?(rtoc_mutable_block_param_327.expr)) THEN
          symbolEntry__mark_owned_optional_capture_mut(&entry);
      END
      MUTABLE container_source: ?String = TRY (typeAnalysisSession__if_bind_container_source(&rtoc_self_view, CAST(unwrapped AS Type), &rtoc_mutable_block_param_327.expr));
      MUTABLE src_sym: ?SymbolEntry@multiowned = NIL;
      MUTABLE source_root: ?Identifier = aST__root_identifier(rtoc_mutable_block_param_327.expr);
      IF source_root EXISTS AS source_root_value THEN
          src_sym = COPY source_root_value.symbol;
      END
      IF src_sym EXISTS AS src_sym_value THEN
          MUTABLE src_sym_value_mutable = COPY src_sym_value;
          IF symbolEntry__non_escaping(src_sym_value_mutable) THEN
            symbolEntry__mark_non_escaping_mut(&entry);
          END
          IF container_source EXISTS AS container_source_value THEN
            MUTABLE container_source_value_mutable = COPY container_source_value;
            entry.lifetime = TRY (symbolEntry__tied_lifetime([src_sym_value_mutable]));
            symbolEntry__mark_borrowed_alias_mut(&entry);
          END
      END
      TRY (typeAnalysisSession__classify_ownership_mut(&rtoc_self_view, &entry));
      TRY (typeAnalysisSession__og_declare(&rtoc_self_view, rtoc_mutable_block_param_327.name, NIL, TypeTypeInput{ Type: COPY unwrapped }));
      IF container_source EXISTS AS container_source_value THEN
          MUTABLE container_source_value_mutable = COPY container_source_value;
          MUTABLE rtoc_graph_13374 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
          MUTABLE graph_node: ?OwnershipNode = COPY ownershipGraph__get_index(rtoc_graph_13374, rtoc_mutable_block_param_327.name);
          IF graph_node EXISTS AS graph_node_value THEN
            MUTABLE graph_node_value_mutable = COPY graph_node_value;
            graph_node_value_mutable.kind = :borrowed;
          END
          MUTABLE rtoc_mutable_receiver_325 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
          TRY (ownershipGraph__borrow(&rtoc_mutable_receiver_325, rtoc_mutable_block_param_327.name, container_source_value_mutable, (mutable_list_alias == TRUE)));
      END
    END
    TRY (typeAnalysisSession__visit_stmts(&rtoc_self_view, node.then_branch));
    NIL
    }), (%() USE(node, MUTABLE rtoc_self_view, MUTABLE branch_logic) -> {
    TRY (typeAnalysisSession__visit_stmts(&rtoc_self_view, node.else_branch));
    NIL
    })];
    TRY (typeAnalysisSession__analyze_control_flow_branches(&rtoc_self_view, rtoc_mutable_block_param_327));
    RETURN TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ IfBind: COPY node }, :Void));
}
END
PRIVATE FN typeAnalysisSession__if_bind_unwrapped_type_mut(MUTABLE self: TypeAnalysisSession, MUTABLE binding: Binding, type: Type) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (binding.predicate == :is_ok) THEN
      IF !(type__error_union?(type)) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY (binding).expr }, TypeAnalysisCodeOrMessage{ SymbolValue: :IS_OK_REQUIRES_FALLIBLE }, [], CAST({:got: locatable__resolved_type((binding).expr)} AS {String@symbol}Any)));
      END
      RETURN TRY (type__success_type(type));
    END
    IF TRY (type__stream_step?(type)) THEN
      binding.predicate = :stream_item;
      RETURN UNWRAP (TRY (type__stream_step_item_type(type)));
    END
    IF !(type__optional?(type)) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY binding.expr }, TypeAnalysisCodeOrMessage{ SymbolValue: :IF_AS_NEEDS_OPTIONAL }, [], CAST({:got: locatable__resolved_type(binding.expr)} AS {String@symbol}Any)));
    END
    RETURN UNWRAP (TRY (type__wrapped_type(type)));
}
END
PRIVATE FN typeAnalysisSession__if_bind_container_source(MUTABLE self: TypeAnalysisSession, type: Type, MUTABLE expression: Locatable) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (TRY (type__node_reference?(type)) OR TRY (type__implicitly_copyable?(type))) THEN
      RETURN NIL;
    END
    RETURN TRY (typeAnalysisSession__find_container_source(&rtoc_self_view, &expression));
}
END
PRIVATE FN typeAnalysisSession__annotate_struct_pattern_mut(MUTABLE self: TypeAnalysisSession, match_node: MatchStatement, MUTABLE pat: StructPattern) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE expr_type: ?String@symbol = locatable__resolved_type(UNWRAP (locatable__expr( Locatable{ MatchStatement: COPY match_node })));
    MUTABLE primitives = [:Float64, :Bool, :Byte, :Int64, :Float64, :String, symbol("NIL"), :BOOLEAN, :Any, :Void];
    IF primitives.contains?(expr_type) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ MatchStatement: COPY match_node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :MATCH_NEEDS_STRUCT_TYPE }, [], CAST({:got: expr_type} AS {String@symbol}Any)));
    END
    MUTABLE schema: ?SchemaValue = TRY (typeAnalysisSession__lookup_type_schema(&rtoc_self_view, UNWRAP (expr_type)));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < pat.fields.length() DO
      IF patternField__wildcard?(pat.fields[rtoc_idx]?) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF schema EXISTS AS schema_value THEN
          IF !(scopeScopeTypeSchema__fields(schema_value).contains?(UNWRAP (pat.fields[rtoc_idx]?.name))) THEN
            MUTABLE name_tok: ?Token@multiowned = COPY pat.fields[rtoc_idx]?.name_token;
            IF name_tok EXISTS AS name_tok_value THEN
              MUTABLE valid_fields = schemaValue__fields(UNWRAP (schema)).keys() |> WHERE !((CAST(_ AS String)).startsWith?("_"));
              TRY (typeAnalysisSession__emit_typo_suggestion_mut(&rtoc_self_view, TypoToken{ TokenMultiowned: COPY name_tok_value }, UNWRAP (pat.fields[rtoc_idx]?.name), valid_fields, "MATCH struct pattern: field '${(pat.fields[rtoc_idx]?.name OR_ELSE "")}' does not exist on type ${(expr_type OR_ELSE "")}", "field of ${(expr_type OR_ELSE "")}", :type, TRUE));
            ELSE
              TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ MatchStatement: COPY match_node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :MATCH_FIELD_UNKNOWN }, [], CAST({:field: pat.fields[rtoc_idx]?.name, :type: expr_type} AS {String@symbol}Any)));
            END
          END
      END
      IF patternField__bind?(pat.fields[rtoc_idx]?) THEN
          IF (TRUE AND schemaValue__fields(UNWRAP (schema)).contains?(UNWRAP (pat.fields[rtoc_idx]?.name))) THEN
            MUTABLE field_def: ?StructField = schemaValue__fields(UNWRAP (schema))[UNWRAP (pat.fields[rtoc_idx]?.name)];
            MUTABLE field_type = structField__type(UNWRAP (field_def));
            MUTABLE rtoc_mutable_receiver_328 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
            TRY (scope__declare(&rtoc_mutable_receiver_328, UNWRAP (pat.fields[rtoc_idx]?.name), NIL, SymbolEntryTypeInput{ Type: COPY field_type }, ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
            TRY (typeAnalysisSession__og_declare(&rtoc_self_view, UNWRAP (pat.fields[rtoc_idx]?.name), NIL, TypeTypeInput{ Type: COPY field_type }));
          END
      ELSE
          MUTABLE field_expr: ?Locatable = patternField__expr(pat.fields[rtoc_idx]?);
          TRY (typeAnalysisSession__visit(&rtoc_self_view, field_expr));
          IF schema EXISTS AS schema_value THEN
            MUTABLE field_def: ?StructField = schemaValue__fields(schema_value)[UNWRAP (pat.fields[rtoc_idx]?.name)];
            MUTABLE ft: ?Type = (IF field_def != NIL THEN
              structField__type(field_def)
            ELSE
              NIL
            END);
            MUTABLE field_type: ?String@symbol = NIL;
            IF ft EXISTS AS rtoc_ft_v THEN
              field_type = type__resolved(rtoc_ft_v);
            END
            MUTABLE val_type: ?String@symbol = locatable__resolved_type(UNWRAP (field_expr));
            MUTABLE is_numeric_promo = (((val_type == :Int64) AND (((field_type == :Float64) OR (field_type == :Float64)))));
            IF !(((((val_type == field_type) OR (val_type == :Any)) OR (field_type == :Any)) OR is_numeric_promo)) THEN
              TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ MatchStatement: COPY match_node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :MATCH_FIELD_TYPE_MISMATCH }, [], CAST({:field: pat.fields[rtoc_idx]?.name, :declared: field_type, :got: val_type} AS {String@symbol}Any)));
            END
          END
      END
    rtoc_idx = rtoc_idx + 1;
    END
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ StructPattern: COPY pat }, TRY (aST__full_type_mut(match_node.expr))));
    NIL;
}
END
