FN castLocatableToOptionalIdentifier(value: Locatable) RETURNS ?Identifier ->
  IF value IS_A Identifier AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN NIL;
END
FN castLocatableToSelectOp(value: Locatable) RETURNS SelectOp ->
  IF value IS_A SelectOp AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to SelectOp");
END
FN castLocatableToStructPattern(value: Locatable) RETURNS StructPattern ->
  IF value IS_A StructPattern AS cast_payload THEN
    RETURN cast_payload;
  END
