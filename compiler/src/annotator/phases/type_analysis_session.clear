    MUTABLE vti = node.value().full_type_mut("assignment scoped move value");
    MUTABLE needs_move = ((vti AND TRY (type__requires_move?((TRY (type__new(vti)))))) OR_ELSE TRUE);
    IF needs_move THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :MOVE_WITH_SCOPED }, [], {:name: node.value().name()});
    END
}
END
PRIVATE FN typeAnalysisSession__handle_assignment_path_move_mut(self: TypeAnalysisSession, node: Node) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    typeAnalysisSession__reject_borrowed_index_assignment_move_mut(rtoc_self_view, node);
    MUTABLE path = typeAnalysisSession__get_path_to_root(rtoc_self_view, node.value());
    IF (path.length() == 0) THEN
      RETURN;
    END
    MUTABLE value_type = TRY (type__new(node.value().resolved_type()));
    IF !(TRY (type__requires_move?(value_type))) THEN
      RETURN;
    END
    MUTABLE graph_path = (path |> SELECT _.toString()).join(".");
    IF !(ownershipGraph__get_index(typeAnalysisSession__ownership_graph(rtoc_self_view), graph_path)) THEN
      typeAnalysisSession__declare_assignment_graph_path_mut(rtoc_self_view, graph_path, value_type);
    END
    TRY (typeAnalysisSession__og_set_moved(rtoc_self_view, graph_path, node.value().token(), :move));
}
END
PRIVATE FN typeAnalysisSession__declare_assignment_graph_path_mut(self: TypeAnalysisSession, graph_path: String, value_type: Type) RETURNS !Void
