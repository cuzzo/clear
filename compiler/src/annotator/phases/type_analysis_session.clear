PRIVATE FN typeAnalysisSession__stamp_atomic_bind_assignment_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: BindExpr, target_sync: ?String@symbol) RETURNS !Void
  REQUIRES self: LOCAL
->
