  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    PARTIAL MATCH node START
      Locatable.FunctionDef AS MUTABLE function_def -> TRY (typeAnalysisSession__visit_FunctionDef(&rtoc_self_view, &function_def));,
      Locatable.LambdaLit AS MUTABLE lambda_lit -> TRY (typeAnalysisSession__visit_LambdaLit(&rtoc_self_view, &lambda_lit));,
      Locatable.BlockExpr AS MUTABLE blockexpr -> TRY (typeAnalysisSession__visit_BlockExpr(&rtoc_self_view, &blockexpr));,
