PRIVATE FN typeAnalysisSession__analyze_shard_each_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp, shard_node: ShardOp) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE conc = COPY node.right;
    MUTABLE each_op = conc.op();
    MUTABLE ti = &shard_node.target_map.full_type_mut("shard target map");
    MUTABLE key_type = (((ti.numeric_map?() AND ((TRY (type__key_type(ti)) != NIL) AND type__resolved(((TRY (type__key_type(ti)))?))))) OR :String);
    typeAnalysisSession__with_new_scope(rtoc_self_view, %() USE(each_op, key_type, MUTABLE rtoc_self_view) -> {
    MUTABLE rtoc_mutable_receiver_148 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_148, "_", NIL, key_type, ScopeMutabilityInput{ BoolValue: TRUE }, FALSE, NIL, :stack));
    FOR _ IN each_op.body() DO
    TRY (typeAnalysisSession__visit(&rtoc_self_view, _));
    END
    NIL
    });
    MUTABLE ctx = conc.shard_context();
    IF ctx THEN
      conc.shard_context = pipelineShardContext__with_frame_allocations((CAST(ctx AS PipelineShardContext)), FALSE, FALSE);
    END
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, :Void));
    node.storage = :stack;
    RETURN :stack;
}
END
PRIVATE FN typeAnalysisSession__emit_multi_map_warning(self: TypeAnalysisSession, conc: ConcurrentOp, sharded_names: [Set]String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE shard_counts = ((sharded_names |> SELECT {
    MUTABLE sc: ?Type@multiowned = NIL;
    IF (IF typeAnalysisSession__lookup_scope_for(rtoc_self_view, _) != NIL THEN
        { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_149 = (typeAnalysisSession__lookup_scope_for(rtoc_self_view, _));
    scope__resolve_entry(rtoc_local_receiver_149, _) }
      ELSE
        NIL
      END) != NIL THEN
        sc = COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_150 = (((IF typeAnalysisSession__lookup_scope_for(rtoc_self_view, _) != NIL THEN
        { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_149 = (typeAnalysisSession__lookup_scope_for(rtoc_self_view, _));
    scope__resolve_entry(rtoc_local_receiver_149, _) }
      ELSE
        NIL
      END))?);
    symbolEntry__type(rtoc_local_receiver_150) };
      END
    (  IF (sc != NIL) THEN
        type__shard_count(sc)
      ELSE
        type__shard_count((TRY (type__new(TypeConstructionInput{ Type: COPY UNWRAP (sc) }))))
      END)
    }) |> WHERE _ != NIL) |> DISTINCT _ |> SELECT COPY _;
    MUTABLE names_str = (sharded_names |> SELECT COPY _).join(", ");
    IF (scopeBindings__length(shard_counts) == 1) THEN
      typeAnalysisSession__note_mut(rtoc_self_view, Locatable{ ConcurrentOp: COPY conc }, "CONCURRENT EACH accesses ${sharded_names.length()} @sharded maps (${names_str}). Co-located (same shard count ${shard_counts.first()}), but auto-sharding requires a single map. Use explicit SHARD() or @sharded(N):locked.");
    ELSE
      typeAnalysisSession__note_mut(rtoc_self_view, Locatable{ ConcurrentOp: COPY conc }, "CONCURRENT EACH accesses @sharded maps with different shard counts (${names_str}). Cross-shard routing is likely \u{2014} consider @sharded(N):locked.");
    END
}
END
PRIVATE FN typeAnalysisSession__collect_sharded_names(self: TypeAnalysisSession, node: ?ShardScanNode, MUTABLE names: [Set]String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    typeAnalysisSession__each_shard_scan_node(rtoc_self_view, node, %(n: Locatable) USE(MUTABLE names, rtoc_self_view) -> {
    IF (IF n IS_A Identifier AS identifier THEN typeAnalysisSession__sharded_unsynced_identifier?(rtoc_self_view, identifier) ELSE FALSE END) THEN
        &names.insert(n.name());
    END
    rubyToClearVoid()
    });
}
END
PRIVATE FN typeAnalysisSession__analyze_auto_shard_each_op(MUTABLE self: TypeAnalysisSession, MUTABLE smooth_node: BinaryOp, MUTABLE conc: ConcurrentOp, proxy: BinaryOp) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lhs_type = &smooth_node.left.full_type_mut("pipeline left");
    MUTABLE iterable = typeAnalysisSession__pipeline_source_fact(rtoc_self_view, smooth_node.left, lhs_type);
    IF !(pipelineSourceFact__valid?(iterable)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, smooth_node.left, TypeAnalysisCodeOrMessage{ SymbolValue: :CONCURRENT_EACH_BAD_INPUT }, [], {:got: smooth_node.left.resolved_type()});
      MUTABLE item_type = :Any;
    ELSE
      item_type = castTypeToStringSymbol(COPY iterable.item_type);
    END
    typeAnalysisSession__with_new_scope(rtoc_self_view, %() USE(conc, item_type, MUTABLE rtoc_self_view) -> {
    MUTABLE rtoc_mutable_receiver_151 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_151, "_", NIL, SymbolEntryTypeInput{ SymbolValue: COPY item_type }, ScopeMutabilityInput{ BoolValue: TRUE }, FALSE, NIL, :stack));
    FOR _ IN conc.op.body() DO
    TRY (typeAnalysisSession__visit(&rtoc_self_view, _));
    END
    NIL
    });
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY smooth_node }, :Void));
    smooth_node.storage = :stack;
    typeAnalysisSession__auto_detect_sharded_access(rtoc_self_view, smooth_node, &conc);
}
END
PRIVATE FN typeAnalysisSession__auto_detect_sharded_access(self: TypeAnalysisSession, smooth_node: BinaryOp, MUTABLE conc: ConcurrentOp) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE each_op = conc.op;
    IF !(each_op IS_A EachOp) THEN
      RETURN;
    END
    MUTABLE sharded_accesses: []PipelineShardedAccess = ( { MUTABLE rtoc_empty_list_152: []PipelineShardedAccess = List[]; rtoc_empty_list_152 } );
    typeAnalysisSession__walk_for_sharded_access(rtoc_self_view, each_op.body(), &sharded_accesses);
    IF (sharded_accesses.length() == 0) THEN
      RETURN;
    END
    MUTABLE first_access: ?PipelineShardedAccess = COPY sharded_accesses.first();
    IF first_access EXISTS AS first_access_value THEN
      MUTABLE first_access_value_mutable = COPY first_access_value;
      MUTABLE map_name = COPY first_access_value_mutable.map_name;
      MUTABLE scope: ?Scope@multiowned = typeAnalysisSession__lookup_scope_for(rtoc_self_view, map_name);
      IF scope EXISTS AS scope_value THEN
        MUTABLE scope_value_mutable = COPY scope_value;
        MUTABLE entry: ?SymbolEntry@multiowned = scope__resolve_entry(scope_value_mutable, map_name);
        MUTABLE map_type: ?Type@multiowned = NIL;
        IF entry != NIL THEN
          map_type = COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_153 = (entry?);
        symbolEntry__type(rtoc_local_receiver_153) };
        END
        IF !((map_type != NIL)) THEN
          map_type = TRY (type__new(TypeConstructionInput{ Type: COPY UNWRAP (map_type) }));
        END
        IF !((type__sharded?(map_type) AND ((IF entry != NIL THEN
          symbolEntry__sync(entry)
        ELSE
          NIL
        END) == NIL))) THEN
          RETURN;
        END
        MUTABLE this_map_accesses = sharded_accesses |> WHERE (_.map_name == map_name);
        MUTABLE key_sources = (this_map_accesses |> SELECT {
    MUTABLE key_expr = COPY _.key_expr;
    MUTABLE key_name: String = "";
          IF key_expr IS_A Identifier AS identifier THEN
            key_name = identifier__name(identifier);
          ELSE
            key_name = COPY CAST(key_expr AS String);
          END
    ((key_expr.class().name() + ":") + key_name)
        }) |> DISTINCT _ |> SELECT COPY _;
        IF (scopeBindings__length(key_sources) > 1) THEN
          typeAnalysisSession__note_mut(rtoc_self_view, Locatable{ ConcurrentOp: COPY conc }, "CONCURRENT EACH uses ${scopeBindings__length(key_sources)} different key expressions on @sharded map '${map_name}'. Routing is based on the first key; other accesses with different keys may trigger cross-shard remote calls.");
        END
        MUTABLE key_expr = (UNWRAP (this_map_accesses.first())).key_expr;
        MUTABLE map_ident = Identifier{ token: CAST(COPY KEEP first_access_value_mutable.map_token AS Token), name: COPY map_name, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, fn_ref: NIL, heap_dupe_result: NIL, atomic_borrow: NIL, ownership_pending_transfer: NIL };
        TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ Identifier: COPY map_ident }, map_type));
        each_op = conc.op;
        conc.shard_context = PipelineShardContext{ map_var: Locatable{ Identifier: COPY map_ident }, shard_count: type__shard_count(map_type), key_expr: COPY key_expr, auto_detected: TRUE, key_allocates_frame: FALSE, body_allocates_frame: FALSE };
      ELSE
        RETURN;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__walk_for_sharded_access(self: TypeAnalysisSession, nodes: []Locatable, MUTABLE results: []PipelineShardedAccess) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    typeAnalysisSession__each_shard_scan_node(rtoc_self_view, ShardScanNode{ ArrayValue: nodes |> SELECT castLocatableToNode(_) }, %(node: Locatable) USE(MUTABLE results, rtoc_self_view) -> {
    MUTABLE access: ?PipelineShardedAccess = typeAnalysisSession__sharded_get_index_access(rtoc_self_view, node, "sharded pipeline target");
    IF access EXISTS AS access_value THEN
        &results.append(access_value);
    END
    rubyToClearVoid()
    });
}
END
PRIVATE FN typeAnalysisSession__each_shard_scan_node(self: TypeAnalysisSession, node: ?ShardScanNode, blk: FN(Locatable) -> Void) RETURNS Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node? IS_A []Node AS array THEN
      FOR _ IN array DO
      typeAnalysisSession__each_shard_scan_node(rtoc_self_view, castNodeToOptionalShardScanNode(_), blk);
      END
      RETURN;
    END
    IF node? IS_A ASTCapability AS ast_capability THEN
      FOR _ IN (CAST(Tuple{ast_capability.var_node, ast_capability.guard_expr, ast_capability.view_length} AS Tuple<Locatable, ?Locatable, ?Locatable>)) DO
      IF ((_ IS_A []@multiowned Any OR _ IS_A ASTCapability) OR _ IS_A Locatable) THEN
        typeAnalysisSession__each_shard_scan_node(rtoc_self_view, _, blk);
      END
      END
      RETURN;
    END
    IF node? IS_A Locatable AS locatable THEN
      blk(locatable);
      IF (locatable IS_A BgBlock OR locatable IS_A DoBlock) THEN
        RETURN;
      END
      FOR _ IN locatable.class().members() DO
    MUTABLE val = COPY locatable.substr(_, 1);
    IF ((FALSE OR FALSE) OR FALSE) THEN
          typeAnalysisSession__each_shard_scan_node(rtoc_self_view, val, blk);
    END
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__sharded_unsynced_entry?(self: TypeAnalysisSession, entry: ?SymbolEntry) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF entry EXISTS AS entry_value THEN
      MUTABLE type = symbolEntry__type(entry_value);
      IF !(TRUE) THEN
        type = TRY (type__new(TypeConstructionInput{ Type: COPY type }));
      END
      RETURN (type__sharded?(type) AND (symbolEntry__sync(entry_value) == NIL));
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__sharded_unsynced_identifier?(self: TypeAnalysisSession, node: Identifier) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN typeAnalysisSession__sharded_unsynced_entry?(rtoc_self_view, (IF node.symbol != NIL THEN node.symbol ELSE (IF typeAnalysisSession__lookup_scope_for(rtoc_self_view, node.name) != NIL THEN
      { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_154 = (typeAnalysisSession__lookup_scope_for(rtoc_self_view, node.name));
    scope__resolve_entry(rtoc_local_receiver_154, node.name) }
    ELSE
      NIL
    END) END));
}
END
PRIVATE FN typeAnalysisSession__sharded_get_index_access(self: TypeAnalysisSession, node: Locatable, context: String) RETURNS ?PipelineShardedAccess
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A GetIndex AS get_index THEN
    IF get_index.target IS_A Identifier THEN
        IF !(typeAnalysisSession__sharded_unsynced_identifier?(rtoc_self_view, castLocatableToIdentifier(get_index.target))) THEN
          RETURN NIL;
        END
        MUTABLE ti = &get_index.target.full_type_mut(context);
        IF !((ti IS_A Type AND type__sharded?(ti))) THEN
          RETURN NIL;
        END
        RETURN PipelineShardedAccess{ map_name: COPY get_index.target.name(), key_expr: COPY get_index.indexOf(), map_token: get_index.target.token() };
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__analyze_shard_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE shard_op = COPY node.right;
    MUTABLE lhs_type = &node.left.full_type_mut("pipeline left");
    MUTABLE iterable = typeAnalysisSession__pipeline_source_fact(rtoc_self_view, node.left, lhs_type);
    IF !(pipelineSourceFact__valid?(iterable)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node.left, TypeAnalysisCodeOrMessage{ SymbolValue: :SHARD_NEEDS_RANGE_OR_COLLECTION }, [], {:got: node.left.resolved_type()});
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, :Void));
      RETURN;
    END
    MUTABLE item_type = COPY iterable.item_type;
    typeAnalysisSession__with_new_scope(rtoc_self_view, %() USE(item_type, shard_op, MUTABLE rtoc_self_view) -> {
    MUTABLE rtoc_mutable_receiver_155 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_155, "_", NIL, castTypeToOptionalSymbolEntryTypeInput(item_type), ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    TRY (typeAnalysisSession__visit(&rtoc_self_view, shard_op.key_expr()))
    });
    MUTABLE key_type = shard_op.key_expr().resolved_type();
    TRY (typeAnalysisSession__visit(&rtoc_self_view, shard_op.target_map()));
    MUTABLE target_info = shard_op.target_map().full_type_mut({:context: "shard op target map"});
    MUTABLE target_sync = IF respondsTo?(shard_op.target_map(), "symbol") THEN
      (IF shard_op.target_map().symbol() != NIL THEN
      (shard_op.target_map().symbol()).sync()
    ELSE
      NIL
    END)
    ELSE
      NIL
    END;
    IF !((((target_info != NIL) AND type__sharded?((target_info?))) AND FALSE)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, shard_op.target_map(), TypeAnalysisCodeOrMessage{ SymbolValue: :SHARD_TARGET_BAD }, [], {:remediation: "SHARD routes items to owning schedulers \u{2014} :locked maps don't have ownership."});
    END
    MUTABLE map_key = (IF target_info != NIL THEN
      TRY (type__key_type(target_info))
    ELSE
      NIL
    END);
    MUTABLE actual_key = shard_op.key_expr().full_type_mut({:context: "SHARD key expression"});
    IF ((map_key AND target_info) AND !(TRY (type__accepts_map_key?(target_info, actual_key)))) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, shard_op.key_expr(), TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_MAP_KEY_MISMATCH }, [], {:expected: TRY (type__surface_name(map_key)), :actual: TRY (type__surface_name(actual_key))});
    END
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, :Void));
    node.storage = :stack;
    RETURN :stack;
}
END
PRIVATE FN typeAnalysisSession__validate_positive_numeric_concurrent_option_mut(MUTABLE self: TypeAnalysisSession, name: String, expr: Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, expr));
    IF !(([:Float64, :Int64]).contains?(expr.resolved_type())) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, expr, TypeAnalysisCodeOrMessage{ SymbolValue: :CONCURRENT_OPT_NEEDS_NUMBER }, [], {:name: name, :got: expr.resolved_type()});
    END
    MUTABLE literal_val: ?Float64 = typeAnalysisSession__numeric_literal_value(rtoc_self_view, expr);
    IF ((literal_val != NIL) AND (literal_val <= 0)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, expr, TypeAnalysisCodeOrMessage{ SymbolValue: :CONCURRENT_OPT_NEEDS_POSITIVE }, [], {:name: name, :got: literal_val.toInt()});
    END
}
END
PRIVATE FN typeAnalysisSession__numeric_literal_value(self: TypeAnalysisSession, expr: Locatable) RETURNS ?Float64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF expr IS_A Literal AS literal THEN
      RETURN literal.value.to_f();
    ELSE
    IF (expr IS_A UnaryOp AND (expr.op() == :SUB)) THEN
        MUTABLE right = expr.right();
        IF right IS_A Literal THEN
          RETURN (-right.value().to_f());
        END
    END
    END
}
END
PRIVATE FN typeAnalysisSession__queue_backed_concurrent_source?(self: TypeAnalysisSession, node: BinaryOp) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE lhs = COPY node.left;
    MUTABLE lhs_type = &lhs.full_type_mut("pipeline lhs");
    RETURN (((((typeAnalysisSession__shard_concurrent_source?(rtoc_self_view, lhs) OR typeAnalysisSession__bounded_stream_source?(rtoc_self_view, &lhs)) OR (IF lhs_type != NIL THEN
      lhs_type.inf_stream?()
    ELSE
      NIL
    END)) OR (IF lhs_type != NIL THEN
      TRY (type__dynamic_stream?(lhs_type))
    ELSE
      NIL
    END)) OR (IF lhs_type != NIL THEN
      TRY (type__open_stream?(lhs_type))
    ELSE
      NIL
    END)) OR lhs IS_A RangeLit);
}
END
PRIVATE FN typeAnalysisSession__shard_concurrent_source?(self: TypeAnalysisSession, lhs: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ((IF lhs IS_A BinaryOp AS binary_op THEN binaryOp__smooth?(binary_op) ELSE FALSE END) AND lhs.right() IS_A ShardOp);
}
END
PRIVATE FN typeAnalysisSession__analyze_concurrent_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE conc = COPY node.right;
    MUTABLE options: {String}Locatable = CAST(conc.options() AS {String}Locatable);
    typeAnalysisSession__validate_concurrent_options_mut(&rtoc_self_view, node, castLocatableToConcurrentOp(conc), options);
    typeAnalysisSession__stamp_concurrent_option_values_mut(&rtoc_self_view, options);
    MUTABLE lhs_type = &node.left.full_type_mut("pipeline left");
    MUTABLE shard_node: ?ShardOp = typeAnalysisSession__prepare_concurrent_shard_context_mut(rtoc_self_view, node, castLocatableToConcurrentOp(conc));
    MUTABLE proxy = BinaryOp{ token: COPY node.token, left: COPY node.left, op: :SMOOTH, right: COPY conc.op(), paren_bind: NIL, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, string_concat: NIL, or_fallback_dupe: NIL, error_union_type: NIL, observable_terminal: NIL, observable_dest: NIL, retain_error_channel: NIL };
    IF (conc.op() IS_A SelectOp) OR (conc.op() IS_A WhereOp) THEN
      IF typeAnalysisSession__bounded_stream_source?(rtoc_self_view, &node.left) THEN
        typeAnalysisSession__analyze_concurrent_bounded_select_family_op(&rtoc_self_view, &node);
      ELSE_IF typeAnalysisSession__concurrent_stream_source?(rtoc_self_view, node.left, lhs_type) THEN
        typeAnalysisSession__analyze_concurrent_stream_select_family_op(&rtoc_self_view, &node);
      ELSE
        typeAnalysisSession__analyze_select_family_op(&rtoc_self_view, &proxy);
      END
    ELSE_IF (conc.op() IS_A EachOp) THEN
      IF typeAnalysisSession__bounded_stream_source?(rtoc_self_view, &node.left) THEN
        typeAnalysisSession__analyze_concurrent_bounded_each_op(&rtoc_self_view, &node);
      ELSE_IF typeAnalysisSession__concurrent_stream_source?(rtoc_self_view, node.left, lhs_type) THEN
        typeAnalysisSession__analyze_concurrent_stream_each_op(&rtoc_self_view, &node);
      ELSE_IF shard_node THEN
        typeAnalysisSession__analyze_shard_each_op(&rtoc_self_view, &node, UNWRAP (shard_node));
      ELSE
        MUTABLE sharded_names = Set[];
        FOR _ IN conc.op().body() DO
        typeAnalysisSession__collect_sharded_names(rtoc_self_view, _, &sharded_names);
        END
        conc.capture_analysis = typeAnalysisSession__with_fiber_capture_analysis(rtoc_self_view, FALSE, %() USE(conc, MUTABLE node, MUTABLE proxy, sharded_names, MUTABLE rtoc_self_view) -> {
    IF (sharded_names.length() > 1) THEN
            typeAnalysisSession__emit_multi_map_warning(rtoc_self_view, castLocatableToConcurrentOp(conc), sharded_names);
            typeAnalysisSession__analyze_each_op(&rtoc_self_view, &proxy);
    ELSE_IF (sharded_names.length() == 1) THEN
            typeAnalysisSession__analyze_auto_shard_each_op(&rtoc_self_view, &node, castLocatableToConcurrentOp(conc), proxy);
    ELSE
            typeAnalysisSession__analyze_each_op(&rtoc_self_view, &proxy);
    END
    rubyToClearVoid()
        });
      END
    ELSE_IF (conc.op() IS_A SumOp) THEN
      typeAnalysisSession__analyze_sum_op(&rtoc_self_view, &proxy);
    ELSE_IF (conc.op() IS_A CountOp) THEN
      typeAnalysisSession__analyze_count_op(&rtoc_self_view, &proxy);
    ELSE_IF (conc.op() IS_A MinOp) THEN
      typeAnalysisSession__analyze_min_op(&rtoc_self_view, &proxy);
    ELSE_IF (conc.op() IS_A MaxOp) THEN
      typeAnalysisSession__analyze_max_op(&rtoc_self_view, &proxy);
    ELSE_IF (conc.op() IS_A AverageOp) THEN
      typeAnalysisSession__analyze_average_op(&rtoc_self_view, &proxy);
    ELSE
      typeAnalysisSession__error_mut(rtoc_self_view, conc, TypeAnalysisCodeOrMessage{ SymbolValue: :CONCURRENT_BAD_FOLLOWING_OP }, [], {:got: conc.op().class().name().split("::").last()});
    END
    MUTABLE inner_expr = PARTIAL MATCH conc.op() START
      AST.SelectOp -> conc.op().expression(),
      AST.WhereOp -> conc.op().expression(),
      DEFAULT -> NIL
    END;
    IF (inner_expr IS_A BinaryOp AND (inner_expr.op() == symbol("OR_ELSE"))) THEN
      MUTABLE modifier = inner_expr.right();
      IF (modifier IS_A OrElsePrune OR modifier IS_A OrElseRaise) THEN
        MUTABLE inner_fn_type = inner_expr.left().full_type_mut({:context: "inner pipeline left"});
        MUTABLE is_error_union = ((respondsTo?(inner_expr.left(), "error_union_type") AND inner_expr.left().error_union_type()));
        IF inner_fn_type != NIL THEN
          is_error_union = inner_fn_type.error_union?();
        END
        IF !(is_error_union) THEN
          MUTABLE mod_name: String = "";
          IF modifier IS_A OrElsePrune THEN
            mod_name = "OR_ELSE PRUNE";
          ELSE
            mod_name = "OR_ELSE RAISE";
          END
          typeAnalysisSession__error_mut(rtoc_self_view, modifier, TypeAnalysisCodeOrMessage{ SymbolValue: :MODIFIER_NEEDS_ERROR_UNION }, [], {:name: mod_name, :got: inner_expr.left().resolved_type()});
        END
        IF modifier IS_A OrElseRaise THEN
          inner_expr.retain_error_channel = TRUE;
        END
      END
    END
    MUTABLE stream_op_analyzed = (aST__pipeline_stream_value_op?(conc.op()) AND ((typeAnalysisSession__bounded_stream_source?(rtoc_self_view, &node.left) OR typeAnalysisSession__concurrent_stream_source?(rtoc_self_view, node.left, lhs_type))));
    IF !(stream_op_analyzed) THEN
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, &proxy.full_type_mut("concurrent proxy result")));
      node.storage = IF ((&node.full_type_mut("pipeline result") == :Void)) THEN
        :stack
      ELSE
        :heap
      END;
    END
    MUTABLE inner = conc.op();
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &inner, &node.full_type_mut("CONCURRENT inner op result")));
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__validate_concurrent_options_mut(MUTABLE self: TypeAnalysisSession, node: BinaryOp, conc: ConcurrentOp, options: {String}Locatable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__validate_concurrent_numeric_option_mut(&rtoc_self_view, options, "workers");
    typeAnalysisSession__validate_concurrent_capacity_option_mut(&rtoc_self_view, node, options);
    typeAnalysisSession__validate_concurrent_numeric_option_mut(&rtoc_self_view, options, "batch");
    typeAnalysisSession__validate_concurrent_parallel_option_mut(rtoc_self_view, options);
    typeAnalysisSession__validate_concurrent_size_option_mut(rtoc_self_view, options);
    typeAnalysisSession__validate_known_concurrent_options_mut(rtoc_self_view, conc, options);
}
END
PRIVATE FN typeAnalysisSession__validate_concurrent_numeric_option_mut(MUTABLE self: TypeAnalysisSession, options: {String}Locatable, name: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE expr: ?Locatable = COPY options[name];
    IF expr EXISTS AS expr_value THEN
      MUTABLE expr_value_mutable = COPY expr_value;
      typeAnalysisSession__validate_positive_numeric_concurrent_option_mut(&rtoc_self_view, name, expr_value_mutable);
    END
}
END
PRIVATE FN typeAnalysisSession__validate_concurrent_capacity_option_mut(MUTABLE self: TypeAnalysisSession, node: BinaryOp, options: {String}Locatable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE cap: ?Locatable = COPY options["capacity"];
    IF cap EXISTS AS cap_value THEN
      MUTABLE cap_value_mutable = COPY cap_value;
      IF !(typeAnalysisSession__queue_backed_concurrent_source?(rtoc_self_view, node)) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, cap_value_mutable, TypeAnalysisCodeOrMessage{ SymbolValue: :CONCURRENT_CAPACITY_BAD_INPUT });
      END
      typeAnalysisSession__validate_positive_numeric_concurrent_option_mut(&rtoc_self_view, "capacity", cap_value_mutable);
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__validate_concurrent_parallel_option_mut(self: TypeAnalysisSession, options: {String}Locatable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE par_val: ?Locatable = COPY options["parallel"];
    IF par_val EXISTS AS par_val_value THEN
      IF typeAnalysisSession__concurrent_bool_option?(rtoc_self_view, par_val_value) THEN
        RETURN;
      END
      typeAnalysisSession__error_mut(rtoc_self_view, par_val_value, TypeAnalysisCodeOrMessage{ SymbolValue: :CONCURRENT_PARALLEL_NEEDS_BOOL }, [], {:got: typeAnalysisSession__concurrent_option_label(rtoc_self_view, par_val_value)});
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__concurrent_bool_option?(self: TypeAnalysisSession, value: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN !(!(((((IF value IS_A Literal AS literal THEN ruby_union_scalar_equal_Type_String_symbol(literal.type, :BOOLEAN) ELSE FALSE END)) OR ((IF value IS_A Identifier AS identifier THEN (["true", "false", "TRUE", "FALSE"]).contains?(identifier__name(identifier)) ELSE FALSE END))))));
}
END
PRIVATE FN typeAnalysisSession__validate_concurrent_size_option_mut(self: TypeAnalysisSession, options: {String}Locatable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE size: ?Locatable = COPY options["size"];
    IF size EXISTS AS size_value THEN
      IF (IF size_value IS_A Identifier AS identifier THEN valid_concurrent_sizes.contains?(identifier__name(identifier)) ELSE FALSE END) THEN
        RETURN;
      END
      typeAnalysisSession__error_mut(rtoc_self_view, size_value, TypeAnalysisCodeOrMessage{ SymbolValue: :CONCURRENT_SIZE_BAD_VALUE }, [], {:valid: valid_concurrent_sizes.join(", "), :got: typeAnalysisSession__concurrent_option_label(rtoc_self_view, size_value)});
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__concurrent_option_label(self: TypeAnalysisSession, value: Locatable) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF value IS_A Identifier AS identifier THEN
      RETURN COPY identifier__name(identifier);
    END
    MUTABLE class_name = value.class().name();
    IF class_name THEN
      RETURN class_name.split("::").last();
    ELSE
      RETURN COPY CAST(value.class() AS String);
    END
}
END
PRIVATE FN typeAnalysisSession__validate_known_concurrent_options_mut(self: TypeAnalysisSession, conc: ConcurrentOp, options: {String}Locatable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    FOR _ IN options.keys() DO
    IF !(valid_concurrent_options.contains?(_)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, conc, TypeAnalysisCodeOrMessage{ SymbolValue: :CONCURRENT_UNKNOWN_OPTION }, [], {:name: _, :valid: valid_concurrent_options.join(", ")});
    END
    END
}
END
PRIVATE FN typeAnalysisSession__stamp_concurrent_option_values_mut(MUTABLE self: TypeAnalysisSession, options: {String}Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN options.values() DO
    MUTABLE rtoc_mutable_block_param_156 = COPY _;
    IF rtoc_mutable_block_param_156 IS_A Identifier THEN
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &rtoc_mutable_block_param_156, TRY (type__new(TypeConstructionInput{ SymbolValue: :Type }))));
    ELSE
      TRY (typeAnalysisSession__visit(&rtoc_self_view, rtoc_mutable_block_param_156));
    END
    END
}
END
PRIVATE FN typeAnalysisSession__prepare_concurrent_shard_context_mut(self: TypeAnalysisSession, node: BinaryOp, MUTABLE conc: ConcurrentOp) RETURNS ?ShardOp
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(typeAnalysisSession__shard_concurrent_source?(rtoc_self_view, node.left)) THEN
      RETURN NIL;
    END
    MUTABLE shard_node = node.left.right();
    MUTABLE target_info = shard_node.target_map().full_type_mut({:context: "shard target map"});
    conc.shard_context = PipelineShardContext{ map_var: COPY shard_node.target_map(), shard_count: (IF target_info != NIL THEN
      type__shard_count(target_info)
    ELSE
      NIL
    END), key_expr: COPY shard_node.key_expr(), auto_detected: FALSE, key_allocates_frame: FALSE, body_allocates_frame: FALSE };
    RETURN shard_node;
}
END
PRIVATE FN typeAnalysisSession__concurrent_stream_source?(self: TypeAnalysisSession, node: Locatable, lhs_type: Type) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (((TRY (type__inf_stream?(lhs_type)) OR TRY (type__dynamic_stream?(lhs_type))) OR TRY (type__open_stream?(lhs_type))) OR node IS_A RangeLit);
}
END
PRIVATE FN typeAnalysisSession__analyze_concurrent_bounded_select_family_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lhs_type = &node.left.full_type_mut("pipeline left");
    MUTABLE item_type = TRY (type__stream_element_type(lhs_type));
    MUTABLE is_parallel = typeAnalysisSession__concurrent_parallel_enabled?(rtoc_self_view, node.right.options());
    MUTABLE analysis = typeAnalysisSession__with_fiber_capture_analysis(rtoc_self_view, &is_parallel, %() USE(item_type, node, MUTABLE rtoc_self_view) -> {
    typeAnalysisSession__with_new_scope(rtoc_self_view, %() USE(item_type, node, MUTABLE rtoc_self_view) -> {
      MUTABLE rtoc_mutable_receiver_157 = typeAnalysisSession__current_scope(rtoc_self_view);
      TRY (scope__declare(&rtoc_mutable_receiver_157, "_", NIL, item_type, ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
      typeAnalysisSession__with_soa_tracking(rtoc_self_view, node, item_type, %() USE(node, MUTABLE rtoc_self_view) -> {
        rtoc_lambda_result_158 = TRY (typeAnalysisSession__visit(&rtoc_self_view, node.right.op().expression()));
        rtoc_lambda_result_158
      })
    });
    rubyToClearVoid()
    });
    node.right.capture_analysis = (typeAnalysisSession__validate_capture_analysis_mut(rtoc_self_view, castLocatableToNode(node.right), analysis, &is_parallel, FALSE) OR_ELSE analysis);
    typeAnalysisSession__validate_concurrent_where_expression_mut(rtoc_self_view, node);
    MUTABLE result_type = typeAnalysisSession__concurrent_select_family_result_type(rtoc_self_view, node, item_type);
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, result_type));
    node.storage = :heap;
    IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
        MUTABLE rtoc_mutable_receiver_159 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
        functionContext__record_frame_use_mut(&rtoc_mutable_receiver_159);
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__analyze_concurrent_bounded_each_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lhs_type = &node.left.full_type_mut("pipeline left");
    MUTABLE item_type = TRY (type__stream_element_type(lhs_type));
    MUTABLE is_parallel = typeAnalysisSession__concurrent_parallel_enabled?(rtoc_self_view, node.right.options());
    MUTABLE analysis = typeAnalysisSession__with_fiber_capture_analysis(rtoc_self_view, &is_parallel, %() USE(item_type, node, MUTABLE rtoc_self_view) -> {
    typeAnalysisSession__with_new_scope(rtoc_self_view, typeAnalysisSession__current_scope(rtoc_self_view), %() USE(item_type, node, MUTABLE rtoc_self_view) -> {
      MUTABLE rtoc_mutable_receiver_160 = typeAnalysisSession__current_scope(rtoc_self_view);
      TRY (scope__declare(&rtoc_mutable_receiver_160, "_", NIL, item_type, ScopeMutabilityInput{ BoolValue: TRUE }, FALSE, NIL, :stack));
      typeAnalysisSession__with_soa_tracking(rtoc_self_view, node, item_type, %() USE(node, MUTABLE rtoc_self_view) -> {
        FOR _ IN node.right.op().body() DO
        TRY (typeAnalysisSession__visit(&rtoc_self_view, _));
        END
        NIL
      })
    });
    rubyToClearVoid()
    });
    node.right.capture_analysis = (typeAnalysisSession__validate_capture_analysis_mut(rtoc_self_view, castLocatableToNode(node.right), analysis, &is_parallel, FALSE) OR_ELSE analysis);
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, :Void));
    node.storage = :stack;
    RETURN :stack;
}
END
PRIVATE FN typeAnalysisSession__analyze_concurrent_stream_select_family_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lhs_type = &node.left.full_type_mut("pipeline left");
    MUTABLE item_type = COPY typeAnalysisSession__pipeline_source_fact(rtoc_self_view, node.left, lhs_type, TRUE).item_type;
    MUTABLE is_parallel = typeAnalysisSession__concurrent_parallel_enabled?(rtoc_self_view, node.right.options());
    MUTABLE analysis = typeAnalysisSession__with_fiber_capture_analysis(rtoc_self_view, &is_parallel, %() USE(item_type, node, MUTABLE rtoc_self_view) -> {
    typeAnalysisSession__with_new_scope(rtoc_self_view, %() USE(item_type, node, MUTABLE rtoc_self_view) -> {
      MUTABLE rtoc_mutable_receiver_161 = typeAnalysisSession__current_scope(rtoc_self_view);
      TRY (scope__declare(&rtoc_mutable_receiver_161, "_", NIL, castTypeToOptionalSymbolEntryTypeInput(item_type), ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
      typeAnalysisSession__with_soa_tracking(rtoc_self_view, node, item_type, %() USE(node, MUTABLE rtoc_self_view) -> {
        rtoc_lambda_result_162 = TRY (typeAnalysisSession__visit(&rtoc_self_view, node.right.op().expression()));
        rtoc_lambda_result_162
      })
    });
    rubyToClearVoid()
    });
    node.right.capture_analysis = (typeAnalysisSession__validate_capture_analysis_mut(rtoc_self_view, castLocatableToNode(node.right), analysis, &is_parallel, FALSE) OR_ELSE analysis);
    typeAnalysisSession__validate_concurrent_where_expression_mut(rtoc_self_view, node);
    MUTABLE result_type = typeAnalysisSession__concurrent_select_family_result_type(rtoc_self_view, node, item_type);
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, TRY (type__new(TypeConstructionInput{ Type: COPY result_type }))));
    node.storage = :heap;
    IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
        MUTABLE rtoc_mutable_receiver_163 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
        functionContext__record_frame_use_mut(&rtoc_mutable_receiver_163);
    END
    RETURN 0;
}
END
PRIVATE FN typeAnalysisSession__validate_concurrent_where_expression_mut(self: TypeAnalysisSession, node: BinaryOp) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE op = node.right.op();
    IF !(op IS_A WhereOp) THEN
      RETURN;
    END
    typeAnalysisSession__validate_where_effect_contract_mut(rtoc_self_view, op, typeAnalysisSession__selector_effect_fact(rtoc_self_view, op.expression()));
}
END
PRIVATE FN typeAnalysisSession__concurrent_select_family_result_type(self: TypeAnalysisSession, node: BinaryOp, item_type: Type) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE op = node.right.op();
    IF op IS_A SelectOp THEN
      MUTABLE effect = typeAnalysisSession__selector_effect_fact(rtoc_self_view, op.expression());
      typeAnalysisSession__validate_select_effect_contract_mut(rtoc_self_view, &op, effect);
      IF selectorEffectFact__asynchronous(effect) THEN
        RETURN TRY (type__promise_list_of(TypeTypeInput{ Type: COPY selectorEffectFact__value_type(effect) }));
      ELSE
        RETURN TRY (type__array_of(TypeTypeInput{ Type: COPY selectorEffectFact__value_type(effect) }));
      END
    END
    IF op IS_A WhereOp THEN
      RETURN TRY (type__array_of(castTypeToTypeTypeInput(item_type)));
    END
    panic("expected CONCURRENT SELECT/WHERE, got {}");
}
END
PRIVATE FN typeAnalysisSession__analyze_concurrent_stream_each_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lhs_type = &node.left.full_type_mut("pipeline left");
    MUTABLE item_type = COPY typeAnalysisSession__pipeline_source_fact(rtoc_self_view, node.left, lhs_type, TRUE).item_type;
    MUTABLE is_parallel = typeAnalysisSession__concurrent_parallel_enabled?(rtoc_self_view, node.right.options());
    MUTABLE analysis = typeAnalysisSession__with_fiber_capture_analysis(rtoc_self_view, &is_parallel, %() USE(item_type, node, MUTABLE rtoc_self_view) -> {
    typeAnalysisSession__with_new_scope(rtoc_self_view, typeAnalysisSession__current_scope(rtoc_self_view), %() USE(item_type, node, MUTABLE rtoc_self_view) -> {
      MUTABLE rtoc_mutable_receiver_164 = typeAnalysisSession__current_scope(rtoc_self_view);
      TRY (scope__declare(&rtoc_mutable_receiver_164, "_", NIL, castTypeToOptionalSymbolEntryTypeInput(item_type), ScopeMutabilityInput{ BoolValue: TRUE }, FALSE, NIL, :stack));
      typeAnalysisSession__with_soa_tracking(rtoc_self_view, node, item_type, %() USE(node, MUTABLE rtoc_self_view) -> {
        FOR _ IN node.right.op().body() DO
        TRY (typeAnalysisSession__visit(&rtoc_self_view, _));
        END
        NIL
      })
    });
    rubyToClearVoid()
    });
    node.right.capture_analysis = (typeAnalysisSession__validate_capture_analysis_mut(rtoc_self_view, castLocatableToNode(node.right), analysis, &is_parallel, FALSE) OR_ELSE analysis);
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, :Void));
    node.storage = :stack;
    RETURN :stack;
}
END
PRIVATE FN typeAnalysisSession__sum_result_clear_type(self: TypeAnalysisSession, expr_sym: String@symbol) RETURNS String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN PARTIAL MATCH expr_sym START
      :Int8 -> :Int64,
      :Int16 -> :Int64,
      :Int32 -> :Int64,
      :Int64 -> :Int64,
      :UInt8 -> :UInt64,
      :Byte -> :UInt64,
      :UInt16 -> :UInt64,
      :UInt32 -> :UInt64,
      :UInt64 -> :UInt64,
      :Float32 -> :Float32,
      DEFAULT -> :Float64
    END;
}
END
PRIVATE FN typeAnalysisSession__require_array_input_mut(self: TypeAnalysisSession, node: BinaryOp, op_name: String, allow_range: Bool = FALSE, allow_stream: Bool = FALSE) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE lhs_type = &node.left.full_type_mut("pipeline left");
    IF (node.left.metatype() == :array) THEN
      RETURN;
    END
    IF (IF lhs_type != NIL THEN
      type__collection?(lhs_type)
    ELSE
      NIL
    END) THEN
      RETURN;
    END
    IF allow_range THEN
    IF node.left IS_A RangeLit THEN
      RETURN;
    END
    END
    IF (allow_stream AND ((lhs_type != NIL) AND (lhs_type?).runtime_stream?())) THEN
      RETURN;
    END
    IF (op_name == "SELECT") THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node.left, TypeAnalysisCodeOrMessage{ SymbolValue: :SELECT_NEEDS_LIST }, [], {:got: node.left.resolved_type()});
    ELSE
      typeAnalysisSession__error_mut(rtoc_self_view, node.left, TypeAnalysisCodeOrMessage{ SymbolValue: :PIPE_OP_NEEDS_LIST }, [], {:op: op_name, :got: node.left.resolved_type()});
    END
}
END
PRIVATE FN typeAnalysisSession__range_element_type(self: TypeAnalysisSession, range_node: RangeLit) RETURNS Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN &range_node.start.full_type_mut("range element");
}
END
PRIVATE FN typeAnalysisSession__check_soa_opportunity_mut(self: TypeAnalysisSession, node: BinaryOp, item_type: Type) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE accessed: ?[Set]String = COPY typeAnalysisSession__phase_traversal_state(rtoc_self_view).pipeline_accessed_fields;
    IF accessed EXISTS AS accessed_value THEN
      IF accessed_value.empty?() THEN
        RETURN;
      END
      MUTABLE schema = typeAnalysisSession__lookup_type_schema(rtoc_self_view, type__resolved(item_type));
      IF !(schemas__field_bearing?(schema)) THEN
        RETURN;
      END
      MUTABLE total = schema.fields().keys().size();
      IF (total < soa_min_fields) THEN
        RETURN;
      END
      MUTABLE ratio = (accessed_value.size().to_f() / total);
      IF (ratio < soa_threshold) THEN
        MUTABLE fields_str = ((accessed_value |> SELECT COPY _) |> ORDER_BY _).join(", ");
        typeAnalysisSession__note_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, "Pipeline accesses ${accessed_value.size()} of ${total} fields (${fields_str}). Consider @soa for better cache performance on '${castTypeToString(item_type)}'.");
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__with_soa_tracking(self: TypeAnalysisSession, node: BinaryOp, item_type: Type, blk: Any) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
  MUTABLE traversal_state = typeAnalysisSession__phase_traversal_state(rtoc_self_view);
  DEFER IF traversal_state THEN
      traversal_state.pipeline_accessed_fields = NIL;
  END
  traversal_state.pipeline_accessed_fields = Set[];
  blk();
  typeAnalysisSession__check_soa_opportunity_mut(rtoc_self_view, node, item_type);
}
END
PRIVATE FN typeAnalysisSession__scope_stack_for_helper(self: TypeAnalysisSession) RETURNS ![]Scope@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (typeAnalysisSession__scope_stack(rtoc_self_view));
}
END
PRIVATE FN typeAnalysisSession__current_scope(self: TypeAnalysisSession) RETURNS Scope@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN KEEP UNWRAP (typeAnalysisSession__scope_stack_for_helper(rtoc_self_view).last());
}
END
PRIVATE FN typeAnalysisSession__lookup_scope_for(self: TypeAnalysisSession, name: String) RETURNS ?Scope@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rtoc_reverse_items_165: []Scope@multiowned = typeAnalysisSession__scope_stack_for_helper(rtoc_self_view);
    MUTABLE rtoc_reverse_i_166 = rtoc_reverse_items_165.length() - 1;
    WHILE rtoc_reverse_i_166 >= 0 DO
    IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_167 = ((rtoc_reverse_items_165[rtoc_reverse_i_166])?);
    scope__entry?(rtoc_local_receiver_167, name) } THEN
        RETURN KEEP (rtoc_reverse_items_165[rtoc_reverse_i_166])?;
    END
    rtoc_reverse_i_166 = rtoc_reverse_i_166 - 1;
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__resolve_variable_scope(self: TypeAnalysisSession, name: String) RETURNS !?Scope@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE scope = typeAnalysisSession__current_scope(rtoc_self_view);
    IF scope__entry?(scope, name) THEN
      RETURN scope;
    ELSE
      MUTABLE outer_scope: ?Scope@multiowned = typeAnalysisSession__lookup_scope_for(rtoc_self_view, name);
      IF outer_scope EXISTS AS outer_scope_value THEN
        IF functionSignature__unwrap(X{ Type: COPY TRY (scope__resolve_type(outer_scope_value, name)) }) THEN
          RETURN outer_scope_value;
        END
        IF outer_scope_value.equal?(typeAnalysisSession__scope_stack_for_helper(rtoc_self_view).first()) THEN
          RETURN outer_scope_value;
        END
        RETURN NIL;
      ELSE
        RETURN NIL;
      END
    END
}
END
PRIVATE FN typeAnalysisSession__lookup_type_schema(self: TypeAnalysisSession, name: String@symbol) RETURNS Any@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE base_name = symbol((compilerRegexReplaceFirst((CAST(name AS String)), compilerRegexCompile("<.*>$"), "")));
    MUTABLE rtoc_reverse_items_168: []Scope@multiowned = typeAnalysisSession__scope_stack_for_helper(rtoc_self_view);
    MUTABLE rtoc_reverse_i_169 = rtoc_reverse_items_168.length() - 1;
    WHILE rtoc_reverse_i_169 >= 0 DO
      MUTABLE schema = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_170 = ((rtoc_reverse_items_168[rtoc_reverse_i_169])?);
      scope__resolve_type_definition(rtoc_local_receiver_170, base_name) };
      IF schema THEN
          RETURN schema;
      END
    rtoc_reverse_i_169 = rtoc_reverse_i_169 - 1;
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__all_known_type_names(self: TypeAnalysisSession) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE names = List[];
    FOR _ IN typeAnalysisSession__scope_stack_for_helper(rtoc_self_view) DO
    ruby_array_concat_Any(names, CAST(_.types.keys() |> SELECT _.toString() AS []Any));
    END
    RETURN CAST((names |> DISTINCT _) AS []Any);
}
END
PRIVATE FN typeAnalysisSession__with_new_scope<Result>(self: TypeAnalysisSession, scope: ?Scope = NIL, blk: FN() -> Result) RETURNS Result
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
  DEFER typeAnalysisSession__scope_stack_for_helper(rtoc_self_view).pop();
  MUTABLE new_scope = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_172: ?Scope = NIL;
    IF (scope == NIL) THEN
      rtoc_ternary_value_172 = scope__new();
    ELSE
      rtoc_ternary_value_172 = COPY scope;
    END
    rtoc_ternary_value_172? };
  MUTABLE stack: []Scope@multiowned = typeAnalysisSession__scope_stack_for_helper(rtoc_self_view);
  new_scope.depth = stack.length();
  &stack.push(new_scope);
  RETURN blk();
}
END
PRIVATE FN typeAnalysisSession__to_type(self: TypeAnalysisSession, input: ?TypeAnalysisInput) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF input EXISTS AS input_value THEN
      MUTABLE value = COPY input_value;
      IF value IS_A Type AS type THEN
        RETURN TRY (type__copy_type(type));
      END
      IF value IS_A String@symbol AS string_symbol THEN
        RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: COPY string_symbol }));
      END
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }));
    ELSE
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }));
    END
}
END
PRIVATE FN typeAnalysisSession__is_safe_autocast?(self: TypeAnalysisSession, source_type: ?SourceType, target_type: TypeTypeInput) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE target = TRY (type__from_input(target_type));
    IF source_type EXISTS AS source_type_value THEN
      IF source_type_value IS_A Type AS type THEN
        RETURN TRY (type__accepts?(target, TRY (type__copy_type(type))));
      END
      IF source_type_value IS_A String@symbol AS string_symbol THEN
        RETURN TRY (type__accepts?(target, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY string_symbol }))));
      END
      RETURN TRY (type__accepts?(target, TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }))));
    ELSE
      RETURN TRY (type__accepts?(target, TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }))));
    END
}
END
PRIVATE FN typeAnalysisSession__error_mut(self: TypeAnalysisSession, node_or_token: Any, code_or_message: TypeAnalysisCodeOrMessage, args: []?DiagnosticKwValue = [], kwargs: {String@symbol}Any = {}) RETURNS !Any@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE token: ?Any@multiowned = typeAnalysisSession__diagnostic_token(rtoc_self_view, node_or_token);
    MUTABLE message: ?String = "";
    IF code_or_message IS_A String@symbol AS string_symbol THEN
      message = TRY (diagnosticRegistry__format_from_hash(string_symbol, args, kwargs));
      IF !(message) THEN
        panic("Internal Compiler Error: Unknown error code :{}");
      END
    ELSE
      message = castCodeOrMessageToOptionalString(COPY code_or_message);
    END
    MUTABLE source_token: ?Token@multiowned = typeAnalysisSession__source_error_token(rtoc_self_view, token);
    MUTABLE diagnostic_code: ?String@symbol = NIL;
    IF code_or_message IS_A String@symbol AS string_symbol THEN
      diagnostic_code = COPY string_symbol;
    END
    RETURN typeAnalysisSession__raise_source_error_mut(rtoc_self_view, CAST(source_token AS ?Token), UNWRAP (message), diagnostic_code);
}
END
PRIVATE FN typeAnalysisSession__format_diagnostic_template(self: TypeAnalysisSession, template: String, args: []?DiagnosticKwValue, kwargs: {String@symbol}?DiagnosticKwValue) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN diagnosticRegistry__format_template(template, args, kwargs);
}
END
PRIVATE FN typeAnalysisSession__diagnostic_message(self: TypeAnalysisSession, code: String@symbol, args: []?DiagnosticKwValue = [], kwargs: {String@symbol}Any = {}) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE message: ?String = TRY (diagnosticRegistry__format_from_hash(code, args, kwargs));
    IF message EXISTS AS message_value THEN
      RETURN message_value;
    ELSE
      panic("Internal Compiler Error: Unknown error code :{}");
    END
}
END
PRIVATE FN typeAnalysisSession__fix_description(self: TypeAnalysisSession, code: String@symbol, kwargs: {String@symbol}?DiagnosticKwValue = {}) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (diagnosticRegistry__fix_description_from_hash(code, kwargs));
}
END
PRIVATE FN typeAnalysisSession__fix_description_from_hash(self: TypeAnalysisSession, code: String@symbol, kwargs: {String@symbol}?DiagnosticKwValue) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (diagnosticRegistry__fix_description_from_hash(code, kwargs));
}
END
PRIVATE FN typeAnalysisSession__note_mut(self: TypeAnalysisSession, node_or_token: Locatable, message: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE token: ?Token@multiowned = typeAnalysisSession__source_error_token(rtoc_self_view, typeAnalysisSession__diagnostic_token(rtoc_self_view, node_or_token));
    MUTABLE loc: String = "";
    IF token EXISTS AS token_value THEN
      loc = " (line ${token_value.line.toString()})";
    ELSE
      loc = "";
    END
    typeAnalysisSession__diagnostic_output(rtoc_self_view, "\x1B[36m[Note]\x1B[0m ${message}${loc}");
    NIL;
}
END
PRIVATE FN typeAnalysisSession__warning_mut(self: TypeAnalysisSession, node_or_token: Locatable, message: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE token: ?Token@multiowned = typeAnalysisSession__source_error_token(rtoc_self_view, typeAnalysisSession__diagnostic_token(rtoc_self_view, node_or_token));
    MUTABLE loc: String = "";
    IF token EXISTS AS token_value THEN
      loc = " (line ${token_value.line.toString()})";
    ELSE
      loc = "";
    END
    typeAnalysisSession__diagnostic_output(rtoc_self_view, "\x1B[33m[Warning]\x1B[0m ${message}${loc}");
    NIL;
}
END
PRIVATE FN typeAnalysisSession__fixable_mut(self: TypeAnalysisSession, node_or_token: Any, category: String@symbol, fixes: []Fix, message: ?String = NIL, code: ?String@symbol = NIL, level: String@symbol = :warning, raise_in_collector: Bool = FALSE, kwargs: {String@symbol}Any = {}) RETURNS !Any@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rendered_message = (message OR_ELSE typeAnalysisSession__diagnostic_message(rtoc_self_view, code?, [], kwargs));
    MUTABLE token: ?Any@multiowned = typeAnalysisSession__diagnostic_token(rtoc_self_view, node_or_token);
    MUTABLE source_token: ?Token@multiowned = typeAnalysisSession__source_error_token(rtoc_self_view, token);
    MUTABLE finding = TRY (fixableFinding__new(level, rendered_message, token, category, fixes));
    IF fixCollector__enabled?() THEN
      TRY (fixCollector__push(finding, (level == :error)));
      IF !(raise_in_collector) THEN
        RETURN;
      END
      typeAnalysisSession__raise_source_error_mut(rtoc_self_view, CAST(source_token AS ?Token), rendered_message);
    END
    IF (level == :hint) OR (level == :info) OR (level == :warning) THEN
      MUTABLE loc: String = "";
      IF source_token EXISTS AS source_token_value THEN
        loc = " (line ${source_token_value.line.toString()})";
      ELSE
        loc = "";
      END
      MUTABLE tag: String = "";
      IF (level == :warning) THEN
        tag = "\x1B[33m[Warning]\x1B[0m";
      ELSE
        tag = "\x1B[36m[${(CAST(level AS String)).capitalize()}]\x1B[0m";
      END
      RETURN typeAnalysisSession__diagnostic_output(rtoc_self_view, "${tag} ${rendered_message}${loc}");
    ELSE_IF (level == :error) THEN
      RETURN typeAnalysisSession__raise_source_error_mut(rtoc_self_view, CAST(source_token AS ?Token), rendered_message);
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__diagnostic_source_code(self: TypeAnalysisSession) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN typeAnalysisSession__source_code(rtoc_self_view);
}
END
PRIVATE FN typeAnalysisSession__parser_error_host?(self: TypeAnalysisSession) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN FALSE;
}
END
PRIVATE FN typeAnalysisSession__raise_source_error_mut(self: TypeAnalysisSession, token: ?Token, message: String, code: ?String@symbol = NIL) RETURNS !Any@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF typeAnalysisSession__parser_error_host?(rtoc_self_view) THEN
      RAISE Input, ParserError, message;
    END
    RAISE Input, CompilerError, message;
}
END
PRIVATE FN typeAnalysisSession__diagnostic_token(self: TypeAnalysisSession, node_or_token: Any) RETURNS ?Any@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE token = IF TRUE THEN
      aST__node__token(node_or_token)
    ELSE
      node_or_token
    END;
    RETURN CAST(token AS ?Any@multiowned);
}
END
PRIVATE FN typeAnalysisSession__source_error_token(self: TypeAnalysisSession, token: ?Any@multiowned) RETURNS ?Token
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF ((token != NIL) AND (token IS_A Token)) THEN
      RETURN COPY token;
    END
    IF !((token != NIL)) THEN
      RETURN NIL;
    END
    RETURN Token{ type: :ANCHOR, value: NIL, line: token.line(), column: token.column(), file: NIL, start_offset: NIL, end_offset: NIL, end_line: NIL, end_column: NIL };
}
END
PRIVATE FN typeAnalysisSession__diagnostic_output(self: TypeAnalysisSession, message: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    Kernel.warn(message);
    NIL;
}
END
PRIVATE FN typeAnalysisSession__check_prefixed_int_range_mut(self: TypeAnalysisSession, node: Locatable, effective_type: ?TypeTypeInput) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF effective_type EXISTS AS effective_type_value THEN
      MUTABLE val: ?Int64 = typeAnalysisSession__integer_literal_range_value(rtoc_self_view, node);
      IF val EXISTS AS val_value THEN
        MUTABLE literal_value = val_value;
        MUTABLE checked_type = COPY effective_type_value;
        MUTABLE t: ?String@symbol = typeAnalysisSession__integer_range_target_type(rtoc_self_view, checked_type);
        IF t EXISTS AS t_value THEN
          MUTABLE type_sym = t_value;
          MUTABLE max: ?Int64 = type__integer_type_max(type_sym);
          IF max EXISTS AS max_value_2 THEN
            MUTABLE max_value = max_value_2;
            MUTABLE min = (type__integer_type_min(type_sym) OR_ELSE 0);
            IF ((literal_value < min) OR (literal_value > max_value)) THEN
              IF node IS_A Literal AS literal THEN
                typeAnalysisSession__handle_prefixed_int_overflow_mut(rtoc_self_view, literal, literal_value, type_sym, min, max_value);
              ELSE
                typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :INT_LITERAL_OVERFLOW }, [], {:val: literal_value, :type: type_sym, :min: min, :max: max_value});
              END
            END
          ELSE
            RETURN;
          END
        ELSE
          RETURN;
        END
      ELSE
        RETURN;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__integer_literal_range_value(self: TypeAnalysisSession, node: Locatable) RETURNS ?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A Literal AS literal THEN
      IF (ruby_union_scalar_equal_Type_String_symbol(literal.type, :PREFIXED_INT) OR ruby_union_scalar_equal_Type_String_symbol(literal.type, :INT64)) THEN
        RETURN literal.value;
      END
    END
    RETURN typeAnalysisSession__negative_integer_literal_range_value(rtoc_self_view, node);
}
END
PRIVATE FN typeAnalysisSession__negative_integer_literal_range_value(self: TypeAnalysisSession, node: Locatable) RETURNS ?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(node IS_A UnaryOp) THEN
      RETURN NIL;
    END
    IF !((node.op() == :SUB)) THEN
      RETURN NIL;
    END
    MUTABLE lit = node.right();
    IF !(lit IS_A Literal) THEN
      RETURN NIL;
    END
    IF !(((lit.type() == :INT64) OR (lit.type() == :PREFIXED_INT))) THEN
      RETURN NIL;
    END
    RETURN (-lit.value());
}
END
PRIVATE FN typeAnalysisSession__integer_range_target_type(self: TypeAnalysisSession, effective_type: TypeTypeInput) RETURNS ?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE current_type = COPY effective_type;
    IF (IF current_type IS_A Type AS type THEN type__error_union?(type) ELSE FALSE END) THEN
      MUTABLE payload_type = current_type.payload_type();
      IF !(payload_type) THEN
        RETURN NIL;
      END
      current_type = payload_type;
    END
    IF current_type IS_A Type AS type THEN
      RETURN type__resolved(type);
    ELSE_IF current_type IS_A String@symbol AS string_symbol THEN
      RETURN string_symbol;
    ELSE_IF current_type IS_A String AS string THEN
      RETURN symbol(string);
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__emit_protocol_projection_issue_mut(self: TypeAnalysisSession, node: Node, issue: ProtocolProjectionIssue) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE arguments = COPY issue.arguments;
    IF (issue.code == :GENERIC_PROJECTION_UNKNOWN_OWNER) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_PROJECTION_UNKNOWN_OWNER }, [], {:owner: UNWRAP (arguments[:owner]), :member: UNWRAP (arguments[:member])});
    ELSE_IF (issue.code == :GENERIC_PROJECTION_NEEDS_PROTOCOL) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_PROJECTION_NEEDS_PROTOCOL }, [], {:owner: UNWRAP (arguments[:owner]), :member: UNWRAP (arguments[:member]), :protocol: UNWRAP (arguments[:protocol])});
    ELSE_IF (issue.code == :GENERIC_UNKNOWN_ASSOCIATED_TYPE) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_UNKNOWN_ASSOCIATED_TYPE }, [], {:owner: UNWRAP (arguments[:owner]), :member: UNWRAP (arguments[:member]), :protocol: UNWRAP (arguments[:protocol]), :available: UNWRAP (arguments[:available])});
    ELSE_IF (issue.code == :GENERIC_AMBIGUOUS_ASSOCIATED_TYPE) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_AMBIGUOUS_ASSOCIATED_TYPE }, [], {:owner: UNWRAP (arguments[:owner]), :member: UNWRAP (arguments[:member]), :protocols: UNWRAP (arguments[:protocols])});
    ELSE
      panic("Unhandled protocol projection issue {}");
    END
}
END
PRIVATE FN typeAnalysisSession__validate_type_param_list_mut(self: TypeAnalysisSession, node: GenericDeclarationNode, type_params: []String, kind: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE seen = {};
    FOR _ IN type_params DO
    MUTABLE param_sym = symbol(_);
    IF seen[param_sym] THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_DUP_TYPE_PARAM_KIND }, [], {:param: _, :kind: kind, :name: node.name()});
    END
    IF builtin_types.contains?(param_sym) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_TYPE_PARAM_SHADOWS }, [], {:param: _});
    END
    seen[param_sym] = TRUE;
    END
}
END
PRIVATE FN typeAnalysisSession__validate_type_annotation_mut(self: TypeAnalysisSession, node: AnnotationNode, MUTABLE type_obj: Type, is_param: Bool = FALSE) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF type__fn_type?(type_obj) THEN
      typeAnalysisSession__resolve_associated_projection_protocols_mut(rtoc_self_view, node, &type_obj);
      RETURN;
    END
    typeAnalysisSession__resolve_associated_projection_protocols_mut(rtoc_self_view, node, &type_obj);
    MUTABLE facts = typeAnalysisSession__type_annotation_facts(rtoc_self_view, node, type_obj, is_param);
    typeAnalysisSession__validate_param_annotation_capabilities_mut(rtoc_self_view, facts);
    typeAnalysisSession__validate_collection_annotation_capabilities_mut(rtoc_self_view, facts);
    typeAnalysisSession__validate_collection_allocation_hint_mut(rtoc_self_view, facts);
    typeAnalysisSession__validate_observable_annotation_capabilities_mut(rtoc_self_view, facts);
    typeAnalysisSession__validate_shape_annotation_capabilities_mut(rtoc_self_view, facts);
    typeAnalysisSession__validate_generic_annotation_mut(rtoc_self_view, facts);
    NIL;
}
END
PRIVATE FN typeAnalysisSession__validate_collection_allocation_hint_mut(self: TypeAnalysisSession, facts: TypeAnnotationFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(TRY (type__preallocation_hint?(facts.type_obj))) THEN
      RETURN;
    END
    IF (!(facts.is_param) AND ((facts.node IS_A VarDecl OR facts.node IS_A BindExpr))) THEN
      RETURN;
    END
    typeAnalysisSession__error_mut(rtoc_self_view, facts.node, TypeAnalysisCodeOrMessage{ SymbolValue: :COLLECTION_HINT_VALUE_ONLY });
}
END
PRIVATE FN typeAnalysisSession__type_annotation_facts(self: TypeAnalysisSession, node: AnnotationNode, type_obj: Type, is_param: Bool) RETURNS !TypeAnnotationFacts
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TypeAnnotationFacts{ node: COPY node, type_obj: COPY type_obj, is_param: COPY is_param, inner: CAST(COPY typeAnalysisSession__type_annotation_inner(rtoc_self_view, type_obj) AS Type), inner_array: (type__tense?(type_obj) AND ((TRY (type__tense_type(type_obj)) != NIL) AND (type__array?(((TRY (type__tense_type(type_obj)))?)) == TRUE))), fn_type_params: COPY TRY (typeAnalysisSession__current_function_type_params(rtoc_self_view)) };
}
END
PRIVATE FN typeAnalysisSession__type_annotation_inner(self: TypeAnalysisSession, type_obj: Type) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE inner = COPY type_obj;
    WHILE TRUE DO
      MUTABLE next_inner_branch_value: ?Type = NIL;
      IF type__error_union?(inner) THEN
        next_inner_branch_value = TRY (type__payload_type(inner));
      ELSE_IF type__optional?(inner) THEN
        next_inner_branch_value = TRY (type__wrapped_type(inner));
      ELSE
        next_inner_branch_value = NIL;
      END
      MUTABLE next_inner: ?Type = next_inner_branch_value;
      IF next_inner EXISTS AS next_inner_value THEN
        inner = next_inner_value;
      ELSE
        RETURN inner;
      END
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__validate_param_annotation_capabilities_mut(self: TypeAnalysisSession, facts: TypeAnnotationFacts) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(facts.is_param) THEN
      RETURN;
    END
    MUTABLE type_obj = COPY facts.type_obj;
    MUTABLE has_ownership_cap = ([:multiowned, :split]).contains?(type__ownership(type_obj));
    MUTABLE primitive_atomic_param = (type__atomic?(type_obj) AND type__primitive?(type_obj));
    MUTABLE has_sync_cap = (((type__sync(type_obj) != NIL) AND !(primitive_atomic_param)) AND !(([:raw, :symbol, :c, :size]).contains?(type__sync(type_obj))));
    IF (has_ownership_cap OR has_sync_cap) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, facts.node, TypeAnalysisCodeOrMessage{ SymbolValue: :FN_PARAM_NO_CAPABILITY });
    END
}
END
PRIVATE FN typeAnalysisSession__validate_collection_annotation_capabilities_mut(self: TypeAnalysisSession, facts: TypeAnnotationFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE type_obj = COPY facts.type_obj;
    MUTABLE shape = COPY facts.inner;
    IF (type__split?(type_obj) AND !(TRY (type__stream?(type_obj)))) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, facts.node, TypeAnalysisCodeOrMessage{ SymbolValue: :ATSPLIT_STREAM_ONLY });
    END
    IF TRY (type__list_requires_array_shape?(shape)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, facts.node, TypeAnalysisCodeOrMessage{ SymbolValue: :COLLECTION_NEEDS_ARRAY_TYPE }, [], {:cap: "@list", :example: "User[]@list or User[N]@list"});
    END
    IF ((type__pool?(shape) AND !(type__array?(shape))) AND !(facts.inner_array)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, facts.node, TypeAnalysisCodeOrMessage{ SymbolValue: :COLLECTION_NEEDS_ARRAY_TYPE }, [], {:cap: "@pool", :example: "User[]@pool or User[N]@pool"});
    END
    IF ((type__set_collection?(shape) AND !(type__array?(shape))) AND !(facts.inner_array)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, facts.node, TypeAnalysisCodeOrMessage{ SymbolValue: :COLLECTION_NEEDS_ARRAY_TYPE }, [], {:cap: "@set", :example: "String[]@set"});
    END
    IF TRY (type__observable_array_without_set?(type_obj)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, facts.node, TypeAnalysisCodeOrMessage{ SymbolValue: :OBSERVABLE_REQUIRES_SET });
    END
    MUTABLE payload = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_174: ?Type = NIL;
    IF type__map?(shape) THEN
      rtoc_ternary_value_174 = TRY (type__value_type(shape));
    ELSE
      rtoc_ternary_value_174 = TRY (type__element_type(shape));
    END
    rtoc_ternary_value_174? };
    IF (((payload != NIL) AND (payload?).indirect?()) AND type__primitive?(payload)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, facts.node, TypeAnalysisCodeOrMessage{ SymbolValue: :INDIRECT_ELEMENT_PRIMITIVE }, [], {:type: payload.resolved()});
    END
    IF (type__sharded?(type_obj) AND ((payload != NIL) AND (payload?).multiowned?())) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, facts.node, TypeAnalysisCodeOrMessage{ SymbolValue: :SHARDED_ELEMENT_REQUIRES_SHARED }, [], {:got: CAST(payload AS String)});
    END
}
END
PRIVATE FN typeAnalysisSession__validate_observable_annotation_capabilities_mut(self: TypeAnalysisSession, facts: TypeAnnotationFacts) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE offending_own: ?String@symbol = NIL;
    MUTABLE offending_sync: ?String@symbol = NIL;
    MUTABLE type_obj = COPY facts.type_obj;
    IF !((type__tense?(type_obj) AND type__observable?(type_obj))) THEN
      RETURN;
    END
    IF ((type__sync(type_obj) != NIL) AND !(([:raw, :symbol, :c, :size]).contains?(type__sync(type_obj)))) THEN
      offending_sync = type__sync(type_obj);
    END
    IF ([:multiowned, :shared, :split]).contains?(type__ownership(type_obj)) THEN
      offending_own = type__ownership(type_obj);
    END
    IF !((IF offending_sync != NIL THEN offending_sync ELSE offending_own END)) THEN
      RETURN;
    END
    MUTABLE labels = typeAnalysisSession__observable_capability_labels(rtoc_self_view, offending_sync, offending_own);
    MUTABLE explain = typeAnalysisSession__observable_capability_explanation(rtoc_self_view, offending_sync, offending_own);
    typeAnalysisSession__error_mut(rtoc_self_view, facts.node, TypeAnalysisCodeOrMessage{ SymbolValue: :OBSERVABLE_NOT_COMBINABLE }, [], {:labels: labels.join(" / "), :explain: explain});
}
END
PRIVATE FN typeAnalysisSession__observable_capability_labels(self: TypeAnalysisSession, offending_sync: ?String@symbol, offending_own: ?String@symbol) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE labels: []String = ( { MUTABLE rtoc_empty_list_175: []String = List[]; rtoc_empty_list_175 } );
    IF offending_sync EXISTS AS offending_sync_value THEN
      &labels.append("sync wrapper :${offending_sync_value}");
    END
    IF offending_own EXISTS AS offending_own_value THEN
      &labels.append("ownership wrapper :${offending_own_value}");
    END
    RETURN labels;
}
END
PRIVATE FN typeAnalysisSession__observable_capability_explanation(self: TypeAnalysisSession, offending_sync: ?String@symbol, offending_own: ?String@symbol) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF ((offending_sync != NIL) AND (offending_own != NIL)) THEN
      RETURN "The observable is already a lock-free single-producer accumulator (extra sync is redundant) AND its heap-pointer lifetime is owned by the producing scope (sharing it across owners would race the producer's `finish()` against the cleanup-side `wait(); destroy()`).";
    END
    IF offending_sync EXISTS AS offending_sync_value THEN
      RETURN "The observable is already a lock-free single-producer accumulator; layering :${offending_sync_value} on top would double-synchronize, and its guard semantics conflict with WITH VIEW (which is meant to be a non-blocking single-load).";
    END
    RETURN "The observable's heap-pointer lifetime is owned by the producing scope (the producer fiber's `defer ctx.acc.finish()` plus the scope's `wait(); destroy()` cleanup assume exactly one owner). Sharing it via :${offending_own} would race the producer's lifetime against the destroy and corrupt the WaitGroup bridge.";
}
END
PRIVATE FN typeAnalysisSession__validate_shape_annotation_capabilities_mut(self: TypeAnalysisSession, facts: TypeAnnotationFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE type_obj = COPY facts.type_obj;
    IF type__soa_requires_fixed_array?(type_obj) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, facts.node, TypeAnalysisCodeOrMessage{ SymbolValue: :SOA_NEEDS_FIXED_ARRAY });
    END
    MUTABLE shard_count: ?Int64 = type__shard_count(type_obj);
    IF ((shard_count != NIL) AND (shard_count < 2)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, facts.node, TypeAnalysisCodeOrMessage{ SymbolValue: :SHARDED_NEEDS_2_PLUS }, [], {:got: shard_count});
    END
    IF (type__pool?(type_obj) AND !(type__fixed?(type_obj))) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, facts.node, TypeAnalysisCodeOrMessage{ SymbolValue: :POOL_NEEDS_FIXED_CAPACITY }, [], {:element: (IF TRY (type__element_type(type_obj)) != NIL THEN
        type__resolved((TRY (type__element_type(type_obj))))
      ELSE
        NIL
      END)});
    END
}
END
PRIVATE FN typeAnalysisSession__validate_generic_annotation_mut(self: TypeAnalysisSession, facts: TypeAnnotationFacts) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF type__projection?(facts.inner) THEN
      typeAnalysisSession__validate_associated_projection_mut(rtoc_self_view, facts.node, facts.inner);
      RETURN;
    END
    IF type__generic_instance?(facts.inner) THEN
      typeAnalysisSession__validate_generic_instance_annotation_mut(rtoc_self_view, facts);
    ELSE
      typeAnalysisSession__validate_plain_type_annotation_mut(rtoc_self_view, facts);
    END
}
END
PRIVATE FN typeAnalysisSession__validate_generic_instance_annotation_mut(self: TypeAnalysisSession, facts: TypeAnnotationFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE inner = COPY facts.inner;
    MUTABLE base_name = type__generic_base(inner);
    IF (base_name == :Id) THEN
      RETURN;
    END
    IF ((base_name == :Tuple) OR (base_name == :StreamStep)) THEN
      FOR _ IN (TRY (type__generic_args(inner))) DO
      typeAnalysisSession__validate_generic_type_arg_mut(rtoc_self_view, facts, _);
      END
      RETURN;
    END
    MUTABLE schema: ?GenericSchema = typeAnalysisSession__annotation_schema_for_mut(rtoc_self_view, facts.node, base_name);
    MUTABLE type_params = typeAnalysisSession__schema_type_params(rtoc_self_view, schema);
    IF (type_params.length() == 0) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, facts.node, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_NOT_GENERIC }, [], {:type: base_name});
    END
    MUTABLE expected = type_params.length();
    MUTABLE actual = (TRY (type__generic_args(inner))).length();
    IF (actual != expected) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, facts.node, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_WRONG_ARG_COUNT }, [], {:type: base_name, :expected: expected, :got: actual});
    END
    FOR _ IN (TRY (type__generic_args(inner))) DO
    typeAnalysisSession__validate_generic_type_arg_mut(rtoc_self_view, facts, _);
    END
    IF schema? IS_A StructSchema AS struct_schema THEN
      (struct_schema.generic_params.zip(TRY (type__generic_args(inner)))).keys() |> EACH {
    MUTABLE argument: Any = ((struct_schema.generic_params.zip(TRY (type__generic_args(inner))))[_] OR_ELSE panic("missing hash key"));
    IF !((_ AND argument)) THEN
      CONTINUE;
    END
    typeAnalysisSession__validate_generic_argument_bounds_mut(rtoc_self_view, facts.node, _, argument);
      };
    END
}
END
PRIVATE FN typeAnalysisSession__validate_generic_type_arg_mut(self: TypeAnalysisSession, facts: TypeAnnotationFacts, arg: Type) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF ((type__optional?(arg) OR type__error_union?(arg)) OR type__tense?(arg)) THEN
      MUTABLE wrapped = (IF TRY (type__wrapped_type(arg)) != NIL THEN TRY (type__wrapped_type(arg)) ELSE UNWRAP (TRY (type__payload_type(arg))) END);
      typeAnalysisSession__validate_generic_type_arg_mut(rtoc_self_view, facts, wrapped);
      RETURN;
    END
    IF type__array?(arg) THEN
      typeAnalysisSession__validate_generic_type_arg_mut(rtoc_self_view, facts, UNWRAP (TRY (type__element_type(arg))));
      RETURN;
    END
    IF type__projection?(arg) THEN
      typeAnalysisSession__validate_associated_projection_mut(rtoc_self_view, facts.node, arg);
      RETURN;
    END
    IF type__map?(arg) THEN
      RETURN;
    END
    IF type__generic_instance?(arg) THEN
      IF ((type__generic_base(arg) == :Tuple) OR (type__generic_base(arg) == :StreamStep)) THEN
        FOR _ IN (TRY (type__generic_args(arg))) DO
        typeAnalysisSession__validate_generic_type_arg_mut(rtoc_self_view, facts, _);
        END
        RETURN;
      END
      MUTABLE nested_schema: ?GenericSchema = CAST(typeAnalysisSession__lookup_type_schema(rtoc_self_view, type__generic_base(arg)) AS ?GenericSchema);
      IF (nested_schema == NIL) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, facts.node, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_UNKNOWN_TYPE_ARG }, [], {:type: type__resolved(arg)});
      END
      MUTABLE nested_params = typeAnalysisSession__schema_type_params(rtoc_self_view, nested_schema);
      IF (nested_params.length() != (TRY (type__generic_args(arg))).length()) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, facts.node, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_WRONG_ARG_COUNT }, [], {:type: type__generic_base(arg), :expected: nested_params.length(), :got: (TRY (type__generic_args(arg))).length()});
      END
      FOR _ IN (TRY (type__generic_args(arg))) DO
      typeAnalysisSession__validate_generic_type_arg_mut(rtoc_self_view, facts, _);
      END
      RETURN;
    END
    IF builtin_types.contains?(type__resolved(arg)) THEN
      RETURN;
    END
    IF facts.fn_type_params.contains?(type__resolved(arg)) THEN
      RETURN;
    END
    MUTABLE arg_schema: ?GenericSchema = CAST(typeAnalysisSession__lookup_type_schema(rtoc_self_view, type__resolved(arg)) AS ?GenericSchema);
    IF (arg_schema == NIL) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, facts.node, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_UNKNOWN_TYPE_ARG }, [], {:type: type__resolved(arg)});
    END
    MUTABLE type_params = typeAnalysisSession__schema_type_params(rtoc_self_view, arg_schema);
    IF (type_params.length() == 0) THEN
      RETURN;
    END
    MUTABLE params_hint = (type_params |> SELECT _.toString()).join(", ");
    typeAnalysisSession__error_mut(rtoc_self_view, facts.node, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_MISSING_TYPE_ARGS }, [], {:type: type__resolved(arg), :type2: type__resolved(arg), :hint: params_hint});
}
END
PRIVATE FN typeAnalysisSession__validate_plain_type_annotation_mut(self: TypeAnalysisSession, facts: TypeAnnotationFacts) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE base_name = type__resolved(facts.inner);
    IF facts.fn_type_params.contains?(base_name) THEN
      RETURN;
    END
    MUTABLE schema: ?GenericSchema = CAST(typeAnalysisSession__lookup_type_schema(rtoc_self_view, base_name) AS ?GenericSchema);
    MUTABLE type_params = typeAnalysisSession__schema_type_params(rtoc_self_view, schema);
    IF (type_params.length() == 0) THEN
      RETURN;
    END
    MUTABLE params_hint = (type_params |> SELECT _.toString()).join(", ");
    typeAnalysisSession__error_mut(rtoc_self_view, facts.node, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_MISSING_TYPE_ARGS }, [], {:type: base_name, :type2: base_name, :hint: params_hint});
}
END
PRIVATE FN typeAnalysisSession__annotation_schema_for_mut(self: TypeAnalysisSession, node: AnnotationNode, base_name: String@symbol) RETURNS ?GenericSchema
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE schema: ?GenericSchema = CAST(typeAnalysisSession__lookup_type_schema(rtoc_self_view, base_name) AS ?GenericSchema);
