UNION SourceType { SymbolValue: String@symbol, StringValue: String, Type: Type }
UNION TypeAnalysisSessionReturnValue { StringValue: String, SymbolValue: String@symbol, Type: Type, Int64Value: Int64 }
UNION TypeAnalysisSessionReturnValueItem { StringValue: String, SymbolValue: String@symbol }
PUB STRUCT TypeAnalysisSession {
  audit_inputs: CapabilityAuditInputs,
  config: AnnotatorPhasesTypeAnalysisSessionConfig,
  resolution: ResolutionFacts@multiowned,
  traversal_state: TraversalState
}

PUB STRUCT StreamYieldFrame {
  node: BgStreamBlock,
  expected_type: ?Type,
  yield_types: []Type,
  closed: Bool
}
PUB UNION AnnotatorPhasesTypeAnalysisSessionDeadlockEscapeValue { SymbolValue: String@symbol, TokenMultiowned: Token@multiowned, Token: Token }
PUB STRUCT TraversalState {
  scopes: []Scope@multiowned,
  function_contexts: []FunctionContext@multiowned,
  loop_depth: Int64,
  conditional_depth: Int64,
  smooth_depth: Int64,
  body_fact_frames: []BodyFactFrame,
  stream_yield_frames: []StreamYieldFrame,
  with_block_depth: Int64,
  match_pattern_depth: Int64,
  current_bg_pinned: Bool,
  pipeline_accessed_fields: ?[Set]String,
  auto_locked_assign_name: ?String,
  struct_literal_call_argument_depth: Int64,
  annotation_ancestors: []Locatable,
  comptime_type_param_refinements: {String@symbol}Type,
  value_type_refinements: {Int64}Type,
  branch_terminated: Bool,
  next_synthetic_body_ordinal: Int64,
  deferred_copy_wrapper_bindings: []Any@multiowned
}
PUB STRUCT AnnotatorPhasesTypeAnalysisSessionConfig {
  importer: ?ModuleImporter@multiowned,
  source_dir: String,
  strict_test: Bool,
  source_code: ?String
}
PUB FN typeAnalysisSession__semantic_function_nodes(self: TypeAnalysisSession) RETURNS !{String}FunctionDef
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (typeAnalysisSession__function_node_map(rtoc_self_view));
}
END
PUB FN typeAnalysisSession__semantic_function_registry(self: TypeAnalysisSession) RETURNS FunctionRegistry
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY rtoc_self_view.resolution.function_registry;
}
END
PUB FN typeAnalysisSession__function_node_map(self: TypeAnalysisSession) RETURNS !{String}FunctionDef
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY typeAnalysisSession__semantic_function_registry(rtoc_self_view).nodes;
}
END
PUB FN typeAnalysisSession__phase_traversal_state(self: TypeAnalysisSession) RETURNS TraversalState
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY rtoc_self_view.traversal_state;
}
END
PUB FN typeAnalysisSession__phase_audit_inputs(self: TypeAnalysisSession) RETURNS CapabilityAuditInputs
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY rtoc_self_view.audit_inputs;
}
END
PUB FN typeAnalysisSession__ownership_graph(self: TypeAnalysisSession) RETURNS OwnershipGraph@multiowned
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN KEEP rtoc_self_view.audit_inputs.ownership_graph;
}
END
PUB FN typeAnalysisSession__function_node_for(self: TypeAnalysisSession, name: ?String) RETURNS ?FunctionDef
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN CAST(COPY UNWRAP (typeAnalysisSession__semantic_function_registry(rtoc_self_view)[name]) AS ?FunctionDef);
}
END
PUB FN typeAnalysisSession__register_function_node_mut(self: TypeAnalysisSession, node: FunctionDef) RETURNS !FunctionDef
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN CAST(TRY (functionRegistry__register_mut(typeAnalysisSession__semantic_function_registry(rtoc_self_view), node)) AS FunctionDef);
}
END
PUB FN typeAnalysisSession__scope_stack(self: TypeAnalysisSession) RETURNS ![]Scope@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY rtoc_self_view.traversal_state.scopes;
}
END
PUB FN typeAnalysisSession__semantic_root_scope(self: TypeAnalysisSession) RETURNS Scope@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN KEEP UNWRAP (rtoc_self_view.traversal_state.scopes.first());
}
END
PUB FN typeAnalysisSession__semantic_program(self: TypeAnalysisSession) RETURNS Program
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN CAST(COPY KEEP rtoc_self_view.resolution.program AS Program);
}
END
PUB FN typeAnalysisSession__semantic_protocol(self: TypeAnalysisSession, name: String) RETURNS ?ProtocolDef
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY rtoc_self_view.resolution.protocols[name];
}
END
PUB FN typeAnalysisSession__semantic_protocols(self: TypeAnalysisSession) RETURNS !{String}ProtocolDef
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY rtoc_self_view.resolution.protocols;
}
