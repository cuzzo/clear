PRIVATE FN typeAnalysisSession__atomic_bind_operation(MUTABLE self: TypeAnalysisSession, MUTABLE node: BindExpr) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (node.compound_op == NIL) THEN
      RETURN :store;
    ELSE_IF (node.compound_op == :ADD) THEN
      RETURN :fetchAdd;
    ELSE_IF (node.compound_op == :SUB) THEN
      RETURN :fetchSub;
    ELSE_IF (node.compound_op == :MUL) OR (node.compound_op == :DIV) THEN
      MUTABLE op_str: String = "";
      IF (node.compound_op == :MUL) THEN
        op_str = "*=";
      ELSE
        op_str = "/=";
      END
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ BindExpr: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :ATOMIC_NO_MUL_DIV_COMPOUND }, [], CAST({:op: op_str} AS {String@symbol}Any)));
      RETURN NIL;
    ELSE
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ BindExpr: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :ATOMIC_UNSUPPORTED_COMPOUND }, [], CAST({:op: node.compound_op} AS {String@symbol}Any)));
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__visit_Identifier(MUTABLE self: TypeAnalysisSession, MUTABLE node: Identifier) RETURNS !?SymbolEntry@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__predicate_identifier_allowed_mut(&rtoc_self_view, &node));
    MUTABLE scope_branch_value: ?Scope@multiowned = NIL;
    IF (typeAnalysisSession__smooth_depth(&rtoc_self_view) > 0) THEN
      scope_branch_value = TRY (typeAnalysisSession__lookup_scope_for(&rtoc_self_view, node.name));
    ELSE
      scope_branch_value = TRY (typeAnalysisSession__resolve_variable_scope(&rtoc_self_view, node.name));
    END
    MUTABLE scope: ?Scope@multiowned = scope_branch_value;
    IF scope EXISTS AS scope_value THEN
      MUTABLE scope_value_mutable = COPY scope_value;
      TRY (scope__check_validity_mut(&scope_value_mutable, node.name));
      MUTABLE entry: ?SymbolEntry@multiowned = scope__resolve_entry(scope_value_mutable, node.name);
      MUTABLE raw_type_branch_value: ?Type@multiowned = NIL;
      IF entry EXISTS AS entry_value THEN
        raw_type_branch_value = (rtoc_self_view.traversal_state.value_type_refinements[entry_value.binding_id] OR_ELSE TRY (scope__resolve_full_type(scope_value_mutable, node.name)));
      ELSE
        raw_type_branch_value = TRY (scope__resolve_full_type(scope_value_mutable, node.name));
      END
      MUTABLE raw_type: Type@multiowned = raw_type_branch_value?;
      raw_type = TRY (typeAnalysisSession__refined_comptime_type_param_type(&rtoc_self_view, CAST(raw_type AS Type)));
      IF (type__fn_type?(raw_type) AND ((entry != NIL) AND (symbolEntry__storage(entry) == :static))) THEN
        TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ Identifier: COPY node }, raw_type));
        node.fn_ref = TRUE;
      ELSE_IF ((TRUE AND type__atomic?(raw_type)) AND (type__layout(raw_type) != :indirect)) THEN
        TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ Identifier: COPY node }, TRY (type__new(castTypeShapeRawToTypeConstructionInput(type__raw(raw_type))))));
        TRY (typeAnalysisSession__record_effect(&rtoc_self_view, symbol("CONTENTION")));
      ELSE
        TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ Identifier: COPY node }, raw_type));
      END
      IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_381 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
      ownershipGraph__moved?(rtoc_local_receiver_381, node.name) } THEN
        MUTABLE rtoc_graph_15285 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
        TRY (typeAnalysisSession__emit_use_of_moved_error_mut(&rtoc_self_view, node, UNWRAP (ownershipGraph__get_index(rtoc_graph_15285, node.name))));
      END
      MUTABLE owner: ?Scope@multiowned = TRY (typeAnalysisSession__lookup_scope_for(&rtoc_self_view, node.name));
      IF owner != NIL THEN
            scope__mark_read(&owner, node.name);
      END
      IF owner != NIL THEN
        node.symbol = UNWRAP (scope__entry_for_write(&owner, node.name));
      ELSE
        node.symbol = NIL;
      END
      TRY (typeAnalysisSession__record_capture_identifier_mut(&rtoc_self_view, &node));
      MUTABLE rtoc_owned_return_382: ?SymbolEntry@multiowned = node.symbol;
      RETURN COPY rtoc_owned_return_382;
    ELSE
      IF TRY (typeAnalysisSession__current_function_type_param?(&rtoc_self_view, symbol(node.name))) THEN
        TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ Identifier: COPY node }, :Type));
        RETURN NIL;
      END
      MUTABLE type_schema: ?SchemaValue = TRY (typeAnalysisSession__lookup_type_schema(&rtoc_self_view, symbol(node.name)));
      IF type_schema THEN
        TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ Identifier: COPY node }, :Type));
        RETURN NIL;
      END
      TRY (typeAnalysisSession__emit_typo_suggestion_mut(&rtoc_self_view, TypoToken{ TokenMultiowned: COPY node.token }, node.name, (TRY (typeAnalysisSession__outer_scope_vars(&rtoc_self_view))) |> SELECT COPY _, "Undefined variable '${node.name}'", "closest in-scope variable"));
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__classify_ownership_mut(MUTABLE self: TypeAnalysisSession, MUTABLE entry: SymbolEntry) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE type_obj = symbolEntry__type(entry);
    IF type__fn_type?(type_obj) THEN
      RETURN NIL;
    END
    MUTABLE ownership_kind: String@symbol = :affine;
    IF symbolEntry__resource(entry) THEN
      ownership_kind = :resource;
    ELSE_IF ((type__multiowned?(type_obj) OR type__shared?(type_obj)) OR symbolEntry__rc_stored?(entry)) THEN
      ownership_kind = :rc;
    ELSE_IF symbolEntry__sync(entry) THEN
      ownership_kind = :sync;
    ELSE_IF type__collection?(type_obj) THEN
      ownership_kind = :collection;
    ELSE_IF (!(symbolEntry__takes(entry)) AND TRY (type__implicitly_copyable?(type_obj, %(t: String@symbol) USE(MUTABLE rtoc_self_view) -> TRY (typeAnalysisSession__schema_lookup_result(&rtoc_self_view, t))))) THEN
      ownership_kind = :value;
    END
    symbolEntry__set_ownership_kind(&entry, ownership_kind);
    RETURN COPY ownership_kind;
}
END
PRIVATE FN typeAnalysisSession__track_union_alias(MUTABLE self: TypeAnalysisSession, var_name: String, MUTABLE value_node: Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !((value_node IS_A FuncCall OR value_node IS_A MethodCall)) THEN
      RETURN;
    END
    MUTABLE ret_type = TRY (aST__full_type_mut(value_node));
    IF !(ret_type) THEN
      RETURN;
    END
    MUTABLE ret_type_obj_branch_value: ?Type = NIL;
    IF TRUE THEN
      ret_type_obj_branch_value = ret_type;
    ELSE
      ret_type_obj_branch_value = TRY (type__new( TypeConstructionInput{ Type: COPY ret_type }));
    END
    MUTABLE ret_type_obj: Type = ret_type_obj_branch_value?;
    MUTABLE schema: ?SchemaValue = TRY (typeAnalysisSession__lookup_type_schema(&rtoc_self_view, type__resolved(ret_type_obj)));
    IF !(schemas__union?(schema)) THEN
      RETURN;
    END
    MUTABLE has_heap = (((schemaValue__variants(UNWRAP (schema)) OR_ELSE {}))) |> ANY TRY (type__variant_has_heap?(_._1));
    IF !(has_heap) THEN
      RETURN;
    END
    MUTABLE first_arg =   IF value_node IS_A MethodCall THEN
      locatable__object(value_node)
    ELSE_IF type__any?(locatable__args(value_node)) THEN
      locatable__args(value_node).first()
    ELSE
      NIL
    END;
    IF !(first_arg IS_A Identifier) THEN
      RETURN;
    END
    MUTABLE arg_type = first_arg.resolved_type;
    IF ((arg_type == type__resolved(ret_type_obj)) OR type__map?((TRY (aST__full_type_mut(first_arg))))) THEN
      MUTABLE rtoc_mutable_receiver_383 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
      TRY (ownershipGraph__add_edge(&rtoc_mutable_receiver_383, Edge{ from: COPY var_name, to: COPY first_arg.name(), kind: :aliases }));
    END
}
END
PRIVATE FN typeAnalysisSession__accumulate_stack_bytes(MUTABLE self: TypeAnalysisSession, storage: String@symbol, MUTABLE node: DeclarationNode) RETURNS ?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_ctx: FunctionContext@multiowned = UNWRAP (typeAnalysisSession__current_fn_ctx(&rtoc_self_view));
    IF !(((storage == :stack) AND (TRUE))) THEN
      RETURN NIL;
    END
    MUTABLE bytes = (((declarationNode__slot_size(node) OR_ELSE 1)) * 8);
    functionContext__record_stack_bytes_mut( &fn_ctx, bytes);
    RETURN bytes;
}
END
PRIVATE FN typeAnalysisSession__mark_var_mutated(MUTABLE self: TypeAnalysisSession, name: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE scope: ?Scope@multiowned = TRY (typeAnalysisSession__lookup_scope_for(&rtoc_self_view, name));
    IF scope EXISTS AS scope_value THEN
      MUTABLE scope_value_mutable = COPY scope_value;
      MUTABLE entry: ?SymbolEntry@multiowned = scope__entry_for_write(&scope_value_mutable, name);
      IF entry EXISTS AS entry_value THEN
        MUTABLE entry_value_mutable = COPY entry_value;
        symbolEntry__mark_mutated_mut(&entry_value_mutable, TRUE);
        TRY (typeAnalysisSession__audit_mark_mutated(&rtoc_self_view, name));
      ELSE
        RETURN;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__mark_var_mutated_via_call(MUTABLE self: TypeAnalysisSession, name: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE scope: ?Scope@multiowned = TRY (typeAnalysisSession__lookup_scope_for(&rtoc_self_view, name));
    IF scope EXISTS AS scope_value THEN
      MUTABLE scope_value_mutable = COPY scope_value;
      MUTABLE entry: ?SymbolEntry@multiowned = scope__entry_for_write(&scope_value_mutable, name);
      IF entry EXISTS AS entry_value THEN
        MUTABLE entry_value_mutable = COPY entry_value;
        symbolEntry__mark_mutated_via_reference_mut(&entry_value_mutable);
        TRY (typeAnalysisSession__audit_mark_mutated(&rtoc_self_view, name));
      ELSE
        RETURN;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__chain_root_name(MUTABLE self: TypeAnalysisSession, MUTABLE node: Locatable) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE curr: Locatable = COPY node;
    WHILE ((curr IS_A GetField OR curr IS_A GetIndex) OR curr IS_A OptionalUnwrap) DO
      curr = UNWRAP (aST__node_target(curr));
    END
    IF curr IS_A Identifier AS identifier THEN
      RETURN COPY identifier__name(identifier);
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__interior_mutable_access_path?(MUTABLE self: TypeAnalysisSession, MUTABLE node: AccessPathNode) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE curr: AccessPathNode = COPY node;
    WHILE TRUE DO
      MUTABLE type = TRY (aST__full_type_mut( castAccessPathNodeToLocatable(curr)));
      IF symbolEntry__always_mutable_sync?(type__sync(type)) THEN
        RETURN TRUE;
      END
      IF !(((curr IS_A GetField OR curr IS_A GetIndex) OR curr IS_A OptionalUnwrap)) THEN
        BREAK;
      END
      curr = UNWRAP (castLocatableToAccessPathNode(UNWRAP (accessPathNode__target(curr))));
    END
    RETURN FALSE;
}
END
PRIVATE FN typeAnalysisSession__visit_Assignment(MUTABLE self: TypeAnalysisSession, MUTABLE node: Assignment) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE previous_auto_lock: ?String = COPY typeAnalysisSession__phase_traversal_state(&rtoc_self_view).auto_locked_assign_name;
    MUTABLE auto_lock_name: ?String = COPY previous_auto_lock;
    MUTABLE target = COPY node.name;
    IF target IS_A GetField AS get_field THEN
    IF get_field.target IS_A Identifier THEN
      MUTABLE tname: ?String = aST__node_name(get_field.target);
      MUTABLE tscope: ?Scope@multiowned = TRY (typeAnalysisSession__lookup_scope_for(&rtoc_self_view, UNWRAP (tname)));
      MUTABLE tsym: ?SymbolEntry@multiowned = NIL;
      IF tscope != NIL THEN
        tsym = COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_384 = tscope;
      scope__resolve_entry(rtoc_local_receiver_384, UNWRAP (tname)) };
      END
      IF (IF (IF (IF tsym != NIL THEN
        symbolEntry__locked?(tsym)
      ELSE
        NIL
      END) != NIL THEN (IF tsym != NIL THEN
        symbolEntry__locked?(tsym)
      ELSE
        NIL
      END) ELSE (IF tsym != NIL THEN
        symbolEntry__write_locked?(tsym)
      ELSE
        NIL
      END) END) != NIL THEN (IF (IF tsym != NIL THEN
        symbolEntry__locked?(tsym)
      ELSE
        NIL
      END) != NIL THEN (IF tsym != NIL THEN
        symbolEntry__locked?(tsym)
      ELSE
        NIL
      END) ELSE (IF tsym != NIL THEN
        symbolEntry__write_locked?(tsym)
      ELSE
        NIL
      END) END) ELSE (IF tsym != NIL THEN
        symbolEntry__atomic_ptr?(tsym)
      ELSE
        NIL
      END) END) THEN
        auto_lock_name = tname;
      END
    END
    END
    rtoc_self_view.traversal_state.auto_locked_assign_name = auto_lock_name;
    DEFER rtoc_self_view.traversal_state.auto_locked_assign_name = previous_auto_lock;
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.value));
    IF node.value IS_A IfStatement THEN
      MUTABLE rtoc_if_value = UNWRAP (castLocatableToIfStatement(node.value));
      TRY (typeAnalysisSession__promote_to_expr_if_mut(&rtoc_self_view, Locatable{ Assignment: COPY node }, &rtoc_if_value));
    END
    IF node.value IS_A MatchStatement THEN
      MUTABLE rtoc_match_value = castLocatableToMatchStatement(node.value);
      TRY (typeAnalysisSession__promote_to_expr_match_mut(&rtoc_self_view, Locatable{ Assignment: COPY node }, &rtoc_match_value));
    END
    TRY (typeAnalysisSession__verify_unrestricted_mut(&rtoc_self_view, Node{ Assignment: COPY node }));
    TRY (typeAnalysisSession__verify_tied_assignment_mut(&rtoc_self_view, node));
    target = COPY node.name;
    IF target IS_A Identifier AS identifier THEN
      TRY (typeAnalysisSession__visit_assignment_variable(&rtoc_self_view, identifier, &node));
    ELSE_IF target IS_A GetIndex AS get_index THEN
      MUTABLE get_index_mutable = COPY get_index;
      TRY (typeAnalysisSession__visit_assignment_index(&rtoc_self_view, &get_index_mutable, &node));
    ELSE_IF target IS_A GetField AS get_field THEN
      MUTABLE get_field_mutable = COPY get_field;
      TRY (typeAnalysisSession__visit_assignment_field(&rtoc_self_view, &get_field_mutable, &node));
    ELSE
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ Assignment: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :INVALID_ASSIGNMENT_TARGET }, [], CAST({:got: DiagnosticKwValue{ StringValue: assignmentName__variant_name(target) }} AS {String@symbol}Any)));
    END
    TRY (typeAnalysisSession__handle_assign_move(&rtoc_self_view, Node{ Assignment: COPY node }));
    TRY (typeAnalysisSession__handle_assign_borrow(&rtoc_self_view, Node{ Assignment: COPY node }));
    IF node.name IS_A Identifier THEN
      RETURN typeAnalysisSession__og_set_live(&rtoc_self_view, UNWRAP (assignmentName__name(node.name)));
    END
}
END
PRIVATE FN typeAnalysisSession__visit_assignment_variable(MUTABLE self: TypeAnalysisSession, identifier: Identifier, MUTABLE node: Assignment) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE var_name = COPY identifier.name;
    MUTABLE scope = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
    IF !(scope__entry?(&scope, var_name)) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ Assignment: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :ASSIGN_UNDEFINED_VAR }, [], CAST({:name: var_name} AS {String@symbol}Any)));
    END
    IF scope__is_immutable?(scope, var_name) THEN
      MUTABLE fix: ?Fix@multiowned = TRY (typeAnalysisSession__build_declare_mutable_fix(&rtoc_self_view, var_name, scope));
      IF fix EXISTS AS fix_value THEN
        TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ Assignment: COPY node } }, :ownership, [fix_value], NIL, :ASSIGN_VAR_IMMUTABLE, :error, FALSE, CAST({:name: var_name} AS {String@symbol}Any)));
      ELSE
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ Assignment: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :ASSIGN_VAR_IMMUTABLE }, [], CAST({:name: var_name} AS {String@symbol}Any)));
      END
    END
    MUTABLE expected_type = TRY (scope__resolve_full_type(scope, var_name));
    IF (((typeAnalysisSession__language_mode(&rtoc_self_view) != :strict) AND node.value IS_A Identifier) AND !(TRY (type__implicitly_copyable?((TRY (aST__full_type_mut(node.value))), %(name: String@symbol) USE(MUTABLE rtoc_self_view) -> TRY (typeAnalysisSession__schema_lookup_result(&rtoc_self_view, name)))))) THEN
      MUTABLE rtoc_assign_value = UNWRAP (aST__node_value(Locatable{ Assignment: COPY node }));
      locatable__set_ownership_pending_transfer_mut(&rtoc_assign_value, TRUE);    END
    TRY (typeAnalysisSession__validate_assignment_type(&rtoc_self_view, Node{ Assignment: COPY node }, TypeTypeInput{ Type: COPY TRY (scope__resolve_type(scope, var_name)) }, (IF locatable__resolved_type(node.value) EXISTS AS rtoc_vt THEN TypeTypeInput{ SymbolValue: COPY rtoc_vt } ELSE NIL END)));
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ Assignment: COPY node }, TRY (scope__resolve_type(scope, var_name))));
    MUTABLE entry: ?SymbolEntry@multiowned = scope__resolve_entry(scope, var_name);
    IF entry EXISTS AS entry_value THEN
      MUTABLE entry_value_mutable = COPY entry_value;
      entry_value_mutable.reassigned = TRUE;
    END
    TRY (typeAnalysisSession__mark_var_mutated(&rtoc_self_view, var_name));
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__visit_assignment_index(MUTABLE self: TypeAnalysisSession, MUTABLE index_node: GetIndex, MUTABLE assignment_node: Assignment) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, Locatable{ GetIndex: COPY index_node }));
    typeAnalysisSession__mark_chain_needs_mut_ref_mut(&rtoc_self_view, Locatable{ GetIndex: COPY index_node });
    IF index_node.target IS_A Identifier THEN
      MUTABLE var_name: ?String = aST__node_name(index_node.target);
      IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_387 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
      scope__is_immutable?(rtoc_local_receiver_387, UNWRAP (var_name)) } THEN
        TRY (typeAnalysisSession__emit_immutable_index_assignment_error_mut(&rtoc_self_view, assignment_node, TRY (typeAnalysisSession__current_scope(&rtoc_self_view)), UNWRAP (var_name)));
      END
      TRY (typeAnalysisSession__mark_var_mutated(&rtoc_self_view, UNWRAP (var_name)));
    ELSE
      MUTABLE root: ?String = typeAnalysisSession__chain_root_name(&rtoc_self_view, &index_node.target);
      IF root EXISTS AS root_value THEN
        TRY (typeAnalysisSession__mark_var_mutated(&rtoc_self_view, root_value));
      END
    END
    MUTABLE target_type = TRY (aST__full_type_mut(index_node.target));
    MUTABLE protocol_map = TRY (typeAnalysisSession__map_requires_protocol_lowering?(&rtoc_self_view, target_type));
    MUTABLE assign_type = TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }));
    IF protocol_map THEN
      TRY (typeAnalysisSession__require_generic_map_access_scope_mut(&rtoc_self_view, index_node.target, target_type));
      index_node.protocol_operation = :map_put;
      assign_type = CAST(TRY (typeAnalysisSession__protocol_map_associated_type(&rtoc_self_view, target_type, :Value)) AS Type);
    ELSE_IF (!((FALSE)) AND type__map?(target_type)) THEN
      assign_type = type__value_type(target_type);
    ELSE
      MUTABLE index_type = TRY (aST__full_type_mut(Locatable{ GetIndex: COPY index_node }));
      IF type__optional?(index_type) THEN
        assign_type = UNWRAP (TRY (type__wrapped_type(index_type)));
      ELSE
        assign_type = CAST(index_type AS Type);
      END
    END
    IF (((typeAnalysisSession__language_mode(&rtoc_self_view) != :strict) AND assignment_node.value IS_A Identifier) AND !(TRY (type__implicitly_copyable?((TRY (aST__full_type_mut(assignment_node.value))), %(name: String@symbol) USE(MUTABLE rtoc_self_view) -> TRY (typeAnalysisSession__schema_lookup_result(&rtoc_self_view, name)))))) THEN
      locatable__set_ownership_pending_transfer_mut(&assignment_node.value, TRUE);
    END
    TRY (typeAnalysisSession__validate_assignment_type(&rtoc_self_view, Node{ Assignment: COPY assignment_node }, castTypeToOptionalTypeTypeInput__type_analysis_session(assign_type), (IF locatable__resolved_type(assignment_node.value) EXISTS AS rtoc_wrap_15708 THEN TypeTypeInput{ SymbolValue: COPY rtoc_wrap_15708 } ELSE NIL END)));
    IF protocol_map THEN
      TRY (typeAnalysisSession__consume_generic_map_value_mut(&rtoc_self_view, &assignment_node.value, assign_type));
    END
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ Assignment: COPY assignment_node }, assign_type));
    IF (type__map?(target_type) OR protocol_map) THEN
      IF typeAnalysisSession__current_fn_ctx(&rtoc_self_view) != NIL THEN
            MUTABLE rtoc_mutable_receiver_388 = UNWRAP (typeAnalysisSession__current_fn_ctx(&rtoc_self_view));
            functionContext__record_heap_use_mut(&rtoc_mutable_receiver_388);
      END
      IF typeAnalysisSession__current_fn_ctx(&rtoc_self_view) != NIL THEN
            MUTABLE rtoc_mutable_receiver_389 = UNWRAP (typeAnalysisSession__current_fn_ctx(&rtoc_self_view));
            functionContext__record_alloc_use_mut(&rtoc_mutable_receiver_389);
      END
      TRY (typeAnalysisSession__record_effect(&rtoc_self_view, symbol("HEAP")));
    END
}
END
PRIVATE FN typeAnalysisSession__visit_assignment_field(MUTABLE self: TypeAnalysisSession, MUTABLE field_node: GetField, MUTABLE assignment_node: Assignment) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    field_node.is_assignment_lhs = TRUE;
    TRY (typeAnalysisSession__visit(&rtoc_self_view, Locatable{ GetField: COPY field_node }));
    MUTABLE navigation = COPY field_node.target;
    IF (IF navigation IS_A TenseNavigation AS tense_navigation THEN tense_navigation.markers.contains?("~") ELSE FALSE END) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ Assignment: COPY assignment_node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :TENSE_NAVIGATION_MUTATION }, [], CAST({:markers: locatable__markers(navigation)} AS {String@symbol}Any)));
    END
    TRY (typeAnalysisSession__reject_bare_atomic_ptr_mutation_mut(&rtoc_self_view, &field_node, assignment_node));
    typeAnalysisSession__mark_chain_needs_mut_ref_mut(&rtoc_self_view, Locatable{ GetField: COPY field_node });
    IF field_node.target IS_A Identifier THEN
      MUTABLE var_name: ?String = aST__node_name(field_node.target);
      MUTABLE syn: ?String = (IF locatable__symbol(field_node.target) != NIL THEN
        symbolEntry__sync(UNWRAP ((locatable__symbol(field_node.target))))
      ELSE
        NIL
      END);
      IF ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_390 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
      scope__is_immutable?(rtoc_local_receiver_390, UNWRAP (var_name)) } AND (syn != :always_mutable)) THEN
        TRY (typeAnalysisSession__emit_immutable_field_assignment_error_mut(&rtoc_self_view, assignment_node, TRY (typeAnalysisSession__current_scope(&rtoc_self_view)), UNWRAP (var_name), field_node.field));
      END
      TRY (typeAnalysisSession__mark_var_mutated(&rtoc_self_view, UNWRAP (var_name)));
      syn = (IF locatable__symbol(field_node.target) != NIL THEN
        symbolEntry__sync(UNWRAP ((locatable__symbol(field_node.target))))
      ELSE
        NIL
      END);
      IF (((syn == :locked) OR (syn == :write_locked)) OR (syn == :always_mutable)) THEN
        assignment_node.auto_lock = AutoLockPlan{ var: COPY UNWRAP (var_name), sync: COPY UNWRAP (syn)};
      END
    ELSE
      MUTABLE target: AccessPathNode = COPY castLocatableToAccessPathNode(field_node.target);
      MUTABLE root: ?String = typeAnalysisSession__chain_root_name(&rtoc_self_view, castAccessPathNodeToLocatable(target));
      IF root EXISTS AS root_value THEN
        IF ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_391 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
        scope__is_immutable?(rtoc_local_receiver_391, root_value) } AND !(TRY (typeAnalysisSession__interior_mutable_access_path?(&rtoc_self_view, &target)))) THEN
          TRY (typeAnalysisSession__emit_immutable_field_assignment_error_mut(&rtoc_self_view, assignment_node, TRY (typeAnalysisSession__current_scope(&rtoc_self_view)), root_value, field_node.field));
        END
        TRY (typeAnalysisSession__mark_var_mutated(&rtoc_self_view, root_value));
      END
    END
    MUTABLE assignment_field_type = TRY (aST__full_type_mut(Locatable{ GetField: COPY field_node }));
    IF ((field_node.safe_nav_chain == TRUE) AND type__optional?(assignment_field_type)) THEN
      assignment_field_type = UNWRAP (TRY (type__wrapped_type(assignment_field_type)));
    END
    IF (((typeAnalysisSession__language_mode(&rtoc_self_view) != :strict) AND assignment_node.value IS_A Identifier) AND !(TRY (type__implicitly_copyable?((TRY (aST__full_type_mut(assignment_node.value))), %(name: String@symbol) USE(MUTABLE rtoc_self_view) -> TRY (typeAnalysisSession__schema_lookup_result(&rtoc_self_view, name)))))) THEN
      locatable__set_ownership_pending_transfer_mut(&assignment_node.value, TRUE);
    END
    IF type__multiowned?(assignment_field_type) THEN
      MUTABLE owner = (type__resolved((TRY (aST__full_type_mut(field_node.target)))));
      TRY (typeAnalysisSession__keep_param_identity_mut(&rtoc_self_view, assignment_node.value, CAST(assignment_field_type AS Type), "${owner}.${field_node.field}"));
    END
    TRY (typeAnalysisSession__validate_assignment_type(&rtoc_self_view, Node{ Assignment: COPY assignment_node }, TypeTypeInput{ Type: COPY assignment_field_type }, TypeTypeInput{ Type: COPY TRY (aST__full_type_mut(assignment_node.value)) }));
    RETURN TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ Assignment: COPY assignment_node }, :Void));
}
END
PRIVATE FN typeAnalysisSession__validate_assignment_type(MUTABLE self: TypeAnalysisSession, MUTABLE node: Node, target_type: ?TypeTypeInput, value_type: ?TypeTypeInput) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF target_type EXISTS AS target_type_value THEN
      MUTABLE target = TRY (type__new(castTypeTypeInputToTypeConstructionInput__type_analysis_session(target_type_value)));
      MUTABLE value = TRY (typeAnalysisSession__assignment_value_type(&rtoc_self_view, &node, value_type));
      IF ((type__any?(target) OR type__any?(value)) OR type__untyped?(value)) THEN
        RETURN;
      END
      IF (type__resolved(target) == symbol("NIL")) THEN
        RETURN;
      END
      MUTABLE union_schema: ?SchemaValue = TRY (typeAnalysisSession__lookup_type_schema(&rtoc_self_view, type__resolved((TRY (type__value_payload_type(target))))));
      MUTABLE value_node: Locatable = UNWRAP (aST__node_value(UNWRAP (castNodeToLocatable(node))));
      IF TRY (unionPayloadCompatibility__unique_variant(target, CAST(value AS Type), union_schema)) THEN
        locatable__set_coerced_type_object_mut(&value_node, target);
        RETURN;
      END
      IF TRY (type__accepts?(target, CAST(value AS Type))) THEN
        IF (!(TRY (type__equals?(target, castTypeToTypeTypeInput__type_analysis_session(value)))) OR ((TRY (type__node_reference?(target)) AND !(TRY (type__node_reference?(value)))))) THEN
          locatable__set_coerced_type_object_mut(&value_node, target);
        END
        RETURN;
      END
      TRY (typeAnalysisSession__emit_type_mismatch_assign_error_mut(&rtoc_self_view, &node, castTypeToTypeTypeInput__type_analysis_session(target), type__resolved(value)));
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__assignment_value_type(MUTABLE self: TypeAnalysisSession, MUTABLE node: Node, fallback: ?TypeTypeInput) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF castNodeToLocatable(node) EXISTS AS rtoc_node THEN
      IF aST__node_value(rtoc_node) EXISTS AS rtoc_value THEN
        IF TRY (locatable__typed?(rtoc_value)) THEN
          RETURN TRY (aST__full_type_mut(rtoc_value));
        END
      END
    END
    IF fallback EXISTS AS fallback_value THEN
      RETURN TRY (type__new(castTypeTypeInputToTypeConstructionInput__type_analysis_session(fallback_value)));
    END
    RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :Untyped }));
}
END
PRIVATE FN typeAnalysisSession__visit_DestructuringAssignment(MUTABLE self: TypeAnalysisSession, MUTABLE node: DestructuringAssignment) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.value));
    MUTABLE rhs = TRY (typeAnalysisSession__destructure_rhs_facts(&rtoc_self_view, &node));
    TRY (typeAnalysisSession__validate_destructure_shape_mut(&rtoc_self_view, &node, rhs));
    TRY (typeAnalysisSession__validate_destructure_copyable_mut(&rtoc_self_view, &node, rhs));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < node.targets.length() DO
      IF typeAnalysisSession__destructure_discard?(&rtoc_self_view, node.targets[rtoc_idx]?) THEN
          TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ DestructureTarget: COPY node.targets[rtoc_idx]? }, rhs.element_type));
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE target_value_type = TRY (typeAnalysisSession__destructure_value_type_at(rtoc_self_view, &node, rtoc_idx, rhs.element_type));
      IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_392 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
      scope__entry?(&rtoc_local_receiver_392, UNWRAP (node.targets[rtoc_idx]?.name)) } THEN
          TRY (typeAnalysisSession__finalize_destructure_assignment_target_mut(&rtoc_self_view, &node, node.targets[rtoc_idx]?, CAST(target_value_type AS Type)));
      ELSE
          TRY (typeAnalysisSession__finalize_destructure_declaration_target_mut(&rtoc_self_view, &node, node.targets[rtoc_idx]?, CAST(target_value_type AS Type)));
      END
    rtoc_idx = rtoc_idx + 1;
    END
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ DestructuringAssignment: COPY node }, :Void));
}
END
PRIVATE FN typeAnalysisSession__destructure_discard?(MUTABLE self: TypeAnalysisSession, target: DestructureTarget) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN (target.name == "_");
}
END
PRIVATE FN typeAnalysisSession__destructure_rhs_facts(MUTABLE self: TypeAnalysisSession, MUTABLE node: DestructuringAssignment) RETURNS !DestructureRhsFacts
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE value_type = TRY (type__success_type((TRY (aST__full_type_mut(node.value)))));
    MUTABLE element_type_branch_value: ?Type = NIL;
    IF type__tuple?(value_type) THEN
      element_type_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }));
    ELSE
      element_type_branch_value = (TRY (type__element_type(value_type)) OR_ELSE TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })));
    END
    MUTABLE element_type: Type = element_type_branch_value?;
    RETURN DestructureRhsFacts{ value_type: COPY value_type, element_type: COPY element_type };
}
END
PRIVATE FN typeAnalysisSession__validate_destructure_shape_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: DestructuringAssignment, rhs: DestructureRhsFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE value_type = COPY rhs.value_type;
    IF !((type__tuple?(value_type) OR ((type__fixed?(value_type) AND type__array?(value_type))))) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ DestructuringAssignment: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :DESTRUCTURE_REQUIRES_FIXED_SHAPE }, [], CAST({:got: type__to_s(value_type)} AS {String@symbol}Any)));
    END
    MUTABLE value_count_branch_value: ?TypeArrayCapacity = NIL;
    IF type__tuple?(value_type) THEN
      value_count_branch_value = (TRY (type__generic_args(value_type))).length();
    ELSE
      value_count_branch_value = type__capacity(value_type);
    END
    MUTABLE value_count: ?TypeArrayCapacity = value_count_branch_value;
    IF (type__capacity_text(value_count) != node.targets.length().toString()) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ DestructuringAssignment: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :DESTRUCTURE_ARITY_MISMATCH }, [], CAST({:targets: node.targets.length(), :values: value_count} AS {String@symbol}Any)));
    END
}
END
PRIVATE FN typeAnalysisSession__validate_destructure_copyable_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: DestructuringAssignment, rhs: DestructureRhsFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF type__tuple?(rhs.value_type) THEN
      RETURN;
    END
    MUTABLE copyable = TRY (type__implicitly_copyable?(rhs.element_type, %(t: String@symbol) USE(MUTABLE rtoc_self_view) -> TRY (typeAnalysisSession__schema_lookup_result(&rtoc_self_view, t))));
    IF copyable THEN
      RETURN;
    END
    TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ DestructuringAssignment: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :DESTRUCTURE_REQUIRES_COPYABLE_RHS }, [], CAST({:got: type__to_s(rhs.value_type)} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__destructure_value_type_at(self: TypeAnalysisSession, MUTABLE node: DestructuringAssignment, index_value: Int64, fallback: Type) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE value = node.value;
    IF (IF value IS_A ListLit THEN ((locatable__items(value) OR_ELSE List[])[index_value] != NIL) ELSE FALSE END) THEN
      RETURN TRY (aST__full_type_mut(UNWRAP ((locatable__items(value) OR_ELSE List[])[index_value])));
    END
    IF type__tuple?((TRY (aST__full_type_mut(node.value)))) THEN
      RETURN COPY UNWRAP ((TRY (type__generic_args((TRY (aST__full_type_mut(node.value))))))[index_value]);
    END
    RETURN COPY fallback;
}
END
PRIVATE FN typeAnalysisSession__finalize_destructure_declaration_target_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: DestructuringAssignment, MUTABLE target: DestructureTarget, value_type: Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF target.type EXISTS AS MUTABLE type_value THEN
      TRY (typeAnalysisSession__validate_type_annotation_mut(&rtoc_self_view, AnnotationNode{ DestructureTarget: COPY target }, &type_value));
    END
    MUTABLE final_type: ?Type = COPY target.type;
    TRY (typeAnalysisSession__validate_destructure_target_type_mut(&rtoc_self_view, &node, castTypeToTypeTypeInput__type_analysis_session( UNWRAP (final_type)), value_type));
    MUTABLE rtoc_target_loc = Locatable{ DestructureTarget: COPY target };
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, &rtoc_target_loc, final_type));
    MUTABLE rtoc_mutable_receiver_394 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
    TRY (scope__declare(&rtoc_mutable_receiver_394, target.name, SymbolEntryRegInput{ DestructureTarget: COPY target }, castTypeToOptionalSymbolEntryTypeInput__type_analysis_session( UNWRAP (final_type)), ScopeMutabilityInput{ BoolValue: (target.mutable OR_ELSE FALSE) }, FALSE));
    typeAnalysisSession__record_capture_local_mut(&rtoc_self_view, CAST(target.name AS String));
    target.symbol = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_395 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
    scope__local_entry_mut(&rtoc_local_receiver_395, target.name) };
    TRY (typeAnalysisSession__classify_ownership_mut(&rtoc_self_view, UNWRAP (target.symbol)));
    TRY (typeAnalysisSession__og_declare(&rtoc_self_view, target.name, Node{ DestructureTarget: COPY target }, castTypeToTypeTypeInput__type_analysis_session( UNWRAP (final_type))));
}
END
PRIVATE FN typeAnalysisSession__finalize_destructure_assignment_target_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: DestructuringAssignment, MUTABLE target: DestructureTarget, value_type: Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE scope = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
    IF !({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_396 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
    TRY (ownershipGraph__can_write?(rtoc_local_receiver_396, target.name)) }) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ DestructuringAssignment: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :ASSIGN_WHILE_BORROWED }, [], CAST({:name: target.name} AS {String@symbol}Any)));
    END
    IF scope__is_immutable?(scope, target.name) THEN
      MUTABLE fix: ?Fix@multiowned = TRY (typeAnalysisSession__build_declare_mutable_fix(&rtoc_self_view, target.name, scope));
      IF fix EXISTS AS fix_value THEN
        TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ DestructuringAssignment: COPY node } }, :ownership, [fix_value], NIL, :ASSIGN_VAR_IMMUTABLE, :error, FALSE, CAST({:name: target.name} AS {String@symbol}Any)));
      ELSE
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ DestructuringAssignment: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :ASSIGN_VAR_IMMUTABLE }, [], CAST({:name: target.name} AS {String@symbol}Any)));
      END
    END
    IF target.type EXISTS AS MUTABLE type_value THEN
      TRY (typeAnalysisSession__validate_type_annotation_mut(&rtoc_self_view, AnnotationNode{ DestructureTarget: COPY target }, &type_value));
    END
    MUTABLE target_type = TRY (scope__resolve_type(scope, target.name));
    TRY (typeAnalysisSession__validate_destructure_target_type_mut(&rtoc_self_view, &node, TypeTypeInput{ Type: COPY target_type }, value_type));
    MUTABLE rtoc_target_loc = Locatable{ DestructureTarget: COPY target };
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, &rtoc_target_loc, target_type));
    target.symbol = scope__entry_for_write(&scope, target.name);
    TRY (typeAnalysisSession__mark_var_mutated(&rtoc_self_view, target.name));
    typeAnalysisSession__og_set_live(&rtoc_self_view, target.name);
}
END
PRIVATE FN typeAnalysisSession__validate_destructure_target_type_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: DestructuringAssignment, target_type: TypeTypeInput, value_type: Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF ((FALSE OR ruby_union_scalar_equal_TypeTypeInput_String_symbol__type_analysis_session(target_type, :Any)) OR (type__resolved(value_type) == :Any)) THEN
      RETURN;
    END
    IF ruby_union_scalar_equal_TypeTypeInput_String_symbol__type_analysis_session(target_type, symbol("NIL")) THEN
      RETURN;
    END
    IF TRY (type__accepts?((TRY (type__new(castTypeTypeInputToTypeConstructionInput__type_analysis_session(target_type)))), value_type)) THEN
      RETURN;
    END
    TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ DestructuringAssignment: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :TYPE_MISMATCH_ASSIGN }, [], CAST({:got: type__resolved(value_type), :expected: target_type} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__visit_GetIndex(MUTABLE self: TypeAnalysisSession, MUTABLE node: GetIndex) RETURNS !?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE root: ?Identifier = NIL;
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.target));
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.index));
    MUTABLE target_type_info = TRY (aST__full_type_mut(node.target));
    MUTABLE implicit_safe_nav = ((type__optional?(target_type_info) AND (locatable__safe_nav_chain(node.target) != NIL)) AND (locatable__safe_nav_chain(node.target) == TRUE));
    IF implicit_safe_nav THEN
      target_type_info = UNWRAP (TRY (type__wrapped_type( target_type_info)));
    END
    IF TRY (type__c_array_view?( target_type_info)) THEN
      root = aST__root_identifier(node.target);
      IF (root != NIL) THEN
        TRY (typeAnalysisSession__emit_foreign_index_needs_unsafe_view_mut(&rtoc_self_view, &node, identifier__name(root)));
      ELSE
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ GetIndex: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :FOREIGN_POINTER_DIRECT_INDEX }, [], CAST({:name: "foreign pointer"} AS {String@symbol}Any)));
      END
    END
    IF (type__future?( target_type_info) AND type__observable?( target_type_info)) THEN
      root = aST__root_identifier(node.target);
      IF (root != NIL) THEN
        TRY (typeAnalysisSession__emit_direct_view_access_finding_mut(&rtoc_self_view, Locatable{ GetIndex: COPY node }, identifier__name(root), "VIEW"));
      ELSE
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ GetIndex: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :DIRECT_VIEW_ACCESS_REQUIRES_WITH }, [], CAST({:name: "observable", :permission: "VIEW"} AS {String@symbol}Any)));
      END
    END
    IF type__rank?( target_type_info) THEN
      MUTABLE indices: []Locatable = List[];
      IF node.index IS_A TupleLit THEN
        indices = (locatable__items(node.index) OR_ELSE List[]);
      ELSE
        indices = [node.index];
      END
      IF (indices.length() != TRY (type__rank( target_type_info))) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ GetIndex: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :RANK_INDEX_ARITY }, [], CAST({:expected: TRY (type__rank( target_type_info)), :got: indices.length()} AS {String@symbol}Any)));
      END
      FOR _ IN indices DO
    MUTABLE rtoc_mutable_block_param_397 = COPY _;
    MUTABLE index_type = TRY (aST__full_type_mut(rtoc_mutable_block_param_397));
    IF !(type__integer?(index_type)) THEN
          TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY rtoc_mutable_block_param_397 }, TypeAnalysisCodeOrMessage{ SymbolValue: :RANK_INDEX_INTEGER }, [], CAST({:got: type__resolved(index_type)} AS {String@symbol}Any)));
    END
      END
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ GetIndex: COPY node }, TRY (type__element_type( target_type_info))));
      node.container_borrow = TRUE;
      RETURN NIL;
    END
    IF type__tuple?( target_type_info) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ GetIndex: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :TUPLE_INDEX_SYNTAX }));
    END
    IF TRY (typeAnalysisSession__map_requires_protocol_lowering?(&rtoc_self_view, target_type_info)) THEN
      TRY (typeAnalysisSession__require_generic_map_access_scope_mut(&rtoc_self_view, node.target, target_type_info));
      MUTABLE key_type = TRY (typeAnalysisSession__protocol_map_associated_type(&rtoc_self_view, target_type_info, :Key));
      MUTABLE index_type = TRY (aST__full_type_mut(node.index));
      IF !(TRY (type__accepts?(key_type, index_type))) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ GetIndex: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_MAP_KEY_MISMATCH }, [], CAST({:expected: TRY (type__surface_name(TypeTypeInput{ Type: COPY key_type })), :actual: TRY (type__surface_name(TypeTypeInput{ Type: COPY index_type }))} AS {String@symbol}Any)));
      END
      MUTABLE value_type = TRY (typeAnalysisSession__protocol_map_associated_type(&rtoc_self_view, target_type_info, :Value));
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ GetIndex: COPY node }, TRY (type__optional_of(TypeTypeInput{ Type: COPY value_type }))));
      node.protocol_operation = :map_get;
      node.container_borrow = TRUE;
      RETURN NIL;
    END
    MUTABLE op: ?FunctionSignature@multiowned = TRY (typeAnalysisSession__resolve_index_op(&rtoc_self_view, target_type_info, :get));
    IF op EXISTS AS op_value THEN
      MUTABLE op_value_mutable = COPY op_value;
      MUTABLE rtoc_return_def = UNWRAP (op_value_mutable.facts.return_def);
      MUTABLE result_type = TRY (functionReturn__resolve(rtoc_return_def, target_type_info, ( { MUTABLE rtoc_empty_list_398: []Locatable = List[]; rtoc_empty_list_398 } )));
      MUTABLE navigation = ((node.target IS_A OptionalUnwrap AND (locatable__safe_navigation?(node.target) OR_ELSE FALSE)) OR implicit_safe_nav);
      IF (_ AND !(type__optional?(result_type))) THEN
        result_type = TRY (type__optional_of(TypeTypeInput{ Type: COPY result_type }));
        node.safe_nav_chain = TRUE;
      END
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ GetIndex: COPY node }, result_type));
      IF op_value_mutable[:container_borrow] THEN
        node.container_borrow = TRUE;
      END
      IF type__map( target_type_info) THEN
        MUTABLE index_type_info = TRY (aST__full_type_mut(node.index));
        MUTABLE expected_key_type = TRY (type__key_type( UNWRAP (target_type_info)));
        IF !((index_type_info AND TRY (type__accepts_map_key?( UNWRAP (target_type_info), index_type_info)))) THEN
          TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ GetIndex: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_MAP_KEY_MISMATCH }, [], CAST({:expected: TRY (type__surface_name(expected_key_type)), :actual: IF index_type_info THEN
            TRY (type__surface_name(index_type_info))
          ELSE
            node.index.resolved_type
          END} AS {String@symbol}Any)));
        END
      END
    ELSE
    IF type__promise_list?(target_type_info) THEN
        MUTABLE elem_t: ?Type = TRY (type__element_type((TRY (type__tense_type( target_type_info)))));
        TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ GetIndex: COPY node }, TRY (type__optional_of(castTypeToTypeTypeInput__type_analysis_session(TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("~${type__resolved(UNWRAP (elem_t))}") })))))));
    ELSE_IF (TRY (type__string?( target_type_info)) AND !(type__raw?( target_type_info))) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ GetIndex: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :STRING_INDEX_BY_INT }));
    ELSE_IF ((aST__metatype(node.target) == :struct) AND TRY (type__element_type( target_type_info))) THEN
        TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ GetIndex: COPY node }, TRY (type__element_type( target_type_info))));
        node.container_borrow = TRUE;
    ELSE
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ GetIndex: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :UNSUPPORTED_INDEX }));
    END
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__visit_GetField(MUTABLE self: TypeAnalysisSession, MUTABLE node: GetField) RETURNS !?TypeAnalysisSessionReturnValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE navigation = NIL;
    IF TRY (typeAnalysisSession__resolve_variant_access(&rtoc_self_view, &node)) THEN
      RETURN NIL;
    END
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.target));
    TRY (typeAnalysisSession__emit_moved_field_path_error_if_needed_mut(&rtoc_self_view, &node));
    MUTABLE target_type = TRY (aST__full_type_mut(node.target));
    IF (type__future?(target_type) AND type__observable?(target_type)) THEN
      MUTABLE root: ?Identifier = aST__root_identifier(node.target);
      IF (root != NIL) THEN
        TRY (typeAnalysisSession__emit_direct_view_access_finding_mut(&rtoc_self_view, Locatable{ GetField: COPY node }, identifier__name(root), "VIEW"));
      ELSE
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ GetField: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :DIRECT_VIEW_ACCESS_REQUIRES_WITH }, [], CAST({:name: "observable", :permission: "VIEW"} AS {String@symbol}Any)));
      END
    END
    MUTABLE implicit_safe_nav = ((type__optional?(target_type) AND (locatable__safe_nav_chain(node.target) != NIL)) AND (locatable__safe_nav_chain(node.target) == TRUE));
    IF ((type__optional?(target_type) AND !(node.target IS_A OptionalUnwrap)) AND !(implicit_safe_nav)) THEN
      TRY (typeAnalysisSession__emit_optional_field_safe_nav_finding_mut(&rtoc_self_view, node, target_type));
      target_type = UNWRAP (TRY (type__wrapped_type( target_type)));
    END
    IF implicit_safe_nav THEN
      target_type = UNWRAP (TRY (type__wrapped_type( target_type)));
    END
    MUTABLE type = type__resolved(target_type);
    MUTABLE match: ?CompilerRegexScanner = compilerRegexMatchData(CAST(node.field AS String), (compilerRegexCompile("\\A_(\\d+)\\z")));
    IF (type__tuple?( target_type) AND (match)) THEN
      MUTABLE position = TRY (compilerRegexCapture(match, 1).toInt());
      MUTABLE position_type: ?Type = TRY (type__fixed_position_type( target_type, position));
      IF (position_type == NIL) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ GetField: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :FIXED_POSITION_OUT_OF_BOUNDS }, [], CAST({:index: position, :count: TRY (type__fixed_position_count( target_type)), :type: TRY (type__surface_name( TypeTypeInput{ Type: COPY target_type }))} AS {String@symbol}Any)));
      END
      MUTABLE field_type = position_type;
      IF node.target IS_A TenseNavigation THEN
        field_type = TRY (typeAnalysisSession__publish_tense_navigation_plan_mut(&rtoc_self_view, Locatable{ GetField: COPY node }, castLocatableToTenseNavigation__type_analysis_session(node.target), CAST(field_type AS Type)));
        IF locatable__safe_navigation?(node.target) THEN
          node.safe_nav_chain = TRUE;
        END
      END
      navigation = ((node.target IS_A OptionalUnwrap AND (locatable__safe_navigation?(node.target) OR_ELSE FALSE)) OR implicit_safe_nav);
      IF (navigation AND !(type__optional?(field_type))) THEN
        field_type = TRY (type__optional_of(TypeTypeInput{ Type: COPY field_type }));
      END
      node.tuple_position = position;
      IF implicit_safe_nav THEN
        node.safe_nav_chain = TRUE;
      END
      node.container_borrow = TRUE;
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ GetField: COPY node }, field_type));
      RETURN NIL;
    END
    IF getField__wildcard?(node) THEN
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ GetField: COPY node }, :Void));
      RETURN NIL;
    END
    TRY (typeAnalysisSession__emit_capability_field_access_error_if_needed_mut(&rtoc_self_view, &node));
    MUTABLE raw_schema: ?SchemaValue = TRY (typeAnalysisSession__lookup_type_schema(&rtoc_self_view, type));
    IF schemas__enum?(raw_schema) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ GetField: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :ENUM_FIELD_ACCESS }, [], CAST({:enum: type} AS {String@symbol}Any)));
      RETURN NIL;
    END
    IF (raw_schema IS_A UnionSchema OR (schemas__union?(raw_schema))) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ GetField: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :UNION_FIELD_ACCESS }, [], CAST({:union: type} AS {String@symbol}Any)));
      RETURN NIL;
    END
    IF !(schemas__field_bearing?(raw_schema)) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ GetField: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :ILLEGAL_FIELD_LOOKUP }, [], CAST({:field: node.field, :type: type} AS {String@symbol}Any)));
      RETURN NIL;
    END
    MUTABLE struct_schema: Any@multiowned = CAST(raw_schema AS Any@multiowned);
    MUTABLE field_def = struct_schemaValue__fields(UNWRAP (schema))[node.field];
    IF !(field_def) THEN
      IF node.token THEN
        MUTABLE valid_fields = struct_schemaValue__fields(UNWRAP (schema)).keys() |> WHERE !((_ IS_A String@symbol OR (CAST(_ AS String)).startsWith?("_")));
        TRY (typeAnalysisSession__emit_typo_suggestion_mut(&rtoc_self_view, TypoToken{ TokenMultiowned: COPY node.token }, node.field, valid_fields, "Struct '${type}' has no field '${node.field}'", "field of ${type}", :type, TRUE));
      ELSE
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ GetField: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :ILLEGAL_FIELD_LOOKUP }, [], CAST({:field: node.field, :type: type} AS {String@symbol}Any)));
      END
      RETURN NIL;
    END
    MUTABLE field_type = field_def.type();
    IF (((typeAnalysisSession__phase_traversal_state(&rtoc_self_view).pipeline_accessed_fields != NIL) AND node.target IS_A Identifier) AND (locatable__name(node.target) == "_")) THEN
      ((typeAnalysisSession__phase_traversal_state(&rtoc_self_view).pipeline_accessed_fields)?).insert(node.field);
    END
    MUTABLE type_obj = TRY (type__new(TypeConstructionInput{ SymbolValue: COPY type }));
    IF (type__generic_instance?(type_obj) AND type__any?(struct_schema.type_params())) THEN
      MUTABLE subst = {};
      (struct_schema.type_params().zip(TRY (type__generic_args(type_obj)))).keys() |> EACH {
    MUTABLE arg = ((struct_schema.type_params().zip(TRY (type__generic_args(type_obj))))[_] OR_ELSE panic("missing hash key"));
    IF !(arg) THEN
      CONTINUE;
    END
    subst[_] = arg.resolved();
      };
      field_type = TRY (typeAnalysisSession__apply_type_subst(&rtoc_self_view, TypeTypeInput{ Type: COPY field_type }, subst));
    END
    IF type__indirect?(field_type) THEN
      MUTABLE psch = TRY (typeAnalysisSession__lookup_type_schema(&rtoc_self_view, type__resolved(field_type)));
      MUTABLE struct_pointee = schemas__struct?(psch);
      IF !(struct_pointee) THEN
        node.indirect_field = TRUE;
