PRIVATE FN typeAnalysisSession__find_matching_intrinsic(MUTABLE self: TypeAnalysisSession, definitions: []FunctionSignature, args: []Locatable) RETURNS !?FunctionSignature@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE matched: ?FunctionSignature@multiowned = NIL;
    MUTABLE matched_score: Int64 = -1;
    MUTABLE varargs_fallback: ?FunctionSignature@multiowned = NIL;
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < definitions.length() DO
      IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_101 = definitions[rtoc_idx]?;
      functionSignature__intrinsic_varargs?(rtoc_local_receiver_101) } THEN
          varargs_fallback = (varargs_fallback OR_ELSE definitions[rtoc_idx]?);
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE specs = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_102 = definitions[rtoc_idx]?;
      TRY (functionSignature__intrinsic_arg_specs(rtoc_local_receiver_102)) };
      IF (args.length() != specs.length()) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE all_match = {
        MUTABLE rtoc_value_block_marker = 0;
        MUTABLE rtoc_indexed_items_103: []Locatable = args;
        MUTABLE rtoc_indexed_output_105 = TRUE;
        MUTABLE rtoc_indexed_i_104 = 0;
        WHILE rtoc_indexed_i_104 < rtoc_indexed_items_103.length() AND rtoc_indexed_output_105 DO
          rtoc_indexed_output_105 = TRY (typeAnalysisSession__intrinsic_arg_matches?(&rtoc_self_view, UNWRAP (specs[rtoc_indexed_i_104]), UNWRAP (rtoc_indexed_items_103[rtoc_indexed_i_104])));
          rtoc_indexed_i_104 = rtoc_indexed_i_104 + 1;
        END
        rtoc_indexed_output_105
      };
      IF !(all_match) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE score = {
        MUTABLE rtoc_value_block_marker = 0;
        MUTABLE rtoc_indexed_items_106: []Locatable = args;
        MUTABLE rtoc_indexed_output_108 = 0;
        MUTABLE rtoc_indexed_i_107 = 0;
        WHILE rtoc_indexed_i_107 < rtoc_indexed_items_106.length() DO
          IF {
        MUTABLE spec = COPY UNWRAP (specs[rtoc_indexed_i_107]);
        (!(intrinsicArgSpec__unconstrained_any?(spec)) AND (locatable__resolved_type(UNWRAP (rtoc_indexed_items_106[rtoc_indexed_i_107])) == spec.type))
      } THEN
            rtoc_indexed_output_108 = rtoc_indexed_output_108 + 1;
          END
          rtoc_indexed_i_107 = rtoc_indexed_i_107 + 1;
        END
        rtoc_indexed_output_108
      };
      IF !((score > matched_score)) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      matched = COPY definitions[rtoc_idx]?;
      matched_score = score;
    rtoc_idx = rtoc_idx + 1;
    END
    IF matched != NIL THEN
    RETURN matched;
    ELSE
    RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__intrinsic_arg_matches?(MUTABLE self: TypeAnalysisSession, spec: IntrinsicArgSpec, MUTABLE arg: Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF intrinsicArgSpec__unconstrained_any?(spec) THEN
      RETURN TRUE;
    END
    IF ((spec.type == symbol("Any[]")) AND TRY (typeAnalysisSession__any_array_intrinsic_arg?(&rtoc_self_view, spec.type, &arg))) THEN
      RETURN TRUE;
    END
    MUTABLE cast_source: ?String@symbol = locatable__resolved_type(arg);
    IF (CAST(cast_source AS String)).contains?("[") THEN
      MUTABLE full = TRY (aST__full_type_mut(arg));
      IF type__array?(full) THEN
        cast_source = COPY type__resolved(full);
      END
    END
    IF !(((spec.type == :Any) OR TRY (typeAnalysisSession__is_safe_autocast?(rtoc_self_view, SourceType{ SymbolValue: COPY UNWRAP (cast_source) }, TypeTypeInput{ SymbolValue: COPY spec.type })))) THEN
      RETURN FALSE;
    END
    IF !(intrinsicArgSpec__capability_constrained?(spec)) THEN
      RETURN TRUE;
    END
    MUTABLE arg_type = TRY (aST__full_type_mut(arg));
    IF ((TRUE) AND ((IF (TRUE) THEN
      type__sync(arg_type)
    ELSE
      NIL
    END) != (spec.sync)?)) THEN
      RETURN FALSE;
    END
    IF ((TRUE) AND ((IF (TRUE) THEN
      type__ownership(arg_type)
    ELSE
      NIL
    END) != (spec.ownership)?)) THEN
      RETURN FALSE;
    END
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__any_array_intrinsic_arg?(MUTABLE self: TypeAnalysisSession, spec: String@symbol, MUTABLE arg: Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !((spec == symbol("Any[]"))) THEN
      RETURN FALSE;
    END
    MUTABLE type = TRY (aST__full_type_mut(arg));
    IF type__array?(type) THEN
      RETURN TRUE;
    END
    IF !(type__future?(type)) THEN
      RETURN FALSE;
    END
    RETURN ((((TRY (type__dynamic_stream?(type)) OR type__promise_list?(type)) OR type__bounded_stream?(type)) OR TRY (type__open_stream?(type))) OR type__inf_stream?(type));
}
END
PRIVATE FN typeAnalysisSession__visit_Smooth(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__with_smooth_context(&rtoc_self_view, %() USE(MUTABLE node, MUTABLE rtoc_self_view) -> {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.left));
    MUTABLE source_type = TRY (aST__full_type_mut(node.left));
    IF type__catch_snapshot_payload?(source_type) THEN
        TRY (typeAnalysisSession__record_body_fact_pipe_input_type_mut(&rtoc_self_view, CAST(type__resolved(source_type) AS String)));
    END
    IF typeAnalysisSession__pipe_complex_op?(&rtoc_self_view, node.right) THEN
        TRY (typeAnalysisSession__analyze_higher_order_op(&rtoc_self_view, &node));
    ELSE_IF node.right IS_A FuncCall THEN
        TRY (typeAnalysisSession__analyze_pipe_to_func_call(&rtoc_self_view, &node));
    ELSE_IF node.right IS_A Identifier THEN
        TRY (typeAnalysisSession__analyze_pipe_to_identifier(&rtoc_self_view, &node));
    ELSE
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ BinaryOp: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :PIPE_BAD_DESTINATION }));
        TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY node }, :Any));
    END
    MUTABLE result_ti: ?Type = TRY (type__from_node_mut(Locatable{ BinaryOp: COPY node }, "pipeline effect recording"));
    IF !(TRY (type__inf_stream?( UNWRAP (result_ti)))) THEN
        IF typeAnalysisSession__current_fn_ctx(&rtoc_self_view) != NIL THEN
              MUTABLE rtoc_mutable_receiver_109: FunctionContext@multiowned = UNWRAP ((typeAnalysisSession__current_fn_ctx(&rtoc_self_view)));
              functionContext__record_frame_use_mut(&rtoc_mutable_receiver_109);
        END
        IF ((locatable__storage(Locatable{ BinaryOp: COPY node }) == :heap) OR type__heap?( UNWRAP (result_ti))) THEN
          IF typeAnalysisSession__current_fn_ctx(&rtoc_self_view) != NIL THEN
                  MUTABLE rtoc_mutable_receiver_110: ?FunctionContext = (typeAnalysisSession__current_fn_ctx(&rtoc_self_view));
                  MUTABLE rtoc_heap_ctx = UNWRAP (rtoc_mutable_receiver_110); functionContext__record_heap_use_mut(&rtoc_heap_ctx);
          END
          IF typeAnalysisSession__current_fn_ctx(&rtoc_self_view) != NIL THEN
                  MUTABLE rtoc_mutable_receiver_111: ?FunctionContext = (typeAnalysisSession__current_fn_ctx(&rtoc_self_view));
                  MUTABLE rtoc_alloc_ctx = UNWRAP (rtoc_mutable_receiver_111); functionContext__record_alloc_use_mut(&rtoc_alloc_ctx);
          END
        END
    END
    NIL
    });
    RETURN typeAnalysisSession__smooth_depth(&rtoc_self_view);
}
END
PRIVATE FN typeAnalysisSession__select_element_forces_heap_result?(MUTABLE self: TypeAnalysisSession, expr: Locatable) RETURNS !Bool
