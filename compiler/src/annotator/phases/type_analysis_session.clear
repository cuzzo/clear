PRIVATE FN typeAnalysisSession__record_body_fact_with_block_mut(self: TypeAnalysisSession, node: WithBlock) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE frame: ?BodyFactFrame = COPY typeAnalysisSession__body_fact_frames(rtoc_self_view).last();
    IF frame EXISTS AS frame_value THEN
      MUTABLE suspends = typeAnalysisSession__with_block_suspends?(rtoc_self_view, node);
      MUTABLE summary = COPY frame_value.summary;
      &summary.with_blocks.append(node);
      summary.with_scope_nodes[aST__node_identity(node)] = (summary.with_scope_nodes[aST__node_identity(node)] OR_ELSE List[]);
      IF suspends THEN
        &summary.suspend_points.append(COPY SuspendPointFact{ id: COPY SuspendPointId{ value: summary.suspend_points.length() }, kind: :lock, node: Locatable{ WithBlock: COPY node } });
      END
    ELSE
      RETURN;
    END
}
END
