          comptime_type_args = ( { MUTABLE rtoc_empty_list_67: []Any = List[]; rtoc_empty_list_67 } );
          MUTABLE params = TRY (functionSignature__params(signature));
          MUTABLE rtoc_idx = 0;
          WHILE rtoc_idx < params.length() DO
      MUTABLE arg: ?Locatable = COPY args[rtoc_idx];
