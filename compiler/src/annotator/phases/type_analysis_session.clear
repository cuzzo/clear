PUB FN typeAnalysisSession__semantic_conformance_resolutions(self: TypeAnalysisSession) RETURNS ![]ConformanceResolution
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY rtoc_self_view.resolution.conformance_resolutions;
}
END
PUB FN typeAnalysisSession__semantic_held_lock_types(self: TypeAnalysisSession) RETURNS ![]HeldLockTypeEntry
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (typeAnalysisSession__current_held_lock_types(rtoc_self_view));
}
END
PUB FN typeAnalysisSession__pending_deferred_validation_count(self: TypeAnalysisSession) RETURNS Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN rtoc_self_view.audit_inputs.deferred_with_validations.length();
}
END
PUB FN typeAnalysisSession__deferred_with_validations(self: TypeAnalysisSession) RETURNS ![]DeferredWithValidation
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY rtoc_self_view.audit_inputs.deferred_with_validations;
}
END
