UNION TypeAnalysisCallNode { FuncCall: FuncCall, MethodCall: MethodCall }
PUB FN typeAnalysisCallNode__name(self: TypeAnalysisCallNode) RETURNS String ->
  PARTIAL MATCH self START
    TypeAnalysisCallNode.FuncCall AS item -> RETURN COPY callName__string_value(item.name);,
    TypeAnalysisCallNode.MethodCall AS item -> RETURN COPY item.name;
  END
  RETURN "";
END
