PRIVATE FN typeAnalysisSession__typo_anchor(self: TypeAnalysisSession, token: ?Token) RETURNS AnchorToken
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF token EXISTS AS token_value THEN
      RETURN AnchorToken{ line: token_value.line, column: token_value.column };
    ELSE
      RETURN AnchorToken{ line: 0, column: 0 };
    END
}
END
PRIVATE FN typeAnalysisSession__suggestion_levenshtein(self: TypeAnalysisSession, left: String, right: String) RETURNS !Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (left.length() == 0) THEN
      RETURN right.codepointCount();
    END
    IF (right.length() == 0) THEN
      RETURN left.codepointCount();
    END
    MUTABLE previous = TRY (effectSet__to_a((0 ..= right.codepointCount())));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < left.length() DO
      MUTABLE current = [(rtoc_idx + 1)];
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < right.length() DO
          MUTABLE cost = IF (left.substr(rtoc_idx, 1) == right.substr(rtoc_idx, 1)) THEN
              0
            ELSE
              1
            END;
          &current.append(([(UNWRAP (current[rtoc_idx]) + 1), (previous[(rtoc_idx + 1)] + 1), (previous[rtoc_idx] + cost)]).min());
        rtoc_idx = rtoc_idx + 1;
      END
      previous = current;
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN previous.last();
}
END
PRIVATE FN typeAnalysisSession__emit_optional_field_safe_nav_finding_mut(self: TypeAnalysisSession, node: GetField, target_type: Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE token = COPY node.token;
    MUTABLE fix = TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :INSERT_SAFE_NAVIGATION), [edit__new(span__new(NIL, token.line, (token.column - 1), 0), "?")], :auto));
    typeAnalysisSession__fixable_mut(rtoc_self_view, node, :type, [fix], NIL, :OPTIONAL_FIELD_REQUIRES_SAFE_NAV, :error, FALSE, {:field: node.field, :type: TRY (type__surface_name(castTypeToTypeTypeInput(target_type))), :target: node.target.name()});
}
END
PRIVATE FN typeAnalysisSession__emit_mutable_unused_finding_mut(self: TypeAnalysisSession, reg: ?TypeAnalysisReg, name: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF reg EXISTS AS reg_value THEN
      MUTABLE tok_branch_value: ?Token = NIL;
      IF reg_value IS_A VarDecl AS var_decl THEN
        tok_branch_value = varDecl__token(var_decl);
      ELSE
        tok_branch_value = (MATCH reg_value START TypeAnalysisReg.VarDecl AS item -> item.token, TypeAnalysisReg.DestructureTarget AS item -> item.token END);
      END
      MUTABLE tok: Token = tok_branch_value?;
      MUTABLE fixes = List[];
      IF (tok.value == "MUTABLE") THEN
        &fixes.append(TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :REMOVE_MUTABLE_UNUSED), [edit__new(span__new(NIL, tok.line, tok.column, "MUTABLE ".codepointCount()), "")], :auto)));
      END
      typeAnalysisSession__fixable_mut(rtoc_self_view, reg_value, :lint, fixes, NIL, :MUTABLE_UNUSED, :warning, FALSE, {:name: name});
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__closest_name(self: TypeAnalysisSession, input: NameCandidate, candidates: []NameCandidate, max_distance: Int64 = 3) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE best: ?NameCandidate = NIL;
    MUTABLE best_d: Int64 = (max_distance + 1);
    FOR _ IN candidates DO
    MUTABLE d = typeAnalysisSession__levenshtein(rtoc_self_view, CAST(input AS String), CAST(_ AS String));
    IF (d < best_d) THEN
        best = COPY _;
        best_d = d;
    END
    END
    IF (best_d <= max_distance) THEN
      RETURN COPY CAST(best AS String);
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__levenshtein(self: TypeAnalysisSession, a: String, b: String) RETURNS !Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (a.length() == 0) THEN
      RETURN b.codepointCount();
    END
    IF (b.length() == 0) THEN
      RETURN a.codepointCount();
    END
    MUTABLE prev = TRY (effectSet__to_a((0 ..= b.codepointCount())));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < a.length() DO
      MUTABLE curr = [(rtoc_idx + 1)];
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < b.length() DO
          MUTABLE cost = IF (a.substr(rtoc_idx, 1) == b.substr(rtoc_idx, 1)) THEN
              0
            ELSE
              1
            END;
          &curr.append(([(UNWRAP (curr[rtoc_idx]) + 1), (prev[(rtoc_idx + 1)] + 1), (prev[rtoc_idx] + cost)]).min());
        rtoc_idx = rtoc_idx + 1;
      END
      prev = curr;
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN prev.last();
}
END
PRIVATE FN typeAnalysisSession__emit_registry_mismatch_mut(self: TypeAnalysisSession, token: Token, name: NameCandidate, candidates: []NameCandidate, message: String, fix_label: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE best: ?String =   IF ((fix_label == "closest in-scope variable") AND compilerRegexMatch((CAST(name AS String)), compilerRegexCompile("\\A[A-Z]"))) THEN
      NIL
    ELSE
      typeAnalysisSession__closest_name(rtoc_self_view, name, candidates)
    END;
    MUTABLE fixes = List[];
    IF best EXISTS AS best_value THEN
      &fixes.append(TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :REPLACE_IDENTIFIER_WITH_CANDIDATE, {:name: castNameCandidateToOptionalDiagnosticKwValue(name), :best: DiagnosticKwValue{ StringValue: COPY best_value }, :label: DiagnosticKwValue{ StringValue: COPY fix_label }}), [edit__new(span__new(NIL, token.line, token.column, (CAST(name AS String)).codepointCount()), best_value)], :auto)));
    END
    IF (fixes.length() == 0) THEN
      RETURN typeAnalysisSession__error_mut(rtoc_self_view, token, TypeAnalysisCodeOrMessage{ SymbolValue: :REGISTRY_MISMATCH_REJECTED }, [], {:detail: message});
    END
    typeAnalysisSession__fixable_mut(rtoc_self_view, token, :registry, fixes, NIL, :REGISTRY_MISMATCH_REJECTED, :error, FALSE, {:detail: message});
}
END
PRIVATE FN typeAnalysisSession__emit_typo_suggestion_mut(self: TypeAnalysisSession, token: ?TypoToken, name: String, candidates: []String, message: String, fix_label: String, category: String@symbol = :registry, cascade: Bool = TRUE) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE token_line: Int64 = CAST((MATCH token START TypoToken.TokenMultiowned AS item -> item.line, TypoToken.AnchorToken AS item -> item.line END) AS Int64);
    MUTABLE token_column: Int64 = CAST((MATCH token START TypoToken.TokenMultiowned AS item -> item.column, TypoToken.AnchorToken AS item -> item.column END) AS Int64);
    MUTABLE best: ?String =   IF ((fix_label == "closest in-scope variable") AND compilerRegexMatch(name, compilerRegexCompile("\\A[A-Z]"))) THEN
      NIL
    ELSE
      typeAnalysisSession__closest_name(rtoc_self_view, NameCandidate{ StringValue: COPY name }, candidates)
    END;
    MUTABLE fixes = List[];
    IF best EXISTS AS best_value THEN
      &fixes.append(TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :REPLACE_IDENTIFIER_WITH_CANDIDATE, {:name: DiagnosticKwValue{ StringValue: COPY name }, :best: DiagnosticKwValue{ StringValue: COPY best_value }, :label: DiagnosticKwValue{ StringValue: COPY fix_label }}), [edit__new(span__new(NIL, token_line, token_column, name.codepointCount()), best_value)], :auto)));
    END
    IF (fixes.length() == 0) THEN
      RETURN typeAnalysisSession__error_mut(rtoc_self_view, token, TypeAnalysisCodeOrMessage{ SymbolValue: :TYPO_SUGGESTION_REJECTED }, [], {:detail: message});
    END
    typeAnalysisSession__fixable_mut(rtoc_self_view, token, category, fixes, NIL, :TYPO_SUGGESTION_REJECTED, :error, cascade, {:detail: message});
}
END
PRIVATE FN typeAnalysisSession__anchor_at(self: TypeAnalysisSession, line: Int64, col: Int64) RETURNS AnchorToken
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN AnchorToken{ line: COPY line, column: COPY col };
}
END
PRIVATE FN typeAnalysisSession__variant_anchor_from_getfield(self: TypeAnalysisSession, getfield_node: GetField) RETURNS ?AnchorToken
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE tgt = COPY getfield_node.target;
    IF !(tgt.token()) THEN
      RETURN NIL;
    END
    RETURN typeAnalysisSession__anchor_at(rtoc_self_view, tgt.token().line(), ((tgt.token().column() + (CAST(tgt.name() AS String)).codepointCount()) + 1));
}
END
PRIVATE FN typeAnalysisSession__variant_anchor_from_unionlit(self: TypeAnalysisSession, node: Node, variant_name: String) RETURNS ?AnchorToken
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(aST__node__token(node)) THEN
      RETURN NIL;
    END
    RETURN typeAnalysisSession__anchor_at(rtoc_self_view, aST__node__token(node).line(), (aST__node__token(node).column() - variant_name.codepointCount()));
}
END
PRIVATE FN typeAnalysisSession__emit_variant_typo_mut(self: TypeAnalysisSession, anchor: AnchorToken, name: String, candidates: []NameCandidate, message: String, fix_label: String, cascade: Bool = FALSE) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE best: ?String = typeAnalysisSession__closest_name(rtoc_self_view, NameCandidate{ StringValue: COPY name }, candidates);
    MUTABLE fixes = List[];
    IF best EXISTS AS best_value THEN
      &fixes.append(TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :REPLACE_IDENTIFIER_WITH_CANDIDATE, {:name: DiagnosticKwValue{ StringValue: COPY name }, :best: DiagnosticKwValue{ StringValue: COPY best_value }, :label: DiagnosticKwValue{ StringValue: COPY fix_label }}), [edit__new(span__new(NIL, anchor.line, anchor.column, name.codepointCount()), best_value)], :auto)));
    END
    IF (fixes.length() == 0) THEN
      RETURN typeAnalysisSession__error_mut(rtoc_self_view, anchor, TypeAnalysisCodeOrMessage{ SymbolValue: :TYPO_SUGGESTION_REJECTED }, [], {:detail: message});
    END
    typeAnalysisSession__fixable_mut(rtoc_self_view, anchor, :type, fixes, NIL, :TYPO_SUGGESTION_REJECTED, :error, cascade, {:detail: message});
}
END
PRIVATE FN typeAnalysisSession__emit_use_of_moved_error_mut(self: TypeAnalysisSession, use_node: Identifier, og_node: OwnershipNode) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE src: ?String = typeAnalysisSession__source_code(rtoc_self_view);
    MUTABLE name = COPY use_node.name;
    MUTABLE move_line: ?Int64 = og_node.move_line;
    MUTABLE move_col: ?Int64 = og_node.move_col;
    IF move_line EXISTS AS move_line_value THEN
      IF move_col THEN
        MUTABLE fanout_entry: ?SymbolEntry@multiowned = NIL;
        IF typeAnalysisSession__lookup_scope_for(rtoc_self_view, name) != NIL THEN
          fanout_entry = COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_35 = ((typeAnalysisSession__lookup_scope_for(rtoc_self_view, name))?);
        scope__resolve_entry(rtoc_local_receiver_35, name) };
        END
        IF (((fanout_entry != NIL) AND symbolEntry__is_param(fanout_entry)) AND (symbolEntry__carrier_contract(fanout_entry) == :polymorphic)) THEN
          RETURN typeAnalysisSession__emit_carrier_fanout_error_mut(rtoc_self_view, use_node, og_node, name, move_line_value, UNWRAP (move_col));
        END
        MUTABLE type = ownershipNode__full_type(og_node);
        MUTABLE is_shared = type__shared?(type);
        MUTABLE is_multi = type__multiowned?(type);
        MUTABLE is_split = type__split?(type);
        MUTABLE use_clone = ((is_shared OR is_multi) OR is_split);
        MUTABLE consumer_keyword: String = "";
        IF use_clone THEN
          consumer_keyword = "KEEP";
        ELSE
          consumer_keyword = "COPY";
        END
        MUTABLE consumer_description_code = IF use_clone THEN
          :WRAP_CONSUMER_WITH_KEEP
        ELSE
          :WRAP_CONSUMER_WITH_COPY
        END;
        MUTABLE replacement_col: ?Int64 = move_col;
        MUTABLE replacement_length = name.codepointCount();
        IF src EXISTS AS src_value THEN
          MUTABLE move_text = COPY (src_value.split("\n")[(move_line_value - 1)] OR_ELSE "");
          MUTABLE prefix = COPY (move_text.substr(0, (move_col - 1)));
          MUTABLE give_prefix: ?CompilerRegexScanner = compilerRegexMatchData(prefix, compilerRegexCompile("GIVE\\s+\\z"));
          IF give_prefix EXISTS AS give_prefix_value THEN
            replacement_col = (give_prefix_value.begin(0) + 1);
            replacement_length = (replacement_length + compilerRegexCapture(give_prefix_value, 0).codepointCount());
          END
        END
        MUTABLE fixes = List[];
        &fixes.append(TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, consumer_description_code, {:line: ruby_wrap_optional_Int64_DiagnosticKwValue(og_node.move_line)}), [edit__new(span__new(NIL, move_line_value, UNWRAP (replacement_col), replacement_length), "(${consumer_keyword} ${name})")], :interactive)));
        MUTABLE candidate_caps = List[];
        IF !((is_multi OR is_split)) THEN
          &candidate_caps.append("@multiowned");
        END
        IF !((is_shared OR is_split)) THEN
          &candidate_caps.append("@shared");
        END
        MUTABLE consumed_by_call = ((og_node.move_action == :takes) OR (og_node.move_action == :give));
        IF (TRUE AND consumed_by_call) THEN
          MUTABLE pt: ?TypeTypeInput = COPY og_node.move_consumer_param_type;
          IF ((pt != NIL) AND !(pt IS_A Type)) THEN
            pt = castTypeToTypeTypeInput(TRY (type__new(castTypeTypeInputToTypeConstructionInput(pt))));
          END
          MUTABLE param_admits_shared = ((pt != NIL) AND (IF respondsTo?(pt, "shared?") THEN
            type__shared?(pt)
          ELSE
            FALSE
          END));
          MUTABLE param_admits_multi = ((pt != NIL) AND (IF respondsTo?(pt, "multiowned?") THEN
            pt.multiowned?()
          ELSE
            FALSE
          END));
          IF (((pt != NIL) AND !(param_admits_shared)) AND !(param_admits_multi)) THEN
            &candidate_caps.delete("@shared");
            &candidate_caps.delete("@multiowned");
          END
        END
        MUTABLE scope: ?Scope@multiowned = typeAnalysisSession__lookup_scope_for(rtoc_self_view, name);
        MUTABLE decl: ?SymbolEntryRegInput = NIL;
        IF (IF scope != NIL THEN
          scope__resolve_entry(scope, name)
        ELSE
          NIL
        END) != NIL THEN
          decl = COPY (((IF scope != NIL THEN
          scope__resolve_entry(scope, name)
        ELSE
          NIL
        END))?).reg;
        END
        src = typeAnalysisSession__source_code(rtoc_self_view);
        IF (((decl != NIL) AND aST__node__token(decl)) AND (src != NIL)) THEN
          MUTABLE dline = aST__node__token(decl).line();
          MUTABLE line_text = (src.split("\n")[(dline - 1)] OR_ELSE "");
          MUTABLE semi_idx: ?Int64 = line_text.indexOf(";", (aST__node__token(decl).column() - 1));
          IF semi_idx EXISTS AS semi_idx_value THEN
            MUTABLE insert_col = (semi_idx_value + 1);
            FOR _ IN candidate_caps DO
    MUTABLE reason = "atomic Arc; safe across fibers";
    IF (_ == "@multiowned") THEN
                reason = "single-scheduler Rc; automatic clone on move";
    END
    &fixes.append(TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :CHANGE_BINDING_CAPABILITY_FOR_MOVE, {:name: DiagnosticKwValue{ StringValue: COPY name }, :cap: _, :reason: DiagnosticKwValue{ StringValue: COPY reason }}), [edit__new(span__new(NIL, dline, insert_col, 0), " ${_}")], :interactive)));
            END
          END
        END
        MUTABLE consumer: ?String = typeAnalysisSession__consumer_source_text(rtoc_self_view, move_line_value);
        MUTABLE phrase = typeAnalysisSession__ownership_active_phrase(rtoc_self_view, (og_node.move_action OR_ELSE :move));
        IF consumer EXISTS AS consumer_value THEN
          msg = "USE AFTER MOVE: You can't use `${name}`. `${consumer_value}` ${phrase} (line ${move_line_value.toString()}).";
        ELSE
          msg = "USE AFTER MOVE: You can't use `${name}` \u{2014} it ${phrase} (line ${move_line_value.toString()}).";
        END
        typeAnalysisSession__fixable_mut(rtoc_self_view, use_node, :ownership, fixes, NIL, :USE_OF_MOVED_VALUE, :error, TRUE, {:detail: msg});
      ELSE
        MUTABLE msg = "USE AFTER MOVE: You can't use `${name}`.";
        RETURN typeAnalysisSession__error_mut(rtoc_self_view, use_node, TypeAnalysisCodeOrMessage{ SymbolValue: :USE_OF_MOVED_VALUE }, [], {:detail: msg});
      END
    ELSE
      msg = "USE AFTER MOVE: You can't use `${name}`.";
      RETURN typeAnalysisSession__error_mut(rtoc_self_view, use_node, TypeAnalysisCodeOrMessage{ SymbolValue: :USE_OF_MOVED_VALUE }, [], {:detail: msg});
    END
}
END
PRIVATE FN typeAnalysisSession__emit_carrier_fanout_error_mut(self: TypeAnalysisSession, use_node: Identifier, og_node: OwnershipNode, name: String, move_line: Int64, move_col: Int64) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE consumer: ?String = typeAnalysisSession__consumer_source_text(rtoc_self_view, move_line);
    MUTABLE consumer_clause: String = "";
    IF consumer EXISTS AS consumer_value THEN
      consumer_clause = "`${consumer_value}` consumes it (line ${move_line.toString()})";
    ELSE
      consumer_clause = "it is consumed (line ${move_line.toString()})";
    END
    MUTABLE msg = "`${name}` is used again after ${consumer_clause}. `${name}` is a carrier-polymorphic parameter; choose how the additional owner is created: wrap the first consuming use as KEEP to preserve the caller's ownership model. If both consumers require independent identity, constrain the parameter as UNIQUE and use COPY.";
    MUTABLE fixes = [TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :WRAP_CONSUMER_WITH_KEEP, {:line: DiagnosticKwValue{ Int64Value: move_line }}), [edit__new(span__new(NIL, move_line, move_col, name.codepointCount()), "(KEEP ${name})")], :interactive))];
    typeAnalysisSession__fixable_mut(rtoc_self_view, use_node, :ownership, fixes, NIL, :CARRIER_POLYMORPHIC_FANOUT, :error, TRUE, {:detail: msg});
}
END
PRIVATE FN typeAnalysisSession__emit_use_of_moved_in_loop_error_mut(self: TypeAnalysisSession, node: Node, name: String, og_node: ?OwnershipNode = NIL, code: String@symbol = :USE_OF_MOVED_IN_LOOP) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE loop_move_line: ?Int64 = og_node?.move_line;
    MUTABLE consumer: ?String = IF loop_move_line != NIL THEN
      typeAnalysisSession__consumer_source_text(rtoc_self_view, loop_move_line)
    ELSE
      NIL
    END;
    MUTABLE consumer_clause: String = "";
    IF consumer EXISTS AS consumer_value THEN
      consumer_clause = "`${consumer_value}` already TOOK it. ";
    ELSE
      consumer_clause = "";
    END
    MUTABLE msg = "USE AFTER MOVE: You can't use `${name}` here \u{2014} ${consumer_clause}Values can only be TAKEN once; subsequent iterations have nothing left to GIVE.";
    typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: COPY code }, [], {:detail: msg});
}
END
PRIVATE FN typeAnalysisSession__emit_use_of_moved_path_error_mut(self: TypeAnalysisSession, node: GetField, path: []NameCandidate, og_node: ?OwnershipNode = NIL) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE path_str = (path |> SELECT _.toString()).join(".");
    MUTABLE root = COPY CAST(path.first() AS String);
    MUTABLE msg: String = "";
    IF ((og_node != NIL) AND (og_node.move_line != NIL)) THEN
      MUTABLE phrase = typeAnalysisSession__ownership_passive_phrase(rtoc_self_view, (og_node.move_action OR_ELSE :move));
      msg = "USE AFTER MOVE: You can't use `${path_str}`. Its owner `${root}` ${phrase} on line ${og_node.move_line}.";
    ELSE
      msg = "USE AFTER MOVE: You can't use `${path_str}`. Its owner `${root}` was already consumed elsewhere.";
    END
    typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :USE_OF_MOVED_PATH }, [], {:detail: msg});
}
END
PRIVATE FN typeAnalysisSession__ownership_active_phrase(self: TypeAnalysisSession, action: String@symbol) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (CAST({:give: "already GAVE it away", :takes: "already TOOK it away", :return: "already RETURNED it", :next: "already consumed it via NEXT", :share: "already SHARED it", :collect: "already COLLECTED it", :capture: "already captured it", :move: "already MOVED it"} AS {String@symbol}String))[action] != NIL THEN
    RETURN COPY ((CAST({:give: "already GAVE it away", :takes: "already TOOK it away", :return: "already RETURNED it", :next: "already consumed it via NEXT", :share: "already SHARED it", :collect: "already COLLECTED it", :capture: "already captured it", :move: "already MOVED it"} AS {String@symbol}String))[action])?;
    ELSE
    RETURN "already consumed it";
    END
}
END
PRIVATE FN typeAnalysisSession__ownership_passive_phrase(self: TypeAnalysisSession, action: String@symbol) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (CAST({:give: "was already GIVEN away", :takes: "was already TAKEN away", :return: "was already RETURNED", :next: "was already consumed via NEXT", :share: "was already SHARED", :collect: "was already COLLECTED", :capture: "was already captured", :move: "was already MOVED"} AS {String@symbol}String))[action] != NIL THEN
    RETURN COPY ((CAST({:give: "was already GIVEN away", :takes: "was already TAKEN away", :return: "was already RETURNED", :next: "was already consumed via NEXT", :share: "was already SHARED", :collect: "was already COLLECTED", :capture: "was already captured", :move: "was already MOVED"} AS {String@symbol}String))[action])?;
    ELSE
    RETURN "was already consumed";
    END
}
END
PRIVATE FN typeAnalysisSession__consumer_source_text(self: TypeAnalysisSession, line_num: Int64) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE src: ?String = typeAnalysisSession__source_code(rtoc_self_view);
    IF src EXISTS AS src_value THEN
      IF line_num THEN
        MUTABLE line: ?String = COPY src_value.split("\n")[(line_num - 1)];
        IF line EXISTS AS line_value THEN
          MUTABLE text = line_value.trim();
          text = text.chomp(";").trim();
          IF (text.length() == 0) THEN
            RETURN NIL;
          ELSE
            RETURN text;
          END
        ELSE
          RETURN NIL;
        END
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__smallest_fitting_int_type(self: TypeAnalysisSession, val: Int64) RETURNS ?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE order = IF (val >= 0) THEN
      unsigned_order
    ELSE
      signed_order
    END;
    MUTABLE selected: ?String@symbol = NIL;
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < order.length() DO
      IF selected THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE max: ?Int64 = (CAST({:Byte: 255, :UInt8: 255, :UInt16: 65535, :UInt32: 4294967295, :UInt64: (((2 ** 64)) - 1), :Int8: 127, :Int16: 32767, :Int32: 2147483647, :Int64: 9223372036854775807} AS {String@symbol}Int64))[order[rtoc_idx]];
      IF (max == NIL) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE min = ((CAST({:Byte: 0, :UInt8: 0, :UInt16: 0, :UInt32: 0, :UInt64: 0, :Int8: -128, :Int16: -32768, :Int32: -2147483648, :Int64: (-9223372036854775807 - 1)} AS {String@symbol}Int64))[order[rtoc_idx]] OR_ELSE 0);
      IF ((val >= min) AND (val <= max)) THEN
          selected = order[rtoc_idx];
      END
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN selected;
}
END
PRIVATE FN typeAnalysisSession__annotation_type_column(self: TypeAnalysisSession, prefix: String, target_name: String) RETURNS ?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE idx = 0;
    MUTABLE found: ?Int64 = NIL;
    WHILE (idx < prefix.codepointCount()) DO
      MUTABLE colon: ?Int64 = prefix.indexOf(":", idx);
      IF colon EXISTS AS colon_value THEN
        MUTABLE type_start = (colon_value + 1);
        WHILE ((type_start < prefix.codepointCount()) AND typeAnalysisSession__whitespace_char?(rtoc_self_view, prefix.substr(type_start, 1))) DO
          type_start = (type_start + 1);
        END
        MUTABLE type_end = (type_start + target_name.codepointCount());
        IF ((prefix.substr(type_start, target_name.codepointCount()) == target_name) AND !(typeAnalysisSession__identifier_char_at?(rtoc_self_view, prefix, type_end))) THEN
          found = (type_start + 1);
        END
        idx = (colon_value + 1);
      ELSE
        idx = prefix.codepointCount();
      END
    END
    RETURN found;
}
END
PRIVATE FN typeAnalysisSession__whitespace_char?(self: TypeAnalysisSession, ch: ?String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ((ch == " ") OR (ch == "\t"));
}
END
PRIVATE FN typeAnalysisSession__identifier_char_at?(self: TypeAnalysisSession, text: String, idx: Int64) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (idx >= text.codepointCount()) THEN
      RETURN FALSE;
    END
    MUTABLE ch = text.substr(idx, 1);
    RETURN ((((((ch >= "A") AND (ch <= "Z"))) OR (((ch >= "a") AND (ch <= "z")))) OR (((ch >= "0") AND (ch <= "9")))) OR (ch == "_"));
}
END
PRIVATE FN typeAnalysisSession__emit_int_overflow_error_mut(self: TypeAnalysisSession, node: Literal, val: Int64, target_type: String@symbol, min_value: Int64, max_value: Int64) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE src: ?String = typeAnalysisSession__source_code(rtoc_self_view);
    MUTABLE tok = COPY node.token;
    IF !((TRUE AND (src != NIL))) THEN
      RETURN typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :INT_LITERAL_OVERFLOW }, [], {:val: val, :type: target_type, :min: min_value, :max: max_value});
    END
    MUTABLE best: ?String@symbol = typeAnalysisSession__smallest_fitting_int_type(rtoc_self_view, val);
    IF best EXISTS AS best_value THEN
      MUTABLE line_text = (src.split("\n")[(tok.line - 1)] OR_ELSE "");
      MUTABLE snippet = line_text.substr(((tok.column - 1)), (line_text.length() - ((tok.column - 1))));
      MUTABLE m: ?CompilerRegexScanner = compilerRegexMatchData(snippet, compilerRegexCompile("\\A(\\d[\\d_]*)_([a-z]\\d+)"));
      IF m EXISTS AS m_value THEN
        MUTABLE old_suffix = COPY compilerRegexCapture(m_value, 2);
        MUTABLE new_suffix: ?String = COPY (CAST({:Int8: "i8", :Byte: "u8", :Int16: "i16", :UInt16: "u16", :Int32: "i32", :UInt32: "u32", :Int64: "i64", :UInt64: "u64"} AS {String@symbol}String))[best_value];
        IF ((new_suffix != NIL) AND (new_suffix != old_suffix)) THEN
          MUTABLE suffix_col = ((tok.column + compilerRegexCapture(m_value, 1).codepointCount()) + 1);
          RETURN typeAnalysisSession__emit_overflow_suffix_fix_mut(rtoc_self_view, Locatable{ Literal: COPY node }, target_type, min_value, max_value, tok, suffix_col, old_suffix, new_suffix, val);
        END
      END
      MUTABLE target_name = COPY CAST(target_type AS String);
      MUTABLE prefix = line_text.substr(0, (((tok.column - 1)) - 0));
      MUTABLE ann_col: ?Int64 = typeAnalysisSession__annotation_type_column(rtoc_self_view, prefix, target_name);
      IF ann_col EXISTS AS ann_col_value THEN
        MUTABLE new_type = COPY CAST(best_value AS String);
        IF (new_type != target_name) THEN
          MUTABLE fix = TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :WIDEN_INT_ANNOTATION, {:old_type: DiagnosticKwValue{ StringValue: COPY target_name }, :new_type: DiagnosticKwValue{ StringValue: COPY new_type }, :value: DiagnosticKwValue{ Int64Value: val }}), [edit__new(span__new(NIL, tok.line, ann_col_value, target_name.codepointCount()), new_type)], :auto));
          RETURN typeAnalysisSession__fixable_mut(rtoc_self_view, node, :type, [fix], NIL, :INT_LITERAL_OVERFLOW, :error, TRUE, {:val: val, :type: target_type, :min: min_value, :max: max_value});
        END
      END
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :INT_LITERAL_OVERFLOW }, [], {:val: val, :type: target_type, :min: min_value, :max: max_value});
    ELSE
      RETURN typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :INT_LITERAL_OVERFLOW }, [], {:val: val, :type: target_type, :min: min_value, :max: max_value});
    END
}
END
PRIVATE FN typeAnalysisSession__emit_overflow_suffix_fix_mut(self: TypeAnalysisSession, node: Locatable, target_type: String@symbol, min_value: Int64, max_value: Int64, tok: Token, suffix_col: Int64, old_suffix: String, new_suffix: String, val: Int64) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fix = TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :WIDEN_INT_SUFFIX, {:old_suffix: DiagnosticKwValue{ StringValue: COPY old_suffix }, :new_suffix: DiagnosticKwValue{ StringValue: COPY new_suffix }, :value: DiagnosticKwValue{ Int64Value: val }}), [edit__new(span__new(NIL, tok.line, suffix_col, old_suffix.codepointCount()), new_suffix)], :auto));
    typeAnalysisSession__fixable_mut(rtoc_self_view, node, :type, [fix], NIL, :INT_LITERAL_OVERFLOW, :error, TRUE, {:val: val, :type: target_type, :min: min_value, :max: max_value});
}
END
PRIVATE FN typeAnalysisSession__emit_local_never_shared_finding_mut(self: TypeAnalysisSession, info: BindingAuditRecord) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE name = COPY info.var;
    MUTABLE line: ?Int64 = info.line;
    MUTABLE fixes = List[];
    MUTABLE source: ?String = typeAnalysisSession__source_code(rtoc_self_view);
    IF ((source != NIL) AND (line != NIL)) THEN
      MUTABLE src_line = (source.split("\n")[(line - 1)] OR_ELSE "");
      MUTABLE idx: ?Int64 = src_line.indexOf("@local", (((info.column OR_ELSE 1)) - 1));
      IF idx EXISTS AS idx_value THEN
        MUTABLE trail = IF ((src_line.substr((idx_value + 6), 1) == " ")) THEN
          1
        ELSE
          0
        END;
        MUTABLE lead = IF (((idx_value > 0) AND (src_line.substr((idx_value - 1), 1) == " "))) THEN
          1
        ELSE
          0
        END;
        MUTABLE start_col = ((idx_value + 1) - lead);
        MUTABLE length = ((6 + lead) + trail);
        &fixes.append(TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :REMOVE_LOCAL_CAPABILITY, {:name: DiagnosticKwValue{ StringValue: COPY name }}), [edit__new(span__new(NIL, line, start_col, length), "")], :auto)));
      END
    END
    MUTABLE anchor_branch_value: ?AnchorToken = NIL;
    IF line EXISTS AS line_value THEN
      anchor_branch_value = typeAnalysisSession__anchor_at(rtoc_self_view, line_value, (info.column OR_ELSE 1));
    ELSE
      anchor_branch_value = NIL;
    END
    MUTABLE anchor: ?AnchorToken = anchor_branch_value;
    typeAnalysisSession__fixable_mut(rtoc_self_view, anchor, :lint, fixes, NIL, :LOCAL_NEVER_SHARED, :info, FALSE, {:name: name});
}
END
PRIVATE FN typeAnalysisSession__emit_immutable_assignment_error_mut(self: TypeAnalysisSession, node: BindExpr, scope: Scope) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fix: ?Fix@multiowned = typeAnalysisSession__build_declare_mutable_fix(rtoc_self_view, node.name, scope);
    IF fix EXISTS AS fix_value THEN
      typeAnalysisSession__fixable_mut(rtoc_self_view, node, :ownership, [fix_value], NIL, :IMMUTABLE_ASSIGNMENT, :error, FALSE, {:name: node.name});
    ELSE
      RETURN typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :IMMUTABLE_ASSIGNMENT }, [], {:name: node.name});
    END
}
END
PRIVATE FN typeAnalysisSession__emit_immutable_arg_error_mut(self: TypeAnalysisSession, arg_node: Identifier, scope: Scope, arg_idx: Int64, param_name: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fix: ?Fix@multiowned = typeAnalysisSession__build_declare_mutable_fix(rtoc_self_view, arg_node.name, scope);
    MUTABLE kw = {:index: arg_idx, :param: param_name, :actual: arg_node.name};
    IF fix EXISTS AS fix_value THEN
      typeAnalysisSession__fixable_mut(rtoc_self_view, arg_node, :ownership, [fix_value], NIL, :IMMUTABLE_ARG_PASSED_AS_MUTABLE, :error, TRUE, kw);
    ELSE
      RETURN typeAnalysisSession__error_mut(rtoc_self_view, arg_node, TypeAnalysisCodeOrMessage{ SymbolValue: :IMMUTABLE_ARG_PASSED_AS_MUTABLE }, [], kw);
    END
}
END
PRIVATE FN typeAnalysisSession__emit_missing_mutable_marker_error_mut(self: TypeAnalysisSession, facts: CallArgumentFacts, scope: Scope) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE arg = COPY facts.arg_node;
    MUTABLE root: ?Identifier = aST__root_identifier(arg);
    IF root EXISTS AS root_value THEN
      MUTABLE edits: []Edit = [edit__new(span__new(NIL, root_value.token.line, root_value.token.column, 0), "&")];
      MUTABLE mutable_fix: ?Fix@multiowned = typeAnalysisSession__build_declare_mutable_fix(rtoc_self_view, root_value.name, scope);
      IF (scope__is_immutable?(scope, root_value.name) AND (mutable_fix != NIL)) THEN
        edits = ruby_array_concat_Edit(edits, mutable_fix.edits);
      END
      MUTABLE fix = TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :INSERT_MUTABLE_ARGUMENT_MARKER, {:name: DiagnosticKwValue{ StringValue: COPY root_value.name }, :param: DiagnosticKwValue{ StringValue: COPY facts.param.name }}), edits, :auto));
      typeAnalysisSession__fixable_mut(rtoc_self_view, root_value, :mutability, [fix], NIL, :MUTABLE_ARGUMENT_REQUIRES_MARKER, :error, FALSE, {:index: (facts.index + 1), :param: facts.param.name, :actual: root_value.name});
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__emit_unexpected_mutable_argument_error_mut(self: TypeAnalysisSession, facts: CallArgumentFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE token: ?Token@multiowned = COPY KEEP facts.mutable_marker_token;
    IF token EXISTS AS token_value THEN
      MUTABLE fix = TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :REMOVE_MUTABLE_ARGUMENT_MARKER, {:param: DiagnosticKwValue{ StringValue: COPY facts.param.name }}), [edit__new(span__new(NIL, token_value.line, token_value.column, 1), "")], :auto));
      typeAnalysisSession__fixable_mut(rtoc_self_view, token_value, :mutability, [fix], NIL, :MUTABLE_MARKER_ON_IMMUTABLE_PARAM, :error, FALSE, {:index: (facts.index + 1), :param: facts.param.name});
    ELSE
      RETURN typeAnalysisSession__error_mut(rtoc_self_view, facts.arg_node, TypeAnalysisCodeOrMessage{ SymbolValue: :MUTABLE_MARKER_ON_IMMUTABLE_PARAM }, [], {:index: (facts.index + 1), :param: facts.param.name});
    END
}
END
PRIVATE FN typeAnalysisSession__emit_immutable_index_assignment_error_mut(self: TypeAnalysisSession, assignment_node: Assignment, scope: Scope, var_name: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fix: ?Fix@multiowned = typeAnalysisSession__build_declare_mutable_fix(rtoc_self_view, var_name, scope);
    IF fix EXISTS AS fix_value THEN
      typeAnalysisSession__fixable_mut(rtoc_self_view, assignment_node, :ownership, [fix_value], NIL, :ASSIGN_INDEX_IMMUTABLE_LIST, :error, FALSE, {:name: var_name});
    ELSE
      RETURN typeAnalysisSession__error_mut(rtoc_self_view, assignment_node, TypeAnalysisCodeOrMessage{ SymbolValue: :ASSIGN_INDEX_IMMUTABLE_LIST }, [], {:name: var_name});
    END
}
END
PRIVATE FN typeAnalysisSession__emit_immutable_field_assignment_error_mut(self: TypeAnalysisSession, assignment_node: Assignment, scope: Scope, var_name: String, field_name: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fix: ?Fix@multiowned = typeAnalysisSession__build_declare_mutable_fix(rtoc_self_view, var_name, scope);
    MUTABLE kw = {:name: var_name, :field: field_name};
    IF fix EXISTS AS fix_value THEN
      typeAnalysisSession__fixable_mut(rtoc_self_view, assignment_node, :ownership, [fix_value], NIL, :IMMUTABLE_FIELD_ASSIGNMENT, :error, FALSE, kw);
    ELSE
      RETURN typeAnalysisSession__error_mut(rtoc_self_view, assignment_node, TypeAnalysisCodeOrMessage{ SymbolValue: :IMMUTABLE_FIELD_ASSIGNMENT }, [], kw);
    END
