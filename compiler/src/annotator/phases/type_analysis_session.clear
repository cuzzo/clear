PRIVATE FN typeAnalysisSession__verify_returns(MUTABLE self: TypeAnalysisSession, node: RoutineNode, found_returns: []ReturnFact, declared_return: ?TypeTypeInput) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE declared_type_branch_value: ?Type = NIL;
    IF (declared_return == NIL) THEN
