    MUTABLE rtoc_each_items_13 = ((COPY resolution.program).statements);
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_13.length() DO
      IF UNWRAP (rtoc_each_items_13[rtoc_idx]) IS_A FunctionDef THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      TRY (typeAnalysisSession__scan_kept_fn_value_use_mut(&rtoc_self_view, UNWRAP (rtoc_each_items_13[rtoc_idx]), _));
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PUB FN typeAnalysisSession__scan_kept_fn_value_use_mut(MUTABLE self: TypeAnalysisSession, node: Locatable, kept_fns: {String}Param) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (IF node IS_A Identifier AS identifier THEN kept_fns.contains?(identifier__name(identifier)) ELSE FALSE END) THEN
      MUTABLE sym: ?SymbolEntry@multiowned = aST__node__symbol(node);
      MUTABLE shadowed = (((TRUE AND ((functionSignature__unwrap(X{ Type: COPY symbolEntry__type(UNWRAP (sym)) })) == NIL)) AND !((FALSE))) AND (type__resolved(symbolEntry__type(UNWRAP (sym))) != :Any));
      IF !(shadowed) THEN
        MUTABLE param = COPY UNWRAP (kept_fns[UNWRAP (locatable__name(node))]);
        MUTABLE contract = UNWRAP ((IF param.symbol != NIL THEN
          symbolEntry__kept_identity(UNWRAP (param.symbol))
        ELSE
          NIL
        END));
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY node }, TypeAnalysisCodeOrMessage{ SymbolValue: :KEPT_FN_VALUE_ABI }, [], CAST({:name: locatable__name(node), :param: param.name, :sink: contract.sink, :fn_type: "FN(...)"} AS {String@symbol}Any)));
      END
    END
    aST__each_child_node(node, %(child: Locatable) USE(kept_fns, MUTABLE rtoc_self_view) -> {
    TRY (typeAnalysisSession__scan_kept_fn_value_use_mut(&rtoc_self_view, child, kept_fns));
    rubyToClearVoid__type_analysis_session()
    });
}
END
PUB FN typeAnalysisSession__kept_identity_declaration_anchor(MUTABLE self: TypeAnalysisSession, body_summaries: {String}FunctionBodySummary, entry: SymbolEntry) RETURNS ?Locatable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR rtoc_each_item_14 IN body_summaries.values() DO
    MUTABLE decl: ?BindingNode = rtoc_each_item_14.binding_nodes |> FIND (TRUE AND ((UNWRAP (aST__node__symbol( castBindingNodeToLocatable(_)))).binding_id == entry.binding_id));
    IF decl EXISTS AS decl_value THEN
        RETURN castBindingNodeToLocatable(decl_value);
    END
    END
    RETURN NIL;
}
END
PUB FN typeAnalysisSession__language_mode(MUTABLE self: TypeAnalysisSession) RETURNS String@symbol
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN (COPY rtoc_self_view.resolution.program).language_mode;
}
