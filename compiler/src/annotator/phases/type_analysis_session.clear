PRIVATE FN typeAnalysisSession__pipeline_source_fact(MUTABLE self: TypeAnalysisSession, source: Locatable, source_type: Type, include_inf_stream: Bool = FALSE) RETURNS !PipelineSourceFact
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (include_inf_stream AND TRY (type__inf_stream?(source_type))) THEN
      MUTABLE item: ?Type = (IF TRY (type__canonical_stream_item_type(source_type)) != NIL THEN TRY (type__canonical_stream_item_type(source_type)) ELSE UNWRAP (TRY (type__inf_stream_element_type(source_type))) END);
      RETURN PipelineSourceFact{ kind: :inf_stream, item_type: COPY UNWRAP (item)};
    END
    IF source IS_A RangeLit AS source_narrowed THEN
      RETURN PipelineSourceFact{ kind: :range, item_type: CAST(COPY TRY (typeAnalysisSession__range_element_type(rtoc_self_view, source_narrowed)) AS Type) };
    END
    IF TRY (type__open_stream?(source_type)) THEN
      MUTABLE item: ?Type = (IF TRY (type__canonical_stream_item_type(source_type)) != NIL THEN TRY (type__canonical_stream_item_type(source_type)) ELSE UNWRAP (TRY (type__open_stream_element_type(source_type))) END);
      RETURN PipelineSourceFact{ kind: :open_stream, item_type: COPY UNWRAP (item)};
    END
    IF TRY (type__dynamic_stream?(source_type)) THEN
      MUTABLE item: ?Type = (IF TRY (type__canonical_stream_item_type(source_type)) != NIL THEN TRY (type__canonical_stream_item_type(source_type)) ELSE UNWRAP (TRY (type__element_type((TRY (type__tense_type(source_type)))))) END);
      RETURN PipelineSourceFact{ kind: :dynamic_stream, item_type: COPY UNWRAP (item)};
    END
    IF TRY (type__bounded_stream?(source_type)) THEN
      MUTABLE item: ?Type = (IF TRY (type__canonical_stream_item_type(source_type)) != NIL THEN TRY (type__canonical_stream_item_type(source_type)) ELSE UNWRAP (TRY (type__element_type((TRY (type__tense_type(source_type)))))) END);
      RETURN PipelineSourceFact{ kind: :bounded_stream, item_type: COPY UNWRAP (item)};
    END
    MUTABLE element_type: ?Type = TRY (type__element_type(source_type));
    IF (TRY (type__linear_collection?(source_type)) AND (element_type != NIL)) THEN
      RETURN PipelineSourceFact{ kind: :collection, item_type: COPY element_type };
    END
    RETURN PipelineSourceFact{ kind: :invalid, item_type: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })) };
}
END
PRIVATE FN typeAnalysisSession__has_catch_blocks?(MUTABLE self: TypeAnalysisSession) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_name: ?String = COPY typeAnalysisSession__current_fn_ctx(&rtoc_self_view)?.name;
    MUTABLE fn_nodes = TRY (typeAnalysisSession__function_node_map(&rtoc_self_view));
    MUTABLE fn_branch_value: ?FunctionDef@multiowned = NIL;
    IF fn_name EXISTS AS fn_name_value THEN
      fn_branch_value = COPY fn_nodes[fn_name_value];
    ELSE
      fn_branch_value = NIL;
    END
    MUTABLE fn: ?FunctionDef@multiowned = fn_branch_value;
    IF fn EXISTS AS fn_value THEN
      RETURN typeAnalysisSession__function_has_catch_clauses?(&rtoc_self_view, CAST(fn_value AS FunctionDef));
    ELSE
      RETURN FALSE;
    END
