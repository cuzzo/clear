    ELSE
      rtoc_ternary_value_185 = TRY (type__new(castTypeTypeInputToTypeConstructionInput(type_obj)));
    END
    rtoc_ternary_value_185? };
    IF t.fn_type?() THEN
      MUTABLE fn_type = type__function_type(t);
      IF !(fn_type) THEN
        RETURN t;
      END
      MUTABLE params = fn_type.params() |> SELECT FunctionTypeParam{ type: CAST(COPY typeAnalysisSession__apply_type_subst(rtoc_self_view, _.type(), subst) AS Type), mutable: FALSE };
      RETURN TRY (type__new(TypeConstructionInput{ FunctionType: COPY FunctionType{ params: COPY params, return_type: CAST(COPY typeAnalysisSession__apply_type_subst(rtoc_self_view, TypeTypeInput{ Type: COPY functionSignature__return_type(fn_type) }, subst) AS Type), reentrant: functionSignature__reentrant(fn_type), source_signature: COPY fn_type.source_signature(), abi: COPY fn_type.abi() } }));
    ELSE
