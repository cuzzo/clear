    MUTABLE type_schema: ?SchemaValue = TRY (typeAnalysisSession__lookup_type_schema(&rtoc_self_view, base));
    IF !((((schemas__struct?(type_schema) OR schemas__resource?(type_schema))) AND ((schemaValue__methods(UNWRAP (type_schema)) != NIL) AND ((schemaValue__methods(UNWRAP (type_schema)))?).contains?(node.name)))) THEN
      RETURN FALSE;
    END
    MUTABLE method_sig: ?{String@symbol}FunctionSignature@multiowned = schemaValue__methods(UNWRAP (type_schema))[node.name];
    IF !(functionSignature__extern(method_sig)) THEN
      RETURN FALSE;
    END
    node.extern_call = TRUE;
    IF TRY (functionSignature__extern_effects(method_sig)) THEN
      node.extern_effects = TRY (functionSignature__extern_effects(method_sig));
    END
    node.extern_source = functionSignature__extern_source(method_sig);
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, &node, functionSignature__return_type(method_sig)));
    TRY (typeAnalysisSession__record_effect(&rtoc_self_view, symbol("EXTERN")));
    TRY (typeAnalysisSession__record_extern_method_alloc_mut(&rtoc_self_view, method_sig));
    TRY (typeAnalysisSession__record_predicate_call_site_mut(&rtoc_self_view, Node{ MethodCall: COPY node }));
    RETURN TRUE;
}
END
