    MUTABLE lhs_type = TRY (aST__full_type_mut(node.left));
    MUTABLE lhs_t = (typeAnalysisSession__recoverable_result_type(&rtoc_self_view, &node.left, "RECOVER input") OR_ELSE TRY (type__new(TypeConstructionInput{ Type: COPY lhs_type })));
