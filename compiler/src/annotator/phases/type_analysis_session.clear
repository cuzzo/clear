END
PRIVATE FN typeAnalysisSession__verify_takes_argument_mut(MUTABLE self: TypeAnalysisSession, MUTABLE facts: CallArgumentFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (facts.is_give AND !(facts.param.takes)) THEN
      TRY (typeAnalysisSession__record_deferred_give_validation_mut(&rtoc_self_view, facts));
    END
    IF !(((facts.param.takes OR_ELSE FALSE) OR facts.is_give)) THEN
      RETURN;
    END
    MUTABLE inner_identifier_branch_value: ?Identifier = NIL;
    IF facts.inner_node IS_A Identifier THEN
      inner_identifier_branch_value = COPY castLocatableToIdentifier__type_analysis_session(facts.inner_node);
    ELSE
      inner_identifier_branch_value = NIL;
    END
    MUTABLE inner_identifier: ?Identifier = inner_identifier_branch_value;
    TRY (typeAnalysisSession__verify_owned_takes_argument_mut(&rtoc_self_view, facts));
    MUTABLE container_alloc = (typeAnalysisSession__receiver_container_alloc(&rtoc_self_view, facts.site.node) OR_ELSE :heap);
    MUTABLE inner_type = TRY (aST__full_type_mut(facts.inner_node));
    MUTABLE give_needs_representation_copy = (facts.is_give AND ((type__list_collection?(inner_type) OR ((TRY (type__string?(inner_type)) AND type__rodata?(inner_type))))));
    MUTABLE owned_branch_value: ?Locatable = NIL;
    IF (facts.is_give AND !(give_needs_representation_copy)) THEN
      owned_branch_value = NIL;
    ELSE
      owned_branch_value = TRY (typeAnalysisSession__ensure_owned_value_mut(&rtoc_self_view, &facts.inner_node, castTypeToOptionalTypeTypeInput__type_analysis_session(facts.param.type), NIL, container_alloc));
    END
    MUTABLE owned: ?Locatable = owned_branch_value;
    IF owned EXISTS AS owned_value THEN
      callSignatureSite__replace_arg_mut(&facts.site, facts.index, owned_value);
    END
    MUTABLE current_arg: ?Locatable = COPY facts.site.args[facts.index];
    IF (IF current_arg? IS_A CopyNode AS copy_node THEN (container_alloc != :heap) ELSE FALSE END) THEN
      IF current_arg EXISTS AS MUTABLE current_arg_present THEN
        locatable__set_alloc_mut(&current_arg_present, container_alloc);
      END
    END
    IF owned EXISTS AS owned_value THEN
      RETURN;
    END
    IF ((((((typeAnalysisSession__language_mode(&rtoc_self_view) != :strict) AND !(facts.is_give)) AND (inner_identifier != NIL)) AND !(TRY (type__implicitly_copyable?((TRY (aST__full_type_mut(Locatable{ Identifier: COPY inner_identifier }))), %(name: String@symbol) USE(MUTABLE rtoc_self_view) -> TRY (typeAnalysisSession__schema_lookup_result(&rtoc_self_view, name)))))) AND !(facts.arg_node IS_A CopyNode)) AND !(facts.arg_node IS_A KeepNode)) THEN
      inner_identifier.ownership_pending_transfer = TRUE;
      RETURN;
    END
    TRY (typeAnalysisSession__move_if_takes_ownership_mut(&rtoc_self_view, &facts.inner_node, IF facts.is_give THEN
      :give
    ELSE
      :takes
    END, facts.param.type));
    locatable__set_was_moved_mut(&facts.inner_node, TRUE);
    locatable__set_was_moved_mut(&facts.arg_node, TRUE);
    IF (aST__node_was_moved( UNWRAP (current_arg)) EXISTS) THEN
      IF current_arg EXISTS AS MUTABLE current_arg_present THEN
        locatable__set_was_moved_mut(&current_arg_present, TRUE);
      END
    END
}
END
PRIVATE FN typeAnalysisSession__verify_owned_takes_argument_mut(MUTABLE self: TypeAnalysisSession, facts: CallArgumentFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(typeAnalysisSession__borrowed_takes_argument?(&rtoc_self_view, facts.inner_node)) THEN
      RETURN;
    END
    MUTABLE arg_ti = TRY (aST__full_type_mut(facts.inner_node));
    IF TRY (type__implicitly_copyable?(arg_ti, %(type: String@symbol) USE(MUTABLE rtoc_self_view) -> TRY (typeAnalysisSession__schema_lookup_result(&rtoc_self_view, type)))) THEN
      RETURN;
    END
    IF facts.inner_node IS_A GetIndex THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY facts.inner_node }, TypeAnalysisCodeOrMessage{ SymbolValue: :TAKES_NEEDS_OWNED_INDEX }));
    ELSE
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY facts.inner_node }, TypeAnalysisCodeOrMessage{ SymbolValue: :TAKES_NEEDS_OWNED_BORROW }));
    END
}
END
PRIVATE FN typeAnalysisSession__verify_link_argument_mut(MUTABLE self: TypeAnalysisSession, facts: CallArgumentFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(type__link?(facts.arg_type)) THEN
      RETURN;
    END
    IF (type__any?(facts.expected_type) OR type__link?(facts.expected_type)) THEN
      RETURN;
    END
    TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY facts.arg_node }, TypeAnalysisCodeOrMessage{ SymbolValue: :LINK_NEEDS_RESOLVE_FOR_CALL }, [], CAST({:name: typeAnalysisSession__argument_name(&rtoc_self_view, facts.arg_node, "Expression"), :param: facts.param.name} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__verify_argument_type_mut(MUTABLE self: TypeAnalysisSession, MUTABLE facts: CallArgumentFacts, signature: FunctionSignature, MUTABLE atomic_bare_value_args: []Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (type__array?(facts.expected_type) AND type__array?(facts.actual_type)) THEN
      MUTABLE expected_element: ?Type = TRY (type__element_type(facts.expected_type));
      MUTABLE actual_element: ?Type = TRY (type__element_type(facts.actual_type));
      IF ((((expected_element != NIL) AND (actual_element != NIL)) AND (type__resolved(expected_element) == type__resolved(actual_element))) AND (type__indirect?(expected_element) != type__indirect?(actual_element))) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY facts.arg_node }, TypeAnalysisCodeOrMessage{ SymbolValue: :COLLECTION_ELEMENT_LAYOUT_MISMATCH }, [], CAST({:expected: TRY (typeAnalysisSession__collection_layout_display(&rtoc_self_view, facts.expected_type)), :actual: TRY (typeAnalysisSession__collection_layout_display(&rtoc_self_view, facts.actual_type))} AS {String@symbol}Any)));
      END
    END
    IF ((type__indirect?(facts.expected_type) AND !(type__indirect?(facts.actual_type))) AND (type__resolved(facts.expected_type) == type__resolved(facts.actual_type))) THEN
      IF !((typeAnalysisSession__language_mode(&rtoc_self_view) == :easy)) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY facts.arg_node }, TypeAnalysisCodeOrMessage{ SymbolValue: :INDIRECT_ARGUMENT_EXPLICIT }, [], CAST({:index: (facts.index + 1), :expected: TRY (type__coercion_surface_name(castTypeToTypeTypeInput__type_analysis_session(facts.expected_type)))} AS {String@symbol}Any)));
      END
      locatable__set_coerced_type_object_mut(&facts.arg_node, COPY facts.expected_type);
    END
    MUTABLE match = TRY (typeAnalysisSession__fn_type_argument_match?(&rtoc_self_view, facts));
    TRY (typeAnalysisSession__verify_atomic_argument_mut(&rtoc_self_view, facts, signature, &atomic_bare_value_args));
    IF TRY (typeAnalysisSession__shared_argument_match?(&rtoc_self_view, facts, match)) THEN
      match = TRUE;
    END
    IF TRY (typeAnalysisSession__basic_argument_match?(&rtoc_self_view, &facts)) THEN
      match = TRUE;
    END
    IF match THEN
      RETURN;
    END
    TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY facts.arg_node }, TypeAnalysisCodeOrMessage{ SymbolValue: :ARGUMENT_TYPE_ERROR }, [], CAST({:fn: typeAnalysisSession__argument_name(&rtoc_self_view, facts.arg_node, "Expression"), :index: (facts.index + 1), :expected: TRY (type__coercion_surface_name(castTypeToTypeTypeInput__type_analysis_session(facts.expected_type))), :got: TRY (type__coercion_surface_name(castTypeToTypeTypeInput__type_analysis_session(facts.actual_type)))} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__collection_layout_display(MUTABLE self: TypeAnalysisSession, type: Type) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE element: ?Type = TRY (type__element_type(type));
    IF element EXISTS AS element_value THEN
      MUTABLE element_name = TRY (type__surface_name_type(element_value));
      IF type__indirect?(element_value) THEN
        element_name = (element_name $+ "@boxed");
      END
      MUTABLE collection_name: String = "";
      IF type__collection(type) THEN
        collection_name = "@${(type__collection(type) OR_ELSE "")}";
      ELSE
        collection_name = "";
      END
      RETURN "${element_name}[]${collection_name}";
    ELSE
      RETURN TRY (type__coercion_surface_name(castTypeToTypeTypeInput__type_analysis_session(type)));
    END
}
END
PRIVATE FN typeAnalysisSession__fn_type_argument_match?(MUTABLE self: TypeAnalysisSession, facts: CallArgumentFacts) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(type__fn_type?(facts.expected_type)) THEN
      RETURN FALSE;
    END
    MUTABLE actual_type = TRY (aST__full_type_mut(facts.arg_node));
    IF TRY (type__accepts?(facts.expected_type, actual_type)) THEN
      RETURN TRUE;
    END
    IF TRY (typeAnalysisSession__reentrant_fn_argument_allowed_by_callee?(&rtoc_self_view, facts)) THEN
      RETURN TRUE;
    END
    IF !(TRY (typeAnalysisSession__reentrant_fn_argument_rejected?(&rtoc_self_view, facts))) THEN
      RETURN FALSE;
    END
    TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY facts.arg_node }, TypeAnalysisCodeOrMessage{ SymbolValue: :REENTRANT_FN_TO_NON_REENTRANT_PARAM }, [], CAST({:name: typeAnalysisSession__argument_name(&rtoc_self_view, facts.arg_node, "Expression"), :param: facts.param.name} AS {String@symbol}Any)));
    RETURN FALSE;
}
END
PRIVATE FN typeAnalysisSession__reentrant_fn_argument_allowed_by_callee?(MUTABLE self: TypeAnalysisSession, facts: CallArgumentFacts) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(type__fn_type?(facts.actual_type)) THEN
      RETURN FALSE;
    END
    MUTABLE actual_sig: ?FunctionSignature@multiowned = type__function_signature(facts.actual_type);
    IF actual_sig EXISTS AS actual_sig_value THEN
      IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_78 = CAST(actual_sig_value AS FunctionSignature);
      functionSignature__reentrant(rtoc_local_receiver_78) } THEN
        MUTABLE callee: ?FunctionDef@multiowned = TRY (typeAnalysisSession__function_node_for(&rtoc_self_view, facts.site.name));
        IF !((IF callee != NIL THEN
          functionDef__declared_plain_reentrant?(callee)
        ELSE
          NIL
        END)) THEN
          RETURN FALSE;
        END
        RETURN ((callee?.requires_clauses == NIL) OR (((UNWRAP (callee).requires_clauses)?)[facts.param.name] != :non_reentrant));
      ELSE
        RETURN FALSE;
      END
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__reentrant_fn_argument_rejected?(MUTABLE self: TypeAnalysisSession, facts: CallArgumentFacts) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(type__fn_type?(facts.actual_type)) THEN
      RETURN FALSE;
    END
    MUTABLE actual_sig: ?FunctionSignature@multiowned = type__function_signature(facts.actual_type);
    IF actual_sig EXISTS AS actual_sig_value THEN
      IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_79 = CAST(actual_sig_value AS FunctionSignature);
      functionSignature__reentrant(rtoc_local_receiver_79) } THEN
        MUTABLE callee: ?FunctionDef@multiowned = TRY (typeAnalysisSession__function_node_for(&rtoc_self_view, facts.site.name));
        MUTABLE constraint: ?String = (IF callee != NIL THEN
          callee.requires_clauses[facts.param.name]
        ELSE
          NIL
        END);
        IF (constraint == :non_reentrant) THEN
          RETURN TRUE;
        END
        RETURN ((callee == NIL) OR (functionDef__declared_plain_reentrant?(callee) != TRUE));
      ELSE
        RETURN FALSE;
      END
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__verify_atomic_argument_mut(MUTABLE self: TypeAnalysisSession, facts: CallArgumentFacts, signature: FunctionSignature, MUTABLE atomic_bare_value_args: []Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE arg_node = COPY facts.arg_node;
    IF typeAnalysisSession__explicit_primitive_atomic_param?(&rtoc_self_view, facts.expected_type) THEN
      IF !((IF arg_node IS_A Identifier AS identifier THEN typeAnalysisSession__atomic_cell_arg?(&rtoc_self_view, identifier) ELSE FALSE END)) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY arg_node }, TypeAnalysisCodeOrMessage{ SymbolValue: :ARG_NEEDS_ATOMIC_CELL }, [], CAST({:index: (facts.index + 1), :fn: facts.site.name, :expected: type__resolved(facts.expected_type), :name: typeAnalysisSession__argument_name(&rtoc_self_view, arg_node, "Expression"), :actual: type__resolved(facts.actual_type)} AS {String@symbol}Any)));
      END
      IF arg_node IS_A Identifier AS MUTABLE identifier THEN
        identifier.atomic_borrow = TRUE;
      END
    END
    IF typeAnalysisSession__atomic_cell_to_bare_value_param?(&rtoc_self_view, arg_node, facts.expected_type, facts.param) THEN
      &atomic_bare_value_args.append(COPY arg_node);
    END
    IF TRY (typeAnalysisSession__atomic_cell_to_atomic_param?(&rtoc_self_view, arg_node, facts.param, signature)) THEN
      IF arg_node IS_A Identifier AS MUTABLE identifier THEN
        identifier.atomic_borrow = TRUE;
      END
    END
}
END
PRIVATE FN typeAnalysisSession__shared_argument_match?(MUTABLE self: TypeAnalysisSession, facts: CallArgumentFacts, matched: Bool) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF matched THEN
      RETURN FALSE;
    END
    IF !((type__shared?(facts.expected_type) AND (type__resolved(facts.expected_type) == type__resolved(facts.actual_type)))) THEN
      RETURN FALSE;
    END
    MUTABLE arg_node = COPY facts.arg_node;
    IF !(type__shared?(facts.actual_type)) THEN
      MUTABLE hint: String = "";
      IF arg_node IS_A Identifier AS identifier THEN
        hint = " Use SHARE ${identifier__name(identifier)} to create a shared handle.";
      ELSE
        hint = " Use SHARE <expr> to create a shared handle.";
      END
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY arg_node }, TypeAnalysisCodeOrMessage{ SymbolValue: :ARG_NEEDS_SHARED }, [], CAST({:index: (facts.index + 1), :fn: facts.site.name, :expected: facts.expected_type, :actual: facts.actual_type, :hint: hint} AS {String@symbol}Any)));
    END
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__basic_argument_match?(MUTABLE self: TypeAnalysisSession, MUTABLE facts: CallArgumentFacts) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__check_prefixed_int_range_mut(&rtoc_self_view, facts.arg_node, castTypeToOptionalTypeTypeInput__type_analysis_session(facts.expected_type)));
    IF ((type__any?(facts.expected_type) OR (facts.actual == :Any)) OR (type__semantic_type_key(facts.expected_type) == type__semantic_type_key(facts.actual_type))) THEN
      RETURN TRUE;
    END
    IF TRY (typeAnalysisSession__any_element_collection_param?(&rtoc_self_view, facts.expected_type, facts.actual_type)) THEN
      RETURN TRUE;
    END
    IF TRY (type__accepts?(facts.expected_type, facts.actual_type)) THEN
      IF (TRY (type__node_reference?(facts.expected_type)) AND !(TRY (type__node_reference?(facts.actual_type)))) THEN
        locatable__set_coerced_type_object_mut(&facts.arg_node, COPY facts.expected_type);
      END
      RETURN TRUE;
    END
    IF type__auto?(facts.expected_type) THEN
      RETURN TRUE;
    END
    IF !(TRY (typeAnalysisSession__is_safe_autocast?(rtoc_self_view, ruby_wrap_optional_String_symbol_SourceType(facts.actual), castTypeToTypeTypeInput__type_analysis_session(facts.expected_type)))) THEN
      RETURN FALSE;
    END
    locatable__set_coerced_type_object_mut(&facts.arg_node, COPY facts.expected_type);
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__verify_argument_aliases_mut(MUTABLE self: TypeAnalysisSession, facts: CallArgumentFacts, MUTABLE encountered_args: []EncounteredCallArgument) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE current_path = COPY facts.path;
    IF (current_path.length() == 0) THEN
      RETURN;
    END
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < encountered_args.length() DO
      IF !((((typeAnalysisSession__param_mutable?(&rtoc_self_view, facts.param) OR (encountered_args[rtoc_idx]?.mutable OR_ELSE FALSE))) AND typeAnalysisSession__paths_overlap?(&rtoc_self_view, current_path, (encountered_args[rtoc_idx]?.path OR_ELSE List[])))) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY facts.arg_node }, TypeAnalysisCodeOrMessage{ SymbolValue: :ARG_ALIAS_CONFLICT }, [], CAST({:index: (facts.index + 1), :name: typeAnalysisSession__argument_name(&rtoc_self_view, facts.arg_node, "arg"), :other_index: (rtoc_idx + 1), :path: symbol(UNWRAP (current_path.first()))} AS {String@symbol}Any)));
    rtoc_idx = rtoc_idx + 1;
    END
    &encountered_args.append(EncounteredCallArgument{ path: COPY current_path, mutable: typeAnalysisSession__param_mutable?(&rtoc_self_view, facts.param), name: COPY typeAnalysisSession__argument_name(&rtoc_self_view, facts.arg_node, "arg") });
}
END
PRIVATE FN typeAnalysisSession__argument_name(MUTABLE self: TypeAnalysisSession, node: Locatable, fallback: String) RETURNS String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (node IS_A Identifier) OR (node IS_A FuncCall) OR (node IS_A MethodCall) OR (node IS_A VarDecl) OR (node IS_A BindExpr) THEN
      RETURN COPY CAST(locatable__name(node) AS String);
    ELSE_IF node IS_A GetField AS get_field THEN
      RETURN typeAnalysisSession__argument_name(&rtoc_self_view, get_field.target, fallback);
    ELSE_IF node IS_A GetIndex AS get_index THEN
      RETURN typeAnalysisSession__argument_name(&rtoc_self_view, get_index.target, fallback);
    ELSE
      RETURN COPY fallback;
    END
}
END
PRIVATE FN typeAnalysisSession__param_mutable?(MUTABLE self: TypeAnalysisSession, param: Param) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN !(!(param.mutable));
}
END
PRIVATE FN typeAnalysisSession__borrowed_takes_argument?(MUTABLE self: TypeAnalysisSession, node: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN aST__borrowed_ownership_view?(node);
}
END
PRIVATE FN typeAnalysisSession__any_element_collection_param?(MUTABLE self: TypeAnalysisSession, expected_type: Type, actual_type: Type) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE expected_elem: ?Type = TRY (type__element_type(expected_type));
    MUTABLE expected_accepts_any_element = (((TRY (type__collection_value?(expected_type)) OR type__dynamic?(expected_type))) AND ((expected_elem != NIL) AND type__any?(expected_elem)));
    MUTABLE actual_is_collection_like = (TRY (type__collection_value?(actual_type)) OR TRY (type__runtime_stream?(actual_type)));
    RETURN !(!(((expected_accepts_any_element AND actual_is_collection_like))));
}
END
PRIVATE FN typeAnalysisSession__atomic_cell_to_bare_value_param?(MUTABLE self: TypeAnalysisSession, arg_node: Locatable, expected_type_obj: Type, param: Param) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF arg_node IS_A Identifier AS identifier THEN
      MUTABLE sym: ?SymbolEntry = identifier.symbol;
      IF !((IF sym != NIL THEN
        symbolEntry__atomic?(sym)
      ELSE
        NIL
      END)) THEN
        RETURN FALSE;
      END
      IF symbolEntry__indirect?( UNWRAP (sym)) THEN
        RETURN FALSE;
      END
      IF param__atomic?(param) THEN
        RETURN FALSE;
      END
      IF param.symbol EXISTS AS symbol_value THEN
        IF symbolEntry__atomic?(symbol_value) THEN
        RETURN FALSE;
      END
      END
      IF (type__any?(expected_type_obj) OR type__fn_type?(expected_type_obj)) THEN
        RETURN FALSE;
      END
      IF (type__shared?(expected_type_obj) OR type__any_sync?(expected_type_obj)) THEN
        RETURN FALSE;
      END
      RETURN type__primitive?(expected_type_obj);
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__atomic_cell_to_atomic_param?(MUTABLE self: TypeAnalysisSession, arg_node: Locatable, param: Param, signature: FunctionSignature) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
