PRIVATE FN typeAnalysisSession__current_body_fact_scope_nodes(self: TypeAnalysisSession, node: WithBlock) RETURNS ![]Locatable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE frame: ?BodyFactFrame = COPY typeAnalysisSession__body_fact_frames(rtoc_self_view).last();
    IF frame EXISTS AS frame_value THEN
      IF frame_value.summary.with_scope_nodes[aST__node_identity(node)] != NIL THEN
    RETURN COPY (frame_value.summary.with_scope_nodes[aST__node_identity(node)])?;
      ELSE
    RETURN CAST(( { MUTABLE rtoc_empty_list_276: []Locatable = List[]; rtoc_empty_list_276 } ) AS []Locatable);
      END
    ELSE
      RETURN CAST(( { MUTABLE rtoc_empty_list_277: []Locatable = List[]; rtoc_empty_list_277 } ) AS []Locatable);
    END
}
