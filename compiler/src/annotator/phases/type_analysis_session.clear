PRIVATE FN typeAnalysisSession__declare_match_destructure_bindings_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MatchStatement, match_case: MatchCase, plan: MatchSubjectPlan) RETURNS !Void
