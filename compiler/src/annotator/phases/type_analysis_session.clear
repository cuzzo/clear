        IF typeAnalysisSession__stale_auto_node_type?(&rtoc_self_view, CAST(stmt_type AS Type)) THEN
          RETURN NIL;
        END
        RETURN TRY (type__new(TypeConstructionInput{ Type: COPY stmt_type }));
      ELSE
        RETURN NIL;
