          parameter_ids_branch_value = (lambda_lit.params |> SELECT:? ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_39 = typeAnalysisSession__current_scope(rtoc_self_view);
          scope__resolve_entry(rtoc_local_receiver_39, CAST(_.name() AS String)) })?.binding_id |> WHERE _ != NIL) |> DISTINCT _;
        ELSE
          parameter_ids_branch_value = Set[];
        END
      MUTABLE parameter_ids: Set = parameter_ids_branch_value?;
      MUTABLE transport_facts = ownershipTransportFacts__new(parameter_ids);
      IF !((typeAnalysisSession__language_mode(rtoc_self_view) == :strict)) THEN
          typeAnalysisSession__phase_audit_inputs(rtoc_self_view).ownership_transport_frames.append(KEEP transport_facts);
      END
      IF node IS_A FunctionDef THEN
          typeAnalysisSession__visit_pre_clauses_mut(&rtoc_self_view, node);
      END
      DEFER IF !((typeAnalysisSession__language_mode(rtoc_self_view) == :strict)) THEN
          MUTABLE popped: ?OwnershipTransportFacts@multiowned = typeAnalysisSession__phase_audit_inputs(rtoc_self_view).ownership_transport_frames.pop();
          IF !(popped.equal?(transport_facts)) THEN
            panic("BUG: ownership transport fact frame mismatch");
          END
      END
      IF body IS_A []Node AS array THEN
          MUTABLE array_mutable = COPY array;
          TRY (typeAnalysisSession__visit_stmts(&rtoc_self_view, array_mutable));
      ELSE
          TRY (typeAnalysisSession__visit(&rtoc_self_view, castRoutineBodyToOptionalLocatable(body)));
      END
      IF !((typeAnalysisSession__language_mode(rtoc_self_view) == :strict)) THEN
          typeAnalysisSession__finalize_ownership_transport_facts_mut(rtoc_self_view, transport_facts);
      END
      NIL;
      IF node IS_A FunctionDef THEN
          typeAnalysisSession__visit_post_clauses_mut(&rtoc_self_view, node);
      END
      rubyToClearVoid()
    });
    rubyToClearVoid()
    });
    typeAnalysisSession__verify_returns(rtoc_self_view, node, found_returns, { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_40: ?Void = NIL;
    IF is_implicit THEN
      rtoc_ternary_value_40 = NIL;
    ELSE
      rtoc_ternary_value_40 = declared_return;
    END
    rtoc_ternary_value_40? });
    MUTABLE return_type =   IF body IS_A []Node THEN
      ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_42: ?Type = NIL;
    IF found_returns |> ANY _ THEN
      rtoc_ternary_value_42 = (UNWRAP (found_returns.first())).type;
    ELSE
      rtoc_ternary_value_42 = :Any;
    END
    rtoc_ternary_value_42? })
    ELSE
      body.resolved_type()
    END;
    IF (((is_implicit OR ruby_union_scalar_equal_optional_TypeTypeInput_String_symbol(declared_return, :Any))) AND (found_returns |> ANY _)) THEN
      MUTABLE inferred = (UNWRAP (found_returns.first())).type;
      IF (is_implicit OR (found_returns.length() == 1)) THEN
        return_type = inferred;
      END
    END
    RETURN castTypeToOptionalStringSymbol(return_type);
}
END
PRIVATE FN typeAnalysisSession__module_variable_scope(self: TypeAnalysisSession) RETURNS Scope@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE seeded = scope__new();
    typeAnalysisSession__semantic_root_scope(rtoc_self_view).binding_entries.keys() |> EACH {
    MUTABLE entry: SymbolEntry@multiowned = (typeAnalysisSession__semantic_root_scope(rtoc_self_view).binding_entries[_] OR_ELSE CAST(panic("missing hash key") AS SymbolEntry@multiowned));
    IF !(((entry.reg != NIL) AND (entry.reg IS_A VarDecl))) THEN
      CONTINUE;
    END
    seeded.binding_entries[_] = KEEP entry;
    };
    RETURN seeded;
}
END
PRIVATE FN typeAnalysisSession__with_routine_analysis_scope(self: TypeAnalysisSession, node: RoutineNode, blk: FN() -> Void) RETURNS Void
  REQUIRES self: LOCAL
