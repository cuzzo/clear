PRIVATE FN typeAnalysisSession__analyze_control_flow_branches(MUTABLE self: TypeAnalysisSession, branches: []FN() -> ?[]DeferredDrop, merge_to_parent: Bool = TRUE) RETURNS ![]?[]DeferredDrop
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE og_snapshot = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_308 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
    ownershipGraph__fork_lightweight(rtoc_local_receiver_308) };
    MUTABLE branch_results: []BranchAnalysisResult = ( { MUTABLE rtoc_empty_list_309: []BranchAnalysisResult = List[]; rtoc_empty_list_309 } );
    FOR _ IN branches DO
    &branch_results.append(TRY (typeAnalysisSession__analyze_control_flow_branch( &rtoc_self_view, _, og_snapshot)));
    END
    IF merge_to_parent THEN
      IF og_snapshot THEN
        MUTABLE rtoc_mutable_receiver_310 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
        TRY (ownershipGraph__restore_lightweight(&rtoc_mutable_receiver_310, og_snapshot));
      END
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < branch_results.length() DO
      IF branch_results[rtoc_idx]?.terminated THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE snap: ?LightweightSnapshot = COPY branch_results[rtoc_idx]?.snapshot;
      IF !(snap) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      lightweightSnapshot__each_state( snap, %(path: String, state: String@symbol) USE(snap, MUTABLE rtoc_self_view) -> {
        MUTABLE rtoc_graph_12868 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
        MUTABLE node: ?OwnershipNode = COPY ownershipGraph__get_index(rtoc_graph_12868, path);
        IF !(node) THEN
              RETURN;
        END
        IF (node?.state != state) THEN
              IF (state == :moved) THEN
                IF node EXISTS AS MUTABLE node_present THEN
                  node_present.state = :moved;
                END
                IF node EXISTS AS MUTABLE node_present THEN
                  node_present.move_line = lightweightSnapshot__move_line_for( UNWRAP (snap), path);
                END
                IF node EXISTS AS MUTABLE node_present THEN
                  node_present.move_col = lightweightSnapshot__move_col_for( UNWRAP (snap), path);
                END
                IF node EXISTS AS MUTABLE node_present THEN
                  node_present.move_action = lightweightSnapshot__move_action_for( UNWRAP (snap), path);
                END
              END
        END
        rubyToClearVoid__type_analysis_session()
      });
    rtoc_idx = rtoc_idx + 1;
      END
    ELSE
      IF og_snapshot THEN
        MUTABLE rtoc_mutable_receiver_311 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
        TRY (ownershipGraph__restore_lightweight(&rtoc_mutable_receiver_311, og_snapshot));
      END
    END
    RETURN branch_results |> SELECT:? _.drops;
}
END
PRIVATE FN typeAnalysisSession__analyze_control_flow_branch(MUTABLE self: TypeAnalysisSession, branch_logic: FN() -> ?[]DeferredDrop, og_snapshot: ?LightweightSnapshot) RETURNS !BranchAnalysisResult
  REQUIRES self: LOCAL
