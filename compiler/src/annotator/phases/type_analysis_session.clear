PRIVATE FN typeAnalysisSession__promote_pipe_to_observable_dest_mut(self: TypeAnalysisSession, MUTABLE node: DeclarationNode) RETURNS !?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((TRUE AND (MATCH node START DeclarationNode.VarDecl AS item -> item.type, DeclarationNode.BindExpr AS item -> item.type END))) THEN
      RETURN;
    END
    IF !((MATCH node START DeclarationNode.VarDecl AS item -> item.value, DeclarationNode.BindExpr AS item -> item.value END)) THEN
      RETURN;
    END
    MUTABLE target: ?Type = NIL;
    MATCH node START
      DeclarationNode.VarDecl AS item ->
        target = COPY item.type;,
      DeclarationNode.BindExpr AS item ->
        target = COPY item.type;,
    END
    IF !((type__future?(target) AND type__observable?(target))) THEN
      RETURN;
    END
    MUTABLE pipe: Any = NIL;
    MATCH node START
      DeclarationNode.VarDecl AS item ->
        pipe = COPY item.value;,
      DeclarationNode.BindExpr AS item ->
        pipe = COPY item.value;,
    END
    IF !((pipe IS_A BinaryOp AND pipe.smooth?())) THEN
      RETURN;
    END
    IF !(type__observable_terminal(pipe)) THEN
      RETURN;
    END
    pipe.observable_dest = TRUE;
    MUTABLE pipe_type = &pipe.full_type_mut("observable pipe");
    IF type__observable_terminal(pipe_type) THEN
      MUTABLE pipe_terminal = type__observable_terminal(pipe_type);
      MUTABLE target_t: ?Type = NIL;
      MATCH node START
        DeclarationNode.VarDecl AS item ->
          target_t = COPY item.type;,
        DeclarationNode.BindExpr AS item ->
          target_t = COPY item.type;,
      END
      IF ((type__observable_terminal(target_t) != NIL) AND (type__observable_terminal(target_t) != pipe_terminal)) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :OBSERVABLE_TERMINAL_MISMATCH }, [], {:lhs: compilerInspectValue(), :pipe: compilerInspectValue()});
      END
      TRY (type__stamp_observable_terminal_mut(&target_t, pipe_terminal));
      MATCH node START
        DeclarationNode.VarDecl AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.type = target_t;
          node = DeclarationNode{ VarDecl: item_mutable };,
        DeclarationNode.BindExpr AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.type = target_t;
          node = DeclarationNode{ BindExpr: item_mutable };,
      END
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, castDeclarationNodeToLocatable(node), target_t));
    END
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &pipe, (MATCH node START DeclarationNode.VarDecl AS item -> item.type, DeclarationNode.BindExpr AS item -> item.type END)));
}
END
PRIVATE FN typeAnalysisSession__finalize_decl_node_mut(self: TypeAnalysisSession, MUTABLE node: DeclarationNode, MUTABLE mutable_flag: Bool) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE value = (MATCH node START DeclarationNode.VarDecl AS item -> item.value, DeclarationNode.BindExpr AS item -> item.value END);
    typeAnalysisSession__verify_unrestricted_mut(rtoc_self_view, castDeclarationNodeToNode(node));
    typeAnalysisSession__handle_assign_move(rtoc_self_view, castDeclarationNodeToNode(node));
    typeAnalysisSession__handle_assign_borrow(rtoc_self_view, castDeclarationNodeToNode(node));
    MUTABLE declared_type: ?Type = NIL;
    MATCH node START
      DeclarationNode.VarDecl AS item ->
        declared_type = COPY item.type;,
      DeclarationNode.BindExpr AS item ->
        declared_type = COPY item.type;,
    END
    IF declared_type EXISTS AS declared_type_value THEN
