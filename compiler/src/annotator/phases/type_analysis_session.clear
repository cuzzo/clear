    END
    END
    MUTABLE lifetime_paths = COPY typeAnalysisSession__current_fn_ctx_mut(&rtoc_self_view).lifetime;
    MUTABLE type_info: ?Type = locatable__type_object(node);
    MUTABLE has_lifetime = !((lifetime_paths.length() == 0));
    MUTABLE schema_resolver = %(t: String@symbol) USE(MUTABLE rtoc_self_view) -> TRY (typeAnalysisSession__schema_lookup_result(&rtoc_self_view, t));
    MUTABLE is_copyable = (IF type_info != NIL THEN
      (type__copyable?(type_info, schema_resolver) OR TRY (type__implicitly_copyable?(type_info, schema_resolver)))
    ELSE
      FALSE
    END);
    MUTABLE is_type_param = TRY (typeAnalysisSession__current_function_type_param?(&rtoc_self_view, (IF type_info != NIL THEN
      type__resolved(type_info)
    ELSE
      NIL
    END)));
    IF !(((has_lifetime OR is_copyable) OR is_type_param)) THEN
      TRY (typeAnalysisSession__emit_return_borrowed_no_copy_error_mut(&rtoc_self_view, &node));
    END
    IF !(has_lifetime) THEN
      RETURN TRUE;
    END
    MUTABLE is_wildcard = ((lifetime_paths.length() == 1) AND (lifetime_paths[0] == FunctionContextLifetimeSource{ SymbolValue: :wildcard }));
    IF is_wildcard THEN
      RETURN TRUE;
    END
    IF node IS_A Identifier AS identifier THEN
      RETURN TRUE;
    END
    MUTABLE actual_path = TRY (typeAnalysisSession__get_path_to_root(&rtoc_self_view, castLocatableToNode__type_analysis_session(node)));
    IF (actual_path.length() == 0) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY node }, TypeAnalysisCodeOrMessage{ SymbolValue: :RETURN_LIFETIME_NOT_ASSOCIATED }, [], CAST({:sources: lifetime_paths.join(", ")} AS {String@symbol}Any)));
      RETURN TRUE;
    END
    MUTABLE matched = lifetime_paths |> ANY {
    MUTABLE lifetime_syms = (CAST(_ AS String)).split(".") |> SELECT symbol(_);
    (actual_path.substr(0, (lifetime_syms.length() - 0)) == lifetime_syms)
    };
    IF !(matched) THEN
      MUTABLE sources_msg: String = "";
      IF (lifetime_paths.length() == 1) THEN
        sources_msg = "derived from: ${castOptionalFunctionContextLifetimeSourceToString(lifetime_paths.first())}";
      ELSE
        sources_msg = "derived from one of: ${lifetime_paths.join(" | ")}";
      END
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY node }, TypeAnalysisCodeOrMessage{ SymbolValue: :RETURN_LIFETIME_MISMATCH }, [], CAST({:sources_msg: sources_msg, :actual: actual_path.join(".")} AS {String@symbol}Any)));
    END
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__return_is_borrow?(MUTABLE self: TypeAnalysisSession, node: Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE plan: ?TenseOperationPlan = CAST(locatable__tense_plan(node) AS ?TenseOperationPlan);
    IF plan EXISTS AS plan_value THEN
      IF tenseOperationPlan__owns_result?(plan_value) THEN
      RETURN FALSE;
    END
    END
    IF (node IS_A FuncCall OR node IS_A MethodCall) THEN
      RETURN TRY (typeAnalysisSession__call_returns_borrowed_view?(&rtoc_self_view, castLocatableToCallNode__type_analysis_session(node)));
    END
    IF node IS_A Identifier AS identifier THEN
      MUTABLE rtoc_graph_4905 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
      IF !(((ownershipGraph__get_index(rtoc_graph_4905, identifier__name(identifier)) != NIL) AND (((ownershipGraph__get_index(rtoc_graph_4905, identifier__name(identifier)))?).kind == :borrowed))) THEN
        RETURN FALSE;
      END
      MUTABLE scope: ?Scope@multiowned = TRY (typeAnalysisSession__lookup_scope_for(&rtoc_self_view, identifier__name(identifier)));
      MUTABLE reg: ?SymbolEntryRegInput = NIL;
      IF (IF scope != NIL THEN
        scope__resolve_entry(scope, identifier__name(identifier))
      ELSE
        NIL
      END) != NIL THEN
        reg = UNWRAP (COPY (((IF scope != NIL THEN
        scope__resolve_entry(scope, identifier__name(identifier))
      ELSE
        NIL
      END)))).reg;
      END
      RETURN !(!(((TRUE AND (aST__node__container_borrow(castSymbolEntryRegInputToLocatable(UNWRAP (reg))) == TRUE)))));
    END
    IF node IS_A GetIndex AS get_index THEN
      RETURN TRUE;
    END
    IF node IS_A GetField AS get_field THEN
      RETURN TRUE;
    END
    RETURN FALSE;
}
END
PRIVATE FN typeAnalysisSession__paths_overlap?(MUTABLE self: TypeAnalysisSession, path_a: []String@symbol, path_b: []String@symbol) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (path_a.first() != path_b.first()) THEN
      RETURN FALSE;
    END
    MUTABLE len = min(path_a.length(), path_b.length());
    RETURN (path_a[0..<len] == path_b[0..<len]);
}
END
PRIVATE FN typeAnalysisSession__reject_arg_type_matches?(MUTABLE self: TypeAnalysisSession, MUTABLE arg: Locatable, kind: String@symbol) RETURNS !Bool
  REQUIRES self: LOCAL
