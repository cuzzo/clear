PRIVATE FN typeAnalysisSession__visit_FunctionDef(MUTABLE self: TypeAnalysisSession, MUTABLE node: FunctionDef) RETURNS !?FunctionContext@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__effects_begin_function(rtoc_self_view, node.name);
    MUTABLE is_implicit_return = functionDef__implicit_return_type?(node);
    node.type_params = typeAnalysisSession__infer_implicit_type_params(rtoc_self_view, node);
    MUTABLE declared_return = functionDef__annotation_return_type(node);
    MUTABLE lifetime_paths = typeAnalysisSession__get_lifetime_paths(rtoc_self_view, node);
    MUTABLE fn_type_params = node.type_params |> SELECT symbol(_);
    MUTABLE fn_ctx = TRY (functionContext__new(node.name, functionDef__annotation_return_type(node), lifetime_paths, fn_type_params, node.generic_params));
    typeAnalysisSession__push_function_context_mut(rtoc_self_view, fn_ctx);
    DEFER typeAnalysisSession__pop_function_context_mut(rtoc_self_view);
    typeAnalysisSession__verify_lifetime_mut(rtoc_self_view, node);
    IF type__any?(fn_type_params) THEN
