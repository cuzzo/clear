PRIVATE FN typeAnalysisSession__match_payload_binding_type(MUTABLE self: TypeAnalysisSession, plan: MatchSubjectPlan, variant_name: String, raw_payload: ?MatchPayload, MUTABLE match_case: MatchCase) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE payload = COPY UNWRAP (raw_payload);
    IF payload IS_A InlineStructVariant AS inline_struct_variant THEN
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("${plan.type_name}_${variant_name}") }));
    END
    IF (IF payload IS_A Type AS type THEN type__indirect?(type) ELSE FALSE END) THEN
      MUTABLE inner_type = COPY payload;
      matchPayload__strip_layout_mut(&inner_type);
      match_case.indirect_payload_as = TRUE;
      RETURN CAST(TRY (typeAnalysisSession__apply_type_subst(&rtoc_self_view, castMatchPayloadToTypeTypeInput(inner_type), castMapStringToMapGenericBinding(plan.union_subst))) AS Type);
    END
    RETURN CAST(TRY (typeAnalysisSession__apply_type_subst(&rtoc_self_view, castMatchPayloadToTypeTypeInput(payload), castMapStringToMapGenericBinding(plan.union_subst))) AS Type);
}
END
