PRIVATE FN typeAnalysisSession__concrete_function_call_type_for(MUTABLE self: TypeAnalysisSession, MUTABLE node: Locatable) RETURNS !?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node IS_A FuncCall AS func_call THEN
      MUTABLE entry: ?SymbolEntry@multiowned = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_261 = typeAnalysisSession__semantic_root_scope(&rtoc_self_view);
      scope__resolve_entry(rtoc_local_receiver_261, UNWRAP (castCallNameToString(funcCall__name(func_call)))) };
      MUTABLE signature: ?FunctionSignature@multiowned = functionSignature__unwrap(ruby_wrap_optional_Type_multiowned_X__type_analysis_session((IF entry != NIL THEN
        symbolEntry__type(entry)
      ELSE
        NIL
      END)));
      IF signature EXISTS AS signature_value THEN
        MUTABLE return_type = functionSignature__return_type(signature_value);
        IF typeAnalysisSession__stale_auto_node_type?(&rtoc_self_view, CAST(return_type AS Type)) THEN
          RETURN NIL;
        END
        RETURN TRY (type__new(TypeConstructionInput{ Type: COPY return_type }));
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__restamp_binary_type_after_auto_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node IS_A BinaryOp AS binary_op THEN
      MUTABLE binary_op_mutable = COPY binary_op;
      MUTABLE left_type = TRY (typeAnalysisSession__auto_finalization_node_type(&rtoc_self_view, &binary_op_mutable.left));
      MUTABLE right_type = TRY (typeAnalysisSession__auto_finalization_node_type(&rtoc_self_view, &binary_op_mutable.right));
      IF (typeAnalysisSession__stale_auto_node_type?(&rtoc_self_view, CAST(left_type AS Type)) OR typeAnalysisSession__stale_auto_node_type?(&rtoc_self_view, CAST(right_type AS Type))) THEN
        RETURN FALSE;
      END
      MUTABLE result = TRY (type__binary_op(binary_op_mutable.op, CAST(left_type AS Type), CAST(right_type AS Type)));
      IF result.error EXISTS AS error_value THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ BinaryOp: COPY binary_op_mutable } }, TypeAnalysisCodeOrMessage{ SymbolValue: :TYPE_ERROR_GENERIC }, [], CAST({:detail: error_value} AS {String@symbol}Any)));
      END
      MUTABLE result_type: Type = COPY (UNWRAP (result.type));
      IF typeAnalysisSession__stale_auto_node_type?(&rtoc_self_view, result_type) THEN
        RETURN FALSE;
      END
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY binary_op_mutable }, TRY (type__new(castTypeToTypeConstructionInput__type_analysis_session(result_type)))));
      RETURN TRUE;
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__concrete_program_type_for(MUTABLE self: TypeAnalysisSession, MUTABLE node: Locatable) RETURNS !?Type
