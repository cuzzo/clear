PRIVATE FN typeAnalysisSession__consume_match_subject_if_takes_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MatchStatement, plan: MatchSubjectPlan) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE expr = COPY node.expr;
    IF !((((node.takes OR_ELSE FALSE) AND matchSubjectPlan__union?(plan)) AND expr IS_A Identifier)) THEN
      RETURN;
    END
    MUTABLE source_name: ?String = locatable__name(expr);
    MUTABLE rtoc_graph_13664 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
    MUTABLE graph_node: ?OwnershipNode = COPY ownershipGraph__get_index(rtoc_graph_13664, UNWRAP (source_name));
    IF graph_node EXISTS AS graph_node_value THEN
      IF (graph_node_value.kind != :borrowed) THEN
        locatable__set_was_moved_mut(&expr, TRUE);
        TRY (typeAnalysisSession__og_set_moved(&rtoc_self_view, UNWRAP (source_name), locatable__token(expr), :takes));
      ELSE
        RETURN;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__analyze_match_case_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MatchStatement, MUTABLE match_case: MatchCase, plan: MatchSubjectPlan) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (match_case.kind == :when) THEN
      TRY (typeAnalysisSession__analyze_when_match_case_mut(&rtoc_self_view, &node, match_case));
    ELSE_IF (match_case.kind == :struct_pattern) THEN
      MUTABLE pattern = COPY match_case.value;
      IF pattern IS_A StructPattern AS MUTABLE pattern_narrowed THEN
        TRY (typeAnalysisSession__annotate_struct_pattern_mut(&rtoc_self_view, node, &pattern_narrowed));
      END
    ELSE
      TRY (typeAnalysisSession__analyze_value_match_case_mut(&rtoc_self_view, &node, &match_case, plan));
    END
}
END
PRIVATE FN typeAnalysisSession__analyze_when_match_case_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MatchStatement, match_case: MatchCase) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, match_case.value));
    IF (locatable__resolved_type(match_case.value) == :Bool) THEN
      RETURN;
    END
    TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ MatchStatement: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :WHEN_NEEDS_BOOL }, [], CAST({:got: locatable__resolved_type(match_case.value)} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__analyze_value_match_case_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MatchStatement, MUTABLE match_case: MatchCase, plan: MatchSubjectPlan) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit_match_patterns_mut(&rtoc_self_view, &node, match_case));
    TRY (typeAnalysisSession__validate_match_pattern_types_mut(&rtoc_self_view, &node, match_case, plan));
    TRY (typeAnalysisSession__declare_match_payload_binding_mut(&rtoc_self_view, &node, &match_case, plan));
    TRY (typeAnalysisSession__declare_match_destructure_bindings_mut(&rtoc_self_view, &node, match_case, plan));
}
END
PRIVATE FN typeAnalysisSession__visit_match_patterns_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MatchStatement, match_case: MatchCase) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__with_match_pattern_context(&rtoc_self_view, %() USE(match_case, node, MUTABLE rtoc_self_view) -> {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, match_case.value));
    FOR _ IN match_case.extra_values DO
    IF _ IS_A StructPattern AS struct_pattern THEN
        MUTABLE struct_pattern_mutable = COPY struct_pattern;
        TRY (typeAnalysisSession__annotate_struct_pattern_mut(&rtoc_self_view, node, &struct_pattern_mutable));
    ELSE
        TRY (typeAnalysisSession__visit(&rtoc_self_view, _));
    END
    END
    NIL
    });
}
END
PRIVATE FN typeAnalysisSession__validate_match_pattern_types_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MatchStatement, match_case: MatchCase, plan: MatchSubjectPlan) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_each_items_331 = ([match_case.value] + (match_case.extra_values));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_331.length() DO
      IF TRY (typeAnalysisSession__match_pattern_type_matches_subject?(&rtoc_self_view, &rtoc_each_items_331[rtoc_idx], &node, plan)) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ MatchStatement: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :MATCH_CASE_TYPE_MISMATCH }, [], CAST({:case: locatable__resolved_type(rtoc_each_items_331[rtoc_idx]), :expr: locatable__resolved_type(UNWRAP (locatable__expr(Locatable{ MatchStatement: COPY node })))} AS {String@symbol}Any)));
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PRIVATE FN typeAnalysisSession__match_pattern_type_matches_subject?(MUTABLE self: TypeAnalysisSession, MUTABLE pattern: Locatable, MUTABLE node: MatchStatement, plan: MatchSubjectPlan) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE case_type = TRY (type__new(TypeConstructionInput{ Type: COPY TRY (aST__full_type_mut(pattern)) }));
    IF (locatable__resolved_type(pattern) == locatable__resolved_type(UNWRAP (locatable__expr( Locatable{ MatchStatement: COPY node })))) THEN
      RETURN TRUE;
    END
    IF ((locatable__resolved_type(node.expr) == :Any) OR (locatable__resolved_type(pattern) == :Any)) THEN
      RETURN TRUE;
    END
    IF (type__generic_instance?(plan.expr_type) AND (type__generic_base(plan.expr_type) == locatable__resolved_type(pattern))) THEN
      RETURN TRUE;
    END
    IF (type__optional?(plan.expr_type) AND TRY (type__accepts?(UNWRAP (TRY (type__wrapped_type(plan.expr_type))), case_type))) THEN
      RETURN TRUE;
    END
    IF (TRY (type__string?(plan.expr_type)) AND TRY (type__string?(case_type))) THEN
      RETURN TRUE;
    END
    RETURN FALSE;
}
END
PRIVATE FN typeAnalysisSession__declare_match_payload_binding_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MatchStatement, MUTABLE match_case: MatchCase, plan: MatchSubjectPlan) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE binding: ?String = COPY match_case.binding;
    IF binding EXISTS AS binding_value THEN
      IF matchSubjectPlan__enum?(plan) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ MatchStatement: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :MATCH_ENUM_CAPTURE }, [], CAST({:binding: binding_value} AS {String@symbol}Any)));
        RETURN;
      END
      IF !(matchSubjectPlan__union?(plan)) THEN
        RETURN;
      END
      MUTABLE union_schema = typeAnalysisSession__match_union_schema(&rtoc_self_view, plan);
      MUTABLE variant_name: ?String = typeAnalysisSession__match_variant_name(&rtoc_self_view, match_case.value);
      TRY (typeAnalysisSession__verify_match_multi_arm_payloads_mut(&rtoc_self_view, &node, match_case, union_schema, variant_name, plan.union_subst, "AS", binding_value));
      IF variant_name EXISTS AS variant_name_value THEN
        TRY (typeAnalysisSession__declare_union_payload_binding_mut(&rtoc_self_view, &node, &match_case, plan, variant_name_value, binding_value));
      ELSE
        RETURN;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__declare_union_payload_binding_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MatchStatement, MUTABLE match_case: MatchCase, plan: MatchSubjectPlan, variant_name: String, binding: String) RETURNS !Void
  REQUIRES self: LOCAL
