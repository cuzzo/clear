PRIVATE FN typeAnalysisSession__generic_binding_source(MUTABLE self: TypeAnalysisSession, type: GenericBinding) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE t = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_192: ?GenericBinding = NIL;
    IF type IS_A Type THEN
      rtoc_ternary_value_192 = COPY type;
    ELSE
      rtoc_ternary_value_192 = GenericBinding{ Type: COPY TRY (type__new(castGenericBindingToTypeConstructionInput(type))) };
    END
    rtoc_ternary_value_192? };
    MUTABLE parts = [CAST(genericBinding__resolved(t) AS String)];
    MUTABLE ownership: ?String = genericBinding__ownership_surface_name(t);
    MUTABLE sync: ?String = genericBinding__sync_surface_name(t);
    IF ownership THEN
      &parts.append(ownership);
    END
    IF sync THEN
      &parts.append(sync);
    END
    IF (genericBinding__indirect?(t) OR_ELSE FALSE) THEN
      &parts.append("@boxed");
    END
    RETURN parts.join("");
}
END
PRIVATE FN typeAnalysisSession__shared_call_capability_display(MUTABLE self: TypeAnalysisSession, type: Type) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE caps = ["@shared"];
    IF type__indirect?(type) THEN
      &caps.append("indirect");
    END
    &caps.append(UNWRAP (type__sync_family_name(type)));
    RETURN (caps |> WHERE TRUE).join(":");
}
END
PRIVATE FN typeAnalysisSession__substitute_type_params(MUTABLE self: TypeAnalysisSession, signature: FunctionSignature, subst: {String@symbol}GenericBinding) RETURNS !FunctionSignature@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_sig_params = TRY (functionSignature__params(signature));
    MUTABLE rtoc_new_params: []Param = List[];
    MUTABLE rtoc_p_i = 0;
    WHILE rtoc_p_i < rtoc_sig_params.length() DO
      MUTABLE np: Param = COPY UNWRAP (rtoc_sig_params[rtoc_p_i]);
      np.type = TRY (typeAnalysisSession__apply_type_subst(&rtoc_self_view, TypeTypeInput{ Type: COPY np.type }, subst));
      &rtoc_new_params.append(np);
      rtoc_p_i = rtoc_p_i + 1;
    END
    RETURN TRY (functionSignature__new(rtoc_new_params,  TypeTypeInput{ Type: COPY TRY (typeAnalysisSession__apply_type_subst(&rtoc_self_view, TypeTypeInput{ Type: COPY functionSignature__return_type(signature) }, subst)) }, FunctionSignatureLifetimeInput{ ArrayValue: COPY TRY (functionSignature__return_lifetime(signature)) }, functionSignature__visibility(signature), ( { MUTABLE rtoc_empty_list_193: []String@symbol = List[]; rtoc_empty_list_193 } ), {}, FALSE, FALSE, NIL, NIL, NIL, ( { MUTABLE rtoc_empty_list_194: []String@symbol = List[]; rtoc_empty_list_194 } ), NIL, ( { MUTABLE rtoc_empty_list_195: []String@symbol = List[]; rtoc_empty_list_195 } )));
}
END
PRIVATE FN typeAnalysisSession__validate_stream_type_mut(MUTABLE self: TypeAnalysisSession, node: DeclarationNode) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !((MATCH node START DeclarationNode.VarDecl AS item -> type__future?( UNWRAP (item.type)), DeclarationNode.BindExpr AS item -> type__future?( UNWRAP (item.type)) END)) THEN
      RETURN;
    END
    IF (MATCH node START DeclarationNode.VarDecl AS item -> type__multiowned?(UNWRAP (item.type)), DeclarationNode.BindExpr AS item -> type__multiowned?(UNWRAP (item.type)) END) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castDeclarationNodeToLocatable(node)), TypeAnalysisCodeOrMessage{ SymbolValue: :RC_PROMISE_NEEDS_SHARED }));
    END
    IF ((MATCH node START DeclarationNode.VarDecl AS item -> type__split?(UNWRAP (item.type)), DeclarationNode.BindExpr AS item -> type__split?(UNWRAP (item.type)) END) AND !((MATCH node START DeclarationNode.VarDecl AS item -> TRY (type__split_open_stream?(UNWRAP (item.type))), DeclarationNode.BindExpr AS item -> TRY (type__split_open_stream?(UNWRAP (item.type))) END))) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castDeclarationNodeToLocatable(node)), TypeAnalysisCodeOrMessage{ SymbolValue: :ATSPLIT_NEEDS_OPEN_STREAM }));
    END
}
END
PRIVATE FN typeAnalysisSession__propagate_declared_type_to_value_mut(MUTABLE self: TypeAnalysisSession, node: DeclarationNode, final_type: AnnotationTypeShape) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE value_type: ?TypeConstructionInput = NIL;
    IF !(declarationNode__type(node)) THEN
      RETURN;
    END
    MUTABLE final_type_info = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_197: ?AnnotationTypeShape = NIL;
    IF final_type IS_A Type THEN
      rtoc_ternary_value_197 = COPY final_type;
    ELSE
      rtoc_ternary_value_197 = AnnotationTypeShape{ Type: COPY UNWRAP (castTypeConstructionInputToType(TRY (type__new(TypeConstructionInput{ Type: COPY castAnnotationTypeShapeToTypeConstructionInput(final_type) }))))};
    END
    rtoc_ternary_value_197? };
    IF ((MATCH node START DeclarationNode.VarDecl AS item -> item.value IS_A BgStreamBlock, DeclarationNode.BindExpr AS item -> item.value IS_A BgStreamBlock END) AND (MATCH node START DeclarationNode.VarDecl AS item -> TRY (type__inf_stream?(UNWRAP (item.type))), DeclarationNode.BindExpr AS item -> TRY (type__inf_stream?(UNWRAP (item.type))) END)) THEN
      MUTABLE stream: ?Locatable = NIL;
      MATCH node START
        DeclarationNode.VarDecl AS item ->
          stream = COPY item.value;,
        DeclarationNode.BindExpr AS item ->
          stream = COPY item.value;,
      END
      IF TRY (typeAnalysisSession__stream_body_contains_close?(&rtoc_self_view, UNWRAP (locatable__body(UNWRAP (stream))))) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ BgStreamBlock: COPY UNWRAP (castLocatableToBgStreamBlock(UNWRAP (stream)))} }, TypeAnalysisCodeOrMessage{ SymbolValue: :INFINITE_STREAM_CLOSE }));
      END
      IF TRY (typeAnalysisSession__stream_body_may_fall_through?(&rtoc_self_view, UNWRAP (locatable__body(UNWRAP (stream))))) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ BgStreamBlock: COPY UNWRAP (castLocatableToBgStreamBlock(UNWRAP (stream)))} }, TypeAnalysisCodeOrMessage{ SymbolValue: :INFINITE_STREAM_FALLTHROUGH }));
      END
    END
    IF ((MATCH node START DeclarationNode.VarDecl AS item -> item.value IS_A BgStreamBlock, DeclarationNode.BindExpr AS item -> item.value IS_A BgStreamBlock END) AND (MATCH node START DeclarationNode.VarDecl AS item -> TRY (type__runtime_stream?(UNWRAP (item.type))), DeclarationNode.BindExpr AS item -> TRY (type__runtime_stream?(UNWRAP (item.type))) END)) THEN
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, UNWRAP (declarationNode__value(node)), final_type_info));
    END
    IF ((MATCH node START DeclarationNode.VarDecl AS item -> item.value IS_A BgStreamBlock, DeclarationNode.BindExpr AS item -> item.value IS_A BgStreamBlock END) AND (MATCH node START DeclarationNode.VarDecl AS item -> TRY (type__split_open_stream?(UNWRAP (item.type))), DeclarationNode.BindExpr AS item -> TRY (type__split_open_stream?(UNWRAP (item.type))) END)) THEN
      value_type = (MATCH node START DeclarationNode.VarDecl AS item -> TRY (aST__full_type_mut(item.value)), DeclarationNode.BindExpr AS item -> TRY (aST__full_type_mut(item.value)) END);
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, UNWRAP (declarationNode__value(node)), TRY (type__new(value_type, :split))));
    END
    IF (MATCH node START DeclarationNode.VarDecl AS item -> type__shard_count(item.type), DeclarationNode.BindExpr AS item -> type__shard_count(item.type) END) THEN
      TRY (type__copy_topology_from_mut(&final_type_info, declarationNode__type(node)));
    END
    IF ((MATCH node START DeclarationNode.VarDecl AS item -> item.value IS_A BgBlock, DeclarationNode.BindExpr AS item -> item.value IS_A BgBlock END) AND (MATCH node START DeclarationNode.VarDecl AS item -> type__shared_promise?(item.type), DeclarationNode.BindExpr AS item -> type__shared_promise?(item.type) END)) THEN
      value_type = (MATCH node START DeclarationNode.VarDecl AS item -> TRY (aST__full_type_mut(item.value)), DeclarationNode.BindExpr AS item -> TRY (aST__full_type_mut(item.value)) END);
      MUTABLE rtoc_writer_receiver_198: Void = UNWRAP (declarationNode__value(node));
      rtoc_writer_receiver_198.async_result_shape = TRY (asyncResultShape__promise(Type{ Type: COPY TRY (type__tense_type(value_type)) }, TRUE));
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, UNWRAP (declarationNode__value(node)), TRY (type__new(value_type, :shared))));
    END
}
END
PRIVATE FN typeAnalysisSession__stream_body_contains_close?(MUTABLE self: TypeAnalysisSession, body: []Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN body |> ANY (_ IS_A CloseStream OR (aST__child_bodies(_) |> ANY TRY (typeAnalysisSession__stream_body_contains_close?(&rtoc_self_view, _))));
}
END
PRIVATE FN typeAnalysisSession__stream_body_may_fall_through?(MUTABLE self: TypeAnalysisSession, body: []Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (body.length() == 0) THEN
      RETURN TRUE;
    END
    MUTABLE stmt: ?Locatable = COPY body.last();
    IF (((((stmt != NIL) AND (stmt IS_A CloseStream)) OR ((stmt != NIL) AND (stmt IS_A ReturnNode))) OR ((stmt != NIL) AND (stmt IS_A Raise))) OR ((stmt != NIL) AND (stmt IS_A DieNode))) THEN
      RETURN FALSE;
    END
    IF stmt? IS_A IfStatement AS if_statement THEN
      IF if_statement.else_branch EXISTS AS optional_value_value THEN
        IF optional_value_value.empty?() THEN
          RETURN TRUE;
        ELSE
          RETURN (typeAnalysisSession__stream_body_may_fall_through?(&rtoc_self_view, if_statement.then_branch) OR typeAnalysisSession__stream_body_may_fall_through?(&rtoc_self_view, optional_value_value));
        END
      ELSE
        RETURN TRUE;
      END
    END
    IF stmt? IS_A IfBind AS if_bind THEN
      IF ((FALSE) OR if_bind.else_branch.empty?()) THEN
        RETURN TRUE;
      END
      RETURN (typeAnalysisSession__stream_body_may_fall_through?(&rtoc_self_view, if_bind.then_branch) OR typeAnalysisSession__stream_body_may_fall_through?(&rtoc_self_view, if_bind.else_branch));
    END
    IF stmt? IS_A WhileLoop AS while_loop THEN
      MUTABLE condition = while_loop.condition;
      MUTABLE is_true = (IF condition IS_A Literal AS literal THEN literal__true_boolean?(literal) ELSE FALSE END);
      IF (is_true AND !(TRY (typeAnalysisSession__stream_body_contains_break?(&rtoc_self_view, while_loop.do_branch)))) THEN
        RETURN FALSE;
      END
    END
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__stream_body_contains_break?(MUTABLE self: TypeAnalysisSession, body: []Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN body |> ANY (IF _ IS_A BreakNode THEN TRUE ELSE (IF (aST__loop_node?(_) OR aST__call_like_boundary?(_)) THEN FALSE ELSE aST__child_bodies(_) |> ANY TRY (typeAnalysisSession__stream_body_contains_break?(&rtoc_self_view, _)) END) END);
}
END
PRIVATE FN typeAnalysisSession__propagate_collection_metadata_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: DeclarationNode, final_type: AnnotationTypeShape) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE _ = COPY final_type;
    MUTABLE decl_type: ?Type = NIL;
    MATCH node START
      DeclarationNode.VarDecl AS item ->
        decl_type = COPY item.type;,
      DeclarationNode.BindExpr AS item ->
        decl_type = COPY item.type;,
    END
    MUTABLE node_type = TRY (aST__full_type_mut( UNWRAP (castDeclarationNodeToLocatable(node))));
    MUTABLE value_type = (MATCH node START DeclarationNode.VarDecl AS item -> TRY (aST__full_type_mut(item.value)), DeclarationNode.BindExpr AS item -> TRY (aST__full_type_mut(item.value)) END);
    MUTABLE coll_src_branch_value: ?Type = NIL;
    IF type__rank?( UNWRAP (decl_type)) THEN
      coll_src_branch_value = NIL;
    ELSE_IF type__collection( UNWRAP (decl_type)) THEN
      coll_src_branch_value = COPY decl_type;
    ELSE_IF type__collection(value_type) THEN
      coll_src_branch_value = value_type;
    ELSE
      coll_src_branch_value = NIL;
    END
    MUTABLE coll_src: ?Type = coll_src_branch_value;
    IF coll_src EXISTS AS coll_src_value THEN
      MUTABLE coll_src_value_mutable = COPY coll_src_value;
      TRY (type__copy_collection_shape_from_mut(&node_type, coll_src_value_mutable));
      IF (type__pool?(coll_src_value_mutable) OR type__set_collection?(coll_src_value_mutable)) THEN
        type__mark_heap_allocated_mut(&node_type);
      END
    END
    IF ((coll_src == NIL) AND (type__soa(UNWRAP (decl_type)))) THEN
      TRY (type__mark_soa_layout_mut(&node_type));
    END
    IF decl_type EXISTS AS decl_type_value THEN
      MUTABLE decl_type_value_mutable = COPY decl_type_value;
      TRY (type__copy_declared_collection_modifiers_from_mut(&node_type, decl_type_value_mutable));
    END
}
END
