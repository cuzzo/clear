    MUTABLE dest: ?SymbolEntry@multiowned = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_379 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
    scope__resolve_entry(rtoc_local_receiver_379, (MATCH node START DeclarationNode.VarDecl AS item -> CAST(item.name AS String), DeclarationNode.BindExpr AS item -> CAST(item.name AS String) END)) };
    IF (dest != NIL) THEN
