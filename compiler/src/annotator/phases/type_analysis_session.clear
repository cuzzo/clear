PRIVATE FN typeAnalysisSession__validate_strict_io_mut(MUTABLE self: TypeAnalysisSession, test_that: TestThat, stubbed_fns: [Set]String, body_summary: BodyScanSummary) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE calls = COPY body_summary.callees;
    MUTABLE visited = Set[];
    MUTABLE queue: []String = COPY (calls |> SELECT COPY _);
    WHILE !(queue.empty?()) DO
      MUTABLE name: ?String = &queue.shift();
      IF visited.contains?(name) THEN
        CONTINUE;
      END
      &visited.insert(name);
      IF stubbed_fns.contains?(name) THEN
        CONTINUE;
      END
      IF ((["tcpRead", "tcpWrite", "accept", "connect", "readFile", "writeFile", "readLine", "readLinePrompt", "listDir", "listAll", "fileSize", "socketRead", "socketWrite", "socketClose"]) |> DISTINCT _).contains?(name) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ TestThat: COPY test_that } }, TypeAnalysisCodeOrMessage{ SymbolValue: :STRICT_TEST_NEEDS_STUB }, [], CAST({:name: name} AS {String@symbol}Any)));
        CONTINUE;
      END
      MUTABLE fn_nodes = TRY (typeAnalysisSession__function_node_map(&rtoc_self_view));
      MUTABLE fn: ?FunctionDef@multiowned = COPY fn_nodes[UNWRAP (name)];
      IF fn?.effects THEN
        MUTABLE has_io = (UNWRAP (fn).effects.contains?(:BLOCKING) OR UNWRAP (fn).effects.contains?(symbol("EXTERN")));
        IF has_io THEN
          TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ TestThat: COPY test_that } }, TypeAnalysisCodeOrMessage{ SymbolValue: :STRICT_TEST_HAS_IO_EFFECTS }, [], CAST({:name: name, :effects: ((UNWRAP ((fn)).effects OR_ELSE List[] |> SELECT COPY _)).join(", ")} AS {String@symbol}Any)));
        END
      END
      FOR _ IN (TRY (typeAnalysisSession__function_call_graph(&rtoc_self_view))[UNWRAP (name)]) DO
      &queue.append(COPY _);
      END
    END
}
END
