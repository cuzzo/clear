    Site.ProtocolRequirement AS item -> RETURN Locatable{ ProtocolRequirement: COPY item };,
    Site.ProtocolDef AS item -> RETURN Locatable{ ProtocolDef: COPY item };,
    Site.FunctionDef AS item -> RETURN Locatable{ FunctionDef: COPY item };,
