        END
      END
    ELSE_IF node.tail_call THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :REENTRANCE_TAIL_CALL_NOT_RECURSIVE }, [], {:name: node.name});
    ELSE_IF (node.reentrance_kind == :reentrant_thunk) THEN
  
    END
    MUTABLE resolved_return_type = final_return_type?;
    IF ((is_implicit_return OR (declared_return == :Any))) THEN
      node.return_type = Type{ SymbolValue: COPY resolved_return_type };
