    frame.next_place_ordinal=((frame.next_place_ordinal() + 1));
    MUTABLE body_id_base = (summary.body_id.value * body_id_stride);
    MUTABLE place_id = (body_id_base + frame.next_place_ordinal);
    &summary.local_facts.append(COPY LocalFact{ id: COPY LocalId{ value: (body_id_base + frame.next_local_ordinal) }, place_id: COPY SemanticPlaceId{ value: place_id }, name: COPY name });
    MUTABLE symbol = IF TRUE THEN
      aST__node__symbol(node)
    ELSE
      NIL
    END;
    IF symbol IS_A SymbolEntry THEN
      &symbol.adopt_semantic_place_id_mut(place_id);
    END
}
END
PRIVATE FN typeAnalysisSession__record_body_fact_node_mut(self: TypeAnalysisSession, MUTABLE node: Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE frames = typeAnalysisSession__body_fact_frames(rtoc_self_view);
    IF (frames.length() == 0) THEN
      RETURN;
    END
    MUTABLE suspend_kind: ?String@symbol = NIL;
    IF (node IS_A FuncCall OR node IS_A MethodCall) THEN
      IF typeAnalysisSession__func_call_suspends?(rtoc_self_view, castLocatableToCallLikeNode(node)) THEN
        suspend_kind = IF (IF node.matched_stdlib_def() != NIL THEN
          { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_280 = (node.matched_stdlib_def());
        TRY (functionSignature__intrinsic_suspends?(&rtoc_mutable_receiver_280)) }
        ELSE
          NIL
        END) THEN
          :io
        ELSE
          :call
        END;
      END
    END
    MUTABLE with_block_raises = (IF node IS_A WithBlock AS with_block THEN typeAnalysisSession__with_block_raises_directly?(rtoc_self_view, with_block) ELSE FALSE END);
    FOR _ IN frames DO
    MUTABLE summary = COPY _.summary;
    IF (TRUE AND !(node IS_A FunctionDef)) THEN
        &summary.escape_nodes.append(COPY node);
        IF _.track_with_scope_stack THEN
          FOR _ IN _.with_scope_stack DO
          IF summary.with_scope_nodes[aST__node_identity(_)] == NIL THEN
            summary.with_scope_nodes[aST__node_identity(_)] = List[];
          END
          (summary.with_scope_nodes[aST__node_identity(_)])?.append(node);
          END
        END
    END
    IF node IS_A Identifier AS identifier THEN
        MUTABLE lambda_node: ?LambdaLit = COPY _.lambda_body_stack.last();
        IF lambda_node EXISTS AS lambda_node_value THEN
          IF summary.lambda_body_identifier_refs[aST__node_identity(lambda_node_value)] == NIL THEN
            summary.lambda_body_identifier_refs[aST__node_identity(lambda_node_value)] = List[];
          END
          (summary.lambda_body_identifier_refs[aST__node_identity(lambda_node_value)])?.append(identifier);
        END
    END
    IF suspend_kind EXISTS AS suspend_kind_value THEN
      &summary.suspend_points.append(COPY SuspendPointFact{ id: COPY SuspendPointId{ value: summary.suspend_points.length() }, kind: symbol(UNWRAP (COPY suspend_kind)), node: COPY node });
    END
    IF node IS_A ReturnNode AS return_node THEN
        &summary.return_nodes.append(COPY return_node);
    ELSE_IF node IS_A VarDecl AS var_decl THEN
        &summary.binding_nodes.append(BindingNode{ VarDecl: COPY var_decl });
        typeAnalysisSession__record_local_binding_fact_mut(rtoc_self_view, _, BindingNode{ VarDecl: COPY var_decl }, CAST(var_decl.name AS String));
    ELSE_IF node IS_A BindExpr AS bind_expr THEN
        IF (bind_expr.mode == :assign) THEN
          &summary.assignment_nodes.append(AssignmentNode{ BindExpr: COPY bind_expr });
        ELSE
          &summary.binding_nodes.append(BindingNode{ BindExpr: COPY bind_expr });
          typeAnalysisSession__record_local_binding_fact_mut(rtoc_self_view, _, BindingNode{ BindExpr: COPY bind_expr }, CAST(bind_expr.name AS String));
        END
    ELSE_IF node IS_A Assignment AS assignment THEN
        &summary.assignment_nodes.append(AssignmentNode{ Assignment: COPY assignment });
    ELSE_IF node IS_A DestructuringAssignment AS destructuring_assignment THEN
        &summary.assignment_nodes.append(AssignmentNode{ DestructuringAssignment: COPY destructuring_assignment });
        MUTABLE rtoc_each_items_282 = destructuringAssignment__targets(destructuring_assignment);
        MUTABLE rtoc_idx = 0;
        WHILE rtoc_idx < rtoc_each_items_282.length() DO
        IF (rtoc_each_items_282[rtoc_idx]?.name == "_") THEN
          rtoc_idx = rtoc_idx + 1;
      CONTINUE;
        END
        &summary.binding_nodes.append(BindingNode{ DestructureTarget: COPY rtoc_each_items_282[rtoc_idx]? });
        typeAnalysisSession__record_local_binding_fact_mut(rtoc_self_view, _, BindingNode{ DestructureTarget: COPY rtoc_each_items_282[rtoc_idx]? }, CAST((rtoc_each_items_282[rtoc_idx]?.name) AS String));
      rtoc_idx = rtoc_idx + 1;
        END
    ELSE_IF node IS_A Identifier AS identifier THEN
        IF (identifier__name(identifier) == "snapshot") THEN
          summary.references_snapshot = TRUE;
        END
    ELSE_IF (node IS_A Raise) OR (node IS_A OrElseRaise) OR (node IS_A BgBlock) OR (node IS_A BgStreamBlock) THEN
        summary.raises_directly = TRUE;
    ELSE_IF (node IS_A UnaryOp) THEN
        IF (node.op() == :TRY) THEN
          summary.raises_directly = TRUE;
        END
    ELSE_IF node IS_A WithBlock AS with_block THEN
        IF with_block_raises THEN
          summary.raises_directly = TRUE;
        END
    ELSE_IF node IS_A NextExpr AS next_expr THEN
        &summary.suspend_points.append(COPY SuspendPointFact{ id: COPY SuspendPointId{ value: summary.suspend_points.length() }, kind: :next, node: Locatable{ NextExpr: COPY next_expr } });
    ELSE_IF node IS_A YieldExpr AS yield_expr THEN
        &summary.suspend_points.append(COPY SuspendPointFact{ id: COPY SuspendPointId{ value: summary.suspend_points.length() }, kind: :yield, node: Locatable{ YieldExpr: COPY yield_expr } });
    ELSE_IF (node IS_A FuncCall) OR (node IS_A MethodCall) THEN
        IF _.record_call_sites THEN
          _.next_call_site_ordinal=((_.next_call_site_ordinal() + 1));
          &summary.call_site_facts.append(COPY CallSiteFact{ id: COPY CallSiteId{ value: ((summary.body_id.value * body_id_stride) + _.next_call_site_ordinal) }, node: node, callee_name: COPY node.name(), args: COPY node.args(), fn_var_call: (IF node IS_A FuncCall AS func_call THEN (func_call.fn_var_call == TRUE) ELSE FALSE END), propagates_failure: !(_.failure_absorbed) });
        END
        IF (IF node IS_A FuncCall AS func_call THEN func_call.fn_var_call ELSE FALSE END) THEN
          summary.has_fnptr_call = TRUE;
          IF (!(_.failure_absorbed) AND typeAnalysisSession__fn_var_call_error_fallible?(rtoc_self_view, castLocatableToFuncCall(node))) THEN
            summary.raises_directly = TRUE;
          END
        ELSE_IF node IS_A FuncCall AS func_call THEN
          &summary.callees.insert(funcCall__name(func_call));
          IF !(_.failure_absorbed) THEN
            &summary.propagating_callees.insert(funcCall__name(func_call));
          END
          IF (!(_.failure_absorbed) AND typeAnalysisSession__resolved_call_error_fallible?(rtoc_self_view, Node{ FuncCall: COPY func_call })) THEN
            summary.raises_directly = TRUE;
          END
        ELSE_IF (!(_.failure_absorbed) AND typeAnalysisSession__resolved_call_error_fallible?(rtoc_self_view, castLocatableToNode(node))) THEN
          summary.raises_directly = TRUE;
        END
    END
    END
}
END
PRIVATE FN typeAnalysisSession__fn_var_call_error_fallible?(self: TypeAnalysisSession, MUTABLE node: FuncCall) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE sig: ?FunctionSignature@multiowned = functionSignature__unwrap(ruby_wrap_optional_FunctionSignature_multiowned_X(KEEP node.matched_signature));
    IF type__error_union?((IF sig != NIL THEN
      functionSignature__return_type(sig)
    ELSE
      NIL
    END)) THEN
      RETURN TRUE;
    END
    RETURN type__error_union?((&node.full_type_mut("function pointer call")));
}
CATCH Transient, Input, System, NotFound, Permission, Canceled
  RETURN FALSE;
END
PRIVATE FN typeAnalysisSession__resolved_call_error_fallible?(self: TypeAnalysisSession, MUTABLE node: Node) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (respondsTo?(node, "error_union_type") AND node.error_union_type()) THEN
      RETURN TRUE;
    END
    MUTABLE signature: ?FunctionSignature@multiowned = functionSignature__unwrap(node.matched_signature());
    IF type__error_union?((IF signature != NIL THEN
      functionSignature__return_type(signature)
    ELSE
      NIL
    END)) THEN
      RETURN TRUE;
    END
    MUTABLE intrinsic = node.matched_stdlib_def();
    IF (IF intrinsic != NIL THEN
      functionSignature__recoverable_result?(intrinsic)
    ELSE
      NIL
    END) THEN
      RETURN TRUE;
    END
    RETURN (&node.full_type_mut("fallible call analysis")).error_union?();
}
CATCH Transient, Input, System, NotFound, Permission, Canceled
  RETURN FALSE;
END
PRIVATE FN typeAnalysisSession__with_block_raises_directly?(self: TypeAnalysisSession, node: WithBlock) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (node.snapshot_mode == :transaction) THEN
      RETURN TRUE;
    END
    MUTABLE clause = node.lock_error_clause;
    IF !(clause) THEN
      RETURN FALSE;
    END
    RETURN (([ErrorActionKind.Raise, ErrorActionKind.Exit]).contains?(clause.action()) OR !(clause.bubble_types().empty?()));
}
END
PRIVATE FN typeAnalysisSession__analyze_program_bodies_mut(MUTABLE self: TypeAnalysisSession, declarations: DeclarationIndex, program: Program) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN declarations.body_statements DO
    TRY (typeAnalysisSession__visit(&rtoc_self_view, _));
    END
    FOR _ IN (TRY (typeAnalysisSession__synthetic_function_definitions(rtoc_self_view))) DO
    MUTABLE rtoc_mutable_block_param_283 = COPY _;
    typeAnalysisSession__visit_FunctionDef(&rtoc_self_view, &rtoc_mutable_block_param_283);
    &program.statements.append(COPY rtoc_mutable_block_param_283);
    END
}
END
PRIVATE FN typeAnalysisSession__validate_conformances_mut(self: TypeAnalysisSession, resolutions: []ConformanceResolution) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < resolutions.length() DO
      MUTABLE failures = ((resolutions[rtoc_idx]?.protocol).requirements) |> SELECT:? {
        MUTABLE member: ?FunctionDef@multiowned = COPY (resolutions[rtoc_idx]?.members)[_.name];
        (  IF (member == NIL) THEN
            "${_.name}: missing"
          ELSE
            typeAnalysisSession__conformance_requirement_mismatch(rtoc_self_view, _, CAST(COPY member AS FunctionDef), resolutions[rtoc_idx]?)
          END)
      } |> WHERE _ != NIL;
      MUTABLE extras = ((resolutions[rtoc_idx]?.members).keys() - (((resolutions[rtoc_idx]?.protocol).requirements) |> SELECT _.name));
      &failures.concat(extras |> SELECT "${_}: not declared by ${(resolutions[rtoc_idx]?.protocol).name}");
      IF (failures.length() == 0) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      typeAnalysisSession__error_mut(rtoc_self_view, resolutions[rtoc_idx]?.declaration, TypeAnalysisCodeOrMessage{ SymbolValue: :CONFORMANCE_REQUIREMENTS }, [], {:protocol: (resolutions[rtoc_idx]?.protocol).name, :owner: resolutions[rtoc_idx]?.owner_name, :count: failures.length(), :details: (failures |> SELECT "\n  - ${_}").join("")});
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PRIVATE FN typeAnalysisSession__conformance_requirement_mismatch(self: TypeAnalysisSession, requirement: ProtocolRequirement, member: FunctionDef, resolution: ConformanceResolution) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (requirement.is_method != member.is_method) THEN
      MUTABLE expected_kind: String = "";
      IF requirement.is_method THEN
        expected_kind = "METHOD";
      ELSE
        expected_kind = "FN";
      END
      MUTABLE actual_kind: String = "";
      IF member.is_method THEN
        actual_kind = "METHOD";
      ELSE
        actual_kind = "FN";
      END
      RETURN "${requirement.name}: expected ${expected_kind}, found ${actual_kind}";
    END
    IF (requirement.params.length() != member.params.length()) THEN
      RETURN "${requirement.name}: expected ${requirement.params.length()} parameter(s), found ${member.params.length()}";
    END
    MUTABLE substitutions: {String@symbol}GenericBinding = {:Self: resolution.declaration.owner_type}.keys() |> REDUCE(COPY resolution.associated_types) { acc[_] = COPY ({:Self: resolution.declaration.owner_type}[_] OR_ELSE panic("missing hash key")); acc };
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < requirement.params.length() DO
      MUTABLE actual = COPY UNWRAP (member.params[rtoc_idx]);
      MUTABLE expected_type = typeAnalysisSession__apply_type_subst(rtoc_self_view, castTypeToTypeTypeInput(requirement.params[rtoc_idx]?.type), substitutions);
      IF (((type__semantic_type_key(expected_type) != type__semantic_type_key(actual.type)) OR (requirement.params[rtoc_idx]?.mutable != actual.mutable)) OR (requirement.params[rtoc_idx]?.takes != actual.takes)) THEN
          RETURN "${requirement.name}: parameter ${(rtoc_idx + 1)} is incompatible";
      END
    rtoc_idx = rtoc_idx + 1;
    END
    MUTABLE expected_return = typeAnalysisSession__apply_type_subst(rtoc_self_view, castTypeToTypeTypeInput(requirement.return_type), substitutions);
    MUTABLE actual_return = (member.return_type OR_ELSE TRY (type__new(TypeConstructionInput{ SymbolValue: :Void })));
    IF !((type__semantic_type_key(expected_return) == type__semantic_type_key(actual_return))) THEN
      RETURN "${requirement.name}: expected RETURNS ${TRY (type__surface_name(TypeTypeInput{ Type: COPY expected_return }))}, found ${TRY (type__surface_name(castTypeToTypeTypeInput(actual_return)))}";
    END
    MUTABLE actual_effect = (member.reentrance_kind OR member.effects_decl);
    IF typeAnalysisSession__protocol_effect_accepts?(rtoc_self_view, requirement.effects_decl, actual_effect) THEN
      RETURN NIL;
    END
    MUTABLE expected: String = "";
    IF requirement.effects_decl EXISTS AS effects_decl_value THEN
      expected = typeAnalysisSession__protocol_effect_name(rtoc_self_view, effects_decl_value);
    ELSE
      expected = "no reentrant effect";
    END
    MUTABLE found: String = "";
    IF actual_effect THEN
      found = typeAnalysisSession__protocol_effect_name(rtoc_self_view, actual_effect);
    ELSE
      found = "no reentrant effect";
    END
    RETURN "${requirement.name}: expected ${expected}, found ${found}";
}
END
PRIVATE FN typeAnalysisSession__protocol_effect_accepts?(self: TypeAnalysisSession, required: ?String@symbol, actual: ?String@symbol) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ((required == :reentrant) OR (IF (required == NIL) THEN
      (actual == NIL)
    ELSE
      ((actual == NIL) OR (actual? == required))
    END));
}
END
PRIVATE FN typeAnalysisSession__protocol_effect_name(self: TypeAnalysisSession, effect: String@symbol) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE suffix = COPY ((CAST({:reentrant: "", :reentrant_thunk: ":THUNK", :reentrant_tail_call: ":TAIL_CALL", :reentrant_not_logical: ":NOT_LOGICAL", :reentrant_max_depth: ":MAX_DEPTH"} AS {String@symbol}String))[effect] OR_ELSE ":${(CAST(effect AS String)).upcase()}");
    RETURN "EFFECTS REENTRANT${suffix}";
}
END
