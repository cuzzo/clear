    RETURN ((typeAnalysisSession__function_has_pre_clauses?(&rtoc_self_view, node) OR typeAnalysisSession__function_has_catch_clauses?(&rtoc_self_view, node)) OR typeAnalysisSession__function_has_default_catch?(&rtoc_self_view, node));
}
END
PRIVATE FN typeAnalysisSession__run_auto_inference_mut(MUTABLE self: TypeAnalysisSession, program_node: Program) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = TRY (typeAnalysisSession__function_node_map(&rtoc_self_view));
    MUTABLE collector = autoConstraintCollector__new(fn_nodes);
    MUTABLE slots = TRY (autoConstraintCollector__collect_mut(&collector, program_node));
    IF (slots.length() == 0) THEN
      RETURN;
    END
    MUTABLE rtoc_local_receiver_15 = shapeEvidenceCollector__new(slots, fn_nodes);
    TRY (shapeEvidenceCollector__collect_mut(&rtoc_local_receiver_15));
    MUTABLE op_evidence = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_16 = operatorEvidenceCollector__new(slots, fn_nodes);
    TRY (operatorEvidenceCollector__collect_mut(&rtoc_local_receiver_16)) };
    MUTABLE unifier = autoUnifier__new(slots);
    MUTABLE result = TRY (autoUnifier__resolve_mut(&unifier));
    TRY (autoUnifier__stamp_map_pairs_mut(&unifier, result.resolved));
    TRY (typeAnalysisSession__apply_auto_resolution_stamps_mut(&rtoc_self_view, program_node, result.resolved));
    FOR _ IN result.resolved.values() DO
    TRY (typeAnalysisSession__emit_auto_resolved_finding_mut(&rtoc_self_view, _));
    END
    TRY (typeAnalysisSession__emit_auto_shape_resolved_findings_mut(&rtoc_self_view, result.resolved));
    FOR _ IN result.ambiguous.values() DO
    TRY (typeAnalysisSession__emit_auto_ambiguity_finding_mut(&rtoc_self_view, _, op_evidence));
    END
    FOR _ IN result.unresolved.values() DO
    TRY (typeAnalysisSession__emit_auto_unresolved_finding_mut(&rtoc_self_view, _, op_evidence));
    END
}
END
PRIVATE FN typeAnalysisSession__emit_auto_shape_resolved_findings_mut(MUTABLE self: TypeAnalysisSession, resolved_slots: {AutoSlotId}Resolution) RETURNS !?{AutoSlotId}Resolution
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE seen: {Int64}Bool = {};
    FOR _ IN resolved_slots.values() DO
    MUTABLE slot = COPY _.slot;
    IF (slot.shape == NIL) THEN
        CONTINUE;
    END
    MUTABLE decl_key: Int64 = slotDeclIdentity(slot.decl_node);
    IF seen[decl_key] THEN
        CONTINUE;
    END
    seen[decl_key] = TRUE;
    TRY (typeAnalysisSession__emit_auto_shape_resolved_finding_mut(&rtoc_self_view, slot.decl_node, slot));
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__visit(MUTABLE self: TypeAnalysisSession, node: ?Locatable) RETURNS !Any@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node EXISTS AS node_value THEN
      MUTABLE node_value_mutable = COPY node_value;
      &rtoc_self_view.traversal_state.annotation_ancestors.append(COPY node_value_mutable);
      DEFER {
      MUTABLE popped: ?Locatable = &rtoc_self_view.traversal_state.annotation_ancestors.pop();
      IF (popped == NIL) THEN
        panic("BUG: annotation ancestor stack mismatch");
      END
      }
      MUTABLE result = PARTIAL MATCH node_value_mutable START
        AnnotationNode.StructDef -> {
          MUTABLE rtoc_value_block_marker = 0;
          MUTABLE rtoc_local_receiver_17 = TRY (typeAnalysisSession__local_resolution_session(&rtoc_self_view));
        TRY (resolutionSession__register_local_declaration_mut(&rtoc_local_receiver_17, castLocatableToNode__type_analysis_session(node_value_mutable)));
          NIL
        },
        Locatable.ExternStructDecl AS extern_struct_decl -> {
          MUTABLE rtoc_value_block_marker = 0;
          MUTABLE rtoc_local_receiver_18 = TRY (typeAnalysisSession__local_resolution_session(&rtoc_self_view));
        TRY (resolutionSession__register_local_declaration_mut(&rtoc_local_receiver_18, Node{ ExternStructDecl: COPY extern_struct_decl }));
          NIL
        },
        Locatable.EnumDef -> {
          MUTABLE rtoc_value_block_marker = 0;
          MUTABLE rtoc_local_receiver_19 = TRY (typeAnalysisSession__local_resolution_session(&rtoc_self_view));
        TRY (resolutionSession__register_local_declaration_mut(&rtoc_local_receiver_19, castLocatableToNode__type_analysis_session(node_value_mutable)));
          NIL
        },
        Locatable.UnionDef AS union_def -> {
          MUTABLE rtoc_value_block_marker = 0;
          MUTABLE rtoc_local_receiver_20 = TRY (typeAnalysisSession__local_resolution_session(&rtoc_self_view));
        TRY (resolutionSession__register_local_declaration_mut(&rtoc_local_receiver_20, Node{ UnionDef: COPY union_def }));
          NIL
        },
        Locatable.ExternFnDecl AS extern_fn_decl -> {
          MUTABLE rtoc_value_block_marker = 0;
          MUTABLE rtoc_local_receiver_21 = TRY (typeAnalysisSession__local_resolution_session(&rtoc_self_view));
        TRY (resolutionSession__register_local_declaration_mut(&rtoc_local_receiver_21, Node{ ExternFnDecl: COPY extern_fn_decl }));
          NIL
        },
        DEFAULT -> TRY (typeAnalysisSession__dispatch_visit(&rtoc_self_view, &node_value_mutable))
      END;
      TRY (typeAnalysisSession__record_body_fact_node_mut(&rtoc_self_view, &node_value_mutable));
      TRY (typeAnalysisSession__record_ownership_transport_fact_mut(&rtoc_self_view, node_value_mutable));
      RETURN result;
    ELSE
      RETURN;
    END
}
END
