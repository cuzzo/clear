    ELSE
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ MatchStatement: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :MATCH_DESTRUCTURE_FIELD_UNKNOWN }, [], CAST({:field: field.name, :variant: variant_name} AS {String@symbol}Any)));
    END
