PRIVATE FN typeAnalysisSession__apply_auto_resolution_stamps_mut(MUTABLE self: TypeAnalysisSession, program: Program, resolved_slots: {AutoSlotId}Resolution) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE touched_functions: [Set]FunctionDef@multiowned = TRY (typeAnalysisSession__restamp_auto_resolution_slots_mut(&rtoc_self_view, resolved_slots));
    FOR MUTABLE rtoc_for_elem_11220 IN touched_functions DO
    TRY (typeAnalysisSession__restamp_auto_function_signature_mut(&rtoc_self_view, &rtoc_for_elem_11220));
    END
    TRY (typeAnalysisSession__restamp_stale_auto_nodes_mut(&rtoc_self_view, program));
