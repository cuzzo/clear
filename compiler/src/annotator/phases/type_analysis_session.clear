PRIVATE FN typeAnalysisSession__stamp_observable_terminal_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node.left IS_A RangeLit THEN
      RETURN NIL;
    END
    MUTABLE ti = TRY (aST__full_type_mut(node.left));
    IF !((((TRUE) AND type__future?(ti)) AND ((((TRY (type__dynamic_stream?(ti)) OR TRY (type__inf_stream?(ti))) OR TRY (type__open_stream?(ti))) OR TRY (type__bounded_stream?(ti)))))) THEN
      RETURN NIL;
    END
    node.observable_terminal = TRUE;
    node.observable_dest = TRUE;
    IF node.left IS_A Identifier THEN
      locatable__set_was_moved_mut(&node.left, TRUE);
      TRY (typeAnalysisSession__og_set_moved(&rtoc_self_view, UNWRAP (locatable__name(node.left)), UNWRAP (locatable__token(node.left)), :takes));
    END
    RETURN TRUE;
}
END
