PRIVATE FN typeAnalysisSession__declare_snapshot_capability_mut(MUTABLE self: TypeAnalysisSession, fact: CapabilityTransition) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE alias_name = COPY fact.alias_name;
    MUTABLE inner_type = TRY (type__bare_data_type((TRY (type__new(castTypeToTypeConstructionInput__type_analysis_session(fact.resolved_type))))));
    MUTABLE rtoc_mutable_receiver_226 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
    TRY (scope__declare(&rtoc_mutable_receiver_226, alias_name, NIL, castTypeToOptionalSymbolEntryTypeInput__type_analysis_session(inner_type), ScopeMutabilityInput{ BoolValue: fact.alias_mutable }, FALSE, NIL, :stack));
    typeAnalysisSession__record_capture_local_mut(&rtoc_self_view, alias_name);
    MUTABLE sym = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_227 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
    scope__local_entry_mut(&rtoc_local_receiver_227, alias_name) };
    symbolEntry__mark_non_escaping_mut(&sym);
