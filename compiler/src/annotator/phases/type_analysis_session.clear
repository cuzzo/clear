PRIVATE FN typeAnalysisSession__handle_assign_move(self: TypeAnalysisSession, node: Node) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE plan = IF respondsTo?(node, "ownership_transport_plan") THEN
      node.ownership_transport_plan()
    ELSE
      NIL
    END;
    IF (((typeAnalysisSession__language_mode(rtoc_self_view) != :strict) AND plan IS_A OwnershipTransportPlan) AND (plan.action() != :move)) THEN
      RETURN;
    END
    IF (((typeAnalysisSession__language_mode(rtoc_self_view) != :strict) AND node.value() IS_A Identifier) AND (node.value().ownership_pending_transfer() == TRUE)) THEN
      RETURN;
    END
    IF node.value() IS_A CopyNode THEN
      RETURN;
    END
    IF ((typeAnalysisSession__language_mode(rtoc_self_view) != :strict) AND aST__borrowed_ownership_view?(node.value())) THEN
      RETURN;
    END
    typeAnalysisSession__reject_scoped_assignment_move_mut(rtoc_self_view, node);
    IF (node.value() IS_A GetField OR node.value() IS_A GetIndex) THEN
      typeAnalysisSession__handle_assignment_path_move_mut(rtoc_self_view, node);
      RETURN;
    END
    typeAnalysisSession__handle_assignment_identifier_move_mut(rtoc_self_view, node);
}
END
PRIVATE FN typeAnalysisSession__reject_scoped_assignment_move_mut(self: TypeAnalysisSession, node: Node) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((node.value() IS_A Identifier AND ((node.value().symbol() != NIL) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_478 = ((node.value().symbol())?);
    symbolEntry__non_escaping(rtoc_local_receiver_478) }))) THEN
