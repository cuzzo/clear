    END
    functionSignature__replace_return_strategy_mut(&signature, typeAnalysisSession__get_return_strategy(rtoc_self_view, TypeTypeInput{ Type: COPY functionSignature__return_type(signature) }));
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ FunctionDef: COPY node }, signature));
    MUTABLE ctx: FunctionContext@multiowned = KEEP fn_ctx;
    node.uses_frame = ((ctx.frame_count > 0));
    node.uses_heap = ((ctx.heap_count > 0));
    node.uses_alloc = ((ctx.alloc_count > 0));
    node.uses_rt = ctx.uses_rt;
    node.stack_vars_bytes = ctx.stack_vars_bytes;
    MUTABLE raises_directly = ((functionDef__reentrance_guard_required?(node) OR typeAnalysisSession__function_has_pre_clauses?(rtoc_self_view, node)) OR (raises_in_body == TRUE));
    typeAnalysisSession__record_function_body_summary_mut(rtoc_self_view, FunctionBodySummary{ name: COPY node.name, definition_id: COPY body_identity.definition_id, body_id: COPY body_identity.body_id, callees: COPY (called_names - [node.name]), propagating_callees: COPY ((unabsorbed_calls) - [node.name]), has_fnptr_call: has_fnptr, raises_directly: raises_directly, call_site_facts: COPY body_scan.call_site_facts, local_facts: COPY body_scan.local_facts, return_nodes: COPY body_scan.return_nodes, binding_nodes: COPY body_scan.binding_nodes, assignment_nodes: COPY body_scan.assignment_nodes, escape_nodes: COPY body_scan.escape_nodes, with_scope_nodes: COPY body_scan.with_scope_nodes, lambda_body_identifier_refs: COPY body_scan.lambda_body_identifier_refs, with_blocks: body_scan.with_blocks, suspend_points: COPY body_scan.suspend_points });
    IF typeAnalysisSession__runtime_error_clause?(rtoc_self_view, node) THEN
      functionContext__mark_runtime_used_mut(&fn_ctx);
    END
    IF typeAnalysisSession__function_has_catch_clauses?(rtoc_self_view, node) THEN
      MUTABLE candidate_snap_types = COPY body_scan.pipe_input_types;
      MUTABLE snap_types: [Set]String = Set[];
      MUTABLE all_catch_bodies = node.catch_clauses |> SELECT _.body();
      IF typeAnalysisSession__function_has_default_catch?(rtoc_self_view, node) THEN
        &all_catch_bodies.append(node.default_catch);
      END
      MUTABLE catch_body_scan = typeAnalysisSession__with_body_fact_frame(rtoc_self_view, bodyIdentity__unassigned(), %() USE(all_catch_bodies, candidate_snap_types, MUTABLE rtoc_self_view) -> {
    FOR _ IN (all_catch_bodies |> WHERE _ != NIL) DO
    typeAnalysisSession__with_new_scope(rtoc_self_view, %() USE(candidate_snap_types, _, MUTABLE rtoc_self_view) -> {
      MUTABLE rtoc_mutable_receiver_62 = typeAnalysisSession__current_scope(rtoc_self_view);
      TRY (scope__declare(&rtoc_mutable_receiver_62, "__error", NIL, SymbolEntryTypeInput{ SymbolValue: :ErrorContext }, ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
      IF (candidate_snap_types.size() == 1) THEN
            MUTABLE rtoc_mutable_receiver_63 = typeAnalysisSession__current_scope(rtoc_self_view);
            TRY (scope__declare(&rtoc_mutable_receiver_63, "snapshot", NIL, SymbolEntryTypeInput{ SymbolValue: COPY type__to_sym(candidate_snap_types.first()) }, ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
      END
      TRY (typeAnalysisSession__visit_stmts(&rtoc_self_view, _))
    });
    END
    rubyToClearVoid()
      });
      IF catch_body_scan.references_snapshot THEN
        snap_types.merge(candidate_snap_types);
      END
      node.snapshot_types = snap_types;
    END
