WITH POLYMORPHIC self AS rtoc_self_view {
    typeAnalysisSession__with_new_scope(rtoc_self_view, typeAnalysisSession__module_variable_scope(rtoc_self_view), %() USE(blk, node, rtoc_self_view) -> {
    typeAnalysisSession__og_push_scope(rtoc_self_view);
    DEFER typeAnalysisSession__og_pop_scope(rtoc_self_view, TRUE);
