    END
    TRY (typeAnalysisSession__analyze_loop_control_flow_branches(rtoc_self_view, [proc(%() USE(MUTABLE node, MUTABLE rtoc_self_view) -> {
    MUTABLE rtoc_mutable_receiver_346 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_346, node.var_name, NIL, SymbolEntryTypeInput{ SymbolValue: :Int64 }, ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    typeAnalysisSession__record_capture_local_mut(rtoc_self_view, CAST(node.var_name AS String));
    node.symbol = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_347 = typeAnalysisSession__current_scope(rtoc_self_view);
    scope__local_entry_mut(rtoc_local_receiver_347, node.var_name) };
    typeAnalysisSession__classify_ownership_mut(rtoc_self_view, UNWRAP (node.symbol));
    TRY (typeAnalysisSession__visit_stmts(&rtoc_self_view, node.body));
    typeAnalysisSession__finalize_scope(rtoc_self_view, Locatable{ ForRange: COPY node });
    node.deferred_drops
    })], FALSE));
    IF node.tight THEN
      typeAnalysisSession__validate_tight_body_mut(rtoc_self_view, AstScanInput{ ArrayValue: COPY node.body }, TightLoopNode{ ForRange: COPY node });
    END
    node.mark_per_iter = FALSE;
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ ForRange: COPY node }, :Void));
}
END
PRIVATE FN typeAnalysisSession__visit_ForEach(MUTABLE self: TypeAnalysisSession, MUTABLE node: ForEach) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.collection));
    MUTABLE coll_type = &node.collection.full_type_mut("FOR collection");
    MUTABLE ct_branch_value: ?Type = NIL;
    IF coll_type IS_A Type THEN
      ct_branch_value = coll_type;
    ELSE
      ct_branch_value = TRY (type__new(coll_type));
    END
    MUTABLE ct: Type = ct_branch_value?;
    MUTABLE elem_type =   IF (TRY (type__dynamic_stream?(ct)) OR ((TRY (type__bounded_stream?(ct)) AND type__canonical_stream?(ct)))) THEN
      (IF TRY (type__stream_element_type(ct)) != NIL THEN TRY (type__stream_element_type(ct)) ELSE UNWRAP (TRY (type__element_type((TRY (type__tense_type(ct)))))) END)
    ELSE_IF (type__array?(ct) OR type__list_collection?(ct)) THEN
      (TRY (type__element_type(ct)) OR_ELSE TRY (type__value_type(ct)))
    ELSE_IF type__map?(ct) THEN
      :String
    ELSE
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :FOR_IN_NEEDS_COLLECTION }, [], {:got: coll_type})
    END;
    MUTABLE elem_ti_branch_value: ?Type = NIL;
    IF elem_type IS_A Type THEN
      elem_ti_branch_value = elem_type;
    ELSE
      elem_ti_branch_value = TRY (type__new(elem_type));
    END
    MUTABLE elem_ti: Type = elem_ti_branch_value?;
    TRY (typeAnalysisSession__analyze_loop_control_flow_branches(rtoc_self_view, [proc(%() USE(elem_ti, MUTABLE node, MUTABLE rtoc_self_view) -> {
    MUTABLE rtoc_mutable_receiver_351 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_351, node.var_name, NIL, castTypeToOptionalSymbolEntryTypeInput(elem_ti), (node.is_mutable == TRUE), FALSE, NIL, :borrow));
    typeAnalysisSession__record_capture_local_mut(rtoc_self_view, CAST(node.var_name AS String));
    node.symbol = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_352 = typeAnalysisSession__current_scope(rtoc_self_view);
    scope__local_entry_mut(rtoc_local_receiver_352, node.var_name) };
    MUTABLE rtoc_mutable_receiver_353 = UNWRAP (node.symbol);
    symbolEntry__mark_borrowed_alias_mut(&rtoc_mutable_receiver_353);
    typeAnalysisSession__classify_ownership_mut(rtoc_self_view, UNWRAP (node.symbol));
    typeAnalysisSession__og_declare(rtoc_self_view, CAST(node.var_name AS String), NIL, castTypeToTypeTypeInput(elem_ti));
    MUTABLE graph_node: ?OwnershipNode = COPY ownershipGraph__get_index(typeAnalysisSession__ownership_graph(rtoc_self_view), CAST(node.var_name AS String));
    IF graph_node EXISTS AS graph_node_value THEN
        MUTABLE graph_node_value_mutable = COPY graph_node_value;
        graph_node_value_mutable.kind = :borrowed;
    END
    TRY (typeAnalysisSession__visit_stmts(&rtoc_self_view, node.body));
    typeAnalysisSession__finalize_scope(rtoc_self_view, Locatable{ ForEach: COPY node });
    node.deferred_drops
    })], FALSE));
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ ForEach: COPY node }, :Void));
}
END
PRIVATE FN typeAnalysisSession__visit_WhileLoop(MUTABLE self: TypeAnalysisSession, MUTABLE node: WhileLoop) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.condition));
    IF (node.condition.resolved_type() != :Bool) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :CONDITION_NEEDS_BOOL }, [], {:got: node.condition.resolved_type()});
    END
    IF (((node.condition IS_A Identifier AND (node.condition.name() == "TRUE"))) OR ((node.condition IS_A Literal AND node.condition.true_boolean?()))) THEN
      typeAnalysisSession__record_effect(rtoc_self_view, symbol("LOOP_UNBOUND"));
    END
    MUTABLE pre_loop_states = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_354 = typeAnalysisSession__ownership_graph(rtoc_self_view);
    ownershipGraph__fork_lightweight(rtoc_local_receiver_354) };
    TRY (typeAnalysisSession__analyze_loop_control_flow_branches(rtoc_self_view, [proc(%() USE(node, pre_loop_states, MUTABLE rtoc_self_view) -> {
    IF node.do_branch IS_A []Any THEN
        TRY (typeAnalysisSession__visit_stmts(&rtoc_self_view, node.do_branch));
    ELSE
        TRY (typeAnalysisSession__visit(&rtoc_self_view, node.do_branch));
    END
    typeAnalysisSession__finalize_scope(rtoc_self_view, Locatable{ WhileLoop: COPY node });
    typeAnalysisSession__validate_moved_values_not_reused_by_loop_mut(rtoc_self_view, Node{ WhileLoop: COPY node }, Body{ ArrayValue: COPY node.do_branch }, pre_loop_states, :USE_OF_MOVED_IN_LOOP);
    node.deferred_drops
    })], FALSE));
    IF node.tight THEN
      typeAnalysisSession__validate_tight_body_mut(rtoc_self_view, AstScanInput{ ArrayValue: COPY node.do_branch }, TightLoopNode{ WhileLoop: COPY node });
    END
    node.mark_per_iter = FALSE;
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ WhileLoop: COPY node }, :Void));
}
