PRIVATE FN typeAnalysisSession__collect_routine_returns(self: TypeAnalysisSession, blk: FN() -> Void) RETURNS ![]ReturnFact
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fn_ctx: ?FunctionContext@multiowned = typeAnalysisSession__current_fn_ctx(rtoc_self_view);
    MUTABLE saved_returns: ?[]ReturnFact = NIL;
    IF fn_ctx != NIL THEN
      saved_returns = COPY (fn_ctx?).returns;
    END
    IF fn_ctx EXISTS AS fn_ctx_value THEN
      MUTABLE fn_ctx_value_mutable = COPY fn_ctx_value;
      fn_ctx_value_mutable.returns = ( { MUTABLE rtoc_empty_list_43: []ReturnFact = List[]; rtoc_empty_list_43 } );
    END
    blk();
    MUTABLE found_returns: []ReturnFact = ((typeAnalysisSession__current_fn_ctx(rtoc_self_view)?.returns OR_ELSE List[])) |> DISTINCT _ |> SELECT COPY _;
    MUTABLE restore_ctx: ?FunctionContext@multiowned = typeAnalysisSession__current_fn_ctx(rtoc_self_view);
    IF ((restore_ctx != NIL) AND (saved_returns != NIL)) THEN
      restore_ctx.returns = saved_returns;
    END
    RETURN found_returns;
}
END
