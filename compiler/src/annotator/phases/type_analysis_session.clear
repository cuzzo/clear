    END
    IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
        MUTABLE rtoc_mutable_receiver_477 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
        functionContext__record_heap_use_mut(&rtoc_mutable_receiver_477);
