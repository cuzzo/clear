      END
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__promote_mutable_call_argument_mut(MUTABLE self: TypeAnalysisSession, arg_node: Identifier) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
