PRIVATE FN typeAnalysisSession__downgrade_frame_to_stack(self: TypeAnalysisSession, MUTABLE node: AllocDeclarationNode, storage: String@symbol) RETURNS String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(((storage == :frame) AND typeAnalysisSession__current_loop_depth(rtoc_self_view).positive?())) THEN
      RETURN storage;
    END
    IF !((MATCH node START AllocDeclarationNode.VarDecl AS item -> item.value IS_A StructLit, AllocDeclarationNode.BindExpr AS item -> item.value IS_A StructLit END)) THEN
      RETURN storage;
    END
    MUTABLE rtoc_mutable_receiver_238 = (&node.full_type_mut());
    type__mark_stack_value_mut(&rtoc_mutable_receiver_238);
    node.storage = :stack;
    MUTABLE value_node: Any = NIL;
    MATCH node START
      AllocDeclarationNode.VarDecl AS item ->
        value_node = COPY item.value;,
      AllocDeclarationNode.BindExpr AS item ->
        value_node = COPY item.value;,
    END
    value_node.storage = :stack;
    RETURN :stack;
}
END
PRIVATE FN typeAnalysisSession__finalize_decl_storage_mut(self: TypeAnalysisSession, MUTABLE node: AllocDeclarationNode, final_type: FinalType) RETURNS String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE storage = &node.finalize_storage_mut(final_type, %(n) USE(rtoc_self_view) -> typeAnalysisSession__lookup_type_schema(rtoc_self_view, type__to_sym(n)));
    storage = typeAnalysisSession__downgrade_frame_to_stack(rtoc_self_view, &node, storage);
    IF (storage == :frame) THEN
      IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
            MUTABLE rtoc_mutable_receiver_239 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
            functionContext__record_frame_use_mut(&rtoc_mutable_receiver_239);
      END
    END
    IF (storage == :heap) THEN
      IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
            MUTABLE rtoc_mutable_receiver_240 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
            functionContext__record_heap_use_mut(&rtoc_mutable_receiver_240);
      END
      typeAnalysisSession__record_effect(rtoc_self_view, symbol("HEAP"));
    END
    RETURN storage;
}
END
