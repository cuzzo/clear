}
END
PRIVATE FN typeAnalysisSession__reject_direct_observable_method_access_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MethodCall) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE receiver_type = TRY (aST__full_type_mut(node.object));
    IF !((type__future?(receiver_type) AND type__observable?(receiver_type))) THEN
      RETURN;
    END
    MUTABLE root: ?Identifier = aST__root_identifier(node.object);
    IF (root != NIL) THEN
      TRY (typeAnalysisSession__emit_direct_view_access_finding_mut(&rtoc_self_view, Locatable{ MethodCall: COPY node }, identifier__name(root), "VIEW"));
    ELSE
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ MethodCall: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :DIRECT_VIEW_ACCESS_REQUIRES_WITH }, [], CAST({:name: "observable", :permission: "VIEW"} AS {String@symbol}Any)));
    END
}
END
PRIVATE FN typeAnalysisSession__reject_mutating_borrowed_receiver_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MethodCall) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(node.mutates_receiver) THEN
      RETURN;
    END
    MUTABLE root: ?String = typeAnalysisSession__root_variable_name(&rtoc_self_view, node.object);
    IF root EXISTS AS root_value THEN
      IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_299 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
      TRY (ownershipGraph__can_write?(rtoc_local_receiver_299, root_value)) } THEN
        RETURN;
      END
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ MethodCall: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :ASSIGN_WHILE_BORROWED }, [], CAST({:name: root_value} AS {String@symbol}Any)));
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__visit_StaticCall(MUTABLE self: TypeAnalysisSession, MUTABLE node: StaticCall) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__normalize_explicit_mutable_arguments_mut(&rtoc_self_view, Node{ StaticCall: COPY node });
    FOR _ IN node.args DO
    TRY (typeAnalysisSession__visit(&rtoc_self_view, _));
    END
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, &node.type_name, TRY (type__new(TypeConstructionInput{ SymbolValue: :Type }))));
    MUTABLE type_name = symbol(UNWRAP (aST__node_name(node.type_name)));
    MUTABLE schema: ?SchemaValue = TRY (typeAnalysisSession__lookup_type_schema(&rtoc_self_view, type_name));
    IF (schemas__struct?(schema) AND schemaValue__static_methods(UNWRAP (schema)).contains?(node.method_name)) THEN
      TRY (typeAnalysisSession__resolve_inherent_static_call_mut(&rtoc_self_view, &node, type_name));
      RETURN;
    END
    IF !((schemaValue__kind(UNWRAP (schema)) == :resource)) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ StaticCall: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :STATIC_NOT_RESOURCE }, [], CAST({:type: type_name} AS {String@symbol}Any)));
    END
    MUTABLE static_methods = (schemaValue__static_methods(UNWRAP (schema)) OR_ELSE {});
    MUTABLE method_def: ?FunctionSignature@multiowned = COPY static_methods[node.method_name];
    IF method_def EXISTS AS method_def_value THEN
      MUTABLE method_def_value_mutable = COPY method_def_value;
      MUTABLE expected_args = TRY (functionSignature__intrinsic_arg_specs(method_def_value_mutable));
      IF ((node.args).length() != expected_args.length()) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ StaticCall: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :STATIC_ARITY }, [], CAST({:type: type_name, :method: node.method_name, :expected: expected_args.length(), :got: (node.args).length()} AS {String@symbol}Any)));
      END
      MUTABLE rtoc_each_items_300 = node.args;
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < rtoc_each_items_300.length() DO
      IF (UNWRAP (rtoc_each_items_300[rtoc_idx])[1] AND TRY (typeAnalysisSession__intrinsic_arg_matches?(&rtoc_self_view, UNWRAP (rtoc_each_items_300[rtoc_idx])[1], &UNWRAP (rtoc_each_items_300[rtoc_idx])[0]))) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE actual = UNWRAP (rtoc_each_items_300[rtoc_idx])[0].resolved_type;
      IF (_ == :Any) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ StaticCall: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :STATIC_ARG_TYPE }, [], CAST({:index: (rtoc_idx + 1), :type: type_name, :method: node.method_name, :expected: ((IF UNWRAP (rtoc_each_items_300[rtoc_idx])[1] != NIL THEN
            (UNWRAP (rtoc_each_items_300[rtoc_idx])[1]).type()
          ELSE
            NIL
          END) OR_ELSE :Any), :got: actual} AS {String@symbol}Any)));
    rtoc_idx = rtoc_idx + 1;
      END
      node.zig_pattern = castOptionalFunctionSignatureReturnValueToOptionalStringSymbol__type_analysis_session(TRY (functionSignature__intrinsic_pattern(method_def_value_mutable)));
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ StaticCall: COPY node }, { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_301 = (TRY (functionSignature__return_def(method_def_value_mutable)));
      TRY (functionReturn__resolve(rtoc_local_receiver_301, NIL, node.args)) }));
      node.matched_stdlib_def = method_def_value_mutable;
      node.matched_signature = method_def_value_mutable;
      MUTABLE method_allocates = TRY (functionSignature__emits_allocating?(method_def_value_mutable));
      node.stdlib_allocates = method_allocates;
      node.mutates_receiver = TRY (functionSignature__mutates_receiver?(method_def_value_mutable));
      node.can_fail = (IF node.can_fail != NIL THEN node.can_fail ELSE functionSignature__can_fail(method_def_value_mutable) END);
      IF (functionSignature__recoverable_result?(method_def_value_mutable) AND TRUE) THEN
        node.error_union_type = TRY (type__error_union_of(castTypeToTypeTypeInput__type_analysis_session(TRY (type__new(TypeConstructionInput{ Type: COPY TRY (aST__full_type_mut(Locatable{ StaticCall: COPY node })) })))));
      END
      node.error_kind = TRY (functionSignature__intrinsic_error_kind(method_def_value_mutable));
      node.error_type = TRY (functionSignature__intrinsic_error_type(method_def_value_mutable));
      IF (method_allocates OR (functionSignature__can_fail(method_def_value_mutable) OR_ELSE FALSE)) THEN
        IF typeAnalysisSession__current_fn_ctx(&rtoc_self_view) != NIL THEN
                MUTABLE rtoc_mutable_receiver_302 = UNWRAP (typeAnalysisSession__current_fn_ctx(&rtoc_self_view));
                functionContext__record_alloc_use_mut(&rtoc_mutable_receiver_302);
        END
      END
    ELSE
      MUTABLE available = static_methods.keys().join(", ");
      IF (available.length() == 0) THEN
        available = "(none)";
      END
      MUTABLE rtoc_held_12624: ?Token = locatable__token(node.type_name);
      IF rtoc_held_12624 THEN
        MUTABLE anchor = typeAnalysisSession__anchor_at(&rtoc_self_view, rtoc_held_12624.line, ((rtoc_held_12624.column + (CAST(locatable__name(node.type_name) AS String)).codepointCount()) + 2));
        TRY (typeAnalysisSession__emit_typo_suggestion_mut(&rtoc_self_view, TypoToken{ AnchorToken: COPY rtoc_held_12624 }, node.method_name, static_methods.keys(), "Type Error: No static method '${node.method_name}' on '${type_name}'. Available: ${available}.", "static method of ${type_name}", :type, TRUE));
      ELSE
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ StaticCall: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :STATIC_UNKNOWN_METHOD }, [], CAST({:method: node.method_name, :type: type_name, :available: available} AS {String@symbol}Any)));
      END
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__resolve_inherent_static_call_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: StaticCall, owner: String@symbol) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE call = FuncCall{ token: COPY node.token, name: CallName{ StringValue: COPY implementationRegistration__function_name(CAST(owner AS String), node.method_name) }, args: COPY node.args, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, explicit_mutable_argument_tokens: NIL, module_alias: NIL, extern_call: NIL, extern_effects: NIL, extern_source: NIL, generic_type_args: NIL, fn_var_call: NIL, pipe_lhs: NIL, heap_dupe_result: NIL, arg_families: NIL, collapsed_errors: NIL, error_union_type: NIL, protocol_name: NIL, protocol_operation: NIL, protocol_receiver_index: NIL, retain_error_channel: NIL };
    FOR rtoc_each_key IN node.explicit_mutable_argument_tokens.keys() DO
    MUTABLE token: Token@multiowned = COPY UNWRAP (node.explicit_mutable_argument_tokens[rtoc_each_key]);
    MUTABLE rtoc_call_node = Locatable{ FuncCall: COPY call };
    locatable__mark_explicit_mutable_argument_mut(&rtoc_call_node, rtoc_each_key, CAST(COPY token AS Token));
    END
    TRY (typeAnalysisSession__resolve_call(&rtoc_self_view, FunctionCallNode{ FuncCall: COPY call }, node.args));
    MUTABLE resolved_return = TRY (aST__full_type_mut(Locatable{ FuncCall: COPY call }));
    aST__copy_pipeline_rewrite_metadata_mut(PipelineRewriteNode{ FuncCall: COPY call }, PipelineRewriteNode{ StaticCall: COPY node }, TRUE);
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ FuncCall: COPY call }, resolved_return));
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ StaticCall: COPY node }, resolved_return));
    node.inherent_call = call;
    TRY (typeAnalysisSession__record_predicate_call_site_mut(&rtoc_self_view, Node{ FuncCall: COPY call }));
    TRY (typeAnalysisSession__record_named_call_site_mut(&rtoc_self_view, &call));
}
END
PRIVATE FN typeAnalysisSession__visit_IntrinsicFunc(MUTABLE self: TypeAnalysisSession, MUTABLE node: Node, args: []Locatable, matched_def_input: ?FunctionSignature = NIL) RETURNS !?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE matched_def = COPY matched_def_input;
    MUTABLE definitions: []FunctionSignature@multiowned = TRY (intrinsicRegistry__overloads(:std_lib, UNWRAP (aST__node_name(UNWRAP (castNodeToLocatable(node))))));
    matched_def = (matched_def OR_ELSE TRY (typeAnalysisSession__find_matching_intrinsic(&rtoc_self_view, definitions, args)));
    IF matched_def EXISTS AS matched_def_value THEN
      MUTABLE matched_def_value_mutable = COPY matched_def_value;
      IF !(functionSignature__intrinsic_varargs?(matched_def_value_mutable)) THEN
        TRY (typeAnalysisSession__verify_function_signature_mut(&rtoc_self_view, castNodeToFunctionCallNode(node), TRY (functionSignature__intrinsic_call_validation_signature(matched_def_value_mutable)), args));
      END
      MUTABLE reject_when: ?String@symbol = TRY (functionSignature__intrinsic_reject_when(matched_def_value_mutable));
      MUTABLE first_arg: ?Locatable = COPY args.first();
      IF (((reject_when != NIL) AND (first_arg != NIL)) AND TRY (typeAnalysisSession__reject_arg_type_matches?(&rtoc_self_view, &first_arg, symbol(reject_when)))) THEN
        MUTABLE reason = (TRY (functionSignature__intrinsic_reject_error(matched_def_value_mutable)) OR_ELSE "${(aST__node_name(UNWRAP (castNodeToLocatable(node))) OR_ELSE "")}() is not valid for ${(locatable__resolved_type(first_arg) OR_ELSE "")}");
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castNodeToLocatable(node)), TypeAnalysisCodeOrMessage{ SymbolValue: :INTRINSIC_REJECTED }, [], CAST({:detail: reason} AS {String@symbol}Any)));
        RETURN NIL;
      END
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, castNodeToLocatable__type_analysis_session(node), { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_303 = (TRY (functionSignature__return_def(matched_def_value_mutable)));
      TRY (functionReturn__resolve(rtoc_local_receiver_303, NIL, args)) }));
      node__set_zig_pattern_mut(&node, TRY (functionSignature__intrinsic_pattern(matched_def_value_mutable)));
      node__set_matched_stdlib_def_mut(&node, COPY matched_def_value_mutable);
      IF (aST__node__matched_signature(Node{ MethodCall: COPY UNWRAP (castNodeToMethodCall(node))}) EXISTS) THEN
        node.matched_signature = COPY matched_def_value_mutable;
      END
      MUTABLE matched_allocates = TRY (functionSignature__emits_allocating?(matched_def_value_mutable));
      node__set_stdlib_allocates_mut(&node, matched_allocates);
      node__set_mutates_receiver_mut(&node, TRY (functionSignature__mutates_receiver?(matched_def_value_mutable)));
      node.can_fail = ((aST__node__can_fail(UNWRAP (castNodeToLocatable(node))) OR functionSignature__can_fail(matched_def_value_mutable)) OR matched_allocates);
      IF (functionSignature__recoverable_result?(matched_def_value_mutable) AND (aST__node_error_union_type(UNWRAP (castNodeToLocatable(node))) EXISTS)) THEN
        node.error_union_type = TRY (type__error_union_of(castTypeToTypeTypeInput__type_analysis_session(TRY (type__new(TypeConstructionInput{ Type: COPY TRY (aST__full_type_mut(UNWRAP (castNodeToLocatable(node)))) })))));
      END
      IF TRY (functionSignature__intrinsic_error_kind(matched_def_value_mutable)) THEN
        node__set_error_kind_mut(&node, TRY (functionSignature__intrinsic_error_kind(matched_def_value_mutable)));
      END
      IF TRY (functionSignature__intrinsic_error_type(matched_def_value_mutable)) THEN
