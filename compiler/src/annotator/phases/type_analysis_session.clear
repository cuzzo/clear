      MUTABLE path = TRY (typeAnalysisSession__get_path_to_root(&rtoc_self_view, castLocatableToNode__type_analysis_session(actual_arg_value_mutable)));
      IF (path.length() == 0) THEN
        RETURN;
      END
      MUTABLE root_var = COPY CAST(path.first() AS String);
      MUTABLE borrowed_scope: ?Scope@multiowned = TRY (typeAnalysisSession__lookup_scope_for(&rtoc_self_view, root_var));
      IF (borrowed_scope == NIL) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castNodeToLocatable(node)), TypeAnalysisCodeOrMessage{ SymbolValue: :BORROWED_VAR_NOT_FOUND }));
      END
      IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_482 = UNWRAP (borrowed_scope);
      scope__is_immutable?(rtoc_local_receiver_482, root_var) } THEN
        RETURN;
      END
      MUTABLE lhs_name: ?String = aST__node_name(UNWRAP (castNodeToLocatable(node)));
      MUTABLE mutable = (IF node IS_A VarDecl AS var_decl THEN var_decl.mutable ELSE FALSE END);
      MUTABLE err: ?String = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_483 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
      TRY (ownershipGraph__borrow(&rtoc_mutable_receiver_483, UNWRAP (lhs_name), root_var, mutable)) };
      IF err EXISTS AS err_value THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castNodeToLocatable(node)), TypeAnalysisCodeOrMessage{ SymbolValue: :LIFETIME_ALREADY_BORROWED }, [], CAST({:name: root_var} AS {String@symbol}Any)));
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__resolve_borrow_source(MUTABLE self: TypeAnalysisSession, call_node: TypeAnalysisCallNode) RETURNS !?Locatable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE matched_def: ?FunctionSignature@multiowned = NIL;
    MATCH call_node START
      TypeAnalysisCallNode.FuncCall AS item ->
        matched_def = COPY item.matched_stdlib_def;,
      TypeAnalysisCallNode.MethodCall AS item ->
        matched_def = COPY item.matched_stdlib_def;,
    END
    IF matched_def EXISTS AS matched_def_value THEN
      MUTABLE matched_def_value_mutable = COPY matched_def_value;
      MUTABLE lifetimes = TRY (functionSignature__intrinsic_lifetime(matched_def_value_mutable));
      IF !((lifetimes.length() == 0)) THEN
        IF lifetimes.contains?("self") THEN
        IF call_node IS_A MethodCall AS method_call THEN
          RETURN COPY method_call.object;
        END
        END
        MUTABLE args_branch_value: ?[]Locatable = NIL;
        IF call_node IS_A MethodCall AS method_call THEN
          args_branch_value = ([method_call.object] + method_call.args);
        ELSE
          PARTIAL MATCH call_node START
            TypeAnalysisCallNode.FuncCall AS item -> args_branch_value = COPY item.args;,
            TypeAnalysisCallNode.MethodCall AS item -> args_branch_value = COPY item.args;,
            DEFAULT -> args_branch_value = NIL;
          END
        END
        MUTABLE args: []Locatable = args_branch_value?;
        MUTABLE idx = (TRY (functionSignature__intrinsic_arg_specs(matched_def_value_mutable))).indexOf();
        IF (idx AND (args[idx] != NIL)) THEN
          RETURN COPY args[idx];
        END
        RETURN NIL;
      END
    END
    MUTABLE func_name = typeAnalysisCallNode__name(call_node);
    MUTABLE scope: ?Scope@multiowned = TRY (typeAnalysisSession__lookup_scope_for(&rtoc_self_view, func_name));
    IF scope EXISTS AS scope_value THEN
      MUTABLE func_type: ?FunctionSignature@multiowned = functionSignature__unwrap(X{ Type: COPY TRY (scope__resolve_type(scope_value, func_name)) });
      IF func_type EXISTS AS func_type_value THEN
        MUTABLE lifetime = TRY (functionSignature__return_lifetime(func_type_value));
        IF ((lifetime.length() == 0) OR (lifetime == [:wildcard])) THEN
          RETURN NIL;
        END
        MUTABLE primary: ?FunctionSignatureLifetimeSource = COPY lifetime.first();
        IF ruby_union_scalar_equal_optional_FunctionSignatureLifetimeSource_String_symbol(primary, :wildcard) THEN
          RETURN NIL;
        END
        MUTABLE primary_root: ?String = COPY (CAST(primary AS String)).split(".").first();
        MUTABLE param_index = (TRY (functionSignature__params(func_type_value))).find_index(%(p: Param) USE(primary_root) -> (p.name == primary_root));
        IF !(param_index) THEN
          RETURN NIL;
        END
        MUTABLE args_branch_value: ?[]Locatable = NIL;
        IF call_node IS_A MethodCall AS method_call THEN
          args_branch_value = ([method_call.object] + method_call.args);
        ELSE
          PARTIAL MATCH call_node START
            TypeAnalysisCallNode.FuncCall AS item -> args_branch_value = COPY item.args;,
            TypeAnalysisCallNode.MethodCall AS item -> args_branch_value = COPY item.args;,
            DEFAULT -> args_branch_value = NIL;
          END
        END
        MUTABLE args: []Locatable = args_branch_value?;
        RETURN COPY args[param_index];
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__call_returns_borrowed_view?(MUTABLE self: TypeAnalysisSession, call_node: TypeAnalysisCallNode) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE matched_def: ?FunctionSignature@multiowned = NIL;
    MATCH call_node START
      TypeAnalysisCallNode.FuncCall AS item ->
        matched_def = COPY item.matched_stdlib_def;,
      TypeAnalysisCallNode.MethodCall AS item ->
        matched_def = COPY item.matched_stdlib_def;,
    END
    IF ((matched_def != NIL) AND !(((TRY (functionSignature__intrinsic_lifetime(matched_def))).length() == 0))) THEN
      RETURN TRUE;
    END
    MUTABLE scope: ?Scope@multiowned = TRY (typeAnalysisSession__lookup_scope_for(&rtoc_self_view, typeAnalysisCallNode__name(call_node)));
    MUTABLE signature: ?FunctionSignature@multiowned = functionSignature__unwrap(ruby_wrap_optional_Type_multiowned_X__type_analysis_session((IF scope != NIL THEN
      TRY (scope__resolve_type(scope, typeAnalysisCallNode__name(call_node)))
    ELSE
      NIL
    END)));
    RETURN ( !(!(signature)) AND !(((TRY (functionSignature__return_lifetime( signature))).length() == 0)));
}
END
