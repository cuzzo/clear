PRIVATE FN typeAnalysisSession__analyze_limit_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lhs_ti = &node.left.full_type_mut("pipeline left");
    MUTABLE source = typeAnalysisSession__pipeline_source_fact(rtoc_self_view, node.left, lhs_ti, TRUE);
