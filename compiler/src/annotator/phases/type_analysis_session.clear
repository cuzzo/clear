PRIVATE FN typeAnalysisSession__verify_match_multi_arm_payloads_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MatchStatement, arm: MatchCase, schema: UnionSchema, variant_name: ?String, union_subst: {String@symbol}String@symbol, kind: String, name: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF variant_name EXISTS AS variant_name_value THEN
      MUTABLE head_payload: ?MatchPayload = TRY (typeAnalysisSession__normalized_match_payload(&rtoc_self_view, castOptionalSchemasUnionSchemaVariantValueToOptionalMatchPayload(schema.variants[symbol(variant_name_value)]), union_subst));
      MUTABLE rtoc_each_items_330 = (TRY (typeAnalysisSession__match_variant_names(&rtoc_self_view, arm)) |> SKIP 1);
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < rtoc_each_items_330.length() DO
      MUTABLE extra_payload: ?MatchPayload = TRY (typeAnalysisSession__normalized_match_payload(&rtoc_self_view, castOptionalSchemasUnionSchemaVariantValueToOptionalMatchPayload(schema.variants[rtoc_each_items_330[rtoc_idx]]), union_subst));
      IF TRY (matchPayload__eq?(head_payload, extra_payload)) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ MatchStatement: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :MATCH_MULTI_ARM_PAYLOAD_MISMATCH }, [], CAST({:head: variant_name_value, :other: rtoc_each_items_330[rtoc_idx], :kind: kind, :name: name} AS {String@symbol}Any)));
    rtoc_idx = rtoc_idx + 1;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__literal_type_substitution_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: StructLit, schema: TypeAnalysisSchema) RETURNS !{String@symbol}GenericBinding
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE type_params: ?[]String@symbol = typeAnalysisSchema__type_params(schema);
    MUTABLE subst: {String@symbol}GenericBinding = {};
    IF node.type_args EXISTS AS type_args_value THEN
      IF type_args_value.any?() THEN
      IF UNWRAP (type_params).empty?() THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ StructLit: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_NOT_GENERIC }, [], CAST({:type: node.name} AS {String@symbol}Any)));
      END
      IF ((node.type_args OR_ELSE List[]).length() != (type_params).length()) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ StructLit: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_WRONG_ARG_COUNT }, [], CAST({:type: node.name, :expected: (type_params).length(), :got: node.type_args.length()} AS {String@symbol}Any)));
      END
      type_params.zip(node.type_args).keys() |> EACH {
    MUTABLE arg = (type_params.zip(node.type_args)[_] OR_ELSE panic("missing hash key"));
      subst[_] = castTypeToGenericBinding(TRY (type__new(arg)));
      };
    ELSE_IF (type_params).any?() THEN
      MUTABLE params_hint = ((type_params OR_ELSE List[]) |> SELECT _.toString()).join(", ");
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ StructLit: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_MISSING_TYPE_ARGS }, [], CAST({:type: node.name, :type2: node.name, :hint: params_hint} AS {String@symbol}Any)));
    END
    END
    RETURN subst;
}
END
PRIVATE FN typeAnalysisSession__literal_instance_type(MUTABLE self: TypeAnalysisSession, MUTABLE node: StructLit) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node.type_args EXISTS AS type_args_value THEN
      IF type_args_value.any?() THEN
      RETURN TRY (type__new(TypeConstructionInput{ TypeExpression: COPY typeExpression__of(TypeExpressionKind{ NamedTypeExpression: COPY NamedTypeExpression{ name: COPY symbol(node.name), arguments: COPY ((node.type_args OR_ELSE List[]) |> SELECT ((TRY (type__new(castTypeToTypeConstructionInput__type_analysis_session(_)))).shape).expression) } }) }));
    ELSE
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol(node.name) }));
    END
    END
}
END
PRIVATE FN typeAnalysisSession__match_subject_plan(MUTABLE self: TypeAnalysisSession, MUTABLE node: MatchStatement) RETURNS !MatchSubjectPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE expr_t = TRY (type__new(TypeConstructionInput{ Type: COPY TRY (aST__full_type_mut(node.expr)) }));
    IF TRY (type__string?(expr_t)) THEN
      node.string_match = TRUE;
    END
    MUTABLE type_name_branch_value: ?String@symbol = NIL;
    IF type__generic_instance?(expr_t) THEN
      type_name_branch_value = type__generic_base(expr_t);
    ELSE
      type_name_branch_value = type__resolved(expr_t);
    END
    MUTABLE type_name: String@symbol = type_name_branch_value?;
    MUTABLE schema: ?MatchSchema = CAST(TRY (typeAnalysisSession__lookup_type_schema(&rtoc_self_view, type_name)) AS ?MatchSchema);
    MUTABLE is_enum = schemas__enum?(castOptionalMatchSchemaToOptionalSchemaValue(schema));
    MUTABLE is_union = schemas__union?(castOptionalMatchSchemaToOptionalSchemaValue(schema));
    RETURN MatchSubjectPlan{ expr_type: COPY expr_t, type_name: COPY type_name, schema: COPY schema, enum_subject: is_enum, union_subject: is_union, union_subst: COPY TRY (typeAnalysisSession__match_union_substitution(&rtoc_self_view, expr_t, schema, is_union)) };
}
END
PRIVATE FN typeAnalysisSession__match_union_substitution(MUTABLE self: TypeAnalysisSession, expr_t: Type, schema: ?MatchSchema, is_union: Bool) RETURNS !{String@symbol}String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(is_union) THEN
      RETURN {};
    END
    IF !(type__generic_instance?(expr_t)) THEN
      RETURN {};
    END
    MUTABLE union_schema: UnionSchema@multiowned = COPY castOptionalMatchSchemaToUnionSchemaMultiowned(schema);
    MUTABLE type_params = COPY union_schema.type_params;
    IF (type_params.length() == 0) THEN
      RETURN {};
    END
    MUTABLE subst: {String@symbol}String@symbol = {};
    MUTABLE rtoc_zip_args = TRY (type__generic_args(expr_t));
    MUTABLE rtoc_zip_i = 0;
    WHILE rtoc_zip_i < type_params.length() DO
      MUTABLE a: ?Type = COPY rtoc_zip_args[rtoc_zip_i];
      IF a EXISTS AS rtoc_a_value THEN
        subst[UNWRAP (type_params[rtoc_zip_i])] = type__resolved(rtoc_a_value);
      END
      rtoc_zip_i = rtoc_zip_i + 1;
    END
    RETURN subst;
}
END
PRIVATE FN typeAnalysisSession__match_union_schema(MUTABLE self: TypeAnalysisSession, plan: MatchSubjectPlan) RETURNS UnionSchema@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN KEEP castOptionalMatchSchemaToUnionSchemaMultiowned(plan.schema);
}
END
