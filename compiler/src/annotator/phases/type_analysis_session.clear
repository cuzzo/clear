    MUTABLE result = TRY (typeAnalysisSession__publish_tense_navigation_plan_mut(&rtoc_self_view, Locatable{ MethodCall: COPY node }, castLocatableToTenseNavigation__type_analysis_session(node.object), CAST(mapped_type AS Type)));
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ MethodCall: COPY node }, result));
    IF (IF node.object IS_A OptionalUnwrap AS rtoc_nav2 THEN optionalUnwrap__safe_navigation?(rtoc_nav2) ELSE FALSE END) THEN
      node.safe_nav_chain = TRUE;
    END
}
END
