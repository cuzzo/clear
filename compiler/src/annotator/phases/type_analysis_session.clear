              MUTABLE item_mutable = COPY item;
              item_mutable.generic_type_args = type_params |> SELECT subst[_];
              node = FunctionCallNode{ FuncCall: item_mutable };,
            FunctionCallNode.MethodCall AS item ->
              MUTABLE item_mutable = COPY item;
              item_mutable.generic_type_args = type_params |> SELECT subst[_];
              node = FunctionCallNode{ MethodCall: item_mutable };,
          END
          MUTABLE substituted = TRY (typeAnalysisSession__substitute_type_params(&rtoc_self_view, UNWRAP (signature), subst));
          TRY (typeAnalysisSession__verify_function_signature_mut(&rtoc_self_view, node, substituted, args));
          MATCH node START
            FunctionCallNode.FuncCall AS item ->
              MUTABLE item_mutable = COPY item;
              item_mutable.matched_signature = substituted;
              node = FunctionCallNode{ FuncCall: item_mutable };,
            FunctionCallNode.MethodCall AS item ->
              MUTABLE item_mutable = COPY item;
              item_mutable.matched_signature = substituted;
              node = FunctionCallNode{ MethodCall: item_mutable };,
          END
          TRY (typeAnalysisSession__stamp_resolved_call_result_mut(&rtoc_self_view, &node, CAST(functionSignature__return_type(substituted) AS Type), functionSignature__recoverable_result?(substituted)));
        ELSE
          TRY (typeAnalysisSession__verify_function_signature_mut(&rtoc_self_view, node, UNWRAP (signature), args));
          MATCH node START
            FunctionCallNode.FuncCall AS item ->
              MUTABLE item_mutable = COPY item;
              item_mutable.matched_signature = signature;
              node = FunctionCallNode{ FuncCall: item_mutable };,
            FunctionCallNode.MethodCall AS item ->
              MUTABLE item_mutable = COPY item;
              item_mutable.matched_signature = signature;
              node = FunctionCallNode{ MethodCall: item_mutable };,
          END
          TRY (typeAnalysisSession__stamp_resolved_call_result_mut(&rtoc_self_view, &node, CAST(functionSignature__return_type(signature) AS Type), functionSignature__recoverable_result?(signature)));
        END
      ELSE_IF (IF fsig != NIL THEN fsig ELSE fn_type END) THEN
        IF node IS_A FuncCall AS func_call THEN
          func_call.fn_var_call = TRUE;
        END
        IF TRY (typeAnalysisSession__lookup_scope_for(&rtoc_self_view, UNWRAP (func_name))) != NIL THEN
                MUTABLE rtoc_mutable_receiver_69: ?Scope@multiowned = (TRY (typeAnalysisSession__lookup_scope_for(&rtoc_self_view, UNWRAP (func_name))));
                scope__mark_read(&_, func_name);
        END
        MUTABLE sig = (fsig OR_ELSE TRY (typeAnalysisSession__signature_from_function_type(&rtoc_self_view, fn_type?)));
        MUTABLE synthetic_sig = TRY (functionSignature__new(TRY (functionSignature__params(sig)), TypeTypeInput{ Type: COPY functionSignature__return_type(sig) }, NIL, NIL, ( { MUTABLE rtoc_empty_list_70: []String@symbol = List[]; rtoc_empty_list_70 } ), {}, functionSignature__reentrant(sig), FALSE, NIL, NIL, NIL, ( { MUTABLE rtoc_empty_list_71: []String@symbol = List[]; rtoc_empty_list_71 } ), NIL, ( { MUTABLE rtoc_empty_list_72: []String@symbol = List[]; rtoc_empty_list_72 } )));
        TRY (typeAnalysisSession__verify_function_signature_mut(&rtoc_self_view, node, synthetic_sig, args));
        MATCH node START
          FunctionCallNode.FuncCall AS item ->
            MUTABLE item_mutable = COPY item;
            item_mutable.matched_signature = synthetic_sig;
            node = FunctionCallNode{ FuncCall: item_mutable };,
          FunctionCallNode.MethodCall AS item ->
            MUTABLE item_mutable = COPY item;
            item_mutable.matched_signature = synthetic_sig;
            node = FunctionCallNode{ MethodCall: item_mutable };,
        END
        TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, UNWRAP (castFunctionCallNodeToLocatable(node)), functionSignature__return_type(sig)));
      ELSE_IF func_type IS_A String@symbol THEN
        TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, UNWRAP (castFunctionCallNodeToLocatable(node)), func_type));
      ELSE
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castFunctionCallNodeToLocatable(node)), TypeAnalysisCodeOrMessage{ SymbolValue: :NOT_A_FUNCTION }, [], CAST({:name: func_name} AS {String@symbol}Any)));
      END
      RETURN NIL;
    ELSE
      MUTABLE fn_nodes = TRY (typeAnalysisSession__function_node_map(&rtoc_self_view));
      TRY (typeAnalysisSession__emit_typo_suggestion_mut(&rtoc_self_view, TypoToken{ TokenMultiowned: COPY UNWRAP (functionCallNode__token(node)) }, func_name, fn_nodes.keys(), "Undefined function '${(func_name OR_ELSE "")}'", "closest declared function"));
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__stamp_resolved_call_result_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: FunctionCallNode, return_type: Type, recoverable: Bool = FALSE) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE resolved = TRY (type__new(castTypeToTypeConstructionInput__type_analysis_session(return_type)));
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, UNWRAP (castFunctionCallNodeToLocatable(node)), resolved));
    IF !((type__error_union?(resolved) OR recoverable)) THEN
      RETURN;
    END
    MUTABLE error_union_branch_value: ?Type = NIL;
    IF type__error_union?(resolved) THEN
      error_union_branch_value = resolved;
    ELSE
      error_union_branch_value = TRY (type__error_union_of(castTypeToTypeTypeInput__type_analysis_session(resolved)));
    END
    MUTABLE error_union: Type = error_union_branch_value?;
    MATCH node START
      FunctionCallNode.FuncCall AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.error_union_type = error_union;
        node = FunctionCallNode{ FuncCall: item_mutable };,
      FunctionCallNode.MethodCall AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.error_union_type = error_union;
        node = FunctionCallNode{ MethodCall: item_mutable };,
    END
    MATCH node START
      FunctionCallNode.FuncCall AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.can_fail = TRUE;
        node = FunctionCallNode{ FuncCall: item_mutable };,
      FunctionCallNode.MethodCall AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.can_fail = TRUE;
        node = FunctionCallNode{ MethodCall: item_mutable };,
    END
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, UNWRAP (castFunctionCallNodeToLocatable(node)), TRY (type__success_type(error_union))));
}
END
PRIVATE FN typeAnalysisSession__mark_owned_c_out_parameters_mut(MUTABLE self: TypeAnalysisSession, signature: FunctionSignature, args: []Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(((functionSignature__extern_source(signature) != NIL) AND (((functionSignature__extern_source(signature))?).abi == :c))) THEN
      RETURN;
    END
    MUTABLE rtoc_zip_params = TRY (functionSignature__params(signature));
    MUTABLE rtoc_zip_i = 0;
    WHILE rtoc_zip_i < rtoc_zip_params.length() DO
    MUTABLE param: ?Param = rtoc_zip_params[rtoc_zip_i];
    MUTABLE arg: ?Locatable = args[rtoc_zip_i];
    IF !((IF param != NIL THEN
        param.mutable
      ELSE
        FALSE
      END)) THEN
      rtoc_zip_i = rtoc_zip_i + 1;
      CONTINUE;
    END
    IF !(UNWRAP (arg) IS_A Identifier) THEN
        rtoc_zip_i = rtoc_zip_i + 1;
        CONTINUE;
    END
    MUTABLE param_type = TRY (type__new(TypeConstructionInput{ Type: COPY UNWRAP (param).type }));
    MUTABLE payload_branch_value: ?Type = NIL;
      IF type__optional?(param_type) THEN
        payload_branch_value = TRY (type__wrapped_type(param_type));
      ELSE
        payload_branch_value = NIL;
      END
    MUTABLE payload: ?Type = payload_branch_value;
    IF !(payload) THEN
        rtoc_zip_i = rtoc_zip_i + 1;
        CONTINUE;
    END
    MUTABLE schema: ?SchemaValue = TRY (typeAnalysisSession__lookup_type_schema(&rtoc_self_view, type__resolved( payload)));
    IF !((IF schema EXISTS AS schema_value THEN schema_value IS_A ResourceSchema ELSE FALSE END)) THEN
        rtoc_zip_i = rtoc_zip_i + 1;
        CONTINUE;
    END
    MUTABLE symbol: ?SymbolEntry@multiowned = locatable__symbol(UNWRAP (arg));
    IF symbol EXISTS AS MUTABLE symbol_value THEN
        symbolEntry__set_foreign_out_owner(&symbol_value, TRUE);
    END
    rtoc_zip_i = rtoc_zip_i + 1;
    END
}
END
PRIVATE FN typeAnalysisSession__receiver_container_alloc(MUTABLE self: TypeAnalysisSession, node: FunctionCallNode) RETURNS ?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node IS_A MethodCall AS method_call THEN
      MUTABLE obj = method_call.object;
      MUTABLE sym: ?SymbolEntry@multiowned = aST__node__symbol(obj);
      MUTABLE storage: ?String@symbol = symbolEntry__storage(UNWRAP (sym));
      IF storage EXISTS AS storage_value THEN
        IF (storage_value == :frame) THEN
          RETURN :frame;
        END
        IF (storage_value == :heap) THEN
          RETURN :heap;
        END
        RETURN NIL;
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__verify_function_signature_mut(MUTABLE self: TypeAnalysisSession, node: FunctionCallNode, signature: FunctionSignature, args_input: ?[]Locatable = NIL) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE args: []Locatable = (COPY args_input OR_ELSE UNWRAP (functionCallNode__args(node)));
    MUTABLE site = typeAnalysisSession__call_signature_site(&rtoc_self_view, node, args);
    callSignatureSite__assign_signature_mut(&site, signature);
    MUTABLE plan = TRY (typeAnalysisSession__call_arity_plan(&rtoc_self_view, site, signature));
    TRY (typeAnalysisSession__verify_call_arity_mut(&rtoc_self_view, plan));
    TRY (typeAnalysisSession__inject_default_arguments_mut(&rtoc_self_view, &plan));
    MUTABLE encountered_args: []EncounteredCallArgument = ( { MUTABLE rtoc_empty_list_73: []EncounteredCallArgument = List[]; rtoc_empty_list_73 } );
    MUTABLE atomic_bare_value_args: []Locatable = ( { MUTABLE rtoc_empty_list_74: []Locatable = List[]; rtoc_empty_list_74 } );
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < site.args.length() DO
      MUTABLE param = COPY UNWRAP ((TRY (functionSignature__params(signature)))[rtoc_idx]);
      IF param.comptime EXISTS AS comptime_value THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE facts = TRY (typeAnalysisSession__call_argument_facts(&rtoc_self_view, site, param, site.args[rtoc_idx]?, rtoc_idx));
      TRY (typeAnalysisSession__verify_param_lifetime_mut(&rtoc_self_view, facts.arg_node, facts.param, signature));
      TRY (typeAnalysisSession__verify_mutable_argument_mut(&rtoc_self_view, facts));
      TRY (typeAnalysisSession__verify_takes_argument_mut(&rtoc_self_view, &facts));
      TRY (typeAnalysisSession__verify_link_argument_mut(&rtoc_self_view, facts));
      TRY (typeAnalysisSession__verify_argument_type_mut(&rtoc_self_view, &facts, signature, &atomic_bare_value_args));
      TRY (typeAnalysisSession__verify_argument_aliases_mut(&rtoc_self_view, facts, &encountered_args));
      TRY (typeAnalysisSession__verify_copy_retained_boundary_mut(&rtoc_self_view, facts));
      TRY (typeAnalysisSession__verify_unique_argument_mut(&rtoc_self_view, facts));
      TRY (typeAnalysisSession__verify_retained_into_plain_slot_mut(&rtoc_self_view, facts));
    rtoc_idx = rtoc_idx + 1;
    END
    typeAnalysisSession__warn_multi_atomic_bare_value_call_mut(&rtoc_self_view, site.node, atomic_bare_value_args);
    NIL;
}
END
PRIVATE FN typeAnalysisSession__call_signature_site(MUTABLE self: TypeAnalysisSession, node: FunctionCallNode, args_input: ?[]Locatable = NIL) RETURNS CallSignatureSite
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE args: []Locatable = (COPY args_input OR_ELSE UNWRAP (functionCallNode__args(node)));
    MUTABLE source_name: String = "";
    IF (IF node IS_A MethodCall AS method_call THEN (methodCall__source_method_name(method_call) != NIL) ELSE FALSE END) THEN
      source_name = UNWRAP (functionCallNode__source_method_name(node));
    ELSE
      source_name = COPY CAST(functionCallNode__name(node) AS String);
    END
    RETURN CallSignatureSite{ node: COPY node, name: COPY source_name, args: COPY args };
}
END
PRIVATE FN typeAnalysisSession__call_arity_plan(MUTABLE self: TypeAnalysisSession, site: CallSignatureSite, signature: FunctionSignature) RETURNS !CallArityPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE params = TRY (functionSignature__params(signature));
    RETURN CallArityPlan{ site: COPY site, params: COPY params, min_args: params |> COUNT (_.required == TRUE), max_args: params.length(), given_args: site.args.length() };
}
END
PRIVATE FN typeAnalysisSession__verify_call_arity_mut(MUTABLE self: TypeAnalysisSession, plan: CallArityPlan) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(callArityPlan__mismatch?(plan)) THEN
      RETURN;
    END
    IF callArityPlan__exact?(plan) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castFunctionCallNodeToLocatable(plan.site.node)), TypeAnalysisCodeOrMessage{ SymbolValue: :ARITY_MISMATCH }, [], CAST({:name: plan.site.name, :expected: plan.min_args, :got: plan.given_args} AS {String@symbol}Any)));
    ELSE
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castFunctionCallNodeToLocatable(plan.site.node)), TypeAnalysisCodeOrMessage{ SymbolValue: :ARITY_MISMATCH_RANGE }, [], CAST({:name: plan.site.name, :min: plan.min_args, :max: plan.max_args, :got: plan.given_args} AS {String@symbol}Any)));
    END
}
END
PRIVATE FN typeAnalysisSession__inject_default_arguments_mut(MUTABLE self: TypeAnalysisSession, MUTABLE plan: CallArityPlan) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN (TRY (callArityPlan__injectable_defaults(plan))) DO
    MUTABLE injected = typeAnalysisSession__default_argument_for(&rtoc_self_view, _);
    TRY (typeAnalysisSession__visit(&rtoc_self_view, injected));
    callSignatureSite__append_arg_mut( &plan.site, injected);
    END
}
END
PRIVATE FN typeAnalysisSession__default_argument_for(MUTABLE self: TypeAnalysisSession, param: Param) RETURNS Locatable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE default: ?Locatable = COPY param.default;
    IF UNWRAP (default) IS_A DefaultLit THEN
      RETURN Locatable{ StructLit: COPY StructLit{ token: COPY UNWRAP (locatable__token(UNWRAP (default))), name: COPY type__to_s(param.type), fields: COPY {}, storage: NIL, type_args: NIL, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, borrowed_field_names: NIL, field_tokens: {} } };
    END
    RETURN CAST(COPY default AS Locatable);
}
END
PRIVATE FN typeAnalysisSession__call_argument_facts(MUTABLE self: TypeAnalysisSession, site: CallSignatureSite, param: Param, MUTABLE arg_node: Locatable, index_value: Int64) RETURNS !CallArgumentFacts
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE is_give = arg_node IS_A MoveNode;
    MUTABLE inner_node_branch_value: ?Locatable = NIL;
    IF is_give THEN
      inner_node_branch_value = CAST(aST__node_value(arg_node) AS Locatable);
    ELSE
      inner_node_branch_value = COPY arg_node;
    END
    MUTABLE inner_node: Locatable = inner_node_branch_value?;
    MUTABLE arg_type = TRY (aST__full_type_mut(arg_node));
    MUTABLE actual: ?String@symbol = locatable__resolved_type(arg_node);
    RETURN CallArgumentFacts{ site: COPY site, index: COPY index_value, param: COPY param, arg_node: COPY arg_node, is_give: is_give, inner_node: COPY inner_node, arg_type: COPY arg_type, expected_type: COPY param.type, actual_type: COPY arg_type, actual: COPY actual, path: COPY TRY (typeAnalysisSession__get_path_to_root(&rtoc_self_view, castLocatableToNode__type_analysis_session(arg_node))), explicit_mutable: callSignatureSite__explicit_mutable_argument?(site, index_value), mutable_marker_token: callSignatureSite__explicit_mutable_argument_token(site, index_value) };
}
END
PRIVATE FN typeAnalysisSession__verify_copy_retained_boundary_mut(MUTABLE self: TypeAnalysisSession, facts: CallArgumentFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE arg = COPY facts.arg_node;
    IF arg IS_A CopyNode AS copy_node THEN
      MUTABLE copy_node_mutable = COPY copy_node;
      MUTABLE src_type = (TRY (aST__full_type_mut(copy_node_mutable.value)));
      IF !(TRUE) THEN
        RETURN;
      END
      MUTABLE carrier: String = "";
      IF type__multiowned?(src_type) THEN
        carrier = "@multiowned";
      ELSE_IF type__shared?(src_type) THEN
        carrier = "@shared";
      ELSE
        carrier = "";
      END
      IF copy_node_mutable.own THEN
        copy_node_mutable.carrier_op = :shared_to_unique_copy;
        RETURN;
      END
      MUTABLE name: String = "";
      IF copy_node_mutable.value IS_A Identifier THEN
        name = COPY (CAST(copy_node_mutable.value AS Identifier)).name;
      ELSE
        name = "the value";
      END
      &rtoc_self_view.audit_inputs.deferred_copy_retained_validations.append(DeferredCopyRetainedValidation{ arg_node: Locatable{ CopyNode: COPY copy_node_mutable }, name: COPY name, carrier: COPY carrier, callee_name: COPY (aST__node_name(UNWRAP (castFunctionCallNodeToLocatable(facts.site.node))) OR_ELSE ""), param_index: facts.index });
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__warn_monomorphic_variant_explosion_mut(MUTABLE self: TypeAnalysisSession, node: FunctionDef) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE count = node.params |> COUNT (_.carrier_contract == :monomorphic);
    IF (count < 3) THEN
      RETURN;
    END
    MUTABLE variants = (3 ** count);
    print("\x1B[36m[Note]\x1B[0m '${node.name}' has ${count.toString()} MONOMORPHIC parameters, so Zig may stencil up to ${variants.toString()} (3^${count.toString()}) carrier variants of it. This is a combinatoric-explosion hazard for code size and instruction cache; if the extra carriers are not needed, constrain some parameters to a concrete carrier (plain / SHARED).");
}
END
PRIVATE FN typeAnalysisSession__verify_retained_into_plain_slot_mut(MUTABLE self: TypeAnalysisSession, facts: CallArgumentFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE arg = COPY facts.arg_node;
    IF arg IS_A CopyNode AS copy_node THEN
      RETURN;
    END
    IF arg IS_A KeepNode AS keep_node THEN
      RETURN;
    END
    IF !(facts.param.takes) THEN
      RETURN;
    END
    MUTABLE callee_fn: ?FunctionDef@multiowned = TRY (typeAnalysisSession__function_node_for(&rtoc_self_view, aST__node_name(UNWRAP (castFunctionCallNodeToLocatable(facts.site.node)))));
    IF callee_fn EXISTS AS callee_fn_value THEN
      MUTABLE callee_param: ?Param = NIL;
      IF TRUE THEN
        callee_param = COPY ((callee_fn_value.params)[facts.index]);
      END
      MUTABLE contract: String@symbol = UNWRAP (facts.param.carrier_contract);
      IF callee_param != NIL THEN
        contract = UNWRAP (callee_param.carrier_contract);
      END
      IF (((contract == :shared) OR (contract == :monomorphic)) OR (contract == :unique)) THEN
        RETURN;
      END
      MUTABLE param_type = COPY facts.param.type;
      IF (TRUE AND ((type__generic_type_parameter?(param_type) OR TRY (type__any_rc?(param_type))))) THEN
        RETURN;
      END
      IF (IF arg IS_A Identifier AS identifier THEN ((identifier.symbol != NIL) AND ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_75 = ((identifier.symbol)?);
      symbolEntry__carrier_contract(rtoc_local_receiver_75) } == :monomorphic)) ELSE FALSE END) THEN
        RETURN TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY arg }, TypeAnalysisCodeOrMessage{ SymbolValue: :RETAINED_NEEDS_OWN_COPY }, [], CAST({:name: locatable__name(arg), :carrier: "MONOMORPHIC", :param: facts.param.name} AS {String@symbol}Any)));
      END
      MUTABLE src_type = (TRY (aST__full_type_mut(arg)));
      IF !(TRUE) THEN
        RETURN;
      END
      IF type__collection?(src_type) THEN
        RETURN;
      END
      MUTABLE carrier: String = "";
      IF type__multiowned?(src_type) THEN
        carrier = "@multiowned";
      ELSE_IF type__shared?(src_type) THEN
        carrier = "@shared";
      ELSE
        carrier = "";
      END
      MUTABLE name: String = "";
      IF arg IS_A Identifier AS identifier THEN
        name = identifier__name(identifier);
      ELSE
        name = "the value";
      END
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY arg }, TypeAnalysisCodeOrMessage{ SymbolValue: :RETAINED_NEEDS_OWN_COPY }, [], CAST({:name: name, :carrier: carrier, :param: facts.param.name} AS {String@symbol}Any)));
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__verify_unique_argument_mut(MUTABLE self: TypeAnalysisSession, facts: CallArgumentFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE arg = COPY facts.arg_node;
    IF arg IS_A CopyNode AS copy_node THEN
      RETURN;
    END
    MUTABLE callee_param: ?Param = ((TRY (typeAnalysisSession__function_node_for(&rtoc_self_view, aST__node_name(UNWRAP (castFunctionCallNodeToLocatable(facts.site.node))))))?.params[facts.index]);
    MUTABLE contract: String@symbol = UNWRAP (facts.param.carrier_contract);
    IF callee_param != NIL THEN
      contract = UNWRAP ((callee_param).carrier_contract);
    END
    IF !((contract == :unique)) THEN
      RETURN;
    END
    MUTABLE src_type = (TRY (aST__full_type_mut(arg)));
    MUTABLE carrier: String = "";
    IF type__multiowned?(src_type) THEN
      carrier = "@multiowned";
    ELSE_IF type__shared?(src_type) THEN
      carrier = "@shared";
    ELSE
      carrier = "";
    END
    MUTABLE name: String = "";
    IF arg IS_A Identifier AS identifier THEN
      name = identifier__name(identifier);
    ELSE
      name = "the value";
    END
    TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY arg }, TypeAnalysisCodeOrMessage{ SymbolValue: :UNIQUE_NEEDS_EXCLUSIVE }, [], CAST({:name: name, :carrier: carrier, :param: facts.param.name} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__verify_mutable_argument_mut(MUTABLE self: TypeAnalysisSession, facts: CallArgumentFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(typeAnalysisSession__param_mutable?(&rtoc_self_view, facts.param)) THEN
      IF facts.explicit_mutable THEN
        TRY (typeAnalysisSession__emit_unexpected_mutable_argument_error_mut(&rtoc_self_view, facts));
      END
      RETURN;
    END
    MUTABLE arg_node = COPY facts.arg_node;
    MUTABLE root: ?Identifier = aST__root_identifier(arg_node);
    IF root EXISTS AS root_value THEN
      MUTABLE interior_mutable = symbolEntry__always_mutable_sync?(type__sync((TRY (aST__full_type_mut(arg_node)))));
      IF interior_mutable THEN
        TRY (typeAnalysisSession__mark_var_mutated_via_call(&rtoc_self_view, root_value.name));
        RETURN;
      END
      MUTABLE missing_marker = !(facts.explicit_mutable);
      IF missing_marker THEN
        IF (typeAnalysisSession__language_mode(&rtoc_self_view) == :easy) THEN
          IF fixCollector__enabled?() THEN
            TRY (typeAnalysisSession__emit_missing_mutable_marker_error_mut(&rtoc_self_view, facts, TRY (typeAnalysisSession__current_scope(&rtoc_self_view))));
          END
          TRY (typeAnalysisSession__promote_mutable_call_argument_mut(&rtoc_self_view, root_value));
        ELSE
          TRY (typeAnalysisSession__emit_missing_mutable_marker_error_mut(&rtoc_self_view, facts, TRY (typeAnalysisSession__current_scope(&rtoc_self_view))));
        END
      END
      IF ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_76 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
      scope__is_immutable?(rtoc_local_receiver_76, root_value.name) } AND !(missing_marker)) THEN
        IF (typeAnalysisSession__language_mode(&rtoc_self_view) == :easy) THEN
          TRY (typeAnalysisSession__promote_mutable_call_argument_mut(&rtoc_self_view, root_value));
        ELSE
          TRY (typeAnalysisSession__emit_immutable_arg_error_mut(&rtoc_self_view, root_value, TRY (typeAnalysisSession__current_scope(&rtoc_self_view)), (facts.index + 1), facts.param.name));
        END
      END
      TRY (typeAnalysisSession__mark_var_mutated_via_call(&rtoc_self_view, root_value.name));
    ELSE
      IF facts.explicit_mutable THEN
