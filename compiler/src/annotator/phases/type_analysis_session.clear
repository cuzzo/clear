PRIVATE FN typeAnalysisSession__declare_match_destructure_fields_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MatchStatement, destructure: StructPattern, payload_schema: MatchSchema, variant_name: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE struct_schema: StructSchema@multiowned = COPY castMatchSchemaToStructSchemaMultiowned(payload_schema);
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < destructure.fields.length() DO
      IF !(patternField__bind?(destructure.fields[rtoc_idx]?)) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !(struct_schema.fields.contains?(UNWRAP (destructure.fields[rtoc_idx]?.name))) THEN
          TRY (typeAnalysisSession__emit_unknown_destructure_field_mut(&rtoc_self_view, &node, destructure.fields[rtoc_idx]?, struct_schema, variant_name));
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE field_type = structField__type((struct_schema.fields[UNWRAP (destructure.fields[rtoc_idx]?.name)]?));
      MUTABLE rtoc_mutable_receiver_340 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
      TRY (scope__declare(&rtoc_mutable_receiver_340, UNWRAP (destructure.fields[rtoc_idx]?.name), NIL, castTypeToOptionalSymbolEntryTypeInput__type_analysis_session(field_type), ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
      TRY (typeAnalysisSession__og_declare(&rtoc_self_view, UNWRAP (destructure.fields[rtoc_idx]?.name), NIL, castTypeToTypeTypeInput__type_analysis_session(field_type)));
    rtoc_idx = rtoc_idx + 1;
    END
}
