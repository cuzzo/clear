    IF (node.condition IS_A ResolveNode AND ((ti.multiowned?() OR type__shared?(ti)))) THEN
      TRY (type__apply_reference_ownership_mut(&unwrapped, type__ownership(ti), ti.link_source()));
    END
    MUTABLE pre_loop_states = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_355 = typeAnalysisSession__ownership_graph(rtoc_self_view);
    ownershipGraph__fork_lightweight(rtoc_local_receiver_355) };
    MUTABLE cond = COPY node.condition;
    IF cond IS_A MethodCall THEN
      MUTABLE recv = cond.object();
      IF (recv IS_A Identifier AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_356 = typeAnalysisSession__current_scope(rtoc_self_view);
      scope__is_immutable?(rtoc_local_receiver_356, recv.name()) }) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :WHILE_AS_IMMUTABLE_RECEIVER }, [], {:method: cond.name(), :recv: recv.name(), :recv2: recv.name()});
      END
    END
    TRY (typeAnalysisSession__analyze_loop_control_flow_branches(rtoc_self_view, [proc(%() USE(node, pre_loop_states, unwrapped, MUTABLE rtoc_self_view) -> {
    MUTABLE rtoc_mutable_receiver_359 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_359, node.binding_name, NIL, unwrapped, ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    typeAnalysisSession__record_capture_local_mut(rtoc_self_view, CAST(node.binding_name AS String));
    MUTABLE entry = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_360 = typeAnalysisSession__current_scope(rtoc_self_view);
    scope__local_entry_mut(rtoc_local_receiver_360, node.binding_name) };
    typeAnalysisSession__classify_ownership_mut(rtoc_self_view, &entry);
    typeAnalysisSession__og_declare(rtoc_self_view, CAST(node.binding_name AS String), NIL, unwrapped);
    TRY (typeAnalysisSession__visit_stmts(&rtoc_self_view, node.do_branch));
    typeAnalysisSession__finalize_scope(rtoc_self_view, Locatable{ WhileBindLoop: COPY node });
    typeAnalysisSession__validate_moved_values_not_reused_by_loop_mut(rtoc_self_view, Node{ WhileBindLoop: COPY node }, Body{ ArrayValue: COPY node.do_branch }, pre_loop_states, :USE_OF_MOVED_IN_LOOP_SHORT, CAST(node.binding_name AS String));
    node.deferred_drops
    })], FALSE));
    node.mark_per_iter = FALSE;
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ WhileBindLoop: COPY node }, :Void));
}
END
PRIVATE FN typeAnalysisSession__validate_moved_values_not_reused_by_loop_mut(self: TypeAnalysisSession, node: Node, body: Body, pre_loop_states: LightweightSnapshot, code: String@symbol, ignored_name: ?String = NIL) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rtoc_each_items_361 = (typeAnalysisSession__collect_body_identifier_names(rtoc_self_view, castBodyToNodes(body)));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_361.length() DO
      IF (rtoc_each_items_361[rtoc_idx] == ignored_name) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !((lightweightSnapshot__state_for(pre_loop_states, rtoc_each_items_361[rtoc_idx]) == :live)) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE graph_node: ?OwnershipNode = COPY ownershipGraph__get_index(typeAnalysisSession__ownership_graph(rtoc_self_view), rtoc_each_items_361[rtoc_idx]);
      IF !(((graph_node != NIL) AND (graph_node.state == :moved))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF typeAnalysisSession__captured_move_consumed_by_loop?(rtoc_self_view, rtoc_each_items_361[rtoc_idx]) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF typeAnalysisSession__loop_value_copyable?(rtoc_self_view, rtoc_each_items_361[rtoc_idx]) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      typeAnalysisSession__emit_use_of_moved_in_loop_error_mut(rtoc_self_view, node, rtoc_each_items_361[rtoc_idx], graph_node, code);
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PRIVATE FN typeAnalysisSession__captured_move_consumed_by_loop?(self: TypeAnalysisSession, name: String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (((((ownershipGraph__get_index(typeAnalysisSession__ownership_graph(rtoc_self_view), name) != NIL) AND (((ownershipGraph__get_index(typeAnalysisSession__ownership_graph(rtoc_self_view), name))?).move_action == :capture)) AND (((typeAnalysisSession__current_capture_context(rtoc_self_view)?.analysis)?.captures != NIL) AND (((typeAnalysisSession__current_capture_context(rtoc_self_view)?.analysis)?.captures)?).contains?(name)))) == TRUE);
}
