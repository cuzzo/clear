PRIVATE FN typeAnalysisSession__register_container_borrow_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: DeclarationNode) RETURNS !?Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE container: ?String = TRY (typeAnalysisSession__find_container_source(&rtoc_self_view, UNWRAP (declarationNode__value(node))));
    IF container EXISTS AS container_value THEN
      MUTABLE container_value_mutable = COPY container_value;
      MUTABLE var_name: String = "";
      IF (MATCH node START DeclarationNode.VarDecl AS item -> TRUE, DeclarationNode.BindExpr AS item -> TRUE END) THEN
        PARTIAL MATCH node START
          DeclarationNode.VarDecl AS item -> var_name = COPY item.name;,
          DeclarationNode.BindExpr AS item -> var_name = COPY item.name;,
          DEFAULT -> var_name = "";
        END
      ELSE
        var_name = COPY (MATCH node START DeclarationNode.VarDecl AS item -> CAST(item.name AS String), DeclarationNode.BindExpr AS item -> CAST(item.name AS String) END);
      END
      MUTABLE rtoc_graph_8640 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
      MUTABLE graph_node: ?OwnershipNode = COPY ownershipGraph__get_index(rtoc_graph_8640, var_name);
      IF graph_node EXISTS AS graph_node_value THEN
        MUTABLE graph_node_value_mutable = COPY graph_node_value;
        graph_node_value_mutable.kind = :borrowed;
      END
      IF (TRUE AND (declarationNode__symbol(node) != NIL)) THEN
        MUTABLE rtoc_mutable_receiver_199 = UNWRAP (declarationNode__symbol(node));
        symbolEntry__mark_borrowed_alias_mut(&rtoc_mutable_receiver_199);
      END
      MATCH node START
        DeclarationNode.VarDecl AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.container_borrow = TRUE;
          node = DeclarationNode{ VarDecl: item_mutable };,
        DeclarationNode.BindExpr AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.container_borrow = TRUE;
          node = DeclarationNode{ BindExpr: item_mutable };,
      END
      MUTABLE value_node: ?Locatable = NIL;
      MATCH node START
        DeclarationNode.VarDecl AS item ->
          value_node = COPY item.value;,
        DeclarationNode.BindExpr AS item ->
          value_node = COPY item.value;,
      END
      IF (aST__node__container_borrow(UNWRAP (value_node)) EXISTS) THEN
        IF value_node EXISTS AS MUTABLE value_node_present THEN
          locatable__set_container_borrow_mut(&value_node_present, TRUE);
        END
      END
      IF TRUE THEN
        declarationNode__set_storage_override_mut(&node, :borrow);
      END
      RETURN TRUE;
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__find_container_source(MUTABLE self: TypeAnalysisSession, MUTABLE expr: ?Locatable) RETURNS !?String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE ti: ?Type = NIL;
    IF expr EXISTS AS expr_value THEN
      MUTABLE expr_value_mutable = COPY expr_value;
      IF (expr_value_mutable IS_A CopyNode OR expr_value_mutable IS_A KeepNode) THEN
        RETURN NIL;
      END
      IF (TRUE AND (aST__node__container_borrow(expr_value_mutable) OR_ELSE FALSE)) THEN
        MUTABLE receiver: ?Locatable = (aST__node_object(expr_value_mutable) OR_ELSE aST__node_target(expr_value_mutable));
        IF receiver EXISTS AS receiver_value THEN
          RETURN typeAnalysisSession__root_variable_name(&rtoc_self_view, receiver_value);
        END
      END
      IF expr_value_mutable IS_A GetIndex AS get_index THEN
        ti = TRY (aST__full_type_mut(get_index.target));
        IF TRY (type__collection_value?(UNWRAP (ti))) THEN
          RETURN typeAnalysisSession__root_variable_name(&rtoc_self_view, get_index.target);
        END
      END
      IF expr_value_mutable IS_A Slice AS slice THEN
        ti = TRY (aST__full_type_mut(slice.target));
        IF type__array?(UNWRAP (ti)) THEN
          RETURN typeAnalysisSession__root_variable_name(&rtoc_self_view, slice.target);
        END
      END
      IF expr_value_mutable IS_A GetField AS get_field THEN
        MUTABLE get_field_mutable = COPY get_field;
        RETURN TRY (typeAnalysisSession__field_container_source(&rtoc_self_view, &get_field_mutable));
      END
      MUTABLE transparent_operand: ?Locatable = aST__borrow_transparent_operand(expr_value_mutable);
      IF transparent_operand EXISTS AS MUTABLE transparent_operand_value THEN
        RETURN typeAnalysisSession__find_container_source(&rtoc_self_view, &transparent_operand_value);
      END
      RETURN NIL;
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__field_container_source(MUTABLE self: TypeAnalysisSession, MUTABLE expr: GetField) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF expr.target IS_A Identifier THEN
      MUTABLE target_schema: ?SchemaValue = TRY (typeAnalysisSession__lookup_type_schema(&rtoc_self_view, symbol(UNWRAP (aST__node_name(expr.target)))));
      IF ((schemas__union?(target_schema) OR schemas__enum?(target_schema))) THEN
        RETURN NIL;
      END
    END
    MUTABLE field_ti = TRY (aST__full_type_mut(Locatable{ GetField: COPY expr }));
    IF TRY (type__implicitly_copyable?(field_ti, %(type_name: String@symbol) USE(MUTABLE rtoc_self_view) -> TRY (typeAnalysisSession__schema_lookup_result(&rtoc_self_view, type_name)))) THEN
      RETURN NIL;
    END
    RETURN typeAnalysisSession__root_variable_name(&rtoc_self_view, expr.target);
}
END
PRIVATE FN typeAnalysisSession__effects_init_mut(MUTABLE self: TypeAnalysisSession) RETURNS EffectState
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.audit_inputs.effect_state = EffectState{ direct_effects: {}, call_site_context: {}, call_site_arg_families: {} };
    RETURN typeAnalysisSession__effect_state(&rtoc_self_view);
}
END
PRIVATE FN typeAnalysisSession__effect_state(MUTABLE self: TypeAnalysisSession) RETURNS EffectState
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN COPY UNWRAP (typeAnalysisSession__phase_audit_inputs(&rtoc_self_view).effect_state);
}
END
PRIVATE FN typeAnalysisSession__effect_direct_effects(MUTABLE self: TypeAnalysisSession) RETURNS {String}[Set]String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN COPY typeAnalysisSession__effect_state(&rtoc_self_view).direct_effects;
}
END
PRIVATE FN typeAnalysisSession__effect_call_site_context(MUTABLE self: TypeAnalysisSession) RETURNS {String}{String}{String@symbol}Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN COPY typeAnalysisSession__effect_state(&rtoc_self_view).call_site_context;
}
END
PRIVATE FN typeAnalysisSession__effect_call_site_arg_families(MUTABLE self: TypeAnalysisSession) RETURNS {String}{String}[][][Set]String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN COPY typeAnalysisSession__effect_state(&rtoc_self_view).call_site_arg_families;
}
END
PRIVATE FN typeAnalysisSession__effect_direct_effects_for(MUTABLE self: TypeAnalysisSession, fn_name: String) RETURNS ![Set]String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__set_direct_effect_mut(&rtoc_self_view, fn_name, (typeAnalysisSession__effect_direct_effects(&rtoc_self_view)[fn_name] OR_ELSE Set[]));
    RETURN COPY (typeAnalysisSession__effect_direct_effects(&rtoc_self_view)[fn_name] OR_ELSE Set[]);
}
END
PRIVATE FN typeAnalysisSession__effect_call_site_context_for(MUTABLE self: TypeAnalysisSession, caller_name: String, callee_name: String) RETURNS {String@symbol}Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__set_call_site_context_mut(&rtoc_self_view, caller_name, (typeAnalysisSession__effect_call_site_context(&rtoc_self_view)[caller_name] OR_ELSE {}));
    MUTABLE caller_context = COPY UNWRAP (typeAnalysisSession__effect_call_site_context(&rtoc_self_view)[caller_name]);
    caller_context[callee_name] = (caller_context[callee_name] OR_ELSE {:loop: FALSE, :cond: FALSE});
    typeAnalysisSession__set_call_site_context_mut(&rtoc_self_view, caller_name, COPY caller_context);
    RETURN COPY UNWRAP (caller_context[callee_name]);
}
END
PRIVATE FN typeAnalysisSession__effect_call_site_arg_families_for(MUTABLE self: TypeAnalysisSession, caller_name: String, callee_name: String) RETURNS ![][][Set]String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__set_call_site_arg_families_mut(&rtoc_self_view, caller_name, (typeAnalysisSession__effect_call_site_arg_families(&rtoc_self_view)[caller_name] OR_ELSE {}));
    MUTABLE caller_families = COPY (typeAnalysisSession__effect_call_site_arg_families(&rtoc_self_view)[caller_name] OR_ELSE {});
    IF !(caller_families.contains?(callee_name)) THEN
      caller_families[callee_name] = [];
    END
    MUTABLE rtoc_result = COPY UNWRAP (caller_families[callee_name]);
    typeAnalysisSession__set_call_site_arg_families_mut(&rtoc_self_view, caller_name, COPY caller_families);
    RETURN rtoc_result;
}
END
PRIVATE FN typeAnalysisSession__effects_begin_function(MUTABLE self: TypeAnalysisSession, fn_name: String) RETURNS ![Set]String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_index_receiver_201 = typeAnalysisSession__effect_direct_effects(&rtoc_self_view);
    rtoc_index_receiver_201[fn_name] = CAST(Set[] AS [Set]String@symbol);
    RETURN CAST(Set[] AS [Set]String@symbol);
}
END
PRIVATE FN typeAnalysisSession__record_effect(MUTABLE self: TypeAnalysisSession, effect_input: String@symbol) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE effect = COPY effect_input;
    MUTABLE fn_ctx: ?FunctionContext@multiowned = typeAnalysisSession__current_fn_ctx(&rtoc_self_view);
    IF !(fn_ctx?.name) THEN
      RETURN;
    END
    effect = typeAnalysisSession__promote_suspends_for_current_context(&rtoc_self_view, effect);
    (TRY (typeAnalysisSession__effect_direct_effects_for(&rtoc_self_view, UNWRAP (fn_ctx?.name)))).insert(COPY effect);
    IF (typeAnalysisSession__inside_snapshot_transaction_body?(&rtoc_self_view) AND anySuspendsEffect(Set[effect])) THEN
      typeAnalysisSession__record_snapshot_txn_violation_mut(&rtoc_self_view, effect, UNWRAP (fn_ctx).name);
    END
    NIL;
}
END
PRIVATE FN typeAnalysisSession__promote_suspends_for_current_context(MUTABLE self: TypeAnalysisSession, effect: String@symbol) RETURNS String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !((effect == :SUSPENDS)) THEN
      RETURN effect;
    END
    IF (typeAnalysisSession__current_loop_depth(&rtoc_self_view) > 0) THEN
      RETURN :SUSPENDS_LOOP;
    ELSE_IF (typeAnalysisSession__current_conditional_depth(&rtoc_self_view) > 0) THEN
      RETURN :SUSPENDS_CONDITIONAL;
    ELSE
      RETURN :SUSPENDS;
    END
}
END
PRIVATE FN typeAnalysisSession__record_call_site(MUTABLE self: TypeAnalysisSession, callee_name: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_ctx: ?FunctionContext@multiowned = typeAnalysisSession__current_fn_ctx(&rtoc_self_view);
    IF !(fn_ctx?.name) THEN
      RETURN;
    END
    MUTABLE caller_name: ?String = COPY fn_ctx?.name;
    MUTABLE in_loop = (typeAnalysisSession__current_loop_depth(&rtoc_self_view) > 0);
    MUTABLE in_cond = (typeAnalysisSession__current_conditional_depth(&rtoc_self_view) > 0);
    IF !((in_loop OR in_cond)) THEN
      RETURN;
    END
    MUTABLE existing = typeAnalysisSession__effect_call_site_context_for(&rtoc_self_view, UNWRAP (caller_name), callee_name);
    existing[:loop] = ((existing[:loop] OR_ELSE FALSE) OR in_loop);
    existing[:cond] = (existing[:cond] OR_ELSE in_cond);
    NIL;
}
END
PRIVATE FN typeAnalysisSession__record_call_arg_families(MUTABLE self: TypeAnalysisSession, callee_name: String, arg_family_sets: [][Set]String@symbol) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_ctx: ?FunctionContext@multiowned = typeAnalysisSession__current_fn_ctx(&rtoc_self_view);
    IF !(fn_ctx?.name) THEN
      RETURN;
    END
    (TRY (typeAnalysisSession__effect_call_site_arg_families_for(&rtoc_self_view, UNWRAP (fn_ctx?.name), callee_name))).append(COPY arg_family_sets);
}
END
PRIVATE FN typeAnalysisSession__validate_tight_body_mut(MUTABLE self: TypeAnalysisSession, stmts: AstScanInput, loop_node: TightLoopNode) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = TRY (typeAnalysisSession__function_node_map(&rtoc_self_view));
    aST__each_locatable( castAstScanInputToLocatable(stmts), FALSE, %(node: Locatable) USE(fn_nodes, loop_node, MUTABLE rtoc_self_view) -> {
    TRY (typeAnalysisSession__validate_tight_node_mut(&rtoc_self_view, node, loop_node, fn_nodes));
    rubyToClearVoid__type_analysis_session()
    });
}
END
PRIVATE FN typeAnalysisSession__validate_tight_node_mut(MUTABLE self: TypeAnalysisSession, node: Locatable, loop_node: TightLoopNode, fn_nodes: {String}FunctionDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node IS_A FuncCall AS func_call THEN
      IF (TRUE AND (func_call.extern_call OR_ELSE FALSE)) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castTightLoopNodeToLocatable(loop_node)), TypeAnalysisCodeOrMessage{ SymbolValue: :TIGHT_CALLS_EXTERN_FN }, [], CAST({:name: funcCall__name(func_call)} AS {String@symbol}Any)));
      END
      MUTABLE fn: ?FunctionDef = COPY fn_nodes[callName__string_value(funcCall__name(func_call))];
      IF ((fn != NIL) AND (fn.reentrance_kind == :reentrant)) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castTightLoopNodeToLocatable(loop_node)), TypeAnalysisCodeOrMessage{ SymbolValue: :TIGHT_CALLS_REENTRANT_FN }, [], CAST({:name: funcCall__name(func_call)} AS {String@symbol}Any)));
      END
    ELSE_IF (node IS_A MethodCall) THEN
      IF (IF node IS_A FuncCall AS func_call THEN func_call.extern_call ELSE FALSE END) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castTightLoopNodeToLocatable(loop_node)), TypeAnalysisCodeOrMessage{ SymbolValue: :TIGHT_CALLS_EXTERN_FN }, [], CAST({:name: locatable__name(node)} AS {String@symbol}Any)));
      END
      MUTABLE fn: ?FunctionDef = COPY fn_nodes[UNWRAP (locatable__name(node))];
      IF ((fn != NIL) AND (fn.reentrance_kind == :reentrant)) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castTightLoopNodeToLocatable(loop_node)), TypeAnalysisCodeOrMessage{ SymbolValue: :TIGHT_CALLS_REENTRANT_FN }, [], CAST({:name: locatable__name(node)} AS {String@symbol}Any)));
      END
    END
}
END
PRIVATE FN typeAnalysisSession__with_block_suspends?(MUTABLE self: TypeAnalysisSession, node: WithBlock) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN ((TRY (withCapabilityPlan__locks((TRY (capabilityPlan__require_for(node)))))).length() > 0);
}
END
PRIVATE FN typeAnalysisSession__func_call_suspends?(MUTABLE self: TypeAnalysisSession, node: CallLikeNode) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = TRY (typeAnalysisSession__function_node_map(&rtoc_self_view));
    IF (IF callLikeNode__matched_stdlib_def(node) != NIL THEN
      { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_202: ?FunctionSignature@multiowned = (callLikeNode__matched_stdlib_def(node));
    TRY (functionSignature__intrinsic_suspends?(UNWRAP (rtoc_mutable_receiver_202))) }
    ELSE
      NIL
    END) THEN
      RETURN TRUE;
    END
    IF (IF node IS_A FuncCall AS func_call THEN func_call.fn_var_call ELSE FALSE END) THEN
      RETURN FALSE;
    END
    MUTABLE callee: ?FunctionDef@multiowned = COPY fn_nodes[UNWRAP (callLikeNode__name(node))];
    IF callee EXISTS AS callee_value THEN
      MUTABLE effs: ?[Set]String@symbol = callee_value.effects;
      RETURN ((effs != NIL) AND anySuspendsEffect(effs));
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__bridge_reentrance_mut(MUTABLE self: TypeAnalysisSession, program_node: Program) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < program_node.statements.length() DO
      IF !(UNWRAP (program_node.statements[rtoc_idx]) IS_A FunctionDef) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE fn_node: ?Locatable = program_node.statements[rtoc_idx];
      MUTABLE kind: ?String@symbol = typeAnalysisSession__canonical_reentrance_kind(rtoc_self_view, UNWRAP (castLocatableToFunctionDef(UNWRAP (fn_node))));
      IF fn_node EXISTS AS MUTABLE fn_node_present THEN
        locatable__set_reentrance_kind_mut(&fn_node_present, kind);
      END
      IF (kind == :reentrant_tail_call) THEN
          IF fn_node EXISTS AS MUTABLE fn_node_present THEN
            locatable__set_tail_call_mut(&fn_node_present, TRUE);
          END
      ELSE_IF (kind == :reentrant_not_logical) THEN
    
      ELSE_IF (kind == :reentrant_max_depth) THEN
          MUTABLE budget = symbol("RECURSION_YIELD_BUDGET");
          IF (((locatable__max_depth_n(UNWRAP (fn_node)) OR_ELSE 0)) <= CAST(budget AS Int64)) THEN
            MUTABLE rtoc_fn_slot = UNWRAP (fn_node); locatable__set_tight_reentrance_mut(&rtoc_fn_slot, TRUE);
          ELSE
            MUTABLE rtoc_fn_slot2 = UNWRAP (fn_node); locatable__set_tight_reentrance_mut(&rtoc_fn_slot2, FALSE);
          END
      END
      TRY (typeAnalysisSession__validate_requires_clauses_mut(&rtoc_self_view, UNWRAP (castLocatableToFunctionDef(UNWRAP (fn_node)))));
      TRY (typeAnalysisSession__validate_not_logical_return_mut(&rtoc_self_view, UNWRAP (castLocatableToFunctionDef(UNWRAP (fn_node)))));
      TRY (typeAnalysisSession__offer_unconstrained_fn_param_fix_mut(&rtoc_self_view, UNWRAP (castLocatableToFunctionDef(UNWRAP (fn_node)))));
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PRIVATE FN typeAnalysisSession__offer_plain_reentrant_variant_fix_mut(MUTABLE self: TypeAnalysisSession, fn_node: FunctionDef, body_facts: TypeAnalysisBodyFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !((fn_node.reentrance_kind == :reentrant)) THEN
      RETURN;
    END
    IF !(fn_node.effects_span) THEN
      RETURN;
    END
    IF !((fn_node.effects_decl == :reentrant)) THEN
      RETURN;
    END
    MUTABLE suggestion_reason: []String = ( { MUTABLE rtoc_empty_list_203: []String = List[]; rtoc_empty_list_203 } );
    IF typeAnalysisSession__thunk_all_self_calls_in_tail_position?(rtoc_self_view, fn_node, body_facts) THEN
      suggestion_reason = ["EFFECTS REENTRANT:TAIL_CALL", "all self-calls are in tail position; TCO turns this into a self-`jmp` loop with depth=1"];
    ELSE_IF TRY (recursiveSplitter__split(fn_node.body, fn_node.name)) THEN
      suggestion_reason = ["EFFECTS REENTRANT:THUNK", "the body matches the simple-recurrence shape; heap CPS keeps the fiber stack at depth=1"];
    END
    IF (suggestion_reason.length() == 0) THEN
      RETURN;
    END
    MUTABLE suggestion = COPY UNWRAP (suggestion_reason.first());
    MUTABLE edits: []Edit@multiowned = TRY (typeAnalysisSession__effects_clause_edits(rtoc_self_view, fn_node, suggestion));
    IF (edits.length() == 0) THEN
      RETURN;
    END
    MUTABLE span: ?EffectSpan = COPY fn_node.effects_span;
    MUTABLE reason = COPY UNWRAP (suggestion_reason[1]);
    TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, (IF span?.start_token EXISTS AS rtoc_wrap_9038 THEN DiagnosticAnchor{ TokenValue: COPY rtoc_wrap_9038 } ELSE NIL END), :reentrance, [TRY (fix__new(TRY (typeAnalysisSession__fix_description(rtoc_self_view, :REPLACE_REENTRANT_WITH_VARIANT, CAST({:suggestion: DiagnosticKwValue{ StringValue: COPY suggestion }, :reason: DiagnosticKwValue{ StringValue: COPY reason }} AS {String@symbol}DiagnosticKwValue))), edits, :auto))], NIL, :PLAIN_REENTRANT_VARIANT_SUGGESTION, :info, FALSE, CAST({:fn: fn_node.name, :reason: reason, :suggestion: suggestion} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__validate_not_logical_return_mut(MUTABLE self: TypeAnalysisSession, fn_node: FunctionDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(([:reentrant_not_logical, :reentrant_max_depth]).contains?(fn_node.reentrance_kind)) THEN
      RETURN;
    END
    MUTABLE rt: ?Type = functionDef__declared_return_type(fn_node);
    IF rt EXISTS AS rt_value THEN
      IF type__error_union?(rt_value) THEN
      RETURN;
    END
    END
    MUTABLE rt_str: String = "";
    IF rt THEN
      rt_str = COPY CAST(rt AS String);
    ELSE
      rt_str = "Void";
    END
    MUTABLE suggested: String = "";
    IF (rt == NIL) THEN
      suggested = "!Void";
    ELSE
      suggested = "!${compilerRegexReplaceFirst(rt_str, compilerRegexCompile("\\A!"), "")}";
    END
    MUTABLE err_name: String = "";
    IF (fn_node.reentrance_kind == :reentrant_not_logical) THEN
      err_name = "UnexpectedRecursion";
    ELSE
      err_name = "MaxDepthExceeded";
    END
    MUTABLE variant_text: String = "";
    IF (fn_node.reentrance_kind == :reentrant_not_logical) THEN
      variant_text = "EFFECTS REENTRANT:NOT_LOGICAL";
    ELSE
      variant_text = "EFFECTS REENTRANT:MAX_DEPTH(${(UNWRAP (fn_node.max_depth_n)).toString()})";
    END
    TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ FunctionDef: COPY fn_node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :REENTRANT_NEEDS_FALLIBLE_RETURN }, [], CAST({:variant_text: variant_text, :fn: fn_node.name, :err: err_name, :rt: rt_str, :suggested: suggested} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__route_thunk_to_tail_call_compat_mut(MUTABLE self: TypeAnalysisSession, MUTABLE fn_node: FunctionDef, body_facts: TypeAnalysisBodyFacts) RETURNS ?Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !((fn_node.reentrance_kind == :reentrant_thunk)) THEN
      RETURN NIL;
    END
    IF !(typeAnalysisSession__thunk_all_self_calls_in_tail_position?(rtoc_self_view, fn_node, body_facts)) THEN
      RETURN NIL;
    END
    fn_node.tail_call = TRUE;
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__validate_tail_call_mut(MUTABLE self: TypeAnalysisSession, fn_node: FunctionDef, body_scan: BodyScanSummary) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_name = fn_node.name;
    MUTABLE all_self_calls = body_scan.call_site_facts |> SELECT:? (  IF (_.callee_name == fn_name) THEN
      COPY _.node
    ELSE
      NIL
    END) |> WHERE _ != NIL;
    MUTABLE blessed = body_scan.return_nodes |> SELECT:? {
    MUTABLE value: ?Locatable = _.value;
    (  IF (IF UNWRAP (value) IS_A FuncCall AS rtoc_fc THEN (callName__string_value(rtoc_fc.name) == fn_name) ELSE FALSE END) THEN
        value
      ELSE
        NIL
      END)
    } |> WHERE _ != NIL;
    MUTABLE blessed_ids = (blessed |> SELECT aST__node_identity(UNWRAP (_))) |> DISTINCT _;
    IF (blessed.length() == 0) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ FunctionDef: COPY fn_node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :TAIL_CALL_NEEDS_RECURSIVE }, [], CAST({:fn: fn_name} AS {String@symbol}Any)));
    END
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < all_self_calls.length() DO
      IF blessed_ids.contains?(aST__node_identity(UNWRAP (all_self_calls[rtoc_idx]))) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY UNWRAP (all_self_calls[rtoc_idx]) }, TypeAnalysisCodeOrMessage{ SymbolValue: :TAIL_CALL_NOT_TAIL_POSITION }, [], CAST({:fn: fn_name} AS {String@symbol}Any)));
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PRIVATE FN typeAnalysisSession__canonical_reentrance_kind(self: TypeAnalysisSession, fn_node: FunctionDef) RETURNS ?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN fn_node.effects_decl;
}
END
PRIVATE FN typeAnalysisSession__offer_unconstrained_fn_param_fix_mut(MUTABLE self: TypeAnalysisSession, fn_node: FunctionDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF ([:reentrant, :reentrant_thunk, :reentrant_tail_call, :reentrant_not_logical, :reentrant_max_depth]).contains?(fn_node.reentrance_kind) THEN
      RETURN;
    END
    IF !(fn_node.arrow_token) THEN
      RETURN;
    END
    MUTABLE existing = (fn_node.requires_clauses OR_ELSE {});
    MUTABLE candidates: []String = List[];
    FOR _ IN fn_node.params DO
      MUTABLE name = COPY _.name;
      IF existing.contains?(name) THEN
        CONTINUE;
      END
      MUTABLE type = COPY _.type;
      IF !(type__fn_type?(type)) THEN
        CONTINUE;
      END
      MUTABLE raw: ?TypeShapeRaw = type__raw(type);
      IF (IF raw EXISTS AS rtoc_raw_v THEN (IF rtoc_raw_v IS_A FunctionType AS rtoc_fn_shape THEN (rtoc_fn_shape.reentrant == TRUE) ELSE FALSE END) ELSE FALSE END) THEN
        CONTINUE;
      END
      &candidates.append(COPY name);
    END
    IF (candidates.length() == 0) THEN
      RETURN;
    END
    MUTABLE arrow: Token = COPY fn_node.arrow_token;
    MUTABLE requires_insert = (candidates |> SELECT "REQUIRES ${_}: NON_REENTRANT ").join("");
    MUTABLE requires_desc = (candidates |> SELECT "REQUIRES ${_}: NON_REENTRANT").join(" + ");
    MUTABLE constrain_fix = TRY (fix__new(TRY (typeAnalysisSession__fix_description(rtoc_self_view, :ADD_NON_REENTRANT_REQUIRES, CAST({:requires: DiagnosticKwValue{ StringValue: COPY requires_desc }} AS {String@symbol}DiagnosticKwValue))), [edit__new(span__new(NIL, arrow.line, arrow.column, 2), "${requires_insert}->")], :auto));
    MUTABLE propagate_fix = TRY (fix__new(TRY (typeAnalysisSession__fix_description(rtoc_self_view, :DECLARE_FN_REENTRANT, {:fn: DiagnosticKwValue{ StringValue: COPY CAST(fn_node.name AS String) }})), [edit__new(span__new(NIL, arrow.line, arrow.column, 2), "EFFECTS REENTRANT ->")], :interactive));
    MUTABLE msg_subject: String = "";
    IF (candidates.length() == 1) THEN
      msg_subject = "an unconstrained FN-typed parameter";
    ELSE
      msg_subject = "unconstrained FN-typed parameters";
    END
    TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ TokenValue: COPY arrow }, :lint, [constrain_fix, propagate_fix], NIL, :UNCONSTRAINED_FN_PARAM_REENTRANCE, :warning, FALSE, CAST({:fn: COPY fn_node.name, :subject: msg_subject, :candidates: candidates.join(", ")} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__validate_requires_clauses_mut(MUTABLE self: TypeAnalysisSession, fn_node: FunctionDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF ((fn_node.requires_clauses == NIL) OR fn_node.requires_clauses.empty?()) THEN
      RETURN;
    END
    MUTABLE param_names = ((fn_node.params |> SELECT _.name) |> WHERE TRUE) |> DISTINCT _;
    FOR rtoc_each_key IN fn_node.requires_clauses.keys() DO
    MUTABLE ignored_kind = COPY UNWRAP (fn_node.requires_clauses[rtoc_each_key]);
    IF param_names.contains?(rtoc_each_key) THEN
      CONTINUE;
    END
    TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ FunctionDef: COPY fn_node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :REQUIRES_NON_REENTRANT_NOT_PARAM }, [], CAST({:fn: fn_node.name, :name: rtoc_each_key} AS {String@symbol}Any)));
    END
}
END
PRIVATE FN typeAnalysisSession__effects_clause_edits(self: TypeAnalysisSession, fn_node: FunctionDef, replacement: String) RETURNS ![]Edit
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE span: ?EffectSpan = COPY fn_node.effects_span;
    IF !(span) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_204: []Edit = List[]; rtoc_empty_list_204 } ) AS []Edit);
    END
    MUTABLE s = span.start_token;
    MUTABLE e = span.end_token;
    IF (s.line != e.line) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_205: []Edit = List[]; rtoc_empty_list_205 } ) AS []Edit);
    END
    MUTABLE end_col = (e.column + (CAST(e.value AS String)).codepointCount());
    RETURN CAST([edit__new(span__new(NIL, s.line, s.column, (end_col - s.column)), replacement)] AS []Edit);
}
END
PRIVATE FN typeAnalysisSession__thunk_all_self_calls_in_tail_position?(self: TypeAnalysisSession, fn_node: FunctionDef, body_facts: TypeAnalysisBodyFacts) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE all = UNWRAP (typeAnalysisBodyFacts__call_site_facts(body_facts)) |> SELECT:? (  IF (_.callee_name == fn_node.name) THEN
      COPY _.node
    ELSE
      NIL
    END) |> WHERE _ != NIL;
    IF (all.length() == 0) THEN
      RETURN FALSE;
    END
    MUTABLE blessed = UNWRAP (typeAnalysisBodyFacts__return_nodes(body_facts)) |> SELECT:? (  IF (UNWRAP (_.value) IS_A FuncCall AND (aST__node_name(UNWRAP (_.value)) == fn_node.name)) THEN
      _.value
    ELSE
      NIL
    END) |> WHERE _ != NIL;
    IF (blessed.length() == 0) THEN
      RETURN FALSE;
    END
    MUTABLE blessed_ids = (blessed |> SELECT aST__node_identity( UNWRAP (_))) |> DISTINCT _;
    RETURN all |> ALL blessed_ids.contains?(aST__node_identity( UNWRAP (_)));
}
END
PRIVATE FN typeAnalysisSession__cap_var_sync(self: TypeAnalysisSession, MUTABLE var_node: Locatable) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE sym_sync: ?String = (IF aST__node__symbol(var_node) != NIL THEN
      symbolEntry__sync(UNWRAP ((aST__node__symbol(var_node))))
    ELSE
      NIL
    END);
    IF sym_sync THEN
      RETURN sym_sync;
    END
    RETURN type__sync((TRY (aST__full_type_mut(var_node))));
}
END
PRIVATE FN typeAnalysisSession__cap_var_storage(MUTABLE self: TypeAnalysisSession, MUTABLE var_node: Locatable) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF aST__node__symbol(var_node) EXISTS AS sym THEN
      RETURN symbolEntry__storage(sym);
    END
    RETURN type__ownership_storage((TRY (aST__full_type_mut(var_node))));
}
END
PRIVATE FN typeAnalysisSession__cap_var_layout(MUTABLE self: TypeAnalysisSession, MUTABLE var_node: Locatable) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE sym_layout: ?String = (IF aST__node__symbol(var_node) != NIL THEN
      symbolEntry__layout(UNWRAP ((aST__node__symbol(var_node))))
    ELSE
      NIL
    END);
    IF sym_layout THEN
      RETURN sym_layout;
    END
    RETURN type__layout((TRY (aST__full_type_mut(var_node))));
}
END
PRIVATE FN typeAnalysisSession__cap_var_label(MUTABLE self: TypeAnalysisSession, var_node: Locatable) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF var_node IS_A Identifier AS identifier THEN
      RETURN COPY identifier__name(identifier);
    ELSE_IF var_node IS_A GetField AS get_field THEN
      RETURN COPY CAST(get_field.field AS String);
    ELSE_IF var_node IS_A GetIndex AS get_index THEN
      RETURN capabilityPlan__var_name_for(Locatable{ GetIndex: COPY get_index });
    ELSE
      RETURN COPY "__unknown";
    END
}
END
PRIVATE FN typeAnalysisSession__validate_capability_transition_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: WithBlock, fact: CapabilityTransition) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE var_node = COPY fact.var_node;
    MUTABLE var_type = COPY fact.resolved_type;
    IF !(typeAnalysisSession__valid_capability_target?(&rtoc_self_view, fact.capability, var_node)) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY var_node }, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_CAP_BAD_TARGET }, [], CAST({:capability: fact.capability, :got: DiagnosticKwValue{ StringValue: locatable__variant_name(var_node) }} AS {String@symbol}Any)));
    END
    IF (fact.capability == symbol("EXCLUSIVE")) THEN
      IF (capabilityTransition__exclusive_validation_action(fact) == :valid) OR (capabilityTransition__exclusive_validation_action(fact) == :declared_contract) THEN
    
      ELSE_IF (capabilityTransition__exclusive_validation_action(fact) == :defer) THEN
        TRY (typeAnalysisSession__record_deferred_with_validation_mut(&rtoc_self_view, &node, fact));
      ELSE
        MUTABLE storage: ?String@symbol = COPY fact.storage;
        MUTABLE name = COPY fact.target_label;
        TRY (typeAnalysisSession__emit_with_cap_mismatch_mut(&rtoc_self_view, &node, name, :WITH_EXCLUSIVE_NEEDS_LOCK, [CapabilityFixCandidate{ sigil: "@locked", description_code: :WITH_ADD_LOCKED, description_params: {} }, CapabilityFixCandidate{ sigil: "@writeLocked", description_code: :WITH_ADD_WRITE_LOCKED, description_params: CAST({:reader: DiagnosticKwValue{ StringValue: COPY "can coexist via WITH READ" }} AS {String@symbol}DiagnosticKwValue) }], :interactive, CAST({:got: DiagnosticKwValue{ SymbolValue: COPY UNWRAP (storage)}} AS {String@symbol}DiagnosticKwValue)));
      END
    ELSE_IF (fact.capability == :write_locked_read) THEN
      IF !(capabilityTransition__write_locked_sync?(fact)) THEN
        IF capabilityTransition__deferred_sync_param?(fact) THEN
          TRY (typeAnalysisSession__record_deferred_with_validation_mut(&rtoc_self_view, &node, fact));
        ELSE
          MUTABLE name = COPY fact.target_label;
          TRY (typeAnalysisSession__emit_with_read_needs_write_lock_mut(&rtoc_self_view, &node, name, &var_node));
        END
      END
    ELSE_IF (fact.capability == symbol("RESTRICT")) THEN
      IF ((IF var_node IS_A Identifier AS identifier THEN (identifier.symbol != NIL) ELSE FALSE END) AND !(UNWRAP (aST__node__symbol(Locatable{ WithBlock: COPY node })).mutable)) THEN
        TRY (typeAnalysisSession__emit_with_restrict_immutable_error_mut(&rtoc_self_view, &node, castLocatableToIdentifier__type_analysis_session(var_node)));
      END
    ELSE_IF (fact.capability == symbol("BORROWED")) THEN
  
    ELSE_IF (fact.capability == symbol("VIEW")) THEN
      MUTABLE t_branch_value: ?Type = NIL;
      IF TRUE THEN
        t_branch_value = var_type;
      ELSE
        t_branch_value = TRY (type__new(castTypeToTypeConstructionInput__type_analysis_session(var_type)));
      END
      MUTABLE t: Type = t_branch_value?;
      IF TRY (type__c_array_view?(t)) THEN
        TRY (typeAnalysisSession__emit_foreign_with_view_needs_unsafe_mut(&rtoc_self_view, &node, fact));
        RETURN;
      END
      IF !((type__future?(t) AND type__observable?(t))) THEN
        IF var_node IS_A Identifier AS identifier THEN
          TRY (typeAnalysisSession__emit_view_not_observable_finding_mut(&rtoc_self_view, &node, fact, t));
        ELSE
          MUTABLE name = COPY fact.target_label;
          TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_VIEW_NEEDS_OBSERVABLE }, [], CAST({:name: name, :got: type__resolved(t)} AS {String@symbol}Any)));
        END
      END
    ELSE_IF (fact.capability == :MATERIALIZED_VIEW) THEN
      MUTABLE t_branch_value: ?Type = NIL;
      IF TRUE THEN
        t_branch_value = var_type;
      ELSE
        t_branch_value = TRY (type__new(castTypeToTypeConstructionInput__type_analysis_session(var_type)));
      END
      MUTABLE t: Type = t_branch_value?;
      IF !(type__future?(t)) THEN
        MUTABLE name = COPY fact.target_label;
        TRY (typeAnalysisSession__emit_with_materialized_needs_tense_mut(&rtoc_self_view, &node, name, TypeTypeInput{ StringValue: CAST(type__resolved(t) AS String) }));
      END
    ELSE_IF (fact.capability == :UNSAFE_VIEW) THEN
      MUTABLE t_branch_value: ?Type = NIL;
      IF TRUE THEN
        t_branch_value = var_type;
      ELSE
        t_branch_value = TRY (type__new(castTypeToTypeConstructionInput__type_analysis_session(var_type)));
      END
      MUTABLE t: Type = t_branch_value?;
      IF !(TRY (type__c_array_view?(t))) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_UNSAFE_VIEW_NEEDS_FOREIGN_POINTER }, [], CAST({:got: TRY (type__surface_name(castTypeToTypeTypeInput__type_analysis_session(t)))} AS {String@symbol}Any)));
      END
      MUTABLE length: ?Locatable = COPY fact.view_length;
      IF length EXISTS AS length_value THEN
        MUTABLE length_value_mutable = COPY length_value;
        TRY (typeAnalysisSession__visit(&rtoc_self_view, length_value_mutable));
        MUTABLE length_type = TRY (aST__full_type_mut(length_value_mutable));
        IF !(type__integer?(length_type)) THEN
          TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY length_value_mutable }, TypeAnalysisCodeOrMessage{ SymbolValue: :RANK_INDEX_INTEGER }, [], CAST({:got: type__resolved(length_type)} AS {String@symbol}Any)));
        END
      ELSE
        panic("Internal: WITH UNSAFE VIEW missing LENGTH expression");
      END
    ELSE_IF (fact.capability == symbol("SNAPSHOT")) THEN
      MUTABLE snapshot_sync: ?String@symbol = COPY fact.sync;
      MUTABLE snapshot_layout: ?String@symbol = COPY fact.layout;
      MUTABLE atomic_ptr_ok = ((snapshot_sync == :atomic) AND (snapshot_layout == :indirect));
      IF !(((snapshot_sync == :versioned) OR atomic_ptr_ok)) THEN
        MUTABLE name = COPY fact.target_label;
        MUTABLE storage: ?String@symbol = COPY fact.storage;
        MUTABLE actual: String = "";
        IF ((snapshot_sync != NIL) AND (snapshot_layout == :indirect)) THEN
          actual = "@boxed:${snapshot_sync}";
        ELSE_IF snapshot_sync EXISTS AS snapshot_sync_value THEN
          actual = "@${snapshot_sync_value}";
        ELSE
          IF storage THEN
            actual = "@${storage}";
          ELSE
            actual = "plain";
          END
        END
        TRY (typeAnalysisSession__emit_with_cap_mismatch_mut(&rtoc_self_view, &node, name, :WITH_SNAPSHOT_NEEDS_VERSIONED_OR_ATOMIC, [CapabilityFixCandidate{ sigil: "@versioned", description_code: :WITH_ADD_VERSIONED, description_params: {} }, CapabilityFixCandidate{ sigil: "@boxed:atomic", description_code: :WITH_ADD_INDIRECT_ATOMIC, description_params: {} }], :interactive, CAST({:name: DiagnosticKwValue{ StringValue: COPY name }, :actual: DiagnosticKwValue{ StringValue: COPY actual }} AS {String@symbol}DiagnosticKwValue)));
      END
    ELSE_IF (fact.capability == :multiowned) THEN
      IF !((fact.storage == :multiowned)) THEN
        MUTABLE name = COPY fact.target_label;
        TRY (typeAnalysisSession__emit_with_cap_mismatch_mut(&rtoc_self_view, &node, name, :WITH_NEEDS_MULTIOWNED, [CapabilityFixCandidate{ sigil: "@multiowned", description_code: :WITH_ADD_MULTIOWNED, description_params: CAST({:suffix: DiagnosticKwValue{ StringValue: COPY " via WITH" }} AS {String@symbol}DiagnosticKwValue) }], :auto, CAST({:name: DiagnosticKwValue{ StringValue: COPY name }} AS {String@symbol}DiagnosticKwValue)));
      END
    ELSE_IF (fact.capability == :shared) THEN
      IF !((fact.storage == :shared)) THEN
        MUTABLE name = COPY fact.target_label;
        TRY (typeAnalysisSession__emit_with_cap_mismatch_mut(&rtoc_self_view, &node, name, :WITH_NEEDS_SHARED, [CapabilityFixCandidate{ sigil: "@shared", description_code: :WITH_ADD_SHARED, description_params: CAST({:suffix: DiagnosticKwValue{ StringValue: COPY "to clone across fibers" }} AS {String@symbol}DiagnosticKwValue) }], :auto, CAST({:name: DiagnosticKwValue{ StringValue: COPY name }} AS {String@symbol}DiagnosticKwValue)));
      END
    ELSE_IF (fact.capability == :ATOMIC) THEN
      MUTABLE syn: ?String@symbol = COPY fact.sync;
      IF !((syn == :atomic)) THEN
        IF capabilityTransition__deferred_sync_param?(fact) THEN
          TRY (typeAnalysisSession__record_deferred_with_validation_mut(&rtoc_self_view, &node, fact));
        ELSE
          MUTABLE name = COPY fact.target_label;
          MUTABLE storage: ?String@symbol = COPY fact.storage;
          MUTABLE actual: String = "";
          IF syn EXISTS AS syn_value THEN
            actual = "@${syn_value}";
          ELSE
            IF storage EXISTS AS rtoc_storage_v THEN
              actual = "@${rtoc_storage_v}";
            ELSE
              actual = COPY "plain";
            END
          END
          TRY (typeAnalysisSession__emit_with_cap_mismatch_mut(&rtoc_self_view, &node, name, :WITH_ATOMIC_NEEDS_SHARED_ATOMIC, [CapabilityFixCandidate{ sigil: "@shared:atomic", description_code: :WITH_ADD_SHARED_ATOMIC, description_params: {} }], :auto, CAST({:name: DiagnosticKwValue{ StringValue: COPY name }, :actual: DiagnosticKwValue{ StringValue: COPY actual }} AS {String@symbol}DiagnosticKwValue)));
        END
      END
    ELSE
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :UNKNOWN_WITH_CAP_TYPE }, [], CAST({:type: fact.capability} AS {String@symbol}Any)));
    END
}
END
PRIVATE FN typeAnalysisSession__valid_capability_target?(MUTABLE self: TypeAnalysisSession, capability_type: String@symbol, var_node: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (var_node IS_A Identifier OR var_node IS_A GetField) THEN
      RETURN TRUE;
    END
    RETURN ((capability_type == symbol("BORROWED")) AND var_node IS_A GetIndex);
}
END
PRIVATE FN typeAnalysisSession__emit_view_not_observable_finding_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: WithBlock, fact: CapabilityTransition, var_type: Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE name = COPY fact.target_label;
    MUTABLE msg = "WITH VIEW requires an `@observable` source, but '${name}' has type ${type__resolved(var_type)}. Use `WITH MATERIALIZED VIEW` for non-observable aggregates, or annotate the binding as `~T@observable`.";
    MUTABLE view_tok: ?Token = COPY capability__view_token(fact.source);
    MUTABLE fixes = List[];
    IF view_tok EXISTS AS view_tok_value THEN
      &fixes.append(TRY (fix__new(TRY (typeAnalysisSession__fix_description(rtoc_self_view, :WITH_VIEW_TO_MATERIALIZED)), [edit__new(span__new(NIL, view_tok_value.line, view_tok_value.column, "VIEW".codepointCount()), "MATERIALIZED VIEW")], :auto)));
    END
    IF (fixes.length() == 0) THEN
      RETURN TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_VIEW_NEEDS_OBSERVABLE }, [], CAST({:name: name, :got: type__resolved(var_type)} AS {String@symbol}Any)));
    END
    TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, :capability, fixes, NIL, :WITH_VIEW_NEEDS_OBSERVABLE, :error, FALSE, CAST({:name: name, :got: type__resolved(var_type)} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__predicate_identifier_allowed_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: Identifier) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE ctx: ?PredicateContext = typeAnalysisSession__current_predicate_context(&rtoc_self_view);
    IF ctx EXISTS AS ctx_value THEN
      IF (["TRUE", "FALSE"]).contains?(node.name) THEN
        RETURN;
      END
      IF (ctx_value.kind == :guard) THEN
        MUTABLE own_alias: ?String = COPY ctx_value.guard_alias;
        IF own_alias EXISTS AS own_alias_value THEN
          IF (node.name == own_alias_value) THEN
            RETURN;
          END
          MUTABLE sibling_aliases = COPY ctx_value.sibling_aliases;
          IF sibling_aliases.contains?(node.name) THEN
            TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ Identifier: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_GUARD_REFS_SIBLING_ALIAS }, [], CAST({:own_alias: own_alias_value, :name: node.name, :remediation: "Use an `IF` guard clause inside the WITH body for cross-alias checks."} AS {String@symbol}Any)));
          ELSE
            TRY (typeAnalysisSession__emit_typo_suggestion_mut(&rtoc_self_view, TypoToken{ TokenMultiowned: COPY node.token }, node.name, [own_alias_value], "WITH GUARD can only reference the guarded alias '${own_alias_value}'. Found '${node.name}'.", "the guarded alias", :capability, TRUE));
          END
        ELSE
          RETURN;
        END
      ELSE_IF (ctx_value.kind == :pre) THEN
        MUTABLE params = COPY ctx_value.param_names;
        IF params.contains?(node.name) THEN
          RETURN;
        END
        TRY (typeAnalysisSession__emit_typo_suggestion_mut(&rtoc_self_view, TypoToken{ TokenMultiowned: COPY node.token }, node.name, params, "PRE clauses may only reference function parameters. Found '${node.name}', which is not a parameter of '${(ctx_value.fn_name OR_ELSE "")}'.", "a parameter of '${(ctx_value.fn_name OR_ELSE "")}'", :type, TRUE));
      ELSE_IF (ctx_value.kind == :post) THEN
        MUTABLE allowed = COPY ctx_value.allowed_names;
        MUTABLE rejected = COPY ctx_value.rejected_param_names;
        IF !(allowed.contains?(node.name)) THEN
          RETURN TRY (typeAnalysisSession__emit_typo_suggestion_mut(&rtoc_self_view, TypoToken{ TokenMultiowned: COPY node.token }, node.name, allowed, "DEBUG_POST clauses may only reference function parameters or 'result'. Found '${node.name}', which is not in scope for '${(ctx_value.fn_name OR_ELSE "")}'.", "a parameter of '${(ctx_value.fn_name OR_ELSE "")}' or 'result'", :type, TRUE));
        END
        IF rejected.contains?(node.name) THEN
          TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ Identifier: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :DEBUG_POST_NEEDS_UNSYNC_PARAM }, [], CAST({:name: node.name} AS {String@symbol}Any)));
        END
      END
      NIL;
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__record_predicate_call_site_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: Node) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE ctx: ?PredicateContext = typeAnalysisSession__current_predicate_context(&rtoc_self_view);
    IF ctx EXISTS AS ctx_value THEN
      &rtoc_self_view.audit_inputs.predicate_call_sites.append(PredicateCallSite{ kind: COPY ctx_value.kind, with_node: COPY ctx_value.with_node, fn_node: COPY ctx_value.fn_node, pred_expr: COPY ctx_value.pred_expr, call: COPY castNodeToPredicateCall(node), callee: (COPY aST__node_name(UNWRAP (castNodeToLocatable(node))) OR_ELSE "")});
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__validate_and_visit_with_guards_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: WithBlock) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE capability_plan = TRY (capabilityPlan__require_for(node));
    MUTABLE caps = COPY capability_plan.all;
    MUTABLE guarded = TRY (withCapabilityPlan__guarded(capability_plan));
    IF (guarded.length() == 0) THEN
      RETURN;
    END
    IF node.arms EXISTS AS arms_value THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_GUARD_NOT_WITH_MATCH }));
    END
    IF (node.snapshot_mode == :transaction) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_GUARD_NOT_ON_SNAPSHOT }));
    END
    MUTABLE missing_alias = caps |> WHERE !(_.alias_explicit);
    IF !(missing_alias.empty?()) THEN
      TRY (typeAnalysisSession__emit_with_guard_all_bindings_need_as_mut(&rtoc_self_view, &node, missing_alias));
    END
    MUTABLE aliases = caps |> SELECT _.alias_name;
    FOR _ IN guarded DO
    MUTABLE own = COPY _.alias_name;
    MUTABLE siblings = (aliases |> WHERE (_ != own));
    MUTABLE guard_expr = COPY UNWRAP (_.guard_expr);
    typeAnalysisSession__with_predicate_context(&rtoc_self_view, PredicateContext{ kind: :guard, with_node: COPY node, fn_node: NIL, pred_expr: COPY guard_expr, guard_alias: COPY own, sibling_aliases: COPY siblings, param_names: ( { MUTABLE rtoc_empty_list_206: []String = List[]; rtoc_empty_list_206 } ), allowed_names: ( { MUTABLE rtoc_empty_list_207: []String = List[]; rtoc_empty_list_207 } ), rejected_param_names: COPY Set[], fn_name: NIL }, %() USE(MUTABLE guard_expr, MUTABLE rtoc_self_view) -> {
      TRY (typeAnalysisSession__visit(&rtoc_self_view, guard_expr));
      MUTABLE guard_type = TRY (aST__full_type_mut(guard_expr));
      IF !((TRUE AND (type__resolved(guard_type) == :Bool))) THEN
          TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY guard_expr }, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_GUARD_EXPR_MUST_BE_BOOL }, [], CAST({:got: type__resolved(guard_type)} AS {String@symbol}Any)));
      END
      NIL
    });
    END
}
END
PRIVATE FN typeAnalysisSession__visit_pre_clauses_mut(MUTABLE self: TypeAnalysisSession, fn_node: FunctionDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE pre_clauses = (fn_node.pre_clauses OR_ELSE List[]);
    IF pre_clauses.empty?() THEN
      RETURN;
    END
    IF !(fn_node.explicit_return_type) THEN
      MUTABLE arrow_tok = COPY fn_node.arrow_token;
      IF arrow_tok THEN
        MUTABLE fixes = [TRY (fix__new(TRY (typeAnalysisSession__fix_description(rtoc_self_view, :INSERT_RETURNS_FALLIBLE_VOID)), [edit__new(span__new(NIL, arrow_tok.line, arrow_tok.column, 0), "RETURNS !Void ")], :auto))];
        TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ FunctionDef: COPY fn_node } }, :type, fixes, NIL, :PRE_CLAUSES_NEED_EXPLICIT_FALLIBLE_RETURN, :error, FALSE, CAST({:fn: fn_node.name} AS {String@symbol}Any)));
      ELSE
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ FunctionDef: COPY fn_node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :PRE_CLAUSES_NEED_EXPLICIT_FALLIBLE_RETURN }, [], CAST({:fn: fn_node.name} AS {String@symbol}Any)));
      END
    END
    MUTABLE param_names = fn_node.params |> SELECT _.name;
    FOR _ IN pre_clauses DO
    MUTABLE expr: ?ContractClauseValue = _[:expr];
    typeAnalysisSession__with_predicate_context(&rtoc_self_view, PredicateContext{ kind: :pre, with_node: NIL, fn_node: COPY fn_node, pred_expr: COPY CAST(expr AS Locatable), guard_alias: NIL, sibling_aliases: ( { MUTABLE rtoc_empty_list_208: []String = List[]; rtoc_empty_list_208 } ), param_names: COPY param_names, allowed_names: ( { MUTABLE rtoc_empty_list_209: []String = List[]; rtoc_empty_list_209 } ), rejected_param_names: COPY Set[], fn_name: COPY fn_node.name }, %() USE(MUTABLE expr, MUTABLE rtoc_self_view) -> {
      TRY (typeAnalysisSession__visit(&rtoc_self_view, castContractClauseValueToLocatable(UNWRAP (expr))));
      MUTABLE pred_type = TRY (aST__full_type_mut(UNWRAP (castContractClauseValueToLocatable(UNWRAP (expr)))));
      IF !((TRUE AND (type__resolved(pred_type) == :Bool))) THEN
          TRY (typeAnalysisSession__error_mut(&rtoc_self_view, (IF expr EXISTS AS rtoc_expr_v THEN (IF rtoc_expr_v IS_A Locatable AS rtoc_loc_v THEN DiagnosticAnchor{ Locatable: COPY rtoc_loc_v } ELSE NIL END) ELSE NIL END), TypeAnalysisCodeOrMessage{ SymbolValue: :PRE_EXPR_MUST_BE_BOOL }, [], CAST({:got: type__resolved(pred_type)} AS {String@symbol}Any)));
      END
      NIL
    });
    END
}
END
PRIVATE FN typeAnalysisSession__visit_post_clauses_mut(MUTABLE self: TypeAnalysisSession, fn_node: FunctionDef) RETURNS !?Scope@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE post_clauses: []{String@symbol}ContractClauseValue = List[];
    IF TRUE THEN
      post_clauses = ((fn_node.post_clauses OR_ELSE List[]));
    ELSE
      post_clauses = ( { MUTABLE rtoc_empty_list_210: []{String@symbol}ContractClauseValue = List[]; rtoc_empty_list_210 } );
    END
    IF (post_clauses.length() == 0) THEN
      RETURN NIL;
    END
    MUTABLE has_catch = typeAnalysisSession__function_has_catch_clauses?(&rtoc_self_view, fn_node);
    MUTABLE has_default_catch = typeAnalysisSession__function_has_default_catch?(&rtoc_self_view, fn_node);
    IF (has_catch OR has_default_catch) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ FunctionDef: COPY fn_node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :DEBUG_POST_NOT_WITH_CATCH }));
    END
    MUTABLE param_names = fn_node.params |> SELECT _.name;
    MUTABLE rejected = (fn_node.params |> SELECT:? { MUTABLE rtoc_value_block_marker = 0; MUTABLE sym: ?SymbolEntry@multiowned = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_211 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
    scope__resolve_entry(rtoc_local_receiver_211, _.name) }; (IF !(((sym != NIL) AND ([:locked, :write_locked, :versioned, :atomic]).contains?(symbolEntry__sync(sym)))) THEN NIL ELSE _.name END) } |> WHERE _ != NIL |> SELECT COPY UNWRAP (_)) |> DISTINCT _;
    MUTABLE rt: ?Type = COPY fn_node.return_type;
    MUTABLE payload_branch_value: ?Type = NIL;
    IF ((rt != NIL) AND type__error_union?(rt)) THEN
      payload_branch_value = TRY (type__payload_type(rt));
    ELSE
      payload_branch_value = rt;
    END
    MUTABLE payload: ?Type = payload_branch_value;
    typeAnalysisSession__with_new_scope(&rtoc_self_view, typeAnalysisSession__current_scope(&rtoc_self_view), %() USE(fn_node, param_names, payload, post_clauses, rejected, MUTABLE rtoc_self_view) -> {
    IF payload EXISTS AS payload_value THEN
        MUTABLE payload_value_mutable = COPY payload_value;
        MUTABLE rtoc_mutable_receiver_212 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
        TRY (scope__declare(&rtoc_mutable_receiver_212, "result", NIL, castTypeToOptionalSymbolEntryTypeInput__type_analysis_session(payload_value_mutable), ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    END
    MUTABLE allowed_names = (param_names + ["result"]);
    FOR _ IN post_clauses DO
      MUTABLE expr: ?ContractClauseValue = COPY _[:expr];
      typeAnalysisSession__with_predicate_context(&rtoc_self_view, PredicateContext{ kind: :post, with_node: NIL, fn_node: COPY fn_node, pred_expr: COPY CAST(expr AS Locatable), guard_alias: NIL, sibling_aliases: ( { MUTABLE rtoc_empty_list_213: []String = List[]; rtoc_empty_list_213 } ), param_names: ( { MUTABLE rtoc_empty_list_214: []String = List[]; rtoc_empty_list_214 } ), allowed_names: COPY allowed_names, rejected_param_names: COPY rejected, fn_name: COPY fn_node.name }, %() USE(MUTABLE expr, MUTABLE rtoc_self_view) -> {
        TRY (typeAnalysisSession__visit(&rtoc_self_view, UNWRAP (castContractClauseValueToLocatable(UNWRAP (expr)))));
        MUTABLE pred_type = TRY (aST__full_type_mut(UNWRAP (castContractClauseValueToLocatable(UNWRAP (expr)))));
        IF !((TRUE AND (type__resolved(pred_type) == :Bool))) THEN
            TRY (typeAnalysisSession__error_mut(&rtoc_self_view, (IF expr EXISTS AS rtoc_pe THEN (IF rtoc_pe IS_A Locatable AS rtoc_pl THEN DiagnosticAnchor{ Locatable: COPY rtoc_pl } ELSE NIL END) ELSE NIL END), TypeAnalysisCodeOrMessage{ SymbolValue: :DEBUG_POST_EXPR_MUST_BE_BOOL }, [], CAST({:got: type__resolved(pred_type)} AS {String@symbol}Any)));
        END
        NIL
      });
    END
    NIL
    });
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__validate_with_guard_no_body_mutation_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: WithBlock) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE capability_plan = TRY (capabilityPlan__require_for(node));
    IF ((TRY (withCapabilityPlan__guarded(capability_plan))).length() == 0) THEN
      RETURN;
    END
    MUTABLE mutable_caps = capability_plan.all |> WHERE (_.alias_mutable AND _.alias_explicit);
    IF mutable_caps.empty?() THEN
      RETURN;
    END
    MUTABLE mutated = (mutable_caps |> SELECT _.alias_name) |> WHERE TRY (typeAnalysisSession__alias_mutated?(&rtoc_self_view, _));
    IF mutated.empty?() THEN
      RETURN;
    END
    MUTABLE is_or_are: String = "";
    IF ((mutated).length() == 1) THEN
      is_or_are = "is";
    ELSE
      is_or_are = "are";
    END
    TRY (typeAnalysisSession__emit_with_guard_mutable_mutated_mut(&rtoc_self_view, &node, mutated, is_or_are));
}
END
PRIVATE FN typeAnalysisSession__alias_mutated?(MUTABLE self: TypeAnalysisSession, alias_name: String) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE scope: ?Scope@multiowned = TRY (typeAnalysisSession__lookup_scope_for(&rtoc_self_view, alias_name));
    IF scope EXISTS AS scope_value THEN
      RETURN !(!((IF scope__resolve_entry(scope_value, alias_name) != NIL THEN
        { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_215: ?SymbolEntry@multiowned = (scope__resolve_entry(scope_value, alias_name));
      symbolEntry__mutated(UNWRAP (rtoc_local_receiver_215)) }
      ELSE
        NIL
      END)));
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__acquire_capability_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: WithBlock, MUTABLE cap: Capability, MUTABLE expanded: WithCapabilityPlan) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE var_node = COPY capability__var_node(cap);
    TRY (typeAnalysisSession__visit(&rtoc_self_view, var_node));
    cap.resolved_type = TRY (aST__full_type_mut(var_node));
    MUTABLE abstract_shared_map = TRY (typeAnalysisSession__generic_parameter_has_shared_map_bound?(&rtoc_self_view, type__resolved(capability__resolved_type(cap))));
    IF abstract_shared_map THEN
      IF !(node.polymorphic) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_SHARED_MAP_REQUIRES_WITH }, [], CAST({:type: type__resolved(capability__resolved_type(cap))} AS {String@symbol}Any)));
      END
      node.universal_poly = TRUE;
    END
    cap.old_scope = TRY (typeAnalysisSession__lookup_scope_for(&rtoc_self_view, capabilityPlan__var_name_for(var_node)));
    IF (capability__capability(cap) == :infer) THEN
      MUTABLE storage: ?String@symbol = TRY (typeAnalysisSession__cap_var_storage(&rtoc_self_view, &var_node));
      MUTABLE syn: ?String@symbol = TRY (typeAnalysisSession__cap_var_sync(rtoc_self_view, &var_node));
      cap.capability = IF (syn == :locked) THEN
        symbol("EXCLUSIVE")
      ELSE_IF (syn == :write_locked) THEN
        :write_locked_read
      ELSE_IF (syn == :versioned) THEN
        symbol("SNAPSHOT")
      ELSE_IF (syn == :atomic) THEN
        :ATOMIC
      ELSE_IF ((((TRUE AND (node.polymorphic OR_ELSE FALSE))) AND (((syn == NIL) OR (syn == :local)))) AND ((((((storage == NIL) OR (storage == :local)) OR (storage == :multiowned)) OR (storage == :stack)) OR (storage == :heap)))) THEN
        {
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE root: ?Identifier = aST__root_identifier(var_node);
    MUTABLE is_mut = ((capability__alias_mutable(cap) OR (IF aST__node__symbol(Locatable{ WithBlock: COPY node }) != NIL THEN
        (aST__node__symbol(Locatable{ WithBlock: COPY node })).mutable()
      ELSE
        NIL
      END)) OR root?.symbol?.mutable);
    (IF is_mut THEN
        {
    MUTABLE rtoc_value_block_marker = 0;
    cap.alias_mutable = TRUE;
    symbol("RESTRICT")
      }
      ELSE
        symbol("BORROWED")
      END)
      }
      ELSE_IF (storage == :multiowned) THEN
        :multiowned
      ELSE_IF (storage == :shared) THEN
        :shared
      ELSE
        {
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE name = typeAnalysisSession__cap_var_label(&rtoc_self_view, var_node);
    TRY (typeAnalysisSession__emit_with_cannot_infer_cap_mut(&rtoc_self_view, &node, name));
    :unknown
      }
      END;
    END
    MUTABLE fact = TRY (typeAnalysisSession__with_capability_fact(&rtoc_self_view, cap));
    TRY (typeAnalysisSession__validate_capability_transition_mut(&rtoc_self_view, &node, fact));
    IF (TRUE AND (node.arms != NIL)) THEN
  
    ELSE
      IF (fact.capability == symbol("EXCLUSIVE")) OR (fact.capability == :write_locked_read) THEN
        TRY (typeAnalysisSession__record_effect(&rtoc_self_view, symbol("BLOCKING")));
        TRY (typeAnalysisSession__record_effect(&rtoc_self_view, symbol("CONTENTION")));
      ELSE_IF (fact.capability == symbol("SNAPSHOT")) THEN
        TRY (typeAnalysisSession__record_effect(&rtoc_self_view, symbol("CONTENTION")));
      END
    END
    MUTABLE audit_root: ?Identifier = aST__root_identifier(var_node);
    IF ((audit_root != NIL) AND (((fact.capability == symbol("EXCLUSIVE")) OR (((node.polymorphic OR_ELSE FALSE) AND capability__alias_mutable(cap)))))) THEN
      TRY (typeAnalysisSession__audit_mark_mutated(&rtoc_self_view, audit_root.name));
    END
    IF (IF var_node IS_A GetField AS get_field THEN getField__wildcard?(get_field) ELSE FALSE END) THEN
      MUTABLE target_type = UNWRAP locatable__resolved_type(UNWRAP ((locatable__target(var_node))));
      MUTABLE schema: ?SchemaValue = TRY (typeAnalysisSession__lookup_type_schema(&rtoc_self_view, target_type));
      MUTABLE fields = schemaValue__fields(UNWRAP (schema));
      FOR rtoc_each_key IN fields.keys() DO
    MUTABLE ignored_1 = COPY UNWRAP (fields[rtoc_each_key]);
    (TRY (typeAnalysisSession__visit(&rtoc_self_view, Locatable{ GetField: COPY rtoc_each_key })));
    MUTABLE expanded_cap = Capability{ capability: COPY capability__capability(cap), var_node: Locatable{ GetField: COPY rtoc_each_key }, old_scope: COPY capability__old_scope(cap), resolved_type: CAST(COPY TRY (aST__full_type_mut(rtoc_each_key)) AS Type), alias_value: NIL, alias_mutable: FALSE, guard_expr: NIL, snapshot_token: NIL, view_token: NIL, view_length: NIL, as_token: NIL };
    withCapabilityPlan__add( &expanded, TRY (typeAnalysisSession__with_capability_fact(&rtoc_self_view, rtoc_each_key)));
      END
      MUTABLE base_t = aST__full_type_mut(UNWRAP (locatable__target(var_node)));
      MUTABLE rtoc_each_key = Capability{ capability: COPY capability__capability(cap), var_node: COPY UNWRAP (locatable__target(var_node)), old_scope: COPY capability__old_scope(cap), resolved_type: COPY rtoc_each_key, alias_value: NIL, alias_mutable: FALSE, guard_expr: NIL, snapshot_token: NIL, view_token: NIL, view_length: NIL, as_token: NIL };
      withCapabilityPlan__add( &expanded, TRY (typeAnalysisSession__with_capability_fact(&rtoc_self_view, rtoc_each_key)));
    ELSE
      withCapabilityPlan__add( &expanded, fact);
    END
}
END
PRIVATE FN typeAnalysisSession__with_capability_fact(MUTABLE self: TypeAnalysisSession, cap: Capability) RETURNS !CapabilityTransition
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE request = capabilityRequest__from_ast(cap);
    MUTABLE var_node: Locatable = COPY castLocatableToLocatable__type_analysis_session(capability__var_node(cap));
    MUTABLE var_name = capabilityPlan__var_name_for(var_node);
    MUTABLE resolved = COPY capability__resolved_type(cap);
    MUTABLE old_scope: ?Scope@multiowned = CAST(capability__old_scope(cap) AS ?Scope@multiowned);
    MUTABLE source_entry: ?SymbolEntry@multiowned = NIL;
    IF old_scope != NIL THEN
      source_entry = COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_216 = old_scope;
    scope__resolve_entry(rtoc_local_receiver_216, var_name) };
    END
    MUTABLE source_type_branch_value: ?Type = NIL;
    IF source_entry EXISTS AS source_entry_value THEN
      source_type_branch_value = TRY (type__new(TypeConstructionInput{ Type: COPY symbolEntry__type(source_entry_value) }));
    ELSE
      source_type_branch_value = TRY (type__new(castTypeToTypeConstructionInput__type_analysis_session(resolved)));
    END
    MUTABLE source_type: Type = source_type_branch_value?;
    MUTABLE sync: ?String@symbol = TRY (typeAnalysisSession__cap_var_sync(rtoc_self_view, &var_node));
    MUTABLE target = CapabilityTargetFact{ var_node: COPY var_node, var_name: COPY var_name, target_label: COPY typeAnalysisSession__cap_var_label(&rtoc_self_view, var_node), field_target: var_node IS_A GetField, index_target: var_node IS_A GetIndex, resolved_type: COPY TRY (type__new(castTypeToTypeConstructionInput__type_analysis_session(resolved))), old_scope: old_scope, source_entry: source_entry, sync: COPY sync, storage: COPY TRY (typeAnalysisSession__cap_var_storage(&rtoc_self_view, &var_node)), layout: COPY TRY (typeAnalysisSession__cap_var_layout(&rtoc_self_view, &var_node)), source_type: COPY source_type, live_symbol_refreshed: FALSE };
    RETURN TRY (capabilityPlan__transition_from(request, target, typeAnalysisSession__borrowed_source_qualifier(&rtoc_self_view, source_entry)));
}
END
PRIVATE FN typeAnalysisSession__borrowed_source_qualifier(MUTABLE self: TypeAnalysisSession, entry: ?SymbolEntry) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF entry EXISTS AS entry_value THEN
      MUTABLE storage_qualifier: ?String = COPY (CAST({:shared: "@shared", :multiowned: "@multiowned"} AS {String@symbol}String))[symbolEntry__storage(entry_value)];
      IF storage_qualifier EXISTS AS storage_qualifier_value THEN
        RETURN COPY storage_qualifier_value;
      END
      IF symbolEntry__locked?(entry_value) THEN
        RETURN COPY "@locked";
      END
      IF symbolEntry__write_locked?(entry_value) THEN
        RETURN COPY "@writeLocked";
      END
      RETURN NIL;
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__declare_capability_scope_mut(MUTABLE self: TypeAnalysisSession, fact: CapabilityTransition) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF capabilityTransition__unwraps_sync_alias?(fact) THEN
      TRY (typeAnalysisSession__declare_unwrapped_capability_alias_mut(&rtoc_self_view, fact));
    END
    TRY (typeAnalysisSession__declare_capability_binding_or_error_mut(&rtoc_self_view, fact));
    TRY (typeAnalysisSession__declare_capability_projection_mut(&rtoc_self_view, fact));
    MUTABLE alias_name = COPY fact.alias_name;
    MUTABLE alias_name_value: String = alias_name;
    IF TRUE THEN
      MUTABLE rtoc_local_receiver_217 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
      IF scope__resolve_entry(rtoc_local_receiver_217, alias_name_value) EXISTS AS MUTABLE rtoc_alias_entry THEN
        &rtoc_alias_entry.capabilities.insert(COPY fact.capability);
      END
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__declare_capability_binding_or_error_mut(MUTABLE self: TypeAnalysisSession, fact: CapabilityTransition) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_218 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
    scope__declare_with_new_capability(&rtoc_mutable_receiver_218, fact.source) } THEN
      RETURN;
    END
    TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY fact.var_node }, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_CAP_BINDING_LOST }, [], CAST({:capability: fact.capability, :name: fact.var_name} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__declare_capability_projection_mut(MUTABLE self: TypeAnalysisSession, fact: CapabilityTransition) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (fact.capability == symbol("RESTRICT")) THEN
      TRY (typeAnalysisSession__declare_restrict_capability_mut(&rtoc_self_view, fact));
    ELSE_IF (fact.capability == symbol("VIEW")) OR (fact.capability == :MATERIALIZED_VIEW) OR (fact.capability == :UNSAFE_VIEW) THEN
      TRY (typeAnalysisSession__declare_view_capability_mut(&rtoc_self_view, fact));
    ELSE_IF (fact.capability == symbol("SNAPSHOT")) THEN
      TRY (typeAnalysisSession__declare_snapshot_capability_mut(&rtoc_self_view, fact));
    ELSE_IF (fact.capability == symbol("BORROWED")) THEN
      TRY (typeAnalysisSession__declare_borrowed_capability_mut(&rtoc_self_view, fact));
    END
}
END
PRIVATE FN typeAnalysisSession__declare_unwrapped_capability_alias_mut(MUTABLE self: TypeAnalysisSession, fact: CapabilityTransition) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE alias_name = COPY fact.alias_name;
    MUTABLE inner_type = TRY (typeAnalysisSession__unwrapped_capability_alias_type(&rtoc_self_view, fact));
    MUTABLE rtoc_mutable_receiver_219 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
    TRY (scope__declare(&rtoc_mutable_receiver_219, alias_name, NIL, SymbolEntryTypeInput{ TypeMultiowned: COPY inner_type }, ScopeMutabilityInput{ BoolValue: TRUE }, FALSE, NIL, :heap));
    IF fact.alias_explicit THEN
      typeAnalysisSession__record_capture_local_mut(&rtoc_self_view, alias_name);
    END
    MUTABLE alias_entry = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_220 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
    scope__local_entry_mut(&rtoc_local_receiver_220, alias_name) };
    symbolEntry__mark_non_escaping_mut(&alias_entry);
    symbolEntry__mark_borrowed_alias_mut(&alias_entry);
    TRY (typeAnalysisSession__og_declare(&rtoc_self_view, alias_name, NIL, TypeTypeInput{ Type: COPY inner_type }));
}
END
PRIVATE FN typeAnalysisSession__unwrapped_capability_alias_type(MUTABLE self: TypeAnalysisSession, fact: CapabilityTransition) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE source_type_branch_value: ?Type@multiowned = NIL;
    IF fact.field_target THEN
      source_type_branch_value = TRY (aST__full_type_mut(fact.var_node));
    ELSE
      source_type_branch_value = capabilityTransition__declared_source_type(fact);
    END
    MUTABLE source_type: Type@multiowned = source_type_branch_value?;
    RETURN CAST(TRY (typeAnalysisSession__capability_alias_type(&rtoc_self_view, CAST(source_type AS Type))) AS Type);
}
END
PRIVATE FN typeAnalysisSession__declare_restrict_capability_mut(MUTABLE self: TypeAnalysisSession, fact: CapabilityTransition) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_mutable_receiver_221 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
    TRY (ownershipGraph__borrow(&rtoc_mutable_receiver_221, "__restrict_${fact.var_name}", fact.var_name, TRUE));
    IF fact.alias_mutable THEN
      TRY (typeAnalysisSession__mark_var_mutated(&rtoc_self_view, fact.var_name));
    END
    IF capabilityTransition__declares_plain_restrict_alias?(fact) THEN
      TRY (typeAnalysisSession__declare_restrict_alias_mut(&rtoc_self_view, fact));
    END
}
END
PRIVATE FN typeAnalysisSession__declare_restrict_alias_mut(MUTABLE self: TypeAnalysisSession, fact: CapabilityTransition) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE alias_name = COPY fact.alias_name;
    MUTABLE resolved_type = TRY (typeAnalysisSession__capability_alias_type(&rtoc_self_view, CAST(typeAnalysisSession__capability_source_type(&rtoc_self_view, fact) AS Type)));
    MUTABLE rtoc_mutable_receiver_222 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
    TRY (scope__declare(&rtoc_mutable_receiver_222, alias_name, NIL, SymbolEntryTypeInput{ TypeMultiowned: COPY resolved_type }, ScopeMutabilityInput{ BoolValue: fact.alias_mutable }, FALSE, NIL, :stack));
    typeAnalysisSession__record_capture_local_mut(&rtoc_self_view, alias_name);
    MUTABLE sym = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_223 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
    scope__local_entry_mut(&rtoc_local_receiver_223, alias_name) };
    symbolEntry__mark_non_escaping_mut(&sym);
    symbolEntry__mark_borrowed_alias_mut(&sym);
    TRY (typeAnalysisSession__og_declare(&rtoc_self_view, alias_name, NIL, TypeTypeInput{ Type: COPY resolved_type }));
}
END
PRIVATE FN typeAnalysisSession__declare_view_capability_mut(MUTABLE self: TypeAnalysisSession, fact: CapabilityTransition) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE bind_type = TRY (typeAnalysisSession__view_capability_alias_type(&rtoc_self_view, fact));
    MUTABLE alias_name = COPY fact.alias_name;
    MUTABLE rtoc_mutable_receiver_224 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
    TRY (scope__declare(&rtoc_mutable_receiver_224, alias_name, NIL, SymbolEntryTypeInput{ TypeMultiowned: COPY bind_type }, ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    typeAnalysisSession__record_capture_local_mut(&rtoc_self_view, alias_name);
    IF ((fact.capability == symbol("VIEW")) OR (fact.capability == :UNSAFE_VIEW)) THEN
      TRY (typeAnalysisSession__declare_view_borrow_constraints_mut(&rtoc_self_view, alias_name));
    END
    TRY (typeAnalysisSession__og_declare(&rtoc_self_view, alias_name, NIL, TypeTypeInput{ Type: COPY bind_type }));
}
END
PRIVATE FN typeAnalysisSession__view_capability_alias_type(MUTABLE self: TypeAnalysisSession, fact: CapabilityTransition) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (fact.capability == :UNSAFE_VIEW) THEN
      MUTABLE element = UNWRAP (TRY (type__element_type(fact.resolved_type)));
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("${TRY (type__surface_name(castTypeToTypeTypeInput__type_analysis_session(element)))}[]") }, NIL, NIL, NIL, :borrow));
    END
    RETURN TRY (type__tense_type((TRY (type__new(castTypeToTypeConstructionInput__type_analysis_session(fact.resolved_type))))));
}
END
PRIVATE FN typeAnalysisSession__declare_view_borrow_constraints_mut(MUTABLE self: TypeAnalysisSession, alias_name: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
