PRIVATE FN typeAnalysisSession__warn_multi_atomic_bare_value_call_mut(MUTABLE self: TypeAnalysisSession, node: FunctionCallNode, atomic_args: []Locatable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE unique_args = atomic_args |> WHERE TRUE;
    IF ((unique_args).length() < 2) THEN
      RETURN;
    END
    MUTABLE names: []String = List[];
    MUTABLE rtoc_name_i = 0;
    WHILE rtoc_name_i < unique_args.length() DO
      MUTABLE rtoc_arg = unique_args[rtoc_name_i];
      IF rtoc_arg IS_A Identifier THEN
        &names.append(COPY (aST__node_name(rtoc_arg) OR_ELSE "<expr>"));
      ELSE
        &names.append("<expr>");
      END
      rtoc_name_i = rtoc_name_i + 1;
    END
    typeAnalysisSession__warning_mut(&rtoc_self_view, UNWRAP (castFunctionCallNodeToLocatable(node)), "Call to '${(functionCallNode__name(node) OR_ELSE "")}' reads multiple atomic values independently (${names.join(", ")}). This is not a multi-object-consistent snapshot; default mode allows it as ordinary atomic loads. STRICT/STRICT EXTREME will require an explicit @inconsistent call-site annotation.");
}
END
PRIVATE FN typeAnalysisSession__verify_param_lifetime_mut(MUTABLE self: TypeAnalysisSession, arg_node: Locatable, param: Param, signature: FunctionSignature) RETURNS !Bool
  REQUIRES self: LOCAL
