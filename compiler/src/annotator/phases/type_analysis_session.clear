PRIVATE FN typeAnalysisSession__visit_FuncCall(MUTABLE self: TypeAnalysisSession, MUTABLE node: FuncCall) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__normalize_explicit_mutable_arguments_mut(rtoc_self_view, Node{ FuncCall: COPY node });
    FOR _ IN node.args DO
    typeAnalysisSession__annotate_call_argument_mut(&rtoc_self_view, node, _);
    END
    IF (node.name == "native_call") THEN
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ FuncCall: COPY node }, :Any));
      RETURN;
    END
    IF typeAnalysisSession__resolve_user_protocol_function_call_mut(&rtoc_self_view, &node) THEN
      typeAnalysisSession__record_predicate_call_site_mut(rtoc_self_view, Node{ FuncCall: COPY node });
      typeAnalysisSession__record_named_call_site_mut(rtoc_self_view, &node);
      RETURN;
    END
    typeAnalysisSession__resolve_call(&rtoc_self_view, FunctionCallNode{ FuncCall: COPY node }, node.args);
    typeAnalysisSession__record_predicate_call_site_mut(rtoc_self_view, Node{ FuncCall: COPY node });
    typeAnalysisSession__record_named_call_site_mut(rtoc_self_view, &node);
    typeAnalysisSession__record_held_lock_call_site_mut(rtoc_self_view, node);
    NIL;
}
END
PRIVATE FN typeAnalysisSession__resolve_user_protocol_function_call_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: FuncCall) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF typeAnalysisSession__lookup_scope_for(rtoc_self_view, node.name) THEN
      RETURN FALSE;
    END
    MUTABLE matches: []Tuple<ProtocolDef, ProtocolRequirement, Type, Int64> = ( { MUTABLE rtoc_empty_list_284: []Tuple<ProtocolDef, ProtocolRequirement, Type, Int64> = List[]; rtoc_empty_list_284 } );
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < node.args.length() DO
      MUTABLE receiver = &node.args[rtoc_idx].full_type_mut({:context: "protocol function dispatch"});
      MUTABLE rtoc_each_items_285 = typeAnalysisSession__user_protocol_names_for_receiver(rtoc_self_view, receiver);
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < rtoc_each_items_285.length() DO
          IF (rtoc_each_items_285[rtoc_idx]? == "Map") THEN
            rtoc_idx = rtoc_idx + 1;
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
          END
          MUTABLE protocol: ?ProtocolDef = typeAnalysisSession__semantic_protocol(rtoc_self_view, rtoc_each_items_285[rtoc_idx]?);
          MUTABLE requirement = protocol?.requirements |> FIND ((!(_.is_method) AND (_.name == node.name)) AND (((IF _.params[rtoc_idx] != NIL THEN
              (_.params[rtoc_idx]).type()
            ELSE
              NIL
            END) != NIL) AND ((((IF _.params[rtoc_idx] != NIL THEN
              (_.params[rtoc_idx]).type()
            ELSE
              NIL
            END))?).resolved() == :Self)));
          IF ((protocol != NIL) AND requirement) THEN
              &matches.append([protocol, requirement, receiver, rtoc_idx]);
          END
        rtoc_idx = rtoc_idx + 1;
      END
    rtoc_idx = rtoc_idx + 1;
    END
    &matches.uniq_mut(%(protocol: Tuple<ProtocolDef, ProtocolRequirement, Type, Int64>, requirement, ignored_receiver) -> [protocol.name(), requirement.name()]);
    IF (matches.length() == 0) THEN
      RETURN FALSE;
    END
    IF (matches.length() > 1) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_PROTOCOL_FUNCTION_AMBIGUOUS }, [], {:name: node.name, :protocols: (matches |> SELECT _.first().name()).join(", ")});
    END
    MUTABLE protocol, requirement, receiver, receiver_index = UNWRAP (matches.first());
    MUTABLE signature = typeAnalysisSession__protocol_requirement_signature(rtoc_self_view, protocol, requirement, receiver);
    typeAnalysisSession__verify_function_signature_mut(&rtoc_self_view, FunctionCallNode{ FuncCall: COPY node }, signature, node.args);
    node.matched_signature = signature;
    node.protocol_name = protocol.name;
    node.protocol_operation = symbol(requirement.name);
    node.protocol_receiver_index = receiver_index;
    typeAnalysisSession__stamp_resolved_call_result_mut(rtoc_self_view, FunctionCallNode{ FuncCall: COPY node }, CAST(functionSignature__return_type(signature) AS Type), functionSignature__recoverable_result?(signature));
    IF functionSignature__reentrant(signature) THEN
      typeAnalysisSession__record_effect(rtoc_self_view, symbol("REENTRANT"));
    END
    IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
        MUTABLE rtoc_mutable_receiver_286 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
        functionContext__mark_runtime_used_mut(&rtoc_mutable_receiver_286);
    END
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__visit_MethodCall(MUTABLE self: TypeAnalysisSession, MUTABLE node: MethodCall) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__normalize_explicit_mutable_arguments_mut(rtoc_self_view, Node{ MethodCall: COPY node });
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.object));
    FOR _ IN node.args DO
    TRY (typeAnalysisSession__visit(&rtoc_self_view, _));
    END
    typeAnalysisSession__reject_legacy_foreign_slice_view_mut(rtoc_self_view, node);
    typeAnalysisSession__reject_direct_observable_method_access_mut(rtoc_self_view, node);
    IF typeAnalysisSession__resolve_protocol_method_call_mut(&rtoc_self_view, &node) THEN
      typeAnalysisSession__finalize_tense_navigation_method_mut(rtoc_self_view, &node);
      RETURN;
    END
    IF typeAnalysisSession__resolve_collection_method(&rtoc_self_view, &node) THEN
      typeAnalysisSession__validate_indirect_collection_insertion_mut(rtoc_self_view, &node);
      MUTABLE receiver_type = &node.object.full_type_mut("@node collection receiver");
      MUTABLE element_type = receiver_type.element_type();
      IF ((((element_type != NIL) AND TRY (type__node_reference?((element_type?)))) AND (["append", "push", "insert"]).contains?(node.name)) AND node.args.any?()) THEN
        MUTABLE value_arg = COPY UNWRAP (node.args.last());
        MUTABLE actual_type = &value_arg.full_type_mut("@node collection insertion");
        IF (!(TRY (type__node_reference?(actual_type))) AND TRY (type__accepts?(element_type, actual_type))) THEN
          value_arg.coerced_type = element_type;
        END
      END
      typeAnalysisSession__reject_mutating_borrowed_receiver_mut(rtoc_self_view, node);
      typeAnalysisSession__record_predicate_call_site_mut(rtoc_self_view, Node{ MethodCall: COPY node });
      typeAnalysisSession__finalize_tense_navigation_method_mut(rtoc_self_view, &node);
      RETURN;
    END
    IF typeAnalysisSession__resolve_extern_method_call_mut(rtoc_self_view, &node) THEN
      typeAnalysisSession__reject_mutating_borrowed_receiver_mut(rtoc_self_view, node);
      typeAnalysisSession__finalize_tense_navigation_method_mut(rtoc_self_view, &node);
      RETURN;
    END
    IF typeAnalysisSession__resolve_inherent_method_call_mut(&rtoc_self_view, &node) THEN
      typeAnalysisSession__reject_mutating_borrowed_receiver_mut(rtoc_self_view, node);
      typeAnalysisSession__finalize_tense_navigation_method_mut(rtoc_self_view, &node);
      RETURN;
    END
    IF typeAnalysisSession__resolve_intrinsic_method_call_mut(&rtoc_self_view, &node) THEN
      typeAnalysisSession__validate_indirect_collection_insertion_mut(rtoc_self_view, &node);
      typeAnalysisSession__reject_mutating_borrowed_receiver_mut(rtoc_self_view, node);
      typeAnalysisSession__finalize_tense_navigation_method_mut(rtoc_self_view, &node);
      RETURN;
    END
    IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_287 = typeAnalysisSession__semantic_root_scope(rtoc_self_view);
    scope__resolve_entry(rtoc_local_receiver_287, node.name) } THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :DOT_CALL_REQUIRES_METHOD }, [], {:name: node.name});
    END
    typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :UNKNOWN_INHERENT_METHOD }, [], {:name: node.name, :type: TRY (type__surface_name(&node.object.full_type_mut("method receiver")))});
}
END
PRIVATE FN typeAnalysisSession__finalize_tense_navigation_method_mut(self: TypeAnalysisSession, MUTABLE node: MethodCall) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(node.object IS_A TenseNavigation) THEN
      RETURN;
    END
    IF (node.object.markers().contains?("~") AND (node.mutates_receiver != NIL)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :TENSE_NAVIGATION_MUTATION }, [], {:markers: node.object.markers()});
    END
    MUTABLE mapped_type = (typeAnalysisSession__recoverable_result_type(rtoc_self_view, &node, "tense navigation method result") OR_ELSE &node.full_type_mut("tense navigation method result"));
    MUTABLE result = typeAnalysisSession__publish_tense_navigation_plan_mut(rtoc_self_view, &node, castLocatableToTenseNavigation(node.object), CAST(mapped_type AS Type));
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node, result));
    IF node.object.safe_navigation?() THEN
      node.safe_nav_chain = TRUE;
    END
}
END
PRIVATE FN typeAnalysisSession__normalize_explicit_mutable_arguments_mut(self: TypeAnalysisSession, MUTABLE node: Node) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rtoc_each_items_288 = node.args();
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_288.length() DO
      IF !(rtoc_each_items_288[rtoc_idx] IS_A MutableBorrow) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      &node.mark_explicit_mutable_argument_mut(rtoc_idx, rtoc_each_items_288[rtoc_idx].token());
      MUTABLE rtoc_index_receiver_289 = node.args();
      rtoc_index_receiver_289[rtoc_idx] = rtoc_each_items_288[rtoc_idx].target();
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PRIVATE FN typeAnalysisSession__visit_MutableBorrow(self: TypeAnalysisSession, node: MutableBorrow) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :MUTABLE_MARKER_REQUIRES_CALL });
}
END
PRIVATE FN typeAnalysisSession__resolve_protocol_method_call_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MethodCall) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE receiver = &node.object.full_type_mut("protocol method receiver");
    IF typeAnalysisSession__resolve_user_protocol_method_call_mut(&rtoc_self_view, &node, receiver) THEN
      RETURN TRUE;
    END
    IF !(typeAnalysisSession__map_requires_protocol_lowering?(rtoc_self_view, receiver)) THEN
      RETURN FALSE;
    END
    typeAnalysisSession__require_generic_map_access_scope_mut(rtoc_self_view, node.object, receiver);
    MUTABLE operation = ({"put": :put, "delete": :delete, "contains?": :contains, "count": :count, "length": :count, "empty?": :empty, "any?": :any})[node.name];
    IF !(operation) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_MAP_METHOD_UNKNOWN }, [], {:name: node.name, :available: "put, delete, contains?, count, length, empty?, any?"});
    END
    operation = operation;
    MUTABLE expected_arity = IF ([:count, :empty, :any]).contains?(operation) THEN
      0
    ELSE
      (IF (operation == :put) THEN
      2
    ELSE
      1
    END)
    END;
    IF (node.args.length() != expected_arity) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_MAP_METHOD_ARITY }, [], {:name: node.name, :expected: expected_arity, :actual: node.args.length()});
    END
    MUTABLE key_type = typeAnalysisSession__protocol_map_associated_type(rtoc_self_view, receiver, :Key);
    MUTABLE value_type = typeAnalysisSession__protocol_map_associated_type(rtoc_self_view, receiver, :Value);
    typeAnalysisSession__verify_generic_map_receiver_mutability_mut(&rtoc_self_view, node, receiver, operation);
    IF expected_arity.positive?() THEN
      typeAnalysisSession__verify_protocol_method_argument_mut(rtoc_self_view, node, 0, CAST(key_type AS Type));
    END
    IF (operation == :put) THEN
      typeAnalysisSession__verify_protocol_method_argument_mut(rtoc_self_view, node, 1, CAST(value_type AS Type));
    END
    IF (operation == :put) THEN
      typeAnalysisSession__consume_generic_map_value_mut(rtoc_self_view, UNWRAP (node.args[1]), CAST(value_type AS Type));
    END
    MUTABLE result_branch_value: ?Type = NIL;
    PARTIAL MATCH operation START
      :contains ->
      result_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: :Bool }));,
      :empty ->
      result_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: :Bool }));,
      :any ->
      result_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: :Bool }));,
      :count ->
      result_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: :Int64 }));,
      DEFAULT ->
      result_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: :Void }));
    END
    MUTABLE result: Type = result_branch_value?;
    node.protocol_operation = operation;
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node, result));
    IF (operation == :put) THEN
      IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
            MUTABLE rtoc_mutable_receiver_290 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
            functionContext__record_heap_use_mut(&rtoc_mutable_receiver_290);
      END
      IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
            MUTABLE rtoc_mutable_receiver_291 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
            functionContext__record_alloc_use_mut(&rtoc_mutable_receiver_291);
      END
      typeAnalysisSession__record_effect(rtoc_self_view, symbol("HEAP"));
      node.can_fail = TRUE;
    END
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__verify_generic_map_receiver_mutability_mut(MUTABLE self: TypeAnalysisSession, node: MethodCall, receiver: Type, operation: String@symbol) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE mutates = ([:put, :delete]).contains?(operation);
    IF !(mutates) THEN
      RETURN;
    END
    MUTABLE params: []Param = [Param{ name: "receiver", type: COPY receiver, required: TRUE, mutable: TRUE, takes: FALSE, default: NIL, comptime: NIL, name_token: NIL, sync: NIL, symbol: NIL, carrier_contract: NIL }];
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < node.args.length() DO
    &params.append(Param{ name: "arg${(rtoc_idx + 1)}", type: COPY &node.args[rtoc_idx].full_type_mut({:context: "generic map method argument"}), required: TRUE, mutable: FALSE, takes: FALSE, default: NIL, comptime: NIL, name_token: NIL, sync: NIL, symbol: NIL, carrier_contract: NIL });
    rtoc_idx = rtoc_idx + 1;
    END
    typeAnalysisSession__verify_function_signature_mut(&rtoc_self_view, FunctionCallNode{ MethodCall: COPY node }, TRY (functionSignature__new(params, castTypeToOptionalTypeTypeInput(TRY (type__new(TypeConstructionInput{ SymbolValue: :Void }))), NIL, NIL, ( { MUTABLE rtoc_empty_list_292: []String@symbol = List[]; rtoc_empty_list_292 } ), {}, FALSE, FALSE, NIL, NIL, NIL, ( { MUTABLE rtoc_empty_list_293: []String@symbol = List[]; rtoc_empty_list_293 } ), NIL, ( { MUTABLE rtoc_empty_list_294: []String@symbol = List[]; rtoc_empty_list_294 } ))), ([node.object] + node.args));
}
END
PRIVATE FN typeAnalysisSession__resolve_user_protocol_method_call_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MethodCall, receiver: Type) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE protocol_names = typeAnalysisSession__user_protocol_names_for_receiver(rtoc_self_view, receiver);
    IF (protocol_names.length() == 0) THEN
      RETURN FALSE;
    END
    MUTABLE matches = protocol_names |> SELECT:? {
    MUTABLE protocol: ?ProtocolDef = typeAnalysisSession__semantic_protocol(rtoc_self_view, _);
    MUTABLE requirement = protocol?.requirements |> FIND (_.is_method AND (_.name == node.name));
    (  IF ((protocol != NIL) AND requirement) THEN
        [protocol, requirement]
      ELSE
        NIL
      END)
    } |> WHERE _ != NIL;
    IF (matches.length() > 1) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_PROTOCOL_METHOD_AMBIGUOUS }, [], {:name: node.name, :protocols: (matches |> SELECT _.first().name()).join(", ")});
    END
    IF (matches.length() == 0) THEN
      MUTABLE available = ((protocol_names |> UNNEST (((IF typeAnalysisSession__semantic_protocol(rtoc_self_view, _)?.requirements != NIL THEN
        (typeAnalysisSession__semantic_protocol(rtoc_self_view, _)?.requirements) |> WHERE _.is_method() |> SELECT _.name()
      ELSE
        NIL
      END)) OR_ELSE List[])) |> DISTINCT _ |> SELECT COPY _) |> ORDER_BY _;
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_PROTOCOL_METHOD_UNKNOWN }, [], {:name: node.name, :protocols: protocol_names.join(" & "), :available: IF available.empty?() THEN
        "none"
      ELSE
        available.join(", ")
      END});
    END
    MUTABLE protocol, requirement = matches.first();
    MUTABLE signature = typeAnalysisSession__protocol_requirement_signature(rtoc_self_view, protocol, requirement, receiver);
    typeAnalysisSession__verify_function_signature_mut(&rtoc_self_view, FunctionCallNode{ MethodCall: COPY node }, signature, ([node.object] + node.args));
    node.matched_signature = signature;
    node.protocol_name = protocol.name();
    node.protocol_operation = type__to_sym(requirement.name());
    typeAnalysisSession__stamp_resolved_call_result_mut(rtoc_self_view, FunctionCallNode{ MethodCall: COPY node }, CAST(functionSignature__return_type(signature) AS Type), functionSignature__recoverable_result?(signature));
    IF functionSignature__reentrant(signature) THEN
      typeAnalysisSession__record_effect(rtoc_self_view, symbol("REENTRANT"));
    END
    IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
        MUTABLE rtoc_mutable_receiver_295 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
        functionContext__mark_runtime_used_mut(&rtoc_mutable_receiver_295);
    END
    typeAnalysisSession__record_predicate_call_site_mut(rtoc_self_view, Node{ MethodCall: COPY node });
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__user_protocol_names_for_receiver(self: TypeAnalysisSession, receiver: Type) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE bounded = (typeAnalysisSession__generic_parameter_protocol_names(rtoc_self_view, type__resolved(receiver))) |> WHERE !((_ == "Map"));
    IF !((bounded.length() == 0)) THEN
      RETURN bounded;
    END
    RETURN (TRY (typeAnalysisSession__semantic_protocols(rtoc_self_view))).keys() |> WHERE !((typeAnalysisSession__conformance_match(rtoc_self_view, _, receiver) == NIL));
}
END
PRIVATE FN typeAnalysisSession__protocol_requirement_signature(self: TypeAnalysisSession, protocol: ProtocolDef, requirement: ProtocolRequirement, receiver: Type) RETURNS !FunctionSignature@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE substitutions = protocol.associated_types |> REDUCE({:Self: receiver}) {
    acc[symbol(_.name)] = TRY (type__new(TypeConstructionInput{ TypeExpression: COPY typeExpression__of(TypeProjectionExpression{ owner: COPY type__resolved(receiver), member: COPY symbol(_.name), protocol: COPY type__to_sym(protocol.name) }) }));
    acc
    };
    RETURN TRY (functionSignature__new(requirement.params |> SELECT Param{ name: COPY _.name, type: CAST(COPY typeAnalysisSession__apply_type_subst(rtoc_self_view, castTypeToTypeTypeInput(_.type), substitutions) AS Type), required: TRUE, mutable: _.mutable, takes: _.takes, default: NIL, comptime: NIL, name_token: NIL, sync: NIL, symbol: NIL, carrier_contract: NIL }, TypeTypeInput{ Type: COPY typeAnalysisSession__apply_type_subst(rtoc_self_view, castTypeToTypeTypeInput(requirement.return_type), substitutions) }, NIL, NIL, ( { MUTABLE rtoc_empty_list_296: []String@symbol = List[]; rtoc_empty_list_296 } ), {}, (requirement.effects_decl == :reentrant), FALSE, NIL, NIL, NIL, ( { MUTABLE rtoc_empty_list_297: []String@symbol = List[]; rtoc_empty_list_297 } ), NIL, ( { MUTABLE rtoc_empty_list_298: []String@symbol = List[]; rtoc_empty_list_298 } )));
}
END
PRIVATE FN typeAnalysisSession__verify_protocol_method_argument_mut(self: TypeAnalysisSession, node: MethodCall, index_value: Int64, expected: Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE argument = COPY UNWRAP (node.args[index_value]);
    MUTABLE actual = &argument.full_type_mut("Map protocol method argument");
    IF TRY (type__accepts?(expected, actual)) THEN
      RETURN;
    END
    typeAnalysisSession__error_mut(rtoc_self_view, argument, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_MAP_METHOD_ARGUMENT }, [], {:name: node.name, :position: (index_value + 1), :expected: TRY (type__surface_name(castTypeToTypeTypeInput(expected))), :actual: TRY (type__surface_name(actual))});
}
END
PRIVATE FN typeAnalysisSession__resolve_inherent_method_call_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MethodCall) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE receiver_type = &node.object.full_type_mut("inherent method receiver");
    MUTABLE owner = IF type__generic_instance?(receiver_type) THEN
      type__generic_base(receiver_type)
    ELSE
      receiver_type.resolved()
    END;
    MUTABLE schema = typeAnalysisSession__lookup_type_schema(rtoc_self_view, owner);
    IF !(schemas__struct?(schema)) THEN
      RETURN FALSE;
    END
    IF !(schema.methods().key?(node.name)) THEN
      RETURN FALSE;
    END
    MUTABLE source_name = COPY node.name;
    node.source_method_name = source_name;
    node.name = ImplementationRegistration.function_name(CAST(owner AS String), source_name);
    typeAnalysisSession__resolve_call(&rtoc_self_view, FunctionCallNode{ MethodCall: COPY node }, ([node.object] + node.args));
    typeAnalysisSession__reject_mutating_borrowed_receiver_mut(rtoc_self_view, node);
    typeAnalysisSession__record_predicate_call_site_mut(rtoc_self_view, Node{ MethodCall: COPY node });
    typeAnalysisSession__record_call_site(rtoc_self_view, node.name);
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__reject_legacy_foreign_slice_view_mut(self: TypeAnalysisSession, node: MethodCall) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE receiver_type = &node.object.full_type_mut("foreign view receiver");
    IF !((TRY (type__c_array_view?(receiver_type)) AND (node.name == "view"))) THEN
      RETURN;
    END
    typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :FOREIGN_VIEW_REQUIRES_WITH });
}
END
PRIVATE FN typeAnalysisSession__reject_direct_observable_method_access_mut(self: TypeAnalysisSession, node: MethodCall) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE receiver_type = &node.object.full_type_mut("observable method receiver");
    IF !((type__future?(receiver_type) AND type__observable?(receiver_type))) THEN
      RETURN;
    END
    MUTABLE root: ?Identifier = aST__root_identifier(node.object);
    IF (root != NIL) THEN
      typeAnalysisSession__emit_direct_view_access_finding_mut(rtoc_self_view, node, identifier__name(root), "VIEW");
    ELSE
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :DIRECT_VIEW_ACCESS_REQUIRES_WITH }, [], {:name: "observable", :permission: "VIEW"});
    END
}
END
PRIVATE FN typeAnalysisSession__reject_mutating_borrowed_receiver_mut(self: TypeAnalysisSession, node: MethodCall) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(node.mutates_receiver) THEN
      RETURN;
    END
    MUTABLE root: ?String = typeAnalysisSession__root_variable_name(rtoc_self_view, node.object);
    IF root EXISTS AS root_value THEN
      IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_299 = typeAnalysisSession__ownership_graph(rtoc_self_view);
      TRY (ownershipGraph__can_write?(rtoc_local_receiver_299, root_value)) } THEN
        RETURN;
      END
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :ASSIGN_WHILE_BORROWED }, [], {:name: root_value});
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__visit_StaticCall(MUTABLE self: TypeAnalysisSession, MUTABLE node: StaticCall) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__normalize_explicit_mutable_arguments_mut(rtoc_self_view, Node{ StaticCall: COPY node });
    FOR _ IN node.args DO
    TRY (typeAnalysisSession__visit(&rtoc_self_view, _));
    END
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node.type_name, TRY (type__new(TypeConstructionInput{ SymbolValue: :Type }))));
    MUTABLE type_name = type__to_sym(node.type_name.name());
    MUTABLE schema = typeAnalysisSession__lookup_type_schema(rtoc_self_view, type_name);
    IF (schemas__struct?(schema) AND schema.static_methods().key?(node.method_name)) THEN
      typeAnalysisSession__resolve_inherent_static_call_mut(&rtoc_self_view, &node, type_name);
      RETURN;
    END
    IF !((schema.kind() == :resource)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :STATIC_NOT_RESOURCE }, [], {:type: type_name});
    END
    MUTABLE static_methods = (schema.static_methods() OR {});
    MUTABLE method_def: ?FunctionSignature@multiowned = functionSignature__unwrap(castOptionalLookupResultToOptionalX(TRY (intrinsicRegistry__lookup(static_methods, node.method_name))));
    IF method_def EXISTS AS method_def_value THEN
      MUTABLE method_def_value_mutable = COPY method_def_value;
      MUTABLE expected_args = TRY (functionSignature__intrinsic_arg_specs(method_def_value_mutable));
      IF (scopeBindings__length(node.args) != expected_args.length()) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :STATIC_ARITY }, [], {:type: type_name, :method: node.method_name, :expected: expected_args.length(), :got: scopeBindings__length(node.args)});
      END
      MUTABLE rtoc_each_items_300 = node.args.zip(expected_args);
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < rtoc_each_items_300.length() DO
      IF (rtoc_each_items_300[rtoc_idx][1] AND typeAnalysisSession__intrinsic_arg_matches?(rtoc_self_view, rtoc_each_items_300[rtoc_idx][1], &rtoc_each_items_300[rtoc_idx][0])) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE actual = rtoc_each_items_300[rtoc_idx][0].resolved_type();
      IF (actual == :Any) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :STATIC_ARG_TYPE }, [], {:index: (rtoc_idx + 1), :type: type_name, :method: node.method_name, :expected: ((IF rtoc_each_items_300[rtoc_idx][1] != NIL THEN
            (rtoc_each_items_300[rtoc_idx][1]).type()
          ELSE
            NIL
          END) OR_ELSE :Any), :got: actual});
    rtoc_idx = rtoc_idx + 1;
      END
      node.zig_pattern = castOptionalFunctionSignatureReturnValueToOptionalStringSymbol(TRY (functionSignature__intrinsic_pattern(&method_def_value_mutable)));
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ StaticCall: COPY node }, { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_301 = (TRY (functionSignature__return_def(method_def_value_mutable)));
      TRY (functionReturn__resolve(rtoc_local_receiver_301, NIL, node.args)) }));
      node.matched_stdlib_def = method_def_value_mutable;
      node.matched_signature = method_def_value_mutable;
      MUTABLE method_allocates = TRY (functionSignature__emits_allocating?(&method_def_value_mutable));
      node.stdlib_allocates = method_allocates;
      node.mutates_receiver = TRY (functionSignature__mutates_receiver?(&method_def_value_mutable));
      node.can_fail = (IF node.can_fail != NIL THEN node.can_fail ELSE functionSignature__can_fail(method_def_value_mutable) END);
      IF (functionSignature__recoverable_result?(method_def_value_mutable) AND TRUE) THEN
        node.error_union_type = TRY (type__error_union_of(castTypeToTypeTypeInput(TRY (type__new(TypeConstructionInput{ Type: COPY &node.full_type_mut("static intrinsic result") })))));
      END
      node.error_kind = TRY (functionSignature__intrinsic_error_kind(&method_def_value_mutable));
      node.error_type = TRY (functionSignature__intrinsic_error_type(&method_def_value_mutable));
      IF (method_allocates OR functionSignature__can_fail(method_def_value_mutable)) THEN
        IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
                MUTABLE rtoc_mutable_receiver_302 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
                functionContext__record_alloc_use_mut(&rtoc_mutable_receiver_302);
        END
      END
    ELSE
      MUTABLE available = static_methods.keys().join(", ");
      IF (available.length() == 0) THEN
        available = "(none)";
      END
      MUTABLE method_tok = node.type_name.token();
      IF method_tok THEN
        MUTABLE anchor = typeAnalysisSession__anchor_at(rtoc_self_view, method_tok.line(), ((method_tok.column() + (CAST(node.type_name.name() AS String)).codepointCount()) + 2));
        typeAnalysisSession__emit_typo_suggestion_mut(rtoc_self_view, TypoToken{ AnchorToken: COPY anchor }, node.method_name, static_methods.keys(), "Type Error: No static method '${node.method_name}' on '${type_name}'. Available: ${available}.", "static method of ${type_name}", :type, TRUE);
      ELSE
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :STATIC_UNKNOWN_METHOD }, [], {:method: node.method_name, :type: type_name, :available: available});
      END
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__resolve_inherent_static_call_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: StaticCall, owner: String@symbol) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE call = FuncCall{ token: COPY node.token, name: ImplementationRegistration.function_name(CAST(owner AS String), node.method_name), args: COPY node.args, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, explicit_mutable_argument_tokens: NIL, module_alias: NIL, extern_call: NIL, extern_effects: NIL, extern_source: NIL, generic_type_args: NIL, fn_var_call: NIL, pipe_lhs: NIL, heap_dupe_result: NIL, arg_families: NIL, collapsed_errors: NIL, error_union_type: NIL, protocol_name: NIL, protocol_operation: NIL, protocol_receiver_index: NIL, retain_error_channel: NIL };
    FOR rtoc_each_key IN node.explicit_mutable_argument_tokens.keys() DO
    MUTABLE token: Token@multiowned = COPY UNWRAP (node.explicit_mutable_argument_tokens[rtoc_each_key]);
    &call.mark_explicit_mutable_argument_mut(rtoc_each_key, CAST(COPY token AS Token));
    END
    typeAnalysisSession__resolve_call(&rtoc_self_view, FunctionCallNode{ FuncCall: COPY call }, node.args);
    MUTABLE resolved_return = &call.full_type_mut("inherent static call");
    aST__copy_pipeline_rewrite_metadata_mut(PipelineRewriteNode{ FuncCall: COPY call }, PipelineRewriteNode{ StaticCall: COPY node }, TRUE);
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ FuncCall: COPY call }, resolved_return));
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ StaticCall: COPY node }, resolved_return));
    node.inherent_call = call;
    typeAnalysisSession__record_predicate_call_site_mut(rtoc_self_view, Node{ FuncCall: COPY call });
    typeAnalysisSession__record_named_call_site_mut(rtoc_self_view, &call);
}
END
PRIVATE FN typeAnalysisSession__visit_IntrinsicFunc(MUTABLE self: TypeAnalysisSession, MUTABLE node: Node, args: []Locatable, matched_def_input: ?FunctionSignature = NIL) RETURNS !?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE matched_def = COPY matched_def_input;
    MUTABLE definitions: []FunctionSignature@multiowned = TRY (intrinsicRegistry__overloads(:std_lib, node.name()));
    matched_def = (matched_def OR_ELSE typeAnalysisSession__find_matching_intrinsic(rtoc_self_view, definitions, args));
    IF matched_def EXISTS AS matched_def_value THEN
      MUTABLE matched_def_value_mutable = COPY matched_def_value;
      IF !(functionSignature__intrinsic_varargs?(matched_def_value_mutable)) THEN
        typeAnalysisSession__verify_function_signature_mut(&rtoc_self_view, castNodeToFunctionCallNode(node), TRY (functionSignature__intrinsic_call_validation_signature(matched_def_value_mutable)), args);
      END
      MUTABLE reject_when: ?String@symbol = TRY (functionSignature__intrinsic_reject_when(&matched_def_value_mutable));
      MUTABLE first_arg: ?Locatable = COPY args.first();
      IF (((reject_when != NIL) AND (first_arg != NIL)) AND typeAnalysisSession__reject_arg_type_matches?(rtoc_self_view, UNWRAP (first_arg), symbol(UNWRAP (reject_when)))) THEN
        MUTABLE reason = (TRY (functionSignature__intrinsic_reject_error(&matched_def_value_mutable)) OR_ELSE "${node.name()}() is not valid for ${first_arg.resolved_type()}");
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :INTRINSIC_REJECTED }, [], {:detail: reason});
        RETURN;
      END
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, castNodeToLocatable(node), { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_303 = (TRY (functionSignature__return_def(matched_def_value_mutable)));
      TRY (functionReturn__resolve(rtoc_local_receiver_303, NIL, args)) }));
      node.zig_pattern = TRY (functionSignature__intrinsic_pattern(&matched_def_value_mutable));
      node.matched_stdlib_def = COPY matched_def_value_mutable;
      IF respondsTo?(node, "matched_signature=") THEN
        node.matched_signature = COPY matched_def_value_mutable;
      END
      MUTABLE matched_allocates = TRY (functionSignature__emits_allocating?(&matched_def_value_mutable));
      node.stdlib_allocates = matched_allocates;
      node.mutates_receiver = TRY (functionSignature__mutates_receiver?(&matched_def_value_mutable));
      node.can_fail = ((aST__node__can_fail(node) OR functionSignature__can_fail(matched_def_value_mutable)) OR matched_allocates);
      IF (functionSignature__recoverable_result?(matched_def_value_mutable) AND respondsTo?(node, "error_union_type=")) THEN
        node.error_union_type = TRY (type__error_union_of(castTypeToTypeTypeInput(TRY (type__new(&node.full_type_mut("intrinsic result"))))));
      END
      IF TRY (functionSignature__intrinsic_error_kind(&matched_def_value_mutable)) THEN
        node.error_kind = TRY (functionSignature__intrinsic_error_kind(&matched_def_value_mutable));
      END
      IF TRY (functionSignature__intrinsic_error_type(&matched_def_value_mutable)) THEN
        node.error_type = TRY (functionSignature__intrinsic_error_type(&matched_def_value_mutable));
      END
      IF ((matched_allocates OR functionSignature__can_fail(matched_def_value_mutable)) OR functionSignature__needs_rt(matched_def_value_mutable)) THEN
        IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
                MUTABLE rtoc_mutable_receiver_304 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
                functionContext__record_alloc_use_mut(&rtoc_mutable_receiver_304);
        END
      END
      IF TRY (functionSignature__intrinsic_suspends?(&matched_def_value_mutable)) THEN
        typeAnalysisSession__record_effect(rtoc_self_view, symbol("SUSPENDS"));
      END
      IF TRY (functionSignature__mutates_receiver?(&matched_def_value_mutable)) THEN
      IF node IS_A MethodCall AS method_call THEN
        typeAnalysisSession__mark_chain_needs_mut_ref_mut(rtoc_self_view, method_call.object);
        MUTABLE root: ?String = typeAnalysisSession__chain_root_name(rtoc_self_view, method_call.object);
        IF root EXISTS AS root_value THEN
          typeAnalysisSession__mark_var_mutated(rtoc_self_view, root_value);
        END
      END
      END
      typeAnalysisSession__narrow_collection_type_mut(rtoc_self_view, matched_def_value_mutable, args);
      RETURN NIL;
    ELSE
      MUTABLE sigs = ( { MUTABLE rtoc_map_results = CAST([] AS []String); definitions |> EACH { &rtoc_map_results.append(COPY functionSignature__intrinsic_args_label(_)); }; rtoc_map_results } ).join(" or ");
      MUTABLE arg_types = (args |> SELECT _.resolved_type()).join(", ");
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :INTRINSIC_NO_OVERLOAD }, arg_types, {:name: node.name(), :candidates: sigs});
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__annotate_call_argument_mut(MUTABLE self: TypeAnalysisSession, parent: FuncCall, MUTABLE arg: Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF arg IS_A StructLit THEN
      typeAnalysisSession__with_struct_literal_call_argument(rtoc_self_view, %() USE(arg, MUTABLE rtoc_self_view) -> {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, arg));
    rubyToClearVoid()
    });
    ELSE
      TRY (typeAnalysisSession__visit(&rtoc_self_view, arg));
    END
    IF arg IS_A IfStatement AS if_statement THEN
      MUTABLE if_statement_mutable = COPY if_statement;
      typeAnalysisSession__promote_to_expr_if_mut(rtoc_self_view, Locatable{ FuncCall: COPY parent }, &if_statement_mutable);
    END
    IF arg IS_A MatchStatement AS match_statement THEN
      MUTABLE match_statement_mutable = COPY match_statement;
      typeAnalysisSession__promote_to_expr_match_mut(rtoc_self_view, Locatable{ FuncCall: COPY parent }, &match_statement_mutable);
    END
}
END
PRIVATE FN typeAnalysisSession__record_named_call_site_mut(self: TypeAnalysisSession, MUTABLE node: FuncCall) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(node.name IS_A String) THEN
      RETURN;
    END
    typeAnalysisSession__record_call_site(rtoc_self_view, node.name);
    IF node.args.empty?() THEN
