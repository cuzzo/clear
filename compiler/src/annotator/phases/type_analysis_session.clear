          TRY (typeAnalysisSession__og_drop(&rtoc_self_view, UNWRAP (rtoc_each_items_486[rtoc_idx])));
      END
    rtoc_idx = rtoc_idx + 1;
    END
    IF (branch == :then) THEN
      MUTABLE rtoc_writer_receiver_492: IfStatement = castLocatableToIfStatement__type_analysis_session(node);
      rtoc_writer_receiver_492.then_drops = drops;
    ELSE_IF (branch == :else) THEN
