    IF (TRUE AND type__shared?(ti)) THEN
      RETURN FALSE;
    END
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__move_if_not_copyable_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: Locatable, action: String@symbol = :move, consumer_param_type: ?Type = NIL) RETURNS !?Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node IS_A Identifier AS identifier THEN
      MUTABLE identifier_mutable = COPY identifier;
      MUTABLE vt = TRY (aST__full_type_mut( Locatable{ Identifier: COPY identifier_mutable }));
      IF TRY (typeAnalysisSession__current_function_type_param?(&rtoc_self_view, type__resolved(vt))) THEN
        RETURN NIL;
      END
      IF TRY (type__implicitly_copyable?(vt, %(t: String@symbol) USE(MUTABLE rtoc_self_view) -> TRY (typeAnalysisSession__schema_lookup_result(&rtoc_self_view, t)))) THEN
        RETURN NIL;
      END
      MUTABLE rtoc_graph_20477 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
      MUTABLE existing: ?OwnershipNode = COPY ownershipGraph__get_index(rtoc_graph_20477, identifier__name(identifier_mutable));
      IF existing EXISTS AS existing_value THEN
        IF ownershipNode__specific_move_action?(existing_value) THEN
        IF ((consumer_param_type != NIL) AND (UNWRAP (existing).move_consumer_param_type == NIL)) THEN
          IF existing EXISTS AS MUTABLE existing_present THEN
            existing_present.move_consumer_param_type = COPY castTypeToOptionalTypeTypeInput__type_analysis_session(consumer_param_type);
          END
        END
        identifier_mutable.was_moved = TRUE;
        RETURN NIL;
      END
      END
      TRY (typeAnalysisSession__og_set_moved(&rtoc_self_view, identifier__name(identifier_mutable), identifier_mutable.token, action, castOptionalTypeToOptionalTypeTypeInput(consumer_param_type)));
      identifier_mutable.was_moved = TRUE;
      RETURN TRUE;
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__move_if_takes_ownership_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: Locatable, action: String@symbol = :takes, consumer_param_type: ?Type = NIL) RETURNS !?Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node IS_A Identifier AS identifier THEN
      MUTABLE identifier_mutable = COPY identifier;
      MUTABLE vt = TRY (aST__full_type_mut( Locatable{ Identifier: COPY identifier_mutable }));
      IF TRY (typeAnalysisSession__current_function_type_param?(&rtoc_self_view, type__resolved(vt))) THEN
        RETURN NIL;
      END
      IF (type__primitive?(vt) OR type__id_handle?(vt)) THEN
        RETURN NIL;
      END
      MUTABLE rtoc_graph_20509 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
      MUTABLE existing: ?OwnershipNode = COPY ownershipGraph__get_index(rtoc_graph_20509, identifier__name(identifier_mutable));
      IF existing EXISTS AS existing_value THEN
        IF ownershipNode__specific_move_action?(existing_value) THEN
        IF ((consumer_param_type != NIL) AND (UNWRAP (existing).move_consumer_param_type == NIL)) THEN
          IF existing EXISTS AS MUTABLE existing_present THEN
            existing_present.move_consumer_param_type = COPY castTypeToOptionalTypeTypeInput__type_analysis_session(consumer_param_type);
          END
        END
        identifier_mutable.was_moved = TRUE;
        RETURN NIL;
      END
      END
      TRY (typeAnalysisSession__og_set_moved(&rtoc_self_view, identifier__name(identifier_mutable), identifier_mutable.token, action, castOptionalTypeToOptionalTypeTypeInput(consumer_param_type)));
      identifier_mutable.was_moved = TRUE;
      RETURN TRUE;
    ELSE
      RETURN NIL;
    END
