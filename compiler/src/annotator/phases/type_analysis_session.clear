PRIVATE FN typeAnalysisSession__get_lifetime_paths(MUTABLE self: TypeAnalysisSession, func_node: FunctionDef) RETURNS ![]TypeAnalysisSessionReturnValueItem
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rl: ?ClearParserReturnLifetime = COPY func_node.return_lifetime;
    IF (rl == NIL) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_514: []TypeAnalysisSessionReturnValueItem = List[]; rtoc_empty_list_514 } ) AS []TypeAnalysisSessionReturnValueItem);
    END
    IF ((IF rl IS_A String@symbol AS rl_payload THEN (rl_payload == :wildcard) ELSE FALSE END)) THEN
      RETURN (CAST([TypeAnalysisSessionReturnValueItem{ SymbolValue: :wildcard }] AS []TypeAnalysisSessionReturnValueItem) |> SELECT TypeAnalysisSessionReturnValueItem{ StringValue: COPY UNWRAP (_) });
    END
    MUTABLE sources: []Any = List[];
    IF rl IS_A ArrayValue AS rl_items THEN
      sources = CAST(rl_items AS []Any);
    ELSE
      sources = [CAST(rl AS Any)];
    END
    RETURN sources |> SELECT:? {
    MUTABLE path = TRY (typeAnalysisSession__get_path_to_root(&rtoc_self_view, _));
    (IF !((path.length() == 0)) THEN
        path.join(".")
      ELSE
        NIL
      END)
    } |> WHERE _ != NIL;
}
END
PRIVATE FN typeAnalysisSession__get_lifetime_path(MUTABLE self: TypeAnalysisSession, func_node: FunctionDef) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE paths = TRY (typeAnalysisSession__get_lifetime_paths(&rtoc_self_view, func_node));
    IF ((paths.length() != 1) OR ruby_union_scalar_equal_optional_LifetimesReturnValueItem_String_symbol(UNWRAP (castTypeAnalysisSessionReturnValueItemToFunctionSignatureLifetimeSource(UNWRAP (paths.first()))), :wildcard)) THEN
      RETURN NIL;
    END
    MUTABLE first: ?FunctionSignatureLifetimeSource = COPY paths.first();
    IF first? IS_A String AS string THEN
      RETURN COPY string;
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__root_variable_name(MUTABLE self: TypeAnalysisSession, node: ?Locatable) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE curr: ?Locatable = COPY node;
    WHILE (curr != NIL) DO
      IF curr? IS_A Identifier AS identifier THEN
        RETURN COPY identifier__name(identifier);
      END
      curr =     IF (aST__node_target( UNWRAP (curr)) EXISTS) THEN
        locatable__target(UNWRAP (curr))
      ELSE_IF (locatable__object( UNWRAP (curr)) != NIL) THEN
        locatable__object(UNWRAP (curr))
      ELSE
        NIL
      END;
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__set_cleanup_alloc_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: Node) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE ti = TRY (aST__full_type_mut( UNWRAP (castNodeToLocatable(node))));
    IF !(ti) THEN
      RETURN NIL;
    END
    MUTABLE val: ?Locatable = typeAnalysisSession__cleanup_source_value(&rtoc_self_view, aST__node_value(UNWRAP (castNodeToLocatable(node))));
    IF ((val != NIL) AND ((val IS_A FuncCall OR val IS_A MethodCall))) THEN
      MUTABLE matched_def: ?FunctionSignature@multiowned = locatable__matched_stdlib_def(val);
      IF matched_def THEN
        IF !( UNWRAP ((TRY (functionSignature__intrinsic_lifetime( &matched_def))).empty?())) THEN
          IF TRUE THEN
            val.storage = :borrow;
          END
          IF TRUE THEN
            node.storage = :borrow;
          END
          RETURN NIL;
        END
        MUTABLE ret_alloc = TRY (functionSignature__return_alloc(matched_def));
        IF TRY (functionSignature__emits_allocating?(matched_def)) THEN
          IF (ret_alloc == NIL) THEN
            ret_alloc = TRY (functionSignature__intrinsic_alloc(&matched_def, IntrinsicAllocationKind.Alloc));
          END
        END
        IF ret_alloc THEN
          IF ([:heap, :frame]).contains?(ret_alloc) THEN
            IF TRUE THEN
              val.storage = ret_alloc;
            END
          END
          RETURN NIL;
        END
      END
    END
    MUTABLE alloc = TRY (type__cleanup_allocator(ti, %(name: String@symbol) USE(MUTABLE rtoc_self_view) -> TRY (typeAnalysisSession__schema_lookup_result(&rtoc_self_view, name))));
    MUTABLE val_ti = IF (val != NIL) THEN
      TRY (aST__full_type_mut(val))
    ELSE
      NIL
    END;
    val_ti = IF val_ti IS_A Type THEN
      val_ti
    ELSE
      NIL
    END;
    type__apply_cleanup_placement_mut(&ti, val_ti, alloc);
    RETURN alloc;
}
END
PRIVATE FN typeAnalysisSession__cleanup_source_value(MUTABLE self: TypeAnalysisSession, node: ?Locatable) RETURNS ?Locatable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE current: ?Locatable = COPY node;
    WHILE ((current != NIL) AND aST__recovery_wrapper?(current)) DO
      current = aST__recovery_payload(UNWRAP (current));
    END
    RETURN current;
}
