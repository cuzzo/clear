PRIVATE FN typeAnalysisSession__mark_chain_needs_mut_ref_mut(MUTABLE self: TypeAnalysisSession, node: Locatable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE curr: ?Locatable = COPY node;
    WHILE (curr != NIL) DO
      IF curr? IS_A GetIndex AS get_index THEN
        MUTABLE get_index_mutable = COPY get_index;
        get_index_mutable.needs_mut_ref = TRUE;
      END
      curr = aST__node_target( UNWRAP (curr));
    END
}
END
PRIVATE FN typeAnalysisSession__get_path_to_root(MUTABLE self: TypeAnalysisSession, node: Node) RETURNS ![]String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE path = List[];
    MUTABLE curr = COPY node;
    WHILE ((curr IS_A GetField OR curr IS_A GetIndex) OR curr IS_A OptionalUnwrap) DO
      IF curr IS_A GetField THEN
        path = ([symbol(node__field(curr) OR_ELSE "")] + path);
      END
      IF curr IS_A GetIndex THEN
        path = ([symbol("*")] + path);
      END
      curr = (castLocatableToNode__type_analysis_session(UNWRAP (locatable__target(UNWRAP (castNodeToLocatable(curr))))));
    END
    IF !(curr IS_A Identifier) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_504: []String@symbol = List[]; rtoc_empty_list_504 } ) AS []String@symbol);
    END
    path = ([symbol(curr.name())] + path);
    RETURN path;
}
END
PRIVATE FN typeAnalysisSession__verify_tied_assignment_mut(MUTABLE self: TypeAnalysisSession, assign_node: Assignment) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE val = COPY assign_node.value;
    MUTABLE sym: ?SymbolEntry@multiowned = aST__node__symbol(val);
    MUTABLE sources: []SymbolEntry@multiowned = TRY (typeAnalysisSession__lifetime_sources_for_value(&rtoc_self_view, val));
    IF (sources.length() == 0) THEN
      RETURN;
    END
    IF (TRUE AND ((sources.length() == 1) AND (sources[0] == sym))) THEN
      RETURN;
    END
    MUTABLE dest_depth: ?Int64 = TRY (typeAnalysisSession__dest_scope_depth_for_target(&rtoc_self_view, castAssignmentNameToLocatable__type_analysis_session(assign_node.name)));
    IF dest_depth EXISTS AS dest_depth_value THEN
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < sources.length() DO
      IF ((sources[rtoc_idx]?.scope_depth) == NIL) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !((dest_depth_value < UNWRAP (sources[rtoc_idx]?.scope_depth))) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE source_name = (typeAnalysisSession__lookup_source_name(&rtoc_self_view, sources[rtoc_idx]?) OR_ELSE "(unnamed)");
      MUTABLE msg = "Lifetime Error: cannot store value tied to '${source_name}' (declared at scope depth ${sources[rtoc_idx]?.scope_depth}) into a destination at scope depth ${dest_depth_value.toString()} -- the destination outlives the source. Move the destination into the same scope, or COPY the value.";
      MUTABLE fix: ?Fix@multiowned = TRY (typeAnalysisSession__build_atomic_escape_migration_fix(&rtoc_self_view, sources[rtoc_idx]?, source_name));
      IF fix EXISTS AS fix_value THEN
            TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ Assignment: COPY assign_node } }, :escape, [fix_value], NIL, :ATOMIC_ESCAPE_ASSIGN, :error, TRUE, CAST({:detail: msg} AS {String@symbol}Any)));
      ELSE
            TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ Assignment: COPY assign_node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :ATOMIC_ESCAPE_ASSIGN }, [], CAST({:detail: msg} AS {String@symbol}Any)));
      END
    rtoc_idx = rtoc_idx + 1;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__verify_tied_return_mut(MUTABLE self: TypeAnalysisSession, return_node: ReturnNode) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE val: ?Locatable@boxed = COPY return_node.value;
    IF !(UNWRAP (val) IS_A Identifier) THEN
      RETURN;
    END
    MUTABLE sym: ?SymbolEntry@multiowned = aST__node__symbol( UNWRAP (val));
    IF !(sym) THEN
      RETURN;
    END
    MUTABLE sources = TRY (symbolEntry__lifetime_sources( sym));
    IF sources.empty?() THEN
      RETURN;
    END
    IF ((sources.length() == 1) AND (sources[0] == sym)) THEN
      RETURN;
    END
    MUTABLE fn_node: ?FunctionDef@multiowned = TRY (typeAnalysisSession__function_node_for(&rtoc_self_view, typeAnalysisSession__current_fn_ctx(&rtoc_self_view)?.name));
    MUTABLE rl: ?Any = COPY fn_node?.return_lifetime;
    IF (rl == :wildcard) THEN
      RETURN;
    END
    MUTABLE declared = (rl OR_ELSE List[]);
    MUTABLE declared_names = declared |> UNNEST {
    MUTABLE path = TRY (typeAnalysisSession__get_path_to_root(&rtoc_self_view, _));
    ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_506: ?[]Any = NIL;
      IF (path.length() == 0) THEN
        rtoc_ternary_value_506 = List[];
      ELSE
        rtoc_ternary_value_506 = [CAST(symbol(UNWRAP (path.first())) AS String)];
      END
      rtoc_ternary_value_506? })
    };
    MUTABLE source_names = (sources |> SELECT TRY (typeAnalysisSession__lookup_source_name(&rtoc_self_view, _))) |> WHERE _ != NIL;
    MUTABLE matched = source_names |> ANY declared_names.contains?(_);
    IF matched THEN
      RETURN;
    END
    MUTABLE sources_msg: String = "";
    IF source_names.empty?() THEN
      sources_msg = "(unnamed source)";
    ELSE
      sources_msg = source_names.join(", ");
    END
    MUTABLE declared_msg: String = "";
    IF declared_names.empty?() THEN
      declared_msg = "no `RETURNS <name>:T`";
    ELSE
      declared_msg = "`RETURNS ${declared_names.join(", ")}:T`";
    END
    MUTABLE msg = "Lifetime Error: cannot RETURN a value whose lifetime is tied to ${sources_msg}, because the enclosing function declares ${declared_msg} -- the caller's scope outlives the source. Either declare the function as `RETURNS ${source_names.first()}:T` (propagates the lifetime to the caller), or COPY the value before returning it.";
    MUTABLE atomic_fix: Any = NIL;
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < sources.length() DO
      MUTABLE name = ((source_names[rtoc_idx] OR TRY (typeAnalysisSession__lookup_source_name(&rtoc_self_view, sources[rtoc_idx]))) OR "(unnamed)");
      MUTABLE f: ?Fix@multiowned = TRY (typeAnalysisSession__build_atomic_escape_migration_fix(&rtoc_self_view, sources[rtoc_idx], name));
      IF f EXISTS AS f_value THEN
          atomic_fix = f_value;
          BREAK;
      END
    rtoc_idx = rtoc_idx + 1;
    END
    IF atomic_fix THEN
      TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ ReturnNode: COPY return_node } }, :escape, [atomic_fix], NIL, :ATOMIC_ESCAPE_RETURN, :error, TRUE, CAST({:detail: msg} AS {String@symbol}Any)));
    ELSE
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ ReturnNode: COPY return_node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :ATOMIC_ESCAPE_RETURN }, [], CAST({:detail: msg} AS {String@symbol}Any)));
    END
}
END
PRIVATE FN typeAnalysisSession__lookup_source_name(MUTABLE self: TypeAnalysisSession, sym: SymbolEntry) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE sc: ?Scope = COPY sym.scope;
    IF sc EXISTS AS sc_value THEN
      FOR rtoc_key IN (TRY (scope__visible_entries(sc_value))).keys() DO
    MUTABLE entry: SymbolEntry@multiowned = ((TRY (scope__visible_entries(sc_value)))[rtoc_key] OR_ELSE CAST(panic("missing hash key") AS SymbolEntry@multiowned));
      IF (entry.binding_id == sym.binding_id) THEN
        RETURN COPY rtoc_key;
      END
      END
    END
    FOR _ IN (TRY (typeAnalysisSession__function_node_map(&rtoc_self_view))).values() DO
    IF !((aST__node_params( Locatable{ FunctionDef: COPY _ }) EXISTS)) THEN
      CONTINUE;
    END
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < _.params.length() DO
      IF (UNWRAP ((UNWRAP (_.params[rtoc_idx]).symbol)).binding_id == sym.binding_id) THEN
          RETURN COPY CAST(UNWRAP (_.params[rtoc_idx]).name AS String);
      END
      rtoc_idx = rtoc_idx + 1;
    END
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__lifetime_sources_for_value(MUTABLE self: TypeAnalysisSession, val_node: Locatable) RETURNS ![]SymbolEntry@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE sources: []SymbolEntry@multiowned = ( { MUTABLE rtoc_empty_list_507: []SymbolEntry@multiowned = List[]; rtoc_empty_list_507 } );
    IF TRUE THEN
      MUTABLE sym: ?SymbolEntry@multiowned = aST__node__symbol(val_node);
      IF sym EXISTS AS sym_value THEN
        sources = ruby_array_concat_SymbolEntry_multiowned( sources, CAST(TRY (symbolEntry__lifetime_sources(sym_value)) AS []SymbolEntry@multiowned));
      END
    END
    sources = ruby_array_concat_SymbolEntry_multiowned(sources, TRY (typeAnalysisSession__collect_bg_sources_in_expr(&rtoc_self_view, castLocatableToOptionalBgSourceWalkValue(val_node))));
    RETURN CAST((sources |> DISTINCT _) AS []SymbolEntry@multiowned);
}
END
PRIVATE FN typeAnalysisSession__dest_scope_depth_for_target(MUTABLE self: TypeAnalysisSession, target_node: Locatable) RETURNS !?Int64
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF target_node IS_A Identifier AS identifier THEN
      MUTABLE sym: ?SymbolEntry = identifier.symbol;
      sym = (sym OR_ELSE (IF TRY (typeAnalysisSession__lookup_scope_for(&rtoc_self_view, identifier__name(identifier))) != NIL THEN
        { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_508: ?Scope@multiowned = (TRY (typeAnalysisSession__lookup_scope_for(&rtoc_self_view, identifier__name(identifier))));
      scope__resolve_entry(UNWRAP (rtoc_local_receiver_508), identifier__name(identifier)) }
      ELSE
        NIL
      END));
      IF sym != NIL THEN
    RETURN sym.scope_depth;
      ELSE
    RETURN NIL;
      END
    END
    IF (target_node IS_A GetField OR target_node IS_A GetIndex) THEN
      RETURN TRY (typeAnalysisSession__dest_scope_depth_for_target(&rtoc_self_view, locatable__target(target_node)));
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__stamp_bg_handle_lifetime_mut(MUTABLE self: TypeAnalysisSession, decl_node: DeclNode) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE sources = CAST(((TRY (typeAnalysisSession__collect_bg_sources_in_expr(&rtoc_self_view, UNWRAP (declNode__value(decl_node))))) |> DISTINCT _) AS []SymbolEntry@multiowned);
    IF sources.empty?() THEN
      RETURN;
    END
    MUTABLE sym: ?SymbolEntry = NIL;
    MATCH decl_node START
      DeclNode.VarDecl AS item ->
        sym = COPY item.symbol;,
      DeclNode.BindExpr AS item ->
        sym = COPY item.symbol;,
    END
    IF sym EXISTS AS sym_value THEN
      MUTABLE sym_value_mutable = COPY sym_value;
      sym_value_mutable.lifetime = TRY (symbolEntry__tied_lifetime(sources));
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__stamp_init_contents_heap_mut(MUTABLE self: TypeAnalysisSession, decl_node: DeclNode) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE sym: ?SymbolEntry = NIL;
    MATCH decl_node START
      DeclNode.VarDecl AS item ->
        sym = COPY item.symbol;,
      DeclNode.BindExpr AS item ->
        sym = COPY item.symbol;,
    END
    IF sym EXISTS AS sym_value THEN
      MUTABLE sym_value_mutable = COPY sym_value;
      MUTABLE init = UNWRAP (declNode__value(decl_node));
      IF TRY (typeAnalysisSession__init_value_contents_heap?(&rtoc_self_view, init)) THEN
        symbolEntry__mark_init_contents_heap_mut(&sym_value_mutable);
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__init_value_contents_heap?(MUTABLE self: TypeAnalysisSession, init: ?Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF init EXISTS AS init_value THEN
      IF init_value IS_A StructLit AS struct_lit THEN
        RETURN struct_lit.fields.values() |> ALL (IF !(_) THEN TRUE ELSE { MUTABLE rtoc_value_block_marker = 0; MUTABLE fti: ?Type = TRY (type__from_node_mut(_, "heap init field")); (IF !((TRY (type__string?( UNWRAP (fti))) OR type__collection?( UNWRAP (fti)))) THEN TRUE ELSE (_ IS_A Locatable AND symbolEntry__heap_storage?(_)) END) } END);
      ELSE_IF init_value IS_A UnionVariantLit AS union_variant_lit THEN
        RETURN union_variant_lit.fields |> ALL (IF !(_._1) THEN TRUE ELSE { MUTABLE rtoc_value_block_marker = 0; MUTABLE fti = TRY (type__from_node_mut(_._1, "heap init field")); (IF !((TRY (type__string?( UNWRAP (fti))) OR type__collection?( UNWRAP (fti)))) THEN TRUE ELSE (_._1 IS_A Locatable AND symbolEntry__heap_storage?(_._1)) END) } END);
      ELSE_IF (init_value IS_A FuncCall) OR (init_value IS_A MethodCall) THEN
        RETURN (TRUE AND init_value.heap_storage?());
      ELSE_IF init_value IS_A Identifier AS identifier THEN
        RETURN !(!((IF identifier.symbol != NIL THEN
          symbolEntry__init_contents_heap(UNWRAP (identifier.symbol))
        ELSE
          NIL
        END)));
      ELSE_IF init_value IS_A CopyNode AS copy_node THEN
        RETURN TRUE;
      ELSE_IF init_value IS_A KeepNode AS keep_node THEN
        RETURN TRUE;
      ELSE_IF init_value IS_A Cast AS rtoc_cast THEN
        RETURN typeAnalysisSession__init_value_contents_heap?(&rtoc_self_view, rtoc_cast.value);
      ELSE_IF init_value IS_A IfStatement AS if_statement THEN
        MUTABLE then_tail: ?Locatable = COPY (if_statement.then_branch).last();
        MUTABLE else_tail: ?Locatable = COPY ((if_statement.else_branch OR_ELSE List[])).last();
        MUTABLE tails = ([then_tail, else_tail]);
        RETURN ((tails.length() == 2) AND (tails |> ALL typeAnalysisSession__init_value_contents_heap?(&rtoc_self_view, _)));
      ELSE_IF init_value IS_A MatchStatement AS match_statement THEN
        MUTABLE cases = (match_statement.cases |> SELECT (TRY (matchCase__body(_))).last()) |> WHERE _ != NIL;
        MUTABLE default_tail = (IF match_statement.default_case != NIL THEN
          match_statement.default_case.last()
        ELSE
          NIL
        END);
        MUTABLE tails = (cases + ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_509: ?[]Any = NIL;
        IF default_tail THEN
          rtoc_ternary_value_509 = [default_tail];
        ELSE
          rtoc_ternary_value_509 = List[];
        END
        rtoc_ternary_value_509? }));
        RETURN ((tails).any?() AND (tails |> ALL typeAnalysisSession__init_value_contents_heap?(&rtoc_self_view, _)));
      ELSE
        RETURN FALSE;
      END
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__collect_bg_sources_in_expr(MUTABLE self: TypeAnalysisSession, expr: ?BgSourceWalkValue) RETURNS ![]SymbolEntry@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (IF castBgSourceWalkValueToLocatable(UNWRAP (expr)) EXISTS AS rtoc_bg_node THEN ((rtoc_bg_node IS_A BgBlock) OR (rtoc_bg_node IS_A BgStreamBlock)) ELSE FALSE END) THEN
      RETURN TRY (typeAnalysisSession__bg_sources_for_block(&rtoc_self_view, expr));
    END
    IF (["Identifier", "Literal", "FuncCall", "MethodCall", "GetField", "GetIndex", "BinaryOp", "UnaryOp"] |> DISTINCT _).contains?(locatable__variant_name(UNWRAP (castBgSourceWalkValueToLocatable(UNWRAP (expr))))) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_510: []SymbolEntry@multiowned = List[]; rtoc_empty_list_510 } ) AS []SymbolEntry@multiowned);
    END
    IF expr EXISTS AS rtoc_expr THEN
      IF castBgSourceWalkValueToLocatable(rtoc_expr) EXISTS AS rtoc_node THEN
        RETURN locatable__child_nodes(rtoc_node) |> UNNEST TRY (typeAnalysisSession__collect_bg_sources_walk(&rtoc_self_view, castLocatableToBgSourceWalkValue(_)));
      END
    END
    RETURN CAST(( { MUTABLE rtoc_empty_list_511: []SymbolEntry@multiowned = List[]; rtoc_empty_list_511 } ) AS []SymbolEntry@multiowned);
}
END
PRIVATE FN typeAnalysisSession__collect_bg_sources_walk(MUTABLE self: TypeAnalysisSession, v: ?BgSourceWalkValue) RETURNS ![]SymbolEntry@multiowned
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN TRY (typeAnalysisSession__collect_bg_sources_in_expr(&rtoc_self_view, v));
}
