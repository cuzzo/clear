  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN diagnosticAnchor__token(node_or_token);
}
END
PRIVATE FN typeAnalysisSession__source_error_token(self: TypeAnalysisSession, token: ?Token) RETURNS ?Token
  REQUIRES self: LOCAL
->
  RETURN COPY token;
END
PRIVATE FN typeAnalysisSession__diagnostic_output(MUTABLE self: TypeAnalysisSession, message: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    print(message);
    NIL;
}
