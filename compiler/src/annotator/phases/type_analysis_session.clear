PRIVATE FN typeAnalysisSession__suggestion_levenshtein(MUTABLE self: TypeAnalysisSession, left: String, right: String) RETURNS !Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (left.length() == 0) THEN
      RETURN right.codepointCount();
    END
    IF (right.length() == 0) THEN
      RETURN left.codepointCount();
    END
    MUTABLE previous: []Int64 = List[];
    MUTABLE rtoc_previous_seed = 0;
    WHILE rtoc_previous_seed <= right.length() DO
      &previous.append(rtoc_previous_seed);
      rtoc_previous_seed = rtoc_previous_seed + 1;
    END
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < left.length() DO
      MUTABLE current: []Int64 = [(rtoc_idx + 1)];
      MUTABLE rtoc_idx_n1 = 0;
      WHILE rtoc_idx_n1 < right.length() DO
          MUTABLE cost = IF (left.substr(rtoc_idx, 1) == right.substr(rtoc_idx_n1, 1)) THEN
              0
            ELSE
              1
            END;
          &current.append(min(min(((UNWRAP (current[rtoc_idx_n1])) + 1), ((UNWRAP (previous[(rtoc_idx_n1 + 1)])) + 1)), ((UNWRAP (previous[rtoc_idx_n1])) + cost)));
        rtoc_idx_n1 = rtoc_idx_n1 + 1;
      END
      previous = COPY current;
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN UNWRAP (previous.last());
}
END
PRIVATE FN typeAnalysisSession__emit_optional_field_safe_nav_finding_mut(MUTABLE self: TypeAnalysisSession, node: GetField, target_type: Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE token = COPY node.token;
    MUTABLE fix = TRY (fix__new(TRY (typeAnalysisSession__fix_description(rtoc_self_view, :INSERT_SAFE_NAVIGATION)), [edit__new(span__new(NIL, token.line, (token.column - 1), 0), "?")], :auto));
    TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ GetField: COPY node } }, :type, [fix], NIL, :OPTIONAL_FIELD_REQUIRES_SAFE_NAV, :error, FALSE, CAST({:field: node.field, :type: TRY (type__surface_name(castTypeToTypeTypeInput__type_analysis_session(target_type))), :target: aST__node_name(node.target)} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__emit_mutable_unused_finding_mut(MUTABLE self: TypeAnalysisSession, reg: ?TypeAnalysisReg, name: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF reg EXISTS AS reg_value THEN
      MUTABLE tok_branch_value: ?Token = NIL;
      IF reg_value IS_A VarDecl AS var_decl THEN
        tok_branch_value = varDecl__token(var_decl);
      ELSE
        PARTIAL MATCH reg_value START
          TypeAnalysisReg.VarDecl AS item -> tok_branch_value = COPY item.token;,
          TypeAnalysisReg.DestructureTarget AS item -> tok_branch_value = COPY item.token;,
          DEFAULT -> tok_branch_value = NIL;
        END
      END
      MUTABLE tok: Token = tok_branch_value?;
      MUTABLE fixes = List[];
      IF (TRY (token__text_mut(tok)) == "MUTABLE") THEN
        &fixes.append(TRY (fix__new(TRY (typeAnalysisSession__fix_description(rtoc_self_view, :REMOVE_MUTABLE_UNUSED)), [edit__new(span__new(NIL, tok.line, tok.column, "MUTABLE ".codepointCount()), "")], :auto)));
      END
      TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, diagnosticAnchor__of(castTypeAnalysisRegToLocatable(reg_value)), :lint, fixes, NIL, :MUTABLE_UNUSED, :warning, FALSE, CAST({:name: name} AS {String@symbol}Any)));
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__closest_name(MUTABLE self: TypeAnalysisSession, input: NameCandidate, candidates: []NameCandidate, max_distance: Int64 = 3) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE best: ?NameCandidate = NIL;
    MUTABLE best_d: Int64 = (max_distance + 1);
    FOR _ IN candidates DO
    MUTABLE d = TRY (typeAnalysisSession__levenshtein(&rtoc_self_view, nameCandidate__text(input), nameCandidate__text(_)));
    IF (d < best_d) THEN
        best = COPY _;
        best_d = d;
    END
    END
    IF (best_d <= max_distance) THEN
      RETURN nameCandidate__text(UNWRAP (best));
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__levenshtein(MUTABLE self: TypeAnalysisSession, a: String, b: String) RETURNS !Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (a.length() == 0) THEN
      RETURN b.codepointCount();
    END
    IF (b.length() == 0) THEN
      RETURN a.codepointCount();
    END
    MUTABLE prev: []Int64 = List[];
    MUTABLE rtoc_prev_seed = 0;
    WHILE rtoc_prev_seed <= b.length() DO
      &prev.append(rtoc_prev_seed);
      rtoc_prev_seed = rtoc_prev_seed + 1;
    END
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < a.length() DO
      MUTABLE curr: []Int64 = [(rtoc_idx + 1)];
      MUTABLE rtoc_idx_n2 = 0;
      WHILE rtoc_idx_n2 < b.length() DO
          MUTABLE cost = IF (a.substr(rtoc_idx, 1) == b.substr(rtoc_idx_n2, 1)) THEN
              0
            ELSE
              1
            END;
          &curr.append(min(min(((UNWRAP (curr[rtoc_idx_n2])) + 1), ((UNWRAP (prev[(rtoc_idx_n2 + 1)])) + 1)), ((UNWRAP (prev[rtoc_idx_n2])) + cost)));
        rtoc_idx_n2 = rtoc_idx_n2 + 1;
      END
      prev = COPY curr;
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN UNWRAP (prev.last());
}
END
PRIVATE FN typeAnalysisSession__emit_registry_mismatch_mut(MUTABLE self: TypeAnalysisSession, token: Token, name: NameCandidate, candidates: []NameCandidate, message: String, fix_label: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE best: ?String =   IF ((fix_label == "closest in-scope variable") AND compilerRegexMatch((CAST(name AS String)), compilerRegexCompile("\\A[A-Z]"))) THEN
      NIL
    ELSE
      TRY (typeAnalysisSession__closest_name(&rtoc_self_view, name, candidates))
    END;
    MUTABLE fixes = List[];
    IF best EXISTS AS best_value THEN
      &fixes.append(TRY (fix__new(TRY (typeAnalysisSession__fix_description(rtoc_self_view, :REPLACE_IDENTIFIER_WITH_CANDIDATE, CAST({:name: castNameCandidateToOptionalDiagnosticKwValue__type_analysis_session(name), :best: DiagnosticKwValue{ StringValue: COPY best_value }, :label: DiagnosticKwValue{ StringValue: COPY fix_label }} AS {String}DiagnosticKwValue))), [edit__new(span__new(NIL, token.line, token.column, (CAST(name AS String)).codepointCount()), best_value)], :auto)));
    END
    IF (fixes.length() == 0) THEN
      RETURN TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ TokenValue: COPY token }, TypeAnalysisCodeOrMessage{ SymbolValue: :REGISTRY_MISMATCH_REJECTED }, [], CAST({:detail: message} AS {String@symbol}Any)));
    END
    TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ TokenValue: COPY token }, :registry, fixes, NIL, :REGISTRY_MISMATCH_REJECTED, :error, FALSE, CAST({:detail: message} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__emit_typo_suggestion_mut(MUTABLE self: TypeAnalysisSession, token: ?TypoToken, name: String, candidates: []String, message: String, fix_label: String, category: String@symbol = :registry, cascade: Bool = TRUE) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE token_line: Int64 = CAST(UNWRAP (typoToken__line( UNWRAP (token))) AS Int64);
    MUTABLE token_column: Int64 = CAST(UNWRAP (typoToken__column( UNWRAP (token))) AS Int64);
    MUTABLE best: ?String =   IF ((fix_label == "closest in-scope variable") AND compilerRegexMatch(name, compilerRegexCompile("\\A[A-Z]"))) THEN
      NIL
    ELSE
      TRY (typeAnalysisSession__closest_name(&rtoc_self_view, NameCandidate{ StringValue: COPY name }, castStringListToNameCandidateList(candidates)))
    END;
    MUTABLE fixes = List[];
    IF best EXISTS AS best_value THEN
      &fixes.append(TRY (fix__new(TRY (typeAnalysisSession__fix_description(rtoc_self_view, :REPLACE_IDENTIFIER_WITH_CANDIDATE, CAST({:name: DiagnosticKwValue{ StringValue: COPY name }, :best: DiagnosticKwValue{ StringValue: COPY best_value }, :label: DiagnosticKwValue{ StringValue: COPY fix_label }} AS {String@symbol}DiagnosticKwValue))), [edit__new(span__new(NIL, token_line, token_column, name.codepointCount()), best_value)], :auto)));
    END
    IF (fixes.length() == 0) THEN
      RETURN TRY (typeAnalysisSession__error_mut(&rtoc_self_view, typoToken__anchor(token), TypeAnalysisCodeOrMessage{ SymbolValue: :TYPO_SUGGESTION_REJECTED }, [], CAST({:detail: message} AS {String@symbol}Any)));
    END
    TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, typoToken__anchor(token), category, fixes, NIL, :TYPO_SUGGESTION_REJECTED, :error, cascade, CAST({:detail: message} AS {String@symbol}Any)));
}
END
