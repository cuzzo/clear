PRIVATE FN typeAnalysisSession__restamp_auto_resolution_slots_mut(MUTABLE self: TypeAnalysisSession, resolved_slots: {AutoSlotId}Resolution) RETURNS ![Set]FunctionDef
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE touched_functions: [Set]FunctionDef = Set[];
    FOR _ IN resolved_slots.values() DO
    MUTABLE slot = COPY _.slot;
    IF (slot.kind == :param) THEN
        TRY (typeAnalysisSession__restamp_auto_param_mut(&rtoc_self_view, slot, _.type));
        &touched_functions.insert(COPY CAST(slot.decl_node AS FunctionDef));
    ELSE_IF (slot.kind == :return) THEN
        TRY (typeAnalysisSession__restamp_auto_return_mut(&rtoc_self_view, slot, _.type));
        &touched_functions.insert(COPY CAST(slot.decl_node AS FunctionDef));
    ELSE_IF (slot.kind == :local) OR (slot.kind == :list_element) OR (slot.kind == :map_key) OR (slot.kind == :map_value) THEN
        TRY (typeAnalysisSession__restamp_auto_local_mut(&rtoc_self_view, slot));
    END
    END
    RETURN touched_functions;
}
END
PRIVATE FN typeAnalysisSession__restamp_auto_param_mut(MUTABLE self: TypeAnalysisSession, slot: Slot, type: AutoConstraintCollectorObservedType) RETURNS !Void
  REQUIRES self: LOCAL
