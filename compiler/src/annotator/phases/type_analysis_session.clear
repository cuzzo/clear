PRIVATE FN typeAnalysisSession__record_ownership_transport_fact_mut(MUTABLE self: TypeAnalysisSession, node: Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (typeAnalysisSession__language_mode(&rtoc_self_view) == :strict) THEN
      RETURN;
    END
    MUTABLE fact_frames: []OwnershipTransportFacts@multiowned = COPY rtoc_self_view.audit_inputs.ownership_transport_frames;
    MUTABLE facts: ?OwnershipTransportFacts@multiowned = COPY fact_frames.last();
    IF facts EXISTS AS facts_value THEN
      MUTABLE facts_value_mutable = COPY facts_value;
      MUTABLE ancestors = (rtoc_self_view.traversal_state.annotation_ancestors |> LIMIT (rtoc_self_view.traversal_state.annotation_ancestors.length() - 1));
      IF node IS_A Identifier AS identifier THEN
        MUTABLE identifier_mutable = COPY identifier;
        FOR MUTABLE rtoc_mutable_block_param_22 IN fact_frames DO
        ownershipTransportFacts__record_read(&rtoc_mutable_block_param_22, identifier_mutable, ancestors);
        END
        RETURN;
      END
      IF ((((node IS_A VarDecl OR node IS_A BindExpr)) AND (locatable__ownership_transport_plan(node) != NIL)) AND (UNWRAP (locatable__ownership_transport_plan(node)).action == :pending)) THEN
        ownershipTransportFacts__record_alias(&facts_value_mutable, castLocatableToNode__type_analysis_session(node), ancestors);
      END
      IF node IS_A Assignment AS assignment THEN
        MUTABLE assignment_mutable = COPY assignment;
        MUTABLE target = assignment_mutable.name;
        MUTABLE root_branch_value: ?Identifier = NIL;
        IF ((target IS_A Identifier OR target IS_A GetField) OR target IS_A GetIndex) THEN
          root_branch_value = aST__root_identifier(castAssignmentNameToLocatable__type_analysis_session(target));
        ELSE
          root_branch_value = NIL;
        END
        MUTABLE root: ?Identifier = root_branch_value;
        IF (root != NIL) THEN
          FOR MUTABLE rtoc_mutable_block_param_23 IN fact_frames DO
          ownershipTransportFacts__record_mutation(&rtoc_mutable_block_param_23, Locatable{ Assignment: COPY assignment_mutable }, root, ancestors);
          END
        END
        MUTABLE value = assignment_mutable.value;
        IF (IF value IS_A Identifier AS rtoc_transfer_ident THEN (rtoc_transfer_ident.ownership_pending_transfer == TRUE) ELSE FALSE END) THEN
          ownershipTransportFacts__record_transfer(&facts_value_mutable, Locatable{ Assignment: COPY assignment_mutable }, OwnershipTransportSlot{ StringValue: COPY "value" }, UNWRAP (castLocatableToIdentifier(value)));
        END
      ELSE_IF (IF node IS_A BindExpr AS bind_expr THEN (bind_expr.mode != :decl) ELSE FALSE END) THEN
        MUTABLE entry: ?SymbolEntry@multiowned = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_24 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
        scope__resolve_entry(rtoc_local_receiver_24, CAST(locatable__name(node) AS String)) };
        IF entry EXISTS AS entry_value THEN
          MUTABLE entry_value_mutable = COPY entry_value;
          FOR MUTABLE rtoc_mutable_block_param_25 IN fact_frames DO
          ownershipTransportFacts__record_mutation_id(&rtoc_mutable_block_param_25, node, entry_value_mutable.ownership_binding_id, ancestors);
          END
        END
      END
      IF (node IS_A FuncCall OR node IS_A MethodCall) THEN
        MUTABLE signature: ?FunctionSignature@multiowned = locatable__matched_signature(node);
        MUTABLE actuals = IF node IS_A MethodCall THEN
          ([UNWRAP (locatable__object(node))] + (locatable__args(node) OR_ELSE List[]))
        ELSE
          locatable__args(node)
        END;
        IF signature THEN
          MUTABLE rtoc_each_items_26 = functionSignature__params(signature);
          MUTABLE rtoc_idx = 0;
          WHILE rtoc_idx < rtoc_mutable_block_param_25.length() DO
      MUTABLE argument = actuals[rtoc_idx];
      IF (UNWRAP (rtoc_each_items_26[rtoc_idx]).mutable() AND argument) THEN
                MUTABLE root: ?Identifier = aST__root_identifier(argument);
                IF (root != NIL) THEN
                  FOR MUTABLE rtoc_mutable_block_param_27 IN fact_frames DO
                  ownershipTransportFacts__record_mutation(&rtoc_mutable_block_param_27, node, root, ancestors);
                  END
                END
      END
    rtoc_idx = rtoc_idx + 1;
          END
        END
        MUTABLE rtoc_idx = 0;
        WHILE rtoc_idx < rtoc_mutable_block_param_27.length() DO
    IF (actuals[rtoc_idx] IS_A Identifier AND (actuals[rtoc_idx].ownership_pending_transfer == TRUE)) THEN
            ownershipTransportFacts__record_transfer(&facts_value_mutable, node, OwnershipTransportSlot{ Int64Value: rtoc_idx }, UNWRAP (actuals[rtoc_idx]));
    END
    rtoc_idx = rtoc_idx + 1;
        END
      ELSE_IF node IS_A StructLit AS struct_lit THEN
        FOR rtoc_each_key IN struct_lit.fields.keys() DO
    MUTABLE value = COPY UNWRAP (struct_lit.fields[rtoc_each_key]);
        IF (value IS_A Identifier AND (locatable__ownership_pending_transfer(value) == TRUE)) THEN
          ownershipTransportFacts__record_transfer(&facts_value_mutable, Locatable{ StructLit: COPY struct_lit }, OwnershipTransportSlot{ StringValue: COPY rtoc_each_key }, UNWRAP (castLocatableToIdentifier(value)));
        END
        END
      END
    ELSE
      RETURN;
    END
}
END
