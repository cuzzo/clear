WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE obj_type = TRY (aST__full_type_mut(node.object));
    IF !(obj_type) THEN
      RETURN FALSE;
    END
    MUTABLE resolved = IF TRUE THEN
      type__resolved(obj_type)
    ELSE
      symbol((CAST(obj_type AS String)))
    END;
    MUTABLE base = IF (TRUE AND type__generic_instance?(obj_type)) THEN
      type__generic_base(obj_type)
    ELSE
      resolved
