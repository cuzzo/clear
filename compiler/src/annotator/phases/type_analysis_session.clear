    TRY (typeAnalysisSession__resolve_call(&rtoc_self_view, FunctionCallNode{ FuncCall: COPY node }, node.args));
    TRY (typeAnalysisSession__record_predicate_call_site_mut(&rtoc_self_view, Node{ FuncCall: COPY node }));
    TRY (typeAnalysisSession__record_named_call_site_mut(&rtoc_self_view, &node));
    TRY (typeAnalysisSession__record_held_lock_call_site_mut(&rtoc_self_view, &node));
    NIL;
}
END
PRIVATE FN typeAnalysisSession__resolve_user_protocol_function_call_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: FuncCall) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF TRY (typeAnalysisSession__lookup_scope_for(&rtoc_self_view, UNWRAP (castCallNameToString(node.name)))) THEN
      RETURN FALSE;
    END
    MUTABLE matches: []Tuple<ProtocolDef, ProtocolRequirement, Type, Int64> = ( { MUTABLE rtoc_empty_list_284: []Tuple<ProtocolDef, ProtocolRequirement, Type, Int64> = List[]; rtoc_empty_list_284 } );
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < node.args.length() DO
      MUTABLE receiver = TRY (aST__full_type_mut(UNWRAP (node.args[rtoc_idx])));
      MUTABLE rtoc_each_items_285 = TRY (typeAnalysisSession__user_protocol_names_for_receiver(&rtoc_self_view, receiver));
      MUTABLE rtoc_idx_n5 = 0;
      WHILE rtoc_idx_n5 < rtoc_each_items_285.length() DO
          IF (rtoc_each_items_285[rtoc_idx_n5]? == "Map") THEN
            rtoc_idx_n5 = rtoc_idx_n5 + 1;
        CONTINUE;
          END
          MUTABLE protocol: ?ProtocolDef = typeAnalysisSession__semantic_protocol(&rtoc_self_view, rtoc_each_items_285[rtoc_idx_n5]?);
          MUTABLE requirement: ?ProtocolRequirement = ((protocol?.requirements OR_ELSE List[]) |> FIND (((!(_.is_method) AND (_.name == callName__string_value(node.name))) AND (_.params[rtoc_idx] != NIL)) AND (type__resolved(param__type(UNWRAP (_.params[rtoc_idx]))) == :Self)));
          IF ((protocol != NIL) AND (requirement != NIL)) THEN
              &matches.append(Tuple{protocol, requirement, receiver, rtoc_idx_n5});
          END
        rtoc_idx_n5 = rtoc_idx_n5 + 1;
      END
    rtoc_idx = rtoc_idx + 1;
    END
    MUTABLE rtoc_seen_keys: [Set]String = Set[];
    MUTABLE rtoc_unique: []Tuple<ProtocolDef, ProtocolRequirement, Type, Int64> = List[];
    FOR rtoc_match IN matches DO
      MUTABLE rtoc_key = "${rtoc_match._0.name}/${rtoc_match._1.name}";
      IF !(rtoc_seen_keys.contains?(rtoc_key)) THEN
        &rtoc_seen_keys.insert(COPY rtoc_key);
        &rtoc_unique.append(COPY rtoc_match);
      END
    END
    matches = rtoc_unique;
    IF (matches.length() == 0) THEN
      RETURN FALSE;
    END
    IF (matches.length() > 1) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ FuncCall: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_PROTOCOL_FUNCTION_AMBIGUOUS }, [], CAST({:name: node.name, :protocols: (matches |> SELECT _._0.name).join(", ")} AS {String@symbol}Any)));
    END
    MUTABLE protocol, requirement, receiver, receiver_index = UNWRAP (matches.first());
    MUTABLE signature = TRY (typeAnalysisSession__protocol_requirement_signature(&rtoc_self_view, protocol, requirement, receiver));
    TRY (typeAnalysisSession__verify_function_signature_mut(&rtoc_self_view, FunctionCallNode{ FuncCall: COPY node }, signature, node.args));
    node.matched_signature = signature;
    node.protocol_name = protocol.name;
    node.protocol_operation = symbol(requirement.name);
    node.protocol_receiver_index = receiver_index;
    TRY (typeAnalysisSession__stamp_resolved_call_result_mut(&rtoc_self_view, FunctionCallNode{ FuncCall: COPY node }, CAST(functionSignature__return_type(signature) AS Type), functionSignature__recoverable_result?(signature)));
    IF functionSignature__reentrant(signature) THEN
      TRY (typeAnalysisSession__record_effect(&rtoc_self_view, symbol("REENTRANT")));
    END
    IF typeAnalysisSession__current_fn_ctx(&rtoc_self_view) != NIL THEN
        MUTABLE rtoc_mutable_receiver_286 = UNWRAP (typeAnalysisSession__current_fn_ctx(&rtoc_self_view));
        functionContext__mark_runtime_used_mut(&rtoc_mutable_receiver_286);
    END
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__visit_MethodCall(MUTABLE self: TypeAnalysisSession, MUTABLE node: MethodCall) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__normalize_explicit_mutable_arguments_mut(&rtoc_self_view, Node{ MethodCall: COPY node });
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.object));
    FOR _ IN node.args DO
    TRY (typeAnalysisSession__visit(&rtoc_self_view, _));
    END
    TRY (typeAnalysisSession__reject_legacy_foreign_slice_view_mut(&rtoc_self_view, &node));
    TRY (typeAnalysisSession__reject_direct_observable_method_access_mut(&rtoc_self_view, &node));
    IF TRY (typeAnalysisSession__resolve_protocol_method_call_mut(&rtoc_self_view, &node)) THEN
      TRY (typeAnalysisSession__finalize_tense_navigation_method_mut(&rtoc_self_view, &node));
      RETURN;
    END
    IF TRY (typeAnalysisSession__resolve_collection_method(&rtoc_self_view, &node)) THEN
      TRY (typeAnalysisSession__validate_indirect_collection_insertion_mut(&rtoc_self_view, &node));
      MUTABLE receiver_type = TRY (aST__full_type_mut(node.object));
      MUTABLE element_type: ?Type = TRY (type__element_type(receiver_type));
      IF ((((element_type != NIL) AND TRY (type__node_reference?(element_type))) AND (["append", "push", "insert"]).contains?(node.name)) AND node.args.any?()) THEN
        MUTABLE value_arg = COPY UNWRAP (node.args.last());
        MUTABLE actual_type = TRY (aST__full_type_mut(value_arg));
        IF (!(TRY (type__node_reference?(actual_type))) AND TRY (type__accepts?(element_type, actual_type))) THEN
          locatable__set_coerced_type_object_mut(&value_arg, element_type);
        END
      END
      TRY (typeAnalysisSession__reject_mutating_borrowed_receiver_mut(&rtoc_self_view, &node));
      TRY (typeAnalysisSession__record_predicate_call_site_mut(&rtoc_self_view, Node{ MethodCall: COPY node }));
      TRY (typeAnalysisSession__finalize_tense_navigation_method_mut(&rtoc_self_view, &node));
      RETURN;
    END
    IF TRY (typeAnalysisSession__resolve_extern_method_call_mut(&rtoc_self_view, &node)) THEN
      TRY (typeAnalysisSession__reject_mutating_borrowed_receiver_mut(&rtoc_self_view, &node));
      TRY (typeAnalysisSession__finalize_tense_navigation_method_mut(&rtoc_self_view, &node));
      RETURN;
    END
    IF TRY (typeAnalysisSession__resolve_inherent_method_call_mut(&rtoc_self_view, &node)) THEN
      TRY (typeAnalysisSession__reject_mutating_borrowed_receiver_mut(&rtoc_self_view, &node));
      TRY (typeAnalysisSession__finalize_tense_navigation_method_mut(&rtoc_self_view, &node));
      RETURN;
    END
    IF TRY (typeAnalysisSession__resolve_intrinsic_method_call_mut(&rtoc_self_view, &node)) THEN
      TRY (typeAnalysisSession__validate_indirect_collection_insertion_mut(&rtoc_self_view, &node));
      TRY (typeAnalysisSession__reject_mutating_borrowed_receiver_mut(&rtoc_self_view, &node));
      TRY (typeAnalysisSession__finalize_tense_navigation_method_mut(&rtoc_self_view, &node));
      RETURN;
    END
    IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_287 = typeAnalysisSession__semantic_root_scope(&rtoc_self_view);
    scope__resolve_entry(rtoc_local_receiver_287, node.name) } THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ MethodCall: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :DOT_CALL_REQUIRES_METHOD }, [], CAST({:name: node.name} AS {String@symbol}Any)));
    END
    TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ MethodCall: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :UNKNOWN_INHERENT_METHOD }, [], CAST({:name: node.name, :type: TRY (type__surface_name( TypeTypeInput{ Type: COPY TRY (aST__full_type_mut(node.object)) }))} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__finalize_tense_navigation_method_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MethodCall) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(node.object IS_A TenseNavigation) THEN
      RETURN;
    END
    IF (UNWRAP (locatable__markers(node.object)).contains?("~") AND (node.mutates_receiver != NIL)) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ MethodCall: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :TENSE_NAVIGATION_MUTATION }, [], CAST({:markers: locatable__markers(node.object)} AS {String@symbol}Any)));
