PRIVATE FN typeAnalysisSession__type_conforms_to_protocol?(self: TypeAnalysisSession, argument: Type, protocol: String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (protocol == "Map") THEN
      RETURN (type__map?(argument) OR typeAnalysisSession__generic_parameter_has_map_bound?(rtoc_self_view, type__resolved(argument)));
    END
    IF (typeAnalysisSession__generic_parameter_protocol_names(rtoc_self_view, type__resolved(argument))).contains?(protocol) THEN
      RETURN TRUE;
    END
    RETURN !((typeAnalysisSession__conformance_match(rtoc_self_view, protocol, argument) == NIL));
}
END
PRIVATE FN typeAnalysisSession__conformance_match(self: TypeAnalysisSession, protocol: String, concrete: Type) RETURNS ?ConformanceMatch
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN typeAnalysisSession__conformance_match_avoiding(rtoc_self_view, protocol, concrete, Set[]);
}
