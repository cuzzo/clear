PRIVATE FN typeAnalysisSession__visit_WhileBindLoop(MUTABLE self: TypeAnalysisSession, MUTABLE node: WhileBindLoop) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.condition));
    MUTABLE ti = &node.condition.full_type_mut("WHILE AS condition");
    IF !((ti.optional?() OR TRY (type__stream_step?(ti)))) THEN
