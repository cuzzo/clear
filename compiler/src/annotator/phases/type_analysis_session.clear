      END
      subst[p_res] = GenericBinding{ TypeMultiowned: COPY actual_binding };
    ELSE_IF ((type__generic_instance?(param_type) AND type__generic_instance?(actual_type)) AND (type__generic_base(param_type) == type__generic_base(actual_type))) THEN
      (TRY (type__generic_args(param_type))).zip(TRY (type__generic_args(actual_type))).keys() |> EACH {
    MUTABLE a_arg: Any = ((TRY (type__generic_args(param_type))).zip(TRY (type__generic_args(actual_type)))[_] OR_ELSE panic("missing hash key"));
    IF !((_ AND a_arg)) THEN
