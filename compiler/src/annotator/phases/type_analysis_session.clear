PRIVATE FN typeAnalysisSession__enforce_shared_family_call_sync_mut(self: TypeAnalysisSession, node: GenericCallNode, signature: FunctionSignature, actual_args: []Locatable, type_params: []String@symbol) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE shared_args: []SharedGenericArg = ( { MUTABLE rtoc_empty_list_182: []SharedGenericArg = List[]; rtoc_empty_list_182 } );
    MUTABLE rtoc_each_items_183 = (TRY (functionSignature__params(signature)));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_183.length() DO
      MUTABLE arg: ?Locatable = COPY actual_args[rtoc_idx];
      IF !(arg) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE param_type = COPY rtoc_each_items_183[rtoc_idx]?.type;
      IF !((typeAnalysisSession__generic_shared_family_param?(rtoc_self_view, param_type) AND type_params.contains?(type__resolved(param_type)))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE actual_type = &arg.full_type_mut("shared generic call argument");
      IF !(type__shared?(actual_type)) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      &shared_args.append(SharedGenericArg{ name: COPY rtoc_each_items_183[rtoc_idx]?.name, type: CAST(COPY typeAnalysisSession__generic_shared_payload_binding(rtoc_self_view, actual_type) AS Type) });
    rtoc_idx = rtoc_idx + 1;
    END
    IF (shared_args.length() < 2) THEN
      RETURN;
    END
    MUTABLE first: ?SharedGenericArg = COPY shared_args.first();
    IF first EXISTS AS first_value THEN
      MUTABLE mismatch: ?SharedGenericArg = shared_args |> FIND !(typeAnalysisSession__same_shared_call_capability?(rtoc_self_view, first_value.type, _.type));
      IF mismatch EXISTS AS mismatch_value THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :POLY_SHARED_INCONSISTENT }, [], {:fn: node.name(), :first: first_value.name, :first_cap: typeAnalysisSession__shared_call_capability_display(rtoc_self_view, first_value.type), :second: mismatch_value.name, :second_cap: typeAnalysisSession__shared_call_capability_display(rtoc_self_view, mismatch_value.type)});
      ELSE
        RETURN;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__extract_type_bindings_mut(self: TypeAnalysisSession, node: GenericCallNode, param_type: Type, actual_type: Type, type_params: []String@symbol, MUTABLE subst: {String@symbol}GenericBinding) RETURNS !Void
