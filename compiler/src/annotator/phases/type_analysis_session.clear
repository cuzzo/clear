WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY typeAnalysisSession__phase_traversal_state(rtoc_self_view).body_fact_frames;
}
END
PRIVATE FN typeAnalysisSession__with_body_fact_frame(self: TypeAnalysisSession, identity_input: BodyIdentity, block: FN() -> Void) RETURNS !BodyScanSummary
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE identity = COPY identity_input;
    IF (identity.body_id == unassigned_body_id) THEN
      MUTABLE ordinal = typeAnalysisSession__phase_traversal_state(rtoc_self_view).next_synthetic_body_ordinal;
      typeAnalysisSession__phase_traversal_state(rtoc_self_view).next_synthetic_body_ordinal=((typeAnalysisSession__phase_traversal_state(rtoc_self_view).next_synthetic_body_ordinal() - 1));
      identity = BodyIdentity{ definition_id: COPY DefId{ value: ordinal }, body_id: COPY BodyId{ value: ordinal } };
    END
    MUTABLE frame = bodyFactFrame__for_identity(identity);
    typeAnalysisSession__body_fact_frames(rtoc_self_view).append(frame);
    DEFER {
    MUTABLE popped: ?BodyFactFrame = typeAnalysisSession__body_fact_frames(rtoc_self_view).pop();
    IF !(popped.equal?(frame)) THEN
      panic("BUG: body fact frame mismatch");
    END
    }
    block();
    RETURN bodyFactFrame__to_summary(frame);
}
END
PRIVATE FN typeAnalysisSession__with_body_fact_nested_body<Result>(self: TypeAnalysisSession, block: FN() -> Result) RETURNS Result
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE frames: []BodyFactFrame = ( { MUTABLE rtoc_empty_list_263: []BodyFactFrame = List[]; rtoc_empty_list_263 } );
    MUTABLE snapshots: []BodyFactContext = ( { MUTABLE rtoc_empty_list_264: []BodyFactContext = List[]; rtoc_empty_list_264 } );
    frames = typeAnalysisSession__body_fact_frames(rtoc_self_view);
    snapshots = ( { MUTABLE rtoc_map_results = CAST([] AS []BodyFactContext); frames |> EACH { &rtoc_map_results.append(COPY bodyFactFrame__context(_)); }; rtoc_map_results } );
    DEFER frames.zip(snapshots).keys() |> EACH {
    MUTABLE snapshot_value: Any = (frames.zip(snapshots)[_] OR_ELSE panic("missing hash key"));
    bodyFactFrame__restore_context(&_, snapshot_value);
    };
    FOR _ IN frames DO
    _.record_call_sites = FALSE;
    _.track_with_scope_stack = FALSE;
    _.with_scope_stack = ( { MUTABLE rtoc_empty_list_265: []WithBlock@multiowned = List[]; rtoc_empty_list_265 } );
    END
    RETURN block();
}
END
