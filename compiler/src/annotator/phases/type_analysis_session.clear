          TRY (typeAnalysisSession__emit_capture_immutable_as_mutable_error_mut(&rtoc_self_view, &node_narrowed, cap_name, owner_scope));
      END
      END
      scope__mark_read(&owner_scope, cap_name);
      captures[rtoc_idx].type = symbolEntry__type(entry);
      captures[rtoc_idx].storage = symbolEntry__storage(entry);
