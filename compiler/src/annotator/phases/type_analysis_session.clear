    SourceNode.ExternFnDecl AS cast_payload -> RETURN Node{ ExternFnDecl: COPY cast_payload };,
    SourceNode.ExternStructDecl AS cast_payload -> RETURN Node{ ExternStructDecl: COPY cast_payload };,
    SourceNode.UnionDef AS cast_payload -> RETURN Node{ UnionDef: COPY cast_payload };,
