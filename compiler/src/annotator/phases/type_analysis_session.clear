      rtoc_writer_receiver_493.else_drops = drops;
    ELSE
      locatable__set_deferred_drops_mut(&node, drops);
    END
    IF (branch == NIL) THEN
      MUTABLE rtoc_each_items_494 = (TRY (typeAnalysisSession__current_scope(&rtoc_self_view))).owned_names;
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < rtoc_each_items_494.length() DO
      MUTABLE info: ?SymbolEntry@multiowned = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_495 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
      scope__local_entry(rtoc_local_receiver_495, UNWRAP (rtoc_each_items_494[rtoc_idx])) };
      IF !(info) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF UNWRAP (rtoc_each_items_494[rtoc_idx]).startsWith?("_") THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF symbolEntry__read(info) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF ((info.reg != NIL) AND (symbolEntryRegInput__var_used(UNWRAP (info.reg)) OR_ELSE FALSE)) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !(symbolEntry__ownership_kind(info)) THEN
            TRY (typeAnalysisSession__classify_ownership_mut(&rtoc_self_view, &info));
      END
      IF ([:resource, :collection, :rc]).contains?(symbolEntry__ownership_kind(info)) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !(info.reg) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE loc: String = "";
          IF TRUE THEN
            loc = " (line ${UNWRAP (info.reg).line})";
          ELSE
            loc = "";
          END
      print("\x1B[33m[Warning]\x1B[0m Unused variable '${UNWRAP (rtoc_each_items_494[rtoc_idx])}'${loc}");
    rtoc_idx = rtoc_idx + 1;
      END
      MUTABLE rtoc_each_items_496 = (TRY (typeAnalysisSession__current_scope(&rtoc_self_view))).owned_names;
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < rtoc_each_items_496.length() DO
      MUTABLE info: ?SymbolEntry@multiowned = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_497 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
      scope__local_entry(rtoc_local_receiver_497, UNWRAP (rtoc_each_items_496[rtoc_idx])) };
      IF !(info) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF UNWRAP (rtoc_each_items_496[rtoc_idx]).startsWith?("_") THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !(info.mutable) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !((symbolEntry__read(info) OR (((symbolEntryRegInput__var_used(info.reg) != NIL) AND info.reg.var_used)))) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF ((symbolEntryRegInput__var_mutated(info.reg) != NIL) AND info.reg.var_mutated) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF (TRUE AND symbolEntry__mutated(info)) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      TRY (typeAnalysisSession__emit_mutable_unused_finding_mut(&rtoc_self_view, castOptionalSymbolEntryRegInputToOptionalReg(info.reg), UNWRAP (rtoc_each_items_496[rtoc_idx])));
    rtoc_idx = rtoc_idx + 1;
      END
    END
    NIL;
}
END
PRIVATE FN typeAnalysisSession__collect_scope_drops(MUTABLE self: TypeAnalysisSession, node: ?MatchStatement = NIL) RETURNS ![]DeferredDrop
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE drops: []DeferredDrop = ( { MUTABLE rtoc_empty_list_498: []DeferredDrop = List[]; rtoc_empty_list_498 } );
    FOR _ IN ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_499 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
    TRY (scope__owned_entries(rtoc_local_receiver_499)) }) DO
    MUTABLE rtoc_mutable_block_param_503 = COPY _;
    IF !({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_502 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
    ownershipGraph__live?(rtoc_local_receiver_502, rtoc_mutable_block_param_503._0) }) THEN
      CONTINUE;
    END
    IF !(symbolEntry__ownership_kind(rtoc_mutable_block_param_503._1)) THEN
        TRY (typeAnalysisSession__classify_ownership_mut(&rtoc_self_view, &rtoc_mutable_block_param_503._1));
    END
    IF (symbolEntry__ownership_kind(rtoc_mutable_block_param_503._1) == :resource) THEN
        &drops.append(TRY (typeAnalysisSession__deferred_drop_for(&rtoc_self_view, rtoc_mutable_block_param_503._0, rtoc_mutable_block_param_503._1, TRUE)));
        TRY (typeAnalysisSession__og_drop(&rtoc_self_view, rtoc_mutable_block_param_503._0));
    ELSE_IF (symbolEntry__ownership_kind(rtoc_mutable_block_param_503._1) == :affine) THEN
        MUTABLE t = TRY (type__new( TypeConstructionInput{ Type: COPY symbolEntry__type(rtoc_mutable_block_param_503._1) }));
        IF ((node != NIL) AND TRY (type__single_future?(t))) THEN
          TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ MatchStatement: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :PROMISE_NOT_CONSUMED }, [], CAST({:name: rtoc_mutable_block_param_503._0} AS {String@symbol}Any)));
        END
        &drops.append(TRY (typeAnalysisSession__deferred_drop_for(&rtoc_self_view, rtoc_mutable_block_param_503._0, rtoc_mutable_block_param_503._1)));
        TRY (typeAnalysisSession__og_drop(&rtoc_self_view, rtoc_mutable_block_param_503._0));
    END
    END
    RETURN drops;
}
END
