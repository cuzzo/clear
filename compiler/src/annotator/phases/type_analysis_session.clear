PRIVATE FN typeAnalysisSession__with_body_fact_failure_absorbed<Result>(self: TypeAnalysisSession, absorbed: Bool, block: FN() -> Result) RETURNS Result
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(absorbed) THEN
      RETURN block();
    END
    MUTABLE frames: []BodyFactFrame = ( { MUTABLE rtoc_empty_list_272: []BodyFactFrame = List[]; rtoc_empty_list_272 } );
    MUTABLE snapshots: []BodyFactContext = ( { MUTABLE rtoc_empty_list_273: []BodyFactContext = List[]; rtoc_empty_list_273 } );
    frames = typeAnalysisSession__body_fact_frames(rtoc_self_view);
    snapshots = ( { MUTABLE rtoc_map_results = CAST([] AS []BodyFactContext); frames |> EACH { &rtoc_map_results.append(COPY bodyFactFrame__context(_)); }; rtoc_map_results } );
    DEFER frames.zip(snapshots).keys() |> EACH {
    MUTABLE snapshot_value: Any = (frames.zip(snapshots)[_] OR_ELSE panic("missing hash key"));
    bodyFactFrame__restore_context(&_, snapshot_value);
    };
    FOR _ IN frames DO
    _.failure_absorbed = TRUE;
