PRIVATE FN typeAnalysisSession__finalize_ownership_transport_facts_mut(MUTABLE self: TypeAnalysisSession, facts: OwnershipTransportFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_each_items_377 = (TRY (ownershipTransportFacts__decisions(facts)));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_377.length() DO
      MUTABLE node: ?Any = COPY KEEP (rtoc_each_items_377[rtoc_idx]?.alias_fact).declaration;
      node?.ownership_transport_plan = COPY rtoc_each_items_377[rtoc_idx]?.plan;
      IF ((rtoc_each_items_377[rtoc_idx]?.plan).action == :move) THEN
          TRY (typeAnalysisSession__handle_assign_move(&rtoc_self_view, node));
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE previous_value = node.value();
      TRY (typeAnalysisSession__prepare_implicit_ownership_transport_mut(&rtoc_self_view, &node));
      IF !(node.value().equal?(previous_value)) THEN
          MUTABLE wrapper = node.value();
          typeAnalysisSession__record_capture_site_mut(&rtoc_self_view, &wrapper, TRUE);
          IF wrapper IS_A KeepNode THEN
            TRY (typeAnalysisSession__finish_previsited_keep_mut(&rtoc_self_view, &wrapper));
          ELSE
            TRY (typeAnalysisSession__finish_previsited_copy_mut(&rtoc_self_view, CAST(wrapper AS CopyNode)));
          END
      END
      MUTABLE symbol: ?SymbolEntry@multiowned = aST__node__symbol(castBindingNodeToLocatable(node));
      IF symbol != NIL THEN
          TRY (typeAnalysisSession__establish_inferred_alias_mut(&rtoc_self_view, &node, &symbol));
      END
    rtoc_idx = rtoc_idx + 1;
    END
    FOR _ IN (TRY (ownershipTransportFacts__transfer_decisions(facts))) DO
    TRY (typeAnalysisSession__finalize_pending_transfer_mut(&rtoc_self_view, _));
    END
}
END
PRIVATE FN typeAnalysisSession__finalize_pending_transfer_mut(MUTABLE self: TypeAnalysisSession, decision: TransferDecision) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE transfer = COPY decision.transfer;
    MUTABLE source = COPY transfer.source;
    IF decision.materialize THEN
      IF (TRUE AND (locatable__implicit_layout_cost(transfer.container) == TRUE)) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY Locatable{ Identifier: COPY source } }, TypeAnalysisCodeOrMessage{ SymbolValue: :INDIRECT_TRANSFER_REQUIRES_COPY }, [], CAST({:name: source.name} AS {String@symbol}Any)));
      END
      MUTABLE source_type = TRY (aST__full_type_mut(Locatable{ Identifier: COPY source }));
      MUTABLE wrapper =     IF (TRY (type__any_rc?(source_type)) OR type__split?(source_type)) THEN
        KeepNode{ token: COPY source.token, value: Locatable{ Identifier: COPY source }, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, carrier_op: NIL }
      ELSE
        CopyNode{ token: COPY source.token, value: Locatable{ Identifier: COPY source }, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, deep_copy: NIL, carrier_op: NIL, own: NIL, alloc: NIL }
      END;
      typeAnalysisSession__record_capture_site_mut(&rtoc_self_view, &wrapper, TRUE);
      IF wrapper IS_A KeepNode THEN
        TRY (typeAnalysisSession__finish_previsited_keep_mut(&rtoc_self_view, &wrapper));
      ELSE
        TRY (typeAnalysisSession__finish_previsited_copy_mut(&rtoc_self_view, CAST(wrapper AS CopyNode)));
      END
      MUTABLE container = COPY transfer.container;
      IF container IS_A FuncCall AS func_call THEN
        MUTABLE func_call_mutable = COPY func_call;
        func_call_mutable.args[CAST(KEEP transfer.slot AS Int64)] = wrapper;
      ELSE_IF (container IS_A MethodCall) THEN
        MUTABLE index: Int64 = COPY CAST(KEEP transfer.slot AS Int64);
        IF index.zero?() THEN
          container.object = wrapper;
        ELSE
          MUTABLE rtoc_index_receiver_378 = container.args();
          rtoc_index_receiver_378[(index - 1)] = wrapper;
        END
      ELSE_IF container IS_A StructLit AS struct_lit THEN
        MUTABLE struct_lit_mutable = COPY struct_lit;
        struct_lit_mutable.fields[CAST(KEEP transfer.slot AS String)] = wrapper;
      ELSE_IF container IS_A Assignment AS assignment THEN
        MUTABLE assignment_mutable = COPY assignment;
        assignment_mutable.value = wrapper;
      END
    ELSE
      source.was_moved = TRUE;
      IF TRUE THEN
        locatable__set_was_moved_mut(&transfer.container, TRUE);
      END
      TRY (typeAnalysisSession__og_set_moved(&rtoc_self_view, source.name, source.token, :move));
    END
}
END
PRIVATE FN typeAnalysisSession__establish_inferred_alias_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: DeclarationNode, MUTABLE symbol: SymbolEntry) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE plan: Any = NIL;
    MATCH node START
      DeclarationNode.VarDecl AS item ->
        plan = COPY item.ownership_transport_plan;,
      DeclarationNode.BindExpr AS item ->
        plan = COPY item.ownership_transport_plan;,
    END
    IF !(FALSE) THEN
      RETURN;
    END
    IF (typeAnalysisSession__language_mode(&rtoc_self_view) == :strict) THEN
      RETURN;
    END
    IF (plan.action == :pending) THEN
      RETURN;
    END
    IF ((plan.action == :move) OR (plan.last_alias_use == NIL)) THEN
      RETURN;
    END
    MUTABLE source_type = (MATCH node START DeclarationNode.VarDecl AS item -> TRY (aST__full_type_mut(item.value)), DeclarationNode.BindExpr AS item -> TRY (aST__full_type_mut(item.value)) END);
    IF TRY (type__implicitly_copyable?(source_type, %(name: String@symbol) USE(MUTABLE rtoc_self_view) -> TRY (typeAnalysisSession__schema_lookup_result(&rtoc_self_view, name)))) THEN
      RETURN;
    END
    IF !((plan.action == :borrow)) THEN
      RETURN;
    END
    symbolEntry__mark_non_escaping_mut(&symbol);
    symbolEntry__mark_borrowed_alias_mut(&symbol);
    MUTABLE rtoc_graph_15088 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
    MUTABLE graph_node: ?OwnershipNode = COPY ownershipGraph__get_index(rtoc_graph_15088, plan.destination);
    IF graph_node EXISTS AS graph_node_value THEN
      MUTABLE graph_node_value_mutable = COPY graph_node_value;
      graph_node_value_mutable.kind = :borrowed;
    END
}
END
