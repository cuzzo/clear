WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn: FunctionDef = COPY CAST(slot.decl_node AS FunctionDef);
    MUTABLE param = COPY UNWRAP (fn.params[UNWRAP (slot.index)]);
    MUTABLE concrete = TRY (type__new(castAutoConstraintCollectorObservedTypeToTypeConstructionInput__type_analysis_session(type)));
    param.type = concrete;
    IF param.symbol EXISTS AS symbol_value THEN
      MUTABLE symbol_value_mutable = COPY symbol_value;
      TRY (symbolEntry__set_type(&symbol_value_mutable, castTypeToOptionalSymbolEntryTypeInput__type_analysis_session(TRY (type__new(castTypeToTypeConstructionInput__type_analysis_session(concrete))))));
    END
}
END
