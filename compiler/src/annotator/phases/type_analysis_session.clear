PRIVATE FN typeAnalysisSession__declare_borrowed_capability_mut(MUTABLE self: TypeAnalysisSession, fact: CapabilityTransition) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE qualifier: ?String = capabilityTransition__borrowed_rejection_qualifier(fact);
    IF qualifier EXISTS AS qualifier_value THEN
      TRY (typeAnalysisSession__emit_borrowed_rejection_mut(&rtoc_self_view, fact, qualifier_value));
    END
    MUTABLE alias_name = COPY fact.alias_name;
    MUTABLE resolved_type = TRY (typeAnalysisSession__capability_alias_type(&rtoc_self_view, CAST(typeAnalysisSession__capability_source_type(&rtoc_self_view, fact) AS Type)));
    MUTABLE rtoc_mutable_receiver_228 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
    TRY (scope__declare(&rtoc_mutable_receiver_228, alias_name, NIL, SymbolEntryTypeInput{ TypeMultiowned: COPY resolved_type }, ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    IF fact.alias_explicit THEN
      typeAnalysisSession__record_capture_local_mut(&rtoc_self_view, alias_name);
    END
    MUTABLE sym = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_229 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
    scope__local_entry_mut(&rtoc_local_receiver_229, alias_name) };
    symbolEntry__mark_non_escaping_mut(&sym);
    symbolEntry__mark_borrowed_alias_mut(&sym);
    TRY (typeAnalysisSession__og_declare(&rtoc_self_view, alias_name, NIL, TypeTypeInput{ Type: COPY resolved_type }));
    MUTABLE rtoc_mutable_receiver_230 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
    TRY (ownershipGraph__borrow(&rtoc_mutable_receiver_230, "__borrowed_${fact.var_name}", fact.var_name, FALSE));
}
END
PRIVATE FN typeAnalysisSession__emit_borrowed_rejection_mut(MUTABLE self: TypeAnalysisSession, fact: CapabilityTransition, qualifier: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE remediation = "BORROWED guarantees the data is stable, but ${qualifier} data can be modified concurrently. Use WITH ${fact.var_name} { } to access it safely instead.";
    TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY fact.var_node }, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_BORROWED_ON_QUALIFIED_VAR }, [], CAST({:qualifier: qualifier, :name: fact.var_name, :remediation: remediation} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__capability_source_type(MUTABLE self: TypeAnalysisSession, fact: CapabilityTransition) RETURNS Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF type__untyped?(fact.resolved_type) THEN
      RETURN CAST(capabilityTransition__declared_source_type(fact) AS Type);
    ELSE
      RETURN COPY fact.resolved_type;
    END
}
END
PRIVATE FN typeAnalysisSession__capability_alias_type(MUTABLE self: TypeAnalysisSession, type: Type) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE t = TRY (type__new(castTypeToTypeConstructionInput__type_analysis_session(type)));
    IF (type__any_sync?(t) OR (type__ownership(t) != :affine)) THEN
      RETURN TRY (type__bare_data_type(t));
    ELSE
      RETURN t;
    END
}
END
PRIVATE FN typeAnalysisSession__new_capture_analysis(MUTABLE self: TypeAnalysisSession) RETURNS CaptureAnalysis
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN CaptureAnalysis{ has_local: FALSE, has_rc: FALSE, has_shared: FALSE, has_sharded: FALSE, has_affine_locked: FALSE, has_outer_ref: FALSE, has_non_escaping_capture: FALSE, captures: {}, capture_symbols: {}, close_plans: {}, pointer_captures: Set[], string_captures: Set[], resource_captures: Set[], site_moved: Set[], site_copied: Set[], strategies: {}, move_mark_names: Set[], alloc_mark_entries: {} };
}
END
PRIVATE FN typeAnalysisSession__with_fiber_capture_analysis(MUTABLE self: TypeAnalysisSession, MUTABLE is_parallel: ?Bool = FALSE, mark_moves: Bool = FALSE, blk: FN() -> Void) RETURNS !?CaptureAnalysis
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE ctx: ?CaptureContext = NIL;
  MUTABLE state: CapabilityAuditInputs = typeAnalysisSession__phase_audit_inputs(&rtoc_self_view);
  ctx = CaptureContext{ analysis: COPY typeAnalysisSession__new_capture_analysis(&rtoc_self_view), outer_scope: TRY (typeAnalysisSession__current_scope(&rtoc_self_view)), locals: COPY Set[], is_parallel: !(!(is_parallel)), mark_moves: mark_moves };
  DEFER {
  MUTABLE popped: ?CaptureContext = &state.capture_stack.pop();
  IF (popped == NIL) THEN
      panic("BUG: capture context mismatch");
  END
  }
  &state.capture_stack.append(UNWRAP (COPY ctx));
  blk();
  RETURN COPY ctx?.analysis;
}
END
PRIVATE FN typeAnalysisSession__current_capture_context(MUTABLE self: TypeAnalysisSession) RETURNS ?CaptureContext
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN COPY typeAnalysisSession__phase_audit_inputs(&rtoc_self_view).capture_stack.last();
}
END
PRIVATE FN typeAnalysisSession__record_capture_local_mut(MUTABLE self: TypeAnalysisSession, name: ?String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF name EXISTS AS name_value THEN
      IF typeAnalysisSession__current_capture_context(&rtoc_self_view) EXISTS AS MUTABLE capture_context THEN
      &capture_context.locals.insert(COPY name_value);
    END
    END
}
END
PRIVATE FN typeAnalysisSession__record_capture_site_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: CaptureSiteNode, copied: Bool) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE ctx: ?CaptureContext = typeAnalysisSession__current_capture_context(&rtoc_self_view);
    IF ctx EXISTS AS MUTABLE ctx_value THEN
      MUTABLE root: ?Identifier = (aST__root_identifier( UNWRAP (captureSiteNode__value(node))));
      MUTABLE name: ?String = COPY (IF root != NIL THEN
        (identifier__name(root) OR_ELSE "")
      ELSE
        NIL
      END);
      IF (!(name) OR ctx_value.locals.contains?(name)) THEN
        RETURN;
      END
      IF copied THEN
        &ctx_value.analysis.site_copied.insert(name);
      ELSE
        &ctx_value.analysis.site_moved.insert(name);
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__record_capture_identifier_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: Identifier) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE ctx: ?CaptureContext = typeAnalysisSession__current_capture_context(&rtoc_self_view);
    IF ctx EXISTS AS ctx_value THEN
      MUTABLE name = COPY node.name;
      IF (ctx_value.locals.contains?(name) OR (["TRUE", "FALSE", "VOID", "_"]).contains?(name)) THEN
        RETURN;
      END
      MUTABLE info: ?SymbolEntry@multiowned = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_231 = (KEEP ctx_value.outer_scope);
      scope__resolve_entry(rtoc_local_receiver_231, name) };
      MUTABLE resolved_sym: ?SymbolEntry@multiowned = (IF info != NIL THEN info ELSE node.symbol END);
      IF typeAnalysisSession__non_escaping_fiber_capture?(&rtoc_self_view, resolved_sym) THEN
        MUTABLE rtoc_ctx_analysis = COPY ctx_value.analysis; rtoc_ctx_analysis.has_non_escaping_capture = TRUE;
      END
      IF info EXISTS AS info_value THEN
        TRY (typeAnalysisSession__record_capture_info_mut(&rtoc_self_view, ctx_value, name, info_value, &node));
        MUTABLE rtoc_info_slot = COPY info_value;
        TRY (typeAnalysisSession__record_capture_move_mut(&rtoc_self_view, ctx_value, name, &rtoc_info_slot, &node));
      ELSE
      IF TRY (typeAnalysisSession__lookup_scope_for(&rtoc_self_view, name)) THEN
          MUTABLE rtoc_outer_analysis = COPY ctx_value.analysis; rtoc_outer_analysis.has_outer_ref = TRUE;
      END
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__non_escaping_fiber_capture?(MUTABLE self: TypeAnalysisSession, symbol: ?SymbolEntry) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(symbol) THEN
      RETURN FALSE;
    END
    MUTABLE rtoc_alias_symbol = symbol;
    IF !((symbolEntry__borrowed_alias(rtoc_alias_symbol) AND symbolEntry__non_escaping(rtoc_alias_symbol))) THEN
      RETURN FALSE;
    END
    RETURN (((!(symbolEntry__locked?(rtoc_alias_symbol)) AND !(symbolEntry__write_locked?(rtoc_alias_symbol))) AND !(symbolEntry__local?(rtoc_alias_symbol))) AND !(symbolEntry__atomic?(rtoc_alias_symbol)));
}
END
PRIVATE FN typeAnalysisSession__record_capture_info_mut(MUTABLE self: TypeAnalysisSession, ctx: CaptureContext, name: String, info: SymbolEntry, MUTABLE node: Identifier) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE result = COPY ctx.analysis;
    result.has_outer_ref = TRUE;
    IF !(result.captures.contains?(name)) THEN
      MUTABLE cap_type_branch_value: ?Type@multiowned = NIL;
      IF symbolEntry__atomic?(info) THEN
        cap_type_branch_value = symbolEntry__type(info);
      ELSE
        cap_type_branch_value = TRY (aST__full_type_mut(Locatable{ Identifier: COPY node }));
      END
      MUTABLE cap_type: Type@multiowned = cap_type_branch_value?;
      result.captures[name] = CAST(COPY cap_type AS Type);
      result.capture_symbols[name] = info;
      MUTABLE t = cap_type;
      MUTABLE close_plan: ?ResourceClosePlan = symbolEntry__close_plan(info);
      typeAnalysisSession__add_capture_name_when(&rtoc_self_view, &result.pointer_captures, name, type__needs_pointer_passing?(t));
      typeAnalysisSession__add_capture_name_when(&rtoc_self_view, &result.string_captures, name, TRY (type__string?(t)));
      typeAnalysisSession__add_capture_name_when(&rtoc_self_view, &result.resource_captures, name, (type__resource?(t) OR !((close_plan == NIL))));
      MUTABLE string_map_cleanup = (TRY (type__captured_plain_string_map_needs_deinit?(t)) AND (close_plan == NIL));
      typeAnalysisSession__add_capture_name_when(&rtoc_self_view, &result.resource_captures, name, string_map_cleanup);
      typeAnalysisSession__set_capture_close_plan_when(&rtoc_self_view, &result.close_plans, name, resourceClosePlan__method("deinit", 2), string_map_cleanup);
    END
    MUTABLE close_plan: ?ResourceClosePlan = symbolEntry__close_plan(info);
    typeAnalysisSession__set_capture_close_plan_when(&rtoc_self_view, &result.close_plans, name, close_plan, !((close_plan == NIL)));
    result.has_local = (result.has_local OR symbolEntry__local?(info));
    result.has_rc = (result.has_rc OR (symbolEntry__storage(info) == :multiowned));
    MUTABLE ti = symbolEntry__type(info);
    MUTABLE recursive_boundary_reason: ?String@symbol = TRY (type__parallel_boundary_forbidden_reason(ti, %(type_name: String@symbol) USE(MUTABLE rtoc_self_view) -> TRY (typeAnalysisSession__schema_lookup_result(&rtoc_self_view, type_name))));
    result.has_local = (result.has_local OR (recursive_boundary_reason == :local_scheduler_affinity));
    result.has_rc = (result.has_rc OR (recursive_boundary_reason == :non_atomic_rc));
    MUTABLE sync_capture = (!(((type__striped?(ti) AND ((type__shared?(ti) OR type__multiowned?(ti)))))) AND !(symbolEntry__atomic?(info)));
    MUTABLE sharded_capture = (sync_capture AND type__sharded?(ti));
    result.has_shared = (result.has_shared OR (sharded_capture OR ((sync_capture AND ((((symbolEntry__locked?(info) OR symbolEntry__write_locked?(info)) OR symbolEntry__local?(info)) OR symbolEntry__rc_stored?(info)))))));
    result.has_affine_locked = (result.has_affine_locked OR (sync_capture AND symbolEntry__affine_locked_capture?(info)));
    result.has_sharded = (result.has_sharded OR sharded_capture);
    TRY (typeAnalysisSession__audit_mark_captured(&rtoc_self_view, name, ctx.is_parallel));
}
END
PRIVATE FN typeAnalysisSession__add_capture_name_when(MUTABLE self: TypeAnalysisSession, MUTABLE names: [Set]String, name: String, active: Bool) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(active) THEN
      RETURN;
    END
    &names.insert(COPY name);
}
END
PRIVATE FN typeAnalysisSession__set_capture_close_plan_when(MUTABLE self: TypeAnalysisSession, MUTABLE plans: {String}ResourceClosePlan, name: String, plan: ?ResourceClosePlan, active: Bool) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(active) THEN
      RETURN;
    END
    plans[name] = (plans[name] OR_ELSE UNWRAP (plan));
}
END
PRIVATE FN typeAnalysisSession__record_capture_move_mut(MUTABLE self: TypeAnalysisSession, ctx: CaptureContext, name: String, MUTABLE info: SymbolEntry, MUTABLE node: Identifier) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !((ctx.mark_moves AND typeAnalysisSession__phase_audit_inputs(&rtoc_self_view).capture_move_suppression_depth.zero?())) THEN
      RETURN;
    END
    IF !(((COPY ctx.outer_scope).owned_names).contains?(name)) THEN
      RETURN;
    END
    IF !(symbolEntry__ownership_kind(info)) THEN
      TRY (typeAnalysisSession__classify_ownership_mut(&rtoc_self_view, &info));
    END
    IF symbolEntry__capture_move_required?(info, { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_233 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
    ownershipGraph__live?(rtoc_local_receiver_233, name) }) THEN
      TRY (typeAnalysisSession__og_set_moved(&rtoc_self_view, name, node.token, :capture));
    END
}
END
PRIVATE FN typeAnalysisSession__without_capture_moves<RESULT>(MUTABLE self: TypeAnalysisSession, blk: FN() -> RESULT) RETURNS RESULT
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  DEFER rtoc_self_view.audit_inputs.capture_move_suppression_depth=((typeAnalysisSession__phase_audit_inputs(&rtoc_self_view).capture_move_suppression_depth - 1));
  rtoc_self_view.audit_inputs.capture_move_suppression_depth=((typeAnalysisSession__phase_audit_inputs(&rtoc_self_view).capture_move_suppression_depth + 1));
  RETURN blk();
}
END
PRIVATE FN typeAnalysisSession__validate_capture_analysis_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: Node, analysis: CaptureAnalysis, MUTABLE is_parallel: Bool, MUTABLE is_pinned: Bool) RETURNS !?CaptureAnalysis
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF is_parallel THEN
      IF analysis.has_local THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castNodeToLocatable(node)), TypeAnalysisCodeOrMessage{ SymbolValue: :LOCAL_VAR_NOT_IN_PARALLEL }));
      END
      IF analysis.has_rc THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castNodeToLocatable(node)), TypeAnalysisCodeOrMessage{ SymbolValue: :MULTIOWNED_NOT_IN_PARALLEL }));
      END
    END
    IF ((!(is_pinned) AND !(is_parallel)) AND analysis.has_shared) THEN
      RETURN COPY analysis;
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__capability_audit_init_mut(MUTABLE self: TypeAnalysisSession) RETURNS !{String}BindingAuditRecord
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE store = TRY (typeAnalysisSession__capability_audit_store(&rtoc_self_view));
    &store.clear();
    RETURN store;
