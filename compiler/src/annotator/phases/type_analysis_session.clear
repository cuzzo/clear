PRIVATE FN typeAnalysisSession__analyze_pipe_to_func_call(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    # UFC: inject the LHS as the call's first argument so the ordinary
    # FuncCall validation runs, then take it back out. CLEAR holds the args by
    # value, so each edit is a write-back into node.right, not an in-place
    # mutation of a returned list.
    PARTIAL MATCH node.right START
      Locatable.FuncCall AS MUTABLE injected_call ->
        injected_call.args = ([node.left] + injected_call.args);
        node.right = Locatable{ FuncCall: COPY injected_call };
    END
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.right));
    PARTIAL MATCH node.right START
      Locatable.FuncCall AS MUTABLE visited_call ->
        visited_call.args = visited_call.args |> SKIP 1;
        node.right = Locatable{ FuncCall: COPY visited_call };
    END
    MUTABLE result_type = TRY (aST__full_type_mut(node.right));
    IF (TRY (typeAnalysisSession__has_catch_blocks?(&rtoc_self_view)) AND TRUE) THEN
      MUTABLE t = TRY (type__new(TypeConstructionInput{ Type: COPY result_type }));
      IF type__error_union?(t) THEN
        result_type = UNWRAP (TRY (type__payload_type(t)));
      END
    END
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY node }, result_type));
    typeAnalysisSession__propagate_pipeline_recovery_mut(&rtoc_self_view, &node, castLocatableToFuncCall__type_analysis_session(node.right), !(TRY (typeAnalysisSession__has_catch_blocks?(&rtoc_self_view))));
    RETURN CAST(TRY (aST__full_type_mut(Locatable{ BinaryOp: COPY node })) AS ?Type);
}
END
PRIVATE FN typeAnalysisSession__analyze_pipe_to_identifier(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.right));
    MUTABLE t = TRY (aST__full_type_mut(node.right));
    MUTABLE sig: ?FunctionSignature@multiowned = functionSignature__unwrap(X{ Type: COPY t });
    MUTABLE func_name: ?String = locatable__name(node.right);
    IF sig != NIL THEN
      TRY (typeAnalysisSession__analyze_pipe_to_named_function(&rtoc_self_view, &node, sig, UNWRAP (func_name)));
    ELSE_IF ((type__resolved(t) == :Intrinsic) OR (type__resolved(t) == :Nil)) THEN
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY node }, IF (type__resolved(t) == :Intrinsic) THEN
        :Any
      ELSE
        type__resolved(t)
      END));
    ELSE
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ BinaryOp: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :PIPE_NOT_CALLABLE }, [], CAST({:name: func_name, :type: sig} AS {String@symbol}Any)));
    END
}
END
PRIVATE FN typeAnalysisSession__analyze_pipe_to_named_function(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp, sig: FunctionSignature, func_name: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE plan = TRY (typeAnalysisSession__pipe_arity_plan(&rtoc_self_view, sig, 1));
    IF pipeArityPlan__mismatch?(plan) THEN
      IF pipeArityPlan__exact?(plan) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ BinaryOp: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :ARITY_MISMATCH }, [], CAST({:name: func_name, :expected: plan.min_args, :got: plan.given_args} AS {String@symbol}Any)));
      ELSE
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ BinaryOp: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :ARITY_MISMATCH_RANGE }, [], CAST({:name: func_name, :min: plan.min_args, :max: plan.max_args, :got: plan.given_args} AS {String@symbol}Any)));
      END
    END
    IF (plan.max_args >= 1) THEN
      MUTABLE param = COPY UNWRAP (plan.params[0]);
      MUTABLE expected = COPY param.type;
      MUTABLE actual: ?String@symbol = locatable__resolved_type(UNWRAP (locatable__left( Locatable{ BinaryOp: COPY node })));
      IF !(TRY (typeAnalysisSession__is_safe_autocast?(rtoc_self_view, (IF actual EXISTS AS rtoc_wrap_6015 THEN SourceType{ SymbolValue: COPY rtoc_wrap_6015 } ELSE NIL END), castTypeToTypeTypeInput__type_analysis_session(expected)))) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY node.left }, TypeAnalysisCodeOrMessage{ SymbolValue: :ARGUMENT_TYPE_ERROR }, [], CAST({:fn: "Pipe Input '${param.name}'", :index: 1, :expected: expected, :got: actual} AS {String@symbol}Any)));
      END
    END
    MUTABLE result_type = functionSignature__return_type(sig);
    IF (TRY (typeAnalysisSession__has_catch_blocks?(&rtoc_self_view)) AND TRUE) THEN
      MUTABLE t = result_type;
      IF type__error_union?(t) THEN
        result_type = UNWRAP (TRY (type__payload_type(t)));
      END
    END
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY node }, result_type));
    MUTABLE recoverable = TRY (type__new(TypeConstructionInput{ Type: COPY functionSignature__return_type(sig) }));
    IF (type__error_union?(recoverable) OR functionSignature__recoverable_result?(sig)) THEN
      IF !(TRY (typeAnalysisSession__has_catch_blocks?(&rtoc_self_view))) THEN
        node.error_union_type = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_137: ?Type = NIL;
        IF type__error_union?(recoverable) THEN
          rtoc_ternary_value_137 = recoverable;
        ELSE
          rtoc_ternary_value_137 = TRY (type__error_union_of(castTypeToTypeTypeInput__type_analysis_session(recoverable)));
        END
        rtoc_ternary_value_137? };
      END
      node.can_fail = TRUE;
    END
}
END
PRIVATE FN typeAnalysisSession__propagate_pipeline_recovery_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp, call: FuncCall, retain_error_union: Bool) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE error_type = NIL;
    error_type = call.error_union_type;
    IF (retain_error_union AND (error_type != NIL)) THEN
      node.error_union_type = error_type;
    END
    IF ((error_type != NIL) OR (call.can_fail == TRUE)) THEN
      node.can_fail = TRUE;
    END
}
END
PRIVATE FN typeAnalysisSession__pipe_arity_plan(MUTABLE self: TypeAnalysisSession, sig: FunctionSignature, given_args: Int64) RETURNS !PipeArityPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE params = TRY (functionSignature__params(sig));
    RETURN PipeArityPlan{ params: COPY params, min_args: params |> COUNT (_.required == TRUE), max_args: params.length(), given_args: COPY given_args };
}
END
PRIVATE FN typeAnalysisSession__analyze_each_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lhs_type = TRY (aST__full_type_mut(node.left));
    MUTABLE iterable = TRY (typeAnalysisSession__pipeline_source_fact(&rtoc_self_view, node.left, lhs_type));
    IF !(pipelineSourceFact__valid?(iterable)) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, (IF locatable__left(Locatable{ BinaryOp: COPY node }) EXISTS AS rtoc_wrap_6071 THEN DiagnosticAnchor{ Locatable: COPY rtoc_wrap_6071 } ELSE NIL END), TypeAnalysisCodeOrMessage{ SymbolValue: :EACH_NEEDS_COLLECTION }, [], CAST({:got: locatable__resolved_type(UNWRAP (locatable__left( Locatable{ BinaryOp: COPY node })))} AS {String@symbol}Any)));
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY node }, :Void));
      RETURN NIL;
    END
    MUTABLE item_type = COPY iterable.item_type;
    typeAnalysisSession__with_new_scope(&rtoc_self_view, typeAnalysisSession__current_scope(&rtoc_self_view), %() USE(item_type, node, MUTABLE rtoc_self_view) -> {
    MUTABLE rtoc_mutable_receiver_138 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
    TRY (scope__declare(&rtoc_mutable_receiver_138, "_", NIL, castTypeToOptionalSymbolEntryTypeInput__type_analysis_session(item_type), ScopeMutabilityInput{ BoolValue: TRUE }, FALSE, NIL, :stack));
    TRY (typeAnalysisSession__with_soa_tracking(&rtoc_self_view, node, item_type, %() USE(node, MUTABLE rtoc_self_view) -> {
      FOR _ IN locatable__body(node.right) DO
      TRY (typeAnalysisSession__visit(&rtoc_self_view, _));
      END
      NIL
    }))
    });
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY node }, :Void));
    node.storage_override = :frame;
    RETURN :frame;
}
END
PRIVATE FN typeAnalysisSession__analyze_skip_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lhs_type = TRY (aST__full_type_mut(node.left));
    MUTABLE source = TRY (typeAnalysisSession__pipeline_source_fact(&rtoc_self_view, node.left, lhs_type, TRUE));
    MUTABLE is_stream = pipelineSourceFact__stream?(source);
    TRY (typeAnalysisSession__require_array_input_mut(&rtoc_self_view, node, "SKIP", is_stream, is_stream));
    MUTABLE item_type = COPY source.item_type;
    TRY (typeAnalysisSession__visit(&rtoc_self_view, locatable__count(node.right)));
    MUTABLE count_type: ?String@symbol = locatable__resolved_type(UNWRAP (locatable__count(node.right)));
    IF !(([:Int64, :Float64]).contains?(count_type)) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, (IF locatable__count(node.right) EXISTS AS rtoc_wrap_6103 THEN DiagnosticAnchor{ Locatable: COPY rtoc_wrap_6103 } ELSE NIL END), TypeAnalysisCodeOrMessage{ SymbolValue: :SKIP_COUNT_NEEDS_NUMBER }, [], CAST({:got: count_type} AS {String@symbol}Any)));
    END
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY node }, IF pipelineSourceFact__inf_stream?(source) THEN
      symbol("~${castTypeToString(item_type)}[INF]")
    ELSE
      symbol("${castTypeToString(item_type)}[]")
    END));
    node.storage_override = :frame;
    RETURN :frame;
}
END
