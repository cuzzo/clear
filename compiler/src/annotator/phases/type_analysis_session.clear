    FOR _ IN sources DO
    TRY (typeAnalysisSession__verify_lifetime_source_mut(&rtoc_self_view, node, _));
    END
    TRY (typeAnalysisSession__verify_no_mixed_atomic_returned_lifetime_mut(&rtoc_self_view, node, sources));
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__verify_no_mixed_atomic_returned_lifetime_mut(MUTABLE self: TypeAnalysisSession, node: FunctionDef, sources: []FunctionSignatureLifetimeSource) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE requires_map: {Any}Any = {};
    IF TRUE THEN
      requires_map = ((node.requires OR_ELSE {}));
    ELSE
      requires_map = {};
    END
    IF (requires_map.count() == 0) THEN
      RETURN;
    END
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < sources.length() DO
      MUTABLE path = TRY (typeAnalysisSession__get_path_to_root(&rtoc_self_view, castFunctionSignatureLifetimeSourceToNode(sources[rtoc_idx]?)));
      IF (path.length() == 0) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE root_name = COPY CAST(path.first() AS String);
      MUTABLE families: ?[Set]String@symbol = COPY requires_map[root_name];
      IF !((((families != NIL) AND TRUE) AND (families.length() > 1))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !(families.contains?(:ATOMIC)) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE others: [Set]String@symbol = families.difference(([:ATOMIC] |> DISTINCT _));
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ FunctionDef: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :LIFETIME_RETURNS_REQUIRES_FAMILY_CONFLICT }, [], CAST({:fn: node.name, :name: root_name, :others: ((others |> SELECT COPY _)).join(" | "), :others_label: ((others |> SELECT COPY _)).join(" / ")} AS {String@symbol}Any)));
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PRIVATE FN typeAnalysisSession__verify_lifetime_source_mut(MUTABLE self: TypeAnalysisSession, node: FunctionDef, source_node: SourceNode) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
