PRIVATE FN typeAnalysisSession__downgrade_frame_to_stack(MUTABLE self: TypeAnalysisSession, MUTABLE node: AllocDeclarationNode, storage: String@symbol) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(((storage == :frame) AND typeAnalysisSession__current_loop_depth(&rtoc_self_view).positive?())) THEN
      RETURN storage;
    END
    IF !((MATCH node START AllocDeclarationNode.VarDecl AS item -> item.value IS_A StructLit, AllocDeclarationNode.BindExpr AS item -> item.value IS_A StructLit END)) THEN
      RETURN storage;
    END
    MUTABLE rtoc_mutable_receiver_238 = (TRY (aST__full_type_mut( castAllocDeclarationNodeToLocatable(node))));
    type__mark_stack_value_mut(&rtoc_mutable_receiver_238);
    allocDeclarationNode__set_storage_override_mut(&node, :stack);
    MUTABLE value_node: ?Locatable@boxed = NIL;
    MATCH node START
      AllocDeclarationNode.VarDecl AS item ->
        value_node = COPY item.value;,
      AllocDeclarationNode.BindExpr AS item ->
        value_node = COPY item.value;,
    END
    IF value_node EXISTS AS MUTABLE rtoc_value_node_v THEN
      locatable__set_storage_override_mut(&rtoc_value_node_v, :stack);
    END
    RETURN :stack;
}
END
PRIVATE FN typeAnalysisSession__finalize_decl_storage_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: AllocDeclarationNode, final_type: FinalType) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE storage = &node.finalize_storage_mut(final_type, %(n) USE(MUTABLE rtoc_self_view) -> TRY (typeAnalysisSession__lookup_type_schema(&rtoc_self_view, type__to_sym(n))));
    storage = TRY (typeAnalysisSession__downgrade_frame_to_stack(&rtoc_self_view, &node, storage));
    IF (storage == :frame) THEN
      IF typeAnalysisSession__current_fn_ctx(&rtoc_self_view) != NIL THEN
            MUTABLE rtoc_mutable_receiver_239 = UNWRAP (typeAnalysisSession__current_fn_ctx(&rtoc_self_view));
            functionContext__record_frame_use_mut(&rtoc_mutable_receiver_239);
      END
    END
    IF (storage == :heap) THEN
      IF typeAnalysisSession__current_fn_ctx(&rtoc_self_view) != NIL THEN
            MUTABLE rtoc_mutable_receiver_240 = UNWRAP (typeAnalysisSession__current_fn_ctx(&rtoc_self_view));
            functionContext__record_heap_use_mut(&rtoc_mutable_receiver_240);
      END
      TRY (typeAnalysisSession__record_effect(&rtoc_self_view, symbol("HEAP")));
    END
    RETURN storage;
}
END
PRIVATE FN typeAnalysisSession__resolve_resource_close(MUTABLE self: TypeAnalysisSession, MUTABLE node: Locatable) RETURNS !ResourceCloseResult
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE ti = TRY (aST__full_type_mut(node));
    RETURN type__resolve_resource_close(ti, %(name: String@symbol) USE(MUTABLE rtoc_self_view) -> TRY (typeAnalysisSession__schema_lookup_result(&rtoc_self_view, name)));
}
END
PRIVATE FN typeAnalysisSession__declaration_allocates?(MUTABLE self: TypeAnalysisSession, MUTABLE node: AllocDeclarationNode) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !((node IS_A VarDecl OR node IS_A BindExpr)) THEN
      RETURN FALSE;
    END
    RETURN typeAnalysisSession__expression_allocates?(&rtoc_self_view, UNWRAP (allocDeclarationNode__value(node)));
}
END
PRIVATE FN typeAnalysisSession__expression_allocates?(MUTABLE self: TypeAnalysisSession, MUTABLE node: ?Locatable) RETURNS Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN PARTIAL MATCH UNWRAP (node) START
      Locatable.FuncCall AS func_call -> FALSE,
      AutoInferenceWalkNode.MethodCall -> FALSE,
      Locatable.Identifier AS identifier -> FALSE,
      Locatable.GetField AS get_field -> FALSE,
      Locatable.GetIndex AS get_index -> FALSE,
      Locatable.Literal AS literal -> FALSE,
      Locatable.OrElsePass -> FALSE,
      Locatable.OrElseRaise -> FALSE,
      Locatable.OrElseExit -> FALSE,
      Locatable.ThrowNode AS throw_node -> FALSE,
      Locatable.ReturnNode AS return_node -> FALSE,
      Locatable.BinaryOp AS binary_op -> (IF (binary_op.op == :OR_RESCUE) THEN
          (typeAnalysisSession__expression_allocates?(&rtoc_self_view, binary_op.left) OR typeAnalysisSession__expression_allocates?(&rtoc_self_view, binary_op.right))
        ELSE
          TRUE
        END),
      Locatable.Cast -> typeAnalysisSession__expression_allocates?(&rtoc_self_view, aST__node_value( UNWRAP (node))),
      Locatable.MoveNode AS move_node -> typeAnalysisSession__expression_allocates?(&rtoc_self_view, move_node.value),
      Locatable.CopyNode AS copy_node -> typeAnalysisSession__expression_allocates?(&rtoc_self_view, copy_node.value),
      Locatable.KeepNode AS keep_node -> typeAnalysisSession__expression_allocates?(&rtoc_self_view, keep_node.value),
      Locatable.ShareNode AS share_node -> typeAnalysisSession__expression_allocates?(&rtoc_self_view, share_node.value),
      Locatable.LinkNode AS link_node -> typeAnalysisSession__expression_allocates?(&rtoc_self_view, link_node.value),
      Locatable.ResolveNode AS resolve_node -> typeAnalysisSession__expression_allocates?(&rtoc_self_view, resolve_node.value),
      Locatable.CapabilityWrap AS capability_wrap -> typeAnalysisSession__expression_allocates?(&rtoc_self_view, capability_wrap.value),
      DEFAULT -> TRUE
    END;
}
END
PRIVATE FN typeAnalysisSession__resolve_collection_method(MUTABLE self: TypeAnalysisSession, MUTABLE node: MethodCall) RETURNS !?Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE obj_type = TRY (aST__full_type_mut(node.object));
    MUTABLE implicit_safe_nav = ((type__optional?(obj_type) AND (locatable__safe_nav_chain(UNWRAP (locatable__object(Locatable{ MethodCall: COPY UNWRAP (castLocatableToMethodCall(Locatable{ MethodCall: COPY node }))}))) != NIL)) AND (locatable__safe_nav_chain( Locatable{ MethodCall: COPY node.object }) == TRUE));
    IF implicit_safe_nav THEN
      obj_type = TRY (type__wrapped_type( UNWRAP (obj_type)));
    END
    MUTABLE config: ?CollectionMethodConfig = collectionMethodConfig__for(UNWRAP (TRY (type__dispatch_key( obj_type))));
    IF config EXISTS AS config_value THEN
      MUTABLE handled: ?Bool = TRY (typeAnalysisSession__resolve_typed_method(&rtoc_self_view, &node, obj_type, config_value.registry, config_value.tag, TRY (collectionMethodConfig__label(config_value, obj_type))));
      MUTABLE navigation = ((IF node.object IS_A OptionalUnwrap AS rtoc_nav THEN optionalUnwrap__safe_navigation?(rtoc_nav) ELSE FALSE END) OR implicit_safe_nav);
      IF ((handled != NIL) AND navigation) THEN
        MUTABLE result = TRY (aST__full_type_mut(Locatable{ MethodCall: COPY node }));
        IF !(type__optional?(result)) THEN
          TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, &node, TRY (type__optional_of(TypeTypeInput{ Type: COPY result }))));
          node.safe_nav_chain = TRUE;
        END
      END
      RETURN handled;
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__narrow_collection_type_mut(MUTABLE self: TypeAnalysisSession, matched_def: FunctionSignature, args: []Locatable) RETURNS !?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !((((TRY (functionSignature__intrinsic_contract(matched_def))).behavior).narrows_collection AND (args.length() >= 2))) THEN
      RETURN NIL;
    END
    MUTABLE list_arg: ?Locatable = COPY args[0];
    IF list_arg? IS_A Identifier AS identifier THEN
      MUTABLE identifier_mutable = COPY identifier;
      MUTABLE scope_entry: ?SymbolEntry = identifier_mutable.symbol;
      MUTABLE ti: ?Type@multiowned = NIL;
      IF scope_entry != NIL THEN
        ti = COPY symbolEntry__type(scope_entry);
      END
      IF scope_entry EXISTS AS scope_entry_value THEN
        MUTABLE scope_entry_value_mutable = COPY scope_entry_value;
        IF ((ti != NIL) AND type__promise_list?(ti)) THEN
          RETURN NIL;
        END
        IF !((((ti != NIL) AND (type__collection(ti) != NIL)) AND ((TRY (type__element_type(ti)) != NIL) AND (type__resolved((UNWRAP (TRY (type__element_type(ti))))) == :Any)))) THEN
          RETURN NIL;
        END
        MUTABLE val_arg = COPY UNWRAP (args[1]);
        MUTABLE val_type: ?String@symbol = locatable__resolved_type(val_arg);
        MUTABLE new_type = TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("${UNWRAP (val_type)}[]") }, NIL, NIL, NIL, NIL, type__collection( ti)));
        TRY (type__copy_collection_shape_from_mut(&new_type, CAST(ti AS Type)));
        TRY (type__copy_element_capabilities_from_mut(&new_type, CAST(ti AS Type)));
        type__copy_placement_from_mut(&new_type, CAST(ti AS Type), FALSE);
        TRY (symbolEntry__set_type(&scope_entry_value_mutable, castTypeToOptionalSymbolEntryTypeInput__type_analysis_session(new_type)));
        RETURN TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ Identifier: COPY identifier_mutable }, new_type));
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PUB STRUCT CollectionMethodConfig {
  registry: String@symbol,
  tag: String@symbol,
  label_container: String
}
# Ruby COLLECTION_METHOD_CONFIGS. The label was a lambda over the receiver;
# every arm prints "Container<element-or-value>", so the container name is the
# only thing that varies.
PUB FN collectionMethodConfig__for(dispatch_key: String@symbol) RETURNS ?CollectionMethodConfig ->
  IF (dispatch_key == :pool) THEN
    RETURN CollectionMethodConfig{ registry: :pool_methods, tag: :pool_method, label_container: "Pool" };
  END
  IF (dispatch_key == :set_collection) THEN
    RETURN CollectionMethodConfig{ registry: :set_methods, tag: :set_method, label_container: "Set" };
  END
  IF (dispatch_key == :string_map) THEN
    RETURN CollectionMethodConfig{ registry: :map_methods, tag: :map_method, label_container: "HashMap" };
  END
  IF (dispatch_key == :numeric_map) THEN
    RETURN CollectionMethodConfig{ registry: :map_methods, tag: :map_method, label_container: "HashMap" };
  END
  RETURN NIL;
END
# A receiver whose element/value type has not resolved must still produce a
# message, so an unresolved part reads "Unknown" rather than failing.
PUB FN collectionMethodConfig__label(self: CollectionMethodConfig, obj_type: Type) RETURNS !String ->
  MUTABLE part: ?Type = NIL;
  IF (self.label_container == "HashMap") THEN
    part = TRY (type__value_type(obj_type));
  ELSE
    part = TRY (type__element_type(obj_type));
  END
  IF part EXISTS AS part_value THEN
    RETURN "${self.label_container}<${type__resolved(part_value)}>";
  END
  RETURN "${self.label_container}<Unknown>";
END
PRIVATE FN typeAnalysisSession__resolve_typed_method(MUTABLE self: TypeAnalysisSession, MUTABLE node: MethodCall, obj_type: Type, registry: {RegistryKey}RawRegistryEntry, tag_field: String@symbol, type_label: String) RETURNS !?Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE actual_type: ?Type = NIL;
    MUTABLE defn: ?FunctionSignature@multiowned = functionSignature__unwrap(castOptionalLookupResultToOptionalX__type_analysis_session(TRY (intrinsicRegistry__lookup(registry, RegistryKey{ StringValue: COPY node.name }))));
    IF defn EXISTS AS defn_value THEN
      MUTABLE defn_value_mutable = COPY defn_value;
      MUTABLE arity: ?Int64 = functionSignature__arity(defn_value_mutable);
      IF (((arity != NIL) AND (arity >= 0)) AND (node.args.length() != arity)) THEN
        IF (arity == 0) THEN
          TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ MethodCall: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :STDLIB_METHOD_NO_ARGS }, [], CAST({:label: type_label, :method: node.name, :got: node.args.length()} AS {String@symbol}Any)));
        ELSE
          TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ MethodCall: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :STDLIB_METHOD_ARITY }, [], CAST({:label: type_label, :method: node.name, :expected: arity, :got: node.args.length()} AS {String@symbol}Any)));
        END
        RETURN TRUE;
      END
      MUTABLE arg_validator: ?Any@multiowned = functionSignature__arg_validator(defn_value_mutable);
      IF arg_validator EXISTS AS arg_validator_value THEN
        runtimeCallSpec__call(CAST(arg_validator_value AS RuntimeCallSpec), node, node.args, obj_type, method(CAST(symbol("error!") AS String)));
      END
      MUTABLE element_type: ?Type = TRY (type__element_type(obj_type));
      IF ((((element_type != NIL) AND TRY (type__node_reference?(UNWRAP (element_type)))) AND (["append", "push", "insert"]).contains?(node.name)) AND node.args.any?()) THEN
        MUTABLE value_arg = COPY UNWRAP (node.args.last());
        actual_type = TRY (aST__full_type_mut(value_arg));
        IF (!(TRY (type__node_reference?(actual_type))) AND TRY (type__accepts?(element_type, actual_type))) THEN
          locatable__set_coerced_type_object_mut(&value_arg, element_type);
        END
      END
      IF (tag_field == :pool_method) THEN
        node.pool_method = symbol(node.name);
      ELSE_IF (tag_field == :set_method) THEN
        node.set_method = symbol(node.name);
      ELSE_IF (tag_field == :map_method) THEN
        node.map_method = symbol(node.name);
      ELSE
        panic("resolve_typed_method: unknown collection tag field {}");
      END
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, &node, { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_242 = (TRY (functionSignature__return_def(defn_value_mutable)));
      TRY (functionReturn__resolve(rtoc_local_receiver_242, obj_type, ( { MUTABLE rtoc_empty_list_241: []Locatable = List[]; rtoc_empty_list_241 } ))) }));
      node.container_borrow = TRY (functionSignature__intrinsic_container_borrow?(defn_value_mutable));
      MUTABLE sharded_pattern: ?FunctionSignatureReturnValue = TRY (functionSignature__intrinsic_template(defn_value_mutable, IntrinsicTemplateKind.ShardedZig));
      MUTABLE numeric_pattern: ?FunctionSignatureReturnValue = TRY (functionSignature__intrinsic_template(defn_value_mutable, IntrinsicTemplateKind.NumericZig));
      MUTABLE zig_branch_value: ?FunctionSignatureReturnValue = NIL;
      IF (((type__sharded?(obj_type) OR type__striped?(obj_type))) AND (sharded_pattern != NIL)) THEN
        zig_branch_value = sharded_pattern;
      ELSE_IF (TRY (type__plain_numeric_map?(obj_type)) AND (numeric_pattern != NIL)) THEN
        zig_branch_value = numeric_pattern;
      ELSE
        zig_branch_value = TRY (functionSignature__intrinsic_pattern(defn_value_mutable));
      END
      MUTABLE zig: ?FunctionSignatureReturnValue = zig_branch_value;
      MUTABLE alloc: ?String@symbol =     IF (((type__sharded?(obj_type) OR type__striped?(obj_type))) AND (TRY (functionSignature__intrinsic_alloc(&defn_value_mutable, IntrinsicAllocationKind.ShardedAlloc)) != NIL)) THEN
        TRY (functionSignature__intrinsic_alloc(&defn_value_mutable, IntrinsicAllocationKind.ShardedAlloc))
      ELSE
        TRY (functionSignature__intrinsic_alloc(&defn_value_mutable, IntrinsicAllocationKind.Alloc))
      END;
      IF zig EXISTS AS zig_value THEN
        MUTABLE resolved_defn = TRY (functionSignature__with_intrinsic_override(defn_value_mutable, castFunctionSignatureReturnValueToIntrinsicEmitStrOrSym(zig_value), alloc));
        node.zig_pattern = castFunctionSignatureReturnValueToOptionalStringSymbol(zig_value);
        node.matched_stdlib_def = resolved_defn;
        node.matched_signature = resolved_defn;
      END
      MUTABLE defn_allocates = TRY (functionSignature__emits_allocating?(defn_value_mutable));
      node.stdlib_allocates = defn_allocates;
      node.mutates_receiver = TRY (functionSignature__mutates_receiver?(defn_value_mutable));
      IF (TRY (functionSignature__mutates_receiver?(defn_value_mutable)) OR (TRY (functionSignature__intrinsic_argument_takes_indices(defn_value_mutable))).any?()) THEN
        TRY (typeAnalysisSession__verify_function_signature_mut(&rtoc_self_view, FunctionCallNode{ MethodCall: COPY node }, TRY (typeAnalysisSession__collection_effect_signature(&rtoc_self_view, &node, obj_type, &defn_value_mutable)), ([node.object] + node.args)));
        IF ((zig != NIL) AND TRUE) THEN
          node.matched_signature = resolved_defn;
        END
      END
      TRY (typeAnalysisSession__narrow_receiver_collection_mut(&rtoc_self_view, &node, obj_type, &defn_value_mutable));
      IF defn_allocates THEN
        IF typeAnalysisSession__current_fn_ctx(&rtoc_self_view) != NIL THEN
                MUTABLE rtoc_mutable_receiver_243 = UNWRAP (typeAnalysisSession__current_fn_ctx(&rtoc_self_view));
                functionContext__record_heap_use_mut(&rtoc_mutable_receiver_243);
        END
      END
      node.can_fail = (((IF node.can_fail != NIL THEN node.can_fail ELSE functionSignature__can_fail(defn_value_mutable) END) != NIL) OR defn_allocates);
      node.error_kind = TRY (functionSignature__intrinsic_error_kind(defn_value_mutable));
      node.error_type = TRY (functionSignature__intrinsic_error_type(defn_value_mutable));
      IF ((((element_type != NIL) AND TRY (type__node_reference?(UNWRAP (element_type)))) AND (["append", "push", "insert"]).contains?(node.name)) AND node.args.any?()) THEN
        MUTABLE value_arg = COPY UNWRAP (node.args.last());
        actual_type = TRY (aST__full_type_mut(value_arg));
        IF (!(TRY (type__node_reference?(actual_type))) AND TRY (type__accepts?(element_type, actual_type))) THEN
          locatable__set_coerced_type_object_mut(&value_arg, element_type);
        END
      END
      RETURN TRUE;
    ELSE
      MUTABLE available = registry.keys().join(", ");
      TRY (typeAnalysisSession__emit_typo_suggestion_mut(&rtoc_self_view, TypoToken{ TokenMultiowned: COPY node.token }, node.name, registry.keys() |> SELECT _.toString(), "Unknown method '${node.name}' on ${type_label}. Available: ${available}", "method of ${type_label}", :type, TRUE));
      RETURN TRUE;
    END
}
END
PRIVATE FN typeAnalysisSession__collection_effect_signature(MUTABLE self: TypeAnalysisSession, MUTABLE node: MethodCall, receiver_type: Type, MUTABLE definition: FunctionSignature) RETURNS !FunctionSignature@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE takes = (TRY (functionSignature__intrinsic_argument_takes_indices(definition))) |> DISTINCT _;
    MUTABLE params: []Param = [Param{ name: "receiver", type: COPY receiver_type, required: TRUE, mutable: TRY (functionSignature__mutates_receiver?(definition)), takes: FALSE, default: NIL, comptime: NIL, name_token: NIL, sync: NIL, symbol: NIL, carrier_contract: NIL }];
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < node.args.length() DO
    &params.append(Param{ name: "arg${(rtoc_idx + 1).toString()}", type: COPY TRY (aST__full_type_mut(UNWRAP (node.args[rtoc_idx]))), required: TRUE, mutable: FALSE, takes: takes.contains?(rtoc_idx), default: NIL, comptime: NIL, name_token: NIL, sync: NIL, symbol: NIL, carrier_contract: NIL });
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN TRY (functionSignature__new(params, TypeTypeInput{ Type: COPY TRY (aST__full_type_mut(Locatable{ MethodCall: COPY node })) }, NIL, NIL, ( { MUTABLE rtoc_empty_list_244: []String@symbol = List[]; rtoc_empty_list_244 } ), {}, FALSE, FALSE, NIL, NIL, NIL, ( { MUTABLE rtoc_empty_list_245: []String@symbol = List[]; rtoc_empty_list_245 } ), NIL, ( { MUTABLE rtoc_empty_list_246: []String@symbol = List[]; rtoc_empty_list_246 } )));
}
END
PRIVATE FN typeAnalysisSession__validate_indirect_collection_insertion_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MethodCall) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE signature: ?FunctionSignature@multiowned = NIL;
    MUTABLE receiver_type = TRY (aST__full_type_mut(node.object));
    IF !(TRY (type__linear_collection?(receiver_type))) THEN
      RETURN;
    END
    signature = functionSignature__unwrap(ruby_wrap_optional_FunctionSignature_multiowned_X__type_analysis_session(COPY node.matched_stdlib_def));
    signature = (signature OR_ELSE functionSignature__unwrap(ruby_wrap_optional_FunctionSignature_multiowned_X__type_analysis_session(node__matched_signature(Node{ MethodCall: COPY node }))));
    IF signature EXISTS AS signature_value THEN
      MUTABLE signature_params: []Param = TRY (functionSignature__params(signature_value));
      MUTABLE takes_count = 0;
      FOR signature_param IN signature_params DO
        IF (signature_param.takes OR_ELSE FALSE) THEN
          takes_count = takes_count + 1;
        END
      END
      IF !((takes_count == 1)) THEN
        RETURN;
      END
      MUTABLE signature_param = (signature_param.first() - 1);
      IF signature_param.negative?() THEN
        RETURN;
      END
      MUTABLE signature_param: ?Locatable = COPY node.args[signature_param];
      IF signature_param EXISTS AS value_arg_value THEN
        MUTABLE value_arg_value_mutable = COPY value_arg_value;
        MUTABLE element_type: ?Type = TRY (type__element_type(receiver_type));
        IF !(element_type) THEN
          RETURN;
        END
        MUTABLE actual_type = TRY (aST__full_type_mut(value_arg_value_mutable));
        IF !((type__resolved(UNWRAP (element_type)) == actual_type.resolved())) THEN
          RETURN;
        END
        IF (type__indirect?(UNWRAP (element_type)) AND !(actual_type.indirect?())) THEN
          IF ((TRY (type__any_rc?(actual_type)) OR TRY (type__node_reference?(actual_type))) OR type__link?(actual_type)) THEN
            TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY value_arg_value_mutable }, TypeAnalysisCodeOrMessage{ SymbolValue: :INDIRECT_ELEMENT_IDENTITY }, [], CAST({:type: type__resolved(UNWRAP (element_type)), :actual: TRY (typeAnalysisSession__indirect_identity_display(&rtoc_self_view, actual_type))} AS {String@symbol}Any)));
          ELSE_IF (typeAnalysisSession__language_mode(&rtoc_self_view) != :easy) THEN
            TRY (typeAnalysisSession__emit_indirect_element_explicit_error_mut(&rtoc_self_view, value_arg_value_mutable, UNWRAP (element_type)));
          ELSE
            node.implicit_layout_cost = TRUE;
            value_arg_value_mutable.layout_transport = :box;
          END
        ELSE_IF (!(type__indirect?(UNWRAP (element_type))) AND actual_type.indirect?()) THEN
          value_arg_value_mutable.layout_transport = :unbox;
        ELSE_IF ((type__indirect?(UNWRAP (element_type)) != actual_type.indirect?()) AND (((TRY (type__any_rc?(actual_type)) OR TRY (type__node_reference?(actual_type))) OR type__link?(actual_type)))) THEN
          TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY value_arg_value_mutable }, TypeAnalysisCodeOrMessage{ SymbolValue: :INDIRECT_ELEMENT_IDENTITY }, [], CAST({:type: type__resolved(UNWRAP (element_type)), :actual: TRY (typeAnalysisSession__indirect_identity_display(&rtoc_self_view, actual_type))} AS {String@symbol}Any)));
        END
      ELSE
        RETURN;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__indirect_identity_display(MUTABLE self: TypeAnalysisSession, type: Type) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE parts = [TRY (type__surface_name_type(type))];
    MUTABLE ownership: ?String = type__ownership_surface_name(type);
    IF ownership EXISTS AS ownership_value THEN
      &parts.append(ownership_value);
    END
    IF type__indirect?(type) THEN
      &parts.append("@boxed");
    END
    RETURN parts.join("");
}
END
PRIVATE FN typeAnalysisSession__emit_indirect_element_explicit_error_mut(MUTABLE self: TypeAnalysisSession, value_arg: Locatable, element_type: Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE token: ?Token = locatable__token(value_arg);
    MUTABLE fixes: []Fix = ( { MUTABLE rtoc_empty_list_247: []Fix = List[]; rtoc_empty_list_247 } );
    IF token EXISTS AS token_value THEN
      &fixes.append(TRY (fix__new(TRY (typeAnalysisSession__fix_description(rtoc_self_view, :CONSTRUCT_INDIRECT_LAYOUT)), [edit__new(span__new(NIL, token_value.line, (token_value.column + (CAST(token_value.value AS String)).codepointCount()), 0), " @boxed")], :interactive)));
    END
    TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY value_arg }, :type, fixes, NIL, :INDIRECT_ELEMENT_EXPLICIT, :error, TRUE, CAST({:type: type__resolved(element_type)} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__narrow_receiver_collection_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MethodCall, obj_type: Type, MUTABLE defn: FunctionSignature) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(TRY (functionSignature__intrinsic_receiver_collection_narrowing?(defn))) THEN
      RETURN;
    END
    IF !((node.args.length() == 1)) THEN
      RETURN;
    END
    IF !(((TRY (type__element_type(obj_type)) != NIL) AND (type__resolved((UNWRAP (TRY (type__element_type(obj_type))))) == :Any))) THEN
      RETURN;
    END
    MUTABLE val_type: ?String@symbol = locatable__resolved_type((UNWRAP ((locatable__args( Locatable{ MethodCall: COPY node }) OR_ELSE List[])[0])));
    MUTABLE new_type = TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("${(val_type OR_ELSE "")}[]") }, NIL, NIL, NIL, NIL, type__collection(obj_type)));
    type__copy_placement_from_mut(&new_type, obj_type, FALSE);
    TRY (type__copy_collection_shape_from_mut(&new_type, obj_type));
    TRY (type__copy_element_capabilities_from_mut(&new_type, obj_type));
    IF node.object IS_A Identifier THEN
      MUTABLE entry: ?SymbolEntry@multiowned = locatable__symbol(node.object);
      IF entry EXISTS AS MUTABLE rtoc_entry_v THEN
        TRY (symbolEntry__set_type(&rtoc_entry_v, SymbolEntryTypeInput{ Type: COPY new_type }));
        TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, &node.object, new_type));
      END
    END
}
END
PRIVATE FN typeAnalysisSession__resolve_index_op(MUTABLE self: TypeAnalysisSession, type_info: Type, op: String@symbol) RETURNS !?FunctionSignature@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF type__promise_list?(type_info) THEN
      RETURN NIL;
    END
    IF TRY (type__dispatch_key(type_info)) EXISTS AS rtoc_kind THEN
      RETURN TRY (intrinsicRegistry__lookup_single(:index_ops, "${CAST(rtoc_kind AS String)}_${CAST(op AS String)}"));
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__resolve_variant_access(MUTABLE self: TypeAnalysisSession, MUTABLE node: GetField) RETURNS !?Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(node.target IS_A Identifier) THEN
      RETURN FALSE;
    END
    MUTABLE type_name = symbol(UNWRAP (aST__node_name(node.target)));
    MUTABLE schema: ?SchemaValue = TRY (typeAnalysisSession__lookup_type_schema(&rtoc_self_view, type_name));
    IF !((schemas__union?(schema) OR schemas__enum?(schema))) THEN
      RETURN FALSE;
    END
    IF (schemaValue__kind(UNWRAP (schema)) == :enum) THEN
      IF !(schemaValue__variants(UNWRAP (schema)).contains?(node.field)) THEN
        TRY (typeAnalysisSession__emit_variant_typo_mut(&rtoc_self_view, UNWRAP (typeAnalysisSession__variant_anchor_from_getfield(&rtoc_self_view, node)), node.field, ((schemaValue__variants(UNWRAP (schema)) OR_ELSE Set[]) |> SELECT NameCandidate{ StringValue: COPY _ }), "Type Error: Enum '${type_name}' has no variant '${node.field}'.", "variant of enum ${type_name}", TRUE));
      END
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, &node.target, type_name));
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ GetField: COPY node }, type_name));
      RETURN TRUE;
    END
    IF (schemaValue__kind(UNWRAP (schema)) == :union) THEN
      IF !(schemaValue__variants(UNWRAP (schema)).contains?(node.field)) THEN
        TRY (typeAnalysisSession__emit_variant_typo_mut(&rtoc_self_view, UNWRAP (typeAnalysisSession__variant_anchor_from_getfield(&rtoc_self_view, node)), node.field, ((schemaValue__variants(UNWRAP (schema)) OR_ELSE Set[]) |> SELECT NameCandidate{ StringValue: COPY _ }), "Type Error: Union '${type_name}' has no variant '${node.field}'.", "variant of union ${type_name}", TRUE));
      END
      MUTABLE var_data: ?SchemasUnionSchemaVariantValue = NIL;
      IF schemaValue__union_variants(UNWRAP (schema)) EXISTS AS rtoc_vmap_10827 THEN
        IF rtoc_vmap_10827[node.field] EXISTS AS rtoc_vd_10826 THEN
        var_data = COPY rtoc_vd_10826;
      END
        END
      IF (schemas__inline_struct?(var_data) AND !(typeAnalysisSession__inside_match_pattern_context?(&rtoc_self_view))) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ GetField: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :UNION_INLINE_VARIANT_NEEDS_BRACES }, [], CAST({:union: type_name, :variant: node.field, :union2: type_name, :variant2: node.field} AS {String@symbol}Any)));
      END
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, &node.target, type_name));
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ GetField: COPY node }, type_name));
      RETURN TRUE;
    END
}
END
PRIVATE FN typeAnalysisSession__visit_UnionVariantLit(MUTABLE self: TypeAnalysisSession, MUTABLE node: UnionVariantLit) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE schema: ?SchemaValue = TRY (typeAnalysisSession__lookup_type_schema(&rtoc_self_view, symbol(node.union_name)));
    MUTABLE var_data: ?InlineStructVariant@multiowned = TRY (typeAnalysisSession__validate_union_schema_mut(&rtoc_self_view, &node, schema));
    TRY (typeAnalysisSession__validate_union_fields_mut(&rtoc_self_view, &node, { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_248 = UNWRAP (var_data);
    TRY (inlineStructVariant__typed_fields(rtoc_local_receiver_248)) }));
    RETURN TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ UnionVariantLit: COPY node }, symbol(node.union_name)));
}
END
PRIVATE FN typeAnalysisSession__validate_union_schema_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: UnionVariantLit, schema: ?SchemaValue) RETURNS !?InlineStructVariant@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (schema == NIL) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ UnionVariantLit: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :UNION_TYPE_UNKNOWN }, [], CAST({:name: node.union_name} AS {String@symbol}Any)));
    END
    IF !(((schema != NIL) AND (schema IS_A UnionSchema))) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ UnionVariantLit: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :NOT_A_UNION_TYPE }, [], CAST({:name: node.union_name} AS {String@symbol}Any)));
      RETURN NIL;
    END
    IF !(schemaValue__variants(schema).contains?(node.variant_name)) THEN
      TRY (typeAnalysisSession__emit_variant_typo_mut(&rtoc_self_view, UNWRAP (typeAnalysisSession__variant_anchor_from_unionlit(&rtoc_self_view, Node{ UnionVariantLit: COPY node }, node.variant_name)), node.variant_name, ((schemaValue__variants(schema) OR_ELSE Set[]) |> SELECT NameCandidate{ StringValue: COPY _ }), "Type Error: Union '${node.union_name}' has no variant '${node.variant_name}'.", "variant of union ${node.union_name}", TRUE));
    END
    MUTABLE var_data: ?SchemasUnionSchemaVariantValue = NIL;
    IF schemaValue__union_variants(schema) EXISTS AS rtoc_vmap_10865 THEN
      IF rtoc_vmap_10865[node.variant_name] EXISTS AS rtoc_vd_10861 THEN
      var_data = COPY rtoc_vd_10861;
    END
      END
    IF !((IF var_data EXISTS AS rtoc_vd_probe THEN rtoc_vd_probe IS_A InlineStructVariantMultiowned ELSE FALSE END)) THEN
      IF (var_data == NIL) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ UnionVariantLit: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :UNION_VARIANT_IS_UNIT_NO_FIELDS }, [], CAST({:variant: node.variant_name, :union: node.union_name} AS {String@symbol}Any)));
      ELSE
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ UnionVariantLit: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :UNION_VARIANT_NEEDS_PAYLOAD_OBJECT }, [], CAST({:variant: node.variant_name, :union: node.union_name} AS {String@symbol}Any)));
      END
      RETURN NIL;
    END
    IF var_data EXISTS AS rtoc_vd_ret THEN
      IF rtoc_vd_ret IS_A InlineStructVariantMultiowned AS rtoc_isv THEN
        RETURN KEEP rtoc_isv;
      END
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__validate_union_fields_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: UnionVariantLit, expected_fields: {String}Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN node.fields.keys() DO
    IF !(expected_fields.contains?(_)) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ UnionVariantLit: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :UNION_INLINE_VARIANT_UNKNOWN_FIELD }, [], CAST({:union: node.union_name, :variant: node.variant_name, :field: _} AS {String@symbol}Any)));
    END
    END
    FOR _ IN expected_fields.keys() DO
    IF !(node.fields.contains?(_)) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ UnionVariantLit: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :UNION_INLINE_VARIANT_MISSING_FIELD }, [], CAST({:union: node.union_name, :variant: node.variant_name, :field: _} AS {String@symbol}Any)));
    END
    END
    FOR rtoc_each_key IN node.fields.keys() DO
    MUTABLE val_node = COPY UNWRAP (node.fields[rtoc_each_key]);
    TRY (typeAnalysisSession__visit(&rtoc_self_view, val_node));
    TRY (typeAnalysisSession__reject_borrowed_value_mut(&rtoc_self_view, &val_node, "${node.union_name}.${node.variant_name}.${rtoc_each_key}"));
    MUTABLE owned: ?Locatable = TRY (typeAnalysisSession__ensure_owned_value_mut(&rtoc_self_view, &val_node, castOptionalTypeToOptionalTypeTypeInput(expected_fields[rtoc_each_key]), "${node.union_name}.${node.variant_name}.${rtoc_each_key}"));
    IF owned EXISTS AS owned_value THEN
        MUTABLE owned_value_mutable = COPY owned_value;
        node.fields[rtoc_each_key] = owned_value_mutable;
        MUTABLE val_node = owned_value_mutable;
    END
    MUTABLE ef: ?Type = COPY expected_fields[rtoc_each_key];
    IF ((ef != NIL) AND type__indirect?(ef)) THEN
        locatable__set_needs_heap_create_mut(&val_node, TRUE);        IF typeAnalysisSession__current_fn_ctx(&rtoc_self_view) != NIL THEN
              MUTABLE rtoc_mutable_receiver_249: FunctionContext@multiowned = UNWRAP ((typeAnalysisSession__current_fn_ctx(&rtoc_self_view)));
              functionContext__record_heap_use_mut(&rtoc_mutable_receiver_249);
        END
        TRY (typeAnalysisSession__record_effect(&rtoc_self_view, symbol("HEAP")));
    END
    MUTABLE expected_type: ?Type = COPY expected_fields[rtoc_each_key];
    MUTABLE actual = TRY (aST__full_type_mut(val_node));
    IF !(TRY (type__accepts?(UNWRAP (expected_type), actual))) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ UnionVariantLit: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :UNION_INLINE_VARIANT_TYPE_MISMATCH }, [], CAST({:union: node.union_name, :variant: node.variant_name, :field: rtoc_each_key, :expected: type__resolved(UNWRAP (expected_type)), :got: (IF TRUE THEN
          type__resolved(actual)
        ELSE
          NIL
        END)} AS {String@symbol}Any)));
    END
    TRY (typeAnalysisSession__move_if_not_copyable_mut(&rtoc_self_view, &val_node));
    END
}
END
PRIVATE FN typeAnalysisSession__record_lock_type_rank_mut(MUTABLE self: TypeAnalysisSession, type_sym: String@symbol, rank: Int64, MUTABLE node: CapabilityWrap) RETURNS !?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !((TRUE AND TRUE)) THEN
      RETURN NIL;
    END
    MUTABLE lock_type_ranks = COPY typeAnalysisSession__phase_audit_inputs(&rtoc_self_view).lock_analysis.type_ranks;
    MUTABLE existing: ?Int64 = lock_type_ranks[type_sym];
    IF (existing == NIL) THEN
      lock_type_ranks[type_sym] = COPY rank;
      RETURN rank;
    ELSE
    IF (existing != rank) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ CapabilityWrap: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :LOCK_RANK_INCONSISTENT }, [], CAST({:type: type_sym, :previous: existing, :rank: rank} AS {String@symbol}Any)));
        RETURN NIL;
    END
    END
}
END
PRIVATE FN typeAnalysisSession__rank_of_cap(MUTABLE self: TypeAnalysisSession, cap: CapabilityTransition) RETURNS ?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE t: ?String@symbol = capabilityTransition__lock_identity(cap);
    IF t EXISTS AS t_value THEN
      RETURN COPY typeAnalysisSession__phase_audit_inputs(&rtoc_self_view).lock_analysis.type_ranks[t_value];
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__record_lock_clause_site_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: WithBlock, lock_capabilities: []CapabilityTransition) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(node.lock_error_clause) THEN
      RETURN;
    END
    MUTABLE cap_types = CAST(((lock_capabilities |> SELECT:? capabilityTransition__lock_identity(_) |> WHERE _ != NIL) |> SELECT UNWRAP (_)) AS []String@symbol);
    &rtoc_self_view.audit_inputs.lock_analysis.clause_sites.append(COPY LockClauseSite{ node: COPY node, cap_types: COPY cap_types });
    NIL;
}
END
PRIVATE FN typeAnalysisSession__check_nested_lock_reacquire_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: WithBlock, lock_capabilities: []CapabilityTransition) RETURNS !?[]CapabilityTransition
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE held_locks = TRY (typeAnalysisSession__current_held_locks(&rtoc_self_view));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < lock_capabilities.length() DO
      MUTABLE vn: ?String = COPY lock_capabilities[rtoc_idx]?.var_name;
      IF !(held_locks.contains?(UNWRAP (vn))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE outer_tok: ?Token = COPY (UNWRAP (held_locks[UNWRAP (vn)])).token;
      MUTABLE escape: ?DeadlockEscape = COPY node.deadlock_escape;
      IF (escape AND (escape.kind == :deadlock)) THEN
          MUTABLE rtoc_outer_line: String = COPY "?";
          IF outer_tok EXISTS AS rtoc_ot THEN
            rtoc_outer_line = rtoc_ot.line.toString();
          END
          typeAnalysisSession__note_mut(&rtoc_self_view, UNWRAP (lock_capabilities[rtoc_idx]?.var_node), "POSSIBLE_DEADLOCK accepted: '${(vn OR_ELSE "")}' already held by an enclosing WITH (outer line ${rtoc_outer_line}). Reviewer: verify this cannot actually self-acquire at runtime (distinct instances, sorted acquire, etc.).");
      ELSE
          TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY UNWRAP (lock_capabilities[rtoc_idx]?.var_node) }, TypeAnalysisCodeOrMessage{ SymbolValue: :LOCK_NESTED_REACQUIRE }, [], CAST({:name: vn, :outer_line: (IF outer_tok != NIL THEN
            outer_tok.line
          ELSE
            NIL
          END)} AS {String@symbol}Any)));
      END
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__check_lock_rank_ordering_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: WithBlock, lock_capabilities: []CapabilityTransition) RETURNS !?[]CapabilityTransition
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE held_lock_types = TRY (typeAnalysisSession__current_held_lock_types(&rtoc_self_view));
    IF (held_lock_types.length() == 0) THEN
      RETURN NIL;
    END
    MUTABLE lock_type_ranks = COPY typeAnalysisSession__phase_audit_inputs(&rtoc_self_view).lock_analysis.type_ranks;
    IF (lock_type_ranks.length() == 0) THEN
      RETURN NIL;
    END
    MUTABLE escape: ?DeadlockEscape = COPY node.deadlock_escape;
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < lock_capabilities.length() DO
      MUTABLE cap_rank: ?Int64 = typeAnalysisSession__rank_of_cap(&rtoc_self_view, lock_capabilities[rtoc_idx]?);
      IF !(cap_rank) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE rtoc_idx_n4 = 0;
      WHILE rtoc_idx_n4 < held_lock_types.length() DO
          MUTABLE held_rank: ?Int64 = lock_type_ranks[UNWRAP (held_lock_types[rtoc_idx_n4]?.type)];
          IF !(held_rank) THEN
              rtoc_idx_n4 = rtoc_idx_n4 + 1;
        CONTINUE;
          END
          IF (cap_rank > held_rank) THEN
              rtoc_idx_n4 = rtoc_idx_n4 + 1;
        CONTINUE;
          END
          IF escape THEN
              MUTABLE msg = "Lock rank violation: acquiring ':${(capabilityTransition__lock_identity(lock_capabilities[rtoc_idx_n4]?) OR_ELSE "")}' at rank ${cap_rank} while ':${castTypeToString(held_lock_types[rtoc_idx_n4]?.type)}' (rank ${held_rank}) is held. Ranks must be strictly ascending along the acquire path to prove LockCycle freedom by construction.";
              typeAnalysisSession__note_mut(&rtoc_self_view, lock_capabilities[rtoc_idx_n4]?.var_node, (msg $+ " (POSSIBLE_${(CAST(escape[:kind] AS String)).upcase()} accepted.)"));
          ELSE
              TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY UNWRAP (lock_capabilities[rtoc_idx_n4]?.var_node) }, TypeAnalysisCodeOrMessage{ SymbolValue: :LOCK_RANK_VIOLATION }, [], CAST({:cap: capabilityTransition__lock_identity(lock_capabilities[rtoc_idx_n4]?), :cap_rank: cap_rank, :held: held_lock_types[rtoc_idx_n4]?.type, :held_rank: held_rank} AS {String@symbol}Any)));
          END
        rtoc_idx_n4 = rtoc_idx_n4 + 1;
      END
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__record_with_acquire_mut(MUTABLE self: TypeAnalysisSession, fn_name: String, cap: CapabilityTransition, held_stack: []HeldLockTypeEntry, escape: ?{String@symbol}AnnotatorPhasesTypeAnalysisSessionDeadlockEscapeValue) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE t: ?String@symbol = capabilityTransition__lock_identity(cap);
    IF t EXISTS AS t_value THEN
      MUTABLE state = COPY typeAnalysisSession__phase_audit_inputs(&rtoc_self_view).lock_analysis;
      IF state.direct_acquires[fn_name] EXISTS AS rtoc_map_slot_250 THEN
        &rtoc_map_slot_250.insert(t_value);
      ELSE
        panic("T.must: map slot is NIL");
      END
      MUTABLE site_tok = cap.aST__node__token(node);
      MUTABLE acquirer_opt = !((escape == NIL));
      FOR _ IN held_stack DO
      IF state.direct_edges[fn_name] EXISTS AS rtoc_map_slot_251 THEN
        &rtoc_map_slot_251.append(LockEdge{ held: COPY _.type, acquired: COPY t_value, site_token: site_tok, fn_name: COPY fn_name, opted_out: (acquirer_opt OR _.opted_out) });
      ELSE
        panic("T.must: map slot is NIL");
      END
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__record_held_call_mut(MUTABLE self: TypeAnalysisSession, fn_name: String, callee_name: String, held_stack: []HeldLockTypeEntry, site_token: Token) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE state = COPY typeAnalysisSession__phase_audit_inputs(&rtoc_self_view).lock_analysis;
    FOR _ IN held_stack DO
    IF state.held_calls[fn_name] EXISTS AS rtoc_map_slot_252 THEN
      &rtoc_map_slot_252.append(LockHeldCallSite{ held: COPY _.type, callee: COPY callee_name, site_token: COPY site_token, opted_out: _.opted_out });
    ELSE
      panic("T.must: map slot is NIL");
    END
    END
}
END
PRIVATE FN typeAnalysisSession__visit_TestBlock(MUTABLE self: TypeAnalysisSession, MUTABLE node: TestBlock) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__with_new_scope(&rtoc_self_view, NIL, %() USE(MUTABLE node, MUTABLE rtoc_self_view) -> {
    FOR _ IN node.setup DO
    TRY (typeAnalysisSession__visit(&rtoc_self_view, _));
    END
    TRY (typeAnalysisSession__visit_test_lets(&rtoc_self_view, TestContainerNode{ TestBlock: COPY node }));
    TRY (typeAnalysisSession__visit_test_hook_bodies(&rtoc_self_view, TestContainerNode{ TestBlock: COPY node }));
    FOR MUTABLE rtoc_for_elem_11036 IN node.whens DO
    TRY (typeAnalysisSession__visit_WhenBlock(&rtoc_self_view, &rtoc_for_elem_11036));
    END
    NIL
    });
    RETURN TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ TestBlock: COPY node }, :Void));
}
END
PRIVATE FN typeAnalysisSession__visit_WhenBlock(MUTABLE self: TypeAnalysisSession, MUTABLE node: WhenBlock) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN node.setup DO
    TRY (typeAnalysisSession__visit(&rtoc_self_view, UNWRAP (castBenchmarkEntryToLocatable(_))));
    END
    TRY (typeAnalysisSession__visit_test_lets(&rtoc_self_view, TestContainerNode{ WhenBlock: COPY node }));
    TRY (typeAnalysisSession__visit_test_hook_bodies(&rtoc_self_view, TestContainerNode{ WhenBlock: COPY node }));
    MUTABLE test_body_summaries: {Int64}BodyScanSummary = {};
    FOR MUTABLE rtoc_for_elem_11054 IN node.tests DO
    typeAnalysisSession__with_new_scope(&rtoc_self_view, typeAnalysisSession__current_scope(&rtoc_self_view), %() USE(MUTABLE test_body_summaries, rtoc_for_elem_11054, MUTABLE rtoc_self_view) -> {
    test_body_summaries[aST__node_identity(Locatable{ TestThat: COPY rtoc_for_elem_11054 })] = typeAnalysisSession__with_body_fact_frame(&rtoc_self_view, bodyIdentity__unassigned(), %() USE(rtoc_for_elem_11054, MUTABLE rtoc_self_view) -> {
      MUTABLE rtoc_test_slot = COPY rtoc_for_elem_11054;
      TRY (typeAnalysisSession__visit_TestThat(&rtoc_self_view, &rtoc_test_slot));
      rubyToClearVoid__type_analysis_session()
    });
    NIL
    });
    END
    IF typeAnalysisSession__strict_test?(&rtoc_self_view) THEN
      MUTABLE stubbed_fns: [Set]String = ((node.setup OR_ELSE List[]) |> SELECT:? (    IF _ IS_A StubDecl THEN
        locatable__function_name(_)
      ELSE
        NIL
      END) |> WHERE _ != NIL) |> DISTINCT _;
      FOR _ IN node.tests DO
      TRY (typeAnalysisSession__validate_strict_io_mut(&rtoc_self_view, _, _, UNWRAP (test_body_summaries[aST__node_identity(Locatable{ TestThat: COPY _ })])));
      END
    END
    FOR _ IN node.benchmarks DO
    TRY (typeAnalysisSession__visit(&rtoc_self_view, UNWRAP (castBenchmarkEntryToLocatable(_))));
    END
    RETURN TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ WhenBlock: COPY node }, :Void));
}
END
PRIVATE FN typeAnalysisSession__visit_test_lets(MUTABLE self: TypeAnalysisSession, MUTABLE node: TestContainerNode) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN ((testContainerNode__lets(node) OR_ELSE List[])) DO
    TRY (typeAnalysisSession__visit(&rtoc_self_view, _.expr));
    MUTABLE let_type = TRY (aST__full_type_mut(_.expr));
    MUTABLE rtoc_mutable_receiver_253 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
