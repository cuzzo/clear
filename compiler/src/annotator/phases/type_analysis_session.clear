PUB FN typeAnalysisSession__with_stream_yield_frame<Result>(self: TypeAnalysisSession, node: BgStreamBlock, blk: FN() -> Result) RETURNS ![]Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE frame = StreamYieldFrame{ node: COPY node, expected_type: COPY node.declared_yield_type, yield_types: List[], closed: FALSE };
    &rtoc_self_view.traversal_state.stream_yield_frames.append(COPY frame);
    DEFER {
    MUTABLE popped: ?StreamYieldFrame = &rtoc_self_view.traversal_state.stream_yield_frames.pop();
    IF !(popped.equal?(frame)) THEN
      panic("BUG: stream yield frame mismatch");
    END
    }
