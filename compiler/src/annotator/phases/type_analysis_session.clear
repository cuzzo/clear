PRIVATE FN typeAnalysisSession__reject_duplicate_match_patterns_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MatchStatement, plan: MatchSubjectPlan) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !((matchSubjectPlan__enum?(plan) OR matchSubjectPlan__union?(plan))) THEN
      RETURN;
    END
    MUTABLE seen: {String}Bool = {};
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < node.cases.length() DO
      IF ((matchCase__kind(UNWRAP (node.cases[rtoc_idx])) == :when) OR (matchCase__kind(UNWRAP (node.cases[rtoc_idx])) == :struct_pattern)) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      FOR _ IN TRY (typeAnalysisSession__match_variant_names(&rtoc_self_view, UNWRAP (node.cases[rtoc_idx]))) DO
        IF seen[_] THEN
            TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ MatchStatement: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :MATCH_DUPLICATE_PATTERN }, [], CAST({:variant: _} AS {String@symbol}Any)));
        END
        seen[_] = TRUE;
      END
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PRIVATE FN typeAnalysisSession__check_match_exhaustiveness_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MatchStatement, plan: MatchSubjectPlan) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(node.exhaustive) THEN
      RETURN;
    END
    IF !((matchSubjectPlan__enum?(plan) OR matchSubjectPlan__union?(plan))) THEN
      TRY (typeAnalysisSession__emit_match_partial_fix_mut(&rtoc_self_view, node, :MATCH_NEEDS_ENUM_OR_UNION, {:type: DiagnosticKwValue{ StringValue: CAST(type__resolved(plan.expr_type) AS String) }}));
    END
    IF node.default_case EXISTS AS default_case_value THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ MatchStatement: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :MATCH_FORBIDS_DEFAULT }));
    END
    IF node.cases |> ANY (matchCase__kind(_) == :when) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ MatchStatement: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :MATCH_FORBIDS_WHEN }));
    END
    TRY (typeAnalysisSession__emit_missing_match_variants_mut(&rtoc_self_view, &node, plan));
}
END
PRIVATE FN typeAnalysisSession__emit_missing_match_variants_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MatchStatement, plan: MatchSubjectPlan) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !((matchSubjectPlan__enum?(plan) OR matchSubjectPlan__union?(plan))) THEN
      RETURN;
    END
    MUTABLE covered = (node.cases |> UNNEST TRY (typeAnalysisSession__match_variant_names(&rtoc_self_view, _))) |> DISTINCT _;
    MUTABLE all_variants: [Set]String@symbol = Set[];
    IF matchSubjectPlan__enum?(plan) THEN
      all_variants = typeAnalysisSession__match_enum_schema(&rtoc_self_view, plan).variants |> DISTINCT _;
    ELSE
      all_variants = typeAnalysisSession__match_union_schema(&rtoc_self_view, plan).variants.keys() |> DISTINCT _;
    END
    MUTABLE missing = (all_variants |> WHERE !(covered.contains?(_.toString())));
    IF missing.empty?() THEN
      RETURN;
    END
    MUTABLE type_label: String = "";
    IF matchSubjectPlan__enum?(plan) THEN
      type_label = "enum";
    ELSE
      type_label = "union";
    END
    TRY (typeAnalysisSession__emit_match_partial_fix_mut(&rtoc_self_view, node, :MATCH_NON_EXHAUSTIVE, CAST({:kind: DiagnosticKwValue{ StringValue: COPY type_label }, :name: DiagnosticKwValue{ SymbolValue: COPY plan.type_name }, :missing: DiagnosticKwValue{ StringValue: COPY (missing |> ORDER_BY _).join(", ") }} AS {String@symbol}DiagnosticKwValue)));
}
END
