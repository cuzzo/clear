PRIVATE FN typeAnalysisSession__restamp_auto_local_mut(MUTABLE self: TypeAnalysisSession, slot: Slot) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE decl: AutoConstraintCollectorDeclarationNode = COPY castAutoConstraintCollectorSlotDeclNodeToAutoConstraintCollectorDeclarationNode__type_analysis_session(slot.decl_node);
    MUTABLE concrete = TRY (type__new(TypeConstructionInput{ Type: COPY UNWRAP (autoConstraintCollectorDeclarationNode__type( decl)) }));
    MATCH decl START
      AutoConstraintCollectorDeclarationNode.VarDecl AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.type = concrete;
        decl = AutoConstraintCollectorDeclarationNode{ VarDecl: item_mutable };,
      AutoConstraintCollectorDeclarationNode.BindExpr AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.type = concrete;
        decl = AutoConstraintCollectorDeclarationNode{ BindExpr: item_mutable };,
    END
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, castAutoConstraintCollectorDeclarationNodeToLocatable__type_analysis_session(decl), concrete));
    MUTABLE symbol: ?SymbolEntry = NIL;
    MATCH decl START
      AutoConstraintCollectorDeclarationNode.VarDecl AS item ->
        symbol = COPY item.symbol;,
      AutoConstraintCollectorDeclarationNode.BindExpr AS item ->
        symbol = COPY item.symbol;,
    END
    IF symbol EXISTS AS symbol_value THEN
      MUTABLE symbol_value_mutable = COPY symbol_value;
      TRY (symbolEntry__set_type(&symbol_value_mutable, castTypeToOptionalSymbolEntryTypeInput__type_analysis_session(TRY (type__new(castTypeToTypeConstructionInput__type_analysis_session(concrete))))));
      symbolEntry__set_sync(&symbol_value_mutable, type__sync(concrete));
      symbolEntry__set_layout(&symbol_value_mutable, type__layout(concrete));
    END
    MUTABLE value: Any = NIL;
    MATCH decl START
      AutoConstraintCollectorDeclarationNode.VarDecl AS item ->
        value = COPY item.value;,
      AutoConstraintCollectorDeclarationNode.BindExpr AS item ->
        value = COPY item.value;,
    END
    IF !(value) THEN
      RETURN;
    END
    MUTABLE current_value_type = TRY (typeAnalysisSession__auto_finalization_node_type(&rtoc_self_view, &value));
    IF !((((slot.shape != NIL) OR type__auto?(current_value_type)) OR type__untyped?(current_value_type))) THEN
      RETURN;
    END
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, &value, concrete));
    locatable__set_coerced_type_object_mut(&value, concrete);
}
END
PRIVATE FN typeAnalysisSession__restamp_auto_function_signature_mut(MUTABLE self: TypeAnalysisSession, MUTABLE fn_value: FunctionDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
