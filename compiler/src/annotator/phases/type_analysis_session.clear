FN ruby_array_concat_Any__type_analysis_session(left: []Any, right: []Any) RETURNS []Any ->
  MUTABLE result: []Any = [];
  FOR rtoc_left_item IN left DO
    &result.append(COPY rtoc_left_item);
  END
  FOR rtoc_right_item IN right DO
    &result.append(COPY rtoc_right_item);
  END
  RETURN result;
END
FN ruby_array_concat_Edit__type_analysis_session(left: []Edit, right: []Edit) RETURNS []Edit ->
  MUTABLE result: []Edit = [];
  FOR rtoc_left_item IN left DO
    &result.append(COPY rtoc_left_item);
  END
  FOR rtoc_right_item IN right DO
    &result.append(COPY rtoc_right_item);
  END
  RETURN result;
END
FN ruby_array_concat_SymbolEntry_multiowned(left: []SymbolEntry, right: []SymbolEntry@multiowned) RETURNS []SymbolEntry@multiowned ->
  MUTABLE result: []SymbolEntry@multiowned = [];
  FOR rtoc_left_item IN left DO
    &result.append(COPY rtoc_left_item);
  END
  FOR rtoc_right_item IN right DO
    &result.append(KEEP rtoc_right_item);
  END
  RETURN result;
END
FN ruby_set_intersection<T>(left: [Set]T, right: [Set]T) RETURNS [Set]T ->
  MUTABLE result: [Set]T = Set[];
  left |> EACH {
    IF right.contains?(_) AND !(result.contains?(_)) THEN
      &result.insert(COPY _);
    END
  };
  RETURN result;
END
FN ruby_set_intersection_Any_set(left: [Set]Any, right: [Set]Any) RETURNS [Set]Any ->
  MUTABLE result: [Set]Any = [];
  left |> EACH {
    IF right.contains?(_) AND !(result.contains?(_)) THEN
      &result.insert(COPY _);
    END
  };
  RETURN result;
END
FN ruby_set_intersection_String(left: []String, right: []String) RETURNS []String ->
  MUTABLE result: []String = [];
  left |> EACH {
    IF right.contains?(_) AND !(result.contains?(_)) THEN
      &result.append(COPY _);
    END
  };
  RETURN result;
END
FN ruby_set_union<T>(left: [Set]T, right: [Set]T) RETURNS [Set]T ->
  MUTABLE result: [Set]T = COPY left;
  right |> EACH {
    IF !(result.contains?(_)) THEN
      &result.insert(COPY _);
    END
  };
  RETURN result;
END
