PRIVATE FN typeAnalysisSession__analyze_higher_order_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (node.right IS_A SelectOp) OR (node.right IS_A WhereOp) OR (node.right IS_A IndexOp) OR (node.right IS_A OrderByOp) THEN
      TRY (typeAnalysisSession__analyze_select_family_op(&rtoc_self_view, &node));
    ELSE_IF (node.right IS_A ReduceOp) THEN
      TRY (typeAnalysisSession__analyze_reduce_op(&rtoc_self_view, &node));
    ELSE_IF (node.right IS_A LimitOp) THEN
      TRY (typeAnalysisSession__analyze_limit_op(&rtoc_self_view, &node));
    ELSE_IF (node.right IS_A UnnestOp) THEN
      TRY (typeAnalysisSession__analyze_unnest_op(&rtoc_self_view, &node));
    ELSE_IF (node.right IS_A DistinctOp) THEN
      TRY (typeAnalysisSession__analyze_distinct_op(&rtoc_self_view, &node));
    ELSE_IF (node.right IS_A EachOp) THEN
      TRY (typeAnalysisSession__analyze_each_op(&rtoc_self_view, &node));
    ELSE_IF (node.right IS_A FindOp) THEN
      TRY (typeAnalysisSession__analyze_find_op(&rtoc_self_view, &node));
    ELSE_IF (node.right IS_A AnyOp) THEN
      TRY (typeAnalysisSession__analyze_any_op(&rtoc_self_view, &node));
    ELSE_IF (node.right IS_A AllOp) THEN
      TRY (typeAnalysisSession__analyze_all_op(&rtoc_self_view, &node));
    ELSE_IF (node.right IS_A CountOp) THEN
      TRY (typeAnalysisSession__analyze_count_op(&rtoc_self_view, &node));
    ELSE_IF (node.right IS_A SumOp) THEN
      TRY (typeAnalysisSession__analyze_sum_op(&rtoc_self_view, &node));
    ELSE_IF (node.right IS_A AverageOp) THEN
      TRY (typeAnalysisSession__analyze_average_op(&rtoc_self_view, &node));
    ELSE_IF (node.right IS_A MinOp) THEN
      TRY (typeAnalysisSession__analyze_min_op(&rtoc_self_view, &node));
    ELSE_IF (node.right IS_A MaxOp) THEN
      TRY (typeAnalysisSession__analyze_max_op(&rtoc_self_view, &node));
    ELSE_IF (node.right IS_A ConcurrentOp) THEN
      TRY (typeAnalysisSession__analyze_concurrent_op(&rtoc_self_view, &node));
    ELSE_IF (node.right IS_A ShardOp) THEN
      TRY (typeAnalysisSession__analyze_shard_op(&rtoc_self_view, &node));
    ELSE_IF (node.right IS_A SkipOp) THEN
      TRY (typeAnalysisSession__analyze_skip_op(&rtoc_self_view, &node));
    ELSE_IF (node.right IS_A TapOp) THEN
      TRY (typeAnalysisSession__analyze_tap_op(&rtoc_self_view, &node));
    ELSE_IF (node.right IS_A TakeWhileOp) THEN
      TRY (typeAnalysisSession__analyze_take_while_op(&rtoc_self_view, &node));
    ELSE_IF (node.right IS_A WindowOp) THEN
      TRY (typeAnalysisSession__analyze_window_op(&rtoc_self_view, &node));
    ELSE_IF (node.right IS_A BatchWindowOp) THEN
      TRY (typeAnalysisSession__analyze_batch_window_op(&rtoc_self_view, &node));
    ELSE_IF (node.right IS_A JoinOp) THEN
      TRY (typeAnalysisSession__analyze_join_op(&rtoc_self_view, &node));
    ELSE_IF (node.right IS_A RecoverOp) THEN
      TRY (typeAnalysisSession__analyze_recover_op(&rtoc_self_view, &node));
    ELSE_IF (node.right IS_A CollectOp) THEN
      TRY (typeAnalysisSession__analyze_collect_op(&rtoc_self_view, &node));
    END
    RETURN TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, &node.right, TRY (aST__full_type_mut(Locatable{ BinaryOp: COPY node }))));
}
END
PRIVATE FN typeAnalysisSession__annotate_pipeline_expression_mut(MUTABLE self: TypeAnalysisSession, parent: Locatable, MUTABLE expression: Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, expression));
    IF expression IS_A IfStatement AS if_statement THEN
      MUTABLE if_statement_mutable = COPY if_statement;
      TRY (typeAnalysisSession__promote_to_expr_if_mut(&rtoc_self_view, parent, &if_statement_mutable));
    END
    IF expression IS_A MatchStatement AS match_statement THEN
      MUTABLE match_statement_mutable = COPY match_statement;
      TRY (typeAnalysisSession__promote_to_expr_match_mut(&rtoc_self_view, parent, &match_statement_mutable));
    END
}
END
PRIVATE FN typeAnalysisSession__analyze_collect_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lhs_t = TRY (aST__full_type_mut(node.left));
    IF !((((TRUE) AND type__future?(lhs_t)) AND type__observable?(lhs_t))) THEN
      MUTABLE ty: String = "<unknown>";
      IF TRUE THEN
        ty = type__resolved(lhs_t);
      END
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ BinaryOp: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :COLLECT_NEEDS_OBSERVABLE }, [], CAST({:got: ty} AS {String@symbol}Any)));
    END
    IF node.left IS_A Identifier THEN
      TRY (typeAnalysisSession__og_set_moved(&rtoc_self_view, UNWRAP (aST__node_name(node.left)), locatable__token(node.left), :collect));
    END
    MUTABLE inner: ?Type = (IF TRUE THEN
      TRY (type__tense_type(lhs_t))
    ELSE
      NIL
    END);
    IF (((TRUE) AND type__observable?(lhs_t)) AND ((inner != NIL) AND type__array?(inner))) THEN
      MUTABLE elem_sym = type__to_sym(UNWRAP (TRY (type__element_type(inner))));
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY node }, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("${elem_sym}[]") }))));
      node.storage_override = :heap;
      RETURN :heap;
    ELSE
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY node }, IF inner THEN
        type__resolved(inner)
      ELSE
        :Any
      END));
      node.storage_override = :stack;
      RETURN :stack;
    END
}
END
PRIVATE FN typeAnalysisSession__analyze_select_family_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE is_filter = aST__pipeline_select_filter_op?(node.right);
    MUTABLE lhs_type = TRY (aST__full_type_mut(node.left));
    MUTABLE source = TRY (typeAnalysisSession__pipeline_source_fact(&rtoc_self_view, node.left, lhs_type, is_filter));
    MUTABLE is_stream = (pipelineSourceFact__stream?(source) AND ((is_filter OR node.right IS_A IndexOp)));
    TRY (typeAnalysisSession__require_array_input_mut(&rtoc_self_view, node, "SELECT", is_stream, is_stream));
    MUTABLE item_type = COPY source.item_type;
    MUTABLE selector_effect: ?SelectorEffectFact = NIL;
    typeAnalysisSession__with_new_scope(&rtoc_self_view, NIL, %() USE(item_type, node, MUTABLE selector_effect, source, MUTABLE rtoc_self_view) -> {
    MUTABLE rtoc_mutable_receiver_112 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
    TRY (scope__declare(&rtoc_mutable_receiver_112, "_", NIL, castTypeToOptionalSymbolEntryTypeInput__type_analysis_session(item_type), ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    IF (UNWRAP (aST__node_right( Locatable{ BinaryOp: COPY node })) IS_A SelectOp AND ((pipelineSourceFact__stream?(source) OR (locatable__stream_mode(node.right) OR_ELSE FALSE)))) THEN
        MUTABLE analysis: ?CaptureAnalysis = typeAnalysisSession__with_fiber_capture_analysis(&rtoc_self_view, FALSE, FALSE, %() USE(item_type, node, MUTABLE rtoc_self_view) -> {
      TRY (typeAnalysisSession__with_soa_tracking(&rtoc_self_view, node, item_type, %() USE(node, MUTABLE rtoc_self_view) -> TRY (typeAnalysisSession__annotate_pipeline_expression_mut(&rtoc_self_view, node.right, UNWRAP (locatable__expression(node.right))))));
      rubyToClearVoid__type_analysis_session()
        });
        MUTABLE rtoc_right_slot = COPY node.right;
        locatable__set_capture_analysis_mut(&rtoc_right_slot, (TRY (typeAnalysisSession__validate_capture_analysis_mut(&rtoc_self_view, castLocatableToNode__type_analysis_session(UNWRAP (locatable__right(Locatable{ BinaryOp: COPY node }))), UNWRAP (analysis), FALSE, FALSE)) OR_ELSE analysis));
    ELSE
        TRY (typeAnalysisSession__with_soa_tracking(&rtoc_self_view, node, item_type, %() USE(node, MUTABLE rtoc_self_view) -> TRY (typeAnalysisSession__annotate_pipeline_expression_mut(&rtoc_self_view, node.right, UNWRAP (locatable__expression(node.right))))));
    END
    selector_effect = TRY (typeAnalysisSession__selector_effect_fact(&rtoc_self_view, UNWRAP (locatable__expression(node.right))));
    IF node.right IS_A WhereOp THEN
      TRY (typeAnalysisSession__validate_where_effect_contract_mut(&rtoc_self_view, castLocatableToWhereOp__type_analysis_session(node.right), UNWRAP (selector_effect)));
      RETURN NIL;
    ELSE_IF node.right IS_A SelectOp THEN
      TRY (typeAnalysisSession__validate_select_effect_contract_mut(&rtoc_self_view, castLocatableToSelectOp__type_analysis_session(node.right), UNWRAP (selector_effect)));
      IF (pipelineSourceFact__inf_stream?(source) AND pipelinePlaceholderUsage__moved_placeholder?(UNWRAP (locatable__expression(node.right)))) THEN
        RETURN TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY node.right }, TypeAnalysisCodeOrMessage{ SymbolValue: :INF_STREAM_SELECT_MOVES_ITEM }));
      END
    END
    NIL
    });
    IF (node.right IS_A SelectOp) THEN
      MUTABLE effect = selector_effect?;
      MUTABLE result_type =     IF (pipelineSourceFact__stream?(source) OR (locatable__stream_mode(node.right) OR_ELSE FALSE)) THEN
        TRY (typeAnalysisSession__select_stream_result_type(&rtoc_self_view, lhs_type, source, effect))
      ELSE_IF selectorEffectFact__asynchronous(effect) THEN
        TRY (type__promise_list_of(TypeTypeInput{ Type: COPY TRY (selectorEffectFact__leaf_type(effect)) }))
      ELSE
        TRY (type__array_of(TypeTypeInput{ Type: COPY selectorEffectFact__value_type(effect) }))
      END;
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY node }, result_type));
    ELSE_IF (node.right IS_A WhereOp) THEN
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY node }, IF pipelineSourceFact__inf_stream?(source) THEN
        symbol("~${castTypeToString(item_type)}[INF]")
      ELSE
        symbol("${castTypeToString(item_type)}[]")
      END));
    ELSE_IF (node.right IS_A IndexOp) THEN
      MUTABLE key_type: ?String@symbol = locatable__resolved_type(UNWRAP (locatable__expression(node.right)));
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY node }, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("HashMap<${castTypeToString(item_type)}[]>") }))));
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, &node.right, key_type));
    ELSE_IF (node.right IS_A OrderByOp) THEN
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY node }, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("${castTypeToString(item_type)}[]") }))));
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, &node.right, locatable__resolved_type(UNWRAP (locatable__expression(node.right)))));
    END
    node.storage_override = IF type__promise_list?((TRY (aST__full_type_mut(Locatable{ BinaryOp: COPY node })))) THEN
      :heap
    ELSE
      :frame
    END;
    IF (((node.storage_override == :frame) AND node.right IS_A SelectOp) AND TRY (typeAnalysisSession__select_element_forces_heap_result?(&rtoc_self_view, UNWRAP (locatable__expression(node.right))))) THEN
      node.storage_override = :heap;
    END
    IF !(pipelineSourceFact__inf_stream?(source)) THEN
      IF (node.storage_override == :heap) THEN
        IF typeAnalysisSession__current_fn_ctx(&rtoc_self_view) != NIL THEN
                MUTABLE rtoc_mutable_receiver_113 = UNWRAP (typeAnalysisSession__current_fn_ctx(&rtoc_self_view));
                functionContext__record_heap_use_mut(&rtoc_mutable_receiver_113);
        END
        IF typeAnalysisSession__current_fn_ctx(&rtoc_self_view) != NIL THEN
                MUTABLE rtoc_mutable_receiver_114 = UNWRAP (typeAnalysisSession__current_fn_ctx(&rtoc_self_view));
                functionContext__record_alloc_use_mut(&rtoc_mutable_receiver_114);
        END
      ELSE
        IF typeAnalysisSession__current_fn_ctx(&rtoc_self_view) != NIL THEN
                MUTABLE rtoc_mutable_receiver_115 = UNWRAP (typeAnalysisSession__current_fn_ctx(&rtoc_self_view));
                functionContext__record_frame_use_mut(&rtoc_mutable_receiver_115);
        END
      END
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__select_stream_result_type(MUTABLE self: TypeAnalysisSession, source_type: Type, source: PipelineSourceFact, effect: SelectorEffectFact) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE cardinality =   IF (pipelineSourceFact__stream?(source) AND source_type.shape.expression.kind IS_A StreamTypeExpression) THEN
      (CAST(source_type.shape.expression.kind AS StreamTypeExpression)).cardinality
    ELSE
      TypeExpressionDimension{ SymbolValue: :FINITE }
    END;
    RETURN CAST(TRY (tenseSelectorPlan__stream_result_type(effect.plan, cardinality)) AS Type);
}
END
PRIVATE FN typeAnalysisSession__selector_effect_fact(MUTABLE self: TypeAnalysisSession, MUTABLE expression: Locatable) RETURNS !SelectorEffectFact
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE expression_type = TRY (aST__full_type_mut(expression));
    MUTABLE recoverable: ?Type@multiowned = TRY (typeAnalysisSession__recoverable_result_type(&rtoc_self_view, &expression, "pipeline selector recovery"));
    MUTABLE wrapped = (recoverable OR_ELSE expression_type);
    RETURN SelectorEffectFact{ plan: COPY TRY (tenseOperationPlanner__selector(wrapped)) };
}
END
PRIVATE FN typeAnalysisSession__validate_select_effect_contract_mut(MUTABLE self: TypeAnalysisSession, MUTABLE op: SelectOp, effect: SelectorEffectFact) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    op.tense_plan = TensePlanValue{ TenseSelectorPlan: COPY effect.plan };
    MUTABLE declared_order = COPY CAST(op.modifier_order AS String);
    MUTABLE required_order = selectorEffectFact__required_order(effect);
    IF (declared_order == required_order) THEN
      IF selectorEffectFact__fallible?(effect) THEN
        typeAnalysisSession__retain_select_error_channel_mut(&rtoc_self_view, &op.expression);
      END
      RETURN;
    END
    MUTABLE expected_selector: String = "";
    IF (required_order.length() == 0) THEN
      expected_selector = "SELECT";
    ELSE
      expected_selector = "SELECT:${required_order}";
    END
    IF (declared_order.length() == 0) THEN
      MUTABLE fixes = [TRY (fix__new(TRY (typeAnalysisSession__fix_description(rtoc_self_view, :INSERT_SELECT_EFFECT_ANNOTATION, CAST({:selector: DiagnosticKwValue{ StringValue: COPY expected_selector }} AS {String@symbol}DiagnosticKwValue))), [edit__new(span__new(NIL, op.token.line, (op.token.column + (TRY (token__text_mut(op.token))).codepointCount()), 0), ":${required_order}")], :auto))];
      TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ SelectOp: COPY op } }, :type, fixes, NIL, :SELECT_EFFECT_ANNOTATION_REQUIRED, :error, TRUE, {:got: TRY (type__surface_name_type(CAST(selectorEffectFact__value_type(effect) AS Type))), :selector: expected_selector}));
      RETURN;
    END
    TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ SelectOp: COPY op } }, TypeAnalysisCodeOrMessage{ SymbolValue: :SELECT_EFFECT_ANNOTATION_MISMATCH }, [], {:declared: declared_order, :got: TRY (type__surface_name_type(CAST(selectorEffectFact__value_type(effect) AS Type))), :expected: expected_selector}));
}
END
PRIVATE FN typeAnalysisSession__retain_select_error_channel_mut(MUTABLE self: TypeAnalysisSession, MUTABLE expression: Locatable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (aST__node_retain_error_channel(expression) EXISTS) THEN
      locatable__set_retain_error_channel_mut(&expression, TRUE);    END
}
END
PRIVATE FN typeAnalysisSession__select_effect_suffix(MUTABLE self: TypeAnalysisSession, mode: ?String@symbol) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (mode == :fallible) THEN
      RETURN "!";
    ELSE_IF (mode == :optional) THEN
      RETURN "?";
    ELSE_IF (mode == :fallible_optional) THEN
      RETURN "!?";
    ELSE
      RETURN "";
    END
}
END
PRIVATE FN typeAnalysisSession__validate_where_effect_contract_mut(MUTABLE self: TypeAnalysisSession, op: WhereOp, effect: SelectorEffectFact) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF ((!(selectorEffectFact__asynchronous(effect)) AND (selectorEffectFact__required_mode(effect) == NIL)) AND (type__resolved(selectorEffectFact__value_type(effect)) == :Bool)) THEN
      RETURN;
    END
    TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WhereOp: COPY op } }, TypeAnalysisCodeOrMessage{ SymbolValue: :WHERE_NEEDS_BOOL }, [], {:got: TRY (type__surface_name_type(CAST(selectorEffectFact__value_type(effect) AS Type)))}));
}
END
PRIVATE FN typeAnalysisSession__analyze_take_while_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lhs_type = TRY (aST__full_type_mut(node.left));
    MUTABLE source = TRY (typeAnalysisSession__pipeline_source_fact(&rtoc_self_view, node.left, lhs_type, TRUE));
    MUTABLE is_stream = pipelineSourceFact__stream?(source);
    TRY (typeAnalysisSession__require_array_input_mut(&rtoc_self_view, node, "TAKE_WHILE", is_stream, is_stream));
    MUTABLE item_type = COPY source.item_type;
    typeAnalysisSession__with_new_scope(&rtoc_self_view, NIL, %() USE(item_type, node, MUTABLE rtoc_self_view) -> {
    MUTABLE rtoc_mutable_receiver_116 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
    TRY (scope__declare(&rtoc_mutable_receiver_116, "_", NIL, castTypeToOptionalSymbolEntryTypeInput__type_analysis_session(item_type), ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    TRY (typeAnalysisSession__annotate_pipeline_expression_mut(&rtoc_self_view, node.right, UNWRAP (locatable__expression(node.right))))
    });
    IF !((locatable__resolved_type(UNWRAP (locatable__expression(node.right))) == :Bool)) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY node.right }, TypeAnalysisCodeOrMessage{ SymbolValue: :TAKE_WHILE_NEEDS_BOOL }, [], CAST({:got: locatable__resolved_type(UNWRAP (locatable__expression(node.right)))} AS {String@symbol}Any)));
    END
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY node }, IF pipelineSourceFact__inf_stream?(source) THEN
      symbol("~${castTypeToString(item_type)}[INF]")
    ELSE
      symbol("${castTypeToString(item_type)}[]")
    END));
    node.storage_override = :frame;
    IF !(pipelineSourceFact__inf_stream?(source)) THEN
      IF typeAnalysisSession__current_fn_ctx(&rtoc_self_view) != NIL THEN
            MUTABLE rtoc_mutable_receiver_117: FunctionContext@multiowned = UNWRAP ((typeAnalysisSession__current_fn_ctx(&rtoc_self_view)));
            functionContext__record_frame_use_mut(&rtoc_mutable_receiver_117);
      END
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__analyze_window_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__require_array_input_mut(&rtoc_self_view, node, "WINDOW"));
    MUTABLE item_type = type__resolved(UNWRAP (TRY (type__element_type((TRY (aST__full_type_mut(node.left)))))));
    TRY (typeAnalysisSession__visit(&rtoc_self_view, UNWRAP (locatable__size(node.right))));
    MUTABLE size_type: ?String@symbol = locatable__resolved_type(UNWRAP (locatable__size(node.right)));
    IF !(([:Int64, :Float64]).contains?(size_type)) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY UNWRAP (locatable__size(node.right)) }, TypeAnalysisCodeOrMessage{ SymbolValue: :WINDOW_SIZE_NEEDS_NUMBER }, [], CAST({:got: size_type} AS {String@symbol}Any)));
    END
    typeAnalysisSession__with_new_scope(&rtoc_self_view, NIL, %() USE(item_type, node, MUTABLE rtoc_self_view) -> {
    MUTABLE rtoc_mutable_receiver_118 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
    TRY (scope__declare(&rtoc_mutable_receiver_118, "_", NIL, SymbolEntryTypeInput{ SymbolValue: COPY symbol("${item_type}[]") }, ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    TRY (typeAnalysisSession__annotate_pipeline_expression_mut(&rtoc_self_view, node.right, UNWRAP (locatable__expression(node.right))))
    });
    MUTABLE expr_type = TRY (aST__full_type_mut(UNWRAP (locatable__expression(node.right))));
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY node }, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("${type__resolved(expr_type).toString()}[]") }))));
    node.storage_override = :frame;
    IF typeAnalysisSession__current_fn_ctx(&rtoc_self_view) != NIL THEN
        MUTABLE rtoc_mutable_receiver_119: ?FunctionContext@multiowned = (typeAnalysisSession__current_fn_ctx(&rtoc_self_view));
        MUTABLE rtoc_frame_ctx = UNWRAP (rtoc_mutable_receiver_119);
        functionContext__record_frame_use_mut(&rtoc_frame_ctx);
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__parse_batch_window_time_ns(MUTABLE self: TypeAnalysisSession, str: String) RETURNS !?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE m: ?CompilerRegexScanner = compilerRegexMatchData(str, compilerRegexCompile("\\A(\\d+(?:\\.\\d+)?)(ms|s|min|h)\\z"));
    IF !(m) THEN
      RETURN NIL;
    END
    scanner: CompilerRegexScanner = m;
    amount: Float64 = (compilerRegexCapture(scanner, 1)).toFloat();
    unit: String = COPY compilerRegexCapture(scanner, 2);
    MUTABLE scale: {String}Int64 = {"ms": 1000000, "s": 1000000000, "min": 60000000000, "h": 3600000000000};
    RETURN ((amount * (UNWRAP (scale[unit])).toFloat())).toInt();
}
END
PRIVATE FN typeAnalysisSession__analyze_batch_window_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE opts: ?{String}Locatable = locatable__options(node.right);
    MUTABLE bw = COPY node.right;
    MUTABLE valid_keys = ["size", "time"];
    FOR _ IN opts.keys() DO
    IF !(valid_keys.contains?(_)) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, (IF locatable__token(bw) EXISTS AS rtoc_wrap_5632 THEN DiagnosticAnchor{ TokenValue: COPY rtoc_wrap_5632 } ELSE NIL END), TypeAnalysisCodeOrMessage{ SymbolValue: :WINDOW_BAD_OPTION }, [], CAST({:name: _, :valid: valid_keys.join(", ")} AS {String@symbol}Any)));
    END
    END
    IF !((opts.contains?("size") OR opts.contains?("time"))) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ TokenValue: COPY UNWRAP (locatable__token(bw)) }, TypeAnalysisCodeOrMessage{ SymbolValue: :WINDOW_NEEDS_SIZE_OR_TIME }));
    END
    IF opts["size"] THEN
      TRY (typeAnalysisSession__visit(&rtoc_self_view, opts["size"]));
      MUTABLE size_type: ?String@symbol = locatable__resolved_type(UNWRAP (opts["size"]));
      IF !(([:Int64, :Float64]).contains?(size_type)) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY UNWRAP (opts["size"]) }, TypeAnalysisCodeOrMessage{ SymbolValue: :WINDOW_SIZE_NEEDS_NUMBER }, [], CAST({:got: size_type} AS {String@symbol}Any)));
      END
      IF UNWRAP (opts["size"]) IS_A Literal THEN
        MUTABLE v = tokenValue__to_f(UNWRAP (castLocatableToLiteral(UNWRAP (opts["size"]))));
        IF (_ <= 0) THEN
          TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY UNWRAP (opts["size"]) }, TypeAnalysisCodeOrMessage{ SymbolValue: :WINDOW_SIZE_NEEDS_POSITIVE }));
        END
      END
    END
    IF opts["time"] THEN
      TRY (typeAnalysisSession__visit(&rtoc_self_view, opts["time"]));
      IF !((IF UNWRAP (opts["time"]) IS_A Literal AS rtoc_time_lit THEN (rtoc_time_lit.type == :STRING) ELSE FALSE END)) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY UNWRAP (opts["time"]) }, TypeAnalysisCodeOrMessage{ SymbolValue: :WINDOW_TIME_NEEDS_STRING_LIT }));
      END
      MUTABLE ns: ?Int64 = TRY (typeAnalysisSession__parse_batch_window_time_ns(&rtoc_self_view, opts["time"].value()));
      IF !(_) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, opts["time"], TypeAnalysisCodeOrMessage{ SymbolValue: :WINDOW_TIME_BAD_FORMAT }, [], CAST({:got: opts["time"].value()} AS {String@symbol}Any)));
      END
      IF (_ <= 0) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, opts["time"], TypeAnalysisCodeOrMessage{ SymbolValue: :WINDOW_TIME_NEEDS_POSITIVE }));
      END
    END
    MUTABLE left_ti = TRY (aST__full_type_mut(node.left));
    MUTABLE item_type_branch_value: ?Any@multiowned = NIL;
    IF left_ti EXISTS AS left_ti_value THEN
      IF left_ti_value.inf_stream?() THEN
      item_type_branch_value = type__resolved((TRY (type__inf_stream_element_type(left_ti))));
    ELSE_IF (IF left_ti != NIL THEN
      TRY (type__open_stream?(left_ti))
    ELSE
      NIL
    END) THEN
    END
      item_type_branch_value = type__resolved((TRY (type__open_stream_element_type(left_ti))));
    ELSE_IF (IF left_ti != NIL THEN
      TRY (type__dynamic_stream?(left_ti))
    ELSE
      NIL
    END) THEN
      item_type_branch_value = type__resolved((TRY (type__element_type((TRY (type__tense_type(left_ti)))))));
    ELSE_IF (IF left_ti != NIL THEN
      left_ti.bounded_stream?()
    ELSE
      NIL
    END) THEN
      item_type_branch_value = type__resolved((TRY (type__stream_element_type(left_ti))));
    ELSE_IF (IF left_ti != NIL THEN
      TRY (type__element_type(left_ti))
    ELSE
      NIL
    END) THEN
