PRIVATE FN typeAnalysisSession__infer_generic_type_args_mut(self: TypeAnalysisSession, node: GenericCallNode, signature: FunctionSignature, actual_args: []Locatable, type_params: []String@symbol) RETURNS !{String@symbol}GenericBinding
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE subst: {String@symbol}GenericBinding = {};
    MUTABLE rtoc_each_items_177 = (TRY (functionSignature__params(signature)));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_177.length() DO
      MUTABLE arg: ?Locatable = COPY actual_args[rtoc_idx];
      IF !(arg) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE param_type = COPY rtoc_each_items_177[rtoc_idx]?.type;
      MUTABLE actual_type = &arg.full_type_mut("generic call argument");
      typeAnalysisSession__extract_type_bindings_mut(rtoc_self_view, node, param_type, actual_type, type_params, &subst);
    rtoc_idx = rtoc_idx + 1;
    END
    typeAnalysisSession__enforce_shared_family_call_sync_mut(rtoc_self_view, node, signature, actual_args, type_params);
    FOR _ IN type_params DO
    IF !(subst.contains?(_)) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_FN_CANNOT_INFER }, [], {:param: _, :fn: node.name(), :type: _});
    END
    typeAnalysisSession__validate_bound_types_mut(rtoc_self_view, castGenericCallNodeToAnnotationNode(node), _, TRY (type__new(castGenericBindingToTypeConstructionInput(UNWRAP (subst[_])))), (signature.generic_bounds[_] OR_ELSE List[]));
