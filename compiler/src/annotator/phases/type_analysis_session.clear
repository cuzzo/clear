        RETURN TRUE;
      END
      IF param__atomic?(param) THEN
        RETURN TRUE;
      END
      IF param.symbol EXISTS AS symbol_value THEN
        IF symbolEntry__atomic?(symbol_value) THEN
        RETURN TRUE;
      END
      END
      RETURN (TRY (functionSignature__requires(signature))[param.name]).contains?(:ATOMIC);
    ELSE
      RETURN FALSE;
    END
}
END
