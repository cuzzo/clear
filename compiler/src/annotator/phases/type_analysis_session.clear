        MUTABLE rtoc_mutable_receiver_129 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
        functionContext__record_frame_use_mut(&rtoc_mutable_receiver_129);
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__analyze_recover_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.right.default_expr()));
    MUTABLE lhs_type = &node.left.full_type_mut("pipeline left");
    MUTABLE lhs_t = (typeAnalysisSession__recoverable_result_type(rtoc_self_view, &node.left, "RECOVER input") OR_ELSE TRY (type__new(lhs_type)));
    IF (IF lhs_t != NIL THEN
      lhs_t.error_union?()
    ELSE
      NIL
    END) THEN
      MUTABLE fallback_type = node.right.default_expr().full_type_mut({:context: "RECOVER fallback"});
      MUTABLE plan = TRY (tenseOperationPlanner__or_else(lhs_t, fallback_type, TenseOperationKind.OrElseValue, TenseRecovery.Fallback));
      node.tense_plan = plan;
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, plan.result_type));
    ELSE
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, lhs_type));
    END
    node.storage = :stack;
    RETURN :stack;
}
END
PRIVATE FN typeAnalysisSession__analyze_reduce_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lhs_type = &node.left.full_type_mut("pipeline left");
    MUTABLE source = typeAnalysisSession__pipeline_source_fact(rtoc_self_view, node.left, lhs_type);
    MUTABLE is_stream = pipelineSourceFact__finite_stream?(source);
    typeAnalysisSession__require_array_input_mut(rtoc_self_view, node, "REDUCE", is_stream, is_stream);
    MUTABLE item_type = COPY source.item_type;
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.right.initial_value()));
    MUTABLE acc_type = node.right.initial_value().resolved_type();
    typeAnalysisSession__with_new_scope(rtoc_self_view, %() USE(acc_type, item_type, node, rtoc_self_view) -> {
    MUTABLE rtoc_mutable_receiver_130 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_130, "acc", NIL, acc_type, ScopeMutabilityInput{ BoolValue: TRUE }, FALSE, NIL, :stack));
    MUTABLE rtoc_mutable_receiver_131 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_131, "_", NIL, castTypeToOptionalSymbolEntryTypeInput(item_type), ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    typeAnalysisSession__annotate_pipeline_expression_mut(&rtoc_self_view, node.right, node.right.expression())
    });
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, acc_type));
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node.right, acc_type));
    node.storage = :stack;
    MUTABLE acc_t = TRY (type__new(acc_type));
    IF !(TRY (type__collection_value?(acc_t))) THEN
      IF typeAnalysisSession__observable_reducible_scalar?(rtoc_self_view, acc_type) THEN
        typeAnalysisSession__mark_observable_terminal_mut(rtoc_self_view, node, :reduce, symbol("~${acc_type}"));
      END
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__observable_reducible_scalar?(self: TypeAnalysisSession, acc_type: String@symbol) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN observable_reducible_numeric.contains?(acc_type);
}
