PRIVATE FN typeAnalysisSession__conformance_match_avoiding(self: TypeAnalysisSession, protocol: String, concrete: Type, active: [Set]String) RETURNS !?ConformanceMatch
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE key = "${protocol}:${type__semantic_type_key(concrete)}";
    IF active.contains?(key) THEN
      RETURN NIL;
    END
    MUTABLE next_active = (COPY active).insert(key);
    MUTABLE rtoc_each_items_181 = (TRY (typeAnalysisSession__semantic_conformance_resolutions(rtoc_self_view)));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_181.length() DO
      IF !(((rtoc_each_items_181[rtoc_idx]?.protocol).name == protocol)) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE owner = COPY (rtoc_each_items_181[rtoc_idx]?.declaration).owner_type;
      MUTABLE substitutions: ?{String@symbol}Type@multiowned = typeAnalysisSession__conformance_owner_substitutions(rtoc_self_view, owner, concrete);
      IF !(substitutions) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !(typeAnalysisSession__conformance_binder_bounds_satisfied?(rtoc_self_view, rtoc_each_items_181[rtoc_idx]?, CAST(substitutions AS {String@symbol}Type), next_active)) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      RETURN ConformanceMatch{ resolution: COPY rtoc_each_items_181[rtoc_idx]?, substitutions: CAST(COPY substitutions AS {String@symbol}Type) };
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__conformance_binder_bounds_satisfied?(self: TypeAnalysisSession, resolution: ConformanceResolution, substitutions: {String@symbol}Type, active: [Set]String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN resolution.declaration.binders |> ALL { MUTABLE rtoc_value_block_marker = 0; MUTABLE concrete: ?Type = COPY substitutions[symbol(_.name)]; (IF !(concrete) THEN FALSE ELSE ((_.bounds |> ALL {
    MUTABLE protocol = typeAnalysisSession__protocol_base_name(rtoc_self_view, _.type);
    (  IF (protocol == "Map") THEN
        (type__map?(concrete) OR typeAnalysisSession__generic_parameter_has_map_bound?(rtoc_self_view, type__resolved(concrete)))
      ELSE_IF (typeAnalysisSession__generic_parameter_protocol_names(rtoc_self_view, type__resolved(concrete))).contains?(protocol) THEN
        TRUE
      ELSE
        !(((typeAnalysisSession__conformance_match_avoiding(rtoc_self_view, protocol, UNWRAP (concrete), active)) == NIL))
      END)
    }) AND ((((!(_.bounds |> ANY type__polymorphic_shared?(_.type))) OR type__shared?(concrete))))) END) };
}
END
PRIVATE FN typeAnalysisSession__conformance_owner_substitutions(self: TypeAnalysisSession, pattern: Type, concrete: Type) RETURNS !?{String@symbol}Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF type__generic_instance?(pattern) THEN
      IF !((type__generic_instance?(concrete) AND (type__generic_base(pattern) == type__generic_base(concrete)))) THEN
        RETURN NIL;
      END
      IF !(((TRY (type__generic_args(pattern))).length() == (TRY (type__generic_args(concrete))).length())) THEN
        RETURN NIL;
      END
      MUTABLE substitutions: {String@symbol}Type = {};
      FOR rtoc_key IN (TRY (type__generic_args(pattern))).zip(TRY (type__generic_args(concrete))).keys() DO
    MUTABLE argument: Any = ((TRY (type__generic_args(pattern))).zip(TRY (type__generic_args(concrete)))[rtoc_key] OR_ELSE panic("missing hash key"));
    IF !((rtoc_key AND argument)) THEN
          RETURN NIL;
    END
    substitutions[rtoc_key.resolved()] = TRY (type__new(argument));
      END
      RETURN substitutions;
    END
    IF (type__semantic_type_key((TRY (type__bare_data_type(pattern)))) == type__semantic_type_key((TRY (type__bare_data_type(concrete))))) THEN
      RETURN {};
    END
    RETURN NIL;
}
END
