      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, :Void));
      RETURN;
    END
    MUTABLE item_type = COPY iterable.item_type;
    typeAnalysisSession__with_new_scope(rtoc_self_view, %() USE(item_type, node, MUTABLE rtoc_self_view) -> {
    MUTABLE rtoc_mutable_receiver_139 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_139, "_", NIL, castTypeToOptionalSymbolEntryTypeInput(item_type), ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    FOR _ IN node.right.body() DO
    TRY (typeAnalysisSession__visit(&rtoc_self_view, _));
    END
    NIL
    });
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, lhs_type));
    node.storage = node.left.storage();
    RETURN node.left.storage();
