  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node, :Void));
}
END
PRIVATE FN typeAnalysisSession__visit_OrElsePrune(self: TypeAnalysisSession, MUTABLE node: OrElsePrune) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node, :Void));
}
END
PRIVATE FN typeAnalysisSession__visit_OrElseExit(MUTABLE self: TypeAnalysisSession, MUTABLE node: OrElseExit) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node.message THEN
      TRY (typeAnalysisSession__visit(&rtoc_self_view, node.message));
    END
    typeAnalysisSession__resolve_error_registration_mut(rtoc_self_view, Node{ OrElseExit: COPY node }, node.kind, node.error_name, node.token);
    IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
        MUTABLE rtoc_mutable_receiver_443 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
        functionContext__mark_runtime_used_mut(&rtoc_mutable_receiver_443);
    END
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node, :Void));
}
END
PRIVATE FN typeAnalysisSession__recoverable_result_type(self: TypeAnalysisSession, MUTABLE node: Locatable, context: String) RETURNS !?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE stored =   IF (respondsTo?(node, "error_union_type") AND node.error_union_type()) THEN
      node.error_union_type()
    ELSE
      NIL
    END;
    IF stored THEN
      IF stored IS_A Type THEN
        RETURN stored;
      ELSE
        RETURN TRY (type__new(stored));
      END
    END
    MUTABLE resolved = TRY (type__new(&node.full_type_mut(context)));
    IF type__error_union?(resolved) THEN
      RETURN resolved;
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__fault_recoverable_result?(self: TypeAnalysisSession, MUTABLE node: Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE result = TRY (type__new(&node.full_type_mut("recoverable FAULT result")));
    IF (type__future?(result) OR TRY (type__stream?(result))) THEN
      RETURN FALSE;
    END
    IF (TRUE AND (aST__node__can_fail(node) == TRUE)) THEN
      RETURN TRUE;
    END
    IF !((node IS_A FuncCall OR node IS_A MethodCall)) THEN
      RETURN FALSE;
    END
    MUTABLE callee: ?FunctionDef@multiowned = COPY (TRY (typeAnalysisSession__function_node_map(rtoc_self_view)))[node.name()];
    RETURN !(!((((callee != NIL) AND (((((callee.alloc_fault == TRUE) OR (callee.uses_frame == TRUE)) OR (callee.uses_heap == TRUE)) OR (callee.uses_alloc == TRUE)))))));
}
END
PRIVATE FN typeAnalysisSession__infer_implicit_type_params(self: TypeAnalysisSession, fn_node: FunctionDef) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE explicit = fn_node.type_params |> SELECT _.toString();
    IF !(explicit.empty?()) THEN
      RETURN explicit;
    END
    MUTABLE inferred = List[];
    FOR _ IN (([fn_node.return_type] + (fn_node.params |> SELECT _.type))) DO
    typeAnalysisSession__collect_implicit_type_params(rtoc_self_view, _, &inferred, explicit);
    END
    RETURN CAST((((explicit + inferred)) |> DISTINCT _) AS []String);
}
END
PRIVATE FN typeAnalysisSession__collect_implicit_type_params(self: TypeAnalysisSession, type: ?Type, MUTABLE out: []String, explicit: []String) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((type != NIL)) THEN
      RETURN;
    END
    MUTABLE name = COPY CAST(type__resolved(type) AS String);
    IF ((compilerRegexMatch(name, compilerRegexCompile("\\A[A-Z]\\z")) AND !(explicit.contains?(name))) AND !(typeAnalysisSession__lookup_type_schema(rtoc_self_view, symbol(name)))) THEN
      &out.append(name);
    END
    IF type__generic_instance?(type) THEN
      FOR _ IN (TRY (type__generic_args(type))) DO
      typeAnalysisSession__collect_implicit_type_params(rtoc_self_view, _, &out, explicit);
      END
    END
    IF (TRUE AND type__error_union?(type)) THEN
      typeAnalysisSession__collect_implicit_type_params(rtoc_self_view, TRY (type__payload_type(type)), &out, explicit);
    END
    IF (TRUE AND type__optional?(type)) THEN
      typeAnalysisSession__collect_implicit_type_params(rtoc_self_view, TRY (type__wrapped_type(type)), &out, explicit);
    END
    IF (TRUE AND type__array?(type)) THEN
      typeAnalysisSession__collect_implicit_type_params(rtoc_self_view, TRY (type__element_type(type)), &out, explicit);
    END
}
END
PRIVATE FN typeAnalysisSession__visit_Cast(MUTABLE self: TypeAnalysisSession, MUTABLE node: Cast) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE target_type = TRY (type__new(node.target));
    IF (node.value IS_A ListLit AND type__tuple?(target_type)) THEN
      node.value.coerced_type = target_type;
    ELSE_IF (node.value IS_A HashLit AND type__map?(target_type)) THEN
      node.value.coerced_type = target_type;
    END
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.value));
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node, target_type));
}
END
PRIVATE FN typeAnalysisSession__visit_CallSiteOverride(self: TypeAnalysisSession, node: CallSiteOverride) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE sigil: String = "";
    IF (node.kind == :thunk) THEN
      sigil = "@thunk";
    ELSE
      sigil = "@maxDepth";
    END
    MUTABLE variant_hint: String = "";
    IF (node.kind == :thunk) THEN
      variant_hint = "'EFFECTS REENTRANT:THUNK'";
    ELSE
      variant_hint = "'EFFECTS REENTRANT:MAX_DEPTH(${node.n})'";
    END
    typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :CALL_SITE_OVERRIDE_UNIMPLEMENTED }, [], {:sigil: sigil, :n: node.n, :variant_hint: variant_hint});
}
END
PRIVATE FN typeAnalysisSession__visit_UnaryOp(MUTABLE self: TypeAnalysisSession, MUTABLE node: UnaryOp) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (node.op == :IS_OK) THEN
      typeAnalysisSession__with_body_fact_failure_absorbed(rtoc_self_view, TRUE, %() USE(node, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_444 = TRY (typeAnalysisSession__visit(&rtoc_self_view, node.right));
    rtoc_lambda_result_444
      });
    ELSE
      TRY (typeAnalysisSession__visit(&rtoc_self_view, node.right));
    END
    IF (node.op == :NOT) OR (node.op == "!") THEN
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node, :Bool));
    ELSE_IF (node.op == :EXISTS) THEN
      MUTABLE operand_type = &node.right.full_type_mut("EXISTS operand");
      IF !((type__optional?((TRY (type__new(TypeConstructionInput{ Type: COPY UNWRAP (operand_type) })))) OR TRY (type__stream_step?((TRY (type__new(TypeConstructionInput{ Type: COPY UNWRAP (operand_type) }))))))) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :EXISTS_REQUIRES_OPTIONAL }, [], {:got: operand_type});
      END
      IF !(TRY (type__stream_step?((TRY (type__new(TypeConstructionInput{ Type: COPY UNWRAP (operand_type) })))))) THEN
        node.tense_plan = TRY (tenseOperationPlanner__exists(TRY (type__new(TypeConstructionInput{ Type: COPY UNWRAP (operand_type) }))));
      END
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node, :Bool));
    ELSE_IF (node.op == :IS_OK) THEN
      MUTABLE operand_type: ?Type@multiowned = typeAnalysisSession__recoverable_result_type(rtoc_self_view, &node.right, "IS_OK operand");
      IF !(operand_type) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :IS_OK_REQUIRES_FALLIBLE }, [], {:got: &node.right.full_type_mut("IS_OK operand")});
      END
      node.tense_plan = TRY (tenseOperationPlanner__is_ok(CAST(operand_type? AS Type)));
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node, :Bool));
    ELSE_IF (node.op == :IS_READY) THEN
      MUTABLE operand_type = &node.right.full_type_mut("IS_READY operand");
      MUTABLE ti = TRY (type__new(TypeConstructionInput{ Type: COPY UNWRAP (operand_type) }));
      IF !((TRY (type__single_future?(ti)) OR type__shared_promise?(ti))) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :IS_READY_REQUIRES_FUTURE }, [], {:got: operand_type});
      END
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node, :Bool));
    ELSE_IF (node.op == :TRY) THEN
      MUTABLE declared: ?Type@multiowned = typeAnalysisSession__recoverable_result_type(rtoc_self_view, &node.right, "TRY operand");
      MUTABLE raw_type = TRY (type__new(&node.right.full_type_mut("TRY operand")));
      MUTABLE plan_input = (declared OR_ELSE raw_type);
      MUTABLE plan: ?TenseOperationPlan = typeAnalysisSession__try_value_plan_with_diagnostic(rtoc_self_view, node, plan_input, raw_type);
      MUTABLE plan_value: TenseOperationPlan = plan?;
      node.tense_plan = plan_value;
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node, plan_value.result_type));
      node.storage = node.right.storage();
    ELSE
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node, &node.right.full_type_mut("unary right")));
    END
    RETURN CAST(&node.full_type_mut("unary expression") AS Type);
}
END
PRIVATE FN typeAnalysisSession__try_value_plan_with_diagnostic(self: TypeAnalysisSession, node: UnaryOp, plan_input: Type, raw_type: Type) RETURNS !?TenseOperationPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (tenseOperationPlanner__try_value(plan_input));
}
CATCH ArgumentError
  typeAnalysisSession__error_mut(self, node, TypeAnalysisCodeOrMessage{ SymbolValue: :UNWRAP_NON_OPTIONAL }, [], {:got: raw_type});
  RETURN NIL;
END
PRIVATE FN typeAnalysisSession__visit_Literal(self: TypeAnalysisSession, MUTABLE node: Literal) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE literal_type_branch_value: ?Type = NIL;
    PARTIAL MATCH node.type START
      :NUMBER ->
      literal_type_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: :Float64 }));,
      :INT64 ->
      literal_type_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: :Int64 }));,
      :STRING ->
      IF (node.storage == :stack) THEN
        node.storage = :rodata;
        literal_type_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("Byte[${node.value.length()}]") }, NIL, NIL, NIL, :rodata));
      ELSE
        node.storage = :rodata;
        literal_type_branch_value = TRY (type__new(string_type, NIL, NIL, NIL, :rodata));
      END,
      :SYMBOL ->
      node.storage = :rodata;
      literal_type_branch_value = TRY (type__new(string_type, NIL, :symbol, NIL, :rodata));,
      :BYTE ->
      literal_type_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: :Byte }));,
      :PREFIXED_INT ->
      literal_type_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: :Byte }));,
      :INT8 ->
      literal_type_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: :Int8 }));,
      :INT16 ->
      literal_type_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: :Int16 }));,
      :INT32 ->
      literal_type_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: :Int32 }));,
      :UINT16 ->
      literal_type_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: :UInt16 }));,
      :UINT32 ->
      literal_type_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: :UInt32 }));,
      :UINT64 ->
      literal_type_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: :UInt64 }));,
      :FLOAT32 ->
      literal_type_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: :Float32 }));,
      :BOOLEAN ->
      literal_type_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: :Bool }));,
      symbol("NIL") ->
      literal_type_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: symbol("NIL") }));,
      DEFAULT ->
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :UNKNOWN_LITERAL });
      literal_type_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }));
    END
    MUTABLE literal_type: Type = literal_type_branch_value?;
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ Literal: COPY node }, literal_type));
}
END
PRIVATE FN typeAnalysisSession__visit_DefaultLit(self: TypeAnalysisSession, MUTABLE node: DefaultLit) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ DefaultLit: COPY node }, :Any));
}
END
PRIVATE FN typeAnalysisSession__visit_BinaryOp(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?TypeAnalysisSessionReturnValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (node.op == :SMOOTH) THEN
      RETURN ruby_wrap_optional_Int64_TypeAnalysisSessionReturnValue(typeAnalysisSession__visit_Smooth(&rtoc_self_view, node));
    ELSE_IF (node.op == :BIND_VAR) THEN
      RETURN TypeAnalysisSessionReturnValue{ Type: COPY typeAnalysisSession__visit_BindVar(&rtoc_self_view, node) };
    ELSE_IF (node.op == symbol("OR_ELSE")) THEN
      RETURN TypeAnalysisSessionReturnValue{ Type: COPY typeAnalysisSession__visit_OrElse(&rtoc_self_view, &node) };
    END
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.left));
    IF ((node.op == symbol("AND")) OR (node.op == symbol("OR"))) THEN
      MUTABLE refinements = typeAnalysisSession__short_circuit_non_nil_refinements(rtoc_self_view, node.left, (node.op == symbol("AND")));
      typeAnalysisSession__with_value_type_refinements(&rtoc_self_view, refinements, %() USE(node, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_445 = TRY (typeAnalysisSession__visit(&rtoc_self_view, node.right));
    rtoc_lambda_result_445
      });
    ELSE
      TRY (typeAnalysisSession__visit(&rtoc_self_view, node.right));
    END
    IF node.left IS_A IfStatement THEN
      typeAnalysisSession__promote_to_expr_if_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, castLocatableToIfStatement(node.left));
    END
    IF node.left IS_A MatchStatement THEN
      typeAnalysisSession__promote_to_expr_match_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, castLocatableToMatchStatement(node.left));
    END
    IF node.right IS_A IfStatement THEN
      typeAnalysisSession__promote_to_expr_if_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, castLocatableToIfStatement(node.right));
    END
    IF node.right IS_A MatchStatement THEN
      typeAnalysisSession__promote_to_expr_match_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, castLocatableToMatchStatement(node.right));
    END
    MUTABLE left_type = &node.left.full_type_mut("binary left");
    MUTABLE right_type = &node.right.full_type_mut("binary right");
    typeAnalysisSession__reject_direct_observable_operand_mut(rtoc_self_view, node, node.left, left_type);
    typeAnalysisSession__reject_direct_observable_operand_mut(rtoc_self_view, node, node.right, right_type);
    IF ((node.op == :ADD) AND ((TRY (type__string?(left_type)) OR TRY (type__string?(right_type))))) THEN
      MUTABLE token = COPY node.token;
      typeAnalysisSession__fixable_mut(rtoc_self_view, node, :syntax, [TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :REPLACE_STRING_CONCAT_OPERATOR), [edit__new(span__new(NIL, token.line, token.column, 1), "$+")], :auto))], NIL, :STRING_CONCAT_REQUIRES_DOLLAR, :error);
    END
    IF ((node.op == symbol("AND")) OR (node.op == symbol("OR"))) THEN
      typeAnalysisSession__validate_logical_presence_operand_mut(rtoc_self_view, node.left, left_type, node.op);
      typeAnalysisSession__validate_logical_presence_operand_mut(rtoc_self_view, node.right, right_type, node.op);
    END
    MUTABLE logical_presence = ((((node.op == symbol("AND")) OR (node.op == symbol("OR")))) AND ((type__optional?((TRY (type__new(left_type)))) OR type__optional?((TRY (type__new(right_type)))))));
    MUTABLE result_branch_value: ?BinaryOpResult = NIL;
    IF logical_presence THEN
      result_branch_value = BinaryOpResult{ type: COPY TRY (type__new(TypeConstructionInput{ SymbolValue: :Bool })), left_coercion: NIL, right_coercion: NIL, storage: NIL, error: NIL };
    ELSE
      result_branch_value = TRY (type__binary_op(node.op, left_type, right_type));
    END
    MUTABLE result: BinaryOpResult = result_branch_value?;
    IF result.error EXISTS AS error_value THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :TYPE_ERROR_GENERIC }, [], {:detail: error_value});
    END
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, result.type));
    IF result.left_coercion EXISTS AS left_coercion_value THEN
      node.left.coerced_type = COPY left_coercion_value;
    END
    IF result.right_coercion EXISTS AS right_coercion_value THEN
      node.right.coerced_type = COPY right_coercion_value;
    END
    IF result.storage EXISTS AS storage_value THEN
      node.storage = COPY storage_value;
    END
    IF ((node.op == :CONCAT) OR (((node.op == :ADD) AND ((TRY (type__string?(left_type)) OR TRY (type__string?(right_type))))))) THEN
      node.string_concat = TRUE;
      IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
            MUTABLE rtoc_mutable_receiver_446 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
            functionContext__record_frame_use_mut(&rtoc_mutable_receiver_446);
      END
      node.storage = :frame;
      MUTABLE ti = &node.full_type_mut("binary result");
      type__mark_frame_allocated_mut(&ti);
    END
    RETURN COPY castTypeToOptionalTypeAnalysisSessionReturnValue(result.type);
}
END
PRIVATE FN typeAnalysisSession__short_circuit_non_nil_refinements(self: TypeAnalysisSession, node: Locatable, MUTABLE truthy: Bool) RETURNS !{Int64}Type
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A UnaryOp THEN
      IF (node.op() == :NOT) THEN
        RETURN typeAnalysisSession__short_circuit_non_nil_refinements(rtoc_self_view, node.right(), !(truthy));
      END
      IF ((node.op() == :EXISTS) AND truthy) THEN
        RETURN typeAnalysisSession__identifier_non_nil_refinement(rtoc_self_view, node.right());
      END
      RETURN {};
    END
    IF node IS_A BinaryOp AS binary_op THEN
      IF ((((binary_op.op == symbol("AND")) AND truthy)) OR (((binary_op.op == symbol("OR")) AND !(truthy)))) THEN
        RETURN typeAnalysisSession__short_circuit_non_nil_refinements(rtoc_self_view, binary_op.right, &truthy).keys() |> REDUCE(COPY typeAnalysisSession__short_circuit_non_nil_refinements(rtoc_self_view, binary_op.left, &truthy)) { acc[_] = COPY (typeAnalysisSession__short_circuit_non_nil_refinements(rtoc_self_view, binary_op.right, &truthy)[_] OR_ELSE CAST(panic("missing hash key") AS Type@multiowned)); acc };
      END
      IF !(((binary_op.op == :EQ) OR (binary_op.op == :NEQ))) THEN
        RETURN {};
      END
      MUTABLE identifier: ?Identifier = typeAnalysisSession__nil_comparison_identifier(rtoc_self_view, binary_op);
      MUTABLE proves_non_nil = ((((binary_op.op == :EQ) AND !(truthy))) OR (((binary_op.op == :NEQ) AND truthy)));
      IF ((identifier != NIL) AND proves_non_nil) THEN
        RETURN typeAnalysisSession__identifier_non_nil_refinement(rtoc_self_view, Locatable{ Identifier: COPY identifier });
      ELSE
        RETURN {};
      END
    ELSE
      RETURN {};
    END
}
END
PRIVATE FN typeAnalysisSession__nil_comparison_identifier(self: TypeAnalysisSession, node: BinaryOp) RETURNS ?Identifier
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (node.left IS_A Identifier AND typeAnalysisSession__nil_literal?(rtoc_self_view, node.right)) THEN
      RETURN COPY castLocatableToOptionalIdentifier(node.left);
    END
    IF (node.right IS_A Identifier AND typeAnalysisSession__nil_literal?(rtoc_self_view, node.left)) THEN
      RETURN COPY castLocatableToOptionalIdentifier(node.right);
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__nil_literal?(self: TypeAnalysisSession, node: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (IF node IS_A Literal AS literal THEN ruby_union_scalar_equal_Type_String_symbol(literal.type, symbol("NIL")) ELSE FALSE END);
}
END
PRIVATE FN typeAnalysisSession__identifier_non_nil_refinement(self: TypeAnalysisSession, node: Locatable) RETURNS !{Int64}Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A Identifier AS identifier THEN
      MUTABLE scope: ?Scope@multiowned = typeAnalysisSession__resolve_variable_scope(rtoc_self_view, identifier__name(identifier));
      MUTABLE entry: ?SymbolEntry@multiowned = NIL;
      IF scope != NIL THEN
        entry = COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_447 = (scope?);
      scope__resolve_entry(rtoc_local_receiver_447, identifier__name(identifier)) };
      END
      IF scope EXISTS AS scope_value THEN
        IF entry THEN
          MUTABLE full_type = TRY (scope__resolve_full_type(scope_value, identifier__name(identifier)));
          IF !(type__optional?(full_type)) THEN
            RETURN {};
          END
          RETURN CAST({entry.binding_id: UNWRAP (TRY (type__wrapped_type(full_type)))} AS {Int64}Type);
        ELSE
          RETURN {};
        END
      ELSE
        RETURN {};
      END
    ELSE
      RETURN {};
    END
}
END
PRIVATE FN typeAnalysisSession__reject_direct_observable_operand_mut(self: TypeAnalysisSession, site: BinaryOp, operand: Locatable, operand_type: Type) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((type__future?(operand_type) AND type__observable?(operand_type))) THEN
      RETURN;
    END
    MUTABLE root: ?Identifier = aST__root_identifier(operand);
    IF !((root != NIL)) THEN
      RETURN;
    END
    typeAnalysisSession__emit_direct_view_access_finding_mut(rtoc_self_view, Locatable{ BinaryOp: COPY site }, root.name, "VIEW");
}
END
PRIVATE FN typeAnalysisSession__validate_logical_presence_operand_mut(self: TypeAnalysisSession, operand: Locatable, operand_type: Type, op: String@symbol) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE ti = TRY (type__new(castTypeToTypeConstructionInput(operand_type)));
    IF !(type__optional?(ti)) THEN
      RETURN;
    END
    IF !((type__resolved(UNWRAP (TRY (type__wrapped_type(ti)))) == :Bool)) THEN
      RETURN;
    END
    MUTABLE fixes: []Fix = ( { MUTABLE rtoc_empty_list_448: []Fix = List[]; rtoc_empty_list_448 } );
    IF operand IS_A Identifier AS identifier THEN
      MUTABLE token = identifier.token;
      MUTABLE span = span__new(NIL, token.line, token.column, identifier__name(identifier).codepointCount());
      &fixes.append(TRY (fix__new(TRY (diagnosticRegistry__fix_description(:TEST_OPTIONAL_BOOL_PRESENCE, {:name: DiagnosticKwValue{ StringValue: COPY identifier__name(identifier) }})), [edit__new(span, "${identifier__name(identifier)} EXISTS")], :interactive)));
      &fixes.append(TRY (fix__new(TRY (diagnosticRegistry__fix_description(:DEFAULT_OPTIONAL_BOOL_PAYLOAD, {:name: DiagnosticKwValue{ StringValue: COPY identifier__name(identifier) }})), [edit__new(span, "(${identifier__name(identifier)} OR_ELSE FALSE)")], :interactive)));
    END
    typeAnalysisSession__fixable_mut(rtoc_self_view, operand, :type, fixes, NIL, :AMBIGUOUS_OPTIONAL_BOOL_LOGIC, :error, FALSE, {:op: op});
}
END
PRIVATE FN typeAnalysisSession__visit_Placeholder(self: TypeAnalysisSession, node: Placeholder) RETURNS ?SymbolEntry@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE result: ?SymbolEntry@multiowned = typeAnalysisSession__visit_Identifier(rtoc_self_view, Identifier{ token: COPY node.token, name: "_", can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, fn_ref: NIL, heap_dupe_result: NIL, atomic_borrow: NIL, ownership_pending_transfer: NIL });
    IF (result != NIL) THEN
      RETURN result;
    END
}
END
PRIVATE FN typeAnalysisSession__visit_BindVar(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.left));
    MUTABLE lhs_type = &node.left.full_type_mut("bind left");
    MUTABLE var_name = node.right.name();
    MUTABLE lhs_ti = TRY (type__new(lhs_type));
    MUTABLE binding_type: String = "";
    IF (TRY (type__collection_value?(lhs_ti)) AND (TRY (type__element_type(lhs_ti)) != NIL)) THEN
      binding_type = COPY type__to_s((TRY (type__element_type(lhs_ti))));
    ELSE
      binding_type = lhs_type;
    END
    MUTABLE rtoc_mutable_receiver_449 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_449, var_name, NIL, SymbolEntryTypeInput{ StringValue: COPY binding_type }, ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node.right, binding_type));
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, lhs_type));
}
END
PRIVATE FN typeAnalysisSession__visit_CapabilityWrap(MUTABLE self: TypeAnalysisSession, MUTABLE node: CapabilityWrap) RETURNS !?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.value));
    MUTABLE base_type = node.value.resolved_type();
    MUTABLE ti = TRY (type__new(base_type));
    MUTABLE is_atomic_primitive = (capabilityWrap__atomic?(node) AND !(capabilityWrap__indirect?(node)));
    IF (type__primitive?(ti) AND capabilityWrap__atomic_ptr?(node)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :INDIRECT_ATOMIC_PRIMITIVE }, [], {:type: base_type});
    END
    IF ((type__primitive?(ti) AND !(is_atomic_primitive)) AND capabilityWrap__capability?(node)) THEN
      MUTABLE cap_name = ((node.sync OR_ELSE node.ownership) OR node.layout);
      IF (cap_name == :indirect) THEN
        cap_name = :boxed;
      END
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :CAPABILITY_ON_PRIMITIVE }, [], {:cap: cap_name, :type: base_type});
    END
    IF ((!(type__primitive?(ti)) AND capabilityWrap__atomic?(node)) AND !(capabilityWrap__indirect?(node))) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :STRUCT_ATOMIC_NEEDS_INDIRECT }, [], {:type: base_type});
    END
    IF capabilityWrap__atomic_ptr?(node) THEN
      IF (node.ownership == :local) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :LOCAL_INDIRECT_ATOMIC });
      ELSE_IF capabilityWrap__multiowned?(node) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :MULTIOWNED_INDIRECT_ATOMIC });
      END
    END
    TRY (type__apply_declared_type_capabilities_mut(&ti, node.ownership, node.sync, node.lock_rank, node.layout));
    IF (capabilityWrap__atomic_ptr?(node) AND !(node.ownership)) THEN
      TRY (type__apply_reference_ownership_mut(&ti, :shared));
    END
    IF capabilityWrap__indirect?(node) THEN
      type__pin_heap_for_indirect_mut(&ti);
    END
    IF (node.lock_rank AND capabilityWrap__locked_sync?(node)) THEN
      typeAnalysisSession__record_lock_type_rank_mut(rtoc_self_view, type__base_type(ti), node.lock_rank, node);
    END
    IF ((node.ownership OR node.sync) OR node.layout) THEN
      IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
            MUTABLE rtoc_mutable_receiver_450 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
            functionContext__record_heap_use_mut(&rtoc_mutable_receiver_450);
      END
      IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
            MUTABLE rtoc_mutable_receiver_451 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
            functionContext__record_alloc_use_mut(&rtoc_mutable_receiver_451);
      END
      IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
            MUTABLE rtoc_mutable_receiver_452 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
            functionContext__mark_runtime_used_mut(&rtoc_mutable_receiver_452);
      END
      typeAnalysisSession__record_effect(rtoc_self_view, symbol("HEAP"));
    END
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ CapabilityWrap: COPY node }, ti));
}
END
PRIVATE FN typeAnalysisSession__visit_OptionalUnwrap(MUTABLE self: TypeAnalysisSession, MUTABLE node: OptionalUnwrap) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.target));
    MUTABLE type = &node.target.full_type_mut("optional unwrap target");
    IF !((IF type != NIL THEN
      type.optional?()
    ELSE
      NIL
    END)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :UNWRAP_NON_OPTIONAL }, [], {:got: node.target.resolved_type()});
    END
    MUTABLE recoverable: ?Type@multiowned = typeAnalysisSession__recoverable_result_type(rtoc_self_view, &node.target, "optional unwrap target");
    MUTABLE plan_input_branch_value: ?Type@multiowned = NIL;
    IF (IF recoverable != NIL THEN
      type__optional?(recoverable)
    ELSE
      NIL
    END) THEN
      plan_input_branch_value = recoverable?;
    ELSE
      plan_input_branch_value = type;
    END
    MUTABLE plan_input: Type@multiowned = plan_input_branch_value?;
    MUTABLE plan = TRY (tenseOperationPlanner__unwrap(CAST(plan_input AS Type)));
    node.tense_plan = plan;
    MUTABLE result = COPY plan.result_type;
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node, result));
    node.storage = node.target.storage();
    IF type__error_union?(result) THEN
      node.error_union_type = result;
      node.can_fail = TRUE;
    END
    IF (TRY (type__c_array_view?(result)) OR aST__container_borrow?(node.target)) THEN
      node.container_borrow = TRUE;
    END
    RETURN result;
}
END
PRIVATE FN typeAnalysisSession__visit_TenseNavigation(MUTABLE self: TypeAnalysisSession, MUTABLE node: TenseNavigation) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.target));
    IF (node.markers.startsWith?("!") AND respondsTo?(node.target, "retain_error_channel=")) THEN
      node.target.retain_error_channel = TRUE;
    END
    MUTABLE receiver_type = (typeAnalysisSession__recoverable_result_type(rtoc_self_view, &node.target, "tense navigation receiver") OR_ELSE &node.target.full_type_mut("tense navigation receiver"));
    IF (TRY (type__canonical_stream_result?(receiver_type)) OR receiver_type.stream?()) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :TENSE_NAVIGATION_STREAM }, [], {:markers: node.markers, :type: TRY (type__surface_name(receiver_type))});
    END
    MUTABLE envelope = TRY (tenseEnvelope__from_type(receiver_type));
    IF (tenseEnvelope__order(envelope) != node.markers) THEN
      MUTABLE expected: String = "";
      IF (tenseEnvelope__order(envelope).length() == 0) THEN
        expected = "plain `.`";
      ELSE
        expected = tenseEnvelope__order(envelope);
      END
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :TENSE_NAVIGATION_MISMATCH }, [], {:markers: node.markers, :type: TRY (type__surface_name(receiver_type)), :expected: expected});
    END
    MUTABLE payload = TRY (tenseOperationPlanner__navigation_payload(receiver_type));
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ TenseNavigation: COPY node }, payload));
    node.storage = node.target.storage();
    IF aST__container_borrow?(node.target) THEN
      node.container_borrow = TRUE;
    END
    RETURN CAST(payload AS Type);
}
END
PRIVATE FN typeAnalysisSession__publish_tense_navigation_plan_mut(self: TypeAnalysisSession, MUTABLE member: Locatable, navigation: TenseNavigation, mapped_type: Type) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE receiver_type = (typeAnalysisSession__recoverable_result_type(rtoc_self_view, &navigation.target, "tense navigation receiver") OR_ELSE &navigation.target.full_type_mut("tense navigation receiver"));
    MUTABLE receiver_envelope = TRY (tenseEnvelope__from_type(receiver_type));
    MUTABLE mapped_envelope = TRY (tenseEnvelope__from_type(mapped_type));
    IF (tenseEnvelope__asynchronous?(receiver_envelope) AND tenseEnvelope__asynchronous?(mapped_envelope)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, member, TypeAnalysisCodeOrMessage{ SymbolValue: :TENSE_NAVIGATION_NESTED_FUTURE }, [], {:type: TRY (type__surface_name(castTypeToTypeTypeInput(mapped_type)))});
    END
    MUTABLE plan = TRY (tenseOperationPlanner__navigate(receiver_type, mapped_type, navigation.markers, type__shared?(receiver_type)));
    member.tense_plan = plan;
    IF tenseOperationPlan__consumes_handle?(plan) THEN
      MUTABLE root: ?Identifier = aST__root_identifier(navigation.target);
      IF (root != NIL) THEN
        TRY (typeAnalysisSession__og_set_moved(rtoc_self_view, identifier__name(root), root.token, :next));
      END
    ELSE_IF ((plan.backend_form == TenseBackendForm.DirectMap) AND aST__container_borrow?(navigation.target)) THEN
      member.container_borrow = TRUE;
    END
    RETURN COPY plan.result_type;
}
END
PRIVATE FN typeAnalysisSession__expr_result_type(self: TypeAnalysisSession, branch: []Locatable) RETURNS ?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (branch.length() == 0) THEN
      RETURN NIL;
    END
    MUTABLE last: ?Locatable = COPY branch.last();
    IF last? IS_A IfStatement AS if_statement THEN
      RETURN if_statement.then_result_type;
    END
    IF !((last != NIL)) THEN
      RETURN NIL;
    END
    MUTABLE ti = &last.full_type_mut("branch result");
    IF (ti.resolved() == :NoReturn) THEN
      RETURN ti;
    END
    IF type__void?(ti) THEN
      RETURN NIL;
    END
    IF aST__statement_result_void?(UNWRAP (last)) THEN
      RETURN NIL;
    END
    RETURN ti;
}
END
PRIVATE FN typeAnalysisSession__promote_to_expr_if_mut(self: TypeAnalysisSession, parent_node: Locatable, MUTABLE if_node: IfStatement) RETURNS !?Type
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE else_result = NIL;
    IF ((if_node.else_branch != NIL) AND (((if_node.else_branch)?).length() == 1)) THEN
    MUTABLE nested = if_node.else_branch.first();
    IF (nested) IS_A IfStatement THEN
      typeAnalysisSession__promote_to_expr_if_mut(rtoc_self_view, Locatable{ IfStatement: COPY if_node }, &nested);
      else_result = &nested.full_type_mut({:context: "nested expression if result"});
    ELSE
      else_result = if_node.else_result_type;
    END
    ELSE
    else_result = if_node.else_result_type;
    END
    MUTABLE then_result = if_node.then_result_type;
    IF !(then_result) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, if_node, TypeAnalysisCodeOrMessage{ SymbolValue: :IF_EXPR_THEN_NEEDS_VALUE });
    END
    IF !(else_result) THEN
      IF ((if_node.else_branch == NIL) OR ((if_node.else_branch)?).empty?()) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, if_node, TypeAnalysisCodeOrMessage{ SymbolValue: :IF_EXPR_NEEDS_ELSE });
      ELSE
        typeAnalysisSession__error_mut(rtoc_self_view, if_node, TypeAnalysisCodeOrMessage{ SymbolValue: :IF_EXPR_ELSE_NEEDS_VALUE });
      END
    END
    IF !((then_result AND else_result)) THEN
