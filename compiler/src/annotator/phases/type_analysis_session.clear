    END
    MUTABLE sig: ?FunctionSignature@multiowned = functionSignature__unwrap(ruby_wrap_optional_Type_multiowned_X((IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_305 = typeAnalysisSession__semantic_root_scope(rtoc_self_view);
    scope__resolve_entry(rtoc_local_receiver_305, node.name) } != NIL THEN
      { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_306 = ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_305 = typeAnalysisSession__semantic_root_scope(rtoc_self_view);
    scope__resolve_entry(rtoc_local_receiver_305, node.name) });
    symbolEntry__type(rtoc_local_receiver_306) }
    ELSE
      NIL
    END)));
    IF (((sig != NIL) AND TRY (functionSignature__requires(sig))) AND !(((TRY (functionSignature__requires(sig))).count() == 0))) THEN
      node.collapsed_errors = typeAnalysisSession__collapse_errors_for_call(rtoc_self_view, sig, node.args);
    END
}
END
PRIVATE FN typeAnalysisSession__record_held_lock_call_site_mut(self: TypeAnalysisSession, node: FuncCall) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE held_lock_types = TRY (typeAnalysisSession__semantic_held_lock_types(rtoc_self_view));
    IF (held_lock_types.length() == 0) THEN
      RETURN;
    END
    IF !((TRY (typeAnalysisSession__semantic_function_nodes(rtoc_self_view))).contains?(node.name)) THEN
      RETURN;
    END
    MUTABLE fn_name: String = "<top>";
    IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
      fn_name = ((typeAnalysisSession__current_fn_ctx(rtoc_self_view))?).name;
    END
    typeAnalysisSession__record_held_call_mut(rtoc_self_view, fn_name, node.name, held_lock_types, node.token);
}
END
PRIVATE FN typeAnalysisSession__resolve_extern_method_call_mut(self: TypeAnalysisSession, MUTABLE node: MethodCall) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE obj_type = &node.object.full_type_mut("method receiver");
    IF !(obj_type) THEN
      RETURN FALSE;
    END
    MUTABLE resolved = IF obj_type IS_A Type THEN
      obj_type.resolved()
    ELSE
      symbol((CAST(obj_type AS String)))
    END;
    MUTABLE base = IF (obj_type IS_A Type AND type__generic_instance?(obj_type)) THEN
      type__generic_base(obj_type)
    ELSE
      resolved
    END;
    MUTABLE type_schema = typeAnalysisSession__lookup_type_schema(rtoc_self_view, base);
    IF !((((schemas__struct?(type_schema) OR schemas__resource?(type_schema))) AND ((type_schema.methods() != NIL) AND ((type_schema.methods())?).key?(node.name)))) THEN
      RETURN FALSE;
    END
    MUTABLE method_sig = type_schema.methods()[node.name];
    IF !(functionSignature__extern(method_sig)) THEN
      RETURN FALSE;
    END
    node.extern_call = TRUE;
    IF TRY (functionSignature__extern_effects(method_sig)) THEN
      node.extern_effects = TRY (functionSignature__extern_effects(method_sig));
    END
    node.extern_source = functionSignature__extern_source(method_sig);
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node, functionSignature__return_type(method_sig)));
    typeAnalysisSession__record_effect(rtoc_self_view, symbol("EXTERN"));
    typeAnalysisSession__record_extern_method_alloc_mut(rtoc_self_view, method_sig);
    typeAnalysisSession__record_predicate_call_site_mut(rtoc_self_view, Node{ MethodCall: COPY node });
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__record_extern_method_alloc_mut(self: TypeAnalysisSession, method_sig: FunctionSignature) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE alloc_kind = (TRY (functionSignature__extern_effects(method_sig)))[:alloc];
    MUTABLE fn_ctx: ?FunctionContext@multiowned = typeAnalysisSession__current_fn_ctx(rtoc_self_view);
    IF !((alloc_kind AND (fn_ctx != NIL))) THEN
      RETURN;
    END
    IF (alloc_kind == :heap) THEN
      functionContext__record_heap_use_mut(&fn_ctx);
    ELSE
      functionContext__record_frame_use_mut(&fn_ctx);
    END
}
END
PRIVATE FN typeAnalysisSession__resolve_intrinsic_method_call_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: MethodCall) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE definitions: []FunctionSignature@multiowned = TRY (intrinsicRegistry__overloads(:std_lib, node.name));
    IF (definitions.length() > 0) THEN
      MUTABLE method_overloads: []FunctionSignature@multiowned = definitions |> WHERE { MUTABLE rtoc_mutable_block_param_307 = COPY _;
      ((TRY (functionSignature__intrinsic_contract(&rtoc_mutable_block_param_307))).behavior).is_method };
      IF (method_overloads.length() == 0) THEN
        RETURN FALSE;
      END
      MUTABLE receiver_type = &node.object.full_type_mut("intrinsic method receiver");
      MUTABLE implicit_safe_nav = ((receiver_type.optional?() AND respondsTo?(node.object, "safe_nav_chain")) AND (node.object.safe_nav_chain() == TRUE));
      MUTABLE resolution_receiver = COPY node.object;
      IF implicit_safe_nav THEN
        resolution_receiver = COPY node.object;
        TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &resolution_receiver, TRY (type__wrapped_type(receiver_type))));
      END
      MUTABLE ufcs_args = ([resolution_receiver] + node.args);
      MUTABLE matched_def: ?FunctionSignature@multiowned = typeAnalysisSession__find_matching_intrinsic(rtoc_self_view, method_overloads, ufcs_args);
      IF !(matched_def) THEN
        MUTABLE sigs = ( { MUTABLE rtoc_map_results = CAST([] AS []String); method_overloads |> EACH { &rtoc_map_results.append(COPY functionSignature__intrinsic_args_label(_)); }; rtoc_map_results } ).join(" or ");
        MUTABLE arg_types = (ufcs_args |> SELECT _.resolved_type()).join(", ");
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :INTRINSIC_NO_OVERLOAD }, arg_types, {:name: node.name, :candidates: sigs});
      END
      typeAnalysisSession__visit_IntrinsicFunc(&rtoc_self_view, Node{ MethodCall: COPY node }, ufcs_args, matched_def);
      MUTABLE navigation = ((node.object IS_A OptionalUnwrap AND node.object.safe_navigation?()) OR implicit_safe_nav);
      IF navigation THEN
        MUTABLE result = &node.full_type_mut("safe-navigation intrinsic method result");
        IF !(type__optional?(result)) THEN
          TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node, TRY (type__optional_of(TypeTypeInput{ Type: COPY result }))));
          node.safe_nav_chain = TRUE;
        END
      END
      MUTABLE resolved_receiver_type = IF implicit_safe_nav THEN
        TRY (type__wrapped_type(receiver_type))
      ELSE
        receiver_type
      END;
      MUTABLE element_type = resolved_receiver_type.element_type();
      IF ((((element_type != NIL) AND TRY (type__node_reference?((element_type?)))) AND (["append", "push", "insert"]).contains?(node.name)) AND node.args.any?()) THEN
        MUTABLE value_arg = COPY UNWRAP (node.args.last());
        MUTABLE actual_type = &value_arg.full_type_mut("@node collection insertion");
        IF (!(TRY (type__node_reference?(actual_type))) AND TRY (type__accepts?(element_type, actual_type))) THEN
          value_arg.coerced_type = element_type;
        END
      END
      typeAnalysisSession__record_predicate_call_site_mut(rtoc_self_view, Node{ MethodCall: COPY node });
      RETURN TRUE;
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__finalize_program_type_mut(self: TypeAnalysisSession, program: Program) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
