PRIVATE FN typeAnalysisSession__validate_bound_types_mut(self: TypeAnalysisSession, node: AnnotationNode, parameter: String@symbol, argument: Type, bounds: []Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < bounds.length() DO
      MUTABLE protocol = typeAnalysisSession__protocol_base_name(rtoc_self_view, bounds[rtoc_idx]?);
      IF typeAnalysisSession__type_conforms_to_protocol?(rtoc_self_view, argument, protocol) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_PROTOCOL_BOUND_FAILED }, [], {:parameter: parameter, :actual: TRY (type__surface_name(castTypeToTypeTypeInput(argument))), :protocol: protocol});
    rtoc_idx = rtoc_idx + 1;
    END
    MUTABLE shared = bounds |> ANY type__polymorphic_shared?(_);
    IF ((shared AND !(type__shared?(argument))) AND !(typeAnalysisSession__generic_parameter_has_shared_map_bound?(rtoc_self_view, type__resolved(argument)))) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_SHARED_BOUND_FAILED }, [], {:parameter: parameter, :actual: TRY (type__surface_name(castTypeToTypeTypeInput(argument))), :protocol: "Map"});
    END
}
END
