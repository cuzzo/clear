PRIVATE FN typeAnalysisSession__type_conforms_to_protocol?(MUTABLE self: TypeAnalysisSession, argument: Type, protocol: String) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (protocol == "Map") THEN
      RETURN (type__map?(argument) OR TRY (typeAnalysisSession__generic_parameter_has_map_bound?(&rtoc_self_view, type__resolved(argument))));
    END
    IF (TRY (typeAnalysisSession__generic_parameter_protocol_names(&rtoc_self_view, type__resolved(argument)))).contains?(protocol) THEN
      RETURN TRUE;
    END
    RETURN !((TRY (typeAnalysisSession__conformance_match(&rtoc_self_view, protocol, argument)) == NIL));
}
END
PRIVATE FN typeAnalysisSession__conformance_match(MUTABLE self: TypeAnalysisSession, protocol: String, concrete: Type) RETURNS !?ConformanceMatch
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN TRY (typeAnalysisSession__conformance_match_avoiding(&rtoc_self_view, protocol, concrete, Set[]));
}
END
PRIVATE FN typeAnalysisSession__conformance_match_avoiding(MUTABLE self: TypeAnalysisSession, protocol: String, concrete: Type, active: [Set]String) RETURNS !?ConformanceMatch
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE key = "${protocol}:${type__semantic_type_key(concrete)}";
    IF active.contains?(key) THEN
      RETURN NIL;
    END
    MUTABLE next_active: [Set]String = COPY active;
    &next_active.insert(COPY key);
    MUTABLE rtoc_each_items_181 = (TRY (typeAnalysisSession__semantic_conformance_resolutions(&rtoc_self_view)));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_181.length() DO
      IF !(((rtoc_each_items_181[rtoc_idx]?.protocol).name == protocol)) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE owner: ?Type = COPY (rtoc_each_items_181[rtoc_idx]?.declaration).owner_type;
      MUTABLE substitutions: ?{String@symbol}Type@multiowned = TRY (typeAnalysisSession__conformance_owner_substitutions(&rtoc_self_view, UNWRAP (owner), concrete));
      IF !(substitutions) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !(TRY (typeAnalysisSession__conformance_binder_bounds_satisfied?(&rtoc_self_view, UNWRAP (rtoc_each_items_181[rtoc_idx]), CAST(substitutions AS {String@symbol}Type), next_active))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      RETURN ConformanceMatch{ resolution: COPY rtoc_each_items_181[rtoc_idx]?, substitutions: CAST(COPY substitutions AS {String@symbol}Type) };
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__conformance_binder_bounds_satisfied?(MUTABLE self: TypeAnalysisSession, resolution: ConformanceResolution, substitutions: {String@symbol}Type, active: [Set]String) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN resolution.declaration.binders |> ALL { MUTABLE rtoc_value_block_marker = 0; MUTABLE concrete: ?Type = COPY substitutions[symbol(_.name)]; (IF !(concrete) THEN FALSE ELSE ((_.bounds |> ALL {
    MUTABLE protocol = typeAnalysisSession__protocol_base_name(&rtoc_self_view, _.type);
    (  IF (protocol == "Map") THEN
        (type__map?( concrete) OR TRY (typeAnalysisSession__generic_parameter_has_map_bound?(&rtoc_self_view, type__resolved( concrete))))
      ELSE_IF (TRY (typeAnalysisSession__generic_parameter_protocol_names(&rtoc_self_view, type__resolved( concrete)))).contains?(protocol) THEN
        TRUE
      ELSE
        !(((TRY (typeAnalysisSession__conformance_match_avoiding(&rtoc_self_view, protocol, concrete, active))) == NIL))
      END)
    }) AND ((((!(_.bounds |> ANY type__polymorphic_shared?(_.type))) OR type__shared?( concrete))))) END) };
}
END
PRIVATE FN typeAnalysisSession__conformance_owner_substitutions(MUTABLE self: TypeAnalysisSession, pattern: Type, concrete: Type) RETURNS !?{String@symbol}Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF type__generic_instance?(pattern) THEN
      IF !((type__generic_instance?(concrete) AND (type__generic_base(pattern) == type__generic_base(concrete)))) THEN
        RETURN NIL;
      END
      IF !(((TRY (type__generic_args(pattern))).length() == (TRY (type__generic_args(concrete))).length())) THEN
        RETURN NIL;
      END
      MUTABLE substitutions: {String@symbol}Type = {};
      MUTABLE rtoc_pattern_args = TRY (type__generic_args(pattern));
      MUTABLE rtoc_concrete_args = TRY (type__generic_args(concrete));
      MUTABLE rtoc_zip_i = 0;
      WHILE rtoc_zip_i < rtoc_pattern_args.length() DO
        MUTABLE parameter: ?Type = COPY rtoc_pattern_args[rtoc_zip_i];
        MUTABLE argument: ?Type = COPY rtoc_concrete_args[rtoc_zip_i];
        IF !((parameter != NIL AND argument != NIL)) THEN
          RETURN NIL;
        END
        substitutions[type__resolved(parameter)] = TRY (type__new(TypeConstructionInput{ Type: COPY argument }));
        rtoc_zip_i = rtoc_zip_i + 1;
      END
      RETURN substitutions;
    END
    IF (type__semantic_type_key((TRY (type__bare_data_type(pattern)))) == type__semantic_type_key((TRY (type__bare_data_type(concrete))))) THEN
      RETURN {};
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__generic_parameter_has_map_bound?(MUTABLE self: TypeAnalysisSession, name: String@symbol) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE param: ?GenericParamDecl = (TRY (typeAnalysisSession__current_function_generic_params(&rtoc_self_view))) |> FIND (symbol(_.name) == name);
