    END
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("${castTypeToString(item_type)}[]") }))));
    node.storage = :frame;
    RETURN :frame;
}
END
PRIVATE FN typeAnalysisSession__analyze_unnest_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?SymbolEntry@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__require_array_input_mut(rtoc_self_view, node, "UNNEST");
    MUTABLE item_type = (&node.left.full_type_mut("pipeline left")).element_type().resolved();
    MUTABLE inner_bind_name = NIL;
    MUTABLE expr = node.right.expression();
    IF (expr IS_A BinaryOp AND (expr.op() == :BIND_VAR)) THEN
      inner_bind_name = expr.right().name();
    END
    typeAnalysisSession__with_new_scope(rtoc_self_view, %() USE(item_type, node, rtoc_self_view) -> {
    MUTABLE rtoc_mutable_receiver_132 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_132, "_", NIL, item_type, ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    typeAnalysisSession__annotate_pipeline_expression_mut(&rtoc_self_view, node.right, node.right.expression())
    });
    MUTABLE expr_type = TRY (type__new(node.right.expression().full_type_mut({:context: "pipeline op expression"})));
    IF !(type__array?(expr_type)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node.right.expression(), TypeAnalysisCodeOrMessage{ SymbolValue: :UNNEST_NEEDS_ARRAY }, [], {:got: node.right.expression().resolved_type()});
    END
    MUTABLE nested_element_type = type__resolved(UNWRAP (TRY (type__element_type(expr_type))));
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("${nested_element_type}[]") }))));
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node.right, node.right.expression().full_type_mut({:context: "pipeline op expression"})));
    node.storage = :frame;
    IF inner_bind_name THEN
      RETURN { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_133 = typeAnalysisSession__current_scope(rtoc_self_view);
      TRY (scope__declare(&rtoc_mutable_receiver_133, inner_bind_name, NIL, SymbolEntryTypeInput{ StringValue: COPY CAST(nested_element_type AS String) }, ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack)) };
    END
}
END
PRIVATE FN typeAnalysisSession__analyze_distinct_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lhs_type = &node.left.full_type_mut("pipeline left");
    MUTABLE source = typeAnalysisSession__pipeline_source_fact(rtoc_self_view, node.left, lhs_type, TRUE);
    MUTABLE is_stream = pipelineSourceFact__stream?(source);
    typeAnalysisSession__require_array_input_mut(rtoc_self_view, node, "DISTINCT", is_stream, is_stream);
    MUTABLE item_type = COPY source.item_type;
    typeAnalysisSession__with_new_scope(rtoc_self_view, %() USE(item_type, node, rtoc_self_view) -> {
    MUTABLE rtoc_mutable_receiver_134 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_134, "_", NIL, castTypeToOptionalSymbolEntryTypeInput(item_type), ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    typeAnalysisSession__annotate_pipeline_expression_mut(&rtoc_self_view, node.right, node.right.expression())
    });
    MUTABLE key_type = node.right.expression().full_type_mut({:context: "DISTINCT key expression"});
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node.right, key_type));
    MUTABLE bounded_n =   IF (IF lhs_type != NIL THEN
      lhs_type.bounded_stream?()
    ELSE
      NIL
    END) THEN
      {
    MUTABLE rtoc_value_block_marker = 0;
    shape = IF type__fixed?((TRY (type__tense_type(lhs_type)))) THEN
      TRY (type__tense_type(lhs_type))
    ELSE
      TRY (type__optional_stream_shape_type(lhs_type))
    END;
    (IF shape != NIL THEN
      shape.capacity()
    ELSE
      NIL
    END)
    }
    ELSE
      NIL
    END;
    IF bounded_n THEN
      MUTABLE result_type = TRY (type__set_of(key_type, bounded_n));
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, result_type));
      node.storage = :heap;
      IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
            MUTABLE rtoc_mutable_receiver_135 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
            functionContext__record_heap_use_mut(&rtoc_mutable_receiver_135);
      END
      RETURN CAST(typeAnalysisSession__mark_observable_terminal_mut(rtoc_self_view, node, :distinct, symbol("~${key_type}[${bounded_n}]"), :set) AS ?Type);
    ELSE
      result_type = TRY (type__set_of(key_type));
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, result_type));
      node.storage = :heap;
      IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
            MUTABLE rtoc_mutable_receiver_136 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
            functionContext__record_heap_use_mut(&rtoc_mutable_receiver_136);
      END
      RETURN CAST(typeAnalysisSession__mark_observable_terminal_mut(rtoc_self_view, node, :distinct, symbol("~${key_type}[]"), :set) AS ?Type);
    END
}
END
PRIVATE FN typeAnalysisSession__analyze_pipe_to_func_call(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    node.right.args().unshift(node.left);
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.right));
    node.right.args().shift();
    MUTABLE result_type = &node.right.full_type_mut("pipeline right");
    IF (typeAnalysisSession__has_catch_blocks?(rtoc_self_view) AND TRUE) THEN
      MUTABLE t = TRY (type__new(TypeConstructionInput{ SymbolValue: COPY result_type }));
      IF type__error_union?(t) THEN
        result_type = type__resolved(UNWRAP (TRY (type__payload_type(t))));
      END
    END
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, result_type));
    typeAnalysisSession__propagate_pipeline_recovery_mut(rtoc_self_view, &node, castLocatableToFuncCall(node.right), !(typeAnalysisSession__has_catch_blocks?(rtoc_self_view)));
    RETURN CAST(&node.full_type_mut("pipeline function result") AS ?Type);
}
END
PRIVATE FN typeAnalysisSession__analyze_pipe_to_identifier(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.right));
    MUTABLE t = &node.right.full_type_mut("pipeline callable");
    MUTABLE sig = (functionSignature__unwrap(t) OR_ELSE t);
    MUTABLE func_name = node.right.name();
    IF sig IS_A FunctionSignature@multiowned THEN
      typeAnalysisSession__analyze_pipe_to_named_function(rtoc_self_view, &node, sig, func_name);
    ELSE_IF ((sig == :Intrinsic) OR (sig == :Nil)) THEN
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, IF ((sig == :Intrinsic)) THEN
        :Any
      ELSE
        sig
      END));
    ELSE
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :PIPE_NOT_CALLABLE }, [], {:name: func_name, :type: sig});
    END
}
END
PRIVATE FN typeAnalysisSession__analyze_pipe_to_named_function(self: TypeAnalysisSession, MUTABLE node: BinaryOp, sig: FunctionSignature, func_name: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE plan = typeAnalysisSession__pipe_arity_plan(rtoc_self_view, sig, 1);
    IF pipeArityPlan__mismatch?(plan) THEN
      IF pipeArityPlan__exact?(plan) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :ARITY_MISMATCH }, [], {:name: func_name, :expected: plan.min_args, :got: plan.given_args});
      ELSE
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :ARITY_MISMATCH_RANGE }, [], {:name: func_name, :min: plan.min_args, :max: plan.max_args, :got: plan.given_args});
      END
    END
    IF (plan.max_args >= 1) THEN
      MUTABLE param = COPY UNWRAP (plan.params[0]);
      MUTABLE expected = COPY param.type;
      MUTABLE actual = node.left.resolved_type();
      IF !(typeAnalysisSession__is_safe_autocast?(rtoc_self_view, actual, castTypeToTypeTypeInput(expected))) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node.left, TypeAnalysisCodeOrMessage{ SymbolValue: :ARGUMENT_TYPE_ERROR }, [], {:fn: "Pipe Input '${param.name}'", :index: 1, :expected: expected, :got: actual});
      END
    END
    MUTABLE result_type = functionSignature__return_type(sig);
    IF (typeAnalysisSession__has_catch_blocks?(rtoc_self_view) AND TRUE) THEN
      MUTABLE t = result_type;
      IF type__error_union?(t) THEN
        result_type = type__resolved((TRY (type__payload_type(t))));
      END
    END
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, result_type));
    MUTABLE recoverable = TRY (type__new(TypeConstructionInput{ Type: COPY functionSignature__return_type(sig) }));
    IF (type__error_union?(recoverable) OR functionSignature__recoverable_result?(sig)) THEN
      IF !(typeAnalysisSession__has_catch_blocks?(rtoc_self_view)) THEN
        node.error_union_type = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_137: ?Type = NIL;
        IF type__error_union?(recoverable) THEN
          rtoc_ternary_value_137 = recoverable;
        ELSE
          rtoc_ternary_value_137 = TRY (type__error_union_of(castTypeToTypeTypeInput(recoverable)));
        END
        rtoc_ternary_value_137? };
      END
      node.can_fail = TRUE;
    END
}
END
PRIVATE FN typeAnalysisSession__propagate_pipeline_recovery_mut(self: TypeAnalysisSession, MUTABLE node: BinaryOp, call: FuncCall, retain_error_union: Bool) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE error_type = NIL;
    error_type = call.error_union_type;
    IF (retain_error_union AND error_type) THEN
      node.error_union_type = error_type;
    END
    IF (error_type OR (call.can_fail == TRUE)) THEN
      node.can_fail = TRUE;
    END
}
END
PRIVATE FN typeAnalysisSession__pipe_arity_plan(self: TypeAnalysisSession, sig: FunctionSignature, given_args: Int64) RETURNS !PipeArityPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE params = TRY (functionSignature__params(sig));
    RETURN PipeArityPlan{ params: COPY params, min_args: params |> COUNT _.required, max_args: params.length(), given_args: COPY given_args };
}
END
PRIVATE FN typeAnalysisSession__analyze_each_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lhs_type = &node.left.full_type_mut("pipeline left");
    MUTABLE iterable = typeAnalysisSession__pipeline_source_fact(rtoc_self_view, node.left, lhs_type);
    IF !(pipelineSourceFact__valid?(iterable)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node.left, TypeAnalysisCodeOrMessage{ SymbolValue: :EACH_NEEDS_COLLECTION }, [], {:got: node.left.resolved_type()});
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, :Void));
      RETURN;
    END
    MUTABLE item_type = COPY iterable.item_type;
    typeAnalysisSession__with_new_scope(rtoc_self_view, typeAnalysisSession__current_scope(rtoc_self_view), %() USE(item_type, node, MUTABLE rtoc_self_view) -> {
    MUTABLE rtoc_mutable_receiver_138 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_138, "_", NIL, castTypeToOptionalSymbolEntryTypeInput(item_type), ScopeMutabilityInput{ BoolValue: TRUE }, FALSE, NIL, :stack));
    typeAnalysisSession__with_soa_tracking(rtoc_self_view, node, item_type, %() USE(node, MUTABLE rtoc_self_view) -> {
      FOR _ IN node.right.body() DO
      TRY (typeAnalysisSession__visit(&rtoc_self_view, _));
      END
      NIL
    })
    });
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, :Void));
    node.storage = :frame;
    RETURN :frame;
}
END
PRIVATE FN typeAnalysisSession__analyze_skip_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lhs_type = &node.left.full_type_mut("pipeline left");
    MUTABLE source = typeAnalysisSession__pipeline_source_fact(rtoc_self_view, node.left, lhs_type, TRUE);
    MUTABLE is_stream = pipelineSourceFact__stream?(source);
    typeAnalysisSession__require_array_input_mut(rtoc_self_view, node, "SKIP", is_stream, is_stream);
    MUTABLE item_type = COPY source.item_type;
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.right.count()));
    MUTABLE count_type = node.right.count().resolved_type();
    IF !(([:Int64, :Float64]).contains?(count_type)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node.right.count(), TypeAnalysisCodeOrMessage{ SymbolValue: :SKIP_COUNT_NEEDS_NUMBER }, [], {:got: count_type});
    END
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, IF pipelineSourceFact__inf_stream?(source) THEN
      symbol("~${castTypeToString(item_type)}[INF]")
    ELSE
      symbol("${castTypeToString(item_type)}[]")
    END));
    node.storage = :frame;
    RETURN :frame;
}
END
PRIVATE FN typeAnalysisSession__analyze_tap_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lhs_type = &node.left.full_type_mut("pipeline left");
