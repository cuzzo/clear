PRIVATE FN typeAnalysisSession__generic_type_has_capabilities?(MUTABLE self: TypeAnalysisSession, type: Type) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN ((((((type__ownership(type) != :affine) OR !((type__sync(type) == NIL))) OR !((type__layout(type) == NIL))) OR !((type__elem_ownership(type) == NIL))) OR !((type__elem_sync(type) == NIL))) OR !((type__elem_layout(type) == NIL)));
