PRIVATE FN typeAnalysisSession__parse_batch_window_time_ns(self: TypeAnalysisSession, str: String) RETURNS !?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE m = (compilerRegexCompile("\\A(\\d+(?:\\.\\d+)?)(ms|s|min|h)\\z")).match(str);
    IF !(m) THEN
      RETURN NIL;
    END
    RETURN TRY (((m[1].to_f() * UNWRAP (([CAST(Tuple{"ms", 1000000} AS Tuple<String, Int64>), CAST(Tuple{"s", 1000000000} AS Tuple<String, Int64>), CAST(Tuple{"min", 60000000000} AS Tuple<String, Int64>), CAST(Tuple{"h", 3600000000000} AS Tuple<String, Int64>)]).to_h()[m[2]]))).toInt());
}
END
PRIVATE FN typeAnalysisSession__analyze_batch_window_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE opts = node.right.options();
    MUTABLE bw = COPY node.right;
    MUTABLE valid_keys = ["size", "time"];
    FOR _ IN opts.keys() DO
    IF !(valid_keys.contains?(_)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, bw.token(), TypeAnalysisCodeOrMessage{ SymbolValue: :WINDOW_BAD_OPTION }, [], {:name: _, :valid: valid_keys.join(", ")});
    END
    END
    IF !((opts.key?("size") OR opts.key?("time"))) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, bw.token(), TypeAnalysisCodeOrMessage{ SymbolValue: :WINDOW_NEEDS_SIZE_OR_TIME });
    END
    IF opts["size"] THEN
      TRY (typeAnalysisSession__visit(&rtoc_self_view, opts["size"]));
      MUTABLE size_type = opts["size"].resolved_type();
      IF !(([:Int64, :Float64]).contains?(size_type)) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, opts["size"], TypeAnalysisCodeOrMessage{ SymbolValue: :WINDOW_SIZE_NEEDS_NUMBER }, [], {:got: size_type});
      END
      IF opts["size"] IS_A Literal THEN
        MUTABLE v = opts["size"].value().to_f();
        IF (v <= 0) THEN
          typeAnalysisSession__error_mut(rtoc_self_view, opts["size"], TypeAnalysisCodeOrMessage{ SymbolValue: :WINDOW_SIZE_NEEDS_POSITIVE });
        END
      END
    END
    IF opts["time"] THEN
      TRY (typeAnalysisSession__visit(&rtoc_self_view, opts["time"]));
      IF !((opts["time"] IS_A Literal AND (opts["time"].type() == :STRING))) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, opts["time"], TypeAnalysisCodeOrMessage{ SymbolValue: :WINDOW_TIME_NEEDS_STRING_LIT });
      END
      MUTABLE ns: ?Int64 = typeAnalysisSession__parse_batch_window_time_ns(rtoc_self_view, opts["time"].value());
      IF !(ns) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, opts["time"], TypeAnalysisCodeOrMessage{ SymbolValue: :WINDOW_TIME_BAD_FORMAT }, [], {:got: opts["time"].value()});
      END
      IF (ns <= 0) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, opts["time"], TypeAnalysisCodeOrMessage{ SymbolValue: :WINDOW_TIME_NEEDS_POSITIVE });
      END
    END
    MUTABLE left_ti = &node.left.full_type_mut("pipeline left");
    MUTABLE item_type_branch_value: ?Any@multiowned = NIL;
    IF (IF left_ti != NIL THEN
      left_ti.inf_stream?()
    ELSE
      NIL
    END) THEN
      item_type_branch_value = type__resolved((TRY (type__inf_stream_element_type(left_ti))));
    ELSE_IF (IF left_ti != NIL THEN
      TRY (type__open_stream?(left_ti))
    ELSE
      NIL
    END) THEN
      item_type_branch_value = type__resolved((TRY (type__open_stream_element_type(left_ti))));
    ELSE_IF (IF left_ti != NIL THEN
      TRY (type__dynamic_stream?(left_ti))
    ELSE
      NIL
    END) THEN
      item_type_branch_value = type__resolved((TRY (type__element_type((TRY (type__tense_type(left_ti)))))));
    ELSE_IF (IF left_ti != NIL THEN
      left_ti.bounded_stream?()
    ELSE
      NIL
    END) THEN
      item_type_branch_value = type__resolved((TRY (type__stream_element_type(left_ti))));
    ELSE_IF (IF left_ti != NIL THEN
      left_ti.element_type()
    ELSE
      NIL
    END) THEN
      item_type_branch_value = left_ti.element_type().resolved();
    ELSE
      item_type_branch_value = typeAnalysisSession__error_mut(rtoc_self_view, node.left, TypeAnalysisCodeOrMessage{ SymbolValue: :WINDOW_NEEDS_COLLECTION_INPUT });
    END
    MUTABLE item_type: Any@multiowned = item_type_branch_value?;
    typeAnalysisSession__with_new_scope(rtoc_self_view, %() USE(bw, item_type, MUTABLE rtoc_self_view) -> {
    MUTABLE rtoc_mutable_receiver_120 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_120, "_", NIL, SymbolEntryTypeInput{ SymbolValue: COPY symbol("${item_type}[]") }, ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    TRY (typeAnalysisSession__visit(&rtoc_self_view, bw.expression()))
    });
    MUTABLE expr_type = bw.expression().full_type_mut({:context: "BATCH WINDOW expression"});
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("${expr_type}[]") }))));
    node.storage = :heap;
    IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
        MUTABLE rtoc_mutable_receiver_121 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
        functionContext__record_frame_use_mut(&rtoc_mutable_receiver_121);
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__analyze_join_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__require_array_input_mut(rtoc_self_view, node, "JOIN");
    MUTABLE left_type = (&node.left.full_type_mut("pipeline left")).element_type().resolved();
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.right.right_source()));
    MUTABLE rhs_type_info = node.right.right_source().full_type_mut({:context: "pipeline right source"});
    IF !(((node.right.right_source().metatype() == :array) OR (IF rhs_type_info != NIL THEN
      type__collection?(rhs_type_info)
    ELSE
      NIL
    END))) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node.right.right_source(), TypeAnalysisCodeOrMessage{ SymbolValue: :JOIN_RIGHT_NEEDS_LIST }, [], {:got: node.right.right_source().resolved_type()});
    END
    MUTABLE right_type = rhs_type_info.element_type().resolved();
    MUTABLE key_expr = node.right.key_expr();
    IF key_expr IS_A LambdaLit THEN
      MUTABLE params = key_expr.params();
      IF !((params.size() == 2)) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, key_expr, TypeAnalysisCodeOrMessage{ SymbolValue: :JOIN_LAMBDA_ARITY });
      END
      MUTABLE left_name = params[0].name();
      MUTABLE right_name = params[1].name();
      typeAnalysisSession__with_new_scope(rtoc_self_view, %() USE(key_expr, left_name, left_type, right_name, right_type, MUTABLE rtoc_self_view) -> {
    MUTABLE rtoc_mutable_receiver_122 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_122, left_name, NIL, left_type, ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    MUTABLE rtoc_mutable_receiver_123 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_123, right_name, NIL, right_type, ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    FOR _ IN (TRY (aST__lambda_body_nodes(key_expr.body()))) DO
    TRY (typeAnalysisSession__visit(&rtoc_self_view, castNodeToOptionalLocatable(_)));
    END
    NIL
      });
      MUTABLE key_result: ?Node = COPY (TRY (aST__lambda_body_nodes(key_expr.body()))).last();
      IF !(((key_result != NIL) AND (key_result.resolved_type() == :Bool))) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, key_expr, TypeAnalysisCodeOrMessage{ SymbolValue: :JOIN_LAMBDA_NEEDS_BOOL }, [], {:got: (IF key_result != NIL THEN
          key_result.resolved_type()
        ELSE
          NIL
        END)});
      END
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &key_expr, typeAnalysisSession__build_lambda_signature(rtoc_self_view, params, :Bool)));
    ELSE
      typeAnalysisSession__with_new_scope(rtoc_self_view, %() USE(key_expr, left_type, MUTABLE rtoc_self_view) -> {
    MUTABLE rtoc_mutable_receiver_124 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_124, "_", NIL, left_type, ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    TRY (typeAnalysisSession__visit(&rtoc_self_view, key_expr))
      });
      typeAnalysisSession__with_new_scope(rtoc_self_view, %() USE(key_expr, right_type, MUTABLE rtoc_self_view) -> {
    MUTABLE rtoc_mutable_receiver_125 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_125, "_", NIL, right_type, ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    TRY (typeAnalysisSession__visit(&rtoc_self_view, key_expr))
      });
    END
    MUTABLE join_type_name = symbol("JoinResult_${left_type}_${right_type}");
    IF !({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_126 = typeAnalysisSession__current_scope(rtoc_self_view);
    scope__resolve_type_definition(rtoc_local_receiver_126, join_type_name) }) THEN
