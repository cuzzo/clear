PRIVATE FN typeAnalysisSession__emit_use_of_moved_error_mut(MUTABLE self: TypeAnalysisSession, use_node: Identifier, og_node: OwnershipNode) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE src: ?String = typeAnalysisSession__source_code(&rtoc_self_view);
    MUTABLE name = COPY use_node.name;
    MUTABLE move_line: ?Int64 = og_node.move_line;
    MUTABLE move_col: ?Int64 = og_node.move_col;
    IF move_line EXISTS AS move_line_value THEN
      IF move_col THEN
        MUTABLE fanout_entry: ?SymbolEntry@multiowned = NIL;
        IF TRY (typeAnalysisSession__lookup_scope_for(&rtoc_self_view, name)) != NIL THEN
          fanout_entry = COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_35 = (UNWRAP (TRY (typeAnalysisSession__lookup_scope_for(&rtoc_self_view, name))));
        scope__resolve_entry(rtoc_local_receiver_35, name) };
        END
        IF (((fanout_entry != NIL) AND symbolEntry__is_param(fanout_entry)) AND (symbolEntry__carrier_contract(fanout_entry) == :polymorphic)) THEN
          RETURN TRY (typeAnalysisSession__emit_carrier_fanout_error_mut(&rtoc_self_view, use_node, og_node, name, move_line_value, move_col));
        END
        MUTABLE type = ownershipNode__full_type(og_node);
        MUTABLE is_shared = type__shared?(UNWRAP (castTypeTypeInputToType(TypeTypeInput{ Type: COPY type })));
        MUTABLE is_multi = type__multiowned?(type);
        MUTABLE is_split = type__split?(type);
        MUTABLE use_clone = ((is_shared OR is_multi) OR is_split);
        MUTABLE consumer_keyword: String = "";
        IF use_clone THEN
          consumer_keyword = "KEEP";
        ELSE
          consumer_keyword = "COPY";
        END
        MUTABLE consumer_description_code = IF use_clone THEN
          :WRAP_CONSUMER_WITH_KEEP
        ELSE
          :WRAP_CONSUMER_WITH_COPY
        END;
        MUTABLE replacement_col: ?Int64 = move_col;
        MUTABLE replacement_length = name.codepointCount();
        IF src EXISTS AS src_value THEN
          MUTABLE move_text = COPY (src_value.split("\n")[(move_line_value - 1)] OR_ELSE "");
          MUTABLE prefix = COPY (move_text.substr(0, (move_col - 1)));
          MUTABLE give_prefix: ?CompilerRegexScanner = compilerRegexMatchData(prefix, compilerRegexCompile("GIVE\\s+\\z"));
          IF give_prefix EXISTS AS give_prefix_value THEN
            replacement_col = ((compilerRegexPosition(give_prefix_value) - compilerRegexCapture(give_prefix_value, 0).codepointCount()) + 1);
            replacement_length = (replacement_length + compilerRegexCapture(give_prefix_value, 0).codepointCount());
          END
        END
        MUTABLE fixes = List[];
        &fixes.append(TRY (fix__new(TRY (typeAnalysisSession__fix_description(rtoc_self_view, consumer_description_code, CAST({:line: (ruby_wrap_optional_Int64_DiagnosticKwValue__type_analysis_session(og_node.move_line) OR_ELSE DiagnosticKwValue{ StringValue: COPY "" })} AS {String@symbol}DiagnosticKwValue))), [edit__new(span__new(NIL, move_line_value, UNWRAP (replacement_col), replacement_length), "(${consumer_keyword} ${name})")], :interactive)));
        MUTABLE candidate_caps = List[];
        IF !((is_multi OR is_split)) THEN
          &candidate_caps.append("@multiowned");
        END
        IF !((is_shared OR is_split)) THEN
          &candidate_caps.append("@shared");
        END
        MUTABLE consumed_by_call = ((og_node.move_action == :takes) OR (og_node.move_action == :give));
        IF (TRUE AND consumed_by_call) THEN
          MUTABLE pt: ?TypeTypeInput = COPY og_node.move_consumer_param_type;
          IF ((pt != NIL) AND !(pt IS_A Type)) THEN
            pt = castTypeToTypeTypeInput__type_analysis_session(TRY (type__new(castTypeTypeInputToTypeConstructionInput__type_analysis_session(pt))));
          END
          MUTABLE param_admits_shared = ((pt != NIL) AND (IF (typeTypeInput__shared?(pt) != NIL) THEN
            type__shared?(UNWRAP (castTypeTypeInputToType(pt)))
          ELSE
            FALSE
          END));
          MUTABLE param_admits_multi = ((pt != NIL) AND (typeTypeInput__multiowned?(pt) OR_ELSE FALSE));
          IF (((pt != NIL) AND !(param_admits_shared)) AND !(param_admits_multi)) THEN
            candidate_caps = candidate_caps |> WHERE ((_ != "@shared") AND (_ != "@multiowned"));
          END
        END
        MUTABLE scope: ?Scope@multiowned = TRY (typeAnalysisSession__lookup_scope_for(&rtoc_self_view, name));
        MUTABLE decl: ?SymbolEntryRegInput = NIL;
        IF scope EXISTS AS rtoc_scope_value THEN
          IF scope__resolve_entry(rtoc_scope_value, name) EXISTS AS rtoc_entry_value THEN
            decl = COPY rtoc_entry_value.reg;
          END
        END
        src = typeAnalysisSession__source_code(&rtoc_self_view);
        IF (((decl != NIL) AND TRUE) AND (src != NIL)) THEN
          MUTABLE rtoc_decl_tok_1795: Token = aST__node__token(castSymbolEntryRegInputToLocatable(decl));
          MUTABLE dline: Int64 = rtoc_decl_tok_1795.line;
          MUTABLE line_text = (src.split("\n")[(dline - 1)] OR_ELSE "");
          MUTABLE semi_idx: ?Int64 = line_text.indexOf(";", (rtoc_decl_tok_1795.column - 1));
          IF semi_idx EXISTS AS semi_idx_value THEN
            MUTABLE insert_col = (semi_idx_value + 1);
            FOR _ IN candidate_caps DO
    MUTABLE reason = "atomic Arc; safe across fibers";
    IF (_ == "@multiowned") THEN
                reason = "single-scheduler Rc; automatic clone on move";
    END
    &fixes.append(TRY (fix__new(TRY (typeAnalysisSession__fix_description(rtoc_self_view, :CHANGE_BINDING_CAPABILITY_FOR_MOVE, CAST({:name: DiagnosticKwValue{ StringValue: COPY name }, :cap: DiagnosticKwValue{ StringValue: COPY _ }, :reason: DiagnosticKwValue{ StringValue: COPY reason }} AS {String@symbol}DiagnosticKwValue))), [edit__new(span__new(NIL, dline, insert_col, 0), " ${_}")], :interactive)));
            END
          END
        END
        MUTABLE consumer: ?String = typeAnalysisSession__consumer_source_text(&rtoc_self_view, move_line_value);
        MUTABLE phrase = typeAnalysisSession__ownership_active_phrase(&rtoc_self_view, (og_node.move_action OR_ELSE :move));
        MUTABLE msg = "";
        IF consumer EXISTS AS consumer_value THEN
          msg = "USE AFTER MOVE: You can't use `${name}`. `${consumer_value}` ${phrase} (line ${move_line_value.toString()}).";
        ELSE
          msg = "USE AFTER MOVE: You can't use `${name}` \u{2014} it ${phrase} (line ${move_line_value.toString()}).";
        END
        TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ Identifier: COPY use_node } }, :ownership, fixes, NIL, :USE_OF_MOVED_VALUE, :error, TRUE, CAST({:detail: msg} AS {String@symbol}Any)));
      ELSE
        MUTABLE msg = "USE AFTER MOVE: You can't use `${name}`.";
        RETURN TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ Identifier: COPY use_node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :USE_OF_MOVED_VALUE }, [], CAST({:detail: msg} AS {String@symbol}Any)));
      END
    ELSE
      msg = "USE AFTER MOVE: You can't use `${name}`.";
      RETURN TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ Identifier: COPY use_node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :USE_OF_MOVED_VALUE }, [], CAST({:detail: msg} AS {String@symbol}Any)));
    END
}
END
PRIVATE FN typeAnalysisSession__emit_carrier_fanout_error_mut(MUTABLE self: TypeAnalysisSession, use_node: Identifier, og_node: OwnershipNode, name: String, move_line: Int64, move_col: Int64) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE consumer: ?String = typeAnalysisSession__consumer_source_text(&rtoc_self_view, move_line);
    MUTABLE consumer_clause: String = "";
    IF consumer EXISTS AS consumer_value THEN
      consumer_clause = "`${consumer_value}` consumes it (line ${move_line.toString()})";
    ELSE
      consumer_clause = "it is consumed (line ${move_line.toString()})";
    END
    MUTABLE msg = "`${name}` is used again after ${consumer_clause}. `${name}` is a carrier-polymorphic parameter; choose how the additional owner is created: wrap the first consuming use as KEEP to preserve the caller's ownership model. If both consumers require independent identity, constrain the parameter as UNIQUE and use COPY.";
    MUTABLE fixes = [TRY (fix__new(TRY (typeAnalysisSession__fix_description(rtoc_self_view, :WRAP_CONSUMER_WITH_KEEP, CAST({:line: DiagnosticKwValue{ Int64Value: move_line }} AS {String@symbol}DiagnosticKwValue))), [edit__new(span__new(NIL, move_line, move_col, name.codepointCount()), "(KEEP ${name})")], :interactive))];
    TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ Identifier: COPY use_node } }, :ownership, fixes, NIL, :CARRIER_POLYMORPHIC_FANOUT, :error, TRUE, CAST({:detail: msg} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__emit_use_of_moved_in_loop_error_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: Node, name: String, og_node: ?OwnershipNode = NIL, code: String@symbol = :USE_OF_MOVED_IN_LOOP) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE loop_move_line: ?Int64 = og_node?.move_line;
    MUTABLE consumer: ?String = NIL;
    IF loop_move_line EXISTS THEN
      consumer = typeAnalysisSession__consumer_source_text(&rtoc_self_view, loop_move_line);
    END
    MUTABLE consumer_clause: String = "";
    IF consumer EXISTS AS consumer_value THEN
      consumer_clause = "`${consumer_value}` already TOOK it. ";
    ELSE
      consumer_clause = "";
    END
    MUTABLE msg = "USE AFTER MOVE: You can't use `${name}` here \u{2014} ${consumer_clause}Values can only be TAKEN once; subsequent iterations have nothing left to GIVE.";
    TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castNodeToLocatable(node)), TypeAnalysisCodeOrMessage{ SymbolValue: COPY code }, [], CAST({:detail: msg} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__emit_use_of_moved_path_error_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: GetField, path: []NameCandidate, og_node: ?OwnershipNode = NIL) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE path_str = (path |> SELECT nameCandidate__to_s(_)).join(".");
    MUTABLE root = COPY CAST(path.first() AS String);
    MUTABLE msg: String = "";
    IF ((og_node != NIL) AND (og_node.move_line != NIL)) THEN
      MUTABLE phrase = typeAnalysisSession__ownership_passive_phrase(&rtoc_self_view, (og_node.move_action OR_ELSE :move));
      msg = "USE AFTER MOVE: You can't use `${path_str}`. Its owner `${root}` ${phrase} on line ${UNWRAP (og_node.move_line).toString()}.";
    ELSE
      msg = "USE AFTER MOVE: You can't use `${path_str}`. Its owner `${root}` was already consumed elsewhere.";
    END
    TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ GetField: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :USE_OF_MOVED_PATH }, [], CAST({:detail: msg} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__ownership_active_phrase(MUTABLE self: TypeAnalysisSession, action: String@symbol) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (CAST({:give: "already GAVE it away", :takes: "already TOOK it away", :return: "already RETURNED it", :next: "already consumed it via NEXT", :share: "already SHARED it", :collect: "already COLLECTED it", :capture: "already captured it", :move: "already MOVED it"} AS {String@symbol}String))[action] != NIL THEN
    RETURN COPY ((CAST({:give: "already GAVE it away", :takes: "already TOOK it away", :return: "already RETURNED it", :next: "already consumed it via NEXT", :share: "already SHARED it", :collect: "already COLLECTED it", :capture: "already captured it", :move: "already MOVED it"} AS {String@symbol}String))[action])?;
    ELSE
    RETURN COPY "already consumed it";
    END
}
END
PRIVATE FN typeAnalysisSession__ownership_passive_phrase(MUTABLE self: TypeAnalysisSession, action: String@symbol) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (CAST({:give: "was already GIVEN away", :takes: "was already TAKEN away", :return: "was already RETURNED", :next: "was already consumed via NEXT", :share: "was already SHARED", :collect: "was already COLLECTED", :capture: "was already captured", :move: "was already MOVED"} AS {String@symbol}String))[action] != NIL THEN
    RETURN COPY ((CAST({:give: "was already GIVEN away", :takes: "was already TAKEN away", :return: "was already RETURNED", :next: "was already consumed via NEXT", :share: "was already SHARED", :collect: "was already COLLECTED", :capture: "was already captured", :move: "was already MOVED"} AS {String@symbol}String))[action])?;
    ELSE
    RETURN COPY "was already consumed";
    END
}
END
PRIVATE FN typeAnalysisSession__consumer_source_text(MUTABLE self: TypeAnalysisSession, line_num: Int64) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE src: ?String = typeAnalysisSession__source_code(&rtoc_self_view);
    IF src EXISTS AS src_value THEN
      IF line_num THEN
        MUTABLE line: ?String = COPY src_value.split("\n")[(line_num - 1)];
        IF line EXISTS AS line_value THEN
          MUTABLE text = line_value.trim();
          text = compilerStringChomp(text, ";").trim();
          IF (text.length() == 0) THEN
            RETURN NIL;
          ELSE
            RETURN text;
          END
        ELSE
          RETURN NIL;
        END
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__smallest_fitting_int_type(MUTABLE self: TypeAnalysisSession, val: Int64) RETURNS ?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE order = fixableHelpers__unsigned_order();
    IF !((val >= 0)) THEN
      order = fixableHelpers__signed_order();
    END
    MUTABLE selected: ?String@symbol = NIL;
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < order.length() DO
      IF selected THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE max: ?Int64 = (CAST({:Byte: 255, :UInt8: 255, :UInt16: 65535, :UInt32: 4294967295, :UInt64: (((2 ** 64)) - 1), :Int8: 127, :Int16: 32767, :Int32: 2147483647, :Int64: 9223372036854775807} AS {String@symbol}Int64))[order[rtoc_idx]];
      IF (max == NIL) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE min = ((CAST({:Byte: 0, :UInt8: 0, :UInt16: 0, :UInt32: 0, :UInt64: 0, :Int8: -128, :Int16: -32768, :Int32: -2147483648, :Int64: (-9223372036854775807 - 1)} AS {String@symbol}Int64))[order[rtoc_idx]] OR_ELSE 0);
      IF ((val >= min) AND (val <= max)) THEN
          selected = order[rtoc_idx];
      END
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN selected;
}
END
PRIVATE FN typeAnalysisSession__annotation_type_column(MUTABLE self: TypeAnalysisSession, prefix: String, target_name: String) RETURNS ?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE idx = 0;
    MUTABLE found: ?Int64 = NIL;
    WHILE (idx < prefix.codepointCount()) DO
      MUTABLE colon: ?Int64 = prefix.indexOf(":", idx);
      IF colon EXISTS AS colon_value THEN
        MUTABLE type_start = (colon_value + 1);
        WHILE ((type_start < prefix.codepointCount()) AND typeAnalysisSession__whitespace_char?(&rtoc_self_view, prefix.substr(type_start, 1))) DO
          type_start = (type_start + 1);
        END
        MUTABLE type_end = (type_start + target_name.codepointCount());
        IF ((prefix.substr(type_start, target_name.codepointCount()) == target_name) AND !(typeAnalysisSession__identifier_char_at?(&rtoc_self_view, prefix, type_end))) THEN
          found = (type_start + 1);
        END
        idx = (colon_value + 1);
      ELSE
        idx = prefix.codepointCount();
      END
    END
    RETURN found;
}
END
PRIVATE FN typeAnalysisSession__whitespace_char?(MUTABLE self: TypeAnalysisSession, ch: ?String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN ((ch == " ") OR (ch == "\t"));
}
END
PRIVATE FN typeAnalysisSession__identifier_char_at?(MUTABLE self: TypeAnalysisSession, text: String, idx: Int64) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (idx >= text.codepointCount()) THEN
      RETURN FALSE;
    END
    MUTABLE ch = text.substr(idx, 1);
    RETURN ((((((ch >= "A") AND (ch <= "Z"))) OR (((ch >= "a") AND (ch <= "z")))) OR (((ch >= "0") AND (ch <= "9")))) OR (ch == "_"));
}
END
PRIVATE FN typeAnalysisSession__emit_int_overflow_error_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: Literal, val: Int64, target_type: String@symbol, min_value: Int64, max_value: Int64) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE src: ?String = typeAnalysisSession__source_code(&rtoc_self_view);
    MUTABLE tok = COPY node.token;
    IF !((TRUE AND (src != NIL))) THEN
      RETURN TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ Literal: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :INT_LITERAL_OVERFLOW }, [], CAST({:val: val, :type: target_type, :min: min_value, :max: max_value} AS {String@symbol}Any)));
    END
    MUTABLE best: ?String@symbol = typeAnalysisSession__smallest_fitting_int_type(&rtoc_self_view, val);
    IF best EXISTS AS best_value THEN
      MUTABLE line_text = (src.split("\n")[(tok.line - 1)] OR_ELSE "");
      MUTABLE snippet = line_text.substr(((tok.column - 1)), (line_text.length() - ((tok.column - 1))));
      MUTABLE m: ?CompilerRegexScanner = compilerRegexMatchData(snippet, compilerRegexCompile("\\A(\\d[\\d_]*)_([a-z]\\d+)"));
      IF m EXISTS AS m_value THEN
        MUTABLE old_suffix = COPY compilerRegexCapture(m_value, 2);
        MUTABLE new_suffix: ?String = COPY (CAST({:Int8: "i8", :Byte: "u8", :Int16: "i16", :UInt16: "u16", :Int32: "i32", :UInt32: "u32", :Int64: "i64", :UInt64: "u64"} AS {String@symbol}String))[best_value];
        IF ((new_suffix != NIL) AND (new_suffix != old_suffix)) THEN
          MUTABLE suffix_col = ((tok.column + compilerRegexCapture(m_value, 1).codepointCount()) + 1);
          RETURN TRY (typeAnalysisSession__emit_overflow_suffix_fix_mut(&rtoc_self_view, Locatable{ Literal: COPY node }, target_type, min_value, max_value, tok, suffix_col, old_suffix, new_suffix, val));
        END
      END
      MUTABLE target_name = COPY CAST(target_type AS String);
      MUTABLE prefix = line_text.substr(0, (((tok.column - 1)) - 0));
      MUTABLE ann_col: ?Int64 = typeAnalysisSession__annotation_type_column(&rtoc_self_view, prefix, target_name);
      IF ann_col EXISTS AS ann_col_value THEN
        MUTABLE new_type = COPY CAST(best_value AS String);
        IF (new_type != target_name) THEN
          MUTABLE fix = TRY (fix__new(TRY (typeAnalysisSession__fix_description(rtoc_self_view, :WIDEN_INT_ANNOTATION, CAST({:old_type: DiagnosticKwValue{ StringValue: COPY target_name }, :new_type: DiagnosticKwValue{ StringValue: COPY new_type }, :value: DiagnosticKwValue{ Int64Value: val }} AS {String@symbol}DiagnosticKwValue))), [edit__new(span__new(NIL, tok.line, ann_col_value, target_name.codepointCount()), new_type)], :auto));
          RETURN TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ Literal: COPY node } }, :type, [fix], NIL, :INT_LITERAL_OVERFLOW, :error, TRUE, CAST({:val: val, :type: target_type, :min: min_value, :max: max_value} AS {String@symbol}Any)));
        END
      END
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ Literal: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :INT_LITERAL_OVERFLOW }, [], CAST({:val: val, :type: target_type, :min: min_value, :max: max_value} AS {String@symbol}Any)));
    ELSE
      RETURN TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ Literal: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :INT_LITERAL_OVERFLOW }, [], CAST({:val: val, :type: target_type, :min: min_value, :max: max_value} AS {String@symbol}Any)));
    END
}
END
PRIVATE FN typeAnalysisSession__emit_overflow_suffix_fix_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: Locatable, target_type: String@symbol, min_value: Int64, max_value: Int64, tok: Token, suffix_col: Int64, old_suffix: String, new_suffix: String, val: Int64) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fix = TRY (fix__new(TRY (typeAnalysisSession__fix_description(rtoc_self_view, :WIDEN_INT_SUFFIX, CAST({:old_suffix: DiagnosticKwValue{ StringValue: COPY old_suffix }, :new_suffix: DiagnosticKwValue{ StringValue: COPY new_suffix }, :value: DiagnosticKwValue{ Int64Value: val }} AS {String@symbol}DiagnosticKwValue))), [edit__new(span__new(NIL, tok.line, suffix_col, old_suffix.codepointCount()), new_suffix)], :auto));
    TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY node }, :type, [fix], NIL, :INT_LITERAL_OVERFLOW, :error, TRUE, CAST({:val: val, :type: target_type, :min: min_value, :max: max_value} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__emit_local_never_shared_finding_mut(MUTABLE self: TypeAnalysisSession, info: BindingAuditRecord) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE name = COPY info.var;
    MUTABLE line: ?Int64 = info.line;
    MUTABLE fixes = List[];
    MUTABLE source: ?String = typeAnalysisSession__source_code(&rtoc_self_view);
    IF ((source != NIL) AND (line != NIL)) THEN
      MUTABLE src_line = (source.split("\n")[(line - 1)] OR_ELSE "");
      MUTABLE idx: ?Int64 = src_line.indexOf("@local", (((info.column OR_ELSE 1)) - 1));
      IF idx EXISTS AS idx_value THEN
        MUTABLE trail = IF ((src_line.substr((idx_value + 6), 1) == " ")) THEN
          1
        ELSE
          0
        END;
        MUTABLE lead = IF (((idx_value > 0) AND (src_line.substr((idx_value - 1), 1) == " "))) THEN
          1
        ELSE
          0
        END;
        MUTABLE start_col = ((idx_value + 1) - lead);
        MUTABLE length = ((6 + lead) + trail);
        &fixes.append(TRY (fix__new(TRY (typeAnalysisSession__fix_description(rtoc_self_view, :REMOVE_LOCAL_CAPABILITY, CAST({:name: DiagnosticKwValue{ StringValue: COPY name }} AS {String@symbol}DiagnosticKwValue))), [edit__new(span__new(NIL, line, start_col, length), "")], :auto)));
      END
    END
    MUTABLE anchor_branch_value: ?AnchorToken = NIL;
    IF line EXISTS AS line_value THEN
      anchor_branch_value = typeAnalysisSession__anchor_at(&rtoc_self_view, line_value, (info.column OR_ELSE 1));
    ELSE
      anchor_branch_value = NIL;
    END
    MUTABLE anchor: ?AnchorToken = anchor_branch_value;
    TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, (IF anchor EXISTS AS rtoc_wrap_2092 THEN DiagnosticAnchor{ AnchorTokenValue: COPY rtoc_wrap_2092 } ELSE NIL END), :lint, fixes, NIL, :LOCAL_NEVER_SHARED, :info, FALSE, CAST({:name: name} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__emit_immutable_assignment_error_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: BindExpr, scope: Scope) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fix: ?Fix@multiowned = TRY (typeAnalysisSession__build_declare_mutable_fix(&rtoc_self_view, node.name, scope));
    IF fix EXISTS AS fix_value THEN
      TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ BindExpr: COPY node } }, :ownership, [fix_value], NIL, :IMMUTABLE_ASSIGNMENT, :error, FALSE, CAST({:name: node.name} AS {String@symbol}Any)));
    ELSE
      RETURN TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ BindExpr: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :IMMUTABLE_ASSIGNMENT }, [], CAST({:name: node.name} AS {String@symbol}Any)));
    END
}
END
PRIVATE FN typeAnalysisSession__emit_immutable_arg_error_mut(MUTABLE self: TypeAnalysisSession, arg_node: Identifier, scope: Scope, arg_idx: Int64, param_name: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fix: ?Fix@multiowned = TRY (typeAnalysisSession__build_declare_mutable_fix(&rtoc_self_view, arg_node.name, scope));
    MUTABLE kw = CAST({:index: arg_idx, :param: param_name, :actual: arg_node.name} AS {String@symbol}Any);
    IF fix EXISTS AS fix_value THEN
      TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ Identifier: COPY arg_node } }, :ownership, [fix_value], NIL, :IMMUTABLE_ARG_PASSED_AS_MUTABLE, :error, TRUE, kw));
    ELSE
      RETURN TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ Identifier: COPY arg_node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :IMMUTABLE_ARG_PASSED_AS_MUTABLE }, [], kw));
    END
}
END
PRIVATE FN typeAnalysisSession__emit_missing_mutable_marker_error_mut(MUTABLE self: TypeAnalysisSession, facts: CallArgumentFacts, scope: Scope) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE arg = COPY facts.arg_node;
    MUTABLE root: ?Identifier = aST__root_identifier(arg);
    IF root EXISTS AS root_value THEN
      MUTABLE edits: []Edit = [edit__new(span__new(NIL, root_value.token.line, root_value.token.column, 0), "&")];
      MUTABLE mutable_fix: ?Fix@multiowned = TRY (typeAnalysisSession__build_declare_mutable_fix(&rtoc_self_view, root_value.name, scope));
      IF (scope__is_immutable?(scope, root_value.name) AND (mutable_fix != NIL)) THEN
        edits = ruby_array_concat_Edit__type_analysis_session(edits, mutable_fix.edits);
      END
      MUTABLE fix = TRY (fix__new(TRY (typeAnalysisSession__fix_description(rtoc_self_view, :INSERT_MUTABLE_ARGUMENT_MARKER, CAST({:name: DiagnosticKwValue{ StringValue: COPY root_value.name }, :param: DiagnosticKwValue{ StringValue: COPY facts.param.name }} AS {String@symbol}DiagnosticKwValue))), edits, :auto));
      TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ Identifier: COPY root_value } }, :mutability, [fix], NIL, :MUTABLE_ARGUMENT_REQUIRES_MARKER, :error, FALSE, CAST({:index: (facts.index + 1), :param: facts.param.name, :actual: root_value.name} AS {String@symbol}Any)));
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__emit_unexpected_mutable_argument_error_mut(MUTABLE self: TypeAnalysisSession, facts: CallArgumentFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE token: ?Token@multiowned = COPY facts.mutable_marker_token;
    IF token EXISTS AS token_value THEN
      MUTABLE fix = TRY (fix__new(TRY (typeAnalysisSession__fix_description(rtoc_self_view, :REMOVE_MUTABLE_ARGUMENT_MARKER, CAST({:param: DiagnosticKwValue{ StringValue: COPY facts.param.name }} AS {String@symbol}DiagnosticKwValue))), [edit__new(span__new(NIL, token_value.line, token_value.column, 1), "")], :auto));
      TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ TokenValue: COPY token_value }, :mutability, [fix], NIL, :MUTABLE_MARKER_ON_IMMUTABLE_PARAM, :error, FALSE, CAST({:index: (facts.index + 1), :param: facts.param.name} AS {String@symbol}Any)));
    ELSE
      RETURN TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY facts.arg_node }, TypeAnalysisCodeOrMessage{ SymbolValue: :MUTABLE_MARKER_ON_IMMUTABLE_PARAM }, [], CAST({:index: (facts.index + 1), :param: facts.param.name} AS {String@symbol}Any)));
    END
}
END
