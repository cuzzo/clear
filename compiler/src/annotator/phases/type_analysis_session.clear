    SourceNode.StaticCall AS cast_payload -> RETURN Node{ StaticCall: COPY cast_payload };,
    SourceNode.ThenChain AS cast_payload -> RETURN Node{ ThenChain: COPY cast_payload };,
    SourceNode.BgStreamBlock AS cast_payload -> RETURN Node{ BgStreamBlock: COPY cast_payload };,
    SourceNode.YieldExpr AS cast_payload -> RETURN Node{ YieldExpr: COPY cast_payload };,
    SourceNode.CloseStream AS cast_payload -> RETURN Node{ CloseStream: COPY cast_payload };,
    SourceNode.NextExpr AS cast_payload -> RETURN Node{ NextExpr: COPY cast_payload };,
    SourceNode.MatchStatement AS cast_payload -> RETURN Node{ MatchStatement: COPY cast_payload };,
    SourceNode.ForRange AS cast_payload -> RETURN Node{ ForRange: COPY cast_payload };,
    SourceNode.ForEach AS cast_payload -> RETURN Node{ ForEach: COPY cast_payload };,
    SourceNode.TestBlock AS cast_payload -> RETURN Node{ TestBlock: COPY cast_payload };,
    SourceNode.WhenBlock AS cast_payload -> RETURN Node{ WhenBlock: COPY cast_payload };,
    SourceNode.LetBinding AS cast_payload -> RETURN Node{ LetBinding: COPY cast_payload };,
    SourceNode.TestThat AS cast_payload -> RETURN Node{ TestThat: COPY cast_payload };,
    SourceNode.AssertRaises AS cast_payload -> RETURN Node{ AssertRaises: COPY cast_payload };,
    SourceNode.BenchmarkStmt AS cast_payload -> RETURN Node{ BenchmarkStmt: COPY cast_payload };,
    SourceNode.SmashStmt AS cast_payload -> RETURN Node{ SmashStmt: COPY cast_payload };,
    SourceNode.ProfileStmt AS cast_payload -> RETURN Node{ ProfileStmt: COPY cast_payload };,
    SourceNode.StubDecl AS cast_payload -> RETURN Node{ StubDecl: COPY cast_payload };,
    SourceNode.Drop AS cast_payload -> RETURN Node{ Drop: COPY cast_payload };,
    SourceNode.SuppressCleanup AS cast_payload -> RETURN Node{ SuppressCleanup: COPY cast_payload };,
    SourceNode.Return AS cast_payload -> RETURN Node{ Return: COPY cast_payload };,
    SourceNode.ReassignCleanup AS cast_payload -> RETURN Node{ ReassignCleanup: COPY cast_payload };,
    SourceNode.FieldCleanup AS cast_payload -> RETURN Node{ FieldCleanup: COPY cast_payload };,
