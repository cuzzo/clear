PRIVATE FN typeAnalysisSession__reject_keep_on_known_carrier_mut(self: TypeAnalysisSession, node: KeepNode) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE root = typeAnalysisSession__get_root_object(rtoc_self_view, node.value);
    IF root IS_A Identifier AS identifier THEN
      MUTABLE entry: ?SymbolEntry = identifier.symbol;
      IF !((entry != NIL)) THEN
        RETURN NIL;
      END
      IF symbolEntry__non_escaping(entry) THEN
        RETURN NIL;
      END
      MUTABLE ty = &node.value.full_type_mut("KEEP carrier");
      MUTABLE retained = (ty IS_A Type AND ((((TRY (type__any_rc?(ty)) OR TRY (type__split_open_stream?(ty))) OR ty.shared_promise?()) OR type__split?(ty))));
      MUTABLE carrier: String = "";
      IF (symbolEntry__is_param(entry) AND (symbolEntry__carrier_contract(entry) == :unique)) THEN
        carrier = "UNIQUE parameter";
      ELSE_IF ((!(symbolEntry__is_param(entry)) AND !(symbolEntry__carrier_polymorphic(entry))) AND !(retained)) THEN
        carrier = "plain local";
      ELSE
        carrier = "";
      END
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :KEEP_ON_KNOWN_CARRIER }, [], {:name: identifier__name(identifier), :carrier: carrier});
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__finish_previsited_keep_mut(self: TypeAnalysisSession, MUTABLE node: KeepNode) RETURNS !?Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE type = &node.value.full_type_mut("KEEP value");
    MUTABLE root = typeAnalysisSession__get_root_object(rtoc_self_view, node.value);
    MUTABLE retained_projection = ((type IS_A Type AND TRY (type__any_rc?(type))) AND (node.value != root));
    IF ((IF root IS_A Identifier AS identifier THEN ((identifier.symbol != NIL) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_472 = ((identifier.symbol)?);
    symbolEntry__non_escaping(rtoc_local_receiver_472) }) ELSE FALSE END) AND !(retained_projection)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :KEEP_WITH_SCOPED }, [], {:name: root.name()});
    END
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ KeepNode: COPY node }, &node.value.full_type_mut("KEEP result")));
    IF respondsTo?(node.value, "storage") THEN
      node.storage = node.value.storage();
    END
    IF (IF type != NIL THEN
      TRY (type__any_rc?(type))
    ELSE
      NIL
    END) THEN
      IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
            MUTABLE rtoc_mutable_receiver_473 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
            functionContext__mark_runtime_used_mut(&rtoc_mutable_receiver_473);
      END
    END
    typeAnalysisSession__stamp_keep_carrier_op_mut(rtoc_self_view, &node, type, root);
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__stamp_keep_carrier_op_mut(self: TypeAnalysisSession, MUTABLE node: KeepNode, type: ?Type, root: Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF ((IF root IS_A Identifier AS identifier THEN (identifier.symbol != NIL) ELSE FALSE END) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_474 = root.symbol();
    symbolEntry__carrier_polymorphic(rtoc_local_receiver_474) }) THEN
      node.carrier_op = IF ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_475 = root.symbol();
      symbolEntry__carrier_contract(rtoc_local_receiver_475) } == :monomorphic) THEN
        :monomorphic_keep
      ELSE
        :deferred_specialization
      END;
      RETURN;
    END
    IF !((type != NIL)) THEN
      RETURN;
    END
    MUTABLE carrier =   IF type__multiowned?(type) THEN
      :multiowned
    ELSE_IF type__shared?(type) THEN
      :shared
    ELSE_IF (((!(TRY (type__any_rc?(type))) AND !(TRY (type__split_open_stream?(type)))) AND !(type__shared_promise?(type))) AND !(type__split?(type))) THEN
      :plain
    ELSE
      NIL
    END;
    node.carrier_op = (TRY (ownershipEdgePlanner__select(carrier, :keep))).op();
}
END
PRIVATE FN typeAnalysisSession__visit_ShareNode(MUTABLE self: TypeAnalysisSession, MUTABLE node: ShareNode) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.value));
    MUTABLE source_type = &node.value.full_type_mut("SHARE value");
