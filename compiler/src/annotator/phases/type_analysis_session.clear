PUB FN typeAnalysisSession__with_match_family_effects(self: TypeAnalysisSession, family: String@symbol) RETURNS ![]String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (family == :LOCKED) THEN
      RETURN CAST([symbol("BLOCKING"), symbol("CONTENTION"), symbol("SUSPENDS")] AS []String@symbol);
    ELSE_IF (family == :VERSIONED) OR (family == :ATOMIC) THEN
      RETURN CAST([symbol("CONTENTION")] AS []String@symbol);
    ELSE
      RETURN CAST(( { MUTABLE rtoc_empty_list_4: []String@symbol = List[]; rtoc_empty_list_4 } ) AS []String@symbol);
    END
}
END
PUB FN typeAnalysisSession__with_held_locks<Result>(MUTABLE self: TypeAnalysisSession, node: WithBlock, lock_capabilities: []CapabilityTransition, blk: FN() -> Result) RETURNS Result
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE previous_locks = COPY rtoc_self_view.audit_inputs.held_locks;
  MUTABLE previous_types = COPY rtoc_self_view.audit_inputs.held_lock_types;
  DEFER {
  rtoc_self_view.audit_inputs.held_locks = previous_locks;
  rtoc_self_view.audit_inputs.held_lock_types = previous_types;
  }
  rtoc_self_view.audit_inputs.held_locks = COPY previous_locks;
  rtoc_self_view.audit_inputs.held_lock_types = COPY previous_types;
  MUTABLE opted_out = !((node.deadlock_escape == NIL));
  FOR _ IN lock_capabilities DO
    MUTABLE variable_name = COPY _.var_name;
    MUTABLE token = _.var_aST__node__token(node);
    rtoc_self_view.audit_inputs.held_locks[variable_name] = (rtoc_self_view.audit_inputs.held_locks[variable_name] OR_ELSE HeldLockEntry{ token: token });
    MUTABLE lock_type: ?String@symbol = capabilityTransition__lock_identity(_);
    IF lock_type EXISTS AS lock_type_value THEN
        RETURN &rtoc_self_view.audit_inputs.held_lock_types.append(COPY HeldLockTypeEntry{ type: COPY lock_type_value, opted_out: opted_out });
    END
  END
  RETURN blk();
}
END
PUB FN typeAnalysisSession__with_snapshot_transaction_body<Result>(self: TypeAnalysisSession, node: WithBlock, blk: FN() -> Result) RETURNS !Result
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
  MUTABLE frame = SnapshotTxnFrame{ violations: List[] };
  DEFER {
  MUTABLE popped: ?SnapshotTxnFrame = &rtoc_self_view.audit_inputs.snapshot_txn_frames.pop();
  IF ((popped != NIL) AND !(popped.equal?(frame))) THEN
      panic("BUG: snapshot transaction frame mismatch");
  END
  }
  &rtoc_self_view.audit_inputs.snapshot_txn_frames.append(COPY frame);
  MUTABLE result = blk();
  MUTABLE txn_violations = COPY frame.violations;
  IF !((txn_violations.length() == 0)) THEN
      MUTABLE kinds = (CAST(((txn_violations |> SELECT effectTracker__display(_.effect)) |> DISTINCT _) AS []String)).join(", ");
      RETURN typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_SNAPSHOT_BODY_NOT_PURE }, [], {:kinds: kinds});
  END
  RETURN result;
}
END
