      rtoc_ternary_value_517 = TRY (type__new(castTypeTypeInputToTypeConstructionInput__type_analysis_session(type_info)));
    END
    rtoc_ternary_value_517? };
    MUTABLE line: ?Int64 = aST__node__token(UNWRAP (castNodeToLocatable(UNWRAP (node)))).line;
    RETURN { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_518 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
    TRY (ownershipGraph__declare(&rtoc_mutable_receiver_518, name, kind, UNWRAP (castTypeTypeInputToType(ti)), typeAnalysisSession__ownership_graph(&rtoc_self_view).scope_depth, UNWRAP (line))) };
}
END
PRIVATE FN typeAnalysisSession__share_consumes_source?(MUTABLE self: TypeAnalysisSession, MUTABLE node: Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node IS_A CopyNode AS copy_node THEN
      RETURN FALSE;
