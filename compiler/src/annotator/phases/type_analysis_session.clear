FN castTypeAnalysisRegToLocatable(value: TypeAnalysisReg) RETURNS ?Locatable ->
  PARTIAL MATCH value START
    TypeAnalysisReg.VarDecl AS item -> RETURN Locatable{ VarDecl: COPY item };,
    TypeAnalysisReg.DestructureTarget AS item -> RETURN Locatable{ DestructureTarget: COPY item };,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
# Ruby asks `respond_to?(:value)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN declNode__value(value: DeclNode) RETURNS ?Locatable@boxed ->
  PARTIAL MATCH value START
    DeclNode.VarDecl AS item -> RETURN COPY item.value;,
    DeclNode.BindExpr AS item -> RETURN COPY item.value;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
# Ruby asks `respond_to?(:call_site_facts)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN typeAnalysisBodyFacts__call_site_facts(value: TypeAnalysisBodyFacts) RETURNS ?[]CallSiteFact ->
  PARTIAL MATCH value START
    TypeAnalysisBodyFacts.BodyScanSummary AS item -> RETURN COPY item.call_site_facts;,
    TypeAnalysisBodyFacts.FunctionBodySummary AS item -> RETURN COPY item.call_site_facts;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
# Ruby asks `respond_to?(:return_nodes)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN typeAnalysisBodyFacts__return_nodes(value: TypeAnalysisBodyFacts) RETURNS ?[]ReturnNode ->
  PARTIAL MATCH value START
    TypeAnalysisBodyFacts.BodyScanSummary AS item -> RETURN COPY item.return_nodes;,
    TypeAnalysisBodyFacts.FunctionBodySummary AS item -> RETURN COPY item.return_nodes;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
# Ruby writes straight through the accessor; the CLEAR accessor returns a COPY,
# so the write needs a path to the real field. Mirrors the capability audit
# session's setters.
PRIVATE FN typeAnalysisSession__set_direct_effect_mut(MUTABLE self: TypeAnalysisSession, fn_name: String, value: [Set]String@symbol) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF rtoc_self_view.audit_inputs.effect_state EXISTS AS MUTABLE rtoc_state THEN
      rtoc_state.direct_effects[fn_name] = COPY value;
    END
}
END
PRIVATE FN typeAnalysisSession__set_call_site_context_mut(MUTABLE self: TypeAnalysisSession, caller_name: String, value: {String}{String@symbol}Bool) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF rtoc_self_view.audit_inputs.effect_state EXISTS AS MUTABLE rtoc_state THEN
      rtoc_state.call_site_context[caller_name] = COPY value;
    END
}
END
PRIVATE FN typeAnalysisSession__set_call_site_arg_families_mut(MUTABLE self: TypeAnalysisSession, caller_name: String, value: {String}[][][Set]String@symbol) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF rtoc_self_view.audit_inputs.effect_state EXISTS AS MUTABLE rtoc_state THEN
      rtoc_state.call_site_arg_families[caller_name] = COPY value;
    END
}
END
# The schema_lookup callback is declared FN(String@symbol) -> ?TypeSchemaLookupResult
# by every callee. The scope answers with SchemaValue, so the lookup
# is wrapped here rather than at each call site; NIL stays NIL.
PRIVATE FN typeAnalysisSession__schema_lookup_result(MUTABLE self: TypeAnalysisSession, name: String@symbol) RETURNS !?TypeSchemaLookupResult
  REQUIRES self: LOCAL
->
  MUTABLE found: ?SchemaValue = TRY (typeAnalysisSession__lookup_type_schema(&self, name));
  IF found EXISTS AS found_value THEN
    RETURN castSchemaValueToTypeSchemaLookupResult(found_value);
  END
  RETURN NIL;
END
# Ruby asks `respond_to?(:type_params)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN typeAnalysisSchema__type_params(value: TypeAnalysisSchema) RETURNS ?[]String@symbol ->
  PARTIAL MATCH value START
    TypeAnalysisSchema.StructSchemaMultiowned AS item -> RETURN COPY item.type_params;,
    TypeAnalysisSchema.ResourceSchemaMultiowned AS item -> RETURN COPY item.type_params;,
    TypeAnalysisSchema.UnionSchemaMultiowned AS item -> RETURN COPY item.type_params;,
    TypeAnalysisSchema.StructSchema AS item -> RETURN COPY item.type_params;,
    TypeAnalysisSchema.UnionSchema AS item -> RETURN COPY item.type_params;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
FN castTypeAnalysisSessionReturnValueItemToFunctionSignatureLifetimeSource(value: TypeAnalysisSessionReturnValueItem) RETURNS FunctionSignatureLifetimeSource ->
  PARTIAL MATCH value START
    TypeAnalysisSessionReturnValueItem.StringValue AS cast_payload -> RETURN FunctionSignatureLifetimeSource{ SymbolValue: symbol(cast_payload) };,
    TypeAnalysisSessionReturnValueItem.SymbolValue AS cast_payload -> RETURN FunctionSignatureLifetimeSource{ SymbolValue: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to FunctionSignatureLifetimeSource");
  END
  panic("Invalid cast to FunctionSignatureLifetimeSource");
END
# Ruby pushes and pops the session's own frame stack. The reader accessor
# returns a COPY, so mutating THAT is a silent no-op; reach the owned field.
PRIVATE FN typeAnalysisSession__push_body_fact_frame_mut(MUTABLE self: TypeAnalysisSession, frame: BodyFactFrame) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    &rtoc_self_view.traversal_state.body_fact_frames.append(COPY frame);
}
END
PRIVATE FN typeAnalysisSession__pop_body_fact_frame_mut(MUTABLE self: TypeAnalysisSession) RETURNS ?BodyFactFrame
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN &rtoc_self_view.traversal_state.body_fact_frames.pop();
}
END
# The diagnostic entry points take their kwargs as {String@symbol}Any; the
# callers hold a map of DiagnosticKwValue. The single-value cast cannot convert
# a map, so this converts entry by entry.
FN castDiagnosticKwValueMapToAnyMap__type_analysis_session(values: {String@symbol}DiagnosticKwValue) RETURNS {String@symbol}Any ->
  MUTABLE out: {String@symbol}Any = {};
  FOR key IN values.keys() DO
    out[key] = castDiagnosticKwValueToAnyMultiowned__type_analysis_session((values[key] OR_ELSE panic("missing hash key")));
  END
  RETURN out;
END
PUB FN castMapTypeToMapGenericBinding(source: {String}Type) RETURNS {String}GenericBinding ->
  MUTABLE out: {String}GenericBinding = {};
  FOR rtoc_cast_key IN source.keys() DO
    out[rtoc_cast_key] = GenericBinding{ Type: COPY UNWRAP (source[rtoc_cast_key]) };
  END
  RETURN out;
END
PUB FN castMapStringToMapGenericBinding(source: {String}String) RETURNS {String}GenericBinding ->
  MUTABLE out: {String}GenericBinding = {};
  FOR rtoc_cast_key IN source.keys() DO
    out[rtoc_cast_key] = GenericBinding{ SymbolValue: COPY UNWRAP (source[rtoc_cast_key]) };
  END
  RETURN out;
END
# Ruby asks `respond_to?(:source_method_name)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN functionCallNode__source_method_name(value: FunctionCallNode) RETURNS ?String ->
  PARTIAL MATCH value START
    FunctionCallNode.MethodCall AS item -> RETURN COPY item.source_method_name;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
# Ruby asks `respond_to?(:name)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN functionCallNode__name(value: FunctionCallNode) RETURNS ?String ->
  PARTIAL MATCH value START
    FunctionCallNode.MethodCall AS item -> RETURN COPY item.name;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
# 109 of 125 Nodes variants map to Locatable
FN castNodesToLocatable(value: Nodes) RETURNS ?Locatable ->
  PARTIAL MATCH value START
    Nodes.RequireNode AS item -> RETURN Locatable{ RequireNode: COPY item };,
    Nodes.ProtocolRequirement AS item -> RETURN Locatable{ ProtocolRequirement: COPY item };,
    Nodes.ProtocolDef AS item -> RETURN Locatable{ ProtocolDef: COPY item };,
    Nodes.FunctionDef AS item -> RETURN Locatable{ FunctionDef: COPY item };,
    Nodes.ImplementationDef AS item -> RETURN Locatable{ ImplementationDef: COPY item };,
    Nodes.ConformanceDef AS item -> RETURN Locatable{ ConformanceDef: COPY item };,
    Nodes.VarDecl AS item -> RETURN Locatable{ VarDecl: COPY item };,
    Nodes.Assignment AS item -> RETURN Locatable{ Assignment: COPY item };,
    Nodes.DestructuringAssignment AS item -> RETURN Locatable{ DestructuringAssignment: COPY item };,
    Nodes.BindExpr AS item -> RETURN Locatable{ BindExpr: COPY item };,
    Nodes.BinaryOp AS item -> RETURN Locatable{ BinaryOp: COPY item };,
    Nodes.IsA AS item -> RETURN Locatable{ IsA: COPY item };,
    Nodes.CallSiteOverride AS item -> RETURN Locatable{ CallSiteOverride: COPY item };,
    Nodes.Identifier AS item -> RETURN Locatable{ Identifier: COPY item };,
    Nodes.Literal AS item -> RETURN Locatable{ Literal: COPY item };,
    Nodes.ListLit AS item -> RETURN Locatable{ ListLit: COPY item };,
    Nodes.TupleLit AS item -> RETURN Locatable{ TupleLit: COPY item };,
    Nodes.DefaultArrayLit AS item -> RETURN Locatable{ DefaultArrayLit: COPY item };,
    Nodes.HashLit AS item -> RETURN Locatable{ HashLit: COPY item };,
    Nodes.DefaultLit AS item -> RETURN Locatable{ DefaultLit: COPY item };,
    Nodes.StructLit AS item -> RETURN Locatable{ StructLit: COPY item };,
    Nodes.LambdaLit AS item -> RETURN Locatable{ LambdaLit: COPY item };,
    Nodes.IfStatement AS item -> RETURN Locatable{ IfStatement: COPY item };,
    Nodes.IfBind AS item -> RETURN Locatable{ IfBind: COPY item };,
    Nodes.WhileLoop AS item -> RETURN Locatable{ WhileLoop: COPY item };,
    Nodes.WhileBindLoop AS item -> RETURN Locatable{ WhileBindLoop: COPY item };,
    Nodes.BreakNode AS item -> RETURN Locatable{ BreakNode: COPY item };,
    Nodes.ContinueNode AS item -> RETURN Locatable{ ContinueNode: COPY item };,
    Nodes.FuncCall AS item -> RETURN Locatable{ FuncCall: COPY item };,
    Nodes.GetField AS item -> RETURN Locatable{ GetField: COPY item };,
    Nodes.GetIndex AS item -> RETURN Locatable{ GetIndex: COPY item };,
    Nodes.ReturnNode AS item -> RETURN Locatable{ ReturnNode: COPY item };,
    Nodes.Assert AS item -> RETURN Locatable{ Assert: COPY item };,
    Nodes.ThrowNode AS item -> RETURN Locatable{ ThrowNode: COPY item };,
    Nodes.DieNode AS item -> RETURN Locatable{ DieNode: COPY item };,
    Nodes.Slice AS item -> RETURN Locatable{ Slice: COPY item };,
    Nodes.Require AS item -> RETURN Locatable{ Require: COPY item };,
    Nodes.WithBlock AS item -> RETURN Locatable{ WithBlock: COPY item };,
    Nodes.SyncPolicyDecl AS item -> RETURN Locatable{ SyncPolicyDecl: COPY item };,
    Nodes.SelectOp AS item -> RETURN Locatable{ SelectOp: COPY item };,
    Nodes.WhereOp AS item -> RETURN Locatable{ WhereOp: COPY item };,
    Nodes.IndexOp AS item -> RETURN Locatable{ IndexOp: COPY item };,
    Nodes.ReduceOp AS item -> RETURN Locatable{ ReduceOp: COPY item };,
    Nodes.OrderByOp AS item -> RETURN Locatable{ OrderByOp: COPY item };,
    Nodes.LimitOp AS item -> RETURN Locatable{ LimitOp: COPY item };,
    Nodes.UnnestOp AS item -> RETURN Locatable{ UnnestOp: COPY item };,
    Nodes.DistinctOp AS item -> RETURN Locatable{ DistinctOp: COPY item };,
    Nodes.EachOp AS item -> RETURN Locatable{ EachOp: COPY item };,
    Nodes.TapOp AS item -> RETURN Locatable{ TapOp: COPY item };,
    Nodes.SkipOp AS item -> RETURN Locatable{ SkipOp: COPY item };,
    Nodes.CollectOp AS item -> RETURN Locatable{ CollectOp: COPY item };,
    Nodes.TakeWhileOp AS item -> RETURN Locatable{ TakeWhileOp: COPY item };,
    Nodes.WindowOp AS item -> RETURN Locatable{ WindowOp: COPY item };,
    Nodes.BatchWindowOp AS item -> RETURN Locatable{ BatchWindowOp: COPY item };,
    Nodes.JoinOp AS item -> RETURN Locatable{ JoinOp: COPY item };,
    Nodes.FindOp AS item -> RETURN Locatable{ FindOp: COPY item };,
    Nodes.AnyOp AS item -> RETURN Locatable{ AnyOp: COPY item };,
    Nodes.AllOp AS item -> RETURN Locatable{ AllOp: COPY item };,
    Nodes.CountOp AS item -> RETURN Locatable{ CountOp: COPY item };,
    Nodes.SumOp AS item -> RETURN Locatable{ SumOp: COPY item };,
    Nodes.AverageOp AS item -> RETURN Locatable{ AverageOp: COPY item };,
    Nodes.MinOp AS item -> RETURN Locatable{ MinOp: COPY item };,
    Nodes.MaxOp AS item -> RETURN Locatable{ MaxOp: COPY item };,
    Nodes.ShardOp AS item -> RETURN Locatable{ ShardOp: COPY item };,
    Nodes.ConcurrentOp AS item -> RETURN Locatable{ ConcurrentOp: COPY item };,
    Nodes.Placeholder AS item -> RETURN Locatable{ Placeholder: COPY item };,
    Nodes.Copy AS item -> RETURN Locatable{ Copy: COPY item };,
    Nodes.TenseNavigation AS item -> RETURN Locatable{ TenseNavigation: COPY item };,
    Nodes.MutableBorrow AS item -> RETURN Locatable{ MutableBorrow: COPY item };,
    Nodes.CatchBlock AS item -> RETURN Locatable{ CatchBlock: COPY item };,
    Nodes.RecoverOp AS item -> RETURN Locatable{ RecoverOp: COPY item };,
    Nodes.StringConcat AS item -> RETURN Locatable{ StringConcat: COPY item };,
    Nodes.CapabilityWrap AS item -> RETURN Locatable{ CapabilityWrap: COPY item };,
    Nodes.MoveNode AS item -> RETURN Locatable{ MoveNode: COPY item };,
    Nodes.CopyNode AS item -> RETURN Locatable{ CopyNode: COPY item };,
    Nodes.KeepNode AS item -> RETURN Locatable{ KeepNode: COPY item };,
    Nodes.ShareNode AS item -> RETURN Locatable{ ShareNode: COPY item };,
    Nodes.LinkNode AS item -> RETURN Locatable{ LinkNode: COPY item };,
    Nodes.ResolveNode AS item -> RETURN Locatable{ ResolveNode: COPY item };,
    Nodes.FreezeNode AS item -> RETURN Locatable{ FreezeNode: COPY item };,
    Nodes.PassStmt AS item -> RETURN Locatable{ PassStmt: COPY item };,
    Nodes.StructPattern AS item -> RETURN Locatable{ StructPattern: COPY item };,
    Nodes.ExternFnDecl AS item -> RETURN Locatable{ ExternFnDecl: COPY item };,
    Nodes.ExternStructDecl AS item -> RETURN Locatable{ ExternStructDecl: COPY item };,
    Nodes.UnionDef AS item -> RETURN Locatable{ UnionDef: COPY item };,
    Nodes.UnionVariantLit AS item -> RETURN Locatable{ UnionVariantLit: COPY item };,
    Nodes.StaticCall AS item -> RETURN Locatable{ StaticCall: COPY item };,
    Nodes.ThenChain AS item -> RETURN Locatable{ ThenChain: COPY item };,
    Nodes.BgStreamBlock AS item -> RETURN Locatable{ BgStreamBlock: COPY item };,
    Nodes.YieldExpr AS item -> RETURN Locatable{ YieldExpr: COPY item };,
    Nodes.CloseStream AS item -> RETURN Locatable{ CloseStream: COPY item };,
    Nodes.NextExpr AS item -> RETURN Locatable{ NextExpr: COPY item };,
    Nodes.MatchStatement AS item -> RETURN Locatable{ MatchStatement: COPY item };,
    Nodes.ForRange AS item -> RETURN Locatable{ ForRange: COPY item };,
    Nodes.ForEach AS item -> RETURN Locatable{ ForEach: COPY item };,
    Nodes.TestBlock AS item -> RETURN Locatable{ TestBlock: COPY item };,
    Nodes.WhenBlock AS item -> RETURN Locatable{ WhenBlock: COPY item };,
    Nodes.LetBinding AS item -> RETURN Locatable{ LetBinding: COPY item };,
    Nodes.TestThat AS item -> RETURN Locatable{ TestThat: COPY item };,
    Nodes.AssertRaises AS item -> RETURN Locatable{ AssertRaises: COPY item };,
    Nodes.BenchmarkStmt AS item -> RETURN Locatable{ BenchmarkStmt: COPY item };,
    Nodes.SmashStmt AS item -> RETURN Locatable{ SmashStmt: COPY item };,
    Nodes.ProfileStmt AS item -> RETURN Locatable{ ProfileStmt: COPY item };,
    Nodes.StubDecl AS item -> RETURN Locatable{ StubDecl: COPY item };,
    Nodes.Drop AS item -> RETURN Locatable{ Drop: COPY item };,
    Nodes.SuppressCleanup AS item -> RETURN Locatable{ SuppressCleanup: COPY item };,
    Nodes.Return AS item -> RETURN Locatable{ Return: COPY item };,
    Nodes.ReassignCleanup AS item -> RETURN Locatable{ ReassignCleanup: COPY item };,
    Nodes.FieldCleanup AS item -> RETURN Locatable{ FieldCleanup: COPY item };,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
# Ruby walks the same nodes; the walker takes the AST union, so each entry is
# named as the locatable it already is.
FN nodes__locatable_list(values: []Nodes) RETURNS []Locatable ->
  MUTABLE out: []Locatable = List[];
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < values.length() DO
    IF castNodesToLocatable(UNWRAP (values[rtoc_idx])) EXISTS AS rtoc_node THEN
      &out.append(COPY rtoc_node);
    END
    rtoc_idx = rtoc_idx + 1;
  END
  RETURN out;
END
FN castLocatableToTypeAnalysisCallNode(value: Locatable) RETURNS ?TypeAnalysisCallNode ->
  PARTIAL MATCH value START
    Locatable.FuncCall AS item -> RETURN TypeAnalysisCallNode{ FuncCall: COPY item };,
    Locatable.MethodCall AS item -> RETURN TypeAnalysisCallNode{ MethodCall: COPY item };,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
# Associated types arrive as plain Types; a substitution map holds them as the
# binding union, one entry at a time.
FN castTypeMapToGenericBindingMap__type_analysis_session(values: {String@symbol}Type) RETURNS {String@symbol}GenericBinding ->
  MUTABLE out: {String@symbol}GenericBinding = {};
  FOR key IN values.keys() DO
    out[key] = GenericBinding{ Type: COPY (values[key] OR_ELSE panic("missing hash key")) };
  END
  RETURN out;
END
# Ruby hands the node straight to a callee that wants one specific shape.
# The union either holds that variant or it does not.
PUB FN castFinalTypeToType(value: FinalType) RETURNS ?Type EFFECTS REENTRANT ->
  IF value IS_A Type AS item THEN
    RETURN item;
  END
  RETURN NIL;
END
FN castTypeAnalysisSessionReturnValueItemToFunctionContextLifetimeSource(value: TypeAnalysisSessionReturnValueItem) RETURNS ?FunctionContextLifetimeSource ->
  PARTIAL MATCH value START
    TypeAnalysisSessionReturnValueItem.StringValue AS item -> RETURN FunctionContextLifetimeSource{ StringValue: COPY item };,
    TypeAnalysisSessionReturnValueItem.SymbolValue AS item -> RETURN FunctionContextLifetimeSource{ SymbolValue: COPY item };,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
FN castTypeAnalysisCallNodeToLocatable(value: TypeAnalysisCallNode) RETURNS ?Locatable ->
  PARTIAL MATCH value START
    TypeAnalysisCallNode.FuncCall AS item -> RETURN Locatable{ FuncCall: COPY item };,
    TypeAnalysisCallNode.MethodCall AS item -> RETURN Locatable{ MethodCall: COPY item };,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
# Ruby asks `respond_to?(:type_params)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN typeAnalysisSchema__type_params(value: TypeAnalysisSchema) RETURNS ?[]String@symbol ->
  PARTIAL MATCH value START
    TypeAnalysisSchema.StructSchemaMultiowned AS item -> RETURN COPY item.type_params;,
    TypeAnalysisSchema.ResourceSchemaMultiowned AS item -> RETURN COPY item.type_params;,
    TypeAnalysisSchema.UnionSchemaMultiowned AS item -> RETURN COPY item.type_params;,
    TypeAnalysisSchema.StructSchema AS item -> RETURN COPY item.type_params;,
    TypeAnalysisSchema.UnionSchema AS item -> RETURN COPY item.type_params;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END