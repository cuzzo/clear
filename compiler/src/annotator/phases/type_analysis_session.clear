PRIVATE FN typeAnalysisSession__consume_generic_map_value_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: Locatable, value_type: Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_graph_20535 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
    MUTABLE borrowed =   IF node IS_A GetIndex THEN
      TRUE
    ELSE_IF node IS_A Identifier THEN
      ((ownershipGraph__get_index(rtoc_graph_20535, UNWRAP (locatable__name(node))) != NIL) AND (((ownershipGraph__get_index(rtoc_graph_20535, UNWRAP (locatable__name(node))))?).kind == :borrowed))
    ELSE
      FALSE
    END;
    IF borrowed THEN
      IF node IS_A GetIndex AS get_index THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ GetIndex: COPY get_index } }, TypeAnalysisCodeOrMessage{ SymbolValue: :TAKES_NEEDS_OWNED_INDEX }));
      ELSE
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY node }, TypeAnalysisCodeOrMessage{ SymbolValue: :TAKES_NEEDS_OWNED_BORROW }));
      END
    END
    TRY (typeAnalysisSession__move_if_takes_ownership_mut(&rtoc_self_view, &node, :takes, value_type));
}
END
PRIVATE FN typeAnalysisSession__keep_param_identity_mut(MUTABLE self: TypeAnalysisSession, val_node: Locatable, expected_type: Type, container_desc: String) RETURNS !Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(type__multiowned?(expected_type)) THEN
      RETURN FALSE;
    END
    IF TRY (typeAnalysisSession__current_function_type_param?(&rtoc_self_view, type__resolved(expected_type))) THEN
      RETURN FALSE;
    END
    IF (IF val_node IS_A BinaryOp AS binary_op THEN (binary_op.op == symbol("OR_ELSE")) ELSE FALSE END) THEN
      RETURN typeAnalysisSession__keep_param_identity_mut(&rtoc_self_view, UNWRAP (locatable__left(val_node)), expected_type, container_desc);
    END
    IF val_node IS_A Identifier AS identifier THEN
      MUTABLE entry: ?SymbolEntry@multiowned = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_519 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
      scope__resolve_entry(rtoc_local_receiver_519, identifier__name(identifier)) };
      IF !((IF entry != NIL THEN
        symbolEntry__is_param(entry)
      ELSE
        NIL
      END)) THEN
        RETURN FALSE;
      END
      IF entry EXISTS AS MUTABLE entry_present THEN
        entry_present.kept_identity = (symbolEntry__kept_identity(UNWRAP (entry)) OR_ELSE KeptIdentityContract{ family: :multiowned, sink: COPY container_desc });
      END
      RETURN TRUE;
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__reject_borrowed_value_mut(MUTABLE self: TypeAnalysisSession, MUTABLE val_node: Locatable, container_desc: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE borrowed_name: ?String = NIL;
    MUTABLE rtoc_graph_20588 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
    IF val_node IS_A GetIndex AS get_index THEN
      borrowed_name = "${(typeAnalysisSession__root_variable_name(&rtoc_self_view, Locatable{ GetIndex: COPY get_index }) OR_ELSE "")}[index]";
    ELSE_IF (IF val_node IS_A Identifier AS identifier THEN ((ownershipGraph__get_index(rtoc_graph_20588, identifier__name(identifier)) != NIL) AND (((ownershipGraph__get_index(rtoc_graph_20588, identifier__name(identifier)))?).kind == :borrowed)) ELSE FALSE END) THEN
      borrowed_name = locatable__name(val_node);
    END
    IF !(borrowed_name) THEN
      RETURN;
    END
    MUTABLE vti = TRY (aST__full_type_mut(val_node));
    MUTABLE vti_value = vti;
    IF TRUE THEN
      IF type__primitive?(vti_value) THEN
      RETURN;
    END
    END
    MUTABLE vti_value = vti;
    IF TRUE THEN
      IF type__generic_instance?(vti_value) THEN
      RETURN;
    END
    END
    IF TRY (typeAnalysisSession__current_function_type_param?(&rtoc_self_view, (IF TRUE THEN
      type__resolved(vti)
    ELSE
      NIL
    END))) THEN
      RETURN;
    END
    MUTABLE has_pointer: ?Bool = (IF (TRUE) THEN
      TRY (type__heap_ptr?(vti))
    ELSE
      NIL
    END);
    IF (!(has_pointer) AND !((IF (TRUE) THEN
      type__struct?(vti)
    ELSE
      NIL
    END))) THEN
      RETURN;
    END
    TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY val_node }, TypeAnalysisCodeOrMessage{ SymbolValue: :STORE_BORROWED_INTO_CONTAINER }, [], CAST({:name: borrowed_name, :container: container_desc} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__classify_og_kind(MUTABLE self: TypeAnalysisSession, type_info: TypeTypeInput, sync_value: ?String@symbol = NIL) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE t = TRY (type__new(castTypeTypeInputToTypeConstructionInput__type_analysis_session(type_info)));
    IF (type__multiowned?(t) OR type__shared?(t)) THEN
      RETURN :rc;
    ELSE_IF sync_value THEN
      RETURN :sync;
    ELSE_IF TRY (type__implicitly_copyable?(t, %(name: String@symbol) USE(MUTABLE rtoc_self_view) -> TRY (typeAnalysisSession__schema_lookup_result(&rtoc_self_view, name)))) THEN
      RETURN :value;
    ELSE
      RETURN :affine;
    END
}
END
PUB FN typeAnalysisSession__new(importer: ?ModuleImporter = NIL, compiler: ?ModuleImporter = NIL, source_dir: ?String = NIL, strict_test: Bool = FALSE, source_code: ?String = NIL) RETURNS !TypeAnalysisSession@multiowned ->
  MUTABLE rtoc_source_dir: String = TRY (rtocResolveSourceDir(source_dir));
  MUTABLE self = TypeAnalysisSession{ current_if_is_a_condition: NIL, audit_inputs: CapabilityAuditInputs{ held_locks: {}, held_lock_types: List[], current_predicate_context: NIL, deferred_with_validations: List[], deferred_recovery_validations: List[], deferred_give_validations: List[], deferred_copy_retained_validations: List[], predicate_call_sites: List[], async_body_facts: List[], capability_audit: {}, capture_stack: List[], capture_move_suppression_depth: 0, snapshot_txn_frames: List[], effect_state: NIL, lock_analysis: LockAnalysisState{ direct_edges: {}, direct_acquires: {}, held_calls: {}, clause_sites: List[], type_ranks: {} }, ownership_graph: ownershipGraph__new(), ownership_transport_frames: List[] }, config: AnnotatorPhasesTypeAnalysisSessionConfig{ importer: ( { MUTABLE rtoc_optional_or_source_520: ?ModuleImporter@multiowned = COPY importer; MUTABLE rtoc_optional_or_result_521: ?ModuleImporter@multiowned = NIL; IF rtoc_optional_or_source_520 != NIL THEN rtoc_optional_or_result_521 = COPY rtoc_optional_or_source_520; ELSE rtoc_optional_or_result_521 = COPY compiler; END rtoc_optional_or_result_521 } ), source_dir: COPY rtoc_source_dir, strict_test: strict_test, source_code: COPY source_code }, resolution: TRY (resolutionFacts__empty()), traversal_state: TraversalState{ scopes: [scope__new()], function_contexts: List[], loop_depth: 0, conditional_depth: 0, smooth_depth: 0, body_fact_frames: List[], stream_yield_frames: List[], with_block_depth: 0, match_pattern_depth: 0, current_bg_pinned: FALSE, pipeline_accessed_fields: NIL, auto_locked_assign_name: NIL, struct_literal_call_argument_depth: 0, annotation_ancestors: List[], comptime_type_param_refinements: {}, value_type_refinements: {}, branch_terminated: FALSE, next_synthetic_body_ordinal: -1, deferred_copy_wrapper_bindings: List[] } };
  TRY (typeAnalysisSession__initialize(&self, importer, compiler, source_dir, strict_test, source_code));
  RETURN self @multiowned;
END
