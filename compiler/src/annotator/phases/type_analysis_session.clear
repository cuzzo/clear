PRIVATE FN typeAnalysisSession__body_identity_for_function(self: TypeAnalysisSession, name: String) RETURNS !BodyIdentity
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE ordinal = ((TRY (functionRegistry__names(typeAnalysisSession__semantic_function_registry(rtoc_self_view)))).indexOf(name) + 1);
    RETURN bodyIdentity__for_ordinal(ordinal);
}
END
PRIVATE FN typeAnalysisSession__function_has_pre_clauses?(self: TypeAnalysisSession, node: FunctionDef) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (node.pre_clauses IS_A []Any AND type__any?(node.pre_clauses));
}
END
PRIVATE FN typeAnalysisSession__function_has_catch_clauses?(self: TypeAnalysisSession, node: FunctionDef) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (node.catch_clauses IS_A []Any AND type__any?(node.catch_clauses));
}
END
PRIVATE FN typeAnalysisSession__function_has_default_catch?(self: TypeAnalysisSession, node: FunctionDef) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (node.default_catch IS_A []Any AND type__any?(node.default_catch));
}
END
PRIVATE FN typeAnalysisSession__runtime_error_clause?(self: TypeAnalysisSession, node: FunctionDef) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ((typeAnalysisSession__function_has_pre_clauses?(rtoc_self_view, node) OR typeAnalysisSession__function_has_catch_clauses?(rtoc_self_view, node)) OR typeAnalysisSession__function_has_default_catch?(rtoc_self_view, node));
}
END
PRIVATE FN typeAnalysisSession__run_auto_inference_mut(self: TypeAnalysisSession, program_node: Program) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fn_nodes = TRY (typeAnalysisSession__function_node_map(rtoc_self_view));
    MUTABLE collector = autoConstraintCollector__new(fn_nodes);
    MUTABLE slots = TRY (autoConstraintCollector__collect_mut(&collector, program_node));
    IF (slots.count() == 0) THEN
      RETURN;
    END
    MUTABLE rtoc_local_receiver_15 = shapeEvidenceCollector__new(slots, fn_nodes);
    TRY (shapeEvidenceCollector__collect_mut(rtoc_local_receiver_15));
    MUTABLE op_evidence = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_16 = operatorEvidenceCollector__new(slots, fn_nodes);
    TRY (operatorEvidenceCollector__collect_mut(rtoc_local_receiver_16)) };
    MUTABLE unifier = autoUnifier__new(slots);
    MUTABLE result = TRY (autoUnifier__resolve_mut(unifier));
    TRY (autoUnifier__stamp_map_pairs_mut(unifier, result.resolved));
    typeAnalysisSession__apply_auto_resolution_stamps_mut(rtoc_self_view, program_node, result.resolved);
    FOR _ IN result.resolved.values() DO
    typeAnalysisSession__emit_auto_resolved_finding_mut(rtoc_self_view, _);
    END
    TRY (typeAnalysisSession__emit_auto_shape_resolved_findings_mut(rtoc_self_view, result.resolved));
    FOR _ IN result.ambiguous.values() DO
    typeAnalysisSession__emit_auto_ambiguity_finding_mut(rtoc_self_view, _, op_evidence);
    END
    FOR _ IN result.unresolved.values() DO
    typeAnalysisSession__emit_auto_unresolved_finding_mut(rtoc_self_view, _, op_evidence);
    END
}
END
PRIVATE FN typeAnalysisSession__emit_auto_shape_resolved_findings_mut(self: TypeAnalysisSession, resolved_slots: {AutoSlotId}Resolution) RETURNS !{AutoSlotId}Resolution
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE seen = {};
    FOR _ IN resolved_slots.values() DO
    MUTABLE slot = COPY _.slot;
    IF (slot.shape == NIL) THEN
        CONTINUE;
    END
    MUTABLE decl_key: Int64 = slotDeclIdentity(slot.decl_node);
    IF seen[decl_key] THEN
        CONTINUE;
    END
    seen[decl_key] = TRUE;
    typeAnalysisSession__emit_auto_shape_resolved_finding_mut(rtoc_self_view, slot.decl_node, slot);
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__visit(MUTABLE self: TypeAnalysisSession, node: ?Locatable) RETURNS !Any@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node EXISTS AS node_value THEN
      MUTABLE node_value_mutable = COPY node_value;
      &rtoc_self_view.traversal_state.annotation_ancestors.append(COPY node_value_mutable);
      DEFER {
      MUTABLE popped: ?Locatable = &rtoc_self_view.traversal_state.annotation_ancestors.pop();
      IF !(popped.equal?(node_value_mutable)) THEN
        panic("BUG: annotation ancestor stack mismatch");
      END
      }
      MUTABLE result = PARTIAL MATCH node_value_mutable START
        AST.StructDef -> {
          MUTABLE rtoc_value_block_marker = 0;
          MUTABLE rtoc_local_receiver_17 = typeAnalysisSession__local_resolution_session(rtoc_self_view);
        resolutionSession__register_local_declaration_mut(rtoc_local_receiver_17, castLocatableToNode(node_value_mutable));
          NIL
        },
        Locatable.ExternStructDecl AS extern_struct_decl -> {
          MUTABLE rtoc_value_block_marker = 0;
          MUTABLE rtoc_local_receiver_18 = typeAnalysisSession__local_resolution_session(rtoc_self_view);
        resolutionSession__register_local_declaration_mut(rtoc_local_receiver_18, Node{ ExternStructDecl: COPY extern_struct_decl });
          NIL
        },
        AST.EnumDef -> {
          MUTABLE rtoc_value_block_marker = 0;
          MUTABLE rtoc_local_receiver_19 = typeAnalysisSession__local_resolution_session(rtoc_self_view);
        resolutionSession__register_local_declaration_mut(rtoc_local_receiver_19, castLocatableToNode(node_value_mutable));
          NIL
        },
        Locatable.UnionDef AS union_def -> {
          MUTABLE rtoc_value_block_marker = 0;
          MUTABLE rtoc_local_receiver_20 = typeAnalysisSession__local_resolution_session(rtoc_self_view);
        resolutionSession__register_local_declaration_mut(rtoc_local_receiver_20, Node{ UnionDef: COPY union_def });
          NIL
        },
        Locatable.ExternFnDecl AS extern_fn_decl -> {
          MUTABLE rtoc_value_block_marker = 0;
          MUTABLE rtoc_local_receiver_21 = typeAnalysisSession__local_resolution_session(rtoc_self_view);
        resolutionSession__register_local_declaration_mut(rtoc_local_receiver_21, Node{ ExternFnDecl: COPY extern_fn_decl });
          NIL
        },
        DEFAULT -> TRY (typeAnalysisSession__dispatch_visit(&rtoc_self_view, node_value_mutable))
      END;
      typeAnalysisSession__record_body_fact_node_mut(rtoc_self_view, node_value_mutable);
      typeAnalysisSession__record_ownership_transport_fact_mut(rtoc_self_view, node_value_mutable);
      RETURN result;
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__dispatch_visit(MUTABLE self: TypeAnalysisSession, MUTABLE node: Locatable) RETURNS !Any@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN PARTIAL MATCH node START
      Locatable.FunctionDef AS function_def -> typeAnalysisSession__visit_FunctionDef(&rtoc_self_view, &function_def),
      Locatable.LambdaLit AS lambda_lit -> typeAnalysisSession__visit_LambdaLit(&rtoc_self_view, lambda_lit),
      blockexpr -> typeAnalysisSession__visit_BlockExpr(&rtoc_self_view, &node),
      Locatable.IfStatement AS if_statement -> typeAnalysisSession__visit_IfStatement(&rtoc_self_view, &if_statement),
      Locatable.IsA AS is_a -> typeAnalysisSession__visit_IsA(&rtoc_self_view, is_a),
      Locatable.IfBind AS if_bind -> typeAnalysisSession__visit_IfBind(&rtoc_self_view, if_bind),
      Locatable.MatchStatement AS match_statement -> typeAnalysisSession__visit_MatchStatement(&rtoc_self_view, &match_statement),
      Locatable.ForRange AS for_range -> typeAnalysisSession__visit_ForRange(&rtoc_self_view, &for_range),
      Locatable.ForEach AS for_each -> typeAnalysisSession__visit_ForEach(&rtoc_self_view, &for_each),
      Locatable.WhileLoop AS while_loop -> typeAnalysisSession__visit_WhileLoop(&rtoc_self_view, &while_loop),
      Locatable.WhileBindLoop AS while_bind_loop -> typeAnalysisSession__visit_WhileBindLoop(&rtoc_self_view, &while_bind_loop),
      Locatable.BreakNode AS break_node -> typeAnalysisSession__visit_BreakNode(rtoc_self_view, break_node),
      Locatable.ContinueNode AS continue_node -> typeAnalysisSession__visit_ContinueNode(rtoc_self_view, continue_node),
      Locatable.PassStmt AS pass_stmt -> typeAnalysisSession__visit_PassStmt(rtoc_self_view, pass_stmt),
      AST.DeferStmt -> typeAnalysisSession__visit_DeferStmt(&rtoc_self_view, node),
      Locatable.SyncPolicyDecl AS sync_policy_decl -> typeAnalysisSession__visit_SyncPolicyDecl(&rtoc_self_view, sync_policy_decl),
      Locatable.Assert AS assert -> typeAnalysisSession__visit_Assert(&rtoc_self_view, assert),
      Locatable.DieNode AS die_node -> typeAnalysisSession__visit_DieNode(&rtoc_self_view, die_node),
      raise_value -> typeAnalysisSession__visit_Raise(&rtoc_self_view, node),
      Locatable.ReturnNode AS return_node -> typeAnalysisSession__visit_ReturnNode(&rtoc_self_view, return_node),
      AST.OrElseRaise -> typeAnalysisSession__visit_OrElseRaise(rtoc_self_view, node),
      AST.OrElseBreak -> typeAnalysisSession__visit_OrElseBreak(rtoc_self_view, node),
      AST.OrElsePass -> typeAnalysisSession__visit_OrElsePass(rtoc_self_view, node),
      AST.OrElsePrune -> typeAnalysisSession__visit_OrElsePrune(rtoc_self_view, node),
      AST.OrElseExit -> typeAnalysisSession__visit_OrElseExit(&rtoc_self_view, node),
      Locatable.WithBlock AS with_block -> typeAnalysisSession__visit_WithBlock(&rtoc_self_view, &with_block),
      doblock -> typeAnalysisSession__visit_DoBlock(&rtoc_self_view, node),
      Locatable.BgStreamBlock AS bg_stream_block -> typeAnalysisSession__visit_BgStreamBlock(&rtoc_self_view, &bg_stream_block),
      Locatable.YieldExpr AS yield_expr -> typeAnalysisSession__visit_YieldExpr(&rtoc_self_view, &yield_expr),
      Locatable.CloseStream AS close_stream -> typeAnalysisSession__visit_CloseStream(rtoc_self_view, close_stream),
      AST.BgBlock -> typeAnalysisSession__visit_BgBlock(&rtoc_self_view, &node),
      Locatable.ThenChain AS then_chain -> typeAnalysisSession__visit_ThenChain(&rtoc_self_view, then_chain),
      Locatable.NextExpr AS next_expr -> typeAnalysisSession__visit_NextExpr(&rtoc_self_view, &next_expr),
      AST.Cast -> typeAnalysisSession__visit_Cast(&rtoc_self_view, node),
      Locatable.CallSiteOverride AS call_site_override -> typeAnalysisSession__visit_CallSiteOverride(rtoc_self_view, call_site_override),
      AST.UnaryOp -> typeAnalysisSession__visit_UnaryOp(&rtoc_self_view, &node),
      Locatable.Literal AS literal -> typeAnalysisSession__visit_Literal(rtoc_self_view, &literal),
      Locatable.DefaultLit AS default_lit -> typeAnalysisSession__visit_DefaultLit(rtoc_self_view, default_lit),
      Locatable.BinaryOp AS binary_op -> typeAnalysisSession__visit_BinaryOp(&rtoc_self_view, &binary_op),
      Locatable.Placeholder AS placeholder -> typeAnalysisSession__visit_Placeholder(rtoc_self_view, placeholder),
      Locatable.CapabilityWrap AS capability_wrap -> typeAnalysisSession__visit_CapabilityWrap(&rtoc_self_view, capability_wrap),
      AST.OptionalUnwrap -> typeAnalysisSession__visit_OptionalUnwrap(&rtoc_self_view, &node),
      Locatable.TenseNavigation AS tense_navigation -> typeAnalysisSession__visit_TenseNavigation(&rtoc_self_view, &tense_navigation),
      Locatable.MutableBorrow AS mutable_borrow -> typeAnalysisSession__visit_MutableBorrow(rtoc_self_view, mutable_borrow),
      Locatable.FuncCall AS func_call -> typeAnalysisSession__visit_FuncCall(&rtoc_self_view, func_call),
      AST.MethodCall -> typeAnalysisSession__visit_MethodCall(&rtoc_self_view, node),
      Locatable.StaticCall AS static_call -> typeAnalysisSession__visit_StaticCall(&rtoc_self_view, &static_call),
      Locatable.MoveNode AS move_node -> typeAnalysisSession__visit_MoveNode(&rtoc_self_view, &move_node),
      Locatable.CopyNode AS copy_node -> typeAnalysisSession__visit_CopyNode(&rtoc_self_view, copy_node),
      Locatable.KeepNode AS keep_node -> typeAnalysisSession__visit_KeepNode(&rtoc_self_view, keep_node),
      Locatable.Copy AS copy -> typeAnalysisSession__visit_Copy(&rtoc_self_view, &copy),
      Locatable.LinkNode AS link_node -> typeAnalysisSession__visit_LinkNode(&rtoc_self_view, link_node),
      Locatable.ResolveNode AS resolve_node -> typeAnalysisSession__visit_ResolveNode(&rtoc_self_view, resolve_node),
      Locatable.FreezeNode AS freeze_node -> typeAnalysisSession__visit_FreezeNode(&rtoc_self_view, &freeze_node),
      Locatable.ShareNode AS share_node -> typeAnalysisSession__visit_ShareNode(&rtoc_self_view, &share_node),
      Locatable.GetIndex AS get_index -> typeAnalysisSession__visit_GetIndex(&rtoc_self_view, &get_index),
      Locatable.GetField AS get_field -> typeAnalysisSession__visit_GetField(&rtoc_self_view, &get_field),
      Locatable.Slice AS slice -> typeAnalysisSession__visit_Slice(&rtoc_self_view, &slice),
      Locatable.HashLit AS hash_lit -> typeAnalysisSession__visit_HashLit(&rtoc_self_view, &hash_lit),
      Locatable.StructLit AS struct_lit -> typeAnalysisSession__visit_StructLit(&rtoc_self_view, &struct_lit),
      Locatable.ListLit AS list_lit -> typeAnalysisSession__visit_ListLit(&rtoc_self_view, &list_lit),
      Locatable.TupleLit AS tuple_lit -> typeAnalysisSession__visit_TupleLit(&rtoc_self_view, &tuple_lit),
      Locatable.DefaultArrayLit AS default_array_lit -> typeAnalysisSession__visit_DefaultArrayLit(rtoc_self_view, &default_array_lit),
      AST.RangeLit -> typeAnalysisSession__visit_RangeLit(&rtoc_self_view, node),
      Locatable.VarDecl AS var_decl -> typeAnalysisSession__visit_VarDecl(&rtoc_self_view, var_decl),
      Locatable.BindExpr AS bind_expr -> typeAnalysisSession__visit_BindExpr(&rtoc_self_view, bind_expr),
      Locatable.Identifier AS identifier -> typeAnalysisSession__visit_Identifier(rtoc_self_view, &identifier),
      Locatable.Assignment AS assignment -> typeAnalysisSession__visit_Assignment(&rtoc_self_view, assignment),
      Locatable.TestBlock AS test_block -> typeAnalysisSession__visit_TestBlock(&rtoc_self_view, test_block),
      Locatable.WhenBlock AS when_block -> typeAnalysisSession__visit_WhenBlock(&rtoc_self_view, when_block),
      Locatable.TestThat AS test_that -> typeAnalysisSession__visit_TestThat(&rtoc_self_view, test_that),
      Locatable.AssertRaises AS assert_raises -> typeAnalysisSession__visit_AssertRaises(&rtoc_self_view, assert_raises),
      Locatable.BenchmarkStmt AS benchmark_stmt -> typeAnalysisSession__visit_BenchmarkStmt(&rtoc_self_view, benchmark_stmt),
      Locatable.SmashStmt AS smash_stmt -> typeAnalysisSession__visit_SmashStmt(&rtoc_self_view, smash_stmt),
      Locatable.ProfileStmt AS profile_stmt -> typeAnalysisSession__visit_ProfileStmt(&rtoc_self_view, profile_stmt),
      Locatable.StubDecl AS stub_decl -> typeAnalysisSession__visit_StubDecl(&rtoc_self_view, stub_decl),
      Locatable.DestructuringAssignment AS destructuring_assignment -> typeAnalysisSession__visit_DestructuringAssignment(&rtoc_self_view, destructuring_assignment),
      Locatable.UnionVariantLit AS union_variant_lit -> typeAnalysisSession__visit_UnionVariantLit(&rtoc_self_view, union_variant_lit),
      DEFAULT -> panic("BUG: no annotation visitor for {}")
    END;
}
END
PRIVATE FN typeAnalysisSession__local_resolution_session(self: TypeAnalysisSession) RETURNS ResolutionSession@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN resolutionSession__new(typeAnalysisSession__active_importer(rtoc_self_view), typeAnalysisSession__import_source_dir(rtoc_self_view), rtoc_self_view.config.source_code, typeAnalysisSession__current_scope(rtoc_self_view), typeAnalysisSession__semantic_function_registry(rtoc_self_view), FALSE);
}
END
PRIVATE FN typeAnalysisSession__record_ownership_transport_fact_mut(self: TypeAnalysisSession, node: Locatable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (typeAnalysisSession__language_mode(rtoc_self_view) == :strict) THEN
      RETURN;
    END
    MUTABLE fact_frames: []OwnershipTransportFacts@multiowned = COPY rtoc_self_view.audit_inputs.ownership_transport_frames;
    MUTABLE facts: ?OwnershipTransportFacts@multiowned = COPY fact_frames.last();
    IF facts EXISTS AS facts_value THEN
      MUTABLE facts_value_mutable = COPY facts_value;
      MUTABLE ancestors = (rtoc_self_view.traversal_state.annotation_ancestors.substr(0, ((rtoc_self_view.traversal_state.annotation_ancestors.length() - 1) - 0)) OR_ELSE List[]);
      IF node IS_A Identifier AS identifier THEN
        MUTABLE identifier_mutable = COPY identifier;
        FOR _ IN fact_frames DO
    MUTABLE rtoc_mutable_block_param_22 = COPY _;
        ownershipTransportFacts__record_read(&rtoc_mutable_block_param_22, identifier_mutable, ancestors);
        END
        RETURN;
      END
      IF ((((node IS_A VarDecl OR node IS_A BindExpr)) AND node.ownership_transport_plan() IS_A OwnershipTransportPlan) AND (node.ownership_transport_plan().action() == :pending)) THEN
        ownershipTransportFacts__record_alias(&facts_value_mutable, castLocatableToNode(node), ancestors);
      END
      IF node IS_A Assignment AS assignment THEN
        MUTABLE assignment_mutable = COPY assignment;
        MUTABLE target = assignment_mutable.name;
        MUTABLE root_branch_value: ?Identifier = NIL;
        IF ((target IS_A Identifier OR target IS_A GetField) OR target IS_A GetIndex) THEN
          root_branch_value = aST__root_identifier(castAssignmentNameToLocatable(target));
        ELSE
          root_branch_value = NIL;
        END
        MUTABLE root: ?Identifier = root_branch_value;
        IF (root != NIL) THEN
          FOR _ IN fact_frames DO
    MUTABLE rtoc_mutable_block_param_23 = COPY _;
          ownershipTransportFacts__record_mutation(&rtoc_mutable_block_param_23, Locatable{ Assignment: COPY assignment_mutable }, UNWRAP (root), ancestors);
          END
        END
        MUTABLE value = assignment_mutable.value;
        IF (value IS_A Identifier AND (value.ownership_pending_transfer() == TRUE)) THEN
          ownershipTransportFacts__record_transfer(&facts_value_mutable, Locatable{ Assignment: COPY assignment_mutable }, Slot{ StringValue: COPY "value" }, value);
        END
      ELSE_IF (IF node IS_A BindExpr AS bind_expr THEN (bind_expr.mode != :decl) ELSE FALSE END) THEN
        MUTABLE entry: ?SymbolEntry@multiowned = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_24 = typeAnalysisSession__current_scope(rtoc_self_view);
        scope__resolve_entry(rtoc_local_receiver_24, CAST(node.name() AS String)) };
        IF entry EXISTS AS entry_value THEN
          MUTABLE entry_value_mutable = COPY entry_value;
          FOR _ IN fact_frames DO
    MUTABLE rtoc_mutable_block_param_25 = COPY _;
          ownershipTransportFacts__record_mutation_id(&rtoc_mutable_block_param_25, node, entry_value_mutable.ownership_binding_id, ancestors);
          END
        END
      END
      IF (node IS_A FuncCall OR node IS_A MethodCall) THEN
        MUTABLE signature = node.matched_signature();
        MUTABLE actuals = IF node IS_A MethodCall THEN
          ([node.object()] + node.args())
        ELSE
          node.args()
        END;
        IF signature THEN
          MUTABLE rtoc_each_items_26 = signature.params();
          MUTABLE rtoc_idx = 0;
          WHILE rtoc_idx < rtoc_each_items_26.length() DO
      MUTABLE argument = actuals[rtoc_idx];
      IF (rtoc_each_items_26[rtoc_idx].mutable() AND argument) THEN
                MUTABLE root: ?Identifier = aST__root_identifier(argument);
                IF (root != NIL) THEN
                  FOR _ IN fact_frames DO
        MUTABLE rtoc_mutable_block_param_27 = COPY _;
                  ownershipTransportFacts__record_mutation(&rtoc_mutable_block_param_27, node, UNWRAP (root), ancestors);
                  END
                END
      END
    rtoc_idx = rtoc_idx + 1;
          END
        END
        MUTABLE rtoc_idx = 0;
        WHILE rtoc_idx < actuals.length() DO
    IF (actuals[rtoc_idx] IS_A Identifier AND (actuals[rtoc_idx].ownership_pending_transfer() == TRUE)) THEN
            ownershipTransportFacts__record_transfer(&facts_value_mutable, node, rtoc_idx, actuals[rtoc_idx]);
    END
    rtoc_idx = rtoc_idx + 1;
        END
      ELSE_IF node IS_A StructLit AS struct_lit THEN
        FOR rtoc_each_key IN struct_lit.fields.keys() DO
    MUTABLE value = COPY UNWRAP (struct_lit.fields[rtoc_each_key]);
        IF (value IS_A Identifier AND (value.ownership_pending_transfer() == TRUE)) THEN
          ownershipTransportFacts__record_transfer(&facts_value_mutable, Locatable{ StructLit: COPY struct_lit }, rtoc_each_key, value);
        END
        END
      END
    ELSE
      RETURN;
    END
}
END
