PUB FN typeAnalysisSession__analyze_resolution_mut(MUTABLE self: TypeAnalysisSession, resolution: ResolutionFacts) RETURNS !OwnershipGraph@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__adopt_resolution_facts_mut(&rtoc_self_view, resolution);
    TRY (typeAnalysisSession__validate_conformances_mut(&rtoc_self_view, resolution.conformance_resolutions));
    TRY (typeAnalysisSession__bridge_reentrance_mut(&rtoc_self_view, CAST(COPY resolution.program AS Program)));
    TRY (typeAnalysisSession__validate_and_resolve_sync_policy_mut(&rtoc_self_view, CAST(COPY resolution.program AS Program)));
    TRY (typeAnalysisSession__seed_error_type_registrations_mut(&rtoc_self_view, resolution.declarations));
    TRY (typeAnalysisSession__analyze_program_bodies_mut(&rtoc_self_view, resolution.declarations, CAST(COPY resolution.program AS Program)));
    TRY (typeAnalysisSession__resolve_catch_clauses_from_declarations_mut(&rtoc_self_view, resolution.declarations));
    TRY (typeAnalysisSession__finalize_program_type_mut(&rtoc_self_view, CAST(COPY resolution.program AS Program)));
    TRY (typeAnalysisSession__finalize_auto_types_mut(&rtoc_self_view, CAST(COPY resolution.program AS Program)));
    RETURN typeAnalysisSession__ownership_graph(&rtoc_self_view);
}
END
PUB FN typeAnalysisSession__release_capability_audit_inputs_mut(MUTABLE self: TypeAnalysisSession) RETURNS CapabilityAuditInputs
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE inputs = COPY rtoc_self_view.audit_inputs;
    rtoc_self_view.audit_inputs = CapabilityAuditInputs{ held_locks: {}, held_lock_types: List[], current_predicate_context: NIL, deferred_with_validations: List[], deferred_recovery_validations: List[], deferred_give_validations: List[], deferred_copy_retained_validations: List[], predicate_call_sites: List[], async_body_facts: List[], capability_audit: {}, capture_stack: List[], capture_move_suppression_depth: 0, snapshot_txn_frames: List[], effect_state: NIL, lock_analysis: LockAnalysisState{ direct_edges: {}, direct_acquires: {}, held_calls: {}, clause_sites: List[], type_ranks: {} }, ownership_graph: ownershipGraph__new(), ownership_transport_frames: List[] };
    RETURN inputs;
}
END
PUB FN typeAnalysisSession__release_capability_audit_request_mut(MUTABLE self: TypeAnalysisSession) RETURNS CapabilityAuditRequest
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN CapabilityAuditRequest{ inputs: COPY typeAnalysisSession__release_capability_audit_inputs_mut(&rtoc_self_view), source_code: COPY rtoc_self_view.config.source_code, language_mode: COPY typeAnalysisSession__language_mode(&rtoc_self_view), strict_test: typeAnalysisSession__strict_test?(&rtoc_self_view) };
}
END
PRIVATE FN typeAnalysisSession__reset_compilation_state_mut(MUTABLE self: TypeAnalysisSession) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.traversal_state = TraversalState{ scopes: [scope__new()], function_contexts: List[], loop_depth: 0, conditional_depth: 0, smooth_depth: 0, body_fact_frames: List[], stream_yield_frames: List[], with_block_depth: 0, match_pattern_depth: 0, current_bg_pinned: FALSE, pipeline_accessed_fields: NIL, auto_locked_assign_name: NIL, struct_literal_call_argument_depth: 0, annotation_ancestors: List[], comptime_type_param_refinements: {}, value_type_refinements: {}, branch_terminated: FALSE, next_synthetic_body_ordinal: -1, deferred_copy_wrapper_bindings: List[] };
    rtoc_self_view.audit_inputs = CapabilityAuditInputs{ held_locks: {}, held_lock_types: List[], current_predicate_context: NIL, deferred_with_validations: List[], deferred_recovery_validations: List[], deferred_give_validations: List[], deferred_copy_retained_validations: List[], predicate_call_sites: List[], async_body_facts: List[], capability_audit: {}, capture_stack: List[], capture_move_suppression_depth: 0, snapshot_txn_frames: List[], effect_state: NIL, lock_analysis: LockAnalysisState{ direct_edges: {}, direct_acquires: {}, held_calls: {}, clause_sites: List[], type_ranks: {} }, ownership_graph: ownershipGraph__new(), ownership_transport_frames: List[] };
    rtoc_self_view.resolution = TRY (resolutionFacts__empty());
    rtoc_self_view.traversal_state.scopes = [KEEP rtoc_self_view.resolution.root_scope];
    typeAnalysisSession__effects_init_mut( &rtoc_self_view);
    TRY (typeAnalysisSession__capability_audit_init_mut(&rtoc_self_view));
}
END
PRIVATE FN typeAnalysisSession__adopt_resolution_facts_mut(MUTABLE self: TypeAnalysisSession, resolution: ResolutionFacts) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.resolution = COPY resolution;
    rtoc_self_view.traversal_state.scopes = [COPY resolution.root_scope];
}
END
