PRIVATE FN typeAnalysisSession__record_capability_binding(MUTABLE self: TypeAnalysisSession, var_name: String, MUTABLE node: Locatable, final_type: FinalType, storage: String@symbol) RETURNS !?BindingAuditRecord
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_ctx: ?FunctionContext@multiowned = typeAnalysisSession__current_fn_ctx(&rtoc_self_view);
    IF fn_ctx EXISTS AS fn_ctx_value THEN
      MUTABLE fn_name = COPY fn_ctx_value.name;
      MUTABLE info: ?SymbolEntry@multiowned = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_234 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
      scope__resolve_entry(rtoc_local_receiver_234, var_name) };
      MUTABLE sync: ?String@symbol = (IF info != NIL THEN
        symbolEntry__sync(info)
      ELSE
        NIL
      END);
      IF ((storage == :multiowned) OR (storage == :shared)) THEN
        MUTABLE own = COPY storage;
      END
      IF !((sync != NIL)) THEN
        RETURN NIL;
      END
      MUTABLE fn_nodes = TRY (typeAnalysisSession__function_node_map(&rtoc_self_view));
      MUTABLE fn_node: ?FunctionDef@multiowned = COPY fn_nodes[fn_name];
      IF ((fn_node != NIL) AND (fn_node.visibility == :pub)) THEN
        RETURN NIL;
      END
      MUTABLE key = typeAnalysisSession__capability_audit_key(&rtoc_self_view, fn_name, var_name);
      MUTABLE line: ?Int64 = (IF TRUE THEN
        (aST__node__token(node)).line
      ELSE
        NIL
      END);
      MUTABLE column: ?Int64 = (IF TRUE THEN
        (aST__node__token(node)).column
      ELSE
        NIL
      END);
      MUTABLE final_type_info = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_236: ?FinalType = NIL;
      IF final_type IS_A Type THEN
        rtoc_ternary_value_236 = COPY final_type;
      ELSE
        rtoc_ternary_value_236 = TRY (type__new(castFinalTypeToTypeConstructionInput(final_type)));
      END
      rtoc_ternary_value_236? };
      MUTABLE record = BindingAuditRecord{ fn: COPY fn_name, var: COPY var_name, line: line, column: column, sync: COPY sync, ownership: NIL, storage: COPY storage, sharded: type__sharded?(UNWRAP (castFinalTypeToType(final_type_info))), mutated: FALSE, captured_bg: FALSE, captured_parallel: FALSE };
      MUTABLE rtoc_index_receiver_237 = TRY (typeAnalysisSession__capability_audit_store(&rtoc_self_view));
      rtoc_index_receiver_237[key] = record;
      RETURN record;
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__audit_mark_mutated(MUTABLE self: TypeAnalysisSession, var_name: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_name: ?String = COPY typeAnalysisSession__current_fn_ctx(&rtoc_self_view)?.name;
    IF fn_name EXISTS AS fn_name_value THEN
      MUTABLE fn_name_value_mutable = COPY fn_name_value;
      MUTABLE record: ?BindingAuditRecord = COPY TRY (typeAnalysisSession__capability_audit_store(&rtoc_self_view))[typeAnalysisSession__capability_audit_key(&rtoc_self_view, fn_name_value_mutable, var_name)];
      IF record != NIL THEN
            bindingAuditRecord__mark_mutated_mut(&record);
