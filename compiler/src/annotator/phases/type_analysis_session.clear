}
END
PRIVATE FN typeAnalysisSession__resolve_call(MUTABLE self: TypeAnalysisSession, MUTABLE node: FunctionCallNode, args: []Locatable) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE comptime_type_args: []Any = List[];
    MUTABLE subst = NIL;
    MUTABLE func_name = node.name();
    MUTABLE scope: ?Scope@multiowned = typeAnalysisSession__lookup_scope_for(rtoc_self_view, func_name);
    IF scope EXISTS AS scope_value THEN
      MUTABLE scope_value_mutable = COPY scope_value;
      MUTABLE func_type = TRY (scope__resolve_type(scope_value_mutable, func_name));
      MUTABLE entry: ?SymbolEntry@multiowned = scope__resolve_entry(scope_value_mutable, func_name);
      MUTABLE fsig: ?FunctionSignature@multiowned = functionSignature__unwrap(X{ Type: COPY func_type });
      MUTABLE fn_type_branch_value: ?FunctionType = NIL;
      IF TRUE THEN
        fn_type_branch_value = type__function_type(func_type);
      ELSE
        fn_type_branch_value = NIL;
      END
      MUTABLE fn_type: ?FunctionType = fn_type_branch_value;
      IF (func_type == :Intrinsic) THEN
        typeAnalysisSession__visit_IntrinsicFunc(&rtoc_self_view, castFunctionCallNodeToNode(node), args);
      ELSE_IF ((fsig != NIL) AND ((entry != NIL) AND (symbolEntry__storage(entry) == :static))) THEN
        MUTABLE signature: ?FunctionSignature@multiowned = KEEP fsig;
        IF (IF node IS_A FuncCall AS func_call THEN (functionSignature__module_alias(signature) != NIL) ELSE FALSE END) THEN
          node.module_alias = functionSignature__module_alias(signature);
        END
        IF (TRUE AND functionSignature__extern(signature)) THEN
          MATCH node START
            FunctionCallNode.FuncCall AS item ->
