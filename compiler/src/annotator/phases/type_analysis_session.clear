->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE identity = COPY identity_input;
    IF (identity.body_id == semanticUnassignedBodyId()) THEN
      MUTABLE ordinal = typeAnalysisSession__phase_traversal_state(&rtoc_self_view).next_synthetic_body_ordinal;
      rtoc_self_view.traversal_state.next_synthetic_body_ordinal=((typeAnalysisSession__phase_traversal_state(&rtoc_self_view).next_synthetic_body_ordinal - 1));
      identity = BodyIdentity{ definition_id: COPY DefId{ value: ordinal }, body_id: COPY BodyId{ value: ordinal } };
    END
    MUTABLE frame = bodyFactFrame__for_identity(identity);
    typeAnalysisSession__push_body_fact_frame_mut(&rtoc_self_view, frame);
    DEFER {
    MUTABLE popped: ?BodyFactFrame = typeAnalysisSession__pop_body_fact_frame_mut(&rtoc_self_view);
    IF (popped == NIL) THEN
      panic("BUG: body fact frame mismatch");
    END
    }
    block();
    RETURN bodyFactFrame__to_summary(frame);
}
END
