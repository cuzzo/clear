      type__sync(_.type)
    ELSE
      NIL
    END, carrier_contract: COPY _.carrier_contract, comptime: NIL, name_token: NIL, symbol: NIL }, functionDef__annotation_return_type(node), FunctionSignatureLifetimeInput{ ArrayValue: lifetime_paths |> SELECT castLifetimesReturnValueItemToFunctionSignatureLifetimeSource(_) }, node.visibility, fn_type_params, node.generic_params |> REDUCE({}) {
    acc[symbol(_.name)] = ( { MUTABLE rtoc_map_results = CAST([] AS []Type); _.bounds |> EACH { &rtoc_map_results.append(COPY _.type); }; rtoc_map_results } );
    acc
    }, functionDef__declared_plain_reentrant?(node), FALSE, NIL, NIL, NIL, ( { MUTABLE rtoc_empty_list_58: []String@symbol = List[]; rtoc_empty_list_58 } ), NIL, ( { MUTABLE rtoc_empty_list_59: []String@symbol = List[]; rtoc_empty_list_59 } ), FALSE, NIL, NIL, NIL, NIL, NIL, NIL, NIL, node.requires));
    MUTABLE rtoc_mutable_receiver_60 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_60, node.name, NIL, SymbolEntryTypeInput{ FunctionSignatureMultiowned: COPY signature }, ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :static));
    typeAnalysisSession__register_function_node_mut(rtoc_self_view, node);
    typeAnalysisSession__warn_monomorphic_variant_explosion_mut(rtoc_self_view, node);
    MUTABLE body_identity = typeAnalysisSession__body_identity_for_function(rtoc_self_view, node.name);
    node.semantic_with_blocks = ( { MUTABLE rtoc_empty_list_61: []WithBlock = List[]; rtoc_empty_list_61 } );
    MUTABLE final_return_type: ?String@symbol = NIL;
    MUTABLE body_scan = typeAnalysisSession__with_body_fact_frame(rtoc_self_view, body_identity, %() USE(declared_return, is_implicit_return, node, MUTABLE rtoc_self_view) -> {
    final_return_type = typeAnalysisSession__analyze_routine(&rtoc_self_view, RoutineNode{ FunctionDefMultiowned: COPY node }, RoutineBody{ ArrayValue: node.body |> SELECT castLocatableToNode(_) }, declared_return, is_implicit_return);
    rubyToClearVoid()
    });
    MUTABLE called_names = COPY body_scan.callees;
    MUTABLE has_fnptr = body_scan.has_fnptr_call;
    MUTABLE unabsorbed_calls = COPY body_scan.propagating_callees;
    MUTABLE raises_in_body = body_scan.raises_directly;
    MUTABLE directly_recursive = called_names.contains?(node.name);
    IF has_fnptr THEN
      functionContext__mark_runtime_used_mut(&fn_ctx);
    END
    typeAnalysisSession__offer_plain_reentrant_variant_fix_mut(rtoc_self_view, node, TypeAnalysisBodyFacts{ BodyScanSummary: COPY body_scan });
    typeAnalysisSession__route_thunk_to_tail_call_compat_mut(rtoc_self_view, &node, TypeAnalysisBodyFacts{ BodyScanSummary: COPY body_scan });
    IF directly_recursive THEN
      typeAnalysisSession__record_effect(rtoc_self_view, symbol("REENTRANT"));
      IF !(node.reentrance_kind) THEN
        typeAnalysisSession__emit_reentrant_error_mut(rtoc_self_view, node, :REENTRANCE_INDIRECT_RECURSIVE);
      END
      IF node.tail_call THEN
        typeAnalysisSession__validate_tail_call_mut(rtoc_self_view, node, body_scan);
      END
      IF ((node.reentrance_kind == :reentrant_thunk) AND !(node.tail_call)) THEN
        MUTABLE plan: ?Plan = recursiveSplitter__split(node.body, node.name);
        IF plan EXISTS AS plan_value THEN
