END
PRIVATE FN typeAnalysisSession__analyze_find_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lhs_type = &node.left.full_type_mut("pipeline left");
    MUTABLE source = typeAnalysisSession__pipeline_source_fact(rtoc_self_view, node.left, lhs_type);
    MUTABLE is_stream = pipelineSourceFact__finite_stream?(source);
    typeAnalysisSession__require_array_input_mut(rtoc_self_view, node, "FIND", is_stream, is_stream);
    MUTABLE item_type = COPY source.item_type;
    typeAnalysisSession__with_new_scope(rtoc_self_view, %() USE(item_type, node, rtoc_self_view) -> {
    MUTABLE rtoc_mutable_receiver_140 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_140, "_", NIL, castTypeToOptionalSymbolEntryTypeInput(item_type), ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    typeAnalysisSession__annotate_pipeline_expression_mut(&rtoc_self_view, node.right, node.right.expression())
    });
    IF !((node.right.expression().resolved_type() == :Bool)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node.right, TypeAnalysisCodeOrMessage{ SymbolValue: :PIPE_CLAUSE_NEEDS_BOOL }, [], {:clause: "FIND", :got: node.right.expression().resolved_type()});
    END
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("?${castTypeToString(item_type)}") }))));
    node.storage = :stack;
    RETURN CAST(typeAnalysisSession__mark_observable_terminal_mut(rtoc_self_view, node, :find, symbol("~?${castTypeToString(item_type)}")) AS ?Type);
}
END
PRIVATE FN typeAnalysisSession__analyze_any_op(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lhs_type = &node.left.full_type_mut("pipeline left");
    MUTABLE source = typeAnalysisSession__pipeline_source_fact(rtoc_self_view, node.left, lhs_type);
    MUTABLE is_stream = pipelineSourceFact__finite_stream?(source);
    typeAnalysisSession__require_array_input_mut(rtoc_self_view, node, "ANY", is_stream, is_stream);
    MUTABLE item_type = COPY source.item_type;
    typeAnalysisSession__with_new_scope(rtoc_self_view, %() USE(item_type, node, rtoc_self_view) -> {
    MUTABLE rtoc_mutable_receiver_141 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_141, "_", NIL, castTypeToOptionalSymbolEntryTypeInput(item_type), ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    typeAnalysisSession__annotate_pipeline_expression_mut(&rtoc_self_view, node.right, node.right.expression())
    });
    IF !((node.right.expression().resolved_type() == :Bool)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node.right, TypeAnalysisCodeOrMessage{ SymbolValue: :PIPE_CLAUSE_NEEDS_BOOL }, [], {:clause: "ANY", :got: node.right.expression().resolved_type()});
    END
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, :Bool));
    node.storage = :stack;
    RETURN CAST(typeAnalysisSession__mark_observable_terminal_mut(rtoc_self_view, node, :any, symbol("~Bool")) AS ?Type);
}
END
