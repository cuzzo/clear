PRIVATE FN typeAnalysisSession__visit_FuncCall(MUTABLE self: TypeAnalysisSession, MUTABLE node: FuncCall) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__normalize_explicit_mutable_arguments_mut(&rtoc_self_view, Node{ FuncCall: COPY node });
    FOR MUTABLE rtoc_for_elem_12042 IN node.args DO
    TRY (typeAnalysisSession__annotate_call_argument_mut(&rtoc_self_view, node, &rtoc_for_elem_12042));
    END
    IF ((IF node.name IS_A String AS nodename_payload THEN (nodename_payload == "native_call") ELSE FALSE END)) THEN
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ FuncCall: COPY node }, :Any));
      RETURN;
    END
    IF TRY (typeAnalysisSession__resolve_user_protocol_function_call_mut(&rtoc_self_view, &node)) THEN
      TRY (typeAnalysisSession__record_predicate_call_site_mut(&rtoc_self_view, Node{ FuncCall: COPY node }));
