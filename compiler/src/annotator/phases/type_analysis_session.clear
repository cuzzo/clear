PRIVATE FN typeAnalysisSession__visit_Raise(MUTABLE self: TypeAnalysisSession, MUTABLE node: Raise) RETURNS !?Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node.message_expr THEN
      TRY (typeAnalysisSession__visit(&rtoc_self_view, node.message_expr));
    END
    TRY (typeAnalysisSession__resolve_error_registration_mut(&rtoc_self_view, Node{ Raise: COPY node }, node.kind, node.error_name, node.token));
    IF typeAnalysisSession__current_fn_ctx(&rtoc_self_view) != NIL THEN
        MUTABLE rtoc_mutable_receiver_435: FunctionContext@multiowned = UNWRAP ((typeAnalysisSession__current_fn_ctx(&rtoc_self_view)));
        functionContext__mark_runtime_used_mut(&rtoc_mutable_receiver_435);
    END
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ Raise: COPY node }, :NoReturn));
    rtoc_self_view.traversal_state.branch_terminated = TRUE;
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__resolve_error_registration_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: Node, kind_sym: ?String@symbol, type_name_str: ?String, site_tok: Token) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF type_name_str EXISTS AS type_name_str_value THEN
      MUTABLE type_sym = symbol(type_name_str_value);
      IF kind_sym EXISTS AS kind_sym_value THEN
        _, MUTABLE conflict = TRY (aST__register_type_mut(type_sym, kind_sym_value, site_tok));
        IF conflict EXISTS AS conflict_value THEN
          TRY (typeAnalysisSession__emit_error_type_conflict_mut(&rtoc_self_view, Site{ Token: COPY site_tok }, type_name_str_value, conflict_value));
        END
        NIL;
      ELSE
        IF !(TRY (aST__error_type?(type_sym))) THEN
          TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ TokenValue: COPY site_tok }, TypeAnalysisCodeOrMessage{ SymbolValue: :ERROR_TYPE_NOT_REGISTERED }, [], CAST({:name: type_name_str_value} AS {String@symbol}Any)));
          RETURN;
        END
        node__set_kind_mut(&node, TRY (aST__kind_of_type(type_sym)));
        RETURN;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__emit_error_type_conflict_mut(MUTABLE self: TypeAnalysisSession, site: Site, type_name: String, conflict: {String@symbol}?ErrorTypeConflictValue) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE first_site: ?Token = COPY CAST(conflict[:first_site] AS ?Token);
    MUTABLE first_loc: String = "";
    IF first_site EXISTS AS first_site_value THEN
      first_loc = " (first registered at line ${first_site_value.line.toString()})";
    ELSE
      first_loc = "";
    END
    IF ruby_union_scalar_equal_optional_ErrorTypeConflictValue_Bool(conflict[:is_stdlib], TRUE) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castSiteToLocatable(site)), TypeAnalysisCodeOrMessage{ SymbolValue: :ERROR_TYPE_RESERVED_BY_STDLIB }, [], {:name: type_name, :kind: CAST(conflict[:existing_kind] AS String@symbol)}));
    ELSE
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castSiteToLocatable(site)), TypeAnalysisCodeOrMessage{ SymbolValue: :ERROR_TYPE_KIND_CONFLICT }, [], {:name: type_name, :kind: CAST(conflict[:existing_kind] AS String@symbol), :first_loc: first_loc}));
    END
}
END
PRIVATE FN typeAnalysisSession__visit_ReturnNode(MUTABLE self: TypeAnalysisSession, MUTABLE node: ReturnNode) RETURNS !?Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_ctx = typeAnalysisSession__current_fn_ctx_mut(&rtoc_self_view);
    MUTABLE expected = COPY fn_ctx.return_type;
    MUTABLE raw_value: ?Locatable@boxed = COPY node.value;
    MUTABLE value: ?Locatable = raw_value;
    MUTABLE return_payload = (TRY (type__plain_return_payload_type(expected)) OR_ELSE expected);
    IF (value IS_A BgBlock AND TRY (type__single_future?(return_payload))) THEN
      value.declared_async_payload = TRY (type__new(castTypeToTypeConstructionInput__type_analysis_session(TRY (type__tense_type(return_payload)))));
    END
    IF (value IS_A ListLit AND ((type__collection?(return_payload) OR type__tuple?(return_payload)))) THEN
      locatable__set_coerced_type_object_mut(&value, return_payload);
    ELSE_IF (value IS_A HashLit AND type__map?(return_payload)) THEN
      locatable__set_coerced_type_object_mut(&value, return_payload);
    END
    TRY (typeAnalysisSession__visit(&rtoc_self_view, value));
    MUTABLE inline_bg_sources = CAST((TRY (typeAnalysisSession__collect_bg_sources_in_expr(&rtoc_self_view, UNWRAP (castLocatableToBgSourceWalkValue(UNWRAP (value))))) |> DISTINCT _) AS []SymbolEntry@multiowned);
    IF (inline_bg_sources).any?() THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ ReturnNode: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :RETURN_BORROWED_NO_COPY_OR_LIFETIME }, [], {:type: CAST((TRY (aST__full_type_mut(value))) AS String)}));
    END
    IF typeAnalysisSession__inside_with_block?(&rtoc_self_view) THEN
      IF (value IS_A Identifier AND ((locatable__symbol(UNWRAP (value)) != NIL) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_437 = ((locatable__symbol(UNWRAP (value)))?);
      symbolEntry__non_escaping(rtoc_local_receiver_437) })) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ ReturnNode: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :RETURN_FROM_WITH_SCOPED }, [], CAST({:name: locatable__name(UNWRAP (value))} AS {String@symbol}Any)));
      ELSE_IF ((value IS_A GetField AND TRUE) AND ((locatable__target(UNWRAP (value)).symbol != NIL) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_438 = ((locatable__target(UNWRAP (value)).symbol)?);
      symbolEntry__non_escaping(rtoc_local_receiver_438) })) THEN
        MUTABLE returned_type = TRY (aST__full_type_mut(value));
        IF !(TRY (type__implicitly_copyable?(returned_type, %(type: String@symbol) USE(MUTABLE rtoc_self_view) -> TRY (typeAnalysisSession__schema_lookup_result(&rtoc_self_view, type))))) THEN
          TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ ReturnNode: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :RETURN_FIELD_FROM_WITH_SCOPED }));
        END
      ELSE_IF ((value IS_A GetIndex AND TRUE) AND ((locatable__target(UNWRAP (value)).symbol != NIL) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_439 = ((locatable__target(UNWRAP (value)).symbol)?);
      symbolEntry__non_escaping(rtoc_local_receiver_439) })) THEN
        returned_type = TRY (aST__full_type_mut(value));
        IF !(TRY (type__implicitly_copyable?(returned_type, %(type: String@symbol) USE(MUTABLE rtoc_self_view) -> TRY (typeAnalysisSession__schema_lookup_result(&rtoc_self_view, type))))) THEN
          TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ ReturnNode: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :RETURN_INDEX_FROM_WITH_SCOPED }));
        END
      END
    END
    IF value IS_A IfStatement THEN
      TRY (typeAnalysisSession__promote_to_expr_if_mut(&rtoc_self_view, Locatable{ ReturnNode: COPY node }, &value));
    END
    IF value IS_A MatchStatement THEN
      TRY (typeAnalysisSession__promote_to_expr_match_mut(&rtoc_self_view, Locatable{ ReturnNode: COPY node }, &value));
    END
    MUTABLE rtoc_open_1 = UNWRAP (value);
    TRY (typeAnalysisSession__verify_return(&rtoc_self_view, &rtoc_open_1));
    TRY (typeAnalysisSession__verify_tied_return_mut(&rtoc_self_view, node));
    MUTABLE actual = locatable__resolved_type(UNWRAP (value));
    MUTABLE rtoc_open_2 = UNWRAP (value);
    MUTABLE actual_full = TRY (typeAnalysisSession__return_value_type(&rtoc_self_view, &rtoc_open_2));
    IF value IS_A Identifier THEN
      MUTABLE vti = TRY (aST__full_type_mut(value));
      IF (vti AND !(TRY (type__implicitly_copyable?(vti, %(t: String@symbol) USE(MUTABLE rtoc_self_view) -> TRY (typeAnalysisSession__schema_lookup_result(&rtoc_self_view, t)))))) THEN
        value.was_moved = TRUE;
      END
      MUTABLE vt_branch_value: ?Type = NIL;
      IF vti IS_A Type THEN
        vt_branch_value = vti;
      ELSE
        vt_branch_value = ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_440: ?Type = NIL;
        IF vti THEN
          rtoc_ternary_value_440 = TRY (type__new(vti));
        ELSE
          rtoc_ternary_value_440 = NIL;
        END
        rtoc_ternary_value_440? });
      END
      MUTABLE vt: ?Type = vt_branch_value;
      IF vt EXISTS AS vt_value THEN
        IF type__future?(vt_value) THEN
        TRY (typeAnalysisSession__og_set_moved(&rtoc_self_view, locatable__name(UNWRAP (value)), locatable__token(UNWRAP (value)), :return));
      END
      END
    END
    IF !(value IS_A Identifier) THEN
      IF ((type__heap_return_storage?(expected) AND TRUE) AND TRY (type__requires_move?((TRY (aST__full_type_mut(value)))))) THEN
        value.storage = :heap;
      END
    END
    MUTABLE actual_is_auto = type__auto?(actual_full);
    MUTABLE expected_is_auto = type__auto?(expected);
    MUTABLE return_checkable = (((!(actual_is_auto) AND !(expected_is_auto)) AND !((type__resolved(expected) == :Void))) AND !((type__resolved(expected) == :Any)));
    IF (return_checkable AND !(TRY (typeAnalysisSession__return_type_compatible?(&rtoc_self_view, CAST(actual_full AS Type), expected)))) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ ReturnNode: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :RETURN_MISMATCH }, [], {:expected: TRY (typeAnalysisSession__type_display(&rtoc_self_view, expected)), :got: TRY (typeAnalysisSession__type_display(&rtoc_self_view, CAST(actual_full AS Type)))}));
    ELSE_IF (return_checkable AND (actual != expected)) THEN
      MUTABLE value_is_fallible = (!((TRY (typeAnalysisSession__recoverable_result_type(&rtoc_self_view, &value, "return value")) == NIL)) OR type__error_union?(actual_full));
      MUTABLE coerce_target =     IF (!(value_is_fallible) AND (TRY (type__plain_return_payload_type(expected)) != NIL)) THEN
        TRY (type__plain_return_payload_type(expected))
      ELSE
        expected
      END;
      locatable__set_coerced_type_object_mut(&value, coerce_target);
      TRY (typeAnalysisSession__check_prefixed_int_range_mut(&rtoc_self_view, value, coerce_target));
    END
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ ReturnNode: COPY node }, actual));
    MUTABLE return_fact_type: Type = (locatable__coerced_type_info(UNWRAP (value)) OR actual_full);
    &fn_ctx.returns.append(COPY ReturnFact{ storage: COPY CAST(locatable__storage(UNWRAP (value)) AS ?String@symbol), type: COPY symbol((TRY (type__coercion_surface_name(castTypeToTypeTypeInput__type_analysis_session(return_fact_type))))), metatype: COPY CAST(aST__metatype(value) AS ?String@symbol) });
    rtoc_self_view.traversal_state.branch_terminated = TRUE;
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__return_value_type(MUTABLE self: TypeAnalysisSession, MUTABLE value: Locatable) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN TRY (aST__full_type_mut(value));
}
END
PRIVATE FN typeAnalysisSession__return_type_compatible?(MUTABLE self: TypeAnalysisSession, actual_type: Type, expected_type: Type) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (type__any?(expected_type) OR type__any?(actual_type)) THEN
      RETURN TRUE;
    END
    IF (type__resolved(actual_type) == :NoReturn) THEN
      RETURN TRUE;
    END
    IF type__fn_type?(expected_type) THEN
      RETURN TRY (type__accepts?(expected_type, actual_type));
    END
    IF (type__optional?(expected_type) AND (type__resolved(actual_type) == symbol("NIL"))) THEN
      RETURN TRUE;
    END
    IF TRY (typeAnalysisSession__union_payload_variant(&rtoc_self_view, expected_type, actual_type)) THEN
      RETURN TRUE;
    END
    IF !(TRY (typeAnalysisSession__same_return_capabilities?(&rtoc_self_view, expected_type, actual_type))) THEN
      RETURN FALSE;
    END
    RETURN TRY (typeAnalysisSession__is_safe_autocast?(rtoc_self_view, castTypeToOptionalSourceType(actual_type), castTypeToTypeTypeInput__type_analysis_session(expected_type)));
}
END
PRIVATE FN typeAnalysisSession__union_payload_variant(MUTABLE self: TypeAnalysisSession, expected_type: Type, actual_type: Type) RETURNS !?TypeAnalysisSessionReturnValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE target_type = TRY (type__value_payload_type(expected_type));
    MUTABLE schema: ?SchemaValue = TRY (typeAnalysisSession__lookup_type_schema(&rtoc_self_view, type__resolved(target_type)));
    RETURN castOptionalUnionPayloadCompatibilityReturnValueToOptionalTypeAnalysisSessionReturnValue(TRY (unionPayloadCompatibility__unique_variant(expected_type, actual_type, schema)));
}
END
PRIVATE FN typeAnalysisSession__same_return_capabilities?(MUTABLE self: TypeAnalysisSession, expected_t: Type, actual_t: Type) RETURNS !?Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE name = COPY CAST(type__resolved(expected_t) AS String);
    IF (((((compilerRegexMatch(name, compilerRegexCompile("\\A[A-Z]\\z")) AND !(TRY (typeAnalysisSession__lookup_type_schema(&rtoc_self_view, symbol(name))))) AND type__polymorphic_shared?(expected_t)) AND type__shared?(actual_t)) AND (type__sync(expected_t) == NIL)) AND (type__resolved(expected_t) == type__resolved(actual_t))) THEN
      RETURN TRUE;
    END
    MUTABLE layout_ok = ((type__layout(expected_t) == type__layout(actual_t)) OR type__indirect?(expected_t));
    MUTABLE elem_own: RuntimeCallSpec = %(t) -> {
    IF (type__elem_ownership(t) == :affine) THEN
      RETURN NIL;
    ELSE
      RETURN type__elem_ownership(t);
    END
    NIL
    };
    RETURN (((((((type__ownership(expected_t) == type__ownership(actual_t)) AND (type__sync(expected_t) == type__sync(actual_t))) AND layout_ok) AND (runtimeCallSpec__call(elem_own, expected_t) == runtimeCallSpec__call(elem_own, actual_t))) AND (type__elem_sync(expected_t) == type__elem_sync(actual_t)))) == TRUE);
}
END
PRIVATE FN typeAnalysisSession__type_display(MUTABLE self: TypeAnalysisSession, type: Type) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE parts = [TRY (type__surface_name_type(type))];
    MUTABLE ownership: ?String = type__ownership_surface_name(type);
    MUTABLE sync: ?String = type__sync_surface_name(type);
    IF ownership EXISTS AS ownership_value THEN
      &parts.append(ownership_value);
    END
    IF sync EXISTS AS sync_value THEN
      &parts.append(sync_value);
    END
    RETURN parts.join(" ");
}
END
PRIVATE FN typeAnalysisSession__visit_OrElse(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rhs_propagates = (((node.right IS_A OrElseRaise OR node.right IS_A OrElseExit) OR node.right IS_A ThrowNode) OR node.right IS_A ReturnNode);
    typeAnalysisSession__with_body_fact_failure_absorbed(&rtoc_self_view, !(rhs_propagates), %() USE(node, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_442 = TRY (typeAnalysisSession__visit(&rtoc_self_view, node.left));
    rtoc_lambda_result_442
    });
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.right));
    MUTABLE t_right_type = TRY (aST__full_type_mut(node.right));
    MUTABLE bare_nil = (IF node.left IS_A Literal AS left_literal THEN (left_literal.type == symbol("NIL")) ELSE FALSE END);
    MUTABLE t_left_type: ?Type =   IF (bare_nil AND (type__resolved(t_right_type) != :NoReturn)) THEN
      {
    MUTABLE rtoc_value_block_marker = 0;
    contextual = TRY (type__optional_of(TypeTypeInput{ Type: COPY t_right_type }));
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, &node.left, contextual));
    contextual
    }
    ELSE
      TRY (typeAnalysisSession__recoverable_result_type(&rtoc_self_view, &node.left, "OR_ELSE left"))
    END;
    IF !(t_left_type) THEN
      MUTABLE left_value_type = TRY (type__new(TypeConstructionInput{ Type: COPY TRY (aST__full_type_mut(node.left)) }));
      IF TRY (typeAnalysisSession__fault_recoverable_result?(&rtoc_self_view, &node.left)) THEN
        t_left_type = TRY (type__error_union_of(castTypeToTypeTypeInput__type_analysis_session(left_value_type)));
        IF ((node.left IS_A BinaryOp AND locatable__smooth?(node.left)) AND TRUE) THEN
          node.left.error_union_type = t_left_type;
        END
      ELSE_IF type__optional?(left_value_type) THEN
        t_left_type = COPY left_value_type;
      ELSE_IF (node.left IS_A FuncCall AND (TRY (typeAnalysisSession__function_node_map(&rtoc_self_view))).contains?(node.left.name())) THEN
        TRY (typeAnalysisSession__record_deferred_recovery_validation_mut(&rtoc_self_view, &node, castLocatableToFuncCall__type_analysis_session(node.left), node.left.name(), left_value_type));
        t_left_type = TRY (type__error_union_of(castTypeToTypeTypeInput__type_analysis_session(left_value_type)));
      ELSE
        t_left_type = left_value_type;
      END
    END
    IF !((type__error_union?(UNWRAP (t_left_type)) OR type__optional?(t_left_type))) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ BinaryOp: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :OR_ELSE_NEEDS_RECOVERABLE_LEFT }, [], {:got: TRY (typeAnalysisSession__type_display(&rtoc_self_view, CAST(t_left_type AS Type)))}));
    END
    IF node.right IS_A OrElseBreak THEN
      IF (typeAnalysisSession__current_loop_depth(&rtoc_self_view) <= 0) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ BinaryOp: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :OR_BREAK_OUTSIDE_WHILE }));
      END
    END
    MUTABLE operation, recovery = typeAnalysisSession__or_else_operation(&rtoc_self_view, node.right);
    MUTABLE plan = TRY (typeAnalysisSession__plan_or_else_with_diagnostic(&rtoc_self_view, node, CAST(t_left_type AS Type), t_right_type, operation, recovery));
    MUTABLE plan_value: TenseOperationPlan = plan?;
    node.tense_plan = TensePlanValue{ TenseOperationPlan: COPY plan_value };
    IF (recovery == TenseRecovery.Fallback) THEN
      TRY (typeAnalysisSession__coerce_empty_collection_fallback_mut(&rtoc_self_view, node.right, plan_value.result_type));
    END
    RETURN TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BinaryOp: COPY node }, plan_value.result_type));
}
END
PRIVATE FN typeAnalysisSession__plan_or_else_with_diagnostic(MUTABLE self: TypeAnalysisSession, node: BinaryOp, left_type: Type, right_type: Type, operation: TenseOperationKind, recovery: TenseRecovery) RETURNS !TenseOperationPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN TRY (tenseOperationPlanner__or_else(left_type, right_type, operation, recovery));
}
CATCH Input
  MUTABLE expected = TRY (type__value_payload_type(left_type));
  TRY (typeAnalysisSession__error_mut(&self, DiagnosticAnchor{ Locatable: Locatable{ BinaryOp: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :TYPE_MISMATCH_IN_OR }, [], CAST({:expected: type__resolved(expected), :got: type__resolved(right_type)} AS {String@symbol}Any)));
  RETURN TRY (tenseOperationPlanner__or_else(left_type, expected, operation, recovery));
END
PRIVATE FN typeAnalysisSession__or_else_operation(MUTABLE self: TypeAnalysisSession, node: Locatable) RETURNS Tuple<TenseOperationKind, TenseRecovery>
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (node IS_A OrElseRaise) THEN
      RETURN CAST(Tuple{TenseOperationKind.OrElseRaise, TenseRecovery.Raise} AS Tuple<TenseOperationKind, TenseRecovery>);
    ELSE_IF (node IS_A OrElseExit) THEN
      RETURN CAST(Tuple{TenseOperationKind.OrElseExit, TenseRecovery.Exit} AS Tuple<TenseOperationKind, TenseRecovery>);
    ELSE_IF (node IS_A OrElsePass) THEN
      RETURN CAST(Tuple{TenseOperationKind.OrElsePass, TenseRecovery.Pass} AS Tuple<TenseOperationKind, TenseRecovery>);
    ELSE_IF (node IS_A OrElseBreak) THEN
      RETURN CAST(Tuple{TenseOperationKind.OrElseBreak, TenseRecovery.Break} AS Tuple<TenseOperationKind, TenseRecovery>);
    ELSE_IF (node IS_A OrElsePrune) THEN
      RETURN CAST(Tuple{TenseOperationKind.OrElsePrune, TenseRecovery.Prune} AS Tuple<TenseOperationKind, TenseRecovery>);
    ELSE
      RETURN CAST(Tuple{TenseOperationKind.OrElseValue, TenseRecovery.Fallback} AS Tuple<TenseOperationKind, TenseRecovery>);
    END
}
END
PRIVATE FN typeAnalysisSession__coerce_empty_collection_fallback_mut(MUTABLE self: TypeAnalysisSession, MUTABLE rhs: Locatable, expected: ?Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !((expected != NIL)) THEN
      RETURN;
    END
    MUTABLE empty_list = (IF rhs IS_A ListLit AS list_lit THEN (list_lit.items.empty?() AND (list_lit.constructor_options == NIL)) ELSE FALSE END);
    MUTABLE empty_hash = (IF rhs IS_A HashLit AS hash_lit THEN hash_lit.pairs.empty?() ELSE FALSE END);
    IF !((empty_list OR empty_hash)) THEN
      RETURN;
    END
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, &rhs, expected));
}
END
PRIVATE FN typeAnalysisSession__visit_OrElseRaise(MUTABLE self: TypeAnalysisSession, MUTABLE node: OrElseRaise) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ OrElseRaise: COPY node }, :Void));
}
END
