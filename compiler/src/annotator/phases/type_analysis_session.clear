END
PRIVATE FN typeAnalysisSession__handle_assign_borrow(self: TypeAnalysisSession, node: Node) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((node.value() IS_A FuncCall OR node.value() IS_A MethodCall)) THEN
      RETURN;
    END
    MUTABLE call_node = node.value();
    IF aST__collection_method_call?(call_node) THEN
      RETURN;
    END
    MUTABLE actual_arg: ?Locatable = typeAnalysisSession__resolve_borrow_source(rtoc_self_view, call_node);
    IF actual_arg EXISTS AS actual_arg_value THEN
      MUTABLE actual_arg_value_mutable = COPY actual_arg_value;
      MUTABLE path = typeAnalysisSession__get_path_to_root(rtoc_self_view, castLocatableToNode(actual_arg_value_mutable));
      IF (path.length() == 0) THEN
        RETURN;
      END
      MUTABLE root_var = COPY CAST(path.first() AS String);
      MUTABLE borrowed_scope: ?Scope@multiowned = typeAnalysisSession__lookup_scope_for(rtoc_self_view, root_var);
      IF (borrowed_scope == NIL) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :BORROWED_VAR_NOT_FOUND });
      END
      IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_482 = UNWRAP (borrowed_scope);
      scope__is_immutable?(rtoc_local_receiver_482, root_var) } THEN
        RETURN;
      END
      MUTABLE lhs_name = node.name();
      IF !(TRUE) THEN
        lhs_name = "__borrow_${root_var}";
      END
      MUTABLE mutable = (IF node IS_A VarDecl AS var_decl THEN var_decl.mutable ELSE FALSE END);
      MUTABLE err: ?String = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_483 = typeAnalysisSession__ownership_graph(rtoc_self_view);
      TRY (ownershipGraph__borrow(&rtoc_mutable_receiver_483, lhs_name, root_var, mutable)) };
      IF err EXISTS AS err_value THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :LIFETIME_ALREADY_BORROWED }, [], {:name: root_var});
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__resolve_borrow_source(self: TypeAnalysisSession, call_node: TypeAnalysisCallNode) RETURNS !?Locatable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE matched_def: ?FunctionSignature@multiowned = NIL;
    MATCH call_node START
      TypeAnalysisCallNode.FuncCall AS item ->
        matched_def = COPY item.matched_stdlib_def;,
      TypeAnalysisCallNode.MethodCall AS item ->
        matched_def = COPY item.matched_stdlib_def;,
    END
    IF matched_def EXISTS AS matched_def_value THEN
      MUTABLE matched_def_value_mutable = COPY matched_def_value;
      MUTABLE lifetimes = TRY (functionSignature__intrinsic_lifetime(&matched_def_value_mutable));
      IF !((lifetimes.length() == 0)) THEN
        IF lifetimes.contains?("self") THEN
        IF call_node IS_A MethodCall AS method_call THEN
          RETURN COPY method_call.object;
        END
        END
        MUTABLE args_branch_value: ?[]Locatable = NIL;
        IF call_node IS_A MethodCall AS method_call THEN
          args_branch_value = ([method_call.object] + method_call.args);
        ELSE
          args_branch_value = (MATCH call_node START TypeAnalysisCallNode.FuncCall AS item -> item.args, TypeAnalysisCallNode.MethodCall AS item -> item.args END);
        END
        MUTABLE args: []Locatable = args_branch_value?;
        MUTABLE idx = (TRY (functionSignature__intrinsic_arg_specs(matched_def_value_mutable))).indexOf();
        IF (idx AND (args[idx] != NIL)) THEN
          RETURN COPY args[idx];
        END
        RETURN NIL;
      END
    END
    MUTABLE func_name = call_node.name();
    MUTABLE scope: ?Scope@multiowned = typeAnalysisSession__lookup_scope_for(rtoc_self_view, func_name);
    IF scope EXISTS AS scope_value THEN
      MUTABLE func_type: ?FunctionSignature@multiowned = functionSignature__unwrap(X{ Type: COPY TRY (scope__resolve_type(scope_value, func_name)) });
      IF func_type EXISTS AS func_type_value THEN
        MUTABLE lifetime = TRY (functionSignature__return_lifetime(func_type_value));
        IF ((lifetime.length() == 0) OR (lifetime == [:wildcard])) THEN
          RETURN NIL;
        END
        MUTABLE primary: ?FunctionSignatureLifetimeSource = COPY lifetime.first();
        IF ruby_union_scalar_equal_optional_FunctionSignatureLifetimeSource_String_symbol(primary, :wildcard) THEN
          RETURN NIL;
        END
        MUTABLE primary_root: ?String = COPY (CAST(primary AS String)).split(".").first();
        MUTABLE param_index = (TRY (functionSignature__params(func_type_value))).find_index(%(p: Param) USE(primary_root) -> (p.name == primary_root));
        IF !(param_index) THEN
          RETURN NIL;
        END
        MUTABLE args_branch_value: ?[]Locatable = NIL;
        IF call_node IS_A MethodCall AS method_call THEN
          args_branch_value = ([method_call.object] + method_call.args);
        ELSE
          args_branch_value = (MATCH call_node START TypeAnalysisCallNode.FuncCall AS item -> item.args, TypeAnalysisCallNode.MethodCall AS item -> item.args END);
        END
        MUTABLE args: []Locatable = args_branch_value?;
        RETURN COPY args[param_index];
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__call_returns_borrowed_view?(self: TypeAnalysisSession, call_node: TypeAnalysisCallNode) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE matched_def: ?FunctionSignature@multiowned = NIL;
    MATCH call_node START
      TypeAnalysisCallNode.FuncCall AS item ->
        matched_def = COPY item.matched_stdlib_def;,
      TypeAnalysisCallNode.MethodCall AS item ->
        matched_def = COPY item.matched_stdlib_def;,
    END
    IF ((matched_def != NIL) AND !(((TRY (functionSignature__intrinsic_lifetime(&matched_def))).length() == 0))) THEN
      RETURN TRUE;
    END
    MUTABLE scope: ?Scope@multiowned = typeAnalysisSession__lookup_scope_for(rtoc_self_view, call_node.name());
    MUTABLE signature: ?FunctionSignature@multiowned = functionSignature__unwrap(ruby_wrap_optional_Type_multiowned_X((IF scope != NIL THEN
      TRY (scope__resolve_type(scope, call_node.name()))
    ELSE
      NIL
    END)));
    RETURN (!(!(signature)) AND !(((TRY (functionSignature__return_lifetime(signature))).length() == 0)));
}
END
PRIVATE FN typeAnalysisSession__verify_unrestricted_mut(self: TypeAnalysisSession, node: Node) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE path = typeAnalysisSession__get_path_to_root(rtoc_self_view, node.name());
    IF (path.length() == 0) THEN
      RETURN;
    END
    MUTABLE root_name = COPY CAST(path.first() AS String);
    IF !({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_484 = typeAnalysisSession__ownership_graph(rtoc_self_view);
    TRY (ownershipGraph__can_write?(rtoc_local_receiver_484, root_name)) }) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :ASSIGN_WHILE_BORROWED }, [], {:name: root_name});
    END
}
END
PRIVATE FN typeAnalysisSession__finalize_scope(self: TypeAnalysisSession, node: Locatable, branch: ?String@symbol = NIL) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE drops: []DeferredDrop = ( { MUTABLE rtoc_empty_list_485: []DeferredDrop = List[]; rtoc_empty_list_485 } );
    MUTABLE rtoc_each_items_486 = typeAnalysisSession__current_scope(rtoc_self_view).owned_names;
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_486.length() DO
      MUTABLE info: ?SymbolEntry@multiowned = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_487 = typeAnalysisSession__current_scope(rtoc_self_view);
      scope__local_entry(rtoc_local_receiver_487, rtoc_each_items_486[rtoc_idx]) };
      IF !(info) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE is_takes = (TRUE AND symbolEntry__takes(info));
      IF !(({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_488 = typeAnalysisSession__ownership_graph(rtoc_self_view);
      ownershipGraph__live?(rtoc_local_receiver_488, rtoc_each_items_486[rtoc_idx]) } OR ((is_takes AND ((ownershipGraph__get_index(typeAnalysisSession__ownership_graph(rtoc_self_view), rtoc_each_items_486[rtoc_idx]) != NIL) AND ownershipNode__moved?(((ownershipGraph__get_index(typeAnalysisSession__ownership_graph(rtoc_self_view), rtoc_each_items_486[rtoc_idx]))?))))))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !(symbolEntry__ownership_kind(info)) THEN
          typeAnalysisSession__classify_ownership_mut(rtoc_self_view, UNWRAP (info));
      END
      IF (symbolEntry__ownership_kind(info) == :resource) THEN
          &drops.append(typeAnalysisSession__deferred_drop_for(rtoc_self_view, rtoc_each_items_486[rtoc_idx], UNWRAP (info), TRUE));
          TRY (typeAnalysisSession__og_drop(rtoc_self_view, rtoc_each_items_486[rtoc_idx]));
      ELSE_IF (symbolEntry__ownership_kind(info) == :affine) THEN
          MUTABLE t = TRY (type__new(TypeConstructionInput{ Type: COPY symbolEntry__type(info) }));
          IF (TRY (type__single_future?(t)) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_491 = typeAnalysisSession__ownership_graph(rtoc_self_view);
          ownershipGraph__live?(rtoc_local_receiver_491, rtoc_each_items_486[rtoc_idx]) }) THEN
            typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :PROMISE_NOT_CONSUMED }, [], {:name: rtoc_each_items_486[rtoc_idx]});
          END
          &drops.append(typeAnalysisSession__deferred_drop_for(rtoc_self_view, rtoc_each_items_486[rtoc_idx], UNWRAP (info)));
          TRY (typeAnalysisSession__og_drop(rtoc_self_view, rtoc_each_items_486[rtoc_idx]));
      END
    rtoc_idx = rtoc_idx + 1;
    END
    IF (branch == :then) THEN
      MUTABLE rtoc_writer_receiver_492: IfStatement = castLocatableToIfStatement(node);
      rtoc_writer_receiver_492.then_drops = drops;
    ELSE_IF (branch == :else) THEN
      MUTABLE rtoc_writer_receiver_493: IfStatement = castLocatableToIfStatement(node);
      rtoc_writer_receiver_493.else_drops = drops;
    ELSE
      node.deferred_drops = drops;
    END
    IF (branch == NIL) THEN
      MUTABLE rtoc_each_items_494 = typeAnalysisSession__current_scope(rtoc_self_view).owned_names;
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < rtoc_each_items_494.length() DO
      MUTABLE info: ?SymbolEntry@multiowned = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_495 = typeAnalysisSession__current_scope(rtoc_self_view);
      scope__local_entry(rtoc_local_receiver_495, rtoc_each_items_494[rtoc_idx]) };
      IF !(info) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF rtoc_each_items_494[rtoc_idx].startsWith?("_") THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF symbolEntry__read(info) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF (respondsTo?(info.reg, "var_used") AND info.reg.var_used()) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !(symbolEntry__ownership_kind(info)) THEN
            typeAnalysisSession__classify_ownership_mut(rtoc_self_view, UNWRAP (info));
      END
      IF ([:resource, :collection, :rc]).contains?(symbolEntry__ownership_kind(info)) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !(info.reg) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE loc: String = "";
          IF respondsTo?(info.reg, "line") THEN
            loc = " (line ${info.reg.line()})";
          ELSE
            loc = "";
          END
      print("\x1B[33m[Warning]\x1B[0m Unused variable '${rtoc_each_items_494[rtoc_idx]}'${loc}");
    rtoc_idx = rtoc_idx + 1;
      END
      MUTABLE rtoc_each_items_496 = typeAnalysisSession__current_scope(rtoc_self_view).owned_names;
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < rtoc_each_items_496.length() DO
      MUTABLE info: ?SymbolEntry@multiowned = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_497 = typeAnalysisSession__current_scope(rtoc_self_view);
      scope__local_entry(rtoc_local_receiver_497, rtoc_each_items_496[rtoc_idx]) };
      IF !(info) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF rtoc_each_items_496[rtoc_idx].startsWith?("_") THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !(info.mutable) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !((symbolEntry__read(info) OR ((respondsTo?(info.reg, "var_used") AND info.reg.var_used())))) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF (respondsTo?(info.reg, "var_mutated") AND info.reg.var_mutated()) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF (TRUE AND symbolEntry__mutated(info)) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      typeAnalysisSession__emit_mutable_unused_finding_mut(rtoc_self_view, castOptionalSymbolEntryRegInputToOptionalReg(info.reg), rtoc_each_items_496[rtoc_idx]);
    rtoc_idx = rtoc_idx + 1;
      END
    END
    NIL;
}
END
PRIVATE FN typeAnalysisSession__collect_scope_drops(self: TypeAnalysisSession, node: ?MatchStatement = NIL) RETURNS ![]DeferredDrop
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE drops: []DeferredDrop = ( { MUTABLE rtoc_empty_list_498: []DeferredDrop = List[]; rtoc_empty_list_498 } );
    FOR _ IN ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_499 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__owned_entries(rtoc_local_receiver_499)) }) DO
    MUTABLE rtoc_mutable_block_param_503 = COPY _;
    IF !({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_502 = typeAnalysisSession__ownership_graph(rtoc_self_view);
    ownershipGraph__live?(rtoc_local_receiver_502, rtoc_mutable_block_param_503._0) }) THEN
      CONTINUE;
    END
    IF !(symbolEntry__ownership_kind(rtoc_mutable_block_param_503._1)) THEN
        typeAnalysisSession__classify_ownership_mut(rtoc_self_view, &rtoc_mutable_block_param_503._1);
    END
    IF (symbolEntry__ownership_kind(rtoc_mutable_block_param_503._1) == :resource) THEN
        &drops.append(typeAnalysisSession__deferred_drop_for(rtoc_self_view, rtoc_mutable_block_param_503._0, rtoc_mutable_block_param_503._1, TRUE));
        TRY (typeAnalysisSession__og_drop(rtoc_self_view, rtoc_mutable_block_param_503._0));
    ELSE_IF (symbolEntry__ownership_kind(rtoc_mutable_block_param_503._1) == :affine) THEN
        MUTABLE t = TRY (type__new(rtoc_mutable_block_param_503._1.type()));
        IF ((node != NIL) AND TRY (type__single_future?(t))) THEN
          typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :PROMISE_NOT_CONSUMED }, [], {:name: rtoc_mutable_block_param_503._0});
        END
        &drops.append(typeAnalysisSession__deferred_drop_for(rtoc_self_view, rtoc_mutable_block_param_503._0, rtoc_mutable_block_param_503._1));
        TRY (typeAnalysisSession__og_drop(rtoc_self_view, rtoc_mutable_block_param_503._0));
    END
    END
    RETURN drops;
}
END
PRIVATE FN typeAnalysisSession__deferred_drop_for(self: TypeAnalysisSession, name: String, info: SymbolEntry, resource: Bool = FALSE) RETURNS !DeferredDrop
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN DeferredDrop{ name: COPY name, type: COPY TRY (type__from_node_mut(symbolEntry__type(info), "deferred drop type")), resource: COPY resource };
}
END
PRIVATE FN typeAnalysisSession__mark_chain_needs_mut_ref_mut(self: TypeAnalysisSession, node: Locatable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE curr: ?Locatable = COPY node;
    WHILE curr DO
      IF curr? IS_A GetIndex AS get_index THEN
        MUTABLE get_index_mutable = COPY get_index;
        get_index_mutable.needs_mut_ref = TRUE;
      END
      curr = IF respondsTo?(curr, "target") THEN
        curr.target()
      ELSE
        NIL
      END;
    END
}
END
PRIVATE FN typeAnalysisSession__get_path_to_root(self: TypeAnalysisSession, node: Node) RETURNS ![]String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE path = List[];
    MUTABLE curr: Any = COPY node;
    WHILE ((curr IS_A GetField OR curr IS_A GetIndex) OR curr IS_A OptionalUnwrap) DO
      IF curr IS_A GetField THEN
        &path.unshift(type__to_sym(curr.field()));
      END
      IF curr IS_A GetIndex THEN
        &path.unshift(symbol("*"));
      END
      curr = curr.target();
    END
    IF !(curr IS_A Identifier) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_504: []String@symbol = List[]; rtoc_empty_list_504 } ) AS []String@symbol);
    END
    &path.unshift(type__to_sym(curr.name()));
    RETURN path;
}
END
PRIVATE FN typeAnalysisSession__verify_tied_assignment_mut(self: TypeAnalysisSession, assign_node: Assignment) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE val = COPY assign_node.value;
    MUTABLE sym = IF TRUE THEN
      aST__node__symbol(val)
    ELSE
      NIL
    END;
    MUTABLE sources: []SymbolEntry@multiowned = typeAnalysisSession__lifetime_sources_for_value(rtoc_self_view, val);
    IF (sources.length() == 0) THEN
      RETURN;
    END
    IF (TRUE AND (sources == [sym])) THEN
      RETURN;
    END
    MUTABLE dest_depth: ?Int64 = typeAnalysisSession__dest_scope_depth_for_target(rtoc_self_view, castAssignmentNameToLocatable(assign_node.name));
    IF dest_depth EXISTS AS dest_depth_value THEN
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < sources.length() DO
      IF ((sources[rtoc_idx]?.scope_depth) == NIL) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !((dest_depth_value < UNWRAP (sources[rtoc_idx]?.scope_depth))) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE source_name = (typeAnalysisSession__lookup_source_name(rtoc_self_view, sources[rtoc_idx]?) OR_ELSE "(unnamed)");
      MUTABLE msg = "Lifetime Error: cannot store value tied to '${source_name}' (declared at scope depth ${sources[rtoc_idx]?.scope_depth}) into a destination at scope depth ${dest_depth_value.toString()} -- the destination outlives the source. Move the destination into the same scope, or COPY the value.";
      MUTABLE fix: ?Fix@multiowned = typeAnalysisSession__build_atomic_escape_migration_fix(rtoc_self_view, sources[rtoc_idx]?, source_name);
      IF fix EXISTS AS fix_value THEN
            typeAnalysisSession__fixable_mut(rtoc_self_view, assign_node, :escape, [fix_value], NIL, :ATOMIC_ESCAPE_ASSIGN, :error, TRUE, {:detail: msg});
      ELSE
            typeAnalysisSession__error_mut(rtoc_self_view, assign_node, TypeAnalysisCodeOrMessage{ SymbolValue: :ATOMIC_ESCAPE_ASSIGN }, [], {:detail: msg});
      END
    rtoc_idx = rtoc_idx + 1;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__verify_tied_return_mut(self: TypeAnalysisSession, return_node: ReturnNode) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE val = return_node.value;
    IF !(val IS_A Identifier) THEN
      RETURN;
    END
    MUTABLE sym = aST__node__symbol(val);
    IF !(sym) THEN
      RETURN;
    END
    MUTABLE sources = TRY (symbolEntry__lifetime_sources(sym));
    IF sources.empty?() THEN
      RETURN;
    END
    IF (sources == [sym]) THEN
      RETURN;
    END
    MUTABLE fn_node: ?FunctionDef@multiowned = typeAnalysisSession__function_node_for(rtoc_self_view, typeAnalysisSession__current_fn_ctx(rtoc_self_view)?.name);
    MUTABLE rl: ?Any = COPY fn_node?.return_lifetime;
    IF (rl == :wildcard) THEN
      RETURN;
    END
    MUTABLE declared = (rl OR_ELSE List[]);
    MUTABLE declared_names = declared |> UNNEST {
    MUTABLE path = typeAnalysisSession__get_path_to_root(rtoc_self_view, _);
    ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_506: ?[]Any = NIL;
      IF (path.length() == 0) THEN
        rtoc_ternary_value_506 = List[];
      ELSE
        rtoc_ternary_value_506 = [CAST(symbol(UNWRAP (path.first())) AS String)];
      END
      rtoc_ternary_value_506? })
    };
    MUTABLE source_names = (sources |> SELECT typeAnalysisSession__lookup_source_name(rtoc_self_view, _)) |> WHERE _ != NIL;
    MUTABLE matched = source_names |> ANY declared_names.contains?(_);
    IF matched THEN
      RETURN;
    END
    MUTABLE sources_msg: String = "";
    IF source_names.empty?() THEN
      sources_msg = "(unnamed source)";
    ELSE
      sources_msg = source_names.join(", ");
    END
    MUTABLE declared_msg: String = "";
    IF declared_names.empty?() THEN
      declared_msg = "no `RETURNS <name>:T`";
    ELSE
      declared_msg = "`RETURNS ${declared_names.join(", ")}:T`";
    END
    MUTABLE msg = "Lifetime Error: cannot RETURN a value whose lifetime is tied to ${sources_msg}, because the enclosing function declares ${declared_msg} -- the caller's scope outlives the source. Either declare the function as `RETURNS ${source_names.first()}:T` (propagates the lifetime to the caller), or COPY the value before returning it.";
    MUTABLE atomic_fix: Any = NIL;
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < sources.length() DO
      MUTABLE name = ((source_names[rtoc_idx] OR typeAnalysisSession__lookup_source_name(rtoc_self_view, sources[rtoc_idx])) OR "(unnamed)");
      MUTABLE f: ?Fix@multiowned = typeAnalysisSession__build_atomic_escape_migration_fix(rtoc_self_view, sources[rtoc_idx], name);
      IF f EXISTS AS f_value THEN
          atomic_fix = f_value;
          BREAK;
      END
    rtoc_idx = rtoc_idx + 1;
    END
    IF atomic_fix THEN
      typeAnalysisSession__fixable_mut(rtoc_self_view, return_node, :escape, [atomic_fix], NIL, :ATOMIC_ESCAPE_RETURN, :error, TRUE, {:detail: msg});
    ELSE
      typeAnalysisSession__error_mut(rtoc_self_view, return_node, TypeAnalysisCodeOrMessage{ SymbolValue: :ATOMIC_ESCAPE_RETURN }, [], {:detail: msg});
    END
}
END
PRIVATE FN typeAnalysisSession__lookup_source_name(self: TypeAnalysisSession, sym: SymbolEntry) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE sc: ?Scope = COPY sym.scope;
    IF sc EXISTS AS sc_value THEN
      FOR rtoc_key IN (TRY (scope__visible_entries(sc_value))).keys() DO
    MUTABLE entry: SymbolEntry@multiowned = ((TRY (scope__visible_entries(sc_value)))[rtoc_key] OR_ELSE CAST(panic("missing hash key") AS SymbolEntry@multiowned));
      IF entry.equal?(sym) THEN
        RETURN COPY rtoc_key;
      END
      END
    END
    FOR _ IN (TRY (typeAnalysisSession__function_node_map(rtoc_self_view))).values() DO
    IF !(respondsTo?(_, "params")) THEN
      CONTINUE;
    END
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < _.params.length() DO
      IF _.params[rtoc_idx].symbol.equal?(sym) THEN
          RETURN COPY CAST(_.params[rtoc_idx].name AS String);
      END
      rtoc_idx = rtoc_idx + 1;
    END
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__lifetime_sources_for_value(self: TypeAnalysisSession, val_node: Locatable) RETURNS ![]SymbolEntry@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE sources: []SymbolEntry@multiowned = ( { MUTABLE rtoc_empty_list_507: []SymbolEntry@multiowned = List[]; rtoc_empty_list_507 } );
    IF TRUE THEN
      MUTABLE sym = val_aST__node__symbol(node);
      IF sym THEN
        sources = ruby_array_concat_SymbolEntry_multiowned(sources, CAST(TRY (symbolEntry__lifetime_sources(sym)) AS []SymbolEntry@multiowned));
      END
    END
    sources = ruby_array_concat_SymbolEntry_multiowned(sources, typeAnalysisSession__collect_bg_sources_in_expr(rtoc_self_view, castLocatableToOptionalBgSourceWalkValue(val_node)));
    RETURN CAST((sources |> DISTINCT _) AS []SymbolEntry@multiowned);
}
END
PRIVATE FN typeAnalysisSession__dest_scope_depth_for_target(self: TypeAnalysisSession, target_node: Locatable) RETURNS ?Int64
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF target_node IS_A Identifier AS identifier THEN
      MUTABLE sym: ?SymbolEntry = identifier.symbol;
      sym = (sym OR_ELSE (IF typeAnalysisSession__lookup_scope_for(rtoc_self_view, identifier__name(identifier)) != NIL THEN
        { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_508 = (typeAnalysisSession__lookup_scope_for(rtoc_self_view, identifier__name(identifier)));
      scope__resolve_entry(rtoc_local_receiver_508, identifier__name(identifier)) }
      ELSE
        NIL
      END));
      IF sym != NIL THEN
    RETURN (sym?).scope_depth;
      ELSE
    RETURN NIL;
      END
    END
    IF (target_node IS_A GetField OR target_node IS_A GetIndex) THEN
      RETURN typeAnalysisSession__dest_scope_depth_for_target(rtoc_self_view, target_node.target());
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__stamp_bg_handle_lifetime_mut(self: TypeAnalysisSession, decl_node: DeclNode) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE sources = CAST(((typeAnalysisSession__collect_bg_sources_in_expr(rtoc_self_view, (MATCH decl_node START DeclNode.VarDecl AS item -> item.value, DeclNode.BindExpr AS item -> item.value END))) |> DISTINCT _) AS []SymbolEntry@multiowned);
    IF sources.empty?() THEN
      RETURN;
    END
    MUTABLE sym: ?SymbolEntry = NIL;
    MATCH decl_node START
      DeclNode.VarDecl AS item ->
        sym = COPY item.symbol;,
      DeclNode.BindExpr AS item ->
        sym = COPY item.symbol;,
    END
    IF sym EXISTS AS sym_value THEN
      MUTABLE sym_value_mutable = COPY sym_value;
      sym_value_mutable.lifetime = TRY (symbolEntry__tied_lifetime(sources));
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__stamp_init_contents_heap_mut(self: TypeAnalysisSession, decl_node: DeclNode) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE sym: ?SymbolEntry = NIL;
    MATCH decl_node START
      DeclNode.VarDecl AS item ->
        sym = COPY item.symbol;,
      DeclNode.BindExpr AS item ->
        sym = COPY item.symbol;,
    END
    IF sym EXISTS AS sym_value THEN
      MUTABLE sym_value_mutable = COPY sym_value;
      MUTABLE init = (MATCH decl_node START DeclNode.VarDecl AS item -> item.value, DeclNode.BindExpr AS item -> item.value END);
      IF typeAnalysisSession__init_value_contents_heap?(rtoc_self_view, init) THEN
        symbolEntry__mark_init_contents_heap_mut(&sym_value_mutable);
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__init_value_contents_heap?(self: TypeAnalysisSession, init: ?Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF init EXISTS AS init_value THEN
      IF init_value IS_A StructLit AS struct_lit THEN
        RETURN struct_lit.fields |> ALL (IF !(_._1) THEN TRUE ELSE { MUTABLE rtoc_value_block_marker = 0; MUTABLE fti = TRY (type__from_node_mut(_._1, "heap init field")); (IF !((TRY (type__string?(fti)) OR type__collection?(fti))) THEN TRUE ELSE (_._1 IS_A Locatable AND symbolEntry__heap_storage?(_._1)) END) } END);
      ELSE_IF init_value IS_A UnionVariantLit AS union_variant_lit THEN
        RETURN union_variant_lit.fields |> ALL (IF !(_._1) THEN TRUE ELSE { MUTABLE rtoc_value_block_marker = 0; MUTABLE fti = TRY (type__from_node_mut(_._1, "heap init field")); (IF !((TRY (type__string?(fti)) OR type__collection?(fti))) THEN TRUE ELSE (_._1 IS_A Locatable AND symbolEntry__heap_storage?(_._1)) END) } END);
      ELSE_IF (init_value IS_A FuncCall) OR (init_value IS_A MethodCall) THEN
        RETURN (TRUE AND init_value.heap_storage?());
      ELSE_IF init_value IS_A Identifier AS identifier THEN
        RETURN !(!((IF identifier.symbol != NIL THEN
          symbolEntry__init_contents_heap(identifier.symbol)
        ELSE
          NIL
        END)));
      ELSE_IF init_value IS_A CopyNode AS copy_node THEN
        RETURN TRUE;
      ELSE_IF init_value IS_A KeepNode AS keep_node THEN
        RETURN TRUE;
      ELSE_IF (init_value IS_A Cast) THEN
        RETURN typeAnalysisSession__init_value_contents_heap?(rtoc_self_view, init_value.value());
      ELSE_IF init_value IS_A IfStatement AS if_statement THEN
        MUTABLE then_tail: ?Locatable = COPY (if_statement.then_branch).last();
        MUTABLE else_tail: ?Locatable = COPY ((if_statement.else_branch OR_ELSE List[])).last();
        MUTABLE tails = ([then_tail, else_tail]);
        RETURN ((tails.size() == 2) AND (tails |> ALL typeAnalysisSession__init_value_contents_heap?(rtoc_self_view, _)));
      ELSE_IF init_value IS_A MatchStatement AS match_statement THEN
        MUTABLE cases = (match_statement.cases |> SELECT matchCase__body(_).last()) |> WHERE _ != NIL;
        MUTABLE default_tail = (IF match_statement.default_case != NIL THEN
          match_statement.default_case.last()
        ELSE
          NIL
        END);
        MUTABLE tails = (cases + ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_509: ?[]Any = NIL;
        IF default_tail THEN
          rtoc_ternary_value_509 = [default_tail];
        ELSE
          rtoc_ternary_value_509 = List[];
        END
        rtoc_ternary_value_509? }));
        RETURN (type__any?(tails) AND (tails |> ALL typeAnalysisSession__init_value_contents_heap?(rtoc_self_view, _)));
      ELSE
        RETURN FALSE;
      END
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__collect_bg_sources_in_expr(self: TypeAnalysisSession, expr: ?BgSourceWalkValue) RETURNS ![]SymbolEntry@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (((expr != NIL) AND (expr IS_A BgBlock)) OR ((expr != NIL) AND (expr IS_A BgStreamBlock))) THEN
      RETURN typeAnalysisSession__bg_sources_for_block(rtoc_self_view, expr);
    END
    IF ([AST.Identifier, AST.Literal, AST.FuncCall, AST.MethodCall, AST.GetField, AST.GetIndex, AST.BinaryOp, AST.UnaryOp] |> DISTINCT _).contains?(expr.class()) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_510: []SymbolEntry@multiowned = List[]; rtoc_empty_list_510 } ) AS []SymbolEntry@multiowned);
    END
    IF expr? IS_A Struct AS struct THEN
      RETURN struct.members() |> UNNEST {
    MUTABLE v = COPY struct[_];
    typeAnalysisSession__collect_bg_sources_walk(rtoc_self_view, v)
      };
    ELSE
      RETURN CAST(( { MUTABLE rtoc_empty_list_511: []SymbolEntry@multiowned = List[]; rtoc_empty_list_511 } ) AS []SymbolEntry@multiowned);
    END
}
END
PRIVATE FN typeAnalysisSession__collect_bg_sources_walk(self: TypeAnalysisSession, v: ?BgSourceWalkValue) RETURNS ![]SymbolEntry@multiowned
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF v IS_A []Any@multiowned AS array THEN
      RETURN array |> UNNEST typeAnalysisSession__collect_bg_sources_walk(rtoc_self_view, BgSourceWalkValue{ ArrayValue: COPY _ });
    ELSE_IF (v == Hash) THEN
      RETURN v.values() |> UNNEST typeAnalysisSession__collect_bg_sources_walk(rtoc_self_view, _);
    ELSE_IF v IS_A Struct AS struct THEN
      RETURN typeAnalysisSession__collect_bg_sources_in_expr(rtoc_self_view, BgSourceWalkValue{ Struct: COPY struct });
    ELSE
      RETURN CAST(( { MUTABLE rtoc_empty_list_512: []SymbolEntry@multiowned = List[]; rtoc_empty_list_512 } ) AS []SymbolEntry@multiowned);
    END
}
END
PRIVATE FN typeAnalysisSession__bg_sources_for_block(self: TypeAnalysisSession, expr: ?BgSourceWalkValue) RETURNS ![]SymbolEntry@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE analysis = IF respondsTo?(expr, "capture_analysis") THEN
      expr.capture_analysis()
    ELSE
      NIL
    END;
    IF !((TRUE AND respondsTo?(analysis, "capture_symbols"))) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_513: []SymbolEntry@multiowned = List[]; rtoc_empty_list_513 } ) AS []SymbolEntry@multiowned);
    END
    RETURN typeAnalysisSession__bg_lifetime_sources(rtoc_self_view, analysis);
}
END
PRIVATE FN typeAnalysisSession__bg_lifetime_sources(self: TypeAnalysisSession, analysis: CaptureAnalysis) RETURNS ![]SymbolEntry@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (analysis.capture_symbols.values() |> WHERE !((_ AND typeAnalysisSession__bg_capture_independent?(rtoc_self_view, _)))) |> WHERE _ != NIL;
}
END
PRIVATE FN typeAnalysisSession__bg_capture_independent?(self: TypeAnalysisSession, info: SymbolEntry) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF ((([:shared, :heap] |> DISTINCT _).contains?(symbolEntry__storage(info))) AND (symbolEntry__sync(info) == NIL)) THEN
      RETURN TRUE;
    END
    IF symbolEntry__atomic_ptr?(info) THEN
      RETURN TRUE;
    END
    IF ((symbolEntry__sync(info) != NIL) AND (!(([:raw, :symbol, :c, :size] |> DISTINCT _).contains?(symbolEntry__sync(info))))) THEN
      RETURN FALSE;
    END
    IF (symbolEntry__storage(info) == :multiowned) THEN
      RETURN FALSE;
    END
    MUTABLE ti_branch_value: ?Type@multiowned = NIL;
    IF TRUE THEN
      ti_branch_value = symbolEntry__type(info);
    ELSE
      ti_branch_value = NIL;
    END
    MUTABLE ti: ?Type@multiowned = ti_branch_value;
    IF ti EXISTS AS ti_value THEN
      RETURN typeAnalysisSession__value_copy_capture?(rtoc_self_view, CAST(ti_value AS Type));
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__value_copy_capture?(self: TypeAnalysisSession, t: Type) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (type__bg_capture_is_value_copy?(t, %(name) USE(rtoc_self_view) -> typeAnalysisSession__lookup_type_schema(rtoc_self_view, name)));
}
END
PRIVATE FN typeAnalysisSession__get_lifetime_paths(self: TypeAnalysisSession, func_node: FunctionDef) RETURNS ![]TypeAnalysisSessionReturnValueItem
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rl = func_node.return_lifetime;
    IF (rl == NIL) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_514: []TypeAnalysisSessionReturnValueItem = List[]; rtoc_empty_list_514 } ) AS []TypeAnalysisSessionReturnValueItem);
    END
    IF (rl == :wildcard) THEN
      RETURN CAST([TypeAnalysisSessionReturnValueItem{ SymbolValue: :wildcard }] AS []TypeAnalysisSessionReturnValueItem);
    END
    MUTABLE sources: []Any = List[];
    IF rl IS_A []Any THEN
      sources = rl;
    ELSE
      sources = [CAST(rl AS Any)];
    END
    RETURN sources |> SELECT:? {
    MUTABLE path = typeAnalysisSession__get_path_to_root(rtoc_self_view, _);
    (IF !((path.length() == 0)) THEN
        path.join(".")
      ELSE
        NIL
      END)
    } |> WHERE _ != NIL;
}
END
PRIVATE FN typeAnalysisSession__get_lifetime_path(self: TypeAnalysisSession, func_node: FunctionDef) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE paths = typeAnalysisSession__get_lifetime_paths(rtoc_self_view, func_node);
    IF ((paths.length() != 1) OR ruby_union_scalar_equal_optional_LifetimesReturnValueItem_String_symbol(paths.first(), :wildcard)) THEN
      RETURN NIL;
    END
    MUTABLE first: ?LifetimesReturnValueItem = COPY paths.first();
    IF first? IS_A String AS string THEN
      RETURN COPY string;
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__root_variable_name(self: TypeAnalysisSession, node: ?Locatable) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE curr: ?Locatable = COPY node;
    WHILE curr DO
      IF curr? IS_A Identifier AS identifier THEN
        RETURN COPY identifier__name(identifier);
      END
      curr =     IF respondsTo?(curr, "target") THEN
        curr.target()
      ELSE_IF respondsTo?(curr, "object") THEN
        curr.object()
      ELSE
        NIL
      END;
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__set_cleanup_alloc_mut(self: TypeAnalysisSession, MUTABLE node: Node) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE ti = &node.full_type_mut("cleanup binding");
    IF !(ti) THEN
      RETURN;
    END
    MUTABLE val: ?Locatable = typeAnalysisSession__cleanup_source_value(rtoc_self_view, node.value());
    IF ((val != NIL) AND ((val IS_A FuncCall OR val IS_A MethodCall))) THEN
      MUTABLE matched_def = val.matched_stdlib_def();
      IF matched_def THEN
        IF !((TRY (functionSignature__intrinsic_lifetime(&matched_def))).empty?()) THEN
          IF respondsTo?(val, "storage=") THEN
            val.storage = :borrow;
          END
          IF respondsTo?(node, "storage=") THEN
            node.storage = :borrow;
          END
          RETURN;
        END
        MUTABLE ret_alloc = TRY (functionSignature__return_alloc(&matched_def));
        IF TRY (functionSignature__emits_allocating?(&matched_def)) THEN
          ret_alloc = (ret_alloc OR TRY (functionSignature__intrinsic_alloc(&matched_def, IntrinsicAllocationKind.Alloc)));
        END
        IF ret_alloc THEN
          IF ([:heap, :frame]).contains?(ret_alloc) THEN
            IF respondsTo?(val, "storage=") THEN
              val.storage = ret_alloc;
            END
          END
          RETURN;
        END
      END
    END
    MUTABLE alloc = TRY (type__cleanup_allocator(ti, %(name) USE(rtoc_self_view) -> typeAnalysisSession__lookup_type_schema(rtoc_self_view, name)));
    MUTABLE val_ti = IF (val != NIL) THEN
      &val.full_type_mut("cleanup value provenance")
    ELSE
      NIL
    END;
    val_ti = IF val_ti IS_A Type THEN
      val_ti
    ELSE
      NIL
    END;
    type__apply_cleanup_placement_mut(&ti, val_ti, alloc);
    RETURN alloc;
}
END
PRIVATE FN typeAnalysisSession__cleanup_source_value(self: TypeAnalysisSession, node: ?Locatable) RETURNS ?Locatable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE current: ?Locatable = COPY node;
    WHILE ((current != NIL) AND aST__recovery_wrapper?(current)) DO
      current = aST__recovery_payload(UNWRAP (current));
    END
    RETURN current;
}
END
PRIVATE FN typeAnalysisSession__og_declare(self: TypeAnalysisSession, name: String, node: ?Node, type_info: TypeTypeInput) RETURNS !?[Set]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE entry = ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_515 = typeAnalysisSession__current_scope(rtoc_self_view);
    scope__resolve_entry(rtoc_local_receiver_515, name) } OR_ELSE NIL);
    MUTABLE kind = typeAnalysisSession__classify_og_kind(rtoc_self_view, type_info, (IF entry != NIL THEN
      entry.sync()
    ELSE
      NIL
    END));
    MUTABLE ti = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_517: ?TypeTypeInput = NIL;
    IF type_info IS_A Type THEN
      rtoc_ternary_value_517 = type_info;
    ELSE
      rtoc_ternary_value_517 = TRY (type__new(castTypeTypeInputToTypeConstructionInput(type_info)));
    END
    rtoc_ternary_value_517? };
    MUTABLE line: ?Int64 = aST__node__token(node).line;
    RETURN { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_518 = typeAnalysisSession__ownership_graph(rtoc_self_view);
    TRY (ownershipGraph__declare(&rtoc_mutable_receiver_518, name, kind, ti, typeAnalysisSession__ownership_graph(rtoc_self_view).scope_depth, line)) };
}
END
PRIVATE FN typeAnalysisSession__share_consumes_source?(self: TypeAnalysisSession, MUTABLE node: Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A CopyNode AS copy_node THEN
      RETURN FALSE;
    END
    MUTABLE ti = &node.full_type_mut("share consume source");
    IF (ti AND !(TRUE)) THEN
      ti = TRY (type__new(castTypeToTypeConstructionInput(ti)));
    END
    IF (TRUE AND type__shared?(ti)) THEN
      RETURN FALSE;
    END
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__move_if_not_copyable_mut(self: TypeAnalysisSession, MUTABLE node: Locatable, action: String@symbol = :move, consumer_param_type: ?Type = NIL) RETURNS !?Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A Identifier AS identifier THEN
      MUTABLE identifier_mutable = COPY identifier;
      MUTABLE vt = &identifier_mutable.full_type_mut("move candidate");
      IF TRY (typeAnalysisSession__current_function_type_param?(rtoc_self_view, type__resolved(vt))) THEN
        RETURN;
      END
      IF TRY (type__implicitly_copyable?(vt, %(t) USE(rtoc_self_view) -> typeAnalysisSession__lookup_type_schema(rtoc_self_view, t))) THEN
        RETURN;
      END
      MUTABLE existing: ?OwnershipNode = COPY ownershipGraph__get_index(typeAnalysisSession__ownership_graph(rtoc_self_view), identifier__name(identifier_mutable));
      IF (IF existing != NIL THEN
        ownershipNode__specific_move_action?(existing)
      ELSE
        NIL
      END) THEN
        IF ((consumer_param_type != NIL) AND (existing.move_consumer_param_type == NIL)) THEN
          existing.move_consumer_param_type = COPY castTypeToOptionalTypeTypeInput(consumer_param_type);
        END
        identifier_mutable.was_moved = TRUE;
        RETURN;
      END
      TRY (typeAnalysisSession__og_set_moved(rtoc_self_view, identifier__name(identifier_mutable), identifier_mutable.token, action, castOptionalTypeToOptionalTypeTypeInput(consumer_param_type)));
      identifier_mutable.was_moved = TRUE;
      RETURN TRUE;
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__move_if_takes_ownership_mut(self: TypeAnalysisSession, MUTABLE node: Locatable, action: String@symbol = :takes, consumer_param_type: ?Type = NIL) RETURNS !?Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A Identifier AS identifier THEN
      MUTABLE identifier_mutable = COPY identifier;
      MUTABLE vt = &identifier_mutable.full_type_mut("TAKES ownership candidate");
      IF TRY (typeAnalysisSession__current_function_type_param?(rtoc_self_view, type__resolved(vt))) THEN
        RETURN;
      END
      IF (type__primitive?(vt) OR type__id_handle?(vt)) THEN
        RETURN;
      END
      MUTABLE existing: ?OwnershipNode = COPY ownershipGraph__get_index(typeAnalysisSession__ownership_graph(rtoc_self_view), identifier__name(identifier_mutable));
      IF (IF existing != NIL THEN
        ownershipNode__specific_move_action?(existing)
      ELSE
        NIL
      END) THEN
        IF ((consumer_param_type != NIL) AND (existing.move_consumer_param_type == NIL)) THEN
          existing.move_consumer_param_type = COPY castTypeToOptionalTypeTypeInput(consumer_param_type);
        END
        identifier_mutable.was_moved = TRUE;
        RETURN;
      END
      TRY (typeAnalysisSession__og_set_moved(rtoc_self_view, identifier__name(identifier_mutable), identifier_mutable.token, action, castOptionalTypeToOptionalTypeTypeInput(consumer_param_type)));
      identifier_mutable.was_moved = TRUE;
      RETURN TRUE;
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__consume_generic_map_value_mut(self: TypeAnalysisSession, MUTABLE node: Locatable, value_type: Type) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE borrowed =   IF node IS_A GetIndex THEN
      TRUE
    ELSE_IF node IS_A Identifier THEN
      ((ownershipGraph__get_index(typeAnalysisSession__ownership_graph(rtoc_self_view), node.name()) != NIL) AND (((ownershipGraph__get_index(typeAnalysisSession__ownership_graph(rtoc_self_view), node.name()))?).kind == :borrowed))
    ELSE
      FALSE
    END;
    IF borrowed THEN
      IF node IS_A GetIndex AS get_index THEN
        typeAnalysisSession__error_mut(rtoc_self_view, get_index, TypeAnalysisCodeOrMessage{ SymbolValue: :TAKES_NEEDS_OWNED_INDEX });
      ELSE
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :TAKES_NEEDS_OWNED_BORROW });
      END
    END
    typeAnalysisSession__move_if_takes_ownership_mut(rtoc_self_view, &node, :takes, value_type);
}
END
PRIVATE FN typeAnalysisSession__keep_param_identity_mut(self: TypeAnalysisSession, val_node: Locatable, expected_type: Type, container_desc: String) RETURNS !Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(type__multiowned?(expected_type)) THEN
      RETURN FALSE;
    END
    IF TRY (typeAnalysisSession__current_function_type_param?(rtoc_self_view, type__resolved(expected_type))) THEN
      RETURN FALSE;
    END
    IF (IF val_node IS_A BinaryOp AS binary_op THEN (binary_op.op == symbol("OR_ELSE")) ELSE FALSE END) THEN
      RETURN typeAnalysisSession__keep_param_identity_mut(rtoc_self_view, val_node.left(), expected_type, container_desc);
    END
    IF val_node IS_A Identifier AS identifier THEN
      MUTABLE entry: ?SymbolEntry@multiowned = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_519 = typeAnalysisSession__current_scope(rtoc_self_view);
      scope__resolve_entry(rtoc_local_receiver_519, identifier__name(identifier)) };
      IF !((IF entry != NIL THEN
        symbolEntry__is_param(entry)
      ELSE
        NIL
      END)) THEN
        RETURN FALSE;
      END
      entry.kept_identity = (entry.kept_identity() OR_ELSE KeptIdentityContract{ family: :multiowned, sink: COPY container_desc });
      RETURN TRUE;
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__reject_borrowed_value_mut(self: TypeAnalysisSession, MUTABLE val_node: Locatable, container_desc: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE borrowed_name = NIL;
    IF val_node IS_A GetIndex AS get_index THEN
      borrowed_name = "${typeAnalysisSession__root_variable_name(rtoc_self_view, Locatable{ GetIndex: COPY get_index })}[index]";
    ELSE_IF (IF val_node IS_A Identifier AS identifier THEN ((ownershipGraph__get_index(typeAnalysisSession__ownership_graph(rtoc_self_view), identifier__name(identifier)) != NIL) AND (((ownershipGraph__get_index(typeAnalysisSession__ownership_graph(rtoc_self_view), identifier__name(identifier)))?).kind == :borrowed)) ELSE FALSE END) THEN
      borrowed_name = val_node.name();
    END
    IF !(borrowed_name) THEN
      RETURN;
    END
    MUTABLE vti = &val_node.full_type_mut("borrowed container value");
    IF (IF vti != NIL THEN
      type__primitive?(vti)
    ELSE
      NIL
    END) THEN
      RETURN;
    END
    IF (IF vti != NIL THEN
      type__generic_instance?(vti)
    ELSE
      NIL
    END) THEN
      RETURN;
    END
    IF TRY (typeAnalysisSession__current_function_type_param?(rtoc_self_view, (IF vti != NIL THEN
      vti.resolved()
    ELSE
      NIL
    END))) THEN
      RETURN;
    END
    MUTABLE has_pointer = (IF vti != NIL THEN
      TRY (type__heap_ptr?(vti))
    ELSE
      NIL
    END);
    IF (!(has_pointer) AND !((IF vti != NIL THEN
      vti.struct?()
    ELSE
      NIL
    END))) THEN
      RETURN;
    END
    typeAnalysisSession__error_mut(rtoc_self_view, val_node, TypeAnalysisCodeOrMessage{ SymbolValue: :STORE_BORROWED_INTO_CONTAINER }, [], {:name: borrowed_name, :container: container_desc});
}
END
PRIVATE FN typeAnalysisSession__classify_og_kind(self: TypeAnalysisSession, type_info: TypeTypeInput, sync_value: ?String@symbol = NIL) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE t = TRY (type__new(castTypeTypeInputToTypeConstructionInput(type_info)));
    IF (type__multiowned?(t) OR type__shared?(t)) THEN
      RETURN :rc;
    ELSE_IF sync_value THEN
      RETURN :sync;
    ELSE_IF TRY (type__implicitly_copyable?(t, %(name) USE(rtoc_self_view) -> typeAnalysisSession__lookup_type_schema(rtoc_self_view, name))) THEN
      RETURN :value;
    ELSE
      RETURN :affine;
    END
}
END
PUB FN typeAnalysisSession__new(importer: ?ModuleImporter = NIL, compiler: ?ModuleImporter = NIL, source_dir: ?String = NIL, strict_test: Bool = FALSE, source_code: ?String = NIL) RETURNS TypeAnalysisSession@multiowned ->
  MUTABLE self = TypeAnalysisSession{ audit_inputs: CapabilityAuditInputs{ held_locks: {}, held_lock_types: List[], current_predicate_context: NIL, deferred_with_validations: List[], deferred_recovery_validations: List[], deferred_give_validations: List[], deferred_copy_retained_validations: List[], predicate_call_sites: List[], async_body_facts: List[], capability_audit: {}, capture_stack: List[], capture_move_suppression_depth: 0, snapshot_txn_frames: List[], effect_state: NIL, lock_analysis: LockAnalysisState{ direct_edges: {}, direct_acquires: {}, held_calls: {}, clause_sites: List[], type_ranks: {} }, ownership_graph: ownershipGraph__new(), ownership_transport_frames: List[] }, config: AnnotatorPhasesTypeAnalysisSessionConfig{ importer: ( { MUTABLE rtoc_optional_or_source_520: ?ModuleImporter@multiowned = COPY importer; MUTABLE rtoc_optional_or_result_521: ?ModuleImporter@multiowned = NIL; IF rtoc_optional_or_source_520 != NIL THEN rtoc_optional_or_result_521 = COPY rtoc_optional_or_source_520; ELSE rtoc_optional_or_result_521 = COPY compiler; END rtoc_optional_or_result_521 } ), source_dir: COPY IF COPY source_dir != NIL THEN
  expand(COPY source_dir)
ELSE
  TRY (pwd())
END, strict_test: COPY strict_test, source_code: COPY source_code }, resolution: NIL, traversal_state: TraversalState{ scopes: [scope__new()], function_contexts: List[], loop_depth: 0, conditional_depth: 0, smooth_depth: 0, body_fact_frames: List[], stream_yield_frames: List[], with_block_depth: 0, match_pattern_depth: 0, current_bg_pinned: FALSE, pipeline_accessed_fields: NIL, auto_locked_assign_name: NIL, struct_literal_call_argument_depth: 0, annotation_ancestors: List[], comptime_type_param_refinements: {}, value_type_refinements: {}, branch_terminated: FALSE, next_synthetic_body_ordinal: -1, deferred_copy_wrapper_bindings: List[] } };
  typeAnalysisSession__initialize(&self, importer, compiler, source_dir, strict_test, source_code);
  RETURN self @multiowned;
END
FN castAccessPathNodeToLocatable(value: AccessPathNode) RETURNS Locatable ->
  PARTIAL MATCH value START
    AccessPathNode.GetField AS cast_payload -> RETURN Locatable{ GetField: COPY cast_payload };,
    AccessPathNode.GetIndex AS cast_payload -> RETURN Locatable{ GetIndex: COPY cast_payload };,
    AccessPathNode.Identifier AS cast_payload -> RETURN Locatable{ Identifier: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Locatable");
  END
  panic("Invalid cast to Locatable");
END
FN castAnnotationNodeToNode(value: AnnotationNode) RETURNS Node ->
  PARTIAL MATCH value START
    AnnotationNode.MIRProgram AS cast_payload -> RETURN Node{ MIRProgram: COPY cast_payload };,
    AnnotationNode.RequireNode AS cast_payload -> RETURN Node{ RequireNode: COPY cast_payload };,
    AnnotationNode.ProtocolRequirement AS cast_payload -> RETURN Node{ ProtocolRequirement: COPY cast_payload };,
    AnnotationNode.ProtocolDef AS cast_payload -> RETURN Node{ ProtocolDef: COPY cast_payload };,
    AnnotationNode.ImplementationDef AS cast_payload -> RETURN Node{ ImplementationDef: COPY cast_payload };,
    AnnotationNode.ConformanceDef AS cast_payload -> RETURN Node{ ConformanceDef: COPY cast_payload };,
    AnnotationNode.MIRStructDef AS cast_payload -> RETURN Node{ MIRStructDef: COPY cast_payload };,
    AnnotationNode.VarDecl AS cast_payload -> RETURN Node{ VarDecl: COPY cast_payload };,
    AnnotationNode.Assignment AS cast_payload -> RETURN Node{ Assignment: COPY cast_payload };,
    AnnotationNode.MIRDestructureTarget AS cast_payload -> RETURN Node{ MIRDestructureTarget: COPY cast_payload };,
    AnnotationNode.DestructuringAssignment AS cast_payload -> RETURN Node{ DestructuringAssignment: COPY cast_payload };,
    AnnotationNode.BindExpr AS cast_payload -> RETURN Node{ BindExpr: COPY cast_payload };,
    AnnotationNode.BinaryOp AS cast_payload -> RETURN Node{ BinaryOp: COPY cast_payload };,
    AnnotationNode.IsA AS cast_payload -> RETURN Node{ IsA: COPY cast_payload };,
    AnnotationNode.MIRUnaryOp AS cast_payload -> RETURN Node{ MIRUnaryOp: COPY cast_payload };,
    AnnotationNode.CallSiteOverride AS cast_payload -> RETURN Node{ CallSiteOverride: COPY cast_payload };,
    AnnotationNode.Identifier AS cast_payload -> RETURN Node{ Identifier: COPY cast_payload };,
    AnnotationNode.Literal AS cast_payload -> RETURN Node{ Literal: COPY cast_payload };,
    AnnotationNode.ListLit AS cast_payload -> RETURN Node{ ListLit: COPY cast_payload };,
    AnnotationNode.TupleLit AS cast_payload -> RETURN Node{ TupleLit: COPY cast_payload };,
    AnnotationNode.DefaultArrayLit AS cast_payload -> RETURN Node{ DefaultArrayLit: COPY cast_payload };,
