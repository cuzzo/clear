            WHILE rtoc_idx < type_params.length() DO
    IF comptime_type_args[rtoc_idx] THEN
                subst[type_params[rtoc_idx]?] = UNWRAP (COPY comptime_type_args[rtoc_idx]);
    END
    rtoc_idx = rtoc_idx + 1;
            END
          ELSE
