PRIVATE FN typeAnalysisSession__verify_captures_mut(MUTABLE self: TypeAnalysisSession, node: RoutineNode) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE captures: []Capture = List[];
