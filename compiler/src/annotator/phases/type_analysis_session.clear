      IF (error_set == NIL) THEN
        rtoc_ternary_value_186 = NIL;
      ELSE
        rtoc_ternary_value_186 = typeAnalysisSession__apply_expression_subst(&rtoc_self_view, error_set, subst);
      END
      rtoc_ternary_value_186? } }, capabilities: COPY cap };
    ELSE_IF kind IS_A FutureTypeExpression AS rtoc_future_type_expression THEN
      RETURN TypeExpression{ kind: TypeExpressionKind{ FutureTypeExpression: COPY FutureTypeExpression{ inner: COPY typeAnalysisSession__apply_expression_subst(&rtoc_self_view, rtoc_future_type_expression.inner, subst)  } }, capabilities: COPY cap };
    ELSE_IF kind IS_A LinearTypeExpression AS rtoc_linear_type_expression THEN
      RETURN TypeExpression{ kind: TypeExpressionKind{ LinearTypeExpression: COPY LinearTypeExpression{ kind: COPY rtoc_linear_type_expression.kind, dimensions: COPY rtoc_linear_type_expression.dimensions, item: COPY typeAnalysisSession__apply_expression_subst(&rtoc_self_view, rtoc_linear_type_expression.item, subst), allocation_hint: rtoc_linear_type_expression.allocation_hint  } }, capabilities: COPY cap };
    ELSE_IF kind IS_A MapTypeExpression AS rtoc_map_type_expression THEN
      RETURN TypeExpression{ kind: TypeExpressionKind{ MapTypeExpression: COPY MapTypeExpression{ key: COPY typeAnalysisSession__apply_expression_subst(&rtoc_self_view, rtoc_map_type_expression.key, subst), value: COPY typeAnalysisSession__apply_expression_subst(&rtoc_self_view, rtoc_map_type_expression.value, subst), key_implicit: rtoc_map_type_expression.key_implicit, legacy_separator: COPY rtoc_map_type_expression.legacy_separator  } }, capabilities: COPY cap };
    ELSE_IF kind IS_A StreamTypeExpression AS rtoc_stream_type_expression THEN
      RETURN TypeExpression{ kind: TypeExpressionKind{ StreamTypeExpression: COPY StreamTypeExpression{ cardinality: COPY rtoc_stream_type_expression.cardinality, item: COPY typeAnalysisSession__apply_expression_subst(&rtoc_self_view, rtoc_stream_type_expression.item, subst)  } }, capabilities: COPY cap };
    ELSE
      RETURN COPY expression;
    END
}
