        END
    END
    MUTABLE pending_owned_transfer = (((((typeAnalysisSession__language_mode(&rtoc_self_view) != :strict) AND !(rtoc_each_key)) AND !(is_call_arg)) AND ((TRUE) AND (val_node IS_A Identifier))) AND !(TRY (type__implicitly_copyable?(actual_type, %(name: String@symbol) USE(MUTABLE rtoc_self_view) -> TRY (typeAnalysisSession__schema_lookup_result(&rtoc_self_view, name))))));
    IF rtoc_each_key THEN
        locatable__set_ownership_pending_transfer_mut(&val_node, TRUE);
    END
    IF !((rtoc_each_key OR rtoc_each_key)) THEN
        TRY (typeAnalysisSession__move_if_not_copyable_mut(&rtoc_self_view, UNWRAP (val_node)));
    END
    END
    node.borrowed_field_names = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_408 = CAST(schema AS StructSchema);
    TRY (structSchema__borrowed_fields(rtoc_local_receiver_408)) };
    RETURN TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ StructLit: COPY node }, TRY (typeAnalysisSession__literal_instance_type(&rtoc_self_view, &node))));
}
END
PRIVATE FN typeAnalysisSession__visit_ListLit(MUTABLE self: TypeAnalysisSession, MUTABLE node: ListLit) RETURNS !?TypeAnalysisSessionReturnValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN node.items DO
    TRY (typeAnalysisSession__visit(&rtoc_self_view, _));
    END
    MUTABLE expected_tuple: ?Type@multiowned = locatable__coerced_type_info(Locatable{ ListLit: COPY node });
    IF expected_tuple EXISTS AS expected_tuple_value THEN
      IF type__tuple?(expected_tuple_value) THEN
      MUTABLE tuple_types = TRY ( type__generic_args(UNWRAP (expected_tuple)));
      IF (tuple_types.length() != node.items.length()) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ ListLit: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_WRONG_ARG_COUNT }, [], CAST({:type: :Tuple, :expected: tuple_types.length(), :got: node.items.length()} AS {String@symbol}Any)));
      END
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < node.items.length() DO
      MUTABLE expected_item = COPY UNWRAP (tuple_types[rtoc_idx]);
      MUTABLE actual_item = TRY (aST__full_type_mut(UNWRAP (node.items[rtoc_idx])));
      IF TRY (type__accepts?(expected_item, actual_item)) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE union_schema: ?SchemaValue = TRY (typeAnalysisSession__lookup_type_schema(&rtoc_self_view, type__resolved((TRY (type__value_payload_type(expected_item))))));
      IF TRY (unionPayloadCompatibility__unique_variant(expected_item, actual_item, union_schema)) THEN
            node.items[rtoc_idx].coerced_type = COPY expected_item;
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !(TRY (typeAnalysisSession__is_safe_autocast?(rtoc_self_view, SourceType{ Type: COPY actual_item }, castTypeToTypeTypeInput__type_analysis_session(expected_item)))) THEN
            TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ ListLit: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :TYPE_MISMATCH_ASSIGN }, [], CAST({:got: actual_item.resolved(), :expected: expected_item} AS {String@symbol}Any)));
      END
      node.items[rtoc_idx].coerced_type = COPY expected_item;
    rtoc_idx = rtoc_idx + 1;
      END
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ ListLit: COPY node }, expected_tuple));
      node.storage = :stack;
      RETURN NIL;
    END
    END
    IF (!(node.items.empty?()) AND (node.items |> ALL type__future?((TRY (type__new(_.resolved_type)))))) THEN
      MUTABLE inner_types = CAST(((node.items |> SELECT type__to_sym((TRY (type__tense_type((TRY (type__new(_.resolved_type)))))))) |> DISTINCT _) AS []String@symbol);
      IF (inner_types.length() > 1) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ ListLit: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :BOUNDED_STREAM_MIXED_TYPES }, [], CAST({:types: inner_types.join(", ")} AS {String@symbol}Any)));
      END
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ ListLit: COPY node }, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("~${inner_types.first()}[${node.items.length()}]") }))));
      node.storage = :stack;
      RETURN NIL;
    END
    IF node.items.empty?() THEN
      MUTABLE coll = listLit__constructor_collection(node);
      IF coll THEN
        MUTABLE t = TRY (type__new(TypeConstructionInput{ SymbolValue: symbol("Any[]") }, NIL, NIL, NIL, NIL, coll));
        TRY (type__apply_constructor_collection_mut(&t, NIL, listLit__constructor_soa?(node), listLit__constructor_shard_count(node)));
        IF ((coll == :pool) OR (coll == :set)) THEN
          type__mark_heap_allocated_mut(&t);
        END
        TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ ListLit: COPY node }, t));
        node.storage = IF (((coll == :pool) OR (coll == :set))) THEN
          :heap
        ELSE
          :stack
        END;
        TRY (typeAnalysisSession__record_effect(&rtoc_self_view, symbol("HEAP")));
        RETURN NIL;
      END
      IF (node.storage == :heap) THEN
        TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ ListLit: COPY node }, TRY (type__new(TypeConstructionInput{ SymbolValue: symbol("Any[]") }, NIL, NIL, NIL, :heap))));
      ELSE
        TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ ListLit: COPY node }, symbol("Any[]")));
      END
      RETURN NIL;
    END
    MUTABLE string_item_types = node.items |> SELECT { MUTABLE rtoc_mutable_block_param_409 = COPY _;
    TRY (aST__full_type_mut(rtoc_mutable_block_param_409)) };
    MUTABLE all_strings = string_item_types |> ALL _.string?();
    MUTABLE string_element_sync =   IF all_strings THEN
      {
    MUTABLE rtoc_value_block_marker = 0;
    syncs = (string_item_types |> SELECT _.sync()) |> DISTINCT _ |> SELECT COPY _;
    (IF ((syncs).length() == 1) THEN
      syncs.first()
    ELSE
      NIL
    END)
    }
    ELSE
      NIL
    END;
    IF all_strings THEN
      MUTABLE base_type = :String;
    ELSE
      MUTABLE base_type = (UNWRAP (node.items.first())).resolved_type;
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < node.items.length() DO
      IF (rtoc_idx == 0) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF (node.items[rtoc_idx].resolved_type != base_type) THEN
            TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ ListLit: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :LIST_LITERAL_MIXED_TYPES }, [], CAST({:base: base_type, :index: (rtoc_idx + 1), :got: node.items[rtoc_idx].resolved_type} AS {String@symbol}Any)));
      END
    rtoc_idx = rtoc_idx + 1;
      END
    END
    IF (node.storage == :stack) THEN
      MUTABLE inferred = TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("${base_type}[${node.items.length()}]") }));
      IF string_element_sync THEN
        TRY (type__set_elem_sync(&inferred, string_element_sync));
      END
      RETURN TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ ListLit: COPY node }, inferred));
    ELSE
      MUTABLE t = TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("${base_type}[]") }, NIL, NIL, NIL, :heap));
      IF string_element_sync THEN
        TRY (type__set_elem_sync(&t, string_element_sync));
      END
      type__mark_frame_allocated_mut(&_);
      RETURN TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ ListLit: COPY node }, t));
    END
}
END
PRIVATE FN typeAnalysisSession__visit_TupleLit(MUTABLE self: TypeAnalysisSession, MUTABLE node: TupleLit) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN node.items DO
    TRY (typeAnalysisSession__visit(&rtoc_self_view, _));
    END
    MUTABLE item_types = node.items |> SELECT { MUTABLE rtoc_mutable_block_param_410 = COPY _;
    TRY (aST__full_type_mut(rtoc_mutable_block_param_410)) };
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ TupleLit: COPY node }, TRY (type__generic_instance_of(:Tuple, castTypeListToTypeTypeInputList(item_types)))));
    node.storage = :stack;
}
END
PRIVATE FN typeAnalysisSession__visit_DefaultArrayLit(MUTABLE self: TypeAnalysisSession, MUTABLE node: DefaultArrayLit) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE type_info = TRY (type__new(TypeConstructionInput{ Type: COPY node.type_info }));
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ DefaultArrayLit: COPY node }, type_info));
    node.storage = :stack;
    RETURN type_info;
}
END
PRIVATE FN typeAnalysisSession__visit_RangeLit(MUTABLE self: TypeAnalysisSession, MUTABLE node: RangeLit) RETURNS !?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.start));
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.finish));
    MUTABLE start_type = type__resolved(TRY (aST__full_type_mut(node.start)));
    MUTABLE finish_type = type__resolved(TRY (aST__full_type_mut(node.finish)));
    IF !(type__numeric?((TRY (type__new(TypeConstructionInput{ SymbolValue: COPY start_type }))))) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ RangeLit: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :RANGE_START_NEEDS_NUMERIC }, [], CAST({:got: start_type} AS {String@symbol}Any)));
    END
    IF !(type__numeric?((TRY (type__new(TypeConstructionInput{ SymbolValue: COPY finish_type }))))) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ RangeLit: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :RANGE_END_NEEDS_NUMERIC }, [], CAST({:got: finish_type} AS {String@symbol}Any)));
    END
    MUTABLE start_is_float = type__float?((TRY (type__new(TypeConstructionInput{ SymbolValue: COPY start_type }))));
    MUTABLE finish_is_float = type__float?((TRY (type__new(TypeConstructionInput{ SymbolValue: COPY finish_type }))));
    IF (start_is_float != finish_is_float) THEN
      IF !(start_is_float) THEN
        locatable__set_coerced_type_object_mut(&node.start, TRY (type__new(TypeConstructionInput{ SymbolValue: :Float64 })));
      END
      IF !(finish_is_float) THEN
        locatable__set_coerced_type_object_mut(&node.finish, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY :Float64 })));
      END
    ELSE_IF start_is_float THEN
  
    ELSE
  
    END
    MUTABLE base_type =   IF (start_is_float OR finish_is_float) THEN
      :Float64
    ELSE
      :Int64
    END;
    MUTABLE rtoc_open_0 = Locatable{ RangeLit: COPY node };
    RETURN TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, &rtoc_open_0, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("~${base_type}[]") }))));
}
END
PRIVATE FN typeAnalysisSession__visit_WithBlock(MUTABLE self: TypeAnalysisSession, MUTABLE node: WithBlock) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_ctx: ?FunctionContext@multiowned = typeAnalysisSession__current_fn_ctx(&rtoc_self_view);
    IF fn_ctx EXISTS AS fn_ctx_value THEN
      MUTABLE fn_node: ?FunctionDef@multiowned = TRY (typeAnalysisSession__function_node_for(&rtoc_self_view, fn_ctx_value.name));
      IF fn_node EXISTS AS MUTABLE fn_node_value THEN
        &fn_node_value.semantic_with_blocks.append(COPY node);
      END
    END
    rtoc_self_view.traversal_state.with_block_depth=((typeAnalysisSession__phase_traversal_state(&rtoc_self_view).with_block_depth + 1));
    DEFER rtoc_self_view.traversal_state.with_block_depth=((typeAnalysisSession__phase_traversal_state(&rtoc_self_view).with_block_depth - 1));
    MUTABLE capability_expansion = WithCapabilityPlan{ all: List[] };
    FOR MUTABLE rtoc_mutable_block_param_411 IN node.capabilities DO
    TRY (typeAnalysisSession__acquire_capability_mut(&rtoc_self_view, &node, &rtoc_mutable_block_param_411, &capability_expansion));
    END
    node.capability_plan = capability_expansion;
    MUTABLE capability_plan = TRY (capabilityPlan__require_for(node));
    MUTABLE expanded_capabilities = COPY capability_plan.all;
    MUTABLE lock_capabilities = TRY (withCapabilityPlan__locks(capability_plan));
    TRY (typeAnalysisSession__validate_with_match_source_shape_mut(&rtoc_self_view, &node, capability_expansion));
    TRY (typeAnalysisSession__check_nested_lock_reacquire_mut(&rtoc_self_view, &node, lock_capabilities));
    TRY (typeAnalysisSession__check_lock_rank_ordering_mut(&rtoc_self_view, &node, lock_capabilities));
    MUTABLE fn_name_for_lock: String = "<top>";
    IF typeAnalysisSession__current_fn_ctx(&rtoc_self_view) != NIL THEN
      fn_name_for_lock = UNWRAP (((typeAnalysisSession__current_fn_ctx(&rtoc_self_view))?).name);
    END
    MUTABLE held_entries_now = TRY (typeAnalysisSession__current_held_lock_types(&rtoc_self_view));
    MUTABLE is_match_form = !((node.arms == NIL));
    FOR _ IN lock_capabilities DO
    typeAnalysisSession__record_with_acquire_mut(&rtoc_self_view, fn_name_for_lock, _, held_entries_now, node.deadlock_escape);
    IF !(is_match_form) THEN
        TRY (typeAnalysisSession__record_effect(&rtoc_self_view, symbol("BLOCKING")));
        TRY (typeAnalysisSession__record_effect(&rtoc_self_view, symbol("SUSPENDS")));
    END
    END
    MUTABLE is_snapshot_txn_body = ((node.snapshot_mode == :transaction));
    MUTABLE with_body = (%() USE(expanded_capabilities, is_snapshot_txn_body, node, MUTABLE rtoc_self_view) -> {
    TRY (typeAnalysisSession__record_body_fact_with_block_mut(&rtoc_self_view, &node));
    typeAnalysisSession__with_new_scope(&rtoc_self_view, typeAnalysisSession__current_scope(&rtoc_self_view), %() USE(expanded_capabilities, is_snapshot_txn_body, node, MUTABLE rtoc_self_view) -> {
      FOR _ IN expanded_capabilities DO
      TRY (typeAnalysisSession__declare_capability_scope_mut(&rtoc_self_view, _));
      END
      TRY (typeAnalysisSession__validate_and_visit_with_guards_mut(&rtoc_self_view, &node));
      typeAnalysisSession__with_body_fact_scope(&rtoc_self_view, node, %() USE(node, MUTABLE rtoc_self_view) -> {
        rtoc_lambda_result_412 = TRY (typeAnalysisSession__visit_stmts(&rtoc_self_view, node.body));
        rtoc_lambda_result_412
      });
      TRY (typeAnalysisSession__validate_with_guard_no_body_mutation_mut(&rtoc_self_view, &node));
      MUTABLE fallible_sources = TRY (typeAnalysisSession__retryable_with_fallible_sources(&rtoc_self_view, &node));
      IF (is_snapshot_txn_body AND !((fallible_sources.length() == 0))) THEN
          TRY (typeAnalysisSession__retryable_with_fallible_body_error_mut(&rtoc_self_view, &node, "WITH SNAPSHOT ... AS MUTABLE", fallible_sources));
      END
      IF ((TRY (typeAnalysisSession__retryable_with_universal_poly_candidate?(&rtoc_self_view, &node)) != NIL) AND !((fallible_sources.length() == 0))) THEN
          TRY (typeAnalysisSession__retryable_with_fallible_body_error_mut(&rtoc_self_view, &node, "WITH POLYMORPHIC", fallible_sources));
      END
      MUTABLE arms: ?[]WithMatchArm = COPY node.arms;
      IF arms EXISTS AS arms_value THEN
          MUTABLE arms_value_mutable = COPY arms_value;
          MUTABLE fn_ctx_name: ?String = COPY typeAnalysisSession__current_fn_ctx(&rtoc_self_view)?.name;
          MUTABLE direct_effects = typeAnalysisSession__effect_direct_effects(&rtoc_self_view);
          MUTABLE snapshot_branch_value: ?[Set]String@symbol = NIL;
          IF fn_ctx_name EXISTS AS fn_ctx_name_value THEN
            snapshot_branch_value = COPY TRY (typeAnalysisSession__effect_direct_effects_for(&rtoc_self_view, fn_ctx_name_value));
          ELSE
            snapshot_branch_value = NIL;
          END
          MUTABLE snapshot: ?[Set]String@symbol = snapshot_branch_value;
          MUTABLE per_arm_effects = List[];
          FOR _ IN arms_value_mutable DO
        MUTABLE before_branch_value: ?[Set]String@symbol = NIL;
            IF fn_ctx_name EXISTS AS fn_ctx_name_value THEN
              before_branch_value = COPY TRY (typeAnalysisSession__effect_direct_effects_for(&rtoc_self_view, fn_ctx_name_value));
            ELSE
              before_branch_value = NIL;
            END
        MUTABLE before: ?[Set]String@symbol = before_branch_value;
        FOR _ IN (TRY (typeAnalysisSession__with_match_family_effects(&rtoc_self_view, _.family))) DO
        TRY (typeAnalysisSession__record_effect(&rtoc_self_view, _));
        END
        typeAnalysisSession__with_new_scope(&rtoc_self_view, typeAnalysisSession__current_scope(&rtoc_self_view), %() USE(node, _, MUTABLE rtoc_self_view) -> {
          typeAnalysisSession__with_body_fact_scope(&rtoc_self_view, node, %() USE(_, MUTABLE rtoc_self_view) -> {
            rtoc_lambda_result_413 = TRY (typeAnalysisSession__visit_stmts(&rtoc_self_view, _.body()));
            rtoc_lambda_result_413
          });
          TRY (typeAnalysisSession__finalize_scope(&rtoc_self_view, Locatable{ WithBlock: COPY node }))
        });
        IF fn_ctx_name EXISTS AS fn_ctx_name_value THEN
              MUTABLE after = TRY (typeAnalysisSession__effect_direct_effects_for(&rtoc_self_view, fn_ctx_name_value));
              MUTABLE arm_delta = (after - before?);
              &per_arm_effects.append(arm_delta);
              direct_effects[fn_ctx_name_value] = COPY UNWRAP (snapshot);
        END
          END
          IF ((fn_ctx_name != NIL) AND !((per_arm_effects.length() == 0))) THEN
            MUTABLE concrete = ((per_arm_effects |> REDUCE(per_arm_effects[0]) (ruby_set_intersection(acc, _))) OR_ELSE Set[]);
            MUTABLE all_union = per_arm_effects |> REDUCE(Set[]) (ruby_set_union(acc, _));
            MUTABLE maybe_set = (all_union - concrete);
            MUTABLE maybe_projection = {symbol("CONTENTION"): symbol("CONTENTION_MAYBE"), symbol("BLOCKING"): symbol("BLOCKING_MAYBE")};
            MUTABLE target_effects = TRY (typeAnalysisSession__effect_direct_effects_for(&rtoc_self_view, fn_ctx_name));
            FOR _ IN concrete DO
            &target_effects.insert(COPY _);
            END
            FOR _ IN maybe_set DO
            &target_effects.insert((maybe_projection[_] OR_ELSE _));
            END
          END
      END
      TRY (typeAnalysisSession__finalize_scope(&rtoc_self_view, Locatable{ WithBlock: COPY node }))
    })
    });
    typeAnalysisSession__with_held_locks(&rtoc_self_view, node, lock_capabilities, %() USE(is_snapshot_txn_body, node, with_body, MUTABLE rtoc_self_view) -> {
    IF is_snapshot_txn_body THEN
      RETURN TRY (typeAnalysisSession__with_snapshot_transaction_body(&rtoc_self_view, node, with_body));
    ELSE
      RETURN with_body();
    END
    NIL
    });
    FOR _ IN expanded_capabilities DO
    MUTABLE vname = _.var_name;
    IF capabilityTransition__restrict?(_) THEN
        MUTABLE rtoc_mutable_receiver_414 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
        TRY (ownershipGraph__release_borrow(&rtoc_mutable_receiver_414, "__restrict_${vname}"));
    ELSE_IF capabilityTransition__borrowed?(_) THEN
        MUTABLE rtoc_mutable_receiver_415 = typeAnalysisSession__ownership_graph(&rtoc_self_view);
        TRY (ownershipGraph__release_borrow(&rtoc_mutable_receiver_415, "__borrowed_${vname}"));
    END
    END
    TRY (typeAnalysisSession__validate_no_multi_object_atomic_mut(&rtoc_self_view, &node));
    TRY (typeAnalysisSession__validate_lock_error_clause_mut(&rtoc_self_view, &node, lock_capabilities));
    TRY (typeAnalysisSession__mark_with_runtime_requirements_mut(&rtoc_self_view, &node));
    typeAnalysisSession__record_lock_clause_site_mut(&rtoc_self_view, &node, lock_capabilities);
    RETURN TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ WithBlock: COPY node }, :Void));
}
END
PRIVATE FN typeAnalysisSession__validate_with_match_source_shape_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: WithBlock, capability_plan: WithCapabilityPlan) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE arms: ?[]WithMatchArm = COPY node.arms;
    IF arms EXISTS AS arms_value THEN
      IF (node.snapshot_mode == NIL) THEN
        MUTABLE mutable_cap: ?CapabilityTransition = capability_plan.all |> FIND _.alias_mutable;
        IF (mutable_cap AND (arms_value |> ANY (_.family == :VERSIONED))) THEN
          TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_MATCH_VERSIONED_AS_MUTABLE }, [], CAST({:name: mutable_cap.var_name} AS {String@symbol}Any)));
        END
        IF !((capability_plan.all.length() > 1)) THEN
          RETURN;
        END
        MUTABLE names = (capability_plan.all |> SELECT _.var_name).join(", ");
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_MATCH_MULTI_CELL }, [], CAST({:names: names} AS {String@symbol}Any)));
      ELSE
        RETURN;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__mark_with_runtime_requirements_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: WithBlock) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_ctx: ?FunctionContext@multiowned = typeAnalysisSession__current_fn_ctx(&rtoc_self_view);
    IF fn_ctx EXISTS AS fn_ctx_value THEN
      MUTABLE fn_ctx_value_mutable = COPY fn_ctx_value;
      IF typeAnalysisSession__with_block_uses_runtime?(&rtoc_self_view, &node) THEN
        fn_ctx_value_mutable.uses_rt = TRUE;
      END
      TRY (typeAnalysisSession__mark_unrequired_polymorphic_with_runtime_mut(&rtoc_self_view, &node, &fn_ctx_value_mutable));
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__with_block_uses_runtime?(MUTABLE self: TypeAnalysisSession, MUTABLE node: WithBlock) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN (((node.snapshot_mode == :read) OR (node.snapshot_mode == :transaction)) OR typeAnalysisSession__with_block_has_versioned_arm?(&rtoc_self_view, &node));
}
END
PRIVATE FN typeAnalysisSession__with_block_has_versioned_arm?(MUTABLE self: TypeAnalysisSession, MUTABLE node: WithBlock) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node.arms EXISTS AS arms THEN
      RETURN arms |> ANY (_.family == :VERSIONED);
    END
    RETURN FALSE;
}
END
PRIVATE FN typeAnalysisSession__mark_unrequired_polymorphic_with_runtime_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: WithBlock, MUTABLE fn_ctx: FunctionContext) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE bound_name: ?String = TRY (typeAnalysisSession__unrequired_polymorphic_runtime_bound_name(&rtoc_self_view, &node));
    IF bound_name EXISTS AS bound_name_value THEN
      MUTABLE fn_node: ?FunctionDef@multiowned = TRY (typeAnalysisSession__function_node_for(&rtoc_self_view, fn_ctx.name));
      IF fn_node EXISTS AS fn_node_value THEN
        MUTABLE fn_node_value_mutable = COPY fn_node_value;
        IF !(typeAnalysisSession__with_requires_binding?(&rtoc_self_view, CAST(fn_node_value_mutable AS FunctionDef), bound_name_value)) THEN
          fn_ctx.uses_rt = TRUE;
          fn_node_value_mutable.can_fail = TRUE;
        ELSE
          RETURN;
        END
      ELSE
        RETURN;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__unrequired_polymorphic_runtime_bound_name(MUTABLE self: TypeAnalysisSession, MUTABLE node: WithBlock) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE capability_plan = TRY (capabilityPlan__require_for(node));
    IF !(((node.polymorphic OR_ELSE FALSE) AND (capability_plan.all.length() == 1))) THEN
      RETURN NIL;
    END
    MUTABLE bound_fact = withCapabilityPlan__first_transition(capability_plan);
    MUTABLE bound_var = COPY bound_fact.var_node;
    MUTABLE bound_sym: ?SymbolEntry@multiowned = aST__node__symbol(bound_var);
    IF !(((TRUE AND TRUE) AND symbolEntry__is_param(UNWRAP (bound_sym)))) THEN
      RETURN NIL;
    END
    RETURN COPY bound_fact.var_name;
}
END
PRIVATE FN typeAnalysisSession__with_requires_binding?(MUTABLE self: TypeAnalysisSession, fn_node: FunctionDef, bound_name: ?String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF bound_name EXISTS AS bound_name_value THEN
      RETURN fn_node.requires.contains?(bound_name_value);
    END
    RETURN FALSE;
}
END
PRIVATE FN typeAnalysisSession__retryable_with_fallible_sources(MUTABLE self: TypeAnalysisSession, MUTABLE node: WithBlock) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE sources: []String = ( { MUTABLE rtoc_empty_list_418: []String = List[]; rtoc_empty_list_418 } );
    FOR _ IN TRY (typeAnalysisSession__current_body_fact_scope_nodes(&rtoc_self_view, &node)) DO
    IF (_ IS_A Raise) THEN
      &sources.append("RAISE");
    ELSE_IF (_ IS_A OrElseRaise) THEN
      &sources.append("OR_ELSE RAISE");
    ELSE_IF _ IS_A FuncCall AS func_call THEN
      IF typeAnalysisSession__retryable_with_call_fallible?(&rtoc_self_view, Node{ FuncCall: COPY func_call }) THEN
        &sources.append(COPY CAST(funcCall__name(func_call) AS String));
      END
    ELSE_IF (_ IS_A MethodCall) THEN
      IF typeAnalysisSession__retryable_with_call_fallible?(&rtoc_self_view, castLocatableToNode__type_analysis_session(_)) THEN
        &sources.append("${UNWRAP (locatable__name(_))}()");
      END
    ELSE_IF _ IS_A StaticCall AS static_call THEN
      IF typeAnalysisSession__retryable_with_call_fallible?(&rtoc_self_view, Node{ StaticCall: COPY static_call }) THEN
        &sources.append(COPY CAST(static_call.method_name AS String));
      END
    ELSE_IF _ IS_A FreezeNode AS freeze_node THEN
      &sources.append("FREEZE");
    END
    END
    RETURN dedupeStrings(sources);
}
END
PRIVATE FN typeAnalysisSession__retryable_with_call_fallible?(MUTABLE self: TypeAnalysisSession, MUTABLE node: Node) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (TRUE AND (aST__node__can_fail( UNWRAP (castNodeToLocatable(node))) OR_ELSE FALSE)) THEN
      RETURN TRUE;
    END
    IF (aST__node_error_union_type(UNWRAP (castNodeToLocatable(node))) != NIL) THEN
      RETURN TRUE;
    END
    RETURN FALSE;
}
END
PRIVATE FN typeAnalysisSession__retryable_with_universal_poly_candidate?(MUTABLE self: TypeAnalysisSession, MUTABLE node: WithBlock) RETURNS !?Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node.universal_poly THEN
      RETURN TRUE;
    END
    MUTABLE capability_plan = TRY (capabilityPlan__require_for(node));
    IF !(((node.polymorphic OR_ELSE FALSE) AND (capability_plan.all.length() == 1))) THEN
      RETURN FALSE;
    END
    MUTABLE bound_fact = withCapabilityPlan__first_transition(capability_plan);
    MUTABLE bound_var = COPY bound_fact.var_node;
    MUTABLE bound_name = COPY bound_fact.var_name;
    MUTABLE bound_sym: ?SymbolEntry@multiowned = aST__node__symbol(bound_var);
    MUTABLE is_param = ((TRUE AND TRUE) AND symbolEntry__is_param(UNWRAP (bound_sym)));
    MUTABLE fn_node: ?FunctionDef@multiowned = TRY (typeAnalysisSession__function_node_for(&rtoc_self_view, typeAnalysisSession__current_fn_ctx(&rtoc_self_view)?.name));
    MUTABLE has_req = ((((fn_node != NIL) AND TRUE) AND fn_node.requires) AND fn_node.requires.contains?(bound_name));
    RETURN (is_param AND !(has_req));
}
END
PRIVATE FN typeAnalysisSession__retryable_with_fallible_body_error_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: WithBlock, with_name: String, sources: []String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE detail = (sources[0..<min(3, sources.length())]).join(", ");
    IF (sources.length() > 3) THEN
      detail = (detail $+ ", ...");
    END
    TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_RETRYABLE_FALLIBLE_BODY }, [], CAST({:with_name: with_name, :detail: detail} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__validate_lock_error_clause_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: WithBlock, lock_capabilities: []CapabilityTransition) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE clause: ?ErrorClause = COPY node.lock_error_clause;
    MUTABLE is_snapshot_txn = (node.snapshot_mode == :transaction);
    IF ((node.arms != NIL) AND is_snapshot_txn) THEN
      TRY (typeAnalysisSession__validate_snapshot_match_arms_mut(&rtoc_self_view, &node));
      RETURN;
    END
    MUTABLE capability_plan = TRY (capabilityPlan__require_for(node));
    MUTABLE has_atomic_ptr = (is_snapshot_txn AND ((TRY (withCapabilityPlan__snapshot_transitions(capability_plan))) |> ANY {
    MUTABLE sym: ?SymbolEntry@multiowned = COPY KEEP _.source_entry;
    (((sym != NIL) AND symbolEntry__atomic?(sym)) AND symbolEntry__indirect?(sym))
    }));
    IF (is_snapshot_txn AND (clause == NIL)) THEN
      MUTABLE target_error = IF has_atomic_ptr THEN
        :AtomicConflict
      ELSE
        :MvccConflict
      END;
      MUTABLE synth: ?ErrorClause = typeAnalysisSession__synthesize_clause_from_policy(&rtoc_self_view, target_error);
      IF synth EXISTS AS synth_value THEN
        node.lock_error_clause = synth_value;
        clause = synth_value;
      ELSE
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_SNAPSHOT_NEEDS_HANDLER }, [], CAST({:error: target_error} AS {String@symbol}Any)));
      END
    END
    IF (has_atomic_ptr AND clause) THEN
      MUTABLE bad_selector: ?ErrorSelector = clause.selectors |> FIND ((_.form == :type) AND (_.name == :MvccConflict));
      IF bad_selector EXISTS AS bad_selector_value THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_ATOMIC_HANDLER_WRONG_ERROR }));
      END
    END
    IF !(clause) THEN
      RETURN;
    END
    MUTABLE has_guard = !(((TRY (withCapabilityPlan__guarded(capability_plan))).length() == 0));
    MUTABLE has_fallible = ((has_guard OR is_snapshot_txn) OR !((lock_capabilities.length() == 0)));
    IF !(has_fallible) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :ON_RETRY_NEEDS_FALLIBLE_CAP }));
    END
    TRY (typeAnalysisSession__resolve_error_selectors_mut(&rtoc_self_view, &node, &clause, is_snapshot_txn));
    IF (clause.action == ErrorActionKind.Exit) THEN
      TRY (typeAnalysisSession__visit(&rtoc_self_view, clause.message));
    ELSE_IF (clause.action IS_A Return) THEN
      TRY (typeAnalysisSession__visit(&rtoc_self_view, clause.value));
    ELSE_IF (clause.action == ErrorActionKind.Block) THEN
      TRY (typeAnalysisSession__visit_stmts(&rtoc_self_view, clause.body));
    END
}
END
PRIVATE FN typeAnalysisSession__reject_bare_atomic_ptr_mutation_mut(MUTABLE self: TypeAnalysisSession, MUTABLE field_node: GetField, assignment_node: Assignment) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE root: GetField = COPY field_node;
    WHILE (TRUE AND !(Locatable{ GetField: COPY root } IS_A Identifier)) DO
      root = castLocatableToGetField__type_analysis_session(COPY root.target);
    END
    IF !(Locatable{ GetField: COPY root } IS_A Identifier) THEN
      RETURN;
    END
    MUTABLE sym: ?SymbolEntry = root.symbol;
    IF sym EXISTS AS sym_value THEN
      IF !(symbolEntry__atomic?(sym_value)) THEN
        RETURN;
      END
      IF !((TRUE AND symbolEntry__indirect?(sym_value))) THEN
        RETURN;
      END
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ Assignment: COPY assignment_node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :INDIRECT_ATOMIC_FIELD_WRITE }, [], CAST({:name: getField__name(root), :field: typeAnalysisSession__field_name_for_msg(&rtoc_self_view, &field_node)} AS {String@symbol}Any)));
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__field_name_for_msg(MUTABLE self: TypeAnalysisSession, MUTABLE node: GetField) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(node.field.empty?()) THEN
      RETURN COPY node.field;
    END
    RETURN COPY "<field>";
}
END
PRIVATE FN typeAnalysisSession__validate_no_multi_object_atomic_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: WithBlock) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE capability_plan = TRY (capabilityPlan__require_for(node));
    MUTABLE caps = TRY (withCapabilityPlan__sync_constrained(capability_plan));
    IF (caps.length() < 2) THEN
      RETURN;
    END
    MUTABLE arm_admits_atomic = ((node.arms OR_ELSE List[])) |> ANY (_.family == :ATOMIC);
    MUTABLE offender: ?CapabilityTransition = caps |> FIND TRY (typeAnalysisSession__cap_admits_atomic?(&rtoc_self_view, _));
    IF !(((offender != NIL) OR arm_admits_atomic)) THEN
      RETURN;
    END
    MUTABLE var_name: String = "";
    IF offender EXISTS AS offender_value THEN
      var_name = COPY offender_value.var_name;
    ELSE
      var_name = "this WITH";
    END
    TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_MULTI_OBJECT_ATOMIC }, [], CAST({:name: var_name} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__cap_admits_atomic?(MUTABLE self: TypeAnalysisSession, cap: CapabilityTransition) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE sym: ?SymbolEntry@multiowned = COPY cap.source_entry;
    IF sym EXISTS AS sym_value THEN
      IF symbolEntry__atomic?(sym_value) THEN
        RETURN TRUE;
      END
      MUTABLE fams: ?[Set]String@symbol = COPY sym_value.sync_families;
      IF !((fams != NIL)) THEN
        RETURN FALSE;
      END
      MUTABLE expanded = TRY (withMatchCheck__expand_snapshotted( fams));
      RETURN expanded.contains?(:ATOMIC);
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__validate_snapshot_match_arms_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: WithBlock) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN ((node.arms OR_ELSE List[])) DO
    MUTABLE clauses = _.lock_error_clauses;
    IF (_.family == :VERSIONED) THEN
        IF clauses.empty?() THEN
          MUTABLE synth: ?ErrorClause = typeAnalysisSession__synthesize_clause_from_policy(&rtoc_self_view, :MvccConflict);
          IF synth EXISTS AS synth_value THEN
            _.lock_error_clauses = [synth_value];
          ELSE
            TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_SNAPSHOT_MATCH_VERSIONED_NEEDS_HANDLER }));
          END
        END
    ELSE_IF (_.family == :ATOMIC) THEN
        IF !(clauses.empty?()) THEN
          TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_SNAPSHOT_MATCH_ATOMIC_FORBIDS_HANDLER }));
        END
    END
    END
    FOR _ IN ((node.arms OR_ELSE List[])) DO
    FOR _ IN _.lock_error_clauses DO
    IF (_.action == ErrorActionKind.Exit) THEN
      TRY (typeAnalysisSession__visit(&rtoc_self_view, _.message));
    ELSE_IF (_.action == ErrorActionKind.Block) THEN
      TRY (typeAnalysisSession__visit_stmts(&rtoc_self_view, _.body()));
    END
    END
    END
}
END
PRIVATE FN typeAnalysisSession__resolve_error_selectors_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: WithBlock, MUTABLE clause: ErrorClause, is_snapshot_txn: Bool = FALSE) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE possible = Set[];
    IF is_snapshot_txn THEN
      &possible.merge(executionBoundaries__snapshot_possible_types());
    END
    MUTABLE capability_plan = TRY (capabilityPlan__require_for(node));
    IF ((TRY (withCapabilityPlan__locks(capability_plan))).length() > 0) THEN
      &possible.merge(executionBoundaries__lock_possible_types());
    END
    IF !(((TRY (withCapabilityPlan__guarded(capability_plan))).length() == 0)) THEN
      &possible.insert(:GuardFail);
    END
    possible = possible |> SELECT COPY _;
    MUTABLE matched = List[];
    FOR _ IN clause.selectors DO
    MUTABLE form = COPY _.form;
    MUTABLE name = COPY _.name;
    MUTABLE token: ?Token@multiowned = COPY _.token;
    MUTABLE diagnostic_token = (token OR_ELSE node.token);
    IF (form == :kind) THEN
        IF !(aST__error_kind?(name)) THEN
          TRY (typeAnalysisSession__emit_registry_mismatch_mut(&rtoc_self_view, diagnostic_token, NameCandidate{ SymbolValue: COPY name }, (((ruby_constant_error_kinds() |> SELECT _.toString() |> SELECT NameCandidate{ StringValue: COPY UNWRAP (castNameCandidateToString(NameCandidate{ StringValue: COPY _ }))}) |> SELECT NameCandidate{ StringValue: COPY _ }) |> SELECT NameCandidate{ StringValue: COPY _ }), "Unknown error kind '${name}'. Expected one of: ${(ruby_constant_error_kinds() |> SELECT _.toString()).join(", ")}", "closest known kind"));
        END
        IF aST__error_kind?(name) THEN
          matched = ruby_array_concat_Any__type_analysis_session(matched, CAST(TRY (aST__types_for_kind(name)) AS []Any));
        END
    ELSE_IF (form == :type) THEN
        IF !(TRY (aST__error_type?(name))) THEN
          TRY (typeAnalysisSession__emit_registry_mismatch_mut(&rtoc_self_view, diagnostic_token, NameCandidate{ SymbolValue: COPY name }, TRY (aST__error_type_names()), "Unknown error type '${name}'. Register it in src/ast/error_registry.rb.", "closest registered type"));
        END
        IF TRY (aST__error_type?(name)) THEN
          &matched.append(name);
        END
    END
    END
    &matched.uniq_mut();
    IF clause.retries EXISTS AS retries_value THEN
      MUTABLE non_transient = matched |> WHERE !((TRY (aST__kind_of_type(_)) == :Transient));
      IF !((non_transient.length() == 0)) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, (IF clause.token EXISTS AS rtoc_anchor_tok_17255 THEN DiagnosticAnchor{ TokenValue: COPY rtoc_anchor_tok_17255 } ELSE DiagnosticAnchor{ Locatable: COPY Locatable{ WithBlock: COPY node } } END), TypeAnalysisCodeOrMessage{ SymbolValue: :RETRY_ONLY_TRANSIENT }, [], CAST({:types: non_transient.join(", ")} AS {String@symbol}Any)));
      END
    END
    MUTABLE overlap = ruby_set_intersection_Any_set(matched, possible);
    IF overlap.empty?() THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :SELECTORS_NO_MATCH }, [], CAST({:matched: matched.join(", "), :possible: "any error the WITH acquire can produce (${possible.join(", ")})."} AS {String@symbol}Any)));
    END
    clause.matched_types = overlap;
    clause.bubble_types = (possible - overlap);
}
END
PRIVATE FN typeAnalysisSession__visit_DoBlock(MUTABLE self: TypeAnalysisSession, MUTABLE node: DoBlock) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR MUTABLE rtoc_mutable_block_param_419 IN node.branches DO
    MUTABLE full_analysis: ?CaptureAnalysis = NIL;
    typeAnalysisSession__with_async_body_fact_frame(&rtoc_self_view, &rtoc_mutable_block_param_419, AsyncValidationNode{ DoBlock: COPY node }, %() USE(rtoc_mutable_block_param_419, MUTABLE rtoc_self_view) -> {
      full_analysis = typeAnalysisSession__with_fiber_capture_analysis(&rtoc_self_view, &rtoc_mutable_block_param_419.parallel, FALSE, %() USE(rtoc_mutable_block_param_419, MUTABLE rtoc_self_view) -> {
        TRY (typeAnalysisSession__visit_stmts(&rtoc_self_view, rtoc_mutable_block_param_419.body));
        rubyToClearVoid__type_analysis_session()
      });
      rubyToClearVoid__type_analysis_session()
    });
    MUTABLE analysis_result = full_analysis?;
    selectOp__set_capture_analysis(&rtoc_mutable_block_param_419, analysis_result);
    IF rtoc_mutable_block_param_419.parallel THEN
        IF analysis_result.has_local THEN
          TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ DoBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :LOCAL_VAR_NOT_IN_PARALLEL }));
        END
        IF analysis_result.has_rc THEN
          TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ DoBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :MULTIOWNED_NOT_IN_PARALLEL }));
        END
    END
    IF analysis_result.has_non_escaping_capture THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ DoBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :DO_CAPTURES_WITH_SCOPED }));
    END
    MUTABLE analysis_branch_value: ?CaptureAnalysis = NIL;
      IF (((!(rtoc_mutable_block_param_419.pinned) AND !(rtoc_mutable_block_param_419.parallel)) AND analysis_result.has_shared)) THEN
        analysis_branch_value = analysis_result;
      ELSE
        analysis_branch_value = NIL;
      END
    MUTABLE analysis: ?CaptureAnalysis = analysis_branch_value;
    IF ((analysis != NIL) AND !(rtoc_mutable_block_param_419.pinned)) THEN
        rtoc_mutable_block_param_419.pinned = TRUE;
        typeAnalysisSession__note_mut(&rtoc_self_view, Locatable{ DoBlock: COPY node }, "DO branch auto-pinned \u{2014} captures shared/locked resource. Use @parallel to distribute.");
    END
    END
    MUTABLE rtoc_open_0 = Locatable{ DoBlock: COPY node };
    RETURN TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, &rtoc_open_0, :Void));
}
END
PRIVATE FN typeAnalysisSession__visit_BgStreamBlock(MUTABLE self: TypeAnalysisSession, MUTABLE node: BgStreamBlock) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__record_effect(&rtoc_self_view, symbol("LOOP_UNBOUND")));
    MUTABLE stream_analysis: ?CaptureAnalysis = NIL;
    MUTABLE yield_types: []Type@multiowned = TRY (typeAnalysisSession__with_stream_yield_frame(&rtoc_self_view, node, %() USE(node, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_420 = typeAnalysisSession__with_async_body_fact_frame(&rtoc_self_view, AsyncBodyNode{ BgStreamBlock: COPY node }, AsyncValidationNode{ BgStreamBlock: COPY node }, %() USE(node, MUTABLE rtoc_self_view) -> {
    stream_analysis = typeAnalysisSession__with_fiber_capture_analysis(&rtoc_self_view, FALSE, FALSE, %() USE(node, MUTABLE rtoc_self_view, MUTABLE yield_types) -> {
      TRY (typeAnalysisSession__visit_stmts(&rtoc_self_view, node.body));
      rubyToClearVoid__type_analysis_session()
    });
    rubyToClearVoid__type_analysis_session()
    });
    rtoc_lambda_result_420
    }));
    MUTABLE stream_analysis_result = stream_analysis?;
    IF (yield_types.length() == 0) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ BgStreamBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :BG_STREAM_NO_YIELD }));
    END
    MUTABLE inferred_join = TRY (tenseOperationPlanner__join_async_results(yield_types));
    IF ((node.declared_yield_type == NIL) AND !(tenseJoinPlan__success?(inferred_join))) THEN
      MUTABLE surfaces = CAST(((yield_types |> SELECT TRY (type__surface_name(TypeTypeInput{ Type: COPY _ }))) |> DISTINCT _) AS []String);
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ BgStreamBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :BG_STREAM_INCONSISTENT_YIELD }, [], CAST({:types: surfaces.join(", "), :union_shape: "Union<${surfaces.join(", ")}>"} AS {String@symbol}Any)));
    ELSE_IF (((node.declared_yield_type == NIL) AND (inferred_join.result_type != NIL)) AND TRY (typeAnalysisSession__stream_yields_contract_required?(&rtoc_self_view, UNWRAP (inferred_join.result_type)))) THEN
      TRY (typeAnalysisSession__emit_missing_stream_yields_contract_mut(&rtoc_self_view, &node, UNWRAP (inferred_join.result_type)));
    END
    MUTABLE element_type = (IF node.declared_yield_type != NIL THEN node.declared_yield_type ELSE UNWRAP (inferred_join.result_type) END);
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ BgStreamBlock: COPY node }, TRY (type__new(TypeConstructionInput{ TypeExpression: COPY typeExpression__of(StreamTypeExpression{ cardinality: TypeExpressionDimension{ SymbolValue: :FINITE }, item: COPY element_type.shape.expression }) }))));
    node.capture_analysis = stream_analysis_result;
    IF stream_analysis_result.has_non_escaping_capture THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ BgStreamBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :BG_STREAM_CAPTURES_WITH_SCOPED }));
    END
}
END
PRIVATE FN typeAnalysisSession__visit_YieldExpr(MUTABLE self: TypeAnalysisSession, MUTABLE node: YieldExpr) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE frame: ?StreamYieldFrame = typeAnalysisSession__current_stream_yield_frame(&rtoc_self_view);
    IF frame EXISTS AS frame_value THEN
      MUTABLE frame_value_mutable = COPY frame_value;
      IF frame_value_mutable.closed THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ YieldExpr: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :YIELD_AFTER_CLOSE }));
      END
      TRY (typeAnalysisSession__visit(&rtoc_self_view, node.expr));
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ YieldExpr: COPY node }, TRY (aST__full_type_mut(node.expr))));
      MUTABLE yielded_type = TRY (type__new(TypeConstructionInput{ Type: COPY TRY (aST__full_type_mut(Locatable{ YieldExpr: COPY node })) }));
      MUTABLE expected_type: ?Type = COPY frame_value_mutable.expected_type;
      IF ((expected_type != NIL) AND !(TRY (type__accepts?(expected_type, yielded_type)))) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ YieldExpr: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :BG_STREAM_INCONSISTENT_YIELD }, [], CAST({:types: "${TRY (type__surface_name(castTypeToTypeTypeInput__type_analysis_session(expected_type)))}, ${TRY (type__surface_name(castTypeToTypeTypeInput__type_analysis_session(yielded_type)))}", :union_shape: "Union<${TRY (type__surface_name(castTypeToTypeTypeInput__type_analysis_session(expected_type)))}, ${TRY (type__surface_name(castTypeToTypeTypeInput__type_analysis_session(yielded_type)))}>"} AS {String@symbol}Any)));
      END
      &frame_value_mutable.yield_types.append(COPY yielded_type);
      TRY (typeAnalysisSession__record_effect(&rtoc_self_view, symbol("SUSPENDS")));
    ELSE
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ YieldExpr: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :YIELD_OUTSIDE_BG_STREAM }));
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__stream_yields_contract_required?(MUTABLE self: TypeAnalysisSession, type: Type) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF type__future?(type) THEN
      RETURN TRUE;
    END
    IF TRY (typeAnalysisSession__lookup_type_schema(&rtoc_self_view, type__resolved(type))) EXISTS AS schema THEN
      RETURN schema IS_A UnionSchema;
    END
    RETURN FALSE;
}
END
PRIVATE FN typeAnalysisSession__emit_missing_stream_yields_contract_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: BgStreamBlock, contract: Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE contract_name = TRY (type__surface_name(castTypeToTypeTypeInput__type_analysis_session(contract)));
    MUTABLE source: ?String = typeAnalysisSession__source_code(&rtoc_self_view);
    MUTABLE token = COPY node.token;
    MUTABLE fix: ?Fix = NIL;
    IF ((source != NIL) AND TRUE) THEN
      MUTABLE line: ?String = COPY source.split("\n")[(token.line - 1)];
      MUTABLE start = (token.column - 1);
      MUTABLE stream_at: ?Int64 = (IF line != NIL THEN
        line.indexOf(compilerRegexCompile("\\bSTREAM\\b"), start)
      ELSE
        NIL
      END);
      IF stream_at EXISTS AS stream_at_value THEN
        MUTABLE insert_col = ((stream_at_value + "STREAM".codepointCount()) + 1);
        fix = TRY (fix__new(TRY (typeAnalysisSession__fix_description(rtoc_self_view, :ADD_STREAM_YIELDS_CONTRACT, CAST({:type: DiagnosticKwValue{ StringValue: COPY contract_name }} AS {String@symbol}DiagnosticKwValue))), [edit__new(span__new(NIL, token.line, insert_col, 0), " YIELDS ${contract_name}")], :auto));
      END
    END
    IF fix EXISTS AS fix_value THEN
      TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ BgStreamBlock: COPY node } }, :type, [fix_value], NIL, :BG_STREAM_YIELDS_REQUIRED, :error, FALSE, CAST({:type: contract_name} AS {String@symbol}Any)));
    ELSE
      RETURN TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ BgStreamBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :BG_STREAM_YIELDS_REQUIRED }, [], CAST({:type: contract_name} AS {String@symbol}Any)));
    END
}
END
PRIVATE FN typeAnalysisSession__visit_CloseStream(MUTABLE self: TypeAnalysisSession, MUTABLE node: CloseStream) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE frame: ?StreamYieldFrame = typeAnalysisSession__current_stream_yield_frame(&rtoc_self_view);
    IF !(frame) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ CloseStream: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :CLOSE_OUTSIDE_BG_STREAM }));
    END
    IF frame?.closed THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ CloseStream: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :STREAM_ALREADY_CLOSED }));
    END
    IF frame EXISTS AS MUTABLE frame_present THEN
      frame_present.closed = TRUE;
    END
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ CloseStream: COPY node }, :Void));
    rtoc_self_view.traversal_state.branch_terminated = TRUE;
}
END
PRIVATE FN typeAnalysisSession__visit_BgBlock(MUTABLE self: TypeAnalysisSession, MUTABLE node: BgBlock) RETURNS !?Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__record_effect(&rtoc_self_view, symbol("YIELD")));
    MUTABLE prev_bg_pinned = typeAnalysisSession__phase_traversal_state(&rtoc_self_view).current_bg_pinned;
    rtoc_self_view.traversal_state.current_bg_pinned = !(!(node.pinned));
    DEFER rtoc_self_view.traversal_state.current_bg_pinned = prev_bg_pinned;
    MUTABLE last_type: Type = TRY (type__new(TypeConstructionInput{ SymbolValue: :Void }));
    MUTABLE full_analysis: ?CaptureAnalysis = NIL;
    typeAnalysisSession__with_async_body_fact_frame(&rtoc_self_view, AsyncBodyNode{ BgBlock: COPY node }, AsyncValidationNode{ BgBlock: COPY node }, %() USE(node, MUTABLE rtoc_self_view) -> {
    full_analysis = typeAnalysisSession__with_fiber_capture_analysis(&rtoc_self_view, &node.parallel, TRUE, %() USE(node, MUTABLE rtoc_self_view) -> {
      FOR MUTABLE rtoc_mutable_block_param_424 IN node.body DO
        TRY (typeAnalysisSession__visit(&rtoc_self_view, rtoc_mutable_block_param_424));
        last_type = (typeAnalysisSession__recoverable_result_type(&rtoc_self_view, &rtoc_mutable_block_param_424, "BG body expression") OR_ELSE TRY (aST__full_type_mut((CAST(rtoc_mutable_block_param_424 AS Locatable)))));
      END
      rubyToClearVoid__type_analysis_session()
    });
    rubyToClearVoid__type_analysis_session()
    });
    MUTABLE analysis_result = full_analysis?;
    MUTABLE declared_payload: ?Type = COPY node.declared_async_payload;
    IF declared_payload EXISTS AS declared_payload_value THEN
      last_type = declared_payload?;
    END
    IF (type__error_union?(last_type) AND ((node.body.last() != NIL) AND TRUE)) THEN
      node.body.last().retain_error_channel = TRUE;
    END
    MUTABLE payload_type = TRY (typeAnalysisSession__owned_async_payload_type(&rtoc_self_view, last_type));
    node.async_result_shape = TRY (asyncResultShape__promise(CAST(payload_type AS Type)));
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, &node, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("~${payload_type}") }))));
    IF node.arena_mode THEN
      node.pinned = TRUE;
      IF node.parallel THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ BgBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :BG_ARENA_AND_PARALLEL }));
      END
    END
    node.capture_analysis = analysis_result;
    IF node.parallel THEN
      IF analysis_result.has_local THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ BgBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :LOCAL_VAR_NOT_IN_PARALLEL }));
      END
      IF analysis_result.has_rc THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ BgBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :MULTIOWNED_NOT_IN_PARALLEL }));
      END
    END
    IF analysis_result.has_non_escaping_capture THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ BgBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :BG_CAPTURES_WITH_SCOPED }));
    END
    MUTABLE analysis_branch_value: ?CaptureAnalysis = NIL;
    IF (((!(node.pinned) AND !(node.parallel)) AND analysis_result.has_shared)) THEN
      analysis_branch_value = analysis_result;
    ELSE
      analysis_branch_value = NIL;
    END
    MUTABLE analysis: ?CaptureAnalysis = analysis_branch_value;
    IF ((prev_bg_pinned AND !(node.pinned)) AND analysis_result.has_outer_ref) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ BgBlock: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :BG_PINNED_CAPTURE_MISMATCH }));
    END
    IF ((analysis != NIL) AND !(node.pinned)) THEN
      IF analysis.has_local THEN
        node.pinned = :local;
        typeAnalysisSession__note_mut(&rtoc_self_view, Locatable{ BgBlock: COPY node }, "BG block auto-pinned \u{2014} captures @local resource (same-scheduler affinity).");
      ELSE_IF analysis.has_affine_locked THEN
        node.pinned = :shared;
        typeAnalysisSession__note_mut(&rtoc_self_view, Locatable{ BgBlock: COPY node }, "BG block auto-pinned \u{2014} captures @locked resource (round-robin scheduler affinity).");
      ELSE
        node.pinned = :local;
        IF analysis.has_sharded THEN
          typeAnalysisSession__note_mut(&rtoc_self_view, Locatable{ BgBlock: COPY node }, "BG block auto-pinned \u{2014} captures @sharded map (scheduler affinity for shard locality).");
        ELSE
          typeAnalysisSession__note_mut(&rtoc_self_view, Locatable{ BgBlock: COPY node }, "BG block auto-pinned \u{2014} captures shared/locked resource. Use @parallel to override.");
        END
      END
    END
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__visit_ThenChain(MUTABLE self: TypeAnalysisSession, MUTABLE node: ThenChain) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE last_type: Type = TRY (type__new(TypeConstructionInput{ SymbolValue: :Void }));
    FOR _ IN node.steps DO
    TRY (typeAnalysisSession__visit(&rtoc_self_view, _.expr));
    MUTABLE step_type = TRY (aST__full_type_mut(_.expr));
    MUTABLE binding: ?String = _.binding;
    IF binding THEN
        MUTABLE bind_type = COPY step_type;
        IF type__error_union?(step_type) THEN
          bind_type = UNWRAP (TRY (type__payload_type(step_type)));
        END
        MUTABLE rtoc_mutable_receiver_425 = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
        TRY (scope__declare(&rtoc_mutable_receiver_425, binding, NIL, SymbolEntryTypeInput{ Type: COPY bind_type }, ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
        typeAnalysisSession__record_capture_local_mut(&rtoc_self_view, CAST(_.binding AS String));
    END
    last_type = step_type;
    END
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ ThenChain: COPY node }, last_type));
}
END
PRIVATE FN typeAnalysisSession__visit_NextExpr(MUTABLE self: TypeAnalysisSession, MUTABLE node: NextExpr) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__record_effect(&rtoc_self_view, symbol("YIELD")));
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.expr));
    MUTABLE expr = COPY node.expr;
    MUTABLE promise_type = TRY (aST__full_type_mut(expr));
    IF !(type__future?(promise_type)) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ NextExpr: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :NEXT_NEEDS_FUTURE }, [], CAST({:got: TRY (aST__full_type_mut(expr))} AS {String@symbol}Any)));
    END
    TRY (typeAnalysisSession__record_effect(&rtoc_self_view, symbol("SUSPENDS")));
    MUTABLE async_shape: ?String@symbol = IF expr IS_A Identifier THEN
      (IF locatable__symbol(expr) != NIL THEN
      { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_427: ?SymbolEntry@multiowned = (locatable__symbol(expr));
    symbolEntry__async_result_shape(UNWRAP (rtoc_local_receiver_427)) }
    ELSE
      NIL
    END)
    ELSE
      NIL
    END;
    IF async_shape.promise?() THEN
      IF (IF expr IS_A Identifier AS identifier THEN !(async_shape.shared_promise?()) ELSE FALSE END) THEN
        TRY (typeAnalysisSession__og_set_moved(&rtoc_self_view, expr.name(), expr.token(), :next));
      END
      MUTABLE result_type = COPY (TRY (typeAnalysisSession__publish_scalar_next_plan(&rtoc_self_view, &node, promise_type, (async_shape.shared_promise?() OR promise_type.shared_promise?())))).result_type;
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ NextExpr: COPY node }, result_type));
      IF TRY (typeAnalysisSession__async_next_result_requires_heap?(&rtoc_self_view, result_type)) THEN
        node.storage_override = :heap;
      END
    ELSE_IF promise_type.promise_list?() THEN
      IF expr IS_A Identifier AS identifier THEN
        TRY (typeAnalysisSession__og_set_moved(&rtoc_self_view, identifier__name(identifier), identifier.token, :next));
      END
      MUTABLE plan = TRY (tenseOperationPlanner__next_value(promise_type));
      node.tense_plan = TensePlanValue{ TenseOperationPlan: COPY plan };
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ NextExpr: COPY node }, plan.result_type));
    ELSE_IF TRY (type__observable_array_future?(promise_type)) THEN
      IF expr IS_A Identifier AS identifier THEN
        TRY (typeAnalysisSession__og_set_moved(&rtoc_self_view, identifier__name(identifier), identifier.token, :next));
      END
      MUTABLE elem_sym = type__to_sym((TRY (type__element_type((TRY (type__tense_type(promise_type)))))));
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ NextExpr: COPY node }, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("${elem_sym}[]") }))));
      node.storage_override = :heap;
    ELSE_IF TRY (type__split_open_stream?(promise_type)) THEN
      elem_sym = type__to_sym((TRY (type__open_stream_element_type(promise_type))));
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ NextExpr: COPY node }, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("?${elem_sym}") }))));
    ELSE_IF TRY (type__dynamic_stream?(promise_type)) THEN
      elem_sym = type__to_sym((TRY (type__element_type((TRY (type__tense_type(promise_type)))))));
      IF type__canonical_stream?(promise_type) THEN
        TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ NextExpr: COPY node }, TRY (type__stream_step_of(TRY (type__element_type((TRY (type__tense_type(promise_type)))))))));
      ELSE
        TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ NextExpr: COPY node }, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("?${elem_sym}") }))));
      END
    ELSE_IF promise_type.bounded_stream?() THEN
      MUTABLE element_type = TRY (type__stream_element_type(promise_type));
      IF type__canonical_stream?(promise_type) THEN
        TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ NextExpr: COPY node }, TRY (type__stream_step_of(element_type))));
      ELSE
        TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ NextExpr: COPY node }, type__to_sym( UNWRAP (element_type))));
      END
    ELSE_IF promise_type.shared_promise?() THEN
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ NextExpr: COPY node }, (TRY (typeAnalysisSession__publish_scalar_next_plan(&rtoc_self_view, &node, promise_type, TRUE))).result_type));
    ELSE_IF (TRY (type__split_open_stream?(promise_type)) OR TRY (type__open_stream?(promise_type))) THEN
      elem_sym = type__to_sym((TRY (type__open_stream_element_type(promise_type))));
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ NextExpr: COPY node }, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("?${elem_sym}") }))));
    ELSE_IF promise_type.inf_stream?() THEN
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ NextExpr: COPY node }, type__to_sym((TRY (type__inf_stream_element_type(promise_type))))));
    ELSE
      IF expr IS_A Identifier AS identifier THEN
        TRY (typeAnalysisSession__og_set_moved(&rtoc_self_view, identifier__name(identifier), identifier.token, :next));
      END
      TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ NextExpr: COPY node }, (TRY (typeAnalysisSession__publish_scalar_next_plan(&rtoc_self_view, &node, promise_type, FALSE))).result_type));
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__publish_scalar_next_plan(MUTABLE self: TypeAnalysisSession, MUTABLE node: NextExpr, promise_type: Type, shared_value: Bool) RETURNS !TenseOperationPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE plan = TRY (tenseOperationPlanner__next_value(promise_type, shared_value));
    node.tense_plan = TensePlanValue{ TenseOperationPlan: COPY plan };
    RETURN plan;
}
END
PRIVATE FN typeAnalysisSession__async_next_result_requires_heap?(MUTABLE self: TypeAnalysisSession, type_info: Type) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF type__id_handle?(type_info) THEN
      RETURN FALSE;
    END
    RETURN TRY (type__ownership_bearing?(type_info, %(name: String@symbol) USE(MUTABLE rtoc_self_view) -> TRY (typeAnalysisSession__schema_lookup_result(&rtoc_self_view, name))));
}
END
PRIVATE FN typeAnalysisSession__owned_async_payload_type(MUTABLE self: TypeAnalysisSession, type_info: Type) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (TRY (type__string?(type_info)) AND type__rodata?(type_info)) THEN
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :String }, NIL, NIL, NIL, :heap));
    END
    RETURN COPY type_info;
}
END
PRIVATE FN typeAnalysisSession__resolve_catch_clauses_from_declarations_mut(MUTABLE self: TypeAnalysisSession, declarations: DeclarationIndex) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN declarations.function_declarations DO
    FOR MUTABLE rtoc_mutable_block_param_428 IN _.catch_clauses DO
    TRY (typeAnalysisSession__resolve_catch_clause_mut(&rtoc_self_view, &rtoc_mutable_block_param_428));
    END
    END
}
END
PRIVATE FN typeAnalysisSession__seed_error_type_registrations_mut(MUTABLE self: TypeAnalysisSession, declarations: DeclarationIndex) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN declarations.error_type_registrations DO
    _, MUTABLE conflict = TRY (aST__register_type_mut(symbol(_.type_name), _.kind, CAST(COPY _.token AS ?Token)));
    IF conflict EXISTS AS conflict_value THEN
        TRY (typeAnalysisSession__emit_error_type_conflict_mut(&rtoc_self_view, Site{ Token: COPY _.token }, _.type_name, conflict_value));
    END
    END
}
END
PRIVATE FN typeAnalysisSession__baked_in_default_sync_policy(MUTABLE self: TypeAnalysisSession) RETURNS ![]ErrorClause
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN CAST([ErrorClause{ selectors: [ErrorSelector{ form: :type, name: :LockTimeout, token: NIL }], retries: 3, action: COPY ErrorActionKind.Raise, token: NIL, value: NIL, message: NIL, body: List[], matched_types: List[], bubble_types: List[] }, ErrorClause{ selectors: [ErrorSelector{ form: :type, name: :MvccConflict, token: NIL }], retries: NIL, action: COPY ErrorActionKind.Raise, token: NIL, value: NIL, message: NIL, body: List[], matched_types: List[], bubble_types: List[] }, ErrorClause{ selectors: [ErrorSelector{ form: :type, name: :AtomicConflict, token: NIL }], retries: NIL, action: COPY ErrorActionKind.Raise, token: NIL, value: NIL, message: NIL, body: List[], matched_types: List[], bubble_types: List[] }] AS []ErrorClause);
}
END
PRIVATE FN typeAnalysisSession__validate_and_resolve_sync_policy_mut(MUTABLE self: TypeAnalysisSession, MUTABLE program_node: Program) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE decls = program_node.statements |> WHERE _ IS_A SyncPolicyDecl;
    IF (decls.length() > 1) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY decls[1] }, TypeAnalysisCodeOrMessage{ SymbolValue: :SYNC_POLICY_DUPLICATE }));
    END
    IF decls.empty?() THEN
      program_node.sync_policy = TRY (typeAnalysisSession__baked_in_default_sync_policy(&rtoc_self_view));
      RETURN;
    END
    MUTABLE decl: SyncPolicyDecl = COPY castLocatableToSyncPolicyDecl(UNWRAP (decls.first()));
    MUTABLE has_main = program_node.statements |> ANY (IF _ IS_A FunctionDef AS function_def THEN (function_def.name == name) ELSE FALSE END);
    IF !(has_main) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ SyncPolicyDecl: COPY decl } }, TypeAnalysisCodeOrMessage{ SymbolValue: :SYNC_POLICY_NEEDS_MAIN_FILE }));
    END
    TRY (typeAnalysisSession__validate_sync_policy_body_mut(&rtoc_self_view, decl));
    program_node.sync_policy = decl.handlers;
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ SyncPolicyDecl: COPY decl }, :Void));
}
END
PRIVATE FN typeAnalysisSession__validate_sync_policy_body_mut(MUTABLE self: TypeAnalysisSession, decl: SyncPolicyDecl) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE seen = List[];
    FOR _ IN ((decl.handlers)) DO
    MUTABLE rtoc_each_items_429 = _.selectors;
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_429.length() DO
        IF !((UNWRAP (rtoc_each_items_429[rtoc_idx]).form == :type)) THEN
          rtoc_idx = rtoc_idx + 1;
      CONTINUE;
        END
        MUTABLE name = UNWRAP (rtoc_each_items_429[rtoc_idx]).name;
        IF errors__sync_policy_inline_only_errors().contains?(name) THEN
            TRY (typeAnalysisSession__error_mut(&rtoc_self_view, (IF UNWRAP (rtoc_each_items_429[rtoc_idx]).token != NIL THEN (IF UNWRAP (rtoc_each_items_429[rtoc_idx]).token EXISTS AS rtoc_wrap_17631 THEN DiagnosticAnchor{ TokenValue: COPY rtoc_wrap_17631 } ELSE NIL END) ELSE DiagnosticAnchor{ Locatable: Locatable{ SyncPolicyDecl: COPY decl } } END), TypeAnalysisCodeOrMessage{ SymbolValue: :SYNC_POLICY_INLINE_ONLY }, [], CAST({:name: name, :escape: (IF (name == :Deadlock) THEN
              "DEADLOCK"
            ELSE
              "LOCK_CYCLE"
            END)} AS {String@symbol}Any)));
        END
        IF !(errors__sync_policy_required_errors().contains?(name)) THEN
            TRY (typeAnalysisSession__error_mut(&rtoc_self_view, (IF UNWRAP (rtoc_each_items_429[rtoc_idx]).token != NIL THEN DiagnosticAnchor{ TokenValue: COPY UNWRAP (rtoc_each_items_429[rtoc_idx]).token } ELSE DiagnosticAnchor{ Locatable: Locatable{ SyncPolicyDecl: COPY decl } } END), TypeAnalysisCodeOrMessage{ SymbolValue: :SYNC_POLICY_INVALID_ERROR }, [], CAST({:name: name, :required: errors__sync_policy_required_errors().join(", ")} AS {String@symbol}Any)));
        END
        &seen.append(name);
      rtoc_idx = rtoc_idx + 1;
    END
    MUTABLE rtoc_each_items_430 = _.selectors;
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_430.length() DO
        IF !((UNWRAP (rtoc_each_items_430[rtoc_idx]).form == :kind)) THEN
          rtoc_idx = rtoc_idx + 1;
      CONTINUE;
        END
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, (UNWRAP (rtoc_each_items_430[rtoc_idx]).token OR decl), TypeAnalysisCodeOrMessage{ SymbolValue: :SYNC_POLICY_NEEDS_TYPE_NOT_KIND }, [], CAST({:name: UNWRAP (rtoc_each_items_430[rtoc_idx]).name} AS {String@symbol}Any)));
      rtoc_idx = rtoc_idx + 1;
    END
    END
    MUTABLE seen_set = seen |> DISTINCT _;
    MUTABLE missing = errors__sync_policy_required_errors() |> WHERE !(seen_set.contains?(_));
    IF !(missing.empty?()) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ SyncPolicyDecl: COPY decl } }, TypeAnalysisCodeOrMessage{ SymbolValue: :SYNC_POLICY_INCOMPLETE }, [], CAST({:required: errors__sync_policy_required_errors().join(", "), :missing: missing.join(", ")} AS {String@symbol}Any)));
    END
}
END
PRIVATE FN typeAnalysisSession__collapse_errors_for_call(MUTABLE self: TypeAnalysisSession, sig: FunctionSignature, args: []Locatable) RETURNS ![Set]String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE collapsed: [Set]String@symbol = Set[];
    MUTABLE param_indices = {
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE rtoc_indexed_items_431: []Param = TRY (functionSignature__params(sig));
    MUTABLE rtoc_indexed_output_433 = {};
    MUTABLE rtoc_indexed_i_432 = 0;
    WHILE rtoc_indexed_i_432 < rtoc_indexed_items_431.length() DO
      MUTABLE rtoc_indexed_pair_434 = Tuple{UNWRAP (rtoc_indexed_items_431[rtoc_indexed_i_432]).name, COPY rtoc_indexed_i_432};
      rtoc_indexed_output_433[rtoc_indexed_pair_434._0] = rtoc_indexed_pair_434._1;
      rtoc_indexed_i_432 = rtoc_indexed_i_432 + 1;
    END
    rtoc_indexed_output_433
    };
    FOR param_name IN (TRY (functionSignature__requires(sig))).keys() DO
    MUTABLE ignored_families: [Set]String@symbol = ((TRY (functionSignature__requires(sig)))[param_name] OR_ELSE CAST(panic("missing hash key") AS [Set]String@symbol));
    MUTABLE idx: ?Int64 = param_indices[param_name];
    IF !(idx) THEN
        CONTINUE;
    END
    MUTABLE arg: ?Locatable = COPY args[idx];
    IF !(arg) THEN
        CONTINUE;
    END
    MUTABLE families = TRY (withMatchCheck__family_of_arg_set( arg));
    IF (FALSE OR families.empty?()) THEN
        CONTINUE;
    END
    FOR _ IN families DO
      MUTABLE axes = (((CAST({:LOCKED: [:locked, :write_locked] |> DISTINCT _, :SNAPSHOTTED: [:versioned, :atomic] |> DISTINCT _, :VERSIONED: [:versioned] |> DISTINCT _, :ATOMIC: [:atomic] |> DISTINCT _, :LOCAL: [:local, :multiowned, :plain] |> DISTINCT _, :ACTOR: [:actor] |> DISTINCT _, :LOCK_FREE: [:lock_free] |> DISTINCT _} AS {String@symbol}[Set]String@symbol))[_]) OR_ELSE Set[]);
      FOR _ IN axes DO
      FOR _ IN ((((CAST({:locked: [:LockTimeout] |> DISTINCT _, :write_locked: [:LockTimeout] |> DISTINCT _, :versioned: [:MvccConflict] |> DISTINCT _, :atomic: [:AtomicConflict] |> DISTINCT _} AS {String@symbol}[Set]String@symbol))[_]) OR_ELSE Set[])) DO
      &collapsed.insert(COPY _);
      END
      END
    END
    END
    RETURN collapsed;
}
END
PRIVATE FN typeAnalysisSession__synthesize_clause_from_policy(MUTABLE self: TypeAnalysisSession, error_name: String@symbol) RETURNS ?ErrorClause
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE handlers: ?[]ErrorClause = COPY typeAnalysisSession__semantic_program(&rtoc_self_view).sync_policy;
    IF !(handlers) THEN
      RETURN NIL;
    END
    FOR handler IN handlers DO
      IF handler.selectors |> ANY ((_.form == :type) AND (_.name == error_name)) THEN
        RETURN COPY handler;
      END
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__visit_SyncPolicyDecl(MUTABLE self: TypeAnalysisSession, MUTABLE node: SyncPolicyDecl) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN ((node.handlers)) DO
    IF (_.action == ErrorActionKind.Exit) THEN
      TRY (typeAnalysisSession__visit(&rtoc_self_view, _.message));
    ELSE_IF (_.action == ErrorActionKind.Block) THEN
      TRY (typeAnalysisSession__visit_stmts(&rtoc_self_view, _.body));
    END
    END
    TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ SyncPolicyDecl: COPY node }, :Void));
}
END
PRIVATE FN typeAnalysisSession__resolve_catch_clause_mut(MUTABLE self: TypeAnalysisSession, MUTABLE clause: CatchClause) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE kinds = List[];
    MUTABLE types = List[];
    FOR _ IN clause.items DO
    IF (_.form == :kind) THEN
      MUTABLE kind_sym = symbol(_.name);
      IF !(aST__error_kind?(kind_sym)) THEN
        TRY (typeAnalysisSession__emit_registry_mismatch_mut(&rtoc_self_view, CAST(COPY _.token AS Token), NameCandidate{ StringValue: COPY UNWRAP (castNameCandidateToString(NameCandidate{ StringValue: COPY _.name }))}, (((ruby_constant_error_kinds() |> SELECT _.toString() |> SELECT NameCandidate{ StringValue: COPY _ }) |> SELECT NameCandidate{ StringValue: COPY _ }) |> SELECT NameCandidate{ StringValue: COPY _ }), "Unknown error kind '${_.name}'. Expected one of: ${(ruby_constant_error_kinds() |> SELECT _.toString()).join(", ")}", "closest known kind"));
      END
      IF aST__error_kind?(kind_sym) THEN
        &kinds.append(kind_sym);
      END
    ELSE
      MUTABLE type_sym = symbol(_.name);
      IF !(TRY (aST__error_type?(type_sym))) THEN
        TRY (typeAnalysisSession__emit_registry_mismatch_mut(&rtoc_self_view, CAST(COPY _.token AS Token), NameCandidate{ StringValue: COPY _.name }, TRY (aST__error_type_names()), "CATCH ${_.name}: error type '${_.name}' is not registered. A type must be registered via RAISE/OR_ELSE EXIT before it can be CATCHed.", "closest registered type"));
      END
      IF TRY (aST__error_type?(type_sym)) THEN
        &types.append(COPY _.name);
      END
    END
    END
    clause.kinds = CAST((kinds |> DISTINCT _) AS []Any);
    clause.types = CAST((types |> DISTINCT _) AS []Any);
    MUTABLE filter_types = List[];
    MUTABLE filter_messages = List[];
    FOR _ IN clause.filters DO
    IF (_.form == :type) THEN
      MUTABLE type_sym = symbol((CAST(_.value AS String)));
      IF !(TRY (aST__error_type?(type_sym))) THEN
        TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ TokenValue: COPY _.token }, TypeAnalysisCodeOrMessage{ SymbolValue: :CATCH_WITH_UNREGISTERED }, [], CAST({:name: _.value} AS {String@symbol}Any)));
      END
      &filter_types.append(COPY CAST(_.value AS String));
    ELSE_IF (_.form == :message) THEN
      MUTABLE message_expr: Locatable = COPY CAST(_.value AS Locatable);
      TRY (typeAnalysisSession__visit(&rtoc_self_view, message_expr));
      &filter_messages.append(message_expr);
    END
    END
    clause.filter_types = CAST((filter_types |> DISTINCT _) AS []Any);
    clause.filter_messages = filter_messages;
}
END
PRIVATE FN typeAnalysisSession__visit_Assert(MUTABLE self: TypeAnalysisSession, MUTABLE node: Assert) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.condition));
    IF (locatable__resolved_type(UNWRAP (locatable__condition( Locatable{ Assert: COPY node }))) != :Bool) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ Assert: COPY node } }, TypeAnalysisCodeOrMessage{ SymbolValue: :ASSERT_NEEDS_BOOL }));
    END
    RETURN TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ Assert: COPY node }, :Void));
}
END
PRIVATE FN typeAnalysisSession__visit_DieNode(MUTABLE self: TypeAnalysisSession, MUTABLE node: DieNode) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node.status THEN
      TRY (typeAnalysisSession__visit(&rtoc_self_view, node.status));
