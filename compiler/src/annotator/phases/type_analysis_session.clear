    END
    typeAnalysisSession__accumulate_stack_bytes(&rtoc_self_view, storage, &node);
    TRY (typeAnalysisSession__track_union_alias(&rtoc_self_view, UNWRAP (declarationNode__name(node)), &value));
    TRY (typeAnalysisSession__record_capability_binding(&rtoc_self_view, UNWRAP (declarationNode__name(node)), castDeclarationNodeToLocatable(node), castTypeToFinalType(final_type), storage));
    NIL;
}
END
PRIVATE FN typeAnalysisSession__materialize_inferred_wrapper_annotation_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: DeclarationNode) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE declared: ?Type = NIL;
    MATCH node START
      DeclarationNode.VarDecl AS item ->
        declared = COPY item.type;,
      DeclarationNode.BindExpr AS item ->
        declared = COPY item.type;,
    END
    IF declared EXISTS AS declared_value THEN
      MUTABLE wants_future = (type__future?(declared_value) AND (type__resolved((TRY (type__tense_type(declared_value)))) == symbol("Auto")));
      MUTABLE wants_error = (type__error_union?(declared_value) AND (type__resolved((TRY (type__success_type(declared_value)))) == symbol("Auto")));
      MUTABLE wants_optional = (type__optional?(declared_value) AND (type__resolved(UNWRAP (TRY (type__wrapped_type(declared_value)))) == symbol("Auto")));
      MUTABLE wants_error_optional = ((type__error_union?(declared_value) AND type__optional?((TRY (type__success_type(declared_value))))) AND (type__resolved(UNWRAP (TRY (type__wrapped_type((TRY (type__success_type(declared_value))))))) == symbol("Auto")));
      IF !((((wants_future OR wants_error) OR wants_optional) OR wants_error_optional)) THEN
        RETURN;
      END
      MUTABLE value_type = TRY (type__new(TypeConstructionInput{ Type: COPY (MATCH node START DeclarationNode.VarDecl AS item -> TRY (aST__full_type_mut(item.value)), DeclarationNode.BindExpr AS item -> TRY (aST__full_type_mut(item.value)) END) }));
      MUTABLE error_type: ?Type@multiowned = TRY (typeAnalysisSession__recoverable_result_type(&rtoc_self_view, UNWRAP (declarationNode__value(node)), "inferred wrapper binding"));
      MUTABLE payload_branch_value: ?Type = NIL;
      IF type__error_union?(value_type) THEN
        payload_branch_value = TRY (type__success_type(value_type));
      ELSE_IF (IF error_type != NIL THEN
        type__error_union?(error_type)
      ELSE
        NIL
      END) THEN
        payload_branch_value = TRY (type__success_type(UNWRAP (error_type)));
      ELSE
        payload_branch_value = value_type;
      END
      MUTABLE payload: Type = payload_branch_value?;
      MUTABLE selected_type = COPY declared_value;
      IF wants_future THEN
        IF type__future?(value_type) THEN
          selected_type = COPY value_type;
        ELSE
          selected_type = declared_value;
        END
      ELSE_IF wants_error_optional THEN
        IF (type__error_union?(value_type) AND type__optional?((TRY (type__success_type(value_type))))) THEN
          selected_type = COPY value_type;
        ELSE_IF ((!((error_type == NIL)) AND type__error_union?(error_type)) AND type__optional?(payload)) THEN
          selected_type = CAST(KEEP error_type AS Type);
        ELSE
          selected_type = TRY (type__error_union_of(castTypeToTypeTypeInput__type_analysis_session(TRY (type__optional_of(castTypeToTypeTypeInput__type_analysis_session(payload))))));
        END
      ELSE_IF wants_error THEN
        IF type__error_union?(value_type) THEN
          selected_type = value_type;
        ELSE_IF (!((error_type == NIL)) AND type__error_union?(error_type)) THEN
          selected_type = CAST(error_type AS Type);
        ELSE
          selected_type = TRY (type__error_union_of(castTypeToTypeTypeInput__type_analysis_session(payload)));
        END
      ELSE
        IF type__optional?(payload) THEN
          selected_type = COPY payload;
        ELSE
          selected_type = TRY (type__optional_of(castTypeToTypeTypeInput__type_analysis_session(payload)));
        END
      END
      MATCH node START
        DeclarationNode.VarDecl AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.type = selected_type;
          MUTABLE node = DeclarationNode{ VarDecl: item_mutable };,
        DeclarationNode.BindExpr AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.type = selected_type;
          MUTABLE node = DeclarationNode{ BindExpr: item_mutable };,
      END
      IF (wants_error OR wants_error_optional) THEN
        MUTABLE value_node: Locatable = NIL;
        MATCH node START
          DeclarationNode.VarDecl AS item ->
            value_node = COPY item.value;,
          DeclarationNode.BindExpr AS item ->
            value_node = COPY item.value;,
        END
        IF (aST__node_retain_error_channel(value_node) EXISTS) THEN
          value_node.retain_error_channel = TRUE;
        END
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__reject_implicit_wrapper_binding_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: DeclarationNode, MUTABLE process_deferred_copy: Bool = FALSE) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF declarationNode__type(node) THEN
      RETURN;
    END
    MUTABLE value: ?Locatable = NIL;
    MATCH node START
      DeclarationNode.VarDecl AS item ->
        value = COPY item.value;,
      DeclarationNode.BindExpr AS item ->
        value = COPY item.value;,
    END
    IF (UNWRAP (value) IS_A CopyNode AND !(process_deferred_copy)) THEN
      &rtoc_self_view.traversal_state.deferred_copy_wrapper_bindings.append(node);
      RETURN;
    END
    MUTABLE rtoc_open_1 = UNWRAP (value);
    MUTABLE error_type: ?Type@multiowned = TRY (typeAnalysisSession__recoverable_result_type(&rtoc_self_view, &rtoc_open_1, "inferred wrapper binding"));
    MUTABLE error_success_type_branch_value: ?Type = NIL;
    IF error_type EXISTS AS error_type_value THEN
      IF type__error_union?(error_type_value) THEN
      error_success_type_branch_value = TRY (type__success_type(UNWRAP (error_type)));
    ELSE
      error_success_type_branch_value = NIL;
    END
    END
    MUTABLE error_success_type: ?Type = error_success_type_branch_value;
    MUTABLE value_type = TRY (type__new(TypeConstructionInput{ Type: COPY TRY (aST__full_type_mut(UNWRAP (value))) }));
    MUTABLE asynchronous = (((type__future?(value_type) OR TRY (type__stream?(value_type))) OR type__future?( UNWRAP (error_success_type))) OR TRY (type__stream?( UNWRAP (error_success_type))));
    IF asynchronous THEN
      TRY (typeAnalysisSession__emit_inferred_async_binding_mut(&rtoc_self_view, &node, value_type, CAST(error_type AS ?Type)));
      RETURN;
    END
    MUTABLE fallible = !((error_type == NIL));
    IF fallible THEN
      TRY (typeAnalysisSession__emit_inferred_wrapper_binding_mut(&rtoc_self_view, &node, :INFERRED_FALLIBLE_BINDING, "TRY ", "!"));
      RETURN;
    END
    IF !(type__optional?(value_type)) THEN
      RETURN;
    END
    IF ((aST__node_safe_nav_chain(UNWRAP (value)) EXISTS) AND (locatable__safe_nav_chain(UNWRAP (value)) == TRUE)) THEN
      RETURN;
    END
    TRY (typeAnalysisSession__emit_inferred_wrapper_binding_mut(&rtoc_self_view, &node, :INFERRED_OPTIONAL_BINDING, "UNWRAP ", "?"));
}
END
PRIVATE FN typeAnalysisSession__emit_inferred_async_binding_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: DeclarationNode, value_type: Type, error_type: ?Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE async_type_branch_value: ?Type = NIL;
    IF error_type EXISTS AS error_type_value THEN
      IF type__error_union?(error_type_value) THEN
      async_type_branch_value = TRY (type__success_type( UNWRAP (error_type)));
    ELSE
      async_type_branch_value = COPY value_type;
    END
    END
    MUTABLE async_type: Type = async_type_branch_value?;
    MUTABLE stream = TRY (type__stream?(async_type));
    MUTABLE action: String = "";
    IF stream THEN
      action = "COLLECT";
    ELSE
      action = "NEXT";
    END
    MUTABLE wrapper = "~";
    MUTABLE value_token: ?Token = (MATCH node START DeclarationNode.VarDecl AS item -> locatable__token(item.value), DeclarationNode.BindExpr AS item -> locatable__token(item.value) END);
    MUTABLE fixes: []Fix = ( { MUTABLE rtoc_empty_list_372: []Fix = List[]; rtoc_empty_list_372 } );
    IF !(stream) THEN
      &fixes.append(TRY (fix__new(TRY (typeAnalysisSession__fix_description(rtoc_self_view, :CONSUME_FUTURE_WITH_NEXT)), [edit__new(span__new(NIL, UNWRAP (value_token).line, UNWRAP (value_token).column, 0), "NEXT ")], :auto)));
    ELSE
      MUTABLE value_range: ?SourceRange = (MATCH node START DeclarationNode.VarDecl AS item -> locatable__source_range(item.value), DeclarationNode.BindExpr AS item -> locatable__source_range(item.value) END);
      &fixes.append(TRY (fix__new(TRY (typeAnalysisSession__fix_description(rtoc_self_view, :CONSUME_STREAM_WITH_COLLECT)), [edit__new(span__new(UNWRAP (value_range).file, (UNWRAP (value_range)).end_line, UNWRAP (value_range).end_column, 0), " |> COLLECT")], :auto)));
    END
    IF node IS_A BindExpr AS bind_expr THEN
      &fixes.append(TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :RETAIN_ASYNC_WRAPPER, CAST({:kind: DiagnosticKwValue{ StringValue: COPY IF stream THEN
        "stream"
      ELSE
        "future"
      END }} AS {String@symbol}DiagnosticKwValue)), [edit__new(span__new(NIL, bind_expr.token.line, (bind_expr.token.column + (bind_expr.name).length()), 0), ":${wrapper}")], :auto)));
    END
    TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, diagnosticAnchor__of(castDeclarationNodeToLocatable(node)), :type, fixes, NIL, :INFERRED_ASYNC_BINDING, :error, TRUE, CAST({:name: UNWRAP (declarationNode__name(node)), :expected_action: action} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__emit_inferred_wrapper_binding_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: DeclarationNode, code: String@symbol, prefix: String, wrapper: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE value_range: ?SourceRange = (MATCH node START DeclarationNode.VarDecl AS item -> locatable__source_range(item.value), DeclarationNode.BindExpr AS item -> locatable__source_range(item.value) END);
    MUTABLE wraps_expression = (MATCH node START DeclarationNode.VarDecl AS item -> item.value IS_A BinaryOp, DeclarationNode.BindExpr AS item -> item.value IS_A BinaryOp END);
    MUTABLE fixes = [TRY (fix__new(TRY (typeAnalysisSession__fix_description(rtoc_self_view, :MAKE_VALUE_RECOVERY_EXPLICIT)), (CAST([edit__new(span__new(NIL, (UNWRAP (value_range)).start_line, (UNWRAP (value_range)).start_column, 0), IF wraps_expression THEN
      "${prefix}("
    ELSE
      prefix
    END)] AS []Edit) + ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_374: ?[]Edit = NIL;
    IF wraps_expression THEN
      rtoc_ternary_value_374 = [edit__new(span__new(NIL, (UNWRAP (value_range)).end_line, UNWRAP (value_range).end_column, 0), ")")];
    ELSE
      rtoc_ternary_value_374 = List[];
    END
    rtoc_ternary_value_374? })), :auto))];
    IF node IS_A BindExpr AS bind_expr THEN
      &fixes.append(TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :RETAIN_VALUE_WRAPPER, CAST({:kind: DiagnosticKwValue{ StringValue: COPY IF (wrapper == "!") THEN
        "fallible"
      ELSE
        "optional"
      END }} AS {String@symbol}DiagnosticKwValue)), [edit__new(span__new(NIL, bind_expr.token.line, (bind_expr.token.column + (bind_expr.name).length()), 0), ":${wrapper}")], :auto)));
    END
    TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, diagnosticAnchor__of(castDeclarationNodeToLocatable(node)), :type, fixes, NIL, code, :error, TRUE, CAST({:name: UNWRAP (declarationNode__name(node))} AS {String@symbol}Any)));
}
END
PRIVATE FN typeAnalysisSession__validate_rank_initializer_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: DeclarationNode, declared_type: Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(type__rank?(declared_type)) THEN
      RETURN;
    END
    IF !((MATCH node START DeclarationNode.VarDecl AS item -> item.value IS_A ListLit, DeclarationNode.BindExpr AS item -> item.value IS_A ListLit END)) THEN
      RETURN;
    END
    MUTABLE item_count = ((MATCH node START DeclarationNode.VarDecl AS item -> locatable__items(item.value), DeclarationNode.BindExpr AS item -> locatable__items(item.value) END)).length();
    IF (TRY (type__fixed_rank?(declared_type)) AND (item_count != UNWRAP (type__capacity(declared_type)))) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castDeclarationNodeToLocatable(node)), TypeAnalysisCodeOrMessage{ SymbolValue: :RANK_LITERAL_SIZE }, [], CAST({:expected: UNWRAP (type__capacity(declared_type)), :got: item_count} AS {String@symbol}Any)));
    END
    IF (TRY (type__dynamic_rank?(declared_type)) AND (item_count != 0)) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castDeclarationNodeToLocatable(node)), TypeAnalysisCodeOrMessage{ SymbolValue: :RANK_DYNAMIC_LITERAL_NEEDS_SHAPE }));
    END
}
END
PRIVATE FN typeAnalysisSession__validate_observable_binding_initializer_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: DeclarationNode) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !((((declarationNode__type(node) != NIL) AND type__future?(((declarationNode__type(node))?))) AND (MATCH node START DeclarationNode.VarDecl AS item -> type__observable?( UNWRAP (item.type)), DeclarationNode.BindExpr AS item -> type__observable?( UNWRAP (item.type)) END))) THEN
      RETURN TRUE;
    END
    MUTABLE pipe: ?Locatable = NIL;
    MATCH node START
      DeclarationNode.VarDecl AS item ->
        pipe = COPY item.value;,
      DeclarationNode.BindExpr AS item ->
        pipe = COPY item.value;,
    END
    MUTABLE ok = ((UNWRAP (pipe) IS_A BinaryOp AND UNWRAP locatable__smooth?(UNWRAP ((pipe)))) AND UNWRAP locatable__observable_dest(UNWRAP ((pipe))));
    IF ok THEN
      RETURN TRUE;
    END
    MUTABLE fixes: []Fix@multiowned = TRY (typeAnalysisSession__observable_binding_drop_fixes(&rtoc_self_view, &node));
    IF (fixes.length() == 0) THEN
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castDeclarationNodeToLocatable(node)), TypeAnalysisCodeOrMessage{ SymbolValue: :OBSERVABLE_BINDING_NEEDS_FOLD_PIPE }));
      RETURN FALSE;
    END
    TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, diagnosticAnchor__of(castDeclarationNodeToLocatable(node)), :type, fixes, NIL, :OBSERVABLE_BINDING_NEEDS_FOLD_PIPE, :error, FALSE));
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__observable_binding_drop_fixes(MUTABLE self: TypeAnalysisSession, MUTABLE node: DeclarationNode) RETURNS ![]Fix
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE obs_tok: ?Token@multiowned = NIL;
    MUTABLE fixes: []Fix = ( { MUTABLE rtoc_empty_list_375: []Fix = List[]; rtoc_empty_list_375 } );
    IF (MATCH node START DeclarationNode.VarDecl AS item -> TRUE, DeclarationNode.BindExpr AS item -> TRUE END) THEN
      obs_tok = (MATCH node START DeclarationNode.VarDecl AS item -> type__observable_token( UNWRAP (item.type)), DeclarationNode.BindExpr AS item -> type__observable_token( UNWRAP (item.type)) END);
    END
    IF obs_tok EXISTS AS obs_tok_value THEN
      MUTABLE tok_text = COPY CAST(obs_tok_value.value AS String);
      &fixes.append(TRY (fix__new(TRY (typeAnalysisSession__fix_description(rtoc_self_view, :DROP_OBSERVABLE_CAPABILITY, CAST({:token: DiagnosticKwValue{ StringValue: COPY tok_text }} AS {String@symbol}DiagnosticKwValue))), [edit__new(span__new(NIL, obs_tok_value.line, obs_tok_value.column, tok_text.codepointCount()), "")], :interactive)));
      RETURN fixes;
    ELSE
      RETURN fixes;
    END
}
END
PRIVATE FN typeAnalysisSession__visit_BindExpr(MUTABLE self: TypeAnalysisSession, MUTABLE node: BindExpr) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF typeAnalysisSession__bind_declares_new_symbol?(&rtoc_self_view, &node, TRY (typeAnalysisSession__current_scope(&rtoc_self_view))) THEN
      TRY (typeAnalysisSession__prepare_implicit_ownership_transport_mut(&rtoc_self_view, DeclarationNode{ BindExpr: COPY node }));
    END
    TRY (typeAnalysisSession__visit_declaration_value_mut(&rtoc_self_view, DeclarationNode{ BindExpr: COPY node }));
    MUTABLE scope = TRY (typeAnalysisSession__current_scope(&rtoc_self_view));
    IF typeAnalysisSession__bind_declares_new_symbol?(&rtoc_self_view, &node, &scope) THEN
      TRY (typeAnalysisSession__finalize_bind_declaration_mut( &rtoc_self_view, &node));
    ELSE_IF scope__is_immutable?(scope, node.name) THEN
      TRY (typeAnalysisSession__reject_immutable_bind_assignment_mut(&rtoc_self_view, &node, scope));
    ELSE
      TRY (typeAnalysisSession__finalize_bind_assignment_mut(&rtoc_self_view, &node, &scope));
    END
}
END
PRIVATE FN typeAnalysisSession__visit_declaration_value_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: DeclarationNode) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE declared: ?Type = NIL;
    MATCH node START
      DeclarationNode.VarDecl AS item ->
        declared = COPY item.type;,
      DeclarationNode.BindExpr AS item ->
        declared = COPY item.type;,
    END
    MUTABLE value_node: ?Locatable@boxed = NIL;
    MATCH node START
      DeclarationNode.VarDecl AS item ->
        value_node = COPY item.value;,
      DeclarationNode.BindExpr AS item ->
        value_node = COPY item.value;,
    END
    IF value_node EXISTS AS MUTABLE rtoc_vn THEN
      IF (rtoc_vn IS_A BgBlock AND ((declared != NIL) AND TRY (type__single_future?(declared)))) THEN
        MUTABLE payload = TRY (type__tense_type(declared));
        IF ((TRUE AND !(type__dynamic?(payload))) AND !(type__auto?(payload))) THEN
          IF !(([symbol("Auto"), :Any]).contains?(type__resolved(payload))) THEN
            locatable__set_declared_async_payload_mut(&rtoc_vn, payload);
          END
        END
      END
      IF (rtoc_vn IS_A ListLit AND ((declarationNode__type(node) != NIL) AND type__fixed?(UNWRAP (declarationNode__type(node))))) THEN
        locatable__set_storage_override_mut(&rtoc_vn, :stack);
      END
      IF (rtoc_vn IS_A ListLit AND ((declarationNode__type(node) != NIL) AND type__tuple?(UNWRAP (declarationNode__type(node))))) THEN
        locatable__set_coerced_type_object_mut(&rtoc_vn, declarationNode__type(node));
      END
      IF (rtoc_vn IS_A HashLit AND ((declarationNode__type(node) != NIL) AND type__map?(UNWRAP (declarationNode__type(node))))) THEN
        locatable__set_coerced_type_object_mut(&rtoc_vn, declarationNode__type(node));
      END
      TRY (typeAnalysisSession__visit(&rtoc_self_view, rtoc_vn));
    END
}
END
PRIVATE FN typeAnalysisSession__prepare_implicit_ownership_transport_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: DeclarationNode) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE detail: String = "";
    MUTABLE plan: Any = NIL;
    MATCH node START
      DeclarationNode.VarDecl AS item ->
        plan = COPY item.ownership_transport_plan;,
      DeclarationNode.BindExpr AS item ->
        plan = COPY item.ownership_transport_plan;,
    END
    IF (typeAnalysisSession__language_mode(&rtoc_self_view) == :strict) THEN
      RETURN;
    END
    IF !(FALSE) THEN
      MUTABLE source: ?Locatable = NIL;
      MATCH node START
        DeclarationNode.VarDecl AS item ->
          source = COPY item.value;,
        DeclarationNode.BindExpr AS item ->
          source = COPY item.value;,
      END
      IF !(ownershipTransportFacts__source?(UNWRAP (source))) THEN
        RETURN;
      END
      MUTABLE source_name = ownershipTransportFacts__source_display(UNWRAP (source));
      MATCH node START
        DeclarationNode.VarDecl AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.ownership_transport_plan = OwnershipTransportPlan{ action: :pending, source: COPY source_name, destination: COPY (MATCH node START DeclarationNode.VarDecl AS item -> CAST(item.name AS String), DeclarationNode.BindExpr AS item -> CAST(item.name AS String) END), alias_root: COPY source_name, last_alias_use: NIL, conflicting_mutation: NIL, hidden_cost: NIL };
          MUTABLE node = DeclarationNode{ VarDecl: item_mutable };,
        DeclarationNode.BindExpr AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.ownership_transport_plan = OwnershipTransportPlan{ action: :pending, source: COPY source_name, destination: COPY (MATCH node START DeclarationNode.VarDecl AS item -> CAST(item.name AS String), DeclarationNode.BindExpr AS item -> CAST(item.name AS String) END), alias_root: COPY source_name, last_alias_use: NIL, conflicting_mutation: NIL, hidden_cost: NIL };
          MUTABLE node = DeclarationNode{ BindExpr: item_mutable };,
      END
      RETURN;
    END
    IF (plan.action == :pending) THEN
      RETURN;
    END
    IF (plan.action == :move) THEN
      RETURN;
    END
    MUTABLE source_type = (MATCH node START DeclarationNode.VarDecl AS item -> TRY (aST__full_type_mut(item.value)), DeclarationNode.BindExpr AS item -> TRY (aST__full_type_mut(item.value)) END);
    IF TRY (type__implicitly_copyable?(source_type, %(name: String@symbol) USE(MUTABLE rtoc_self_view) -> TRY (typeAnalysisSession__schema_lookup_result(&rtoc_self_view, name)))) THEN
      RETURN;
    END
    IF plan.conflicting_mutation THEN
      MUTABLE mutation = plan.conflicting_mutation;
      MUTABLE last_line = (((IF plan.last_alias_use != NIL THEN
        (plan.last_alias_use).token().line
      ELSE
        NIL
      END) OR_ELSE (IF mutation.token() != NIL THEN
        (mutation.token()).line
      ELSE
        NIL
      END)) OR (MATCH node START DeclarationNode.VarDecl AS item -> item.token.line, DeclarationNode.BindExpr AS item -> item.token.line END));
      detail = "Aliasing Error: `${plan.destination} = ${plan.source}` creates an inferred alias, but mutation occurs on line ${((IF mutation.token() != NIL THEN
        (mutation.token()).line
      ELSE
        NIL
      END) OR_ELSE (MATCH node START DeclarationNode.VarDecl AS item -> item.token.line, DeclarationNode.BindExpr AS item -> item.token.line END))} while `${plan.destination}` remains live through line ${last_line}. CLEAR will not infer snapshot-versus-shared mutation semantics in EASY, DEFAULT, or STRICT. Write `${plan.destination} = COPY ${plan.source}` for an independent value, or explicitly use @multiowned/@shared and `KEEP ${plan.source}`.";
      MUTABLE source_token = (MATCH node START DeclarationNode.VarDecl AS item -> item.value.token(), DeclarationNode.BindExpr AS item -> item.value.token() END);
      MUTABLE fixes: []Fix = [TRY (fix__new(TRY (typeAnalysisSession__fix_description(rtoc_self_view, :PREFIX_COPY_SNAPSHOT)), [edit__new(span__new(NIL, source_token.line, source_token.column, 0), "COPY ")], :interactive))];
      IF (TRY (type__any_rc?(source_type)) OR type__split?(source_type)) THEN
        &fixes.append(TRY (fix__new(TRY (typeAnalysisSession__fix_description(rtoc_self_view, :PREFIX_EXPLICIT_OWNERSHIP_COST, CAST({:keyword: DiagnosticKwValue{ StringValue: COPY "KEEP" }} AS {String@symbol}DiagnosticKwValue))), [edit__new(span__new(NIL, source_token.line, source_token.column, 0), "KEEP ")], :interactive)));
      END
      TRY (typeAnalysisSession__fixable_mut(&rtoc_self_view, mutation, :ownership, fixes, NIL, :INFERRED_ALIAS_MUTATION, :error, TRUE, CAST({:detail: detail} AS {String@symbol}Any)));
    END
    IF (plan.action == :borrow) THEN
      node.storage = :borrow;
      RETURN;
    END
    IF !((plan.action == :materialize)) THEN
      RETURN;
    END
    MATCH node START
      DeclarationNode.VarDecl AS item ->
        source = COPY item.value;,
      DeclarationNode.BindExpr AS item ->
        source = COPY item.value;,
    END
    source_type = TRY (aST__full_type_mut(source));
