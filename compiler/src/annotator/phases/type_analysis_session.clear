      CONTINUE;
    END
    typeAnalysisSession__extract_type_bindings_mut(rtoc_self_view, node, _.type(), a_param.type(), type_params, &subst);
          };
          typeAnalysisSession__extract_type_bindings_mut(rtoc_self_view, node, param_fn_value.return_type, actual_fn.return_type, type_params, &subst);
        ELSE
          RETURN;
        END
      ELSE
        RETURN;
      END
    ELSE_IF type_params.contains?(p_res) THEN
      MUTABLE actual_binding_branch_value: ?Type@multiowned = NIL;
      IF (typeAnalysisSession__generic_shared_family_param?(rtoc_self_view, param_type) AND type__shared?(actual_type)) THEN
