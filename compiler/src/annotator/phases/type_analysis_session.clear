PRIVATE FN typeAnalysisSession__verify_lifetime_mut(MUTABLE self: TypeAnalysisSession, node: FunctionDef) RETURNS !?Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rl: ?ClearParserReturnLifetime = locatable__return_lifetime(Locatable{ FunctionDef: COPY node });
    IF (rl == NIL) THEN
      RETURN TRUE;
    END
    IF ((IF rl IS_A String@symbol AS rl_payload THEN (rl_payload == :wildcard) ELSE FALSE END)) THEN
      typeAnalysisSession__note_mut(&rtoc_self_view, Locatable{ FunctionDef: COPY node }, "Function '${node.name}' uses wildcard return lifetime `RETURNS *:T`. Every parameter is conservatively folded into the source set. Consider replacing with the explicit list of parameters whose lifetimes the return value actually depends on; `clear fix` (lint) will offer the rewrite once the audit matrix lands.");
      RETURN TRUE;
    END
    MUTABLE sources: []Any = List[];
    IF rl IS_A ArrayValue AS rl_items THEN
      sources = COPY CAST(rl_items AS []Any);
    ELSE
      sources = [CAST(rl AS Any)];
