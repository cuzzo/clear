WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE param: ?GenericParamDecl = (TRY (typeAnalysisSession__current_function_generic_params(&rtoc_self_view))) |> FIND (symbol(_.name) == name);
