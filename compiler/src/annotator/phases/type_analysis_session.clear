PRIVATE FN typeAnalysisSession__apply_expression_subst(self: TypeAnalysisSession, expression: TypeExpression, subst: {String@symbol}GenericBinding) RETURNS !TypeExpression
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE kind = COPY expression.kind;
    MUTABLE cap = COPY expression.capabilities;
    IF (kind IS_A NamedTypeExpression) THEN
      IF (kind.arguments().empty?() AND subst.contains?(kind.name())) THEN
        MUTABLE replacement = TRY (type__new(castOptionalGenericBindingToTypeConstructionInput(subst[kind.name()])));
        IF (type__generic_payload_type_arg?(replacement) AND !(cap.polymorphic_shared)) THEN
          type__strip_runtime_capabilities_mut(&replacement);
        END
        MUTABLE parameter = TRY (type__new(TypeConstructionInput{ TypeExpression: COPY expression }));
        IF typeAnalysisSession__generic_type_has_capabilities?(rtoc_self_view, parameter) THEN
          TRY (type__merge_capabilities_from_mut(&replacement, parameter));
        END
        RETURN COPY replacement.shape.expression;
      END
      RETURN TypeExpression{ kind: TypeExpressionKind{ NamedTypeExpression: COPY NamedTypeExpression{ name: COPY kind.name(), arguments: COPY kind.arguments() |> SELECT typeAnalysisSession__apply_expression_subst(rtoc_self_view, _, subst)  } }, capabilities: COPY cap };
    ELSE_IF (kind IS_A TypeProjectionExpression) THEN
      MUTABLE binding: ?GenericBinding = COPY subst[kind.owner()];
      IF binding EXISTS AS binding_value THEN
        MUTABLE concrete = TRY (type__new(castGenericBindingToTypeConstructionInput(binding_value)));
        MUTABLE projected: ?Type = NIL;
        IF (kind.member() == :Key) THEN
          IF ((((kind.protocol() == NIL) OR (kind.protocol() == :Map))) AND type__map?(concrete)) THEN
            projected = TRY (type__key_type(concrete));
          END
        ELSE_IF (kind.member() == :Value) THEN
          IF ((((kind.protocol() == NIL) OR (kind.protocol() == :Map))) AND type__map?(concrete)) THEN
            projected = TRY (type__value_type(concrete));
          END
        END
        IF (((projected == NIL) AND kind.protocol()) AND (kind.protocol() != :Map)) THEN
          MUTABLE match: ?ConformanceMatch = typeAnalysisSession__conformance_match(rtoc_self_view, CAST(kind.protocol() AS String), concrete);
          IF match EXISTS AS match_value THEN
            MUTABLE associated: ?Type = COPY match_value.resolution.associated_types[kind.member()];
            IF associated EXISTS AS associated_value THEN
              projected = CAST(typeAnalysisSession__apply_type_subst(rtoc_self_view, castTypeToTypeTypeInput(associated_value), match_value.substitutions) AS ?Type);
            END
          END
        END
        IF projected EXISTS AS projected_value THEN
          RETURN typeExpressionTree__with_root_capabilities(projected_value.shape.expression, cap);
        ELSE
          RETURN TypeExpression{ kind: TypeExpressionKind{ TypeProjectionExpression: COPY TypeProjectionExpression{ owner: COPY type__resolved(concrete), member: COPY kind.member(), protocol: COPY kind.protocol() } }, capabilities: COPY cap };
        END
      ELSE
        RETURN COPY expression;
      END
    ELSE_IF (kind IS_A FunctionTypeExpression) THEN
      MUTABLE signature = TRY (type__function_type_for_expression(kind));
      RETURN TypeExpression{ kind: COPY type__function_type_expression_for(FunctionType{ params: COPY signature.params |> SELECT FunctionTypeParam{ type: CAST(COPY typeAnalysisSession__apply_type_subst(rtoc_self_view, castTypeToTypeTypeInput(_.type), subst) AS Type), mutable: FALSE }, return_type: CAST(COPY typeAnalysisSession__apply_type_subst(rtoc_self_view, castTypeToTypeTypeInput(signature.return_type), subst) AS Type), reentrant: signature.reentrant, source_signature: COPY signature.source_signature, abi: COPY signature.abi }), capabilities: COPY cap };
    ELSE_IF (kind IS_A TupleTypeExpression) THEN
      RETURN TypeExpression{ kind: TypeExpressionKind{ TupleTypeExpression: COPY TupleTypeExpression{ items: COPY kind.items() |> SELECT typeAnalysisSession__apply_expression_subst(rtoc_self_view, _, subst)  } }, capabilities: COPY cap };
    ELSE_IF (kind IS_A OptionalTypeExpression) THEN
      RETURN TypeExpression{ kind: TypeExpressionKind{ OptionalTypeExpression: COPY OptionalTypeExpression{ inner: COPY typeAnalysisSession__apply_expression_subst(rtoc_self_view, kind.inner(), subst)  } }, capabilities: COPY cap };
    ELSE_IF (kind IS_A FallibleTypeExpression) THEN
      MUTABLE error_set = kind.error_set();
      RETURN TypeExpression{ kind: COPY FallibleTypeExpression{ inner: COPY typeAnalysisSession__apply_expression_subst(rtoc_self_view, kind.inner(), subst), error_set: COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_186: ?Void = NIL;
      IF (error_set == NIL) THEN
        rtoc_ternary_value_186 = NIL;
      ELSE
        rtoc_ternary_value_186 = typeAnalysisSession__apply_expression_subst(rtoc_self_view, error_set, subst);
      END
      rtoc_ternary_value_186? } }, capabilities: COPY cap };
    ELSE_IF (kind IS_A FutureTypeExpression) THEN
      RETURN TypeExpression{ kind: TypeExpressionKind{ FutureTypeExpression: COPY FutureTypeExpression{ inner: COPY typeAnalysisSession__apply_expression_subst(rtoc_self_view, kind.inner(), subst)  } }, capabilities: COPY cap };
    ELSE_IF (kind IS_A LinearTypeExpression) THEN
      RETURN TypeExpression{ kind: TypeExpressionKind{ LinearTypeExpression: COPY LinearTypeExpression{ kind: COPY kind.kind(), dimensions: COPY kind.dimensions(), item: COPY typeAnalysisSession__apply_expression_subst(rtoc_self_view, kind.item(), subst), allocation_hint: kind.allocation_hint()  } }, capabilities: COPY cap };
    ELSE_IF (kind IS_A MapTypeExpression) THEN
      RETURN TypeExpression{ kind: TypeExpressionKind{ MapTypeExpression: COPY MapTypeExpression{ key: COPY typeAnalysisSession__apply_expression_subst(rtoc_self_view, kind.key(), subst), value: COPY typeAnalysisSession__apply_expression_subst(rtoc_self_view, kind.value(), subst), key_implicit: kind.key_implicit(), legacy_separator: COPY kind.legacy_separator()  } }, capabilities: COPY cap };
    ELSE_IF (kind IS_A StreamTypeExpression) THEN
      RETURN TypeExpression{ kind: TypeExpressionKind{ StreamTypeExpression: COPY StreamTypeExpression{ cardinality: COPY kind.cardinality(), item: COPY typeAnalysisSession__apply_expression_subst(rtoc_self_view, kind.item(), subst)  } }, capabilities: COPY cap };
    ELSE
      RETURN COPY expression;
    END
}
END
PRIVATE FN typeAnalysisSession__generic_binding_value(self: TypeAnalysisSession, type: Type) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (type__new(castTypeToTypeConstructionInput(type)));
}
END
PRIVATE FN typeAnalysisSession__generic_shared_family_param?(self: TypeAnalysisSession, type: Type) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (type__polymorphic_shared?(type) AND compilerRegexMatch((CAST(type__resolved(type) AS String)), compilerRegexCompile("\\A[A-Z]\\z")));
}
END
PRIVATE FN typeAnalysisSession__generic_shared_payload_binding(self: TypeAnalysisSession, type: Type) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE t = TRY (type__new(castTypeToTypeConstructionInput(type)));
    TRY (type__apply_reference_ownership_mut(&t, :affine));
    type__mark_stack_value_mut(&t);
    type__mark_generic_payload_type_arg_mut(&t);
    RETURN t;
}
END
PRIVATE FN typeAnalysisSession__same_generic_binding?(self: TypeAnalysisSession, left: GenericBinding, right: GenericBinding) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE l = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_188: ?GenericBinding = NIL;
    IF left IS_A Type THEN
      rtoc_ternary_value_188 = left;
    ELSE
      rtoc_ternary_value_188 = TRY (type__new(castGenericBindingToTypeConstructionInput(left)));
    END
    rtoc_ternary_value_188? };
    MUTABLE r = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_190: ?GenericBinding = NIL;
    IF right IS_A Type THEN
      rtoc_ternary_value_190 = right;
    ELSE
      rtoc_ternary_value_190 = TRY (type__new(castGenericBindingToTypeConstructionInput(right)));
    END
    rtoc_ternary_value_190? };
    RETURN ((((((l.resolved() == r.resolved()) AND (type__ownership(l) == type__ownership(r))) AND (l.sync() == r.sync())) AND (l.layout() == r.layout())) AND (type__elem_ownership(l) == type__elem_ownership(r))) AND (type__elem_sync(l) == type__elem_sync(r)));
}
END
PRIVATE FN typeAnalysisSession__same_shared_call_capability?(self: TypeAnalysisSession, left: Type, right: Type) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ((((type__sync(left) == type__sync(right)) AND (type__layout(left) == type__layout(right))) AND (type__elem_ownership(left) == type__elem_ownership(right))) AND (type__elem_sync(left) == type__elem_sync(right)));
}
END
PRIVATE FN typeAnalysisSession__generic_type_has_capabilities?(self: TypeAnalysisSession, type: Type) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ((((((type__ownership(type) != :affine) OR !((type__sync(type) == NIL))) OR !((type__layout(type) == NIL))) OR !((type__elem_ownership(type) == NIL))) OR !((type__elem_sync(type) == NIL))) OR !((type__elem_layout(type) == NIL)));
}
END
PRIVATE FN typeAnalysisSession__generic_binding_source(self: TypeAnalysisSession, type: GenericBinding) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE t = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_192: ?GenericBinding = NIL;
    IF type IS_A Type THEN
      rtoc_ternary_value_192 = type;
    ELSE
      rtoc_ternary_value_192 = TRY (type__new(castGenericBindingToTypeConstructionInput(type)));
    END
    rtoc_ternary_value_192? };
    MUTABLE parts = [CAST(t.resolved() AS String)];
    MUTABLE ownership = type__ownership_surface_name(t);
    MUTABLE sync = type__sync_surface_name(t);
    IF ownership THEN
      &parts.append(ownership);
    END
    IF sync THEN
      &parts.append(sync);
    END
    IF t.indirect?() THEN
      &parts.append("@boxed");
    END
    RETURN parts.join("");
}
END
PRIVATE FN typeAnalysisSession__shared_call_capability_display(self: TypeAnalysisSession, type: Type) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE caps = ["@shared"];
    IF type__indirect?(type) THEN
      &caps.append("indirect");
    END
    &caps.append(UNWRAP (type__sync_family_name(type)));
    RETURN (caps |> WHERE _ != NIL).join(":");
}
END
PRIVATE FN typeAnalysisSession__substitute_type_params(self: TypeAnalysisSession, signature: FunctionSignature, subst: {String@symbol}GenericBinding) RETURNS !FunctionSignature@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (functionSignature__new((TRY (functionSignature__params(signature))) |> SELECT (COPY _).tap(%(np) USE(subst, _, rtoc_self_view) -> {
    np.type = typeAnalysisSession__apply_type_subst(rtoc_self_view, castTypeToTypeTypeInput(_.type), subst);
    NIL
    }), TypeTypeInput{ Type: COPY typeAnalysisSession__apply_type_subst(rtoc_self_view, TypeTypeInput{ Type: COPY functionSignature__return_type(signature) }, subst) }, FunctionSignatureLifetimeInput{ ArrayValue: COPY TRY (functionSignature__return_lifetime(signature)) }, functionSignature__visibility(signature), ( { MUTABLE rtoc_empty_list_193: []String@symbol = List[]; rtoc_empty_list_193 } ), {}, FALSE, FALSE, NIL, NIL, NIL, ( { MUTABLE rtoc_empty_list_194: []String@symbol = List[]; rtoc_empty_list_194 } ), NIL, ( { MUTABLE rtoc_empty_list_195: []String@symbol = List[]; rtoc_empty_list_195 } )));
}
END
PRIVATE FN typeAnalysisSession__validate_stream_type_mut(self: TypeAnalysisSession, node: DeclarationNode) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((MATCH node START DeclarationNode.VarDecl AS item -> type__future?(item.type), DeclarationNode.BindExpr AS item -> type__future?(item.type) END)) THEN
      RETURN;
    END
    IF (MATCH node START DeclarationNode.VarDecl AS item -> type__multiowned?(item.type), DeclarationNode.BindExpr AS item -> type__multiowned?(item.type) END) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :RC_PROMISE_NEEDS_SHARED });
    END
    IF ((MATCH node START DeclarationNode.VarDecl AS item -> type__split?(item.type), DeclarationNode.BindExpr AS item -> type__split?(item.type) END) AND !((MATCH node START DeclarationNode.VarDecl AS item -> TRY (type__split_open_stream?(item.type)), DeclarationNode.BindExpr AS item -> TRY (type__split_open_stream?(item.type)) END))) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :ATSPLIT_NEEDS_OPEN_STREAM });
    END
}
END
PRIVATE FN typeAnalysisSession__propagate_declared_type_to_value_mut(self: TypeAnalysisSession, node: DeclarationNode, final_type: AnnotationTypeShape) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE value_type = NIL;
    IF !((MATCH node START DeclarationNode.VarDecl AS item -> item.type, DeclarationNode.BindExpr AS item -> item.type END)) THEN
      RETURN;
    END
    MUTABLE final_type_info = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_197: ?AnnotationTypeShape = NIL;
    IF final_type IS_A Type THEN
      rtoc_ternary_value_197 = final_type;
    ELSE
      rtoc_ternary_value_197 = TRY (type__new(castAnnotationTypeShapeToTypeConstructionInput(final_type)));
    END
    rtoc_ternary_value_197? };
    IF ((MATCH node START DeclarationNode.VarDecl AS item -> item.value IS_A BgStreamBlock, DeclarationNode.BindExpr AS item -> item.value IS_A BgStreamBlock END) AND (MATCH node START DeclarationNode.VarDecl AS item -> TRY (type__inf_stream?(item.type)), DeclarationNode.BindExpr AS item -> TRY (type__inf_stream?(item.type)) END)) THEN
      MUTABLE stream: BgStreamBlock = NIL;
      MATCH node START
        DeclarationNode.VarDecl AS item ->
          stream = COPY item.value;,
        DeclarationNode.BindExpr AS item ->
          stream = COPY item.value;,
      END
      IF typeAnalysisSession__stream_body_contains_close?(rtoc_self_view, stream.body) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, stream, TypeAnalysisCodeOrMessage{ SymbolValue: :INFINITE_STREAM_CLOSE });
      END
      IF typeAnalysisSession__stream_body_may_fall_through?(rtoc_self_view, stream.body) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, stream, TypeAnalysisCodeOrMessage{ SymbolValue: :INFINITE_STREAM_FALLTHROUGH });
      END
    END
    IF ((MATCH node START DeclarationNode.VarDecl AS item -> item.value IS_A BgStreamBlock, DeclarationNode.BindExpr AS item -> item.value IS_A BgStreamBlock END) AND (MATCH node START DeclarationNode.VarDecl AS item -> TRY (type__runtime_stream?(item.type)), DeclarationNode.BindExpr AS item -> TRY (type__runtime_stream?(item.type)) END)) THEN
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, (MATCH node START DeclarationNode.VarDecl AS item -> item.value, DeclarationNode.BindExpr AS item -> item.value END), final_type_info));
    END
    IF ((MATCH node START DeclarationNode.VarDecl AS item -> item.value IS_A BgStreamBlock, DeclarationNode.BindExpr AS item -> item.value IS_A BgStreamBlock END) AND (MATCH node START DeclarationNode.VarDecl AS item -> TRY (type__split_open_stream?(item.type)), DeclarationNode.BindExpr AS item -> TRY (type__split_open_stream?(item.type)) END)) THEN
      value_type = (MATCH node START DeclarationNode.VarDecl AS item -> &item.value.full_type_mut("BgStreamBlock split_open_stream value"), DeclarationNode.BindExpr AS item -> &item.value.full_type_mut("BgStreamBlock split_open_stream value") END);
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, (MATCH node START DeclarationNode.VarDecl AS item -> item.value, DeclarationNode.BindExpr AS item -> item.value END), TRY (type__new(value_type, :split))));
    END
    IF (MATCH node START DeclarationNode.VarDecl AS item -> type__shard_count(item.type), DeclarationNode.BindExpr AS item -> type__shard_count(item.type) END) THEN
      TRY (type__copy_topology_from_mut(&final_type_info, (MATCH node START DeclarationNode.VarDecl AS item -> item.type, DeclarationNode.BindExpr AS item -> item.type END)));
    END
    IF ((MATCH node START DeclarationNode.VarDecl AS item -> item.value IS_A BgBlock, DeclarationNode.BindExpr AS item -> item.value IS_A BgBlock END) AND (MATCH node START DeclarationNode.VarDecl AS item -> type__shared_promise?(item.type), DeclarationNode.BindExpr AS item -> type__shared_promise?(item.type) END)) THEN
      value_type = (MATCH node START DeclarationNode.VarDecl AS item -> &item.value.full_type_mut("BgBlock shared_promise value"), DeclarationNode.BindExpr AS item -> &item.value.full_type_mut("BgBlock shared_promise value") END);
      MUTABLE rtoc_writer_receiver_198: Void = (MATCH node START DeclarationNode.VarDecl AS item -> item.value, DeclarationNode.BindExpr AS item -> item.value END);
      rtoc_writer_receiver_198.async_result_shape = TRY (asyncResultShape__promise(Type{ Type: COPY TRY (type__tense_type(value_type)) }, TRUE));
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, (MATCH node START DeclarationNode.VarDecl AS item -> item.value, DeclarationNode.BindExpr AS item -> item.value END), TRY (type__new(value_type, :shared))));
    END
}
END
PRIVATE FN typeAnalysisSession__stream_body_contains_close?(self: TypeAnalysisSession, body: []Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN body |> ANY (_ IS_A CloseStream OR ((TRY (aST__child_bodies(_))) |> ANY typeAnalysisSession__stream_body_contains_close?(rtoc_self_view, _)));
}
END
PRIVATE FN typeAnalysisSession__stream_body_may_fall_through?(self: TypeAnalysisSession, body: []Locatable) RETURNS Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (body.length() == 0) THEN
      RETURN TRUE;
    END
    MUTABLE stmt: ?Locatable = COPY body.last();
    IF (((((stmt != NIL) AND (stmt IS_A CloseStream)) OR ((stmt != NIL) AND (stmt IS_A ReturnNode))) OR ((stmt != NIL) AND (stmt IS_A Raise))) OR ((stmt != NIL) AND (stmt IS_A DieNode))) THEN
      RETURN FALSE;
    END
    IF stmt? IS_A IfStatement AS if_statement THEN
      IF if_statement.else_branch EXISTS AS optional_value_value THEN
        IF optional_value_value.empty?() THEN
          RETURN TRUE;
        ELSE
          RETURN (typeAnalysisSession__stream_body_may_fall_through?(rtoc_self_view, if_statement.then_branch) OR typeAnalysisSession__stream_body_may_fall_through?(rtoc_self_view, optional_value_value));
        END
      ELSE
        RETURN TRUE;
      END
    END
    IF stmt? IS_A IfBind AS if_bind THEN
      IF ((if_bind.else_branch == NIL) OR if_bind.else_branch.empty?()) THEN
        RETURN TRUE;
      END
      RETURN (typeAnalysisSession__stream_body_may_fall_through?(rtoc_self_view, if_bind.then_branch) OR typeAnalysisSession__stream_body_may_fall_through?(rtoc_self_view, if_bind.else_branch));
    END
    IF stmt? IS_A WhileLoop AS while_loop THEN
      MUTABLE condition = while_loop.condition;
      MUTABLE is_true = (IF condition IS_A Literal AS literal THEN literal__true_boolean?(literal) ELSE FALSE END);
      IF (is_true AND !(typeAnalysisSession__stream_body_contains_break?(rtoc_self_view, while_loop.do_branch))) THEN
        RETURN FALSE;
      END
    END
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__stream_body_contains_break?(self: TypeAnalysisSession, body: []Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN body |> ANY (IF _ IS_A BreakNode THEN TRUE ELSE (IF (aST__loop_node?(_) OR aST__call_like_boundary?(_)) THEN FALSE ELSE (TRY (aST__child_bodies(_))) |> ANY typeAnalysisSession__stream_body_contains_break?(rtoc_self_view, _) END) END);
}
END
PRIVATE FN typeAnalysisSession__propagate_collection_metadata_mut(self: TypeAnalysisSession, MUTABLE node: DeclarationNode, final_type: AnnotationTypeShape) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE _ = COPY final_type;
    MUTABLE decl_type: ?Type = NIL;
    MATCH node START
      DeclarationNode.VarDecl AS item ->
        decl_type = COPY item.type;,
      DeclarationNode.BindExpr AS item ->
        decl_type = COPY item.type;,
    END
    MUTABLE node_type = &node.full_type_mut("declaration metadata target");
    MUTABLE value_type = (MATCH node START DeclarationNode.VarDecl AS item -> &item.value.full_type_mut("declaration metadata value"), DeclarationNode.BindExpr AS item -> &item.value.full_type_mut("declaration metadata value") END);
    MUTABLE coll_src_branch_value: ?Type = NIL;
    IF type__rank?(decl_type) THEN
      coll_src_branch_value = NIL;
    ELSE_IF type__collection(decl_type) THEN
      coll_src_branch_value = decl_type;
    ELSE_IF type__collection(value_type) THEN
      coll_src_branch_value = value_type;
    ELSE
      coll_src_branch_value = NIL;
    END
    MUTABLE coll_src: ?Type = coll_src_branch_value;
    IF coll_src EXISTS AS coll_src_value THEN
      MUTABLE coll_src_value_mutable = COPY coll_src_value;
      TRY (type__copy_collection_shape_from_mut(&node_type, coll_src_value_mutable));
      IF (type__pool?(coll_src_value_mutable) OR type__set_collection?(coll_src_value_mutable)) THEN
        type__mark_heap_allocated_mut(&node_type);
      END
    END
    IF (!(coll_src) AND ((decl_type != NIL) AND type__soa((decl_type?)))) THEN
      TRY (type__mark_soa_layout_mut(&node_type));
    END
    IF decl_type EXISTS AS decl_type_value THEN
      MUTABLE decl_type_value_mutable = COPY decl_type_value;
      TRY (type__copy_declared_collection_modifiers_from_mut(&node_type, decl_type_value_mutable));
    END
}
END
PRIVATE FN typeAnalysisSession__propagate_call_flags_mut(self: TypeAnalysisSession, node: AnnotationNode) RETURNS ?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE _ = COPY node;
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__register_container_borrow_mut(self: TypeAnalysisSession, MUTABLE node: DeclarationNode) RETURNS ?Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE container: ?String = typeAnalysisSession__find_container_source(rtoc_self_view, (MATCH node START DeclarationNode.VarDecl AS item -> item.value, DeclarationNode.BindExpr AS item -> item.value END));
    IF container EXISTS AS container_value THEN
      MUTABLE container_value_mutable = COPY container_value;
      MUTABLE var_name: String = "";
      IF (MATCH node START DeclarationNode.VarDecl AS item -> item.name IS_A String, DeclarationNode.BindExpr AS item -> item.name IS_A String END) THEN
        var_name = (MATCH node START DeclarationNode.VarDecl AS item -> item.name, DeclarationNode.BindExpr AS item -> item.name END);
      ELSE
        var_name = COPY (MATCH node START DeclarationNode.VarDecl AS item -> CAST(item.name AS String), DeclarationNode.BindExpr AS item -> CAST(item.name AS String) END);
      END
      MUTABLE graph_node: ?OwnershipNode = COPY ownershipGraph__get_index(typeAnalysisSession__ownership_graph(rtoc_self_view), var_name);
      IF graph_node EXISTS AS graph_node_value THEN
        MUTABLE graph_node_value_mutable = COPY graph_node_value;
        graph_node_value_mutable.kind = :borrowed;
      END
      IF (TRUE AND ((MATCH node START DeclarationNode.VarDecl AS item -> item.symbol, DeclarationNode.BindExpr AS item -> item.symbol END) != NIL)) THEN
        MUTABLE rtoc_mutable_receiver_199 = UNWRAP ((MATCH node START DeclarationNode.VarDecl AS item -> item.symbol, DeclarationNode.BindExpr AS item -> item.symbol END));
        symbolEntry__mark_borrowed_alias_mut(&rtoc_mutable_receiver_199);
      END
      MATCH node START
        DeclarationNode.VarDecl AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.container_borrow = TRUE;
          node = DeclarationNode{ VarDecl: item_mutable };,
        DeclarationNode.BindExpr AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.container_borrow = TRUE;
          node = DeclarationNode{ BindExpr: item_mutable };,
      END
      MUTABLE value_node: Any = NIL;
      MATCH node START
        DeclarationNode.VarDecl AS item ->
          value_node = COPY item.value;,
        DeclarationNode.BindExpr AS item ->
          value_node = COPY item.value;,
      END
      IF respondsTo?(value_node, "container_borrow=") THEN
        value_node.container_borrow = TRUE;
      END
      IF respondsTo?(node, "storage=") THEN
        node.storage = :borrow;
      END
      RETURN TRUE;
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__find_container_source(self: TypeAnalysisSession, MUTABLE expr: ?Locatable) RETURNS !?String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE ti = NIL;
    IF expr EXISTS AS expr_value THEN
      MUTABLE expr_value_mutable = COPY expr_value;
      IF (expr_value_mutable IS_A CopyNode OR expr_value_mutable IS_A KeepNode) THEN
        RETURN NIL;
      END
      IF (TRUE AND aST__node__container_borrow(expr_value_mutable)) THEN
        MUTABLE receiver =       IF respondsTo?(expr_value_mutable, "object") THEN
          expr_value_mutable.object()
        ELSE_IF respondsTo?(expr_value_mutable, "target") THEN
          expr_value_mutable.target()
        ELSE
          NIL
        END;
        IF receiver THEN
          RETURN typeAnalysisSession__root_variable_name(rtoc_self_view, receiver);
        END
      END
      IF expr_value_mutable IS_A GetIndex AS get_index THEN
        ti = &get_index.target.full_type_mut("container source");
        IF TRY (type__collection_value?(ti)) THEN
          RETURN typeAnalysisSession__root_variable_name(rtoc_self_view, get_index.target);
        END
      END
      IF expr_value_mutable IS_A Slice AS slice THEN
        ti = &slice.target.full_type_mut("slice container source");
        IF type__array?(ti) THEN
          RETURN typeAnalysisSession__root_variable_name(rtoc_self_view, slice.target);
        END
      END
      IF expr_value_mutable IS_A GetField AS get_field THEN
        MUTABLE get_field_mutable = COPY get_field;
        RETURN typeAnalysisSession__field_container_source(rtoc_self_view, &get_field_mutable);
      END
      MUTABLE transparent_operand: ?Locatable = aST__borrow_transparent_operand(expr_value_mutable);
      IF transparent_operand EXISTS AS transparent_operand_value THEN
        RETURN typeAnalysisSession__find_container_source(rtoc_self_view, transparent_operand_value);
      END
      RETURN NIL;
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__field_container_source(self: TypeAnalysisSession, MUTABLE expr: GetField) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF expr.target IS_A Identifier THEN
      MUTABLE target_schema = typeAnalysisSession__lookup_type_schema(rtoc_self_view, type__to_sym(expr.target.name()));
      IF ((schemas__union?(target_schema) OR schemas__enum?(target_schema))) THEN
        RETURN NIL;
      END
    END
    MUTABLE field_ti = &expr.full_type_mut("field container source");
    IF TRY (type__implicitly_copyable?(field_ti, %(type_name) USE(rtoc_self_view) -> typeAnalysisSession__lookup_type_schema(rtoc_self_view, type_name))) THEN
      RETURN NIL;
    END
    RETURN typeAnalysisSession__root_variable_name(rtoc_self_view, expr.target);
}
END
PRIVATE FN typeAnalysisSession__effects_init_mut(self: TypeAnalysisSession) RETURNS EffectState
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rtoc_writer_receiver_200: CapabilityAuditInputs = typeAnalysisSession__phase_audit_inputs(rtoc_self_view);
    rtoc_writer_receiver_200.effect_state = EffectState{ direct_effects: {}, call_site_context: {}, call_site_arg_families: {} };
    RETURN typeAnalysisSession__effect_state(rtoc_self_view);
}
END
PRIVATE FN typeAnalysisSession__effect_state(self: TypeAnalysisSession) RETURNS EffectState
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY UNWRAP (typeAnalysisSession__phase_audit_inputs(rtoc_self_view).effect_state);
}
END
PRIVATE FN typeAnalysisSession__effect_direct_effects(self: TypeAnalysisSession) RETURNS EffectSetMap
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY typeAnalysisSession__effect_state(rtoc_self_view).direct_effects;
}
END
PRIVATE FN typeAnalysisSession__effect_call_site_context(self: TypeAnalysisSession) RETURNS CallSiteContextMap
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY typeAnalysisSession__effect_state(rtoc_self_view).call_site_context;
}
END
PRIVATE FN typeAnalysisSession__effect_call_site_arg_families(self: TypeAnalysisSession) RETURNS CallSiteArgFamilyMap
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY typeAnalysisSession__effect_state(rtoc_self_view).call_site_arg_families;
}
END
PRIVATE FN typeAnalysisSession__effect_direct_effects_for(self: TypeAnalysisSession, fn_name: String) RETURNS ![Set]String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    typeAnalysisSession__effect_direct_effects(rtoc_self_view)[fn_name] = (typeAnalysisSession__effect_direct_effects(rtoc_self_view)[fn_name] OR_ELSE Set[]);
    RETURN typeAnalysisSession__effect_direct_effects(rtoc_self_view)[fn_name];
}
END
PRIVATE FN typeAnalysisSession__effect_call_site_context_for(self: TypeAnalysisSession, caller_name: String, callee_name: String) RETURNS CallContext
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    typeAnalysisSession__effect_call_site_context(rtoc_self_view)[caller_name] = (typeAnalysisSession__effect_call_site_context(rtoc_self_view)[caller_name] OR_ELSE {});
    MUTABLE caller_context = COPY UNWRAP (typeAnalysisSession__effect_call_site_context(rtoc_self_view)[caller_name]);
    caller_context[callee_name] = (caller_context[callee_name] OR_ELSE {:loop: FALSE, :cond: FALSE});
    RETURN caller_context[callee_name];
}
END
PRIVATE FN typeAnalysisSession__effect_call_site_arg_families_for(self: TypeAnalysisSession, caller_name: String, callee_name: String) RETURNS ![][][Set]String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    typeAnalysisSession__effect_call_site_arg_families(rtoc_self_view)[caller_name] = (typeAnalysisSession__effect_call_site_arg_families(rtoc_self_view)[caller_name] OR_ELSE {});
    MUTABLE caller_families = COPY UNWRAP (typeAnalysisSession__effect_call_site_arg_families(rtoc_self_view)[caller_name]);
    IF !(caller_families.contains?(callee_name)) THEN
      caller_families[callee_name] = [];
    END
    RETURN caller_families[callee_name];
}
END
PRIVATE FN typeAnalysisSession__effects_begin_function(self: TypeAnalysisSession, fn_name: String) RETURNS ![Set]String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rtoc_index_receiver_201 = typeAnalysisSession__effect_direct_effects(rtoc_self_view);
    rtoc_index_receiver_201[fn_name] = Set[];
    RETURN Set[];
}
END
PRIVATE FN typeAnalysisSession__record_effect(self: TypeAnalysisSession, effect_input: String@symbol) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE effect = COPY effect_input;
    MUTABLE fn_ctx: ?FunctionContext@multiowned = typeAnalysisSession__current_fn_ctx(rtoc_self_view);
    IF !(fn_ctx?.name) THEN
      RETURN;
    END
    effect = typeAnalysisSession__promote_suspends_for_current_context(rtoc_self_view, effect);
    typeAnalysisSession__effect_direct_effects_for(rtoc_self_view, fn_ctx.name).insert(COPY effect);
    IF (typeAnalysisSession__inside_snapshot_transaction_body?(rtoc_self_view) AND suspends_family.contains?(effect)) THEN
      typeAnalysisSession__record_snapshot_txn_violation_mut(rtoc_self_view, effect, fn_ctx.name);
    END
    NIL;
}
END
PRIVATE FN typeAnalysisSession__promote_suspends_for_current_context(self: TypeAnalysisSession, effect: String@symbol) RETURNS String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((effect == suspends)) THEN
      RETURN effect;
    END
    IF (typeAnalysisSession__current_loop_depth(rtoc_self_view) > 0) THEN
      RETURN suspends_loop;
    ELSE_IF (typeAnalysisSession__current_conditional_depth(rtoc_self_view) > 0) THEN
      RETURN suspends_conditional;
    ELSE
      RETURN suspends;
    END
}
END
PRIVATE FN typeAnalysisSession__record_call_site(self: TypeAnalysisSession, callee_name: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fn_ctx: ?FunctionContext@multiowned = typeAnalysisSession__current_fn_ctx(rtoc_self_view);
    IF !(fn_ctx?.name) THEN
      RETURN;
    END
    MUTABLE caller_name = COPY fn_ctx.name;
    MUTABLE in_loop = (typeAnalysisSession__current_loop_depth(rtoc_self_view) > 0);
    MUTABLE in_cond = (typeAnalysisSession__current_conditional_depth(rtoc_self_view) > 0);
    IF !((in_loop OR in_cond)) THEN
      RETURN;
    END
    MUTABLE existing = typeAnalysisSession__effect_call_site_context_for(rtoc_self_view, caller_name, callee_name);
    existing[:loop] = (existing[:loop] OR_ELSE in_loop);
    existing[:cond] = (existing[:cond] OR_ELSE in_cond);
    NIL;
}
END
PRIVATE FN typeAnalysisSession__record_call_arg_families(self: TypeAnalysisSession, callee_name: String, arg_family_sets: [][Set]String@symbol) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fn_ctx: ?FunctionContext@multiowned = typeAnalysisSession__current_fn_ctx(rtoc_self_view);
    IF !(fn_ctx?.name) THEN
      RETURN;
    END
    typeAnalysisSession__effect_call_site_arg_families_for(rtoc_self_view, fn_ctx.name, callee_name).append(COPY arg_family_sets);
}
END
PRIVATE FN typeAnalysisSession__validate_tight_body_mut(self: TypeAnalysisSession, stmts: AstScanInput, loop_node: TightLoopNode) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fn_nodes = TRY (typeAnalysisSession__function_node_map(rtoc_self_view));
    aST__each_locatable(stmts, FALSE, %(node: Locatable) USE(fn_nodes, loop_node, rtoc_self_view) -> {
    typeAnalysisSession__validate_tight_node_mut(rtoc_self_view, node, loop_node, fn_nodes);
    rubyToClearVoid()
    });
}
END
PRIVATE FN typeAnalysisSession__validate_tight_node_mut(self: TypeAnalysisSession, node: Locatable, loop_node: TightLoopNode, fn_nodes: {String}FunctionDef) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A FuncCall AS func_call THEN
      IF (TRUE AND func_call.extern_call) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, loop_node, TypeAnalysisCodeOrMessage{ SymbolValue: :TIGHT_CALLS_EXTERN_FN }, [], {:name: funcCall__name(func_call)});
      END
      MUTABLE fn: ?FunctionDef = COPY fn_nodes[funcCall__name(func_call)];
      IF ((fn != NIL) AND (fn.reentrance_kind == :reentrant)) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, loop_node, TypeAnalysisCodeOrMessage{ SymbolValue: :TIGHT_CALLS_REENTRANT_FN }, [], {:name: funcCall__name(func_call)});
      END
    ELSE_IF (node IS_A MethodCall) THEN
      IF (IF node IS_A FuncCall AS func_call THEN func_call.extern_call ELSE FALSE END) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, loop_node, TypeAnalysisCodeOrMessage{ SymbolValue: :TIGHT_CALLS_EXTERN_FN }, [], {:name: node.name()});
      END
      MUTABLE fn: ?FunctionDef = COPY fn_nodes[node.name()];
      IF ((fn != NIL) AND (fn.reentrance_kind == :reentrant)) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, loop_node, TypeAnalysisCodeOrMessage{ SymbolValue: :TIGHT_CALLS_REENTRANT_FN }, [], {:name: node.name()});
      END
    END
}
END
PRIVATE FN typeAnalysisSession__with_block_suspends?(self: TypeAnalysisSession, node: WithBlock) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (TRY (withCapabilityPlan__locks((TRY (capabilityPlan__require_for(node)))))) |> ANY _;
}
END
PRIVATE FN typeAnalysisSession__func_call_suspends?(self: TypeAnalysisSession, node: CallLikeNode) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fn_nodes = TRY (typeAnalysisSession__function_node_map(rtoc_self_view));
    IF (IF (MATCH node START CallLikeNode.FuncCall AS item -> item.matched_stdlib_def, CallLikeNode.MethodCall AS item -> item.matched_stdlib_def END) != NIL THEN
      { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_202 = ((MATCH node START CallLikeNode.FuncCall AS item -> item.matched_stdlib_def, CallLikeNode.MethodCall AS item -> item.matched_stdlib_def END));
    TRY (functionSignature__intrinsic_suspends?(&rtoc_mutable_receiver_202)) }
    ELSE
      NIL
    END) THEN
      RETURN TRUE;
    END
    IF (IF node IS_A FuncCall AS func_call THEN func_call.fn_var_call ELSE FALSE END) THEN
      RETURN FALSE;
    END
    MUTABLE callee: ?FunctionDef@multiowned = COPY fn_nodes[node.name()];
    IF callee EXISTS AS callee_value THEN
      MUTABLE effs = callee_value.effects;
      RETURN !(!(((effs AND (effs |> ANY suspends_family.contains?(_))))));
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__bridge_reentrance_mut(self: TypeAnalysisSession, program_node: Program) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < program_node.statements.length() DO
      IF !(program_node.statements[rtoc_idx] IS_A FunctionDef) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE fn_node = program_node.statements[rtoc_idx];
      MUTABLE kind: ?String@symbol = typeAnalysisSession__canonical_reentrance_kind(rtoc_self_view, fn_node);
      fn_node.reentrance_kind = kind;
      IF (kind == :reentrant_tail_call) THEN
          fn_node.tail_call = TRUE;
      ELSE_IF (kind == :reentrant_not_logical) THEN
    
      ELSE_IF (kind == :reentrant_max_depth) THEN
          MUTABLE budget = symbol("RECURSION_YIELD_BUDGET");
          IF (((fn_node.max_depth_n() OR 0)) <= budget) THEN
            fn_node.tight_reentrance = TRUE;
          ELSE
            fn_node.tight_reentrance = FALSE;
          END
      END
      typeAnalysisSession__validate_requires_clauses_mut(rtoc_self_view, fn_node);
      typeAnalysisSession__validate_not_logical_return_mut(rtoc_self_view, fn_node);
      typeAnalysisSession__offer_unconstrained_fn_param_fix_mut(rtoc_self_view, fn_node);
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PRIVATE FN typeAnalysisSession__offer_plain_reentrant_variant_fix_mut(self: TypeAnalysisSession, fn_node: FunctionDef, body_facts: TypeAnalysisBodyFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((fn_node.reentrance_kind == :reentrant)) THEN
      RETURN;
    END
    IF !(fn_node.effects_span) THEN
      RETURN;
    END
    IF !((fn_node.effects_decl == :reentrant)) THEN
      RETURN;
    END
    MUTABLE suggestion_reason: []String = ( { MUTABLE rtoc_empty_list_203: []String = List[]; rtoc_empty_list_203 } );
    IF typeAnalysisSession__thunk_all_self_calls_in_tail_position?(rtoc_self_view, fn_node, body_facts) THEN
      suggestion_reason = ["EFFECTS REENTRANT:TAIL_CALL", "all self-calls are in tail position; TCO turns this into a self-`jmp` loop with depth=1"];
    ELSE_IF recursiveSplitter__split(fn_node.body, fn_node.name) THEN
      suggestion_reason = ["EFFECTS REENTRANT:THUNK", "the body matches the simple-recurrence shape; heap CPS keeps the fiber stack at depth=1"];
    END
    IF (suggestion_reason.length() == 0) THEN
      RETURN;
    END
    MUTABLE suggestion = COPY UNWRAP (suggestion_reason.first());
    MUTABLE edits: []Edit@multiowned = typeAnalysisSession__effects_clause_edits(rtoc_self_view, fn_node, suggestion);
    IF (edits.length() == 0) THEN
      RETURN;
    END
    MUTABLE span = fn_node.effects_span;
    MUTABLE reason = COPY UNWRAP (suggestion_reason[1]);
    typeAnalysisSession__fixable_mut(rtoc_self_view, span.start_token(), :reentrance, [TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :REPLACE_REENTRANT_WITH_VARIANT, {:suggestion: DiagnosticKwValue{ StringValue: COPY suggestion }, :reason: DiagnosticKwValue{ StringValue: COPY reason }}), edits, :auto))], NIL, :PLAIN_REENTRANT_VARIANT_SUGGESTION, :info, FALSE, {:fn: fn_node.name, :reason: reason, :suggestion: suggestion});
}
END
PRIVATE FN typeAnalysisSession__validate_not_logical_return_mut(self: TypeAnalysisSession, fn_node: FunctionDef) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(([:reentrant_not_logical, :reentrant_max_depth]).contains?(fn_node.reentrance_kind)) THEN
      RETURN;
    END
    MUTABLE rt = functionDef__declared_return_type(fn_node);
    IF (IF rt != NIL THEN
      rt.error_union?()
    ELSE
      NIL
    END) THEN
      RETURN;
    END
    MUTABLE rt_str: String = "";
    IF rt THEN
      rt_str = COPY CAST(rt AS String);
    ELSE
      rt_str = "Void";
    END
    MUTABLE suggested: String = "";
    IF (rt == NIL) THEN
      suggested = "!Void";
    ELSE
      suggested = "!${compilerRegexReplaceFirst(rt_str, compilerRegexCompile("\\A!"), "")}";
    END
    MUTABLE err_name: String = "";
    IF (fn_node.reentrance_kind == :reentrant_not_logical) THEN
      err_name = "UnexpectedRecursion";
    ELSE
      err_name = "MaxDepthExceeded";
    END
    MUTABLE variant_text: String = "";
    IF (fn_node.reentrance_kind == :reentrant_not_logical) THEN
      variant_text = "EFFECTS REENTRANT:NOT_LOGICAL";
    ELSE
      variant_text = "EFFECTS REENTRANT:MAX_DEPTH(${fn_node.max_depth_n})";
    END
    typeAnalysisSession__error_mut(rtoc_self_view, fn_node, TypeAnalysisCodeOrMessage{ SymbolValue: :REENTRANT_NEEDS_FALLIBLE_RETURN }, [], {:variant_text: variant_text, :fn: fn_node.name, :err: err_name, :rt: rt_str, :suggested: suggested});
}
END
PRIVATE FN typeAnalysisSession__route_thunk_to_tail_call_compat_mut(self: TypeAnalysisSession, MUTABLE fn_node: FunctionDef, body_facts: TypeAnalysisBodyFacts) RETURNS ?Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((fn_node.reentrance_kind == :reentrant_thunk)) THEN
      RETURN;
    END
    IF !(typeAnalysisSession__thunk_all_self_calls_in_tail_position?(rtoc_self_view, fn_node, body_facts)) THEN
      RETURN;
    END
    fn_node.tail_call = TRUE;
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__validate_tail_call_mut(self: TypeAnalysisSession, fn_node: FunctionDef, body_scan: BodyScanSummary) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fn_name = fn_node.name;
    MUTABLE all_self_calls = body_scan.call_site_facts |> SELECT:? (  IF (_.callee_name == fn_name) THEN
      KEEP _.node
    ELSE
      NIL
    END) |> WHERE _ != NIL;
    MUTABLE blessed = body_scan.return_nodes |> SELECT:? {
    MUTABLE value = _.value;
    (  IF (value IS_A FuncCall AND (value.name() == fn_name)) THEN
        value
      ELSE
        NIL
      END)
    } |> WHERE _ != NIL;
    MUTABLE blessed_ids = (blessed |> SELECT aST__node_identity(_)) |> DISTINCT _;
    IF (blessed.length() == 0) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, fn_node, TypeAnalysisCodeOrMessage{ SymbolValue: :TAIL_CALL_NEEDS_RECURSIVE }, [], {:fn: fn_name});
    END
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < all_self_calls.length() DO
      IF blessed_ids.contains?(aST__node_identity(all_self_calls[rtoc_idx])) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      typeAnalysisSession__error_mut(rtoc_self_view, all_self_calls[rtoc_idx], TypeAnalysisCodeOrMessage{ SymbolValue: :TAIL_CALL_NOT_TAIL_POSITION }, [], {:fn: fn_name});
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PRIVATE FN typeAnalysisSession__canonical_reentrance_kind(self: TypeAnalysisSession, fn_node: FunctionDef) RETURNS ?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN fn_node.effects_decl;
}
END
PRIVATE FN typeAnalysisSession__offer_unconstrained_fn_param_fix_mut(self: TypeAnalysisSession, fn_node: FunctionDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF ([:reentrant, :reentrant_thunk, :reentrant_tail_call, :reentrant_not_logical, :reentrant_max_depth]).contains?(fn_node.reentrance_kind) THEN
      RETURN;
    END
    IF !(fn_node.arrow_token) THEN
      RETURN;
    END
    MUTABLE existing = (fn_node.requires_clauses OR {});
    MUTABLE candidates = fn_node.params |> SELECT:? { MUTABLE rtoc_value_block_marker = 0; MUTABLE name = COPY _.name; (IF existing.key?(name) THEN NIL ELSE { MUTABLE rtoc_value_block_marker = 0; MUTABLE type = COPY _.type; (IF !((TRUE AND type__fn_type?(type))) THEN NIL ELSE { MUTABLE rtoc_value_block_marker = 0; MUTABLE raw_branch_value: ?TypeShapeRaw = NIL;
    IF TRUE THEN
      raw_branch_value = type__raw(type);
    ELSE
      raw_branch_value = NIL;
    END
    MUTABLE raw: ?TypeShapeRaw = raw_branch_value; (IF (((raw != NIL) AND (raw IS_A FunctionSignature)) AND (raw.reentrant() == TRUE)) THEN NIL ELSE name END) } END) } END) } |> WHERE _ != NIL;
    IF (candidates.length() == 0) THEN
      RETURN;
    END
    MUTABLE arrow = COPY fn_node.arrow_token;
    MUTABLE requires_insert = (candidates |> SELECT "REQUIRES ${_}: NON_REENTRANT ").join("");
    MUTABLE requires_desc = (candidates |> SELECT "REQUIRES ${_}: NON_REENTRANT").join(" + ");
    MUTABLE constrain_fix = TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :ADD_NON_REENTRANT_REQUIRES, {:requires: requires_desc}), [edit__new(span__new(NIL, arrow.line, arrow.column, 2), "${requires_insert}->")], :auto));
    MUTABLE propagate_fix = TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :DECLARE_FN_REENTRANT, {:fn: DiagnosticKwValue{ AnyMultiowned: COPY fn_node.name }}), [edit__new(span__new(NIL, arrow.line, arrow.column, 2), "EFFECTS REENTRANT ->")], :interactive));
    MUTABLE msg_subject: String = "";
    IF (candidates.length() == 1) THEN
      msg_subject = "an unconstrained FN-typed parameter";
    ELSE
      msg_subject = "unconstrained FN-typed parameters";
    END
    typeAnalysisSession__fixable_mut(rtoc_self_view, arrow, :lint, [constrain_fix, propagate_fix], NIL, :UNCONSTRAINED_FN_PARAM_REENTRANCE, :warning, FALSE, {:fn: fn_node.name, :subject: msg_subject, :candidates: candidates.join(", ")});
}
END
PRIVATE FN typeAnalysisSession__validate_requires_clauses_mut(self: TypeAnalysisSession, fn_node: FunctionDef) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF ((fn_node.requires_clauses == NIL) OR fn_node.requires_clauses.empty?()) THEN
      RETURN;
    END
    MUTABLE param_names = ((fn_node.params |> SELECT _.name) |> WHERE _ != NIL) |> DISTINCT _;
    FOR rtoc_each_key IN fn_node.requires_clauses.keys() DO
    MUTABLE ignored_kind = COPY UNWRAP (fn_node.requires_clauses[rtoc_each_key]);
    IF param_names.contains?(rtoc_each_key) THEN
      CONTINUE;
    END
    typeAnalysisSession__error_mut(rtoc_self_view, fn_node, TypeAnalysisCodeOrMessage{ SymbolValue: :REQUIRES_NON_REENTRANT_NOT_PARAM }, [], {:fn: fn_node.name, :name: rtoc_each_key});
    END
}
END
PRIVATE FN typeAnalysisSession__effects_clause_edits(self: TypeAnalysisSession, fn_node: FunctionDef, replacement: String) RETURNS ![]Edit
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE span = fn_node.effects_span;
    IF !(span) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_204: []Edit = List[]; rtoc_empty_list_204 } ) AS []Edit);
    END
    MUTABLE s = span.start_token();
    MUTABLE e = span.end_token();
    IF (s.line() != e.line()) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_205: []Edit = List[]; rtoc_empty_list_205 } ) AS []Edit);
    END
    MUTABLE end_col = (e.column() + (CAST(e.value() AS String)).codepointCount());
    RETURN CAST([edit__new(span__new(NIL, s.line(), s.column(), (end_col - s.column())), replacement)] AS []Edit);
}
END
PRIVATE FN typeAnalysisSession__thunk_all_self_calls_in_tail_position?(self: TypeAnalysisSession, fn_node: FunctionDef, body_facts: TypeAnalysisBodyFacts) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE all = (MATCH body_facts START TypeAnalysisBodyFacts.BodyScanSummary AS item -> item.call_site_facts, TypeAnalysisBodyFacts.FunctionBodySummary AS item -> item.call_site_facts END) |> SELECT:? (  IF (_.callee_name == fn_node.name) THEN
      KEEP _.node
    ELSE
      NIL
    END) |> WHERE _ != NIL;
    IF (all.length() == 0) THEN
      RETURN FALSE;
    END
    MUTABLE blessed = (MATCH body_facts START TypeAnalysisBodyFacts.BodyScanSummary AS item -> item.return_nodes, TypeAnalysisBodyFacts.FunctionBodySummary AS item -> item.return_nodes END) |> SELECT:? (  IF (_.value IS_A FuncCall AND (_.value.name() == fn_node.name)) THEN
      _.value
    ELSE
      NIL
    END) |> WHERE _ != NIL;
    IF (blessed.length() == 0) THEN
      RETURN FALSE;
    END
    MUTABLE blessed_ids = (blessed |> SELECT aST__node_identity(_)) |> DISTINCT _;
    RETURN all |> ALL blessed_ids.contains?(aST__node_identity(_));
}
END
PRIVATE FN typeAnalysisSession__cap_var_sync(self: TypeAnalysisSession, MUTABLE var_node: Locatable) RETURNS ?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE sym_sync = (IF var_aST__node__symbol(node) != NIL THEN
      (var_aST__node__symbol(node)).sync()
    ELSE
      NIL
    END);
    IF sym_sync THEN
      RETURN sym_sync;
    END
    RETURN (&var_node.full_type_mut("WITH capability sync target")).sync();
}
END
PRIVATE FN typeAnalysisSession__cap_var_storage(self: TypeAnalysisSession, MUTABLE var_node: Locatable) RETURNS ?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE sym = var_aST__node__symbol(node);
    IF sym THEN
      RETURN sym.storage();
    END
    RETURN type__ownership_storage((&var_node.full_type_mut("WITH capability storage target")));
}
END
PRIVATE FN typeAnalysisSession__cap_var_layout(self: TypeAnalysisSession, MUTABLE var_node: Locatable) RETURNS ?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE sym_layout = (IF var_aST__node__symbol(node) != NIL THEN
      (var_aST__node__symbol(node)).layout()
    ELSE
      NIL
    END);
    IF sym_layout THEN
      RETURN sym_layout;
    END
    RETURN (&var_node.full_type_mut("WITH capability layout target")).layout();
}
END
PRIVATE FN typeAnalysisSession__cap_var_label(self: TypeAnalysisSession, var_node: Locatable) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF var_node IS_A Identifier AS identifier THEN
      RETURN COPY identifier__name(identifier);
    ELSE_IF var_node IS_A GetField AS get_field THEN
      RETURN COPY CAST(get_field.field AS String);
    ELSE_IF var_node IS_A GetIndex AS get_index THEN
      RETURN capabilityPlan__var_name_for(Locatable{ GetIndex: COPY get_index });
    ELSE
      RETURN "__unknown";
    END
}
END
PRIVATE FN typeAnalysisSession__validate_capability_transition_mut(MUTABLE self: TypeAnalysisSession, node: WithBlock, fact: CapabilityTransition) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE var_node = COPY fact.var_node;
    MUTABLE var_type = COPY fact.resolved_type;
    IF !(typeAnalysisSession__valid_capability_target?(rtoc_self_view, fact.capability, var_node)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, var_node, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_CAP_BAD_TARGET }, [], {:capability: fact.capability, :got: var_node.class()});
    END
    IF (fact.capability == symbol("EXCLUSIVE")) THEN
      IF (capabilityTransition__exclusive_validation_action(fact) == :valid) OR (capabilityTransition__exclusive_validation_action(fact) == :declared_contract) THEN
    
      ELSE_IF (capabilityTransition__exclusive_validation_action(fact) == :defer) THEN
        typeAnalysisSession__record_deferred_with_validation_mut(rtoc_self_view, node, fact);
      ELSE
        MUTABLE storage = COPY fact.storage;
        MUTABLE name = COPY fact.target_label;
        typeAnalysisSession__emit_with_cap_mismatch_mut(rtoc_self_view, node, name, :WITH_EXCLUSIVE_NEEDS_LOCK, [CapabilityFixCandidate{ sigil: "@locked", description_code: :WITH_ADD_LOCKED, description_params: {} }, CapabilityFixCandidate{ sigil: "@writeLocked", description_code: :WITH_ADD_WRITE_LOCKED, description_params: CAST({:reader: DiagnosticKwValue{ StringValue: COPY "can coexist via WITH READ" }} AS {String@symbol}DiagnosticKwValue) }], :interactive, {:got: DiagnosticKwValue{ SymbolValue: COPY storage }});
      END
    ELSE_IF (fact.capability == :write_locked_read) THEN
      IF !(capabilityTransition__write_locked_sync?(fact)) THEN
        IF capabilityTransition__deferred_sync_param?(fact) THEN
          typeAnalysisSession__record_deferred_with_validation_mut(rtoc_self_view, node, fact);
        ELSE
          MUTABLE name = COPY fact.target_label;
          typeAnalysisSession__emit_with_read_needs_write_lock_mut(rtoc_self_view, node, name, var_node);
        END
      END
    ELSE_IF (fact.capability == symbol("RESTRICT")) THEN
      IF ((IF var_node IS_A Identifier AS identifier THEN (identifier.symbol != NIL) ELSE FALSE END) AND !(var_aST__node__symbol(node).mutable())) THEN
        typeAnalysisSession__emit_with_restrict_immutable_error_mut(rtoc_self_view, node, castLocatableToIdentifier(var_node));
      END
    ELSE_IF (fact.capability == symbol("BORROWED")) THEN
  
    ELSE_IF (fact.capability == symbol("VIEW")) THEN
      MUTABLE t_branch_value: ?Type = NIL;
      IF TRUE THEN
        t_branch_value = var_type;
      ELSE
        t_branch_value = TRY (type__new(castTypeToTypeConstructionInput(var_type)));
      END
      MUTABLE t: Type = t_branch_value?;
      IF TRY (type__c_array_view?(t)) THEN
        typeAnalysisSession__emit_foreign_with_view_needs_unsafe_mut(rtoc_self_view, node, fact);
        RETURN;
      END
      IF !((type__future?(t) AND type__observable?(t))) THEN
        IF var_node IS_A Identifier AS identifier THEN
          typeAnalysisSession__emit_view_not_observable_finding_mut(rtoc_self_view, node, fact, t);
        ELSE
          MUTABLE name = COPY fact.target_label;
          typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_VIEW_NEEDS_OBSERVABLE }, [], {:name: name, :got: type__resolved(t)});
        END
      END
    ELSE_IF (fact.capability == :MATERIALIZED_VIEW) THEN
      MUTABLE t_branch_value: ?Type = NIL;
      IF TRUE THEN
        t_branch_value = var_type;
      ELSE
        t_branch_value = TRY (type__new(castTypeToTypeConstructionInput(var_type)));
      END
      MUTABLE t: Type = t_branch_value?;
      IF !(type__future?(t)) THEN
        MUTABLE name = COPY fact.target_label;
        typeAnalysisSession__emit_with_materialized_needs_tense_mut(rtoc_self_view, node, name, TypeTypeInput{ StringValue: CAST(type__resolved(t) AS String) });
      END
    ELSE_IF (fact.capability == :UNSAFE_VIEW) THEN
      MUTABLE t_branch_value: ?Type = NIL;
      IF TRUE THEN
        t_branch_value = var_type;
      ELSE
        t_branch_value = TRY (type__new(castTypeToTypeConstructionInput(var_type)));
      END
      MUTABLE t: Type = t_branch_value?;
      IF !(TRY (type__c_array_view?(t))) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_UNSAFE_VIEW_NEEDS_FOREIGN_POINTER }, [], {:got: TRY (type__surface_name(castTypeToTypeTypeInput(t)))});
      END
      MUTABLE length: ?Locatable = COPY fact.view_length;
      IF length EXISTS AS length_value THEN
        MUTABLE length_value_mutable = COPY length_value;
        TRY (typeAnalysisSession__visit(&rtoc_self_view, length_value_mutable));
        MUTABLE length_type = &length_value_mutable.full_type_mut("foreign view length");
        IF !(type__integer?(length_type)) THEN
          typeAnalysisSession__error_mut(rtoc_self_view, length_value_mutable, TypeAnalysisCodeOrMessage{ SymbolValue: :RANK_INDEX_INTEGER }, [], {:got: length_type.resolved()});
        END
      ELSE
        panic("Internal: WITH UNSAFE VIEW missing LENGTH expression");
      END
    ELSE_IF (fact.capability == symbol("SNAPSHOT")) THEN
      MUTABLE snapshot_sync: ?String@symbol = COPY fact.sync;
      MUTABLE snapshot_layout: ?String@symbol = COPY fact.layout;
      MUTABLE atomic_ptr_ok = ((snapshot_sync == :atomic) AND (snapshot_layout == :indirect));
      IF !(((snapshot_sync == :versioned) OR atomic_ptr_ok)) THEN
        MUTABLE name = COPY fact.target_label;
        MUTABLE storage = COPY fact.storage;
        MUTABLE actual: String = "";
        IF ((snapshot_sync != NIL) AND (snapshot_layout == :indirect)) THEN
          actual = "@boxed:${snapshot_sync}";
        ELSE_IF snapshot_sync EXISTS AS snapshot_sync_value THEN
          actual = "@${snapshot_sync_value}";
        ELSE
          IF storage THEN
            actual = "@${storage}";
          ELSE
            actual = "plain";
          END
        END
        typeAnalysisSession__emit_with_cap_mismatch_mut(rtoc_self_view, node, name, :WITH_SNAPSHOT_NEEDS_VERSIONED_OR_ATOMIC, [CapabilityFixCandidate{ sigil: "@versioned", description_code: :WITH_ADD_VERSIONED, description_params: {} }, CapabilityFixCandidate{ sigil: "@boxed:atomic", description_code: :WITH_ADD_INDIRECT_ATOMIC, description_params: {} }], {:confidence: :interactive, :name: name, :actual: actual});
      END
    ELSE_IF (fact.capability == :multiowned) THEN
      IF !((fact.storage == :multiowned)) THEN
        MUTABLE name = COPY fact.target_label;
        typeAnalysisSession__emit_with_cap_mismatch_mut(rtoc_self_view, node, name, :WITH_NEEDS_MULTIOWNED, [CapabilityFixCandidate{ sigil: "@multiowned", description_code: :WITH_ADD_MULTIOWNED, description_params: CAST({:suffix: DiagnosticKwValue{ StringValue: COPY " via WITH" }} AS {String@symbol}DiagnosticKwValue) }], {:confidence: :auto, :name: name});
      END
    ELSE_IF (fact.capability == :shared) THEN
      IF !((fact.storage == :shared)) THEN
        MUTABLE name = COPY fact.target_label;
        typeAnalysisSession__emit_with_cap_mismatch_mut(rtoc_self_view, node, name, :WITH_NEEDS_SHARED, [CapabilityFixCandidate{ sigil: "@shared", description_code: :WITH_ADD_SHARED, description_params: CAST({:suffix: DiagnosticKwValue{ StringValue: COPY "to clone across fibers" }} AS {String@symbol}DiagnosticKwValue) }], {:confidence: :auto, :name: name});
      END
    ELSE_IF (fact.capability == :ATOMIC) THEN
      MUTABLE syn: ?String@symbol = COPY fact.sync;
      IF !((syn == :atomic)) THEN
        IF capabilityTransition__deferred_sync_param?(fact) THEN
          typeAnalysisSession__record_deferred_with_validation_mut(rtoc_self_view, node, fact);
        ELSE
          MUTABLE name = COPY fact.target_label;
          MUTABLE storage = COPY fact.storage;
          MUTABLE actual: String = "";
          IF syn EXISTS AS syn_value THEN
            actual = "@${syn_value}";
          ELSE
            actual = (IF storage THEN
              "@${storage}"
            ELSE
              "plain"
            END);
          END
          typeAnalysisSession__emit_with_cap_mismatch_mut(rtoc_self_view, node, name, :WITH_ATOMIC_NEEDS_SHARED_ATOMIC, [CapabilityFixCandidate{ sigil: "@shared:atomic", description_code: :WITH_ADD_SHARED_ATOMIC, description_params: {} }], {:confidence: :auto, :name: name, :actual: actual});
        END
      END
    ELSE
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :UNKNOWN_WITH_CAP_TYPE }, [], {:type: fact.capability});
    END
}
END
PRIVATE FN typeAnalysisSession__valid_capability_target?(self: TypeAnalysisSession, capability_type: String@symbol, var_node: Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (var_node IS_A Identifier OR var_node IS_A GetField) THEN
      RETURN TRUE;
    END
    RETURN ((capability_type == symbol("BORROWED")) AND var_node IS_A GetIndex);
}
END
PRIVATE FN typeAnalysisSession__emit_view_not_observable_finding_mut(self: TypeAnalysisSession, node: WithBlock, fact: CapabilityTransition, var_type: Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE name = COPY fact.target_label;
    MUTABLE msg = "WITH VIEW requires an `@observable` source, but '${name}' has type ${type__resolved(var_type)}. Use `WITH MATERIALIZED VIEW` for non-observable aggregates, or annotate the binding as `~T@observable`.";
    MUTABLE view_tok: ?Token = COPY aSTCapability__view_token(fact.source);
    MUTABLE fixes = List[];
    IF view_tok EXISTS AS view_tok_value THEN
      &fixes.append(TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :WITH_VIEW_TO_MATERIALIZED), [edit__new(span__new(NIL, view_tok_value.line, view_tok_value.column, "VIEW".codepointCount()), "MATERIALIZED VIEW")], :auto)));
    END
    IF (fixes.length() == 0) THEN
      RETURN typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_VIEW_NEEDS_OBSERVABLE }, [], {:name: name, :got: type__resolved(var_type)});
    END
    typeAnalysisSession__fixable_mut(rtoc_self_view, node, :capability, fixes, NIL, :WITH_VIEW_NEEDS_OBSERVABLE, :error, FALSE, {:name: name, :got: type__resolved(var_type)});
}
END
PRIVATE FN typeAnalysisSession__predicate_identifier_allowed_mut(self: TypeAnalysisSession, node: Identifier) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE ctx: ?PredicateContext = typeAnalysisSession__current_predicate_context(rtoc_self_view);
    IF ctx EXISTS AS ctx_value THEN
      IF (["TRUE", "FALSE"]).contains?(node.name) THEN
        RETURN;
      END
      IF (ctx_value.kind == :guard) THEN
        MUTABLE own_alias: ?String = COPY ctx_value.guard_alias;
        IF own_alias EXISTS AS own_alias_value THEN
          IF (node.name == own_alias_value) THEN
            RETURN;
          END
          MUTABLE sibling_aliases = COPY ctx_value.sibling_aliases;
          IF sibling_aliases.contains?(node.name) THEN
            typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_GUARD_REFS_SIBLING_ALIAS }, [], {:own_alias: own_alias_value, :name: node.name, :remediation: "Use an `IF` guard clause inside the WITH body for cross-alias checks."});
          ELSE
            typeAnalysisSession__emit_typo_suggestion_mut(rtoc_self_view, TypoToken{ TokenMultiowned: COPY node.token }, node.name, [own_alias_value], "WITH GUARD can only reference the guarded alias '${own_alias_value}'. Found '${node.name}'.", "the guarded alias", :capability, TRUE);
          END
        ELSE
          RETURN;
        END
      ELSE_IF (ctx_value.kind == :pre) THEN
        MUTABLE params = COPY ctx_value.param_names;
        IF params.contains?(node.name) THEN
          RETURN;
        END
        typeAnalysisSession__emit_typo_suggestion_mut(rtoc_self_view, TypoToken{ TokenMultiowned: COPY node.token }, node.name, params, "PRE clauses may only reference function parameters. Found '${node.name}', which is not a parameter of '${ctx_value.fn_name}'.", "a parameter of '${ctx_value.fn_name}'", :type, TRUE);
      ELSE_IF (ctx_value.kind == :post) THEN
        MUTABLE allowed = COPY ctx_value.allowed_names;
        MUTABLE rejected = COPY ctx_value.rejected_param_names;
        IF !(allowed.contains?(node.name)) THEN
          RETURN typeAnalysisSession__emit_typo_suggestion_mut(rtoc_self_view, TypoToken{ TokenMultiowned: COPY node.token }, node.name, allowed, "DEBUG_POST clauses may only reference function parameters or 'result'. Found '${node.name}', which is not in scope for '${ctx_value.fn_name}'.", "a parameter of '${ctx_value.fn_name}' or 'result'", :type, TRUE);
        END
        IF rejected.contains?(node.name) THEN
          typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :DEBUG_POST_NEEDS_UNSYNC_PARAM }, [], {:name: node.name});
        END
      END
      NIL;
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__record_predicate_call_site_mut(self: TypeAnalysisSession, node: Node) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE ctx: ?PredicateContext = typeAnalysisSession__current_predicate_context(rtoc_self_view);
    IF ctx EXISTS AS ctx_value THEN
      (TRY (typeAnalysisSession__predicate_call_sites(rtoc_self_view))).append(PredicateCallSite{ kind: COPY ctx_value.kind, with_node: KEEP ctx_value.with_node, fn_node: KEEP ctx_value.fn_node, pred_expr: COPY ctx_value.pred_expr, call: node, callee: COPY node.name() });
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__validate_and_visit_with_guards_mut(MUTABLE self: TypeAnalysisSession, node: WithBlock) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE capability_plan = TRY (capabilityPlan__require_for(node));
    MUTABLE caps = COPY capability_plan.all;
    MUTABLE guarded = TRY (withCapabilityPlan__guarded(capability_plan));
    IF (guarded.length() == 0) THEN
      RETURN;
    END
    IF node.arms EXISTS AS arms_value THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_GUARD_NOT_WITH_MATCH });
    END
    IF (node.snapshot_mode == :transaction) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_GUARD_NOT_ON_SNAPSHOT });
    END
    MUTABLE missing_alias = caps |> WHERE !(_.alias_explicit());
    IF !(missing_alias.empty?()) THEN
      typeAnalysisSession__emit_with_guard_all_bindings_need_as_mut(rtoc_self_view, node, missing_alias);
    END
    MUTABLE aliases = caps |> SELECT _.alias_name();
    FOR _ IN guarded DO
    MUTABLE own = COPY _.alias_name;
    MUTABLE siblings = (aliases - [own]);
    MUTABLE guard_expr = COPY UNWRAP (_.guard_expr);
    typeAnalysisSession__with_predicate_context(&rtoc_self_view, PredicateContext{ kind: :guard, with_node: node, fn_node: NIL, pred_expr: COPY guard_expr, guard_alias: COPY own, sibling_aliases: COPY siblings, param_names: ( { MUTABLE rtoc_empty_list_206: []String = List[]; rtoc_empty_list_206 } ), allowed_names: ( { MUTABLE rtoc_empty_list_207: []String = List[]; rtoc_empty_list_207 } ), rejected_param_names: COPY Set[], fn_name: NIL }, %() USE(MUTABLE guard_expr, MUTABLE rtoc_self_view) -> {
      TRY (typeAnalysisSession__visit(&rtoc_self_view, guard_expr));
      MUTABLE guard_type = &guard_expr.full_type_mut("WITH guard expression");
      IF !((guard_type AND (guard_type.resolved() == :Bool))) THEN
          typeAnalysisSession__error_mut(rtoc_self_view, guard_expr, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_GUARD_EXPR_MUST_BE_BOOL }, [], {:got: (guard_type OR "Unknown")});
      END
      NIL
    });
    END
}
END
PRIVATE FN typeAnalysisSession__visit_pre_clauses_mut(MUTABLE self: TypeAnalysisSession, fn_node: FunctionDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE pre_clauses = (fn_node.pre_clauses OR List[]);
    IF pre_clauses.empty?() THEN
      RETURN;
    END
    IF !(fn_node.explicit_return_type) THEN
      MUTABLE arrow_tok = COPY fn_node.arrow_token;
      IF arrow_tok THEN
        MUTABLE fixes = [TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :INSERT_RETURNS_FALLIBLE_VOID), [edit__new(span__new(NIL, arrow_tok.line, arrow_tok.column, 0), "RETURNS !Void ")], :auto))];
        typeAnalysisSession__fixable_mut(rtoc_self_view, fn_node, :type, fixes, NIL, :PRE_CLAUSES_NEED_EXPLICIT_FALLIBLE_RETURN, :error, FALSE, {:fn: fn_node.name});
      ELSE
        typeAnalysisSession__error_mut(rtoc_self_view, fn_node, TypeAnalysisCodeOrMessage{ SymbolValue: :PRE_CLAUSES_NEED_EXPLICIT_FALLIBLE_RETURN }, [], {:fn: fn_node.name});
      END
    END
    MUTABLE param_names = fn_node.params |> SELECT _.name;
    FOR _ IN pre_clauses DO
    MUTABLE expr = _[:expr];
    typeAnalysisSession__with_predicate_context(&rtoc_self_view, PredicateContext{ kind: :pre, with_node: NIL, fn_node: fn_node, pred_expr: COPY CAST(expr AS Locatable), guard_alias: NIL, sibling_aliases: ( { MUTABLE rtoc_empty_list_208: []String = List[]; rtoc_empty_list_208 } ), param_names: COPY param_names, allowed_names: ( { MUTABLE rtoc_empty_list_209: []String = List[]; rtoc_empty_list_209 } ), rejected_param_names: COPY Set[], fn_name: COPY fn_node.name }, %() USE(MUTABLE expr, MUTABLE rtoc_self_view) -> {
      TRY (typeAnalysisSession__visit(&rtoc_self_view, expr));
      MUTABLE pred_type = &expr.full_type_mut({:context: "PRE expression"});
      IF !((pred_type AND (pred_type.resolved() == :Bool))) THEN
          typeAnalysisSession__error_mut(rtoc_self_view, expr, TypeAnalysisCodeOrMessage{ SymbolValue: :PRE_EXPR_MUST_BE_BOOL }, [], {:got: (pred_type OR "Unknown")});
      END
      NIL
    });
    END
}
END
PRIVATE FN typeAnalysisSession__visit_post_clauses_mut(MUTABLE self: TypeAnalysisSession, fn_node: FunctionDef) RETURNS !?Scope@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE post_clauses: []Any = List[];
    IF TRUE THEN
      post_clauses = ((fn_node.post_clauses OR List[]));
    ELSE
      post_clauses = ( { MUTABLE rtoc_empty_list_210: []Any = List[]; rtoc_empty_list_210 } );
    END
    IF (post_clauses.length() == 0) THEN
      RETURN;
    END
    MUTABLE has_catch = typeAnalysisSession__function_has_catch_clauses?(rtoc_self_view, fn_node);
    MUTABLE has_default_catch = typeAnalysisSession__function_has_default_catch?(rtoc_self_view, fn_node);
    IF (has_catch OR has_default_catch) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, fn_node, TypeAnalysisCodeOrMessage{ SymbolValue: :DEBUG_POST_NOT_WITH_CATCH });
    END
    MUTABLE param_names = fn_node.params |> SELECT _.name;
    MUTABLE rejected = (fn_node.params |> SELECT:? { MUTABLE rtoc_value_block_marker = 0; MUTABLE sym: ?SymbolEntry@multiowned = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_211 = typeAnalysisSession__current_scope(rtoc_self_view);
    scope__resolve_entry(rtoc_local_receiver_211, _.name) }; (IF !(((sym != NIL) AND ([:locked, :write_locked, :versioned, :atomic]).contains?(symbolEntry__sync(sym)))) THEN NIL ELSE _.name END) } |> WHERE _ != NIL) |> DISTINCT _;
    MUTABLE rt: ?Type = COPY fn_node.return_type;
    MUTABLE payload_branch_value: ?Type = NIL;
    IF ((rt != NIL) AND type__error_union?(rt)) THEN
      payload_branch_value = TRY (type__payload_type(rt));
    ELSE
      payload_branch_value = rt;
    END
    MUTABLE payload: ?Type = payload_branch_value;
    typeAnalysisSession__with_new_scope(rtoc_self_view, typeAnalysisSession__current_scope(rtoc_self_view), %() USE(fn_node, param_names, payload, post_clauses, rejected, MUTABLE rtoc_self_view) -> {
    IF payload EXISTS AS payload_value THEN
        MUTABLE payload_value_mutable = COPY payload_value;
        MUTABLE rtoc_mutable_receiver_212 = typeAnalysisSession__current_scope(rtoc_self_view);
        TRY (scope__declare(&rtoc_mutable_receiver_212, "result", NIL, castTypeToOptionalSymbolEntryTypeInput(payload_value_mutable), ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    END
    MUTABLE allowed_names = (param_names + ["result"]);
    FOR _ IN post_clauses DO
      MUTABLE expr = _[:expr];
      typeAnalysisSession__with_predicate_context(&rtoc_self_view, PredicateContext{ kind: :post, with_node: NIL, fn_node: fn_node, pred_expr: COPY CAST(expr AS Locatable), guard_alias: NIL, sibling_aliases: ( { MUTABLE rtoc_empty_list_213: []String = List[]; rtoc_empty_list_213 } ), param_names: ( { MUTABLE rtoc_empty_list_214: []String = List[]; rtoc_empty_list_214 } ), allowed_names: COPY allowed_names, rejected_param_names: COPY rejected, fn_name: COPY fn_node.name }, %() USE(MUTABLE expr, MUTABLE rtoc_self_view) -> {
        TRY (typeAnalysisSession__visit(&rtoc_self_view, expr));
        MUTABLE pred_type = &expr.full_type_mut({:context: "DEBUG_POST expression"});
        IF !((pred_type AND (pred_type.resolved() == :Bool))) THEN
            typeAnalysisSession__error_mut(rtoc_self_view, expr, TypeAnalysisCodeOrMessage{ SymbolValue: :DEBUG_POST_EXPR_MUST_BE_BOOL }, [], {:got: (pred_type OR "Unknown")});
        END
        NIL
      });
    END
    NIL
    });
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__validate_with_guard_no_body_mutation_mut(self: TypeAnalysisSession, node: WithBlock) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE capability_plan = TRY (capabilityPlan__require_for(node));
    IF ((TRY (withCapabilityPlan__guarded(capability_plan))).length() == 0) THEN
      RETURN;
    END
    MUTABLE mutable_caps = capability_plan.all |> WHERE (_.alias_mutable() AND _.alias_explicit());
    IF mutable_caps.empty?() THEN
      RETURN;
    END
    MUTABLE mutated = (mutable_caps |> SELECT _.alias_name()) |> WHERE typeAnalysisSession__alias_mutated?(rtoc_self_view, _);
    IF mutated.empty?() THEN
      RETURN;
    END
    MUTABLE is_or_are: String = "";
    IF (scopeBindings__length(mutated) == 1) THEN
      is_or_are = "is";
    ELSE
      is_or_are = "are";
    END
    typeAnalysisSession__emit_with_guard_mutable_mutated_mut(rtoc_self_view, node, mutated, is_or_are);
}
END
PRIVATE FN typeAnalysisSession__alias_mutated?(self: TypeAnalysisSession, alias_name: String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE scope: ?Scope@multiowned = typeAnalysisSession__lookup_scope_for(rtoc_self_view, alias_name);
    IF scope EXISTS AS scope_value THEN
      RETURN !(!((IF scope__resolve_entry(scope_value, alias_name) != NIL THEN
        { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_215 = (scope__resolve_entry(scope_value, alias_name));
      symbolEntry__mutated(rtoc_local_receiver_215) }
      ELSE
        NIL
      END)));
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__acquire_capability_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: WithBlock, MUTABLE cap: ASTCapability, MUTABLE expanded: WithCapabilityPlan) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE var_node = COPY aSTCapability__var_node(cap);
    TRY (typeAnalysisSession__visit(&rtoc_self_view, var_node));
    cap.resolved_type = &var_node.full_type_mut("WITH resolved capability target");
    MUTABLE abstract_shared_map = typeAnalysisSession__generic_parameter_has_shared_map_bound?(rtoc_self_view, type__resolved(aSTCapability__resolved_type(cap)));
    IF abstract_shared_map THEN
      IF !(node.polymorphic) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_SHARED_MAP_REQUIRES_WITH }, [], {:type: type__resolved(aSTCapability__resolved_type(cap))});
      END
      node.universal_poly = TRUE;
    END
    cap.old_scope = typeAnalysisSession__lookup_scope_for(rtoc_self_view, capabilityPlan__var_name_for(var_node));
    IF (aSTCapability__capability(cap) == :infer) THEN
      MUTABLE storage: ?String@symbol = typeAnalysisSession__cap_var_storage(rtoc_self_view, &var_node);
      MUTABLE syn: ?String@symbol = typeAnalysisSession__cap_var_sync(rtoc_self_view, &var_node);
      cap.capability = IF (syn == :locked) THEN
        symbol("EXCLUSIVE")
      ELSE_IF (syn == :write_locked) THEN
        :write_locked_read
      ELSE_IF (syn == :versioned) THEN
        symbol("SNAPSHOT")
      ELSE_IF (syn == :atomic) THEN
        :ATOMIC
      ELSE_IF ((((TRUE AND node.polymorphic)) AND (((syn == NIL) OR (syn? == :local)))) AND ((((((storage == NIL) OR (storage? == :local)) OR (storage == :multiowned)) OR (storage == :stack)) OR (storage == :heap)))) THEN
        {
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE root: ?Identifier = aST__root_identifier(var_node);
    MUTABLE is_mut = ((aSTCapability__alias_mutable(cap) OR (IF var_aST__node__symbol(node) != NIL THEN
        (var_aST__node__symbol(node)).mutable()
      ELSE
        NIL
      END)) OR root?.symbol?.mutable);
    (IF is_mut THEN
        {
    MUTABLE rtoc_value_block_marker = 0;
    cap.alias_mutable = TRUE;
    symbol("RESTRICT")
      }
      ELSE
        symbol("BORROWED")
      END)
      }
      ELSE_IF (storage == :multiowned) THEN
        :multiowned
      ELSE_IF (storage == :shared) THEN
        :shared
      ELSE
        {
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE name = typeAnalysisSession__cap_var_label(rtoc_self_view, var_node);
    typeAnalysisSession__emit_with_cannot_infer_cap_mut(rtoc_self_view, node, name);
    :unknown
      }
      END;
    END
    MUTABLE fact = typeAnalysisSession__with_capability_fact(rtoc_self_view, cap);
    typeAnalysisSession__validate_capability_transition_mut(&rtoc_self_view, node, fact);
    IF (TRUE AND (node.arms != NIL)) THEN
  
    ELSE
      IF (fact.capability == symbol("EXCLUSIVE")) OR (fact.capability == :write_locked_read) THEN
        typeAnalysisSession__record_effect(rtoc_self_view, symbol("BLOCKING"));
        typeAnalysisSession__record_effect(rtoc_self_view, symbol("CONTENTION"));
      ELSE_IF (fact.capability == symbol("SNAPSHOT")) THEN
        typeAnalysisSession__record_effect(rtoc_self_view, symbol("CONTENTION"));
      END
    END
    MUTABLE audit_root: ?Identifier = aST__root_identifier(var_node);
    IF ((audit_root != NIL) AND (((fact.capability == symbol("EXCLUSIVE")) OR ((node.polymorphic AND aSTCapability__alias_mutable(cap)))))) THEN
      typeAnalysisSession__audit_mark_mutated(rtoc_self_view, audit_root.name);
    END
    IF (IF var_node IS_A GetField AS get_field THEN getField__wildcard?(get_field) ELSE FALSE END) THEN
      MUTABLE target_type = var_node.target().resolved_type();
      MUTABLE schema = typeAnalysisSession__lookup_type_schema(rtoc_self_view, target_type);
      MUTABLE fields = schema.fields();
      FOR rtoc_each_key IN fields.keys() DO
    MUTABLE ignored_1 = COPY UNWRAP (fields[rtoc_each_key]);
    (TRY (typeAnalysisSession__visit(&rtoc_self_view, Locatable{ GetField: COPY field_node })) OR_ELSE NIL);
    MUTABLE expanded_cap = ASTCapability{ capability: COPY aSTCapability__capability(cap), var_node: Locatable{ GetField: COPY field_node }, old_scope: COPY aSTCapability__old_scope(cap), resolved_type: CAST(COPY &field_node.full_type_mut("WITH wildcard field") AS Type), alias_value: NIL, alias_mutable: FALSE, guard_expr: NIL, snapshot_token: NIL, view_token: NIL, view_length: NIL, as_token: NIL };
    withCapabilityPlan__add(expanded, typeAnalysisSession__with_capability_fact(rtoc_self_view, expanded_cap));
      END
      MUTABLE base_t = var_node.target().full_type_mut({:context: "WITH wildcard base"});
      IF !(TRUE) THEN
        base_t = TRY (type__new(castTypeToTypeConstructionInput(base_t)));
      END
      MUTABLE expanded_cap = ASTCapability{ capability: COPY aSTCapability__capability(cap), var_node: COPY var_node.target(), old_scope: COPY aSTCapability__old_scope(cap), resolved_type: COPY base_t, alias_value: NIL, alias_mutable: FALSE, guard_expr: NIL, snapshot_token: NIL, view_token: NIL, view_length: NIL, as_token: NIL };
      withCapabilityPlan__add(expanded, typeAnalysisSession__with_capability_fact(rtoc_self_view, expanded_cap));
    ELSE
      withCapabilityPlan__add(expanded, fact);
    END
}
END
PRIVATE FN typeAnalysisSession__with_capability_fact(self: TypeAnalysisSession, cap: ASTCapability) RETURNS !CapabilityTransition
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE request = capabilityRequest__from_ast(cap);
    MUTABLE var_node: Locatable = COPY castLocatableToLocatable(aSTCapability__var_node(cap));
    MUTABLE var_name = capabilityPlan__var_name_for(var_node);
    MUTABLE resolved = COPY aSTCapability__resolved_type(cap);
    MUTABLE old_scope: ?Scope@multiowned = CAST(aSTCapability__old_scope(cap) AS ?Scope@multiowned);
    MUTABLE source_entry: ?SymbolEntry@multiowned = NIL;
    IF old_scope != NIL THEN
      source_entry = COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_216 = (old_scope?);
    scope__resolve_entry(rtoc_local_receiver_216, var_name) };
    END
    MUTABLE source_type_branch_value: ?Type = NIL;
    IF source_entry EXISTS AS source_entry_value THEN
      source_type_branch_value = TRY (type__new(TypeConstructionInput{ Type: COPY symbolEntry__type(source_entry_value) }));
    ELSE
      source_type_branch_value = TRY (type__new(castTypeToTypeConstructionInput(resolved)));
    END
    MUTABLE source_type: Type = source_type_branch_value?;
    MUTABLE sync: ?String@symbol = typeAnalysisSession__cap_var_sync(rtoc_self_view, &var_node);
    MUTABLE target = CapabilityTargetFact{ var_node: COPY var_node, var_name: COPY var_name, target_label: COPY typeAnalysisSession__cap_var_label(rtoc_self_view, var_node), field_target: var_node IS_A GetField, index_target: var_node IS_A GetIndex, resolved_type: COPY TRY (type__new(castTypeToTypeConstructionInput(resolved))), old_scope: old_scope, source_entry: source_entry, sync: COPY sync, storage: COPY typeAnalysisSession__cap_var_storage(rtoc_self_view, &var_node), layout: COPY typeAnalysisSession__cap_var_layout(rtoc_self_view, &var_node), source_type: COPY source_type, live_symbol_refreshed: FALSE };
    RETURN TRY (capabilityPlan__transition_from(request, target, typeAnalysisSession__borrowed_source_qualifier(rtoc_self_view, source_entry)));
}
END
PRIVATE FN typeAnalysisSession__borrowed_source_qualifier(self: TypeAnalysisSession, entry: ?SymbolEntry) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF entry EXISTS AS entry_value THEN
      MUTABLE storage_qualifier: ?String = COPY (CAST({:shared: "@shared", :multiowned: "@multiowned"} AS {String@symbol}String))[symbolEntry__storage(entry_value)];
      IF storage_qualifier EXISTS AS storage_qualifier_value THEN
        RETURN COPY storage_qualifier_value;
      END
      IF symbolEntry__locked?(entry_value) THEN
        RETURN "@locked";
      END
      IF symbolEntry__write_locked?(entry_value) THEN
        RETURN "@writeLocked";
      END
      RETURN NIL;
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__declare_capability_scope_mut(self: TypeAnalysisSession, fact: CapabilityTransition) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF capabilityTransition__unwraps_sync_alias?(fact) THEN
      typeAnalysisSession__declare_unwrapped_capability_alias_mut(rtoc_self_view, fact);
    END
    typeAnalysisSession__declare_capability_binding_or_error_mut(rtoc_self_view, fact);
    typeAnalysisSession__declare_capability_projection_mut(rtoc_self_view, fact);
    MUTABLE alias_name = COPY fact.alias_name;
    IF alias_name THEN
      (({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_217 = typeAnalysisSession__current_scope(rtoc_self_view);
      scope__resolve_entry(rtoc_local_receiver_217, alias_name) })?.capabilities).insert(COPY fact.capability);
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__declare_capability_binding_or_error_mut(self: TypeAnalysisSession, fact: CapabilityTransition) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_218 = typeAnalysisSession__current_scope(rtoc_self_view);
    scope__declare_with_new_capability(&rtoc_mutable_receiver_218, fact.source) } THEN
      RETURN;
    END
    typeAnalysisSession__error_mut(rtoc_self_view, fact.var_node, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_CAP_BINDING_LOST }, [], {:capability: fact.capability, :name: fact.var_name});
}
END
PRIVATE FN typeAnalysisSession__declare_capability_projection_mut(self: TypeAnalysisSession, fact: CapabilityTransition) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (fact.capability == symbol("RESTRICT")) THEN
      typeAnalysisSession__declare_restrict_capability_mut(rtoc_self_view, fact);
    ELSE_IF (fact.capability == symbol("VIEW")) OR (fact.capability == :MATERIALIZED_VIEW) OR (fact.capability == :UNSAFE_VIEW) THEN
      typeAnalysisSession__declare_view_capability_mut(rtoc_self_view, fact);
    ELSE_IF (fact.capability == symbol("SNAPSHOT")) THEN
      typeAnalysisSession__declare_snapshot_capability_mut(rtoc_self_view, fact);
    ELSE_IF (fact.capability == symbol("BORROWED")) THEN
      typeAnalysisSession__declare_borrowed_capability_mut(rtoc_self_view, fact);
    END
}
END
PRIVATE FN typeAnalysisSession__declare_unwrapped_capability_alias_mut(self: TypeAnalysisSession, fact: CapabilityTransition) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE alias_name = COPY fact.alias_name;
    MUTABLE inner_type = typeAnalysisSession__unwrapped_capability_alias_type(rtoc_self_view, fact);
    MUTABLE rtoc_mutable_receiver_219 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_219, alias_name, NIL, SymbolEntryTypeInput{ TypeMultiowned: COPY inner_type }, ScopeMutabilityInput{ BoolValue: TRUE }, FALSE, NIL, :heap));
    IF fact.alias_explicit THEN
      typeAnalysisSession__record_capture_local_mut(rtoc_self_view, alias_name);
    END
    MUTABLE alias_entry = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_220 = typeAnalysisSession__current_scope(rtoc_self_view);
    scope__local_entry_mut(rtoc_local_receiver_220, alias_name) };
    TRY (symbolEntry__mark_non_escaping_mut(&alias_entry));
    symbolEntry__mark_borrowed_alias_mut(&alias_entry);
    typeAnalysisSession__og_declare(rtoc_self_view, alias_name, NIL, TypeTypeInput{ Type: COPY inner_type });
}
END
PRIVATE FN typeAnalysisSession__unwrapped_capability_alias_type(self: TypeAnalysisSession, fact: CapabilityTransition) RETURNS Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE source_type_branch_value: ?Type@multiowned = NIL;
    IF fact.field_target THEN
      source_type_branch_value = &fact.var_node.full_type_mut("WITH capability field alias");
    ELSE
      source_type_branch_value = capabilityTransition__declared_source_type(fact);
    END
    MUTABLE source_type: Type@multiowned = source_type_branch_value?;
    RETURN CAST(typeAnalysisSession__capability_alias_type(rtoc_self_view, CAST(source_type AS Type)) AS Type);
}
END
PRIVATE FN typeAnalysisSession__declare_restrict_capability_mut(self: TypeAnalysisSession, fact: CapabilityTransition) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rtoc_mutable_receiver_221 = typeAnalysisSession__ownership_graph(rtoc_self_view);
    TRY (ownershipGraph__borrow(&rtoc_mutable_receiver_221, "__restrict_${fact.var_name}", fact.var_name, TRUE));
    IF fact.alias_mutable THEN
      typeAnalysisSession__mark_var_mutated(rtoc_self_view, fact.var_name);
    END
    IF capabilityTransition__declares_plain_restrict_alias?(fact) THEN
      typeAnalysisSession__declare_restrict_alias_mut(rtoc_self_view, fact);
    END
}
END
PRIVATE FN typeAnalysisSession__declare_restrict_alias_mut(self: TypeAnalysisSession, fact: CapabilityTransition) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE alias_name = COPY fact.alias_name;
    MUTABLE resolved_type = typeAnalysisSession__capability_alias_type(rtoc_self_view, CAST(typeAnalysisSession__capability_source_type(rtoc_self_view, fact) AS Type));
    MUTABLE rtoc_mutable_receiver_222 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_222, alias_name, NIL, SymbolEntryTypeInput{ TypeMultiowned: COPY resolved_type }, ScopeMutabilityInput{ BoolValue: fact.alias_mutable }, FALSE, NIL, :stack));
    typeAnalysisSession__record_capture_local_mut(rtoc_self_view, alias_name);
    MUTABLE sym = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_223 = typeAnalysisSession__current_scope(rtoc_self_view);
    scope__local_entry_mut(rtoc_local_receiver_223, alias_name) };
    TRY (symbolEntry__mark_non_escaping_mut(&sym));
    symbolEntry__mark_borrowed_alias_mut(&sym);
    typeAnalysisSession__og_declare(rtoc_self_view, alias_name, NIL, TypeTypeInput{ Type: COPY resolved_type });
}
END
PRIVATE FN typeAnalysisSession__declare_view_capability_mut(self: TypeAnalysisSession, fact: CapabilityTransition) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE bind_type = typeAnalysisSession__view_capability_alias_type(rtoc_self_view, fact);
    MUTABLE alias_name = COPY fact.alias_name;
    MUTABLE rtoc_mutable_receiver_224 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_224, alias_name, NIL, SymbolEntryTypeInput{ TypeMultiowned: COPY bind_type }, ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    typeAnalysisSession__record_capture_local_mut(rtoc_self_view, alias_name);
    IF ((fact.capability == symbol("VIEW")) OR (fact.capability == :UNSAFE_VIEW)) THEN
      typeAnalysisSession__declare_view_borrow_constraints_mut(rtoc_self_view, alias_name);
    END
    typeAnalysisSession__og_declare(rtoc_self_view, alias_name, NIL, TypeTypeInput{ Type: COPY bind_type });
}
END
PRIVATE FN typeAnalysisSession__view_capability_alias_type(self: TypeAnalysisSession, fact: CapabilityTransition) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (fact.capability == :UNSAFE_VIEW) THEN
      MUTABLE element = UNWRAP (TRY (type__element_type(fact.resolved_type)));
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("${TRY (type__surface_name(castTypeToTypeTypeInput(element)))}[]") }, NIL, NIL, NIL, :borrow));
    END
    RETURN TRY (type__tense_type((TRY (type__new(castTypeToTypeConstructionInput(fact.resolved_type))))));
}
END
PRIVATE FN typeAnalysisSession__declare_view_borrow_constraints_mut(self: TypeAnalysisSession, alias_name: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE sym = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_225 = typeAnalysisSession__current_scope(rtoc_self_view);
    scope__local_entry_mut(rtoc_local_receiver_225, alias_name) };
    TRY (symbolEntry__mark_non_escaping_mut(&sym));
    symbolEntry__mark_borrowed_alias_mut(&sym);
}
END
PRIVATE FN typeAnalysisSession__declare_snapshot_capability_mut(self: TypeAnalysisSession, fact: CapabilityTransition) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE alias_name = COPY fact.alias_name;
    MUTABLE inner_type = TRY (type__bare_data_type((TRY (type__new(castTypeToTypeConstructionInput(fact.resolved_type))))));
    MUTABLE rtoc_mutable_receiver_226 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_226, alias_name, NIL, castTypeToOptionalSymbolEntryTypeInput(inner_type), ScopeMutabilityInput{ BoolValue: fact.alias_mutable }, FALSE, NIL, :stack));
    typeAnalysisSession__record_capture_local_mut(rtoc_self_view, alias_name);
    MUTABLE sym = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_227 = typeAnalysisSession__current_scope(rtoc_self_view);
    scope__local_entry_mut(rtoc_local_receiver_227, alias_name) };
    TRY (symbolEntry__mark_non_escaping_mut(&sym));
    symbolEntry__mark_borrowed_alias_mut(&sym);
    typeAnalysisSession__og_declare(rtoc_self_view, alias_name, NIL, castTypeToTypeTypeInput(inner_type));
}
END
PRIVATE FN typeAnalysisSession__declare_borrowed_capability_mut(self: TypeAnalysisSession, fact: CapabilityTransition) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE qualifier: ?String = capabilityTransition__borrowed_rejection_qualifier(fact);
    IF qualifier EXISTS AS qualifier_value THEN
      typeAnalysisSession__emit_borrowed_rejection_mut(rtoc_self_view, fact, qualifier_value);
    END
    MUTABLE alias_name = COPY fact.alias_name;
    MUTABLE resolved_type = typeAnalysisSession__capability_alias_type(rtoc_self_view, CAST(typeAnalysisSession__capability_source_type(rtoc_self_view, fact) AS Type));
    MUTABLE rtoc_mutable_receiver_228 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_228, alias_name, NIL, SymbolEntryTypeInput{ TypeMultiowned: COPY resolved_type }, ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    IF fact.alias_explicit THEN
      typeAnalysisSession__record_capture_local_mut(rtoc_self_view, alias_name);
    END
    MUTABLE sym = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_229 = typeAnalysisSession__current_scope(rtoc_self_view);
    scope__local_entry_mut(rtoc_local_receiver_229, alias_name) };
    TRY (symbolEntry__mark_non_escaping_mut(&sym));
    symbolEntry__mark_borrowed_alias_mut(&sym);
    typeAnalysisSession__og_declare(rtoc_self_view, alias_name, NIL, TypeTypeInput{ Type: COPY resolved_type });
    MUTABLE rtoc_mutable_receiver_230 = typeAnalysisSession__ownership_graph(rtoc_self_view);
    TRY (ownershipGraph__borrow(&rtoc_mutable_receiver_230, "__borrowed_${fact.var_name}", fact.var_name, FALSE));
}
END
PRIVATE FN typeAnalysisSession__emit_borrowed_rejection_mut(self: TypeAnalysisSession, fact: CapabilityTransition, qualifier: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE remediation = "BORROWED guarantees the data is stable, but ${qualifier} data can be modified concurrently. Use WITH ${fact.var_name} { } to access it safely instead.";
    typeAnalysisSession__error_mut(rtoc_self_view, fact.var_node, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_BORROWED_ON_QUALIFIED_VAR }, [], {:qualifier: qualifier, :name: fact.var_name, :remediation: remediation});
}
END
PRIVATE FN typeAnalysisSession__capability_source_type(self: TypeAnalysisSession, fact: CapabilityTransition) RETURNS Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF type__untyped?(fact.resolved_type) THEN
      RETURN CAST(capabilityTransition__declared_source_type(fact) AS Type);
    ELSE
      RETURN COPY fact.resolved_type;
    END
}
END
PRIVATE FN typeAnalysisSession__capability_alias_type(self: TypeAnalysisSession, type: Type) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE t = TRY (type__new(castTypeToTypeConstructionInput(type)));
    IF (type__any_sync?(t) OR (type__ownership(t) != :affine)) THEN
      RETURN TRY (type__bare_data_type(t));
    ELSE
      RETURN t;
    END
}
END
PRIVATE FN typeAnalysisSession__new_capture_analysis(self: TypeAnalysisSession) RETURNS CaptureAnalysis
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN CaptureAnalysis{ has_local: FALSE, has_rc: FALSE, has_shared: FALSE, has_sharded: FALSE, has_affine_locked: FALSE, has_outer_ref: FALSE, has_non_escaping_capture: FALSE, captures: {}, capture_symbols: {}, close_plans: {}, pointer_captures: Set[], string_captures: Set[], resource_captures: Set[], site_moved: Set[], site_copied: Set[], strategies: {}, move_mark_names: Set[], alloc_mark_entries: {} };
}
END
PRIVATE FN typeAnalysisSession__with_fiber_capture_analysis(self: TypeAnalysisSession, MUTABLE is_parallel: ?Bool = FALSE, mark_moves: Bool = FALSE, blk: FN() -> Void) RETURNS !CaptureAnalysis
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
  MUTABLE ctx: ?CaptureContext = NIL;
  MUTABLE state: CapabilityAuditInputs = typeAnalysisSession__phase_audit_inputs(rtoc_self_view);
  ctx = CaptureContext{ analysis: COPY typeAnalysisSession__new_capture_analysis(rtoc_self_view), outer_scope: typeAnalysisSession__current_scope(rtoc_self_view), locals: COPY Set[], is_parallel: !(!(is_parallel)), mark_moves: COPY mark_moves };
  DEFER {
  MUTABLE popped: ?CaptureContext = &state.capture_stack.pop();
  IF ((popped != NIL) AND !(popped.equal?(ctx))) THEN
      panic("BUG: capture context mismatch");
  END
  }
  &state.capture_stack.append(UNWRAP (COPY ctx));
  blk();
  RETURN COPY ctx.analysis;
}
END
PRIVATE FN typeAnalysisSession__current_capture_context(self: TypeAnalysisSession) RETURNS ?CaptureContext
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY typeAnalysisSession__phase_audit_inputs(rtoc_self_view).capture_stack.last();
}
END
PRIVATE FN typeAnalysisSession__record_capture_local_mut(self: TypeAnalysisSession, name: ?String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF name EXISTS AS name_value THEN
      (typeAnalysisSession__current_capture_context(rtoc_self_view)?.locals).insert(COPY name_value);
    END
}
END
PRIVATE FN typeAnalysisSession__record_capture_site_mut(self: TypeAnalysisSession, node: CaptureSiteNode, copied: Bool) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE ctx: ?CaptureContext = typeAnalysisSession__current_capture_context(rtoc_self_view);
    IF ctx EXISTS AS ctx_value THEN
      MUTABLE root = (aST__root_identifier(node.value()) OR_ELSE NIL);
      MUTABLE name: ?String = COPY (IF root != NIL THEN
        (root.name() OR_ELSE "")
      ELSE
        NIL
      END);
      IF (!(name) OR ctx_value.locals.contains?(name)) THEN
        RETURN;
      END
      IF copied THEN
        &ctx_value.analysis.site_copied.insert(UNWRAP (name));
      ELSE
        &ctx_value.analysis.site_moved.insert(UNWRAP (name));
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__record_capture_identifier_mut(self: TypeAnalysisSession, MUTABLE node: Identifier) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE ctx: ?CaptureContext = typeAnalysisSession__current_capture_context(rtoc_self_view);
    IF ctx EXISTS AS ctx_value THEN
      MUTABLE name = COPY node.name;
      IF (ctx_value.locals.contains?(name) OR (["TRUE", "FALSE", "VOID", "_"]).contains?(name)) THEN
        RETURN;
      END
      MUTABLE info: ?SymbolEntry@multiowned = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_231 = (KEEP ctx_value.outer_scope);
      scope__resolve_entry(rtoc_local_receiver_231, name) };
      MUTABLE resolved_sym = (IF info != NIL THEN info ELSE node.symbol END);
      IF typeAnalysisSession__non_escaping_fiber_capture?(rtoc_self_view, resolved_sym) THEN
        ctx_value.analysis.has_non_escaping_capture = TRUE;
      END
      IF info EXISTS AS info_value THEN
        typeAnalysisSession__record_capture_info_mut(rtoc_self_view, ctx_value, name, info_value, &node);
        typeAnalysisSession__record_capture_move_mut(rtoc_self_view, ctx_value, name, info_value, node);
      ELSE
      IF typeAnalysisSession__lookup_scope_for(rtoc_self_view, name) THEN
          ctx_value.analysis.has_outer_ref = TRUE;
      END
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__non_escaping_fiber_capture?(self: TypeAnalysisSession, symbol: ?SymbolEntry) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((((symbol != NIL) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_232 = (symbol?);
    symbolEntry__borrowed_alias(rtoc_local_receiver_232) }) AND symbolEntry__non_escaping(symbol))) THEN
      RETURN FALSE;
    END
    RETURN (((!(symbolEntry__locked?(symbol)) AND !(symbolEntry__write_locked?(symbol))) AND !(symbolEntry__local?(symbol))) AND !(symbolEntry__atomic?(symbol)));
}
END
PRIVATE FN typeAnalysisSession__record_capture_info_mut(self: TypeAnalysisSession, ctx: CaptureContext, name: String, info: SymbolEntry, MUTABLE node: Identifier) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE result = COPY ctx.analysis;
    result.has_outer_ref = TRUE;
    IF !(result.captures.contains?(name)) THEN
      MUTABLE cap_type_branch_value: ?Type@multiowned = NIL;
      IF symbolEntry__atomic?(info) THEN
        cap_type_branch_value = symbolEntry__type(info);
      ELSE
        cap_type_branch_value = &node.full_type_mut("fiber capture identifier");
      END
      MUTABLE cap_type: Type@multiowned = cap_type_branch_value?;
      result.captures[name] = CAST(COPY cap_type AS Type);
      result.capture_symbols[name] = info;
      MUTABLE t = cap_type;
      MUTABLE close_plan: ?ResourceClosePlan = symbolEntry__close_plan(info);
      typeAnalysisSession__add_capture_name_when(rtoc_self_view, &result.pointer_captures, name, type__needs_pointer_passing?(t));
      typeAnalysisSession__add_capture_name_when(rtoc_self_view, &result.string_captures, name, TRY (type__string?(t)));
      typeAnalysisSession__add_capture_name_when(rtoc_self_view, &result.resource_captures, name, (type__resource?(t) OR !((close_plan == NIL))));
      MUTABLE string_map_cleanup = (TRY (type__captured_plain_string_map_needs_deinit?(t)) AND (close_plan == NIL));
      typeAnalysisSession__add_capture_name_when(rtoc_self_view, &result.resource_captures, name, string_map_cleanup);
      typeAnalysisSession__set_capture_close_plan_when(rtoc_self_view, result.close_plans, name, resourceClosePlan__method("deinit", 2), string_map_cleanup);
    END
    close_plan = symbolEntry__close_plan(info);
    typeAnalysisSession__set_capture_close_plan_when(rtoc_self_view, result.close_plans, name, close_plan, !((close_plan == NIL)));
    result.has_local = (result.has_local OR symbolEntry__local?(info));
    result.has_rc = (result.has_rc OR (symbolEntry__storage(info) == :multiowned));
    MUTABLE ti = symbolEntry__type(info);
    MUTABLE recursive_boundary_reason: ?String@symbol = TRY (type__parallel_boundary_forbidden_reason(ti, %(type_name) USE(rtoc_self_view) -> typeAnalysisSession__lookup_type_schema(rtoc_self_view, type_name)));
    result.has_local = (result.has_local OR (recursive_boundary_reason == :local_scheduler_affinity));
    result.has_rc = (result.has_rc OR (recursive_boundary_reason == :non_atomic_rc));
    MUTABLE sync_capture = (!(((type__striped?(ti) AND ((type__shared?(ti) OR type__multiowned?(ti)))))) AND !(symbolEntry__atomic?(info)));
    MUTABLE sharded_capture = (sync_capture AND type__sharded?(ti));
    result.has_shared = (result.has_shared OR (sharded_capture OR ((sync_capture AND ((((symbolEntry__locked?(info) OR symbolEntry__write_locked?(info)) OR symbolEntry__local?(info)) OR symbolEntry__rc_stored?(info)))))));
    result.has_affine_locked = (result.has_affine_locked OR (sync_capture AND symbolEntry__affine_locked_capture?(info)));
    result.has_sharded = (result.has_sharded OR sharded_capture);
    typeAnalysisSession__audit_mark_captured(rtoc_self_view, name, ctx.is_parallel);
}
END
PRIVATE FN typeAnalysisSession__add_capture_name_when(self: TypeAnalysisSession, MUTABLE names: [Set]String, name: String, active: Bool) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(active) THEN
      RETURN;
    END
    &names.insert(COPY name);
}
END
PRIVATE FN typeAnalysisSession__set_capture_close_plan_when(self: TypeAnalysisSession, plans: {String}ResourceClosePlan, name: String, plan: ?ResourceClosePlan, active: Bool) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(active) THEN
      RETURN;
    END
    plans[name] = (plans[name] OR_ELSE plan?);
}
END
PRIVATE FN typeAnalysisSession__record_capture_move_mut(self: TypeAnalysisSession, ctx: CaptureContext, name: String, MUTABLE info: SymbolEntry, node: Identifier) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((ctx.mark_moves AND typeAnalysisSession__phase_audit_inputs(rtoc_self_view).capture_move_suppression_depth.zero?())) THEN
      RETURN;
    END
    IF !(((KEEP ctx.outer_scope).owned_names).contains?(name)) THEN
      RETURN;
    END
    IF !(symbolEntry__ownership_kind(info)) THEN
      typeAnalysisSession__classify_ownership_mut(rtoc_self_view, &info);
    END
    IF symbolEntry__capture_move_required?(info, { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_233 = typeAnalysisSession__ownership_graph(rtoc_self_view);
    ownershipGraph__live?(rtoc_local_receiver_233, name) }) THEN
      TRY (typeAnalysisSession__og_set_moved(rtoc_self_view, name, node.token, :capture));
    END
}
END
PRIVATE FN typeAnalysisSession__without_capture_moves<Result>(self: TypeAnalysisSession, blk: FN() -> Result) RETURNS Result
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
  DEFER typeAnalysisSession__phase_audit_inputs(rtoc_self_view).capture_move_suppression_depth=((typeAnalysisSession__phase_audit_inputs(rtoc_self_view).capture_move_suppression_depth() - 1));
  typeAnalysisSession__phase_audit_inputs(rtoc_self_view).capture_move_suppression_depth=((typeAnalysisSession__phase_audit_inputs(rtoc_self_view).capture_move_suppression_depth() + 1));
  RETURN blk();
}
END
PRIVATE FN typeAnalysisSession__validate_capture_analysis_mut(self: TypeAnalysisSession, node: Node, analysis: CaptureAnalysis, MUTABLE is_parallel: Bool, MUTABLE is_pinned: Bool) RETURNS ?CaptureAnalysis
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF is_parallel THEN
      IF analysis.has_local THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :LOCAL_VAR_NOT_IN_PARALLEL });
      END
      IF analysis.has_rc THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :MULTIOWNED_NOT_IN_PARALLEL });
      END
    END
    IF ((!(is_pinned) AND !(is_parallel)) AND analysis.has_shared) THEN
      RETURN COPY analysis;
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__capability_audit_init_mut(self: TypeAnalysisSession) RETURNS BindingAuditStore
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE store = typeAnalysisSession__capability_audit_store(rtoc_self_view);
    &store.clear();
    RETURN store;
}
END
PRIVATE FN typeAnalysisSession__record_capability_binding(self: TypeAnalysisSession, var_name: String, node: Locatable, final_type: FinalType, storage: String@symbol) RETURNS !?BindingAuditRecord
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fn_ctx: ?FunctionContext@multiowned = typeAnalysisSession__current_fn_ctx(rtoc_self_view);
    IF fn_ctx EXISTS AS fn_ctx_value THEN
      MUTABLE fn_name = COPY fn_ctx_value.name;
      MUTABLE info: ?SymbolEntry@multiowned = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_234 = typeAnalysisSession__current_scope(rtoc_self_view);
      scope__resolve_entry(rtoc_local_receiver_234, var_name) };
      MUTABLE sync: ?String@symbol = (IF info != NIL THEN
        symbolEntry__sync(info)
      ELSE
        NIL
      END);
      IF ((storage == :multiowned) OR (storage == :shared)) THEN
        MUTABLE own = COPY storage;
      END
      IF !((sync OR_ELSE own)) THEN
        RETURN;
      END
      MUTABLE fn_nodes = TRY (typeAnalysisSession__function_node_map(rtoc_self_view));
      MUTABLE fn_node: ?FunctionDef@multiowned = COPY fn_nodes[fn_name];
      IF ((fn_node != NIL) AND (fn_node.visibility == :pub)) THEN
        RETURN;
      END
      MUTABLE key = typeAnalysisSession__capability_audit_key(rtoc_self_view, fn_name, var_name);
      MUTABLE line = (IF aST__node__token(node) != NIL THEN
        (aST__node__token(node)).line()
      ELSE
        NIL
      END);
      MUTABLE column = (IF aST__node__token(node) != NIL THEN
        (aST__node__token(node)).column()
      ELSE
        NIL
      END);
      MUTABLE final_type_info = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_236: ?FinalType = NIL;
      IF final_type IS_A Type THEN
        rtoc_ternary_value_236 = final_type;
      ELSE
        rtoc_ternary_value_236 = TRY (type__new(castFinalTypeToTypeConstructionInput(final_type)));
      END
      rtoc_ternary_value_236? };
      MUTABLE record = BindingAuditRecord{ fn: COPY fn_name, var: COPY var_name, line: line, column: column, sync: COPY sync, ownership: COPY own, storage: COPY storage, sharded: type__sharded?(final_type_info), mutated: FALSE, captured_bg: FALSE, captured_parallel: FALSE };
      MUTABLE rtoc_index_receiver_237 = typeAnalysisSession__capability_audit_store(rtoc_self_view);
      rtoc_index_receiver_237[key] = record;
      RETURN record;
    ELSE
      RETURN;
    END
}
END
