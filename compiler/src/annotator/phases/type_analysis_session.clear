PUB FN typeAnalysisSession__execute_type_analysis_mut(MUTABLE self: TypeAnalysisSession, resolution: ResolutionFacts) RETURNS !TypeAnalysisHandoff
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__reset_compilation_state_mut(&rtoc_self_view);
    MUTABLE ownership = typeAnalysisSession__analyze_resolution_mut(&rtoc_self_view, resolution);
    MUTABLE inventory = TRY (annotationTypeInventory__scan(CAST(COPY KEEP resolution.program AS Program)));
    TRY (annotationTypeInventory__verify_resolved_mut(inventory));
    TRY (typeAnalysisSession__apply_keep_analysis_mut(rtoc_self_view, resolution));
    MUTABLE schema_lookup = %(name) USE(rtoc_self_view) -> typeAnalysisSession__lookup_type_schema(rtoc_self_view, name);
    MUTABLE lifecycle_inventory = TRY (lifecycleRegistry__type_inventory(CAST(COPY KEEP resolution.program AS Program), schema_lookup));
    MUTABLE linear_resource_facts = linearResourceFacts__build_types(lifecycle_inventory.values(), schema_lookup);
    typeAnalysisSession__validate_copy_linear_resource_facts_mut(rtoc_self_view, CAST(COPY KEEP resolution.program AS Program), linear_resource_facts);
    MUTABLE lifecycle_registry = TRY (lifecycleRegistry__build(CAST(COPY KEEP resolution.program AS Program), schema_lookup, resolution.function_registry.body_summaries.values() |> UNNEST _.binding_nodes, linear_resource_facts, lifecycle_inventory));
    MUTABLE typed_program = TRY (typedProgramFacts__new(resolution, resolution.function_registry.body_summaries, inventory.typed_node_count, annotationTypeInventory__unresolved_node_count(inventory), ownership, lifecycle_registry, linear_resource_facts));
    RETURN TypeAnalysisHandoff{ typed_program: typed_program, audit_request: COPY typeAnalysisSession__release_capability_audit_request_mut(&rtoc_self_view) };
}
END
PUB FN typeAnalysisSession__validate_copy_linear_resource_facts_mut(self: TypeAnalysisSession, program: Program, facts: LinearResourceFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    aST__each_locatable(Locatable{ Program: COPY program }, TRUE, %(node: Locatable) USE(facts, rtoc_self_view) -> {
    IF !(node IS_A CopyNode) THEN
        RETURN;
    END
    MUTABLE type_info = node.value().full_type_mut("post-annotation COPY resource validation");
    IF TRY (linearResourceFacts__contains?(facts, type_info)) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :COPY_NON_COPYABLE }, [], {:type: CAST(type_info AS String)});
    END
    rubyToClearVoid()
    });
    FOR _ IN rtoc_self_view.traversal_state.deferred_copy_wrapper_bindings DO
    typeAnalysisSession__reject_implicit_wrapper_binding_mut(rtoc_self_view, _, TRUE);
    END
}
END
PUB FN typeAnalysisSession__imported_kept_params(self: TypeAnalysisSession, fn_nodes: {String}FunctionDef) RETURNS !{String}[]Param
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE out: {String}[]Param = {};
    ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_7 = typeAnalysisSession__semantic_root_scope(rtoc_self_view);
    TRY (scope__visible_entries(rtoc_local_receiver_7)) }).keys() |> EACH {
    MUTABLE entry: SymbolEntry@multiowned = (({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_7 = typeAnalysisSession__semantic_root_scope(rtoc_self_view);
    TRY (scope__visible_entries(rtoc_local_receiver_7)) })[_] OR_ELSE CAST(panic("missing hash key") AS SymbolEntry@multiowned));
    MUTABLE key = COPY _;
    IF fn_nodes.contains?(key) THEN
        CONTINUE;
    END
    MUTABLE signature: ?FunctionSignature@multiowned = symbolEntry__fn_signature(entry);
    IF !(signature) THEN
        CONTINUE;
    END
    MUTABLE params = TRY (functionSignature__params(signature));
    IF !(params |> ANY (IF _.symbol != NIL THEN
        symbolEntry__kept_identity(_.symbol)
      ELSE
        NIL
      END)) THEN
        CONTINUE;
    END
    out[key] = params;
    };
    RETURN out;
}
END
PUB FN typeAnalysisSession__apply_keep_analysis_mut(self: TypeAnalysisSession, resolution: ResolutionFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fn_nodes = COPY resolution.function_registry.nodes;
    MUTABLE body_summaries = COPY resolution.function_registry.body_summaries;
    keepAnalysis__propagate_kept_identity_mut(fn_nodes, body_summaries);
    TRY (escapeAnalysis__apply_kept_identity_placement_mut(fn_nodes, body_summaries, %(entry, arg, callee_name) USE(body_summaries, fn_nodes, rtoc_self_view) -> {
    MUTABLE sink = (((symbolEntry__kept_identity(entry)?.sink OR_ELSE ((IF (IF fn_nodes[callee_name] != NIL THEN
        ((fn_nodes[callee_name]).params) |> FIND (IF aST__node__symbol(_) != NIL THEN
        { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_8 = (aST__node__symbol(_));
    symbolEntry__kept_identity(rtoc_local_receiver_8) }
      ELSE
        NIL
      END)
      ELSE
        NIL
      END) != NIL THEN
        { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_9 = ((IF fn_nodes[callee_name] != NIL THEN
        ((fn_nodes[callee_name]).params) |> FIND (IF aST__node__symbol(_) != NIL THEN
        { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_8 = (aST__node__symbol(_));
    symbolEntry__kept_identity(rtoc_local_receiver_8) }
      ELSE
        NIL
      END)
      ELSE
        NIL
      END)).symbol();
    symbolEntry__kept_identity(rtoc_local_receiver_9) }
      ELSE
        NIL
      END)?.sink))) OR "an @multiowned destination");
    MUTABLE anchor = (typeAnalysisSession__kept_identity_declaration_anchor(rtoc_self_view, body_summaries, entry) OR_ELSE arg);
    typeAnalysisSession__error_mut(rtoc_self_view, anchor, TypeAnalysisCodeOrMessage{ SymbolValue: :KEPT_IDENTITY_NEEDS_MODEL }, [], {:name: arg.name(), :keeper: callee_name, :sink: sink})
    }, %(arg, source_family, dest_family, callee_name) USE(fn_nodes, rtoc_self_view) -> {
    MUTABLE sink: String = "an @${dest_family} destination";
    IF (IF (IF fn_nodes[callee_name] != NIL THEN
        ((fn_nodes[callee_name]).params) |> FIND (IF aST__node__symbol(_) != NIL THEN
        { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_10 = (aST__node__symbol(_));
    symbolEntry__kept_identity(rtoc_local_receiver_10) }
      ELSE
        NIL
      END)
      ELSE
        NIL
      END) != NIL THEN
        { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_11 = ((IF fn_nodes[callee_name] != NIL THEN
        ((fn_nodes[callee_name]).params) |> FIND (IF aST__node__symbol(_) != NIL THEN
        { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_10 = (aST__node__symbol(_));
    symbolEntry__kept_identity(rtoc_local_receiver_10) }
      ELSE
        NIL
      END)
      ELSE
        NIL
      END)).symbol();
    symbolEntry__kept_identity(rtoc_local_receiver_11) }
      ELSE
        NIL
      END) != NIL THEN
        sink = (((IF (IF fn_nodes[callee_name] != NIL THEN
        ((fn_nodes[callee_name]).params) |> FIND (IF aST__node__symbol(_) != NIL THEN
        { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_10 = (aST__node__symbol(_));
    symbolEntry__kept_identity(rtoc_local_receiver_10) }
      ELSE
        NIL
      END)
      ELSE
        NIL
      END) != NIL THEN
        { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_11 = ((IF fn_nodes[callee_name] != NIL THEN
        ((fn_nodes[callee_name]).params) |> FIND (IF aST__node__symbol(_) != NIL THEN
        { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_10 = (aST__node__symbol(_));
    symbolEntry__kept_identity(rtoc_local_receiver_10) }
      ELSE
        NIL
      END)
      ELSE
        NIL
      END)).symbol();
    symbolEntry__kept_identity(rtoc_local_receiver_11) }
      ELSE
        NIL
      END))?).sink;
      END
    MUTABLE name: String = "";
      IF arg IS_A Identifier THEN
        name = arg.name();
      ELSE
        name = "the argument";
      END
    typeAnalysisSession__error_mut(rtoc_self_view, arg, TypeAnalysisCodeOrMessage{ SymbolValue: :KEPT_IDENTITY_FAMILY_MISMATCH }, [], {:name: name, :keeper: callee_name, :sink: sink, :source_family: source_family, :dest_family: dest_family})
    }, TRY (typeAnalysisSession__imported_kept_params(rtoc_self_view, fn_nodes))));
    typeAnalysisSession__reject_kept_function_values_mut(rtoc_self_view, resolution, fn_nodes);
}
END
PUB FN typeAnalysisSession__reject_kept_function_values_mut(self: TypeAnalysisSession, resolution: ResolutionFacts, fn_nodes: {String}FunctionDef) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE kept_fns = fn_nodes.each_with_object({}, %(tuple_param_0, map: Tuple<String,FunctionDef>) -> {
    MUTABLE name = tuple_param_0._0;
    MUTABLE fn = tuple_param_0._1;
    MUTABLE kept_param = fn.params() |> FIND (IF aST__node__symbol(_) != NIL THEN
        { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_12 = (aST__node__symbol(_));
    symbolEntry__kept_identity(rtoc_local_receiver_12) }
      ELSE
        NIL
      END);
    IF kept_param THEN
      map[name] = kept_param;
      RETURN NIL;
    END
    NIL
    });
    IF kept_fns.empty?() THEN
      RETURN;
    END
    FOR _ IN fn_nodes.values() DO
    FOR _ IN _.body DO
    typeAnalysisSession__scan_kept_fn_value_use_mut(rtoc_self_view, _, kept_fns);
    END
    END
    MUTABLE rtoc_each_items_13 = ((KEEP resolution.program).statements);
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_13.length() DO
      IF rtoc_each_items_13[rtoc_idx] IS_A FunctionDef THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      typeAnalysisSession__scan_kept_fn_value_use_mut(rtoc_self_view, rtoc_each_items_13[rtoc_idx], kept_fns);
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PUB FN typeAnalysisSession__scan_kept_fn_value_use_mut(self: TypeAnalysisSession, node: Locatable, kept_fns: {String}Param) RETURNS Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (IF node IS_A Identifier AS identifier THEN kept_fns.contains?(identifier__name(identifier)) ELSE FALSE END) THEN
      MUTABLE sym = aST__node__symbol(node);
      MUTABLE shadowed = (((sym IS_A SymbolEntry@multiowned AND ((functionSignature__unwrap(sym.type())) == NIL)) AND !((sym.type() == NIL))) AND (sym.type().resolved() != :Any));
      IF !(shadowed) THEN
        MUTABLE param = COPY UNWRAP (kept_fns[node.name()]);
        MUTABLE contract = UNWRAP ((IF param.symbol != NIL THEN
          symbolEntry__kept_identity(param.symbol)
        ELSE
          NIL
        END));
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :KEPT_FN_VALUE_ABI }, [], {:name: node.name(), :param: param.name, :sink: contract.sink, :fn_type: "FN(...)"});
      END
    END
    aST__each_child_node(node, %(child: Locatable) USE(kept_fns, rtoc_self_view) -> {
    typeAnalysisSession__scan_kept_fn_value_use_mut(rtoc_self_view, child, kept_fns);
    rubyToClearVoid()
    });
}
END
PUB FN typeAnalysisSession__kept_identity_declaration_anchor(self: TypeAnalysisSession, body_summaries: {String}Any, entry: SymbolEntry) RETURNS ?Locatable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    FOR rtoc_each_item_14 IN body_summaries.values() DO
    MUTABLE decl = rtoc_each_item_14.binding_nodes() |> FIND (TRUE AND aST__node__symbol(_).equal?(entry));
    IF decl THEN
        RETURN decl;
    END
    END
    RETURN NIL;
}
END
PUB FN typeAnalysisSession__language_mode(self: TypeAnalysisSession) RETURNS String@symbol
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (KEEP rtoc_self_view.resolution.program).language_mode;
}
END
PUB FN typeAnalysisSession__analyze_resolution_mut(MUTABLE self: TypeAnalysisSession, resolution: ResolutionFacts) RETURNS OwnershipGraph@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__adopt_resolution_facts_mut(&rtoc_self_view, resolution);
    typeAnalysisSession__validate_conformances_mut(rtoc_self_view, resolution.conformance_resolutions);
    typeAnalysisSession__bridge_reentrance_mut(rtoc_self_view, CAST(COPY KEEP resolution.program AS Program));
    typeAnalysisSession__validate_and_resolve_sync_policy_mut(rtoc_self_view, CAST(COPY KEEP resolution.program AS Program));
    typeAnalysisSession__seed_error_type_registrations_mut(rtoc_self_view, resolution.declarations);
    typeAnalysisSession__analyze_program_bodies_mut(&rtoc_self_view, resolution.declarations, CAST(COPY KEEP resolution.program AS Program));
    typeAnalysisSession__resolve_catch_clauses_from_declarations_mut(&rtoc_self_view, resolution.declarations);
    typeAnalysisSession__finalize_program_type_mut(rtoc_self_view, CAST(COPY KEEP resolution.program AS Program));
    typeAnalysisSession__finalize_auto_types_mut(rtoc_self_view, CAST(COPY KEEP resolution.program AS Program));
    RETURN typeAnalysisSession__ownership_graph(rtoc_self_view);
}
END
PUB FN typeAnalysisSession__release_capability_audit_inputs_mut(MUTABLE self: TypeAnalysisSession) RETURNS CapabilityAuditInputs
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE inputs = COPY rtoc_self_view.audit_inputs;
    rtoc_self_view.audit_inputs = CapabilityAuditInputs{ held_locks: {}, held_lock_types: List[], current_predicate_context: NIL, deferred_with_validations: List[], deferred_recovery_validations: List[], deferred_give_validations: List[], deferred_copy_retained_validations: List[], predicate_call_sites: List[], async_body_facts: List[], capability_audit: {}, capture_stack: List[], capture_move_suppression_depth: 0, snapshot_txn_frames: List[], effect_state: NIL, lock_analysis: LockAnalysisState{ direct_edges: {}, direct_acquires: {}, held_calls: {}, clause_sites: List[], type_ranks: {} }, ownership_graph: ownershipGraph__new(), ownership_transport_frames: List[] };
    RETURN inputs;
}
END
PUB FN typeAnalysisSession__release_capability_audit_request_mut(MUTABLE self: TypeAnalysisSession) RETURNS CapabilityAuditRequest
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN CapabilityAuditRequest{ inputs: COPY typeAnalysisSession__release_capability_audit_inputs_mut(&rtoc_self_view), source_code: COPY rtoc_self_view.config.source_code, language_mode: COPY typeAnalysisSession__language_mode(rtoc_self_view), strict_test: typeAnalysisSession__strict_test?(rtoc_self_view) };
}
END
PRIVATE FN typeAnalysisSession__reset_compilation_state_mut(MUTABLE self: TypeAnalysisSession) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.traversal_state = TraversalState{ scopes: [scope__new()], function_contexts: List[], loop_depth: 0, conditional_depth: 0, smooth_depth: 0, body_fact_frames: List[], stream_yield_frames: List[], with_block_depth: 0, match_pattern_depth: 0, current_bg_pinned: FALSE, pipeline_accessed_fields: NIL, auto_locked_assign_name: NIL, struct_literal_call_argument_depth: 0, annotation_ancestors: List[], comptime_type_param_refinements: {}, value_type_refinements: {}, branch_terminated: FALSE, next_synthetic_body_ordinal: -1, deferred_copy_wrapper_bindings: List[] };
    rtoc_self_view.audit_inputs = CapabilityAuditInputs{ held_locks: {}, held_lock_types: List[], current_predicate_context: NIL, deferred_with_validations: List[], deferred_recovery_validations: List[], deferred_give_validations: List[], deferred_copy_retained_validations: List[], predicate_call_sites: List[], async_body_facts: List[], capability_audit: {}, capture_stack: List[], capture_move_suppression_depth: 0, snapshot_txn_frames: List[], effect_state: NIL, lock_analysis: LockAnalysisState{ direct_edges: {}, direct_acquires: {}, held_calls: {}, clause_sites: List[], type_ranks: {} }, ownership_graph: ownershipGraph__new(), ownership_transport_frames: List[] };
    rtoc_self_view.resolution = resolutionFacts__empty();
    rtoc_self_view.traversal_state.scopes = [KEEP rtoc_self_view.resolution.root_scope];
    typeAnalysisSession__effects_init_mut(rtoc_self_view);
    typeAnalysisSession__capability_audit_init_mut(rtoc_self_view);
}
END
PRIVATE FN typeAnalysisSession__adopt_resolution_facts_mut(MUTABLE self: TypeAnalysisSession, resolution: ResolutionFacts) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.resolution = COPY resolution;
    rtoc_self_view.traversal_state.scopes = [KEEP resolution.root_scope];
}
END
