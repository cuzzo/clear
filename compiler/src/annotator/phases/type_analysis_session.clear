  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY rtoc_self_view.audit_inputs.deferred_copy_retained_validations;
}
END
PUB FN typeAnalysisSession__current_fn_ctx(self: TypeAnalysisSession) RETURNS ?FunctionContext@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN KEEP rtoc_self_view.traversal_state.function_contexts.last();
}
END
PUB FN typeAnalysisSession__current_fn_ctx_mut(self: TypeAnalysisSession) RETURNS FunctionContext@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN UNWRAP (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
}
END
PUB FN typeAnalysisSession__current_function_type_params(self: TypeAnalysisSession) RETURNS ![]String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE ctx: ?FunctionContext@multiowned = typeAnalysisSession__current_fn_ctx(rtoc_self_view);
    IF ctx EXISTS AS ctx_value THEN
      RETURN COPY ctx_value.type_params;
    ELSE
      RETURN CAST(( { MUTABLE rtoc_empty_list_1: []String@symbol = List[]; rtoc_empty_list_1 } ) AS []String@symbol);
    END
}
END
PUB FN typeAnalysisSession__current_function_generic_params(self: TypeAnalysisSession) RETURNS ![]GenericParamDecl
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF typeAnalysisSession__current_fn_ctx(rtoc_self_view)?.generic_params != NIL THEN
    RETURN COPY (typeAnalysisSession__current_fn_ctx(rtoc_self_view)?.generic_params)?;
    ELSE
    RETURN CAST(( { MUTABLE rtoc_empty_list_2: []GenericParamDecl = List[]; rtoc_empty_list_2 } ) AS []GenericParamDecl);
    END
}
END
PUB FN typeAnalysisSession__current_function_type_param?(self: TypeAnalysisSession, type_name: ?String@symbol) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF type_name EXISTS AS type_name_value THEN
      RETURN (TRY (typeAnalysisSession__current_function_type_params(rtoc_self_view))).contains?(type_name_value);
    ELSE
      RETURN FALSE;
    END
}
END
PUB FN typeAnalysisSession__refined_comptime_type_param_type(self: TypeAnalysisSession, type: Type) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE type_name = type__resolved(type);
    IF !(TRY (typeAnalysisSession__current_function_type_param?(rtoc_self_view, type_name))) THEN
      RETURN COPY type;
    END
    IF rtoc_self_view.traversal_state.comptime_type_param_refinements[type_name] != NIL THEN
    RETURN COPY (rtoc_self_view.traversal_state.comptime_type_param_refinements[type_name])?;
    ELSE
    RETURN COPY type;
    END
}
END
PUB FN typeAnalysisSession__with_comptime_type_param_refinement<Result>(MUTABLE self: TypeAnalysisSession, type_param: String@symbol, narrowed_type: Type, blk: FN() -> Result) RETURNS !Result
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE previous = COPY rtoc_self_view.traversal_state.comptime_type_param_refinements;
  DEFER rtoc_self_view.traversal_state.comptime_type_param_refinements = previous;
  rtoc_self_view.traversal_state.comptime_type_param_refinements = {type_param: TRY (type__new(castTypeToTypeConstructionInput(narrowed_type)))}.keys() |> REDUCE(COPY previous) { acc[_] = COPY ({type_param: TRY (type__new(castTypeToTypeConstructionInput(narrowed_type)))}[_] OR_ELSE panic("missing hash key")); acc };
  RETURN blk();
}
END
PUB FN typeAnalysisSession__with_value_type_refinements<Result>(MUTABLE self: TypeAnalysisSession, refinements: {Int64}Type, blk: FN() -> Result) RETURNS Result
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE previous = COPY rtoc_self_view.traversal_state.value_type_refinements;
  DEFER rtoc_self_view.traversal_state.value_type_refinements = previous;
  rtoc_self_view.traversal_state.value_type_refinements = refinements.keys() |> REDUCE(COPY previous) { acc[_] = COPY (refinements[_] OR_ELSE CAST(panic("missing hash key") AS Type)); acc };
  RETURN blk();
}
END
PUB FN typeAnalysisSession__push_function_context_mut(self: TypeAnalysisSession, ctx: FunctionContext) RETURNS FunctionContext@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    &rtoc_self_view.traversal_state.function_contexts.append(ctx);
    MUTABLE rtoc_owned_return_3: FunctionContext@multiowned = ctx;
    RETURN rtoc_owned_return_3;
}
END
PUB FN typeAnalysisSession__pop_function_context_mut(self: TypeAnalysisSession) RETURNS ?FunctionContext@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN &rtoc_self_view.traversal_state.function_contexts.pop();
}
END
PUB FN typeAnalysisSession__stamp_type_mut<Stamp>(self: TypeAnalysisSession, MUTABLE node: Locatable, value: Stamp) RETURNS !Stamp
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (value == NIL) THEN
      panic("annotation stamp missing type for {}");
    END
    node.full_type = COPY CAST(value AS SyntheticTypeInput);
    MUTABLE stamped = &node.full_type_mut("annotation stamp");
    IF type__untyped?(stamped) THEN
      panic("annotation stamp produced :Untyped for {}");
    END
    RETURN COPY value;
}
END
PUB FN typeAnalysisSession__record_snapshot_txn_violation_mut(self: TypeAnalysisSession, effect: String@symbol, fn_name: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE frame: ?SnapshotTxnFrame = COPY rtoc_self_view.audit_inputs.snapshot_txn_frames.last();
    IF frame EXISTS AS frame_value THEN
      &frame_value.violations.append(COPY SnapshotTxnViolation{ effect: COPY effect, fn: COPY fn_name });
    ELSE
      RETURN;
    END
}
END
PUB FN typeAnalysisSession__inside_snapshot_transaction_body?(self: TypeAnalysisSession) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN !((rtoc_self_view.audit_inputs.snapshot_txn_frames.length() == 0));
}
END
PUB FN typeAnalysisSession__with_conditional_context<Result>(self: TypeAnalysisSession, blk: FN() -> Result) RETURNS Result
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
  MUTABLE fn_ctx: ?FunctionContext@multiowned = typeAnalysisSession__current_fn_ctx(rtoc_self_view);
  DEFER typeAnalysisSession__leave_conditional_context_mut(rtoc_self_view, &fn_ctx);
  typeAnalysisSession__enter_conditional_context_mut(rtoc_self_view, &fn_ctx);
  RETURN blk();
}
END
PUB FN typeAnalysisSession__enter_conditional_context_mut(self: TypeAnalysisSession, MUTABLE fn_ctx: ?FunctionContext) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF fn_ctx EXISTS AS fn_ctx_value THEN
      MUTABLE fn_ctx_value_mutable = COPY fn_ctx_value;
      functionContext__enter_conditional_mut(&fn_ctx_value_mutable);
    ELSE
      rtoc_self_view.traversal_state.conditional_depth=((rtoc_self_view.traversal_state.conditional_depth() + 1));
    END
}
END
PUB FN typeAnalysisSession__leave_conditional_context_mut(self: TypeAnalysisSession, MUTABLE fn_ctx: ?FunctionContext) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF fn_ctx EXISTS AS fn_ctx_value THEN
      MUTABLE fn_ctx_value_mutable = COPY fn_ctx_value;
      functionContext__exit_conditional_mut(&fn_ctx_value_mutable);
    ELSE
      rtoc_self_view.traversal_state.conditional_depth=((rtoc_self_view.traversal_state.conditional_depth() - 1));
    END
}
END
PUB FN typeAnalysisSession__with_loop_context<Result>(self: TypeAnalysisSession, blk: FN() -> Result) RETURNS Result
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
  MUTABLE fn_ctx: ?FunctionContext@multiowned = typeAnalysisSession__current_fn_ctx(rtoc_self_view);
  DEFER typeAnalysisSession__leave_loop_context_mut(rtoc_self_view, &fn_ctx);
  typeAnalysisSession__enter_loop_context_mut(rtoc_self_view, &fn_ctx);
  RETURN blk();
}
END
PUB FN typeAnalysisSession__enter_loop_context_mut(self: TypeAnalysisSession, MUTABLE fn_ctx: ?FunctionContext) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF fn_ctx EXISTS AS fn_ctx_value THEN
      MUTABLE fn_ctx_value_mutable = COPY fn_ctx_value;
      functionContext__enter_loop_mut(&fn_ctx_value_mutable);
    ELSE
      rtoc_self_view.traversal_state.loop_depth=((rtoc_self_view.traversal_state.loop_depth() + 1));
    END
}
END
PUB FN typeAnalysisSession__leave_loop_context_mut(self: TypeAnalysisSession, MUTABLE fn_ctx: ?FunctionContext) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF fn_ctx EXISTS AS fn_ctx_value THEN
      MUTABLE fn_ctx_value_mutable = COPY fn_ctx_value;
      functionContext__exit_loop_mut(&fn_ctx_value_mutable);
    ELSE
      rtoc_self_view.traversal_state.loop_depth=((rtoc_self_view.traversal_state.loop_depth() - 1));
    END
}
END
PUB FN typeAnalysisSession__analyze_loop_control_flow_branches(self: TypeAnalysisSession, branches: FN() -> []Any, merge_to_parent: Bool) RETURNS ![]Any@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN typeAnalysisSession__with_loop_context(rtoc_self_view, %() USE(branches, merge_to_parent, rtoc_self_view) -> typeAnalysisSession__analyze_control_flow_branches(rtoc_self_view, branches, merge_to_parent));
}
END
PUB FN typeAnalysisSession__with_smooth_context<Result>(self: TypeAnalysisSession, blk: FN() -> Result) RETURNS Result
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
  DEFER rtoc_self_view.traversal_state.smooth_depth=((rtoc_self_view.traversal_state.smooth_depth() - 1));
  rtoc_self_view.traversal_state.smooth_depth=((rtoc_self_view.traversal_state.smooth_depth() + 1));
  RETURN blk();
}
END
PUB FN typeAnalysisSession__smooth_depth(self: TypeAnalysisSession) RETURNS Int64
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN rtoc_self_view.traversal_state.smooth_depth;
}
END
PUB FN typeAnalysisSession__current_loop_depth(self: TypeAnalysisSession) RETURNS Int64
  REQUIRES self: LOCAL
->
