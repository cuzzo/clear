PRIVATE FN typeAnalysisSession__visit_StubDecl(MUTABLE self: TypeAnalysisSession, MUTABLE node: StubDecl) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node.value IS_A Locatable THEN
      TRY (typeAnalysisSession__visit(&rtoc_self_view, node.value));
    END
    IF (node.kind == :captures) THEN
      MUTABLE cap_name = node.value;
      MUTABLE rtoc_mutable_receiver_254 = typeAnalysisSession__current_scope(rtoc_self_view);
      TRY (scope__declare(&rtoc_mutable_receiver_254, cap_name, SymbolEntryRegInput{ StubDecl: COPY node }, SymbolEntryTypeInput{ SymbolValue: :Int64 }, ScopeMutabilityInput{ BoolValue: TRUE }, FALSE, NIL, :stack));
      typeAnalysisSession__og_declare(rtoc_self_view, cap_name, Node{ StubDecl: COPY node }, TypeTypeInput{ SymbolValue: :Int64 });
    END
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ StubDecl: COPY node }, :Void));
}
END
PRIVATE FN typeAnalysisSession__validate_strict_io_mut(self: TypeAnalysisSession, test_that: TestThat, stubbed_fns: [Set]String, body_summary: BodyScanSummary) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE calls = COPY body_summary.callees;
    MUTABLE visited = Set[];
    MUTABLE queue = COPY (calls |> SELECT COPY _);
    WHILE !(queue.empty?()) DO
      MUTABLE name = &queue.shift();
      IF visited.contains?(name) THEN
        CONTINUE;
      END
      &visited.insert(name);
      IF stubbed_fns.contains?(name) THEN
        CONTINUE;
      END
      IF ((["tcpRead", "tcpWrite", "accept", "connect", "readFile", "writeFile", "readLine", "readLinePrompt", "listDir", "listAll", "fileSize", "socketRead", "socketWrite", "socketClose"]) |> DISTINCT _).contains?(name) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, test_that, TypeAnalysisCodeOrMessage{ SymbolValue: :STRICT_TEST_NEEDS_STUB }, [], {:name: name});
        CONTINUE;
      END
      MUTABLE fn_nodes = TRY (typeAnalysisSession__function_node_map(rtoc_self_view));
      MUTABLE fn: ?FunctionDef@multiowned = COPY fn_nodes[name];
      IF fn?.effects THEN
        MUTABLE has_io = (fn.effects.contains?(:BLOCKING) OR fn.effects.contains?(symbol("EXTERN")));
        IF has_io THEN
          typeAnalysisSession__error_mut(rtoc_self_view, test_that, TypeAnalysisCodeOrMessage{ SymbolValue: :STRICT_TEST_HAS_IO_EFFECTS }, [], {:name: name, :effects: (TRY (effectSet__to_a(fn.effects))).join(", ")});
        END
      END
      FOR _ IN ((typeAnalysisSession__function_call_graph(rtoc_self_view)[name] OR_ELSE List[])) DO
      &queue.append(COPY _);
      END
    END
}
END
PRIVATE FN typeAnalysisSession__finalize_auto_types_mut(self: TypeAnalysisSession, program: Program) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    TRY (typeAnalysisSession__run_auto_inference_mut(rtoc_self_view, program));
}
END
PRIVATE FN typeAnalysisSession__apply_auto_resolution_stamps_mut(self: TypeAnalysisSession, program: Program, resolved_slots: {AutoSlotId}Resolution) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE touched_functions: [Set]FunctionDef@multiowned = typeAnalysisSession__restamp_auto_resolution_slots_mut(rtoc_self_view, resolved_slots);
    FOR _ IN touched_functions DO
    typeAnalysisSession__restamp_auto_function_signature_mut(rtoc_self_view, _);
    END
    typeAnalysisSession__restamp_stale_auto_nodes_mut(rtoc_self_view, program);
}
END
PRIVATE FN typeAnalysisSession__restamp_auto_resolution_slots_mut(self: TypeAnalysisSession, resolved_slots: {AutoSlotId}Resolution) RETURNS ![Set]FunctionDef
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE touched_functions: [Set]FunctionDef = Set[];
    FOR _ IN resolved_slots.values() DO
    MUTABLE slot = COPY _.slot;
    IF (slot.kind == :param) THEN
        typeAnalysisSession__restamp_auto_param_mut(rtoc_self_view, slot, _.type);
        &touched_functions.insert(COPY CAST(slot.decl_node AS FunctionDef));
    ELSE_IF (slot.kind == :return) THEN
        typeAnalysisSession__restamp_auto_return_mut(rtoc_self_view, slot, _.type);
        &touched_functions.insert(COPY CAST(slot.decl_node AS FunctionDef));
    ELSE_IF (slot.kind == :local) OR (slot.kind == :list_element) OR (slot.kind == :map_key) OR (slot.kind == :map_value) THEN
        typeAnalysisSession__restamp_auto_local_mut(rtoc_self_view, slot);
    END
    END
    RETURN touched_functions;
}
END
PRIVATE FN typeAnalysisSession__restamp_auto_param_mut(self: TypeAnalysisSession, slot: Slot, type: AutoConstraintCollectorObservedType) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fn: FunctionDef = COPY CAST(slot.decl_node AS FunctionDef);
    MUTABLE param = COPY UNWRAP (fn.params[UNWRAP (slot.index)]);
    MUTABLE concrete = TRY (type__new(castAutoConstraintCollectorObservedTypeToTypeConstructionInput(type)));
    param.type = concrete;
    IF param.symbol EXISTS AS symbol_value THEN
      MUTABLE symbol_value_mutable = COPY symbol_value;
      TRY (symbolEntry__set_type(&symbol_value_mutable, castTypeToOptionalSymbolEntryTypeInput(TRY (type__new(castTypeToTypeConstructionInput(concrete))))));
    END
}
END
PRIVATE FN typeAnalysisSession__restamp_auto_return_mut(self: TypeAnalysisSession, slot: Slot, type: AutoConstraintCollectorObservedType) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fn: FunctionDef = COPY CAST(slot.decl_node AS FunctionDef);
    MUTABLE concrete = TRY (type__new(castAutoConstraintCollectorObservedTypeToTypeConstructionInput(type)));
    fn.return_type = concrete;
}
END
PRIVATE FN typeAnalysisSession__restamp_auto_local_mut(self: TypeAnalysisSession, slot: Slot) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE decl: AutoConstraintCollectorDeclarationNode = COPY castAutoConstraintCollectorSlotDeclNodeToAutoConstraintCollectorDeclarationNode(slot.decl_node);
    MUTABLE concrete = TRY (type__new(castTypeToTypeConstructionInput(castTypeToType((MATCH decl START AutoConstraintCollectorDeclarationNode.VarDecl AS item -> item.type, AutoConstraintCollectorDeclarationNode.BindExpr AS item -> item.type END)))));
    MATCH decl START
      AutoConstraintCollectorDeclarationNode.VarDecl AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.type = concrete;
        decl = AutoConstraintCollectorDeclarationNode{ VarDecl: item_mutable };,
      AutoConstraintCollectorDeclarationNode.BindExpr AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.type = concrete;
        decl = AutoConstraintCollectorDeclarationNode{ BindExpr: item_mutable };,
    END
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, castAutoConstraintCollectorDeclarationNodeToLocatable(decl), concrete));
    MUTABLE symbol: ?SymbolEntry = NIL;
    MATCH decl START
      AutoConstraintCollectorDeclarationNode.VarDecl AS item ->
        symbol = COPY item.symbol;,
      AutoConstraintCollectorDeclarationNode.BindExpr AS item ->
        symbol = COPY item.symbol;,
    END
    IF symbol EXISTS AS symbol_value THEN
      MUTABLE symbol_value_mutable = COPY symbol_value;
      TRY (symbolEntry__set_type(&symbol_value_mutable, castTypeToOptionalSymbolEntryTypeInput(TRY (type__new(castTypeToTypeConstructionInput(concrete))))));
      symbolEntry__set_sync(&symbol_value_mutable, type__sync(concrete));
      symbolEntry__set_layout(&symbol_value_mutable, type__layout(concrete));
    END
    MUTABLE value: Any = NIL;
    MATCH decl START
      AutoConstraintCollectorDeclarationNode.VarDecl AS item ->
        value = COPY item.value;,
      AutoConstraintCollectorDeclarationNode.BindExpr AS item ->
        value = COPY item.value;,
    END
    IF !(value) THEN
      RETURN;
    END
    MUTABLE current_value_type = typeAnalysisSession__auto_finalization_node_type(rtoc_self_view, &value);
    IF !((((slot.shape != NIL) OR type__auto?(current_value_type)) OR type__untyped?(current_value_type))) THEN
      RETURN;
    END
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &value, concrete));
    value.coerced_type = concrete;
}
END
PRIVATE FN typeAnalysisSession__restamp_auto_function_signature_mut(self: TypeAnalysisSession, MUTABLE fn_value: FunctionDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE signature = TRY (functionSignature__new(fn_value.params, castOptionalTypeToOptionalTypeTypeInput(fn_value.return_type), FunctionSignatureLifetimeInput{ ArrayValue: typeAnalysisSession__get_lifetime_paths(rtoc_self_view, fn_value) |> SELECT castLifetimesReturnValueItemToFunctionSignatureLifetimeSource(_) }, fn_value.visibility, fn_value.type_params |> SELECT symbol(_), {}, functionDef__declared_plain_reentrant?(fn_value), FALSE, NIL, NIL, NIL, ( { MUTABLE rtoc_empty_list_255: []String@symbol = List[]; rtoc_empty_list_255 } ), NIL, ( { MUTABLE rtoc_empty_list_256: []String@symbol = List[]; rtoc_empty_list_256 } )));
    TRY (functionSignature__sync_from_function_def_mut(&signature, FunctionSignatureSyncSource{ FunctionDefMultiowned: COPY fn_value }));
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ FunctionDef: COPY fn_value }, signature));
    MUTABLE entry: ?SymbolEntry@multiowned = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_257 = typeAnalysisSession__semantic_root_scope(rtoc_self_view);
    scope__local_entry(rtoc_local_receiver_257, fn_value.name) };
    IF entry EXISTS AS entry_value THEN
      MUTABLE entry_value_mutable = COPY entry_value;
      TRY (symbolEntry__set_type(&entry_value_mutable, castTypeToOptionalSymbolEntryTypeInput(TRY (type__from_function_signature(signature)))));
    END
}
END
PRIVATE FN typeAnalysisSession__restamp_stale_auto_nodes_mut(self: TypeAnalysisSession, program: Program) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE nodes: []Locatable = ( { MUTABLE rtoc_empty_list_258: []Locatable = List[]; rtoc_empty_list_258 } );
    aST__each_locatable(Locatable{ Program: COPY program }, TRUE, %(node: Locatable) USE(MUTABLE nodes) -> {
    &nodes.append(COPY node);
    rubyToClearVoid()
    });
    MUTABLE rtoc_reverse_items_259: []Locatable = nodes;
    MUTABLE rtoc_reverse_i_260 = rtoc_reverse_items_259.length() - 1;
    WHILE rtoc_reverse_i_260 >= 0 DO
      IF typeAnalysisSession__restamp_binary_type_after_auto_mut(rtoc_self_view, (rtoc_reverse_items_259[rtoc_reverse_i_260])?) THEN
        rtoc_reverse_i_260 = rtoc_reverse_i_260 - 1;
    CONTINUE;
      END
      IF !(typeAnalysisSession__stale_auto_node_type?(rtoc_self_view, CAST(typeAnalysisSession__auto_finalization_node_type(rtoc_self_view, (rtoc_reverse_items_259[rtoc_reverse_i_260])?) AS Type))) THEN
          rtoc_reverse_i_260 = rtoc_reverse_i_260 - 1;
    CONTINUE;
      END
      MUTABLE symbol_type: ?Type@multiowned = typeAnalysisSession__concrete_symbol_type_for(rtoc_self_view, (rtoc_reverse_items_259[rtoc_reverse_i_260])?);
      IF symbol_type EXISTS AS symbol_type_value THEN
          MUTABLE symbol_type_value_mutable = COPY symbol_type_value;
          TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, (rtoc_reverse_items_259[rtoc_reverse_i_260])?, symbol_type_value_mutable));
          rtoc_reverse_i_260 = rtoc_reverse_i_260 - 1;
    CONTINUE;
      END
      MUTABLE call_type: ?Type@multiowned = typeAnalysisSession__concrete_function_call_type_for(rtoc_self_view, (rtoc_reverse_items_259[rtoc_reverse_i_260])?);
      IF call_type EXISTS AS call_type_value THEN
          MUTABLE call_type_value_mutable = COPY call_type_value;
          TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, (rtoc_reverse_items_259[rtoc_reverse_i_260])?, call_type_value_mutable));
          rtoc_reverse_i_260 = rtoc_reverse_i_260 - 1;
    CONTINUE;
      END
      MUTABLE program_type: ?Type@multiowned = typeAnalysisSession__concrete_program_type_for(rtoc_self_view, (rtoc_reverse_items_259[rtoc_reverse_i_260])?);
      IF program_type EXISTS AS program_type_value THEN
          MUTABLE program_type_value_mutable = COPY program_type_value;
          TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, (rtoc_reverse_items_259[rtoc_reverse_i_260])?, program_type_value_mutable));
      END
    rtoc_reverse_i_260 = rtoc_reverse_i_260 - 1;
    END
}
END
PRIVATE FN typeAnalysisSession__auto_finalization_node_type(self: TypeAnalysisSession, MUTABLE node: Locatable) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(node.typed?()) THEN
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :Untyped }));
    END
    RETURN &node.full_type_mut("auto finalization node");
}
END
PRIVATE FN typeAnalysisSession__stale_auto_node_type?(self: TypeAnalysisSession, type: Type) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (type__untyped?(type) OR type__auto?(type));
}
END
PRIVATE FN typeAnalysisSession__concrete_symbol_type_for(self: TypeAnalysisSession, node: Locatable) RETURNS !?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE symbol = aST__node__symbol(node);
    IF !(symbol) THEN
      RETURN NIL;
    END
    MUTABLE symbol_type = symbol.type();
    IF typeAnalysisSession__stale_auto_node_type?(rtoc_self_view, symbol_type) THEN
      RETURN NIL;
    END
    RETURN TRY (type__new(symbol_type));
}
END
PRIVATE FN typeAnalysisSession__concrete_function_call_type_for(self: TypeAnalysisSession, node: Locatable) RETURNS !?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A FuncCall AS func_call THEN
      MUTABLE entry: ?SymbolEntry@multiowned = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_261 = typeAnalysisSession__semantic_root_scope(rtoc_self_view);
      scope__resolve_entry(rtoc_local_receiver_261, funcCall__name(func_call)) };
      MUTABLE signature: ?FunctionSignature@multiowned = functionSignature__unwrap(ruby_wrap_optional_Type_multiowned_X((IF entry != NIL THEN
        symbolEntry__type(entry)
      ELSE
        NIL
      END)));
      IF signature EXISTS AS signature_value THEN
        MUTABLE return_type = functionSignature__return_type(signature_value);
        IF typeAnalysisSession__stale_auto_node_type?(rtoc_self_view, CAST(return_type AS Type)) THEN
          RETURN NIL;
        END
        RETURN TRY (type__new(TypeConstructionInput{ Type: COPY return_type }));
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__restamp_binary_type_after_auto_mut(self: TypeAnalysisSession, MUTABLE node: Locatable) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A BinaryOp AS binary_op THEN
      MUTABLE binary_op_mutable = COPY binary_op;
      MUTABLE left_type = typeAnalysisSession__auto_finalization_node_type(rtoc_self_view, &binary_op_mutable.left);
      MUTABLE right_type = typeAnalysisSession__auto_finalization_node_type(rtoc_self_view, &binary_op_mutable.right);
      IF (typeAnalysisSession__stale_auto_node_type?(rtoc_self_view, CAST(left_type AS Type)) OR typeAnalysisSession__stale_auto_node_type?(rtoc_self_view, CAST(right_type AS Type))) THEN
        RETURN FALSE;
      END
      MUTABLE result = TRY (type__binary_op(binary_op_mutable.op, CAST(left_type AS Type), CAST(right_type AS Type)));
      IF result.error EXISTS AS error_value THEN
        typeAnalysisSession__error_mut(rtoc_self_view, binary_op_mutable, TypeAnalysisCodeOrMessage{ SymbolValue: :TYPE_ERROR_GENERIC }, [], {:detail: error_value});
      END
      MUTABLE result_type: Type = COPY castTypeToType(result.type);
      IF typeAnalysisSession__stale_auto_node_type?(rtoc_self_view, result_type) THEN
        RETURN FALSE;
      END
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY binary_op_mutable }, TRY (type__new(castTypeToTypeConstructionInput(result_type)))));
      RETURN TRUE;
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__concrete_program_type_for(self: TypeAnalysisSession, node: Locatable) RETURNS !?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A Program AS program THEN
      MUTABLE last_stmt: ?Locatable = program.statements.reverse() |> FIND TRUE;
      IF last_stmt EXISTS AS last_stmt_value THEN
        MUTABLE last_stmt_value_mutable = COPY last_stmt_value;
        MUTABLE stmt_type = typeAnalysisSession__auto_finalization_node_type(rtoc_self_view, &last_stmt_value_mutable);
        IF typeAnalysisSession__stale_auto_node_type?(rtoc_self_view, CAST(stmt_type AS Type)) THEN
          RETURN NIL;
        END
        RETURN TRY (type__new(TypeConstructionInput{ Type: COPY stmt_type }));
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
