    MUTABLE schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult = %(name: String@symbol) USE(MUTABLE rtoc_self_view) -> TRY (typeAnalysisSession__schema_lookup_result(&rtoc_self_view, name));
    MUTABLE lifecycle_inventory = TRY (lifecycleRegistry__type_inventory(CAST(COPY resolution.program AS Program), schema_lookup));
    MUTABLE linear_resource_facts = TRY (linearResourceFacts__build_types(lifecycle_inventory.values(), schema_lookup));
    TRY (typeAnalysisSession__validate_copy_linear_resource_facts_mut(&rtoc_self_view, CAST(COPY resolution.program AS Program), linear_resource_facts));
    MUTABLE lifecycle_registry = TRY (lifecycleRegistry__build(CAST(COPY resolution.program AS Program), schema_lookup, resolution.function_registry.body_summaries.values() |> UNNEST _.binding_nodes |> SELECT UNWRAP (castBindingNodeToSemanticLifecycleRegistryBindingNode(_)), linear_resource_facts, lifecycle_inventory));
