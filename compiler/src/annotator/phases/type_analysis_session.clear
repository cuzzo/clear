PRIVATE FN typeAnalysisSession__same_generic_binding?(MUTABLE self: TypeAnalysisSession, left: GenericBinding, right: GenericBinding) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE l = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_188: ?GenericBinding = NIL;
    IF left IS_A Type THEN
      rtoc_ternary_value_188 = COPY left;
    ELSE
      rtoc_ternary_value_188 = GenericBinding{ Type: COPY TRY (type__new(castGenericBindingToTypeConstructionInput(left))) };
    END
    rtoc_ternary_value_188? };
    MUTABLE r = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_190: ?GenericBinding = NIL;
    IF right IS_A Type THEN
      rtoc_ternary_value_190 = COPY right;
    ELSE
      rtoc_ternary_value_190 = GenericBinding{ Type: COPY TRY (type__new(castGenericBindingToTypeConstructionInput(right))) };
    END
    rtoc_ternary_value_190? };
    RETURN ((((((genericBinding__resolved(l) == genericBinding__resolved(r)) AND (genericBinding__ownership(l) == genericBinding__ownership(r))) AND (genericBinding__sync(l) == genericBinding__sync(r))) AND (genericBinding__layout(l) == genericBinding__layout(r))) AND (genericBinding__elem_ownership(l) == genericBinding__elem_ownership(r))) AND (genericBinding__elem_sync(l) == genericBinding__elem_sync(r)));
}
END
PRIVATE FN typeAnalysisSession__same_shared_call_capability?(MUTABLE self: TypeAnalysisSession, left: Type, right: Type) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN ((((type__sync(left) == type__sync(right)) AND (type__layout(left) == type__layout(right))) AND (type__elem_ownership(left) == type__elem_ownership(right))) AND (type__elem_sync(left) == type__elem_sync(right)));
