  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ OrElseBreak: COPY node }, :Void));
}
