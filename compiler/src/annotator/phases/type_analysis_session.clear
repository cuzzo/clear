PRIVATE FN typeAnalysisSession__stamp_program_result_type_mut(self: TypeAnalysisSession, MUTABLE program: Program) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE final_statement: ?Locatable = COPY program.statements.last();
    IF final_statement EXISTS AS final_statement_value THEN
      MUTABLE final_statement_value_mutable = COPY final_statement_value;
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, castProgramToLocatable(program), &final_statement_value_mutable.full_type_mut("program final statement")));
    ELSE
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, castProgramToLocatable(program), :Void));
    END
}
END
PRIVATE FN typeAnalysisSession__analyze_control_flow_branches(self: TypeAnalysisSession, branches: FN() -> []Any, merge_to_parent: Bool = TRUE) RETURNS ![]Any@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE og_snapshot = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_308 = typeAnalysisSession__ownership_graph(rtoc_self_view);
    ownershipGraph__fork_lightweight(rtoc_local_receiver_308) };
    MUTABLE branch_results: []BranchAnalysisResult = ( { MUTABLE rtoc_empty_list_309: []BranchAnalysisResult = List[]; rtoc_empty_list_309 } );
    FOR _ IN branches DO
    &branch_results.append(typeAnalysisSession__analyze_control_flow_branch(rtoc_self_view, _, og_snapshot));
    END
    IF merge_to_parent THEN
      IF og_snapshot THEN
        MUTABLE rtoc_mutable_receiver_310 = typeAnalysisSession__ownership_graph(rtoc_self_view);
        TRY (ownershipGraph__restore_lightweight(&rtoc_mutable_receiver_310, og_snapshot));
      END
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < branch_results.length() DO
      IF branch_results[rtoc_idx]?.terminated THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE snap: ?LightweightSnapshot = COPY branch_results[rtoc_idx]?.snapshot;
      IF !(snap) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      lightweightSnapshot__each_state(snap, %(path: String, state: String@symbol) USE(snap, rtoc_self_view) -> {
        MUTABLE node: ?OwnershipNode = COPY ownershipGraph__get_index(typeAnalysisSession__ownership_graph(rtoc_self_view), path);
        IF !(node) THEN
              RETURN;
        END
        IF (node.state != state) THEN
              IF (state == :moved) THEN
                node.state = :moved;
                node.move_line = lightweightSnapshot__move_line_for(snap, path);
                node.move_col = lightweightSnapshot__move_col_for(snap, path);
                node.move_action = lightweightSnapshot__move_action_for(snap, path);
              END
        END
        rubyToClearVoid()
      });
    rtoc_idx = rtoc_idx + 1;
      END
    ELSE
      IF og_snapshot THEN
        MUTABLE rtoc_mutable_receiver_311 = typeAnalysisSession__ownership_graph(rtoc_self_view);
        TRY (ownershipGraph__restore_lightweight(&rtoc_mutable_receiver_311, og_snapshot));
      END
    END
    RETURN branch_results |> SELECT _.drops;
}
END
PRIVATE FN typeAnalysisSession__analyze_control_flow_branch(self: TypeAnalysisSession, branch_logic: FN() -> Any, og_snapshot: ?LightweightSnapshot) RETURNS !BranchAnalysisResult
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF og_snapshot EXISTS AS og_snapshot_value THEN
      MUTABLE og_snapshot_value_mutable = COPY og_snapshot_value;
      MUTABLE rtoc_mutable_receiver_312 = typeAnalysisSession__ownership_graph(rtoc_self_view);
      TRY (ownershipGraph__restore_lightweight(&rtoc_mutable_receiver_312, og_snapshot_value_mutable));
    END
    MUTABLE prev_terminated = typeAnalysisSession__phase_traversal_state(rtoc_self_view).branch_terminated;
    MUTABLE stream_frame: ?StreamYieldFrame = typeAnalysisSession__current_stream_yield_frame(rtoc_self_view);
    MUTABLE prev_stream_closed: ?Bool = stream_frame?.closed;
    MUTABLE rtoc_writer_receiver_313: TraversalState = typeAnalysisSession__phase_traversal_state(rtoc_self_view);
    rtoc_writer_receiver_313.branch_terminated = FALSE;
    DEFER {
    MUTABLE rtoc_writer_receiver_314: TraversalState = typeAnalysisSession__phase_traversal_state(rtoc_self_view);
    rtoc_writer_receiver_314.branch_terminated = prev_terminated;
    IF ((stream_frame != NIL) AND !((prev_stream_closed == NIL))) THEN
      stream_frame.closed = prev_stream_closed?;
    END
    }
    RETURN typeAnalysisSession__with_new_scope(rtoc_self_view, typeAnalysisSession__current_scope(rtoc_self_view), %() USE(branch_logic, rtoc_self_view) -> {
    MUTABLE pushed_og_scope: Bool = FALSE;
    typeAnalysisSession__og_push_scope(rtoc_self_view);
    pushed_og_scope = TRUE;
    DEFER IF pushed_og_scope THEN
        typeAnalysisSession__og_pop_scope(rtoc_self_view);
    END
    BranchAnalysisResult{ drops: branch_logic(), snapshot: COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_315 = typeAnalysisSession__ownership_graph(rtoc_self_view);
    ownershipGraph__fork_lightweight(rtoc_local_receiver_315) }, terminated: typeAnalysisSession__phase_traversal_state(rtoc_self_view).branch_terminated }
    });
}
END
PRIVATE FN typeAnalysisSession__visit_BlockExpr(MUTABLE self: TypeAnalysisSession, MUTABLE node: BlockExpr) RETURNS !?Scope@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__with_new_scope(rtoc_self_view, typeAnalysisSession__current_scope(rtoc_self_view), %() USE(MUTABLE node, MUTABLE rtoc_self_view) -> {
    FOR _ IN node.body DO
    TRY (typeAnalysisSession__visit(&rtoc_self_view, _));
    END
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.result));
    IF ((node.result != NIL) AND (node.result IS_A IfStatement)) THEN
        typeAnalysisSession__promote_to_expr_if_mut(rtoc_self_view, node, castOptionalLocatableToIfStatement(node.result));
    END
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node, &node.result.full_type_mut("catch branch result")));
    node.storage = node.result.storage();
    NIL
    });
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__visit_IfStatement(MUTABLE self: TypeAnalysisSession, MUTABLE node: IfStatement) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (node.condition IS_A IsA AND node.comptime) THEN
      typeAnalysisSession__annotate_comptime_is_a_mut(&rtoc_self_view, castLocatableToIsA(node.condition));
    ELSE
      IF (node.condition IS_A IsA AND typeAnalysisSession__static_type_expr?(rtoc_self_view, node.condition.left())) THEN
        typeAnalysisSession__emit_is_a_needs_comptime_fix_mut(rtoc_self_view, node);
      END
      typeAnalysisSession__with_if_is_a_condition(&rtoc_self_view, node.condition, %() USE(node, MUTABLE rtoc_self_view) -> {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.condition));
    rubyToClearVoid()
      });
    END
    MUTABLE then_value_refinements = typeAnalysisSession__short_circuit_non_nil_refinements(rtoc_self_view, node.condition, TRUE);
    MUTABLE else_value_refinements = typeAnalysisSession__short_circuit_non_nil_refinements(rtoc_self_view, node.condition, FALSE);
    MUTABLE branch_logic = [proc(%() USE(node, then_value_refinements, MUTABLE rtoc_self_view) -> {
    typeAnalysisSession__with_conditional_context(rtoc_self_view, %() USE(node, then_value_refinements, MUTABLE rtoc_self_view) -> {
      rtoc_lambda_result_317 = typeAnalysisSession__with_value_type_refinements(&rtoc_self_view, then_value_refinements, %() USE(node, MUTABLE rtoc_self_view) -> {
      typeAnalysisSession__declare_is_a_binding_mut(rtoc_self_view, node.condition);
      typeAnalysisSession__with_comptime_is_a_then_refinement(&rtoc_self_view, node.condition, %() USE(node, MUTABLE rtoc_self_view) -> {
        rtoc_lambda_result_316 = TRY (typeAnalysisSession__visit_stmts(&rtoc_self_view, node.then_branch));
        rtoc_lambda_result_316
      })
    });
      rtoc_lambda_result_317
    });
    typeAnalysisSession__finalize_scope(rtoc_self_view, Locatable{ IfStatement: COPY node }, :then);
    node.then_drops
    }), proc(%() USE(else_value_refinements, node, MUTABLE rtoc_self_view) -> {
    typeAnalysisSession__with_conditional_context(rtoc_self_view, %() USE(else_value_refinements, node, MUTABLE rtoc_self_view) -> {
      rtoc_lambda_result_319 = typeAnalysisSession__with_value_type_refinements(&rtoc_self_view, else_value_refinements, %() USE(node, MUTABLE rtoc_self_view) -> {
      rtoc_lambda_result_318 = TRY (typeAnalysisSession__visit_stmts(&rtoc_self_view, node.else_branch));
      rtoc_lambda_result_318
    });
      rtoc_lambda_result_319
    });
    typeAnalysisSession__finalize_scope(rtoc_self_view, Locatable{ IfStatement: COPY node }, :else);
    node.else_drops
    })];
    typeAnalysisSession__analyze_control_flow_branches(rtoc_self_view, branch_logic);
    node.then_result_type = typeAnalysisSession__expr_result_type(rtoc_self_view, node.then_branch);
    node.else_result_type = typeAnalysisSession__expr_result_type(rtoc_self_view, node.else_branch);
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ IfStatement: COPY node }, :Void));
}
END
PRIVATE FN typeAnalysisSession__visit_IsA(MUTABLE self: TypeAnalysisSession, MUTABLE node: IsA) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(typeAnalysisSession__static_type_expr?(rtoc_self_view, node.left)) THEN
      typeAnalysisSession__annotate_runtime_is_a_mut(&rtoc_self_view, &node);
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ IsA: COPY node }, :Bool));
      RETURN NIL;
    END
    typeAnalysisSession__annotate_comptime_is_a_mut(&rtoc_self_view, node);
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__annotate_comptime_is_a_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: IsA) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__annotate_is_a_operand_mut(&rtoc_self_view, &node.left, "Left");
    typeAnalysisSession__annotate_is_a_operand_mut(&rtoc_self_view, &node.right, "Right");
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ IsA: COPY node }, :Bool));
}
END
PRIVATE FN typeAnalysisSession__with_if_is_a_condition(MUTABLE self: TypeAnalysisSession, condition: Locatable, blk: FN() -> Void) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE previous = rtoc_self_view.current_if_is_a_condition;
  DEFER rtoc_self_view.current_if_is_a_condition = previous;
  rtoc_self_view.current_if_is_a_condition = COPY condition;
  blk();
}
END
PRIVATE FN typeAnalysisSession__annotate_runtime_is_a_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: IsA) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.left));
    MUTABLE subject_type = &node.left.full_type_mut("runtime IS_A subject");
    MUTABLE type_name_branch_value: ?String@symbol = NIL;
    IF type__generic_instance?(subject_type) THEN
      type_name_branch_value = type__generic_base(subject_type);
    ELSE
      type_name_branch_value = subject_type.resolved();
    END
    MUTABLE type_name: String@symbol = type_name_branch_value?;
    MUTABLE schema: ?MatchSchema = CAST(typeAnalysisSession__lookup_type_schema(rtoc_self_view, type_name) AS ?MatchSchema);
    IF !(schemas__union?(castOptionalMatchSchemaToOptionalSchemaValue(schema))) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node.left, TypeAnalysisCodeOrMessage{ SymbolValue: :IS_A_RUNTIME_NEEDS_UNION }, [], {:got: CAST(subject_type AS String)});
    END
    MUTABLE union_schema: UnionSchema@multiowned = castOptionalMatchSchemaToUnionSchemaMultiowned(schema);
    MUTABLE subst = typeAnalysisSession__match_union_substitution(rtoc_self_view, subject_type, MatchSchema{ UnionSchemaMultiowned: COPY union_schema }, TRUE);
    MUTABLE variant_name = typeAnalysisSession__resolve_runtime_is_a_variant_mut(rtoc_self_view, node, union_schema, type_name, subst);
    node.runtime_variant_name = variant_name;
    typeAnalysisSession__stamp_runtime_is_a_target_mut(&rtoc_self_view, node.right, type_name);
    MUTABLE binding = node.binding;
    IF !(binding) THEN
      RETURN;
    END
    MUTABLE raw_payload: ?MatchPayload = typeAnalysisSession__runtime_union_payload(rtoc_self_view, union_schema, variant_name);
    IF raw_payload EXISTS AS raw_payload_value THEN
      MUTABLE match_case = MatchCase{ kind: :eq, value: COPY node.right, binding: COPY binding, body: COPY List[], destructure: NIL, extra_values: List[], indirect_payload_as: FALSE };
      node.runtime_payload_type = typeAnalysisSession__match_payload_binding_type(rtoc_self_view, MatchSubjectPlan{ expr_type: COPY subject_type, type_name: COPY type_name, schema: MatchSchema{ UnionSchemaMultiowned: COPY union_schema }, enum_subject: FALSE, union_subject: TRUE, union_subst: COPY subst }, variant_name, raw_payload_value, &match_case);
      node.runtime_indirect_payload_as = match_case.indirect_payload_as;
    ELSE
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :MATCH_UNIT_CAPTURE }, [], {:binding: binding, :variant: variant_name});
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__resolve_runtime_is_a_variant_mut(self: TypeAnalysisSession, node: IsA, schema: UnionSchema, union_type: String@symbol, union_subst: {String@symbol}String@symbol) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE target_names = typeAnalysisSession__runtime_is_a_target_names(rtoc_self_view, node.right);
    MUTABLE variant_key = (target_names |> SELECT:? typeAnalysisSession__runtime_union_variant_key(rtoc_self_view, schema, _) |> WHERE _ != NIL).first();
    IF variant_key THEN
      RETURN COPY CAST(variant_key AS String);
    END
    MUTABLE payload_matches = schema.variants.keys() |> WHERE {
    MUTABLE payload: ?MatchPayload = typeAnalysisSession__normalized_runtime_match_payload(rtoc_self_view, castOptionalSchemasUnionSchemaVariantValueToOptionalMatchPayload(schema.variants[_]), union_subst);
    typeAnalysisSession__runtime_is_a_payload_matches?(rtoc_self_view, payload, target_names, union_type, CAST(_ AS String))
    };
    IF (payload_matches.length() == 1) THEN
      RETURN COPY CAST(payload_matches.first() AS String);
    ELSE_IF (payload_matches.length() > 1) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :IS_A_RUNTIME_AMBIGUOUS_PAYLOAD }, [], {:target: typeAnalysisSession__runtime_is_a_target_label(rtoc_self_view, node.right), :union: union_type, :variants: ((payload_matches |> SELECT _.toString()) |> ORDER_BY _).join(", ")});
    END
    RETURN typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :IS_A_RUNTIME_UNKNOWN_VARIANT }, [], {:target: typeAnalysisSession__runtime_is_a_target_label(rtoc_self_view, node.right), :union: union_type});
}
END
PRIVATE FN typeAnalysisSession__runtime_is_a_target_names(self: TypeAnalysisSession, node: Node) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE segments = typeAnalysisSession__runtime_is_a_target_segments(rtoc_self_view, node);
    MUTABLE full = segments.join(".");
    RETURN CAST((([full, segments.last()]) |> DISTINCT _) AS []String);
}
END
PRIVATE FN typeAnalysisSession__runtime_is_a_target_segments(self: TypeAnalysisSession, node: Node) RETURNS ![]String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A Type AS type THEN
      RETURN CAST([TRY (type__coercion_surface_name(castTypeToTypeTypeInput(type)))] AS []String);
    ELSE_IF node IS_A Identifier AS identifier THEN
      RETURN CAST([identifier__name(identifier)] AS []String);
    ELSE_IF node IS_A GetField AS get_field THEN
      RETURN (typeAnalysisSession__runtime_is_a_target_segments(rtoc_self_view, castLocatableToNode(castLocatableToLocatable(get_field.target))) + [CAST(get_field.field AS String)]);
    ELSE
      RETURN CAST([CAST(node.token_value() AS String)] AS []String);
    END
}
END
PRIVATE FN typeAnalysisSession__runtime_is_a_target_label(self: TypeAnalysisSession, node: Node) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN typeAnalysisSession__runtime_is_a_target_segments(rtoc_self_view, node).join(".");
}
END
PRIVATE FN typeAnalysisSession__runtime_union_variant_key(self: TypeAnalysisSession, schema: UnionSchema, name: String) RETURNS ?TypeAnalysisSessionReturnValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ruby_wrap_optional_String_symbol_TypeAnalysisSessionReturnValue(schema.variants.keys() |> FIND (CAST(_ AS String) == name));
}
END
PRIVATE FN typeAnalysisSession__runtime_union_payload(self: TypeAnalysisSession, schema: UnionSchema, variant_name: String) RETURNS ?MatchPayload
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE key: ?ControlFlowReturnValue = typeAnalysisSession__runtime_union_variant_key(rtoc_self_view, schema, variant_name);
    IF key EXISTS AS key_value THEN
      RETURN COPY castOptionalSchemasUnionSchemaVariantValueToOptionalMatchPayload(schema.variants[castControlFlowReturnValueToStringSymbol(key_value)]);
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__runtime_is_a_payload_matches?(self: TypeAnalysisSession, payload: ?MatchPayload, target_names: []String, union_type: String@symbol, variant_name: String) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF payload IS_A Type@multiowned AS type_multiowned THEN
      MUTABLE payload_name = TRY (type__coercion_surface_name(TypeTypeInput{ Type: COPY type_multiowned }));
      MUTABLE payload_names = (CAST(Tuple{payload_name, payload_name.split(".").last()} AS Tuple<String, ?String>)) |> DISTINCT _ |> SELECT COPY _;
      RETURN type__any?((ruby_set_intersection_String(payload_names, target_names)));
    ELSE_IF payload IS_A InlineStructVariant@multiowned AS inline_struct_variant_multiowned THEN
      MUTABLE synthetic_name = "${union_type}_${variant_name}";
      RETURN type__any?((ruby_set_intersection_String([synthetic_name, variant_name], target_names)));
    ELSE_IF payload IS_A String@symbol AS string_symbol THEN
      MUTABLE payload_name = COPY CAST(string_symbol AS String);
      RETURN type__any?((ruby_set_intersection_String(CAST(Tuple{payload_name, payload_name.split(".").last()} AS Tuple<String, ?String>), target_names)));
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__stamp_runtime_is_a_target_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: Node, type_name: String@symbol) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node IS_A Type AS type THEN
      RETURN;
    ELSE_IF node IS_A GetField AS get_field THEN
      MUTABLE get_field_mutable = COPY get_field;
      typeAnalysisSession__stamp_runtime_is_a_target_mut(&rtoc_self_view, castLocatableToNode(castLocatableToLocatable(get_field_mutable.target)), type_name);
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ GetField: COPY get_field_mutable }, type_name));
    ELSE_IF node IS_A Identifier AS identifier THEN
      MUTABLE identifier_mutable = COPY identifier;
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ Identifier: COPY identifier_mutable }, :Type));
    ELSE
      TRY (typeAnalysisSession__visit(&rtoc_self_view, castNodeToOptionalLocatable(node)));
    END
}
END
PRIVATE FN typeAnalysisSession__annotate_is_a_operand_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: Node, side: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node IS_A Type AS type THEN
      RETURN;
    END
    IF typeAnalysisSession__static_type_expr?(rtoc_self_view, node) THEN
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, castNodeToLocatable(node), :Type));
    ELSE
      TRY (typeAnalysisSession__visit(&rtoc_self_view, castNodeToOptionalLocatable(node)));
    END
    MUTABLE type_info = &node.full_type_mut("IS_A ${side.downcase()} operand");
    IF (type_info.resolved() == :Type) THEN
      RETURN;
    END
    typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :IS_A_OPERAND_NEEDS_TYPE }, [], {:side: side, :got: CAST(type_info AS String)});
}
END
PRIVATE FN typeAnalysisSession__static_type_expr?(self: TypeAnalysisSession, node: Node) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A Type AS type THEN
      RETURN TRUE;
    ELSE_IF node IS_A Identifier AS identifier THEN
      MUTABLE name = symbol(identifier__name(identifier));
      RETURN ((TRY (typeAnalysisSession__current_function_type_param?(rtoc_self_view, name)) OR (CAST({:Float64: "f64", :Int64: "i64", :String: "[]const u8", :Void: "void", :Bool: "bool", :Byte: "u8", :Int8: "i8", :Int16: "i16", :Int32: "i32", :UInt8: "u8", :UInt16: "u16", :UInt32: "u32", :UInt64: "u64", :Float32: "f32", :TargetInt: "c_int", :TargetUInt: "c_uint", :TargetLong: "c_long", :TargetULong: "c_ulong", :TargetLongLong: "c_longlong", :TargetULongLong: "c_ulonglong", :Any: "f64", :Range: "CheatLib.Range", :File: "CheatLib.File", :TCPServer: "i32", :TCPClient: "i32"} AS {String@symbol}String)).contains?(name)) OR !(!(typeAnalysisSession__lookup_type_schema(rtoc_self_view, name))));
    ELSE_IF node IS_A GetField AS get_field THEN
      RETURN typeAnalysisSession__static_dotted_type_expr?(rtoc_self_view, get_field);
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__static_dotted_type_expr?(self: TypeAnalysisSession, node: GetField) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(node.target IS_A Identifier) THEN
      RETURN FALSE;
    END
    MUTABLE namespace = COPY castLocatableToIdentifier(node.target).name;
    RETURN (namespace == "AST");
}
END
PRIVATE FN typeAnalysisSession__with_comptime_is_a_then_refinement<Result>(MUTABLE self: TypeAnalysisSession, condition: Locatable, blk: FN() -> Result) RETURNS !Result
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE refinement: ?[]Any@multiowned = typeAnalysisSession__comptime_is_a_type_param_refinement(rtoc_self_view, condition);
    IF refinement EXISTS AS refinement_value THEN
      MUTABLE refinement_value_mutable = COPY refinement_value;
      MUTABLE type_param: String@symbol = CAST(refinement_value_mutable[0] AS String@symbol);
      MUTABLE narrowed_type: Type = CAST(refinement_value_mutable[1] AS Type);
      RETURN TRY (typeAnalysisSession__with_comptime_type_param_refinement(&rtoc_self_view, type_param, narrowed_type, %() USE(blk) -> blk()));
    ELSE
      RETURN blk();
    END
}
END
PRIVATE FN typeAnalysisSession__comptime_is_a_type_param_refinement(self: TypeAnalysisSession, condition: Locatable) RETURNS !?[]Any@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF condition IS_A IsA AS is_a THEN
      MUTABLE left = is_a.left;
      IF !(left IS_A Identifier) THEN
        RETURN NIL;
      END
      MUTABLE type_param = type__to_sym(left.name());
      IF !(TRY (typeAnalysisSession__current_function_type_param?(rtoc_self_view, type_param))) THEN
        RETURN NIL;
      END
      MUTABLE narrowed_type: ?Type@multiowned = typeAnalysisSession__static_is_a_target_type(rtoc_self_view, is_a.right);
      IF narrowed_type EXISTS AS narrowed_type_value THEN
        RETURN CAST(Tuple{type_param, narrowed_type_value} AS Tuple<String@symbol, Type@multiowned>);
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__static_is_a_target_type(self: TypeAnalysisSession, node: Node) RETURNS !?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A Type AS type THEN
      RETURN TRY (type__new(castTypeToTypeConstructionInput(type)));
    ELSE_IF node IS_A Identifier AS identifier THEN
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol(identifier__name(identifier)) }));
    ELSE_IF node IS_A GetField AS get_field THEN
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol(typeAnalysisSession__runtime_is_a_target_label(rtoc_self_view, Node{ GetField: COPY get_field })) }));
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__emit_is_a_needs_comptime_fix_mut(self: TypeAnalysisSession, node: IfStatement) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fix = TRY (fix__new(TRY (diagnosticRegistry__fix_description(:INSERT_COMPTIME_BEFORE_IF)), [edit__new(span__new(NIL, node.token.line, node.token.column, 0), "COMPTIME ")], :auto));
    typeAnalysisSession__fixable_mut(rtoc_self_view, node, :type, [fix], NIL, :IS_A_NEEDS_COMPTIME, :error, TRUE);
}
END
PRIVATE FN typeAnalysisSession__declare_is_a_binding_mut(self: TypeAnalysisSession, condition: Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF condition IS_A IsA AS is_a THEN
      MUTABLE is_a_mutable = COPY is_a;
      MUTABLE binding = is_a_mutable.binding;
      IF !(binding) THEN
        RETURN;
      END
      IF is_a_mutable.runtime_variant_name THEN
        MUTABLE payload_type = is_a_mutable.runtime_payload_type;
        IF !(payload_type) THEN
          RETURN;
        END
        MUTABLE scope = typeAnalysisSession__current_scope(rtoc_self_view);
        TRY (scope__declare(&scope, binding, SymbolEntryRegInput{ IsA: COPY is_a_mutable }, payload_type, ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
        typeAnalysisSession__og_declare(rtoc_self_view, binding, Node{ IsA: COPY is_a_mutable }, payload_type);
        typeAnalysisSession__classify_ownership_mut(rtoc_self_view, scope__local_entry_mut(scope, binding));
        typeAnalysisSession__borrow_match_payload_binding_mut(rtoc_self_view, binding);
        RETURN;
      END
      MUTABLE rtoc_mutable_receiver_320 = typeAnalysisSession__current_scope(rtoc_self_view);
      TRY (scope__declare(&rtoc_mutable_receiver_320, binding, NIL, castTypeToOptionalSymbolEntryTypeInput(TRY (type__new(TypeConstructionInput{ SymbolValue: :Type }))), ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__visit_IfBind(MUTABLE self: TypeAnalysisSession, MUTABLE node: IfBind) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE branch_logic = [proc(%() USE(node, MUTABLE rtoc_self_view) -> {
    FOR _ IN node.bindings DO
      MUTABLE rtoc_mutable_block_param_327 = COPY _;
      IF (rtoc_mutable_block_param_327.predicate == :is_ok) THEN
          typeAnalysisSession__with_body_fact_failure_absorbed(rtoc_self_view, TRUE, %() USE(rtoc_mutable_block_param_327, MUTABLE rtoc_self_view) -> {
        rtoc_lambda_result_321 = TRY (typeAnalysisSession__visit(&rtoc_self_view, rtoc_mutable_block_param_327.expr));
        rtoc_lambda_result_321
          });
      ELSE
          TRY (typeAnalysisSession__visit(&rtoc_self_view, rtoc_mutable_block_param_327.expr));
      END
      MUTABLE ti_branch_value: ?Type = NIL;
        IF (rtoc_mutable_block_param_327.predicate == :is_ok) THEN
          ti_branch_value = (typeAnalysisSession__recoverable_result_type(rtoc_self_view, &rtoc_mutable_block_param_327.expr, "IF predicate binding expression") OR_ELSE TRY (type__new(&rtoc_mutable_block_param_327.expr.full_type_mut("IF predicate binding expression"))));
        ELSE
          ti_branch_value = TRY (type__new(&rtoc_mutable_block_param_327.expr.full_type_mut("IF predicate binding expression")));
        END
      MUTABLE ti: Type = ti_branch_value?;
      MUTABLE unwrapped = typeAnalysisSession__if_bind_unwrapped_type_mut(rtoc_self_view, &rtoc_mutable_block_param_327, ti);
      IF (rtoc_mutable_block_param_327.expr IS_A ResolveNode AND ((type__multiowned?(ti) OR type__shared?(ti)))) THEN
          TRY (type__apply_reference_ownership_mut(&unwrapped, type__ownership(ti), type__link_source(ti)));
      END
      rtoc_mutable_block_param_327.unwrapped_type = CAST(unwrapped AS Type);
      MUTABLE sym = type__resolved(unwrapped);
      MUTABLE root: ?Identifier = aST__root_identifier(rtoc_mutable_block_param_327.expr);
      MUTABLE mutable_slot_payload = (((TRY (type__struct?(unwrapped)) OR type__collection?(unwrapped))) AND !(TRY (type__any_rc?(unwrapped))));
      MUTABLE mutable_list_alias = (((rtoc_mutable_block_param_327.expr IS_A GetIndex AND (root != NIL)) AND !({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_322 = typeAnalysisSession__current_scope(rtoc_self_view);
      scope__is_immutable?(rtoc_local_receiver_322, root.name) })) AND mutable_slot_payload);
      MUTABLE rtoc_mutable_receiver_323 = typeAnalysisSession__current_scope(rtoc_self_view);
      TRY (scope__declare(&rtoc_mutable_receiver_323, rtoc_mutable_block_param_327.name, NIL, SymbolEntryTypeInput{ TypeMultiowned: COPY unwrapped }, &mutable_list_alias, FALSE, NIL, :stack));
      MUTABLE entry = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_324 = typeAnalysisSession__current_scope(rtoc_self_view);
      scope__local_entry_mut(rtoc_local_receiver_324, rtoc_mutable_block_param_327.name) };
      rtoc_mutable_block_param_327.symbol = entry;
      IF aST__capture_expr_owns_result?(rtoc_mutable_block_param_327.expr) THEN
          symbolEntry__mark_owned_optional_capture_mut(&entry);
      END
      MUTABLE container_source: ?String = typeAnalysisSession__if_bind_container_source(rtoc_self_view, CAST(unwrapped AS Type), rtoc_mutable_block_param_327.expr);
      MUTABLE src_sym: ?SymbolEntry@multiowned = NIL;
      MUTABLE source_root: ?Identifier = aST__root_identifier(rtoc_mutable_block_param_327.expr);
      IF source_root EXISTS AS source_root_value THEN
          src_sym = COPY source_root_value.symbol;
      END
      IF src_sym EXISTS AS src_sym_value THEN
          MUTABLE src_sym_value_mutable = COPY src_sym_value;
          IF symbolEntry__non_escaping(src_sym_value_mutable) THEN
            TRY (symbolEntry__mark_non_escaping_mut(&entry));
          END
          IF container_source EXISTS AS container_source_value THEN
            MUTABLE container_source_value_mutable = COPY container_source_value;
            entry.lifetime = TRY (symbolEntry__tied_lifetime([src_sym_value_mutable]));
            symbolEntry__mark_borrowed_alias_mut(&entry);
          END
      END
      typeAnalysisSession__classify_ownership_mut(rtoc_self_view, &entry);
      typeAnalysisSession__og_declare(rtoc_self_view, rtoc_mutable_block_param_327.name, NIL, TypeTypeInput{ Type: COPY unwrapped });
      IF container_source EXISTS AS container_source_value THEN
          MUTABLE container_source_value_mutable = COPY container_source_value;
          MUTABLE graph_node: ?OwnershipNode = COPY ownershipGraph__get_index(typeAnalysisSession__ownership_graph(rtoc_self_view), rtoc_mutable_block_param_327.name);
          IF graph_node EXISTS AS graph_node_value THEN
            MUTABLE graph_node_value_mutable = COPY graph_node_value;
            graph_node_value_mutable.kind = :borrowed;
          END
          MUTABLE rtoc_mutable_receiver_325 = typeAnalysisSession__ownership_graph(rtoc_self_view);
          TRY (ownershipGraph__borrow(&rtoc_mutable_receiver_325, rtoc_mutable_block_param_327.name, container_source_value_mutable, (mutable_list_alias == TRUE)));
      END
    END
    TRY (typeAnalysisSession__visit_stmts(&rtoc_self_view, node.then_branch));
    NIL
    }), proc(%() USE(node, MUTABLE rtoc_self_view) -> {
    TRY (typeAnalysisSession__visit_stmts(&rtoc_self_view, node.else_branch));
    NIL
    })];
    typeAnalysisSession__analyze_control_flow_branches(rtoc_self_view, branch_logic);
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ IfBind: COPY node }, :Void));
}
END
PRIVATE FN typeAnalysisSession__if_bind_unwrapped_type_mut(self: TypeAnalysisSession, MUTABLE binding: Binding, type: Type) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (binding.predicate == :is_ok) THEN
      IF !(type__error_union?(type)) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, binding.expr, TypeAnalysisCodeOrMessage{ SymbolValue: :IS_OK_REQUIRES_FALLIBLE }, [], {:got: binding.expr.resolved_type()});
      END
      RETURN TRY (type__success_type(type));
    END
    IF TRY (type__stream_step?(type)) THEN
      binding.predicate = :stream_item;
      RETURN UNWRAP (TRY (type__stream_step_item_type(type)));
    END
    IF !(type__optional?(type)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, binding.expr, TypeAnalysisCodeOrMessage{ SymbolValue: :IF_AS_NEEDS_OPTIONAL }, [], {:got: binding.expr.resolved_type()});
    END
    RETURN UNWRAP (TRY (type__wrapped_type(type)));
}
END
PRIVATE FN typeAnalysisSession__if_bind_container_source(self: TypeAnalysisSession, type: Type, expression: Locatable) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (TRY (type__node_reference?(type)) OR TRY (type__implicitly_copyable?(type))) THEN
      RETURN;
    END
    RETURN typeAnalysisSession__find_container_source(rtoc_self_view, expression);
}
END
PRIVATE FN typeAnalysisSession__annotate_struct_pattern_mut(MUTABLE self: TypeAnalysisSession, match_node: MatchStatement, MUTABLE pat: StructPattern) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE expr_type = match_node.expr.resolved_type();
    MUTABLE primitives = [:Float64, :Bool, :Byte, :Int64, :Float64, :String, symbol("NIL"), :BOOLEAN, :Any, :Void];
    IF primitives.contains?(expr_type) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, match_node, TypeAnalysisCodeOrMessage{ SymbolValue: :MATCH_NEEDS_STRUCT_TYPE }, [], {:got: expr_type});
    END
    MUTABLE schema = typeAnalysisSession__lookup_type_schema(rtoc_self_view, expr_type);
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < pat.fields.length() DO
      IF patternField__wildcard?(pat.fields[rtoc_idx]?) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF schema THEN
          IF !(schema.fields().key?(pat.fields[rtoc_idx]?.name)) THEN
            MUTABLE name_tok: ?Token@multiowned = COPY KEEP pat.fields[rtoc_idx]?.name_token;
            IF name_tok EXISTS AS name_tok_value THEN
              MUTABLE valid_fields = schema.fields().keys() |> WHERE !((CAST(_ AS String)).startsWith?("_"));
              typeAnalysisSession__emit_typo_suggestion_mut(rtoc_self_view, TypoToken{ TokenMultiowned: COPY name_tok_value }, pat.fields[rtoc_idx]?.name, valid_fields, "MATCH struct pattern: field '${pat.fields[rtoc_idx]?.name}' does not exist on type ${expr_type}", "field of ${expr_type}", :type, TRUE);
            ELSE
              typeAnalysisSession__error_mut(rtoc_self_view, match_node, TypeAnalysisCodeOrMessage{ SymbolValue: :MATCH_FIELD_UNKNOWN }, [], {:field: pat.fields[rtoc_idx]?.name, :type: expr_type});
            END
          END
      END
      IF patternField__bind?(pat.fields[rtoc_idx]?) THEN
          IF (TRUE AND schema.fields().key?(pat.fields[rtoc_idx]?.name)) THEN
            MUTABLE field_def = schema.fields()[pat.fields[rtoc_idx]?.name];
            MUTABLE field_type = field_def.type();
            MUTABLE rtoc_mutable_receiver_328 = typeAnalysisSession__current_scope(rtoc_self_view);
            TRY (scope__declare(&rtoc_mutable_receiver_328, pat.fields[rtoc_idx]?.name, NIL, field_type, ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
            typeAnalysisSession__og_declare(rtoc_self_view, pat.fields[rtoc_idx]?.name, NIL, field_type);
          END
      ELSE
          MUTABLE field_expr = patternField__expr(pat.fields[rtoc_idx]?);
          TRY (typeAnalysisSession__visit(&rtoc_self_view, field_expr));
          IF schema THEN
            MUTABLE field_def = schema.fields()[pat.fields[rtoc_idx]?.name];
            MUTABLE ft = (IF field_def != NIL THEN
              field_def.type()
            ELSE
              NIL
            END);
            MUTABLE field_type = IF ft IS_A Type THEN
              ft.resolved()
            ELSE
              ft
            END;
            MUTABLE val_type = field_expr.resolved_type();
            MUTABLE is_numeric_promo = (((val_type == :Int64) AND (((field_type == :Float64) OR (field_type == :Float64)))));
            IF !(((((val_type == field_type) OR (val_type == :Any)) OR (field_type == :Any)) OR is_numeric_promo)) THEN
              typeAnalysisSession__error_mut(rtoc_self_view, match_node, TypeAnalysisCodeOrMessage{ SymbolValue: :MATCH_FIELD_TYPE_MISMATCH }, [], {:field: pat.fields[rtoc_idx]?.name, :declared: field_type, :got: val_type});
            END
          END
      END
    rtoc_idx = rtoc_idx + 1;
    END
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ StructPattern: COPY pat }, &match_node.expr.full_type_mut("match destructure subject")));
    NIL;
}
END
PRIVATE FN typeAnalysisSession__match_variant_name(self: TypeAnalysisSession, pattern: Locatable) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF pattern IS_A GetField AS get_field THEN
      RETURN get_field.field;
    ELSE_IF (pattern IS_A MethodCall) THEN
      RETURN pattern.name();
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__match_variant_names(self: TypeAnalysisSession, arm: MatchCase) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ([arm.value] + (arm.extra_values)) |> SELECT:? typeAnalysisSession__match_variant_name(rtoc_self_view, _) |> WHERE _ != NIL;
}
END
PRIVATE FN typeAnalysisSession__normalized_match_payload(self: TypeAnalysisSession, payload: ?MatchPayload, union_subst: {String@symbol}String@symbol) RETURNS ?MatchPayload
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF payload? IS_A Type AS type THEN
      RETURN MatchPayload{ StringValue: CAST(type__resolved((typeAnalysisSession__apply_type_subst(rtoc_self_view, castTypeToTypeTypeInput(type), union_subst))) AS String) };
    END
    IF payload? IS_A String@symbol AS string_symbol THEN
      RETURN MatchPayload{ SymbolValue: COPY (union_subst[string_symbol] OR_ELSE string_symbol) };
    END
    RETURN COPY payload;
}
END
PRIVATE FN typeAnalysisSession__normalized_runtime_match_payload(self: TypeAnalysisSession, payload: ?MatchPayload, union_subst: {String@symbol}String@symbol) RETURNS ?MatchPayload
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF payload? IS_A Type AS type THEN
      RETURN MatchPayload{ TypeMultiowned: COPY typeAnalysisSession__apply_type_subst(rtoc_self_view, castTypeToTypeTypeInput(type), union_subst) };
    END
    IF payload? IS_A String@symbol AS string_symbol THEN
      RETURN MatchPayload{ SymbolValue: COPY (union_subst[string_symbol] OR_ELSE string_symbol) };
    END
    RETURN COPY payload;
}
END
PRIVATE FN typeAnalysisSession__verify_match_multi_arm_payloads_mut(self: TypeAnalysisSession, node: MatchStatement, arm: MatchCase, schema: UnionSchema, variant_name: ?String, union_subst: {String@symbol}String@symbol, kind: String, name: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF variant_name EXISTS AS variant_name_value THEN
      MUTABLE head_payload: ?MatchPayload = typeAnalysisSession__normalized_match_payload(rtoc_self_view, castOptionalSchemasUnionSchemaVariantValueToOptionalMatchPayload(schema.variants[symbol(variant_name_value)]), union_subst);
      MUTABLE rtoc_each_items_330 = (typeAnalysisSession__match_variant_names(rtoc_self_view, arm) |> SKIP 1);
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < rtoc_each_items_330.length() DO
      MUTABLE extra_payload: ?MatchPayload = typeAnalysisSession__normalized_match_payload(rtoc_self_view, castOptionalSchemasUnionSchemaVariantValueToOptionalMatchPayload(schema.variants[rtoc_each_items_330[rtoc_idx]]), union_subst);
      IF (head_payload == extra_payload) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :MATCH_MULTI_ARM_PAYLOAD_MISMATCH }, [], {:head: variant_name_value, :other: rtoc_each_items_330[rtoc_idx], :kind: kind, :name: name});
    rtoc_idx = rtoc_idx + 1;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__literal_type_substitution_mut(self: TypeAnalysisSession, node: StructLit, schema: TypeAnalysisSchema) RETURNS !{String@symbol}GenericBinding
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE type_params = schema.type_params();
    MUTABLE subst: {String@symbol}GenericBinding = {};
    IF (IF node.type_args != NIL THEN
      node.type_args.any?()
    ELSE
      NIL
    END) THEN
      IF type_params.empty?() THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_NOT_GENERIC }, [], {:type: node.name});
      END
      IF (node.type_args.length() != scopeBindings__length(type_params)) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_WRONG_ARG_COUNT }, [], {:type: node.name, :expected: scopeBindings__length(type_params), :got: node.type_args.length()});
      END
      type_params.zip(node.type_args).keys() |> EACH {
    MUTABLE arg: Any = (type_params.zip(node.type_args)[_] OR_ELSE panic("missing hash key"));
      subst[_] = castTypeToGenericBinding(TRY (type__new(arg)));
      };
    ELSE_IF type__any?(type_params) THEN
      MUTABLE params_hint = (type_params |> SELECT _.toString()).join(", ");
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_MISSING_TYPE_ARGS }, [], {:type: node.name, :type2: node.name, :hint: params_hint});
    END
    RETURN subst;
}
END
PRIVATE FN typeAnalysisSession__literal_instance_type(self: TypeAnalysisSession, node: StructLit) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (IF node.type_args != NIL THEN
      node.type_args.any?()
    ELSE
      NIL
    END) THEN
      RETURN TRY (type__new(TypeConstructionInput{ TypeExpression: COPY typeExpression__of(NamedTypeExpression{ name: COPY symbol(node.name), arguments: COPY node.type_args |> SELECT ((TRY (type__new(castTypeToTypeConstructionInput(_)))).shape).expression }) }));
    ELSE
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol(node.name) }));
    END
}
END
PRIVATE FN typeAnalysisSession__match_subject_plan(self: TypeAnalysisSession, MUTABLE node: MatchStatement) RETURNS !MatchSubjectPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE expr_t = TRY (type__new(&node.expr.full_type_mut("MATCH subject")));
    IF TRY (type__string?(expr_t)) THEN
      node.string_match = TRUE;
    END
    MUTABLE type_name_branch_value: ?String@symbol = NIL;
    IF type__generic_instance?(expr_t) THEN
      type_name_branch_value = type__generic_base(expr_t);
    ELSE
      type_name_branch_value = type__resolved(expr_t);
    END
    MUTABLE type_name: String@symbol = type_name_branch_value?;
    MUTABLE schema: ?MatchSchema = CAST(typeAnalysisSession__lookup_type_schema(rtoc_self_view, type_name) AS ?MatchSchema);
    MUTABLE is_enum = schemas__enum?(castOptionalMatchSchemaToOptionalSchemaValue(schema));
    MUTABLE is_union = schemas__union?(castOptionalMatchSchemaToOptionalSchemaValue(schema));
    RETURN MatchSubjectPlan{ expr_type: COPY expr_t, type_name: COPY type_name, schema: COPY schema, enum_subject: is_enum, union_subject: is_union, union_subst: COPY typeAnalysisSession__match_union_substitution(rtoc_self_view, expr_t, schema, is_union) };
}
END
PRIVATE FN typeAnalysisSession__match_union_substitution(self: TypeAnalysisSession, expr_t: Type, schema: ?MatchSchema, is_union: Bool) RETURNS !{String@symbol}String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(is_union) THEN
      RETURN {};
    END
    IF !(type__generic_instance?(expr_t)) THEN
      RETURN {};
    END
    MUTABLE union_schema: UnionSchema@multiowned = COPY castOptionalMatchSchemaToUnionSchemaMultiowned(schema);
    MUTABLE type_params = COPY union_schema.type_params;
    IF (type_params.length() == 0) THEN
      RETURN {};
    END
    MUTABLE subst: {String@symbol}String@symbol = {};
    (type_params.zip(TRY (type__generic_args(expr_t)))).keys() |> EACH {
    MUTABLE a: Any = ((type_params.zip(TRY (type__generic_args(expr_t))))[_] OR_ELSE panic("missing hash key"));
    IF !(a) THEN
      CONTINUE;
    END
    subst[_] = a.resolved();
    };
    RETURN subst;
}
END
PRIVATE FN typeAnalysisSession__match_union_schema(self: TypeAnalysisSession, plan: MatchSubjectPlan) RETURNS UnionSchema@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN KEEP castOptionalMatchSchemaToUnionSchemaMultiowned(plan.schema);
}
END
PRIVATE FN typeAnalysisSession__match_enum_schema(self: TypeAnalysisSession, plan: MatchSubjectPlan) RETURNS EnumSchema@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN KEEP castOptionalMatchSchemaToEnumSchemaMultiowned(plan.schema);
}
END
PRIVATE FN typeAnalysisSession__consume_match_subject_if_takes_mut(self: TypeAnalysisSession, node: MatchStatement, plan: MatchSubjectPlan) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE expr = COPY node.expr;
    IF !(((node.takes AND matchSubjectPlan__union?(plan)) AND expr IS_A Identifier)) THEN
      RETURN;
    END
    MUTABLE source_name = expr.name();
    MUTABLE graph_node: ?OwnershipNode = COPY ownershipGraph__get_index(typeAnalysisSession__ownership_graph(rtoc_self_view), source_name);
    IF graph_node EXISTS AS graph_node_value THEN
      IF (graph_node_value.kind != :borrowed) THEN
        expr.was_moved = TRUE;
        TRY (typeAnalysisSession__og_set_moved(rtoc_self_view, source_name, expr.token(), :takes));
      ELSE
        RETURN;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__analyze_match_case_mut(MUTABLE self: TypeAnalysisSession, node: MatchStatement, match_case: MatchCase, plan: MatchSubjectPlan) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (match_case.kind == :when) THEN
      typeAnalysisSession__analyze_when_match_case_mut(&rtoc_self_view, node, match_case);
    ELSE_IF (match_case.kind == :struct_pattern) THEN
      MUTABLE pattern = COPY match_case.value;
      IF pattern IS_A StructPattern THEN
        typeAnalysisSession__annotate_struct_pattern_mut(&rtoc_self_view, node, pattern);
      END
    ELSE
      typeAnalysisSession__analyze_value_match_case_mut(&rtoc_self_view, node, match_case, plan);
    END
}
END
PRIVATE FN typeAnalysisSession__analyze_when_match_case_mut(MUTABLE self: TypeAnalysisSession, node: MatchStatement, match_case: MatchCase) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, match_case.value));
    IF (match_case.value.resolved_type() == :Bool) THEN
      RETURN;
    END
    typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :WHEN_NEEDS_BOOL }, [], {:got: match_case.value.resolved_type()});
}
END
PRIVATE FN typeAnalysisSession__analyze_value_match_case_mut(MUTABLE self: TypeAnalysisSession, node: MatchStatement, match_case: MatchCase, plan: MatchSubjectPlan) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__visit_match_patterns_mut(&rtoc_self_view, node, match_case);
    typeAnalysisSession__validate_match_pattern_types_mut(rtoc_self_view, node, match_case, plan);
    typeAnalysisSession__declare_match_payload_binding_mut(rtoc_self_view, node, match_case, plan);
    typeAnalysisSession__declare_match_destructure_bindings_mut(rtoc_self_view, node, match_case, plan);
}
END
PRIVATE FN typeAnalysisSession__visit_match_patterns_mut(MUTABLE self: TypeAnalysisSession, node: MatchStatement, match_case: MatchCase) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__with_match_pattern_context(rtoc_self_view, %() USE(match_case, node, MUTABLE rtoc_self_view) -> {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, match_case.value));
    FOR _ IN match_case.extra_values DO
    IF _ IS_A StructPattern AS struct_pattern THEN
        MUTABLE struct_pattern_mutable = COPY struct_pattern;
        typeAnalysisSession__annotate_struct_pattern_mut(&rtoc_self_view, node, struct_pattern_mutable);
    ELSE
        TRY (typeAnalysisSession__visit(&rtoc_self_view, _));
    END
    END
    NIL
    });
}
END
PRIVATE FN typeAnalysisSession__validate_match_pattern_types_mut(self: TypeAnalysisSession, node: MatchStatement, match_case: MatchCase, plan: MatchSubjectPlan) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rtoc_each_items_331 = ([match_case.value] + (match_case.extra_values));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_331.length() DO
      IF typeAnalysisSession__match_pattern_type_matches_subject?(rtoc_self_view, &rtoc_each_items_331[rtoc_idx], node, plan) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :MATCH_CASE_TYPE_MISMATCH }, [], {:case: rtoc_each_items_331[rtoc_idx].resolved_type(), :expr: node.expr.resolved_type()});
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PRIVATE FN typeAnalysisSession__match_pattern_type_matches_subject?(self: TypeAnalysisSession, MUTABLE pattern: Locatable, node: MatchStatement, plan: MatchSubjectPlan) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE case_type = TRY (type__new(&pattern.full_type_mut("MATCH pattern")));
    IF (pattern.resolved_type() == node.expr.resolved_type()) THEN
      RETURN TRUE;
    END
    IF ((node.expr.resolved_type() == :Any) OR (pattern.resolved_type() == :Any)) THEN
      RETURN TRUE;
    END
    IF (type__generic_instance?(plan.expr_type) AND (type__generic_base(plan.expr_type) == pattern.resolved_type())) THEN
      RETURN TRUE;
    END
    IF (type__optional?(plan.expr_type) AND TRY (type__accepts?(UNWRAP (TRY (type__wrapped_type(plan.expr_type))), case_type))) THEN
      RETURN TRUE;
    END
    IF (TRY (type__string?(plan.expr_type)) AND TRY (type__string?(case_type))) THEN
      RETURN TRUE;
    END
    RETURN FALSE;
}
END
PRIVATE FN typeAnalysisSession__declare_match_payload_binding_mut(self: TypeAnalysisSession, node: MatchStatement, match_case: MatchCase, plan: MatchSubjectPlan) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE binding: ?String = COPY match_case.binding;
    IF binding EXISTS AS binding_value THEN
      IF matchSubjectPlan__enum?(plan) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :MATCH_ENUM_CAPTURE }, [], {:binding: binding_value});
        RETURN;
      END
      IF !(matchSubjectPlan__union?(plan)) THEN
        RETURN;
      END
      MUTABLE union_schema = typeAnalysisSession__match_union_schema(rtoc_self_view, plan);
      MUTABLE variant_name: ?String = typeAnalysisSession__match_variant_name(rtoc_self_view, match_case.value);
      typeAnalysisSession__verify_match_multi_arm_payloads_mut(rtoc_self_view, node, match_case, union_schema, variant_name, plan.union_subst, "AS", binding_value);
      IF variant_name EXISTS AS variant_name_value THEN
        typeAnalysisSession__declare_union_payload_binding_mut(rtoc_self_view, node, match_case, plan, variant_name_value, binding_value);
      ELSE
        RETURN;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__declare_union_payload_binding_mut(self: TypeAnalysisSession, node: MatchStatement, MUTABLE match_case: MatchCase, plan: MatchSubjectPlan, variant_name: String, binding: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE raw_payload: ?SchemasUnionSchemaVariantValue = COPY typeAnalysisSession__match_union_schema(rtoc_self_view, plan).variants[symbol(variant_name)];
    IF raw_payload EXISTS AS raw_payload_value THEN
      MUTABLE raw_payload_value_mutable = COPY raw_payload_value;
      MUTABLE payload_type = typeAnalysisSession__match_payload_binding_type(rtoc_self_view, plan, variant_name, castSchemasUnionSchemaVariantValueToOptionalMatchPayload(raw_payload_value_mutable), &match_case);
      MUTABLE rtoc_mutable_receiver_332 = typeAnalysisSession__current_scope(rtoc_self_view);
      TRY (scope__declare(&rtoc_mutable_receiver_332, binding, SymbolEntryRegInput{ MatchCase: COPY match_case }, SymbolEntryTypeInput{ TypeMultiowned: COPY payload_type }, ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
      typeAnalysisSession__og_declare(rtoc_self_view, binding, Node{ MatchCase: COPY match_case }, TypeTypeInput{ Type: COPY payload_type });
      typeAnalysisSession__classify_ownership_mut(rtoc_self_view, { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_333 = typeAnalysisSession__current_scope(rtoc_self_view);
      scope__local_entry_mut(rtoc_local_receiver_333, binding) });
      IF !(node.takes) THEN
        typeAnalysisSession__borrow_match_payload_binding_mut(rtoc_self_view, binding);
      END
    ELSE
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :MATCH_UNIT_CAPTURE }, [], {:binding: binding, :variant: variant_name});
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__match_payload_binding_type(self: TypeAnalysisSession, plan: MatchSubjectPlan, variant_name: String, raw_payload: ?MatchPayload, MUTABLE match_case: MatchCase) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE payload = COPY UNWRAP (raw_payload);
    IF payload IS_A InlineStructVariant AS inline_struct_variant THEN
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("${plan.type_name}_${variant_name}") }));
    END
    IF (IF payload IS_A Type AS type THEN type__indirect?(type) ELSE FALSE END) THEN
      MUTABLE inner_type = COPY payload;
      &inner_type.strip_layout_mut();
      match_case.indirect_payload_as = TRUE;
      RETURN CAST(typeAnalysisSession__apply_type_subst(rtoc_self_view, castMatchPayloadToTypeTypeInput(inner_type), plan.union_subst) AS Type);
    END
    RETURN CAST(typeAnalysisSession__apply_type_subst(rtoc_self_view, castMatchPayloadToTypeTypeInput(payload), plan.union_subst) AS Type);
}
END
PRIVATE FN typeAnalysisSession__borrow_match_payload_binding_mut(self: TypeAnalysisSession, binding: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rtoc_writer_receiver_334: OwnershipNode = UNWRAP (ownershipGraph__get_index(typeAnalysisSession__ownership_graph(rtoc_self_view), binding));
    rtoc_writer_receiver_334.kind = :borrowed;
    MUTABLE rtoc_mutable_receiver_336 = ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_335 = typeAnalysisSession__current_scope(rtoc_self_view);
    scope__entry_for_write_mut(&rtoc_mutable_receiver_335, binding) });
    symbolEntry__set_storage(&rtoc_mutable_receiver_336, :borrow);
}
END
PRIVATE FN typeAnalysisSession__declare_match_destructure_bindings_mut(self: TypeAnalysisSession, node: MatchStatement, match_case: MatchCase, plan: MatchSubjectPlan) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE destructure: ?StructPattern = COPY match_case.destructure;
    IF destructure EXISTS AS destructure_value THEN
      MUTABLE destructure_value_mutable = COPY destructure_value;
      IF matchSubjectPlan__union?(plan) THEN
        TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ StructPattern: COPY destructure_value_mutable }, &node.expr.full_type_mut("union destructure subject")));
        MUTABLE variant_name: ?String = typeAnalysisSession__match_variant_name(rtoc_self_view, match_case.value);
        MUTABLE union_schema = typeAnalysisSession__match_union_schema(rtoc_self_view, plan);
        typeAnalysisSession__verify_match_multi_arm_payloads_mut(rtoc_self_view, node, match_case, union_schema, variant_name, plan.union_subst, "destructure", "{ ... }");
        IF variant_name EXISTS AS variant_name_value THEN
          MUTABLE payload_schema: ?MatchSchema = typeAnalysisSession__match_payload_struct_schema(rtoc_self_view, plan, variant_name_value);
          IF payload_schema? IS_A StructSchema AS struct_schema THEN
            typeAnalysisSession__declare_match_destructure_fields_mut(rtoc_self_view, node, destructure_value_mutable, MatchSchema{ StructSchemaMultiowned: COPY struct_schema }, variant_name_value);
          END
        ELSE
          RETURN;
        END
      ELSE
        RETURN;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__match_payload_struct_schema(self: TypeAnalysisSession, plan: MatchSubjectPlan, variant_name: String) RETURNS !?MatchSchema
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE raw_payload: ?SchemasUnionSchemaVariantValue = COPY typeAnalysisSession__match_union_schema(rtoc_self_view, plan).variants[symbol(variant_name)];
    IF raw_payload? IS_A InlineStructVariant AS inline_struct_variant THEN
      MUTABLE inline_payload: InlineStructVariant@multiowned = CAST(inline_struct_variant AS InlineStructVariant@multiowned);
      RETURN MatchSchema{ StructSchemaMultiowned: COPY TRY (structSchema__new(( { MUTABLE rtoc_transform_values_result_337: {String@symbol}StructField = {}; FOR rtoc_key IN inline_payload.fields.keys() DO rtoc_transform_values_result_337[rtoc_key] = { MUTABLE rtoc_value_block_marker = 0;
    MUTABLE t: TypeTypeInput = (inline_payload.fields[rtoc_key] OR_ELSE CAST(panic("missing hash key") AS TypeTypeInput));
      StructField{ type: COPY t, default: NIL, borrowed: FALSE }
      }; END rtoc_transform_values_result_337 } ), ( { MUTABLE rtoc_empty_list_338: []String@symbol = List[]; rtoc_empty_list_338 } ), ( { MUTABLE rtoc_empty_list_339: []GenericParamDecl = List[]; rtoc_empty_list_339 } ), {}, {})) };
    END
    IF raw_payload? IS_A Type AS type THEN
      MUTABLE payload_type_sym = type__resolved(type);
      payload_type_sym = COPY (plan.union_subst[payload_type_sym] OR_ELSE payload_type_sym);
      RETURN CAST(typeAnalysisSession__lookup_type_schema(rtoc_self_view, payload_type_sym) AS ?MatchSchema);
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__declare_match_destructure_fields_mut(self: TypeAnalysisSession, node: MatchStatement, destructure: StructPattern, payload_schema: MatchSchema, variant_name: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE struct_schema: StructSchema@multiowned = COPY castMatchSchemaToStructSchemaMultiowned(payload_schema);
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < destructure.fields.length() DO
      IF !(patternField__bind?(destructure.fields[rtoc_idx]?)) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !(struct_schema.fields.contains?(destructure.fields[rtoc_idx]?.name)) THEN
          typeAnalysisSession__emit_unknown_destructure_field_mut(rtoc_self_view, node, destructure.fields[rtoc_idx]?, struct_schema, variant_name);
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE field_type = structField__type((struct_schema.fields[destructure.fields[rtoc_idx]?.name]?));
      MUTABLE rtoc_mutable_receiver_340 = typeAnalysisSession__current_scope(rtoc_self_view);
      TRY (scope__declare(&rtoc_mutable_receiver_340, destructure.fields[rtoc_idx]?.name, NIL, castTypeToOptionalSymbolEntryTypeInput(field_type), ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
      typeAnalysisSession__og_declare(rtoc_self_view, destructure.fields[rtoc_idx]?.name, NIL, castTypeToTypeTypeInput(field_type));
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PRIVATE FN typeAnalysisSession__emit_unknown_destructure_field_mut(self: TypeAnalysisSession, node: MatchStatement, field: PatternField, payload_schema: StructSchema, variant_name: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE name_tok: ?Token@multiowned = COPY KEEP field.name_token;
    IF name_tok EXISTS AS name_tok_value THEN
      MUTABLE valid_fields = payload_schema.fields.keys() |> WHERE !(_.startsWith?("_"));
      typeAnalysisSession__emit_typo_suggestion_mut(rtoc_self_view, TypoToken{ TokenMultiowned: COPY name_tok_value }, field.name, valid_fields, "MATCH destructure: field '${field.name}' is not on variant ${variant_name}", "field of variant ${variant_name}", :type, TRUE);
    ELSE
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :MATCH_DESTRUCTURE_FIELD_UNKNOWN }, [], {:field: field.name, :variant: variant_name});
    END
}
END
PRIVATE FN typeAnalysisSession__reject_duplicate_match_patterns_mut(self: TypeAnalysisSession, node: MatchStatement, plan: MatchSubjectPlan) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((matchSubjectPlan__enum?(plan) OR matchSubjectPlan__union?(plan))) THEN
      RETURN;
    END
    MUTABLE seen: {String}Bool = {};
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < node.cases.length() DO
      IF ((node.cases[rtoc_idx].kind() == :when) OR (node.cases[rtoc_idx].kind() == :struct_pattern)) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      FOR _ IN typeAnalysisSession__match_variant_names(rtoc_self_view, node.cases[rtoc_idx]) DO
        IF seen[_] THEN
            typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :MATCH_DUPLICATE_PATTERN }, [], {:variant: _});
        END
        seen[_] = TRUE;
      END
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PRIVATE FN typeAnalysisSession__check_match_exhaustiveness_mut(self: TypeAnalysisSession, node: MatchStatement, plan: MatchSubjectPlan) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(node.exhaustive) THEN
      RETURN;
    END
    IF !((matchSubjectPlan__enum?(plan) OR matchSubjectPlan__union?(plan))) THEN
      typeAnalysisSession__emit_match_partial_fix_mut(rtoc_self_view, node, :MATCH_NEEDS_ENUM_OR_UNION, {:type: DiagnosticKwValue{ StringValue: CAST(type__resolved(plan.expr_type) AS String) }});
    END
    IF node.default_case EXISTS AS default_case_value THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :MATCH_FORBIDS_DEFAULT });
    END
    IF node.cases |> ANY (matchCase__kind(_) == :when) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :MATCH_FORBIDS_WHEN });
    END
    typeAnalysisSession__emit_missing_match_variants_mut(rtoc_self_view, node, plan);
}
END
PRIVATE FN typeAnalysisSession__emit_missing_match_variants_mut(self: TypeAnalysisSession, node: MatchStatement, plan: MatchSubjectPlan) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((matchSubjectPlan__enum?(plan) OR matchSubjectPlan__union?(plan))) THEN
      RETURN;
    END
    MUTABLE covered = (node.cases |> UNNEST typeAnalysisSession__match_variant_names(rtoc_self_view, _)) |> DISTINCT _;
    MUTABLE all_variants: [Set]String@symbol = Set[];
    IF matchSubjectPlan__enum?(plan) THEN
      all_variants = typeAnalysisSession__match_enum_schema(rtoc_self_view, plan).variants |> DISTINCT _;
    ELSE
      all_variants = typeAnalysisSession__match_union_schema(rtoc_self_view, plan).variants.keys() |> DISTINCT _;
    END
    MUTABLE missing = (all_variants - covered);
    IF missing.empty?() THEN
      RETURN;
    END
    MUTABLE type_label: String = "";
    IF matchSubjectPlan__enum?(plan) THEN
      type_label = "enum";
    ELSE
      type_label = "union";
    END
    typeAnalysisSession__emit_match_partial_fix_mut(rtoc_self_view, node, :MATCH_NON_EXHAUSTIVE, {:kind: DiagnosticKwValue{ StringValue: COPY type_label }, :name: DiagnosticKwValue{ SymbolValue: COPY plan.type_name }, :missing: (missing |> ORDER_BY _).join(", ")});
}
END
PRIVATE FN typeAnalysisSession__visit_PassStmt(self: TypeAnalysisSession, MUTABLE node: PassStmt) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ PassStmt: COPY node }, :Void));
}
END
PRIVATE FN typeAnalysisSession__visit_DeferStmt(MUTABLE self: TypeAnalysisSession, MUTABLE node: DeferStmt) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN node.body DO
    TRY (typeAnalysisSession__visit(&rtoc_self_view, _));
    END
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node, :Void));
}
END
PRIVATE FN typeAnalysisSession__visit_MatchStatement(MUTABLE self: TypeAnalysisSession, MUTABLE node: MatchStatement) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.expr));
    MUTABLE plan = typeAnalysisSession__match_subject_plan(rtoc_self_view, &node);
    typeAnalysisSession__consume_match_subject_if_takes_mut(rtoc_self_view, node, plan);
    MUTABLE branches: FN() -> []Any@multiowned = ( { MUTABLE rtoc_empty_list_341: FN() -> []Any@multiowned = List[]; rtoc_empty_list_341 } );
    FOR _ IN node.cases DO
    &branches.append(Kernel.proc(%() USE(node, plan, _, MUTABLE rtoc_self_view) -> {
    typeAnalysisSession__analyze_match_case_mut(&rtoc_self_view, node, _, plan);
    typeAnalysisSession__with_conditional_context(rtoc_self_view, %() USE(_, MUTABLE rtoc_self_view) -> {
      rtoc_lambda_result_342 = TRY (typeAnalysisSession__visit_stmts(&rtoc_self_view, matchCase__body(_)));
      rtoc_lambda_result_342
    });
    typeAnalysisSession__collect_scope_drops(rtoc_self_view, node)
    }));
    END
    IF node.default_case EXISTS AS default_case_value THEN
      MUTABLE default_case_value_mutable = COPY default_case_value;
      &branches.append(Kernel.proc(%() USE(node, MUTABLE rtoc_self_view) -> {
    typeAnalysisSession__with_conditional_context(rtoc_self_view, %() USE(node, MUTABLE rtoc_self_view) -> {
      rtoc_lambda_result_343 = TRY (typeAnalysisSession__visit_stmts(&rtoc_self_view, default_case_value_mutable));
      rtoc_lambda_result_343
    });
    typeAnalysisSession__collect_scope_drops(rtoc_self_view, node)
      }));
    END
    MUTABLE all_drops: []Any@multiowned = typeAnalysisSession__analyze_control_flow_branches(rtoc_self_view, branches);
    IF node.default_case EXISTS AS default_case_value THEN
      node.default_drops = UNWRAP (&all_drops.pop());
    END
    node.case_drops = all_drops;
    typeAnalysisSession__reject_duplicate_match_patterns_mut(rtoc_self_view, node, plan);
    typeAnalysisSession__check_match_exhaustiveness_mut(rtoc_self_view, node, plan);
    node.case_result_types = node.cases |> SELECT typeAnalysisSession__expr_result_type(rtoc_self_view, matchCase__body(_));
    node.default_result_type = typeAnalysisSession__expr_result_type(rtoc_self_view, (node.default_case OR_ELSE List[]));
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ MatchStatement: COPY node }, :Void));
}
END
PRIVATE FN typeAnalysisSession__visit_ForRange(MUTABLE self: TypeAnalysisSession, MUTABLE node: ForRange) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.start_expr));
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.end_expr));
    MUTABLE start_type = node.start_expr.resolved_type();
    MUTABLE end_type = node.end_expr.resolved_type();
    IF !((start_type == :Int64)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :FOR_RANGE_START_NEEDS_INT64 }, [], {:got: start_type});
    END
    IF !((end_type == :Int64)) THEN
