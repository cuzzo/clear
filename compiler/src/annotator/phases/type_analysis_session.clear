    END
    IF declared_type EXISTS AS declared_type_value THEN
      typeAnalysisSession__validate_rank_initializer_mut(rtoc_self_view, node, declared_type_value);
    END
    typeAnalysisSession__validate_stream_type_mut(rtoc_self_view, node);
    typeAnalysisSession__materialize_inferred_wrapper_annotation_mut(rtoc_self_view, &node);
    typeAnalysisSession__reject_implicit_wrapper_binding_mut(rtoc_self_view, node);
    typeAnalysisSession__promote_pipe_to_observable_dest_mut(rtoc_self_view, &node);
    IF !(typeAnalysisSession__validate_observable_binding_initializer_mut(rtoc_self_view, node)) THEN
      RETURN;
    END
    MUTABLE final_type, error = &value.coerce_mut((MATCH node START DeclarationNode.VarDecl AS item -> item.type, DeclarationNode.BindExpr AS item -> item.type END));
    IF error THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :TYPE_COERCION_FAILED }, [], {:detail: error});
    END
    IF (value IS_A CapabilityWrap AND (((value.ownership() OR value.sync()) OR value.layout()))) THEN
      MUTABLE capability_target_branch_value: ?Type = NIL;
      IF (MATCH node START DeclarationNode.VarDecl AS item -> item.type, DeclarationNode.BindExpr AS item -> item.type END) THEN
        capability_target_branch_value = TRY (type__new(castTypeToTypeConstructionInput((MATCH node START DeclarationNode.VarDecl AS item -> item.type, DeclarationNode.BindExpr AS item -> item.type END))));
      ELSE
        capability_target_branch_value = TRY (type__new(&value.full_type_mut("capability declaration value")));
      END
      MUTABLE capability_target: Type = capability_target_branch_value?;
      TRY (type__merge_capabilities_from_mut(&capability_target, &value.full_type_mut("capability declaration value")));
      value.coerced_type = capability_target;
      final_type = capability_target;
    END
    IF aST__empty_auto_collection_literal_decl?(castDeclarationNodeToOptionalLocatable(node)) THEN
      final_type = value.type_object();
    END
    typeAnalysisSession__check_prefixed_int_range_mut(rtoc_self_view, value, (value.coerced_type_info() OR final_type));
    typeAnalysisSession__propagate_declared_type_to_value_mut(rtoc_self_view, node, castTypeToAnnotationTypeShape(final_type));
    MUTABLE storage = typeAnalysisSession__finalize_decl_storage_mut(rtoc_self_view, castDeclarationNodeToAllocDeclarationNode(node), castTypeToFinalType(final_type));
    typeAnalysisSession__propagate_collection_metadata_mut(rtoc_self_view, &node, castTypeToAnnotationTypeShape(final_type));
    typeAnalysisSession__propagate_call_flags_mut(rtoc_self_view, castDeclarationNodeToAnnotationNode(node));
    typeAnalysisSession__set_cleanup_alloc_mut(rtoc_self_view, castDeclarationNodeToNode(node));
    MUTABLE resource_result = typeAnalysisSession__resolve_resource_close(rtoc_self_view, castDeclarationNodeToLocatable(node));
    MATCH node START
      DeclarationNode.VarDecl AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.resource_close_plan = COPY KEEP resource_result.close_plan;
        node = DeclarationNode{ VarDecl: item_mutable };,
      DeclarationNode.BindExpr AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.resource_close_plan = COPY KEEP resource_result.close_plan;
        node = DeclarationNode{ BindExpr: item_mutable };,
    END
    MUTABLE node_type = &node.full_type_mut("var declaration");
    IF (resource_result.is_resource AND respondsTo?(node_type, "is_resource=")) THEN
      node_type.is_resource = TRUE;
    END
    TRY (capabilities__validate_mut(castDeclarationNodeToLocatable(node), node_type, %(n, msg) USE(rtoc_self_view) -> {
    typeAnalysisSession__error_mut(rtoc_self_view, n, TypeAnalysisCodeOrMessage{ SymbolValue: :CAPABILITY_INVALID }, [], {:detail: msg});
    rubyToClearVoid()
    }));
    MUTABLE node_sync = node_type.sync();
    MUTABLE node_layout = node_type.layout();
    MUTABLE scope_type_branch_value: ?Type = NIL;
    IF TRY (type__collection_value?(node_type)) THEN
      MUTABLE ft = TRY (type__new(castTypeToTypeConstructionInput(final_type)));
      TRY (type__copy_collection_shape_from_mut(&ft, node_type));
      TRY (type__copy_element_capabilities_from_mut(&ft, node_type));
      scope_type_branch_value = ft;
    ELSE
      scope_type_branch_value = final_type;
    END
    MUTABLE scope_type: Type = scope_type_branch_value?;
    MUTABLE rtoc_mutable_receiver_368 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_368, (MATCH node START DeclarationNode.VarDecl AS item -> item.name, DeclarationNode.BindExpr AS item -> item.name END), castDeclarationNodeToOptionalSymbolEntryRegInput(node), castTypeToOptionalSymbolEntryTypeInput(scope_type), ScopeMutabilityInput{ BoolValue: mutable_flag }, FALSE, (MATCH node START DeclarationNode.VarDecl AS item -> item.slot_size, DeclarationNode.BindExpr AS item -> item.slot_size END), storage, Set[], ( { MUTABLE rtoc_empty_list_367: []SymbolEntry@multiowned = List[]; rtoc_empty_list_367 } ), node_sync, node_layout, resource_result.is_resource, KEEP resource_result.close_plan));
    typeAnalysisSession__record_capture_local_mut(rtoc_self_view, (MATCH node START DeclarationNode.VarDecl AS item -> CAST(item.name AS String), DeclarationNode.BindExpr AS item -> CAST(item.name AS String) END));
    MATCH node START
      DeclarationNode.VarDecl AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.symbol = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_369 = typeAnalysisSession__current_scope(rtoc_self_view);
    scope__local_entry_mut(rtoc_local_receiver_369, (MATCH node START DeclarationNode.VarDecl AS item -> item.name, DeclarationNode.BindExpr AS item -> item.name END)) };
        node = DeclarationNode{ VarDecl: item_mutable };,
      DeclarationNode.BindExpr AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.symbol = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_369 = typeAnalysisSession__current_scope(rtoc_self_view);
    scope__local_entry_mut(rtoc_local_receiver_369, (MATCH node START DeclarationNode.VarDecl AS item -> item.name, DeclarationNode.BindExpr AS item -> item.name END)) };
        node = DeclarationNode{ BindExpr: item_mutable };,
    END
    MUTABLE sym = UNWRAP ((MATCH node START DeclarationNode.VarDecl AS item -> item.symbol, DeclarationNode.BindExpr AS item -> item.symbol END));
    IF value IS_A BgBlock THEN
      symbolEntry__set_async_result_shape(&sym, value.async_result_shape());
    END
    MUTABLE val_ti = &value.full_type_mut("declaration link source value");
    IF (IF val_ti != NIL THEN
      type__link?(val_ti)
    ELSE
      NIL
    END) THEN
      MUTABLE link_src = val_ti.link_source();
      IF link_src THEN
        symbolEntry__set_link_source(&sym, link_src);
      END
    END
    IF type__observable?(node_type) THEN
      TRY (symbolEntry__mark_non_escaping_mut(&sym));
    END
    IF (type__versioned?(node_type) AND (type__ownership(node_type) == :affine)) THEN
      MUTABLE cap_tok = IF value IS_A CapabilityWrap THEN
        value.token()
      ELSE
        NIL
      END;
      MUTABLE fixes = List[];
      IF (TRUE AND (CAST(cap_tok.value() AS String) == "@versioned")) THEN
        &fixes.append(TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :UPGRADE_VERSIONED_TO_SHARED), [edit__new(span__new(NIL, cap_tok.line(), cap_tok.column(), "@versioned".codepointCount()), "@shared:versioned")], :auto)));
      END
      IF fixes |> ANY _ THEN
        typeAnalysisSession__fixable_mut(rtoc_self_view, node, :lint, fixes, NIL, :BARE_VERSIONED_UNSHARED, :warning, FALSE, {:name: (MATCH node START DeclarationNode.VarDecl AS item -> item.name, DeclarationNode.BindExpr AS item -> item.name END)});
      ELSE
        typeAnalysisSession__note_mut(rtoc_self_view, castDeclarationNodeToLocatable(node), typeAnalysisSession__diagnostic_message(rtoc_self_view, :BARE_VERSIONED_UNSHARED, [], {:name: (MATCH node START DeclarationNode.VarDecl AS item -> item.name, DeclarationNode.BindExpr AS item -> item.name END)}));
      END
    END
    typeAnalysisSession__classify_ownership_mut(rtoc_self_view, &sym);
    typeAnalysisSession__og_declare(rtoc_self_view, (MATCH node START DeclarationNode.VarDecl AS item -> item.name, DeclarationNode.BindExpr AS item -> item.name END), castDeclarationNodeToOptionalNode(node), node_type);
    typeAnalysisSession__establish_inferred_alias_mut(rtoc_self_view, node, &sym);
    typeAnalysisSession__register_container_borrow_mut(rtoc_self_view, &node);
    IF !(TRY (type__implicitly_copyable?(node_type, %(t) USE(rtoc_self_view) -> typeAnalysisSession__lookup_type_schema(rtoc_self_view, t)))) THEN
      IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
            MUTABLE rtoc_mutable_receiver_371 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
            functionContext__mark_runtime_used_mut(&rtoc_mutable_receiver_371);
      END
    END
    typeAnalysisSession__accumulate_stack_bytes(rtoc_self_view, storage, node);
    typeAnalysisSession__track_union_alias(rtoc_self_view, (MATCH node START DeclarationNode.VarDecl AS item -> item.name, DeclarationNode.BindExpr AS item -> item.name END), &value);
    typeAnalysisSession__record_capability_binding(rtoc_self_view, (MATCH node START DeclarationNode.VarDecl AS item -> item.name, DeclarationNode.BindExpr AS item -> item.name END), castDeclarationNodeToLocatable(node), castTypeToFinalType(final_type), storage);
    NIL;
}
END
PRIVATE FN typeAnalysisSession__materialize_inferred_wrapper_annotation_mut(self: TypeAnalysisSession, MUTABLE node: DeclarationNode) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE declared: ?Type = NIL;
    MATCH node START
      DeclarationNode.VarDecl AS item ->
        declared = COPY item.type;,
      DeclarationNode.BindExpr AS item ->
        declared = COPY item.type;,
    END
    IF declared EXISTS AS declared_value THEN
      MUTABLE wants_future = (type__future?(declared_value) AND (type__resolved((TRY (type__tense_type(declared_value)))) == symbol("Auto")));
      MUTABLE wants_error = (type__error_union?(declared_value) AND (type__resolved((TRY (type__success_type(declared_value)))) == symbol("Auto")));
      MUTABLE wants_optional = (type__optional?(declared_value) AND (type__resolved(UNWRAP (TRY (type__wrapped_type(declared_value)))) == symbol("Auto")));
      MUTABLE wants_error_optional = ((type__error_union?(declared_value) AND type__optional?((TRY (type__success_type(declared_value))))) AND (type__resolved(UNWRAP (TRY (type__wrapped_type((TRY (type__success_type(declared_value))))))) == symbol("Auto")));
      IF !((((wants_future OR wants_error) OR wants_optional) OR wants_error_optional)) THEN
        RETURN;
      END
      MUTABLE value_type = TRY (type__new((MATCH node START DeclarationNode.VarDecl AS item -> &item.value.full_type_mut("inferred wrapper binding"), DeclarationNode.BindExpr AS item -> &item.value.full_type_mut("inferred wrapper binding") END)));
      MUTABLE error_type: ?Type@multiowned = typeAnalysisSession__recoverable_result_type(rtoc_self_view, (MATCH node START DeclarationNode.VarDecl AS item -> item.value, DeclarationNode.BindExpr AS item -> item.value END), "inferred wrapper binding");
      MUTABLE payload_branch_value: ?Type = NIL;
      IF type__error_union?(value_type) THEN
        payload_branch_value = TRY (type__success_type(value_type));
      ELSE_IF (IF error_type != NIL THEN
        type__error_union?(error_type)
      ELSE
        NIL
      END) THEN
        payload_branch_value = TRY (type__success_type(error_type));
      ELSE
        payload_branch_value = value_type;
      END
      MUTABLE payload: Type = payload_branch_value?;
      MUTABLE selected_type = COPY declared_value;
      IF wants_future THEN
        IF type__future?(value_type) THEN
          selected_type = COPY value_type;
        ELSE
          selected_type = declared_value;
        END
      ELSE_IF wants_error_optional THEN
        IF (type__error_union?(value_type) AND type__optional?((TRY (type__success_type(value_type))))) THEN
          selected_type = COPY value_type;
        ELSE_IF ((!((error_type == NIL)) AND type__error_union?(error_type)) AND type__optional?(payload)) THEN
          selected_type = CAST(KEEP error_type AS Type);
        ELSE
          selected_type = TRY (type__error_union_of(castTypeToTypeTypeInput(TRY (type__optional_of(castTypeToTypeTypeInput(payload))))));
        END
      ELSE_IF wants_error THEN
        IF type__error_union?(value_type) THEN
          selected_type = value_type;
        ELSE_IF (!((error_type == NIL)) AND type__error_union?(error_type)) THEN
          selected_type = CAST(error_type AS Type);
        ELSE
          selected_type = TRY (type__error_union_of(castTypeToTypeTypeInput(payload)));
        END
      ELSE
        IF type__optional?(payload) THEN
          selected_type = COPY payload;
        ELSE
          selected_type = TRY (type__optional_of(castTypeToTypeTypeInput(payload)));
        END
      END
      MATCH node START
        DeclarationNode.VarDecl AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.type = selected_type;
          node = DeclarationNode{ VarDecl: item_mutable };,
        DeclarationNode.BindExpr AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.type = selected_type;
          node = DeclarationNode{ BindExpr: item_mutable };,
      END
      IF (wants_error OR wants_error_optional) THEN
        MUTABLE value_node: Any = NIL;
        MATCH node START
          DeclarationNode.VarDecl AS item ->
            value_node = COPY item.value;,
          DeclarationNode.BindExpr AS item ->
            value_node = COPY item.value;,
        END
        IF respondsTo?(value_node, "retain_error_channel=") THEN
          value_node.retain_error_channel = TRUE;
        END
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__reject_implicit_wrapper_binding_mut(self: TypeAnalysisSession, node: DeclarationNode, MUTABLE process_deferred_copy: Bool = FALSE) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (MATCH node START DeclarationNode.VarDecl AS item -> item.type, DeclarationNode.BindExpr AS item -> item.type END) THEN
      RETURN;
    END
    MUTABLE value: Any = NIL;
    MATCH node START
      DeclarationNode.VarDecl AS item ->
        value = COPY item.value;,
      DeclarationNode.BindExpr AS item ->
        value = COPY item.value;,
    END
    IF (value IS_A CopyNode AND !(process_deferred_copy)) THEN
      &rtoc_self_view.traversal_state.deferred_copy_wrapper_bindings.append(node);
      RETURN;
    END
    MUTABLE error_type: ?Type@multiowned = typeAnalysisSession__recoverable_result_type(rtoc_self_view, &value, "inferred wrapper binding");
    MUTABLE error_success_type_branch_value: ?Type = NIL;
    IF (IF error_type != NIL THEN
      type__error_union?(error_type)
    ELSE
      NIL
    END) THEN
      error_success_type_branch_value = TRY (type__success_type(error_type));
    ELSE
      error_success_type_branch_value = NIL;
    END
    MUTABLE error_success_type: ?Type = error_success_type_branch_value;
    MUTABLE value_type = TRY (type__new(&value.full_type_mut("inferred wrapper binding")));
    MUTABLE asynchronous = (((type__future?(value_type) OR TRY (type__stream?(value_type))) OR type__future?(error_success_type)) OR TRY (type__stream?(error_success_type)));
    IF asynchronous THEN
      typeAnalysisSession__emit_inferred_async_binding_mut(rtoc_self_view, node, value_type, CAST(error_type AS ?Type));
      RETURN;
    END
    MUTABLE fallible = !((error_type == NIL));
    IF fallible THEN
      typeAnalysisSession__emit_inferred_wrapper_binding_mut(rtoc_self_view, node, :INFERRED_FALLIBLE_BINDING, "TRY ", "!");
      RETURN;
    END
    IF !(type__optional?(value_type)) THEN
      RETURN;
    END
    IF (respondsTo?(value, "safe_nav_chain") AND (value.safe_nav_chain() == TRUE)) THEN
      RETURN;
    END
    typeAnalysisSession__emit_inferred_wrapper_binding_mut(rtoc_self_view, node, :INFERRED_OPTIONAL_BINDING, "UNWRAP ", "?");
}
END
PRIVATE FN typeAnalysisSession__emit_inferred_async_binding_mut(self: TypeAnalysisSession, node: DeclarationNode, value_type: Type, error_type: ?Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE async_type_branch_value: ?Type = NIL;
    IF (IF error_type != NIL THEN
      type__error_union?(error_type)
    ELSE
      NIL
    END) THEN
      async_type_branch_value = TRY (type__success_type(error_type));
    ELSE
      async_type_branch_value = COPY value_type;
    END
    MUTABLE async_type: Type = async_type_branch_value?;
    MUTABLE stream = TRY (type__stream?(async_type));
    MUTABLE action: String = "";
    IF stream THEN
      action = "COLLECT";
    ELSE
      action = "NEXT";
    END
    MUTABLE wrapper = "~";
    MUTABLE value_token = (MATCH node START DeclarationNode.VarDecl AS item -> item.value.token(), DeclarationNode.BindExpr AS item -> item.value.token() END);
    MUTABLE fixes: []Fix = ( { MUTABLE rtoc_empty_list_372: []Fix = List[]; rtoc_empty_list_372 } );
    IF !(stream) THEN
      &fixes.append(TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :CONSUME_FUTURE_WITH_NEXT), [edit__new(span__new(NIL, value_token.line(), value_token.column(), 0), "NEXT ")], :auto)));
    ELSE
      MUTABLE value_range = (MATCH node START DeclarationNode.VarDecl AS item -> item.value.source_range(), DeclarationNode.BindExpr AS item -> item.value.source_range() END);
      &fixes.append(TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :CONSUME_STREAM_WITH_COLLECT), [edit__new(span__new(value_range.file(), span__end_line(value_range), value_range.end_column(), 0), " |> COLLECT")], :auto)));
    END
    IF node IS_A BindExpr AS bind_expr THEN
      &fixes.append(TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :RETAIN_ASYNC_WRAPPER, {:kind: DiagnosticKwValue{ StringValue: COPY IF stream THEN
        "stream"
      ELSE
        "future"
      END }}), [edit__new(span__new(NIL, bind_expr.token.line, (bind_expr.token.column + scopeBindings__length(bind_expr.name)), 0), ":${wrapper}")], :auto)));
    END
    typeAnalysisSession__fixable_mut(rtoc_self_view, node, :type, fixes, NIL, :INFERRED_ASYNC_BINDING, :error, TRUE, {:name: (MATCH node START DeclarationNode.VarDecl AS item -> item.name, DeclarationNode.BindExpr AS item -> item.name END), :expected_action: action});
}
END
PRIVATE FN typeAnalysisSession__emit_inferred_wrapper_binding_mut(self: TypeAnalysisSession, node: DeclarationNode, code: String@symbol, prefix: String, wrapper: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE value_range = (MATCH node START DeclarationNode.VarDecl AS item -> item.value.source_range(), DeclarationNode.BindExpr AS item -> item.value.source_range() END);
    MUTABLE wraps_expression = (MATCH node START DeclarationNode.VarDecl AS item -> item.value IS_A BinaryOp, DeclarationNode.BindExpr AS item -> item.value IS_A BinaryOp END);
    MUTABLE fixes = [TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :MAKE_VALUE_RECOVERY_EXPLICIT), (CAST([edit__new(span__new(NIL, token__start_line(value_range), token__start_column(value_range), 0), IF wraps_expression THEN
      "${prefix}("
    ELSE
      prefix
    END)] AS []Edit) + ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_374: ?[]Edit = NIL;
    IF wraps_expression THEN
      rtoc_ternary_value_374 = [edit__new(span__new(NIL, span__end_line(value_range), value_range.end_column(), 0), ")")];
    ELSE
      rtoc_ternary_value_374 = List[];
    END
    rtoc_ternary_value_374? })), :auto))];
    IF node IS_A BindExpr AS bind_expr THEN
      &fixes.append(TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :RETAIN_VALUE_WRAPPER, {:kind: DiagnosticKwValue{ StringValue: COPY IF (wrapper == "!") THEN
        "fallible"
      ELSE
        "optional"
      END }}), [edit__new(span__new(NIL, bind_expr.token.line, (bind_expr.token.column + scopeBindings__length(bind_expr.name)), 0), ":${wrapper}")], :auto)));
    END
    typeAnalysisSession__fixable_mut(rtoc_self_view, node, :type, fixes, NIL, code, :error, TRUE, {:name: (MATCH node START DeclarationNode.VarDecl AS item -> item.name, DeclarationNode.BindExpr AS item -> item.name END)});
}
END
PRIVATE FN typeAnalysisSession__validate_rank_initializer_mut(self: TypeAnalysisSession, node: DeclarationNode, declared_type: Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(type__rank?(declared_type)) THEN
      RETURN;
    END
    IF !((MATCH node START DeclarationNode.VarDecl AS item -> item.value IS_A ListLit, DeclarationNode.BindExpr AS item -> item.value IS_A ListLit END)) THEN
      RETURN;
    END
    MUTABLE item_count = scopeBindings__length((MATCH node START DeclarationNode.VarDecl AS item -> item.value.items(), DeclarationNode.BindExpr AS item -> item.value.items() END));
    IF (TRY (type__fixed_rank?(declared_type)) AND (item_count != UNWRAP (type__capacity(declared_type)))) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :RANK_LITERAL_SIZE }, [], {:expected: UNWRAP (type__capacity(declared_type)), :got: item_count});
    END
    IF (TRY (type__dynamic_rank?(declared_type)) AND (item_count != 0)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :RANK_DYNAMIC_LITERAL_NEEDS_SHAPE });
    END
}
END
PRIVATE FN typeAnalysisSession__validate_observable_binding_initializer_mut(self: TypeAnalysisSession, node: DeclarationNode) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(((((MATCH node START DeclarationNode.VarDecl AS item -> item.type, DeclarationNode.BindExpr AS item -> item.type END) != NIL) AND type__future?((((MATCH node START DeclarationNode.VarDecl AS item -> item.type, DeclarationNode.BindExpr AS item -> item.type END))?))) AND (MATCH node START DeclarationNode.VarDecl AS item -> type__observable?(item.type), DeclarationNode.BindExpr AS item -> type__observable?(item.type) END))) THEN
      RETURN TRUE;
    END
    MUTABLE pipe: Any = NIL;
    MATCH node START
      DeclarationNode.VarDecl AS item ->
        pipe = COPY item.value;,
      DeclarationNode.BindExpr AS item ->
        pipe = COPY item.value;,
    END
    MUTABLE ok = ((pipe IS_A BinaryOp AND pipe.smooth?()) AND pipe.observable_dest());
    IF ok THEN
      RETURN TRUE;
    END
    MUTABLE fixes: []Fix@multiowned = typeAnalysisSession__observable_binding_drop_fixes(rtoc_self_view, node);
    IF (fixes.length() == 0) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :OBSERVABLE_BINDING_NEEDS_FOLD_PIPE });
      RETURN FALSE;
    END
    typeAnalysisSession__fixable_mut(rtoc_self_view, node, :type, fixes, NIL, :OBSERVABLE_BINDING_NEEDS_FOLD_PIPE, :error, FALSE);
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__observable_binding_drop_fixes(self: TypeAnalysisSession, node: DeclarationNode) RETURNS ![]Fix
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE obs_tok: ?Token@multiowned = NIL;
    MUTABLE fixes: []Fix = ( { MUTABLE rtoc_empty_list_375: []Fix = List[]; rtoc_empty_list_375 } );
    IF (MATCH node START DeclarationNode.VarDecl AS item -> TRUE, DeclarationNode.BindExpr AS item -> TRUE END) THEN
      obs_tok = (MATCH node START DeclarationNode.VarDecl AS item -> type__observable_token(item.type), DeclarationNode.BindExpr AS item -> type__observable_token(item.type) END);
    END
    IF obs_tok EXISTS AS obs_tok_value THEN
      MUTABLE tok_text = COPY CAST(obs_tok_value.value AS String);
      &fixes.append(TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :DROP_OBSERVABLE_CAPABILITY, {:token: DiagnosticKwValue{ StringValue: COPY tok_text }}), [edit__new(span__new(NIL, obs_tok_value.line, obs_tok_value.column, tok_text.codepointCount()), "")], :interactive)));
      RETURN fixes;
    ELSE
      RETURN fixes;
    END
}
END
PRIVATE FN typeAnalysisSession__visit_BindExpr(MUTABLE self: TypeAnalysisSession, MUTABLE node: BindExpr) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF typeAnalysisSession__bind_declares_new_symbol?(rtoc_self_view, node, typeAnalysisSession__current_scope(rtoc_self_view)) THEN
      typeAnalysisSession__prepare_implicit_ownership_transport_mut(rtoc_self_view, DeclarationNode{ BindExpr: COPY node });
    END
    typeAnalysisSession__visit_declaration_value_mut(&rtoc_self_view, DeclarationNode{ BindExpr: COPY node });
    MUTABLE scope = typeAnalysisSession__current_scope(rtoc_self_view);
    IF typeAnalysisSession__bind_declares_new_symbol?(rtoc_self_view, node, scope) THEN
      typeAnalysisSession__finalize_bind_declaration_mut(rtoc_self_view, &node);
    ELSE_IF scope__is_immutable?(scope, node.name) THEN
      typeAnalysisSession__reject_immutable_bind_assignment_mut(rtoc_self_view, &node, scope);
    ELSE
      typeAnalysisSession__finalize_bind_assignment_mut(rtoc_self_view, &node, scope);
    END
}
END
PRIVATE FN typeAnalysisSession__visit_declaration_value_mut(MUTABLE self: TypeAnalysisSession, node: DeclarationNode) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE declared: ?Type = NIL;
    MATCH node START
      DeclarationNode.VarDecl AS item ->
        declared = COPY item.type;,
      DeclarationNode.BindExpr AS item ->
        declared = COPY item.type;,
    END
    MUTABLE value_node: Any = NIL;
    MATCH node START
      DeclarationNode.VarDecl AS item ->
        value_node = COPY item.value;,
      DeclarationNode.BindExpr AS item ->
        value_node = COPY item.value;,
    END
    IF (value_node IS_A BgBlock AND ((declared != NIL) AND TRY (type__single_future?((declared?))))) THEN
      MUTABLE payload = TRY (type__tense_type(declared));
      IF (((payload AND !(type__dynamic?(payload))) AND !(type__auto?(payload))) AND !(([symbol("Auto"), :Any]).contains?(type__resolved(payload)))) THEN
        value_node.declared_async_payload = payload;
      END
    END
    IF (value_node IS_A ListLit AND (((MATCH node START DeclarationNode.VarDecl AS item -> item.type, DeclarationNode.BindExpr AS item -> item.type END) != NIL) AND type__fixed?((((MATCH node START DeclarationNode.VarDecl AS item -> item.type, DeclarationNode.BindExpr AS item -> item.type END))?)))) THEN
      value_node.storage = :stack;
    END
    IF (value_node IS_A ListLit AND (((MATCH node START DeclarationNode.VarDecl AS item -> item.type, DeclarationNode.BindExpr AS item -> item.type END) != NIL) AND type__tuple?((((MATCH node START DeclarationNode.VarDecl AS item -> item.type, DeclarationNode.BindExpr AS item -> item.type END))?)))) THEN
      value_node.coerced_type = (MATCH node START DeclarationNode.VarDecl AS item -> item.type, DeclarationNode.BindExpr AS item -> item.type END);
    END
    IF (value_node IS_A HashLit AND (((MATCH node START DeclarationNode.VarDecl AS item -> item.type, DeclarationNode.BindExpr AS item -> item.type END) != NIL) AND type__map?((((MATCH node START DeclarationNode.VarDecl AS item -> item.type, DeclarationNode.BindExpr AS item -> item.type END))?)))) THEN
      value_node.coerced_type = (MATCH node START DeclarationNode.VarDecl AS item -> item.type, DeclarationNode.BindExpr AS item -> item.type END);
    END
    TRY (typeAnalysisSession__visit(&rtoc_self_view, value_node));
}
END
PRIVATE FN typeAnalysisSession__prepare_implicit_ownership_transport_mut(self: TypeAnalysisSession, MUTABLE node: DeclarationNode) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE detail: String = "";
    MUTABLE plan: Any = NIL;
    MATCH node START
      DeclarationNode.VarDecl AS item ->
        plan = COPY item.ownership_transport_plan;,
      DeclarationNode.BindExpr AS item ->
        plan = COPY item.ownership_transport_plan;,
    END
    IF (typeAnalysisSession__language_mode(rtoc_self_view) == :strict) THEN
      RETURN;
    END
    IF !(plan IS_A OwnershipTransportPlan) THEN
      MUTABLE source: Any = NIL;
      MATCH node START
        DeclarationNode.VarDecl AS item ->
          source = COPY item.value;,
        DeclarationNode.BindExpr AS item ->
          source = COPY item.value;,
      END
      IF !(ownershipTransportFacts__source?(source)) THEN
        RETURN;
      END
      MUTABLE source_name = ownershipTransportFacts__source_display(source);
      MATCH node START
        DeclarationNode.VarDecl AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.ownership_transport_plan = OwnershipTransportPlan{ action: :pending, source: COPY source_name, destination: COPY (MATCH node START DeclarationNode.VarDecl AS item -> CAST(item.name AS String), DeclarationNode.BindExpr AS item -> CAST(item.name AS String) END), alias_root: COPY source_name, last_alias_use: NIL, conflicting_mutation: NIL, hidden_cost: NIL };
          node = DeclarationNode{ VarDecl: item_mutable };,
        DeclarationNode.BindExpr AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.ownership_transport_plan = OwnershipTransportPlan{ action: :pending, source: COPY source_name, destination: COPY (MATCH node START DeclarationNode.VarDecl AS item -> CAST(item.name AS String), DeclarationNode.BindExpr AS item -> CAST(item.name AS String) END), alias_root: COPY source_name, last_alias_use: NIL, conflicting_mutation: NIL, hidden_cost: NIL };
          node = DeclarationNode{ BindExpr: item_mutable };,
      END
      RETURN;
    END
    IF (plan.action() == :pending) THEN
      RETURN;
    END
    IF (plan.action() == :move) THEN
      RETURN;
    END
    MUTABLE source_type = (MATCH node START DeclarationNode.VarDecl AS item -> &item.value.full_type_mut("implicit ownership transport source"), DeclarationNode.BindExpr AS item -> &item.value.full_type_mut("implicit ownership transport source") END);
    IF TRY (type__implicitly_copyable?(source_type, %(name) USE(rtoc_self_view) -> typeAnalysisSession__lookup_type_schema(rtoc_self_view, name))) THEN
      RETURN;
    END
    IF plan.conflicting_mutation() THEN
      MUTABLE mutation = plan.conflicting_mutation();
      MUTABLE last_line = (((IF plan.last_alias_use() != NIL THEN
        (plan.last_alias_use()).token().line()
      ELSE
        NIL
      END) OR_ELSE (IF mutation.token() != NIL THEN
        (mutation.token()).line()
      ELSE
        NIL
      END)) OR (MATCH node START DeclarationNode.VarDecl AS item -> item.token.line, DeclarationNode.BindExpr AS item -> item.token.line END));
      detail = "Aliasing Error: `${plan.destination()} = ${plan.source()}` creates an inferred alias, but mutation occurs on line ${((IF mutation.token() != NIL THEN
        (mutation.token()).line()
      ELSE
        NIL
      END) OR_ELSE (MATCH node START DeclarationNode.VarDecl AS item -> item.token.line, DeclarationNode.BindExpr AS item -> item.token.line END))} while `${plan.destination()}` remains live through line ${last_line}. CLEAR will not infer snapshot-versus-shared mutation semantics in EASY, DEFAULT, or STRICT. Write `${plan.destination()} = COPY ${plan.source()}` for an independent value, or explicitly use @multiowned/@shared and `KEEP ${plan.source()}`.";
      MUTABLE source_token = (MATCH node START DeclarationNode.VarDecl AS item -> item.value.token(), DeclarationNode.BindExpr AS item -> item.value.token() END);
      MUTABLE fixes: []Fix = [TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :PREFIX_COPY_SNAPSHOT), [edit__new(span__new(NIL, source_token.line(), source_token.column(), 0), "COPY ")], :interactive))];
      IF (TRY (type__any_rc?(source_type)) OR type__split?(source_type)) THEN
        &fixes.append(TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :PREFIX_EXPLICIT_OWNERSHIP_COST, {:keyword: DiagnosticKwValue{ StringValue: COPY "KEEP" }}), [edit__new(span__new(NIL, source_token.line(), source_token.column(), 0), "KEEP ")], :interactive)));
      END
      typeAnalysisSession__fixable_mut(rtoc_self_view, mutation, :ownership, fixes, NIL, :INFERRED_ALIAS_MUTATION, :error, TRUE, {:detail: detail});
    END
    IF (plan.action() == :borrow) THEN
      node.storage = :borrow;
      RETURN;
    END
    IF !((plan.action() == :materialize)) THEN
      RETURN;
    END
    MATCH node START
      DeclarationNode.VarDecl AS item ->
        source = COPY item.value;,
      DeclarationNode.BindExpr AS item ->
        source = COPY item.value;,
    END
    source_type = &source.full_type_mut("implicit ownership materialization source");
    MUTABLE keyword: String = "";
    IF (TRY (type__any_rc?(source_type)) OR type__split?(source_type)) THEN
      keyword = "KEEP";
    ELSE
      keyword = "COPY";
    END
    IF ((typeAnalysisSession__language_mode(rtoc_self_view) == :strict) AND (keyword == "COPY")) THEN
      detail = "STRICT ownership cost: `${plan.destination()} = ${plan.source()}` requires an implicit ${IF (keyword == "KEEP") THEN
        "reference-count retain"
      ELSE
        "deep copy"
      END}. Write `${plan.destination()} = ${keyword} ${plan.source()}` explicitly, or shorten the lifetime so this is a move/borrow.";
      typeAnalysisSession__fixable_mut(rtoc_self_view, node, :ownership, [TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :PREFIX_EXPLICIT_OWNERSHIP_COST, {:keyword: DiagnosticKwValue{ StringValue: COPY keyword }}), [edit__new(span__new(NIL, source.token().line(), source.token().column(), 0), "${keyword} ")], :auto))], NIL, :STRICT_IMPLICIT_OWNERSHIP_COST, :error, TRUE, {:detail: detail});
    END
    MUTABLE wrapper =   IF (keyword == "KEEP") THEN
      KeepNode{ token: COPY source.token(), value: COPY source, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, carrier_op: NIL }
    ELSE
      CopyNode{ token: COPY source.token(), value: COPY source, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, deep_copy: NIL, carrier_op: NIL, own: NIL, alloc: NIL }
    END;
    MATCH node START
      DeclarationNode.VarDecl AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.value = wrapper;
        node = DeclarationNode{ VarDecl: item_mutable };,
      DeclarationNode.BindExpr AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.value = wrapper;
        node = DeclarationNode{ BindExpr: item_mutable };,
    END
}
END
PRIVATE FN typeAnalysisSession__finalize_ownership_transport_facts_mut(self: TypeAnalysisSession, facts: OwnershipTransportFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rtoc_each_items_377 = (TRY (ownershipTransportFacts__decisions(facts)));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_377.length() DO
      MUTABLE node = COPY KEEP (rtoc_each_items_377[rtoc_idx]?.alias_fact).declaration;
      node.ownership_transport_plan = COPY rtoc_each_items_377[rtoc_idx]?.plan;
      IF ((rtoc_each_items_377[rtoc_idx]?.plan).action == :move) THEN
          typeAnalysisSession__handle_assign_move(rtoc_self_view, node);
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE previous_value = node.value();
      typeAnalysisSession__prepare_implicit_ownership_transport_mut(rtoc_self_view, &node);
      IF !(node.value().equal?(previous_value)) THEN
          MUTABLE wrapper = node.value();
          typeAnalysisSession__record_capture_site_mut(rtoc_self_view, wrapper, TRUE);
          IF wrapper IS_A KeepNode THEN
            typeAnalysisSession__finish_previsited_keep_mut(rtoc_self_view, &wrapper);
          ELSE
            typeAnalysisSession__finish_previsited_copy_mut(rtoc_self_view, CAST(wrapper AS CopyNode));
          END
      END
      MUTABLE symbol = IF TRUE THEN
          aST__node__symbol(node)
        ELSE
          NIL
        END;
      IF symbol IS_A SymbolEntry THEN
          typeAnalysisSession__establish_inferred_alias_mut(rtoc_self_view, node, &symbol);
      END
    rtoc_idx = rtoc_idx + 1;
    END
    FOR _ IN (TRY (ownershipTransportFacts__transfer_decisions(facts))) DO
    typeAnalysisSession__finalize_pending_transfer_mut(rtoc_self_view, _);
    END
}
END
PRIVATE FN typeAnalysisSession__finalize_pending_transfer_mut(self: TypeAnalysisSession, decision: TransferDecision) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE transfer = COPY decision.transfer;
    MUTABLE source = COPY transfer.source;
    IF decision.materialize THEN
      IF (respondsTo?(transfer.container, "implicit_layout_cost") AND (transfer.container.implicit_layout_cost() == TRUE)) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, source, TypeAnalysisCodeOrMessage{ SymbolValue: :INDIRECT_TRANSFER_REQUIRES_COPY }, [], {:name: source.name});
      END
      MUTABLE source_type = &source.full_type_mut("finalized ownership transfer");
      MUTABLE wrapper =     IF (TRY (type__any_rc?(source_type)) OR type__split?(source_type)) THEN
        KeepNode{ token: COPY source.token, value: Locatable{ Identifier: COPY source }, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, carrier_op: NIL }
      ELSE
        CopyNode{ token: COPY source.token, value: Locatable{ Identifier: COPY source }, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, deep_copy: NIL, carrier_op: NIL, own: NIL, alloc: NIL }
      END;
      typeAnalysisSession__record_capture_site_mut(rtoc_self_view, wrapper, TRUE);
      IF wrapper IS_A KeepNode THEN
        typeAnalysisSession__finish_previsited_keep_mut(rtoc_self_view, &wrapper);
      ELSE
        typeAnalysisSession__finish_previsited_copy_mut(rtoc_self_view, CAST(wrapper AS CopyNode));
      END
      MUTABLE container = COPY transfer.container;
      IF container IS_A FuncCall AS func_call THEN
        MUTABLE func_call_mutable = COPY func_call;
        func_call_mutable.args[CAST(KEEP transfer.slot AS Int64)] = wrapper;
      ELSE_IF (container IS_A MethodCall) THEN
        MUTABLE index: Int64 = COPY CAST(KEEP transfer.slot AS Int64);
        IF index.zero?() THEN
          container.object = wrapper;
        ELSE
          MUTABLE rtoc_index_receiver_378 = container.args();
          rtoc_index_receiver_378[(index - 1)] = wrapper;
        END
      ELSE_IF container IS_A StructLit AS struct_lit THEN
        MUTABLE struct_lit_mutable = COPY struct_lit;
        struct_lit_mutable.fields[CAST(KEEP transfer.slot AS String)] = wrapper;
      ELSE_IF container IS_A Assignment AS assignment THEN
        MUTABLE assignment_mutable = COPY assignment;
        assignment_mutable.value = wrapper;
      END
    ELSE
      source.was_moved = TRUE;
      IF respondsTo?(transfer.container, "was_moved=") THEN
        transfer.container.was_moved = TRUE;
      END
      TRY (typeAnalysisSession__og_set_moved(rtoc_self_view, source.name, source.token, :move));
    END
}
END
PRIVATE FN typeAnalysisSession__establish_inferred_alias_mut(self: TypeAnalysisSession, node: DeclarationNode, MUTABLE symbol: SymbolEntry) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE plan: Any = NIL;
    MATCH node START
      DeclarationNode.VarDecl AS item ->
        plan = COPY item.ownership_transport_plan;,
      DeclarationNode.BindExpr AS item ->
        plan = COPY item.ownership_transport_plan;,
    END
    IF !(plan IS_A OwnershipTransportPlan) THEN
      RETURN;
    END
    IF (typeAnalysisSession__language_mode(rtoc_self_view) == :strict) THEN
      RETURN;
    END
    IF (plan.action() == :pending) THEN
      RETURN;
    END
    IF ((plan.action() == :move) OR (plan.last_alias_use() == NIL)) THEN
      RETURN;
    END
    MUTABLE source_type = (MATCH node START DeclarationNode.VarDecl AS item -> &item.value.full_type_mut("inferred alias source"), DeclarationNode.BindExpr AS item -> &item.value.full_type_mut("inferred alias source") END);
    IF TRY (type__implicitly_copyable?(source_type, %(name) USE(rtoc_self_view) -> typeAnalysisSession__lookup_type_schema(rtoc_self_view, name))) THEN
      RETURN;
    END
    IF !((plan.action() == :borrow)) THEN
      RETURN;
    END
    TRY (symbolEntry__mark_non_escaping_mut(&symbol));
    symbolEntry__mark_borrowed_alias_mut(&symbol);
    MUTABLE graph_node: ?OwnershipNode = COPY ownershipGraph__get_index(typeAnalysisSession__ownership_graph(rtoc_self_view), plan.destination());
    IF graph_node EXISTS AS graph_node_value THEN
      MUTABLE graph_node_value_mutable = COPY graph_node_value;
      graph_node_value_mutable.kind = :borrowed;
    END
}
END
PRIVATE FN typeAnalysisSession__finalize_var_declaration_mut(self: TypeAnalysisSession, MUTABLE node: VarDecl) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    typeAnalysisSession__promote_declaration_value_mut(rtoc_self_view, DeclarationNode{ VarDecl: COPY node });
    typeAnalysisSession__finalize_decl_node_mut(rtoc_self_view, DeclarationNode{ VarDecl: COPY node }, node.mutable);
    typeAnalysisSession__stamp_init_contents_heap_mut(rtoc_self_view, DeclNode{ VarDecl: COPY node });
    typeAnalysisSession__stamp_bg_handle_lifetime_mut(rtoc_self_view, DeclNode{ VarDecl: COPY node });
    typeAnalysisSession__propagate_carrier_polymorphic_mut(rtoc_self_view, DeclarationNode{ VarDecl: COPY node });
}
END
PRIVATE FN typeAnalysisSession__propagate_carrier_polymorphic_mut(self: TypeAnalysisSession, node: DeclarationNode) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rhs: Any = NIL;
    MATCH node START
      DeclarationNode.VarDecl AS item ->
        rhs = COPY item.value;,
      DeclarationNode.BindExpr AS item ->
        rhs = COPY item.value;,
    END
    IF rhs IS_A MoveNode THEN
      rhs = rhs.value();
    END
    IF !(rhs IS_A Identifier) THEN
      RETURN;
    END
    MUTABLE src = rhs.symbol();
    IF !((src IS_A SymbolEntry@multiowned AND symbolEntry__carrier_polymorphic(src))) THEN
      RETURN;
    END
    MUTABLE dest: ?SymbolEntry@multiowned = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_379 = typeAnalysisSession__current_scope(rtoc_self_view);
    scope__resolve_entry(rtoc_local_receiver_379, (MATCH node START DeclarationNode.VarDecl AS item -> CAST(item.name AS String), DeclarationNode.BindExpr AS item -> CAST(item.name AS String) END)) };
    IF (dest != NIL) THEN
      symbolEntry__set_carrier_polymorphic(&dest, TRUE);
    END
}
END
PRIVATE FN typeAnalysisSession__promote_declaration_value_mut(self: TypeAnalysisSession, node: DeclarationNode) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (MATCH node START DeclarationNode.VarDecl AS item -> item.value IS_A IfStatement, DeclarationNode.BindExpr AS item -> item.value IS_A IfStatement END) THEN
      typeAnalysisSession__promote_to_expr_if_mut(rtoc_self_view, castDeclarationNodeToLocatable(node), (MATCH node START DeclarationNode.VarDecl AS item -> item.value, DeclarationNode.BindExpr AS item -> item.value END));
    END
    IF (MATCH node START DeclarationNode.VarDecl AS item -> item.value IS_A MatchStatement, DeclarationNode.BindExpr AS item -> item.value IS_A MatchStatement END) THEN
      typeAnalysisSession__promote_to_expr_match_mut(rtoc_self_view, castDeclarationNodeToLocatable(node), (MATCH node START DeclarationNode.VarDecl AS item -> item.value, DeclarationNode.BindExpr AS item -> item.value END));
    END
}
END
PRIVATE FN typeAnalysisSession__bind_declares_new_symbol?(self: TypeAnalysisSession, node: BindExpr, scope: Scope) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (!(scope__entry?(scope, node.name)) OR (node.name == "_"));
}
END
PRIVATE FN typeAnalysisSession__finalize_bind_declaration_mut(self: TypeAnalysisSession, MUTABLE node: BindExpr) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    typeAnalysisSession__promote_declaration_value_mut(rtoc_self_view, DeclarationNode{ BindExpr: COPY node });
    node.mode = :decl;
    typeAnalysisSession__finalize_decl_node_mut(rtoc_self_view, DeclarationNode{ BindExpr: COPY node }, FALSE);
    typeAnalysisSession__mark_borrowed_field_bind_alias_mut(rtoc_self_view, node);
    typeAnalysisSession__stamp_init_contents_heap_mut(rtoc_self_view, DeclNode{ BindExpr: COPY node });
    typeAnalysisSession__stamp_bg_handle_lifetime_mut(rtoc_self_view, DeclNode{ BindExpr: COPY node });
    typeAnalysisSession__propagate_carrier_polymorphic_mut(rtoc_self_view, DeclarationNode{ BindExpr: COPY node });
}
END
PRIVATE FN typeAnalysisSession__mark_borrowed_field_bind_alias_mut(self: TypeAnalysisSession, node: BindExpr) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((node.value IS_A StructLit AND node.value.borrowed_fields?())) THEN
      RETURN;
    END
    MUTABLE sym = COPY UNWRAP (node.symbol);
    TRY (symbolEntry__mark_non_escaping_mut(&sym));
    symbolEntry__mark_borrowed_alias_mut(&sym);
}
END
PRIVATE FN typeAnalysisSession__reject_immutable_bind_assignment_mut(self: TypeAnalysisSession, MUTABLE node: BindExpr, scope: Scope) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    node.symbol = scope__resolve_entry(scope, node.name);
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BindExpr: COPY node }, TRY (scope__resolve_type(scope, node.name))));
    typeAnalysisSession__emit_immutable_assignment_error_mut(rtoc_self_view, node, scope);
}
END
PRIVATE FN typeAnalysisSession__finalize_bind_assignment_mut(self: TypeAnalysisSession, MUTABLE node: BindExpr, scope: Scope) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    node.mode = :assign;
    typeAnalysisSession__verify_unrestricted_mut(rtoc_self_view, Node{ BindExpr: COPY node });
    typeAnalysisSession__promote_declaration_value_mut(rtoc_self_view, DeclarationNode{ BindExpr: COPY node });
    node.symbol = scope__entry_for_write(&scope, node.name);
    MUTABLE target_type = TRY (scope__resolve_type(scope, node.name));
    typeAnalysisSession__validate_assignment_type(rtoc_self_view, Node{ BindExpr: COPY node }, TypeTypeInput{ Type: COPY target_type }, node.value.resolved_type());
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BindExpr: COPY node }, target_type));
    typeAnalysisSession__handle_assign_move(rtoc_self_view, Node{ BindExpr: COPY node });
    typeAnalysisSession__handle_assign_borrow(rtoc_self_view, Node{ BindExpr: COPY node });
    typeAnalysisSession__mark_var_mutated(rtoc_self_view, node.name);
    typeAnalysisSession__og_set_live(rtoc_self_view, node.name);
    typeAnalysisSession__stamp_atomic_bind_assignment_mut(rtoc_self_view, &node, (IF scope__resolve_entry(scope, node.name) != NIL THEN
      { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_380 = (scope__resolve_entry(scope, node.name));
    symbolEntry__sync(rtoc_local_receiver_380) }
    ELSE
      NIL
    END));
}
END
PRIVATE FN typeAnalysisSession__stamp_atomic_bind_assignment_mut(self: TypeAnalysisSession, MUTABLE node: BindExpr, target_sync: ?String@symbol) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((target_sync == :atomic)) THEN
      RETURN;
    END
    MUTABLE op: ?String@symbol = typeAnalysisSession__atomic_bind_operation(rtoc_self_view, node);
    IF op EXISTS AS op_value THEN
      node.auto_atomic_op = op_value;
    END
    typeAnalysisSession__record_effect(rtoc_self_view, symbol("CONTENTION"));
}
END
PRIVATE FN typeAnalysisSession__atomic_bind_operation(self: TypeAnalysisSession, node: BindExpr) RETURNS ?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (node.compound_op == NIL) THEN
      RETURN :store;
    ELSE_IF (node.compound_op == :ADD) THEN
      RETURN :fetchAdd;
    ELSE_IF (node.compound_op == :SUB) THEN
      RETURN :fetchSub;
    ELSE_IF (node.compound_op == :MUL) OR (node.compound_op == :DIV) THEN
      MUTABLE op_str: String = "";
      IF (node.compound_op == :MUL) THEN
        op_str = "*=";
      ELSE
        op_str = "/=";
      END
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :ATOMIC_NO_MUL_DIV_COMPOUND }, [], {:op: op_str});
      RETURN NIL;
    ELSE
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :ATOMIC_UNSUPPORTED_COMPOUND }, [], {:op: node.compound_op});
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__visit_Identifier(self: TypeAnalysisSession, MUTABLE node: Identifier) RETURNS !?SymbolEntry@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    typeAnalysisSession__predicate_identifier_allowed_mut(rtoc_self_view, node);
    MUTABLE scope_branch_value: ?Scope@multiowned = NIL;
    IF (typeAnalysisSession__smooth_depth(rtoc_self_view) > 0) THEN
      scope_branch_value = typeAnalysisSession__lookup_scope_for(rtoc_self_view, node.name);
    ELSE
      scope_branch_value = typeAnalysisSession__resolve_variable_scope(rtoc_self_view, node.name);
    END
    MUTABLE scope: ?Scope@multiowned = scope_branch_value;
    IF scope EXISTS AS scope_value THEN
      MUTABLE scope_value_mutable = COPY scope_value;
      TRY (scope__check_validity_mut(scope_value_mutable, node.name));
      MUTABLE entry: ?SymbolEntry@multiowned = scope__resolve_entry(scope_value_mutable, node.name);
      MUTABLE raw_type_branch_value: ?Type@multiowned = NIL;
      IF entry EXISTS AS entry_value THEN
        raw_type_branch_value = (rtoc_self_view.traversal_state.value_type_refinements[entry_value.binding_id] OR_ELSE TRY (scope__resolve_full_type(scope_value_mutable, node.name)));
      ELSE
        raw_type_branch_value = TRY (scope__resolve_full_type(scope_value_mutable, node.name));
      END
      MUTABLE raw_type: Type@multiowned = raw_type_branch_value?;
      raw_type = TRY (typeAnalysisSession__refined_comptime_type_param_type(rtoc_self_view, CAST(raw_type AS Type)));
      IF (type__fn_type?(raw_type) AND ((entry != NIL) AND (symbolEntry__storage(entry) == :static))) THEN
        TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ Identifier: COPY node }, raw_type));
        node.fn_ref = TRUE;
      ELSE_IF ((TRUE AND type__atomic?(raw_type)) AND (type__layout(raw_type) != :indirect)) THEN
        TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ Identifier: COPY node }, TRY (type__new(castTypeShapeRawToTypeConstructionInput(type__raw(raw_type))))));
        typeAnalysisSession__record_effect(rtoc_self_view, symbol("CONTENTION"));
      ELSE
        TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ Identifier: COPY node }, raw_type));
      END
      IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_381 = typeAnalysisSession__ownership_graph(rtoc_self_view);
      ownershipGraph__moved?(rtoc_local_receiver_381, node.name) } THEN
        typeAnalysisSession__emit_use_of_moved_error_mut(rtoc_self_view, node, UNWRAP (ownershipGraph__get_index(typeAnalysisSession__ownership_graph(rtoc_self_view), node.name)));
      END
      MUTABLE owner: ?Scope@multiowned = typeAnalysisSession__lookup_scope_for(rtoc_self_view, node.name);
      IF owner != NIL THEN
            scope__mark_read(&owner, node.name);
      END
      IF owner != NIL THEN
        node.symbol = UNWRAP (scope__entry_for_write(&owner, node.name));
      ELSE
        node.symbol = NIL;
      END
      typeAnalysisSession__record_capture_identifier_mut(rtoc_self_view, node);
      MUTABLE rtoc_owned_return_382: ?SymbolEntry@multiowned = node.symbol;
      RETURN rtoc_owned_return_382;
    ELSE
      IF TRY (typeAnalysisSession__current_function_type_param?(rtoc_self_view, symbol(node.name))) THEN
        TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ Identifier: COPY node }, :Type));
        RETURN;
      END
      MUTABLE type_schema = typeAnalysisSession__lookup_type_schema(rtoc_self_view, symbol(node.name));
      IF type_schema THEN
        TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ Identifier: COPY node }, :Type));
        RETURN;
      END
      typeAnalysisSession__emit_typo_suggestion_mut(rtoc_self_view, TypoToken{ TokenMultiowned: COPY node.token }, node.name, (TRY (typeAnalysisSession__outer_scope_vars(rtoc_self_view))) |> SELECT COPY _, "Undefined variable '${node.name}'", "closest in-scope variable");
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__classify_ownership_mut(self: TypeAnalysisSession, MUTABLE entry: SymbolEntry) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE type_obj = symbolEntry__type(entry);
    IF type__fn_type?(type_obj) THEN
      RETURN;
    END
    MUTABLE ownership_kind: String@symbol = :affine;
    IF symbolEntry__resource(entry) THEN
      ownership_kind = :resource;
    ELSE_IF ((type__multiowned?(type_obj) OR type__shared?(type_obj)) OR symbolEntry__rc_stored?(entry)) THEN
      ownership_kind = :rc;
    ELSE_IF symbolEntry__sync(entry) THEN
      ownership_kind = :sync;
    ELSE_IF type__collection?(type_obj) THEN
      ownership_kind = :collection;
    ELSE_IF (!(symbolEntry__takes(entry)) AND TRY (type__implicitly_copyable?(type_obj, %(t) USE(rtoc_self_view) -> typeAnalysisSession__lookup_type_schema(rtoc_self_view, t)))) THEN
      ownership_kind = :value;
    END
    symbolEntry__set_ownership_kind(&entry, ownership_kind);
    RETURN ownership_kind;
}
END
PRIVATE FN typeAnalysisSession__track_union_alias(self: TypeAnalysisSession, var_name: String, MUTABLE value_node: Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((value_node IS_A FuncCall OR value_node IS_A MethodCall)) THEN
      RETURN;
    END
    MUTABLE ret_type = &value_node.full_type_mut("union alias return");
    IF !(ret_type) THEN
      RETURN;
    END
    MUTABLE ret_type_obj_branch_value: ?Type = NIL;
    IF ret_type IS_A Type THEN
      ret_type_obj_branch_value = ret_type;
    ELSE
      ret_type_obj_branch_value = TRY (type__new(ret_type));
    END
    MUTABLE ret_type_obj: Type = ret_type_obj_branch_value?;
    MUTABLE schema = typeAnalysisSession__lookup_type_schema(rtoc_self_view, type__resolved(ret_type_obj));
    IF !(schemas__union?(schema)) THEN
      RETURN;
    END
    MUTABLE has_heap = (((schema.variants() OR {}))) |> ANY TRY (type__variant_has_heap?(_._1));
    IF !(has_heap) THEN
      RETURN;
    END
    MUTABLE first_arg =   IF value_node IS_A MethodCall THEN
      value_node.object()
    ELSE_IF type__any?(value_node.args()) THEN
      value_node.args().first()
    ELSE
      NIL
    END;
    IF !(first_arg IS_A Identifier) THEN
      RETURN;
    END
    MUTABLE arg_type = first_arg.resolved_type();
    IF ((arg_type == type__resolved(ret_type_obj)) OR type__map?((&first_arg.full_type_mut({:context: "union alias source"})))) THEN
      MUTABLE rtoc_mutable_receiver_383 = typeAnalysisSession__ownership_graph(rtoc_self_view);
      TRY (ownershipGraph__add_edge(&rtoc_mutable_receiver_383, Edge{ from: COPY var_name, to: COPY first_arg.name(), kind: :aliases }));
    END
}
END
PRIVATE FN typeAnalysisSession__accumulate_stack_bytes(self: TypeAnalysisSession, storage: String@symbol, node: DeclarationNode) RETURNS ?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fn_ctx: ?FunctionContext@multiowned = typeAnalysisSession__current_fn_ctx(rtoc_self_view);
    IF !(((storage == :stack) AND (fn_ctx != NIL))) THEN
      RETURN;
    END
    MUTABLE bytes = ((((MATCH node START DeclarationNode.VarDecl AS item -> item.slot_size, DeclarationNode.BindExpr AS item -> item.slot_size END) OR_ELSE 1)) * 8);
    functionContext__record_stack_bytes_mut(&fn_ctx, bytes);
    RETURN bytes;
}
END
PRIVATE FN typeAnalysisSession__mark_var_mutated(self: TypeAnalysisSession, name: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE scope: ?Scope@multiowned = typeAnalysisSession__lookup_scope_for(rtoc_self_view, name);
    IF scope EXISTS AS scope_value THEN
      MUTABLE scope_value_mutable = COPY scope_value;
      MUTABLE entry: ?SymbolEntry@multiowned = scope__entry_for_write(&scope_value_mutable, name);
      IF entry EXISTS AS entry_value THEN
        MUTABLE entry_value_mutable = COPY entry_value;
        symbolEntry__mark_mutated_mut(&entry_value_mutable, TRUE);
        typeAnalysisSession__audit_mark_mutated(rtoc_self_view, name);
      ELSE
        RETURN;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__mark_var_mutated_via_call(self: TypeAnalysisSession, name: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE scope: ?Scope@multiowned = typeAnalysisSession__lookup_scope_for(rtoc_self_view, name);
    IF scope EXISTS AS scope_value THEN
      MUTABLE scope_value_mutable = COPY scope_value;
      MUTABLE entry: ?SymbolEntry@multiowned = scope__entry_for_write(&scope_value_mutable, name);
      IF entry EXISTS AS entry_value THEN
        MUTABLE entry_value_mutable = COPY entry_value;
        symbolEntry__mark_mutated_via_reference_mut(&entry_value_mutable);
        typeAnalysisSession__audit_mark_mutated(rtoc_self_view, name);
      ELSE
        RETURN;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__chain_root_name(self: TypeAnalysisSession, node: Locatable) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE curr: Locatable = COPY node;
    WHILE ((curr IS_A GetField OR curr IS_A GetIndex) OR curr IS_A OptionalUnwrap) DO
      curr = curr.target();
    END
    IF curr IS_A Identifier AS identifier THEN
      RETURN COPY identifier__name(identifier);
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN typeAnalysisSession__interior_mutable_access_path?(self: TypeAnalysisSession, node: AccessPathNode) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE curr: AccessPathNode = COPY node;
    WHILE TRUE DO
      MUTABLE type = &curr.full_type_mut("interior-mutable assignment path");
      IF symbolEntry__always_mutable_sync?(type.sync()) THEN
        RETURN TRUE;
      END
      IF !(((curr IS_A GetField OR curr IS_A GetIndex) OR curr IS_A OptionalUnwrap)) THEN
        BREAK;
      END
      curr = curr.target();
    END
    RETURN FALSE;
}
END
PRIVATE FN typeAnalysisSession__visit_Assignment(MUTABLE self: TypeAnalysisSession, MUTABLE node: Assignment) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE previous_auto_lock: ?String = COPY typeAnalysisSession__phase_traversal_state(rtoc_self_view).auto_locked_assign_name;
    MUTABLE auto_lock_name: ?String = previous_auto_lock;
    MUTABLE target = COPY node.name;
    IF target IS_A GetField AS get_field THEN
    IF get_field.target IS_A Identifier THEN
      MUTABLE tname = get_field.target.name();
      MUTABLE tscope: ?Scope@multiowned = typeAnalysisSession__lookup_scope_for(rtoc_self_view, tname);
      MUTABLE tsym: ?SymbolEntry@multiowned = NIL;
      IF tscope != NIL THEN
        tsym = COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_384 = (tscope?);
      scope__resolve_entry(rtoc_local_receiver_384, tname) };
      END
      IF (IF (IF (IF tsym != NIL THEN
        symbolEntry__locked?(tsym)
      ELSE
        NIL
      END) != NIL THEN (IF tsym != NIL THEN
        symbolEntry__locked?(tsym)
      ELSE
        NIL
      END) ELSE (IF tsym != NIL THEN
        symbolEntry__write_locked?(tsym)
      ELSE
        NIL
      END) END) != NIL THEN (IF (IF tsym != NIL THEN
        symbolEntry__locked?(tsym)
      ELSE
        NIL
      END) != NIL THEN (IF tsym != NIL THEN
        symbolEntry__locked?(tsym)
      ELSE
        NIL
      END) ELSE (IF tsym != NIL THEN
        symbolEntry__write_locked?(tsym)
      ELSE
        NIL
      END) END) ELSE (IF tsym != NIL THEN
        symbolEntry__atomic_ptr?(tsym)
      ELSE
        NIL
      END) END) THEN
        auto_lock_name = tname;
      END
    END
    END
    MUTABLE rtoc_writer_receiver_385: TraversalState = typeAnalysisSession__phase_traversal_state(rtoc_self_view);
    rtoc_writer_receiver_385.auto_locked_assign_name = auto_lock_name;
    DEFER MUTABLE rtoc_writer_receiver_386: TraversalState = typeAnalysisSession__phase_traversal_state(rtoc_self_view);
    rtoc_writer_receiver_386.auto_locked_assign_name = previous_auto_lock;
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.value));
    IF node.value IS_A IfStatement THEN
      typeAnalysisSession__promote_to_expr_if_mut(rtoc_self_view, Locatable{ Assignment: COPY node }, &node.value);
    END
    IF node.value IS_A MatchStatement THEN
      typeAnalysisSession__promote_to_expr_match_mut(rtoc_self_view, Locatable{ Assignment: COPY node }, &node.value);
    END
    typeAnalysisSession__verify_unrestricted_mut(rtoc_self_view, Node{ Assignment: COPY node });
    typeAnalysisSession__verify_tied_assignment_mut(rtoc_self_view, node);
    target = COPY node.name;
    IF target IS_A Identifier AS identifier THEN
      typeAnalysisSession__visit_assignment_variable(rtoc_self_view, identifier, node);
    ELSE_IF target IS_A GetIndex AS get_index THEN
      MUTABLE get_index_mutable = COPY get_index;
      typeAnalysisSession__visit_assignment_index(&rtoc_self_view, &get_index_mutable, node);
    ELSE_IF target IS_A GetField AS get_field THEN
      MUTABLE get_field_mutable = COPY get_field;
      typeAnalysisSession__visit_assignment_field(&rtoc_self_view, &get_field_mutable, &node);
    ELSE
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :INVALID_ASSIGNMENT_TARGET }, [], {:got: target.class()});
    END
    typeAnalysisSession__handle_assign_move(rtoc_self_view, Node{ Assignment: COPY node });
    typeAnalysisSession__handle_assign_borrow(rtoc_self_view, Node{ Assignment: COPY node });
    IF node.name IS_A Identifier THEN
      RETURN typeAnalysisSession__og_set_live(rtoc_self_view, node.name.name());
    END
}
END
PRIVATE FN typeAnalysisSession__visit_assignment_variable(self: TypeAnalysisSession, identifier: Identifier, MUTABLE node: Assignment) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE var_name = COPY identifier.name;
    MUTABLE scope = typeAnalysisSession__current_scope(rtoc_self_view);
    IF !(scope__entry?(scope, var_name)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :ASSIGN_UNDEFINED_VAR }, [], {:name: var_name});
    END
    IF scope__is_immutable?(scope, var_name) THEN
      MUTABLE fix: ?Fix@multiowned = typeAnalysisSession__build_declare_mutable_fix(rtoc_self_view, var_name, scope);
      IF fix EXISTS AS fix_value THEN
        typeAnalysisSession__fixable_mut(rtoc_self_view, node, :ownership, [fix_value], NIL, :ASSIGN_VAR_IMMUTABLE, :error, FALSE, {:name: var_name});
      ELSE
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :ASSIGN_VAR_IMMUTABLE }, [], {:name: var_name});
      END
    END
    MUTABLE expected_type = TRY (scope__resolve_full_type(scope, var_name));
    IF (((typeAnalysisSession__language_mode(rtoc_self_view) != :strict) AND node.value IS_A Identifier) AND !(TRY (type__implicitly_copyable?((&node.value.full_type_mut("pending binding assignment")), %(name) USE(rtoc_self_view) -> typeAnalysisSession__lookup_type_schema(rtoc_self_view, name))))) THEN
      node.value.ownership_pending_transfer = TRUE;
    END
    typeAnalysisSession__validate_assignment_type(rtoc_self_view, Node{ Assignment: COPY node }, TypeTypeInput{ Type: COPY TRY (scope__resolve_type(scope, var_name)) }, node.value.resolved_type());
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ Assignment: COPY node }, TRY (scope__resolve_type(scope, var_name))));
    MUTABLE entry: ?SymbolEntry@multiowned = scope__resolve_entry(scope, var_name);
    IF entry EXISTS AS entry_value THEN
      MUTABLE entry_value_mutable = COPY entry_value;
      entry_value_mutable.reassigned = TRUE;
    END
    typeAnalysisSession__mark_var_mutated(rtoc_self_view, var_name);
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__visit_assignment_index(MUTABLE self: TypeAnalysisSession, MUTABLE index_node: GetIndex, MUTABLE assignment_node: Assignment) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, Locatable{ GetIndex: COPY index_node }));
    typeAnalysisSession__mark_chain_needs_mut_ref_mut(rtoc_self_view, Locatable{ GetIndex: COPY index_node });
    IF index_node.target IS_A Identifier THEN
      MUTABLE var_name = index_node.target.name();
      IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_387 = typeAnalysisSession__current_scope(rtoc_self_view);
      scope__is_immutable?(rtoc_local_receiver_387, var_name) } THEN
        typeAnalysisSession__emit_immutable_index_assignment_error_mut(rtoc_self_view, assignment_node, typeAnalysisSession__current_scope(rtoc_self_view), var_name);
      END
      typeAnalysisSession__mark_var_mutated(rtoc_self_view, var_name);
    ELSE
      MUTABLE root: ?String = typeAnalysisSession__chain_root_name(rtoc_self_view, index_node.target);
      IF root EXISTS AS root_value THEN
        typeAnalysisSession__mark_var_mutated(rtoc_self_view, root_value);
      END
    END
    MUTABLE target_type = &index_node.target.full_type_mut("index assignment collection");
    MUTABLE protocol_map = typeAnalysisSession__map_requires_protocol_lowering?(rtoc_self_view, target_type);
    MUTABLE assign_type = TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }));
    IF protocol_map THEN
      typeAnalysisSession__require_generic_map_access_scope_mut(rtoc_self_view, index_node.target, target_type);
      index_node.protocol_operation = :map_put;
      assign_type = CAST(typeAnalysisSession__protocol_map_associated_type(rtoc_self_view, target_type, :Value) AS Type);
    ELSE_IF (!((target_type == NIL)) AND type__map?(target_type)) THEN
      assign_type = target_type.value_type();
    ELSE
      MUTABLE index_type = &index_node.full_type_mut("index assignment target");
      IF type__optional?(index_type) THEN
        assign_type = UNWRAP (TRY (type__wrapped_type(index_type)));
      ELSE
        assign_type = CAST(index_type AS Type);
      END
    END
    IF (((typeAnalysisSession__language_mode(rtoc_self_view) != :strict) AND assignment_node.value IS_A Identifier) AND !(TRY (type__implicitly_copyable?((&assignment_node.value.full_type_mut("pending indexed assignment")), %(name) USE(rtoc_self_view) -> typeAnalysisSession__lookup_type_schema(rtoc_self_view, name))))) THEN
      assignment_node.value.ownership_pending_transfer = TRUE;
    END
    typeAnalysisSession__validate_assignment_type(rtoc_self_view, Node{ Assignment: COPY assignment_node }, castTypeToOptionalTypeTypeInput(assign_type), assignment_node.value.resolved_type());
    IF protocol_map THEN
      typeAnalysisSession__consume_generic_map_value_mut(rtoc_self_view, assignment_node.value, assign_type);
    END
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ Assignment: COPY assignment_node }, assign_type));
    IF ((IF target_type != NIL THEN
      type__map?(target_type)
    ELSE
      NIL
    END) OR_ELSE protocol_map) THEN
      IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
            MUTABLE rtoc_mutable_receiver_388 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
            functionContext__record_heap_use_mut(&rtoc_mutable_receiver_388);
      END
      IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
            MUTABLE rtoc_mutable_receiver_389 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
            functionContext__record_alloc_use_mut(&rtoc_mutable_receiver_389);
      END
      typeAnalysisSession__record_effect(rtoc_self_view, symbol("HEAP"));
    END
}
END
PRIVATE FN typeAnalysisSession__visit_assignment_field(MUTABLE self: TypeAnalysisSession, MUTABLE field_node: GetField, MUTABLE assignment_node: Assignment) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    field_node.is_assignment_lhs = TRUE;
    TRY (typeAnalysisSession__visit(&rtoc_self_view, Locatable{ GetField: COPY field_node }));
    MUTABLE navigation = COPY field_node.target;
    IF (IF navigation IS_A TenseNavigation AS tense_navigation THEN tense_navigation.markers.contains?("~") ELSE FALSE END) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, assignment_node, TypeAnalysisCodeOrMessage{ SymbolValue: :TENSE_NAVIGATION_MUTATION }, [], {:markers: navigation.markers()});
    END
    typeAnalysisSession__reject_bare_atomic_ptr_mutation_mut(rtoc_self_view, field_node, assignment_node);
    typeAnalysisSession__mark_chain_needs_mut_ref_mut(rtoc_self_view, Locatable{ GetField: COPY field_node });
    IF field_node.target IS_A Identifier THEN
      MUTABLE var_name = field_node.target.name();
      MUTABLE syn = (IF field_node.target.symbol() != NIL THEN
        (field_node.target.symbol()).sync()
      ELSE
        NIL
      END);
      IF ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_390 = typeAnalysisSession__current_scope(rtoc_self_view);
      scope__is_immutable?(rtoc_local_receiver_390, var_name) } AND (syn != :always_mutable)) THEN
        typeAnalysisSession__emit_immutable_field_assignment_error_mut(rtoc_self_view, assignment_node, typeAnalysisSession__current_scope(rtoc_self_view), var_name, field_node.field);
      END
      typeAnalysisSession__mark_var_mutated(rtoc_self_view, var_name);
      syn = (IF field_node.target.symbol() != NIL THEN
        (field_node.target.symbol()).sync()
      ELSE
        NIL
      END);
      IF (((syn == :locked) OR (syn == :write_locked)) OR (syn == :always_mutable)) THEN
        assignment_node.auto_lock = AutoLockPlan{ var: COPY var_name, sync: COPY syn };
      END
    ELSE
      MUTABLE target: AccessPathNode = COPY castLocatableToAccessPathNode(field_node.target);
      MUTABLE root: ?String = typeAnalysisSession__chain_root_name(rtoc_self_view, castAccessPathNodeToLocatable(target));
      IF root EXISTS AS root_value THEN
        IF ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_391 = typeAnalysisSession__current_scope(rtoc_self_view);
        scope__is_immutable?(rtoc_local_receiver_391, root_value) } AND !(typeAnalysisSession__interior_mutable_access_path?(rtoc_self_view, target))) THEN
          typeAnalysisSession__emit_immutable_field_assignment_error_mut(rtoc_self_view, assignment_node, typeAnalysisSession__current_scope(rtoc_self_view), root_value, field_node.field);
        END
        typeAnalysisSession__mark_var_mutated(rtoc_self_view, root_value);
      END
    END
    MUTABLE assignment_field_type = &field_node.full_type_mut("assignment field");
    IF ((field_node.safe_nav_chain == TRUE) AND type__optional?(assignment_field_type)) THEN
      assignment_field_type = UNWRAP (TRY (type__wrapped_type(assignment_field_type)));
    END
    IF (((typeAnalysisSession__language_mode(rtoc_self_view) != :strict) AND assignment_node.value IS_A Identifier) AND !(TRY (type__implicitly_copyable?((&assignment_node.value.full_type_mut("pending field assignment")), %(name) USE(rtoc_self_view) -> typeAnalysisSession__lookup_type_schema(rtoc_self_view, name))))) THEN
      assignment_node.value.ownership_pending_transfer = TRUE;
    END
    IF type__multiowned?(assignment_field_type) THEN
      MUTABLE owner = ((&field_node.target.full_type_mut("assignment receiver")).resolved() OR_ELSE NIL);
      typeAnalysisSession__keep_param_identity_mut(rtoc_self_view, assignment_node.value, CAST(assignment_field_type AS Type), "${(owner OR "field")}.${field_node.field}");
    END
    typeAnalysisSession__validate_assignment_type(rtoc_self_view, Node{ Assignment: COPY assignment_node }, TypeTypeInput{ Type: COPY assignment_field_type }, &assignment_node.value.full_type_mut("assignment value"));
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ Assignment: COPY assignment_node }, :Void));
}
END
PRIVATE FN typeAnalysisSession__validate_assignment_type(self: TypeAnalysisSession, node: Node, target_type: ?TypeTypeInput, value_type: ?TypeTypeInput) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF target_type EXISTS AS target_type_value THEN
      MUTABLE target = TRY (type__new(castTypeTypeInputToTypeConstructionInput(target_type_value)));
      MUTABLE value = typeAnalysisSession__assignment_value_type(rtoc_self_view, node, value_type);
      IF ((type__any?(target) OR type__any?(value)) OR type__untyped?(value)) THEN
        RETURN;
      END
      IF (type__resolved(target) == symbol("NIL")) THEN
        RETURN;
      END
      MUTABLE union_schema = typeAnalysisSession__lookup_type_schema(rtoc_self_view, type__resolved((TRY (type__value_payload_type(target)))));
      MUTABLE value_node = node.value();
      IF TRY (unionPayloadCompatibility__unique_variant(target, CAST(value AS Type), union_schema)) THEN
        value_node.coerced_type = target;
        RETURN;
      END
      IF TRY (type__accepts?(target, CAST(value AS Type))) THEN
        IF (!(ruby_union_scalar_equal_Type_Type_multiowned(target, value)) OR ((TRY (type__node_reference?(target)) AND !(TRY (type__node_reference?(value)))))) THEN
          value_node.coerced_type = target;
        END
        RETURN;
      END
      typeAnalysisSession__emit_type_mismatch_assign_error_mut(rtoc_self_view, node, castTypeToTypeTypeInput(target), type__resolved(value));
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__assignment_value_type(self: TypeAnalysisSession, node: Node, fallback: ?TypeTypeInput) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE value = node.value();
    IF (respondsTo?(value, "typed?") AND value.typed?()) THEN
      RETURN &value.full_type_mut("assignment value");
    END
    IF fallback EXISTS AS fallback_value THEN
      RETURN TRY (type__new(castTypeTypeInputToTypeConstructionInput(fallback_value)));
    END
    RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :Untyped }));
}
END
PRIVATE FN typeAnalysisSession__visit_DestructuringAssignment(MUTABLE self: TypeAnalysisSession, MUTABLE node: DestructuringAssignment) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.value));
    MUTABLE rhs = typeAnalysisSession__destructure_rhs_facts(rtoc_self_view, node);
    typeAnalysisSession__validate_destructure_shape_mut(rtoc_self_view, node, rhs);
    typeAnalysisSession__validate_destructure_copyable_mut(rtoc_self_view, node, rhs);
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < node.targets.length() DO
      IF typeAnalysisSession__destructure_discard?(rtoc_self_view, node.targets[rtoc_idx]?) THEN
          TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, node.targets[rtoc_idx]?, rhs.element_type));
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE target_value_type = typeAnalysisSession__destructure_value_type_at(rtoc_self_view, node, rtoc_idx, rhs.element_type);
      IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_392 = typeAnalysisSession__current_scope(rtoc_self_view);
      scope__entry?(rtoc_local_receiver_392, node.targets[rtoc_idx]?.name) } THEN
          typeAnalysisSession__finalize_destructure_assignment_target_mut(rtoc_self_view, node, node.targets[rtoc_idx]?, CAST(target_value_type AS Type));
      ELSE
          typeAnalysisSession__finalize_destructure_declaration_target_mut(rtoc_self_view, node, node.targets[rtoc_idx]?, CAST(target_value_type AS Type));
      END
    rtoc_idx = rtoc_idx + 1;
    END
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ DestructuringAssignment: COPY node }, :Void));
}
END
PRIVATE FN typeAnalysisSession__destructure_discard?(self: TypeAnalysisSession, target: DestructureTarget) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (target.name == "_");
}
END
PRIVATE FN typeAnalysisSession__destructure_rhs_facts(self: TypeAnalysisSession, node: DestructuringAssignment) RETURNS !DestructureRhsFacts
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE value_type = TRY (type__success_type((&node.value.full_type_mut("destructuring assignment value"))));
    MUTABLE element_type_branch_value: ?Type = NIL;
    IF type__tuple?(value_type) THEN
      element_type_branch_value = TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }));
    ELSE
      element_type_branch_value = ((value_type.element_type() OR TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }))));
    END
    MUTABLE element_type: Type = element_type_branch_value?;
    RETURN DestructureRhsFacts{ value_type: COPY value_type, element_type: COPY element_type };
}
END
PRIVATE FN typeAnalysisSession__validate_destructure_shape_mut(self: TypeAnalysisSession, node: DestructuringAssignment, rhs: DestructureRhsFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE value_type = COPY rhs.value_type;
    IF !((type__tuple?(value_type) OR ((type__fixed?(value_type) AND type__array?(value_type))))) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :DESTRUCTURE_REQUIRES_FIXED_SHAPE }, [], {:got: type__to_s(value_type)});
    END
    MUTABLE value_count_branch_value: ?TypeArrayCapacity = NIL;
    IF type__tuple?(value_type) THEN
      value_count_branch_value = (TRY (type__generic_args(value_type))).length();
    ELSE
      value_count_branch_value = type__capacity(value_type);
    END
    MUTABLE value_count: ?TypeArrayCapacity = value_count_branch_value;
    IF (value_count != node.targets.length()) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :DESTRUCTURE_ARITY_MISMATCH }, [], {:targets: node.targets.length(), :values: value_count});
    END
}
END
PRIVATE FN typeAnalysisSession__validate_destructure_copyable_mut(self: TypeAnalysisSession, node: DestructuringAssignment, rhs: DestructureRhsFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF type__tuple?(rhs.value_type) THEN
      RETURN;
    END
    MUTABLE copyable = TRY (type__implicitly_copyable?(rhs.element_type, %(t) USE(rtoc_self_view) -> typeAnalysisSession__lookup_type_schema(rtoc_self_view, t)));
    IF copyable THEN
      RETURN;
    END
    typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :DESTRUCTURE_REQUIRES_COPYABLE_RHS }, [], {:got: type__to_s(rhs.value_type)});
}
END
PRIVATE FN typeAnalysisSession__destructure_value_type_at(self: TypeAnalysisSession, node: DestructuringAssignment, index_value: Int64, fallback: Type) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE value = node.value;
    IF (value IS_A ListLit AND value.items()[index_value]) THEN
      RETURN value.items()[index_value].full_type_mut({:context: "destructuring literal element"});
    END
    IF type__tuple?((&node.value.full_type_mut("destructuring tuple value"))) THEN
      RETURN COPY (TRY (type__generic_args((&node.value.full_type_mut()))))[index_value];
    END
    RETURN COPY fallback;
}
END
PRIVATE FN typeAnalysisSession__finalize_destructure_declaration_target_mut(self: TypeAnalysisSession, node: DestructuringAssignment, MUTABLE target: DestructureTarget, value_type: Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF target.type EXISTS AS type_value THEN
      typeAnalysisSession__validate_type_annotation_mut(rtoc_self_view, target, type_value);
    END
    MUTABLE final_type = target.type;
    typeAnalysisSession__validate_destructure_target_type_mut(rtoc_self_view, node, castTypeToTypeTypeInput(final_type), value_type);
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &target, final_type));
    MUTABLE rtoc_mutable_receiver_394 = typeAnalysisSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_394, target.name, target, castTypeToOptionalSymbolEntryTypeInput(final_type), &target.mutable, FALSE));
    typeAnalysisSession__record_capture_local_mut(rtoc_self_view, CAST(target.name AS String));
    target.symbol = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_395 = typeAnalysisSession__current_scope(rtoc_self_view);
    scope__local_entry_mut(rtoc_local_receiver_395, target.name) };
    typeAnalysisSession__classify_ownership_mut(rtoc_self_view, UNWRAP (target.symbol));
    typeAnalysisSession__og_declare(rtoc_self_view, target.name, target, castTypeToTypeTypeInput(final_type));
}
END
PRIVATE FN typeAnalysisSession__finalize_destructure_assignment_target_mut(self: TypeAnalysisSession, node: DestructuringAssignment, MUTABLE target: DestructureTarget, value_type: Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE scope = typeAnalysisSession__current_scope(rtoc_self_view);
    IF !({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_396 = typeAnalysisSession__ownership_graph(rtoc_self_view);
    TRY (ownershipGraph__can_write?(rtoc_local_receiver_396, target.name)) }) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :ASSIGN_WHILE_BORROWED }, [], {:name: target.name});
    END
    IF scope__is_immutable?(scope, target.name) THEN
      MUTABLE fix: ?Fix@multiowned = typeAnalysisSession__build_declare_mutable_fix(rtoc_self_view, target.name, scope);
      IF fix EXISTS AS fix_value THEN
        typeAnalysisSession__fixable_mut(rtoc_self_view, node, :ownership, [fix_value], NIL, :ASSIGN_VAR_IMMUTABLE, :error, FALSE, {:name: target.name});
      ELSE
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :ASSIGN_VAR_IMMUTABLE }, [], {:name: target.name});
      END
    END
    IF target.type EXISTS AS type_value THEN
      typeAnalysisSession__validate_type_annotation_mut(rtoc_self_view, target, type_value);
    END
    MUTABLE target_type = TRY (scope__resolve_type(scope, target.name));
    typeAnalysisSession__validate_destructure_target_type_mut(rtoc_self_view, node, TypeTypeInput{ Type: COPY target_type }, value_type);
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &target, target_type));
    target.symbol = scope__entry_for_write(&scope, target.name);
    typeAnalysisSession__mark_var_mutated(rtoc_self_view, target.name);
    typeAnalysisSession__og_set_live(rtoc_self_view, target.name);
}
END
PRIVATE FN typeAnalysisSession__validate_destructure_target_type_mut(self: TypeAnalysisSession, node: DestructuringAssignment, target_type: TypeTypeInput, value_type: Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF ((FALSE OR ruby_union_scalar_equal_TypeTypeInput_String_symbol(target_type, :Any)) OR (type__resolved(value_type) == :Any)) THEN
      RETURN;
    END
    IF ruby_union_scalar_equal_TypeTypeInput_String_symbol(target_type, symbol("NIL")) THEN
      RETURN;
    END
    IF TRY (type__accepts?((TRY (type__new(castTypeTypeInputToTypeConstructionInput(target_type)))), value_type)) THEN
      RETURN;
    END
    typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :TYPE_MISMATCH_ASSIGN }, [], {:got: type__resolved(value_type), :expected: target_type});
}
END
PRIVATE FN typeAnalysisSession__visit_GetIndex(MUTABLE self: TypeAnalysisSession, MUTABLE node: GetIndex) RETURNS !?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE root: ?Identifier = NIL;
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.target));
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.index));
    MUTABLE target_type_info = &node.target.full_type_mut("index target");
    MUTABLE implicit_safe_nav = ((target_type_info.optional?() AND respondsTo?(node.target, "safe_nav_chain")) AND (node.target.safe_nav_chain() == TRUE));
    IF implicit_safe_nav THEN
      target_type_info = TRY (type__wrapped_type(target_type_info));
    END
    IF TRY (type__c_array_view?(target_type_info)) THEN
      root = aST__root_identifier(node.target);
      IF (root != NIL) THEN
        typeAnalysisSession__emit_foreign_index_needs_unsafe_view_mut(rtoc_self_view, node, identifier__name(root));
      ELSE
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :FOREIGN_POINTER_DIRECT_INDEX }, [], {:name: "foreign pointer"});
      END
    END
    IF (type__future?(target_type_info) AND type__observable?(target_type_info)) THEN
      root = aST__root_identifier(node.target);
      IF (root != NIL) THEN
        typeAnalysisSession__emit_direct_view_access_finding_mut(rtoc_self_view, Locatable{ GetIndex: COPY node }, identifier__name(root), "VIEW");
      ELSE
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :DIRECT_VIEW_ACCESS_REQUIRES_WITH }, [], {:name: "observable", :permission: "VIEW"});
      END
    END
    IF type__rank?(target_type_info) THEN
      MUTABLE indices: []Locatable = List[];
      IF node.index IS_A TupleLit THEN
        indices = node.index.items();
      ELSE
        indices = [node.index];
      END
      IF (indices.length() != TRY (type__rank(target_type_info))) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :RANK_INDEX_ARITY }, [], {:expected: TRY (type__rank(target_type_info)), :got: indices.length()});
      END
      FOR _ IN indices DO
    MUTABLE rtoc_mutable_block_param_397 = COPY _;
    MUTABLE index_type = &rtoc_mutable_block_param_397.full_type_mut({:context: "rank index"});
    IF !(type__integer?(index_type)) THEN
          typeAnalysisSession__error_mut(rtoc_self_view, rtoc_mutable_block_param_397, TypeAnalysisCodeOrMessage{ SymbolValue: :RANK_INDEX_INTEGER }, [], {:got: index_type.resolved()});
    END
      END
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ GetIndex: COPY node }, target_type_info.element_type()));
      node.container_borrow = TRUE;
      RETURN;
    END
    IF type__tuple?(target_type_info) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :TUPLE_INDEX_SYNTAX });
    END
    IF typeAnalysisSession__map_requires_protocol_lowering?(rtoc_self_view, target_type_info) THEN
      typeAnalysisSession__require_generic_map_access_scope_mut(rtoc_self_view, node.target, target_type_info);
      MUTABLE key_type = typeAnalysisSession__protocol_map_associated_type(rtoc_self_view, target_type_info, :Key);
      MUTABLE index_type = &node.index.full_type_mut("Map protocol index key");
      IF !(TRY (type__accepts?(key_type, index_type))) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_MAP_KEY_MISMATCH }, [], {:expected: TRY (type__surface_name(TypeTypeInput{ Type: COPY key_type })), :actual: TRY (type__surface_name(index_type))});
      END
      MUTABLE value_type = typeAnalysisSession__protocol_map_associated_type(rtoc_self_view, target_type_info, :Value);
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ GetIndex: COPY node }, TRY (type__optional_of(TypeTypeInput{ Type: COPY value_type }))));
      node.protocol_operation = :map_get;
      node.container_borrow = TRUE;
      RETURN;
    END
    MUTABLE op: ?{Any@multiowned}Any@multiowned = typeAnalysisSession__resolve_index_op(rtoc_self_view, target_type_info, :get);
    IF op EXISTS AS op_value THEN
      MUTABLE op_value_mutable = COPY op_value;
      MUTABLE result_type = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_399 = (TRY (intrinsicRegistry__to_return_def(ruby_wrap_optional_Any_multiowned_ReturnDescriptor(op_value_mutable[:return_type]))));
      TRY (functionReturn__resolve(rtoc_local_receiver_399, target_type_info, ( { MUTABLE rtoc_empty_list_398: []Locatable = List[]; rtoc_empty_list_398 } ))) };
      MUTABLE navigation = ((node.target IS_A OptionalUnwrap AND node.target.safe_navigation?()) OR implicit_safe_nav);
      IF (navigation AND !(type__optional?(result_type))) THEN
        result_type = TRY (type__optional_of(TypeTypeInput{ Type: COPY result_type }));
        node.safe_nav_chain = TRUE;
      END
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ GetIndex: COPY node }, result_type));
      IF op_value_mutable[:container_borrow] THEN
        node.container_borrow = TRUE;
      END
      IF type__map?(target_type_info) THEN
        MUTABLE index_type_info = &node.index.full_type_mut("index key");
        MUTABLE expected_key_type = TRY (type__key_type(target_type_info));
        IF !((index_type_info AND TRY (type__accepts_map_key?(target_type_info, index_type_info)))) THEN
          typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_MAP_KEY_MISMATCH }, [], {:expected: TRY (type__surface_name(expected_key_type)), :actual: IF index_type_info THEN
            TRY (type__surface_name(index_type_info))
          ELSE
            node.index.resolved_type()
          END});
        END
      END
    ELSE
    IF target_type_info.promise_list?() THEN
        MUTABLE elem_t = TRY (type__element_type((TRY (type__tense_type(target_type_info)))));
        TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ GetIndex: COPY node }, TRY (type__optional_of(castTypeToTypeTypeInput(TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("~${elem_t.resolved()}") })))))));
    ELSE_IF (TRY (type__string?(target_type_info)) AND !(type__raw?(target_type_info))) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :STRING_INDEX_BY_INT });
    ELSE_IF ((node.target.metatype() == :struct) AND target_type_info.element_type()) THEN
        TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ GetIndex: COPY node }, target_type_info.element_type()));
        node.container_borrow = TRUE;
    ELSE
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :UNSUPPORTED_INDEX });
    END
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__visit_GetField(MUTABLE self: TypeAnalysisSession, MUTABLE node: GetField) RETURNS !?TypeAnalysisSessionReturnValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE navigation = NIL;
    IF typeAnalysisSession__resolve_variant_access(rtoc_self_view, node) THEN
      RETURN;
    END
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.target));
    typeAnalysisSession__emit_moved_field_path_error_if_needed_mut(rtoc_self_view, node);
    MUTABLE target_type = &node.target.full_type_mut("field receiver");
    IF (type__future?(target_type) AND type__observable?(target_type)) THEN
      MUTABLE root: ?Identifier = aST__root_identifier(node.target);
      IF (root != NIL) THEN
        typeAnalysisSession__emit_direct_view_access_finding_mut(rtoc_self_view, Locatable{ GetField: COPY node }, identifier__name(root), "VIEW");
      ELSE
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :DIRECT_VIEW_ACCESS_REQUIRES_WITH }, [], {:name: "observable", :permission: "VIEW"});
      END
    END
    MUTABLE implicit_safe_nav = ((target_type.optional?() AND respondsTo?(node.target, "safe_nav_chain")) AND (node.target.safe_nav_chain() == TRUE));
    IF ((target_type.optional?() AND !(node.target IS_A OptionalUnwrap)) AND !(implicit_safe_nav)) THEN
      typeAnalysisSession__emit_optional_field_safe_nav_finding_mut(rtoc_self_view, node, target_type);
      target_type = TRY (type__wrapped_type(target_type));
    END
    IF implicit_safe_nav THEN
      target_type = TRY (type__wrapped_type(target_type));
    END
    MUTABLE type = target_type.resolved();
    MUTABLE match: ?CompilerRegexScanner = compilerRegexMatchData(CAST(node.field AS String), (compilerRegexCompile("\\A_(\\d+)\\z")));
    IF (type__tuple?(target_type) AND (match)) THEN
      MUTABLE position = TRY (compilerRegexCapture(match?, 1).toInt());
      MUTABLE position_type = TRY (type__fixed_position_type(target_type, position));
      IF (position_type == NIL) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :FIXED_POSITION_OUT_OF_BOUNDS }, [], {:index: position, :count: TRY (type__fixed_position_count(target_type)), :type: TRY (type__surface_name(target_type))});
      END
      MUTABLE field_type = position_type;
      IF node.target IS_A TenseNavigation THEN
        field_type = typeAnalysisSession__publish_tense_navigation_plan_mut(rtoc_self_view, Locatable{ GetField: COPY node }, castLocatableToTenseNavigation(node.target), CAST(field_type AS Type));
        IF node.target.safe_navigation?() THEN
          node.safe_nav_chain = TRUE;
        END
      END
      navigation = ((node.target IS_A OptionalUnwrap AND node.target.safe_navigation?()) OR implicit_safe_nav);
      IF (navigation AND !(type__optional?(field_type))) THEN
        field_type = TRY (type__optional_of(TypeTypeInput{ Type: COPY field_type }));
      END
      node.tuple_position = position;
      IF implicit_safe_nav THEN
        node.safe_nav_chain = TRUE;
      END
      node.container_borrow = TRUE;
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ GetField: COPY node }, field_type));
      RETURN;
    END
    IF getField__wildcard?(node) THEN
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ GetField: COPY node }, :Void));
      RETURN;
    END
    typeAnalysisSession__emit_capability_field_access_error_if_needed_mut(rtoc_self_view, node);
    MUTABLE raw_schema = typeAnalysisSession__lookup_type_schema(rtoc_self_view, type);
    IF schemas__enum?(raw_schema) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :ENUM_FIELD_ACCESS }, [], {:enum: type});
      RETURN;
    END
    IF (raw_schema IS_A UnionSchema OR (schemas__union?(raw_schema))) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :UNION_FIELD_ACCESS }, [], {:union: type});
      RETURN;
    END
    IF !(schemas__field_bearing?(raw_schema)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :ILLEGAL_FIELD_LOOKUP }, [], {:field: node.field, :type: type});
      RETURN;
    END
    MUTABLE struct_schema: Any@multiowned = CAST(raw_schema AS Any@multiowned);
    MUTABLE field_def = struct_schema.fields()[node.field];
    IF !(field_def) THEN
      IF node.token THEN
        MUTABLE valid_fields = struct_schema.fields().keys() |> WHERE !((_ IS_A String@symbol OR (CAST(_ AS String)).startsWith?("_")));
        typeAnalysisSession__emit_typo_suggestion_mut(rtoc_self_view, TypoToken{ TokenMultiowned: COPY node.token }, node.field, valid_fields, "Struct '${type}' has no field '${node.field}'", "field of ${type}", :type, TRUE);
      ELSE
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :ILLEGAL_FIELD_LOOKUP }, [], {:field: node.field, :type: type});
      END
      RETURN;
    END
    MUTABLE field_type = field_def.type();
    IF (((typeAnalysisSession__phase_traversal_state(rtoc_self_view).pipeline_accessed_fields != NIL) AND node.target IS_A Identifier) AND (node.target.name() == "_")) THEN
      (UNWRAP ((typeAnalysisSession__phase_traversal_state(rtoc_self_view).pipeline_accessed_fields)?)).insert(node.field);
    END
    MUTABLE type_obj = TRY (type__new(type));
    IF (type__generic_instance?(type_obj) AND type__any?(struct_schema.type_params())) THEN
      MUTABLE subst = {};
      (struct_schema.type_params().zip(TRY (type__generic_args(type_obj)))).keys() |> EACH {
    MUTABLE arg: Any = ((struct_schema.type_params().zip(TRY (type__generic_args(type_obj))))[_] OR_ELSE panic("missing hash key"));
    IF !(arg) THEN
      CONTINUE;
    END
    subst[_] = arg.resolved();
      };
      field_type = typeAnalysisSession__apply_type_subst(rtoc_self_view, TypeTypeInput{ Type: COPY field_type }, subst);
    END
    IF type__indirect?(field_type) THEN
      MUTABLE psch = typeAnalysisSession__lookup_type_schema(rtoc_self_view, type__resolved(field_type));
      MUTABLE struct_pointee = schemas__struct?(psch);
      IF !(struct_pointee) THEN
        node.indirect_field = TRUE;
      END
      IF !(struct_pointee) THEN
        field_type = OWN COPY field_type;
        TRY (type__strip_layout_mut(&field_type));
      END
    END
    IF node.target IS_A TenseNavigation THEN
      field_type = typeAnalysisSession__publish_tense_navigation_plan_mut(rtoc_self_view, Locatable{ GetField: COPY node }, castLocatableToTenseNavigation(node.target), CAST(field_type AS Type));
      IF node.target.safe_navigation?() THEN
        node.safe_nav_chain = TRUE;
      END
    END
    navigation = ((node.target IS_A OptionalUnwrap AND node.target.safe_navigation?()) OR implicit_safe_nav);
    IF (navigation AND !(type__optional?(field_type))) THEN
      field_type = TRY (type__optional_of(TypeTypeInput{ Type: COPY field_type }));
      node.safe_nav_chain = TRUE;
    END
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ GetField: COPY node }, field_type));
}
END
PRIVATE FN typeAnalysisSession__emit_moved_field_path_error_if_needed_mut(self: TypeAnalysisSession, node: GetField) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE path = typeAnalysisSession__get_path_to_root(rtoc_self_view, Node{ GetField: COPY node });
    IF (path.length() == 0) THEN
      RETURN;
    END
    MUTABLE check: String = "";
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < path.length() DO
        IF (check.length() == 0) THEN
          check = COPY CAST(path[rtoc_idx]? AS String);
        ELSE
          check = "${check}.${path[rtoc_idx]?}";
        END
      IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_400 = typeAnalysisSession__ownership_graph(rtoc_self_view);
      ownershipGraph__moved?(rtoc_local_receiver_400, check) } THEN
          typeAnalysisSession__emit_use_of_moved_path_error_mut(rtoc_self_view, node, path, ownershipGraph__get_index(typeAnalysisSession__ownership_graph(rtoc_self_view), check));
          BREAK;
      END
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PRIVATE FN typeAnalysisSession__emit_capability_field_access_error_if_needed_mut(self: TypeAnalysisSession, node: GetField) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(node.target IS_A Identifier) THEN
      RETURN;
    END
    IF node.is_assignment_lhs THEN
      RETURN;
    END
    MUTABLE sym = node.target.symbol();
    MUTABLE in_auto_lock = (typeAnalysisSession__phase_traversal_state(rtoc_self_view).auto_locked_assign_name == node.target.name());
    MUTABLE in_with_block = typeAnalysisSession__inside_with_block?(rtoc_self_view);
    MUTABLE cap_error = ([[(IF sym != NIL THEN
      sym.locked?()
    ELSE
      NIL
    END), :CAP_FIELD_NEEDS_WITH_EXCLUSIVE, "EXCLUSIVE", "@locked"], [(IF sym != NIL THEN
      sym.write_locked?()
    ELSE
      NIL
    END), :CAP_FIELD_NEEDS_WITH_EXCLUSIVE, "EXCLUSIVE", "@writeLocked"], [(IF sym != NIL THEN
      sym.atomic_ptr?()
    ELSE
      NIL
    END), :CAP_FIELD_NEEDS_WITH_SNAPSHOT, "SNAPSHOT", "@boxed:atomic"]]) |> FIND _[0];
    IF ((cap_error AND !(in_auto_lock)) AND !(in_with_block)) THEN
      typeAnalysisSession__emit_cap_field_needs_with_mut(rtoc_self_view, node, cap_error[1], node.target.name(), node.field, cap_error[3], cap_error[2]);
    END
}
END
PRIVATE FN typeAnalysisSession__visit_Slice(MUTABLE self: TypeAnalysisSession, MUTABLE node: Slice) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.target));
    IF node.start THEN
      TRY (typeAnalysisSession__visit(&rtoc_self_view, node.start));
    END
    IF node.end THEN
      TRY (typeAnalysisSession__visit(&rtoc_self_view, node.end));
    END
    MUTABLE target_type = &node.target.full_type_mut("slice target");
    IF (IF target_type != NIL THEN
      type__array?(target_type)
    ELSE
      NIL
    END) THEN
      MUTABLE element = target_type.element_type();
      MUTABLE slice_type = TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("${element.resolved()}[]") }));
      TRY (type__set_elem_ownership(&slice_type, type__ownership(element)));
      TRY (type__set_elem_sync(&slice_type, element.sync()));
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ Slice: COPY node }, slice_type));
      node.container_borrow = TRUE;
    ELSE
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ Slice: COPY node }, :Any));
    END
}
END
PRIVATE FN typeAnalysisSession__visit_HashLit(MUTABLE self: TypeAnalysisSession, MUTABLE node: HashLit) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE expected_map: ?Type@multiowned = node.coerced_type_info();
    IF (IF expected_map != NIL THEN
      type__map?(expected_map)
    ELSE
      NIL
    END) THEN
      MUTABLE expected_key = TRY (type__key_type(expected_map));
      MUTABLE expected_value = TRY (type__value_type(expected_map));
      FOR rtoc_each_key IN node.pairs.keys() DO
    MUTABLE value: Locatable = COPY UNWRAP (node.pairs[rtoc_each_key]);
    rtoc_each_key.coerced_type = expected_key;
    value.coerced_type = expected_value;
    TRY (typeAnalysisSession__visit(&rtoc_self_view, rtoc_each_key));
    TRY (typeAnalysisSession__visit(&rtoc_self_view, value));
    MUTABLE actual_key = &rtoc_each_key.full_type_mut("hash literal key");
    MUTABLE actual_value = &value.full_type_mut("hash literal value");
    IF !(((type__any?(expected_key) OR TRY (type__accepts?(expected_key, actual_key))) OR typeAnalysisSession__is_safe_autocast?(rtoc_self_view, actual_key, castTypeToTypeTypeInput(expected_key)))) THEN
          typeAnalysisSession__error_mut(rtoc_self_view, rtoc_each_key, TypeAnalysisCodeOrMessage{ SymbolValue: :TYPE_MISMATCH_ASSIGN }, [], {:got: actual_key.resolved(), :expected: expected_key});
    END
    IF !(((type__any?(expected_value) OR TRY (type__accepts?(expected_value, actual_value))) OR typeAnalysisSession__is_safe_autocast?(rtoc_self_view, actual_value, castTypeToTypeTypeInput(expected_value)))) THEN
          typeAnalysisSession__error_mut(rtoc_self_view, value, TypeAnalysisCodeOrMessage{ SymbolValue: :TYPE_MISMATCH_ASSIGN }, [], {:got: actual_value.resolved(), :expected: expected_value});
    END
      END
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ HashLit: COPY node }, expected_map));
      node.storage = :stack;
      RETURN;
    END
    IF node.pairs.empty?() THEN
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ HashLit: COPY node }, symbol("HashMap<Any>")));
      node.storage = :stack;
      RETURN;
    END
    FOR rtoc_inner_key IN node.pairs.keys() DO
    MUTABLE v: Locatable = COPY UNWRAP (node.pairs[rtoc_inner_key]);
    TRY (typeAnalysisSession__visit(&rtoc_self_view, rtoc_inner_key));
    TRY (typeAnalysisSession__visit(&rtoc_self_view, v));
    END
    MUTABLE values = node.pairs.values();
    IF values |> ALL TRY (type__string?((TRY (type__new(_.resolved_type()))))) THEN
      MUTABLE value_type = IF values |> ALL { MUTABLE rtoc_mutable_block_param_403 = COPY _;
      type__symbol?((&rtoc_mutable_block_param_403.full_type_mut("hash literal symbol value"))) } THEN
        symbol("String@symbol")
      ELSE
        :String
      END;
    ELSE
      MUTABLE value_type = values.first().resolved_type();
      MUTABLE symbol_key_map = node.pairs.keys() |> ALL (IF _ IS_A Literal AS literal THEN ruby_union_scalar_equal_Type_String_symbol(literal.type, :SYMBOL) ELSE FALSE END);
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < values.length() DO
    IF (values[rtoc_idx]?.resolved_type() != value_type) THEN
          IF symbol_key_map THEN
            TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ HashLit: COPY node }, TRY (type__new(TypeConstructionInput{ SymbolValue: symbol("HashMap<String@symbol, Auto>") }))));
            node.storage = :stack;
            RETURN;
          END
          typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :HASHMAP_MIXED_VALUES });
    END
    rtoc_idx = rtoc_idx + 1;
      END
    END
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ HashLit: COPY node }, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("HashMap<${value_type}>") }))));
    node.storage = :stack;
}
END
PRIVATE FN typeAnalysisSession__visit_StructLit(MUTABLE self: TypeAnalysisSession, MUTABLE node: StructLit) RETURNS !?TypeAnalysisSessionReturnValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE display_name = COPY node.name;
    MUTABLE schema = typeAnalysisSession__lookup_type_schema(rtoc_self_view, symbol(display_name));
    IF schemas__union?(schema) THEN
      IF (node.fields.length() != 1) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :UNION_LITERAL_VARIANT_COUNT }, [], {:name: node.name, :got: node.fields.length()});
      END
      MUTABLE union_subst = typeAnalysisSession__literal_type_substitution_mut(rtoc_self_view, node, schema);
      MUTABLE variant_name, val_node = node.fields.first();
      IF !(schema.variants().key?(variant_name)) THEN
        MUTABLE anchor: ?AnchorToken = typeAnalysisSession__variant_anchor_from_unionlit(rtoc_self_view, Node{ StructLit: COPY node }, variant_name);
        IF anchor EXISTS AS anchor_value THEN
          typeAnalysisSession__emit_variant_typo_mut(rtoc_self_view, anchor_value, variant_name, schema.variants().keys(), "Type Error: Union '${node.name}' has no variant '${variant_name}'.", "variant of union ${node.name}", TRUE);
        ELSE
          typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :UNION_UNKNOWN_VARIANT }, [], {:union: node.name, :variant: variant_name});
        END
      END
      MUTABLE raw_expected = schema.variants()[variant_name];
      IF (raw_expected == NIL) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :UNION_VARIANT_IS_UNIT_NO_PAYLOAD }, [], {:variant: variant_name, :union: node.name, :variant2: variant_name});
      END
      IF schemas__inline_struct?(raw_expected) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :UNION_INLINE_VARIANT_OLD_SYNTAX }, [], {:union: node.name, :variant: variant_name, :union2: node.name, :variant2: variant_name});
      END
      MUTABLE indirect_payload = (raw_expected IS_A Type AND raw_expected.indirect?());
      MUTABLE raw_for_check =     IF indirect_payload THEN
        {
    MUTABLE rtoc_value_block_marker = 0;
    d = COPY raw_expected;
    TRY (type__strip_layout_mut(&d));
    d
      }
      ELSE
        raw_expected
      END;
      MUTABLE expected_type: Type = CAST(typeAnalysisSession__apply_type_subst(rtoc_self_view, raw_for_check, union_subst) AS Type);
      TRY (typeAnalysisSession__visit(&rtoc_self_view, val_node));
      typeAnalysisSession__reject_borrowed_value_mut(rtoc_self_view, UNWRAP (val_node), "${node.name}.${variant_name}");
      MUTABLE owned: ?Locatable = typeAnalysisSession__ensure_owned_value_mut(rtoc_self_view, UNWRAP (val_node), castTypeToOptionalTypeTypeInput(expected_type), "${node.name}.${variant_name}");
      IF owned EXISTS AS owned_value THEN
        node.fields[variant_name] = owned_value;
        val_node = COPY owned_value;
      END
      IF indirect_payload THEN
        val_node.needs_heap_create = TRUE;
        IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
                MUTABLE rtoc_mutable_receiver_404 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
                functionContext__record_heap_use_mut(&rtoc_mutable_receiver_404);
        END
      END
      MUTABLE actual = &val_node.full_type_mut("union payload");
      IF !(TRY (type__accepts?(expected_type, actual))) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :UNION_PAYLOAD_MISMATCH }, [], {:variant: variant_name, :expected: type__resolved(expected_type), :got: (IF actual != NIL THEN
          actual.resolved()
        ELSE
          NIL
        END)});
      END
      typeAnalysisSession__move_if_not_copyable_mut(rtoc_self_view, UNWRAP (val_node));
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ StructLit: COPY node }, typeAnalysisSession__literal_instance_type(rtoc_self_view, node)));
      RETURN;
    END
    IF node.fields.empty?() THEN
      MUTABLE field_names = schema.fields().keys();
      IF !(field_names.empty?()) THEN
        MUTABLE field_defaults = ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_405 = CAST(schema AS StructSchema);
        TRY (structSchema__field_defaults(rtoc_local_receiver_405)) } OR {});
        MUTABLE missing = field_names |> WHERE !(field_defaults.key?(_));
        IF type__any?(missing) THEN
          typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :STRUCT_LITERAL_MISSING_FIELDS }, [], {:name: node.name, :fields: missing.join(", ")});
        END
      END
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ StructLit: COPY node }, typeAnalysisSession__literal_instance_type(rtoc_self_view, node)));
      RETURN;
    END
    MUTABLE type_subst = typeAnalysisSession__literal_type_substitution_mut(rtoc_self_view, node, schema);
    FOR rtoc_each_key IN node.fields.keys() DO
    MUTABLE val_node = COPY UNWRAP (node.fields[rtoc_each_key]);
    TRY (typeAnalysisSession__visit(&rtoc_self_view, val_node));
    IF val_node? IS_A IfStatement AS if_statement THEN
        MUTABLE if_statement_mutable = COPY if_statement;
        typeAnalysisSession__promote_to_expr_if_mut(rtoc_self_view, Locatable{ StructLit: COPY node }, &if_statement_mutable);
    END
    IF val_node? IS_A MatchStatement AS match_statement THEN
        MUTABLE match_statement_mutable = COPY match_statement;
        typeAnalysisSession__promote_to_expr_match_mut(rtoc_self_view, Locatable{ StructLit: COPY node }, &match_statement_mutable);
    END
    MUTABLE raw_expected: ?Any@multiowned = (IF schema.fields()[rtoc_each_key] != NIL THEN
        (schema.fields()[rtoc_each_key]).type()
      ELSE
        NIL
      END);
    IF (raw_expected == NIL) THEN
        MUTABLE valid_fields = schema.fields().keys() |> WHERE !((CAST(rtoc_each_key AS String)).startsWith?("rtoc_each_key"));
        MUTABLE name_tok: ?Token = COPY node.field_tokens[rtoc_each_key];
        IF name_tok EXISTS AS name_tok_value THEN
          typeAnalysisSession__emit_typo_suggestion_mut(rtoc_self_view, TypoToken{ TokenMultiowned: COPY name_tok_value }, rtoc_each_key, valid_fields, "Struct '${node.name}' has no field '${rtoc_each_key}'", "field of ${node.name}", :type, TRUE);
        ELSE
          typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :STRUCT_FIELD_UNRESOLVABLE }, [], {:struct: node.name, :field: rtoc_each_key});
        END
    END
    MUTABLE raw_expected_value: Any@multiowned = raw_expected?;
    MUTABLE field_is_borrowed = ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_406 = CAST(schema AS StructSchema);
    TRY (structSchema__borrowed_fields(rtoc_local_receiver_406)) }).contains?(rtoc_each_key);
    MUTABLE expected_type: Type = CAST(typeAnalysisSession__apply_type_subst(rtoc_self_view, raw_expected_value, type_subst) AS Type);
    MUTABLE kept_param_store = typeAnalysisSession__keep_param_identity_mut(rtoc_self_view, UNWRAP (val_node), expected_type, "${node.name}.${rtoc_each_key}");
    IF !((field_is_borrowed OR kept_param_store)) THEN
        typeAnalysisSession__reject_borrowed_value_mut(rtoc_self_view, UNWRAP (val_node), "${node.name}.${rtoc_each_key}");
    END
    MUTABLE is_call_arg = typeAnalysisSession__struct_literal_call_argument_context?(rtoc_self_view);
    MUTABLE owned: ?Locatable = IF !(((field_is_borrowed OR is_call_arg) OR kept_param_store)) THEN
        typeAnalysisSession__ensure_owned_value_mut(rtoc_self_view, UNWRAP (val_node), castTypeToOptionalTypeTypeInput(expected_type), "${node.name}.${rtoc_each_key}")
      ELSE
        NIL
      END;
    IF owned EXISTS AS owned_value THEN
        node.fields[rtoc_each_key] = owned_value;
        MUTABLE val_node = owned_value;
    END
    MUTABLE actual_type = &val_node.full_type_mut("struct field value");
    MUTABLE nil_value = (IF val_node? IS_A Literal AS literal THEN ruby_union_scalar_equal_Type_String_symbol(literal.type, symbol("NIL")) ELSE FALSE END);
    MUTABLE expected_layout_value_branch_value: ?Type = NIL;
      IF type__optional?(expected_type) THEN
        expected_layout_value_branch_value = UNWRAP (TRY (type__wrapped_type(expected_type)));
      ELSE
        expected_layout_value_branch_value = expected_type;
      END
    MUTABLE expected_layout_value: Type = expected_layout_value_branch_value?;
    MUTABLE actual_layout_value = IF actual_type.optional?() THEN
        TRY (type__wrapped_type(actual_type))
      ELSE
        actual_type
      END;
    MUTABLE indirect_construction = (((type__indirect?(expected_type) AND !(actual_type.indirect?())) AND !(nil_value)) AND (type__resolved(expected_layout_value) == actual_layout_value.resolved()));
    IF indirect_construction THEN
        val_node.needs_heap_create = TRUE;
        IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
              MUTABLE rtoc_mutable_receiver_407 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
              functionContext__record_heap_use_mut(&rtoc_mutable_receiver_407);
        END
    END
    MUTABLE node_coercion = ((TRY (type__node_reference?(expected_type)) AND !(TRY (type__node_reference?(actual_type)))) AND TRY (type__accepts?(expected_type, actual_type)));
    IF ((actual_type != expected_type) OR node_coercion) THEN
        IF !((typeAnalysisSession__is_safe_autocast?(rtoc_self_view, actual_type, castTypeToTypeTypeInput(expected_type)) OR ((TRY (type__node_reference?(expected_type)) AND TRY (type__accepts?(expected_type, actual_type)))))) THEN
          typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :FIELD_TYPE_MISMATCH }, [], {:field: rtoc_each_key, :expected: expected_type, :got: actual_type});
        END
        IF !((indirect_construction OR ((nil_value AND type__indirect?(expected_type))))) THEN
          val_node.coerced_type = expected_type;
        END
    END
    MUTABLE pending_owned_transfer = (((((typeAnalysisSession__language_mode(rtoc_self_view) != :strict) AND !(field_is_borrowed)) AND !(is_call_arg)) AND ((val_node != NIL) AND (val_node IS_A Identifier))) AND !(TRY (type__implicitly_copyable?(actual_type, %(name) USE(rtoc_self_view) -> typeAnalysisSession__lookup_type_schema(rtoc_self_view, name)))));
    IF pending_owned_transfer THEN
        val_node.ownership_pending_transfer = TRUE;
    END
    IF !((field_is_borrowed OR pending_owned_transfer)) THEN
        typeAnalysisSession__move_if_not_copyable_mut(rtoc_self_view, UNWRAP (val_node));
    END
    END
    node.borrowed_field_names = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_408 = CAST(schema AS StructSchema);
    TRY (structSchema__borrowed_fields(rtoc_local_receiver_408)) };
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ StructLit: COPY node }, typeAnalysisSession__literal_instance_type(rtoc_self_view, node)));
}
END
PRIVATE FN typeAnalysisSession__visit_ListLit(MUTABLE self: TypeAnalysisSession, MUTABLE node: ListLit) RETURNS !?TypeAnalysisSessionReturnValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN node.items DO
    TRY (typeAnalysisSession__visit(&rtoc_self_view, _));
    END
    MUTABLE expected_tuple: ?Type@multiowned = node.coerced_type_info();
    IF (IF expected_tuple != NIL THEN
      type__tuple?(expected_tuple)
    ELSE
      NIL
    END) THEN
      MUTABLE tuple_types = TRY (type__generic_args(expected_tuple));
      IF (tuple_types.length() != node.items.length()) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :GENERIC_WRONG_ARG_COUNT }, [], {:type: :Tuple, :expected: tuple_types.length(), :got: node.items.length()});
      END
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < node.items.length() DO
      MUTABLE expected_item = COPY UNWRAP (tuple_types[rtoc_idx]);
      MUTABLE actual_item = &node.items[rtoc_idx].full_type_mut({:context: "tuple literal element"});
      IF TRY (type__accepts?(expected_item, actual_item)) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE union_schema = typeAnalysisSession__lookup_type_schema(rtoc_self_view, type__resolved((TRY (type__value_payload_type(expected_item)))));
      IF TRY (unionPayloadCompatibility__unique_variant(expected_item, actual_item, union_schema)) THEN
            node.items[rtoc_idx].coerced_type = COPY expected_item;
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !(typeAnalysisSession__is_safe_autocast?(rtoc_self_view, actual_item, castTypeToTypeTypeInput(expected_item))) THEN
            typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :TYPE_MISMATCH_ASSIGN }, [], {:got: actual_item.resolved(), :expected: expected_item});
      END
      node.items[rtoc_idx].coerced_type = COPY expected_item;
    rtoc_idx = rtoc_idx + 1;
      END
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ ListLit: COPY node }, expected_tuple));
      node.storage = :stack;
      RETURN;
    END
    IF (!(node.items.empty?()) AND (node.items |> ALL type__future?((TRY (type__new(_.resolved_type())))))) THEN
      MUTABLE inner_types = CAST(((node.items |> SELECT type__to_sym((TRY (type__tense_type((TRY (type__new(_.resolved_type())))))))) |> DISTINCT _) AS []String@symbol);
      IF (inner_types.size() > 1) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :BOUNDED_STREAM_MIXED_TYPES }, [], {:types: inner_types.join(", ")});
      END
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ ListLit: COPY node }, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("~${inner_types.first()}[${node.items.size()}]") }))));
      node.storage = :stack;
      RETURN;
    END
    IF node.items.empty?() THEN
      MUTABLE coll = listLit__constructor_collection(node);
      IF coll THEN
        MUTABLE t = TRY (type__new(TypeConstructionInput{ SymbolValue: symbol("Any[]") }, NIL, NIL, NIL, NIL, coll));
        TRY (type__apply_constructor_collection_mut(&t, NIL, listLit__constructor_soa?(node), listLit__constructor_shard_count(node)));
        IF ((coll == :pool) OR (coll == :set)) THEN
          type__mark_heap_allocated_mut(&t);
        END
        TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ ListLit: COPY node }, t));
        node.storage = IF (((coll == :pool) OR (coll == :set))) THEN
          :heap
        ELSE
          :stack
        END;
        typeAnalysisSession__record_effect(rtoc_self_view, symbol("HEAP"));
        RETURN;
      END
      IF (node.storage == :heap) THEN
        TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ ListLit: COPY node }, TRY (type__new(TypeConstructionInput{ SymbolValue: symbol("Any[]") }, NIL, NIL, NIL, :heap))));
      ELSE
        TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ ListLit: COPY node }, symbol("Any[]")));
      END
      RETURN;
    END
    MUTABLE string_item_types = node.items |> SELECT { MUTABLE rtoc_mutable_block_param_409 = COPY _;
    &rtoc_mutable_block_param_409.full_type_mut("list literal string element") };
    MUTABLE all_strings = string_item_types |> ALL _.string?();
    MUTABLE string_element_sync =   IF all_strings THEN
      {
    MUTABLE rtoc_value_block_marker = 0;
    syncs = (string_item_types |> SELECT _.sync()) |> DISTINCT _ |> SELECT COPY _;
    (IF (scopeBindings__length(syncs) == 1) THEN
      syncs.first()
    ELSE
      NIL
    END)
    }
    ELSE
      NIL
    END;
    IF all_strings THEN
      MUTABLE base_type = :String;
    ELSE
      MUTABLE base_type = (UNWRAP (node.items.first())).resolved_type();
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < node.items.length() DO
      IF (rtoc_idx == 0) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF (node.items[rtoc_idx].resolved_type() != base_type) THEN
            typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :LIST_LITERAL_MIXED_TYPES }, [], {:base: base_type, :index: (rtoc_idx + 1), :got: node.items[rtoc_idx].resolved_type()});
      END
    rtoc_idx = rtoc_idx + 1;
      END
    END
    IF (node.storage == :stack) THEN
      MUTABLE inferred = TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("${base_type}[${node.items.size()}]") }));
      IF string_element_sync THEN
        TRY (type__set_elem_sync(&inferred, string_element_sync));
      END
      RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ ListLit: COPY node }, inferred));
    ELSE
      MUTABLE t = TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("${base_type}[]") }, NIL, NIL, NIL, :heap));
      IF string_element_sync THEN
        TRY (type__set_elem_sync(&t, string_element_sync));
      END
      type__mark_frame_allocated_mut(&t);
      RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ ListLit: COPY node }, t));
    END
}
END
PRIVATE FN typeAnalysisSession__visit_TupleLit(MUTABLE self: TypeAnalysisSession, MUTABLE node: TupleLit) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN node.items DO
    TRY (typeAnalysisSession__visit(&rtoc_self_view, _));
    END
    MUTABLE item_types = node.items |> SELECT { MUTABLE rtoc_mutable_block_param_410 = COPY _;
    &rtoc_mutable_block_param_410.full_type_mut("tuple literal item") };
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ TupleLit: COPY node }, TRY (type__generic_instance_of(:Tuple, item_types))));
    node.storage = :stack;
}
END
PRIVATE FN typeAnalysisSession__visit_DefaultArrayLit(self: TypeAnalysisSession, MUTABLE node: DefaultArrayLit) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE type_info = TRY (type__new(node.type_info));
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ DefaultArrayLit: COPY node }, type_info));
    node.storage = :stack;
    RETURN type_info;
}
END
PRIVATE FN typeAnalysisSession__visit_RangeLit(MUTABLE self: TypeAnalysisSession, MUTABLE node: RangeLit) RETURNS !?Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.start));
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.finish));
    MUTABLE start_type = (&node.start.full_type_mut()).resolved();
    MUTABLE finish_type = (&node.finish.full_type_mut()).resolved();
    IF !(type__numeric?((TRY (type__new(start_type))))) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :RANGE_START_NEEDS_NUMERIC }, [], {:got: start_type});
    END
    IF !(type__numeric?((TRY (type__new(finish_type))))) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :RANGE_END_NEEDS_NUMERIC }, [], {:got: finish_type});
    END
    MUTABLE start_is_float = type__float?((TRY (type__new(start_type))));
    MUTABLE finish_is_float = type__float?((TRY (type__new(finish_type))));
    IF (start_is_float != finish_is_float) THEN
      IF !(start_is_float) THEN
        node.start.coerced_type = :Float64;
      END
      IF !(finish_is_float) THEN
        node.finish.coerced_type = :Float64;
      END
    ELSE_IF start_is_float THEN
  
    ELSE
  
    END
    MUTABLE base_type =   IF (start_is_float OR finish_is_float) THEN
      :Float64
    ELSE
      :Int64
    END;
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("~${base_type}[]") }))));
}
END
PRIVATE FN typeAnalysisSession__visit_WithBlock(MUTABLE self: TypeAnalysisSession, MUTABLE node: WithBlock) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_ctx: ?FunctionContext@multiowned = typeAnalysisSession__current_fn_ctx(rtoc_self_view);
    IF fn_ctx EXISTS AS fn_ctx_value THEN
      MUTABLE fn_node: ?FunctionDef@multiowned = typeAnalysisSession__function_node_for(rtoc_self_view, fn_ctx_value.name);
      IF fn_node EXISTS AS fn_node_value THEN
        &fn_node_value.semantic_with_blocks.append(COPY node);
      END
    END
    typeAnalysisSession__phase_traversal_state(rtoc_self_view).with_block_depth=((typeAnalysisSession__phase_traversal_state(rtoc_self_view).with_block_depth() + 1));
    DEFER typeAnalysisSession__phase_traversal_state(rtoc_self_view).with_block_depth=((typeAnalysisSession__phase_traversal_state(rtoc_self_view).with_block_depth() - 1));
    MUTABLE capability_expansion = WithCapabilityPlan{ all: List[] };
    FOR _ IN node.capabilities DO
    MUTABLE rtoc_mutable_block_param_411 = COPY _;
    typeAnalysisSession__acquire_capability_mut(&rtoc_self_view, &node, &rtoc_mutable_block_param_411, &capability_expansion);
    END
    node.capability_plan = capability_expansion;
    MUTABLE capability_plan = TRY (capabilityPlan__require_for(node));
    MUTABLE expanded_capabilities = COPY capability_plan.all;
    MUTABLE lock_capabilities = TRY (withCapabilityPlan__locks(capability_plan));
    typeAnalysisSession__validate_with_match_source_shape_mut(rtoc_self_view, node, capability_expansion);
    typeAnalysisSession__check_nested_lock_reacquire_mut(rtoc_self_view, node, lock_capabilities);
    typeAnalysisSession__check_lock_rank_ordering_mut(rtoc_self_view, node, lock_capabilities);
    MUTABLE fn_name_for_lock: String = "<top>";
    IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
      fn_name_for_lock = ((typeAnalysisSession__current_fn_ctx(rtoc_self_view))?).name;
    END
    MUTABLE held_entries_now = TRY (typeAnalysisSession__current_held_lock_types(rtoc_self_view));
    MUTABLE is_match_form = !((node.arms == NIL));
    FOR _ IN lock_capabilities DO
    typeAnalysisSession__record_with_acquire_mut(rtoc_self_view, fn_name_for_lock, _, held_entries_now, node.deadlock_escape);
    IF !(is_match_form) THEN
        typeAnalysisSession__record_effect(rtoc_self_view, symbol("BLOCKING"));
        typeAnalysisSession__record_effect(rtoc_self_view, symbol("SUSPENDS"));
    END
    END
    MUTABLE is_snapshot_txn_body = ((node.snapshot_mode == :transaction));
    MUTABLE with_body = proc(%() USE(expanded_capabilities, is_snapshot_txn_body, node, MUTABLE rtoc_self_view) -> {
    typeAnalysisSession__record_body_fact_with_block_mut(rtoc_self_view, node);
    typeAnalysisSession__with_new_scope(rtoc_self_view, typeAnalysisSession__current_scope(rtoc_self_view), %() USE(expanded_capabilities, is_snapshot_txn_body, node, MUTABLE rtoc_self_view) -> {
      FOR _ IN expanded_capabilities DO
      typeAnalysisSession__declare_capability_scope_mut(rtoc_self_view, _);
      END
      typeAnalysisSession__validate_and_visit_with_guards_mut(&rtoc_self_view, node);
      typeAnalysisSession__with_body_fact_scope(rtoc_self_view, node, %() USE(node, MUTABLE rtoc_self_view) -> {
        rtoc_lambda_result_412 = TRY (typeAnalysisSession__visit_stmts(&rtoc_self_view, node.body));
        rtoc_lambda_result_412
      });
      typeAnalysisSession__validate_with_guard_no_body_mutation_mut(rtoc_self_view, node);
      MUTABLE fallible_sources = typeAnalysisSession__retryable_with_fallible_sources(rtoc_self_view, node);
      IF (is_snapshot_txn_body AND !((fallible_sources.length() == 0))) THEN
          typeAnalysisSession__retryable_with_fallible_body_error_mut(rtoc_self_view, node, "WITH SNAPSHOT ... AS MUTABLE", fallible_sources);
      END
      IF ((typeAnalysisSession__retryable_with_universal_poly_candidate?(rtoc_self_view, node) != NIL) AND !((fallible_sources.length() == 0))) THEN
          typeAnalysisSession__retryable_with_fallible_body_error_mut(rtoc_self_view, node, "WITH POLYMORPHIC", fallible_sources);
      END
      MUTABLE arms: ?[]WithMatchArm = COPY node.arms;
      IF arms EXISTS AS arms_value THEN
          MUTABLE arms_value_mutable = COPY arms_value;
          MUTABLE fn_ctx_name: ?String = COPY typeAnalysisSession__current_fn_ctx(rtoc_self_view)?.name;
          MUTABLE direct_effects = typeAnalysisSession__effect_direct_effects(rtoc_self_view);
          MUTABLE snapshot_branch_value: ?[Set]String@symbol = NIL;
          IF fn_ctx_name EXISTS AS fn_ctx_name_value THEN
            snapshot_branch_value = COPY typeAnalysisSession__effect_direct_effects_for(rtoc_self_view, fn_ctx_name_value);
          ELSE
            snapshot_branch_value = NIL;
          END
          MUTABLE snapshot: ?[Set]String@symbol = snapshot_branch_value;
          MUTABLE per_arm_effects = List[];
          FOR _ IN arms_value_mutable DO
        MUTABLE before_branch_value: ?[Set]String@symbol = NIL;
            IF fn_ctx_name EXISTS AS fn_ctx_name_value THEN
              before_branch_value = COPY typeAnalysisSession__effect_direct_effects_for(rtoc_self_view, fn_ctx_name_value);
            ELSE
              before_branch_value = NIL;
            END
        MUTABLE before: ?[Set]String@symbol = before_branch_value;
        FOR _ IN (TRY (typeAnalysisSession__with_match_family_effects(rtoc_self_view, _.family()))) DO
        typeAnalysisSession__record_effect(rtoc_self_view, _);
        END
        typeAnalysisSession__with_new_scope(rtoc_self_view, typeAnalysisSession__current_scope(rtoc_self_view), %() USE(node, _, MUTABLE rtoc_self_view) -> {
          typeAnalysisSession__with_body_fact_scope(rtoc_self_view, node, %() USE(_, MUTABLE rtoc_self_view) -> {
            rtoc_lambda_result_413 = TRY (typeAnalysisSession__visit_stmts(&rtoc_self_view, _.body()));
            rtoc_lambda_result_413
          });
          typeAnalysisSession__finalize_scope(rtoc_self_view, Locatable{ WithBlock: COPY node })
        });
        IF fn_ctx_name EXISTS AS fn_ctx_name_value THEN
              MUTABLE after = typeAnalysisSession__effect_direct_effects_for(rtoc_self_view, fn_ctx_name_value);
              MUTABLE arm_delta = (after - before?);
              &per_arm_effects.append(arm_delta);
              direct_effects[fn_ctx_name_value] = COPY UNWRAP (snapshot);
        END
          END
          IF ((fn_ctx_name != NIL) AND !((per_arm_effects.length() == 0))) THEN
            MUTABLE concrete = ((per_arm_effects |> REDUCE(per_arm_effects[0]) (ruby_set_intersection(acc, _))) OR Set[]);
            MUTABLE all_union = per_arm_effects |> REDUCE(Set[]) (ruby_set_union(acc, _));
            MUTABLE maybe_set = (all_union - concrete);
            MUTABLE maybe_projection = {symbol("CONTENTION"): symbol("CONTENTION_MAYBE"), symbol("BLOCKING"): symbol("BLOCKING_MAYBE")};
            MUTABLE target_effects = typeAnalysisSession__effect_direct_effects_for(rtoc_self_view, fn_ctx_name);
            FOR _ IN concrete DO
            &target_effects.insert(_);
            END
            FOR _ IN maybe_set DO
            &target_effects.insert((maybe_projection[_] OR_ELSE _));
            END
          END
      END
      typeAnalysisSession__finalize_scope(rtoc_self_view, Locatable{ WithBlock: COPY node })
    })
    });
    typeAnalysisSession__with_held_locks(&rtoc_self_view, node, lock_capabilities, %() USE(is_snapshot_txn_body, node, with_body, rtoc_self_view) -> {
    IF is_snapshot_txn_body THEN
      RETURN TRY (typeAnalysisSession__with_snapshot_transaction_body(rtoc_self_view, node, with_body));
    ELSE
      RETURN runtimeCallSpec__call(with_body);
    END
    NIL
    });
    FOR _ IN expanded_capabilities DO
    MUTABLE vname = _.var_name();
    IF capabilityTransition__restrict?(_) THEN
        MUTABLE rtoc_mutable_receiver_414 = typeAnalysisSession__ownership_graph(rtoc_self_view);
        TRY (ownershipGraph__release_borrow(&rtoc_mutable_receiver_414, "__restrict_${vname}"));
    ELSE_IF capabilityTransition__borrowed?(_) THEN
        MUTABLE rtoc_mutable_receiver_415 = typeAnalysisSession__ownership_graph(rtoc_self_view);
        TRY (ownershipGraph__release_borrow(&rtoc_mutable_receiver_415, "__borrowed_${vname}"));
    END
    END
    typeAnalysisSession__validate_no_multi_object_atomic_mut(rtoc_self_view, node);
    typeAnalysisSession__validate_lock_error_clause_mut(&rtoc_self_view, &node, lock_capabilities);
    typeAnalysisSession__mark_with_runtime_requirements_mut(rtoc_self_view, node);
    typeAnalysisSession__record_lock_clause_site_mut(rtoc_self_view, node, lock_capabilities);
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ WithBlock: COPY node }, :Void));
}
END
PRIVATE FN typeAnalysisSession__validate_with_match_source_shape_mut(self: TypeAnalysisSession, node: WithBlock, capability_plan: WithCapabilityPlan) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE arms: ?[]WithMatchArm = COPY node.arms;
    IF arms EXISTS AS arms_value THEN
      IF (node.snapshot_mode == NIL) THEN
        MUTABLE mutable_cap = capability_plan.all |> FIND _.alias_mutable();
        IF (mutable_cap AND (arms_value |> ANY (_.family() == :VERSIONED))) THEN
          typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_MATCH_VERSIONED_AS_MUTABLE }, [], {:name: mutable_cap.var_name()});
        END
        IF !((capability_plan.all.length() > 1)) THEN
          RETURN;
        END
        MUTABLE names = (capability_plan.all |> SELECT _.var_name()).join(", ");
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_MATCH_MULTI_CELL }, [], {:names: names});
      ELSE
        RETURN;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__mark_with_runtime_requirements_mut(self: TypeAnalysisSession, node: WithBlock) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fn_ctx: ?FunctionContext@multiowned = typeAnalysisSession__current_fn_ctx(rtoc_self_view);
    IF fn_ctx EXISTS AS fn_ctx_value THEN
      MUTABLE fn_ctx_value_mutable = COPY fn_ctx_value;
      IF typeAnalysisSession__with_block_uses_runtime?(rtoc_self_view, node) THEN
        fn_ctx_value_mutable.uses_rt = TRUE;
      END
      typeAnalysisSession__mark_unrequired_polymorphic_with_runtime_mut(rtoc_self_view, node, &fn_ctx_value_mutable);
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__with_block_uses_runtime?(self: TypeAnalysisSession, node: WithBlock) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (((node.snapshot_mode == :read) OR (node.snapshot_mode == :transaction)) OR typeAnalysisSession__with_block_has_versioned_arm?(rtoc_self_view, node));
}
END
PRIVATE FN typeAnalysisSession__with_block_has_versioned_arm?(self: TypeAnalysisSession, node: WithBlock) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN !(!((IF node.arms != NIL THEN
      node.arms |> ANY (_.family() == :VERSIONED)
    ELSE
      NIL
    END)));
}
END
PRIVATE FN typeAnalysisSession__mark_unrequired_polymorphic_with_runtime_mut(self: TypeAnalysisSession, node: WithBlock, MUTABLE fn_ctx: FunctionContext) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE bound_name: ?String = typeAnalysisSession__unrequired_polymorphic_runtime_bound_name(rtoc_self_view, node);
    IF bound_name EXISTS AS bound_name_value THEN
      MUTABLE fn_node: ?FunctionDef@multiowned = typeAnalysisSession__function_node_for(rtoc_self_view, fn_ctx.name);
      IF fn_node EXISTS AS fn_node_value THEN
        MUTABLE fn_node_value_mutable = COPY fn_node_value;
        IF !(typeAnalysisSession__with_requires_binding?(rtoc_self_view, CAST(fn_node_value_mutable AS FunctionDef), bound_name_value)) THEN
          fn_ctx.uses_rt = TRUE;
          fn_node_value_mutable.can_fail = TRUE;
        ELSE
          RETURN;
        END
      ELSE
        RETURN;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__unrequired_polymorphic_runtime_bound_name(self: TypeAnalysisSession, node: WithBlock) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE capability_plan = TRY (capabilityPlan__require_for(node));
    IF !((node.polymorphic AND (capability_plan.all.length() == 1))) THEN
      RETURN NIL;
    END
    MUTABLE bound_fact = withCapabilityPlan__first_transition(capability_plan);
    MUTABLE bound_var = COPY bound_fact.var_node;
    MUTABLE bound_sym = IF TRUE THEN
      aST__node__symbol(bound_var)
    ELSE
      NIL
    END;
    IF !(((TRUE AND respondsTo?(bound_sym, "is_param")) AND bound_sym.is_param())) THEN
      RETURN NIL;
    END
    RETURN COPY bound_fact.var_name;
}
END
PRIVATE FN typeAnalysisSession__with_requires_binding?(self: TypeAnalysisSession, fn_node: FunctionDef, bound_name: ?String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN !(!((((TRUE AND fn_node.requires) AND fn_node.requires.contains?(bound_name)))));
}
END
PRIVATE FN typeAnalysisSession__retryable_with_fallible_sources(self: TypeAnalysisSession, node: WithBlock) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE sources: []String = ( { MUTABLE rtoc_empty_list_418: []String = List[]; rtoc_empty_list_418 } );
    FOR _ IN typeAnalysisSession__current_body_fact_scope_nodes(rtoc_self_view, node) DO
    IF (_ IS_A Raise) THEN
      &sources.append("RAISE");
    ELSE_IF (_ IS_A OrElseRaise) THEN
      &sources.append("OR_ELSE RAISE");
    ELSE_IF _ IS_A FuncCall AS func_call THEN
      IF typeAnalysisSession__retryable_with_call_fallible?(rtoc_self_view, Node{ FuncCall: COPY func_call }) THEN
        &sources.append(COPY CAST(funcCall__name(func_call) AS String));
      END
    ELSE_IF (_ IS_A MethodCall) THEN
      IF typeAnalysisSession__retryable_with_call_fallible?(rtoc_self_view, castLocatableToNode(_)) THEN
        &sources.append("${_.name()}()");
      END
    ELSE_IF _ IS_A StaticCall AS static_call THEN
      IF typeAnalysisSession__retryable_with_call_fallible?(rtoc_self_view, Node{ StaticCall: COPY static_call }) THEN
        &sources.append(COPY CAST(static_call.method_name AS String));
      END
    ELSE_IF _ IS_A FreezeNode AS freeze_node THEN
      &sources.append("FREEZE");
    END
    END
    RETURN CAST((sources |> DISTINCT _) AS []String);
}
END
PRIVATE FN typeAnalysisSession__retryable_with_call_fallible?(self: TypeAnalysisSession, node: Node) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (TRUE AND aST__node__can_fail(node)) THEN
      RETURN TRUE;
    END
    IF (respondsTo?(node, "error_union_type") AND node.error_union_type()) THEN
      RETURN TRUE;
    END
    RETURN FALSE;
}
END
PRIVATE FN typeAnalysisSession__retryable_with_universal_poly_candidate?(self: TypeAnalysisSession, node: WithBlock) RETURNS !?Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node.universal_poly THEN
      RETURN TRUE;
    END
    MUTABLE capability_plan = TRY (capabilityPlan__require_for(node));
    IF !((node.polymorphic AND (capability_plan.all.length() == 1))) THEN
      RETURN FALSE;
    END
    MUTABLE bound_fact = withCapabilityPlan__first_transition(capability_plan);
    MUTABLE bound_var = COPY bound_fact.var_node;
    MUTABLE bound_name = COPY bound_fact.var_name;
    MUTABLE bound_sym = IF TRUE THEN
      aST__node__symbol(bound_var)
    ELSE
      NIL
    END;
    MUTABLE is_param = ((TRUE AND respondsTo?(bound_sym, "is_param")) AND bound_sym.is_param());
    MUTABLE fn_node: ?FunctionDef@multiowned = typeAnalysisSession__function_node_for(rtoc_self_view, typeAnalysisSession__current_fn_ctx(rtoc_self_view)?.name);
    MUTABLE has_req = ((((fn_node != NIL) AND TRUE) AND fn_node.requires) AND fn_node.requires.contains?(bound_name));
    RETURN (is_param AND !(has_req));
}
END
PRIVATE FN typeAnalysisSession__retryable_with_fallible_body_error_mut(self: TypeAnalysisSession, node: WithBlock, with_name: String, sources: []String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE detail = sources.first(3).join(", ");
    IF (sources.length() > 3) THEN
      detail = (detail + ", ...");
    END
    typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_RETRYABLE_FALLIBLE_BODY }, [], {:with_name: with_name, :detail: detail});
}
END
PRIVATE FN typeAnalysisSession__validate_lock_error_clause_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: WithBlock, lock_capabilities: []CapabilityTransition) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE clause = node.lock_error_clause;
    MUTABLE is_snapshot_txn = (node.snapshot_mode == :transaction);
    IF ((node.arms != NIL) AND is_snapshot_txn) THEN
      typeAnalysisSession__validate_snapshot_match_arms_mut(&rtoc_self_view, node);
      RETURN;
    END
    MUTABLE capability_plan = TRY (capabilityPlan__require_for(node));
    MUTABLE has_atomic_ptr = (is_snapshot_txn AND ((TRY (withCapabilityPlan__snapshot_transitions(capability_plan))) |> ANY {
    MUTABLE sym: ?SymbolEntry@multiowned = COPY KEEP _.source_entry;
    (((sym != NIL) AND symbolEntry__atomic?(sym)) AND symbolEntry__indirect?(sym))
    }));
    IF (is_snapshot_txn AND (clause == NIL)) THEN
      MUTABLE target_error = IF has_atomic_ptr THEN
        :AtomicConflict
      ELSE
        :MvccConflict
      END;
      MUTABLE synth: ?ErrorClause = typeAnalysisSession__synthesize_clause_from_policy(rtoc_self_view, target_error);
      IF synth EXISTS AS synth_value THEN
        node.lock_error_clause = synth_value;
        clause = synth_value;
      ELSE
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_SNAPSHOT_NEEDS_HANDLER }, [], {:error: target_error});
      END
    END
    IF (has_atomic_ptr AND clause) THEN
      MUTABLE bad_selector = clause.selectors() |> FIND ((_.form() == :type) AND (_.name() == :MvccConflict));
      IF bad_selector EXISTS AS bad_selector_value THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_ATOMIC_HANDLER_WRONG_ERROR });
      END
    END
    IF !(clause) THEN
      RETURN;
    END
    MUTABLE has_guard = !(((TRY (withCapabilityPlan__guarded(capability_plan))).length() == 0));
    MUTABLE has_fallible = ((has_guard OR is_snapshot_txn) OR !((lock_capabilities.length() == 0)));
    IF !(has_fallible) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :ON_RETRY_NEEDS_FALLIBLE_CAP });
    END
    typeAnalysisSession__resolve_error_selectors_mut(rtoc_self_view, node, &clause, is_snapshot_txn);
    IF (clause.action() IS_A Exit) THEN
      TRY (typeAnalysisSession__visit(&rtoc_self_view, clause.message()));
    ELSE_IF (clause.action() IS_A Return) THEN
      TRY (typeAnalysisSession__visit(&rtoc_self_view, clause.value()));
    ELSE_IF (clause.action() == ErrorActionKind.Block) THEN
      TRY (typeAnalysisSession__visit_stmts(&rtoc_self_view, clause.body()));
    END
}
END
PRIVATE FN typeAnalysisSession__reject_bare_atomic_ptr_mutation_mut(self: TypeAnalysisSession, field_node: GetField, assignment_node: Assignment) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE root: GetField = COPY field_node;
    WHILE (TRUE AND !(root IS_A Identifier)) DO
      root = castLocatableToGetField(COPY root.target);
    END
    IF !(root IS_A Identifier) THEN
      RETURN;
    END
    MUTABLE sym: ?SymbolEntry = root.symbol;
    IF sym EXISTS AS sym_value THEN
      IF !(symbolEntry__atomic?(sym_value)) THEN
        RETURN;
      END
      IF !((TRUE AND symbolEntry__indirect?(sym_value))) THEN
        RETURN;
      END
      typeAnalysisSession__error_mut(rtoc_self_view, assignment_node, TypeAnalysisCodeOrMessage{ SymbolValue: :INDIRECT_ATOMIC_FIELD_WRITE }, [], {:name: getField__name(root), :field: typeAnalysisSession__field_name_for_msg(rtoc_self_view, field_node)});
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__field_name_for_msg(self: TypeAnalysisSession, node: GetField) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (TRUE AND node.field) THEN
      RETURN COPY CAST(node.field AS String);
    END
    RETURN "<field>";
}
END
PRIVATE FN typeAnalysisSession__validate_no_multi_object_atomic_mut(self: TypeAnalysisSession, node: WithBlock) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE capability_plan = TRY (capabilityPlan__require_for(node));
    MUTABLE caps = TRY (withCapabilityPlan__sync_constrained(capability_plan));
    IF (caps.length() < 2) THEN
      RETURN;
    END
    MUTABLE arm_admits_atomic = ((node.arms OR_ELSE List[])) |> ANY (_.family() == :ATOMIC);
    MUTABLE offender: ?CapabilityTransition = caps |> FIND typeAnalysisSession__cap_admits_atomic?(rtoc_self_view, _);
    IF !((offender OR_ELSE arm_admits_atomic)) THEN
      RETURN;
    END
    MUTABLE var_name: String = "";
    IF offender EXISTS AS offender_value THEN
      var_name = COPY offender_value.var_name;
    ELSE
      var_name = "this WITH";
    END
    typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_MULTI_OBJECT_ATOMIC }, [], {:name: var_name});
}
END
PRIVATE FN typeAnalysisSession__cap_admits_atomic?(self: TypeAnalysisSession, cap: CapabilityTransition) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE sym: ?SymbolEntry@multiowned = COPY KEEP cap.source_entry;
    IF sym EXISTS AS sym_value THEN
      IF symbolEntry__atomic?(sym_value) THEN
        RETURN TRUE;
      END
      MUTABLE fams: ?[Set]String@symbol = COPY sym_value.sync_families;
      IF !((fams != NIL)) THEN
        RETURN FALSE;
      END
      MUTABLE expanded = TRY (withMatchCheck__expand_snapshotted(fams));
      RETURN expanded.contains?(:ATOMIC);
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN typeAnalysisSession__validate_snapshot_match_arms_mut(MUTABLE self: TypeAnalysisSession, node: WithBlock) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN ((node.arms OR_ELSE List[])) DO
    MUTABLE clauses = _.lock_error_clauses();
    IF (_.family() == :VERSIONED) THEN
        IF clauses.empty?() THEN
          MUTABLE synth: ?ErrorClause = typeAnalysisSession__synthesize_clause_from_policy(rtoc_self_view, :MvccConflict);
          IF synth EXISTS AS synth_value THEN
            _.lock_error_clauses = [synth_value];
          ELSE
            typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_SNAPSHOT_MATCH_VERSIONED_NEEDS_HANDLER });
          END
        END
    ELSE_IF (_.family() == :ATOMIC) THEN
        IF !(clauses.empty?()) THEN
          typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :WITH_SNAPSHOT_MATCH_ATOMIC_FORBIDS_HANDLER });
        END
    END
    END
    FOR _ IN ((node.arms OR_ELSE List[])) DO
    FOR _ IN _.lock_error_clauses() DO
    IF (_.action() IS_A Exit) THEN
      TRY (typeAnalysisSession__visit(&rtoc_self_view, _.message()));
    ELSE_IF (_.action() == ErrorActionKind.Block) THEN
      TRY (typeAnalysisSession__visit_stmts(&rtoc_self_view, _.body()));
    END
    END
    END
}
END
PRIVATE FN typeAnalysisSession__resolve_error_selectors_mut(self: TypeAnalysisSession, node: WithBlock, MUTABLE clause: ErrorClause, is_snapshot_txn: Bool = FALSE) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE possible = Set[];
    IF is_snapshot_txn THEN
      possible.merge(snapshot_possible_types);
    END
    MUTABLE capability_plan = TRY (capabilityPlan__require_for(node));
    IF (TRY (withCapabilityPlan__locks(capability_plan))) |> ANY _ THEN
      possible.merge(lock_possible_types);
    END
    IF !(((TRY (withCapabilityPlan__guarded(capability_plan))).length() == 0)) THEN
      &possible.insert(:GuardFail);
    END
    possible = possible |> SELECT COPY _;
    MUTABLE matched = List[];
    FOR _ IN clause.selectors DO
    MUTABLE form = COPY _.form;
    MUTABLE name = COPY _.name;
    MUTABLE token: ?Token@multiowned = COPY KEEP _.token;
    MUTABLE diagnostic_token = (token OR_ELSE node.token);
    IF (form == :kind) THEN
        IF !(aST__error_kind?(name)) THEN
          typeAnalysisSession__emit_registry_mismatch_mut(rtoc_self_view, diagnostic_token, NameCandidate{ SymbolValue: COPY name }, ruby_constant_error_kinds() |> SELECT _.toString(), "Unknown error kind '${name}'. Expected one of: ${(ruby_constant_error_kinds() |> SELECT _.toString()).join(", ")}", "closest known kind");
        END
        IF aST__error_kind?(name) THEN
          matched = ruby_array_concat_Any(matched, CAST(TRY (aST__types_for_kind(name)) AS []Any));
        END
    ELSE_IF (form == :type) THEN
        IF !(TRY (aST__error_type?(name))) THEN
          typeAnalysisSession__emit_registry_mismatch_mut(rtoc_self_view, diagnostic_token, NameCandidate{ SymbolValue: COPY name }, TRY (aST__error_type_names()), "Unknown error type '${name}'. Register it in src/ast/error_registry.rb.", "closest registered type");
        END
        IF TRY (aST__error_type?(name)) THEN
          &matched.append(name);
        END
    END
    END
    &matched.uniq_mut();
    IF clause.retries EXISTS AS retries_value THEN
      MUTABLE non_transient = matched |> WHERE !((TRY (aST__kind_of_type(_)) == :Transient));
      IF !((non_transient.length() == 0)) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, (KEEP clause.token OR_ELSE node), TypeAnalysisCodeOrMessage{ SymbolValue: :RETRY_ONLY_TRANSIENT }, [], {:types: non_transient.join(", ")});
      END
    END
    MUTABLE overlap = ruby_set_intersection_Any_set(matched, possible);
    IF overlap.empty?() THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :SELECTORS_NO_MATCH }, [], {:matched: matched.join(", "), :possible: "any error the WITH acquire can produce (${possible.join(", ")})."});
    END
    clause.matched_types = overlap;
    clause.bubble_types = (possible - overlap);
}
END
PRIVATE FN typeAnalysisSession__visit_DoBlock(MUTABLE self: TypeAnalysisSession, MUTABLE node: DoBlock) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN node.branches DO
    MUTABLE rtoc_mutable_block_param_419 = COPY _;
    MUTABLE full_analysis: ?CaptureAnalysis = NIL;
    typeAnalysisSession__with_async_body_fact_frame(rtoc_self_view, rtoc_mutable_block_param_419, AsyncValidationNode{ DoBlock: COPY node }, %() USE(rtoc_mutable_block_param_419, MUTABLE rtoc_self_view) -> {
      full_analysis = typeAnalysisSession__with_fiber_capture_analysis(rtoc_self_view, rtoc_mutable_block_param_419.parallel(), %() USE(rtoc_mutable_block_param_419, MUTABLE rtoc_self_view) -> {
        TRY (typeAnalysisSession__visit_stmts(&rtoc_self_view, rtoc_mutable_block_param_419.body()));
        rubyToClearVoid()
      });
      rubyToClearVoid()
    });
    MUTABLE analysis_result = full_analysis?;
    selectOp__set_capture_analysis(&rtoc_mutable_block_param_419, analysis_result);
    IF rtoc_mutable_block_param_419.parallel() THEN
        IF analysis_result.has_local THEN
          typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :LOCAL_VAR_NOT_IN_PARALLEL });
        END
        IF analysis_result.has_rc THEN
          typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :MULTIOWNED_NOT_IN_PARALLEL });
        END
    END
    IF analysis_result.has_non_escaping_capture THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :DO_CAPTURES_WITH_SCOPED });
    END
    MUTABLE analysis_branch_value: ?CaptureAnalysis = NIL;
      IF (((!(rtoc_mutable_block_param_419.pinned()) AND !(rtoc_mutable_block_param_419.parallel())) AND analysis_result.has_shared)) THEN
        analysis_branch_value = analysis_result;
      ELSE
        analysis_branch_value = NIL;
      END
    MUTABLE analysis: ?CaptureAnalysis = analysis_branch_value;
    IF ((analysis != NIL) AND !(rtoc_mutable_block_param_419.pinned())) THEN
        rtoc_mutable_block_param_419.pinned = TRUE;
        typeAnalysisSession__note_mut(rtoc_self_view, node, "DO branch auto-pinned \u{2014} captures shared/locked resource. Use @parallel to distribute.");
    END
    END
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node, :Void));
}
END
PRIVATE FN typeAnalysisSession__visit_BgStreamBlock(MUTABLE self: TypeAnalysisSession, MUTABLE node: BgStreamBlock) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__record_effect(rtoc_self_view, symbol("LOOP_UNBOUND"));
    MUTABLE stream_analysis: ?CaptureAnalysis = NIL;
    MUTABLE yield_types: []Type@multiowned = TRY (typeAnalysisSession__with_stream_yield_frame(rtoc_self_view, node, %() USE(node, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_420 = typeAnalysisSession__with_async_body_fact_frame(rtoc_self_view, AsyncBodyNode{ BgStreamBlock: COPY node }, AsyncValidationNode{ BgStreamBlock: COPY node }, %() USE(node, MUTABLE rtoc_self_view) -> {
    stream_analysis = typeAnalysisSession__with_fiber_capture_analysis(rtoc_self_view, %() USE(node, MUTABLE rtoc_self_view) -> {
      TRY (typeAnalysisSession__visit_stmts(&rtoc_self_view, node.body));
      rubyToClearVoid()
    });
    rubyToClearVoid()
    });
    rtoc_lambda_result_420
    }));
    MUTABLE stream_analysis_result = stream_analysis?;
    IF (yield_types.length() == 0) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :BG_STREAM_NO_YIELD });
    END
    MUTABLE inferred_join = TRY (tenseOperationPlanner__join_async_results(yield_types));
    IF ((node.declared_yield_type == NIL) AND !(tenseJoinPlan__success?(inferred_join))) THEN
      MUTABLE surfaces = CAST(((yield_types |> SELECT TRY (type__surface_name(TypeTypeInput{ Type: COPY _ }))) |> DISTINCT _) AS []String);
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :BG_STREAM_INCONSISTENT_YIELD }, [], {:types: surfaces.join(", "), :union_shape: "Union<${surfaces.join(", ")}>"});
    ELSE_IF (((node.declared_yield_type == NIL) AND (inferred_join.result_type != NIL)) AND typeAnalysisSession__stream_yields_contract_required?(rtoc_self_view, UNWRAP (inferred_join.result_type))) THEN
      typeAnalysisSession__emit_missing_stream_yields_contract_mut(rtoc_self_view, node, UNWRAP (inferred_join.result_type));
    END
    MUTABLE element_type = (IF node.declared_yield_type != NIL THEN node.declared_yield_type ELSE UNWRAP (inferred_join.result_type) END);
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BgStreamBlock: COPY node }, TRY (type__new(TypeConstructionInput{ TypeExpression: COPY typeExpression__of(StreamTypeExpression{ cardinality: TypeExpressionDimension{ SymbolValue: :FINITE }, item: COPY element_type.shape.expression }) }))));
    node.capture_analysis = stream_analysis_result;
    IF stream_analysis_result.has_non_escaping_capture THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :BG_STREAM_CAPTURES_WITH_SCOPED });
    END
}
END
PRIVATE FN typeAnalysisSession__visit_YieldExpr(MUTABLE self: TypeAnalysisSession, MUTABLE node: YieldExpr) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE frame: ?StreamYieldFrame = typeAnalysisSession__current_stream_yield_frame(rtoc_self_view);
    IF frame EXISTS AS frame_value THEN
      MUTABLE frame_value_mutable = COPY frame_value;
      IF frame_value_mutable.closed THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :YIELD_AFTER_CLOSE });
      END
      TRY (typeAnalysisSession__visit(&rtoc_self_view, node.expr));
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ YieldExpr: COPY node }, &node.expr.full_type_mut("yield expression")));
      MUTABLE yielded_type = TRY (type__new(TypeConstructionInput{ Type: COPY &node.full_type_mut("yield result") }));
      MUTABLE expected_type: ?Type = COPY frame_value_mutable.expected_type;
      IF ((expected_type != NIL) AND !(TRY (type__accepts?(expected_type, yielded_type)))) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :BG_STREAM_INCONSISTENT_YIELD }, [], {:types: "${TRY (type__surface_name(castTypeToTypeTypeInput(expected_type)))}, ${TRY (type__surface_name(castTypeToTypeTypeInput(yielded_type)))}", :union_shape: "Union<${TRY (type__surface_name(castTypeToTypeTypeInput(expected_type)))}, ${TRY (type__surface_name(castTypeToTypeTypeInput(yielded_type)))}>"});
      END
      &frame_value_mutable.yield_types.append(COPY yielded_type);
      typeAnalysisSession__record_effect(rtoc_self_view, symbol("SUSPENDS"));
    ELSE
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :YIELD_OUTSIDE_BG_STREAM });
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__stream_yields_contract_required?(self: TypeAnalysisSession, type: Type) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF type__future?(type) THEN
      RETURN TRUE;
    END
    RETURN (typeAnalysisSession__lookup_type_schema(rtoc_self_view, type__resolved(type))) IS_A UnionSchema;
}
END
PRIVATE FN typeAnalysisSession__emit_missing_stream_yields_contract_mut(self: TypeAnalysisSession, node: BgStreamBlock, contract: Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE contract_name = TRY (type__surface_name(castTypeToTypeTypeInput(contract)));
    MUTABLE source: ?String = typeAnalysisSession__source_code(rtoc_self_view);
    MUTABLE token = COPY node.token;
    MUTABLE fix: ?Fix = NIL;
    IF ((source != NIL) AND TRUE) THEN
      MUTABLE line: ?String = COPY source.split("\n")[(token.line - 1)];
      MUTABLE start = (token.column - 1);
      MUTABLE stream_at: ?Int64 = (IF line != NIL THEN
        line.indexOf(compilerRegexCompile("\\bSTREAM\\b"), start)
      ELSE
        NIL
      END);
      IF stream_at EXISTS AS stream_at_value THEN
        MUTABLE insert_col = ((stream_at_value + "STREAM".codepointCount()) + 1);
        fix = TRY (fix__new(typeAnalysisSession__fix_description(rtoc_self_view, :ADD_STREAM_YIELDS_CONTRACT, {:type: DiagnosticKwValue{ StringValue: COPY contract_name }}), [edit__new(span__new(NIL, token.line, insert_col, 0), " YIELDS ${contract_name}")], :auto));
      END
    END
    IF fix EXISTS AS fix_value THEN
      typeAnalysisSession__fixable_mut(rtoc_self_view, node, :type, [fix_value], NIL, :BG_STREAM_YIELDS_REQUIRED, :error, FALSE, {:type: contract_name});
    ELSE
      RETURN typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :BG_STREAM_YIELDS_REQUIRED }, [], {:type: contract_name});
    END
}
END
PRIVATE FN typeAnalysisSession__visit_CloseStream(self: TypeAnalysisSession, MUTABLE node: CloseStream) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE frame: ?StreamYieldFrame = typeAnalysisSession__current_stream_yield_frame(rtoc_self_view);
    IF !(frame) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :CLOSE_OUTSIDE_BG_STREAM });
    END
    IF frame.closed THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :STREAM_ALREADY_CLOSED });
    END
    frame.closed = TRUE;
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ CloseStream: COPY node }, :Void));
    MUTABLE rtoc_writer_receiver_421: TraversalState = typeAnalysisSession__phase_traversal_state(rtoc_self_view);
    rtoc_writer_receiver_421.branch_terminated = TRUE;
}
END
PRIVATE FN typeAnalysisSession__visit_BgBlock(MUTABLE self: TypeAnalysisSession, MUTABLE node: BgBlock) RETURNS !?Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__record_effect(rtoc_self_view, symbol("YIELD"));
    MUTABLE prev_bg_pinned = typeAnalysisSession__phase_traversal_state(rtoc_self_view).current_bg_pinned;
    MUTABLE rtoc_writer_receiver_422: TraversalState = typeAnalysisSession__phase_traversal_state(rtoc_self_view);
    rtoc_writer_receiver_422.current_bg_pinned = !(!(node.pinned));
    DEFER MUTABLE rtoc_writer_receiver_423: TraversalState = typeAnalysisSession__phase_traversal_state(rtoc_self_view);
    rtoc_writer_receiver_423.current_bg_pinned = prev_bg_pinned;
    MUTABLE last_type: Type = TRY (type__new(TypeConstructionInput{ SymbolValue: :Void }));
    MUTABLE full_analysis: ?CaptureAnalysis = NIL;
    typeAnalysisSession__with_async_body_fact_frame(rtoc_self_view, AsyncBodyNode{ BgBlock: COPY node }, AsyncValidationNode{ BgBlock: COPY node }, %() USE(node, MUTABLE rtoc_self_view) -> {
    full_analysis = typeAnalysisSession__with_fiber_capture_analysis(rtoc_self_view, &node.parallel, TRUE, %() USE(node, MUTABLE rtoc_self_view) -> {
      FOR _ IN node.body DO
        MUTABLE rtoc_mutable_block_param_424 = COPY _;
        TRY (typeAnalysisSession__visit(&rtoc_self_view, rtoc_mutable_block_param_424));
        last_type = (typeAnalysisSession__recoverable_result_type(rtoc_self_view, &rtoc_mutable_block_param_424, "BG body expression") OR_ELSE (CAST(rtoc_mutable_block_param_424 AS Locatable)).full_type_mut("BG body expression"));
      END
      rubyToClearVoid()
    });
    rubyToClearVoid()
    });
    MUTABLE analysis_result = full_analysis?;
    MUTABLE declared_payload: ?Type = COPY CAST(node.declared_async_payload AS ?Type);
    IF declared_payload EXISTS AS declared_payload_value THEN
      last_type = declared_payload?;
    END
    IF (type__error_union?(last_type) AND ((node.body.last() != NIL) AND respondsTo?(((node.body.last())?), "retain_error_channel="))) THEN
      node.body.last().retain_error_channel = TRUE;
    END
    MUTABLE payload_type = typeAnalysisSession__owned_async_payload_type(rtoc_self_view, last_type);
    node.async_result_shape = TRY (asyncResultShape__promise(CAST(payload_type AS Type)));
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("~${payload_type}") }))));
    IF node.arena_mode THEN
      node.pinned = TRUE;
      IF node.parallel THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :BG_ARENA_AND_PARALLEL });
      END
    END
    node.capture_analysis = analysis_result;
    IF node.parallel THEN
      IF analysis_result.has_local THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :LOCAL_VAR_NOT_IN_PARALLEL });
      END
      IF analysis_result.has_rc THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :MULTIOWNED_NOT_IN_PARALLEL });
      END
    END
    IF analysis_result.has_non_escaping_capture THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :BG_CAPTURES_WITH_SCOPED });
    END
    MUTABLE analysis_branch_value: ?CaptureAnalysis = NIL;
    IF (((!(node.pinned) AND !(node.parallel)) AND analysis_result.has_shared)) THEN
      analysis_branch_value = analysis_result;
    ELSE
      analysis_branch_value = NIL;
    END
    MUTABLE analysis: ?CaptureAnalysis = analysis_branch_value;
    IF ((prev_bg_pinned AND !(node.pinned)) AND analysis_result.has_outer_ref) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :BG_PINNED_CAPTURE_MISMATCH });
    END
    IF ((analysis != NIL) AND !(node.pinned)) THEN
      IF analysis.has_local THEN
        node.pinned = :local;
        typeAnalysisSession__note_mut(rtoc_self_view, node, "BG block auto-pinned \u{2014} captures @local resource (same-scheduler affinity).");
      ELSE_IF analysis.has_affine_locked THEN
        node.pinned = :shared;
        typeAnalysisSession__note_mut(rtoc_self_view, node, "BG block auto-pinned \u{2014} captures @locked resource (round-robin scheduler affinity).");
      ELSE
        node.pinned = :local;
        IF analysis.has_sharded THEN
          typeAnalysisSession__note_mut(rtoc_self_view, node, "BG block auto-pinned \u{2014} captures @sharded map (scheduler affinity for shard locality).");
        ELSE
          typeAnalysisSession__note_mut(rtoc_self_view, node, "BG block auto-pinned \u{2014} captures shared/locked resource. Use @parallel to override.");
        END
      END
    END
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__visit_ThenChain(MUTABLE self: TypeAnalysisSession, MUTABLE node: ThenChain) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE last_type: Type = TRY (type__new(TypeConstructionInput{ SymbolValue: :Void }));
    FOR _ IN node.steps DO
    TRY (typeAnalysisSession__visit(&rtoc_self_view, _.expr()));
    MUTABLE step_type = _.expr().full_type_mut({:context: "THEN step"});
    MUTABLE binding = _.binding();
    IF binding THEN
        MUTABLE bind_type = COPY step_type;
        IF step_type.error_union?() THEN
          bind_type = step_type.payload_type();
        END
        MUTABLE rtoc_mutable_receiver_425 = typeAnalysisSession__current_scope(rtoc_self_view);
        TRY (scope__declare(&rtoc_mutable_receiver_425, binding, NIL, bind_type, ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
        typeAnalysisSession__record_capture_local_mut(rtoc_self_view, CAST(_.binding() AS String));
    END
    last_type = step_type;
    END
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ ThenChain: COPY node }, last_type));
}
END
PRIVATE FN typeAnalysisSession__visit_NextExpr(MUTABLE self: TypeAnalysisSession, MUTABLE node: NextExpr) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    typeAnalysisSession__record_effect(rtoc_self_view, symbol("YIELD"));
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.expr));
    MUTABLE expr = COPY node.expr;
    MUTABLE promise_type = &expr.full_type_mut("NEXT expression");
    IF !(type__future?(promise_type)) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :NEXT_NEEDS_FUTURE }, [], {:got: &expr.full_type_mut("NEXT non-future expression")});
    END
    typeAnalysisSession__record_effect(rtoc_self_view, symbol("SUSPENDS"));
    MUTABLE async_shape = IF expr IS_A Identifier THEN
      (IF expr.symbol() != NIL THEN
      { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_427 = (expr.symbol());
    symbolEntry__async_result_shape(rtoc_local_receiver_427) }
    ELSE
      NIL
    END)
    ELSE
      NIL
    END;
    IF async_shape.promise?() THEN
      IF (IF expr IS_A Identifier AS identifier THEN !(async_shape.shared_promise?()) ELSE FALSE END) THEN
        TRY (typeAnalysisSession__og_set_moved(rtoc_self_view, expr.name(), expr.token(), :next));
      END
      MUTABLE result_type = COPY (typeAnalysisSession__publish_scalar_next_plan(rtoc_self_view, &node, promise_type, (async_shape.shared_promise?() OR promise_type.shared_promise?()))).result_type;
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ NextExpr: COPY node }, result_type));
      IF typeAnalysisSession__async_next_result_requires_heap?(rtoc_self_view, result_type) THEN
        node.storage = :heap;
      END
    ELSE_IF promise_type.promise_list?() THEN
      IF expr IS_A Identifier AS identifier THEN
        TRY (typeAnalysisSession__og_set_moved(rtoc_self_view, identifier__name(identifier), identifier.token, :next));
      END
      MUTABLE plan = TRY (tenseOperationPlanner__next_value(promise_type));
      node.tense_plan = plan;
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ NextExpr: COPY node }, plan.result_type));
    ELSE_IF TRY (type__observable_array_future?(promise_type)) THEN
      IF expr IS_A Identifier AS identifier THEN
        TRY (typeAnalysisSession__og_set_moved(rtoc_self_view, identifier__name(identifier), identifier.token, :next));
      END
      MUTABLE elem_sym = type__to_sym((TRY (type__element_type((TRY (type__tense_type(promise_type)))))));
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ NextExpr: COPY node }, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("${elem_sym}[]") }))));
      node.storage = :heap;
    ELSE_IF TRY (type__split_open_stream?(promise_type)) THEN
      elem_sym = type__to_sym((TRY (type__open_stream_element_type(promise_type))));
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ NextExpr: COPY node }, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("?${elem_sym}") }))));
    ELSE_IF TRY (type__dynamic_stream?(promise_type)) THEN
      elem_sym = type__to_sym((TRY (type__element_type((TRY (type__tense_type(promise_type)))))));
      IF type__canonical_stream?(promise_type) THEN
        TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ NextExpr: COPY node }, TRY (type__stream_step_of(TRY (type__element_type((TRY (type__tense_type(promise_type)))))))));
      ELSE
        TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ NextExpr: COPY node }, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("?${elem_sym}") }))));
      END
    ELSE_IF promise_type.bounded_stream?() THEN
      MUTABLE element_type = TRY (type__stream_element_type(promise_type));
      IF type__canonical_stream?(promise_type) THEN
        TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ NextExpr: COPY node }, TRY (type__stream_step_of(element_type))));
      ELSE
        TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ NextExpr: COPY node }, type__to_sym(element_type)));
      END
    ELSE_IF promise_type.shared_promise?() THEN
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ NextExpr: COPY node }, typeAnalysisSession__publish_scalar_next_plan(rtoc_self_view, &node, promise_type, TRUE).result_type));
    ELSE_IF (TRY (type__split_open_stream?(promise_type)) OR TRY (type__open_stream?(promise_type))) THEN
      elem_sym = type__to_sym((TRY (type__open_stream_element_type(promise_type))));
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ NextExpr: COPY node }, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("?${elem_sym}") }))));
    ELSE_IF promise_type.inf_stream?() THEN
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ NextExpr: COPY node }, type__to_sym((TRY (type__inf_stream_element_type(promise_type))))));
    ELSE
      IF expr IS_A Identifier AS identifier THEN
        TRY (typeAnalysisSession__og_set_moved(rtoc_self_view, identifier__name(identifier), identifier.token, :next));
      END
      TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ NextExpr: COPY node }, typeAnalysisSession__publish_scalar_next_plan(rtoc_self_view, &node, promise_type, FALSE).result_type));
    END
    RETURN NIL;
}
END
PRIVATE FN typeAnalysisSession__publish_scalar_next_plan(self: TypeAnalysisSession, MUTABLE node: NextExpr, promise_type: Type, shared_value: Bool) RETURNS !TenseOperationPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE plan = TRY (tenseOperationPlanner__next_value(promise_type, shared_value));
    node.tense_plan = plan;
    RETURN plan;
}
END
PRIVATE FN typeAnalysisSession__async_next_result_requires_heap?(self: TypeAnalysisSession, type_info: Type) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF type__id_handle?(type_info) THEN
      RETURN FALSE;
    END
    RETURN TRY (type__ownership_bearing?(type_info, %(name) USE(rtoc_self_view) -> typeAnalysisSession__lookup_type_schema(rtoc_self_view, name)));
}
END
PRIVATE FN typeAnalysisSession__owned_async_payload_type(self: TypeAnalysisSession, type_info: Type) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (TRY (type__string?(type_info)) AND type__rodata?(type_info)) THEN
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :String }, NIL, NIL, NIL, :heap));
    END
    RETURN COPY type_info;
}
END
PRIVATE FN typeAnalysisSession__resolve_catch_clauses_from_declarations_mut(MUTABLE self: TypeAnalysisSession, declarations: DeclarationIndex) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN declarations.function_declarations DO
    FOR _ IN _.catch_clauses DO
    MUTABLE rtoc_mutable_block_param_428 = COPY _;
    typeAnalysisSession__resolve_catch_clause_mut(&rtoc_self_view, &rtoc_mutable_block_param_428);
    END
    END
}
END
PRIVATE FN typeAnalysisSession__seed_error_type_registrations_mut(self: TypeAnalysisSession, declarations: DeclarationIndex) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    FOR _ IN declarations.error_type_registrations DO
    _, MUTABLE conflict = TRY (aST__register_type_mut(symbol(_.type_name), _.kind, CAST(COPY KEEP _.token AS ?Token)));
    IF conflict EXISTS AS conflict_value THEN
        typeAnalysisSession__emit_error_type_conflict_mut(rtoc_self_view, Site{ Token: COPY KEEP _.token }, _.type_name, conflict_value);
    END
    END
}
END
PRIVATE FN typeAnalysisSession__baked_in_default_sync_policy(self: TypeAnalysisSession) RETURNS ![]ErrorClause
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN CAST([ErrorClause{ selectors: [ErrorSelector{ form: :type, name: :LockTimeout, token: NIL }], retries: 3, action: COPY ErrorActionKind.Raise, token: NIL, value: NIL, message: NIL, body: List[], matched_types: List[], bubble_types: List[] }, ErrorClause{ selectors: [ErrorSelector{ form: :type, name: :MvccConflict, token: NIL }], retries: NIL, action: COPY ErrorActionKind.Raise, token: NIL, value: NIL, message: NIL, body: List[], matched_types: List[], bubble_types: List[] }, ErrorClause{ selectors: [ErrorSelector{ form: :type, name: :AtomicConflict, token: NIL }], retries: NIL, action: COPY ErrorActionKind.Raise, token: NIL, value: NIL, message: NIL, body: List[], matched_types: List[], bubble_types: List[] }] AS []ErrorClause);
}
END
PRIVATE FN typeAnalysisSession__validate_and_resolve_sync_policy_mut(self: TypeAnalysisSession, MUTABLE program_node: Program) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE decls = program_node.statements |> WHERE _ IS_A SyncPolicyDecl;
    IF (decls.size() > 1) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, decls[1], TypeAnalysisCodeOrMessage{ SymbolValue: :SYNC_POLICY_DUPLICATE });
    END
    IF decls.empty?() THEN
      program_node.sync_policy = typeAnalysisSession__baked_in_default_sync_policy(rtoc_self_view);
      RETURN;
    END
    MUTABLE decl: SyncPolicyDecl = COPY castLocatableToSyncPolicyDecl(UNWRAP (decls.first()));
    MUTABLE has_main = program_node.statements |> ANY (IF _ IS_A FunctionDef AS function_def THEN (function_def.name == name) ELSE FALSE END);
    IF !(has_main) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, decl, TypeAnalysisCodeOrMessage{ SymbolValue: :SYNC_POLICY_NEEDS_MAIN_FILE });
    END
    typeAnalysisSession__validate_sync_policy_body_mut(rtoc_self_view, decl);
    program_node.sync_policy = decl.handlers;
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ SyncPolicyDecl: COPY decl }, :Void));
}
END
PRIVATE FN typeAnalysisSession__validate_sync_policy_body_mut(self: TypeAnalysisSession, decl: SyncPolicyDecl) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE seen = List[];
    FOR _ IN ((decl.handlers OR List[])) DO
    MUTABLE rtoc_each_items_429 = _.selectors();
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_429.length() DO
        IF !((rtoc_each_items_429[rtoc_idx].form() == :type)) THEN
          rtoc_idx = rtoc_idx + 1;
      CONTINUE;
        END
        MUTABLE name = rtoc_each_items_429[rtoc_idx].name();
        IF sync_policy_inline_only_errors.contains?(name) THEN
            typeAnalysisSession__error_mut(rtoc_self_view, (rtoc_each_items_429[rtoc_idx].token() OR decl), TypeAnalysisCodeOrMessage{ SymbolValue: :SYNC_POLICY_INLINE_ONLY }, [], {:name: name, :escape: (IF (name == :Deadlock) THEN
              "DEADLOCK"
            ELSE
              "LOCK_CYCLE"
            END)});
        END
        IF !(sync_policy_required_errors.contains?(name)) THEN
            typeAnalysisSession__error_mut(rtoc_self_view, (rtoc_each_items_429[rtoc_idx].token() OR decl), TypeAnalysisCodeOrMessage{ SymbolValue: :SYNC_POLICY_INVALID_ERROR }, [], {:name: name, :required: sync_policy_required_errors.join(", ")});
        END
        &seen.append(name);
      rtoc_idx = rtoc_idx + 1;
    END
    MUTABLE rtoc_each_items_430 = _.selectors();
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_430.length() DO
        IF !((rtoc_each_items_430[rtoc_idx].form() == :kind)) THEN
          rtoc_idx = rtoc_idx + 1;
      CONTINUE;
        END
        typeAnalysisSession__error_mut(rtoc_self_view, (rtoc_each_items_430[rtoc_idx].token() OR decl), TypeAnalysisCodeOrMessage{ SymbolValue: :SYNC_POLICY_NEEDS_TYPE_NOT_KIND }, [], {:name: rtoc_each_items_430[rtoc_idx].name()});
      rtoc_idx = rtoc_idx + 1;
    END
    END
    MUTABLE seen_set = seen |> DISTINCT _;
    MUTABLE missing = sync_policy_required_errors |> WHERE !(seen_set.contains?(_));
    IF !(missing.empty?()) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, decl, TypeAnalysisCodeOrMessage{ SymbolValue: :SYNC_POLICY_INCOMPLETE }, [], {:required: sync_policy_required_errors.join(", "), :missing: missing.join(", ")});
    END
}
END
PRIVATE FN typeAnalysisSession__collapse_errors_for_call(self: TypeAnalysisSession, sig: FunctionSignature, args: []Locatable) RETURNS ![Set]String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE collapsed = Set[];
    MUTABLE param_indices = {
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE rtoc_indexed_items_431: []Param = TRY (functionSignature__params(sig));
    MUTABLE rtoc_indexed_output_433 = {};
    MUTABLE rtoc_indexed_i_432 = 0;
    WHILE rtoc_indexed_i_432 < rtoc_indexed_items_431.length() DO
      MUTABLE rtoc_indexed_pair_434 = [rtoc_indexed_items_431[rtoc_indexed_i_432].name, rtoc_indexed_i_432];
      rtoc_indexed_output_433[rtoc_indexed_pair_434._0] = rtoc_indexed_pair_434._1;
      rtoc_indexed_i_432 = rtoc_indexed_i_432 + 1;
    END
    rtoc_indexed_output_433
    };
    (TRY (functionSignature__requires(sig))).keys() |> EACH {
    MUTABLE ignored_families: [Set]String@symbol = ((TRY (functionSignature__requires(sig)))[_] OR_ELSE CAST(panic("missing hash key") AS [Set]String@symbol));
    MUTABLE idx = param_indices[_];
    IF !(idx) THEN
        CONTINUE;
    END
    MUTABLE arg: ?Locatable = COPY args[idx];
    IF !(arg) THEN
        CONTINUE;
    END
    MUTABLE families = TRY (withMatchCheck__family_of_arg_set(arg));
    IF (FALSE OR families.empty?()) THEN
        CONTINUE;
    END
    FOR _ IN families DO
      MUTABLE axes = (((CAST({:LOCKED: [:locked, :write_locked] |> DISTINCT _, :SNAPSHOTTED: [:versioned, :atomic] |> DISTINCT _, :VERSIONED: [:versioned] |> DISTINCT _, :ATOMIC: [:atomic] |> DISTINCT _, :LOCAL: [:local, :multiowned, :plain] |> DISTINCT _, :ACTOR: [:actor] |> DISTINCT _, :LOCK_FREE: [:lock_free] |> DISTINCT _} AS {String@symbol}[Set]String@symbol))[_]) OR_ELSE Set[]);
      FOR _ IN axes DO
      FOR _ IN ((((CAST({:locked: [:LockTimeout] |> DISTINCT _, :write_locked: [:LockTimeout] |> DISTINCT _, :versioned: [:MvccConflict] |> DISTINCT _, :atomic: [:AtomicConflict] |> DISTINCT _} AS {String@symbol}[Set]String@symbol))[_]) OR_ELSE Set[])) DO
      &collapsed.insert(COPY _);
      END
      END
    END
    };
    RETURN collapsed;
}
END
PRIVATE FN typeAnalysisSession__synthesize_clause_from_policy(self: TypeAnalysisSession, error_name: String@symbol) RETURNS ?ErrorClause
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE handlers = typeAnalysisSession__semantic_program(rtoc_self_view).sync_policy;
    IF !(handlers) THEN
      RETURN NIL;
    END
    RETURN handlers |> FIND _.selectors() |> ANY ((_.form() == :type) AND (_.name() == error_name));
}
END
PRIVATE FN typeAnalysisSession__visit_SyncPolicyDecl(MUTABLE self: TypeAnalysisSession, MUTABLE node: SyncPolicyDecl) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN ((node.handlers OR List[])) DO
    IF (_.action() IS_A Exit) THEN
      TRY (typeAnalysisSession__visit(&rtoc_self_view, _.message()));
    ELSE_IF (_.action() == ErrorActionKind.Block) THEN
      TRY (typeAnalysisSession__visit_stmts(&rtoc_self_view, _.body()));
    END
    END
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ SyncPolicyDecl: COPY node }, :Void));
}
END
PRIVATE FN typeAnalysisSession__resolve_catch_clause_mut(MUTABLE self: TypeAnalysisSession, MUTABLE clause: CatchClause) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE kinds = List[];
    MUTABLE types = List[];
    FOR _ IN clause.items DO
    IF (_.form == :kind) THEN
      MUTABLE kind_sym = symbol(_.name);
      IF !(aST__error_kind?(kind_sym)) THEN
        typeAnalysisSession__emit_registry_mismatch_mut(rtoc_self_view, CAST(COPY KEEP _.token AS Token), NameCandidate{ StringValue: COPY _.name }, ruby_constant_error_kinds() |> SELECT _.toString(), "Unknown error kind '${_.name}'. Expected one of: ${(ruby_constant_error_kinds() |> SELECT _.toString()).join(", ")}", "closest known kind");
      END
      IF aST__error_kind?(kind_sym) THEN
        &kinds.append(kind_sym);
      END
    ELSE
      MUTABLE type_sym = symbol(_.name);
      IF !(TRY (aST__error_type?(type_sym))) THEN
        typeAnalysisSession__emit_registry_mismatch_mut(rtoc_self_view, CAST(COPY KEEP _.token AS Token), NameCandidate{ StringValue: COPY _.name }, TRY (aST__error_type_names()), "CATCH ${_.name}: error type '${_.name}' is not registered. A type must be registered via RAISE/OR_ELSE EXIT before it can be CATCHed.", "closest registered type");
      END
      IF TRY (aST__error_type?(type_sym)) THEN
        &types.append(COPY _.name);
      END
    END
    END
    clause.kinds = CAST((kinds |> DISTINCT _) AS []Any);
    clause.types = CAST((types |> DISTINCT _) AS []Any);
    MUTABLE filter_types = List[];
    MUTABLE filter_messages = List[];
    FOR _ IN clause.filters DO
    IF (_.form == :type) THEN
      MUTABLE type_sym = symbol((CAST(_.value AS String)));
      IF !(TRY (aST__error_type?(type_sym))) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, KEEP _.token, TypeAnalysisCodeOrMessage{ SymbolValue: :CATCH_WITH_UNREGISTERED }, [], {:name: _.value});
      END
      &filter_types.append(COPY CAST(_.value AS String));
    ELSE_IF (_.form == :message) THEN
      MUTABLE message_expr: Locatable = COPY CAST(_.value AS Locatable);
      TRY (typeAnalysisSession__visit(&rtoc_self_view, message_expr));
      &filter_messages.append(message_expr);
    END
    END
    clause.filter_types = CAST((filter_types |> DISTINCT _) AS []Any);
    clause.filter_messages = filter_messages;
}
END
PRIVATE FN typeAnalysisSession__visit_Assert(MUTABLE self: TypeAnalysisSession, MUTABLE node: Assert) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.condition));
    IF (node.condition.resolved_type() != :Bool) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :ASSERT_NEEDS_BOOL });
    END
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ Assert: COPY node }, :Void));
}
END
PRIVATE FN typeAnalysisSession__visit_DieNode(MUTABLE self: TypeAnalysisSession, MUTABLE node: DieNode) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node.status THEN
      TRY (typeAnalysisSession__visit(&rtoc_self_view, node.status));
    END
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ DieNode: COPY node }, :NoReturn));
}
END
PRIVATE FN typeAnalysisSession__visit_Raise(MUTABLE self: TypeAnalysisSession, MUTABLE node: Raise) RETURNS !?Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node.message_expr THEN
      TRY (typeAnalysisSession__visit(&rtoc_self_view, node.message_expr));
    END
    typeAnalysisSession__resolve_error_registration_mut(rtoc_self_view, Node{ Raise: COPY node }, node.kind, node.error_name, node.token);
    IF typeAnalysisSession__current_fn_ctx(rtoc_self_view) != NIL THEN
        MUTABLE rtoc_mutable_receiver_435 = (typeAnalysisSession__current_fn_ctx(rtoc_self_view));
        functionContext__mark_runtime_used_mut(&rtoc_mutable_receiver_435);
    END
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node, :NoReturn));
    MUTABLE rtoc_writer_receiver_436: TraversalState = typeAnalysisSession__phase_traversal_state(rtoc_self_view);
    rtoc_writer_receiver_436.branch_terminated = TRUE;
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__resolve_error_registration_mut(self: TypeAnalysisSession, MUTABLE node: Node, kind_sym: ?String@symbol, type_name_str: ?String, site_tok: Token) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF type_name_str EXISTS AS type_name_str_value THEN
      MUTABLE type_sym = symbol(type_name_str_value);
      IF kind_sym EXISTS AS kind_sym_value THEN
        _, MUTABLE conflict = TRY (aST__register_type_mut(type_sym, kind_sym_value, site_tok));
        IF conflict EXISTS AS conflict_value THEN
          typeAnalysisSession__emit_error_type_conflict_mut(rtoc_self_view, Site{ Token: COPY site_tok }, type_name_str_value, conflict_value);
        END
        NIL;
      ELSE
        IF !(TRY (aST__error_type?(type_sym))) THEN
          typeAnalysisSession__error_mut(rtoc_self_view, site_tok, TypeAnalysisCodeOrMessage{ SymbolValue: :ERROR_TYPE_NOT_REGISTERED }, [], {:name: type_name_str_value});
          RETURN;
        END
        node.kind = TRY (aST__kind_of_type(type_sym));
        RETURN;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__emit_error_type_conflict_mut(self: TypeAnalysisSession, site: Site, type_name: String, conflict: {String@symbol}?ErrorTypeConflictValue) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE first_site: ?Token = COPY CAST(conflict[:first_site] AS ?Token);
    MUTABLE first_loc: String = "";
    IF first_site EXISTS AS first_site_value THEN
      first_loc = " (first registered at line ${first_site_value.line.toString()})";
    ELSE
      first_loc = "";
    END
    IF ruby_union_scalar_equal_optional_ErrorTypeConflictValue_Bool(conflict[:is_stdlib], TRUE) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, site, TypeAnalysisCodeOrMessage{ SymbolValue: :ERROR_TYPE_RESERVED_BY_STDLIB }, [], {:name: type_name, :kind: CAST(conflict[:existing_kind] AS String@symbol)});
    ELSE
      typeAnalysisSession__error_mut(rtoc_self_view, site, TypeAnalysisCodeOrMessage{ SymbolValue: :ERROR_TYPE_KIND_CONFLICT }, [], {:name: type_name, :kind: CAST(conflict[:existing_kind] AS String@symbol), :first_loc: first_loc});
    END
}
END
PRIVATE FN typeAnalysisSession__visit_ReturnNode(MUTABLE self: TypeAnalysisSession, MUTABLE node: ReturnNode) RETURNS !?Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_ctx = typeAnalysisSession__current_fn_ctx_mut(rtoc_self_view);
    MUTABLE expected = COPY fn_ctx.return_type;
    MUTABLE raw_value = node.value;
    MUTABLE value = raw_value;
    MUTABLE return_payload = (TRY (type__plain_return_payload_type(expected)) OR_ELSE expected);
    IF (value IS_A BgBlock AND TRY (type__single_future?(return_payload))) THEN
      value.declared_async_payload = TRY (type__new(castTypeToTypeConstructionInput(TRY (type__tense_type(return_payload)))));
    END
    IF (value IS_A ListLit AND ((type__collection?(return_payload) OR type__tuple?(return_payload)))) THEN
      value.coerced_type = return_payload;
    ELSE_IF (value IS_A HashLit AND type__map?(return_payload)) THEN
      value.coerced_type = return_payload;
    END
    TRY (typeAnalysisSession__visit(&rtoc_self_view, value));
    MUTABLE inline_bg_sources = CAST((typeAnalysisSession__collect_bg_sources_in_expr(rtoc_self_view, value) |> DISTINCT _) AS []SymbolEntry@multiowned);
    IF type__any?(inline_bg_sources) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :RETURN_BORROWED_NO_COPY_OR_LIFETIME }, [], {:type: CAST((&value.full_type_mut("inline BG return")) AS String)});
    END
    IF typeAnalysisSession__inside_with_block?(rtoc_self_view) THEN
      IF (value IS_A Identifier AND ((value.symbol() != NIL) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_437 = ((value.symbol())?);
      symbolEntry__non_escaping(rtoc_local_receiver_437) })) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :RETURN_FROM_WITH_SCOPED }, [], {:name: value.name()});
      ELSE_IF ((value IS_A GetField AND respondsTo?(value.target(), "symbol")) AND ((value.target().symbol() != NIL) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_438 = ((value.target().symbol())?);
      symbolEntry__non_escaping(rtoc_local_receiver_438) })) THEN
        MUTABLE returned_type = &value.full_type_mut("WITH-scoped field return");
        IF !(TRY (type__implicitly_copyable?(returned_type, %(type) USE(rtoc_self_view) -> typeAnalysisSession__lookup_type_schema(rtoc_self_view, type)))) THEN
          typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :RETURN_FIELD_FROM_WITH_SCOPED });
        END
      ELSE_IF ((value IS_A GetIndex AND respondsTo?(value.target(), "symbol")) AND ((value.target().symbol() != NIL) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_439 = ((value.target().symbol())?);
      symbolEntry__non_escaping(rtoc_local_receiver_439) })) THEN
        returned_type = &value.full_type_mut("WITH-scoped indexed return");
        IF !(TRY (type__implicitly_copyable?(returned_type, %(type) USE(rtoc_self_view) -> typeAnalysisSession__lookup_type_schema(rtoc_self_view, type)))) THEN
          typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :RETURN_INDEX_FROM_WITH_SCOPED });
        END
      END
    END
    IF value IS_A IfStatement THEN
      typeAnalysisSession__promote_to_expr_if_mut(rtoc_self_view, Locatable{ ReturnNode: COPY node }, &value);
    END
    IF value IS_A MatchStatement THEN
      typeAnalysisSession__promote_to_expr_match_mut(rtoc_self_view, Locatable{ ReturnNode: COPY node }, &value);
    END
    typeAnalysisSession__verify_return(rtoc_self_view, value);
    typeAnalysisSession__verify_tied_return_mut(rtoc_self_view, node);
    MUTABLE actual = value.resolved_type();
    MUTABLE actual_full = typeAnalysisSession__return_value_type(rtoc_self_view, &value);
    IF value IS_A Identifier THEN
      MUTABLE vti = &value.full_type_mut("return identifier");
      IF (vti AND !(TRY (type__implicitly_copyable?(vti, %(t) USE(rtoc_self_view) -> typeAnalysisSession__lookup_type_schema(rtoc_self_view, t))))) THEN
        value.was_moved = TRUE;
      END
      MUTABLE vt_branch_value: ?Type = NIL;
      IF vti IS_A Type THEN
        vt_branch_value = vti;
      ELSE
        vt_branch_value = ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_440: ?Type = NIL;
        IF vti THEN
          rtoc_ternary_value_440 = TRY (type__new(vti));
        ELSE
          rtoc_ternary_value_440 = NIL;
        END
        rtoc_ternary_value_440? });
      END
      MUTABLE vt: ?Type = vt_branch_value;
      IF (IF vt != NIL THEN
        type__future?(vt)
      ELSE
        NIL
      END) THEN
        TRY (typeAnalysisSession__og_set_moved(rtoc_self_view, value.name(), value.token(), :return));
      END
    END
    IF !(value IS_A Identifier) THEN
      IF ((type__heap_return_storage?(expected) AND respondsTo?(value, "storage=")) AND TRY (type__requires_move?((&value.full_type_mut("return expression storage"))))) THEN
        value.storage = :heap;
      END
    END
    MUTABLE actual_is_auto = type__auto?(actual_full);
    MUTABLE expected_is_auto = type__auto?(expected);
    MUTABLE return_checkable = (((!(actual_is_auto) AND !(expected_is_auto)) AND !(ruby_union_scalar_equal_Type_String_symbol(expected, :Void))) AND !(ruby_union_scalar_equal_Type_String_symbol(expected, :Any)));
    IF (return_checkable AND !(typeAnalysisSession__return_type_compatible?(rtoc_self_view, CAST(actual_full AS Type), expected))) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :RETURN_MISMATCH }, [], {:expected: typeAnalysisSession__type_display(rtoc_self_view, expected), :got: typeAnalysisSession__type_display(rtoc_self_view, CAST(actual_full AS Type))});
    ELSE_IF (return_checkable AND (actual != expected)) THEN
      MUTABLE value_is_fallible = (!((typeAnalysisSession__recoverable_result_type(rtoc_self_view, &value, "return value") == NIL)) OR type__error_union?(actual_full));
      MUTABLE coerce_target =     IF (!(value_is_fallible) AND (TRY (type__plain_return_payload_type(expected)) != NIL)) THEN
        TRY (type__plain_return_payload_type(expected))
      ELSE
        expected
      END;
      value.coerced_type = coerce_target;
      typeAnalysisSession__check_prefixed_int_range_mut(rtoc_self_view, value, coerce_target);
    END
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ ReturnNode: COPY node }, actual));
    MUTABLE return_fact_type: Type = (value.coerced_type_info() OR actual_full);
    &fn_ctx.returns.append(COPY ReturnFact{ storage: COPY CAST(value.storage() AS ?String@symbol), type: COPY symbol((TRY (type__coercion_surface_name(castTypeToTypeTypeInput(return_fact_type))))), metatype: COPY CAST(value.metatype() AS ?String@symbol) });
    MUTABLE rtoc_writer_receiver_441: TraversalState = typeAnalysisSession__phase_traversal_state(rtoc_self_view);
    rtoc_writer_receiver_441.branch_terminated = TRUE;
    RETURN TRUE;
}
END
PRIVATE FN typeAnalysisSession__return_value_type(self: TypeAnalysisSession, MUTABLE value: Locatable) RETURNS Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN &value.full_type_mut("return value");
}
END
PRIVATE FN typeAnalysisSession__return_type_compatible?(self: TypeAnalysisSession, actual_type: Type, expected_type: Type) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (type__any?(expected_type) OR type__any?(actual_type)) THEN
      RETURN TRUE;
    END
    IF (type__resolved(actual_type) == :NoReturn) THEN
      RETURN TRUE;
    END
    IF type__fn_type?(expected_type) THEN
      RETURN TRY (type__accepts?(expected_type, actual_type));
    END
    IF (type__optional?(expected_type) AND (type__resolved(actual_type) == symbol("NIL"))) THEN
      RETURN TRUE;
    END
    IF typeAnalysisSession__union_payload_variant(rtoc_self_view, expected_type, actual_type) THEN
      RETURN TRUE;
    END
    IF !(typeAnalysisSession__same_return_capabilities?(rtoc_self_view, expected_type, actual_type)) THEN
      RETURN FALSE;
    END
    RETURN typeAnalysisSession__is_safe_autocast?(rtoc_self_view, castTypeToOptionalSourceType(actual_type), castTypeToTypeTypeInput(expected_type));
}
END
PRIVATE FN typeAnalysisSession__union_payload_variant(self: TypeAnalysisSession, expected_type: Type, actual_type: Type) RETURNS !?TypeAnalysisSessionReturnValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE target_type = TRY (type__value_payload_type(expected_type));
    MUTABLE schema = typeAnalysisSession__lookup_type_schema(rtoc_self_view, type__resolved(target_type));
    RETURN castOptionalUnionPayloadCompatibilityReturnValueToOptionalTypeAnalysisSessionReturnValue(TRY (unionPayloadCompatibility__unique_variant(expected_type, actual_type, schema)));
}
END
PRIVATE FN typeAnalysisSession__same_return_capabilities?(self: TypeAnalysisSession, expected_t: Type, actual_t: Type) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE name = COPY CAST(type__resolved(expected_t) AS String);
    IF (((((compilerRegexMatch(name, compilerRegexCompile("\\A[A-Z]\\z")) AND !(typeAnalysisSession__lookup_type_schema(rtoc_self_view, symbol(name)))) AND type__polymorphic_shared?(expected_t)) AND type__shared?(actual_t)) AND (type__sync(expected_t) == NIL)) AND (type__resolved(expected_t) == type__resolved(actual_t))) THEN
      RETURN TRUE;
    END
    MUTABLE layout_ok = ((type__layout(expected_t) == type__layout(actual_t)) OR type__indirect?(expected_t));
    MUTABLE elem_own = %(t) -> {
    IF (type__elem_ownership(t) == :affine) THEN
      RETURN NIL;
    ELSE
      RETURN type__elem_ownership(t);
    END
    NIL
    };
    RETURN (((((((type__ownership(expected_t) == type__ownership(actual_t)) AND (type__sync(expected_t) == type__sync(actual_t))) AND layout_ok) AND (runtimeCallSpec__call(elem_own, expected_t) == runtimeCallSpec__call(elem_own, actual_t))) AND (type__elem_sync(expected_t) == type__elem_sync(actual_t)))) == TRUE);
}
END
PRIVATE FN typeAnalysisSession__type_display(self: TypeAnalysisSession, type: Type) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE parts = [TRY (type__surface_name_type(type))];
    MUTABLE ownership: ?String = type__ownership_surface_name(type);
    MUTABLE sync: ?String = type__sync_surface_name(type);
    IF ownership EXISTS AS ownership_value THEN
      &parts.append(ownership_value);
    END
    IF sync EXISTS AS sync_value THEN
      &parts.append(sync_value);
    END
    RETURN parts.join(" ");
}
END
PRIVATE FN typeAnalysisSession__visit_OrElse(MUTABLE self: TypeAnalysisSession, MUTABLE node: BinaryOp) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rhs_propagates = (((node.right IS_A OrElseRaise OR node.right IS_A OrElseExit) OR node.right IS_A ThrowNode) OR node.right IS_A ReturnNode);
    typeAnalysisSession__with_body_fact_failure_absorbed(rtoc_self_view, !(rhs_propagates), %() USE(node, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_442 = TRY (typeAnalysisSession__visit(&rtoc_self_view, node.left));
    rtoc_lambda_result_442
    });
    TRY (typeAnalysisSession__visit(&rtoc_self_view, node.right));
    MUTABLE t_right_type = &node.right.full_type_mut("OR_ELSE right");
    MUTABLE bare_nil = (node.left IS_A Literal AND ruby_union_scalar_equal_Type_String_symbol(node.left.type(), symbol("NIL")));
    MUTABLE t_left_type =   IF (bare_nil AND (t_right_type.resolved() != :NoReturn)) THEN
      {
    MUTABLE rtoc_value_block_marker = 0;
    contextual = TRY (type__optional_of(t_right_type));
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node.left, contextual));
    contextual
    }
    ELSE
      typeAnalysisSession__recoverable_result_type(rtoc_self_view, &node.left, "OR_ELSE left")
    END;
    IF !(t_left_type) THEN
      MUTABLE left_value_type = TRY (type__new(&node.left.full_type_mut("OR_ELSE left")));
      IF typeAnalysisSession__fault_recoverable_result?(rtoc_self_view, &node.left) THEN
        t_left_type = TRY (type__error_union_of(castTypeToTypeTypeInput(left_value_type)));
        IF ((node.left IS_A BinaryOp AND node.left.smooth?()) AND respondsTo?(node.left, "error_union_type=")) THEN
          node.left.error_union_type = t_left_type;
        END
      ELSE_IF type__optional?(left_value_type) THEN
        t_left_type = COPY left_value_type;
      ELSE_IF (node.left IS_A FuncCall AND (TRY (typeAnalysisSession__function_node_map(rtoc_self_view))).contains?(node.left.name())) THEN
        typeAnalysisSession__record_deferred_recovery_validation_mut(rtoc_self_view, node, castLocatableToFuncCall(node.left), node.left.name(), left_value_type);
        t_left_type = TRY (type__error_union_of(castTypeToTypeTypeInput(left_value_type)));
      ELSE
        t_left_type = left_value_type;
      END
    END
    IF !((type__error_union?(t_left_type) OR type__optional?(t_left_type))) THEN
      typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :OR_ELSE_NEEDS_RECOVERABLE_LEFT }, [], {:got: typeAnalysisSession__type_display(rtoc_self_view, CAST(t_left_type AS Type))});
    END
    IF node.right IS_A OrElseBreak THEN
      IF (typeAnalysisSession__current_loop_depth(rtoc_self_view) <= 0) THEN
        typeAnalysisSession__error_mut(rtoc_self_view, node, TypeAnalysisCodeOrMessage{ SymbolValue: :OR_BREAK_OUTSIDE_WHILE });
      END
    END
    MUTABLE operation, recovery = typeAnalysisSession__or_else_operation(rtoc_self_view, node.right);
    MUTABLE plan = typeAnalysisSession__plan_or_else_with_diagnostic(rtoc_self_view, node, CAST(t_left_type AS Type), t_right_type, operation, recovery);
    MUTABLE plan_value: TenseOperationPlan = plan?;
    node.tense_plan = plan_value;
    IF (recovery == TenseRecovery.Fallback) THEN
      typeAnalysisSession__coerce_empty_collection_fallback_mut(rtoc_self_view, node.right, plan_value.result_type);
    END
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, Locatable{ BinaryOp: COPY node }, plan_value.result_type));
}
END
PRIVATE FN typeAnalysisSession__plan_or_else_with_diagnostic(self: TypeAnalysisSession, node: BinaryOp, left_type: Type, right_type: Type, operation: TenseOperationKind, recovery: TenseRecovery) RETURNS !TenseOperationPlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (tenseOperationPlanner__or_else(left_type, right_type, operation, recovery));
}
CATCH ArgumentError
  MUTABLE expected = TRY (type__value_payload_type(left_type));
  typeAnalysisSession__error_mut(self, node, TypeAnalysisCodeOrMessage{ SymbolValue: :TYPE_MISMATCH_IN_OR }, [], {:expected: type__resolved(expected), :got: type__resolved(right_type)});
  RETURN TRY (tenseOperationPlanner__or_else(left_type, expected, operation, recovery));
END
PRIVATE FN typeAnalysisSession__or_else_operation(self: TypeAnalysisSession, node: Locatable) RETURNS Tuple<TenseOperationKind, TenseRecovery>
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (node IS_A OrElseRaise) THEN
      RETURN CAST(Tuple{TenseOperationKind.OrElseRaise, TenseRecovery.Raise} AS Tuple<TenseOperationKind, TenseRecovery>);
    ELSE_IF (node IS_A OrElseExit) THEN
      RETURN CAST(Tuple{TenseOperationKind.OrElseExit, TenseRecovery.Exit} AS Tuple<TenseOperationKind, TenseRecovery>);
    ELSE_IF (node IS_A OrElsePass) THEN
      RETURN CAST(Tuple{TenseOperationKind.OrElsePass, TenseRecovery.Pass} AS Tuple<TenseOperationKind, TenseRecovery>);
    ELSE_IF (node IS_A OrElseBreak) THEN
      RETURN CAST(Tuple{TenseOperationKind.OrElseBreak, TenseRecovery.Break} AS Tuple<TenseOperationKind, TenseRecovery>);
    ELSE_IF (node IS_A OrElsePrune) THEN
      RETURN CAST(Tuple{TenseOperationKind.OrElsePrune, TenseRecovery.Prune} AS Tuple<TenseOperationKind, TenseRecovery>);
    ELSE
      RETURN CAST(Tuple{TenseOperationKind.OrElseValue, TenseRecovery.Fallback} AS Tuple<TenseOperationKind, TenseRecovery>);
    END
}
END
PRIVATE FN typeAnalysisSession__coerce_empty_collection_fallback_mut(self: TypeAnalysisSession, MUTABLE rhs: Locatable, expected: ?Type) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((expected != NIL)) THEN
      RETURN;
    END
    MUTABLE empty_list = (IF rhs IS_A ListLit AS list_lit THEN (list_lit.items.empty?() AND (list_lit.constructor_options == NIL)) ELSE FALSE END);
    MUTABLE empty_hash = (IF rhs IS_A HashLit AS hash_lit THEN hash_lit.pairs.empty?() ELSE FALSE END);
    IF !((empty_list OR empty_hash)) THEN
      RETURN;
    END
    TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &rhs, expected));
}
END
PRIVATE FN typeAnalysisSession__visit_OrElseRaise(self: TypeAnalysisSession, MUTABLE node: OrElseRaise) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node, :Void));
}
END
PRIVATE FN typeAnalysisSession__visit_OrElseBreak(self: TypeAnalysisSession, MUTABLE node: OrElseBreak) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (typeAnalysisSession__stamp_type_mut(rtoc_self_view, &node, :Void));
}
END
