PRIVATE FN typeAnalysisSession__fix_description_from_hash(self: TypeAnalysisSession, code: String@symbol, kwargs: {String@symbol}?DiagnosticKwValue) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (diagnosticRegistry__fix_description_from_hash(code, diagnosticKwargs__rendered(kwargs)));
}
END
PRIVATE FN typeAnalysisSession__note_mut(MUTABLE self: TypeAnalysisSession, node_or_token: Locatable, message: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE token: ?Token@multiowned = typeAnalysisSession__source_error_token(rtoc_self_view, typeAnalysisSession__diagnostic_token(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY node_or_token }));
    MUTABLE loc: String = "";
    IF token EXISTS AS token_value THEN
      loc = " (line ${token_value.line.toString()})";
    ELSE
      loc = "";
    END
    typeAnalysisSession__diagnostic_output(&rtoc_self_view, "\x1B[36m[Note]\x1B[0m ${message}${loc}");
    NIL;
}
END
PRIVATE FN typeAnalysisSession__warning_mut(MUTABLE self: TypeAnalysisSession, node_or_token: Locatable, message: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE token: ?Token@multiowned = typeAnalysisSession__source_error_token(rtoc_self_view, typeAnalysisSession__diagnostic_token(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY node_or_token }));
    MUTABLE loc: String = "";
    IF token EXISTS AS token_value THEN
      loc = " (line ${token_value.line.toString()})";
    ELSE
      loc = "";
    END
    typeAnalysisSession__diagnostic_output(&rtoc_self_view, "\x1B[33m[Warning]\x1B[0m ${message}${loc}");
    NIL;
}
END
PRIVATE FN typeAnalysisSession__fixable_mut(MUTABLE self: TypeAnalysisSession, node_or_token: ?DiagnosticAnchor, category: String@symbol, fixes: []Fix, message: ?String = NIL, code: ?String@symbol = NIL, level: String@symbol = :warning, raise_in_collector: Bool = FALSE, kwargs: {String@symbol}Any = {}) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rendered_message = (message OR_ELSE TRY (typeAnalysisSession__diagnostic_message(rtoc_self_view, code?, [], kwargs)));
    MUTABLE token: ?Any@multiowned = typeAnalysisSession__diagnostic_token(&rtoc_self_view, node_or_token);
    MUTABLE source_token: ?Token@multiowned = typeAnalysisSession__source_error_token(rtoc_self_view, token);
    MUTABLE finding = TRY (fixableFinding__new(level, rendered_message, token, category, fixes));
    IF fixCollector__enabled?() THEN
      TRY (fixCollector__push(finding, (level == :error)));
      IF !(raise_in_collector) THEN
        RETURN;
      END
      TRY (typeAnalysisSession__raise_source_error_mut(&rtoc_self_view, CAST(source_token AS ?Token), rendered_message));
    END
    IF (level == :hint) OR (level == :info) OR (level == :warning) THEN
      MUTABLE loc: String = "";
      IF source_token EXISTS AS source_token_value THEN
        loc = " (line ${source_token_value.line.toString()})";
      ELSE
        loc = "";
      END
      MUTABLE tag: String = "";
      IF (level == :warning) THEN
        tag = "\x1B[33m[Warning]\x1B[0m";
      ELSE
        tag = "\x1B[36m[${(CAST(level AS String)).capitalize()}]\x1B[0m";
      END
      typeAnalysisSession__diagnostic_output(&rtoc_self_view, "${tag} ${rendered_message}${loc}");
      RETURN;
    ELSE_IF (level == :error) THEN
      RETURN TRY (typeAnalysisSession__raise_source_error_mut(&rtoc_self_view, CAST(source_token AS ?Token), rendered_message));
    ELSE
      RETURN;
    END
}
END
PRIVATE FN typeAnalysisSession__diagnostic_source_code(MUTABLE self: TypeAnalysisSession) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN typeAnalysisSession__source_code(&rtoc_self_view);
}
END
PRIVATE FN typeAnalysisSession__parser_error_host?(self: TypeAnalysisSession) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN FALSE;
}
END
PRIVATE FN typeAnalysisSession__raise_source_error_mut(MUTABLE self: TypeAnalysisSession, token: ?Token, message: String, code: ?String@symbol = NIL) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF typeAnalysisSession__parser_error_host?(rtoc_self_view) THEN
      RAISE Input, ParserError, message;
    END
    RAISE Input, CompilerError, message;
}
END
