PRIVATE FN typeAnalysisSession__visit_OrElsePass(MUTABLE self: TypeAnalysisSession, MUTABLE node: OrElsePass) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, Locatable{ OrElsePass: COPY node }, :Void));
