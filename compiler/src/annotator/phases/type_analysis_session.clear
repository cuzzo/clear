    MUTABLE t: TypeTypeInput = (inline_payload.fields[rtoc_key] OR_ELSE CAST(panic("missing hash key") AS TypeTypeInput));
      StructField{ type: COPY UNWRAP (castTypeTypeInputToType(t)), default: NIL, borrowed: FALSE }
      }; END rtoc_transform_values_result_337 } )), ( { MUTABLE rtoc_empty_list_338: []String@symbol = List[]; rtoc_empty_list_338 } ), ( { MUTABLE rtoc_empty_list_339: []GenericParamDecl = List[]; rtoc_empty_list_339 } ), {}, {})) };
