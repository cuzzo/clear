PRIVATE FN typeAnalysisSession__record_local_binding_fact_mut(MUTABLE self: TypeAnalysisSession, MUTABLE frame: BodyFactFrame, MUTABLE node: BindingNode, name: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE summary = COPY frame.summary;
    frame.next_local_ordinal=((frame.next_local_ordinal + 1));
    frame.next_place_ordinal=((frame.next_place_ordinal + 1));
    MUTABLE body_id_base = (summary.body_id.value * semanticBodyIdStride());
    MUTABLE place_id = (body_id_base + frame.next_place_ordinal);
    &summary.local_facts.append(COPY LocalFact{ id: COPY LocalId{ value: (body_id_base + frame.next_local_ordinal) }, place_id: COPY SemanticPlaceId{ value: place_id }, name: COPY name });
    MUTABLE symbol: ?SymbolEntry@multiowned = aST__node__symbol(castBindingNodeToLocatable(node));
    IF symbol != NIL THEN
      symbolEntry__adopt_semantic_place_id_mut(&symbol, place_id);
    END
}
END
PRIVATE FN typeAnalysisSession__record_body_fact_node_mut(MUTABLE self: TypeAnalysisSession, MUTABLE node: Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE frames = TRY (typeAnalysisSession__body_fact_frames(&rtoc_self_view));
    IF (frames.length() == 0) THEN
      RETURN;
    END
    MUTABLE suspend_kind: ?String@symbol = NIL;
    IF (node IS_A FuncCall OR node IS_A MethodCall) THEN
      IF TRY (typeAnalysisSession__func_call_suspends?(&rtoc_self_view, castLocatableToCallLikeNode(node))) THEN
        suspend_kind = IF (IF locatable__matched_stdlib_def(node) != NIL THEN
          { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_280: ?FunctionSignature@multiowned = (locatable__matched_stdlib_def(node));
        TRY (functionSignature__intrinsic_suspends?(UNWRAP (rtoc_mutable_receiver_280))) }
        ELSE
          NIL
        END) THEN
          :io
        ELSE
          :call
        END;
      END
    END
    MUTABLE with_block_raises = (IF node IS_A WithBlock AS MUTABLE with_block THEN typeAnalysisSession__with_block_raises_directly?(&rtoc_self_view, &with_block) ELSE FALSE END);
    FOR MUTABLE _ IN frames DO
    MUTABLE summary = COPY _.summary;
    IF (TRUE AND !(node IS_A FunctionDef)) THEN
        &summary.escape_nodes.append(COPY node);
        IF _.track_with_scope_stack THEN
          FOR MUTABLE _ IN _.with_scope_stack DO
          MUTABLE with_scope_key = aST__node_identity( Locatable{ WithBlock: COPY _ });
          MUTABLE with_scope_entry = COPY (summary.with_scope_nodes[with_scope_key] OR_ELSE List[]);
          &with_scope_entry.append(COPY node);
          summary.with_scope_nodes[with_scope_key] = COPY with_scope_entry;
          END
        END
    END
    IF node IS_A Identifier AS identifier THEN
        MUTABLE lambda_node: ?LambdaLit = COPY _.lambda_body_stack.last();
        IF lambda_node EXISTS AS lambda_node_value THEN
          MUTABLE lambda_refs_key = aST__node_identity(Locatable{ LambdaLit: COPY lambda_node_value });
          MUTABLE lambda_refs_entry = COPY (summary.lambda_body_identifier_refs[lambda_refs_key] OR_ELSE List[]);
          &lambda_refs_entry.append(COPY identifier);
          summary.lambda_body_identifier_refs[lambda_refs_key] = COPY lambda_refs_entry;
        END
    END
    IF suspend_kind EXISTS AS suspend_kind_value THEN
      &summary.suspend_points.append(COPY SuspendPointFact{ id: COPY SuspendPointId{ value: summary.suspend_points.length() }, kind: symbol(UNWRAP (COPY suspend_kind)), node: COPY node });
    END
    IF node IS_A ReturnNode AS return_node THEN
        &summary.return_nodes.append(COPY return_node);
    ELSE_IF node IS_A VarDecl AS var_decl THEN
        &summary.binding_nodes.append(BindingNode{ VarDecl: COPY var_decl });
        MUTABLE rtoc_frame_slot = COPY _;
        typeAnalysisSession__record_local_binding_fact_mut(&rtoc_self_view, &rtoc_frame_slot, BindingNode{ VarDecl: COPY var_decl }, CAST(var_decl.name AS String));
    ELSE_IF node IS_A BindExpr AS bind_expr THEN
        IF (bind_expr.mode == :assign) THEN
          &summary.assignment_nodes.append(AssignmentNode{ BindExpr: COPY bind_expr });
        ELSE
          &summary.binding_nodes.append(BindingNode{ BindExpr: COPY bind_expr });
          MUTABLE rtoc_frame_slot2 = COPY _;
          typeAnalysisSession__record_local_binding_fact_mut(&rtoc_self_view, &rtoc_frame_slot2, BindingNode{ BindExpr: COPY bind_expr }, CAST(bind_expr.name AS String));
        END
    ELSE_IF node IS_A Assignment AS assignment THEN
        &summary.assignment_nodes.append(AssignmentNode{ Assignment: COPY assignment });
    ELSE_IF node IS_A DestructuringAssignment AS destructuring_assignment THEN
        &summary.assignment_nodes.append(AssignmentNode{ DestructuringAssignment: COPY destructuring_assignment });
        MUTABLE rtoc_each_items_282 = destructuringAssignment__targets(destructuring_assignment);
        MUTABLE rtoc_idx = 0;
        WHILE rtoc_idx < rtoc_each_items_282.length() DO
        IF ((UNWRAP (rtoc_each_items_282[rtoc_idx])).name == "_") THEN
          rtoc_idx = rtoc_idx + 1;
      CONTINUE;
        END
        &summary.binding_nodes.append(BindingNode{ DestructureTarget: COPY rtoc_each_items_282[rtoc_idx]? });
        typeAnalysisSession__record_local_binding_fact_mut(&rtoc_self_view, &_, BindingNode{ DestructureTarget: COPY rtoc_each_items_282[rtoc_idx]? }, CAST(((UNWRAP (rtoc_each_items_282[rtoc_idx])).name) AS String));
      rtoc_idx = rtoc_idx + 1;
        END
    ELSE_IF node IS_A Identifier AS identifier THEN
        IF (identifier__name(identifier) == "snapshot") THEN
          summary.references_snapshot = TRUE;
        END
    ELSE_IF (node IS_A Raise) OR (node IS_A OrElseRaise) OR (node IS_A BgBlock) OR (node IS_A BgStreamBlock) THEN
        summary.raises_directly = TRUE;
    ELSE_IF (node IS_A UnaryOp) THEN
        IF (locatable__symbol_op(node) == :TRY) THEN
          summary.raises_directly = TRUE;
        END
    ELSE_IF node IS_A WithBlock AS with_block THEN
        IF with_block_raises THEN
          summary.raises_directly = TRUE;
        END
    ELSE_IF node IS_A NextExpr AS next_expr THEN
        &summary.suspend_points.append(COPY SuspendPointFact{ id: COPY SuspendPointId{ value: summary.suspend_points.length() }, kind: :next, node: Locatable{ NextExpr: COPY next_expr } });
    ELSE_IF node IS_A YieldExpr AS yield_expr THEN
        &summary.suspend_points.append(COPY SuspendPointFact{ id: COPY SuspendPointId{ value: summary.suspend_points.length() }, kind: :yield, node: Locatable{ YieldExpr: COPY yield_expr } });
    ELSE_IF (node IS_A FuncCall) OR (node IS_A MethodCall) THEN
        IF _.record_call_sites THEN
          _.next_call_site_ordinal=((_.next_call_site_ordinal + 1));
          &summary.call_site_facts.append(COPY CallSiteFact{ id: COPY CallSiteId{ value: ((summary.body_id.value * semanticBodyIdStride()) + _.next_call_site_ordinal) }, node: COPY node, callee_name: COPY UNWRAP (locatable__name(node)), args: COPY (locatable__args(node) OR_ELSE List[]), fn_var_call: (IF node IS_A FuncCall AS func_call THEN (func_call.fn_var_call == TRUE) ELSE FALSE END), propagates_failure: !(_.failure_absorbed) });
        END
        IF (IF node IS_A FuncCall AS func_call THEN func_call.fn_var_call ELSE FALSE END) THEN
          summary.has_fnptr_call = TRUE;
          IF (!(_.failure_absorbed) AND TRY (typeAnalysisSession__fn_var_call_error_fallible?(&rtoc_self_view, castLocatableToFuncCall__type_analysis_session(node)))) THEN
            summary.raises_directly = TRUE;
          END
        ELSE_IF node IS_A FuncCall AS func_call THEN
          &summary.callees.insert(callName__string_value(funcCall__name(func_call)));
          IF !(_.failure_absorbed) THEN
            &summary.propagating_callees.insert(callName__string_value(funcCall__name(func_call)));
          END
          IF (!(_.failure_absorbed) AND TRY (typeAnalysisSession__resolved_call_error_fallible?(&rtoc_self_view, Node{ FuncCall: COPY func_call }))) THEN
            summary.raises_directly = TRUE;
          END
        ELSE_IF (!(_.failure_absorbed) AND TRY (typeAnalysisSession__resolved_call_error_fallible?(&rtoc_self_view, castLocatableToNode__type_analysis_session(node)))) THEN
          summary.raises_directly = TRUE;
        END
    END
    END
}
END
PRIVATE FN typeAnalysisSession__fn_var_call_error_fallible?(MUTABLE self: TypeAnalysisSession, MUTABLE node: FuncCall) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE sig: ?FunctionSignature@multiowned = functionSignature__unwrap(ruby_wrap_optional_FunctionSignature_multiowned_X__type_analysis_session(KEEP node__matched_signature(Node{ FuncCall: COPY node })));
    IF ((sig != NIL) AND type__error_union?(functionSignature__return_type(sig))) THEN
      RETURN TRUE;
    END
    RETURN type__error_union?((TRY (aST__full_type_mut(Locatable{ FuncCall: COPY node }))));
}
CATCH Transient, Input, System, NotFound, Permission, Canceled
  RETURN FALSE;
END
PRIVATE FN typeAnalysisSession__resolved_call_error_fallible?(MUTABLE self: TypeAnalysisSession, MUTABLE node: Node) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (aST__node_error_union_type( UNWRAP (castNodeToLocatable(node))) != NIL) THEN
      RETURN TRUE;
    END
    MUTABLE signature: ?FunctionSignature@multiowned = functionSignature__unwrap((IF node__matched_signature(Node{ MethodCall: COPY node }) EXISTS AS rtoc_wrap_11966 THEN X{ FunctionSignature: COPY rtoc_wrap_11966 } ELSE NIL END));
    IF ((signature != NIL) AND type__error_union?(functionSignature__return_type(signature))) THEN
      RETURN TRUE;
    END
    MUTABLE intrinsic: ?FunctionSignature@multiowned = node__matched_stdlib_def(node);
    IF intrinsic EXISTS AS intrinsic_value THEN
      IF functionSignature__recoverable_result?(intrinsic_value) THEN
      RETURN TRUE;
    END
    END
    RETURN type__error_union?(TRY (aST__full_type_mut(UNWRAP (castNodeToLocatable(node)))));
}
CATCH Transient, Input, System, NotFound, Permission, Canceled
  RETURN FALSE;
END
PRIVATE FN typeAnalysisSession__with_block_raises_directly?(MUTABLE self: TypeAnalysisSession, MUTABLE node: WithBlock) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (node.snapshot_mode == :transaction) THEN
      RETURN TRUE;
    END
    MUTABLE clause: ?ErrorClause = node.lock_error_clause;
    IF !(clause) THEN
      RETURN FALSE;
    END
    RETURN (((clause.action == ErrorActionKind.Raise) OR (clause.action == ErrorActionKind.Exit)) OR !(clause.bubble_types.empty?()));
}
END
PRIVATE FN typeAnalysisSession__analyze_program_bodies_mut(MUTABLE self: TypeAnalysisSession, declarations: DeclarationIndex, MUTABLE program: Program) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN declarations.body_statements DO
    TRY (typeAnalysisSession__visit(&rtoc_self_view, _));
    END
    FOR MUTABLE rtoc_mutable_block_param_283 IN (TRY (typeAnalysisSession__synthetic_function_definitions(&rtoc_self_view))) DO
    TRY (typeAnalysisSession__visit_FunctionDef(&rtoc_self_view, &rtoc_mutable_block_param_283));
    &program.statements.append(COPY rtoc_mutable_block_param_283);
    END
}
END
PRIVATE FN typeAnalysisSession__validate_conformances_mut(MUTABLE self: TypeAnalysisSession, resolutions: []ConformanceResolution) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < resolutions.length() DO
      MUTABLE failures = ((resolutions[rtoc_idx]?.protocol)?.requirements OR_ELSE List[]) |> SELECT:? {
        MUTABLE member: ?FunctionDef@multiowned = COPY (resolutions[rtoc_idx]?.members)[_.name];
        (  IF (member == NIL) THEN
            "${_.name}: missing"
          ELSE
            TRY (typeAnalysisSession__conformance_requirement_mismatch(&rtoc_self_view, _, CAST(COPY member AS FunctionDef), resolutions[rtoc_idx]?))
          END)
      } |> WHERE _ != NIL;
      MUTABLE extras = ((resolutions[rtoc_idx]?.members OR_ELSE {}).keys() - (((resolutions[rtoc_idx]?.protocol).requirements) |> SELECT _.name));
      failures = (failures + extras |> SELECT "${_}: not declared by ${(resolutions[rtoc_idx]?.protocol).name}");
      IF (failures.length() == 0) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      TRY (typeAnalysisSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY Locatable{ ConformanceDef: COPY UNWRAP (resolutions[rtoc_idx]?.declaration) } }, TypeAnalysisCodeOrMessage{ SymbolValue: :CONFORMANCE_REQUIREMENTS }, [], CAST({:protocol: (resolutions[rtoc_idx]?.protocol).name, :owner: resolutions[rtoc_idx]?.owner_name, :count: failures.length(), :details: (failures |> SELECT "\n  - ${(_ OR_ELSE "")}").join("")} AS {String@symbol}Any)));
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PRIVATE FN typeAnalysisSession__conformance_requirement_mismatch(MUTABLE self: TypeAnalysisSession, requirement: ProtocolRequirement, member: FunctionDef, resolution: ConformanceResolution) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (requirement.is_method != member.is_method) THEN
      MUTABLE expected_kind: String = "";
      IF requirement.is_method THEN
        expected_kind = "METHOD";
      ELSE
        expected_kind = "FN";
      END
      MUTABLE actual_kind: String = "";
      IF member.is_method THEN
        actual_kind = "METHOD";
      ELSE
        actual_kind = "FN";
      END
      RETURN "${requirement.name}: expected ${expected_kind}, found ${actual_kind}";
    END
    IF (requirement.params.length() != member.params.length()) THEN
      RETURN "${requirement.name}: expected ${requirement.params.length().toString()} parameter(s), found ${member.params.length().toString()}";
    END
    MUTABLE substitutions: {String@symbol}GenericBinding = castTypeMapToGenericBindingMap__type_analysis_session(resolution.associated_types);
    substitutions[:Self] = GenericBinding{ Type: COPY resolution.declaration.owner_type };
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < requirement.params.length() DO
      MUTABLE actual = COPY UNWRAP (member.params[rtoc_idx]);
      MUTABLE expected_type = TRY (typeAnalysisSession__apply_type_subst(&rtoc_self_view, castTypeToTypeTypeInput__type_analysis_session(UNWRAP (requirement.params[rtoc_idx]?.type)), substitutions));
      IF (((type__semantic_type_key(expected_type) != type__semantic_type_key(actual.type)) OR (requirement.params[rtoc_idx]?.mutable != actual.mutable)) OR (requirement.params[rtoc_idx]?.takes != actual.takes)) THEN
          RETURN "${requirement.name}: parameter ${(rtoc_idx + 1).toString()} is incompatible";
      END
    rtoc_idx = rtoc_idx + 1;
    END
    MUTABLE expected_return = TRY (typeAnalysisSession__apply_type_subst(&rtoc_self_view, castTypeToTypeTypeInput__type_analysis_session(requirement.return_type), substitutions));
    MUTABLE actual_return = (member.return_type OR_ELSE TRY (type__new(TypeConstructionInput{ SymbolValue: :Void })));
    IF !((type__semantic_type_key(expected_return) == type__semantic_type_key(actual_return))) THEN
      RETURN "${requirement.name}: expected RETURNS ${TRY (type__surface_name(TypeTypeInput{ Type: COPY expected_return }))}, found ${TRY (type__surface_name(castTypeToTypeTypeInput__type_analysis_session(actual_return)))}";
    END
    MUTABLE actual_effect = (member.reentrance_kind OR member.effects_decl);
    IF typeAnalysisSession__protocol_effect_accepts?(&rtoc_self_view, requirement.effects_decl, actual_effect) THEN
      RETURN NIL;
    END
    MUTABLE expected: String = "";
    IF requirement.effects_decl EXISTS AS effects_decl_value THEN
      expected = typeAnalysisSession__protocol_effect_name(&rtoc_self_view, effects_decl_value);
    ELSE
      expected = "no reentrant effect";
    END
    MUTABLE found: String = "";
    IF actual_effect THEN
      found = typeAnalysisSession__protocol_effect_name(&rtoc_self_view, actual_effect);
    ELSE
      found = "no reentrant effect";
    END
    RETURN "${requirement.name}: expected ${expected}, found ${found}";
}
END
PRIVATE FN typeAnalysisSession__protocol_effect_accepts?(MUTABLE self: TypeAnalysisSession, required: ?String@symbol, actual: ?String@symbol) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN ((required == :reentrant) OR (IF (required == NIL) THEN
      (actual == NIL)
    ELSE
      ((actual == NIL) OR (actual == required))
    END));
}
END
PRIVATE FN typeAnalysisSession__protocol_effect_name(MUTABLE self: TypeAnalysisSession, effect: String@symbol) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE suffix = COPY ((CAST({:reentrant: "", :reentrant_thunk: ":THUNK", :reentrant_tail_call: ":TAIL_CALL", :reentrant_not_logical: ":NOT_LOGICAL", :reentrant_max_depth: ":MAX_DEPTH"} AS {String@symbol}String))[effect] OR_ELSE ":${(CAST(effect AS String)).upcase()}");
    RETURN "EFFECTS REENTRANT${suffix}";
}
END
