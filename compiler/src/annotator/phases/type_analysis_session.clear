PRIVATE FN typeAnalysisSession__restamp_stale_auto_nodes_mut(MUTABLE self: TypeAnalysisSession, program: Program) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE nodes: []Locatable = ( { MUTABLE rtoc_empty_list_258: []Locatable = List[]; rtoc_empty_list_258 } );
    aST__each_locatable(Locatable{ Program: COPY program }, TRUE, %(MUTABLE node: Locatable) USE(MUTABLE nodes) -> {
    &nodes.append(COPY node);
    rubyToClearVoid__type_analysis_session()
    });
    MUTABLE rtoc_reverse_items_259: []Locatable = nodes;
    MUTABLE rtoc_reverse_i_260 = rtoc_reverse_items_259.length() - 1;
    WHILE rtoc_reverse_i_260 >= 0 DO
      IF TRY (typeAnalysisSession__restamp_binary_type_after_auto_mut(&rtoc_self_view, (rtoc_reverse_items_259[rtoc_reverse_i_260])?)) THEN
        rtoc_reverse_i_260 = rtoc_reverse_i_260 - 1;
    CONTINUE;
      END
      IF !(typeAnalysisSession__stale_auto_node_type?(&rtoc_self_view, CAST(TRY (typeAnalysisSession__auto_finalization_node_type(&rtoc_self_view, (rtoc_reverse_items_259[rtoc_reverse_i_260])?)) AS Type))) THEN
          rtoc_reverse_i_260 = rtoc_reverse_i_260 - 1;
    CONTINUE;
      END
      MUTABLE symbol_type: ?Type@multiowned = TRY (typeAnalysisSession__concrete_symbol_type_for(&rtoc_self_view, (rtoc_reverse_items_259[rtoc_reverse_i_260])?));
      IF symbol_type EXISTS AS symbol_type_value THEN
          MUTABLE symbol_type_value_mutable = COPY symbol_type_value;
          TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, (rtoc_reverse_items_259[rtoc_reverse_i_260])?, symbol_type_value_mutable));
          rtoc_reverse_i_260 = rtoc_reverse_i_260 - 1;
    CONTINUE;
      END
      MUTABLE call_type: ?Type@multiowned = TRY (typeAnalysisSession__concrete_function_call_type_for(&rtoc_self_view, (rtoc_reverse_items_259[rtoc_reverse_i_260])?));
      IF call_type EXISTS AS call_type_value THEN
          MUTABLE call_type_value_mutable = COPY call_type_value;
          TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, (rtoc_reverse_items_259[rtoc_reverse_i_260])?, call_type_value_mutable));
          rtoc_reverse_i_260 = rtoc_reverse_i_260 - 1;
    CONTINUE;
      END
      MUTABLE program_type: ?Type@multiowned = TRY (typeAnalysisSession__concrete_program_type_for(&rtoc_self_view, (rtoc_reverse_items_259[rtoc_reverse_i_260])?));
      IF program_type EXISTS AS program_type_value THEN
          MUTABLE program_type_value_mutable = COPY program_type_value;
          TRY (typeAnalysisSession__stamp_type_mut(&rtoc_self_view, (rtoc_reverse_items_259[rtoc_reverse_i_260])?, program_type_value_mutable));
      END
    rtoc_reverse_i_260 = rtoc_reverse_i_260 - 1;
    END
}
END
PRIVATE FN typeAnalysisSession__auto_finalization_node_type(MUTABLE self: TypeAnalysisSession, MUTABLE node: Locatable) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(locatable__typed?(node)) THEN
