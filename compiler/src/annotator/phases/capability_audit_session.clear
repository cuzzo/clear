    MUTABLE has_takes_heap = fn_node.params |> ANY ((_.takes OR_ELSE FALSE) AND !(((type__primitive?(_.type) OR type__id_handle?(_.type)))));
    MUTABLE has_catch = capabilityAuditSession__function_has_catch_clauses?(rtoc_self_view, fn_node);
    MUTABLE has_raise = TRY (capabilityAuditSession__function_raises_directly?(rtoc_self_view, name));
    MUTABLE thunk_uses_rt = (!((fn_node.thunk_plan == NIL)) OR !((fn_node.mutual_thunk_plan == NIL)));
    MUTABLE yield_uses_rt = capabilityAuditSession__recursion_yield_needed?(rtoc_self_view, fn_node);
    RETURN ((((((((functionDef__uses_runtime?(fn_node) OR heap_return) OR (TRY (capabilityAuditSession__function_has_fnptr_call?(rtoc_self_view, name)))) OR has_takes_heap) OR has_catch) OR has_raise) OR thunk_uses_rt) OR yield_uses_rt) OR (name == name));
}
END
PRIVATE FN capabilityAuditSession__seed_imported_needs_rt_mut(MUTABLE self: CapabilityAuditSession, MUTABLE needs_rt: {String}Bool) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR rtoc_each_8 IN (TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view))).keys() DO
    MUTABLE callees: [Set]String = ((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[rtoc_each_8] OR_ELSE CAST(panic("missing hash key") AS [Set]String));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < callees.length() DO
      IF needs_rt.contains?(callees[rtoc_idx]) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE scope: ?Scope@multiowned = TRY (capabilityAuditSession__lookup_scope_for(&rtoc_self_view, callees[rtoc_idx]));
      IF !(scope) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE sig: ?FunctionSignature@multiowned = functionSignature__unwrap(ruby_wrap_optional_Type_multiowned_X__capability_audit_session((IF scope__resolve_entry(scope, callees[rtoc_idx]) != NIL THEN
          { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_15 = (scope__resolve_entry(scope, callees[rtoc_idx]));
      symbolEntry__type(rtoc_local_receiver_15) }
        ELSE
          NIL
        END)));
      IF sig EXISTS AS sig_value THEN
        IF functionSignature__needs_rt(sig_value) THEN
          needs_rt[callees[rtoc_idx]] = TRUE;
      END
      END
    rtoc_idx = rtoc_idx + 1;
    END
