PRIVATE FN capabilityAuditSession__emit_missing_mutable_marker_error_mut(self: CapabilityAuditSession, facts: CallArgumentFacts, scope: Scope) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE arg = COPY facts.arg_node;
    MUTABLE root: ?Identifier = aST__root_identifier(arg);
    IF root EXISTS AS root_value THEN
      MUTABLE edits: []Edit = [edit__new(span__new(NIL, root_value.token.line, root_value.token.column, 0), "&")];
      MUTABLE mutable_fix: ?Fix@multiowned = capabilityAuditSession__build_declare_mutable_fix(rtoc_self_view, root_value.name, scope);
      IF (scope__is_immutable?(scope, root_value.name) AND (mutable_fix != NIL)) THEN
        edits = ruby_array_concat_Edit(edits, mutable_fix.edits);
      END
      MUTABLE fix = TRY (fix__new(capabilityAuditSession__fix_description(rtoc_self_view, :INSERT_MUTABLE_ARGUMENT_MARKER, {:name: DiagnosticKwValue{ StringValue: COPY root_value.name }, :param: DiagnosticKwValue{ StringValue: COPY facts.param.name }}), edits, :auto));
      capabilityAuditSession__fixable_mut(rtoc_self_view, root_value, :mutability, [fix], NIL, :MUTABLE_ARGUMENT_REQUIRES_MARKER, :error, FALSE, {:index: (facts.index + 1), :param: facts.param.name, :actual: root_value.name});
    ELSE
      RETURN;
    END
}
END
PRIVATE FN capabilityAuditSession__emit_unexpected_mutable_argument_error_mut(self: CapabilityAuditSession, facts: CallArgumentFacts) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE token: ?Token@multiowned = COPY KEEP facts.mutable_marker_token;
    IF token EXISTS AS token_value THEN
      MUTABLE fix = TRY (fix__new(capabilityAuditSession__fix_description(rtoc_self_view, :REMOVE_MUTABLE_ARGUMENT_MARKER, {:param: DiagnosticKwValue{ StringValue: COPY facts.param.name }}), [edit__new(span__new(NIL, token_value.line, token_value.column, 1), "")], :auto));
      capabilityAuditSession__fixable_mut(rtoc_self_view, token_value, :mutability, [fix], NIL, :MUTABLE_MARKER_ON_IMMUTABLE_PARAM, :error, FALSE, {:index: (facts.index + 1), :param: facts.param.name});
    ELSE
      RETURN capabilityAuditSession__error_mut(rtoc_self_view, facts.arg_node, CodeOrMessage{ SymbolValue: :MUTABLE_MARKER_ON_IMMUTABLE_PARAM }, [], {:index: (facts.index + 1), :param: facts.param.name});
    END
}
END
