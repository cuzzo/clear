PRIVATE FN capabilityAuditSession__emit_ambiguous_return_error_mut(MUTABLE self: CapabilityAuditSession, fn_node: FunctionDef, found_returns: []ReturnFact) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE return_types = ( { MUTABLE rtoc_map_results = CAST([] AS []Type); found_returns |> EACH { &rtoc_map_results.append(COPY _.type); }; rtoc_map_results } );
    MUTABLE arrow = COPY fn_node.arrow_token;
    MUTABLE fix: ?Fix = NIL;
    IF arrow THEN
      fix = TRY (fix__new(TRY (capabilityAuditSession__fix_description(rtoc_self_view, :INSERT_RETURNS_ANY)), [edit__new(span__new(NIL, arrow.line, arrow.column, 0), "RETURNS :Any ")], :auto));
    END
    IF !(fix) THEN
      RETURN TRY (capabilityAuditSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ FunctionDef: COPY fn_node } }, CapabilityAuditCodeOrMessage{ SymbolValue: :AMBIGUOUS_RETURN }, [], CAST({:types: return_types} AS {String@symbol}Any)));
    END
    TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ FunctionDef: COPY fn_node } }, :type, [UNWRAP (fix)], NIL, :AMBIGUOUS_RETURN, :error, FALSE, CAST({:types: return_types} AS {String@symbol}Any)));
}
END
PRIVATE FN capabilityAuditSession__emit_match_partial_fix_mut(MUTABLE self: CapabilityAuditSession, match_node: MatchStatement, code: String@symbol, kwargs: {String@symbol}DiagnosticKwValue = {}) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE tok = COPY match_node.token;
    MUTABLE fix: ?Fix = NIL;
    IF tok THEN
      fix = TRY (fix__new(TRY (capabilityAuditSession__fix_description(rtoc_self_view, :REPLACE_MATCH_WITH_PARTIAL)), [edit__new(span__new(NIL, tok.line, tok.column, 0), "PARTIAL ")], :auto));
    END
    IF !(fix) THEN
      RETURN TRY (capabilityAuditSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ MatchStatement: COPY match_node } }, CapabilityAuditCodeOrMessage{ SymbolValue: COPY code }, [], castDiagnosticKwValueMapToAnyMap__capability_audit_session(kwargs)));
    END
    IF (code == :MATCH_NEEDS_ENUM_OR_UNION) THEN
      TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ MatchStatement: COPY match_node } }, :type, [fix], NIL, code, :error, FALSE, CAST({:type: kwargs.substr(:type, 1)} AS {String@symbol}Any)));
    ELSE_IF (code == :MATCH_NON_EXHAUSTIVE) THEN
      TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ MatchStatement: COPY match_node } }, :type, [fix], NIL, code, :error, FALSE, CAST({:kind: kwargs.substr(:kind, 1), :name: kwargs.substr(:name, 1), :missing: kwargs.substr(:missing, 1)} AS {String@symbol}Any)));
    ELSE
      panic("unsupported MATCH partial fix diagnostic: {}");
    END
}
END
PRIVATE FN capabilityAuditSession__emit_return_borrowed_no_copy_error_mut(MUTABLE self: CapabilityAuditSession, MUTABLE node: Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fix: ?Fix = NIL;
    IF locatable__token(node) THEN
      MUTABLE tok: ?Token = locatable__token(node);
      fix = TRY (fix__new(TRY (capabilityAuditSession__fix_description(rtoc_self_view, :WRAP_RETURN_WITH_COPY)), [edit__new(span__new(NIL, UNWRAP (tok).line, UNWRAP (tok).column, 0), "COPY ")], :auto));
    END
    MUTABLE kw = {:type: TRY (aST__full_type_mut(node))};
    IF !(fix) THEN
      RETURN TRY (capabilityAuditSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY node }, CapabilityAuditCodeOrMessage{ SymbolValue: :RETURN_BORROWED_NO_COPY_OR_LIFETIME }, [], kw));
    END
    TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY node }, :lifetime, [UNWRAP (fix)], NIL, :RETURN_BORROWED_NO_COPY_OR_LIFETIME, :error, FALSE, kw));
}
END
PRIVATE FN capabilityAuditSession__emit_cap_field_needs_with_mut(MUTABLE self: CapabilityAuditSession, node: GetField, code: String@symbol, name: NameCandidate, field: String, cap: String, perm: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE src: ?String = capabilityAuditSession__source_code(rtoc_self_view);
    MUTABLE kw: {String@symbol}DiagnosticKwValue = {:name: DiagnosticKwValue{ StringValue: COPY castNameCandidateToString__capability_audit_session(name) }, :field: DiagnosticKwValue{ StringValue: COPY field }, :cap: DiagnosticKwValue{ StringValue: COPY cap }};
    MUTABLE fixes = List[];
    IF (((src != NIL) AND TRUE)) THEN
      MUTABLE line_num = node.token.line;
      MUTABLE line_text = (src.split("\n")[(line_num - 1)] OR_ELSE "");
      body = line_text.trim();
      MUTABLE indent = (compilerRegexFirstMatch(body, compilerRegexCompile("\\A\\s*")) OR_ELSE "");
      MUTABLE inner = body.trimStart();
      IF (!(inner.empty?()) AND !(inner.contains?("\n"))) THEN
        MUTABLE alias_name = "${castNameCandidateToString__capability_audit_session(name)}_v";
        MUTABLE rewritten = compilerRegexReplaceAll(inner, compilerRegexCompile("\\b${compilerRegexEscape(CAST(name AS String))}\\.(?=\\w)"), "${alias_name}.");
        MUTABLE new_line = "${indent}WITH ${perm} ${castNameCandidateToString__capability_audit_session(name)} AS ${alias_name} { ${rewritten} }";
        &fixes.append(TRY (fix__new(TRY (capabilityAuditSession__fix_description(rtoc_self_view, :WRAP_CAPABILITY_ACCESS, CAST({:permission: DiagnosticKwValue{ StringValue: COPY perm }, :name: castNameCandidateToOptionalDiagnosticKwValue__capability_audit_session(name), :alias_name: DiagnosticKwValue{ StringValue: COPY alias_name }, :capability: DiagnosticKwValue{ StringValue: COPY cap }} AS {String@symbol}?DiagnosticKwValue))), [edit__new(span__new(NIL, line_num, 1, (body).length()), new_line)], :interactive)));
      END
    END
    IF (fixes.length() == 0) THEN
      RETURN TRY (capabilityAuditSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ GetField: COPY node } }, CapabilityAuditCodeOrMessage{ SymbolValue: COPY code }, [], kw));
    END
    TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ GetField: COPY node } }, :capability, fixes, NIL, code, :error, TRUE, kw));
}
END
PRIVATE FN capabilityAuditSession__emit_foreign_with_view_needs_unsafe_mut(MUTABLE self: CapabilityAuditSession, node: WithBlock, fact: CapabilityTransition) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE name = COPY fact.target_label;
    MUTABLE view_token: ?Token = COPY capability__view_token(fact.source);
    MUTABLE as_token: ?Token = COPY capability__as_token(fact.source);
    IF view_token EXISTS AS view_token_value THEN
      IF as_token EXISTS AS as_token_value THEN
        MUTABLE fix = TRY (fix__new(TRY (capabilityAuditSession__fix_description(rtoc_self_view, :CONVERT_FOREIGN_VIEW_TO_UNSAFE, CAST({:name: DiagnosticKwValue{ StringValue: COPY name }} AS {String@symbol}?DiagnosticKwValue))), [edit__new(span__new(NIL, view_token_value.line, view_token_value.column, "VIEW".codepointCount()), "UNSAFE VIEW"), edit__new(span__new(NIL, as_token_value.line, UNWRAP (as_token).column, 0), "LENGTH 0 ")], :interactive));
        TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, :capability, [fix], NIL, :WITH_VIEW_FOREIGN_NEEDS_UNSAFE, :error, TRUE, CAST({:name: name} AS {String@symbol}Any)));
      ELSE
        RETURN TRY (capabilityAuditSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, CapabilityAuditCodeOrMessage{ SymbolValue: :WITH_VIEW_FOREIGN_NEEDS_UNSAFE }, [], CAST({:name: name} AS {String@symbol}Any)));
      END
    ELSE
      RETURN TRY (capabilityAuditSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, CapabilityAuditCodeOrMessage{ SymbolValue: :WITH_VIEW_FOREIGN_NEEDS_UNSAFE }, [], CAST({:name: name} AS {String@symbol}Any)));
    END
}
END
PRIVATE FN capabilityAuditSession__emit_foreign_index_needs_unsafe_view_mut(MUTABLE self: CapabilityAuditSession, node: GetIndex, name: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE src: ?String = capabilityAuditSession__source_code(rtoc_self_view);
    MUTABLE fixes = List[];
    IF src EXISTS AS src_value THEN
      MUTABLE line_num = node.source_range?.start_line;
      MUTABLE line_text = (src_value.split("\n")[(UNWRAP (line_num) - 1)] OR_ELSE "");
      body = line_text.trim();
      MUTABLE indent = (compilerRegexFirstMatch(body, compilerRegexCompile("\\A\\s*")) OR_ELSE "");
      MUTABLE inner = body.trimStart();
      MUTABLE index = COPY node.index;
      MUTABLE length: String = "";
      IF ((IF index IS_A Literal AS literal THEN literal.value IS_A Int64 ELSE FALSE END) AND (index.value() >= 0)) THEN
        length = COPY CAST(((index.value() + 1)) AS String);
      ELSE
        length = "0";
      END
      IF !(inner.empty?()) THEN
        MUTABLE alias_name = "${name}_view";
        MUTABLE rewritten = compilerRegexReplaceAll(inner, compilerRegexCompile("\\b${compilerRegexEscape(name)}\\s*(?=\\[)"), alias_name);
        MUTABLE replacement = "${indent}WITH UNSAFE VIEW ${name} LENGTH ${length} AS ${alias_name} { ${rewritten} }";
        &fixes.append(TRY (fix__new(TRY (capabilityAuditSession__fix_description(rtoc_self_view, :WRAP_FOREIGN_INDEX_UNSAFE_VIEW, CAST({:name: DiagnosticKwValue{ StringValue: COPY name }, :length: DiagnosticKwValue{ StringValue: COPY length }, :alias_name: DiagnosticKwValue{ StringValue: COPY alias_name }} AS {String@symbol}?DiagnosticKwValue))), [edit__new(span__new(NIL, line_num, 1, (body).length()), replacement)], :interactive)));
      END
    END
    IF (fixes.length() == 0) THEN
      RETURN TRY (capabilityAuditSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ GetIndex: COPY node } }, CapabilityAuditCodeOrMessage{ SymbolValue: :FOREIGN_POINTER_DIRECT_INDEX }, [], CAST({:name: name} AS {String@symbol}Any)));
    END
    TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ GetIndex: COPY node } }, :capability, fixes, NIL, :FOREIGN_POINTER_DIRECT_INDEX, :error, TRUE, CAST({:name: name} AS {String@symbol}Any)));
}
END
PRIVATE FN capabilityAuditSession__emit_direct_view_access_finding_mut(MUTABLE self: CapabilityAuditSession, node: Locatable, name: String, permission: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE src: ?String = capabilityAuditSession__source_code(rtoc_self_view);
    MUTABLE fixes = List[];
    IF src EXISTS AS src_value THEN
      MUTABLE line_num = UNWRAP (locatable__source_range(node)).start_line;
      MUTABLE line_text = (src_value.split("\n")[(line_num - 1)] OR_ELSE "");
      body = line_text.trim();
      MUTABLE indent = (compilerRegexFirstMatch(body, compilerRegexCompile("\\A\\s*")) OR_ELSE "");
      MUTABLE inner = body.trimStart();
      IF !(inner.empty?()) THEN
        MUTABLE alias_name = "${name}_view";
        MUTABLE rewritten = compilerRegexReplaceAll(inner, compilerRegexCompile("\\b${compilerRegexEscape(name)}\\b"), alias_name);
        MUTABLE replacement = "${indent}WITH ${permission} ${name} AS ${alias_name} { ${rewritten} }";
        &fixes.append(TRY (fix__new(TRY (capabilityAuditSession__fix_description(rtoc_self_view, :WRAP_DIRECT_VIEW_ACCESS, CAST({:permission: DiagnosticKwValue{ StringValue: COPY permission }, :name: DiagnosticKwValue{ StringValue: COPY name }, :alias_name: DiagnosticKwValue{ StringValue: COPY alias_name }} AS {String@symbol}?DiagnosticKwValue))), [edit__new(span__new(NIL, line_num, 1, (body).length()), replacement)], :interactive)));
      END
    END
    IF (fixes.length() == 0) THEN
      RETURN TRY (capabilityAuditSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY node }, CapabilityAuditCodeOrMessage{ SymbolValue: :DIRECT_VIEW_ACCESS_REQUIRES_WITH }, [], CAST({:name: name, :permission: permission} AS {String@symbol}Any)));
    END
    TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY node }, :capability, fixes, NIL, :DIRECT_VIEW_ACCESS_REQUIRES_WITH, :error, TRUE, CAST({:name: name, :permission: permission} AS {String@symbol}Any)));
}
END
PRIVATE FN capabilityAuditSession__emit_with_guard_all_bindings_need_as_mut(MUTABLE self: CapabilityAuditSession, node: WithBlock, missing_caps: []CapabilityTransition) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE edits = List[];
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < missing_caps.length() DO
      MUTABLE vn = COPY missing_caps[rtoc_idx]?.var_node;
      IF !(((IF UNWRAP (vn) IS_A Identifier AS identifier THEN TRUE ELSE FALSE END) AND locatable__token(UNWRAP (vn)))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE tok: ?Token = locatable__token(UNWRAP (vn));
      MUTABLE name = COPY CAST(aST__node_name(UNWRAP (vn)) AS String);
      &edits.append(edit__new(span__new(NIL, UNWRAP (tok).line, (UNWRAP (tok).column + name.codepointCount()), 0), " AS ${name}_v"));
    rtoc_idx = rtoc_idx + 1;
    END
    IF (edits.length() == 0) THEN
      RETURN TRY (capabilityAuditSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, CapabilityAuditCodeOrMessage{ SymbolValue: :WITH_GUARD_ALL_BINDINGS_NEED_AS }));
    END
    MUTABLE fix = TRY (fix__new(TRY (capabilityAuditSession__fix_description(rtoc_self_view, :ADD_WITH_GUARD_ALIASES)), edits, :auto));
    TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, :capability, [fix], NIL, :WITH_GUARD_ALL_BINDINGS_NEED_AS, :error, TRUE));
}
END
PRIVATE FN capabilityAuditSession__emit_with_guard_mutable_mutated_mut(MUTABLE self: CapabilityAuditSession, node: WithBlock, names_input: []String, verb: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE names = COPY names_input;
    MUTABLE src: ?String = capabilityAuditSession__source_code(rtoc_self_view);
    names = names;
    MUTABLE edits = List[];
    IF (((src != NIL) AND TRUE)) THEN
      MUTABLE with_line = node.token.line;
      MUTABLE window_lines = (src.split("\n").substr(((with_line - 1)), ((((with_line + 8)) - ((with_line - 1))) + 1)) OR_ELSE List[]);
      FOR _ IN names DO
    MUTABLE pat = compilerRegexCompile("\\bMUTABLE\\s+${compilerRegexEscape(_)}\\b");
    MUTABLE off = 0;
    MUTABLE found: Bool = FALSE;
    WHILE ((off < window_lines.codepointCount()) AND !(found)) DO
          MUTABLE line = window_lines.substr(off, 1);
          MUTABLE idx = compilerRegexMatch(line, pat);
          IF idx THEN
            MUTABLE line_no = (with_line + off);
            MUTABLE mut_col = (idx + 1);
            &edits.append(edit__new(span__new(NIL, line_no, mut_col, "MUTABLE ".codepointCount()), ""));
            found = TRUE;
          END
          off = (off + 1);
    END
      END
    END
    MUTABLE names_str = (names |> SELECT "'${_}'").join(", ");
    MUTABLE kw = {:names: names_str, :verb: verb};
    IF (edits.length() == 0) THEN
      RETURN TRY (capabilityAuditSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, CapabilityAuditCodeOrMessage{ SymbolValue: :WITH_GUARD_MUTABLE_MUTATED }, [], kw));
    END
    MUTABLE target: String = "";
    IF (names.length() == 1) THEN
      target = "the alias";
    ELSE
      target = "each guarded alias";
    END
    MUTABLE fix = TRY (fix__new(TRY (capabilityAuditSession__fix_description(rtoc_self_view, :DROP_WITH_GUARD_MUTABLE, CAST({:target: DiagnosticKwValue{ StringValue: COPY target }} AS {String@symbol}?DiagnosticKwValue))), edits, :interactive));
    TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, :capability, [fix], NIL, :WITH_GUARD_MUTABLE_MUTATED, :error, TRUE, kw));
}
END
PRIVATE FN capabilityAuditSession__emit_with_read_needs_write_lock_mut(MUTABLE self: CapabilityAuditSession, node: WithBlock, name: String, MUTABLE var_node: Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE syn = cap_var_sync(&var_node);
    MUTABLE fix_branch_value: ?Fix@multiowned = NIL;
    IF (syn == :locked) THEN
      fix_branch_value = TRY (capabilityAuditSession__build_decl_cap_replace_fix(&rtoc_self_view, name, "@locked", "@writeLocked", :REPLACE_LOCKED_WITH_WRITE_LOCKED, {}, :auto));
    ELSE
      fix_branch_value = TRY (capabilityAuditSession__build_decl_cap_insert_fix(&rtoc_self_view, name, "@writeLocked", :WITH_ADD_WRITE_LOCKED, CAST({:reader: DiagnosticKwValue{ StringValue: COPY "via `WITH READ`" }} AS {String@symbol}?DiagnosticKwValue), :auto));
    END
    MUTABLE fix: ?Fix@multiowned = fix_branch_value;
    IF fix EXISTS AS fix_value THEN
      TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, :capability, [fix_value], NIL, :WITH_READ_NEEDS_WRITE_LOCK, :error, TRUE, CAST({:name: name} AS {String@symbol}Any)));
    ELSE
      RETURN TRY (capabilityAuditSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, CapabilityAuditCodeOrMessage{ SymbolValue: :WITH_READ_NEEDS_WRITE_LOCK }, [], CAST({:name: name} AS {String@symbol}Any)));
    END
}
END
PRIVATE FN capabilityAuditSession__emit_with_cannot_infer_cap_mut(MUTABLE self: CapabilityAuditSession, node: WithBlock, name: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE candidates: []WithCapCandidate = [
      WithCapCandidate{ sigil: "@multiowned", description_code: :WITH_ADD_MULTIOWNED, description_params: {:suffix: DiagnosticKwValue{ StringValue: "" }} },
      WithCapCandidate{ sigil: "@shared", description_code: :WITH_ADD_SHARED, description_params: {:suffix: DiagnosticKwValue{ StringValue: "across fibers" }} },
      WithCapCandidate{ sigil: "@locked", description_code: :WITH_ADD_LOCKED, description_params: {} },
      WithCapCandidate{ sigil: "@writeLocked", description_code: :WITH_ADD_WRITE_LOCKED, description_params: {:reader: DiagnosticKwValue{ StringValue: "via WITH READ" }} }];
    MUTABLE fixes = candidates |> SELECT:? TRY (capabilityAuditSession__build_decl_cap_insert_fix(&rtoc_self_view, name, _.sigil, _.description_code, _.description_params, :interactive)) |> WHERE _ != NIL |> SELECT UNWRAP (_);
    IF (fixes.length() == 0) THEN
      RETURN TRY (capabilityAuditSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, CapabilityAuditCodeOrMessage{ SymbolValue: :WITH_CANNOT_INFER_CAP }, [], CAST({:name: name} AS {String@symbol}Any)));
    END
    TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, :capability, fixes, NIL, :WITH_CANNOT_INFER_CAP, :error, TRUE, CAST({:name: name} AS {String@symbol}Any)));
}
END
PRIVATE FN capabilityAuditSession__emit_with_materialized_needs_tense_mut(MUTABLE self: CapabilityAuditSession, node: WithBlock, name: String, got: TypeTypeInput) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE src: ?String = capabilityAuditSession__source_code(rtoc_self_view);
    MUTABLE scope: ?Scope@multiowned = TRY (capabilityAuditSession__lookup_scope_for(&rtoc_self_view, name));
    MUTABLE decl: ?SymbolEntryRegInput = NIL;
    IF (IF scope != NIL THEN
      scope__resolve_entry(scope, name)
    ELSE
      NIL
    END) != NIL THEN
      decl = UNWRAP (COPY (((IF scope != NIL THEN
      scope__resolve_entry(scope, name)
    ELSE
      NIL
    END)))).reg;
    END
    MUTABLE fix: ?Fix = NIL;
    IF ((decl != NIL) AND (src != NIL)) THEN
      MUTABLE token: ?Token = aST__node__token(castSymbolEntryRegInputToLocatable(decl));
      IF token THEN
        MUTABLE dline = UNWRAP (token).line;
        MUTABLE line_text = (src.split("\n")[(dline - 1)] OR_ELSE "");
        MUTABLE search_offset = (UNWRAP (token).column - 1);
        MUTABLE ann_match: ?CompilerRegexScanner = NIL;
        IF line_text.substr(search_offset, (line_text.length() - search_offset)) != NIL THEN
          ann_match = COPY compilerRegexMatchData(((line_text.substr(search_offset, (line_text.length() - search_offset)))?), compilerRegexCompile(":\\s*([A-Za-z_][\\w]*)"));
        END
        IF ((ann_match != NIL) AND !(line_text.contains?("~"))) THEN
          MUTABLE type_col = ((search_offset + ann_match.begin(1)) + 1);
          fix = TRY (fix__new(TRY (capabilityAuditSession__fix_description(rtoc_self_view, :PREFIX_TENSE_TYPE, CAST({:name: DiagnosticKwValue{ StringValue: COPY name }} AS {String@symbol}?DiagnosticKwValue))), [edit__new(span__new(NIL, dline, type_col, 0), "~")], :interactive));
        END
      END
    END
    MUTABLE kw = {:name: name, :got: got};
    IF !(fix) THEN
      RETURN TRY (capabilityAuditSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, CapabilityAuditCodeOrMessage{ SymbolValue: :WITH_MATERIALIZED_NEEDS_TENSE }, [], kw));
    END
    TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, :capability, [fix], NIL, :WITH_MATERIALIZED_NEEDS_TENSE, :error, TRUE, kw));
}
END
PRIVATE FN capabilityAuditSession__emit_with_restrict_immutable_error_mut(MUTABLE self: CapabilityAuditSession, node: WithBlock, var_node: Identifier) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE name = COPY var_node.name;
    MUTABLE scope = ((var_node.symbol?.scope) OR_ELSE TRY (capabilityAuditSession__current_scope(rtoc_self_view)));
    MUTABLE fix: ?Fix@multiowned = TRY (capabilityAuditSession__build_declare_mutable_fix(rtoc_self_view, name, scope));
    IF fix EXISTS AS fix_value THEN
      TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, :capability, [fix_value], NIL, :WITH_RESTRICT_NEEDS_MUTABLE, :error, FALSE, CAST({:name: name} AS {String@symbol}Any)));
    ELSE
      RETURN TRY (capabilityAuditSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, CapabilityAuditCodeOrMessage{ SymbolValue: :WITH_RESTRICT_NEEDS_MUTABLE }, [], CAST({:name: name} AS {String@symbol}Any)));
    END
}
END
PRIVATE FN capabilityAuditSession__emit_can_smash_unsupported_error_mut(MUTABLE self: CapabilityAuditSession, node: AsyncValidationNode) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fix: ?Fix = NIL;
    MUTABLE tok: ?Token = IF (asyncValidationNode__can_smash_token(node) != NIL) THEN
      asyncValidationNode__can_smash_token(node)
    ELSE
      NIL
    END;
    IF tok THEN
      fix = TRY (fix__new(TRY (capabilityAuditSession__fix_description(rtoc_self_view, :REPLACE_CAN_SMASH_WITH_SERVICE)), [edit__new(span__new(NIL, UNWRAP (tok).line, tok.column, (CAST(tok.value() AS String)).codepointCount()), "@service")], :auto));
    END
    IF !(fix) THEN
      RETURN TRY (capabilityAuditSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castAsyncValidationNodeToLocatable(node)), CapabilityAuditCodeOrMessage{ SymbolValue: :CAN_SMASH_NOT_SUPPORTED }));
    END
    TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, diagnosticAnchor__of(castAsyncValidationNodeToLocatable(node)), :reentrance, [fix], NIL, :CAN_SMASH_NOT_SUPPORTED, :error));
}
END
PRIVATE FN capabilityAuditSession__emit_type_mismatch_assign_error_mut(MUTABLE self: CapabilityAuditSession, node: Node, target_type: TypeTypeInput, value_type: String@symbol) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE kw = CAST({:got: value_type, :expected: target_type} AS {String@symbol}Any);
    MUTABLE value: ?Locatable = aST__node_value(UNWRAP (castNodeToLocatable(node)));
    MUTABLE fix: ?Fix@multiowned = TRY (capabilityAuditSession__build_cast_wrap_fix(rtoc_self_view, value, target_type));
    IF fix EXISTS AS fix_value THEN
      TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, diagnosticAnchor__of(castNodeToLocatable(node)), :type, [fix_value], NIL, :TYPE_MISMATCH_ASSIGN, :error, FALSE, kw));
    ELSE
      RETURN TRY (capabilityAuditSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castNodeToLocatable(node)), CapabilityAuditCodeOrMessage{ SymbolValue: :TYPE_MISMATCH_ASSIGN }, [], kw));
    END
}
END
PRIVATE FN capabilityAuditSession__literal_source_length(self: CapabilityAuditSession, tok: Token) RETURNS Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE src: ?String = capabilityAuditSession__source_code(rtoc_self_view);
    IF src EXISTS AS src_value THEN
      MUTABLE line: ?String = COPY src_value.split("\n")[(tok.line - 1)];
      IF line EXISTS AS line_value THEN
        MUTABLE rest = line_value.substr(((tok.column - 1)), (line_value.length() - ((tok.column - 1))));
        IF (FALSE OR (rest.length() == 0)) THEN
          RETURN (CAST(tok.value AS String)).codepointCount();
        END
        IF rest.startsWith?("\"\"\"") THEN
          MUTABLE idx: ?Int64 = rest.indexOf("\"\"\"", 3);
          IF idx EXISTS AS idx_value THEN
            RETURN (idx_value + 3);
          ELSE
            RETURN (CAST(tok.value AS String)).codepointCount();
          END
        END
        IF rest.startsWith?("\"") THEN
          MUTABLE i = 1;
          WHILE (i < rest.codepointCount()) DO
            MUTABLE ch = rest.substr(i, 1);
            IF (ch == "\"") THEN
              BREAK;
            END
            IF ((ch == "\\") AND ((i + 1) < rest.codepointCount())) THEN
              i = (i + 1);
            END
            i = (i + 1);
          END
          RETURN (i + 1);
        END
        MUTABLE m: ?CompilerRegexScanner = compilerRegexMatchData(rest, compilerRegexCompile("\\A[\\d_a-zA-Z.]+"));
        IF m EXISTS AS m_value THEN
          RETURN compilerRegexCapture(m_value, 0).codepointCount();
        ELSE
          RETURN (CAST(tok.value AS String)).codepointCount();
        END
      ELSE
        RETURN (CAST(tok.value AS String)).codepointCount();
      END
    ELSE
      RETURN (CAST(tok.value AS String)).codepointCount();
    END
}
END
PRIVATE FN capabilityAuditSession__build_cast_wrap_fix(self: CapabilityAuditSession, value: ?Locatable, target_type: TypeTypeInput) RETURNS !?Fix
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF value EXISTS AS value_value THEN
      IF !(locatable__token(value_value)) THEN
        RETURN NIL;
      END
      MUTABLE tok: ?Token = locatable__token(value_value);
      MUTABLE target_name_branch_value: ?TypeTypeInput = NIL;
      IF target_type IS_A Type AS type THEN
        target_name_branch_value = TypeTypeInput{ SymbolValue: COPY type__resolved(type) };
      ELSE
        target_name_branch_value = COPY target_type;
      END
      MUTABLE target_name: TypeTypeInput = target_name_branch_value?;
      MUTABLE text_length = NIL;
      PARTIAL MATCH value_value START
        Locatable.Literal AS literal -> text_length = capabilityAuditSession__literal_source_length(rtoc_self_view, UNWRAP (tok));,
        Locatable.Identifier AS identifier -> text_length = identifier__name(identifier).codepointCount();,
        DEFAULT -> text_length = NIL;
      END
      IF !(text_length) THEN
        RETURN NIL;
      END
      RETURN TRY (fix__new(TRY (capabilityAuditSession__fix_description(rtoc_self_view, :WRAP_VALUE_WITH_CAST, CAST({:type: castTypeTypeInputToOptionalDiagnosticKwValue__capability_audit_session(target_name)} AS {String@symbol}?DiagnosticKwValue))), [edit__new(span__new(NIL, UNWRAP (tok).line, UNWRAP (tok).column, 0), "CAST("), edit__new(span__new(NIL, UNWRAP (tok).line, (UNWRAP (tok).column + text_length), 0), " AS ${castTypeTypeInputToString__capability_audit_session(target_name)})")], :interactive));
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN capabilityAuditSession__build_decl_cap_insert_fix(MUTABLE self: CapabilityAuditSession, name: String, sigil: String, description_code: String@symbol = :ADD_DECL_CAPABILITY_GENERIC, description_params: {String@symbol}DiagnosticKwValue, confidence: String@symbol = :auto) RETURNS !?Fix
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE src: ?String = capabilityAuditSession__source_code(rtoc_self_view);
    MUTABLE scope: ?Scope@multiowned = TRY (capabilityAuditSession__lookup_scope_for(&rtoc_self_view, name));
    MUTABLE decl: ?SymbolEntryRegInput = NIL;
    IF (IF scope != NIL THEN
      scope__resolve_entry(scope, name)
    ELSE
      NIL
    END) != NIL THEN
      decl = UNWRAP (COPY (((IF scope != NIL THEN
      scope__resolve_entry(scope, name)
    ELSE
      NIL
    END)))).reg;
    END
    IF !((((decl != NIL) AND TRUE) AND TRUE)) THEN
      RETURN NIL;
    END
    IF src EXISTS AS src_value THEN
      MUTABLE dline = aST__node__token(castSymbolEntryRegInputToLocatable(UNWRAP (decl))).line;
      MUTABLE line_text = (src_value.split("\n")[(dline - 1)] OR_ELSE "");
      MUTABLE semi_idx: ?Int64 = line_text.indexOf(";", (aST__node__token(castSymbolEntryRegInputToLocatable(UNWRAP (decl))).column - 1));
      IF semi_idx EXISTS AS semi_idx_value THEN
        IF line_text.contains?(sigil) THEN
          RETURN NIL;
        END
        MUTABLE insert_col = (semi_idx_value + 1);
        MUTABLE fix_params = {:sigil: sigil, :name: name, :line: dline}.keys() |> REDUCE(COPY description_params) { acc[_] = COPY ({:sigil: sigil, :name: name, :line: dline}[_] OR_ELSE panic("missing hash key")); acc };
        RETURN TRY (fix__new(TRY (capabilityAuditSession__fix_description_from_hash(rtoc_self_view, description_code, fix_params)), [edit__new(span__new(NIL, dline, insert_col, 0), " ${sigil}")], confidence));
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN capabilityAuditSession__build_decl_cap_replace_fix(MUTABLE self: CapabilityAuditSession, name: String, old_sigil: String, new_sigil: String, description_code: String@symbol = :CHANGE_DECL_CAPABILITY_GENERIC, description_params: {String@symbol}DiagnosticKwValue, confidence: String@symbol = :auto) RETURNS !?Fix
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE src: ?String = capabilityAuditSession__source_code(rtoc_self_view);
    MUTABLE scope: ?Scope@multiowned = TRY (capabilityAuditSession__lookup_scope_for(&rtoc_self_view, name));
    MUTABLE decl: ?SymbolEntryRegInput = NIL;
    IF (IF scope != NIL THEN
      scope__resolve_entry(scope, name)
    ELSE
      NIL
    END) != NIL THEN
      decl = UNWRAP (COPY (((IF scope != NIL THEN
      scope__resolve_entry(scope, name)
    ELSE
      NIL
    END)))).reg;
    END
    IF !((((decl != NIL) AND TRUE) AND TRUE)) THEN
      RETURN NIL;
    END
    IF src EXISTS AS src_value THEN
      MUTABLE dline = aST__node__token(castSymbolEntryRegInputToLocatable(UNWRAP (decl))).line;
      MUTABLE line_text = (src_value.split("\n")[(dline - 1)] OR_ELSE "");
      MUTABLE idx: ?Int64 = line_text.indexOf(old_sigil);
      IF idx EXISTS AS idx_value THEN
        MUTABLE fix_params = {:old_sigil: old_sigil, :new_sigil: new_sigil, :name: name, :line: dline}.keys() |> REDUCE(COPY description_params) { acc[_] = COPY ({:old_sigil: old_sigil, :new_sigil: new_sigil, :name: name, :line: dline}[_] OR_ELSE panic("missing hash key")); acc };
        RETURN TRY (fix__new(TRY (capabilityAuditSession__fix_description_from_hash(rtoc_self_view, description_code, fix_params)), [edit__new(span__new(NIL, dline, (idx_value + 1), old_sigil.codepointCount()), new_sigil)], confidence));
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN capabilityAuditSession__emit_with_cap_mismatch_mut(MUTABLE self: CapabilityAuditSession, node: WithBlock, name: String, code: String@symbol, candidates: []CapabilityFixCandidate, confidence: String@symbol = :auto, kw: {String@symbol}DiagnosticKwValue = {}) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fixes = candidates |> SELECT:? TRY (capabilityAuditSession__build_decl_cap_insert_fix(&rtoc_self_view, name, _.sigil, _.description_code, _.description_params, confidence)) |> WHERE _ != NIL;
    IF (fixes.length() == 0) THEN
      RETURN TRY (capabilityAuditSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, CapabilityAuditCodeOrMessage{ SymbolValue: COPY code }, [], castDiagnosticKwValueToAnyMultiowned__capability_audit_session(kw)));
    END
    IF (code == :WITH_EXCLUSIVE_NEEDS_LOCK) THEN
      TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, :capability, fixes, NIL, code, :error, TRUE, CAST({:got: kw.substr(:got, 1)} AS {String@symbol}Any)));
    ELSE_IF (code == :WITH_SNAPSHOT_NEEDS_VERSIONED_OR_ATOMIC) OR (code == :WITH_ATOMIC_NEEDS_SHARED_ATOMIC) THEN
      TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, :capability, fixes, NIL, code, :error, TRUE, CAST({:name: kw.substr(:name, 1), :actual: kw.substr(:actual, 1)} AS {String@symbol}Any)));
    ELSE_IF (code == :WITH_NEEDS_MULTIOWNED) OR (code == :WITH_NEEDS_SHARED) THEN
      TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ WithBlock: COPY node } }, :capability, fixes, NIL, code, :error, TRUE, CAST({:name: kw.substr(:name, 1)} AS {String@symbol}Any)));
    ELSE
      panic("unsupported WITH capability mismatch diagnostic: {}");
    END
}
END
PRIVATE FN capabilityAuditSession__build_declare_mutable_fix(self: CapabilityAuditSession, name: String, scope: Scope) RETURNS !?Fix
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE info: ?SymbolEntry@multiowned = scope__resolve_entry(scope, name);
    IF info EXISTS AS info_value THEN
      MUTABLE tok: ?Token = NIL;
      MUTABLE decl: ?SymbolEntryRegInput = COPY info_value.reg;
      IF ((decl != NIL) AND TRUE) THEN
        tok = aST__node__token(castSymbolEntryRegInputToLocatable(decl));
      ELSE_IF (symbolEntry__is_param(info_value) AND (COPY info_value.param_decl_token != NIL)) THEN
        tok = COPY info_value.param_decl_token;
      END
      IF !(tok) THEN
        RETURN NIL;
      END
      IF (token__text_is?(UNWRAP (tok), "MUTABLE")) THEN
        RETURN NIL;
      END
      RETURN TRY (fix__new(TRY (capabilityAuditSession__fix_description(rtoc_self_view, :DECLARE_MUTABLE_BINDING, CAST({:name: DiagnosticKwValue{ StringValue: COPY name }, :line: UNWRAP (tok).line} AS {String@symbol}?DiagnosticKwValue))), [edit__new(span__new(NIL, tok.line, tok.column, 0), "MUTABLE ")], :auto));
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN capabilityAuditSession__build_atomic_escape_migration_fix(self: CapabilityAuditSession, source_sym: SymbolEntry, source_name: String) RETURNS !?Fix
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE src: ?String = capabilityAuditSession__source_code(rtoc_self_view);
    IF !(((TRUE AND TRUE) AND symbolEntry__atomic?(source_sym))) THEN
      RETURN NIL;
    END
    IF src EXISTS AS src_value THEN
      MUTABLE reg_branch_value: ?SymbolEntryRegInput = NIL;
      IF TRUE THEN
        reg_branch_value = COPY source_sym.reg;
      ELSE
        reg_branch_value = NIL;
      END
      MUTABLE reg: ?SymbolEntryRegInput = reg_branch_value;
      IF reg EXISTS AS reg_value THEN
        IF symbolEntryRegInput__token(reg_value) THEN
          MUTABLE line_num = symbolEntryRegInput__token(reg_value)?.line;
          IF !(line_num) THEN
            RETURN NIL;
          END
          MUTABLE src_line = (src_value.split("\n")[(UNWRAP (line_num) - 1)] OR_ELSE "");
          MUTABLE search_offset = (UNWRAP (symbolEntryRegInput__token(reg_value)).column - 1);
          MUTABLE match: ?CompilerRegexScanner = NIL;
          IF src_line.substr(search_offset, (src_line.length() - search_offset)) != NIL THEN
            match = COPY compilerRegexMatchData(((src_line.substr(search_offset, (src_line.length() - search_offset)))?), compilerRegexCompile("@(?:shared:atomic|atomic:shared)"));
          END
          IF match EXISTS AS match_value THEN
            MUTABLE start_col = ((search_offset + match_value.begin(0)) + 1);
            RETURN TRY (fix__new(TRY (capabilityAuditSession__fix_description(rtoc_self_view, :MIGRATE_ATOMIC_ESCAPE, CAST({:name: DiagnosticKwValue{ StringValue: COPY source_name }} AS {String@symbol}?DiagnosticKwValue))), [edit__new(span__new(NIL, line_num, start_col, compilerRegexCapture(match_value, 0).codepointCount()), "@shared:locked")], :interactive));
          ELSE
            RETURN NIL;
          END
        ELSE
          RETURN NIL;
        END
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN capabilityAuditSession__auto_rank_candidates(self: CapabilityAuditSession, ops: [Set]String@symbol) RETURNS ![]AutoCandidate
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (FALSE OR ops.empty?()) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_3: []AutoCandidate = List[]; rtoc_empty_list_3 } ) AS []AutoCandidate);
    END
    MUTABLE agg: {String@symbol}AutoCandidateStat = {};
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < ops.length() DO
      MUTABLE entry: ?{String@symbol}Any@multiowned = COPY (CAST({:ADD: CAST({:default: :Int64, :alts: [:Float64]} AS {String@symbol}Any@multiowned), :CONCAT: CAST({:default: :String, :alts: List[]} AS {String@symbol}Any@multiowned), :SUB: CAST({:default: :Int64, :alts: [:Float64]} AS {String@symbol}Any@multiowned), :MUL: CAST({:default: :Int64, :alts: [:Float64]} AS {String@symbol}Any@multiowned), :DIV: CAST({:default: :Float64, :alts: [:Int64], :notes: {:Int64: "integer division \u{2014} TRUNCATES toward zero"}} AS {String@symbol}Any@multiowned), symbol("MOD"): CAST({:default: :Int64, :alts: List[]} AS {String@symbol}Any@multiowned), :EQ: CAST({:default: :Int64, :alts: [:Float64, :String]} AS {String@symbol}Any@multiowned), :NEQ: CAST({:default: :Int64, :alts: [:Float64, :String]} AS {String@symbol}Any@multiowned), :LT: CAST({:default: :Int64, :alts: [:Float64, :String]} AS {String@symbol}Any@multiowned), :GT: CAST({:default: :Int64, :alts: [:Float64, :String]} AS {String@symbol}Any@multiowned), :LTE: CAST({:default: :Int64, :alts: [:Float64, :String]} AS {String@symbol}Any@multiowned), :GTE: CAST({:default: :Int64, :alts: [:Float64, :String]} AS {String@symbol}Any@multiowned), symbol("AND"): CAST({:default: :Bool, :alts: List[]} AS {String@symbol}Any@multiowned), symbol("OR"): CAST({:default: :Bool, :alts: List[]} AS {String@symbol}Any@multiowned)} AS {String@symbol}{String@symbol}Any@multiowned))[ops[rtoc_idx]];
      IF !(entry) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE default: String@symbol = COPY CAST(entry[:default] AS String@symbol);
      MUTABLE alts: []String@symbol = CAST((entry[:alts] OR_ELSE List[]) AS []String@symbol);
      MUTABLE notes: {String@symbol}String = CAST((entry[:notes] OR_ELSE {}) AS {String@symbol}String);
      MUTABLE ranked = ([default] + alts);
      MUTABLE rtoc_idx_n3 = 0;
      WHILE rtoc_idx_n3 < ranked.length() DO
          MUTABLE stat: AutoCandidateStat = (agg[ranked[rtoc_idx_n3]] OR_ELSE AutoCandidateStat{ count: 0, rank_sum: 0, notes: List[] });
          stat.count = (stat.count + 1);
          stat.rank_sum = (stat.rank_sum + rtoc_idx_n3);
          IF notes[ranked[rtoc_idx_n3]] EXISTS AS rtoc_note THEN
              &stat.notes.append(COPY rtoc_note);
          END
          agg[ranked[rtoc_idx_n3]] = stat;
        rtoc_idx_n3 = rtoc_idx_n3 + 1;
      END
    rtoc_idx = rtoc_idx + 1;
    END
    MUTABLE n_ops = ops.size();
    MUTABLE intersection = agg |> WHERE (_._1.count == n_ops);
    MUTABLE ordered = intersection |> ORDER_BY _._1.rank_sum;
    RETURN ordered.keys() |> SELECT AutoCandidate{ type_sym: COPY CAST(_ AS String@symbol), note: COPY ((UNWRAP (ordered[_])).notes |> DISTINCT _).first() };
}
END
PUB STRUCT AutoCandidateStat {
  count: Int64,
  rank_sum: Int64,
  notes: []String
}
PRIVATE FN capabilityAuditSession__build_auto_candidate_fix(self: CapabilityAuditSession, slot: Slot, type_sym: String@symbol, note: ?String, position: Int64) RETURNS !?Fix
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE auto_tok: ?Token@multiowned = capabilityAuditSession__auto_token_for(rtoc_self_view, slot);
    IF auto_tok EXISTS AS auto_tok_value THEN
      MUTABLE type_str = COPY CAST(type_sym AS String);
      RETURN TRY (fix__new(capabilityAuditSession__fix_description(rtoc_self_view, :PIN_AUTO_SLOT, CAST({:position: DiagnosticKwValue{ Int64Value: position }, :label: ruby_wrap_optional_String_DiagnosticKwValue__capability_audit_session(capabilityAuditSession__auto_slot_label(rtoc_self_view, slot)), :type: DiagnosticKwValue{ StringValue: COPY type_str }, :note: DiagnosticKwValue{ StringValue: COPY IF note != NIL THEN
        " ${note}"
      ELSE
        ""
      END }} AS {String@symbol}?DiagnosticKwValue)), [edit__new(span__new(NIL, auto_tok_value.line, auto_tok_value.column, "Auto".codepointCount()), type_str)], :interactive));
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN capabilityAuditSession__build_auto_op_evidence_block(self: CapabilityAuditSession, ops: [Set]String@symbol, candidates: []AutoCandidate) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (candidates.length() == 0) THEN
      RETURN "";
    END
    MUTABLE op_list = ((ops |> SELECT COPY _) |> ORDER_BY _).join(", ");
    MUTABLE msg = "\n  In the body, the binding is used in operator(s): ${op_list}.\n";
    msg = (msg $+ "  Suggested fixes:\n");
    MUTABLE idx = 0;
    WHILE (idx < candidates.length()) DO
      MUTABLE candidate: ?AutoCandidate = COPY candidates[idx];
      MUTABLE type_sym = candidate?.type_sym;
      MUTABLE note: ?String = UNWRAP (candidate).note;
      MUTABLE label = "";
      IF (idx == 0) THEN
        label = "(recommended)";
      END
      MUTABLE line = "    ${(idx + 1).toString()}. ${label.ljust(15)} ${type_sym}";
      IF note EXISTS AS note_value THEN
        line = (line $+ "  -- ${note_value}");
      END
      msg = (msg $+ line);
      msg = (msg $+ "\n");
      idx = (idx + 1);
    END
    RETURN msg;
}
END
PRIVATE FN capabilityAuditSession__emit_auto_resolved_finding_mut(MUTABLE self: CapabilityAuditSession, resolution: Resolution) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE slot = COPY resolution.slot;
    IF (TRUE AND (slot.shape != NIL)) THEN
      RETURN;
    END
    MUTABLE type_str = capabilityAuditSession__auto_type_source_form(rtoc_self_view, resolution.type);
    MUTABLE label: ?String = TRY (capabilityAuditSession__auto_slot_label(rtoc_self_view, slot));
    MUTABLE auto_tok: ?Token@multiowned = capabilityAuditSession__auto_token_for(rtoc_self_view, slot);
    TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, (auto_tok OR_ELSE slot.decl_node), :type, TRY (capabilityAuditSession__build_auto_replace_fixes(rtoc_self_view, CAST(auto_tok AS ?Token), type_str)), NIL, :AUTO_INFERRED_TYPE, :info, FALSE, CAST({:label: label, :type: type_str} AS {String@symbol}Any)));
}
END
PRIVATE FN capabilityAuditSession__emit_auto_shape_resolved_finding_mut(MUTABLE self: CapabilityAuditSession, decl: AutoConstraintCollectorSlotDeclNode, slot: Slot) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !((decl IS_A VarDecl OR decl IS_A BindExpr)) THEN
      RETURN;
    END
    IF !(autoConstraintCollectorSlotDeclNode__type(decl)) THEN
      RETURN;
    END
    IF type__auto?( UNWRAP (autoConstraintCollectorSlotDeclNode__type(decl))) THEN
      RETURN;
    END
    MUTABLE type_str = capabilityAuditSession__auto_type_source_form(rtoc_self_view, castTypeToAutoConstraintCollectorObservedType__capability_audit_session( UNWRAP (autoConstraintCollectorSlotDeclNode__type(decl))));
    MUTABLE name: String = "";
    IF TRUE THEN
      PARTIAL MATCH decl START
        AutoConstraintCollectorSlotDeclNode.FunctionDefMultiowned AS item -> name = COPY item.name;,
        AutoConstraintCollectorSlotDeclNode.VarDecl AS item -> name = COPY item.name;,
        AutoConstraintCollectorSlotDeclNode.BindExpr AS item -> name = COPY item.name;,
        DEFAULT -> name = "";
      END
    ELSE
      name = "<binding>";
    END
    MUTABLE auto_tok: ?Token@multiowned = capabilityAuditSession__auto_token_for(rtoc_self_view, slot);
    TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, (auto_tok OR_ELSE decl), :type, TRY (capabilityAuditSession__build_auto_replace_fixes(rtoc_self_view, CAST(auto_tok AS ?Token), type_str)), NIL, :AUTO_INFERRED_BINDING_TYPE, :info, FALSE, CAST({:name: name, :type: type_str} AS {String@symbol}Any)));
}
END
PRIVATE FN capabilityAuditSession__build_auto_replace_fixes(self: CapabilityAuditSession, auto_tok: ?Token, type_str: String) RETURNS ![]Fix
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF auto_tok EXISTS AS auto_tok_value THEN
      RETURN CAST([TRY (fix__new(TRY (capabilityAuditSession__fix_description(rtoc_self_view, :REPLACE_AUTO_WITH_INFERRED, CAST({:type: DiagnosticKwValue{ StringValue: COPY type_str }} AS {String@symbol}?DiagnosticKwValue))), [edit__new(span__new(NIL, auto_tok_value.line, auto_tok_value.column, "Auto".codepointCount()), type_str)], :auto))] AS []Fix);
    ELSE
      RETURN CAST(( { MUTABLE rtoc_empty_list_4: []Fix = List[]; rtoc_empty_list_4 } ) AS []Fix);
    END
}
END
PRIVATE FN capabilityAuditSession__emit_auto_ambiguity_finding_mut(MUTABLE self: CapabilityAuditSession, ambiguity: Ambiguity, op_evidence: {AutoSlotId}[Set]String@symbol) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE slot = COPY ambiguity.slot;
    MUTABLE label: ?String = TRY (capabilityAuditSession__auto_slot_label(rtoc_self_view, slot));
    MUTABLE observed = COPY ambiguity.observed_types;
    MUTABLE observed_strs = observed |> SELECT capabilityAuditSession__auto_type_source_form(rtoc_self_view, _);
    MUTABLE message = TRY (capabilityAuditSession__build_auto_ambiguity_message(rtoc_self_view, label?, observed_strs, slot));
    MUTABLE slot_id: ?AutoSlotId@multiowned = capabilityAuditSession__slot_id_for(rtoc_self_view, slot);
    MUTABLE ops: [Set]Any = Set[];
    IF slot_id EXISTS AS slot_id_value THEN
      ops = ((op_evidence[slot_id_value] OR_ELSE Set[]));
    ELSE
      ops = Set[];
    END
    MUTABLE candidates = TRY (capabilityAuditSession__auto_rank_candidates(rtoc_self_view, ops));
    IF !((candidates.length() == 0)) THEN
      message = (message $+ capabilityAuditSession__build_auto_op_evidence_block(rtoc_self_view, ops, candidates));
    END
    MUTABLE fixes = List[];
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < candidates.length() DO
      MUTABLE fix: ?Fix@multiowned = TRY (capabilityAuditSession__build_auto_candidate_fix(rtoc_self_view, slot, candidates[rtoc_idx]?.type_sym, candidates[rtoc_idx]?.note, (rtoc_idx + 1)));
      IF fix EXISTS AS fix_value THEN
          &fixes.append(fix_value);
      END
    rtoc_idx = rtoc_idx + 1;
    END
    MUTABLE auto_tok: ?Token@multiowned = capabilityAuditSession__auto_token_for(rtoc_self_view, slot);
    TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, (auto_tok OR_ELSE slot.decl_node), :type, fixes, NIL, :AUTO_AMBIGUOUS_TYPE, :error, FALSE, CAST({:detail: message} AS {String@symbol}Any)));
}
END
PRIVATE FN capabilityAuditSession__emit_auto_unresolved_finding_mut(MUTABLE self: CapabilityAuditSession, slot: Slot, op_evidence: {AutoSlotId}[Set]String@symbol) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE label: ?String = TRY (capabilityAuditSession__auto_slot_label(rtoc_self_view, slot));
    MUTABLE base_msg = "Cannot infer type for ${(label OR_ELSE "")} \u{2014} no observed uses to drive inference.";
    MUTABLE slot_id: ?AutoSlotId@multiowned = capabilityAuditSession__slot_id_for(rtoc_self_view, slot);
    MUTABLE ops: [Set]Any = Set[];
    IF slot_id EXISTS AS slot_id_value THEN
      ops = ((op_evidence[slot_id_value] OR_ELSE Set[]));
    ELSE
      ops = Set[];
    END
    MUTABLE candidates = TRY (capabilityAuditSession__auto_rank_candidates(rtoc_self_view, ops));
    MUTABLE message = COPY base_msg;
    IF (candidates.length() == 0) THEN
      message = (message $+ " Replace `Auto` with a concrete type, or remove the unused declaration.");
    ELSE
      message = (message $+ COPY capabilityAuditSession__build_auto_op_evidence_block(rtoc_self_view, ops, candidates));
    END
    MUTABLE fixes = List[];
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < candidates.length() DO
      MUTABLE fix: ?Fix@multiowned = TRY (capabilityAuditSession__build_auto_candidate_fix(rtoc_self_view, slot, candidates[rtoc_idx]?.type_sym, candidates[rtoc_idx]?.note, (rtoc_idx + 1)));
      IF fix EXISTS AS fix_value THEN
          &fixes.append(fix_value);
      END
    rtoc_idx = rtoc_idx + 1;
    END
    MUTABLE auto_tok: ?Token@multiowned = capabilityAuditSession__auto_token_for(rtoc_self_view, slot);
    TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, (auto_tok OR_ELSE slot.decl_node), :type, fixes, NIL, :AUTO_UNRESOLVED_TYPE, :error, FALSE, CAST({:detail: message} AS {String@symbol}Any)));
}
END
PRIVATE FN capabilityAuditSession__slot_id_for(self: CapabilityAuditSession, slot: Slot) RETURNS ?AutoSlotId@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE kind = COPY slot.kind;
    IF ((kind == :param) AND !((((slot.fn_name != NIL) AND (slot.index != NIL))))) THEN
      RETURN NIL;
    END
    IF ((kind == :return) AND !(slot.fn_name)) THEN
      RETURN NIL;
    END
    IF (kind == :param) THEN
      RETURN autoSlotId__param(UNWRAP (slot.fn_name), UNWRAP (slot.index));
    ELSE_IF (kind == :return) THEN
      RETURN autoSlotId__return(UNWRAP (slot.fn_name));
    ELSE_IF (kind == :local) THEN
      RETURN autoSlotId__local(castAutoConstraintCollectorDeclarationNodeToLocatable__capability_audit_session(castAutoConstraintCollectorSlotDeclNodeToAutoConstraintCollectorDeclarationNode__capability_audit_session(slot.decl_node)));
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN capabilityAuditSession__auto_type_source_form(self: CapabilityAuditSession, type: AutoConstraintCollectorObservedType) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF type IS_A Type AS type_as_type THEN
      MUTABLE sym = type__resolved(type_as_type);
      RETURN COPY CAST(sym AS String);
    ELSE
      RETURN COPY CAST(type AS String);
    END
}
END
PRIVATE FN capabilityAuditSession__auto_slot_label(self: CapabilityAuditSession, slot: Slot) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (TRUE AND (slot.shape != NIL)) THEN
      RETURN capabilityAuditSession__auto_shape_slot_label(rtoc_self_view, slot);
    END
    IF (slot.kind == :param) THEN
      RETURN capabilityAuditSession__auto_param_slot_label(rtoc_self_view, slot);
    ELSE_IF (slot.kind == :return) THEN
      RETURN "return type of `${UNWRAP (slot.fn_name)}`";
    ELSE_IF (slot.kind == :local) THEN
      RETURN capabilityAuditSession__auto_local_slot_label(rtoc_self_view, slot);
    ELSE
      panic("auto_slot_label: unrecognized slot kind {}");
    END
}
END
PRIVATE FN capabilityAuditSession__auto_shape_slot_label(self: CapabilityAuditSession, slot: Slot) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE name: String = "";
    MATCH castAutoConstraintCollectorSlotDeclNodeToAutoConstraintCollectorDeclarationNode__capability_audit_session(slot.decl_node) START
      AutoConstraintCollectorDeclarationNode.VarDecl AS item ->
        name = COPY item.name;,
      AutoConstraintCollectorDeclarationNode.BindExpr AS item ->
        name = COPY item.name;,
    END
    IF (slot.shape == :list_element) THEN
      RETURN "element type of list `${name.toString()}`";
    ELSE_IF (slot.shape == :map_key) THEN
      RETURN "key type of map `${name}`";
    ELSE_IF (slot.shape == :map_value) THEN
      RETURN "value type of map `${name}`";
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN capabilityAuditSession__auto_param_slot_label(self: CapabilityAuditSession, slot: Slot) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fn: FunctionDef = COPY CAST(slot.decl_node AS FunctionDef);
    MUTABLE param = COPY UNWRAP (fn.params[UNWRAP (slot.index)]);
    RETURN "parameter '${param.name}' of `${(slot.fn_name OR_ELSE "")}`";
}
END
PRIVATE FN capabilityAuditSession__auto_local_slot_label(self: CapabilityAuditSession, slot: Slot) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE name: String = "";
    MATCH castAutoConstraintCollectorSlotDeclNodeToAutoConstraintCollectorDeclarationNode__capability_audit_session(slot.decl_node) START
      AutoConstraintCollectorDeclarationNode.VarDecl AS item ->
        name = COPY item.name;,
      AutoConstraintCollectorDeclarationNode.BindExpr AS item ->
        name = COPY item.name;,
    END
    RETURN "local '${name}'";
}
END
PRIVATE FN capabilityAuditSession__auto_token_for(self: CapabilityAuditSession, slot: Slot) RETURNS ?Token
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN CAST(COPY slot.auto_token AS ?Token);
}
END
PRIVATE FN capabilityAuditSession__build_auto_ambiguity_message(self: CapabilityAuditSession, label: String, observed_strs: []String, slot: Slot) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE types_list = observed_strs.join(", ");
    MUTABLE msg = "Ambiguous Auto for ${label}: observed as ${types_list}.\n";
    msg = (msg $+ "  Option 1 (recommended): pin one concrete type at the\n");
    msg = (msg $+ "    declaration and convert at the divergent sites. The\n");
    msg = (msg $+ "    candidate types observed are: ${types_list}.\n");
    msg = (msg $+ "    Pick the one whose semantics match your intent and\n");
    msg = (msg $+ "    convert the others (e.g. `Int64.toString(x)`,\n");
    msg = (msg $+ "    `Int.fromString(s) OR_ELSE RAISE`).\n");
    msg = (msg $+ "  Option 2: if these types do not have an obvious\n");
    msg = (msg $+ "    conversion path, restructure the call sites so a\n");
    msg = (msg $+ "    single concrete type flows through.\n");
    IF ((slot.kind == :param) OR (slot.kind == :return)) THEN
      MUTABLE union_name: String = "";
      IF (slot.kind == :param) THEN
        MUTABLE fn: FunctionDef = COPY CAST(slot.decl_node AS FunctionDef);
        union_name = ((UNWRAP (fn.params[UNWRAP (slot.index)])).name).capitalize();
      ELSE
        union_name = "Result";
      END
      MUTABLE variant_parts: []String = ( { MUTABLE rtoc_empty_list_5: []String = List[]; rtoc_empty_list_5 } );
      MUTABLE i: Int64 = 0;
      WHILE (i < observed_strs.length()) DO
        &variant_parts.append("Variant${i.toString()}: ${UNWRAP (observed_strs[i])}");
        i = (i + 1);
      END
      MUTABLE variants = variant_parts.join(", ");
      msg = (msg $+ "  Option 3 (last resort): if you genuinely need to accept\n");
      msg = (msg $+ "    multiple types, define a union explicitly:\n");
      msg = (msg $+ "      UNION ${union_name} { ${variants} }\n");
      msg = (msg $+ "    Auto does NOT auto-create unions.\n");
    END
    RETURN msg;
}
END
PRIVATE FN capabilityAuditSession__scope_stack_for_helper(self: CapabilityAuditSession) RETURNS []Scope@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (capabilityAuditSession__scope_stack(rtoc_self_view));
}
END
PRIVATE FN capabilityAuditSession__current_scope(self: CapabilityAuditSession) RETURNS !Scope@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN KEEP UNWRAP (((capabilityAuditSession__scope_stack_for_helper(rtoc_self_view))).last());
}
END
PRIVATE FN capabilityAuditSession__lookup_scope_for(MUTABLE self: CapabilityAuditSession, name: String) RETURNS !?Scope@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_reverse_items_6: []Scope@multiowned = (capabilityAuditSession__scope_stack_for_helper(rtoc_self_view));
    MUTABLE rtoc_reverse_i_7 = rtoc_reverse_items_6.length() - 1;
    WHILE rtoc_reverse_i_7 >= 0 DO
    IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_8 = ((rtoc_reverse_items_6[rtoc_reverse_i_7])?);
    scope__entry?(&rtoc_local_receiver_8, name) } THEN
        RETURN KEEP (rtoc_reverse_items_6[rtoc_reverse_i_7])?;
    END
    rtoc_reverse_i_7 = rtoc_reverse_i_7 - 1;
    END
    RETURN NIL;
}
END
PRIVATE FN capabilityAuditSession__resolve_variable_scope(MUTABLE self: CapabilityAuditSession, name: String) RETURNS !?Scope@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE scope = TRY (capabilityAuditSession__current_scope(rtoc_self_view));
    IF scope__entry?(&scope, name) THEN
      RETURN scope;
    ELSE
      MUTABLE outer_scope: ?Scope@multiowned = TRY (capabilityAuditSession__lookup_scope_for(&rtoc_self_view, name));
      IF outer_scope EXISTS AS outer_scope_value THEN
        IF functionSignature__unwrap(X{ Type: COPY TRY (scope__resolve_type(outer_scope_value, name)) }) THEN
          RETURN outer_scope_value;
        END
        IF (outer_scope_value.depth == 0) THEN
          RETURN outer_scope_value;
        END
        RETURN NIL;
      ELSE
        RETURN NIL;
      END
    END
}
END
PRIVATE FN capabilityAuditSession__lookup_type_schema(self: CapabilityAuditSession, name: String@symbol) RETURNS !?SchemaValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE base_name = symbol((compilerRegexReplaceFirst((CAST(name AS String)), compilerRegexCompile("<.*>$"), "")));
    MUTABLE rtoc_reverse_items_9: []Scope@multiowned = (capabilityAuditSession__scope_stack_for_helper(rtoc_self_view));
    MUTABLE rtoc_reverse_i_10 = rtoc_reverse_items_9.length() - 1;
    WHILE rtoc_reverse_i_10 >= 0 DO
      MUTABLE schema = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_11 = ((rtoc_reverse_items_9[rtoc_reverse_i_10])?);
      TRY (scope__resolve_type_definition(rtoc_local_receiver_11, base_name)) };
      IF schema THEN
          RETURN schema;
      END
    rtoc_reverse_i_10 = rtoc_reverse_i_10 - 1;
    END
    RETURN NIL;
}
END
PRIVATE FN capabilityAuditSession__all_known_type_names(self: CapabilityAuditSession) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE names = List[];
    FOR _ IN (capabilityAuditSession__scope_stack_for_helper(rtoc_self_view)) DO
    ruby_array_concat_Any__capability_audit_session(names, CAST(_.types.keys() |> SELECT _.toString() AS []Any));
    END
    RETURN CAST((names |> DISTINCT _) AS []Any);
}
END
PRIVATE FN capabilityAuditSession__with_new_scope<RESULT>(self: CapabilityAuditSession, scope: ?Scope = NIL, blk: FN() -> RESULT) RETURNS !RESULT
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE new_scope = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_13: ?Scope = NIL;
    IF (scope == NIL) THEN
      rtoc_ternary_value_13 = scope__new();
    ELSE
      rtoc_ternary_value_13 = COPY scope;
    END
    rtoc_ternary_value_13? };
  MUTABLE stack: []Scope@multiowned = (capabilityAuditSession__scope_stack_for_helper(rtoc_self_view));
  # Ruby's ensure pops capabilityAuditSession#scope_stack, which builds a fresh
  # [semantic_root_scope] on every call -- the pop is a no-op on a temporary,
  # and DEFER may not allocate one.
  new_scope.depth = stack.length();
  &stack.push(new_scope);
  RETURN blk();
}
END
