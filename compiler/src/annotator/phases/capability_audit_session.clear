PRIVATE FN capabilityAuditSession__emit_reentrant_error_mut(self: CapabilityAuditSession, fn_node: FunctionDef, code: String@symbol) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE arrow = COPY fn_node.arrow_token;
    MUTABLE fix = NIL;
    IF arrow THEN
      fix = TRY (fix__new(capabilityAuditSession__fix_description(rtoc_self_view, :ADD_EFFECTS_REENTRANT), [edit__new(span__new(NIL, arrow.line, arrow.column, 0), "EFFECTS REENTRANT ")], :auto));
    END
    IF !(fix) THEN
      RETURN capabilityAuditSession__error_mut(rtoc_self_view, fn_node, CodeOrMessage{ SymbolValue: COPY code }, [], {:name: fn_node.name});
    END
    capabilityAuditSession__fixable_mut(rtoc_self_view, fn_node, :reentrance, [fix], NIL, code, :error, FALSE, {:name: fn_node.name});
}
END
