PRIVATE FN capabilityAuditSession__function_needs_runtime_directly?(self: CapabilityAuditSession, name: String, MUTABLE fn_node: FunctionDef) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
