    MUTABLE callees: [Set]String = ((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[_] OR_ELSE CAST(panic("missing hash key") AS [Set]String));
    IF alloc_fault[_] THEN
      CONTINUE;
    END
    MUTABLE prop = ((TRY (capabilityAuditSession__function_propagating_callees(&rtoc_self_view)))[_] OR_ELSE callees);
    IF prop |> ANY alloc_fault[_] THEN
          alloc_fault[_] = TRUE;
          changed = TRUE;
    END
      };
    END
    fn_nodes.keys() |> EACH {
    MUTABLE fn_node: Any = (fn_nodes[_] OR_ELSE panic("missing hash key"));
    MUTABLE ef = ((error_fallible[_] == TRUE));
    MUTABLE af = ((alloc_fault[_] == TRUE));
    fn_node.error_fallible = ef;
    fn_node.alloc_fault = af;
    fn_node.can_fail = (ef OR af);
    };
    RETURN NIL;
}
END
PRIVATE FN capabilityAuditSession__enforce_fallible_returns_mut(MUTABLE self: CapabilityAuditSession) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = function_node_map();
    IF !(fallible_returns_enforce) THEN
      RETURN;
    END
    fn_nodes.keys() |> EACH {
    MUTABLE fn_node: Any = (fn_nodes[_] OR_ELSE panic("missing hash key"));
    IF !(functionSignature__error_fallible(fn_node)) THEN
      CONTINUE;
    END
    IF (_ == name) THEN
        CONTINUE;
    END
    MUTABLE has_catch = capabilityAuditSession__function_has_catch_clauses?(rtoc_self_view, fn_node);
    MUTABLE has_default = capabilityAuditSession__function_has_default_catch?(rtoc_self_view, fn_node);
    IF (has_catch OR has_default) THEN
        CONTINUE;
    END
    IF !(fn_node.explicit_return_type()) THEN
        CONTINUE;
    END
    MUTABLE ret = functionSignature__return_type(fn_node);
    IF !(ret) THEN
        CONTINUE;
    END
    MUTABLE ret_t = ret;
    IF ret_t.error_union?() THEN
        CONTINUE;
    END
    IF (TRUE AND type__tense?(ret_t)) THEN
        CONTINUE;
    END
    MUTABLE hint = capabilityAuditSession__fallibility_hint_for(&rtoc_self_view, _);
    MUTABLE return_type = ret_t.resolved();
    MUTABLE tok = IF respondsTo?(fn_node, "return_type_token") THEN
        fn_node.return_type_token()
      ELSE
        NIL
      END;
    IF tok THEN
        MUTABLE edits = [edit__new(span__new(NIL, tok.line(), tok.column(), 0), "!")];
        IF fixCollector__fallibility_propagation_enabled?() THEN
          edits = ruby_array_concat_Edit(edits, CAST(capabilityAuditSession__fallibility_call_site_edits(rtoc_self_view, _) AS []Edit));
        END
        MUTABLE description_key = IF fixCollector__fallibility_propagation_enabled?() THEN
          :PROPAGATE_ERROR_UNION_TO_CALLERS
        ELSE
          :ADD_ERROR_UNION_TO_RETURN
        END;
        MUTABLE fixes = [TRY (fix__new(capabilityAuditSession__fix_description(rtoc_self_view, description_key), edits, :auto))];
        capabilityAuditSession__fixable_mut(rtoc_self_view, fn_node, :type, fixes, NIL, :FALLIBLE_RETURN_NEEDS_ERROR_UNION, :error, FALSE, {:fn: _, :hint: hint, :return_type: return_type});
    ELSE
        capabilityAuditSession__error_mut(rtoc_self_view, fn_node, CodeOrMessage{ SymbolValue: :FALLIBLE_RETURN_NEEDS_ERROR_UNION }, [], {:fn: _, :hint: hint, :return_type: return_type});
    END
    };
}
END
PRIVATE FN capabilityAuditSession__fallibility_call_site_edits(self: CapabilityAuditSession, name: String) RETURNS ![]Edit
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE summary: ?FunctionBodySummary = COPY (TRY (capabilityAuditSession__function_body_summaries(rtoc_self_view)))[name];
    IF summary EXISTS AS summary_value THEN
      RETURN summary_value.call_site_facts |> REDUCE(List[]) {
    IF !(_.propagates_failure) THEN
          CONTINUE;
    END
    IF !(capabilityAuditSession__fallible_call_site_fact?(rtoc_self_view, _)) THEN
          CONTINUE;
    END
    MUTABLE range = (KEEP _.node).source_range();
    IF ((token__start_line(range) <= 0) OR (span__end_line(range) <= 0)) THEN
          CONTINUE;
    END
    &acc.append(edit__new(span__new(range.file(), token__start_line(range), token__start_column(range), 0), "TRY ("));
    &acc.append(edit__new(span__new(range.file(), span__end_line(range), range.end_column(), 0), ")"));
    acc
      };
    ELSE
      RETURN CAST(( { MUTABLE rtoc_empty_list_18: []Edit = List[]; rtoc_empty_list_18 } ) AS []Edit);
    END
}
END
PRIVATE FN capabilityAuditSession__fallible_call_site_fact?(self: CapabilityAuditSession, fact: CallSiteFact) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE node = COPY KEEP fact.node;
    IF (respondsTo?(node, "error_union_type") AND node.error_union_type()) THEN
      RETURN TRUE;
    END
    MUTABLE signature: ?FunctionSignature@multiowned = functionSignature__unwrap(node.matched_signature());
    IF type__error_union?((IF signature != NIL THEN
      functionSignature__return_type(signature)
    ELSE
      NIL
    END)) THEN
      RETURN TRUE;
    END
    MUTABLE intrinsic = node.matched_stdlib_def();
    IF (IF intrinsic != NIL THEN
      functionSignature__recoverable_result?(intrinsic)
    ELSE
      NIL
    END) THEN
      RETURN TRUE;
    END
    MUTABLE callee: ?FunctionDef@multiowned = COPY (TRY (capabilityAuditSession__semantic_function_nodes(rtoc_self_view)))[fact.callee_name];
    RETURN ((callee != NIL) AND (callee.error_fallible == TRUE));
}
END
PRIVATE FN capabilityAuditSession__fallibility_hint_for(MUTABLE self: CapabilityAuditSession, name: String) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = function_node_map();
    IF TRY (capabilityAuditSession__function_raises_directly?(rtoc_self_view, name)) THEN
      RETURN "raises directly via RAISE";
    END
    MUTABLE callees = ((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[name] OR_ELSE List[]);
    MUTABLE fallible_callee = callees |> FIND (IF fn_nodes[_] != NIL THEN
      { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_19 = (fn_nodes[_]);
    functionSignature__can_fail(rtoc_local_receiver_19) }
    ELSE
      NIL
    END);
    IF fallible_callee THEN
      RETURN "calls fallible '${fallible_callee}'";
    END
    RETURN "transitively";
}
END
PRIVATE FN capabilityAuditSession__mark_fn_value_references_mut(self: CapabilityAuditSession) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fn_nodes = function_node_map();
    FOR _ IN (TRY (capabilityAuditSession__function_body_summaries(rtoc_self_view))).values() DO
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < _.escape_nodes.length() DO
      IF !(_.escape_nodes[rtoc_idx] IS_A Identifier) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !(capabilityAuditSession__function_value_reference?(rtoc_self_view, _.escape_nodes[rtoc_idx])) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE fn = fn_nodes[_.escape_nodes[rtoc_idx].name()];
      IF !(fn) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      fn.fn_value_ref = TRUE;
      fn.can_fail = TRUE;
    rtoc_idx = rtoc_idx + 1;
    END
    END
}
END
PRIVATE FN capabilityAuditSession__function_value_reference?(self: CapabilityAuditSession, node: Identifier) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (node.fn_ref == TRUE);
}
END
PRIVATE FN capabilityAuditSession__compute_fsm_eligibility_mut(self: CapabilityAuditSession) RETURNS !{Any@multiowned}Any@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fn_nodes = function_node_map();
    fn_nodes.keys() |> EACH {
    MUTABLE fn_node: Any = (fn_nodes[_] OR_ELSE panic("missing hash key"));
    MUTABLE effs = (fn_node.effects() OR Set[]);
    MUTABLE reason = NIL;
    IF (effs.contains?(reentrant) OR fn_node.plain_reentrant?()) THEN
        reason = :reentrant;
    ELSE_IF effs.contains?(extern_value) THEN
        reason = :extern;
    ELSE_IF !(effs |> ANY suspends_family.contains?(_)) THEN
        reason = :no_suspends;
    END
    fn_node.fsm_eligible = FALSE;
    fn_node.fsm_ineligible_reason = reason;
    };
    RETURN NIL;
}
END
PRIVATE FN capabilityAuditSession__enumerate_fsm_suspend_points_mut(self: CapabilityAuditSession) RETURNS !{Any@multiowned}Any@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fn_nodes = function_node_map();
    MUTABLE summaries = TRY (capabilityAuditSession__function_body_summaries(rtoc_self_view));
    fn_nodes.keys() |> EACH {
    MUTABLE fn_node: Any = (fn_nodes[_] OR_ELSE panic("missing hash key"));
    IF !(fn_node.fsm_eligible()) THEN
      CONTINUE;
    END
    fn_node.fsm_suspend_points = summaries[fn_node.name()]?.suspend_points;
    };
    RETURN NIL;
}
END
PRIVATE FN capabilityAuditSession__finalize_async_execution_shapes_mut(MUTABLE self: CapabilityAuditSession, program_node: Program) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE _ = COPY program_node;
    FOR _ IN (TRY (capabilityAuditSession__async_body_facts(rtoc_self_view))) DO
    MUTABLE node = COPY _.node;
    MUTABLE body_scan = COPY _.summary;
    IF (node IS_A BgBlock) THEN
        capabilityAuditSession__assign_bg_spawn_shape_mut(&rtoc_self_view, &node, body_scan);
        capabilityAuditSession__assign_async_stack_tier_mut(&rtoc_self_view, node, body_scan.callees, node.stack_size(), node.can_smash(), node);
    ELSE_IF (node IS_A BgStreamBlock) THEN
        capabilityAuditSession__assign_bg_spawn_shape_mut(&rtoc_self_view, &node, body_scan);
        capabilityAuditSession__assign_async_stack_tier_mut(&rtoc_self_view, node, body_scan.callees, node.stack_size(), FALSE, node);
    ELSE_IF (node IS_A DoBranch) THEN
        capabilityAuditSession__assign_async_stack_tier_mut(&rtoc_self_view, node, body_scan.callees, node.stack_size(), node.can_smash(), _.validation_node);
    END
    END
}
END
PRIVATE FN capabilityAuditSession__assign_bg_spawn_shape_mut(MUTABLE self: CapabilityAuditSession, MUTABLE node: AsyncSpawnNode, body_scan: BodyScanSummary) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (TRUE AND (MATCH node START AsyncSpawnNode.BgBlock AS item -> item.stack_size, AsyncSpawnNode.BgStreamBlock AS item -> item.stack_size END)) THEN
      MATCH node START
        AsyncSpawnNode.BgBlock AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.spawn_form = :stackful;
          node = AsyncSpawnNode{ BgBlock: item_mutable };,
        AsyncSpawnNode.BgStreamBlock AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.spawn_form = :stackful;
          node = AsyncSpawnNode{ BgStreamBlock: item_mutable };,
      END
      MATCH node START
        AsyncSpawnNode.BgBlock AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.fsm_ineligible_reason = :explicit_stack_size;
          node = AsyncSpawnNode{ BgBlock: item_mutable };,
        AsyncSpawnNode.BgStreamBlock AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.fsm_ineligible_reason = :explicit_stack_size;
          node = AsyncSpawnNode{ BgStreamBlock: item_mutable };,
      END
    ELSE
      MUTABLE decision = capabilityAuditSession__bg_spawn_form_for(&rtoc_self_view, body_scan.callees, body_scan.has_fnptr_call);
      MATCH node START
        AsyncSpawnNode.BgBlock AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.spawn_form = COPY decision.spawn_form;
          node = AsyncSpawnNode{ BgBlock: item_mutable };,
        AsyncSpawnNode.BgStreamBlock AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.spawn_form = COPY decision.spawn_form;
          node = AsyncSpawnNode{ BgStreamBlock: item_mutable };,
      END
      MATCH node START
        AsyncSpawnNode.BgBlock AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.fsm_ineligible_reason = COPY decision.reason;
          node = AsyncSpawnNode{ BgBlock: item_mutable };,
        AsyncSpawnNode.BgStreamBlock AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.fsm_ineligible_reason = COPY decision.reason;
          node = AsyncSpawnNode{ BgStreamBlock: item_mutable };,
      END
    END
    MATCH node START
      AsyncSpawnNode.BgBlock AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.fsm_suspend_points = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_22: ?[]SuspendPointFact = NIL;
    IF (MATCH node START AsyncSpawnNode.BgBlock AS item -> (item.spawn_form == :fsm), AsyncSpawnNode.BgStreamBlock AS item -> (item.spawn_form == :fsm) END) THEN
      rtoc_ternary_value_22 = body_scan.suspend_points;
    ELSE
      rtoc_ternary_value_22 = NIL;
    END
    rtoc_ternary_value_22? };
        node = AsyncSpawnNode{ BgBlock: item_mutable };,
      AsyncSpawnNode.BgStreamBlock AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.fsm_suspend_points = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_22: ?[]SuspendPointFact = NIL;
    IF (MATCH node START AsyncSpawnNode.BgBlock AS item -> (item.spawn_form == :fsm), AsyncSpawnNode.BgStreamBlock AS item -> (item.spawn_form == :fsm) END) THEN
      rtoc_ternary_value_22 = body_scan.suspend_points;
    ELSE
      rtoc_ternary_value_22 = NIL;
    END
    rtoc_ternary_value_22? };
        node = AsyncSpawnNode{ BgStreamBlock: item_mutable };,
    END
}
END
PRIVATE FN capabilityAuditSession__assign_async_stack_tier_mut(MUTABLE self: CapabilityAuditSession, target: AsyncStackTarget, calls: [Set]String, user_size: ?String@symbol, can_smash: Bool, validation_node: AsyncValidationNode) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE raw: String@symbol = capabilityAuditSession__max_tier_for_calls(&rtoc_self_view, calls);
    target.computed_stack_tier = IF ((raw == :unbounded)) THEN
      :service
    ELSE
      raw
    END;
    capabilityAuditSession__validate_fiber_stack_mut(&rtoc_self_view, validation_node, calls, user_size, can_smash);
}
END
PRIVATE FN capabilityAuditSession__bg_spawn_form_for(MUTABLE self: CapabilityAuditSession, callee_names: [Set]String, has_fnptr: Bool) RETURNS !BgSpawnDecision
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = function_node_map();
    IF has_fnptr THEN
      RETURN BgSpawnDecision{ spawn_form: :stackful, reason: :fn_pointer };
    END
    MUTABLE visited = Set[];
    MUTABLE queue = COPY (callee_names |> SELECT COPY _);
    WHILE !(queue.empty?()) DO
      MUTABLE name = &queue.shift();
      IF visited.contains?(name) THEN
        CONTINUE;
      END
      &visited.insert(name);
      MUTABLE fn = fn_nodes[name];
      IF !(fn) THEN
        CONTINUE;
      END
      MUTABLE effs = (fn.effects() OR Set[]);
      IF (effs.contains?(reentrant) OR fn.plain_reentrant?()) THEN
        RETURN BgSpawnDecision{ spawn_form: :stackful, reason: :reentrant };
      END
      IF effs.contains?(extern_value) THEN
        RETURN BgSpawnDecision{ spawn_form: :stackful, reason: :extern };
      END
      IF effs |> ANY suspends_family.contains?(_) THEN
        RETURN BgSpawnDecision{ spawn_form: :stackful, reason: :suspending_callee };
      END
      FOR _ IN (((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[name] OR_ELSE List[])) DO
      &queue.append(COPY _);
      END
    END
    RETURN BgSpawnDecision{ spawn_form: :fsm, reason: NIL };
}
END
PRIVATE FN capabilityAuditSession__recursion_yield_needed?(self: CapabilityAuditSession, fn_node: FunctionDef) RETURNS Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN aST__recursion_yield_needed?(fn_node);
}
END
PRIVATE FN capabilityAuditSession__compute_stack_tiers_mut(MUTABLE self: CapabilityAuditSession) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = function_node_map();
    capabilityAuditSession__assign_base_stack_tiers_mut(&rtoc_self_view, fn_nodes);
    capabilityAuditSession__propagate_unbounded_stack_tiers_mut(&rtoc_self_view, fn_nodes);
    NIL;
}
END
PRIVATE FN capabilityAuditSession__assign_base_stack_tiers_mut(MUTABLE self: CapabilityAuditSession, fn_nodes: {String}FunctionDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    fn_nodes.keys() |> EACH {
    MUTABLE fn_node: FunctionDef = (fn_nodes[_] OR_ELSE CAST(panic("missing hash key") AS FunctionDef));
    MUTABLE effs = (fn_node.effects OR Set[]);
    MUTABLE stack_bytes = (fn_node.stack_vars_bytes OR 0);
    MUTABLE kind = fn_node.reentrance_kind;
    IF (kind == :reentrant) THEN
        fn_node.stack_tier = :unbounded;
        fn_node.stack_vars_bytes = stack_bytes;
        CONTINUE;
    END
    IF (kind == :reentrant_max_depth) THEN
        MUTABLE n = (fn_node.max_depth_n OR 1);
        IF capabilityAuditSession__mutually_recursive_in_call_graph?(&rtoc_self_view, _) THEN
          fn_node.stack_tier = :unbounded;
          fn_node.stack_vars_bytes = stack_bytes;
          CONTINUE;
        END
        stack_bytes = (stack_bytes * n);
    END
    MUTABLE return_t: ?Type = functionSignature__return_type(fn_node);
    IF ((return_t != NIL) AND !(TRUE)) THEN
        return_t = TRY (type__new(castTypeToTypeConstructionInput(return_t)));
    END
    MUTABLE declared_runtime_return = !(!((((return_t != NIL) AND (((type__heap?(return_t) OR type__indirect?(return_t)) OR TRY (type__needs_escape_promotion?(return_t))))))));
    MUTABLE tier =   IF (((effs.contains?(heap) OR effs.contains?(blocking)) OR effs.contains?(extern_value)) OR functionDef__runtime_stack_required?(fn_node, capabilityAuditSession__recursion_yield_needed?(rtoc_self_view, fn_node), declared_runtime_return)) THEN
        :standard
      ELSE
        :micro
      END;
    MUTABLE budget = UNWRAP ((CAST({:micro: 4096, :standard: 16384, :large: 65536, :xl: 262144, :service: 4194304} AS {String@symbol}Int64))[tier]);
    WHILE ((stack_bytes > (budget / 2)) AND (tier != :xl)) DO
        tier =     IF (tier == :micro) THEN
          :standard
        ELSE_IF (tier == :standard) THEN
          :large
        ELSE
          :xl
        END;
        budget = UNWRAP ((CAST({:micro: 4096, :standard: 16384, :large: 65536, :xl: 262144, :service: 4194304} AS {String@symbol}Int64))[tier]);
    END
    fn_node.stack_tier = tier;
    fn_node.stack_vars_bytes = stack_bytes;
    };
}
END
PRIVATE FN capabilityAuditSession__propagate_unbounded_stack_tiers_mut(MUTABLE self: CapabilityAuditSession, fn_nodes: {String}FunctionDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE changed: Bool = TRUE;
    WHILE changed DO
      changed = FALSE;
      (TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view))).keys() |> EACH {
    MUTABLE callees: [Set]String = ((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[_] OR_ELSE CAST(panic("missing hash key") AS [Set]String));
    MUTABLE fn: ?FunctionDef = COPY fn_nodes[_];
    IF !(fn) THEN
          CONTINUE;
    END
    IF (fn.stack_tier == :unbounded) THEN
          CONTINUE;
    END
    IF callees |> ANY ((fn_nodes[_] != NIL) AND (((fn_nodes[_])?).stack_tier == :unbounded)) THEN
          fn.stack_tier = :unbounded;
          changed = TRUE;
    END
      };
    END
}
END
PRIVATE FN capabilityAuditSession__mutually_recursive_in_call_graph?(MUTABLE self: CapabilityAuditSession, start_value: String) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN (((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[start_value] OR_ELSE Set[])) |> ANY (IF (_ == start_value) THEN FALSE ELSE capabilityAuditSession__reachable_in_call_graph?(&rtoc_self_view, _, start_value) END);
}
END
PRIVATE FN capabilityAuditSession__reachable_in_call_graph?(MUTABLE self: CapabilityAuditSession, from_name: String, target: String) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE visited = Set[];
    MUTABLE queue = [from_name];
    WHILE !((queue.length() == 0)) DO
      MUTABLE n: ?String = &queue.shift();
      IF visited.contains?(n) THEN
        CONTINUE;
      END
      &visited.insert(n);
      IF (n == target) THEN
        RETURN TRUE;
      END
      queue = ruby_array_concat_String(queue, CAST(TRY (effectSet__to_a((((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[n?] OR_ELSE Set[])))) AS []String));
    END
    RETURN FALSE;
}
END
PRIVATE FN capabilityAuditSession__max_tier_for_calls(MUTABLE self: CapabilityAuditSession, fn_names: [Set]String) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = function_node_map();
    MUTABLE visited = Set[];
    MUTABLE max: String@symbol = :micro;
    MUTABLE queue = COPY (fn_names |> SELECT COPY _);
    WHILE !(queue.empty?()) DO
      MUTABLE name = &queue.shift();
      IF visited.contains?(name) THEN
        CONTINUE;
      END
      &visited.insert(name);
      MUTABLE fn = fn_nodes[name];
      IF (IF fn != NIL THEN
        functionSignature__stack_tier(fn)
      ELSE
        NIL
      END) THEN
        IF (((CAST({:micro: 0, :standard: 1, :large: 2, :xl: 3, :service: 4, :unbounded: 5} AS {String@symbol}Int64))[functionSignature__stack_tier(fn)] OR_ELSE 0) > ((CAST({:micro: 0, :standard: 1, :large: 2, :xl: 3, :service: 4, :unbounded: 5} AS {String@symbol}Int64))[max] OR_ELSE 0)) THEN
          max = functionSignature__stack_tier(fn);
        END
      END
      FOR _ IN (((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[name] OR_ELSE List[])) DO
      &queue.append(COPY _);
      END
    END
    RETURN max;
}
END
PRIVATE FN capabilityAuditSession__check_indirect_reentrancy_mut(MUTABLE self: CapabilityAuditSession) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = function_node_map();
    MUTABLE direct_effects = capabilityAuditSession__effect_direct_effects(rtoc_self_view);
    FOR _ IN (TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view))).keys() DO
    MUTABLE node = fn_nodes[_];
    IF (node == NIL) THEN
        CONTINUE;
    END
    IF node.reentrance_kind() THEN
        CONTINUE;
    END
    MUTABLE visited = Set[];
    MUTABLE queue = TRY (effectSet__to_a((((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[_] OR_ELSE Set[]))));
    WHILE !(queue.empty?()) DO
        MUTABLE callee = &queue.shift();
        IF visited.contains?(callee) THEN
          CONTINUE;
        END
        &visited.insert(callee);
        IF (callee == _) THEN
          (IF direct_effects[_] != NIL THEN
            (direct_effects[_]).insert(symbol("REENTRANT"))
          ELSE
            NIL
          END);
          MUTABLE arrow = node.arrow_token();
          IF arrow THEN
            MUTABLE fix = TRY (fix__new(capabilityAuditSession__fix_description(rtoc_self_view, :ADD_EFFECTS_REENTRANT), [edit__new(span__new(NIL, arrow.line(), arrow.column(), 0), "EFFECTS REENTRANT ")], :auto));
            capabilityAuditSession__fixable_mut(rtoc_self_view, node, :reentrance, [fix], NIL, :REENTRANCY_MUTUAL_CYCLE, :error, FALSE, {:name: _});
          ELSE
            capabilityAuditSession__error_mut(rtoc_self_view, node, CodeOrMessage{ SymbolValue: :REENTRANCY_MUTUAL_CYCLE }, [], {:name: _});
          END
          BREAK;
        END
        FOR _ IN (((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[callee] OR_ELSE Set[])) DO
        &queue.append(COPY _);
        END
    END
    END
}
END
PRIVATE FN capabilityAuditSession__with_block_suspends?(self: CapabilityAuditSession, node: WithBlock) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (TRY (withCapabilityPlan__locks((TRY (capabilityPlan__require_for(node)))))) |> ANY _;
}
END
PRIVATE FN capabilityAuditSession__func_call_suspends?(self: CapabilityAuditSession, node: CallLikeNode) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fn_nodes = function_node_map();
    IF (IF (MATCH node START CallLikeNode.FuncCall AS item -> item.matched_stdlib_def, CallLikeNode.MethodCall AS item -> item.matched_stdlib_def END) != NIL THEN
      { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_23 = ((MATCH node START CallLikeNode.FuncCall AS item -> item.matched_stdlib_def, CallLikeNode.MethodCall AS item -> item.matched_stdlib_def END));
    TRY (functionSignature__intrinsic_suspends?(&rtoc_mutable_receiver_23)) }
    ELSE
      NIL
    END) THEN
      RETURN TRUE;
    END
    IF (IF node IS_A FuncCall AS func_call THEN func_call.fn_var_call ELSE FALSE END) THEN
      RETURN FALSE;
    END
    MUTABLE callee = fn_nodes[node.name()];
    IF !(callee) THEN
      RETURN FALSE;
    END
    MUTABLE effs = callee.effects();
    RETURN !(!(((effs AND (effs |> ANY suspends_family.contains?(_))))));
}
END
PRIVATE FN capabilityAuditSession__validate_fiber_stack_mut(MUTABLE self: CapabilityAuditSession, node: AsyncValidationNode, call_names: [Set]String, user_size: ?String@symbol, can_smash: Bool) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF can_smash THEN
      capabilityAuditSession__emit_can_smash_unsupported_error_mut(rtoc_self_view, node);
      RETURN;
    END
    MUTABLE plain_reentrant_callee: ?String = capabilityAuditSession__find_plain_reentrant_callee(&rtoc_self_view, call_names);
    IF ((plain_reentrant_callee != NIL) AND (user_size != :service)) THEN
      capabilityAuditSession__emit_service_required_error_mut(rtoc_self_view, node, plain_reentrant_callee, user_size);
      RETURN;
    END
    MUTABLE raw = capabilityAuditSession__max_tier_for_calls(&rtoc_self_view, call_names);
    MUTABLE computed = IF ((raw == :unbounded)) THEN
      :service
    ELSE
      raw
    END;
    IF ((raw == :unbounded) AND (user_size != :service)) THEN
      MUTABLE mutual_md_callee: ?String = capabilityAuditSession__find_mutual_max_depth_callee(&rtoc_self_view, call_names);
      IF mutual_md_callee EXISTS AS mutual_md_callee_value THEN
        capabilityAuditSession__error_mut(rtoc_self_view, node, CodeOrMessage{ SymbolValue: :STACK_SAFETY_MUTUAL_RECURSION }, [], {:callee: mutual_md_callee_value});
        RETURN;
      END
    END
    IF (user_size == :stack) THEN
      capabilityAuditSession__warning_mut(rtoc_self_view, castAsyncValidationNodeToLocatable(node), UNWRAP (TRY (diagnosticRegistry__format(:STACK_SAFETY_STACK_ALIAS, List[], {:computed: DiagnosticKwValue{ SymbolValue: COPY computed }}))));
      RETURN;
    END
    IF ((user_size != NIL) AND ((symbol("TIER_ORDER")[user_size] OR_ELSE 0) < (symbol("TIER_ORDER")[computed] OR_ELSE 0))) THEN
      capabilityAuditSession__error_mut(rtoc_self_view, node, CodeOrMessage{ SymbolValue: :STACK_SAFETY_USER_SIZE_TOO_SMALL }, [], {:size: user_size, :budget: symbol("STACK_TIER_BUDGET")[user_size], :computed: computed});
    END
}
END
PRIVATE FN capabilityAuditSession__find_plain_reentrant_callee(MUTABLE self: CapabilityAuditSession, call_names: [Set]String) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE visited: [Set]String = Set[];
    MUTABLE queue: []String = COPY (call_names |> SELECT COPY _);
    WHILE !((queue.length() == 0)) DO
      MUTABLE name = UNWRAP (&queue.shift());
      IF visited.contains?(name) THEN
        CONTINUE;
      END
      &visited.insert(name);
      MUTABLE fn: ?FunctionDef@multiowned = capabilityAuditSession__function_node_for(rtoc_self_view, name);
      IF ((fn != NIL) AND (fn.reentrance_kind == :reentrant)) THEN
        RETURN name;
      END
      FOR _ IN (((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[name] OR_ELSE List[])) DO
      &queue.append(COPY _);
      END
    END
    RETURN NIL;
}
END
PRIVATE FN capabilityAuditSession__find_mutual_max_depth_callee(MUTABLE self: CapabilityAuditSession, call_names: [Set]String) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE visited: [Set]String = Set[];
    MUTABLE queue: []String = COPY (call_names |> SELECT COPY _);
    WHILE !((queue.length() == 0)) DO
      MUTABLE name = UNWRAP (&queue.shift());
      IF visited.contains?(name) THEN
        CONTINUE;
      END
      &visited.insert(name);
      MUTABLE fn: ?FunctionDef@multiowned = capabilityAuditSession__function_node_for(rtoc_self_view, name);
      IF (((fn != NIL) AND (fn.reentrance_kind == :reentrant_max_depth)) AND capabilityAuditSession__mutually_recursive_in_call_graph?(&rtoc_self_view, name)) THEN
        RETURN name;
      END
      FOR _ IN (((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[name] OR_ELSE List[])) DO
      &queue.append(COPY _);
      END
    END
    RETURN NIL;
}
END
PRIVATE FN capabilityAuditSession__emit_service_required_error_mut(self: CapabilityAuditSession, node: AsyncValidationNode, reentrant_fn: String, user_size: ?String@symbol) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fix: ?Fix@multiowned = capabilityAuditSession__service_required_fix(rtoc_self_view, node, user_size);
    IF fix EXISTS AS fix_value THEN
      capabilityAuditSession__fixable_mut(rtoc_self_view, node, :reentrance, [fix_value], NIL, :STACK_NEEDS_SERVICE_FIXABLE, :error, FALSE, {:reentrant_fn: reentrant_fn});
    ELSE
      RETURN capabilityAuditSession__error_mut(rtoc_self_view, node, CodeOrMessage{ SymbolValue: :STACK_NEEDS_SERVICE_FIXABLE }, [], {:reentrant_fn: reentrant_fn});
    END
}
END
PRIVATE FN capabilityAuditSession__service_required_fix(self: CapabilityAuditSession, node: AsyncValidationNode, user_size: ?String@symbol) RETURNS ?Fix
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A BgBlock AS bg_block THEN
      MUTABLE prefix_token = bg_block.prefix_token;
      IF prefix_token THEN
        RETURN CAST(capabilityAuditSession__replace_stack_sigil_with_service_fix(rtoc_self_view, prefix_token, user_size) AS ?Fix);
      END
      MUTABLE open_brace_token = bg_block.open_brace_token;
      IF open_brace_token THEN
        RETURN CAST(capabilityAuditSession__insert_service_after_open_brace_fix(rtoc_self_view, open_brace_token) AS ?Fix);
      END
      RETURN NIL;
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN capabilityAuditSession__replace_stack_sigil_with_service_fix(self: CapabilityAuditSession, token: Token, user_size: ?String@symbol) RETURNS !Fix
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (fix__new(TRY (diagnosticRegistry__fix_description(:REPLACE_STACK_SIGIL_WITH_SERVICE, {:stack: ruby_wrap_optional_String_symbol_DiagnosticKwValue(user_size)})), [edit__new(span__new(NIL, token.line, token.column, (CAST(token.value AS String)).codepointCount()), "@service")], :interactive));
}
END
PRIVATE FN capabilityAuditSession__insert_service_after_open_brace_fix(self: CapabilityAuditSession, token: Token) RETURNS !Fix
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (fix__new(TRY (diagnosticRegistry__fix_description(:INSERT_SERVICE_AFTER_OPEN_BRACE)), [edit__new(span__new(NIL, token.line, (token.column + 1), 0), " @service ->")], :interactive));
}
END
PRIVATE FN capabilityAuditSession__validate_not_logical_recursion_mut(MUTABLE self: CapabilityAuditSession) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = function_node_map();
    fn_nodes.keys() |> EACH {
    MUTABLE fn_node: Any = (fn_nodes[_] OR_ELSE panic("missing hash key"));
    IF !((fn_node.reentrance_kind() == :reentrant_not_logical)) THEN
      CONTINUE;
    END
    MUTABLE direct = capabilityAuditSession__effect_direct_effects_for(rtoc_self_view, _).contains?(symbol("REENTRANT"));
    MUTABLE mutual = (!(direct) AND capabilityAuditSession__reachable_from_self?(&rtoc_self_view, _));
    IF !((direct OR mutual)) THEN
        CONTINUE;
    END
    MUTABLE cycle_desc: String = "";
      IF direct THEN
        cycle_desc = "directly calls itself";
      ELSE
        cycle_desc = "is part of a mutually recursive call cycle (reachable from itself via ${(capabilityAuditSession__thunk_cycle_members(&rtoc_self_view, _) |> ORDER_BY _).join(", ")})";
      END
    capabilityAuditSession__error_mut(rtoc_self_view, fn_node, CodeOrMessage{ SymbolValue: :REENTRANT_NOT_LOGICAL_BUT_RECURSIVE }, [], {:name: _, :cycle_desc: cycle_desc});
    };
}
END
PRIVATE FN capabilityAuditSession__validate_max_depth_mutual_cycle_mut(MUTABLE self: CapabilityAuditSession) RETURNS !{Any@multiowned}Any@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = function_node_map();
    fn_nodes.keys() |> EACH {
    MUTABLE fn_node: Any = (fn_nodes[_] OR_ELSE panic("missing hash key"));
    IF !((fn_node.reentrance_kind() == :reentrant_max_depth)) THEN
      CONTINUE;
    END
    MUTABLE direct = capabilityAuditSession__effect_direct_effects_for(rtoc_self_view, _).contains?(symbol("REENTRANT"));
    MUTABLE mutual = (!(direct) AND capabilityAuditSession__reachable_from_self?(&rtoc_self_view, _));
    IF !(mutual) THEN
        CONTINUE;
    END
    MUTABLE cycle_members = capabilityAuditSession__thunk_cycle_members(&rtoc_self_view, _) |> ORDER_BY _;
    MUTABLE fixes = List[];
    MUTABLE drop_edits: []Edit@multiowned = capabilityAuditSession__effects_clause_edits(rtoc_self_view, fn_node, "EFFECTS REENTRANT");
    IF drop_edits |> ANY _ THEN
        &fixes.append(TRY (fix__new(capabilityAuditSession__fix_description(rtoc_self_view, :DROP_MAX_DEPTH_MUTUAL, {:max_depth: fn_node.max_depth_n()}), drop_edits, :auto)));
    END
    IF (fixes.length() == 0) THEN
        capabilityAuditSession__fixable_mut(rtoc_self_view, fn_node, :reentrance, fixes, NIL, :REENTRANT_MAX_DEPTH_MUTUAL_DEMOTED, :warning, FALSE, {:fn: _, :max_depth: fn_node.max_depth_n(), :cycle: cycle_members.join(", ")});
    ELSE
        capabilityAuditSession__fixable_mut(rtoc_self_view, fn_node, :reentrance, fixes, NIL, :REENTRANT_MAX_DEPTH_MUTUAL_DEMOTED, :warning, FALSE, {:fn: _, :max_depth: fn_node.max_depth_n(), :cycle: cycle_members.join(", ")});
    END
    };
    RETURN NIL;
}
END
PRIVATE FN capabilityAuditSession__validate_thunk_recursion_mut(MUTABLE self: CapabilityAuditSession) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = function_node_map();
    fn_nodes.keys() |> EACH {
    MUTABLE fn_node: Any = (fn_nodes[_] OR_ELSE panic("missing hash key"));
    IF !((fn_node.reentrance_kind() == :reentrant_thunk)) THEN
      CONTINUE;
    END
    IF fn_node.tail_call() THEN
        CONTINUE;
    END
    IF fn_node.thunk_plan() THEN
        CONTINUE;
    END
    IF fn_node.mutual_thunk_plan() THEN
        CONTINUE;
    END
    MUTABLE direct = (((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[_] OR_ELSE Set[])).contains?(_);
    MUTABLE mutually = (!(direct) AND capabilityAuditSession__reachable_from_self?(&rtoc_self_view, _));
    IF direct THEN
        CONTINUE;
    ELSE_IF mutually THEN
        IF capabilityAuditSession__try_stamp_mutual_thunk_plan_mut(&rtoc_self_view, fn_node) THEN
          CONTINUE;
        END
        capabilityAuditSession__emit_mutual_thunk_unsupported_mut(&rtoc_self_view, fn_node);
    ELSE
        capabilityAuditSession__error_mut(rtoc_self_view, fn_node, CodeOrMessage{ SymbolValue: :REENTRANT_THUNK_NOT_RECURSIVE }, [], {:name: _});
    END
    };
}
END
PRIVATE FN capabilityAuditSession__try_stamp_mutual_thunk_plan_mut(MUTABLE self: CapabilityAuditSession, fn_node: FunctionDef) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = function_node_map();
    MUTABLE cycle_names = capabilityAuditSession__thunk_cycle_members(&rtoc_self_view, fn_node.name);
    IF (cycle_names.length() < 2) THEN
      RETURN FALSE;
    END
    MUTABLE cycle_fns = cycle_names |> SELECT fn_nodes[_];
    IF cycle_fns |> ANY _.nil?() THEN
      RETURN FALSE;
    END
    MUTABLE concrete_cycle_fns: []FunctionDef = cycle_fns |> WHERE _ != NIL;
    IF !(concrete_cycle_fns |> ALL (_.reentrance_kind == :reentrant_thunk)) THEN
      RETURN FALSE;
    END
    IF concrete_cycle_fns |> ANY (_.tail_call OR _.thunk_plan) THEN
      RETURN FALSE;
    END
    MUTABLE ret_types = CAST(((concrete_cycle_fns |> SELECT _.return_type) |> SELECT (IF _ != NIL THEN
      CAST(_ AS String)
    ELSE
      NIL
    END) |> DISTINCT _) AS []?String);
    IF !((ret_types.size() == 1)) THEN
      RETURN FALSE;
    END
    MUTABLE plans: {String}MutualPlan = {};
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < concrete_cycle_fns.length() DO
      MUTABLE partners = (cycle_names - [concrete_cycle_fns[rtoc_idx]?.name]);
      MUTABLE mp: ?MutualPlan = recursiveSplitter__split_mutual(concrete_cycle_fns[rtoc_idx]?.body, concrete_cycle_fns[rtoc_idx]?.name, partners);
      IF (mp == NIL) THEN
          RETURN FALSE;
      END
      plans[concrete_cycle_fns[rtoc_idx]?.name] = UNWRAP (mp);
    rtoc_idx = rtoc_idx + 1;
    END
    FOR _ IN concrete_cycle_fns DO
    _.mutual_thunk_plan = MutualThunkPlan{ cycle_fns: concrete_cycle_fns, own_plan: COPY UNWRAP (plans[_.name]) };
    END
    RETURN TRUE;
}
END
PRIVATE FN capabilityAuditSession__emit_mutual_thunk_unsupported_mut(MUTABLE self: CapabilityAuditSession, fn_node: FunctionDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = function_node_map();
    MUTABLE name = fn_node.name;
    MUTABLE cycle_names = capabilityAuditSession__thunk_cycle_members(&rtoc_self_view, name);
    MUTABLE cycle_thunk_fns = (cycle_names |> SELECT:? fn_nodes[_] |> WHERE _ != NIL) |> WHERE (_.reentrance_kind() == :reentrant_thunk);
    MUTABLE fixes = List[];
    MUTABLE edits_plain = cycle_thunk_fns |> UNNEST capabilityAuditSession__effects_clause_edits(rtoc_self_view, _, "EFFECTS REENTRANT");
    IF ((edits_plain.length() == cycle_thunk_fns.length()) AND !((edits_plain.length() == 0))) THEN
      &fixes.append(TRY (fix__new(capabilityAuditSession__fix_description(rtoc_self_view, :DROP_THUNK_CYCLE), edits_plain, :interactive)));
    END
    MUTABLE edits_nl = List[];
    MUTABLE nl_ok = !((cycle_thunk_fns.length() == 0));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < cycle_thunk_fns.length() DO
      MUTABLE eff: []Edit@multiowned = capabilityAuditSession__effects_clause_edits(rtoc_self_view, cycle_thunk_fns[rtoc_idx], "EFFECTS REENTRANT:NOT_LOGICAL");
      IF (eff.length() == 0) THEN
          nl_ok = FALSE;
          BREAK;
      END
      ruby_array_concat_Any(edits_nl, CAST(eff AS []Any));
      MUTABLE rt = cycle_thunk_fns[rtoc_idx].declared_return_type();
      IF (IF rt != NIL THEN
          rt.error_union?()
        ELSE
          NIL
        END) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE rt_tok = cycle_thunk_fns[rtoc_idx].return_type_token();
      IF (rt_tok == NIL) THEN
          nl_ok = FALSE;
          BREAK;
      END
      &edits_nl.append(edit__new(span__new(NIL, rt_tok.line(), rt_tok.column(), 0), "!"));
    rtoc_idx = rtoc_idx + 1;
    END
    IF nl_ok THEN
      &fixes.append(TRY (fix__new(capabilityAuditSession__fix_description(rtoc_self_view, :DECLARE_NOT_LOGICAL_CYCLE), edits_nl, :interactive)));
    END
    MUTABLE edits_md = List[];
    MUTABLE md_ok = !((cycle_thunk_fns.length() == 0));
    MUTABLE default_n = 64;
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < cycle_thunk_fns.length() DO
      MUTABLE eff: []Edit@multiowned = capabilityAuditSession__effects_clause_edits(rtoc_self_view, cycle_thunk_fns[rtoc_idx], "EFFECTS REENTRANT:MAX_DEPTH(${default_n.toString()})");
      IF (eff.length() == 0) THEN
          md_ok = FALSE;
          BREAK;
      END
      ruby_array_concat_Any(edits_md, CAST(eff AS []Any));
      MUTABLE rt = cycle_thunk_fns[rtoc_idx].declared_return_type();
      IF (IF rt != NIL THEN
          rt.error_union?()
        ELSE
          NIL
        END) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE rt_tok = cycle_thunk_fns[rtoc_idx].return_type_token();
      IF (rt_tok == NIL) THEN
          md_ok = FALSE;
          BREAK;
      END
      &edits_md.append(edit__new(span__new(NIL, rt_tok.line(), rt_tok.column(), 0), "!"));
    rtoc_idx = rtoc_idx + 1;
    END
    IF md_ok THEN
      &fixes.append(TRY (fix__new(capabilityAuditSession__fix_description(rtoc_self_view, :DECLARE_MAX_DEPTH_CYCLE, {:depth: DiagnosticKwValue{ Int64Value: default_n }}), edits_md, :interactive)));
    END
    IF (fixes.length() == 0) THEN
      RETURN capabilityAuditSession__error_mut(rtoc_self_view, fn_node, CodeOrMessage{ SymbolValue: :REENTRANT_MUTUAL_THUNK_UNSUPPORTED }, [], {:name: name, :cycle: (cycle_names |> ORDER_BY _).join(", ")});
    END
    capabilityAuditSession__fixable_mut(rtoc_self_view, fn_node, :reentrance, fixes, NIL, :REENTRANT_MUTUAL_THUNK_UNSUPPORTED, :error, FALSE, {:name: name, :cycle: (cycle_names |> ORDER_BY _).join(", ")});
}
END
PRIVATE FN capabilityAuditSession__thunk_cycle_members(MUTABLE self: CapabilityAuditSession, start_value: String) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE start_s = COPY start_value;
    MUTABLE forward = capabilityAuditSession__compute_reachable(rtoc_self_view, TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)), start_s);
    MUTABLE reverse_graph = {};
    (TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view))).keys() |> EACH {
    MUTABLE callees: [Set]String = ((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[_] OR_ELSE CAST(panic("missing hash key") AS [Set]String));
    FOR _ IN callees DO
    IF reverse_graph[CAST(_ AS String)] == NIL THEN
      reverse_graph[CAST(_ AS String)] = Set[];
    END
    (reverse_graph[CAST(_ AS String)])?.insert(_);
    END
    };
    MUTABLE backward = capabilityAuditSession__compute_reachable(rtoc_self_view, reverse_graph, start_s);
    MUTABLE scc = ruby_set_intersection_String_set(forward, backward);
    IF forward.contains?(start_s) THEN
      &scc.append(start_s);
    END
    RETURN TRY (effectSet__to_a(scc));
}
END
PRIVATE FN capabilityAuditSession__compute_reachable(self: CapabilityAuditSession, graph: {String}[Set]String, start_value: String) RETURNS ![Set]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE seen = Set[];
    MUTABLE queue = TRY (effectSet__to_a(((graph[start_value] OR_ELSE Set[]))));
    WHILE !(queue.empty?()) DO
      MUTABLE n = COPY CAST((&queue.shift()) AS String);
      IF seen.contains?(n) THEN
        CONTINUE;
      END
      &seen.insert(n);
      &queue.concat(TRY (effectSet__to_a(((graph[n] OR_ELSE Set[])))));
    END
    RETURN seen;
}
END
PRIVATE FN capabilityAuditSession__reachable_from_self?(MUTABLE self: CapabilityAuditSession, start_value: String) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE visited = Set[];
    MUTABLE queue = TRY (effectSet__to_a((((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[start_value] OR_ELSE Set[]))));
    WHILE !(queue.empty?()) DO
      MUTABLE callee = &queue.shift();
      IF visited.contains?(callee) THEN
        CONTINUE;
      END
      &visited.insert(callee);
      IF (callee == start_value) THEN
        RETURN TRUE;
      END
      &queue.concat(TRY (effectSet__to_a((((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[callee] OR_ELSE Set[])))));
    END
    RETURN FALSE;
}
END
PRIVATE FN capabilityAuditSession__effects_clause_edits(self: CapabilityAuditSession, fn_node: FunctionDef, replacement: String) RETURNS ![]Edit
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE span = fn_node.effects_span;
    IF !(span) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_24: []Edit = List[]; rtoc_empty_list_24 } ) AS []Edit);
    END
    MUTABLE s = span.start_token();
    MUTABLE e = span.end_token();
    IF (s.line() != e.line()) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_25: []Edit = List[]; rtoc_empty_list_25 } ) AS []Edit);
    END
    MUTABLE end_col = (e.column() + (CAST(e.value() AS String)).codepointCount());
    RETURN CAST([edit__new(span__new(NIL, s.line(), s.column(), (end_col - s.column())), replacement)] AS []Edit);
}
END
PRIVATE FN capabilityAuditSession__thunk_all_self_calls_in_tail_position?(self: CapabilityAuditSession, fn_node: FunctionDef, body_facts: BodyFacts) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE all = (MATCH body_facts START BodyFacts.BodyScanSummary AS item -> item.call_site_facts, BodyFacts.FunctionBodySummary AS item -> item.call_site_facts END) |> SELECT:? (  IF (_.callee_name == fn_node.name) THEN
      KEEP _.node
    ELSE
      NIL
    END) |> WHERE _ != NIL;
    IF (all.length() == 0) THEN
      RETURN FALSE;
    END
    MUTABLE blessed = (MATCH body_facts START BodyFacts.BodyScanSummary AS item -> item.return_nodes, BodyFacts.FunctionBodySummary AS item -> item.return_nodes END) |> SELECT:? (  IF (_.value IS_A FuncCall AND (_.value.name() == fn_node.name)) THEN
      _.value
    ELSE
      NIL
    END) |> WHERE _ != NIL;
    IF (blessed.length() == 0) THEN
      RETURN FALSE;
    END
    MUTABLE blessed_ids = (blessed |> SELECT _.object_id()) |> DISTINCT _;
    RETURN all |> ALL blessed_ids.contains?(_.object_id());
}
END
PRIVATE FN capabilityAuditSession__validate_predicate_purity_mut(self: CapabilityAuditSession) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rtoc_each_items_26 = capabilityAuditSession__predicate_call_sites_store(rtoc_self_view);
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_26.length() DO
      MUTABLE call = COPY KEEP rtoc_each_items_26[rtoc_idx]?.call;
      MUTABLE callee = COPY rtoc_each_items_26[rtoc_idx]?.callee;
      MUTABLE reason: ?String = capabilityAuditSession__predicate_impurity_reason(rtoc_self_view, call, callee);
      IF !(reason) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE surface, hint = PARTIAL MATCH rtoc_each_items_26[rtoc_idx]?.kind START
          :pre -> ["PRE clauses", "Move the impure work into the function body and validate the captured value there."],
          :post -> ["DEBUG_POST clauses", "Move the impure work into the function body and assert against an unsynchronized snapshot value instead."],
          DEFAULT -> ["WITH GUARD clauses", "Move the impure work before the WITH block and guard on the captured value."]
      END;
      capabilityAuditSession__error_mut(rtoc_self_view, call, CodeOrMessage{ SymbolValue: :PURE_FN_CANNOT_CALL_IMPURE }, [], {:surface: surface, :callee: callee, :reason: reason, :hint: hint});
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PRIVATE FN capabilityAuditSession__predicate_call_sites_store(self: CapabilityAuditSession) RETURNS ![]PredicateCallSite
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (capabilityAuditSession__predicate_call_sites(rtoc_self_view));
}
END
PRIVATE FN capabilityAuditSession__predicate_impurity_reason(self: CapabilityAuditSession, call: Call, callee: String) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (IF capabilityAuditSession__call_declared_impurity_reason(rtoc_self_view, call) != NIL THEN capabilityAuditSession__call_declared_impurity_reason(rtoc_self_view, call) ELSE capabilityAuditSession__matched_stdlib_impurity_reason(rtoc_self_view, call) END) != NIL THEN
    RETURN ((IF capabilityAuditSession__call_declared_impurity_reason(rtoc_self_view, call) != NIL THEN capabilityAuditSession__call_declared_impurity_reason(rtoc_self_view, call) ELSE capabilityAuditSession__matched_stdlib_impurity_reason(rtoc_self_view, call) END))?;
    ELSE
    RETURN capabilityAuditSession__semantic_function_impurity_reason(rtoc_self_view, callee);
    END
}
END
PRIVATE FN capabilityAuditSession__call_declared_impurity_reason(self: CapabilityAuditSession, call: Call) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (MATCH call START Call.FuncCall AS item -> item.extern_call, Call.MethodCall AS item -> item.extern_call END) THEN
      RETURN "is an extern call";
    END
    MUTABLE extern_effects: Any = NIL;
    MATCH call START
      Call.FuncCall AS item ->
        extern_effects = COPY item.extern_effects;,
      Call.MethodCall AS item ->
        extern_effects = COPY item.extern_effects;,
    END
    IF (extern_effects AND !(extern_effects.empty?())) THEN
      RETURN "has extern effects";
    END
    IF (MATCH call START Call.FuncCall AS item -> item.can_fail, Call.MethodCall AS item -> item.can_fail END) THEN
      RETURN "can fail";
    END
    RETURN NIL;
}
END
PRIVATE FN capabilityAuditSession__matched_stdlib_impurity_reason(self: CapabilityAuditSession, call: Call) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((MATCH call START Call.FuncCall AS item -> item.matched_stdlib_def, Call.MethodCall AS item -> item.matched_stdlib_def END)) THEN
      RETURN NIL;
    END
    MUTABLE md = UNWRAP ((MATCH call START Call.FuncCall AS item -> item.matched_stdlib_def, Call.MethodCall AS item -> item.matched_stdlib_def END));
    IF TRY (functionSignature__emits_allocating?(&md)) THEN
      RETURN "allocates";
    END
    IF functionSignature__can_fail(md) THEN
      RETURN "can fail";
    END
    IF TRY (functionSignature__intrinsic_suspends?(&md)) THEN
      RETURN "suspends";
    END
    IF TRY (functionSignature__mutates_receiver?(&md)) THEN
      RETURN "mutates its receiver";
    END
    RETURN NIL;
}
END
PRIVATE FN capabilityAuditSession__semantic_function_impurity_reason(self: CapabilityAuditSession, callee: String) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fn_nodes = function_node_map();
    MUTABLE fn = fn_nodes[callee];
    IF !(fn) THEN
      RETURN NIL;
    END
    IF functionSignature__can_fail(fn) THEN
      RETURN "can fail";
    END
    MUTABLE effects = (fn.effects() OR Set[]);
    IF effects.empty?() THEN
      RETURN NIL;
    END
    RETURN "has effects ${((effects |> SELECT effectTracker__display(_)) |> ORDER_BY _).join(", ")}";
}
END
PRIVATE FN capabilityAuditSession__finalize_capability_audit_mut(self: CapabilityAuditSession) RETURNS !BindingAuditStore
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    FOR _ IN (TRY (capabilityAuditSession__capability_audit(rtoc_self_view))).values() DO
    MUTABLE loc: String = "";
      IF _.line EXISTS AS line_value THEN
        loc = " (line ${line_value})";
      ELSE
        loc = "";
      END
    MUTABLE sync = COPY _.sync;
    MUTABLE own = COPY _.ownership;
    IF ((symbolEntry__locked_family_sync?(sync) AND !(_.mutated)) AND !(_.sharded)) THEN
        print("\x1B[36m[Note]\x1B[0m Variable '${_.var}' is @${sync} but never mutated via WITH EXCLUSIVE. You are paying for lock acquire/release on every access. Consider @local or removing the lock.${loc}");
    END
    IF ((own == :shared) AND !(_.captured_parallel)) THEN
        print("\x1B[36m[Note]\x1B[0m Variable '${_.var}' is @shared (Arc) but never leaves the local scheduler. You are paying for atomic ref-counting but never crossing cores. Consider @multiowned or @local.${loc}");
    END
    IF (symbolEntry__local_sync?(sync) AND !(_.captured_bg)) THEN
        capabilityAuditSession__emit_local_never_shared_finding_mut(rtoc_self_view, _);
    END
    END
    RETURN NIL;
}
END
PRIVATE FN capabilityAuditSession__propagate_lock_acquires_mut(MUTABLE self: CapabilityAuditSession) RETURNS !{String}[Set]String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE transitive: TransitiveAcquires = {};
    capabilityAuditSession__phase_audit_inputs(rtoc_self_view).lock_analysis.direct_acquires.keys() |> EACH {
    MUTABLE set: [Set]String@symbol = (capabilityAuditSession__phase_audit_inputs(rtoc_self_view).lock_analysis.direct_acquires[_] OR_ELSE CAST(panic("missing hash key") AS [Set]String@symbol));
    transitive[_] = COPY set;
    };
    FOR _ IN (TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view))).keys() DO
    transitive[_] = (transitive[_] OR_ELSE Set[]);
    END
    WHILE TRUE DO
      MUTABLE changed: Bool = FALSE;
      (TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view))).keys() |> EACH {
    MUTABLE callees: [Set]String = ((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[_] OR_ELSE CAST(panic("missing hash key") AS [Set]String));
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < callees.length() DO
      IF !(transitive[callees[rtoc_idx]]) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE rtoc_each_items_27 = (transitive[callees[rtoc_idx]]);
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < rtoc_each_items_27.length() DO
          MUTABLE fn_set = transitive[_];
          IF fn_set.contains?(rtoc_each_items_27[rtoc_idx]) THEN
                rtoc_idx = rtoc_idx + 1;
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
          END
          &fn_set.append(COPY rtoc_each_items_27[rtoc_idx]);
          changed = TRUE;
        rtoc_idx = rtoc_idx + 1;
      END
    rtoc_idx = rtoc_idx + 1;
      END
      };
      IF !(changed) THEN
        BREAK;
      END
    END
    RETURN transitive;
}
END
PRIVATE FN capabilityAuditSession__resolve_held_calls_mut(self: CapabilityAuditSession, transitive_acquires: TransitiveAcquires) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE state = COPY capabilityAuditSession__phase_audit_inputs(rtoc_self_view).lock_analysis;
    state.held_calls.keys() |> EACH {
    MUTABLE sites: []LockHeldCallSite = (state.held_calls[_] OR_ELSE CAST(panic("missing hash key") AS []LockHeldCallSite));
    FOR _ IN sites DO
    FOR _ IN ((transitive_acquires[_.callee] OR Set[])) DO
    IF state.direct_edges[_] EXISTS AS rtoc_map_slot_28 THEN
      &rtoc_map_slot_28.append(LockEdge{ held: COPY _.held, acquired: COPY _, site_token: KEEP _.site_token, fn_name: COPY _, opted_out: _.opted_out });
    ELSE
      panic("T.must: map slot is NIL");
    END
    END
    END
    };
    NIL;
}
END
PRIVATE FN capabilityAuditSession__build_lock_graph(self: CapabilityAuditSession, MUTABLE include_opted_out: Bool = FALSE) RETURNS LockGraph
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE adj: {String@symbol}[Set]String@symbol = {};
    MUTABLE nodes: [Set]String@symbol = Set[];
    MUTABLE live: []LockEdge = ( { MUTABLE rtoc_empty_list_29: []LockEdge = List[]; rtoc_empty_list_29 } );
    capabilityAuditSession__phase_audit_inputs(rtoc_self_view).lock_analysis.direct_edges.keys() |> EACH {
    MUTABLE edges: []LockEdge = (capabilityAuditSession__phase_audit_inputs(rtoc_self_view).lock_analysis.direct_edges[_] OR_ELSE CAST(panic("missing hash key") AS []LockEdge));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < edges.length() DO
      IF (edges[rtoc_idx]?.opted_out AND !(include_opted_out)) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF adj[edges[rtoc_idx]?.held] == NIL THEN
          adj[edges[rtoc_idx]?.held] = Set[];
        END
        IF adj[edges[rtoc_idx]?.held] EXISTS AS rtoc_map_slot_30 THEN
          &rtoc_map_slot_30.insert(edges[rtoc_idx]?.acquired);
        END
      &nodes.insert(edges[rtoc_idx]?.held);
      &nodes.insert(edges[rtoc_idx]?.acquired);
      &live.append(COPY edges[rtoc_idx]?);
    rtoc_idx = rtoc_idx + 1;
    END
    };
    RETURN LockGraph{ nodes: COPY nodes, adj: COPY adj, edges: COPY live };
}
END
PRIVATE FN capabilityAuditSession__tarjan_scc(self: CapabilityAuditSession, nodes: [Set]String@symbol, adj: {String@symbol}[Set]String@symbol) RETURNS ![List, List]String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE empty: [Set]String@symbol = Set[];
    MUTABLE reverse_adj: {String@symbol}[Set]String@symbol = {};
    adj.keys() |> EACH {
    MUTABLE targets: [Set]String@symbol = (adj[_] OR_ELSE CAST(panic("missing hash key") AS [Set]String@symbol));
    FOR _ IN targets DO
    IF reverse_adj[_] == NIL THEN
      reverse_adj[_] = Set[];
    END
    IF reverse_adj[_] EXISTS AS rtoc_map_slot_31 THEN
      &rtoc_map_slot_31.insert(COPY _);
    END
    END
    };
    MUTABLE visited: [Set]String@symbol = Set[];
    MUTABLE finish_order: []String@symbol = ( { MUTABLE rtoc_empty_list_32: []String@symbol = List[]; rtoc_empty_list_32 } );
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < nodes.length() DO
      IF visited.contains?(nodes[rtoc_idx]) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE stack: []LockSccFrame = [LockSccFrame{ node: COPY nodes[rtoc_idx], expanded: FALSE }];
      WHILE !((stack.length() == 0)) DO
          MUTABLE frame = UNWRAP (&stack.pop());
          MUTABLE node = frame.node;
          IF frame.expanded THEN
            &finish_order.append(node);
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
          END
          IF visited.contains?(node) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
          END
          &visited.insert(node);
          &stack.append(LockSccFrame{ node: COPY node, expanded: TRUE });
          FOR _ IN (adj[node] OR_ELSE empty) DO
          IF !(visited.contains?(_)) THEN
            &stack.append(LockSccFrame{ node: COPY _, expanded: FALSE });
          END
          END
      END
    rtoc_idx = rtoc_idx + 1;
    END
    MUTABLE assigned: [Set]String@symbol = Set[];
    MUTABLE sccs: [List, List]String@symbol = ( { MUTABLE rtoc_empty_list_33: [List, List]String@symbol = List[]; rtoc_empty_list_33 } );
    MUTABLE rtoc_reverse_items_34: []String@symbol = finish_order;
    MUTABLE rtoc_reverse_i_35 = rtoc_reverse_items_34.length() - 1;
    WHILE rtoc_reverse_i_35 >= 0 DO
      IF assigned.contains?((rtoc_reverse_items_34[rtoc_reverse_i_35])?) THEN
        rtoc_reverse_i_35 = rtoc_reverse_i_35 - 1;
    CONTINUE;
      END
      MUTABLE component: []String@symbol = ( { MUTABLE rtoc_empty_list_36: []String@symbol = List[]; rtoc_empty_list_36 } );
      MUTABLE stack: []String@symbol = [(rtoc_reverse_items_34[rtoc_reverse_i_35])?];
      WHILE !((stack.length() == 0)) DO
          MUTABLE node = symbol(UNWRAP (&stack.pop()));
          IF assigned.contains?(node) THEN
            rtoc_reverse_i_35 = rtoc_reverse_i_35 - 1;
    CONTINUE;
          END
          &assigned.insert(node);
          &component.append(node);
          FOR _ IN (reverse_adj[node] OR_ELSE empty) DO
          IF !(assigned.contains?(_)) THEN
            &stack.append(COPY _);
          END
          END
      END
      &sccs.append(component);
    rtoc_reverse_i_35 = rtoc_reverse_i_35 - 1;
    END
    RETURN sccs;
}
END
PRIVATE FN capabilityAuditSession__check_lock_cycles_mut(MUTABLE self: CapabilityAuditSession) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE transitive_acquires = capabilityAuditSession__propagate_lock_acquires_mut(&rtoc_self_view);
    capabilityAuditSession__resolve_held_calls_mut(rtoc_self_view, transitive_acquires);
    MUTABLE non_opted = capabilityAuditSession__build_lock_graph(rtoc_self_view, FALSE);
    MUTABLE rtoc_each_items_37 = capabilityAuditSession__tarjan_scc(rtoc_self_view, non_opted.nodes, non_opted.adj);
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_37.length() DO
      IF !(capabilityAuditSession__scc_is_cyclic?(rtoc_self_view, rtoc_each_items_37[rtoc_idx]?, non_opted.adj)) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      capabilityAuditSession__report_lock_cycle_mut(rtoc_self_view, rtoc_each_items_37[rtoc_idx]?, non_opted.edges);
    rtoc_idx = rtoc_idx + 1;
    END
    capabilityAuditSession__check_lock_handler_reachability_mut(rtoc_self_view);
    NIL;
}
END
PRIVATE FN capabilityAuditSession__check_lock_handler_reachability_mut(self: CapabilityAuditSession) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE clause_sites = COPY capabilityAuditSession__phase_audit_inputs(rtoc_self_view).lock_analysis.clause_sites;
    IF (clause_sites.length() == 0) THEN
      RETURN;
    END
    MUTABLE full = capabilityAuditSession__build_lock_graph(rtoc_self_view, TRUE);
    MUTABLE types_in_cycle = Set[];
    MUTABLE types_with_self = Set[];
    FOR _ IN capabilityAuditSession__tarjan_scc(rtoc_self_view, full.nodes, full.adj) DO
    IF (_.length() >= 2) THEN
      FOR _ IN _ DO
      &types_in_cycle.insert(COPY _);
      END
    ELSE
      MUTABLE node = COPY symbol(UNWRAP (_.first()));
      IF (UNWRAP (full.adj[node])).contains?(node) THEN
        &types_in_cycle.insert(COPY node);
        &types_with_self.insert(COPY node);
      END
    END
    END
    FOR _ IN clause_sites DO
    capabilityAuditSession__verify_handler_reachability_mut(rtoc_self_view, _, types_in_cycle, types_with_self);
    END
    NIL;
}
END
PRIVATE FN capabilityAuditSession__verify_handler_reachability_mut(self: CapabilityAuditSession, site: LockClauseSite, types_in_cycle: [Set]String@symbol, types_with_self: [Set]String@symbol) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE possible: [Set]String@symbol = Set[];
    MUTABLE node = COPY KEEP site.node;
    MUTABLE clause = node.lock_error_clause;
    IF !(clause) THEN
      RETURN;
    END
    IF (node.snapshot_mode == :transaction) THEN
      MUTABLE has_atomic_ptr = (TRY (withCapabilityPlan__snapshot_transitions((TRY (capabilityPlan__require_for(CAST(node AS WithBlock))))))) |> ANY {
    MUTABLE sym: ?SymbolEntry@multiowned = COPY KEEP _.source_entry;
    ((((sym != NIL) AND symbolEntry__atomic?(sym)) AND TRUE) AND symbolEntry__indirect?(sym))
      };
      possible = ( { MUTABLE rtoc_pipe_src = [IF has_atomic_ptr THEN
        :AtomicConflict
      ELSE
        :MvccConflict
      END]; rtoc_pipe_src |> DISTINCT _ } );
    ELSE
      possible = Set[];
      IF site.cap_types |> ANY _ THEN
        &possible.insert(:LockTimeout);
      END
      FOR _ IN site.cap_types DO
    IF types_in_cycle.contains?(_) THEN
          &possible.insert(:LockCycle);
    END
    IF types_with_self.contains?(_) THEN
          &possible.insert(:Deadlock);
    END
      END
    END
    IF !(((TRY (withCapabilityPlan__guarded((TRY (capabilityPlan__require_for(CAST(node AS WithBlock))))))).length() == 0)) THEN
      &possible.insert(:GuardFail);
    END
    MUTABLE rtoc_each_items_38 = clause.selectors();
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_38.length() DO
      MUTABLE expansion = PARTIAL MATCH rtoc_each_items_38[rtoc_idx].form() START
          :kind -> (TRY (aST__types_for_kind(rtoc_each_items_38[rtoc_idx].name()))) |> DISTINCT _,
          :type -> ( { MUTABLE rtoc_pipe_src = [rtoc_each_items_38[rtoc_idx].name()]; rtoc_pipe_src |> DISTINCT _ } ),
          DEFAULT -> Set[]
        END;
      MUTABLE reachable = ruby_set_intersection_String_symbol_set(expansion, possible);
      IF !(reachable.empty?()) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE label = COPY CAST(rtoc_each_items_38[rtoc_idx].name() AS String);
      capabilityAuditSession__error_mut(rtoc_self_view, (rtoc_each_items_38[rtoc_idx].token() OR node), CodeOrMessage{ SymbolValue: :SELECTOR_NOT_POSSIBLE }, [], {:label: label});
    rtoc_idx = rtoc_idx + 1;
    END
    NIL;
}
END
PRIVATE FN capabilityAuditSession__scc_is_cyclic?(self: CapabilityAuditSession, scc: []String@symbol, adj: {String@symbol}[Set]String@symbol) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (scc.length() > 1) THEN
      RETURN TRUE;
    END
    MUTABLE node = COPY symbol(UNWRAP (scc.first()));
    RETURN (UNWRAP (adj[node])).contains?(node);
}
END
PRIVATE FN capabilityAuditSession__report_lock_cycle_mut(self: CapabilityAuditSession, scc: []String@symbol, edges: []LockEdge) RETURNS Any@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE scc_set = scc |> DISTINCT _;
    MUTABLE participating = edges |> WHERE (scc_set.contains?(_.held) AND scc_set.contains?(_.acquired));
    MUTABLE sample: ?LockEdge = COPY participating.first();
    MUTABLE site_lines = (CAST(((participating |> SELECT {
    MUTABLE line: String = "?";
    IF KEEP _.site_token != NIL THEN
        line = ((KEEP _.site_token)?).line;
      END
    "  - ${_.fn_name} (line ${line}): holds :${_.held}, acquires :${_.acquired}"
    }) |> DISTINCT _) AS []String)).join("\n");
    MUTABLE types_str = (scc |> SELECT ":${_}").join(", ");
    MUTABLE kind: String = "";
    IF (scc.length() == 1) THEN
      kind = "self-loop (same-type nested acquire)";
    ELSE
      kind = "lock cycle (graph SCC)";
    END
    MUTABLE anchor: ?Token@multiowned = NIL;
    IF sample != NIL THEN
      anchor = COPY KEEP (sample?).site_token;
    END
    RETURN capabilityAuditSession__error_mut(rtoc_self_view, (anchor OR_ELSE capabilityAuditSession__semantic_program(rtoc_self_view)), CodeOrMessage{ SymbolValue: :LOCK_CYCLE_DETECTED }, [], {:kind: kind, :types: types_str, :sites: site_lines});
}
END
PRIVATE FN capabilityAuditSession__run_deferred_validations_mut(self: CapabilityAuditSession) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    capabilityAuditSession__flush_deferred_recovery_validations_mut(rtoc_self_view);
    capabilityAuditSession__flush_deferred_with_validations_mut(rtoc_self_view);
