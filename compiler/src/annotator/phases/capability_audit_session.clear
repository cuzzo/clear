PRIVATE FN capabilityAuditSession__error_mut(MUTABLE self: CapabilityAuditSession, node_or_token: ?DiagnosticAnchor, code_or_message: CapabilityAuditCodeOrMessage, args: []?DiagnosticKwValue = [], kwargs: {String@symbol}Any = {}) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE token: ?Any@multiowned = capabilityAuditSession__diagnostic_token(rtoc_self_view, node_or_token);
    MUTABLE message: ?String = "";
    IF code_or_message IS_A String@symbol AS string_symbol THEN
      message = TRY (diagnosticRegistry__format_from_hash(string_symbol, args, kwargs));
      IF !(message) THEN
        panic("Internal Compiler Error: Unknown error code :{}");
      END
    ELSE
      message = castCodeOrMessageToOptionalString__capability_audit_session(COPY code_or_message);
    END
    MUTABLE source_token: ?Token@multiowned = capabilityAuditSession__source_error_token(rtoc_self_view, token);
    MUTABLE diagnostic_code: ?String@symbol = NIL;
    IF code_or_message IS_A String@symbol AS string_symbol THEN
      diagnostic_code = COPY string_symbol;
    END
    RETURN TRY (capabilityAuditSession__raise_source_error_mut(&rtoc_self_view, CAST(source_token AS ?Token), UNWRAP (message), diagnostic_code));
}
END
PRIVATE FN capabilityAuditSession__format_diagnostic_template(self: CapabilityAuditSession, template: String, args: []?DiagnosticKwValue, kwargs: {String@symbol}?DiagnosticKwValue) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN diagnosticRegistry__format_template(template, args, diagnosticKwargs__rendered(kwargs));
}
END
PRIVATE FN capabilityAuditSession__diagnostic_message(self: CapabilityAuditSession, code: String@symbol, args: []?DiagnosticKwValue = [], kwargs: {String@symbol}Any = {}) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE message: ?String = TRY (diagnosticRegistry__format_from_hash(code, args, kwargs));
    IF message EXISTS AS message_value THEN
      RETURN message_value;
    ELSE
      panic("Internal Compiler Error: Unknown error code :{}");
    END
}
END
PRIVATE FN capabilityAuditSession__fix_description_from_hash(self: CapabilityAuditSession, code: String@symbol, kwargs: {String@symbol}?DiagnosticKwValue) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (diagnosticRegistry__fix_description_from_hash(code, diagnosticKwargs__rendered(kwargs)));
}
END
PRIVATE FN capabilityAuditSession__note_mut(MUTABLE self: CapabilityAuditSession, node_or_token: Locatable, message: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE token: ?Token@multiowned = capabilityAuditSession__source_error_token(rtoc_self_view, capabilityAuditSession__diagnostic_token(rtoc_self_view, DiagnosticAnchor{ Locatable: COPY node_or_token }));
    MUTABLE loc: String = "";
    IF token EXISTS AS token_value THEN
      loc = " (line ${token_value.line.toString()})";
    ELSE
      loc = "";
    END
    capabilityAuditSession__diagnostic_output(rtoc_self_view, "\x1B[36m[Note]\x1B[0m ${message}${loc}");
    NIL;
}
END
PRIVATE FN capabilityAuditSession__warning_mut(MUTABLE self: CapabilityAuditSession, node_or_token: Locatable, message: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE token: ?Token@multiowned = capabilityAuditSession__source_error_token(rtoc_self_view, capabilityAuditSession__diagnostic_token(rtoc_self_view, DiagnosticAnchor{ Locatable: COPY node_or_token }));
    MUTABLE loc: String = "";
    IF token EXISTS AS token_value THEN
      loc = " (line ${token_value.line.toString()})";
    ELSE
      loc = "";
    END
    capabilityAuditSession__diagnostic_output(rtoc_self_view, "\x1B[33m[Warning]\x1B[0m ${message}${loc}");
    NIL;
}
END
PRIVATE FN capabilityAuditSession__fixable_mut(MUTABLE self: CapabilityAuditSession, node_or_token: ?DiagnosticAnchor, category: String@symbol, fixes: []Fix, message: ?String = NIL, code: ?String@symbol = NIL, level: String@symbol = :warning, raise_in_collector: Bool = FALSE, kwargs: {String@symbol}Any = {}) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rendered_message = (message OR_ELSE TRY (capabilityAuditSession__diagnostic_message(rtoc_self_view, code?, [], kwargs)));
    MUTABLE token: ?Any@multiowned = capabilityAuditSession__diagnostic_token(rtoc_self_view, node_or_token);
    MUTABLE source_token: ?Token@multiowned = capabilityAuditSession__source_error_token(rtoc_self_view, token);
    MUTABLE finding = TRY (fixableFinding__new(level, rendered_message, token, category, fixes));
    IF fixCollector__enabled?() THEN
      TRY (fixCollector__push(finding, (level == :error)));
      IF !(raise_in_collector) THEN
        RETURN;
      END
      TRY (capabilityAuditSession__raise_source_error_mut(&rtoc_self_view, CAST(source_token AS ?Token), rendered_message));
    END
    IF (level == :hint) OR (level == :info) OR (level == :warning) THEN
      MUTABLE loc: String = "";
      IF source_token EXISTS AS source_token_value THEN
        loc = " (line ${source_token_value.line.toString()})";
      ELSE
        loc = "";
      END
      MUTABLE tag: String = "";
      IF (level == :warning) THEN
        tag = "\x1B[33m[Warning]\x1B[0m";
      ELSE
        tag = "\x1B[36m[${(CAST(level AS String)).capitalize()}]\x1B[0m";
      END
      capabilityAuditSession__diagnostic_output(rtoc_self_view, "${tag} ${rendered_message}${loc}");
      RETURN;
    ELSE_IF (level == :error) THEN
      RETURN TRY (capabilityAuditSession__raise_source_error_mut(&rtoc_self_view, CAST(source_token AS ?Token), rendered_message));
    ELSE
      RETURN;
    END
}
END
PRIVATE FN capabilityAuditSession__diagnostic_source_code(self: CapabilityAuditSession) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN capabilityAuditSession__source_code(rtoc_self_view);
}
END
PRIVATE FN capabilityAuditSession__parser_error_host?(self: CapabilityAuditSession) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN FALSE;
}
END
PRIVATE FN capabilityAuditSession__raise_source_error_mut(MUTABLE self: CapabilityAuditSession, token: ?Token, message: String, code: ?String@symbol = NIL) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF capabilityAuditSession__parser_error_host?(rtoc_self_view) THEN
      RAISE Input, ParserError, message;
    END
    RAISE Input, CompilerError, message;
}
END
