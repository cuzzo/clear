  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN TRY (capabilityAuditSession__derived_call_view(&rtoc_self_view, :callees, %(function: LocalFunctionFacts) -> function.callees |> DISTINCT _));
}
END
PRIVATE FN capabilityAuditSession__function_propagating_callees(MUTABLE self: CapabilityAuditSession) RETURNS !{String}[Set]String
  REQUIRES self: LOCAL
->
