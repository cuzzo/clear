PRIVATE FN capabilityAuditSession__propagate_needs_rt_mut(MUTABLE self: CapabilityAuditSession, MUTABLE needs_rt: {String}Bool) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE changed: Bool = TRUE;
    WHILE changed DO
      changed = FALSE;
      FOR rtoc_each_9 IN (TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view))).keys() DO
    MUTABLE callees: [Set]String = ((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[rtoc_each_9] OR_ELSE CAST(panic("missing hash key") AS [Set]String));
    IF needs_rt[rtoc_each_9] THEN
      CONTINUE;
    END
    IF callees |> ANY needs_rt[rtoc_each_9] THEN
          needs_rt[rtoc_each_9] = TRUE;
          changed = TRUE;
    END
            END
    END
}
END
PRIVATE FN capabilityAuditSession__compute_can_fail_mut(MUTABLE self: CapabilityAuditSession) RETURNS !?{Any@multiowned}Any@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = TRY (capabilityAuditSession__function_node_map(rtoc_self_view));
    MUTABLE error_fallible = {};
    fn_nodes.keys() |> EACH {
    MUTABLE fn_node: FunctionDef@multiowned = (fn_nodes[_] OR_ELSE panic("missing hash key"));
    MUTABLE declared_fallible = ({
      MUTABLE rtoc_value_block_marker = 0;
      MUTABLE rt: ?Type = fn_node.return_type;
      ((rt != NIL AND TRUE) AND type__error_union?(rt))
    });
    error_fallible[_] = ((TRY (capabilityAuditSession__function_raises_directly?(rtoc_self_view, _)) OR declared_fallible) OR (_ == name));
    };
    FOR rtoc_each_10 IN (TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view))).keys() DO
    MUTABLE callees: [Set]String = ((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[rtoc_each_10] OR_ELSE CAST(panic("missing hash key") AS [Set]String));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < callees.length() DO
      IF error_fallible.contains?(callees[rtoc_idx]) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE scope: ?Scope@multiowned = TRY (capabilityAuditSession__lookup_scope_for(&rtoc_self_view, callees[rtoc_idx]));
      IF !(scope) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE sig: ?FunctionSignature@multiowned = functionSignature__unwrap(ruby_wrap_optional_Type_multiowned_X__capability_audit_session((IF scope__resolve_entry(scope, callees[rtoc_idx]) != NIL THEN
          { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_16 = (scope__resolve_entry(scope, callees[rtoc_idx]));
      symbolEntry__type(rtoc_local_receiver_16) }
        ELSE
          NIL
        END)));
      IF !(sig) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE ef: ?Bool = IF (functionSignature__error_fallible(sig) == NIL) THEN
          functionSignature__can_fail(sig)
        ELSE
          functionSignature__error_fallible(sig)
        END;
      IF ef EXISTS AS ef_value THEN
          error_fallible[callees[rtoc_idx]] = TRUE;
      END
    rtoc_idx = rtoc_idx + 1;
    END
        END
    MUTABLE changed: Bool = TRUE;
    WHILE changed DO
      changed = FALSE;
      FOR rtoc_each_11 IN (TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view))).keys() DO
    MUTABLE callees: [Set]String = ((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[rtoc_each_11] OR_ELSE CAST(panic("missing hash key") AS [Set]String));
    IF error_fallible[rtoc_each_11] THEN
      CONTINUE;
    END
    MUTABLE prop = ((TRY (capabilityAuditSession__function_propagating_callees(&rtoc_self_view)))[rtoc_each_11] OR_ELSE callees);
    IF prop |> ANY error_fallible[rtoc_each_11] THEN
          error_fallible[rtoc_each_11] = TRUE;
          changed = TRUE;
    END
            END
    END
    MUTABLE alloc_fault = {};
    fn_nodes.keys() |> EACH {
    MUTABLE fn_node: FunctionDef@multiowned = (fn_nodes[_] OR_ELSE panic("missing hash key"));
    MUTABLE direct_alloc = ((fn_node.uses_alloc == TRUE));
    MUTABLE decl_alloc = ({
      MUTABLE rtoc_value_block_marker = 0;
      MUTABLE rt = functionSignature__return_type(fn_node);
      (IF rt THEN
        (IF rt.error_union?() THEN
        (type__collection?(rt) OR TRY (type__string?(rt)))
      ELSE
        ((((TRUE AND TRY (type__needs_escape_promotion?(rt)))) OR type__collection?(rt)) OR TRY (type__string?(rt)))
      END)
      ELSE
        FALSE
      END)
    } OR_ELSE FALSE);
    alloc_fault[_] = (direct_alloc OR decl_alloc);
    };
    FOR rtoc_each_12 IN (TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view))).keys() DO
    MUTABLE callees: [Set]String = ((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[rtoc_each_12] OR_ELSE CAST(panic("missing hash key") AS [Set]String));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < callees.length() DO
      IF alloc_fault.contains?(callees[rtoc_idx]) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE scope: ?Scope@multiowned = TRY (capabilityAuditSession__lookup_scope_for(&rtoc_self_view, callees[rtoc_idx]));
      IF !(scope) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE sig: ?FunctionSignature@multiowned = functionSignature__unwrap(ruby_wrap_optional_Type_multiowned_X__capability_audit_session((IF scope__resolve_entry(scope, callees[rtoc_idx]) != NIL THEN
          { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_17 = (scope__resolve_entry(scope, callees[rtoc_idx]));
      symbolEntry__type(rtoc_local_receiver_17) }
        ELSE
          NIL
        END)));
      IF sig EXISTS AS sig_value THEN
        IF functionSignature__alloc_fault(sig_value) THEN
          alloc_fault[callees[rtoc_idx]] = TRUE;
      END
      END
    rtoc_idx = rtoc_idx + 1;
    END
        END
    changed = TRUE;
    WHILE changed DO
      changed = FALSE;
      FOR rtoc_each_13 IN (TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view))).keys() DO
    MUTABLE callees: [Set]String = ((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[rtoc_each_13] OR_ELSE CAST(panic("missing hash key") AS [Set]String));
    IF alloc_fault[rtoc_each_13] THEN
      CONTINUE;
    END
    MUTABLE prop = ((TRY (capabilityAuditSession__function_propagating_callees(&rtoc_self_view)))[rtoc_each_13] OR_ELSE callees);
    IF prop |> ANY alloc_fault[rtoc_each_13] THEN
          alloc_fault[rtoc_each_13] = TRUE;
          changed = TRUE;
    END
            END
    END
    fn_nodes.keys() |> EACH {
    MUTABLE fn_node: FunctionDef@multiowned = (fn_nodes[_] OR_ELSE panic("missing hash key"));
    MUTABLE ef = ((error_fallible[_] == TRUE));
    MUTABLE af = ((alloc_fault[_] == TRUE));
    fn_node.error_fallible = ef;
    fn_node.alloc_fault = af;
    fn_node.can_fail = (ef OR af);
    };
    RETURN NIL;
}
END
PRIVATE FN capabilityAuditSession__enforce_fallible_returns_mut(MUTABLE self: CapabilityAuditSession) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = TRY (capabilityAuditSession__function_node_map(rtoc_self_view));
    IF !(TRUE) THEN
      RETURN;
    END
    FOR rtoc_each_14 IN fn_nodes.keys() DO
    MUTABLE fn_node: FunctionDef@multiowned = (fn_nodes[rtoc_each_14] OR_ELSE panic("missing hash key"));
    IF !(fn_node.error_fallible) THEN
      CONTINUE;
    END
    IF (rtoc_each_14 == name) THEN
        CONTINUE;
    END
    MUTABLE has_catch = capabilityAuditSession__function_has_catch_clauses?(rtoc_self_view, fn_node);
    MUTABLE has_default = capabilityAuditSession__function_has_default_catch?(rtoc_self_view, fn_node);
    IF (has_catch OR has_default) THEN
        CONTINUE;
    END
    IF !(fn_node.explicit_return_type) THEN
        CONTINUE;
    END
    MUTABLE ret = functionSignature__return_type(fn_node);
    IF !(ret) THEN
        CONTINUE;
    END
    MUTABLE ret_t = ret;
    IF ret_t.error_union?() THEN
        CONTINUE;
    END
    IF (TRUE AND type__tense?(ret_t)) THEN
        CONTINUE;
    END
    MUTABLE hint = TRY (capabilityAuditSession__fallibility_hint_for(&rtoc_self_view, rtoc_each_14));
    MUTABLE return_type = ret_t.resolved();
    MUTABLE tok = IF TRUE THEN
        fn_node.return_type_token
      ELSE
        NIL
      END;
    IF tok THEN
        MUTABLE edits = [edit__new(span__new(NIL, tok.line, tok.column, 0), "!")];
        IF fixCollector__fallibility_propagation_enabled?() THEN
          edits = ruby_array_concat_Edit__capability_audit_session(edits, CAST(TRY (capabilityAuditSession__fallibility_call_site_edits(rtoc_self_view, rtoc_each_14)) AS []Edit));
        END
        MUTABLE description_key = IF fixCollector__fallibility_propagation_enabled?() THEN
          :PROPAGATE_ERROR_UNION_TO_CALLERS
        ELSE
          :ADD_ERROR_UNION_TO_RETURN
        END;
        MUTABLE fixes = [TRY (fix__new(TRY (capabilityAuditSession__fix_description(rtoc_self_view, description_key)), edits, :auto))];
        TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ FunctionDef: COPY fn_node } }, :type, fixes, NIL, :FALLIBLE_RETURN_NEEDS_ERROR_UNION, :error, FALSE, CAST({:fn: rtoc_each_14, :hint: hint, :return_type: return_type} AS {String@symbol}Any)));
    ELSE
        TRY (capabilityAuditSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ FunctionDef: COPY fn_node } }, CapabilityAuditCodeOrMessage{ SymbolValue: :FALLIBLE_RETURN_NEEDS_ERROR_UNION }, [], CAST({:fn: rtoc_each_14, :hint: hint, :return_type: return_type} AS {String@symbol}Any)));
    END
        END
}
END
PRIVATE FN capabilityAuditSession__fallibility_call_site_edits(self: CapabilityAuditSession, name: String) RETURNS ![]Edit
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE summary: ?FunctionBodySummary = COPY (TRY (capabilityAuditSession__function_body_summaries(rtoc_self_view)))[name];
    IF summary EXISTS AS summary_value THEN
      RETURN summary_value.call_site_facts |> REDUCE(List[]) {
    IF !(_.propagates_failure) THEN
          CONTINUE;
    END
    IF !(TRY (capabilityAuditSession__fallible_call_site_fact?(rtoc_self_view, _))) THEN
          CONTINUE;
    END
    MUTABLE range = (COPY _.node).source_range;
    IF ((token__start_line(range) <= 0) OR (span__end_line(range) <= 0)) THEN
          CONTINUE;
    END
    &acc.append(edit__new(span__new(range.file, token__start_line(range), token__start_column(range), 0), "TRY ("));
    &acc.append(edit__new(span__new(range.file, span__end_line(range), range.end_column, 0), ")"));
    acc
      };
    ELSE
      RETURN CAST(( { MUTABLE rtoc_empty_list_18: []Edit = List[]; rtoc_empty_list_18 } ) AS []Edit);
    END
}
END
PRIVATE FN capabilityAuditSession__fallible_call_site_fact?(self: CapabilityAuditSession, fact: CallSiteFact) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE node = COPY fact.node;
    IF (aST__node_error_union_type(node) != NIL) THEN
      RETURN TRUE;
    END
    MUTABLE signature: ?FunctionSignature@multiowned = functionSignature__unwrap((IF locatable__matched_signature(node) EXISTS AS rtoc_wrap_2756 THEN X{ FunctionSignature: COPY rtoc_wrap_2756 } ELSE NIL END));
    IF type__error_union?((IF signature != NIL THEN
      functionSignature__return_type(signature)
    ELSE
      NIL
    END)) THEN
      RETURN TRUE;
    END
    MUTABLE intrinsic = node.matched_stdlib_def;
    IF intrinsic EXISTS AS intrinsic_value THEN
      IF functionSignature__recoverable_result?(intrinsic_value) THEN
      RETURN TRUE;
    END
    END
    MUTABLE callee: ?FunctionDef@multiowned = COPY (TRY (capabilityAuditSession__semantic_function_nodes(rtoc_self_view)))[fact.callee_name];
    RETURN ((callee != NIL) AND (callee.error_fallible == TRUE));
}
END
PRIVATE FN capabilityAuditSession__fallibility_hint_for(MUTABLE self: CapabilityAuditSession, name: String) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = TRY (capabilityAuditSession__function_node_map(rtoc_self_view));
    IF TRY (capabilityAuditSession__function_raises_directly?(rtoc_self_view, name)) THEN
      RETURN "raises directly via RAISE";
    END
    MUTABLE callees = ((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[name] OR_ELSE List[]);
    MUTABLE fallible_callee = callees |> FIND (IF fn_nodes[_] != NIL THEN
      { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_19 = (fn_nodes[_]);
    functionSignature__can_fail(rtoc_local_receiver_19) }
    ELSE
      NIL
    END);
    IF fallible_callee THEN
      RETURN "calls fallible '${fallible_callee}'";
    END
    RETURN "transitively";
}
END
PRIVATE FN capabilityAuditSession__mark_fn_value_references_mut(MUTABLE self: CapabilityAuditSession) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = TRY (capabilityAuditSession__function_node_map(rtoc_self_view));
    FOR _ IN (TRY (capabilityAuditSession__function_body_summaries(rtoc_self_view))).values() DO
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < _.escape_nodes.length() DO
      IF !(UNWRAP (_.escape_nodes[rtoc_idx]) IS_A Identifier) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF !(capabilityAuditSession__function_value_reference?(&rtoc_self_view, _.escape_nodes[rtoc_idx])) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE fn = fn_nodes[_.escape_nodes[rtoc_idx].name()];
      IF !(fn) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      fn.fn_value_ref = TRUE;
      fn.can_fail = TRUE;
    rtoc_idx = rtoc_idx + 1;
    END
    END
