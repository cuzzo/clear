PRIVATE FN capabilityAuditSession__effect_call_site_context_for(MUTABLE self: CapabilityAuditSession, caller_name: String, callee_name: String) RETURNS {String@symbol}Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    capabilityAuditSession__set_call_site_context_mut(&rtoc_self_view, caller_name, (capabilityAuditSession__effect_call_site_context(rtoc_self_view)[caller_name] OR_ELSE {}));
    MUTABLE caller_context = COPY UNWRAP (capabilityAuditSession__effect_call_site_context(rtoc_self_view)[caller_name]);
    caller_context[callee_name] = (caller_context[callee_name] OR_ELSE {:loop: FALSE, :cond: FALSE});
    MUTABLE rtoc_result = COPY UNWRAP (caller_context[callee_name]);
    capabilityAuditSession__set_call_site_context_mut(&rtoc_self_view, caller_name, COPY caller_context);
    RETURN rtoc_result;
}
END
PRIVATE FN capabilityAuditSession__effect_call_site_arg_families_for(MUTABLE self: CapabilityAuditSession, caller_name: String, callee_name: String) RETURNS ![][][Set]String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    capabilityAuditSession__set_call_site_arg_families_mut(&rtoc_self_view, caller_name, (capabilityAuditSession__effect_call_site_arg_families(rtoc_self_view)[caller_name] OR_ELSE {}));
    MUTABLE caller_families = COPY UNWRAP (capabilityAuditSession__effect_call_site_arg_families(rtoc_self_view)[caller_name]);
    IF !(caller_families.contains?(callee_name)) THEN
      caller_families[callee_name] = [];
    END
    MUTABLE rtoc_result = COPY UNWRAP (caller_families[callee_name]);
    capabilityAuditSession__set_call_site_arg_families_mut(&rtoc_self_view, caller_name, COPY caller_families);
    RETURN rtoc_result;
}
END
PRIVATE FN capabilityAuditSession__compute_effects_mut(MUTABLE self: CapabilityAuditSession) RETURNS !?{Any@multiowned}Any@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = TRY (capabilityAuditSession__function_node_map(rtoc_self_view));
    MUTABLE direct_effects = capabilityAuditSession__effect_direct_effects(rtoc_self_view);
    MUTABLE resolved = {};
    direct_effects.keys() |> EACH {
    MUTABLE effs: [Set]String@symbol = (direct_effects[_] OR_ELSE CAST(panic("missing hash key") AS [Set]String@symbol));
    resolved[_] = COPY effs;
    };
    FOR rtoc_each_6 IN fn_nodes.keys() DO
    MUTABLE fn_node: FunctionDef@multiowned = (fn_nodes[rtoc_each_6] OR_ELSE panic("missing hash key"));
    IF fn_node.tight_reentrance THEN
      CONTINUE;
    END
    MUTABLE kind: ?String = fn_node.reentrance_kind;
    IF !(([:reentrant, :reentrant_tail_call, :reentrant_thunk, :reentrant_max_depth]).contains?(kind)) THEN
        CONTINUE;
    END
    MUTABLE resolved_entry = COPY (resolved[rtoc_each_6] OR_ELSE Set[]);
    &resolved_entry.insert(:YIELD);
    resolved[rtoc_each_6] = COPY resolved_entry;
        END
    MUTABLE changed: Bool = TRUE;
    WHILE changed DO
      changed = FALSE;
      FOR rtoc_each_7 IN (TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view))).keys() DO
    MUTABLE callees: [Set]String = ((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[rtoc_each_7] OR_ELSE CAST(panic("missing hash key") AS [Set]String));
    resolved[rtoc_each_7] = (resolved[rtoc_each_7] OR_ELSE Set[]);
    MUTABLE current: ?Any = COPY resolved[rtoc_each_7];
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < callees.length() DO
        MUTABLE callee_effs: ?Any = COPY resolved[UNWRAP (callees[rtoc_idx])];
        IF !(callee_effs) THEN
              rtoc_idx = rtoc_idx + 1;
      CONTINUE;
        END
        MUTABLE before = UNWRAP (current).length();
        MUTABLE site_ctx = capabilityAuditSession__effect_call_site_context_for(&rtoc_self_view, rtoc_each_7, callees[rtoc_idx]);
        MUTABLE resolved_callee = TRY (capabilityAuditSession__resolve_maybe_effects(&rtoc_self_view, callee_effs, rtoc_each_7, callees[rtoc_idx]));
        TRY (capabilityAuditSession__inherit_effects_from_callee(rtoc_self_view, &current, resolved_callee, site_ctx));
        IF (current.size > before) THEN
              changed = TRUE;
        END
      rtoc_idx = rtoc_idx + 1;
    END
            END
    END
    fn_nodes.keys() |> EACH {
    MUTABLE fn_node: FunctionDef@multiowned = (fn_nodes[_] OR_ELSE panic("missing hash key"));
    fn_node.effects = ((resolved[_] OR_ELSE Set[]));
    };
    RETURN NIL;
}
END
PRIVATE FN capabilityAuditSession__resolve_maybe_effects(MUTABLE self: CapabilityAuditSession, callee_set: [Set]String@symbol, caller_name: String, callee_name: String) RETURNS ![Set]String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE has_block_maybe = callee_set.contains?(:BLOCKING_MAYBE);
    MUTABLE has_cont_maybe = callee_set.contains?(:CONTENTION_MAYBE);
    IF !((has_block_maybe OR has_cont_maybe)) THEN
      RETURN COPY callee_set;
    END
    MUTABLE call_sites = TRY (capabilityAuditSession__effect_call_site_arg_families_for(&rtoc_self_view, caller_name, callee_name));
    IF (call_sites.length() == 0) THEN
      RETURN COPY callee_set;
    END
    MUTABLE any_concrete_lockable: Bool = FALSE;
    MUTABLE any_concrete_sync: Bool = FALSE;
    MUTABLE any_polymorphic_arg: Bool = FALSE;
    FOR _ IN call_sites DO
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < _.length() DO
      IF (FALSE OR _[rtoc_idx]?.empty?()) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF (_[rtoc_idx]?.size > 1) THEN
          any_polymorphic_arg = TRUE;
          IF _[rtoc_idx]?.contains?(:LOCKED) THEN
            any_concrete_lockable = TRUE;
          END
          any_concrete_sync = TRUE;
      ELSE
          MUTABLE fam = _[rtoc_idx]?.first();
          IF (fam == :LOCKED) THEN
            any_concrete_lockable = TRUE;
          END
          IF ([:LOCKED, :ATOMIC, :VERSIONED]).contains?(fam) THEN
            any_concrete_sync = TRUE;
          END
      END
    rtoc_idx = rtoc_idx + 1;
    END
    END
    MUTABLE result = COPY callee_set;
    IF has_block_maybe THEN
      IF (any_concrete_lockable AND !(any_polymorphic_arg)) THEN
        &result.insert(blocking);
        &result.delete(blocking_maybe);
      ELSE_IF ((!(any_concrete_lockable) AND !(any_polymorphic_arg)) AND any_concrete_sync) THEN
        &result.delete(blocking_maybe);
      ELSE_IF any_polymorphic_arg THEN
    
      END
    END
    IF has_cont_maybe THEN
      IF (any_concrete_sync AND !(any_polymorphic_arg)) THEN
        &result.insert(contention);
        &result.delete(contention_maybe);
      ELSE_IF any_polymorphic_arg THEN
    
      ELSE
        &result.delete(contention_maybe);
      END
    END
    RETURN result;
}
END
PRIVATE FN capabilityAuditSession__inherit_effects_from_callee(self: CapabilityAuditSession, MUTABLE caller_set: [Set]String@symbol, callee_set: [Set]String@symbol, site_ctx: {String@symbol}Bool) RETURNS !?[Set]String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE in_loop: ?Bool = site_ctx[:loop];
    MUTABLE in_cond: ?Bool = site_ctx[:cond];
    FOR eff IN callee_set DO
    IF (suspendsFamily() |> ANY (_ == eff)) THEN
      MUTABLE has_loop = ((eff == suspendsLoopEffect()) OR (in_loop OR_ELSE FALSE));
      MUTABLE has_cond = ((eff == suspendsConditionalEffect()) OR (in_cond OR_ELSE FALSE));
      &caller_set.insert(suspendsEffect());
      IF has_loop THEN
        &caller_set.insert(suspendsLoopEffect());
      END
      IF has_cond THEN
        &caller_set.insert(suspendsConditionalEffect());
      END
    ELSE
      &caller_set.insert(COPY eff);
    END
    END
    RETURN NIL;
}
END
PRIVATE FN capabilityAuditSession__compute_needs_rt_mut(MUTABLE self: CapabilityAuditSession) RETURNS !Void
