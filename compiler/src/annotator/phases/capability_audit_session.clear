->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN CAST(COPY TRY (functionRegistry__fetch(capabilityAuditSession__semantic_function_registry(rtoc_self_view), name)) AS ?FunctionDef);
}
END
