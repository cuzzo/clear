PRIVATE FN capabilityAuditSession__emit_ambiguous_return_error_mut(self: CapabilityAuditSession, fn_node: FunctionDef, found_returns: []ReturnFact) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE return_types = ( { MUTABLE rtoc_map_results = CAST([] AS []Type); found_returns |> EACH { &rtoc_map_results.append(COPY _.type); }; rtoc_map_results } );
    MUTABLE arrow = COPY fn_node.arrow_token;
    MUTABLE fix = NIL;
    IF arrow THEN
      fix = TRY (fix__new(capabilityAuditSession__fix_description(rtoc_self_view, :INSERT_RETURNS_ANY), [edit__new(span__new(NIL, arrow.line, arrow.column, 0), "RETURNS :Any ")], :auto));
    END
    IF !(fix) THEN
      RETURN capabilityAuditSession__error_mut(rtoc_self_view, fn_node, CodeOrMessage{ SymbolValue: :AMBIGUOUS_RETURN }, [], {:types: return_types});
    END
    capabilityAuditSession__fixable_mut(rtoc_self_view, fn_node, :type, [fix], NIL, :AMBIGUOUS_RETURN, :error, FALSE, {:types: return_types});
}
END
PRIVATE FN capabilityAuditSession__emit_match_partial_fix_mut(self: CapabilityAuditSession, match_node: MatchStatement, code: String@symbol, kwargs: {String@symbol}DiagnosticKwValue = {}) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE tok = COPY match_node.token;
    MUTABLE fix = NIL;
    IF tok THEN
      fix = TRY (fix__new(capabilityAuditSession__fix_description(rtoc_self_view, :REPLACE_MATCH_WITH_PARTIAL), [edit__new(span__new(NIL, tok.line, tok.column, 0), "PARTIAL ")], :auto));
    END
    IF !(fix) THEN
      RETURN capabilityAuditSession__error_mut(rtoc_self_view, match_node, CodeOrMessage{ SymbolValue: COPY code }, [], castDiagnosticKwValueToAnyMultiowned(kwargs));
    END
    IF (code == :MATCH_NEEDS_ENUM_OR_UNION) THEN
      capabilityAuditSession__fixable_mut(rtoc_self_view, match_node, :type, [fix], NIL, code, :error, FALSE, {:type: kwargs.substr(:type, 1)});
    ELSE_IF (code == :MATCH_NON_EXHAUSTIVE) THEN
      capabilityAuditSession__fixable_mut(rtoc_self_view, match_node, :type, [fix], NIL, code, :error, FALSE, {:kind: kwargs.substr(:kind, 1), :name: kwargs.substr(:name, 1), :missing: kwargs.substr(:missing, 1)});
    ELSE
      panic("unsupported MATCH partial fix diagnostic: {}");
    END
}
END
PRIVATE FN capabilityAuditSession__emit_return_borrowed_no_copy_error_mut(self: CapabilityAuditSession, MUTABLE node: Locatable) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fix = NIL;
    IF node.token() THEN
      MUTABLE tok = node.token();
      fix = TRY (fix__new(capabilityAuditSession__fix_description(rtoc_self_view, :WRAP_RETURN_WITH_COPY), [edit__new(span__new(NIL, tok.line(), tok.column(), 0), "COPY ")], :auto));
    END
    MUTABLE kw = {:type: &node.full_type_mut("borrowed return diagnostic")};
    IF !(fix) THEN
      RETURN capabilityAuditSession__error_mut(rtoc_self_view, node, CodeOrMessage{ SymbolValue: :RETURN_BORROWED_NO_COPY_OR_LIFETIME }, [], kw);
    END
    capabilityAuditSession__fixable_mut(rtoc_self_view, node, :lifetime, [fix], NIL, :RETURN_BORROWED_NO_COPY_OR_LIFETIME, :error, FALSE, kw);
}
END
PRIVATE FN capabilityAuditSession__emit_cap_field_needs_with_mut(self: CapabilityAuditSession, node: GetField, code: String@symbol, name: NameCandidate, field: String, cap: String, perm: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE src: ?String = capabilityAuditSession__source_code(rtoc_self_view);
    MUTABLE kw = {:name: name, :field: field, :cap: cap};
    MUTABLE fixes = List[];
    IF (((src != NIL) AND TRUE) AND node.token) THEN
      MUTABLE line_num = node.token.line;
      MUTABLE line_text = (src.split("\n")[(line_num - 1)] OR_ELSE "");
      MUTABLE body = line_text.chomp();
      MUTABLE indent = (compilerRegexFirstMatch(body, compilerRegexCompile("\\A\\s*")) OR_ELSE "");
      MUTABLE inner = body.lstrip();
      IF (!(inner.empty?()) AND !(inner.contains?("\n"))) THEN
        MUTABLE alias_name = "${castNameCandidateToString(name)}_v";
        MUTABLE rewritten = compilerRegexReplaceAll(inner, compilerRegexCompile("\\b${compilerRegexEscape(CAST(name AS String))}\\.(?=\\w)"), "${alias_name}.");
        MUTABLE new_line = "${indent}WITH ${perm} ${castNameCandidateToString(name)} AS ${alias_name} { ${rewritten} }";
        &fixes.append(TRY (fix__new(capabilityAuditSession__fix_description(rtoc_self_view, :WRAP_CAPABILITY_ACCESS, {:permission: DiagnosticKwValue{ StringValue: COPY perm }, :name: castNameCandidateToOptionalDiagnosticKwValue(name), :alias_name: DiagnosticKwValue{ StringValue: COPY alias_name }, :capability: DiagnosticKwValue{ StringValue: COPY cap }}), [edit__new(span__new(NIL, line_num, 1, scopeBindings__length(body)), new_line)], :interactive)));
      END
    END
    IF (fixes.length() == 0) THEN
      RETURN capabilityAuditSession__error_mut(rtoc_self_view, node, CodeOrMessage{ SymbolValue: COPY code }, [], kw);
    END
    capabilityAuditSession__fixable_mut(rtoc_self_view, node, :capability, fixes, NIL, code, :error, TRUE, kw);
}
END
PRIVATE FN capabilityAuditSession__emit_foreign_with_view_needs_unsafe_mut(self: CapabilityAuditSession, node: WithBlock, fact: CapabilityTransition) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE name = COPY fact.target_label;
    MUTABLE view_token: ?Token = COPY aSTCapability__view_token(fact.source);
    MUTABLE as_token: ?Token = COPY aSTCapability__as_token(fact.source);
    IF view_token EXISTS AS view_token_value THEN
      IF as_token THEN
        MUTABLE fix = TRY (fix__new(capabilityAuditSession__fix_description(rtoc_self_view, :CONVERT_FOREIGN_VIEW_TO_UNSAFE, {:name: DiagnosticKwValue{ StringValue: COPY name }}), [edit__new(span__new(NIL, view_token_value.line, view_token_value.column, "VIEW".codepointCount()), "UNSAFE VIEW"), edit__new(span__new(NIL, as_token.line, as_token.column, 0), "LENGTH 0 ")], :interactive));
        capabilityAuditSession__fixable_mut(rtoc_self_view, node, :capability, [fix], NIL, :WITH_VIEW_FOREIGN_NEEDS_UNSAFE, :error, TRUE, {:name: name});
      ELSE
        RETURN capabilityAuditSession__error_mut(rtoc_self_view, node, CodeOrMessage{ SymbolValue: :WITH_VIEW_FOREIGN_NEEDS_UNSAFE }, [], {:name: name});
      END
    ELSE
      RETURN capabilityAuditSession__error_mut(rtoc_self_view, node, CodeOrMessage{ SymbolValue: :WITH_VIEW_FOREIGN_NEEDS_UNSAFE }, [], {:name: name});
    END
}
END
PRIVATE FN capabilityAuditSession__emit_foreign_index_needs_unsafe_view_mut(self: CapabilityAuditSession, node: GetIndex, name: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE src: ?String = capabilityAuditSession__source_code(rtoc_self_view);
    MUTABLE fixes = List[];
    IF src EXISTS AS src_value THEN
      MUTABLE line_num = node.source_range.start_line;
      MUTABLE line_text = (src_value.split("\n")[(line_num - 1)] OR_ELSE "");
      MUTABLE body = line_text.chomp();
      MUTABLE indent = (compilerRegexFirstMatch(body, compilerRegexCompile("\\A\\s*")) OR_ELSE "");
      MUTABLE inner = body.lstrip();
      MUTABLE index = COPY node.index;
      MUTABLE length: String = "";
      IF ((IF index IS_A Literal AS literal THEN literal.value IS_A Int64 ELSE FALSE END) AND (index.value() >= 0)) THEN
        length = COPY CAST(((index.value() + 1)) AS String);
      ELSE
        length = "0";
      END
      IF !(inner.empty?()) THEN
        MUTABLE alias_name = "${name}_view";
        MUTABLE rewritten = compilerRegexReplaceAll(inner, compilerRegexCompile("\\b${compilerRegexEscape(name)}\\s*(?=\\[)"), alias_name);
        MUTABLE replacement = "${indent}WITH UNSAFE VIEW ${name} LENGTH ${length} AS ${alias_name} { ${rewritten} }";
        &fixes.append(TRY (fix__new(capabilityAuditSession__fix_description(rtoc_self_view, :WRAP_FOREIGN_INDEX_UNSAFE_VIEW, {:name: DiagnosticKwValue{ StringValue: COPY name }, :length: DiagnosticKwValue{ StringValue: COPY length }, :alias_name: DiagnosticKwValue{ StringValue: COPY alias_name }}), [edit__new(span__new(NIL, line_num, 1, scopeBindings__length(body)), replacement)], :interactive)));
      END
    END
    IF (fixes.length() == 0) THEN
      RETURN capabilityAuditSession__error_mut(rtoc_self_view, node, CodeOrMessage{ SymbolValue: :FOREIGN_POINTER_DIRECT_INDEX }, [], {:name: name});
    END
    capabilityAuditSession__fixable_mut(rtoc_self_view, node, :capability, fixes, NIL, :FOREIGN_POINTER_DIRECT_INDEX, :error, TRUE, {:name: name});
}
END
PRIVATE FN capabilityAuditSession__emit_direct_view_access_finding_mut(self: CapabilityAuditSession, node: Locatable, name: String, permission: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE src: ?String = capabilityAuditSession__source_code(rtoc_self_view);
    MUTABLE fixes = List[];
    IF src EXISTS AS src_value THEN
      MUTABLE line_num = token__start_line(node.source_range());
      MUTABLE line_text = (src_value.split("\n")[(line_num - 1)] OR_ELSE "");
      MUTABLE body = line_text.chomp();
      MUTABLE indent = (compilerRegexFirstMatch(body, compilerRegexCompile("\\A\\s*")) OR_ELSE "");
      MUTABLE inner = body.lstrip();
      IF !(inner.empty?()) THEN
        MUTABLE alias_name = "${name}_view";
        MUTABLE rewritten = compilerRegexReplaceAll(inner, compilerRegexCompile("\\b${compilerRegexEscape(name)}\\b"), alias_name);
        MUTABLE replacement = "${indent}WITH ${permission} ${name} AS ${alias_name} { ${rewritten} }";
        &fixes.append(TRY (fix__new(capabilityAuditSession__fix_description(rtoc_self_view, :WRAP_DIRECT_VIEW_ACCESS, {:permission: DiagnosticKwValue{ StringValue: COPY permission }, :name: DiagnosticKwValue{ StringValue: COPY name }, :alias_name: DiagnosticKwValue{ StringValue: COPY alias_name }}), [edit__new(span__new(NIL, line_num, 1, scopeBindings__length(body)), replacement)], :interactive)));
      END
    END
    IF (fixes.length() == 0) THEN
      RETURN capabilityAuditSession__error_mut(rtoc_self_view, node, CodeOrMessage{ SymbolValue: :DIRECT_VIEW_ACCESS_REQUIRES_WITH }, [], {:name: name, :permission: permission});
    END
    capabilityAuditSession__fixable_mut(rtoc_self_view, node, :capability, fixes, NIL, :DIRECT_VIEW_ACCESS_REQUIRES_WITH, :error, TRUE, {:name: name, :permission: permission});
}
END
PRIVATE FN capabilityAuditSession__emit_with_guard_all_bindings_need_as_mut(self: CapabilityAuditSession, node: WithBlock, missing_caps: []CapabilityTransition) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE edits = List[];
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < missing_caps.length() DO
      MUTABLE vn = COPY missing_caps[rtoc_idx]?.var_node;
      IF !(((IF vn IS_A Identifier AS identifier THEN TRUE ELSE FALSE END) AND vn.token())) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE tok = vn.token();
      MUTABLE name = COPY CAST(vn.name() AS String);
      &edits.append(edit__new(span__new(NIL, tok.line(), (tok.column() + name.codepointCount()), 0), " AS ${name}_v"));
    rtoc_idx = rtoc_idx + 1;
    END
    IF (edits.length() == 0) THEN
      RETURN capabilityAuditSession__error_mut(rtoc_self_view, node, CodeOrMessage{ SymbolValue: :WITH_GUARD_ALL_BINDINGS_NEED_AS });
    END
    MUTABLE fix = TRY (fix__new(capabilityAuditSession__fix_description(rtoc_self_view, :ADD_WITH_GUARD_ALIASES), edits, :auto));
    capabilityAuditSession__fixable_mut(rtoc_self_view, node, :capability, [fix], NIL, :WITH_GUARD_ALL_BINDINGS_NEED_AS, :error, TRUE);
}
END
PRIVATE FN capabilityAuditSession__emit_with_guard_mutable_mutated_mut(self: CapabilityAuditSession, node: WithBlock, names_input: []String, verb: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE names = COPY names_input;
    MUTABLE src: ?String = capabilityAuditSession__source_code(rtoc_self_view);
    names = names.to_a();
    MUTABLE edits = List[];
    IF (((src != NIL) AND TRUE) AND node.token) THEN
      MUTABLE with_line = node.token.line;
      MUTABLE window_lines = (src.split("\n").substr(((with_line - 1)), ((((with_line + 8)) - ((with_line - 1))) + 1)) OR_ELSE List[]);
      FOR _ IN names DO
    MUTABLE pat = compilerRegexCompile("\\bMUTABLE\\s+${compilerRegexEscape(_)}\\b");
    MUTABLE off = 0;
    MUTABLE found: Bool = FALSE;
    WHILE ((off < window_lines.codepointCount()) AND !(found)) DO
          MUTABLE line = window_lines.substr(off, 1);
          MUTABLE idx = compilerRegexMatch(line, pat);
          IF idx THEN
            MUTABLE line_no = (with_line + off);
            MUTABLE mut_col = (idx + 1);
            &edits.append(edit__new(span__new(NIL, line_no, mut_col, "MUTABLE ".codepointCount()), ""));
            found = TRUE;
          END
          off = (off + 1);
    END
      END
    END
    MUTABLE names_str = (names |> SELECT "'${_}'").join(", ");
    MUTABLE kw = {:names: names_str, :verb: verb};
    IF (edits.length() == 0) THEN
      RETURN capabilityAuditSession__error_mut(rtoc_self_view, node, CodeOrMessage{ SymbolValue: :WITH_GUARD_MUTABLE_MUTATED }, [], kw);
    END
    MUTABLE target: String = "";
    IF (names.length() == 1) THEN
      target = "the alias";
    ELSE
      target = "each guarded alias";
    END
    MUTABLE fix = TRY (fix__new(capabilityAuditSession__fix_description(rtoc_self_view, :DROP_WITH_GUARD_MUTABLE, {:target: DiagnosticKwValue{ StringValue: COPY target }}), edits, :interactive));
    capabilityAuditSession__fixable_mut(rtoc_self_view, node, :capability, [fix], NIL, :WITH_GUARD_MUTABLE_MUTATED, :error, TRUE, kw);
}
END
PRIVATE FN capabilityAuditSession__emit_with_read_needs_write_lock_mut(self: CapabilityAuditSession, node: WithBlock, name: String, MUTABLE var_node: Locatable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE syn = cap_var_sync(&var_node);
    MUTABLE fix_branch_value: ?Fix@multiowned = NIL;
    IF (syn == :locked) THEN
      fix_branch_value = capabilityAuditSession__build_decl_cap_replace_fix(rtoc_self_view, name, "@locked", "@writeLocked", :REPLACE_LOCKED_WITH_WRITE_LOCKED, {}, :auto);
    ELSE
      fix_branch_value = capabilityAuditSession__build_decl_cap_insert_fix(rtoc_self_view, name, "@writeLocked", :WITH_ADD_WRITE_LOCKED, CAST({:reader: DiagnosticKwValue{ StringValue: COPY "via `WITH READ`" }} AS {String@symbol}?DiagnosticKwValue), :auto);
    END
    MUTABLE fix: ?Fix@multiowned = fix_branch_value;
    IF fix EXISTS AS fix_value THEN
      capabilityAuditSession__fixable_mut(rtoc_self_view, node, :capability, [fix_value], NIL, :WITH_READ_NEEDS_WRITE_LOCK, :error, TRUE, {:name: name});
    ELSE
      RETURN capabilityAuditSession__error_mut(rtoc_self_view, node, CodeOrMessage{ SymbolValue: :WITH_READ_NEEDS_WRITE_LOCK }, [], {:name: name});
    END
}
END
PRIVATE FN capabilityAuditSession__emit_with_cannot_infer_cap_mut(self: CapabilityAuditSession, node: WithBlock, name: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE candidates = [{:sigil: "@multiowned", :description_code: :WITH_ADD_MULTIOWNED, :description_params: {:suffix: ""}}, {:sigil: "@shared", :description_code: :WITH_ADD_SHARED, :description_params: {:suffix: "across fibers"}}, {:sigil: "@locked", :description_code: :WITH_ADD_LOCKED, :description_params: {}}, {:sigil: "@writeLocked", :description_code: :WITH_ADD_WRITE_LOCKED, :description_params: {:reader: "via WITH READ"}}];
    MUTABLE fixes = candidates |> SELECT:? capabilityAuditSession__build_decl_cap_insert_fix(rtoc_self_view, name, _[:sigil], _[:description_code], _[:description_params], :interactive) |> WHERE _ != NIL;
    IF (fixes.length() == 0) THEN
      RETURN capabilityAuditSession__error_mut(rtoc_self_view, node, CodeOrMessage{ SymbolValue: :WITH_CANNOT_INFER_CAP }, [], {:name: name});
    END
    capabilityAuditSession__fixable_mut(rtoc_self_view, node, :capability, fixes, NIL, :WITH_CANNOT_INFER_CAP, :error, TRUE, {:name: name});
}
END
PRIVATE FN capabilityAuditSession__emit_with_materialized_needs_tense_mut(self: CapabilityAuditSession, node: WithBlock, name: String, got: TypeTypeInput) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE src: ?String = capabilityAuditSession__source_code(rtoc_self_view);
    MUTABLE scope: ?Scope@multiowned = capabilityAuditSession__lookup_scope_for(rtoc_self_view, name);
    MUTABLE decl: ?SymbolEntryRegInput = NIL;
    IF (IF scope != NIL THEN
      scope__resolve_entry(scope, name)
    ELSE
      NIL
    END) != NIL THEN
      decl = COPY (((IF scope != NIL THEN
      scope__resolve_entry(scope, name)
    ELSE
      NIL
    END))?).reg;
    END
    MUTABLE fix = NIL;
    IF ((decl != NIL) AND (src != NIL)) THEN
      MUTABLE token = IF respondsTo?(decl, "token") THEN
        decl.token()
      ELSE
        NIL
      END;
      IF token THEN
        MUTABLE dline = token.line();
        MUTABLE line_text = (src.split("\n")[(dline - 1)] OR_ELSE "");
        MUTABLE search_offset = (token.column() - 1);
        MUTABLE ann_match: ?CompilerRegexScanner = NIL;
        IF line_text.substr(search_offset, (line_text.length() - search_offset)) != NIL THEN
          ann_match = COPY compilerRegexMatchData(((line_text.substr(search_offset, (line_text.length() - search_offset)))?), compilerRegexCompile(":\\s*([A-Za-z_][\\w]*)"));
        END
        IF ((ann_match != NIL) AND !(line_text.contains?("~"))) THEN
          MUTABLE type_col = ((search_offset + ann_match.begin(1)) + 1);
          fix = TRY (fix__new(capabilityAuditSession__fix_description(rtoc_self_view, :PREFIX_TENSE_TYPE, {:name: DiagnosticKwValue{ StringValue: COPY name }}), [edit__new(span__new(NIL, dline, type_col, 0), "~")], :interactive));
        END
      END
    END
    MUTABLE kw = {:name: name, :got: got};
    IF !(fix) THEN
      RETURN capabilityAuditSession__error_mut(rtoc_self_view, node, CodeOrMessage{ SymbolValue: :WITH_MATERIALIZED_NEEDS_TENSE }, [], kw);
    END
    capabilityAuditSession__fixable_mut(rtoc_self_view, node, :capability, [fix], NIL, :WITH_MATERIALIZED_NEEDS_TENSE, :error, TRUE, kw);
}
END
PRIVATE FN capabilityAuditSession__emit_with_restrict_immutable_error_mut(self: CapabilityAuditSession, node: WithBlock, var_node: Identifier) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE name = COPY var_node.name;
    MUTABLE scope = ((var_node.symbol?.scope) OR_ELSE capabilityAuditSession__current_scope(rtoc_self_view));
    MUTABLE fix: ?Fix@multiowned = capabilityAuditSession__build_declare_mutable_fix(rtoc_self_view, name, scope);
    IF fix EXISTS AS fix_value THEN
      capabilityAuditSession__fixable_mut(rtoc_self_view, node, :capability, [fix_value], NIL, :WITH_RESTRICT_NEEDS_MUTABLE, :error, FALSE, {:name: name});
    ELSE
      RETURN capabilityAuditSession__error_mut(rtoc_self_view, node, CodeOrMessage{ SymbolValue: :WITH_RESTRICT_NEEDS_MUTABLE }, [], {:name: name});
    END
}
END
PRIVATE FN capabilityAuditSession__emit_can_smash_unsupported_error_mut(self: CapabilityAuditSession, node: AsyncValidationNode) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fix = NIL;
    MUTABLE tok = IF respondsTo?(node, "can_smash_token") THEN
      node.can_smash_token()
    ELSE
      NIL
    END;
    IF tok THEN
      fix = TRY (fix__new(capabilityAuditSession__fix_description(rtoc_self_view, :REPLACE_CAN_SMASH_WITH_SERVICE), [edit__new(span__new(NIL, tok.line(), tok.column(), (CAST(tok.value() AS String)).codepointCount()), "@service")], :auto));
    END
    IF !(fix) THEN
      RETURN capabilityAuditSession__error_mut(rtoc_self_view, node, CodeOrMessage{ SymbolValue: :CAN_SMASH_NOT_SUPPORTED });
    END
    capabilityAuditSession__fixable_mut(rtoc_self_view, node, :reentrance, [fix], NIL, :CAN_SMASH_NOT_SUPPORTED, :error);
}
END
PRIVATE FN capabilityAuditSession__emit_type_mismatch_assign_error_mut(self: CapabilityAuditSession, node: Node, target_type: TypeTypeInput, value_type: String@symbol) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE kw = {:got: value_type, :expected: target_type};
    MUTABLE value = node.value();
    MUTABLE fix: ?Fix@multiowned = capabilityAuditSession__build_cast_wrap_fix(rtoc_self_view, value, target_type);
    IF fix EXISTS AS fix_value THEN
      capabilityAuditSession__fixable_mut(rtoc_self_view, node, :type, [fix_value], NIL, :TYPE_MISMATCH_ASSIGN, :error, FALSE, kw);
    ELSE
      RETURN capabilityAuditSession__error_mut(rtoc_self_view, node, CodeOrMessage{ SymbolValue: :TYPE_MISMATCH_ASSIGN }, [], kw);
    END
}
END
PRIVATE FN capabilityAuditSession__literal_source_length(self: CapabilityAuditSession, tok: Token) RETURNS Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE src: ?String = capabilityAuditSession__source_code(rtoc_self_view);
    IF src EXISTS AS src_value THEN
      MUTABLE line: ?String = COPY src_value.split("\n")[(tok.line - 1)];
      IF line EXISTS AS line_value THEN
        MUTABLE rest = line_value.substr(((tok.column - 1)), (line_value.length() - ((tok.column - 1))));
        IF (FALSE OR (rest.length() == 0)) THEN
          RETURN (CAST(tok.value AS String)).codepointCount();
        END
        IF rest.startsWith?("\"\"\"") THEN
          MUTABLE idx: ?Int64 = rest.indexOf("\"\"\"", 3);
          IF idx EXISTS AS idx_value THEN
            RETURN (idx_value + 3);
          ELSE
            RETURN (CAST(tok.value AS String)).codepointCount();
          END
        END
        IF rest.startsWith?("\"") THEN
          MUTABLE i = 1;
          WHILE (i < rest.codepointCount()) DO
            MUTABLE ch = rest.substr(i, 1);
            IF (ch == "\"") THEN
              BREAK;
            END
            IF ((ch == "\\") AND ((i + 1) < rest.codepointCount())) THEN
              i = (i + 1);
            END
            i = (i + 1);
          END
          RETURN (i + 1);
        END
        MUTABLE m: ?CompilerRegexScanner = compilerRegexMatchData(rest, compilerRegexCompile("\\A[\\d_a-zA-Z.]+"));
        IF m EXISTS AS m_value THEN
          RETURN compilerRegexCapture(m_value, 0).codepointCount();
        ELSE
          RETURN (CAST(tok.value AS String)).codepointCount();
        END
      ELSE
        RETURN (CAST(tok.value AS String)).codepointCount();
      END
    ELSE
      RETURN (CAST(tok.value AS String)).codepointCount();
    END
}
END
PRIVATE FN capabilityAuditSession__build_cast_wrap_fix(self: CapabilityAuditSession, value: ?Locatable, target_type: TypeTypeInput) RETURNS !?Fix
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF value EXISTS AS value_value THEN
      IF !(value_value.token()) THEN
        RETURN NIL;
      END
      MUTABLE tok = value_value.token();
      MUTABLE target_name_branch_value: ?TypeTypeInput = NIL;
      IF target_type IS_A Type AS type THEN
        target_name_branch_value = TypeTypeInput{ SymbolValue: COPY type__resolved(type) };
      ELSE
        target_name_branch_value = COPY target_type;
      END
      MUTABLE target_name: TypeTypeInput = target_name_branch_value?;
      MUTABLE text_length = PARTIAL MATCH value_value START
        Locatable.Literal AS literal -> capabilityAuditSession__literal_source_length(rtoc_self_view, tok),
        Locatable.Identifier AS identifier -> identifier__name(identifier).codepointCount(),
        DEFAULT -> NIL
      END;
      IF !(text_length) THEN
        RETURN NIL;
      END
      RETURN TRY (fix__new(capabilityAuditSession__fix_description(rtoc_self_view, :WRAP_VALUE_WITH_CAST, {:type: castTypeTypeInputToOptionalDiagnosticKwValue(target_name)}), [edit__new(span__new(NIL, tok.line(), tok.column(), 0), "CAST("), edit__new(span__new(NIL, tok.line(), (tok.column() + text_length), 0), " AS ${castTypeTypeInputToString(target_name)})")], :interactive));
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN capabilityAuditSession__build_decl_cap_insert_fix(self: CapabilityAuditSession, name: String, sigil: String, description_code: String@symbol = :ADD_DECL_CAPABILITY_GENERIC, description_params: {String@symbol}DiagnosticKwValue, confidence: String@symbol = :auto) RETURNS !?Fix
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE src: ?String = capabilityAuditSession__source_code(rtoc_self_view);
    MUTABLE scope: ?Scope@multiowned = capabilityAuditSession__lookup_scope_for(rtoc_self_view, name);
    MUTABLE decl: ?SymbolEntryRegInput = NIL;
    IF (IF scope != NIL THEN
      scope__resolve_entry(scope, name)
    ELSE
      NIL
    END) != NIL THEN
      decl = COPY (((IF scope != NIL THEN
      scope__resolve_entry(scope, name)
    ELSE
      NIL
    END))?).reg;
    END
    IF !((((decl != NIL) AND respondsTo?(decl, "token")) AND decl.token())) THEN
      RETURN NIL;
    END
    IF src EXISTS AS src_value THEN
      MUTABLE dline = decl.token().line();
      MUTABLE line_text = (src_value.split("\n")[(dline - 1)] OR_ELSE "");
      MUTABLE semi_idx: ?Int64 = line_text.indexOf(";", (decl.token().column() - 1));
      IF semi_idx EXISTS AS semi_idx_value THEN
        IF line_text.contains?(sigil) THEN
          RETURN NIL;
        END
        MUTABLE insert_col = (semi_idx_value + 1);
        MUTABLE fix_params = {:sigil: sigil, :name: name, :line: dline}.keys() |> REDUCE(COPY description_params) { acc[_] = COPY ({:sigil: sigil, :name: name, :line: dline}[_] OR_ELSE panic("missing hash key")); acc };
        RETURN TRY (fix__new(capabilityAuditSession__fix_description_from_hash(rtoc_self_view, description_code, fix_params), [edit__new(span__new(NIL, dline, insert_col, 0), " ${sigil}")], confidence));
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN capabilityAuditSession__build_decl_cap_replace_fix(self: CapabilityAuditSession, name: String, old_sigil: String, new_sigil: String, description_code: String@symbol = :CHANGE_DECL_CAPABILITY_GENERIC, description_params: {String@symbol}DiagnosticKwValue, confidence: String@symbol = :auto) RETURNS !?Fix
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE src: ?String = capabilityAuditSession__source_code(rtoc_self_view);
    MUTABLE scope: ?Scope@multiowned = capabilityAuditSession__lookup_scope_for(rtoc_self_view, name);
    MUTABLE decl: ?SymbolEntryRegInput = NIL;
    IF (IF scope != NIL THEN
      scope__resolve_entry(scope, name)
    ELSE
      NIL
    END) != NIL THEN
      decl = COPY (((IF scope != NIL THEN
      scope__resolve_entry(scope, name)
    ELSE
      NIL
    END))?).reg;
    END
    IF !((((decl != NIL) AND respondsTo?(decl, "token")) AND decl.token())) THEN
      RETURN NIL;
    END
    IF src EXISTS AS src_value THEN
      MUTABLE dline = decl.token().line();
      MUTABLE line_text = (src_value.split("\n")[(dline - 1)] OR_ELSE "");
      MUTABLE idx: ?Int64 = line_text.indexOf(old_sigil);
      IF idx EXISTS AS idx_value THEN
        MUTABLE fix_params = {:old_sigil: old_sigil, :new_sigil: new_sigil, :name: name, :line: dline}.keys() |> REDUCE(COPY description_params) { acc[_] = COPY ({:old_sigil: old_sigil, :new_sigil: new_sigil, :name: name, :line: dline}[_] OR_ELSE panic("missing hash key")); acc };
        RETURN TRY (fix__new(capabilityAuditSession__fix_description_from_hash(rtoc_self_view, description_code, fix_params), [edit__new(span__new(NIL, dline, (idx_value + 1), old_sigil.codepointCount()), new_sigil)], confidence));
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN capabilityAuditSession__emit_with_cap_mismatch_mut(self: CapabilityAuditSession, node: WithBlock, name: String, code: String@symbol, candidates: []CapabilityFixCandidate, confidence: String@symbol = :auto, kw: {String@symbol}DiagnosticKwValue = {}) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fixes = candidates |> SELECT:? capabilityAuditSession__build_decl_cap_insert_fix(rtoc_self_view, name, _.sigil, _.description_code, _.description_params, confidence) |> WHERE _ != NIL;
    IF (fixes.length() == 0) THEN
      RETURN capabilityAuditSession__error_mut(rtoc_self_view, node, CodeOrMessage{ SymbolValue: COPY code }, [], castDiagnosticKwValueToAnyMultiowned(kw));
    END
    IF (code == :WITH_EXCLUSIVE_NEEDS_LOCK) THEN
      capabilityAuditSession__fixable_mut(rtoc_self_view, node, :capability, fixes, NIL, code, :error, TRUE, {:got: kw.substr(:got, 1)});
    ELSE_IF (code == :WITH_SNAPSHOT_NEEDS_VERSIONED_OR_ATOMIC) OR (code == :WITH_ATOMIC_NEEDS_SHARED_ATOMIC) THEN
      capabilityAuditSession__fixable_mut(rtoc_self_view, node, :capability, fixes, NIL, code, :error, TRUE, {:name: kw.substr(:name, 1), :actual: kw.substr(:actual, 1)});
    ELSE_IF (code == :WITH_NEEDS_MULTIOWNED) OR (code == :WITH_NEEDS_SHARED) THEN
      capabilityAuditSession__fixable_mut(rtoc_self_view, node, :capability, fixes, NIL, code, :error, TRUE, {:name: kw.substr(:name, 1)});
    ELSE
      panic("unsupported WITH capability mismatch diagnostic: {}");
    END
}
END
PRIVATE FN capabilityAuditSession__build_declare_mutable_fix(self: CapabilityAuditSession, name: String, scope: Scope) RETURNS !?Fix
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE info: ?SymbolEntry@multiowned = scope__resolve_entry(scope, name);
    IF info EXISTS AS info_value THEN
      MUTABLE tok = NIL;
      MUTABLE decl: ?SymbolEntryRegInput = COPY info_value.reg;
      IF ((decl != NIL) AND decl.token()) THEN
        tok = decl.token();
      ELSE_IF (symbolEntry__is_param(info_value) AND (KEEP info_value.param_decl_token != NIL)) THEN
        tok = COPY KEEP info_value.param_decl_token;
      END
      IF !(tok) THEN
        RETURN NIL;
      END
      IF (tok.value() == "MUTABLE") THEN
        RETURN NIL;
      END
      RETURN TRY (fix__new(capabilityAuditSession__fix_description(rtoc_self_view, :DECLARE_MUTABLE_BINDING, {:name: DiagnosticKwValue{ StringValue: COPY name }, :line: tok.line()}), [edit__new(span__new(NIL, tok.line(), tok.column(), 0), "MUTABLE ")], :auto));
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN capabilityAuditSession__build_atomic_escape_migration_fix(self: CapabilityAuditSession, source_sym: SymbolEntry, source_name: String) RETURNS !?Fix
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE src: ?String = capabilityAuditSession__source_code(rtoc_self_view);
    IF !(((TRUE AND TRUE) AND symbolEntry__atomic?(source_sym))) THEN
      RETURN NIL;
    END
    IF src EXISTS AS src_value THEN
      MUTABLE reg_branch_value: ?SymbolEntryRegInput = NIL;
      IF TRUE THEN
        reg_branch_value = COPY source_sym.reg;
      ELSE
        reg_branch_value = NIL;
      END
      MUTABLE reg: ?SymbolEntryRegInput = reg_branch_value;
      IF reg EXISTS AS reg_value THEN
        IF reg_value.token() THEN
          MUTABLE line_num = reg_value.token().line();
          IF !(line_num) THEN
            RETURN NIL;
          END
          MUTABLE src_line = (src_value.split("\n")[(line_num - 1)] OR_ELSE "");
          MUTABLE search_offset = (reg_value.token().column() - 1);
          MUTABLE match: ?CompilerRegexScanner = NIL;
          IF src_line.substr(search_offset, (src_line.length() - search_offset)) != NIL THEN
            match = COPY compilerRegexMatchData(((src_line.substr(search_offset, (src_line.length() - search_offset)))?), compilerRegexCompile("@(?:shared:atomic|atomic:shared)"));
          END
          IF match EXISTS AS match_value THEN
            MUTABLE start_col = ((search_offset + match_value.begin(0)) + 1);
            RETURN TRY (fix__new(capabilityAuditSession__fix_description(rtoc_self_view, :MIGRATE_ATOMIC_ESCAPE, {:name: DiagnosticKwValue{ StringValue: COPY source_name }}), [edit__new(span__new(NIL, line_num, start_col, compilerRegexCapture(match_value, 0).codepointCount()), "@shared:locked")], :interactive));
          ELSE
            RETURN NIL;
          END
        ELSE
          RETURN NIL;
        END
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN capabilityAuditSession__auto_rank_candidates(self: CapabilityAuditSession, ops: [Set]String@symbol) RETURNS ![]AutoCandidate
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (FALSE OR ops.empty?()) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_3: []AutoCandidate = List[]; rtoc_empty_list_3 } ) AS []AutoCandidate);
    END
    MUTABLE agg = {};
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < ops.length() DO
      MUTABLE entry: ?{String@symbol}Any@multiowned = COPY (CAST({:ADD: CAST({:default: :Int64, :alts: [:Float64]} AS {String@symbol}Any@multiowned), :CONCAT: CAST({:default: :String, :alts: List[]} AS {String@symbol}Any@multiowned), :SUB: CAST({:default: :Int64, :alts: [:Float64]} AS {String@symbol}Any@multiowned), :MUL: CAST({:default: :Int64, :alts: [:Float64]} AS {String@symbol}Any@multiowned), :DIV: CAST({:default: :Float64, :alts: [:Int64], :notes: {:Int64: "integer division \u{2014} TRUNCATES toward zero"}} AS {String@symbol}Any@multiowned), symbol("MOD"): CAST({:default: :Int64, :alts: List[]} AS {String@symbol}Any@multiowned), :EQ: CAST({:default: :Int64, :alts: [:Float64, :String]} AS {String@symbol}Any@multiowned), :NEQ: CAST({:default: :Int64, :alts: [:Float64, :String]} AS {String@symbol}Any@multiowned), :LT: CAST({:default: :Int64, :alts: [:Float64, :String]} AS {String@symbol}Any@multiowned), :GT: CAST({:default: :Int64, :alts: [:Float64, :String]} AS {String@symbol}Any@multiowned), :LTE: CAST({:default: :Int64, :alts: [:Float64, :String]} AS {String@symbol}Any@multiowned), :GTE: CAST({:default: :Int64, :alts: [:Float64, :String]} AS {String@symbol}Any@multiowned), symbol("AND"): CAST({:default: :Bool, :alts: List[]} AS {String@symbol}Any@multiowned), symbol("OR"): CAST({:default: :Bool, :alts: List[]} AS {String@symbol}Any@multiowned)} AS {String@symbol}{String@symbol}Any@multiowned))[ops[rtoc_idx]];
      IF !(entry) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE default: String@symbol = COPY CAST(entry[:default] AS String@symbol);
      MUTABLE alts: []String@symbol = CAST((entry[:alts] OR_ELSE List[]) AS []String@symbol);
      MUTABLE notes: {String@symbol}String = CAST((entry[:notes] OR_ELSE {}) AS {String@symbol}String);
      MUTABLE ranked = ([default] + alts);
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < ranked.length() DO
          MUTABLE stat: ?Any = COPY agg[ranked[rtoc_idx]];
          IF !(stat) THEN
              stat = {:count: 0, :rank_sum: 0, :notes: List[]};
              agg[ranked[rtoc_idx]] = UNWRAP (stat);
          END
          stat[:count] = (CAST(stat[:count] AS Int64) + 1);
          stat[:rank_sum] = (CAST(stat[:rank_sum] AS Int64) + rtoc_idx);
          IF notes[ranked[rtoc_idx]] THEN
              (CAST(stat[:notes] AS []String)).append(UNWRAP (notes[ranked[rtoc_idx]]));
          END
        rtoc_idx = rtoc_idx + 1;
      END
    rtoc_idx = rtoc_idx + 1;
    END
    MUTABLE n_ops = ops.size();
    MUTABLE intersection = agg |> WHERE (_._1[:count] == n_ops);
    RETURN (intersection |> ORDER_BY _._1[:rank_sum]).keys() |> SELECT AutoCandidate{ type_sym: COPY CAST(_ AS String@symbol), note: COPY (CAST(((CAST(((intersection |> ORDER_BY _._1[:rank_sum])[_] OR_ELSE panic("missing hash key"))[:notes] AS []String)) |> DISTINCT _) AS []String)).first() };
}
END
PRIVATE FN capabilityAuditSession__build_auto_candidate_fix(self: CapabilityAuditSession, slot: Slot, type_sym: String@symbol, note: ?String, position: Int64) RETURNS !?Fix
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE auto_tok: ?Token@multiowned = capabilityAuditSession__auto_token_for(rtoc_self_view, slot);
    IF auto_tok EXISTS AS auto_tok_value THEN
      MUTABLE type_str = COPY CAST(type_sym AS String);
      RETURN TRY (fix__new(capabilityAuditSession__fix_description(rtoc_self_view, :PIN_AUTO_SLOT, {:position: DiagnosticKwValue{ Int64Value: position }, :label: ruby_wrap_optional_String_DiagnosticKwValue(capabilityAuditSession__auto_slot_label(rtoc_self_view, slot)), :type: DiagnosticKwValue{ StringValue: COPY type_str }, :note: DiagnosticKwValue{ StringValue: COPY IF note != NIL THEN
        " ${note}"
      ELSE
        ""
      END }}), [edit__new(span__new(NIL, auto_tok_value.line, auto_tok_value.column, "Auto".codepointCount()), type_str)], :interactive));
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN capabilityAuditSession__build_auto_op_evidence_block(self: CapabilityAuditSession, ops: [Set]String@symbol, candidates: []AutoCandidate) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (candidates.length() == 0) THEN
      RETURN "";
    END
    MUTABLE op_list = ((ops |> SELECT COPY _) |> ORDER_BY _).join(", ");
    MUTABLE msg = "\n  In the body, the binding is used in operator(s): ${op_list}.\n";
    msg = (msg $+ "  Suggested fixes:\n");
    MUTABLE idx = 0;
    WHILE (idx < candidates.length()) DO
      MUTABLE candidate: ?AutoCandidate = COPY candidates[idx];
      MUTABLE type_sym = candidate.type_sym;
      MUTABLE note: ?String = candidate.note;
      MUTABLE label = "";
      IF (idx == 0) THEN
        label = "(recommended)";
      END
      MUTABLE line = "    ${(idx + 1).toString()}. ${label.ljust(15)} ${type_sym}";
      IF note EXISTS AS note_value THEN
        line = (line $+ "  -- ${note_value}");
      END
      msg = (msg $+ line);
      msg = (msg $+ "\n");
      idx = (idx + 1);
    END
    RETURN msg;
}
END
PRIVATE FN capabilityAuditSession__emit_auto_resolved_finding_mut(self: CapabilityAuditSession, resolution: Resolution) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE slot = COPY resolution.slot;
    IF (TRUE AND (slot.shape != NIL)) THEN
      RETURN;
    END
    MUTABLE type_str = capabilityAuditSession__auto_type_source_form(rtoc_self_view, castTypeToAutoConstraintCollectorObservedType(resolution.type));
    MUTABLE label: ?String = capabilityAuditSession__auto_slot_label(rtoc_self_view, slot);
    MUTABLE auto_tok: ?Token@multiowned = capabilityAuditSession__auto_token_for(rtoc_self_view, slot);
    capabilityAuditSession__fixable_mut(rtoc_self_view, (auto_tok OR_ELSE slot.decl_node), :type, capabilityAuditSession__build_auto_replace_fixes(rtoc_self_view, CAST(auto_tok AS ?Token), type_str), NIL, :AUTO_INFERRED_TYPE, :info, FALSE, {:label: label, :type: type_str});
}
END
PRIVATE FN capabilityAuditSession__emit_auto_shape_resolved_finding_mut(self: CapabilityAuditSession, decl: AutoConstraintCollectorSlotDeclNode, slot: Slot) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((decl IS_A VarDecl OR decl IS_A BindExpr)) THEN
      RETURN;
    END
    IF !(decl.type()) THEN
      RETURN;
    END
    IF type__auto?(decl.type()) THEN
      RETURN;
    END
    MUTABLE type_str = capabilityAuditSession__auto_type_source_form(rtoc_self_view, castTypeToAutoConstraintCollectorObservedType(decl.type()));
    MUTABLE name: String = "";
    IF TRUE THEN
      name = (MATCH decl START AutoConstraintCollectorSlotDeclNode.FunctionDefMultiowned AS item -> item.name, AutoConstraintCollectorSlotDeclNode.VarDecl AS item -> item.name, AutoConstraintCollectorSlotDeclNode.BindExpr AS item -> item.name END);
    ELSE
      name = "<binding>";
    END
    MUTABLE auto_tok: ?Token@multiowned = capabilityAuditSession__auto_token_for(rtoc_self_view, slot);
    capabilityAuditSession__fixable_mut(rtoc_self_view, (auto_tok OR_ELSE decl), :type, capabilityAuditSession__build_auto_replace_fixes(rtoc_self_view, CAST(auto_tok AS ?Token), type_str), NIL, :AUTO_INFERRED_BINDING_TYPE, :info, FALSE, {:name: name, :type: type_str});
}
END
PRIVATE FN capabilityAuditSession__build_auto_replace_fixes(self: CapabilityAuditSession, auto_tok: ?Token, type_str: String) RETURNS ![]Fix
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF auto_tok EXISTS AS auto_tok_value THEN
      RETURN CAST([TRY (fix__new(capabilityAuditSession__fix_description(rtoc_self_view, :REPLACE_AUTO_WITH_INFERRED, {:type: DiagnosticKwValue{ StringValue: COPY type_str }}), [edit__new(span__new(NIL, auto_tok_value.line, auto_tok_value.column, "Auto".codepointCount()), type_str)], :auto))] AS []Fix);
    ELSE
      RETURN CAST(( { MUTABLE rtoc_empty_list_4: []Fix = List[]; rtoc_empty_list_4 } ) AS []Fix);
    END
}
END
PRIVATE FN capabilityAuditSession__emit_auto_ambiguity_finding_mut(self: CapabilityAuditSession, ambiguity: Ambiguity, op_evidence: {AutoSlotId}[Set]String@symbol) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE slot = COPY ambiguity.slot;
    MUTABLE label: ?String = capabilityAuditSession__auto_slot_label(rtoc_self_view, slot);
    MUTABLE observed = COPY ambiguity.observed_types;
    MUTABLE observed_strs = observed |> SELECT capabilityAuditSession__auto_type_source_form(rtoc_self_view, _);
    MUTABLE message = capabilityAuditSession__build_auto_ambiguity_message(rtoc_self_view, label?, observed_strs, slot);
    MUTABLE slot_id: ?AutoSlotId@multiowned = capabilityAuditSession__slot_id_for(rtoc_self_view, slot);
    MUTABLE ops: [Set]Any = Set[];
    IF slot_id EXISTS AS slot_id_value THEN
      ops = ((op_evidence[slot_id_value] OR_ELSE Set[]));
    ELSE
      ops = Set[];
    END
    MUTABLE candidates = capabilityAuditSession__auto_rank_candidates(rtoc_self_view, ops);
    IF !((candidates.length() == 0)) THEN
      message = (message $+ capabilityAuditSession__build_auto_op_evidence_block(rtoc_self_view, ops, candidates));
    END
    MUTABLE fixes = List[];
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < candidates.length() DO
      MUTABLE fix: ?Fix@multiowned = capabilityAuditSession__build_auto_candidate_fix(rtoc_self_view, slot, candidates[rtoc_idx]?.type_sym, candidates[rtoc_idx]?.note, (rtoc_idx + 1));
      IF fix EXISTS AS fix_value THEN
          &fixes.append(fix_value);
      END
    rtoc_idx = rtoc_idx + 1;
    END
    MUTABLE auto_tok: ?Token@multiowned = capabilityAuditSession__auto_token_for(rtoc_self_view, slot);
    capabilityAuditSession__fixable_mut(rtoc_self_view, (auto_tok OR_ELSE slot.decl_node), :type, fixes, NIL, :AUTO_AMBIGUOUS_TYPE, :error, FALSE, {:detail: message});
}
END
PRIVATE FN capabilityAuditSession__emit_auto_unresolved_finding_mut(self: CapabilityAuditSession, slot: Slot, op_evidence: {AutoSlotId}[Set]String@symbol) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE label: ?String = capabilityAuditSession__auto_slot_label(rtoc_self_view, slot);
    MUTABLE base_msg = "Cannot infer type for ${label} \u{2014} no observed uses to drive inference.";
    MUTABLE slot_id: ?AutoSlotId@multiowned = capabilityAuditSession__slot_id_for(rtoc_self_view, slot);
    MUTABLE ops: [Set]Any = Set[];
    IF slot_id EXISTS AS slot_id_value THEN
      ops = ((op_evidence[slot_id_value] OR_ELSE Set[]));
    ELSE
      ops = Set[];
    END
    MUTABLE candidates = capabilityAuditSession__auto_rank_candidates(rtoc_self_view, ops);
    MUTABLE message = COPY base_msg;
    IF (candidates.length() == 0) THEN
      message = (message $+ " Replace `Auto` with a concrete type, or remove the unused declaration.");
    ELSE
      message = (message $+ COPY capabilityAuditSession__build_auto_op_evidence_block(rtoc_self_view, ops, candidates));
    END
    MUTABLE fixes = List[];
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < candidates.length() DO
      MUTABLE fix: ?Fix@multiowned = capabilityAuditSession__build_auto_candidate_fix(rtoc_self_view, slot, candidates[rtoc_idx]?.type_sym, candidates[rtoc_idx]?.note, (rtoc_idx + 1));
      IF fix EXISTS AS fix_value THEN
          &fixes.append(fix_value);
      END
    rtoc_idx = rtoc_idx + 1;
    END
    MUTABLE auto_tok: ?Token@multiowned = capabilityAuditSession__auto_token_for(rtoc_self_view, slot);
    capabilityAuditSession__fixable_mut(rtoc_self_view, (auto_tok OR_ELSE slot.decl_node), :type, fixes, NIL, :AUTO_UNRESOLVED_TYPE, :error, FALSE, {:detail: message});
}
END
PRIVATE FN capabilityAuditSession__slot_id_for(self: CapabilityAuditSession, slot: Slot) RETURNS ?AutoSlotId@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE kind = COPY slot.kind;
    IF ((kind == :param) AND !((((slot.fn_name != NIL) AND (slot.index != NIL))))) THEN
      RETURN NIL;
    END
    IF ((kind == :return) AND !(slot.fn_name)) THEN
      RETURN NIL;
    END
    IF (kind == :param) THEN
      RETURN autoSlotId__param(UNWRAP (slot.fn_name), UNWRAP (slot.index));
    ELSE_IF (kind == :return) THEN
      RETURN autoSlotId__return(UNWRAP (slot.fn_name));
    ELSE_IF (kind == :local) THEN
      RETURN autoSlotId__local(castAutoConstraintCollectorDeclarationNodeToLocatable(castAutoConstraintCollectorSlotDeclNodeToAutoConstraintCollectorDeclarationNode(slot.decl_node)));
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN capabilityAuditSession__auto_type_source_form(self: CapabilityAuditSession, type: AutoConstraintCollectorObservedType) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF type IS_A Type AS type_as_type THEN
      MUTABLE sym = type__resolved(type_as_type);
      RETURN COPY CAST(sym AS String);
    ELSE
      RETURN COPY CAST(type AS String);
    END
}
END
PRIVATE FN capabilityAuditSession__auto_slot_label(self: CapabilityAuditSession, slot: Slot) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (TRUE AND (slot.shape != NIL)) THEN
      RETURN capabilityAuditSession__auto_shape_slot_label(rtoc_self_view, slot);
    END
    IF (slot.kind == :param) THEN
      RETURN capabilityAuditSession__auto_param_slot_label(rtoc_self_view, slot);
    ELSE_IF (slot.kind == :return) THEN
      RETURN "return type of `${slot.fn_name}`";
    ELSE_IF (slot.kind == :local) THEN
      RETURN capabilityAuditSession__auto_local_slot_label(rtoc_self_view, slot);
    ELSE
      panic("auto_slot_label: unrecognized slot kind {}");
    END
}
END
PRIVATE FN capabilityAuditSession__auto_shape_slot_label(self: CapabilityAuditSession, slot: Slot) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE name: Any = NIL;
    MATCH castAutoConstraintCollectorSlotDeclNodeToAutoConstraintCollectorDeclarationNode(slot.decl_node) START
      AutoConstraintCollectorDeclarationNode.VarDecl AS item ->
        name = COPY item.name;,
      AutoConstraintCollectorDeclarationNode.BindExpr AS item ->
        name = COPY item.name;,
    END
    IF (slot.shape == :list_element) THEN
      RETURN "element type of list `${name}`";
    ELSE_IF (slot.shape == :map_key) THEN
      RETURN "key type of map `${name}`";
    ELSE_IF (slot.shape == :map_value) THEN
      RETURN "value type of map `${name}`";
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN capabilityAuditSession__auto_param_slot_label(self: CapabilityAuditSession, slot: Slot) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fn: FunctionDef = COPY CAST(slot.decl_node AS FunctionDef);
    MUTABLE param = COPY UNWRAP (fn.params[UNWRAP (slot.index)]);
    RETURN "parameter '${param.name}' of `${slot.fn_name}`";
}
END
PRIVATE FN capabilityAuditSession__auto_local_slot_label(self: CapabilityAuditSession, slot: Slot) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE name: Any = NIL;
    MATCH castAutoConstraintCollectorSlotDeclNodeToAutoConstraintCollectorDeclarationNode(slot.decl_node) START
      AutoConstraintCollectorDeclarationNode.VarDecl AS item ->
        name = COPY item.name;,
      AutoConstraintCollectorDeclarationNode.BindExpr AS item ->
        name = COPY item.name;,
    END
    RETURN "local '${name}'";
}
END
PRIVATE FN capabilityAuditSession__auto_token_for(self: CapabilityAuditSession, slot: Slot) RETURNS ?Token
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN CAST(COPY KEEP slot.auto_token AS ?Token);
}
END
PRIVATE FN capabilityAuditSession__build_auto_ambiguity_message(self: CapabilityAuditSession, label: String, observed_strs: []String, slot: Slot) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE types_list = observed_strs.join(", ");
    MUTABLE msg = "Ambiguous Auto for ${label}: observed as ${types_list}.\n";
    msg = (msg $+ "  Option 1 (recommended): pin one concrete type at the\n");
    msg = (msg $+ "    declaration and convert at the divergent sites. The\n");
    msg = (msg $+ "    candidate types observed are: ${types_list}.\n");
    msg = (msg $+ "    Pick the one whose semantics match your intent and\n");
    msg = (msg $+ "    convert the others (e.g. `Int64.toString(x)`,\n");
    msg = (msg $+ "    `Int.fromString(s) OR_ELSE RAISE`).\n");
    msg = (msg $+ "  Option 2: if these types do not have an obvious\n");
    msg = (msg $+ "    conversion path, restructure the call sites so a\n");
    msg = (msg $+ "    single concrete type flows through.\n");
    IF ((slot.kind == :param) OR (slot.kind == :return)) THEN
      MUTABLE union_name: String = "";
      IF (slot.kind == :param) THEN
        MUTABLE fn: FunctionDef = COPY CAST(slot.decl_node AS FunctionDef);
        union_name = ((UNWRAP (fn.params[UNWRAP (slot.index)])).name).capitalize();
      ELSE
        union_name = "Result";
      END
      MUTABLE variant_parts: []String = ( { MUTABLE rtoc_empty_list_5: []String = List[]; rtoc_empty_list_5 } );
      MUTABLE i: Int64 = 0;
      WHILE (i < observed_strs.length()) DO
        &variant_parts.append("Variant${i.toString()}: ${UNWRAP (observed_strs[i])}");
        i = (i + 1);
      END
      MUTABLE variants = variant_parts.join(", ");
      msg = (msg $+ "  Option 3 (last resort): if you genuinely need to accept\n");
      msg = (msg $+ "    multiple types, define a union explicitly:\n");
      msg = (msg $+ "      UNION ${union_name} { ${variants} }\n");
      msg = (msg $+ "    Auto does NOT auto-create unions.\n");
    END
    RETURN msg;
}
END
PRIVATE FN capabilityAuditSession__scope_stack_for_helper(self: CapabilityAuditSession) RETURNS ![]Scope@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (capabilityAuditSession__scope_stack(rtoc_self_view));
}
END
PRIVATE FN capabilityAuditSession__current_scope(self: CapabilityAuditSession) RETURNS Scope@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN KEEP UNWRAP (capabilityAuditSession__scope_stack_for_helper(rtoc_self_view).last());
}
