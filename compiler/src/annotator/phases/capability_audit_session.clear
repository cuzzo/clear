PRIVATE FN capabilityAuditSession__compute_fsm_eligibility_mut(MUTABLE self: CapabilityAuditSession) RETURNS !?{Any@multiowned}Any@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = TRY (capabilityAuditSession__function_node_map(rtoc_self_view));
    fn_nodes.keys() |> EACH {
    MUTABLE fn_node: FunctionDef@multiowned = (fn_nodes[_] OR_ELSE panic("missing hash key"));
    MUTABLE effs = (fn_node.effects OR_ELSE Set[]);
    MUTABLE reason = NIL;
    IF (effs.contains?(:REENTRANT) OR fn_node.plain_reentrant?()) THEN
        reason = :reentrant;
    ELSE_IF effs.contains?(extern_value) THEN
        reason = :extern;
    ELSE_IF !anySuspendsEffect(effs) THEN
        reason = :no_suspends;
    END
    fn_node.fsm_eligible = FALSE;
    fn_node.fsm_ineligible_reason = reason;
    };
    RETURN NIL;
}
END
PRIVATE FN capabilityAuditSession__enumerate_fsm_suspend_points_mut(MUTABLE self: CapabilityAuditSession) RETURNS !?{Any@multiowned}Any@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = TRY (capabilityAuditSession__function_node_map(rtoc_self_view));
    MUTABLE summaries = TRY (capabilityAuditSession__function_body_summaries(rtoc_self_view));
    FOR rtoc_each_15 IN fn_nodes.keys() DO
    MUTABLE fn_node: FunctionDef@multiowned = (fn_nodes[rtoc_each_15] OR_ELSE panic("missing hash key"));
    IF !(fn_node.fsm_eligible) THEN
      CONTINUE;
    END
    fn_node.fsm_suspend_points = summaries[fn_node.name]?.suspend_points;
        END
    RETURN NIL;
}
END
PRIVATE FN capabilityAuditSession__finalize_async_execution_shapes_mut(MUTABLE self: CapabilityAuditSession, program_node: Program) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE _ = COPY program_node;
    FOR _ IN (TRY (capabilityAuditSession__async_body_facts(rtoc_self_view))) DO
    MUTABLE node = COPY _.node;
    MUTABLE body_scan = COPY _.summary;
    IF (node IS_A BgBlock) THEN
        TRY (capabilityAuditSession__assign_bg_spawn_shape_mut(&rtoc_self_view, castAsyncBodyNodeToAsyncSpawnNode(node), body_scan));
        TRY (capabilityAuditSession__assign_async_stack_tier_mut(&rtoc_self_view, &node, body_scan.callees, asyncBodyNode__stack_size(node), UNWRAP (asyncBodyNode__can_smash(node)), node));
    ELSE_IF (node IS_A BgStreamBlock) THEN
        TRY (capabilityAuditSession__assign_bg_spawn_shape_mut(&rtoc_self_view, &node, body_scan));
        TRY (capabilityAuditSession__assign_async_stack_tier_mut(&rtoc_self_view, &node, body_scan.callees, node.stack_size, FALSE, node));
    ELSE_IF (node IS_A DoBranch) THEN
        TRY (capabilityAuditSession__assign_async_stack_tier_mut(&rtoc_self_view, &node, body_scan.callees, node.stack_size, node.can_smash, _.validation_node));
    END
    END
}
END
PRIVATE FN capabilityAuditSession__assign_bg_spawn_shape_mut(MUTABLE self: CapabilityAuditSession, MUTABLE node: AsyncSpawnNode, body_scan: BodyScanSummary) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (TRUE AND asyncSpawnNode__stack_size(node)) THEN
      MATCH node START
        AsyncSpawnNode.BgBlock AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.spawn_form = :stackful;
          node = AsyncSpawnNode{ BgBlock: item_mutable };,
        AsyncSpawnNode.BgStreamBlock AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.spawn_form = :stackful;
          node = AsyncSpawnNode{ BgStreamBlock: item_mutable };,
      END
      MATCH node START
        AsyncSpawnNode.BgBlock AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.fsm_ineligible_reason = :explicit_stack_size;
          node = AsyncSpawnNode{ BgBlock: item_mutable };,
        AsyncSpawnNode.BgStreamBlock AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.fsm_ineligible_reason = :explicit_stack_size;
          node = AsyncSpawnNode{ BgStreamBlock: item_mutable };,
      END
    ELSE
      MUTABLE decision = TRY (capabilityAuditSession__bg_spawn_form_for(&rtoc_self_view, body_scan.callees, body_scan.has_fnptr_call));
      MATCH node START
        AsyncSpawnNode.BgBlock AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.spawn_form = COPY decision.spawn_form;
          node = AsyncSpawnNode{ BgBlock: item_mutable };,
        AsyncSpawnNode.BgStreamBlock AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.spawn_form = COPY decision.spawn_form;
          node = AsyncSpawnNode{ BgStreamBlock: item_mutable };,
      END
      MATCH node START
        AsyncSpawnNode.BgBlock AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.fsm_ineligible_reason = COPY decision.reason;
          node = AsyncSpawnNode{ BgBlock: item_mutable };,
        AsyncSpawnNode.BgStreamBlock AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.fsm_ineligible_reason = COPY decision.reason;
          node = AsyncSpawnNode{ BgStreamBlock: item_mutable };,
      END
    END
    MATCH node START
      AsyncSpawnNode.BgBlock AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.fsm_suspend_points = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_22: ?[]SuspendPointFact = NIL;
    IF (MATCH node START AsyncSpawnNode.BgBlock AS item -> (item.spawn_form == :fsm), AsyncSpawnNode.BgStreamBlock AS item -> (item.spawn_form == :fsm) END) THEN
      rtoc_ternary_value_22 = body_scan.suspend_points;
    ELSE
      rtoc_ternary_value_22 = NIL;
    END
    rtoc_ternary_value_22? };
        node = AsyncSpawnNode{ BgBlock: item_mutable };,
      AsyncSpawnNode.BgStreamBlock AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.fsm_suspend_points = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_22: ?[]SuspendPointFact = NIL;
    IF (MATCH node START AsyncSpawnNode.BgBlock AS item -> (item.spawn_form == :fsm), AsyncSpawnNode.BgStreamBlock AS item -> (item.spawn_form == :fsm) END) THEN
      rtoc_ternary_value_22 = body_scan.suspend_points;
    ELSE
      rtoc_ternary_value_22 = NIL;
    END
    rtoc_ternary_value_22? };
        node = AsyncSpawnNode{ BgStreamBlock: item_mutable };,
    END
}
END
PRIVATE FN capabilityAuditSession__assign_async_stack_tier_mut(MUTABLE self: CapabilityAuditSession, MUTABLE target: AsyncBodyNode, calls: [Set]String, user_size: ?String@symbol, can_smash: Bool, validation_node: AsyncValidationNode) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE raw: String@symbol = TRY (capabilityAuditSession__max_tier_for_calls(&rtoc_self_view, calls));
    asyncBodyNode__set_computed_stack_tier_mut(&target, IF ((raw == :unbounded)) THEN
      :service
    ELSE
      raw
END);
    TRY (capabilityAuditSession__validate_fiber_stack_mut(&rtoc_self_view, validation_node, calls, user_size, can_smash));
}
END
PRIVATE FN capabilityAuditSession__bg_spawn_form_for(MUTABLE self: CapabilityAuditSession, callee_names: [Set]String, has_fnptr: Bool) RETURNS !BgSpawnDecision
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = TRY (capabilityAuditSession__function_node_map(rtoc_self_view));
    IF has_fnptr THEN
      RETURN BgSpawnDecision{ spawn_form: :stackful, reason: :fn_pointer };
    END
    MUTABLE visited = Set[];
    MUTABLE queue: []String = COPY (callee_names |> SELECT COPY _);
    WHILE !(queue.empty?()) DO
      MUTABLE name: ?String = &queue.shift();
      IF visited.contains?(name) THEN
        CONTINUE;
      END
      &visited.insert(name);
      MUTABLE fn = fn_nodes[name];
      IF !(fn) THEN
        CONTINUE;
      END
      MUTABLE effs = (fn.effects() OR_ELSE Set[]);
      IF (effs.contains?(reentrant) OR fn.plain_reentrant?()) THEN
        RETURN BgSpawnDecision{ spawn_form: :stackful, reason: :reentrant };
      END
      IF effs.contains?(extern_value) THEN
        RETURN BgSpawnDecision{ spawn_form: :stackful, reason: :extern };
      END
      IF anySuspendsEffect(effs) THEN
        RETURN BgSpawnDecision{ spawn_form: :stackful, reason: :suspending_callee };
      END
      FOR _ IN (((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[name] OR_ELSE List[])) DO
      &queue.append(COPY _);
      END
    END
    RETURN BgSpawnDecision{ spawn_form: :fsm, reason: NIL };
}
END
PRIVATE FN capabilityAuditSession__recursion_yield_needed?(self: CapabilityAuditSession, fn_node: FunctionDef) RETURNS Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN aST__recursion_yield_needed?(fn_node);
}
END
PRIVATE FN capabilityAuditSession__compute_stack_tiers_mut(MUTABLE self: CapabilityAuditSession) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = TRY (capabilityAuditSession__function_node_map(rtoc_self_view));
    TRY (capabilityAuditSession__assign_base_stack_tiers_mut(&rtoc_self_view, fn_nodes));
    TRY (capabilityAuditSession__propagate_unbounded_stack_tiers_mut(&rtoc_self_view, fn_nodes));
    NIL;
}
END
PRIVATE FN capabilityAuditSession__assign_base_stack_tiers_mut(MUTABLE self: CapabilityAuditSession, fn_nodes: {String}FunctionDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR rtoc_each_16 IN fn_nodes.keys() DO
    MUTABLE fn_node: FunctionDef = (fn_nodes[rtoc_each_16] OR_ELSE CAST(panic("missing hash key") AS FunctionDef));
    MUTABLE effs = (fn_node.effects OR_ELSE Set[]);
    MUTABLE stack_bytes = (fn_node.stack_vars_bytes OR_ELSE 0);
    MUTABLE kind: ?String@symbol = COPY fn_node.reentrance_kind;
    IF (kind == :reentrant) THEN
        fn_node.stack_tier = :unbounded;
        fn_node.stack_vars_bytes = stack_bytes;
        CONTINUE;
    END
    IF (kind == :reentrant_max_depth) THEN
        MUTABLE n = (fn_node.max_depth_n OR_ELSE 1);
        IF TRY (capabilityAuditSession__mutually_recursive_in_call_graph?(&rtoc_self_view, rtoc_each_16)) THEN
          fn_node.stack_tier = :unbounded;
          fn_node.stack_vars_bytes = stack_bytes;
          CONTINUE;
        END
        stack_bytes = (stack_bytes * n);
    END
    MUTABLE return_t: ?Type = fn_node.return_type;
    IF ((return_t != NIL) AND !(TRUE)) THEN
        return_t = TRY (type__new(castTypeToTypeConstructionInput__capability_audit_session(return_t)));
    END
    MUTABLE declared_runtime_return = !(!((((return_t != NIL) AND (((type__heap?(return_t) OR type__indirect?(return_t)) OR TRY (type__needs_escape_promotion?(return_t))))))));
    MUTABLE tier =   IF (((effs.contains?(:HEAP) OR effs.contains?(:BLOCKING)) OR effs.contains?(:EXTERN)) OR functionDef__runtime_stack_required?(fn_node, capabilityAuditSession__recursion_yield_needed?(rtoc_self_view, fn_node), declared_runtime_return)) THEN
        :standard
      ELSE
        :micro
      END;
    MUTABLE budget = UNWRAP ((CAST({:micro: 4096, :standard: 16384, :large: 65536, :xl: 262144, :service: 4194304} AS {String@symbol}Int64))[tier]);
    WHILE ((stack_bytes > (budget / 2)) AND (tier != :xl)) DO
        tier =     IF (tier == :micro) THEN
          :standard
        ELSE_IF (tier == :standard) THEN
          :large
        ELSE
          :xl
        END;
        budget = UNWRAP ((CAST({:micro: 4096, :standard: 16384, :large: 65536, :xl: 262144, :service: 4194304} AS {String@symbol}Int64))[tier]);
    END
    fn_node.stack_tier = tier;
    fn_node.stack_vars_bytes = stack_bytes;
        END
}
END
PRIVATE FN capabilityAuditSession__propagate_unbounded_stack_tiers_mut(MUTABLE self: CapabilityAuditSession, fn_nodes: {String}FunctionDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE changed: Bool = TRUE;
    WHILE changed DO
      changed = FALSE;
      FOR rtoc_each_17 IN (TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view))).keys() DO
    MUTABLE callees: [Set]String = ((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[rtoc_each_17] OR_ELSE CAST(panic("missing hash key") AS [Set]String));
    MUTABLE fn: ?FunctionDef = COPY fn_nodes[rtoc_each_17];
    IF !(fn) THEN
          CONTINUE;
    END
    IF (fn?.stack_tier == :unbounded) THEN
          CONTINUE;
    END
    IF callees |> ANY ((fn_nodes[rtoc_each_17] != NIL) AND (((fn_nodes[rtoc_each_17])?).stack_tier == :unbounded)) THEN
          IF fn EXISTS AS MUTABLE fn_present THEN
            fn_present.stack_tier = :unbounded;
          END
          changed = TRUE;
    END
            END
    END
}
END
PRIVATE FN capabilityAuditSession__mutually_recursive_in_call_graph?(MUTABLE self: CapabilityAuditSession, start_value: String) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN (((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[start_value] OR_ELSE Set[])) |> ANY (IF (_ == start_value) THEN FALSE ELSE TRY (capabilityAuditSession__reachable_in_call_graph?(&rtoc_self_view, _, start_value)) END);
}
END
PRIVATE FN capabilityAuditSession__reachable_in_call_graph?(MUTABLE self: CapabilityAuditSession, from_name: String, target: String) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE visited = Set[];
    MUTABLE queue = [from_name];
    WHILE !((queue.length() == 0)) DO
      MUTABLE n: ?String = &queue.shift();
      IF visited.contains?(n) THEN
        CONTINUE;
      END
      &visited.insert(n);
      IF (n == target) THEN
        RETURN TRUE;
      END
      queue = ruby_array_concat_String__capability_audit_session(queue, CAST(((((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[n?] OR_ELSE Set[])) |> SELECT COPY _) AS []String));
    END
    RETURN FALSE;
}
END
PRIVATE FN capabilityAuditSession__max_tier_for_calls(MUTABLE self: CapabilityAuditSession, fn_names: [Set]String) RETURNS !String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = TRY (capabilityAuditSession__function_node_map(rtoc_self_view));
    MUTABLE visited = Set[];
    MUTABLE max: String@symbol = :micro;
    MUTABLE queue: []String = COPY (fn_names |> SELECT COPY _);
    WHILE !(queue.empty?()) DO
      MUTABLE name: ?String = &queue.shift();
      IF visited.contains?(name) THEN
        CONTINUE;
      END
      &visited.insert(name);
      MUTABLE fn = fn_nodes[name];
      IF fn EXISTS AS fn_value THEN
        IF functionSignature__stack_tier(fn_value) THEN
        IF (((CAST({:micro: 0, :standard: 1, :large: 2, :xl: 3, :service: 4, :unbounded: 5} AS {String@symbol}Int64))[functionSignature__stack_tier(fn)] OR_ELSE 0) > ((CAST({:micro: 0, :standard: 1, :large: 2, :xl: 3, :service: 4, :unbounded: 5} AS {String@symbol}Int64))[max] OR_ELSE 0)) THEN
          max = functionSignature__stack_tier(fn);
        END
      END
      END
      FOR _ IN (((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[name] OR_ELSE List[])) DO
      &queue.append(COPY _);
      END
    END
    RETURN max;
}
END
PRIVATE FN capabilityAuditSession__check_indirect_reentrancy_mut(MUTABLE self: CapabilityAuditSession) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = TRY (capabilityAuditSession__function_node_map(rtoc_self_view));
    MUTABLE direct_effects = capabilityAuditSession__effect_direct_effects(rtoc_self_view);
    FOR _ IN (TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view))).keys() DO
    MUTABLE node: ?FunctionDef = fn_nodes[_];
    IF (node == NIL) THEN
        CONTINUE;
    END
    IF UNWRAP (node).reentrance_kind THEN
        CONTINUE;
    END
    MUTABLE visited = Set[];
    MUTABLE queue: []String = ((((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[_] OR_ELSE Set[])) |> SELECT COPY _);
    WHILE !(queue.empty?()) DO
        MUTABLE callee: ?String = &queue.shift();
        IF visited.contains?(callee) THEN
          CONTINUE;
        END
        &visited.insert(callee);
        IF (callee == _) THEN
          (IF direct_effects[_] != NIL THEN
            (direct_effects[_]).insert(symbol("REENTRANT"))
          ELSE
            NIL
          END);
          MUTABLE arrow = node.arrow_token;
          IF arrow THEN
            MUTABLE fix = TRY (fix__new(TRY (capabilityAuditSession__fix_description(rtoc_self_view, :ADD_EFFECTS_REENTRANT)), [edit__new(span__new(NIL, arrow.line, arrow.column, 0), "EFFECTS REENTRANT ")], :auto));
            TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, node, :reentrance, [fix], NIL, :REENTRANCY_MUTUAL_CYCLE, :error, FALSE, CAST({:name: _} AS {String@symbol}Any)));
          ELSE
            TRY (capabilityAuditSession__error_mut(&rtoc_self_view, node, CapabilityAuditCodeOrMessage{ SymbolValue: :REENTRANCY_MUTUAL_CYCLE }, [], CAST({:name: _} AS {String@symbol}Any)));
          END
          BREAK;
        END
        FOR _ IN (((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[callee] OR_ELSE Set[])) DO
        &queue.append(COPY _);
        END
    END
    END
}
END
PRIVATE FN capabilityAuditSession__with_block_suspends?(self: CapabilityAuditSession, node: WithBlock) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ((TRY (withCapabilityPlan__locks((TRY (capabilityPlan__require_for(node)))))).length() > 0);
}
END
PRIVATE FN capabilityAuditSession__func_call_suspends?(MUTABLE self: CapabilityAuditSession, node: CallLikeNode) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = TRY (capabilityAuditSession__function_node_map(rtoc_self_view));
    IF (IF callLikeNode__matched_stdlib_def(node) != NIL THEN
      { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_23: ?FunctionSignature@multiowned = (callLikeNode__matched_stdlib_def(node));
    TRY (functionSignature__intrinsic_suspends?(UNWRAP (rtoc_mutable_receiver_23))) }
    ELSE
      NIL
    END) THEN
      RETURN TRUE;
    END
    IF (IF node IS_A FuncCall AS func_call THEN func_call.fn_var_call ELSE FALSE END) THEN
      RETURN FALSE;
    END
    MUTABLE callee = fn_nodes[node.name];
    IF !(callee) THEN
      RETURN FALSE;
    END
    MUTABLE effs = callee.effects();
    RETURN !(!(((effs AND anySuspendsEffect(effs)))));
}
END
PRIVATE FN capabilityAuditSession__validate_fiber_stack_mut(MUTABLE self: CapabilityAuditSession, node: AsyncValidationNode, call_names: [Set]String, user_size: ?String@symbol, can_smash: Bool) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF can_smash THEN
      TRY (capabilityAuditSession__emit_can_smash_unsupported_error_mut(&rtoc_self_view, node));
      RETURN;
    END
    MUTABLE plain_reentrant_callee: ?String = TRY (capabilityAuditSession__find_plain_reentrant_callee(&rtoc_self_view, call_names));
    IF ((plain_reentrant_callee != NIL) AND (user_size != :service)) THEN
      TRY (capabilityAuditSession__emit_service_required_error_mut(&rtoc_self_view, node, plain_reentrant_callee, user_size));
      RETURN;
    END
    MUTABLE raw = TRY (capabilityAuditSession__max_tier_for_calls(&rtoc_self_view, call_names));
    MUTABLE computed = IF ((raw == :unbounded)) THEN
      :service
    ELSE
      raw
    END;
    IF ((raw == :unbounded) AND (user_size != :service)) THEN
      MUTABLE mutual_md_callee: ?String = TRY (capabilityAuditSession__find_mutual_max_depth_callee(&rtoc_self_view, call_names));
      IF mutual_md_callee EXISTS AS mutual_md_callee_value THEN
        TRY (capabilityAuditSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castAsyncValidationNodeToLocatable(node)), CapabilityAuditCodeOrMessage{ SymbolValue: :STACK_SAFETY_MUTUAL_RECURSION }, [], CAST({:callee: mutual_md_callee_value} AS {String@symbol}Any)));
        RETURN;
      END
    END
    IF (user_size == :stack) THEN
      capabilityAuditSession__warning_mut(&rtoc_self_view, castAsyncValidationNodeToLocatable(node), UNWRAP (TRY (diagnosticRegistry__format(:STACK_SAFETY_STACK_ALIAS, List[], CAST({:computed: DiagnosticKwValue{ SymbolValue: COPY computed }} AS {String@symbol}String)))));
      RETURN;
    END
    IF ((user_size != NIL) AND ((symbol("TIER_ORDER")[user_size] OR_ELSE 0) < (symbol("TIER_ORDER")[computed] OR_ELSE 0))) THEN
      TRY (capabilityAuditSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castAsyncValidationNodeToLocatable(node)), CapabilityAuditCodeOrMessage{ SymbolValue: :STACK_SAFETY_USER_SIZE_TOO_SMALL }, [], CAST({:size: user_size, :budget: symbol("STACK_TIER_BUDGET")[user_size], :computed: computed} AS {String@symbol}Any)));
    END
}
END
PRIVATE FN capabilityAuditSession__find_plain_reentrant_callee(MUTABLE self: CapabilityAuditSession, call_names: [Set]String) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE visited: [Set]String = Set[];
    MUTABLE queue: []String = COPY (call_names |> SELECT COPY _);
    WHILE !((queue.length() == 0)) DO
      MUTABLE name = UNWRAP (&queue.shift());
      IF visited.contains?(name) THEN
        CONTINUE;
      END
      &visited.insert(name);
      MUTABLE fn: ?FunctionDef@multiowned = TRY (capabilityAuditSession__function_node_for(rtoc_self_view, name));
      IF ((fn != NIL) AND (fn.reentrance_kind == :reentrant)) THEN
        RETURN name;
      END
      FOR _ IN (((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[name] OR_ELSE List[])) DO
      &queue.append(COPY _);
      END
    END
    RETURN NIL;
}
END
PRIVATE FN capabilityAuditSession__find_mutual_max_depth_callee(MUTABLE self: CapabilityAuditSession, call_names: [Set]String) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE visited: [Set]String = Set[];
    MUTABLE queue: []String = COPY (call_names |> SELECT COPY _);
    WHILE !((queue.length() == 0)) DO
      MUTABLE name = UNWRAP (&queue.shift());
      IF visited.contains?(name) THEN
        CONTINUE;
      END
      &visited.insert(name);
      MUTABLE fn: ?FunctionDef@multiowned = TRY (capabilityAuditSession__function_node_for(rtoc_self_view, name));
      IF (((fn != NIL) AND (fn.reentrance_kind == :reentrant_max_depth)) AND TRY (capabilityAuditSession__mutually_recursive_in_call_graph?(&rtoc_self_view, name))) THEN
        RETURN name;
      END
      FOR _ IN (((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[name] OR_ELSE List[])) DO
      &queue.append(COPY _);
      END
    END
    RETURN NIL;
}
END
PRIVATE FN capabilityAuditSession__emit_service_required_error_mut(MUTABLE self: CapabilityAuditSession, node: AsyncValidationNode, reentrant_fn: String, user_size: ?String@symbol) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fix: ?Fix@multiowned = TRY (capabilityAuditSession__service_required_fix(rtoc_self_view, node, user_size));
    IF fix EXISTS AS fix_value THEN
      TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, diagnosticAnchor__of(castAsyncValidationNodeToLocatable(node)), :reentrance, [fix_value], NIL, :STACK_NEEDS_SERVICE_FIXABLE, :error, FALSE, CAST({:reentrant_fn: reentrant_fn} AS {String@symbol}Any)));
    ELSE
      RETURN TRY (capabilityAuditSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castAsyncValidationNodeToLocatable(node)), CapabilityAuditCodeOrMessage{ SymbolValue: :STACK_NEEDS_SERVICE_FIXABLE }, [], CAST({:reentrant_fn: reentrant_fn} AS {String@symbol}Any)));
    END
}
END
PRIVATE FN capabilityAuditSession__service_required_fix(self: CapabilityAuditSession, node: AsyncValidationNode, user_size: ?String@symbol) RETURNS !?Fix
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A BgBlock AS bg_block THEN
      MUTABLE prefix_token: ?Token = bg_block.prefix_token;
      IF prefix_token EXISTS AS prefix_token_value THEN
        RETURN CAST(TRY (capabilityAuditSession__replace_stack_sigil_with_service_fix(rtoc_self_view, UNWRAP (UNWRAP (prefix_token_value)), user_size)) AS ?Fix);
      END
      MUTABLE open_brace_token = bg_block.open_brace_token;
      IF open_brace_token THEN
        RETURN CAST(TRY (capabilityAuditSession__insert_service_after_open_brace_fix(rtoc_self_view, open_brace_token)) AS ?Fix);
      END
      RETURN NIL;
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN capabilityAuditSession__replace_stack_sigil_with_service_fix(self: CapabilityAuditSession, token: Token, user_size: ?String@symbol) RETURNS !Fix
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (fix__new(TRY (diagnosticRegistry__fix_description(:REPLACE_STACK_SIGIL_WITH_SERVICE, CAST({:stack: ruby_wrap_optional_String_symbol_DiagnosticKwValue(user_size)} AS {String@symbol}String))), [edit__new(span__new(NIL, token.line, token.column, (CAST(token.value AS String)).codepointCount()), "@service")], :interactive));
}
END
PRIVATE FN capabilityAuditSession__insert_service_after_open_brace_fix(self: CapabilityAuditSession, token: Token) RETURNS !Fix
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (fix__new(TRY (diagnosticRegistry__fix_description(:INSERT_SERVICE_AFTER_OPEN_BRACE)), [edit__new(span__new(NIL, token.line, (token.column + 1), 0), " @service ->")], :interactive));
}
END
PRIVATE FN capabilityAuditSession__validate_not_logical_recursion_mut(MUTABLE self: CapabilityAuditSession) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = TRY (capabilityAuditSession__function_node_map(rtoc_self_view));
    FOR rtoc_each_18 IN fn_nodes.keys() DO
    MUTABLE fn_node: FunctionDef@multiowned = (fn_nodes[rtoc_each_18] OR_ELSE panic("missing hash key"));
    IF !((fn_node.reentrance_kind == :reentrant_not_logical)) THEN
      CONTINUE;
    END
    MUTABLE direct = (TRY (capabilityAuditSession__effect_direct_effects_for(&rtoc_self_view, rtoc_each_18))).contains?(symbol("REENTRANT"));
    MUTABLE mutual = (!(direct) AND TRY (capabilityAuditSession__reachable_from_self?(&rtoc_self_view, rtoc_each_18)));
    IF !((direct OR mutual)) THEN
        CONTINUE;
    END
    MUTABLE cycle_desc: String = "";
      IF direct THEN
        cycle_desc = "directly calls itself";
      ELSE
        cycle_desc = "is part of a mutually recursive call cycle (reachable from itself via ${(TRY (capabilityAuditSession__thunk_cycle_members(&rtoc_self_view, rtoc_each_18)) |> ORDER_BY rtoc_each_18).join(", ")})";
      END
    TRY (capabilityAuditSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ FunctionDef: COPY fn_node } }, CapabilityAuditCodeOrMessage{ SymbolValue: :REENTRANT_NOT_LOGICAL_BUT_RECURSIVE }, [], CAST({:name: rtoc_each_18, :cycle_desc: cycle_desc} AS {String@symbol}Any)));
        END
}
END
PRIVATE FN capabilityAuditSession__validate_max_depth_mutual_cycle_mut(MUTABLE self: CapabilityAuditSession) RETURNS !?{Any@multiowned}Any@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = TRY (capabilityAuditSession__function_node_map(rtoc_self_view));
    FOR rtoc_each_19 IN fn_nodes.keys() DO
    MUTABLE fn_node: FunctionDef@multiowned = (fn_nodes[rtoc_each_19] OR_ELSE panic("missing hash key"));
    IF !((fn_node.reentrance_kind == :reentrant_max_depth)) THEN
      CONTINUE;
    END
    MUTABLE direct = (TRY (capabilityAuditSession__effect_direct_effects_for(&rtoc_self_view, rtoc_each_19))).contains?(symbol("REENTRANT"));
    MUTABLE mutual = (!(direct) AND TRY (capabilityAuditSession__reachable_from_self?(&rtoc_self_view, rtoc_each_19)));
    IF !(mutual) THEN
        CONTINUE;
    END
    MUTABLE cycle_members = TRY (capabilityAuditSession__thunk_cycle_members(&rtoc_self_view, rtoc_each_19)) |> ORDER_BY rtoc_each_19;
    MUTABLE fixes = List[];
    MUTABLE drop_edits: []Edit@multiowned = TRY (capabilityAuditSession__effects_clause_edits(rtoc_self_view, fn_node, "EFFECTS REENTRANT"));
    IF drop_edits |> ANY rtoc_each_19 THEN
        &fixes.append(TRY (fix__new(TRY (capabilityAuditSession__fix_description(rtoc_self_view, :DROP_MAX_DEPTH_MUTUAL, CAST({:max_depth: fn_node.max_depth_n} AS {String@symbol}?DiagnosticKwValue))), drop_edits, :auto)));
    END
    IF (fixes.length() == 0) THEN
        TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ FunctionDef: COPY fn_node } }, :reentrance, fixes, NIL, :REENTRANT_MAX_DEPTH_MUTUAL_DEMOTED, :warning, FALSE, CAST({:fn: rtoc_each_19, :max_depth: fn_node.max_depth_n, :cycle: cycle_members.join(", ")} AS {String@symbol}Any)));
    ELSE
        TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ FunctionDef: COPY fn_node } }, :reentrance, fixes, NIL, :REENTRANT_MAX_DEPTH_MUTUAL_DEMOTED, :warning, FALSE, CAST({:fn: rtoc_each_19, :max_depth: fn_node.max_depth_n, :cycle: cycle_members.join(", ")} AS {String@symbol}Any)));
    END
        END
    RETURN NIL;
}
END
PRIVATE FN capabilityAuditSession__validate_thunk_recursion_mut(MUTABLE self: CapabilityAuditSession) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = TRY (capabilityAuditSession__function_node_map(rtoc_self_view));
    FOR rtoc_each_20 IN fn_nodes.keys() DO
    MUTABLE fn_node: FunctionDef@multiowned = (fn_nodes[rtoc_each_20] OR_ELSE panic("missing hash key"));
    IF !((fn_node.reentrance_kind == :reentrant_thunk)) THEN
      CONTINUE;
    END
    IF fn_node.tail_call THEN
        CONTINUE;
    END
    IF fn_node.thunk_plan THEN
        CONTINUE;
    END
    IF fn_node.mutual_thunk_plan THEN
        CONTINUE;
    END
    MUTABLE direct = (((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[rtoc_each_20] OR_ELSE Set[])).contains?(rtoc_each_20);
    MUTABLE mutually = (!(direct) AND TRY (capabilityAuditSession__reachable_from_self?(&rtoc_self_view, rtoc_each_20)));
    IF direct THEN
        CONTINUE;
    ELSE_IF mutually THEN
        IF TRY (capabilityAuditSession__try_stamp_mutual_thunk_plan_mut(&rtoc_self_view, fn_node)) THEN
          CONTINUE;
        END
        TRY (capabilityAuditSession__emit_mutual_thunk_unsupported_mut(&rtoc_self_view, fn_node));
    ELSE
        TRY (capabilityAuditSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ FunctionDef: COPY fn_node } }, CapabilityAuditCodeOrMessage{ SymbolValue: :REENTRANT_THUNK_NOT_RECURSIVE }, [], CAST({:name: rtoc_each_20} AS {String@symbol}Any)));
    END
        END
}
END
PRIVATE FN capabilityAuditSession__try_stamp_mutual_thunk_plan_mut(MUTABLE self: CapabilityAuditSession, fn_node: FunctionDef) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = TRY (capabilityAuditSession__function_node_map(rtoc_self_view));
    MUTABLE cycle_names = TRY (capabilityAuditSession__thunk_cycle_members(&rtoc_self_view, fn_node.name));
    IF (cycle_names.length() < 2) THEN
      RETURN FALSE;
    END
    MUTABLE cycle_fns = cycle_names |> SELECT fn_nodes[_];
    IF cycle_fns |> ANY _.nil?() THEN
      RETURN FALSE;
    END
    MUTABLE concrete_cycle_fns: []FunctionDef = cycle_fns |> WHERE _ != NIL;
    IF !(concrete_cycle_fns |> ALL (_.reentrance_kind == :reentrant_thunk)) THEN
      RETURN FALSE;
    END
    IF concrete_cycle_fns |> ANY (_.tail_call OR _.thunk_plan) THEN
      RETURN FALSE;
    END
    MUTABLE ret_types = CAST(((concrete_cycle_fns |> SELECT _.return_type) |> SELECT (IF _ != NIL THEN
      CAST(_ AS String)
    ELSE
      NIL
    END) |> DISTINCT _) AS []?String);
    IF !((ret_types.size == 1)) THEN
      RETURN FALSE;
    END
    MUTABLE plans: {String}MutualPlan = {};
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < concrete_cycle_fns.length() DO
      MUTABLE partners = (cycle_names - [emittable__name(UNWRAP (concrete_cycle_fns[rtoc_idx]))]);
      MUTABLE mp: ?MutualPlan = recursiveSplitter__split_mutual(concrete_cycle_fns[rtoc_idx]?.body, emittable__name(UNWRAP (concrete_cycle_fns[rtoc_idx])), partners);
      IF (mp == NIL) THEN
          RETURN FALSE;
      END
      MUTABLE rtoc_key_1: String = COPY UNWRAP (concrete_cycle_fns[rtoc_idx]).name;
      plans[rtoc_key_1] = UNWRAP (mp);
    rtoc_idx = rtoc_idx + 1;
    END
    FOR _ IN concrete_cycle_fns DO
    _.mutual_thunk_plan = MutualThunkPlan{ cycle_fns: concrete_cycle_fns, own_plan: COPY UNWRAP (plans[_.name]) };
    END
    RETURN TRUE;
}
END
PRIVATE FN capabilityAuditSession__emit_mutual_thunk_unsupported_mut(MUTABLE self: CapabilityAuditSession, fn_node: FunctionDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn_nodes = TRY (capabilityAuditSession__function_node_map(rtoc_self_view));
    MUTABLE name = fn_node.name;
    MUTABLE cycle_names = TRY (capabilityAuditSession__thunk_cycle_members(&rtoc_self_view, name));
    MUTABLE cycle_thunk_fns = (cycle_names |> SELECT:? fn_nodes[_] |> WHERE _ != NIL) |> WHERE (_.reentrance_kind == :reentrant_thunk);
    MUTABLE fixes = List[];
    MUTABLE edits_plain = cycle_thunk_fns |> UNNEST TRY (capabilityAuditSession__effects_clause_edits(rtoc_self_view, _, "EFFECTS REENTRANT"));
    IF ((edits_plain.length() == cycle_thunk_fns.length()) AND !((edits_plain.length() == 0))) THEN
      &fixes.append(TRY (fix__new(TRY (capabilityAuditSession__fix_description(rtoc_self_view, :DROP_THUNK_CYCLE)), edits_plain, :interactive)));
    END
    MUTABLE edits_nl = List[];
    MUTABLE nl_ok = !((cycle_thunk_fns.length() == 0));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < cycle_thunk_fns.length() DO
      MUTABLE eff: []Edit@multiowned = TRY (capabilityAuditSession__effects_clause_edits(rtoc_self_view, cycle_thunk_fns[rtoc_idx], "EFFECTS REENTRANT:NOT_LOGICAL"));
      IF (eff.length() == 0) THEN
          nl_ok = FALSE;
          BREAK;
      END
      ruby_array_concat_Any__capability_audit_session(edits_nl, CAST(eff AS []Any));
      MUTABLE rt = cycle_thunk_fns[rtoc_idx].declared_return_type();
      IF rt EXISTS AS rt_value THEN
        IF rt_value.error_union?() THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      END
      MUTABLE rt_tok = cycle_thunk_fns[rtoc_idx].return_type_token;
      IF (rt_tok == NIL) THEN
          nl_ok = FALSE;
          BREAK;
      END
      &edits_nl.append(edit__new(span__new(NIL, rt_tok.line, rt_tok.column, 0), "!"));
    rtoc_idx = rtoc_idx + 1;
    END
    IF nl_ok THEN
      &fixes.append(TRY (fix__new(TRY (capabilityAuditSession__fix_description(rtoc_self_view, :DECLARE_NOT_LOGICAL_CYCLE)), edits_nl, :interactive)));
    END
    MUTABLE edits_md = List[];
    MUTABLE md_ok = !((cycle_thunk_fns.length() == 0));
    MUTABLE default_n = 64;
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < cycle_thunk_fns.length() DO
      MUTABLE eff: []Edit@multiowned = TRY (capabilityAuditSession__effects_clause_edits(rtoc_self_view, cycle_thunk_fns[rtoc_idx], "EFFECTS REENTRANT:MAX_DEPTH(${default_n.toString()})"));
      IF (eff.length() == 0) THEN
          md_ok = FALSE;
          BREAK;
      END
      ruby_array_concat_Any__capability_audit_session(edits_md, CAST(eff AS []Any));
      MUTABLE rt = cycle_thunk_fns[rtoc_idx].declared_return_type();
      IF rt EXISTS AS rt_value THEN
        IF rt_value.error_union?() THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      END
      MUTABLE rt_tok = cycle_thunk_fns[rtoc_idx].return_type_token;
      IF (rt_tok == NIL) THEN
          md_ok = FALSE;
          BREAK;
      END
      &edits_md.append(edit__new(span__new(NIL, rt_tok.line, rt_tok.column, 0), "!"));
    rtoc_idx = rtoc_idx + 1;
    END
    IF md_ok THEN
      &fixes.append(TRY (fix__new(TRY (capabilityAuditSession__fix_description(rtoc_self_view, :DECLARE_MAX_DEPTH_CYCLE, CAST({:depth: DiagnosticKwValue{ Int64Value: default_n }} AS {String@symbol}?DiagnosticKwValue))), edits_md, :interactive)));
    END
    IF (fixes.length() == 0) THEN
      RETURN TRY (capabilityAuditSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ FunctionDef: COPY fn_node } }, CapabilityAuditCodeOrMessage{ SymbolValue: :REENTRANT_MUTUAL_THUNK_UNSUPPORTED }, [], CAST({:name: name, :cycle: (cycle_names |> ORDER_BY _).join(", ")} AS {String@symbol}Any)));
    END
    TRY (capabilityAuditSession__fixable_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ FunctionDef: COPY fn_node } }, :reentrance, fixes, NIL, :REENTRANT_MUTUAL_THUNK_UNSUPPORTED, :error, FALSE, CAST({:name: name, :cycle: (cycle_names |> ORDER_BY _).join(", ")} AS {String@symbol}Any)));
}
END
PRIVATE FN capabilityAuditSession__thunk_cycle_members(MUTABLE self: CapabilityAuditSession, start_value: String) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE start_s = COPY start_value;
    MUTABLE forward = TRY (capabilityAuditSession__compute_reachable(rtoc_self_view, TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)), start_s));
    MUTABLE reverse_graph = {};
    (TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view))).keys() |> EACH {
    MUTABLE callees: [Set]String = ((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[_] OR_ELSE CAST(panic("missing hash key") AS [Set]String));
    FOR _ IN callees DO
    MUTABLE reverse_key: String = COPY CAST(_ AS String);
    MUTABLE reverse_entry = COPY (reverse_graph[reverse_key] OR_ELSE Set[]);
    &reverse_entry.insert(COPY _);
    reverse_graph[reverse_key] = COPY reverse_entry;
    END
    };
    MUTABLE backward = TRY (capabilityAuditSession__compute_reachable(rtoc_self_view, reverse_graph, start_s));
    MUTABLE scc = ruby_set_intersection_String_set__capability_audit_session(forward, backward);
    IF forward.contains?(start_s) THEN
      &scc.append(start_s);
    END
    RETURN (scc |> SELECT COPY _);
}
END
PRIVATE FN capabilityAuditSession__compute_reachable(self: CapabilityAuditSession, graph: {String}[Set]String, start_value: String) RETURNS ![Set]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE seen: [Set]String = Set[];
    MUTABLE queue = (((graph[start_value] OR_ELSE Set[])) |> SELECT COPY _);
    WHILE !(queue.empty?()) DO
      MUTABLE n = COPY CAST((&queue.shift()) AS String);
      IF seen.contains?(n) THEN
        CONTINUE;
      END
      &seen.insert(n);
      queue = (queue + (((graph[n] OR_ELSE Set[])) |> SELECT COPY _));
    END
    RETURN seen;
}
END
PRIVATE FN capabilityAuditSession__reachable_from_self?(MUTABLE self: CapabilityAuditSession, start_value: String) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE visited = Set[];
    MUTABLE queue: []String = ((((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[start_value] OR_ELSE Set[])) |> SELECT COPY _);
    WHILE !(queue.empty?()) DO
      MUTABLE callee: ?String = &queue.shift();
      IF visited.contains?(callee) THEN
        CONTINUE;
      END
      &visited.insert(callee);
      IF (callee == start_value) THEN
        RETURN TRUE;
      END
      queue = (queue + ((((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[callee] OR_ELSE Set[])) |> SELECT COPY _));
    END
    RETURN FALSE;
}
END
PRIVATE FN capabilityAuditSession__effects_clause_edits(self: CapabilityAuditSession, fn_node: FunctionDef, replacement: String) RETURNS ![]Edit
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE span: ?EffectSpan = COPY fn_node.effects_span;
    IF !(span) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_24: []Edit = List[]; rtoc_empty_list_24 } ) AS []Edit);
    END
    MUTABLE s = span?.start_token;
    MUTABLE e = UNWRAP (span).end_token;
    IF (UNWRAP (s).line != e.line) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_25: []Edit = List[]; rtoc_empty_list_25 } ) AS []Edit);
    END
    MUTABLE end_col = (e.column + (CAST(e.value AS String)).codepointCount());
    RETURN CAST([edit__new(span__new(NIL, UNWRAP (s).line, UNWRAP (s).column, (end_col - UNWRAP (s).column)), replacement)] AS []Edit);
}
END
PRIVATE FN capabilityAuditSession__thunk_all_self_calls_in_tail_position?(self: CapabilityAuditSession, fn_node: FunctionDef, body_facts: CapabilityAuditBodyFacts) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE all = UNWRAP (capabilityAuditBodyFacts__call_site_facts(body_facts)) |> SELECT:? (  IF (_.callee_name == fn_node.name) THEN
      COPY _.node
    ELSE
      NIL
    END) |> WHERE _ != NIL;
    IF (all.length() == 0) THEN
      RETURN FALSE;
    END
    MUTABLE blessed = UNWRAP (capabilityAuditBodyFacts__return_nodes(body_facts)) |> SELECT:? (  IF (UNWRAP (_.value) IS_A FuncCall AND (aST__node_name(UNWRAP (_.value)) == fn_node.name)) THEN
      _.value
    ELSE
      NIL
    END) |> WHERE _ != NIL;
    IF (blessed.length() == 0) THEN
      RETURN FALSE;
    END
    MUTABLE blessed_ids = (blessed |> SELECT aST__node_identity( UNWRAP (_))) |> DISTINCT _;
    RETURN all |> ALL blessed_ids.contains?(aST__node_identity( UNWRAP (_)));
}
END
PRIVATE FN capabilityAuditSession__validate_predicate_purity_mut(MUTABLE self: CapabilityAuditSession) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_each_items_26 = TRY (capabilityAuditSession__predicate_call_sites_store(rtoc_self_view));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_26.length() DO
      MUTABLE call = COPY KEEP rtoc_each_items_26[rtoc_idx]?.call;
      MUTABLE callee = COPY rtoc_each_items_26[rtoc_idx]?.callee;
      MUTABLE reason: ?String = TRY (capabilityAuditSession__predicate_impurity_reason(rtoc_self_view, call, callee));
      IF !(reason) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE surface, hint = PARTIAL MATCH rtoc_each_items_26[rtoc_idx]?.kind START
          :pre -> ["PRE clauses", "Move the impure work into the function body and validate the captured value there."],
          :post -> ["DEBUG_POST clauses", "Move the impure work into the function body and assert against an unsynchronized snapshot value instead."],
          DEFAULT -> ["WITH GUARD clauses", "Move the impure work before the WITH block and guard on the captured value."]
      END;
      TRY (capabilityAuditSession__error_mut(&rtoc_self_view, call, CapabilityAuditCodeOrMessage{ SymbolValue: :PURE_FN_CANNOT_CALL_IMPURE }, [], CAST({:surface: surface, :callee: callee, :reason: reason, :hint: hint} AS {String@symbol}Any)));
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PRIVATE FN capabilityAuditSession__predicate_call_sites_store(self: CapabilityAuditSession) RETURNS ![]PredicateCallSite
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (capabilityAuditSession__predicate_call_sites(rtoc_self_view));
}
END
PRIVATE FN capabilityAuditSession__predicate_impurity_reason(self: CapabilityAuditSession, call: CapabilityAuditCall, callee: String) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF capabilityAuditSession__call_declared_impurity_reason(rtoc_self_view, call) EXISTS AS declared THEN
      RETURN COPY declared;
    END
    IF TRY (capabilityAuditSession__matched_stdlib_impurity_reason(rtoc_self_view, call)) EXISTS AS stdlib THEN
      RETURN COPY stdlib;
    END
    RETURN TRY (capabilityAuditSession__semantic_function_impurity_reason(rtoc_self_view, callee));
}
END
PRIVATE FN capabilityAuditSession__call_declared_impurity_reason(self: CapabilityAuditSession, call: CapabilityAuditCall) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF capabilityAuditCall__extern_call(call) THEN
      RETURN "is an extern call";
    END
    MUTABLE extern_effects: Any = NIL;
    MATCH call START
      CapabilityAuditCall.FuncCall AS item ->
        extern_effects = COPY item.extern_effects;,
      CapabilityAuditCall.MethodCall AS item ->
        extern_effects = COPY item.extern_effects;,
    END
    IF (extern_effects AND !(extern_effects.empty?())) THEN
      RETURN "has extern effects";
    END
    IF capabilityAuditCall__can_fail(call) THEN
      RETURN "can fail";
    END
    RETURN NIL;
}
END
PRIVATE FN capabilityAuditSession__matched_stdlib_impurity_reason(self: CapabilityAuditSession, call: CapabilityAuditCall) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(capabilityAuditCall__matched_stdlib_def(call)) THEN
      RETURN NIL;
    END
    MUTABLE md = UNWRAP (capabilityAuditCall__matched_stdlib_def(call));
    IF TRY (functionSignature__emits_allocating?(md)) THEN
      RETURN "allocates";
    END
    IF functionSignature__can_fail(md) THEN
      RETURN "can fail";
    END
    IF TRY (functionSignature__intrinsic_suspends?(md)) THEN
      RETURN "suspends";
    END
    IF TRY (functionSignature__mutates_receiver?(md)) THEN
      RETURN "mutates its receiver";
    END
    RETURN NIL;
}
END
PRIVATE FN capabilityAuditSession__semantic_function_impurity_reason(self: CapabilityAuditSession, callee: String) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fn_nodes = TRY (capabilityAuditSession__function_node_map(rtoc_self_view));
    MUTABLE fn: ?FunctionDef = fn_nodes[callee];
    IF !(fn) THEN
      RETURN NIL;
    END
    IF functionSignature__can_fail(fn) THEN
      RETURN "can fail";
    END
    MUTABLE effects = (fn.effects() OR_ELSE Set[]);
    IF effects.empty?() THEN
      RETURN NIL;
    END
    RETURN "has effects ${((effects |> SELECT effectTracker__display(_)) |> ORDER_BY _).join(", ")}";
}
END
PRIVATE FN capabilityAuditSession__finalize_capability_audit_mut(MUTABLE self: CapabilityAuditSession) RETURNS !?{String}BindingAuditRecord
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN (TRY (capabilityAuditSession__capability_audit(rtoc_self_view))).values() DO
    MUTABLE loc: String = "";
      IF _.line EXISTS AS line_value THEN
        loc = " (line ${line_value.toString()})";
      ELSE
        loc = "";
      END
    MUTABLE sync = COPY _.sync;
    MUTABLE own = COPY _.ownership;
    IF ((symbolEntry__locked_family_sync?(sync) AND !(_.mutated)) AND !(_.sharded)) THEN
        print("\x1B[36m[Note]\x1B[0m Variable '${_.var}' is @${sync} but never mutated via WITH EXCLUSIVE. You are paying for lock acquire/release on every access. Consider @local or removing the lock.${loc}");
    END
    IF ((own == :shared) AND !(_.captured_parallel)) THEN
        print("\x1B[36m[Note]\x1B[0m Variable '${_.var}' is @shared (Arc) but never preMirTypeCheck__leaves() the local scheduler. You are paying for atomic ref-counting but never crossing cores. Consider @multiowned or @local.${loc}");
    END
    IF (symbolEntry__local_sync?(sync) AND !(_.captured_bg)) THEN
        TRY (capabilityAuditSession__emit_local_never_shared_finding_mut(&rtoc_self_view, _));
    END
    END
    RETURN NIL;
}
END
PRIVATE FN capabilityAuditSession__propagate_lock_acquires_mut(MUTABLE self: CapabilityAuditSession) RETURNS !{String}[Set]String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE transitive: {String}[Set]String@symbol = {};
    capabilityAuditSession__phase_audit_inputs(rtoc_self_view).lock_analysis.direct_acquires.keys() |> EACH {
    MUTABLE set: [Set]String@symbol = (capabilityAuditSession__phase_audit_inputs(rtoc_self_view).lock_analysis.direct_acquires[_] OR_ELSE CAST(panic("missing hash key") AS [Set]String@symbol));
    transitive[_] = COPY set;
    };
    FOR _ IN (TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view))).keys() DO
    transitive[_] = (transitive[_] OR_ELSE Set[]);
    END
    WHILE TRUE DO
      MUTABLE changed: Bool = FALSE;
      FOR rtoc_each_21 IN (TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view))).keys() DO
    MUTABLE callees: [Set]String = ((TRY (capabilityAuditSession__function_call_graph(&rtoc_self_view)))[rtoc_each_21] OR_ELSE CAST(panic("missing hash key") AS [Set]String));
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < callees.length() DO
      IF !(transitive[UNWRAP (callees[rtoc_idx])]) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE rtoc_each_items_27 = (transitive[UNWRAP (callees[rtoc_idx])]);
      MUTABLE rtoc_idx_n4 = 0;
      WHILE rtoc_idx_n4 < rtoc_each_items_27.length() DO
          MUTABLE fn_set = transitive[rtoc_each_21];
          IF fn_set.contains?(rtoc_each_items_27[rtoc_idx_n4]) THEN
                rtoc_idx_n4 = rtoc_idx_n4 + 1;
    CONTINUE;
          END
          &fn_set.append(COPY rtoc_each_items_27[rtoc_idx_n4]);
          changed = TRUE;
        rtoc_idx_n4 = rtoc_idx_n4 + 1;
      END
    rtoc_idx = rtoc_idx + 1;
      END
            END
      IF !(changed) THEN
        BREAK;
      END
    END
    RETURN transitive;
}
END
PRIVATE FN capabilityAuditSession__resolve_held_calls_mut(MUTABLE self: CapabilityAuditSession, transitive_acquires: {String}[Set]String@symbol) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE state = COPY capabilityAuditSession__phase_audit_inputs(rtoc_self_view).lock_analysis;
    state.held_calls.keys() |> EACH {
    MUTABLE fn = COPY _;
    MUTABLE sites: []LockHeldCallSite = (state.held_calls[fn] OR_ELSE CAST(panic("missing hash key") AS []LockHeldCallSite));
    FOR site IN sites DO
    FOR t IN ((transitive_acquires[site.callee] OR_ELSE Set[])) DO
    IF state.direct_edges[fn] EXISTS AS rtoc_map_slot_28 THEN
      &rtoc_map_slot_28.append(LockEdge{ held: COPY site.held, acquired: COPY t, site_token: COPY site.site_token, fn_name: COPY fn, opted_out: site.opted_out });
    ELSE
      panic("T.must: map slot is NIL");
    END
    END
    END
    };
    NIL;
}
END
PRIVATE FN capabilityAuditSession__build_lock_graph(self: CapabilityAuditSession, MUTABLE include_opted_out: Bool = FALSE) RETURNS LockGraph
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE adj: {String@symbol}[Set]String@symbol = {};
    MUTABLE nodes: [Set]String@symbol = Set[];
    MUTABLE live: []LockEdge = ( { MUTABLE rtoc_empty_list_29: []LockEdge = List[]; rtoc_empty_list_29 } );
    FOR rtoc_each_22 IN capabilityAuditSession__phase_audit_inputs(rtoc_self_view).lock_analysis.direct_edges.keys() DO
    MUTABLE edges: []LockEdge = (capabilityAuditSession__phase_audit_inputs(rtoc_self_view).lock_analysis.direct_edges[rtoc_each_22] OR_ELSE CAST(panic("missing hash key") AS []LockEdge));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < edges.length() DO
      IF ((edges[rtoc_idx]?.opted_out OR_ELSE FALSE) AND !(include_opted_out)) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF adj[UNWRAP (edges[rtoc_idx]).held] == NIL THEN
          adj[UNWRAP (UNWRAP (edges[rtoc_idx]).held)] = Set[];
        END
        IF adj[edges[rtoc_idx]?.held] EXISTS AS rtoc_map_slot_30 THEN
          &rtoc_map_slot_30.insert(edges[rtoc_idx]?.acquired);
        END
      &nodes.insert(edges[rtoc_idx]?.held);
      &nodes.insert(edges[rtoc_idx]?.acquired);
      &live.append(COPY edges[rtoc_idx]?);
    rtoc_idx = rtoc_idx + 1;
    END
        END
    RETURN LockGraph{ nodes: COPY nodes, adj: COPY adj, edges: COPY live };
}
END
PRIVATE FN capabilityAuditSession__tarjan_scc(self: CapabilityAuditSession, nodes: [Set]String@symbol, adj: {String@symbol}[Set]String@symbol) RETURNS ![][]String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE empty: [Set]String@symbol = Set[];
    MUTABLE reverse_adj: {String@symbol}[Set]String@symbol = {};
    adj.keys() |> EACH {
    MUTABLE targets: [Set]String@symbol = (adj[_] OR_ELSE CAST(panic("missing hash key") AS [Set]String@symbol));
    FOR _ IN targets DO
    IF reverse_adj[_] == NIL THEN
      reverse_adj[_] = Set[];
    END
    IF reverse_adj[_] EXISTS AS rtoc_map_slot_31 THEN
      &rtoc_map_slot_31.insert(COPY _);
    END
    END
    };
    MUTABLE visited: [Set]String@symbol = Set[];
    MUTABLE finish_order: []String@symbol = ( { MUTABLE rtoc_empty_list_32: []String@symbol = List[]; rtoc_empty_list_32 } );
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < nodes.length() DO
      IF visited.contains?(nodes[rtoc_idx]) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE stack: []LockSccFrame = [LockSccFrame{ node: COPY nodes[rtoc_idx], expanded: FALSE }];
      WHILE !((stack.length() == 0)) DO
          MUTABLE frame = UNWRAP (&stack.pop());
          MUTABLE node = frame.node;
          IF frame.expanded THEN
            &finish_order.append(node);
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
          END
          IF visited.contains?(node) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
          END
          &visited.insert(node);
          &stack.append(LockSccFrame{ node: COPY node, expanded: TRUE });
          FOR _ IN (adj[node] OR_ELSE empty) DO
          IF !(visited.contains?(_)) THEN
            &stack.append(LockSccFrame{ node: COPY _, expanded: FALSE });
          END
          END
      END
    rtoc_idx = rtoc_idx + 1;
    END
    MUTABLE assigned: [Set]String@symbol = Set[];
    MUTABLE sccs: [][]String@symbol = ( { MUTABLE rtoc_empty_list_33: [][]String@symbol = List[]; rtoc_empty_list_33 } );
    MUTABLE rtoc_reverse_items_34: []String@symbol = finish_order;
    MUTABLE rtoc_reverse_i_35 = rtoc_reverse_items_34.length() - 1;
    WHILE rtoc_reverse_i_35 >= 0 DO
      IF assigned.contains?((rtoc_reverse_items_34[rtoc_reverse_i_35])?) THEN
        rtoc_reverse_i_35 = rtoc_reverse_i_35 - 1;
    CONTINUE;
      END
      MUTABLE component: []String@symbol = ( { MUTABLE rtoc_empty_list_36: []String@symbol = List[]; rtoc_empty_list_36 } );
      MUTABLE stack: []String@symbol = [(rtoc_reverse_items_34[rtoc_reverse_i_35])?];
      WHILE !((stack.length() == 0)) DO
          MUTABLE node = symbol(UNWRAP (&stack.pop()));
          IF assigned.contains?(node) THEN
            rtoc_reverse_i_35 = rtoc_reverse_i_35 - 1;
    CONTINUE;
          END
          &assigned.insert(node);
          &component.append(node);
          FOR _ IN (reverse_adj[node] OR_ELSE empty) DO
          IF !(assigned.contains?(_)) THEN
            &stack.append(COPY _);
          END
          END
      END
      &sccs.append(component);
    rtoc_reverse_i_35 = rtoc_reverse_i_35 - 1;
    END
    RETURN sccs;
}
END
PRIVATE FN capabilityAuditSession__check_lock_cycles_mut(MUTABLE self: CapabilityAuditSession) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE transitive_acquires = TRY (capabilityAuditSession__propagate_lock_acquires_mut(&rtoc_self_view));
    capabilityAuditSession__resolve_held_calls_mut(&rtoc_self_view, transitive_acquires);
    MUTABLE non_opted = capabilityAuditSession__build_lock_graph(rtoc_self_view, FALSE);
    MUTABLE rtoc_each_items_37 = TRY (capabilityAuditSession__tarjan_scc(rtoc_self_view, non_opted.nodes, non_opted.adj));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_37.length() DO
      IF !(capabilityAuditSession__scc_is_cyclic?(&rtoc_self_view, rtoc_each_items_37[rtoc_idx]?, non_opted.adj)) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      TRY (capabilityAuditSession__report_lock_cycle_mut(&rtoc_self_view, rtoc_each_items_37[rtoc_idx]?, non_opted.edges));
    rtoc_idx = rtoc_idx + 1;
    END
    TRY (capabilityAuditSession__check_lock_handler_reachability_mut(&rtoc_self_view));
    NIL;
}
END
PRIVATE FN capabilityAuditSession__check_lock_handler_reachability_mut(MUTABLE self: CapabilityAuditSession) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE clause_sites = COPY capabilityAuditSession__phase_audit_inputs(rtoc_self_view).lock_analysis.clause_sites;
    IF (clause_sites.length() == 0) THEN
      RETURN;
    END
    MUTABLE full = capabilityAuditSession__build_lock_graph(rtoc_self_view, TRUE);
    MUTABLE types_in_cycle = Set[];
    MUTABLE types_with_self = Set[];
    FOR _ IN TRY (capabilityAuditSession__tarjan_scc(rtoc_self_view, full.nodes, full.adj)) DO
    IF (_.length() >= 2) THEN
      FOR _ IN _ DO
      &types_in_cycle.insert(COPY _);
      END
    ELSE
      MUTABLE node = COPY symbol(UNWRAP (_.first()));
      IF (UNWRAP (full.adj[node])).contains?(node) THEN
        &types_in_cycle.insert(COPY node);
        &types_with_self.insert(COPY node);
      END
    END
    END
    FOR _ IN clause_sites DO
    TRY (capabilityAuditSession__verify_handler_reachability_mut(&rtoc_self_view, _, types_in_cycle, types_with_self));
    END
    NIL;
}
END
PRIVATE FN capabilityAuditSession__verify_handler_reachability_mut(MUTABLE self: CapabilityAuditSession, site: LockClauseSite, types_in_cycle: [Set]String@symbol, types_with_self: [Set]String@symbol) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE possible: [Set]String@symbol = Set[];
    MUTABLE node = COPY site.node;
    MUTABLE clause: ?ErrorClause = node.lock_error_clause;
    IF !(clause) THEN
      RETURN;
    END
    IF (node.snapshot_mode == :transaction) THEN
      MUTABLE has_atomic_ptr = (TRY (withCapabilityPlan__snapshot_transitions((TRY (capabilityPlan__require_for(CAST(node AS WithBlock))))))) |> ANY {
    MUTABLE sym: ?SymbolEntry@multiowned = COPY KEEP _.source_entry;
    ((((sym != NIL) AND symbolEntry__atomic?(sym)) AND TRUE) AND symbolEntry__indirect?(sym))
      };
      possible = ( { MUTABLE rtoc_pipe_src = [IF has_atomic_ptr THEN
        :AtomicConflict
      ELSE
        :MvccConflict
      END]; rtoc_pipe_src |> DISTINCT _ } );
    ELSE
      possible = Set[];
      IF (site.cap_types.length() > 0) THEN
        &possible.insert(:LockTimeout);
      END
      FOR _ IN site.cap_types DO
    IF types_in_cycle.contains?(_) THEN
          &possible.insert(:LockCycle);
    END
    IF types_with_self.contains?(_) THEN
          &possible.insert(:Deadlock);
    END
      END
    END
    IF !(((TRY (withCapabilityPlan__guarded((TRY (capabilityPlan__require_for(CAST(node AS WithBlock))))))).length() == 0)) THEN
      &possible.insert(:GuardFail);
    END
    MUTABLE rtoc_each_items_38 = clause.selectors;
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_38.length() DO
      MUTABLE expansion = PARTIAL MATCH UNWRAP (rtoc_each_items_38[rtoc_idx]).form START
          :kind -> (TRY (aST__types_for_kind(UNWRAP (rtoc_each_items_38[rtoc_idx]).name()))) |> DISTINCT _,
          :type -> ( { MUTABLE rtoc_pipe_src = [UNWRAP (rtoc_each_items_38[rtoc_idx]).name()]; rtoc_pipe_src |> DISTINCT _ } ),
          DEFAULT -> Set[]
        END;
      MUTABLE reachable = ruby_set_intersection_String_symbol_set(expansion, possible);
      IF !(reachable.empty?()) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE label = COPY CAST(UNWRAP (rtoc_each_items_38[rtoc_idx]).name() AS String);
      TRY (capabilityAuditSession__error_mut(&rtoc_self_view, (UNWRAP (rtoc_each_items_38[rtoc_idx]).token() OR node), CapabilityAuditCodeOrMessage{ SymbolValue: :SELECTOR_NOT_POSSIBLE }, [], CAST({:label: label} AS {String@symbol}Any)));
    rtoc_idx = rtoc_idx + 1;
    END
    NIL;
}
END
PRIVATE FN capabilityAuditSession__scc_is_cyclic?(MUTABLE self: CapabilityAuditSession, scc: []String@symbol, adj: {String@symbol}[Set]String@symbol) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (scc.length() > 1) THEN
      RETURN TRUE;
    END
    MUTABLE node = COPY symbol(UNWRAP (scc.first()));
    RETURN (UNWRAP (adj[node])).contains?(node);
}
END
PRIVATE FN capabilityAuditSession__report_lock_cycle_mut(MUTABLE self: CapabilityAuditSession, scc: []String@symbol, edges: []LockEdge) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE scc_set = scc |> DISTINCT _;
    MUTABLE participating = edges |> WHERE (scc_set.contains?(_.held) AND scc_set.contains?(_.acquired));
    MUTABLE sample: ?LockEdge = COPY participating.first();
    MUTABLE site_lines = (CAST(((participating |> SELECT {
    MUTABLE line: String = "?";
    IF COPY _.site_token != NIL THEN
        line = ((COPY _.site_token)?).line;
      END
    "  - ${_.fn_name} (line ${line}): holds :${_.held}, acquires :${_.acquired}"
    }) |> DISTINCT _) AS []String)).join("\n");
    MUTABLE types_str = (scc |> SELECT ":${_}").join(", ");
    MUTABLE kind: String = "";
    IF (scc.length() == 1) THEN
      kind = "self-loop (same-type nested acquire)";
    ELSE
      kind = "lock cycle (graph SCC)";
    END
    MUTABLE anchor: ?Token@multiowned = NIL;
    IF sample != NIL THEN
      anchor = COPY sample.site_token;
    END
    RETURN TRY (capabilityAuditSession__error_mut(&rtoc_self_view, (anchor OR_ELSE capabilityAuditSession__semantic_program(rtoc_self_view)), CapabilityAuditCodeOrMessage{ SymbolValue: :LOCK_CYCLE_DETECTED }, [], CAST({:kind: kind, :types: types_str, :sites: site_lines} AS {String@symbol}Any)));
}
END
PRIVATE FN capabilityAuditSession__run_deferred_validations_mut(MUTABLE self: CapabilityAuditSession) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (capabilityAuditSession__flush_deferred_recovery_validations_mut(&rtoc_self_view));
    TRY (capabilityAuditSession__flush_deferred_with_validations_mut(&rtoc_self_view));
    TRY (capabilityAuditSession__flush_deferred_give_validations_mut(&rtoc_self_view));
    TRY (capabilityAuditSession__flush_deferred_copy_retained_validations_mut(&rtoc_self_view));
    TRY (capabilityAuditSession__finalize_capability_audit_mut(&rtoc_self_view));
}
END
PRIVATE FN capabilityAuditSession__flush_deferred_give_validations_mut(MUTABLE self: CapabilityAuditSession) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_each_items_39 = (TRY (capabilityAuditSession__deferred_give_validations(rtoc_self_view)));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_39.length() DO
      MUTABLE param: ?FunctionDef = ((TRY (capabilityAuditSession__function_node_for(rtoc_self_view, rtoc_each_items_39[rtoc_idx]?.callee_name)))?.params[rtoc_each_items_39[rtoc_idx]?.param_index]);
      IF (IF param != NIL THEN
          { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_40 = param.symbol;
      symbolEntry__kept_identity(rtoc_local_receiver_40) }
        ELSE
          NIL
        END) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      TRY (capabilityAuditSession__error_mut(&rtoc_self_view, rtoc_each_items_39[rtoc_idx]?.arg_node, CapabilityAuditCodeOrMessage{ SymbolValue: :GIVE_TO_BORROW_PARAM }, [], CAST({:param: rtoc_each_items_39[rtoc_idx]?.param_name} AS {String@symbol}Any)));
    rtoc_idx = rtoc_idx + 1;
    END
    capabilityAuditSession__clear_deferred_give_validations_mut(&rtoc_self_view);
}
END
PRIVATE FN capabilityAuditSession__flush_deferred_copy_retained_validations_mut(MUTABLE self: CapabilityAuditSession) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_each_items_42 = (TRY (capabilityAuditSession__deferred_copy_retained_validations(rtoc_self_view)));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_42.length() DO
      MUTABLE param: ?FunctionDef = ((TRY (capabilityAuditSession__function_node_for(rtoc_self_view, rtoc_each_items_42[rtoc_idx]?.callee_name)))?.params[rtoc_each_items_42[rtoc_idx]?.param_index]);
      IF (IF param != NIL THEN
          { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_43 = param.symbol;
      symbolEntry__kept_identity(rtoc_local_receiver_43) }
        ELSE
          NIL
        END) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      TRY (capabilityAuditSession__error_mut(&rtoc_self_view, rtoc_each_items_42[rtoc_idx]?.arg_node, CapabilityAuditCodeOrMessage{ SymbolValue: :COPY_RETAINED_NEEDS_UNIQUE }, [], CAST({:name: emittable__name(UNWRAP (rtoc_each_items_42[rtoc_idx])), :carrier: rtoc_each_items_42[rtoc_idx]?.carrier} AS {String@symbol}Any)));
    rtoc_idx = rtoc_idx + 1;
    END
    capabilityAuditSession__clear_deferred_copy_retained_validations_mut(&rtoc_self_view);
}
END
PRIVATE FN capabilityAuditSession__flush_deferred_recovery_validations_mut(MUTABLE self: CapabilityAuditSession) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR MUTABLE validation IN (TRY (capabilityAuditSession__deferred_recovery_validations(rtoc_self_view))) DO
    MUTABLE callee: ?FunctionDef@multiowned = TRY (capabilityAuditSession__function_node_for(rtoc_self_view, validation.callee_name));
    IF !(((callee != NIL) AND (callee.can_fail == TRUE))) THEN
        TRY (capabilityAuditSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ BinaryOp: COPY validation.node } }, CapabilityAuditCodeOrMessage{ SymbolValue: :OR_ELSE_NEEDS_RECOVERABLE_LEFT }, [], CAST({:got: TRY (type__surface_name_type(validation.value_type))} AS {String@symbol}Any)));
    END
    validation.left.can_fail = TRUE;
    validation.left.error_union_type = TRY (type__error_union_of(castTypeToTypeTypeInput__capability_audit_session(validation.value_type)));
    END
    capabilityAuditSession__clear_deferred_recovery_validations_mut(&rtoc_self_view);
}
END
PRIVATE FN capabilityAuditSession__flush_deferred_with_validations_mut(MUTABLE self: CapabilityAuditSession) RETURNS ![]DeferredWithValidation
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_each_items_45 = (TRY (capabilityAuditSession__deferred_with_validations(rtoc_self_view)));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_45.length() DO
      MUTABLE fact = COPY rtoc_each_items_45[rtoc_idx]?.fact;
      MUTABLE var_node = COPY fact?.var_node;
      MUTABLE syn: ?String = (IF locatable__symbol(UNWRAP (var_node)) != NIL THEN
          symbolEntry__sync(UNWRAP ((locatable__symbol(UNWRAP (var_node)))))
        ELSE
          NIL
        END);
      IF (UNWRAP (fact).capability == symbol("EXCLUSIVE")) THEN
          IF syn THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
          END
          MUTABLE storage = (IF var_node.symbol != NIL THEN
            (var_node.symbol).storage()
          ELSE
            NIL
          END);
          TRY (capabilityAuditSession__error_mut(&rtoc_self_view, KEEP rtoc_each_items_45[rtoc_idx]?.node, CapabilityAuditCodeOrMessage{ SymbolValue: :WITH_EXCLUSIVE_NEEDS_LOCK_GOT }, [], CAST({:got: (storage OR_ELSE "unknown")} AS {String@symbol}Any)));
      ELSE_IF (fact.capability == :write_locked_read) THEN
          IF (syn == :write_locked) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
          END
          TRY (capabilityAuditSession__error_mut(&rtoc_self_view, KEEP rtoc_each_items_45[rtoc_idx]?.node, CapabilityAuditCodeOrMessage{ SymbolValue: :WITH_READ_NEEDS_WRITE_LOCK_NAME }, [], CAST({:name: fact.target_label} AS {String@symbol}Any)));
      ELSE_IF (fact.capability == :ATOMIC) THEN
          IF (syn == :atomic) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
          END
          MUTABLE storage = (IF var_node.symbol != NIL THEN
            (var_node.symbol).storage()
          ELSE
            NIL
          END);
          MUTABLE actual: String = "";
          IF syn THEN
            actual = "@${syn}";
          ELSE
            actual = (IF storage THEN
              "@${storage}"
            ELSE
              "plain"
            END);
          END
          TRY (capabilityAuditSession__error_mut(&rtoc_self_view, KEEP rtoc_each_items_45[rtoc_idx]?.node, CapabilityAuditCodeOrMessage{ SymbolValue: :WITH_ATOMIC_NEEDS_SHARED_ATOMIC }, [], CAST({:name: fact.target_label, :actual: actual} AS {String@symbol}Any)));
      END
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN capabilityAuditSession__clear_deferred_with_validations_mut(&rtoc_self_view);
}
END
PRIVATE FN capabilityAuditSession__finalize_program_audit_mut(MUTABLE self: CapabilityAuditSession, program: Program) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (capabilityAuditSession__check_indirect_reentrancy_mut(&rtoc_self_view));
    TRY (capabilityAuditSession__validate_not_logical_recursion_mut(&rtoc_self_view));
