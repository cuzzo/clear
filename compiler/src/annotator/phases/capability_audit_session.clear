        &result.delete(blocking_maybe);
      ELSE_IF ((!(any_concrete_lockable) AND !(any_polymorphic_arg)) AND any_concrete_sync) THEN
        &result.delete(blocking_maybe);
      ELSE_IF any_polymorphic_arg THEN
    
      END
    END
    IF has_cont_maybe THEN
      IF (any_concrete_sync AND !(any_polymorphic_arg)) THEN
        &result.insert(contention);
        &result.delete(contention_maybe);
      ELSE_IF any_polymorphic_arg THEN
    
      ELSE
        &result.delete(contention_maybe);
      END
    END
    RETURN result;
