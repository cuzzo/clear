EXTERN STRUCT CompilerRegex {} FROM "compiler_regex";
EXTERN STRUCT CompilerRegexScanner {} CLOSE "deinit" FROM "compiler_regex";
EXTERN FN compilerRegexCompile(pattern: String) RETURNS CompilerRegex EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexMatch(subject: String, regex: CompilerRegex) RETURNS Bool EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexMatchData(subject: String, regex: CompilerRegex) RETURNS ?CompilerRegexScanner EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexFirstMatch(subject: String, regex: CompilerRegex) RETURNS subject:?String EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexReplaceAll(subject: String, regex: CompilerRegex, replacement: String) RETURNS String EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexReplaceFirst(subject: String, regex: CompilerRegex, replacement: String) RETURNS String EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexEscape(value: String) RETURNS String EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexCapture(scanner: CompilerRegexScanner, index: Int64) RETURNS scanner:String EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerStringChomp(value: String, separator: String) RETURNS String EFFECTS :safe FROM "compiler_regex";
UNION CapabilityAuditBodyFacts { BodyScanSummary: BodyScanSummary, FunctionBodySummary: FunctionBodySummary }
UNION CapabilityAuditCall { FuncCall: FuncCall, MethodCall: MethodCall }
UNION CapabilityAuditCodeOrMessage { StringValue: String, SymbolValue: String@symbol }
UNION CapabilityAuditReg { VarDecl: VarDecl, DestructureTarget: DestructureTarget }
# Ruby module Annotator
# Ruby module Annotator::Phases
PUB STRUCT CapabilityAuditSession {
  context: Context,
  derived_call_views: {String@symbol}{String}[Set]String,
  derived_call_views_source: ?{String}LocalFunctionFacts
}

PUB STRUCT Context {
  typed_program: TypedProgramFacts@multiowned,
  inputs: CapabilityAuditInputs,
  source_code: ?String,
  language_mode: String@symbol,
  strict_test: Bool
}
PUB FN capabilityAuditSession__initialize(MUTABLE self: CapabilityAuditSession, typed_program: TypedProgramFacts, inputs: CapabilityAuditInputs, source_code: ?String, language_mode: String@symbol, strict_test: Bool) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.context = Context{ typed_program: typed_program, inputs: COPY inputs, source_code: COPY source_code, language_mode: COPY language_mode, strict_test: strict_test };
    rtoc_self_view.derived_call_views = {};
    rtoc_self_view.derived_call_views_source = NIL;
}
END
PUB FN capabilityAuditSession__audit_mut(MUTABLE self: CapabilityAuditSession) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (capabilityAuditSession__finalize_program_audit_mut(&rtoc_self_view, CAST(capabilityAuditSession__semantic_program(rtoc_self_view) AS Program)));
    TRY (capabilityAuditSession__run_whole_program_semantics_mut(&rtoc_self_view));
    TRY (capabilityAuditSession__run_deferred_validations_mut(&rtoc_self_view));
}
END
PRIVATE FN capabilityAuditSession__phase_audit_inputs(self: CapabilityAuditSession) RETURNS CapabilityAuditInputs
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY rtoc_self_view.context.inputs;
}
END
