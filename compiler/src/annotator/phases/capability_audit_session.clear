  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY capabilityAuditSession__semantic_function_registry(rtoc_self_view).nodes;
}
END
FN capabilityAuditSession__function_node_map(self: CapabilityAuditSession) RETURNS !{String}FunctionDef@multiowned ->
  TRY (capabilityAuditSession__semantic_function_nodes(self));
END
