PRIVATE FN capabilityAuditSession__derived_call_view(MUTABLE self: CapabilityAuditSession, kind: String@symbol, block: FN(LocalFunctionFacts) -> ![Set]String) RETURNS !{String}[Set]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE facts = TRY (capabilityAuditSession__local_function_facts(rtoc_self_view));
    # Ruby drops these cached views when the facts table is a different
    # object. CLEAR copies values, so that question cannot be asked --
    # recomputing builds the same views from the same facts.
    &rtoc_self_view.derived_call_views.clear();
    MUTABLE cached: ?{String}[Set]String = COPY rtoc_self_view.derived_call_views[kind];
    IF cached EXISTS AS cached_value THEN
      RETURN COPY cached_value;
    END
    MUTABLE view: {String}[Set]String = {};
    facts.keys() |> EACH {
    MUTABLE function: LocalFunctionFacts = (facts[_] OR_ELSE CAST(panic("missing hash key") AS LocalFunctionFacts));
    view[_] = TRY (block(function));
    };
    rtoc_self_view.derived_call_views[kind] = view;
    RETURN view;
}
END
PRIVATE FN capabilityAuditSession__function_has_fnptr_call?(self: CapabilityAuditSession, name: String) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (((TRY (capabilityAuditSession__local_function_facts(rtoc_self_view)))[name] != NIL) AND ((((TRY (capabilityAuditSession__local_function_facts(rtoc_self_view)))[name])?).has_function_pointer_call == TRUE));
}
END
