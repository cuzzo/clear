PRIVATE FN capabilityAuditSession__resolve_maybe_effects(self: CapabilityAuditSession, callee_set: [Set]String@symbol, caller_name: String, callee_name: String) RETURNS ![Set]String@symbol
  REQUIRES self: LOCAL
