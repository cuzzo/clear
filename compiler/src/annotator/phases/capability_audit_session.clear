    IF fix EXISTS AS fix_value THEN
      capabilityAuditSession__fixable_mut(rtoc_self_view, node, :ownership, [fix_value], NIL, :CAPTURE_IMMUTABLE_AS_MUTABLE, :error, FALSE, {:name: cap_name});
    ELSE
      RETURN capabilityAuditSession__error_mut(rtoc_self_view, node, CodeOrMessage{ SymbolValue: :CAPTURE_IMMUTABLE_AS_MUTABLE }, [], {:name: cap_name});
    END
}
