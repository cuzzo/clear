  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (((TRY (capabilityAuditSession__local_function_facts(rtoc_self_view)))[name] != NIL) AND ((((TRY (capabilityAuditSession__local_function_facts(rtoc_self_view)))[name])?).raises_directly == TRUE));
}
END
