# Ruby module Annotator
# Ruby module Annotator::Phases
PUB STRUCT ResolutionSession {
  function_registry: FunctionRegistry,
  importer: ?ModuleImporter@multiowned,
  local_type_declaration_names: [Set]String@symbol,
  protocols: {String}ProtocolDef,
  root_scope: Scope@multiowned,
  scope_stack: []Scope@multiowned,
  source_code: ?String,
  source_dir: String
}

PUB FN resolutionSession__builtin_type_parameter_names() RETURNS []String@symbol EFFECTS REENTRANT ->
  RETURN [:Number, :Bool, :Byte, :Int8, :Int16, :Int32, :Int64, :UInt8, :UInt16, :UInt32, :UInt64, :Float32, :Float64, :TargetInt, :TargetUInt, :TargetLong, :TargetULong, :TargetLongLong, :TargetULongLong, :String, :Any, :Void, :Range, :Map];
END
PUB FN resolutionSession__initialize(MUTABLE self: ResolutionSession, importer: ?ModuleImporter, source_dir: String, source_code: ?String, root_scope: ?Scope = NIL, function_registry: ?FunctionRegistry = NIL, install_builtins: Bool = TRUE) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.importer = COPY importer;
    rtoc_self_view.source_dir = COPY source_dir;
    rtoc_self_view.source_code = COPY source_code;
    rtoc_self_view.root_scope = (root_scope OR_ELSE scope__new());
    rtoc_self_view.scope_stack = [rtoc_self_view.root_scope];
    rtoc_self_view.function_registry = (function_registry OR_ELSE FunctionRegistry{ nodes: {}, synthetic_definitions: List[], body_summaries: {} });
    rtoc_self_view.protocols = {};
    rtoc_self_view.local_type_declaration_names = Set[];
    IF install_builtins THEN
      TRY (resolutionSession__initialize_builtin_environment_mut(&rtoc_self_view));
    END
}
END
PUB FN resolutionSession__resolve_mut(MUTABLE self: ResolutionSession, MUTABLE program: Program) RETURNS !ResolutionFacts@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE declarations = TRY (declarationIndexer__index(program));
    rtoc_self_view.local_type_declaration_names = (declarations.type_declarations |> SELECT symbol(UNWRAP (aST__node_name(UNWRAP (castTypeDeclarationToLocatable(_)))))) |> DISTINCT _;
    FOR MUTABLE rtoc_for_elem_99 IN declarations.imports DO
    TRY (resolutionSession__visit_RequireNode(&rtoc_self_view, &rtoc_for_elem_99));
    END
    TRY (resolutionSession__register_type_declarations(&rtoc_self_view, declarations));
    MUTABLE conformance_resolutions = TRY (resolutionSession__resolve_conformance_declarations_mut(&rtoc_self_view, declarations));
    MUTABLE implementation_resolutions = TRY (resolutionSession__resolve_implementation_declarations_mut(&rtoc_self_view, declarations));
    TRY (resolutionSession__prepare_conformance_members_mut(&rtoc_self_view, &declarations, conformance_resolutions, &program));
    TRY (resolutionSession__prepare_implementation_members_mut(&rtoc_self_view, &declarations, implementation_resolutions, &program));
    TRY (resolutionSession__register_program_signatures(&rtoc_self_view, declarations));
    RETURN resolutionFacts__new(program, declarations, rtoc_self_view.root_scope, rtoc_self_view.function_registry, rtoc_self_view.root_scope.types.keys(), TRY (resolutionSession__resolved_function_names(rtoc_self_view)), implementation_resolutions, conformance_resolutions, rtoc_self_view.protocols);
}
END
PUB FN resolutionSession__protocol_declared?(self: ResolutionSession, name: String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ((name == "Map") OR rtoc_self_view.protocols.contains?(name));
}
END
PUB FN resolutionSession__register_protocol_mut(MUTABLE self: ResolutionSession, protocol: ProtocolDef) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.protocols[protocol.name] = COPY protocol;
}
END
PUB FN resolutionSession__register_local_declaration_mut(MUTABLE self: ResolutionSession, MUTABLE node: Node) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node IS_A StructDef AS struct_def THEN
      TRY (resolutionSession__register_type_declaration(&rtoc_self_view, TypeDeclaration{ StructDef: COPY struct_def }));
    ELSE_IF node IS_A ExternStructDecl AS MUTABLE extern_struct_decl THEN
      TRY (resolutionSession__register_type_declaration(&rtoc_self_view, TypeDeclaration{ ExternStructDecl: COPY extern_struct_decl }));
    ELSE_IF node IS_A EnumDef AS enum_def THEN
      TRY (resolutionSession__register_type_declaration(&rtoc_self_view, TypeDeclaration{ EnumDef: COPY enum_def }));
    ELSE_IF node IS_A UnionDef AS union_def THEN
      TRY (resolutionSession__register_type_declaration(&rtoc_self_view, TypeDeclaration{ UnionDef: COPY union_def }));
    ELSE_IF node IS_A ExternFnDecl AS MUTABLE extern_fn_decl THEN
      TRY (resolutionSession__register_extern_function_signature(&rtoc_self_view, &extern_fn_decl));
    END
}
END
PUB FN resolutionSession__scope_stack(self: ResolutionSession) RETURNS ![]Scope@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY rtoc_self_view.scope_stack;
}
END
PUB FN resolutionSession__active_importer(self: ResolutionSession) RETURNS ?ModuleImporter@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN KEEP rtoc_self_view.importer;
}
END
PUB FN resolutionSession__import_source_dir(self: ResolutionSession) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY rtoc_self_view.source_dir;
}
END
PUB FN resolutionSession__stamp_type_mut<Stamp>(self: ResolutionSession, MUTABLE node: Locatable, value: Stamp) RETURNS !Stamp
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (FALSE) THEN
      panic("resolution stamp missing type for {}");
    END
    TRY (aST__set_full_type_mut(&node, CAST(value AS SyntheticTypeInput)));
    TRY (aST__full_type_mut(node));
    RETURN COPY value;
}
END
PUB FN resolutionSession__synthetic_function_definitions(self: ResolutionSession) RETURNS ![]FunctionDef
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY rtoc_self_view.function_registry.synthetic_definitions;
}
END
