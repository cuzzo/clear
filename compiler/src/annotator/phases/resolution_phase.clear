    END
    TRY (resolutionSession__stamp_field_defaults_mut(&rtoc_self_view, node.field_decls));
    TRY (resolutionSession__declare_type_schema_mut(&rtoc_self_view, TypeDeclaration{ StructDef: COPY node }, symbol(node.name), SchemaValue{ StructSchemaMultiowned: COPY TRY (structSchema__new(castMapStructFieldToMapSchemasStructSchemaFieldInput(node.field_decls), TRY (resolutionSession__type_params(rtoc_self_view, node.type_params)), node.generic_params, {}, {}, node.visibility)) }));
    TRY (resolutionSession__stamp_type_mut(rtoc_self_view, Locatable{ StructDef: COPY node }, :Void));
}
END
PRIVATE FN resolutionSession__validate_generic_bounds_mut(MUTABLE self: ResolutionSession, params: []GenericParamDecl) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN params DO
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < _.bounds.length() DO
      IF resolutionSession__protocol_declared?(rtoc_self_view, CAST((type__resolved( UNWRAP ((_.bounds[rtoc_idx]?.type)))) AS String)) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      TRY (resolutionSession__error_mut(&rtoc_self_view, (IF (COPY _.bounds[rtoc_idx]?.token OR_ELSE COPY _.token) EXISTS AS rtoc_wrap_2040 THEN DiagnosticAnchor{ TokenValue: COPY rtoc_wrap_2040 } ELSE NIL END), ResolutionCodeOrMessage{ SymbolValue: :GENERIC_UNKNOWN_PROTOCOL }, [], CAST({:protocol: TRY (type__surface_name(castTypeToTypeTypeInput__resolution_phase( UNWRAP (_.bounds[rtoc_idx]?.type))))} AS {String@symbol}Any)));
    rtoc_idx = rtoc_idx + 1;
    END
    END
}
END
PRIVATE FN resolutionSession__resolve_declaration_projections_mut(MUTABLE self: ResolutionSession, node: Locatable, MUTABLE type: Type, parameters: []GenericParamDecl) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE result = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_58 = protocolProjectionResolver__new(rtoc_self_view.protocols);
    TRY (protocolProjectionResolver__resolve(rtoc_local_receiver_58, type.shape.expression, parameters)) };
    MUTABLE issue: ?ProtocolProjectionIssue = COPY result.issues.first();
    IF issue EXISTS AS issue_value THEN
      TRY (resolutionSession__emit_protocol_projection_issue_mut(&rtoc_self_view, castLocatableToNode__resolution_phase(node), issue_value));
    END
    MUTABLE rtoc_mutable_alias_arg_59 = COPY TRY (typeShape__with_expression(type.shape, result.expression));
    type__replace_shape_mut(&type, rtoc_mutable_alias_arg_59);
}
END
PRIVATE FN resolutionSession__register_enum_declaration(MUTABLE self: ResolutionSession, MUTABLE node: EnumDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (resolutionSession__declare_type_schema_mut(&rtoc_self_view, TypeDeclaration{ EnumDef: COPY node }, symbol(node.name), SchemaValue{ EnumSchemaMultiowned: COPY TRY (enumSchema__new((node.variants |> SELECT SchemasEnumSchemaVariantInputItem{ StringValue: COPY _ }), node.visibility)) }));
