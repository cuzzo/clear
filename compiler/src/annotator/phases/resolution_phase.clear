    Node.BindExpr AS item -> RETURN ResolutionSessionReturnValue{ BindExpr: COPY item };,
    Node.BinaryOp AS item -> RETURN ResolutionSessionReturnValue{ BinaryOp: COPY item };,
    Node.IsA AS item -> RETURN ResolutionSessionReturnValue{ IsA: COPY item };,
    Node.CallSiteOverride AS item -> RETURN ResolutionSessionReturnValue{ CallSiteOverride: COPY item };,
    Node.Identifier AS item -> RETURN ResolutionSessionReturnValue{ Identifier: COPY item };,
    Node.Literal AS item -> RETURN ResolutionSessionReturnValue{ Literal: COPY item };,
    Node.ListLit AS item -> RETURN ResolutionSessionReturnValue{ ListLit: COPY item };,
