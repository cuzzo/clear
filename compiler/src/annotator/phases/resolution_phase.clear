      ELSE
        close_plan = resourceClosePlan__method(UNWRAP (node.close_method));
      END
      schema = SchemaValue{ ResourceSchemaMultiowned: COPY TRY (resourceSchema__new(close_plan, {}, castStructFieldMapToSchemasResourceSchemaFieldInputMap(node.field_decls), TRY (resolutionSession__type_params(rtoc_self_view, node.type_params)), node.from_module, node.as_type, :package, {})) };
