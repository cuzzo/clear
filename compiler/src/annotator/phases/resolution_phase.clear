EXTERN STRUCT CompilerRegex {} FROM "compiler_regex";
EXTERN FN compilerRegexCompile(pattern: String) RETURNS CompilerRegex EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexMatch(subject: String, regex: CompilerRegex) RETURNS Bool EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexReplaceAll(subject: String, regex: CompilerRegex, replacement: String) RETURNS String EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexReplaceFirst(subject: String, regex: CompilerRegex, replacement: String) RETURNS String EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexEscape(value: String) RETURNS String EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerCountOccurrences(text: String, needle: String) RETURNS Int64 EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerLastIndex(text: String, needle: String) RETURNS Int64 EFFECTS :safe FROM "compiler_regex";
UNION ResolutionCodeOrMessage { StringValue: String, SymbolValue: String@symbol }
PUB UNION DiagnosticKwValue { StringValue: String, SymbolValue: String@symbol, Int64Value: Int64, AnyMultiowned: Any@multiowned }

# Ruby interpolates kwargs with `%`, which renders each value with to_s.
PUB FN diagnosticKwValue__to_s(value: ?DiagnosticKwValue) RETURNS String ->
  IF value EXISTS AS rtoc_value THEN
    PARTIAL MATCH rtoc_value START
      DiagnosticKwValue.StringValue AS item -> RETURN COPY item;,
      DiagnosticKwValue.SymbolValue AS item -> RETURN CAST(item AS String);,
      DEFAULT -> RETURN "";
    END
  END
  RETURN "";
END

# The registry formats a map of rendered strings; Ruby hands it the values
# themselves and lets the format render them.
PUB FN diagnosticKwargs__rendered(kwargs: {String@symbol}?DiagnosticKwValue) RETURNS {String@symbol}String ->
  MUTABLE out: {String@symbol}String = {};
  FOR rtoc_key IN kwargs.keys() DO
    out[rtoc_key] = diagnosticKwValue__to_s(UNWRAP (kwargs[rtoc_key]));
  END
  RETURN out;
END
