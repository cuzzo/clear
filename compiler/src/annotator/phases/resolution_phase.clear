    Type.StringValue AS cast_payload -> RETURN TypeConstructionInput{ StringValue: COPY cast_payload };,
    Type.SymbolValue AS cast_payload -> RETURN TypeConstructionInput{ SymbolValue: COPY cast_payload };,
    Type.Type AS cast_payload -> RETURN TypeConstructionInput{ Type: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to TypeConstructionInput");
  END
  panic("Invalid cast to TypeConstructionInput");
END
FN castTypeToTypeTypeInput(value: Type) RETURNS TypeTypeInput ->
  RETURN TypeTypeInput{ Type: COPY value };
END
FN castTypeToValue(value: Type) RETURNS Value ->
  PARTIAL MATCH value START
    Type.StringValue AS cast_payload -> RETURN Value{ StringValue: COPY cast_payload };,
    Type.SymbolValue AS cast_payload -> RETURN Value{ SymbolValue: COPY cast_payload };,
    Type.Type AS cast_payload -> RETURN Value{ Type: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Value");
  END
  panic("Invalid cast to Value");
END
FN castTypeTypeInputToTypeConstructionInput(value: TypeTypeInput) RETURNS TypeConstructionInput ->
  PARTIAL MATCH value START
    TypeTypeInput.FunctionType AS cast_payload -> RETURN TypeConstructionInput{ FunctionType: COPY cast_payload };,
    TypeTypeInput.StringValue AS cast_payload -> RETURN TypeConstructionInput{ StringValue: COPY cast_payload };,
    TypeTypeInput.SymbolValue AS cast_payload -> RETURN TypeConstructionInput{ SymbolValue: COPY cast_payload };,
    TypeTypeInput.Type AS cast_payload -> RETURN TypeConstructionInput{ Type: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to TypeConstructionInput");
  END
  panic("Invalid cast to TypeConstructionInput");
END
FN castValueToTypeConstructionInput(value: Value) RETURNS TypeConstructionInput ->
  PARTIAL MATCH value START
    Value.StringValue AS cast_payload -> RETURN TypeConstructionInput{ StringValue: COPY cast_payload };,
    Value.SymbolValue AS cast_payload -> RETURN TypeConstructionInput{ SymbolValue: COPY cast_payload };,
    Value.Type AS cast_payload -> RETURN TypeConstructionInput{ Type: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to TypeConstructionInput");
  END
  panic("Invalid cast to TypeConstructionInput");
END
FN ruby_array_concat_Any(left: []Any, right: []Any) RETURNS []Any ->
  MUTABLE result: []Any = [];
  left |> EACH { &result.append(COPY _); };
  right |> EACH { &result.append(COPY _); };
  RETURN result;
END
FN ruby_array_concat_Type(left: []Type, right: []Type) RETURNS []Type ->
  MUTABLE result: []Type = [];
  left |> EACH { &result.append(COPY _); };
  right |> EACH { &result.append(COPY _); };
  RETURN result;
END
FN ruby_union_scalar_equal_FunctionSignatureLifetimeSource_String_symbol(value: FunctionSignatureLifetimeSource, expected: String@symbol) RETURNS Bool ->
  IF value IS_A String@symbol AS equality_payload THEN
    RETURN equality_payload == expected;
  END
  FALSE;
END
FN ruby_wrap_optional_string_to_symbol(value: ?String) RETURNS ?String@symbol ->
  IF value EXISTS AS value_value THEN
    RETURN symbol(value_value);
  END
  NIL;
END
