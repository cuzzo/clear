    ELSE_IF node IS_A EnumDef AS MUTABLE enum_def THEN
      TRY (resolutionSession__register_enum_declaration(&rtoc_self_view, &enum_def));
    ELSE_IF node IS_A UnionDef AS MUTABLE union_def THEN
      TRY (resolutionSession__register_union_declaration(&rtoc_self_view, &union_def));
    END
}
END
PRIVATE FN resolutionSession__register_extern_struct_declaration(MUTABLE self: ResolutionSession, MUTABLE node: ExternStructDecl) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE schema: ?SchemaValue = NIL;
