PRIVATE FN resolutionSession__setup_builtins(self: ResolutionSession) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    FOR _ IN (TRY (stdLibRegistry__std_lib())).keys() DO
    MUTABLE rtoc_mutable_receiver_11 = resolutionSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_11, _, NIL, SymbolEntryTypeInput{ SymbolValue: :Intrinsic }, ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :stack));
    END
    FOR _ IN builtin_global_bindings DO
    MUTABLE rtoc_mutable_receiver_12 = resolutionSession__current_scope(rtoc_self_view);
    TRY (scope__declare(&rtoc_mutable_receiver_12, _.name, NIL, castTypeToOptionalSymbolEntryTypeInput(_.type), ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, _.storage));
    END
    FOR _ IN builtin_type_bindings DO
    MUTABLE rtoc_local_receiver_13 = resolutionSession__current_scope(rtoc_self_view);
    scope__install_type(rtoc_local_receiver_13, _.name, (COPY _.schema_factory)());
    END
    NIL;
}
END
PRIVATE FN resolutionSession__conformance_function_name(self: ResolutionSession, protocol_name: String, owner_name: String, member_name: String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE parts = ([protocol_name, owner_name, member_name]) |> SELECT compilerRegexReplaceAll(_, compilerRegexCompile("[^A-Za-z0-9_]"), "_");
    RETURN "__conformance_${parts.join("_")}";
}
END
PRIVATE FN resolutionSession__resolve_conformance_declarations_mut(self: ResolutionSession, declarations: DeclarationIndex) RETURNS ![]ConformanceResolution
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE local_structs = (declarations.type_declarations |> SELECT:? (  IF _ IS_A StructDef THEN
      [_.name(), _]
    ELSE
      NIL
    END) |> WHERE _ != NIL).to_h();
    MUTABLE local_protocols = (declarations.type_declarations |> SELECT:? (  IF _ IS_A ProtocolDef THEN
      _.name()
    ELSE
      NIL
    END) |> WHERE _ != NIL) |> DISTINCT _;
    MUTABLE seen: [Set]String = Set[];
    RETURN declarations.conformance_declarations |> SELECT { MUTABLE rtoc_mutable_block_param_14 = COPY _;
    {
    MUTABLE protocol_name = resolutionSession__conformance_base_name(rtoc_self_view, rtoc_mutable_block_param_14.protocol_type);
    MUTABLE owner_name = resolutionSession__conformance_base_name(rtoc_self_view, rtoc_mutable_block_param_14.owner_type);
    MUTABLE protocol: ?ProtocolDef = COPY rtoc_self_view.protocols[protocol_name];
    IF !(protocol) THEN
        resolutionSession__error_mut(rtoc_self_view, rtoc_mutable_block_param_14, ResolutionCodeOrMessage{ SymbolValue: :CONFORMANCE_UNKNOWN_PROTOCOL }, [], {:protocol: protocol_name});
    END
    MUTABLE local_owner = local_structs[owner_name];
    MUTABLE owner_params: ?[]GenericParamDecl = resolutionSession__conformance_owner_params(rtoc_self_view, owner_name, local_owner);
    IF !(owner_params) THEN
        resolutionSession__error_mut(rtoc_self_view, rtoc_mutable_block_param_14, ResolutionCodeOrMessage{ SymbolValue: :CONFORMANCE_UNKNOWN_OWNER }, [], {:owner: owner_name});
    END
    resolutionSession__infer_conformance_owner_application_mut(rtoc_self_view, &rtoc_mutable_block_param_14, owner_name, owner_params);
    IF !((local_owner OR local_protocols.contains?(protocol_name))) THEN
        resolutionSession__error_mut(rtoc_self_view, rtoc_mutable_block_param_14, ResolutionCodeOrMessage{ SymbolValue: :CONFORMANCE_ORPHAN }, [], {:protocol: protocol_name, :owner: owner_name});
    END
    MUTABLE key = "${protocol_name}:${owner_name}";
    IF seen.contains?(key) THEN
        resolutionSession__error_mut(rtoc_self_view, rtoc_mutable_block_param_14, ResolutionCodeOrMessage{ SymbolValue: :CONFORMANCE_DUPLICATE }, [], {:protocol: protocol_name, :owner: owner_name});
    END
    &seen.insert(key);
    resolutionSession__validate_conformance_arity_mut(rtoc_self_view, rtoc_mutable_block_param_14, UNWRAP (protocol), owner_name, owner_params);
    MUTABLE associated = resolutionSession__conformance_associated_types(rtoc_self_view, rtoc_mutable_block_param_14, UNWRAP (protocol));
    MUTABLE members = resolutionSession__collect_conformance_members_mut(rtoc_self_view, rtoc_mutable_block_param_14, UNWRAP (protocol), owner_name);
    TRY (resolutionSession__stamp_type_mut(rtoc_self_view, Locatable{ ConformanceDef: COPY rtoc_mutable_block_param_14 }, :Void));
    ConformanceResolution{ declaration: COPY rtoc_mutable_block_param_14, protocol: UNWRAP (COPY protocol), owner_name: COPY owner_name, owner_generic_params: COPY owner_params, associated_types: CAST(COPY associated AS {String@symbol}Type), members: members }
    } };
}
END
PRIVATE FN resolutionSession__prepare_conformance_members_mut(self: ResolutionSession, declarations: DeclarationIndex, resolutions: []ConformanceResolution, program: Program) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    FOR _ IN resolutions DO
    FOR _ IN _.members.values() DO
    MUTABLE source_name = _.name;
    MUTABLE inherited_names = (_.declaration.binders |> SELECT _.name) |> DISTINCT _;
    FOR _ IN _.generic_params DO
    IF inherited_names.contains?(_.name) THEN
        resolutionSession__error_mut(rtoc_self_view, (COPY _.token OR _), ResolutionCodeOrMessage{ SymbolValue: :IMPLEMENTATION_MEMBER_SHADOWS_OWNER }, [], {:owner: _.owner_name, :name: _.name, :member: source_name});
    END
    END
    _.generic_params = (_.declaration.binders + _.generic_params);
    _.type_params = _.generic_params |> SELECT _.name();
    _.implementation_owner = COPY _.owner_name;
    _.conformance_protocol = _.protocol.name;
    _.source_name = source_name;
    _[:name] = resolutionSession__conformance_function_name(rtoc_self_view, _.protocol.name, _.owner_name, source_name);
    IF _.is_method THEN
        resolutionSession__prepare_conformance_receiver_mut(rtoc_self_view, _, _);
    END
    resolutionSession__validate_member_type_parameter_references_mut(rtoc_self_view, _);
    &declarations.function_declarations.append(KEEP _);
    &declarations.body_statements.append(COPY _);
    &program.statements.append(COPY _);
    END
    END
}
END
PRIVATE FN resolutionSession__prepare_conformance_receiver_mut(self: ResolutionSession, member: FunctionDef, resolution: ConformanceResolution) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE receiver: ?Param = COPY member.params.first();
    IF !(((receiver != NIL) AND (receiver.name == "self"))) THEN
      resolutionSession__error_mut(rtoc_self_view, member, ResolutionCodeOrMessage{ SymbolValue: :IMPLEMENTATION_METHOD_NEEDS_SELF }, [], {:owner: resolution.owner_name, :name: member.source_name});
    END
    MUTABLE receiver_value: Param = receiver?;
    IF type__any?(receiver_value.type) THEN
      receiver_value.type = COPY resolution.declaration.owner_type;
    END
}
END
PRIVATE FN resolutionSession__conformance_base_name(self: ResolutionSession, type: Type) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF type__generic_instance?(type) THEN
      RETURN COPY CAST(type__generic_base(type) AS String);
    ELSE
      RETURN COPY CAST(type__resolved(type) AS String);
    END
}
END
PRIVATE FN resolutionSession__validate_conformance_arity_mut(self: ResolutionSession, declaration: ConformanceDef, protocol: ProtocolDef, owner_name: String, owner_params: []GenericParamDecl) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE protocol_args = TRY (type__generic_args(declaration.protocol_type));
    MUTABLE owner_args = TRY (type__generic_args(declaration.owner_type));
    IF (protocol_args.length() != protocol.associated_types.length()) THEN
      resolutionSession__error_mut(rtoc_self_view, declaration, ResolutionCodeOrMessage{ SymbolValue: :CONFORMANCE_PROTOCOL_ARITY }, [], {:protocol: protocol.name, :expected: protocol.associated_types.length(), :got: protocol_args.length()});
    END
    IF (owner_args.length() != owner_params.length()) THEN
      resolutionSession__error_mut(rtoc_self_view, declaration, ResolutionCodeOrMessage{ SymbolValue: :CONFORMANCE_OWNER_ARITY }, [], {:owner: owner_name, :expected: owner_params.length(), :got: owner_args.length()});
