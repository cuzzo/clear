    Locatable.ThrowNode AS cast_payload -> RETURN Node{ ThrowNode: COPY cast_payload };,
    Locatable.DieNode AS cast_payload -> RETURN Node{ DieNode: COPY cast_payload };,
    Locatable.Slice AS cast_payload -> RETURN Node{ Slice: COPY cast_payload };,
    Locatable.Require AS cast_payload -> RETURN Node{ Require: COPY cast_payload };,
    Locatable.WithBlock AS cast_payload -> RETURN Node{ WithBlock: COPY cast_payload };,
    Locatable.SyncPolicyDecl AS cast_payload -> RETURN Node{ SyncPolicyDecl: COPY cast_payload };,
    Locatable.SelectOp AS cast_payload -> RETURN Node{ SelectOp: COPY cast_payload };,
    Locatable.WhereOp AS cast_payload -> RETURN Node{ WhereOp: COPY cast_payload };,
    Locatable.IndexOp AS cast_payload -> RETURN Node{ IndexOp: COPY cast_payload };,
    Locatable.ReduceOp AS cast_payload -> RETURN Node{ ReduceOp: COPY cast_payload };,
    Locatable.OrderByOp AS cast_payload -> RETURN Node{ OrderByOp: COPY cast_payload };,
    Locatable.LimitOp AS cast_payload -> RETURN Node{ LimitOp: COPY cast_payload };,
    Locatable.UnnestOp AS cast_payload -> RETURN Node{ UnnestOp: COPY cast_payload };,
    Locatable.DistinctOp AS cast_payload -> RETURN Node{ DistinctOp: COPY cast_payload };,
    Locatable.EachOp AS cast_payload -> RETURN Node{ EachOp: COPY cast_payload };,
