    _.field_decls.keys() |> EACH {
    MUTABLE field: StructField@multiowned = (_.field_decls[_] OR_ELSE CAST(panic("missing hash key") AS StructField@multiowned));
    MUTABLE target: ?String@symbol = resolutionSession__inline_recursive_target(rtoc_self_view, structField__type(field), names);
    IF target EXISTS AS target_value THEN
        &edges.append(RecursiveFieldEdge{ owner: COPY symbol(_.name), target: COPY target_value, field_name: COPY _, type: COPY structField__type(field) });
    END
    };
    END
    MUTABLE rtoc_each_items_48 = resolutionSession__recursive_components(rtoc_self_view, names, edges);
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_48.length() DO
      MUTABLE internal = edges |> WHERE (rtoc_each_items_48[rtoc_idx]?.contains?(_.owner) AND rtoc_each_items_48[rtoc_idx]?.contains?(_.target));
      IF (internal.length() == 0) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE labels = (internal |> SELECT "${_.owner}.${_.field_name}").join(", ");
      MUTABLE fixes: []Fix@multiowned = resolutionSession__recursive_layout_fixes(rtoc_self_view, internal);
      MUTABLE owner_node = UNWRAP (structs |> FIND (symbol(_.name) == (UNWRAP (internal.first())).owner));
      IF (internal.length() == 1) THEN
          resolutionSession__fixable_mut(rtoc_self_view, owner_node, :type, fixes, NIL, :RECURSIVE_LAYOUT_REQUIRES_INDIRECT, :error, TRUE, {:edge: labels});
      ELSE
          resolutionSession__fixable_mut(rtoc_self_view, owner_node, :type, fixes, NIL, :RECURSIVE_LAYOUT_AMBIGUOUS, :error, TRUE, {:edges: labels});
      END
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PRIVATE FN resolutionSession__recursive_layout_fixes(self: ResolutionSession, edges: []RecursiveFieldEdge) RETURNS ![]Fix
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE source: ?String = resolutionSession__diagnostic_source_code(rtoc_self_view);
    IF source EXISTS AS source_value THEN
      MUTABLE choices = [["@node", "Store this edge in the compiler-managed graph slot map"], ["@boxed", "Make this a unique owned heap edge"], ["@multiowned", "Use local reference-counted shared identity"], ["@shared", "Use cross-execution atomic shared identity"], ["@link", "Make this a non-owning link to an independently owned node"]];
      MUTABLE fixes: []Fix = ( { MUTABLE rtoc_empty_list_49: []Fix = List[]; rtoc_empty_list_49 } );
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < edges.length() DO
      MUTABLE span: ?Span@multiowned = resolutionSession__recursive_field_suffix_span(rtoc_self_view, source_value, edges[rtoc_idx]?);
      IF !(span) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      FOR _ IN choices DO
      &fixes.append(TRY (fix__new(resolutionSession__fix_description(rtoc_self_view, :CHOOSE_RECURSIVE_LAYOUT, {:description: _._1, :edge: DiagnosticKwValue{ StringValue: COPY "${edges[rtoc_idx]?.owner}.${edges[rtoc_idx]?.field_name}" }, :capability: _._0}), [edit__new(CAST(span AS Span), _._0)], :interactive)));
      END
    rtoc_idx = rtoc_idx + 1;
      END
      RETURN fixes;
    ELSE
      RETURN CAST(( { MUTABLE rtoc_empty_list_50: []Fix = List[]; rtoc_empty_list_50 } ) AS []Fix);
    END
}
END
PRIVATE FN resolutionSession__recursive_field_suffix_span(self: ResolutionSession, source: String, edge: RecursiveFieldEdge) RETURNS ?Span
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE pattern = compilerRegexCompile("\\b${compilerRegexEscape(edge.field_name)}\\s*:\\s*\\??${compilerRegexEscape(CAST(edge.target AS String))}\\b");
    MUTABLE match = pattern.match(source);
    IF !(match) THEN
      RETURN NIL;
    END
    MUTABLE insert_offset = match.end(0);
    MUTABLE prefix = source.substr(0, (insert_offset - 0));
    MUTABLE line = (compilerCountOccurrences(prefix, "\n") + 1);
    MUTABLE last_newline = compilerLastIndex(prefix, "\n");
    MUTABLE col = (insert_offset - ((last_newline OR -1)));
    RETURN span__new(NIL, line, col, 0);
}
END
PRIVATE FN resolutionSession__inline_recursive_target(self: ResolutionSession, type: Type, names: [Set]String@symbol) RETURNS !?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE t = COPY type;
    IF (((type__indirect?(t) OR TRY (type__any_rc?(t))) OR TRY (type__node_reference?(t))) OR type__link?(t)) THEN
      RETURN NIL;
    END
    WHILE type__optional?(t) DO
      t = UNWRAP (TRY (type__wrapped_type(t)));
    END
    IF (((type__indirect?(t) OR TRY (type__any_rc?(t))) OR TRY (type__node_reference?(t))) OR type__link?(t)) THEN
      RETURN NIL;
    END
    IF (type__collection?(t) OR ((type__array?(t) AND !(type__fixed?(t))))) THEN
      RETURN NIL;
    END
    MUTABLE target = symbol(type__resolved(t));
    IF names.contains?(target) THEN
      RETURN target;
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN resolutionSession__visit_recursive_component(self: ResolutionSession, node: String@symbol, adjacency: {String@symbol}[]String@symbol, index_value: Int64, MUTABLE indices: {String@symbol}Int64, MUTABLE low: {String@symbol}Int64, MUTABLE stack: []String@symbol, MUTABLE on_stack: [Set]String@symbol, MUTABLE result: [][Set]String@symbol) RETURNS Int64
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    indices[node] = COPY index_value;
    low[node] = COPY index_value;
    MUTABLE next_index = (index_value + 1);
    &stack.append(COPY node);
    &on_stack.insert(COPY node);
    FOR _ IN UNWRAP (adjacency[node]) DO
    IF !(indices.contains?(_)) THEN
      next_index = resolutionSession__visit_recursive_component(rtoc_self_view, _, adjacency, next_index, &indices, &low, &stack, &on_stack, &result);
      low[node] = ([UNWRAP (low[node]), UNWRAP (low[_])]).min();
    ELSE
      IF on_stack.contains?(_) THEN
        low[node] = ([UNWRAP (low[node]), UNWRAP (indices[_])]).min();
      END
    END
    END
    IF !((low[node] == indices[node])) THEN
      RETURN next_index;
    END
    MUTABLE component: [Set]String@symbol = Set[];
    WHILE TRUE DO
      MUTABLE member = symbol(UNWRAP (&stack.pop()));
      &on_stack.delete(member);
      &component.insert(member);
      IF (member == node) THEN
        BREAK;
      END
    END
    MUTABLE self_loop = (UNWRAP (adjacency[node])).contains?(node);
    IF ((component.length() > 1) OR self_loop) THEN
      &result.append(component);
    END
    RETURN next_index;
}
END
PRIVATE FN resolutionSession__recursive_components(self: ResolutionSession, names: [Set]String@symbol, edges: []RecursiveFieldEdge) RETURNS ![][Set]String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE adjacency: {String@symbol}[]String@symbol = {};
    FOR _ IN edges DO
    IF adjacency[_.owner] == NIL THEN
      adjacency[_.owner] = List[];
    END
    IF adjacency[_.owner] EXISTS AS rtoc_map_slot_51 THEN
      &rtoc_map_slot_51.append(COPY _.target);
    END
    END
    MUTABLE index: Int64 = 0;
    MUTABLE indices: {String@symbol}Int64 = {};
    MUTABLE low: {String@symbol}Int64 = {};
    MUTABLE stack: []String@symbol = ( { MUTABLE rtoc_empty_list_52: []String@symbol = List[]; rtoc_empty_list_52 } );
    MUTABLE on_stack: [Set]String@symbol = Set[];
    MUTABLE result: [][Set]String@symbol = ( { MUTABLE rtoc_empty_list_53: [][Set]String@symbol = List[]; rtoc_empty_list_53 } );
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < names.length() DO
      IF indices.contains?(names[rtoc_idx]) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      index = resolutionSession__visit_recursive_component(rtoc_self_view, names[rtoc_idx], adjacency, index, &indices, &low, &stack, &on_stack, &result);
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN result;
}
END
PRIVATE FN resolutionSession__register_type_declaration(self: ResolutionSession, node: TypeDeclaration) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A StructDef AS struct_def THEN
      resolutionSession__register_struct_declaration(rtoc_self_view, struct_def);
    ELSE_IF node IS_A ExternStructDecl AS extern_struct_decl THEN
      resolutionSession__register_extern_struct_declaration(rtoc_self_view, extern_struct_decl);
    ELSE_IF node IS_A EnumDef AS enum_def THEN
      resolutionSession__register_enum_declaration(rtoc_self_view, enum_def);
    ELSE_IF node IS_A UnionDef AS union_def THEN
      resolutionSession__register_union_declaration(rtoc_self_view, union_def);
    END
}
END
PRIVATE FN resolutionSession__register_extern_struct_declaration(self: ResolutionSession, MUTABLE node: ExternStructDecl) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE schema =   IF ((node.close_method != NIL) AND (node.from_module != NIL)) THEN
      {
    MUTABLE rtoc_value_block_marker = 0;
      IF (node.extern_source.abi() == :c) THEN
      close_plan = resourceClosePlan__c_function(UNWRAP (node.close_method));
    ELSE
      close_plan = resourceClosePlan__method(UNWRAP (node.close_method));
    END
    TRY (resourceSchema__new(close_plan, {}, node.field_decls, resolutionSession__type_params(rtoc_self_view, node.type_params), node.from_module, node.as_type, :package, {}))
    }
    ELSE
      TRY (structSchema__new(node.field_decls, resolutionSession__type_params(rtoc_self_view, node.type_params), ( { MUTABLE rtoc_empty_list_55: []GenericParamDecl = List[]; rtoc_empty_list_55 } ), {}, {}, :package, node.from_module, node.as_type))
    END;
    MUTABLE existing: ?ScopeTypeEntry = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_56 = resolutionSession__current_scope(rtoc_self_view);
    scope__resolve_type_entry(rtoc_local_receiver_56, type__to_sym(node.name)) };
    IF ((existing != NIL) AND resolutionSession__equivalent_extern_type_schema?(rtoc_self_view, existing.schema, schema)) THEN
      TRY (resolutionSession__stamp_type_mut(rtoc_self_view, Locatable{ ExternStructDecl: COPY node }, :Void));
      RETURN;
    END
    resolutionSession__declare_type_schema_mut(rtoc_self_view, TypeDeclaration{ ExternStructDecl: COPY node }, type__to_sym(node.name), schema);
    TRY (resolutionSession__stamp_type_mut(rtoc_self_view, Locatable{ ExternStructDecl: COPY node }, :Void));
}
END
PRIVATE FN resolutionSession__register_struct_declaration(self: ResolutionSession, MUTABLE node: StructDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node.type_params |> ANY _ THEN
      resolutionSession__validate_type_param_list_mut(rtoc_self_view, Node{ StructDef: COPY node }, node.type_params, "struct");
    END
    resolutionSession__validate_generic_bounds_mut(rtoc_self_view, node.generic_params);
    FOR _ IN node.field_decls.values() DO
    MUTABLE rtoc_mutable_block_param_57 = COPY _;
    resolutionSession__resolve_declaration_projections_mut(rtoc_self_view, node, &rtoc_mutable_block_param_57.type, node.generic_params);
    END
    FOR _ IN node.field_decls.values() DO
    IF TRY (type__preallocation_hint?(_.type)) THEN
      resolutionSession__error_mut(rtoc_self_view, node, ResolutionCodeOrMessage{ SymbolValue: :COLLECTION_HINT_VALUE_ONLY });
    END
    END
    MUTABLE tp_names = resolutionSession__type_params(rtoc_self_view, node.type_params);
    node.field_decls.keys() |> EACH {
    MUTABLE field: StructField@multiowned = (node.field_decls[_] OR_ELSE CAST(panic("missing hash key") AS StructField@multiowned));
    MUTABLE ft = structField__type(field);
    IF !((TRUE AND tp_names.contains?(type__resolved(ft)))) THEN
        CONTINUE;
    END
    IF !((type__multiowned?(ft) OR type__shared?(ft))) THEN
        CONTINUE;
    END
    resolutionSession__error_mut(rtoc_self_view, node, ResolutionCodeOrMessage{ SymbolValue: :GENERIC_IDENTITY_FIELD_UNSUPPORTED }, [], {:struct: node.name, :field: _, :param: CAST(type__resolved(ft) AS String)});
    };
    resolutionSession__stamp_field_defaults_mut(rtoc_self_view, node.field_decls);
    resolutionSession__declare_type_schema_mut(rtoc_self_view, TypeDeclaration{ StructDef: COPY node }, symbol(node.name), ScopeScopeTypeSchema{ StructSchemaMultiowned: COPY TRY (structSchema__new(node.field_decls, resolutionSession__type_params(rtoc_self_view, node.type_params), node.generic_params, {}, {}, (node.visibility OR :package))) });
    TRY (resolutionSession__stamp_type_mut(rtoc_self_view, &node, :Void));
}
END
PRIVATE FN resolutionSession__validate_generic_bounds_mut(self: ResolutionSession, params: []GenericParamDecl) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    FOR _ IN params DO
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < _.bounds.length() DO
      IF resolutionSession__protocol_declared?(rtoc_self_view, CAST((type__resolved((_.bounds[rtoc_idx]?.type))) AS String)) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      resolutionSession__error_mut(rtoc_self_view, (IF COPY _.bounds[rtoc_idx]?.token != NIL THEN COPY _.bounds[rtoc_idx]?.token ELSE COPY _.token END), ResolutionCodeOrMessage{ SymbolValue: :GENERIC_UNKNOWN_PROTOCOL }, [], {:protocol: TRY (type__surface_name(castTypeToTypeTypeInput(_.bounds[rtoc_idx]?.type)))});
    rtoc_idx = rtoc_idx + 1;
    END
    END
}
END
PRIVATE FN resolutionSession__resolve_declaration_projections_mut(self: ResolutionSession, node: Locatable, MUTABLE type: Type, parameters: []GenericParamDecl) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE result = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_58 = protocolProjectionResolver__new(rtoc_self_view.protocols);
    TRY (protocolProjectionResolver__resolve(rtoc_local_receiver_58, type.shape.expression, parameters)) };
    MUTABLE issue: ?ProtocolProjectionIssue = COPY result.issues.first();
    IF issue EXISTS AS issue_value THEN
      resolutionSession__emit_protocol_projection_issue_mut(rtoc_self_view, castLocatableToNode(node), issue_value);
    END
    MUTABLE rtoc_mutable_alias_arg_59 = COPY TRY (typeShape__with_expression(type.shape, result.expression));
    type__replace_shape_mut(&type, rtoc_mutable_alias_arg_59);
}
END
PRIVATE FN resolutionSession__register_enum_declaration(self: ResolutionSession, MUTABLE node: EnumDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    resolutionSession__declare_type_schema_mut(rtoc_self_view, TypeDeclaration{ EnumDef: COPY node }, type__to_sym(node.name), ScopeScopeTypeSchema{ EnumSchemaMultiowned: COPY TRY (enumSchema__new(node.variants, (node.visibility OR :package))) });
    TRY (resolutionSession__stamp_type_mut(rtoc_self_view, &node, :Void));
}
END
PRIVATE FN resolutionSession__register_union_declaration(self: ResolutionSession, MUTABLE node: UnionDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node.type_params.any?() THEN
      resolutionSession__validate_type_param_list_mut(rtoc_self_view, Node{ UnionDef: COPY node }, node.type_params, "union");
    END
    IF (node.type_params.any?() AND (node.variants |> ANY schemas__inline_struct?(_._1))) THEN
      resolutionSession__error_mut(rtoc_self_view, node, ResolutionCodeOrMessage{ SymbolValue: :UNION_INLINE_IN_GENERIC });
    END
    resolutionSession__register_inline_struct_variants_mut(rtoc_self_view, node);
    resolutionSession__declare_type_schema_mut(rtoc_self_view, TypeDeclaration{ UnionDef: COPY node }, type__to_sym(node.name), ScopeScopeTypeSchema{ UnionSchemaMultiowned: COPY TRY (unionSchema__new(node.variants, resolutionSession__type_params(rtoc_self_view, node.type_params), (node.visibility OR :package))) });
    TRY (resolutionSession__stamp_type_mut(rtoc_self_view, Locatable{ UnionDef: COPY node }, :Void));
}
END
PRIVATE FN resolutionSession__stamp_field_defaults_mut(self: ResolutionSession, fields: {String}StructField) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    FOR _ IN fields.values() DO
    MUTABLE default = KEEP _.default;
    IF !(default) THEN
        CONTINUE;
    END
    TRY (resolutionSession__stamp_type_mut(rtoc_self_view, &default, _.type));
    END
}
END
PRIVATE FN resolutionSession__register_inline_struct_variants_mut(self: ResolutionSession, node: UnionDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    node.variants.keys() |> EACH {
    MUTABLE variant_data: Any = (node.variants[_] OR_ELSE panic("missing hash key"));
    IF !(schemas__inline_struct?(variant_data)) THEN
      CONTINUE;
    END
    MUTABLE synthetic_name = symbol("${node.name}_${_}");
    resolutionSession__declare_type_schema_mut(rtoc_self_view, TypeDeclaration{ UnionDef: COPY node }, synthetic_name, ScopeScopeTypeSchema{ StructSchemaMultiowned: COPY TRY (structSchema__new(variant_data.fields().transform_values(%(type) -> StructField{ type: type, default: NIL, borrowed: FALSE }), ( { MUTABLE rtoc_empty_list_60: []String@symbol = List[]; rtoc_empty_list_60 } ), ( { MUTABLE rtoc_empty_list_61: []GenericParamDecl = List[]; rtoc_empty_list_61 } ), {}, {})) });
    MUTABLE entries = resolutionSession__inline_struct_deinit_entries(rtoc_self_view, variant_data);
    IF entries |> ANY _ THEN
        TRY (inlineStructVariant__set_deinit_entries(&variant_data, entries));
    END
    };
}
END
PRIVATE FN resolutionSession__declare_type_schema_mut(self: ResolutionSession, node: TypeDeclaration, name: String@symbol, schema: ScopeScopeTypeSchema) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_62 = resolutionSession__current_scope(rtoc_self_view);
    scope__resolve_type_entry(rtoc_local_receiver_62, name) } THEN
      resolutionSession__error_mut(rtoc_self_view, node, ResolutionCodeOrMessage{ SymbolValue: :DUPLICATE_DECLARATION }, [], {:label: "type", :name: name});
    END
    resolutionSession__current_scope(rtoc_self_view).declare_type(name, schema);
}
END
PRIVATE FN resolutionSession__equivalent_extern_type_schema?(self: ResolutionSession, existing: ScopeScopeTypeSchema, incoming: ScopeScopeTypeSchema) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((existing.class() == incoming.class())) THEN
      RETURN FALSE;
    END
    IF !((resolutionSession__extern_type_schema?(rtoc_self_view, existing) AND resolutionSession__extern_type_schema?(rtoc_self_view, incoming))) THEN
      RETURN FALSE;
    END
    IF !((existing.extern_module() == incoming.extern_module())) THEN
      RETURN FALSE;
    END
    IF !((existing.as_type() == incoming.as_type())) THEN
      RETURN FALSE;
    END
    IF !((existing.type_params() == incoming.type_params())) THEN
      RETURN FALSE;
    END
    IF !(resolutionSession__equivalent_struct_fields?(rtoc_self_view, existing.fields(), incoming.fields())) THEN
      RETURN FALSE;
    END
    IF existing IS_A ResourceSchema AS resource_schema THEN
    IF incoming IS_A ResourceSchema AS resource_schema THEN
      RETURN (resource_schema.close_plan == resource_schema.close_plan);
    END
    END
    RETURN TRUE;
}
END
PRIVATE FN resolutionSession__extern_type_schema?(self: ResolutionSession, schema: ScopeScopeTypeSchema) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (((schema IS_A StructSchema OR schema IS_A ResourceSchema)) AND !((schema.extern_module() == NIL)));
}
END
PRIVATE FN resolutionSession__equivalent_struct_fields?(self: ResolutionSession, left: {String}StructField, right: {String}StructField) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(((left.keys() |> ORDER_BY _) == (right.keys() |> ORDER_BY _))) THEN
      RETURN FALSE;
    END
    RETURN left |> ALL {
    MUTABLE right_field: ?StructField = COPY right[_._0];
    ((((right_field != NIL) AND (CAST(structField__type(_._1) AS String) == CAST(right_field.type AS String))) AND (structField__borrowed(_._1) == right_field.borrowed)) AND ((structField__default(_._1) == NIL) == ((KEEP right_field.default) == NIL)))
    };
}
END
PRIVATE FN resolutionSession__inline_struct_deinit_entries(self: ResolutionSession, variant_data: InlineStructVariant) RETURNS ![]InlineStructDeinitEntry
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN variant_data.fields.each_with_object(List[], %(tuple_param_0, entries: Tuple<String@symbol,TypeTypeInput>) -> {
    MUTABLE field_name = tuple_param_0._0;
    MUTABLE field_type = tuple_param_0._1;
    MUTABLE field_type_info = field_type;
    MUTABLE field = COPY CAST(field_name AS String);
    IF field_type_info.indirect?() THEN
      RETURN &entries.append(inlineStructDeinitEntry__indirect(field, TRY (type__zig_type((TRY (type__new(field_type_info.resolved())))))));
    ELSE_IF (TRY (type__string?(field_type_info)) OR type__collection?(field_type_info)) THEN
      RETURN &entries.append(inlineStructDeinitEntry__uniform(field, TRY (type__zig_type(field_type_info))));
    ELSE_IF (type__array?(field_type_info) AND !(TRY (type__string?(field_type_info)))) THEN
      MUTABLE elem_zig_type = TRY (type__zig_type((TRY (type__new(field_type_info.element_type())))));
      RETURN &entries.append(inlineStructDeinitEntry__array(field, elem_zig_type));
    END
    NIL
    });
}
END
PRIVATE FN resolutionSession__type_params(self: ResolutionSession, params: []ParamsItem) RETURNS ![]String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN params |> SELECT symbol(_);
}
END
PUB FN resolutionSession__new(importer: ?ModuleImporter, source_dir: String, source_code: ?String, root_scope: ?Scope = NIL, function_registry: ?FunctionRegistry = NIL, install_builtins: Bool = TRUE) RETURNS ResolutionSession@multiowned ->
  MUTABLE self = ResolutionSession{ function_registry: (COPY function_registry OR_ELSE FunctionRegistry{ nodes: {}, synthetic_definitions: List[], body_summaries: {} }), importer: COPY importer, local_type_declaration_names: Set[], protocols: {}, root_scope: (root_scope OR_ELSE scope__new()), scope_stack: [root_scope], source_code: COPY source_code, source_dir: COPY source_dir };
  resolutionSession__initialize(&self, importer, source_dir, source_code, root_scope, function_registry, install_builtins);
  RETURN self @multiowned;
END
PUB FN resolutionPhase__run(program: Program, importer: ?ModuleImporter, source_dir: String, source_code: ?String) RETURNS !ResolutionFacts@multiowned ->
  RETURN { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_63 = resolutionSession__new(importer, source_dir, source_code);
  TRY (resolutionSession__resolve_mut(&rtoc_mutable_receiver_63, program)) };
END
# End Ruby module Annotator::Phases
# End Ruby module Annotator
FN castCodeOrMessageToOptionalString(value: ResolutionCodeOrMessage) RETURNS ?String ->
  IF value IS_A String AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN NIL;
END
FN castLocatableToNode(value: Locatable) RETURNS Node ->
  PARTIAL MATCH value START
    Locatable.MIRProgram AS cast_payload -> RETURN Node{ MIRProgram: COPY cast_payload };,
    Locatable.RequireNode AS cast_payload -> RETURN Node{ RequireNode: COPY cast_payload };,
    Locatable.ProtocolRequirement AS cast_payload -> RETURN Node{ ProtocolRequirement: COPY cast_payload };,
