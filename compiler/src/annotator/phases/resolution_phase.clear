END
PRIVATE FN resolutionSession__stamp_field_defaults_mut(MUTABLE self: ResolutionSession, fields: {String}StructField) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR _ IN fields.values() DO
    MUTABLE default: ?Locatable@boxed = COPY _.default;
    IF !(default) THEN
        CONTINUE;
    END
