  PARTIAL MATCH value START
    Node.RequireNode AS item -> RETURN ResolutionSessionReturnValue{ RequireNode: COPY item };,
    Node.ProtocolRequirement AS item -> RETURN ResolutionSessionReturnValue{ ProtocolRequirement: COPY item };,
    Node.ProtocolDef AS item -> RETURN ResolutionSessionReturnValue{ ProtocolDef: COPY item };,
    Node.FunctionDef AS item -> RETURN ResolutionSessionReturnValue{ FunctionDef: COPY item };,
    Node.ImplementationDef AS item -> RETURN ResolutionSessionReturnValue{ ImplementationDef: COPY item };,
