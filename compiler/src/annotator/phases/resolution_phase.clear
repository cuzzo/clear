    ResolutionSessionReturnValue.BenchmarkStmtMultiowned AS item -> RETURN Locatable{ BenchmarkStmt: COPY item };,
    ResolutionSessionReturnValue.SmashStmtMultiowned AS item -> RETURN Locatable{ SmashStmt: COPY item };,
