    Node.IfStatement AS item -> RETURN ResolutionSessionReturnValue{ IfStatement: COPY item };,
    Node.IfBind AS item -> RETURN ResolutionSessionReturnValue{ IfBind: COPY item };,
    Node.WhileLoop AS item -> RETURN ResolutionSessionReturnValue{ WhileLoop: COPY item };,
    Node.WhileBindLoop AS item -> RETURN ResolutionSessionReturnValue{ WhileBindLoop: COPY item };,
    Node.BreakNode AS item -> RETURN ResolutionSessionReturnValue{ BreakNode: COPY item };,
