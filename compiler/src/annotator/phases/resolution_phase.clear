    IF reason EXISTS AS reason_value THEN
      TRY (resolutionSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ ExternFnDecl: COPY node } }, ResolutionCodeOrMessage{ SymbolValue: :C_EXTERN_UNSUPPORTED_TYPE }, [], CAST({:position: position, :type: TRY (type__surface_name(castTypeToTypeTypeInput__resolution_phase(type))), :reason: reason_value} AS {String@symbol}Any)));
    ELSE
      RETURN;
    END
}
