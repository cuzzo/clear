    ResolutionSessionReturnValue.ProfileStmt AS item -> RETURN Locatable{ ProfileStmt: COPY item };,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END

PUB FN castMapStructFieldToMapSchemasStructSchemaFieldInput(source: {String}StructField) RETURNS {String}SchemasStructSchemaFieldInput ->
  MUTABLE out: {String}SchemasStructSchemaFieldInput = {};
  FOR rtoc_cast_key IN source.keys() DO
    out[rtoc_cast_key] = SchemasStructSchemaFieldInput{ StructField: COPY UNWRAP (source[rtoc_cast_key]) };
  END
  RETURN out;
END

# Ruby hands the node straight to a callee that wants one specific shape.
# The union either holds that variant or it does not.
PUB FN castDiagnosticKwValueToString(value: DiagnosticKwValue) RETURNS ?String EFFECTS REENTRANT ->
  IF value IS_A String AS item THEN
    RETURN item;
  END
  RETURN NIL;
END

FN castDiagnosticKwValueToAnyMultiowned__resolution_phase(value: DiagnosticKwValue) RETURNS Any@multiowned ->
  IF value IS_A Any@multiowned AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to Any@multiowned");
END
