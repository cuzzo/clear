PRIVATE FN resolutionSession__visit_RequireNode(MUTABLE self: ResolutionSession, MUTABLE node: RequireNode) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE importer: ModuleImporter@multiowned = UNWRAP (resolutionSession__active_importer(rtoc_self_view));
    IF !(importer) THEN
      TRY (resolutionSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ RequireNode: COPY node } }, ResolutionCodeOrMessage{ SymbolValue: :REQUIRE_NEEDS_IMPORTER }));
    END
    MUTABLE mod_branch_value: ?CompiledModule = NIL;
    IF (node.kind == :package) THEN
      mod_branch_value = TRY ( UNWRAP (moduleImporter__compile_package( &importer, node.path, resolutionSession__import_source_dir( rtoc_self_view))));
    ELSE
      mod_branch_value = TRY (moduleImporter__compile_file(&importer, node.path, resolutionSession__import_source_dir(rtoc_self_view)));
    END
    MUTABLE mod: ?CompiledModule = mod_branch_value;
    MUTABLE mod_value: CompiledModule = mod?;
    TRY (resolutionSession__stamp_type_mut(rtoc_self_view, Locatable{ RequireNode: COPY node }, :Void));
    MUTABLE same_dir = (((node.kind != :package)) AND ((mod_value.source_dir == resolutionSession__import_source_dir(rtoc_self_view))));FOR rtoc_each_1 IN ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_21 = CAST(mod_value.global_scope AS Scope);
    TRY (scope__visible_entries(rtoc_local_receiver_21)) }).keys() DO
    MUTABLE entry = (({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_21 = CAST(mod_value.global_scope AS Scope);
    TRY (scope__visible_entries(rtoc_local_receiver_21)) })[rtoc_each_1] OR_ELSE panic("missing hash key"));
    MUTABLE sig: ?FunctionSignature@multiowned = symbolEntry__fn_signature(entry);
    IF !(sig) THEN
        CONTINUE;
    END
    IF functionSignature__module_alias(sig) THEN
        CONTINUE;
    END
    IF (rtoc_each_1 == rtoc_each_1) THEN
        CONTINUE;
    END
    MUTABLE vis = (functionSignature__visibility(sig) OR_ELSE :package);
    MUTABLE importable = (((vis == :pub)) OR (((vis == :package) AND same_dir)));
    IF !(importable) THEN
        CONTINUE;
    END
    MUTABLE imported_sig = TRY (functionSignature__import_copy(sig, node.namespace));
    MUTABLE rtoc_mutable_receiver_22 = TRY (resolutionSession__current_scope(rtoc_self_view));
    TRY (scope__declare(&rtoc_mutable_receiver_22, rtoc_each_1, NIL, SymbolEntryTypeInput{ FunctionSignatureMultiowned: COPY imported_sig }, ScopeMutabilityInput{ BoolValue: FALSE }, FALSE, NIL, :static));
        END
    FOR rtoc_each_item_1060 IN mod_value.global_scope.types.keys() DO
    MUTABLE type_entry = (mod_value.global_scope.types[rtoc_each_item_1060] OR_ELSE panic("missing hash key"));
    MUTABLE schema = type_entry.schema;
    MUTABLE vis = (schemaValue__visibility(schema) OR_ELSE :package);
    IF (vis == :private) THEN
        CONTINUE;
    END
    IF !((((vis == :pub)) OR (((vis == :package) AND same_dir)))) THEN
        CONTINUE;
    END
    MUTABLE imported_schema: ?SchemaValue = TRY (resolutionSession__clone_imported_schema(rtoc_self_view, schema));
    scope__declare_type((TRY (resolutionSession__current_scope(rtoc_self_view))), symbol(rtoc_each_item_1060), UNWRAP (imported_schema));
    IF UNWRAP (imported_schema) IS_A UnionSchema AS union_schema THEN
        TRY (resolutionSession__import_inline_struct_variants_mut(&rtoc_self_view, symbol(rtoc_each_item_1060), union_schema));
    END
    END
    NIL;
}
END
PRIVATE FN resolutionSession__import_inline_struct_variants_mut(MUTABLE self: ResolutionSession, union_name: String@symbol, schema: UnionSchema) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR variant_name IN schema.variants.keys() DO
      IF schema.variants[variant_name] EXISTS AS variant_value THEN
        IF variant_value IS_A InlineStructVariant AS inline_variant THEN
          MUTABLE synthetic_name = symbol("${union_name}_${variant_name}");
          MUTABLE fields: {String@symbol}SchemasStructSchemaFieldInput = {};
          FOR field_name IN inline_variant.fields.keys() DO
            IF inline_variant.fields[field_name] EXISTS AS field_type THEN
              fields[field_name] = SchemasStructSchemaFieldInput{ StructFieldMultiowned: COPY StructField{ type: TRY (type__new(castTypeTypeInputToTypeConstructionInput__resolution_phase(field_type))), default: NIL, borrowed: FALSE } };
            END
