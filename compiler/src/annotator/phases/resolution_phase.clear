FN castOptionalSchemasUnionSchemaVariantValueToOptionalSchemasUnionSchemaVariantInput(value: ?SchemasUnionSchemaVariantValue) RETURNS ?SchemasUnionSchemaVariantInput ->
  IF value == NIL THEN
    panic("Invalid cast to ?SchemasUnionSchemaVariantInput");
  END
  PARTIAL MATCH value? START
    SchemasUnionSchemaVariantValue.FunctionType AS cast_payload -> RETURN SchemasUnionSchemaVariantInput{ FunctionType: COPY cast_payload };,
    SchemasUnionSchemaVariantValue.StringValue AS cast_payload -> RETURN SchemasUnionSchemaVariantInput{ StringValue: COPY cast_payload };,
    SchemasUnionSchemaVariantValue.SymbolValue AS cast_payload -> RETURN SchemasUnionSchemaVariantInput{ SymbolValue: COPY cast_payload };,
    SchemasUnionSchemaVariantValue.Type AS cast_payload -> RETURN SchemasUnionSchemaVariantInput{ Type: COPY cast_payload };,
    SchemasUnionSchemaVariantValue.InlineStructVariantMultiowned AS cast_payload -> RETURN SchemasUnionSchemaVariantInput{ InlineStructVariantMultiowned: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to ?SchemasUnionSchemaVariantInput");
  END
  panic("Invalid cast to ?SchemasUnionSchemaVariantInput");
END
FN castScopeScopeTypeSchemaToUnionSchemaMultiowned(value: ScopeScopeTypeSchema) RETURNS UnionSchema@multiowned ->
  IF value IS_A UnionSchema@multiowned AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to UnionSchema@multiowned");
END
FN castTypeDeclarationToProtocolDef(value: TypeDeclaration) RETURNS ProtocolDef ->
  IF value IS_A ProtocolDef AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to ProtocolDef");
END
