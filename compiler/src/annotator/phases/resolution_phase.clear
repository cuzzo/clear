    Type.Type AS cast_payload -> RETURN SchemasUnionSchemaVariantValue{ Type: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to ?SchemasUnionSchemaVariantValue");
  END
  panic("Invalid cast to ?SchemasUnionSchemaVariantValue");
END
