PUB FN resolutionSession__validate_union_methods_mut(MUTABLE self: ResolutionSession, node: UnionDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE requirements: []UnionMethodRequirement = COPY CAST(node.methods AS []UnionMethodRequirement);
    MUTABLE seen: [Set]String = Set[];
    FOR _ IN requirements DO
    IF seen.contains?(_.name) THEN
        TRY (resolutionSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ TokenValue: COPY _.token }, ResolutionCodeOrMessage{ SymbolValue: :UNION_METHOD_DUPLICATE }, [], CAST({:union: node.name, :method: _.name} AS {String@symbol}Any)));
    END
    &seen.insert(COPY _.name);
    END
    FOR _ IN requirements DO
    TRY (resolutionSession__validate_union_method_mut(&rtoc_self_view, node, _));
    END
}
END
PRIVATE FN resolutionSession__resolved_function_names(self: ResolutionSession) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE names: []String = List[];
    MUTABLE rtoc_entries = TRY (scope__visible_entries(rtoc_self_view.root_scope));
    FOR rtoc_name IN rtoc_entries.keys() DO
      MUTABLE entry: SymbolEntry@multiowned = KEEP UNWRAP (rtoc_entries[rtoc_name]);
      IF symbolEntry__fn_signature(entry) THEN
        &names.append(COPY rtoc_name);
      END
    END
    RETURN names;
}
END
PRIVATE FN resolutionSession__validate_union_method_mut(MUTABLE self: ResolutionSession, node: UnionDef, requirement: UnionMethodRequirement) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE entry: ?SymbolEntry@multiowned = NIL;
    IF TRY (resolutionSession__lookup_scope_for(&rtoc_self_view, requirement.name)) != NIL THEN
      entry = COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_2 = (UNWRAP (TRY (resolutionSession__lookup_scope_for(&rtoc_self_view, requirement.name))));
    scope__resolve_entry(rtoc_local_receiver_2, requirement.name) };
    END
    IF entry EXISTS AS entry_value THEN
      MUTABLE signature: ?FunctionSignature@multiowned = functionSignature__unwrap(X{ Type: COPY symbolEntry__type(entry_value) });
      IF signature EXISTS AS signature_value THEN
        TRY (resolutionSession__validate_union_method_visibility_mut(&rtoc_self_view, node, requirement, signature_value));
        IF (requirement.params.length() != (TRY (functionSignature__params(signature_value))).length()) THEN
          TRY (resolutionSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ TokenValue: COPY requirement.token }, ResolutionCodeOrMessage{ SymbolValue: :UNION_METHOD_WRONG_ARITY }, [], CAST({:union: node.name, :method: requirement.name, :expected_arity: requirement.params.length(), :fn: requirement.name, :got_arity: (TRY (functionSignature__params(signature_value))).length()} AS {String@symbol}Any)));
        END
        MUTABLE rtoc_idx = 0;
        WHILE rtoc_idx < requirement.params.length() DO
      MUTABLE actual: ?Param = COPY (TRY (functionSignature__params(signature_value)))[rtoc_idx];
      IF !(actual) THEN
              rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE expected_name = type__resolved((TRY (resolutionSession__to_type( rtoc_self_view, castTypeToTypeTypeInput__resolution_phase( UNWRAP (requirement.params[rtoc_idx]?.type))))));
      MUTABLE actual_name = type__resolved((TRY (resolutionSession__to_type(rtoc_self_view, castTypeToTypeTypeInput__resolution_phase(actual.type)))));
      IF (((expected_name == actual_name) OR (expected_name == :Any)) OR (actual_name == :Any)) THEN
              rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      TRY (resolutionSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ TokenValue: COPY requirement.token }, ResolutionCodeOrMessage{ SymbolValue: :UNION_METHOD_PARAM_TYPE }, [], CAST({:union: node.name, :method: requirement.name, :index: (rtoc_idx + 1), :expected: expected_name, :fn: requirement.name, :got: actual_name} AS {String@symbol}Any)));
    rtoc_idx = rtoc_idx + 1;
        END
        MUTABLE return_type: ?Type = COPY requirement.return_type;
        IF return_type EXISTS AS return_type_value THEN
          MUTABLE expected_return = type__resolved((TRY (resolutionSession__to_type(rtoc_self_view, castTypeToTypeTypeInput__resolution_phase(return_type_value)))));
          MUTABLE actual_return = type__resolved(functionSignature__return_type(signature_value));
          IF (((expected_return == actual_return) OR (expected_return == :Any)) OR (actual_return == :Any)) THEN
            RETURN;
          END
          TRY (resolutionSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ TokenValue: COPY requirement.token }, ResolutionCodeOrMessage{ SymbolValue: :UNION_METHOD_RETURN_TYPE }, [], CAST({:union: node.name, :method: requirement.name, :expected: expected_return, :fn: requirement.name, :got: actual_return} AS {String@symbol}Any)));
        ELSE
          RETURN;
        END
      ELSE
        TRY (resolutionSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ TokenValue: COPY requirement.token }, ResolutionCodeOrMessage{ SymbolValue: :UNION_METHOD_MISSING }, [], CAST({:union: node.name, :method: requirement.name, :fn: requirement.name} AS {String@symbol}Any)));
        RETURN;
      END
    ELSE
      IF requirement.has_default_body THEN
        resolutionSession__queue_synthetic_function_mut(&rtoc_self_view, FunctionDef{ token: CAST(COPY requirement.token AS Token), name: COPY requirement.name, params: COPY ( { MUTABLE rtoc_map_results = CAST([] AS []Param); requirement.params |> EACH { &rtoc_map_results.append(COPY unionMethodParamRequirement__to_param(_)); }; rtoc_map_results } ), captures: List[], return_type: COPY requirement.return_type, return_lifetime: NIL, body: COPY requirement.body, catch_clauses: List[], default_catch: NIL, visibility: COPY requirement.visibility, deferred_drops: NIL, uses_frame: NIL, explicit_return_type: FALSE, type_params: List[], tail_call: FALSE, requires: NIL, arrow_token: CAST(COPY requirement.token AS Token), name_token: NIL, effects_decl: NIL, effects_span: NIL, max_depth_n: NIL, tight_reentrance: FALSE, requires_clauses: NIL, return_type_token: NIL, pre_clauses: NIL, post_clauses: NIL, is_method: FALSE, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, effect_set: NIL, inferred_effects: NIL, reentrance_kind: NIL, thunk_plan: NIL, mutual_thunk_plan: NIL, needs_rt: NIL, fn_value_ref: NIL, alloc_fault: NIL, error_fallible: NIL, uses_heap: NIL, uses_alloc: NIL, uses_rt: NIL, effects: NIL, snapshot_types: NIL, stack_tier: NIL, stack_vars_bytes: NIL, moved_guard_info: NIL, cleanup_bindings: NIL, heap_carry_return: NIL, heap_carry_return_vars: NIL, fsm_eligible: NIL, fsm_ineligible_reason: NIL, fsm_suspend_points: NIL, conformance_protocol: NIL, generic_params: List[], implementation_owner: NIL, semantic_with_blocks: List[], source_name: "" });
        RETURN;
      END
      TRY (resolutionSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ TokenValue: COPY requirement.token }, ResolutionCodeOrMessage{ SymbolValue: :UNION_METHOD_MISSING }, [], CAST({:union: node.name, :method: requirement.name, :fn: requirement.name} AS {String@symbol}Any)));
      RETURN;
    END
}
END
PRIVATE FN resolutionSession__validate_union_method_visibility_mut(MUTABLE self: ResolutionSession, node: UnionDef, requirement: UnionMethodRequirement, signature: FunctionSignature) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (requirement.visibility == :package) THEN
      RETURN;
    END
    MUTABLE actual = (functionSignature__visibility(signature) OR_ELSE :package);
    IF (actual == requirement.visibility) THEN
      RETURN;
    END
    MUTABLE labels = {:pub: "PUB", :private: "PRIVATE", :package: "package"};
    TRY (resolutionSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ TokenValue: COPY requirement.token }, ResolutionCodeOrMessage{ SymbolValue: :UNION_METHOD_WRONG_VISIBILITY }, [], CAST({:union: node.name, :method: requirement.name, :declared_vis: UNWRAP (labels[requirement.visibility]), :fn: requirement.name, :fn_vis: UNWRAP (labels[actual])} AS {String@symbol}Any)));
}
END
