    END
    IF schema? IS_A StructSchema AS struct_schema THEN
      RETURN COPY struct_schema.generic_params;
    END
    IF resolutionSession__builtin_type_parameter_names().contains?(symbol(owner_name)) THEN
      RETURN CAST(List[] AS []GenericParamDecl);
    END
    RETURN NIL;
}
END
PRIVATE FN resolutionSession__validate_conformance_binders_mut(MUTABLE self: ResolutionSession, declaration: ConformanceDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE seen: [Set]String@symbol = Set[];
    FOR _ IN declaration.binders DO
    MUTABLE name = symbol(_.name);
    IF seen.contains?(name) THEN
        TRY (resolutionSession__error_mut(&rtoc_self_view, (IF _.token EXISTS AS rtoc_anchor_tok_974 THEN DiagnosticAnchor{ TokenValue: COPY rtoc_anchor_tok_974 } ELSE DiagnosticAnchor{ Locatable: COPY Locatable{ ConformanceDef: COPY declaration } } END), ResolutionCodeOrMessage{ SymbolValue: :GENERIC_DUP_TYPE_PARAM_KIND }, [], CAST({:param: _.name, :kind: "conformance", :name: resolutionSession__conformance_base_name(rtoc_self_view, declaration.owner_type)} AS {String@symbol}Any)));
    END
    IF resolutionSession__builtin_type_parameter_names().contains?(name) THEN
        TRY (resolutionSession__error_mut(&rtoc_self_view, (IF _.token EXISTS AS rtoc_anchor_tok_977 THEN DiagnosticAnchor{ TokenValue: COPY rtoc_anchor_tok_977 } ELSE DiagnosticAnchor{ Locatable: COPY Locatable{ ConformanceDef: COPY declaration } } END), ResolutionCodeOrMessage{ SymbolValue: :GENERIC_TYPE_PARAM_SHADOWS }, [], CAST({:param: _.name} AS {String@symbol}Any)));
    END
    IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_16 = TRY (resolutionSession__current_scope(rtoc_self_view));
    TRY (scope__resolve_type_entry(rtoc_local_receiver_16, name)) } THEN
        TRY (resolutionSession__error_mut(&rtoc_self_view, (IF _.token EXISTS AS rtoc_anchor_tok_981 THEN DiagnosticAnchor{ TokenValue: COPY rtoc_anchor_tok_981 } ELSE DiagnosticAnchor{ Locatable: COPY Locatable{ ConformanceDef: COPY declaration } } END), ResolutionCodeOrMessage{ SymbolValue: :GENERIC_TYPE_PARAM_SHADOWS_NOMINAL }, [], CAST({:param: _.name} AS {String@symbol}Any)));
    END
    &seen.insert(name);
    END
}
END
PRIVATE FN resolutionSession__conformance_associated_types(self: ResolutionSession, declaration: ConformanceDef, protocol: ProtocolDef) RETURNS !{String@symbol}Type
