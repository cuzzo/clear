PRIVATE FN resolutionSession__validate_conformance_arity_mut(MUTABLE self: ResolutionSession, declaration: ConformanceDef, protocol: ProtocolDef, owner_name: String, owner_params: []GenericParamDecl) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE protocol_args = TRY (type__generic_args(declaration.protocol_type));
    MUTABLE owner_args = TRY (type__generic_args(declaration.owner_type));
    IF (protocol_args.length() != protocol.associated_types.length()) THEN
      TRY (resolutionSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ ConformanceDef: COPY declaration } }, ResolutionCodeOrMessage{ SymbolValue: :CONFORMANCE_PROTOCOL_ARITY }, [], CAST({:protocol: protocol.name, :expected: protocol.associated_types.length(), :got: protocol_args.length()} AS {String@symbol}Any)));
    END
    IF (owner_args.length() != owner_params.length()) THEN
      TRY (resolutionSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ ConformanceDef: COPY declaration } }, ResolutionCodeOrMessage{ SymbolValue: :CONFORMANCE_OWNER_ARITY }, [], CAST({:owner: owner_name, :expected: owner_params.length(), :got: owner_args.length()} AS {String@symbol}Any)));
    END
    TRY (resolutionSession__validate_conformance_binders_mut(&rtoc_self_view, declaration));
    TRY (resolutionSession__validate_generic_bounds_mut(&rtoc_self_view, declaration.binders));
}
END
PRIVATE FN resolutionSession__infer_conformance_owner_application_mut(MUTABLE self: ResolutionSession, MUTABLE declaration: ConformanceDef, owner_name: String, owner_params: []GenericParamDecl) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF ((owner_params.length() == 0) OR type__generic_instance?(declaration.owner_type)) THEN
      RETURN;
    END
    MUTABLE binders = COPY declaration.binders;
    IF (binders.length() == 0) THEN
      MUTABLE rtoc_name_list: []String = [];
      FOR rtoc_garg IN (TRY (type__generic_args(declaration.protocol_type))) DO
        MUTABLE kind = COPY rtoc_garg.shape.expression.kind;
        IF ((kind IS_A NamedTypeExpression AND UNWRAP (typeExpressionKind__arguments(kind)).empty?()) AND !(resolutionSession__builtin_type_parameter_names().contains?(typeExpressionKind__name(kind)))) THEN
          &rtoc_name_list.append(COPY CAST(typeExpressionKind__name(kind) AS String));
        END
      END
      MUTABLE names = rtoc_name_list |> DISTINCT _;
      IF ((names).length() != owner_params.length()) THEN
        TRY (resolutionSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ ConformanceDef: COPY declaration } }, ResolutionCodeOrMessage{ SymbolValue: :CONFORMANCE_BINDERS_CANNOT_INFER }, [], CAST({:owner: owner_name, :expected: owner_params.length(), :got: (names).length()} AS {String@symbol}Any)));
      END
      binders = names |> SELECT GenericParamDecl{ token: declaration.token, name: COPY _, bounds: List[] };
      declaration.binders = binders;
    END
    IF (binders.length() != owner_params.length()) THEN
      TRY (resolutionSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ ConformanceDef: COPY declaration } }, ResolutionCodeOrMessage{ SymbolValue: :CONFORMANCE_OWNER_ARITY }, [], CAST({:owner: owner_name, :expected: owner_params.length(), :got: binders.length()} AS {String@symbol}Any)));
    END
    declaration.owner_type = TRY (type__new(TypeConstructionInput{ TypeExpression: COPY TypeExpression{ kind: COPY TypeExpressionKind{ NamedTypeExpression: COPY NamedTypeExpression{ name: COPY symbol(owner_name), arguments: COPY (binders |> SELECT typeExpression__of(TypeExpressionKind{ NamedTypeExpression: COPY NamedTypeExpression{ name: COPY symbol(_.name), arguments: List[] } })) } }, capabilities: COPY declaration.owner_type.capabilities } }));
}
END
PRIVATE FN resolutionSession__conformance_owner_params(self: ResolutionSession, owner_name: String, local_owner: ?StructDef) RETURNS !?[]GenericParamDecl
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF local_owner EXISTS AS local_owner_value THEN
      RETURN COPY local_owner_value.generic_params;
    END
    MUTABLE entry: ?ScopeTypeEntry = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_15 = TRY (resolutionSession__current_scope(rtoc_self_view));
    TRY (scope__resolve_type_entry(rtoc_local_receiver_15, symbol(owner_name))) };
    MUTABLE schema: ?SchemaValue = NIL;
    IF entry != NIL THEN
