  TRY (resolutionSession__initialize(&self, importer, source_dir, source_code, root_scope, function_registry, install_builtins));
  RETURN self @multiowned;
END
PUB FN resolutionPhase__run(MUTABLE program: Program, importer: ?ModuleImporter, source_dir: String, source_code: ?String) RETURNS !ResolutionFacts@multiowned ->
  RETURN { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_63 = TRY (resolutionSession__new(importer, source_dir, source_code));
  TRY (resolutionSession__resolve_mut(&rtoc_mutable_receiver_63, &program)) };
END
