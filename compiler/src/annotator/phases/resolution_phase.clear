FN ruby_array_concat_Any__resolution_phase(left: []Any, right: []Any) RETURNS []Any ->
  MUTABLE result: []Any = [];
  left |> EACH { &result.append(COPY _); };
  right |> EACH { &result.append(COPY _); };
  RETURN result;
END
FN ruby_array_concat_Type__resolution_phase(left: []Type, right: []Type) RETURNS []Type ->
  MUTABLE result: []Type = [];
  left |> EACH { &result.append(COPY _); };
  right |> EACH { &result.append(COPY _); };
  RETURN result;
END
FN ruby_union_scalar_equal_FunctionSignatureLifetimeSource_String_symbol__resolution_phase(value: FunctionSignatureLifetimeSource, expected: String@symbol) RETURNS Bool ->
  IF value IS_A String@symbol AS equality_payload THEN
    RETURN equality_payload == expected;
  END
  FALSE;
END
FN ruby_wrap_optional_string_to_symbol__resolution_phase(value: ?String) RETURNS ?String@symbol ->
  IF value EXISTS AS value_value THEN
    RETURN symbol(value_value);
  END
  NIL;
END

# The diagnostic entry points take their kwargs as {String@symbol}Any; the
# callers hold a map of DiagnosticKwValue. The single-value cast cannot convert
# a map, so this converts entry by entry.
FN castDiagnosticKwValueMapToAnyMap__resolution_phase(values: {String@symbol}DiagnosticKwValue) RETURNS {String@symbol}Any ->
  MUTABLE out: {String@symbol}Any = {};
  FOR key IN values.keys() DO
    out[key] = castDiagnosticKwValueToAnyMultiowned__resolution_phase((values[key] OR_ELSE panic("missing hash key")));
  END
  RETURN out;
END
