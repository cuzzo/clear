    END
    IF (type__optional?(type) AND (TRY (type__wrapped_type(type)) != NIL)) THEN
      &nested.append(UNWRAP (TRY (type__wrapped_type(type))));
    END
    IF (type__error_union?(type) AND (TRY (type__payload_type(type)) != NIL)) THEN
