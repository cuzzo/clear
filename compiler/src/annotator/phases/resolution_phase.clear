PRIVATE FN resolutionSession__collect_conformance_members_mut(MUTABLE self: ResolutionSession, declaration: ConformanceDef, protocol: ProtocolDef, owner_name: String) RETURNS !{String}FunctionDef
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE members: {String}FunctionDef = {};
