    MUTABLE scope = TRY (resolutionSession__current_scope(rtoc_self_view));
          scope__declare_type(&scope, synthetic_name, SchemaValue{ StructSchemaMultiowned: COPY TRY (structSchema__new(fields, ( { MUTABLE rtoc_empty_list_24: []String@symbol = List[]; rtoc_empty_list_24 } ), ( { MUTABLE rtoc_empty_list_25: []GenericParamDecl = List[]; rtoc_empty_list_25 } ), {}, {})) });
        END
      END
    END

}
END
