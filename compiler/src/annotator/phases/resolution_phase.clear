PRIVATE FN resolutionSession__current_scope(self: ResolutionSession) RETURNS !Scope@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN KEEP UNWRAP (((resolutionSession__scope_stack_for_helper(rtoc_self_view))).last());
}
