END
PRIVATE FN resolutionSession__declare_type_schema_mut(MUTABLE self: ResolutionSession, node: TypeDeclaration, name: String@symbol, schema: SchemaValue) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_62 = TRY (resolutionSession__current_scope(rtoc_self_view));
    TRY (scope__resolve_type_entry(rtoc_local_receiver_62, name)) } THEN
      TRY (resolutionSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castTypeDeclarationToLocatable(node)), ResolutionCodeOrMessage{ SymbolValue: :DUPLICATE_DECLARATION }, [], CAST({:label: "type", :name: name} AS {String@symbol}Any)));
    END
