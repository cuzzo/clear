PRIVATE FN resolutionSession__lookup_scope_for(MUTABLE self: ResolutionSession, name: String) RETURNS !?Scope@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_reverse_items_3: []Scope@multiowned = (resolutionSession__scope_stack_for_helper(rtoc_self_view));
    MUTABLE rtoc_reverse_i_4 = rtoc_reverse_items_3.length() - 1;
    WHILE rtoc_reverse_i_4 >= 0 DO
    IF { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_5 = ((rtoc_reverse_items_3[rtoc_reverse_i_4])?);
    scope__entry?(&rtoc_local_receiver_5, name) } THEN
        RETURN KEEP (rtoc_reverse_items_3[rtoc_reverse_i_4])?;
    END
    rtoc_reverse_i_4 = rtoc_reverse_i_4 - 1;
    END
    RETURN NIL;
}
END
PRIVATE FN resolutionSession__resolve_variable_scope(MUTABLE self: ResolutionSession, name: String) RETURNS !?Scope@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE scope = TRY (resolutionSession__current_scope(rtoc_self_view));
    IF scope__entry?(&scope, name) THEN
      RETURN scope;
    ELSE
      MUTABLE outer_scope: ?Scope@multiowned = TRY (resolutionSession__lookup_scope_for(&rtoc_self_view, name));
      IF outer_scope EXISTS AS outer_scope_value THEN
        IF functionSignature__unwrap(X{ Type: COPY TRY (scope__resolve_type(outer_scope_value, name)) }) THEN
          RETURN outer_scope_value;
        END
        IF (outer_scope_value.depth == 0) THEN
          RETURN outer_scope_value;
        END
        RETURN NIL;
      ELSE
        RETURN NIL;
      END
    END
}
END
PRIVATE FN resolutionSession__lookup_type_schema(self: ResolutionSession, name: String@symbol) RETURNS !?SchemaValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE base_name = symbol((compilerRegexReplaceFirst((CAST(name AS String)), compilerRegexCompile("<.*>$"), "")));
    MUTABLE rtoc_reverse_items_6: []Scope@multiowned = (resolutionSession__scope_stack_for_helper(rtoc_self_view));
    MUTABLE rtoc_reverse_i_7 = rtoc_reverse_items_6.length() - 1;
    WHILE rtoc_reverse_i_7 >= 0 DO
      MUTABLE schema: ?SchemaValue = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_8 = ((rtoc_reverse_items_6[rtoc_reverse_i_7])?);
      TRY (scope__resolve_type_definition(rtoc_local_receiver_8, base_name)) };
      IF schema THEN
          RETURN schema;
      END
    rtoc_reverse_i_7 = rtoc_reverse_i_7 - 1;
    END
    RETURN NIL;
}
END
PRIVATE FN resolutionSession__all_known_type_names(MUTABLE self: ResolutionSession) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE names = List[];
    FOR _ IN (resolutionSession__scope_stack_for_helper(rtoc_self_view)) DO
    ruby_array_concat_Any__resolution_phase(names, CAST(_.types.keys() |> SELECT _.toString() AS []Any));
    END
    RETURN CAST((names |> DISTINCT _) AS []Any);
}
END
PRIVATE FN resolutionSession__with_new_scope<RESULT>(MUTABLE self: ResolutionSession, scope: ?Scope = NIL, blk: FN() -> RESULT) RETURNS !RESULT
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  DEFER &rtoc_self_view.scope_stack.pop();
  MUTABLE new_scope = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_10: ?Scope = NIL;
    IF (scope == NIL) THEN
      rtoc_ternary_value_10 = scope__new();
    ELSE
      rtoc_ternary_value_10 = COPY scope;
    END
    rtoc_ternary_value_10? };
  new_scope.depth = rtoc_self_view.scope_stack.length();
  &rtoc_self_view.scope_stack.push(new_scope);
  RETURN blk();
}
END
