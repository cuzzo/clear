        TRY (resolutionSession__error_mut(&rtoc_self_view, (IF _.token EXISTS AS rtoc_anchor_tok_1763 THEN DiagnosticAnchor{ TokenValue: COPY rtoc_anchor_tok_1763 } ELSE DiagnosticAnchor{ Locatable: COPY Locatable{ ProtocolDef: COPY node } } END), ResolutionCodeOrMessage{ SymbolValue: :GENERIC_DUPLICATE_TYPE_PARAM }, [], CAST({:param: _.name, :struct: node.name} AS {String@symbol}Any)));
