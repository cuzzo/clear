PRIVATE FN resolutionSession__conformance_function_name(self: ResolutionSession, protocol_name: String, owner_name: String, member_name: String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE parts = ([protocol_name, owner_name, member_name]) |> SELECT compilerRegexReplaceAll(_, compilerRegexCompile("[^A-Za-z0-9_]"), "_");
    RETURN "__conformance_${parts.join("_")}";
}
END
PRIVATE FN resolutionSession__resolve_conformance_declarations_mut(MUTABLE self: ResolutionSession, declarations: DeclarationIndex) RETURNS ![]ConformanceResolution
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE local_structs: {String}TypeDeclaration = {};
    FOR rtoc_decl IN declarations.type_declarations DO
      IF rtoc_decl IS_A StructDef THEN
        local_structs[(aST__node_name(UNWRAP (castTypeDeclarationToLocatable(rtoc_decl))) OR_ELSE "")] = COPY rtoc_decl;
      END
    END
    MUTABLE local_protocols = (declarations.type_declarations |> SELECT:? (  IF _ IS_A ProtocolDef THEN
      typeDeclaration__name(_)
    ELSE
      NIL
    END) |> WHERE _ != NIL) |> DISTINCT _;
    MUTABLE seen: [Set]String = Set[];
    MUTABLE rtoc_resolutions: []ConformanceResolution = [];
    FOR MUTABLE rtoc_mutable_block_param_14 IN declarations.conformance_declarations DO
    MUTABLE protocol_name = resolutionSession__conformance_base_name(rtoc_self_view, rtoc_mutable_block_param_14.protocol_type);
    MUTABLE owner_name = resolutionSession__conformance_base_name(rtoc_self_view, rtoc_mutable_block_param_14.owner_type);
    MUTABLE protocol: ?ProtocolDef = COPY rtoc_self_view.protocols[protocol_name];
    IF !(protocol) THEN
        TRY (resolutionSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ ConformanceDef: COPY rtoc_mutable_block_param_14 } }, ResolutionCodeOrMessage{ SymbolValue: :CONFORMANCE_UNKNOWN_PROTOCOL }, [], CAST({:protocol: protocol_name} AS {String@symbol}Any)));
    END
    MUTABLE local_owner: ?TypeDeclaration = local_structs[owner_name];
    MUTABLE owner_params: ?[]GenericParamDecl = TRY (resolutionSession__conformance_owner_params(rtoc_self_view, owner_name, UNWRAP (castTypeDeclarationToStructDef(UNWRAP (local_owner)))));
    IF !(owner_params) THEN
        TRY (resolutionSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ ConformanceDef: COPY rtoc_mutable_block_param_14 } }, ResolutionCodeOrMessage{ SymbolValue: :CONFORMANCE_UNKNOWN_OWNER }, [], CAST({:owner: owner_name} AS {String@symbol}Any)));
    END
    TRY (resolutionSession__infer_conformance_owner_application_mut(&rtoc_self_view, &rtoc_mutable_block_param_14, owner_name, UNWRAP (owner_params)));
    IF !((local_owner OR local_protocols.contains?(protocol_name))) THEN
        TRY (resolutionSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ ConformanceDef: COPY rtoc_mutable_block_param_14 } }, ResolutionCodeOrMessage{ SymbolValue: :CONFORMANCE_ORPHAN }, [], CAST({:protocol: protocol_name, :owner: owner_name} AS {String@symbol}Any)));
    END
    MUTABLE key = "${protocol_name}:${owner_name}";
    IF seen.contains?(key) THEN
        TRY (resolutionSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ ConformanceDef: COPY rtoc_mutable_block_param_14 } }, ResolutionCodeOrMessage{ SymbolValue: :CONFORMANCE_DUPLICATE }, [], CAST({:protocol: protocol_name, :owner: owner_name} AS {String@symbol}Any)));
    END
    &seen.insert(key);
    TRY (resolutionSession__validate_conformance_arity_mut(&rtoc_self_view, rtoc_mutable_block_param_14, UNWRAP (protocol), owner_name, UNWRAP (owner_params)));
    MUTABLE associated = TRY (resolutionSession__conformance_associated_types(rtoc_self_view, rtoc_mutable_block_param_14, UNWRAP (protocol)));
    MUTABLE members = TRY (resolutionSession__collect_conformance_members_mut(&rtoc_self_view, rtoc_mutable_block_param_14, UNWRAP (protocol), owner_name));
    TRY (resolutionSession__stamp_type_mut(rtoc_self_view, Locatable{ ConformanceDef: COPY rtoc_mutable_block_param_14 }, :Void));
    &rtoc_resolutions.append(ConformanceResolution{ declaration: COPY rtoc_mutable_block_param_14, protocol: UNWRAP (COPY protocol), owner_name: COPY owner_name, owner_generic_params: COPY UNWRAP (owner_params), associated_types: CAST(COPY associated AS {String@symbol}Type), members: members });
    END
    RETURN rtoc_resolutions;
}
END
PRIVATE FN resolutionSession__prepare_conformance_members_mut(MUTABLE self: ResolutionSession, MUTABLE declarations: DeclarationIndex, resolutions: []ConformanceResolution, MUTABLE program: Program) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR resolution IN resolutions DO
    FOR MUTABLE member IN resolution.members.values() DO
    MUTABLE source_name = COPY member.name;
    MUTABLE inherited_names = (resolution.declaration.binders |> SELECT _.name) |> DISTINCT _;
    FOR parameter IN member.generic_params DO
    IF inherited_names.contains?(parameter.name) THEN
        MUTABLE anchor: ?DiagnosticAnchor = DiagnosticAnchor{ Locatable: Locatable{ FunctionDef: COPY member } };
        IF parameter.token EXISTS AS parameter_token THEN
          anchor = DiagnosticAnchor{ TokenValue: COPY parameter_token };
        END
        TRY (resolutionSession__error_mut(&rtoc_self_view, anchor, ResolutionCodeOrMessage{ SymbolValue: :IMPLEMENTATION_MEMBER_SHADOWS_OWNER }, [], CAST({:owner: resolution.owner_name, :name: parameter.name, :member: source_name} AS {String@symbol}Any)));
    END
    END
    member.generic_params = (resolution.declaration.binders + member.generic_params);
    member.type_params = member.generic_params |> SELECT _.name;
    member.implementation_owner = COPY resolution.owner_name;
    member.conformance_protocol = COPY resolution.protocol.name;
    member.source_name = source_name;
    member.name = resolutionSession__conformance_function_name(rtoc_self_view, resolution.protocol.name, resolution.owner_name, source_name);
    IF member.is_method THEN
        TRY (resolutionSession__prepare_conformance_receiver_mut(&rtoc_self_view, member, resolution));
    END
    TRY (resolutionSession__validate_member_type_parameter_references_mut(&rtoc_self_view, member));
    &declarations.function_declarations.append(COPY member);
    &declarations.body_statements.append(COPY member);
    &program.statements.append(COPY member);
    END
    END
}
END
PRIVATE FN resolutionSession__prepare_conformance_receiver_mut(MUTABLE self: ResolutionSession, member: FunctionDef, resolution: ConformanceResolution) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE receiver: ?Param = COPY member.params.first();
    IF !(((receiver != NIL) AND (receiver.name == "self"))) THEN
      TRY (resolutionSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ FunctionDef: COPY member } }, ResolutionCodeOrMessage{ SymbolValue: :IMPLEMENTATION_METHOD_NEEDS_SELF }, [], CAST({:owner: resolution.owner_name, :name: member.source_name} AS {String@symbol}Any)));
    END
    MUTABLE receiver_value: Param = receiver?;
    IF type__any?(receiver_value.type) THEN
      receiver_value.type = COPY resolution.declaration.owner_type;
    END
}
END
