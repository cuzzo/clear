PUB FN resolutionSession__validate_type_param_list_mut(MUTABLE self: ResolutionSession, node: Node, type_params: []String, kind: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE seen: [Set]String@symbol = Set[];
    FOR _ IN type_params DO
    MUTABLE name = symbol(_);
    IF seen.contains?(name) THEN
        TRY (resolutionSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castNodeToLocatable(node)), ResolutionCodeOrMessage{ SymbolValue: :GENERIC_DUP_TYPE_PARAM_KIND }, [], CAST({:param: _, :kind: kind, :name: aST__node_name(UNWRAP (castNodeToLocatable(node)))} AS {String@symbol}Any)));
    END
    IF resolutionSession__builtin_type_parameter_names().contains?(name) THEN
        TRY (resolutionSession__error_mut(&rtoc_self_view, diagnosticAnchor__of(castNodeToLocatable(node)), ResolutionCodeOrMessage{ SymbolValue: :GENERIC_TYPE_PARAM_SHADOWS }, [], CAST({:param: _} AS {String@symbol}Any)));
    END
    IF (rtoc_self_view.local_type_declaration_names.contains?(name) OR { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_1 = TRY (resolutionSession__current_scope(rtoc_self_view));
    TRY (scope__resolve_type_entry(rtoc_local_receiver_1, name)) }) THEN
        TRY (resolutionSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: COPY UNWRAP (castResolutionSessionReturnValueToLocatable(resolutionSession__generic_param_token(rtoc_self_view, node, _))) }, ResolutionCodeOrMessage{ SymbolValue: :GENERIC_TYPE_PARAM_SHADOWS_NOMINAL }, [], CAST({:param: _} AS {String@symbol}Any)));
    END
    &seen.insert(name);
    END
}
END
PUB FN resolutionSession__generic_param_token(self: ResolutionSession, node: Node, name: String) RETURNS ResolutionSessionReturnValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node__generic_params(node) EXISTS AS params THEN
      MUTABLE param: ?GenericParamDecl = params |> FIND (_.name == name);
      IF param EXISTS AS param_value THEN
        IF param_value.token EXISTS AS param_token THEN
          RETURN ResolutionSessionReturnValue{ Token: COPY param_token };
        END
      END
    END
    RETURN castNodeToResolutionSessionReturnValue(node);
}
END
PUB FN resolutionSession__get_lifetime_path(self: ResolutionSession, node: FunctionDef) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE lifetime: ?ClearParserReturnLifetime = COPY node.return_lifetime;
    IF ((lifetime == NIL) OR (IF lifetime IS_A String@symbol AS lifetime_sym THEN (lifetime_sym == :wildcard) ELSE FALSE END)) THEN
      RETURN NIL;
    END
    MUTABLE sources: []Any = List[];
    IF lifetime IS_A ArrayValue AS rtoc_lifetime_arr THEN
      sources = COPY CAST(rtoc_lifetime_arr AS []Any);
    ELSE
      sources = [CAST(lifetime AS Any)];
    END
    MUTABLE paths = sources |> SELECT:? (IF !(TRUE) THEN NIL ELSE { MUTABLE rtoc_value_block_marker = 0; MUTABLE path = TRY (scope__get_path_to_root(rtoc_self_view.root_scope, CAST(_ AS Locatable))); (IF !((path.length() == 0)) THEN
      path.join(".")
    ELSE
      NIL
    END) } END) |> WHERE _ != NIL;
    IF (paths.length() == 1) THEN
      RETURN COPY paths.first();
    ELSE
      RETURN NIL;
    END
}
END
PUB FN resolutionSession__to_type(self: ResolutionSession, value: TypeTypeInput) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF value IS_A Type AS type THEN
      RETURN COPY type;
    ELSE
      RETURN TRY (type__new(castTypeTypeInputToTypeConstructionInput__resolution_phase(value)));
    END
}
