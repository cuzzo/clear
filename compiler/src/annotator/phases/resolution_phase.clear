    END
    MUTABLE existing: ?ScopeTypeEntry = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_56 = TRY (resolutionSession__current_scope(rtoc_self_view));
    TRY (scope__resolve_type_entry(rtoc_local_receiver_56, symbol(node.name))) };
    IF ((existing != NIL) AND resolutionSession__equivalent_extern_type_schema?(&rtoc_self_view, existing.schema, UNWRAP (schema))) THEN
      TRY (resolutionSession__stamp_type_mut(rtoc_self_view, Locatable{ ExternStructDecl: COPY node }, :Void));
      RETURN;
    END
    TRY (resolutionSession__declare_type_schema_mut(&rtoc_self_view, TypeDeclaration{ ExternStructDecl: COPY node }, symbol(node.name), UNWRAP (schema)));
    TRY (resolutionSession__stamp_type_mut(rtoc_self_view, Locatable{ ExternStructDecl: COPY node }, :Void));
}
END
PRIVATE FN resolutionSession__register_struct_declaration(MUTABLE self: ResolutionSession, MUTABLE node: StructDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (node.type_params.length() > 0) THEN
      TRY (resolutionSession__validate_type_param_list_mut(&rtoc_self_view, Node{ StructDef: COPY node }, node.type_params, "struct"));
    END
    TRY (resolutionSession__validate_generic_bounds_mut(&rtoc_self_view, node.generic_params));
    FOR MUTABLE rtoc_mutable_block_param_57 IN node.field_decls.values() DO
    TRY (resolutionSession__resolve_declaration_projections_mut(&rtoc_self_view, Locatable{ StructDef: COPY node }, &rtoc_mutable_block_param_57.type, node.generic_params));
    END
    FOR _ IN node.field_decls.values() DO
    IF TRY (type__preallocation_hint?(_.type)) THEN
      TRY (resolutionSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ StructDef: COPY node } }, ResolutionCodeOrMessage{ SymbolValue: :COLLECTION_HINT_VALUE_ONLY }));
    END
    END
    MUTABLE tp_names = TRY (resolutionSession__type_params(rtoc_self_view, node.type_params));
    FOR rtoc_each_item_2016 IN node.field_decls.keys() DO
    MUTABLE field: StructField@multiowned = (node.field_decls[rtoc_each_item_2016] OR_ELSE CAST(panic("missing hash key") AS StructField@multiowned));
    MUTABLE ft = structField__type(field);
    IF !((TRUE AND tp_names.contains?(type__resolved(ft)))) THEN
