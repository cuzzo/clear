PRIVATE FN resolutionSession__error_mut(MUTABLE self: ResolutionSession, node_or_token: ?DiagnosticAnchor, code_or_message: ResolutionCodeOrMessage, args: []?DiagnosticKwValue = [], kwargs: {String@symbol}Any = {}) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE token: ?Any@multiowned = resolutionSession__diagnostic_token(rtoc_self_view, node_or_token);
    MUTABLE message: ?String = "";
    IF code_or_message IS_A String@symbol AS string_symbol THEN
      message = TRY (diagnosticRegistry__format_from_hash(string_symbol, args, kwargs));
      IF !(message) THEN
        panic("Internal Compiler Error: Unknown error code :{}");
      END
    ELSE
      message = castCodeOrMessageToOptionalString__resolution_phase(COPY code_or_message);
    END
    MUTABLE source_token: ?Token@multiowned = resolutionSession__source_error_token(rtoc_self_view, token);
    MUTABLE diagnostic_code: ?String@symbol = NIL;
    IF code_or_message IS_A String@symbol AS string_symbol THEN
      diagnostic_code = COPY string_symbol;
    END
    RETURN TRY (resolutionSession__raise_source_error_mut(&rtoc_self_view, CAST(source_token AS ?Token), UNWRAP (message), diagnostic_code));
}
END
