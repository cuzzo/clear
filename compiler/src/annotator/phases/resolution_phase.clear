END
PRIVATE FN resolutionSession__equivalent_extern_type_schema?(MUTABLE self: ResolutionSession, existing: SchemaValue, incoming: SchemaValue) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_vn_existing = scopeScopeTypeSchema__variant_name(existing);
    MUTABLE rtoc_vn_incoming = scopeScopeTypeSchema__variant_name(incoming);
    IF !((rtoc_vn_existing == rtoc_vn_incoming)) THEN
      RETURN FALSE;
    END
    MUTABLE rtoc_ext_existing = resolutionSession__extern_type_schema?(&rtoc_self_view, existing);
    MUTABLE rtoc_ext_incoming = resolutionSession__extern_type_schema?(&rtoc_self_view, incoming);
    IF !((rtoc_ext_existing AND rtoc_ext_incoming)) THEN
      RETURN FALSE;
    END
    MUTABLE rtoc_em_existing: ?String = COPY scopeScopeTypeSchema__extern_module(existing);
    MUTABLE rtoc_em_incoming: ?String = COPY scopeScopeTypeSchema__extern_module(incoming);
    IF !((rtoc_em_existing == rtoc_em_incoming)) THEN
      RETURN FALSE;
    END
    MUTABLE rtoc_at_existing: ?String = COPY schemaValue__as_type(existing);
    MUTABLE rtoc_at_incoming: ?String = COPY schemaValue__as_type(incoming);
    MUTABLE rtoc_at_eq = (rtoc_at_existing == rtoc_at_incoming);
    IF !(rtoc_at_eq) THEN
      RETURN FALSE;
    END
    MUTABLE rtoc_tp_existing = schemaValue__type_params(existing);
    MUTABLE rtoc_tp_incoming = schemaValue__type_params(incoming);
    IF !((rtoc_tp_existing == rtoc_tp_incoming)) THEN
      RETURN FALSE;
    END
    MUTABLE rtoc_f_existing = schemaValue__fields(existing);
    MUTABLE rtoc_f_incoming = schemaValue__fields(incoming);
    MUTABLE rtoc_fields_eq = resolutionSession__equivalent_struct_fields?(&rtoc_self_view, rtoc_f_existing, rtoc_f_incoming);
    IF !(rtoc_fields_eq) THEN
      RETURN FALSE;
    END
    IF existing IS_A ResourceSchema AS rtoc_existing_res THEN
      IF incoming IS_A ResourceSchema AS rtoc_incoming_res THEN
        RETURN (rtoc_existing_res.close_plan == rtoc_incoming_res.close_plan);
      END
    END
    RETURN TRUE;
}
END
PRIVATE FN resolutionSession__extern_type_schema?(MUTABLE self: ResolutionSession, schema: SchemaValue) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN (((schema IS_A StructSchema OR schema IS_A ResourceSchema)) AND !((scopeScopeTypeSchema__extern_module(schema) == NIL)));
}
END
PRIVATE FN resolutionSession__equivalent_struct_fields?(MUTABLE self: ResolutionSession, left: {String}StructField, right: {String}StructField) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(((left.keys() |> ORDER_BY _) == (right.keys() |> ORDER_BY _))) THEN
      RETURN FALSE;
    END
    RETURN left.keys() |> ALL {
    MUTABLE left_field: StructField = UNWRAP (left[_]);
    MUTABLE right_field: ?StructField = COPY right[_];
    ((((right_field != NIL) AND (CAST(structField__type(left_field) AS String) == CAST(right_field.type AS String))) AND (structField__borrowed(left_field) == right_field.borrowed)) AND ((structField__default(left_field) == NIL) == ((COPY right_field.default) == NIL)))
    };
}
END
PRIVATE FN resolutionSession__inline_struct_deinit_entries(self: ResolutionSession, variant_data: InlineStructVariant) RETURNS ![]InlineStructDeinitEntry
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE entries: []InlineStructDeinitEntry = List[];
    FOR field_name IN variant_data.fields.keys() DO
    MUTABLE field_type: TypeTypeInput = UNWRAP (variant_data.fields[field_name]);
    MUTABLE field_type_info = COPY field_type;
    MUTABLE field = COPY CAST(field_name AS String);
    IF (typeTypeInput__indirect?(field_type_info) OR_ELSE FALSE) THEN
      &entries.append(inlineStructDeinitEntry__indirect(field, TRY (type__zig_type((TRY (type__new(TypeConstructionInput{ SymbolValue: COPY UNWRAP (typeTypeInput__resolved(field_type_info)) })))))));
    ELSE_IF ((TRY (typeTypeInput__string?(field_type_info)) OR_ELSE FALSE) OR (typeTypeInput__collection?(field_type_info) OR_ELSE FALSE)) THEN
      &entries.append(inlineStructDeinitEntry__uniform(field, UNWRAP (TRY (typeTypeInput__zig_type(field_type_info)))));
    ELSE_IF ((typeTypeInput__array?(field_type_info) OR_ELSE FALSE) AND !((TRY (typeTypeInput__string?(field_type_info)) OR_ELSE FALSE))) THEN
      MUTABLE elem_zig_type = TRY (type__zig_type((TRY (type__new(TypeConstructionInput{ Type: COPY UNWRAP (TRY (typeTypeInput__element_type(field_type_info))) })))));
      &entries.append(inlineStructDeinitEntry__array(field, elem_zig_type));
    END
    END
    RETURN entries;
}
END
PRIVATE FN resolutionSession__type_params(self: ResolutionSession, params: []String) RETURNS ![]String@symbol
