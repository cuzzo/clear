PRIVATE FN resolutionSession__raise_source_error_mut(MUTABLE self: ResolutionSession, token: ?Token, message: String, code: ?String@symbol = NIL) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
