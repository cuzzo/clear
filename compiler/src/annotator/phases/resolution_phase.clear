PRIVATE FN resolutionSession__clone_enum_schema(self: ResolutionSession, schema: EnumSchema) RETURNS !EnumSchema@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE variants: []String = ( { MUTABLE rtoc_empty_list_26: []String = List[]; rtoc_empty_list_26 } );
    FOR _ IN schema.variants DO
