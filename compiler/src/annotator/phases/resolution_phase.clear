PRIVATE FN resolutionSession__c_boundary_rejection(self: ResolutionSession, type: Type, return_position: Bool) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF type__error_union?(type) THEN
      RETURN "CLEAR error unions do not have a C ABI; return a status code explicitly";
    END
    IF (type__future?(type) OR TRY (type__stream?(type))) THEN
      RETURN "futures and streams cannot cross a synchronous C ABI";
    END
    IF (type__any?(type) OR (type__resolved(type) == :Number)) THEN
      RETURN "abstract Any/Number values have no fixed C representation";
    END
    IF (TRY (type__string?(type)) AND !(TRY (type__c_string?(type)))) THEN
      RETURN "ordinary String is a slice header; use String@c";
    END
    IF ((type__map?(type) OR type__tuple?(type)) OR (((type__array?(type) AND !(type__fixed?(type))) AND !(TRY (type__c_array_view?(type)))))) THEN
      RETURN "maps, Tuples, and managed collections have no portable C ABI";
    END
    IF (return_position AND type__fixed?(type)) THEN
      RETURN "C cannot return an array by value; return a pointer plus a count";
    END
    IF type__fn_type?(type) THEN
      MUTABLE fn: ?FunctionType = type__function_type(type);
      IF !(((fn != NIL) AND (fn.abi == :c))) THEN
        RETURN "callback function types must use CALLCONV C";
      END
      RETURN NIL;
    END
    IF type__optional?(type) THEN
      MUTABLE inner = UNWRAP (TRY (type__wrapped_type(type)));
      IF ((TRY (type__c_string?(inner)) OR TRY (type__c_array_view?(inner))) OR (((!(type__primitive?(inner)) AND !(type__array?(inner))) AND !(type__map?(inner))))) THEN
        RETURN NIL;
      END
      RETURN "nullable scalar values are not C pointers; use an explicit status/out contract";
    END
    IF ((!((type__layout(type) == NIL)) OR !((CAST(Tuple{NIL, :affine} AS Tuple<Void, String@symbol>)).contains?(type__ownership(type)))) OR type__any_sync?(type)) THEN
      RETURN "ownership, synchronization, and boxed wrappers change the declared C layout";
    END
    RETURN NIL;
}
END
