EXTERN STRUCT CompilerRegex {} FROM "compiler_regex";
EXTERN FN compilerRegexCompile(pattern: String) RETURNS CompilerRegex EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexMatch(subject: String, regex: CompilerRegex) RETURNS Bool EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexReplaceAll(subject: String, regex: CompilerRegex, replacement: String) RETURNS String EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexReplaceFirst(subject: String, regex: CompilerRegex, replacement: String) RETURNS String EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexEscape(value: String) RETURNS String EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerCountOccurrences(text: String, needle: String) RETURNS Int64 EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerLastIndex(text: String, needle: String) RETURNS Int64 EFFECTS :safe FROM "compiler_regex";
UNION ResolutionCodeOrMessage { StringValue: String, SymbolValue: String@symbol }
PUB UNION ResolutionSessionReturnValue { MIRProgram: MIRProgram, RequireNode: RequireNode, ProtocolRequirement: ProtocolRequirement, ProtocolDef: ProtocolDef, FunctionDefMultiowned: FunctionDef@multiowned, ImplementationDef: ImplementationDef, ConformanceDef: ConformanceDef, MIRStructDef: MIRStructDef, VarDecl: VarDecl, Assignment: Assignment, MIRDestructureTarget: MIRDestructureTarget, DestructuringAssignment: DestructuringAssignment, BindExpr: BindExpr, BinaryOp: BinaryOp, IsA: IsA, MIRUnaryOp: MIRUnaryOp, CallSiteOverride: CallSiteOverride, Identifier: Identifier, Literal: Literal, ListLit: ListLit, TupleLit: TupleLit, DefaultArrayLit: DefaultArrayLit, HashLit: HashLit, DefaultLit: DefaultLit, StructLit: StructLit, LambdaLit: LambdaLit, IfStatement: IfStatement, IfBind: IfBind, WhileLoop: WhileLoop, WhileBindLoop: WhileBindLoop, BreakNode: BreakNode, ContinueNode: ContinueNode, FuncCall: FuncCall, MIRMethodCall: MIRMethodCall, GetField: GetField, GetIndex: GetIndex, MIRCast: MIRCast, ReturnNode: ReturnNode, Assert: Assert, TenseRecoveryRaise: TenseRecoveryRaise, ThrowNode: ThrowNode, DieNode: DieNode, Slice: Slice, Require: Require, MIRDeferStmt: MIRDeferStmt, WithBlockMultiowned: WithBlock@multiowned, SyncPolicyDecl: SyncPolicyDecl, SelectOpMultiowned: SelectOp@multiowned, WhereOpMultiowned: WhereOp@multiowned, IndexOpMultiowned: IndexOp@multiowned, ReduceOpMultiowned: ReduceOp@multiowned, OrderByOpMultiowned: OrderByOp@multiowned, LimitOp: LimitOp, UnnestOpMultiowned: UnnestOp@multiowned, DistinctOpMultiowned: DistinctOp@multiowned, EachOp: EachOp, TapOp: TapOp, SkipOp: SkipOp, CollectOp: CollectOp, TakeWhileOpMultiowned: TakeWhileOp@multiowned, WindowOpMultiowned: WindowOp@multiowned, BatchWindowOpMultiowned: BatchWindowOp@multiowned, JoinOp: JoinOp, FindOpMultiowned: FindOp@multiowned, AnyOpMultiowned: AnyOp@multiowned, AllOpMultiowned: AllOp@multiowned, CountOpMultiowned: CountOp@multiowned, SumOpMultiowned: SumOp@multiowned, AverageOpMultiowned: AverageOp@multiowned, MinOpMultiowned: MinOp@multiowned, MaxOpMultiowned: MaxOp@multiowned, ShardOp: ShardOp, ConcurrentOp: ConcurrentOp, Placeholder: Placeholder, Copy: Copy, MIROptionalUnwrap: MIROptionalUnwrap, TenseNavigation: TenseNavigation, MutableBorrow: MutableBorrow, TenseOperationKindOrElseRaise: TenseOperationKindOrElseRaise, TenseOperationKindOrElseExit: TenseOperationKindOrElseExit, TenseOperationKindOrElsePass: TenseOperationKindOrElsePass, TenseOperationKindOrElsePrune: TenseOperationKindOrElsePrune, TenseOperationKindOrElseBreak: TenseOperationKindOrElseBreak, CatchBlock: CatchBlock, RecoverOp: RecoverOp, MIRBlockExpr: MIRBlockExpr, StringConcat: StringConcat, CapabilityWrap: CapabilityWrap, MoveNode: MoveNode, CopyNode: CopyNode, KeepNode: KeepNode, ShareNode: ShareNode, LinkNode: LinkNode, ResolveNode: ResolveNode, FreezeNode: FreezeNode, PassStmt: PassStmt, StructPattern: StructPattern, MIRRangeLit: MIRRangeLit, ExternFnDecl: ExternFnDecl, ExternStructDecl: ExternStructDecl, MIREnumDef: MIREnumDef, UnionDef: UnionDef, UnionVariantLit: UnionVariantLit, StaticCall: StaticCall, MIRDoBlock: MIRDoBlock, MIRBgBlock: MIRBgBlock, ThenChain: ThenChain, BgStreamBlock: BgStreamBlock, YieldExpr: YieldExpr, CloseStream: CloseStream, NextExpr: NextExpr, MatchStatement: MatchStatement, ForRange: ForRange, ForEach: ForEach, TestBlock: TestBlock, WhenBlock: WhenBlock, LetBinding: LetBinding, TestThat: TestThat, AssertRaisesMultiowned: AssertRaises@multiowned, BenchmarkStmtMultiowned: BenchmarkStmt@multiowned, SmashStmtMultiowned: SmashStmt@multiowned, ProfileStmtMultiowned: ProfileStmt@multiowned, StubDecl: StubDecl, Drop: Drop, SuppressCleanup: SuppressCleanup, Return: Return, ReassignCleanup: ReassignCleanup, FieldCleanup: FieldCleanup, TokenMultiowned: Token@multiowned, FunctionDef: FunctionDef, WithBlock: WithBlock, SelectOp: SelectOp, WhereOp: WhereOp, IndexOp: IndexOp, ReduceOp: ReduceOp, OrderByOp: OrderByOp, UnnestOp: UnnestOp, DistinctOp: DistinctOp, TakeWhileOp: TakeWhileOp, WindowOp: WindowOp, BatchWindowOp: BatchWindowOp, FindOp: FindOp, AnyOp: AnyOp, AllOp: AllOp, CountOp: CountOp, SumOp: SumOp, AverageOp: AverageOp, MinOp: MinOp, MaxOp: MaxOp, AssertRaises: AssertRaises, BenchmarkStmt: BenchmarkStmt, SmashStmt: SmashStmt, ProfileStmt: ProfileStmt, Token: Token }
# Ruby module Annotator
# Ruby module Annotator::Phases
PUB STRUCT ResolutionSession {
  function_registry: FunctionRegistry,
  importer: ?ModuleImporter@multiowned,
  local_type_declaration_names: [Set]String@symbol,
  protocols: {String}ProtocolDef,
  root_scope: Scope@multiowned,
  scope_stack: []Scope@multiowned,
  source_code: ?String,
  source_dir: String
}

builtin_type_parameter_names = [:Number, :Bool, :Byte, :Int8, :Int16, :Int32, :Int64, :UInt8, :UInt16, :UInt32, :UInt64, :Float32, :Float64, :TargetInt, :TargetUInt, :TargetLong, :TargetULong, :TargetLongLong, :TargetULongLong, :String, :Any, :Void, :Range, :Map];
PUB FN resolutionSession__initialize(MUTABLE self: ResolutionSession, importer: ?ModuleImporter, source_dir: String, source_code: ?String, root_scope: ?Scope = NIL, function_registry: ?FunctionRegistry = NIL, install_builtins: Bool = TRUE) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.importer = COPY importer;
    rtoc_self_view.source_dir = COPY source_dir;
    rtoc_self_view.source_code = COPY source_code;
    rtoc_self_view.root_scope = (root_scope OR_ELSE scope__new());
    rtoc_self_view.scope_stack = [rtoc_self_view.root_scope];
    rtoc_self_view.function_registry = (function_registry OR_ELSE FunctionRegistry{ nodes: {}, synthetic_definitions: List[], body_summaries: {} });
    rtoc_self_view.protocols = {};
    rtoc_self_view.local_type_declaration_names = Set[];
    IF install_builtins THEN
      resolutionSession__initialize_builtin_environment_mut(rtoc_self_view);
    END
}
END
PUB FN resolutionSession__resolve_mut(MUTABLE self: ResolutionSession, program: Program) RETURNS !ResolutionFacts@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE declarations = TRY (declarationIndexer__index(program));
    rtoc_self_view.local_type_declaration_names = (declarations.type_declarations |> SELECT type__to_sym(_.name())) |> DISTINCT _;
    FOR _ IN declarations.imports DO
    resolutionSession__visit_RequireNode(rtoc_self_view, _);
    END
    resolutionSession__register_type_declarations(&rtoc_self_view, declarations);
    MUTABLE conformance_resolutions = resolutionSession__resolve_conformance_declarations_mut(rtoc_self_view, declarations);
    MUTABLE implementation_resolutions = resolutionSession__resolve_implementation_declarations_mut(rtoc_self_view, declarations);
    resolutionSession__prepare_conformance_members_mut(rtoc_self_view, declarations, conformance_resolutions, program);
    resolutionSession__prepare_implementation_members_mut(rtoc_self_view, declarations, implementation_resolutions, program);
    resolutionSession__register_program_signatures(&rtoc_self_view, declarations);
    RETURN resolutionFacts__new(program, declarations, rtoc_self_view.root_scope, rtoc_self_view.function_registry, rtoc_self_view.root_scope.types.keys(), TRY (resolutionSession__resolved_function_names(rtoc_self_view)), implementation_resolutions, conformance_resolutions, rtoc_self_view.protocols);
}
END
PUB FN resolutionSession__protocol_declared?(self: ResolutionSession, name: String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ((name == "Map") OR rtoc_self_view.protocols.contains?(name));
}
END
PUB FN resolutionSession__register_protocol_mut(MUTABLE self: ResolutionSession, protocol: ProtocolDef) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.protocols[protocol.name] = COPY protocol;
}
END
PUB FN resolutionSession__register_local_declaration_mut(self: ResolutionSession, node: Node) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node IS_A StructDef AS struct_def THEN
      resolutionSession__register_type_declaration(rtoc_self_view, TypeDeclaration{ StructDef: COPY struct_def });
    ELSE_IF node IS_A ExternStructDecl AS extern_struct_decl THEN
      resolutionSession__register_type_declaration(rtoc_self_view, TypeDeclaration{ ExternStructDecl: COPY extern_struct_decl });
    ELSE_IF node IS_A EnumDef AS enum_def THEN
      resolutionSession__register_type_declaration(rtoc_self_view, TypeDeclaration{ EnumDef: COPY enum_def });
    ELSE_IF node IS_A UnionDef AS union_def THEN
      resolutionSession__register_type_declaration(rtoc_self_view, TypeDeclaration{ UnionDef: COPY union_def });
    ELSE_IF node IS_A ExternFnDecl AS extern_fn_decl THEN
      resolutionSession__register_extern_function_signature(rtoc_self_view, extern_fn_decl);
    END
}
END
PUB FN resolutionSession__scope_stack(self: ResolutionSession) RETURNS ![]Scope@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY rtoc_self_view.scope_stack;
}
END
PUB FN resolutionSession__active_importer(self: ResolutionSession) RETURNS ?ModuleImporter@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN KEEP rtoc_self_view.importer;
}
END
PUB FN resolutionSession__import_source_dir(self: ResolutionSession) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY rtoc_self_view.source_dir;
}
END
PUB FN resolutionSession__stamp_type_mut<Stamp>(self: ResolutionSession, MUTABLE node: Locatable, value: Stamp) RETURNS !Stamp
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (value == NIL) THEN
      panic("resolution stamp missing type for {}");
    END
    node.full_type = COPY CAST(value AS SyntheticTypeInput);
    &node.full_type_mut("resolution stamp");
    RETURN COPY value;
}
END
PUB FN resolutionSession__synthetic_function_definitions(self: ResolutionSession) RETURNS ![]FunctionDef
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY rtoc_self_view.function_registry.synthetic_definitions;
}
END
PUB FN resolutionSession__clear_synthetic_function_definitions_mut(MUTABLE self: ResolutionSession) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    functionRegistry__clear_synthetic_definitions_mut(rtoc_self_view.function_registry);
}
END
PUB FN resolutionSession__queue_synthetic_function_mut(MUTABLE self: ResolutionSession, node: FunctionDef) RETURNS FunctionDef
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN CAST(functionRegistry__add_synthetic_definition_mut(rtoc_self_view.function_registry, node) AS FunctionDef);
}
END
PUB FN resolutionSession__validate_type_param_list_mut(self: ResolutionSession, node: Node, type_params: []String, kind: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE seen: [Set]String@symbol = Set[];
    FOR _ IN type_params DO
    MUTABLE name = symbol(_);
    IF seen.contains?(name) THEN
        resolutionSession__error_mut(rtoc_self_view, node, ResolutionCodeOrMessage{ SymbolValue: :GENERIC_DUP_TYPE_PARAM_KIND }, [], {:param: _, :kind: kind, :name: node.name()});
    END
    IF builtin_type_parameter_names.contains?(name) THEN
        resolutionSession__error_mut(rtoc_self_view, node, ResolutionCodeOrMessage{ SymbolValue: :GENERIC_TYPE_PARAM_SHADOWS }, [], {:param: _});
    END
    IF (rtoc_self_view.local_type_declaration_names.contains?(name) OR { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_1 = resolutionSession__current_scope(rtoc_self_view);
    scope__resolve_type_entry(rtoc_local_receiver_1, name) }) THEN
        resolutionSession__error_mut(rtoc_self_view, resolutionSession__generic_param_token(rtoc_self_view, node, _), ResolutionCodeOrMessage{ SymbolValue: :GENERIC_TYPE_PARAM_SHADOWS_NOMINAL }, [], {:param: _});
    END
    &seen.insert(name);
    END
}
END
PUB FN resolutionSession__generic_param_token(self: ResolutionSession, node: Node, name: String) RETURNS ResolutionSessionReturnValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE param = node.generic_params() |> FIND (_.name() == name);
    RETURN ((IF param != NIL THEN
      param.token()
    ELSE
      NIL
    END) OR_ELSE node);
}
END
PUB FN resolutionSession__get_lifetime_path(self: ResolutionSession, node: FunctionDef) RETURNS !?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE lifetime = node.return_lifetime;
    IF ((lifetime == NIL) OR (lifetime == :wildcard)) THEN
      RETURN NIL;
    END
    MUTABLE sources: []Any = List[];
    IF lifetime IS_A []Any THEN
      sources = lifetime;
    ELSE
      sources = [CAST(lifetime AS Any)];
    END
    MUTABLE paths = sources |> SELECT:? (IF !(TRUE) THEN NIL ELSE { MUTABLE rtoc_value_block_marker = 0; MUTABLE path = TRY (scope__get_path_to_root(rtoc_self_view.root_scope, CAST(_ AS Locatable))); (IF !((path.length() == 0)) THEN
      path.join(".")
    ELSE
      NIL
    END) } END) |> WHERE _ != NIL;
    IF (paths.length() == 1) THEN
      RETURN paths.first();
    ELSE
      RETURN NIL;
    END
}
END
PUB FN resolutionSession__to_type(self: ResolutionSession, value: Value) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF value IS_A Type AS type THEN
      RETURN COPY type;
    ELSE
      RETURN TRY (type__new(castValueToTypeConstructionInput(value)));
    END
}
END
PUB FN resolutionSession__validate_union_methods_mut(MUTABLE self: ResolutionSession, node: UnionDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE requirements: []UnionMethodRequirement = COPY CAST(node.methods AS []UnionMethodRequirement);
    MUTABLE seen: [Set]String = Set[];
    FOR _ IN requirements DO
    IF seen.contains?(_.name) THEN
        resolutionSession__error_mut(rtoc_self_view, COPY _.token, ResolutionCodeOrMessage{ SymbolValue: :UNION_METHOD_DUPLICATE }, [], {:union: node.name, :method: _.name});
    END
    &seen.insert(COPY _.name);
    END
    FOR _ IN requirements DO
    TRY (resolutionSession__validate_union_method_mut(&rtoc_self_view, node, _));
    END
}
END
PRIVATE FN resolutionSession__resolved_function_names(self: ResolutionSession) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (TRY (scope__visible_entries(rtoc_self_view.root_scope))).each_with_object(List[], %(tuple_param_0, names: Tuple<String,SymbolEntry@multiowned>) -> {
    MUTABLE name = tuple_param_0._0;
    MUTABLE entry = tuple_param_0._1;
    IF symbolEntry__fn_signature(entry) THEN
      RETURN &names.append(COPY name);
    END
    NIL
    });
}
END
PRIVATE FN resolutionSession__validate_union_method_mut(MUTABLE self: ResolutionSession, node: UnionDef, requirement: UnionMethodRequirement) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE entry: ?SymbolEntry@multiowned = NIL;
    IF resolutionSession__lookup_scope_for(rtoc_self_view, requirement.name) != NIL THEN
      entry = COPY { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_2 = ((resolutionSession__lookup_scope_for(rtoc_self_view, requirement.name))?);
    scope__resolve_entry(rtoc_local_receiver_2, requirement.name) };
    END
    IF entry EXISTS AS entry_value THEN
      MUTABLE signature: ?FunctionSignature@multiowned = functionSignature__unwrap(X{ Type: COPY symbolEntry__type(entry_value) });
      IF signature EXISTS AS signature_value THEN
        resolutionSession__validate_union_method_visibility_mut(rtoc_self_view, node, requirement, signature_value);
        IF (requirement.params.length() != (TRY (functionSignature__params(signature_value))).length()) THEN
          resolutionSession__error_mut(rtoc_self_view, COPY requirement.token, ResolutionCodeOrMessage{ SymbolValue: :UNION_METHOD_WRONG_ARITY }, [], {:union: node.name, :method: requirement.name, :expected_arity: requirement.params.length(), :fn: requirement.name, :got_arity: (TRY (functionSignature__params(signature_value))).length()});
        END
        MUTABLE rtoc_idx = 0;
        WHILE rtoc_idx < requirement.params.length() DO
      MUTABLE actual: ?Param = COPY (TRY (functionSignature__params(signature_value)))[rtoc_idx];
      IF !(actual) THEN
              rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE expected_name = type__resolved((TRY (resolutionSession__to_type(rtoc_self_view, castTypeToValue(requirement.params[rtoc_idx]?.type)))));
      MUTABLE actual_name = type__resolved((TRY (resolutionSession__to_type(rtoc_self_view, castTypeToValue(actual.type)))));
      IF (((expected_name == actual_name) OR (expected_name == :Any)) OR (actual_name == :Any)) THEN
              rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      resolutionSession__error_mut(rtoc_self_view, COPY requirement.token, ResolutionCodeOrMessage{ SymbolValue: :UNION_METHOD_PARAM_TYPE }, [], {:union: node.name, :method: requirement.name, :index: (rtoc_idx + 1), :expected: expected_name, :fn: requirement.name, :got: actual_name});
    rtoc_idx = rtoc_idx + 1;
        END
        MUTABLE return_type: ?Type = COPY requirement.return_type;
        IF return_type EXISTS AS return_type_value THEN
          MUTABLE expected_return = type__resolved((TRY (resolutionSession__to_type(rtoc_self_view, castTypeToValue(return_type_value)))));
          MUTABLE actual_return = type__resolved(functionSignature__return_type(signature_value));
          IF (((expected_return == actual_return) OR (expected_return == :Any)) OR (actual_return == :Any)) THEN
            RETURN;
          END
          resolutionSession__error_mut(rtoc_self_view, COPY requirement.token, ResolutionCodeOrMessage{ SymbolValue: :UNION_METHOD_RETURN_TYPE }, [], {:union: node.name, :method: requirement.name, :expected: expected_return, :fn: requirement.name, :got: actual_return});
        ELSE
          RETURN;
        END
      ELSE
        resolutionSession__error_mut(rtoc_self_view, COPY requirement.token, ResolutionCodeOrMessage{ SymbolValue: :UNION_METHOD_MISSING }, [], {:union: node.name, :method: requirement.name, :fn: requirement.name});
        RETURN;
      END
    ELSE
      IF requirement.has_default_body THEN
        resolutionSession__queue_synthetic_function_mut(&rtoc_self_view, FunctionDef{ token: CAST(COPY COPY requirement.token AS Token), name: COPY requirement.name, params: COPY ( { MUTABLE rtoc_map_results = CAST([] AS []Param); requirement.params |> EACH { &rtoc_map_results.append(COPY unionMethodParamRequirement__to_param(_)); }; rtoc_map_results } ), captures: List[], return_type: COPY requirement.return_type, return_lifetime: NIL, body: COPY requirement.body, catch_clauses: NIL, default_catch: NIL, visibility: COPY requirement.visibility, deferred_drops: NIL, uses_frame: NIL, explicit_return_type: NIL, type_params: NIL, tail_call: NIL, requires: NIL, arrow_token: NIL, name_token: NIL, effects_decl: NIL, effects_span: NIL, max_depth_n: NIL, tight_reentrance: NIL, requires_clauses: NIL, return_type_token: NIL, pre_clauses: NIL, post_clauses: NIL, is_method: NIL, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, effect_set: NIL, inferred_effects: NIL, reentrance_kind: NIL, thunk_plan: NIL, mutual_thunk_plan: NIL, needs_rt: NIL, fn_value_ref: NIL, alloc_fault: NIL, error_fallible: NIL, uses_heap: NIL, uses_alloc: NIL, uses_rt: NIL, effects: NIL, snapshot_types: NIL, stack_tier: NIL, stack_vars_bytes: NIL, moved_guard_info: NIL, cleanup_bindings: NIL, heap_carry_return: NIL, heap_carry_return_vars: NIL, fsm_eligible: NIL, fsm_ineligible_reason: NIL, fsm_suspend_points: NIL, conformance_protocol: NIL, generic_params: List[], implementation_owner: NIL, semantic_with_blocks: List[], source_name: "" });
        RETURN;
      END
      resolutionSession__error_mut(rtoc_self_view, COPY requirement.token, ResolutionCodeOrMessage{ SymbolValue: :UNION_METHOD_MISSING }, [], {:union: node.name, :method: requirement.name, :fn: requirement.name});
      RETURN;
    END
}
END
PRIVATE FN resolutionSession__validate_union_method_visibility_mut(self: ResolutionSession, node: UnionDef, requirement: UnionMethodRequirement, signature: FunctionSignature) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (requirement.visibility == :package) THEN
      RETURN;
    END
    MUTABLE actual = (functionSignature__visibility(signature) OR_ELSE :package);
    IF (actual == requirement.visibility) THEN
      RETURN;
    END
    MUTABLE labels = {:pub: "PUB", :private: "PRIVATE", :package: "package"};
    resolutionSession__error_mut(rtoc_self_view, COPY requirement.token, ResolutionCodeOrMessage{ SymbolValue: :UNION_METHOD_WRONG_VISIBILITY }, [], {:union: node.name, :method: requirement.name, :declared_vis: UNWRAP (labels[requirement.visibility]), :fn: requirement.name, :fn_vis: UNWRAP (labels[actual])});
}
END
