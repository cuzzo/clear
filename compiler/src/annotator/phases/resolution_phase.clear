PRIVATE FN resolutionSession__fixable_mut(self: ResolutionSession, node_or_token: Any, category: String@symbol, fixes: []Fix, message: ?String = NIL, code: ?String@symbol = NIL, level: String@symbol = :warning, raise_in_collector: Bool = FALSE, kwargs: {String@symbol}Any = {}) RETURNS !Any@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rendered_message = (message OR_ELSE resolutionSession__diagnostic_message(rtoc_self_view, code?, [], kwargs));
    MUTABLE token: ?Any@multiowned = resolutionSession__diagnostic_token(rtoc_self_view, node_or_token);
    MUTABLE source_token: ?Token@multiowned = resolutionSession__source_error_token(rtoc_self_view, token);
    MUTABLE finding = TRY (fixableFinding__new(level, rendered_message, token, category, fixes));
    IF fixCollector__enabled?() THEN
      TRY (fixCollector__push(finding, (level == :error)));
      IF !(raise_in_collector) THEN
        RETURN;
      END
      resolutionSession__raise_source_error_mut(rtoc_self_view, CAST(source_token AS ?Token), rendered_message);
    END
    IF (level == :hint) OR (level == :info) OR (level == :warning) THEN
      MUTABLE loc: String = "";
      IF source_token EXISTS AS source_token_value THEN
        loc = " (line ${source_token_value.line.toString()})";
      ELSE
        loc = "";
      END
      MUTABLE tag: String = "";
      IF (level == :warning) THEN
        tag = "\x1B[33m[Warning]\x1B[0m";
      ELSE
        tag = "\x1B[36m[${(CAST(level AS String)).capitalize()}]\x1B[0m";
      END
      RETURN resolutionSession__diagnostic_output(rtoc_self_view, "${tag} ${rendered_message}${loc}");
    ELSE_IF (level == :error) THEN
      RETURN resolutionSession__raise_source_error_mut(rtoc_self_view, CAST(source_token AS ?Token), rendered_message);
    ELSE
      RETURN NIL;
    END
}
END
