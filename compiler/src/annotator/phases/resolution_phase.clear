PRIVATE FN resolutionSession__register_union_declaration(MUTABLE self: ResolutionSession, MUTABLE node: UnionDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node.type_params.any?() THEN
      TRY (resolutionSession__validate_type_param_list_mut(&rtoc_self_view, Node{ UnionDef: COPY node }, node.type_params, "union"));
    END
    IF (node.type_params.any?() AND (node.variants.values() |> ANY schemas__inline_struct?(castSchemasUnionSchemaVariantInputToSchemasUnionSchemaVariantValue(UNWRAP (_))))) THEN
      TRY (resolutionSession__error_mut(&rtoc_self_view, DiagnosticAnchor{ Locatable: Locatable{ UnionDef: COPY node } }, ResolutionCodeOrMessage{ SymbolValue: :UNION_INLINE_IN_GENERIC }));
    END
    TRY (resolutionSession__register_inline_struct_variants_mut(&rtoc_self_view, node));
    TRY (resolutionSession__declare_type_schema_mut(&rtoc_self_view, TypeDeclaration{ UnionDef: COPY node }, symbol(node.name), SchemaValue{ UnionSchemaMultiowned: COPY TRY (unionSchema__new(node.variants, TRY (resolutionSession__type_params(rtoc_self_view, node.type_params)), node.visibility)) }));
    TRY (resolutionSession__stamp_type_mut(rtoc_self_view, Locatable{ UnionDef: COPY node }, :Void));
