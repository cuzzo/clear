REQUIRE "pkg:rtoc_6173742f747970652e636c656172" AS type
REQUIRE "pkg:rtoc_6173742f646961676e6f737469635f72656769737472792e636c656172" AS diagnostic_registry
REQUIRE "pkg:rtoc_6173742f6173742e636c656172" AS ast
REQUIRE "pkg:rtoc_73656d616e7469632f6f776e6572736869705f67726170682e636c656172" AS ownership_graph
REQUIRE "pkg:rtoc_6173742f73636f70652e636c656172" AS scope
REQUIRE "pkg:rtoc_6173742f73796d626f6c5f656e7472792e636c656172" AS symbol_entry
REQUIRE "pkg:rtoc_616e6e6f7461746f722f68656c706572732f67656e657269635f616e616c797369732e636c656172" AS generic_analysis
REQUIRE "pkg:rtoc_616e6e6f7461746f722f616e6e6f7461746f722e636c656172" AS annotator
# Ruby module Annotator
# Ruby module Annotator::Domains
# Ruby module Annotator::Domains::ControlFlow
PUB UNION MatchSchema { EnumSchemaMultiowned: EnumSchema@multiowned, StructSchemaMultiowned: StructSchema@multiowned, UnionSchemaMultiowned: UnionSchema@multiowned, ResourceSchemaMultiowned: ResourceSchema@multiowned }
PUB UNION MatchPayload { FunctionType: FunctionType, TypeMultiowned: Type@multiowned, SymbolValue: String@symbol, StringValue: String, InlineStructVariantMultiowned: InlineStructVariant@multiowned, Type: Type }
PUB STRUCT BranchAnalysisResult {
  drops: ?[]DeferredDrop,
  snapshot: ?LightweightSnapshot,
  terminated: Bool
}
PUB STRUCT MatchSubjectPlan {
  expr_type: Type,
  type_name: String@symbol,
  schema: ?MatchSchema,
  enum_subject: Bool,
  union_subject: Bool,
  union_subst: {String@symbol}String@symbol
}

PUB FN matchSubjectPlan__enum?(self: MatchSubjectPlan) RETURNS Bool ->
  RETURN self.enum_subject;
END
PUB FN matchSubjectPlan__union?(self: MatchSubjectPlan) RETURNS Bool ->
  RETURN self.union_subject;
END
# End Ruby module Annotator::Domains::ControlFlow
# End Ruby module Annotator::Domains
# End Ruby module Annotator

# Ruby asks `respond_to?(:strip_layout_mut)` and then calls it. The variants that
# can answer compute it; the rest do not respond.
PUB FN matchPayload__strip_layout_mut(MUTABLE value: MatchPayload) RETURNS !?TypeCapabilities EFFECTS REENTRANT ->
  PARTIAL MATCH value START
    MatchPayload.TypeMultiowned AS MUTABLE item -> RETURN TRY (type__strip_layout_mut(&item));,
    MatchPayload.Type AS MUTABLE item -> RETURN TRY (type__strip_layout_mut(&item));,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END

# Ruby compares two payloads with `==`. Zig has no `==` for a tagged union, so
# the comparison asks the same question one variant at a time: same variant,
# equal payload.
PUB FN matchPayload__eq?(left: ?MatchPayload, right: ?MatchPayload) RETURNS !Bool EFFECTS REENTRANT ->
  IF left EXISTS AS left_value THEN
    IF right EXISTS AS right_value THEN
      PARTIAL MATCH left_value START
        MatchPayload.SymbolValue AS left_sym -> RETURN (IF right_value IS_A String@symbol AS right_sym THEN (left_sym == right_sym) ELSE FALSE END);,
        MatchPayload.StringValue AS left_str -> RETURN (IF right_value IS_A String AS right_str THEN (left_str == right_str) ELSE FALSE END);,
        MatchPayload.Type AS left_type -> RETURN (IF right_value IS_A Type AS right_type THEN TRY (type__equals?(left_type, TypeTypeInput{ Type: COPY right_type })) ELSE FALSE END);,
        MatchPayload.TypeMultiowned AS left_type_mo -> RETURN (IF right_value IS_A Type AS right_type_mo THEN TRY (type__equals?(left_type_mo, TypeTypeInput{ Type: COPY right_type_mo })) ELSE FALSE END);,
        MatchPayload.InlineStructVariantMultiowned AS left_isv -> RETURN (IF right_value IS_A InlineStructVariant AS right_isv THEN inlineStructVariant__equals?(left_isv, right_isv) ELSE FALSE END);,
        DEFAULT -> RETURN FALSE;
      END
      RETURN FALSE;
    END
    RETURN FALSE;
  END
  RETURN !(right EXISTS);
END
