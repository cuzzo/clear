REQUIRE "pkg:rtoc_6173742f747970652e636c656172" AS type
REQUIRE "pkg:rtoc_6173742f6173742e636c656172" AS ast
REQUIRE "pkg:rtoc_616e6e6f7461746f722f68656c706572732f6361706162696c69746965732e636c656172" AS capabilities
REQUIRE "pkg:rtoc_616e6e6f7461746f722f68656c706572732f756e696f6e2e636c656172" AS union
REQUIRE "pkg:rtoc_6173742f73796d626f6c5f656e7472792e636c656172" AS symbol_entry
REQUIRE "pkg:rtoc_6173742f73636f70652e636c656172" AS scope
# Ruby module Annotator
# Ruby module Annotator::Domains
# Ruby module Annotator::Domains::Variables
PUB UNION AccessPathNode { GetField: GetField, GetIndex: GetIndex, OptionalUnwrap: OptionalUnwrap, Identifier: Identifier }
# End Ruby module Annotator::Domains::Variables
# End Ruby module Annotator::Domains
# End Ruby module Annotator

# Ruby asks `respond_to?(:target)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN accessPathNode__target(value: AccessPathNode) RETURNS ?Locatable@boxed ->
  PARTIAL MATCH value START
    AccessPathNode.GetField AS item -> RETURN COPY item.target;,
    AccessPathNode.GetIndex AS item -> RETURN COPY item.target;,
    AccessPathNode.OptionalUnwrap AS item -> RETURN COPY item.target;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
