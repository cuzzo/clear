    Locatable.ProfileStmt AS item -> RETURN BgSourceWalkValue{ ProfileStmt: COPY item };,
    Locatable.StubDecl AS item -> RETURN BgSourceWalkValue{ StubDecl: COPY item };,
    Locatable.Drop AS item -> RETURN BgSourceWalkValue{ Drop: COPY item };,
    Locatable.SuppressCleanup AS item -> RETURN BgSourceWalkValue{ SuppressCleanup: COPY item };,
    Locatable.Return AS item -> RETURN BgSourceWalkValue{ Return: COPY item };,
    Locatable.ReassignCleanup AS item -> RETURN BgSourceWalkValue{ ReassignCleanup: COPY item };,
    Locatable.FieldCleanup AS item -> RETURN BgSourceWalkValue{ FieldCleanup: COPY item };,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
