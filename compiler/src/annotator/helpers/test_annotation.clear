# Ruby asks `respond_to?(:after_all)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN testContainerNode__after_all(value: TestContainerNode) RETURNS ?[][]Locatable ->
  PARTIAL MATCH value START
    TestContainerNode.TestBlock AS item -> RETURN COPY item.after_all;,
    TestContainerNode.WhenBlock AS item -> RETURN COPY item.after_all;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
