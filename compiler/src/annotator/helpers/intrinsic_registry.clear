REQUIRE "pkg:rtoc_6173742f747970652e636c656172"
REQUIRE "pkg:rtoc_616e6e6f7461746f722f68656c706572732f66756e6374696f6e5f7369676e61747572652e636c656172"
REQUIRE "pkg:rtoc_616e6e6f7461746f722f68656c706572732f66756e6374696f6e5f72657475726e2e636c656172"
REQUIRE "pkg:rtoc_616e6e6f7461746f722f68656c706572732f696e7472696e7369635f636f6e74726163742e636c656172"
REQUIRE "pkg:rtoc_6173742f7374645f6c69625f72656769737472792e636c656172"

# Ruby module IntrinsicRegistry.
#
# The Ruby version converts the registry hashes into typed signatures at
# startup. CLEAR has no dynamic value type, so that conversion happens at build
# time instead (tools/gen_intrinsic_registry_clear.rb) and this file is only
# the lookup surface over the generated tables. A registry is identified by its
# name, not by passing the hash itself around.
PUB UNION Name { StringValue: String, SymbolValue: String@symbol }

PUB FN intrinsicRegistry__name_string(name: Name) RETURNS String ->
  PARTIAL MATCH name START
    Name.StringValue AS text -> RETURN COPY text;
  END
  RETURN COPY CAST(name AS String);
END

PUB FN intrinsicRegistry__overloads(registry: String@symbol, name: String) RETURNS ![]FunctionSignature@multiowned ->
  MUTABLE table = TRY (stdLibRegistry__table(registry));
  MUTABLE found: ?[]FunctionSignature@multiowned = COPY table[name];
  IF found EXISTS AS found_value THEN
    RETURN COPY found_value;
  END
  # MAP_METHODS aliases `insert` onto `put`.
  IF ((registry == :map_methods) AND (name == "insert")) THEN
    MUTABLE aliased: ?[]FunctionSignature@multiowned = COPY table["put"];
    IF aliased EXISTS AS aliased_value THEN
      RETURN COPY aliased_value;
    END
  END
  MUTABLE empty: []FunctionSignature@multiowned = [];
  RETURN empty;
END

# Ruby: `FunctionSignature.unwrap(lookup(...))`. `unwrap` answers nil for an
# ARRAY of overloads, so a name with more than one signature has no single
# definition -- callers that want them all ask for overloads.
PUB FN intrinsicRegistry__lookup_single(registry: String@symbol, name: String) RETURNS !?FunctionSignature@multiowned ->
  MUTABLE all = TRY (intrinsicRegistry__overloads(registry, name));
  IF (all.length != 1) THEN
    RETURN NIL;
  END
  RETURN COPY UNWRAP (all[0]);
END

PUB FN intrinsicRegistry__to_return_type(rdef: FunctionReturn) RETURNS !Type ->
  IF rdef.fixed EXISTS AS fixed_type THEN
    RETURN COPY fixed_type;
  END
  RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }));
END

PUB FN intrinsicRegistry__collection_element_evidence_method?(name: Name, arity: Int64) RETURNS !Bool ->
  IF (arity != 1) THEN
    RETURN FALSE;
  END
  MUTABLE method_name = intrinsicRegistry__name_string(name);
  registries: [3]String@symbol = [:std_lib, :pool_methods, :set_methods];
  MUTABLE i: Int64 = 0;
  WHILE (i < registries.length) DO
    MUTABLE found: ?FunctionSignature@multiowned = TRY (intrinsicRegistry__lookup_single(registries[i], method_name));
    IF found EXISTS AS found_value THEN
      MUTABLE found_mutable = COPY found_value;
      IF (TRY (functionSignature__intrinsic_contract(&found_mutable))).behavior.is_method THEN
        IF TRY (functionSignature__intrinsic_collection_narrowing?(&found_mutable)) THEN
          RETURN TRUE;
        END
      END
    END
    i = (i + 1);
  END
  RETURN FALSE;
END

PUB FN intrinsicRegistry__map_pair_evidence_method?(name: Name, arity: Int64) RETURNS !Bool ->
  IF (arity != 2) THEN
    RETURN FALSE;
  END
  MUTABLE found: ?FunctionSignature@multiowned = TRY (intrinsicRegistry__lookup_single(:map_methods, intrinsicRegistry__name_string(name)));
  IF found EXISTS AS found_value THEN
    MUTABLE found_mutable = COPY found_value;
    IF !((TRY (functionSignature__intrinsic_contract(&found_mutable))).behavior.is_method) THEN
      RETURN FALSE;
    END
    RETURN (TRY (functionSignature__mutates_receiver?(&found_mutable)) AND TRY (functionSignature__takes_ownership?(&found_mutable)));
  END
  RETURN FALSE;
END

PUB FN intrinsicRegistry__collection_value_store_method?(name: Name, arity: Int64) RETURNS !Bool ->
  MUTABLE method_name = intrinsicRegistry__name_string(name);
  registries: [4]String@symbol = [:std_lib, :pool_methods, :set_methods, :map_methods];
  MUTABLE i: Int64 = 0;
  WHILE (i < registries.length) DO
    MUTABLE found: ?FunctionSignature@multiowned = TRY (intrinsicRegistry__lookup_single(registries[i], method_name));
    IF found EXISTS AS found_value THEN
      MUTABLE found_mutable = COPY found_value;
      MUTABLE declared_arity: ?Int64 = functionSignature__arity(found_mutable);
      MUTABLE param_arity = ((TRY (functionSignature__params(found_mutable))).length() - 1);
      IF (param_arity < 0) THEN
        param_arity = 0;
      END
      MUTABLE method_arity = (declared_arity OR_ELSE param_arity);
      IF (method_arity == arity) THEN
        IF (TRY (functionSignature__intrinsic_contract(&found_mutable))).behavior.is_method THEN
          IF (TRY (functionSignature__mutates_receiver?(&found_mutable)) AND TRY (functionSignature__takes_ownership?(&found_mutable))) THEN
            RETURN TRUE;
          END
        END
      END
    END
    i = (i + 1);
  END
  RETURN FALSE;
END
