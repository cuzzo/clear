REQUIRE "pkg:rtoc_616e6e6f7461746f722f68656c706572732f66756e6374696f6e5f7369676e61747572652e636c656172"
REQUIRE "pkg:rtoc_6d69722f66736d5f6f70732e636c656172"

PUB STRUCT IntrinsicEmit {
  zig: ?IntrinsicEmitStrOrSym,
  numeric_zig: ?IntrinsicEmitStrOrSym,
  sharded_zig: ?IntrinsicEmitStrOrSym,
  shard_direct_zig: ?IntrinsicEmitStrOrSym,
  fsm_setup: []Stmt,
  fsm_state_decls: []StateFieldDecl,
  fsm_finish_block: []Stmt,
  fsm_state_finalize: []Stmt,
  fsm_setup_present: Bool,
  fsm_state_decls_present: Bool,
  fsm_finish_block_present: Bool,
  fsm_state_finalize_present: Bool,
  fsm_finish_value: ?Expr,
  bc: Bool,
  is_method: Bool,
  suspends: Bool,
  narrows_collection: Bool,
  narrows_receiver_collection: Bool,
  mutates_receiver: Bool,
  allocates: Bool,
  takes_value: Bool,
  container_borrow: Bool,
  tag: ?String@symbol,
  builtin: ?String@symbol,
  alloc: ?String@symbol,
  return_alloc: ?String@symbol,
  val_alloc: ?String@symbol,
  key_alloc: ?String@symbol,
  shard_alloc: ?String@symbol,
  sharded_alloc: ?String@symbol,
  borrows: ?Borrows,
  reject_when: ?String@symbol,
  bc_op: ?String@symbol,
  error_kind: ?String@symbol,
  error_type: ?String@symbol,
  registry: ?String@symbol,
  elem: ?String,
  lifetime: []String,
  reject_error: ?String,
  arity: ?Int64,
  takes_args: []Int64,
  eql: ?IntrinsicEmit@boxed,
  strcmp: ?IntrinsicEmit@boxed,
  cleanup: ?IntrinsicEmit@boxed,
  assert: ?IntrinsicEmit@boxed,
  array: ?IntrinsicEmit@boxed,
  list: ?IntrinsicEmit@boxed,
  pool: ?IntrinsicEmit@boxed,
  set: ?IntrinsicEmit@boxed,
  get: ?IntrinsicEmit@boxed,
  string_raw: ?IntrinsicEmit@boxed,
  string_symbol: ?IntrinsicEmit@boxed,
  string_map: ?IntrinsicEmit@boxed,
  numeric_map: ?IntrinsicEmit@boxed,
  set_collection: ?IntrinsicEmit@boxed
}

PUB UNION IntrinsicEmitStrOrSym { StringValue: String, SymbolValue: String@symbol }
