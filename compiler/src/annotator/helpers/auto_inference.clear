UNION AutoInferenceWalkNode { MIRProgram: MIRProgram, RequireNode: RequireNode, ProtocolRequirement: ProtocolRequirement, ProtocolDef: ProtocolDef, FunctionDefMultiowned: FunctionDef@multiowned, ImplementationDef: ImplementationDef, ConformanceDef: ConformanceDef, MIRStructDef: MIRStructDef, VarDecl: VarDecl, Assignment: Assignment, MIRDestructureTarget: MIRDestructureTarget, DestructuringAssignment: DestructuringAssignment, BindExpr: BindExpr, BinaryOp: BinaryOp, IsA: IsA, MIRUnaryOp: MIRUnaryOp, CallSiteOverride: CallSiteOverride, Identifier: Identifier, Literal: Literal, ListLit: ListLit, TupleLit: TupleLit, DefaultArrayLit: DefaultArrayLit, HashLit: HashLit, DefaultLit: DefaultLit, StructLit: StructLit, LambdaLit: LambdaLit, IfStatement: IfStatement, IfBind: IfBind, WhileLoop: WhileLoop, WhileBindLoop: WhileBindLoop, BreakNode: BreakNode, ContinueNode: ContinueNode, FuncCall: FuncCall, MethodCall: MethodCall, MIRMethodCall: MIRMethodCall, GetField: GetField, GetIndex: GetIndex, MIRCast: MIRCast, ReturnNode: ReturnNode, Assert: Assert, Raise: Raise, ThrowNode: ThrowNode, DieNode: DieNode, Slice: Slice, Require: Require, MIRDeferStmt: MIRDeferStmt, WithBlock: WithBlock, SyncPolicyDecl: SyncPolicyDecl, SelectOpMultiowned: SelectOp@multiowned, WhereOpMultiowned: WhereOp@multiowned, IndexOpMultiowned: IndexOp@multiowned, ReduceOpMultiowned: ReduceOp@multiowned, OrderByOpMultiowned: OrderByOp@multiowned, LimitOp: LimitOp, UnnestOpMultiowned: UnnestOp@multiowned, DistinctOpMultiowned: DistinctOp@multiowned, EachOp: EachOp, TapOp: TapOp, SkipOp: SkipOp, CollectOp: CollectOp, TakeWhileOpMultiowned: TakeWhileOp@multiowned, WindowOpMultiowned: WindowOp@multiowned, BatchWindowOpMultiowned: BatchWindowOp@multiowned, JoinOp: JoinOp, FindOpMultiowned: FindOp@multiowned, AnyOpMultiowned: AnyOp@multiowned, AllOpMultiowned: AllOp@multiowned, CountOpMultiowned: CountOp@multiowned, SumOpMultiowned: SumOp@multiowned, AverageOpMultiowned: AverageOp@multiowned, MinOpMultiowned: MinOp@multiowned, MaxOpMultiowned: MaxOp@multiowned, ShardOp: ShardOp, ConcurrentOp: ConcurrentOp, Placeholder: Placeholder, Copy: Copy, MIROptionalUnwrap: MIROptionalUnwrap, TenseNavigation: TenseNavigation, MutableBorrow: MutableBorrow, OrElseRaise: OrElseRaise, OrElseExit: OrElseExit, OrElsePass: OrElsePass, OrElsePrune: OrElsePrune, OrElseBreak: OrElseBreak, CatchBlock: CatchBlock, RecoverOp: RecoverOp, MIRBlockExpr: MIRBlockExpr, StringConcat: StringConcat, CapabilityWrap: CapabilityWrap, MoveNode: MoveNode, CopyNode: CopyNode, KeepNode: KeepNode, ShareNode: ShareNode, LinkNode: LinkNode, ResolveNode: ResolveNode, FreezeNode: FreezeNode, PassStmt: PassStmt, StructPattern: StructPattern, MIRRangeLit: MIRRangeLit, ExternFnDecl: ExternFnDecl, ExternStructDecl: ExternStructDecl, MIREnumDef: MIREnumDef, UnionDef: UnionDef, UnionVariantLit: UnionVariantLit, StaticCall: StaticCall, MIRDoBlock: MIRDoBlock, MIRBgBlock: MIRBgBlock, ThenChain: ThenChain, BgStreamBlock: BgStreamBlock, YieldExpr: YieldExpr, CloseStream: CloseStream, NextExpr: NextExpr, MatchStatement: MatchStatement, ForRange: ForRange, ForEach: ForEach, TestBlock: TestBlock, WhenBlock: WhenBlock, LetBinding: LetBinding, TestThat: TestThat, AssertRaisesMultiowned: AssertRaises@multiowned, BenchmarkStmtMultiowned: BenchmarkStmt@multiowned, SmashStmtMultiowned: SmashStmt@multiowned, ProfileStmtMultiowned: ProfileStmt@multiowned, StubDecl: StubDecl, Drop: Drop, SuppressCleanup: SuppressCleanup, Return: Return, ReassignCleanup: ReassignCleanup, FieldCleanup: FieldCleanup, ArrayValue: []Node, EnumSchemaMultiowned: EnumSchema@multiowned, InlineStructVariantMultiowned: InlineStructVariant@multiowned, ResourceSchemaMultiowned: ResourceSchema@multiowned, StructSchemaMultiowned: StructSchema@multiowned, UnionSchemaMultiowned: UnionSchema@multiowned, ScopeMultiowned: Scope@multiowned, SymbolEntryMultiowned: SymbolEntry@multiowned, SymbolValue: String@symbol, StringValue: String, Float64Value: Float64, BoolValue: Bool, TokenMultiowned: Token@multiowned, TypeMultiowned: Type@multiowned, AnyMultiowned: Any@multiowned, FunctionDef: FunctionDef, SelectOp: SelectOp, WhereOp: WhereOp, IndexOp: IndexOp, ReduceOp: ReduceOp, OrderByOp: OrderByOp, UnnestOp: UnnestOp, DistinctOp: DistinctOp, TakeWhileOp: TakeWhileOp, WindowOp: WindowOp, BatchWindowOp: BatchWindowOp, FindOp: FindOp, AnyOp: AnyOp, AllOp: AllOp, CountOp: CountOp, SumOp: SumOp, AverageOp: AverageOp, MinOp: MinOp, MaxOp: MaxOp, AssertRaises: AssertRaises, BenchmarkStmt: BenchmarkStmt, SmashStmt: SmashStmt, ProfileStmt: ProfileStmt, Token: Token, Type: Type }
UNION AutoInferenceDeclBlockParam1 { BindExpr: BindExpr, VarDecl: VarDecl }
PUB STRUCT AutoSlotId {
  decl_id: ?Int64,
  fn_name: ?String,
  index: ?Int64,
  kind: String@symbol
}

FN autoSlotId__initialize(MUTABLE self: AutoSlotId, kind: String@symbol, fn_name: ?String = NIL, index_value: ?Int64 = NIL, decl_id: ?Int64 = NIL) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.kind = COPY kind;
    rtoc_self_view.fn_name = COPY fn_name;
    rtoc_self_view.index = COPY index_value;
    rtoc_self_view.decl_id = COPY decl_id;
}
END
PUB FN autoSlotId__param(fn_name: String, index_value: Int64) RETURNS AutoSlotId@multiowned ->
  RETURN autoSlotId__new(:param, fn_name, index_value);
END
PUB FN autoSlotId__return(fn_name: String) RETURNS AutoSlotId@multiowned ->
  RETURN autoSlotId__new(:return, fn_name);
END
PUB FN autoSlotId__local(decl_node: Locatable) RETURNS AutoSlotId@multiowned ->
  RETURN autoSlotId__new(:local, NIL, NIL, aST__node_identity(decl_node));
END
FN autoSlotId__list_element(decl_node: Locatable) RETURNS AutoSlotId@multiowned ->
  RETURN autoSlotId__new(:list_element, NIL, NIL, aST__node_identity(decl_node));
END
FN autoSlotId__map_key(decl_node: Locatable) RETURNS AutoSlotId@multiowned ->
  RETURN autoSlotId__new(:map_key, NIL, NIL, aST__node_identity(decl_node));
END
FN autoSlotId__map_value(decl_node: Locatable) RETURNS AutoSlotId@multiowned ->
  RETURN autoSlotId__new(:map_value, NIL, NIL, aST__node_identity(decl_node));
END
FN autoSlotId__hash(self: AutoSlotId) RETURNS Int64
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE combined: Int64 = (CAST(rtoc_self_view.kind AS String)).length();
    IF rtoc_self_view.fn_name EXISTS AS fn_name_value THEN
      combined = ((combined * 31) + fn_name_value.length());
    END
    IF rtoc_self_view.index EXISTS AS index_value THEN
      combined = ((combined * 31) + index_value);
    END
    IF rtoc_self_view.decl_id EXISTS AS decl_id_value THEN
      combined = ((combined * 31) + decl_id_value);
    END
    RETURN combined;
}
END
FN autoSlotId__eql?(self: AutoSlotId, other: AutoSlotId) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(TRUE) THEN
      RETURN FALSE;
    END
    RETURN ((((rtoc_self_view.kind == other.kind) AND (rtoc_self_view.fn_name == other.fn_name)) AND (rtoc_self_view.index == other.index)) AND (rtoc_self_view.decl_id == other.decl_id));
}
END
FN autoSlotId__equals?(self: AutoSlotId, other: AutoSlotId) RETURNS Bool ->
  autoSlotId__eql?(self, other);
END
FN autoSlotId__new(kind: String@symbol, fn_name: ?String = NIL, index: ?Int64 = NIL, decl_id: ?Int64 = NIL) RETURNS AutoSlotId@multiowned ->
  MUTABLE self = AutoSlotId{ decl_id: decl_id, fn_name: COPY fn_name, index: index, kind: COPY kind };
  autoSlotId__initialize(&self, kind, fn_name, index, decl_id);
  RETURN self @multiowned;
END
STRUCT AutoMapShapeEntry {
  key: AutoSlotId@multiowned,
  value: AutoSlotId@multiowned
}

FN autoMapShapeEntry__initialize(MUTABLE self: AutoMapShapeEntry, key: AutoSlotId, value: AutoSlotId) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.key = COPY key;
    rtoc_self_view.value = COPY value;
}
END
FN autoMapShapeEntry__new(key: AutoSlotId, value: AutoSlotId) RETURNS AutoMapShapeEntry@multiowned ->
  MUTABLE self = AutoMapShapeEntry{ key: COPY key, value: COPY value };
  autoMapShapeEntry__initialize(&self, key, value);
  RETURN self @multiowned;
END
STRUCT AutoConstraintCollector {
  fn_nodes: {String}FunctionDef@multiowned,
  local_decls: {String}AutoConstraintCollectorLocalDeclEntry,
  slots: {AutoSlotId}Slot@multiowned
}

PUB UNION AutoConstraintCollectorDeclarationNode { VarDecl: VarDecl, BindExpr: BindExpr }
PUB UNION AutoConstraintCollectorSlotDeclNode { FunctionDefMultiowned: FunctionDef@multiowned, VarDecl: VarDecl, BindExpr: BindExpr, FunctionDef: FunctionDef }
PUB UNION AutoConstraintCollectorObservedType { TypeMultiowned: Type@multiowned, SymbolValue: String@symbol, Type: Type }
UNION AutoConstraintCollectorLocalDeclEntry { AutoSlotIdMultiowned: AutoSlotId@multiowned, AutoMapShapeEntryMultiowned: AutoMapShapeEntry@multiowned }
PUB STRUCT Slot {
  kind: String@symbol,
  fn_name: ?String,
  index: ?Int64,
  decl_node: AutoConstraintCollectorSlotDeclNode,
  sources: []Locatable,
  shape: ?String@symbol,
  auto_token: ?Token,
  resolved_scalar: ?Type
}
FN autoConstraintCollector__initialize(MUTABLE self: AutoConstraintCollector, fn_nodes: {String}FunctionDef) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.fn_nodes = COPY fn_nodes;
    rtoc_self_view.slots = {};
    rtoc_self_view.local_decls = {};
}
END
FN autoConstraintCollector__collect_mut(MUTABLE self: AutoConstraintCollector, program_node: Program) RETURNS !{AutoSlotId@multiowned}Slot@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    TRY (autoConstraintCollector__register_signature_slots(&rtoc_self_view));
    autoConstraintCollector__walk(&rtoc_self_view, castProgramToOptionalAutoInferenceWalkNode(program_node), NIL);
    RETURN COPY rtoc_self_view.slots;
}
END
PRIVATE FN autoConstraintCollector__register_signature_slots(MUTABLE self: AutoConstraintCollector) RETURNS !{AutoSlotId@multiowned}Slot@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    FOR rtoc_each_3 IN rtoc_self_view.fn_nodes.keys() DO
    MUTABLE fn_value: FunctionDef@multiowned = (rtoc_self_view.fn_nodes[rtoc_each_3] OR_ELSE CAST(panic("missing hash key") AS FunctionDef@multiowned));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < fn_value.params.length() DO
        IF !(autoConstraintCollector__auto?(rtoc_self_view, param__type(fn_value.params[rtoc_idx]?))) THEN
          rtoc_idx = rtoc_idx + 1;
      CONTINUE;
        END
        rtoc_self_view.slots[autoSlotId__param(rtoc_each_3, rtoc_idx)] = COPY Slot{ kind: :param, fn_name: COPY rtoc_each_3, index: rtoc_idx, decl_node: AutoConstraintCollectorSlotDeclNode{ FunctionDefMultiowned: COPY fn_value }, sources: ( { MUTABLE rtoc_empty_list_1: []Locatable = List[]; rtoc_empty_list_1 } ), auto_token: KEEP param__type(fn_value.params[rtoc_idx]?).auto_token, shape: NIL, resolved_scalar: NIL } @multiowned;
      rtoc_idx = rtoc_idx + 1;
    END
    IF autoConstraintCollector__auto?(rtoc_self_view, fn_value.return_type) THEN
        rtoc_self_view.slots[autoSlotId__return(rtoc_each_3)] = COPY Slot{ kind: :return, fn_name: COPY rtoc_each_3, index: NIL, decl_node: AutoConstraintCollectorSlotDeclNode{ FunctionDefMultiowned: COPY fn_value }, sources: ( { MUTABLE rtoc_empty_list_2: []Locatable = List[]; rtoc_empty_list_2 } ), auto_token: KEEP (fn_value.return_type?).auto_token, shape: NIL, resolved_scalar: NIL } @multiowned;
    END
        END
    RETURN COPY rtoc_self_view.slots;
}
END
PRIVATE FN autoConstraintCollector__auto?(self: AutoConstraintCollector, t: ?Type) RETURNS Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF t EXISTS AS t_value THEN
      RETURN type__auto?(t_value);
    END
    RETURN FALSE;
}
END
PRIVATE FN autoConstraintCollector__walk(MUTABLE self: AutoConstraintCollector, node: ?AutoInferenceWalkNode, current_fn: ?FunctionDef) RETURNS Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node EXISTS AS node_value THEN
      MUTABLE node_value_mutable = COPY node_value;
      IF node_value_mutable IS_A String@symbol AS string_symbol THEN
    
      ELSE_IF node_value_mutable IS_A String AS string THEN
    
      ELSE_IF node_value_mutable IS_A Float64 AS float64 THEN
    
      ELSE_IF node_value_mutable IS_A Bool AS bool THEN
    
      ELSE_IF node_value_mutable IS_A Bool AS bool THEN
    
      ELSE_IF node_value_mutable IS_A Token@multiowned AS token_multiowned THEN
    
      ELSE_IF node_value_mutable IS_A Type@multiowned AS type_multiowned THEN
    
      ELSE_IF node_value_mutable IS_A SymbolEntry@multiowned AS symbol_entry_multiowned THEN
    
      ELSE_IF node_value_mutable IS_A Scope@multiowned AS scope_multiowned THEN
    
      ELSE_IF node_value_mutable IS_A EnumSchema@multiowned AS enum_schema_multiowned THEN
    
      ELSE_IF node_value_mutable IS_A InlineStructVariant@multiowned AS inline_struct_variant_multiowned THEN
    
      ELSE_IF node_value_mutable IS_A ResourceSchema@multiowned AS resource_schema_multiowned THEN
    
      ELSE_IF node_value_mutable IS_A StructSchema@multiowned AS struct_schema_multiowned THEN
    
      ELSE_IF node_value_mutable IS_A UnionSchema@multiowned AS union_schema_multiowned THEN
    
      ELSE_IF node_value_mutable IS_A []Node AS array_value THEN
        FOR rtoc_array_item IN array_value DO
        autoConstraintCollector__walk(&rtoc_self_view, castNodeToOptionalAutoInferenceWalkNode(rtoc_array_item), current_fn);
        END
      ELSE
        autoConstraintCollector__record_constraint(&rtoc_self_view, node_value_mutable, current_fn);
        MUTABLE next_fn: ?FunctionDef = COPY current_fn;
        IF node_value_mutable IS_A FunctionDef AS next_function_def THEN
          next_fn = COPY next_function_def;
        END
        MUTABLE saved_local_decls: {String}AutoConstraintCollectorLocalDeclEntry = {};
        IF node_value_mutable IS_A FunctionDef AS function_def THEN
          saved_local_decls = COPY rtoc_self_view.local_decls;
          rtoc_self_view.local_decls = {};
        END
        FOR rtoc_walk_child_5 IN rtocChildrenAutoInferenceWalkNode(node_value_mutable) DO
        autoConstraintCollector__walk(&rtoc_self_view, rtoc_walk_child_5, next_fn);
        END
        IF node_value_mutable IS_A FunctionDef AS function_def THEN
          rtoc_self_view.local_decls = saved_local_decls;
        END
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN autoConstraintCollector__record_constraint(MUTABLE self: AutoConstraintCollector, node: ?AutoInferenceWalkNode, current_fn: ?FunctionDef) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node EXISTS AS node_value THEN
      IF node_value IS_A FuncCall AS func_call THEN
        autoConstraintCollector__record_call_site(rtoc_self_view, func_call);
      ELSE_IF node_value IS_A ReturnNode AS return_node THEN
        IF current_fn EXISTS AS current_fn_value THEN
          autoConstraintCollector__record_return(rtoc_self_view, return_node, current_fn_value);
        END
      ELSE_IF node_value IS_A BindExpr AS bind_expr THEN
        MUTABLE bind_expr_mutable = COPY bind_expr;
        autoConstraintCollector__record_local(&rtoc_self_view, AutoConstraintCollectorDeclarationNode{ BindExpr: COPY bind_expr_mutable });
      ELSE_IF node_value IS_A VarDecl AS var_decl THEN
        MUTABLE var_decl_mutable = COPY var_decl;
        autoConstraintCollector__record_local(&rtoc_self_view, AutoConstraintCollectorDeclarationNode{ VarDecl: COPY var_decl_mutable });
      END
    END
}
END
PRIVATE FN autoConstraintCollector__record_call_site(self: AutoConstraintCollector, call_node: FuncCall) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE callee_name: String = "";
    IF call_node.name IS_A String AS call_name_text THEN
      callee_name = COPY call_name_text;
    END
    MUTABLE callee: ?FunctionDef@multiowned = COPY rtoc_self_view.fn_nodes[callee_name];
    IF callee EXISTS AS callee_value THEN
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < callee_value.params.length() DO
      IF !(autoConstraintCollector__auto?(rtoc_self_view, callee_value.params[rtoc_idx]?.type)) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE arg: ?Locatable = NIL;
      IF (rtoc_idx < call_node.args.length()) THEN
        arg = COPY call_node.args[rtoc_idx];
      END
      IF arg EXISTS AS arg_value THEN
        MUTABLE slot: ?Slot@multiowned = COPY rtoc_self_view.slots[autoSlotId__param(callee_value.name, rtoc_idx)];
        IF slot EXISTS AS slot_value THEN
          MUTABLE slot_mutable = KEEP slot_value;
          &slot_mutable.sources.append(COPY arg_value);
        END
      END
    rtoc_idx = rtoc_idx + 1;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN autoConstraintCollector__record_return(self: AutoConstraintCollector, return_node: ReturnNode, current_fn: FunctionDef) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((TRUE AND autoConstraintCollector__auto?(rtoc_self_view, current_fn.return_type))) THEN
      RETURN;
    END
    IF !(return_node.value) THEN
      RETURN;
    END
    MUTABLE slot: ?Slot@multiowned = COPY rtoc_self_view.slots[autoSlotId__return(current_fn.name)];
    IF slot EXISTS AS slot_value THEN
      MUTABLE return_slot = KEEP slot_value;
      &return_slot.sources.append(COPY return_node.value);
    END
}
END
FN declNodeType(decl_node: AutoConstraintCollectorDeclarationNode) RETURNS ?Type ->
  PARTIAL MATCH decl_node START
    AutoConstraintCollectorDeclarationNode.VarDecl AS item -> RETURN COPY item.type;,
    AutoConstraintCollectorDeclarationNode.BindExpr AS item -> RETURN COPY item.type;
  END
  RETURN NIL;
END
FN declNodeValue(decl_node: AutoConstraintCollectorDeclarationNode) RETURNS Locatable ->
  PARTIAL MATCH decl_node START
    AutoConstraintCollectorDeclarationNode.VarDecl AS item -> RETURN COPY item.value;,
    AutoConstraintCollectorDeclarationNode.BindExpr AS item -> RETURN COPY item.value;
  END
  RETURN CAST(panic("declaration node has no value") AS Locatable);
END
FN declNodeAutoToken(decl_node: AutoConstraintCollectorDeclarationNode) RETURNS ?Token ->
  IF declNodeType(decl_node) EXISTS AS decl_type THEN
    RETURN COPY decl_type.auto_token;
  END
  RETURN NIL;
END
FN declNodeName(decl_node: AutoConstraintCollectorDeclarationNode) RETURNS String ->
  PARTIAL MATCH decl_node START
    AutoConstraintCollectorDeclarationNode.VarDecl AS item -> RETURN COPY item.name;,
    AutoConstraintCollectorDeclarationNode.BindExpr AS item -> RETURN COPY item.name;
  END
  RETURN "";
END
PRIVATE FN autoConstraintCollector__record_local(MUTABLE self: AutoConstraintCollector, decl_node: AutoConstraintCollectorDeclarationNode) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF autoConstraintCollector__auto?(rtoc_self_view, declNodeType(decl_node)) THEN
      IF autoConstraintCollector__empty_list_lit?(rtoc_self_view, declNodeValue(decl_node)) THEN
        autoConstraintCollector__register_list_shape_slot(&rtoc_self_view, decl_node);
        RETURN;
      ELSE_IF autoConstraintCollector__empty_hash_lit?(rtoc_self_view, declNodeValue(decl_node)) THEN
        autoConstraintCollector__register_map_shape_slots(&rtoc_self_view, decl_node);
        RETURN;
      END
      MUTABLE slot_id = autoSlotId__local(castAutoConstraintCollectorDeclarationNodeToLocatable(decl_node));
      rtoc_self_view.slots[slot_id] = (rtoc_self_view.slots[slot_id] OR_ELSE Slot{ kind: :local, fn_name: NIL, index: NIL, decl_node: castAutoConstraintCollectorDeclarationNodeToAutoConstraintCollectorSlotDeclNode(COPY decl_node), sources: ( { MUTABLE rtoc_empty_list_6: []Locatable = List[]; rtoc_empty_list_6 } ), shape: NIL, auto_token: declNodeAutoToken(decl_node), resolved_scalar: NIL } @multiowned);
      IF declNodeValue(decl_node) THEN
        IF rtoc_self_view.slots[slot_id] EXISTS AS rtoc_map_slot_7 THEN
          MUTABLE local_slot = KEEP rtoc_map_slot_7;
          &local_slot.sources.append(declNodeValue(decl_node));
        ELSE
          panic("T.must: map slot is NIL");
        END
      END
      rtoc_self_view.local_decls[declNodeName(decl_node)] = AutoConstraintCollectorLocalDeclEntry{ AutoSlotIdMultiowned: COPY slot_id };
    ELSE_IF (FALSE AND TRUE) THEN
      MUTABLE entry: ?AutoConstraintCollectorLocalDeclEntry = COPY rtoc_self_view.local_decls[declNodeName(decl_node)];
      IF entry EXISTS AS entry_value THEN
        autoConstraintCollector__record_reassignment_sources(rtoc_self_view, entry_value, declNodeValue(decl_node));
      ELSE
        RETURN;
      END
    END
}
END
PRIVATE FN autoConstraintCollector__record_reassignment_sources(self: AutoConstraintCollector, entry: AutoConstraintCollectorLocalDeclEntry, rhs: ?Locatable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF rhs EXISTS AS rhs_value THEN
      IF entry IS_A AutoMapShapeEntry AS auto_map_shape_entry THEN
        IF rhs_value IS_A HashLit AS hash_lit THEN
          MUTABLE key_slot = KEEP UNWRAP (rtoc_self_view.slots[KEEP auto_map_shape_entry.key]);
          MUTABLE val_slot = KEEP UNWRAP (rtoc_self_view.slots[KEEP auto_map_shape_entry.value]);
          hash_lit.pairs |> EACH {
    pair_key, pair_value = _;
    &key_slot.sources.append(COPY pair_key);
    &val_slot.sources.append(COPY pair_value);
          };
          RETURN;
        ELSE
          RETURN;
        END
      END
      MUTABLE slot = KEEP UNWRAP (rtoc_self_view.slots[castAutoConstraintCollectorLocalDeclEntryToAutoSlotIdMultiowned(entry)]);
      IF (slot.shape == :list_element) THEN
        IF rhs_value IS_A ListLit AS list_lit THEN
          FOR rtoc_item IN list_lit.items DO
          &slot.sources.append(COPY rtoc_item);
          END
        END
      ELSE_IF (slot.shape == NIL) THEN
        &slot.sources.append(COPY rhs_value);
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN autoConstraintCollector__empty_list_lit?(self: AutoConstraintCollector, node: ?Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node EXISTS AS node_value THEN
      IF node_value IS_A ListLit AS list_lit THEN
        RETURN (list_lit.items.empty?() AND (list_lit.constructor_options == NIL));
      END
    END
    RETURN FALSE;
}
END
PRIVATE FN autoConstraintCollector__empty_hash_lit?(self: AutoConstraintCollector, node: ?Locatable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node EXISTS AS node_value THEN
      IF node_value IS_A HashLit AS hash_lit THEN
        RETURN (hash_lit.pairs.length() == 0);
      END
    END
    RETURN FALSE;
}
END
PRIVATE FN autoConstraintCollector__register_list_shape_slot(MUTABLE self: AutoConstraintCollector, decl_node: AutoConstraintCollectorDeclarationNode) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE slot_id = autoSlotId__list_element(castAutoConstraintCollectorDeclarationNodeToLocatable(decl_node));
    rtoc_self_view.slots[slot_id] = (rtoc_self_view.slots[slot_id] OR_ELSE Slot{ kind: :local, fn_name: NIL, index: NIL, decl_node: castAutoConstraintCollectorDeclarationNodeToAutoConstraintCollectorSlotDeclNode(COPY decl_node), sources: ( { MUTABLE rtoc_empty_list_8: []Locatable = List[]; rtoc_empty_list_8 } ), shape: :list_element, auto_token: declNodeAutoToken(decl_node), resolved_scalar: NIL } @multiowned);
    rtoc_self_view.local_decls[declNodeName(decl_node)] = AutoConstraintCollectorLocalDeclEntry{ AutoSlotIdMultiowned: COPY slot_id };
}
END
PRIVATE FN autoConstraintCollector__register_map_shape_slots(MUTABLE self: AutoConstraintCollector, decl_node: AutoConstraintCollectorDeclarationNode) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE key_id = autoSlotId__map_key(castAutoConstraintCollectorDeclarationNodeToLocatable(decl_node));
    MUTABLE val_id = autoSlotId__map_value(castAutoConstraintCollectorDeclarationNodeToLocatable(decl_node));
    MUTABLE auto_tok: ?Token = declNodeAutoToken(decl_node);
    rtoc_self_view.slots[key_id] = (rtoc_self_view.slots[key_id] OR_ELSE Slot{ kind: :local, fn_name: NIL, index: NIL, decl_node: castAutoConstraintCollectorDeclarationNodeToAutoConstraintCollectorSlotDeclNode(COPY decl_node), sources: ( { MUTABLE rtoc_empty_list_9: []Locatable = List[]; rtoc_empty_list_9 } ), shape: :map_key, auto_token: auto_tok, resolved_scalar: NIL } @multiowned);
    rtoc_self_view.slots[val_id] = (rtoc_self_view.slots[val_id] OR_ELSE Slot{ kind: :local, fn_name: NIL, index: NIL, decl_node: castAutoConstraintCollectorDeclarationNodeToAutoConstraintCollectorSlotDeclNode(COPY decl_node), sources: ( { MUTABLE rtoc_empty_list_10: []Locatable = List[]; rtoc_empty_list_10 } ), shape: :map_value, auto_token: auto_tok, resolved_scalar: NIL } @multiowned);
    rtoc_self_view.local_decls[declNodeName(decl_node)] = AutoConstraintCollectorLocalDeclEntry{ AutoMapShapeEntryMultiowned: COPY autoMapShapeEntry__new(key_id, val_id) };
}
END
FN autoConstraintCollector__new(fn_nodes: {String}FunctionDef) RETURNS AutoConstraintCollector@multiowned ->
  MUTABLE self = AutoConstraintCollector{ fn_nodes: COPY fn_nodes, local_decls: {}, slots: {} };
  autoConstraintCollector__initialize(&self, fn_nodes);
  RETURN self @multiowned;
END
STRUCT AutoShapeSlots {
  key: ?Slot,
  list: ?Slot,
