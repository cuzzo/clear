FN rtocChildrenOfAutoInferenceWalkNodeIfStatement(v: IfStatement) RETURNS []AutoInferenceWalkNode ->
  MUTABLE out: []AutoInferenceWalkNode = [];
  &out.append(AutoInferenceWalkNode{ TokenMultiowned: COPY v.token });
  &out.append(castLocatableToAutoInferenceWalkNode(COPY v.condition));
  FOR rtoc_arr_child IN v.then_branch DO
    &out.append(castLocatableToAutoInferenceWalkNode(COPY rtoc_arr_child));
  END
  IF v.else_branch EXISTS AS rtoc_opt_child THEN
    FOR rtoc_arr_child IN rtoc_opt_child DO
      &out.append(castLocatableToAutoInferenceWalkNode(COPY rtoc_arr_child));
    END
