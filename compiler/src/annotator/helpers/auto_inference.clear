    rtoc_self_view.list = COPY list;
    rtoc_self_view.key = COPY key;
    rtoc_self_view.value = COPY value;
}
END
FN autoShapeSlots__new(list: ?Slot, key: ?Slot, value: ?Slot) RETURNS AutoShapeSlots@multiowned ->
  MUTABLE self = AutoShapeSlots{ key: COPY key, list: COPY list, value: COPY value };
  autoShapeSlots__initialize(&self, list, key, value);
  RETURN self @multiowned;
END
STRUCT AutoUnifier {
  slots: {AutoSlotId@multiowned}Slot@multiowned,
  type_of: FN(Locatable) -> ?AutoConstraintCollectorObservedType
}

PUB STRUCT Resolution {
  slot: Slot,
  type: AutoConstraintCollectorObservedType,
  sources: []Locatable
}
PUB STRUCT Ambiguity {
  slot: Slot,
  observed_types: []AutoConstraintCollectorObservedType,
  sources: []Locatable
}
STRUCT MapPairResolution {
  key: ?Resolution,
  value: ?Resolution
}

FN mapPairResolution__initialize(MUTABLE self: MapPairResolution) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.key = NIL;
    rtoc_self_view.value = NIL;
}
END
FN mapPairResolution__new() RETURNS MapPairResolution@multiowned ->
  MUTABLE self = MapPairResolution{ key: NIL, value: NIL };
  mapPairResolution__initialize(&self);
  RETURN self @multiowned;
END
PUB STRUCT Result {
  resolved: {AutoSlotId@multiowned}Resolution,
  ambiguous: {AutoSlotId@multiowned}Ambiguity,
  unresolved: {AutoSlotId@multiowned}Slot@multiowned
}
FN autoUnifier__default_type_of(node: Locatable) RETURNS ?AutoConstraintCollectorObservedType EFFECTS REENTRANT ->
  RETURN AutoConstraintCollectorObservedType{ Type: TRY (aST__full_type_mut(node)) };
CATCH Transient, Input, System, NotFound, Permission, Canceled
  RETURN NIL;
END
FN autoUnifier__initialize(MUTABLE self: AutoUnifier, slots: {AutoSlotId@multiowned}Slot@multiowned, type_of: ?FN(Locatable) -> ?AutoConstraintCollectorObservedType = NIL) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.slots = COPY slots;
    rtoc_self_view.type_of = (type_of OR_ELSE autoUnifier__default_type_of);
}
END
FN autoUnifier__resolve_mut(self: AutoUnifier) RETURNS !Result
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE resolved: {AutoSlotId@multiowned}Resolution = {};
    MUTABLE ambiguous: {AutoSlotId@multiowned}Ambiguity = {};
    MUTABLE progress: Bool = TRUE;
    WHILE progress DO
      progress = FALSE;
      FOR rtoc_each_4 IN rtoc_self_view.slots.keys() DO
    MUTABLE slot: Slot@multiowned = (rtoc_self_view.slots[rtoc_each_4] OR_ELSE CAST(panic("missing hash key") AS Slot));
    IF (resolved.contains?(rtoc_each_4) OR ambiguous.contains?(rtoc_each_4)) THEN
      CONTINUE;
    END
    MUTABLE observed = TRY (autoUnifier__collect_observed_types(rtoc_self_view, slot));
    IF (observed.length() == 1) THEN
          MUTABLE type = COPY UNWRAP (observed.first());
          TRY (autoUnifier__stamp_slot_mut(rtoc_self_view, &slot, type));
          resolved[rtoc_each_4] = Resolution{ slot: COPY slot, type: COPY type, sources: COPY slot.sources };
          progress = TRUE;
    ELSE_IF (observed.length() == 0) THEN
  
    ELSE
          ambiguous[rtoc_each_4] = Ambiguity{ slot: COPY slot, observed_types: COPY observed, sources: COPY slot.sources };
          progress = TRUE;
    END
            END
    END
    MUTABLE unresolved: {AutoSlotId@multiowned}Slot@multiowned = {};
    FOR rtoc_slot_key IN rtoc_self_view.slots.keys() DO
      IF (resolved.contains?(rtoc_slot_key) OR ambiguous.contains?(rtoc_slot_key)) THEN
        CONTINUE;
      END
      MUTABLE slot: Slot@multiowned = (rtoc_self_view.slots[rtoc_slot_key] OR_ELSE CAST(panic("missing hash key") AS Slot));
      unresolved[rtoc_slot_key] = KEEP slot;
    END
    RETURN Result{ resolved: COPY resolved, ambiguous: COPY ambiguous, unresolved: COPY unresolved };
}
END
PRIVATE FN autoUnifier__collect_observed_types(self: AutoUnifier, slot: Slot) RETURNS ![]AutoConstraintCollectorObservedType
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE seen: []AutoConstraintCollectorObservedType = ( { MUTABLE rtoc_empty_list_11: []AutoConstraintCollectorObservedType = List[]; rtoc_empty_list_11 } );
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < slot.sources.length() DO
      MUTABLE type_of_fn = rtoc_self_view.type_of;
      MUTABLE t: ?AutoConstraintCollectorObservedType = type_of_fn(UNWRAP (slot.sources[rtoc_idx]));
      IF (t == NIL) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF (IF t? IS_A Type AS type THEN type__auto?(type) ELSE FALSE END) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      t = autoUnifier__widen_byte_array_to_string(rtoc_self_view, UNWRAP (t));
      IF seen |> ANY autoUnifier__types_equal?(rtoc_self_view, _, UNWRAP (t)) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      &seen.append(UNWRAP (t));
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN seen;
}
END
PRIVATE FN autoUnifier__widen_byte_array_to_string(self: AutoUnifier, t: AutoConstraintCollectorObservedType) RETURNS AutoConstraintCollectorObservedType
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE sym_branch_value: ?AutoConstraintCollectorObservedType = NIL;
    IF t IS_A Type AS type THEN
      sym_branch_value = AutoConstraintCollectorObservedType{ SymbolValue: COPY type__resolved(type) };
    ELSE
      sym_branch_value = COPY t;
    END
    MUTABLE sym: AutoConstraintCollectorObservedType = sym_branch_value?;
    IF ((IF sym IS_A String@symbol AS string_symbol THEN (CAST(string_symbol AS String)).startsWith?("Byte[") ELSE FALSE END) AND (CAST(sym AS String)).endsWith?("]")) THEN
      RETURN AutoConstraintCollectorObservedType{ SymbolValue: :String };
    END
    RETURN COPY t;
}
END
PRIVATE FN autoUnifier__types_equal?(self: AutoUnifier, a: AutoConstraintCollectorObservedType, b: AutoConstraintCollectorObservedType) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (a == b) THEN
      RETURN TRUE;
    END
    IF !((a IS_A Type OR b IS_A Type)) THEN
      RETURN FALSE;
    END
    MUTABLE a_sym_branch_value: ?AutoConstraintCollectorObservedType = NIL;
    IF a IS_A Type AS type THEN
      a_sym_branch_value = AutoConstraintCollectorObservedType{ SymbolValue: COPY type__resolved(type) };
    ELSE
      a_sym_branch_value = COPY a;
    END
    MUTABLE a_sym: AutoConstraintCollectorObservedType = a_sym_branch_value?;
    MUTABLE b_sym_branch_value: ?AutoConstraintCollectorObservedType = NIL;
    IF b IS_A Type AS type THEN
      b_sym_branch_value = AutoConstraintCollectorObservedType{ SymbolValue: COPY type__resolved(type) };
    ELSE
      b_sym_branch_value = COPY b;
    END
    MUTABLE b_sym: AutoConstraintCollectorObservedType = b_sym_branch_value?;
    RETURN (a_sym == b_sym);
}
END
PRIVATE FN autoUnifier__stamp_slot_mut(self: AutoUnifier, MUTABLE slot: Slot, type: AutoConstraintCollectorObservedType) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE resolved_branch: ?Type = NIL;
    IF type IS_A Type AS observed_type_value THEN
      resolved_branch = COPY observed_type_value;
    ELSE
      resolved_branch = TRY (type__new(castAutoConstraintCollectorObservedTypeToTypeConstructionInput(type)));
    END
    MUTABLE resolved_type: Type = UNWRAP (resolved_branch);
    IF (slot.shape == :list_element) THEN
      MUTABLE element_sym = type__resolved(resolved_type);
      MUTABLE rtoc_writer_receiver_14: AutoConstraintCollectorDeclarationNode = castAutoConstraintCollectorSlotDeclNodeToAutoConstraintCollectorDeclarationNode(slot.decl_node);
      declNode__set_type(&rtoc_writer_receiver_14, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("${element_sym}[]") })));
      RETURN;
    ELSE_IF (slot.shape == :map_key) OR (slot.shape == :map_value) THEN
      slot.resolved_scalar = resolved_type;
      RETURN;
    END
    IF (slot.kind == :param) THEN
      MUTABLE fn: FunctionDef = COPY castAutoConstraintCollectorSlotDeclNodeToFunctionDef(slot.decl_node);
      param__set_type(UNWRAP (fn.params[UNWRAP (slot.index)]), castTypeToTypeTypeInput(resolved_type));
    ELSE_IF (slot.kind == :return) THEN
      MUTABLE rtoc_writer_receiver_15: FunctionDef = castAutoConstraintCollectorSlotDeclNodeToFunctionDef(slot.decl_node);
      rtoc_writer_receiver_15.return_type = resolved_type;
    ELSE_IF (slot.kind == :local) THEN
      MUTABLE rtoc_writer_receiver_16: AutoConstraintCollectorDeclarationNode = castAutoConstraintCollectorSlotDeclNodeToAutoConstraintCollectorDeclarationNode(slot.decl_node);
      declNode__set_type(&rtoc_writer_receiver_16, resolved_type);
    END
}
END
FN observedTypeSymbol(observed: AutoConstraintCollectorObservedType) RETURNS String@symbol ->
  PARTIAL MATCH observed START
    AutoConstraintCollectorObservedType.SymbolValue AS item -> RETURN COPY item;,
    AutoConstraintCollectorObservedType.Type AS item -> RETURN type__resolved(item);,
    AutoConstraintCollectorObservedType.TypeMultiowned AS item -> RETURN type__resolved(item);
  END
  RETURN :Any;
END
FN declBlockParamName(decl: AutoInferenceDeclBlockParam1) RETURNS String ->
  PARTIAL MATCH decl START
    AutoInferenceDeclBlockParam1.BindExpr AS item -> RETURN COPY item.name;,
    AutoInferenceDeclBlockParam1.VarDecl AS item -> RETURN COPY item.name;
  END
  RETURN "";
END
PUB FN slotDeclIdentity(decl_node: AutoConstraintCollectorSlotDeclNode) RETURNS Int64 ->
  PARTIAL MATCH decl_node START
    AutoConstraintCollectorSlotDeclNode.FunctionDefMultiowned AS item -> RETURN aST__node_identity(Locatable{ FunctionDef: COPY item });,
    AutoConstraintCollectorSlotDeclNode.FunctionDef AS item -> RETURN aST__node_identity(Locatable{ FunctionDef: COPY item });,
    AutoConstraintCollectorSlotDeclNode.VarDecl AS item -> RETURN aST__node_identity(Locatable{ VarDecl: COPY item });,
    AutoConstraintCollectorSlotDeclNode.BindExpr AS item -> RETURN aST__node_identity(Locatable{ BindExpr: COPY item });
  END
  RETURN 0;
END
FN autoUnifier__stamp_map_pairs_mut(self: AutoUnifier, resolved_slots: {AutoSlotId@multiowned}Resolution) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE by_decl: {Int64}MapPairResolution@multiowned = {};
    FOR _ IN resolved_slots.values() DO
    IF !(((_.slot.shape == :map_key) OR (_.slot.shape == :map_value))) THEN
      CONTINUE;
    END
    IF by_decl[slotDeclIdentity(_.slot.decl_node)] == NIL THEN
        by_decl[slotDeclIdentity(_.slot.decl_node)] = mapPairResolution__new();
      END
    MUTABLE pair = COPY UNWRAP (by_decl[slotDeclIdentity(_.slot.decl_node)]);
    IF (_.slot.shape == :map_key) THEN
        pair.key = COPY _;
        by_decl[slotDeclIdentity(_.slot.decl_node)] = COPY pair;
    ELSE
        pair.value = COPY _;
        by_decl[slotDeclIdentity(_.slot.decl_node)] = COPY pair;
    END
    END
    FOR rtoc_each_5 IN by_decl.keys() DO
    MUTABLE pair: MapPairResolution@multiowned = (by_decl[rtoc_each_5] OR_ELSE CAST(panic("missing hash key") AS MapPairResolution@multiowned));
    MUTABLE key_res: ?Resolution = pair.key;
    MUTABLE val_res: ?Resolution = pair.value;
    IF ((key_res == NIL) OR (val_res == NIL)) THEN
        CONTINUE;
    END
    MUTABLE key_resolution: Resolution = COPY UNWRAP (key_res);
    MUTABLE val_resolution: Resolution = COPY UNWRAP (val_res);
    MUTABLE decl: AutoConstraintCollectorDeclarationNode = castAutoConstraintCollectorSlotDeclNodeToAutoConstraintCollectorDeclarationNode(key_resolution.slot.decl_node);
    MUTABLE k_sym: String@symbol = observedTypeSymbol(key_resolution.type);
    MUTABLE v_sym: String@symbol = observedTypeSymbol(val_resolution.type);
    declNode__set_type(&decl, TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("HashMap<${k_sym}, ${v_sym}>") })));
        END
}
END
FN autoUnifier__new(slots: {AutoSlotId@multiowned}Slot@multiowned, type_of: ?FN(Locatable) -> ?AutoConstraintCollectorObservedType = NIL) RETURNS AutoUnifier@multiowned ->
  MUTABLE self = AutoUnifier{ slots: COPY slots, type_of: (COPY type_of OR_ELSE autoUnifier__default_type_of) };
  autoUnifier__initialize(&self, slots, type_of);
  RETURN self @multiowned;
END
STRUCT ShapeEvidenceCollector {
  fn_nodes: {String}FunctionDef,
  slots: {AutoSlotId@multiowned}Slot@multiowned
}

FN shapeEvidenceCollector__initialize(MUTABLE self: ShapeEvidenceCollector, slots: {AutoSlotId@multiowned}Slot@multiowned, fn_nodes: {String}FunctionDef) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.slots = COPY slots;
    rtoc_self_view.fn_nodes = COPY fn_nodes;
}
END
FN shapeEvidenceCollector__collect_mut(self: ShapeEvidenceCollector) RETURNS !{AutoSlotId@multiowned}Slot@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    FOR _ IN rtoc_self_view.fn_nodes.values() DO
    TRY (shapeEvidenceCollector__collect_in_function(rtoc_self_view, _));
    END
    RETURN COPY rtoc_self_view.slots;
}
END
PRIVATE FN shapeEvidenceCollector__collect_in_function(self: ShapeEvidenceCollector, fn_value: FunctionDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE name_map = TRY (shapeEvidenceCollector__build_name_map(rtoc_self_view, fn_value));
    IF (name_map.count() == 0) THEN
      RETURN;
    END
    TRY (shapeEvidenceCollector__walk(rtoc_self_view, AutoInferenceWalkNode{ ArrayValue: fn_value.body |> SELECT castLocatableToNode(_) }, name_map));
}
END
PRIVATE FN shapeEvidenceCollector__build_name_map(self: ShapeEvidenceCollector, fn_value: FunctionDef) RETURNS !{String}AutoShapeSlots@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE map: {String}AutoShapeSlots@multiowned = {};
    shapeEvidenceCollector__walk_for_shape_decls(rtoc_self_view, AutoInferenceWalkNode{ ArrayValue: fn_value.body |> SELECT castLocatableToNode(_) }, %(decl: AutoInferenceDeclBlockParam1) USE(MUTABLE map, rtoc_self_view) -> {
    MUTABLE list_slot: ?Slot@multiowned = COPY rtoc_self_view.slots[autoSlotId__list_element(castAutoInferenceDeclBlockParam1ToLocatable(decl))];
    MUTABLE key_slot: ?Slot@multiowned = COPY rtoc_self_view.slots[autoSlotId__map_key(castAutoInferenceDeclBlockParam1ToLocatable(decl))];
    MUTABLE val_slot: ?Slot@multiowned = COPY rtoc_self_view.slots[autoSlotId__map_value(castAutoInferenceDeclBlockParam1ToLocatable(decl))];
    IF (((list_slot == NIL) AND (key_slot == NIL)) AND (val_slot == NIL)) THEN
        RETURN;
    END
    MUTABLE decl_name: String = declBlockParamName(decl);
    map[decl_name] = autoShapeSlots__new(list_slot, key_slot, val_slot);
    rubyToClearVoid()
    });
    RETURN map;
}
END
PRIVATE FN shapeEvidenceCollector__walk_for_shape_decls(self: ShapeEvidenceCollector, node: ?AutoInferenceWalkNode, block: FN(AutoInferenceDeclBlockParam1) -> Void) RETURNS Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node EXISTS AS node_value THEN
      IF node_value IS_A BindExpr AS bind_expr THEN
        IF typeAutoOptional?(bind_expr.type) THEN
          block(AutoInferenceDeclBlockParam1{ BindExpr: COPY bind_expr });
        END
        shapeEvidenceCollector__walk_for_shape_decls(rtoc_self_view, AutoInferenceWalkNode{ ArrayValue: [castLocatableToNode(COPY bind_expr.value)] }, block);
      ELSE_IF node_value IS_A VarDecl AS var_decl THEN
        IF typeAutoOptional?(var_decl.type) THEN
          block(AutoInferenceDeclBlockParam1{ VarDecl: COPY var_decl });
        END
        shapeEvidenceCollector__walk_for_shape_decls(rtoc_self_view, AutoInferenceWalkNode{ ArrayValue: [castLocatableToNode(COPY var_decl.value)] }, block);
      ELSE_IF node_value IS_A FunctionDef@multiowned AS function_def_multiowned THEN
    
      ELSE_IF node_value IS_A Token@multiowned AS token_multiowned THEN
    
      ELSE_IF node_value IS_A []Node AS array THEN
        FOR _ IN array DO
        shapeEvidenceCollector__walk_for_shape_decls(rtoc_self_view, castNodeToOptionalAutoInferenceWalkNode(_), block);
        END
      ELSE
        FOR rtoc_walk_child_18 IN rtocChildrenAutoInferenceWalkNode(node_value) DO
        shapeEvidenceCollector__walk_for_shape_decls(rtoc_self_view, rtoc_walk_child_18, block);
        END
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN shapeEvidenceCollector__walk(self: ShapeEvidenceCollector, node: ?AutoInferenceWalkNode, name_map: {String}AutoShapeSlots@multiowned) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node EXISTS AS node_value THEN
      IF node_value IS_A MethodCall AS method_call THEN
        TRY (shapeEvidenceCollector__record_method_call(rtoc_self_view, method_call, name_map));
        TRY (shapeEvidenceCollector__walk(rtoc_self_view, castLocatableToOptionalAutoInferenceWalkNode(method_call.object), name_map));
        FOR rtoc_call_arg IN method_call.args DO
        TRY (shapeEvidenceCollector__walk(rtoc_self_view, castLocatableToOptionalAutoInferenceWalkNode(rtoc_call_arg), name_map));
        END
      ELSE_IF node_value IS_A Assignment AS assignment THEN
        shapeEvidenceCollector__record_index_assign(rtoc_self_view, assignment, name_map);
        TRY (shapeEvidenceCollector__walk(rtoc_self_view, castLocatableToOptionalAutoInferenceWalkNode(assignment.value), name_map));
      ELSE_IF node_value IS_A FunctionDef@multiowned AS function_def_multiowned THEN
    
      ELSE_IF node_value IS_A Token@multiowned AS token_multiowned THEN
    
      ELSE_IF node_value IS_A []Node AS array THEN
        FOR _ IN array DO
        TRY (shapeEvidenceCollector__walk(rtoc_self_view, castNodeToOptionalAutoInferenceWalkNode(_), name_map));
        END
      ELSE
        FOR rtoc_walk_child_19 IN rtocChildrenAutoInferenceWalkNode(node_value) DO
        TRY (shapeEvidenceCollector__walk(rtoc_self_view, rtoc_walk_child_19, name_map));
        END
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN shapeEvidenceCollector__record_method_call(self: ShapeEvidenceCollector, call: MethodCall, name_map: {String}AutoShapeSlots@multiowned) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE target = COPY call.object;
    IF target IS_A Identifier AS identifier THEN
      MUTABLE slots: ?AutoShapeSlots@multiowned = COPY name_map[identifier__name(identifier)];
      IF slots EXISTS AS slots_value THEN
        MUTABLE args = call.args;
        IF slots_value.list EXISTS AS list_slot THEN
          IF TRY (intrinsicRegistry__collection_element_evidence_method?(Name{ StringValue: COPY call.name }, args.length())) THEN
            MUTABLE list_slot_mutable = COPY list_slot;
            &list_slot_mutable.sources.append(COPY UNWRAP (args[0]));
          END
        END
        IF TRY (intrinsicRegistry__map_pair_evidence_method?(Name{ StringValue: COPY call.name }, args.length())) THEN
          shapeEvidenceCollector__record_map_pair_evidence(rtoc_self_view, slots_value, args);
        END
      ELSE
        RETURN;
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN shapeEvidenceCollector__record_map_pair_evidence(self: ShapeEvidenceCollector, slots: AutoShapeSlots, args: []Locatable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(((slots.key != NIL) AND (slots.value != NIL))) THEN
      RETURN;
    END
    ((UNWRAP (slots.key)).sources).append(COPY UNWRAP (args[0]));
    ((UNWRAP (slots.value)).sources).append(COPY UNWRAP (args[1]));
}
END
PRIVATE FN shapeEvidenceCollector__record_index_assign(self: ShapeEvidenceCollector, assign: Assignment, name_map: {String}AutoShapeSlots@multiowned) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE target = COPY assign.name;
    IF target IS_A GetIndex AS get_index THEN
      MUTABLE base: Locatable = COPY get_index.target;
      IF base IS_A Identifier AS base_identifier THEN
        MUTABLE slots: ?AutoShapeSlots@multiowned = COPY name_map[base_identifier.name];
        IF slots EXISTS AS slots_value THEN
          IF slots_value.list EXISTS AS list_value THEN
            MUTABLE list_mutable = COPY list_value;
            &list_mutable.sources.append(COPY assign.value);
          ELSE
            IF slots_value.key EXISTS AS key_value THEN
              IF slots_value.value EXISTS AS val_value THEN
                MUTABLE key_mutable = COPY key_value;
                MUTABLE val_mutable = COPY val_value;
                &key_mutable.sources.append(COPY get_index.index);
                &val_mutable.sources.append(COPY assign.value);
              END
            END
          END
        END
      END
    ELSE
      RETURN;
    END
}
END
FN shapeEvidenceCollector__new(slots: {AutoSlotId@multiowned}Slot@multiowned, fn_nodes: {String}FunctionDef) RETURNS ShapeEvidenceCollector@multiowned ->
  MUTABLE self = ShapeEvidenceCollector{ fn_nodes: COPY fn_nodes, slots: COPY slots };
  shapeEvidenceCollector__initialize(&self, slots, fn_nodes);
  RETURN self @multiowned;
END
STRUCT OperatorEvidenceCollector {
  evidence: {AutoSlotId}[Set]String@symbol,
  fn_nodes: {String}FunctionDef,
  slots: {AutoSlotId@multiowned}Slot@multiowned
}

FN operatorEvidenceCollector__initialize(MUTABLE self: OperatorEvidenceCollector, slots: {AutoSlotId@multiowned}Slot@multiowned, fn_nodes: {String}FunctionDef) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.slots = COPY slots;
    rtoc_self_view.fn_nodes = COPY fn_nodes;
    rtoc_self_view.evidence = {};
}
END
FN operatorEvidenceCollector__collect_mut(self: OperatorEvidenceCollector) RETURNS !{AutoSlotId@multiowned}[Set]String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    FOR _ IN rtoc_self_view.fn_nodes.values() DO
    TRY (operatorEvidenceCollector__collect_in_function(rtoc_self_view, _));
    END
    RETURN COPY rtoc_self_view.evidence;
}
END
PRIVATE FN operatorEvidenceCollector__collect_in_function(self: OperatorEvidenceCollector, fn_value: FunctionDef) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE name_to_slot = TRY (operatorEvidenceCollector__build_name_map(rtoc_self_view, fn_value));
    operatorEvidenceCollector__walk_binops(rtoc_self_view, AutoInferenceWalkNode{ ArrayValue: fn_value.body |> SELECT castLocatableToNode(_) }, name_to_slot, fn_value);
}
END
PRIVATE FN operatorEvidenceCollector__build_name_map(self: OperatorEvidenceCollector, fn_value: FunctionDef) RETURNS !{String}AutoSlotId@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE map: {String}AutoSlotId@multiowned = {};
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < fn_value.params.length() DO
      MUTABLE slot_id = autoSlotId__param(fn_value.name, rtoc_idx);
      IF rtoc_self_view.slots.contains?(slot_id) THEN
          MUTABLE param_key: String = COPY UNWRAP (fn_value.params[rtoc_idx]).name;
          map[param_key] = slot_id;
      END
    rtoc_idx = rtoc_idx + 1;
    END
    operatorEvidenceCollector__walk_for_local_decls(rtoc_self_view, AutoInferenceWalkNode{ ArrayValue: fn_value.body |> SELECT castLocatableToNode(_) }, %(decl: AutoInferenceDeclBlockParam1) USE(MUTABLE map, rtoc_self_view) -> {
    MUTABLE slot_id = autoSlotId__local(castAutoInferenceDeclBlockParam1ToLocatable(decl));
    IF rtoc_self_view.slots.contains?(slot_id) THEN
        MUTABLE decl_name: String = declBlockParamName(decl);
    map[decl_name] = slot_id;
    END
    rubyToClearVoid()
    });
    RETURN map;
}
END
PRIVATE FN operatorEvidenceCollector__walk_for_local_decls(self: OperatorEvidenceCollector, node: ?AutoInferenceWalkNode, block: FN(AutoInferenceDeclBlockParam1) -> Void) RETURNS Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node EXISTS AS node_value THEN
      IF node_value IS_A BindExpr AS bind_expr THEN
        IF operatorEvidenceCollector__auto?(rtoc_self_view, bind_expr.type) THEN
          block(AutoInferenceDeclBlockParam1{ BindExpr: COPY bind_expr });
        END
        operatorEvidenceCollector__walk_for_local_decls(rtoc_self_view, AutoInferenceWalkNode{ ArrayValue: [castLocatableToNode(COPY bind_expr.value)] }, block);
      ELSE_IF node_value IS_A VarDecl AS var_decl THEN
        IF operatorEvidenceCollector__auto?(rtoc_self_view, var_decl.type) THEN
          block(AutoInferenceDeclBlockParam1{ VarDecl: COPY var_decl });
        END
        operatorEvidenceCollector__walk_for_local_decls(rtoc_self_view, AutoInferenceWalkNode{ ArrayValue: [castLocatableToNode(COPY var_decl.value)] }, block);
      ELSE_IF node_value IS_A FunctionDef@multiowned AS function_def_multiowned THEN
    
      ELSE_IF node_value IS_A Token@multiowned AS token_multiowned THEN
    
      ELSE_IF node_value IS_A []Node AS array THEN
        FOR _ IN array DO
        operatorEvidenceCollector__walk_for_local_decls(rtoc_self_view, castNodeToOptionalAutoInferenceWalkNode(_), block);
        END
      ELSE
        FOR rtoc_walk_child_20 IN rtocChildrenAutoInferenceWalkNode(node_value) DO
        operatorEvidenceCollector__walk_for_local_decls(rtoc_self_view, rtoc_walk_child_20, block);
        END
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN operatorEvidenceCollector__walk_binops(self: OperatorEvidenceCollector, node: ?AutoInferenceWalkNode, name_to_slot: {String}AutoSlotId@multiowned, fn_value: FunctionDef) RETURNS Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node EXISTS AS node_value THEN
      IF node_value IS_A BinaryOp AS binary_op THEN
        operatorEvidenceCollector__record_binop(rtoc_self_view, binary_op, name_to_slot);
        operatorEvidenceCollector__walk_binops(rtoc_self_view, AutoInferenceWalkNode{ ArrayValue: [castLocatableToNode(COPY binary_op.left)] }, name_to_slot, fn_value);
        operatorEvidenceCollector__walk_binops(rtoc_self_view, AutoInferenceWalkNode{ ArrayValue: [castLocatableToNode(COPY binary_op.right)] }, name_to_slot, fn_value);
      ELSE_IF node_value IS_A ReturnNode AS return_node THEN
        MUTABLE ret_slot = autoSlotId__return(fn_value.name);
        IF rtoc_self_view.slots.contains?(ret_slot) THEN
        MUTABLE ret_is_binop: Bool = FALSE;
        IF return_node.value EXISTS AS return_value THEN
          ret_is_binop = return_value IS_A BinaryOp;
        END
        IF ret_is_binop THEN
          IF rtoc_self_view.evidence[ret_slot] == NIL THEN
            rtoc_self_view.evidence[ret_slot] = Set[];
          END
          IF return_node.value EXISTS AS ret_value THEN
            IF ret_value IS_A BinaryOp AS ret_binop THEN
              IF rtoc_self_view.evidence[ret_slot] EXISTS AS evidence_set THEN
                MUTABLE evidence_mutable = COPY evidence_set;
                &evidence_mutable.insert(COPY ret_binop.op);
              END
            END
          END
        END
        END
        operatorEvidenceCollector__walk_binops(rtoc_self_view, AutoInferenceWalkNode{ ArrayValue: [castLocatableToNode(COPY UNWRAP (return_node.value))] }, name_to_slot, fn_value);
      ELSE_IF node_value IS_A FunctionDef@multiowned AS function_def_multiowned THEN
    
      ELSE_IF node_value IS_A Token@multiowned AS token_multiowned THEN
    
      ELSE_IF node_value IS_A []Node AS array THEN
        FOR _ IN array DO
        operatorEvidenceCollector__walk_binops(rtoc_self_view, castNodeToOptionalAutoInferenceWalkNode(_), name_to_slot, fn_value);
        END
      ELSE
        FOR rtoc_walk_child_21 IN rtocChildrenAutoInferenceWalkNode(node_value) DO
        operatorEvidenceCollector__walk_binops(rtoc_self_view, rtoc_walk_child_21, name_to_slot, fn_value);
        END
      END
    ELSE
      RETURN;
    END
}
END
PRIVATE FN operatorEvidenceCollector__record_binop(self: OperatorEvidenceCollector, binop: BinaryOp, name_to_slot: {String}AutoSlotId@multiowned) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rtoc_each_items_22 = ([binop.left, binop.right]);
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_each_items_22.length() DO
      MUTABLE operand: Locatable = COPY rtoc_each_items_22[rtoc_idx];
      IF operand IS_A Identifier AS operand_identifier THEN
        MUTABLE slot_id: ?AutoSlotId@multiowned = COPY name_to_slot[operand_identifier.name];
        IF slot_id EXISTS AS slot_id_value THEN
          IF rtoc_self_view.evidence[slot_id_value] == NIL THEN
            rtoc_self_view.evidence[slot_id_value] = Set[];
          END
          IF rtoc_self_view.evidence[slot_id_value] EXISTS AS evidence_set THEN
            MUTABLE evidence_mutable = COPY evidence_set;
            &evidence_mutable.insert(COPY binop.op);
          END
        END
      END
    rtoc_idx = rtoc_idx + 1;
    END
}
END
PRIVATE FN operatorEvidenceCollector__auto?(self: OperatorEvidenceCollector, t: ?Type) RETURNS Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF t EXISTS AS t_value THEN
      RETURN type__auto?(t_value);
    END
    RETURN FALSE;
}
END
FN operatorEvidenceCollector__new(slots: {AutoSlotId@multiowned}Slot@multiowned, fn_nodes: {String}FunctionDef) RETURNS OperatorEvidenceCollector@multiowned ->
  MUTABLE self = OperatorEvidenceCollector{ evidence: {}, fn_nodes: COPY fn_nodes, slots: COPY slots };
  operatorEvidenceCollector__initialize(&self, slots, fn_nodes);
  RETURN self @multiowned;
END
