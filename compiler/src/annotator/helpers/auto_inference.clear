FN rubyToClearVoid() RETURNS Void ->
  RETURN;
END

PUB FN declNode__set_type(MUTABLE node: AutoConstraintCollectorDeclarationNode, value: ?Type) RETURNS Void ->
  MATCH node START
    AutoConstraintCollectorDeclarationNode.VarDecl AS MUTABLE item -> item.type = COPY value;,
    AutoConstraintCollectorDeclarationNode.BindExpr AS MUTABLE item -> item.type = COPY value;
  END
END
FN castTypeToTypeTypeInput(value: Type) RETURNS TypeTypeInput ->
  RETURN TypeTypeInput{ Type: COPY value };
END
PUB FN autoUnifier__type_of_call(self: AutoUnifier, arg0: Locatable) RETURNS ?AutoConstraintCollectorObservedType ->
  MUTABLE fn_value = self.type_of;
  RETURN fn_value(arg0);
END
