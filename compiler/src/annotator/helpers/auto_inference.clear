FN castLocatableToAutoInferenceWalkNode(value: Locatable) RETURNS AutoInferenceWalkNode ->
  PARTIAL MATCH value START
    Locatable.RequireNode AS cast_payload -> RETURN AutoInferenceWalkNode{ RequireNode: COPY cast_payload };,
