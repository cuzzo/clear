    &out.append(AutoInferenceWalkNode{ TokenMultiowned: COPY rtoc_opt_child });
  END
  &out.append(AutoInferenceWalkNode{ ArrayValue: COPY v.pre_clauses });
  &out.append(AutoInferenceWalkNode{ ArrayValue: COPY v.post_clauses });
  &out.append(AutoInferenceWalkNode{ ArrayValue: COPY v.is_method });
  IF v.can_fail EXISTS AS rtoc_opt_child THEN
    &out.append(AutoInferenceWalkNode{ BoolValue: COPY rtoc_opt_child });
