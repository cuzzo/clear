  &out.append(AutoInferenceWalkNode{ TokenMultiowned: COPY v.token });
  &out.append(AutoInferenceWalkNode{ ArrayValue: COPY v.initial_value });
  &out.append(AutoInferenceWalkNode{ ArrayValue: COPY v.expression });
  IF v.can_fail EXISTS AS rtoc_opt_child THEN
    &out.append(AutoInferenceWalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.coerced_type_object EXISTS AS rtoc_opt_child THEN
    &out.append(AutoInferenceWalkNode{ TypeMultiowned: COPY rtoc_opt_child });
  END
  IF v.collection_return EXISTS AS rtoc_opt_child THEN
    &out.append(AutoInferenceWalkNode{ TypeMultiowned: COPY rtoc_opt_child });
  END
  IF v.container_borrow EXISTS AS rtoc_opt_child THEN
    &out.append(AutoInferenceWalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.error_kind EXISTS AS rtoc_opt_child THEN
    &out.append(AutoInferenceWalkNode{ SymbolValue: COPY rtoc_opt_child });
  END
  IF v.error_type EXISTS AS rtoc_opt_child THEN
    &out.append(AutoInferenceWalkNode{ SymbolValue: COPY rtoc_opt_child });
  END
  IF v.implicit_layout_cost EXISTS AS rtoc_opt_child THEN
    &out.append(AutoInferenceWalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.layout_transport EXISTS AS rtoc_opt_child THEN
    &out.append(AutoInferenceWalkNode{ SymbolValue: COPY rtoc_opt_child });
  END
  IF v.mutates_receiver EXISTS AS rtoc_opt_child THEN
    &out.append(AutoInferenceWalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.needs_heap_create EXISTS AS rtoc_opt_child THEN
    &out.append(AutoInferenceWalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.needs_mut_ref EXISTS AS rtoc_opt_child THEN
    &out.append(AutoInferenceWalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.stdlib_allocates EXISTS AS rtoc_opt_child THEN
    &out.append(AutoInferenceWalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.storage_override EXISTS AS rtoc_opt_child THEN
    &out.append(AutoInferenceWalkNode{ SymbolValue: COPY rtoc_opt_child });
  END
  IF v.symbol EXISTS AS rtoc_opt_child THEN
    &out.append(AutoInferenceWalkNode{ SymbolEntryMultiowned: COPY rtoc_opt_child });
  END
  IF v.type_object EXISTS AS rtoc_opt_child THEN
    &out.append(AutoInferenceWalkNode{ TypeMultiowned: COPY rtoc_opt_child });
  END
  IF v.var_mutated EXISTS AS rtoc_opt_child THEN
    &out.append(AutoInferenceWalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.var_used EXISTS AS rtoc_opt_child THEN
    &out.append(AutoInferenceWalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.was_moved EXISTS AS rtoc_opt_child THEN
    &out.append(AutoInferenceWalkNode{ BoolValue: COPY rtoc_opt_child });
  END
  IF v.zig_pattern EXISTS AS rtoc_opt_child THEN
    &out.append(AutoInferenceWalkNode{ SymbolValue: COPY rtoc_opt_child });
  END
  RETURN out;
END
