FN rtocChildrenOfAutoInferenceWalkNodeFunctionDef(v: FunctionDef) RETURNS []AutoInferenceWalkNode ->
  MUTABLE out: []AutoInferenceWalkNode = [];
  &out.append(AutoInferenceWalkNode{ TokenMultiowned: COPY v.token });
  &out.append(AutoInferenceWalkNode{ ArrayValue: COPY v.name });
  &out.append(AutoInferenceWalkNode{ ArrayValue: COPY v.captures });
  IF v.return_type EXISTS AS rtoc_opt_child THEN
    &out.append(AutoInferenceWalkNode{ TypeMultiowned: COPY rtoc_opt_child });
  END
  &out.append(AutoInferenceWalkNode{ ArrayValue: COPY v.return_lifetime });
  FOR rtoc_arr_child IN v.body DO
    &out.append(castLocatableToAutoInferenceWalkNode(COPY rtoc_arr_child));
  END
  &out.append(AutoInferenceWalkNode{ ArrayValue: COPY v.catch_clauses });
  &out.append(AutoInferenceWalkNode{ ArrayValue: COPY v.default_catch });
  &out.append(AutoInferenceWalkNode{ ArrayValue: COPY v.visibility });
  &out.append(AutoInferenceWalkNode{ ArrayValue: COPY v.deferred_drops });
  &out.append(AutoInferenceWalkNode{ ArrayValue: COPY v.uses_frame });
  &out.append(AutoInferenceWalkNode{ ArrayValue: COPY v.explicit_return_type });
  FOR rtoc_arr_child IN v.type_params DO
    &out.append(AutoInferenceWalkNode{ SymbolValue: COPY rtoc_arr_child });
  END
  &out.append(AutoInferenceWalkNode{ ArrayValue: COPY v.tail_call });
  &out.append(AutoInferenceWalkNode{ ArrayValue: COPY v.requires });
  &out.append(AutoInferenceWalkNode{ TokenMultiowned: COPY v.arrow_token });
  IF v.name_token EXISTS AS rtoc_opt_child THEN
    &out.append(AutoInferenceWalkNode{ TokenMultiowned: COPY rtoc_opt_child });
  END
  &out.append(AutoInferenceWalkNode{ ArrayValue: COPY v.effects_decl });
  &out.append(AutoInferenceWalkNode{ ArrayValue: COPY v.effects_span });
  &out.append(AutoInferenceWalkNode{ ArrayValue: COPY v.max_depth_n });
  &out.append(AutoInferenceWalkNode{ ArrayValue: COPY v.tight_reentrance });
  &out.append(AutoInferenceWalkNode{ ArrayValue: COPY v.requires_clauses });
