REQUIRE "pkg:rtoc_6173742f747970652e636c656172" AS type
REQUIRE "pkg:rtoc_73656d616e7469632f6361706162696c6974795f706c616e2e636c656172" AS capability_plan
REQUIRE "pkg:rtoc_73656d616e7469632f73656d616e7469635f6964732e636c656172" AS semantic_ids
REQUIRE "pkg:rtoc_6173742f6173742e636c656172" AS ast
REQUIRE "pkg:rtoc_6d69722f66736d5f6f70732e636c656172" AS fsm_ops
REQUIRE "pkg:rtoc_6173742f706172616d2e636c656172" AS param
REQUIRE "pkg:rtoc_6173742f6c657865722e636c656172" AS lexer
REQUIRE "pkg:rtoc_6d69722f6d69722e636c656172" AS mir
REQUIRE "pkg:rtoc_616e6e6f7461746f722f68656c706572732f66756e6374696f6e5f7369676e61747572652e636c656172" AS function_signature
REQUIRE "pkg:rtoc_6173742f73796d626f6c5f656e7472792e636c656172" AS symbol_entry
# Ruby module WithMatchCheck
PUB FN withMatchCheck__admissible_axes(family_set: ?[Set]String@symbol) RETURNS ![Set]String@symbol ->
  MUTABLE axes: [Set]String@symbol = Set[];
  IF family_set EXISTS AS families THEN
    FOR family IN families DO
      IF (family == :LOCKED) THEN
        &axes.insert(:locked);
        &axes.insert(:write_locked);
      ELSE_IF (family == :SNAPSHOTTED) THEN
        &axes.insert(:versioned);
        &axes.insert(:atomic);
      ELSE_IF (family == :VERSIONED) THEN
        &axes.insert(:versioned);
      ELSE_IF (family == :ATOMIC) THEN
        &axes.insert(:atomic);
      ELSE_IF (family == :LOCAL) THEN
        &axes.insert(:local);
        &axes.insert(:multiowned);
        &axes.insert(:plain);
      ELSE_IF (family == :ACTOR) THEN
        &axes.insert(:actor);
      ELSE_IF (family == :LOCK_FREE) THEN
        &axes.insert(:lock_free);
      END
    END
  END
  RETURN axes;
END
PUB FN withMatchCheck__poly_requires?(family_set: ?[Set]String@symbol) RETURNS !Bool ->
  RETURN ((TRY (withMatchCheck__admissible_axes(family_set))).length() > 1);
END
PUB FN withMatchCheck__check_function_mut(MUTABLE fn_value: FunctionDef, with_blocks: []WithBlock, error_handler: FN(Locatable, String) -> Void, warn_handler: ?FN(Locatable, String) -> Void = NIL, policy_handlers: []ErrorClause) RETURNS !Void ->
  MUTABLE requires_map: {String}[Set]String@symbol = {};
  IF fn_value.requires EXISTS AS declared_requires THEN
    requires_map = COPY declared_requires;
  END
  MUTABLE param_names = (fn_value.params |> SELECT _.name) |> DISTINCT _;
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < with_blocks.length() DO
    IF with_blocks[rtoc_idx]?.view_kind THEN
      rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    MUTABLE bound_params = withMatchCheck__collect_bound_param_names(with_blocks[rtoc_idx]?, param_names);
    IF !(with_blocks[rtoc_idx]?.arms) THEN
        TRY (withMatchCheck__enforce_polymorphic_iff_rule_mut(with_blocks[rtoc_idx]?, bound_params, requires_map, fn_value, error_handler));
    END
    IF !(with_blocks[rtoc_idx]?.arms) THEN
        TRY (withMatchCheck__warn_polymorphic_unhandled_errors_mut(with_blocks[rtoc_idx]?, bound_params, requires_map, policy_handlers, warn_handler?));
    END
    IF with_blocks[rtoc_idx]?.polymorphic THEN
        fn_value.uses_rt = TRUE;
        fn_value.uses_alloc = TRUE;
    END
    MUTABLE requires_bound_params: [Set]String = Set[];
      IF with_blocks[rtoc_idx]?.polymorphic THEN
        requires_bound_params = bound_params;
      ELSE
        requires_bound_params = withMatchCheck__collect_sync_bound_param_names(with_blocks[rtoc_idx]?, param_names);
      END
    MUTABLE rtoc_req_idx = 0;
    WHILE rtoc_req_idx < requires_bound_params.length() DO
      MUTABLE pname: String = COPY UNWRAP (requires_bound_params[rtoc_req_idx]);
      IF requires_map.contains?(pname) THEN
        rtoc_req_idx = rtoc_req_idx + 1;
        CONTINUE;
      END
      IF with_blocks[rtoc_idx]?.polymorphic THEN
        requires_map[pname] = Set[];
        fn_value.requires = (fn_value.requires OR_ELSE {});
        fn_value.requires[pname] = Set[];
        MUTABLE rtoc_writer_receiver_1: WithBlock = with_blocks[rtoc_idx]?;
        rtoc_writer_receiver_1.universal_poly = TRUE;
        fn_value.uses_rt = TRUE;
        fn_value.uses_alloc = TRUE;
        rtoc_req_idx = rtoc_req_idx + 1;
        CONTINUE;
      END
      IF warn_handler EXISTS AS warn_handler_value THEN
        MUTABLE warn_handler_value_mutable = COPY warn_handler_value;
        warn_handler_value_mutable(Locatable{ WithBlock: COPY with_blocks[rtoc_idx]? }, "WITH at line ${UNWRAP ((with_blocks[rtoc_idx]?.token)?.line).toString()} binds '${pname}' without REQUIRES; assuming REQUIRES ${pname}: LOCKED");
        MUTABLE locked_family: [Set]String@symbol = Set[];
        &locked_family.insert(:LOCKED);
        requires_map[pname] = COPY locked_family;
        fn_value.requires = (fn_value.requires OR_ELSE {});
        fn_value.requires[pname] = COPY locked_family;
      ELSE
        error_handler(Locatable{ WithBlock: COPY with_blocks[rtoc_idx]? }, "WITH at line ${UNWRAP ((with_blocks[rtoc_idx]?.token)?.line).toString()} binds '${pname}' without REQUIRES");
      END
      rtoc_req_idx = rtoc_req_idx + 1;
    END

    MUTABLE arms: ?[]WithMatchArm = COPY with_blocks[rtoc_idx]?.arms;
    IF !(arms) THEN
        rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    MUTABLE arm_families: [Set]String@symbol = Set[];
    FOR arm IN UNWRAP (arms) DO
      &arm_families.insert(COPY arm.family);
    END
    MUTABLE required_families: [Set]String@symbol = Set[];
    FOR bound_param IN bound_params DO
      IF requires_map[bound_param] EXISTS AS declared_families THEN
        FOR declared IN declared_families DO
          &required_families.insert(COPY declared);
        END
      END
    END
    MUTABLE missing: [Set]String@symbol = Set[];
    FOR required IN required_families DO
      IF !(arm_families.contains?(required)) THEN
        &missing.insert(COPY required);
      END
    END
    MUTABLE extra: [Set]String@symbol = Set[];
    FOR present IN arm_families DO
      IF !(required_families.contains?(present)) THEN
        &extra.insert(COPY present);
      END
    END
    FOR _ IN missing DO
    error_handler(Locatable{ WithBlock: COPY with_blocks[rtoc_idx]? }, "WITH MATCH at line ${UNWRAP ((with_blocks[rtoc_idx]?.token)?.line).toString()} is missing a WHEN arm for ${_} (declared in REQUIRES). Add an arm:\n    WHEN ${_}\n        -> { <body for ${_} strategy> }");
    END
    FOR _ IN extra DO
    error_handler(Locatable{ WithBlock: COPY with_blocks[rtoc_idx]? }, "WITH MATCH at line ${UNWRAP ((with_blocks[rtoc_idx]?.token)?.line).toString()} has a WHEN arm for ${_}, but ${_} is not in REQUIRES. Either remove the arm or add ${_} to REQUIRES.");
    END
  rtoc_idx = rtoc_idx + 1;
  END
  NIL;
END
PUB FN withMatchCheck__collect_bound_param_names(with_node: WithBlock, param_names: [Set]String) RETURNS [Set]String ->
  MUTABLE out: [Set]String = Set[];
  MUTABLE rtoc_each_items_2 = ((TRY (capabilityPlan__require_for(with_node))).all);
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < rtoc_each_items_2.length() DO
    MUTABLE vn: ?Locatable = COPY rtoc_each_items_2[rtoc_idx]?.var_node;
    IF vn EXISTS AS vn_value THEN
      IF vn_value IS_A Identifier AS identifier THEN
        IF param_names.contains?(identifier.name) THEN
          &out.insert(COPY identifier.name);
        END
      END
    END
  rtoc_idx = rtoc_idx + 1;
  END
  RETURN out;
END
PUB FN withMatchCheck__collect_sync_bound_param_names(with_node: WithBlock, param_names: [Set]String) RETURNS [Set]String ->
  MUTABLE out: [Set]String = Set[];
  MUTABLE rtoc_each_items_3 = (TRY (withCapabilityPlan__sync_constrained((TRY (capabilityPlan__require_for(with_node))))));
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < rtoc_each_items_3.length() DO
    MUTABLE vn: ?Locatable = COPY rtoc_each_items_3[rtoc_idx]?.var_node;
    IF vn EXISTS AS vn_value THEN
      IF vn_value IS_A Identifier AS identifier THEN
        IF param_names.contains?(identifier.name) THEN
          &out.insert(COPY identifier.name);
        END
      END
    END
  rtoc_idx = rtoc_idx + 1;
  END
  RETURN out;
END
PUB FN withMatchCheck__enforce_polymorphic_iff_rule_mut(node: WithBlock, bound_params: [Set]String, requires_map: {String}[Set]String@symbol, fn_value: FunctionDef, error_handler: FN(Locatable, String) -> Void) RETURNS !Void ->
  IF ((node.view_kind != NIL) OR (node.snapshot_mode != NIL)) THEN
    RETURN;
  END
  IF (node.universal_poly OR_ELSE FALSE) THEN
    RETURN;
  END
  MUTABLE has_poly_param = FALSE;
  MUTABLE has_universal_poly_param = FALSE;
  FOR bound_param IN bound_params DO
    IF requires_map[bound_param] EXISTS AS declared_families THEN
      IF TRY (withMatchCheck__poly_requires?(declared_families)) THEN
        has_poly_param = TRUE;
      END
      IF declared_families.empty?() THEN
        has_universal_poly_param = TRUE;
      END
    ELSE
      has_universal_poly_param = TRUE;
    END
  END
  IF ((((node.polymorphic OR_ELSE FALSE) AND !(has_poly_param))) AND !(has_universal_poly_param)) THEN
    RETURN error_handler(Locatable{ WithBlock: COPY node }, "WITH POLYMORPHIC is only allowed when at least one bound binding is a polymorphic parameter (REQUIRES admits more than one storage family, e.g. `LOCKED` or `SNAPSHOTTED`). Either drop POLYMORPHIC and use plain WITH (be specific), or broaden REQUIRES to a polymorphic family.");
  ELSE_IF (!((node.polymorphic OR_ELSE FALSE)) AND has_poly_param) THEN
    MUTABLE example: String = "";
    MUTABLE example_fams: String = "";
    FOR bound_param IN bound_params DO
      IF requires_map[bound_param] EXISTS AS declared_families THEN
        IF (TRY (withMatchCheck__poly_requires?(declared_families)) AND (example.length() == 0)) THEN
          example = COPY bound_param;
          FOR family IN declared_families DO
            IF (example_fams.length() == 0) THEN
              example_fams = "${family}";
            ELSE
              example_fams = "${example_fams} | ${family}";
            END
          END
        END
      END
    END
    RETURN error_handler(Locatable{ WithBlock: COPY node }, "Plain WITH on the polymorphic parameter '${example}' (REQUIRES admits ${example_fams}) is not allowed. Use `WITH POLYMORPHIC ...` so the body's polymorphism is visible at the use site (the comptime dispatch lowers per family). If you want to commit to a single family, narrow REQUIRES to one of: VERSIONED, ATOMIC.");
  END
END
PUB FN withMatchCheck__check_call_sites_mut(call_sites: []CallSiteFact, sig_lookup: FN(String) -> ?Type, error_handler: FN(Locatable, String) -> Void) RETURNS !Void ->
  FOR call_site IN call_sites DO
    MUTABLE looked_up: ?Type = sig_lookup(COPY call_site.callee_name);
    MUTABLE sig: ?FunctionSignature@multiowned = NIL;
    IF looked_up EXISTS AS looked_up_type THEN
      sig = functionSignature__unwrap(X{ Type: COPY looked_up_type });
    END
    IF sig EXISTS AS sig_value THEN
      MUTABLE sig_mutable = COPY sig_value;
      MUTABLE requires_map = TRY (functionSignature__requires(sig_mutable));
      MUTABLE params = TRY (functionSignature__params(sig_mutable));
      MUTABLE idx: Int64 = 0;
      WHILE (idx < params.length()) DO
        MUTABLE param_name: String = COPY UNWRAP (params[idx]).name;
        MUTABLE arg: ?Locatable = NIL;
        IF (idx < call_site.args.length()) THEN
          arg = COPY call_site.args[idx];
        END
        MUTABLE families: ?[Set]String@symbol = COPY requires_map[param_name];
        IF families EXISTS AS declared_families THEN
          IF declared_families.empty?() THEN
            # A plain-T argument bound to a universal-poly parameter is lowered
            # as a Zig `var` so &c yields *T and polymorphicMutate can write back.
            IF arg EXISTS AS arg_value THEN
              IF arg_value IS_A Identifier AS identifier THEN
                IF identifier.symbol EXISTS AS sym THEN
                  MUTABLE sym_mutable = COPY sym;
                  IF !(symbolEntry__with_match_capability_family?(sym_mutable)) THEN
                    IF sym_mutable.mutable THEN
                      symbolEntry__mark_poly_borrow_target_mut(&sym_mutable);
                    END
                  END
                END
              END
            END
          ELSE
            IF arg EXISTS AS arg_value THEN
              MUTABLE family_names: String = "";
              FOR family IN declared_families DO
                IF (family_names.length() == 0) THEN
                  family_names = "${family}";
                ELSE
                  family_names = "${family_names} | ${family}";
                END
              END
              MUTABLE arg_family: ?String@symbol = withMatchCheck__family_of_arg(arg_value);
              IF arg_family EXISTS AS arg_family_value THEN
                IF !(withMatchCheck__disjunction_admits?(declared_families, arg_family_value)) THEN
                  error_handler(COPY call_site.node, "Call to '${call_site.callee_name}' requires parameter '${param_name}' to be bound under one of: ${family_names}. The argument here is in family ${arg_family_value}, which is not accepted by this function.");
                END
              ELSE
                error_handler(COPY call_site.node, "Call to '${call_site.callee_name}' requires parameter '${param_name}' to be bound under one of: ${family_names}. The argument here is bound without sync, which belongs to no family. Add a sync wrapper at the binding declaration (e.g., '@locked' or '@shared:locked').");
              END
            END
          END
        END
        idx = (idx + 1);
      END
    END
  END
  RETURN;
END
PUB FN withMatchCheck__family_of_arg(arg: Locatable) RETURNS ?String@symbol ->
  MUTABLE sym_opt: ?SymbolEntry@multiowned = withMatchCheck__capability_argument_symbol(arg);
  IF sym_opt == NIL THEN
    RETURN NIL;
  END
  MUTABLE sym: SymbolEntry@multiowned = COPY KEEP UNWRAP (sym_opt);
  MUTABLE sync: ?String@symbol = symbolEntry__sync(sym);
  IF ((sync != NIL) AND ([:locked, :write_locked, :always_mutable]).contains?(sync)) THEN
    RETURN :LOCKED;
  END
  IF ((sync != NIL) AND ([:versioned]).contains?(sync)) THEN
    RETURN :VERSIONED;
  END
  IF ((sync != NIL) AND ([:atomic]).contains?(sync)) THEN
    RETURN :ATOMIC;
  END
  IF symbolEntry__local?(sym) THEN
    RETURN :LOCAL;
  END
  IF ((symbolEntry__sync(sym) == NIL) AND (symbolEntry__storage(sym) == :multiowned)) THEN
    RETURN :LOCAL;
  END
  IF symbolEntry__plain_local_family?(sym) THEN
    RETURN :LOCAL;
  END
  RETURN NIL;
END
# Ruby walks `.symbol` up through GetField/GetIndex/value wrappers; the AST
# already exposes that walk as root_identifier, whose symbol is the one the
# capability check wants.
PRIVATE FN withMatchCheck__capability_argument_symbol(arg: Locatable) RETURNS ?SymbolEntry@multiowned ->
  IF aST__root_identifier(arg) EXISTS AS identifier THEN
    RETURN COPY KEEP identifier.symbol;
  END
  RETURN NIL;
END
PUB FN withMatchCheck__disjunction_admits?(disjunction: [Set]String@symbol, arg_family: String@symbol) RETURNS Bool ->
  RETURN (disjunction) |> ANY (IF (_ == arg_family) THEN TRUE ELSE (IF ((_ == :SNAPSHOTTED) AND (((arg_family == :VERSIONED) OR (arg_family == :ATOMIC)))) THEN TRUE ELSE FALSE END) END);
END
PUB FN withMatchCheck__family_of_arg_set(arg: Locatable) RETURNS ![Set]String@symbol ->
  MUTABLE sym_opt: ?SymbolEntry@multiowned = withMatchCheck__capability_argument_symbol(arg);
  IF sym_opt EXISTS AS sym_value THEN
    MUTABLE sym: SymbolEntry@multiowned = COPY KEEP sym_value;
    MUTABLE families: [Set]String@symbol = Set[];
    IF sym.sync_families EXISTS AS declared_sync_families THEN
      families = COPY declared_sync_families;
    END
    IF (families.length() > 1) THEN
      RETURN TRY (withMatchCheck__expand_snapshotted(families));
    END
    IF (families.length() == 1) THEN
      FOR single IN families DO
        IF (single == :SNAPSHOTTED) THEN
          MUTABLE snapshot_families: [Set]String@symbol = Set[];
          &snapshot_families.insert(:VERSIONED);
          &snapshot_families.insert(:ATOMIC);
          RETURN snapshot_families;
        END
      END
    END
  END
  MUTABLE fam: ?String@symbol = withMatchCheck__family_of_arg(arg);
  IF fam EXISTS AS fam_value THEN
    MUTABLE single_family: [Set]String@symbol = Set[];
    &single_family.insert(COPY fam_value);
    RETURN single_family;
  END
  MUTABLE no_family: [Set]String@symbol = Set[];
  RETURN no_family;
END
PUB FN withMatchCheck__expand_snapshotted(family_set: [Set]String@symbol) RETURNS ![Set]String@symbol ->
  IF !(family_set.contains?(:SNAPSHOTTED)) THEN
    RETURN COPY family_set;
  END
  MUTABLE out: [Set]String@symbol = Set[];
  FOR family IN family_set DO
    IF (family != :SNAPSHOTTED) THEN
      &out.insert(COPY family);
    END
  END
  &out.insert(:VERSIONED);
  &out.insert(:ATOMIC);
  RETURN out;
END
PUB FN withMatchCheck__errors_for_requires(family_set: ?[Set]String@symbol) RETURNS ![Set]String@symbol ->
  MUTABLE errors: [Set]String@symbol = Set[];
  FOR axis IN (TRY (withMatchCheck__admissible_axes(family_set))) DO
    IF ((axis == :locked) OR (axis == :write_locked)) THEN
      &errors.insert(:LockTimeout);
    ELSE_IF (axis == :versioned) THEN
      &errors.insert(:MvccConflict);
    ELSE_IF (axis == :atomic) THEN
      &errors.insert(:AtomicConflict);
    END
  END
  RETURN errors;
END
PUB FN withMatchCheck__warn_polymorphic_unhandled_errors_mut(node: WithBlock, bound_params: [Set]String, requires_map: {String}[Set]String@symbol, policy_handlers: []ErrorClause, warn_handler: ?FN(Locatable, String) -> Void) RETURNS !Void ->
  IF !(((warn_handler != NIL) AND (node.polymorphic OR_ELSE FALSE))) THEN
    RETURN;
  END
  MUTABLE handled = TRY (withMatchCheck__handled_error_set(node, policy_handlers));
  FOR bound_param IN bound_params DO
    IF requires_map[bound_param] EXISTS AS fams THEN
      IF !(fams.empty?()) THEN
        MUTABLE possible = TRY (withMatchCheck__errors_for_requires(fams));
        MUTABLE family_names: String = "";
        FOR family IN fams DO
          IF (family_names.length() == 0) THEN
            family_names = "${family}";
          ELSE
            family_names = "${family_names} | ${family}";
          END
        END
        FOR possible_error IN possible DO
          IF !(handled.contains?(possible_error)) THEN
            IF warn_handler EXISTS AS warn_handler_value THEN
              warn_handler_value(Locatable{ WithBlock: COPY node }, "Polymorphic error `${possible_error}` may fire under `REQUIRES ${bound_param}: ${family_names}` but no ON clause or SYNC POLICY handles it");
            END
          END
        END
      END
    END
  END
  RETURN;
END
PUB FN withMatchCheck__handled_error_set(node: WithBlock, policy_handlers: []ErrorClause) RETURNS ![Set]String@symbol ->
  MUTABLE handled: [Set]String@symbol = Set[];
  MUTABLE clauses: []ErrorClause = [];
  IF node.lock_error_clause EXISTS AS lock_clause THEN
    &clauses.append(COPY lock_clause);
  END
  FOR policy_handler IN policy_handlers DO
    &clauses.append(COPY policy_handler);
  END
  FOR clause IN clauses DO
    FOR selector IN clause.selectors DO
      IF (selector.form == :type) THEN
        &handled.insert(COPY selector.name);
      ELSE_IF (selector.form == :kind) THEN
        FOR kind_type IN (TRY (aST__types_for_kind(selector.name))) DO
          &handled.insert(COPY kind_type);
        END
      END
    END
  END
  RETURN handled;
END
# End Ruby module WithMatchCheck
