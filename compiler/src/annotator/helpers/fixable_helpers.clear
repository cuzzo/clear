EXTERN STRUCT CompilerRegex {} FROM "compiler_regex";
EXTERN FN compilerRegexCompile(pattern: String) RETURNS CompilerRegex EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexMatch(subject: String, regex: CompilerRegex) RETURNS Bool EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexReplaceAll(subject: String, regex: CompilerRegex, replacement: String) RETURNS String EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexEscape(value: String) RETURNS String EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexFirstMatch(subject: String, regex: CompilerRegex) RETURNS subject:?String EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerStringChomp(value: String, separator: String) RETURNS String EFFECTS :safe FROM "compiler_regex";

UNION FixableReg { VarDecl: VarDecl, DestructureTarget: DestructureTarget }
# Ruby module FixableHelper
PUB FN fixableHelpers__signed_order() RETURNS [4]String@symbol EFFECTS REENTRANT ->
  RETURN [:Int8, :Int16, :Int32, :Int64];
END
PUB FN fixableHelpers__unsigned_order() RETURNS [4]String@symbol EFFECTS REENTRANT ->
  RETURN [:Byte, :UInt16, :UInt32, :UInt64];
END
STRUCT CapabilityFixCandidate {
  sigil: String,
  description_code: String@symbol,
  description_params: {String@symbol}DiagnosticKwValue
}
STRUCT AutoCandidate {
  type_sym: String@symbol,
  note: ?String
}
# End Ruby module FixableHelper
