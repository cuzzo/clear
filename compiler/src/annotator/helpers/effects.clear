Multiowned: MinOp@multiowned, MaxOpMultiowned: MaxOp@multiowned, ShardOp: ShardOp, ConcurrentOp: ConcurrentOp, Placeholder: Placeholder, Copy: Copy, MIROptionalUnwrap: MIROptionalUnwrap, TenseNavigation: TenseNavigation, MutableBorrow: MutableBorrow, TenseOperationKindOrElseRaise: TenseOperationKindOrElseRaise, TenseOperationKindOrElseExit: TenseOperationKindOrElseExit, TenseOperationKindOrElsePass: TenseOperationKindOrElsePass, TenseOperationKindOrElsePrune: TenseOperationKindOrElsePrune, TenseOperationKindOrElseBreak: TenseOperationKindOrElseBreak, CatchBlock: CatchBlock, RecoverOp: RecoverOp, MIRBlockExpr: MIRBlockExpr, StringConcat: StringConcat, CapabilityWrap: CapabilityWrap, MoveNode: MoveNode, CopyNode: CopyNode, KeepNode: KeepNode, ShareNode: ShareNode, LinkNode: LinkNode, ResolveNode: ResolveNode, FreezeNode: FreezeNode, PassStmt: PassStmt, StructPattern: StructPattern, MIRRangeLit: MIRRangeLit, ExternFnDecl: ExternFnDecl, ExternStructDecl: ExternStructDecl, MIREnumDef: MIREnumDef, UnionDef: UnionDef, UnionVariantLit: UnionVariantLit, StaticCall: StaticCall, MIRDoBlock: MIRDoBlock, MIRBgBlock: MIRBgBlock, ThenChain: ThenChain, BgStreamBlock: BgStreamBlock, YieldExpr: YieldExpr, CloseStream: CloseStream, NextExpr: NextExpr, MatchStatement: MatchStatement, ForRange: ForRange, ForEach: ForEach, TestBlock: TestBlock, WhenBlock: WhenBlock, LetBinding: LetBinding, TestThat: TestThat, AssertRaisesMultiowned: AssertRaises@multiowned, BenchmarkStmtMultiowned: BenchmarkStmt@multiowned, SmashStmtMultiowned: SmashStmt@multiowned, ProfileStmtMultiowned: ProfileStmt@multiowned, StubDecl: StubDecl, Drop: Drop, SuppressCleanup: SuppressCleanup, Return: Return, ReassignCleanup: ReassignCleanup, FieldCleanup: FieldCleanup, ArrayValue: []Locatable, FunctionDef: FunctionDef, WithBlock: WithBlock, SelectOp: SelectOp, WhereOp: WhereOp, IndexOp: IndexOp, ReduceOp: ReduceOp, OrderByOp: OrderByOp, UnnestOp: UnnestOp, DistinctOp: DistinctOp, TakeWhileOp: TakeWhileOp, WindowOp: WindowOp, BatchWindowOp: BatchWindowOp, FindOp: FindOp, AnyOp: AnyOp, AllOp: AllOp, CountOp: CountOp, SumOp: SumOp, AverageOp: AverageOp, MinOp: MinOp, MaxOp: MaxOp, AssertRaises: AssertRaises, BenchmarkStmt: BenchmarkStmt, SmashStmt: SmashStmt, ProfileStmt: ProfileStmt }
PUB UNION AsyncSpawnNode { BgBlock: BgBlock, BgStreamBlock: BgStreamBlock }
PUB UNION AsyncStackTarget { BgBlock: BgBlock, BgStreamBlock: BgStreamBlock, DoBranch: DoBranch }
PUB UNION CallLikeNode { FuncCall: FuncCall, MethodCall: MethodCall }
PUB UNION TightLoopNode { WhileLoop: WhileLoop, ForRange: ForRange }
PUB STRUCT EffectState {
  direct_effects: {String}[Set]String@symbol,
  call_site_context: {String}{String}{String@symbol}Bool,
  call_site_arg_families: {String}{String}[][][Set]String@symbol
}
suspends_family: [3]String@symbol = [:SUSPENDS, :SUSPENDS_CONDITIONAL, :SUSPENDS_LOOP];
all_effects: [13]String@symbol = [:HEAP, :BLOCKING, :REENTRANT, :LOOP_UNBOUND, symbol("EXTERN"), symbol("YIELD"), :IO, :SUSPENDS, :SUSPENDS_CONDITIONAL, :SUSPENDS_LOOP, :CONTENTION, :CONTENTION_MAYBE, :BLOCKING_MAYBE];
PUB FN effectTracker__display(effect: String@symbol) RETURNS String ->
  IF (effect == :SUSPENDS) THEN
    RETURN "SUSPENDS";
  ELSE_IF (effect == :SUSPENDS_CONDITIONAL) THEN
    RETURN "SUSPENDS:CONDITIONAL";
  ELSE_IF (effect == :SUSPENDS_LOOP) THEN
    RETURN "SUSPENDS:LOOP";
  ELSE
    RETURN COPY CAST(effect AS String);
  END
END
