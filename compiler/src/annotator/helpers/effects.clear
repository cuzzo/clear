FN castTightLoopNodeToLocatable(value: TightLoopNode) RETURNS ?Locatable ->
  PARTIAL MATCH value START
    TightLoopNode.WhileLoop AS item -> RETURN Locatable{ WhileLoop: COPY item };,
    TightLoopNode.ForRange AS item -> RETURN Locatable{ ForRange: COPY item };,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END

# Ruby asks `respond_to?(:stack_size)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN asyncSpawnNode__stack_size(value: AsyncSpawnNode) RETURNS ?String@symbol ->
  PARTIAL MATCH value START
    AsyncSpawnNode.BgBlock AS item -> RETURN COPY item.stack_size;,
    AsyncSpawnNode.BgStreamBlock AS item -> RETURN COPY item.stack_size;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
# Ruby asks `respond_to?(:matched_stdlib_def)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN callLikeNode__matched_stdlib_def(value: CallLikeNode) RETURNS ?FunctionSignature@multiowned ->
  PARTIAL MATCH value START
    CallLikeNode.FuncCall AS item -> RETURN COPY item.matched_stdlib_def;,
    CallLikeNode.MethodCall AS item -> RETURN COPY item.matched_stdlib_def;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END

# The mirror of asyncStackTarget__computed_stack_tier: a variant that carries the field takes
# the write, and one that does not ignores it -- which is what Ruby does
# when the node has no such attribute.
PUB FN asyncStackTarget__set_computed_stack_tier_mut(MUTABLE value: AsyncStackTarget, new_value: ?String@symbol) RETURNS Void ->
  PARTIAL MATCH value START
    AsyncStackTarget.BgBlock AS MUTABLE item -> item.computed_stack_tier = COPY new_value;,
    AsyncStackTarget.BgStreamBlock AS MUTABLE item -> item.computed_stack_tier = COPY new_value;,
    AsyncStackTarget.DoBranch AS MUTABLE item -> item.computed_stack_tier = COPY new_value;,
    DEFAULT -> RETURN;
  END
END

