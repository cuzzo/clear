PRIVATE FN functionSignature__normalize_lifetime(self: FunctionSignature, val: ?FunctionSignatureLifetimeInput) RETURNS ![]FunctionSignatureLifetimeSource
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF val EXISTS AS val_value THEN
      MUTABLE raw: []FunctionSignatureLifetimeSource = ( { MUTABLE rtoc_empty_list_9: []FunctionSignatureLifetimeSource = List[]; rtoc_empty_list_9 } );
      IF val_value IS_A []FunctionSignatureLifetimeSource AS array THEN
      FOR rtoc_array_item_10 IN array DO
          &raw.append(COPY rtoc_array_item_10);
        END
      ELSE
      &raw.append(COPY castFunctionSignatureLifetimeInputToFunctionSignatureLifetimeSource(val_value));
      END
      MUTABLE out: []FunctionSignatureLifetimeSource = ( { MUTABLE rtoc_empty_list_11: []FunctionSignatureLifetimeSource = List[]; rtoc_empty_list_11 } );
      MUTABLE i: Int64 = 0;
      WHILE (i < raw.length()) DO
        MUTABLE item = COPY UNWRAP (raw[i]);
        IF item IS_A String@symbol AS string_symbol THEN
          &out.append(FunctionSignatureLifetimeSource{ StringValue: COPY CAST(string_symbol AS String) });
        ELSE
          &out.append(COPY item);
        END
        i = (i + 1);
      END
      RETURN out;
    ELSE
      RETURN CAST(( { MUTABLE rtoc_empty_list_12: []FunctionSignatureLifetimeSource = List[]; rtoc_empty_list_12 } ) AS []FunctionSignatureLifetimeSource);
    END
}
END
