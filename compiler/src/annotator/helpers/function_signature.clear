  TRY (functionSignature__initialize(&self, params, return_type, return_lifetime, visibility, type_params, generic_bounds, reentrant, extern, module_alias, extern_effects, extern_source, fn_type_params, owner_type, owner_type_params, intrinsic, needs_rt, can_fail, alloc_fault, error_fallible, effects, return_strategy, stack_tier, requires, heap_carry_return, heap_carry_return_vars, arg_validator, arg_spec, arity, emit, return_def));
