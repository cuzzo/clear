PUB FN functionSignature__initialize(MUTABLE self: FunctionSignature, params: []Param, return_type: ?TypeTypeInput = NIL, return_lifetime: ?FunctionSignatureLifetimeInput = NIL, visibility: ?String@symbol = NIL, type_params: []String@symbol, generic_bounds: {String@symbol}[]Type, reentrant: Bool = FALSE, extern_value: Bool = FALSE, module_alias: ?String = NIL, extern_effects: ?{String@symbol}ExternEffectValue = NIL, extern_source: ?ExternSource = NIL, fn_type_params: []String@symbol, owner_type: ?String = NIL, owner_type_params: []String@symbol, intrinsic: Bool = FALSE, needs_rt: ?Bool = NIL, can_fail: ?Bool = NIL, alloc_fault: ?Bool = NIL, error_fallible: ?Bool = NIL, effects_value: ?[Set]String@symbol = NIL, return_strategy: ?String@symbol = NIL, stack_tier: ?String@symbol = NIL, requires_value: ?{String}[Set]String@symbol = NIL, heap_carry_return: ?Bool = NIL, heap_carry_return_vars: ?[Set]String = NIL, arg_validator: ?String@symbol = NIL, arg_spec: ?IntrinsicArgSpecRawArgSpec = NIL, arity: ?Int64 = NIL, emit: ?IntrinsicEmit = NIL, return_def: ?FunctionReturn = NIL) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.contract = TRY (contract__new(params, visibility, type_params, reentrant, extern_value, module_alias, (extern_effects OR_ELSE {}), extern_source, fn_type_params, owner_type, owner_type_params, intrinsic));
    rtoc_self_view.generic_bounds = ( { MUTABLE rtoc_transform_values_result_7: {String@symbol}[]Type = {}; FOR rtoc_key IN generic_bounds.keys() DO rtoc_transform_values_result_7[rtoc_key] = { MUTABLE rtoc_value_block_marker = 0;
    MUTABLE bounds: []Type = (generic_bounds[rtoc_key] OR_ELSE CAST(panic("missing hash key") AS []Type));
    bounds |> SELECT TRY (type__new(TypeConstructionInput{ Type: COPY _ }))
    }; END rtoc_transform_values_result_7 } );
    rtoc_self_view.facts = AnalysisFacts{ needs_rt: COPY needs_rt, can_fail: COPY can_fail, alloc_fault: COPY alloc_fault, error_fallible: COPY error_fallible, effects: COPY effects_value, return_strategy: COPY return_strategy, stack_tier: COPY stack_tier, requires: COPY TRY (functionSignature__copy_requires_for_import((requires_value OR_ELSE {}))), heap_carry_return: COPY heap_carry_return, heap_carry_return_vars: COPY heap_carry_return_vars, arg_validator: COPY arg_validator, intrinsic_arg_specs: COPY TRY (intrinsicArgSpec__list_from_registry(arg_spec)), intrinsic_fixed_arg_list: intrinsicArgSpec__fixed_list_from_registry?(arg_spec), intrinsic_varargs: intrinsicArgSpec__varargs_from_registry?(arg_spec), arity: COPY arity, emit: COPY emit, return_def: return_def };
    rtoc_self_view.contract.return_type = CAST(TRY (functionSignature__coerce_return_type(rtoc_self_view, return_type)) AS Type);
    rtoc_self_view.contract.return_lifetime = TRY (functionSignature__normalize_lifetime(rtoc_self_view, return_lifetime));
    rtoc_self_view.intrinsic_contract = NIL;
}
END
PUB FN functionSignature__replace_return_type_mut(MUTABLE self: FunctionSignature, return_type: ?TypeTypeInput) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.contract.return_type = CAST(TRY (functionSignature__coerce_return_type(rtoc_self_view, return_type)) AS Type);
    rtoc_self_view;
}
END
