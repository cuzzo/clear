PUB FN functionSignature__copy_requires_for_import(requires_value: {String}[Set]String@symbol) RETURNS !{String}[Set]String@symbol ->
  MUTABLE copied: {String}[Set]String@symbol = {};
  requires_value.keys() |> EACH {
  MUTABLE families: [Set]String@symbol = (requires_value[_] OR_ELSE CAST(panic("missing hash key") AS [Set]String@symbol));
  copied[_] = COPY families;
  };
  RETURN copied;
END
