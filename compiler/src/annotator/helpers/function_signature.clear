PUB UNION Borrows { SymbolValue: String@symbol, ArrayValue: []String@symbol }
PUB UNION FunctionSignatureReturnValue { StringValue: String, SymbolValue: String@symbol }
PUB UNION X { Type: Type, FunctionSignatureMultiowned: FunctionSignature@multiowned, ArrayValue: []FunctionSignature@multiowned, FunctionSignature: FunctionSignature }
PUB STRUCT FunctionSignature {
  contract: Contract@multiowned,
  facts: AnalysisFacts,
  generic_bounds: {String@symbol}[]Type@multiowned,
  intrinsic_contract: ?IntrinsicContract
}

PUB UNION FunctionSignatureLifetimeSource { StringValue: String, SymbolValue: String@symbol }
PUB UNION FunctionSignatureLifetimeInput { StringValue: String, SymbolValue: String@symbol, ArrayValue: []FunctionSignatureLifetimeSource }
UNION FunctionSignatureSyncSource { FunctionDefMultiowned: FunctionDef@multiowned, FunctionDef: FunctionDef }
PUB STRUCT Contract {
  extern: Bool,
  extern_effects: {String@symbol}ExternEffectValue,
  extern_source: ?ExternSource,
  fn_type_params: []String@symbol,
  intrinsic: Bool,
  module_alias: ?String,
  owner_type: ?String,
  owner_type_params: []String@symbol,
  params: []Param,
  reentrant: Bool,
  return_lifetime: []FunctionSignatureLifetimeSource,
  return_type: Type,
  type_params: []String@symbol,
  visibility: ?String@symbol
}

FN contract__initialize(MUTABLE self: Contract, params: []Param, visibility: ?String@symbol = NIL, type_params: []String@symbol, reentrant: Bool = FALSE, extern_value: Bool = FALSE, module_alias: ?String = NIL, extern_effects: {String@symbol}ExternEffectValue, extern_source: ?ExternSource = NIL, fn_type_params: []String@symbol, owner_type: ?String = NIL, owner_type_params: []String@symbol, intrinsic: Bool = FALSE) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.params = COPY params;
    rtoc_self_view.return_type = TRY (type__new(TypeConstructionInput{ SymbolValue: :Void }));
    rtoc_self_view.return_lifetime = List[];
    rtoc_self_view.visibility = COPY visibility;
    rtoc_self_view.type_params = COPY type_params;
    rtoc_self_view.reentrant = COPY reentrant;
    rtoc_self_view.extern = COPY extern_value;
    rtoc_self_view.module_alias = COPY module_alias;
    rtoc_self_view.extern_effects = COPY extern_effects;
    rtoc_self_view.extern_source = COPY extern_source;
    rtoc_self_view.fn_type_params = COPY fn_type_params;
    rtoc_self_view.owner_type = COPY owner_type;
    rtoc_self_view.owner_type_params = COPY owner_type_params;
    rtoc_self_view.intrinsic = COPY intrinsic;
}
END
FN contract__new(params: []Param, visibility: ?String@symbol = NIL, type_params: []String@symbol, reentrant: Bool = FALSE, extern: Bool = FALSE, module_alias: ?String = NIL, extern_effects: {String@symbol}ExternEffectValue, extern_source: ?ExternSource = NIL, fn_type_params: []String@symbol, owner_type: ?String = NIL, owner_type_params: []String@symbol, intrinsic: Bool = FALSE) RETURNS !Contract@multiowned ->
  MUTABLE self = Contract{ extern: extern, extern_effects: COPY extern_effects, extern_source: COPY extern_source, fn_type_params: COPY fn_type_params, intrinsic: intrinsic, module_alias: COPY module_alias, owner_type: COPY owner_type, owner_type_params: COPY owner_type_params, params: COPY params, reentrant: reentrant, return_lifetime: List[], return_type: TRY (type__new(TypeConstructionInput{ SymbolValue: :Void })), type_params: COPY type_params, visibility: COPY visibility };
  TRY (contract__initialize(&self, params, visibility, type_params, reentrant, extern, module_alias, extern_effects, extern_source, fn_type_params, owner_type, owner_type_params, intrinsic));
  RETURN self @multiowned;
END
PUB STRUCT AnalysisFacts {
  needs_rt: ?Bool,
  can_fail: ?Bool,
  alloc_fault: ?Bool,
  error_fallible: ?Bool,
  effects: ?[Set]String@symbol,
  return_strategy: ?String@symbol,
  stack_tier: ?String@symbol,
  requires: {String}[Set]String@symbol,
  heap_carry_return: ?Bool,
  heap_carry_return_vars: ?[Set]String,
  arg_validator: ?String@symbol,
  intrinsic_arg_specs: []IntrinsicArgSpec,
  intrinsic_fixed_arg_list: Bool,
  intrinsic_varargs: Bool,
  arity: ?Int64,
  emit: ?IntrinsicEmit,
  return_def: ?FunctionReturn@multiowned
}

FN analysisFacts__copy(self: AnalysisFacts) RETURNS !AnalysisFacts ->
  RETURN AnalysisFacts{ needs_rt: self.needs_rt, can_fail: self.can_fail, alloc_fault: self.alloc_fault, error_fallible: self.error_fallible, effects: COPY self.effects, return_strategy: COPY self.return_strategy, stack_tier: COPY self.stack_tier, requires: COPY TRY (functionSignature__copy_requires_for_import(self.requires)), heap_carry_return: self.heap_carry_return, heap_carry_return_vars: COPY self.heap_carry_return_vars, arg_validator: KEEP self.arg_validator, intrinsic_arg_specs: COPY self.intrinsic_arg_specs, intrinsic_fixed_arg_list: self.intrinsic_fixed_arg_list, intrinsic_varargs: self.intrinsic_varargs, arity: self.arity, emit: COPY self.emit, return_def: KEEP self.return_def };
END
