PUB FN functionSignature__replace_intrinsic_emit_mut(MUTABLE self: FunctionSignature, emit: ?IntrinsicEmit) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF emit EXISTS AS emit_value THEN
      rtoc_self_view.facts.emit = COPY emit_value;
    ELSE
      rtoc_self_view.facts.emit = NIL;
    END
    rtoc_self_view.intrinsic_contract = NIL;
    rtoc_self_view;
}
END
