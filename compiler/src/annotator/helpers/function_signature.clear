PUB FN functionSignature__with_intrinsic_override(self: FunctionSignature, pattern: IntrinsicEmitStrOrSym, alloc: ?String@symbol = NIL) RETURNS !FunctionSignature@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE copy: FunctionSignature@multiowned = TRY (functionSignature__dup(rtoc_self_view));
    MUTABLE emit_copy: IntrinsicEmit = IntrinsicEmit{ zig: NIL, numeric_zig: NIL, sharded_zig: NIL, shard_direct_zig: NIL, fsm_setup: List[], fsm_state_decls: List[], fsm_finish_block: List[], fsm_state_finalize: List[], fsm_setup_present: FALSE, fsm_state_decls_present: FALSE, fsm_finish_block_present: FALSE, fsm_state_finalize_present: FALSE, fsm_finish_value: NIL, bc: FALSE, is_method: FALSE, suspends: FALSE, narrows_collection: FALSE, narrows_receiver_collection: FALSE, mutates_receiver: FALSE, allocates: FALSE, takes_value: FALSE, container_borrow: FALSE, tag: NIL, builtin: NIL, alloc: NIL, return_alloc: NIL, val_alloc: NIL, key_alloc: NIL, shard_alloc: NIL, sharded_alloc: NIL, borrows: NIL, reject_when: NIL, bc_op: NIL, error_kind: NIL, error_type: NIL, registry: NIL, elem: NIL, fallible_clauses: NIL, lifetime: List[], reject_error: NIL, arity: NIL, takes_args: List[], label: NIL, eql: NIL, strcmp: NIL, cleanup: NIL, assert: NIL, array: NIL, list: NIL, pool: NIL, set: NIL, get: NIL, string_raw: NIL, string_symbol: NIL, string_map: NIL, numeric_map: NIL, set_collection: NIL };
    IF functionSignature__emit(copy) THEN
      emit_copy = COPY UNWRAP (functionSignature__emit(copy));
    END
    IF pattern IS_A String@symbol AS string_symbol THEN
      emit_copy.zig = COPY IntrinsicEmitStrOrSym{ SymbolValue: COPY string_symbol };
    ELSE_IF pattern IS_A String AS string THEN
      emit_copy.zig = COPY IntrinsicEmitStrOrSym{ StringValue: COPY string };
    END
    IF alloc EXISTS AS alloc_value THEN
      emit_copy.alloc = COPY alloc_value;
    END
    functionSignature__replace_intrinsic_emit_mut(&copy, emit_copy);
    RETURN copy;
}
END
