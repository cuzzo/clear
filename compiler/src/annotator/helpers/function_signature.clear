PUB FN functionSignature__template_kind_label(kind: IntrinsicTemplateKind) RETURNS String ->
  IF (kind == IntrinsicTemplateKind.Zig) THEN
    RETURN "zig";
  END
  IF (kind == IntrinsicTemplateKind.NumericZig) THEN
    RETURN "numeric_zig";
  END
  IF (kind == IntrinsicTemplateKind.ShardedZig) THEN
    RETURN "sharded_zig";
  END
  IF (kind == IntrinsicTemplateKind.ShardDirectZig) THEN
    RETURN "shard_direct_zig";
  END
  RETURN "unknown";
END
