FN castFunctionSignatureLifetimeInputToFunctionSignatureLifetimeSource(value: FunctionSignatureLifetimeInput) RETURNS FunctionSignatureLifetimeSource ->
  PARTIAL MATCH value START
    FunctionSignatureLifetimeInput.StringValue AS cast_payload -> RETURN FunctionSignatureLifetimeSource{ StringValue: COPY cast_payload };,
    FunctionSignatureLifetimeInput.SymbolValue AS cast_payload -> RETURN FunctionSignatureLifetimeSource{ SymbolValue: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to FunctionSignatureLifetimeSource");
  END
  panic("Invalid cast to FunctionSignatureLifetimeSource");
END
FN castOptionalIntrinsicEmitStrOrSymToOptionalFunctionSignatureReturnValue(value: ?IntrinsicEmitStrOrSym) RETURNS ?FunctionSignatureReturnValue ->
  IF value == NIL THEN
    panic("Invalid cast to ?FunctionSignatureReturnValue");
  END
  PARTIAL MATCH value? START
    IntrinsicEmitStrOrSym.StringValue AS cast_payload -> RETURN FunctionSignatureReturnValue{ StringValue: COPY cast_payload };,
    IntrinsicEmitStrOrSym.SymbolValue AS cast_payload -> RETURN FunctionSignatureReturnValue{ SymbolValue: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to ?FunctionSignatureReturnValue");
  END
  panic("Invalid cast to ?FunctionSignatureReturnValue");
END
FN castTypeTypeInputToTypeConstructionInput(value: TypeTypeInput) RETURNS TypeConstructionInput ->
  PARTIAL MATCH value START
    TypeTypeInput.FunctionType AS cast_payload -> RETURN TypeConstructionInput{ FunctionType: COPY cast_payload };,
    TypeTypeInput.Type AS cast_payload -> RETURN TypeConstructionInput{ Type: COPY cast_payload };,
    TypeTypeInput.SymbolValue AS cast_payload -> RETURN TypeConstructionInput{ SymbolValue: COPY cast_payload };,
    TypeTypeInput.StringValue AS cast_payload -> RETURN TypeConstructionInput{ StringValue: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to TypeConstructionInput");
  END
  panic("Invalid cast to TypeConstructionInput");
END
