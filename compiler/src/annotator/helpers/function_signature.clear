PUB FN functionSignature__unwrap(x: ?X) RETURNS ?FunctionSignature@multiowned ->
  IF x? IS_A FunctionSignature AS function_signature THEN
    MUTABLE rtoc_owned_return_2: ?FunctionSignature@multiowned = function_signature;
    RETURN rtoc_owned_return_2;
  END
  IF x? IS_A Type AS type THEN
    MUTABLE type = COPY type;
    MUTABLE function_type: ?FunctionType = type__function_type(type);
    IF function_type EXISTS AS function_type_value THEN
      # The slot records only whether type.clear memoized a signature; that
      # module sits below FunctionSignature and cannot name it.
      IF function_type_value.source_signature EXISTS AS source_signature_value THEN
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
  END
  RETURN NIL;
END
PUB FN functionSignature__intrinsic_signature(return_type: Type = TRY (type__new(TypeConstructionInput{ SymbolValue: :Void })), allocates: Bool = FALSE, borrows: ?Borrows = NIL, can_fail: ?Bool = NIL, return_alloc: ?String@symbol = NIL) RETURNS !FunctionSignature@multiowned ->
  RETURN TRY (functionSignature__new(( { MUTABLE rtoc_empty_list_3: []Param = List[]; rtoc_empty_list_3 } ), TypeTypeInput{ Type: COPY return_type }, NIL, NIL, ( { MUTABLE rtoc_empty_list_4: []String@symbol = List[]; rtoc_empty_list_4 } ), {}, FALSE, FALSE, NIL, NIL, NIL, ( { MUTABLE rtoc_empty_list_5: []String@symbol = List[]; rtoc_empty_list_5 } ), NIL, ( { MUTABLE rtoc_empty_list_6: []String@symbol = List[]; rtoc_empty_list_6 } ), TRUE, NIL, can_fail, NIL, NIL, NIL, NIL, NIL, NIL, NIL, NIL, NIL, NIL, NIL, IntrinsicEmit{ allocates: COPY allocates, borrows: borrows, return_alloc: COPY return_alloc, zig: NIL, numeric_zig: NIL, sharded_zig: NIL, shard_direct_zig: NIL, fsm_setup: List[], fsm_state_decls: List[], fsm_finish_block: List[], fsm_state_finalize: List[], fsm_setup_present: FALSE, fsm_state_decls_present: FALSE, fsm_finish_block_present: FALSE, fsm_state_finalize_present: FALSE, fsm_finish_value: NIL, bc: FALSE, is_method: FALSE, suspends: FALSE, narrows_collection: FALSE, narrows_receiver_collection: FALSE, mutates_receiver: FALSE, takes_value: FALSE, container_borrow: FALSE, tag: NIL, builtin: NIL, alloc: NIL, val_alloc: NIL, key_alloc: NIL, shard_alloc: NIL, sharded_alloc: NIL, reject_when: NIL, bc_op: NIL, error_kind: NIL, error_type: NIL, registry: NIL, elem: NIL, fallible_clauses: NIL, lifetime: List[], reject_error: NIL, arity: NIL, takes_args: List[], label: NIL, eql: NIL, strcmp: NIL, cleanup: NIL, assert: NIL, array: NIL, list: NIL, pool: NIL, set: NIL, get: NIL, string_raw: NIL, string_symbol: NIL, string_map: NIL, numeric_map: NIL, set_collection: NIL }));
