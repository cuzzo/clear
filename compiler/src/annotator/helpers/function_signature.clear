PUB FN functionSignature__recoverable_result?(self: FunctionSignature) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF rtoc_self_view.facts.error_fallible EXISTS AS optional_value_value THEN
      RETURN (optional_value_value == TRUE);
    ELSE
      RETURN (functionSignature__can_fail(rtoc_self_view) == TRUE);
    END
}
END
PUB FN functionSignature__mutates_receiver?(MUTABLE self: FunctionSignature) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN ((TRY (functionSignature__intrinsic_contract(&rtoc_self_view))).ownership).mutates_receiver;
