PUB FN functionSignature__borrowing_intrinsic() RETURNS !FunctionSignature@multiowned ->
  RETURN TRY (functionSignature__intrinsic_signature(TRY (type__new(TypeConstructionInput{ SymbolValue: :Void })), FALSE, Borrows{ SymbolValue: :all }));
