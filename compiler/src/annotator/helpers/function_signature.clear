PUB FN functionSignature__allocating_intrinsic() RETURNS !FunctionSignature@multiowned ->
  RETURN TRY (functionSignature__intrinsic_signature(TRY (type__new(TypeConstructionInput{ SymbolValue: :Void })), TRUE));
