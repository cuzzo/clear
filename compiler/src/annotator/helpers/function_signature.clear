PUB FN functionSignature__adopt_param_symbols_mut(self: FunctionSignature, fn_value: FunctionDef) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < rtoc_self_view.contract.params.length() DO
      MUTABLE src: ?Param = COPY fn_value.params[rtoc_idx];
      IF rtoc_self_view.contract.params[rtoc_idx] != NIL THEN
          MUTABLE rtoc_field_slot_8 = COPY UNWRAP (rtoc_self_view.contract.params[rtoc_idx]);
          rtoc_field_slot_8.symbol = (rtoc_field_slot_8.symbol OR_ELSE src?.symbol);
          rtoc_self_view.contract.params[rtoc_idx] = rtoc_field_slot_8;
        END
    rtoc_idx = rtoc_idx + 1;
    END
}
END
