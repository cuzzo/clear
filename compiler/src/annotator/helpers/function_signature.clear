PUB FN functionSignature__intrinsic_contract(MUTABLE self: FunctionSignature) RETURNS !IntrinsicContract
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF rtoc_self_view.intrinsic_contract == NIL THEN
        MUTABLE emit: ?IntrinsicEmit = COPY rtoc_self_view.facts.emit;
      rtoc_self_view.intrinsic_contract = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_1: ?IntrinsicContract = NIL;
        IF emit != NIL THEN
          rtoc_ternary_value_1 = TRY (intrinsicContract__from_emit(emit, rtoc_self_view.contract.params));
        ELSE
          rtoc_ternary_value_1 = intrinsicContract__empty();
        END
        rtoc_ternary_value_1? };  END
    RETURN UNWRAP (rtoc_self_view.intrinsic_contract);
}
END
