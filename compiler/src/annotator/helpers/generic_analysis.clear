FN castDeclarationNodeToLocatable(value: DeclarationNode) RETURNS ?Locatable ->
  PARTIAL MATCH value START
    DeclarationNode.VarDecl AS item -> RETURN Locatable{ VarDecl: COPY item };,
    DeclarationNode.BindExpr AS item -> RETURN Locatable{ BindExpr: COPY item };,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
FN castGenericCallNodeToLocatable(value: GenericCallNode) RETURNS ?Locatable ->
  PARTIAL MATCH value START
    GenericCallNode.FuncCall AS item -> RETURN Locatable{ FuncCall: COPY item };,
    GenericCallNode.MethodCall AS item -> RETURN Locatable{ MethodCall: COPY item };,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
FN castGenericDeclarationNodeToLocatable(value: GenericDeclarationNode) RETURNS ?Locatable ->
  PARTIAL MATCH value START
    GenericDeclarationNode.FunctionDefMultiowned AS item -> RETURN Locatable{ FunctionDef: COPY item };,
    GenericDeclarationNode.StructDef AS item -> RETURN Locatable{ StructDef: COPY item };,
    GenericDeclarationNode.UnionDef AS item -> RETURN Locatable{ UnionDef: COPY item };,
    GenericDeclarationNode.FunctionDef AS item -> RETURN Locatable{ FunctionDef: COPY item };,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END

# Ruby asks `respond_to?(:name)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN declarationNode__name(value: DeclarationNode) RETURNS ?String ->
  PARTIAL MATCH value START
    DeclarationNode.VarDecl AS item -> RETURN COPY item.name;,
    DeclarationNode.BindExpr AS item -> RETURN COPY item.name;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
# Ruby asks `respond_to?(:slot_size)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN declarationNode__slot_size(value: DeclarationNode) RETURNS ?Int64 ->
  PARTIAL MATCH value START
    DeclarationNode.VarDecl AS item -> RETURN COPY item.slot_size;,
    DeclarationNode.BindExpr AS item -> RETURN COPY item.slot_size;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
# Ruby asks `respond_to?(:symbol)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN declarationNode__symbol(value: DeclarationNode) RETURNS ?SymbolEntry@multiowned ->
  PARTIAL MATCH value START
    DeclarationNode.VarDecl AS item -> RETURN COPY item.symbol;,
    DeclarationNode.BindExpr AS item -> RETURN COPY item.symbol;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
# Ruby asks `respond_to?(:type)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN declarationNode__type(value: DeclarationNode) RETURNS ?Type ->
  PARTIAL MATCH value START
    DeclarationNode.VarDecl AS item -> RETURN COPY item.type;,
    DeclarationNode.BindExpr AS item -> RETURN COPY item.type;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
# Ruby asks `respond_to?(:value)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN declarationNode__value(value: DeclarationNode) RETURNS ?Locatable@boxed ->
  PARTIAL MATCH value START
    DeclarationNode.VarDecl AS item -> RETURN COPY item.value;,
    DeclarationNode.BindExpr AS item -> RETURN COPY item.value;,
    DEFAULT -> RETURN NIL;
  END
