    Locatable.CopyNode AS item -> RETURN ShardScanNode{ CopyNode: COPY item };,
    Locatable.KeepNode AS item -> RETURN ShardScanNode{ KeepNode: COPY item };,
    Locatable.ShareNode AS item -> RETURN ShardScanNode{ ShareNode: COPY item };,
    Locatable.LinkNode AS item -> RETURN ShardScanNode{ LinkNode: COPY item };,
    Locatable.ResolveNode AS item -> RETURN ShardScanNode{ ResolveNode: COPY item };,
    Locatable.FreezeNode AS item -> RETURN ShardScanNode{ FreezeNode: COPY item };,
    Locatable.PassStmt AS item -> RETURN ShardScanNode{ PassStmt: COPY item };,
    Locatable.StructPattern AS item -> RETURN ShardScanNode{ StructPattern: COPY item };,
    Locatable.ExternFnDecl AS item -> RETURN ShardScanNode{ ExternFnDecl: COPY item };,
    Locatable.ExternStructDecl AS item -> RETURN ShardScanNode{ ExternStructDecl: COPY item };,
    Locatable.UnionDef AS item -> RETURN ShardScanNode{ UnionDef: COPY item };,
    Locatable.UnionVariantLit AS item -> RETURN ShardScanNode{ UnionVariantLit: COPY item };,
    Locatable.StaticCall AS item -> RETURN ShardScanNode{ StaticCall: COPY item };,
    Locatable.ThenChain AS item -> RETURN ShardScanNode{ ThenChain: COPY item };,
    Locatable.BgStreamBlock AS item -> RETURN ShardScanNode{ BgStreamBlock: COPY item };,
    Locatable.YieldExpr AS item -> RETURN ShardScanNode{ YieldExpr: COPY item };,
    Locatable.CloseStream AS item -> RETURN ShardScanNode{ CloseStream: COPY item };,
    Locatable.NextExpr AS item -> RETURN ShardScanNode{ NextExpr: COPY item };,
    Locatable.MatchStatement AS item -> RETURN ShardScanNode{ MatchStatement: COPY item };,
    Locatable.ForRange AS item -> RETURN ShardScanNode{ ForRange: COPY item };,
    Locatable.ForEach AS item -> RETURN ShardScanNode{ ForEach: COPY item };,
    Locatable.TestBlock AS item -> RETURN ShardScanNode{ TestBlock: COPY item };,
    Locatable.WhenBlock AS item -> RETURN ShardScanNode{ WhenBlock: COPY item };,
    Locatable.LetBinding AS item -> RETURN ShardScanNode{ LetBinding: COPY item };,
    Locatable.TestThat AS item -> RETURN ShardScanNode{ TestThat: COPY item };,
    Locatable.AssertRaises AS item -> RETURN ShardScanNode{ AssertRaises: COPY item };,
    Locatable.BenchmarkStmt AS item -> RETURN ShardScanNode{ BenchmarkStmt: COPY item };,
    Locatable.SmashStmt AS item -> RETURN ShardScanNode{ SmashStmt: COPY item };,
    Locatable.ProfileStmt AS item -> RETURN ShardScanNode{ ProfileStmt: COPY item };,
    Locatable.StubDecl AS item -> RETURN ShardScanNode{ StubDecl: COPY item };,
    Locatable.Drop AS item -> RETURN ShardScanNode{ Drop: COPY item };,
    Locatable.SuppressCleanup AS item -> RETURN ShardScanNode{ SuppressCleanup: COPY item };,
    Locatable.Return AS item -> RETURN ShardScanNode{ Return: COPY item };,
    Locatable.ReassignCleanup AS item -> RETURN ShardScanNode{ ReassignCleanup: COPY item };,
    Locatable.FieldCleanup AS item -> RETURN ShardScanNode{ FieldCleanup: COPY item };,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
