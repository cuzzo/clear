PUB STRUCT PipeArityPlan {
  params: []Param,
  min_args: Int64,
  max_args: Int64,
  given_args: Int64
}

PUB FN pipeArityPlan__mismatch?(self: PipeArityPlan) RETURNS Bool ->
  RETURN ((self.given_args < self.min_args) OR (self.given_args > self.max_args));
END
PUB FN pipeArityPlan__exact?(self: PipeArityPlan) RETURNS Bool ->
  RETURN (self.min_args == self.max_args);
END
PUB STRUCT PipelineSourceFact {
  kind: String@symbol,
  item_type: Type
}

PUB FN pipelineSourceFact__stream?(self: PipelineSourceFact) RETURNS Bool ->
  RETURN (pipelineSourceFact__valid?(self) AND (self.kind != :collection));
END
PUB FN pipelineSourceFact__finite_stream?(self: PipelineSourceFact) RETURNS Bool ->
  RETURN (pipelineSourceFact__stream?(self) AND (self.kind != :inf_stream));
END
PUB FN pipelineSourceFact__inf_stream?(self: PipelineSourceFact) RETURNS Bool ->
  RETURN (self.kind == :inf_stream);
END
PUB FN pipelineSourceFact__valid?(self: PipelineSourceFact) RETURNS Bool ->
  RETURN (self.kind != :invalid);
END
PUB STRUCT SelectorEffectFact {
  plan: TenseSelectorPlan
}

PUB FN selectorEffectFact__value_type(self: SelectorEffectFact) RETURNS Type EFFECTS REENTRANT ->
  RETURN COPY self.plan.value_type;
END
PUB FN selectorEffectFact__asynchronous(self: SelectorEffectFact) RETURNS Bool ->
  RETURN tenseSelectorPlan__asynchronous?(self.plan);
END
PUB FN selectorEffectFact__required_mode(self: SelectorEffectFact) RETURNS ?String@symbol EFFECTS REENTRANT ->
  RETURN tenseSelectorPlan__required_mode(self.plan);
END
PUB FN selectorEffectFact__required_order(self: SelectorEffectFact) RETURNS String EFFECTS REENTRANT ->
  RETURN tenseSelectorPlan__required_order(self.plan);
END
PUB FN selectorEffectFact__leaf_type(self: SelectorEffectFact) RETURNS !Type EFFECTS REENTRANT ->
  RETURN CAST(tenseSelectorPlan__leaf_type(self.plan) AS Type);
END
PUB FN selectorEffectFact__fallible?(self: SelectorEffectFact) RETURNS Bool EFFECTS REENTRANT ->
  RETURN tenseSelectorPlan__fallible?(self.plan);
END
observable_reducible_numeric = [:Int8, :Int16, :Int32, :Int64, :UInt8, :Byte, :UInt16, :UInt32, :UInt64, :Float32, :Float64];
valid_concurrent_options = ["workers", "capacity", "batch", "parallel", "size"];
valid_concurrent_sizes = ["MICRO", "STANDARD", "LARGE", "XL"];
# End Ruby module PipeAnalysis
