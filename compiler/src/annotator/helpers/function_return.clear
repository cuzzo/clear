FN functionReturn__infer_optional_element_type(self: FunctionReturn, args: []Locatable) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (type__optional_of(TypeTypeInput{ Type: COPY TRY (functionReturn__infer_element_type(rtoc_self_view, args)) }));
}
END
