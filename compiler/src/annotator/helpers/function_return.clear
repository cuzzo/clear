      Locatable.CopyNode AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.KeepNode AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.ShareNode AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.LinkNode AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.ResolveNode AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.FreezeNode AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.PassStmt AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.StructPattern AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.RangeLit AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.ExternFnDecl AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.ExternStructDecl AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.EnumDef AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.UnionDef AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.UnionVariantLit AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.StaticCall AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.DoBlock AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.BgBlock AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.ThenChain AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.BgStreamBlock AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.YieldExpr AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.CloseStream AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.NextExpr AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.MatchStatement AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.ForRange AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.ForEach AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.TestBlock AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.WhenBlock AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.LetBinding AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.TestThat AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.AssertRaises AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.BenchmarkStmt AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.SmashStmt AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.ProfileStmt AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.StubDecl AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.Drop AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.SuppressCleanup AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.Return AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.ReassignCleanup AS item ->
        receiver_type = COPY item.type_object;,
      Locatable.FieldCleanup AS item ->
        receiver_type = COPY item.type_object;,
    END
    IF receiver_type EXISTS AS receiver_type_value THEN
      MUTABLE receiver_type_value_mutable = COPY receiver_type_value;
      MUTABLE receiver_type_value_mutable = receiver_type_value_mutable;
      IF type__untyped?(receiver_type_value_mutable) THEN
        panic("toList receiver: unresolved type info");
      END
      MUTABLE element_type_branch_value: ?Type = NIL;
      IF (TRY (type__dynamic_stream?(receiver_type_value_mutable)) OR type__promise_list?(receiver_type_value_mutable)) THEN
        element_type_branch_value = TRY (type__element_type((TRY (type__tense_type(receiver_type_value_mutable)))));
      ELSE_IF TRY (type__bounded_stream?(receiver_type_value_mutable)) THEN
        element_type_branch_value = TRY (type__stream_element_type(receiver_type_value_mutable));
      ELSE_IF TRY (type__inf_stream?(receiver_type_value_mutable)) THEN
        element_type_branch_value = TRY (type__inf_stream_element_type(receiver_type_value_mutable));
      ELSE_IF TRY (type__open_stream?(receiver_type_value_mutable)) THEN
        element_type_branch_value = TRY (type__open_stream_element_type(receiver_type_value_mutable));
      ELSE
        element_type_branch_value = TRY (type__element_type(receiver_type_value_mutable));
      END
      MUTABLE element_type: ?Type = element_type_branch_value;
      MUTABLE element = element_type?;
      MUTABLE list = TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("${type__resolved(element)}[]") }, NIL, NIL, NIL, :heap, :list));
      TRY (type__set_elem_ownership(&list, type__ownership(element)));
      TRY (type__set_elem_sync(&list, type__sync(element)));
      RETURN list;
    ELSE
      panic("toList receiver: unresolved type info");
    END
}
END
FN functionReturn__new(kind: Kind, fixed: ?Type = NIL, infer: ?String@symbol = NIL) RETURNS FunctionReturn@multiowned ->
  MUTABLE self = FunctionReturn{ fixed: COPY fixed, infer: COPY infer, kind: COPY kind };
  functionReturn__initialize(&self, kind, fixed, infer);
  RETURN self @multiowned;
END
