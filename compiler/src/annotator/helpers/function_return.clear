REQUIRE "pkg:rtoc_6173742f747970652e636c656172"
REQUIRE "pkg:rtoc_6173742f6173742e636c656172"
PUB STRUCT FunctionReturn {
  fixed: ?Type,
  infer: ?String@symbol,
  kind: Kind
}

PUB ENUM Kind { Fixed, ElementOf, OptionalOfElement, IdOfElement, OptionalOfValue, ValueList, KeyList, Infer }
FN functionReturn__initialize(MUTABLE self: FunctionReturn, kind: Kind, fixed: ?Type = NIL, infer: ?String@symbol = NIL) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.kind = COPY kind;
    rtoc_self_view.fixed = COPY fixed;
    rtoc_self_view.infer = COPY infer;
}
END
PUB FN functionReturn__fixed(t: Type) RETURNS FunctionReturn@multiowned ->
  RETURN functionReturn__new(Kind.Fixed, t);
END
PUB FN functionReturn__infer(m: String@symbol) RETURNS FunctionReturn@multiowned ->
  RETURN functionReturn__new(Kind.Infer, NIL, m);
END
PUB FN functionReturn__fixed?(self: FunctionReturn) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (rtoc_self_view.kind == Kind.Fixed);
}
END
PUB FN functionReturn__variant(kind_name: String@symbol) RETURNS !FunctionReturn@multiowned ->
  RETURN functionReturn__new(TRY (functionReturn__variant_kind(kind_name)));
END
FN functionReturn__variant_kind(kind_name: String@symbol) RETURNS !Kind ->
  IF (kind_name == :Fixed) THEN
    RETURN Kind.Fixed;
  ELSE_IF (kind_name == :ElementOf) THEN
    RETURN Kind.ElementOf;
  ELSE_IF (kind_name == :OptionalOfElement) THEN
    RETURN Kind.OptionalOfElement;
  ELSE_IF (kind_name == :IdOfElement) THEN
    RETURN Kind.IdOfElement;
  ELSE_IF (kind_name == :OptionalOfValue) THEN
    RETURN Kind.OptionalOfValue;
  ELSE_IF (kind_name == :ValueList) THEN
    RETURN Kind.ValueList;
  ELSE_IF (kind_name == :KeyList) THEN
    RETURN Kind.KeyList;
  ELSE_IF (kind_name == :Infer) THEN
    RETURN Kind.Infer;
  ELSE
    panic("unknown FunctionReturn variant: {}");
  END
END
PUB FN functionReturn__copy(self: FunctionReturn) RETURNS !FunctionReturn@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (rtoc_self_view.kind == Kind.Fixed) THEN
      RETURN functionReturn__fixed(TRY (type__new(TypeConstructionInput{ Type: COPY UNWRAP (rtoc_self_view.fixed) })));
    END
    IF (rtoc_self_view.kind == Kind.Infer) THEN
      RETURN functionReturn__infer(symbol(UNWRAP (rtoc_self_view.infer)));
    END
    RETURN functionReturn__new(rtoc_self_view.kind);
}
END
FN functionReturn__resolve(self: FunctionReturn, receiver: ?Type, args: []Locatable) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (rtoc_self_view.kind == Kind.Fixed) THEN
      RETURN COPY UNWRAP (rtoc_self_view.fixed);
    ELSE_IF (rtoc_self_view.kind == Kind.ElementOf) THEN
      IF receiver EXISTS AS receiver_value THEN
        MUTABLE el: ?Type = TRY (type__element_type(receiver_value));
        IF el != NIL THEN
    RETURN el;
        ELSE
    RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }));
        END
      ELSE
        RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }));
      END
    ELSE_IF (rtoc_self_view.kind == Kind.OptionalOfElement) THEN
      RETURN TRY (type__optional_of(TypeTypeInput{ Type: COPY UNWRAP (TRY (type__element_type(UNWRAP (receiver)))) }));
    ELSE_IF (rtoc_self_view.kind == Kind.IdOfElement) THEN
      RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("Id<${type__resolved(UNWRAP (TRY (type__element_type(UNWRAP (receiver)))))}>") }));
    ELSE_IF (rtoc_self_view.kind == Kind.OptionalOfValue) THEN
      RETURN TRY (type__optional_of(TypeTypeInput{ Type: COPY TRY (type__value_type(UNWRAP (receiver))) }));
    ELSE_IF (rtoc_self_view.kind == Kind.ValueList) THEN
      MUTABLE value = TRY (type__value_type(UNWRAP (receiver)));
      RETURN CAST(TRY (functionReturn__element_list(rtoc_self_view, value)) AS Type);
    ELSE_IF (rtoc_self_view.kind == Kind.KeyList) THEN
      MUTABLE key = TRY (type__key_type(UNWRAP (receiver)));
      RETURN CAST(TRY (functionReturn__element_list(rtoc_self_view, key)) AS Type);
    ELSE_IF (rtoc_self_view.kind == Kind.Infer) THEN
      RETURN CAST(TRY (functionReturn__resolve_infer(rtoc_self_view, args)) AS Type);
    ELSE
      panic("unknown FunctionReturn kind: {}");
    END
}
END
FN functionReturn__element_list(self: FunctionReturn, element: Type) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE list = TRY (type__new(TypeConstructionInput{ SymbolValue: COPY symbol("${type__resolved(element)}[]") }, NIL, NIL, NIL, NIL, :list));
    IF !(((type__ownership(element) == NIL) OR ((type__ownership(element))? == :affine))) THEN
      TRY (type__set_elem_ownership(&list, type__ownership(element)));
    END
    IF !((type__sync(element) == NIL)) THEN
      TRY (type__set_elem_sync(&list, type__sync(element)));
    END
    RETURN list;
}
END
FN functionReturn__resolve_infer(self: FunctionReturn, args: []Locatable) RETURNS !Type
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE r_branch_value: ?Type@multiowned = NIL;
    PARTIAL MATCH symbol(UNWRAP (rtoc_self_view.infer)) START
      :infer_element_type ->
      r_branch_value = TRY (functionReturn__infer_element_type(rtoc_self_view, args));,
      :infer_optional_element_type ->
      r_branch_value = TRY (functionReturn__infer_optional_element_type(rtoc_self_view, args));,
      :infer_to_list ->
      r_branch_value = TRY (functionReturn__infer_to_list(rtoc_self_view, args));,
      DEFAULT ->
      panic("unknown FunctionReturn infer method: {}");
    END
    MUTABLE r: Type@multiowned = r_branch_value?;
    IF TRUE THEN
      RETURN CAST(r AS Type);
    ELSE
      RETURN TRY (type__new(TypeConstructionInput{ Type: COPY r }));
    END
}
END
