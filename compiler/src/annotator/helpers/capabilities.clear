# Ruby module PredicateAudit
# Ruby module CapabilityHelper
PUB STRUCT CaptureAnalysis {
  has_local: Bool,
  has_rc: Bool,
  has_shared: Bool,
  has_sharded: Bool,
  has_affine_locked: Bool,
  has_outer_ref: Bool,
  has_non_escaping_capture: Bool,
  captures: {String}Type,
  capture_symbols: {String}SymbolEntry@multiowned,
  close_plans: {String}ResourceClosePlan,
  pointer_captures: [Set]String,
  string_captures: [Set]String,
  resource_captures: [Set]String,
  site_moved: [Set]String,
  site_copied: [Set]String,
  strategies: {String}Strategy,
  move_mark_names: [Set]String,
  alloc_mark_entries: {String}String@symbol
}

PUB FN captureAnalysis__pin_reason(self: CaptureAnalysis) RETURNS String@symbol ->
  IF self.has_sharded THEN
    RETURN :sharded;
  ELSE
    RETURN :shared;
  END
END
PUB FN captureAnalysis__merge_nested_mut(MUTABLE self: CaptureAnalysis, nested: CaptureAnalysis) RETURNS Void ->
  &self.captures.merge_mut(nested.captures, %(ignored_name: Tuple<String,Type>, old, ignored_new) -> old);
  &self.capture_symbols.merge_mut(nested.capture_symbols, %(ignored_name: Tuple<String,SymbolEntry@multiowned>, old, ignored_new) -> old);
  &self.close_plans.merge_mut(nested.close_plans, %(ignored_name: Tuple<String,ResourceClosePlan>, old, ignored_new) -> old);
  self.pointer_captures.merge(nested.pointer_captures);
  self.string_captures.merge(nested.string_captures);
  self.resource_captures.merge(nested.resource_captures);
  self.site_moved.merge(nested.site_moved);
  self.site_copied.merge(nested.site_copied);
  &self.strategies.merge_mut(nested.strategies, %(ignored_name: Tuple<String,Strategy>, old, ignored_new) -> old);
  self.move_mark_names.merge(nested.move_mark_names);
  &self.alloc_mark_entries.merge_mut(nested.alloc_mark_entries, %(ignored_name: Tuple<String,String@symbol>, old, ignored_new) -> old);
END
PUB STRUCT CaptureContext {
  analysis: CaptureAnalysis,
  outer_scope: Scope@multiowned,
  locals: [Set]String,
  is_parallel: Bool,
  mark_moves: Bool
}
# End Ruby module CapabilityHelper
# Ruby module CapabilityAudit
PUB STRUCT BindingAuditRecord {
  fn: String,
  var: String,
  line: ?Int64,
  column: ?Int64,
  sync: ?String@symbol,
  ownership: ?String@symbol,
  storage: String@symbol,
  sharded: Bool,
  mutated: Bool,
  captured_bg: Bool,
  captured_parallel: Bool
}

PUB FN bindingAuditRecord__mark_mutated_mut(MUTABLE self: BindingAuditRecord) RETURNS Void ->
  self.mutated = TRUE;
END
PUB FN bindingAuditRecord__mark_captured_mut(MUTABLE self: BindingAuditRecord, parallel: Bool) RETURNS Void ->
  self.captured_bg = TRUE;
  IF parallel THEN
    self.captured_parallel = TRUE;
  END
END
# End Ruby module CapabilityAudit
