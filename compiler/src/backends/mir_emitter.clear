WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN "try CheatLib.freeze(${node.zig_base}, ${TRY (mIREmitter__emit(&rtoc_self_view, Emittable{ AllocatorRef: COPY node.alloc_ref }))}, ${TRY (mIREmitter__emit(&rtoc_self_view, node.inner))})";
