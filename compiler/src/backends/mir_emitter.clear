  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN "const frame_mark = ${node.rt_expr}.saveFrameMark();";
}
END
PRIVATE FN mIREmitter__emit_frame_restore(self: MIREmitter, node: FrameRestore) RETURNS String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN "defer ${node.rt_expr}.restoreFrameMark(frame_mark);";
}
END
PRIVATE FN mIREmitter__emit_call(MUTABLE self: MIREmitter, node: Call) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE args = (node.args |> SELECT TRY (mIREmitter__emit_call_argument(&rtoc_self_view, _))).join(", ");
    MUTABLE call = "${mIREmitter__runtime_scoped_callee(rtoc_self_view, node.callee)}(${args})";
    IF node.try_wrap THEN
      RETURN "try ${call}";
    ELSE
      RETURN call;
    END
}
END
PRIVATE FN mIREmitter__emit_runtime_call(MUTABLE self: MIREmitter, node: RuntimeCall) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN TRY (mIREmitter__emit_call(&rtoc_self_view, runtimeCallSpec__call(node.spec, node.args)));
}
END
PRIVATE FN mIREmitter__runtime_scoped_callee(self: MIREmitter, callee: String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE text = COPY callee;
    IF text.startsWith?("rt.") THEN
      RETURN "${rtoc_self_view.rt_name}.${text.deletePrefix("rt.")}";
    ELSE
      RETURN text;
    END
}
END
PRIVATE FN mIREmitter__emit_tail_call(MUTABLE self: MIREmitter, node: TailCall) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE args = (node.args |> SELECT TRY (mIREmitter__emit_call_argument(&rtoc_self_view, _))).join(", ");
    RETURN "@call(.always_tail, ${node.callee}, .{${args}})";
}
END
PRIVATE FN mIREmitter__emit_method_call(MUTABLE self: MIREmitter, node: MIRMethodCall) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE recv = mIREmitter__paren_if_try(rtoc_self_view, TRY (mIREmitter__emit(&rtoc_self_view, node.receiver)));
    IF (((node.method == "heapAlloc") AND (node.args.length() == 0)) AND (recv == rtoc_self_view.rt_name)) THEN
      RETURN TRY (mIREmitter__alloc_zig(rtoc_self_view, :heap));
    END
    MUTABLE args = (node.args |> SELECT TRY (mIREmitter__emit_call_argument(&rtoc_self_view, _))).join(", ");
    MUTABLE call = "${recv}.${node.method}(${args})";
    IF node.try_wrap THEN
      RETURN "try ${call}";
    ELSE
      RETURN call;
    END
}
END
PRIVATE FN mIREmitter__emit_call_argument(MUTABLE self: MIREmitter, argument: Emittable) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rendered = TRY (mIREmitter__emit(&rtoc_self_view, argument));
    IF argument IS_A MIRBlockExpr AS mir_block_expr THEN
      RETURN "(${rendered})";
    ELSE
      RETURN rendered;
    END
}
END
PRIVATE FN mIREmitter__emit_field_get(MUTABLE self: MIREmitter, node: FieldGet) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE object = TRY (mIREmitter__emit(&rtoc_self_view, node.object));
    IF (node.object IS_A StructInit OR node.object IS_A TupleLiteral) THEN
      object = "(${object})";
    END
    RETURN "${mIREmitter__paren_if_try(rtoc_self_view, object)}.${mIREmitter__zig_field_name(rtoc_self_view, Name{ StringValue: COPY node.field })}";
}
END
PRIVATE FN mIREmitter__emit_union_payload_get(MUTABLE self: MIREmitter, node: UnionPayloadGet) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE subject = TRY (mIREmitter__emit(&rtoc_self_view, node.subject));
    MUTABLE variant = COPY node.variant;
    RETURN "(switch (${subject}) { .${variant} => |__union_payload| __union_payload, else => unreachable })";
}
END
PRIVATE FN mIREmitter__emit_assert_stmt(MUTABLE self: MIREmitter, node: AssertStmt) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN "CheatLib.assert(${TRY (mIREmitter__emit(&rtoc_self_view, node.cond))}, ${node.message});";
}
END
PRIVATE FN mIREmitter__emit_assert_raises_check(MUTABLE self: MIREmitter, node: AssertRaisesCheck) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE error_check: String = "";
    IF node.error_name THEN
      error_check = " and !${node.rt_name}.__error.matchesName(@intFromEnum(ErrorName.${(node.error_name OR_ELSE "")}))";
    ELSE
      error_check = "";
    END
    RETURN regexReplaceAll__mir_emitter("{\n    if (${TRY (mIREmitter__emit(&rtoc_self_view, node.expr))}) |_| {\n        @panic(\"ASSERT_RAISES: expected ${node.kind} error but none raised\");\n    } else |_| {\n        if (!${node.rt_name}.__error.matchesKind(.${node.kind})${error_check}) {\n            @panic(\"ASSERT_RAISES: expected ${node.kind} error, got different kind\");\n        }\n    }\n}\n", "\\s+\\z", "");
}
END
PRIVATE FN mIREmitter__emit_test_preamble(self: MIREmitter) RETURNS String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN "var da = std.heap.DebugAllocator(.{}){};\n    defer _ = da.deinit();\n    const allocator = da.allocator;\n    var global_ctx = EbrContext{};\n    defer global_ctx.deinit(allocator);\n    var __rt_box = try Runtime.init(allocator, 128 * 1024 * 1024, &global_ctx);\n    defer __rt_box.deinit();\n    __rt_box.wireAllocator();\n    const rt: *Runtime = &__rt_box; _ = &rt;\n".trim();
}
END
PRIVATE FN mIREmitter__emit_debug_only(MUTABLE self: MIREmitter, node: DebugOnly) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE body = TRY (mIREmitter__emit_body(&rtoc_self_view, node.body));
    RETURN regexReplaceAll__mir_emitter("if (@import(\"builtin\").mode == .Debug) {\n${mIREmitter__indent_block(rtoc_self_view, body, 4)}\n}\n", "\\s+\\z", "");
}
END
PRIVATE FN mIREmitter__paren_if_try(self: MIREmitter, expr: String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF expr.startsWith?("try ") THEN
      RETURN COPY "(${expr})";
    ELSE
      RETURN COPY expr;
    END
}
END
PRIVATE FN mIREmitter__emit_index_get(MUTABLE self: MIREmitter, node: IndexGet) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN "${TRY (mIREmitter__emit(&rtoc_self_view, node.object))}[${TRY (mIREmitter__emit(&rtoc_self_view, node.index))}]";
}
END
PRIVATE FN mIREmitter__emit_bin_op(MUTABLE self: MIREmitter, node: MIRBinOp) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN "(${TRY (mIREmitter__emit(&rtoc_self_view, node.left))} ${node.op} ${TRY (mIREmitter__emit(&rtoc_self_view, node.right))})";
}
END
PRIVATE FN mIREmitter__emit_unary_op(MUTABLE self: MIREmitter, node: MIRUnaryOp) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN "${node.op}${TRY (mIREmitter__emit(&rtoc_self_view, node.operand))}";
}
END
PRIVATE FN mIREmitter__emit_pointer_cast(MUTABLE self: MIREmitter, node: PointerCast) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN "@as(${node.target_type}, @ptrCast(@alignCast(${TRY (mIREmitter__emit(&rtoc_self_view, node.expr))})))";
}
END
PRIVATE FN mIREmitter__emit_default_stream_capacity(MUTABLE self: MIREmitter, node: DefaultStreamCapacity) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE workers: String = TRY (mIREmitter__emit(&rtoc_self_view, node.worker_count));
    RETURN "blk: { var c: usize = 4; while (c < ${workers} * 4) : (c <<= 1) {} break :blk @min(c, 64); }";
}
END
PRIVATE FN mIREmitter__emit_next_promise_list(MUTABLE self: MIREmitter, node: NextPromiseList) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE list_expr = mIREmitter__paren_if_try(rtoc_self_view, TRY (mIREmitter__emit(&rtoc_self_view, node.list_expr)));
    MUTABLE alloc = TRY (mIREmitter__alloc_zig(rtoc_self_view, node.alloc));
    MUTABLE resolved_value: String = "";
    IF asyncResultShape__boxes_fallible_payload?(node.async_shape) THEN
      resolved_value = regexReplaceAll__mir_emitter("const __resolved = try __p.next();\n        var __value = __resolved.value catch |__err| {\n            CheatLib.cleanup(@TypeOf(${node.results_var}), ${alloc}, &${node.results_var});\n            break :${node.label} __err;\n        };\n", "\\s+\\z", "");
    ELSE
      resolved_value = "var __value = try __p.next();";
    END
    RETURN regexReplaceAll__mir_emitter("${node.label}: {\n    var ${node.results_var} = std.ArrayListUnmanaged(${TRY (nextPromiseList__elem_zig(node))}).empty;\n    errdefer CheatLib.cleanup(@TypeOf(${node.results_var}), ${alloc}, &${node.results_var});\n    for (${list_expr}.items) |__p| {\n        ${resolved_value}\n        defer if (comptime CheatLib.needsCleanup(@TypeOf(__value)))\n            CheatLib.cleanup(@TypeOf(__value), __p.alloc, &__value);\n        const __placed = if (comptime CheatLib.needsCleanup(@TypeOf(__value)))\n            try CheatLib.dupeValue(@TypeOf(__value), __value, ${alloc})\n        else\n            __value;\n        errdefer CheatLib.cleanup(@TypeOf(__placed), ${alloc}, &__placed);\n        try ${node.results_var}.append(${alloc}, __placed);\n    }\n    break :${node.label} ${node.results_var};\n}\n", "\\s+\\z", "");
}
END
PRIVATE FN mIREmitter__emit_struct_init(MUTABLE self: MIREmitter, node: StructInit) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    # Ruby's filter_map over the fields, as a loop: an IF EXPRESSION cannot
    # yield a ?String, and nesting two value blocks to hold `name` and `value`
    # is what forced one here.
    MUTABLE field_parts: []String = List[];
    FOR struct_field IN node.fields DO
      MUTABLE field_name: ?MIRReturnValue = mIR__struct_init_field_name(struct_field);
      MUTABLE field_value: ?Emittable = mIR__struct_init_field_value(struct_field);
      IF field_name EXISTS AS field_name_value THEN
        IF field_value EXISTS AS field_value_value THEN
          &field_parts.append(".${mIREmitter__zig_field_name(rtoc_self_view, castOptionalMIRReturnValueToName(field_name_value))} = ${TRY (mIREmitter__emit_struct_init_field_value(&rtoc_self_view, field_value_value))}");
        END
      END
    END
    MUTABLE fields = field_parts.join(", ");
    IF node.zig_type THEN
      RETURN "${(node.zig_type OR_ELSE "")}{ ${fields} }";
    ELSE
      RETURN ".{ ${fields} }";
    END
}
END
PRIVATE FN mIREmitter__emit_tuple_literal(MUTABLE self: MIREmitter, node: TupleLiteral) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN ".{${(node.items |> SELECT TRY (mIREmitter__emit(&rtoc_self_view, _))).join(", ")}}";
}
END
PRIVATE FN mIREmitter__emit_lock_acquire(MUTABLE self: MIREmitter, node: LockAcquire) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE lock_expr = TRY (mIREmitter__emit(&rtoc_self_view, node.lock_expr));
    IF (node.lock_sync == :write_locked) THEN
      RETURN "${lock_expr}.${IF node.fallible THEN
        "writeOrErr"
      ELSE
        "write"
      END}()";
    END
    IF (node.lock_sync == :locked) THEN
      RETURN "${lock_expr}.${IF node.fallible THEN
        "acquireOrErr"
      ELSE
        "acquire"
      END}()";
    END
    MUTABLE write_method: String = "";
    IF node.fallible THEN
      write_method = "writeOrErr";
    ELSE
      write_method = "write";
    END
    MUTABLE acquire_method: String = "";
    IF node.fallible THEN
      acquire_method = "acquireOrErr";
    ELSE
      acquire_method = "acquire";
    END
    RETURN "(if (comptime @hasDecl(@TypeOf(${lock_expr}), \"${write_method}\")) ${lock_expr}.${write_method}() else ${lock_expr}.${acquire_method}())";
}
END
PRIVATE FN mIREmitter__emit_array_init(MUTABLE self: MIREmitter, node: ArrayInit) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE items = (node.items |> SELECT TRY (mIREmitter__emit(&rtoc_self_view, _))).join(", ");
    RETURN "[${node.count}]${node.elem_type}{ ${items} }";
}
END
PRIVATE FN mIREmitter__emit_array_default_init(MUTABLE self: MIREmitter, node: ArrayDefaultInit) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN "[_]${node.elem_type}{ ${TRY (mIREmitter__emit(&rtoc_self_view, node.default_value))} } ** ${node.count}";
}
END
PRIVATE FN mIREmitter__emit_slice_expr(MUTABLE self: MIREmitter, node: SliceExpr) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE target: String = TRY (mIREmitter__emit(&rtoc_self_view, node.target));
    MUTABLE s: String = TRY (mIREmitter__emit(&rtoc_self_view, node.start));
    MUTABLE range: String = "";
    IF node.end_expr THEN
      range = "${s}..${TRY (mIREmitter__emit(&rtoc_self_view, node.end_expr))}";
    ELSE
      range = "${s}..";
    END
    IF node.elem_type THEN
      RETURN "@as([]const ${(node.elem_type OR_ELSE "")}, ${target}[${range}])";
    ELSE
      RETURN "${target}[${range}]";
    END
}
END
PRIVATE FN mIREmitter__emit_block_expr(MUTABLE self: MIREmitter, node: MIRBlockExpr) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE body = TRY (mIREmitter__emit_body(&rtoc_self_view, node.body));
    MUTABLE label_prefix: String = "";
    IF node.label THEN
      label_prefix = "${(node.label OR_ELSE "")}: ";
    ELSE
      label_prefix = "";
    END
    RETURN "${label_prefix}{\n${body}\n}";
}
END
PRIVATE FN mIREmitter__emit_concat(MUTABLE self: MIREmitter, node: ConcatStr) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE parts = (node.parts |> SELECT TRY (mIREmitter__emit(&rtoc_self_view, _))).join(", ");
    RETURN "try std.mem.concat(${TRY (mIREmitter__alloc_zig(rtoc_self_view, node.alloc))}, u8, &.{ ${parts} })";
}
END
PRIVATE FN mIREmitter__emit_cast(MUTABLE self: MIREmitter, node: MIRCast) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE inner = TRY (mIREmitter__emit(&rtoc_self_view, node.expr));
    MUTABLE target_t: ?String = COPY node.target_type;
    IF target_t EXISTS AS target_t_value THEN
      target_t = zigType__cast_target_type(zigType__new(target_t_value));
    END
    IF inner.startsWith?("@panic(") THEN
      RETURN inner;
    END
    IF (node.method == :as) THEN
      RETURN "@as(${(target_t OR_ELSE "")}, ${inner})";
    ELSE_IF (node.method == :intCast) THEN
      IF target_t THEN
        RETURN "@as(${(target_t OR_ELSE "")}, @intCast(${inner}))";
      ELSE
        RETURN "@intCast(${inner})";
      END
    ELSE_IF (node.method == :floatCast) THEN
      RETURN "@floatCast(${inner})";
    ELSE_IF (node.method == :ptrCast) THEN
      RETURN "@ptrCast(${inner})";
    ELSE_IF (node.method == :intFromFloat) THEN
      RETURN "@intFromFloat(${inner})";
    ELSE_IF (node.method == :floatFromInt) THEN
      RETURN "@floatFromInt(${inner})";
    ELSE_IF (node.method == :truncate) THEN
      RETURN "@truncate(${inner})";
    ELSE_IF (node.method == :enumFromInt) THEN
      IF target_t THEN
        RETURN "@as(${(target_t OR_ELSE "")}, @enumFromInt(${inner}))";
      ELSE
        RETURN "@enumFromInt(${inner})";
      END
    ELSE
      panic("MIREmitter#emit_cast: unknown method :{}");
    END
}
END
PRIVATE FN mIREmitter__emit_orelse(MUTABLE self: MIREmitter, node: Orelse) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fallback = TRY (mIREmitter__emit(&rtoc_self_view, node.fallback));
    MUTABLE result_type: ?Type = COPY node.result_type;
    IF ((result_type != NIL) AND !(fallback.startsWith?("@panic("))) THEN
      fallback = "@as(${TRY (type__zig_type(result_type))}, ${fallback})";
    END
    MUTABLE expr: String = TRY (mIREmitter__emit(&rtoc_self_view, node.expr));
    IF ((result_type != NIL) AND (expr == "null")) THEN
      expr = "@as(?${TRY (type__zig_type(result_type))}, null)";
    END
    RETURN "(${expr} orelse ${fallback})";
}
END
PRIVATE FN mIREmitter__emit_try_catch(MUTABLE self: MIREmitter, node: TryCatch) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE expr: String = TRY (mIREmitter__emit(&rtoc_self_view, node.expr));
    MUTABLE catch_body: String = TRY (mIREmitter__emit(&rtoc_self_view, node.catch_body));
    MUTABLE cap: String = "";
    IF node.capture THEN
      cap = " |${(node.capture OR_ELSE "")}|";
    ELSE
      cap = "";
    END
    RETURN "(${expr} catch${cap} ${catch_body})";
}
END
PRIVATE FN mIREmitter__emit_discard_owned(MUTABLE self: MIREmitter, node: DiscardOwned) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.discard_counter = (rtoc_self_view.discard_counter + 1);
    MUTABLE name = "__discard_${rtoc_self_view.discard_counter.toString()}";
    MUTABLE discard_expr = COPY node.expr;
    IF mIREmitter__discard_success_only?(rtoc_self_view, discard_expr) THEN
      MUTABLE success_expr: TryCatch = castEmittableToTryCatch__mir_emitter(discard_expr);
      MUTABLE opt = "${name}_opt";
      MUTABLE expr: String = TRY (mIREmitter__emit(&rtoc_self_view, success_expr.expr));
      MUTABLE body = (["{", "const ${opt}: ?${node.zig_type} = (${expr} catch null);", "if (${opt}) |${name}_val| {", "var ${name} = ${name}_val;", mIREmitter__indent_block(rtoc_self_view, TRY (mIREmitter__emit_cleanup(rtoc_self_view, name, node.cleanup_entry, FALSE)), 4), "}", "}"]).join("\n");
      RETURN body;
    END
    RETURN (["{", "var ${name} = ${TRY (mIREmitter__emit(&rtoc_self_view, node.expr))};", mIREmitter__indent_block(rtoc_self_view, TRY (mIREmitter__emit_cleanup(rtoc_self_view, name, node.cleanup_entry, FALSE)), 4), "}"]).join("\n");
}
END
PRIVATE FN mIREmitter__discard_success_only?(self: MIREmitter, expr: Emittable) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF expr IS_A TryCatch AS try_catch THEN
    IF (try_catch.capture == NIL) THEN
        MUTABLE catch_body = try_catch.catch_body;
        RETURN (((IF catch_body IS_A Ident AS ident THEN (ident.name == "undefined") ELSE FALSE END)) OR catch_body IS_A Undef);
      ELSE
        RETURN FALSE;
      END
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN mIREmitter__emit_conditional(MUTABLE self: MIREmitter, node: Conditional) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN "(if (${TRY (mIREmitter__emit(&rtoc_self_view, node.cond))}) ${TRY (mIREmitter__emit(&rtoc_self_view, node.then_val))} else ${TRY (mIREmitter__emit(&rtoc_self_view, node.else_val))})";
}
END
PRIVATE FN mIREmitter__emit_if_optional(MUTABLE self: MIREmitter, node: IfOptional) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE then_expr: String = TRY (mIREmitter__emit(&rtoc_self_view, node.then_expr));
    IF node.result_type EXISTS AS result_type_value THEN
      IF type__optional?(result_type_value) THEN
      then_expr = "@as(${TRY (type__zig_type(result_type_value))}, ${then_expr})";
    END
    END
    RETURN "(if (${TRY (mIREmitter__emit(&rtoc_self_view, node.optional))}) |${(node.capture OR_ELSE "")}| ${then_expr} else ${TRY (mIREmitter__emit(&rtoc_self_view, node.else_expr))})";
}
END
PRIVATE FN mIREmitter__emit_allocator_ref(self: MIREmitter, node: AllocatorRef) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (mIREmitter__alloc_zig(rtoc_self_view, node.kind));
}
END
PRIVATE FN mIREmitter__emit_type_sentinel(self: MIREmitter, node: TypeSentinel) RETURNS ?String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE t = COPY CAST(node.zig_type AS String);
    IF (node.extreme == :max) THEN
      IF zigType__float_identifier?(t) THEN
        RETURN "std.math.floatMax(${t})";
      ELSE_IF zigType__integer_identifier?(t) THEN
        RETURN "std.math.maxInt(${t})";
      ELSE
        RETURN "std.math.floatMax(f64)";
      END
    ELSE_IF (node.extreme == :min) THEN
      IF zigType__float_identifier?(t) THEN
        RETURN "-std.math.floatMax(${t})";
      ELSE_IF zigType__integer_identifier?(t) THEN
        RETURN "std.math.minInt(${t})";
      ELSE
        RETURN "-std.math.floatMax(f64)";
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN mIREmitter__emit_default_value(self: MIREmitter, node: DefaultValue) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (node.kind == :aggregate_empty) THEN
      RETURN ".{}";
    ELSE_IF (node.kind == :string_empty) THEN
      RETURN "@as([]const u8, \"\")";
    ELSE_IF (node.kind == :collection_empty) THEN
      RETURN "@as(${UNWRAP (node.zig_type)}, .empty)";
    ELSE_IF (node.kind == :undefined) THEN
      IF node.zig_type EXISTS AS zig_type_value THEN
        RETURN "@as(${zig_type_value}, undefined)";
      ELSE
        RETURN "undefined";
      END
    ELSE
      panic("unknown MIR::DefaultValue kind {}");
    END
}
END
PRIVATE FN mIREmitter__emit_range_lit(MUTABLE self: MIREmitter, node: MIRRangeLit) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE s: String = TRY (mIREmitter__emit(&rtoc_self_view, node.start));
    MUTABLE e: String = TRY (mIREmitter__emit(&rtoc_self_view, node.end_val));
    IF (node.elem_type == :Int64) THEN
      RETURN "CheatLib.IntRange{ .start = ${s}, .end = ${e} }";
    ELSE
      RETURN "CheatLib.Range{ .start = ${s}, .end = ${e} }";
    END
}
END
PRIVATE FN mIREmitter__emit_has_field(MUTABLE self: MIREmitter, node: HasField) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN "@hasField(@TypeOf(${TRY (mIREmitter__emit(&rtoc_self_view, node.expr))}), \"${node.field}\")";
}
END
PRIVATE FN mIREmitter__emit_lambda(MUTABLE self: MIREmitter, node: LambdaExpr) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fn = node.fn_def;
    MUTABLE fn_zig = TRY (mIREmitter__emit_fn_def(&rtoc_self_view, fn));
    RETURN "&(struct { ${fn_zig} }).${fn.name}";
}
END
PRIVATE FN mIREmitter__emit_items_access(MUTABLE self: MIREmitter, node: ItemsAccess) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE inner: String = TRY (mIREmitter__emit(&rtoc_self_view, node.expr));
    IF node.safe THEN
      rtoc_self_view.items_block_counter = (rtoc_self_view.items_block_counter + 1);
      MUTABLE label = "blk_items_${rtoc_self_view.items_block_counter.toString()}";
      RETURN "(${label}: { const __x = if (@typeInfo(@TypeOf(${inner})) == .pointer and @typeInfo(@TypeOf(${inner})).pointer.size == .one) ${inner}.* else ${inner}; break :${label} (if (@hasField(@TypeOf(__x), \"items\")) __x.items else @constCast(__x[0..])); })";
    ELSE
      RETURN "${inner}.items";
    END
}
END
PRIVATE FN mIREmitter__emit_owned_slice(MUTABLE self: MIREmitter, node: OwnedSlice) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE inner: String = TRY (mIREmitter__emit(&rtoc_self_view, node.expr));
    rtoc_self_view.owned_slice_counter = (rtoc_self_view.owned_slice_counter + 1);
    MUTABLE label = "blk_owned_slice_${rtoc_self_view.owned_slice_counter.toString()}";
    MUTABLE alloc = TRY (mIREmitter__alloc_expr(&rtoc_self_view, Alloc{ SymbolValue: COPY node.alloc }));
    RETURN "${label}: { var __x = ${inner}; break :${label} if (comptime @typeInfo(@TypeOf(__x)) == .@\"struct\" and @hasDecl(@TypeOf(__x), \"toOwnedSlice\")) try __x.toOwnedSlice(${alloc}) else if (comptime @typeInfo(@TypeOf(__x)) == .array) try ${alloc}.dupe(@typeInfo(@TypeOf(__x)).array.child, __x[0..]) else __x; }";
}
END
PRIVATE FN mIREmitter__emit_body(MUTABLE self: MIREmitter, stmts: []Emittable) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN (stmts |> SELECT:? { MUTABLE rtoc_value_block_marker = 0; MUTABLE code: String = TRY (mIREmitter__emit(&rtoc_self_view, _)); (IF !(code) THEN NIL ELSE { MUTABLE rtoc_value_block_marker = 0; MUTABLE stripped = code.trim(); (  IF mIREmitter__semicolon_required?(rtoc_self_view, _, stripped) THEN
      "${code};"
    ELSE
      code
    END) } END) } |> WHERE _ != NIL |> SELECT UNWRAP _).join("\n");
}
END
PRIVATE FN mIREmitter__semicolon_required?(self: MIREmitter, stmt: Emittable, stripped: String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (((emittable__expr?(stmt) AND !(stripped.endsWith?(";"))) AND !(stripped.endsWith?("}"))) AND !(stripped.endsWith?("{")));
}
END
PRIVATE FN mIREmitter__alloc_from_entry(self: MIREmitter, entry: CleanupEntry) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (mIREmitter__alloc_zig(rtoc_self_view, cleanupEntry__alloc(entry)));
}
END
PRIVATE FN mIREmitter__alloc_from_sym(self: MIREmitter, sym: String@symbol) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (mIREmitter__alloc_zig(rtoc_self_view, sym));
}
END
PRIVATE FN mIREmitter__alloc_zig(self: MIREmitter, sym: String@symbol) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(((sym == :heap) OR (sym == :frame))) THEN
      panic("alloc_zig: unknown allocator symbol :{}");
    END
    IF (((sym == :heap) AND (rtoc_self_view.heap_allocator_cache_name != NIL)) AND (rtoc_self_view.heap_allocator_cache_runtime_name == rtoc_self_view.rt_name)) THEN
      RETURN COPY (rtoc_self_view.heap_allocator_cache_name)?;
    END
    RETURN placement__zig_allocator(sym, rtoc_self_view.rt_name);
}
END
PRIVATE FN mIREmitter__unique_heap_allocator_cache_name(self: MIREmitter) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE base = "__clear_heap_alloc";
    IF !(rtoc_self_view.heap_allocator_cache_names.contains?(base)) THEN
      RETURN base;
    END
    MUTABLE suffix = 1;
    WHILE rtoc_self_view.heap_allocator_cache_names.contains?("${base}_${suffix.toString()}") DO
      suffix = (suffix + 1);
    END
    RETURN "${base}_${suffix.toString()}";
}
END
PRIVATE FN mIREmitter__guarded_defer(self: MIREmitter, name: String, body: String, guarded: Bool, errdefer: Bool = FALSE) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE kw: String = "";
    IF errdefer THEN
      kw = "errdefer";
    ELSE
      kw = "defer";
    END
    IF guarded THEN
      RETURN "var ${mIREmitter__move_guard_name(rtoc_self_view, Name{ StringValue: COPY name })} = false; _ = &${mIREmitter__move_guard_name(rtoc_self_view, Name{ StringValue: COPY name })};\n${kw} if (!${mIREmitter__move_guard_name(rtoc_self_view, Name{ StringValue: COPY name })}) ${body};\n";
    ELSE_IF (body.startsWith?("{") AND body.endsWith?("}")) THEN
      RETURN "${kw} ${body}\n";
    ELSE
      RETURN "${kw} ${body};\n";
    END
}
END
PRIVATE FN mIREmitter__guarded_cleanup(self: MIREmitter, name: String, zig_type_input: String, alloc: String, guarded: Bool, errdefer: Bool = FALSE, via_pointer: ?Bool = FALSE) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE zig_type = COPY zig_type_input;
    MUTABLE kw: String = "";
    IF errdefer THEN
      kw = "errdefer";
    ELSE
      kw = "defer";
    END
    MUTABLE arg: String = "";
    IF via_pointer EXISTS AS via_pointer_value THEN
      arg = COPY name;
    ELSE
      arg = "&${name}";
    END
    zig_type = zigType__cleanup_storage_type(zigType__new(zig_type));
    IF guarded THEN
      RETURN mIREmitter__guarded_defer(rtoc_self_view, name, "CheatLib.cleanup(${zig_type}, ${alloc}, ${arg})", TRUE, errdefer);
    ELSE
      RETURN "${kw} CheatLib.cleanup(${zig_type}, ${alloc}, ${arg});\n";
    END
}
END
PRIVATE FN mIREmitter__render_resource_close_plan(self: MIREmitter, plan: ResourceClosePlan, root_name: String) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (plan.actions |> SELECT TRY (mIREmitter__render_resource_close_action(rtoc_self_view, _, root_name))).join("; ");
}
END
PRIVATE FN mIREmitter__render_resource_close_action(self: MIREmitter, action: ResourceCloseAction, root_name: String) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE target = (([root_name] + action.field_path)).join(".");
    MUTABLE runtime_args: []String = ( { MUTABLE rtoc_empty_list_40: []String = List[]; rtoc_empty_list_40 } );
    FOR rtoc_counter_h IN (0_i64 ..< action.runtime_heap_alloc_args) DO
      &runtime_args.append(TRY (mIREmitter__alloc_zig(rtoc_self_view, :heap)));
    END
    IF (action.call_kind == ResourceCloseCallKind.Method) THEN
      RETURN "${target}.${action.name}(${runtime_args.join(", ")})";
    ELSE_IF (action.call_kind == ResourceCloseCallKind.Function) THEN
      MUTABLE args = ([target] + runtime_args);
      RETURN "${action.name}(${args.join(", ")})";
    ELSE_IF (action.call_kind == ResourceCloseCallKind.CFunction) THEN
      RETURN "_ = ${action.name}(${target})";
    ELSE
      panic("unknown resource close call kind: {}");
    END
}
END
PRIVATE FN mIREmitter__render_tuple_cleanup(self: MIREmitter, entry: CleanupEntry, root_name: String, alloc: String) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE statements = (cleanupEntry__tuple_cleanup_fields(entry)) |> SELECT {
    MUTABLE target = "${root_name}.@\"${_.index.toString()}\"";
    MUTABLE close_plan: ?ResourceClosePlan = COPY _.close_plan;
    (  IF close_plan THEN
        "${TRY (mIREmitter__render_resource_close_plan(rtoc_self_view, UNWRAP (close_plan), target))};"
      ELSE
        "CheatLib.cleanup(@TypeOf(${target}), ${alloc}, &${target});"
      END)
    };
    RETURN "{ ${statements.join(" ")} }";
}
END
PRIVATE FN mIREmitter__emit_resource_close(MUTABLE self: MIREmitter, node: ResourceClose) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE target = TRY (mIREmitter__emit(&rtoc_self_view, node.target));
    RETURN "${TRY (mIREmitter__render_resource_close_plan(rtoc_self_view, node.close_plan, target))};";
}
END
PRIVATE FN mIREmitter__direct_cleanup_statement(self: MIREmitter, name: String, body: String, guarded: Bool) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE stripped = body.trim();
    MUTABLE statement: String = "";
    IF (stripped.endsWith?(";") OR stripped.endsWith?("}")) THEN
      statement = stripped;
    ELSE
      statement = "${stripped};";
    END
    IF guarded THEN
      RETURN "if (!${mIREmitter__move_guard_name(rtoc_self_view, Name{ StringValue: COPY name })}) ${statement}";
    ELSE
      RETURN statement;
    END
}
END
PRIVATE FN mIREmitter__direct_uniform_cleanup(self: MIREmitter, name: String, zig_type: String, alloc: String, guarded: Bool, via_pointer: ?Bool = FALSE) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE arg: String = "";
    IF via_pointer EXISTS AS via_pointer_value THEN
      arg = COPY name;
    ELSE
      arg = "&${name}";
    END
    MUTABLE storage_type = zigType__cleanup_storage_type(zigType__new(zig_type));
    RETURN mIREmitter__direct_cleanup_statement(rtoc_self_view, name, "CheatLib.cleanup(${storage_type}, ${alloc}, ${arg})", guarded);
}
END
PUB FN mIREmitter__new(state: ?EmissionState = NIL) RETURNS MIREmitter@multiowned ->
  MUTABLE self = MIREmitter{ deep_copy_counter: ((COPY state)?.deep_copy_counter OR_ELSE 0), discard_counter: ((COPY state)?.discard_counter OR_ELSE 0), flow_alias_name: NIL, heap_allocator_cache_name: NIL, heap_allocator_cache_names: List[], heap_allocator_cache_runtime_name: NIL, ident_overrides: {}, if_bind_counter: NIL, indent: 0, items_block_counter: ((COPY state)?.items_block_counter OR_ELSE 0), move_guard_overrides: {}, owned_slice_counter: ((COPY state)?.owned_slice_counter OR_ELSE 0), rt_name: "rt", symbol_literals: {}, uses_c_callback: (((COPY state)?.uses_c_callback != NIL) OR FALSE) };
  mIREmitter__initialize(&self, state);
  RETURN self @multiowned;
END
FN castBgBlockPlanToPlan(value: BgBlockPlan) RETURNS MIREmitterPlan ->
  PARTIAL MATCH value START
    BgBlockPlan.FsmIoBody AS cast_payload -> RETURN MIREmitterPlan{ FsmIoBody: COPY cast_payload };,
    BgBlockPlan.FsmB1Body AS cast_payload -> RETURN MIREmitterPlan{ FsmB1Body: COPY cast_payload };,
    BgBlockPlan.FsmGenericBody AS cast_payload -> RETURN MIREmitterPlan{ FsmGenericBody: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to MIREmitterPlan");
  END
  panic("Invalid cast to MIREmitterPlan");
END
FN castEmittableToFailureAction(value: Emittable) RETURNS FailureAction ->
  IF value IS_A FailureAction AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to FailureAction");
END
FN castEmittableToOptionalFailureAction(value: Emittable) RETURNS ?FailureAction ->
  IF value IS_A FailureAction AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN NIL;
END
FN castEmittableToTryCatch__mir_emitter(value: Emittable) RETURNS TryCatch ->
  IF value IS_A TryCatch AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to TryCatch");
END
FN castNameToString__mir_emitter(value: Name) RETURNS String ->
  IF value IS_A String AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN "";
END
FN castOptionalMIRReturnValueToName(value: ?MIRReturnValue) RETURNS Name ->
  IF value == NIL THEN
    panic("Invalid cast to Name");
  END
  PARTIAL MATCH value START
    MIRReturnValue.StringValue AS cast_payload -> RETURN Name{ StringValue: COPY cast_payload };,
    MIRReturnValue.SymbolValue AS cast_payload -> RETURN Name{ SymbolValue: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Name");
  END
  panic("Invalid cast to Name");
END
FN castPlanToFsmBody(value: MIREmitterPlan) RETURNS FsmBody ->
  PARTIAL MATCH value START
    MIREmitterPlan.FsmIoBody AS cast_payload -> RETURN FsmBody{ FsmIoBody: COPY cast_payload };,
    MIREmitterPlan.FsmB1Body AS cast_payload -> RETURN FsmBody{ FsmB1Body: COPY cast_payload };,
    MIREmitterPlan.FsmGenericBody AS cast_payload -> RETURN FsmBody{ FsmGenericBody: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to FsmBody");
  END
  panic("Invalid cast to FsmBody");
END
FN rtoc_delete_prefix__mir_emitter(s: String, affix: String) RETURNS String ->
  IF s.startsWith?(affix) THEN
    RETURN s.substr(affix.length(), (s.length() - affix.length()));
  END
  RETURN COPY s;
END
FN rubyToClearVoid__mir_emitter() RETURNS Void ->
  RETURN;
END

# Ruby asks `respond_to?(:shard_idx)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN mIREmitterShardedMapNode__shard_idx(value: MIREmitterShardedMapNode) RETURNS ?Emittable@boxed ->
  PARTIAL MATCH value START
    MIREmitterShardedMapNode.ShardedMapPut AS item -> RETURN COPY item.shard_idx;,
    MIREmitterShardedMapNode.ShardedMapGet AS item -> RETURN COPY item.shard_idx;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
# Ruby asks `respond_to?(:shard_key)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN mIREmitterShardedMapNode__shard_key(value: MIREmitterShardedMapNode) RETURNS ?Emittable@boxed ->
  PARTIAL MATCH value START
    MIREmitterShardedMapNode.ShardedMapPut AS item -> RETURN COPY item.shard_key;,
    MIREmitterShardedMapNode.ShardedMapGet AS item -> RETURN COPY item.shard_key;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
