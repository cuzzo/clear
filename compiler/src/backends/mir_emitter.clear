REQUIRE "../ast/type.clear"
REQUIRE "../ast/error_registry.clear"
REQUIRE "../mir/mir.clear"
REQUIRE "../mir/cleanup_entry.clear"
REQUIRE "../mir/placement.clear"
REQUIRE "zig_type.clear"
REQUIRE "fsm_wrapper_emitter.clear"
REQUIRE "../ast/ast.clear"
REQUIRE "../annotator/helpers/function_signature.clear"
REQUIRE "../annotator/helpers/intrinsic_contract.clear"
REQUIRE "../ast/async_result_shape.clear"
EXTERN FN compilerStringDump(value: String) RETURNS String EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerByteStringLiteral(value: String) RETURNS String EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerStringChomp(value: String, separator: String) RETURNS String EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerInspectValue() RETURNS String EFFECTS :safe FROM "compiler_regex";
EXTERN STRUCT CompilerRegex {} FROM "compiler_regex";
EXTERN FN compilerRegexCompile(pattern: String) RETURNS CompilerRegex EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexReplaceAll(subject: String, regex: CompilerRegex, replacement: String) RETURNS String EFFECTS :safe FROM "compiler_regex";
FN regexReplaceAll__mir_emitter(subject: String, pattern: String, replacement: String) RETURNS String ->
  RETURN compilerRegexReplaceAll(subject, compilerRegexCompile(pattern), replacement);
END
UNION MIREmitterPlan { FsmIoBody: FsmIoBody, FsmB1Body: FsmB1Body, FsmGenericBody: FsmGenericBody }
STRUCT MIREmitter {
  deep_copy_counter: Int64,
  discard_counter: Int64,
  flow_alias_name: ?String,
  heap_allocator_cache_name: ?String,
  heap_allocator_cache_names: []String,
  heap_allocator_cache_runtime_name: ?String,
  ident_overrides: {String}String,
  if_bind_counter: ?Int64,
  indent: Int64,
  items_block_counter: Int64,
  move_guard_overrides: {String}String,
  owned_slice_counter: Int64,
  rt_name: String,
  symbol_literals: {String}String,
  uses_c_callback: Bool
}

STRUCT EmissionState {
  symbol_literals: {String}String,
  uses_c_callback: Bool,
  if_bind_counter: ?Int64,
  discard_counter: Int64,
  deep_copy_counter: Int64,
  items_block_counter: Int64,
  owned_slice_counter: Int64
}
UNION MIREmitterShardedMapNode { ShardedMapPut: ShardedMapPut, ShardedMapGet: ShardedMapGet }
FN mIREmitter__initialize(MUTABLE self: MIREmitter, state: ?EmissionState = NIL) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.indent = 0;
    rtoc_self_view.rt_name = "rt";
    rtoc_self_view.heap_allocator_cache_name = NIL;
    rtoc_self_view.heap_allocator_cache_runtime_name = NIL;
    rtoc_self_view.heap_allocator_cache_names = List[];
    rtoc_self_view.flow_alias_name = NIL;
    rtoc_self_view.if_bind_counter = state?.if_bind_counter;
    rtoc_self_view.discard_counter = (state?.discard_counter OR_ELSE 0);
    rtoc_self_view.deep_copy_counter = (state?.deep_copy_counter OR_ELSE 0);
    rtoc_self_view.items_block_counter = (state?.items_block_counter OR_ELSE 0);
    rtoc_self_view.owned_slice_counter = (state?.owned_slice_counter OR_ELSE 0);
    rtoc_self_view.symbol_literals = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_1: ?{String}String = NIL;
    IF state != NIL THEN
      rtoc_ternary_value_1 = COPY state.symbol_literals;
    ELSE
      rtoc_ternary_value_1 = {};
    END
    rtoc_ternary_value_1? };
    rtoc_self_view.ident_overrides = {};
    rtoc_self_view.move_guard_overrides = {};
    rtoc_self_view.uses_c_callback = ((state?.uses_c_callback != NIL) OR FALSE);
}
END
FN mIREmitter__emission_state(self: MIREmitter) RETURNS EmissionState
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN EmissionState{ symbol_literals: COPY rtoc_self_view.symbol_literals, uses_c_callback: rtoc_self_view.uses_c_callback, if_bind_counter: rtoc_self_view.if_bind_counter, discard_counter: rtoc_self_view.discard_counter, deep_copy_counter: rtoc_self_view.deep_copy_counter, items_block_counter: rtoc_self_view.items_block_counter, owned_slice_counter: rtoc_self_view.owned_slice_counter };
}
END
PUB FN mIREmitter__emit(MUTABLE self: MIREmitter, node: ?Emittable) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (node == NIL) THEN
      RETURN COPY "";
    ELSE_IF node IS_A MIRProgram AS rtoc_m_i_r_program THEN
      RETURN TRY (mIREmitter__emit_program(&rtoc_self_view, rtoc_m_i_r_program));
    ELSE_IF node IS_A FnDef AS rtoc_fn_def THEN
      RETURN TRY (mIREmitter__emit_fn_def(&rtoc_self_view, rtoc_fn_def));
    ELSE_IF node IS_A MIRStructDef AS rtoc_m_i_r_struct_def THEN
      RETURN TRY (mIREmitter__emit_struct_def(&rtoc_self_view, rtoc_m_i_r_struct_def));
    ELSE_IF node IS_A MIREnumDef AS rtoc_m_i_r_enum_def THEN
      RETURN mIREmitter__emit_enum_def(rtoc_self_view, rtoc_m_i_r_enum_def);
    ELSE_IF node IS_A UnionTypeDef AS rtoc_union_type_def THEN
      RETURN TRY (mIREmitter__emit_union_def(&rtoc_self_view, rtoc_union_type_def));
    ELSE_IF node IS_A Import AS rtoc_import THEN
      RETURN mIREmitter__emit_import(rtoc_self_view, rtoc_import);
    ELSE_IF node IS_A TypeAlias AS rtoc_type_alias THEN
      RETURN mIREmitter__emit_type_alias(rtoc_self_view, rtoc_type_alias);
    ELSE_IF node IS_A CExternFnDecl AS rtoc_c_extern_fn_decl THEN
      RETURN TRY (mIREmitter__emit_c_extern_fn_decl(rtoc_self_view, rtoc_c_extern_fn_decl));
    ELSE_IF node IS_A CExternStructDef AS rtoc_c_extern_struct_def THEN
      RETURN TRY (mIREmitter__emit_c_extern_struct_def(rtoc_self_view, rtoc_c_extern_struct_def));
    ELSE_IF node IS_A ModuleNamespace AS rtoc_module_namespace THEN
      RETURN TRY (mIREmitter__emit_module_namespace(&rtoc_self_view, rtoc_module_namespace));
    ELSE_IF node IS_A TestDef AS rtoc_test_def THEN
      RETURN TRY (mIREmitter__emit_test_def(&rtoc_self_view, rtoc_test_def));
    ELSE_IF node IS_A Let AS rtoc_let THEN
      RETURN TRY (mIREmitter__emit_let(&rtoc_self_view, rtoc_let));
    ELSE_IF node IS_A Set AS rtoc_set THEN
      RETURN TRY (mIREmitter__emit_set(&rtoc_self_view, rtoc_set));
    ELSE_IF node IS_A DestructureSet AS rtoc_destructure_set THEN
      RETURN TRY (mIREmitter__emit_destructure_set(&rtoc_self_view, rtoc_destructure_set));
    ELSE_IF node IS_A ReassignWithCleanup AS rtoc_reassign_with_cleanup THEN
      RETURN TRY (mIREmitter__emit_reassign_cleanup(&rtoc_self_view, rtoc_reassign_with_cleanup));
    ELSE_IF node IS_A ResourceClose AS rtoc_resource_close THEN
      RETURN TRY (mIREmitter__emit_resource_close(&rtoc_self_view, rtoc_resource_close));
    ELSE_IF node IS_A IfStmt AS rtoc_if_stmt THEN
      RETURN TRY (mIREmitter__emit_if_stmt(&rtoc_self_view, rtoc_if_stmt));
    ELSE_IF node IS_A IfBindStmt AS rtoc_if_bind_stmt THEN
      RETURN TRY (mIREmitter__emit_if_bind_stmt(&rtoc_self_view, rtoc_if_bind_stmt));
    ELSE_IF node IS_A WhileStmt AS rtoc_while_stmt THEN
      RETURN TRY (mIREmitter__emit_while(&rtoc_self_view, rtoc_while_stmt));
    ELSE_IF node IS_A ForStmt AS rtoc_for_stmt THEN
      RETURN TRY (mIREmitter__emit_for(&rtoc_self_view, rtoc_for_stmt));
    ELSE_IF node IS_A SwitchStmt AS rtoc_switch_stmt THEN
      RETURN TRY (mIREmitter__emit_switch(&rtoc_self_view, rtoc_switch_stmt));
    ELSE_IF node IS_A UnionMatchStmt AS rtoc_union_match_stmt THEN
      RETURN TRY (mIREmitter__emit_union_match(&rtoc_self_view, rtoc_union_match_stmt));
    ELSE_IF node IS_A IfChain AS rtoc_if_chain THEN
      RETURN TRY (mIREmitter__emit_if_chain(&rtoc_self_view, rtoc_if_chain));
    ELSE_IF node IS_A ReturnStmt AS rtoc_return_stmt THEN
      RETURN TRY (mIREmitter__emit_return(&rtoc_self_view, rtoc_return_stmt));
    ELSE_IF node IS_A BreakStmt AS rtoc_break_stmt THEN
      RETURN TRY (mIREmitter__emit_break(&rtoc_self_view, rtoc_break_stmt));
    ELSE_IF (node IS_A ContinueStmt) THEN
      RETURN COPY "continue;";
    ELSE_IF (node IS_A Panic) THEN
      RETURN COPY "@panic(${compilerInspectValue()});";
    ELSE_IF node IS_A AssertStmt AS rtoc_assert_stmt THEN
      RETURN TRY (mIREmitter__emit_assert_stmt(&rtoc_self_view, rtoc_assert_stmt));
    ELSE_IF node IS_A AssertRaisesCheck AS rtoc_assert_raises_check THEN
      RETURN TRY (mIREmitter__emit_assert_raises_check(&rtoc_self_view, rtoc_assert_raises_check));
    ELSE_IF (node IS_A TestPreamble) THEN
      RETURN mIREmitter__emit_test_preamble(rtoc_self_view);
    ELSE_IF node IS_A DebugOnly AS rtoc_debug_only THEN
      RETURN TRY (mIREmitter__emit_debug_only(&rtoc_self_view, rtoc_debug_only));
    ELSE_IF node IS_A Sort AS rtoc_sort THEN
      RETURN TRY (mIREmitter__emit_sort(&rtoc_self_view, rtoc_sort));
    ELSE_IF node IS_A SoaFieldAccess AS rtoc_soa_field_access THEN
      RETURN COPY "${TRY (mIREmitter__emit(&rtoc_self_view, rtoc_soa_field_access.soa_expr))}.data.items(.${rtoc_soa_field_access.field_name})";
    ELSE_IF node IS_A TryOrPanic AS rtoc_try_or_panic THEN
      RETURN COPY "${TRY (mIREmitter__emit(&rtoc_self_view, rtoc_try_or_panic.expr))} catch @panic(${compilerInspectValue()})";
    ELSE_IF node IS_A IndexInsert AS rtoc_index_insert THEN
      RETURN TRY (mIREmitter__emit_index_insert(&rtoc_self_view, rtoc_index_insert));
    ELSE_IF node IS_A BatchWindowPush AS rtoc_batch_window_push THEN
      RETURN TRY (mIREmitter__emit_batch_window_push(&rtoc_self_view, rtoc_batch_window_push));
    ELSE_IF node IS_A BatchWindowFlush AS rtoc_batch_window_flush THEN
      RETURN TRY (mIREmitter__emit_batch_window_flush(&rtoc_self_view, rtoc_batch_window_flush));
    ELSE_IF node IS_A ThunkTrampoline AS rtoc_thunk_trampoline THEN
      RETURN TRY (mIREmitter__emit_thunk_trampoline(&rtoc_self_view, rtoc_thunk_trampoline));
    ELSE_IF node IS_A MutualThunkTrampoline AS rtoc_mutual_thunk_trampoline THEN
      RETURN TRY (mIREmitter__emit_mutual_thunk_trampoline(&rtoc_self_view, rtoc_mutual_thunk_trampoline));
    ELSE_IF node IS_A MIRDeferStmt AS rtoc_m_i_r_defer_stmt THEN
      RETURN TRY (mIREmitter__emit_defer(&rtoc_self_view, rtoc_m_i_r_defer_stmt));
    ELSE_IF node IS_A ErrDeferStmt AS rtoc_err_defer_stmt THEN
      RETURN TRY (mIREmitter__emit_errdefer(&rtoc_self_view, rtoc_err_defer_stmt));
    ELSE_IF node IS_A ExprStmt AS rtoc_expr_stmt THEN
      RETURN TRY (mIREmitter__emit_expr_stmt(&rtoc_self_view, rtoc_expr_stmt));
    ELSE_IF node IS_A DiscardOwned AS rtoc_discard_owned THEN
      RETURN TRY (mIREmitter__emit_discard_owned(&rtoc_self_view, rtoc_discard_owned));
    ELSE_IF node IS_A ScopeBlock AS rtoc_scope_block THEN
      RETURN TRY (mIREmitter__emit_scope_block(&rtoc_self_view, rtoc_scope_block));
    ELSE_IF node IS_A Pipeline AS rtoc_pipeline THEN
      RETURN TRY (mIREmitter__emit(&rtoc_self_view, rtoc_pipeline.inner));
    ELSE_IF node IS_A MIRBgBlock AS rtoc_m_i_r_bg_block THEN
      RETURN TRY (mIREmitter__emit_bg_block(&rtoc_self_view, rtoc_m_i_r_bg_block));
    ELSE_IF node IS_A DirectTenseMap AS rtoc_direct_tense_map THEN
      RETURN TRY (mIREmitter__emit_direct_tense_map(&rtoc_self_view, rtoc_direct_tense_map));
    ELSE_IF node IS_A AsyncPayloadTake AS rtoc_async_payload_take THEN
      RETURN COPY "${mIREmitter__paren_if_try(rtoc_self_view, TRY (mIREmitter__emit(&rtoc_self_view, rtoc_async_payload_take.source)))}.value";
    ELSE_IF node IS_A ShardConcurrentEach AS rtoc_shard_concurrent_each THEN
      RETURN TRY (mIREmitter__emit_shard_concurrent_each(&rtoc_self_view, rtoc_shard_concurrent_each));
    ELSE_IF node IS_A MIRDoBlock AS rtoc_m_i_r_do_block THEN
      RETURN TRY (mIREmitter__emit_do_block(&rtoc_self_view, rtoc_m_i_r_do_block));
    ELSE_IF node IS_A CatchWrapper AS rtoc_catch_wrapper THEN
      RETURN TRY (mIREmitter__emit_catch_wrapper(&rtoc_self_view, rtoc_catch_wrapper));
    ELSE_IF node IS_A Comment AS rtoc_comment THEN
      RETURN COPY "// ${rtoc_comment.text}";
    ELSE_IF node IS_A Suppress AS rtoc_suppress THEN
      RETURN COPY "_ = &${rtoc_suppress.name};";
    ELSE_IF node IS_A PubConst AS rtoc_pub_const THEN
      RETURN COPY "pub const ${rtoc_pub_const.name} = ${rtoc_pub_const.value};";
    ELSE_IF node IS_A ModuleVar AS rtoc_module_var THEN
      RETURN "${IF (rtoc_module_var.visibility == :pub) THEN
        "pub "
      ELSE
        ""
      END}var ${rtoc_module_var.name}: ${rtoc_module_var.zig_type} = undefined;";
    ELSE_IF node IS_A ModuleConstFree AS rtoc_module_const_free THEN
      RETURN COPY "defer CheatLib.cleanup(@TypeOf(${rtoc_module_const_free.name}), ${rtoc_self_view.rt_name}.heapAlloc(), &${rtoc_module_const_free.name});";
    ELSE_IF node IS_A ProtocolAdapterDef AS rtoc_protocol_adapter_def THEN
      RETURN mIREmitter__emit_protocol_adapter_def(rtoc_self_view, rtoc_protocol_adapter_def);
    ELSE_IF node IS_A HeapCreate AS rtoc_heap_create THEN
      RETURN TRY (mIREmitter__emit_heap_create(&rtoc_self_view, rtoc_heap_create));
    ELSE_IF node IS_A DupeSlice AS rtoc_dupe_slice THEN
      RETURN TRY (mIREmitter__emit_dupe_slice(&rtoc_self_view, rtoc_dupe_slice));
    ELSE_IF node IS_A AllocSlice AS rtoc_alloc_slice THEN
      RETURN TRY (mIREmitter__emit_alloc_slice(&rtoc_self_view, rtoc_alloc_slice));
    ELSE_IF node IS_A FreeSlice AS rtoc_free_slice THEN
      RETURN TRY (mIREmitter__emit_free_slice(&rtoc_self_view, rtoc_free_slice));
    ELSE_IF node IS_A DestroyPtr AS rtoc_destroy_ptr THEN
      RETURN TRY (mIREmitter__emit_destroy_ptr(&rtoc_self_view, rtoc_destroy_ptr));
    ELSE_IF node IS_A Cleanup AS rtoc_cleanup THEN
      RETURN TRY (mIREmitter__emit_cleanup(rtoc_self_view, COPY rtoc_cleanup.name, KEEP rtoc_cleanup.cleanup_entry));
    ELSE_IF node IS_A ErrCleanup AS rtoc_err_cleanup THEN
      RETURN TRY (mIREmitter__emit_cleanup(rtoc_self_view, COPY rtoc_err_cleanup.name, KEEP rtoc_err_cleanup.cleanup_entry, TRUE));
    ELSE_IF node IS_A MoveMark AS rtoc_move_mark THEN
      RETURN mIREmitter__emit_move_mark(rtoc_self_view, rtoc_move_mark);
    ELSE_IF node IS_A DeepCopy AS rtoc_deep_copy THEN
      RETURN TRY (mIREmitter__emit_deep_copy(&rtoc_self_view, rtoc_deep_copy));
    ELSE_IF node IS_A ContainerInit AS rtoc_container_init THEN
      RETURN TRY (mIREmitter__emit_container_init(&rtoc_self_view, rtoc_container_init));
    ELSE_IF node IS_A CapWrap AS rtoc_cap_wrap THEN
      RETURN TRY (mIREmitter__emit_cap_wrap(&rtoc_self_view, rtoc_cap_wrap));
    ELSE_IF node IS_A SharePromote AS rtoc_share_promote THEN
      RETURN TRY (mIREmitter__emit_share_promote(&rtoc_self_view, rtoc_share_promote));
    ELSE_IF node IS_A RcRetain AS rtoc_rc_retain THEN
      RETURN TRY (mIREmitter__emit_rc_retain(&rtoc_self_view, rtoc_rc_retain));
    ELSE_IF node IS_A ComptimeCarrierPayload AS rtoc_comptime_carrier_payload THEN
      RETURN TRY (mIREmitter__emit_comptime_carrier_payload(&rtoc_self_view, rtoc_comptime_carrier_payload));
    ELSE_IF node IS_A MonomorphicKeep AS rtoc_monomorphic_keep THEN
      RETURN TRY (mIREmitter__emit_monomorphic_keep(&rtoc_self_view, rtoc_monomorphic_keep));
    ELSE_IF node IS_A RcRelease AS rtoc_rc_release THEN
      RETURN TRY (mIREmitter__emit_rc_release(&rtoc_self_view, rtoc_rc_release));
    ELSE_IF node IS_A RcDowngrade AS rtoc_rc_downgrade THEN
      RETURN TRY (mIREmitter__emit_rc_downgrade(&rtoc_self_view, rtoc_rc_downgrade));
    ELSE_IF node IS_A WeakUpgrade AS rtoc_weak_upgrade THEN
      RETURN TRY (mIREmitter__emit_weak_upgrade(&rtoc_self_view, rtoc_weak_upgrade));
    ELSE_IF node IS_A FreezeExpr AS rtoc_freeze_expr THEN
      RETURN TRY (mIREmitter__emit_freeze(&rtoc_self_view, rtoc_freeze_expr));
    ELSE_IF node IS_A MakeList AS rtoc_make_list THEN
      RETURN TRY (mIREmitter__emit_make_list(&rtoc_self_view, rtoc_make_list));
    ELSE_IF node IS_A FrameSave AS rtoc_frame_save THEN
      RETURN mIREmitter__emit_frame_save(rtoc_self_view, rtoc_frame_save);
    ELSE_IF node IS_A FrameRestore AS rtoc_frame_restore THEN
      RETURN mIREmitter__emit_frame_restore(rtoc_self_view, rtoc_frame_restore);
    ELSE_IF node IS_A SnapshotRead AS rtoc_snapshot_read THEN
      RETURN TRY (mIREmitter__emit_snapshot_read(&rtoc_self_view, rtoc_snapshot_read));
    ELSE_IF node IS_A SnapshotTransaction AS rtoc_snapshot_transaction THEN
      RETURN TRY (mIREmitter__emit_snapshot_transaction(&rtoc_self_view, rtoc_snapshot_transaction));
    ELSE_IF node IS_A SnapshotMultiTxn AS rtoc_snapshot_multi_txn THEN
      RETURN TRY (mIREmitter__emit_snapshot_multi_txn(&rtoc_self_view, rtoc_snapshot_multi_txn));
    ELSE_IF node IS_A PolymorphicMutate AS rtoc_polymorphic_mutate THEN
      RETURN TRY (mIREmitter__emit_polymorphic_mutate(&rtoc_self_view, rtoc_polymorphic_mutate));
    ELSE_IF node IS_A PolymorphicMutateFlow AS rtoc_polymorphic_mutate_flow THEN
      RETURN TRY (mIREmitter__emit_polymorphic_mutate_flow(&rtoc_self_view, rtoc_polymorphic_mutate_flow));
    ELSE_IF node IS_A WithMatchDispatch AS rtoc_with_match_dispatch THEN
      RETURN TRY (mIREmitter__emit_with_match_dispatch(&rtoc_self_view, rtoc_with_match_dispatch));
    ELSE_IF node IS_A SortedLockAcquire AS rtoc_sorted_lock_acquire THEN
      RETURN TRY (mIREmitter__emit_sorted_lock_acquire(&rtoc_self_view, rtoc_sorted_lock_acquire));
    ELSE_IF node IS_A FallibleLockBinding AS rtoc_fallible_lock_binding THEN
      RETURN TRY (mIREmitter__emit_fallible_lock_binding(&rtoc_self_view, rtoc_fallible_lock_binding));
    ELSE_IF (node IS_A Noop) OR (node IS_A AllocMark) OR (node IS_A ReturnMark) OR (node IS_A TransferMark) OR (node IS_A ReassignMark) OR (node IS_A FieldCleanupMark) OR (node IS_A OwnedCreate) OR (node IS_A OwnedDestroy) OR (node IS_A OwnedTransfer) OR (node IS_A OwnedBorrow) OR (node IS_A OwnedStore) OR (node IS_A OwnedReturn) THEN
      RETURN COPY "";
    ELSE_IF node IS_A Call AS rtoc_call THEN
      RETURN TRY (mIREmitter__emit_call(&rtoc_self_view, rtoc_call));
    ELSE_IF node IS_A RuntimeCall AS rtoc_runtime_call THEN
      RETURN TRY (mIREmitter__emit_runtime_call(&rtoc_self_view, rtoc_runtime_call));
    ELSE_IF node IS_A TailCall AS rtoc_tail_call THEN
      RETURN TRY (mIREmitter__emit_tail_call(&rtoc_self_view, rtoc_tail_call));
    ELSE_IF node IS_A MIRMethodCall AS rtoc_m_i_r_method_call THEN
      RETURN TRY (mIREmitter__emit_method_call(&rtoc_self_view, rtoc_m_i_r_method_call));
    ELSE_IF node IS_A FieldGet AS rtoc_field_get THEN
      RETURN TRY (mIREmitter__emit_field_get(&rtoc_self_view, rtoc_field_get));
    ELSE_IF node IS_A UnionPayloadGet AS rtoc_union_payload_get THEN
      RETURN TRY (mIREmitter__emit_union_payload_get(&rtoc_self_view, rtoc_union_payload_get));
    ELSE_IF node IS_A IndexGet AS rtoc_index_get THEN
      RETURN TRY (mIREmitter__emit_index_get(&rtoc_self_view, rtoc_index_get));
    ELSE_IF node IS_A MIRBinOp AS rtoc_m_i_r_bin_op THEN
      RETURN TRY (mIREmitter__emit_bin_op(&rtoc_self_view, rtoc_m_i_r_bin_op));
    ELSE_IF node IS_A FallibleOk AS rtoc_fallible_ok THEN
      RETURN COPY "if (${TRY (mIREmitter__emit(&rtoc_self_view, rtoc_fallible_ok.expr))}) |_| true else |_| false";
    ELSE_IF node IS_A FutureReady AS rtoc_future_ready THEN
      RETURN COPY "${TRY (mIREmitter__emit(&rtoc_self_view, rtoc_future_ready.expr))}.isReady()";
    ELSE_IF node IS_A MIRUnaryOp AS rtoc_m_i_r_unary_op THEN
      RETURN TRY (mIREmitter__emit_unary_op(&rtoc_self_view, rtoc_m_i_r_unary_op));
    ELSE_IF node IS_A Lit AS rtoc_lit THEN
      RETURN COPY CAST(rtoc_lit.value AS String);
    ELSE_IF node IS_A SymbolLit AS rtoc_symbol_lit THEN
      RETURN mIREmitter__symbol_literal_name(&rtoc_self_view, CAST(rtoc_symbol_lit.value AS String));
    ELSE_IF (node IS_A VoidLiteral) THEN
      RETURN COPY "{}";
    ELSE_IF node IS_A DefaultValue AS rtoc_default_value THEN
      RETURN TRY (mIREmitter__emit_default_value(rtoc_self_view, rtoc_default_value));
    ELSE_IF node IS_A EnumTag AS rtoc_enum_tag THEN
      RETURN COPY ".${rtoc_enum_tag.variant}";
    ELSE_IF node IS_A EnumOrdinal AS rtoc_enum_ordinal THEN
      RETURN COPY "@intFromEnum(${TRY (mIREmitter__emit(&rtoc_self_view, rtoc_enum_ordinal.value))})";
    ELSE_IF node IS_A Ident AS rtoc_ident THEN
      RETURN COPY (rtoc_self_view.ident_overrides[CAST(rtoc_ident.name AS String)] OR_ELSE CAST(rtoc_ident.name AS String));
    ELSE_IF node IS_A MIRDestructureTarget AS rtoc_m_i_r_destructure_target THEN
      RETURN TRY (mIREmitter__emit_destructure_target(rtoc_self_view, rtoc_m_i_r_destructure_target));
    ELSE_IF node IS_A TupleLiteral AS rtoc_tuple_literal THEN
      RETURN TRY (mIREmitter__emit_tuple_literal(&rtoc_self_view, rtoc_tuple_literal));
    ELSE_IF node IS_A CapabilityUnwrap AS rtoc_capability_unwrap THEN
      RETURN TRY (mIREmitter__emit_capability_unwrap(&rtoc_self_view, rtoc_capability_unwrap));
    ELSE_IF node IS_A CapabilityLockTarget AS rtoc_capability_lock_target THEN
      RETURN TRY (mIREmitter__emit_capability_lock_target(&rtoc_self_view, rtoc_capability_lock_target));
    ELSE_IF node IS_A CapabilityLockAddress AS rtoc_capability_lock_address THEN
      RETURN TRY (mIREmitter__emit_capability_lock_address(&rtoc_self_view, rtoc_capability_lock_address));
    ELSE_IF node IS_A FnRef AS rtoc_fn_ref THEN
      RETURN COPY "&${rtoc_fn_ref.name}";
    ELSE_IF node IS_A LockAcquire AS rtoc_lock_acquire THEN
      RETURN TRY (mIREmitter__emit_lock_acquire(&rtoc_self_view, rtoc_lock_acquire));
    ELSE_IF node IS_A TypeOf AS rtoc_type_of THEN
      RETURN COPY "@TypeOf(${TRY (mIREmitter__emit(&rtoc_self_view, rtoc_type_of.expr))})";
    ELSE_IF node IS_A TypeEq AS rtoc_type_eq THEN
      RETURN COPY "(${TRY (mIREmitter__emit(&rtoc_self_view, rtoc_type_eq.left))} == ${TRY (mIREmitter__emit(&rtoc_self_view, rtoc_type_eq.right))})";
    ELSE_IF node IS_A StructInit AS rtoc_struct_init THEN
      RETURN TRY (mIREmitter__emit_struct_init(&rtoc_self_view, rtoc_struct_init));
    ELSE_IF node IS_A ArrayInit AS rtoc_array_init THEN
      RETURN TRY (mIREmitter__emit_array_init(&rtoc_self_view, rtoc_array_init));
    ELSE_IF node IS_A ArrayDefaultInit AS rtoc_array_default_init THEN
      RETURN TRY (mIREmitter__emit_array_default_init(&rtoc_self_view, rtoc_array_default_init));
    ELSE_IF node IS_A SliceExpr AS rtoc_slice_expr THEN
      RETURN TRY (mIREmitter__emit_slice_expr(&rtoc_self_view, rtoc_slice_expr));
    ELSE_IF node IS_A MIRBlockExpr AS rtoc_m_i_r_block_expr THEN
      RETURN TRY (mIREmitter__emit_block_expr(&rtoc_self_view, rtoc_m_i_r_block_expr));
    ELSE_IF node IS_A ConcatStr AS rtoc_concat_str THEN
      RETURN TRY (mIREmitter__emit_concat(&rtoc_self_view, rtoc_concat_str));
    ELSE_IF node IS_A MIRCast AS rtoc_m_i_r_cast THEN
      RETURN TRY (mIREmitter__emit_cast(&rtoc_self_view, rtoc_m_i_r_cast));
    ELSE_IF node IS_A TryExpr AS rtoc_try_expr THEN
      MUTABLE try_expr: Emittable = COPY rtoc_try_expr.expr;
      IF try_expr IS_A MIROptionalUnwrap AS rtoc_optional_unwrap THEN
        RETURN COPY "(try ${TRY (mIREmitter__emit(&rtoc_self_view, rtoc_optional_unwrap.expr))}).?";
      ELSE
        RETURN COPY "try ${TRY (mIREmitter__emit(&rtoc_self_view, try_expr))}";
      END
    ELSE_IF node IS_A TryOptional AS rtoc_try_optional THEN
      RETURN COPY "(${TRY (mIREmitter__emit(&rtoc_self_view, rtoc_try_optional.expr))} orelse return error.TryOptional)";
    ELSE_IF node IS_A TryCatch AS rtoc_try_catch THEN
      RETURN TRY (mIREmitter__emit_try_catch(&rtoc_self_view, rtoc_try_catch));
    ELSE_IF node IS_A BreakExpr AS rtoc_break_expr THEN
      RETURN TRY (mIREmitter__emit_break_expr(&rtoc_self_view, rtoc_break_expr));
    ELSE_IF node IS_A Orelse AS rtoc_orelse THEN
      RETURN TRY (mIREmitter__emit_orelse(&rtoc_self_view, rtoc_orelse));
    ELSE_IF node IS_A Conditional AS rtoc_conditional THEN
      RETURN TRY (mIREmitter__emit_conditional(&rtoc_self_view, rtoc_conditional));
    ELSE_IF node IS_A IfOptional AS rtoc_if_optional THEN
      RETURN TRY (mIREmitter__emit_if_optional(&rtoc_self_view, rtoc_if_optional));
    ELSE_IF node IS_A Comptime AS rtoc_comptime THEN
      RETURN COPY "comptime ${TRY (mIREmitter__emit(&rtoc_self_view, rtoc_comptime.expr))}";
    ELSE_IF node IS_A UnionVariantGet AS rtoc_union_variant_get THEN
      RETURN COPY "${mIREmitter__paren_if_try(rtoc_self_view, TRY (mIREmitter__emit(&rtoc_self_view, rtoc_union_variant_get.object)))}.${rtoc_union_variant_get.variant}";
    ELSE_IF node IS_A ListItems AS rtoc_list_items THEN
      RETURN COPY "${mIREmitter__paren_if_try(rtoc_self_view, TRY (mIREmitter__emit(&rtoc_self_view, rtoc_list_items.list)))}.items";
    ELSE_IF node IS_A ListLength AS rtoc_list_length THEN
      RETURN COPY "${mIREmitter__paren_if_try(rtoc_self_view, TRY (mIREmitter__emit(&rtoc_self_view, rtoc_list_length.expr)))}.len";
    ELSE_IF node IS_A AddressOf AS rtoc_address_of THEN
      RETURN COPY "&${TRY (mIREmitter__emit(&rtoc_self_view, rtoc_address_of.expr))}";
    ELSE_IF node IS_A Deref AS rtoc_deref THEN
      RETURN COPY "${TRY (mIREmitter__emit(&rtoc_self_view, rtoc_deref.expr))}.*";
    ELSE_IF node IS_A PointerCast AS rtoc_pointer_cast THEN
      RETURN TRY (mIREmitter__emit_pointer_cast(&rtoc_self_view, rtoc_pointer_cast));
    ELSE_IF node IS_A ConstCast AS rtoc_const_cast THEN
      RETURN COPY "@constCast(${TRY (mIREmitter__emit(&rtoc_self_view, rtoc_const_cast.expr))})";
    ELSE_IF node IS_A DefaultStreamCapacity AS rtoc_default_stream_capacity THEN
      RETURN TRY (mIREmitter__emit_default_stream_capacity(&rtoc_self_view, rtoc_default_stream_capacity));
    ELSE_IF node IS_A NextPromiseList AS rtoc_next_promise_list THEN
      RETURN TRY (mIREmitter__emit_next_promise_list(&rtoc_self_view, rtoc_next_promise_list));
    ELSE_IF node IS_A MIROptionalUnwrap AS rtoc_optional_unwrap_node THEN
      RETURN COPY "${mIREmitter__paren_if_try(rtoc_self_view, TRY (mIREmitter__emit(&rtoc_self_view, rtoc_optional_unwrap_node.expr)))}.?";
    ELSE_IF node IS_A ForeignOwnedUnwrap AS rtoc_foreign_owned_unwrap THEN
      RETURN COPY "${mIREmitter__paren_if_try(rtoc_self_view, TRY (mIREmitter__emit(&rtoc_self_view, rtoc_foreign_owned_unwrap.expr)))}.?";
    ELSE_IF node IS_A CFunctionAdapter AS rtoc_c_function_adapter THEN
      RETURN TRY (mIREmitter__emit_c_function_adapter(&rtoc_self_view, rtoc_c_function_adapter));
    ELSE_IF node IS_A ForeignSliceView AS rtoc_foreign_slice_view THEN
      RETURN COPY "${TRY (mIREmitter__emit(&rtoc_self_view, rtoc_foreign_slice_view.pointer))}[0..@intCast(${TRY (mIREmitter__emit(&rtoc_self_view, rtoc_foreign_slice_view.count))})]";
    ELSE_IF node IS_A AllocatorRef AS rtoc_allocator_ref THEN
      RETURN TRY (mIREmitter__emit_allocator_ref(rtoc_self_view, rtoc_allocator_ref));
    ELSE_IF (node IS_A Undef) THEN
      IF TRY (type__zig_type(CAST(node AS Type))) THEN
        RETURN COPY "@as(${TRY (type__zig_type(CAST(node AS Type)))}, undefined)";
      ELSE
        RETURN COPY "undefined";
      END
    ELSE_IF node IS_A TypeSentinel AS rtoc_type_sentinel THEN
      RETURN UNWRAP (mIREmitter__emit_type_sentinel(rtoc_self_view, rtoc_type_sentinel));
    ELSE_IF node IS_A IterRange AS rtoc_iter_range THEN
      RETURN COPY "${TRY (mIREmitter__emit(&rtoc_self_view, rtoc_iter_range.start))}..${TRY (mIREmitter__emit(&rtoc_self_view, rtoc_iter_range.end_val))}";
    ELSE_IF node IS_A MIRRangeLit AS rtoc_m_i_r_range_lit THEN
      RETURN TRY (mIREmitter__emit_range_lit(&rtoc_self_view, rtoc_m_i_r_range_lit));
    ELSE_IF node IS_A HasField AS rtoc_has_field THEN
      RETURN TRY (mIREmitter__emit_has_field(&rtoc_self_view, rtoc_has_field));
    ELSE_IF node IS_A ItemsAccess AS rtoc_items_access THEN
      RETURN TRY (mIREmitter__emit_items_access(&rtoc_self_view, rtoc_items_access));
    ELSE_IF node IS_A OwnedSlice AS rtoc_owned_slice THEN
      RETURN TRY (mIREmitter__emit_owned_slice(&rtoc_self_view, rtoc_owned_slice));
    ELSE_IF node IS_A LambdaExpr AS rtoc_lambda_expr THEN
      RETURN TRY (mIREmitter__emit_lambda(&rtoc_self_view, rtoc_lambda_expr));
    ELSE_IF node IS_A RegistryCall AS rtoc_registry_call THEN
      RETURN TRY (mIREmitter__emit_registry_call(&rtoc_self_view, rtoc_registry_call));
    ELSE_IF node IS_A IndexedStore AS rtoc_indexed_store THEN
      RETURN TRY (mIREmitter__emit_indexed_store(&rtoc_self_view, rtoc_indexed_store));
    ELSE_IF node IS_A ExternTrampoline AS rtoc_extern_trampoline THEN
      RETURN TRY (mIREmitter__emit_extern_trampoline(&rtoc_self_view, rtoc_extern_trampoline));
    ELSE_IF node IS_A ObservableConsumerSpawn AS rtoc_observable_consumer_spawn THEN
      RETURN TRY (mIREmitter__emit_observable_consumer_spawn(&rtoc_self_view, rtoc_observable_consumer_spawn));
    ELSE_IF node IS_A InlineBc AS rtoc_inline_bc THEN
      RETURN TRY (mIREmitter__emit_inline_bc_as_zig(&rtoc_self_view, rtoc_inline_bc));
    ELSE_IF node IS_A ShardedMapPut AS rtoc_sharded_map_put THEN
      RETURN TRY (mIREmitter__emit_sharded_map_put(&rtoc_self_view, rtoc_sharded_map_put));
    ELSE_IF node IS_A ShardedMapGet AS rtoc_sharded_map_get THEN
      RETURN TRY (mIREmitter__emit_sharded_map_get(&rtoc_self_view, rtoc_sharded_map_get));
    ELSE_IF node IS_A ProtocolCall AS rtoc_protocol_call THEN
      RETURN TRY (mIREmitter__emit_protocol_call(&rtoc_self_view, rtoc_protocol_call));
    ELSE
      panic("MIREmitter: unknown node type {}");
    END
}
END
PUB FN mIREmitter__emit_statements(MUTABLE self: MIREmitter, stmts: []Emittable) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN TRY (mIREmitter__emit_body(&rtoc_self_view, stmts));
}
END
FN mIREmitter__emit_bg_block(MUTABLE self: MIREmitter, node: MIRBgBlock) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE plan = COPY node.code;
    IF plan IS_A BgStackfulPlan AS bg_stackful_plan THEN
      MUTABLE bg_stackful_plan_mutable = COPY bg_stackful_plan;
      RETURN TRY (mIREmitter__emit_bg_stackful_plan(&rtoc_self_view, bg_stackful_plan_mutable));
    END
    IF plan IS_A BgStreamPlan AS bg_stream_plan THEN
      MUTABLE bg_stream_plan_mutable = COPY bg_stream_plan;
      RETURN TRY (mIREmitter__emit_bg_stream_plan(&rtoc_self_view, bg_stream_plan_mutable));
    END
    IF plan IS_A FutureMapPlan AS future_map_plan THEN
      MUTABLE future_map_plan_mutable = COPY future_map_plan;
      RETURN TRY (mIREmitter__emit_future_map_plan(&rtoc_self_view, future_map_plan_mutable));
    END
    IF mIREmitter__fsm_bg_body_plan?(rtoc_self_view, plan) THEN
      RETURN TRY (mIREmitter__emit_fsm_bg_body(rtoc_self_view, castBgBlockPlanToPlan(plan)));
    END
    panic("MIR::BgBlock must carry a structural emission plan, got {}");
}
END
FN mIREmitter__emit_direct_tense_map(MUTABLE self: MIREmitter, plan: DirectTenseMap) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN TRY (mIREmitter__emit_direct_tense_layers(rtoc_self_view, plan.layers, plan.bindings, TRY (mIREmitter__emit(&rtoc_self_view, plan.source)), TRY (mIREmitter__emit(&rtoc_self_view, plan.mapped)), plan.label));
}
END
FN mIREmitter__emit_direct_tense_layers(self: MIREmitter, layers: []String, bindings: []String, source: String, mapped: String, label: String) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (layers.length() == 0) THEN
      RETURN COPY mapped;
    END
    MUTABLE layer = COPY UNWRAP (layers.first());
    MUTABLE binding = COPY UNWRAP (bindings.first());
    MUTABLE tail = TRY (mIREmitter__emit_direct_tense_layers(rtoc_self_view, layers |> SKIP 1, bindings |> SKIP 1, binding, mapped, label));
    IF (layer == "!") THEN
      RETURN "${label}: {\n    const ${binding} = ${source} catch |__tense_err| break :${label} __tense_err;\n    break :${label} ${tail};\n}\n".trim();
    ELSE_IF (layer == "?") THEN
      RETURN COPY "if (${source}) |${binding}| ${tail} else null";
    ELSE
      panic("unsupported immediate tense-map layer {}");
    END
}
END
FN mIREmitter__emit_future_map_plan(MUTABLE self: MIREmitter, plan: FutureMapPlan) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE source = TRY (mIREmitter__emit(&rtoc_self_view, plan.source));
    MUTABLE source_init: String = "";
    IF plan.source_shared THEN
      source_init = "(${source}).retain()";
    ELSE
      source_init = COPY source;
    END
    MUTABLE run_body = (TRY (mIREmitter__emit_body_with_runtime(&rtoc_self_view, plan.run_body, plan.raw_rt))).replace("\n", "\n                  ");
    MUTABLE spawn_call = (TRY (mIREmitter__emit_fiber_spawn_call(rtoc_self_view, plan.spawn_call))).replace("\n", "\n          ");
    MUTABLE profile_comment = mIREmitter__emit_profile_task_site(rtoc_self_view, plan.profile_site);
    RETURN "${plan.blk_label}: {\n    ${profile_comment}\n    const ${plan.ctx_type} = struct {\n        inner: *${plan.promise_zig}.Inner,\n        alloc: std.mem.Allocator,\n        ${plan.source_field}: @TypeOf(${source}),\n        fn run(__raw_rt_map${plan.id.toString()}: *anyopaque, __raw_args_map${plan.id.toString()}: ?*anyopaque) anyerror!void {\n            const ${plan.raw_rt} = @as(*Runtime, @ptrCast(@alignCast(__raw_rt_map${plan.id.toString()})));\n            _ = &${plan.raw_rt};\n            const __ctx_map${plan.id.toString()} = @as(*@This(), @ptrCast(@alignCast(__raw_args_map${plan.id.toString()}.?)));\n            defer __ctx_map${plan.id.toString()}.alloc.destroy(__ctx_map${plan.id.toString()});\n            defer __ctx_map${plan.id.toString()}.inner.wg.done();\n            errdefer |fiber_err| __ctx_map${plan.id.toString()}.inner.result = fiber_err;\n            ${run_body}\n        }\n    };\n    const ${plan.alloc_var} = ${plan.rt_name}.heapAlloc();\n    const ${plan.promise_var} = try ${plan.promise_zig}.spawn(${plan.alloc_var}, ${plan.rt_name}.getSched());\n    const ${plan.ctx_var} = try ${plan.alloc_var}.create(${plan.ctx_type});\n    errdefer ${plan.alloc_var}.destroy(${plan.ctx_var});\n    ${plan.ctx_var}.* = .{\n        .inner = ${plan.promise_var}.inner,\n        .alloc = ${plan.alloc_var},\n        .${plan.source_field} = ${source_init},\n    };\n    ${spawn_call}\n    break :${plan.blk_label} ${plan.promise_var};\n}\n".trim();
}
END
FN mIREmitter__emit_bg_stackful_plan(MUTABLE self: MIREmitter, plan: BgStackfulPlan) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE run_body_raw = TRY (mIREmitter__emit_body_with_runtime(&rtoc_self_view, plan.run_body, plan.bg_rt));
    MUTABLE capture_frees_raw = TRY (mIREmitter__emit_capture_cleanup_actions_with_runtime(&rtoc_self_view, plan.capture_frees, plan.bg_rt));
    MUTABLE arena_init_raw: String = "";
    IF plan.arena_init EXISTS AS arena_init_value THEN
      arena_init_raw = TRY (mIREmitter__emit_node_with_runtime(&rtoc_self_view, arena_init_value, plan.bg_rt));
    ELSE
      arena_init_raw = "";
    END
    MUTABLE run_body_code = run_body_raw.replace("\n", "\n                  ");
    MUTABLE promoted_decls = (TRY (mIREmitter__emit_body(&rtoc_self_view, plan.promoted_decls))).replace("\n", "\n          ");
    MUTABLE capture_fields = (TRY (mIREmitter__emit_context_field_decls(&rtoc_self_view, plan.capture_fields))).replace("\n", "\n              ");
    MUTABLE capture_inits = TRY (mIREmitter__emit_struct_init_fields(&rtoc_self_view, plan.capture_inits));
    MUTABLE capture_frees = capture_frees_raw.replace("\n", "\n                  ");
    MUTABLE arena_init = COPY arena_init_raw;
    MUTABLE spawn_call = (TRY (mIREmitter__emit_fiber_spawn_call(rtoc_self_view, plan.spawn_call))).replace("\n", "\n          ");
    MUTABLE alloc_expr = TRY (mIREmitter__emit(&rtoc_self_view, plan.alloc_expr));
    MUTABLE profile_comment = mIREmitter__emit_profile_task_site(rtoc_self_view, plan.profile_site);
    MUTABLE suppress_line = mIREmitter__bg_stackful_runtime_suppress_line(rtoc_self_view, plan, run_body_raw, capture_frees_raw, arena_init_raw);
    MUTABLE void_result_line: String = "";
    IF plan.is_void THEN
      void_result_line = "__ctx_${plan.id.toString()}.inner.result = {};";
    END
    RETURN ("${plan.blk_label}: {\n    ${profile_comment}\n    const ${plan.ctx_type} = struct {\n        inner: *${plan.promise_zig}.Inner,\n        alloc: std.mem.Allocator,\n        ${capture_fields}\n        fn run(__raw_rt_${plan.id.toString()}: *anyopaque, __raw_args_${plan.id.toString()}: ?*anyopaque) anyerror!void {\n            const ${plan.bg_rt} = @as(*Runtime, @ptrCast(@alignCast(__raw_rt_${plan.id.toString()})));\n            ${suppress_line}\n            ${arena_init}\n            const __ctx_${plan.id.toString()} = @as(*@This(), @ptrCast(@alignCast(__raw_args_${plan.id.toString()}.?)));\n            defer __ctx_${plan.id.toString()}.alloc.destroy(__ctx_${plan.id.toString()});\n            defer __ctx_${plan.id.toString()}.inner.wg.done();\n            errdefer |fiber_err| __ctx_${plan.id.toString()}.inner.result = fiber_err;\n            ${capture_frees}\n            ${run_body_code}\n            ${void_result_line}\n        }\n    };\n    const ${plan.alloc_var} = ${alloc_expr};\n    const ${plan.promise_var} = try ${plan.promise_zig}.spawn(${plan.alloc_var}, ${plan.rt_name}.getSched());\n    ${promoted_decls}\n    const ${plan.ctx_var} = try ${plan.alloc_var}.create(${plan.ctx_type});\n    errdefer ${plan.alloc_var}.destroy(${plan.ctx_var});\n    ${plan.ctx_var}.* = .{ ${capture_inits} };\n    ${spawn_call}\n    break :${plan.blk_label} ${plan.promise_var};\n}\n").trim();
}
END
FN mIREmitter__bg_stackful_runtime_suppress_line(self: MIREmitter, plan: BgStackfulPlan, run_body_code: String, capture_frees: String, arena_init: String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE text = ((run_body_code $+ capture_frees) $+ arena_init);
    IF text.contains?(plan.bg_rt) THEN
      RETURN "";
    ELSE
      RETURN "_ = &${plan.bg_rt};";
    END
}
END
FN mIREmitter__fsm_bg_body_plan?<T>(self: MIREmitter, plan: T) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ((T IS_A FsmIoBody OR T IS_A FsmB1Body) OR T IS_A FsmGenericBody);
}
END
FN mIREmitter__emit_fsm_bg_body(self: MIREmitter, plan: MIREmitterPlan) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (fsmWrapperEmitter__render(castPlanToFsmBody(plan)));
}
END
FN mIREmitter__emit_bg_stream_plan(MUTABLE self: MIREmitter, plan: BgStreamPlan) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE body_code = (TRY (mIREmitter__emit_body_with_runtime(&rtoc_self_view, plan.body, "__rt"))).replace("\n", "\n                  ");
    MUTABLE promoted_decls = (TRY (mIREmitter__emit_body_with_runtime(&rtoc_self_view, plan.promoted_decls, "__rt"))).replace("\n", "\n          ");
    MUTABLE capture_cleanups = (TRY (mIREmitter__emit_body_with_runtime(&rtoc_self_view, plan.capture_cleanups, "__rt"))).replace("\n", "\n                  ");
    MUTABLE capture_fields = (TRY (mIREmitter__emit_context_field_decls(&rtoc_self_view, plan.capture_fields))).replace("\n", "\n              ");
    MUTABLE capture_inits = TRY (mIREmitter__emit_struct_init_fields(&rtoc_self_view, plan.capture_inits));
    MUTABLE spawn_call = (TRY (mIREmitter__emit_fiber_spawn_call(rtoc_self_view, plan.spawn_call))).replace("\n", "\n          ");
    MUTABLE rt_suppress: String = "";
    IF body_code.contains?("__rt") THEN
      rt_suppress = "";
    ELSE
      rt_suppress = "_ = &__rt;";
    END
    RETURN "${plan.blk_label}: {\n    const ${plan.ctx_type} = struct {\n        stream_inner: *${plan.stream_zig}.Inner,\n        alloc: std.mem.Allocator,\n        ${capture_fields}\n        fn run(__raw_rt_sg${plan.id.toString()}: *anyopaque, __raw_args_sg${plan.id.toString()}: ?*anyopaque) anyerror!void {\n            const __rt = @as(*Runtime, @ptrCast(@alignCast(__raw_rt_sg${plan.id.toString()})));\n            ${rt_suppress}\n            const ctx = @as(*@This(), @ptrCast(@alignCast(__raw_args_sg${plan.id.toString()}.?)));\n            defer ctx.alloc.destroy(ctx);\n            ${capture_cleanups}\n            var ${plan.local_stream} = ${plan.stream_zig}{ .inner = ctx.stream_inner, .alloc = ctx.alloc };\n            defer ${plan.local_stream}.close();\n            errdefer |gen_err| ${plan.local_stream}.inner.err = gen_err;\n            ${body_code}\n        }\n    };\n    const ${plan.alloc_var} = ${plan.rt_name}.getSched().allocator;\n    const ${plan.stream_var} = try ${plan.stream_zig}.spawnNew(${plan.alloc_var}, ${plan.rt_name}.getSched());\n    ${promoted_decls}\n    const ${plan.ctx_var} = try ${plan.alloc_var}.create(${plan.ctx_type});\n    errdefer ${plan.alloc_var}.destroy(${plan.ctx_var});\n    ${plan.ctx_var}.* = .{ ${capture_inits} };\n    ${spawn_call}\n    break :${plan.blk_label} ${plan.stream_var};\n}\n".trim();
}
END
FN mIREmitter__emit_do_block(MUTABLE self: MIREmitter, node: MIRDoBlock) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE plan = COPY node.code;
    RETURN TRY (mIREmitter__emit_do_block_plan(&rtoc_self_view, plan));
}
END
FN mIREmitter__emit_do_block_plan(MUTABLE self: MIREmitter, plan: DoBlockPlan) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE branches = (plan.branches |> SELECT TRY (mIREmitter__emit_do_branch_plan(&rtoc_self_view, _))).join("\n");
    RETURN "{\n    var ${plan.wg_var} = CheatHeader.WaitGroup.init(${rtoc_self_view.rt_name}.getSched());\n    errdefer ${plan.wg_var}.wait();\n    ${branches}\n${plan.wg_var}.wait();\n}\n".trim();
}
END
FN mIREmitter__emit_do_branch_plan(MUTABLE self: MIREmitter, plan: DoBranchPlan) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE body_code = (TRY (mIREmitter__emit_body_with_runtime(&rtoc_self_view, plan.body, "__rt"))).replace("\n", "\n        ");
    MUTABLE capture_pre_decls = (TRY (mIREmitter__emit_body_with_runtime(&rtoc_self_view, plan.capture_pre_decls, "__rt"))).replace("\n", "\n        ");
    MUTABLE capture_fields = (TRY (mIREmitter__emit_context_field_decls(&rtoc_self_view, plan.capture_fields))).replace("\n", "\n      ");
    MUTABLE capture_inits = TRY (mIREmitter__emit_struct_init_fields(&rtoc_self_view, plan.capture_inits));
    MUTABLE spawn_call = (TRY (mIREmitter__emit_fiber_spawn_call(rtoc_self_view, plan.spawn_call))).replace("\n", "\n    ");
    MUTABLE rt_suppress: String = "";
    IF body_code.contains?("__rt") THEN
      rt_suppress = "";
    ELSE
      rt_suppress = "_ = &__rt;";
    END
    RETURN "const ${plan.ctx_type} = struct {\n    wg: *CheatHeader.WaitGroup,\n    ${capture_fields}\n    fn run(${plan.raw_rt_name}: *anyopaque, ${plan.raw_args_name}: ?*anyopaque) anyerror!void {\n        const __rt = @as(*Runtime, @ptrCast(@alignCast(${plan.raw_rt_name})));\n        ${rt_suppress}\n        const ctx = @as(*@This(), @ptrCast(@alignCast(${plan.raw_args_name}.?)));\n        defer ctx.wg.done();\n        ${body_code}\n    }\n};\n${capture_pre_decls}\nvar ${plan.ctx_var} = ${plan.ctx_type}{ ${capture_inits} };\n${spawn_call}\n${plan.wg_var}.add(1);\n".trim();
}
END
FN mIREmitter__emit_context_field_decls(MUTABLE self: MIREmitter, fields: []ContextFieldDecl) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN (fields |> SELECT {
    MUTABLE default: String = "";
      IF _.default_value EXISTS AS default_value_value THEN
        default = " = ${TRY (mIREmitter__emit(&rtoc_self_view, default_value_value))}";
      ELSE
        default = "";
      END
    "${_.name}: ${_.type_zig}${default},"
    }).join("\n");
}
END
FN mIREmitter__emit_struct_init_fields(MUTABLE self: MIREmitter, fields: []StructInitField) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN (fields |> SELECT ".${mIREmitter__zig_field_name(rtoc_self_view, Name{ SymbolValue: COPY _.name })} = ${TRY (mIREmitter__emit_struct_init_field_value(&rtoc_self_view, _.value))}").join(", ");
}
END
FN mIREmitter__emit_capture_cleanup_actions(MUTABLE self: MIREmitter, actions: []CaptureCleanupAction) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN (actions |> SELECT {
    MUTABLE allocator: ?String = NIL;
      IF _.allocator EXISTS THEN
        allocator = TRY (mIREmitter__emit(&rtoc_self_view, (_.allocator)?));
      END
    "defer ${TRY (mIREmitter__emit_direct_cleanup(rtoc_self_view, TRY (mIREmitter__emit(&rtoc_self_view, _.target)), KEEP _.cleanup_entry, allocator))}"
    }).join("\n");
}
END
PUB FN mIREmitter__emit_profile_task_site(self: MIREmitter, site: ProfileTaskSite) RETURNS String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN "// CLEAR_PROFILE_TASK_SITE id=${site.site_id.toString()} kind=BG line=${site.line.toString()} column=${site.column.toString()} dispatch=${site.dispatch} form=${site.form}";
}
END
FN mIREmitter__emit_task_config_plan(self: MIREmitter, plan: TaskConfigPlan) RETURNS String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fields = [".stack_size = .${plan.stack_variant}"];
    IF plan.profile_site_id EXISTS AS profile_site_id_value THEN
      &fields.append(".profile_site_id = ${profile_site_id_value.toString()}");
    END
    IF plan.profile_dispatch_id EXISTS AS profile_dispatch_id_value THEN
      &fields.append(".profile_dispatch = ${profile_dispatch_id_value.toString()}");
    END
    RETURN ".{ ${fields.join(", ")} }";
}
END
FN mIREmitter__emit_fiber_spawn_call(self: MIREmitter, call: FiberSpawnCall) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE callee: String = "";
    IF (call.target == :runtime_submit) THEN
      MUTABLE runtime_name = (call.runtime_name OR_ELSE CAST(panic("FiberSpawnCall runtime_name required") AS String));
      callee = "try ${runtime_name}.getSched().submitSpawn";
    ELSE_IF (call.target == :pinned) THEN
      callee = "try CheatHeader.spawnPinned";
    ELSE_IF (call.target == :best) THEN
      callee = "try CheatHeader.spawnBest";
    ELSE_IF (call.target == :wait_group_submit) THEN
      MUTABLE wait_group_name = (call.wait_group_name OR_ELSE CAST(panic("FiberSpawnCall wait_group_name required") AS String));
      callee = "try ${wait_group_name}.sched.submitSpawn";
    ELSE
      panic("unknown FiberSpawnCall target {}");
    END
    MUTABLE task_cfg = mIREmitter__emit_task_config_plan(rtoc_self_view, call.task_config);
    MUTABLE ctx_arg: String = "";
    IF call.pass_ctx_by_address THEN
      ctx_arg = "&${call.ctx_var}";
    ELSE
      ctx_arg = COPY call.ctx_var;
    END
    RETURN "${callee}(\n    @intFromPtr(&Runtime.entryWrapper),\n    @as(CheatHeader.TaskFn, @ptrCast(&${call.ctx_type}.run)),\n    ${ctx_arg},\n    ${task_cfg}\n);\n".trim();
}
END
FN mIREmitter__emit_inline_bc_as_zig(MUTABLE self: MIREmitter, node: InlineBc) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE entry = node.stdlib_def;
    IF !(entry) THEN
      panic("emit_inline_bc_as_zig: node has no stdlib_def (:{})");
    END
    MUTABLE pattern = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_3 = CAST(entry AS FunctionSignature);
    TRY (functionSignature__required_intrinsic_template(rtoc_mutable_receiver_3, IntrinsicTemplateKind.Zig)) };
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < node.args.length() DO
    pattern = pattern.split("{${rtoc_idx.toString()}}").join(TRY (mIREmitter__emit(&rtoc_self_view, node.args[rtoc_idx]?)));
    rtoc_idx = rtoc_idx + 1;
    END
    IF node.suppress_try THEN
      RETURN rtoc_delete_prefix__mir_emitter(pattern, "try ");
    ELSE
      RETURN pattern;
    END
}
END
FN mIREmitter__emit_sharded_map_put(MUTABLE self: MIREmitter, node: ShardedMapPut) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE pattern = COPY (TRY (mIREmitter__sharded_map_template(rtoc_self_view, MIREmitterShardedMapNode{ ShardedMapPut: COPY node })));
    pattern = (pattern.replace("{target}", TRY (mIREmitter__emit(&rtoc_self_view, node.target)))).replace("&{target}", "&${TRY (mIREmitter__emit(&rtoc_self_view, node.target))}").replace("{index}", TRY (mIREmitter__emit(&rtoc_self_view, node.key))).replace("{value}", TRY (mIREmitter__emit(&rtoc_self_view, node.value)));
    RETURN TRY (mIREmitter__sharded_map_substitute_common(&rtoc_self_view, pattern, MIREmitterShardedMapNode{ ShardedMapPut: COPY node }));
}
END
FN mIREmitter__emit_sharded_map_get(MUTABLE self: MIREmitter, node: ShardedMapGet) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE pattern = COPY (TRY (mIREmitter__sharded_map_template(rtoc_self_view, MIREmitterShardedMapNode{ ShardedMapGet: COPY node })));
    pattern = (pattern.replace("{target}", TRY (mIREmitter__emit(&rtoc_self_view, node.target)))).replace("{index}", TRY (mIREmitter__emit(&rtoc_self_view, node.key)));
    RETURN TRY (mIREmitter__sharded_map_substitute_common(&rtoc_self_view, pattern, MIREmitterShardedMapNode{ ShardedMapGet: COPY node }));
}
END
FN mIREmitter__emit_protocol_call(MUTABLE self: MIREmitter, node: ProtocolCall) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !((node.protocol == :Map)) THEN
      panic("unsupported protocol call {}.{}");
    END
    MUTABLE receiver: String = TRY (mIREmitter__emit(&rtoc_self_view, node.receiver));
    MUTABLE arguments: []String = node.args |> SELECT TRY (mIREmitter__emit(&rtoc_self_view, _));
    IF (node.operation == :get) THEN
      RETURN "CheatLib.mapProtocolGet(${receiver}, ${UNWRAP (arguments[0])})";
    ELSE_IF (node.operation == :put) THEN
      RETURN "try CheatLib.mapProtocolPut(${receiver}, ${UNWRAP (arguments[2])}, ${UNWRAP (arguments[3])}, ${UNWRAP (arguments[0])}, ${UNWRAP (arguments[1])})";
    ELSE_IF (node.operation == :delete) THEN
      RETURN "CheatLib.mapProtocolDelete(${receiver}, ${UNWRAP (arguments[1])}, ${UNWRAP (arguments[0])})";
    ELSE_IF (node.operation == :contains) THEN
      RETURN "CheatLib.mapProtocolContains(${receiver}, ${UNWRAP (arguments[0])})";
    ELSE_IF (node.operation == :count) THEN
      RETURN "CheatLib.mapProtocolCount(${receiver})";
    ELSE_IF (node.operation == :empty) THEN
      RETURN "(CheatLib.mapProtocolCount(${receiver}) == 0)";
    ELSE_IF (node.operation == :any) THEN
      RETURN "(CheatLib.mapProtocolCount(${receiver}) > 0)";
    ELSE
      panic("unsupported Map protocol operation {}");
    END
}
END
FN mIREmitter__emit_protocol_adapter_def(self: MIREmitter, node: ProtocolAdapterDef) RETURNS String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE facts_name = "__clearProtocolFacts_${node.protocol}";
    MUTABLE facts_cases: []String = List[];
    FOR conformance IN node.conformances DO
      MUTABLE field_decls: []String = List[];
      FOR assoc_name IN node.associated_types DO
        MUTABLE value: String = COPY UNWRAP (conformance.associated_types[assoc_name]);
        &field_decls.append("pub const ${assoc_name} = ${value};");
      END
      MUTABLE fields: String = field_decls.join(" ");
      &facts_cases.append(mIREmitter__protocol_conformance_branch(rtoc_self_view, conformance, %(bindings: String) USE(fields) -> "${bindings}return struct { ${fields} };"));
    END
    MUTABLE facts_body = ((facts_cases + ["@compileError(\"No ${node.protocol} conformance for \" ++ @typeName(T));"])).join("\n    ");
    MUTABLE facts = "fn ${facts_name}(comptime T: type) type {\n    ${facts_body}\n}";
    MUTABLE operations: []String = List[];
    FOR requirement IN node.requirements DO
      MUTABLE params: []String = List[];
      MUTABLE arg_names: []String = List[];
      MUTABLE arg_index = 1;
      WHILE arg_index < requirement.argument_count DO
        &params.append("arg${arg_index.toString()}: anytype");
        &arg_names.append("arg${arg_index.toString()}");
        arg_index = arg_index + 1;
      END
      MUTABLE all_params: []String = (["comptime T: type", "rt: *Runtime", "self: anytype"] + params);
      MUTABLE branches: []String = List[];
      FOR conformance IN node.conformances DO
        IF conformance.operations[requirement.name] EXISTS AS target THEN
          MUTABLE call_args: []String = ((COPY conformance.type_params + ["rt", "self"]) + arg_names);
          &branches.append(mIREmitter__protocol_conformance_branch(rtoc_self_view, conformance, %(bindings: String) USE(target, call_args) -> "${bindings}return ${target}(${call_args.join(", ")});"));
        END
      END
      MUTABLE suppressions: []String = List[];
      IF (branches.length() == 0) THEN
        suppressions = (["rt", "self"] + arg_names) |> SELECT "_ = ${_};";
      END
      MUTABLE body: String = (((suppressions + branches) + ["@compileError(\"No ${node.protocol}.${requirement.name} conformance for \" ++ @typeName(T));"])).join("\n    ");
      &operations.append("fn __clearProtocol_${node.protocol}_${mIREmitter__protocol_zig_name(rtoc_self_view, requirement.name)}(${all_params.join(", ")}) ${requirement.return_type} {\n    ${body}\n}");
    END
    RETURN (([facts] + operations)).join("\n\n");
}
END
FN mIREmitter__protocol_conformance_branch(self: MIREmitter, conformance: ProtocolConformanceCase, block: FN(String) -> String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF conformance.owner_type EXISTS AS owner_type_value THEN
      RETURN "if (T == ${owner_type_value}) { ${block("")} }";
    END
    MUTABLE marker = COPY UNWRAP (conformance.owner_marker);
    MUTABLE binding_parts: []String = List[];
    MUTABLE type_param_names: []String = COPY conformance.type_params;
    MUTABLE binding_index = 0;
    WHILE binding_index < type_param_names.length() DO
      MUTABLE type_param: String = COPY UNWRAP (type_param_names[binding_index]);
      &binding_parts.append("const ${type_param} = T.__clear_type_args[${binding_index.toString()}]; ");
      binding_index = binding_index + 1;
    END
    MUTABLE bindings: String = binding_parts.join("");
    RETURN "if (comptime @typeInfo(T) == .@\"struct\" and @hasDecl(T, \"${marker}\")) { ${block(bindings)} }";
}
END
FN mIREmitter__protocol_zig_name(self: MIREmitter, name: String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (name.endsWith?("!") OR name.endsWith?("?")) THEN
      RETURN COPY name.substr(0, ((name.length() - 1) - 0));
    ELSE
      RETURN COPY name;
    END
}
END
FN mIREmitter__sharded_map_template(self: MIREmitter, node: MIREmitterShardedMapNode) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE op: ?FunctionSignature@multiowned = KEEP mIREmitter__sharded_map_stdlib_def(node);
    MUTABLE kind = mIREmitter__sharded_map_template_kind(node);
    MUTABLE op_value: FunctionSignature = COPY UNWRAP (op);
    IF (TRY (functionSignature__intrinsic_template(op_value, kind))) EXISTS AS template THEN
      PARTIAL MATCH template START
        FunctionSignatureReturnValue.StringValue AS text -> RETURN COPY text;,
        FunctionSignatureReturnValue.SymbolValue AS sym -> RETURN CAST(sym AS String);
      END
    END
    panic("ShardedMap: op has no :{} template (contract={})");
}
END
FN mIREmitter__sharded_map_substitute_common(MUTABLE self: MIREmitter, pattern_input: String, node: MIREmitterShardedMapNode) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE pattern = COPY pattern_input;
    IF mIREmitterShardedMapNode__shard_idx(node) THEN
      pattern = (pattern.replace("{shard_idx}", TRY (mIREmitter__emit(&rtoc_self_view, mIREmitterShardedMapNode__shard_idx(node))))).replace("{shard_key}", TRY (mIREmitter__emit(&rtoc_self_view, mIREmitterShardedMapNode__shard_key(node))));
    END
    MUTABLE key_type: ?Type = mIREmitter__sharded_map_key_type(node);
    IF key_type EXISTS AS key_type_value THEN
      pattern = pattern.replace("{key_zig}", TRY (type__zig_type(key_type_value)));
    END
    MUTABLE value_type: ?Type = mIREmitter__sharded_map_value_type(node);
    IF value_type EXISTS AS value_type_value THEN
      pattern = pattern.replace("{val_zig}", TRY (type__zig_type(value_type_value)));
    END
    MUTABLE rtoc_local_receiver_7 = mIREmitter__sharded_map_resolved_allocs(node);
    inlineAllocMetadata__each(rtoc_local_receiver_7, %(alloc_key: String@symbol, sym: String@symbol) USE(MUTABLE pattern, rtoc_self_view) -> {
    pattern = pattern.replace("{${alloc_key}}", TRY (mIREmitter__alloc_zig(rtoc_self_view, sym)));
    rubyToClearVoid__mir_emitter()
    });
    RETURN COPY pattern;
}
END
PRIVATE FN mIREmitter__emit_registry_call(MUTABLE self: MIREmitter, node: RegistryCall) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE code = TRY (mIREmitter__registry_template(rtoc_self_view, KEEP node.entry, IntrinsicTemplateKind.Zig));
    code = TRY (mIREmitter__substitute_registry_common(rtoc_self_view, code, KEEP node.entry, KEEP node.allocs, node.key_type, node.value_type));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < node.args.length() DO
      MUTABLE rendered = TRY (mIREmitter__coerce_registry_arg(rtoc_self_view, TRY (mIREmitter__emit(&rtoc_self_view, node.args[rtoc_idx]?.expr)), node.args[rtoc_idx]?.coerce_type));
      code = code.replace("&{${rtoc_idx.toString()}}", "&${rendered}");
      code = code.replace("{${rtoc_idx.toString()}}", rendered);
    rtoc_idx = rtoc_idx + 1;
    END
    IF node.suppress_try THEN
      RETURN code.deletePrefix("try ");
    ELSE
      RETURN code;
    END
}
END
PRIVATE FN mIREmitter__emit_indexed_store(MUTABLE self: MIREmitter, node: IndexedStore) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE code = TRY (mIREmitter__registry_template(rtoc_self_view, KEEP node.entry, node.template_kind));
    code = TRY (mIREmitter__substitute_registry_common(rtoc_self_view, code, KEEP node.entry, KEEP node.allocs, node.key_type, node.value_type));
    MUTABLE target = TRY (mIREmitter__emit(&rtoc_self_view, node.target));
    MUTABLE index = TRY (mIREmitter__emit(&rtoc_self_view, node.index));
    MUTABLE value = TRY (mIREmitter__emit(&rtoc_self_view, node.value));
    RETURN code.replace("&{target}", "&${target}").replace("{target}", target).replace("{index}", index).replace("{value}", value);
}
END
PRIVATE FN mIREmitter__registry_template(self: MIREmitter, entry: FunctionSignature, template_kind: IntrinsicTemplateKind) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (functionSignature__required_intrinsic_template(entry, template_kind));
}
END
PRIVATE FN mIREmitter__substitute_registry_common(self: MIREmitter, code: String, entry: FunctionSignature, allocs: ?InlineAllocMetadata, key_type: ?Type, value_type: ?Type) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE out = code.replace("{rt}", rtoc_self_view.rt_name);
    IF key_type EXISTS AS key_type_value THEN
      out = out.replace("{key_zig}", TRY (type__zig_type(key_type_value)));
    END
    IF value_type EXISTS AS value_type_value THEN
      out = out.replace("{val_zig}", TRY (type__zig_type(value_type_value)));
    END
    IF allocs != NIL THEN
        inlineAllocMetadata__each(allocs, %(key: String@symbol, sym: String@symbol) USE(MUTABLE out, rtoc_self_view) -> {
        out = out.replace("{${key}}", TRY (mIREmitter__alloc_zig(rtoc_self_view, sym)));
        rubyToClearVoid__mir_emitter()
        });
    END
    RETURN out;
}
END
PRIVATE FN mIREmitter__coerce_registry_arg(self: MIREmitter, rendered_arg: String, coerce_type: ?String@symbol) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF coerce_type EXISTS AS coerce_type_value THEN
      MUTABLE coercible = [:Int64, :Float64, :Int32, :Int16, :Int8, :UInt64, :UInt32, :UInt16, :UInt8, :Bool];
      IF !(coercible.contains?(coerce_type_value)) THEN
        RETURN COPY rendered_arg;
      END
      RETURN COPY "@as(${TRY (type__zig_type((TRY (type__new(TypeConstructionInput{ SymbolValue: COPY coerce_type_value })))))}, ${rendered_arg})";
    ELSE
      RETURN COPY rendered_arg;
    END
}
END
PRIVATE FN mIREmitter__emit_extern_trampoline(MUTABLE self: MIREmitter, node: ExternTrampoline) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE payload_t_branch_value: ?Type = NIL;
    IF type__error_union?(node.return_type) THEN
      payload_t_branch_value = UNWRAP (TRY (type__payload_type(node.return_type)));
    ELSE
      payload_t_branch_value = COPY node.return_type;
    END
    MUTABLE payload_t: Type = payload_t_branch_value?;
    MUTABLE returns_void = type__void?(payload_t);
    MUTABLE can_fail = type__error_union?(node.return_type);
    MUTABLE prefix: String = "";
    IF node.method_name EXISTS AS method_name_value THEN
      prefix = "__ExtM";
    ELSE
      prefix = "__Ext";
    END
    MUTABLE args_tuple_name: String = "";
    IF node.method_name EXISTS AS method_name_value THEN
      args_tuple_name = "__extm${node.id.toString()}_args";
    ELSE
      args_tuple_name = "__ext${node.id.toString()}_args";
    END
    MUTABLE frame_name: String = "";
    IF node.method_name EXISTS AS method_name_value THEN
      frame_name = "__extm${node.id.toString()}_frame";
    ELSE
      frame_name = "__ext${node.id.toString()}_frame";
    END
    MUTABLE runtime_arg_codes = node.runtime_args |> SELECT TRY (mIREmitter__emit(&rtoc_self_view, _.expr));
    MUTABLE comptime_codes = node.comptime_args |> SELECT TRY (mIREmitter__emit(&rtoc_self_view, _));
    MUTABLE arg_tuple: String = "";
    IF (runtime_arg_codes.length() == 0) THEN
      arg_tuple = ".{}";
    ELSE
      arg_tuple = ".{ ${runtime_arg_codes.join(", ")} }";
    END
    MUTABLE receiver_code: ?String = NIL;
    IF node.receiver EXISTS THEN
      receiver_code = TRY (mIREmitter__emit(&rtoc_self_view, (node.receiver)?));
    END
    MUTABLE fields: []String = ( { MUTABLE rtoc_empty_list_8: []String = List[]; rtoc_empty_list_8 } );
    IF receiver_code EXISTS AS receiver_code_value THEN
      &fields.append("self_val: @TypeOf(${receiver_code_value})");
    END
    IF node.alloc_kind EXISTS AS alloc_kind_value THEN
      &fields.append("alloc: std.mem.Allocator");
    END
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < node.runtime_args.length() DO
      MUTABLE runtime_arg = COPY UNWRAP (node.runtime_args[rtoc_idx]);
      MUTABLE field_type: ?String = COPY runtime_arg.field_zig_type;
      IF !(field_type EXISTS) THEN
        IF runtime_arg.field_type EXISTS AS arg_field_type THEN
          field_type = TRY (type__zig_type(arg_field_type, TRUE));
        END
      END
      &fields.append("a${rtoc_idx.toString()}: ${(field_type OR_ELSE "@TypeOf(${args_tuple_name}[${rtoc_idx.toString()}])")}");
    rtoc_idx = rtoc_idx + 1;
    END
    IF can_fail THEN
      &fields.append("err: ?anyerror = null");
    END
    IF !(returns_void) THEN
      &fields.append("ret: ${TRY (type__zig_type(payload_t))} = undefined");
    END
    MUTABLE call_zig = mIREmitter__extern_trampoline_call(rtoc_self_view, node, comptime_codes, runtime_arg_codes.length());
    MUTABLE call_stmt: String = "";
    IF can_fail THEN
      IF returns_void THEN
        call_stmt = "${call_zig} catch |err| { f.err = err; return; };";
      ELSE
        call_stmt = "f.ret = (${call_zig} catch |err| { f.err = err; return; });";
      END
    ELSE
      IF returns_void THEN
        call_stmt = "${call_zig};";
      ELSE
        call_stmt = "f.ret = ${call_zig};";
      END
    END
    MUTABLE init_fields: []String = ( { MUTABLE rtoc_empty_list_9: []String = List[]; rtoc_empty_list_9 } );
    IF receiver_code EXISTS AS receiver_code_value THEN
      &init_fields.append(".self_val = ${receiver_code_value}");
    END
    MUTABLE arg_index = 0;
    WHILE arg_index < runtime_arg_codes.length() DO
      &init_fields.append(".a${arg_index.toString()} = ${args_tuple_name}[${arg_index.toString()}]");
      arg_index = arg_index + 1;
    END
    MUTABLE alloc_kind: ?String@symbol = COPY node.alloc_kind;
    IF alloc_kind EXISTS AS alloc_kind_value THEN
      MUTABLE alloc_expr = TRY (mIREmitter__alloc_zig(rtoc_self_view, alloc_kind_value));
      &init_fields.append(".alloc = ${alloc_expr}");
    END
    MUTABLE f_needed = ((((receiver_code EXISTS) OR (node.alloc_kind EXISTS)) OR (runtime_arg_codes.length() > 0)) OR (!(returns_void) OR can_fail));
    MUTABLE f_binding: String = "";
    IF f_needed THEN
      f_binding = "const f: *@This() = @ptrCast(@alignCast(ptr));";
    ELSE
      f_binding = "_ = ptr;";
    END
    MUTABLE label = "blk_ext${node.id.toString()}";
    MUTABLE code: String = "";
    IF returns_void THEN
      code = "{ ";
    ELSE
      code = "${label}: { ";
    END
    IF node.runtime_args |> ANY _.expr IS_A CFunctionAdapter THEN
      code = (code $+ "const __previous_c_callback_rt = __clear_c_callback_rt; __clear_c_callback_rt = ${rtoc_self_view.rt_name}; defer __clear_c_callback_rt = __previous_c_callback_rt; ");
    END
    IF (runtime_arg_codes.length() > 0) THEN
      code = (code $+ "const ${args_tuple_name} = ${arg_tuple}; ");
    END
    MUTABLE field_decls: String = "";
    IF (fields.length() == 0) THEN
      field_decls = "";
    ELSE
      field_decls = "${fields.join(", ")}, ";
    END
    code = (code $+ "const ${prefix}${node.id.toString()} = struct { ${field_decls}fn run(ptr: ?*anyopaque) callconv(.c) void { ${f_binding} ${call_stmt} } }; ");
    code = (code $+ "var ${frame_name} = ${prefix}${node.id.toString()}{ ${init_fields.join(", ")} }; ");
    code = (code $+ "${rtoc_self_view.rt_name}.onRootStack(@as(*const fn (?*anyopaque) callconv(.c) void, &${prefix}${node.id.toString()}.run), @ptrCast(&${frame_name})); ");
    IF can_fail THEN
      code = (code $+ "if (${frame_name}.err) |e| return e; ");
    END
    IF !(returns_void) THEN
      code = (code $+ "break :${label} ${frame_name}.ret; ");
    END
    RETURN (code $+ "}");
}
END
PRIVATE FN mIREmitter__emit_c_function_adapter(MUTABLE self: MIREmitter, node: CFunctionAdapter) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.uses_c_callback = TRUE;
    MUTABLE params = {
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE rtoc_indexed_items_10: []FunctionTypeParam = node.signature.params;
    MUTABLE rtoc_indexed_output_12 = [];
    MUTABLE rtoc_indexed_i_11 = 0;
    WHILE rtoc_indexed_i_11 < rtoc_indexed_items_10.length() DO
      &rtoc_indexed_output_12.append("a${rtoc_indexed_i_11.toString()}: ${TRY (type__zig_type(UNWRAP (rtoc_indexed_items_10[rtoc_indexed_i_11]).type, TRUE))}");
      rtoc_indexed_i_11 = rtoc_indexed_i_11 + 1;
    END
    rtoc_indexed_output_12
    };
    MUTABLE args: []String = List[];
    MUTABLE param_index = 0;
    WHILE param_index < node.signature.params.length() DO
      &args.append("a${param_index.toString()}");
      param_index = param_index + 1;
    END
    MUTABLE clear_function = (TRY (mIREmitter__emit(&rtoc_self_view, node.clear_function))).deletePrefix("&");
    MUTABLE clear_call = "${clear_function}(__clear_c_callback_rt orelse @panic(\"C callback escaped its synchronous CLEAR call\")${IF (args.length() == 0) THEN
      ""
    ELSE
      ", ${args.join(", ")}"
    END})";
    MUTABLE return_type = COPY node.signature.return_type;
    MUTABLE body: String = "";
    IF type__void?(return_type) THEN
      body = "${clear_call} catch @panic(\"CLEAR error crossed a C callback\");";
    ELSE
      body = "return ${clear_call} catch @panic(\"CLEAR error crossed a C callback\");";
    END
    RETURN "&struct { fn run(${params.join(", ")}) callconv(.c) ${TRY (type__zig_type(return_type))} { ${body} } }.run";
}
END
PRIVATE FN mIREmitter__extern_trampoline_call(self: MIREmitter, node: ExternTrampoline, comptime_codes: []String, runtime_arg_count: Int64) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node.method_name EXISTS AS method_name_value THEN
      MUTABLE args = List[];
      IF node.alloc_kind EXISTS AS alloc_kind_value THEN
        &args.append("f.alloc");
      END
      FOR rtoc_counter_a IN (0_i64 ..< runtime_arg_count) DO
        &args.append("f.a${rtoc_counter_a.toString()}");
      END
      RETURN "f.self_val.${method_name_value}(${args.join(", ")})";
    END
    MUTABLE mod_prefix: String = "";
    IF node.module_alias EXISTS AS module_alias_value THEN
      mod_prefix = "${module_alias_value.replace(".", "_")}.";
    ELSE
      mod_prefix = "";
    END
    MUTABLE parts = COPY comptime_codes;
    IF node.alloc_kind EXISTS AS alloc_kind_value THEN
      &parts.append("f.alloc");
    END
    FOR rtoc_counter_p IN (0_i64 ..< runtime_arg_count) DO
      &parts.append("f.a${rtoc_counter_p.toString()}");
    END
    RETURN "${mod_prefix}${node.callee_name}(${parts.join(", ")})";
}
END
PRIVATE FN mIREmitter__emit_observable_consumer_spawn(MUTABLE self: MIREmitter, node: ObservableConsumerSpawn) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE ctx_type = "__ObsConsumerCtx${node.id.toString()}";
    MUTABLE fiber_rt = "__rt_obs_${node.id.toString()}";
    MUTABLE body = TRY (mIREmitter__emit_body_with_runtime(&rtoc_self_view, node.body, fiber_rt));
    body = mIREmitter__replace_emit_identifier(rtoc_self_view, mIREmitter__replace_emit_identifier(rtoc_self_view, body, node.acc_name, "ctx.acc"), node.source_name, "ctx.gen");
    MUTABLE rt_name = COPY node.runtime_name;
    RETURN ("const ${ctx_type} = struct {\n        acc: ${TRY (type__zig_type(node.acc_type))},\n        gen: @TypeOf(${node.source_name}),\n        fn run(__raw_rt_obs_${node.id.toString()}: *anyopaque, __raw_args_obs_${node.id.toString()}: ?*anyopaque) anyerror!void {\n            const ${fiber_rt} = @as(*Runtime, @ptrCast(@alignCast(__raw_rt_obs_${node.id.toString()})));\n            ${IF body.contains?(fiber_rt) THEN
      ""
    ELSE
      "_ = &${fiber_rt};"
    END}\n            const ctx = @as(*@This(), @ptrCast(@alignCast(__raw_args_obs_${node.id.toString()}.?)));\n            defer ctx.acc.finish;\n            ${body}\n        }\n    };\n    try CheatHeader.spawnObservableConsumerCtx(\n        ${ctx_type},\n        ${rt_name},\n        .{ .acc = ${node.acc_name}, .gen = ${node.source_name} },\n        @as(CheatHeader.TaskFn, @ptrCast(&${ctx_type}.run)),\n        .{ .stack_size = .${node.task_config_variant} }\n    )\n").trim();
}
END
PRIVATE FN mIREmitter__emit_shard_concurrent_each(MUTABLE self: MIREmitter, node: ShardConcurrentEach) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE id = node.id;
    MUTABLE idx_var = "__sh${id.toString()}_i";
    MUTABLE key_var = "__sh${id.toString()}_key";
    MUTABLE sh_var = "__sh${id.toString()}_sh";
    MUTABLE map_ptr = "__sh${id.toString()}_map";
    MUTABLE key_zig = TRY (type__zig_type(node.key_type));
    MUTABLE shard_count = node.shard_count;
    MUTABLE string_key = !(TRY (type__numeric_map?(node.map_type)));
    MUTABLE body_zig = TRY (mIREmitter__emit_body_with_runtime(&rtoc_self_view, node.body, "__rt"));
    MUTABLE worker_body: String = "";
    IF body_zig.contains?("__rt") THEN
      worker_body = body_zig;
    ELSE
      worker_body = "_ = &__rt;\n${body_zig}";
    END
    MUTABLE producer_key_body = TRY (mIREmitter__emit_body(&rtoc_self_view, node.producer_key_body));
    MUTABLE capture_setup = TRY (mIREmitter__emit_body(&rtoc_self_view, node.capture_setup));
    MUTABLE capture_fields = TRY (mIREmitter__emit_shard_worker_capture_fields(&rtoc_self_view, node, map_ptr));
    MUTABLE capture_inits = TRY (mIREmitter__emit_shard_worker_capture_inits(&rtoc_self_view, node, map_ptr));
    MUTABLE key_loop_mark: String = "";
    IF node.key_allocates_frame THEN
      key_loop_mark = "const __sh${id.toString()}_key_mark = rt.saveLoopMark();\ndefer rt.restoreLoopMark(__sh${id.toString()}_key_mark);";
    ELSE
      key_loop_mark = "";
    END
    MUTABLE body_loop_mark: String = "";
    IF node.body_allocates_frame THEN
      body_loop_mark = "const __sh${id.toString()}_body_mark = __rt.saveLoopMark();\ndefer __rt.restoreLoopMark(__sh${id.toString()}_body_mark);";
    ELSE
      body_loop_mark = "";
    END
    MUTABLE key_store_expr: String = "";
    IF string_key THEN
      key_store_expr = "try rt.heapAlloc().dupe(u8, ${key_var})";
    ELSE
      key_store_expr = COPY key_var;
    END
    MUTABLE key_free_work = mIREmitter__shard_key_free_work(rtoc_self_view, id, string_key);
    MUTABLE key_free_success: String = "";
    IF string_key THEN
      key_free_success = "__rt.heapAlloc().free(${key_var});";
    ELSE
      key_free_success = "";
    END
    MUTABLE key_free_remaining: String = "";
    IF string_key THEN
      key_free_remaining = "errdefer for (__work.keys[__sh${id.toString()}_ki..]) |__k| __rt.heapAlloc().free(__k);";
    ELSE
      key_free_remaining = "";
    END
    MUTABLE key_slice_cleanup: String = "";
    IF string_key THEN
      key_slice_cleanup = "for (__sh${id.toString()}_keys) |__k| rt.heapAlloc().free(__k);";
    ELSE
      key_slice_cleanup = "";
    END
    MUTABLE pending_batch_cleanup: String = "";
    IF string_key THEN
      pending_batch_cleanup = "for (__sh${id.toString()}_batches[__s].items) |__k| rt.heapAlloc().free(__k);";
    ELSE
      pending_batch_cleanup = "";
    END
    MUTABLE op_str: String = "";
    IF node.inclusive THEN
      op_str = "<=";
    ELSE
      op_str = "<";
    END
    RETURN "{\n    const ${map_ptr} = &${TRY (mIREmitter__emit(&rtoc_self_view, node.map_expr))};\n    ${map_ptr}.ensureOwnership();\n    const __sh${id.toString()}_cap: usize = ${TRY (mIREmitter__emit(&rtoc_self_view, node.capacity_expr))};\n    const __sh${id.toString()}_batch: usize = @max(@as(usize, ${TRY (mIREmitter__emit(&rtoc_self_view, node.batch_size_expr))}), 1);\n    const __ShWork${id.toString()} = struct {\n        keys: []${key_zig},\n    };\n    const __ShCleanup${id.toString()} = struct {\n${mIREmitter__indent_block(rtoc_self_view, mIREmitter__emit_shard_cleanup_buffered(rtoc_self_view, id, string_key), 12)}\n    };\n    var __sh${id.toString()}_chans: [${shard_count.toString()}]CheatLib.BoundedChannel(__ShWork${id.toString()}) = undefined;\n    for (0..${shard_count.toString()}) |__s| {\n        __sh${id.toString()}_chans[__s] = try CheatLib.BoundedChannel(__ShWork${id.toString()}).init(rt.heapAlloc(), __sh${id.toString()}_cap);\n    }\n    defer for (0..${shard_count.toString()}) |__s| __sh${id.toString()}_chans[__s].deinit();\n${mIREmitter__indent_block(rtoc_self_view, capture_setup, 4)}\n    var __sh${id.toString()}_wg = CheatHeader.WaitGroup.init(rt.getSched());\n    var __sh${id.toString()}_err = std.atomic.Value(bool).init(false);\n    const __ShWorker${id.toString()} = struct {\n        wg: *CheatHeader.WaitGroup,\n        chans: *[${shard_count.toString()}]CheatLib.BoundedChannel(__ShWork${id.toString()}),\n        err: *std.atomic.Value(bool),\n        shard: usize,\n${mIREmitter__indent_block(rtoc_self_view, capture_fields, 8)}\n        fn run(raw_rt: *anyopaque, raw_args: ?*anyopaque) anyerror!void {\n            const __rt = @as(*Runtime, @ptrCast(@alignCast(raw_rt)));\n            const ctx = @as(*@This(), @ptrCast(@alignCast(raw_args.?)));\n            defer ctx.wg.done();\n            errdefer {\n                ctx.err.store(true, .release);\n                for (0..${shard_count.toString()}) |__s| ctx.chans[__s].setError(error.CheatError);\n            }\n            while (ctx.chans[ctx.shard].pop() catch |__err| {\n                ctx.err.store(true, .release);\n                for (0..${shard_count.toString()}) |__s| ctx.chans[__s].setError(__err);\n                return __err;\n            }) |__work| {\n                errdefer {\n${mIREmitter__indent_block(rtoc_self_view, key_free_work, 24)}\n                }\n                var __sh${id.toString()}_ki: usize = 0;\n                while (__sh${id.toString()}_ki < __work.keys.len) : (__sh${id.toString()}_ki += 1) {\n${mIREmitter__indent_block(rtoc_self_view, key_free_remaining, 24)}\n                    const ${key_var}: ${key_zig} = __work.keys[__sh${id.toString()}_ki];\n${mIREmitter__indent_block(rtoc_self_view, body_loop_mark, 24)}\n${mIREmitter__indent_block(rtoc_self_view, worker_body, 24)}\n${mIREmitter__indent_block(rtoc_self_view, key_free_success, 24)}\n                }\n                __rt.heapAlloc().free(__work.keys);\n                __rt.checkYield();\n            }\n        }\n    };\n    var __sh${id.toString()}_workers: [${shard_count.toString()}]__ShWorker${id.toString()} = undefined;\n    __sh${id.toString()}_wg.add(${shard_count.toString()});\n    for (0..${shard_count.toString()}) |__s| {\n        __sh${id.toString()}_workers[__s] = .{ .wg = &__sh${id.toString()}_wg, .chans = &__sh${id.toString()}_chans, .err = &__sh${id.toString()}_err, .shard = __s${capture_inits} };\n        try CheatHeader.spawnBest(\n            @intFromPtr(&Runtime.entryWrapper),\n            @as(CheatHeader.TaskFn, @ptrCast(&__ShWorker${id.toString()}.run)),\n            &__sh${id.toString()}_workers[__s],\n            .{ .stack_size = .${node.task_config_variant} },\n        );\n    }\n\n    var __sh${id.toString()}_batches: [${shard_count.toString()}]std.ArrayListUnmanaged(${key_zig}) = [_]std.ArrayListUnmanaged(${key_zig}){.empty} ** ${shard_count.toString()};\n    defer for (0..${shard_count.toString()}) |__s| {\n${mIREmitter__indent_block(rtoc_self_view, pending_batch_cleanup, 12)}\n        __sh${id.toString()}_batches[__s].deinit(rt.heapAlloc());\n    };\n\n    var ${idx_var}: i64 = ${TRY (mIREmitter__emit(&rtoc_self_view, node.start_expr))};\n    const __sh${id.toString()}_end: i64 = ${TRY (mIREmitter__emit(&rtoc_self_view, node.finish_expr))};\n    while ((${idx_var} ${op_str} __sh${id.toString()}_end) and !__sh${id.toString()}_err.load(.acquire)) : (${idx_var} += 1) {\n${mIREmitter__indent_block(rtoc_self_view, key_loop_mark, 12)}\n${mIREmitter__indent_block(rtoc_self_view, producer_key_body, 12)}\n        const ${sh_var} = @TypeOf(${map_ptr}.*).shardIndexWithHash(${key_var});\n        try __sh${id.toString()}_batches[${sh_var}.shard].append(rt.heapAlloc(), ${key_store_expr});\n        if (__sh${id.toString()}_batches[${sh_var}.shard].items.len >= __sh${id.toString()}_batch) {\n            const __sh${id.toString()}_keys = try __sh${id.toString()}_batches[${sh_var}.shard].toOwnedSlice(rt.heapAlloc());\n            const __sh${id.toString()}_work = __ShWork${id.toString()}{ .keys = __sh${id.toString()}_keys };\n            __sh${id.toString()}_chans[${sh_var}.shard].push(__sh${id.toString()}_work) catch |__err| {\n${mIREmitter__indent_block(rtoc_self_view, key_slice_cleanup, 20)}\n                rt.heapAlloc().free(__sh${id.toString()}_keys);\n                __sh${id.toString()}_err.store(true, .release);\n                for (0..${shard_count.toString()}) |__s| __sh${id.toString()}_chans[__s].setError(__err);\n                break;\n            };\n        }\n    }\n    for (0..${shard_count.toString()}) |__s| {\n        if (__sh${id.toString()}_batches[__s].items.len > 0 and !__sh${id.toString()}_err.load(.acquire)) {\n            const __sh${id.toString()}_keys = try __sh${id.toString()}_batches[__s].toOwnedSlice(rt.heapAlloc());\n            const __sh${id.toString()}_work = __ShWork${id.toString()}{ .keys = __sh${id.toString()}_keys };\n            __sh${id.toString()}_chans[__s].push(__sh${id.toString()}_work) catch |__err| {\n${mIREmitter__indent_block(rtoc_self_view, key_slice_cleanup, 20)}\n                rt.heapAlloc().free(__sh${id.toString()}_keys);\n                __sh${id.toString()}_err.store(true, .release);\n                for (0..${shard_count.toString()}) |__ss| __sh${id.toString()}_chans[__ss].setError(__err);\n                break;\n            };\n        }\n    }\n    for (0..${shard_count.toString()}) |__s| __sh${id.toString()}_chans[__s].close();\n    __sh${id.toString()}_wg.wait();\n    for (0..${shard_count.toString()}) |__s| __ShCleanup${id.toString()}.cleanupBuffered(&__sh${id.toString()}_chans[__s], rt);\n    if (__sh${id.toString()}_err.load(.acquire)) return error.CheatError;\n}\n".trim();
}
END
PRIVATE FN mIREmitter__emit_shard_worker_capture_fields(MUTABLE self: MIREmitter, node: ShardConcurrentEach, map_ptr: String) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fields: []String = ["__shard_map: *@TypeOf(${map_ptr}.*),"];
    MUTABLE rendered = TRY (mIREmitter__emit_context_field_decls(&rtoc_self_view, node.capture_fields));
    IF !((rendered.length() == 0)) THEN
      &fields.append(rendered);
    END
    RETURN fields.join("\n");
}
END
PRIVATE FN mIREmitter__emit_shard_worker_capture_inits(MUTABLE self: MIREmitter, node: ShardConcurrentEach, map_ptr: String) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fields = [".__shard_map = ${map_ptr}"];
    MUTABLE rendered = TRY (mIREmitter__emit_struct_init_fields(&rtoc_self_view, node.capture_inits));
    IF !((rendered.length() == 0)) THEN
      &fields.append(rendered);
    END
    RETURN ", ${fields.join(", ")}";
}
END
PRIVATE FN mIREmitter__emit_shard_cleanup_buffered(self: MIREmitter, id: Int64, string_key: Bool) RETURNS String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE key_cleanup: String = "";
    IF string_key THEN
      key_cleanup = "for (__work.keys) |__k| __rt.heapAlloc().free(__k);\n__rt.heapAlloc().free(__work.keys);";
    ELSE
      key_cleanup = "__rt.heapAlloc().free(__work.keys);";
    END
    RETURN "fn cleanupBuffered(chan: *CheatLib.BoundedChannel(__ShWork${id.toString()}), __rt: *Runtime) void {\n    const inner = chan.inner;\n    inner.mutex.lock();\n    while (inner.tail != inner.head) {\n        const __work = inner.buf[inner.tail & inner.mask];\n        inner.tail += 1;\n${mIREmitter__indent_block(rtoc_self_view, key_cleanup, 12)}\n    }\n    inner.mutex.unlock();\n}\n".trim();
}
END
PRIVATE FN mIREmitter__shard_key_free_work(self: MIREmitter, id: Int64, string_key: Bool) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(string_key) THEN
      RETURN "__rt.heapAlloc().free(__work.keys);";
    END
    RETURN "for (__work.keys) |__k| __rt.heapAlloc().free(__k);\n__rt.heapAlloc().free(__work.keys);";
}
END
PRIVATE FN mIREmitter__emit_body_with_runtime(MUTABLE self: MIREmitter, stmts: []Emittable, runtime_name: String) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE prior_rt_name: String = COPY rtoc_self_view.rt_name;
  DEFER rtoc_self_view.rt_name = prior_rt_name;
  rtoc_self_view.rt_name = COPY runtime_name;
  RETURN TRY (mIREmitter__emit_body(&rtoc_self_view, stmts));
}
END
PRIVATE FN mIREmitter__emit_node_with_runtime(MUTABLE self: MIREmitter, node: Emittable, runtime_name: String) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE prior_rt_name: String = COPY rtoc_self_view.rt_name;
  DEFER rtoc_self_view.rt_name = prior_rt_name;
  rtoc_self_view.rt_name = COPY runtime_name;
  RETURN TRY (mIREmitter__emit(&rtoc_self_view, node));
}
END
PRIVATE FN mIREmitter__emit_capture_cleanup_actions_with_runtime(MUTABLE self: MIREmitter, actions: []CaptureCleanupAction, runtime_name: String) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE prior_rt_name: String = COPY rtoc_self_view.rt_name;
  DEFER rtoc_self_view.rt_name = prior_rt_name;
  rtoc_self_view.rt_name = COPY runtime_name;
  RETURN TRY (mIREmitter__emit_capture_cleanup_actions(&rtoc_self_view, actions));
}
END
PRIVATE FN mIREmitter__replace_emit_identifier(self: MIREmitter, source: String, needle: String, replacement: String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (needle.length() == 0) THEN
      RETURN COPY source;
    END
    MUTABLE idx = 0;
    MUTABLE needle_len = needle.bytes();
    MUTABLE result = "";
    WHILE (idx < source.bytes()) DO
      IF (((source.substr(idx, needle_len) == needle) AND mIREmitter__emit_identifier_boundary?(rtoc_self_view, source, (idx - 1))) AND mIREmitter__emit_identifier_boundary?(rtoc_self_view, source, (idx + needle_len))) THEN
        &result.append(COPY replacement);
        idx = (idx + needle_len);
      ELSE
        &result.append(source.substr(idx, 1));
        idx = (idx + 1);
      END
    END
    RETURN result;
}
END
PRIVATE FN mIREmitter__emit_identifier_boundary?(self: MIREmitter, source: String, index_value: Int64) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF ((index_value < 0) OR (index_value >= source.bytes())) THEN
      RETURN TRUE;
    END
    MUTABLE byte = byteAt(source, index_value);
    RETURN !((((((((byte >= 48) AND (byte <= 57))) OR (((byte >= 65) AND (byte <= 90)))) OR (((byte >= 97) AND (byte <= 122)))) OR (byte == 95))));
}
END
PRIVATE FN mIREmitter__emit_snapshot_read(MUTABLE self: MIREmitter, node: SnapshotRead) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE body = TRY (mIREmitter__emit_body(&rtoc_self_view, node.body));
    MUTABLE cell_unwrap = TRY (mIREmitter__emit(&rtoc_self_view, node.cell_unwrap));
    MUTABLE parts = ["var ${node.guard_var} = ${cell_unwrap}.*.read(${node.rt});", "defer ${node.guard_var}.release();", "const ${node.alias_name} = ${node.guard_var}.get;", "_ = &${node.alias_name};"];
    IF !((body.length() == 0)) THEN
      &parts.append(body);
    END
    RETURN parts.join("\n");
}
END
PRIVATE FN mIREmitter__sharded_map_key_type(node: MIREmitterShardedMapNode) RETURNS ?Type ->
  PARTIAL MATCH node START
    MIREmitterShardedMapNode.ShardedMapPut AS item -> RETURN COPY item.key_type;,
    MIREmitterShardedMapNode.ShardedMapGet AS item -> RETURN COPY item.key_type;
  END
  RETURN NIL;
END
PRIVATE FN mIREmitter__sharded_map_value_type(node: MIREmitterShardedMapNode) RETURNS ?Type ->
  PARTIAL MATCH node START
    MIREmitterShardedMapNode.ShardedMapPut AS item -> RETURN COPY item.value_type;,
    MIREmitterShardedMapNode.ShardedMapGet AS item -> RETURN COPY item.value_type;
  END
  RETURN NIL;
END
PRIVATE FN mIREmitter__sharded_map_resolved_allocs(node: MIREmitterShardedMapNode) RETURNS InlineAllocMetadata@multiowned ->
  PARTIAL MATCH node START
    MIREmitterShardedMapNode.ShardedMapPut AS item -> RETURN KEEP item.resolved_allocs;,
    MIREmitterShardedMapNode.ShardedMapGet AS item -> RETURN KEEP item.resolved_allocs;
  END
  panic("unreachable sharded map node");
END
PRIVATE FN mIREmitter__sharded_map_template_kind(node: MIREmitterShardedMapNode) RETURNS IntrinsicTemplateKind ->
  PARTIAL MATCH node START
    MIREmitterShardedMapNode.ShardedMapPut AS item -> RETURN COPY item.template_kind;,
    MIREmitterShardedMapNode.ShardedMapGet AS item -> RETURN COPY item.template_kind;
  END
  panic("unreachable sharded map node");
