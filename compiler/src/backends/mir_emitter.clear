PRIVATE FN mIREmitter__emit_make_list(MUTABLE self: MIREmitter, node: MakeList) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE items = (node.items |> SELECT TRY (mIREmitter__emit(&rtoc_self_view, _))).join(", ");
    MUTABLE items_expr: String = "";
    IF (node.items.length() == 0) THEN
      items_expr = "&.{}";
    ELSE
      items_expr = "&.{ ${items} }";
    END
    IF node.minimum_capacity EXISTS AS minimum_capacity_value THEN
      RETURN "try CheatLib.makeListCapacity(${node.elem_type}, ${TRY (mIREmitter__alloc_zig(rtoc_self_view, node.alloc))}, ${items_expr}, ${minimum_capacity_value.toString()})";
    ELSE
      RETURN "try CheatLib.makeList(${node.elem_type}, ${TRY (mIREmitter__alloc_zig(rtoc_self_view, node.alloc))}, ${items_expr})";
    END
}
END
