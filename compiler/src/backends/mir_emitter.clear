->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN "CheatLib.${node.func}(${node.zig_base}, ${TRY (mIREmitter__emit(&rtoc_self_view, node.alloc))}, ${TRY (mIREmitter__emit(&rtoc_self_view, node.source))})";
