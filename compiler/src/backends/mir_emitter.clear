PRIVATE FN mIREmitter__emit_capability_unwrap(MUTABLE self: MIREmitter, node: CapabilityUnwrap) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE source = TRY (mIREmitter__emit(&rtoc_self_view, node.source));
    MUTABLE is_ptr = "@typeInfo(@TypeOf(${source})) == .pointer";
    MUTABLE inner_t = "@typeInfo(@TypeOf(${source})).pointer.child";
    RETURN "(if (comptime ${is_ptr}) (if (comptime @typeInfo(${inner_t}) == .@\"struct\") (if (comptime @hasDecl(${inner_t}, \"__clear_ref_carrier\")) ${source}.ctrl.data else ${source}) else (if (comptime @typeInfo(${inner_t}) == .pointer) (if (comptime @typeInfo(@typeInfo(${inner_t}).pointer.child) == .@\"struct\") (if (comptime @hasDecl(@typeInfo(${inner_t}).pointer.child, \"__clear_ref_carrier\")) ${source}.*.ctrl.data else ${source}.*) else ${source}.*) else ${source})) else (if (comptime @typeInfo(@TypeOf(${source})) == .@\"struct\") (if (comptime @hasDecl(@TypeOf(${source}), \"__clear_ref_carrier\")) ${source}.ctrl.data else &${source}) else &${source}))";
}
END
PRIVATE FN mIREmitter__emit_capability_lock_target(MUTABLE self: MIREmitter, node: CapabilityLockTarget) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE source = TRY (mIREmitter__emit(&rtoc_self_view, node.source));
    IF node.comptime_arc_unwrap THEN
      RETURN mIREmitter__comptime_arc_unwrap_expr(rtoc_self_view, source);
    END
    IF node.arc_wrapped THEN
      RETURN "${source}.ctrl.data.*";
    END
    RETURN source;
}
END
PRIVATE FN mIREmitter__emit_capability_lock_address(MUTABLE self: MIREmitter, node: CapabilityLockAddress) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE source = TRY (mIREmitter__emit(&rtoc_self_view, node.source));
    IF node.arc_wrapped THEN
      RETURN "${source}.ctrl.data";
    ELSE
      RETURN "&${source}";
    END
}
END
PRIVATE FN mIREmitter__comptime_arc_unwrap_expr(self: MIREmitter, source: String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE base_t = "@TypeOf(${source})";
    RETURN "(if (comptime @typeInfo(${base_t}) == .pointer) (if (comptime @typeInfo(@typeInfo(${base_t}).pointer.child) == .@\"struct\") (if (comptime @hasDecl(@typeInfo(${base_t}).pointer.child, \"__clear_ref_carrier\")) ${source}.*.ctrl.data.* else ${source}.*) else ${source}.*) else (if (comptime @typeInfo(${base_t}) == .@\"struct\") (if (comptime @hasDecl(${base_t}, \"__clear_ref_carrier\")) ${source}.ctrl.data.* else ${source}) else ${source}))";
}
END
PRIVATE FN mIREmitter__emit_polymorphic_mutate(MUTABLE self: MIREmitter, node: PolymorphicMutate) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE captures = TRY (mIREmitter__polymorphic_read_captures(rtoc_self_view, node.body, [node.alias_name]));
    IF !(captures.contains?(CAST(node.rt AS String))) THEN
      captures = ([CAST(node.rt AS String)] + captures);
    END
    MUTABLE overrides = TRY (mIREmitter__polymorphic_capture_overrides(rtoc_self_view, captures));
    MUTABLE guard_captures = TRY (mIREmitter__polymorphic_move_guard_captures(rtoc_self_view, node.body, [node.alias_name]));
    MUTABLE guard_overrides = TRY (mIREmitter__polymorphic_move_guard_overrides(&rtoc_self_view, guard_captures, captures.length()));
    MUTABLE body_zig = mIREmitter__with_move_guard_overrides(&rtoc_self_view, guard_overrides, %() USE(node, overrides, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_15 = mIREmitter__with_ident_overrides(&rtoc_self_view, overrides, %() USE(node, overrides, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_14 = mIREmitter__with_runtime_name(&rtoc_self_view, UNWRAP (overrides[CAST(node.rt AS String)]), %() USE(node, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_13 = TRY (mIREmitter__emit_body(&rtoc_self_view, node.body));
    rtoc_lambda_result_13
    });
    rtoc_lambda_result_14
    });
    rtoc_lambda_result_15
    });
    MUTABLE cell_zig = TRY (mIREmitter__emit(&rtoc_self_view, node.cell));
    MUTABLE capture_param: String = "";
    IF (captures.length() == 0) THEN
      capture_param = "";
    ELSE
      capture_param = ", __captures: anytype";
    END
    MUTABLE capture_suppress: String = "";
    IF (captures.length() == 0) THEN
      capture_suppress = "";
    ELSE
      capture_suppress = "_ = &__captures;";
    END
    MUTABLE all_capture_args = (captures + (guard_captures |> SELECT "&${mIREmitter__move_guard_name(rtoc_self_view, Name{ StringValue: COPY _ })}"));
    MUTABLE capture_args: String = "";
    IF all_capture_args.empty?() THEN
      capture_args = ".{}";
    ELSE
      capture_args = ".{.{${all_capture_args.join(", ")}}}";
    END
    RETURN regexReplaceAll__mir_emitter("try CheatLib.polymorphicMutate(${cell_zig}, ${node.rt}, struct {\n    fn run(${node.alias_name}: *${TRY (type__zig_type(CAST(node.bare_type AS Type)))}${capture_param}) !void {\n        _ = &${node.alias_name};\n        ${capture_suppress}\n        ${body_zig}\n    }\n}.run, ${capture_args});\n", "\\s+\\z", "");
}
END
PRIVATE FN mIREmitter__emit_polymorphic_mutate_flow(MUTABLE self: MIREmitter, node: PolymorphicMutateFlow) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE old_flow_alias: ?String = COPY rtoc_self_view.flow_alias_name;
    rtoc_self_view.flow_alias_name = node.alias_name;
    MUTABLE cell_zig = TRY (mIREmitter__emit(&rtoc_self_view, node.cell));
    MUTABLE captures = TRY (mIREmitter__polymorphic_read_captures(rtoc_self_view, ((node.body) + ((node.guard_fail_body OR_ELSE List[]))), [node.alias_name, "__flow"]));
    IF !(captures.contains?(CAST(node.rt AS String))) THEN
      captures = ([CAST(node.rt AS String)] + captures);
    END
    MUTABLE overrides = TRY (mIREmitter__polymorphic_capture_overrides(rtoc_self_view, captures));
    MUTABLE all_bodies = ((node.body) + ((node.guard_fail_body OR_ELSE List[])));
    MUTABLE guard_captures = TRY (mIREmitter__polymorphic_move_guard_captures(rtoc_self_view, all_bodies, [node.alias_name, "__flow"]));
    MUTABLE guard_overrides = TRY (mIREmitter__polymorphic_move_guard_overrides(&rtoc_self_view, guard_captures, captures.length()));
    MUTABLE body_zig = mIREmitter__with_move_guard_overrides(&rtoc_self_view, guard_overrides, %() USE(node, overrides, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_18 = mIREmitter__with_ident_overrides(&rtoc_self_view, overrides, %() USE(node, overrides, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_17 = mIREmitter__with_runtime_name(&rtoc_self_view, UNWRAP (overrides[CAST(node.rt AS String)]), %() USE(node, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_16 = TRY (mIREmitter__emit_body_flow(&rtoc_self_view, node.body, :ret_commit));
    rtoc_lambda_result_16
    });
    rtoc_lambda_result_17
    });
    rtoc_lambda_result_18
    });
    MUTABLE capture_param: String = "";
    IF (captures.length() == 0) THEN
      capture_param = "";
    ELSE
      capture_param = ", __captures: anytype";
    END
    MUTABLE capture_suppress: String = "";
    IF (captures.length() == 0) THEN
      capture_suppress = "";
    ELSE
      capture_suppress = "_ = &__captures;";
    END
    MUTABLE all_capture_args = (captures + (guard_captures |> SELECT "&${mIREmitter__move_guard_name(rtoc_self_view, Name{ StringValue: COPY _ })}"));
    MUTABLE capture_args: String = "";
    IF all_capture_args.empty?() THEN
      capture_args = ".{&__poly_flow}";
    ELSE
      capture_args = ".{&__poly_flow, .{${all_capture_args.join(", ")}}}";
    END
    MUTABLE guard_block = "";
    IF node.guard_cond THEN
      MUTABLE fail_zig = mIREmitter__with_move_guard_overrides(&rtoc_self_view, guard_overrides, %() USE(node, overrides, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_21 = mIREmitter__with_ident_overrides(&rtoc_self_view, overrides, %() USE(node, overrides, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_20 = mIREmitter__with_runtime_name(&rtoc_self_view, UNWRAP (overrides[CAST(node.rt AS String)]), %() USE(node, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_19 = TRY (mIREmitter__emit_body_flow(&rtoc_self_view, (node.guard_fail_body OR_ELSE List[]), :ret_no_commit));
    rtoc_lambda_result_19
      });
    rtoc_lambda_result_20
      });
    rtoc_lambda_result_21
      });
      IF !(TRY (mIREmitter__flow_body_terminates?(rtoc_self_view, (node.guard_fail_body OR_ELSE List[])))) THEN
        fail_zig = (fail_zig $+ "\n__flow.* = .{ .kind = .skip_no_commit };\nreturn;");
      END
      guard_block = "if (!(${mIREmitter__with_ident_overrides(&rtoc_self_view, overrides, %() USE(node, overrides, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_23 = mIREmitter__with_runtime_name(&rtoc_self_view, UNWRAP (overrides[CAST(node.rt AS String)]), %() USE(node, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_22 = TRY (mIREmitter__emit(&rtoc_self_view, node.guard_cond));
    rtoc_lambda_result_22
      });
    rtoc_lambda_result_23
      })})) {\n    ${mIREmitter__indent_block(rtoc_self_view, fail_zig, 12)}\n}\n";
    END
    MUTABLE fallthrough_arm: String = "";
    IF TRY (mIREmitter__flow_always_exits?(rtoc_self_view, node)) THEN
      fallthrough_arm = "unreachable";
    ELSE
      fallthrough_arm = "{}";
    END
    MUTABLE result = regexReplaceAll__mir_emitter(("const __PolyFlow = struct {\n    kind: enum { cont_commit, skip_no_commit, ret_commit, ret_no_commit, raise_no_commit },\n    ret: ${TRY (type__zig_type(CAST(node.return_type AS Type)))} = undefined,\n};\nvar __poly_flow = __PolyFlow{ .kind = .cont_commit };\ntry CheatLib.polymorphicMutateFlow(${cell_zig}, ${node.rt}, struct {\n    fn run(${node.alias_name}: *${TRY (type__zig_type(CAST(node.bare_type AS Type)))}, __flow: *__PolyFlow${capture_param}) !void {\n        _ = &${node.alias_name};\n        ${capture_suppress}\n        ${guard_block}\n        ${body_zig}\n        ${IF TRY (mIREmitter__flow_body_terminates?(rtoc_self_view, node.body)) THEN
      ""
    ELSE
      "__flow.* = .{ .kind = .cont_commit };"
    END}\n    }\n}.run, ${capture_args});\nswitch (__poly_flow.kind) {\n    .ret_commit, .ret_no_commit => return __poly_flow.ret,\n    .raise_no_commit => return error.CheatError,\n    .cont_commit, .skip_no_commit => ${fallthrough_arm},\n}\n"), "\\s+\\z", "");
    rtoc_self_view.flow_alias_name = old_flow_alias;
    RETURN result;
}
END
PRIVATE FN mIREmitter__polymorphic_read_captures(self: MIREmitter, body: []Emittable, excluded: []String) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE declared: [Set]String = excluded |> DISTINCT _;
    MUTABLE used: []String = ( { MUTABLE rtoc_empty_list_24: []String = List[]; rtoc_empty_list_24 } );
    TRY (mIR__each_node(NodeRoot{ ArrayValue: COPY body }, %(part: Emittable) USE(MUTABLE declared, MUTABLE used) -> {
    IF part IS_A Let AS let THEN
        &declared.insert(COPY CAST(let.name AS String));
    END
    IF part IS_A Ident AS ident THEN
        MUTABLE name = COPY ident.name;
        IF !(used.contains?(name)) THEN
          &used.append(name);
        END
    END
    rubyToClearVoid__mir_emitter()
    }));
    RETURN used |> WHERE !(declared.contains?(_));
}
END
PRIVATE FN mIREmitter__polymorphic_capture_overrides(self: MIREmitter, captures_value: []String) RETURNS !{String}String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN {
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE rtoc_indexed_items_25: []String = captures_value;
    MUTABLE rtoc_indexed_output_27 = {};
    MUTABLE rtoc_indexed_i_26 = 0;
    WHILE rtoc_indexed_i_26 < rtoc_indexed_items_25.length() DO
      MUTABLE rtoc_indexed_pair_28 = Tuple{UNWRAP (rtoc_indexed_items_25[rtoc_indexed_i_26]), "__captures[${rtoc_indexed_i_26.toString()}]"};
      rtoc_indexed_output_27[rtoc_indexed_pair_28._0] = rtoc_indexed_pair_28._1;
      rtoc_indexed_i_26 = rtoc_indexed_i_26 + 1;
    END
    rtoc_indexed_output_27
    };
}
END
PRIVATE FN mIREmitter__polymorphic_move_guard_captures(self: MIREmitter, body: []Emittable, excluded: []String) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE declared: [Set]String = excluded |> DISTINCT _;
    MUTABLE moved: []String = ( { MUTABLE rtoc_empty_list_29: []String = List[]; rtoc_empty_list_29 } );
    TRY (mIR__each_node(NodeRoot{ ArrayValue: COPY body }, %(part: Emittable) USE(MUTABLE declared, MUTABLE moved) -> {
    IF part IS_A Let AS let THEN
        &declared.insert(COPY CAST(let.name AS String));
    END
    IF part IS_A MoveMark AS move_mark THEN
      MUTABLE name = COPY CAST(move_mark.name AS String);
      IF !((declared.contains?(name) OR moved.contains?(name))) THEN
          &moved.append(name);
      END
    END
    rubyToClearVoid__mir_emitter()
    }));
    RETURN moved;
}
END
PRIVATE FN mIREmitter__polymorphic_move_guard_overrides(MUTABLE self: MIREmitter, captures_value: []String, offset: Int64) RETURNS !{String}String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN {
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE rtoc_indexed_items_30: []String = captures_value;
    MUTABLE rtoc_indexed_output_32 = {};
    MUTABLE rtoc_indexed_i_31 = 0;
    WHILE rtoc_indexed_i_31 < rtoc_indexed_items_30.length() DO
      MUTABLE rtoc_indexed_pair_33 = Tuple{UNWRAP (rtoc_indexed_items_30[rtoc_indexed_i_31]), "__captures[${(offset + rtoc_indexed_i_31).toString()}].*"};
      rtoc_indexed_output_32[rtoc_indexed_pair_33._0] = rtoc_indexed_pair_33._1;
      rtoc_indexed_i_31 = rtoc_indexed_i_31 + 1;
    END
    rtoc_indexed_output_32
    };
}
END
PRIVATE FN mIREmitter__with_ident_overrides<U>(MUTABLE self: MIREmitter, overrides: {String}String, blk: FN() -> U) RETURNS U
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE previous: {String}String = COPY rtoc_self_view.ident_overrides;
  DEFER rtoc_self_view.ident_overrides = previous;
  rtoc_self_view.ident_overrides = overrides.keys() |> REDUCE(COPY rtoc_self_view.ident_overrides) { acc[_] = COPY UNWRAP (overrides[_]); acc };
  RETURN blk();
}
END
PRIVATE FN mIREmitter__with_move_guard_overrides<U>(MUTABLE self: MIREmitter, overrides: {String}String, blk: FN() -> U) RETURNS U
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE previous: {String}String = COPY rtoc_self_view.move_guard_overrides;
  DEFER rtoc_self_view.move_guard_overrides = previous;
  rtoc_self_view.move_guard_overrides = overrides.keys() |> REDUCE(COPY rtoc_self_view.move_guard_overrides) { acc[_] = COPY UNWRAP (overrides[_]); acc };
  RETURN blk();
}
END
PRIVATE FN mIREmitter__with_runtime_name<U>(MUTABLE self: MIREmitter, runtime_name: String, blk: FN() -> U) RETURNS U
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE previous: String = COPY rtoc_self_view.rt_name;
  DEFER rtoc_self_view.rt_name = previous;
  rtoc_self_view.rt_name = COPY runtime_name;
  RETURN blk();
}
END
PRIVATE FN mIREmitter__with_heap_allocator_cache<U>(MUTABLE self: MIREmitter, cache_name: ?String, runtime_name: ?String, blk: FN() -> U) RETURNS U
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE previous_name: ?String = COPY rtoc_self_view.heap_allocator_cache_name;
  MUTABLE previous_runtime: ?String = COPY rtoc_self_view.heap_allocator_cache_runtime_name;
  DEFER mIREmitter__restore_heap_allocator_cache(&rtoc_self_view, cache_name, previous_name, previous_runtime);
  IF cache_name EXISTS AS cache_name_value THEN
      &rtoc_self_view.heap_allocator_cache_names.append(COPY cache_name_value);
  END
  rtoc_self_view.heap_allocator_cache_name = COPY cache_name;
  rtoc_self_view.heap_allocator_cache_runtime_name = COPY runtime_name;
  RETURN blk();
}
END
PRIVATE FN mIREmitter__restore_heap_allocator_cache(MUTABLE self: MIREmitter, cache_name: ?String, TAKES previous_name: ?String, TAKES previous_runtime: ?String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF cache_name EXISTS AS cache_name_value THEN
      &rtoc_self_view.heap_allocator_cache_names.pop();
    END
    rtoc_self_view.heap_allocator_cache_name = previous_name;
    rtoc_self_view.heap_allocator_cache_runtime_name = previous_runtime;
}
END
PRIVATE FN mIREmitter__emit_body_flow(MUTABLE self: MIREmitter, stmts: []Emittable, return_kind: String@symbol) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN (stmts |> SELECT TRY (mIREmitter__emit_flow_stmt(&rtoc_self_view, _, return_kind))).join("\n");
}
END
PRIVATE FN mIREmitter__emit_flow_stmt(MUTABLE self: MIREmitter, stmt: Emittable, return_kind: String@symbol) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF stmt IS_A ReturnStmt AS return_stmt THEN
      MUTABLE return_stmt_mutable = COPY return_stmt;
      MUTABLE ret: String = "{}";
      IF return_stmt_mutable.value != NIL THEN
        ret = TRY (mIREmitter__emit(&rtoc_self_view, return_stmt_mutable.value));
      END
      IF ((rtoc_self_view.flow_alias_name != NIL) AND (ret == (rtoc_self_view.flow_alias_name)?)) THEN
        ret = "${ret}.*";
      END
      RETURN "__flow.* = .{ .kind = .${return_kind}, .ret = ${ret} };\nreturn;";
    ELSE_IF stmt IS_A ScopeBlock AS scope_block THEN
      MUTABLE scope_block_mutable = COPY scope_block;
      MUTABLE inner = TRY (mIREmitter__emit_body_flow(&rtoc_self_view, TRY (scopeBlock__body(scope_block_mutable)), return_kind));
      RETURN "{\n${mIREmitter__indent_block(rtoc_self_view, inner, 4)}\n}";
    ELSE_IF stmt IS_A IfStmt AS if_stmt THEN
      MUTABLE if_stmt_mutable = COPY if_stmt;
      MUTABLE then_zig = TRY (mIREmitter__emit_body_flow(&rtoc_self_view, if_stmt_mutable.then_body, return_kind));
      MUTABLE else_zig = TRY (mIREmitter__emit_body_flow(&rtoc_self_view, (if_stmt_mutable.else_body OR_ELSE List[]), return_kind));
      MUTABLE else_body: ?[]Emittable = COPY if_stmt_mutable.else_body;
      IF ((else_body != NIL) AND !(else_body.empty?())) THEN
        RETURN "if (${TRY (mIREmitter__emit(&rtoc_self_view, if_stmt_mutable.cond))}) {\n${mIREmitter__indent_block(rtoc_self_view, then_zig, 4)}\n} else {\n${mIREmitter__indent_block(rtoc_self_view, else_zig, 4)}\n}";
      ELSE
        RETURN "if (${TRY (mIREmitter__emit(&rtoc_self_view, if_stmt_mutable.cond))}) {\n${mIREmitter__indent_block(rtoc_self_view, then_zig, 4)}\n}";
      END
    ELSE_IF stmt IS_A PolymorphicFlowSignal AS polymorphic_flow_signal THEN
      MUTABLE polymorphic_flow_signal_mutable = COPY polymorphic_flow_signal;
      RETURN TRY (mIREmitter__emit_polymorphic_flow_signal(&rtoc_self_view, polymorphic_flow_signal_mutable));
    ELSE
      RETURN TRY (mIREmitter__emit(&rtoc_self_view, stmt));
    END
}
END
PRIVATE FN mIREmitter__emit_polymorphic_flow_signal(MUTABLE self: MIREmitter, node: PolymorphicFlowSignal) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fields = [".kind = .${node.kind}"];
    IF node.ret THEN
      &fields.append(".ret = ${TRY (mIREmitter__emit(&rtoc_self_view, node.ret))}");
    END
    RETURN "__flow.* = .{ ${fields.join(", ")} };\nreturn;";
}
END
PRIVATE FN mIREmitter__flow_body_terminates?(self: MIREmitter, stmts: []Emittable) RETURNS !Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF stmts.empty?() THEN
      RETURN FALSE;
    END
    MUTABLE last: Emittable = COPY UNWRAP (stmts.last());
    IF last IS_A ReturnStmt AS return_stmt THEN
      RETURN TRUE;
    ELSE_IF last IS_A PolymorphicFlowSignal AS polymorphic_flow_signal THEN
      RETURN TRUE;
    ELSE_IF last IS_A ScopeBlock AS scope_block THEN
      RETURN mIREmitter__flow_body_terminates?(rtoc_self_view, TRY (scopeBlock__body(scope_block)));
    ELSE_IF last IS_A IfStmt AS if_stmt THEN
      IF !(mIREmitter__flow_body_terminates?(rtoc_self_view, if_stmt.then_body)) THEN
        RETURN FALSE;
      END
      MUTABLE else_body: []Emittable = COPY (if_stmt.else_body OR_ELSE List[]);
      IF else_body.empty?() THEN
        RETURN FALSE;
      END
      RETURN mIREmitter__flow_body_terminates?(rtoc_self_view, else_body);
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN mIREmitter__flow_always_exits?(self: MIREmitter, node: PolymorphicMutateFlow) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE body_exits = TRY (mIREmitter__flow_body_terminates?(rtoc_self_view, node.body));
    IF !(node.guard_cond) THEN
      RETURN body_exits;
    END
    RETURN (body_exits AND TRY (mIREmitter__flow_body_terminates?(rtoc_self_view, (node.guard_fail_body OR_ELSE List[]))));
}
END
PRIVATE FN mIREmitter__indent_block(self: MIREmitter, code: String, spaces: Int64) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE pad = compilerRepeatString(" ", spaces);
    # An IF EXPRESSION may not produce a heap String, and Ruby's `lines` keeps
    # the newline that `split` drops -- joining with "" ran every line together.
    MUTABLE padded: []String = List[];
    FOR line IN code.split("\n") DO
      IF (line.trim().length() == 0) THEN
        &padded.append(COPY line);
      ELSE
        &padded.append("${pad}${line}");
      END
    END
    RETURN regexReplaceAll__mir_emitter(padded.join("\n"), "\\s+\\z", "");
}
END
PRIVATE FN mIREmitter__emit_snapshot_transaction(MUTABLE self: MIREmitter, node: SnapshotTransaction) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE body_zig = TRY (mIREmitter__emit_body(&rtoc_self_view, node.body));
    MUTABLE cell_unwrap = TRY (mIREmitter__emit(&rtoc_self_view, node.cell_unwrap));
    MUTABLE alloc = TRY (mIREmitter__alloc_zig(rtoc_self_view, node.alloc));
    MUTABLE core = regexReplaceAll__mir_emitter("${cell_unwrap}.*.update(${node.rt}, ${alloc}, struct {\n    fn run(${node.alias_name}: *${TRY (type__zig_type(CAST(node.bare_type AS Type)))}) void {\n        _ = &${node.alias_name};\n        ${body_zig}\n    }\n}.run, .{})\n", "\\s+\\z", "");
    MUTABLE zig_error_name: String = "";
    IF node.is_atomic_ptr THEN
      zig_error_name = "AtomicConflict";
    ELSE
      zig_error_name = "UpdateRetriesExhausted";
    END
    RETURN TRY (mIREmitter__wrap_conflict_handler(&rtoc_self_view, core, castEmittableToOptionalFailureAction(node.conflict_action), node.retries, zig_error_name));
}
END
PRIVATE FN mIREmitter__emit_snapshot_multi_txn(MUTABLE self: MIREmitter, node: SnapshotMultiTxn) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE body_zig = TRY (mIREmitter__emit_body(&rtoc_self_view, node.body));
    MUTABLE cell_parts: []String = List[];
    FOR cell IN node.cells DO
      &cell_parts.append(TRY (mIREmitter__emit(&rtoc_self_view, cell)));
    END
    MUTABLE cells_tuple = ".{ ${cell_parts.join(", ")} }";
    MUTABLE alloc = TRY (mIREmitter__alloc_zig(rtoc_self_view, node.alloc));
    MUTABLE alias_parts: []String = List[];
    MUTABLE alias_index: Int64 = 0;
    WHILE (alias_index < node.aliases.length()) DO
      MUTABLE alias_name: String = COPY UNWRAP (node.aliases[alias_index]);
      &alias_parts.append("const ${alias_name} = views[${alias_index.toString()}]; _ = &${alias_name};");
      alias_index = (alias_index + 1);
    END
    MUTABLE alias_decls = alias_parts.join("\n            ");
    MUTABLE core = regexReplaceAll__mir_emitter("CheatLib.versionedUpdateMulti(${cells_tuple}, ${node.rt}, ${alloc}, struct {\n    fn run(views: anytype) anyerror!void {\n        ${alias_decls}\n        ${body_zig}\n    }\n}.run, .{})\n", "\\s+\\z", "");
    RETURN TRY (mIREmitter__wrap_conflict_handler(&rtoc_self_view, core, castEmittableToOptionalFailureAction(node.conflict_action), node.retries));
}
END
PRIVATE FN mIREmitter__emit_with_match_dispatch(MUTABLE self: MIREmitter, node: WithMatchDispatch) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE cell_zig = TRY (mIREmitter__emit(&rtoc_self_view, node.cell));
    MUTABLE arms = COPY node.arms;
    MUTABLE arm_strs: []String = List[];
    MUTABLE arm_index: Int64 = 0;
    WHILE (arm_index < arms.length()) DO
      MUTABLE arm: MIRWithMatchArm = COPY UNWRAP (arms[arm_index]);
      MUTABLE probe = TRY (mIREmitter__emit_with_match_probe(rtoc_self_view, arm.family, cell_zig, node.snapshot_mode));
      MUTABLE head: String = "else if (comptime ${probe})";
      IF (arm_index == 0) THEN
        head = "if (comptime ${probe})";
      END
      MUTABLE body_zig = TRY (mIREmitter__emit_body(&rtoc_self_view, arm.body));
      MUTABLE prelude = TRY (mIREmitter__emit_with_match_prelude(&rtoc_self_view, arm, cell_zig, node.alias_name, node.rt_name, node.snapshot_mode));
      MUTABLE inner: String = COPY body_zig;
      IF !(prelude.empty?()) THEN
        inner = "${prelude}\n${body_zig}";
      END
      &arm_strs.append("${head} {\n    ${inner}\n}");
      arm_index = (arm_index + 1);
    END
    MUTABLE chain = (arm_strs.join(" ") $+ " else { unreachable; }");
    RETURN "${chain}\n_ = &${cell_zig};";
}
END
PRIVATE FN mIREmitter__emit_with_match_probe(self: MIREmitter, family: String@symbol, cell_zig: String, snapshot_mode: Bool) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE inner_t = "CheatLib.WithMatchInner(@TypeOf(${cell_zig}))";
    IF (family == :VERSIONED) THEN
      IF snapshot_mode THEN
        RETURN "(@hasDecl(${inner_t}, \"Inner\") and !@hasDecl(${inner_t}, \"compareAndPublish\"))";
      ELSE
        RETURN "@hasDecl(${inner_t}, \"Inner\")";
      END
    ELSE_IF (family == :LOCKED) THEN
      RETURN "@hasField(${inner_t}, \"mutex\")";
    ELSE_IF (family == :ATOMIC) THEN
      IF snapshot_mode THEN
        RETURN "@hasDecl(${inner_t}, \"compareAndPublish\")";
      ELSE
        RETURN "@hasDecl(${inner_t}, \"cmpxchgStrong\")";
      END
    ELSE
      panic("WITH MATCH: no probe for family {}");
    END
}
END
PRIVATE FN mIREmitter__emit_with_match_prelude(MUTABLE self: MIREmitter, arm: MIRWithMatchArm, cell_zig: String, alias_name: String, rt_name: String, snapshot_mode: Bool) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE unwrap = TRY (mIREmitter__emit_capability_unwrap(&rtoc_self_view, CapabilityUnwrap{ source: Emittable{ Ident: COPY Ident{ name: COPY cell_zig, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL }));
    IF (arm.family == :VERSIONED) THEN
      RETURN mIREmitter__emit_with_match_guard_prelude(rtoc_self_view, unwrap, arm.guard_var, alias_name, rt_name, :read);
    ELSE_IF (arm.family == :LOCKED) THEN
      RETURN mIREmitter__emit_with_match_guard_prelude(rtoc_self_view, unwrap, arm.guard_var, alias_name, rt_name, :acquire);
    ELSE_IF (arm.family == :ATOMIC) THEN
      IF snapshot_mode THEN
        RETURN mIREmitter__emit_with_match_guard_prelude(rtoc_self_view, unwrap, arm.guard_var, alias_name, rt_name, :read);
      ELSE
        RETURN "const ${alias_name} = ${unwrap};\n_ = &${alias_name};";
      END
    ELSE
      RETURN "";
    END
}
END
PRIVATE FN mIREmitter__emit_with_match_guard_prelude(self: MIREmitter, unwrap: String, guard_var: String, alias_name: String, rt_name: String, mode: String@symbol) RETURNS String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE call: String = "";
    IF (mode == :read) THEN
      call = "read(${rt_name})";
    ELSE
      call = "acquire()";
    END
    RETURN (["var ${guard_var} = ${unwrap}.*.${call};", "defer ${guard_var}.release();", "const ${alias_name} = ${guard_var}.get;", "_ = &${alias_name};"]).join("\n");
}
END
PRIVATE FN mIREmitter__wrap_conflict_handler(MUTABLE self: MIREmitter, core_call: String, conflict_action: ?FailureAction, retries: ?Int64, zig_error_name: String = "UpdateRetriesExhausted") RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE action_zig: String = "";
    IF conflict_action EXISTS AS conflict_action_value THEN
      action_zig = TRY (mIREmitter__emit_failure_action(&rtoc_self_view, conflict_action_value));
    ELSE
      action_zig = "return error.${zig_error_name};";
    END
    IF retries EXISTS AS retries_value THEN
      RETURN regexReplaceAll__mir_emitter("{\n    var __retry: usize = 0;\n    __snap_retry: while (true) : (__retry += 1) {\n        if (${core_call}) |_| {\n            break :__snap_retry;\n        } else |__err| switch (__err) {\n            error.${zig_error_name} => {\n                if (__retry + 1 < ${retries_value.toString()}) continue;\n                ${action_zig}\n            },\n            else => return __err,\n        }\n    }\n}\n", "\\s+\\z", "");
    ELSE
      RETURN regexReplaceAll__mir_emitter("${core_call} catch |__err| switch (__err) {\n    error.${zig_error_name} => { ${action_zig} },\n    else => return __err,\n};\n", "\\s+\\z", "");
    END
}
END
PRIVATE FN mIREmitter__emit_failure_action(MUTABLE self: MIREmitter, action: FailureAction) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE kind = COPY action.kind;
    MUTABLE error_name = COPY CAST(action.error_type AS String);
    IF (kind == FailureActionKind.Raise) THEN
      RETURN "${action.rt_name}.setError(.${action.error_kind}, @intFromEnum(ErrorName.${error_name}), ${mIREmitter__zig_string_literal(rtoc_self_view, action.default_message)}, ${action.line});\nreturn error.CheatError;";
    ELSE_IF (kind == FailureActionKind.Exit) THEN
      MUTABLE message: String = "";
      IF action.message EXISTS AS message_value THEN
        message = TRY (mIREmitter__emit(&rtoc_self_view, message_value));
      ELSE
        message = mIREmitter__zig_string_literal(rtoc_self_view, action.default_message);
      END
      RETURN "${action.rt_name}.setError(.${action.error_kind}, @intFromEnum(ErrorName.${error_name}), ${message}, ${action.line});\nreturn error.CheatError;";
    ELSE_IF (kind == FailureActionKind.Pass) THEN
      RETURN "break :${TRY (mIREmitter__required_failure_label(rtoc_self_view, action))};";
    ELSE_IF (kind == FailureActionKind.Return) THEN
      RETURN "return ${TRY (mIREmitter__emit(&rtoc_self_view, UNWRAP (action.return_value)))};";
    ELSE_IF (kind == FailureActionKind.Block) THEN
      RETURN "${TRY (mIREmitter__emit_body(&rtoc_self_view, action.body))}\nbreak :${TRY (mIREmitter__required_failure_label(rtoc_self_view, action))};";
    ELSE
      panic("unknown failure action kind: {}");
    END
}
END
PRIVATE FN mIREmitter__required_failure_label(self: MIREmitter, action: FailureAction) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE label: ?String = COPY action.with_label;
    IF label EXISTS AS label_value THEN
      RETURN label_value;
    ELSE
      panic("failure action requires a WITH label");
    END
}
END
# `[a, b].reject(&:empty?).join(sep)`. Written out because the machine
# translation bound `.join` to the WHERE predicate rather than to the
# filtered list, so every one of these joined a Bool.
PRIVATE FN mIREmitterJoinNonEmpty(parts: []String, separator: String) RETURNS String ->
  MUTABLE kept: []String = List[];
  FOR part IN parts DO
    IF !(part.empty?()) THEN
      &kept.append(COPY part);
    END
  END
  RETURN kept.join(separator);
END
PRIVATE FN mIREmitter__zig_string_literal(self: MIREmitter, text: String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN compilerStringDump(text);
}
END
PRIVATE FN mIREmitter__symbol_literal_name(MUTABLE self: MIREmitter, value: String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE existing: ?String = COPY rtoc_self_view.symbol_literals[value];
    IF existing EXISTS AS existing_value THEN
      RETURN COPY existing_value;
    END
    MUTABLE name = "__clear_symbol_${rtoc_self_view.symbol_literals.count().toString()}";
    rtoc_self_view.symbol_literals[value] = name;
    RETURN name;
}
END
PRIVATE FN mIREmitter__zig_byte_string_literal(self: MIREmitter, text: String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN compilerByteStringLiteral(text);
}
END
PRIVATE FN mIREmitter__emit_fallible_lock_binding(MUTABLE self: MIREmitter, node: FallibleLockBinding) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN (["var ${node.guard_var} = ${TRY (mIREmitter__emit_fallible_lock_acquire_expr(&rtoc_self_view, node))};", "defer ${node.guard_var}.release();", "const ${node.alias_name} = ${node.guard_var}.get;", "_ = &${node.alias_name};"]).join("\n");
}
END
PRIVATE FN mIREmitter__emit_fallible_lock_acquire_expr(MUTABLE self: MIREmitter, node: FallibleLockBinding) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE handler = TRY (mIREmitter__emit_fallible_lock_error_handler(&rtoc_self_view, castEmittableToFailureAction(node.action), node.retries, node.matched_types, node.bubble_types, node.rt_name, CAST(node.source_line AS String)));
    MUTABLE acquire_call = TRY (mIREmitter__emit(&rtoc_self_view, node.acquire_call));
    IF node.retries THEN
      RETURN regexReplaceAll__mir_emitter("${node.acquire_block}: {\n  var __retry: usize = 0;\n  while (true) : (__retry += 1) {\n    if (${acquire_call}) |__g| {\n      break :${node.acquire_block} __g;\n    } else |__err| {\n      ${handler}\n    }\n  }\n}\n", "\\s+\\z", "");
    ELSE
      RETURN regexReplaceAll__mir_emitter("${node.acquire_block}: {\n  if (${acquire_call}) |__g| {\n    break :${node.acquire_block} __g;\n  } else |__err| {\n    ${handler}\n  }\n}\n", "\\s+\\z", "");
    END
}
END
PRIVATE FN mIREmitter__emit_fallible_lock_error_handler(MUTABLE self: MIREmitter, action: FailureAction, retries: ?Int64, matched_types: []String@symbol, bubble_types: []String@symbol, rt_name: String, source_line: String) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE action_zig = TRY (mIREmitter__emit_failure_action(&rtoc_self_view, action));
    # `zig_name_of_type` / `kind_of_type` are nilable, and Ruby interpolates a
    # nil as the empty string. CLEAR rejects a `?String` in interpolation, so
    # the fallback has to be written out to keep the emitted text identical.
    MUTABLE arms: []String = List[];
    FOR matched_type IN matched_types DO
      MUTABLE matched_errs = "error.${(TRY (aST__zig_name_of_type(matched_type))) OR_ELSE ""}";
      MUTABLE body: String = COPY action_zig;
      IF retries EXISTS AS retries_value THEN
        body = "if (__retry + 1 < ${retries_value.toString()}) continue;\n${action_zig}";
      END
      &arms.append("${matched_errs} => { ${body} }");
    END
    FOR bubble_type IN bubble_types DO
      MUTABLE zig: String = (TRY (aST__zig_name_of_type(bubble_type))) OR_ELSE "";
      MUTABLE kind: String = CAST((TRY (aST__kind_of_type(bubble_type))) OR_ELSE symbol("") AS String);
      &arms.append("error.${zig} => { ${rt_name}.setError(.${kind}, @intFromEnum(ErrorName.${zig}), \"lock ${zig}\", ${source_line}); return error.CheatError; }");
    END
    RETURN "switch (__err) {\n${arms.join(",\n")}\n}";
}
END
PRIVATE FN mIREmitter__emit_sorted_lock_acquire(MUTABLE self: MIREmitter, node: SortedLockAcquire) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node.fallible THEN
      RETURN TRY (mIREmitter__emit_sorted_lock_acquire_fallible(&rtoc_self_view, node));
    ELSE
      RETURN TRY (mIREmitter__emit_sorted_lock_acquire_panic(&rtoc_self_view, node));
    END
}
END
PRIVATE FN mIREmitter__emit_sorted_lock_acquire_panic(MUTABLE self: MIREmitter, node: SortedLockAcquire) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE entries = COPY node.entries;
    MUTABLE n = entries.length();
    # `_.indexOf()` was a mistranslation of Ruby's `entry.index` field, and
    # `(0...n).to_a` has no CLEAR equivalent -- both are explicit loops here.
    MUTABLE guard_parts: []String = List[];
    MUTABLE ptr_parts: []String = List[];
    MUTABLE switch_parts: []String = List[];
    MUTABLE release_parts: []String = List[];
    MUTABLE alias_parts: []String = List[];
    FOR entry IN entries DO
      MUTABLE lock_zig = TRY (mIREmitter__emit(&rtoc_self_view, entry.lock_expr));
      &guard_parts.append("var ${entry.guard_var}: @TypeOf(${lock_zig}.${entry.method_name}()) = undefined;");
      &ptr_parts.append("@intFromPtr(${TRY (mIREmitter__emit(&rtoc_self_view, entry.address_expr))})");
      &switch_parts.append("${entry.index.toString()} => ${entry.guard_var} = ${lock_zig}.${entry.method_name}(),");
      &release_parts.append("defer ${entry.guard_var}.release();");
      &alias_parts.append("const ${entry.alias_name} = ${entry.guard_var}.get;\n_ = &${entry.alias_name};");
    END
    MUTABLE order_parts: []String = List[];
    MUTABLE order_index: Int64 = 0;
    WHILE (order_index < n) DO
      &order_parts.append(order_index.toString());
      order_index = (order_index + 1);
    END
    MUTABLE guard_decls = guard_parts.join("\n");
    MUTABLE ptr_init = ptr_parts.join(", ");
    MUTABLE order_init = order_parts.join(", ");
    MUTABLE switch_arms = switch_parts.join("\n                ");
    MUTABLE defer_releases = release_parts.join("\n");
    MUTABLE alias_decls = alias_parts.join("\n");
    RETURN regexReplaceAll__mir_emitter("${guard_decls}\n{\n    const __ptrs = [_]usize{ ${ptr_init} };\n    var __order = [_]u8{ ${order_init} };\n    var __i: usize = 0;\n    while (__i < ${n.toString()}) : (__i += 1) {\n        var __j: usize = 0;\n        while (__j + 1 < ${n.toString()}) : (__j += 1) {\n            if (__ptrs[__order[__j]] > __ptrs[__order[__j + 1]]) {\n                const __tmp = __order[__j];\n                __order[__j] = __order[__j + 1];\n                __order[__j + 1] = __tmp;\n            }\n        }\n    }\n    for (__order) |__idx| {\n        switch (__idx) {\n          ${switch_arms}\n          else => unreachable,\n        }\n    }\n}\n${defer_releases}\n${alias_decls}\n", "\\s+\\z", "");
}
END
PRIVATE FN mIREmitter__emit_sorted_lock_acquire_fallible(MUTABLE self: MIREmitter, node: SortedLockAcquire) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE entries = node.entries;
    MUTABLE n = entries.length();
    MUTABLE action: FailureAction = COPY castEmittableToFailureAction(node.action);
    # Same two mistranslations as the panic path: `_.indexOf()` for the
    # entry's `index` FIELD, and `(0...n).to_a` which CLEAR has no method for.
    MUTABLE guard_parts: []String = List[];
    MUTABLE held_parts: []String = List[];
    MUTABLE ptr_parts: []String = List[];
    MUTABLE acquire_parts: []String = List[];
    MUTABLE release_parts: []String = List[];
    FOR entry IN entries DO
      MUTABLE lock_expr: String = TRY (mIREmitter__emit(&rtoc_self_view, entry.lock_expr));
      &guard_parts.append("var ${entry.guard_var}: @TypeOf(try ${lock_expr}.${entry.method_name}()) = undefined;");
      &held_parts.append("var ${entry.held_var}: bool = false;");
      &ptr_parts.append("@intFromPtr(${TRY (mIREmitter__emit(&rtoc_self_view, entry.address_expr))})");
      &acquire_parts.append(regexReplaceAll__mir_emitter("${entry.index.toString()} => {\n                                if (${lock_expr}.${entry.method_name}()) |__g| {\n                                    ${entry.guard_var} = __g;\n                                    ${entry.held_var} = true;\n                                } else |__err_inner| {\n                                    __err_caught = __err_inner;\n                                    __success = false;\n                                }\n                            },\n", "\\s+\\z", ""));
      &release_parts.append("${entry.index.toString()} => if (${entry.held_var}) { ${entry.guard_var}.release(); ${entry.held_var} = false; },");
    END
    MUTABLE order_parts: []String = List[];
    MUTABLE order_index: Int64 = 0;
    WHILE (order_index < n) DO
      &order_parts.append(order_index.toString());
      order_index = (order_index + 1);
    END
    MUTABLE guard_decls = guard_parts.join("\n");
    MUTABLE held_decls = held_parts.join("\n");
    MUTABLE ptr_init = ptr_parts.join(", ");
    MUTABLE order_init = order_parts.join(", ");
    MUTABLE acquire_arms = acquire_parts.join("\n                                ");
    MUTABLE release_arms = release_parts.join("\n                            ");
    MUTABLE handler_switch = TRY (mIREmitter__emit_sorted_lock_handler_switch(&rtoc_self_view, action, node.matched_types, node.bubble_types, node.rt_name, CAST(node.source_line AS String)));
    MUTABLE retry_branch: String = "// no retries configured";
    IF node.retries EXISTS AS retries_value THEN
      retry_branch = "if (__retry + 1 < ${retries_value.toString()}) continue;";
    END
    MUTABLE defer_releases = (entries |> SELECT "defer if (${_.held_var}) ${_.guard_var}.release();").join("\n");
    MUTABLE alias_decls = (entries |> SELECT "const ${_.alias_name} = ${_.guard_var}.get;\n_ = &${_.alias_name};").join("\n");
    RETURN regexReplaceAll__mir_emitter("${guard_decls}\n${held_decls}\n${node.loop_label}: {\n    var __retry: usize = 0;\n    while (true) : (__retry += 1) {\n        const __ptrs = [_]usize{ ${ptr_init} };\n        var __order = [_]u8{ ${order_init} };\n        var __i: usize = 0;\n        while (__i < ${n.toString()}) : (__i += 1) {\n            var __j: usize = 0;\n            while (__j + 1 < ${n.toString()}) : (__j += 1) {\n                if (__ptrs[__order[__j]] > __ptrs[__order[__j + 1]]) {\n                    const __tmp = __order[__j];\n                    __order[__j] = __order[__j + 1];\n                    __order[__j + 1] = __tmp;\n                }\n            }\n        }\n        var __success = true;\n        var __err_caught: ?anyerror = null;\n        var __k: usize = 0;\n        while (__k < ${n.toString()}) : (__k += 1) {\n            const __idx = __order[__k];\n            switch (__idx) {\n                ${acquire_arms}\n                else => unreachable,\n            }\n            if (!__success) break;\n        }\n        if (__success) break :${node.loop_label};\n        var __r: usize = __k;\n        while (__r > 0) {\n            __r -= 1;\n            switch (__order[__r]) {\n                ${release_arms}\n                else => unreachable,\n            }\n        }\n        ${retry_branch}\n        ${handler_switch}\n        unreachable;\n    }\n}\n${defer_releases}\n${alias_decls}\n", "\\s+\\z", "");
}
END
PRIVATE FN mIREmitter__emit_sorted_lock_handler_switch(MUTABLE self: MIREmitter, action: FailureAction, matched: []String@symbol, bubble: []String@symbol, rt_name: String, source_line: String) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE handler_arms: []String = ( { MUTABLE rtoc_empty_list_34: []String = List[]; rtoc_empty_list_34 } );
    IF !((matched.length() == 0)) THEN
      # Same nilable-interpolation rule as the fallible-lock handler: Ruby
      # renders a nil name as the empty string, and CLEAR rejects `?String`.
      MUTABLE matched_parts: []String = List[];
      FOR matched_type IN matched DO
        &matched_parts.append("error.${(TRY (aST__zig_name_of_type(matched_type))) OR_ELSE ""}");
      END
      MUTABLE matched_errs = matched_parts.join(", ");
      &handler_arms.append("${matched_errs} => { ${TRY (mIREmitter__emit_failure_action(&rtoc_self_view, action))} }");
    END
    FOR bubble_type IN bubble DO
      MUTABLE zig: String = (TRY (aST__zig_name_of_type(bubble_type))) OR_ELSE "";
      MUTABLE kind: String = CAST((TRY (aST__kind_of_type(bubble_type))) OR_ELSE symbol("") AS String);
      &handler_arms.append("error.${zig} => { ${rt_name}.setError(.${kind}, @intFromEnum(ErrorName.${zig}), \"lock ${zig}\", ${source_line}); return error.CheatError; }");
    END
    &handler_arms.append("else => |__err_other| { ${rt_name}.setError(.System, 0, @errorName(__err_other), ${source_line}); return error.CheatError; }");
    RETURN "switch (__err_caught.?) {\n                    ${handler_arms.join(",\n                    ")},\n                }";
}
END
PRIVATE FN mIREmitter__emit_program(MUTABLE self: MIREmitter, node: MIRProgram) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    # `emit_container_item` returns `!String`, never nil, so Ruby's filter_map
    # is a plain map here; `SELECT:?` claimed an optional selector result.
    MUTABLE parts: []String = List[];
    FOR container_item IN node.items DO
      &parts.append(TRY (mIREmitter__emit_container_item(&rtoc_self_view, container_item)));
    END
    MUTABLE symbol_pool = mIREmitter__symbol_pool_declarations(rtoc_self_view);
    IF !((symbol_pool.length() == 0)) THEN
      parts = ([symbol_pool] + parts);
    END
    MUTABLE out: []String = List[];
    MUTABLE rtoc_idx: Int64 = 0;
    WHILE (rtoc_idx < parts.length()) DO
      MUTABLE part: String = COPY UNWRAP (parts[rtoc_idx]);
      IF (rtoc_idx == 0) THEN
        &out.append(COPY part);
      ELSE_IF (UNWRAP (parts[(rtoc_idx - 1)])).startsWith?("// CLR:") THEN
        &out.append("\n${part}");
      ELSE
        &out.append("\n\n${part}");
      END
      rtoc_idx = (rtoc_idx + 1);
    END
    RETURN out.join("");
}
END
FN mIREmitter__symbol_pool_declarations(self: MIREmitter) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE lines: []String = ( { MUTABLE rtoc_empty_list_35: []String = List[]; rtoc_empty_list_35 } );
    IF rtoc_self_view.uses_c_callback THEN
      &lines.append("// Runtime bridge for synchronous C callbacks.");
      &lines.append("threadlocal var __clear_c_callback_rt: ?*Runtime = null;");
    END
    IF !((rtoc_self_view.symbol_literals.count() == 0)) THEN
      &lines.append("// Static String@symbol literal pool.");
    END
    FOR rtoc_key IN rtoc_self_view.symbol_literals.keys() DO
    MUTABLE name: String = COPY UNWRAP (rtoc_self_view.symbol_literals[rtoc_key]);
    &lines.append("const ${name}: CheatLib.Symbol = .{ .bytes = ${mIREmitter__zig_byte_string_literal(rtoc_self_view, rtoc_key)} };");
    END
    RETURN lines.join("\n");
}
END
PRIVATE FN mIREmitter__emit_fn_def(MUTABLE self: MIREmitter, node: FnDef) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE vis: String = "";
    IF (node.visibility == :pub) THEN
      vis = "pub ";
    ELSE
      vis = "";
    END
    MUTABLE comptime = (node.comptime_params OR_ELSE List[]).join(", ");
    MUTABLE param_parts: []String = List[];
    FOR fn_param IN node.params DO
      &param_parts.append("${fn_param.name}: ${fn_param.zig_type}");
    END
    MUTABLE params = param_parts.join(", ");
    # `[comptime, params].reject(&:empty?)` bound `.join` to the WHERE
    # predicate instead of to the filtered list.
    MUTABLE all_param_parts: []String = List[];
    IF !(comptime.empty?()) THEN
      &all_param_parts.append(COPY comptime);
    END
    IF !(params.empty?()) THEN
      &all_param_parts.append(COPY params);
    END
    MUTABLE all_params = all_param_parts.join(", ");
    MUTABLE ret: String = "";
    IF node.can_fail THEN
      ret = "!${node.ret_type}";
    ELSE
      ret = node.ret_type;
    END
    MUTABLE runtime_param: ?MIRParam = node.params |> FIND (_.zig_type == "*Runtime");
    MUTABLE cache_name: ?String = NIL;
    IF runtime_param EXISTS THEN
      cache_name = mIREmitter__unique_heap_allocator_cache_name(rtoc_self_view);
    END
    # `runtime_param` is a FIND result, so every read of it needs the presence
    # it was found with; the translation dropped that on three of four reads.
    MUTABLE runtime_param_name: String = "";
    IF runtime_param EXISTS AS runtime_param_value THEN
      runtime_param_name = COPY runtime_param_value.name;
    END
    MUTABLE body = mIREmitter__with_heap_allocator_cache(&rtoc_self_view, cache_name, runtime_param?.name, %() USE(node, runtime_param, runtime_param_name, MUTABLE rtoc_self_view) -> {
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE rtoc_body_text: String = "";
    IF (runtime_param != NIL) THEN
      rtoc_body_text = TRY (mIREmitter__emit_body_with_runtime(&rtoc_self_view, node.body, runtime_param_name));
    ELSE
      rtoc_body_text = TRY (mIREmitter__emit_body(&rtoc_self_view, node.body));
    END
    rtoc_body_text
    });
    IF ((cache_name != NIL) AND body.contains?(cache_name)) THEN
      MUTABLE cache_init = "const ${cache_name} = ${runtime_param_name}.heapAlloc(); _ = &${cache_name};";
      body = mIREmitterJoinNonEmpty([cache_init, body], "\n");
    END
    RETURN "${vis}fn ${node.name}(${all_params}) ${ret} {\n${body}\n}";
}
END
PRIVATE FN mIREmitter__emit_struct_def(MUTABLE self: MIREmitter, node: MIRStructDef) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE vis: String = "";
    IF (node.visibility == :pub) THEN
      vis = "pub ";
    ELSE
      vis = "";
    END
    # `f.zig_type` is the FieldDef's own field; `TRY (type__zig_type(_))` asked the
    # Type module to render the FieldDef itself.
    MUTABLE field_parts: []String = List[];
    FOR field IN node.fields DO
      MUTABLE default: String = "";
      IF field.default EXISTS AS default_value THEN
        default = " = ${TRY (mIREmitter__emit(&rtoc_self_view, default_value))}";
      END
      &field_parts.append("${mIREmitter__zig_field_name(rtoc_self_view, Name{ StringValue: COPY field.name })}: ${field.zig_type}${default},");
    END
    MUTABLE fields = field_parts.join("\n    ");
    MUTABLE method_parts: []String = List[];
    FOR method IN (node.methods OR_ELSE List[]) DO
      &method_parts.append(TRY (mIREmitter__emit(&rtoc_self_view, method)));
    END
    MUTABLE methods = method_parts.join("\n\n    ");
    MUTABLE parts = mIREmitterJoinNonEmpty([fields, methods], "\n\n    ");
    IF node.name EXISTS AS struct_name THEN
      RETURN "${vis}const ${struct_name} = struct {\n    ${parts}\n};";
    END
    RETURN "struct {\n    ${parts}\n    }";
}
END
PRIVATE FN mIREmitter__emit_enum_def(self: MIREmitter, node: MIREnumDef) RETURNS String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE vis: String = "";
    IF (node.visibility == :pub) THEN
      vis = "pub ";
    ELSE
      vis = "";
    END
    MUTABLE variants = node.variants.join(", ");
    RETURN "${vis}const ${node.name} = enum { ${variants} };";
}
END
PRIVATE FN mIREmitter__emit_union_def(MUTABLE self: MIREmitter, node: UnionTypeDef) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE vis: String = "";
    IF (node.visibility == :pub) THEN
      vis = "pub ";
    ELSE
      vis = "";
    END
    MUTABLE variant_parts: []String = List[];
    FOR variant IN node.variants DO
      &variant_parts.append("${CAST(variant.name AS String)}: ${variant.zig_type},");
    END
    MUTABLE fields = variant_parts.join("\n    ");
    MUTABLE method_parts: []String = List[];
    FOR method IN (node.methods OR_ELSE List[]) DO
      &method_parts.append(TRY (mIREmitter__emit(&rtoc_self_view, method)));
    END
    MUTABLE methods = method_parts.join("\n\n    ");
    MUTABLE parts = mIREmitterJoinNonEmpty([fields, methods], "\n\n    ");
    IF node.name EXISTS AS union_name THEN
      RETURN "${vis}const ${union_name} = union(enum) {\n    ${parts}\n};";
    END
    RETURN "union(enum) {\n    ${parts}\n    }";
}
END
PRIVATE FN mIREmitter__emit_import(self: MIREmitter, node: Import) RETURNS String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE base = "@import(\"${node.module_path}\")";
    IF node.member THEN
      base = "${base}.${UNWRAP (node.member)}";
    END
    RETURN "const ${node.alias_name} = ${base};";
}
END
PRIVATE FN mIREmitter__emit_type_alias(self: MIREmitter, node: TypeAlias) RETURNS String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN "pub const ${node.name} = ${node.target};\ncomptime { _ = @typeName(${node.name}); }";
}
END
PRIVATE FN mIREmitter__emit_c_extern_fn_decl(self: MIREmitter, node: CExternFnDecl) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    # `param.zig_type` is the param's own field; `TRY (type__zig_type(_))` asked the
    # Type module to render the param itself.
    MUTABLE extern_param_parts: []String = List[];
    FOR extern_param IN node.params DO
      &extern_param_parts.append("${extern_param.name}: ${extern_param.zig_type}");
    END
    MUTABLE params = extern_param_parts.join(", ");
    # Ruby's `node.library == "c" ? "c" : node.library` on a nilable library
    # yields nil for the else, which interpolates as the empty string.
    MUTABLE library: String = (node.library OR_ELSE "");
    MUTABLE callconv = PARTIAL MATCH node.callconv START
      :system -> ".c",
      :winapi -> ".winapi",
      DEFAULT -> ".c"
    END;
    RETURN "extern \"${library}\" fn ${node.name}(${params}) callconv(${callconv}) ${node.return_type};";
}
END
PRIVATE FN mIREmitter__emit_c_extern_struct_def(self: MIREmitter, node: CExternStructDef) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE extern_field_parts: []String = List[];
    FOR extern_field IN node.fields DO
      &extern_field_parts.append("${extern_field.name}: ${extern_field.zig_type}");
    END
    MUTABLE fields = extern_field_parts.join(", ");
    RETURN "const ${node.name} = extern struct { ${fields} };";
}
END
PRIVATE FN mIREmitter__emit_module_namespace(MUTABLE self: MIREmitter, node: ModuleNamespace) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    # `emit_container_item` returns `!String`, never nil: filter_map is a map.
    MUTABLE namespace_parts: []String = List[];
    FOR namespace_item IN node.items DO
      &namespace_parts.append(TRY (mIREmitter__emit_container_item(&rtoc_self_view, namespace_item)));
    END
    MUTABLE body = namespace_parts.join("\n");
    RETURN "const ${node.name} = struct {\n${mIREmitter__indent_block(rtoc_self_view, body, 4)}\n};";
}
END
PRIVATE FN mIREmitter__emit_container_item(MUTABLE self: MIREmitter, node: Emittable) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node IS_A Let AS let THEN
      MUTABLE let_mutable = COPY let;
      RETURN TRY (mIREmitter__emit_let(&rtoc_self_view, let_mutable, FALSE));
    END
    RETURN TRY (mIREmitter__emit(&rtoc_self_view, node));
}
END
PRIVATE FN mIREmitter__emit_test_def(MUTABLE self: MIREmitter, node: TestDef) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node.needs_scheduler EXISTS AS needs_scheduler_value THEN
      MUTABLE needs_scheduler_value_mutable = COPY needs_scheduler_value;
      RETURN TRY (mIREmitter__emit_scheduler_test_def(&rtoc_self_view, node));
    END
    MUTABLE body = TRY (mIREmitter__emit_body(&rtoc_self_view, node.body));
    RETURN "test \"${node.name}\" {\n${body}\n}";
}
END
PRIVATE FN mIREmitter__emit_scheduler_test_def(MUTABLE self: MIREmitter, node: TestDef) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE stmts = node.body |> WHERE !(_ IS_A TestPreamble);
    MUTABLE body = TRY (mIREmitter__emit_body(&rtoc_self_view, stmts));
    RETURN "test \"${node.name}\" {\nvar da = std.heap.DebugAllocator(.{}){};\n    defer _ = da.deinit();\n    const allocator = da.allocator;\n    var global_ctx = EbrContext{};\n    defer global_ctx.deinit(allocator);\n    const fp = @import(\"runtime/scheduler.zig\");\n    var sched = try fp.Scheduler.init(allocator, &global_ctx, null);\n    defer {\n        fp.scheduler_running = false;\n        sched.deinit();\n        fp.global_registry.deinit(allocator);\n    }\n    fp.active_scheduler = &sched;\n    fp.scheduler_running = true;\n    const __TestBody = struct {\n        fn run(raw_rt: *anyopaque, raw_args: ?*anyopaque) anyerror!void {\n            _ = raw_args;\n            const rt = @as(*Runtime, @ptrCast(@alignCast(raw_rt)));\n            _ = &rt;\n${body}\n        }\n    };\n    try sched.submitSpawn(\n        @intFromPtr(&Runtime.entryWrapper),\n        @as(CheatHeader.TaskFn, @ptrCast(&__TestBody.run)),\n        null,\n        .{ .stack_size = .Large },\n    );\n    sched.run();\n}\n".trim();
}
END
PRIVATE FN mIREmitter__emit_let(MUTABLE self: MIREmitter, node: Let, include_suppression: Bool = TRUE) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    # `init` holds emitted Zig text; inferring it from a NIL seed made every
    # interpolation of it a NIL operand.
    MUTABLE init: String = "";
    MUTABLE kw: String = "";
    MUTABLE sup: String = "";
    IF node.init IS_A FreezeExpr THEN
      MUTABLE buf = "${node.name}__buf";
      IF node.mutable THEN
        kw = "var";
      ELSE
        kw = "const";
      END
      IF (include_suppression AND (node.suppression != NIL)) THEN
        sup = " ${(node.suppression OR_ELSE "")}";
      ELSE
        sup = "";
      END
      RETURN "const ${buf} = ${TRY (mIREmitter__emit(&rtoc_self_view, node.init))};\n${kw} ${node.name} = ${buf}._root;${sup}";
    END
    IF node.mutable THEN
      kw = "var";
    ELSE
      kw = "const";
    END
    MUTABLE ann: String = "";
    IF node.annotation EXISTS AS annotation_value THEN
      ann = ": ${TRY (type__nested_zig_type(annotation_value))}";
    ELSE
      ann = "";
    END
    IF node.module_const EXISTS AS module_const_value THEN
      MUTABLE module_const_value_mutable = COPY module_const_value;
      init = mIREmitter__with_ident_overrides(&rtoc_self_view, {"rt": "undefined"}, %() USE(node, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_36 = TRY (mIREmitter__emit(&rtoc_self_view, node.init));
    rtoc_lambda_result_36
      });
      MUTABLE vis: String = "";
      IF (node.const_visibility == :pub) THEN
        vis = "pub ";
      ELSE
        vis = "";
      END
      RETURN "${vis}const ${node.name}${ann} = ${init};";
    END
    init = TRY (mIREmitter__emit(&rtoc_self_view, node.init));
    IF (include_suppression AND (node.suppression != NIL)) THEN
      sup = " ${(node.suppression OR_ELSE "")}";
    ELSE
      sup = "";
    END
    RETURN "${kw} ${node.name}${ann} = ${init};${sup}";
}
END
PRIVATE FN mIREmitter__emit_set(MUTABLE self: MIREmitter, node: Set) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN "${TRY (mIREmitter__emit(&rtoc_self_view, node.target))} = ${TRY (mIREmitter__emit(&rtoc_self_view, node.value))};";
}
END
PRIVATE FN mIREmitter__emit_destructure_set(MUTABLE self: MIREmitter, node: DestructureSet) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE targets = (node.targets |> SELECT TRY (mIREmitter__emit(&rtoc_self_view, _))).join(", ");
    # The predicate reads MIRDestructureTarget's OWN fields, so the variant has
    # to be matched out of the union first -- `_.declaration_kind()` asked the
    # union for a method it does not have.
    MUTABLE suppression_parts: []String = List[];
    FOR destructure_target IN node.targets DO
      PARTIAL MATCH destructure_target START
        Emittable.MIRDestructureTarget AS target_value ->
          IF ((target_value.declaration_kind == :var) AND (target_value.name != "_")) THEN
            &suppression_parts.append(" _ = &${target_value.name};");
          END,
      END
    END
    MUTABLE suppressions = suppression_parts.join("");
    RETURN "${targets} = ${TRY (mIREmitter__emit(&rtoc_self_view, node.value))};${suppressions}";
}
END
PRIVATE FN mIREmitter__emit_destructure_target(self: MIREmitter, node: MIRDestructureTarget) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (CAST(node.name AS String) == "_") THEN
      RETURN COPY "_";
    END
    MUTABLE annotation: String = "";
    IF node.annotation THEN
      annotation = ": ${TRY (type__zig_type(CAST(node.annotation AS Type)))}";
    ELSE
      annotation = "";
    END
    IF (node.declaration_kind == :const) OR (node.declaration_kind == :var) THEN
      RETURN COPY "${UNWRAP (node.declaration_kind)} ${node.name}${annotation}";
    ELSE
      RETURN COPY CAST(node.name AS String);
    END
}
END
PRIVATE FN mIREmitter__zig_bare_name(self: MIREmitter, name: Name) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE text = COPY CAST(name AS String);
    IF (text.startsWith?("@\"") AND text.endsWith?("\"")) THEN
      RETURN COPY text.substr(2, (((text.length() - 2) - 2) + 1));
    ELSE
      RETURN text;
    END
}
END
PRIVATE FN mIREmitter__move_guard_name(self: MIREmitter, name: Name) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN "${mIREmitter__zig_bare_name(rtoc_self_view, name)}_moved";
}
END
PRIVATE FN mIREmitter__emit_struct_init_field_value(MUTABLE self: MIREmitter, value: Emittable) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    # `T IS_A MIRCast` tested the TYPE PARAMETER, not the value, and then read
    # MIRCast's fields off the generic. The union match is the whole test.
    PARTIAL MATCH value START
      Emittable.MIRCast AS cast_value ->
        IF (cast_value.method == :as) THEN
          PARTIAL MATCH cast_value.expr START
            Emittable.Lit AS lit_value ->
              IF (lit_value.value == "null") THEN
                RETURN "null";
              END,
          END
        END,
    END
    RETURN TRY (mIREmitter__emit(&rtoc_self_view, value));
}
END
PRIVATE FN mIREmitter__zig_field_name(self: MIREmitter, name: Name) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE text = COPY CAST(name AS String);
    IF text.startsWith?("@\"") THEN
      RETURN text;
    END
    IF zigType__reserved_identifier?(text) THEN
      RETURN "@\"${text}\"";
    ELSE
      RETURN text;
    END
}
END
PRIVATE FN mIREmitter__emit_reassign_cleanup(MUTABLE self: MIREmitter, node: ReassignWithCleanup) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE alloc: String = "";
    # `val` only ever holds emitted text; the optional seed made every
    # interpolation of it a ?String operand.
    MUTABLE val: String = "";
    MUTABLE base = mIREmitter__zig_bare_name(rtoc_self_view, Name{ StringValue: COPY node.name });
    MUTABLE try_expr: ?Emittable = mIREmitter__reassign_success_only_expr(rtoc_self_view, node);
    IF try_expr EXISTS AS try_expr_value THEN
      MUTABLE opt = "__new_${base}_opt";
      val = "__new_${base}_val";
      alloc = TRY (mIREmitter__alloc_zig(rtoc_self_view, node.alloc));
      RETURN (["{", "const ${opt}: ?${node.zig_type} = (${TRY (mIREmitter__emit(&rtoc_self_view, try_expr_value))} catch null);", "if (${opt}) |${val}| {", "    CheatLib.cleanup(@TypeOf(${node.name}), ${alloc}, &${node.name});", "    ${node.name} = ${val};", "}", "}"]).join("\n");
    END
    MUTABLE tmp = "__new_${base}";
    val = TRY (mIREmitter__emit(&rtoc_self_view, node.value));
    alloc = TRY (mIREmitter__alloc_zig(rtoc_self_view, node.alloc));
    RETURN "{\nconst ${tmp} = ${val};\nCheatLib.cleanup(@TypeOf(${node.name}), ${alloc}, &${node.name});\n${node.name} = ${tmp};\n}";
}
END
PRIVATE FN mIREmitter__reassign_success_only_expr(self: MIREmitter, node: ReassignWithCleanup) RETURNS ?Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE value = COPY node.value;
    IF value IS_A MIRCast AS mir_cast THEN
      MUTABLE mir_cast = cast__expr(mir_cast);
    END
    IF value IS_A TryCatch AS try_catch THEN
      IF !((try_catch.capture == NIL)) THEN
        RETURN NIL;
      END
      MUTABLE catch_body = try_catch.catch_body;
      IF catch_body IS_A Ident AS ident THEN
        IF !((ident.name == CAST(node.name AS String))) THEN
          RETURN NIL;
        END
        RETURN COPY tryCatch__expr(try_catch);
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN mIREmitter__emit_if_stmt(MUTABLE self: MIREmitter, node: IfStmt) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE cond: String = TRY (mIREmitter__emit(&rtoc_self_view, node.cond));
    IF (node.comptime OR_ELSE FALSE) THEN
      cond = "comptime ${cond}";
    END
    MUTABLE then_body = TRY (mIREmitter__emit_body(&rtoc_self_view, node.then_body));
    MUTABLE result = "if (${cond}) {\n${then_body}\n}";
    MUTABLE else_stmts: []Emittable = (node.else_body OR_ELSE List[]);
    IF !(else_stmts.empty?()) THEN
      MUTABLE else_body = TRY (mIREmitter__emit_body(&rtoc_self_view, else_stmts));
      result = (result $+ " else {\n${else_body}\n}");
    END
    RETURN result;
}
END
PRIVATE FN mIREmitter__emit_if_bind_stmt(MUTABLE self: MIREmitter, node: IfBindStmt) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE result: String = "";
    MUTABLE then_body = TRY (mIREmitter__emit_body(&rtoc_self_view, node.then_body));
    MUTABLE else_stmts: []Emittable = (node.else_body OR_ELSE List[]);
    MUTABLE else_body: ?String = NIL;
    IF !(else_stmts.empty?()) THEN
      else_body = TRY (mIREmitter__emit_body(&rtoc_self_view, else_stmts));
    END
    IF (node.bindings.length() == 1) THEN
      MUTABLE b: MIRIfBinding = COPY UNWRAP (node.bindings[0]);
      MUTABLE expr: String = TRY (mIREmitter__emit(&rtoc_self_view, b.expr));
      MUTABLE suppress: String = "";
      IF (CAST(b.capture AS String) == "_") THEN
        suppress = "";
      ELSE
        suppress = "_ = &${CAST(b.capture AS String)};\n";
      END
      IF b.node_ref THEN
        result = "{\nconst ${CAST(b.capture AS String)} = ${expr};\n";
        result = (result $+ "if (!${CAST(b.capture AS String)}.isNil()) {\n${suppress}${then_body}\n}");
        IF else_body EXISTS AS else_body_value THEN
          result = (result $+ " else {\n${else_body_value}\n}");
        END
        result = (result $+ "\n}");
      ELSE_IF (b.predicate == :stream_item) THEN
        IF else_body EXISTS AS else_body_value THEN
          result = "switch (${expr}) {\n.Item => |${CAST(b.capture AS String)}| {\n${suppress}${then_body}\n},\n.Closed => {\n${else_body_value}\n},\n}";
        END
        IF result.empty?() THEN
          result = "switch (${expr}) {\n.Item => |${CAST(b.capture AS String)}| {\n${suppress}${then_body}\n},\n.Closed => {},\n}";
        END
      ELSE_IF (b.predicate == :is_ok) THEN
        result = "if (${expr}) |${CAST(b.capture AS String)}| {\n${suppress}${then_body}\n}";
        IF else_body EXISTS AS else_body_value THEN
          result = (result $+ " else |_| {\n${else_body_value}\n}");
        END
        IF !(else_body) THEN
          result = (result $+ " else |_| {}");
        END
      ELSE
        MUTABLE capture: String = "";
        IF b.pointer_capture THEN
          capture = "*${CAST(b.capture AS String)}";
        ELSE
          capture = CAST(b.capture AS String);
        END
        result = "if (${expr}) |${capture}| {\n${suppress}${then_body}\n}";
        IF else_body EXISTS AS else_body_value THEN
          result = (result $+ " else {\n${else_body_value}\n}");
        END
      END
      RETURN result;
    ELSE
      rtoc_self_view.if_bind_counter = (((rtoc_self_view.if_bind_counter OR_ELSE 0)) + 1);
      MUTABLE label = "__ib_${UNWRAP (rtoc_self_view.if_bind_counter).toString()}";
      MUTABLE ok_var = "__ib_ok_${UNWRAP (rtoc_self_view.if_bind_counter).toString()}";
      # Same `b[:field]` hash syntax as the single-binding path, on what is a
      # struct; an explicit loop also keeps the emit fallible.
      MUTABLE inner_parts: []String = List[];
      FOR binding IN node.bindings DO
        MUTABLE binding_capture: String = CAST(binding.capture AS String);
        MUTABLE binding_expr: String = TRY (mIREmitter__emit(&rtoc_self_view, binding.expr));
        IF (binding.node_ref OR_ELSE FALSE) THEN
          &inner_parts.append("const ${binding_capture} = ${binding_expr}; if (${binding_capture}.isNil()) break :${label};");
        ELSE_IF (binding.predicate == :stream_item) THEN
          &inner_parts.append("const ${binding_capture} = switch (${binding_expr}) { .Item => |payload| payload, .Closed => break :${label} };");
        ELSE_IF (binding.predicate == :is_ok) THEN
          &inner_parts.append("const ${binding_capture} = ${binding_expr} catch break :${label};");
        ELSE
          &inner_parts.append("const ${binding_capture} = ${binding_expr} orelse break :${label};");
        END
      END
      MUTABLE inner = inner_parts.join("\n");
      result = "var ${ok_var}: bool = false;\n";
      result = (result $+ "${label}: {\n${inner}\n${then_body}\n${ok_var} = true;\n}");
      IF else_body EXISTS AS else_body_value THEN
        result = (result $+ "\nif (!${ok_var}) {\n${else_body_value}\n}");
      END
      RETURN result;
    END
}
END
PRIVATE FN mIREmitter__emit_while(MUTABLE self: MIREmitter, node: WhileStmt) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE cond: String = TRY (mIREmitter__emit(&rtoc_self_view, node.cond));
    MUTABLE cap: String = "";
    IF node.capture THEN
      cap = " |${(node.capture OR_ELSE "")}|";
    ELSE
      cap = "";
    END
    MUTABLE upd: String = "";
    IF node.update THEN
      MUTABLE update_code = compilerStringChomp(TRY (mIREmitter__emit(&rtoc_self_view, node.update)), ";");
      upd = " : (${update_code})";
    ELSE
      upd = "";
    END
    MUTABLE body = TRY (mIREmitter__emit_body(&rtoc_self_view, node.body));
    MUTABLE capture_suppress: String = "";
    IF (node.capture AND (CAST(node.capture AS String) != "_")) THEN
      capture_suppress = "_ = &${(node.capture OR_ELSE "")};\n";
    ELSE
      capture_suppress = "";
    END
    RETURN "while (${cond})${upd}${cap} {\n${capture_suppress}${body}\n}";
}
END
PRIVATE FN mIREmitter__emit_for(MUTABLE self: MIREmitter, node: ForStmt) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE iter: String = TRY (mIREmitter__emit(&rtoc_self_view, node.iter));
    # Ruby's `.compact` before the join: both captures are optional and an
    # absent one contributes nothing rather than an empty slot.
    MUTABLE capture_parts: []String = List[];
    IF node.capture EXISTS AS for_capture THEN
      &capture_parts.append(COPY for_capture);
    END
    IF node.index_capture EXISTS AS for_index_capture THEN
      &capture_parts.append(COPY for_index_capture);
    END
    MUTABLE captures = capture_parts.join(", ");
    MUTABLE body = TRY (mIREmitter__emit_body(&rtoc_self_view, node.body));
    IF mIREmitter__i64_range_capture_cast_required?(rtoc_self_view, node) THEN
      MUTABLE raw_capture = "__${(node.capture OR_ELSE "")}_usize";
      RETURN "for (${iter}) |${raw_capture}| {\nconst ${(node.capture OR_ELSE "")}: i64 = @intCast(${raw_capture});\n${body}\n}";
    END
    RETURN "for (${iter}) |${captures}| {\n${body}\n}";
}
END
PRIVATE FN mIREmitter__i64_range_capture_cast_required?(self: MIREmitter, node: ForStmt) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE iter = COPY node.iter;
    # Ruby's `node.capture.is_a?(String)` is a presence test on a nilable
    # field, not a union test -- CLEAR spells that EXISTS.
    IF iter IS_A IterRange AS iter_range THEN
      IF ((iter_range.capture_type == :i64) AND (node.index_capture == NIL)) THEN
        IF node.capture EXISTS AS for_capture_value THEN
          RETURN !(for_capture_value.startsWith?("*"));
        END
      END
    END
    RETURN FALSE;
}
END
PRIVATE FN mIREmitter__emit_switch(MUTABLE self: MIREmitter, node: SwitchStmt) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE subject: String = TRY (mIREmitter__emit(&rtoc_self_view, node.subject));
    MUTABLE arms = node.arms |> SELECT {
    MUTABLE body = TRY (mIREmitter__emit_body(&rtoc_self_view, _.body));
    "${TRY (mIREmitter__emit_switch_patterns(&rtoc_self_view, _.patterns))} => {\n${body}\n}"
    };
    IF node.default_body EXISTS AS default_body THEN
      MUTABLE body: String = "";
      IF !(default_body.empty?()) THEN
        body = TRY (mIREmitter__emit_body(&rtoc_self_view, default_body));
      END
      &arms.append("else => {\n${body}\n}");
    END
    RETURN "switch (${subject}) {\n    ${arms.join(",\n    ")},\n}";
}
END
PRIVATE FN mIREmitter__emit_switch_patterns(MUTABLE self: MIREmitter, patterns: []SwitchPattern) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN (patterns |> SELECT TRY (mIREmitter__emit_switch_pattern(&rtoc_self_view, _))).join(", ");
}
END
PRIVATE FN mIREmitter__emit_switch_pattern(MUTABLE self: MIREmitter, pattern: SwitchPattern) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    # SwitchPattern is its own union; `emit` takes an Emittable, so the other
    # arm has to be unwrapped rather than passed through as the union.
    PARTIAL MATCH pattern START
      SwitchPattern.EnumSwitchPattern AS enum_switch_pattern ->
        RETURN ".${enum_switch_pattern.variant}";,
      SwitchPattern.Emittable AS emittable_pattern ->
        RETURN TRY (mIREmitter__emit(&rtoc_self_view, emittable_pattern));,
    END
    RETURN "";
}
END
PRIVATE FN mIREmitter__emit_catch_wrapper(MUTABLE self: MIREmitter, node: CatchWrapper) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE inner_call = TRY (mIREmitter__emit(&rtoc_self_view, node.inner_call));
    IF node.clauses.empty?() THEN
      RETURN "return ${inner_call} catch {\n${mIREmitter__indent_block(rtoc_self_view, TRY (mIREmitter__emit_catch_default_body(&rtoc_self_view, node)), 4)}\n};";
    END
    MUTABLE clauses = COPY node.clauses;
    MUTABLE branch_parts: []String = List[];
    MUTABLE clause_index: Int64 = 0;
    WHILE (clause_index < clauses.length()) DO
      MUTABLE clause: MIRCatchClause = COPY UNWRAP (clauses[clause_index]);
      &branch_parts.append(TRY (mIREmitter__emit_catch_clause(&rtoc_self_view, clause, node.rt_name, node.snapshot_type, (clause_index == 0))));
      clause_index = (clause_index + 1);
    END
    &branch_parts.append(TRY (mIREmitter__emit_catch_default(&rtoc_self_view, node)));
    MUTABLE branch_chain = branch_parts.join(" else ");
    RETURN "return ${inner_call} catch {\n${mIREmitter__indent_block(rtoc_self_view, branch_chain, 4)}\n};";
}
END
PRIVATE FN mIREmitter__emit_catch_clause(MUTABLE self: MIREmitter, clause: MIRCatchClause, rt_name: String, snapshot_type: ?Type, first_clause: Bool) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE body = TRY (mIREmitter__emit_catch_body(&rtoc_self_view, rt_name, clause.body, snapshot_type));
    RETURN "if (${TRY (mIREmitter__emit_catch_condition(&rtoc_self_view, clause.meta, rt_name))}) {\n${mIREmitter__indent_block(rtoc_self_view, body, 8)}\n}";
}
END
PRIVATE FN mIREmitter__emit_catch_default(MUTABLE self: MIREmitter, node: CatchWrapper) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN "{\n${mIREmitter__indent_block(rtoc_self_view, TRY (mIREmitter__emit_catch_default_body(&rtoc_self_view, node)), 8)}\n}";
}
END
PRIVATE FN mIREmitter__emit_catch_default_body(MUTABLE self: MIREmitter, node: CatchWrapper) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE action: CatchDefaultAction = COPY CAST(node.default_action AS CatchDefaultAction);
    IF (action == CatchDefaultAction.Body) THEN
      RETURN TRY (mIREmitter__emit_catch_body(&rtoc_self_view, node.rt_name, (node.default_body OR_ELSE List[]), NIL));
    ELSE_IF (action == CatchDefaultAction.Propagate) THEN
      RETURN "${node.rt_name}.freeSnapshot();\nreturn error.CheatError;";
    ELSE_IF (action == CatchDefaultAction.Unreachable) THEN
      RETURN "${node.rt_name}.freeSnapshot();\nunreachable;";
    ELSE
      RETURN panic("unreachable: exhaustive union match");
    END
}
END
PRIVATE FN mIREmitter__emit_catch_body(MUTABLE self: MIREmitter, rt_name: String, body: []Emittable, snapshot_type: ?Type) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE parts: []String = ( { MUTABLE rtoc_empty_list_37: []String = List[]; rtoc_empty_list_37 } );
    MUTABLE snapshot_decl = TRY (mIREmitter__emit_catch_snapshot_decl(rtoc_self_view, rt_name, snapshot_type));
    IF !((snapshot_decl.length() == 0)) THEN
      &parts.append(snapshot_decl);
    END
    &parts.append("const __error = ${rt_name}.__error;");
    &parts.append("_ = &__error;");
    &parts.append("defer ${rt_name}.freeSnapshot();");
    MUTABLE emitted_body = TRY (mIREmitter__emit_body(&rtoc_self_view, body));
    IF !((emitted_body.length() == 0)) THEN
      &parts.append(emitted_body);
    END
    RETURN parts.join("\n");
}
END
PRIVATE FN mIREmitter__emit_catch_snapshot_decl(self: MIREmitter, rt_name: String, snapshot_type: ?Type) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF snapshot_type EXISTS AS snapshot_type_value THEN
      MUTABLE snap_zig = TRY (type__zig_type(snapshot_type_value));
      RETURN (["const __snap_ptr = ${rt_name}.__error.snapshotAs(${snap_zig});", "const snapshot = if (__snap_ptr) |p| p.* else undefined;", "const __has_snapshot = __snap_ptr != null;", "_ = &snapshot; _ = &__has_snapshot;"]).join("\n");
    ELSE
      RETURN "";
    END
}
END
PRIVATE FN mIREmitter__emit_catch_condition(MUTABLE self: MIREmitter, meta: CatchClauseMeta, rt_name: String) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE item_checks: []String = ( { MUTABLE rtoc_empty_list_38: []String = List[]; rtoc_empty_list_38 } );
    FOR _ IN meta.kinds DO
    &item_checks.append("${rt_name}.__error.matchesKind(.${_})");
    END
    FOR _ IN meta.types DO
    &item_checks.append("${rt_name}.__error.matchesName(@intFromEnum(ErrorName.${_}))");
    END
    MUTABLE item_cond = mIREmitter__emit_catch_condition_group(rtoc_self_view, item_checks, "true");
    MUTABLE filter_checks: []String = ( { MUTABLE rtoc_empty_list_39: []String = List[]; rtoc_empty_list_39 } );
    FOR _ IN meta.filter_types DO
    &filter_checks.append("${rt_name}.__error.matchesName(@intFromEnum(ErrorName.${_}))");
    END
    FOR _ IN meta.filter_messages DO
    &filter_checks.append("${rt_name}.__error.matchesMessage(${TRY (mIREmitter__emit(&rtoc_self_view, _))})");
    END
    IF (filter_checks.length() == 0) THEN
      RETURN item_cond;
    END
    MUTABLE filter_cond = mIREmitter__emit_catch_condition_group(rtoc_self_view, filter_checks, "true");
    RETURN "${item_cond} and ${filter_cond}";
}
END
PRIVATE FN mIREmitter__emit_catch_condition_group(self: MIREmitter, checks: []String, default_value: String) RETURNS String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (checks.length() == 0) THEN
      RETURN COPY default_value;
    END
    IF (checks.length() == 1) THEN
      RETURN COPY UNWRAP (checks.first());
    END
    RETURN "(${checks.join(" or ")})";
}
END
PRIVATE FN mIREmitter__emit_union_match(MUTABLE self: MIREmitter, node: UnionMatchStmt) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE subject: String = TRY (mIREmitter__emit(&rtoc_self_view, node.subject));
    MUTABLE arms = node.arms |> SELECT {
    MUTABLE body = TRY (mIREmitter__emit_body(&rtoc_self_view, _.body));
    # Ruby writes all three of these off one nilable payload; CLEAR wants the
    # presence bound once, and an absent payload contributes nothing.
    MUTABLE capture: String = "";
    MUTABLE suppress: String = "";
    IF _.payload EXISTS AS payload_value THEN
      MUTABLE capture_name: String = COPY payload_value;
      IF _.pointer_payload THEN
        capture_name = "*${payload_value}";
      END
      capture = " |${capture_name}|";
      suppress = "_ = &${payload_value};\n";
    END
    ".${_.variant} =>${capture} {\n${suppress}${body}\n}"
    };
    IF node.default_body EXISTS AS default_body THEN
      MUTABLE body: String = "";
      IF !(default_body.empty?()) THEN
        body = TRY (mIREmitter__emit_body(&rtoc_self_view, default_body));
      END
      &arms.append("else => {\n${body}\n}");
    END
    RETURN "switch (${subject}) {\n    ${arms.join(",\n    ")},\n}";
}
END
PRIVATE FN mIREmitter__emit_if_chain(MUTABLE self: MIREmitter, node: IfChain) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE parts = node.branches |> SELECT {
    MUTABLE cond: String = TRY (mIREmitter__emit(&rtoc_self_view, _.cond));
    MUTABLE body = TRY (mIREmitter__emit_body(&rtoc_self_view, _.body));
    "if (${cond}) {\n${body}\n}"
    };
    MUTABLE result = parts.join(" else ");
    MUTABLE default_body: []Emittable = (node.default_body OR_ELSE List[]);
    IF !(default_body.empty?()) THEN
      MUTABLE body = TRY (mIREmitter__emit_body(&rtoc_self_view, default_body));
      result = (result $+ " else {\n${body}\n}");
    END
    RETURN result;
}
END
PRIVATE FN mIREmitter__emit_return(MUTABLE self: MIREmitter, node: ReturnStmt) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node.value THEN
      RETURN "return ${TRY (mIREmitter__emit(&rtoc_self_view, node.value))};";
    ELSE
      RETURN "return;";
    END
}
END
PRIVATE FN mIREmitter__emit_break(MUTABLE self: MIREmitter, node: BreakStmt) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE parts = ["break"];
    IF node.label THEN
      &parts.append(":${(node.label OR_ELSE "")}");
    END
    IF node.value THEN
      &parts.append(TRY (mIREmitter__emit(&rtoc_self_view, node.value)));
    END
    RETURN "${parts.join(" ")};";
}
END
PRIVATE FN mIREmitter__emit_break_expr(MUTABLE self: MIREmitter, node: BreakExpr) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE parts = ["break"];
    IF node.label THEN
      &parts.append(":${(node.label OR_ELSE "")}");
    END
    IF node.value THEN
      &parts.append(TRY (mIREmitter__emit(&rtoc_self_view, node.value)));
    END
    RETURN parts.join(" ");
}
END
PRIVATE FN mIREmitter__emit_index_insert(MUTABLE self: MIREmitter, node: IndexInsert) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE map: String = TRY (mIREmitter__emit(&rtoc_self_view, node.map));
    MUTABLE key: String = TRY (mIREmitter__emit(&rtoc_self_view, node.key_expr));
    MUTABLE val: String = TRY (mIREmitter__emit(&rtoc_self_view, node.value_expr));
    # `alloc` is a plain String@symbol here, so Ruby's `when nil` arm has no
    # CLEAR counterpart; `key_zig_type` IS optional and wants OR_ELSE, not OR.
    MUTABLE key_t: String = (node.key_zig_type OR_ELSE "u8");
    MUTABLE elem_t: String = (node.elem_zig_type OR_ELSE "");
    MUTABLE alloc_str: String = CAST(node.alloc AS String);
    IF (node.alloc == :heap) THEN
      alloc_str = TRY (mIREmitter__alloc_zig(rtoc_self_view, :heap));
    ELSE_IF (node.alloc == :frame) THEN
      alloc_str = TRY (mIREmitter__alloc_zig(rtoc_self_view, :frame));
    END
    RETURN "{\n    const __idx_key_owned = try ${alloc_str}.dupe(${key_t}, ${key});\n    var __gop = ${map}.inner.getOrPut(${alloc_str}, __idx_key_owned) catch @panic(\"INDEX allocation failed\");\n    if (__gop.found_existing) {\n        ${alloc_str}.free(__idx_key_owned);\n    } else {\n        __gop.value_ptr.* = @as(std.ArrayListUnmanaged(${elem_t}), .empty);\n    }\n    __gop.value_ptr.append(${alloc_str}, ${val}) catch @panic(\"INDEX append failed\");\n}";
}
END
PRIVATE FN mIREmitter__emit_sort(MUTABLE self: MIREmitter, node: Sort) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE et = node.elem_type;
    MUTABLE items: String = TRY (mIREmitter__emit(&rtoc_self_view, node.items_expr));
    MUTABLE cmp: String = "";
    IF node.string_keys THEN
      cmp = "std.mem.order(u8, ${TRY (mIREmitter__emit(&rtoc_self_view, node.key_a))}, ${TRY (mIREmitter__emit(&rtoc_self_view, node.key_b))}) == .lt";
    ELSE
      cmp = "${TRY (mIREmitter__emit(&rtoc_self_view, node.key_a))} < ${TRY (mIREmitter__emit(&rtoc_self_view, node.key_b))}";
    END
    RETURN "std.mem.sort(${et}, ${items}, {}, struct {\n    pub fn lessThan(_: void, a: ${et}, b: ${et}) bool {\n        return ${cmp};\n    }\n}.lessThan);";
}
END
PRIVATE FN mIREmitter__emit_batch_window_push(MUTABLE self: MIREmitter, node: BatchWindowPush) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN TRY (mIREmitter__emit_batch_window_emit(&rtoc_self_view, BatchWindowEmitNode{ BatchWindowPush: COPY node }, "try ${node.window}.push(${TRY (mIREmitter__emit(&rtoc_self_view, node.item_expr))})"));
}
END
PRIVATE FN mIREmitter__emit_batch_window_flush(MUTABLE self: MIREmitter, node: BatchWindowFlush) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN TRY (mIREmitter__emit_batch_window_emit(&rtoc_self_view, BatchWindowEmitNode{ BatchWindowFlush: COPY node }, "try ${node.window}.flush()"));
}
END
PRIVATE FN mIREmitter__emit_thunk_trampoline(MUTABLE self: MIREmitter, node: ThunkTrampoline) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE return_type_zig = TRY (type__zig_type(node.return_type));
    MUTABLE param_field_lines = TRY (mIREmitter__emit_thunk_frame_field_decls(rtoc_self_view, node.param_fields, "            "));
    MUTABLE param_init = TRY (mIREmitter__emit_thunk_frame_inits(&rtoc_self_view, node.param_init_fields));
    MUTABLE base_case_branches = (node.base_cases |> SELECT "if (${TRY (mIREmitter__emit(&rtoc_self_view, _.cond))}) {\n                    const result: ${return_type_zig} = ${TRY (mIREmitter__emit(&rtoc_self_view, _.value))};\n${TRY (mIREmitter__emit_thunk_return_or_pop(rtoc_self_view))}\n                }\n".trim()).join("\n                    ");
    MUTABLE recurse_arg_inits = TRY (mIREmitter__emit_thunk_frame_inits(&rtoc_self_view, node.recurse_arg_inits));
    MUTABLE combine_op = TRY (mIREmitter__emit_thunk_combine_op(rtoc_self_view, node.combine_op));
    RETURN "const Frame = struct {\n        ${param_field_lines}\n        step: u8 = 0,\n        child_result: ${return_type_zig} = undefined,\n        parent: ?*@This() = null,\n    };\n    var initial: Frame = .{ ${param_init} };\n    var current: *Frame = &initial;\n    while (true) {\n        // Cooperative yield: hands control back to the scheduler\n        // periodically (rt.checkYield uses its own internal\n        // counter -- thunk depth doesn't fight the fiber's\n        // own yield budget). Strippable via :TIGHT:THUNK\n        // for tight inner loops where the caller manages\n        // scheduler hand-off externally.\n        ${TRY (mIREmitter__emit_thunk_yield_statement(rtoc_self_view, node.yield_policy))}\n        switch (current.step) {\n            0 => {\n                ${base_case_branches}\n                // recursive call -- push child frame\n                const child = ${TRY (mIREmitter__alloc_zig(rtoc_self_view, :heap))}.create(Frame) catch unreachable;\n                child.* = .{ ${recurse_arg_inits}, .parent = current };\n                current.step = 1;\n                current = child;\n                continue;\n            },\n            1 => {\n                const result: ${return_type_zig} = ${TRY (mIREmitter__emit(&rtoc_self_view, node.combine_lhs))} ${combine_op} current.child_result;\n${TRY (mIREmitter__emit_thunk_return_or_pop(rtoc_self_view))}\n            },\n            else => unreachable,\n        }\n    }\n";
}
END
PRIVATE FN mIREmitter__emit_thunk_return_or_pop(self: MIREmitter) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN "if (current.parent) |p| {\n    p.child_result = result;\n    if (current != &initial) ${TRY (mIREmitter__alloc_zig(rtoc_self_view, :heap))}.destroy(current);\n    current = p;\n    continue;\n}\nreturn result;\n".trim();
}
END
PRIVATE FN mIREmitter__emit_mutual_thunk_trampoline(MUTABLE self: MIREmitter, node: MutualThunkTrampoline) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE variant_decls = (node.variants |> SELECT {
    MUTABLE fields = TRY (mIREmitter__emit_thunk_frame_field_decls(rtoc_self_view, _.param_fields, "          "));
    "${_.name}: struct {\n          ${fields}\n      },\n".trim()
    }).join("\n      ");
    MUTABLE initial_fields = TRY (mIREmitter__emit_thunk_frame_inits(&rtoc_self_view, node.initial_fields));
    MUTABLE switch_arms = (node.arms |> SELECT TRY (mIREmitter__emit_mutual_thunk_arm(&rtoc_self_view, _))).join("\n              ");
    RETURN "const Frame = union(enum) {\n    ${variant_decls}\n};\nvar current: Frame = .{ .${node.initial_variant} = .{ ${initial_fields} } };\nwhile (true) {\n    ${TRY (mIREmitter__emit_thunk_yield_statement(rtoc_self_view, node.yield_policy))}\n    switch (current) {\n        ${switch_arms}\n    }\n}\n";
}
END
PRIVATE FN mIREmitter__emit_mutual_thunk_arm(MUTABLE self: MIREmitter, arm: MutualThunkArm) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE base_branches = (arm.base_cases |> SELECT "if (${TRY (mIREmitter__emit(&rtoc_self_view, _.cond))}) {\n                      return ${TRY (mIREmitter__emit(&rtoc_self_view, _.value))};\n                  }\n".trim()).join("\n                      ");
    MUTABLE target_arg_inits = TRY (mIREmitter__emit_thunk_frame_inits(&rtoc_self_view, arm.target_arg_inits));
    RETURN ".${arm.variant_name} => |f| {\n                ${base_branches}\n                current = .{ .${arm.target_variant} = .{ ${target_arg_inits} } };\n                continue;\n            },\n".trim();
}
END
PRIVATE FN mIREmitter__emit_thunk_frame_inits(MUTABLE self: MIREmitter, inits: []ThunkFrameInit) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN (inits |> SELECT ".${_.field_name} = ${TRY (mIREmitter__emit(&rtoc_self_view, _.value))}").join(", ");
}
END
PRIVATE FN mIREmitter__emit_thunk_frame_field_decls(self: MIREmitter, fields: []ThunkFrameField, indent: String) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (fields |> SELECT "${_.name}: ${TRY (type__zig_type(_.type_info))},").join("\n${indent}");
}
END
PRIVATE FN mIREmitter__emit_thunk_yield_statement(self: MIREmitter, policy_value: String@symbol) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (policy_value == :check) THEN
      RETURN "${rtoc_self_view.rt_name}.checkYield();";
    ELSE_IF (policy_value == :tight_skip) THEN
      RETURN "// (TIGHT: scheduler yield-check skipped)";
    ELSE
      panic("unknown thunk yield policy: {}");
    END
}
END
PRIVATE FN mIREmitter__emit_thunk_combine_op(self: MIREmitter, op: String@symbol) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY ((CAST({:ADD: "+", :SUB: "-", :MUL: "*", :DIV: "/"} AS {String@symbol}String))[op] OR_ELSE panic("unknown thunk combine op: {}"));
}
END
PRIVATE FN mIREmitter__emit_batch_window_emit(MUTABLE self: MIREmitter, node: BatchWindowEmitNode, source: String) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    # Ruby types this `T.any(BatchWindowPush, BatchWindowFlush)`; the
    # translation reached for the AST `Node` union, which has neither.
    MUTABLE batch_var: String = "";
    MUTABLE window: String = "";
    MUTABLE elem_zig: String = "";
    MUTABLE result_var: String = "";
    MUTABLE node_alloc: String@symbol = :heap;
    MUTABLE value_expr: ?Emittable = NIL;
    PARTIAL MATCH node START
      BatchWindowEmitNode.BatchWindowPush AS push_node ->
        batch_var = COPY push_node.batch_var;
        window = COPY push_node.window;
        elem_zig = COPY push_node.elem_zig;
        result_var = (push_node.result_var OR_ELSE "");
        node_alloc = COPY push_node.alloc;
        value_expr = COPY push_node.value_expr;,
      BatchWindowEmitNode.BatchWindowFlush AS flush_node ->
        batch_var = COPY flush_node.batch_var;
        window = COPY flush_node.window;
        elem_zig = COPY flush_node.elem_zig;
        result_var = (flush_node.result_var OR_ELSE "");
        node_alloc = COPY flush_node.alloc;
        value_expr = COPY flush_node.value_expr;,
    END
    MUTABLE slice = "${batch_var}_slice";
    MUTABLE val = "${batch_var}_val";
    MUTABLE alloc = TRY (mIREmitter__alloc_zig(rtoc_self_view, node_alloc));
    RETURN "if (${source}) |${slice}| {\n    defer ${window}.freeBatch(${slice});\n    var ${batch_var} = std.ArrayListUnmanaged(${elem_zig}){ .items = ${slice}, .capacity = ${slice}.len };\n    _ = &${batch_var};\n    const ${val} = ${TRY (mIREmitter__emit(&rtoc_self_view, UNWRAP (value_expr)))};\n    try ${result_var}.append(${alloc}, ${val});\n}\n".trim();
}
END
PRIVATE FN mIREmitter__emit_scope_block(MUTABLE self: MIREmitter, node: ScopeBlock) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE body = TRY (mIREmitter__emit_body(&rtoc_self_view, node.body));
    RETURN "{\n${body}\n}";
}
END
PRIVATE FN mIREmitter__emit_defer(MUTABLE self: MIREmitter, node: MIRDeferStmt) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN mIREmitter__emit_defer_like(rtoc_self_view, "defer", TRY (mIREmitter__emit_defer_body(&rtoc_self_view, node.body)));
}
END
PRIVATE FN mIREmitter__emit_errdefer(MUTABLE self: MIREmitter, node: ErrDeferStmt) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN mIREmitter__emit_defer_like(rtoc_self_view, "errdefer", TRY (mIREmitter__emit_defer_body(&rtoc_self_view, node.body)));
}
END
PRIVATE FN mIREmitter__emit_defer_body(MUTABLE self: MIREmitter, body: DeferBody) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    # DeferBody is a union of the two shapes Ruby's `body.is_a?(Array)` tests;
    # the else arm has to be unwrapped, not passed through as the union.
    PARTIAL MATCH body START
      DeferBody.ArrayValue AS array ->
        RETURN "{\n${mIREmitter__indent_block(rtoc_self_view, TRY (mIREmitter__emit_body(&rtoc_self_view, array)), 4)}\n}";,
      DeferBody.Emittable AS single ->
        RETURN TRY (mIREmitter__emit(&rtoc_self_view, single));,
    END
    RETURN "";
}
END
PRIVATE FN mIREmitter__emit_defer_like(self: MIREmitter, keyword: String, body_input: ?String) RETURNS String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE body: ?String = COPY body_input;
    MUTABLE body_value: String = body?;
    IF body_value.startsWith?("{") THEN
      RETURN "${keyword} ${body_value}";
    END
    RETURN "${keyword} ${body_value};";
}
END
PRIVATE FN mIREmitter__emit_expr_stmt(MUTABLE self: MIREmitter, node: ExprStmt) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE code: String = TRY (mIREmitter__emit(&rtoc_self_view, node.expr));
    IF (node.discard OR_ELSE FALSE) THEN
      RETURN "_ = ${code};";
    ELSE
      RETURN "${code};";
    END
}
END
PRIVATE FN mIREmitter__emit_heap_create(MUTABLE self: MIREmitter, node: HeapCreate) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE label = (node.label OR_ELSE "__hc");
    MUTABLE init: String = TRY (mIREmitter__emit(&rtoc_self_view, node.init));
    MUTABLE alloc = TRY (mIREmitter__alloc_expr(&rtoc_self_view, Alloc{ SymbolValue: COPY node.alloc }));
    RETURN "${label}: {\n    const __p = try ${alloc}.create(${node.zig_type});\n    errdefer ${alloc}.destroy(__p);\n    __p.* = ${init};\n    break :${label} __p;\n}";
}
END
PRIVATE FN mIREmitter__emit_dupe_slice(MUTABLE self: MIREmitter, node: DupeSlice) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN "@as([]const u8, try ${TRY (mIREmitter__alloc_expr(&rtoc_self_view, Alloc{ SymbolValue: COPY node.alloc }))}.dupe(u8, ${TRY (mIREmitter__emit(&rtoc_self_view, node.source))}))";
}
END
PRIVATE FN mIREmitter__emit_alloc_slice(MUTABLE self: MIREmitter, node: AllocSlice) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN "try ${TRY (mIREmitter__alloc_expr(&rtoc_self_view, Alloc{ SymbolValue: COPY node.alloc }))}.alloc(${node.elem_type}, ${TRY (mIREmitter__emit(&rtoc_self_view, node.len))})";
}
END
PRIVATE FN mIREmitter__emit_free_slice(MUTABLE self: MIREmitter, node: FreeSlice) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN "${TRY (mIREmitter__alloc_expr(&rtoc_self_view, node.alloc))}.free(${TRY (mIREmitter__emit(&rtoc_self_view, node.slice))})";
}
END
PRIVATE FN mIREmitter__emit_destroy_ptr(MUTABLE self: MIREmitter, node: DestroyPtr) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN "${TRY (mIREmitter__alloc_expr(&rtoc_self_view, node.alloc))}.destroy(${TRY (mIREmitter__emit(&rtoc_self_view, node.ptr))})";
}
END
PRIVATE FN mIREmitter__alloc_expr(MUTABLE self: MIREmitter, alloc: Alloc) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    PARTIAL MATCH alloc START
      Alloc.SymbolValue AS string_symbol ->
        RETURN TRY (mIREmitter__alloc_zig(rtoc_self_view, string_symbol));,
      Alloc.Emittable AS alloc_expr ->
        RETURN TRY (mIREmitter__emit(&rtoc_self_view, alloc_expr));,
    END
    RETURN "";
}
END
FN mIREmitter__emit_stmt_list(MUTABLE self: MIREmitter, stmts: []Emittable) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN TRY (mIREmitter__emit_body(&rtoc_self_view, stmts));
}
END
PUB FN mIREmitter__emit_direct_cleanup(self: MIREmitter, name: String, entry: CleanupEntry, alloc_override: ?String = NIL) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE alloc: String = (alloc_override OR_ELSE TRY (mIREmitter__alloc_from_entry(rtoc_self_view, entry)));
    MUTABLE guarded = cleanupEntry__has_moved_guard?(entry);
    MUTABLE via_pointer = cleanupEntry__via_pointer?(entry);
    IF (cleanupEntry__kind(entry) == :resource) THEN
      MUTABLE close = TRY (mIREmitter__render_resource_close_plan(rtoc_self_view, UNWRAP (cleanupEntry__resource_close_plan(entry)), name));
      RETURN mIREmitter__direct_cleanup_statement(rtoc_self_view, name, close, guarded);
    ELSE_IF (cleanupEntry__kind(entry) == :tuple) THEN
      RETURN mIREmitter__direct_cleanup_statement(rtoc_self_view, name, TRY (mIREmitter__render_tuple_cleanup(rtoc_self_view, entry, name, alloc)), guarded);
    ELSE
      MUTABLE rc_alloc: ?String@symbol = cleanupEntry__rc_alloc(entry);
      MUTABLE use_alloc: String = "";
      use_alloc = COPY alloc;
      IF ((cleanupEntry__kind(entry) == :rc) AND (alloc_override == NIL)) THEN
        IF rc_alloc EXISTS AS rc_alloc_value THEN
          use_alloc = TRY (mIREmitter__alloc_from_sym(rtoc_self_view, rc_alloc_value));
        END
      END
      MUTABLE use_name: String = "";
      IF (cleanupEntry__kind(entry) == :frozen) THEN
        use_name = "${name}__buf";
      ELSE
        use_name = COPY name;
      END
      MUTABLE use_type: String = "";
      IF via_pointer THEN
        use_type = "@TypeOf(${use_name}.*)";
      ELSE
        use_type = "@TypeOf(${use_name})";
      END
      MUTABLE result = mIREmitter__direct_uniform_cleanup(rtoc_self_view, use_name, use_type, use_alloc, guarded, via_pointer);
      IF cleanupEntry__rc_release_fields_cleanup?(entry) THEN
        MUTABLE guard: String = "";
        IF guarded THEN
          guard = "if (!${mIREmitter__move_guard_name(rtoc_self_view, Name{ StringValue: COPY name })}) ";
        ELSE
          guard = "";
        END
        result = (result $+ "\n${guard}CheatLib.releaseFields(${(cleanupEntry__base_zig(entry) OR_ELSE "")}, ${use_alloc}, ${name}.ctrl.data.*);");
      END
      RETURN result;
    END
}
END
PRIVATE FN mIREmitter__emit_cleanup(self: MIREmitter, name: String, entry: CleanupEntry, errdefer: Bool = FALSE) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE alloc: String = TRY (mIREmitter__alloc_from_entry(rtoc_self_view, entry));
    MUTABLE g = cleanupEntry__has_moved_guard?(entry);
    MUTABLE vp = cleanupEntry__via_pointer?(entry);
    IF (cleanupEntry__kind(entry) == :resource) THEN
      MUTABLE close: String = "";
      IF cleanupEntry__resource_close_plan(entry) EXISTS AS close_plan THEN
        close = TRY (mIREmitter__render_resource_close_plan(rtoc_self_view, close_plan, name));
      END
      RETURN mIREmitter__guarded_defer(rtoc_self_view, name, close, g, errdefer);
    ELSE_IF (cleanupEntry__kind(entry) == :tuple) THEN
      RETURN mIREmitter__guarded_defer(rtoc_self_view, name, TRY (mIREmitter__render_tuple_cleanup(rtoc_self_view, entry, name, alloc)), g, errdefer);
    ELSE
      MUTABLE use_alloc: String = COPY alloc;
      IF (cleanupEntry__kind(entry) == :rc) THEN
        IF cleanupEntry__rc_alloc(entry) EXISTS AS rc_alloc_value THEN
          use_alloc = TRY (mIREmitter__alloc_from_sym(rtoc_self_view, rc_alloc_value));
        END
      END
      MUTABLE use_name: String = "";
      IF (cleanupEntry__kind(entry) == :frozen) THEN
        use_name = "${name}__buf";
      ELSE
        use_name = COPY name;
      END
      MUTABLE use_type: String = "";
      IF vp THEN
        use_type = "@TypeOf(${use_name}.*)";
      ELSE
        use_type = "@TypeOf(${use_name})";
      END
      MUTABLE result = mIREmitter__guarded_cleanup(rtoc_self_view, use_name, use_type, use_alloc, g, errdefer, vp);
      IF cleanupEntry__rc_release_fields_cleanup?(entry) THEN
        MUTABLE guard: String = "";
        IF g THEN
          guard = "if (!${mIREmitter__move_guard_name(rtoc_self_view, Name{ StringValue: COPY name })}) ";
        ELSE
          guard = "";
        END
        MUTABLE kw: String = "";
        IF errdefer THEN
          kw = "errdefer";
        ELSE
          kw = "defer";
        END
        result = (result $+ "${kw} ${guard}CheatLib.releaseFields(${(cleanupEntry__base_zig(entry) OR_ELSE "")}, ${use_alloc}, ${name}.ctrl.data.*);\n");
      END
      RETURN result;
    END
}
END
PRIVATE FN mIREmitter__emit_move_mark(self: MIREmitter, node: MoveMark) RETURNS String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE guard = COPY (rtoc_self_view.move_guard_overrides[CAST(node.name AS String)] OR_ELSE mIREmitter__move_guard_name(rtoc_self_view, Name{ StringValue: COPY node.name }));
    RETURN "${guard} = true;";
}
END
PRIVATE FN mIREmitter__emit_deep_copy(MUTABLE self: MIREmitter, node: DeepCopy) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE src = TRY (mIREmitter__emit(&rtoc_self_view, node.source));
    IF src.startsWith?("@panic(") THEN
      RETURN src;
    END
    # Ruby's `node.alloc ? alloc_expr(node.alloc) : nil` -- the interpolations
    # below all sit in the branch that only runs with an allocator, so the
    # empty default is what Ruby's nil would have printed.
    MUTABLE alloc: String = "";
    IF node.alloc EXISTS AS node_alloc THEN
      alloc = TRY (mIREmitter__alloc_expr(&rtoc_self_view, Alloc{ SymbolValue: COPY node_alloc }));
    END
    rtoc_self_view.deep_copy_counter = (rtoc_self_view.deep_copy_counter + 1);
    MUTABLE bc = "blk_copy_${rtoc_self_view.deep_copy_counter.toString()}";
    IF (node.strategy == :passthrough) THEN
      RETURN "(if (comptime @typeInfo(@TypeOf(${src})) == .pointer and @typeInfo(@TypeOf(${src})).pointer.size == .one) (${src}).* else ${src})";
    ELSE_IF (node.strategy == :full_value) THEN
      # CLEAR's narrowing does not reach inside an IF EXPRESSION's arms, so the
      # presence has to be bound before either call sees it.
      MUTABLE storage_zig_type: String = (node.zig_type OR_ELSE "");
      IF node.type_info EXISTS AS type_info_value THEN
        IF type__error_union?(type_info_value) THEN
          storage_zig_type = TRY (type__nested_zig_type(type_info_value));
        END
      END
      MUTABLE type_arg: String = "";
      IF (node.copy_shape == :pointer) THEN
        type_arg = "@TypeOf(${src})";
      ELSE
        type_arg = (storage_zig_type);
      END
      IF (node.copy_shape == :slice) THEN
        RETURN "${bc}: { const __copy_src = ${src}; break :${bc} try CheatLib.dupeValue(${type_arg}, __copy_src, ${alloc}); }";
      ELSE
        MUTABLE pointer_type_arg: String = "";
        IF (node.copy_shape == :pointer) THEN
          pointer_type_arg = "@TypeOf(${src})";
        ELSE
          pointer_type_arg = (storage_zig_type);
        END
        MUTABLE pointer_value: String = "";
        IF (node.copy_shape == :value) THEN
          pointer_value = "__copy_src.*";
        ELSE
          pointer_value = "__copy_src";
        END
        RETURN "${bc}: { const __copy_src = ${src}; if (comptime @typeInfo(@TypeOf(__copy_src)) == .pointer and @typeInfo(@TypeOf(__copy_src)).pointer.size == .one) { break :${bc} try CheatLib.dupeValue(${pointer_type_arg}, ${pointer_value}, ${alloc}); } else { break :${bc} try CheatLib.dupeValue(${type_arg}, __copy_src, ${alloc}); } }";
      END
    ELSE
      panic("MIREmitter#emit_deep_copy: unhandled strategy :{}");
    END
}
END
PRIVATE FN mIREmitter__emit_container_init(MUTABLE self: MIREmitter, node: ContainerInit) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (node.strategy == :pool) OR (node.strategy == :list_capacity) OR (node.strategy == :set_capacity) THEN
      # `capacity` is an ?Emittable, not a String: Ruby interpolates the NODE,
      # which renders through emit, so the empty-string default was wrong even
      # where it type-checked.
      MUTABLE capacity_zig: String = "";
      IF node.capacity EXISTS AS capacity_value THEN
        capacity_zig = TRY (mIREmitter__emit(&rtoc_self_view, capacity_value));
      END
      RETURN "try ${node.zig_type}.initCapacity(${TRY (mIREmitter__alloc_zig(rtoc_self_view, symbol(UNWRAP (node.alloc))))}, ${capacity_zig})";
    ELSE_IF (node.strategy == :array_list_empty) OR (node.strategy == :grid_empty) THEN
      RETURN "@as(${node.zig_type}, .empty)";
    ELSE_IF (node.strategy == :list_empty) OR (node.strategy == :set_empty) OR (node.strategy == :map_empty) THEN
      RETURN "${node.zig_type}{}";
    ELSE_IF (node.strategy == :map_bare) THEN
      RETURN "${node.zig_type}{ .alloc = ${TRY (mIREmitter__alloc_zig(rtoc_self_view, symbol(UNWRAP (node.alloc))))} }";
    ELSE
      panic("MIREmitter#emit_container_init: unhandled strategy :{}");
    END
}
END
PRIVATE FN mIREmitter__emit_cap_wrap(MUTABLE self: MIREmitter, node: CapWrap) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE inner: String = TRY (mIREmitter__emit(&rtoc_self_view, node.inner));
    MUTABLE alloc = TRY (mIREmitter__alloc_zig(rtoc_self_view, node.alloc));
    IF (node.strategy == :local) THEN
      RETURN "try CheatLib.localCreate(${node.zig_base}, ${alloc}, ${inner})";
    ELSE_IF (node.strategy == :sync_only) THEN
      RETURN "try CheatLib.${(node.sync_fn OR_ELSE "")}(${node.zig_base}, ${alloc}, ${inner})";
    ELSE_IF (node.strategy == :own_only) THEN
      RETURN "try CheatLib.${(node.own_fn OR_ELSE "")}(${node.zig_base}, ${alloc}, ${inner})";
    ELSE_IF (node.strategy == :both) THEN
      RETURN "blk_cap: {\n    const __cap_inner = try CheatLib.${(node.sync_fn OR_ELSE "")}(${node.zig_base}, ${alloc}, ${inner});\n    const __cap_val = __cap_inner.*;\n    ${alloc}.destroy(__cap_inner);\n    break :blk_cap try CheatLib.${(node.own_fn OR_ELSE "")}(${(node.sync_type OR_ELSE "")}, ${alloc}, __cap_val);\n}\n".trim();
    ELSE_IF (node.strategy == :passthrough) THEN
      RETURN inner;
    ELSE
      panic("MIREmitter#emit_cap_wrap: unhandled strategy :{}");
    END
}
END
PRIVATE FN mIREmitter__emit_share_promote(MUTABLE self: MIREmitter, node: SharePromote) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE source: String = TRY (mIREmitter__emit(&rtoc_self_view, node.source));
    MUTABLE alloc = TRY (mIREmitter__alloc_zig(rtoc_self_view, node.alloc));
    RETURN "blk_share: {\n    const __share_src = ${source};\n    errdefer CheatLib.rcRelease(${node.zig_base}, ${alloc}, __share_src);\n    var __share_val = try CheatLib.dupeValue(${node.zig_base}, __share_src.ctrl.data.*, ${alloc});\n    errdefer CheatLib.cleanup(${node.zig_base}, ${alloc}, &__share_val);\n    const __share_arc = try CheatLib.arcCreate(${node.zig_base}, ${alloc}, __share_val);\n    CheatLib.rcRelease(${node.zig_base}, ${alloc}, __share_src);\n    break :blk_share __share_arc;\n}\n".trim();
}
END
