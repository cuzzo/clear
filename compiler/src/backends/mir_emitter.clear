REQUIRE "../ast/type.clear"
REQUIRE "../ast/error_registry.clear"
REQUIRE "../mir/mir.clear"
REQUIRE "../mir/cleanup_entry.clear"
REQUIRE "../mir/placement.clear"
REQUIRE "zig_type.clear"
REQUIRE "fsm_wrapper_emitter.clear"
REQUIRE "../ast/ast.clear"
REQUIRE "../annotator/helpers/function_signature.clear"
REQUIRE "../annotator/helpers/intrinsic_contract.clear"
REQUIRE "../ast/async_result_shape.clear"
UNION Plan { FsmIoBody: FsmIoBody, FsmB1Body: FsmB1Body, FsmGenericBody: FsmGenericBody }
STRUCT MIREmitter {
  deep_copy_counter: Int64,
  discard_counter: Int64,
  flow_alias_name: ?String,
  heap_allocator_cache_name: ?String,
  heap_allocator_cache_names: []String,
  heap_allocator_cache_runtime_name: ?String,
  ident_overrides: {String}String,
  if_bind_counter: ?Int64,
  indent: Int64,
  items_block_counter: Int64,
  move_guard_overrides: {String}String,
  owned_slice_counter: Int64,
  rt_name: String,
  symbol_literals: {String}String,
  uses_c_callback: Bool
}

STRUCT EmissionState {
  symbol_literals: {String}String,
  uses_c_callback: Bool,
  if_bind_counter: ?Int64,
  discard_counter: Int64,
  deep_copy_counter: Int64,
  items_block_counter: Int64,
  owned_slice_counter: Int64
}
UNION MIREmitterShardedMapNode { ShardedMapPut: ShardedMapPut, ShardedMapGet: ShardedMapGet }
FN mIREmitter__initialize(MUTABLE self: MIREmitter, state: ?EmissionState = NIL) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.indent = 0;
    rtoc_self_view.rt_name = "rt";
    rtoc_self_view.heap_allocator_cache_name = NIL;
    rtoc_self_view.heap_allocator_cache_runtime_name = NIL;
    rtoc_self_view.heap_allocator_cache_names = List[];
    rtoc_self_view.flow_alias_name = NIL;
    rtoc_self_view.if_bind_counter = state?.if_bind_counter;
    rtoc_self_view.discard_counter = (state?.discard_counter OR_ELSE 0);
    rtoc_self_view.deep_copy_counter = (state?.deep_copy_counter OR_ELSE 0);
    rtoc_self_view.items_block_counter = (state?.items_block_counter OR_ELSE 0);
    rtoc_self_view.owned_slice_counter = (state?.owned_slice_counter OR_ELSE 0);
    rtoc_self_view.symbol_literals = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_ternary_value_1: ?{String}String = NIL;
    IF state != NIL THEN
      rtoc_ternary_value_1 = COPY state.symbol_literals;
    ELSE
      rtoc_ternary_value_1 = {};
    END
    rtoc_ternary_value_1? };
    rtoc_self_view.ident_overrides = {};
    rtoc_self_view.move_guard_overrides = {};
    rtoc_self_view.uses_c_callback = ((state?.uses_c_callback != NIL) OR FALSE);
}
END
FN mIREmitter__emission_state(self: MIREmitter) RETURNS EmissionState
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN EmissionState{ symbol_literals: COPY rtoc_self_view.symbol_literals, uses_c_callback: rtoc_self_view.uses_c_callback, if_bind_counter: rtoc_self_view.if_bind_counter, discard_counter: rtoc_self_view.discard_counter, deep_copy_counter: rtoc_self_view.deep_copy_counter, items_block_counter: rtoc_self_view.items_block_counter, owned_slice_counter: rtoc_self_view.owned_slice_counter };
}
END
FN mIREmitter__emit(MUTABLE self: MIREmitter, MUTABLE node: ?Emittable) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (node == NIL) THEN
      RETURN "";
    ELSE_IF (node == String) THEN
      panic("MIREmitter cannot emit raw Zig strings; use a structural MIR node");
    ELSE_IF (node IS_A MIRProgram) THEN
      RETURN TRY (mIREmitter__emit_program(&rtoc_self_view, node));
    ELSE_IF (node IS_A FnDef) THEN
      RETURN TRY (mIREmitter__emit_fn_def(&rtoc_self_view, node));
    ELSE_IF (node IS_A MIRStructDef) THEN
      RETURN TRY (mIREmitter__emit_struct_def(&rtoc_self_view, node));
    ELSE_IF (node IS_A MIREnumDef) THEN
      RETURN mIREmitter__emit_enum_def(rtoc_self_view, node);
    ELSE_IF (node IS_A UnionTypeDef) THEN
      RETURN TRY (mIREmitter__emit_union_def(&rtoc_self_view, node));
    ELSE_IF (node IS_A Import) THEN
      RETURN mIREmitter__emit_import(rtoc_self_view, node);
    ELSE_IF (node IS_A TypeAlias) THEN
      RETURN mIREmitter__emit_type_alias(rtoc_self_view, node);
    ELSE_IF (node IS_A CExternFnDecl) THEN
      RETURN mIREmitter__emit_c_extern_fn_decl(rtoc_self_view, node);
    ELSE_IF (node IS_A CExternStructDef) THEN
      RETURN mIREmitter__emit_c_extern_struct_def(rtoc_self_view, node);
    ELSE_IF (node IS_A ModuleNamespace) THEN
      RETURN TRY (mIREmitter__emit_module_namespace(&rtoc_self_view, node));
    ELSE_IF (node IS_A TestDef) THEN
      RETURN TRY (mIREmitter__emit_test_def(&rtoc_self_view, node));
    ELSE_IF (node IS_A Let) THEN
      RETURN TRY (mIREmitter__emit_let(&rtoc_self_view, node));
    ELSE_IF (node IS_A Set) THEN
      RETURN TRY (mIREmitter__emit_set(&rtoc_self_view, node));
    ELSE_IF (node IS_A DestructureSet) THEN
      RETURN TRY (mIREmitter__emit_destructure_set(&rtoc_self_view, node));
    ELSE_IF (node IS_A ReassignWithCleanup) THEN
      RETURN TRY (mIREmitter__emit_reassign_cleanup(&rtoc_self_view, node));
    ELSE_IF (node IS_A ResourceClose) THEN
      RETURN TRY (mIREmitter__emit_resource_close(&rtoc_self_view, node));
    ELSE_IF (node IS_A IfStmt) THEN
      RETURN TRY (mIREmitter__emit_if_stmt(&rtoc_self_view, node));
    ELSE_IF (node IS_A IfBindStmt) THEN
      RETURN TRY (mIREmitter__emit_if_bind_stmt(&rtoc_self_view, node));
    ELSE_IF (node IS_A WhileStmt) THEN
      RETURN TRY (mIREmitter__emit_while(&rtoc_self_view, &node));
    ELSE_IF (node IS_A ForStmt) THEN
      RETURN TRY (mIREmitter__emit_for(&rtoc_self_view, node));
    ELSE_IF (node IS_A SwitchStmt) THEN
      RETURN TRY (mIREmitter__emit_switch(&rtoc_self_view, node));
    ELSE_IF (node IS_A UnionMatchStmt) THEN
      RETURN TRY (mIREmitter__emit_union_match(&rtoc_self_view, node));
    ELSE_IF (node IS_A IfChain) THEN
      RETURN TRY (mIREmitter__emit_if_chain(&rtoc_self_view, node));
    ELSE_IF (node IS_A ReturnStmt) THEN
      RETURN TRY (mIREmitter__emit_return(&rtoc_self_view, node));
    ELSE_IF (node IS_A BreakStmt) THEN
      RETURN TRY (mIREmitter__emit_break(&rtoc_self_view, node));
    ELSE_IF (node IS_A ContinueStmt) THEN
      RETURN "continue;";
    ELSE_IF (node IS_A Panic) THEN
      RETURN "@panic(${compilerInspectValue()});";
    ELSE_IF (node IS_A AssertStmt) THEN
      RETURN TRY (mIREmitter__emit_assert_stmt(&rtoc_self_view, node));
    ELSE_IF (node IS_A AssertRaisesCheck) THEN
      RETURN TRY (mIREmitter__emit_assert_raises_check(&rtoc_self_view, node));
    ELSE_IF (node IS_A TestPreamble) THEN
      RETURN mIREmitter__emit_test_preamble(rtoc_self_view);
    ELSE_IF (node IS_A DebugOnly) THEN
      RETURN TRY (mIREmitter__emit_debug_only(&rtoc_self_view, node));
    ELSE_IF (node IS_A Sort) THEN
      RETURN TRY (mIREmitter__emit_sort(&rtoc_self_view, node));
    ELSE_IF (node IS_A SoaFieldAccess) THEN
      RETURN "${TRY (mIREmitter__emit(&rtoc_self_view, node.soa_expr()))}.data.items(.${node.field_name()})";
    ELSE_IF (node IS_A TryOrPanic) THEN
      RETURN "${TRY (mIREmitter__emit(&rtoc_self_view, node.expr()))} catch @panic(${compilerInspectValue()})";
    ELSE_IF (node IS_A IndexInsert) THEN
      RETURN TRY (mIREmitter__emit_index_insert(&rtoc_self_view, node));
    ELSE_IF (node IS_A BatchWindowPush) THEN
      RETURN TRY (mIREmitter__emit_batch_window_push(&rtoc_self_view, node));
    ELSE_IF (node IS_A BatchWindowFlush) THEN
      RETURN TRY (mIREmitter__emit_batch_window_flush(&rtoc_self_view, node));
    ELSE_IF (node IS_A ThunkTrampoline) THEN
      RETURN TRY (mIREmitter__emit_thunk_trampoline(&rtoc_self_view, node));
    ELSE_IF (node IS_A MutualThunkTrampoline) THEN
      RETURN TRY (mIREmitter__emit_mutual_thunk_trampoline(&rtoc_self_view, node));
    ELSE_IF (node IS_A MIRDeferStmt) THEN
      RETURN TRY (mIREmitter__emit_defer(&rtoc_self_view, node));
    ELSE_IF (node IS_A ErrDeferStmt) THEN
      RETURN TRY (mIREmitter__emit_errdefer(&rtoc_self_view, node));
    ELSE_IF (node IS_A ExprStmt) THEN
      RETURN TRY (mIREmitter__emit_expr_stmt(&rtoc_self_view, node));
    ELSE_IF (node IS_A DiscardOwned) THEN
      RETURN TRY (mIREmitter__emit_discard_owned(&rtoc_self_view, node));
    ELSE_IF (node IS_A ScopeBlock) THEN
      RETURN TRY (mIREmitter__emit_scope_block(&rtoc_self_view, node));
    ELSE_IF (node IS_A Pipeline) THEN
      RETURN TRY (mIREmitter__emit(&rtoc_self_view, node.inner()));
    ELSE_IF (node IS_A MIRBgBlock) THEN
      RETURN TRY (mIREmitter__emit_bg_block(&rtoc_self_view, node));
    ELSE_IF (node IS_A DirectTenseMap) THEN
      RETURN TRY (mIREmitter__emit_direct_tense_map(&rtoc_self_view, node));
    ELSE_IF (node IS_A AsyncPayloadTake) THEN
      RETURN "${mIREmitter__paren_if_try(rtoc_self_view, UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, node.source()))))}.value";
    ELSE_IF (node IS_A ShardConcurrentEach) THEN
      RETURN TRY (mIREmitter__emit_shard_concurrent_each(&rtoc_self_view, node));
    ELSE_IF (node IS_A MIRDoBlock) THEN
      RETURN TRY (mIREmitter__emit_do_block(&rtoc_self_view, node));
    ELSE_IF (node IS_A CatchWrapper) THEN
      RETURN TRY (mIREmitter__emit_catch_wrapper(&rtoc_self_view, node));
    ELSE_IF (node IS_A Comment) THEN
      RETURN "// ${node.text()}";
    ELSE_IF (node IS_A Suppress) THEN
      RETURN "_ = &${node.name()};";
    ELSE_IF (node IS_A PubConst) THEN
      RETURN "pub const ${node.name()} = ${node.value()};";
    ELSE_IF (node IS_A ModuleVar) THEN
      RETURN "${IF ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_2 = CAST(node AS FunctionSignature);
      functionSignature__visibility(rtoc_local_receiver_2) } == :pub) THEN
        "pub "
      ELSE
        ""
      END}var ${node.name()}: ${TRY (type__zig_type(CAST(node AS Type)))} = undefined;";
    ELSE_IF (node IS_A ModuleConstFree) THEN
      RETURN "defer CheatLib.cleanup(@TypeOf(${node.name()}), ${rtoc_self_view.rt_name}.heapAlloc(), &${node.name()});";
    ELSE_IF (node IS_A ProtocolAdapterDef) THEN
      RETURN mIREmitter__emit_protocol_adapter_def(rtoc_self_view, node);
    ELSE_IF (node IS_A HeapCreate) THEN
      RETURN TRY (mIREmitter__emit_heap_create(&rtoc_self_view, node));
    ELSE_IF (node IS_A DupeSlice) THEN
      RETURN TRY (mIREmitter__emit_dupe_slice(&rtoc_self_view, node));
    ELSE_IF (node IS_A AllocSlice) THEN
      RETURN TRY (mIREmitter__emit_alloc_slice(&rtoc_self_view, node));
    ELSE_IF (node IS_A FreeSlice) THEN
      RETURN TRY (mIREmitter__emit_free_slice(&rtoc_self_view, node));
    ELSE_IF (node IS_A DestroyPtr) THEN
      RETURN TRY (mIREmitter__emit_destroy_ptr(&rtoc_self_view, node));
    ELSE_IF (node IS_A Cleanup) THEN
      RETURN TRY (mIREmitter__emit_cleanup(rtoc_self_view, node));
    ELSE_IF (node IS_A ErrCleanup) THEN
      RETURN TRY (mIREmitter__emit_cleanup(rtoc_self_view, node, TRUE));
    ELSE_IF (node IS_A MoveMark) THEN
      RETURN mIREmitter__emit_move_mark(rtoc_self_view, node);
    ELSE_IF (node IS_A DeepCopy) THEN
      RETURN TRY (mIREmitter__emit_deep_copy(&rtoc_self_view, node));
    ELSE_IF (node IS_A ContainerInit) THEN
      RETURN TRY (mIREmitter__emit_container_init(rtoc_self_view, node));
    ELSE_IF (node IS_A CapWrap) THEN
      RETURN TRY (mIREmitter__emit_cap_wrap(&rtoc_self_view, node));
    ELSE_IF (node IS_A SharePromote) THEN
      RETURN TRY (mIREmitter__emit_share_promote(&rtoc_self_view, node));
    ELSE_IF (node IS_A RcRetain) THEN
      RETURN TRY (mIREmitter__emit_rc_retain(&rtoc_self_view, node));
    ELSE_IF (node IS_A ComptimeCarrierPayload) THEN
      RETURN TRY (mIREmitter__emit_comptime_carrier_payload(&rtoc_self_view, node));
    ELSE_IF (node IS_A MonomorphicKeep) THEN
      RETURN TRY (mIREmitter__emit_monomorphic_keep(&rtoc_self_view, node));
    ELSE_IF (node IS_A RcRelease) THEN
      RETURN TRY (mIREmitter__emit_rc_release(&rtoc_self_view, node));
    ELSE_IF (node IS_A RcDowngrade) THEN
      RETURN TRY (mIREmitter__emit_rc_downgrade(&rtoc_self_view, node));
    ELSE_IF (node IS_A WeakUpgrade) THEN
      RETURN TRY (mIREmitter__emit_weak_upgrade(&rtoc_self_view, node));
    ELSE_IF (node IS_A FreezeExpr) THEN
      RETURN TRY (mIREmitter__emit_freeze(&rtoc_self_view, node));
    ELSE_IF (node IS_A MakeList) THEN
      RETURN TRY (mIREmitter__emit_make_list(&rtoc_self_view, node));
    ELSE_IF (node IS_A FrameSave) THEN
      RETURN mIREmitter__emit_frame_save(rtoc_self_view, node);
    ELSE_IF (node IS_A FrameRestore) THEN
      RETURN mIREmitter__emit_frame_restore(rtoc_self_view, node);
    ELSE_IF (node IS_A SnapshotRead) THEN
      RETURN TRY (mIREmitter__emit_snapshot_read(&rtoc_self_view, node));
    ELSE_IF (node IS_A SnapshotTransaction) THEN
      RETURN TRY (mIREmitter__emit_snapshot_transaction(&rtoc_self_view, node));
    ELSE_IF (node IS_A SnapshotMultiTxn) THEN
      RETURN TRY (mIREmitter__emit_snapshot_multi_txn(&rtoc_self_view, node));
    ELSE_IF (node IS_A PolymorphicMutate) THEN
      RETURN TRY (mIREmitter__emit_polymorphic_mutate(&rtoc_self_view, node));
    ELSE_IF (node IS_A PolymorphicMutateFlow) THEN
      RETURN TRY (mIREmitter__emit_polymorphic_mutate_flow(&rtoc_self_view, node));
    ELSE_IF (node IS_A WithMatchDispatch) THEN
      RETURN TRY (mIREmitter__emit_with_match_dispatch(&rtoc_self_view, node));
    ELSE_IF (node IS_A SortedLockAcquire) THEN
      RETURN TRY (mIREmitter__emit_sorted_lock_acquire(&rtoc_self_view, node));
    ELSE_IF (node IS_A FallibleLockBinding) THEN
      RETURN TRY (mIREmitter__emit_fallible_lock_binding(&rtoc_self_view, node));
    ELSE_IF (node IS_A Noop) OR (node IS_A AllocMark) OR (node IS_A ReturnMark) OR (node IS_A TransferMark) OR (node IS_A ReassignMark) OR (node IS_A FieldCleanupMark) OR (node IS_A OwnedCreate) OR (node IS_A OwnedDestroy) OR (node IS_A OwnedTransfer) OR (node IS_A OwnedBorrow) OR (node IS_A OwnedStore) OR (node IS_A OwnedReturn) THEN
      RETURN NIL;
    ELSE_IF (node IS_A Call) THEN
      RETURN TRY (mIREmitter__emit_call(&rtoc_self_view, node));
    ELSE_IF (node IS_A RuntimeCall) THEN
      RETURN TRY (mIREmitter__emit_runtime_call(&rtoc_self_view, node));
    ELSE_IF (node IS_A TailCall) THEN
      RETURN TRY (mIREmitter__emit_tail_call(&rtoc_self_view, node));
    ELSE_IF (node IS_A MIRMethodCall) THEN
      RETURN TRY (mIREmitter__emit_method_call(&rtoc_self_view, node));
    ELSE_IF (node IS_A FieldGet) THEN
      RETURN TRY (mIREmitter__emit_field_get(&rtoc_self_view, node));
    ELSE_IF (node IS_A UnionPayloadGet) THEN
      RETURN TRY (mIREmitter__emit_union_payload_get(&rtoc_self_view, node));
    ELSE_IF (node IS_A IndexGet) THEN
      RETURN TRY (mIREmitter__emit_index_get(&rtoc_self_view, node));
    ELSE_IF (node IS_A MIRBinOp) THEN
      RETURN TRY (mIREmitter__emit_bin_op(&rtoc_self_view, node));
    ELSE_IF (node IS_A FallibleOk) THEN
      RETURN "if (${TRY (mIREmitter__emit(&rtoc_self_view, node.expr()))}) |_| true else |_| false";
    ELSE_IF (node IS_A FutureReady) THEN
      RETURN "${TRY (mIREmitter__emit(&rtoc_self_view, node.expr()))}.isReady()";
    ELSE_IF (node IS_A MIRUnaryOp) THEN
      RETURN TRY (mIREmitter__emit_unary_op(&rtoc_self_view, node));
    ELSE_IF (node IS_A Lit) THEN
      RETURN COPY CAST(node.value() AS String);
    ELSE_IF (node IS_A SymbolLit) THEN
      RETURN mIREmitter__symbol_literal_name(&rtoc_self_view, CAST(node.value() AS String));
    ELSE_IF (node IS_A VoidLiteral) THEN
      RETURN "{}";
    ELSE_IF (node IS_A DefaultValue) THEN
      RETURN TRY (mIREmitter__emit_default_value(rtoc_self_view, node));
    ELSE_IF (node IS_A EnumTag) THEN
      RETURN ".${node.variant()}";
    ELSE_IF (node IS_A EnumOrdinal) THEN
      RETURN "@intFromEnum(${TRY (mIREmitter__emit(&rtoc_self_view, node.value()))})";
    ELSE_IF (node IS_A Ident) THEN
      RETURN COPY (rtoc_self_view.ident_overrides[CAST(node.name() AS String)] OR_ELSE CAST(node.name() AS String));
    ELSE_IF (node IS_A MIRDestructureTarget) THEN
      RETURN mIREmitter__emit_destructure_target(rtoc_self_view, node);
    ELSE_IF (node IS_A TupleLiteral) THEN
      RETURN TRY (mIREmitter__emit_tuple_literal(&rtoc_self_view, node));
    ELSE_IF (node IS_A CapabilityUnwrap) THEN
      RETURN TRY (mIREmitter__emit_capability_unwrap(&rtoc_self_view, node));
    ELSE_IF (node IS_A CapabilityLockTarget) THEN
      RETURN TRY (mIREmitter__emit_capability_lock_target(&rtoc_self_view, node));
    ELSE_IF (node IS_A CapabilityLockAddress) THEN
      RETURN TRY (mIREmitter__emit_capability_lock_address(&rtoc_self_view, node));
    ELSE_IF (node IS_A FnRef) THEN
      RETURN "&${node.name()}";
    ELSE_IF (node IS_A LockAcquire) THEN
      RETURN TRY (mIREmitter__emit_lock_acquire(&rtoc_self_view, node));
    ELSE_IF (node IS_A TypeOf) THEN
      RETURN "@TypeOf(${TRY (mIREmitter__emit(&rtoc_self_view, node.expr()))})";
    ELSE_IF (node IS_A TypeEq) THEN
      RETURN "(${TRY (mIREmitter__emit(&rtoc_self_view, node.left()))} == ${TRY (mIREmitter__emit(&rtoc_self_view, node.right()))})";
    ELSE_IF (node IS_A StructInit) THEN
      RETURN TRY (mIREmitter__emit_struct_init(&rtoc_self_view, node));
    ELSE_IF (node IS_A ArrayInit) THEN
      RETURN TRY (mIREmitter__emit_array_init(&rtoc_self_view, node));
    ELSE_IF (node IS_A ArrayDefaultInit) THEN
      RETURN TRY (mIREmitter__emit_array_default_init(&rtoc_self_view, node));
    ELSE_IF (node IS_A SliceExpr) THEN
      RETURN TRY (mIREmitter__emit_slice_expr(&rtoc_self_view, node));
    ELSE_IF (node IS_A MIRBlockExpr) THEN
      RETURN TRY (mIREmitter__emit_block_expr(&rtoc_self_view, node));
    ELSE_IF (node IS_A ConcatStr) THEN
      RETURN TRY (mIREmitter__emit_concat(&rtoc_self_view, node));
    ELSE_IF (node IS_A MIRCast) THEN
      RETURN TRY (mIREmitter__emit_cast(&rtoc_self_view, node));
    ELSE_IF (node IS_A TryExpr) THEN
      MUTABLE try_expr = node.expr();
      IF try_expr IS_A MIROptionalUnwrap THEN
        RETURN "(try ${TRY (mIREmitter__emit(&rtoc_self_view, try_expr.expr()))}).?";
      ELSE
        RETURN "try ${TRY (mIREmitter__emit(&rtoc_self_view, try_expr))}";
      END
    ELSE_IF (node IS_A TryOptional) THEN
      RETURN "(${TRY (mIREmitter__emit(&rtoc_self_view, node.expr()))} orelse return error.TryOptional)";
    ELSE_IF (node IS_A TryCatch) THEN
      RETURN TRY (mIREmitter__emit_try_catch(&rtoc_self_view, node));
    ELSE_IF (node IS_A BreakExpr) THEN
      RETURN TRY (mIREmitter__emit_break_expr(&rtoc_self_view, node));
    ELSE_IF (node IS_A Orelse) THEN
      RETURN TRY (mIREmitter__emit_orelse(&rtoc_self_view, node));
    ELSE_IF (node IS_A Conditional) THEN
      RETURN TRY (mIREmitter__emit_conditional(&rtoc_self_view, node));
    ELSE_IF (node IS_A IfOptional) THEN
      RETURN TRY (mIREmitter__emit_if_optional(&rtoc_self_view, node));
    ELSE_IF (node IS_A Comptime) THEN
      RETURN "comptime ${TRY (mIREmitter__emit(&rtoc_self_view, node.expr()))}";
    ELSE_IF (node IS_A UnionVariantGet) THEN
      RETURN "${mIREmitter__paren_if_try(rtoc_self_view, UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, node.object()))))}.${node.variant()}";
    ELSE_IF (node IS_A ListItems) THEN
      RETURN "${mIREmitter__paren_if_try(rtoc_self_view, UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, node.list()))))}.items";
    ELSE_IF (node IS_A ListLength) THEN
      RETURN "${mIREmitter__paren_if_try(rtoc_self_view, UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, node.expr()))))}.len";
    ELSE_IF (node IS_A AddressOf) THEN
      RETURN "&${TRY (mIREmitter__emit(&rtoc_self_view, node.expr()))}";
    ELSE_IF (node IS_A Deref) THEN
      RETURN "${TRY (mIREmitter__emit(&rtoc_self_view, node.expr()))}.*";
    ELSE_IF (node IS_A PointerCast) THEN
      RETURN TRY (mIREmitter__emit_pointer_cast(&rtoc_self_view, node));
    ELSE_IF (node IS_A ConstCast) THEN
      RETURN "@constCast(${TRY (mIREmitter__emit(&rtoc_self_view, node.expr()))})";
    ELSE_IF (node IS_A DefaultStreamCapacity) THEN
      RETURN TRY (mIREmitter__emit_default_stream_capacity(&rtoc_self_view, node));
    ELSE_IF (node IS_A NextPromiseList) THEN
      RETURN TRY (mIREmitter__emit_next_promise_list(&rtoc_self_view, node));
    ELSE_IF (node IS_A MIROptionalUnwrap) OR (node IS_A ForeignOwnedUnwrap) THEN
      RETURN "${mIREmitter__paren_if_try(rtoc_self_view, UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, node.expr()))))}.?";
    ELSE_IF (node IS_A CFunctionAdapter) THEN
      RETURN TRY (mIREmitter__emit_c_function_adapter(&rtoc_self_view, node));
    ELSE_IF (node IS_A ForeignSliceView) THEN
      RETURN "${TRY (mIREmitter__emit(&rtoc_self_view, node.pointer()))}[0..@intCast(${TRY (mIREmitter__emit(&rtoc_self_view, node.count()))})]";
    ELSE_IF (node IS_A AllocatorRef) THEN
      RETURN TRY (mIREmitter__emit_allocator_ref(rtoc_self_view, node));
    ELSE_IF (node IS_A Undef) THEN
      IF TRY (type__zig_type(CAST(node AS Type))) THEN
        RETURN "@as(${TRY (type__zig_type(CAST(node AS Type)))}, undefined)";
      ELSE
        RETURN "undefined";
      END
    ELSE_IF (node IS_A TypeSentinel) THEN
      RETURN mIREmitter__emit_type_sentinel(rtoc_self_view, node);
    ELSE_IF (node IS_A IterRange) THEN
      RETURN "${TRY (mIREmitter__emit(&rtoc_self_view, node.start()))}..${TRY (mIREmitter__emit(&rtoc_self_view, node.end_val()))}";
    ELSE_IF (node IS_A MIRRangeLit) THEN
      RETURN TRY (mIREmitter__emit_range_lit(&rtoc_self_view, node));
    ELSE_IF (node IS_A HasField) THEN
      RETURN TRY (mIREmitter__emit_has_field(&rtoc_self_view, node));
    ELSE_IF (node IS_A ItemsAccess) THEN
      RETURN TRY (mIREmitter__emit_items_access(&rtoc_self_view, node));
    ELSE_IF (node IS_A OwnedSlice) THEN
      RETURN TRY (mIREmitter__emit_owned_slice(&rtoc_self_view, node));
    ELSE_IF (node IS_A LambdaExpr) THEN
      RETURN TRY (mIREmitter__emit_lambda(&rtoc_self_view, node));
    ELSE_IF (node IS_A RegistryCall) THEN
      RETURN TRY (mIREmitter__emit_registry_call(&rtoc_self_view, node));
    ELSE_IF (node IS_A IndexedStore) THEN
      RETURN TRY (mIREmitter__emit_indexed_store(&rtoc_self_view, node));
    ELSE_IF (node IS_A ExternTrampoline) THEN
      RETURN TRY (mIREmitter__emit_extern_trampoline(&rtoc_self_view, node));
    ELSE_IF (node IS_A ObservableConsumerSpawn) THEN
      RETURN TRY (mIREmitter__emit_observable_consumer_spawn(&rtoc_self_view, node));
    ELSE_IF (node IS_A InlineBc) THEN
      RETURN TRY (mIREmitter__emit_inline_bc_as_zig(&rtoc_self_view, node));
    ELSE_IF (node IS_A ShardedMapPut) THEN
      RETURN TRY (mIREmitter__emit_sharded_map_put(&rtoc_self_view, node));
    ELSE_IF (node IS_A ShardedMapGet) THEN
      RETURN TRY (mIREmitter__emit_sharded_map_get(&rtoc_self_view, node));
    ELSE_IF (node IS_A ProtocolCall) THEN
      RETURN TRY (mIREmitter__emit_protocol_call(&rtoc_self_view, node));
    ELSE
      panic("MIREmitter: unknown node type {}");
    END
}
END
FN mIREmitter__emit_statements(MUTABLE self: MIREmitter, stmts: []Emittable) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN TRY (mIREmitter__emit_body(&rtoc_self_view, stmts));
}
END
FN mIREmitter__emit_bg_block(MUTABLE self: MIREmitter, node: MIRBgBlock) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE plan = COPY node.code;
    IF plan IS_A BgStackfulPlan AS bg_stackful_plan THEN
      MUTABLE bg_stackful_plan_mutable = COPY bg_stackful_plan;
      RETURN TRY (mIREmitter__emit_bg_stackful_plan(&rtoc_self_view, bg_stackful_plan_mutable));
    END
    IF plan IS_A BgStreamPlan AS bg_stream_plan THEN
      MUTABLE bg_stream_plan_mutable = COPY bg_stream_plan;
      RETURN TRY (mIREmitter__emit_bg_stream_plan(&rtoc_self_view, bg_stream_plan_mutable));
    END
    IF plan IS_A FutureMapPlan AS future_map_plan THEN
      MUTABLE future_map_plan_mutable = COPY future_map_plan;
      RETURN TRY (mIREmitter__emit_future_map_plan(&rtoc_self_view, future_map_plan_mutable));
    END
    IF mIREmitter__fsm_bg_body_plan?(rtoc_self_view, plan) THEN
      RETURN TRY (mIREmitter__emit_fsm_bg_body(rtoc_self_view, castBgBlockPlanToPlan(plan)));
    END
    panic("MIR::BgBlock must carry a structural emission plan, got {}");
}
END
FN mIREmitter__emit_direct_tense_map(MUTABLE self: MIREmitter, plan: DirectTenseMap) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN TRY (mIREmitter__emit_direct_tense_layers(rtoc_self_view, plan.layers, plan.bindings, UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, plan.source))), UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, plan.mapped))), plan.label));
}
END
FN mIREmitter__emit_direct_tense_layers(self: MIREmitter, layers: []String, bindings: []String, source: String, mapped: String, label: String) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (layers.length() == 0) THEN
      RETURN COPY mapped;
    END
    MUTABLE layer = COPY UNWRAP (layers.first());
    MUTABLE binding = COPY UNWRAP (bindings.first());
    MUTABLE tail = TRY (mIREmitter__emit_direct_tense_layers(rtoc_self_view, layers |> SKIP 1, bindings |> SKIP 1, binding, mapped, label));
    IF (layer == "!") THEN
      RETURN "${label}: {\n    const ${binding} = ${source} catch |__tense_err| break :${label} __tense_err;\n    break :${label} ${tail};\n}\n".trim();
    ELSE_IF (layer == "?") THEN
      RETURN "if (${source}) |${binding}| ${tail} else null";
    ELSE
      panic("unsupported immediate tense-map layer {}");
    END
}
END
FN mIREmitter__emit_future_map_plan(MUTABLE self: MIREmitter, plan: FutureMapPlan) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE source = UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, plan.source)));
    MUTABLE source_init: String = "";
    IF plan.source_shared THEN
      source_init = "(${source}).retain()";
    ELSE
      source_init = source;
    END
    MUTABLE run_body = (TRY (mIREmitter__emit_body_with_runtime(&rtoc_self_view, plan.run_body, plan.raw_rt))).replace("\n", "\n                  ");
    MUTABLE spawn_call = (TRY (mIREmitter__emit_fiber_spawn_call(rtoc_self_view, plan.spawn_call))).replace("\n", "\n          ");
    MUTABLE profile_comment = mIREmitter__emit_profile_task_site(rtoc_self_view, plan.profile_site);
    RETURN "${plan.blk_label}: {\n    ${profile_comment}\n    const ${plan.ctx_type} = struct {\n        inner: *${plan.promise_zig}.Inner,\n        alloc: std.mem.Allocator,\n        ${plan.source_field}: @TypeOf(${source}),\n        fn run(__raw_rt_map${plan.id.toString()}: *anyopaque, __raw_args_map${plan.id.toString()}: ?*anyopaque) anyerror!void {\n            const ${plan.raw_rt} = @as(*Runtime, @ptrCast(@alignCast(__raw_rt_map${plan.id.toString()})));\n            _ = &${plan.raw_rt};\n            const __ctx_map${plan.id.toString()} = @as(*@This(), @ptrCast(@alignCast(__raw_args_map${plan.id.toString()}.?)));\n            defer __ctx_map${plan.id.toString()}.alloc.destroy(__ctx_map${plan.id.toString()});\n            defer __ctx_map${plan.id.toString()}.inner.wg.done();\n            errdefer |fiber_err| __ctx_map${plan.id.toString()}.inner.result = fiber_err;\n            ${run_body}\n        }\n    };\n    const ${plan.alloc_var} = ${plan.rt_name}.heapAlloc();\n    const ${plan.promise_var} = try ${plan.promise_zig}.spawn(${plan.alloc_var}, ${plan.rt_name}.getSched());\n    const ${plan.ctx_var} = try ${plan.alloc_var}.create(${plan.ctx_type});\n    errdefer ${plan.alloc_var}.destroy(${plan.ctx_var});\n    ${plan.ctx_var}.* = .{\n        .inner = ${plan.promise_var}.inner,\n        .alloc = ${plan.alloc_var},\n        .${plan.source_field} = ${source_init},\n    };\n    ${spawn_call}\n    break :${plan.blk_label} ${plan.promise_var};\n}\n".trim();
}
END
FN mIREmitter__emit_bg_stackful_plan(MUTABLE self: MIREmitter, plan: BgStackfulPlan) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE run_body_raw = TRY (mIREmitter__emit_body_with_runtime(&rtoc_self_view, plan.run_body, plan.bg_rt));
    MUTABLE capture_frees_raw = TRY (mIREmitter__emit_capture_cleanup_actions_with_runtime(&rtoc_self_view, plan.capture_frees, plan.bg_rt));
    MUTABLE arena_init_raw: String = "";
    IF plan.arena_init EXISTS AS arena_init_value THEN
      arena_init_raw = TRY (mIREmitter__emit_node_with_runtime(&rtoc_self_view, arena_init_value, plan.bg_rt));
    ELSE
      arena_init_raw = "";
    END
    MUTABLE run_body_code = run_body_raw.replace("\n", "\n                  ");
    MUTABLE promoted_decls = (TRY (mIREmitter__emit_body(&rtoc_self_view, plan.promoted_decls))).replace("\n", "\n          ");
    MUTABLE capture_fields = (TRY (mIREmitter__emit_context_field_decls(&rtoc_self_view, plan.capture_fields))).replace("\n", "\n              ");
    MUTABLE capture_inits = TRY (mIREmitter__emit_struct_init_fields(&rtoc_self_view, plan.capture_inits));
    MUTABLE capture_frees = capture_frees_raw.replace("\n", "\n                  ");
    MUTABLE arena_init = COPY arena_init_raw;
    MUTABLE spawn_call = (TRY (mIREmitter__emit_fiber_spawn_call(rtoc_self_view, plan.spawn_call))).replace("\n", "\n          ");
    MUTABLE alloc_expr = UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, plan.alloc_expr)));
    MUTABLE profile_comment = mIREmitter__emit_profile_task_site(rtoc_self_view, plan.profile_site);
    MUTABLE suppress_line = mIREmitter__bg_stackful_runtime_suppress_line(rtoc_self_view, plan, run_body_raw, capture_frees_raw, arena_init_raw);
    RETURN ("${plan.blk_label}: {\n    ${profile_comment}\n    const ${plan.ctx_type} = struct {\n        inner: *${plan.promise_zig}.Inner,\n        alloc: std.mem.Allocator,\n        ${capture_fields}\n        fn run(__raw_rt_${plan.id.toString()}: *anyopaque, __raw_args_${plan.id.toString()}: ?*anyopaque) anyerror!void {\n            const ${plan.bg_rt} = @as(*Runtime, @ptrCast(@alignCast(__raw_rt_${plan.id.toString()})));\n            ${suppress_line}\n            ${arena_init}\n            const __ctx_${plan.id.toString()} = @as(*@This(), @ptrCast(@alignCast(__raw_args_${plan.id.toString()}.?)));\n            defer __ctx_${plan.id.toString()}.alloc.destroy(__ctx_${plan.id.toString()});\n            defer __ctx_${plan.id.toString()}.inner.wg.done();\n            errdefer |fiber_err| __ctx_${plan.id.toString()}.inner.result = fiber_err;\n            ${capture_frees}\n            ${run_body_code}\n            ${IF plan.is_void THEN
      "__ctx_${plan.id.toString()}.inner.result = {};"
    ELSE
      ""
    END}\n        }\n    };\n    const ${plan.alloc_var} = ${alloc_expr};\n    const ${plan.promise_var} = try ${plan.promise_zig}.spawn(${plan.alloc_var}, ${plan.rt_name}.getSched());\n    ${promoted_decls}\n    const ${plan.ctx_var} = try ${plan.alloc_var}.create(${plan.ctx_type});\n    errdefer ${plan.alloc_var}.destroy(${plan.ctx_var});\n    ${plan.ctx_var}.* = .{ ${capture_inits} };\n    ${spawn_call}\n    break :${plan.blk_label} ${plan.promise_var};\n}\n").trim();
}
END
FN mIREmitter__bg_stackful_runtime_suppress_line(self: MIREmitter, plan: BgStackfulPlan, run_body_code: String, capture_frees: String, arena_init: String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE text = ((run_body_code $+ capture_frees) $+ arena_init);
    IF text.contains?(plan.bg_rt) THEN
      RETURN "";
    ELSE
      RETURN "_ = &${plan.bg_rt};";
    END
}
END
FN mIREmitter__fsm_bg_body_plan?<T>(self: MIREmitter, plan: T) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ((T IS_A FsmIoBody OR T IS_A FsmB1Body) OR T IS_A FsmGenericBody);
}
END
FN mIREmitter__emit_fsm_bg_body(self: MIREmitter, plan: Plan) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (fsmWrapperEmitter__render(castPlanToFsmBody(plan)));
}
END
FN mIREmitter__emit_bg_stream_plan(MUTABLE self: MIREmitter, plan: BgStreamPlan) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE body_code = (TRY (mIREmitter__emit_body_with_runtime(&rtoc_self_view, plan.body, "__rt"))).replace("\n", "\n                  ");
    MUTABLE promoted_decls = (TRY (mIREmitter__emit_body_with_runtime(&rtoc_self_view, plan.promoted_decls, "__rt"))).replace("\n", "\n          ");
    MUTABLE capture_cleanups = (TRY (mIREmitter__emit_body_with_runtime(&rtoc_self_view, plan.capture_cleanups, "__rt"))).replace("\n", "\n                  ");
    MUTABLE capture_fields = (TRY (mIREmitter__emit_context_field_decls(&rtoc_self_view, plan.capture_fields))).replace("\n", "\n              ");
    MUTABLE capture_inits = TRY (mIREmitter__emit_struct_init_fields(&rtoc_self_view, plan.capture_inits));
    MUTABLE spawn_call = (TRY (mIREmitter__emit_fiber_spawn_call(rtoc_self_view, plan.spawn_call))).replace("\n", "\n          ");
    MUTABLE rt_suppress: String = "";
    IF body_code.contains?("__rt") THEN
      rt_suppress = "";
    ELSE
      rt_suppress = "_ = &__rt;";
    END
    RETURN "${plan.blk_label}: {\n    const ${plan.ctx_type} = struct {\n        stream_inner: *${plan.stream_zig}.Inner,\n        alloc: std.mem.Allocator,\n        ${capture_fields}\n        fn run(__raw_rt_sg${plan.id.toString()}: *anyopaque, __raw_args_sg${plan.id.toString()}: ?*anyopaque) anyerror!void {\n            const __rt = @as(*Runtime, @ptrCast(@alignCast(__raw_rt_sg${plan.id.toString()})));\n            ${rt_suppress}\n            const ctx = @as(*@This(), @ptrCast(@alignCast(__raw_args_sg${plan.id.toString()}.?)));\n            defer ctx.alloc.destroy(ctx);\n            ${capture_cleanups}\n            var ${plan.local_stream} = ${plan.stream_zig}{ .inner = ctx.stream_inner, .alloc = ctx.alloc };\n            defer ${plan.local_stream}.close();\n            errdefer |gen_err| ${plan.local_stream}.inner.err = gen_err;\n            ${body_code}\n        }\n    };\n    const ${plan.alloc_var} = ${plan.rt_name}.getSched().allocator;\n    const ${plan.stream_var} = try ${plan.stream_zig}.spawnNew(${plan.alloc_var}, ${plan.rt_name}.getSched());\n    ${promoted_decls}\n    const ${plan.ctx_var} = try ${plan.alloc_var}.create(${plan.ctx_type});\n    errdefer ${plan.alloc_var}.destroy(${plan.ctx_var});\n    ${plan.ctx_var}.* = .{ ${capture_inits} };\n    ${spawn_call}\n    break :${plan.blk_label} ${plan.stream_var};\n}\n".trim();
}
END
FN mIREmitter__emit_do_block(MUTABLE self: MIREmitter, node: MIRDoBlock) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE plan = COPY node.code;
    RETURN TRY (mIREmitter__emit_do_block_plan(&rtoc_self_view, plan));
}
END
FN mIREmitter__emit_do_block_plan(MUTABLE self: MIREmitter, plan: DoBlockPlan) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE branches = (plan.branches |> SELECT TRY (mIREmitter__emit_do_branch_plan(&rtoc_self_view, _))).join("\n");
    RETURN "{\n    var ${plan.wg_var} = CheatHeader.WaitGroup.init(${rtoc_self_view.rt_name}.getSched());\n    errdefer ${plan.wg_var}.wait();\n    ${branches}\n${plan.wg_var}.wait();\n}\n".trim();
}
END
FN mIREmitter__emit_do_branch_plan(MUTABLE self: MIREmitter, plan: DoBranchPlan) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE body_code = (TRY (mIREmitter__emit_body_with_runtime(&rtoc_self_view, plan.body, "__rt"))).replace("\n", "\n        ");
    MUTABLE capture_pre_decls = (TRY (mIREmitter__emit_body_with_runtime(&rtoc_self_view, plan.capture_pre_decls, "__rt"))).replace("\n", "\n        ");
    MUTABLE capture_fields = (TRY (mIREmitter__emit_context_field_decls(&rtoc_self_view, plan.capture_fields))).replace("\n", "\n      ");
    MUTABLE capture_inits = TRY (mIREmitter__emit_struct_init_fields(&rtoc_self_view, plan.capture_inits));
    MUTABLE spawn_call = (TRY (mIREmitter__emit_fiber_spawn_call(rtoc_self_view, plan.spawn_call))).replace("\n", "\n    ");
    MUTABLE rt_suppress: String = "";
    IF body_code.contains?("__rt") THEN
      rt_suppress = "";
    ELSE
      rt_suppress = "_ = &__rt;";
    END
    RETURN "const ${plan.ctx_type} = struct {\n    wg: *CheatHeader.WaitGroup,\n    ${capture_fields}\n    fn run(${plan.raw_rt_name}: *anyopaque, ${plan.raw_args_name}: ?*anyopaque) anyerror!void {\n        const __rt = @as(*Runtime, @ptrCast(@alignCast(${plan.raw_rt_name})));\n        ${rt_suppress}\n        const ctx = @as(*@This(), @ptrCast(@alignCast(${plan.raw_args_name}.?)));\n        defer ctx.wg.done();\n        ${body_code}\n    }\n};\n${capture_pre_decls}\nvar ${plan.ctx_var} = ${plan.ctx_type}{ ${capture_inits} };\n${spawn_call}\n${plan.wg_var}.add(1);\n".trim();
}
END
FN mIREmitter__emit_context_field_decls(MUTABLE self: MIREmitter, fields: []ContextFieldDecl) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN (fields |> SELECT {
    MUTABLE default: String = "";
      IF _.default_value EXISTS AS default_value_value THEN
        default = " = ${TRY (mIREmitter__emit(&rtoc_self_view, default_value_value))}";
      ELSE
        default = "";
      END
    "${_.name}: ${_.type_zig}${default},"
    }).join("\n");
}
END
FN mIREmitter__emit_struct_init_fields(MUTABLE self: MIREmitter, fields: []StructInitField) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN (fields |> SELECT ".${mIREmitter__zig_field_name(rtoc_self_view, Name{ SymbolValue: COPY _.name })} = ${TRY (mIREmitter__emit_struct_init_field_value(&rtoc_self_view, _.value))}").join(", ");
}
END
FN mIREmitter__emit_capture_cleanup_actions(MUTABLE self: MIREmitter, actions: []CaptureCleanupAction) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN (actions |> SELECT {
    MUTABLE allocator: ?String = IF _.allocator != NIL THEN
        TRY (mIREmitter__emit(&rtoc_self_view, (_.allocator)?))
      ELSE
        NIL
      END;
    "defer ${TRY (mIREmitter__emit_direct_cleanup(rtoc_self_view, UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, _.target))), KEEP _.cleanup_entry, allocator))}"
    }).join("\n");
}
END
FN mIREmitter__emit_profile_task_site(self: MIREmitter, site: ProfileTaskSite) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN "// CLEAR_PROFILE_TASK_SITE id=${site.site_id.toString()} kind=BG line=${site.line.toString()} column=${site.column.toString()} dispatch=${site.dispatch} form=${site.form}";
}
END
FN mIREmitter__emit_task_config_plan(self: MIREmitter, plan: TaskConfigPlan) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fields = [".stack_size = .${plan.stack_variant}"];
    IF plan.profile_site_id EXISTS AS profile_site_id_value THEN
      &fields.append(".profile_site_id = ${profile_site_id_value.toString()}");
    END
    IF plan.profile_dispatch_id EXISTS AS profile_dispatch_id_value THEN
      &fields.append(".profile_dispatch = ${profile_dispatch_id_value.toString()}");
    END
    RETURN ".{ ${fields.join(", ")} }";
}
END
FN mIREmitter__emit_fiber_spawn_call(self: MIREmitter, call: FiberSpawnCall) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE callee = PARTIAL MATCH call.target START
      :runtime_submit -> {
        MUTABLE rtoc_value_block_marker = 0;
        MUTABLE runtime_name = (call.runtime_name OR_ELSE CAST(panic("FiberSpawnCall runtime_name required") AS String));
        "try ${runtime_name}.getSched().submitSpawn"
      },
      :pinned -> "try CheatHeader.spawnPinned",
      :best -> "try CheatHeader.spawnBest",
      :wait_group_submit -> {
        MUTABLE rtoc_value_block_marker = 0;
        MUTABLE wait_group_name = (call.wait_group_name OR_ELSE CAST(panic("FiberSpawnCall wait_group_name required") AS String));
        "try ${wait_group_name}.sched.submitSpawn"
      },
      DEFAULT -> panic("unknown FiberSpawnCall target {}")
    END;
    MUTABLE task_cfg = mIREmitter__emit_task_config_plan(rtoc_self_view, call.task_config);
    MUTABLE ctx_arg: String = "";
    IF call.pass_ctx_by_address THEN
      ctx_arg = "&${call.ctx_var}";
    ELSE
      ctx_arg = COPY call.ctx_var;
    END
    RETURN "${callee}(\n    @intFromPtr(&Runtime.entryWrapper),\n    @as(CheatHeader.TaskFn, @ptrCast(&${call.ctx_type}.run)),\n    ${ctx_arg},\n    ${task_cfg}\n);\n".trim();
}
END
FN mIREmitter__emit_inline_bc_as_zig(MUTABLE self: MIREmitter, node: InlineBc) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE entry = node.stdlib_def;
    IF !(entry) THEN
      panic("emit_inline_bc_as_zig: node has no stdlib_def (:{})");
    END
    MUTABLE pattern = { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_mutable_receiver_3 = CAST(entry AS FunctionSignature);
    TRY (functionSignature__required_intrinsic_template(&rtoc_mutable_receiver_3, IntrinsicTemplateKind.Zig)) };
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < node.args.length() DO
    pattern = pattern.split("{${rtoc_idx}}").join(UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, node.args[rtoc_idx]?))));
    rtoc_idx = rtoc_idx + 1;
    END
    IF node.suppress_try THEN
      RETURN rtoc_delete_prefix(pattern, "try ");
    ELSE
      RETURN pattern;
    END
}
END
FN mIREmitter__emit_sharded_map_put(MUTABLE self: MIREmitter, node: ShardedMapPut) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE pattern = COPY (TRY (mIREmitter__sharded_map_template(rtoc_self_view, MIREmitterShardedMapNode{ ShardedMapPut: COPY node })));
    pattern = (pattern.replace("{target}", TRY (mIREmitter__emit(&rtoc_self_view, node.target)))).replace("&{target}", "&${TRY (mIREmitter__emit(&rtoc_self_view, node.target))}").replace("{index}", TRY (mIREmitter__emit(&rtoc_self_view, node.key))).replace("{value}", TRY (mIREmitter__emit(&rtoc_self_view, node.value)));
    RETURN TRY (mIREmitter__sharded_map_substitute_common(&rtoc_self_view, pattern, MIREmitterShardedMapNode{ ShardedMapPut: COPY node }));
}
END
FN mIREmitter__emit_sharded_map_get(MUTABLE self: MIREmitter, node: ShardedMapGet) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE pattern = COPY (TRY (mIREmitter__sharded_map_template(rtoc_self_view, MIREmitterShardedMapNode{ ShardedMapGet: COPY node })));
    pattern = (pattern.replace("{target}", TRY (mIREmitter__emit(&rtoc_self_view, node.target)))).replace("{index}", TRY (mIREmitter__emit(&rtoc_self_view, node.key)));
    RETURN TRY (mIREmitter__sharded_map_substitute_common(&rtoc_self_view, pattern, MIREmitterShardedMapNode{ ShardedMapGet: COPY node }));
}
END
FN mIREmitter__emit_protocol_call(MUTABLE self: MIREmitter, node: ProtocolCall) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !((node.protocol == :Map)) THEN
      panic("unsupported protocol call {}.{}");
    END
    MUTABLE receiver: ?String = TRY (mIREmitter__emit(&rtoc_self_view, node.receiver));
    MUTABLE arguments: []?String = node.args |> SELECT TRY (mIREmitter__emit(&rtoc_self_view, _));
    IF (node.operation == :get) THEN
      RETURN "CheatLib.mapProtocolGet(${receiver}, ${arguments[0]})";
    ELSE_IF (node.operation == :put) THEN
      RETURN "try CheatLib.mapProtocolPut(${receiver}, ${arguments[2]}, ${arguments[3]}, ${arguments[0]}, ${arguments[1]})";
    ELSE_IF (node.operation == :delete) THEN
      RETURN "CheatLib.mapProtocolDelete(${receiver}, ${arguments[1]}, ${arguments[0]})";
    ELSE_IF (node.operation == :contains) THEN
      RETURN "CheatLib.mapProtocolContains(${receiver}, ${arguments[0]})";
    ELSE_IF (node.operation == :count) THEN
      RETURN "CheatLib.mapProtocolCount(${receiver})";
    ELSE_IF (node.operation == :empty) THEN
      RETURN "(CheatLib.mapProtocolCount(${receiver}) == 0)";
    ELSE_IF (node.operation == :any) THEN
      RETURN "(CheatLib.mapProtocolCount(${receiver}) > 0)";
    ELSE
      panic("unsupported Map protocol operation {}");
    END
}
END
FN mIREmitter__emit_protocol_adapter_def(self: MIREmitter, node: ProtocolAdapterDef) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE facts_name = "__clearProtocolFacts_${node.protocol}";
    MUTABLE facts_cases = node.conformances |> SELECT mIREmitter__protocol_conformance_branch(rtoc_self_view, _, %(bindings: String) USE(node, _) -> {
    MUTABLE fields = (node.associated_types |> SELECT {
      MUTABLE value = COPY _.associated_types[_]?;
      "pub const ${_} = ${value};"
    }).join(" ");
    "${bindings}return struct { ${fields} };"
    });
    MUTABLE facts_body = ((facts_cases + ["@compileError(\"No ${node.protocol} conformance for \" ++ @typeName(T));"])).join("\n    ");
    MUTABLE facts = "fn ${facts_name}(comptime T: type) type {\n    ${facts_body}\n}";
    MUTABLE operations = node.requirements |> SELECT {
    MUTABLE params = (1 ..< _.argument_count) |> SELECT "arg${_}: anytype";
    MUTABLE all_params = (["comptime T: type", "rt: *Runtime", "self: anytype"] + params);
    MUTABLE branches = node.conformances |> SELECT:? { MUTABLE rtoc_value_block_marker = 0; MUTABLE target: ?String = COPY _.operations[_.name]; (IF !(target) THEN NIL ELSE mIREmitter__protocol_conformance_branch(rtoc_self_view, _, %(bindings: String) USE(target, _) -> {
      MUTABLE type_args = COPY _.type_params;
      MUTABLE call_args = ((type_args + ["rt", "self"]) + ((1 ..< _.argument_count) |> SELECT "arg${_}"));
      "${bindings}return ${target}(${call_args.join(", ")});"
    }) END) } |> WHERE _ != NIL;
    MUTABLE suppressions =   IF (branches.length() == 0) THEN
        ((["rt", "self"] + ((1 ..< _.argument_count) |> SELECT "arg${_}"))) |> SELECT "_ = ${_};"
      ELSE
        List[]
      END;
    MUTABLE body = (((suppressions + branches) + ["@compileError(\"No ${node.protocol}.${_.name} conformance for \" ++ @typeName(T));"])).join("\n    ");
    "fn __clearProtocol_${node.protocol}_${mIREmitter__protocol_zig_name(rtoc_self_view, _.name)}(${all_params.join(", ")}) ${_.return_type} {\n    ${body}\n}"
    };
    RETURN (([facts] + operations)).join("\n\n");
}
END
FN mIREmitter__protocol_conformance_branch(self: MIREmitter, conformance: ProtocolConformanceCase, block: FN(String) -> String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF conformance.owner_type EXISTS AS owner_type_value THEN
      RETURN "if (T == ${owner_type_value}) { ${block("")} }";
    END
    MUTABLE marker = COPY UNWRAP (conformance.owner_marker);
    MUTABLE bindings = ({
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE rtoc_indexed_items_4: []String = conformance.type_params;
    MUTABLE rtoc_indexed_output_6 = [];
    MUTABLE rtoc_indexed_i_5 = 0;
    WHILE rtoc_indexed_i_5 < rtoc_indexed_items_4.length() DO
      &rtoc_indexed_output_6.append("const ${rtoc_indexed_items_4[rtoc_indexed_i_5]} = T.__clear_type_args[${rtoc_indexed_i_5}]; ");
      rtoc_indexed_i_5 = rtoc_indexed_i_5 + 1;
    END
    rtoc_indexed_output_6
    }).join("");
    RETURN "if (comptime @typeInfo(T) == .@\"struct\" and @hasDecl(T, \"${marker}\")) { ${block(bindings)} }";
}
END
FN mIREmitter__protocol_zig_name(self: MIREmitter, name: String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (name.endsWith?("!") OR name.endsWith?("?")) THEN
      RETURN COPY name.substr(0, ((name.length() - 1) - 0));
    ELSE
      RETURN COPY name;
    END
}
END
FN mIREmitter__sharded_map_template(self: MIREmitter, node: MIREmitterShardedMapNode) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE op: FunctionSignature = NIL;
    MATCH node START
      MIREmitterShardedMapNode.ShardedMapPut AS item ->
        op = COPY item.stdlib_def;,
      MIREmitterShardedMapNode.ShardedMapGet AS item ->
        op = COPY item.stdlib_def;,
    END
    MUTABLE kind = (MATCH node START MIREmitterShardedMapNode.ShardedMapPut AS item -> item.template_kind, MIREmitterShardedMapNode.ShardedMapGet AS item -> item.template_kind END);
    IF TRY (functionSignature__intrinsic_template(&op, kind)) != NIL THEN
    RETURN TRY (functionSignature__intrinsic_template(&op, kind));
    ELSE
    panic("ShardedMap: op has no :{} template (contract={})");
    END
}
END
FN mIREmitter__sharded_map_substitute_common(MUTABLE self: MIREmitter, pattern_input: String, node: MIREmitterShardedMapNode) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE pattern = COPY pattern_input;
    IF (MATCH node START MIREmitterShardedMapNode.ShardedMapPut AS item -> item.shard_idx, MIREmitterShardedMapNode.ShardedMapGet AS item -> item.shard_idx END) THEN
      pattern = (pattern.replace("{shard_idx}", UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, (MATCH node START MIREmitterShardedMapNode.ShardedMapPut AS item -> item.shard_idx, MIREmitterShardedMapNode.ShardedMapGet AS item -> item.shard_idx END)))))).replace("{shard_key}", UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, (MATCH node START MIREmitterShardedMapNode.ShardedMapPut AS item -> item.shard_key, MIREmitterShardedMapNode.ShardedMapGet AS item -> item.shard_key END)))));
    END
    IF (MATCH node START MIREmitterShardedMapNode.ShardedMapPut AS item -> item.key_type, MIREmitterShardedMapNode.ShardedMapGet AS item -> item.key_type END) THEN
      pattern = pattern.replace("{key_zig}", (MATCH node START MIREmitterShardedMapNode.ShardedMapPut AS item -> TRY (type__zig_type(item.key_type)), MIREmitterShardedMapNode.ShardedMapGet AS item -> TRY (type__zig_type(item.key_type)) END));
    END
    IF (MATCH node START MIREmitterShardedMapNode.ShardedMapPut AS item -> item.value_type, MIREmitterShardedMapNode.ShardedMapGet AS item -> item.value_type END) THEN
      pattern = pattern.replace("{val_zig}", (MATCH node START MIREmitterShardedMapNode.ShardedMapPut AS item -> TRY (type__zig_type(item.value_type)), MIREmitterShardedMapNode.ShardedMapGet AS item -> TRY (type__zig_type(item.value_type)) END));
    END
    MUTABLE rtoc_local_receiver_7 = (MATCH node START MIREmitterShardedMapNode.ShardedMapPut AS item -> item.resolved_allocs, MIREmitterShardedMapNode.ShardedMapGet AS item -> item.resolved_allocs END);
    inlineAllocMetadata__each(rtoc_local_receiver_7, %(alloc_key: String@symbol, sym: String@symbol) USE(MUTABLE pattern, rtoc_self_view) -> {
    pattern = pattern.replace("{${alloc_key}}", TRY (mIREmitter__alloc_zig(rtoc_self_view, sym)));
    rubyToClearVoid()
    });
    RETURN COPY pattern;
}
END
PRIVATE FN mIREmitter__emit_registry_call(MUTABLE self: MIREmitter, node: RegistryCall) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE code = mIREmitter__registry_template(rtoc_self_view, KEEP node.entry, IntrinsicTemplateKind.Zig);
    code = TRY (mIREmitter__substitute_registry_common(rtoc_self_view, code, KEEP node.entry, KEEP node.allocs, node.key_type, node.value_type));
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < node.args.length() DO
      MUTABLE rendered = TRY (mIREmitter__coerce_registry_arg(rtoc_self_view, UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, node.args[rtoc_idx]?.expr))), node.args[rtoc_idx]?.coerce_type));
      code = code.replace("&{${rtoc_idx}}", "&${rendered}");
      code = code.replace("{${rtoc_idx}}", rendered);
    rtoc_idx = rtoc_idx + 1;
    END
    IF node.suppress_try THEN
      RETURN code.deletePrefix("try ");
    ELSE
      RETURN code;
    END
}
END
PRIVATE FN mIREmitter__emit_indexed_store(MUTABLE self: MIREmitter, node: IndexedStore) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE code = mIREmitter__registry_template(rtoc_self_view, KEEP node.entry, node.template_kind);
    code = TRY (mIREmitter__substitute_registry_common(rtoc_self_view, code, KEEP node.entry, KEEP node.allocs, node.key_type, node.value_type));
    MUTABLE target = UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, node.target)));
    MUTABLE index = UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, node.index)));
    MUTABLE value = UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, node.value)));
    RETURN code.replace("&{target}", "&${target}").replace("{target}", target).replace("{index}", index).replace("{value}", value);
}
END
PRIVATE FN mIREmitter__registry_template(self: MIREmitter, entry: FunctionSignature, template_kind: IntrinsicTemplateKind) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (functionSignature__required_intrinsic_template(&entry, template_kind));
}
END
PRIVATE FN mIREmitter__substitute_registry_common(self: MIREmitter, code: String, entry: FunctionSignature, allocs: ?InlineAllocMetadata, key_type: ?Type, value_type: ?Type) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE out = code.replace("{rt}", rtoc_self_view.rt_name);
    IF key_type EXISTS AS key_type_value THEN
      out = out.replace("{key_zig}", TRY (type__zig_type(key_type_value)));
    END
    IF value_type EXISTS AS value_type_value THEN
      out = out.replace("{val_zig}", TRY (type__zig_type(value_type_value)));
    END
    IF allocs != NIL THEN
        inlineAllocMetadata__each(allocs, %(key: String@symbol, sym: String@symbol) USE(MUTABLE out, rtoc_self_view) -> {
        out = out.replace("{${key}}", TRY (mIREmitter__alloc_zig(rtoc_self_view, sym)));
        rubyToClearVoid()
        });
    END
    RETURN out;
}
END
PRIVATE FN mIREmitter__coerce_registry_arg(self: MIREmitter, rendered_arg: String, coerce_type: ?String@symbol) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF coerce_type EXISTS AS coerce_type_value THEN
      MUTABLE coercible = [:Int64, :Float64, :Int32, :Int16, :Int8, :UInt64, :UInt32, :UInt16, :UInt8, :Bool];
      IF !(coercible.contains?(coerce_type_value)) THEN
        RETURN COPY rendered_arg;
      END
      RETURN "@as(${TRY (type__zig_type((TRY (type__new(TypeConstructionInput{ SymbolValue: COPY coerce_type_value })))))}, ${rendered_arg})";
    ELSE
      RETURN COPY rendered_arg;
    END
}
END
PRIVATE FN mIREmitter__emit_extern_trampoline(MUTABLE self: MIREmitter, node: ExternTrampoline) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE payload_t_branch_value: ?Type = NIL;
    IF type__error_union?(node.return_type) THEN
      payload_t_branch_value = UNWRAP (TRY (type__payload_type(node.return_type)));
    ELSE
      payload_t_branch_value = COPY node.return_type;
    END
    MUTABLE payload_t: Type = payload_t_branch_value?;
    MUTABLE returns_void = type__void?(payload_t);
    MUTABLE can_fail = type__error_union?(node.return_type);
    MUTABLE prefix: String = "";
    IF node.method_name EXISTS AS method_name_value THEN
      prefix = "__ExtM";
    ELSE
      prefix = "__Ext";
    END
    MUTABLE args_tuple_name: String = "";
    IF node.method_name EXISTS AS method_name_value THEN
      args_tuple_name = "__extm${node.id.toString()}_args";
    ELSE
      args_tuple_name = "__ext${node.id.toString()}_args";
    END
    MUTABLE frame_name: String = "";
    IF node.method_name EXISTS AS method_name_value THEN
      frame_name = "__extm${node.id.toString()}_frame";
    ELSE
      frame_name = "__ext${node.id.toString()}_frame";
    END
    MUTABLE runtime_arg_codes = node.runtime_args |> SELECT UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, _.expr)));
    MUTABLE comptime_codes = node.comptime_args |> SELECT UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, _)));
    MUTABLE arg_tuple: String = "";
    IF (runtime_arg_codes.length() == 0) THEN
      arg_tuple = ".{}";
    ELSE
      arg_tuple = ".{ ${runtime_arg_codes.join(", ")} }";
    END
    MUTABLE receiver_code: ?String = IF node.receiver != NIL THEN
      TRY (mIREmitter__emit(&rtoc_self_view, (node.receiver)?))
    ELSE
      NIL
    END;
    MUTABLE fields: []String = ( { MUTABLE rtoc_empty_list_8: []String = List[]; rtoc_empty_list_8 } );
    IF receiver_code EXISTS AS receiver_code_value THEN
      &fields.append("self_val: @TypeOf(${receiver_code_value})");
    END
    IF node.alloc_kind EXISTS AS alloc_kind_value THEN
      &fields.append("alloc: std.mem.Allocator");
    END
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < node.runtime_args.length() DO
      MUTABLE field_type: ?String = (IF node.runtime_args[rtoc_idx]?.field_zig_type != NIL THEN node.runtime_args[rtoc_idx]?.field_zig_type ELSE (IF node.runtime_args[rtoc_idx]?.field_type != NIL THEN
          TRY (type__zig_type((node.runtime_args[rtoc_idx]?.field_type), TRUE))
        ELSE
          NIL
        END) END);
      &fields.append("a${rtoc_idx}: ${(field_type OR_ELSE "@TypeOf(${args_tuple_name}[${rtoc_idx}])")}");
    rtoc_idx = rtoc_idx + 1;
    END
    IF can_fail THEN
      &fields.append("err: ?anyerror = null");
    END
    IF !(returns_void) THEN
      &fields.append("ret: ${TRY (type__zig_type(payload_t))} = undefined");
    END
    MUTABLE call_zig = mIREmitter__extern_trampoline_call(rtoc_self_view, node, comptime_codes, runtime_arg_codes.length());
    MUTABLE call_stmt: String = "";
    IF can_fail THEN
      IF returns_void THEN
        call_stmt = "${call_zig} catch |err| { f.err = err; return; };";
      ELSE
        call_stmt = "f.ret = (${call_zig} catch |err| { f.err = err; return; });";
      END
    ELSE
      IF returns_void THEN
        call_stmt = "${call_zig};";
      ELSE
        call_stmt = "f.ret = ${call_zig};";
      END
    END
    MUTABLE init_fields: []String = ( { MUTABLE rtoc_empty_list_9: []String = List[]; rtoc_empty_list_9 } );
    IF receiver_code EXISTS AS receiver_code_value THEN
      &init_fields.append(".self_val = ${receiver_code_value}");
    END
    runtime_arg_codes.each_index(%(index_value: String) USE(args_tuple_name, MUTABLE init_fields) -> &init_fields.append(".a${index_value} = ${args_tuple_name}[${index_value}]"));
    MUTABLE alloc_kind: ?String@symbol = COPY node.alloc_kind;
    IF alloc_kind EXISTS AS alloc_kind_value THEN
      MUTABLE alloc_expr = TRY (mIREmitter__alloc_zig(rtoc_self_view, alloc_kind_value));
      &init_fields.append(".alloc = ${alloc_expr}");
    END
    MUTABLE f_needed = !(!((((((((IF receiver_code != NIL THEN receiver_code ELSE node.alloc_kind END) OR (runtime_arg_codes |> ANY _))) OR !(returns_void))) OR can_fail))));
    MUTABLE f_binding: String = "";
    IF f_needed THEN
      f_binding = "const f: *@This() = @ptrCast(@alignCast(ptr));";
    ELSE
      f_binding = "_ = ptr;";
    END
    MUTABLE label = "blk_ext${node.id.toString()}";
    MUTABLE code: String = "";
    IF returns_void THEN
      code = "{ ";
    ELSE
      code = "${label}: { ";
    END
    IF node.runtime_args |> ANY _.expr IS_A CFunctionAdapter THEN
      code = (code + "const __previous_c_callback_rt = __clear_c_callback_rt; __clear_c_callback_rt = ${rtoc_self_view.rt_name}; defer __clear_c_callback_rt = __previous_c_callback_rt; ");
    END
    IF runtime_arg_codes |> ANY _ THEN
      code = (code + "const ${args_tuple_name} = ${arg_tuple}; ");
    END
    MUTABLE field_decls: String = "";
    IF (fields.length() == 0) THEN
      field_decls = "";
    ELSE
      field_decls = "${fields.join(", ")}, ";
    END
    code = (code + "const ${prefix}${node.id.toString()} = struct { ${field_decls}fn run(ptr: ?*anyopaque) callconv(.c) void { ${f_binding} ${call_stmt} } }; ");
    code = (code + "var ${frame_name} = ${prefix}${node.id.toString()}{ ${init_fields.join(", ")} }; ");
    code = (code + "${rtoc_self_view.rt_name}.onRootStack(@as(*const fn (?*anyopaque) callconv(.c) void, &${prefix}${node.id.toString()}.run), @ptrCast(&${frame_name})); ");
    IF can_fail THEN
      code = (code + "if (${frame_name}.err) |e| return e; ");
    END
    IF !(returns_void) THEN
      code = (code + "break :${label} ${frame_name}.ret; ");
    END
    RETURN (code $+ "}");
}
END
PRIVATE FN mIREmitter__emit_c_function_adapter(MUTABLE self: MIREmitter, node: CFunctionAdapter) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.uses_c_callback = TRUE;
    MUTABLE params = {
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE rtoc_indexed_items_10: []FunctionTypeParam = node.signature.params;
    MUTABLE rtoc_indexed_output_12 = [];
    MUTABLE rtoc_indexed_i_11 = 0;
    WHILE rtoc_indexed_i_11 < rtoc_indexed_items_10.length() DO
      &rtoc_indexed_output_12.append("a${rtoc_indexed_i_11}: ${TRY (type__zig_type(rtoc_indexed_items_10[rtoc_indexed_i_11].type, TRUE))}");
      rtoc_indexed_i_11 = rtoc_indexed_i_11 + 1;
    END
    rtoc_indexed_output_12
    };
    MUTABLE args = node.signature.params.each_index() |> SELECT "a${_}";
    MUTABLE clear_function = UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, node.clear_function))).deletePrefix("&");
    MUTABLE clear_call = "${clear_function}(__clear_c_callback_rt orelse @panic(\"C callback escaped its synchronous CLEAR call\")${IF (args.length() == 0) THEN
      ""
    ELSE
      ", ${args.join(", ")}"
    END})";
    MUTABLE return_type = COPY node.signature.return_type;
    MUTABLE body: String = "";
    IF type__void?(return_type) THEN
      body = "${clear_call} catch @panic(\"CLEAR error crossed a C callback\");";
    ELSE
      body = "return ${clear_call} catch @panic(\"CLEAR error crossed a C callback\");";
    END
    RETURN "&struct { fn run(${params.join(", ")}) callconv(.c) ${TRY (type__zig_type(return_type))} { ${body} } }.run";
}
END
PRIVATE FN mIREmitter__extern_trampoline_call(self: MIREmitter, node: ExternTrampoline, comptime_codes: []String, runtime_arg_count: Int64) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF node.method_name EXISTS AS method_name_value THEN
      MUTABLE args = List[];
      IF node.alloc_kind EXISTS AS alloc_kind_value THEN
        &args.append("f.alloc");
      END
      runtime_arg_count.times(%(index_value) USE(MUTABLE args) -> {
    &args.append("f.a${index_value}");
    rubyToClearVoid()
      });
      RETURN "f.self_val.${method_name_value}(${args.join(", ")})";
    END
    MUTABLE mod_prefix: String = "";
    IF node.module_alias EXISTS AS module_alias_value THEN
      mod_prefix = "${(UNWRAP (module_alias_value)).replace(".", "_")}.";
    ELSE
      mod_prefix = "";
    END
    MUTABLE parts = COPY comptime_codes;
    IF node.alloc_kind EXISTS AS alloc_kind_value THEN
      &parts.append("f.alloc");
    END
    runtime_arg_count.times(%(index_value) USE(MUTABLE parts) -> {
    &parts.append("f.a${index_value}");
    rubyToClearVoid()
    });
    RETURN "${mod_prefix}${node.callee_name}(${parts.join(", ")})";
}
END
PRIVATE FN mIREmitter__emit_observable_consumer_spawn(MUTABLE self: MIREmitter, node: ObservableConsumerSpawn) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE ctx_type = "__ObsConsumerCtx${node.id.toString()}";
    MUTABLE fiber_rt = "__rt_obs_${node.id.toString()}";
    MUTABLE body = TRY (mIREmitter__emit_body_with_runtime(&rtoc_self_view, node.body, fiber_rt));
    body = mIREmitter__replace_emit_identifier(rtoc_self_view, mIREmitter__replace_emit_identifier(rtoc_self_view, body, node.acc_name, "ctx.acc"), node.source_name, "ctx.gen");
    MUTABLE rt_name = COPY node.runtime_name;
    RETURN ("const ${ctx_type} = struct {\n        acc: ${TRY (type__zig_type(node.acc_type))},\n        gen: @TypeOf(${node.source_name}),\n        fn run(__raw_rt_obs_${node.id.toString()}: *anyopaque, __raw_args_obs_${node.id.toString()}: ?*anyopaque) anyerror!void {\n            const ${fiber_rt} = @as(*Runtime, @ptrCast(@alignCast(__raw_rt_obs_${node.id.toString()})));\n            ${IF body.contains?(fiber_rt) THEN
      ""
    ELSE
      "_ = &${fiber_rt};"
    END}\n            const ctx = @as(*@This(), @ptrCast(@alignCast(__raw_args_obs_${node.id.toString()}.?)));\n            defer ctx.acc.finish();\n            ${body}\n        }\n    };\n    try CheatHeader.spawnObservableConsumerCtx(\n        ${ctx_type},\n        ${rt_name},\n        .{ .acc = ${node.acc_name}, .gen = ${node.source_name} },\n        @as(CheatHeader.TaskFn, @ptrCast(&${ctx_type}.run)),\n        .{ .stack_size = .${node.task_config_variant} }\n    )\n").trim();
}
END
PRIVATE FN mIREmitter__emit_shard_concurrent_each(MUTABLE self: MIREmitter, node: ShardConcurrentEach) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE id = node.id;
    MUTABLE idx_var = "__sh${id.toString()}_i";
    MUTABLE key_var = "__sh${id.toString()}_key";
    MUTABLE sh_var = "__sh${id.toString()}_sh";
    MUTABLE map_ptr = "__sh${id.toString()}_map";
    MUTABLE key_zig = TRY (type__zig_type(node.key_type));
    MUTABLE shard_count = node.shard_count;
    MUTABLE string_key = !(TRY (type__numeric_map?(node.map_type)));
    MUTABLE body_zig = TRY (mIREmitter__emit_body_with_runtime(&rtoc_self_view, node.body, "__rt"));
    MUTABLE worker_body: String = "";
    IF body_zig.contains?("__rt") THEN
      worker_body = body_zig;
    ELSE
      worker_body = "_ = &__rt;\n${body_zig}";
    END
    MUTABLE producer_key_body = TRY (mIREmitter__emit_body(&rtoc_self_view, node.producer_key_body));
    MUTABLE capture_setup = TRY (mIREmitter__emit_body(&rtoc_self_view, node.capture_setup));
    MUTABLE capture_fields = TRY (mIREmitter__emit_shard_worker_capture_fields(&rtoc_self_view, node, map_ptr));
    MUTABLE capture_inits = TRY (mIREmitter__emit_shard_worker_capture_inits(&rtoc_self_view, node, map_ptr));
    MUTABLE key_loop_mark: String = "";
    IF node.key_allocates_frame THEN
      key_loop_mark = "const __sh${id.toString()}_key_mark = rt.saveLoopMark();\ndefer rt.restoreLoopMark(__sh${id.toString()}_key_mark);";
    ELSE
      key_loop_mark = "";
    END
    MUTABLE body_loop_mark: String = "";
    IF node.body_allocates_frame THEN
      body_loop_mark = "const __sh${id.toString()}_body_mark = __rt.saveLoopMark();\ndefer __rt.restoreLoopMark(__sh${id.toString()}_body_mark);";
    ELSE
      body_loop_mark = "";
    END
    MUTABLE key_store_expr: String = "";
    IF string_key THEN
      key_store_expr = "try rt.heapAlloc().dupe(u8, ${key_var})";
    ELSE
      key_store_expr = key_var;
    END
    MUTABLE key_free_work = mIREmitter__shard_key_free_work(rtoc_self_view, id, string_key);
    MUTABLE key_free_success: String = "";
    IF string_key THEN
      key_free_success = "__rt.heapAlloc().free(${key_var});";
    ELSE
      key_free_success = "";
    END
    MUTABLE key_free_remaining: String = "";
    IF string_key THEN
      key_free_remaining = "errdefer for (__work.keys[__sh${id.toString()}_ki..]) |__k| __rt.heapAlloc().free(__k);";
    ELSE
      key_free_remaining = "";
    END
    MUTABLE key_slice_cleanup: String = "";
    IF string_key THEN
      key_slice_cleanup = "for (__sh${id.toString()}_keys) |__k| rt.heapAlloc().free(__k);";
    ELSE
      key_slice_cleanup = "";
    END
    MUTABLE pending_batch_cleanup: String = "";
    IF string_key THEN
      pending_batch_cleanup = "for (__sh${id.toString()}_batches[__s].items) |__k| rt.heapAlloc().free(__k);";
    ELSE
      pending_batch_cleanup = "";
    END
    MUTABLE op_str: String = "";
    IF node.inclusive THEN
      op_str = "<=";
    ELSE
      op_str = "<";
    END
    RETURN "{\n    const ${map_ptr} = &${TRY (mIREmitter__emit(&rtoc_self_view, node.map_expr))};\n    ${map_ptr}.ensureOwnership();\n    const __sh${id.toString()}_cap: usize = ${TRY (mIREmitter__emit(&rtoc_self_view, node.capacity_expr))};\n    const __sh${id.toString()}_batch: usize = @max(@as(usize, ${TRY (mIREmitter__emit(&rtoc_self_view, node.batch_size_expr))}), 1);\n    const __ShWork${id.toString()} = struct {\n        keys: []${key_zig},\n    };\n    const __ShCleanup${id.toString()} = struct {\n${mIREmitter__indent_block(rtoc_self_view, mIREmitter__emit_shard_cleanup_buffered(rtoc_self_view, id, string_key), 12)}\n    };\n    var __sh${id.toString()}_chans: [${shard_count.toString()}]CheatLib.BoundedChannel(__ShWork${id.toString()}) = undefined;\n    for (0..${shard_count.toString()}) |__s| {\n        __sh${id.toString()}_chans[__s] = try CheatLib.BoundedChannel(__ShWork${id.toString()}).init(rt.heapAlloc(), __sh${id.toString()}_cap);\n    }\n    defer for (0..${shard_count.toString()}) |__s| __sh${id.toString()}_chans[__s].deinit();\n${mIREmitter__indent_block(rtoc_self_view, capture_setup, 4)}\n    var __sh${id.toString()}_wg = CheatHeader.WaitGroup.init(rt.getSched());\n    var __sh${id.toString()}_err = std.atomic.Value(bool).init(false);\n    const __ShWorker${id.toString()} = struct {\n        wg: *CheatHeader.WaitGroup,\n        chans: *[${shard_count.toString()}]CheatLib.BoundedChannel(__ShWork${id.toString()}),\n        err: *std.atomic.Value(bool),\n        shard: usize,\n${mIREmitter__indent_block(rtoc_self_view, capture_fields, 8)}\n        fn run(raw_rt: *anyopaque, raw_args: ?*anyopaque) anyerror!void {\n            const __rt = @as(*Runtime, @ptrCast(@alignCast(raw_rt)));\n            const ctx = @as(*@This(), @ptrCast(@alignCast(raw_args.?)));\n            defer ctx.wg.done();\n            errdefer {\n                ctx.err.store(true, .release);\n                for (0..${shard_count.toString()}) |__s| ctx.chans[__s].setError(error.CheatError);\n            }\n            while (ctx.chans[ctx.shard].pop() catch |__err| {\n                ctx.err.store(true, .release);\n                for (0..${shard_count.toString()}) |__s| ctx.chans[__s].setError(__err);\n                return __err;\n            }) |__work| {\n                errdefer {\n${mIREmitter__indent_block(rtoc_self_view, key_free_work, 24)}\n                }\n                var __sh${id.toString()}_ki: usize = 0;\n                while (__sh${id.toString()}_ki < __work.keys.len) : (__sh${id.toString()}_ki += 1) {\n${mIREmitter__indent_block(rtoc_self_view, key_free_remaining, 24)}\n                    const ${key_var}: ${key_zig} = __work.keys[__sh${id.toString()}_ki];\n${mIREmitter__indent_block(rtoc_self_view, body_loop_mark, 24)}\n${mIREmitter__indent_block(rtoc_self_view, worker_body, 24)}\n${mIREmitter__indent_block(rtoc_self_view, key_free_success, 24)}\n                }\n                __rt.heapAlloc().free(__work.keys);\n                __rt.checkYield();\n            }\n        }\n    };\n    var __sh${id.toString()}_workers: [${shard_count.toString()}]__ShWorker${id.toString()} = undefined;\n    __sh${id.toString()}_wg.add(${shard_count.toString()});\n    for (0..${shard_count.toString()}) |__s| {\n        __sh${id.toString()}_workers[__s] = .{ .wg = &__sh${id.toString()}_wg, .chans = &__sh${id.toString()}_chans, .err = &__sh${id.toString()}_err, .shard = __s${capture_inits} };\n        try CheatHeader.spawnBest(\n            @intFromPtr(&Runtime.entryWrapper),\n            @as(CheatHeader.TaskFn, @ptrCast(&__ShWorker${id.toString()}.run)),\n            &__sh${id.toString()}_workers[__s],\n            .{ .stack_size = .${node.task_config_variant} },\n        );\n    }\n\n    var __sh${id.toString()}_batches: [${shard_count.toString()}]std.ArrayListUnmanaged(${key_zig}) = [_]std.ArrayListUnmanaged(${key_zig}){.empty} ** ${shard_count.toString()};\n    defer for (0..${shard_count.toString()}) |__s| {\n${mIREmitter__indent_block(rtoc_self_view, pending_batch_cleanup, 12)}\n        __sh${id.toString()}_batches[__s].deinit(rt.heapAlloc());\n    };\n\n    var ${idx_var}: i64 = ${TRY (mIREmitter__emit(&rtoc_self_view, node.start_expr))};\n    const __sh${id.toString()}_end: i64 = ${TRY (mIREmitter__emit(&rtoc_self_view, node.finish_expr))};\n    while ((${idx_var} ${op_str} __sh${id.toString()}_end) and !__sh${id.toString()}_err.load(.acquire)) : (${idx_var} += 1) {\n${mIREmitter__indent_block(rtoc_self_view, key_loop_mark, 12)}\n${mIREmitter__indent_block(rtoc_self_view, producer_key_body, 12)}\n        const ${sh_var} = @TypeOf(${map_ptr}.*).shardIndexWithHash(${key_var});\n        try __sh${id.toString()}_batches[${sh_var}.shard].append(rt.heapAlloc(), ${key_store_expr});\n        if (__sh${id.toString()}_batches[${sh_var}.shard].items.len >= __sh${id.toString()}_batch) {\n            const __sh${id.toString()}_keys = try __sh${id.toString()}_batches[${sh_var}.shard].toOwnedSlice(rt.heapAlloc());\n            const __sh${id.toString()}_work = __ShWork${id.toString()}{ .keys = __sh${id.toString()}_keys };\n            __sh${id.toString()}_chans[${sh_var}.shard].push(__sh${id.toString()}_work) catch |__err| {\n${mIREmitter__indent_block(rtoc_self_view, key_slice_cleanup, 20)}\n                rt.heapAlloc().free(__sh${id.toString()}_keys);\n                __sh${id.toString()}_err.store(true, .release);\n                for (0..${shard_count.toString()}) |__s| __sh${id.toString()}_chans[__s].setError(__err);\n                break;\n            };\n        }\n    }\n    for (0..${shard_count.toString()}) |__s| {\n        if (__sh${id.toString()}_batches[__s].items.len > 0 and !__sh${id.toString()}_err.load(.acquire)) {\n            const __sh${id.toString()}_keys = try __sh${id.toString()}_batches[__s].toOwnedSlice(rt.heapAlloc());\n            const __sh${id.toString()}_work = __ShWork${id.toString()}{ .keys = __sh${id.toString()}_keys };\n            __sh${id.toString()}_chans[__s].push(__sh${id.toString()}_work) catch |__err| {\n${mIREmitter__indent_block(rtoc_self_view, key_slice_cleanup, 20)}\n                rt.heapAlloc().free(__sh${id.toString()}_keys);\n                __sh${id.toString()}_err.store(true, .release);\n                for (0..${shard_count.toString()}) |__ss| __sh${id.toString()}_chans[__ss].setError(__err);\n                break;\n            };\n        }\n    }\n    for (0..${shard_count.toString()}) |__s| __sh${id.toString()}_chans[__s].close();\n    __sh${id.toString()}_wg.wait();\n    for (0..${shard_count.toString()}) |__s| __ShCleanup${id.toString()}.cleanupBuffered(&__sh${id.toString()}_chans[__s], rt);\n    if (__sh${id.toString()}_err.load(.acquire)) return error.CheatError;\n}\n".trim();
}
END
PRIVATE FN mIREmitter__emit_shard_worker_capture_fields(MUTABLE self: MIREmitter, node: ShardConcurrentEach, map_ptr: String) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fields: []String = ["__shard_map: *@TypeOf(${map_ptr}.*),"];
    MUTABLE rendered = TRY (mIREmitter__emit_context_field_decls(&rtoc_self_view, node.capture_fields));
    IF !((rendered.length() == 0)) THEN
      &fields.append(rendered);
    END
    RETURN fields.join("\n");
}
END
PRIVATE FN mIREmitter__emit_shard_worker_capture_inits(MUTABLE self: MIREmitter, node: ShardConcurrentEach, map_ptr: String) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fields = [".__shard_map = ${map_ptr}"];
    MUTABLE rendered = TRY (mIREmitter__emit_struct_init_fields(&rtoc_self_view, node.capture_inits));
    IF !((rendered.length() == 0)) THEN
      &fields.append(rendered);
    END
    RETURN ", ${fields.join(", ")}";
}
END
PRIVATE FN mIREmitter__emit_shard_cleanup_buffered(self: MIREmitter, id: Int64, string_key: Bool) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE key_cleanup: String = "";
    IF string_key THEN
      key_cleanup = "for (__work.keys) |__k| __rt.heapAlloc().free(__k);\n__rt.heapAlloc().free(__work.keys);";
    ELSE
      key_cleanup = "__rt.heapAlloc().free(__work.keys);";
    END
    RETURN "fn cleanupBuffered(chan: *CheatLib.BoundedChannel(__ShWork${id.toString()}), __rt: *Runtime) void {\n    const inner = chan.inner;\n    inner.mutex.lock();\n    while (inner.tail != inner.head) {\n        const __work = inner.buf[inner.tail & inner.mask];\n        inner.tail += 1;\n${mIREmitter__indent_block(rtoc_self_view, key_cleanup, 12)}\n    }\n    inner.mutex.unlock();\n}\n".trim();
}
END
PRIVATE FN mIREmitter__shard_key_free_work(self: MIREmitter, id: Int64, string_key: Bool) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(string_key) THEN
      RETURN "__rt.heapAlloc().free(__work.keys);";
    END
    RETURN "for (__work.keys) |__k| __rt.heapAlloc().free(__k);\n__rt.heapAlloc().free(__work.keys);";
}
END
PRIVATE FN mIREmitter__emit_body_with_runtime(MUTABLE self: MIREmitter, stmts: []Emittable, runtime_name: String) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE prior_rt_name: String = COPY rtoc_self_view.rt_name;
  DEFER rtoc_self_view.rt_name = prior_rt_name;
  rtoc_self_view.rt_name = COPY runtime_name;
  RETURN TRY (mIREmitter__emit_body(&rtoc_self_view, stmts));
}
END
PRIVATE FN mIREmitter__emit_node_with_runtime(MUTABLE self: MIREmitter, node: Emittable, runtime_name: String) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE prior_rt_name: String = COPY rtoc_self_view.rt_name;
  DEFER rtoc_self_view.rt_name = prior_rt_name;
  rtoc_self_view.rt_name = COPY runtime_name;
  RETURN UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, node)));
}
END
PRIVATE FN mIREmitter__emit_capture_cleanup_actions_with_runtime(MUTABLE self: MIREmitter, actions: []CaptureCleanupAction, runtime_name: String) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE prior_rt_name: String = COPY rtoc_self_view.rt_name;
  DEFER rtoc_self_view.rt_name = prior_rt_name;
  rtoc_self_view.rt_name = COPY runtime_name;
  RETURN TRY (mIREmitter__emit_capture_cleanup_actions(&rtoc_self_view, actions));
}
END
PRIVATE FN mIREmitter__replace_emit_identifier(self: MIREmitter, source: String, needle: String, replacement: String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (needle.length() == 0) THEN
      RETURN COPY source;
    END
    MUTABLE idx = 0;
    MUTABLE needle_len = needle.bytes();
    MUTABLE result = "";
    WHILE (idx < source.bytes()) DO
      IF (((source.byteslice(idx, needle_len) == needle) AND mIREmitter__emit_identifier_boundary?(rtoc_self_view, source, (idx - 1))) AND mIREmitter__emit_identifier_boundary?(rtoc_self_view, source, (idx + needle_len))) THEN
        &result.append(COPY replacement);
        idx = (idx + needle_len);
      ELSE
        &result.append(source.byteslice(idx, 1));
        idx = (idx + 1);
      END
    END
    RETURN result;
}
END
PRIVATE FN mIREmitter__emit_identifier_boundary?(self: MIREmitter, source: String, index_value: Int64) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF ((index_value < 0) OR (index_value >= source.bytes())) THEN
      RETURN TRUE;
    END
    MUTABLE byte = source.getbyte(index_value);
    IF !(byte) THEN
      RETURN TRUE;
    END
    RETURN !((((((((byte >= 48) AND (byte <= 57))) OR (((byte >= 65) AND (byte <= 90)))) OR (((byte >= 97) AND (byte <= 122)))) OR (byte == 95))));
}
END
PRIVATE FN mIREmitter__emit_snapshot_read(MUTABLE self: MIREmitter, node: SnapshotRead) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE body = TRY (mIREmitter__emit_body(&rtoc_self_view, node.body));
    MUTABLE cell_unwrap = UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, node.cell_unwrap)));
    MUTABLE parts = ["var ${node.guard_var} = ${cell_unwrap}.*.read(${node.rt});", "defer ${node.guard_var}.release();", "const ${node.alias_name} = ${node.guard_var}.get();", "_ = &${node.alias_name};"];
    IF !((body.length() == 0)) THEN
      &parts.append(body);
    END
    RETURN parts.join("\n");
}
END
PRIVATE FN mIREmitter__emit_capability_unwrap(MUTABLE self: MIREmitter, node: CapabilityUnwrap) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE source = UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, node.source)));
    MUTABLE is_ptr = "@typeInfo(@TypeOf(${source})) == .pointer";
    MUTABLE inner_t = "@typeInfo(@TypeOf(${source})).pointer.child";
    RETURN "(if (comptime ${is_ptr}) (if (comptime @typeInfo(${inner_t}) == .@\"struct\") (if (comptime @hasDecl(${inner_t}, \"__clear_ref_carrier\")) ${source}.ctrl.data else ${source}) else (if (comptime @typeInfo(${inner_t}) == .pointer) (if (comptime @typeInfo(@typeInfo(${inner_t}).pointer.child) == .@\"struct\") (if (comptime @hasDecl(@typeInfo(${inner_t}).pointer.child, \"__clear_ref_carrier\")) ${source}.*.ctrl.data else ${source}.*) else ${source}.*) else ${source})) else (if (comptime @typeInfo(@TypeOf(${source})) == .@\"struct\") (if (comptime @hasDecl(@TypeOf(${source}), \"__clear_ref_carrier\")) ${source}.ctrl.data else &${source}) else &${source}))";
}
END
PRIVATE FN mIREmitter__emit_capability_lock_target(MUTABLE self: MIREmitter, node: CapabilityLockTarget) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE source = UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, node.source)));
    IF node.comptime_arc_unwrap THEN
      RETURN mIREmitter__comptime_arc_unwrap_expr(rtoc_self_view, source);
    END
    IF node.arc_wrapped THEN
      RETURN "${source}.ctrl.data.*";
    END
    RETURN source;
}
END
PRIVATE FN mIREmitter__emit_capability_lock_address(MUTABLE self: MIREmitter, node: CapabilityLockAddress) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE source = UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, node.source)));
    IF node.arc_wrapped THEN
      RETURN "${source}.ctrl.data";
    ELSE
      RETURN "&${source}";
    END
}
END
PRIVATE FN mIREmitter__comptime_arc_unwrap_expr(self: MIREmitter, source: String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE base_t = "@TypeOf(${source})";
    RETURN "(if (comptime @typeInfo(${base_t}) == .pointer) (if (comptime @typeInfo(@typeInfo(${base_t}).pointer.child) == .@\"struct\") (if (comptime @hasDecl(@typeInfo(${base_t}).pointer.child, \"__clear_ref_carrier\")) ${source}.*.ctrl.data.* else ${source}.*) else ${source}.*) else (if (comptime @typeInfo(${base_t}) == .@\"struct\") (if (comptime @hasDecl(${base_t}, \"__clear_ref_carrier\")) ${source}.ctrl.data.* else ${source}) else ${source}))";
}
END
PRIVATE FN mIREmitter__emit_polymorphic_mutate(MUTABLE self: MIREmitter, node: PolymorphicMutate) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE captures = TRY (mIREmitter__polymorphic_read_captures(rtoc_self_view, node.body, [node.alias_name]));
    IF !(captures.contains?(CAST(node.rt AS String))) THEN
      &captures.unshift(CAST(node.rt AS String));
    END
    MUTABLE overrides = TRY (mIREmitter__polymorphic_capture_overrides(rtoc_self_view, captures));
    MUTABLE guard_captures = TRY (mIREmitter__polymorphic_move_guard_captures(rtoc_self_view, node.body, [node.alias_name]));
    MUTABLE guard_overrides = TRY (mIREmitter__polymorphic_move_guard_overrides(rtoc_self_view, guard_captures, captures.length()));
    MUTABLE body_zig = mIREmitter__with_move_guard_overrides(&rtoc_self_view, guard_overrides, %() USE(node, overrides, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_15 = mIREmitter__with_ident_overrides(&rtoc_self_view, overrides, %() USE(node, overrides, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_14 = mIREmitter__with_runtime_name(&rtoc_self_view, UNWRAP (overrides[CAST(node.rt AS String)]), %() USE(node, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_13 = TRY (mIREmitter__emit_body(&rtoc_self_view, node.body));
    rtoc_lambda_result_13
    });
    rtoc_lambda_result_14
    });
    rtoc_lambda_result_15
    });
    MUTABLE cell_zig = UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, node.cell)));
    MUTABLE capture_param: String = "";
    IF (captures.length() == 0) THEN
      capture_param = "";
    ELSE
      capture_param = ", __captures: anytype";
    END
    MUTABLE capture_suppress: String = "";
    IF (captures.length() == 0) THEN
      capture_suppress = "";
    ELSE
      capture_suppress = "_ = &__captures;";
    END
    MUTABLE all_capture_args = (captures + (guard_captures |> SELECT "&${mIREmitter__move_guard_name(rtoc_self_view, Name{ StringValue: COPY _ })}"));
    MUTABLE capture_args: String = "";
    IF all_capture_args.empty?() THEN
      capture_args = ".{}";
    ELSE
      capture_args = ".{.{${all_capture_args.join(", ")}}}";
    END
    RETURN regexReplaceAll("try CheatLib.polymorphicMutate(${cell_zig}, ${node.rt}, struct {\n    fn run(${node.alias_name}: *${TRY (type__zig_type(CAST(node.bare_type AS Type)))}${capture_param}) !void {\n        _ = &${node.alias_name};\n        ${capture_suppress}\n        ${body_zig}\n    }\n}.run, ${capture_args});\n", "\\s+\\z", "");
}
END
PRIVATE FN mIREmitter__emit_polymorphic_mutate_flow(MUTABLE self: MIREmitter, node: PolymorphicMutateFlow) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE old_flow_alias: ?String = COPY rtoc_self_view.flow_alias_name;
    rtoc_self_view.flow_alias_name = node.alias_name;
    MUTABLE cell_zig = UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, node.cell)));
    MUTABLE captures = TRY (mIREmitter__polymorphic_read_captures(rtoc_self_view, ((node.body) + ((node.guard_fail_body OR List[]))), [node.alias_name, "__flow"]));
    IF !(captures.contains?(CAST(node.rt AS String))) THEN
      &captures.unshift(CAST(node.rt AS String));
    END
    MUTABLE overrides = TRY (mIREmitter__polymorphic_capture_overrides(rtoc_self_view, captures));
    MUTABLE all_bodies = ((node.body) + ((node.guard_fail_body OR List[])));
    MUTABLE guard_captures = TRY (mIREmitter__polymorphic_move_guard_captures(rtoc_self_view, all_bodies, [node.alias_name, "__flow"]));
    MUTABLE guard_overrides = TRY (mIREmitter__polymorphic_move_guard_overrides(rtoc_self_view, guard_captures, captures.length()));
    MUTABLE body_zig = mIREmitter__with_move_guard_overrides(&rtoc_self_view, guard_overrides, %() USE(node, overrides, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_18 = mIREmitter__with_ident_overrides(&rtoc_self_view, overrides, %() USE(node, overrides, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_17 = mIREmitter__with_runtime_name(&rtoc_self_view, UNWRAP (overrides[CAST(node.rt AS String)]), %() USE(node, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_16 = TRY (mIREmitter__emit_body_flow(&rtoc_self_view, node.body, :ret_commit));
    rtoc_lambda_result_16
    });
    rtoc_lambda_result_17
    });
    rtoc_lambda_result_18
    });
    MUTABLE capture_param: String = "";
    IF (captures.length() == 0) THEN
      capture_param = "";
    ELSE
      capture_param = ", __captures: anytype";
    END
    MUTABLE capture_suppress: String = "";
    IF (captures.length() == 0) THEN
      capture_suppress = "";
    ELSE
      capture_suppress = "_ = &__captures;";
    END
    MUTABLE all_capture_args = (captures + (guard_captures |> SELECT "&${mIREmitter__move_guard_name(rtoc_self_view, Name{ StringValue: COPY _ })}"));
    MUTABLE capture_args: String = "";
    IF all_capture_args.empty?() THEN
      capture_args = ".{&__poly_flow}";
    ELSE
      capture_args = ".{&__poly_flow, .{${all_capture_args.join(", ")}}}";
    END
    MUTABLE guard_block = "";
    IF node.guard_cond THEN
      MUTABLE fail_zig = mIREmitter__with_move_guard_overrides(&rtoc_self_view, guard_overrides, %() USE(node, overrides, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_21 = mIREmitter__with_ident_overrides(&rtoc_self_view, overrides, %() USE(node, overrides, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_20 = mIREmitter__with_runtime_name(&rtoc_self_view, UNWRAP (overrides[CAST(node.rt AS String)]), %() USE(node, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_19 = TRY (mIREmitter__emit_body_flow(&rtoc_self_view, (node.guard_fail_body OR List[]), :ret_no_commit));
    rtoc_lambda_result_19
      });
    rtoc_lambda_result_20
      });
    rtoc_lambda_result_21
      });
      IF !(mIREmitter__flow_body_terminates?(rtoc_self_view, (node.guard_fail_body OR List[]))) THEN
        fail_zig = (fail_zig + "\n__flow.* = .{ .kind = .skip_no_commit };\nreturn;");
      END
      guard_block = "if (!(${mIREmitter__with_ident_overrides(&rtoc_self_view, overrides, %() USE(node, overrides, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_23 = mIREmitter__with_runtime_name(&rtoc_self_view, UNWRAP (overrides[CAST(node.rt AS String)]), %() USE(node, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_22 = TRY (mIREmitter__emit(&rtoc_self_view, node.guard_cond));
    rtoc_lambda_result_22
      });
    rtoc_lambda_result_23
      })})) {\n    ${mIREmitter__indent_block(rtoc_self_view, fail_zig, 12)}\n}\n";
    END
    MUTABLE fallthrough_arm: String = "";
    IF mIREmitter__flow_always_exits?(rtoc_self_view, node) THEN
      fallthrough_arm = "unreachable";
    ELSE
      fallthrough_arm = "{}";
    END
    MUTABLE result = regexReplaceAll(("const __PolyFlow = struct {\n    kind: enum { cont_commit, skip_no_commit, ret_commit, ret_no_commit, raise_no_commit },\n    ret: ${TRY (type__zig_type(CAST(node.return_type AS Type)))} = undefined,\n};\nvar __poly_flow = __PolyFlow{ .kind = .cont_commit };\ntry CheatLib.polymorphicMutateFlow(${cell_zig}, ${node.rt}, struct {\n    fn run(${node.alias_name}: *${TRY (type__zig_type(CAST(node.bare_type AS Type)))}, __flow: *__PolyFlow${capture_param}) !void {\n        _ = &${node.alias_name};\n        ${capture_suppress}\n        ${guard_block}\n        ${body_zig}\n        ${IF mIREmitter__flow_body_terminates?(rtoc_self_view, node.body) THEN
      ""
    ELSE
      "__flow.* = .{ .kind = .cont_commit };"
    END}\n    }\n}.run, ${capture_args});\nswitch (__poly_flow.kind) {\n    .ret_commit, .ret_no_commit => return __poly_flow.ret,\n    .raise_no_commit => return error.CheatError,\n    .cont_commit, .skip_no_commit => ${fallthrough_arm},\n}\n"), "\\s+\\z", "");
    rtoc_self_view.flow_alias_name = old_flow_alias;
    RETURN result;
}
END
PRIVATE FN mIREmitter__polymorphic_read_captures(self: MIREmitter, body: []Emittable, excluded: []String) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE declared: [Set]String = excluded |> DISTINCT _;
    MUTABLE used: []String = ( { MUTABLE rtoc_empty_list_24: []String = List[]; rtoc_empty_list_24 } );
    mIR__each_node(NodeRoot{ ArrayValue: COPY body }, %(part: Emittable) USE(MUTABLE declared, MUTABLE used) -> {
    IF part IS_A Let AS let THEN
        &declared.insert(COPY CAST(let.name AS String));
    END
    IF part IS_A Ident AS ident THEN
        MUTABLE name = COPY ident.name;
        IF !(used.contains?(name)) THEN
          &used.append(name);
        END
    END
    rubyToClearVoid()
    });
    RETURN used |> WHERE !(declared.contains?(_));
}
END
PRIVATE FN mIREmitter__polymorphic_capture_overrides(self: MIREmitter, captures_value: []String) RETURNS !{String}String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN {
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE rtoc_indexed_items_25: []String = captures_value;
    MUTABLE rtoc_indexed_output_27 = {};
    MUTABLE rtoc_indexed_i_26 = 0;
    WHILE rtoc_indexed_i_26 < rtoc_indexed_items_25.length() DO
      MUTABLE rtoc_indexed_pair_28 = [rtoc_indexed_items_25[rtoc_indexed_i_26], "__captures[${rtoc_indexed_i_26}]"];
      rtoc_indexed_output_27[rtoc_indexed_pair_28._0] = rtoc_indexed_pair_28._1;
      rtoc_indexed_i_26 = rtoc_indexed_i_26 + 1;
    END
    rtoc_indexed_output_27
    };
}
END
PRIVATE FN mIREmitter__polymorphic_move_guard_captures(self: MIREmitter, body: []Emittable, excluded: []String) RETURNS ![]String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE declared: [Set]String = excluded |> DISTINCT _;
    MUTABLE moved: []String = ( { MUTABLE rtoc_empty_list_29: []String = List[]; rtoc_empty_list_29 } );
    mIR__each_node(NodeRoot{ ArrayValue: COPY body }, %(part: Emittable) USE(MUTABLE declared, MUTABLE moved) -> {
    IF part IS_A Let AS let THEN
        &declared.insert(COPY CAST(let.name AS String));
    END
    IF !(part IS_A MoveMark) THEN
        RETURN;
    END
    MUTABLE name = COPY CAST(part.name() AS String);
    IF !((declared.contains?(name) OR moved.contains?(name))) THEN
        &moved.append(name);
    END
    rubyToClearVoid()
    });
    RETURN moved;
}
END
PRIVATE FN mIREmitter__polymorphic_move_guard_overrides(self: MIREmitter, captures_value: []String, offset: Int64) RETURNS !{String}String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN {
    MUTABLE rtoc_value_block_marker = 0;
    MUTABLE rtoc_indexed_items_30: []String = captures_value;
    MUTABLE rtoc_indexed_output_32 = {};
    MUTABLE rtoc_indexed_i_31 = 0;
    WHILE rtoc_indexed_i_31 < rtoc_indexed_items_30.length() DO
      MUTABLE rtoc_indexed_pair_33 = [rtoc_indexed_items_30[rtoc_indexed_i_31], "__captures[${(offset + rtoc_indexed_i_31).toString()}].*"];
      rtoc_indexed_output_32[rtoc_indexed_pair_33._0] = rtoc_indexed_pair_33._1;
      rtoc_indexed_i_31 = rtoc_indexed_i_31 + 1;
    END
    rtoc_indexed_output_32
    };
}
END
PRIVATE FN mIREmitter__with_ident_overrides<U>(MUTABLE self: MIREmitter, overrides: {String}String, blk: FN() -> U) RETURNS U
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE previous: {String}String = COPY rtoc_self_view.ident_overrides;
  DEFER rtoc_self_view.ident_overrides = previous;
  rtoc_self_view.ident_overrides = overrides.keys() |> REDUCE(COPY previous) { acc[_] = COPY UNWRAP (overrides[_]); acc };
  RETURN blk();
}
END
PRIVATE FN mIREmitter__with_move_guard_overrides<U>(MUTABLE self: MIREmitter, overrides: {String}String, blk: FN() -> U) RETURNS U
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE previous: {String}String = COPY rtoc_self_view.move_guard_overrides;
  DEFER rtoc_self_view.move_guard_overrides = previous;
  rtoc_self_view.move_guard_overrides = overrides.keys() |> REDUCE(COPY previous) { acc[_] = COPY UNWRAP (overrides[_]); acc };
  RETURN blk();
}
END
PRIVATE FN mIREmitter__with_runtime_name<U>(MUTABLE self: MIREmitter, runtime_name: String, blk: FN() -> U) RETURNS U
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE previous: String = COPY rtoc_self_view.rt_name;
  DEFER rtoc_self_view.rt_name = previous;
  rtoc_self_view.rt_name = COPY runtime_name;
  RETURN blk();
}
END
PRIVATE FN mIREmitter__with_heap_allocator_cache<U>(MUTABLE self: MIREmitter, cache_name: ?String, runtime_name: ?String, blk: FN() -> U) RETURNS U
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE previous_name: ?String = COPY rtoc_self_view.heap_allocator_cache_name;
  MUTABLE previous_runtime: ?String = COPY rtoc_self_view.heap_allocator_cache_runtime_name;
  DEFER mIREmitter__restore_heap_allocator_cache(&rtoc_self_view, cache_name, previous_name, previous_runtime);
  IF cache_name EXISTS AS cache_name_value THEN
      RETURN &rtoc_self_view.heap_allocator_cache_names.append(COPY cache_name_value);
  END
  rtoc_self_view.heap_allocator_cache_name = COPY cache_name;
  rtoc_self_view.heap_allocator_cache_runtime_name = COPY runtime_name;
  RETURN blk();
}
END
PRIVATE FN mIREmitter__restore_heap_allocator_cache(MUTABLE self: MIREmitter, cache_name: ?String, previous_name: ?String, previous_runtime: ?String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF cache_name EXISTS AS cache_name_value THEN
      &rtoc_self_view.heap_allocator_cache_names.pop();
    END
    rtoc_self_view.heap_allocator_cache_name = COPY previous_name;
    rtoc_self_view.heap_allocator_cache_runtime_name = COPY previous_runtime;
}
END
PRIVATE FN mIREmitter__emit_body_flow(MUTABLE self: MIREmitter, stmts: []Emittable, return_kind: String@symbol) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN (stmts |> SELECT:? TRY (mIREmitter__emit_flow_stmt(&rtoc_self_view, _, return_kind)) |> WHERE _ != NIL).join("\n");
}
END
PRIVATE FN mIREmitter__emit_flow_stmt(MUTABLE self: MIREmitter, stmt: Emittable, return_kind: String@symbol) RETURNS !?String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF stmt IS_A ReturnStmt AS return_stmt THEN
      MUTABLE return_stmt_mutable = COPY return_stmt;
      MUTABLE ret = IF return_stmt_mutable.value THEN
        TRY (mIREmitter__emit(&rtoc_self_view, return_stmt_mutable.value))
      ELSE
        "{}"
      END;
      IF ((rtoc_self_view.flow_alias_name != NIL) AND (ret == (rtoc_self_view.flow_alias_name)?)) THEN
        ret = "${ret}.*";
      END
      RETURN "__flow.* = .{ .kind = .${return_kind}, .ret = ${ret} };\nreturn;";
    ELSE_IF stmt IS_A ScopeBlock AS scope_block THEN
      MUTABLE scope_block_mutable = COPY scope_block;
      MUTABLE inner = TRY (mIREmitter__emit_body_flow(&rtoc_self_view, scopeBlock__body(scope_block_mutable), return_kind));
      RETURN "{\n${mIREmitter__indent_block(rtoc_self_view, inner, 4)}\n}";
    ELSE_IF stmt IS_A IfStmt AS if_stmt THEN
      MUTABLE if_stmt_mutable = COPY if_stmt;
      MUTABLE then_zig = TRY (mIREmitter__emit_body_flow(&rtoc_self_view, (if_stmt_mutable.then_body OR List[]), return_kind));
      MUTABLE else_zig = TRY (mIREmitter__emit_body_flow(&rtoc_self_view, (if_stmt_mutable.else_body OR List[]), return_kind));
      MUTABLE else_body = if_stmt_mutable.else_body;
      IF (else_body AND !(else_body.empty?())) THEN
        RETURN "if (${TRY (mIREmitter__emit(&rtoc_self_view, if_stmt_mutable.cond))}) {\n${mIREmitter__indent_block(rtoc_self_view, then_zig, 4)}\n} else {\n${mIREmitter__indent_block(rtoc_self_view, else_zig, 4)}\n}";
      ELSE
        RETURN "if (${TRY (mIREmitter__emit(&rtoc_self_view, if_stmt_mutable.cond))}) {\n${mIREmitter__indent_block(rtoc_self_view, then_zig, 4)}\n}";
      END
    ELSE_IF stmt IS_A PolymorphicFlowSignal AS polymorphic_flow_signal THEN
      MUTABLE polymorphic_flow_signal_mutable = COPY polymorphic_flow_signal;
      RETURN TRY (mIREmitter__emit_polymorphic_flow_signal(&rtoc_self_view, polymorphic_flow_signal_mutable));
    ELSE
      RETURN TRY (mIREmitter__emit(&rtoc_self_view, stmt));
    END
}
END
PRIVATE FN mIREmitter__emit_polymorphic_flow_signal(MUTABLE self: MIREmitter, node: PolymorphicFlowSignal) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE fields = [".kind = .${node.kind}"];
    IF node.ret THEN
      &fields.append(".ret = ${TRY (mIREmitter__emit(&rtoc_self_view, node.ret))}");
    END
    RETURN "__flow.* = .{ ${fields.join(", ")} };\nreturn;";
}
END
PRIVATE FN mIREmitter__flow_body_terminates?(self: MIREmitter, stmts: []Emittable) RETURNS Bool
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((TRUE AND !((stmts.length() == 0)))) THEN
      RETURN FALSE;
    END
    MUTABLE last: ?Emittable = COPY stmts.last();
    IF last IS_A ReturnStmt AS return_stmt THEN
      RETURN TRUE;
    ELSE_IF last IS_A PolymorphicFlowSignal AS polymorphic_flow_signal THEN
      RETURN TRUE;
    ELSE_IF last IS_A ScopeBlock AS scope_block THEN
      RETURN mIREmitter__flow_body_terminates?(rtoc_self_view, scopeBlock__body(scope_block));
    ELSE_IF last IS_A IfStmt AS if_stmt THEN
      IF !(mIREmitter__flow_body_terminates?(rtoc_self_view, (if_stmt.then_body OR List[]))) THEN
        RETURN FALSE;
      END
      MUTABLE else_body = if_stmt.else_body;
      IF !((else_body AND !(else_body.empty?()))) THEN
        RETURN FALSE;
      END
      RETURN mIREmitter__flow_body_terminates?(rtoc_self_view, else_body);
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN mIREmitter__flow_always_exits?(self: MIREmitter, node: PolymorphicMutateFlow) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE body_exits = mIREmitter__flow_body_terminates?(rtoc_self_view, node.body);
    IF !(node.guard_cond) THEN
      RETURN body_exits;
    END
    RETURN (body_exits AND mIREmitter__flow_body_terminates?(rtoc_self_view, (node.guard_fail_body OR List[])));
}
END
PRIVATE FN mIREmitter__indent_block(self: MIREmitter, code: String, spaces: Int64) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE pad = compilerRepeatString(" ", spaces);
    RETURN regexReplaceAll((code.split("\n") |> SELECT (IF (_.trim().length() == 0) THEN
      _
    ELSE
      "${pad}${_}"
    END)).join(""), "\\s+\\z", "");
}
END
PRIVATE FN mIREmitter__emit_snapshot_transaction(MUTABLE self: MIREmitter, node: SnapshotTransaction) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE body_zig = TRY (mIREmitter__emit_body(&rtoc_self_view, node.body));
    MUTABLE cell_unwrap = UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, node.cell_unwrap)));
    MUTABLE alloc = TRY (mIREmitter__alloc_zig(rtoc_self_view, node.alloc));
    MUTABLE core = regexReplaceAll("${cell_unwrap}.*.update(${node.rt}, ${alloc}, struct {\n    fn run(${node.alias_name}: *${TRY (type__zig_type(CAST(node.bare_type AS Type)))}) void {\n        _ = &${node.alias_name};\n        ${body_zig}\n    }\n}.run, .{})\n", "\\s+\\z", "");
    MUTABLE zig_error_name: String = "";
    IF node.is_atomic_ptr THEN
      zig_error_name = "AtomicConflict";
    ELSE
      zig_error_name = "UpdateRetriesExhausted";
    END
    RETURN TRY (mIREmitter__wrap_conflict_handler(&rtoc_self_view, core, castEmittableToOptionalFailureAction(node.conflict_action), node.retries, zig_error_name));
}
END
PRIVATE FN mIREmitter__emit_snapshot_multi_txn(MUTABLE self: MIREmitter, node: SnapshotMultiTxn) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE body_zig = TRY (mIREmitter__emit_body(&rtoc_self_view, node.body));
    MUTABLE cells_tuple = ".{ ${(node.cells) |> SELECT UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, _))).join(", ")} }";
    MUTABLE alloc = TRY (mIREmitter__alloc_zig(rtoc_self_view, node.alloc));
    MUTABLE alias_decls = unsupportedRuby("CallNode at 1585:18: each_with_index requires a statically typed collection").join("\n            ");
    MUTABLE core = regexReplaceAll("CheatLib.versionedUpdateMulti(${cells_tuple}, ${node.rt}, ${alloc}, struct {\n    fn run(views: anytype) anyerror!void {\n        ${alias_decls}\n        ${body_zig}\n    }\n}.run, .{})\n", "\\s+\\z", "");
    RETURN TRY (mIREmitter__wrap_conflict_handler(&rtoc_self_view, core, castEmittableToOptionalFailureAction(node.conflict_action), node.retries));
}
END
PRIVATE FN mIREmitter__emit_with_match_dispatch(MUTABLE self: MIREmitter, node: WithMatchDispatch) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE cell_zig = UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, node.cell)));
    MUTABLE arms = node.arms;
    MUTABLE arm_strs = unsupportedRuby("CallNode at 1607:15: each_with_index requires a statically typed collection");
    MUTABLE chain = (arm_strs.join(" ") + " else { unreachable; }");
    RETURN "${chain}\n_ = &${cell_zig};";
}
END
PRIVATE FN mIREmitter__emit_with_match_probe(self: MIREmitter, family: String@symbol, cell_zig: String, snapshot_mode: Bool) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE inner_t = "CheatLib.WithMatchInner(@TypeOf(${cell_zig}))";
    IF (family == :VERSIONED) THEN
      IF snapshot_mode THEN
        RETURN "(@hasDecl(${inner_t}, \"Inner\") and !@hasDecl(${inner_t}, \"compareAndPublish\"))";
      ELSE
        RETURN "@hasDecl(${inner_t}, \"Inner\")";
      END
    ELSE_IF (family == :LOCKED) THEN
      RETURN "@hasField(${inner_t}, \"mutex\")";
    ELSE_IF (family == :ATOMIC) THEN
      IF snapshot_mode THEN
        RETURN "@hasDecl(${inner_t}, \"compareAndPublish\")";
      ELSE
        RETURN "@hasDecl(${inner_t}, \"cmpxchgStrong\")";
      END
    ELSE
      panic("WITH MATCH: no probe for family {}");
    END
}
END
PRIVATE FN mIREmitter__emit_with_match_prelude(MUTABLE self: MIREmitter, arm: MIRWithMatchArm, cell_zig: String, alias_name: String, rt_name: String, snapshot_mode: Bool) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE unwrap = TRY (mIREmitter__emit_capability_unwrap(&rtoc_self_view, CapabilityUnwrap{ source: Emittable{ Ident: COPY Ident{ name: COPY cell_zig, lowered_node_id: NIL, ownership_consumption: NIL } }, lowered_node_id: NIL, ownership_consumption: NIL }));
    IF (arm.family == :VERSIONED) THEN
      RETURN mIREmitter__emit_with_match_guard_prelude(rtoc_self_view, unwrap, arm.guard_var, alias_name, rt_name, :read);
    ELSE_IF (arm.family == :LOCKED) THEN
      RETURN mIREmitter__emit_with_match_guard_prelude(rtoc_self_view, unwrap, arm.guard_var, alias_name, rt_name, :acquire);
    ELSE_IF (arm.family == :ATOMIC) THEN
      IF snapshot_mode THEN
        RETURN mIREmitter__emit_with_match_guard_prelude(rtoc_self_view, unwrap, arm.guard_var, alias_name, rt_name, :read);
      ELSE
        RETURN "const ${alias_name} = ${unwrap};\n_ = &${alias_name};";
      END
    ELSE
      RETURN "";
    END
}
END
PRIVATE FN mIREmitter__emit_with_match_guard_prelude(self: MIREmitter, unwrap: String, guard_var: String, alias_name: String, rt_name: String, mode: String@symbol) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE call: String = "";
    IF (mode == :read) THEN
      call = "read(${rt_name})";
    ELSE
      call = "acquire()";
    END
    RETURN (["var ${guard_var} = ${unwrap}.*.${call};", "defer ${guard_var}.release();", "const ${alias_name} = ${guard_var}.get();", "_ = &${alias_name};"]).join("\n");
}
END
PRIVATE FN mIREmitter__wrap_conflict_handler(MUTABLE self: MIREmitter, core_call: String, conflict_action: ?FailureAction, retries: ?Int64, zig_error_name: String = "UpdateRetriesExhausted") RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE action_zig: String = "";
    IF conflict_action EXISTS AS conflict_action_value THEN
      action_zig = TRY (mIREmitter__emit_failure_action(&rtoc_self_view, conflict_action_value));
    ELSE
      action_zig = "return error.${zig_error_name};";
    END
    IF retries EXISTS AS retries_value THEN
      RETURN regexReplaceAll("{\n    var __retry: usize = 0;\n    __snap_retry: while (true) : (__retry += 1) {\n        if (${core_call}) |_| {\n            break :__snap_retry;\n        } else |__err| switch (__err) {\n            error.${zig_error_name} => {\n                if (__retry + 1 < ${retries_value.toString()}) continue;\n                ${action_zig}\n            },\n            else => return __err,\n        }\n    }\n}\n", "\\s+\\z", "");
    ELSE
      RETURN regexReplaceAll("${core_call} catch |__err| switch (__err) {\n    error.${zig_error_name} => { ${action_zig} },\n    else => return __err,\n};\n", "\\s+\\z", "");
    END
}
END
PRIVATE FN mIREmitter__emit_failure_action(MUTABLE self: MIREmitter, action: FailureAction) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE kind = COPY action.kind;
    MUTABLE error_name = COPY CAST(action.error_type AS String);
    IF (kind IS_A Raise) THEN
      RETURN "${action.rt_name}.setError(.${action.error_kind}, @intFromEnum(ErrorName.${error_name}), ${mIREmitter__zig_string_literal(rtoc_self_view, action.default_message)}, ${action.line});\nreturn error.CheatError;";
    ELSE_IF (kind == FailureActionKind.Exit) THEN
      MUTABLE message: String = "";
      IF action.message EXISTS AS message_value THEN
        message = UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, message_value)));
      ELSE
        message = mIREmitter__zig_string_literal(rtoc_self_view, action.default_message);
      END
      RETURN "${action.rt_name}.setError(.${action.error_kind}, @intFromEnum(ErrorName.${error_name}), ${message}, ${action.line});\nreturn error.CheatError;";
    ELSE_IF (kind == FailureActionKind.Pass) THEN
      RETURN "break :${TRY (mIREmitter__required_failure_label(rtoc_self_view, action))};";
    ELSE_IF (kind IS_A Return) THEN
      RETURN "return ${UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, UNWRAP (action.return_value))))};";
    ELSE_IF (kind == FailureActionKind.Block) THEN
      RETURN "${TRY (mIREmitter__emit_body(&rtoc_self_view, action.body))}\nbreak :${TRY (mIREmitter__required_failure_label(rtoc_self_view, action))};";
    ELSE
      panic("unknown failure action kind: {}");
    END
}
END
PRIVATE FN mIREmitter__required_failure_label(self: MIREmitter, action: FailureAction) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE label: ?String = COPY action.with_label;
    IF label EXISTS AS label_value THEN
      RETURN label_value;
    ELSE
      panic("failure action requires a WITH label");
    END
}
END
PRIVATE FN mIREmitter__zig_string_literal(self: MIREmitter, text: String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN text.dump();
}
END
PRIVATE FN mIREmitter__symbol_literal_name(MUTABLE self: MIREmitter, value: String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE existing: ?String = COPY rtoc_self_view.symbol_literals[value];
    IF existing EXISTS AS existing_value THEN
      RETURN COPY existing_value;
    END
    MUTABLE name = "__clear_symbol_${rtoc_self_view.symbol_literals.count()}";
    rtoc_self_view.symbol_literals[value] = name;
    RETURN name;
}
END
PRIVATE FN mIREmitter__zig_byte_string_literal(self: MIREmitter, text: String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE escaped = (text.bytes() |> SELECT PARTIAL MATCH _ START
      92 -> "\\\\",
      34 -> "\\\"",
      10 -> "\\n",
      13 -> "\\r",
      9 -> "\\t",
      0 -> "\\x00",
      1 ..= 31 -> "\\x${compilerFormatTemplate("%02x")}",
      127 -> "\\x${compilerFormatTemplate("%02x")}",
      128 ..= 255 -> "\\x${compilerFormatTemplate("%02x")}",
      DEFAULT -> codepointToString(_)
    END).join("");
    RETURN "\"${escaped}\"";
}
END
PRIVATE FN mIREmitter__emit_fallible_lock_binding(MUTABLE self: MIREmitter, node: FallibleLockBinding) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN (["var ${node.guard_var} = ${TRY (mIREmitter__emit_fallible_lock_acquire_expr(&rtoc_self_view, node))};", "defer ${node.guard_var}.release();", "const ${node.alias_name} = ${node.guard_var}.get();", "_ = &${node.alias_name};"]).join("\n");
}
END
PRIVATE FN mIREmitter__emit_fallible_lock_acquire_expr(MUTABLE self: MIREmitter, node: FallibleLockBinding) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE handler = TRY (mIREmitter__emit_fallible_lock_error_handler(&rtoc_self_view, castEmittableToFailureAction(node.action), node.retries, (node.matched_types OR List[]), (node.bubble_types OR List[]), node.rt_name, CAST(node.source_line AS String)));
    MUTABLE acquire_call = UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, node.acquire_call)));
    IF node.retries THEN
      RETURN regexReplaceAll("${node.acquire_block}: {\n  var __retry: usize = 0;\n  while (true) : (__retry += 1) {\n    if (${acquire_call}) |__g| {\n      break :${node.acquire_block} __g;\n    } else |__err| {\n      ${handler}\n    }\n  }\n}\n", "\\s+\\z", "");
    ELSE
      RETURN regexReplaceAll("${node.acquire_block}: {\n  if (${acquire_call}) |__g| {\n    break :${node.acquire_block} __g;\n  } else |__err| {\n    ${handler}\n  }\n}\n", "\\s+\\z", "");
    END
}
END
PRIVATE FN mIREmitter__emit_fallible_lock_error_handler(MUTABLE self: MIREmitter, action: FailureAction, retries: ?Int64, matched_types: []String@symbol, bubble_types: []String@symbol, rt_name: String, source_line: String) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE action_zig = TRY (mIREmitter__emit_failure_action(&rtoc_self_view, action));
    MUTABLE matched_arms = matched_types |> SELECT {
    MUTABLE matched_errs = "error.${TRY (aST__zig_name_of_type(_))}";
    MUTABLE body: String = "";
      IF retries EXISTS AS retries_value THEN
        body = "if (__retry + 1 < ${retries_value.toString()}) continue;\n${action_zig}";
      ELSE
        body = action_zig;
      END
    "${matched_errs} => { ${body} }"
    };
    MUTABLE bubble_arms = bubble_types |> SELECT {
    MUTABLE zig: ?String = TRY (aST__zig_name_of_type(_));
    MUTABLE kind: ?String@symbol = TRY (aST__kind_of_type(_));
    "error.${zig} => { ${rt_name}.setError(.${UNWRAP (kind)}, @intFromEnum(ErrorName.${zig}), \"lock ${zig}\", ${source_line}); return error.CheatError; }"
    };
    MUTABLE arms = (matched_arms + bubble_arms);
    RETURN "switch (__err) {\n${arms.join(",\n")}\n}";
}
END
PRIVATE FN mIREmitter__emit_sorted_lock_acquire(MUTABLE self: MIREmitter, node: SortedLockAcquire) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node.fallible THEN
      RETURN TRY (mIREmitter__emit_sorted_lock_acquire_fallible(&rtoc_self_view, node));
    ELSE
      RETURN TRY (mIREmitter__emit_sorted_lock_acquire_panic(&rtoc_self_view, node));
    END
}
END
PRIVATE FN mIREmitter__emit_sorted_lock_acquire_panic(MUTABLE self: MIREmitter, node: SortedLockAcquire) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE entries = node.entries;
    MUTABLE n = entries.length();
    MUTABLE guard_decls = (entries |> SELECT "var ${_.guard_var()}: @TypeOf(${TRY (mIREmitter__emit(&rtoc_self_view, _.lock_expr()))}.${_.method_name()}()) = undefined;").join("\n");
    MUTABLE ptr_init = (entries |> SELECT "@intFromPtr(${TRY (mIREmitter__emit(&rtoc_self_view, _.address_expr()))})").join(", ");
    MUTABLE order_init = (0 ..< n).to_a().join(", ");
    MUTABLE switch_arms = (entries |> SELECT "${_.indexOf()} => ${_.guard_var()} = ${TRY (mIREmitter__emit(&rtoc_self_view, _.lock_expr()))}.${_.method_name()}(),").join("\n                ");
    MUTABLE defer_releases = (entries |> SELECT "defer ${_.guard_var()}.release();").join("\n");
    MUTABLE alias_decls = (entries |> SELECT "const ${_.alias_name()} = ${_.guard_var()}.get();\n_ = &${_.alias_name()};").join("\n");
    RETURN regexReplaceAll("${guard_decls}\n{\n    const __ptrs = [_]usize{ ${ptr_init} };\n    var __order = [_]u8{ ${order_init} };\n    var __i: usize = 0;\n    while (__i < ${n}) : (__i += 1) {\n        var __j: usize = 0;\n        while (__j + 1 < ${n}) : (__j += 1) {\n            if (__ptrs[__order[__j]] > __ptrs[__order[__j + 1]]) {\n                const __tmp = __order[__j];\n                __order[__j] = __order[__j + 1];\n                __order[__j + 1] = __tmp;\n            }\n        }\n    }\n    for (__order) |__idx| {\n        switch (__idx) {\n          ${switch_arms}\n          else => unreachable,\n        }\n    }\n}\n${defer_releases}\n${alias_decls}\n", "\\s+\\z", "");
}
END
PRIVATE FN mIREmitter__emit_sorted_lock_acquire_fallible(MUTABLE self: MIREmitter, node: SortedLockAcquire) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE entries = node.entries;
    MUTABLE n = entries.length();
    MUTABLE action: FailureAction = COPY castEmittableToFailureAction(node.action);
    MUTABLE guard_decls = (entries |> SELECT "var ${_.guard_var()}: @TypeOf(try ${TRY (mIREmitter__emit(&rtoc_self_view, _.lock_expr()))}.${_.method_name()}()) = undefined;").join("\n");
    MUTABLE held_decls = (entries |> SELECT "var ${_.held_var()}: bool = false;").join("\n");
    MUTABLE ptr_init = (entries |> SELECT "@intFromPtr(${TRY (mIREmitter__emit(&rtoc_self_view, _.address_expr()))})").join(", ");
    MUTABLE order_init = (0 ..< n).to_a().join(", ");
    MUTABLE acquire_arms = (entries |> SELECT {
    MUTABLE lock_expr: ?String = TRY (mIREmitter__emit(&rtoc_self_view, _.lock_expr()));
    regexReplaceAll("${_.indexOf()} => {\n                                if (${lock_expr}.${_.method_name()}()) |__g| {\n                                    ${_.guard_var()} = __g;\n                                    ${_.held_var()} = true;\n                                } else |__err_inner| {\n                                    __err_caught = __err_inner;\n                                    __success = false;\n                                }\n                            },\n", "\\s+\\z", "")
    }).join("\n                                ");
    MUTABLE release_arms = (entries |> SELECT "${_.indexOf()} => if (${_.held_var()}) { ${_.guard_var()}.release(); ${_.held_var()} = false; },").join("\n                            ");
    MUTABLE handler_switch = TRY (mIREmitter__emit_sorted_lock_handler_switch(&rtoc_self_view, action, (node.matched_types OR List[]), (node.bubble_types OR List[]), node.rt_name, CAST(node.source_line AS String)));
    MUTABLE retry_branch: String = "";
    IF node.retries THEN
      retry_branch = "if (__retry + 1 < ${node.retries}) continue;";
    ELSE
      retry_branch = "// no retries configured";
    END
    MUTABLE defer_releases = (entries |> SELECT "defer if (${_.held_var()}) ${_.guard_var()}.release();").join("\n");
    MUTABLE alias_decls = (entries |> SELECT "const ${_.alias_name()} = ${_.guard_var()}.get();\n_ = &${_.alias_name()};").join("\n");
    RETURN regexReplaceAll("${guard_decls}\n${held_decls}\n${node.loop_label}: {\n    var __retry: usize = 0;\n    while (true) : (__retry += 1) {\n        const __ptrs = [_]usize{ ${ptr_init} };\n        var __order = [_]u8{ ${order_init} };\n        var __i: usize = 0;\n        while (__i < ${n}) : (__i += 1) {\n            var __j: usize = 0;\n            while (__j + 1 < ${n}) : (__j += 1) {\n                if (__ptrs[__order[__j]] > __ptrs[__order[__j + 1]]) {\n                    const __tmp = __order[__j];\n                    __order[__j] = __order[__j + 1];\n                    __order[__j + 1] = __tmp;\n                }\n            }\n        }\n        var __success = true;\n        var __err_caught: ?anyerror = null;\n        var __k: usize = 0;\n        while (__k < ${n}) : (__k += 1) {\n            const __idx = __order[__k];\n            switch (__idx) {\n                ${acquire_arms}\n                else => unreachable,\n            }\n            if (!__success) break;\n        }\n        if (__success) break :${node.loop_label};\n        var __r: usize = __k;\n        while (__r > 0) {\n            __r -= 1;\n            switch (__order[__r]) {\n                ${release_arms}\n                else => unreachable,\n            }\n        }\n        ${retry_branch}\n        ${handler_switch}\n        unreachable;\n    }\n}\n${defer_releases}\n${alias_decls}\n", "\\s+\\z", "");
}
END
PRIVATE FN mIREmitter__emit_sorted_lock_handler_switch(MUTABLE self: MIREmitter, action: FailureAction, matched: []String@symbol, bubble: []String@symbol, rt_name: String, source_line: String) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE handler_arms: []String = ( { MUTABLE rtoc_empty_list_34: []String = List[]; rtoc_empty_list_34 } );
    IF !((matched.length() == 0)) THEN
      MUTABLE matched_errs = (matched |> SELECT "error.${TRY (aST__zig_name_of_type(_))}").join(", ");
      &handler_arms.append("${matched_errs} => { ${TRY (mIREmitter__emit_failure_action(&rtoc_self_view, action))} }");
    END
    FOR _ IN bubble DO
    MUTABLE zig: ?String = TRY (aST__zig_name_of_type(_));
    MUTABLE kind: ?String@symbol = TRY (aST__kind_of_type(_));
    &handler_arms.append("error.${zig} => { ${rt_name}.setError(.${UNWRAP (kind)}, @intFromEnum(ErrorName.${zig}), \"lock ${zig}\", ${source_line}); return error.CheatError; }");
    END
    &handler_arms.append("else => |__err_other| { ${rt_name}.setError(.System, 0, @errorName(__err_other), ${source_line}); return error.CheatError; }");
    RETURN "switch (__err_caught.?) {\n                    ${handler_arms.join(",\n                    ")},\n                }";
}
END
PRIVATE FN mIREmitter__emit_program(MUTABLE self: MIREmitter, node: MIRProgram) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE parts = node.items |> SELECT:? TRY (mIREmitter__emit_container_item(&rtoc_self_view, _)) |> WHERE _ != NIL;
    MUTABLE symbol_pool = mIREmitter__symbol_pool_declarations(rtoc_self_view);
    IF !((symbol_pool.length() == 0)) THEN
      &parts.unshift(symbol_pool);
    END
    MUTABLE out = List[];
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < parts.length() DO
    IF (rtoc_idx == 0) THEN
        &out.append(COPY parts[rtoc_idx]);
    ELSE_IF parts[(rtoc_idx - 1)].startsWith?("// CLR:") THEN
        &out.append("\n${parts[rtoc_idx]}");
    ELSE
        &out.append("\n\n${parts[rtoc_idx]}");
    END
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN out.join("");
}
END
FN mIREmitter__symbol_pool_declarations(self: MIREmitter) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE lines: []String = ( { MUTABLE rtoc_empty_list_35: []String = List[]; rtoc_empty_list_35 } );
    IF rtoc_self_view.uses_c_callback THEN
      &lines.append("// Runtime bridge for synchronous C callbacks.");
      &lines.append("threadlocal var __clear_c_callback_rt: ?*Runtime = null;");
    END
    IF !((rtoc_self_view.symbol_literals.count() == 0)) THEN
      &lines.append("// Static String@symbol literal pool.");
    END
    FOR rtoc_key IN rtoc_self_view.symbol_literals.keys() DO
    MUTABLE name: String = COPY UNWRAP (rtoc_self_view.symbol_literals[rtoc_key]);
    &lines.append("const ${name}: CheatLib.Symbol = .{ .bytes = ${mIREmitter__zig_byte_string_literal(rtoc_self_view, rtoc_key)} };");
    END
    RETURN lines.join("\n");
}
END
PRIVATE FN mIREmitter__emit_fn_def(MUTABLE self: MIREmitter, node: FnDef) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE vis: String = "";
    IF (node.visibility == :pub) THEN
      vis = "pub ";
    ELSE
      vis = "";
    END
    MUTABLE comptime = ((node.comptime_params OR List[])).join(", ");
    MUTABLE params = (node.params |> SELECT "${_.name}: ${_.zig_type}").join(", ");
    MUTABLE all_params = ([comptime, params]) |> WHERE !(_.empty?()).join(", ");
    MUTABLE ret: String = "";
    IF node.can_fail THEN
      ret = "!${node.ret_type}";
    ELSE
      ret = node.ret_type;
    END
    MUTABLE runtime_param: ?MIRParam = node.params |> FIND (_.zig_type == "*Runtime");
    MUTABLE cache_name: ?String = IF runtime_param != NIL THEN
      mIREmitter__unique_heap_allocator_cache_name(rtoc_self_view)
    ELSE
      NIL
    END;
    MUTABLE body = mIREmitter__with_heap_allocator_cache(&rtoc_self_view, cache_name, runtime_param?.name, %() USE(node, runtime_param, MUTABLE rtoc_self_view) -> {
    IF runtime_param THEN
      RETURN TRY (mIREmitter__emit_body_with_runtime(&rtoc_self_view, node.body, runtime_param.name));
    ELSE
      RETURN TRY (mIREmitter__emit_body(&rtoc_self_view, node.body));
    END
    NIL
    });
    IF ((cache_name != NIL) AND body.contains?(cache_name)) THEN
      MUTABLE cache_init = "const ${cache_name} = ${runtime_param.name}.heapAlloc(); _ = &${cache_name};";
      body = (CAST(Tuple{cache_init, body} AS Tuple<String, U>)) |> WHERE !(_.empty?()).join("\n");
    END
    RETURN "${vis}fn ${node.name}(${all_params}) ${ret} {\n${body}\n}";
}
END
PRIVATE FN mIREmitter__emit_struct_def(MUTABLE self: MIREmitter, node: MIRStructDef) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE vis: String = "";
    IF (node.visibility == :pub) THEN
      vis = "pub ";
    ELSE
      vis = "";
    END
    MUTABLE fields = ((((node.fields OR List[]))) |> SELECT {
    MUTABLE default: String = "";
      IF _.default() THEN
        default = " = ${TRY (mIREmitter__emit(&rtoc_self_view, _.default()))}";
      ELSE
        default = "";
      END
    "${mIREmitter__zig_field_name(rtoc_self_view, _.name())}: ${TRY (type__zig_type(_))}${default},"
    }).join("\n    ");
    MUTABLE methods = (((node.methods OR List[]))) |> SELECT TRY (mIREmitter__emit(&rtoc_self_view, _)).join("\n\n    ");
    MUTABLE parts = ([fields, methods]) |> WHERE !(_.empty?()).join("\n\n    ");
    IF node.name THEN
      RETURN "${vis}const ${node.name} = struct {\n    ${parts}\n};";
    ELSE
      RETURN "struct {\n    ${parts}\n    }";
    END
}
END
PRIVATE FN mIREmitter__emit_enum_def(self: MIREmitter, node: MIREnumDef) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE vis: String = "";
    IF (node.visibility == :pub) THEN
      vis = "pub ";
    ELSE
      vis = "";
    END
    MUTABLE variants = node.variants.join(", ");
    RETURN "${vis}const ${node.name} = enum { ${variants} };";
}
END
PRIVATE FN mIREmitter__emit_union_def(MUTABLE self: MIREmitter, node: UnionTypeDef) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE vis: String = "";
    IF (node.visibility == :pub) THEN
      vis = "pub ";
    ELSE
      vis = "";
    END
    MUTABLE fields = (node.variants |> SELECT "${_[:name]}: ${_[:zig_type]},").join("\n    ");
    MUTABLE methods = (((node.methods OR List[]))) |> SELECT TRY (mIREmitter__emit(&rtoc_self_view, _)).join("\n\n    ");
    MUTABLE parts = ([fields, methods]) |> WHERE !(_.empty?()).join("\n\n    ");
    IF node.name THEN
      RETURN "${vis}const ${castNamedEmittableReturnValueToString(node.name)} = union(enum) {\n    ${parts}\n};";
    ELSE
      RETURN "union(enum) {\n    ${parts}\n    }";
    END
}
END
PRIVATE FN mIREmitter__emit_import(self: MIREmitter, node: Import) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE base = "@import(\"${node.module_path}\")";
    IF node.member THEN
      base = "${base}.${node.member}";
    END
    RETURN "const ${node.alias_name} = ${base};";
}
END
PRIVATE FN mIREmitter__emit_type_alias(self: MIREmitter, node: TypeAlias) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN "pub const ${castNamedEmittableReturnValueToString(node.name)} = ${node.target};\ncomptime { _ = @typeName(${castNamedEmittableReturnValueToString(node.name)}); }";
}
END
PRIVATE FN mIREmitter__emit_c_extern_fn_decl(self: MIREmitter, node: CExternFnDecl) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE params = (node.params |> SELECT "${_.name()}: ${TRY (type__zig_type(_))}").join(", ");
    MUTABLE library: String = "";
    IF (node.library == "c") THEN
      library = "c";
    ELSE
      library = node.library;
    END
    MUTABLE callconv = PARTIAL MATCH node.callconv START
      :system -> ".c",
      :winapi -> ".winapi",
      DEFAULT -> ".c"
    END;
    RETURN "extern \"${library}\" fn ${castNamedEmittableReturnValueToString(node.name)}(${params}) callconv(${callconv}) ${node.return_type};";
}
END
PRIVATE FN mIREmitter__emit_c_extern_struct_def(self: MIREmitter, node: CExternStructDef) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fields = (node.fields |> SELECT "${_.name()}: ${TRY (type__zig_type(_))}").join(", ");
    RETURN "const ${castNamedEmittableReturnValueToString(node.name)} = extern struct { ${fields} };";
}
END
PRIVATE FN mIREmitter__emit_module_namespace(MUTABLE self: MIREmitter, node: ModuleNamespace) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE body = ((node.items) |> SELECT:? TRY (mIREmitter__emit_container_item(&rtoc_self_view, _)) |> WHERE _ != NIL).join("\n");
    RETURN "const ${node.name} = struct {\n${mIREmitter__indent_block(rtoc_self_view, body, 4)}\n};";
}
END
PRIVATE FN mIREmitter__emit_container_item(MUTABLE self: MIREmitter, node: Emittable) RETURNS !?String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node IS_A Let AS let THEN
      MUTABLE let_mutable = COPY let;
      RETURN TRY (mIREmitter__emit_let(&rtoc_self_view, let_mutable, FALSE));
    END
    RETURN TRY (mIREmitter__emit(&rtoc_self_view, node));
}
END
PRIVATE FN mIREmitter__emit_test_def(MUTABLE self: MIREmitter, node: TestDef) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node.needs_scheduler EXISTS AS needs_scheduler_value THEN
      MUTABLE needs_scheduler_value_mutable = COPY needs_scheduler_value;
      RETURN TRY (mIREmitter__emit_scheduler_test_def(&rtoc_self_view, node));
    END
    MUTABLE body = TRY (mIREmitter__emit_body(&rtoc_self_view, node.body));
    RETURN "test \"${node.name}\" {\n${body}\n}";
}
END
PRIVATE FN mIREmitter__emit_scheduler_test_def(MUTABLE self: MIREmitter, node: TestDef) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE stmts = node.body |> WHERE !(_ IS_A TestPreamble);
    MUTABLE body = TRY (mIREmitter__emit_body(&rtoc_self_view, stmts));
    RETURN "test \"${node.name}\" {\nvar da = std.heap.DebugAllocator(.{}){};\n    defer _ = da.deinit();\n    const allocator = da.allocator();\n    var global_ctx = EbrContext{};\n    defer global_ctx.deinit(allocator);\n    const fp = @import(\"runtime/scheduler.zig\");\n    var sched = try fp.Scheduler.init(allocator, &global_ctx, null);\n    defer {\n        fp.scheduler_running = false;\n        sched.deinit();\n        fp.global_registry.deinit(allocator);\n    }\n    fp.active_scheduler = &sched;\n    fp.scheduler_running = true;\n    const __TestBody = struct {\n        fn run(raw_rt: *anyopaque, raw_args: ?*anyopaque) anyerror!void {\n            _ = raw_args;\n            const rt = @as(*Runtime, @ptrCast(@alignCast(raw_rt)));\n            _ = &rt;\n${body}\n        }\n    };\n    try sched.submitSpawn(\n        @intFromPtr(&Runtime.entryWrapper),\n        @as(CheatHeader.TaskFn, @ptrCast(&__TestBody.run)),\n        null,\n        .{ .stack_size = .Large },\n    );\n    sched.run();\n}\n".trim();
}
END
PRIVATE FN mIREmitter__emit_let(MUTABLE self: MIREmitter, node: Let, include_suppression: Bool = TRUE) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE init = NIL;
    MUTABLE kw: String = "";
    MUTABLE sup: String = "";
    IF node.init IS_A FreezeExpr THEN
      MUTABLE buf = "${castNameToString(node.name)}__buf";
      IF node.mutable THEN
        kw = "var";
      ELSE
        kw = "const";
      END
      IF (include_suppression AND (node.suppression != NIL)) THEN
        sup = " ${node.suppression}";
      ELSE
        sup = "";
      END
      RETURN "const ${buf} = ${TRY (mIREmitter__emit(&rtoc_self_view, node.init))};\n${kw} ${castNameToString(node.name)} = ${buf}._root;${sup}";
    END
    IF node.mutable THEN
      kw = "var";
    ELSE
      kw = "const";
    END
    MUTABLE ann: String = "";
    IF node.annotation EXISTS AS annotation_value THEN
      ann = ": ${TRY (type__nested_zig_type(annotation_value))}";
    ELSE
      ann = "";
    END
    IF node.module_const EXISTS AS module_const_value THEN
      MUTABLE module_const_value_mutable = COPY module_const_value;
      init = mIREmitter__with_ident_overrides(&rtoc_self_view, {"rt": "undefined"}, %() USE(node, MUTABLE rtoc_self_view) -> {
    rtoc_lambda_result_36 = TRY (mIREmitter__emit(&rtoc_self_view, node.init));
    rtoc_lambda_result_36
      });
      MUTABLE vis: String = "";
      IF (node.const_visibility == :pub) THEN
        vis = "pub ";
      ELSE
        vis = "";
      END
      RETURN "${vis}const ${castNameToString(node.name)}${ann} = ${init};";
    END
    init = TRY (mIREmitter__emit(&rtoc_self_view, node.init));
    IF (include_suppression AND (node.suppression != NIL)) THEN
      sup = " ${node.suppression}";
    ELSE
      sup = "";
    END
    RETURN "${kw} ${castNameToString(node.name)}${ann} = ${init};${sup}";
}
END
PRIVATE FN mIREmitter__emit_set(MUTABLE self: MIREmitter, node: Set) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN "${TRY (mIREmitter__emit(&rtoc_self_view, node.target))} = ${TRY (mIREmitter__emit(&rtoc_self_view, node.value))};";
}
END
PRIVATE FN mIREmitter__emit_destructure_set(MUTABLE self: MIREmitter, node: DestructureSet) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE targets = (node.targets |> SELECT UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, _)))).join(", ");
    MUTABLE suppressions = (node.targets |> SELECT:? (IF !((_ IS_A MIRDestructureTarget AND (_.declaration_kind() == :var))) THEN NIL ELSE (IF (CAST(_.name() AS String) == "_") THEN NIL ELSE " _ = &${_.name()};" END) END) |> WHERE _ != NIL).join("");
    RETURN "${targets} = ${TRY (mIREmitter__emit(&rtoc_self_view, node.value))};${suppressions}";
}
END
PRIVATE FN mIREmitter__emit_destructure_target(self: MIREmitter, node: MIRDestructureTarget) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (CAST(node.name AS String) == "_") THEN
      RETURN "_";
    END
    MUTABLE annotation: String = "";
    IF node.annotation THEN
      annotation = ": ${TRY (type__zig_type(CAST(node.annotation AS Type)))}";
    ELSE
      annotation = "";
    END
    IF (node.declaration_kind == :const) OR (node.declaration_kind == :var) THEN
      RETURN "${node.declaration_kind} ${node.name}${annotation}";
    ELSE
      RETURN COPY CAST(node.name AS String);
    END
}
END
PRIVATE FN mIREmitter__zig_bare_name(self: MIREmitter, name: Name) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE text = COPY CAST(name AS String);
    IF (text.startsWith?("@\"") AND text.endsWith?("\"")) THEN
      RETURN COPY text.substr(2, (((text.length() - 2) - 2) + 1));
    ELSE
      RETURN text;
    END
}
END
PRIVATE FN mIREmitter__move_guard_name(self: MIREmitter, name: Name) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN "${mIREmitter__zig_bare_name(rtoc_self_view, name)}_moved";
}
END
PRIVATE FN mIREmitter__emit_struct_init_field_value<T>(MUTABLE self: MIREmitter, value: T) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE inner = IF (T IS_A MIRCast AND (value.method() == :as)) THEN
      value.expr()
    ELSE
      NIL
    END;
    IF (inner IS_A Lit AND (CAST(inner.value() AS String) == "null")) THEN
      RETURN "null";
    END
    RETURN UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, value)));
}
END
PRIVATE FN mIREmitter__zig_field_name(self: MIREmitter, name: Name) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE text = COPY CAST(name AS String);
    IF text.startsWith?("@\"") THEN
      RETURN text;
    END
    IF zigType__reserved_identifier?(text) THEN
      RETURN "@\"${text}\"";
    ELSE
      RETURN text;
    END
}
END
PRIVATE FN mIREmitter__emit_reassign_cleanup(MUTABLE self: MIREmitter, node: ReassignWithCleanup) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE alloc: String = "";
    MUTABLE val: ?String = NIL;
    MUTABLE base = mIREmitter__zig_bare_name(rtoc_self_view, node.name);
    MUTABLE try_expr = mIREmitter__reassign_success_only_expr(rtoc_self_view, node);
    IF try_expr THEN
      MUTABLE opt = "__new_${base}_opt";
      val = "__new_${base}_val";
      alloc = TRY (mIREmitter__alloc_zig(rtoc_self_view, node.alloc));
      RETURN (["{", "const ${opt}: ?${node.zig_type} = (${TRY (mIREmitter__emit(&rtoc_self_view, try_expr))} catch null);", "if (${opt}) |${val}| {", "    CheatLib.cleanup(@TypeOf(${node.name}), ${alloc}, &${node.name});", "    ${node.name} = ${val};", "}", "}"]).join("\n");
    END
    MUTABLE tmp = "__new_${base}";
    val = TRY (mIREmitter__emit(&rtoc_self_view, node.value));
    alloc = TRY (mIREmitter__alloc_zig(rtoc_self_view, node.alloc));
    RETURN "{\nconst ${tmp} = ${val};\nCheatLib.cleanup(@TypeOf(${node.name}), ${alloc}, &${node.name});\n${node.name} = ${tmp};\n}";
}
END
PRIVATE FN mIREmitter__reassign_success_only_expr(self: MIREmitter, node: ReassignWithCleanup) RETURNS ?Emittable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE value = COPY node.value;
    IF value IS_A MIRCast AS mir_cast THEN
      MUTABLE mir_cast = cast__expr(mir_cast);
    END
    IF value IS_A TryCatch AS try_catch THEN
      IF !((try_catch.capture == NIL)) THEN
        RETURN NIL;
      END
      MUTABLE catch_body = try_catch.catch_body;
      IF catch_body IS_A Ident AS ident THEN
        IF !((ident.name == CAST(node.name AS String))) THEN
          RETURN NIL;
        END
        RETURN COPY tryCatch__expr(try_catch);
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN mIREmitter__emit_if_stmt(MUTABLE self: MIREmitter, node: IfStmt) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE cond: ?String = TRY (mIREmitter__emit(&rtoc_self_view, node.cond));
    IF node.comptime THEN
      cond = "comptime ${cond}";
    END
    MUTABLE then_body = TRY (mIREmitter__emit_body(&rtoc_self_view, node.then_body));
    MUTABLE result = "if (${cond}) {\n${then_body}\n}";
    MUTABLE else_stmts = node.else_body;
    IF ((else_stmts) AND !(else_stmts.empty?())) THEN
      MUTABLE else_body = TRY (mIREmitter__emit_body(&rtoc_self_view, else_stmts));
      result = (result $+ " else {\n${else_body}\n}");
    END
    RETURN result;
}
END
PRIVATE FN mIREmitter__emit_if_bind_stmt(MUTABLE self: MIREmitter, node: IfBindStmt) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE result: String = "";
    MUTABLE then_body = TRY (mIREmitter__emit_body(&rtoc_self_view, node.then_body));
    MUTABLE else_stmts = node.else_body;
    MUTABLE else_body: ?String = IF (else_stmts AND !(else_stmts.empty?())) THEN
      TRY (mIREmitter__emit_body(&rtoc_self_view, else_stmts))
    ELSE
      NIL
    END;
    IF (node.bindings.length() == 1) THEN
      MUTABLE b = node.bindings[0];
      MUTABLE expr: ?String = TRY (mIREmitter__emit(&rtoc_self_view, b[:expr]));
      MUTABLE suppress: String = "";
      IF (CAST(b[:capture] AS String) == "_") THEN
        suppress = "";
      ELSE
        suppress = "_ = &${b[:capture]};\n";
      END
      IF b[:node_ref] THEN
        result = "{\nconst ${b[:capture]} = ${expr};\n";
        result = (result $+ "if (!${b[:capture]}.isNil()) {\n${suppress}${then_body}\n}");
        IF else_body EXISTS AS else_body_value THEN
          result = (result $+ " else {\n${else_body_value}\n}");
        END
        result = (result $+ "\n}");
      ELSE_IF (b[:predicate] == :stream_item) THEN
        IF else_body EXISTS AS else_body_value THEN
          result = "switch (${expr}) {\n.Item => |${b[:capture]}| {\n${suppress}${then_body}\n},\n.Closed => {\n${else_body_value}\n},\n}";
        END
        result = (result OR "switch (${expr}) {\n.Item => |${b[:capture]}| {\n${suppress}${then_body}\n},\n.Closed => {},\n}");
      ELSE_IF (b[:predicate] == :is_ok) THEN
        result = "if (${expr}) |${b[:capture]}| {\n${suppress}${then_body}\n}";
        IF else_body EXISTS AS else_body_value THEN
          result = (result $+ " else |_| {\n${else_body_value}\n}");
        END
        IF !(else_body) THEN
          result = (result $+ " else |_| {}");
        END
      ELSE
        MUTABLE capture: String = "";
        IF b[:pointer_capture] THEN
          capture = "*${b[:capture]}";
        ELSE
          capture = COPY b[:capture];
        END
        result = "if (${expr}) |${capture}| {\n${suppress}${then_body}\n}";
        IF else_body EXISTS AS else_body_value THEN
          result = (result $+ " else {\n${else_body_value}\n}");
        END
      END
      RETURN result;
    ELSE
      rtoc_self_view.if_bind_counter = (((rtoc_self_view.if_bind_counter OR_ELSE 0)) + 1);
      MUTABLE label = "__ib_${UNWRAP (rtoc_self_view.if_bind_counter).toString()}";
      MUTABLE ok_var = "__ib_ok_${UNWRAP (rtoc_self_view.if_bind_counter).toString()}";
      MUTABLE inner = (node.bindings |> SELECT (    IF _[:node_ref] THEN
        "const ${_[:capture]} = ${TRY (mIREmitter__emit(&rtoc_self_view, _[:expr]))}; if (${_[:capture]}.isNil()) break :${label};"
      ELSE_IF (_[:predicate] == :stream_item) THEN
        "const ${_[:capture]} = switch (${TRY (mIREmitter__emit(&rtoc_self_view, _[:expr]))}) { .Item => |payload| payload, .Closed => break :${label} };"
      ELSE_IF (_[:predicate] == :is_ok) THEN
        "const ${_[:capture]} = ${TRY (mIREmitter__emit(&rtoc_self_view, _[:expr]))} catch break :${label};"
      ELSE
        "const ${_[:capture]} = ${TRY (mIREmitter__emit(&rtoc_self_view, _[:expr]))} orelse break :${label};"
      END)).join("\n");
      result = "var ${ok_var}: bool = false;\n";
      result = (result $+ "${label}: {\n${inner}\n${then_body}\n${ok_var} = true;\n}");
      IF else_body EXISTS AS else_body_value THEN
        result = (result $+ "\nif (!${ok_var}) {\n${else_body_value}\n}");
      END
      RETURN result;
    END
}
END
PRIVATE FN mIREmitter__emit_while(MUTABLE self: MIREmitter, MUTABLE node: WhileStmt) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE cond: ?String = TRY (mIREmitter__emit(&rtoc_self_view, node.cond));
    MUTABLE cap: String = "";
    IF node.capture THEN
      cap = " |${node.capture}|";
    ELSE
      cap = "";
    END
    MUTABLE upd: String = "";
    IF node.update THEN
      MUTABLE update_code = (UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, node.update)))).chomp(";");
      upd = " : (${update_code})";
    ELSE
      upd = "";
    END
    MUTABLE body = TRY (mIREmitter__emit_body(&rtoc_self_view, node.body));
    MUTABLE capture_suppress: String = "";
    IF (node.capture AND (CAST(node.capture AS String) != "_")) THEN
      capture_suppress = "_ = &${node.capture};\n";
    ELSE
      capture_suppress = "";
    END
    RETURN "while (${cond})${upd}${cap} {\n${capture_suppress}${body}\n}";
}
END
PRIVATE FN mIREmitter__emit_for(MUTABLE self: MIREmitter, node: ForStmt) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE iter: ?String = TRY (mIREmitter__emit(&rtoc_self_view, node.iter));
    MUTABLE captures = ([node.capture, node.index_capture]).join(", ");
    MUTABLE body = TRY (mIREmitter__emit_body(&rtoc_self_view, node.body));
    IF mIREmitter__i64_range_capture_cast_required?(rtoc_self_view, node) THEN
      MUTABLE raw_capture = "__${node.capture}_usize";
      RETURN "for (${iter}) |${raw_capture}| {\nconst ${node.capture}: i64 = @intCast(${raw_capture});\n${body}\n}";
    END
    RETURN "for (${iter}) |${captures}| {\n${body}\n}";
}
END
PRIVATE FN mIREmitter__i64_range_capture_cast_required?(self: MIREmitter, node: ForStmt) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE iter = COPY node.iter;
    RETURN !(!((((((IF iter IS_A IterRange AS iter_range THEN (iter_range.capture_type == :i64) ELSE FALSE END) AND (node.index_capture == NIL)) AND node.capture IS_A String) AND !(node.capture.startsWith?("*"))))));
}
END
PRIVATE FN mIREmitter__emit_switch(MUTABLE self: MIREmitter, node: SwitchStmt) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE subject: ?String = TRY (mIREmitter__emit(&rtoc_self_view, node.subject));
    MUTABLE arms = node.arms |> SELECT {
    MUTABLE body = TRY (mIREmitter__emit_body(&rtoc_self_view, _.body()));
    "${TRY (mIREmitter__emit_switch_patterns(&rtoc_self_view, _.patterns()))} => {\n${body}\n}"
    };
    MUTABLE default_body = node.default_body;
    IF default_body THEN
      MUTABLE body: String = "";
      IF default_body.empty?() THEN
        body = "";
      ELSE
        body = TRY (mIREmitter__emit_body(&rtoc_self_view, default_body));
      END
      &arms.append("else => {\n${body}\n}");
    END
    RETURN "switch (${subject}) {\n    ${arms.join(",\n    ")},\n}";
}
END
PRIVATE FN mIREmitter__emit_switch_patterns(MUTABLE self: MIREmitter, patterns: []SwitchPattern) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN (patterns |> SELECT TRY (mIREmitter__emit_switch_pattern(&rtoc_self_view, _))).join(", ");
}
END
PRIVATE FN mIREmitter__emit_switch_pattern(MUTABLE self: MIREmitter, pattern: SwitchPattern) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF pattern IS_A EnumSwitchPattern AS enum_switch_pattern THEN
      RETURN ".${enum_switch_pattern.variant}";
    ELSE
      RETURN UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, pattern)));
    END
}
END
PRIVATE FN mIREmitter__emit_catch_wrapper(MUTABLE self: MIREmitter, node: CatchWrapper) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE inner_call = UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, node.inner_call)));
    IF node.clauses.empty?() THEN
      RETURN "return ${inner_call} catch {\n${mIREmitter__indent_block(rtoc_self_view, TRY (mIREmitter__emit_catch_default_body(&rtoc_self_view, node)), 4)}\n};";
    END
    MUTABLE clauses = COPY node.clauses;
    MUTABLE branch_parts = unsupportedRuby("CallNode at 2461:19: each_with_index requires an array-shaped collection");
    &branch_parts.append(TRY (mIREmitter__emit_catch_default(&rtoc_self_view, node)));
    MUTABLE branch_chain = branch_parts.join(" else ");
    RETURN "return ${inner_call} catch {\n${mIREmitter__indent_block(rtoc_self_view, branch_chain, 4)}\n};";
}
END
PRIVATE FN mIREmitter__emit_catch_clause(MUTABLE self: MIREmitter, clause: MIRCatchClause, rt_name: String, snapshot_type: ?Type, first_clause: Bool) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE body = TRY (mIREmitter__emit_catch_body(&rtoc_self_view, rt_name, clause.body, snapshot_type));
    RETURN "if (${TRY (mIREmitter__emit_catch_condition(&rtoc_self_view, clause.meta, rt_name))}) {\n${mIREmitter__indent_block(rtoc_self_view, body, 8)}\n}";
}
END
PRIVATE FN mIREmitter__emit_catch_default(MUTABLE self: MIREmitter, node: CatchWrapper) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN "{\n${mIREmitter__indent_block(rtoc_self_view, TRY (mIREmitter__emit_catch_default_body(&rtoc_self_view, node)), 8)}\n}";
}
END
PRIVATE FN mIREmitter__emit_catch_default_body(MUTABLE self: MIREmitter, node: CatchWrapper) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE action: CatchDefaultAction = COPY CAST(node.default_action AS CatchDefaultAction);
    IF (action IS_A Body) THEN
      RETURN TRY (mIREmitter__emit_catch_body(&rtoc_self_view, node.rt_name, node.default_body, NIL));
    ELSE_IF (action == CatchDefaultAction.Propagate) THEN
      RETURN "${node.rt_name}.freeSnapshot();\nreturn error.CheatError;";
    ELSE_IF (action == CatchDefaultAction.Unreachable) THEN
      RETURN "${node.rt_name}.freeSnapshot();\nunreachable;";
    ELSE
      RETURN panic("unreachable: exhaustive union match");
    END
}
END
PRIVATE FN mIREmitter__emit_catch_body(MUTABLE self: MIREmitter, rt_name: String, body: []Emittable, snapshot_type: ?Type) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE parts: []String = ( { MUTABLE rtoc_empty_list_37: []String = List[]; rtoc_empty_list_37 } );
    MUTABLE snapshot_decl = mIREmitter__emit_catch_snapshot_decl(rtoc_self_view, rt_name, snapshot_type);
    IF !((snapshot_decl.length() == 0)) THEN
      &parts.append(snapshot_decl);
    END
    &parts.append("const __error = ${rt_name}.__error;");
    &parts.append("_ = &__error;");
    &parts.append("defer ${rt_name}.freeSnapshot();");
    MUTABLE emitted_body = TRY (mIREmitter__emit_body(&rtoc_self_view, body));
    IF !((emitted_body.length() == 0)) THEN
      &parts.append(emitted_body);
    END
    RETURN parts.join("\n");
}
END
PRIVATE FN mIREmitter__emit_catch_snapshot_decl(self: MIREmitter, rt_name: String, snapshot_type: ?Type) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF snapshot_type EXISTS AS snapshot_type_value THEN
      MUTABLE snap_zig = TRY (type__zig_type(snapshot_type_value));
      RETURN (["const __snap_ptr = ${rt_name}.__error.snapshotAs(${snap_zig});", "const snapshot = if (__snap_ptr) |p| p.* else undefined;", "const __has_snapshot = __snap_ptr != null;", "_ = &snapshot; _ = &__has_snapshot;"]).join("\n");
    ELSE
      RETURN "";
    END
}
END
PRIVATE FN mIREmitter__emit_catch_condition(MUTABLE self: MIREmitter, meta: CatchClauseMeta, rt_name: String) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE item_checks: []String = ( { MUTABLE rtoc_empty_list_38: []String = List[]; rtoc_empty_list_38 } );
    FOR _ IN meta.kinds DO
    &item_checks.append("${rt_name}.__error.matchesKind(.${_})");
    END
    FOR _ IN meta.types DO
    &item_checks.append("${rt_name}.__error.matchesName(@intFromEnum(ErrorName.${_}))");
    END
    MUTABLE item_cond = mIREmitter__emit_catch_condition_group(rtoc_self_view, item_checks, "true");
    MUTABLE filter_checks: []String = ( { MUTABLE rtoc_empty_list_39: []String = List[]; rtoc_empty_list_39 } );
    FOR _ IN meta.filter_types DO
    &filter_checks.append("${rt_name}.__error.matchesName(@intFromEnum(ErrorName.${_}))");
    END
    FOR _ IN meta.filter_messages DO
    &filter_checks.append("${rt_name}.__error.matchesMessage(${UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, _)))})");
    END
    IF (filter_checks.length() == 0) THEN
      RETURN item_cond;
    END
    MUTABLE filter_cond = mIREmitter__emit_catch_condition_group(rtoc_self_view, filter_checks, "true");
    RETURN "${item_cond} and ${filter_cond}";
}
END
PRIVATE FN mIREmitter__emit_catch_condition_group(self: MIREmitter, checks: []String, default_value: String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (checks.length() == 0) THEN
      RETURN COPY default_value;
    END
    IF (checks.length() == 1) THEN
      RETURN COPY UNWRAP (checks.first());
    END
    RETURN "(${checks.join(" or ")})";
}
END
PRIVATE FN mIREmitter__emit_union_match(MUTABLE self: MIREmitter, node: UnionMatchStmt) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE subject: ?String = TRY (mIREmitter__emit(&rtoc_self_view, node.subject));
    MUTABLE arms = node.arms |> SELECT {
    MUTABLE body = TRY (mIREmitter__emit_body(&rtoc_self_view, _.body()));
    MUTABLE payload = _.payload();
    MUTABLE capture_name: String = "";
      IF _.pointer_payload() THEN
        capture_name = "*${payload}";
      ELSE
        capture_name = payload;
      END
    MUTABLE capture: String = "";
      IF payload THEN
        capture = " |${capture_name}|";
      ELSE
        capture = "";
      END
    MUTABLE suppress: String = "";
      IF payload THEN
        suppress = "_ = &${payload};\n";
      ELSE
        suppress = "";
      END
    ".${_.variant()} =>${capture} {\n${suppress}${body}\n}"
    };
    MUTABLE default_body = node.default_body;
    IF default_body THEN
      MUTABLE body: String = "";
      IF default_body.empty?() THEN
        body = "";
      ELSE
        body = TRY (mIREmitter__emit_body(&rtoc_self_view, default_body));
      END
      &arms.append("else => {\n${body}\n}");
    END
    RETURN "switch (${subject}) {\n    ${arms.join(",\n    ")},\n}";
}
END
PRIVATE FN mIREmitter__emit_if_chain(MUTABLE self: MIREmitter, node: IfChain) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE parts = node.branches |> SELECT {
    MUTABLE cond: ?String = TRY (mIREmitter__emit(&rtoc_self_view, _.cond()));
    MUTABLE body = TRY (mIREmitter__emit_body(&rtoc_self_view, _.body()));
    "if (${cond}) {\n${body}\n}"
    };
    MUTABLE result = parts.join(" else ");
    MUTABLE default_body = node.default_body;
    IF ((default_body) AND !(default_body.empty?())) THEN
      MUTABLE body = TRY (mIREmitter__emit_body(&rtoc_self_view, default_body));
      result = (result + " else {\n${body}\n}");
    END
    RETURN result;
}
END
PRIVATE FN mIREmitter__emit_return(MUTABLE self: MIREmitter, node: ReturnStmt) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node.value THEN
      RETURN "return ${TRY (mIREmitter__emit(&rtoc_self_view, node.value))};";
    ELSE
      RETURN "return;";
    END
}
END
PRIVATE FN mIREmitter__emit_break(MUTABLE self: MIREmitter, node: BreakStmt) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE parts = ["break"];
    IF node.label THEN
      &parts.append(":${node.label}");
    END
    IF node.value THEN
      &parts.append(UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, node.value))));
    END
    RETURN "${parts.join(" ")};";
}
END
PRIVATE FN mIREmitter__emit_break_expr(MUTABLE self: MIREmitter, node: BreakExpr) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE parts = ["break"];
    IF node.label THEN
      &parts.append(":${node.label}");
    END
    IF node.value THEN
      &parts.append(UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, node.value))));
    END
    RETURN parts.join(" ");
}
END
PRIVATE FN mIREmitter__emit_index_insert(MUTABLE self: MIREmitter, node: IndexInsert) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE map: ?String = TRY (mIREmitter__emit(&rtoc_self_view, node.map));
    MUTABLE key: ?String = TRY (mIREmitter__emit(&rtoc_self_view, node.key_expr));
    MUTABLE val: ?String = TRY (mIREmitter__emit(&rtoc_self_view, node.value_expr));
    MUTABLE key_t = (node.key_zig_type OR "u8");
    MUTABLE elem_t = node.elem_zig_type;
    MUTABLE alloc_str = PARTIAL MATCH node.alloc START
      :heap -> TRY (mIREmitter__alloc_zig(rtoc_self_view, :heap)),
      NIL -> TRY (mIREmitter__alloc_zig(rtoc_self_view, :heap)),
      :frame -> TRY (mIREmitter__alloc_zig(rtoc_self_view, :frame)),
      DEFAULT -> CAST(node.alloc AS String)
    END;
    RETURN "{\n    const __idx_key_owned = try ${alloc_str}.dupe(${key_t}, ${key});\n    var __gop = ${map}.inner.getOrPut(${alloc_str}, __idx_key_owned) catch @panic(\"INDEX allocation failed\");\n    if (__gop.found_existing) {\n        ${alloc_str}.free(__idx_key_owned);\n    } else {\n        __gop.value_ptr.* = @as(std.ArrayListUnmanaged(${elem_t}), .empty);\n    }\n    __gop.value_ptr.append(${alloc_str}, ${val}) catch @panic(\"INDEX append failed\");\n}";
}
END
PRIVATE FN mIREmitter__emit_sort(MUTABLE self: MIREmitter, node: Sort) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE et = node.elem_type;
    MUTABLE items: ?String = TRY (mIREmitter__emit(&rtoc_self_view, node.items_expr));
    MUTABLE cmp: String = "";
    IF node.string_keys THEN
      cmp = "std.mem.order(u8, ${TRY (mIREmitter__emit(&rtoc_self_view, node.key_a))}, ${TRY (mIREmitter__emit(&rtoc_self_view, node.key_b))}) == .lt";
    ELSE
      cmp = "${TRY (mIREmitter__emit(&rtoc_self_view, node.key_a))} < ${TRY (mIREmitter__emit(&rtoc_self_view, node.key_b))}";
    END
    RETURN "std.mem.sort(${et}, ${items}, {}, struct {\n    pub fn lessThan(_: void, a: ${et}, b: ${et}) bool {\n        return ${cmp};\n    }\n}.lessThan);";
}
END
PRIVATE FN mIREmitter__emit_batch_window_push(MUTABLE self: MIREmitter, node: BatchWindowPush) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN TRY (mIREmitter__emit_batch_window_emit(&rtoc_self_view, Node{ BatchWindowPush: COPY node }, "try ${node.window}.push(${TRY (mIREmitter__emit(&rtoc_self_view, node.item_expr))})"));
}
END
PRIVATE FN mIREmitter__emit_batch_window_flush(MUTABLE self: MIREmitter, node: BatchWindowFlush) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN TRY (mIREmitter__emit_batch_window_emit(&rtoc_self_view, Node{ BatchWindowFlush: COPY node }, "try ${node.window}.flush()"));
}
END
PRIVATE FN mIREmitter__emit_thunk_trampoline(MUTABLE self: MIREmitter, node: ThunkTrampoline) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE return_type_zig = TRY (type__zig_type(node.return_type));
    MUTABLE param_field_lines = mIREmitter__emit_thunk_frame_field_decls(rtoc_self_view, node.param_fields, "            ");
    MUTABLE param_init = TRY (mIREmitter__emit_thunk_frame_inits(&rtoc_self_view, node.param_init_fields));
    MUTABLE base_case_branches = (node.base_cases |> SELECT "if (${TRY (mIREmitter__emit(&rtoc_self_view, _.cond))}) {\n                    const result: ${return_type_zig} = ${TRY (mIREmitter__emit(&rtoc_self_view, _.value))};\n${TRY (mIREmitter__emit_thunk_return_or_pop(rtoc_self_view))}\n                }\n".trim()).join("\n                    ");
    MUTABLE recurse_arg_inits = TRY (mIREmitter__emit_thunk_frame_inits(&rtoc_self_view, node.recurse_arg_inits));
    MUTABLE combine_op = TRY (mIREmitter__emit_thunk_combine_op(rtoc_self_view, node.combine_op));
    RETURN "const Frame = struct {\n        ${param_field_lines}\n        step: u8 = 0,\n        child_result: ${return_type_zig} = undefined,\n        parent: ?*@This() = null,\n    };\n    var initial: Frame = .{ ${param_init} };\n    var current: *Frame = &initial;\n    while (true) {\n        // Cooperative yield: hands control back to the scheduler\n        // periodically (rt.checkYield uses its own internal\n        // counter -- thunk depth doesn't fight the fiber's\n        // own yield budget). Strippable via :TIGHT:THUNK\n        // for tight inner loops where the caller manages\n        // scheduler hand-off externally.\n        ${TRY (mIREmitter__emit_thunk_yield_statement(rtoc_self_view, node.yield_policy))}\n        switch (current.step) {\n            0 => {\n                ${base_case_branches}\n                // recursive call -- push child frame\n                const child = ${TRY (mIREmitter__alloc_zig(rtoc_self_view, :heap))}.create(Frame) catch unreachable;\n                child.* = .{ ${recurse_arg_inits}, .parent = current };\n                current.step = 1;\n                current = child;\n                continue;\n            },\n            1 => {\n                const result: ${return_type_zig} = ${TRY (mIREmitter__emit(&rtoc_self_view, node.combine_lhs))} ${combine_op} current.child_result;\n${TRY (mIREmitter__emit_thunk_return_or_pop(rtoc_self_view))}\n            },\n            else => unreachable,\n        }\n    }\n";
}
END
PRIVATE FN mIREmitter__emit_thunk_return_or_pop(self: MIREmitter) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN "if (current.parent) |p| {\n    p.child_result = result;\n    if (current != &initial) ${TRY (mIREmitter__alloc_zig(rtoc_self_view, :heap))}.destroy(current);\n    current = p;\n    continue;\n}\nreturn result;\n".trim();
}
END
PRIVATE FN mIREmitter__emit_mutual_thunk_trampoline(MUTABLE self: MIREmitter, node: MutualThunkTrampoline) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE variant_decls = (node.variants |> SELECT {
    MUTABLE fields = mIREmitter__emit_thunk_frame_field_decls(rtoc_self_view, _.param_fields, "          ");
    "${_.name}: struct {\n          ${fields}\n      },\n".trim()
    }).join("\n      ");
    MUTABLE initial_fields = TRY (mIREmitter__emit_thunk_frame_inits(&rtoc_self_view, node.initial_fields));
    MUTABLE switch_arms = (node.arms |> SELECT TRY (mIREmitter__emit_mutual_thunk_arm(&rtoc_self_view, _))).join("\n              ");
    RETURN "const Frame = union(enum) {\n    ${variant_decls}\n};\nvar current: Frame = .{ .${node.initial_variant} = .{ ${initial_fields} } };\nwhile (true) {\n    ${TRY (mIREmitter__emit_thunk_yield_statement(rtoc_self_view, node.yield_policy))}\n    switch (current) {\n        ${switch_arms}\n    }\n}\n";
}
END
PRIVATE FN mIREmitter__emit_mutual_thunk_arm(MUTABLE self: MIREmitter, arm: MutualThunkArm) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE base_branches = (arm.base_cases |> SELECT "if (${TRY (mIREmitter__emit(&rtoc_self_view, _.cond))}) {\n                      return ${TRY (mIREmitter__emit(&rtoc_self_view, _.value))};\n                  }\n".trim()).join("\n                      ");
    MUTABLE target_arg_inits = TRY (mIREmitter__emit_thunk_frame_inits(&rtoc_self_view, arm.target_arg_inits));
    RETURN ".${arm.variant_name} => |f| {\n                ${base_branches}\n                current = .{ .${arm.target_variant} = .{ ${target_arg_inits} } };\n                continue;\n            },\n".trim();
}
END
PRIVATE FN mIREmitter__emit_thunk_frame_inits(MUTABLE self: MIREmitter, inits: []ThunkFrameInit) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN (inits |> SELECT ".${_.field_name} = ${TRY (mIREmitter__emit(&rtoc_self_view, _.value))}").join(", ");
}
END
PRIVATE FN mIREmitter__emit_thunk_frame_field_decls(self: MIREmitter, fields: []ThunkFrameField, indent: String) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (fields |> SELECT "${_.name}: ${TRY (type__zig_type(_.type_info))},").join("\n${indent}");
}
END
PRIVATE FN mIREmitter__emit_thunk_yield_statement(self: MIREmitter, policy_value: String@symbol) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (policy_value == :check) THEN
      RETURN "${rtoc_self_view.rt_name}.checkYield();";
    ELSE_IF (policy_value == :tight_skip) THEN
      RETURN "// (TIGHT: scheduler yield-check skipped)";
    ELSE
      panic("unknown thunk yield policy: {}");
    END
}
END
PRIVATE FN mIREmitter__emit_thunk_combine_op(self: MIREmitter, op: String@symbol) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY ((CAST({:ADD: "+", :SUB: "-", :MUL: "*", :DIV: "/"} AS {String@symbol}String))[op] OR_ELSE panic("unknown thunk combine op: {}"));
}
END
PRIVATE FN mIREmitter__emit_batch_window_emit(MUTABLE self: MIREmitter, node: Node, source: String) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE slice = "${node.batch_var()}_slice";
    MUTABLE val = "${node.batch_var()}_val";
    MUTABLE alloc = TRY (mIREmitter__alloc_zig(rtoc_self_view, node.alloc()));
    RETURN "if (${source}) |${slice}| {\n    defer ${node.window()}.freeBatch(${slice});\n    var ${node.batch_var()} = std.ArrayListUnmanaged(${node.elem_zig()}){ .items = ${slice}, .capacity = ${slice}.len };\n    _ = &${node.batch_var()};\n    const ${val} = ${TRY (mIREmitter__emit(&rtoc_self_view, node.value_expr()))};\n    try ${node.result_var()}.append(${alloc}, ${val});\n}\n".trim();
}
END
PRIVATE FN mIREmitter__emit_scope_block(MUTABLE self: MIREmitter, node: ScopeBlock) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE body = TRY (mIREmitter__emit_body(&rtoc_self_view, node.body));
    RETURN "{\n${body}\n}";
}
END
PRIVATE FN mIREmitter__emit_defer(MUTABLE self: MIREmitter, node: MIRDeferStmt) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN mIREmitter__emit_defer_like(rtoc_self_view, "defer", TRY (mIREmitter__emit_defer_body(&rtoc_self_view, node.body)));
}
END
PRIVATE FN mIREmitter__emit_errdefer(MUTABLE self: MIREmitter, node: ErrDeferStmt) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN mIREmitter__emit_defer_like(rtoc_self_view, "errdefer", TRY (mIREmitter__emit_defer_body(&rtoc_self_view, node.body)));
}
END
PRIVATE FN mIREmitter__emit_defer_body(MUTABLE self: MIREmitter, body: DeferBody) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF body IS_A []Emittable AS array THEN
      RETURN "{\n${mIREmitter__indent_block(rtoc_self_view, TRY (mIREmitter__emit_body(&rtoc_self_view, array)), 4)}\n}";
    ELSE
      RETURN UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, body)));
    END
}
END
PRIVATE FN mIREmitter__emit_defer_like(self: MIREmitter, keyword: String, body_input: ?String) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE body = COPY body_input;
    MUTABLE body_value: String = body?;
    IF body_value.startsWith?("{") THEN
      RETURN "${keyword} ${body_value}";
    END
    RETURN "${keyword} ${body_value};";
}
END
PRIVATE FN mIREmitter__emit_expr_stmt(MUTABLE self: MIREmitter, node: ExprStmt) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE code: ?String = TRY (mIREmitter__emit(&rtoc_self_view, node.expr));
    IF node.discard THEN
      RETURN "_ = ${code};";
    ELSE
      RETURN "${code};";
    END
}
END
PRIVATE FN mIREmitter__emit_heap_create(MUTABLE self: MIREmitter, node: HeapCreate) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE label = (node.label OR_ELSE "__hc");
    MUTABLE init: ?String = TRY (mIREmitter__emit(&rtoc_self_view, node.init));
    MUTABLE alloc = TRY (mIREmitter__alloc_expr(&rtoc_self_view, Alloc{ SymbolValue: COPY node.alloc }));
    RETURN "${label}: {\n    const __p = try ${alloc}.create(${node.zig_type});\n    errdefer ${alloc}.destroy(__p);\n    __p.* = ${init};\n    break :${label} __p;\n}";
}
END
PRIVATE FN mIREmitter__emit_dupe_slice(MUTABLE self: MIREmitter, node: DupeSlice) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN "@as([]const u8, try ${TRY (mIREmitter__alloc_expr(&rtoc_self_view, Alloc{ SymbolValue: COPY node.alloc }))}.dupe(u8, ${TRY (mIREmitter__emit(&rtoc_self_view, node.source))}))";
}
END
PRIVATE FN mIREmitter__emit_alloc_slice(MUTABLE self: MIREmitter, node: AllocSlice) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN "try ${TRY (mIREmitter__alloc_expr(&rtoc_self_view, Alloc{ SymbolValue: COPY node.alloc }))}.alloc(${node.elem_type}, ${TRY (mIREmitter__emit(&rtoc_self_view, node.len))})";
}
END
PRIVATE FN mIREmitter__emit_free_slice(MUTABLE self: MIREmitter, node: FreeSlice) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN "${TRY (mIREmitter__alloc_expr(&rtoc_self_view, node.alloc))}.free(${TRY (mIREmitter__emit(&rtoc_self_view, node.slice))})";
}
END
PRIVATE FN mIREmitter__emit_destroy_ptr(MUTABLE self: MIREmitter, node: DestroyPtr) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN "${TRY (mIREmitter__alloc_expr(&rtoc_self_view, node.alloc))}.destroy(${TRY (mIREmitter__emit(&rtoc_self_view, node.ptr))})";
}
END
PRIVATE FN mIREmitter__alloc_expr(MUTABLE self: MIREmitter, alloc: Alloc) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF alloc IS_A String@symbol AS string_symbol THEN
      RETURN TRY (mIREmitter__alloc_zig(rtoc_self_view, string_symbol));
    ELSE
      RETURN UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, alloc)));
    END
}
END
FN mIREmitter__emit_stmt_list(MUTABLE self: MIREmitter, stmts: []Emittable) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN TRY (mIREmitter__emit_body(&rtoc_self_view, stmts));
}
END
FN mIREmitter__emit_direct_cleanup(self: MIREmitter, name: String, entry: CleanupEntry, alloc_override: ?String = NIL) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE alloc = (alloc_override OR_ELSE TRY (mIREmitter__alloc_from_entry(rtoc_self_view, entry)));
    MUTABLE guarded = cleanupEntry__has_moved_guard?(entry);
    MUTABLE via_pointer = cleanupEntry__via_pointer?(entry);
    IF (cleanupEntry__kind(entry) == :resource) THEN
      MUTABLE close = TRY (mIREmitter__render_resource_close_plan(rtoc_self_view, UNWRAP (cleanupEntry__resource_close_plan(entry)), name));
      RETURN mIREmitter__direct_cleanup_statement(rtoc_self_view, name, close, guarded);
    ELSE_IF (cleanupEntry__kind(entry) == :tuple) THEN
      RETURN mIREmitter__direct_cleanup_statement(rtoc_self_view, name, TRY (mIREmitter__render_tuple_cleanup(rtoc_self_view, entry, name, alloc)), guarded);
    ELSE
      MUTABLE rc_alloc: ?String@symbol = cleanupEntry__rc_alloc(entry);
      MUTABLE use_alloc: String = "";
      IF (((cleanupEntry__kind(entry) == :rc) AND (rc_alloc != NIL)) AND (alloc_override == NIL)) THEN
        use_alloc = TRY (mIREmitter__alloc_from_sym(rtoc_self_view, symbol(UNWRAP (rc_alloc))));
      ELSE
        use_alloc = alloc;
      END
      MUTABLE use_name: String = "";
      IF (cleanupEntry__kind(entry) == :frozen) THEN
        use_name = "${name}__buf";
      ELSE
        use_name = COPY name;
      END
      MUTABLE use_type: String = "";
      IF via_pointer THEN
        use_type = "@TypeOf(${use_name}.*)";
      ELSE
        use_type = "@TypeOf(${use_name})";
      END
      MUTABLE result = mIREmitter__direct_uniform_cleanup(rtoc_self_view, use_name, use_type, use_alloc, guarded, via_pointer);
      IF cleanupEntry__rc_release_fields_cleanup?(entry) THEN
        MUTABLE guard: String = "";
        IF guarded THEN
          guard = "if (!${mIREmitter__move_guard_name(rtoc_self_view, Name{ StringValue: COPY name })}) ";
        ELSE
          guard = "";
        END
        result = (result $+ "\n${guard}CheatLib.releaseFields(${cleanupEntry__base_zig(entry)}, ${use_alloc}, ${name}.ctrl.data.*);");
      END
      RETURN result;
    END
}
END
PRIVATE FN mIREmitter__emit_cleanup(self: MIREmitter, node: Node, errdefer: Bool = FALSE) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE entry = node.cleanup_entry();
    MUTABLE alloc = TRY (mIREmitter__alloc_from_entry(rtoc_self_view, entry));
    MUTABLE name = node.name();
    MUTABLE g = cleanupEntry__has_moved_guard?(entry);
    MUTABLE vp = cleanupEntry__via_pointer?(entry);
    IF (entry.kind() == :resource) THEN
      MUTABLE close = TRY (mIREmitter__render_resource_close_plan(rtoc_self_view, cleanupEntry__resource_close_plan(entry), name));
      RETURN mIREmitter__guarded_defer(rtoc_self_view, name, close, g, errdefer);
    ELSE_IF (entry.kind() == :tuple) THEN
      RETURN mIREmitter__guarded_defer(rtoc_self_view, name, TRY (mIREmitter__render_tuple_cleanup(rtoc_self_view, entry, name, alloc)), g, errdefer);
    ELSE
      MUTABLE use_alloc: String = "";
      IF ((entry.kind() == :rc) AND cleanupEntry__rc_alloc(entry)) THEN
        use_alloc = TRY (mIREmitter__alloc_from_sym(rtoc_self_view, cleanupEntry__rc_alloc(entry)));
      ELSE
        use_alloc = alloc;
      END
      MUTABLE use_name: String = "";
      IF (entry.kind() == :frozen) THEN
        use_name = "${name}__buf";
      ELSE
        use_name = name;
      END
      MUTABLE use_type: String = "";
      IF vp THEN
        use_type = "@TypeOf(${use_name}.*)";
      ELSE
        use_type = "@TypeOf(${use_name})";
      END
      MUTABLE result = mIREmitter__guarded_cleanup(rtoc_self_view, use_name, use_type, use_alloc, g, errdefer, vp);
      IF cleanupEntry__rc_release_fields_cleanup?(entry) THEN
        MUTABLE guard: String = "";
        IF g THEN
          guard = "if (!${mIREmitter__move_guard_name(rtoc_self_view, name)}) ";
        ELSE
          guard = "";
        END
        MUTABLE kw: String = "";
        IF errdefer THEN
          kw = "errdefer";
        ELSE
          kw = "defer";
        END
        result = (result $+ "${kw} ${guard}CheatLib.releaseFields(${cleanupEntry__base_zig(entry)}, ${use_alloc}, ${name}.ctrl.data.*);\n");
      END
      RETURN result;
    END
}
END
PRIVATE FN mIREmitter__emit_move_mark(self: MIREmitter, node: MoveMark) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE guard = COPY (rtoc_self_view.move_guard_overrides[CAST(node.name AS String)] OR_ELSE mIREmitter__move_guard_name(rtoc_self_view, node.name));
    RETURN "${guard} = true;";
}
END
PRIVATE FN mIREmitter__emit_deep_copy(MUTABLE self: MIREmitter, node: DeepCopy) RETURNS !?String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE src = UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, node.source)));
    IF src.startsWith?("@panic(") THEN
      RETURN src;
    END
    MUTABLE alloc: ?String = IF node.alloc != NIL THEN
      TRY (mIREmitter__alloc_expr(&rtoc_self_view, Alloc{ SymbolValue: COPY symbol(UNWRAP ((node.alloc)?)) }))
    ELSE
      NIL
    END;
    rtoc_self_view.deep_copy_counter = (rtoc_self_view.deep_copy_counter + 1);
    MUTABLE bc = "blk_copy_${rtoc_self_view.deep_copy_counter.toString()}";
    IF (node.strategy == :passthrough) THEN
      RETURN "(if (comptime @typeInfo(@TypeOf(${src})) == .pointer and @typeInfo(@TypeOf(${src})).pointer.size == .one) (${src}).* else ${src})";
    ELSE_IF (node.strategy == :full_value) THEN
      MUTABLE storage_zig_type =     IF (IF node.type_info != NIL THEN
        type__error_union?(node.type_info)
      ELSE
        NIL
      END) THEN
        TRY (type__nested_zig_type(node.type_info))
      ELSE
        node.zig_type
      END;
      MUTABLE type_arg: String = "";
      IF (node.copy_shape == :pointer) THEN
        type_arg = "@TypeOf(${src})";
      ELSE
        type_arg = ((storage_zig_type OR "@TypeOf(${src})"));
      END
      IF (node.copy_shape == :slice) THEN
        RETURN "${bc}: { const __copy_src = ${src}; break :${bc} try CheatLib.dupeValue(${type_arg}, __copy_src, ${alloc}); }";
      ELSE
        MUTABLE pointer_type_arg: String = "";
        IF (node.copy_shape == :pointer) THEN
          pointer_type_arg = "@TypeOf(${src})";
        ELSE
          pointer_type_arg = ((storage_zig_type OR "@TypeOf(__copy_src)"));
        END
        MUTABLE pointer_value: String = "";
        IF (node.copy_shape == :value) THEN
          pointer_value = "__copy_src.*";
        ELSE
          pointer_value = "__copy_src";
        END
        RETURN "${bc}: { const __copy_src = ${src}; if (comptime @typeInfo(@TypeOf(__copy_src)) == .pointer and @typeInfo(@TypeOf(__copy_src)).pointer.size == .one) { break :${bc} try CheatLib.dupeValue(${pointer_type_arg}, ${pointer_value}, ${alloc}); } else { break :${bc} try CheatLib.dupeValue(${type_arg}, __copy_src, ${alloc}); } }";
      END
    ELSE
      panic("MIREmitter#emit_deep_copy: unhandled strategy :{}");
    END
}
END
PRIVATE FN mIREmitter__emit_container_init(self: MIREmitter, node: ContainerInit) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (node.strategy == :pool) OR (node.strategy == :list_capacity) OR (node.strategy == :set_capacity) THEN
      RETURN "try ${node.zig_type}.initCapacity(${TRY (mIREmitter__alloc_zig(rtoc_self_view, symbol(UNWRAP (node.alloc))))}, ${node.capacity})";
    ELSE_IF (node.strategy == :array_list_empty) OR (node.strategy == :grid_empty) THEN
      RETURN "@as(${node.zig_type}, .empty)";
    ELSE_IF (node.strategy == :list_empty) OR (node.strategy == :set_empty) OR (node.strategy == :map_empty) THEN
      RETURN "${node.zig_type}{}";
    ELSE_IF (node.strategy == :map_bare) THEN
      RETURN "${node.zig_type}{ .alloc = ${TRY (mIREmitter__alloc_zig(rtoc_self_view, symbol(UNWRAP (node.alloc))))} }";
    ELSE
      panic("MIREmitter#emit_container_init: unhandled strategy :{}");
    END
}
END
PRIVATE FN mIREmitter__emit_cap_wrap(MUTABLE self: MIREmitter, node: CapWrap) RETURNS !?String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE inner: ?String = TRY (mIREmitter__emit(&rtoc_self_view, node.inner));
    MUTABLE alloc = TRY (mIREmitter__alloc_zig(rtoc_self_view, node.alloc));
    IF (node.strategy == :local) THEN
      RETURN "try CheatLib.localCreate(${node.zig_base}, ${alloc}, ${inner})";
    ELSE_IF (node.strategy == :sync_only) THEN
      RETURN "try CheatLib.${node.sync_fn}(${node.zig_base}, ${alloc}, ${inner})";
    ELSE_IF (node.strategy == :own_only) THEN
      RETURN "try CheatLib.${node.own_fn}(${node.zig_base}, ${alloc}, ${inner})";
    ELSE_IF (node.strategy == :both) THEN
      RETURN "blk_cap: {\n    const __cap_inner = try CheatLib.${node.sync_fn}(${node.zig_base}, ${alloc}, ${inner});\n    const __cap_val = __cap_inner.*;\n    ${alloc}.destroy(__cap_inner);\n    break :blk_cap try CheatLib.${node.own_fn}(${node.sync_type}, ${alloc}, __cap_val);\n}\n".trim();
    ELSE_IF (node.strategy == :passthrough) THEN
      RETURN inner;
    ELSE
      panic("MIREmitter#emit_cap_wrap: unhandled strategy :{}");
    END
}
END
PRIVATE FN mIREmitter__emit_share_promote(MUTABLE self: MIREmitter, node: SharePromote) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE source: ?String = TRY (mIREmitter__emit(&rtoc_self_view, node.source));
    MUTABLE alloc = TRY (mIREmitter__alloc_zig(rtoc_self_view, node.alloc));
    RETURN "blk_share: {\n    const __share_src = ${source};\n    errdefer CheatLib.rcRelease(${node.zig_base}, ${alloc}, __share_src);\n    var __share_val = try CheatLib.dupeValue(${node.zig_base}, __share_src.ctrl.data.*, ${alloc});\n    errdefer CheatLib.cleanup(${node.zig_base}, ${alloc}, &__share_val);\n    const __share_arc = try CheatLib.arcCreate(${node.zig_base}, ${alloc}, __share_val);\n    CheatLib.rcRelease(${node.zig_base}, ${alloc}, __share_src);\n    break :blk_share __share_arc;\n}\n".trim();
}
END
PRIVATE FN mIREmitter__emit_rc_retain(MUTABLE self: MIREmitter, node: RcRetain) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    RETURN "CheatLib.${node.func}(${node.zig_base}, ${TRY (mIREmitter__emit(&rtoc_self_view, node.source))})";
}
END
PRIVATE FN mIREmitter__emit_comptime_carrier_payload(MUTABLE self: MIREmitter, node: ComptimeCarrierPayload) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE src = UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, node.source)));
    RETURN "(if (comptime @hasDecl(@TypeOf(${src}), \"__clear_ref_carrier\")) ${src}.ctrl.data.* else ${src})";
}
END
PRIVATE FN mIREmitter__emit_monomorphic_keep(MUTABLE self: MIREmitter, node: MonomorphicKeep) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE src = UNWRAP (TRY (mIREmitter__emit(&rtoc_self_view, node.source)));
    MUTABLE alloc = TRY (mIREmitter__alloc_from_sym(rtoc_self_view, (node.alloc OR :heap)));
    RETURN "try CheatLib.dupeValue(@TypeOf(${src}), ${src}, ${alloc})";
}
END
