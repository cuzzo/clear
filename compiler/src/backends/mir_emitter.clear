PRIVATE FN mIREmitter__sharded_map_stdlib_def(node: MIREmitterShardedMapNode) RETURNS ?FunctionSignature@multiowned ->
  PARTIAL MATCH node START
    MIREmitterShardedMapNode.ShardedMapPut AS item -> RETURN KEEP item.stdlib_def;,
