EXTERN STRUCT CompilerRegex {} FROM "compiler_regex";
EXTERN FN compilerRegexCompile(pattern: String) RETURNS CompilerRegex EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexMatch(subject: String, regex: CompilerRegex) RETURNS Bool EFFECTS :safe FROM "compiler_regex";
FN regexMatch?(subject: String, pattern: String) RETURNS Bool ->
  RETURN compilerRegexMatch(subject, compilerRegexCompile(pattern));
END

PUB STRUCT ZigType {
  anyerror_union: Bool,
  explicit_error_set_union: Bool,
  inferred_error_union: Bool,
  source: String
}

PUB FN zigType__reserved_identifier?(name: String) RETURNS Bool ->
  RETURN ((( { MUTABLE rtoc_pipe_src = ["_", "addrspace", "align", "allowzero", "and", "anyframe", "anytype", "asm", "async", "await", "break", "callconv", "catch", "comptime", "const", "continue", "defer", "else", "enum", "errdefer", "error", "export", "extern", "false", "fn", "for", "if", "inline", "linksection", "noalias", "noinline", "nosuspend", "null", "opaque", "or", "orelse", "packed", "pub", "resume", "return", "struct", "suspend", "switch", "test", "threadlocal", "true", "try", "type", "undefined", "union", "unreachable", "usingnamespace", "var", "volatile", "while"]; rtoc_pipe_src |> DISTINCT _ } ).contains?(name)) OR zigType__primitive_numeric_identifier?(name));
END
PUB FN zigType__initialize(MUTABLE self: ZigType, source: String) RETURNS Void ->
  self.source = COPY source;
  self.inferred_error_union = source.startsWith?("!");
  self.anyerror_union = source.contains?("anyerror!");
  self.explicit_error_set_union = source.contains?("error{");
END
PUB FN zigType__primitive_numeric_identifier?(name: String) RETURNS Bool ->
  IF (name.codepointCount() < 2) THEN
    RETURN FALSE;
  END
  IF !(((name.startsWith?("u") OR name.startsWith?("i")) OR name.startsWith?("f"))) THEN
    RETURN FALSE;
  END
  RETURN zigType__digits_only?(name.substr(1, (name.length - 1)));
END
PUB FN zigType__float_identifier?(name: String) RETURNS Bool ->
  IF (name.codepointCount() < 2) THEN
    RETURN FALSE;
  END
  IF !(name.startsWith?("f")) THEN
    RETURN FALSE;
  END
  RETURN zigType__digits_only?(name.substr(1, (name.length - 1)));
END
PUB FN zigType__integer_identifier?(name: String) RETURNS Bool ->
  IF (name.codepointCount() < 2) THEN
    RETURN FALSE;
  END
  IF !((name.startsWith?("u") OR name.startsWith?("i"))) THEN
    RETURN FALSE;
  END
  RETURN zigType__digits_only?(name.substr(1, (name.length - 1)));
END
PRIVATE FN zigType__digits_only?(value: String) RETURNS Bool ->
  RETURN regexMatch?(value, "\\A[0-9]+\\z");
END
PUB FN zigType__error_union?(self: ZigType) RETURNS Bool ->
  RETURN ((self.inferred_error_union OR self.anyerror_union) OR self.explicit_error_set_union);
END
PUB FN zigType__inferred_error_union?(self: ZigType) RETURNS Bool ->
  RETURN self.inferred_error_union;
END
PUB FN zigType__fallible_return_type(self: ZigType) RETURNS String ->
  IF zigType__top_level_error_union?(self) THEN
    RETURN COPY self.source;
  END
  RETURN "!${self.source}";
END
PUB FN zigType__concrete_fallible_return_type(self: ZigType) RETURNS String ->
  IF zigType__top_level_concrete_error_union?(self) THEN
    RETURN COPY self.source;
  END
  IF zigType__inferred_error_union?(self) THEN
    RETURN "anyerror${self.source}";
  END
  RETURN "anyerror!${self.source}";
END
PUB FN zigType__fallible_return_type_for(self: ZigType, reentrant: Bool) RETURNS String ->
  IF reentrant THEN
    RETURN zigType__concrete_fallible_return_type(self);
  ELSE
    RETURN zigType__fallible_return_type(self);
  END
END
PUB FN zigType__anyerror_return_type(self: ZigType) RETURNS String ->
  IF zigType__top_level_error_union?(self) THEN
    RETURN COPY self.source;
  END
  RETURN "anyerror!${self.source}";
END
PUB FN zigType__cast_target_type(self: ZigType) RETURNS String ->
  IF zigType__inferred_error_union?(self) THEN
    RETURN "anyerror${self.source}";
  END
  RETURN COPY self.source;
END
PUB FN zigType__cleanup_storage_type(self: ZigType) RETURNS String ->
  IF zigType__inferred_error_union?(self) THEN
    RETURN COPY self.source.substr(1, (self.source.length - 1));
  END
  RETURN COPY self.source;
END
PRIVATE FN zigType__top_level_error_union?(self: ZigType) RETURNS Bool ->
  RETURN (zigType__inferred_error_union?(self) OR zigType__top_level_concrete_error_union?(self));
END
PRIVATE FN zigType__top_level_concrete_error_union?(self: ZigType) RETURNS Bool ->
  RETURN (self.source.startsWith?("anyerror!") OR regexMatch?(self.source, "\\Aerror\\{[^}]*\\}!"));
END
PUB FN zigType__new(source: String) RETURNS ZigType ->
  MUTABLE self = ZigType{ anyerror_union: FALSE, explicit_error_set_union: FALSE, inferred_error_union: FALSE, source: COPY source };
  zigType__initialize(&self, source);
  RETURN self;
END
