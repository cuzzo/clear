REQUIRE "pkg:rtoc_6173742f747970652e636c656172" AS type
REQUIRE "pkg:rtoc_6173742f6c657865722e636c656172" AS lexer
REQUIRE "pkg:rtoc_6173742f7061727365722e636c656172" AS parser
REQUIRE "pkg:rtoc_6173742f6173742e636c656172" AS ast
REQUIRE "pkg:rtoc_616e6e6f7461746f722e636c656172" AS annotator
REQUIRE "pkg:rtoc_6d69722f7265777269746572732f706970656c696e655f72657772697465722e636c656172" AS pipeline_rewriter
REQUIRE "pkg:rtoc_6d69722f7265777269746572732f737472696e675f636f6e6361745f72657772697465722e636c656172" AS string_concat_rewriter
REQUIRE "pkg:rtoc_6d69722f686f6973742e636c656172" AS hoist
REQUIRE "pkg:rtoc_73656d616e7469632f706173735f73746174652e636c656172" AS pass_state
REQUIRE "pkg:rtoc_6d69722f636f6e74726f6c5f666c6f772e636c656172" AS control_flow
