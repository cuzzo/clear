REQUIRE "pkg:rtoc_6d69722f6c6f776572696e672f736368656d615f72656769737472792e636c656172" AS schema_registry
REQUIRE "pkg:rtoc_6d69722f6c6f776572696e672f73746174652e636c656172" AS state
REQUIRE "pkg:rtoc_6666692f635f6865616465725f696d706f727465722e636c656172" AS c_header_importer
REQUIRE "pkg:rtoc_636f6d70696c65722f6d6f64756c655f696d706f727465722e636c656172" AS module_importer
REQUIRE "pkg:rtoc_6173742f66726f6e74656e645f7265736f757263655f6275646765742e636c656172" AS frontend_resource_budget
REQUIRE "pkg:rtoc_6d69722f6d69722e636c656172" AS mir
REQUIRE "pkg:rtoc_616e6e6f7461746f722f616e6e6f7461746f722e636c656172" AS annotator
