REQUIRE "pkg:rtoc_6173742f73636f70652e636c656172" AS scope

# Hand-written: ruby-to-clear cannot translate module_importer.rb, whose cache
# lookup forwards a block (`cache.fetch(key, paths, &block)`) and so has no
# inlinable CLEAR fallback.
#
# The annotator only needs the TYPE and two entry points -- it holds the
# importer as `?ModuleImporter` and reads exactly two fields off a compiled
# module. Resolution passes NIL for the importer whenever there is nothing to
# import, which is the path the byte-compatibility harness takes, so these
# bodies stay unimplemented until the self-hosted compiler drives imports
# itself.
PUB STRUCT CompiledModule {
  # Ruby's CompiledModule Struct carries the parsed program alongside the
  # scope; readers check it before walking its statements.
  ast: ?Program,
  global_scope: Scope@multiowned,
  source_dir: String,
  # Ruby's Struct carries the schemas and MIR items a REQUIRE inlines; the
  # types are the ones schema_registry declares for the same data.
  struct_schemas: {String@symbol}StructSchema@multiowned,
  union_schemas: {String@symbol}UnionSchema@multiowned,
  enum_schemas: {String@symbol}[]TypeEnumVariantsItem,
  mir_items: ?[]Emittable,
  type_items: ?[]Emittable
}

PUB STRUCT ModuleImporter {
  source_dir: String
}

PUB FN moduleImporter__compile_package(MUTABLE self: ModuleImporter, path: String, caller_dir: String) RETURNS !?CompiledModule ->
  RETURN panic("module import is not available in the self-hosted annotator yet");
END

PUB FN moduleImporter__compile_file(MUTABLE self: ModuleImporter, path: String, caller_dir: String) RETURNS !?CompiledModule ->
  RETURN panic("module import is not available in the self-hosted annotator yet");
END

# Ruby looks the package up in `@pkg_paths` and falls back to the name it was
# given. This importer registers no paths -- module import is stubbed here --
# so the fallback is the whole behaviour.
PUB FN moduleImporter__owning_package_name(self: ModuleImporter, pkg_name: String) RETURNS String ->
  RETURN COPY pkg_name;
END

# Ruby answers true when the package has no registered path and does not
# resolve on disk. This importer registers none, so every package is stdlib
# as far as it is concerned.
PUB FN moduleImporter__stdlib_package?(self: ModuleImporter, pkg_name: String) RETURNS Bool ->
  RETURN TRUE;
END
