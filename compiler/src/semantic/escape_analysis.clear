    Locatable.BgStreamBlock AS item -> RETURN DynamicValue{ BgStreamBlock: COPY item };,
    Locatable.YieldExpr AS item -> RETURN DynamicValue{ YieldExpr: COPY item };,
    Locatable.CloseStream AS item -> RETURN DynamicValue{ CloseStream: COPY item };,
    Locatable.NextExpr AS item -> RETURN DynamicValue{ NextExpr: COPY item };,
    Locatable.MatchStatement AS item -> RETURN DynamicValue{ MatchStatement: COPY item };,
    Locatable.ForRange AS item -> RETURN DynamicValue{ ForRange: COPY item };,
    Locatable.ForEach AS item -> RETURN DynamicValue{ ForEach: COPY item };,
    Locatable.TestBlock AS item -> RETURN DynamicValue{ TestBlock: COPY item };,
    Locatable.WhenBlock AS item -> RETURN DynamicValue{ WhenBlock: COPY item };,
    Locatable.LetBinding AS item -> RETURN DynamicValue{ LetBinding: COPY item };,
    Locatable.TestThat AS item -> RETURN DynamicValue{ TestThat: COPY item };,
    Locatable.AssertRaises AS item -> RETURN DynamicValue{ AssertRaises: COPY item };,
    Locatable.BenchmarkStmt AS item -> RETURN DynamicValue{ BenchmarkStmt: COPY item };,
    Locatable.SmashStmt AS item -> RETURN DynamicValue{ SmashStmt: COPY item };,
    Locatable.ProfileStmt AS item -> RETURN DynamicValue{ ProfileStmt: COPY item };,
    Locatable.StubDecl AS item -> RETURN DynamicValue{ StubDecl: COPY item };,
    Locatable.Drop AS item -> RETURN DynamicValue{ Drop: COPY item };,
    Locatable.SuppressCleanup AS item -> RETURN DynamicValue{ SuppressCleanup: COPY item };,
    Locatable.Return AS item -> RETURN DynamicValue{ Return: COPY item };,
    Locatable.ReassignCleanup AS item -> RETURN DynamicValue{ ReassignCleanup: COPY item };,
    Locatable.FieldCleanup AS item -> RETURN DynamicValue{ FieldCleanup: COPY item };,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
FN castAssignmentNameToDynamicValue(value: AssignmentName) RETURNS ?DynamicValue ->
  PARTIAL MATCH value START
    AssignmentName.StringValue AS item -> RETURN DynamicValue{ StringValue: COPY item };,
    AssignmentName.Identifier AS item -> RETURN DynamicValue{ Identifier: COPY item };,
    AssignmentName.GetField AS item -> RETURN DynamicValue{ GetField: COPY item };,
    AssignmentName.GetIndex AS item -> RETURN DynamicValue{ GetIndex: COPY item };,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
