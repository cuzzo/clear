    Locatable.StructLit AS item -> RETURN DynamicValue{ StructLit: COPY item };,
    Locatable.LambdaLit AS item -> RETURN DynamicValue{ LambdaLit: COPY item };,
    Locatable.IfStatement AS item -> RETURN DynamicValue{ IfStatement: COPY item };,
    Locatable.IfBind AS item -> RETURN DynamicValue{ IfBind: COPY item };,
    Locatable.WhileLoop AS item -> RETURN DynamicValue{ WhileLoop: COPY item };,
    Locatable.WhileBindLoop AS item -> RETURN DynamicValue{ WhileBindLoop: COPY item };,
    Locatable.BreakNode AS item -> RETURN DynamicValue{ BreakNode: COPY item };,
    Locatable.ContinueNode AS item -> RETURN DynamicValue{ ContinueNode: COPY item };,
    Locatable.FuncCall AS item -> RETURN DynamicValue{ FuncCall: COPY item };,
    Locatable.GetField AS item -> RETURN DynamicValue{ GetField: COPY item };,
    Locatable.GetIndex AS item -> RETURN DynamicValue{ GetIndex: COPY item };,
    Locatable.ReturnNode AS item -> RETURN DynamicValue{ ReturnNode: COPY item };,
    Locatable.Assert AS item -> RETURN DynamicValue{ Assert: COPY item };,
    Locatable.ThrowNode AS item -> RETURN DynamicValue{ ThrowNode: COPY item };,
    Locatable.DieNode AS item -> RETURN DynamicValue{ DieNode: COPY item };,
    Locatable.Slice AS item -> RETURN DynamicValue{ Slice: COPY item };,
    Locatable.Require AS item -> RETURN DynamicValue{ Require: COPY item };,
    Locatable.WithBlock AS item -> RETURN DynamicValue{ WithBlock: COPY item };,
    Locatable.SyncPolicyDecl AS item -> RETURN DynamicValue{ SyncPolicyDecl: COPY item };,
    Locatable.SelectOp AS item -> RETURN DynamicValue{ SelectOp: COPY item };,
    Locatable.WhereOp AS item -> RETURN DynamicValue{ WhereOp: COPY item };,
    Locatable.IndexOp AS item -> RETURN DynamicValue{ IndexOp: COPY item };,
    Locatable.ReduceOp AS item -> RETURN DynamicValue{ ReduceOp: COPY item };,
    Locatable.OrderByOp AS item -> RETURN DynamicValue{ OrderByOp: COPY item };,
    Locatable.LimitOp AS item -> RETURN DynamicValue{ LimitOp: COPY item };,
    Locatable.UnnestOp AS item -> RETURN DynamicValue{ UnnestOp: COPY item };,
    Locatable.DistinctOp AS item -> RETURN DynamicValue{ DistinctOp: COPY item };,
    Locatable.EachOp AS item -> RETURN DynamicValue{ EachOp: COPY item };,
    Locatable.TapOp AS item -> RETURN DynamicValue{ TapOp: COPY item };,
    Locatable.SkipOp AS item -> RETURN DynamicValue{ SkipOp: COPY item };,
    Locatable.CollectOp AS item -> RETURN DynamicValue{ CollectOp: COPY item };,
    Locatable.TakeWhileOp AS item -> RETURN DynamicValue{ TakeWhileOp: COPY item };,
    Locatable.WindowOp AS item -> RETURN DynamicValue{ WindowOp: COPY item };,
    Locatable.BatchWindowOp AS item -> RETURN DynamicValue{ BatchWindowOp: COPY item };,
    Locatable.JoinOp AS item -> RETURN DynamicValue{ JoinOp: COPY item };,
    Locatable.FindOp AS item -> RETURN DynamicValue{ FindOp: COPY item };,
    Locatable.AnyOp AS item -> RETURN DynamicValue{ AnyOp: COPY item };,
    Locatable.AllOp AS item -> RETURN DynamicValue{ AllOp: COPY item };,
    Locatable.CountOp AS item -> RETURN DynamicValue{ CountOp: COPY item };,
    Locatable.SumOp AS item -> RETURN DynamicValue{ SumOp: COPY item };,
    Locatable.AverageOp AS item -> RETURN DynamicValue{ AverageOp: COPY item };,
    Locatable.MinOp AS item -> RETURN DynamicValue{ MinOp: COPY item };,
    Locatable.MaxOp AS item -> RETURN DynamicValue{ MaxOp: COPY item };,
    Locatable.ShardOp AS item -> RETURN DynamicValue{ ShardOp: COPY item };,
    Locatable.ConcurrentOp AS item -> RETURN DynamicValue{ ConcurrentOp: COPY item };,
    Locatable.Placeholder AS item -> RETURN DynamicValue{ Placeholder: COPY item };,
    Locatable.Copy AS item -> RETURN DynamicValue{ Copy: COPY item };,
    Locatable.TenseNavigation AS item -> RETURN DynamicValue{ TenseNavigation: COPY item };,
    Locatable.MutableBorrow AS item -> RETURN DynamicValue{ MutableBorrow: COPY item };,
    Locatable.CatchBlock AS item -> RETURN DynamicValue{ CatchBlock: COPY item };,
    Locatable.RecoverOp AS item -> RETURN DynamicValue{ RecoverOp: COPY item };,
    Locatable.StringConcat AS item -> RETURN DynamicValue{ StringConcat: COPY item };,
    Locatable.CapabilityWrap AS item -> RETURN DynamicValue{ CapabilityWrap: COPY item };,
    Locatable.MoveNode AS item -> RETURN DynamicValue{ MoveNode: COPY item };,
    Locatable.CopyNode AS item -> RETURN DynamicValue{ CopyNode: COPY item };,
    Locatable.KeepNode AS item -> RETURN DynamicValue{ KeepNode: COPY item };,
    Locatable.ShareNode AS item -> RETURN DynamicValue{ ShareNode: COPY item };,
    Locatable.LinkNode AS item -> RETURN DynamicValue{ LinkNode: COPY item };,
    Locatable.ResolveNode AS item -> RETURN DynamicValue{ ResolveNode: COPY item };,
    Locatable.FreezeNode AS item -> RETURN DynamicValue{ FreezeNode: COPY item };,
    Locatable.PassStmt AS item -> RETURN DynamicValue{ PassStmt: COPY item };,
    Locatable.StructPattern AS item -> RETURN DynamicValue{ StructPattern: COPY item };,
    Locatable.ExternFnDecl AS item -> RETURN DynamicValue{ ExternFnDecl: COPY item };,
    Locatable.ExternStructDecl AS item -> RETURN DynamicValue{ ExternStructDecl: COPY item };,
    Locatable.UnionDef AS item -> RETURN DynamicValue{ UnionDef: COPY item };,
    Locatable.UnionVariantLit AS item -> RETURN DynamicValue{ UnionVariantLit: COPY item };,
