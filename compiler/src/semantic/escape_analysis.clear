FN castLocatableToReturnNode__escape_analysis(value: Locatable) RETURNS ReturnNode ->
  IF value IS_A ReturnNode AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to ReturnNode");
END
