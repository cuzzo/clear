t: ProfileStmt }
PUB STRUCT EscapePlacementFact {
  fn_name: String,
  binding: BindingId,
  reason: String@symbol
}

PUB FN escapePlacementFact__symbol_name(self: EscapePlacementFact) RETURNS String ->
  RETURN COPY self.binding.name;
END
PUB FN escapePlacementFact__binding_id(self: EscapePlacementFact) RETURNS Int64 EFFECTS REENTRANT ->
  RETURN self.binding.binding_id;
END
PUB STRUCT FunctionFacts {
  fn: FunctionDef,
  symbols: {String}SymbolEntry@multiowned,
  binding_values: {String}[]Locatable,
  return_values: []Locatable,
  assignment_nodes: []AssignmentNode,
  escape_nodes: []Locatable,
  lambda_body_identifier_refs: {Int64}[]Identifier
}

PUB FN functionFacts__heap_symbol_count(self: FunctionFacts) RETURNS !Int64 ->
  RETURN (TRY (functionFacts__heap_symbol_ids(self))).length();
END
PUB FN functionFacts__heap_symbols(self: FunctionFacts) RETURNS !{String}SymbolEntry@multiowned ->
  MUTABLE out: {String}SymbolEntry@multiowned = {};
  FOR _ IN self.fn.params DO
  MUTABLE sym: ?SymbolEntry = COPY _.symbol;
  IF (escapeAnalysis__symbol_heap?(sym) AND (sym != NIL)) THEN
      out[_.name] = sym;
  END
  END
  FOR rtoc_key IN self.symbols.keys() DO
  MUTABLE sym: SymbolEntry@multiowned = COPY UNWRAP (self.symbols[rtoc_key]);
  IF escapeAnalysis__symbol_heap?(sym) THEN
    out[rtoc_key] = sym;
  END
  END
  RETURN out;
END
PUB FN functionFacts__heap_symbol_ids(self: FunctionFacts) RETURNS ![Set]Int64 ->
  RETURN (TRY (functionFacts__heap_symbols(self))).values() |> SELECT _.binding_id |> DISTINCT _;
END
PUB STRUCT EscapePlacementFacts {
  placements: []EscapePlacementFact
}

PUB FN escapePlacementFacts__record_new_heap_symbols_mut(MUTABLE self: EscapePlacementFacts, facts: FunctionFacts, before_heap_ids: [Set]Int64, reason: String@symbol) RETURNS !Void ->
  FOR rtoc_key IN (TRY (functionFacts__heap_symbols(facts))).keys() DO
  MUTABLE sym: SymbolEntry@multiowned = COPY UNWRAP ((TRY (functionFacts__heap_symbols(facts)))[rtoc_key]);
  IF before_heap_ids.contains?(sym.binding_id) THEN
    CONTINUE;
  END
  &self.placements.append(COPY EscapePlacementFact{ fn_name: COPY facts.fn.name, binding: COPY bindingId__from_symbol(rtoc_key, sym), reason: COPY reason });
  END
END
PUB FN escapePlacementFacts__heap_function_names(self: EscapePlacementFacts) RETURNS ![Set]String ->
  RETURN (self.placements |> SELECT _.fn_name) |> DISTINCT _;
END
PUB STRUCT EscapeAnalysisResult {
  heap_fns: [Set]String,
  bg_heap: [Set]String,
  placements: EscapePlacementFacts
}
PUB STRUCT EscapeContext {
  fn: FunctionDef,
  facts: ?FunctionFacts,
  fn_nodes: {String}FunctionDef,
  facts_by_name: {String}FunctionFacts,
  bg_heap: [Set]String,
  schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult
}
PUB STRUCT EscapeSink {
  name: String@symbol,
  node_classes: []Any@multiowned,
  handler: String@symbol
}

PUB FN escapeSink__matches?(self: EscapeSink, node: Any) RETURNS Bool ->
  RETURN PARTIAL MATCH node START
    BgSourceWalkValue.ReturnNode -> (self.handler == symbol("apply_return_escape_sink!")),
    BgSourceWalkValue.Assignment -> (self.handler == symbol("apply_assignment_escape_sink!")),
    BgSourceWalkValue.VarDecl -> (self.handler == symbol("apply_binding_escape_sink!")),
    BgSourceWalkValue.BindExpr -> (self.handler == symbol("apply_binding_escape_sink!")),
    BgSourceWalkValue.DestructuringAssignment -> (self.handler == symbol("apply_destructuring_escape_sink!")),
    AsyncSpawnNode.BgBlock -> (self.handler == symbol("apply_execution_boundary_escape_sink!")),
    BgSourceWalkValue.BgStreamBlock -> (self.handler == symbol("apply_execution_boundary_escape_sink!")),
    BgSourceWalkValue.LambdaLit -> (self.handler == symbol("apply_lambda_escape_sink!")),
    BgSourceWalkValue.FuncCall -> (self.handler == symbol("apply_func_call_escape_sink!")),
    AutoInferenceWalkNode.MethodCall -> (self.handler == symbol("apply_method_call_escape_sink!")),
    DEFAULT -> FALSE
  END;
END
PUB FN escapeAnalysis__escape_sinks() RETURNS [8]EscapeSink EFFECTS REENTRANT ->
  RETURN [EscapeSink{ name: :owning_return, node_classes: [BgSourceWalkValue.ReturnNode], handler: symbol("apply_return_escape_sink!") }, EscapeSink{ name: :enclosing_scope_store, node_classes: [BgSourceWalkValue.Assignment], handler: symbol("apply_assignment_escape_sink!") }, EscapeSink{ name: :binding_result, node_classes: [BgSourceWalkValue.VarDecl, BgSourceWalkValue.BindExpr], handler: symbol("apply_binding_escape_sink!") }, EscapeSink{ name: :destructured_binding, node_classes: [BgSourceWalkValue.DestructuringAssignment], handler: symbol("apply_destructuring_escape_sink!") }, EscapeSink{ name: :execution_boundary_capture, node_classes: [AsyncSpawnNode.BgBlock, BgSourceWalkValue.BgStreamBlock], handler: symbol("apply_execution_boundary_escape_sink!") }, EscapeSink{ name: :lambda_capture, node_classes: [BgSourceWalkValue.LambdaLit], handler: symbol("apply_lambda_escape_sink!") }, EscapeSink{ name: :takes_or_mutable_arg, node_classes: [BgSourceWalkValue.FuncCall], handler: symbol("apply_func_call_escape_sink!") }, EscapeSink{ name: :takes_or_mutable_arg, node_classes: [AutoInferenceWalkNode.MethodCall], handler: symbol("apply_method_call_escape_sink!") }];
END
PUB FN escapeAnalysis__apply_mut(fn_nodes: {String}FunctionDef, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL) RETURNS !Tuple<[Set]String, [Set]String> ->
  MUTABLE result = TRY (escapeAnalysis__apply_with_facts_mut(fn_nodes, schema_lookup));
  RETURN CAST(Tuple{result.heap_fns, result.bg_heap} AS Tuple<[Set]String, [Set]String>);
END
PUB FN escapeAnalysis__apply_with_facts_mut(fn_nodes: {String}FunctionDef, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL, body_summaries: {String}FunctionBodySummary = {}, hoist_bindings: ?{String}[]VarDecl = NIL) RETURNS !EscapeAnalysisResult ->
  MUTABLE bg_heap: [Set]String = Set[];
  MUTABLE placements = EscapePlacementFacts{ placements: List[] };
  MUTABLE facts_by_name: {String}FunctionFacts = {};
  FOR rtoc_key IN fn_nodes.keys() DO
  MUTABLE fn_value: FunctionDef = COPY UNWRAP (fn_nodes[rtoc_key]);
  IF fn_value.body THEN
    MUTABLE rtoc_hoisted: []VarDecl = [];
    IF hoist_bindings EXISTS AS rtoc_hoist_map THEN
      rtoc_hoisted = COPY (rtoc_hoist_map[rtoc_key] OR_ELSE List[]);
    END
    facts_by_name[rtoc_key] = TRY (escapeAnalysis__function_facts(fn_value, body_summaries[rtoc_key], rtoc_hoisted));
  END
  END
  FOR _ IN facts_by_name.values() DO
  TRY (escapeAnalysis__record_placement_phase_mut(&placements, _, :owning_return, %() USE(schema_lookup, _) -> {
  TRY (escapeAnalysis__mark_heap_return_facts_mut(_, schema_lookup));
  rubyToClearVoid__escape_analysis()
  }));
  END
  FOR _ IN facts_by_name.values() DO
  TRY (escapeAnalysis__record_placement_phase_mut(&placements, _, :receiver_backing_storage, %() USE(_) -> {
    TRY (escapeAnalysis__mark_param_receiver_allocations_heap_mut(_.escape_nodes));
    rubyToClearVoid__escape_analysis()
  }));
  TRY (escapeAnalysis__record_placement_phase_mut(&placements, _, :recursive_aggregate_owner, %() USE(schema_lookup, _) -> {
    TRY (escapeAnalysis__mark_recursive_aggregate_owners_heap_mut(_, schema_lookup));
    rubyToClearVoid__escape_analysis()
  }));
  END
  FOR _ IN facts_by_name.values() DO
  MUTABLE body = COPY _.fn.body;
  TRY (escapeAnalysis__record_placement_phase_mut(&placements, _, :escape_sink, %() USE(bg_heap, facts_by_name, fn_nodes, schema_lookup, _) -> {
    TRY (escapeAnalysis__mark_body_escapes_mut(_, fn_nodes, facts_by_name, bg_heap, schema_lookup));
    rubyToClearVoid__escape_analysis()
  }));
  TRY (escapeAnalysis__record_placement_phase_mut(&placements, _, :loop_receiver_backing_storage, %() USE(body) -> {
    TRY (escapeAnalysis__mark_loop_receiver_allocations_heap_mut((body |> SELECT castLocatableToNode(_))));
    rubyToClearVoid__escape_analysis()
  }));
  TRY (escapeAnalysis__record_placement_phase_mut(&placements, _, :assignment_ownership, %() USE(facts_by_name, fn_nodes, schema_lookup, _) -> {
    TRY (escapeAnalysis__propagate_assignment_ownership_mut(_, fn_nodes, facts_by_name, schema_lookup));
    rubyToClearVoid__escape_analysis()
  }));
  TRY (escapeAnalysis__record_placement_phase_mut(&placements, _, :hoist_dependency, %() USE(_) -> {
    TRY (escapeAnalysis__propagate_hoist_dependencies_mut(_));
    rubyToClearVoid__escape_analysis()
  }));
  TRY (escapeAnalysis__record_placement_phase_mut(&placements, _, :value_block_placement, %() USE(_) -> {
    escapeAnalysis__propagate_value_block_placements_mut(_);
    rubyToClearVoid__escape_analysis()
  }));
  END
  RETURN EscapeAnalysisResult{ heap_fns: COPY TRY (escapePlacementFacts__heap_function_names(placements)), bg_heap: COPY bg_heap, placements: COPY placements };
END
PRIVATE FN escapeAnalysis__record_placement_phase_mut(MUTABLE placements: EscapePlacementFacts, facts: FunctionFacts, reason: String@symbol, blk: FN() -> Void) RETURNS !Void ->
  MUTABLE before = TRY (functionFacts__heap_symbol_ids(facts));
  blk();
  TRY (escapePlacementFacts__record_new_heap_symbols_mut(&placements, facts, before, reason));
END
PUB FN escapeAnalysis__validate_escape_sink_handlers_mut() RETURNS !Void ->
  TRY (escapeAnalysis__validate_handler_registry_mut("EscapeAnalysis sink registry", CAST({:owning_return: [symbol("mark_heap_return_facts!"), symbol("mark_body_escapes!")], :enclosing_scope_store: [symbol("mark_body_escapes!")], :binding_result: [symbol("mark_body_escapes!")], :execution_boundary_capture: [symbol("mark_body_escapes!")], :lambda_capture: [symbol("mark_body_escapes!")], :takes_or_mutable_arg: [symbol("mark_body_escapes!")], :receiver_backing_storage: [symbol("mark_param_receiver_allocations_heap!"), symbol("mark_loop_receiver_allocations_heap!")]} AS {String@symbol}[]String@symbol)));
END
PUB FN escapeAnalysis__validate_escape_sinks_mut() RETURNS !Void ->
  MUTABLE missing: []String = ( { MUTABLE rtoc_empty_list_1: []String = List[]; rtoc_empty_list_1 } );
  FOR _ IN escapeAnalysis__escape_sinks() DO
  IF !(([:owning_return, :enclosing_scope_store, :binding_result, :destructured_binding, :execution_boundary_capture, :lambda_capture, :takes_or_mutable_arg, :receiver_backing_storage] |> DISTINCT _).contains?(_.name)) THEN
      &missing.append(COPY CAST(_.name AS String));
  END
  IF !(([symbol("apply_return_escape_sink!"), symbol("apply_assignment_escape_sink!"), symbol("apply_binding_escape_sink!"), symbol("apply_destructuring_escape_sink!"), symbol("apply_execution_boundary_escape_sink!"), symbol("apply_lambda_escape_sink!"), symbol("apply_func_call_escape_sink!"), symbol("apply_method_call_escape_sink!"), symbol("mark_heap_return_facts!"), symbol("mark_body_escapes!"), symbol("mark_param_receiver_allocations_heap!"), symbol("mark_loop_receiver_allocations_heap!"), symbol("propagate_assignment_ownership!"), symbol("mark_recursive_aggregate_owners_heap!"), symbol("propagate_hoist_dependencies!")] |> DISTINCT _).contains?(_.handler)) THEN
      &missing.append(COPY CAST(_.handler AS String));
  END
  END
  IF (missing.length() == 0) THEN
    RETURN;
  END
  panic("EscapeAnalysis executable sink registry is incomplete: {}");
END
PUB FN escapeAnalysis__validate_derived_placement_handlers_mut() RETURNS !Void ->
  TRY (escapeAnalysis__validate_handler_registry_mut("EscapeAnalysis derived placement registry", CAST({:recursive_aggregate_owner: [symbol("mark_recursive_aggregate_owners_heap!")], :assignment_ownership: [symbol("propagate_assignment_ownership!")], :hoist_dependency: [symbol("propagate_hoist_dependencies!")]} AS {String@symbol}[]String@symbol)));
END
PUB FN escapeAnalysis__validate_handler_registry_mut(label: String, registry: {String@symbol}[]String@symbol) RETURNS !Void ->
  MUTABLE missing: []String = ( { MUTABLE rtoc_empty_list_2: []String = List[]; rtoc_empty_list_2 } );
  FOR rtoc_key IN registry.keys() DO
  MUTABLE handlers: []String@symbol = COPY UNWRAP (registry[rtoc_key]);
  FOR _ IN handlers DO
  IF !(([symbol("apply_return_escape_sink!"), symbol("apply_assignment_escape_sink!"), symbol("apply_binding_escape_sink!"), symbol("apply_destructuring_escape_sink!"), symbol("apply_execution_boundary_escape_sink!"), symbol("apply_lambda_escape_sink!"), symbol("apply_func_call_escape_sink!"), symbol("apply_method_call_escape_sink!"), symbol("mark_heap_return_facts!"), symbol("mark_body_escapes!"), symbol("mark_param_receiver_allocations_heap!"), symbol("mark_loop_receiver_allocations_heap!"), symbol("propagate_assignment_ownership!"), symbol("mark_recursive_aggregate_owners_heap!"), symbol("propagate_hoist_dependencies!")] |> DISTINCT _).contains?(_)) THEN
    &missing.append("${rtoc_key}=${_}");
  END
  END
  END
  IF (missing.length() == 0) THEN
    RETURN;
  END
  panic("{} is incomplete: {}");
END
PUB FN escapeAnalysis__propagate_caller_sync_mut(fn_nodes: {String}FunctionDef, body_summaries: {String}FunctionBodySummary) RETURNS Void ->
  MUTABLE callsites: {String}[]CallSiteFact = {};
  FOR _ IN body_summaries.values() DO
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < _.call_site_facts.length() DO
    IF _.call_site_facts[rtoc_idx]?.fn_var_call THEN
      rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    MUTABLE callee_key: String = COPY UNWRAP (_.call_site_facts[rtoc_idx]).callee_name;
    MUTABLE callee_facts: []CallSiteFact = COPY (callsites[callee_key] OR_ELSE List[]);
    &callee_facts.append(COPY _.call_site_facts[rtoc_idx]);
    callsites[callee_key] = COPY callee_facts;
  rtoc_idx = rtoc_idx + 1;
  END
  END
  FOR rtoc_counter_sync IN (0_i64 ..< fn_nodes.count()) DO
  MUTABLE changed: Bool = FALSE;
  FOR rtoc_key IN fn_nodes.keys() DO
    MUTABLE callee_fn: FunctionDef = COPY UNWRAP (fn_nodes[rtoc_key]);
    MUTABLE sites = COPY (callsites[rtoc_key] OR_ELSE List[]);
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < callee_fn.params.length() DO
        MUTABLE entry: ?SymbolEntry = callee_fn.params[rtoc_idx]?.symbol;
        IF !(entry) THEN
            rtoc_idx = rtoc_idx + 1;
      CONTINUE;
        END
        IF !(escapeAnalysis__param_sync_was_declared?(callee_fn.params[rtoc_idx]?)) THEN
            MUTABLE unified: ?String@symbol = escapeAnalysis__unify_caller_attr(sites, rtoc_idx, %(s: SymbolEntry) -> {
          MUTABLE rtoc_sync: ?String@symbol = symbolEntry__sync(s);
          IF rtoc_sync == NIL THEN
            rtoc_sync = type__sync(symbolEntry__type(s));
          END
          rtoc_sync
            });
            IF unified EXISTS AS rtoc_unified THEN
              IF ((symbolEntry__sync(entry) != rtoc_unified) AND escapeAnalysis__param_accepts_caller_sync?(callee_fn, UNWRAP (callee_fn.params[rtoc_idx]), rtoc_unified)) THEN
                symbolEntry__set_sync(&entry, rtoc_unified);
                changed = TRUE;
              END
            END
        END
        MUTABLE unified_storage: ?String@symbol = escapeAnalysis__unify_caller_attr(sites, rtoc_idx, %(s: SymbolEntry) -> {
          MUTABLE rtoc_storage: ?String@symbol = NIL;
          IF symbolEntry__rc_stored?(s) THEN
            rtoc_storage = symbolEntry__storage(s);
          ELSE
            MUTABLE t: Type = symbolEntry__type(s);
            IF type__shared?(t) THEN
              rtoc_storage = :shared;
            ELSE_IF type__multiowned?(t) THEN
              rtoc_storage = :multiowned;
            END
          END
          rtoc_storage
        });
        IF unified_storage EXISTS AS rtoc_unified_storage THEN
          IF (symbolEntry__storage(entry) != rtoc_unified_storage) THEN
            symbolEntry__set_storage(&entry, rtoc_unified_storage);
            changed = TRUE;
          END
        END
      rtoc_idx = rtoc_idx + 1;
    END
  END
  IF !(changed) THEN
      BREAK;
  END
  END
END
PUB FN escapeAnalysis__apply_kept_identity_placement_mut(fn_nodes: {String}FunctionDef, body_summaries: {String}FunctionBodySummary, on_mutable_violation: ?FN(SymbolEntry, Identifier, String) -> Void = NIL, on_family_violation: ?FN(Locatable, String@symbol, String@symbol, String) -> Void = NIL, imported_params: {String}[]Param) RETURNS !Void ->
  MUTABLE kept_contracts: {String}{Int64}KeptIdentityContract = {};
  MUTABLE all_params: {String}[]Param = COPY imported_params;
  FOR rtoc_key IN fn_nodes.keys() DO
    all_params[rtoc_key] = COPY (UNWRAP (fn_nodes[rtoc_key])).params;
  END
  FOR rtoc_key IN all_params.keys() DO
  MUTABLE params: []Param = COPY UNWRAP (all_params[rtoc_key]);
  MUTABLE by_index: {Int64}KeptIdentityContract = {};
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < params.length() DO
      MUTABLE entry: ?SymbolEntry@multiowned = COPY params[rtoc_idx]?.symbol;
      MUTABLE contract: ?KeptIdentityContract = NIL;
      IF entry EXISTS AS entry_value THEN
        contract = COPY symbolEntry__kept_identity(entry_value);
      END
      IF !((entry AND (contract != NIL))) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF keptIdentityContract__rc?( contract) THEN
          symbolEntry__set_storage(&entry, :multiowned);
      END
      by_index[rtoc_idx] = contract;
    rtoc_idx = rtoc_idx + 1;
  END
  IF !((by_index.count() == 0)) THEN
      kept_contracts[rtoc_key] = by_index;
  END
  END
  FOR rtoc_summary IN body_summaries.values() DO
    MUTABLE owner_fn: ?FunctionDef = COPY fn_nodes[rtoc_summary.name];
    MUTABLE liveness: ?KeptEdgeLiveness@multiowned = NIL;
    MUTABLE local_entries: {String}SymbolEntry@multiowned = {};
    FOR rtoc_binding IN rtoc_summary.binding_nodes DO
      IF aST__node__symbol(castBindingNodeToLocatable(rtoc_binding)) EXISTS AS rtoc_binding_sym THEN
        local_entries[escapeAnalysis__bindingNodeName(rtoc_binding)] = COPY rtoc_binding_sym;
      END
    END
    FOR MUTABLE rtoc_site IN rtoc_summary.call_site_facts DO
      IF kept_contracts[rtoc_site.callee_name] EXISTS AS rtoc_kept THEN
        FOR rtoc_arg_index IN rtoc_kept.keys() DO
          TRY (escapeAnalysis__plan_kept_edge_mut(rtoc_summary, &rtoc_site, rtoc_arg_index, UNWRAP (rtoc_kept[rtoc_arg_index]), fn_nodes, local_entries, &liveness, owner_fn, on_mutable_violation, on_family_violation));
        END
      END
    END
  END
END

# Ruby plans one kept edge per argument inside the call-site loop and leaves
# with `next`; a CLEAR loop cannot, so each argument gets its own function and
# `next` becomes a plain RETURN.
PRIVATE FN escapeAnalysis__plan_kept_edge_mut(summary: FunctionBodySummary, MUTABLE site: CallSiteFact, idx: Int64, contract: KeptIdentityContract, fn_nodes: {String}FunctionDef, local_entries: {String}SymbolEntry, MUTABLE liveness: ?KeptEdgeLiveness, owner_fn: ?FunctionDef, on_mutable_violation: ?FN(SymbolEntry, Identifier, String) -> Void, on_family_violation: ?FN(Locatable, String@symbol, String@symbol, String) -> Void) RETURNS !Void ->
  IF site.args[idx] == NIL THEN
    RETURN;
  END
  MUTABLE raw_arg: Locatable = COPY UNWRAP (site.args[idx]);
  IF (aST__node_kept_edge_plan(raw_arg) != NIL) THEN
    RETURN;
  END
  MUTABLE family: String@symbol = COPY contract.family;
  MUTABLE given: Bool = raw_arg IS_A MoveNode;
  MUTABLE arg: Locatable = COPY raw_arg;
  IF raw_arg IS_A MoveNode AS rtoc_move THEN
    arg = COPY rtoc_move.value;
  END

  # Per-site COPY override: force an independent identity. Later rewrites may
  # unwrap the COPY node, so the plan rides the inner value too.
  IF arg IS_A CopyNode AS rtoc_copy THEN
    MUTABLE rtoc_copy_plan = CallEdgeOwnershipPlan{ op: :copy_wrap, family: COPY family };
    escapeAnalysis__stamp_kept_edge_plan_mut(&site, idx, rtoc_copy_plan);
    MUTABLE rtoc_inner: Locatable = COPY rtoc_copy.value;
    locatable__set_kept_edge_plan_mut(&rtoc_inner, rtoc_copy_plan);
    RETURN;
  END
  # Omitted / NIL optional edge.
  IF arg IS_A Literal AS rtoc_literal THEN
    IF (rtoc_literal.type == symbol("NIL")) THEN
      escapeAnalysis__stamp_kept_edge_plan_mut(&site, idx, CallEdgeOwnershipPlan{ op: :pass_null, family: COPY family });
      RETURN;
    END
  END

  IF !(arg IS_A Identifier) THEN
    # An rc-typed projection retains the identity it views; any owned payload
    # result moves into a fresh handle.
    MUTABLE rtoc_expr_type: ?Type = TRY (escapeAnalysis__kept_edge_arg_type(arg));
    IF escapeAnalysis__kept_family_conflict(rtoc_expr_type, family) EXISTS AS rtoc_expr_conflict THEN
      IF on_family_violation EXISTS AS rtoc_family_handler THEN
        rtoc_family_handler(arg, rtoc_expr_conflict, family, site.callee_name);
      END
      RETURN;
    END
    escapeAnalysis__stamp_kept_edge_plan_mut(&site, idx, CallEdgeOwnershipPlan{ op: TRY (escapeAnalysis__kept_edge_op(rtoc_expr_type)), family: COPY family });
    RETURN;
  END

  MUTABLE rtoc_ident: Identifier = COPY UNWRAP (castLocatableToIdentifier(arg));
  MUTABLE entry: ?SymbolEntry@multiowned = locatable__symbol(arg);
  IF (entry == NIL) THEN
    entry = COPY local_entries[CAST(rtoc_ident.name AS String)];
  END
  IF (entry == NIL) THEN
    MUTABLE rtoc_ident_type: ?Type = TRY (escapeAnalysis__kept_edge_arg_type(arg));
    escapeAnalysis__stamp_kept_edge_plan_mut(&site, idx, CallEdgeOwnershipPlan{ op: TRY (escapeAnalysis__kept_edge_op(rtoc_ident_type)), family: COPY family });
    RETURN;
  END
  MUTABLE rtoc_entry: SymbolEntry@multiowned = KEEP entry;

  IF escapeAnalysis__kept_family_conflict(symbolEntry__type(rtoc_entry), family) EXISTS AS rtoc_conflict THEN
    IF on_family_violation EXISTS AS rtoc_family_handler2 THEN
      rtoc_family_handler2(arg, rtoc_conflict, family, site.callee_name);
    END
    RETURN;
  END

  IF (liveness == NIL) THEN
    MUTABLE owner_body: []Locatable = [];
    IF owner_fn EXISTS AS owner_fn_value THEN
      owner_body = COPY owner_fn_value.body;
    END
    liveness = keptEdgeLiveness__new(owner_body);
  END
  MUTABLE last_use: Bool = given;
  IF !(last_use) THEN
    IF liveness EXISTS AS rtoc_liveness THEN
      last_use = keptEdgeLiveness__last_use?(rtoc_liveness, rtoc_ident);
    END
  END

  IF symbolEntry__is_param(rtoc_entry) THEN
    # A kept param already holds an owned handle: move it at its last use,
    # retain when it stays live.
    IF (last_use AND !(given)) THEN
      locatable__set_was_moved_mut(&arg, TRUE);
    END
    escapeAnalysis__stamp_kept_edge_plan_mut(&site, idx, CallEdgeOwnershipPlan{ op: escapeAnalysis__kept_edge_move_op(last_use), family: COPY family });
    RETURN;
  END

  MUTABLE already_rc: Bool = (symbolEntry__rc_stored?(rtoc_entry) OR TRY (type__any_rc?(symbolEntry__type(rtoc_entry))));
  IF ((!(already_rc) AND rtoc_entry.mutable) AND !(last_use)) THEN
    IF on_mutable_violation EXISTS AS rtoc_mutable_handler THEN
      rtoc_mutable_handler(rtoc_entry, rtoc_ident, site.callee_name);
    END
    RETURN;
  END
  IF !(already_rc) THEN
    TRY (escapeAnalysis__promote_kept_binding_mut(summary, fn_nodes, &rtoc_entry, &rtoc_ident));
  END
  IF (last_use AND !(given)) THEN
    locatable__set_was_moved_mut(&arg, TRUE);
  END
  escapeAnalysis__stamp_kept_edge_plan_mut(&site, idx, CallEdgeOwnershipPlan{ op: escapeAnalysis__kept_edge_move_op(last_use), family: COPY family });
END

PRIVATE FN escapeAnalysis__kept_edge_op(arg_type: ?Type) RETURNS !String@symbol ->
  IF arg_type EXISTS AS rtoc_arg_type THEN
    IF TRY (type__any_rc?(rtoc_arg_type)) THEN
      RETURN :retain_handle;
    END
  END
  RETURN :move_payload_wrap;
END

PRIVATE FN escapeAnalysis__kept_edge_move_op(last_use: Bool) RETURNS String@symbol ->
  IF last_use THEN
    RETURN :move_handle;
  END
  RETURN :retain_handle;
END

# The plan rides the argument node AND the call node keyed by index: rewrite
# passes may clone argument nodes, but the call node survives.
PRIVATE FN escapeAnalysis__stamp_kept_edge_plan_mut(MUTABLE site: CallSiteFact, idx: Int64, plan: CallEdgeOwnershipPlan) RETURNS Void ->
  IF site.args[idx] EXISTS AS MUTABLE rtoc_arg THEN
    locatable__set_kept_edge_plan_mut(&rtoc_arg, plan);
  END
  MUTABLE rtoc_plans: {Int64}CallEdgeOwnershipPlan = COPY (locatable__kept_edge_plans(site.node) OR_ELSE {});
  rtoc_plans[idx] = COPY plan;
  locatable__set_kept_edge_plans_mut(&site.node, rtoc_plans);
END
PUB FN escapeAnalysis__kept_edge_arg_type(arg: Locatable) RETURNS !?Type ->
  IF !((TRUE AND locatable__typed?(arg))) THEN
    panic("{}placement cannot plan an ownership edge for it");
  END
  RETURN TRY (type__from_node_mut(arg, "kept edge argument"));
END
PUB FN escapeAnalysis__kept_family_conflict(source_type: ?Type, dest_family: String@symbol) RETURNS ?String@symbol ->
  IF source_type EXISTS AS source_type_value THEN
    MUTABLE source_family: ?String@symbol = NIL;
    IF type__shared?(source_type_value) THEN
      source_family = :shared;
    ELSE_IF type__multiowned?(source_type_value) THEN
      source_family = :multiowned;
    END
    IF (FALSE OR (source_family == dest_family)) THEN
      RETURN NIL;
    END
    RETURN source_family;
  ELSE
    RETURN NIL;
  END
END
PUB FN escapeAnalysis__promote_kept_binding_mut(summary: FunctionBodySummary, fn_nodes: {String}FunctionDef, MUTABLE entry: SymbolEntry, MUTABLE arg: Identifier) RETURNS !Void ->
  MUTABLE rtoc_mutable_receiver_7 = symbolEntry__type(entry);
  TRY (type__set_ownership(&rtoc_mutable_receiver_7, :multiowned));
  symbolEntry__set_storage(&entry, :multiowned);
  # Ruby's `find` compares the declaration's symbol to this entry by identity.
  MUTABLE decl: ?BindingNode = NIL;
  FOR rtoc_binding_node IN summary.binding_nodes DO
    IF aST__node__symbol(castBindingNodeToLocatable(rtoc_binding_node)) EXISTS AS rtoc_binding_symbol THEN
      IF (rtoc_binding_symbol.binding_id == entry.binding_id) THEN
        decl = COPY rtoc_binding_node;
      END
    END
  END
  IF decl EXISTS AS decl_value THEN
    MUTABLE stamped: Type = TRY (aST__full_type_mut(castBindingNodeToLocatable(decl_value)));
    TRY (type__set_ownership(&stamped, :multiowned));
  END
  MUTABLE owner_fn: ?FunctionDef = COPY fn_nodes[summary.name];
  IF owner_fn EXISTS AS owner_fn_value THEN
    TRY (escapeAnalysis__restamp_promoted_uses_mut(COPY owner_fn_value.body, arg.name, entry));
  END
  arg.symbol = COPY entry;
END
PUB STRUCT KeptEdgeLiveness {
  by_object: {Int64}Occurrence,
  counter: Int64,
  last_position: {String}Int64
}

PUB STRUCT Occurrence {
  position: Int64,
  loop_depth: Int64
}
PUB FN keptEdgeLiveness__initialize(MUTABLE self: KeptEdgeLiveness, body: []Locatable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.by_object = {};
    rtoc_self_view.last_position = {};
    rtoc_self_view.counter = 0;
    FOR _ IN body DO
    keptEdgeLiveness__index_node(&rtoc_self_view, _, 0);
    END
}
END
PUB FN keptEdgeLiveness__last_use?(self: KeptEdgeLiveness, arg: Identifier) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE occ: ?Occurrence = COPY rtoc_self_view.by_object[aST__node_identity(Locatable{ Identifier: COPY arg })];
    IF occ EXISTS AS occ_value THEN
      IF occ_value.loop_depth.positive?() THEN
        RETURN FALSE;
      END
      RETURN ((rtoc_self_view.last_position[arg.name] OR_ELSE -1) <= occ_value.position);
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN keptEdgeLiveness__index_node(MUTABLE self: KeptEdgeLiveness, node: Locatable, loop_depth: Int64) RETURNS Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF node IS_A FunctionDef AS function_def THEN
      RETURN;
    END
    IF node IS_A Identifier AS identifier THEN
      rtoc_self_view.counter = (rtoc_self_view.counter + 1);
      rtoc_self_view.by_object[aST__node_identity(Locatable{ Identifier: COPY identifier })] = Occurrence{ position: rtoc_self_view.counter, loop_depth: COPY loop_depth };
      IF (rtoc_self_view.counter > (rtoc_self_view.last_position[identifier__name(identifier)] OR_ELSE -1)) THEN
        rtoc_self_view.last_position[identifier__name(identifier)] = COPY rtoc_self_view.counter;
      END
    END
    MUTABLE child_depth = IF aST__loop_node?(node) THEN
      (loop_depth + 1)
    ELSE
      loop_depth
    END;
    aST__each_child_node(node, %(child: Locatable) USE(child_depth, MUTABLE rtoc_self_view) -> {
    keptEdgeLiveness__index_node(&rtoc_self_view, child, child_depth);
    rubyToClearVoid__escape_analysis()
    });
}
END
PUB FN keptEdgeLiveness__new(body: []Locatable) RETURNS KeptEdgeLiveness@multiowned ->
  MUTABLE self = KeptEdgeLiveness{ by_object: {}, counter: 0, last_position: {} };
  keptEdgeLiveness__initialize(&self, body);
  RETURN self @multiowned;
END
PUB FN escapeAnalysis__restamp_promoted_uses_mut(body: []Locatable, name: String, entry: SymbolEntry) RETURNS !Void ->
  FOR _ IN body DO
  TRY (escapeAnalysis__restamp_promoted_uses_in_node_mut(_, name, entry));
  END
END
PUB FN escapeAnalysis__restamp_promoted_uses_in_node_mut(node: Locatable, name: String, entry: SymbolEntry) RETURNS !Void EFFECTS REENTRANT ->
  IF node IS_A FunctionDef AS function_def THEN
    RETURN;
  END
  IF (IF node IS_A Identifier AS identifier THEN (identifier__name(identifier) == name) ELSE FALSE END) THEN
    MUTABLE rtoc_same_binding: Bool = TRUE;
    IF locatable__symbol(node) EXISTS AS sym THEN
      rtoc_same_binding = (sym.binding_id == entry.binding_id);
    END
    IF rtoc_same_binding THEN
      MUTABLE stamp: Type = TRY (aST__full_type_mut(node));
      IF !(TRY (type__any_rc?(stamp))) THEN
        TRY (type__set_ownership(&stamp, :multiowned));
      END
    END
  END
  aST__each_child_node(node, %(child: Locatable) USE(entry, name) -> {
  TRY (escapeAnalysis__restamp_promoted_uses_in_node_mut(child, name, entry));
  rubyToClearVoid__escape_analysis()
  });
END
PUB FN escapeAnalysis__unify_caller_attr(sites: []CallSiteFact, idx: Int64, project: FN(SymbolEntry) -> ?String@symbol) RETURNS ?String@symbol ->
  MUTABLE observed_count: Int64 = 0;
  MUTABLE unique: [Set]String@symbol = Set[];
  MUTABLE saw_absent: Bool = FALSE;
  FOR rtoc_site IN sites DO
    observed_count = observed_count + 1;
    MUTABLE rtoc_projected: ?String@symbol = NIL;
    IF rtoc_site.args[idx] EXISTS AS arg THEN
      IF locatable__symbol(arg) EXISTS AS rtoc_arg_symbol THEN
        rtoc_projected = project(rtoc_arg_symbol);
      END
    END
    IF rtoc_projected EXISTS AS rtoc_projected_value THEN
      &unique.insert(COPY rtoc_projected_value);
    ELSE
      saw_absent = TRUE;
    END
  END
  IF (observed_count == 0) THEN
    RETURN NIL;
  END
  IF (saw_absent OR (unique.length() != 1)) THEN
    RETURN NIL;
  END
  FOR rtoc_only IN unique DO
    RETURN COPY rtoc_only;
  END
  RETURN NIL;
END
PUB FN escapeAnalysis__param_sync_was_declared?(param: Param) RETURNS ?Bool ->
  MUTABLE t = COPY param.type;
  RETURN (TRUE AND type__any_sync?(t));
END
PUB FN escapeAnalysis__param_accepts_caller_sync?(fn_node: FunctionDef, param: Param, sync_value: String@symbol) RETURNS Bool ->
  MUTABLE t = COPY param.type;
  IF (TRUE AND ((type__shared?(t) OR type__any_sync?(t)))) THEN
    RETURN TRUE;
  END
  IF !(symbolEntry__atomic_sync?(sync_value)) THEN
    RETURN TRUE;
  END
  MUTABLE requires: ?{String}[Set]String@symbol = fn_node.requires;
  IF requires EXISTS AS rtoc_requires THEN
    IF rtoc_requires[CAST(param.name AS String)] EXISTS AS families THEN
      RETURN (families.contains?(:ATOMIC) OR families.contains?(:SNAPSHOTTED));
    END
  END
  RETURN FALSE;
END
PUB FN escapeAnalysis__mark_body_escapes_mut(facts: FunctionFacts, fn_nodes: {String}FunctionDef, facts_by_name: {String}FunctionFacts, bg_heap: [Set]String, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Void ->
  MUTABLE context = EscapeContext{ fn: facts.fn, facts: COPY facts, fn_nodes: COPY fn_nodes, facts_by_name: COPY facts_by_name, bg_heap: COPY bg_heap, schema_lookup: schema_lookup };
  FOR rtoc_escape_node IN facts.escape_nodes DO
    FOR rtoc_sink IN escapeAnalysis__escape_sinks() DO
      IF escapeSink__matches?(rtoc_sink, rtoc_escape_node) THEN
        TRY (escapeAnalysis__apply_escape_sink_mut(rtoc_sink, rtoc_escape_node, &context));
      END
    END
  END
END
PUB FN escapeAnalysis__apply_escape_sink_mut(sink: EscapeSink, node: Locatable, MUTABLE context: EscapeContext) RETURNS !Void ->
  IF (sink.handler == symbol("apply_return_escape_sink!")) THEN
    TRY (escapeAnalysis__apply_return_escape_sink_mut(castLocatableToReturnNode__escape_analysis(node), context));
  ELSE_IF (sink.handler == symbol("apply_assignment_escape_sink!")) THEN
    TRY (escapeAnalysis__apply_assignment_escape_sink_mut(castLocatableToAssignment(node), context));
  ELSE_IF (sink.handler == symbol("apply_binding_escape_sink!")) THEN
    TRY (escapeAnalysis__apply_binding_escape_sink_mut(CAST(node AS Any@multiowned), context));
  ELSE_IF (sink.handler == symbol("apply_destructuring_escape_sink!")) THEN
    TRY (escapeAnalysis__apply_destructuring_escape_sink_mut(castLocatableToDestructuringAssignment(node), context));
  ELSE_IF (sink.handler == symbol("apply_execution_boundary_escape_sink!")) THEN
    TRY (escapeAnalysis__apply_execution_boundary_escape_sink_mut(CAST(node AS Any@multiowned), &context));
  ELSE_IF (sink.handler == symbol("apply_lambda_escape_sink!")) THEN
    TRY (escapeAnalysis__apply_lambda_escape_sink_mut(castLocatableToLambdaLit(node), &context));
  ELSE_IF (sink.handler == symbol("apply_func_call_escape_sink!")) THEN
    TRY (escapeAnalysis__apply_func_call_escape_sink_mut(castLocatableToFuncCall__escape_analysis(node), context));
  ELSE_IF (sink.handler == symbol("apply_method_call_escape_sink!")) THEN
    TRY (escapeAnalysis__apply_method_call_escape_sink_mut(CAST(node AS MethodCall), context));
  ELSE
    panic("BUG: unknown escape sink {}");
  END
  NIL;
END
PUB FN escapeAnalysis__apply_return_escape_sink_mut(node: ReturnNode, context: EscapeContext) RETURNS !Void ->
  MUTABLE value: ?Locatable@boxed = COPY node.value;
  IF !(value) THEN
    RETURN;
  END
  IF !(TRY (escapeAnalysis__owning_return_needs_heap_placement?(COPY context.fn, &value, COPY context.schema_lookup))) THEN
    RETURN;
  END
  IF !(escapeAnalysis__returned_call_result?(value)) THEN
    TRY (escapeAnalysis__mark_expr_identifiers_heap_mut(value));
  END
  IF context.facts EXISTS AS facts_value THEN
    TRY (escapeAnalysis__mark_heap_return_mut(facts_value, value));
  END
END
PUB FN escapeAnalysis__apply_assignment_escape_sink_mut(node: Assignment, context: EscapeContext) RETURNS !Void ->
  MUTABLE facts: ?FunctionFacts = COPY context.facts;
  IF facts EXISTS AS facts_value THEN
    MUTABLE target: AssignmentTarget = COPY castAssignmentNameToAssignmentTarget(node.name);
    IF TRY (escapeAnalysis__assignment_target_heap_destination?(facts_value, target, COPY context.schema_lookup)) THEN
      TRY (escapeAnalysis__mark_expr_identifiers_heap_mut(node.value));
    END
  ELSE
    RETURN;
  END
END
PUB FN escapeAnalysis__apply_binding_escape_sink_mut(node: Node, context: EscapeContext) RETURNS !Void ->
  IF TRY (escapeAnalysis__borrow_return_expr?(aST__node_value(UNWRAP (castNodeToLocatable(node))))) THEN
    escapeAnalysis__mark_symbol_borrow_mut(node__symbol(node));
  ELSE_IF TRY (escapeAnalysis__call_result_is_heap?( UNWRAP (aST__node_value(UNWRAP (castNodeToLocatable(node)))), context.fn_nodes, COPY context.schema_lookup, context.facts_by_name)) THEN
    escapeAnalysis__mark_symbol_heap_mut(node__symbol(node));
  END
END
PUB FN escapeAnalysis__apply_destructuring_escape_sink_mut(node: DestructuringAssignment, context: EscapeContext) RETURNS !Void ->
  IF !(node.value) THEN
    RETURN;
  END
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < node.targets.length() DO
    IF (CAST((UNWRAP (node.targets[rtoc_idx])).name AS String) == "_") THEN
      rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    MUTABLE ti: ?Type = TRY (type__from_node_mut( Locatable{ DestructureTarget: COPY UNWRAP (node.targets[rtoc_idx]) }, "destructured target placement"));
    IF !(TRY (type__needs_explicit_cleanup?( UNWRAP (ti), :heap, COPY context.schema_lookup))) THEN
        rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    escapeAnalysis__mark_symbol_heap_mut((UNWRAP (node.targets[rtoc_idx])).symbol);
  rtoc_idx = rtoc_idx + 1;
  END
END
PUB FN escapeAnalysis__propagate_value_block_placements_mut(facts: FunctionFacts) RETURNS Void ->
  MUTABLE body: []Node = facts.fn.body |> SELECT castLocatableToNode(_);
  escapeAnalysis__walk_body(body, %(node: Locatable) -> {
  IF !((node IS_A VarDecl OR node IS_A BindExpr)) THEN
      RETURN;
  END
  IF aST__node__symbol(node) EXISTS AS rtoc_decl_symbol THEN
    IF symbolEntry__heap_storage?(rtoc_decl_symbol) THEN
      escapeAnalysis__mark_value_position_heap_mut(aST__node_value(node));
    END
  END
  rubyToClearVoid__escape_analysis()
  });
END
PUB FN escapeAnalysis__mark_value_position_heap_mut(expr: ?Locatable) RETURNS Void ->
  MUTABLE node: ?DynamicValue = castOptionalLocatableToOptionalDynamicValue(COPY expr);
  WHILE node != NIL DO
    node = escapeAnalysis__unwrap_value(node);
    MUTABLE rtoc_loc: ?Locatable = castOptionalDynamicValueToOptionalLocatable(node);
    IF (rtoc_loc == NIL) THEN
      RETURN;
    END
    MUTABLE rtoc_current: Locatable = COPY rtoc_loc;
    IF rtoc_current IS_A Cast AS rtoc_cast THEN
      node = castOptionalLocatableToOptionalDynamicValue(rtoc_cast.value);
    ELSE_IF rtoc_current IS_A BlockExpr AS rtoc_block THEN
      node = castOptionalLocatableToOptionalDynamicValue(rtoc_block.result);
    ELSE_IF rtoc_current IS_A Identifier THEN
      escapeAnalysis__mark_node_symbol_heap_mut(rtoc_current);
      RETURN;
    ELSE
      RETURN;
    END
  END
END
PUB FN escapeAnalysis__apply_execution_boundary_escape_sink_mut(node: Node, MUTABLE context: EscapeContext) RETURNS !Void ->
  escapeAnalysis__mark_capture_analysis_heap_mut(node__capture_analysis(node), &context.bg_heap);
  IF node IS_A BgBlock AS bg_block THEN
    TRY (escapeAnalysis__mark_fsm_ctx_locals_heap_mut(bg_block, COPY context.schema_lookup));
  END
END
PUB FN escapeAnalysis__apply_lambda_escape_sink_mut(node: LambdaLit, MUTABLE context: EscapeContext) RETURNS !Void ->
  TRY (escapeAnalysis__mark_lambda_captures_heap_mut(node, &context.bg_heap, context.facts));
END
PUB FN escapeAnalysis__apply_func_call_escape_sink_mut(node: FuncCall, context: EscapeContext) RETURNS !Void ->
  TRY (escapeAnalysis__mark_takes_args_heap_mut(node.args, TRY (escapeAnalysis__params_for_call(node, context.fn_nodes)), COPY context.schema_lookup));
END
PUB FN escapeAnalysis__apply_method_call_escape_sink_mut(node: MethodCall, context: EscapeContext) RETURNS !Void ->
  TRY (escapeAnalysis__mark_method_takes_heap_mut(node, TRY (escapeAnalysis__params_for_method_call(node)), context.fn_nodes, context.facts_by_name, COPY context.schema_lookup));
END
PUB FN escapeAnalysis__mark_param_receiver_allocations_heap_mut(nodes: []Locatable) RETURNS !Void ->
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < nodes.length() DO
    IF (nodes[rtoc_idx]? IS_A MethodCall) THEN
        MUTABLE sig_branch_value: ?FunctionSignature@multiowned = NIL;
        IF (locatable__matched_signature(nodes[rtoc_idx]?) != NIL) THEN
          sig_branch_value = functionSignature__unwrap(X{ FunctionSignature: COPY UNWRAP (locatable__matched_signature(nodes[rtoc_idx]?)) });
        ELSE
          sig_branch_value = NIL;
        END
        MUTABLE sig: ?FunctionSignature@multiowned = sig_branch_value;
        IF sig EXISTS AS sig_value THEN
          MUTABLE sig_value_mutable = COPY sig_value;
          IF !((TRY (functionSignature__emits_allocating?(sig_value_mutable)) AND TRY (functionSignature__mutates_receiver?(sig_value_mutable)))) THEN
            rtoc_idx = rtoc_idx + 1;
  CONTINUE;
          END
          MUTABLE root: ?Identifier = aST__root_identifier(nodes[rtoc_idx]?.object);
        ELSE
          rtoc_idx = rtoc_idx + 1;
  CONTINUE;
        END
    ELSE_IF nodes[rtoc_idx]? IS_A Assignment AS assignment THEN
        IF !(assignment.name IS_A GetIndex) THEN
          rtoc_idx = rtoc_idx + 1;
  CONTINUE;
        END
        MUTABLE root: ?Identifier = aST__root_identifier(castAssignmentNameToLocatable__escape_analysis(assignment.name));
        MUTABLE ti: ?Type@multiowned = NIL;
        IF root?.symbol != NIL THEN
          MUTABLE rtoc_root_symbol = UNWRAP (root).symbol;
          ti = COPY symbolEntry__type(rtoc_root_symbol);
        END
        IF !(((ti != NIL) AND type__collection?(ti))) THEN
          rtoc_idx = rtoc_idx + 1;
  CONTINUE;
        END
    ELSE
        rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    MUTABLE sym = COPY root?.symbol;
    IF !((IF sym != NIL THEN
        symbolEntry__is_param(sym)
      ELSE
        NIL
      END)) THEN
        rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    escapeAnalysis__mark_symbol_heap_mut(sym);
  rtoc_idx = rtoc_idx + 1;
  END
END
PUB FN escapeAnalysis__mark_recursive_aggregate_owners_heap_mut(facts: FunctionFacts, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Void ->
  MUTABLE fn = COPY facts.fn;
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < fn.params.length() DO
    IF !(TRY (escapeAnalysis__aggregate_owner_requires_heap?(TRY (type__new( TypeConstructionInput{ Type: COPY UNWRAP (fn.params[rtoc_idx]?.type) })), schema_lookup))) THEN
      rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    escapeAnalysis__mark_symbol_heap_mut(fn.params[rtoc_idx]?.symbol);
  rtoc_idx = rtoc_idx + 1;
  END
  FOR rtoc_key IN facts.binding_values.keys() DO
  MUTABLE values: []Locatable = COPY UNWRAP (facts.binding_values[rtoc_key]);
  MUTABLE sym: ?SymbolEntry@multiowned = COPY facts.symbols[rtoc_key];
  IF !(sym) THEN
      CONTINUE;
  END
  MUTABLE reg: ?SymbolEntryRegInput = COPY sym.reg;
  IF (reg == NIL) THEN
      CONTINUE;
  END
  MUTABLE node: SymbolEntryRegInput = COPY reg;
  MUTABLE rtoc_is_decl: Bool = FALSE;
  IF (node IS_A VarDecl OR node IS_A DestructureTarget) THEN
    rtoc_is_decl = TRUE;
  ELSE_IF node IS_A BindExpr AS bind_expr THEN
    rtoc_is_decl = (bind_expr.mode == :decl);
  END
  IF !(rtoc_is_decl) THEN
      CONTINUE;
  END
  MUTABLE ti = TRY (aST__full_type_mut(castSymbolEntryRegInputToLocatable(node)));
  IF !((TRY (escapeAnalysis__aggregate_owner_requires_heap?(TRY (type__new(TypeConstructionInput{ StringValue: COPY rtoc_key })), schema_lookup)) OR (values |> ANY escapeAnalysis__aggregate_contains_heap_owned_value?(_)))) THEN
      CONTINUE;
  END
  escapeAnalysis__mark_symbol_heap_mut(sym);
  END
END
PUB FN escapeAnalysis__aggregate_contains_heap_owned_value?(node: ?Locatable) RETURNS Bool ->
  IF node EXISTS AS node_value THEN
    IF !(((((node_value IS_A StructLit OR node_value IS_A UnionVariantLit) OR node_value IS_A ListLit) OR node_value IS_A HashLit) OR node_value IS_A TupleLit)) THEN
      RETURN FALSE;
    END
    MUTABLE pending: []Locatable = [node_value];
    WHILE !((pending.length() == 0)) DO
      MUTABLE current: ?Locatable = &pending.pop();
      IF current EXISTS AS current_value THEN
        IF (IF current_value IS_A Identifier AS identifier THEN ((identifier.symbol != NIL) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_11 = ((identifier.symbol)?);
        symbolEntry__heap_storage?(rtoc_local_receiver_11) }) ELSE FALSE END) THEN
          RETURN TRUE;
        END
        aST__each_child_node(current_value, %(child: Locatable) USE(MUTABLE pending) -> {
  &pending.append(COPY child);
  rubyToClearVoid__escape_analysis()
        });
      ELSE
        CONTINUE;
      END
    END
    RETURN FALSE;
  ELSE
    RETURN FALSE;
  END
END
PUB FN escapeAnalysis__aggregate_owner_requires_heap?(ti: ?Type, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Bool ->
  IF ti EXISTS AS ti_value THEN
    MUTABLE t = TRY (type__value_payload_type(ti_value));
    IF (type__rodata?(t) OR type__borrowed_reference?(t)) THEN
      RETURN FALSE;
    END
    IF TRY (type__collection_value?(t)) THEN
      RETURN TRY (type__needs_explicit_cleanup?(t, :frame, schema_lookup));
    END
    IF (TRY (type__string?(t)) OR TRY (type__heap_ptr?(t))) THEN
      RETURN FALSE;
    END
    RETURN TRY (type__ownership_bearing?(t, schema_lookup));
  ELSE
    RETURN FALSE;
  END
CATCH Transient, Input, System, NotFound, Permission, Canceled
  RETURN FALSE;
END
PUB FN escapeAnalysis__mark_loop_receiver_allocations_heap_mut(body: []Node) RETURNS !Void EFFECTS REENTRANT ->
  FOR rtoc_stmt IN body DO
    MUTABLE rtoc_stmt_loc: Locatable = castNodeToLocatable__escape_analysis(rtoc_stmt);
    MUTABLE rtoc_is_loop: Bool = aST__loop_node?(rtoc_stmt_loc);
    FOR rtoc_child_body IN aST__child_bodies(rtoc_stmt_loc) DO
      MUTABLE rtoc_child_nodes: []Node = rtoc_child_body |> SELECT castLocatableToNode(_);
      IF rtoc_is_loop THEN
        TRY (escapeAnalysis__mark_receiver_allocations_in_loop_mut(rtoc_child_nodes));
      END
      TRY (escapeAnalysis__mark_loop_receiver_allocations_heap_mut(rtoc_child_nodes));
    END
  END
END
PUB FN escapeAnalysis__mark_receiver_allocations_in_loop_mut(body: []Node) RETURNS !Void ->
  IF !(TRY (escapeAnalysis__loop_body_has_frame_allocation_candidate?(body))) THEN
    RETURN;
  END
  MUTABLE declared_names = TRY (escapeAnalysis__loop_body_declared_names(body));
  TRY (escapeAnalysis__each_loop_body_node(body, %(node: Locatable) USE(declared_names) -> {
  MUTABLE root: ?Identifier = NIL;
  MUTABLE value_params: []Param = [];
  MUTABLE eligible: Bool = FALSE;
  IF node IS_A MethodCall AS rtoc_method THEN
      IF rtoc_method.matched_signature EXISTS AS sig_value THEN
        MUTABLE sig_value_mutable = COPY sig_value;
        IF (TRY (functionSignature__emits_allocating?(sig_value_mutable)) AND TRY (functionSignature__mutates_receiver?(sig_value_mutable))) THEN
          root = aST__root_identifier(rtoc_method.object);
          value_params = (TRY (functionSignature__params(sig_value_mutable))) |> SKIP 1;
          eligible = TRUE;
        END
      END
  ELSE_IF node IS_A Assignment AS rtoc_assignment THEN
      MUTABLE rtoc_target: ?Locatable = castAssignmentNameToLocatable__escape_analysis(rtoc_assignment.name);
      IF rtoc_target EXISTS AS rtoc_target_value THEN
        IF rtoc_target_value IS_A GetIndex THEN
          root = aST__root_identifier(rtoc_target_value);
          IF root EXISTS AS rtoc_root_a THEN
            IF aST__node__symbol(Locatable{ Identifier: COPY rtoc_root_a }) EXISTS AS rtoc_root_sym THEN
              MUTABLE ti: ?Type@multiowned = COPY symbolEntry__type(rtoc_root_sym);
              IF ti EXISTS AS rtoc_ti THEN
                eligible = type__collection?(rtoc_ti);
              END
            END
          END
        END
      END
  END
  IF !(eligible) THEN
      RETURN;
  END
  IF root EXISTS AS rtoc_root THEN
    IF aST__node__symbol(Locatable{ Identifier: COPY rtoc_root }) EXISTS AS rtoc_root_symbol THEN
      IF !(declared_names.contains?(CAST(rtoc_root.name AS String))) THEN
        escapeAnalysis__mark_symbol_heap_mut(rtoc_root_symbol);
        IF node IS_A MethodCall AS node_narrowed THEN
          TRY (escapeAnalysis__mark_loop_method_value_params_heap_mut(node_narrowed, value_params));
        END
      END
    END
  END
  rubyToClearVoid__escape_analysis()
  }));
END
PUB FN escapeAnalysis__mark_loop_method_value_params_heap_mut(node: MethodCall, value_params: []Param) RETURNS !Void ->
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < value_params.length() DO
    IF !(((value_params[rtoc_idx]?.takes OR_ELSE FALSE) OR (value_params[rtoc_idx]?.mutable OR_ELSE FALSE))) THEN
      rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    MUTABLE arg: ?Locatable = COPY node.args[rtoc_idx];
    IF arg EXISTS AS arg_value THEN
        TRY (escapeAnalysis__mark_expr_identifiers_heap_mut(arg_value));
    END
  rtoc_idx = rtoc_idx + 1;
  END
END
PUB FN escapeAnalysis__walk_body(body: []Node, blk: FN(Locatable) -> Void) RETURNS Void ->
  aST__each_locatable_list(castNodeListToLocatableList(body), FALSE, blk);
END
PUB FN escapeAnalysis__mark_expr_roots_heap_mut(expr: ?Locatable) RETURNS Void ->
  MUTABLE unwrapped: ?DynamicValue = escapeAnalysis__unwrap_value( castOptionalLocatableToOptionalDynamicValue(expr));
  MUTABLE root_branch_value: ?Identifier = NIL;
  IF castOptionalDynamicValueToOptionalLocatable(unwrapped) EXISTS THEN
    root_branch_value = aST__root_identifier(UNWRAP (castDynamicValueToLocatable(UNWRAP (unwrapped))));
  ELSE
    root_branch_value = NIL;
  END
  MUTABLE root: ?Identifier = root_branch_value;
  IF root EXISTS AS root_value THEN
    escapeAnalysis__mark_node_symbol_heap_mut(Locatable{ Identifier: COPY root_value });
    RETURN;
  END
  IF castOptionalDynamicValueToOptionalLocatable(unwrapped) EXISTS AS rtoc_node THEN
    IF rtoc_node IS_A Identifier THEN
      escapeAnalysis__mark_node_symbol_heap_mut(rtoc_node);
    END
  END
END
PUB FN escapeAnalysis__mark_expr_identifiers_heap_mut(expr: ?Locatable) RETURNS !Bool ->
  MUTABLE changed: Bool = FALSE;
  MUTABLE stack: []?Locatable = [expr];
  WHILE !((stack.length() == 0)) DO
    MUTABLE node: ?Locatable = &stack.pop();
    IF (((node != NIL) AND (node IS_A CopyNode)) OR ((node != NIL) AND (node IS_A KeepNode))) THEN
      CONTINUE;
    END
    MUTABLE rtoc_dyn: ?DynamicValue = escapeAnalysis__unwrap_value( castOptionalLocatableToOptionalDynamicValue(node));
    IF (rtoc_dyn == NIL) THEN
      CONTINUE;
    END
    MUTABLE rtoc_loc: ?Locatable = castOptionalDynamicValueToOptionalLocatable(rtoc_dyn);
    IF (rtoc_loc == NIL) THEN
      CONTINUE;
    END
    MUTABLE unwrapped_node: Locatable = COPY rtoc_loc;
    IF unwrapped_node IS_A Identifier AS identifier THEN
      IF escapeAnalysis__mark_node_symbol_heap_mut(identifier) THEN
        changed = TRUE;
      END
      CONTINUE;
    END
    # Only a value-block's RESULT flows into the escape destination -- its body
    # statements (a rewritten pipeline's loop source) do not escape.
    IF unwrapped_node IS_A BlockExpr AS rtoc_block THEN
      IF rtoc_block.result EXISTS AS rtoc_block_result THEN
        &stack.append(COPY rtoc_block_result);
      END
      CONTINUE;
    END
    # A materializing pipeline builds a FRESH list, so its source identifiers
    # are not part of the escaping value.
    IF escapeAnalysis__materializing_pipeline_expr?(unwrapped_node) THEN
      CONTINUE;
    END
    MUTABLE root: ?Identifier = aST__root_identifier(unwrapped_node);
    IF root EXISTS AS root_value THEN
      IF escapeAnalysis__mark_node_symbol_heap_mut(root_value) THEN
        changed = TRUE;
      END
      CONTINUE;
    END
    TRY (escapeAnalysis__push_locatable_children_mut(unwrapped_node, &stack));
  END
  RETURN changed;
END
PUB FN escapeAnalysis__unwrap_value(node: ?DynamicValue) RETURNS ?DynamicValue ->
  MUTABLE current: ?DynamicValue = COPY node;
  WHILE current != NIL DO
    MUTABLE rtoc_loc: ?Locatable = castOptionalDynamicValueToOptionalLocatable(current);
    IF (rtoc_loc == NIL) THEN
      BREAK;
    END
    MUTABLE rtoc_current: Locatable = COPY rtoc_loc;
    IF aST__recovery_wrapper?(rtoc_current) THEN
      current = castLocatableToOptionalDynamicValue(aST__recovery_payload(rtoc_current));
    ELSE_IF aST__ownership_wrapper?(rtoc_current) THEN
      current = castOptionalLocatableToOptionalDynamicValue(aST__node_value(rtoc_current));
    ELSE
      BREAK;
    END
  END
  RETURN current;
END
PUB FN escapeAnalysis__push_locatable_children_mut(node: Locatable, MUTABLE stack: []?Locatable) RETURNS !Void ->
  FOR _ IN (aST__wrapped_children(node)) DO
  &stack.append(COPY _);
  END
  FOR rtoc_child IN locatable__child_nodes(node) DO
  &stack.append(COPY rtoc_child);
  END
END
PUB FN escapeAnalysis__mark_capture_analysis_heap_mut(analysis: ?CaptureAnalysis, MUTABLE bg_heap: [Set]String) RETURNS Void ->
  IF analysis EXISTS AS analysis_value THEN
    MUTABLE analysis_value_mutable = COPY analysis_value;
    FOR rtoc_key IN analysis_value_mutable.capture_symbols.keys() DO
  MUTABLE sym: SymbolEntry@multiowned = COPY UNWRAP (analysis_value_mutable.capture_symbols[rtoc_key]);
    escapeAnalysis__mark_symbol_heap_mut(sym, &bg_heap, rtoc_key);
    END
  ELSE
    RETURN;
  END
END
PUB FN escapeAnalysis__mark_fsm_ctx_locals_heap_mut(node: BgBlock, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Void ->
  IF !((node.spawn_form == :fsm)) THEN
    RETURN;
  END
  escapeAnalysis__walk_body(node.body |> SELECT castLocatableToNode(_), %(child: Locatable) USE(schema_lookup) -> {
  MUTABLE rtoc_is_decl: Bool = FALSE;
  IF child IS_A VarDecl THEN
    rtoc_is_decl = TRUE;
  ELSE_IF child IS_A BindExpr AS rtoc_bind THEN
    rtoc_is_decl = (rtoc_bind.mode == :decl);
  END
  IF !(rtoc_is_decl) THEN
      RETURN;
  END
  MUTABLE ti: ?Type = TRY (type__success_type((TRY (aST__full_type_mut(child)))));
  IF ti EXISTS AS rtoc_ti THEN
    IF (TRY (type__heap_ptr?(rtoc_ti)) OR TRY (type__recursive_cleanup_shape?(rtoc_ti, schema_lookup))) THEN
      escapeAnalysis__mark_symbol_heap_mut(aST__node__symbol(child));
    END
  END
  rubyToClearVoid__escape_analysis()
  });
END
PUB FN escapeAnalysis__mark_takes_args_heap_mut(args: []Locatable, params: []Param, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Void ->
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < params.length() DO
    MUTABLE arg: ?Locatable = COPY args[rtoc_idx];
    IF !(((params[rtoc_idx]?.takes OR_ELSE FALSE) OR escapeAnalysis__symbol_heap?(params[rtoc_idx]?.symbol))) THEN
        rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    MUTABLE arg_type: ?Type = IF (arg != NIL) THEN
        TRY (aST__full_type_mut(arg))
      ELSE
        NIL
      END;
    IF !((TRY (escapeAnalysis__ownership_bearing_transfer_expr?(&arg, schema_lookup)) OR TRY (escapeAnalysis__type_requires_owned_storage?(arg_type, schema_lookup)))) THEN
        rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    escapeAnalysis__mark_expr_roots_heap_mut(arg);
  rtoc_idx = rtoc_idx + 1;
  END
END
PUB FN escapeAnalysis__mark_method_takes_heap_mut(call: MethodCall, params: []Param, fn_nodes: {String}FunctionDef, facts_by_name: {String}FunctionFacts, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Void ->
  MUTABLE receiver_param: ?Param = COPY params.first();
  IF (escapeAnalysis__receiver_is_param?(call.object) AND escapeAnalysis__symbol_heap?(receiver_param?.symbol)) THEN
    escapeAnalysis__mark_expr_roots_heap_mut(call.object);
  END
  MUTABLE value_params = params |> SKIP 1;
  TRY (escapeAnalysis__mark_takes_args_heap_mut(call.args, value_params, schema_lookup));
  TRY (escapeAnalysis__mark_receiver_for_owned_sink_mut(call.object, call.args, value_params, fn_nodes, facts_by_name, schema_lookup));
  TRY (escapeAnalysis__mark_receiver_scope_escapes_mut(call.object, call.args, value_params));
END
PUB FN escapeAnalysis__mark_receiver_for_owned_sink_mut(receiver: Locatable, args: []Locatable, params: []Param, fn_nodes: {String}FunctionDef, facts_by_name: {String}FunctionFacts, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Void ->
  MUTABLE receiver_root: ?Identifier = aST__root_identifier(receiver);
  MUTABLE receiver_sym: ?SymbolEntry = NIL;
  IF receiver_root != NIL THEN
    receiver_sym = COPY receiver_root.symbol;
  END
  IF receiver_sym EXISTS AS receiver_sym_value THEN
    MUTABLE receiver_sym_value_mutable = COPY receiver_sym_value;
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < params.length() DO
    IF !(params[rtoc_idx]?.takes) THEN
      rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    MUTABLE arg: ?Locatable = COPY args[rtoc_idx];
    IF !(arg) THEN
          rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    IF !((TRY (escapeAnalysis__ownership_bearing_transfer_expr?(&arg, schema_lookup)) OR TRY (escapeAnalysis__call_result_is_heap?( arg, fn_nodes, schema_lookup, facts_by_name)))) THEN
          rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    escapeAnalysis__mark_symbol_heap_mut(receiver_sym_value_mutable);
    RETURN;
  rtoc_idx = rtoc_idx + 1;
    END
  ELSE
    RETURN;
  END
END
PUB FN escapeAnalysis__loop_body_has_frame_allocation_candidate?(body: []Node) RETURNS !Bool ->
  MUTABLE found: Bool = FALSE;
  TRY (localBindingAnalysis__each_direct_loop_node(castNodeListToLocatableList(body), %(MUTABLE node: Locatable) USE(MUTABLE found) -> {
  IF found THEN
      RETURN;
  END
  IF TRY (escapeAnalysis__loop_binding_frame_allocation_candidate?(&node)) THEN
      found = TRUE;
  END
  rubyToClearVoid__escape_analysis()
  }));
  RETURN found;
END
PUB FN escapeAnalysis__loop_binding_frame_allocation_candidate?(MUTABLE node: Locatable) RETURNS !Bool ->
  IF !((node IS_A VarDecl OR node IS_A BindExpr)) THEN
    RETURN FALSE;
  END
  IF ((aST__node__symbol(node) EXISTS) AND ((locatable__symbol(node) != NIL) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_13 = ((locatable__symbol(node))?);
  symbolEntry__heap_storage?(rtoc_local_receiver_13) })) THEN
    RETURN FALSE;
  END
  MUTABLE value: ?Locatable = aST__node_value(node);
  MUTABLE unwrapped: ?DynamicValue = escapeAnalysis__unwrap_value( castOptionalLocatableToOptionalDynamicValue(value));
  IF (castOptionalDynamicValueToOptionalLocatable(unwrapped) EXISTS AND escapeAnalysis__string_concat_expr?(UNWRAP (castDynamicValueToLocatable(UNWRAP (unwrapped))))) THEN
    RETURN TRUE;
  END
  MUTABLE entry: ?CleanupEntry@multiowned = localBindingAnalysis__binding_entry(node);
  IF (((entry != NIL) AND { MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_14 = entry;
  cleanupEntry__present?(rtoc_local_receiver_14) }) AND cleanupEntry__frame?(entry)) THEN
    RETURN TRUE;
  END
  MUTABLE ti = TRY (aST__full_type_mut(node));
  RETURN (type__needs_cleanup?(ti) AND (TRY (type__cleanup_allocator(ti)) == :frame));
CATCH Transient, Input, System, NotFound, Permission, Canceled
  RETURN FALSE;
END
PUB FN escapeAnalysis__loop_body_declared_names(body: []Node) RETURNS ![Set]String ->
  MUTABLE names: [Set]String = Set[];
  TRY (escapeAnalysis__each_loop_body_node(body, %(node) USE(MUTABLE names, MUTABLE ti, MUTABLE stack, MUTABLE value) -> {
  MUTABLE name: ?String = localBindingAnalysis__binding_decl_name(node);
  IF name EXISTS AS name_value THEN
    RETURN &names.insert(name_value);
  END
  NIL
  }));
  RETURN names;
END
# Ruby seeds the walk stack with `body.reverse`; CLEAR lists have no reverse,
# so the seed is built back to front by index.
PUB FN escapeAnalysisReversedLocatables(items: []Locatable) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  MUTABLE rtoc_idx: Int64 = (items.length() - 1);
  WHILE rtoc_idx >= 0 DO
    &out.append(COPY UNWRAP (items[rtoc_idx]));
    rtoc_idx = rtoc_idx - 1;
  END
  RETURN out;
END

PUB FN escapeAnalysis__each_loop_body_node(body: []Node, block: FN(Locatable) -> Void) RETURNS !Void ->
  MUTABLE stack: []Locatable = escapeAnalysisReversedLocatables(body |> SELECT castNodeToLocatable__escape_analysis(_));
  WHILE !((stack.length() == 0)) DO
    MUTABLE rtoc_popped: ?Locatable = &stack.pop();
    IF (rtoc_popped == NIL) THEN
      CONTINUE;
    END
    MUTABLE node: Locatable = COPY rtoc_popped;
    block(node);
    IF ((((node IS_A FunctionDef OR node IS_A LambdaLit) OR node IS_A BgBlock) OR node IS_A BgStreamBlock)) THEN
      CONTINUE;
    END
    MUTABLE rtoc_child_bodies = aST__child_bodies(node);
    MUTABLE rtoc_body_i: Int64 = (rtoc_child_bodies.length() - 1);
    WHILE rtoc_body_i >= 0 DO
      MUTABLE rtoc_child_body = COPY UNWRAP (rtoc_child_bodies[rtoc_body_i]);
      MUTABLE rtoc_child_i: Int64 = (rtoc_child_body.length() - 1);
      WHILE rtoc_child_i >= 0 DO
        &stack.append(COPY UNWRAP (rtoc_child_body[rtoc_child_i]));
        rtoc_child_i = rtoc_child_i - 1;
      END
      rtoc_body_i = rtoc_body_i - 1;
    END
  END
  NIL;
END
PUB FN escapeAnalysis__ownership_bearing_transfer_expr?(MUTABLE arg: ?Locatable, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Bool ->
  IF arg? IS_A MoveNode AS move_node THEN
    RETURN TRY (escapeAnalysis__type_requires_owned_storage?(TRY (aST__full_type_mut(move_node.value)), schema_lookup));
  END
  IF escapeAnalysis__heap_owned_transfer_source?(arg) THEN
    RETURN TRUE;
  END
  IF ((TRY (escapeAnalysis__ownership_transferring_expr?(arg, TRUE)) AND (arg != NIL)) AND TRY (escapeAnalysis__type_requires_owned_storage?(TRY (aST__full_type_mut(arg)), schema_lookup))) THEN
    RETURN TRUE;
  END
  RETURN FALSE;
CATCH Transient, Input, System, NotFound, Permission, Canceled
  RETURN FALSE;
END
PUB FN escapeAnalysis__heap_owned_transfer_source?(arg: ?Locatable) RETURNS Bool ->
  IF (((arg != NIL) AND (arg IS_A CopyNode)) OR ((arg != NIL) AND (arg IS_A KeepNode))) THEN
    RETURN FALSE;
  END
  MUTABLE unwrapped: ?DynamicValue = escapeAnalysis__unwrap_value( castOptionalLocatableToOptionalDynamicValue(arg));
  MUTABLE root_branch_value: ?Identifier = NIL;
  IF castOptionalDynamicValueToOptionalLocatable(unwrapped) EXISTS THEN
    root_branch_value = aST__root_identifier(UNWRAP (castDynamicValueToLocatable(UNWRAP (unwrapped))));
  ELSE
    root_branch_value = NIL;
  END
  MUTABLE root: ?Identifier = root_branch_value;
  MUTABLE sym: ?SymbolEntry = NIL;
  IF root != NIL THEN
    sym = COPY root.symbol;
  END
  RETURN escapeAnalysis__symbol_heap?(sym);
CATCH Transient, Input, System, NotFound, Permission, Canceled
  RETURN FALSE;
END
PUB FN escapeAnalysis__mark_receiver_scope_escapes_mut(receiver: Locatable, args: []Locatable, params: []Param) RETURNS !Void ->
  MUTABLE receiver_root: ?Identifier = aST__root_identifier(receiver);
  MUTABLE receiver_depth: ?Int64 = receiver_root?.symbol?.scope_depth;
  IF !((receiver_depth != NIL)) THEN
    RETURN;
  END
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < params.length() DO
    IF !(((params[rtoc_idx]?.takes OR_ELSE FALSE) OR (params[rtoc_idx]?.mutable OR_ELSE FALSE))) THEN
      rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    MUTABLE arg: ?Locatable = COPY args[rtoc_idx];
    IF !(arg) THEN
        rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    MUTABLE arg_root: ?Identifier = aST__root_identifier(arg);
    MUTABLE arg_depth: ?Int64 = arg_root?.symbol?.scope_depth;
    IF !(((arg_depth != NIL) AND (arg_depth > receiver_depth))) THEN
        rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    TRY (escapeAnalysis__mark_expr_identifiers_heap_mut(arg));
  rtoc_idx = rtoc_idx + 1;
  END
END
PUB FN escapeAnalysis__propagate_hoist_dependencies_mut(facts: FunctionFacts) RETURNS !Void ->
  MUTABLE changed: Bool = TRUE;
  WHILE changed DO
    changed = FALSE;
    FOR rtoc_key IN facts.binding_values.keys() DO
  MUTABLE values: []Locatable = COPY UNWRAP (facts.binding_values[rtoc_key]);
  MUTABLE sym: ?SymbolEntry@multiowned = COPY facts.symbols[rtoc_key];
  IF !(escapeAnalysis__symbol_heap?(sym)) THEN
        CONTINUE;
  END
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < values.length() DO
      IF !(escapeAnalysis__heap_binding_carries_sources?(values[rtoc_idx]?)) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF TRY (escapeAnalysis__mark_expr_identifiers_heap_mut(values[rtoc_idx]?)) THEN
            changed = TRUE;
      END
    rtoc_idx = rtoc_idx + 1;
  END
    END
  END
END
PUB FN escapeAnalysis__heap_binding_carries_sources?(value: Locatable) RETURNS Bool ->
  MUTABLE node = COPY value;
  IF (node IS_A CopyNode OR node IS_A KeepNode) THEN
    RETURN FALSE;
  END
  node = UNWRAP (castDynamicValueToLocatable(UNWRAP (escapeAnalysis__unwrap_value(UNWRAP (castLocatableToDynamicValue(node))))));
  IF node IS_A Identifier AS identifier THEN
    RETURN TRUE;
  END
  IF ((((node IS_A StructLit OR node IS_A UnionVariantLit) OR node IS_A ListLit) OR node IS_A HashLit) OR node IS_A TupleLit) THEN
    RETURN TRUE;
  END
  RETURN FALSE;
END
PUB FN escapeAnalysis__propagate_assignment_ownership_mut(facts: FunctionFacts, fn_nodes: {String}FunctionDef, facts_by_name: {String}FunctionFacts, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Void ->
  MUTABLE changed: Bool = TRUE;
  WHILE changed DO
    changed = FALSE;
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < facts.assignment_nodes.length() DO
    MUTABLE target: ?String = escapeAnalysis__assigned_binding_name(facts.assignment_nodes[rtoc_idx]?);
    IF !(target) THEN
          rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    MUTABLE sym: ?SymbolEntry@multiowned = COPY facts.symbols[target];
    IF !(sym) THEN
          rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    IF !(TRY (escapeAnalysis__assignment_value_is_owned?(facts.assignment_nodes[rtoc_idx]?, fn_nodes, facts_by_name, schema_lookup))) THEN
          rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    IF escapeAnalysis__mark_reassigned_symbol_heap_mut(sym) THEN
          changed = TRUE;
    END
  rtoc_idx = rtoc_idx + 1;
    END
  END
END
PUB FN escapeAnalysis__assigned_binding_name(node: AssignmentNode) RETURNS ?String ->
  IF (IF node IS_A BindExpr AS bind_expr THEN (bind_expr.mode == :assign) ELSE FALSE END) THEN
    RETURN COPY CAST(aST__node_name(castAssignmentNodeToLocatable(node)) AS String);
  END
  IF node IS_A DestructuringAssignment AS destructuring_assignment THEN
    RETURN NIL;
  END
  IF node IS_A Assignment AS assignment THEN
    MUTABLE target: ?DynamicValue = escapeAnalysis__unwrap_value(UNWRAP (castAssignmentNameToDynamicValue(assignment.name)));
    IF castOptionalDynamicValueToOptionalString(target) EXISTS AS rtoc_target_name THEN
      RETURN COPY rtoc_target_name;
    END
    IF castOptionalDynamicValueToOptionalLocatable(target) EXISTS AS rtoc_target_loc THEN
      IF rtoc_target_loc IS_A Identifier THEN
        RETURN COPY locatable__name(rtoc_target_loc);
      END
    END
    RETURN NIL;
  ELSE
    RETURN NIL;
  END
END
PUB FN escapeAnalysis__assignment_value_is_owned?(node: AssignmentNode, fn_nodes: {String}FunctionDef, facts_by_name: {String}FunctionFacts, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Bool ->
  IF !((aST__node_value( castAssignmentNodeToLocatable(node)) EXISTS)) THEN
    RETURN FALSE;
  END
  MUTABLE value: ?Locatable = aST__node_value(castAssignmentNodeToLocatable(node));
  IF TRY (escapeAnalysis__ownership_transferring_expr?(value, FALSE)) THEN
    RETURN TRUE;
  END
  MUTABLE unwrapped: ?DynamicValue = escapeAnalysis__unwrap_value( castOptionalLocatableToOptionalDynamicValue(value));
  IF (castOptionalDynamicValueToOptionalLocatable(unwrapped) EXISTS AND escapeAnalysis__string_concat_expr?(UNWRAP (castDynamicValueToLocatable(UNWRAP (unwrapped))))) THEN
    RETURN FALSE;
  END
  IF TRY (escapeAnalysis__expr_has_owned_inline_value?(value)) THEN
    RETURN TRUE;
  END
  RETURN TRY (escapeAnalysis__call_result_is_heap?(UNWRAP (value), fn_nodes, schema_lookup, facts_by_name));
END
PUB FN escapeAnalysis__ownership_transferring_expr?(expr: ?Locatable, include_allocating_expr: Bool) RETURNS !Bool ->
  MUTABLE rtoc_expr_loc: ?Locatable = escapeAnalysis__unwrap_orelse_left(UNWRAP (expr));
  MUTABLE value: ?DynamicValue = castOptionalLocatableToOptionalDynamicValue(rtoc_expr_loc);
  IF ((IF rtoc_expr_loc EXISTS AS rtoc_ck THEN (rtoc_ck IS_A CopyNode OR rtoc_ck IS_A KeepNode) ELSE FALSE END)) THEN
    RETURN TRUE;
  END
  IF (rtoc_expr_loc == NIL) THEN
    RETURN FALSE;
  END
  MUTABLE rtoc_value: Locatable = COPY rtoc_expr_loc;
  IF escapeAnalysis__expr_has_heap_identifier?(rtoc_value) THEN
    RETURN TRUE;
  END
  IF (include_allocating_expr AND escapeAnalysis__string_concat_expr?(rtoc_value)) THEN
    RETURN TRUE;
  END
  IF aST__node_heap_storage?(rtoc_value) THEN
    RETURN TRUE;
  END
  IF aST__node__symbol(rtoc_value) EXISTS AS rtoc_value_symbol THEN
    IF symbolEntry__heap_storage?(rtoc_value_symbol) THEN
      RETURN TRUE;
    END
  END
  MUTABLE ti = TRY (aST__full_type_mut(rtoc_value));
  RETURN !(!(((((!(TRY (type__string?(ti))) AND !(type__rodata?(ti))) AND (type__provenance(ti) != :borrow)) AND TRY (type__heap_ptr?(ti))))));
CATCH Transient, Input, System, NotFound, Permission, Canceled
  RETURN FALSE;
END
PUB FN escapeAnalysis__string_concat_expr?(expr: ?Locatable) RETURNS Bool ->
  IF expr EXISTS AS rtoc_expr THEN
    IF rtoc_expr IS_A StringConcat THEN
      RETURN TRUE;
    END
    IF rtoc_expr IS_A BinaryOp AS binary_op THEN
      RETURN (binary_op.string_concat == TRUE);
    END
  END
  RETURN FALSE;
END
PUB FN escapeAnalysis__type_requires_owned_storage?(ti: ?Type, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Bool ->
  IF ti EXISTS AS ti_value THEN
    MUTABLE t = TRY (type__value_payload_type(ti_value));
    IF (type__rodata?(t) OR type__borrowed_reference?(t)) THEN
      RETURN FALSE;
    END
    RETURN TRY (type__ownership_bearing?(t, schema_lookup));
  ELSE
    RETURN FALSE;
  END
CATCH Transient, Input, System, NotFound, Permission, Canceled
  RETURN FALSE;
END
PUB FN escapeAnalysis__borrow_return_expr?(expr: ?Locatable) RETURNS !Bool ->
  MUTABLE rtoc_call_loc: ?Locatable = castOptionalDynamicValueToOptionalLocatable(escapeAnalysis__unwrap_value( castOptionalLocatableToOptionalDynamicValue(expr)));
  IF (rtoc_call_loc == NIL) THEN
    RETURN FALSE;
  END
  MUTABLE rtoc_call: Locatable = COPY rtoc_call_loc;
  MUTABLE call: ?DynamicValue = castLocatableToDynamicValue(rtoc_call);
  IF !((rtoc_call IS_A FuncCall OR rtoc_call IS_A MethodCall)) THEN
    RETURN FALSE;
  END
  MUTABLE sig_branch_value: ?FunctionSignature@multiowned = locatable__matched_signature(rtoc_call);
  MUTABLE sig: ?FunctionSignature@multiowned = sig_branch_value;
  RETURN (!(!(sig)) AND !(((TRY (functionSignature__return_lifetime(sig))).length() == 0)));
END
PUB FN escapeAnalysis__expr_has_heap_identifier?(expr: ?Locatable) RETURNS Bool ->
  MUTABLE found: Bool = FALSE;
  aST__each_locatable(UNWRAP (expr), FALSE, %(raw: Locatable) -> {
  MUTABLE node: ?DynamicValue = escapeAnalysis__unwrap_value(UNWRAP (castLocatableToDynamicValue(raw)));
  IF castOptionalDynamicValueToOptionalLocatable(node) EXISTS AS rtoc_node_loc THEN
    IF rtoc_node_loc IS_A Identifier AS rtoc_ident THEN
      IF escapeAnalysis__symbol_heap?(rtoc_ident.symbol) THEN
        found = TRUE;
      END
    END
  END
  rubyToClearVoid__escape_analysis()
  });
  RETURN found;
END
PUB FN escapeAnalysis__expr_has_owned_inline_value?(expr: ?Locatable) RETURNS !Bool ->
  MUTABLE root: ?DynamicValue = escapeAnalysis__unwrap_value( castOptionalLocatableToOptionalDynamicValue(expr));
  # Ruby returns straight out of the block; a CLEAR lambda cannot, so the
  # answer rides a captured flag instead.
  MUTABLE found: Bool = FALSE;
  aST__each_locatable(UNWRAP (expr), FALSE, %(raw: Locatable) USE(root, MUTABLE found) -> {
  MUTABLE node: ?DynamicValue = escapeAnalysis__unwrap_value(UNWRAP (castLocatableToDynamicValue(raw)));
  IF castOptionalDynamicValueToOptionalLocatable(node) EXISTS AS rtoc_node THEN
    MUTABLE rtoc_root_loc: ?Locatable = castOptionalDynamicValueToOptionalLocatable(root);
    MUTABLE is_root: Bool = FALSE;
    IF rtoc_root_loc EXISTS AS rtoc_root THEN
      is_root = (aST__node_identity(rtoc_node) == aST__node_identity(rtoc_root));
    END
    IF !((is_root OR rtoc_node IS_A Identifier)) THEN
      IF rtoc_node IS_A Literal AS rtoc_literal THEN
        IF rtoc_literal.value EXISTS AS rtoc_literal_value THEN
          IF rtoc_literal_value IS_A String THEN
            found = TRUE;
          END
        END
      END
      MUTABLE ti = TRY (aST__full_type_mut(rtoc_node));
      IF ((!(type__rodata?(ti)) AND (type__provenance(ti) != :borrow)) AND TRY (type__heap_ptr?(ti))) THEN
        found = TRUE;
      END
    END
  END
  rubyToClearVoid__escape_analysis()
  });
  RETURN found;
CATCH Transient, Input, System, NotFound, Permission, Canceled
  RETURN FALSE;
END
PUB FN escapeAnalysis__symbol_for_name(facts: FunctionFacts, name: String) RETURNS ?SymbolEntry@multiowned ->
  RETURN COPY facts.symbols[name];
END
PUB FN escapeAnalysis__function_facts(fn_value: FunctionDef, summary: ?FunctionBodySummary = NIL, hoist_bindings: []VarDecl = []) RETURNS !FunctionFacts ->
  MUTABLE symbols: {String}SymbolEntry@multiowned = {};
  MUTABLE binding_values: {String}[]Locatable = {};
  MUTABLE return_values: []Locatable = ( { MUTABLE rtoc_empty_list_20: []Locatable = List[]; rtoc_empty_list_20 } );
  MUTABLE assignment_nodes: []AssignmentNode = ( { MUTABLE rtoc_empty_list_21: []AssignmentNode = List[]; rtoc_empty_list_21 } );
  MUTABLE escape_nodes: []Locatable = ( { MUTABLE rtoc_empty_list_22: []Locatable = List[]; rtoc_empty_list_22 } );
  FOR _ IN fn_value.params DO
  MUTABLE sym: ?SymbolEntry = COPY _.symbol;
  IF sym EXISTS AS sym_value THEN
      symbols[_.name] = sym_value;
  END
  END
  IF summary EXISTS AS summary_value THEN
    MUTABLE summary_value_mutable = COPY summary_value;
    FOR _ IN summary_value_mutable.binding_nodes DO
    escapeAnalysis__record_binding_fact_mut(_, &symbols, &binding_values);
    END
    FOR _ IN summary_value_mutable.assignment_nodes DO
  IF _ IS_A BindExpr AS bind_expr THEN
        MUTABLE bind_expr_mutable = COPY bind_expr;
        escapeAnalysis__record_symbol_fact_mut( BindingNode{ BindExpr: COPY bind_expr_mutable }, &symbols);
  END
  &assignment_nodes.append(COPY _);
    END
    FOR _ IN hoist_bindings DO
    escapeAnalysis__record_binding_fact_mut( BindingNode{ VarDecl: COPY _ }, &symbols, binding_values);
    END
    FOR _ IN summary_value_mutable.return_nodes DO
    IF _.value THEN
      &return_values.append(_.value);
    END
    END
    escape_nodes = ruby_array_concat_Locatable(escape_nodes, summary_value_mutable.escape_nodes);
    escape_nodes = ruby_array_concat_Locatable(escape_nodes, CAST(hoist_bindings AS []Locatable));
    RETURN FunctionFacts{ fn: COPY fn_value, symbols: symbols, binding_values: COPY binding_values, return_values: COPY return_values, assignment_nodes: COPY assignment_nodes, escape_nodes: COPY escape_nodes, lambda_body_identifier_refs: COPY summary_value_mutable.lambda_body_identifier_refs };
  END
  escapeAnalysis__walk_body(fn_value.body, %(node) USE(MUTABLE assignment_nodes, binding_values, MUTABLE escape_nodes, MUTABLE return_values, symbols) -> {
  IF node IS_A Locatable THEN
      &escape_nodes.append(node);
  END
  IF (node IS_A ReturnNode AND node.value()) THEN
      &return_values.append(node.value());
  END
  IF (node IS_A Assignment OR node IS_A DestructuringAssignment) THEN
      &assignment_nodes.append(COPY node);
  END
  IF (node IS_A VarDecl) THEN
      escapeAnalysis__record_binding_fact_mut(node, &symbols, binding_values);
  ELSE_IF (node IS_A BindExpr) THEN
      IF (node.mode == :assign) THEN
        &assignment_nodes.append(COPY node);
      ELSE
        escapeAnalysis__record_binding_fact_mut(node, &symbols, binding_values);
      END
  ELSE_IF (node IS_A DestructuringAssignment) THEN
      MUTABLE rtoc_each_items_23 = node.targets;
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < rtoc_each_items_23.length() DO
      IF (UNWRAP (rtoc_each_items_23[rtoc_idx]).name() == "_") THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      IF (IF UNWRAP (rtoc_each_items_23[rtoc_idx]).symbol != NIL THEN
            (UNWRAP (rtoc_each_items_23[rtoc_idx]).symbol).reg
          ELSE
            NIL
          END).equal?(UNWRAP (rtoc_each_items_23[rtoc_idx])) THEN
            escapeAnalysis__record_binding_fact_mut(UNWRAP (rtoc_each_items_23[rtoc_idx]), &symbols, binding_values);
      END
    rtoc_idx = rtoc_idx + 1;
      END
  END
  NIL
  });
  RETURN FunctionFacts{ fn: fn_value, symbols: symbols, binding_values: COPY binding_values, return_values: COPY return_values, assignment_nodes: COPY assignment_nodes, escape_nodes: COPY escape_nodes, lambda_body_identifier_refs: COPY TRY (escapeAnalysis__collect_lambda_identifier_refs(fn_value.body)) };
END
PUB FN escapeAnalysis__bindingNodeName(node: BindingNode) RETURNS String ->
  PARTIAL MATCH node START
    BindingNode.VarDecl AS item -> RETURN COPY CAST(item.name AS String);,
    BindingNode.BindExpr AS item -> RETURN COPY CAST(item.name AS String);,
    BindingNode.DestructureTarget AS item -> RETURN COPY CAST(item.name AS String);,
    DEFAULT -> RETURN COPY "";
  END
  RETURN COPY "";
END
PUB FN escapeAnalysis__record_symbol_fact_mut(node: BindingNode, MUTABLE symbols: {String}SymbolEntry) RETURNS Void ->
  MUTABLE sym: ?SymbolEntry@multiowned = escapeAnalysis__symbol_for_binding_node(node);
  IF sym EXISTS AS rtoc_sym THEN
    symbols[escapeAnalysis__bindingNodeName(node)] = COPY rtoc_sym;
  END
END
PUB FN escapeAnalysis__record_binding_fact_mut(node: BindingNode, MUTABLE symbols: {String}SymbolEntry, MUTABLE binding_values: {String}[]Locatable) RETURNS Void ->
  escapeAnalysis__record_symbol_fact_mut(node, &symbols);
  MUTABLE value: ?Locatable = NIL;
  IF (node IS_A VarDecl OR node IS_A BindExpr) THEN
    value = aST__node_value(castBindingNodeToLocatable(node));
  END
  IF !((value != NIL)) THEN
    RETURN;
  END
  MUTABLE binding_key: String = escapeAnalysis__bindingNodeName(node);
  MUTABLE binding_entry = COPY (binding_values[binding_key] OR_ELSE List[]);
  &binding_entry.append(value);
  binding_values[binding_key] = COPY binding_entry;
END
PUB FN escapeAnalysis__receiver_is_param?(receiver: Locatable) RETURNS Bool ->
  MUTABLE root: ?Identifier = aST__root_identifier(receiver);
  MUTABLE sym: ?SymbolEntry = NIL;
  IF root != NIL THEN
    sym = COPY root.symbol;
  END
  RETURN !(!(((((sym != NIL) AND TRUE) AND symbolEntry__is_param(sym)))));
END
PUB FN escapeAnalysis__mark_lambda_captures_heap_mut(node: LambdaLit, MUTABLE bg_heap: [Set]String, facts: ?FunctionFacts) RETURNS !Void ->
  MUTABLE names: [Set]String = Set[];
  FOR _ IN node.captures DO
  &names.insert(COPY CAST(capture__name(_) AS String));
  END
  IF names.empty?() THEN
    RETURN;
  END
  MUTABLE identifiers: ?[]Identifier = NIL;
  IF facts EXISTS AS rtoc_facts THEN
    identifiers = COPY rtoc_facts.lambda_body_identifier_refs[aST__node_identity(Locatable{ LambdaLit: COPY node })];
  END
  IF (identifiers == NIL) THEN
    identifiers = TRY (escapeAnalysis__collect_lambda_body_identifiers(node));
  END
  MUTABLE rtoc_identifiers: []Identifier = COPY (identifiers OR_ELSE List[]);
  FOR rtoc_ident IN rtoc_identifiers DO
    MUTABLE rtoc_ident_name: String = COPY CAST(rtoc_ident.name AS String);
    IF names.contains?(rtoc_ident_name) THEN
      escapeAnalysis__mark_symbol_heap_mut(rtoc_ident.symbol, &bg_heap, rtoc_ident_name);
    END
  END
END
PUB FN escapeAnalysis__collect_lambda_identifier_refs(body: []Node) RETURNS !{Int64}[]Identifier ->
  MUTABLE refs: {Int64}[]Identifier = {};
  aST__each_locatable_list(body |> SELECT castNodeToLocatable__escape_analysis(_), FALSE, %(node: Locatable) USE(MUTABLE refs) -> {
  IF !(node IS_A LambdaLit) THEN
      RETURN;
  END
  refs[aST__node_identity(node)] = TRY (escapeAnalysis__collect_lambda_body_identifiers( castLocatableToLambdaLit(node)));
  rubyToClearVoid__escape_analysis()
  });
  RETURN refs;
END
PUB FN escapeAnalysis__collect_lambda_body_identifiers(node: LambdaLit) RETURNS ![]Identifier ->
  MUTABLE out: []Identifier = ( { MUTABLE rtoc_empty_list_24: []Identifier = List[]; rtoc_empty_list_24 } );
  MUTABLE stack: []Locatable = escapeAnalysisReversedLocatables(TRY (aST__lambda_body_nodes(node.body)));
  WHILE !((stack.length() == 0)) DO
    MUTABLE rtoc_popped: ?Locatable = &stack.pop();
    MUTABLE rtoc_unwrapped: ?DynamicValue = escapeAnalysis__unwrap_value(castOptionalLocatableToOptionalDynamicValue(rtoc_popped));
    MUTABLE rtoc_current_loc: ?Locatable = castOptionalDynamicValueToOptionalLocatable(rtoc_unwrapped);
    IF (rtoc_current_loc == NIL) THEN
      CONTINUE;
    END
    MUTABLE current: Locatable = COPY rtoc_current_loc;
    IF current IS_A Identifier AS rtoc_current_ident THEN
      &out.append(COPY rtoc_current_ident);
      CONTINUE;
    END
    IF (current IS_A FunctionDef OR current IS_A LambdaLit) THEN
      CONTINUE;
    END
    MUTABLE rtoc_reverse_items_25: []Locatable = (aST__expression_children(current));
    MUTABLE rtoc_reverse_i_26 = rtoc_reverse_items_25.length() - 1;
    WHILE rtoc_reverse_i_26 >= 0 DO
  &stack.append(COPY UNWRAP (rtoc_reverse_items_25[rtoc_reverse_i_26]));
  rtoc_reverse_i_26 = rtoc_reverse_i_26 - 1;
    END
    MUTABLE rtoc_reverse_items_27 = aST__child_bodies(current);
    MUTABLE rtoc_reverse_i_28 = rtoc_reverse_items_27.length() - 1;
    WHILE rtoc_reverse_i_28 >= 0 DO
  MUTABLE rtoc_reverse_items_29: []Locatable = COPY UNWRAP (rtoc_reverse_items_27[rtoc_reverse_i_28]);
  MUTABLE rtoc_reverse_i_30 = rtoc_reverse_items_29.length() - 1;
  WHILE rtoc_reverse_i_30 >= 0 DO
    &stack.append(COPY UNWRAP (rtoc_reverse_items_29[rtoc_reverse_i_30]));
    rtoc_reverse_i_30 = rtoc_reverse_i_30 - 1;
  END
  rtoc_reverse_i_28 = rtoc_reverse_i_28 - 1;
    END
  END
  RETURN out;
END
PUB FN escapeAnalysis__params_for_call(call: FuncCall, fn_nodes: {String}FunctionDef) RETURNS ![]Param ->
  MUTABLE fn: ?FunctionDef = COPY fn_nodes[CAST(call.name AS String)];
  IF fn EXISTS AS fn_value THEN
    RETURN COPY fn_value.params;
  END
  MUTABLE sig_branch_value: ?FunctionSignature@multiowned = NIL;
  IF TRUE THEN
    sig_branch_value = functionSignature__unwrap(ruby_wrap_optional_FunctionSignature_multiowned_X__escape_analysis(KEEP call.matched_signature));
  ELSE
    sig_branch_value = NIL;
  END
  MUTABLE sig: ?FunctionSignature@multiowned = sig_branch_value;
  IF sig EXISTS AS sig_value THEN
    RETURN TRY (functionSignature__params(sig_value));
  ELSE
    RETURN CAST(( { MUTABLE rtoc_empty_list_31: []Param = List[]; rtoc_empty_list_31 } ) AS []Param);
  END
END
PUB FN escapeAnalysis__params_for_method_call(call: MethodCall) RETURNS ![]Param ->
  MUTABLE sig_branch_value: ?FunctionSignature@multiowned = NIL;
  IF TRUE THEN
    sig_branch_value = functionSignature__unwrap(ruby_wrap_optional_FunctionSignature_multiowned_X__escape_analysis(KEEP call.matched_signature));
  ELSE
    sig_branch_value = NIL;
  END
  MUTABLE sig: ?FunctionSignature@multiowned = sig_branch_value;
  IF sig EXISTS AS sig_value THEN
    RETURN TRY (functionSignature__params(sig_value));
  ELSE
    RETURN CAST(( { MUTABLE rtoc_empty_list_32: []Param = List[]; rtoc_empty_list_32 } ) AS []Param);
  END
END
PUB FN escapeAnalysis__borrowed_return?(fn_value: FunctionDef, expr: Locatable) RETURNS !Bool ->
  IF !(fn_value.return_lifetime) THEN
    RETURN FALSE;
  END
  MUTABLE returned: [Set]String = Set[];
  TRY (escapeAnalysis__collect_identifier_names_mut(expr, &returned));
  IF ((IF fn_value.return_lifetime IS_A String@symbol AS fn_valuereturn_lifetime_payload THEN ((type__resolved(fn_valuereturn_lifetime_payload) == :wildcard)) ELSE FALSE END)) THEN
    MUTABLE param_names: [Set]String = Set[];
    FOR _ IN fn_value.params DO
    &param_names.insert(COPY _.name);
    END
    RETURN !((ruby_set_intersection_String_set__escape_analysis(returned, param_names)).empty?());
  END
  MUTABLE borrowed: [Set]String = Set[];
  IF fn_value.return_lifetime EXISTS AS rtoc_return_lifetime THEN
    IF rtoc_return_lifetime IS_A ArrayValue AS rtoc_lifetime_nodes THEN
      FOR rtoc_lifetime_node IN rtoc_lifetime_nodes DO
        IF aST__node_name(rtoc_lifetime_node) EXISTS AS rtoc_lifetime_name THEN
          &borrowed.insert(COPY CAST(rtoc_lifetime_name AS String));
        END
      END
    END
  END
  RETURN !((ruby_set_intersection_String_set__escape_analysis(returned, borrowed)).empty?());
END
PUB FN escapeAnalysis__owning_return_needs_heap_placement?(fn_value: FunctionDef, MUTABLE expr: Locatable, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Bool ->
  IF TRY (escapeAnalysis__borrowed_return?(fn_value, expr)) THEN
    RETURN FALSE;
  END
  MUTABLE ti: ?Type = TRY (escapeAnalysis__owning_return_type(fn_value, &expr));
  IF !(ti) THEN
    RETURN FALSE;
  END
  MUTABLE top_heap_ptr = TRY (type__heap_ptr?( ti));
  ti = TRY (type__value_payload_type( ti));
  IF !(ti) THEN
    RETURN FALSE;
  END
  IF ( (type__primitive?(ti) OR type__void?(ti)) OR type__any?( ti)) THEN
    RETURN FALSE;
  END
  IF (IF expr IS_A Identifier AS identifier THEN escapeAnalysis__symbol_heap?(identifier.symbol) ELSE FALSE END) THEN
    IF ((TRY (type__string?(ti)) OR TRY (type__heap_ptr?(ti))) OR TRY (type__recursive_cleanup_shape?(ti, schema_lookup))) THEN
      RETURN TRUE;
    END
  END
  MUTABLE expr_t = TRY (aST__full_type_mut(expr));
  IF (!(expr IS_A Identifier) AND type__rodata?(expr_t)) THEN
    RETURN FALSE;
  END
  IF (type__rodata?(ti) OR type__borrowed_reference?(ti)) THEN
    RETURN FALSE;
  END
  RETURN (((top_heap_ptr OR (type__ownership(ti) != :affine)) OR TRY (type__ownership_bearing?(ti, schema_lookup))) OR TRY (type__needs_explicit_cleanup?(ti, :heap, schema_lookup)));
END
PUB FN escapeAnalysis__owning_return_type(fn_value: FunctionDef, MUTABLE expr: Locatable) RETURNS !?Type ->
  MUTABLE declared: ?Type = functionDef__declared_return_type(fn_value);
  IF declared EXISTS AS rtoc_declared THEN
    RETURN COPY rtoc_declared;
  END
  RETURN TRY (aST__full_type_mut(expr));
END
PUB FN escapeAnalysis__mark_heap_return_mut(facts: FunctionFacts, expr: Locatable) RETURNS !Void ->
  MUTABLE fn = COPY facts.fn;
  IF escapeAnalysis__function_def_has_return_lifetime?(fn) THEN
    RETURN;
  END
  MUTABLE ret: ?Type = functionDef__declared_return_type(fn);
  IF ret THEN
    ret = TRY (type__value_payload_type(ret));
  END
  IF ret THEN
    type__mark_heap_allocated_mut(&ret);
  END
  fn.heap_carry_return = TRUE;
  MUTABLE names: [Set]String = Set[];
  IF !((escapeAnalysis__returned_call_result?(expr) OR escapeAnalysis__materializing_pipeline_expr?(expr))) THEN
    TRY (escapeAnalysis__collect_identifier_names_mut(expr, &names));
  END
  # A parameter's storage is the caller's decision, so a returned view of a
  # param needs no promotion here.
  MUTABLE rtoc_kept: [Set]String = Set[];
  FOR rtoc_name IN names DO
    MUTABLE rtoc_is_param: Bool = FALSE;
    IF facts.symbols[rtoc_name] EXISTS AS rtoc_named_symbol THEN
      IF rtoc_named_symbol.reg EXISTS AS rtoc_named_reg THEN
        rtoc_is_param = (rtoc_named_reg IS_A Param);
      END
    END
    IF !(rtoc_is_param) THEN
      &rtoc_kept.insert(COPY rtoc_name);
    END
  END
  names = COPY rtoc_kept;
  IF names.empty?() THEN
    RETURN;
  END
  MUTABLE rtoc_carry: [Set]String = COPY (fn.heap_carry_return_vars OR_ELSE Set[]);
  FOR rtoc_carry_name IN names DO
    &rtoc_carry.insert(COPY rtoc_carry_name);
  END
  fn.heap_carry_return_vars = COPY rtoc_carry;
  escapeAnalysis__mark_decl_symbols_heap_by_name_mut(facts, names);
END
# Ruby chains `node.is_a?(AST::BinaryOp)` straight off the unwrapped value; a
# DynamicValue has to become a Locatable before IS_A can ask about a variant.
PRIVATE FN escapeAnalysis__unwrap_orelse_left(expr: Locatable) RETURNS ?Locatable ->
  MUTABLE node: ?DynamicValue = escapeAnalysis__unwrap_value(UNWRAP (castLocatableToDynamicValue(expr)));
  MUTABLE loc: ?Locatable = castOptionalDynamicValueToOptionalLocatable(node);
  IF loc EXISTS AS rtoc_loc THEN
    IF rtoc_loc IS_A BinaryOp AS rtoc_bin THEN
      IF (rtoc_bin.op == symbol("OR_ELSE")) THEN
        MUTABLE inner: ?DynamicValue = escapeAnalysis__unwrap_value(castOptionalLocatableToOptionalDynamicValue(locatable__left(rtoc_loc)));
        RETURN castOptionalDynamicValueToOptionalLocatable(inner);
      END
    END
  END
  RETURN COPY loc;
END
PUB FN escapeAnalysis__materializing_pipeline_expr?(expr: Locatable) RETURNS Bool ->
  MUTABLE node: ?Locatable = escapeAnalysis__unwrap_orelse_left(expr);
  IF node EXISTS AS rtoc_node THEN
    IF rtoc_node IS_A BinaryOp AS rtoc_smooth_n THEN
      IF binaryOp__smooth?(rtoc_smooth_n) THEN
        IF locatable__right(rtoc_node) EXISTS AS rtoc_right THEN
          RETURN !(rtoc_right IS_A SkipOp);
        END
        RETURN TRUE;
      END
    END
  END
  RETURN FALSE;
END
PUB FN escapeAnalysis__returned_call_result?(expr: Locatable) RETURNS Bool ->
  MUTABLE node: ?Locatable = escapeAnalysis__unwrap_orelse_left(expr);
  IF node EXISTS AS rtoc_node THEN
    RETURN aST__call?(rtoc_node);
  END
  RETURN FALSE;
END
PUB FN escapeAnalysis__mark_decl_symbols_heap_by_name_mut(facts: FunctionFacts, names: [Set]String) RETURNS Void ->
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < names.length() DO
    MUTABLE sym: ?SymbolEntry@multiowned = COPY facts.symbols[UNWRAP (names[rtoc_idx])];
    IF !(sym) THEN
        rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    MUTABLE changed = escapeAnalysis__mark_symbol_heap_mut(sym);
    IF changed THEN
      IF sym.reg EXISTS AS MUTABLE rtoc_decl THEN
        symbolEntryRegInput__set_container_borrow_mut(&rtoc_decl, FALSE);
      END
    END
  rtoc_idx = rtoc_idx + 1;
  END
END
PUB FN escapeAnalysis__mark_heap_return_facts_mut(facts: FunctionFacts, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Void ->
  FOR MUTABLE rtoc_mutable_block_param_33 IN facts.return_values DO
  IF TRY (escapeAnalysis__owning_return_needs_heap_placement?(facts.fn, &rtoc_mutable_block_param_33, schema_lookup)) THEN
    TRY (escapeAnalysis__mark_heap_return_mut(facts, rtoc_mutable_block_param_33));
  END
  END
END
PUB FN escapeAnalysis__collect_identifier_names_mut(expr: Locatable, MUTABLE names: [Set]String) RETURNS !Void ->
  MUTABLE stack: []Locatable = [expr];
  WHILE !((stack.length() == 0)) DO
    MUTABLE rtoc_popped: ?Locatable = &stack.pop();
    MUTABLE rtoc_unwrapped: ?DynamicValue = escapeAnalysis__unwrap_value(castOptionalLocatableToOptionalDynamicValue(rtoc_popped));
    MUTABLE rtoc_loc: ?Locatable = castOptionalDynamicValueToOptionalLocatable(rtoc_unwrapped);
    IF (rtoc_loc == NIL) THEN
      CONTINUE;
    END
    MUTABLE node: Locatable = COPY rtoc_loc;
    IF node IS_A Identifier THEN
      &names.insert(COPY (locatable__name(node) OR_ELSE ""));
      CONTINUE;
    END
    # Only a value-block's RESULT flows out of it -- identifiers in its body
    # statements are not part of the returned value.
    IF node IS_A BlockExpr AS rtoc_block THEN
      IF rtoc_block.result EXISTS AS rtoc_block_result THEN
        &stack.append(COPY rtoc_block_result);
      END
      CONTINUE;
    END
    TRY (escapeAnalysis__push_locatable_children_mut(node, &stack));
  END
END
PUB FN escapeAnalysis__assignment_target_heap_destination?(facts: FunctionFacts, target: AssignmentTarget, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Bool ->
  RETURN PARTIAL MATCH target START
    AssignmentTarget.StringValue AS string -> escapeAnalysis__symbol_heap?(escapeAnalysis__symbol_for_name(facts, string)),
    AssignmentTarget.SymbolValue AS string_symbol -> escapeAnalysis__symbol_heap?(escapeAnalysis__symbol_for_name(facts, CAST(string_symbol AS String))),
    DEFAULT -> TRY (escapeAnalysis__heap_destination?(facts, castAssignmentTargetToLocatable(target), schema_lookup))
  END;
END
PUB FN escapeAnalysis__heap_destination?(facts: FunctionFacts, target: Locatable, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Bool ->
  MUTABLE root: ?Identifier = aST__root_identifier(target);
  IF root EXISTS AS root_value THEN
    MUTABLE root_value_mutable = COPY root_value;
    IF escapeAnalysis__symbol_heap?(root_value_mutable.symbol) THEN
      RETURN TRUE;
    END
    MUTABLE sym: ?SymbolEntry@multiowned = escapeAnalysis__symbol_for_name(facts, root_value_mutable.name);
    IF escapeAnalysis__symbol_heap?(sym) THEN
      RETURN TRUE;
    END
    IF target IS_A Identifier AS identifier THEN
      RETURN FALSE;
    END
    MUTABLE ti = TRY (aST__full_type_mut( Locatable{ Identifier: COPY root_value_mutable }));
    RETURN (TRY (type__cleanup_allocator(ti, schema_lookup)) == :heap);
  ELSE
    RETURN FALSE;
  END
CATCH Transient, Input, System, NotFound, Permission, Canceled
  RETURN FALSE;
END
PUB FN escapeAnalysis__call_result_is_heap?(value: Locatable, fn_nodes: {String}FunctionDef, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult, facts_by_name: {String}FunctionFacts) RETURNS !Bool ->
  MUTABLE rtoc_call_loc: ?Locatable = escapeAnalysis__unwrap_orelse_left(value);
  IF (rtoc_call_loc == NIL) THEN
    RETURN FALSE;
  END
  MUTABLE rtoc_call_node: Locatable = COPY rtoc_call_loc;
  IF !(aST__call?(rtoc_call_node)) THEN
    RETURN FALSE;
  END
  MUTABLE call: EscapeAnalysisCall = UNWRAP (castLocatableToEscapeAnalysisCall(rtoc_call_node));
  MUTABLE rtoc_callee_name: String = COPY (aST__node_name(rtoc_call_node) OR_ELSE "");
  MUTABLE callee: ?FunctionDef = COPY fn_nodes[rtoc_callee_name];
  IF ((callee != NIL) AND escapeAnalysis__function_def_has_return_lifetime?(callee)) THEN
    RETURN FALSE;
  END
  MUTABLE callee_facts: ?FunctionFacts = COPY facts_by_name[rtoc_callee_name];
  IF callee EXISTS AS callee_value THEN
    RETURN TRY (escapeAnalysis__call_result_is_heap_for_callee?(call, callee_value, schema_lookup, callee_facts));
  END
  MUTABLE sig_branch_value: ?FunctionSignature@multiowned = locatable__matched_signature(rtoc_call_node);
  MUTABLE sig: ?FunctionSignature@multiowned = sig_branch_value;
  IF sig EXISTS AS sig_value THEN
    MUTABLE sig_value_mutable = COPY sig_value;
    IF !(((TRY (functionSignature__return_lifetime(sig_value_mutable))).length() == 0)) THEN
      RETURN FALSE;
    END
    MUTABLE dep: ?Bool = TRY (escapeAnalysis__signature_heap_return_from_args?(call, sig_value_mutable));
    IF !((dep == NIL)) THEN
      RETURN dep;
    END
    IF (TRUE AND (functionSignature__heap_carry_return(sig_value_mutable) == TRUE)) THEN
      RETURN TRUE;
    END
    IF TRY (functionSignature__heap_return_alloc?(sig_value_mutable)) THEN
      RETURN TRUE;
    END
    RETURN FALSE;
  ELSE
    RETURN FALSE;
  END
END
PUB FN escapeAnalysis__call_result_is_heap_for_callee?(call: EscapeAnalysisCall, callee: FunctionDef, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult, facts: ?FunctionFacts = NIL) RETURNS !Bool ->
  MUTABLE dep: ?Bool = TRY (escapeAnalysis__heap_return_from_args?(UNWRAP (escapeAnalysisCall__args(call)), callee.params, callee.heap_carry_return_vars, castOptionalTypeToOptionalTypeTypeInput(callee.return_type), schema_lookup));
  IF !((dep == NIL)) THEN
    RETURN dep;
  END
  MUTABLE callee_facts = (facts OR_ELSE TRY (escapeAnalysis__function_facts(callee)));
  RETURN (((callee.heap_carry_return == TRUE) OR TRY (escapeAnalysis__function_facts_have_owned_return_value?(callee_facts, schema_lookup))) OR escapeAnalysis__function_facts_have_heap_return_binding?(callee_facts));
END
PUB FN escapeAnalysis__signature_heap_return_from_args?(call: EscapeAnalysisCall, sig_obj: FunctionSignature) RETURNS !?Bool ->
  RETURN TRY (escapeAnalysis__heap_return_from_args?(UNWRAP (escapeAnalysisCall__args(call)), TRY (functionSignature__params(sig_obj)), TRY (functionSignature__heap_carry_return_vars(sig_obj)), TypeTypeInput{ Type: COPY functionSignature__return_type(sig_obj) }, NIL));
END
PUB FN escapeAnalysis__heap_return_from_args?(args: []Locatable, params: []Param, returned_names: ?[Set]String, return_type: ?TypeTypeInput = NIL, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL) RETURNS !?Bool ->
  IF returned_names EXISTS AS returned_names_value THEN
    IF !(returned_names_value.empty?()) THEN
      MUTABLE by_name: {String}Int64 = {};
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < params.length() DO
  by_name[((UNWRAP (params[rtoc_idx])).name)] = rtoc_idx;
  rtoc_idx = rtoc_idx + 1;
      END
      MUTABLE has_param_return: Bool = FALSE;
      MUTABLE rtoc_idx = 0;
      WHILE rtoc_idx < returned_names_value.length() DO
    MUTABLE idx: ?Int64 = by_name[CAST(returned_names_value[rtoc_idx] AS String)];
    IF !(idx) THEN
            RETURN TRUE;
    END
    has_param_return = TRUE;
    MUTABLE arg: ?Locatable = COPY args[idx];
    IF TRY (escapeAnalysis__expr_produces_heap?(arg)) THEN
            RETURN TRUE;
    END
  rtoc_idx = rtoc_idx + 1;
      END
      IF has_param_return THEN
        MUTABLE ret: ?Type = TRY (type__from_node(UNWRAP (castTypeTypeInputToType(UNWRAP (return_type)))));
        IF ret EXISTS AS ret_value THEN
          MUTABLE ret_value = TRY (type__success_type(ret_value));
        END
        IF (IF (IF ret != NIL THEN
          TRY (type__string?(ret))
        ELSE
          NIL
        END) != NIL THEN (IF ret != NIL THEN
          TRY (type__string?(ret))
        ELSE
          NIL
        END) ELSE (IF ret != NIL THEN
          TRY (type__recursive_cleanup_shape?(ret, schema_lookup))
        ELSE
          NIL
        END) END) THEN
          RETURN TRUE;
        END
        RETURN FALSE;
      END
      RETURN NIL;
    ELSE
      RETURN NIL;
    END
  ELSE
    RETURN NIL;
  END
END
PUB FN escapeAnalysis__expr_produces_heap?(expr: ?Locatable) RETURNS !Bool ->
  MUTABLE rtoc_node_loc: ?Locatable = escapeAnalysis__unwrap_orelse_left(UNWRAP (expr));
  IF (rtoc_node_loc == NIL) THEN
    RETURN FALSE;
  END
  MUTABLE node: Locatable = COPY rtoc_node_loc;
  IF aST__node_storage(node) EXISTS AS rtoc_node_storage THEN
    IF ([:rodata, :borrow]).contains?(rtoc_node_storage) THEN
      RETURN FALSE;
    END
  END
  IF aST__node__symbol(node) EXISTS AS rtoc_node_symbol THEN
    IF symbolEntry__rodata_provenance?(rtoc_node_symbol) THEN
      RETURN FALSE;
    END
    IF symbolEntry__borrow_provenance?(rtoc_node_symbol) THEN
      RETURN FALSE;
    END
    IF symbolEntry__heap_storage?(rtoc_node_symbol) THEN
      RETURN TRUE;
    END
  END
  IF aST__node_heap_storage?(node) THEN
    RETURN TRUE;
  END
  IF escapeAnalysis__string_concat_expr?(node) THEN
    RETURN TRUE;
  END
  MUTABLE ti = TRY (aST__full_type_mut(node));
  RETURN (TRY (type__heap_ptr?(ti)) OR TRY (type__recursive_cleanup_shape?(ti, NIL)));
END
PUB FN escapeAnalysis__function_def_has_return_lifetime?(fn_value: FunctionDef) RETURNS Bool ->
  MUTABLE rl: ?ClearParserReturnLifetime = fn_value.return_lifetime;
  IF (rl == NIL) THEN
    RETURN FALSE;
  END
  IF ((IF rl IS_A String@symbol AS rl_payload THEN (rl_payload == :wildcard) ELSE FALSE END)) THEN
    RETURN TRUE;
  END
  IF rl IS_A ArrayValue AS rl_nodes THEN
    RETURN !(rl_nodes.empty?());
  END
  RETURN FALSE;
END
PUB FN escapeAnalysis__function_facts_have_owned_return_value?(facts: FunctionFacts, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Bool ->
  RETURN facts.return_values |> ANY { MUTABLE rtoc_mutable_block_param_35 = COPY _;
  TRY (escapeAnalysis__owning_return_needs_heap_placement?(facts.fn, &rtoc_mutable_block_param_35, schema_lookup)) };
END
PUB FN escapeAnalysis__function_facts_have_heap_return_binding?(facts: FunctionFacts) RETURNS Bool ->
  RETURN facts.return_values |> ANY escapeAnalysis__expr_has_heap_identifier?(_);
END
PUB FN escapeAnalysis__symbol_for_binding_node(node: BindingNode) RETURNS ?SymbolEntry@multiowned ->
  MUTABLE rtoc_owned_return_36: ?SymbolEntry@multiowned = bindingNode__symbol(node);
  RETURN rtoc_owned_return_36;
END
PUB FN escapeAnalysis__mark_symbol_heap_mut(sym: ?SymbolEntry, MUTABLE names: ?[Set]String = NIL, name: ?String = NIL) RETURNS Bool ->
  MUTABLE sym_entry: ?SymbolEntry@multiowned = escapeAnalysis__canonical_symbol(sym);
  IF !(sym_entry) THEN
    RETURN FALSE;
  END
  IF ( symbolEntry__heap_storage?( sym_entry) OR symbolEntry__borrow_provenance?( sym_entry)) THEN
    RETURN FALSE;
  END
  symbolEntry__set_storage(&sym_entry, :heap);
  IF ((names != NIL) AND (name != NIL)) THEN
    &names.insert(COPY name);
  END
  RETURN TRUE;
END
PUB FN escapeAnalysis__mark_node_symbol_heap_mut(node: Locatable) RETURNS Bool ->
  MUTABLE changed = escapeAnalysis__mark_symbol_heap_mut(aST__node__symbol(node));
  IF changed THEN
    IF aST__node__symbol(node) EXISTS AS rtoc_node_symbol THEN
      IF rtoc_node_symbol.reg EXISTS AS MUTABLE rtoc_decl THEN
        symbolEntryRegInput__set_container_borrow_mut(&rtoc_decl, FALSE);
      END
    END
  END
  RETURN changed;
END
PUB FN escapeAnalysis__mark_symbol_borrow_mut(sym: ?SymbolEntry) RETURNS Bool ->
  MUTABLE sym_entry: ?SymbolEntry@multiowned = escapeAnalysis__canonical_symbol(sym);
  IF !(sym_entry) THEN
    RETURN FALSE;
  END
  IF ( symbolEntry__heap_storage?( sym_entry) OR symbolEntry__borrow_provenance?( sym_entry)) THEN
    RETURN FALSE;
  END
  symbolEntry__set_storage(&sym_entry, :borrow);
  RETURN TRUE;
END
PUB FN escapeAnalysis__mark_reassigned_symbol_heap_mut(sym: ?SymbolEntry) RETURNS Bool ->
  MUTABLE sym_entry: ?SymbolEntry@multiowned = escapeAnalysis__canonical_symbol(sym);
  IF !(sym_entry) THEN
    RETURN FALSE;
  END
  IF symbolEntry__heap_storage?( sym_entry) THEN
    RETURN FALSE;
  END
  symbolEntry__set_storage(&sym_entry, :heap);
  RETURN TRUE;
END
PUB FN escapeAnalysis__canonical_symbol(sym: ?SymbolEntry) RETURNS ?SymbolEntry@multiowned ->
  IF sym EXISTS AS sym_value THEN
    MUTABLE decl_branch_value: ?SymbolEntryRegInput = NIL;
    IF TRUE THEN
      decl_branch_value = COPY sym_value.reg;
    ELSE
      decl_branch_value = NIL;
    END
    MUTABLE decl: ?SymbolEntryRegInput = decl_branch_value;
    IF decl EXISTS AS rtoc_decl_value THEN
      IF symbolEntryRegInput__symbol(rtoc_decl_value) EXISTS AS rtoc_decl_symbol THEN
        RETURN COPY rtoc_decl_symbol;
      END
    END
    RETURN COPY sym_value;
  ELSE
    RETURN NIL;
  END
END
PUB FN escapeAnalysis__symbol_heap?(sym: ?SymbolEntry) RETURNS Bool ->
  RETURN ((escapeAnalysis__canonical_symbol(sym) != NIL) AND ({ MUTABLE rtoc_value_block_marker = 0; MUTABLE rtoc_local_receiver_37 = ((escapeAnalysis__canonical_symbol(sym))?);
  symbolEntry__heap_storage?(rtoc_local_receiver_37) } == TRUE));
END
# End Ruby module EscapeAnalysis
FN castAssignmentNameToAssignmentTarget(value: AssignmentName) RETURNS AssignmentTarget ->
  PARTIAL MATCH value START
    AssignmentName.StringValue AS cast_payload -> RETURN AssignmentTarget{ StringValue: COPY cast_payload };,
    AssignmentName.Identifier AS cast_payload -> RETURN AssignmentTarget{ Identifier: COPY cast_payload };,
    AssignmentName.GetField AS cast_payload -> RETURN AssignmentTarget{ GetField: COPY cast_payload };,
    AssignmentName.GetIndex AS cast_payload -> RETURN AssignmentTarget{ GetIndex: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to AssignmentTarget");
  END
  panic("Invalid cast to AssignmentTarget");
END
FN castAssignmentNameToLocatable__escape_analysis(value: AssignmentName) RETURNS Locatable ->
  PARTIAL MATCH value START
    AssignmentName.Identifier AS cast_payload -> RETURN Locatable{ Identifier: COPY cast_payload };,
    AssignmentName.GetField AS cast_payload -> RETURN Locatable{ GetField: COPY cast_payload };,
    AssignmentName.GetIndex AS cast_payload -> RETURN Locatable{ GetIndex: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Locatable");
  END
  panic("Invalid cast to Locatable");
END
FN castLocatableToAssignment(value: Locatable) RETURNS Assignment ->
  IF value IS_A Assignment AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to Assignment");
END
FN castLocatableToDestructuringAssignment(value: Locatable) RETURNS DestructuringAssignment ->
  IF value IS_A DestructuringAssignment AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to DestructuringAssignment");
END
FN castLocatableToFuncCall__escape_analysis(value: Locatable) RETURNS FuncCall ->
  IF value IS_A FuncCall AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to FuncCall");
END
FN castLocatableToLambdaLit(value: Locatable) RETURNS LambdaLit ->
  IF value IS_A LambdaLit AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to LambdaLit");
END
FN castLocatableToOptionalDynamicValue(value: Locatable) RETURNS ?DynamicValue ->
  PARTIAL MATCH value START
    Locatable.RequireNode AS cast_payload -> RETURN DynamicValue{ RequireNode: COPY cast_payload };,
    Locatable.ProtocolRequirement AS cast_payload -> RETURN DynamicValue{ ProtocolRequirement: COPY cast_payload };,
    Locatable.ProtocolDef AS cast_payload -> RETURN DynamicValue{ ProtocolDef: COPY cast_payload };,
    Locatable.FunctionDef AS cast_payload -> RETURN DynamicValue{ FunctionDef: COPY cast_payload };,
    Locatable.ImplementationDef AS cast_payload -> RETURN DynamicValue{ ImplementationDef: COPY cast_payload };,
    Locatable.ConformanceDef AS cast_payload -> RETURN DynamicValue{ ConformanceDef: COPY cast_payload };,
    Locatable.VarDecl AS cast_payload -> RETURN DynamicValue{ VarDecl: COPY cast_payload };,
    Locatable.Assignment AS cast_payload -> RETURN DynamicValue{ Assignment: COPY cast_payload };,
    Locatable.DestructuringAssignment AS cast_payload -> RETURN DynamicValue{ DestructuringAssignment: COPY cast_payload };,
    Locatable.BindExpr AS cast_payload -> RETURN DynamicValue{ BindExpr: COPY cast_payload };,
    Locatable.BinaryOp AS cast_payload -> RETURN DynamicValue{ BinaryOp: COPY cast_payload };,
    Locatable.IsA AS cast_payload -> RETURN DynamicValue{ IsA: COPY cast_payload };,
    Locatable.CallSiteOverride AS cast_payload -> RETURN DynamicValue{ CallSiteOverride: COPY cast_payload };,
    Locatable.Identifier AS cast_payload -> RETURN DynamicValue{ Identifier: COPY cast_payload };,
