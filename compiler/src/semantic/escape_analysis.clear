# Ruby asks `target.is_a?(String) || target.is_a?(Symbol)` before treating the
# assignment target as a plain name.
FN castOptionalDynamicValueToOptionalString(value: ?DynamicValue) RETURNS ?String ->
  IF value EXISTS AS rtoc_value THEN
    PARTIAL MATCH rtoc_value START
      DynamicValue.StringValue AS cast_payload -> RETURN COPY cast_payload;,
      DynamicValue.SymbolValue AS cast_payload -> RETURN COPY CAST(cast_payload AS String);,
      DEFAULT -> RETURN NIL;
    END
  END
  RETURN NIL;
END
