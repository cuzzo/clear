FN rubyToClearVoid__escape_analysis() RETURNS Void ->
  RETURN;
END
FN ruby_array_concat_Locatable(left: []Locatable, right: []Locatable) RETURNS []Locatable ->
  MUTABLE result: []Locatable = [];
  left |> EACH { &result.append(COPY _); };
  right |> EACH { &result.append(COPY _); };
  RETURN result;
END
FN ruby_set_intersection_String_set__escape_analysis(left: [Set]String, right: [Set]String) RETURNS [Set]String ->
  MUTABLE result: [Set]String = [];
  left |> EACH {
    IF right.contains?(_) AND !(result.contains?(_)) THEN
      &result.insert(COPY _);
    END
  };
  RETURN result;
END
FN ruby_wrap_optional_FunctionSignature_multiowned_X__escape_analysis(value: ?FunctionSignature) RETURNS ?X ->
  IF value EXISTS AS optional_payload THEN
    RETURN X{ FunctionSignatureMultiowned: COPY optional_payload };
  END
  NIL;
END
PUB FN escapeContext__schema_lookup_call(self: EscapeContext, arg0: String@symbol) RETURNS ?TypeSchemaLookupResult ->
  MUTABLE fn_value = UNWRAP (self.schema_lookup);
  RETURN fn_value(arg0);
END

# Ruby asks `respond_to?(:args)` and then reads it. A union variant
# either carries the field or it does not, so the question is answered here:
# the variants that have it return it, the rest return NIL.
PUB FN escapeAnalysisCall__args(value: EscapeAnalysisCall) RETURNS ?[]Locatable ->
  PARTIAL MATCH value START
    EscapeAnalysisCall.FuncCall AS item -> RETURN COPY item.args;,
    EscapeAnalysisCall.MethodCall AS item -> RETURN COPY item.args;,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END

