# Ruby narrows to `AST::FuncCall | AST::MethodCall` by asking `AST.call?`.
FN castLocatableToEscapeAnalysisCall(value: Locatable) RETURNS ?EscapeAnalysisCall ->
  PARTIAL MATCH value START
    Locatable.FuncCall AS cast_payload -> RETURN EscapeAnalysisCall{ FuncCall: COPY cast_payload };,
    Locatable.MethodCall AS cast_payload -> RETURN EscapeAnalysisCall{ MethodCall: COPY cast_payload };,
    DEFAULT -> RETURN NIL;
  END
  RETURN NIL;
END
