END
STRUCT LifecycleRegistry {
  binding_plans: {Int64}LifecyclePlan,
  plans: {String}LifecyclePlan
}

UNION SemanticLifecycleRegistryBindingNode { VarDecl: VarDecl, BindExpr: BindExpr, DestructureTarget: DestructureTarget }
FN lifecycleRegistry__empty() RETURNS LifecycleRegistry@multiowned ->
  RETURN lifecycleRegistry__new({}, {});
END
FN lifecycleRegistry__concrete_schema_type(owner: Type, raw_type: TypeTypeInput, type_params: []String@symbol) RETURNS !Type ->
  MUTABLE subst: {String@symbol}Type = {};
  # Ruby zips the parameter names with the concrete arguments; CLEAR has no
  # zip, so walk the shorter of the two by index.
  MUTABLE generic_args = TRY (type__generic_args(owner));
  MUTABLE pair_index: Int64 = 0;
  WHILE ((pair_index < type_params.length()) AND (pair_index < generic_args.length())) DO
    MUTABLE param_name = COPY UNWRAP (type_params[pair_index]);
    MUTABLE argument = COPY UNWRAP (generic_args[pair_index]);
    subst[param_name] = TRY (type__new(TypeConstructionInput{ Type: COPY argument }));
    pair_index = pair_index + 1;
  END
  RETURN CAST(TRY (lifecycleRegistry__substitute_schema_type(raw_type, subst)) AS Type);
END
FN lifecycleRegistry__type_inventory(program: Program, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !{String}Type ->
  MUTABLE types: {String}Type = {};
  aST__each_locatable(CAST(program AS Locatable), TRUE, %(node: Locatable) USE(MUTABLE types) -> {
  # `typed?` is `!full_type.untyped?` on the Ruby side; there is no such method
  # on Locatable here, so ask the type directly.
  IF !(type__untyped?(TRY (aST__full_type_mut(node)))) THEN
      MUTABLE node_type: Type = TRY (aST__full_type_mut(node));
      TRY (lifecycleRegistry__add_type_mut(&types, node_type));
  END
  rubyToClearVoid()
  });
  TRY (lifecycleRegistry__add_declaration_types_mut(&types, program));
  TRY (lifecycleRegistry__add_instantiated_schema_types_mut(&types, schema_lookup));
  RETURN types;
END
FN lifecycleRegistry__build(program: Program, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, binding_nodes: []SemanticLifecycleRegistryBindingNode, linear_resource_facts: ?LinearResourceFacts = NIL, inventory: ?{String}Type = NIL) RETURNS !LifecycleRegistry@multiowned ->
  MUTABLE types = (inventory OR_ELSE TRY (lifecycleRegistry__type_inventory(program, schema_lookup)));
  MUTABLE resource_facts = (linear_resource_facts OR_ELSE linearResourceFacts__build_types(types.values(), schema_lookup));
  MUTABLE plans: {String}LifecyclePlan = {};
  types.keys() |> EACH {
  MUTABLE type_info: Any = (types[_] OR_ELSE panic("missing hash key"));
  plans[_] = TRY (lifecyclePlanner__plan(type_info, schema_lookup, resource_facts));
  };
  lifecycleRegistry__add_monomorphic_carrier_plans_mut(&plans, program);
  MUTABLE binding_plans: {Int64}LifecyclePlan = {};
  MUTABLE inventoried_bindings: []SemanticLifecycleRegistryBindingNode = COPY binding_nodes;
  aST__each_locatable(CAST(program AS Locatable), TRUE, %(node: Locatable) USE(MUTABLE inventoried_bindings) -> {
  IF !(((node IS_A VarDecl OR node IS_A BindExpr) OR node IS_A DestructureTarget)) THEN
      RETURN;
  END
  IF (IF node IS_A BindExpr AS bind_expr THEN (bind_expr.mode == :assign) ELSE FALSE END) THEN
      RETURN;
  END
  IF type__untyped?(TRY (aST__full_type_mut(node))) THEN
      RETURN;
  END
  &inventoried_bindings.append(castLocatableToSemanticLifecycleRegistryBindingNode(COPY node));
  rubyToClearVoid()
  });
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < inventoried_bindings.length() DO
    MUTABLE symbol_branch_value: ?SymbolEntry = NIL;
      IF TRUE THEN
        MATCH inventoried_bindings[rtoc_idx]? START SemanticLifecycleRegistryBindingNode.VarDecl AS item -> symbol_branch_value = item.symbol;, SemanticLifecycleRegistryBindingNode.BindExpr AS item -> symbol_branch_value = item.symbol;, SemanticLifecycleRegistryBindingNode.DestructureTarget AS item -> symbol_branch_value = item.symbol; END
      ELSE
        symbol_branch_value = NIL;
      END
    MUTABLE symbol: ?SymbolEntry = symbol_branch_value;
    MUTABLE declaration_branch_value: ?SymbolEntryRegInput = NIL;
      IF (symbol != NIL) THEN
        declaration_branch_value = symbol.reg;
      ELSE
        declaration_branch_value = NIL;
      END
    MUTABLE declaration: ?SymbolEntryRegInput = declaration_branch_value;
    IF ((((declaration != NIL) AND (declaration IS_A VarDecl)) OR ((declaration != NIL) AND (declaration IS_A BindExpr))) OR ((declaration != NIL) AND (declaration IS_A DestructureTarget))) THEN
        MUTABLE node: ?SymbolEntryRegInput = declaration;
    END
    IF (IF inventoried_bindings[rtoc_idx]? IS_A BindExpr AS bind_expr THEN (bind_expr.mode == :assign) ELSE FALSE END) THEN
        rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    IF type__untyped?(TRY (aST__full_type_mut(castSemanticLifecycleRegistryBindingNodeToLocatable(UNWRAP (inventoried_bindings[rtoc_idx]))))) THEN
        rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    MUTABLE place_id: ?Int64 = lifecycleRegistry__class_binding_place_id(castSemanticLifecycleRegistryBindingNodeToLocatable(inventoried_bindings[rtoc_idx]?));
    IF !(place_id) THEN
        rtoc_idx = rtoc_idx + 1;
  CONTINUE;
    END
    MUTABLE plan = TRY (lifecyclePlanner__plan_binding(TRY (aST__full_type_mut(castSemanticLifecycleRegistryBindingNodeToLocatable(UNWRAP (inventoried_bindings[rtoc_idx])))), castSemanticLifecycleRegistryBindingNodeToLocatable(inventoried_bindings[rtoc_idx]?), schema_lookup, resource_facts));
    MUTABLE existing: ?LifecyclePlan = COPY binding_plans[UNWRAP (place_id)];
    MUTABLE existing_close: ?[]String = NIL;
    IF existing EXISTS AS existing_plan THEN
      IF existing_plan.resource_close_plan EXISTS AS existing_close_plan THEN
        existing_close = COPY existing_close_plan.actions |> SELECT "${_.name}|${_.field_path.join(",")}|${_.runtime_heap_alloc_args.toString()}";
      END
    END
    MUTABLE planned_close: ?[]String = NIL;
    IF plan.resource_close_plan?.actions != NIL THEN
        planned_close = COPY ((plan.resource_close_plan?.actions)?) |> SELECT "${_.name}|${_.field_path.join(",")}|${_.runtime_heap_alloc_args.toString()}";
      END
    MUTABLE same_contract = (((((existing != NIL) AND (existing.type_key == plan.type_key)) AND (existing.drop_strategy == plan.drop_strategy)) AND (existing.copy_strategy == plan.copy_strategy)) AND (existing_close == planned_close));
    IF ((existing != NIL) AND !(same_contract)) THEN
        panic("{}{}{}");
    END
    binding_plans[UNWRAP (place_id)] = plan;
  rtoc_idx = rtoc_idx + 1;
  END
  RETURN lifecycleRegistry__new(plans, binding_plans);
END
FN lifecycleRegistry__add_monomorphic_carrier_plans_mut(MUTABLE plans: {String}LifecyclePlan, program: Program) RETURNS !Void ->
  aST__each_locatable(CAST(program AS Locatable), TRUE, %(node: Locatable) USE(MUTABLE plans) -> {
  IF !(node IS_A FunctionDef) THEN
      RETURN;
  END
  MUTABLE rtoc_each_items_5 = (TRY (functionSignature__params(node)));
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < rtoc_each_items_5.length() DO
      IF !((rtoc_each_items_5[rtoc_idx].takes AND (rtoc_each_items_5[rtoc_idx].carrier_contract == :monomorphic))) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE plan = lifecyclePlanner__monomorphic_carrier_plan(rtoc_each_items_5[rtoc_idx].type);
      plans[plan.type_key] = plan;
    rtoc_idx = rtoc_idx + 1;
  END
  rubyToClearVoid()
  });
END
FN lifecycleRegistry__initialize(MUTABLE self: LifecycleRegistry, plans: {String}LifecyclePlan, binding_plans: {Int64}LifecyclePlan) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.plans = COPY plans;
    rtoc_self_view.binding_plans = COPY binding_plans;
}
END
FN lifecycleRegistry__fetch(self: LifecycleRegistry, type_info: Type) RETURNS !LifecyclePlan
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE key = type__lifecycle_type_key(type_info);
    RETURN COPY (rtoc_self_view.plans[key] OR_ELSE {
    IF !(type__primitive?(type_info)) THEN
        panic("missing annotation lifecycle plan for {} (non-primitive type absent from inventory; refusing to default to no-drop)");
    END
    LifecyclePlan{ type_key: COPY key, drop_strategy: :none, copy_strategy: :bit_copy, resource_close_plan: NIL }
    });
}
END
FN lifecycleRegistry__fetch_monomorphic(self: LifecycleRegistry, type_info: Type) RETURNS LifecyclePlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY (rtoc_self_view.plans[lifecyclePlanner__monomorphic_carrier_key(type_info)] OR_ELSE lifecyclePlanner__monomorphic_carrier_plan(type_info));
}
END
FN lifecycleRegistry__fetch_binding(self: LifecycleRegistry, node: Locatable, type_info: Type) RETURNS !LifecyclePlan
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE place_id: ?Int64 = lifecycleRegistry__binding_place_id(rtoc_self_view, node);
    IF place_id EXISTS AS place_id_value THEN
      RETURN COPY (rtoc_self_view.binding_plans[place_id_value] OR_ELSE panic("missing annotation binding lifecycle plan for place {}"));
    ELSE
      RETURN UNWRAP ([type_info]);
    END
}
END
