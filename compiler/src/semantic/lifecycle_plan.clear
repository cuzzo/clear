PRIVATE FN lifecycleRegistry__add_declaration_types_mut(MUTABLE types: {String}Type, program: Program) RETURNS !Void ->
  aST__each_locatable(CAST(program AS Locatable), TRUE, %(statement: Locatable) USE(MUTABLE types) -> {
  IF statement IS_A StructDef AS struct_def THEN
      MUTABLE struct_def_mutable = COPY struct_def;
      FOR _ IN structDef__field_decls(struct_def_mutable).values() DO
      TRY (lifecycleRegistry__add_type_mut(&types, _.type()));
      END
  ELSE_IF statement IS_A ExternStructDecl AS extern_struct_decl THEN
      MUTABLE extern_struct_decl_mutable = COPY extern_struct_decl;
      FOR _ IN externStructDecl__field_decls(extern_struct_decl_mutable).values() DO
      TRY (lifecycleRegistry__add_type_mut(&types, _.type()));
      END
  ELSE_IF statement IS_A UnionDef AS union_def THEN
      MUTABLE union_def_mutable = COPY union_def;
      FOR _ IN union_def_mutable.variants.values() DO
      IF _ IS_A InlineStructVariant@multiowned THEN
        FOR _ IN _.fields().values() DO
        TRY (lifecycleRegistry__add_type_mut(&types, TRY (type__from_input(_))));
        END
      ELSE_IF _ THEN
        TRY (lifecycleRegistry__add_type_mut(&types, TRY (type__from_variant_input(_))));
      END
      END
  ELSE_IF statement IS_A FunctionDef AS function_def THEN
      MUTABLE function_def_mutable = COPY function_def;
      FOR _ IN (TRY (functionSignature__params(function_def_mutable))) DO
      TRY (lifecycleRegistry__add_type_mut(&types, _.type));
      END
      IF functionSignature__return_type(function_def_mutable) THEN
        TRY (lifecycleRegistry__add_type_mut(&types, TRY (type__new(TypeConstructionInput{ Type: COPY UNWRAP (functionSignature__return_type(function_def_mutable)) }))));
      END
  END
  rubyToClearVoid()
  });
END
PRIVATE FN lifecycleRegistry__add_instantiated_schema_types_mut(MUTABLE types: {String}Type, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Void ->
  MUTABLE pending: []Type = COPY types.values();
  MUTABLE index: Int64 = 0;
  WHILE (index < pending.length()) DO
    MUTABLE type_info = COPY UNWRAP (pending[index]);
    index = (index + 1);
    IF !(type__generic_instance?(type_info)) THEN
      CONTINUE;
    END
    MUTABLE schema: ?TypeSchemaLookupResult = schema_lookup(type__resolved(type_info));
    IF (schema == NIL) THEN
      schema = schema_lookup(type__generic_base(type_info));
    END
    IF !((((schema != NIL) AND (schema IS_A StructSchema)) OR ((schema != NIL) AND (schema IS_A ResourceSchema)))) THEN
      CONTINUE;
    END
    MUTABLE fields = schema.fields().values() |> SELECT _.type();
    FOR _ IN fields DO
  MUTABLE concrete = TRY (lifecycleRegistry__concrete_schema_type(type_info, _, schema.type_params()));
  MUTABLE before = types.count();
  TRY (lifecycleRegistry__add_type_mut(&types, CAST(concrete AS Type)));
  IF (types.count() > before) THEN
        pending = ruby_array_concat_Type(pending, CAST(types.values() |> SKIP before AS []Type));
  END
    END
  END
  RETURN NIL;
END
PRIVATE FN lifecycleRegistry__substitute_schema_type(raw_type: TypeTypeInput, subst: {String@symbol}Type) RETURNS !Type EFFECTS REENTRANT ->
  MUTABLE type_info = TRY (type__from_input(raw_type));
  MUTABLE replacement_branch_value: ?Type = NIL;
  IF type__projection?(type_info) THEN
    MUTABLE owner = symbol(UNWRAP (type__projection_owner(type_info)));
    MUTABLE concrete_input: ?Type = COPY subst[owner];
    IF concrete_input EXISTS AS concrete_input_value THEN
      MUTABLE concrete = TRY (type__new(TypeConstructionInput{ Type: COPY concrete_input_value }));
      MUTABLE projected: ?Type = NIL;
      MUTABLE member: ?String@symbol = type__projection_member(type_info);
      IF type__map?(concrete) THEN
        IF (member == :Key) THEN
          projected = TRY (type__key_type(concrete));
        ELSE_IF (member == :Value) THEN
          projected = TRY (type__value_type(concrete));
        END
      END
      replacement_branch_value = (projected OR_ELSE TRY (type__new(TypeConstructionInput{ TypeExpression: COPY typeExpression__of(TypeProjectionExpression{ owner: COPY type__resolved(concrete), member: COPY symbol(UNWRAP (type__projection_member(type_info))), protocol: COPY type__projection_protocol(type_info) }) })));
    ELSE
      replacement_branch_value = type_info;
    END
  ELSE_IF type__optional?(type_info) THEN
    replacement_branch_value = TRY (type__optional_of(TypeTypeInput{ Type: COPY TRY (lifecycleRegistry__substitute_schema_type(TypeTypeInput{ Type: COPY UNWRAP (TRY (type__wrapped_type(type_info))) }, subst)) }));
  ELSE_IF type__error_union?(type_info) THEN
    replacement_branch_value = TRY (type__error_union_of(TypeTypeInput{ Type: COPY TRY (lifecycleRegistry__substitute_schema_type(TypeTypeInput{ Type: COPY UNWRAP (TRY (type__payload_type(type_info))) }, subst)) }));
  ELSE_IF type__array?(type_info) THEN
    replacement_branch_value = TRY (type__array_of(TypeTypeInput{ Type: COPY TRY (lifecycleRegistry__substitute_schema_type(TypeTypeInput{ Type: COPY UNWRAP (TRY (type__element_type(type_info))) }, subst)) }, type__capacity(type_info)));
  ELSE_IF type__map?(type_info) THEN
    MUTABLE wrapper = COPY type_info.shape.expression;
    MUTABLE expression: MapTypeExpression = COPY CAST(wrapper.kind AS MapTypeExpression);
    MUTABLE key = TRY (lifecycleRegistry__substitute_schema_type(TypeTypeInput{ Type: COPY TRY (type__key_type(type_info)) }, subst));
    MUTABLE value = TRY (lifecycleRegistry__substitute_schema_type(TypeTypeInput{ Type: COPY TRY (type__value_type(type_info)) }, subst));
    replacement_branch_value = TRY (type__new(TypeConstructionInput{ TypeExpression: COPY TypeExpression{ kind: COPY MapTypeExpression{ key: COPY key.shape.expression, value: COPY value.shape.expression, key_implicit: expression.key_implicit, legacy_separator: COPY expression.legacy_separator }, capabilities: COPY wrapper.capabilities } }));
  ELSE_IF type__generic_instance?(type_info) THEN
    replacement_branch_value = TRY (type__generic_instance_of(type__generic_base(type_info), (TRY (type__generic_args(type_info))) |> SELECT TRY (lifecycleRegistry__substitute_schema_type(TypeTypeInput{ Type: COPY _ }, subst))));
  ELSE_IF type__tense?(type_info) THEN
    replacement_branch_value = TRY (type__tense_of(TypeTypeInput{ Type: COPY TRY (lifecycleRegistry__substitute_schema_type(TypeTypeInput{ Type: COPY TRY (type__tense_type(type_info)) }, subst)) }));
  ELSE
    replacement_branch_value = (subst[type__resolved(type_info)] OR_ELSE type_info);
  END
  MUTABLE replacement: Type = replacement_branch_value?;
  TRY (type__merge_capabilities_from_mut(&replacement, type_info));
  type__copy_placement_from_mut(&replacement, type_info);
  RETURN replacement;
END
FN lifecycleRegistry__new(plans: {String}LifecyclePlan, binding_plans: {Int64}LifecyclePlan) RETURNS LifecycleRegistry@multiowned ->
  MUTABLE self = LifecycleRegistry{ binding_plans: {}, plans: {} };
  lifecycleRegistry__initialize(&self, plans, binding_plans);
  RETURN self @multiowned;
END
# End Ruby module Semantic
FN castLocatableToSemanticLifecycleRegistryBindingNode(value: Locatable) RETURNS SemanticLifecycleRegistryBindingNode ->
  PARTIAL MATCH value START
    Locatable.VarDecl AS cast_payload -> RETURN SemanticLifecycleRegistryBindingNode{ VarDecl: COPY cast_payload };,
    Locatable.DestructureTarget AS cast_payload -> RETURN SemanticLifecycleRegistryBindingNode{ DestructureTarget: COPY cast_payload };,
    Locatable.BindExpr AS cast_payload -> RETURN SemanticLifecycleRegistryBindingNode{ BindExpr: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to SemanticLifecycleRegistryBindingNode");
  END
  panic("Invalid cast to SemanticLifecycleRegistryBindingNode");
END
FN castSemanticLifecycleRegistryBindingNodeToLocatable(value: SemanticLifecycleRegistryBindingNode) RETURNS Locatable ->
  PARTIAL MATCH value START
    SemanticLifecycleRegistryBindingNode.VarDecl AS cast_payload -> RETURN Locatable{ VarDecl: COPY cast_payload };,
    SemanticLifecycleRegistryBindingNode.BindExpr AS cast_payload -> RETURN Locatable{ BindExpr: COPY cast_payload };,
    SemanticLifecycleRegistryBindingNode.DestructureTarget AS cast_payload -> RETURN Locatable{ DestructureTarget: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Locatable");
  END
  panic("Invalid cast to Locatable");
END
FN rubyToClearVoid() RETURNS Void ->
  RETURN;
END
FN ruby_array_concat_Type(left: []Type, right: []Type) RETURNS []Type ->
  MUTABLE result: []Type = [];
  left |> EACH { &result.append(COPY _); };
  right |> EACH { &result.append(COPY _); };
  RETURN result;
END
