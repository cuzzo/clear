  IF !(TRY (type__string?(type_info))) THEN
    RETURN FALSE;
  END
  IF !(((MATCH node START Locatable.Program AS item -> item.var_mutated, Locatable.RequireNode AS item -> item.var_mutated, Locatable.ProtocolRequirement AS item -> item.var_mutated, Locatable.ProtocolDef AS item -> item.var_mutated, Locatable.FunctionDef AS item -> item.var_mutated, Locatable.ImplementationDef AS item -> item.var_mutated, Locatable.ConformanceDef AS item -> item.var_mutated, Locatable.StructDef AS item -> item.var_mutated, Locatable.VarDecl AS item -> item.var_mutated, Locatable.Assignment AS item -> item.var_mutated, Locatable.DestructureTarget AS item -> item.var_mutated, Locatable.DestructuringAssignment AS item -> item.var_mutated, Locatable.BindExpr AS item -> item.var_mutated, Locatable.BinaryOp AS item -> item.var_mutated, Locatable.IsA AS item -> item.var_mutated, Locatable.UnaryOp AS item -> item.var_mutated, Locatable.CallSiteOverride AS item -> item.var_mutated, Locatable.Identifier AS item -> item.var_mutated, Locatable.Literal AS item -> item.var_mutated, Locatable.ListLit AS item -> item.var_mutated, Locatable.TupleLit AS item -> item.var_mutated, Locatable.DefaultArrayLit AS item -> item.var_mutated, Locatable.HashLit AS item -> item.var_mutated, Locatable.DefaultLit AS item -> item.var_mutated, Locatable.StructLit AS item -> item.var_mutated, Locatable.LambdaLit AS item -> item.var_mutated, Locatable.IfStatement AS item -> item.var_mutated, Locatable.IfBind AS item -> item.var_mutated, Locatable.WhileLoop AS item -> item.var_mutated, Locatable.WhileBindLoop AS item -> item.var_mutated, Locatable.BreakNode AS item -> item.var_mutated, Locatable.ContinueNode AS item -> item.var_mutated, Locatable.FuncCall AS item -> item.var_mutated, Locatable.MethodCall AS item -> item.var_mutated, Locatable.GetField AS item -> item.var_mutated, Locatable.GetIndex AS item -> item.var_mutated, Locatable.Cast AS item -> item.var_mutated, Locatable.ReturnNode AS item -> item.var_mutated, Locatable.Assert AS item -> item.var_mutated, Locatable.Raise AS i