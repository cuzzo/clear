EXTERN STRUCT CompilerRegex {} FROM "compiler_regex";
EXTERN FN compilerRegexCompile(pattern: String) RETURNS CompilerRegex EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexMatch(subject: String, regex: CompilerRegex) RETURNS Bool EFFECTS :safe FROM "compiler_regex";
EXTERN FN compilerRegexReplaceFirst(subject: String, regex: CompilerRegex, replacement: String) RETURNS String EFFECTS :safe FROM "compiler_regex";
FN regexMatch?(subject: String, pattern: String) RETURNS Bool ->
  RETURN compilerRegexMatch(subject, compilerRegexCompile(pattern));
END
FN regexReplaceFirst(subject: String, pattern: String, replacement: String) RETURNS String ->
  RETURN compilerRegexReplaceFirst(subject, compilerRegexCompile(pattern), replacement);
END

# Ruby module Semantic
STRUCT LinearResourceFacts {
  known: {String}Bool,
  linear: {String}Bool
}

FN linearResourceFacts__initialize(MUTABLE self: LinearResourceFacts, known: {String}Bool, linear: {String}Bool) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.known = COPY known;
    rtoc_self_view.linear = COPY linear;
}
END
FN linearResourceFacts__empty() RETURNS LinearResourceFacts@multiowned ->
  RETURN linearResourceFacts__new({}, {});
END
FN linearResourceFacts__build(program: Program, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !LinearResourceFacts@multiowned ->
  MUTABLE inventory = TRY (lifecycleRegistry__type_inventory(program, schema_lookup));
  RETURN linearResourceFacts__build_types(inventory.values(), schema_lookup);
END
FN linearResourceFacts__build_types(roots: []Type, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS LinearResourceFacts@multiowned ->
  MUTABLE key: String = "";
  MUTABLE known: {String}Bool = {};
  MUTABLE seeds: {String}Bool = {};
  MUTABLE edges: {String}[]String = {};
  MUTABLE pending: []Type = COPY roots;
  MUTABLE index: Int64 = 0;
  WHILE (index < pending.length()) DO
    MUTABLE type_info = COPY UNWRAP (pending[index]);
    index = (index + 1);
    key = linearResourceFacts__fact_key(type_info);
    IF known.contains?(key) THEN
      CONTINUE;
    END
    known[key] = TRUE;
    MUTABLE seed, dependencies = linearResourceFacts__resource_seed_and_dependencies(type_info, schema_lookup);
    IF seed THEN
      seeds[key] = TRUE;
    END
    MUTABLE dependency_keys: []String = ( { MUTABLE rtoc_empty_list_1: []String = List[]; rtoc_empty_list_1 } );
    FOR _ IN dependencies DO
  MUTABLE dependency_key = linearResourceFacts__fact_key(CAST(COPY _ AS Type));
  &dependency_keys.append(dependency_key);
  IF !(known.contains?(dependency_key)) THEN
        &pending.append(CAST(COPY _ AS Type));
  END
    END
    edges[key] = dependency_keys;
  END
  MUTABLE reverse_edges: {String}[]String = {};
  edges.keys() |> EACH {
  MUTABLE dependencies: []String = (edges[_] OR_ELSE CAST(panic("missing hash key") AS []String));
  FOR _ IN dependencies DO
  reverse_edges[_] = (reverse_edges[_] OR_ELSE List[]);
  IF reverse_edges[_] EXISTS AS rtoc_map_slot_2 THEN
      &rtoc_map_slot_2.append(COPY _);
    ELSE
      panic("T.must: map slot is NIL");
    END
  END
  };
  MUTABLE linear: {String}Bool = {};
  MUTABLE queue: []String = seeds.keys();
  MUTABLE cursor: Int64 = 0;
  WHILE (cursor < queue.length()) DO
    key = COPY UNWRAP (queue[cursor]);
    cursor = (cursor + 1);
    IF linear.contains?(key) THEN
      CONTINUE;
    END
    linear[key] = TRUE;
    FOR _ IN ((reverse_edges[key] OR_ELSE List[])) DO
    IF !(linear.contains?(_)) THEN
      &queue.append(COPY _);
    END
    END
  END
  RETURN linearResourceFacts__new(known, linear);
END
FN linearResourceFacts__contains?(self: LinearResourceFacts, type_info: Type) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE key = linearResourceFacts__fact_key(type_info);
    IF !(rtoc_self_view.known.contains?(key)) THEN
      panic("missing linear-resource fact for {} (type absent from post-annotation inventory)");
    END
    RETURN rtoc_self_view.linear.contains?(key);
}
END
FN linearResourceFacts__fact_key(type_info: Type) RETURNS String ->
  RETURN regexReplaceFirst(type__semantic_type_key(type_info), "\\|loc=[^|]+", "|loc=any");
END
PRIVATE FN linearResourceFacts__resource_seed_and_dependencies(type_info: Type, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Tuple<Bool, []Type> ->
  IF type__resource?(type_info) THEN
    RETURN CAST(Tuple{TRUE, List[]} AS Tuple<Bool, []Type>);
  END
  IF type__optional?(type_info) THEN
    MUTABLE wrapped: ?Type = TRY (type__wrapped_type(type_info));
    IF wrapped EXISTS AS wrapped_value THEN
      RETURN CAST(Tuple{FALSE, [wrapped_value]} AS Tuple<Bool, []Type>);
    ELSE
      RETURN CAST(Tuple{FALSE, List[]} AS Tuple<Bool, []Type>);
    END
  END
  IF type__error_union?(type_info) THEN
    RETURN CAST(Tuple{FALSE, [TRY (type__success_type(type_info))]} AS Tuple<Bool, []Type>);
  END
  IF type__tuple?(type_info) THEN
    RETURN CAST(Tuple{FALSE, TRY (type__generic_args(type_info))} AS Tuple<Bool, []Type>);
  END
  IF type__map?(type_info) THEN
    RETURN CAST(Tuple{FALSE, CAST(Tuple{TRY (type__key_type(type_info)), TRY (type__value_type(type_info))} AS Tuple<Bool, []Type>)} AS Tuple<Bool, []Type>);
  END
  IF (type__array?(type_info) OR type__collection?(type_info)) THEN
    MUTABLE element: ?Type = TRY (type__element_type(type_info));
    IF element EXISTS AS element_value THEN
      RETURN CAST(Tuple{FALSE, [element_value]} AS Tuple<Bool, []Type>);
    ELSE
      RETURN CAST(Tuple{FALSE, List[]} AS Tuple<Bool, []Type>);
    END
  END
  MUTABLE schema: ?TypeSchemaLookupResult = schema_lookup(type__resolved(type_info));
  IF ((schema == NIL) AND type__generic_instance?(type_info)) THEN
    schema = schema_lookup(type__generic_base(type_info));
  END
  IF schema? IS_A ResourceSchema AS resource_schema THEN
    RETURN CAST(Tuple{TRUE, List[]} AS Tuple<Bool, []Type>);
  END
  MUTABLE dependencies: []Type = ( { MUTABLE rtoc_empty_list_3: []Type = List[]; rtoc_empty_list_3 } );
  IF schema? IS_A StructSchema AS struct_schema THEN
    struct_schema.fields.keys() |> EACH {
  MUTABLE field: StructField = (struct_schema.fields[_] OR_ELSE CAST(panic("missing hash key") AS StructField));
    IF !(structField__borrowed(field)) THEN
      &dependencies.append(CAST(TRY (lifecycleRegistry__concrete_schema_type(type_info, TypeTypeInput{ Type: COPY structField__type(field) }, struct_schema.type_params)) AS Type));
    END
    };
  ELSE_IF schema? IS_A UnionSchema AS union_schema THEN
    FOR variant_slot IN union_schema.variants.values() DO
    IF variant_slot EXISTS AS variant_value THEN
    IF variant_value IS_A InlineStructVariant AS inline_variant THEN
      FOR _ IN inline_variant.fields.values() DO
      &dependencies.append(CAST(TRY (lifecycleRegistry__concrete_schema_type(type_info, _, union_schema.type_params)) AS Type));
      END
    ELSE
      # The variant slot is the union the schema stores; concrete_schema_type
      # takes a TypeTypeInput, so map the arms that carry one.
      MUTABLE variant_input: ?TypeTypeInput = NIL;
      IF variant_value IS_A Type AS variant_type THEN
        variant_input = TypeTypeInput{ Type: COPY variant_type };
      ELSE_IF variant_value IS_A FunctionType AS variant_fn THEN
        variant_input = TypeTypeInput{ FunctionType: COPY variant_fn };
      ELSE_IF variant_value IS_A String@symbol AS variant_symbol THEN
        variant_input = TypeTypeInput{ SymbolValue: COPY variant_symbol };
      END
      IF variant_input EXISTS AS variant_input_value THEN
        &dependencies.append(CAST(TRY (lifecycleRegistry__concrete_schema_type(type_info, variant_input_value, union_schema.type_params)) AS Type));
      END
    END
    END
    END
  END
  RETURN CAST(Tuple{FALSE, dependencies} AS Tuple<Bool, []Type>);
END
FN linearResourceFacts__new(known: {String}Bool, linear: {String}Bool) RETURNS LinearResourceFacts@multiowned ->
  MUTABLE self = LinearResourceFacts{ known: {}, linear: {} };
  linearResourceFacts__initialize(&self, known, linear);
  RETURN self @multiowned;
END
PUB STRUCT LifecyclePlan {
  type_key: String,
  drop_strategy: String@symbol,
  copy_strategy: String@symbol,
  resource_close_plan: ?ResourceClosePlan
}

FN lifecyclePlan__needs_drop?(self: LifecyclePlan) RETURNS Bool ->
  RETURN (self.drop_strategy != :none);
END
FN lifecyclePlan__copyable?(self: LifecyclePlan) RETURNS Bool ->
  RETURN (self.copy_strategy != :forbidden);
END
FN lifecyclePlanner__plan(type_info: Type, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, linear_resource_facts: ?LinearResourceFacts = NIL) RETURNS !LifecyclePlan ->
  MUTABLE resource_facts = (linear_resource_facts OR_ELSE linearResourceFacts__build_types([type_info], schema_lookup));
  MUTABLE type_key = type__lifecycle_type_key(type_info);
  IF ((type__symbol?(type_info) OR type__id_handle?(type_info)) OR TRY (type__c_array_view?(type_info))) THEN
    RETURN LifecyclePlan{ type_key: COPY type_key, drop_strategy: :none, copy_strategy: :bit_copy, resource_close_plan: NIL };
  END
  IF (type__borrowed_reference?(type_info) OR type__rodata?(type_info)) THEN
    MUTABLE copy =     IF TRY (linearResourceFacts__contains?(resource_facts, type_info)) THEN
      :forbidden
    ELSE_IF TRY (type__any_rc?(type_info)) THEN
      :retain
    ELSE_IF (TRY (type__string?(type_info)) OR TRY (type__recursive_cleanup_shape?(type_info, schema_lookup))) THEN
      :deep_clone
    ELSE
      :bit_copy
    END;
    RETURN LifecyclePlan{ type_key: COPY type_key, drop_strategy: :none, copy_strategy: COPY copy, resource_close_plan: NIL };
  END
  IF TRY (type__any_rc?(type_info)) THEN
    RETURN LifecyclePlan{ type_key: COPY type_key, drop_strategy: :release, copy_strategy: :retain, resource_close_plan: NIL };
  END
  IF TRY (type__split_open_stream?(type_info)) THEN
    RETURN LifecyclePlan{ type_key: COPY type_key, drop_strategy: :semantic, copy_strategy: :retain, resource_close_plan: NIL };
  END
  MUTABLE close = TRY (type__resolve_resource_close(type_info, schema_lookup));
  IF close.is_resource THEN
    RETURN LifecyclePlan{ type_key: COPY type_key, drop_strategy: :resource_close, copy_strategy: :forbidden, resource_close_plan: COPY CAST(close.close_plan AS ?ResourceClosePlan) };
  END
  IF TRY (linearResourceFacts__contains?(resource_facts, type_info)) THEN
    RETURN LifecyclePlan{ type_key: COPY type_key, drop_strategy: :semantic, copy_strategy: :forbidden, resource_close_plan: NIL };
  END
  IF ((type__any_sync?(type_info) OR type__frozen?(type_info)) OR type__link?(type_info)) THEN
    RETURN LifecyclePlan{ type_key: COPY type_key, drop_strategy: :semantic, copy_strategy: :deep_clone, resource_close_plan: NIL };
  END
  IF lifecyclePlanner__generic_parameter?(type_info, schema_lookup) THEN
    RETURN LifecyclePlan{ type_key: COPY type_key, drop_strategy: :generic, copy_strategy: :generic, resource_close_plan: NIL };
  END
  IF (TRY (type__string?(type_info)) OR TRY (type__recursive_cleanup_shape?(type_info, schema_lookup))) THEN
    RETURN LifecyclePlan{ type_key: COPY type_key, drop_strategy: :semantic, copy_strategy: :deep_clone, resource_close_plan: NIL };
  END
  RETURN LifecyclePlan{ type_key: COPY type_key, drop_strategy: :none, copy_strategy: :bit_copy, resource_close_plan: NIL };
END
FN lifecyclePlanner__monomorphic_carrier_key(type_info: Type) RETURNS String ->
  RETURN "MONOMORPHIC ${type__resolved(type_info)}";
END
FN lifecyclePlanner__monomorphic_carrier_plan(type_info: Type) RETURNS LifecyclePlan ->
  RETURN LifecyclePlan{ type_key: COPY lifecyclePlanner__monomorphic_carrier_key(type_info), drop_strategy: :release, copy_strategy: :retain, resource_close_plan: NIL };
END
FN lifecyclePlanner__plan_binding(type_info: Type, node: Locatable, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult, linear_resource_facts: ?LinearResourceFacts = NIL) RETURNS !LifecyclePlan ->
  MUTABLE base = TRY (lifecyclePlanner__plan(type_info, schema_lookup, linear_resource_facts));
  IF !(lifecyclePlanner__mutable_owned_string_binding?(type_info, node)) THEN
    RETURN base;
  END
  RETURN LifecyclePlan{ type_key: "${type__lifecycle_type_key(type_info)}|binding=mutable-owned", drop_strategy: :semantic, copy_strategy: :deep_clone, resource_close_plan: NIL };
END
PRIVATE FN lifecyclePlanner__generic_parameter?(type_info: Type, schema_lookup: FN(String@symbol) -> ?TypeSchemaLookupResult) RETURNS !Bool EFFECTS REENTRANT ->
  IF type__projection?(type_info) THEN
    RETURN TRUE;
  END
  IF type__generic_instance?(type_info) THEN
    RETURN (TRY (type__generic_args(type_info))) |> ANY lifecyclePlanner__generic_parameter?(_, schema_lookup);
  END
  MUTABLE wrapped: ?Type = TRY (type__wrapped_type(type_info));
  IF wrapped EXISTS AS wrapped_value THEN
    RETURN lifecyclePlanner__generic_parameter?(wrapped_value, schema_lookup);
  END
  MUTABLE name = COPY CAST(type__resolved(type_info) AS String);
  RETURN (regexMatch?(name, "\\A[A-Z]\\z") AND ((schema_lookup(type__resolved(type_info))) == NIL));
END
