xpr AS item -> symbol_branch_value = COPY item.symbol;, Locatable.MatchStatement AS item -> symbol_branch_value = COPY item.symbol;, Locatable.ForRange AS item -> symbol_branch_value = COPY item.symbol;, Locatable.ForEach AS item -> symbol_branch_value = COPY item.symbol;, Locatable.TestBlock AS item -> symbol_branch_value = COPY item.symbol;, Locatable.WhenBlock AS item -> symbol_branch_value = COPY item.symbol;, Locatable.LetBinding AS item -> symbol_branch_value = COPY item.symbol;, Locatable.TestThat AS item -> symbol_branch_value = COPY item.symbol;, Locatable.AssertRaises AS item -> symbol_branch_value = COPY item.symbol;, Locatable.BenchmarkStmt AS item -> symbol_branch_value = COPY item.symbol;, Locatable.SmashStmt AS item -> symbol_branch_value = COPY item.symbol;, Locatable.ProfileStmt AS item -> symbol_branch_value = COPY item.symbol;, Locatable.StubDecl AS item -> symbol_branch_value = COPY item.symbol;, Locatable.Drop AS item -> symbol_branch_value = COPY item.symbol;, Locatable.SuppressCleanup AS item -> symbol_branch_value = COPY item.symbol;, Locatable.Return AS item -> symbol_branch_value = COPY item.symbol;, Locatable.ReassignCleanup AS item -> symbol_branch_value = COPY item.symbol;, Locatable.FieldCleanup AS item -> symbol_branch_value = COPY item.symbol; END
    ELSE
      symbol_branch_value = NIL;
    END
    MUTABLE symbol: ?SymbolEntry = symbol_branch_value;
    IF (symbol != NIL) THEN
      RETURN symbolEntry__semantic_place_id(symbol);
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN lifecycleRegistry__add_type_mut(MUTABLE types: {String}Type, type_info: Type) RETURNS !Void EFFECTS REENTRANT ->
  MUTABLE key = type__lifecycle_type_key(type_info);
  IF types.contains?(key) THEN
    RETURN;
  END
  types[key] = COPY type_info;
  FOR _ IN (TRY (typeExpressionTree__direct_children(type_info.shape.expression))) DO
  TRY (lifecycleRegistry__add_type_mut(&types, TRY (type__from_child_expression(_))));
  END
  FOR _ IN (TRY (type__generic_args(type_info))) DO
  TRY (lifecycleRegistry__add_type_mut(&types, _));
  END
  MUTABLE wrapped: ?Type = TRY (type__wrapped_type(type_info));
  IF wrapped EXISTS AS wrapped_value THEN
    MUTABLE wrapped_value_mutable = COPY wrapped_value;
    TRY (lifecycleRegistry__add_type_mut(&types, wrapped_value_mutable));
  END
  MUTABLE element: ?Type = TRY (type__element_type(type_info));
  IF element EXISTS AS element_value THEN
    MUTABLE element_value_mutable = COPY element_value;
    TRY (lifecycleRegistry__add_type_mut(&types, element_value_mutable));
  END
  IF type__map?(type_info) THEN
    TRY (lifecycleRegistry__add_type_mut(&types, TRY (type__key_type(type_info))));
  END
  IF type__map?(type_info) THEN
    TRY (lifecycleRegistry__add_type_mut(&types, TRY (type__value_type(type_info))));
  END
END
