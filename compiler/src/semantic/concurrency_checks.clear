REQUIRE "../ast/type.clear"
REQUIRE "../ast/ast.clear"
REQUIRE "../annotator/phases/body_analysis.clear"
REQUIRE "capability_plan.clear"
REQUIRE "../annotator/helpers/function_signature.clear"
REQUIRE "../annotator.clear"
REQUIRE "../annotator/annotator.clear"
REQUIRE "../ast/lexer.clear"
REQUIRE "../ast/param.clear"
# Ruby module ConcurrencyChecks
UNION SigLookupReturn { FunctionSignatureMultiowned: FunctionSignature@multiowned, TypeMultiowned: Type@multiowned, Type: Type }
PUB FN concurrencyChecks__check_all_mut(fn_nodes: {String}FunctionDef, sig_lookup: FN(String) -> ?SigLookupReturn, error_handler: FN(Locatable, String) -> Void, body_summaries: {String}FunctionBodySummary, lock_ranks: {String@symbol}Int64) RETURNS !Void ->
  FOR _ IN fn_nodes.values() DO
  IF !(_.body) THEN
    CONTINUE;
  END
  MUTABLE summary = COPY body_summaries[_.name]?;
  MUTABLE with_blocks: []WithBlock@multiowned = COPY summary.with_blocks;
  MUTABLE with_scope_nodes = COPY summary.with_scope_nodes;
  TRY (concurrencyChecks__check_hold_across_yield_mut(_, with_blocks, with_scope_nodes, fn_nodes, error_handler));
  TRY (concurrencyChecks__check_naked_nested_with_mut(with_blocks, with_scope_nodes, error_handler, lock_ranks));
  TRY (concurrencyChecks__check_reentrant_mut(_, with_blocks, with_scope_nodes, sig_lookup, error_handler));
  END
END
PRIVATE FN concurrencyChecks__check_hold_across_yield_mut(fn_value: FunctionDef, with_blocks: []WithBlock, with_scope_nodes: {Int64}[]Locatable, fn_nodes: {String}FunctionDef, error_handler: FN(Locatable, String) -> Void) RETURNS !Void ->
  concurrencyChecks__each_with_scope(with_blocks, with_scope_nodes, %(with_block: WithBlock@multiowned, scope: []Locatable) USE(error_handler, fn_nodes) -> {
  IF (TRY (concurrencyChecks__lock_holding_names(CAST(COPY with_block AS WithBlock)))).empty?() THEN
      RETURN;
  END
  MUTABLE rtoc_with_line: Int64 = with_block.token.line;
  FOR rtoc_node IN scope DO
      MUTABLE offender_token: ?Token = NIL;
      MUTABLE reason: String = COPY "";
      IF rtoc_node IS_A BgBlock THEN
          offender_token = locatable__token(rtoc_node);
          reason = COPY "BG";
      ELSE_IF rtoc_node IS_A NextExpr AS next_expr THEN
          offender_token = COPY next_expr.token;
          reason = COPY "NEXT";
      ELSE_IF rtoc_node IS_A FuncCall AS func_call THEN
          IF fn_nodes[CAST(funcCall__name(func_call) AS String)] EXISTS AS callee_value THEN
            IF callee_value.effects.contains?(symbol("YIELD")) THEN
              offender_token = COPY func_call.token;
              reason = COPY "call to '${CAST(funcCall__name(func_call) AS String)}' which yields";
            END
          END
      END
      IF offender_token EXISTS AS rtoc_offender THEN
        MUTABLE rtoc_offender_line: Int64 = rtoc_offender.line;
        error_handler(rtoc_node, COPY "Hold-lock-across-yield: ${reason} at line ${rtoc_offender_line.toString()} executes inside the WITH at line ${rtoc_with_line.toString()}, while a lock is held. Move the suspending operation outside the WITH, or restructure so the lock is released before suspension.");
      END
  END
  rubyToClearVoid__concurrency_checks()
  });
END
PRIVATE FN concurrencyChecks__check_naked_nested_with_mut(with_blocks: []WithBlock, with_scope_nodes: {Int64}[]Locatable, error_handler: FN(Locatable, String) -> Void, lock_ranks: {String@symbol}Int64) RETURNS !Void ->
  concurrencyChecks__each_with_scope(with_blocks, with_scope_nodes, %(outer: WithBlock@multiowned, outer_scope: []Locatable) USE(error_handler, lock_ranks) -> {
  MUTABLE outer_lock_names = TRY (concurrencyChecks__lock_holding_names(CAST(COPY outer AS WithBlock)));
  IF outer_lock_names.empty?() THEN
      RETURN;
  END
  IF TRY (concurrencyChecks__any_lock_rank?(CAST(COPY outer AS WithBlock), lock_ranks)) THEN
      RETURN;
  END
  MUTABLE rtoc_idx = 0;
  WHILE rtoc_idx < outer_scope.length() DO
      IF !(outer_scope[rtoc_idx]? IS_A WithBlock) THEN
        rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE inner = COPY outer_scope[rtoc_idx]?;
      MUTABLE inner_lock_names = TRY (concurrencyChecks__lock_holding_names(castLocatableToWithBlock(inner)));
      IF inner_lock_names.empty?() THEN
          RETURN;
      END
      IF TRY (concurrencyChecks__any_lock_rank?(castLocatableToWithBlock(inner), lock_ranks)) THEN
          RETURN;
      END
      MUTABLE names: [Set]String = inner_lock_names.difference(outer_lock_names);
      IF names.empty?() THEN
          RETURN;
      END
      MUTABLE rtoc_all_names: [Set]String = COPY outer_lock_names;
      &rtoc_all_names.merge(names);
      MUTABLE suggested_names: []String = rtoc_all_names |> SELECT COPY _;
      error_handler(inner, "Naked nested WITH on a different binding (${((names |> SELECT COPY _)).join(", ")}) while ${(outer_lock_names |> SELECT COPY _).join(", ")} is held \u{2014} symmetric callers may deadlock. Use the multi-resource form for safe ordering:\n    WITH EXCLUSIVE ${suggested_names.join(", ")} AS (${(suggested_names |> SELECT ("i_" $+ _)).join(", ")}) { ... }");
    rtoc_idx = rtoc_idx + 1;
  END
  rubyToClearVoid__concurrency_checks()
  });
END
PRIVATE FN concurrencyChecks__any_lock_rank?(with_block: WithBlock, lock_ranks: {String@symbol}Int64) RETURNS !Bool ->
  IF (lock_ranks.count() == 0) THEN
    RETURN FALSE;
  END
  RETURN (TRY (withCapabilityPlan__locks((TRY (capabilityPlan__require_for(with_block)))))) |> ANY {
  MUTABLE identity: ?String@symbol = capabilityTransition__lock_identity(_);
  ((identity != NIL) AND lock_ranks.contains?(identity))
  };
END
PRIVATE FN concurrencyChecks__lock_holding_names(with_block: WithBlock) RETURNS ![Set]String ->
  MUTABLE out: [Set]String = Set[];
  FOR _ IN (TRY (withCapabilityPlan__locks((TRY (capabilityPlan__require_for(with_block)))))) DO
  &out.insert(COPY _.var_name);
  END
  RETURN out;
END
PRIVATE FN concurrencyChecks__check_reentrant_mut(fn_value: FunctionDef, with_blocks: []WithBlock, with_scope_nodes: {Int64}[]Locatable, sig_lookup: FN(String) -> ?SigLookupReturn, error_handler: FN(Locatable, String) -> Void) RETURNS !Void ->
  concurrencyChecks__each_with_scope(with_blocks, with_scope_nodes, %(with_block: WithBlock@multiowned, scope: []Locatable) USE(error_handler, fn_value, sig_lookup) -> {
  MUTABLE held_params = TRY (concurrencyChecks__collect_held_params(CAST(COPY with_block AS WithBlock), fn_value));
  IF held_params.empty?() THEN
      RETURN;
  END
  FOR rtoc_scope_node IN scope DO
    IF rtoc_scope_node IS_A FuncCall AS rtoc_call THEN
      concurrencyChecks__report_reentrant_call_mut(rtoc_call, sig_lookup, held_params, CAST(COPY with_block AS WithBlock), error_handler);
    END
  END
  rubyToClearVoid__concurrency_checks()
  });
END

# Ruby leaves each parameter with `next`; a CLEAR loop cannot, so the per-call
# report lives in its own function.
PRIVATE FN concurrencyChecks__report_reentrant_call_mut(call: FuncCall, sig_lookup: FN(String) -> ?SigLookupReturn, held_params: [Set]String, with_block: WithBlock, error_handler: FN(Locatable, String) -> Void) RETURNS Void ->
  MUTABLE rtoc_call_name: String = COPY CAST(funcCall__name(call) AS String);
  MUTABLE sig: ?FunctionSignature@multiowned = functionSignature__unwrap(castOptionalSigLookupReturnToOptionalX(sig_lookup(rtoc_call_name)));
  IF (sig == NIL) THEN
    RETURN;
  END
  MUTABLE rtoc_requires: {String}[Set]String@symbol = (functionSignature__requires(sig) OR_ELSE {});
  IF rtoc_requires.empty?() THEN
    RETURN;
  END
  MUTABLE rtoc_with_line: Int64 = with_block.token.line;
  MUTABLE rtoc_params: []Param = (functionSignature__params(sig) OR_ELSE List[]);
  MUTABLE rtoc_idx: Int64 = 0;
  WHILE rtoc_idx < rtoc_params.length() DO
    MUTABLE pname: String = COPY CAST(UNWRAP (rtoc_params[rtoc_idx]).name AS String);
    IF rtoc_requires[pname] EXISTS AS rtoc_families THEN
      IF call.args[rtoc_idx] EXISTS AS arg THEN
        IF aST__node_name(arg) EXISTS AS arg_name THEN
          IF held_params.contains?(CAST(arg_name AS String)) THEN
            MUTABLE rtoc_family_text: String = COPY (rtoc_families |> SELECT COPY _).join(" | ");
            error_handler(Locatable{ FuncCall: COPY call }, COPY "Reentrant lock acquisition: '${rtoc_call_name}' has REQUIRES '${pname}: ${rtoc_family_text}' and is called with '${CAST(arg_name AS String)}', which is already held by the WITH at line ${rtoc_with_line.toString()}. Pass the unwrapped inner alias instead of the wrapped binding.");
          END
        END
      END
    END
    rtoc_idx = rtoc_idx + 1;
  END
END
FN concurrencyChecks__each_with_scope(with_blocks: []WithBlock, with_scope_nodes: {Int64}[]Locatable, blk: FN(WithBlock, Locatable[]) -> Void) RETURNS Void ->
  FOR _ IN with_blocks DO
  blk(_, with_scope_nodes[aST__node_identity(Locatable{ WithBlock: COPY _ })]?);
  END
END
PRIVATE FN concurrencyChecks__collect_held_params(with_block: WithBlock, fn_value: FunctionDef) RETURNS ![Set]String ->
  MUTABLE param_names = (fn_value.params |> SELECT CAST(_.name AS String)) |> DISTINCT _;
  MUTABLE out: [Set]String = Set[];
  FOR _ IN (TRY (withCapabilityPlan__locks((TRY (capabilityPlan__require_for(with_block)))))) DO
  MUTABLE n = COPY _.var_name;
  IF param_names.contains?(n) THEN
      &out.insert(n);
  END
  END
  RETURN out;
END
# End Ruby module ConcurrencyChecks
FN castLocatableToWithBlock(value: Locatable) RETURNS WithBlock ->
  IF value IS_A WithBlock AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to WithBlock");
END
FN castOptionalSigLookupReturnToOptionalX(value: ?SigLookupReturn) RETURNS ?X ->
  IF value == NIL THEN
    panic("Invalid cast to ?X");
  END
  PARTIAL MATCH value START
    SigLookupReturn.FunctionSignatureMultiowned AS cast_payload -> RETURN X{ FunctionSignatureMultiowned: COPY cast_payload };,
    SigLookupReturn.Type AS cast_payload -> RETURN X{ Type: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to ?X");
  END
  panic("Invalid cast to ?X");
END
FN rubyToClearVoid__concurrency_checks() RETURNS Void ->
  RETURN;
END
