REQUIRE "pkg:rtoc_6173742f747970652e636c656172"
REQUIRE "pkg:rtoc_6173742f6173742e636c656172"
REQUIRE "pkg:rtoc_6d69722f6d69722e636c656172"
PUB UNION PassStateProgram { MIRProgram: MIRProgram, RequireNode: RequireNode, ProtocolRequirement: ProtocolRequirement, ProtocolDef: ProtocolDef, FunctionDef: FunctionDef, ImplementationDef: ImplementationDef, ConformanceDef: ConformanceDef, MIRStructDef: MIRStructDef, VarDecl: VarDecl, Assignment: Assignment, MIRDestructureTarget: MIRDestructureTarget, DestructuringAssignment: DestructuringAssignment, BindExpr: BindExpr, BinaryOp: BinaryOp, IsA: IsA, MIRUnaryOp: MIRUnaryOp, CallSiteOverride: CallSiteOverride, Identifier: Identifier, Literal: Literal, ListLit: ListLit, TupleLit: TupleLit, DefaultArrayLit: DefaultArrayLit, HashLit: HashLit, DefaultLit: DefaultLit, StructLit: StructLit, LambdaLit: LambdaLit, IfStatement: IfStatement, IfBind: IfBind, WhileLoop: WhileLoop, WhileBindLoop: WhileBindLoop, BreakNode: BreakNode, ContinueNode: ContinueNode, FuncCall: FuncCall, MIRMethodCall: MIRMethodCall, GetField: GetField, GetIndex: GetIndex, MIRCast: MIRCast, ReturnNode: ReturnNode, Assert: Assert, Raise: Raise, ThrowNode: ThrowNode, DieNode: DieNode, Slice: Slice, Require: Require, MIRDeferStmt: MIRDeferStmt, WithBlock: WithBlock, SyncPolicyDecl: SyncPolicyDecl, SelectOp: SelectOp, WhereOp: WhereOp, IndexOp: IndexOp, ReduceOp: ReduceOp, OrderByOp: OrderByOp, LimitOp: LimitOp, UnnestOp: UnnestOp, DistinctOp: DistinctOp, EachOp: EachOp, TapOp: TapOp, SkipOp: SkipOp, CollectOp: CollectOp, TakeWhileOp: TakeWhileOp, WindowOp: WindowOp, BatchWindowOp: BatchWindowOp, JoinOp: JoinOp, FindOp: FindOp, AnyOp: AnyOp, AllOp: AllOp, CountOp: CountOp, SumOp: SumOp, AverageOp: AverageOp, MinOp: MinOp, MaxOp: MaxOp, ShardOp: ShardOp, ConcurrentOp: ConcurrentOp, Placeholder: Placeholder, Copy: Copy, MIROptionalUnwrap: MIROptionalUnwrap, TenseNavigation: TenseNavigation, MutableBorrow: MutableBorrow, OrElseRaise: OrElseRaise, OrElseExit: OrElseExit, OrElsePass: OrElsePass, OrElsePrune: OrElsePrune, OrElseBreak: OrElseBreak, CatchBlock: CatchBlock, RecoverOp: RecoverOp, MIRBlockExpr: MIRBlockExpr, StringConcat: StringConcat, CapabilityWrap: CapabilityWrap, MoveNode: MoveNode, CopyNode: CopyNode, KeepNode: KeepNode, ShareNode: ShareNode, LinkNode: LinkNode, ResolveNode: ResolveNode, FreezeNode: FreezeNode, PassStmt: PassStmt, StructPattern: StructPattern, MIRRangeLit: MIRRangeLit, ExternFnDecl: ExternFnDecl, ExternStructDecl: ExternStructDecl, MIREnumDef: MIREnumDef, UnionDef: UnionDef, UnionVariantLit: UnionVariantLit, StaticCall: StaticCall, MIRDoBlock: MIRDoBlock, MIRBgBlock: MIRBgBlock, ThenChain: ThenChain, BgStreamBlock: BgStreamBlock, YieldExpr: YieldExpr, CloseStream: CloseStream, NextExpr: NextExpr, MatchStatement: MatchStatement, ForRange: ForRange, ForEach: ForEach, TestBlock: TestBlock, WhenBlock: WhenBlock, LetBinding: LetBinding, TestThat: TestThat, AssertRaises: AssertRaises, BenchmarkStmt: BenchmarkStmt, SmashStmt: SmashStmt, ProfileStmt: ProfileStmt, StubDecl: StubDecl, Drop: Drop, SuppressCleanup: SuppressCleanup, Return: Return, ReassignCleanup: ReassignCleanup, FieldCleanup: FieldCleanup, Emittable: Emittable, Program: Program }
PUB STRUCT MIRPassState {
  completed: [Set]String@symbol
}

PUB STRUCT StageSpec {
  name: String@symbol,
  producer: String,
  requires: ?String@symbol
}
stages: [12]StageSpec = [StageSpec{ name: :annotated, producer: "SemanticAnnotator", requires: NIL }, StageSpec{ name: :pipeline_rewritten, producer: "PipelineRewriter", requires: :annotated }, StageSpec{ name: :string_concat_rewritten, producer: "StringConcatRewriter", requires: :pipeline_rewritten }, StageSpec{ name: :hoisted, producer: "Hoist", requires: :string_concat_rewritten }, StageSpec{ name: :premir_type_checked, producer: "PreMirTypeCheck", requires: :hoisted }, StageSpec{ name: :escape_analyzed, producer: "MIRPass/EscapeAnalysis", requires: :premir_type_checked }, StageSpec{ name: :cleanup_classified, producer: "MIRPass/CleanupClassifier", requires: :escape_analyzed }, StageSpec{ name: :loop_frame_analyzed, producer: "MIRPass/LoopFrameAnalysis", requires: :cleanup_classified }, StageSpec{ name: :needs_rt_finalized, producer: "MIRPass#finalize_needs_rt!", requires: :loop_frame_analyzed }, StageSpec{ name: :mir_pass_complete, producer: "MIRPass", requires: :needs_rt_finalized }, StageSpec{ name: :mir_lowered, producer: "MIRLowering", requires: :mir_pass_complete }, StageSpec{ name: :mir_checked, producer: "MIRChecker", requires: :mir_lowered }];
PUB FN mIRPassState__initialize(MUTABLE self: MIRPassState) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.completed = Set[];
}
END
PUB FN mIRPassState__mark_mut(MUTABLE self: MIRPassState, stage: String@symbol) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE spec = TRY (mIRPassState__stage_spec_mut(rtoc_self_view, stage));
    IF rtoc_self_view.completed.contains?(stage) THEN
      RAISE Input, MIRPassOrderError, "{} attempted to mark {} twice";
    END
    MUTABLE expected: ?String@symbol = mIRPassState__next_unmarked_stage(rtoc_self_view);
    IF !((stage == expected)) THEN
      RAISE Input, MIRPassOrderError, "{}{}";
    END
    &rtoc_self_view.completed.insert(COPY stage);
}
END
PUB FN mIRPassState__require_mut(self: MIRPassState, stage: String@symbol, consumer: String) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    TRY (mIRPassState__stage_spec_mut(rtoc_self_view, stage));
    IF rtoc_self_view.completed.contains?(stage) THEN
      RETURN;
    END
    RAISE Input, MIRPassOrderError, "{} requires {}; completed stages: {}";
}
END
PRIVATE FN mIRPassState__completed_stages(self: MIRPassState) RETURNS ![]String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE done: []String@symbol = [];
    FOR stage IN stages DO
      IF rtoc_self_view.completed.contains?(stage.name) THEN
        &done.append(COPY stage.name);
      END
    END
    RETURN done;
}
END
PUB FN mIRPassState__copy(self: MIRPassState) RETURNS MIRPassState@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE state = mIRPassState__new();
    FOR _ IN rtoc_self_view.completed DO
    &state.completed.insert(COPY _);
    END
    RETURN state;
}
END
# Ruby asks `program.respond_to?(:mir_pass_state)`; Program is the only node
# that carries the state, so the answer is a narrowing.
PUB FN mIRPassState__for_mut(MUTABLE program: PassStateProgram) RETURNS MIRPassState@multiowned ->
  IF program IS_A Program AS program_node THEN
    MUTABLE program_mutable = COPY program_node;
    IF program_mutable.mir_pass_state EXISTS AS existing THEN
      IF existing IS_A MIRPassState AS existing_state THEN
        RETURN COPY existing_state @multiowned;
      END
    END
    MUTABLE fresh = mIRPassState__new();
    program_mutable.mir_pass_state = PassStateValue{ MIRPassState: COPY fresh };
    RETURN fresh;
  END
  RETURN mIRPassState__new();
END
PUB FN mIRPassState__class_require_mut(program: PassStateProgram, stage: String@symbol, consumer: String) RETURNS !Void EFFECTS REENTRANT ->
  IF program IS_A Program AS program_node THEN
    IF program_node.mir_pass_state EXISTS AS carried THEN
      IF carried IS_A MIRPassState AS state THEN
        MUTABLE state_mutable = COPY state;
        TRY (mIRPassState__require_mut(state_mutable, stage, consumer));
        RETURN;
      END
    END
  END
  RAISE Input, MIRPassOrderError, "{} requires pass state; program was not produced by the MIR pipeline";
END
PUB FN mIRPassState__validate_stage_mut(self: MIRPassState, stage: String@symbol) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    FOR spec IN stages DO
      IF (spec.name == stage) THEN
        RETURN;
      END
    END
    RAISE Input, MIRPassOrderError, "unknown MIR pass stage {}";
}
END
PRIVATE FN mIRPassState__stage_spec_mut(self: MIRPassState, stage: String@symbol) RETURNS !StageSpec
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    FOR spec IN stages DO
      IF (spec.name == stage) THEN
        RETURN COPY spec;
      END
    END
    RAISE Input, MIRPassOrderError, "unknown MIR pass stage {}";
}
END
PRIVATE FN mIRPassState__next_unmarked_stage(self: MIRPassState) RETURNS ?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    FOR spec IN stages DO
      IF !(rtoc_self_view.completed.contains?(spec.name)) THEN
        RETURN COPY spec.name;
      END
    END
    RETURN NIL;
}
END
PUB FN mIRPassState__new() RETURNS MIRPassState@multiowned ->
  MUTABLE self = MIRPassState{ completed: Set[] };
  mIRPassState__initialize(&self);
  RETURN self @multiowned;
END
