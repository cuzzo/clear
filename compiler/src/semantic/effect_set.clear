PUB STRUCT EffectSet {
  effects: [Set]String@symbol
}

effect_order: [10]String@symbol = [:yield, :alloc_heap, :io, :fail, :contention, :contends_maybe, symbol("contention?"), :blocking, :blocks_maybe, symbol("blocking?")];
FN effectSet__initialize(MUTABLE self: EffectSet, effects_value: ?[Set]String@symbol = NIL) RETURNS !Void ->
    MUTABLE eff: [Set]String@symbol = Set[];
    IF effects_value EXISTS AS effects_present THEN
      eff = COPY effects_present;
    ELSE
      eff = Set[];
    END
    FOR _ IN eff DO
    IF !((([:yield, :alloc_heap, :io, :fail, :contention, :blocking, :contends_maybe, :blocks_maybe, symbol("contention?"), symbol("blocking?")]) |> DISTINCT _).contains?(_)) THEN
      panic("Unknown effect: {}. Valid: {}");
    END
    END
    self.effects = eff;
END
PUB FN effectSet__include?(self: EffectSet, effect: String@symbol) RETURNS Bool
  EFFECTS REENTRANT ->
    RETURN self.effects.contains?(effect);
END
PUB FN effectSet__empty?(self: EffectSet) RETURNS Bool
  EFFECTS REENTRANT ->
    RETURN self.effects.empty?();
END
PUB FN effectSet__union(self: EffectSet, other: EffectSet) RETURNS !EffectSet@multiowned ->
    RETURN TRY (effectSet__new(ruby_set_union_String_symbol_set(self.effects, other.effects)));
END
PUB FN effectSet__equals?(self: EffectSet, other: EffectSet) RETURNS Bool
  EFFECTS REENTRANT ->
    RETURN (TRUE AND (self.effects == other.effects));
END
FN effectSet__eql?(self: EffectSet, other: EffectSet) RETURNS Bool ->
  effectSet__equals?(self, other);
END
PUB FN effectSet__hash(self: EffectSet) RETURNS Int64 ->
    MUTABLE value = 0;
    IF self.effects.contains?(:yield) THEN
      value = (value BIT_OR 1);
    END
    IF self.effects.contains?(:alloc_heap) THEN
      value = (value BIT_OR 2);
    END
    IF self.effects.contains?(:io) THEN
      value = (value BIT_OR 4);
    END
    IF self.effects.contains?(:fail) THEN
      value = (value BIT_OR 8);
    END
    IF self.effects.contains?(:contention) THEN
      value = (value BIT_OR 16);
    END
    IF self.effects.contains?(:blocking) THEN
      value = (value BIT_OR 32);
    END
    IF self.effects.contains?(:contends_maybe) THEN
      value = (value BIT_OR 64);
    END
    IF self.effects.contains?(:blocks_maybe) THEN
      value = (value BIT_OR 128);
    END
    IF self.effects.contains?(symbol("contention?")) THEN
      value = (value BIT_OR 256);
    END
    IF self.effects.contains?(symbol("blocking?")) THEN
      value = (value BIT_OR 512);
    END
    RETURN value;
END
PUB FN effectSet__to_a(self: EffectSet) RETURNS ![]String@symbol ->
    MUTABLE ordered: []String@symbol = List[];
    FOR _ IN effect_order DO
    IF self.effects.contains?(_) THEN
      &ordered.append(COPY _);
    END
    END
    RETURN ordered;
END
PUB FN effectSet__to_s(self: EffectSet) RETURNS !String ->
    RETURN "EffectSet(${(TRY (effectSet__to_a(self))).join(", ")})";
END
PUB FN effectSet__inspect(self: EffectSet) RETURNS !String ->
    RETURN TRY (effectSet__to_s(self));
END
PUB FN effectSet__new(effects: ?[Set]String@symbol = NIL) RETURNS !EffectSet@multiowned ->
  MUTABLE self = EffectSet{ effects: Set[] };
  TRY (effectSet__initialize(&self, effects));
  RETURN self @multiowned;
END
FN ruby_set_union_String_symbol_set(left: [Set]String@symbol, right: [Set]String@symbol) RETURNS [Set]String@symbol ->
  MUTABLE result: [Set]String@symbol = COPY left;
  right |> EACH {
    IF !(result.contains?(_)) THEN
      &result.insert(COPY _);
    END
  };
  RETURN result;
END
