REQUIRE "../ast/type.clear"
REQUIRE "semantic_ids.clear"
REQUIRE "../annotator/phases/body_analysis.clear"
REQUIRE "../ast/ast.clear"
REQUIRE "../annotator.clear"
REQUIRE "../annotator/annotator.clear"
REQUIRE "../ast/symbol_entry.clear"
REQUIRE "../ast/param.clear"
# Ruby module KeepAnalysis
PUB FN keepAnalysis__propagate_kept_identity_mut(fn_nodes: {String}FunctionDef, body_summaries: {String}FunctionBodySummary) RETURNS Void ->
  MUTABLE caller_params: {String}{String}SymbolEntry@multiowned = {};
  FOR rtoc_key IN fn_nodes.keys() DO
  MUTABLE fn_value: FunctionDef = COPY UNWRAP (fn_nodes[rtoc_key]);
  MUTABLE params: {String}SymbolEntry@multiowned = {};
  FOR rtoc_param IN fn_value.params DO
    IF rtoc_param.symbol EXISTS AS entry THEN
      params[CAST(rtoc_param.name AS String)] = COPY entry;
    END
  END
  caller_params[rtoc_key] = params;
  END
  MUTABLE kept_param_indexes: {String}[]Int64 = {};
  MUTABLE refresh_kept: FN() -> Void = %() USE(fn_nodes, MUTABLE kept_param_indexes) -> {
  &kept_param_indexes.clear();
  FOR rtoc_fn_name IN fn_nodes.keys() DO
    MUTABLE fn_value: FunctionDef = COPY UNWRAP (fn_nodes[rtoc_fn_name]);
    MUTABLE indexes: []Int64 = [];
    MUTABLE rtoc_param_idx: Int64 = 0;
    WHILE rtoc_param_idx < fn_value.params.length() DO
      IF fn_value.params[rtoc_param_idx] EXISTS AS rtoc_param THEN
        IF rtoc_param.symbol EXISTS AS rtoc_param_symbol THEN
          IF (symbolEntry__kept_identity(rtoc_param_symbol) != NIL) THEN
            &indexes.append(COPY rtoc_param_idx);
          END
        END
      END
      rtoc_param_idx = rtoc_param_idx + 1;
    END
    IF !(indexes.empty?()) THEN
      kept_param_indexes[rtoc_fn_name] = COPY indexes;
    END
  END
  NIL
  };
  refresh_kept();
  FOR rtoc_counter_keep IN (0_i64 ..< fn_nodes.count()) DO
  MUTABLE changed: Bool = FALSE;
  FOR rtoc_caller_name IN body_summaries.keys() DO
    MUTABLE summary: FunctionBodySummary = COPY UNWRAP (body_summaries[rtoc_caller_name]);
    MUTABLE params: ?{String}SymbolEntry@multiowned = COPY caller_params[rtoc_caller_name];
    IF params EXISTS AS rtoc_params THEN
      IF !(rtoc_params.empty?()) THEN
        FOR rtoc_site IN summary.call_site_facts DO
          IF !(rtoc_site.fn_var_call) THEN
            IF kept_param_indexes[rtoc_site.callee_name] EXISTS AS rtoc_kept THEN
              FOR rtoc_kept_idx IN rtoc_kept DO
                IF keepAnalysis__inherit_kept_identity_mut(rtoc_site, rtoc_kept_idx, rtoc_params, fn_nodes) THEN
                  changed = TRUE;
                END
              END
            END
          END
        END
      END
    END
  END
  IF !(changed) THEN
      BREAK;
  END
  refresh_kept();
  END
END

# Ruby leaves the per-argument body with `next`; a CLEAR loop cannot, so one
# kept argument is inherited per call and `next` becomes a plain RETURN.
PRIVATE FN keepAnalysis__inherit_kept_identity_mut(site: CallSiteFact, idx: Int64, params: {String}SymbolEntry@multiowned, fn_nodes: {String}FunctionDef) RETURNS Bool ->
  IF site.args[idx] EXISTS AS arg THEN
    IF arg IS_A Identifier THEN
      IF params[(locatable__name(arg) OR_ELSE "")] EXISTS AS entry THEN
        IF (symbolEntry__kept_identity(entry) != NIL) THEN
          RETURN FALSE;
        END
        MUTABLE inherited: ?KeptIdentityContract = NIL;
        IF fn_nodes[site.callee_name] EXISTS AS rtoc_callee THEN
          IF rtoc_callee.params[idx] EXISTS AS callee_param THEN
            IF callee_param.symbol EXISTS AS rtoc_callee_symbol THEN
              inherited = COPY symbolEntry__kept_identity(rtoc_callee_symbol);
            END
          END
        END
        MUTABLE rtoc_entry: SymbolEntry@multiowned = KEEP entry;
        IF inherited EXISTS AS rtoc_inherited THEN
          symbolEntry__set_kept_identity(&rtoc_entry, rtoc_inherited);
        ELSE
          symbolEntry__set_kept_identity(&rtoc_entry, KeptIdentityContract{ family: :multiowned, sink: COPY "${site.callee_name} kept position ${idx.toString()}" });
        END
        RETURN TRUE;
      END
    END
  END
  RETURN FALSE;
END
# End Ruby module KeepAnalysis
FN rubyToClearVoid__keep_analysis() RETURNS Void ->
  RETURN;
END
