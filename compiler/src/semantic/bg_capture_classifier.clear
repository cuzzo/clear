REQUIRE "pkg:rtoc_6173742f747970652e636c656172" AS type
REQUIRE "pkg:rtoc_73656d616e7469632f636170747572655f73747261746567792e636c656172" AS capture_strategy
REQUIRE "pkg:rtoc_6173742f73636f70652e636c656172" AS scope
REQUIRE "pkg:rtoc_616e6e6f7461746f722f68656c706572732f6361706162696c69746965732e636c656172" AS capabilities
REQUIRE "pkg:rtoc_6173742f6173742e636c656172" AS ast
REQUIRE "pkg:rtoc_6173742f73796d626f6c5f656e7472792e636c656172" AS symbol_entry
# Ruby module BgCaptureClassifier
PUB FN bgCaptureClassifier__classify_all_mut(fn_nodes: {String}FunctionDef, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL) RETURNS !{String}CaptureAnalysis ->
  MUTABLE analyses: {String}CaptureAnalysis = {};
  FOR rtoc_each_key IN fn_nodes.keys() DO
  MUTABLE fn_value: FunctionDef = COPY UNWRAP (fn_nodes[rtoc_each_key]);
  IF !((IF TRUE THEN
      fn_value.body
    ELSE
      NIL
    END)) THEN
    CONTINUE;
  END
  MUTABLE live_param_syms = TRY (scope__live_param_syms(fn_value));
  # Ruby keys each analysis by `object_id`; CLEAR has no object identity for a
  # struct, so the walk order supplies the same per-function unique key.
  MUTABLE rtoc_site_ordinal: Int64 = 0;
  aST__each_capture_analysis(fn_value.body, %(MUTABLE a: CaptureAnalysis) USE(MUTABLE analyses, live_param_syms, schema_lookup, fn_value, MUTABLE rtoc_site_ordinal) -> {
    TRY (bgCaptureClassifier__classify_one_mut(&a, live_param_syms, schema_lookup));
    analyses["${fn_value.name}:${rtoc_site_ordinal.toString()}"] = COPY a;
    rtoc_site_ordinal = rtoc_site_ordinal + 1;
    rubyToClearVoid__bg_capture_classifier()
  });
  END
  RETURN analyses;
END
PUB FN bgCaptureClassifier__classify_one_mut(MUTABLE a: CaptureAnalysis, live_param_syms: {String}SymbolEntry, schema_lookup: ?FN(String@symbol) -> ?TypeSchemaLookupResult = NIL) RETURNS !?{String}Strategy ->
  FOR rtoc_inner_key IN a.capture_symbols.keys() DO
  MUTABLE ignored_entry: SymbolEntry@multiowned = COPY UNWRAP (a.capture_symbols[rtoc_inner_key]);
  MUTABLE live: ?SymbolEntry = COPY live_param_syms[rtoc_inner_key];
  IF live EXISTS AS live_value THEN
      a.capture_symbols[rtoc_inner_key] = KEEP live_value;
  END
  END
  MUTABLE site_info = CaptureSiteInfo{ copied_names: COPY a.site_copied, moved_names: COPY a.site_moved };
  MUTABLE strategies: {String}Strategy = {};
  FOR rtoc_inner_key IN a.captures.keys() DO
  MUTABLE type_obj: Type = COPY UNWRAP (a.captures[rtoc_inner_key]);
  MUTABLE sym: ?SymbolEntry@multiowned = COPY a.capture_symbols[rtoc_inner_key];
  MUTABLE t: ?Type@multiowned = TRY (bgCaptureClassifier__resolve_capture_type(type_obj, sym));
  IF !(t) THEN
      CONTINUE;
  END
  strategies[rtoc_inner_key] = TRY (captureStrategy__classify(rtoc_inner_key, CAST(t AS Type), site_info, a.resource_captures.contains?(rtoc_inner_key), schema_lookup));
  END
  a.strategies = strategies;
  MUTABLE rtoc_move_marks: [Set]String = Set[];
  FOR rtoc_strategy_key IN strategies.keys() DO
    IF strategies[rtoc_strategy_key] EXISTS AS rtoc_strategy THEN
      IF rtoc_strategy IS_A MoveInto THEN
        &rtoc_move_marks.insert(COPY rtoc_strategy_key);
      END
    END
  END
  a.move_mark_names = COPY rtoc_move_marks;
  MUTABLE rtoc_alloc_marks: {String}String@symbol = {};
  FOR rtoc_alloc_key IN strategies.keys() DO
    IF strategies[rtoc_alloc_key] EXISTS AS rtoc_alloc_strategy THEN
      IF rtoc_alloc_strategy IS_A FreshHeapCopy AS rtoc_fresh THEN
        rtoc_alloc_marks[rtoc_alloc_key] = COPY rtoc_fresh.alloc_sym;
      END
    END
  END
  a.alloc_mark_entries = COPY rtoc_alloc_marks;
  RETURN strategies;
END
PUB FN bgCaptureClassifier__resolve_capture_type(type_obj: ?Type, sym: ?SymbolEntry) RETURNS !?Type ->
  IF type_obj EXISTS AS type_obj_value THEN
    MUTABLE type_obj_value_mutable = COPY type_obj_value;
    MUTABLE base = TRY (type__new(castTypeToTypeConstructionInput__bg_capture_classifier(type_obj_value_mutable)));
    IF sym EXISTS AS sym_value THEN
      MUTABLE sym_value_mutable = COPY sym_value;
      TRY (type__apply_bg_capture_symbol_mut(&base, symbolEntry__storage(sym_value_mutable), symbolEntry__sync(sym_value_mutable)));
      bgCaptureClassifier__apply_capture_storage_provenance_mut(&base, symbolEntry__storage(sym_value_mutable));
      IF symbolEntry__borrowed_alias(sym_value_mutable) THEN
        type__mark_borrowed_reference_mut(&base);
      END
      RETURN base;
    ELSE
      RETURN base;
    END
  ELSE
    RETURN NIL;
  END
END
PUB FN bgCaptureClassifier__apply_capture_storage_provenance_mut(MUTABLE type: Type, storage: String@symbol) RETURNS Void ->
  IF (storage == :heap) THEN
    type__mark_heap_allocated_mut(&type);
  ELSE_IF (storage == :frame) THEN
    type__mark_frame_allocated_mut(&type);
  ELSE_IF (storage == :borrow) THEN
    type__mark_borrowed_reference_mut(&type);
  END
END
# End Ruby module BgCaptureClassifier
FN castTypeToTypeConstructionInput__bg_capture_classifier(value: Type) RETURNS TypeConstructionInput ->
  RETURN TypeConstructionInput{ Type: COPY value };
END
FN rubyToClearVoid__bg_capture_classifier() RETURNS Void ->
  RETURN;
END
