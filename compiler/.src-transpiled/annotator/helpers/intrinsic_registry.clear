REQUIRE "../../ast/type.clear"
REQUIRE "function_signature_returns.clear"
REQUIRE "function_signature.clear"
REQUIRE "function_return.clear"
REQUIRE "intrinsic_arg_spec.clear"
REQUIRE "intrinsic_emit.clear"
REQUIRE "../../ast/std_lib.clear"
REQUIRE "../../ast/param.clear"
REQUIRE "../../ast/ast.clear"
REQUIRE "intrinsic_contract.clear"
# Ruby module IntrinsicRegistry
UNION LookupResult { FunctionSignatureMultiowned: FunctionSignature@multiowned, ArrayValue: []FunctionSignature@multiowned }
UNION RegistryKey { StringValue: String, SymbolValue: String@symbol }
UNION RawArgSpecEntry { SymbolValue: String@symbol, StringValue: String, AnyMultiowned: Any@multiowned }
UNION RawArgSpec { SymbolValue: String@symbol, StringValue: String, AnyMultiowned: Any@multiowned, ArrayValue: []RawArgSpecEntry }
UNION RawRegistryEntry { AnyMultiowned: Any@multiowned, ArrayValue: []Any@multiowned }
UNION RawEmitInput { AnyMultiowned: Any@multiowned, ArrayValue: []Any@multiowned, SymbolValue: String@symbol, StringValue: String, Float64Value: Float64, BoolValue: Bool }
UNION EmitPassthroughValue { StringValue: String, SymbolValue: String@symbol, AnyMultiowned: Any@multiowned, Struct: Struct, ArrayValue: []@multiowned Any }
UNION ReturnDescriptor { TypeMultiowned: Type@multiowned, SymbolValue: String@symbol, StringValue: String, AnyMultiowned: Any@multiowned, Type: Type }
UNION IntegerValue { Int64Value: Int64, StringValue: String }
UNION IntegerInput { Int64Value: Int64, StringValue: String, ArrayValue: []IntegerValue }
UNION SymbolInput { StringValue: String, SymbolValue: String@symbol }
MUTABLE sigs_cache: {String@symbol}{String}?LookupResult = {};
registry_constants: [6]String@symbol = [:STD_LIB, :POOL_METHODS, :SET_METHODS, :MAP_METHODS, :INDEX_OPS, :BUILTIN_OPS];
MUTABLE registry_values_value: {String@symbol}{RegistryKey}RawRegistryEntry = {};
MUTABLE map_method_aliases_value: {String}String = {};
fs_keys = [:args, :arity, :validate, :return, :return_type, :can_fail, :error_fallible, :needs_rt];
emit_bool = [:bc, :is_method, :suspends, :narrows_collection, :narrows_receiver_collection, :mutates_receiver, :allocates, :takes_value, :container_borrow];
emit_strsym = [:zig, :numeric_zig, :sharded_zig, :shard_direct_zig];
emit_str = [:reject_error, :elem];
emit_sym = [:tag, :builtin, :alloc, :return_alloc, :val_alloc, :key_alloc, :shard_alloc, :sharded_alloc, :reject_when, :bc_op, :error_kind, :error_type];
emit_pass = [:borrows, :fallible_clauses, :fsm_setup, :fsm_state_decls, :fsm_finish_block, :fsm_state_finalize, :fsm_finish_value, :label];
emit_intarr = [:takes_args];
emit_nested = [:eql, :strcmp, :cleanup, :assert, :array, :list, :pool, :set, :get, :string_raw, :string_symbol, :string_map, :numeric_map, :set_collection];
PRIVATE FN intrinsicRegistry__build_emit(h: ?RawEmitInput, registries: {String@symbol}{RegistryKey}RawRegistryEntry) RETURNS !?IntrinsicEmit ->
  IF !(((h != NIL) AND (h IS_A {}Any))) THEN
    RETURN NIL;
  END
  MUTABLE e = IntrinsicEmit{ zig: NIL, numeric_zig: NIL, sharded_zig: NIL, shard_direct_zig: NIL, fsm_setup: List[], fsm_state_decls: List[], fsm_finish_block: List[], fsm_state_finalize: List[], fsm_setup_present: FALSE, fsm_state_decls_present: FALSE, fsm_finish_block_present: FALSE, fsm_state_finalize_present: FALSE, fsm_finish_value: NIL, bc: FALSE, is_method: FALSE, suspends: FALSE, narrows_collection: FALSE, narrows_receiver_collection: FALSE, mutates_receiver: FALSE, allocates: FALSE, takes_value: FALSE, container_borrow: FALSE, tag: NIL, builtin: NIL, alloc: NIL, return_alloc: NIL, val_alloc: NIL, key_alloc: NIL, shard_alloc: NIL, sharded_alloc: NIL, borrows: NIL, reject_when: NIL, bc_op: NIL, error_kind: NIL, error_type: NIL, registry: NIL, elem: NIL, fallible_clauses: NIL, lifetime: List[], reject_error: NIL, arity: NIL, takes_args: List[], label: NIL, eql: NIL, strcmp: NIL, cleanup: NIL, assert: NIL, array: NIL, list: NIL, pool: NIL, set: NIL, get: NIL, string_raw: NIL, string_symbol: NIL, string_map: NIL, numeric_map: NIL, set_collection: NIL };
  h.keys() |> EACH {
  MUTABLE v: Any = (h[_] OR_ELSE panic("missing hash key"));
  MUTABLE key = _;
  IF !((fs_keys.contains?(key) OR (v == NIL))) THEN
      IF emit_bool.contains?(key) THEN
        TRY (intrinsicRegistry__assign_emit_bool(&e, key, !(!(v))));
      ELSE_IF emit_strsym.contains?(key) OR emit_pass.contains?(key) THEN
        TRY (intrinsicRegistry__assign_emit_value(&e, key, v));
      ELSE_IF emit_str.contains?(key) THEN
        TRY (intrinsicRegistry__assign_emit_string(&e, key, CAST(v AS String)));
      ELSE_IF (key == :lifetime) THEN
        e.lifetime = (TRY (intrinsicRegistry__normalize_lifetime(v))) |> SELECT intrinsicRegistry__lifetime_source_string(_);
      ELSE_IF emit_sym.contains?(key) THEN
        TRY (intrinsicRegistry__assign_emit_symbol(&e, key, TRY (intrinsicRegistry__coerce_symbol(CAST(v AS SymbolInput)))));
      ELSE_IF emit_intarr.contains?(key) THEN
        TRY (intrinsicRegistry__assign_emit_int_array(&e, key, TRY (intrinsicRegistry__coerce_int_array(CAST(v AS IntegerInput)))));
      ELSE_IF emit_nested.contains?(key) THEN
        TRY (intrinsicRegistry__assign_emit_nested(&e, key, TRY (intrinsicRegistry__nested_emit(v, registries))));
      ELSE
        panic("IntrinsicRegistry: unmapped registry key {}");
      END
  END
  };
  RETURN e;
END
FN intrinsicRegistry__assign_emit_bool(MUTABLE e: IntrinsicEmit, key: String@symbol, value: Bool) RETURNS !Void ->
  IF (key == :bc) THEN
    e.bc = COPY value;
  ELSE_IF (key == :is_method) THEN
    e.is_method = COPY value;
  ELSE_IF (key == :suspends) THEN
    e.suspends = COPY value;
  ELSE_IF (key == :narrows_collection) THEN
    e.narrows_collection = COPY value;
  ELSE_IF (key == :narrows_receiver_collection) THEN
    e.narrows_receiver_collection = COPY value;
  ELSE_IF (key == :mutates_receiver) THEN
    e.mutates_receiver = COPY value;
  ELSE_IF (key == :allocates) THEN
    e.allocates = COPY value;
  ELSE_IF (key == :takes_value) THEN
    e.takes_value = COPY value;
  ELSE_IF (key == :container_borrow) THEN
    e.container_borrow = COPY value;
  ELSE
    TRY (intrinsicRegistry__unknown_emit_key_mut(key));
  END
END
FN intrinsicRegistry__assign_emit_value(MUTABLE e: IntrinsicEmit, key: String@symbol, value: ?EmitPassthroughValue) RETURNS !Void ->
  IF (key == :zig) THEN
    e.zig = COPY castOptionalEmitPassthroughValueToOptionalIntrinsicEmitStrOrSym(value);
  ELSE_IF (key == :numeric_zig) THEN
    e.numeric_zig = COPY castOptionalEmitPassthroughValueToOptionalIntrinsicEmitStrOrSym(value);
  ELSE_IF (key == :sharded_zig) THEN
    e.sharded_zig = COPY castOptionalEmitPassthroughValueToOptionalIntrinsicEmitStrOrSym(value);
  ELSE_IF (key == :shard_direct_zig) THEN
    e.shard_direct_zig = COPY castOptionalEmitPassthroughValueToOptionalIntrinsicEmitStrOrSym(value);
  ELSE_IF (key == :borrows) THEN
    e.borrows = CAST(value AS ?Auto);
  ELSE_IF (key == :fallible_clauses) THEN
    e.fallible_clauses = castOptionalEmitPassthroughValueToAnyMultiowned(value);
  ELSE_IF (key == :fsm_setup) THEN
    e.fsm_setup = COPY castOptionalEmitPassthroughValueToAnyMultiowned(value);
    e.fsm_setup_present = TRUE;
  ELSE_IF (key == :fsm_state_decls) THEN
    e.fsm_state_decls = COPY castOptionalEmitPassthroughValueToAnyMultiowned(value);
    e.fsm_state_decls_present = TRUE;
  ELSE_IF (key == :fsm_finish_block) THEN
    e.fsm_finish_block = COPY castOptionalEmitPassthroughValueToAnyMultiowned(value);
    e.fsm_finish_block_present = TRUE;
  ELSE_IF (key == :fsm_state_finalize) THEN
    e.fsm_state_finalize = COPY castOptionalEmitPassthroughValueToAnyMultiowned(value);
    e.fsm_state_finalize_present = TRUE;
  ELSE_IF (key == :fsm_finish_value) THEN
    e.fsm_finish_value = castOptionalEmitPassthroughValueToAnyMultiowned(value);
  ELSE_IF (key == :label) THEN
    e.label = castOptionalEmitPassthroughValueToOptionalAnyMultiowned(value);
  ELSE
    TRY (intrinsicRegistry__unknown_emit_key_mut(key));
  END
END
FN intrinsicRegistry__assign_emit_string(MUTABLE e: IntrinsicEmit, key: String@symbol, value: String) RETURNS !Void ->
  IF (key == :reject_error) THEN
    e.reject_error = COPY value;
  ELSE_IF (key == :elem) THEN
    e.elem = COPY value;
  ELSE
    TRY (intrinsicRegistry__unknown_emit_key_mut(key));
  END
END
FN intrinsicRegistry__assign_emit_symbol(MUTABLE e: IntrinsicEmit, key: String@symbol, value: String@symbol) RETURNS !Void ->
  IF (key == :tag) THEN
    e.tag = COPY value;
  ELSE_IF (key == :builtin) THEN
    e.builtin = COPY value;
  ELSE_IF (key == :alloc) THEN
    e.alloc = COPY value;
  ELSE_IF (key == :return_alloc) THEN
    e.return_alloc = COPY value;
  ELSE_IF (key == :val_alloc) THEN
    e.val_alloc = COPY value;
  ELSE_IF (key == :key_alloc) THEN
    e.key_alloc = COPY value;
  ELSE_IF (key == :shard_alloc) THEN
    e.shard_alloc = COPY value;
  ELSE_IF (key == :sharded_alloc) THEN
    e.sharded_alloc = COPY value;
  ELSE_IF (key == :reject_when) THEN
    e.reject_when = COPY value;
  ELSE_IF (key == :bc_op) THEN
    e.bc_op = COPY value;
  ELSE_IF (key == :error_kind) THEN
    e.error_kind = COPY value;
  ELSE_IF (key == :error_type) THEN
    e.error_type = COPY value;
  ELSE
    TRY (intrinsicRegistry__unknown_emit_key_mut(key));
  END
END
FN intrinsicRegistry__assign_emit_int_array(MUTABLE e: IntrinsicEmit, key: String@symbol, value: []Int64) RETURNS !Void ->
  IF (key == :takes_args) THEN
    e.takes_args = COPY value;
  ELSE
    TRY (intrinsicRegistry__unknown_emit_key_mut(key));
  END
END
FN intrinsicRegistry__assign_emit_nested(MUTABLE e: IntrinsicEmit, key: String@symbol, value: ?IntrinsicEmit) RETURNS !Void ->
  IF (key == :eql) THEN
    e.eql = COPY value;
  ELSE_IF (key == :strcmp) THEN
    e.strcmp = COPY value;
  ELSE_IF (key == :cleanup) THEN
    e.cleanup = COPY value;
  ELSE_IF (key == :assert) THEN
    e.assert = COPY value;
  ELSE_IF (key == :array) THEN
    e.array = COPY value;
  ELSE_IF (key == :list) THEN
    e.list = COPY value;
  ELSE_IF (key == :pool) THEN
    e.pool = COPY value;
  ELSE_IF (key == :set) THEN
    e.set = COPY value;
  ELSE_IF (key == :get) THEN
    e.get = COPY value;
  ELSE_IF (key == :string_raw) THEN
    e.string_raw = COPY value;
  ELSE_IF (key == :string_symbol) THEN
    e.string_symbol = COPY value;
  ELSE_IF (key == :string_map) THEN
    e.string_map = COPY value;
  ELSE_IF (key == :numeric_map) THEN
    e.numeric_map = COPY value;
  ELSE_IF (key == :set_collection) THEN
    e.set_collection = COPY value;
  ELSE
    TRY (intrinsicRegistry__unknown_emit_key_mut(key));
  END
END
FN intrinsicRegistry__coerce_int_array(value: IntegerInput) RETURNS ![]Int64 ->
  IF value IS_A []IntegerValue AS array THEN
    RETURN array |> SELECT TRY (intrinsicRegistry__coerce_integer(_));
  END
  IF value IS_A Int64 AS int64 THEN
    RETURN CAST([int64] AS []Int64);
  END
  IF value IS_A String AS string THEN
    RETURN CAST([TRY (string.toInt())] AS []Int64);
  END
  panic("IntrinsicRegistry: expected integer-compatible value");
END
FN intrinsicRegistry__normalize_integer_array(value: ?IntegerInput) RETURNS ![]Int64 ->
  IF value EXISTS AS value_value THEN
    RETURN TRY (intrinsicRegistry__coerce_int_array(value_value));
  ELSE
    RETURN CAST(( { MUTABLE rtoc_empty_list_1: []Int64 = List[]; rtoc_empty_list_1 } ) AS []Int64);
  END
END
FN intrinsicRegistry__coerce_integer<T>(value: T) RETURNS !Int64 ->
  COMPTIME IF T IS_A Int64 THEN
    RETURN COPY value;
  END
  COMPTIME IF T IS_A String THEN
    RETURN TRY (value.toInt());
  END
  panic("IntrinsicRegistry: expected integer-compatible value");
END
FN intrinsicRegistry__unknown_emit_key_mut(key: String@symbol) RETURNS Auto ->
  panic("IntrinsicRegistry: unmapped registry key {}");
END
FN intrinsicRegistry__coerce_symbol<T>(value: T) RETURNS !String@symbol ->
  COMPTIME IF T IS_A String@symbol THEN
    RETURN COPY value;
  END
  COMPTIME IF T IS_A String THEN
    RETURN value.to_sym();
  END
  panic("IntrinsicRegistry: expected symbol-compatible value");
END
PRIVATE FN intrinsicRegistry__nested_emit(v: ?RawEmitInput, registries: {String@symbol}{RegistryKey}RawRegistryEntry) RETURNS !?IntrinsicEmit ->
  IF !(((v != NIL) AND (v IS_A {}Any))) THEN
    RETURN NIL;
  END
  MUTABLE ptr = COPY v.substr(:registry, 1);
  IF ptr THEN
    MUTABLE name: ?String@symbol = intrinsicRegistry__registry_name_for(registries, CAST(ptr AS {RegistryKey}RawRegistryEntry));
    IF name EXISTS AS name_value THEN
      RETURN IntrinsicEmit{ registry: COPY name_value, zig: NIL, numeric_zig: NIL, sharded_zig: NIL, shard_direct_zig: NIL, fsm_setup: List[], fsm_state_decls: List[], fsm_finish_block: List[], fsm_state_finalize: List[], fsm_setup_present: FALSE, fsm_state_decls_present: FALSE, fsm_finish_block_present: FALSE, fsm_state_finalize_present: FALSE, fsm_finish_value: NIL, bc: FALSE, is_method: FALSE, suspends: FALSE, narrows_collection: FALSE, narrows_receiver_collection: FALSE, mutates_receiver: FALSE, allocates: FALSE, takes_value: FALSE, container_borrow: FALSE, tag: NIL, builtin: NIL, alloc: NIL, return_alloc: NIL, val_alloc: NIL, key_alloc: NIL, shard_alloc: NIL, sharded_alloc: NIL, borrows: NIL, reject_when: NIL, bc_op: NIL, error_kind: NIL, error_type: NIL, elem: NIL, fallible_clauses: NIL, lifetime: List[], reject_error: NIL, arity: NIL, takes_args: List[], label: NIL, eql: NIL, strcmp: NIL, cleanup: NIL, assert: NIL, array: NIL, list: NIL, pool: NIL, set: NIL, get: NIL, string_raw: NIL, string_symbol: NIL, string_map: NIL, numeric_map: NIL, set_collection: NIL };
    END
    RETURN IntrinsicEmit{ registry: :unknown, zig: NIL, numeric_zig: NIL, sharded_zig: NIL, shard_direct_zig: NIL, fsm_setup: List[], fsm_state_decls: List[], fsm_finish_block: List[], fsm_state_finalize: List[], fsm_setup_present: FALSE, fsm_state_decls_present: FALSE, fsm_finish_block_present: FALSE, fsm_state_finalize_present: FALSE, fsm_finish_value: NIL, bc: FALSE, is_method: FALSE, suspends: FALSE, narrows_collection: FALSE, narrows_receiver_collection: FALSE, mutates_receiver: FALSE, allocates: FALSE, takes_value: FALSE, container_borrow: FALSE, tag: NIL, builtin: NIL, alloc: NIL, return_alloc: NIL, val_alloc: NIL, key_alloc: NIL, shard_alloc: NIL, sharded_alloc: NIL, borrows: NIL, reject_when: NIL, bc_op: NIL, error_kind: NIL, error_type: NIL, elem: NIL, fallible_clauses: NIL, lifetime: List[], reject_error: NIL, arity: NIL, takes_args: List[], label: NIL, eql: NIL, strcmp: NIL, cleanup: NIL, assert: NIL, array: NIL, list: NIL, pool: NIL, set: NIL, get: NIL, string_raw: NIL, string_symbol: NIL, string_map: NIL, numeric_map: NIL, set_collection: NIL };
  END
  RETURN TRY (intrinsicRegistry__build_emit(v, registries));
END
FN intrinsicRegistry__registry_name_for(registries: {String@symbol}{RegistryKey}RawRegistryEntry, target: {RegistryKey}RawRegistryEntry) RETURNS ?String@symbol ->
  MUTABLE names = registries.keys();
  MUTABLE i: Int64 = 0;
  WHILE (i < names.length()) DO
    MUTABLE name = COPY UNWRAP (names[i]);
    IF (UNWRAP (registries[name])).equal?(target) THEN
      RETURN name;
    END
    i = (i + 1);
  END
  i = 0;
  WHILE (i < names.length()) DO
    name = COPY UNWRAP (names[i]);
    IF intrinsicRegistry__registry_matches?(UNWRAP (registries[name]), target) THEN
      RETURN name;
    END
    i = (i + 1);
  END
  RETURN NIL;
END
FN intrinsicRegistry__registry_matches?(left: {RegistryKey}RawRegistryEntry, right: {RegistryKey}RawRegistryEntry) RETURNS Bool ->
  IF !((left.count() == right.count())) THEN
    RETURN FALSE;
  END
  MUTABLE left_keys = left.keys();
  MUTABLE right_keys = right.keys();
  MUTABLE i: Int64 = 0;
  WHILE (i < left_keys.length()) DO
    MUTABLE wanted = intrinsicRegistry__registry_key_string(UNWRAP (left_keys[i]));
    MUTABLE found: Bool = FALSE;
    MUTABLE j: Int64 = 0;
    WHILE (j < right_keys.length()) DO
      IF (intrinsicRegistry__registry_key_string(UNWRAP (right_keys[j])) == wanted) THEN
        found = TRUE;
        BREAK;
      END
      j = (j + 1);
    END
    IF !(found) THEN
      RETURN FALSE;
    END
    i = (i + 1);
  END
  RETURN TRUE;
END
FN intrinsicRegistry__registry_key_string(key: RegistryKey) RETURNS String ->
  IF key IS_A String AS string THEN
    RETURN COPY string;
  END
  RETURN COPY CAST(key AS String);
END
FN intrinsicRegistry__to_return_type(rdef: FunctionReturn) RETURNS !Type ->
  IF functionReturn__fixed?(rdef) THEN
    MUTABLE fixed = COPY rdef.fixed;
    RETURN fixed;
  ELSE
    RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :Any }));
  END
END
FN intrinsicRegistry__to_return_def(v: ?ReturnDescriptor) RETURNS !FunctionReturn@multiowned ->
  IF v EXISTS AS v_value THEN
    IF v_value IS_A Type AS type THEN
      RETURN functionReturn__fixed(type);
    END
    IF v_value IS_A Any AS any THEN
      panic("IntrinsicRegistry: Proc return descriptor is not allowed; use a declarative directive (r_* variant or infer_* host method)");
    END
    IF v_value IS_A {}Any THEN
      MUTABLE raw_type = COPY v_value.substr(:type, 1);
      IF raw_type THEN
        RETURN functionReturn__fixed(TRY (type__new(castTypeTypeInputToTypeConstructionInput(CAST(raw_type AS TypeTypeInput)), CAST(v_value.substr(:ownership, 1) AS ?String@symbol), CAST(v_value.substr(:sync, 1) AS ?String@symbol))));
      END
      RETURN functionReturn__fixed(TRY (type__new(TypeConstructionInput{ SymbolValue: :Any })));
    END
    IF v_value IS_A String@symbol AS string_symbol THEN
      MUTABLE kind: ?String@symbol = COPY (CAST({:r_element_of: :ElementOf, :r_optional_element: :OptionalOfElement, :r_id_element: :IdOfElement, :r_optional_value: :OptionalOfValue, :r_value_list: :ValueList, :r_key_list: :KeyList} AS {String@symbol}String@symbol))[string_symbol];
      IF kind EXISTS AS kind_value THEN
        RETURN TRY (functionReturn__variant(kind_value));
      END
    END
    MUTABLE s = COPY CAST(v_value AS String);
    IF (s.startsWith?("infer_") OR s.startsWith?("macro_")) THEN
      RETURN functionReturn__infer(TRY (intrinsicRegistry__coerce_symbol(v_value)));
    END
    RETURN functionReturn__fixed(TRY (type__new(castReturnDescriptorToTypeConstructionInput(v_value))));
  ELSE
    RETURN functionReturn__fixed(TRY (type__new(TypeConstructionInput{ SymbolValue: :Void })));
  END
END
PRIVATE FN intrinsicRegistry__convert_entry(ignored_name: RegistryKey, h: Any@multiowned, registries: {String@symbol}{RegistryKey}RawRegistryEntry) RETURNS !FunctionSignature@multiowned ->
  MUTABLE ret = h[:return];
  IF h.key?(:return_type) THEN
    ret = h[:return_type];
  END
  MUTABLE rdef = TRY (intrinsicRegistry__to_return_def(CAST(ret AS ?ReturnDescriptor)));
  MUTABLE params = TRY (intrinsicRegistry__params_from_arg_spec(h[:args], h));
  MUTABLE fs = TRY (functionSignature__new(params, TypeTypeInput{ Type: COPY TRY (intrinsicRegistry__to_return_type(rdef)) }, FunctionSignatureLifetimeInput{ ArrayValue: COPY TRY (intrinsicRegistry__normalize_lifetime(h[:lifetime])) }, NIL, ( { MUTABLE rtoc_empty_list_2: []String@symbol = List[]; rtoc_empty_list_2 } ), {}, FALSE, FALSE, NIL, NIL, NIL, ( { MUTABLE rtoc_empty_list_3: []String@symbol = List[]; rtoc_empty_list_3 } ), NIL, ( { MUTABLE rtoc_empty_list_4: []String@symbol = List[]; rtoc_empty_list_4 } ), TRUE, CAST(h[:needs_rt] AS ?Bool), CAST(h[:can_fail] AS ?Bool), NIL, CAST(h[:error_fallible] AS ?Bool), NIL, NIL, NIL, NIL, NIL, NIL, CAST(h[:validate] AS ?Any@multiowned), CAST(h[:args] AS ?IntrinsicArgSpecRawArgSpec), CAST(h[:arity] AS ?Int64), TRY (intrinsicRegistry__build_emit(RawEmitInput{ AnyMultiowned: COPY h }, registries)), rdef));
  RETURN fs;
END
PRIVATE FN intrinsicRegistry__normalize_lifetime(value: ?FunctionSignatureLifetimeInput) RETURNS ![]FunctionSignatureLifetimeSource ->
  IF value EXISTS AS value_value THEN
    IF value_value IS_A []FunctionSignatureLifetimeSource AS array THEN
      RETURN COPY array;
    END
    RETURN CAST([castFunctionSignatureLifetimeInputToFunctionSignatureLifetimeSource(value_value)] AS []FunctionSignatureLifetimeSource);
  ELSE
    RETURN CAST(( { MUTABLE rtoc_empty_list_5: []FunctionSignatureLifetimeSource = List[]; rtoc_empty_list_5 } ) AS []FunctionSignatureLifetimeSource);
  END
END
FN intrinsicRegistry__lifetime_source_string(value: FunctionSignatureLifetimeSource) RETURNS String ->
  IF value IS_A String AS string THEN
    RETURN COPY string;
  END
  RETURN COPY CAST(value AS String);
END
PRIVATE FN intrinsicRegistry__params_from_arg_spec(spec: ?RawArgSpec, h: Any@multiowned) RETURNS ![]Param ->
  MUTABLE arg_specs = TRY (intrinsicArgSpec__list_from_registry(castOptionalRawArgSpecToOptionalIntrinsicArgSpecRawArgSpec(spec)));
  MUTABLE takes_args = TRY (intrinsicRegistry__normalize_integer_array(UNWRAP (CAST(h[:takes_args] AS ?IntegerInput))));
  MUTABLE mutates_receiver = (h[:mutates_receiver] == TRUE);
  MUTABLE params: []Param = ( { MUTABLE rtoc_empty_list_6: []Param = List[]; rtoc_empty_list_6 } );
  MUTABLE i: Int64 = 0;
  WHILE (i < arg_specs.length()) DO
    MUTABLE arg_def = COPY UNWRAP (arg_specs[i]);
    MUTABLE takes_index = IF (((h[:is_method] == TRUE) OR mutates_receiver)) THEN
      (i - 1)
    ELSE
      i
    END;
    MUTABLE takes_by_index = ((takes_index >= 0) AND takes_args.contains?(takes_index));
    &params.append(Param{ name: (arg_def.name OR_ELSE "arg${i.toString()}"), type: COPY arg_def.type, required: TRUE, mutable: ( { MUTABLE rtoc_optional_or_source_7: ?Bool = arg_def.mutable; MUTABLE rtoc_optional_or_result_8: ?Bool = NIL; IF rtoc_optional_or_source_7 != NIL THEN rtoc_optional_or_result_8 = COPY rtoc_optional_or_source_7; ELSE rtoc_optional_or_result_8 = (((i == 0) AND mutates_receiver)); END rtoc_optional_or_result_8 } ), takes: ( { MUTABLE rtoc_optional_or_source_9: ?Bool = arg_def.takes; MUTABLE rtoc_optional_or_result_10: ?Bool = NIL; IF rtoc_optional_or_source_9 != NIL THEN rtoc_optional_or_result_10 = COPY rtoc_optional_or_source_9; ELSE rtoc_optional_or_result_10 = takes_by_index; END rtoc_optional_or_result_10 } ), default: NIL, comptime: NIL, name_token: NIL, sync: NIL, symbol: NIL, carrier_contract: NIL });
    i = (i + 1);
  END
  RETURN params;
END
FN intrinsicRegistry__sigs(reg: {RegistryKey}RawRegistryEntry) RETURNS !{String}?LookupResult ->
  MUTABLE registry_map = TRY (intrinsicRegistry__registries());
  MUTABLE cache_key: ?String@symbol = intrinsicRegistry__registry_name_for(registry_map, reg);
  IF cache_key EXISTS AS cache_key_value THEN
    MUTABLE cached: ?{String}?LookupResult = COPY sigs_cache[cache_key_value];
    IF cached EXISTS AS cached_value THEN
      RETURN cached_value;
    END
  END
  MUTABLE out: {String}?LookupResult = {};
  MUTABLE names = reg.keys();
  MUTABLE entries = reg.values();
  MUTABLE i: Int64 = 0;
  WHILE (i < names.length()) DO
    MUTABLE name = COPY UNWRAP (names[i]);
    MUTABLE entry = COPY UNWRAP (entries[i]);
    MUTABLE key = intrinsicRegistry__registry_key_string(name);
    IF entry IS_A []Any@multiowned AS array THEN
      MUTABLE overloads: []FunctionSignature@multiowned = ( { MUTABLE rtoc_empty_list_11: []FunctionSignature@multiowned = List[]; rtoc_empty_list_11 } );
      MUTABLE j: Int64 = 0;
      WHILE (j < array.length()) DO
        &overloads.append(TRY (intrinsicRegistry__convert_entry(name, UNWRAP (array[j]), registry_map)));
        j = (j + 1);
      END
      out[key] = LookupResult{ FunctionSignatureMultiowned: COPY overloads };
    ELSE_IF entry IS_A {}Any THEN
      out[key] = LookupResult{ FunctionSignatureMultiowned: COPY TRY (intrinsicRegistry__convert_entry(name, castRawRegistryEntryToAnyMultiowned(entry), registry_map)) };
    END
    i = (i + 1);
  END
  IF cache_key EXISTS AS cache_key_value THEN
    sigs_cache[cache_key_value] = out;
  END
  RETURN out;
END
PRIVATE FN intrinsicRegistry__registries() RETURNS !{String@symbol}{RegistryKey}RawRegistryEntry ->
  MUTABLE out: {String@symbol}{RegistryKey}RawRegistryEntry = {};
  MUTABLE values = TRY (intrinsicRegistry__registry_values());
  MUTABLE i: Int64 = 0;
  WHILE (i < registry_constants.length()) DO
    MUTABLE constant_name = UNWRAP (registry_constants[i]);
    MUTABLE registry: ?{RegistryKey}RawRegistryEntry = COPY values[constant_name];
    IF registry EXISTS AS registry_value THEN
      out[constant_name] = COPY registry_value;
    END
    i = (i + 1);
  END
  RETURN out;
END
PRIVATE FN intrinsicRegistry__registry_values() RETURNS !{String@symbol}{RegistryKey}RawRegistryEntry ->
  IF (registry_values_value.count() == 0) THEN
    intrinsicRegistry__populate_registry_values();
  END
  RETURN registry_values_value;
END
