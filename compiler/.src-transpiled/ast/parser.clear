UNION CodeOrMessage { StringValue: String, SymbolValue: String@symbol }
UNION ParsedExternEffectsReturnValueValue { SymbolValue: String@symbol, BoolValue: Bool }
STRUCT ClearParser {
  budget: FrontendResourceBudget@multiowned,
  delimiter_closings: []?Int64,
  gradual: Bool,
  pos: Int64,
  source_code: String,
  tokens: []Token
}

PUB FN ruby_constant_open_delimiters() RETURNS String ->
  RETURN CAST("([{" AS String);
END
PUB FN ruby_constant_close_delimiters() RETURNS String ->
  RETURN CAST(")]}" AS String);
END
STRUCT CapabilityParseResult {
  ownership: ?String@symbol,
  sync: ?String@symbol,
  collection: ?String@symbol,
  is_soa: Bool,
  is_indirect: Bool,
  shard_count: ?Int64,
  observable: Bool,
  observable_token: ?Token
}
STRUCT TaskPrefix {
  pinned: Bool,
  parallel: Bool,
  stack_size: ?String@symbol,
  arena: Bool,
  can_smash: Bool,
  stack_size_token: ?Token,
  can_smash_token: ?Token
}
STRUCT ParsedStructField {
  name: String,
  value: Locatable,
  name_token: Token
}
STRUCT SigilAttrs {
  dim: ?String@symbol,
  val: ?String@symbol,
  stack_size: ?String@symbol,
  pinned: Bool,
  parallel: Bool,
  arena: Bool,
  can_smash: Bool
}
STRUCT CapJoin {
  ownership: ?String@symbol,
  sync: ?String@symbol,
  layout: ?String@symbol,
  lock_rank: ?Int64
}
STRUCT ElementCapability {
  ownership: ?String@symbol,
  sync: ?String@symbol,
  layout: ?String@symbol
}
STRUCT ParsedEffectsDecl {
  kind: ?String@symbol,
  span: ?EffectSpan,
  max_depth: ?Int64,
  tight: Bool
}
STRUCT ParsedExternEffects {
  alloc: ?String@symbol,
  safe: Bool
}

FN parsedExternEffects__to_h(self: ParsedExternEffects) RETURNS !{String@symbol}ParsedExternEffectsReturnValueValue ->
  MUTABLE alloc_kind: ?String@symbol = COPY self.alloc;
  IF ((alloc_kind != NIL) AND self.safe) THEN
    RETURN CAST({:alloc: ParsedExternEffectsReturnValueValue{ SymbolValue: COPY alloc_kind }, :safe: ParsedExternEffectsReturnValueValue{ BoolValue: TRUE }} AS {String@symbol}ParsedExternEffectsReturnValueValue);
  END
  IF alloc_kind EXISTS AS alloc_kind_value THEN
    RETURN CAST({:alloc: ParsedExternEffectsReturnValueValue{ SymbolValue: COPY alloc_kind_value }} AS {String@symbol}ParsedExternEffectsReturnValueValue);
  END
  IF self.safe THEN
    RETURN CAST({:safe: ParsedExternEffectsReturnValueValue{ BoolValue: TRUE }} AS {String@symbol}ParsedExternEffectsReturnValueValue);
  END
  RETURN {};
END
STRUCT ParsedVarForm {
  node: Locatable,
  assignment: Bool
}
STRUCT RequiresKind {
  family: ?String@symbol,
  reentrance: ?String@symbol
}
STRUCT ParsedRequiresClause {
  capabilities: {String}[Set]String@symbol,
  reentrance: {String}String@symbol
}
STRUCT ParsedMatchStart {
  token: Token,
  subject: Locatable,
  takes: Bool
}
STRUCT ParsedMatchArm {
  kind: String@symbol,
  value: Locatable,
  extra_values: []Locatable,
  binding: ?String,
  destructure: ?StructPattern
}
