          item_mutable.source_range = SourceRange{ file: ( { MUTABLE rtoc_optional_or_source_6: ?String = range.file; MUTABLE rtoc_optional_or_result_7: ?String = NIL; IF rtoc_optional_or_source_6 != NIL THEN rtoc_optional_or_result_7 = COPY rtoc_optional_or_source_6; ELSE rtoc_optional_or_result_7 = last.file; END rtoc_optional_or_result_7 } ), start_offset: range.start_offset, end_offset: end_offset, start_line: range.start_line, start_column: range.start_column, end_line: (last.end_line OR last.line), end_column: (last.end_column OR ((last.column + (CAST(last.value AS String)).codepointCount()))) };
          node = Locatable{ SuppressCleanup: item_mutable };,
        Locatable.Return AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.source_range = SourceRange{ file: ( { MUTABLE rtoc_optional_or_source_6: ?String = range.file; MUTABLE rtoc_optional_or_result_7: ?String = NIL; IF rtoc_optional_or_source_6 != NIL THEN rtoc_optional_or_result_7 = COPY rtoc_optional_or_source_6; ELSE rtoc_optional_or_result_7 = last.file; END rtoc_optional_or_result_7 } ), start_offset: range.start_offset, end_offset: end_offset, start_line: range.start_line, start_column: range.start_column, end_line: (last.end_line OR last.line), end_column: (last.end_column OR ((last.column + (CAST(last.value AS String)).codepointCount()))) };
          node = Locatable{ Return: item_mutable };,
        Locatable.ReassignCleanup AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.source_range = SourceRange{ file: ( { MUTABLE rtoc_optional_or_source_6: ?String = range.file; MUTABLE rtoc_optional_or_result_7: ?String = NIL; IF rtoc_optional_or_source_6 != NIL THEN rtoc_optional_or_result_7 = COPY rtoc_optional_or_source_6; ELSE rtoc_optional_or_result_7 = last.file; END rtoc_optional_or_result_7 } ), start_offset: range.start_offset, end_offset: end_offset, start_line: range.start_line, start_column: range.start_column, end_line: (last.end_line OR last.line), end_column: (last.end_column OR ((last.column + (CAST(last.value AS String)).codepointCount()))) };
          node = Locatable{ ReassignCleanup: item_mutable };,
        Locatable.FieldCleanup AS item ->
          MUTABLE item_mutable = COPY item;
          item_mutable.source_range = SourceRange{ file: ( { MUTABLE rtoc_optional_or_source_6: ?String = range.file; MUTABLE rtoc_optional_or_result_7: ?String = NIL; IF rtoc_optional_or_source_6 != NIL THEN rtoc_optional_or_result_7 = COPY rtoc_optional_or_source_6; ELSE rtoc_optional_or_result_7 = last.file; END rtoc_optional_or_result_7 } ), start_offset: range.start_offset, end_offset: end_offset, start_line: range.start_line, start_column: range.start_column, end_line: (last.end_line OR last.line), end_column: (last.end_column OR ((last.column + (CAST(last.value AS String)).codepointCount()))) };
          node = Locatable{ FieldCleanup: item_mutable };,
      END
      RETURN COPY node;
    ELSE
      panic("Internal: source range missing from postfix receiver");
    END
}
END
PRIVATE FN clearParser__source_code(self: ClearParser) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {

}
END
PRIVATE FN clearParser__error_mut(self: ClearParser, node_or_token: Auto, code_or_message: CodeOrMessage, args: []?Auto = [], kwargs: {String@symbol}Auto = {}) RETURNS Auto
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE token: ?Any@multiowned = clearParser__diagnostic_token(rtoc_self_view, node_or_token);
    MUTABLE message: String = "";
    IF code_or_message IS_A String@symbol AS string_symbol THEN
      message = UNWRAP (TRY (diagnosticRegistry__format_from_hash(string_symbol, args, kwargs)));
    ELSE
      message = castCodeOrMessageToString(COPY code_or_message);
    END
    MUTABLE source_token: ?Token@multiowned = clearParser__source_error_token(rtoc_self_view, token);
    MUTABLE diagnostic_code: ?String@symbol = NIL;
    IF code_or_message IS_A String@symbol AS string_symbol THEN
      diagnostic_code = COPY (CAST(string_symbol AS String@symbol));
    END
    RETURN clearParser__raise_source_error_mut(rtoc_self_view, CAST(source_token AS ?Token), message, diagnostic_code);
}
END
PRIVATE FN clearParser__format_diagnostic_template(self: ClearParser, template: String, args: []?Auto, kwargs: {String@symbol}?Auto) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN diagnosticRegistry__format_template(template, args, kwargs);
}
END
PRIVATE FN clearParser__diagnostic_message(self: ClearParser, code: String@symbol, args: []?Auto = [], kwargs: {String@symbol}Auto = {}) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE message: ?String = TRY (diagnosticRegistry__format_from_hash(code, args, kwargs));
    IF message EXISTS AS message_value THEN
      RETURN message_value;
    ELSE
      panic("Internal Compiler Error: Unknown error code :{}");
    END
}
END
PRIVATE FN clearParser__fix_description(self: ClearParser, code: String@symbol, kwargs: {String@symbol}?Auto = {}) RETURNS !String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (diagnosticRegistry__fix_description_from_hash(code, kwargs));
}
END
PRIVATE FN clearParser__fix_description_from_hash(self: ClearParser, code: String@symbol, kwargs: {String@symbol}?Auto) RETURNS !String
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (diagnosticRegistry__fix_description_from_hash(code, kwargs));
}
END
PRIVATE FN clearParser__note_mut(self: ClearParser, node_or_token: Locatable, message: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE token: ?Token@multiowned = clearParser__source_error_token(rtoc_self_view, clearParser__diagnostic_token(rtoc_self_view, node_or_token));
    MUTABLE loc: String = "";
    IF token EXISTS AS token_value THEN
      loc = " (line ${token_value.line})";
    ELSE
      loc = "";
    END
    clearParser__diagnostic_output(rtoc_self_view, "\x1B[36m[Note]\x1B[0m ${message}${loc}");
    NIL;
}
END
PRIVATE FN clearParser__warning_mut(self: ClearParser, node_or_token: Locatable, message: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE token: ?Token@multiowned = clearParser__source_error_token(rtoc_self_view, clearParser__diagnostic_token(rtoc_self_view, node_or_token));
    MUTABLE loc: String = "";
    IF token EXISTS AS token_value THEN
      loc = " (line ${token_value.line})";
    ELSE
      loc = "";
    END
    clearParser__diagnostic_output(rtoc_self_view, "\x1B[33m[Warning]\x1B[0m ${message}${loc}");
    NIL;
}
END
PRIVATE FN clearParser__fixable_mut(self: ClearParser, node_or_token: Auto, category: String@symbol, fixes: []Fix, message: ?String = NIL, code: ?String@symbol = NIL, level: String@symbol = :warning, raise_in_collector: Bool = FALSE, kwargs: {String@symbol}Auto = {}) RETURNS Auto
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE rendered_message = (message OR_ELSE clearParser__diagnostic_message(rtoc_self_view, code?, [], kwargs));
    MUTABLE token: ?Any@multiowned = clearParser__diagnostic_token(rtoc_self_view, node_or_token);
    MUTABLE source_token: ?Token@multiowned = clearParser__source_error_token(rtoc_self_view, token);
    MUTABLE finding = TRY (fixableFinding__new(level, rendered_message, token, category, fixes));
    IF fixCollector__enabled?() THEN
      TRY (fixCollector__push(finding, (level == :error)));
      IF !(raise_in_collector) THEN
        RETURN;
      END
      clearParser__raise_source_error_mut(rtoc_self_view, CAST(source_token AS ?Token), rendered_message);
    END
    IF (level == :hint) OR (level == :info) OR (level == :warning) THEN
      MUTABLE loc: String = "";
      IF source_token EXISTS AS source_token_value THEN
        loc = " (line ${source_token_value.line})";
      ELSE
        loc = "";
      END
      MUTABLE tag: String = "";
      IF (level == :warning) THEN
        tag = "\x1B[33m[Warning]\x1B[0m";
      ELSE
        tag = "\x1B[36m[${(CAST(level AS String)).capitalize()}]\x1B[0m";
      END
      RETURN clearParser__diagnostic_output(rtoc_self_view, "${tag} ${rendered_message}${loc}");
    ELSE_IF (level == :error) THEN
      RETURN clearParser__raise_source_error_mut(rtoc_self_view, CAST(source_token AS ?Token), rendered_message);
    ELSE
      RETURN NIL;
    END
}
END
PRIVATE FN clearParser__diagnostic_source_code(self: ClearParser) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY rtoc_self_view.source_code;
}
END
PRIVATE FN clearParser__raise_source_error_mut(self: ClearParser, token: ?Token, message: String, code: ?String@symbol = NIL) RETURNS Auto
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF clearParser__parser_error_host?(rtoc_self_view) THEN
      RAISE Input, ParserError, message;
    END
    RAISE Input, CompilerError, message;
}
END
PRIVATE FN clearParser__diagnostic_token(self: ClearParser, node_or_token: Auto) RETURNS ?Any@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE token = IF respondsTo?(node_or_token, "token") THEN
      node_or_token.token()
    ELSE
      node_or_token
    END;
    RETURN CAST(token AS ?Any@multiowned);
}
END
PRIVATE FN clearParser__source_error_token(self: ClearParser, token: ?Any@multiowned) RETURNS ?Token
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF ((token != NIL) AND (token IS_A Token)) THEN
      RETURN COPY token;
    END
    IF !((((token != NIL) AND respondsTo?(token, "line")) AND respondsTo?(token, "column"))) THEN
      RETURN NIL;
    END
    RETURN Token{ type: :ANCHOR, value: NIL, line: token.line(), column: token.column(), file: NIL, start_offset: NIL, end_offset: NIL, end_line: NIL, end_column: NIL };
}
END
PRIVATE FN clearParser__diagnostic_output(self: ClearParser, message: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    Kernel.warn(message);
    NIL;
}
END
FN castCodeOrMessageToString(value: CodeOrMessage) RETURNS String ->
  IF value IS_A String AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN "";
END
