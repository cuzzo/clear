REQUIRE "../type.clear"
REQUIRE "../source_error.clear"
REQUIRE "../lexer.clear"
REQUIRE "../ast.clear"
REQUIRE "../fixable_error.clear"
REQUIRE "../diagnostic_registry.clear"
UNION ClearParserReturnValue { TokenMultiowned: Token@multiowned, BoolValue: Bool, Token: Token }
UNION CodeOrMessage { StringValue: String, SymbolValue: String@symbol }
STRUCT ClearParser {
  pos: Int64,
  source_code: String,
  tokens: []Token
}

syntax_tokens_at_statement_end: [4]String = [";", "THEN", "DO", "->"];
FN clearParser__parser_error_host?(self: ClearParser) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRUE;
}
END
PRIVATE FN clearParser__index_delimiter_closings(self: ClearParser, tokens: []Token) RETURNS ![]?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE opening_chars: []String = ( { MUTABLE rtoc_empty_list_1: []String = List[]; rtoc_empty_list_1 } );
    MUTABLE opening_indices: []Int64 = ( { MUTABLE rtoc_empty_list_2: []Int64 = List[]; rtoc_empty_list_2 } );
    MUTABLE closings: []?Int64 = List[];
    MUTABLE rtoc_idx = 0;
    WHILE rtoc_idx < tokens.length() DO
      &closings.append(NIL);
      IF !((tokens[rtoc_idx]?.type == :CHAR)) THEN
          rtoc_idx = rtoc_idx + 1;
    CONTINUE;
      END
      MUTABLE value = TRY (token__text_mut(tokens[rtoc_idx]?));
      IF "([{".contains?(value) THEN
          &opening_chars.append(value);
          &opening_indices.append(COPY rtoc_idx);
      ELSE_IF !((opening_chars.length() == 0)) THEN
          MUTABLE opening = COPY UNWRAP (opening_chars.last());
          MUTABLE closing = ")]}".substr(UNWRAP ("([{".indexOf(opening)), 1);
          IF !((closing == value)) THEN
            rtoc_idx = rtoc_idx + 1;
    CONTINUE;
          END
          &opening_chars.pop();
          MUTABLE opening_index: ?Int64 = &opening_indices.pop();
          closings[opening_index?] = rtoc_idx;
      END
    rtoc_idx = rtoc_idx + 1;
    END
    RETURN closings;
}
END
PRIVATE FN clearParser__peek(self: ClearParser) RETURNS Token
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE token: ?Token = COPY rtoc_self_view.tokens[(rtoc_self_view.pos + 1)];
    IF token EXISTS AS token_value THEN
      RETURN token_value;
    END
    RETURN Token{ type: :EOF, value: "", line: clearParser__current(rtoc_self_view).line, column: clearParser__current(rtoc_self_view).column, file: NIL, start_offset: NIL, end_offset: NIL, end_line: NIL, end_column: NIL };
}
END
PRIVATE FN clearParser__peek_at(self: ClearParser, n: Int64) RETURNS ?Token
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY rtoc_self_view.tokens[(rtoc_self_view.pos + n)];
}
END
PRIVATE FN clearParser__current(self: ClearParser) RETURNS Token
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY UNWRAP (rtoc_self_view.tokens[rtoc_self_view.pos]);
}
END
PRIVATE FN clearParser__previous(self: ClearParser) RETURNS Token
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY UNWRAP (rtoc_self_view.tokens[(rtoc_self_view.pos - 1)]);
}
END
PRIVATE FN clearParser__consume_number(MUTABLE self: ClearParser) RETURNS Token
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF ((clearParser__current(rtoc_self_view).type == :NUMBER) OR (clearParser__current(rtoc_self_view).type == :INT64)) THEN
      MUTABLE tok = clearParser__current(rtoc_self_view);
      rtoc_self_view.pos = (rtoc_self_view.pos + 1);
      RETURN CAST(tok AS Token);
    ELSE
      RETURN clearParser__error_mut(rtoc_self_view, clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :EXPECTED_NUMBER }, [], {:value: clearParser__current(rtoc_self_view).value, :type: clearParser__current(rtoc_self_view).type});
    END
}
END
PRIVATE FN clearParser__consume(MUTABLE self: ClearParser, type: String@symbol, value: ?String = NIL) RETURNS !Token
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE token = clearParser__current(rtoc_self_view);
    MUTABLE matches_value: Bool = FALSE;
    IF value EXISTS AS value_value THEN
      MUTABLE expected_value = COPY value_value;
      matches_value = (TRY (token__text_mut(token)) == expected_value);
    END
    IF (((token.type == type)) OR matches_value) THEN
      IF ((value != NIL) AND !(matches_value)) THEN
        TRY (clearParser__emit_consume_error_with_fix(rtoc_self_view, CAST(token AS Token), type, value));
      END
      rtoc_self_view.pos = (rtoc_self_view.pos + 1);
      RETURN CAST(token AS Token);
    ELSE
      RETURN TRY (clearParser__emit_consume_error_with_fix(rtoc_self_view, CAST(token AS Token), type, value));
    END
}
END
PRIVATE FN clearParser__emit_consume_error_with_fix(self: ClearParser, MUTABLE token: Token, expected_type: String@symbol, expected_value: ?String) RETURNS Auto
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE prev_tok: ?Token = NIL;
    IF (rtoc_self_view.pos > 0) THEN
      prev_tok = COPY rtoc_self_view.tokens[(rtoc_self_view.pos - 1)];
    END
    IF (((expected_value != NIL) AND syntax_tokens_at_statement_end.contains?(expected_value)) AND (prev_tok != NIL)) THEN
      IF (prev_tok.line < token.line) THEN
        RETURN TRY (clearParser__emit_syntax_insert_end_of_line_mut(rtoc_self_view, prev_tok, token, expected_value));
      END
      IF ((["THEN", "DO", "->"]).contains?(expected_value) AND (prev_tok.line == token.line)) THEN
        RETURN TRY (clearParser__emit_syntax_insert_before_token_mut(rtoc_self_view, token, expected_value));
      END
    END
    IF (((((token.type == :CHAR) AND (TRY (token__text_mut(token)) == "!")) AND (prev_tok != NIL)) AND ([:VAR_ID, :TYPE_ID]).contains?(prev_tok.type)) AND (prev_tok.end_offset == token.start_offset)) THEN
      clearParser__error_mut(rtoc_self_view, token, CodeOrMessage{ SymbolValue: :LEGACY_MUTATION_NAME_SUFFIX });
    END
    RETURN clearParser__error_mut(rtoc_self_view, token, CodeOrMessage{ SymbolValue: :PARSER_EXPECTED }, [], {:expected: (expected_value OR_ELSE expected_type), :got: token.value, :type: token.type, :line: token.line});
}
END
PRIVATE FN clearParser__emit_syntax_insert_end_of_line_mut(self: ClearParser, prev_tok: Token, next_tok: Token, expected_value: String) RETURNS Auto
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE line_text = (rtoc_self_view.source_code.split("\n")[(prev_tok.line - 1)] OR_ELSE "");
    MUTABLE insert_col = (regexReplaceAll(line_text, "\\s+\\z", "").length() + 1);
    MUTABLE leader: String = "";
    IF ((expected_value == ";")) THEN
      leader = "";
    ELSE
      leader = " ";
    END
    MUTABLE fix = TRY (fix__new(clearParser__fix_description(rtoc_self_view, :INSERT_EXPECTED_AT_END_OF_LINE, {:expected: expected_value, :line: prev_tok.line}), [edit__new(span__new(NIL, prev_tok.line, insert_col, 0), "${leader}${expected_value}")], :auto));
    RETURN clearParser__fixable_mut(rtoc_self_view, next_tok, :type, [fix], NIL, :PARSER_EXPECTED_AT_END_OF_LINE, :error, TRUE, {:expected: expected_value, :expected_line: prev_tok.line, :got: next_tok.value, :got_line: next_tok.line});
}
END
PRIVATE FN clearParser__emit_syntax_insert_before_token_mut(self: ClearParser, token: Token, expected_value: String) RETURNS Auto
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE fix = TRY (fix__new(clearParser__fix_description(rtoc_self_view, :INSERT_EXPECTED_BEFORE_TOKEN, {:expected: expected_value, :got: token__display_value(token), :line: token.line}), [edit__new(span__new(NIL, token.line, token.column, 0), "${expected_value} ")], :auto));
    RETURN clearParser__fixable_mut(rtoc_self_view, token, :type, [fix], NIL, :PARSER_EXPECTED_BEFORE_TOKEN, :error, TRUE, {:expected: expected_value, :got: token.value, :line: token.line});
}
END
PRIVATE FN clearParser__match?(self: ClearParser, type: String@symbol, val: ?String = NIL) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE token = clearParser__current(rtoc_self_view);
    IF !((token.type == type)) THEN
      RETURN FALSE;
    END
    IF val EXISTS AS val_value THEN
      MUTABLE expected_value = COPY val_value;
      RETURN (TRY (token__text_mut(token)) == expected_value);
    ELSE
      RETURN TRUE;
    END
}
END
PRIVATE FN clearParser__generic_close?(self: ClearParser) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (clearParser__match?(rtoc_self_view, :CHAR, ">") OR clearParser__match?(rtoc_self_view, :CHAR, ">>"));
}
END
PRIVATE FN clearParser__consume_generic_close(MUTABLE self: ClearParser) RETURNS !Token
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(clearParser__match?(rtoc_self_view, :CHAR, ">>")) THEN
      RETURN CAST(TRY (clearParser__consume(&rtoc_self_view, :CHAR, ">")) AS Token);
    END
    MUTABLE combined = clearParser__current(rtoc_self_view);
    MUTABLE first: Token = CAST(OWN COPY combined AS Token);
    MUTABLE second: Token = CAST(OWN COPY combined AS Token);
    first.value = ">";
    IF combined.start_offset THEN
      first.end_offset = (combined.start_offset + 1);
    END
    first.end_column = (combined.column + 1);
    second.value = ">";
    second.column = (combined.column + 1);
    IF combined.start_offset THEN
      second.start_offset = (combined.start_offset + 1);
    END
    rtoc_self_view.tokens[rtoc_self_view.pos] = COPY second;
    RETURN first;
}
END
PRIVATE FN clearParser__match_at?(self: ClearParser, n: Int64, type: String@symbol, val: ?String = NIL) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE tok: ?Token@multiowned = clearParser__peek_at(rtoc_self_view, n);
    IF tok EXISTS AS tok_value THEN
      MUTABLE tok_value_mutable = COPY tok_value;
      IF !((tok_value_mutable.type == type)) THEN
        RETURN FALSE;
      END
      IF val EXISTS AS val_value THEN
        MUTABLE expected_value = COPY val_value;
        RETURN (TRY (token__text_mut(tok_value_mutable)) == expected_value);
      ELSE
        RETURN TRUE;
      END
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN clearParser__multi_pattern_continues?(self: ClearParser) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE nxt: ?Token@multiowned = clearParser__peek_at(rtoc_self_view, 1);
    IF nxt EXISTS AS nxt_value THEN
      MUTABLE nxt_value_mutable = COPY nxt_value;
      IF ((nxt_value_mutable.type == :ARROW) OR (nxt_value_mutable.type == :EOF)) THEN
        RETURN FALSE;
      END
      IF ((nxt_value_mutable.type == :KEYWORD) AND (["AS", "WHEN", "DEFAULT", "END"]).contains?(TRY (token__text_mut(nxt_value_mutable)))) THEN
        RETURN FALSE;
      END
      IF ((nxt_value_mutable.type == :CHAR) AND (TRY (token__text_mut(nxt_value_mutable)) == "{")) THEN
        RETURN FALSE;
      END
      RETURN TRUE;
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN clearParser__match_mut(MUTABLE self: ClearParser, type: String@symbol, value: ?String = NIL) RETURNS !ClearParserReturnValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF clearParser__match?(rtoc_self_view, type, value) THEN
      RETURN ClearParserReturnValue{ TokenMultiowned: COPY TRY (clearParser__consume(&rtoc_self_view, type)) };
    ELSE
      RETURN ClearParserReturnValue{ BoolValue: FALSE };
    END
}
END
PRIVATE FN clearParser__stamp_source_range_mut(self: ClearParser, MUTABLE node: Locatable, first: Token, last: Token) RETURNS Locatable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE start_offset = (first.start_offset OR 0);
    MUTABLE end_offset = (last.end_offset OR ((start_offset + token__display_value(last).bytes())));
    MATCH node START
      Locatable.Program AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.source_range = SourceRange{ file: ( { MUTABLE rtoc_optional_or_source_3: ?String = first.file; MUTABLE rtoc_optional_or_result_4: ?String = NIL; IF rtoc_optional_or_source_3 != NIL THEN rtoc_optional_or_result_4 = COPY rtoc_optional_or_source_3; ELSE rtoc_optional_or_result_4 = last.file; END rtoc_optional_or_result_4 } ), start_offset: start_offset, end_offset: end_offset, start_line: first.line, start_column: first.column, end_line: (last.end_line OR last.line), end_column: (last.end_column OR ((last.column + (CAST(last.value AS String)).codepointCount()))) };
        node = Locatable{ Program: item_mutable };,
      Locatable.RequireNode AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.source_range = SourceRange{ file: ( { MUTABLE rtoc_optional_or_source_3: ?String = first.file; MUTABLE rtoc_optional_or_result_4: ?String = NIL; IF rtoc_optional_or_source_3 != NIL THEN rtoc_optional_or_result_4 = COPY rtoc_optional_or_source_3; ELSE rtoc_optional_or_result_4 = last.file; END rtoc_optional_or_result_4 } ), start_offset: start_offset, end_offset: end_offset, start_line: first.line, start_column: first.column, end_line: (last.end_line OR last.line), end_column: (last.end_column OR ((last.column + (CAST(last.value AS String)).codepointCount()))) };
        node = Locatable{ RequireNode: item_mutable };,
      Locatable.ProtocolRequirement AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.source_range = SourceRange{ file: ( { MUTABLE rtoc_optional_or_source_3: ?String = first.file; MUTABLE rtoc_optional_or_result_4: ?String = NIL; IF rtoc_optional_or_source_3 != NIL THEN rtoc_optional_or_result_4 = COPY rtoc_optional_or_source_3; ELSE rtoc_optional_or_result_4 = last.file; END rtoc_optional_or_result_4 } ), start_offset: start_offset, end_offset: end_offset, start_line: first.line, start_column: first.column, end_line: (last.end_line OR last.line), end_column: (last.end_column OR ((last.column + (CAST(last.value AS String)).codepointCount()))) };
        node = Locatable{ ProtocolRequirement: item_mutable };,
      Locatable.ProtocolDef AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.source_range = SourceRange{ file: ( { MUTABLE rtoc_optional_or_source_3: ?String = first.file; MUTABLE rtoc_optional_or_result_4: ?String = NIL; IF rtoc_optional_or_source_3 != NIL THEN rtoc_optional_or_result_4 = COPY rtoc_optional_or_source_3; ELSE rtoc_optional_or_result_4 = last.file; END rtoc_optional_or_result_4 } ), start_offset: start_offset, end_offset: end_offset, start_line: first.line, start_column: first.column, end_line: (last.end_line OR last.line), end_column: (last.end_column OR ((last.column + (CAST(last.value AS String)).codepointCount()))) };
        node = Locatable{ ProtocolDef: item_mutable };,
      Locatable.FunctionDef AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.source_range = SourceRange{ file: ( { MUTABLE rtoc_optional_or_source_3: ?String = first.file; MUTABLE rtoc_optional_or_result_4: ?String = NIL; IF rtoc_optional_or_source_3 != NIL THEN rtoc_optional_or_result_4 = COPY rtoc_optional_or_source_3; ELSE rtoc_optional_or_result_4 = last.file; END rtoc_optional_or_result_4 } ), start_offset: start_offset, end_offset: end_offset, start_line: first.line, start_column: first.column, end_line: (last.end_line OR last.line), end_column: (last.end_column OR ((last.column + (CAST(last.value AS String)).codepointCount()))) };
        node = Locatable{ FunctionDef: item_mutable };,
      Locatable.ImplementationDef AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.source_range = SourceRange{ file: ( { MUTABLE rtoc_optional_or_source_3: ?String = first.file; MUTABLE rtoc_optional_or_result_4: ?String = NIL; IF rtoc_optional_or_source_3 != NIL THEN rtoc_optional_or_result_4 = COPY rtoc_optional_or_source_3; ELSE rtoc_optional_or_result_4 = last.file; END rtoc_optional_or_result_4 } ), start_offset: start_offset, end_offset: end_offset, start_line: first.line, start_column: first.column, end_line: (last.end_line OR last.line), end_column: (last.end_column OR ((last.column + (CAST(last.value AS String)).codepointCount()))) };
        node = Locatable{ ImplementationDef: item_mutable };,
      Locatable.ConformanceDef AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.source_range = SourceRange{ file: ( { MUTABLE rtoc_optional_or_source_3: ?String = first.file; MUTABLE rtoc_optional_or_result_4: ?String = NIL; IF rtoc_optional_or_source_3 != NIL THEN rtoc_optional_or_result_4 = COPY rtoc_optional_or_source_3; ELSE rtoc_optional_or_result_4 = last.file; END rtoc_optional_or_result_4 } ), start_offset: start_offset, end_offset: end_offset, start_line: first.line, start_column: first.column, end_line: (last.end_line OR last.line), end_column: (last.end_column OR ((last.column + (CAST(last.value AS String)).codepointCount()))) };
        node = Locatable{ ConformanceDef: item_mutable };,
      Locatable.StructDef AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.source_range = SourceRange{ file: ( { MUTABLE rtoc_optional_or_source_3: ?String = first.file; MUTABLE rtoc_optional_or_result_4: ?String = NIL; IF rtoc_optional_or_source_3 != NIL THEN rtoc_optional_or_result_4 = COPY rtoc_optional_or_source_3; ELSE rtoc_optional_or_result_4 = last.file; END rtoc_optional_or_result_4 } ), start_offset: start_offset, end_offset: end_offset, start_line: first.line, start_column: first.column, end_line: (last.end_line OR last.line), end_column: (last.end_column OR ((last.column + (CAST(last.value AS String)).codepointCount()))) };
        node = Locatable{ StructDef: item_mutable };,
      Locatable.VarDecl AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.source_range = SourceRange{ file: ( { MUTABLE rtoc_optional_or_source_3: ?String = first.file; MUTABLE rtoc_optional_or_result_4: ?String = NIL; IF rtoc_optional_or_source_3 != NIL THEN rtoc_optional_or_result_4 = COPY rtoc_optional_or_source_3; ELSE rtoc_optional_or_result_4 = last.file; END rtoc_optional_or_result_4 } ), start_offset: start_offset, end_offset: end_offset, start_line: first.line, start_column: first.column, end_line: (last.end_line OR last.line), end_column: (last.end_column OR ((last.column + (CAST(last.value AS String)).codepointCount()))) };
        node = Locatable{ VarDecl: item_mutable };,
      Locatable.Assignment AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.source_range = SourceRange{ file: ( { MUTABLE rtoc_optional_or_source_3: ?String = first.file; MUTABLE rtoc_optional_or_result_4: ?String = NIL; IF rtoc_optional_or_source_3 != NIL THEN rtoc_optional_or_result_4 = COPY rtoc_optional_or_source_3; ELSE rtoc_optional_or_result_4 = last.file; END rtoc_optional_or_result_4 } ), start_offset: start_offset, end_offset: end_offset, start_line: first.line, start_column: first.column, end_line: (last.end_line OR last.line), end_column: (last.end_column OR ((last.column + (CAST(last.value AS String)).codepointCount()))) };
        node = Locatable{ Assignment: item_mutable };,
      Locatable.DestructureTarget AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.source_range = SourceRange{ file: ( { MUTABLE rtoc_optional_or_source_3: ?String = first.file; MUTABLE rtoc_optional_or_result_4: ?String = NIL; IF rtoc_optional_or_source_3 != NIL THEN rtoc_optional_or_result_4 = COPY rtoc_optional_or_source_3; ELSE rtoc_optional_or_result_4 = last.file; END rtoc_optional_or_result_4 } ), start_offset: start_offset, end_offset: end_offset, start_line: first.line, start_column: first.column, end_line: (last.end_line OR last.line), end_column: (last.end_column OR ((last.column + (CAST(last.value AS String)).codepointCount()))) };
        node = Locatable{ DestructureTarget: item_mutable };,
      Locatable.DestructuringAssignment AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.source_range = SourceRange{ file: ( { MUTABLE rtoc_optional_or_source_3: ?String = first.file; MUTABLE rtoc_optional_or_result_4: ?String = NIL; IF rtoc_optional_or_source_3 != NIL THEN rtoc_optional_or_result_4 = COPY rtoc_optional_or_source_3; ELSE rtoc_optional_or_result_4 = last.file; END rtoc_optional_or_result_4 } ), start_offset: start_offset, end_offset: end_offset, start_line: first.line, start_column: first.column, end_line: (last.end_line OR last.line), end_column: (last.end_column OR ((last.column + (CAST(last.value AS String)).codepointCount()))) };
        node = Locatable{ DestructuringAssignment: item_mutable };,
      Locatable.BindExpr AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.source_range = SourceRange{ file: ( { MUTABLE rtoc_optional_or_source_3: ?String = first.file; MUTABLE rtoc_optional_or_result_4: ?String = NIL; IF rtoc_optional_or_source_3 != NIL THEN rtoc_optional_or_result_4 = COPY rtoc_optional_or_source_3; ELSE rtoc_optional_or_result_4 = last.file; END rtoc_optional_or_result_4 } ), start_offset: start_offset, end_offset: end_offset, start_line: first.line, start_column: first.column, end_line: (last.end_line OR last.line), end_column: (last.end_column OR ((last.column + (CAST(last.value AS String)).codepointCount()))) };
        node = Locatable{ BindExpr: item_mutable };,
      Locatable.BinaryOp AS item ->
        MUTABLE item_mutable = COPY item;
        item_mutable.source_range = SourceRange{ file: ( { MUTABLE rtoc_optional_or_source_3: ?String = first.file; MUTABLE rtoc_optional_or_result_4: ?String = NIL; IF rtoc_optional_or_source_3 != NIL THEN rtoc_optional_or_result_4 = COPY rtoc_optional_or_source_3; ELSE rtoc_optional_or_result_4 = last.file; END rtoc_optional_or_result_4 } ), start_offset: start_offset, end_offset: end_offset, start_line: first.line, start_column: first.column, end_line: (last.end_line OR last.line), end_column: (last.end_column OR ((last.column + (CAST(last.value AS String)).codepointCount()))) };
        node = Locatable{ BinaryOp: item_mutable };,
      Locatable.IsA AS item ->
        MUTABLE item_mutable = COPY item;
