        error_mut(clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :EXPECTED_CAP_SIGIL_AFTER_COLON });
      END
      MUTABLE normalized = IF clearParser__current(rtoc_self_view).value.startsWith?("@") THEN
        clearParser__current(rtoc_self_view).value
      ELSE
        "@${clearParser__current(rtoc_self_view).value}"
      END;
      MUTABLE attrs: ?SigilAttrs = COPY (CAST({"@multiowned": sigil_attrs(:ownership, :multiowned), "@shared": sigil_attrs(:ownership, :shared), "@node": sigil_attrs(:ownership, :node), "@locked": sigil_attrs(:sync, :locked), "@writeLocked": sigil_attrs(:sync, :write_locked), "@local": sigil_attrs(:sync, :local), "@versioned": sigil_attrs(:sync, :versioned), "@atomic": sigil_attrs(:sync, :atomic), "@boxed": sigil_attrs(:layout, :indirect), "@indirect": sigil_attrs(:layout, :indirect), "@alwaysMutable": sigil_attrs(:sync, :always_mutable)} AS {String}SigilAttrs))[normalized];
      IF !(attrs) THEN
        MUTABLE has_at = clearParser__current(rtoc_self_view).value.startsWith?("@");
        MUTABLE candidates: []String = List[];
        IF has_at THEN
          candidates = (CAST({"@multiowned": sigil_attrs(:ownership, :multiowned), "@shared": sigil_attrs(:ownership, :shared), "@node": sigil_attrs(:ownership, :node), "@locked": sigil_attrs(:sync, :locked), "@writeLocked": sigil_attrs(:sync, :write_locked), "@local": sigil_attrs(:sync, :local), "@versioned": sigil_attrs(:sync, :versioned), "@atomic": sigil_attrs(:sync, :atomic), "@boxed": sigil_attrs(:layout, :indirect), "@indirect": sigil_attrs(:layout, :indirect), "@alwaysMutable": sigil_attrs(:sync, :always_mutable)} AS {String}SigilAttrs)).keys();
        ELSE
          candidates = (CAST({"@multiowned": sigil_attrs(:ownership, :multiowned), "@shared": sigil_attrs(:ownership, :shared), "@node": sigil_attrs(:ownership, :node), "@locked": sigil_attrs(:sync, :locked), "@writeLocked": sigil_attrs(:sync, :write_locked), "@local": sigil_attrs(:sync, :local), "@versioned": sigil_attrs(:sync, :versioned), "@atomic": sigil_attrs(:sync, :atomic), "@boxed": sigil_attrs(:layout, :indirect), "@indirect": sigil_attrs(:layout, :indirect), "@alwaysMutable": sigil_attrs(:sync, :always_mutable)} AS {String}SigilAttrs)).keys() |> SELECT regexReplaceFirst(_, "^@", "");
        END
        emit_typo_suggestion_mut(TypoToken{ Token: COPY clearParser__current(rtoc_self_view) }, clearParser__current(rtoc_self_view).value, candidates, "Unknown capability sigil '${clearParser__current(rtoc_self_view).value}'", "closest capability sigil", :capability, TRUE);
      END
      MUTABLE attrs_value: SigilAttrs = attrs?;
      MUTABLE next_tok = clearParser__consume(&rtoc_self_view, :VAR_ID);
      clearParser__emit_boxed_capability_migration(rtoc_self_view, &next_tok);
      clearParser__apply_cap_dim_mut(rtoc_self_view, next_tok, attrs_value, &dims);
      clearParser__parse_lock_rank_arg_mut(rtoc_self_view, next_tok, attrs_value, &dims);
    END
    IF ((clearParser__match?(rtoc_self_view, :VAR_ID) AND clearParser__current(rtoc_self_view).value.startsWith?("@")) AND (CAST({"@multiowned": sigil_attrs(:ownership, :multiowned), "@shared": sigil_attrs(:ownership, :shared), "@node": sigil_attrs(:ownership, :node), "@locked": sigil_attrs(:sync, :locked), "@writeLocked": sigil_attrs(:sync, :write_locked), "@local": sigil_attrs(:sync, :local), "@versioned": sigil_attrs(:sync, :versioned), "@atomic": sigil_attrs(:sync, :atomic), "@boxed": sigil_attrs(:layout, :indirect), "@indirect": sigil_attrs(:layout, :indirect), "@alwaysMutable": sigil_attrs(:sync, :always_mutable)} AS {String}SigilAttrs)).contains?(clearParser__current(rtoc_self_view).value)) THEN
      error_mut(clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :MIXED_AT_CAPABILITIES });
    END
