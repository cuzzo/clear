FN clearParser__parse_with_match_arms(self: ClearParser) RETURNS ![]WithMatchArm
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE arms = List[];
    WHILE clearParser__match?(rtoc_self_view, :KEYWORD, "WHEN") DO
      MUTABLE when_tok = clearParser__consume(&rtoc_self_view, :KEYWORD, "WHEN");
      MUTABLE family = clearParser__parse_requires_family(rtoc_self_view);
      clearParser__consume(&rtoc_self_view, :ARROW, "->");
      MUTABLE body = clearParser__parse_brace_block(&rtoc_self_view);
      MUTABLE lock_error_clauses = List[];
      WHILE (clearParser__match?(rtoc_self_view, :KEYWORD, "ON") OR clearParser__match?(rtoc_self_view, :KEYWORD, "RETRY")) DO
        MUTABLE clause: ?ErrorClause = TRY (clearParser__parse_lock_error_clause(rtoc_self_view));
        IF clause EXISTS AS clause_value THEN
          &lock_error_clauses.append(clause_value);
        END
      END
      &arms.append(WithMatchArm{ family: COPY family, body: COPY body, lock_error_clauses: COPY lock_error_clauses, token: when_tok });
    END
    IF (arms.length() == 0) THEN
      error_mut(clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :WITH_MATCH_NO_WHEN });
    END
    RETURN arms;
}
END
FN clearParser__parse_sync_policy_block(self: ClearParser) RETURNS !SyncPolicyDecl
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE sync_tok = clearParser__consume(&rtoc_self_view, :KEYWORD, "SYNC");
