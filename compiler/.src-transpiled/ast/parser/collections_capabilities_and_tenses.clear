END
FN clearParser__apply_cap_dim_mut(self: ClearParser, tok: Token, attrs: SigilAttrs, MUTABLE dims: CapJoin) RETURNS ?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE dim: ?String@symbol = COPY attrs.dim;
    MUTABLE val: ?String@symbol = COPY attrs.val;
    IF dim EXISTS AS dim_value THEN
      IF val THEN
        MUTABLE current_value_branch_value: ?String@symbol = NIL;
        PARTIAL MATCH dim_value START
          :ownership ->
          current_value_branch_value = COPY dims.ownership;,
          :sync ->
          current_value_branch_value = COPY dims.sync;,
          :layout ->
          current_value_branch_value = COPY dims.layout;,
          DEFAULT ->
          RETURN NIL;
        END
        MUTABLE current_value: ?String@symbol = current_value_branch_value;
        IF ((dim_value == :ownership) AND (((((current_value == :shared) AND (val == :node))) OR (((current_value == :node) AND (val == :shared)))))) THEN
          dims.ownership = :shared_node;
          RETURN :shared_node;
        END
        IF current_value EXISTS AS current_value_value THEN
          error_mut(tok, CodeOrMessage{ SymbolValue: :DUPLICATE_CAPABILITY_DIM }, [], {:dim: dim_value, :current: current_value_value, :attempted: val});
        END
        IF (dim_value == :ownership) THEN
          dims.ownership = val;
        ELSE_IF (dim_value == :sync) THEN
          dims.sync = val;
        ELSE_IF (dim_value == :layout) THEN
          dims.layout = val;
        END
        RETURN val;
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
FN clearParser__parse_lock_rank_arg_mut(self: ClearParser, sigil_tok: Token, attrs: SigilAttrs, MUTABLE dims: CapJoin) RETURNS !?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((attrs.dim == :sync)) THEN
      RETURN;
    END
    IF !(((attrs.val == :locked) OR (attrs.val == :write_locked))) THEN
      RETURN;
    END
    IF !(clearParser__match?(rtoc_self_view, :CHAR, "(")) THEN
      RETURN;
    END
    clearParser__consume(&rtoc_self_view, :CHAR, "(");
    IF !(clearParser__match?(rtoc_self_view, :VAR_ID, "rank")) THEN
      error_mut(clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :EXPECTED_RANK_KEYWORD }, [], {:sigil: attrs.val});
    END
    clearParser__consume(&rtoc_self_view, :VAR_ID, "rank");
    clearParser__consume(&rtoc_self_view, :CHAR, ":");
    MUTABLE neg = clearParser__match_mut(&rtoc_self_view, :CHAR, "-");
    MUTABLE num_tok = clearParser__consume_number(&rtoc_self_view);
    MUTABLE rank = TRY (num_tok.value.toInt());
    IF castClearParserReturnValueToBool(neg) THEN
      rank = (-rank);
    END
    clearParser__consume(&rtoc_self_view, :CHAR, ")");
    IF dims.lock_rank EXISTS AS lock_rank_value THEN
      error_mut(sigil_tok, CodeOrMessage{ SymbolValue: :DUPLICATE_LOCK_RANK }, [], {:current: lock_rank_value, :attempted: rank});
    END
    dims.lock_rank = rank;
    RETURN rank;
}
END
FN clearParser__parse_task_prefix(self: ClearParser, sigils: {String}SigilAttrs, kind: String, prefix_label: String, suggestion_label: String) RETURNS !TaskPrefix
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE pinned: Bool = FALSE;
    MUTABLE parallel: Bool = FALSE;
    MUTABLE arena: Bool = FALSE;
    MUTABLE can_smash: Bool = FALSE;
    MUTABLE stack_size: ?String@symbol = NIL;
    MUTABLE stack_size_token: ?Token = NIL;
    MUTABLE can_smash_token: ?Token = NIL;
    MUTABLE looks_like_sigil = ((clearParser__current(rtoc_self_view).type == :VAR_ID) AND clearParser__current(rtoc_self_view).value.startsWith?("@"));
    IF !(looks_like_sigil) THEN
      RETURN TaskPrefix{ pinned: pinned, parallel: parallel, stack_size: COPY NIL, arena: arena, can_smash: can_smash, stack_size_token: NIL, can_smash_token: NIL };
    END
    WHILE TRUE DO
      MUTABLE tok = clearParser__consume(&rtoc_self_view, :VAR_ID);
      MUTABLE token_text = TRY (token__text_mut(tok));
      MUTABLE cap_name: String = "";
      IF token_text.startsWith?("@") THEN
        cap_name = token_text;
      ELSE
        cap_name = "@${token_text}";
      END
      MUTABLE attrs: ?SigilAttrs = COPY sigils[cap_name];
      IF !(attrs) THEN
        MUTABLE has_at = token_text.startsWith?("@");
        MUTABLE candidates: []String = List[];
        IF has_at THEN
          candidates = sigils.keys();
        ELSE
          candidates = sigils.keys() |> SELECT regexReplaceFirst(_, "^@", "");
        END
        emit_typo_suggestion_mut(TypoToken{ Token: COPY tok }, token_text, candidates, "Unknown ${prefix_label} prefix ${compilerInspectValue()}", suggestion_label, :type, TRUE);
      END
      MUTABLE attrs_value: SigilAttrs = attrs?;
      MUTABLE stack_size_attr: ?String@symbol = COPY attrs_value.stack_size;
      IF stack_size_attr EXISTS AS stack_size_attr_value THEN
        IF NIL EXISTS AS stack_size_value THEN
          error_mut(tok, CodeOrMessage{ SymbolValue: :DUPLICATE_STACK_SIZE }, [], {:kind: kind});
        END
        stack_size = stack_size_attr_value;
        stack_size_token = COPY tok;
      END
      IF attrs_value.pinned THEN
        pinned = TRUE;
      END
      IF attrs_value.parallel THEN
        parallel = TRUE;
      END
      IF attrs_value.arena THEN
        arena = TRUE;
      END
      IF attrs_value.can_smash THEN
        can_smash = TRUE;
        can_smash_token = tok;
      END
      IF !(clearParser__match?(rtoc_self_view, :CHAR, ":")) THEN
        BREAK;
      END
      clearParser__consume(&rtoc_self_view, :CHAR, ":");
    END
    clearParser__consume(&rtoc_self_view, :ARROW, "->");
    RETURN TaskPrefix{ pinned: pinned, parallel: parallel, stack_size: COPY stack_size, arena: arena, can_smash: can_smash, stack_size_token: COPY stack_size_token, can_smash_token: COPY can_smash_token };
}
END
FN clearParser__parse_do_block(self: ClearParser) RETURNS DoBlock
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE do_token = clearParser__consume(&rtoc_self_view, :KEYWORD, "DO");
    clearParser__consume(&rtoc_self_view, :CHAR, "{");
    MUTABLE branches = List[];
    WHILE !((clearParser__match?(rtoc_self_view, :CHAR, "}") OR clearParser__match?(rtoc_self_view, :EOF))) DO
      MUTABLE prefix = clearParser__parse_task_prefix(rtoc_self_view, CAST({"@micro": sigil_attrs(NIL, NIL, :micro), "@stack": sigil_attrs(NIL, NIL, :stack), "@standard": sigil_attrs(NIL, NIL, :standard), "@large": sigil_attrs(NIL, NIL, :large), "@xl": sigil_attrs(NIL, NIL, :xl), "@service": sigil_attrs(NIL, NIL, :service), "@pinned": sigil_attrs(NIL, NIL, NIL, TRUE), "@parallel": sigil_attrs(NIL, NIL, NIL, FALSE, TRUE), "@canSmash": sigil_attrs(NIL, NIL, NIL, FALSE, FALSE, FALSE, TRUE)} AS {String}SigilAttrs), "branch", "branch", "closest DO branch sigil");
      MUTABLE stmt_branch_value: ?Locatable = NIL;
      IF clearParser__match?(rtoc_self_view, :KEYWORD) THEN
        stmt_branch_value = clearParser__parse_statement(&rtoc_self_view);
      ELSE
        stmt_branch_value = clearParser__parse_expression(&rtoc_self_view);
      END
      MUTABLE stmt: Locatable = stmt_branch_value?;
      &branches.append(DoBranch{ body: COPY ([stmt]), pinned: prefix.pinned, parallel: prefix.parallel, stack_size: COPY prefix.stack_size, can_smash: prefix.can_smash, computed_stack_tier: NIL, capture_analysis: NIL });
      IF !(castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, ","))) THEN
        BREAK;
      END
    END
    clearParser__consume(&rtoc_self_view, :CHAR, "}");
    RETURN DoBlock{ token: COPY do_token, branches: branches, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
}
END
FN clearParser__parse_bg_block(self: ClearParser) RETURNS !BgNode
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE bg_token = clearParser__consume(&rtoc_self_view, :KEYWORD, "BG");
    IF clearParser__match?(rtoc_self_view, :KEYWORD, "STREAM") THEN
      RETURN BgNode{ BgStreamBlock: COPY clearParser__parse_bg_stream_block(rtoc_self_view, bg_token) };
    END
    MUTABLE open_brace = clearParser__consume(&rtoc_self_view, :CHAR, "{");
    MUTABLE prefix = clearParser__parse_task_prefix(rtoc_self_view, CAST({"@micro": sigil_attrs(NIL, NIL, :micro), "@stack": sigil_attrs(NIL, NIL, :stack), "@standard": sigil_attrs(NIL, NIL, :standard), "@large": sigil_attrs(NIL, NIL, :large), "@xl": sigil_attrs(NIL, NIL, :xl), "@service": sigil_attrs(NIL, NIL, :service), "@pinned": sigil_attrs(NIL, NIL, NIL, TRUE), "@parallel": sigil_attrs(NIL, NIL, NIL, FALSE, TRUE), "@arena": sigil_attrs(NIL, NIL, NIL, TRUE, FALSE, TRUE), "@canSmash": sigil_attrs(NIL, NIL, NIL, FALSE, FALSE, FALSE, TRUE)} AS {String}SigilAttrs), "BG", "BG", "closest BG body sigil");
    MUTABLE body = TRY (clearParser__parse_bg_then_body(rtoc_self_view));
    clearParser__consume(&rtoc_self_view, :CHAR, "}");
    MUTABLE node = BgBlock{ token: COPY bg_token, body: body, deferred_drops: NIL, stack_size: COPY prefix.stack_size, pinned: prefix.pinned, parallel: prefix.parallel, arena_mode: prefix.arena, can_smash: prefix.can_smash, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, computed_stack_tier: NIL, captures_resource: NIL, capture_analysis: NIL, async_result_shape: NIL, declared_async_payload: NIL, spawn_form: NIL, fsm_ineligible_reason: NIL, fsm_suspend_points: NIL, open_brace_token: NIL, prefix_token: NIL, can_smash_token: NIL };
    node.open_brace_token = open_brace;
    node.prefix_token = COPY prefix.stack_size_token;
    node.can_smash_token = COPY prefix.can_smash_token;
    RETURN BgNode{ BgBlock: COPY node };
}
END
FN clearParser__parse_bg_then_body(self: ClearParser) RETURNS ![]Node
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE stmts = List[];
    WHILE !((clearParser__match?(rtoc_self_view, :CHAR, "}") OR clearParser__match?(rtoc_self_view, :EOF))) DO
      MUTABLE stmt = clearParser__parse_bg_body_stmt(rtoc_self_view);
      IF stmt THEN
        &stmts.append(stmt);
      END
    END
    RETURN stmts;
}
END
FN clearParser__parse_bg_body_stmt(self: ClearParser) RETURNS !Locatable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF ((clearParser__current(rtoc_self_view).type == :VAR_ID) AND clearParser__destructuring_assignment?(rtoc_self_view)) THEN
      RETURN Locatable{ DestructuringAssignment: COPY clearParser__parse_destructuring_assign(rtoc_self_view) };
    END
    MUTABLE rule: ?ParserRule = COPY stmt_rule_index[clearParser__token_rule_key(clearParser__current(rtoc_self_view))];
    IF rule EXISTS AS rule_value THEN
      MUTABLE rule_value_mutable = COPY rule_value;
      RETURN TRY (clearParser__dispatch_stmt_rule(&rtoc_self_view, rule_value_mutable));
    END
    MUTABLE parsed_var_branch_value: ?ParsedVarForm = NIL;
    IF (clearParser__current(rtoc_self_view).type == :VAR_ID) THEN
      parsed_var_branch_value = clearParser__parse_var_form(rtoc_self_view);
    ELSE
      parsed_var_branch_value = NIL;
    END
    MUTABLE parsed_var: ?ParsedVarForm = parsed_var_branch_value;
    IF parsed_var?.assignment THEN
      clearParser__consume(&rtoc_self_view, :CHAR, ";");
      RETURN COPY parsed_var.node;
    END
    MUTABLE expr_branch_value: ?Locatable = NIL;
    IF parsed_var EXISTS AS parsed_var_value THEN
      expr_branch_value = COPY parsed_var_value.node;
    ELSE
      expr_branch_value = clearParser__parse_expression(&rtoc_self_view);
    END
    MUTABLE expr: Locatable = expr_branch_value?;
    IF (clearParser__match?(rtoc_self_view, :KEYWORD, "AS") OR clearParser__match?(rtoc_self_view, :KEYWORD, "THEN")) THEN
      MUTABLE binding_name = NIL;
      IF clearParser__match?(rtoc_self_view, :KEYWORD, "AS") THEN
        clearParser__consume(&rtoc_self_view, :KEYWORD, "AS");
        binding_name = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :VAR_ID)));
      END
      IF !(clearParser__match?(rtoc_self_view, :KEYWORD, "THEN")) THEN
        error_mut(clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :EXPECTED_THEN_AFTER_AS_BG }, [], {:got: compilerInspectValue()});
      END
      MUTABLE steps = [ThenStep{ expr: COPY expr, binding: COPY binding_name }];
      WHILE clearParser__match?(rtoc_self_view, :KEYWORD, "THEN") DO
        clearParser__consume(&rtoc_self_view, :KEYWORD, "THEN");
        MUTABLE next_expr = clearParser__parse_expression(&rtoc_self_view);
        MUTABLE next_binding = NIL;
        IF clearParser__match?(rtoc_self_view, :KEYWORD, "AS") THEN
          clearParser__consume(&rtoc_self_view, :KEYWORD, "AS");
          next_binding = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :VAR_ID)));
        END
        &steps.append(ThenStep{ expr: COPY next_expr, binding: COPY next_binding });
      END
      clearParser__match_mut(&rtoc_self_view, :CHAR, ";");
      RETURN Locatable{ ThenChain: COPY ThenChain{ token: COPY steps.first().expr.token(), steps: steps, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL } };
    END
    clearParser__consume(&rtoc_self_view, :CHAR, ";");
    RETURN expr;
}
END
FN clearParser__parse_bg_stream_block(self: ClearParser, bg_token: Token) RETURNS BgStreamBlock
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    clearParser__consume(&rtoc_self_view, :KEYWORD, "STREAM");
    MUTABLE yields_token: ?Token = NIL;
    MUTABLE declared_yield_type: ?Type = NIL;
    IF clearParser__match?(rtoc_self_view, :KEYWORD, "YIELDS") THEN
      yields_token = clearParser__consume(&rtoc_self_view, :KEYWORD, "YIELDS");
      declared_yield_type = clearParser__parse_type_annotation(&rtoc_self_view);
    END
    MUTABLE body = clearParser__parse_brace_block(&rtoc_self_view);
    MUTABLE node = BgStreamBlock{ token: COPY bg_token, body: body, deferred_drops: NIL, stack_size: NIL, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, computed_stack_tier: NIL, capture_analysis: NIL, spawn_form: NIL, fsm_ineligible_reason: NIL, fsm_suspend_points: NIL, declared_yield_type: NIL, yields_token: NIL };
    bgStreamBlock__set_yield_contract(&node, declared_yield_type, yields_token);
    RETURN node;
}
END
FN clearParser__parse_yield_expr(self: ClearParser) RETURNS YieldExpr
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE tok = clearParser__consume(&rtoc_self_view, :KEYWORD, "YIELD");
    MUTABLE expr = clearParser__parse_expression(&rtoc_self_view);
    clearParser__consume(&rtoc_self_view, :CHAR, ";");
    RETURN YieldExpr{ token: COPY tok, expr: COPY expr, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
}
END
FN clearParser__parse_close_stream(self: ClearParser) RETURNS CloseStream
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE tok = clearParser__consume(&rtoc_self_view, :KEYWORD, "CLOSE");
