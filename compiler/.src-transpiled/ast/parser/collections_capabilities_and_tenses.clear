REQUIRE "../type.clear"
REQUIRE "../lexer.clear"
REQUIRE "../ast.clear"
REQUIRE "state.clear"
REQUIRE "types.clear"
REQUIRE "expressions_and_postfix.clear"
REQUIRE "statements_and_control_flow.clear"
REQUIRE "declarations_and_definitions.clear"
REQUIRE "../parser_rules.clear"
REQUIRE "../parser.clear"
PRIVATE FN clearParser__parse_capabilities(self: ClearParser) RETURNS CapabilityParseResult
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE result = CapabilityParseResult{ ownership: NIL, sync: NIL, collection: NIL, is_soa: FALSE, is_indirect: FALSE, shard_count: NIL, observable: FALSE, observable_token: NIL };
    IF !((clearParser__match?(rtoc_self_view, :VAR_ID) AND capability_tokens.contains?(clearParser__current(rtoc_self_view).value))) THEN
      RETURN result;
    END
    clearParser__apply_capability_mut(rtoc_self_view, &result, clearParser__consume(&rtoc_self_view, :VAR_ID));
    clearParser__parse_capability_chain_mut(rtoc_self_view, result);
    RETURN result;
}
END
PRIVATE FN clearParser__parse_constructor_capabilities(self: ClearParser, type_token: Token, constructor_name: String) RETURNS !CapabilityParseResult
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE result = CapabilityParseResult{ ownership: NIL, sync: NIL, collection: NIL, is_soa: FALSE, is_indirect: FALSE, shard_count: NIL, observable: FALSE, observable_token: NIL };
    IF !((((clearParser__match?(rtoc_self_view, :VAR_ID) AND capability_tokens.contains?(clearParser__current(rtoc_self_view).value))) OR clearParser__match?(rtoc_self_view, :CHAR, ":"))) THEN
      RETURN result;
    END
    MUTABLE allowed = ["@soa", "@sharded"];
    MUTABLE cap_tok = Token{ type: :VAR_ID, value: "@${constructor_name.downcase()}", line: type_token.line, column: type_token.column, file: NIL, start_offset: NIL, end_offset: NIL, end_line: NIL, end_column: NIL };
    IF clearParser__match?(rtoc_self_view, :VAR_ID) THEN
      MUTABLE tok = clearParser__consume(&rtoc_self_view, :VAR_ID);
      MUTABLE normalized: String = "";
      IF (TRY (token__text_mut(tok))).startsWith?("@") THEN
        normalized = TRY (token__text_mut(tok));
      ELSE
        normalized = "@${TRY (token__text_mut(tok))}";
      END
      IF !(allowed.contains?(normalized)) THEN
        error_mut(tok, CodeOrMessage{ SymbolValue: :CAP_BAD_MODIFIER }, [], {:cap: TRY (token__text_mut(cap_tok)), :modifier: TRY (token__text_mut(tok))});
      END
      clearParser__apply_capability_mut(rtoc_self_view, &result, tok, normalized, TRUE);
    END
    clearParser__parse_capability_chain_mut(rtoc_self_view, result, allowed, &cap_tok, TRUE);
    RETURN result;
}
END
PRIVATE FN clearParser__parse_capability_chain_mut(self: ClearParser, MUTABLE result: CapabilityParseResult, allowed_values: []String, MUTABLE cap_tok: ?Token = NIL, validate_shard_count: Bool = FALSE) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    WHILE clearParser__match?(rtoc_self_view, :CHAR, ":") DO
      clearParser__consume(&rtoc_self_view, :CHAR, ":");
      IF !((clearParser__current(rtoc_self_view).type == :VAR_ID)) THEN
        error_mut(clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :EXPECTED_CAP_AFTER_COLON });
      END
      MUTABLE tok = clearParser__consume(&rtoc_self_view, :VAR_ID);
      MUTABLE normalized_value: String = "";
      IF (TRY (token__text_mut(tok))).startsWith?("@") THEN
        normalized_value = TRY (token__text_mut(tok));
      ELSE
        normalized_value = "@${TRY (token__text_mut(tok))}";
      END
      IF (!((allowed_values.length() == 0)) AND !(allowed_values.contains?(normalized_value))) THEN
        error_mut(tok, CodeOrMessage{ SymbolValue: :CAP_BAD_MODIFIER }, [], {:cap: ((IF cap_tok != NIL THEN
          TRY (token__text_mut((cap_tok?)))
        ELSE
          NIL
        END) OR_ELSE "capability"), :modifier: TRY (token__text_mut(tok))});
      END
      clearParser__apply_capability_mut(rtoc_self_view, &result, tok, normalized_value, validate_shard_count);
    END
}
END
PRIVATE FN clearParser__parse_element_capability(self: ClearParser) RETURNS !ElementCapability
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE result = ElementCapability{ ownership: NIL, sync: NIL, layout: NIL };
    IF !((clearParser__match?(rtoc_self_view, :VAR_ID) AND element_capability_tokens.contains?(clearParser__current(rtoc_self_view).value))) THEN
      RETURN result;
    END
    IF !(clearParser__element_capability_suffix?(rtoc_self_view)) THEN
      RETURN result;
    END
    MUTABLE token = clearParser__consume(&rtoc_self_view, :VAR_ID);
    clearParser__emit_boxed_capability_migration(rtoc_self_view, &token);
    clearParser__apply_element_capability_mut(rtoc_self_view, &result, TRY (token__text_mut(token)));
    IF clearParser__match?(rtoc_self_view, :CHAR, ":") THEN
      clearParser__consume(&rtoc_self_view, :CHAR, ":");
      token = clearParser__consume(&rtoc_self_view, :VAR_ID);
      clearParser__emit_boxed_capability_migration(rtoc_self_view, &token);
      clearParser__apply_element_capability_mut(rtoc_self_view, &result, TRY (token__text_mut(token)));
    END
    RETURN result;
}
END
PRIVATE FN clearParser__element_capability_suffix?(self: ClearParser) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE next_tok: ?Token = clearParser__peek_at(rtoc_self_view, 1);
    IF clearParser__token_char?(rtoc_self_view, next_tok, "[") THEN
      RETURN TRUE;
    END
    IF !(clearParser__token_char?(rtoc_self_view, next_tok, ":")) THEN
      RETURN FALSE;
    END
    MUTABLE sync_tok: ?Token = clearParser__peek_at(rtoc_self_view, 2);
    IF !((clearParser__token_var?(rtoc_self_view, sync_tok) AND clearParser__token_char?(rtoc_self_view, clearParser__peek_at(rtoc_self_view, 3), "["))) THEN
      RETURN FALSE;
    END
    MUTABLE joined = TRY (token__text_mut(UNWRAP (sync_tok)));
    RETURN (element_sync_tokens.contains?(joined) OR (["node", "@node", "shared", "@shared"]).contains?(joined));
}
END
PRIVATE FN clearParser__apply_element_capability_mut(self: ClearParser, MUTABLE result: ElementCapability, value: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (value == "@shared") THEN
      result.ownership = IF (result.ownership == :node) THEN
        :shared_node
      ELSE
        :shared
      END;
    ELSE_IF (value == "@multiowned") THEN
      result.ownership = :multiowned;
    ELSE_IF (value == "@node") THEN
      result.ownership = IF (result.ownership == :shared) THEN
        :shared_node
      ELSE
        :node
      END;
    ELSE_IF (value == "shared") THEN
      result.ownership = IF (result.ownership == :node) THEN
        :shared_node
      ELSE
        :shared
      END;
    ELSE_IF (value == "node") THEN
      result.ownership = IF (result.ownership == :shared) THEN
        :shared_node
      ELSE
        :node
      END;
    ELSE_IF (value == "@locked") OR (value == "locked") THEN
      result.sync = :locked;
    ELSE_IF (value == "@writeLocked") OR (value == "writeLocked") THEN
      result.sync = :write_locked;
    ELSE_IF (value == "@alwaysMutable") OR (value == "alwaysMutable") THEN
      result.sync = :always_mutable;
    ELSE_IF (value == "@link") THEN
      result.ownership = :link;
    ELSE_IF (value == "@boxed") OR (value == "boxed") OR (value == "@indirect") OR (value == "indirect") THEN
      result.layout = :indirect;
    END
}
END
PRIVATE FN clearParser__token_char?(self: ClearParser, token: ?Token, value: String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF token EXISTS AS token_value THEN
      RETURN ((token_value.type == :CHAR) AND (token_value.value == value));
    ELSE
      RETURN FALSE;
    END
}
END
PRIVATE FN clearParser__token_var?(self: ClearParser, token: ?Token) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ((token != NIL) AND (token.type == :VAR_ID));
}
END
PRIVATE FN clearParser__apply_capability_mut(self: ClearParser, MUTABLE result: CapabilityParseResult, MUTABLE token: Token, value: String = token.value, validate_shard_count: Bool = FALSE) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    clearParser__emit_boxed_capability_migration(rtoc_self_view, &token);
    MUTABLE ownership: ?String@symbol = COPY (CAST({"@multiowned": :multiowned, "@shared": :shared, "@node": :node, "@split": :split, "@link": :link} AS {String}String@symbol))[value];
    IF ownership EXISTS AS ownership_value THEN
      MUTABLE current: ?String@symbol = COPY result.ownership;
      IF ((((current == :shared) AND (ownership_value == :node))) OR (((current == :node) AND (ownership_value == :shared)))) THEN
        result.ownership = :shared_node;
      ELSE
        IF current EXISTS AS current_value THEN
          error_mut(token, CodeOrMessage{ SymbolValue: :DUPLICATE_OWNERSHIP_CAP });
        END
        result.ownership = ownership_value;
      END
      RETURN;
    END
    MUTABLE sync: ?String@symbol = COPY (CAST({"@locked": :locked, "@writeLocked": :write_locked, "@alwaysMutable": :always_mutable, "@local": :local, "@versioned": :versioned, "@atomic": :atomic, "@raw": :raw, "@symbol": :symbol, "@c": :c, "@size": :size} AS {String}String@symbol))[value];
    IF sync EXISTS AS sync_value THEN
      IF result.sync EXISTS AS sync_value_2 THEN
        error_mut(token, CodeOrMessage{ SymbolValue: :DUPLICATE_SYNC_CAP });
      END
      result.sync = sync_value;
      RETURN;
    END
    MUTABLE collection: ?String@symbol = COPY (CAST({"@list": :list, "@pool": :pool, "@set": :set} AS {String}String@symbol))[value];
    IF collection EXISTS AS collection_value THEN
      IF result.collection EXISTS AS collection_value_2 THEN
        error_mut(token, CodeOrMessage{ SymbolValue: :DUPLICATE_COLLECTION_CAP });
      END
      result.collection = collection_value;
      RETURN;
    END
    IF (value == "@boxed") OR (value == "@indirect") THEN
      IF result.is_indirect THEN
        error_mut(token, CodeOrMessage{ SymbolValue: :DUPLICATE_LAYOUT_CAP });
      END
      result.is_indirect = TRUE;
    ELSE_IF (value == "@soa") THEN
      IF result.is_soa THEN
        error_mut(token, CodeOrMessage{ SymbolValue: :DUPLICATE_SOA_CAP });
      END
      result.is_soa = TRUE;
    ELSE_IF (value == "@sharded") THEN
      IF result.shard_count EXISTS AS shard_count_value THEN
        error_mut(token, CodeOrMessage{ SymbolValue: :DUPLICATE_SHARD_COUNT_CAP });
      END
      clearParser__consume(&rtoc_self_view, :CHAR, "(");
      MUTABLE count_tok = clearParser__consume_number(&rtoc_self_view);
      MUTABLE count = TRY (count_tok.value.toInt());
      IF (validate_shard_count AND (count < 2)) THEN
        error_mut(count_tok, CodeOrMessage{ SymbolValue: :SHARDED_TOO_FEW }, [], {:count: count});
      END
      result.shard_count = count;
      clearParser__consume(&rtoc_self_view, :CHAR, ")");
    ELSE_IF (value == "@observable") THEN
      IF result.observable THEN
        error_mut(token, CodeOrMessage{ SymbolValue: :DUPLICATE_OBSERVABLE_CAP });
      END
      result.observable = TRUE;
      result.observable_token = COPY token;
    ELSE
      emit_typo_suggestion_mut(TypoToken{ Token: COPY token }, value, capability_tokens, "Unknown capability modifier '${value}'", "closest capability", :capability, TRUE);
    END
}
END
FN clearParser__parse_with_capability(self: ClearParser) RETURNS !?WithBlock
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE with_token = clearParser__consume(&rtoc_self_view, :KEYWORD, "WITH");
    IF ((clearParser__match?(rtoc_self_view, :KEYWORD, "VIEW") OR clearParser__match?(rtoc_self_view, :KEYWORD, "MATERIALIZED")) OR clearParser__match?(rtoc_self_view, :KEYWORD, "UNSAFE")) THEN
      RETURN clearParser__parse_view_block(rtoc_self_view, with_token);
    END
    IF clearParser__match?(rtoc_self_view, :KEYWORD, "SNAPSHOT") THEN
      RETURN TRY (clearParser__parse_snapshot_block(rtoc_self_view, with_token));
    END
    MUTABLE polymorphic = FALSE;
    IF clearParser__match?(rtoc_self_view, :KEYWORD, "POLYMORPHIC") THEN
      clearParser__consume(&rtoc_self_view, :KEYWORD, "POLYMORPHIC");
      polymorphic = TRUE;
    END
    MUTABLE escape_tok = NIL;
    IF (clearParser__match?(rtoc_self_view, :KEYWORD, "POSSIBLE_DEADLOCK") OR clearParser__match?(rtoc_self_view, :KEYWORD, "POSSIBLE_LOCK_CYCLE")) THEN
      escape_tok = clearParser__consume(&rtoc_self_view, :KEYWORD);
    END
    MUTABLE capabilities = List[];
    IF clearParser__match?(rtoc_self_view, :TYPE_ID) THEN
      MUTABLE typo_tok = clearParser__current(rtoc_self_view);
      emit_typo_suggestion_mut(TypoToken{ Token: COPY typo_tok }, typo_tok.value, ruby_constant_capabilities() |> SELECT _.toString(), "Unknown WITH capability '${typo_tok.value}'", "closest WITH capability", :capability, TRUE);
    END
    WHILE (clearParser__match?(rtoc_self_view, :KEYWORD) OR clearParser__match?(rtoc_self_view, :VAR_ID)) DO
      MUTABLE capability =     IF (clearParser__match?(rtoc_self_view, :KEYWORD) AND (clearParser__current(rtoc_self_view).value != "AS")) THEN
        {
    MUTABLE rtoc_value_block_marker = 0;
    cap_tok = clearParser__consume(&rtoc_self_view, :KEYWORD);
    cap = symbol((TRY (token__text_mut(cap_tok))));
    IF !(ruby_constant_capabilities().contains?(cap)) THEN
        emit_typo_suggestion_mut(TypoToken{ Token: COPY cap_tok }, TRY (token__text_mut(cap_tok)), ruby_constant_capabilities() |> SELECT _.toString(), "Unknown WITH capability '${cap}'", "closest WITH capability", :capability, TRUE);
      END
    cap
      }
      ELSE
        :infer
      END;
      MUTABLE var_node = clearParser__parse_var_id(&rtoc_self_view);
      MUTABLE alias_name = NIL;
      MUTABLE alias_mutable = FALSE;
      IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "AS")) THEN
        IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "MUTABLE")) THEN
          alias_mutable = TRUE;
        END
        alias_name = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :VAR_ID)));
      END
      MUTABLE guard_expr = NIL;
      IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "GUARD")) THEN
        IF !(alias_name) THEN
          error_mut(clearParser__previous(rtoc_self_view), CodeOrMessage{ SymbolValue: :WITH_GUARD_REQUIRES_AS });
        END
        guard_expr = clearParser__parse_expression(&rtoc_self_view);
      END
      &capabilities.append(Capability{ capability: COPY capability, var_node: var_node, alias_value: alias_name, alias_mutable: alias_mutable, guard_expr: guard_expr, snapshot_token: NIL, view_token: NIL, view_length: NIL, as_token: NIL, resolved_type: type__new(TypeConstructionInput{ SymbolValue: :Untyped }), old_scope: NIL });
      IF !(castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, ","))) THEN
        BREAK;
      END
    END
    IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "MATCH")) THEN
      MUTABLE arms = TRY (clearParser__parse_with_match_arms(rtoc_self_view));
      clearParser__consume(&rtoc_self_view, :KEYWORD, "END");
      MUTABLE node = WithBlock{ token: COPY with_token, capabilities: COPY capabilities, body: COPY List[], deferred_drops: NIL, capability_plan: NIL, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, lock_error_clause: NIL, deadlock_escape: NIL, view_kind: NIL, snapshot_mode: NIL, polymorphic: NIL, universal_poly: NIL, arms: NIL };
      node.arms = arms;
      node.polymorphic = polymorphic;
      IF escape_tok THEN
        node.deadlock_escape = {:kind: IF (escape_tok.value() == "POSSIBLE_DEADLOCK") THEN
          :deadlock
        ELSE
          :lock_cycle
        END, :token: escape_tok};
      END
      RETURN node;
    END
    MUTABLE body = clearParser__parse_brace_block(&rtoc_self_view);
    MUTABLE node = WithBlock{ token: COPY with_token, capabilities: COPY capabilities, body: COPY body, deferred_drops: NIL, capability_plan: NIL, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, lock_error_clause: NIL, deadlock_escape: NIL, view_kind: NIL, snapshot_mode: NIL, polymorphic: NIL, universal_poly: NIL, arms: NIL };
    node.lock_error_clause = TRY (clearParser__parse_lock_error_clause(rtoc_self_view));
    node.polymorphic = polymorphic;
    IF escape_tok THEN
      node.deadlock_escape = {:kind: IF (escape_tok.value() == "POSSIBLE_DEADLOCK") THEN
        :deadlock
      ELSE
        :lock_cycle
      END, :token: escape_tok};
    END
    RETURN node;
}
END
FN clearParser__parse_snapshot_block(self: ClearParser, with_token: Token) RETURNS !?WithBlock
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE capabilities = List[];
    MUTABLE any_mutable: Bool = FALSE;
    WHILE TRUE DO
      MUTABLE snapshot_tok = clearParser__consume(&rtoc_self_view, :KEYWORD, "SNAPSHOT");
      MUTABLE var_node = clearParser__parse_var_id(&rtoc_self_view);
      clearParser__consume(&rtoc_self_view, :KEYWORD, "AS");
      MUTABLE alias_mutable = FALSE;
      IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "MUTABLE")) THEN
        alias_mutable = TRUE;
      END
      MUTABLE alias_name = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :VAR_ID)));
      &capabilities.append(Capability{ capability: symbol("SNAPSHOT"), var_node: var_node, alias_value: alias_name, alias_mutable: alias_mutable, snapshot_token: snapshot_tok, guard_expr: NIL, view_token: NIL, view_length: NIL, as_token: NIL, resolved_type: type__new(TypeConstructionInput{ SymbolValue: :Untyped }), old_scope: NIL });
      any_mutable = (any_mutable OR alias_mutable);
      IF !(castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, ","))) THEN
        BREAK;
      END
    END
    IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "MATCH")) THEN
      MUTABLE arms = TRY (clearParser__parse_with_match_arms(rtoc_self_view));
      clearParser__consume(&rtoc_self_view, :KEYWORD, "END");
      MUTABLE node = WithBlock{ token: COPY with_token, capabilities: COPY capabilities, body: COPY List[], deferred_drops: NIL, capability_plan: NIL, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, lock_error_clause: NIL, deadlock_escape: NIL, view_kind: NIL, snapshot_mode: NIL, polymorphic: NIL, universal_poly: NIL, arms: NIL };
      node.arms = arms;
      node.snapshot_mode = IF any_mutable THEN
        :transaction
      ELSE
        :read
      END;
      RETURN node;
    END
    MUTABLE body = clearParser__parse_brace_block(&rtoc_self_view);
    MUTABLE clause: ?ErrorClause = TRY (clearParser__parse_lock_error_clause(rtoc_self_view));
    MUTABLE node = WithBlock{ token: COPY with_token, capabilities: COPY capabilities, body: COPY body, deferred_drops: NIL, capability_plan: NIL, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, lock_error_clause: NIL, deadlock_escape: NIL, view_kind: NIL, snapshot_mode: NIL, polymorphic: NIL, universal_poly: NIL, arms: NIL };
    node.snapshot_mode = IF any_mutable THEN
      :transaction
    ELSE
      :read
    END;
    node.lock_error_clause = clause;
    RETURN node;
}
END
FN clearParser__parse_view_block(self: ClearParser, with_token: Token) RETURNS !WithBlock
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE body: []Node = List[];
    MUTABLE view_kind = NIL;
    MUTABLE view_token = NIL;
    MUTABLE view_length = NIL;
    IF clearParser__match?(rtoc_self_view, :KEYWORD, "UNSAFE") THEN
      view_token = clearParser__consume(&rtoc_self_view, :KEYWORD, "UNSAFE");
      clearParser__consume(&rtoc_self_view, :KEYWORD, "VIEW");
      view_kind = :unsafe_view;
      MUTABLE capability = :UNSAFE_VIEW;
    ELSE_IF clearParser__match?(rtoc_self_view, :KEYWORD, "MATERIALIZED") THEN
      MUTABLE mat_tok = clearParser__consume(&rtoc_self_view, :KEYWORD, "MATERIALIZED");
      view_token = clearParser__consume(&rtoc_self_view, :KEYWORD, "VIEW");
      view_kind = :materialized_view;
      MUTABLE capability = :MATERIALIZED_VIEW;
      view_token = mat_tok;
    ELSE
      view_token = clearParser__consume(&rtoc_self_view, :KEYWORD, "VIEW");
      view_kind = :view;
      capability = symbol("VIEW");
    END
    MUTABLE var_node = clearParser__parse_var_id(&rtoc_self_view);
    IF (view_kind == :unsafe_view) THEN
      clearParser__consume(&rtoc_self_view, :KEYWORD, "LENGTH");
      view_length = clearParser__parse_expression(&rtoc_self_view, 2);
    END
