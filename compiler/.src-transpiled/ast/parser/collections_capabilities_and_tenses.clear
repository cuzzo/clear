FN clearParser__parse_lock_error_clause(self: ClearParser) RETURNS !?ErrorClause
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF clearParser__match?(rtoc_self_view, :KEYWORD, "ON") THEN
      clearParser__consume(&rtoc_self_view, :KEYWORD, "ON");
      MUTABLE selectors = TRY (clearParser__parse_error_selectors(rtoc_self_view));
      MUTABLE retries: ?Int64 = clearParser__match_optional_retry_mut(rtoc_self_view);
      MUTABLE action = clearParser__parse_lock_action(rtoc_self_view);
      RETURN errorClause__from_action(selectors, retries, action);
    ELSE_IF clearParser__match?(rtoc_self_view, :KEYWORD, "RETRY") THEN
      retries = clearParser__match_optional_retry_mut(rtoc_self_view);
      action = clearParser__parse_lock_action(rtoc_self_view);
      RETURN errorClause__from_action([ErrorSelector{ form: :kind, name: :Transient, token: KEEP action.token }], retries, action);
    ELSE
      RETURN NIL;
    END
}
END
FN clearParser__match_optional_retry_mut(self: ClearParser) RETURNS !?Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "RETRY"))) THEN
      RETURN NIL;
    END
    clearParser__consume(&rtoc_self_view, :CHAR, "(");
    MUTABLE tok = clearParser__consume_number(&rtoc_self_view);
    MUTABLE n = TRY (tok.value.toInt());
    IF (n <= 0) THEN
      error_mut(tok, CodeOrMessage{ SymbolValue: :RETRY_N_NONPOSITIVE }, [], {:got: n});
    END
    clearParser__consume(&rtoc_self_view, :CHAR, ")");
    clearParser__consume(&rtoc_self_view, :KEYWORD, "THEN");
    RETURN n;
}
END
FN clearParser__parse_error_selectors(self: ClearParser) RETURNS ![]ErrorSelector
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE selectors = [clearParser__parse_error_selector(rtoc_self_view)];
    WHILE castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, ",")) DO
      &selectors.append(clearParser__parse_error_selector(rtoc_self_view));
    END
    RETURN selectors;
}
END
FN clearParser__parse_error_selector(self: ClearParser) RETURNS !ErrorSelector
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(clearParser__match?(rtoc_self_view, :TYPE_ID)) THEN
      error_mut(clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :EXPECTED_ERROR_SELECTOR });
    END
    MUTABLE tok = clearParser__consume(&rtoc_self_view, :TYPE_ID);
    MUTABLE form = IF (ruby_constant_error_kinds() |> SELECT _.toString()) |> SELECT _.toString().contains?(TRY (token__text_mut(tok))) THEN
      :kind
    ELSE
      :type
    END;
    RETURN ErrorSelector{ form: COPY form, name: COPY symbol((TRY (token__text_mut(tok)))), token: tok };
}
END
FN clearParser__parse_lock_action(self: ClearParser) RETURNS ErrorAction
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "RAISE")) THEN
      RETURN ErrorAction{ action: COPY ErrorActionKind.Raise, token: clearParser__previous(rtoc_self_view), value: NIL, message: NIL, body: List[] };
