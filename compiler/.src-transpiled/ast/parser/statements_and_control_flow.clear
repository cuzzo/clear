PRIVATE FN clearParser__parse_match_start(self: ClearParser) RETURNS ParsedMatchStart
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE token = clearParser__consume(&rtoc_self_view, :KEYWORD, "MATCH");
    MUTABLE takes = !(!(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "TAKES")));
    MUTABLE subject = clearParser__parse_expression(&rtoc_self_view);
    clearParser__consume(&rtoc_self_view, :KEYWORD, "START");
    RETURN ParsedMatchStart{ token: COPY token, subject: COPY subject, takes: takes };
