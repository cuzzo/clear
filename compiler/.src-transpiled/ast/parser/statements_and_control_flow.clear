PRIVATE FN clearParser__brace_literal_is_hash?(self: ClearParser) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(clearParser__match?(rtoc_self_view, :CHAR, "{")) THEN
      RETURN FALSE;
    END
    IF clearParser__match_at?(rtoc_self_view, 1, :CHAR, "}") THEN
      RETURN TRUE;
    END
    MUTABLE first: ?Token = clearParser__peek_at(rtoc_self_view, 1);
    IF (((first != NIL) AND (first.type == :KEYWORD)) AND value_block_statement_keywords.contains?((UNWRAP (first)).value)) THEN
      RETURN FALSE;
    END
    MUTABLE depth = 0;
    MUTABLE offset = 0;
    WHILE TRUE DO
      MUTABLE token: ?Token = clearParser__peek_at(rtoc_self_view, offset);
      IF token EXISTS AS token_value THEN
        MUTABLE token_value_mutable = COPY token_value;
        IF (token_value_mutable.type == :CHAR) THEN
          MUTABLE token_value = TRY (token__text_mut(token_value_mutable));
          IF (token_value == "{") OR (token_value == "(") OR (token_value == "[") THEN
            MUTABLE closing_index: ?Int64 = rtoc_self_view.delimiter_closings[(rtoc_self_view.pos + offset)];
            IF ((depth > 0) AND (closing_index)) THEN
              offset = ((closing_index - rtoc_self_view.pos) + 1);
              CONTINUE;
            END
            depth = (depth + 1);
          ELSE_IF (token_value == "}") OR (token_value == ")") OR (token_value == "]") THEN
            depth = (depth - 1);
            IF (depth <= 0) THEN
              RETURN FALSE;
            END
          ELSE_IF (token_value == ";") THEN
            IF (depth == 1) THEN
              RETURN FALSE;
            END
          ELSE_IF (token_value == ":") THEN
            IF (depth == 1) THEN
              RETURN !(clearParser__top_level_assignment_before_brace_delimiter?(rtoc_self_view, (offset + 1)));
            END
          END
        END
        offset = (offset + 1);
      ELSE
        RETURN FALSE;
      END
    END
    RETURN NIL;
}
END
PRIVATE FN clearParser__top_level_assignment_before_brace_delimiter?(self: ClearParser, start_offset: Int64) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE depth = 1;
    MUTABLE offset = start_offset;
    WHILE TRUE DO
      MUTABLE token: ?Token = clearParser__peek_at(rtoc_self_view, offset);
      IF token EXISTS AS token_value THEN
        MUTABLE token_value_mutable = COPY token_value;
        IF ((token_value_mutable.type == :COMPOUND_ASSIGN) AND (depth == 1)) THEN
          RETURN TRUE;
        ELSE_IF (token_value_mutable.type == :CHAR) THEN
          MUTABLE token_value = TRY (token__text_mut(token_value_mutable));
          IF (token_value == "{") OR (token_value == "(") OR (token_value == "[") THEN
            MUTABLE closing_index: ?Int64 = rtoc_self_view.delimiter_closings[(rtoc_self_view.pos + offset)];
            IF closing_index EXISTS AS closing_index_value THEN
              offset = ((closing_index_value - rtoc_self_view.pos) + 1);
              CONTINUE;
            END
            depth = (depth + 1);
          ELSE_IF (token_value == "}") OR (token_value == ")") OR (token_value == "]") THEN
            depth = (depth - 1);
            IF (depth <= 0) THEN
              RETURN FALSE;
            END
          ELSE_IF (token_value == ",") OR (token_value == ";") THEN
            IF (depth == 1) THEN
              RETURN FALSE;
            END
          ELSE_IF (token_value == "=") THEN
            IF (depth == 1) THEN
              RETURN TRUE;
            END
          END
        END
        offset = (offset + 1);
      ELSE
        RETURN FALSE;
      END
    END
    RETURN NIL;
}
END
PRIVATE FN clearParser__parse_match_expr(self: ClearParser, MUTABLE partial_value: Bool = FALSE) RETURNS MatchStatement
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE start = clearParser__parse_match_start(rtoc_self_view);
    MUTABLE cases = List[];
    MUTABLE default_case: ?[]Node = NIL;
    WHILE !((clearParser__match?(rtoc_self_view, :KEYWORD, "END") OR clearParser__match?(rtoc_self_view, :EOF))) DO
