UNION ClearParserReturnValue { ForRange: ForRange, ForEach: ForEach, Token: Token, BoolValue: Bool, VarDecl: VarDecl, DestructuringAssignment: DestructuringAssignment, ExternFnDecl: ExternFnDecl, ExternStructDecl: ExternStructDecl, ImplementationDef: ImplementationDef, ConformanceDef: ConformanceDef, Program: Program, RequireNode: RequireNode, ProtocolRequirement: ProtocolRequirement, ProtocolDef: ProtocolDef, FunctionDef: FunctionDef, StructDef: StructDef, Assignment: Assignment, DestructureTarget: DestructureTarget, BindExpr: BindExpr, BinaryOp: BinaryOp, IsA: IsA, UnaryOp: UnaryOp, CallSiteOverride: CallSiteOverride, Identifier: Identifier, Literal: Literal, ListLit: ListLit, TupleLit: TupleLit, DefaultArrayLit: DefaultArrayLit, HashLit: HashLit, DefaultLit: DefaultLit, StructLit: StructLit, LambdaLit: LambdaLit, IfStatement: IfStatement, IfBind: IfBind, WhileLoop: WhileLoop, WhileBindLoop: WhileBindLoop, BreakNode: BreakNode, ContinueNode: ContinueNode, FuncCall: FuncCall, MethodCall: MethodCall, GetField: GetField, GetIndex: GetIndex, Cast: Cast, ReturnNode: ReturnNode, Assert: Assert, Raise: Raise, ThrowNode: ThrowNode, DieNode: DieNode, Slice: Slice, Require: Require, DeferStmt: DeferStmt, WithBlock: WithBlock, SyncPolicyDecl: SyncPolicyDecl, SelectOp: SelectOp, WhereOp: WhereOp, IndexOp: IndexOp, ReduceOp: ReduceOp, OrderByOp: OrderByOp, LimitOp: LimitOp, UnnestOp: UnnestOp, DistinctOp: DistinctOp, EachOp: EachOp, TapOp: TapOp, SkipOp: SkipOp, CollectOp: CollectOp, TakeWhileOp: TakeWhileOp, WindowOp: WindowOp, BatchWindowOp: BatchWindowOp, JoinOp: JoinOp, FindOp: FindOp, AnyOp: AnyOp, AllOp: AllOp, CountOp: CountOp, SumOp: SumOp, AverageOp: AverageOp, MinOp: MinOp, MaxOp: MaxOp, ShardOp: ShardOp, ConcurrentOp: ConcurrentOp, Placeholder: Placeholder, Copy: Copy, OptionalUnwrap: OptionalUnwrap, TenseNavigation: TenseNavigation, MutableBorrow: MutableBorrow, OrElseRaise: OrElseRaise, OrElseExit: OrElseExit, OrElsePass: OrElsePass, OrElsePrune: OrElsePrune, OrElseBreak: OrElseBreak, CatchBlock: CatchBlock, RecoverOp: RecoverOp, BlockExpr: BlockExpr, StringConcat: StringConcat, CapabilityWrap: CapabilityWrap, MoveNode: MoveNode, CopyNode: CopyNode, KeepNode: KeepNode, ShareNode: ShareNode, LinkNode: LinkNode, ResolveNode: ResolveNode, FreezeNode: FreezeNode, PassStmt: PassStmt, StructPattern: StructPattern, RangeLit: RangeLit, EnumDef: EnumDef, UnionDef: UnionDef, UnionVariantLit: UnionVariantLit, StaticCall: StaticCall, DoBlock: DoBlock, BgBlock: BgBlock, ThenChain: ThenChain, BgStreamBlock: BgStreamBlock, YieldExpr: YieldExpr, CloseStream: CloseStream, NextExpr: NextExpr, MatchStatement: MatchStatement, TestBlock: TestBlock, WhenBlock: WhenBlock, LetBinding: LetBinding, TestThat: TestThat, AssertRaises: AssertRaises, BenchmarkStmt: BenchmarkStmt, SmashStmt: SmashStmt, ProfileStmt: ProfileStmt, StubDecl: StubDecl, Drop: Drop, SuppressCleanup: SuppressCleanup, Return: Return, ReassignCleanup: ReassignCleanup, FieldCleanup: FieldCleanup, Type: Type }
MUTABLE value_block_statement_keywords: [Set]String = ["ASSERT", "ASSERT_RAISES", "BENCHMARK", "BREAK", "CONTINUE", "DEFER", "DIE", "DO", "ENUM", "EXIT", "EXTERN", "FN", "FOR", "METHOD", "MUTABLE", "IF", "MATCH", "PARTIAL", "PASS", "PRIVATE", "PROFILE", "PUB", "RAISE", "RETURN", "SMASH", "STRUCT", "STUB", "SYNC", "TEST", "TIGHT", "UNION", "WHILE", "WITH", "YIELD"] |> DISTINCT _;
PRIVATE FN clearParser__dispatch_stmt_rule(MUTABLE self: ClearParser, rule: ParserRule) RETURNS !Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE result = PARTIAL MATCH rule.action() START
      :parse_require -> parse_require(),
      :parse_extern_decl -> parse_extern_decl(),
      :parse_mutable_var_decl -> parse_mutable_var_decl(),
      :parse_const_decl -> parse_const_decl(),
      :parse_function_def -> parse_function_def(),
      :parse_method_function_def -> parse_function_def(:package, {:is_method: TRUE}),
      :parse_pub_visibility -> parse_visibility_decl(:pub),
      :parse_private_visibility -> parse_visibility_decl(:private),
      :parse_if_statement -> parse_if_statement(),
      :parse_comptime_statement -> parse_comptime_statement(),
      :parse_struct_def -> parse_struct_def(),
      :parse_protocol_def -> parse_protocol_def(),
      :parse_implementation_def -> parse_implementation_def(),
      :parse_enum_def -> parse_enum_def(),
      :parse_union_def -> parse_union_def(),
      :parse_while_loop -> parse_while_loop(),
      :parse_for_range -> TRY (clearParser__parse_for_range(&rtoc_self_view)),
      :parse_tight_stmt -> TRY (clearParser__parse_tight_stmt(&rtoc_self_view)),
      :parse_return -> clearParser__parse_return(rtoc_self_view),
      :parse_assert -> clearParser__parse_assert(rtoc_self_view),
      :parse_defer -> TRY (clearParser__parse_defer(&rtoc_self_view)),
      :parse_assert_raises -> parse_assert_raises(),
      :parse_test_block -> parse_test_block(),
      :parse_stub -> parse_stub(),
      :parse_benchmark_stmt -> parse_benchmark_stmt(),
      :parse_smash_stmt -> parse_smash_stmt(),
      :parse_profile_stmt -> parse_profile_stmt(),
      :parse_raise_stmt -> clearParser__parse_raise_stmt(rtoc_self_view),
      :parse_exit -> clearParser__parse_exit(rtoc_self_view),
      :parse_die -> clearParser__parse_die(rtoc_self_view),
      :parse_break -> clearParser__parse_break(rtoc_self_view),
      :parse_continue -> clearParser__parse_continue(rtoc_self_view),
      :parse_with_capability -> parse_with_capability(),
      :parse_sync_policy_block -> parse_sync_policy_block(),
      :parse_do_block -> parse_do_block(),
      :parse_bg_block -> parse_bg_block(),
      :parse_yield_expr -> parse_yield_expr(),
      :parse_close_stream -> parse_close_stream(),
      :parse_match_statement -> TRY (clearParser__parse_match_statement(&rtoc_self_view)),
      :parse_partial_match_statement -> TRY (clearParser__parse_partial_match_statement(&rtoc_self_view)),
      :parse_pass_statement -> clearParser__parse_pass_statement(rtoc_self_view),
      DEFAULT -> panic("Unknown statement parser action {}")
    END;
    RETURN result;
}
END
PRIVATE FN clearParser__parse_assert(self: ClearParser) RETURNS !Assert
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE token = consume(:KEYWORD, "ASSERT");
    MUTABLE condition = parse_expression();
    MUTABLE message: String@symbol = :Any;
    IF match_mut(:CHAR, ",") THEN
      message = TRY (token__text_mut(consume(:STRING)));
    END
    consume(:CHAR, ";");
    RETURN Assert{ token: COPY token, condition: condition, message: message, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
}
END
PRIVATE FN clearParser__parse_defer(MUTABLE self: ClearParser) RETURNS !DeferStmt
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE token = consume(:KEYWORD, "DEFER");
    MUTABLE body: []Locatable = List[];
    IF match?(:CHAR, "{") THEN
      consume(:CHAR, "{");
      MUTABLE stmts: []Locatable = ( { MUTABLE rtoc_empty_list_1: []Locatable = List[]; rtoc_empty_list_1 } );
      WHILE !(match?(:CHAR, "}")) DO
        &stmts.append(TRY (clearParser__parse_statement(&rtoc_self_view)));
      END
      consume(:CHAR, "}");
      body = stmts;
    ELSE
      body = [TRY (clearParser__parse_statement(&rtoc_self_view))];
    END
    clearParser__reject_defer_control_flow_mut(rtoc_self_view, token, body);
    RETURN DeferStmt{ token: COPY token, body: body, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
}
END
PRIVATE FN clearParser__reject_defer_control_flow_mut(self: ClearParser, token: Token, body: []Locatable) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE stack: []Locatable = COPY body;
    WHILE !((stack.length() == 0)) DO
      MUTABLE node: ?Locatable = &stack.pop();
      IF !((node != NIL)) THEN
        CONTINUE;
      END
      IF (((((node != NIL) AND (node IS_A ReturnNode)) OR ((node != NIL) AND (node IS_A BreakNode))) OR ((node != NIL) AND (node IS_A ContinueNode))) OR ((node != NIL) AND (node IS_A YieldExpr))) THEN
        MUTABLE kind: ?String = COPY (CAST(node.class().name() AS String)).split("::").last();
        error_mut(token, :DEFER_NO_CONTROL_FLOW, {:kind: kind});
      END
      IF (((node != NIL) AND (node IS_A FunctionDef)) OR ((node != NIL) AND (node IS_A LambdaLit))) THEN
        CONTINUE;
      END
      FOR _ IN node.class().members() DO
      MUTABLE value = COPY node.substr(_, 1);
      END
    END
}
END
PRIVATE FN clearParser__parse_break(self: ClearParser) RETURNS BreakNode
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE token = consume(:KEYWORD, "BREAK");
    consume(:CHAR, ";");
    RETURN BreakNode{ token: COPY token, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
}
END
PRIVATE FN clearParser__parse_continue(self: ClearParser) RETURNS ContinueNode
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE token = consume(:KEYWORD, "CONTINUE");
    consume(:CHAR, ";");
    RETURN ContinueNode{ token: COPY token, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
}
END
PRIVATE FN clearParser__parse_partial_match_statement(MUTABLE self: ClearParser) RETURNS !Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    consume(:KEYWORD, "PARTIAL");
    RETURN Locatable{ MatchStatement: COPY TRY (clearParser__parse_match_statement(&rtoc_self_view, TRUE)) };
}
END
PRIVATE FN clearParser__parse_pass_statement(self: ClearParser) RETURNS PassStmt
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE tok = consume(:KEYWORD, "PASS");
    match_mut(:CHAR, ";");
    RETURN PassStmt{ token: COPY tok, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
}
END
PRIVATE FN clearParser__parse_statement(MUTABLE self: ClearParser) RETURNS !Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE rtoc_mutable_receiver_2 = CAST(rtoc_self_view.budget AS FrontendResourceBudget);
    TRY (frontendResourceBudget__enter_mut(&rtoc_mutable_receiver_2));
    MUTABLE statement = TRY (clearParser__parse_statement_body(&rtoc_self_view));
    MUTABLE rtoc_mutable_receiver_3 = CAST(rtoc_self_view.budget AS FrontendResourceBudget);
    frontendResourceBudget__leave_mut(&rtoc_mutable_receiver_3);
    RETURN statement;
}
END
PRIVATE FN clearParser__parse_statement_body(MUTABLE self: ClearParser) RETURNS !Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE start_token = current();
    MUTABLE node: ?Locatable = NIL;
    IF (current().type() == :VAR_ID) THEN
      IF clearParser__destructuring_assignment?(rtoc_self_view) THEN
        node = Locatable{ DestructuringAssignment: COPY clearParser__parse_destructuring_assign(rtoc_self_view) };
      ELSE
        MUTABLE parsed = TRY (clearParser__parse_var_form(rtoc_self_view));
        consume(:CHAR, ";");
        node = parsed.node();
      END
    ELSE
      MUTABLE rule = STMT_RULE_INDEX[ClearParser.token_rule_key(current())];
      IF rule THEN
        node = TRY (clearParser__dispatch_stmt_rule(&rtoc_self_view, rule));
      ELSE
        node = parse_expression();
        consume(:CHAR, ";");
      END
    END
    RETURN stamp_source_range_mut(node, start_token, previous());
}
END
PRIVATE FN clearParser__destructuring_assignment?(self: ClearParser) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF match_at?(1, :CHAR, ",") THEN
      RETURN TRUE;
    END
    IF !(match_at?(1, :CHAR, ":")) THEN
      RETURN FALSE;
    END
    MUTABLE offset = 2;
    MUTABLE delimiters: []String = ( { MUTABLE rtoc_empty_list_4: []String = List[]; rtoc_empty_list_4 } );
    WHILE TRUE DO
      MUTABLE token = peek_at(offset);
      IF !(token) THEN
        RETURN FALSE;
      END
      IF (token.type() == :EOF) THEN
        RETURN FALSE;
      END
      IF (token.type() == :CHAR) THEN
        MUTABLE value = TRY (token__text_mut(token));
        IF (value == "(") OR (value == "[") OR (value == "{") OR (value == "<") THEN
          &delimiters.append(value);
        ELSE_IF (value == ")") OR (value == "]") OR (value == "}") OR (value == ">") THEN
          IF !((delimiters.length() == 0)) THEN
            &delimiters.pop();
          END
        ELSE_IF (value == ",") THEN
          IF (delimiters.length() == 0) THEN
            RETURN TRUE;
          END
        ELSE_IF (value == "=") OR (value == ";") THEN
          IF (delimiters.length() == 0) THEN
            RETURN FALSE;
          END
        END
      END
      offset = (offset + 1);
    END
    RETURN NIL;
}
END
PRIVATE FN clearParser__parse_destructuring_assign(self: ClearParser, default_mutable: Bool = FALSE) RETURNS DestructuringAssignment
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE start_token = current();
    MUTABLE targets = [clearParser__parse_destructure_target(rtoc_self_view, default_mutable)];
    WHILE match_mut(:CHAR, ",") DO
      &targets.append(clearParser__parse_destructure_target(rtoc_self_view, default_mutable));
    END
    consume(:CHAR, "=");
    MUTABLE value = parse_expression();
    consume(:CHAR, ";");
    RETURN DestructuringAssignment{ token: COPY start_token, targets: COPY targets, value: value, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
}
END
PRIVATE FN clearParser__parse_destructure_target(self: ClearParser, default_mutable: Bool = FALSE) RETURNS !DestructureTarget
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE mutable = default_mutable;
    IF match_mut(:KEYWORD, "MUTABLE") THEN
      mutable = TRUE;
    END
    MUTABLE name_tok = consume(:VAR_ID);
    MUTABLE type_annotation = NIL;
    IF match_mut(:CHAR, ":") THEN
      type_annotation = parse_type_annotation();
    END
    RETURN DestructureTarget{ token: COPY name_tok, name: TRY (token__text_mut(name_tok)), type: COPY type_annotation, mutable: mutable, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, mir_binding_entry: NIL };
}
END
PRIVATE FN clearParser__parse_var_form(self: ClearParser) RETURNS !ParsedVarForm
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE target_token = current();
    MUTABLE target = parse_expression();
    MUTABLE opt_type = NIL;
    IF (IF target IS_A Identifier AS identifier THEN match?(:CHAR, ":") ELSE FALSE END) THEN
      consume(:CHAR, ":");
      opt_type = (TRY (clearParser__parse_inferred_wrapper_annotation(rtoc_self_view)) OR_ELSE parse_type_annotation());
    END
    IF match?(:COMPOUND_ASSIGN) THEN
      IF !(((target IS_A Identifier OR target IS_A GetField) OR target IS_A GetIndex)) THEN
        error_mut(target_token, CodeOrMessage{ SymbolValue: :INVALID_ASSIGNMENT });
      END
      MUTABLE op_token = consume(:COMPOUND_ASSIGN);
      MUTABLE op_char = TRY (token__text_mut(op_token)).substr(0, 1);
      MUTABLE op_sym = (ruby_constant_op_to_op_code()[op_char] OR_ELSE symbol(op_char));
      MUTABLE rhs = parse_expression();
      MUTABLE desugared_value = BinaryOp{ token: COPY op_token, left: deep_clone_node(target), op: COPY op_sym, right: rhs, paren_bind: NIL, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, string_concat: NIL, or_fallback_dupe: NIL, error_union_type: NIL, observable_terminal: NIL, observable_dest: NIL, retain_error_channel: NIL };
      IF target IS_A Identifier AS identifier THEN
        MUTABLE bind = BindExpr{ token: COPY target_token, name: identifier__name(identifier), type: NIL, value: desugared_value, compound_op: NIL, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, mode: NIL, reassign_cleanup: NIL, mir_binding_entry: NIL, auto_atomic_op: NIL, ownership_transport_plan: NIL };
        bind.compound_op = op_sym;
        RETURN ParsedVarForm{ node: Locatable{ BindExpr: COPY bind }, assignment: TRUE };
      ELSE
        MUTABLE asgn = Assignment{ token: COPY target_token, name: castLocatableToAssignmentName(COPY target), value: Locatable{ BinaryOp: COPY desugared_value }, compound_op: NIL, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, auto_lock: NIL, field_pre_cleanup: NIL, field_lifecycle_plan: NIL, auto_atomic_op: NIL };
        asgn.compound_op = op_sym;
        RETURN ParsedVarForm{ node: Locatable{ Assignment: COPY asgn }, assignment: TRUE };
      END
    END
    IF !(clearParser__match?(rtoc_self_view, :CHAR, "=")) THEN
      IF opt_type THEN
        clearParser__consume(&rtoc_self_view, :CHAR, "=");
      END
      RETURN ParsedVarForm{ node: COPY target, assignment: FALSE };
    END
    IF !(((target IS_A Identifier OR target IS_A GetField) OR target IS_A GetIndex)) THEN
      error_mut(target_token, CodeOrMessage{ SymbolValue: :INVALID_ASSIGNMENT });
    END
    clearParser__consume(&rtoc_self_view, :CHAR, "=");
    MUTABLE value = clearParser__parse_expression(&rtoc_self_view);
    MUTABLE node =   IF target IS_A Identifier THEN
