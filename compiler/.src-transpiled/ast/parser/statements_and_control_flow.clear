PRIVATE FN clearParser__parse_match_arm(self: ClearParser) RETURNS !ParsedMatchArm
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "WHEN")) THEN
      MUTABLE condition = clearParser__parse_expression(&rtoc_self_view);
      clearParser__consume(&rtoc_self_view, :ARROW);
      RETURN ParsedMatchArm{ kind: :when, value: COPY condition, extra_values: ( { MUTABLE rtoc_empty_list_7: []Locatable = List[]; rtoc_empty_list_7 } ), binding: NIL, destructure: NIL };
    END
    IF clearParser__match?(rtoc_self_view, :CHAR, "{") THEN
      MUTABLE pattern = clearParser__parse_struct_pattern(rtoc_self_view);
      clearParser__consume(&rtoc_self_view, :ARROW);
      RETURN ParsedMatchArm{ kind: :struct_pattern, value: Locatable{ StructPattern: COPY pattern }, extra_values: ( { MUTABLE rtoc_empty_list_8: []Locatable = List[]; rtoc_empty_list_8 } ), binding: NIL, destructure: NIL };
    END
    MUTABLE first_pattern = clearParser__parse_expression(&rtoc_self_view);
    MUTABLE extra_patterns: []Locatable = ( { MUTABLE rtoc_empty_list_9: []Locatable = List[]; rtoc_empty_list_9 } );
    WHILE (clearParser__match?(rtoc_self_view, :CHAR, ",") AND clearParser__multi_pattern_continues?(rtoc_self_view)) DO
      clearParser__consume(&rtoc_self_view, :CHAR, ",");
      &extra_patterns.append(clearParser__parse_expression(&rtoc_self_view));
    END
    MUTABLE binding: ?String = NIL;
    MUTABLE destructure: ?StructPattern = NIL;
    IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "AS")) THEN
      binding = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :VAR_ID)));
    ELSE_IF clearParser__match?(rtoc_self_view, :CHAR, "{") THEN
      destructure = clearParser__parse_struct_pattern(rtoc_self_view);
    END
    clearParser__consume(&rtoc_self_view, :ARROW);
    RETURN ParsedMatchArm{ kind: :eq, value: COPY first_pattern, extra_values: COPY extra_patterns, binding: COPY binding, destructure: COPY destructure };
