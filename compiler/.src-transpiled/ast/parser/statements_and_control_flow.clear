    END
    required_count.times(%() USE(MUTABLE rtoc_self_view) -> {
    clearParser__consume(&rtoc_self_view, :CHAR);
    rubyToClearVoid()
    });
    RETURN TRY (type__new(TypeConstructionInput{ StringValue: COPY "${suffix}Auto" }));
}
