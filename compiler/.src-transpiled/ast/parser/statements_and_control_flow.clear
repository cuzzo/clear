PRIVATE FN clearParser__parse_value_block_expr(MUTABLE self: ClearParser) RETURNS !BlockExpr
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    MUTABLE block_token = clearParser__consume(&rtoc_self_view, :CHAR, "{");
    MUTABLE body: []Node = ( { MUTABLE rtoc_empty_list_6: []Node = List[]; rtoc_empty_list_6 } );
    MUTABLE result: ?Locatable = NIL;
    WHILE !((clearParser__match?(rtoc_self_view, :CHAR, "}") OR clearParser__match?(rtoc_self_view, :EOF))) DO
      IF ((clearParser__current(rtoc_self_view).type == :VAR_ID) AND clearParser__destructuring_assignment?(rtoc_self_view)) THEN
        &body.append(Node{ DestructuringAssignment: COPY clearParser__parse_destructuring_assign(rtoc_self_view) });
        CONTINUE;
      END
      IF (clearParser__current(rtoc_self_view).type == :VAR_ID) THEN
        MUTABLE parsed = TRY (clearParser__parse_var_form(rtoc_self_view));
        IF (parsed.assignment OR clearParser__match_mut(&rtoc_self_view, :CHAR, ";")) THEN
          IF parsed.assignment THEN
            clearParser__consume(&rtoc_self_view, :CHAR, ";");
          END
          &body.append(parsed.node);
          CONTINUE;
        END
        result = parsed.node;
        BREAK;
      END
      MUTABLE stmt: ?Locatable = TRY (clearParser__parse_value_block_keyword_statement(&rtoc_self_view));
      IF stmt EXISTS AS stmt_value THEN
        &body.append(castLocatableToNode(stmt_value));
        CONTINUE;
      END
      MUTABLE expr = clearParser__parse_expression(&rtoc_self_view);
      IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, ";")) THEN
        &body.append(castLocatableToNode(expr));
        CONTINUE;
      ELSE
        result = expr;
        BREAK;
      END
    END
    IF !(result) THEN
      error_mut(clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :UNEXPECTED_TOKEN_LINE }, [], {:value: clearParser__current(rtoc_self_view).value, :type: clearParser__current(rtoc_self_view).type, :line: clearParser__current(rtoc_self_view).line});
    END
    clearParser__consume(&rtoc_self_view, :CHAR, "}");
    RETURN BlockExpr{ token: COPY block_token, body: COPY body, result: COPY result, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
}
