    MUTABLE required_count = suffix.length();
    MUTABLE terminal: ?Token = clearParser__peek_at(rtoc_self_view, required_count);
    IF !((((terminal != NIL) AND (terminal.type == :CHAR)) AND ((UNWRAP (terminal)).value == "="))) THEN
