PRIVATE FN clearParser__reject_legacy_select_effect_spelling_mut(self: ClearParser) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((match?(:CHAR, "!") OR match?(:CHAR, "?"))) THEN
      RETURN;
    END
    MUTABLE marker = current().value();
    IF (((marker == "!") AND (peek().type() == :CHAR)) AND (peek().value() == "?")) THEN
      marker = (marker + "?");
    END
    MUTABLE fix = TRY (fix__new(fix_description(:INSERT_SELECT_EFFECT_COLON, {:selector: "SELECT:${marker}"}), [edit__new(span__new(NIL, current().line(), current().column(), 0), ":")], :auto));
    fixable_mut(current(), {:code: :SELECT_EFFECT_COLON_REQUIRED, :selector: "SELECT:${marker}", :category: :syntax, :level: :error, :fixes: [fix], :raise_in_collector: TRUE});
}
