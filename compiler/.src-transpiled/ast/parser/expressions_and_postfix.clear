FN castLocatableToGetField(value: Locatable) RETURNS GetField ->
  IF value IS_A GetField AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to GetField");
END
FN castLocatableToIdentifier(value: Locatable) RETURNS Identifier ->
  IF value IS_A Identifier AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to Identifier");
END
FN castLocatableToReturnNode(value: Locatable) RETURNS ReturnNode ->
  IF value IS_A ReturnNode AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to ReturnNode");
END
FN castLocatableToTupleLit(value: Locatable) RETURNS TupleLit ->
  IF value IS_A TupleLit AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to TupleLit");
END
FN rubyToClearVoid() RETURNS Void ->
  RETURN;
END
FN ruby_pairs_to_hash_String_Locatable(pairs: []Tuple<String, Locatable>) RETURNS {String}Locatable ->
  MUTABLE result: {String}Locatable = {};
  pairs |> EACH { result[COPY _._0] = COPY _._1; };
  result;
END
