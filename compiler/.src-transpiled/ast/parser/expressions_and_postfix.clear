WITH POLYMORPHIC self AS rtoc_self_view {
    IF match?(:KEYWORD, "FN") THEN
      RETURN TRUE;
    END
    IF match?(:KEYWORD, "SHARED") THEN
      RETURN TRUE;
    END
    IF match?(:KEYWORD, "Auto") THEN
      RETURN TRUE;
    END
    IF ((match?(:CHAR, "~") OR match?(:CHAR, "!")) OR match?(:CHAR, "?")) THEN
      RETURN TRUE;
    END
    IF (match?(:CHAR, "[") OR match?(:CHAR, "{")) THEN
      RETURN TRUE;
    END
    IF !(match?(:TYPE_ID)) THEN
      RETURN FALSE;
    END
    MUTABLE nxt = peek_at(1);
    IF !(nxt) THEN
      RETURN FALSE;
    END
    IF ((nxt.type() == :VAR_ID) AND CAPABILITY_TOKENS.contains?(nxt.value())) THEN
