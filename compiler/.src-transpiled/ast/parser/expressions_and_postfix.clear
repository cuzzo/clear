PRIVATE FN clearParser__dispatch_suffix_rule(MUTABLE self: ClearParser, rule: ParserRule, lhs: Locatable) RETURNS !Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF (rule.action() == :parse_index_suffix) THEN
      RETURN TRY (clearParser__parse_index_suffix(&rtoc_self_view, lhs));
    ELSE_IF (rule.action() == :parse_static_call_suffix) THEN
      RETURN Locatable{ StaticCall: COPY TRY (clearParser__parse_static_call_suffix(&rtoc_self_view, lhs)) };
    ELSE_IF (rule.action() == :parse_dot_suffix) THEN
      RETURN TRY (clearParser__parse_dot_suffix(&rtoc_self_view, lhs));
    ELSE_IF (rule.action() == :parse_func_call_suffix) THEN
      RETURN Locatable{ FuncCall: COPY TRY (clearParser__parse_func_call_suffix(&rtoc_self_view, lhs)) };
    ELSE_IF (rule.action() == :parse_optional_unwrap_suffix) THEN
      RETURN clearParser__parse_optional_unwrap_suffix(rtoc_self_view, lhs);
    ELSE_IF (rule.action() == :parse_tense_navigation_suffix) THEN
      RETURN clearParser__parse_tense_navigation_suffix(rtoc_self_view, lhs);
    ELSE_IF (rule.action() == :parse_exists_suffix) THEN
      RETURN Locatable{ UnaryOp: COPY clearParser__parse_exists_suffix(rtoc_self_view, lhs) };
    ELSE_IF (rule.action() == :parse_is_ok_suffix) THEN
      RETURN Locatable{ UnaryOp: COPY clearParser__parse_is_ok_suffix(rtoc_self_view, lhs) };
    ELSE_IF (rule.action() == :parse_is_ready_suffix) THEN
      RETURN Locatable{ UnaryOp: COPY clearParser__parse_is_ready_suffix(rtoc_self_view, lhs) };
    ELSE_IF (rule.action() == :parse_capability_wrap_suffix) THEN
      RETURN Locatable{ CapabilityWrap: COPY clearParser__parse_capability_wrap_suffix(rtoc_self_view, lhs) };
    ELSE_IF (rule.action() == :parse_inline_union_variant_suffix) THEN
      RETURN Locatable{ UnionVariantLit: COPY TRY (clearParser__parse_inline_union_variant_suffix(&rtoc_self_view, lhs)) };
    ELSE
      panic("Unknown suffix parser action {}");
    END
}
END
