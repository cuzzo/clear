PRIVATE FN clearParser__tense_navigation_marker_run(self: ClearParser) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE offset: Int64 = 0;
    MUTABLE markers = "";
    WHILE TRUE DO
      MUTABLE token = peek_at(offset);
      IF (((token == NIL) OR (token.type() != :CHAR)) OR !((["!", "?", "~"]).contains?(token.value()))) THEN
        BREAK;
      END
      &markers.append(token.value());
      offset = (offset + 1);
    END
    MUTABLE dot = peek_at(offset);
    IF (((resourceClosePlan__empty?(markers) OR (dot == NIL)) OR (dot.type() != :CHAR)) OR (dot.value() != ".")) THEN
      RETURN NIL;
    END
    RETURN markers;
}
END
