PRIVATE FN clearParser__parse_select_modifier_order(self: ClearParser) RETURNS ?String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(match?(:CHAR, ":")) THEN
      RETURN NIL;
    END
    MUTABLE modifier = peek();
    IF !(((modifier.type() == :CHAR) AND (["!", "?", "~"]).contains?(modifier.value()))) THEN
      RETURN NIL;
    END
    consume(:CHAR, ":");
    MUTABLE order = "";
    WHILE ((match?(:CHAR, "!") OR match?(:CHAR, "?")) OR match?(:CHAR, "~")) DO
      &order.append(current().value());
      consume(:CHAR, current().value());
    END
    IF !(valid_select_modifier_orders.contains?(order)) THEN
      error_mut(modifier, :SELECT_MODIFIER_ORDER_INVALID, {:order: order});
    END
    RETURN order;
}
END
PRIVATE FN clearParser__select_effect_mode_for(self: ClearParser, MUTABLE order: ?String) RETURNS ?String@symbol
  REQUIRES self: LOCAL
