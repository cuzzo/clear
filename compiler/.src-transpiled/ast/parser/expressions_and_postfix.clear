    MUTABLE markers = UNWRAP (clearParser__tense_navigation_marker_run(rtoc_self_view));
    IF !((valid_tense_orders.contains?(markers) AND !((markers.length() == 0)))) THEN
      error_mut(token, :TENSE_NAVIGATION_ORDER, {:markers: markers});
    END
    markers.each_char(%(marker) -> {
    consume(:CHAR, marker);
    rubyToClearVoid()
    });
    RETURN Locatable{ TenseNavigation: COPY TenseNavigation{ token: COPY token, target: COPY lhs, markers: markers, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL } };
