PRIVATE FN clearParser__peek_generic_angle_params?(self: ClearParser, end_char: String) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(match?(:CHAR, "<")) THEN
      RETURN FALSE;
    END
    MUTABLE offset = 1;
    MUTABLE depth = 1;
    WHILE TRUE DO
      MUTABLE token = peek_at(offset);
      IF !(token) THEN
        RETURN FALSE;
      END
      IF ((token.type() == :CHAR) AND (token.value() == "<")) THEN
        depth = (depth + 1);
      ELSE_IF ((token.type() == :CHAR) AND (((token.value() == ">") OR (token.value() == ">>")))) THEN
        depth = (depth - IF (token.value() == ">>") THEN
          2
        ELSE
          1
        END);
        IF (depth == 0) THEN
          MUTABLE following = peek_at((offset + 1));
          RETURN ((!((following == NIL)) AND (following.type() == :CHAR)) AND (following.value() == end_char));
        END
      END
      offset = (offset + 1);
    END
    RETURN NIL;
}
