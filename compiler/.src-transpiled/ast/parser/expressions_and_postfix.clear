PRIVATE FN clearParser__parse_expression(MUTABLE self: ClearParser, precedence: Int64 = 0) RETURNS !Locatable
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
  MUTABLE rtoc_mutable_receiver_5 = CAST(rtoc_self_view.budget AS FrontendResourceBudget);
  TRY (frontendResourceBudget__enter_mut(&rtoc_mutable_receiver_5));
  MUTABLE prev_ambient: ?Int64 = rtoc_self_view.wrapper_operand_precedence;
  DEFER rtoc_self_view.wrapper_operand_precedence = prev_ambient;
  rtoc_self_view.wrapper_operand_precedence = COPY precedence;
  MUTABLE expression = TRY (clearParser__parse_expression_body(&rtoc_self_view, UNWRAP (precedence)));
  MUTABLE rtoc_mutable_receiver_6 = CAST(rtoc_self_view.budget AS FrontendResourceBudget);
  frontendResourceBudget__leave_mut(&rtoc_mutable_receiver_6);
  RETURN expression;
