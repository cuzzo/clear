WITH POLYMORPHIC self AS rtoc_self_view {
    IF order EXISTS AS order_value THEN
      MUTABLE order_value_mutable = COPY order_value;
      IF (order_value_mutable == "~") THEN
        RETURN NIL;
      ELSE
        MUTABLE inner = &order_value_mutable.delete("~");
        IF (inner.contains?("!") AND inner.contains?("?")) THEN
          RETURN :fallible_optional;
        END
        IF inner.contains?("?") THEN
          RETURN :optional;
        END
        IF inner.contains?("!") THEN
          RETURN :fallible;
        END
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
