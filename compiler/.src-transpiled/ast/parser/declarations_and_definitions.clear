      RETURN StubDecl{ token: COPY tok, function_name: fn_name, kind: :captures, value: var_name, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
    ELSE_IF clearParser__match?(rtoc_self_view, :KEYWORD, "SEQUENCE") THEN
      clearParser__consume(&rtoc_self_view, :KEYWORD, "SEQUENCE");
      MUTABLE bracket_tok, items = clearParser__parse_comma_seq(rtoc_self_view, :CHAR, "[", "]", %() USE(MUTABLE rtoc_self_view) -> clearParser__parse_expression(&rtoc_self_view));
      MUTABLE values = ListLit{ token: CAST(COPY bracket_tok AS Token), items: COPY items, storage: :stack, constructor_options: NIL, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
      clearParser__consume(&rtoc_self_view, :CHAR, ";");
      RETURN StubDecl{ token: COPY tok, function_name: fn_name, kind: :sequence, value: values, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
    ELSE_IF clearParser__match?(rtoc_self_view, :KEYWORD, "WITH") THEN
      clearParser__consume(&rtoc_self_view, :KEYWORD, "WITH");
      MUTABLE lambda_node = clearParser__parse_expression(&rtoc_self_view);
      clearParser__consume(&rtoc_self_view, :CHAR, ";");
      RETURN StubDecl{ token: COPY tok, function_name: fn_name, kind: :with, value: lambda_node, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
    ELSE
      RETURN error_mut(kind_tok, CodeOrMessage{ SymbolValue: :STUB_BAD_AFTER }, [], {:fn: fn_name});
    END
}
END
FN castClearParserReturnValueToBool(value: ClearParserReturnValue) RETURNS Bool ->
  IF value IS_A Bool AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN TRUE;
END
FN ruby_pairs_to_hash_String_StructField(pairs: []Tuple<String, StructField>) RETURNS {String}StructField ->
  MUTABLE result: {String}StructField = {};
  pairs |> EACH { result[COPY _._0] = COPY _._1; };
  result;
END
FN ruby_pairs_to_hash_String_TypeTypeInput(pairs: []Tuple<String, TypeTypeInput>) RETURNS {String}TypeTypeInput ->
  MUTABLE result: {String}TypeTypeInput = {};
  pairs |> EACH { result[COPY _._0] = COPY _._1; };
  result;
END
