PRIVATE FN clearParser__source_slice_between(self: ClearParser, start_tok: Token, end_tok: Token) RETURNS String
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(((TRUE AND TRUE) AND TRUE)) THEN
      RETURN "";
    END
    MUTABLE lines = rtoc_self_view.source_code.split("\n");
    MUTABLE sl, sc = [start_tok.line, start_tok.column];
    MUTABLE el, ec = [end_tok.line, end_tok.column];
    IF ((sl < 1) OR (sl > lines.length())) THEN
      RETURN "";
    END
    IF (sl == el) THEN
      RETURN (UNWRAP (lines[(sl - 1)]).substr((sc - 1), (ec - sc))).trim();
    ELSE
      MUTABLE parts = List[];
      &parts.append(COPY UNWRAP (lines[(sl - 1)]).substr((sc - 1), (UNWRAP (lines[(sl - 1)]).length() - (sc - 1))));
      FOR _ IN (((sl + 1)) ..= ((el - 1))) DO
      &parts.append(COPY lines[(_ - 1)]);
      END
      &parts.append((UNWRAP (lines[(el - 1)]).substr(0, (ec - 1))));
      RETURN parts.join("").trim();
    END
}
END
PRIVATE FN clearParser__parse_function_def(self: ClearParser, visibility: String@symbol = :package, is_method_input: Bool = FALSE) RETURNS !FunctionDef
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE is_method = COPY is_method_input;
    MUTABLE src: String = "";
    MUTABLE fn_token_branch_value: ?Token = NIL;
    IF is_method THEN
      fn_token_branch_value = clearParser__consume(&rtoc_self_view, :KEYWORD, "METHOD");
    ELSE_IF clearParser__match?(rtoc_self_view, :KEYWORD, "METHOD") THEN
      is_method = TRUE;
