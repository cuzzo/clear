    MUTABLE generic_params = TRY (clearParser__parse_generic_type_params(rtoc_self_view));
    MUTABLE type_params = generic_params |> SELECT _.name;
    MUTABLE params = TRY (clearParser__parse_argument_list(rtoc_self_view));
    MUTABLE captures = List[];
    IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "USE")) THEN
