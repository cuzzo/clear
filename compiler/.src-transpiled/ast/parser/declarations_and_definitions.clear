PRIVATE FN clearParser__conformance_implementation_header?(self: ClearParser) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE index = rtoc_self_view.pos;
    WHILE (index < rtoc_self_view.tokens.length()) DO
      MUTABLE token = COPY UNWRAP (rtoc_self_view.tokens[index]);
      IF ((token.type == :KEYWORD) AND (token.value == "FOR")) THEN
        RETURN TRUE;
      END
      IF ((token.type == :CHAR) AND (token.value == "{")) THEN
        RETURN FALSE;
      END
      index = (index + 1);
    END
    RETURN FALSE;
}
END
