REQUIRE "pkg:path"
REQUIRE "../type.clear"
REQUIRE "../ast.clear"
REQUIRE "../param.clear"
REQUIRE "../lexer.clear"
REQUIRE "../struct_field.clear"
REQUIRE "state.clear"
REQUIRE "types.clear"
REQUIRE "statements_and_control_flow.clear"
REQUIRE "expressions_and_postfix.clear"
UNION ClearParserReturnValue { VarDecl: VarDecl, DestructuringAssignment: DestructuringAssignment, ExternFnDecl: ExternFnDecl, ExternStructDecl: ExternStructDecl, ImplementationDef: ImplementationDef, ConformanceDef: ConformanceDef, Token: Token, BoolValue: Bool, ForRange: ForRange, ForEach: ForEach, Program: Program, RequireNode: RequireNode, ProtocolRequirement: ProtocolRequirement, ProtocolDef: ProtocolDef, FunctionDef: FunctionDef, StructDef: StructDef, Assignment: Assignment, DestructureTarget: DestructureTarget, BindExpr: BindExpr, BinaryOp: BinaryOp, IsA: IsA, UnaryOp: UnaryOp, CallSiteOverride: CallSiteOverride, Identifier: Identifier, Literal: Literal, ListLit: ListLit, TupleLit: TupleLit, DefaultArrayLit: DefaultArrayLit, HashLit: HashLit, DefaultLit: DefaultLit, StructLit: StructLit, LambdaLit: LambdaLit, IfStatement: IfStatement, IfBind: IfBind, WhileLoop: WhileLoop, WhileBindLoop: WhileBindLoop, BreakNode: BreakNode, ContinueNode: ContinueNode, FuncCall: FuncCall, MethodCall: MethodCall, GetField: GetField, GetIndex: GetIndex, Cast: Cast, ReturnNode: ReturnNode, Assert: Assert, Raise: Raise, ThrowNode: ThrowNode, DieNode: DieNode, Slice: Slice, Require: Require, DeferStmt: DeferStmt, WithBlock: WithBlock, SyncPolicyDecl: SyncPolicyDecl, SelectOp: SelectOp, WhereOp: WhereOp, IndexOp: IndexOp, ReduceOp: ReduceOp, OrderByOp: OrderByOp, LimitOp: LimitOp, UnnestOp: UnnestOp, DistinctOp: DistinctOp, EachOp: EachOp, TapOp: TapOp, SkipOp: SkipOp, CollectOp: CollectOp, TakeWhileOp: TakeWhileOp, WindowOp: WindowOp, BatchWindowOp: BatchWindowOp, JoinOp: JoinOp, FindOp: FindOp, AnyOp: AnyOp, AllOp: AllOp, CountOp: CountOp, SumOp: SumOp, AverageOp: AverageOp, MinOp: MinOp, MaxOp: MaxOp, ShardOp: ShardOp, ConcurrentOp: ConcurrentOp, Placeholder: Placeholder, Copy: Copy, OptionalUnwrap: OptionalUnwrap, TenseNavigation: TenseNavigation, MutableBorrow: MutableBorrow, OrElseRaise: OrElseRaise, OrElseExit: OrElseExit, OrElsePass: OrElsePass, OrElsePrune: OrElsePrune, OrElseBreak: OrElseBreak, CatchBlock: CatchBlock, RecoverOp: RecoverOp, BlockExpr: BlockExpr, StringConcat: StringConcat, CapabilityWrap: CapabilityWrap, MoveNode: MoveNode, CopyNode: CopyNode, KeepNode: KeepNode, ShareNode: ShareNode, LinkNode: LinkNode, ResolveNode: ResolveNode, FreezeNode: FreezeNode, PassStmt: PassStmt, StructPattern: StructPattern, RangeLit: RangeLit, EnumDef: EnumDef, UnionDef: UnionDef, UnionVariantLit: UnionVariantLit, StaticCall: StaticCall, DoBlock: DoBlock, BgBlock: BgBlock, ThenChain: ThenChain, BgStreamBlock: BgStreamBlock, YieldExpr: YieldExpr, CloseStream: CloseStream, NextExpr: NextExpr, MatchStatement: MatchStatement, TestBlock: TestBlock, WhenBlock: WhenBlock, LetBinding: LetBinding, TestThat: TestThat, AssertRaises: AssertRaises, BenchmarkStmt: BenchmarkStmt, SmashStmt: SmashStmt, ProfileStmt: ProfileStmt, StubDecl: StubDecl, Drop: Drop, SuppressCleanup: SuppressCleanup, Return: Return, ReassignCleanup: ReassignCleanup, FieldCleanup: FieldCleanup, Type: Type }
PRIVATE FN clearParser__parse_argument_specs(self: ClearParser) RETURNS ![]Capture
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (clearParser__parse_comma_seq(rtoc_self_view, :CHAR, "(", ")", %() USE(rtoc_self_view) -> {
    MUTABLE takes = match_mut(:KEYWORD, "TAKES");
    MUTABLE is_mutable = match_mut(:KEYWORD, "MUTABLE");
    MUTABLE is_comptime = FALSE;
    IF (match?(:VAR_ID) AND (current().value() == "comptime")) THEN
        IF (((peek_at(1) != NIL) AND (((peek_at(1))?).type() == :CHAR)) AND ((peek_at(1) != NIL) AND (((peek_at(1))?).value() == ":"))) THEN
          consume(:VAR_ID);
          is_comptime = TRUE;
        END
    END
    MUTABLE name_tok = IF is_comptime THEN
        NIL
      ELSE
        consume(:VAR_ID)
      END;
    MUTABLE p_name: ?String = NIL;
    IF name_tok THEN
        p_name = &name_tok.text_mut();
    END
    MUTABLE p_type: ?ArgumentType = NIL;
    MUTABLE default_val = NIL;
    MUTABLE carrier_contract: String@symbol = :polymorphic;
    IF is_comptime THEN
        consume(:CHAR, ":");
        p_type = type__to_sym((TRY (token__text_mut(consume(:TYPE_ID)))));
        p_name = "comptime";
    ELSE
        IF match_mut(:CHAR, ":") THEN
          carrier_contract = clearParser__parse_carrier_contract(rtoc_self_view);
          p_type = parse_type_annotation();
          IF (((carrier_contract == :polymorphic) AND ((p_type != NIL) AND (p_type IS_A Type))) AND p_type.polymorphic_shared?()) THEN
            carrier_contract = :shared;
          END
          IF match_mut(:CHAR, "=") THEN
            default_val = parse_expression();
          END
        ELSE_IF match_mut(:CHAR, "=") THEN
          default_val = parse_expression();
          IF match_mut(:CHAR, ":") THEN
            p_type = parse_type_annotation();
          END
        ELSE_IF rtoc_self_view.gradual THEN
          p_type = TRY (type__new(TypeConstructionInput{ SymbolValue: symbol("Auto") }, NIL, NIL, NIL, NIL, NIL, NIL, NIL, NIL, NIL, TRUE));
        END
    END
    Capture{ name: UNWRAP (COPY p_name), type: COPY p_type, default: COPY default_val, mutable: is_mutable, takes: takes, comptime: is_comptime, name_token: name_tok, carrier_contract: carrier_contract, storage: NIL }
    }))._1;
}
END
PRIVATE FN clearParser__parse_carrier_contract(self: ClearParser) RETURNS String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF match_mut(:KEYWORD, "UNIQUE") THEN
      RETURN :unique;
    END
    IF match_mut(:KEYWORD, "MONOMORPHIC") THEN
      RETURN :monomorphic;
    END
    RETURN :polymorphic;
}
END
PRIVATE FN clearParser__parse_argument_list(self: ClearParser) RETURNS ![]Param
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (TRY (clearParser__parse_argument_specs(rtoc_self_view))) |> SELECT Param{ name: COPY _.name, type: COPY _.type, default: COPY _.default, mutable: _.mutable, takes: _.takes, comptime: _.comptime, name_token: COPY KEEP _.name_token, carrier_contract: _.carrier_contract, required: NIL, sync: NIL, symbol: NIL };
}
END
PRIVATE FN clearParser__parse_capture_list(self: ClearParser) RETURNS ![]Capture
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN TRY (clearParser__parse_argument_specs(rtoc_self_view));
}
END
PRIVATE FN clearParser__parse_mutable_var_decl(self: ClearParser) RETURNS !ClearParserReturnValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE start_token = consume(:KEYWORD, "MUTABLE");
    IF destructuring_assignment?() THEN
      RETURN parse_destructuring_assign({:default_mutable: TRUE});
    END
    MUTABLE name = TRY (token__text_mut(consume(:VAR_ID)));
    MUTABLE type_annotation: ?Type = NIL;
    IF match_mut(:CHAR, ":") THEN
      type_annotation = (parse_inferred_wrapper_annotation() OR parse_type_annotation());
    END
    IF match_mut(:CHAR, "=") THEN
      MUTABLE value = parse_expression();
      consume(:CHAR, ";");
      RETURN ClearParserReturnValue{ VarDecl: COPY VarDecl{ token: COPY start_token, name: name, type: COPY type_annotation, value: value, mutable: TRUE, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, mir_binding_entry: NIL, ownership_transport_plan: NIL, const_visibility: NIL, module_const: NIL } };
    END
    consume(:CHAR, ";");
    IF type_annotation EXISTS AS type_annotation_value THEN
      MUTABLE value = TRY (clearParser__synthesize_default_for_type(rtoc_self_view, start_token, type_annotation_value));
      RETURN ClearParserReturnValue{ VarDecl: COPY VarDecl{ token: COPY start_token, name: name, type: COPY type_annotation_value, value: value, mutable: TRUE, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, mir_binding_entry: NIL, ownership_transport_plan: NIL, const_visibility: NIL, module_const: NIL } };
    END
    RETURN error_mut(start_token, :MUTABLE_BARE_NEEDS_TYPE);
}
END
PRIVATE FN clearParser__parse_const_decl(self: ClearParser, visibility: String@symbol = :package) RETURNS !VarDecl
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE start_token = consume(:KEYWORD, "CONST");
    MUTABLE name_tok = IF match?(:TYPE_ID) THEN
      consume(:TYPE_ID)
    ELSE
      consume(:VAR_ID)
    END;
    MUTABLE name = TRY (token__text_mut(name_tok));
    IF !(regexMatch?(name, "\\A[A-Z][A-Z0-9_]*\\z")) THEN
      error_mut(name_tok, :CONST_NEEDS_CAPS, {:name: name});
    END
    IF !(match_mut(:CHAR, ":")) THEN
      error_mut(start_token, :CONST_NEEDS_TYPE, {:name: name});
    END
    MUTABLE type_annotation = (parse_inferred_wrapper_annotation() OR parse_type_annotation());
    IF !(match_mut(:CHAR, "=")) THEN
      error_mut(start_token, :CONST_NEEDS_VALUE, {:name: name});
    END
    MUTABLE value = parse_expression();
    consume(:CHAR, ";");
    MUTABLE decl = VarDecl{ token: COPY start_token, name: name, type: COPY type_annotation, value: value, mutable: FALSE, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, mir_binding_entry: NIL, ownership_transport_plan: NIL, const_visibility: NIL, module_const: NIL };
    decl.module_const = TRUE;
    decl.const_visibility = COPY visibility;
    RETURN decl;
}
END
PRIVATE FN clearParser__synthesize_default_for_type(self: ClearParser, tok: Token, type: Type) RETURNS !DefaultArrayLit
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(type__fixed?(type)) THEN
      error_mut(tok, :MUTABLE_BARE_NEEDS_FIXED, {:type: type__resolved(type)});
    END
    MUTABLE elem: ?Type = TRY (type__element_type(type));
    MUTABLE elem_value: Type = elem?;
    MUTABLE elem_resolved = type__resolved(elem_value);
    IF !(([:Int64, :Int32, :Int16, :Int8, :Float64, :Float32, :String, :Bool, :Boolean]).contains?(elem_resolved)) THEN
      error_mut(tok, :MUTABLE_BARE_BAD_ELEMENT, {:type: compilerInspectValue()});
    END
    RETURN DefaultArrayLit{ token: COPY tok, type_info: COPY TRY (type__new(TypeConstructionInput{ Type: COPY type })), storage: :stack, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
}
END
PRIVATE FN clearParser__parse_require(self: ClearParser) RETURNS !RequireNode
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE path = NIL;
    MUTABLE tok = consume(:KEYWORD, "REQUIRE");
    MUTABLE raw = TRY (token__text_mut(consume(:STRING)));
    MUTABLE namespace: String = "";
    MUTABLE kind: String@symbol = :local;
    IF raw.startsWith?("pkg:") THEN
      MUTABLE pkg_name = regexReplaceFirst(raw, "\\Apkg:", "");
      path = COPY pkg_name;
      namespace = regexReplaceFirst(regexReplaceAll(pkg_name, "[^a-zA-Z0-9_]", "_"), "\\A(\\d)", "_\\1");
      kind = :package;
    ELSE
      path = raw;
      namespace = regexReplaceFirst((regexReplaceAll(basename(path, ".clear"), "[^a-zA-Z0-9_]", "_")), "\\A(\\d)", "_\\1");
      kind = :local;
    END
    IF match_mut(:KEYWORD, "AS") THEN
      namespace = TRY (token__text_mut(consume(:VAR_ID)));
    END
    match_mut(:CHAR, ";");
    RETURN RequireNode{ token: COPY tok, path: path, namespace: namespace, kind: kind, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
}
END
PRIVATE FN clearParser__parse_visibility_decl(self: ClearParser, visibility: String@symbol) RETURNS !Locatable
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    consume(:KEYWORD);
    IF match?(:KEYWORD, "FN") THEN
      RETURN Locatable{ FunctionDef: COPY TRY (clearParser__parse_function_def(rtoc_self_view, visibility)) };
    ELSE_IF match?(:KEYWORD, "METHOD") THEN
      RETURN Locatable{ FunctionDef: COPY TRY (clearParser__parse_function_def(rtoc_self_view, visibility, TRUE)) };
    ELSE_IF match?(:KEYWORD, "STRUCT") THEN
      RETURN Locatable{ StructDef: COPY TRY (clearParser__parse_struct_def(rtoc_self_view, visibility)) };
    ELSE_IF match?(:KEYWORD, "PROTOCOL") THEN
      RETURN Locatable{ ProtocolDef: COPY TRY (clearParser__parse_protocol_def(rtoc_self_view, visibility)) };
    ELSE_IF match?(:KEYWORD, "ENUM") THEN
      RETURN Locatable{ EnumDef: COPY clearParser__parse_enum_def(rtoc_self_view, visibility) };
    ELSE_IF match?(:KEYWORD, "UNION") THEN
      RETURN Locatable{ UnionDef: COPY TRY (clearParser__parse_union_def(rtoc_self_view, visibility)) };
    ELSE_IF match?(:KEYWORD, "CONST") THEN
      RETURN Locatable{ VarDecl: COPY clearParser__parse_const_decl(rtoc_self_view, visibility) };
    ELSE
      RETURN error_mut(current(), :VISIBILITY_BAD_KIND, {:got: current().value()});
    END
}
END
PRIVATE FN clearParser__parse_extern_decl(self: ClearParser) RETURNS !ClearParserReturnValue
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE tok = consume(:KEYWORD, "EXTERN");
    IF match?(:KEYWORD, "FN") THEN
      RETURN ClearParserReturnValue{ ExternFnDecl: COPY TRY (clearParser__parse_extern_fn(rtoc_self_view, tok)) };
    ELSE_IF match?(:KEYWORD, "STRUCT") THEN
      RETURN ClearParserReturnValue{ ExternStructDecl: COPY TRY (clearParser__parse_extern_struct(rtoc_self_view, tok)) };
    ELSE
      RETURN error_mut(current(), :EXTERN_BAD_KIND, {:got: current().value()});
    END
}
END
PRIVATE FN clearParser__parse_extern_fn(self: ClearParser, extern_tok: Token) RETURNS !ExternFnDecl
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    consume(:KEYWORD, "FN");
    MUTABLE owner_type: ?String = NIL;
    MUTABLE owner_type_params: []String@symbol = ( { MUTABLE rtoc_empty_list_1: []String@symbol = List[]; rtoc_empty_list_1 } );
    MUTABLE fn_type_params: []String@symbol = ( { MUTABLE rtoc_empty_list_2: []String@symbol = List[]; rtoc_empty_list_2 } );
    MUTABLE name: String = "";
    IF match?(:TYPE_ID) THEN
      MUTABLE type_name = TRY (token__text_mut(consume(:TYPE_ID)));
      owner_type_params = TRY (clearParser__parse_generic_type_param_symbols(rtoc_self_view));
      IF match_mut(:CHAR, ".") THEN
        owner_type = COPY type_name;
        name = TRY (token__text_mut(consume(:VAR_ID)));
      ELSE
        name = type_name;
        fn_type_params = COPY owner_type_params;
        owner_type_params = ( { MUTABLE rtoc_empty_list_3: []String@symbol = List[]; rtoc_empty_list_3 } );
      END
    ELSE
      name = TRY (token__text_mut(consume(:VAR_ID)));
      fn_type_params = TRY (clearParser__parse_generic_type_param_symbols(rtoc_self_view));
    END
    MUTABLE params = TRY (clearParser__parse_argument_list(rtoc_self_view));
    MUTABLE explicit_return = match_mut(:KEYWORD, "RETURNS");
    MUTABLE return_lifetime: ReturnLifetime = NIL;
    MUTABLE return_type: ?Type = NIL;
    IF explicit_return THEN
      return_lifetime = clearParser__parse_extern_return_lifetime(rtoc_self_view);
      return_type = parse_type_annotation();
    END
    MUTABLE effects = clearParser__parse_extern_effects(rtoc_self_view);
    MUTABLE native_name: String = name;
    IF match_mut(:KEYWORD, "AS") THEN
      native_name = TRY (token__text_mut(consume(:STRING)));
    END
    consume(:KEYWORD, "FROM");
    MUTABLE from_module = TRY (token__text_mut(consume(:STRING)));
    MUTABLE source = clearParser__parse_extern_source(rtoc_self_view, from_module, native_name);
    match_mut(:CHAR, ";");
    RETURN ExternFnDecl{ token: COPY extern_tok, name: name, params: COPY params, return_type: COPY return_type, from_module: from_module, effects: COPY effects.to_h(), owner_type: COPY owner_type, owner_type_params: COPY owner_type_params, fn_type_params: COPY fn_type_params, extern_source: source, return_lifetime: return_lifetime, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL };
}
END
PRIVATE FN clearParser__parse_extern_return_lifetime(self: ClearParser) RETURNS ReturnLifetime
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE names: []Locatable = List[];
    IF match?(:CHAR, "(") THEN
      consume(:CHAR, "(");
      names = ( { MUTABLE rtoc_empty_list_4: []Locatable = List[]; rtoc_empty_list_4 } );
      WHILE !(match?(:CHAR, ")")) DO
        &names.append(parse_var_id());
        match_mut(:CHAR, ",");
      END
      consume(:CHAR, ")");
      consume(:CHAR, ":");
      RETURN names;
    END
    IF match?(:CHAR, "*") THEN
      consume(:CHAR, "*");
      consume(:CHAR, ":");
      RETURN :wildcard;
    END
    IF !(((match?(:VAR_ID) AND (peek().type() == :CHAR)) AND (peek().value() == ":"))) THEN
      RETURN NIL;
    END
    names = [parse_var_id()];
    consume(:CHAR, ":");
    RETURN names;
}
END
PRIVATE FN clearParser__parse_extern_effects(self: ClearParser) RETURNS !ParsedExternEffects
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE effects = ParsedExternEffects{ alloc: NIL, safe: FALSE };
    IF !(castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "EFFECTS"))) THEN
      RETURN effects;
    END
    WHILE TRUE DO
      clearParser__consume(&rtoc_self_view, :CHAR, ":");
      MUTABLE effect_token = clearParser__consume(&rtoc_self_view, :VAR_ID);
      MUTABLE effect = symbol((TRY (token__text_mut(effect_token))));
      IF !(([:alloc, :safe]).contains?(effect)) THEN
        emit_typo_suggestion_mut(TypoToken{ Token: COPY effect_token }, TRY (token__text_mut(effect_token)), ["alloc", "safe"], "Unknown effect ':${effect}'", "closest effect", :type, TRUE);
      END
      IF (effect == :safe) THEN
        effects.safe = TRUE;
      ELSE_IF ((effect == :alloc) AND clearParser__match?(rtoc_self_view, :CHAR, ":")) THEN
        clearParser__consume(&rtoc_self_view, :CHAR, ":");
        MUTABLE qualifier_token = clearParser__consume(&rtoc_self_view, :VAR_ID);
        MUTABLE qualifier = symbol((TRY (token__text_mut(qualifier_token))));
        IF !(([:frame, :heap]).contains?(qualifier)) THEN
          emit_typo_suggestion_mut(TypoToken{ Token: COPY qualifier_token }, TRY (token__text_mut(qualifier_token)), ["frame", "heap"], "Unknown alloc qualifier ':${qualifier}'", "closest alloc qualifier", :type, TRUE);
        END
        effects.alloc = qualifier;
      ELSE
        effects.alloc = :frame;
      END
      IF !(castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, ","))) THEN
        BREAK;
      END
    END
    RETURN effects;
}
END
PRIVATE FN clearParser__parse_extern_struct(self: ClearParser, extern_tok: Token) RETURNS !ExternStructDecl
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    clearParser__consume(&rtoc_self_view, :KEYWORD, "STRUCT");
    MUTABLE name = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :TYPE_ID)));
    MUTABLE type_params = TRY (clearParser__parse_generic_type_param_symbols(rtoc_self_view));
    MUTABLE fields = TRY (clearParser__parse_struct_body(rtoc_self_view));
    MUTABLE close_method: ?String = NIL;
    IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "CLOSE")) THEN
      close_method = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :STRING)));
    END
    MUTABLE as_type: ?String = NIL;
    IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "AS")) THEN
      as_type = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :STRING)));
    END
    MUTABLE from_module: ?String = NIL;
    IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "FROM")) THEN
      from_module = TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :STRING)));
    END
    MUTABLE source = clearParser__parse_extern_source(rtoc_self_view, (from_module OR_ELSE ""), (as_type OR_ELSE name));
    clearParser__match_mut(&rtoc_self_view, :CHAR, ";");
