    END
    MUTABLE return_type: ?Type = NIL;
    MUTABLE return_type_token: ?Token = NIL;
    MUTABLE return_lifetime_token: ?Token = NIL;
    MUTABLE return_lifetime: ?ClearParserReturnLifetime = NIL;
    MUTABLE explicit_return = clearParser__match?(rtoc_self_view, :KEYWORD, "RETURNS");
    IF (!(explicit_return) AND rtoc_self_view.gradual) THEN
      return_type = TRY (type__new(TypeConstructionInput{ SymbolValue: symbol("Auto") }, NIL, NIL, NIL, NIL, NIL, NIL, NIL, NIL, NIL, TRUE));
      explicit_return = TRUE;
    END
    IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "RETURNS")) THEN
      MUTABLE shared_return = clearParser__match_mut(&rtoc_self_view, :KEYWORD, "SHARED");
      IF clearParser__match?(rtoc_self_view, :CHAR, "(") THEN
        return_lifetime_token = clearParser__consume(&rtoc_self_view, :CHAR, "(");
        MUTABLE names: []Locatable = ( { MUTABLE rtoc_empty_list_12: []Locatable = List[]; rtoc_empty_list_12 } );
        WHILE !(clearParser__match?(rtoc_self_view, :CHAR, ")")) DO
          &names.append(clearParser__parse_var_id(&rtoc_self_view));
          clearParser__match_mut(&rtoc_self_view, :CHAR, ",");
        END
        clearParser__consume(&rtoc_self_view, :CHAR, ")");
        clearParser__consume(&rtoc_self_view, :CHAR, ":");
        return_lifetime = ClearParserReturnLifetime{ ArrayValue: COPY names };
      ELSE_IF clearParser__match?(rtoc_self_view, :CHAR, "*") THEN
        return_lifetime_token = clearParser__consume(&rtoc_self_view, :CHAR, "*");
        clearParser__consume(&rtoc_self_view, :CHAR, ":");
        return_lifetime = ClearParserReturnLifetime{ SymbolValue: :wildcard };
      ELSE_IF (clearParser__current(rtoc_self_view).type == :VAR_ID) THEN
        return_lifetime_token = clearParser__current(rtoc_self_view);
        MUTABLE names: []Locatable = [clearParser__parse_var_id(&rtoc_self_view)];
        return_lifetime = ClearParserReturnLifetime{ ArrayValue: COPY names };
        clearParser__consume(&rtoc_self_view, :CHAR, ":");
      END
      return_type_token = clearParser__current(rtoc_self_view);
      return_type = clearParser__parse_type_annotation(&rtoc_self_view);
      IF castClearParserReturnValueToBool(shared_return) THEN
        return_type = clearParser__mark_polymorphic_shared_type(rtoc_self_view, UNWRAP (return_type));
      END
    END
    MUTABLE requires_clause: ?{String}[Set]String@symbol = NIL;
    MUTABLE early_requires_clauses: {String}String@symbol = {};
    IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "REQUIRES")) THEN
      MUTABLE parsed_requires = clearParser__parse_requires_clause(rtoc_self_view);
      requires_clause = COPY parsed_requires.capabilities;
      early_requires_clauses = COPY parsed_requires.reentrance;
    END
    MUTABLE parsed_effects = clearParser__parse_effects_decl(rtoc_self_view);
    MUTABLE effects_decl: ?String@symbol = COPY parsed_effects.kind;
    MUTABLE effects_span: ?EffectSpan = COPY parsed_effects.span;
    MUTABLE requires_clauses = TRY (clearParser__parse_requires_clauses(rtoc_self_view, name));
    IF !((early_requires_clauses.count() == 0)) THEN
      early_requires_clauses.keys() |> EACH {
    MUTABLE v: String@symbol = (early_requires_clauses[_] OR_ELSE CAST(panic("missing hash key") AS String@symbol));
    IF requires_clauses.contains?(_) THEN
          error_mut(fn_token, CodeOrMessage{ SymbolValue: :DUPLICATE_REQUIRES_CLAUSE }, [], {:fn: name, :name: _});
    END
    requires_clauses[_] = COPY v;
      };
    END
    MUTABLE pre_clauses = List[];
    WHILE castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "PRE")) DO
      clearParser__consume(&rtoc_self_view, :CHAR, ":");
      MUTABLE start_tok = clearParser__current(rtoc_self_view);
      MUTABLE expr = clearParser__parse_expression(&rtoc_self_view);
      MUTABLE end_tok = clearParser__current(rtoc_self_view);
      src = clearParser__source_slice_between(rtoc_self_view, start_tok, end_tok);
      &pre_clauses.append({:expr: expr, :source: src});
    END
    MUTABLE post_clauses = List[];
    WHILE castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "DEBUG_POST")) DO
      clearParser__consume(&rtoc_self_view, :CHAR, ":");
      start_tok = clearParser__current(rtoc_self_view);
      expr = clearParser__parse_expression(&rtoc_self_view);
      end_tok = clearParser__current(rtoc_self_view);
      src = clearParser__source_slice_between(rtoc_self_view, start_tok, end_tok);
      &post_clauses.append({:expr: expr, :source: src});
    END
    MUTABLE arrow_token = clearParser__current(rtoc_self_view);
    clearParser__consume(&rtoc_self_view, :ARROW, "->");
    MUTABLE body = clearParser__parse_block_body(&rtoc_self_view, ["END", "CATCH"]);
    MUTABLE catch_clauses: []CatchClause = ( { MUTABLE rtoc_empty_list_13: []CatchClause = List[]; rtoc_empty_list_13 } );
    MUTABLE default_body: ?[]Locatable = NIL;
    IF clearParser__match?(rtoc_self_view, :KEYWORD, "CATCH") THEN
      WHILE clearParser__match?(rtoc_self_view, :KEYWORD, "CATCH") DO
        clearParser__consume(&rtoc_self_view, :KEYWORD, "CATCH");
        MUTABLE items = [clearParser__parse_catch_item(rtoc_self_view)];
        WHILE castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, ",")) DO
          &items.append(clearParser__parse_catch_item(rtoc_self_view));
        END
        MUTABLE filters = List[];
        IF clearParser__match?(rtoc_self_view, :KEYWORD, "WITH") THEN
          clearParser__consume(&rtoc_self_view, :KEYWORD, "WITH");
          clearParser__consume(&rtoc_self_view, :CHAR, "(");
          &filters.append(clearParser__parse_catch_filter(rtoc_self_view));
          WHILE castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, ",")) DO
            &filters.append(clearParser__parse_catch_filter(rtoc_self_view));
          END
          clearParser__consume(&rtoc_self_view, :CHAR, ")");
        END
        MUTABLE clause_body = clearParser__parse_block_body(&rtoc_self_view, ["CATCH", "DEFAULT", "END"]);
        &catch_clauses.append(CatchClause{ items: COPY items, filters: COPY filters, body: COPY clause_body, kinds: ( { MUTABLE rtoc_empty_list_14: []String@symbol = List[]; rtoc_empty_list_14 } ), types: ( { MUTABLE rtoc_empty_list_15: []String = List[]; rtoc_empty_list_15 } ), filter_types: ( { MUTABLE rtoc_empty_list_16: []String = List[]; rtoc_empty_list_16 } ), filter_messages: ( { MUTABLE rtoc_empty_list_17: []Locatable = List[]; rtoc_empty_list_17 } ) });
      END
      IF clearParser__match?(rtoc_self_view, :KEYWORD, "DEFAULT") THEN
        clearParser__consume(&rtoc_self_view, :KEYWORD, "DEFAULT");
        default_body = clearParser__parse_block_body(&rtoc_self_view, ["END"]);
      END
    END
    clearParser__consume(&rtoc_self_view, :KEYWORD, "END");
    MUTABLE max_depth_n: ?Int64 = parsed_effects.max_depth;
    MUTABLE tight_reentrance = parsed_effects.tight;
    MUTABLE stored_requires_clauses_branch_value: ?{String}String@symbol = NIL;
    IF (requires_clauses.count() == 0) THEN
      stored_requires_clauses_branch_value = NIL;
    ELSE
      stored_requires_clauses_branch_value = requires_clauses;
    END
    MUTABLE stored_requires_clauses: ?{String}String@symbol = stored_requires_clauses_branch_value;
    MUTABLE stored_pre_clauses_branch_value: ?[]Any = NIL;
    IF (pre_clauses.length() == 0) THEN
      stored_pre_clauses_branch_value = NIL;
    ELSE
      stored_pre_clauses_branch_value = pre_clauses;
    END
    MUTABLE stored_pre_clauses: ?[]Any = stored_pre_clauses_branch_value;
    MUTABLE stored_post_clauses_branch_value: ?[]Any = NIL;
    IF (post_clauses.length() == 0) THEN
      stored_post_clauses_branch_value = NIL;
    ELSE
      stored_post_clauses_branch_value = post_clauses;
    END
    MUTABLE stored_post_clauses: ?[]Any = stored_post_clauses_branch_value;
    MUTABLE node = FunctionDef{ token: COPY fn_token, name: name, params: COPY params, captures: captures, return_type: COPY return_type, return_lifetime: return_lifetime, body: COPY body, catch_clauses: catch_clauses, default_catch: default_body, visibility: COPY visibility, deferred_drops: NIL, uses_frame: NIL, explicit_return_type: explicit_return, type_params: COPY type_params, tail_call: (effects_decl == :reentrant_tail_call), requires: requires_clause, arrow_token: COPY arrow_token, name_token: COPY name_tok, effects_decl: effects_decl, effects_span: effects_span, max_depth_n: max_depth_n, tight_reentrance: tight_reentrance, requires_clauses: stored_requires_clauses, return_type_token: COPY return_type_token, pre_clauses: stored_pre_clauses, post_clauses: stored_post_clauses, is_method: COPY is_method, can_fail: NIL, coerced_type_object: NIL, collection_return: NIL, container_borrow: NIL, error_kind: NIL, error_type: NIL, implicit_layout_cost: NIL, kept_edge_plan: NIL, kept_edge_plans: NIL, layout_transport: NIL, matched_signature: NIL, matched_stdlib_def: NIL, mutates_receiver: NIL, needs_heap_create: NIL, needs_mut_ref: NIL, resource_close_plan: NIL, slot_size: NIL, source_range: NIL, stdlib_allocates: NIL, storage_override: NIL, symbol: NIL, tense_plan: NIL, type_object: NIL, var_mutated: NIL, var_used: NIL, was_moved: NIL, zig_pattern: NIL, effect_set: NIL, inferred_effects: NIL, reentrance_kind: NIL, thunk_plan: NIL, mutual_thunk_plan: NIL, needs_rt: NIL, fn_value_ref: NIL, alloc_fault: NIL, error_fallible: NIL, uses_heap: NIL, uses_alloc: NIL, uses_rt: NIL, effects: NIL, snapshot_types: NIL, stack_tier: NIL, stack_vars_bytes: NIL, moved_guard_info: NIL, cleanup_bindings: NIL, heap_carry_return: NIL, heap_carry_return_vars: NIL, fsm_eligible: NIL, fsm_ineligible_reason: NIL, fsm_suspend_points: NIL, conformance_protocol: NIL, generic_params: List[], implementation_owner: NIL, semantic_with_blocks: List[], source_name: "" };
    node.generic_params = generic_params;
    RETURN node;
}
END
PRIVATE FN clearParser__parse_requires_clause(self: ClearParser) RETURNS !ParsedRequiresClause
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE requires_hash: {String}[Set]String@symbol = {};
    MUTABLE requires_reentrance: {String}String@symbol = {};
    WHILE TRUE DO
      MUTABLE names: []String = [TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :VAR_ID)))];
      WHILE castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, ",")) DO
        &names.append(TRY (token__text_mut(clearParser__consume(&rtoc_self_view, :VAR_ID))));
      END
      clearParser__consume(&rtoc_self_view, :CHAR, ":");
      MUTABLE families: [Set]String@symbol = Set[];
      MUTABLE reentrance_kinds: []String@symbol = ( { MUTABLE rtoc_empty_list_18: []String@symbol = List[]; rtoc_empty_list_18 } );
      MUTABLE first = clearParser__parse_requires_family_or_reentrance(rtoc_self_view);
      MUTABLE family: ?String@symbol = COPY first.family;
      MUTABLE reentrance: ?String@symbol = COPY first.reentrance;
      IF family EXISTS AS family_value THEN
        &families.insert(family_value);
      END
      IF reentrance EXISTS AS reentrance_value THEN
        &reentrance_kinds.append(reentrance_value);
      END
      WHILE castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, "|")) DO
        MUTABLE nxt = clearParser__parse_requires_family_or_reentrance(rtoc_self_view);
        family = COPY nxt.family;
        reentrance = COPY nxt.reentrance;
        IF family EXISTS AS family_value THEN
          &families.insert(family_value);
        END
        IF reentrance EXISTS AS reentrance_value THEN
          &reentrance_kinds.append(reentrance_value);
        END
      END
      FOR _ IN names DO
    IF !(families.empty?()) THEN
          requires_hash[_] = families;
    END
    FOR _ IN reentrance_kinds DO
    requires_reentrance[_] = COPY _;
    END
      END
      IF !(castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, ","))) THEN
        BREAK;
      END
    END
    RETURN ParsedRequiresClause{ capabilities: COPY requires_hash, reentrance: COPY requires_reentrance };
}
END
PRIVATE FN clearParser__parse_requires_family_or_reentrance(self: ClearParser) RETURNS !RequiresKind
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE tok = clearParser__consume(&rtoc_self_view, :TYPE_ID);
    MUTABLE token_value = TRY (token__text_mut(tok));
    MUTABLE result_branch_value: ?RequiresKind = NIL;
    IF ((["LOCKED", "SNAPSHOTTED", "VERSIONED", "ATOMIC", "LOCAL", "ACTOR", "LOCK_FREE"]) |> DISTINCT _).contains?(token_value) THEN
      result_branch_value = RequiresKind{ family: COPY symbol(token_value), reentrance: NIL };
    ELSE_IF ((["NON_REENTRANT"]) |> DISTINCT _).contains?(token_value) THEN
      result_branch_value = RequiresKind{ reentrance: :non_reentrant, family: NIL };
    ELSE
      MUTABLE candidates = ((((["LOCKED", "SNAPSHOTTED", "VERSIONED", "ATOMIC", "LOCAL", "ACTOR", "LOCK_FREE"]) |> DISTINCT _) |> SELECT COPY _) + (((["NON_REENTRANT"]) |> DISTINCT _) |> SELECT COPY _));
      result_branch_value = emit_typo_suggestion_mut(TypoToken{ Token: COPY tok }, token_value, candidates, "Unknown REQUIRES family '${token_value}' (valid: ${(((["LOCKED", "SNAPSHOTTED", "VERSIONED", "ATOMIC", "LOCAL", "ACTOR", "LOCK_FREE"]) |> DISTINCT _) |> SELECT COPY _).join(", ")}; kinds: ${(((["NON_REENTRANT"]) |> DISTINCT _) |> SELECT COPY _).join(", ")})", "closest REQUIRES family/kind", :type, TRUE);
    END
    MUTABLE result: RequiresKind = result_branch_value?;
    RETURN result;
}
END
PRIVATE FN clearParser__parse_requires_family(self: ClearParser) RETURNS String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE res = clearParser__parse_requires_family_or_reentrance(rtoc_self_view);
    MUTABLE family: ?String@symbol = COPY res.family;
    IF !(family) THEN
      error_mut(clearParser__current(rtoc_self_view), CodeOrMessage{ SymbolValue: :EXPECTED_CAP_FAMILY });
    END
    RETURN symbol(UNWRAP (family));
}
END
PRIVATE FN clearParser__parse_requires_clauses(self: ClearParser, fn_name: String) RETURNS !{String}String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE out: {String}String@symbol = {};
    WHILE clearParser__match?(rtoc_self_view, :KEYWORD, "REQUIRES") DO
      clearParser__consume(&rtoc_self_view, :KEYWORD, "REQUIRES");
      MUTABLE name_tok = clearParser__consume(&rtoc_self_view, :VAR_ID);
      MUTABLE name = TRY (token__text_mut(name_tok));
      clearParser__consume(&rtoc_self_view, :CHAR, ":");
      MUTABLE kind_tok = clearParser__consume(&rtoc_self_view, :TYPE_ID);
      MUTABLE kind_value = TRY (token__text_mut(kind_tok));
      IF !((kind_value == "NON_REENTRANT")) THEN
        emit_typo_suggestion_mut(TypoToken{ Token: COPY kind_tok }, kind_value, ["NON_REENTRANT"], "Unknown REQUIRES kind '${kind_value}'", "closest REQUIRES kind", :type, TRUE);
      END
      MUTABLE kind = :non_reentrant;
      IF out.contains?(name) THEN
        error_mut(name_tok, CodeOrMessage{ SymbolValue: :DUPLICATE_REQUIRES_CLAUSE }, [], {:fn: fn_name, :name: name});
      END
      out[name] = kind;
    END
    RETURN out;
}
END
PRIVATE FN clearParser__parse_effects_decl(self: ClearParser) RETURNS !ParsedEffectsDecl
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(clearParser__match?(rtoc_self_view, :KEYWORD, "EFFECTS")) THEN
      RETURN ParsedEffectsDecl{ kind: NIL, span: NIL, max_depth: NIL, tight: FALSE };
    END
    MUTABLE eff_kw = clearParser__consume(&rtoc_self_view, :KEYWORD, "EFFECTS");
    MUTABLE eff_tok = clearParser__consume(&rtoc_self_view, :TYPE_ID);
    MUTABLE effect_value = TRY (token__text_mut(eff_tok));
    IF !((effect_value == "REENTRANT")) THEN
      emit_typo_suggestion_mut(TypoToken{ Token: COPY eff_tok }, effect_value, ["REENTRANT"], "Unknown function effect '${effect_value}'", "closest function effect", :type, TRUE);
    END
    MUTABLE span_start = eff_kw;
    MUTABLE span_end_tok = eff_tok;
    IF !(castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, ":"))) THEN
      MUTABLE span = EffectSpan{ start_token: span_start, end_token: span_end_tok };
      RETURN ParsedEffectsDecl{ kind: :reentrant, span: COPY span, max_depth: NIL, tight: FALSE };
    END
    MUTABLE tight = FALSE;
    MUTABLE tight_tok = NIL;
    IF clearParser__match?(rtoc_self_view, :KEYWORD, "TIGHT") THEN
      tight_tok = clearParser__consume(&rtoc_self_view, :KEYWORD, "TIGHT");
      tight = TRUE;
      span_end_tok = tight_tok;
      IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, ":")) THEN
    
      ELSE
        span = EffectSpan{ start_token: span_start, end_token: span_end_tok };
        RETURN ParsedEffectsDecl{ kind: :reentrant, span: COPY span, tight: TRUE, max_depth: NIL };
      END
    END
    MUTABLE variant_tok = clearParser__consume(&rtoc_self_view, :TYPE_ID);
    MUTABLE variant_value = TRY (token__text_mut(variant_tok));
    MUTABLE kind: String@symbol = :reentrant;
    IF (variant_value == "THUNK") THEN
      kind = :reentrant_thunk;
    ELSE_IF (variant_value == "TAIL_CALL") THEN
      kind = :reentrant_tail_call;
    ELSE_IF (variant_value == "NOT_LOGICAL") THEN
      kind = :reentrant_not_logical;
    ELSE_IF (variant_value == "MAX_DEPTH") THEN
      kind = :reentrant_max_depth;
    ELSE
      emit_typo_suggestion_mut(TypoToken{ Token: COPY variant_tok }, variant_value, ["THUNK", "TAIL_CALL", "NOT_LOGICAL", "MAX_DEPTH"], "Unknown REENTRANT variant '${variant_value}'", "closest REENTRANT variant", :type, TRUE);
    END
    IF (tight AND (((kind == :reentrant_not_logical) OR (kind == :reentrant_max_depth)))) THEN
      MUTABLE label: String = "";
      IF (kind == :reentrant_not_logical) THEN
        label = "NOT_LOGICAL";
      ELSE
        label = "MAX_DEPTH";
      END
      MUTABLE explanation: String = "";
      IF (label == "MAX_DEPTH") THEN
        explanation = "MAX_DEPTH(N) implies TIGHT (the bounded depth replaces the yield-check); just write :MAX_DEPTH(N).";
      ELSE
        explanation = "NOT_LOGICAL has depth=1 by runtime assertion, so TIGHT is meaningless.";
      END
      error_mut(variant_tok, CodeOrMessage{ SymbolValue: :INVALID_TIGHT_VARIANT }, [], {:label: label, :explanation: explanation});
    END
    span_end_tok = variant_tok;
    MUTABLE max_depth_n: ?Int64 = NIL;
    IF (kind == :reentrant_max_depth) THEN
      clearParser__consume(&rtoc_self_view, :CHAR, "(");
      MUTABLE n_tok = clearParser__current(rtoc_self_view);
      MUTABLE n_lit = clearParser__consume_number(&rtoc_self_view);
      max_depth_n = TRY (token__integer_mut(n_lit));
      IF (max_depth_n <= 0) THEN
        error_mut(n_tok, CodeOrMessage{ SymbolValue: :MAX_DEPTH_NONPOSITIVE }, [], {:got: max_depth_n});
      END
      MUTABLE close_tok = clearParser__consume(&rtoc_self_view, :CHAR, ")");
      span_end_tok = close_tok;
    END
    span = EffectSpan{ start_token: span_start, end_token: span_end_tok };
    RETURN ParsedEffectsDecl{ kind: COPY kind, span: COPY span, max_depth: max_depth_n, tight: tight };
}
END
PRIVATE FN clearParser__parse_struct_body(self: ClearParser) RETURNS !{String}StructField
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE pairs: []Tuple<String, StructField> = ( { MUTABLE rtoc_empty_list_19: []Tuple<String, StructField> = List[]; rtoc_empty_list_19 } );
    _, pairs = clearParser__parse_comma_seq(rtoc_self_view, :CHAR, "{", "}", %() USE(MUTABLE rtoc_self_view) -> {
    MUTABLE name_tok = clearParser__consume(&rtoc_self_view, :VAR_ID);
    MUTABLE name = TRY (token__text_mut(name_tok));
    MUTABLE default_val = NIL;
    IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, "=")) THEN
        default_val = clearParser__parse_expression(&rtoc_self_view);
    END
    clearParser__consume(&rtoc_self_view, :CHAR, ":");
    MUTABLE borrowed = IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :KEYWORD, "BORROWED")) THEN
        TRUE
      ELSE
        FALSE
      END;
    MUTABLE type = clearParser__parse_type_annotation(&rtoc_self_view);
    clearParser__reject_auto_in_aggregate_field_mut(rtoc_self_view, type, name, name_tok, "STRUCT");
    CAST(Tuple{name, StructField{ type: type, default: default_val, borrowed: borrowed }} AS Tuple<String, StructField>)
    });
    RETURN ruby_pairs_to_hash_String_StructField(pairs);
}
END
PRIVATE FN clearParser__reject_auto_in_aggregate_field_mut(self: ClearParser, type: Type, field_name: String, field_tok: ?Token, context_label: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(type__auto?(type)) THEN
      RETURN;
    END
    MUTABLE auto_tok_branch_value: ?Token@multiowned = NIL;
    IF TRUE THEN
      auto_tok_branch_value = COPY KEEP type.auto_token;
    ELSE
      auto_tok_branch_value = NIL;
    END
    MUTABLE auto_tok: ?Token@multiowned = auto_tok_branch_value;
    MUTABLE anchor = (IF auto_tok != NIL THEN auto_tok ELSE field_tok END);
    error_mut(anchor, CodeOrMessage{ SymbolValue: :AUTO_NOT_ALLOWED_IN_FIELD }, [], {:context: context_label, :field: field_name});
}
END
FN clearParser__parse_comma_seq<Elem>(self: ClearParser, type: String@symbol, open: String, close_value: String, blk: FN() -> Elem) RETURNS Tuple<Token, []Elem>
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE start_token = clearParser__consume(&rtoc_self_view, type, open);
    MUTABLE items: []Elem = ( { MUTABLE rtoc_empty_list_20: []Elem = List[]; rtoc_empty_list_20 } );
    WHILE !(clearParser__match?(rtoc_self_view, :CHAR, close_value)) DO
      &items.append(blk());
      clearParser__match_mut(&rtoc_self_view, :CHAR, ",");
    END
    clearParser__consume(&rtoc_self_view, :CHAR, close_value);
    RETURN CAST(Tuple{start_token, items} AS Tuple<Token, []Elem>);
}
END
FN clearParser__parse_generic_type_params(self: ClearParser) RETURNS ![]GenericParamDecl
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(clearParser__match?(rtoc_self_view, :CHAR, "<")) THEN
      RETURN CAST(( { MUTABLE rtoc_empty_list_21: []GenericParamDecl = List[]; rtoc_empty_list_21 } ) AS []GenericParamDecl);
    END
    _, MUTABLE params = clearParser__parse_comma_seq(rtoc_self_view, :CHAR, "<", ">", %() USE(MUTABLE rtoc_self_view) -> {
    MUTABLE name_token = clearParser__consume(&rtoc_self_view, :TYPE_ID);
    MUTABLE bounds: []GenericBoundDecl = ( { MUTABLE rtoc_empty_list_22: []GenericBoundDecl = List[]; rtoc_empty_list_22 } );
    IF castClearParserReturnValueToBool(clearParser__match_mut(&rtoc_self_view, :CHAR, ":")) THEN
