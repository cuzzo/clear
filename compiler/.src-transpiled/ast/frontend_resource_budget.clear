STRUCT FrontendResourceBudget {
  max_nesting: Int64,
  max_source_bytes: Int64,
  max_tokens: Int64,
  nesting: Int64
}

STRUCT Exceeded {
  kind: String@symbol,
  limit: Int64
}

FN exceeded__initialize(MUTABLE self: Exceeded, kind: String@symbol, limit_value: Int64) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.kind = COPY kind;
    rtoc_self_view.limit = COPY limit_value;
}
END
FN exceeded__new(kind: String@symbol, limit: Int64) RETURNS Exceeded@multiowned ->
  MUTABLE self = Exceeded{ kind: COPY kind, limit: limit };
  exceeded__initialize(&self, kind, limit);
  RETURN self @multiowned;
END
FN frontendResourceBudget__initialize(MUTABLE self: FrontendResourceBudget, max_nesting: Int64 = 192, max_tokens: Int64 = 1000000, max_source_bytes: Int64 = ((32 * 1024) * 1024)) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.max_nesting = COPY max_nesting;
    rtoc_self_view.max_tokens = COPY max_tokens;
    rtoc_self_view.max_source_bytes = COPY max_source_bytes;
    rtoc_self_view.nesting = 0;
}
END
FN frontendResourceBudget__check_source_mut(self: FrontendResourceBudget, source: String) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE violation: ?Exceeded = frontendResourceBudget__source_violation(rtoc_self_view, source);
    IF violation EXISTS AS violation_value THEN
      panic("Ruby exception raised");
    END
}
END
FN frontendResourceBudget__source_violation(self: FrontendResourceBudget, source: String) RETURNS ?Exceeded@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (source.bytes() > rtoc_self_view.max_source_bytes) THEN
      RETURN exceeded__new(:source_bytes, rtoc_self_view.max_source_bytes);
    END
    RETURN NIL;
}
END
FN frontendResourceBudget__check_tokens_mut(self: FrontendResourceBudget, count_value: Int64) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE violation: ?Exceeded = frontendResourceBudget__tokens_violation(rtoc_self_view, count_value);
    IF violation EXISTS AS violation_value THEN
      panic("Ruby exception raised");
    END
}
END
FN frontendResourceBudget__tokens_violation(self: FrontendResourceBudget, count_value: Int64) RETURNS ?Exceeded@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF (count_value > rtoc_self_view.max_tokens) THEN
      RETURN exceeded__new(:tokens, rtoc_self_view.max_tokens);
    END
    RETURN NIL;
}
END
FN frontendResourceBudget__nesting_limit(self: FrontendResourceBudget) RETURNS Int64
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN rtoc_self_view.max_nesting;
}
END
FN frontendResourceBudget__enter_mut(MUTABLE self: FrontendResourceBudget) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.nesting = (rtoc_self_view.nesting + 1);
    IF (rtoc_self_view.nesting > rtoc_self_view.max_nesting) THEN
      rtoc_self_view.nesting = (rtoc_self_view.nesting - 1);
      RAISE Input, Exceeded, "Ruby exception raised";
    END
}
END
FN frontendResourceBudget__leave_mut(MUTABLE self: FrontendResourceBudget) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.nesting = (rtoc_self_view.nesting - 1);
}
END
FN frontendResourceBudget__new(max_nesting: Int64 = 192, max_tokens: Int64 = 1000000, max_source_bytes: Int64 = ((32 * 1024) * 1024)) RETURNS FrontendResourceBudget@multiowned ->
  MUTABLE self = FrontendResourceBudget{ max_nesting: max_nesting, max_source_bytes: max_source_bytes, max_tokens: max_tokens, nesting: 0 };
  frontendResourceBudget__initialize(&self, max_nesting, max_tokens, max_source_bytes);
  RETURN self @multiowned;
END
