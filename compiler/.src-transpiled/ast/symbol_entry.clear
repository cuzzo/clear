FN symbolEntry__write_locked?(self: SymbolEntry) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN symbolEntry__write_locked_sync?(symbolEntry__sync(rtoc_self_view));
}
END
FN symbolEntry__declared_sync_contract?(self: SymbolEntry) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((symbolEntry__sync(rtoc_self_view) == NIL)) THEN
      RETURN TRUE;
    END
    MUTABLE families: ?[Set]String@symbol = COPY rtoc_self_view.sync_families;
    IF !((families != NIL)) THEN
      RETURN FALSE;
    END
    RETURN !((UNWRAP (families)).empty?());
}
END
PRIVATE FN symbolEntry__lock_sync?(self: SymbolEntry) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (symbolEntry__locked?(rtoc_self_view) OR symbolEntry__write_locked?(rtoc_self_view));
}
END
FN symbolEntry__sync_or_shared_storage?(self: SymbolEntry) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ((symbolEntry__lock_sync?(rtoc_self_view) OR symbolEntry__rc_stored?(rtoc_self_view)) OR symbolEntry__local_storage?(rtoc_self_view));
}
END
FN symbolEntry__boxed_capture_storage?(self: SymbolEntry) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (symbolEntry__lock_sync?(rtoc_self_view) OR symbolEntry__local_storage?(rtoc_self_view));
}
END
FN symbolEntry__affine_locked_capture?(self: SymbolEntry) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (symbolEntry__lock_sync?(rtoc_self_view) AND !(symbolEntry__rc_stored?(rtoc_self_view)));
}
END
FN symbolEntry__with_match_capability_family?(self: SymbolEntry) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (((!((symbolEntry__sync(rtoc_self_view) == NIL)) OR symbolEntry__rc_stored?(rtoc_self_view)) OR symbolEntry__local_storage?(rtoc_self_view)) OR symbolEntry__heap_storage?(rtoc_self_view));
}
END
FN symbolEntry__plain_local_family?(self: SymbolEntry) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN ((symbolEntry__sync(rtoc_self_view) == NIL) AND (((symbolEntry__storage(rtoc_self_view) == :stack) OR symbolEntry__heap_storage?(rtoc_self_view))));
}
END
FN symbolEntry__capture_move_required?(self: SymbolEntry, live: Bool) RETURNS !Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (live AND ((((symbolEntry__ownership_kind(rtoc_self_view) == :resource) OR (symbolEntry__ownership_kind(rtoc_self_view) == :affine)) OR TRY (type__needs_escape_promotion?(symbolEntry__type(rtoc_self_view))))));
}
END
FN symbolEntry__locked_sync?(sync_value: ?String@symbol) RETURNS Bool ->
  RETURN symbolEntry__sync_matches?(sync_value, :locked);
END
FN symbolEntry__write_locked_sync?(sync_value: ?String@symbol) RETURNS Bool ->
  RETURN symbolEntry__sync_matches?(sync_value, :write_locked);
END
FN symbolEntry__versioned_sync?(sync_value: ?String@symbol) RETURNS Bool ->
  RETURN symbolEntry__sync_matches?(sync_value, :versioned);
END
FN symbolEntry__local_sync?(sync_value: ?String@symbol) RETURNS Bool ->
  RETURN symbolEntry__sync_matches?(sync_value, :local);
END
FN symbolEntry__always_mutable_sync?(sync_value: ?String@symbol) RETURNS Bool ->
  RETURN symbolEntry__sync_matches?(sync_value, :always_mutable);
END
FN symbolEntry__locked_family_sync?(sync_value: ?String@symbol) RETURNS Bool ->
  RETURN (symbolEntry__locked_sync?(sync_value) OR symbolEntry__write_locked_sync?(sync_value));
END
FN symbolEntry__cleanup_sync?(sync_value: ?String@symbol) RETURNS Bool ->
  RETURN (((symbolEntry__locked_sync?(sync_value) OR symbolEntry__write_locked_sync?(sync_value)) OR symbolEntry__always_mutable_sync?(sync_value)) OR symbolEntry__versioned_sync?(sync_value));
END
FN symbolEntry__sync_matches?(sync_value: ?String@symbol, expected: String@symbol) RETURNS Bool ->
  RETURN (sync_value == expected);
END
FN symbolEntry__rc_stored?(self: SymbolEntry) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN symbolEntry__rc_storage?(symbolEntry__storage(rtoc_self_view));
}
END
FN symbolEntry__rc_storage?(storage: ?String@symbol) RETURNS Bool ->
  RETURN ((storage == :shared) OR (storage == :multiowned));
END
FN symbolEntry__provenance(self: SymbolEntry) RETURNS ?String@symbol
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !(provenance_storage.contains?(symbolEntry__storage(rtoc_self_view))) THEN
      RETURN NIL;
    END
    RETURN symbolEntry__storage(rtoc_self_view);
}
END
FN symbolEntry__heap_storage?(self: SymbolEntry) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN symbolEntry__heap_storage_value?(symbolEntry__storage(rtoc_self_view));
}
END
FN symbolEntry__frame_provenance?(self: SymbolEntry) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN symbolEntry__frame_storage_value?(symbolEntry__storage(rtoc_self_view));
}
END
FN symbolEntry__rodata_provenance?(self: SymbolEntry) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (symbolEntry__storage(rtoc_self_view) == :rodata);
}
END
FN symbolEntry__borrow_provenance?(self: SymbolEntry) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (symbolEntry__storage(rtoc_self_view) == :borrow);
