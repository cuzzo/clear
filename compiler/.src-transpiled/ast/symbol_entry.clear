PRIVATE FN symbolEntry__local_storage?(self: SymbolEntry) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN symbolEntry__local_storage_value?(symbolEntry__storage(rtoc_self_view));
