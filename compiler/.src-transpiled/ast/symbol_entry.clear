FN symbolEntry__heap_storage_value?(storage: ?String@symbol) RETURNS Bool ->
  RETURN (storage == :heap);
END
FN symbolEntry__frame_storage_value?(storage: ?String@symbol) RETURNS Bool ->
  RETURN (storage == :frame);
END
FN symbolEntry__local_storage_value?(storage: ?String@symbol) RETURNS Bool ->
  RETURN (storage == :local);
END
FN symbolEntry__invalidate_mut(MUTABLE self: SymbolEntry, reason: String) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.flow.valid = FALSE;
    rtoc_self_view.flow.invalid_reason = COPY reason;
}
END
FN symbolEntry__mark_read_mut(MUTABLE self: SymbolEntry) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.flow.read = TRUE;
    MUTABLE reg: ?SymbolEntryRegInput = COPY rtoc_self_view.reg;
    IF reg EXISTS AS reg_value THEN
      MUTABLE reg_value_mutable = COPY reg_value;
      IF reg_value_mutable IS_A VarDecl AS var_decl THEN
        MUTABLE var_decl_mutable = COPY var_decl;
        var_decl_mutable.var_used = TRUE;
      ELSE_IF reg_value_mutable IS_A Assignment AS assignment THEN
        MUTABLE assignment_mutable = COPY assignment;
        assignment_mutable.var_used = TRUE;
      ELSE_IF reg_value_mutable IS_A DestructureTarget AS destructure_target THEN
        MUTABLE destructure_target_mutable = COPY destructure_target;
        destructure_target_mutable.var_used = TRUE;
      ELSE_IF reg_value_mutable IS_A DestructuringAssignment AS destructuring_assignment THEN
        MUTABLE destructuring_assignment_mutable = COPY destructuring_assignment;
        destructuring_assignment_mutable.var_used = TRUE;
      ELSE_IF reg_value_mutable IS_A BindExpr AS bind_expr THEN
        MUTABLE bind_expr_mutable = COPY bind_expr;
        bind_expr_mutable.var_used = TRUE;
      END
    END
}
END
FN symbolEntry__mark_mutated_mut(MUTABLE self: SymbolEntry, touch_declaration: Bool = FALSE) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.flow.mutated = TRUE;
    MUTABLE reg: ?SymbolEntryRegInput = COPY rtoc_self_view.reg;
    IF (touch_declaration AND (reg != NIL)) THEN
      IF reg IS_A VarDecl AS var_decl THEN
        MUTABLE var_decl_mutable = COPY var_decl;
        var_decl_mutable.var_mutated = TRUE;
      ELSE_IF reg IS_A Assignment AS assignment THEN
        MUTABLE assignment_mutable = COPY assignment;
        assignment_mutable.var_mutated = TRUE;
      ELSE_IF reg IS_A DestructureTarget AS destructure_target THEN
        MUTABLE destructure_target_mutable = COPY destructure_target;
        destructure_target_mutable.var_mutated = TRUE;
      ELSE_IF reg IS_A DestructuringAssignment AS destructuring_assignment THEN
        MUTABLE destructuring_assignment_mutable = COPY destructuring_assignment;
        destructuring_assignment_mutable.var_mutated = TRUE;
      ELSE_IF reg IS_A BindExpr AS bind_expr THEN
        MUTABLE bind_expr_mutable = COPY bind_expr;
        bind_expr_mutable.var_mutated = TRUE;
      END
    END
}
END
FN symbolEntry__mark_mutated_via_reference_mut(MUTABLE self: SymbolEntry) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.flow.mutated = TRUE;
    rtoc_self_view.flow.mutable_ref_target = TRUE;
}
END
