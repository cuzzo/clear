  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.lifetime = [rtoc_self_view];
}
END
FN symbolEntry__clear_non_escaping_mut(MUTABLE self: SymbolEntry) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    IF !(symbolEntry__non_escaping(rtoc_self_view)) THEN
      RETURN;
    END
    rtoc_self_view.lifetime = ( { MUTABLE rtoc_empty_list_1: []SymbolEntry@multiowned = List[]; rtoc_empty_list_1 } );
}
END
