  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.lifecycle.owned_optional_capture = TRUE;
}
END
FN symbolEntry__initialize_copy(MUTABLE self: SymbolEntry, original: SymbolEntry) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.lifecycle = COPY original.lifecycle;
    rtoc_self_view.flow = symbolEntry__flow_snapshot(original);
    rtoc_self_view.lifetime = COPY original.lifetime;
}
END
FN symbolEntry__flow_facts(self: SymbolEntry) RETURNS BindingFlowFacts
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY rtoc_self_view.flow;
}
END
FN symbolEntry__flow_snapshot(self: SymbolEntry) RETURNS BindingFlowFacts
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN BindingFlowFacts{ non_escaping: rtoc_self_view.flow.non_escaping, borrowed_alias: rtoc_self_view.flow.borrowed_alias, valid: rtoc_self_view.flow.valid, invalid_reason: COPY rtoc_self_view.flow.invalid_reason, read: rtoc_self_view.flow.read, mutated: rtoc_self_view.flow.mutated, mutable_ref_target: rtoc_self_view.flow.mutable_ref_target, poly_borrow_target: rtoc_self_view.flow.poly_borrow_target, init_contents_heap: rtoc_self_view.flow.init_contents_heap };
}
END
FN symbolEntry__lifetime_sources(self: SymbolEntry) RETURNS ![]SymbolEntry@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN COPY rtoc_self_view.lifetime;
}
END
FN symbolEntry__tied_lifetime(sources: []SymbolEntry@multiowned) RETURNS ![]SymbolEntry@multiowned ->
  RETURN CAST((sources |> DISTINCT _) AS []SymbolEntry@multiowned);
END
FN symbolEntry__initialize(MUTABLE self: SymbolEntry, reg: ?SymbolEntryRegInput, type: ?SymbolEntryTypeInput, mutable_value: Bool, storage: String@symbol, sync_value: ?String@symbol = NIL, layout: ?String@symbol = NIL, rebindable: Bool = FALSE, size: Int64 = 0, capabilities: [Set]String@symbol = Set[], valid: Bool = TRUE, invalid_reason: ?String = NIL, resource: ?Bool = NIL, close_plan: ?ResourceClosePlan = NIL) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.binding_id = symbolEntry__next_binding_id();
    rtoc_self_view.ownership_binding_id = rtoc_self_view.binding_id;
    rtoc_self_view.reg = COPY reg;
    rtoc_self_view.lifecycle = BindingLifecycleFacts{ type: COPY TRY (symbolEntry__normalize_type_input(type)), storage: COPY storage, sync: COPY sync_value, layout: COPY layout, resource: COPY resource, close_plan: COPY close_plan, semantic_place_id: NIL, ownership_kind: NIL, takes: FALSE, is_param: FALSE, link_source: NIL, async_result_shape: NIL, foreign_out_owner: FALSE, owned_optional_capture: FALSE, kept_identity: NIL, carrier_contract: :polymorphic, carrier_polymorphic: FALSE };
    rtoc_self_view.mutable = COPY mutable_value;
    rtoc_self_view.rebindable = COPY rebindable;
    rtoc_self_view.reassigned = FALSE;
    rtoc_self_view.size = COPY size;
    rtoc_self_view.capabilities = COPY capabilities;
    rtoc_self_view.lifetime = List[];
    rtoc_self_view.flow = BindingFlowFacts{ valid: COPY valid, invalid_reason: COPY invalid_reason, non_escaping: FALSE, borrowed_alias: FALSE, read: FALSE, mutated: FALSE, mutable_ref_target: FALSE, poly_borrow_target: FALSE, init_contents_heap: FALSE };
    rtoc_self_view.sync_families = NIL;
    rtoc_self_view.scope = NIL;
    rtoc_self_view.scope_depth = NIL;
    rtoc_self_view.param_decl_token = NIL;
}
END
FN symbolEntry__set_type(MUTABLE self: SymbolEntry, val: ?SymbolEntryTypeInput) RETURNS !Void
  REQUIRES self: LOCAL
  EFFECTS REENTRANT
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.lifecycle.type = TRY (symbolEntry__normalize_type_input(val));
}
END
PRIVATE FN symbolEntry__normalize_type_input(value: ?SymbolEntryTypeInput) RETURNS !Type ->
  IF value EXISTS AS value_value THEN
    IF value_value IS_A FunctionSignature AS function_signature THEN
      RETURN CAST(TRY (symbolEntry__type_from_function_signature(function_signature)) AS Type);
    END
    RETURN TRY (type__new(castSymbolEntryTypeInputToTypeConstructionInput(value_value)));
  ELSE
    RETURN TRY (type__new(TypeConstructionInput{ SymbolValue: :Untyped }));
  END
END
PRIVATE FN symbolEntry__type_from_function_signature(signature: FunctionSignature) RETURNS !Type ->
  MUTABLE param_types = ( { MUTABLE rtoc_map_results = CAST([] AS []Type); (TRY (functionSignature__params(signature))) |> EACH { &rtoc_map_results.append(COPY param__type(_)); }; rtoc_map_results } );
  RETURN TRY (type__function_type_from_parts(param_types, CAST(functionSignature__return_type(signature) AS Type), functionSignature__reentrant(signature), signature));
END
PRIVATE FN symbolEntry__next_binding_id() RETURNS Int64 ->
  MUTABLE id = COPY next_binding_id_value;
  next_binding_id_value = (next_binding_id_value + 1);
  RETURN id;
END
PRIVATE FN symbolEntry__normalize_lifetime(self: SymbolEntry, value: ?SymbolEntryLifetimeInput) RETURNS ![]SymbolEntry@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF value? IS_A String@symbol AS string_symbol THEN
      IF (string_symbol == :current_scope) THEN
        RETURN CAST([rtoc_self_view] AS []SymbolEntry@multiowned);
      END
    END
    MUTABLE sources: []SymbolEntryLifetimeSourceInput = ( { MUTABLE rtoc_empty_list_2: []SymbolEntryLifetimeSourceInput = List[]; rtoc_empty_list_2 } );
    IF value? IS_A {String@symbol}[]SymbolEntryLifetimeSourceInput AS hash THEN
      sources = (hash[:sources] OR_ELSE List[]);
    ELSE_IF value? IS_A []SymbolEntryLifetimeSourceInput AS array THEN
      sources = COPY array;
    ELSE_IF value THEN
      sources = [castOptionalSymbolEntryLifetimeInputToSymbolEntryLifetimeSourceInput(value)];
    END
    MUTABLE normalized: []SymbolEntry@multiowned = ( { MUTABLE rtoc_empty_list_3: []SymbolEntry@multiowned = List[]; rtoc_empty_list_3 } );
    FOR _ IN sources DO
    IF !(_ IS_A SymbolEntry) THEN
        panic("SymbolEntry#lifetime sources must be SymbolEntry instances");
    END
    &normalized.append(castSymbolEntryLifetimeSourceInputToSymbolEntryMultiowned(COPY _));
    END
    RETURN CAST((normalized |> DISTINCT _) AS []SymbolEntry@multiowned);
}
END
FN symbolEntry__new(reg: ?SymbolEntryRegInput, type: ?SymbolEntryTypeInput, mutable: Bool, storage: String@symbol, sync: ?String@symbol = NIL, layout: ?String@symbol = NIL, rebindable: Bool = FALSE, size: Int64 = 0, capabilities: [Set]String@symbol = Set[], valid: Bool = TRUE, invalid_reason: ?String = NIL, resource: ?Bool = NIL, close_plan: ?ResourceClosePlan = NIL) RETURNS !SymbolEntry@multiowned ->
  MUTABLE self = SymbolEntry{ binding_id: 0_i64, capabilities: COPY capabilities, flow: BindingFlowFacts{ valid: COPY valid, invalid_reason: COPY invalid_reason, non_escaping: FALSE, borrowed_alias: FALSE, read: FALSE, mutated: FALSE, mutable_ref_target: FALSE, poly_borrow_target: FALSE, init_contents_heap: FALSE }, lifecycle: BindingLifecycleFacts{ type: COPY TRY (symbolEntry__normalize_type_input(COPY type)), storage: COPY storage, sync: COPY sync, layout: COPY layout, resource: COPY resource, close_plan: COPY close_plan, semantic_place_id: NIL, ownership_kind: NIL, takes: FALSE, is_param: FALSE, link_source: NIL, async_result_shape: NIL, foreign_out_owner: FALSE, owned_optional_capture: FALSE, kept_identity: NIL, carrier_contract: :polymorphic, carrier_polymorphic: FALSE }, lifetime: List[], mutable: mutable, ownership_binding_id: 0_i64, param_decl_token: NIL, reassigned: FALSE, rebindable: rebindable, reg: COPY reg, scope: NIL, scope_depth: NIL, size: size, sync_families: NIL };
  TRY (symbolEntry__initialize(&self, reg, type, mutable, storage, sync, layout, rebindable, size, capabilities, valid, invalid_reason, resource, close_plan));
  RETURN self @multiowned;
END
FN castOptionalSymbolEntryLifetimeInputToSymbolEntryLifetimeSourceInput(value: ?SymbolEntryLifetimeInput) RETURNS SymbolEntryLifetimeSourceInput ->
  IF value == NIL THEN
    panic("Invalid cast to SymbolEntryLifetimeSourceInput");
  END
  PARTIAL MATCH value? START
    SymbolEntryLifetimeInput.SymbolValue AS cast_payload -> RETURN SymbolEntryLifetimeSourceInput{ SymbolValue: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to SymbolEntryLifetimeSourceInput");
  END
  panic("Invalid cast to SymbolEntryLifetimeSourceInput");
END
FN castSymbolEntryLifetimeSourceInputToSymbolEntryMultiowned(value: SymbolEntryLifetimeSourceInput) RETURNS SymbolEntry@multiowned ->
  IF value IS_A SymbolEntry@multiowned AS cast_payload THEN
    RETURN cast_payload;
  END
  RETURN panic("Invalid cast to SymbolEntry@multiowned");
END
FN castSymbolEntryTypeInputToTypeConstructionInput(value: SymbolEntryTypeInput) RETURNS TypeConstructionInput ->
  PARTIAL MATCH value START
    SymbolEntryTypeInput.FunctionType AS cast_payload -> RETURN TypeConstructionInput{ FunctionType: COPY cast_payload };,
    SymbolEntryTypeInput.SymbolValue AS cast_payload -> RETURN TypeConstructionInput{ SymbolValue: COPY cast_payload };,
    SymbolEntryTypeInput.StringValue AS cast_payload -> RETURN TypeConstructionInput{ StringValue: COPY cast_payload };,
    SymbolEntryTypeInput.Type AS cast_payload -> RETURN TypeConstructionInput{ Type: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to TypeConstructionInput");
  END
  panic("Invalid cast to TypeConstructionInput");
END
