FN symbolEntry__inherit_ownership_identity_mut(MUTABLE self: SymbolEntry, source: SymbolEntry) RETURNS Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.ownership_binding_id = source.ownership_binding_id;
}
END
FN symbolEntry__set_lifetime(MUTABLE self: SymbolEntry, value: ?SymbolEntryLifetimeInput) RETURNS !Void
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS MUTABLE rtoc_self_view {
    rtoc_self_view.lifetime = TRY (symbolEntry__normalize_lifetime(rtoc_self_view, value));
    rtoc_self_view.flow.non_escaping = symbolEntry__lifetime_self_only?(rtoc_self_view);
}
END
FN symbolEntry__lifetime_self_only?(self: SymbolEntry) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    IF !((rtoc_self_view.lifetime.length() == 1)) THEN
      RETURN FALSE;
    END
    MUTABLE source: ?SymbolEntry@multiowned = COPY rtoc_self_view.lifetime.first();
    IF source EXISTS AS source_value THEN
      RETURN (source_value.binding_id == rtoc_self_view.binding_id);
    ELSE
      RETURN FALSE;
    END
}
END
FN symbolEntry__fn_signature(self: SymbolEntry) RETURNS ?FunctionSignature@multiowned
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    MUTABLE function_type: ?FunctionType = type__function_type(symbolEntry__type(rtoc_self_view));
    IF function_type EXISTS AS function_type_value THEN
      MUTABLE signature: ?Any@multiowned = COPY KEEP function_type_value.source_signature;
      IF signature EXISTS AS signature_value THEN
        RETURN CAST(signature_value AS FunctionSignature@multiowned);
      ELSE
        RETURN NIL;
      END
    ELSE
      RETURN NIL;
    END
}
END
FN symbolEntry__atomic?(self: SymbolEntry) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN symbolEntry__atomic_sync?(symbolEntry__sync(rtoc_self_view));
}
END
FN symbolEntry__atomic_sync?(sync_value: ?String@symbol) RETURNS Bool ->
  RETURN symbolEntry__sync_matches?(sync_value, :atomic);
END
FN symbolEntry__indirect?(self: SymbolEntry) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (symbolEntry__layout(rtoc_self_view) == :indirect);
}
END
FN symbolEntry__atomic_ptr?(self: SymbolEntry) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN (symbolEntry__atomic?(rtoc_self_view) AND symbolEntry__indirect?(rtoc_self_view));
}
END
FN symbolEntry__locked?(self: SymbolEntry) RETURNS Bool
  REQUIRES self: LOCAL
->
WITH POLYMORPHIC self AS rtoc_self_view {
    RETURN symbolEntry__locked_sync?(symbolEntry__sync(rtoc_self_view));
}
END
