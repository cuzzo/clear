STRUCT CollectionConstructorFact {
  collection: String@symbol,
  soa: Bool,
  shard_count: ?Int64
}
STRUCT EffectSpan {
  start_token: Token,
  end_token: Token
}
STRUCT SourceRange {
  file: ?String,
  start_offset: Int64,
  end_offset: Int64,
  start_line: Int64,
  start_column: Int64,
  end_line: Int64,
  end_column: Int64
}
STRUCT Capture {
  name: String,
  type: Type,
  default: ?Locatable,
  mutable: Bool,
  takes: Bool,
  comptime: Bool,
  name_token: ?Token@multiowned,
  storage: ?String@symbol,
  carrier_contract: Any@multiowned
}

PUB FN capture__name(self: Capture) RETURNS String ->
  RETURN COPY self.name;
END
PUB FN capture__type(self: Capture) RETURNS Type ->
  RETURN COPY self.type;
END
PUB FN capture__default(self: Capture) RETURNS ?Locatable ->
  RETURN COPY self.default;
END
PUB FN capture__mutable(self: Capture) RETURNS Bool ->
  RETURN COPY self.mutable;
END
PUB FN capture__takes(self: Capture) RETURNS Bool ->
  RETURN COPY self.takes;
END
PUB FN capture__comptime(self: Capture) RETURNS Bool ->
  RETURN COPY self.comptime;
END
PUB FN capture__name_token(self: Capture) RETURNS ?Token ->
  RETURN CAST(COPY KEEP self.name_token AS ?Token);
END
STRUCT MatchCase {
  kind: String@symbol,
  value: Locatable,
  body: []Locatable,
  binding: ?String,
  destructure: ?StructPattern,
  extra_values: []Locatable,
  indirect_payload_as: Bool
}

PUB FN matchCase__body(self: MatchCase) RETURNS ![]Locatable ->
  RETURN COPY self.body;
END
