  family: String@symbol,
  body: []Locatable,
  lock_error_clauses: []ErrorClause,
  token: ?Token
}

PUB FN withMatchArm__body_nodes(self: WithMatchArm) RETURNS ![]Locatable ->
  RETURN COPY self.body;
END
PUB FN withMatchArm__family_value(self: WithMatchArm) RETURNS String@symbol ->
  RETURN self.family;
END
PUB FN withMatchArm__lock_error_clauses_value(self: WithMatchArm) RETURNS ![]ErrorClause ->
  RETURN COPY self.lock_error_clauses;
END
PUB FN withMatchArm__token_value(self: WithMatchArm) RETURNS ?Token ->
  RETURN COPY self.token;
END
STRUCT UnionMethodParamRequirement {
  name: String,
  type: Type
}
STRUCT UnionMethodRequirement {
  token: Token,
  name: String,
  params: []UnionMethodParamRequirement,
  return_type: ?Type,
  body: []Locatable,
  has_default_body: Bool,
  visibility: String@symbol
}
STRUCT DoBranch {
  body: []Locatable,
  pinned: Bool,
  parallel: Bool,
  stack_size: ?String@symbol,
  can_smash: Bool,
  computed_stack_tier: ?String@symbol,
  capture_analysis: Any@multiowned
}
STRUCT ThenStep {
  expr: Locatable,
  binding: ?String
}
FN aST__precedence_info(ops: []String, assoc: String@symbol) RETURNS !{String@symbol}PrecedenceInfoValue ->
  MUTABLE info: {String@symbol}PrecedenceInfoValue = {};
  info[:ops] = PrecedenceInfoValue{ ArrayValue: COPY ops };
  info[:assoc] = PrecedenceInfoValue{ SymbolValue: COPY assoc };
  RETURN info;
END
