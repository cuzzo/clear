PUB FN ruby_constant_unary_ops() RETURNS []String ->
  RETURN CAST(["-", "!", "~"] AS []String);
END
PUB FN ruby_constant_op_to_op_code() RETURNS {String}String@symbol ->
  RETURN CAST({"+": :ADD, "$+": :CONCAT, "-": :SUB, "*": :MUL, "/": :DIV, "**": :POW, "==": :EQ, "!=": :NEQ, "<": :LT, "<=": :LTE, ">": :GT, ">=": :GTE, "!": :NOT, "AND": symbol("AND"), "OR": symbol("OR"), "MOD": symbol("MOD"), "OR_ELSE": symbol("OR_ELSE"), "~": :BITWISE_NOT, "XOR": symbol("XOR"), "BIT_AND": symbol("BIT_AND"), "BIT_OR": symbol("BIT_OR"), "<<": :SHL, ">>": :SHR, "AS": :BIND_VAR, "%+": :WRAP_ADD, "%-": :WRAP_SUB, "%*": :WRAP_MUL, "!+": :CHECK_ADD, "!-": :CHECK_SUB, "!*": :CHECK_MUL} AS {String}String@symbol);
END
PUB FN ruby_constant_capabilities() RETURNS []String@symbol ->
  RETURN CAST([symbol("RESTRICT"), symbol("EXCLUSIVE"), symbol("BORROWED"), symbol("VIEW"), :MATERIALIZED_VIEW, :UNSAFE_VIEW, symbol("SNAPSHOT")] AS []String@symbol);
END
