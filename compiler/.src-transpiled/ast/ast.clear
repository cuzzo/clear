    Locatable.TapOp AS cast_payload -> RETURN Locatable{ TapOp: COPY cast_payload };,
    Locatable.SkipOp AS cast_payload -> RETURN Locatable{ SkipOp: COPY cast_payload };,
    Locatable.CollectOp AS cast_payload -> RETURN Locatable{ CollectOp: COPY cast_payload };,
    Locatable.TakeWhileOp AS cast_payload -> RETURN Locatable{ TakeWhileOp: COPY cast_payload };,
    Locatable.WindowOp AS cast_payload -> RETURN Locatable{ WindowOp: COPY cast_payload };,
    Locatable.BatchWindowOp AS cast_payload -> RETURN Locatable{ BatchWindowOp: COPY cast_payload };,
    Locatable.JoinOp AS cast_payload -> RETURN Locatable{ JoinOp: COPY cast_payload };,
    Locatable.FindOp AS cast_payload -> RETURN Locatable{ FindOp: COPY cast_payload };,
    Locatable.AnyOp AS cast_payload -> RETURN Locatable{ AnyOp: COPY cast_payload };,
    Locatable.AllOp AS cast_payload -> RETURN Locatable{ AllOp: COPY cast_payload };,
    Locatable.CountOp AS cast_payload -> RETURN Locatable{ CountOp: COPY cast_payload };,
    Locatable.SumOp AS cast_payload -> RETURN Locatable{ SumOp: COPY cast_payload };,
    Locatable.AverageOp AS cast_payload -> RETURN Locatable{ AverageOp: COPY cast_payload };,
    Locatable.MinOp AS cast_payload -> RETURN Locatable{ MinOp: COPY cast_payload };,
    Locatable.MaxOp AS cast_payload -> RETURN Locatable{ MaxOp: COPY cast_payload };,
    Locatable.ShardOp AS cast_payload -> RETURN Locatable{ ShardOp: COPY cast_payload };,
    Locatable.ConcurrentOp AS cast_payload -> RETURN Locatable{ ConcurrentOp: COPY cast_payload };,
    Locatable.Placeholder AS cast_payload -> RETURN Locatable{ Placeholder: COPY cast_payload };,
    Locatable.Copy AS cast_payload -> RETURN Locatable{ Copy: COPY cast_payload };,
    Locatable.OptionalUnwrap AS cast_payload -> RETURN Locatable{ OptionalUnwrap: COPY cast_payload };,
    Locatable.TenseNavigation AS cast_payload -> RETURN Locatable{ TenseNavigation: COPY cast_payload };,
    Locatable.MutableBorrow AS cast_payload -> RETURN Locatable{ MutableBorrow: COPY cast_payload };,
    Locatable.OrElseRaise AS cast_payload -> RETURN Locatable{ OrElseRaise: COPY cast_payload };,
    Locatable.OrElseExit AS cast_payload -> RETURN Locatable{ OrElseExit: COPY cast_payload };,
    Locatable.OrElsePass AS cast_payload -> RETURN Locatable{ OrElsePass: COPY cast_payload };,
    Locatable.OrElsePrune AS cast_payload -> RETURN Locatable{ OrElsePrune: COPY cast_payload };,
    Locatable.OrElseBreak AS cast_payload -> RETURN Locatable{ OrElseBreak: COPY cast_payload };,
    Locatable.CatchBlock AS cast_payload -> RETURN Locatable{ CatchBlock: COPY cast_payload };,
    Locatable.RecoverOp AS cast_payload -> RETURN Locatable{ RecoverOp: COPY cast_payload };,
    Locatable.BlockExpr AS cast_payload -> RETURN Locatable{ BlockExpr: COPY cast_payload };,
    Locatable.StringConcat AS cast_payload -> RETURN Locatable{ StringConcat: COPY cast_payload };,
    Locatable.CapabilityWrap AS cast_payload -> RETURN Locatable{ CapabilityWrap: COPY cast_payload };,
    Locatable.MoveNode AS cast_payload -> RETURN Locatable{ MoveNode: COPY cast_payload };,
    Locatable.CopyNode AS cast_payload -> RETURN Locatable{ CopyNode: COPY cast_payload };,
    Locatable.KeepNode AS cast_payload -> RETURN Locatable{ KeepNode: COPY cast_payload };,
    Locatable.ShareNode AS cast_payload -> RETURN Locatable{ ShareNode: COPY cast_payload };,
    Locatable.LinkNode AS cast_payload -> RETURN Locatable{ LinkNode: COPY cast_payload };,
    Locatable.ResolveNode AS cast_payload -> RETURN Locatable{ ResolveNode: COPY cast_payload };,
    Locatable.FreezeNode AS cast_payload -> RETURN Locatable{ FreezeNode: COPY cast_payload };,
    Locatable.PassStmt AS cast_payload -> RETURN Locatable{ PassStmt: COPY cast_payload };,
    Locatable.StructPattern AS cast_payload -> RETURN Locatable{ StructPattern: COPY cast_payload };,
    Locatable.RangeLit AS cast_payload -> RETURN Locatable{ RangeLit: COPY cast_payload };,
    Locatable.ExternFnDecl AS cast_payload -> RETURN Locatable{ ExternFnDecl: COPY cast_payload };,
    Locatable.ExternStructDecl AS cast_payload -> RETURN Locatable{ ExternStructDecl: COPY cast_payload };,
    Locatable.EnumDef AS cast_payload -> RETURN Locatable{ EnumDef: COPY cast_payload };,
    Locatable.UnionDef AS cast_payload -> RETURN Locatable{ UnionDef: COPY cast_payload };,
    Locatable.UnionVariantLit AS cast_payload -> RETURN Locatable{ UnionVariantLit: COPY cast_payload };,
    Locatable.StaticCall AS cast_payload -> RETURN Locatable{ StaticCall: COPY cast_payload };,
    Locatable.DoBlock AS cast_payload -> RETURN Locatable{ DoBlock: COPY cast_payload };,
    Locatable.BgBlock AS cast_payload -> RETURN Locatable{ BgBlock: COPY cast_payload };,
    Locatable.ThenChain AS cast_payload -> RETURN Locatable{ ThenChain: COPY cast_payload };,
    Locatable.BgStreamBlock AS cast_payload -> RETURN Locatable{ BgStreamBlock: COPY cast_payload };,
    Locatable.YieldExpr AS cast_payload -> RETURN Locatable{ YieldExpr: COPY cast_payload };,
    Locatable.CloseStream AS cast_payload -> RETURN Locatable{ CloseStream: COPY cast_payload };,
    Locatable.NextExpr AS cast_payload -> RETURN Locatable{ NextExpr: COPY cast_payload };,
    Locatable.MatchStatement AS cast_payload -> RETURN Locatable{ MatchStatement: COPY cast_payload };,
    Locatable.ForRange AS cast_payload -> RETURN Locatable{ ForRange: COPY cast_payload };,
    Locatable.ForEach AS cast_payload -> RETURN Locatable{ ForEach: COPY cast_payload };,
    Locatable.TestBlock AS cast_payload -> RETURN Locatable{ TestBlock: COPY cast_payload };,
    Locatable.WhenBlock AS cast_payload -> RETURN Locatable{ WhenBlock: COPY cast_payload };,
    Locatable.LetBinding AS cast_payload -> RETURN Locatable{ LetBinding: COPY cast_payload };,
    Locatable.TestThat AS cast_payload -> RETURN Locatable{ TestThat: COPY cast_payload };,
    Locatable.AssertRaises AS cast_payload -> RETURN Locatable{ AssertRaises: COPY cast_payload };,
    Locatable.BenchmarkStmt AS cast_payload -> RETURN Locatable{ BenchmarkStmt: COPY cast_payload };,
    Locatable.SmashStmt AS cast_payload -> RETURN Locatable{ SmashStmt: COPY cast_payload };,
    Locatable.ProfileStmt AS cast_payload -> RETURN Locatable{ ProfileStmt: COPY cast_payload };,
    Locatable.StubDecl AS cast_payload -> RETURN Locatable{ StubDecl: COPY cast_payload };,
    Locatable.Drop AS cast_payload -> RETURN Locatable{ Drop: COPY cast_payload };,
    Locatable.SuppressCleanup AS cast_payload -> RETURN Locatable{ SuppressCleanup: COPY cast_payload };,
    Locatable.Return AS cast_payload -> RETURN Locatable{ Return: COPY cast_payload };,
    Locatable.ReassignCleanup AS cast_payload -> RETURN Locatable{ ReassignCleanup: COPY cast_payload };,
    Locatable.FieldCleanup AS cast_payload -> RETURN Locatable{ FieldCleanup: COPY cast_payload };,
    DEFAULT -> panic("Invalid cast to Locatable");
  END
  panic("Invalid cast to Locatable");
END
FN rtocChildrenLocatable(node: Locatable) RETURNS []Locatable ->
  PARTIAL MATCH node START
    Locatable.Program AS v -> RETURN rtocChildrenOfLocatableProgram(v);,
    Locatable.FunctionDef AS v -> RETURN rtocChildrenOfLocatableFunctionDef(v);,
    Locatable.Assignment AS v -> RETURN rtocChildrenOfLocatableAssignment(v);,
    Locatable.ListLit AS v -> RETURN rtocChildrenOfLocatableListLit(v);,
    Locatable.LambdaLit AS v -> RETURN rtocChildrenOfLocatableLambdaLit(v);,
    Locatable.IfStatement AS v -> RETURN rtocChildrenOfLocatableIfStatement(v);,
    Locatable.WhileLoop AS v -> RETURN rtocChildrenOfLocatableWhileLoop(v);,
    Locatable.WhileBindLoop AS v -> RETURN rtocChildrenOfLocatableWhileBindLoop(v);,
    Locatable.FuncCall AS v -> RETURN rtocChildrenOfLocatableFuncCall(v);,
    Locatable.MethodCall AS v -> RETURN rtocChildrenOfLocatableMethodCall(v);,
    Locatable.GetField AS v -> RETURN rtocChildrenOfLocatableGetField(v);,
    Locatable.WithBlock AS v -> RETURN rtocChildrenOfLocatableWithBlock(v);,
    Locatable.OptionalUnwrap AS v -> RETURN rtocChildrenOfLocatableOptionalUnwrap(v);,
    Locatable.TenseNavigation AS v -> RETURN rtocChildrenOfLocatableTenseNavigation(v);,
    Locatable.BlockExpr AS v -> RETURN rtocChildrenOfLocatableBlockExpr(v);,
    Locatable.StringConcat AS v -> RETURN rtocChildrenOfLocatableStringConcat(v);,
    Locatable.MoveNode AS v -> RETURN rtocChildrenOfLocatableMoveNode(v);,
    Locatable.CopyNode AS v -> RETURN rtocChildrenOfLocatableCopyNode(v);,
    Locatable.KeepNode AS v -> RETURN rtocChildrenOfLocatableKeepNode(v);,
    Locatable.ShareNode AS v -> RETURN rtocChildrenOfLocatableShareNode(v);,
    Locatable.StaticCall AS v -> RETURN rtocChildrenOfLocatableStaticCall(v);,
    Locatable.YieldExpr AS v -> RETURN rtocChildrenOfLocatableYieldExpr(v);,
    Locatable.NextExpr AS v -> RETURN rtocChildrenOfLocatableNextExpr(v);,
    Locatable.MatchStatement AS v -> RETURN rtocChildrenOfLocatableMatchStatement(v);,
    Locatable.LetBinding AS v -> RETURN rtocChildrenOfLocatableLetBinding(v);,
  END
  MUTABLE rtoc_no_children: []Locatable = [];
  RETURN rtoc_no_children;
END
FN rtocChildrenOfLocatableAssignment(v: Assignment) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(castAssignmentNameToLocatable(COPY v.name));
  &out.append(COPY v.value);
  RETURN out;
END
FN rtocChildrenOfLocatableBlockExpr(v: BlockExpr) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  FOR rtoc_arr_child IN v.body DO
    &out.append(COPY rtoc_arr_child);
  END
  IF v.result EXISTS AS rtoc_opt_child THEN
    &out.append(COPY rtoc_opt_child);
  END
  RETURN out;
END
FN rtocChildrenOfLocatableCopyNode(v: CopyNode) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.value);
  RETURN out;
END
FN rtocChildrenOfLocatableFuncCall(v: FuncCall) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  FOR rtoc_arr_child IN v.args DO
    &out.append(COPY rtoc_arr_child);
  END
  RETURN out;
END
FN rtocChildrenOfLocatableFunctionDef(v: FunctionDef) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  FOR rtoc_arr_child IN v.body DO
    &out.append(COPY rtoc_arr_child);
  END
  RETURN out;
END
FN rtocChildrenOfLocatableGetField(v: GetField) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.target);
  RETURN out;
END
FN rtocChildrenOfLocatableIfStatement(v: IfStatement) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.condition);
  FOR rtoc_arr_child IN v.then_branch DO
    &out.append(COPY rtoc_arr_child);
  END
  IF v.else_branch EXISTS AS rtoc_opt_child THEN
    FOR rtoc_arr_child IN rtoc_opt_child DO
      &out.append(COPY rtoc_arr_child);
    END
  END
  RETURN out;
END
FN rtocChildrenOfLocatableKeepNode(v: KeepNode) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.value);
  RETURN out;
END
FN rtocChildrenOfLocatableLambdaLit(v: LambdaLit) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(castLambdaBodyToLocatable(COPY v.body));
  RETURN out;
END
FN rtocChildrenOfLocatableLetBinding(v: LetBinding) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.expr);
  RETURN out;
END
FN rtocChildrenOfLocatableListLit(v: ListLit) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  FOR rtoc_arr_child IN v.items DO
    &out.append(COPY rtoc_arr_child);
  END
  RETURN out;
END
FN rtocChildrenOfLocatableMatchStatement(v: MatchStatement) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.expr);
  RETURN out;
END
FN rtocChildrenOfLocatableMethodCall(v: MethodCall) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.object);
  FOR rtoc_arr_child IN v.args DO
    &out.append(COPY rtoc_arr_child);
  END
  RETURN out;
END
FN rtocChildrenOfLocatableMoveNode(v: MoveNode) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.value);
  RETURN out;
END
FN rtocChildrenOfLocatableNextExpr(v: NextExpr) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.expr);
  RETURN out;
END
FN rtocChildrenOfLocatableOptionalUnwrap(v: OptionalUnwrap) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.target);
  RETURN out;
END
FN rtocChildrenOfLocatableProgram(v: Program) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  FOR rtoc_arr_child IN v.statements DO
    &out.append(COPY rtoc_arr_child);
  END
  RETURN out;
END
FN rtocChildrenOfLocatableShareNode(v: ShareNode) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.value);
  RETURN out;
END
FN rtocChildrenOfLocatableStaticCall(v: StaticCall) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  IF v.inherent_call EXISTS AS rtoc_opt_child THEN
    &out.append(Locatable{ FuncCall: COPY rtoc_opt_child });
  END
  RETURN out;
END
FN rtocChildrenOfLocatableStringConcat(v: StringConcat) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  FOR rtoc_arr_child IN v.parts DO
    &out.append(COPY rtoc_arr_child);
  END
  RETURN out;
END
FN rtocChildrenOfLocatableTenseNavigation(v: TenseNavigation) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.target);
  RETURN out;
END
FN rtocChildrenOfLocatableWhileBindLoop(v: WhileBindLoop) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.condition);
  FOR rtoc_arr_child IN v.do_branch DO
    &out.append(COPY rtoc_arr_child);
  END
  RETURN out;
END
FN rtocChildrenOfLocatableWhileLoop(v: WhileLoop) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.condition);
  FOR rtoc_arr_child IN v.do_branch DO
    &out.append(COPY rtoc_arr_child);
  END
  RETURN out;
END
FN rtocChildrenOfLocatableWithBlock(v: WithBlock) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  FOR rtoc_arr_child IN v.body DO
    &out.append(COPY rtoc_arr_child);
  END
  RETURN out;
END
FN rtocChildrenOfLocatableYieldExpr(v: YieldExpr) RETURNS []Locatable ->
  MUTABLE out: []Locatable = [];
  &out.append(COPY v.expr);
  RETURN out;
END
