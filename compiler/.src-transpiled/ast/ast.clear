PUB FN funcCall__explicit_mutable_argument?(self: FuncCall, index_value: Int64) RETURNS Bool ->
  MUTABLE tokens: ?{Int64}Token = COPY self.explicit_mutable_argument_tokens;
  IF tokens EXISTS AS tokens_value THEN
    RETURN tokens_value.contains?(index_value);
  ELSE
    RETURN FALSE;
  END
END
PUB FN funcCall__explicit_mutable_argument_token(self: FuncCall, index_value: Int64) RETURNS ?Token ->
  MUTABLE tokens: ?{Int64}Token = COPY self.explicit_mutable_argument_tokens;
  IF tokens EXISTS AS tokens_value THEN
    RETURN COPY tokens_value[index_value];
  ELSE
    RETURN NIL;
  END
END
FN funcCall__retain_error_channel(self: FuncCall) RETURNS ?Bool ->
  RETURN self.retain_error_channel;
END
FN funcCall__set_retain_error_channel(MUTABLE self: FuncCall, value: ?Bool) RETURNS ?Bool ->
  self.retain_error_channel = COPY value;
  RETURN COPY value;
END
