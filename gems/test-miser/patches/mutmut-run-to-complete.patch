+        rows.append(
+            {
+                "id": name,
+                "file": str(data.path),
+                "method": function.rpartition(".")[2],
+                "outcome": {
+                    "survived": "survived",
+                    "killed": "killed",
+                    "timeout": "timeout",
+                    "no tests": "uncovered",
+                }.get(status, status),
+                "covered_by": sorted(mutmut.tests_by_mangled_function_name.get(function, set())),
+                "killed_by": attribution.get(name, []),
+            }
+        )
+
+    subjects: list[dict[str, Any]] = []
+    grouped: dict[tuple[str, str], list[dict[str, Any]]] = defaultdict(list)
