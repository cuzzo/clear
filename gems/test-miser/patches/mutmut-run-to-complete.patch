+def _write_test_miser_facts(
+    *,
+    output: Path,
+    tests: list[dict[str, Any]],
+    mutants: list[tuple[SourceFileMutationData, str, int | None]],
+    complete: bool,
+) -> None:
+    spool = output.parent / f".{output.name}.parts"
+    attribution: dict[str, list[str]] = {}
+    if spool.exists():
+        for part in spool.glob("*.json"):
+            payload = json.loads(part.read_text())
+            attribution[payload["mutant"]] = payload["killed_by"]
+
+    rows: list[dict[str, Any]] = []
