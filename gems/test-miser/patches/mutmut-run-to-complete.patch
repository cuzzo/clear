+                "file": file,
+                "method": method,
+                "mutations": len(group),
+                "killed": killed,
+                "alive": sum(row["outcome"] == "survived" for row in group),
+                "kill_rate": round(killed / len(group) * 100, 2),
+                "mutation_kind": "stochastic",
+                "gate_status": "advisory",
+            }
+        )
+
