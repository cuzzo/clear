@@ -0,0 +1,130 @@
+package cmd
+
+import (
+	"encoding/json"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/go-gremlins/gremlins/internal/engine"
+	"github.com/go-gremlins/gremlins/internal/gomodule"
+	"github.com/go-gremlins/gremlins/internal/mutator"
+	"github.com/go-gremlins/gremlins/internal/report"
+)
+
+type testMiserTest struct {
+	ID   string `json:"id"`
+	Name string `json:"name"`
+	File string `json:"file"`
+	Line int    `json:"line"`
+}
+
+type testMiserMutant struct {
+	ID        string   `json:"id"`
+	File      string   `json:"file"`
+	Kind      string   `json:"kind"`
+	Outcome   string   `json:"outcome"`
+	Line      int      `json:"line"`
+	Column    int      `json:"column"`
+	CoveredBy []string `json:"covered_by"`
+	KilledBy  []string `json:"killed_by"`
+}
+
+func writeTestMiserFacts(output string, mod gomodule.GoModule, results report.Results) error {
+	attribution := engine.TestAttribution()
+	mutants := make([]testMiserMutant, 0, len(results.Mutants))
+	attributionComplete := true
+	for _, mutant := range results.Mutants {
+		position := mutant.Position()
+		id := engine.MutantID(mutant)
+		killedBy := attribution[id]
+		if killedBy == nil {
+			killedBy = []string{}
+		}
+		if mutant.Status() == mutator.Killed && len(killedBy) == 0 {
+			attributionComplete = false
+		}
+		mutants = append(mutants, testMiserMutant{
+			ID: id, File: position.Filename, Kind: mutant.Type().String(),
+			Outcome: testMiserOutcome(mutant.Status()), Line: position.Line, Column: position.Column,
+			CoveredBy: []string{}, KilledBy: killedBy,
+		})
+	}
+
+	tests, err := collectGoTests(mod)
+	if err != nil {
+		return err
+	}
+	payload := map[string]any{
+		"schema": "mutant-facts/v1", "source": "gremlins", "language": "go",
+		"mutation_kind": "stochastic", "subjects": []any{}, "tests": tests, "mutants": mutants,
+		"test_miser": map[string]bool{
+			"complete": true, "attribution_complete": attributionComplete, "run_to_complete": true,
+		},
+	}
+	data, err := json.MarshalIndent(payload, "", "  ")
+	if err != nil {
+		return err
+	}
+	return os.WriteFile(output, append(data, '\n'), 0o644)
+}
+
+func testMiserOutcome(status mutator.Status) string {
+	switch status {
+	case mutator.Killed:
+		return "killed"
+	case mutator.Lived:
+		return "survived"
+	case mutator.NotCovered:
+		return "uncovered"
+	case mutator.NotViable:
+		return "unviable"
+	case mutator.TimedOut:
+		return "timeout"
+	case mutator.Skipped:
+		return "skipped"
+	default:
+		return strings.ToLower(status.String())
+	}
+}
+
+func collectGoTests(mod gomodule.GoModule) ([]testMiserTest, error) {
+	var tests []testMiserTest
+	set := token.NewFileSet()
+	err := filepath.WalkDir(mod.Root, func(path string, entry os.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if entry.IsDir() && (entry.Name() == ".git" || entry.Name() == "vendor") {
+			return filepath.SkipDir
+		}
+		if entry.IsDir() || !strings.HasSuffix(path, "_test.go") {
+			return nil
+		}
+		file, err := parser.ParseFile(set, path, nil, 0)
+		if err != nil {
+			return err
+		}
+		relFile, _ := filepath.Rel(mod.Root, path)
+		relDir := filepath.Dir(relFile)
+		pkg := mod.Name
+		if relDir != "." {
+			pkg += "/" + filepath.ToSlash(relDir)
+		}
+		for _, decl := range file.Decls {
+			fn, ok := decl.(*ast.FuncDecl)
+			if !ok || !strings.HasPrefix(fn.Name.Name, "Test") {
+				continue
+			}
+			tests = append(tests, testMiserTest{
+				ID: "go:" + pkg + ":" + fn.Name.Name, Name: fn.Name.Name,
+				File: filepath.ToSlash(relFile), Line: set.Position(fn.Pos()).Line,
+			})
+		}
+		return nil
+	})
+	return tests, err
+}
