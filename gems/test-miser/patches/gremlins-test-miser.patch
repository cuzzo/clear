diff --git a/internal/engine/test_miser.go b/internal/engine/test_miser.go
new file mode 100644
index 0000000..73187b6
--- /dev/null
+++ b/internal/engine/test_miser.go
@@ -0,0 +1,30 @@
+package engine
+
+import (
+	"fmt"
+	"sync"
+
+	"github.com/go-gremlins/gremlins/internal/mutator"
+)
+
+var testAttribution sync.Map
+
+// MutantID is stable across the executor and the Test Miser exporter.
+func MutantID(m mutator.Mutator) string {
+	position := m.Position()
+	return fmt.Sprintf("go:%s:%d:%d:%s", position.Filename, position.Line, position.Column, m.Type().String())
+}
+
+func recordTestAttribution(m mutator.Mutator, killedBy []string) {
+	testAttribution.Store(MutantID(m), killedBy)
+}
+
+// TestAttribution returns the complete failure set captured for each executed mutant.
+func TestAttribution() map[string][]string {
+	result := make(map[string][]string)
+	testAttribution.Range(func(key, value any) bool {
+		result[key.(string)] = value.([]string)
+		return true
+	})
+	return result
+}
