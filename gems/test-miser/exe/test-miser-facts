#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "optparse"
require_relative "../lib/test_miser/mutation_report"

options = { selected_components: [] }
parser = OptionParser.new do |opts|
  opts.banner = "Usage: test-miser-facts normalize [options]"
  opts.on("--input FILE") { |value| options[:input] = value }
  opts.on("--output FILE") { |value| options[:output] = value }
  opts.on("--path-prefix PATH") { |value| options[:path_prefix] = value.sub(%r{/+\z}, "") }
  opts.on("--selected-component FILE") { |value| options[:selected_components] << value }
  opts.on("-h", "--help") { puts opts; exit 0 }
end

def method_from_mutant_id(id, file)
  prefix = "#{file}:evil:"
  return unless id.start_with?(prefix)

  id.delete_prefix(prefix).split(":#{file}:", 2).first
end

def summarize_subjects(mutants)
  mutants.group_by { |mutant| [mutant.fetch("file"), mutant["method"] || "*"] }
    .sort_by { |(file, method), _rows| [file, method] }
    .map do |(file, method), rows|
      killed = rows.count { |row| !row.fetch("killed_by").empty? }
      {
        "file" => file,
        "method" => method,
        "source" => "test-miser",
        "language" => "ruby",
        "mutation_kind" => "stochastic",
        "mutations" => rows.length,
        "killed" => killed,
        "alive" => rows.length - killed,
        "kill_rate" => rows.empty? ? nil : (killed * 100.0 / rows.length).round(2)
      }.compact
    end
end

begin
  command = ARGV.shift
  parser.parse!
  unless command == "normalize" && options[:input] && options[:output]
    warn parser
    exit 1
  end

  payload = JSON.parse(File.read(options[:input]))
  payload = if payload["schema"].to_s.start_with?("mutant-facts/")
              payload
            elsif payload["files"].is_a?(Hash)
              report = TestMiser::MutationReport.new(payload, source: options[:input])
              metadata = payload.fetch("testMiser", {})
              mutants = report.mutants.map do |mutant|
                {
                  "id" => mutant.id,
                  "file" => mutant.file,
                  "method" => method_from_mutant_id(mutant.id, mutant.file),
                  "covered_by" => mutant.covered_by.to_a.sort,
                  "killed_by" => mutant.killed_by.to_a.sort
                }.compact
              end
              {
                "schema" => "mutant-facts/v1",
                "source" => "test-miser",
                "language" => "ruby",
                "subjects" => summarize_subjects(mutants),
                "tests" => report.tests.map(&:to_h),
                "mutants" => mutants,
                "test_miser" => {
                  "complete" => metadata["complete"] == true,
                  "attribution_complete" => metadata["complete"] == true,
                  "run_to_complete" => metadata["runToComplete"] == true
                }
              }
            else
              raise KeyError, "input is not mutant-facts or Mutation Testing Elements"
            end

  if options[:path_prefix]
    ["subjects", "tests", "mutants"].each do |collection|
      Array(payload[collection]).each do |row|
        next unless row["file"]

        row["file"] = "#{options[:path_prefix]}/#{row['file'].sub(%r{\A\./}, '')}"
      end
    end
  end
  metadata = payload["test_miser"] ||= {}
  metadata["selected_components"] = options[:selected_components] unless options[:selected_components].empty?
  temporary = "#{options[:output]}.tmp-#{Process.pid}"
  File.write(temporary, "#{JSON.pretty_generate(payload)}\n")
  File.rename(temporary, options[:output])
rescue JSON::ParserError, Errno::ENOENT, KeyError, TestMiser::InvalidReport => error
  warn "test-miser-facts: #{error.message}"
  exit 1
ensure
  File.delete(temporary) if defined?(temporary) && temporary && File.exist?(temporary)
end
