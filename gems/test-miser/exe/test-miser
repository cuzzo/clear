#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require_relative "../lib/test_miser"

command = %w[infer adapt evidence].include?(ARGV.first) ? ARGV.shift : "report"
options = {
  format: command == "infer" ? "sarif" : command == "evidence" ? "json" : "markdown", output: nil,
  root: Dir.pwd, language: "java", selected_components: [], new_test_ids: [], baseline_test_ids: [],
  runtimes: {}, high_cost_ms: 1_000.0
}
parser = OptionParser.new do |opts|
  opts.banner = "Usage: test-miser [infer|adapt|evidence] [options] INPUT [...]"
  opts.on("-f", "--format FORMAT", %w[markdown json sarif], "Output format: markdown, json, or sarif") do |format|
    options[:format] = format
  end
  opts.on("-o", "--output FILE", "Write the report to FILE") do |path|
    options[:output] = path
  end
  opts.on("--root DIR", "Repository root used to infer missing test line numbers") do |path|
    options[:root] = path
  end
  opts.on("--language LANGUAGE", "Adapter source language (for example java or kotlin)") do |language|
    options[:language] = language
  end
  opts.on("--path-prefix PATH", "Prefix adapter source and test paths") { |path| options[:path_prefix] = path }
  opts.on("--selected-component PATH", "Declare an exactly refreshed source component") do |path|
    options[:selected_components] << path
  end
  opts.on("--new-test TEST_ID", "Include TEST_ID in the selected new-test cohort") do |test_id|
    options[:new_test_ids] << test_id
  end
  opts.on("--baseline-test TEST_ID", "Include TEST_ID in the comparison baseline cohort") do |test_id|
    options[:baseline_test_ids] << test_id
  end
  opts.on("--runtime TEST_ID=MILLISECONDS", "Record a test runtime for cost-aware review") do |value|
    test_id, milliseconds = value.split("=", 2)
    raise OptionParser::InvalidArgument, value if test_id.to_s.empty? || milliseconds.to_s.empty?

    options[:runtimes][test_id] = Float(milliseconds)
  end
  opts.on("--high-cost-ms MILLISECONDS", Float, "Runtime threshold for cost findings") do |milliseconds|
    options[:high_cost_ms] = milliseconds
  end
  opts.on("-h", "--help", "Show this help") do
    puts opts
    exit 0
  end
end

begin
  parser.parse!
  if ARGV.empty?
    warn parser
    exit 1
  end

  if command == "adapt"
    adapter = ARGV.shift
    payload = case adapter
    when "cargo-mutants"
      unless ARGV.length == 1
        warn "Usage: test-miser adapt [options] cargo-mutants MUTANTS_OUT"
        exit 1
      end
      TestMiser::Adapters::CargoMutants.new(
        output_dir: ARGV.fetch(0), root: options[:root],
        path_prefix: options[:path_prefix], selected_components: options[:selected_components]
      ).call
    when "pit"
      unless ARGV.length == 2
        warn "Usage: test-miser adapt [options] pit MUTATIONS_XML TEST_REPORT_DIR"
        exit 1
      end
      TestMiser::Adapters::Pit.new(
        mutations_xml: ARGV.fetch(0), test_reports: ARGV.fetch(1),
        root: options[:root], language: options[:language]
      ).call
    when "infection"
      unless ARGV.length == 2
        warn "Usage: test-miser adapt [options] infection INFECTION_HTML JUNIT_XML"
        exit 1
      end
      TestMiser::Adapters::Infection.new(
        report: ARGV.fetch(0), junit: ARGV.fetch(1), root: options[:root]
      ).call
    when "mull-gtest"
      unless ARGV.length == 2
        warn "Usage: test-miser adapt [options] mull-gtest MULL_SQLITE GTEST_JSON"
        exit 1
      end
      TestMiser::Adapters::MullGtest.new(
        database: ARGV.fetch(0), gtest_json: ARGV.fetch(1),
        root: options[:root], language: options[:language]
      ).call
    when "muter"
      unless ARGV.length == 2
        warn "Usage: test-miser adapt [options] muter MUTER_JSON MUTER_LOG_DIR"
        exit 1
      end
      TestMiser::Adapters::Muter.new(
        report: ARGV.fetch(0), logs: ARGV.fetch(1), root: options[:root]
      ).call
    else
      warn "Unknown adapter: #{adapter}"
      exit 1
    end
    output = JSON.pretty_generate(payload)
    if options[:output]
      File.write(options[:output], "#{output}\n")
    else
      puts output
    end
    exit 0
  end

  if command == "evidence"
    report = TestMiser::MutationReport.load_files(ARGV)
    corpus = TestMiser::Evidence::Corpus.from_report(report)
    contributions = TestMiser::Evidence::ContributionAnalyzer.new(corpus).analyze(
      new_test_ids: options[:new_test_ids],
      baseline_test_ids: options[:baseline_test_ids],
    )
    subsumption = TestMiser::Evidence::SubsumptionAnalyzer.new(corpus).analyze(contributions: contributions)
    evidence = TestMiser::Evidence::ReportBuilder.new(corpus).build(
      contributions: contributions,
      subsumption: subsumption,
      runtimes: options[:runtimes],
      high_cost_ms: options[:high_cost_ms],
    )
    output = evidence.json
    if options[:output]
      File.write(options[:output], "#{output}\n")
    else
      puts output
    end
    exit 0
  end

  report = TestMiser::MutationReport.load_files(ARGV)
  report = TestMiser::LocationResolver.new(root: options[:root]).call(report) if command == "infer"
  analysis = TestMiser::Analyzer.new(report).analyze
  reporter = TestMiser::Reporter.new(analysis)
  output = case options[:format]
  when "json" then reporter.json
  when "sarif" then reporter.sarif
  else reporter.markdown
  end

  if options[:output]
    File.write(options[:output], "#{output}\n")
  else
    puts output
  end
rescue TestMiser::InvalidReport, TestMiser::Evidence::InvalidCohort, Errno::ENOENT => error
  warn "test-miser: #{error.message}"
  exit 1
end
