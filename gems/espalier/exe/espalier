#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require_relative "../lib/espalier"

TREE_SITTER_EXTS = Decomplex::Syntax.supported_exts(parser: "tree_sitter").freeze
DEFAULT_EXCLUDE_PATTERNS = %w[
  **/.clear-cache/**
  **/.clear-transpile-cache/**
  **/.global-zig-cache/**
  **/.zig-cache/**
  **/zig-cache/**
  **/zig-out/**
  **/node_modules/**
  **/all-tests.zig
].freeze

options = {
  format: :markdown,
  output: nil,
  decomplex: nil,
  nil_kill: nil,
  risk: nil,
  manifest: nil,
  exclude: []
}

def report_link_base(output)
  output && File.dirname(File.expand_path(output))
end

def excluded_path?(path, patterns)
  path = path.to_s.tr("\\", "/")
  expanded = File.expand_path(path).tr("\\", "/")
  patterns.any? do |pattern|
    pat = pattern.to_s.tr("\\", "/")
    directory_exclude_match?(path, pat) ||
      directory_exclude_match?(expanded, pat) ||
      File.fnmatch?(pat, path, File::FNM_PATHNAME | File::FNM_EXTGLOB) ||
      File.fnmatch?(pat, expanded, File::FNM_PATHNAME | File::FNM_EXTGLOB) ||
      File.fnmatch?(pat, File.basename(path), File::FNM_EXTGLOB)
  end
end

def directory_exclude_match?(path, pattern)
  return false unless pattern.end_with?("/**")

  prefix = pattern.delete_suffix("/**")
  if prefix.start_with?("**/")
    suffix = prefix.delete_prefix("**/")
    path == suffix || path.start_with?("#{suffix}/") || path.include?("/#{suffix}/")
  else
    path == prefix || path.start_with?("#{prefix}/")
  end
end

def source_target?(path, exclude_patterns)
  return false unless File.file?(path)
  return false if File.basename(path).start_with?(".")
  return false if excluded_path?(path, exclude_patterns)

  TREE_SITTER_EXTS.include?(File.extname(path).downcase)
end

OptionParser.new do |opts|
  opts.banner = "Usage: espalier [options] <files/directories...>"

  opts.on("-f", "--format FORMAT", [:markdown, :yaml, :report], "Output format (markdown, yaml, report). Default: markdown") do |f|
    options[:format] = f
  end

  opts.on("-o", "--output FILE", "Write output to path instead of stdout") do |o|
    options[:output] = o
  end

  opts.on("--decomplex FILE", "Path to decomplex run report or JSON data") do |d|
    options[:decomplex] = d
  end

  opts.on("--nil-kill FILE", "Path to nil-kill signature mapping") do |n|
    options[:nil_kill] = n
  end

  opts.on("--risk FILE", "Path to boobytrap/slopcop churn & coverage report") do |r|
    options[:risk] = r
  end

  opts.on("--manifest FILE", "Read an existing Espalier architecture YAML manifest") do |m|
    options[:manifest] = m
  end

  opts.on("--exclude PATTERN", "Exclude a path/glob from directory scans. May be repeated.") do |pattern|
    options[:exclude] << pattern
  end
end.parse!

if options[:manifest]
  unless File.exist?(options[:manifest])
    puts "Error: Manifest not found: #{options[:manifest]}"
    exit 1
  end

  manifest = YAML.load_file(options[:manifest])
  output_contents = if options[:format] == :report
                      Espalier::Reporter.new(
                        manifest,
                        link_base: report_link_base(options[:output])
                      ).to_markdown
                    elsif options[:format] == :yaml
                      Espalier::Formatter.to_yaml(manifest)
                    else
                      Espalier::Formatter.to_markdown(manifest)
                    end

  if options[:output]
    File.write(options[:output], output_contents)
  else
    puts output_contents
  end
  exit 0
end

if ARGV.empty?
  puts "Error: No files or directories provided."
  exit 1
end

# Resolve input files
targets = []
exclude_patterns = DEFAULT_EXCLUDE_PATTERNS + options[:exclude]
ARGV.each do |arg|
  if File.directory?(arg)
    targets.concat(Dir.glob(File.join(arg, "**", "*")).select { |path| source_target?(path, exclude_patterns) })
  elsif File.file?(arg)
    targets << arg if source_target?(arg, exclude_patterns)
  end
end

targets.uniq!

if targets.empty?
  puts "No supported source files found."
  exit 0
end

# Mock external metadata loader helpers for CLI
decomplex_data = {}
if options[:decomplex] && File.exist?(options[:decomplex])
  # Simplistic line parser mapping methods to simulated metrics or simple hashes
  File.readlines(options[:decomplex]).each do |line|
    if line =~ /([\w:]+##\w+).*deviance.*?([\d\.]+)/
      decomplex_data[$1] = { deviance: $2.to_f }
    end
  end
end

nil_kill_evidence = Espalier::NilKillEvidence.load(options[:nil_kill])
nil_kill_data = nil_kill_evidence.method_signatures

risk_data = {}
if options[:risk] && File.exist?(options[:risk])
  # Simplistic parse mapping files to mock metrics
  File.readlines(options[:risk]).each do |line|
    if line =~ /file:\s*(\S+)\s*churn:\s*([\d\.]+)/
      risk_data[$1] = { churn: $2.to_f }
    end
  end
end

# Extract Static Skeletons
modules = []
targets.each do |file|
  extractor = Espalier::AstExtractor.new(file)
  modules.concat(extractor.extract)
end

# Synthesize Aggregated Architecture
aggregator = Espalier::Aggregator.new(
  decomplex_data: decomplex_data,
  nil_kill_data: nil_kill_data,
  risk_data: risk_data
)

nil_kill_evidence.apply!(modules)

manifest = aggregator.aggregate(modules)

# Format & Outflow
output_contents = if options[:format] == :yaml
                    Espalier::Formatter.to_yaml(manifest)
                  elsif options[:format] == :report
                    Espalier::Reporter.new(
                      manifest,
                      link_base: report_link_base(options[:output])
                    ).to_markdown
                  else
                    Espalier::Formatter.to_markdown(manifest)
                  end

if options[:output]
  File.write(options[:output], output_contents)
else
  puts output_contents
end
