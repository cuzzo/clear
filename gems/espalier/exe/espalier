#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require_relative "../lib/espalier"
require_relative "../lib/espalier/type_profile"

options = {
  format: :markdown,
  output: nil,
  decomplex: nil,
  nil_kill: nil,
  risk: nil,
  manifest: nil,
  exclude: [],
  fact_mine: nil,
  scip_indexes: [],
  vcs: nil
}

def report_link_base(output)
  output && File.dirname(File.expand_path(output))
end

OptionParser.new do |opts|
  opts.banner = "Usage: espalier [options] <files/directories...>"

  opts.on("-f", "--format FORMAT", [:markdown, :yaml, :report, :dot, :sarif, :json, :architecture, :unknown_operations], "Output format (markdown, yaml, report, dot, sarif, json, architecture, unknown_operations). Default: markdown") do |f|
    options[:format] = f
  end

  opts.on("-o", "--output FILE", "Write output to path instead of stdout") do |o|
    options[:output] = o
  end

  opts.on("--decomplex FILE", "Path to decomplex run report or JSON data") do |d|
    options[:decomplex] = d
  end

  opts.on("--nil-kill FILE", "Path to nil-kill signature mapping") do |n|
    options[:nil_kill] = n
  end

  opts.on("--risk FILE", "Path to boobytrap/slopcop churn & coverage report") do |r|
    options[:risk] = r
  end

  opts.on("--manifest FILE", "Read an existing Espalier architecture YAML manifest") do |m|
    options[:manifest] = m
  end

  opts.on("--exclude PATTERN", "Exclude a path/glob from directory scans. May be repeated.") do |pattern|
    options[:exclude] << pattern
  end

  opts.on("--vcs VCS", "Only parse files tracked by VCS (e.g. git)") do |v|
    options[:vcs] = v
  end

  opts.on("--fact-mine FILE", "Use previously mined fact file") do |f|
    options[:fact_mine] = f
  end


  opts.on("--scip-index FILE", "Import a .scip or SCIP JSON index (repeatable)") do |f|
    options[:scip_indexes] << f
  end
end.parse!

ENV["FACT_MINE_FACTS_FILE"] = options[:fact_mine] if options[:fact_mine]

if options[:manifest]
  unless File.exist?(options[:manifest])
    puts "Error: Manifest not found: #{options[:manifest]}"
    exit 1
  end

  manifest = YAML.respond_to?(:unsafe_load_file) ? YAML.unsafe_load_file(options[:manifest]) : YAML.load_file(options[:manifest])
  output_contents = if options[:format] == :report
                      Espalier::Reporter.new(
                        manifest,
                        link_base: report_link_base(options[:output])
                      ).to_markdown
                    elsif options[:format] == :yaml
                      Espalier::Formatter.to_yaml(manifest)
                    elsif options[:format] == :dot
                      Espalier::Formatter.to_dot(manifest)
                    elsif options[:format] == :unknown_operations
                      JSON.pretty_generate(Espalier::UnknownOperationsReport.build(manifest))
                    elsif %i[sarif json].include?(options[:format])
                      Espalier::Formatter.to_sarif(manifest)
                    else
                      Espalier::Formatter.to_markdown(manifest)
                    end

  if options[:output]
    File.write(options[:output], output_contents)
  else
    puts output_contents
  end
  exit 0
end

if ARGV.empty?
  puts "Error: No files or directories provided."
  exit 1
end

# Resolve input files
targets = Decomplex::SourceFilter.collect(
  ARGV,
  parser: "tree_sitter",
  root: Dir.pwd,
  exclude: options[:exclude]
)

if targets.empty?
  puts "No supported source files found."
  exit 0
end

# Mock external metadata loader helpers for CLI
decomplex_data = {}
if options[:decomplex] && File.exist?(options[:decomplex])
  # Simplistic line parser mapping methods to simulated metrics or simple hashes
  File.readlines(options[:decomplex]).each do |line|
    if line =~ /([\w:]+##\w+).*deviance.*?([\d\.]+)/
      decomplex_data[$1] = { deviance: $2.to_f }
    end
  end
end

nil_kill_evidence = Espalier::NilKillEvidence.load(options[:nil_kill])
nil_kill_data = nil_kill_evidence.method_signatures

risk_data = {}
if options[:risk] && File.exist?(options[:risk])
  # Simplistic parse mapping files to mock metrics
  File.readlines(options[:risk]).each do |line|
    if line =~ /file:\s*(\S+)\s*churn:\s*([\d\.]+)/
      risk_data[$1] = { churn: $2.to_f }
    end
  end
end

# Extract Static Skeletons
evidence = Espalier::StaticEvidence.build(
  targets,
  root: Dir.pwd,
  vcs: options[:vcs],
  scip_indexes: options[:scip_indexes],
  include_annotations: options[:format] != :architecture
)

if options[:format] == :architecture
  output_contents = JSON.pretty_generate(Espalier::ArchitectureArtifact.build(evidence, root: Dir.pwd))
  if options[:output]
    File.write(options[:output], output_contents)
  else
    puts output_contents
  end
  exit 0
end

# Group flat evidence into module structures expected by aggregator/analyzers
modules = Espalier::StaticEvidence.project_modules(evidence)

# Synthesize Aggregated Architecture
aggregator = Espalier::Aggregator.new(
  decomplex_data: decomplex_data,
  nil_kill_data: nil_kill_data,
  risk_data: risk_data,
  nil_kill_loops: nil_kill_evidence.loop_counts,
  nil_kill_evidence: nil_kill_evidence
)

nil_kill_evidence.apply!(modules)

manifest = aggregator.aggregate(modules)

# Format & Outflow
output_contents = if options[:format] == :unknown_operations
                    JSON.pretty_generate(Espalier::UnknownOperationsReport.build(manifest))
                  elsif options[:format] == :yaml
                    Espalier::Formatter.to_yaml(manifest)
                  elsif options[:format] == :dot
                    Espalier::Formatter.to_dot(manifest)
                  elsif %i[sarif json].include?(options[:format])
                    Espalier::Formatter.to_sarif(manifest)
                  elsif options[:format] == :report
                    Espalier::Reporter.new(
                      manifest,
                      link_base: report_link_base(options[:output])
                    ).to_markdown
                  else
                    Espalier::Formatter.to_markdown(manifest)
                  end

if options[:output]
  File.write(options[:output], output_contents)
else
  puts output_contents
end
