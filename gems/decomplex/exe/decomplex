#!/usr/bin/env ruby
# frozen_string_literal: true

require "rbconfig"

root = File.expand_path("..", __dir__)
binary_name = RbConfig::CONFIG["host_os"].match?(/mswin|mingw|cygwin/) ? "decomplex-rust.exe" : "decomplex-rust"
candidates = [
  ENV["DECOMPLEX_RUST_BINARY"],
  File.join(root, "target", "release", binary_name),
  File.join(root, "target", "debug", binary_name),
  ENV["PATH"].to_s.split(File::PATH_SEPARATOR).map { |dir| File.join(dir, binary_name) },
].flatten.compact
binary = candidates.find { |path| File.file?(path) && File.executable?(path) }

abort <<~MESSAGE unless binary
  decomplex-rust was not found.
  Build it with `cargo build --release --manifest-path #{File.join(root, "Cargo.toml")}`
  or set DECOMPLEX_RUST_BINARY to the compiled executable.
MESSAGE

exec(binary, *ARGV)
