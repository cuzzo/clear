#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/decomplex"

def collect_files(args)
  args.flat_map do |a|
    File.directory?(a) ? Dir.glob(File.join(a, "**", "*.rb")) : [a]
  end.select { |f| File.file?(f) }
end

# decomplex delta BASELINE.json FILE_OR_DIR...
#   diff a fresh run against a saved baseline snapshot. Line-
#   insensitive: a finding that only moved lines is "persisted".
if ARGV[0] == "delta"
  require_relative "../lib/decomplex/report"
  baseline = ARGV[1]
  abort "usage: decomplex delta BASELINE.json FILE..." unless baseline && File.file?(baseline)

  files = collect_files(ARGV[2..])
  abort "no .rb files" if files.empty?
  rep = Decomplex::Report.new(files)
  head = Decomplex::Delta.snapshot(rep.sections_data, rep.root_clusters)
  base = JSON.parse(File.read(baseline))
  puts Decomplex::Delta.to_markdown(Decomplex::Delta.diff(base, head))
  exit 0
end

if ARGV[0] == "state-mesh"
  require_relative "../lib/decomplex/state_mesh"
  args = ARGV[1..]
  out_path = nil
  args = args.reject { |a| a =~ /\A--output=(.+)/ && (out_path = Regexp.last_match(1)) }
  files = collect_files(args)
  abort "no .rb files" if files.empty?
  sm = Decomplex::StateMesh.scan(files)
  sm.run
  json = JSON.pretty_generate(sm.to_json_graph)
  if out_path
    File.write(out_path, json)
    warn "wrote #{out_path} (#{files.size} files)"
  else
    puts json
  end
  exit 0
end

if ARGV[0] == "state-branches"
  args = ARGV[1..]
  out_path = nil
  args = args.reject { |a| a =~ /\A--output=(.+)/ && (out_path = Regexp.last_match(1)) }
  files = collect_files(args)
  abort "no .rb files" if files.empty?
  rows = Decomplex::StateBranchDensity.scan(files).findings
  md = +"# Decomplex State-Based Branch Density\n\n"
  md << "| # | method | state branches | refs | score |\n"
  md << "|---|--------|----------------|------|-------|\n"
  rows.each_with_index do |h, idx|
    md << "| #{idx + 1} | `#{h[:at]}` | #{h[:decisions]} | " \
          "`#{h[:state_refs].first(8).join(' | ')}` | #{h[:score]} |\n"
  end
  if out_path
    File.write(out_path, md)
    warn "wrote #{out_path} (#{files.size} files)"
  else
    puts md
  end
  exit 0
end

if ARGV[0] == "temporal-ordering"
  args = ARGV[1..]
  out_path = nil
  args = args.reject { |a| a =~ /\A--output=(.+)/ && (out_path = Regexp.last_match(1)) }
  files = collect_files(args)
  abort "no .rb files" if files.empty?
  rows = Decomplex::TemporalOrderingPressure.scan(files)
  md = +"# Decomplex Temporal Ordering Pressure\n\n"
  md << "| # | owner | score | public | state methods | writers | shared fields | flows | states |\n"
  md << "|---|-------|-------|--------|---------------|---------|---------------|-------|--------|\n"
  rows.each_with_index do |h, idx|
    md << "| #{idx + 1} | `#{h[:owner]}` | #{h[:score]} | #{h[:public_methods]} | " \
          "#{h[:state_methods]} | #{h[:writers]} | `#{h[:shared_fields].join(' | ')}` | " \
          "#{h[:orderings]} | #{h[:state_space]} |\n"
  end
  if out_path
    File.write(out_path, md)
    warn "wrote #{out_path} (#{files.size} files)"
  else
    puts md
  end
  exit 0
end

if ["implicit-control-flow", "ordered-protocols"].include?(ARGV[0])
  args = ARGV[1..]
  out_path = nil
  args = args.reject { |a| a =~ /\A--output=(.+)/ && (out_path = Regexp.last_match(1)) }
  files = collect_files(args)
  abort "no .rb files" if files.empty?
  rows = Decomplex::ImplicitControlFlow.scan(files).ordered_protocols
  md = +"# Decomplex Implicit Control Flow\n\n"
  md << "| # | first site | kind | support | protocol | dependency | state |\n"
  md << "|---|------------|------|---------|----------|------------|-------|\n"
  rows.each_with_index do |h, idx|
    md << "| #{idx + 1} | `#{h[:at]}` | #{h[:kind]} | #{h[:support]} | " \
          "`#{h[:protocol].join(' -> ')}` | " \
          "`#{h[:dependency].join(' | ')}` | `#{h[:states].join(' | ')}` |\n"
  end
  if out_path
    File.write(out_path, md)
    warn "wrote #{out_path} (#{files.size} files)"
  else
    puts md
  end
  exit 0
end

if ["weighted-inlined-complexity", "wicc"].include?(ARGV[0])
  args = ARGV[1..]
  out_path = nil
  args = args.reject { |a| a =~ /\A--output=(.+)/ && (out_path = Regexp.last_match(1)) }
  files = collect_files(args)
  abort "no .rb files" if files.empty?
  rows = Decomplex::WeightedInlinedCognitiveComplexity.scan(files)
  md = +"# Decomplex Weighted Inlined Cognitive Complexity\n\n"
  md << "| # | method | inlined | local | hidden | depth | single-caller helpers | chain |\n"
  md << "|---|--------|---------|-------|--------|-------|-----------------------|-------|\n"
  rows.each_with_index do |h, idx|
    md << "| #{idx + 1} | `#{h[:at]}` | #{h[:inlined]} | #{h[:local]} | " \
          "#{h[:hidden]} | #{h[:depth]} | `#{h[:single_caller_callees].join(' | ')}` | " \
          "`#{h[:call_chain].join(' -> ')}` |\n"
  end
  if out_path
    File.write(out_path, md)
    warn "wrote #{out_path} (#{files.size} files)"
  else
    puts md
  end
  exit 0
end

if ARGV[0] == "report"
  require_relative "../lib/decomplex/report"
  args = ARGV[1..]
  out_path = nil
  json_path = nil
  args = args.reject { |a| a =~ /\A--output=(.+)/ && (out_path = Regexp.last_match(1)) }
  args = args.reject { |a| a =~ /\A--emit-json=(.+)/ && (json_path = Regexp.last_match(1)) }
  files = collect_files(args)
  abort "no .rb files" if files.empty?
  rep = Decomplex::Report.new(files)
  if json_path
    snap = Decomplex::Delta.snapshot(rep.sections_data, rep.root_clusters)
    File.write(json_path, JSON.dump(snap))
    warn "wrote baseline snapshot #{json_path}"
  end
  md = rep.to_markdown
  if out_path
    File.write(out_path, md)
    warn "wrote #{out_path} (#{files.size} files)"
  else
    puts md
  end
  exit 0
end

if ARGV.empty? || ARGV[0] == "-h" || ARGV[0] == "--help"
  warn <<~USAGE
    decomplex -- decision-level duplication + neglected-condition detector

      decomplex FILE_OR_DIR [FILE_OR_DIR ...]
      decomplex report [--output=FILE] [--emit-json=FILE] FILE_OR_DIR ...
      decomplex state-mesh [--output=FILE] FILE_OR_DIR ...
      decomplex state-branches [--output=FILE] FILE_OR_DIR ...
      decomplex temporal-ordering [--output=FILE] FILE_OR_DIR ...
      decomplex delta BASELINE.json FILE_OR_DIR ...

    Reports:
      MISSING ABSTRACTION  identical guard tuple recomputed across >=2
                           decision units, ranked support x scatter.
      NEGLECTED CONDITION  a site that is a high-support pattern minus
                           one element -- a possible bug candidate.

    Subcommands:
      report       Full markdown report with all detectors
      state-mesh   JSON graph of reader/writer hierarchy by field
      state-branches
                   Markdown table of branches whose predicate reads state
      temporal-ordering
                   Markdown table of public mutable lifecycle surfaces
      implicit-control-flow
                   Markdown table of state-dependent internal call-order pressure
      ordered-protocols
                   Alias for implicit-control-flow
      weighted-inlined-complexity
                   Markdown table of same-owner hidden cognitive complexity
      wicc         Alias for weighted-inlined-complexity
      delta        Before/after diff against a baseline snapshot

    v0 mines exact-match case/when dispatch + && conjunction only.
  USAGE
  exit 1
end

files = ARGV.flat_map do |a|
  if File.directory?(a)
    Dir.glob(File.join(a, "**", "*.rb"))
  else
    [a]
  end
end.select { |f| File.file?(f) }

miner = Decomplex::Miner.scan(files)

ma = miner.missing_abstractions
puts "=== MISSING ABSTRACTIONS (#{ma.size}) " \
     "-- guard tuple recomputed across >=2 decision units ==="
ma.first(40).each do |h|
  puts format("\n[%s] support=%d scatter=%d rank=%d",
              h[:kind], h[:support], h[:scatter], h[:rank])
  puts "  tuple: #{h[:members].join(' | ')}"
  h[:sites].first(8).each { |s| puts "    #{s}" }
  puts "    ...(+#{h[:sites].size - 8} more)" if h[:sites].size > 8
end

nc = miner.neglected_conditions
puts "\n\n=== NEGLECTED CONDITIONS (#{nc.size}) " \
     "-- pattern minus one element, likely bug ==="
nc.first(40).each do |h|
  puts format("\n[support=%d] at %s", h[:support], h[:at])
  puts "  full pattern: #{h[:pattern].join(' | ')}"
  puts "  MISSING here: #{h[:missing]}"
end

cu = Decomplex::CoUpdate.scan(files)
nu = cu.neglected_updates
puts "\n\n=== NEGLECTED UPDATES (#{nu.size}) " \
     "-- co-written state, one write missing (redundant-state desync) ==="
nu.first(40).each do |h|
  puts format("\n[support=%d] %s writes .%s but NOT .%s",
              h[:support], h[:at], h[:has], h[:missing])
  puts "  same-receiver write: #{h[:recv]}.#{h[:has]} = ..."
  puts "  pair co-written elsewhere: .#{h[:pair][0]} + .#{h[:pair][1]}"
end

pa = Decomplex::PredicateAlias.scan(files)
ac = pa.alias_clusters
puts "\n\n=== PREDICATE ALIASES (#{ac.size}) " \
     "-- one decision under multiple names (re-derived state) ==="
ac.first(30).each do |h|
  puts "\n  names: #{h[:names].join(' = ')}"
  puts "  body : #{h[:body]}"
  h[:sites].each { |s| puts "    #{s}" }
end

rm = pa.reification_misses(miner.sites)
unless rm.empty?
  puts "\n\n=== REIFICATION MISSES (#{rm.size}) " \
       "-- existing predicate reinvented inline ==="
  rm.first(30).each do |h|
    puts "\n  predicate ##{h[:predicate]} == #{h[:body]}"
    puts "  reinvented inline at #{h[:inline_at]}"
  end
end
