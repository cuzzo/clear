{
  "schema_version": 1,
  "name": "compiler-ruby-self-host",
  "description": "Every Ruby implementation file in the CLEAR compiler, evaluated as a complete source unit.",
  "corpus": {
    "source_root": "compiler/ruby",
    "glob": "**/*.rb",
    "generated_root": "compiler/src",
    "exclude": [
      "tools/**/*.rb",
      "lsp/**/*.rb"
    ]
  },
  "helper_config": "gems/ruby-to-clear/config/compiler_regex_helpers.json",
  "packages": {
    "fs": "stdlib/fs/src/lib.clear",
    "path": "stdlib/path/src/lib.clear"
  },
  "native_modules": {
    "compiler_regex": "compiler/src/compiler_regex.zig"
  },
  "forbidden_output_patterns": [
    "# [UNSUPPORTED:",
    "unsupportedRuby("
  ],
  "timeout_seconds": 240
}
