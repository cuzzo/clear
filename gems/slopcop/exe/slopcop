#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/slopcop"

def usage
  warn <<~U
    slopcop -- top true coverage gaps, ranked by fix-churn

      slopcop report [--repo=.] [--coverage=coverage/.resultset.json] \\
                   [--output=report.md] [--files=a.rb,b.rb] \\
                   [--ffi=meth1,meth2] [--diagnostic=meth1,meth2] \\
                   [--top=N] [--mutation=mutant-facts.json] [--exclude=GLOB ...]

    --coverage
             SimpleCov .resultset.json, kcov output directory,
             kcov Cobertura XML, or kcov codecov JSON
    --files  repo-relative source files to triage (default: app/lib/src;
             .rb in RubyVM mode, Decomplex Tree-sitter extensions in
             DECOMPLEX_PARSER=tree_sitter mode)
    --ffi    project external-boundary method names (the per-project
             lexicon; the gem ships none -- it is general)
    --diagnostic
             project methods that report/raise invalid-input diagnostics
             and should not be treated as ordinary reachable work
    --mutation
             mutant-facts/v1 JSON with file/method kill-rate and gate
             status; used to rank weakly verified complex/churned gaps
    --exclude
             exclude a path/glob from source scans. May be repeated;
             defaults already skip Zig caches, node_modules, and all-tests.zig.
  U
  exit 1
end

usage if ARGV.empty? || %w[-h --help].include?(ARGV[0])
usage unless ARGV[0] == "report"

TREE_SITTER_EXTS = %w[rb py js jsx mjs cjs ts tsx go rs zig].freeze

def tree_sitter_parser?
  ENV.fetch("DECOMPLEX_PARSER", "rubyvm").to_s.tr("-", "_") == "tree_sitter"
end

def default_file_globs
  exts = tree_sitter_parser? ? TREE_SITTER_EXTS : %w[rb]
  roots = %w[app lib src]
  roots.product(exts).map { |root, ext| "#{root}/**/*.#{ext}" }
end

def selected_parser
  tree_sitter_parser? ? "tree_sitter" : "rubyvm"
end

def repo_relative(path, repo)
  root = File.expand_path(repo).tr("\\", "/").chomp("/")
  expanded = File.expand_path(path.to_s.start_with?("/") ? path : File.join(repo, path)).tr("\\", "/")
  prefix = "#{root}/"
  expanded.start_with?(prefix) ? expanded[prefix.length..] : path.to_s
end

def default_files(repo, exclude)
  if Boobytrap::DecomplexRisk.load_decomplex_source_filter
    roots = %w[app lib src].map { |root| File.join(repo, root) }
    return Decomplex::SourceFilter.collect(
      roots,
      parser: selected_parser,
      root: repo,
      exclude: exclude
    ).map { |path| repo_relative(path, repo) }.uniq.sort
  end

  default_file_globs.flat_map { |g| Dir.chdir(repo) { Dir[g] } }.uniq.sort
end

def filter_files(files, repo, exclude)
  Array(files).select do |file|
    Boobytrap::DecomplexRisk.source_file?(
      file,
      root: repo,
      parser: selected_parser,
      exclude: exclude
    )
  end.map { |file| repo_relative(file, repo) }.uniq.sort
end

opts = { repo: ".", coverage: "coverage/.resultset.json", output: nil,
         top: 50, ffi: [], diagnostic: [], files: nil, mutation: nil, exclude: [] }
args = ARGV[1..].dup
until args.empty?
  a = args.shift
  case a
  when /\A--repo=(.+)/     then opts[:repo] = Regexp.last_match(1)
  when /\A--coverage=(.+)/ then opts[:coverage] = Regexp.last_match(1)
  when /\A--output=(.+)/   then opts[:output] = Regexp.last_match(1)
  when /\A--files=(.+)/    then opts[:files] = Regexp.last_match(1).split(",")
  when /\A--ffi=(.+)/      then opts[:ffi] = Regexp.last_match(1).split(",")
  when /\A--diagnostic=(.+)/ then opts[:diagnostic] = Regexp.last_match(1).split(",")
  when /\A--top=(\d+)/     then opts[:top] = Regexp.last_match(1).to_i
  when /\A--mutation=(.+)/ then opts[:mutation] = Regexp.last_match(1)
  when /\A--exclude=(.+)/  then opts[:exclude] << Regexp.last_match(1)
  when "--exclude"         then opts[:exclude] << args.shift.to_s
  else usage
  end
end

opts[:files] = if opts[:files]
                 filter_files(opts[:files], opts[:repo], opts[:exclude])
               else
                 default_files(opts[:repo], opts[:exclude])
               end

md = SlopCop::Report.new(
  files: opts[:files], repo: opts[:repo], resultset: opts[:coverage],
  ffi_boundary: opts[:ffi], diagnostic_mids: opts[:diagnostic],
  top: opts[:top],
  mutation: opts[:mutation],
  exclude: opts[:exclude],
  # links must resolve from wherever the report is written.
  link_base: (opts[:output] ? File.dirname(opts[:output]) : nil)
).to_markdown

if opts[:output]
  File.write(opts[:output], md)
  warn "wrote #{opts[:output]}"
else
  puts md
end
