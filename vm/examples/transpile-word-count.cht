STRUCT User { id: Int64 }

FN cheatMain() RETURNS User ->
  VAR raw_data = readFile("testdata/fruits.csv").trim();

  -- 1. Split into List
  --    Note: split returns %String, so 'parts' is a Heap List

  -- TODO: Figure this out...
  MUTABLE parts = raw_data.split(",");

  print("Count:", parts.length());
  print("Part 1:", parts[1]);

  -- 2. Modify
  parts.append(%"date");

  -- 3. Join back together
  VAR new_csv = join(parts, " | ");

  print(new_csv);
  -- Expected: "apple | banana | cherry | date"

  VAR u = %User{ id: 200 };
  RETURN u;
END
